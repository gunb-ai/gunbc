module v2.extdeps.languages.c




data c_r3_interface_members_split_note: String = "C R3: v2.std.compilers.compilation_unit.CompilationUnit.interface renders to the unit .h (declarations only); v2.std.compilers.compilation_unit.CompilationUnit.members renders to the unit .c (implementation). partition_fold is the sole producer of interface/deps; this module only spells linkage paths and cross-unit #include lines."

data c_r4_permissive_linkage_note: String = "C R4: permissive on module-SCC split across TUs, UnitGraphCycle, and LinkageCycle — mutually-recursive modules may live in different units; each .c #includes peer headers and links cyclically. Refuses only ByValueTypeCycle: an incomplete by-value type containment cycle that cannot be forward-declared (universal cause on home PartitionR4ValidityCause). SccSplit is Rust R4, not C R4."

data c_by_value_type_cycle_detail: String = "incomplete by-value type containment cycle across partition units"

data c_by_value_type_ambiguous_identity_detail: String = "ambiguous type identity across modules for by-value R4 lookup"

data c_partition_fold_outcome_note: String = "C callers requiring receipt-bearing partition results MUST use c_partition_fold_outcome (routes v2.std.compilers.compilation_unit.partition_fold_outcome from home). Never treat partition_fold() -> [] as a refusal signal — that compat wrapper collapses v2.std.compilers.compilation_unit.PartitionFoldRefused to [] (§5 absorbing-fallback). Returns v2.std.compilers.compilation_unit.PartitionFoldOutcome directly — no parallel C-local coproduct."

fn c_partition_fold_outcome(
  module_dag: v2.std.compilers.compilation_unit.ModuleDag,
  assignment: Map<v2.std.compilers.compilation_unit.ModuleId, v2.std.compilers.compilation_unit.CompilationUnitId>
) -> v2.std.compilers.compilation_unit.PartitionFoldOutcome {
  v2.std.compilers.compilation_unit.partition_fold_outcome(module_dag: module_dag, assignment: assignment)
}

type CTranslationUnitSpelling {
  unit_id: v2.std.compilers.compilation_unit.CompilationUnitId
  header_path: String
  source_path: String
  include_directives: v2.std.collection.List<String>
  include_closure: v2.std.collection.List<v2.std.compilers.compilation_unit.CompilationUnitId>
  object_path: String
  interface_nodes: v2.std.collection.List<v2.std.node.Node>
}

data c_translation_unit_basename_note: String = "C-realization spelling authority for an agnostic v2.std.compilers.compilation_unit.CompilationUnitId (review 2026-08-01). v2.std.compilers.compilation_unit.CompilationUnitId is a branded NonEmptyStr: the brand gives nominal distinction but NO spelling law, so `../peer`, `a/b`, `a\\b`, an embedded CR/LF/NUL, and `\"` all inhabit it (the same class path_segment_is_safe records). Those values reached `.h`/`.c`/`.o` paths verbatim and were concatenated between #include \" and \", so a quote terminated the include string and a newline split the generated C source. Repair is a REVERSIBLE ENCODING, not sanitization and not a bare refusal: every codepoint outside [A-Za-z0-9._-] — and a LEADING '.', so the parent-directory segments '.' and '..' cannot be produced — renders as '%' + exactly 6 lowercase hex digits (all of Unicode fits in 6; max scalar 0x10FFFF). Because '%' is itself outside the allowlist it always escapes to %000025, so every '%' in the output opens an escape of fixed width 7 and decoding is unambiguous — that is the injectivity proof: distinct unit ids cannot collapse to one basename, so two units can never contend for one .o. Encoding rather than refusing keeps the realization TOTAL over the agnostic identity; the honesty boundary is that the emitted name is a target spelling, not the logical id."

fn c_basename_char_allowed(cp: Int) -> Bool {
  (cp >= 48 && cp <= 57)
    || (cp >= 65 && cp <= 90)
    || (cp >= 97 && cp <= 122)
    || cp == 95
    || cp == 45
    || cp == 46
}

fn c_translation_unit_basename_safe(value: String) -> Bool {
  c_basename_all_chars_allowed(text: value, index: 0)
    && value.length() > 0
    && code_point(substring(s: value, start: 0, end: 1)) != 46
}

fn c_basename_all_chars_allowed(text: String, index: Int) -> Bool {
  if index >= text.length() {
    true
  } else {
    if c_basename_char_allowed(cp: code_point(substring(s: text, start: index, end: index + 1)))
      || code_point(substring(s: text, start: index, end: index + 1)) == 37 {
      c_basename_all_chars_allowed(text: text, index: index + 1)
    } else {
      false
    }
  }
}

type CTranslationUnitBasename = std.types.NonEmptyStr where c_translation_unit_basename_safe

fn c_hex_digit(v: Int) -> String {
  if v == 0 { "0" } else if v == 1 { "1" } else if v == 2 { "2" } else if v == 3 { "3" }
  else if v == 4 { "4" } else if v == 5 { "5" } else if v == 6 { "6" } else if v == 7 { "7" }
  else if v == 8 { "8" } else if v == 9 { "9" } else if v == 10 { "a" } else if v == 11 { "b" }
  else if v == 12 { "c" } else if v == 13 { "d" } else if v == 14 { "e" } else { "f" }
}

fn c_basename_escape(cp: Int) -> String {
  concat(
    "%",
    c_hex_digit(v: cp / 1048576 % 16),
    c_hex_digit(v: cp / 65536 % 16),
    c_hex_digit(v: cp / 4096 % 16),
    c_hex_digit(v: cp / 256 % 16),
    c_hex_digit(v: cp / 16 % 16),
    c_hex_digit(v: cp % 16)
  )
}

fn c_basename_encode_go(text: String, index: Int, acc: String) -> String {
  if index >= text.length() {
    acc
  } else {
    let cp = code_point(substring(s: text, start: index, end: index + 1))
    let keep = c_basename_char_allowed(cp: cp) && !(index == 0 && cp == 46)
    c_basename_encode_go(
      text: text,
      index: index + 1,
      acc: concat(acc, if keep { substring(s: text, start: index, end: index + 1) } else { c_basename_escape(cp: cp) })
    )
  }
}

fn c_translation_unit_basename(unit_id: v2.std.compilers.compilation_unit.CompilationUnitId) -> CTranslationUnitBasename {
  c_basename_encode_go(text: unit_id as String, index: 0, acc: "") as CTranslationUnitBasename
}

fn c_unit_basename(unit_id: v2.std.compilers.compilation_unit.CompilationUnitId) -> String {
  c_translation_unit_basename(unit_id: unit_id) as String
}

fn c_unit_header_path(unit_id: v2.std.compilers.compilation_unit.CompilationUnitId) -> String {
  extdeps.languages.c.emit.c_path_with_extension(
    basename: c_unit_basename(unit_id: unit_id),
    extension: extdeps.languages.c.emit.c_header_extension
  )
}

fn c_unit_source_path(unit_id: v2.std.compilers.compilation_unit.CompilationUnitId) -> String {
  extdeps.languages.c.emit.c_path_with_extension(
    basename: c_unit_basename(unit_id: unit_id),
    extension: extdeps.languages.c.emit.c_source_extension
  )
}

fn c_unit_object_path(unit_id: v2.std.compilers.compilation_unit.CompilationUnitId) -> String {
  extdeps.languages.c.emit.c_path_with_extension(
    basename: c_unit_basename(unit_id: unit_id),
    extension: extdeps.languages.c.emit.c_object_extension
  )
}

fn c_include_directive_for_dep(dep_id: v2.std.compilers.compilation_unit.CompilationUnitId) -> String {
  extdeps.languages.c.emit.c_include_directive_for_header_path(
    header_path: c_unit_header_path(unit_id: dep_id)
  )
}

fn c_unit_include_directives(deps: v2.std.collection.List<v2.std.compilers.compilation_unit.CompilationUnitId>) -> v2.std.collection.List<String> {
  deps |> map(dep => c_include_directive_for_dep(dep_id: dep))
}

fn c_include_closure_snoc_unique(
  items: v2.std.collection.List<v2.std.compilers.compilation_unit.CompilationUnitId>,
  item: v2.std.compilers.compilation_unit.CompilationUnitId
) -> v2.std.collection.List<v2.std.compilers.compilation_unit.CompilationUnitId> {
  if v2.std.algebra.any(xs: items, predicate: fn(id) { id == item }) {
    items
  } else {
    items |> list_push(item)
  }
}

fn c_include_closure_grow_once(
  units: v2.std.collection.List<v2.std.compilers.compilation_unit.CompilationUnit>,
  closed: v2.std.collection.List<v2.std.compilers.compilation_unit.CompilationUnitId>
) -> v2.std.collection.List<v2.std.compilers.compilation_unit.CompilationUnitId> {
  closed
    |> fold(init: closed, f: fn(acc, dep_id) {
      match v2.std.compilers.compilation_unit.partition_unit_by_id(units: units, unit_id: dep_id) {
        v2.std.optional.Present { value: dep_unit } =>
          dep_unit.deps
            |> fold(init: acc, f: fn(inner, next) {
              c_include_closure_snoc_unique(items: inner, item: next)
            })
        v2.std.optional.Absent => acc
      }
    })
    |> sort_by(id => id)
}

fn c_include_closure_saturate_with_fuel(
  units: v2.std.collection.List<v2.std.compilers.compilation_unit.CompilationUnit>,
  closed: v2.std.collection.List<v2.std.compilers.compilation_unit.CompilationUnitId>,
  fuel: Int
) -> v2.std.collection.List<v2.std.compilers.compilation_unit.CompilationUnitId> {
  if fuel <= 0 {
    closed
  } else {
    let grown = c_include_closure_grow_once(units: units, closed: closed)
    if v2.std.algebra.length(xs: grown) == v2.std.algebra.length(xs: closed) {
      grown
    } else {
      c_include_closure_saturate_with_fuel(
        units: units,
        closed: grown,
        fuel: fuel - 1
      )
    }
  }
}

fn c_include_closure(
  unit: v2.std.compilers.compilation_unit.CompilationUnit,
  units: v2.std.collection.List<v2.std.compilers.compilation_unit.CompilationUnit>
) -> v2.std.collection.List<v2.std.compilers.compilation_unit.CompilationUnitId> {
  c_include_closure_saturate_with_fuel(
    units: units,
    closed: unit.deps,
    fuel: (units |> count) + 1
  )
}

fn c_translation_unit_spelling(
  unit: v2.std.compilers.compilation_unit.CompilationUnit,
  units: v2.std.collection.List<v2.std.compilers.compilation_unit.CompilationUnit>
) -> CTranslationUnitSpelling {
  CTranslationUnitSpelling {
    unit_id: unit.id
    header_path: c_unit_header_path(unit_id: unit.id)
    source_path: c_unit_source_path(unit_id: unit.id)
    include_directives: c_unit_include_directives(deps: unit.deps)
    include_closure: c_include_closure(unit: unit, units: units)
    object_path: c_unit_object_path(unit_id: unit.id)
    interface_nodes: unit.interface
  }
}

fn c_unit_graph_call_graph(units: v2.std.collection.List<v2.std.compilers.compilation_unit.CompilationUnit>) -> std.graph.CallGraph {
  std.graph.CallGraph {
    edges: units
      |> fold(init: std.algebra.Empty, f: fn(acc, unit) {
        unit.deps
          |> fold(init: acc, f: fn(inner, dep) {
            inner
              |> list_push(
                std.graph.GraphEdge {
                  caller: unit.id,
                  callee: dep
                }
              )
          })
      })
  }
}

fn c_unit_graph_names(units: v2.std.collection.List<v2.std.compilers.compilation_unit.CompilationUnit>) -> v2.std.collection.List<String> {
  units |> map(unit => unit.id) |> sort_by(id => id)
}

fn c_partition_unit_graph_has_cycle(units: v2.std.collection.List<v2.std.compilers.compilation_unit.CompilationUnit>) -> Bool {
  std.graph.graph_has_multi_node_scc(
    names: c_unit_graph_names(units: units),
    graph: c_unit_graph_call_graph(units: units)
  )
}

type CTypeOwner {
  module: v2.std.compilers.compilation_unit.ModuleId
  identity: v2.std.node.Symbol
}

type CByValueTypeEdge {
  from: CTypeOwner
  to: CTypeOwner
}

type CTypeOwnerLookup
  = CTypeOwnerFound { owner: CTypeOwner }
  | CTypeOwnerAbsent
  | CTypeOwnerAmbiguous { identity: v2.std.node.Symbol }

fn c_type_owner_eq(left: CTypeOwner, right: CTypeOwner) -> Bool {
  left.module == right.module && left.identity == right.identity
}

fn c_list_snoc_type_owner(items: v2.std.collection.List<CTypeOwner>, item: CTypeOwner) -> v2.std.collection.List<CTypeOwner> {
  items |> list_push(item)
}

fn c_type_atoms_by_value_in_node(node: v2.std.node.Node) -> v2.std.collection.List<v2.std.node.Symbol> {
  match node.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: sym } } => [sym]
    v2.std.node.TypeNode { connective: v2.std.node.Arrow } => []
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      node.children
        |> fold(init: [], f: fn(acc, child) {
          c_type_atoms_by_value_in_node(node: child.target)
            |> fold(init: acc, f: fn(inner, sym) {
              if v2.std.algebra.any(xs: inner, predicate: fn(s) { s == sym }) {
                inner
              } else {
                inner |> list_push(sym)
              }
            })
        })
    _ => []
  }
}

fn c_type_definition_body(row: v2.std.compilers.compilation_unit.ModuleTypeDefinitionRow) -> v2.std.node.Node {
  row.definition
}

fn c_all_type_owners(module_dag: v2.std.compilers.compilation_unit.ModuleDag) -> v2.std.collection.List<CTypeOwner> {
  module_dag.modules
    |> fold(init: [], f: fn(acc, member_module) {
      v2.std.compilers.compilation_unit.module_type_definition_rows(module_dag: module_dag, module: member_module)
        |> fold(init: acc, f: fn(inner, row) {
          inner
            |> list_push(
              CTypeOwner {
                module: member_module,
                identity: v2.std.compilers.compilation_unit.type_definition_row_identity(row: row),
              }
            )
        })
    })
}

fn c_type_owner_for_symbol_in_module(
  owners: v2.std.collection.List<CTypeOwner>,
  member_module: v2.std.compilers.compilation_unit.ModuleId,
  sym: v2.std.node.Symbol
) -> v2.std.optional.Optional<CTypeOwner> {
  v2.std.algebra.fold_list(
    xs: owners,
    empty: v2.std.optional.Absent,
    cons: fn(acc, owner) {
      match acc {
        v2.std.optional.Present { value: _ } => acc
        v2.std.optional.Absent =>
          match (owner.module == member_module) && (owner.identity == sym) {
            true => v2.std.optional.Present { value: owner }
            false => v2.std.optional.Absent
          }
      }
    }
  )
}

fn c_type_owner_singleton_match(
  owners: v2.std.collection.List<CTypeOwner>,
  sym: v2.std.node.Symbol
) -> CTypeOwnerLookup {
  v2.std.algebra.fold_list(
    xs: owners,
    empty: CTypeOwnerAbsent,
    cons: fn(acc, owner) {
      match owner.identity == sym {
        false => acc
        true =>
          match acc {
            CTypeOwnerAbsent => CTypeOwnerFound { owner: owner }
            CTypeOwnerFound { owner: _ } => CTypeOwnerAmbiguous { identity: sym }
            CTypeOwnerAmbiguous { identity: _ } => acc
          }
      }
    }
  )
}

fn c_type_owner_for_symbol(
  owners: v2.std.collection.List<CTypeOwner>,
  home_module: v2.std.compilers.compilation_unit.ModuleId,
  sym: v2.std.node.Symbol
) -> CTypeOwnerLookup {
  match c_type_owner_for_symbol_in_module(
    owners: owners,
    member_module: home_module,
    sym: sym
  ) {
    v2.std.optional.Present { value: owner } => CTypeOwnerFound { owner: owner }
    v2.std.optional.Absent => c_type_owner_singleton_match(owners: owners, sym: sym)
  }
}

fn c_type_definition_for_owner(
  module_dag: v2.std.compilers.compilation_unit.ModuleDag,
  owner: CTypeOwner
) -> v2.std.optional.Optional<v2.std.node.Node> {
  v2.std.algebra.fold_list(
    xs: v2.std.compilers.compilation_unit.module_type_definition_rows(module_dag: module_dag, module: owner.module),
    empty: v2.std.optional.Absent,
    cons: fn(acc, row) {
      match acc {
        v2.std.optional.Present { value: _ } => acc
        v2.std.optional.Absent =>
          match v2.std.compilers.compilation_unit.type_definition_row_identity(row: row) == owner.identity {
            true => v2.std.optional.Present { value: c_type_definition_body(row: row) }
            false => v2.std.optional.Absent
          }
      }
    }
  )
}

fn c_by_value_type_edges(
  module_dag: v2.std.compilers.compilation_unit.ModuleDag,
  owners: v2.std.collection.List<CTypeOwner>
) -> v2.std.collection.List<CByValueTypeEdge> {
  owners
    |> fold(init: [], f: fn(acc, owner) {
      match c_type_definition_for_owner(module_dag: module_dag, owner: owner) {
        v2.std.optional.Present { value: defn } =>
          c_type_atoms_by_value_in_node(node: defn)
            |> fold(init: acc, f: fn(inner, sym) {
              match c_type_owner_for_symbol(
                owners: owners,
                home_module: owner.module,
                sym: sym
              ) {
                CTypeOwnerFound { owner: target } =>
                  inner
                    |> list_push(
                      CByValueTypeEdge {
                        from: owner,
                        to: target,
                      }
                    )
                CTypeOwnerAbsent => inner
                CTypeOwnerAmbiguous { identity: _ } => inner
              }
            })
        v2.std.optional.Absent => acc
      }
    })
}

fn c_by_value_type_identity_resolution_refusal(
  module_dag: v2.std.compilers.compilation_unit.ModuleDag,
  owners: v2.std.collection.List<CTypeOwner>
) -> v2.std.optional.Optional<String> {
  owners
    |> fold(init: v2.std.optional.Absent, f: fn(acc, owner) {
      match acc {
        v2.std.optional.Present { value: _ } => acc
        v2.std.optional.Absent =>
          match c_type_definition_for_owner(module_dag: module_dag, owner: owner) {
            v2.std.optional.Present { value: defn } =>
              c_type_atoms_by_value_in_node(node: defn)
                |> fold(init: v2.std.optional.Absent, f: fn(inner_acc, sym) {
                  match inner_acc {
                    v2.std.optional.Present { value: _ } => inner_acc
                    v2.std.optional.Absent =>
                      match c_type_owner_for_symbol(
                        owners: owners,
                        home_module: owner.module,
                        sym: sym
                      ) {
                        CTypeOwnerAmbiguous { identity: _ } =>
                          v2.std.optional.Present { value: c_by_value_type_ambiguous_identity_detail }
                        CTypeOwnerFound { owner: _ } => v2.std.optional.Absent
                        CTypeOwnerAbsent => v2.std.optional.Absent
                      }
                  }
                })
            v2.std.optional.Absent => v2.std.optional.Absent
          }
      }
    })
}

fn c_path_contains_type_owner(path: v2.std.collection.List<CTypeOwner>, node: CTypeOwner) -> Bool {
  path |> v2.std.algebra.any(step => c_type_owner_eq(left: step, right: node))
}

fn c_by_value_edge_crosses_units(
  edge: CByValueTypeEdge,
  assignment: Map<v2.std.compilers.compilation_unit.ModuleId, v2.std.compilers.compilation_unit.CompilationUnitId>
) -> Bool {
  match v2.std.compilers.compilation_unit.module_unit_id(assignment: assignment, module: edge.from.module) {
    v2.std.optional.Present { value: from_unit } =>
      match v2.std.compilers.compilation_unit.module_unit_id(assignment: assignment, module: edge.to.module) {
        v2.std.optional.Present { value: to_unit } => from_unit != to_unit
        v2.std.optional.Absent => false
      }
    v2.std.optional.Absent => false
  }
}

fn c_by_value_cycle_has_cross_unit_edge(
  edges: v2.std.collection.List<CByValueTypeEdge>,
  assignment: Map<v2.std.compilers.compilation_unit.ModuleId, v2.std.compilers.compilation_unit.CompilationUnitId>,
  cycle: v2.std.collection.List<CTypeOwner>
) -> Bool {
  edges |> v2.std.algebra.any(edge =>
    c_path_contains_type_owner(path: cycle, node: edge.from)
      && c_path_contains_type_owner(path: cycle, node: edge.to)
      && c_by_value_edge_crosses_units(edge: edge, assignment: assignment)
  )
}

fn c_dfs_by_value_type_cycle(
  edges: v2.std.collection.List<CByValueTypeEdge>,
  assignment: Map<v2.std.compilers.compilation_unit.ModuleId, v2.std.compilers.compilation_unit.CompilationUnitId>,
  current: CTypeOwner,
  path: v2.std.collection.List<CTypeOwner>,
  fuel: Int
) -> v2.std.optional.Optional<String> {
  match fuel <= 0 {
    true => v2.std.optional.Absent
    false =>
      match c_path_contains_type_owner(path: path, node: current) {
        true =>
          match c_by_value_cycle_has_cross_unit_edge(
            edges: edges,
            assignment: assignment,
            cycle: path
          ) {
            true => v2.std.optional.Present { value: c_by_value_type_cycle_detail }
            false => v2.std.optional.Absent
          }
        false =>
          let next_path = c_list_snoc_type_owner(items: path, item: current)
          edges
            |> fold(init: v2.std.optional.Absent, f: fn(acc, edge) {
              match acc {
                v2.std.optional.Present { value: _ } => acc
                v2.std.optional.Absent =>
                  match c_type_owner_eq(left: edge.from, right: current) {
                    true =>
                      c_dfs_by_value_type_cycle(
                        edges: edges,
                        assignment: assignment,
                        current: edge.to,
                        path: next_path,
                        fuel: fuel - 1
                      )
                    false => v2.std.optional.Absent
                  }
              }
            })
      }
  }
}

fn c_find_by_value_type_cycle_detail(
  edges: v2.std.collection.List<CByValueTypeEdge>,
  assignment: Map<v2.std.compilers.compilation_unit.ModuleId, v2.std.compilers.compilation_unit.CompilationUnitId>,
  owners: v2.std.collection.List<CTypeOwner>
) -> v2.std.optional.Optional<String> {
  owners
    |> fold(init: v2.std.optional.Absent, f: fn(acc, owner) {
      match acc {
        v2.std.optional.Present { value: _ } => acc
        v2.std.optional.Absent =>
          c_dfs_by_value_type_cycle(
            edges: edges,
            assignment: assignment,
            current: owner,
            path: [],
            fuel: (owners |> count) + 1
          )
      }
    })
}

fn c_by_value_type_cycle_detail_after_resolution(
  module_dag: v2.std.compilers.compilation_unit.ModuleDag,
  assignment: Map<v2.std.compilers.compilation_unit.ModuleId, v2.std.compilers.compilation_unit.CompilationUnitId>,
  owners: v2.std.collection.List<CTypeOwner>
) -> v2.std.optional.Optional<String> {
  let edges = c_by_value_type_edges(module_dag: module_dag, owners: owners)
  c_find_by_value_type_cycle_detail(
    edges: edges,
    assignment: assignment,
    owners: owners
  )
}

fn c_partition_by_value_type_cycle_cause(
  module_dag: v2.std.compilers.compilation_unit.ModuleDag,
  assignment: Map<v2.std.compilers.compilation_unit.ModuleId, v2.std.compilers.compilation_unit.CompilationUnitId>,
  units: v2.std.collection.List<v2.std.compilers.compilation_unit.CompilationUnit>
) -> v2.std.optional.Optional<String> {
  let _ = units
  let owners = c_all_type_owners(module_dag: module_dag)
  match c_by_value_type_identity_resolution_refusal(
    module_dag: module_dag,
    owners: owners
  ) {
    v2.std.optional.Present { value: detail } => v2.std.optional.Present { value: detail }
    v2.std.optional.Absent =>
      c_by_value_type_cycle_detail_after_resolution(
        module_dag: module_dag,
        assignment: assignment,
        owners: owners
      )
  }
}

fn c_validate_partition_r4(
  module_dag: v2.std.compilers.compilation_unit.ModuleDag,
  assignment: Map<v2.std.compilers.compilation_unit.ModuleId, v2.std.compilers.compilation_unit.CompilationUnitId>,
  units: v2.std.collection.List<v2.std.compilers.compilation_unit.CompilationUnit>
) -> v2.std.compilers.compilation_unit.PartitionR4ValidityVerdict {
  match c_partition_by_value_type_cycle_cause(
    module_dag: module_dag,
    assignment: assignment,
    units: units
  ) {
    v2.std.optional.Absent => v2.std.compilers.compilation_unit.PartitionR4Valid
    v2.std.optional.Present { value: detail } =>
      v2.std.compilers.compilation_unit.PartitionR4Refused {
        cause: v2.std.compilers.compilation_unit.ByValueTypeCycle { detail: detail },
      }
  }
}

data c_stage0_emit_note: String = "Stage 0 C source emitter seeded on fn add (ISO/IEC 9899:2018 / C17 — extdeps.languages.c.emit extdeps_external_authority_anchor). Grammar relation rows + lex + binding_spellings live here; the smoke main harness suffix is the sole legitimate string scaffold (dissolves when a modeled main producer lands)."

type CStage0EmitStandardEdition
  = | CStage0EmitStandardC17

data c_stage0_emit_standard_edition: CStage0EmitStandardEdition = CStage0EmitStandardC17

data c_stage0_emit_standard_citation: std.decl_ref.DeclarationRef = std.decl_ref.DeclarationRef {
  module_path: "extdeps.languages.c.emit",
  decl_name: "extdeps_external_authority_anchor",
  field: std.decl_ref.WholeDeclaration
}

type CTranslationUnitPreambleDefect
  = MissingStdboolInclude {
      emitted_bool_literal_requires: std.decl_ref.DeclarationRef
    }

type CValueExpressionEmitValidityUnderStandard
  = ValidUnderDeclaredStandard
  | KnownInvalidUnderDeclaredStandard {
      standard_edition: CStage0EmitStandardEdition,
      standard_citation: std.decl_ref.DeclarationRef,
      defect: CTranslationUnitPreambleDefect
    }

fn c_bool_literal_emit_validity_under_declared_standard() -> CValueExpressionEmitValidityUnderStandard {
  KnownInvalidUnderDeclaredStandard {
    standard_edition: c_stage0_emit_standard_edition,
    standard_citation: c_stage0_emit_standard_citation,
    defect: MissingStdboolInclude {
      emitted_bool_literal_requires: std.decl_ref.DeclarationRef {
        module_path: "v2.extdeps.languages.c",
        decl_name: "c_stdbool_include_directive",
        field: std.decl_ref.WholeDeclaration
      }
    }
  }
}

data c_stdbool_include_directive: String = "#include <stdbool.h>\n"

fn c_bool_literal_host_source_text(literal: String) -> String {
  concat(
    left: concat(
      left: c_stdbool_include_directive,
      right: "\nint main(void) {\n  bool x = "
    ),
    right: concat(left: literal, right: ";\n  return x ? 0 : 1;\n}\n")
  )
}

fn c_bool_literal_host_runtime_row(literal: String) -> v2.std.host_transport.TargetEmitHostRuntimeRow {
  v2.std.host_transport.HostRuntimeRowPresent {
    row: v2.std.host_transport.EmitHostRuntimeRow {
      transport: v2.std.host_transport.HostTransportDescriptor {
        identity: ^c_bool_literal_host_transport_identity,
        workspace: [
          v2.std.host_transport.WorkspaceFile {
            path: "fixture.c",
            content: v2.std.host_transport.FixedText { text: c_bool_literal_host_source_text(literal: literal) }
          }
        ],
        build: [
          v2.std.host_transport.ProcessInvocation {
            program: v2.std.host_transport.HostToolProgram { executable: "cc" },
            args: [v2.std.host_transport.LiteralArg { text: "fixture.c" }, v2.std.host_transport.LiteralArg { text: "-o" }, v2.std.host_transport.LiteralArg { text: "fixture" }]
          }
        ],
        run: v2.std.host_transport.ProcessInvocation {
          program: v2.std.host_transport.ProducedProgram { path: "fixture" },
          args: []
        },
        runtime_value_codec: v2.std.host_transport.FixedWidthBytes { width: 0 }
      },
      runtime_primitive_type: c_emit_host_runtime_primitive_type_node()
    }
  }
}

data c_cpp_realization_relationship_note: String = "C and C++ share the ISO C subset: cpp_target_model retains the C++ scalar/primitive-facts model (38+ fns) while c_target_model owns the C Stage-0 fn-add grammar + cc runtime_row. Intended end-state: C is the base realization; C++ extends/reuses the C bundle for shared C-syntax rows rather than forking parallel spellings (cpp_source_text and c_source_text currently agree on add — a §3 nicknaming risk until C++ dispatches through c rows or a shared c_subset home). DISSOLVES WHEN cpp_target_model re-homes shared C-syntax translation rules onto c_target_model (or a lifted c_subset authority) and cpp keeps only C++-only extensions."

data c_source_text: String = "int add(int x, int y) { return x + y; }"

data c_emit_host_main_suffix: String = "\n\nextern long write(int, const void *, unsigned long);\nint main(void) { int value = add(2, 3); if (value != 5) { return 1; } unsigned char b[5] = {0, (unsigned char)(value & 0xff), (unsigned char)((value >> 8) & 0xff), (unsigned char)((value >> 16) & 0xff), (unsigned char)((value >> 24) & 0xff)}; write(1, b, 5); return 0; }\n"

data c_emit_host_inject_fault_main_suffix: String = "\n\nextern long write(int, const void *, unsigned long);\nint main(void) { int value = add(2, 2); unsigned char b[5] = {0, (unsigned char)(value & 0xff), (unsigned char)((value >> 8) & 0xff), (unsigned char)((value >> 16) & 0xff), (unsigned char)((value >> 24) & 0xff)}; write(1, b, 5); return 0; }\n"

data c_emit_host_main_suffix_dissolution_trigger: std.dissolution.DissolutionCondition = std.dissolution.unbound_dissolution(description: "🟡 dissolve-on: c_emit_host_main_suffix + c_emit_host_inject_fault_main_suffix — smoke-driver main harness fragments spliced after emitted add via v2.std.host_transport.EmittedWithSuffix (parallel to rust_emit_host_main_suffix / slb_driver_main_source). DISSOLVES WHEN a modeled C main producer emits the harness from grammar rows — retire these string carriers then.")

fn c_atom(id: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn c_named_edge(name: v2.std.node.Symbol, target: v2.std.node.Node) -> v2.std.node.Edge {
  v2.std.node.Edge { label: v2.std.node.Named { name: name }, target: target }
}

fn c_concrete_tokens() -> v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  [
    v2.std.compilers.target_model.FixedToken { token_class: ^c_token_ty_int },
    v2.std.compilers.target_model.BoundToken { token_class: ^c_token_ident, binding: ^c_binding_fn_add },
    v2.std.compilers.target_model.FixedToken { token_class: ^c_token_lparen },
    v2.std.compilers.target_model.FixedToken { token_class: ^c_token_ty_int },
    v2.std.compilers.target_model.BoundToken { token_class: ^c_token_ident, binding: ^c_binding_param_x },
    v2.std.compilers.target_model.FixedToken { token_class: ^c_token_comma },
    v2.std.compilers.target_model.FixedToken { token_class: ^c_token_ty_int },
    v2.std.compilers.target_model.BoundToken { token_class: ^c_token_ident, binding: ^c_binding_param_y },
    v2.std.compilers.target_model.FixedToken { token_class: ^c_token_rparen },
    v2.std.compilers.target_model.FixedToken { token_class: ^c_token_lbrace },
    v2.std.compilers.target_model.FixedToken { token_class: ^c_token_kw_return },
    v2.std.compilers.target_model.BoundToken { token_class: ^c_token_ident, binding: ^c_binding_param_x },
    v2.std.compilers.target_model.FixedToken { token_class: ^c_token_plus },
    v2.std.compilers.target_model.BoundToken { token_class: ^c_token_ident, binding: ^c_binding_param_y },
    v2.std.compilers.target_model.FixedToken { token_class: ^c_token_semicolon },
    v2.std.compilers.target_model.FixedToken { token_class: ^c_token_rbrace }
  ]
}

fn c_int_inhabitant_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      c_named_edge(name: ^c_inhabitant_field_atom, target: c_atom(id: ^c_inhabitant_int))
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn c_emitted_add_fn_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Arrow },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: c_int_inhabitant_node() },
      v2.std.node.Edge { label: v2.std.node.Positional, target: c_int_inhabitant_node() },
      v2.std.node.Edge { label: v2.std.node.Positional, target: c_int_inhabitant_node() }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn c_concrete_token_node(token: v2.std.compilers.target_model.ConcreteSyntaxToken) -> v2.std.node.Node {
  v2.std.compilers.target_model.concrete_syntax_token_to_node(token: token)
}

fn c_serialize_source_children() -> v2.std.collection.List<v2.std.node.Edge> {
  v2.std.algebra.list_append(
    left: [
      c_named_edge(name: ^serialize_source_field_source_text, target: c_atom(id: ^c_source_literal)),
      c_named_edge(name: ^serialize_source_field_source_grammar, target: c_atom(id: ^c_production_fn_add))
    ],
    right: [
      c_named_edge(
        name: ^grammar_relation_field_tokens,
        target: v2.std.grammar.grammar_relation_tokens_node(
          tokens: c_concrete_tokens(),
          token_to_node: c_concrete_token_node
        )
      )
    ]
  )
}

fn c_serialize_source_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: c_serialize_source_children(),
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn c_grammar_terminal(token_class: v2.std.node.Symbol) -> v2.std.grammar.GrammarExpr {
  v2.std.grammar.Terminal { token_class: token_class, stamp: v2.std.grammar.StampClass }
}

type CGramBuild1State
  = CGramBuild1StateInit
  | CGramBuild1StateReady { expr: v2.std.grammar.GrammarExpr }

fn c_grammar_sequence_from_token_classes() -> v2.std.grammar.GrammarExpr {
  match v2.std.algebra.fold_list(
    xs: c_concrete_tokens(),
    empty: CGramBuild1StateInit,
    cons: fn(state, token) {
      match state {
        CGramBuild1StateInit =>
          CGramBuild1StateReady {
            expr: c_grammar_terminal(token_class: v2.std.compilers.target_model.concrete_syntax_token_class(token: token))
          }
        CGramBuild1StateReady { expr: acc } =>
          CGramBuild1StateReady {
            expr: v2.std.grammar.Sequence {
              left: acc,
              right: c_grammar_terminal(token_class: v2.std.compilers.target_model.concrete_syntax_token_class(token: token))
            }
          }
      }
    }
  ) {
    CGramBuild1StateInit =>
      c_grammar_terminal(token_class: ^c_token_ty_int)
    CGramBuild1StateReady { expr: result } => result
  }
}

fn c_grammar_production_fn_add() -> v2.std.grammar.GrammarProduction {
  v2.std.grammar.GrammarProduction {
    name: ^c_production_fn_add,
    expression: c_grammar_sequence_from_token_classes(),
    emitted: c_emitted_add_fn_node()
  }
}

type CGrammarRelationRow {
  production: v2.std.grammar.GrammarProduction
  emitted: v2.std.node.Node
  tokens: v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>
}

fn c_grammar_relation_row() -> CGrammarRelationRow {
  CGrammarRelationRow {
    production: c_grammar_production_fn_add(),
    emitted: c_emitted_add_fn_node(),
    tokens: c_concrete_tokens()
  }
}

fn c_grammar_relation_row_node(row: CGrammarRelationRow) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      c_named_edge(name: ^grammar_relation_field_production, target: v2.std.grammar.grammar_production_to_node(production: row.production)),
      c_named_edge(name: ^grammar_relation_field_emitted, target: row.emitted),
      c_named_edge(
        name: ^grammar_relation_field_tokens,
        target: v2.std.grammar.grammar_relation_tokens_node(
          tokens: row.tokens,
          token_to_node: c_concrete_token_node
        )
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn c_translation_rules_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      c_named_edge(name: ^c_relation_rule_fn_add, target: c_grammar_relation_row_node(row: c_grammar_relation_row()))
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn c_selection_policy_node() -> v2.std.node.Node {
  c_int_inhabitant_node()
}

fn c_add_declared_inhabitants_root() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      c_named_edge(name: ^c_inhabitant_field_int, target: c_int_inhabitant_node()),
      c_named_edge(name: ^c_inhabitant_field_add_fn, target: c_emitted_add_fn_node())
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}


// C's minimal value-expression surface, enough to project the shared fixture body
// (a binding-ref plus op_add). Forms C has not yet modeled carry token classes with
// no lex rule, so reaching one REFUSES at serialization rather than emitting
// fabricated text -- the fail-closed property the lex-miss arm already provides.
// Delimiting discipline for this target. C's `if` is a STATEMENT and cannot
// appear in a value position at all, so the previous spelling -- kw_if with an
// lbrace then-arm -- was a copy of the .dag shape describing a construct C does
// not have here; it never emitted, because neither token had a lex rule. The
// conditional operator is what C actually has, and it is self-delimiting:
// `c ? a : b` ends with its else arm. C has no value-producing loop, so
// loop_token stays unspelled and the loop form refuses rather than emitting --
// self-delimiting is a claim about where a construct ENDS, never a claim that
// the language has one.
fn c_value_expression_projection() -> v2.std.compilers.target_model.TargetValueExpressionProjection {
  v2.std.compilers.target_model.TargetValueExpressionProjection {
    binding_ref_form: v2.std.compilers.target_model.TargetBindingRefShape { ident_token: ^c_token_ident },
    primitive_apply_form: v2.std.compilers.target_model.TargetPrimitiveApplyShape {
      open: ^c_token_lparen,
      close: ^c_token_rparen,
      separator: ^c_token_comma
    },
    callable_apply_form: v2.std.compilers.target_model.TargetCallApplyShape {
      callee_ident_token: ^c_token_ident,
      open: ^c_token_lparen,
      separator: ^c_token_comma,
      close: ^c_token_rparen
    },
    closure_form: v2.std.compilers.target_model.TargetClosureShape {
      fn_token: ^c_token_unwired_closure,
      open: ^c_token_lparen,
      separator: ^c_token_comma,
      close: ^c_token_rparen,
      body_open: ^c_token_lbrace,
      body_close: ^c_token_rbrace,
      param_ident_token: ^c_token_ident
    },
    effect_apply_form: v2.std.compilers.target_model.TargetEffectApplyShape {
      callees: [],
      open: ^c_token_lparen,
      close: ^c_token_rparen,
      separator: ^c_token_comma
    },
    conditional_form: v2.std.compilers.target_model.TargetConditionalShape {
      if_token: ^c_token_ternary_nop,
      then_token: ^c_token_ternary_question,
      else_token: ^c_token_ternary_colon,
      delimiting: v2.std.compilers.target_model.ConditionalSelfDelimiting
    },
    let_form: v2.std.compilers.target_model.TargetBindLetShape {
      let_token: ^c_token_unwired_let,
      assign_token: ^c_token_unwired_assign,
      in_token: ^c_token_semicolon
    },
    loop_form: v2.std.compilers.target_model.TargetLoopShape { loop_token: ^c_token_unwired_loop },
    record_construct_form: v2.std.compilers.target_model.TargetRecordConstructShape {
      open: ^c_token_lbrace,
      close: ^c_token_rbrace,
      separator: ^c_token_comma,
      assign: ^c_token_unwired_assign,
      record_literal_names_type: v2.std.compilers.target_model.Prepend
    },
    field_access_form: v2.std.compilers.target_model.TargetFieldAccessShape { dot: ^c_token_unwired_dot },
    match_form: v2.std.compilers.target_model.TargetMatchShape {
      match_token: ^c_token_unwired_match,
      scrutinee_open: ^c_token_lparen,
      scrutinee_close: ^c_token_rparen,
      open: ^c_token_lbrace,
      close: ^c_token_rbrace,
      fat_arrow: ^c_token_unwired_fat_arrow,
      arm_separator: ^c_token_comma
    },
    bool_literal_form: v2.std.compilers.target_model.TargetBoolLiteralShape {
      true_token: ^c_token_kw_true,
      false_token: ^c_token_kw_false
    },
    block_evaluation_mode: v2.std.compilers.target_model.StatementSequenced {
      return_token: ^c_token_kw_return,
      statement_terminator: ^c_token_semicolon
    }
  }
}

fn c_operator_realizations_catalog_node() -> v2.std.node.Node {
  v2.std.compilers.target_model.target_operator_realizations_catalog_node(rows: [
    v2.std.compilers.target_model.target_operator_realization_node(
      operation: v2.std.compilers.target_model.canonical_operation_op_add(),
      shape: v2.std.compilers.target_model.InfixToken { token: ^c_token_plus }
    )
  ])
}

fn c_target_model_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      c_named_edge(name: ^target_model_edge_selection_policy, target: c_selection_policy_node()),
      c_named_edge(name: ^target_model_edge_declared_inhabitants, target: c_add_declared_inhabitants_root()),
      c_named_edge(name: ^target_model_edge_translation_rules, target: c_translation_rules_node()),
      c_named_edge(name: ^target_model_edge_serialize_source, target: c_serialize_source_node()),
      c_named_edge(
        name: ^target_model_edge_semantic_decl_emission,
        target: v2.extdeps.languages.c_decl.c_semantic_decl_emission_bundle_node()
      ),
      c_named_edge(
        name: ^target_model_edge_value_expression_projection,
        target: v2.std.compilers.target_model.value_expr_projection_bundle_node(projection: c_value_expression_projection())
      ),
      c_named_edge(
        name: ^target_model_edge_operator_realizations,
        target: c_operator_realizations_catalog_node()
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn c_binding_spellings() -> Map<v2.std.node.Symbol, String> {
  v2.std.collection.map_insert(
    v2.std.collection.map_insert(
      v2.std.collection.map_insert(v2.std.collection.empty_map(), ^c_binding_fn_add, "add"),
      ^c_binding_param_x,
      "x"
    ),
    ^c_binding_param_y,
    "y"
  )
}

fn c_binding_spellings_with_dag_fixture() -> Map<v2.std.node.Symbol, String> {
  v2.std.collection.map_insert(
    v2.std.collection.map_insert(
      v2.std.collection.map_insert(
        v2.std.collection.map_insert(c_binding_spellings(), ^dag_binding_type_int, "int "),
        ^dag_binding_param_x,
        "x"
      ),
      ^dag_binding_param_y,
      "y"
    ),
    ^c_binding_fn_add,
    "add"
  )
}

fn c_lex_rule(token_class: v2.std.node.Symbol, text: String) -> v2.std.compilers.lexing.LexRule {
  v2.std.compilers.lexing.TokenRule { token_class: token_class, pattern: v2.std.compilers.lexing.LiteralPattern { text: text } }
}

fn c_lex_rules() -> v2.std.collection.List<v2.std.compilers.lexing.LexRule> {
  [
    c_lex_rule(token_class: ^c_token_ty_int, text: "int "),
    c_lex_rule(token_class: ^c_token_lparen, text: "("),
    c_lex_rule(token_class: ^c_token_comma, text: ", "),
    c_lex_rule(token_class: ^c_token_rparen, text: ") "),
    c_lex_rule(token_class: ^c_token_lbrace, text: "{ "),
    c_lex_rule(token_class: ^c_token_kw_return, text: "return "),
    c_lex_rule(token_class: ^c_token_plus, text: " + "),
    c_lex_rule(token_class: ^c_token_semicolon, text: ";"),
    c_lex_rule(token_class: ^c_token_rbrace, text: " }"),
    c_lex_rule(token_class: ^c_token_kw_true, text: "true"),
    c_lex_rule(token_class: ^c_token_kw_false, text: "false"),
    c_lex_rule(token_class: ^c_token_ternary_nop, text: ""),
    c_lex_rule(token_class: ^c_token_ternary_question, text: " ? "),
    c_lex_rule(token_class: ^c_token_ternary_colon, text: " : ")
  ]
}

fn c_lex() -> v2.std.compilers.lexing.LexRules {
  v2.std.compilers.lexing.ModeledLexRules { root: v2.std.compilers.lexing.LexRuleSet { rules: c_lex_rules() } }
}

