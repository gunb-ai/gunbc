module v2.extdeps.languages.c

import extdeps.languages.c.emit {
  c_header_extension,
  c_include_directive_for_header_path,
  c_object_extension,
  c_path_with_extension,
  c_source_extension
}
import std.algebra { Empty }
import std.graph {
  CallGraph,
  GraphEdge,
  graph_has_multi_node_scc
}
import std.types { String }
import v2.std.algebra { any, length }
import v2.std.collection {
  Absent,
  Optional,
  Present
}
import v2.std.algebra { fold_list }
import v2.std.compilers.compilation_unit {
  ByValueTypeCycle,
  CompilationUnit,
  CompilationUnitArtifactId,
  CompilationUnitId,
  ModuleDag,
  ModuleId,
  ModuleTypeDefinitionRow,
  PartitionFoldOk,
  PartitionFoldOutcome,
  PartitionFoldRefused,
  PartitionR4Refused,
  PartitionR4Valid,
  PartitionR4ValidityVerdict,
  module_type_definition_rows,
  module_unit_id,
  partition_fold_outcome,
  partition_unit_by_id,
  type_definition_row_identity
}
import v2.std.logic { Bool }
import v2.std.node {
  Arrow,
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Symbol,
  TypeNode
}

data c_r3_interface_members_split_note: String = "C R3: CompilationUnit.interface renders to the unit .h (declarations only); CompilationUnit.members renders to the unit .c (implementation). partition_fold is the sole producer of interface/deps; this module only spells linkage paths and cross-unit #include lines."

data c_r4_permissive_linkage_note: String = "C R4: permissive on module-SCC split across TUs, UnitGraphCycle, and LinkageCycle — mutually-recursive modules may live in different units; each .c #includes peer headers and links cyclically. Refuses only ByValueTypeCycle: an incomplete by-value type containment cycle that cannot be forward-declared (universal cause on home PartitionR4ValidityCause). SccSplit is Rust R4, not C R4."

data c_by_value_type_cycle_detail: String = "incomplete by-value type containment cycle across partition units"

data c_by_value_type_ambiguous_identity_detail: String = "ambiguous type identity across modules for by-value R4 lookup"

data c_partition_fold_outcome_note: String = "C callers requiring receipt-bearing partition results MUST use c_partition_fold_outcome (routes partition_fold_outcome from home). Never treat partition_fold() -> [] as a refusal signal — that compat wrapper collapses PartitionFoldRefused to [] (§5 absorbing-fallback). Returns PartitionFoldOutcome directly — no parallel C-local coproduct."

fn c_partition_fold_outcome(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>
) -> PartitionFoldOutcome {
  partition_fold_outcome(module_dag: module_dag, assignment: assignment)
}

type CTranslationUnitSpelling {
  unit_id: CompilationUnitId
  header_path: String
  source_path: String
  include_directives: List<String>
  include_closure: List<CompilationUnitId>
  object_path: String
  interface_nodes: List<Node>
}

fn c_unit_basename(unit_id: CompilationUnitId) -> String {
  unit_id
}

fn c_unit_header_path(unit_id: CompilationUnitId) -> String {
  c_path_with_extension(
    basename: c_unit_basename(unit_id: unit_id),
    extension: c_header_extension
  )
}

fn c_unit_source_path(unit_id: CompilationUnitId) -> String {
  c_path_with_extension(
    basename: c_unit_basename(unit_id: unit_id),
    extension: c_source_extension
  )
}

fn c_unit_object_path(artifact: CompilationUnitArtifactId) -> String {
  c_path_with_extension(basename: artifact, extension: c_object_extension)
}

fn c_include_directive_for_dep(dep_id: CompilationUnitId) -> String {
  c_include_directive_for_header_path(
    header_path: c_unit_header_path(unit_id: dep_id)
  )
}

fn c_unit_include_directives(deps: List<CompilationUnitId>) -> List<String> {
  deps |> map(dep => c_include_directive_for_dep(dep_id: dep))
}

fn c_include_closure_snoc_unique(
  items: List<CompilationUnitId>,
  item: CompilationUnitId
) -> List<CompilationUnitId> {
  if any(xs: items, predicate: fn(id) { id == item }) {
    items
  } else {
    items |> list_push(item)
  }
}

fn c_include_closure_grow_once(
  units: List<CompilationUnit>,
  closed: List<CompilationUnitId>
) -> List<CompilationUnitId> {
  closed
    |> fold(init: closed, f: fn(acc, dep_id) {
      match partition_unit_by_id(units: units, unit_id: dep_id) {
        Present { value: dep_unit } =>
          dep_unit.deps
            |> fold(init: acc, f: fn(inner, next) {
              c_include_closure_snoc_unique(items: inner, item: next)
            })
        Absent => acc
      }
    })
    |> sort_by(id => id)
}

fn c_include_closure_saturate_with_fuel(
  units: List<CompilationUnit>,
  closed: List<CompilationUnitId>,
  fuel: Int
) -> List<CompilationUnitId> {
  if fuel <= 0 {
    closed
  } else {
    let grown = c_include_closure_grow_once(units: units, closed: closed)
    if length(xs: grown) == length(xs: closed) {
      grown
    } else {
      c_include_closure_saturate_with_fuel(
        units: units,
        closed: grown,
        fuel: fuel - 1
      )
    }
  }
}

fn c_include_closure(
  unit: CompilationUnit,
  units: List<CompilationUnit>
) -> List<CompilationUnitId> {
  c_include_closure_saturate_with_fuel(
    units: units,
    closed: unit.deps,
    fuel: (units |> count) + 1
  )
}

fn c_translation_unit_spelling(
  unit: CompilationUnit,
  units: List<CompilationUnit>
) -> CTranslationUnitSpelling {
  CTranslationUnitSpelling {
    unit_id: unit.id
    header_path: c_unit_header_path(unit_id: unit.id)
    source_path: c_unit_source_path(unit_id: unit.id)
    include_directives: c_unit_include_directives(deps: unit.deps)
    include_closure: c_include_closure(unit: unit, units: units)
    object_path: c_unit_object_path(artifact: unit.artifact)
    interface_nodes: unit.interface
  }
}

fn c_unit_graph_call_graph(units: List<CompilationUnit>) -> CallGraph {
  CallGraph {
    edges: units
      |> fold(init: Empty, f: fn(acc, unit) {
        unit.deps
          |> fold(init: acc, f: fn(inner, dep) {
            inner
              |> list_push(
                GraphEdge {
                  caller: unit.id,
                  callee: dep
                }
              )
          })
      })
  }
}

fn c_unit_graph_names(units: List<CompilationUnit>) -> List<String> {
  units |> map(unit => unit.id) |> sort_by(id => id)
}

fn c_partition_unit_graph_has_cycle(units: List<CompilationUnit>) -> Bool {
  graph_has_multi_node_scc(
    names: c_unit_graph_names(units: units),
    graph: c_unit_graph_call_graph(units: units)
  )
}

type CTypeOwner {
  module: ModuleId
  identity: Symbol
}

type CByValueTypeEdge {
  from: CTypeOwner
  to: CTypeOwner
}

type CTypeOwnerLookup
  = CTypeOwnerFound { owner: CTypeOwner }
  | CTypeOwnerAbsent
  | CTypeOwnerAmbiguous { identity: Symbol }

fn c_type_owner_eq(left: CTypeOwner, right: CTypeOwner) -> Bool {
  left.module == right.module && left.identity == right.identity
}

fn c_list_snoc_type_owner(items: List<CTypeOwner>, item: CTypeOwner) -> List<CTypeOwner> {
  items |> list_push(item)
}

fn c_type_atoms_by_value_in_node(node: Node) -> List<Symbol> {
  match node.kind {
    TypeNode { connective: Atom { identity: sym } } => [sym]
    TypeNode { connective: Arrow } => []
    TypeNode { connective: Conj } =>
      node.children
        |> fold(init: [], f: fn(acc, child) {
          c_type_atoms_by_value_in_node(node: child.target)
            |> fold(init: acc, f: fn(inner, sym) {
              if any(xs: inner, predicate: fn(s) { s == sym }) {
                inner
              } else {
                inner |> list_push(sym)
              }
            })
        })
    _ => []
  }
}

fn c_type_definition_body(row: ModuleTypeDefinitionRow) -> Node {
  row.definition
}

fn c_all_type_owners(module_dag: ModuleDag) -> List<CTypeOwner> {
  module_dag.modules
    |> fold(init: [], f: fn(acc, member_module) {
      module_type_definition_rows(module_dag: module_dag, module: member_module)
        |> fold(init: acc, f: fn(inner, row) {
          inner
            |> list_push(
              CTypeOwner {
                module: member_module,
                identity: type_definition_row_identity(row: row),
              }
            )
        })
    })
}

fn c_type_owner_for_symbol_in_module(
  owners: List<CTypeOwner>,
  module: ModuleId,
  sym: Symbol
) -> Optional<CTypeOwner> {
  fold_list(
    xs: owners,
    empty: Absent,
    cons: fn(acc, owner) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          if owner.module == module && owner.identity == sym {
            Present { value: owner }
          } else {
            Absent
          }
      }
    }
  )
}

fn c_type_owner_singleton_match(
  owners: List<CTypeOwner>,
  sym: Symbol
) -> CTypeOwnerLookup {
  fold_list(
    xs: owners,
    empty: CTypeOwnerAbsent,
    cons: fn(acc, owner) {
      if owner.identity != sym {
        acc
      } else {
        match acc {
          CTypeOwnerAbsent => CTypeOwnerFound { owner: owner }
          CTypeOwnerFound { owner: _ } => CTypeOwnerAmbiguous { identity: sym }
          CTypeOwnerAmbiguous { identity: _ } => acc
        }
      }
    }
  )
}

fn c_type_owner_for_symbol(
  owners: List<CTypeOwner>,
  home_module: ModuleId,
  sym: Symbol
) -> CTypeOwnerLookup {
  match c_type_owner_for_symbol_in_module(
    owners: owners,
    module: home_module,
    sym: sym
  ) {
    Present { value: owner } => CTypeOwnerFound { owner: owner }
    Absent => c_type_owner_singleton_match(owners: owners, sym: sym)
  }
}

fn c_type_definition_for_owner(
  module_dag: ModuleDag,
  owner: CTypeOwner
) -> Optional<Node> {
  fold_list(
    xs: module_type_definition_rows(module_dag: module_dag, module: owner.module),
    empty: Absent,
    cons: fn(acc, row) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          if type_definition_row_identity(row: row) == owner.identity {
            Present { value: c_type_definition_body(row: row) }
          } else {
            Absent
          }
      }
    }
  )
}

fn c_by_value_type_edges(
  module_dag: ModuleDag,
  owners: List<CTypeOwner>
) -> List<CByValueTypeEdge> {
  owners
    |> fold(init: [], f: fn(acc, owner) {
      match c_type_definition_for_owner(module_dag: module_dag, owner: owner) {
        Present { value: defn } =>
          c_type_atoms_by_value_in_node(node: defn)
            |> fold(init: acc, f: fn(inner, sym) {
              match c_type_owner_for_symbol(
                owners: owners,
                home_module: owner.module,
                sym: sym
              ) {
                CTypeOwnerFound { owner: target } =>
                  inner
                    |> list_push(
                      CByValueTypeEdge {
                        from: owner,
                        to: target,
                      }
                    )
                CTypeOwnerAbsent => inner
                CTypeOwnerAmbiguous { identity: _ } => inner
              }
            })
        Absent => acc
      }
    })
}

fn c_by_value_type_identity_resolution_refusal(
  module_dag: ModuleDag,
  owners: List<CTypeOwner>
) -> Optional<String> {
  owners
    |> fold(init: Absent, f: fn(acc, owner) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match c_type_definition_for_owner(module_dag: module_dag, owner: owner) {
            Present { value: defn } =>
              c_type_atoms_by_value_in_node(node: defn)
                |> fold(init: Absent, f: fn(inner_acc, sym) {
                  match inner_acc {
                    Present { value: _ } => inner_acc
                    Absent =>
                      match c_type_owner_for_symbol(
                        owners: owners,
                        home_module: owner.module,
                        sym: sym
                      ) {
                        CTypeOwnerAmbiguous { identity: _ } =>
                          Present { value: c_by_value_type_ambiguous_identity_detail }
                        CTypeOwnerFound { owner: _ } => Absent
                        CTypeOwnerAbsent => Absent
                      }
                  }
                })
            Absent => Absent
          }
      }
    })
}

fn c_path_contains_type_owner(path: List<CTypeOwner>, node: CTypeOwner) -> Bool {
  path |> any(step => c_type_owner_eq(left: step, right: node))
}

fn c_by_value_edge_crosses_units(
  edge: CByValueTypeEdge,
  assignment: Map<ModuleId, CompilationUnitId>
) -> Bool {
  match module_unit_id(assignment: assignment, module: edge.from.module) {
    Present { value: from_unit } =>
      match module_unit_id(assignment: assignment, module: edge.to.module) {
        Present { value: to_unit } => from_unit != to_unit
        Absent => false
      }
    Absent => false
  }
}

fn c_by_value_cycle_has_cross_unit_edge(
  edges: List<CByValueTypeEdge>,
  assignment: Map<ModuleId, CompilationUnitId>,
  cycle: List<CTypeOwner>
) -> Bool {
  edges |> any(edge =>
    c_path_contains_type_owner(path: cycle, node: edge.from)
      && c_path_contains_type_owner(path: cycle, node: edge.to)
      && c_by_value_edge_crosses_units(edge: edge, assignment: assignment)
  )
}

fn c_dfs_by_value_type_cycle(
  edges: List<CByValueTypeEdge>,
  assignment: Map<ModuleId, CompilationUnitId>,
  current: CTypeOwner,
  path: List<CTypeOwner>,
  fuel: Int
) -> Optional<String> {
  if fuel <= 0 {
    Absent
  } else if c_path_contains_type_owner(path: path, node: current) {
    let cycle = path
    if c_by_value_cycle_has_cross_unit_edge(
      edges: edges,
      assignment: assignment,
      cycle: cycle
    ) {
      Present { value: c_by_value_type_cycle_detail }
    } else {
      Absent
    }
  } else {
    let next_path = c_list_snoc_type_owner(items: path, item: current)
    edges
      |> fold(init: Absent, f: fn(acc, edge) {
        match acc {
          Present { value: _ } => acc
          Absent =>
            if c_type_owner_eq(left: edge.from, right: current) {
              c_dfs_by_value_type_cycle(
                edges: edges,
                assignment: assignment,
                current: edge.to,
                path: next_path,
                fuel: fuel - 1
              )
            } else {
              Absent
            }
        }
      })
  }
}

fn c_find_by_value_type_cycle_detail(
  edges: List<CByValueTypeEdge>,
  assignment: Map<ModuleId, CompilationUnitId>,
  owners: List<CTypeOwner>
) -> Optional<String> {
  owners
    |> fold(init: Absent, f: fn(acc, owner) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          c_dfs_by_value_type_cycle(
            edges: edges,
            assignment: assignment,
            current: owner,
            path: [],
            fuel: (owners |> count) + 1
          )
      }
    })
}

fn c_partition_by_value_type_cycle_cause(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>,
  units: List<CompilationUnit>
) -> Optional<String> {
  let _ = units
  let owners = c_all_type_owners(module_dag: module_dag)
  match c_by_value_type_identity_resolution_refusal(
    module_dag: module_dag,
    owners: owners
  ) {
    Present { value: detail } => Present { value: detail }
    Absent => {
      let edges = c_by_value_type_edges(module_dag: module_dag, owners: owners)
      c_find_by_value_type_cycle_detail(
        edges: edges,
        assignment: assignment,
        owners: owners
      )
    }
  }
}

fn c_validate_partition_r4(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>,
  units: List<CompilationUnit>
) -> PartitionR4ValidityVerdict {
  match c_partition_by_value_type_cycle_cause(
    module_dag: module_dag,
    assignment: assignment,
    units: units
  ) {
    Absent => PartitionR4Valid
    Present { value: detail } =>
      PartitionR4Refused {
        cause: ByValueTypeCycle { detail: detail },
      }
  }
}
