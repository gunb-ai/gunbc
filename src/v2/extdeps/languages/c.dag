// C owns C's signature order here, and it is NOT Rust's: the return type comes
// FIRST, each parameter is TYPE then NAME with no label separator, and there is no
// return arrow. C is statement-sequenced, so the scaffold carries a return token
// before the body and a terminator after it. The compiler is not edited to support
// v2.std.algebra.any of this -- C supplies its own renderer and its own spellings.
fn c_produced_type_tokens(type_node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  match type_node.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } } =>
      v2.std.diagnostic.outcome_accepted(value: [v2.std.compilers.target_model.BoundToken { token_class: ^c_token_ident, binding: id }])
    _ =>
      v2.std.diagnostic.outcome_rejected(
        d: c_produced_decl_diagnostic(reason: ^c_produced_signature_type_unsupported, node: type_node)
      )
  }
}

fn c_produced_decl_diagnostic(reason: v2.std.node.Symbol, node: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: reason,
    at: v2.std.diagnostic.node_locus(node: node),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn c_produced_one_param_tokens(edge: v2.std.node.Edge) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  match edge.label {
    v2.std.node.Named { name: pname } =>
      v2.std.diagnostic.bind_outcome(
        o: c_produced_type_tokens(type_node: edge.target),
        f: fn(type_toks) {
          v2.std.diagnostic.outcome_accepted(
            value: v2.std.algebra.list_append(
              left: type_toks,
              right: [v2.std.compilers.target_model.BoundToken { token_class: ^c_token_ident, binding: pname }]
            )
          )
        }
      )
    v2.std.node.Positional =>
      v2.std.diagnostic.outcome_rejected(
        d: c_produced_decl_diagnostic(reason: ^c_produced_signature_param_unnamed, node: edge.target)
      )
  }
}

fn c_produced_params_tail_tokens(params: v2.std.collection.List<v2.std.node.Edge>) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  match params {
    std.algebra.Empty => v2.std.diagnostic.outcome_accepted(value: std.algebra.Empty)
    std.algebra.Cons { head: e, tail: rest } =>
      v2.std.diagnostic.bind_outcome(
        o: c_produced_one_param_tokens(edge: e),
        f: fn(toks) {
          v2.std.diagnostic.bind_outcome(
            o: c_produced_params_tail_tokens(params: rest),
            f: fn(rest_toks) {
              v2.std.diagnostic.outcome_accepted(
                value: v2.std.algebra.list_append(
                  left: v2.std.algebra.list_append(left: [v2.std.compilers.target_model.FixedToken { token_class: ^c_token_comma }], right: toks),
                  right: rest_toks
                )
              )
            }
          )
        }
      )
  }
}

fn c_produced_params_tokens(params: v2.std.collection.List<v2.std.node.Edge>) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  match params {
    std.algebra.Empty => v2.std.diagnostic.outcome_accepted(value: std.algebra.Empty)
    std.algebra.Cons { head: e, tail: rest } =>
      v2.std.diagnostic.bind_outcome(
        o: c_produced_one_param_tokens(edge: e),
        f: fn(first_toks) {
          v2.std.diagnostic.bind_outcome(
            o: c_produced_params_tail_tokens(params: rest),
            f: fn(rest_toks) {
              v2.std.diagnostic.outcome_accepted(value: v2.std.algebra.list_append(left: first_toks, right: rest_toks))
            }
          )
        }
      )
  }
}

fn c_produced_signature_from_name_and_arrow(
  fn_name: v2.std.node.Symbol,
  arrow: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  match v2.std.collection.list_at_optional(xs: v2.std.node_query.node_positional_child_targets(node: arrow), index: 0) {
    v2.std.optional.Present { value: domain } =>
      match v2.std.collection.list_at_optional(xs: v2.std.node_query.node_positional_child_targets(node: arrow), index: 1) {
        v2.std.optional.Present { value: codomain } =>
          v2.std.diagnostic.bind_outcome(
            o: c_produced_type_tokens(type_node: codomain),
            f: fn(ret_toks) {
              v2.std.diagnostic.bind_outcome(
                o: c_produced_params_tokens(params: domain.children),
                f: fn(param_toks) {
                  v2.std.diagnostic.outcome_accepted(
                    value: v2.std.algebra.list_append(
                      left: v2.std.algebra.list_append(
                        left: ret_toks,
                        right: [
                          v2.std.compilers.target_model.BoundToken { token_class: ^c_token_ident, binding: fn_name },
                          v2.std.compilers.target_model.FixedToken { token_class: ^c_token_lparen }
                        ]
                      ),
                      right: v2.std.algebra.list_append(
                        left: param_toks,
                        right: [
                          v2.std.compilers.target_model.FixedToken { token_class: ^c_token_rparen },
                          v2.std.compilers.target_model.FixedToken { token_class: ^c_token_lbrace }
                        ]
                      )
                    )
                  )
                }
              )
            }
          )
        v2.std.optional.Absent =>
          v2.std.diagnostic.outcome_rejected(
            d: c_produced_decl_diagnostic(reason: ^c_produced_signature_codomain_missing, node: arrow)
          )
      }
    v2.std.optional.Absent =>
      v2.std.diagnostic.outcome_rejected(
        d: c_produced_decl_diagnostic(reason: ^c_produced_signature_domain_missing, node: arrow)
      )
  }
}

fn c_produced_decl_render(decl: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetBodiedArrowStatementScaffold> {
  match decl.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      match v2.std.collection.list_at_optional(xs: decl.children, index: 0) {
        v2.std.optional.Present { value: decl_edge } =>
          match decl_edge.label {
            v2.std.node.Named { name: fn_name } =>
              v2.std.diagnostic.bind_outcome(
                o: c_produced_signature_from_name_and_arrow(
                  fn_name: fn_name,
                  arrow: decl_edge.target
                ),
                f: fn(signature_with_open) {
                  v2.std.diagnostic.outcome_accepted(
                    v2.std.compilers.target_model.derive_bodied_arrow_scaffold(
                      signature_with_open: signature_with_open,
                      block_close: [v2.std.compilers.target_model.FixedToken { token_class: ^c_token_rbrace }],
                      mode: v2.std.compilers.target_model.StatementSequenced {
                        return_token: ^c_token_kw_return,
                        statement_terminator: ^c_token_semicolon
                      }
                    )
                  )
                }
              )
            v2.std.node.Positional =>
              v2.std.diagnostic.outcome_rejected(
                d: c_produced_decl_diagnostic(reason: ^c_produced_decl_unnamed, node: decl)
              )
          }
        v2.std.optional.Absent =>
          v2.std.diagnostic.outcome_rejected(
            d: c_produced_decl_diagnostic(reason: ^c_produced_decl_empty, node: decl)
          )
      }
    _ =>
      v2.std.diagnostic.outcome_rejected(
        d: c_produced_decl_diagnostic(reason: ^c_produced_decl_not_conj, node: decl)
      )
  }
}

fn c_produced_decl_support() -> v2.std.compilers.target_model.ProducedDeclSupport {
  v2.std.compilers.target_model.ProducedDeclWired {
    render: c_produced_decl_render,
    scaffold_relation_rule_name: ^c_relation_rule_fn_add,
    scaffold_base_row: c_grammar_relation_row_node(row: c_grammar_relation_row())
  }
}

fn c_target_model() -> v2.std.compilers.target_model.TargetModel {
  v2.std.compilers.target_model.TargetModel {
    produced_decl_support: c_produced_decl_support(),
    bundle: c_target_model_node(),
    lex: c_lex(),
    binding_spellings: c_binding_spellings_with_dag_fixture(),
    token_class_emit_transforms: v2.std.compilers.target_model.target_model_emit_transforms_empty,
    authority_source_text: c_source_text,
    runtime_row: c_runtime_row()
  }
}
