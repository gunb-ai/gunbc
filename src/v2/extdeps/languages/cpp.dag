// 🟢 pretty-much-done — closed signed integer spelling family; testcase: test/claim/manual/cpp_scalar_grounding_anchor.dag.
// 🟢 coproduct dissolution · T29-CPP-SCALAR-FORWARD.
type CppSignedIntegerSurfaceSpelling
  = SignedChar
  | ShortInt
  | Int
  | LongInt
  | LongLongInt

// 🟢 pretty-much-done — closed unsigned integer spelling family; testcase: test/claim/manual/cpp_scalar_grounding_anchor.dag.
// 🟢 coproduct dissolution · T29-CPP-SCALAR-FORWARD.
type CppUnsignedIntegerSurfaceSpelling
  = UnsignedChar
  | UnsignedShortInt
  | UnsignedInt
  | UnsignedLongInt
  | UnsignedLongLongInt

// 🟢 pretty-much-done — singleton plain-char spelling; testcase: test/claim/manual/cpp_scalar_grounding_anchor.dag.
type CppPlainCharSurfaceSpelling

// 🟢 pretty-much-done — singleton wchar_t spelling; testcase: test/claim/manual/cpp_scalar_grounding_anchor.dag.
type CppWcharTSurfaceSpelling

// 🟢 pretty-much-done — closed fixed unsigned code-unit spelling family; testcase: test/claim/manual/cpp_scalar_grounding_anchor.dag.
// 🟢 coproduct dissolution · T29-CPP-SCALAR-FORWARD.
type CppFixedUnsignedCodeUnitIntegerSurfaceSpelling
  = Char8T
  | Char16T
  | Char32T

// 🟢 pretty-much-done — C++20 signed integer representation fact; testcase: test/claim/manual/cpp_scalar_grounding_anchor.dag.
type CppTwosComplement

// 🟡 needs-more-work — generated per-spelling target-profile selection rows still produce these witnesses; testcase: test/claim/manual/cpp_scalar_grounding_anchor.dag.
// 🟡 feature:t4-cpp-scalar-ladder — scaffold:T-4-cpp-slice; dissolve-on: generated per-spelling target-profile selection rows consume CppTargetProfile and select these widths.
type CppSignedIntegerWidthSelection {
  spelling: CppSignedIntegerSurfaceSpelling
  target_profile: CppTargetProfile
}

type CppUnsignedIntegerWidthSelection {
  spelling: CppUnsignedIntegerSurfaceSpelling
  target_profile: CppTargetProfile
}

type CppPlainCharWidthSelection {
  spelling: CppPlainCharSurfaceSpelling
  target_profile: CppTargetProfile
}

type CppWcharTWidthSelection {
  spelling: CppWcharTSurfaceSpelling
  target_profile: CppTargetProfile
}

type CppFixedUnsignedCodeUnitIntegerWidthSelection {
  spelling: CppFixedUnsignedCodeUnitIntegerSurfaceSpelling
  target_profile: CppTargetProfile
}

// Anchor: ISO/IEC 14882:2020 (C++20) [expr.pre]; upstream mirror https://eel.is/c++draft/expr.pre.
// 🟢 pretty-much-done — arm-specific overflow witnesses; testcase: test/claim/manual/cpp_scalar_grounding_anchor.dag.
type CppRepresentableResultRequired
type CppUnsignedModuloArithmetic

// 🟢 pretty-much-done — scalar fact-bundle arms prevent spelling/signedness/overflow cross-pairings; testcase: test/claim/manual/cpp_scalar_grounding_anchor.dag.
// 🟢 coproduct dissolution · T29-CPP-SCALAR-FORWARD.
type CppScalar
  = SignedIntegerScalar {
      width_selection: CppSignedIntegerWidthSelection,
      signed_representation: CppTwosComplement,
      overflow_disposition: CppRepresentableResultRequired
    }
  | UnsignedIntegerScalar {
      width_selection: CppUnsignedIntegerWidthSelection,
      overflow_disposition: CppUnsignedModuloArithmetic
    }
  | PlainCharScalar {
      width_selection: CppPlainCharWidthSelection
    }
  | WcharTScalar {
      width_selection: CppWcharTWidthSelection
    }
  | FixedUnsignedCodeUnitIntegerScalar {
      width_selection: CppFixedUnsignedCodeUnitIntegerWidthSelection,
      unsigned_modulo_arithmetic: CppUnsignedModuloArithmetic
    }
  | BoolScalar

type CppIntegerPrimitiveFacts {
  surface_spelling: Symbol
  width_fact: Node
  signedness_fact: Node
  encoding_fact: Node
  overflow_fact: Node
}

type CppCharacterPrimitiveFacts {
  surface_spelling: Symbol
  width_fact: Node
  signedness_fact: Node
  encoding_fact: Node
}

type CppBoolPrimitiveFacts {
  surface_spelling: Symbol
  encoding_fact: Node
}

type CppLanguageModel {
  language_identity: Symbol
  canonical_symbols: Set<Symbol>
  core: ModelCore
}

// Tokens are the shared v2.std.compilers.target_model ConcreteSyntaxToken carrier (FixedToken | BoundToken);
// per-target C++ coproduct dissolved into that std authority.

type CppGrammarRelationRow {
  production: GrammarProduction
  emitted: Node
  tokens: List<ConcreteSyntaxToken>
}
data cpp_mvp1_source_text: String = "int add(int x, int y) { return x + y; }"

fn cpp_mvp1_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^cpp_token_ty_int },
    BoundToken { token_class: ^cpp_token_ident, binding: ^cpp_binding_fn_add },
    FixedToken { token_class: ^cpp_token_lparen },
    FixedToken { token_class: ^cpp_token_ty_int },
    BoundToken { token_class: ^cpp_token_ident, binding: ^cpp_binding_param_x },
    FixedToken { token_class: ^cpp_token_comma },
    FixedToken { token_class: ^cpp_token_ty_int },
    BoundToken { token_class: ^cpp_token_ident, binding: ^cpp_binding_param_y },
    FixedToken { token_class: ^cpp_token_rparen },
    FixedToken { token_class: ^cpp_token_lbrace },
    FixedToken { token_class: ^cpp_token_kw_return },
    BoundToken { token_class: ^cpp_token_ident, binding: ^cpp_binding_param_x },
    FixedToken { token_class: ^cpp_token_plus },
    BoundToken { token_class: ^cpp_token_ident, binding: ^cpp_binding_param_y },
    FixedToken { token_class: ^cpp_token_semicolon },
    FixedToken { token_class: ^cpp_token_rbrace }
  ]
}
fn cpp_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn cpp_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn cpp_signed_integer_spelling_node(spelling: CppSignedIntegerSurfaceSpelling) -> Node {
  match spelling {
    SignedChar => cpp_atom(id: ^cpp_surface_spelling_signed_char)
    ShortInt => cpp_atom(id: ^cpp_surface_spelling_short_int)
    Int => cpp_atom(id: ^cpp_surface_spelling_int)
    LongInt => cpp_atom(id: ^cpp_surface_spelling_long_int)
    LongLongInt => cpp_atom(id: ^cpp_surface_spelling_long_long_int)
  }
}

fn cpp_unsigned_integer_spelling_node(spelling: CppUnsignedIntegerSurfaceSpelling) -> Node {
  match spelling {
    UnsignedChar => cpp_atom(id: ^cpp_surface_spelling_unsigned_char)
    UnsignedShortInt => cpp_atom(id: ^cpp_surface_spelling_unsigned_short_int)
    UnsignedInt => cpp_atom(id: ^cpp_surface_spelling_unsigned_int)
    UnsignedLongInt => cpp_atom(id: ^cpp_surface_spelling_unsigned_long_int)
    UnsignedLongLongInt => cpp_atom(id: ^cpp_surface_spelling_unsigned_long_long_int)
  }
}

fn cpp_fixed_code_unit_spelling_node(
  spelling: CppFixedUnsignedCodeUnitIntegerSurfaceSpelling
) -> Node {
  match spelling {
    Char8T => cpp_atom(id: ^cpp_surface_spelling_char8_t)
    Char16T => cpp_atom(id: ^cpp_surface_spelling_char16_t)
    Char32T => cpp_atom(id: ^cpp_surface_spelling_char32_t)
  }
}

fn cpp_width_selection_node(spelling: Node, target_profile: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      cpp_named_edge(name: ^cpp_field_width_selection, target: cpp_atom(id: ^cpp_tag_width_selection)),
      cpp_named_edge(name: ^cpp_field_spelling, target: spelling),
      cpp_named_edge(
        name: ^cpp_field_target_profile,
        target: target_profile
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn cpp_target_profile_selection_node(kind: Symbol, target_profile: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      cpp_named_edge(name: ^cpp_field_scalar, target: cpp_atom(id: kind)),
      cpp_named_edge(name: ^cpp_field_target_profile, target: target_profile)
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn cpp_integer_scalar_fact_node(facts: CppIntegerPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      cpp_named_edge(name: ^cpp_field_scalar, target: facts.signedness_fact),
      cpp_named_edge(name: ^cpp_field_width_selection, target: facts.width_fact),
      cpp_named_edge(name: ^cpp_field_signed_representation, target: facts.encoding_fact),
      cpp_named_edge(name: ^cpp_field_overflow_disposition, target: facts.overflow_fact)
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn cpp_character_scalar_fact_node(facts: CppCharacterPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      cpp_named_edge(name: ^cpp_field_scalar, target: facts.signedness_fact),
      cpp_named_edge(name: ^cpp_field_width_selection, target: facts.width_fact),
      cpp_named_edge(name: ^cpp_field_signed_representation, target: facts.encoding_fact)
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn cpp_integer_facts_node(facts: CppIntegerPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      cpp_named_edge(name: ^cpp_field_surface_spelling, target: cpp_atom(id: facts.surface_spelling)),
      cpp_named_edge(name: ^cpp_field_scalar, target: cpp_integer_scalar_fact_node(facts: facts))
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn cpp_character_facts_node(facts: CppCharacterPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      cpp_named_edge(name: ^cpp_field_surface_spelling, target: cpp_atom(id: facts.surface_spelling)),
      cpp_named_edge(name: ^cpp_field_scalar, target: cpp_character_scalar_fact_node(facts: facts))
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn cpp_bool_facts_node(facts: CppBoolPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      cpp_named_edge(name: ^cpp_field_surface_spelling, target: cpp_atom(id: facts.surface_spelling)),
      cpp_named_edge(name: ^cpp_field_scalar, target: cpp_atom(id: ^cpp_tag_bool)),
      cpp_named_edge(name: ^cpp_field_signed_representation, target: facts.encoding_fact)
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn cpp_signed_integer_facts(
  spelling: CppSignedIntegerSurfaceSpelling,
  surface_spelling: Symbol,
  target_profile: Node
) -> CppIntegerPrimitiveFacts {
  let width_fact = cpp_width_selection_node(
    spelling: cpp_signed_integer_spelling_node(spelling: spelling),
    target_profile: target_profile
  )
  CppIntegerPrimitiveFacts {
    surface_spelling: surface_spelling,
    width_fact: width_fact,
    signedness_fact: cpp_atom(id: ^cpp_tag_signed_integer),
    encoding_fact: cpp_atom(id: ^cpp_tag_twos_complement),
    overflow_fact: cpp_atom(id: ^cpp_tag_representable_result_required)
  }
}

fn cpp_unsigned_integer_facts(
  spelling: CppUnsignedIntegerSurfaceSpelling,
  surface_spelling: Symbol,
  target_profile: Node
) -> CppIntegerPrimitiveFacts {
  let width_fact = cpp_width_selection_node(
    spelling: cpp_unsigned_integer_spelling_node(spelling: spelling),
    target_profile: target_profile
  )
  CppIntegerPrimitiveFacts {
    surface_spelling: surface_spelling,
    width_fact: width_fact,
    signedness_fact: cpp_atom(id: ^cpp_tag_unsigned_integer),
    encoding_fact: cpp_atom(id: ^cpp_tag_unsigned_integer_representation),
    overflow_fact: cpp_atom(id: ^cpp_tag_unsigned_modulo_arithmetic)
  }
}

fn cpp_signed_integer_facts_catalog(target_profile: Node) -> List<CppIntegerPrimitiveFacts> {
  [
    cpp_signed_integer_facts(
      spelling: SignedChar,
      surface_spelling: ^cpp_surface_spelling_signed_char,
      target_profile: target_profile
    ),
    cpp_signed_integer_facts(
      spelling: ShortInt,
      surface_spelling: ^cpp_surface_spelling_short_int,
      target_profile: target_profile
    ),
    cpp_signed_integer_facts(
      spelling: Int,
      surface_spelling: ^cpp_surface_spelling_int,
      target_profile: target_profile
    ),
    cpp_signed_integer_facts(
      spelling: LongInt,
      surface_spelling: ^cpp_surface_spelling_long_int,
      target_profile: target_profile
    ),
    cpp_signed_integer_facts(
      spelling: LongLongInt,
      surface_spelling: ^cpp_surface_spelling_long_long_int,
      target_profile: target_profile
    )
  ]
}

fn cpp_unsigned_integer_facts_catalog(target_profile: Node) -> List<CppIntegerPrimitiveFacts> {
  [
    cpp_unsigned_integer_facts(
      spelling: UnsignedChar,
      surface_spelling: ^cpp_surface_spelling_unsigned_char,
      target_profile: target_profile
    ),
    cpp_unsigned_integer_facts(
      spelling: UnsignedShortInt,
      surface_spelling: ^cpp_surface_spelling_unsigned_short_int,
      target_profile: target_profile
    ),
    cpp_unsigned_integer_facts(
      spelling: UnsignedInt,
      surface_spelling: ^cpp_surface_spelling_unsigned_int,
      target_profile: target_profile
    ),
    cpp_unsigned_integer_facts(
      spelling: UnsignedLongInt,
      surface_spelling: ^cpp_surface_spelling_unsigned_long_int,
      target_profile: target_profile
    ),
    cpp_unsigned_integer_facts(
      spelling: UnsignedLongLongInt,
      surface_spelling: ^cpp_surface_spelling_unsigned_long_long_int,
      target_profile: target_profile
    )
  ]
}

fn cpp_integer_facts_catalog(target_profile: Node) -> List<CppIntegerPrimitiveFacts> {
  list_append(
    left: cpp_signed_integer_facts_catalog(target_profile: target_profile),
    right: cpp_unsigned_integer_facts_catalog(target_profile: target_profile)
  )
}

// Anchor: ISO/IEC 14882:2020 [conv.prom] / [expr.arith.conv] — char and short
// promote before usual arithmetic, so they stay in primitive facts only (no T,T→T algebra closure).
fn cpp_signed_integer_algebra_inhabitance_facts_catalog(
  target_profile: Node
) -> List<CppIntegerPrimitiveFacts> {
  [
    cpp_signed_integer_facts(
      spelling: Int,
      surface_spelling: ^cpp_surface_spelling_int,
      target_profile: target_profile
    ),
    cpp_signed_integer_facts(
      spelling: LongInt,
      surface_spelling: ^cpp_surface_spelling_long_int,
      target_profile: target_profile
    ),
    cpp_signed_integer_facts(
      spelling: LongLongInt,
      surface_spelling: ^cpp_surface_spelling_long_long_int,
      target_profile: target_profile
    )
  ]
}

fn cpp_unsigned_integer_algebra_inhabitance_facts_catalog(
  target_profile: Node
) -> List<CppIntegerPrimitiveFacts> {
  [
    cpp_unsigned_integer_facts(
      spelling: UnsignedInt,
      surface_spelling: ^cpp_surface_spelling_unsigned_int,
      target_profile: target_profile
    ),
    cpp_unsigned_integer_facts(
      spelling: UnsignedLongInt,
      surface_spelling: ^cpp_surface_spelling_unsigned_long_int,
      target_profile: target_profile
    ),
    cpp_unsigned_integer_facts(
      spelling: UnsignedLongLongInt,
      surface_spelling: ^cpp_surface_spelling_unsigned_long_long_int,
      target_profile: target_profile
    )
  ]
}

fn cpp_character_facts_catalog(target_profile: Node) -> List<CppCharacterPrimitiveFacts> {
  let char_width_fact = cpp_width_selection_node(
    spelling: cpp_atom(id: ^cpp_surface_spelling_char),
    target_profile: target_profile
  )
  let wchar_t_width_fact = cpp_width_selection_node(
    spelling: cpp_atom(id: ^cpp_surface_spelling_wchar_t),
    target_profile: target_profile
  )
  let char8_t_width_fact = cpp_width_selection_node(
    spelling: cpp_atom(id: ^cpp_surface_spelling_char8_t),
    target_profile: target_profile
  )
  let char16_t_width_fact = cpp_width_selection_node(
    spelling: cpp_atom(id: ^cpp_surface_spelling_char16_t),
    target_profile: target_profile
  )
  let char32_t_width_fact = cpp_width_selection_node(
    spelling: cpp_atom(id: ^cpp_surface_spelling_char32_t),
    target_profile: target_profile
  )
  [
    CppCharacterPrimitiveFacts {
      surface_spelling: ^cpp_surface_spelling_char,
      width_fact: char_width_fact,
      signedness_fact: cpp_target_profile_selection_node(
        kind: ^cpp_tag_plain_char_signedness_selection,
        target_profile: target_profile
      ),
      encoding_fact: cpp_atom(id: ^cpp_tag_plain_char_representation)
    },
    CppCharacterPrimitiveFacts {
      surface_spelling: ^cpp_surface_spelling_wchar_t,
      width_fact: wchar_t_width_fact,
      signedness_fact: cpp_target_profile_selection_node(
        kind: ^cpp_tag_wchar_t_signedness_selection,
        target_profile: target_profile
      ),
      encoding_fact: cpp_atom(id: ^cpp_tag_wchar_t_representation)
    },
    CppCharacterPrimitiveFacts {
      surface_spelling: ^cpp_surface_spelling_char8_t,
      width_fact: char8_t_width_fact,
      signedness_fact: cpp_atom(id: ^cpp_tag_unsigned_integer),
      encoding_fact: cpp_atom(id: ^cpp_tag_unsigned_code_unit_representation)
    },
    CppCharacterPrimitiveFacts {
      surface_spelling: ^cpp_surface_spelling_char16_t,
      width_fact: char16_t_width_fact,
      signedness_fact: cpp_atom(id: ^cpp_tag_unsigned_integer),
      encoding_fact: cpp_atom(id: ^cpp_tag_unsigned_code_unit_representation)
    },
    CppCharacterPrimitiveFacts {
      surface_spelling: ^cpp_surface_spelling_char32_t,
      width_fact: char32_t_width_fact,
      signedness_fact: cpp_atom(id: ^cpp_tag_unsigned_integer),
      encoding_fact: cpp_atom(id: ^cpp_tag_unsigned_code_unit_representation)
    }
  ]
}

fn cpp_bool_facts_catalog() -> List<CppBoolPrimitiveFacts> {
  [
    CppBoolPrimitiveFacts {
      surface_spelling: ^cpp_surface_spelling_bool,
      encoding_fact: cpp_atom(id: ^cpp_tag_bool_representation)
    }
  ]
}

fn cpp_integer_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: CppIntegerPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn cpp_character_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: CppCharacterPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn cpp_bool_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: CppBoolPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn cpp_integer_catalog_surface_symbol(sym: Symbol, target_profile: Node) -> Bool {
  fold_list(
    xs: cpp_integer_facts_catalog(target_profile: target_profile),
    empty: false,
    cons: fn(acc, facts) {
      cpp_integer_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn cpp_character_catalog_surface_symbol(sym: Symbol, target_profile: Node) -> Bool {
  fold_list(
    xs: cpp_character_facts_catalog(target_profile: target_profile),
    empty: false,
    cons: fn(acc, facts) {
      cpp_character_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn cpp_bool_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: cpp_bool_facts_catalog(),
    empty: false,
    cons: fn(acc, facts) {
      cpp_bool_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn cpp_catalog_surface_symbol(sym: Symbol, target_profile: Node) -> Bool {
  cpp_integer_catalog_surface_symbol(sym: sym, target_profile: target_profile) ||
    cpp_character_catalog_surface_symbol(sym: sym, target_profile: target_profile) ||
    cpp_bool_catalog_surface_symbol(sym: sym)
}

fn cpp_language_model_canonical_symbols(target_profile: Node) -> Set<Symbol> {
  Set {
    member: fn(sym) {
      cpp_catalog_surface_symbol(sym: sym, target_profile: target_profile)
    }
  }
}

fn cpp_integer_spec_facts(facts: CppIntegerPrimitiveFacts) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      if axis == discriminant(v: ModelCoreFactAxisSurfaceSpelling {}) {
          Holds { value: cpp_atom(id: facts.surface_spelling) }
      } else if axis == discriminant(v: ModelCoreFactAxisWidth {}) {
          Holds { value: facts.width_fact }
      } else if axis == discriminant(v: ModelCoreFactAxisSignedness {}) {
          Holds { value: facts.signedness_fact }
      } else if axis == discriminant(v: ModelCoreFactAxisEncoding {}) {
          Holds { value: facts.encoding_fact }
      } else if axis == discriminant(v: ModelCoreFactAxisOverflowDisposition {}) {
          Holds { value: facts.overflow_fact }
      } else {
          Violates {
            diagnostic: primitive_fact_axis_unbound_diagnostic(axis: axis)
          }
      }
    }
  }
}

fn cpp_character_spec_facts(facts: CppCharacterPrimitiveFacts) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      if axis == discriminant(v: ModelCoreFactAxisSurfaceSpelling {}) {
          Holds { value: cpp_atom(id: facts.surface_spelling) }
      } else if axis == discriminant(v: ModelCoreFactAxisWidth {}) {
          Holds { value: facts.width_fact }
      } else if axis == discriminant(v: ModelCoreFactAxisSignedness {}) {
          Holds { value: facts.signedness_fact }
      } else if axis == discriminant(v: ModelCoreFactAxisEncoding {}) {
          Holds { value: facts.encoding_fact }
      } else {
          Violates {
            diagnostic: primitive_fact_axis_unbound_diagnostic(axis: axis)
          }
      }
    }
  }
}

fn cpp_bool_spec_facts(facts: CppBoolPrimitiveFacts) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      if axis == discriminant(v: ModelCoreFactAxisSurfaceSpelling {}) {
          Holds { value: cpp_atom(id: facts.surface_spelling) }
      } else if axis == discriminant(v: ModelCoreFactAxisEncoding {}) {
          Holds { value: facts.encoding_fact }
      } else {
          Violates {
            diagnostic: primitive_fact_axis_unbound_diagnostic(axis: axis)
          }
      }
    }
  }
}

fn cpp_primitive_bundle_from_integer_facts(facts: CppIntegerPrimitiveFacts) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: cpp_integer_facts_node(facts: facts),
    spec_facts: cpp_integer_spec_facts(facts: facts)
  }
}

fn cpp_primitive_bundle_from_character_facts(
  facts: CppCharacterPrimitiveFacts
) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: cpp_character_facts_node(facts: facts),
    spec_facts: cpp_character_spec_facts(facts: facts)
  }
}

fn cpp_primitive_bundle_from_bool_facts(facts: CppBoolPrimitiveFacts) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: cpp_bool_facts_node(facts: facts),
    spec_facts: cpp_bool_spec_facts(facts: facts)
  }
}

fn cpp_primitive_bundles_from_integer_catalog(
  target_profile: Node
) -> List<PrimitiveFactBundle> {
  fold_list(
    xs: cpp_integer_facts_catalog(target_profile: target_profile),
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(
        xs: acc,
        item: cpp_primitive_bundle_from_integer_facts(facts: facts)
      )
    }
  )
}

fn cpp_primitive_bundles_from_character_catalog(
  target_profile: Node
) -> List<PrimitiveFactBundle> {
  fold_list(
    xs: cpp_character_facts_catalog(target_profile: target_profile),
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(
        xs: acc,
        item: cpp_primitive_bundle_from_character_facts(facts: facts)
      )
    }
  )
}

fn cpp_primitive_bundles_from_bool_catalog() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: cpp_bool_facts_catalog(),
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(
        xs: acc,
        item: cpp_primitive_bundle_from_bool_facts(facts: facts)
      )
    }
  )
}

fn cpp_wave1_primitive_fact_bundles(
  target_profile: Node
) -> List<PrimitiveFactBundle> {
  list_append(
    left: list_append(
      left: cpp_primitive_bundles_from_integer_catalog(target_profile: target_profile),
      right: cpp_primitive_bundles_from_character_catalog(target_profile: target_profile)
    ),
    right: cpp_primitive_bundles_from_bool_catalog()
  )
}

fn cpp_integer_algebra_witness_node(facts: CppIntegerPrimitiveFacts, witness: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      cpp_named_edge(name: witness, target: cpp_atom(id: witness)),
      cpp_named_edge(name: ^cpp_field_surface_spelling, target: cpp_atom(id: facts.surface_spelling)),
      cpp_named_edge(name: ^cpp_field_width_selection, target: facts.width_fact),
      cpp_named_edge(name: ^cpp_field_scalar, target: facts.signedness_fact),
      cpp_named_edge(name: ^cpp_field_signed_representation, target: facts.encoding_fact),
      cpp_named_edge(name: ^cpp_field_overflow_disposition, target: facts.overflow_fact)
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn cpp_signed_integer_algebra_witness_node(facts: CppIntegerPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      cpp_named_edge(
        name: ^cpp_witness_representable_result_integer_arithmetic,
        target: cpp_atom(id: ^cpp_witness_representable_result_integer_arithmetic)
      ),
      cpp_named_edge(
        name: ^cpp_precondition_signed_integer_result_representable,
        target: cpp_atom(id: ^cpp_precondition_signed_integer_result_representable)
      ),
      cpp_named_edge(name: ^cpp_field_surface_spelling, target: cpp_atom(id: facts.surface_spelling)),
      cpp_named_edge(name: ^cpp_field_width_selection, target: facts.width_fact),
      cpp_named_edge(name: ^cpp_field_scalar, target: facts.signedness_fact),
      cpp_named_edge(name: ^cpp_field_signed_representation, target: facts.encoding_fact),
      cpp_named_edge(name: ^cpp_field_overflow_disposition, target: facts.overflow_fact)
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn cpp_signed_integer_algebra_inhabitance(facts: CppIntegerPrimitiveFacts) -> AlgebraInhabitanceDecl {
  let inhabitant = cpp_integer_facts_node(facts: facts)
  AlgebraInhabitanceDecl {
    algebra: ordered_ring_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: cpp_signed_integer_algebra_witness_node(facts: facts)
  }
}

fn cpp_unsigned_integer_algebra_inhabitance(facts: CppIntegerPrimitiveFacts) -> AlgebraInhabitanceDecl {
  let inhabitant = cpp_integer_facts_node(facts: facts)
  AlgebraInhabitanceDecl {
