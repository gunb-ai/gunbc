fn cpp_algebra_operation_node(operation: Symbol) -> Node {
  cpp_atom(id: operation)
}

fn cpp_fail_closed_partial_operation(
  operation: Node,
  precondition: Symbol,
  reason: Symbol
) -> PartialOperationDecl {
  PartialOperationDecl {
    operation: operation,
    precondition: cpp_atom(id: precondition),
    discharge: FailClosedAtBoundary { reason: reason }
  }
}

// Partiality keys off canonical OrderedRing field identities from v2.std.algebra
// (ring_field_add / ring_field_mul / group_field_inverse), not target-private op symbols.
// Subtraction is not an exported ring field; representable-result for sub is covered
// via the additive/inverse carriers until a canonical subtract ref lands in std.algebra.
fn cpp_partiality_semantics_wave1() -> PartialitySemanticsDecl {
  PartialitySemanticsDecl {
    operations: [
      cpp_fail_closed_partial_operation(
        operation: cpp_algebra_operation_node(operation: ring_field_add),
        precondition: ^cpp_precondition_signed_integer_result_representable,
        reason: ^cpp_partial_signed_integer_result_not_representable
      ),
      cpp_fail_closed_partial_operation(
        operation: cpp_algebra_operation_node(operation: ring_field_mul),
        precondition: ^cpp_precondition_signed_integer_result_representable,
        reason: ^cpp_partial_signed_integer_result_not_representable
      ),
      cpp_fail_closed_partial_operation(
        operation: cpp_algebra_operation_node(operation: group_field_inverse),
        precondition: ^cpp_precondition_signed_integer_result_representable,
        reason: ^cpp_partial_signed_integer_result_not_representable
      )
    ]
  }
}

fn cpp_model_core_wave1(target_profile: Node) -> ModelCore {
  ModelCore {
    primitives: cpp_wave1_primitive_fact_bundles(target_profile: target_profile),
    inhabitance: cpp_model_core_inhabitance_decls(target_profile: target_profile),
    laws: [],
    effects: EffectSemanticsDecl { operations: [] },
    partiality: cpp_partiality_semantics_wave1()
  }
}

fn cpp_language_model_wave1(target_profile: Node) -> CppLanguageModel {
  CppLanguageModel {
    language_identity: ^cpp_language_model_surface_id,
    canonical_symbols: cpp_language_model_canonical_symbols(target_profile: target_profile),
    core: cpp_model_core_wave1(target_profile: target_profile)
  }
}

fn cpp_int_inhabitant_node(target_profile: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      cpp_named_edge(name: ^cpp_inhabitant_field_atom, target: cpp_atom(id: ^cpp_inhabitant_int)),
      cpp_named_edge(
        name: ^cpp_inhabitant_field_facts,
        target: cpp_integer_facts_node(
          facts: cpp_signed_integer_facts(
            spelling: Int,
            surface_spelling: ^cpp_surface_spelling_int,
            target_profile: target_profile
          )
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn cpp_declared_inhabitants_root(target_profile: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      cpp_named_edge(name: ^cpp_inhabitant_field_int, target: cpp_int_inhabitant_node(target_profile: target_profile))
    ],
    occurrence_id: SyntheticOccurrence
}
}

// Zip-fold support nodes derived from cpp signed-int facts — not parallel fixture data.
// 🟡 gated — feature:W-T-10-mvp1-exact-zip-closure — bind gunbc#4760 — dissolve-on: find_witness enumerates inside declared_inhabitants without fixture zip-fold support edges.
fn cpp_mvp1_int_zip_fold_closure_edges(target_profile: Node) -> List<Edge> {
  let facts = cpp_signed_integer_facts(
    spelling: Int,
    surface_spelling: ^cpp_surface_spelling_int,
    target_profile: target_profile
  )
  [
    cpp_named_edge(
      name: ^cpp_inhabitant_field_int,
      target: cpp_int_inhabitant_node(target_profile: target_profile)
    ),
    cpp_named_edge(
      name: ^cpp_inhabitant_field_mvp1_add_fn,
      target: cpp_mvp1_emitted_add_fn_node(target_profile: target_profile)
    ),
    cpp_named_edge(
      name: ^cpp_coercion_field_int_inhabitant_atom,
      target: cpp_atom(id: ^cpp_inhabitant_int)
    ),
    cpp_named_edge(
      name: ^cpp_coercion_field_int_facts,
      target: cpp_integer_facts_node(facts: facts)
    ),
    cpp_named_edge(
      name: ^cpp_coercion_field_int_spelling,
      target: cpp_atom(id: ^cpp_surface_spelling_int)
    ),
    cpp_named_edge(
      name: ^cpp_coercion_field_int_signed,
      target: cpp_atom(id: ^cpp_tag_signed_integer)
    ),
    cpp_named_edge(
      name: ^cpp_coercion_field_int_width,
      target: cpp_atom(id: ^cpp_tag_width_selection)
    ),
    cpp_named_edge(
      name: ^cpp_coercion_field_int_encoding,
      target: cpp_atom(id: ^cpp_tag_twos_complement)
    ),
    cpp_named_edge(
      name: ^cpp_coercion_field_int_overflow,
      target: cpp_atom(id: ^cpp_tag_representable_result_required)
    ),
    cpp_named_edge(
      name: ^cpp_coercion_field_int_scalar,
      target: cpp_integer_scalar_fact_node(facts: facts)
    ),
    cpp_named_edge(
      name: ^cpp_coercion_field_int_width_fact,
      target: facts.width_fact
    ),
    cpp_named_edge(
      name: ^cpp_coercion_field_int_spelling_node,
      target: cpp_signed_integer_spelling_node(spelling: Int)
    ),
    cpp_named_edge(
      name: ^cpp_coercion_field_int_target_profile,
      target: target_profile
    )
  ]
}

fn cpp_mvp1_coercion_candidate_edges(target_profile: Node) -> List<Edge> {
  cpp_mvp1_int_zip_fold_closure_edges(target_profile: target_profile)
}

fn cpp_mvp1_declared_inhabitants_root(target_profile: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: cpp_mvp1_coercion_candidate_edges(target_profile: target_profile),
    occurrence_id: SyntheticOccurrence
}
}

fn cpp_mvp1_selection_policy_node(target_profile: Node) -> Node {
  cpp_int_inhabitant_node(target_profile: target_profile)
}

fn cpp_mvp1_emitted_add_fn_node(target_profile: Node) -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: cpp_int_inhabitant_node(target_profile: target_profile) },
      Edge { label: Positional, target: cpp_int_inhabitant_node(target_profile: target_profile) },
      Edge { label: Positional, target: cpp_int_inhabitant_node(target_profile: target_profile) }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn cpp_concrete_token_node(token: ConcreteSyntaxToken) -> Node {
  // T-11: serialize through the single shared morphism (no parallel wire authority).
  concrete_syntax_token_to_node(token: token)
}



fn cpp_mvp1_serialize_source_children() -> List<Edge> {
  list_append(
    left: [
      cpp_named_edge(name: ^serialize_source_field_source_text, target: cpp_atom(id: ^cpp_mvp1_source_literal)),
      cpp_named_edge(name: ^serialize_source_field_source_grammar, target: cpp_atom(id: ^cpp_production_mvp1_fn_add))
    ],
    right: [
      cpp_named_edge(
        name: grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: cpp_mvp1_concrete_tokens(),
          token_to_node: cpp_concrete_token_node
        )
      )
    ]
  )
}

fn cpp_mvp1_serialize_source_node() -> Node {
  Node { kind: TypeNode { connective: Conj }, children: cpp_mvp1_serialize_source_children(),
 occurrence_id: SyntheticOccurrence
}
}


fn cpp_formal_rhs_from_tokens(tokens: List<ConcreteSyntaxToken>) -> List<FormalGrammarSymbol> {
  fold_list(
    xs: tokens,
    empty: Empty,
    cons: fn(acc, token) {
      list_snoc_item(
        xs: acc,
        item: grammar_formal_terminal(identity: concrete_syntax_token_class(token: token))
      )
    }
  )
}

fn cpp_formal_production_mvp1_fn_add() -> FormalProduction {
  grammar_formal_production(
    lhs: ^cpp_production_mvp1_fn_add,
    rhs: cpp_formal_rhs_from_tokens(tokens: cpp_mvp1_concrete_tokens())
  )
}

fn cpp_wave1_formal_productions() -> List<FormalProduction> {
  [cpp_formal_production_mvp1_fn_add()]
}

fn cpp_grammar_terminal(token_class: Symbol) -> GrammarExpr {
  Terminal { token_class: token_class }
}

type CppGramBuild1State
  = CppGramBuild1StateInit
  | CppGramBuild1StateReady { expr: GrammarExpr }

fn cpp_grammar_sequence_from_token_classes() -> GrammarExpr {
  match fold_list(
    xs: cpp_mvp1_concrete_tokens(),
    empty: CppGramBuild1StateInit,
    cons: fn(state, token) {
      match state {
        CppGramBuild1StateInit =>
          CppGramBuild1StateReady {
            expr: cpp_grammar_terminal(token_class: concrete_syntax_token_class(token: token))
          }
        CppGramBuild1StateReady { expr: acc } =>
          CppGramBuild1StateReady {
            expr: Sequence {
              left: acc,
              right: cpp_grammar_terminal(token_class: concrete_syntax_token_class(token: token))
            }
          }
      }
    }
  ) {
    CppGramBuild1StateInit =>
      cpp_grammar_terminal(token_class: ^cpp_token_ty_int)
    CppGramBuild1StateReady { expr: result } => result
  }
}

fn cpp_grammar_production_mvp1_fn_add(target_profile: Node) -> GrammarProduction {
  GrammarProduction {
    name: ^cpp_production_mvp1_fn_add,
    expression: cpp_grammar_sequence_from_token_classes(),
    emitted: cpp_mvp1_emitted_add_fn_node(target_profile: target_profile)
  }
}

fn cpp_mvp1_grammar_relation_row(target_profile: Node) -> CppGrammarRelationRow {
  CppGrammarRelationRow {
    production: cpp_grammar_production_mvp1_fn_add(target_profile: target_profile),
    emitted: cpp_mvp1_emitted_add_fn_node(target_profile: target_profile),
    tokens: cpp_mvp1_concrete_tokens()
  }
}


fn cpp_grammar_relation_row_node(row: CppGrammarRelationRow) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      cpp_named_edge(name: grammar_relation_field_production, target: grammar_production_to_node(production: row.production)),
      cpp_named_edge(name: grammar_relation_field_emitted, target: row.emitted),
      cpp_named_edge(
        name: grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: row.tokens,
          token_to_node: cpp_concrete_token_node
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn cpp_mvp1_translation_rules_node(target_profile: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      cpp_named_edge(name: ^cpp_relation_rule_mvp1_fn_add, target: cpp_grammar_relation_row_node(row: cpp_mvp1_grammar_relation_row(target_profile: target_profile)))
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn cpp_mvp1_target_model_node(target_profile: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      cpp_named_edge(name: target_model_edge_selection_policy, target: cpp_mvp1_selection_policy_node(target_profile: target_profile)),
      cpp_named_edge(name: target_model_edge_declared_inhabitants, target: cpp_mvp1_declared_inhabitants_root(target_profile: target_profile)),
      cpp_named_edge(name: target_model_edge_translation_rules, target: cpp_mvp1_translation_rules_node(target_profile: target_profile)),
      cpp_named_edge(name: target_model_edge_serialize_source, target: cpp_mvp1_serialize_source_node())
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn cpp_mvp1_binding_spellings() -> Map<Symbol, String> {
  map_insert(
    map_insert(
      map_insert(empty_map(), ^cpp_binding_fn_add, "add"),
      ^cpp_binding_param_x,
      "x"
    ),
    ^cpp_binding_param_y,
    "y"
  )
}
data cpp_mvp1_target_profile: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^cpp_mvp1_target_profile_atom } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn cpp_mvp1_target_model() -> TargetModel {
  cpp_mvp1_target_model_for_profile(target_profile: cpp_mvp1_target_profile)
}

fn cpp_mvp1_target_model_for_profile(target_profile: Node) -> TargetModel {
  TargetModel {
    bundle: cpp_mvp1_target_model_node(target_profile: target_profile),
    lex: cpp_wave1_lex(),
    binding_spellings: cpp_mvp1_binding_spellings(),
    authority_source_text: cpp_mvp1_source_text
  }
}

fn cpp_lex_rule(token_class: Symbol, text: String) -> LexRule {
  TokenRule { token_class: token_class, pattern: LiteralPattern { text: text } }
}

fn cpp_wave1_lex_rules() -> List<LexRule> {
  [
    cpp_lex_rule(token_class: ^cpp_token_ty_int, text: "int "),
    cpp_lex_rule(token_class: ^cpp_token_lparen, text: "("),
    cpp_lex_rule(token_class: ^cpp_token_comma, text: ", "),
    cpp_lex_rule(token_class: ^cpp_token_rparen, text: ") "),
    cpp_lex_rule(token_class: ^cpp_token_lbrace, text: "{ "),
    cpp_lex_rule(token_class: ^cpp_token_kw_return, text: "return "),
    cpp_lex_rule(token_class: ^cpp_token_plus, text: " + "),
    cpp_lex_rule(token_class: ^cpp_token_semicolon, text: ";"),
    cpp_lex_rule(token_class: ^cpp_token_rbrace, text: " }")
  ]
}

fn cpp_wave1_lex() -> LexRules {
  ModeledLexRules { root: LexRuleSet { rules: cpp_wave1_lex_rules() } }
}

// Anchor: https://eel.is/c++draft/basic.fundamental
// 🟡 canonical-B decl-ref · E-6(b) bounded-exception · scaffold feature:canonical-b-grounding-consumer · dissolve-on: B1-CANON+zip-fold consume (ledger: B1·T-9/C1)
data cpp_bool_grounding: BooleanAlgebra<Bool> = bool_boolean_algebra
