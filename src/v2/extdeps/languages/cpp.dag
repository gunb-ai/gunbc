    inhabitant: inhabitant,
    witness: cpp_integer_algebra_witness_node(
      facts: facts,
      witness: ^cpp_witness_commutative_semiring_integer
    )
  }
}

fn cpp_bool_algebra_witness_node(facts: CppBoolPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      cpp_named_edge(name: ^cpp_witness_bool_boolean_algebra, target: cpp_atom(id: ^cpp_witness_bool_boolean_algebra)),
      cpp_named_edge(name: ^cpp_field_surface_spelling, target: cpp_atom(id: facts.surface_spelling)),
      cpp_named_edge(name: ^cpp_field_signed_representation, target: facts.encoding_fact)
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn cpp_bool_algebra_inhabitance(facts: CppBoolPrimitiveFacts) -> AlgebraInhabitanceDecl {
