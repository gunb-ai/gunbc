module v2.extdeps.languages.llvm_ir


type FloatKind
  = HalfFloat
  | BFloatFloat
  | SingleFloat
  | DoubleFloat
  | Fp128Float
  | X86Fp80Float
  | PpcFp128Float

type LlvmType
  = VoidType
  | LabelType
  | TokenType
  | MetadataType
  | IntegerType { bits: v2.std.cardinality.NonZeroNat }
  | FloatingType { kind: FloatKind }
  | PointerType { address_space: v2.std.nat.Nat }
  | VectorType { element: LlvmType, count: v2.std.cardinality.NonZeroNat, scalable: VectorScaling }
  | ArrayType { element: LlvmType, count: v2.std.nat.Nat }
  | StructType { fields: List<LlvmType>, packed: StructPacking }
  | FunctionType { result: LlvmType, params: List<LlvmType>, var_arg: VarArg }
  | NamedType { name: v2.std.node.Symbol }

type VectorScaling
  = FixedVector
  | ScalableVector

type StructPacking
  = NaturalAligned
  | Packed

type VarArg
  = FixedArity
  | Variadic

type LlvmConstant
  = IntConstant { ty: LlvmType, value: Int }
  | FloatConstant { ty: LlvmType, bits: Int }
  | NullPointer { ty: LlvmType }
  | NoneToken
  | AggregateConstant { ty: LlvmType, elements: List<LlvmConstant> }
  | ZeroInitializer { ty: LlvmType }
  | UndefValue { ty: LlvmType }
  | PoisonValue { ty: LlvmType }
  | BlockAddress { function: v2.std.node.Symbol, block: v2.std.node.Symbol }
  | GlobalAddress { name: v2.std.node.Symbol }
  | ConstantExpr { op: ConstExprOpcode, operands: List<LlvmConstant>, result_type: LlvmType }

type LlvmValue
  = LocalRef { name: v2.std.node.Symbol }
  | ConstantOperand { constant: LlvmConstant }
  | GlobalRef { name: v2.std.node.Symbol }

type BinaryOpcode
  = OpAdd | OpSub | OpMul | OpUDiv | OpSDiv | OpURem | OpSRem
  | OpShl | OpLShr | OpAShr | OpAnd | OpOr | OpXor
  | OpFAdd | OpFSub | OpFMul | OpFDiv | OpFRem

type ConversionOpcode
  = OpTrunc | OpZExt | OpSExt
  | OpFPTrunc | OpFPExt
  | OpFPToUI | OpFPToSI | OpUIToFP | OpSIToFP
  | OpPtrToInt | OpIntToPtr | OpBitCast | OpAddrSpaceCast

type IntPredicate
  = IcmpEq | IcmpNe
  | IcmpUgt | IcmpUge | IcmpUlt | IcmpUle
  | IcmpSgt | IcmpSge | IcmpSlt | IcmpSle

type FloatPredicate
  = FcmpFalse
  | FcmpOeq | FcmpOgt | FcmpOge | FcmpOlt | FcmpOle | FcmpOne | FcmpOrd
  | FcmpUeq | FcmpUgt | FcmpUge | FcmpUlt | FcmpUle | FcmpUne | FcmpUno
  | FcmpTrue

type ConstExprOpcode
  = CeTrunc | CePtrToInt | CeIntToPtr | CeBitCast
  | CeAddrSpaceCast | CeGetElementPtr
  | CeAdd | CeSub | CeMul | CeShl | CeXor
  | CeICmp | CeFCmp
  | CeExtractElement | CeInsertElement | CeShuffleVector

type PhiIncoming {
  value: LlvmValue
  block: v2.std.node.Symbol
}

type PhiNode {
  result: v2.std.node.Symbol
  result_type: LlvmType
  incomings: List<PhiIncoming>
}

type SwitchCase {
  match_value: LlvmConstant
  target: v2.std.node.Symbol
}

type CallArgument {
  ty: LlvmType
  value: LlvmValue
}

type CallResult
  = VoidCall
  | ValueCall { name: v2.std.node.Symbol, result_type: LlvmType }

type LandingPadCleanup
  = IsCleanup
  | NotCleanup

type LandingClause
  = CatchClause { type_info: LlvmValue }
  | FilterClause { type_infos: List<LlvmValue> }

type AtomicOrdering
  = OrderingUnordered
  | OrderingMonotonic
  | OrderingAcquire
  | OrderingRelease
  | OrderingAcqRel
  | OrderingSeqCst

type CmpXchgSuccessOrdering
  = SuccessMonotonic
  | SuccessAcquire
  | SuccessRelease
  | SuccessAcqRel
  | SuccessSeqCst

type CmpXchgFailureOrdering
  = FailureMonotonic
  | FailureAcquire
  | FailureSeqCst

type FenceOrdering
  = FenceAcquire
  | FenceRelease
  | FenceAcqRel
  | FenceSeqCst

type AtomicRmwOrdering
  = RmwOrdMonotonic
  | RmwOrdAcquire
  | RmwOrdRelease
  | RmwOrdAcqRel
  | RmwOrdSeqCst

type AtomicRmwOp
  = RmwXchg | RmwAdd | RmwSub | RmwAnd | RmwNand | RmwOr | RmwXor
  | RmwMax | RmwMin | RmwUMax | RmwUMin | RmwFAdd | RmwFSub
  | RmwFMax | RmwFMin | RmwUIncWrap | RmwUDecWrap

type LlvmInstruction
  = Binary {
      result: v2.std.node.Symbol
      result_type: LlvmType
      op: BinaryOpcode
      lhs: LlvmValue
      rhs: LlvmValue
    }
  | Conversion {
      result: v2.std.node.Symbol
      result_type: LlvmType
      op: ConversionOpcode
      value: LlvmValue
    }
  | IntCompare {
      result: v2.std.node.Symbol
      predicate: IntPredicate
      lhs: LlvmValue
      rhs: LlvmValue
    }
  | FloatCompare {
      result: v2.std.node.Symbol
      predicate: FloatPredicate
      lhs: LlvmValue
      rhs: LlvmValue
    }
  | Alloca {
      result: v2.std.node.Symbol
      allocated_type: LlvmType
      element_count: LlvmValue
    }
  | Load {
      result: v2.std.node.Symbol
      result_type: LlvmType
      pointer: LlvmValue
      ordering: LoadAtomicity
    }
  | Store {
      value: LlvmValue
      pointer: LlvmValue
      ordering: StoreAtomicity
    }
  | GetElementPtr {
      result: v2.std.node.Symbol
      source_type: LlvmType
      base: LlvmValue
      indices: List<LlvmValue>
    }
  | AtomicRmw {
      result: v2.std.node.Symbol
      op: AtomicRmwOp
      pointer: LlvmValue
      operand: LlvmValue
      ordering: AtomicRmwOrdering
    }
  | CmpXchg {
      result: v2.std.node.Symbol
      pointer: LlvmValue
      compare_value: LlvmValue
      new_value: LlvmValue
      success_ordering: CmpXchgSuccessOrdering
      failure_ordering: CmpXchgFailureOrdering
    }
  | Fence {
      ordering: FenceOrdering
    }
  | ExtractValue {
      result: v2.std.node.Symbol
      aggregate: LlvmValue
      indices: List<Int>
    }
  | InsertValue {
      result: v2.std.node.Symbol
      aggregate: LlvmValue
      element: LlvmValue
      indices: List<Int>
    }
  | ExtractElement {
      result: v2.std.node.Symbol
      vector: LlvmValue
      index: LlvmValue
    }
  | InsertElement {
      result: v2.std.node.Symbol
      vector: LlvmValue
      element: LlvmValue
      index: LlvmValue
    }
  | ShuffleVector {
      result: v2.std.node.Symbol
      first: LlvmValue
      second: LlvmValue
      mask: LlvmValue
    }
  | Select {
      result: v2.std.node.Symbol
      condition: LlvmValue
      if_true: LlvmValue
      if_false: LlvmValue
    }
  | Call {
      callee: LlvmValue
      arguments: List<CallArgument>
      result: CallResult
    }
  | Freeze {
      result: v2.std.node.Symbol
      value: LlvmValue
    }
  | FNeg {
      result: v2.std.node.Symbol
      result_type: LlvmType
      operand: LlvmValue
    }
  | VaArg {
      result: v2.std.node.Symbol
      result_type: LlvmType
      va_list: LlvmValue
      arg_type: LlvmType
    }
  | LandingPad {
      result: v2.std.node.Symbol
      result_type: LlvmType
      is_cleanup: LandingPadCleanup
      clauses: List<LandingClause>
    }
  | CatchPad {
      result: v2.std.node.Symbol
      catch_switch: LlvmValue
      args: List<LlvmValue>
    }
  | CleanupPad {
      result: v2.std.node.Symbol
      parent_pad: LlvmValue
      args: List<LlvmValue>
    }

type LoadOrdering
  = LoadUnordered
  | LoadMonotonic
  | LoadAcquire
  | LoadSeqCst

type StoreOrdering
  = StoreUnordered
  | StoreMonotonic
  | StoreRelease
  | StoreSeqCst

type LoadAtomicity
  = PlainLoad
  | AtomicLoad { ordering: LoadOrdering }

type StoreAtomicity
  = PlainStore
  | AtomicStore { ordering: StoreOrdering }

type Terminator
  = RetVoid
  | RetValue { value: LlvmValue }
  | UnconditionalBr { target: v2.std.node.Symbol }
  | ConditionalBr { condition: LlvmValue, if_true: v2.std.node.Symbol, if_false: v2.std.node.Symbol }
  | Switch { value: LlvmValue, default_target: v2.std.node.Symbol, cases: List<SwitchCase> }
  | IndirectBr { address: LlvmValue, possible_targets: List<v2.std.node.Symbol> }
  | Unreachable
  | Invoke {
      callee: LlvmValue
      arguments: List<CallArgument>
      result: CallResult
      normal_target: v2.std.node.Symbol
      unwind_target: v2.std.node.Symbol
    }
  | CallBr {
      callee: LlvmValue
      arguments: List<CallArgument>
      result: CallResult
      fallthrough: v2.std.node.Symbol
      indirect_targets: List<v2.std.node.Symbol>
    }
  | Resume { value: LlvmValue }
  | CatchSwitch { result: v2.std.node.Symbol, parent_pad: LlvmValue, handlers: List<v2.std.node.Symbol>, unwind: UnwindDest }
  | CleanupRet { cleanup_pad: LlvmValue, unwind: UnwindDest }
  | CatchRet { catch_pad: LlvmValue, successor: v2.std.node.Symbol }

type UnwindDest
  = UnwindToCaller
  | UnwindToLabel { target: v2.std.node.Symbol }

type BasicBlock {
  label: v2.std.node.Symbol
  phis: List<PhiNode>
  body: List<LlvmInstruction>
  terminator: Terminator
}

type Linkage
  = LinkagePrivate
  | LinkageInternal
  | LinkageAvailableExternally
  | LinkageLinkOnce
  | LinkageLinkOnceOdr
  | LinkageWeak
  | LinkageWeakOdr
  | LinkageCommon
  | LinkageAppending
  | LinkageExternal
  | LinkageExternalWeak

type FunctionBody
  = Declared
  | Defined { entry: BasicBlock, rest: List<BasicBlock> }

type FunctionParameter {
  ty: LlvmType
  name: v2.std.node.Symbol
}

type LlvmFunction {
  name: v2.std.node.Symbol
  result_type: LlvmType
  parameters: List<FunctionParameter>
  var_arg: VarArg
  linkage: Linkage
  body: FunctionBody
}

type GlobalMutability
  = MutableGlobal
  | ConstantGlobal

type GlobalInitializer
  = ExternalInit
  | InitializedWith { constant: LlvmConstant }

type LlvmGlobal {
  name: v2.std.node.Symbol
  value_type: LlvmType
  mutability: GlobalMutability
  linkage: Linkage
  initializer: GlobalInitializer
  address_space: Int
}

type NamedStructDef {
  name: v2.std.node.Symbol
  definition: LlvmType
}

type LlvmModule {
  data_layout: v2.std.node.Symbol
  target_triple: v2.std.node.Symbol
  named_structs: List<NamedStructDef>
  globals: List<LlvmGlobal>
  functions: List<LlvmFunction>
}

fn unwind_successors(d: UnwindDest) -> List<v2.std.node.Symbol> {
  match d {
    UnwindToCaller => []
    UnwindToLabel { target: t } => [t]
  }
}

fn block_successors(t: Terminator) -> List<v2.std.node.Symbol> {
  match t {
    RetVoid => []
    RetValue { value: _ } => []
    UnconditionalBr { target: tgt } => [tgt]
    ConditionalBr { condition: _, if_true: a, if_false: b } => [a, b]
    Switch { value: _, default_target: d, cases: cs } =>
      concat([d], map(cs, fn(c) { c.target }))
    IndirectBr { address: _, possible_targets: ts } => ts
    Unreachable => []
    Invoke { callee: _, arguments: _, result: _, normal_target: n, unwind_target: u } => [n, u]
    CallBr { callee: _, arguments: _, result: _, fallthrough: f, indirect_targets: it } =>
      concat([f], it)
    Resume { value: _ } => []
    CatchSwitch { result: _, parent_pad: _, handlers: hs, unwind: u } => concat(hs, unwind_successors(d: u))
    CleanupRet { cleanup_pad: _, unwind: u } => unwind_successors(d: u)
    CatchRet { catch_pad: _, successor: s } => [s]
  }
}

fn block_well_formed(b: BasicBlock) -> Bool {
  match b.terminator {
    CatchSwitch { result: _, parent_pad: _, handlers: _, unwind: _ } => count(b.body) == 0
    _ => true
  }
}

type FidelityFeature
  = StructuralCore
  | SsaValueSpelling
  | BlockTextualOrder
  | LexicalTrivia
  | TargetConfigToken
  | AdvisoryMetadata
  | UnmodeledInlineAsm
  | UnmodeledSemanticAttribute
  | UnmodeledType
  | UnmodeledInstruction
  | UnmodeledConstExpr
  | MalformedStructure

fn feature_disposition(f: FidelityFeature) -> FidelityDisposition<FidelityFeature> {
  match f {
    StructuralCore => Modeled
    SsaValueSpelling => v2.extdeps.languages.fidelity.DeclaredNormalized { feature: SsaValueSpelling }
    BlockTextualOrder => v2.extdeps.languages.fidelity.DeclaredNormalized { feature: BlockTextualOrder }
    LexicalTrivia => v2.extdeps.languages.fidelity.DeclaredNormalized { feature: LexicalTrivia }
    TargetConfigToken => v2.extdeps.languages.fidelity.DeclaredNormalized { feature: TargetConfigToken }
    AdvisoryMetadata => v2.extdeps.languages.fidelity.DeclaredNormalized { feature: AdvisoryMetadata }
    UnmodeledInlineAsm => FailClosed { feature: UnmodeledInlineAsm }
    UnmodeledSemanticAttribute => FailClosed { feature: UnmodeledSemanticAttribute }
    UnmodeledType => FailClosed { feature: UnmodeledType }
    UnmodeledInstruction => FailClosed { feature: UnmodeledInstruction }
    UnmodeledConstExpr => FailClosed { feature: UnmodeledConstExpr }
    MalformedStructure => FailClosed { feature: MalformedStructure }
  }
}

type LlvmIntegerBits
  = LlvmBits32
  | LlvmBits64

type LlvmFloatKind
  = LlvmHalfFloat
  | LlvmSingleFloat
  | LlvmDoubleFloat

type LlvmIntegerPrimitiveFacts {
  surface_spelling: v2.std.node.Symbol
  bits: LlvmIntegerBits
  std_projection: v2.std.node.Symbol
}

type LlvmFloatPrimitiveFacts {
  surface_spelling: v2.std.node.Symbol
  kind: LlvmFloatKind
  std_projection: v2.std.node.Symbol
}
data llvm_facts_i32: LlvmIntegerPrimitiveFacts = LlvmIntegerPrimitiveFacts {
  surface_spelling: ^llvm_surface_spelling_i32,
  bits: LlvmBits32,
  std_projection: ^llvm_std_projection_i32,
}

data llvm_facts_i64: LlvmIntegerPrimitiveFacts = LlvmIntegerPrimitiveFacts {
  surface_spelling: ^llvm_surface_spelling_i64,
  bits: LlvmBits64,
  std_projection: ^llvm_std_projection_i64,
}

data llvm_integer_facts_catalog: List<LlvmIntegerPrimitiveFacts> = [
  llvm_facts_i32,
  llvm_facts_i64,
]

data llvm_facts_half: LlvmFloatPrimitiveFacts = LlvmFloatPrimitiveFacts {
  surface_spelling: ^llvm_surface_spelling_half,
  kind: LlvmHalfFloat,
  std_projection: ^llvm_std_projection_half,
}

data llvm_facts_float: LlvmFloatPrimitiveFacts = LlvmFloatPrimitiveFacts {
  surface_spelling: ^llvm_surface_spelling_float,
  kind: LlvmSingleFloat,
  std_projection: ^llvm_std_projection_float,
}

data llvm_facts_double: LlvmFloatPrimitiveFacts = LlvmFloatPrimitiveFacts {
  surface_spelling: ^llvm_surface_spelling_double,
  kind: LlvmDoubleFloat,
  std_projection: ^llvm_std_projection_double,
}

data llvm_float_facts_catalog: List<LlvmFloatPrimitiveFacts> = [
  llvm_facts_half,
  llvm_facts_float,
  llvm_facts_double,
]

fn llvm_inhabitant_atom(id: v2.std.node.Symbol) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn llvm_integer_bits_node(bits: LlvmIntegerBits) -> Node {
  match bits {
    LlvmBits32 => llvm_inhabitant_atom(id: ^llvm_tag_width_bits32)
    LlvmBits64 => llvm_inhabitant_atom(id: ^llvm_tag_width_bits64)
  }
}

fn llvm_float_kind_node(kind: LlvmFloatKind) -> Node {
  match kind {
    LlvmHalfFloat => llvm_inhabitant_atom(id: ^llvm_tag_float_kind_half)
    LlvmSingleFloat => llvm_inhabitant_atom(id: ^llvm_tag_float_kind_single)
    LlvmDoubleFloat => llvm_inhabitant_atom(id: ^llvm_tag_float_kind_double)
  }
}

fn llvm_integer_facts_node(facts: LlvmIntegerPrimitiveFacts) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      v2.std.node.Edge {
        label: Named { name: discriminant(v: v2.std.model_core.ModelCoreFactAxisSurfaceSpelling {}) },
        target: llvm_inhabitant_atom(id: facts.surface_spelling)
      },
      v2.std.node.Edge {
        label: Named { name: discriminant(v: v2.std.model_core.ModelCoreFactAxisWidth {}) },
        target: llvm_integer_bits_node(bits: facts.bits)
      },
      v2.std.node.Edge {
        label: Named { name: discriminant(v: v2.std.model_core.ModelCoreFactAxisEncoding {}) },
        target: llvm_inhabitant_atom(id: ^llvm_repr_sign_agnostic_integer)
      },
      v2.std.node.Edge {
        label: Named { name: ^llvm_facts_field_std_projection },
        target: llvm_inhabitant_atom(id: facts.std_projection)
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn llvm_float_facts_node(facts: LlvmFloatPrimitiveFacts) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      v2.std.node.Edge {
        label: Named { name: discriminant(v: v2.std.model_core.ModelCoreFactAxisSurfaceSpelling {}) },
        target: llvm_inhabitant_atom(id: facts.surface_spelling)
      },
      v2.std.node.Edge {
        label: Named { name: discriminant(v: v2.std.model_core.ModelCoreFactAxisEncoding {}) },
        target: llvm_float_kind_node(kind: facts.kind)
      },
      v2.std.node.Edge {
        label: Named { name: ^llvm_facts_field_std_projection },
        target: llvm_inhabitant_atom(id: facts.std_projection)
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn llvm_integer_spec_facts(facts: LlvmIntegerPrimitiveFacts) -> Map<v2.std.node.Symbol, Node> {
  std.types.Map {
    lookup: fn(axis) {
      if axis == discriminant(v: v2.std.model_core.ModelCoreFactAxisSurfaceSpelling {}) {
          v2.std.optional.Present { value: llvm_inhabitant_atom(id: facts.surface_spelling) }
      } else if axis == discriminant(v: v2.std.model_core.ModelCoreFactAxisWidth {}) {
          v2.std.optional.Present { value: llvm_integer_bits_node(bits: facts.bits) }
      } else if axis == discriminant(v: v2.std.model_core.ModelCoreFactAxisEncoding {}) {
          v2.std.optional.Present { value: llvm_inhabitant_atom(id: ^llvm_repr_sign_agnostic_integer) }
      } else {
          v2.std.optional.Absent
      }
    }
  }
}

fn llvm_float_spec_facts(facts: LlvmFloatPrimitiveFacts) -> Map<v2.std.node.Symbol, Node> {
  std.types.Map {
    lookup: fn(axis) {
      if axis == discriminant(v: v2.std.model_core.ModelCoreFactAxisSurfaceSpelling {}) {
          v2.std.optional.Present { value: llvm_inhabitant_atom(id: facts.surface_spelling) }
      } else if axis == discriminant(v: v2.std.model_core.ModelCoreFactAxisEncoding {}) {
          v2.std.optional.Present { value: llvm_float_kind_node(kind: facts.kind) }
      } else {
          v2.std.optional.Absent
      }
    }
  }
}

fn llvm_primitive_bundle_from_integer_facts(facts: LlvmIntegerPrimitiveFacts) -> v2.std.model_core.PrimitiveFactBundle {
  v2.std.model_core.PrimitiveFactBundle {
    substrate_carrier: llvm_integer_facts_node(facts: facts),
    spec_facts: llvm_integer_spec_facts(facts: facts)
  }
}

fn llvm_primitive_bundle_from_float_facts(facts: LlvmFloatPrimitiveFacts) -> v2.std.model_core.PrimitiveFactBundle {
  v2.std.model_core.PrimitiveFactBundle {
    substrate_carrier: llvm_float_facts_node(facts: facts),
    spec_facts: llvm_float_spec_facts(facts: facts)
  }
}

fn llvm_primitive_bundles_from_integer_catalog() -> List<v2.std.model_core.PrimitiveFactBundle> {
  fold_list(
    xs: llvm_integer_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(
        xs: acc,
        item: llvm_primitive_bundle_from_integer_facts(facts: facts)
      )
    }
  )
}

fn llvm_primitive_bundles_from_float_catalog() -> List<v2.std.model_core.PrimitiveFactBundle> {
  fold_list(
    xs: llvm_float_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(
        xs: acc,
        item: llvm_primitive_bundle_from_float_facts(facts: facts)
      )
    }
  )
}

fn llvm_primitive_fact_bundles() -> List<v2.std.model_core.PrimitiveFactBundle> {
  list_append(
    left: llvm_primitive_bundles_from_integer_catalog(),
    right: llvm_primitive_bundles_from_float_catalog()
  )
}

fn llvm_ir_model_core() -> v2.std.model_core.ModelCore {
  v2.std.model_core.ModelCore {
    primitives: llvm_primitive_fact_bundles(),
    inhabitance: [],
    laws: [],
    effects: v2.std.model_core.EffectSemanticsDecl { operations: [] },
    partiality: v2.std.model_core.PartialitySemanticsDecl { operations: [] }
  }
}
fn llvm_lex_token(token_class: v2.std.node.Symbol, pattern: v2.std.compilers.lexing.LexPattern) -> v2.std.compilers.lexing.LexRule {
  v2.std.compilers.lexing.TokenRule { token_class: token_class, pattern: pattern }
}

fn llvm_grammar_terminal(token_class: v2.std.node.Symbol) -> v2.std.grammar.GrammarExpr {
  Terminal { token_class: token_class, stamp: StampClass }
}

fn llvm_grammar_sequence(left: v2.std.grammar.GrammarExpr, right: v2.std.grammar.GrammarExpr) -> v2.std.grammar.GrammarExpr {
  v2.std.grammar.Sequence { left: left, right: right }
}

fn llvm_global_ident_pattern() -> v2.std.compilers.lexing.LexPattern {
  v2.std.compilers.lexing.SequencePattern {
    left: v2.std.compilers.lexing.LiteralPattern { text: "@" },
    right: v2.std.compilers.lexing.SequencePattern {
      left: v2.std.compilers.lexing.CharClassPattern { class: IdentStartChar },
      right: v2.std.compilers.lexing.RepeatPattern { element: v2.std.compilers.lexing.CharClassPattern { class: IdentContinueChar } }
    }
  }
}

fn llvm_lex() -> v2.std.compilers.lexing.LexRules {
  v2.std.compilers.lexing.ModeledLexRules {
    root: v2.std.compilers.lexing.LexRuleSet {
      rules: [
        v2.std.compilers.lexing.TriviaRule { pattern: v2.std.compilers.lexing.OneOrMorePattern { element: v2.std.compilers.lexing.CharClassPattern { class: WhitespaceChar } } },
        llvm_lex_token(token_class: ^llvm_token_global_ident, pattern: llvm_global_ident_pattern()),
        llvm_lex_token(token_class: ^llvm_token_kw_define, pattern: v2.std.compilers.lexing.KeywordPattern { text: "define" }),
        llvm_lex_token(token_class: ^llvm_token_kw_void, pattern: v2.std.compilers.lexing.KeywordPattern { text: "void" }),
        llvm_lex_token(token_class: ^llvm_token_kw_ret, pattern: v2.std.compilers.lexing.KeywordPattern { text: "ret" }),
        llvm_lex_token(token_class: ^llvm_token_lparen, pattern: v2.std.compilers.lexing.LiteralPattern { text: "(" }),
        llvm_lex_token(token_class: ^llvm_token_rparen, pattern: v2.std.compilers.lexing.LiteralPattern { text: ")" }),
        llvm_lex_token(token_class: ^llvm_token_lbrace, pattern: v2.std.compilers.lexing.LiteralPattern { text: "{" }),
        llvm_lex_token(token_class: ^llvm_token_rbrace, pattern: v2.std.compilers.lexing.LiteralPattern { text: "}" })
      ]
    }
  }
}

fn llvm_void_function_expr() -> v2.std.grammar.GrammarExpr {
  llvm_grammar_sequence(
    left: llvm_grammar_terminal(token_class: ^llvm_token_kw_define),
    right: llvm_grammar_sequence(
      left: llvm_grammar_terminal(token_class: ^llvm_token_kw_void),
      right: llvm_grammar_sequence(
        left: llvm_grammar_terminal(token_class: ^llvm_token_global_ident),
        right: llvm_grammar_sequence(
          left: llvm_grammar_terminal(token_class: ^llvm_token_lparen),
          right: llvm_grammar_sequence(
            left: llvm_grammar_terminal(token_class: ^llvm_token_rparen),
            right: llvm_grammar_sequence(
              left: llvm_grammar_terminal(token_class: ^llvm_token_lbrace),
              right: llvm_grammar_sequence(
                left: llvm_grammar_terminal(token_class: ^llvm_token_kw_ret),
                right: llvm_grammar_sequence(
                  left: llvm_grammar_terminal(token_class: ^llvm_token_kw_void),
                  right: llvm_grammar_terminal(token_class: ^llvm_token_rbrace)
                )
              )
            )
          )
        )
      )
    )
  )
}

fn llvm_ir_grammar() -> v2.std.grammar.ParseGrammar {
  let start = v2.std.grammar.GrammarProduction {
    name: ^llvm_production_void_function,
    expression: llvm_void_function_expr(),
    emitted: grammar_atom(identity: ^llvm_surface_void_function)
  }
  v2.std.grammar.ModeledGrammar {
    root: v2.std.grammar.GrammarRoot {
      start: ^llvm_production_void_function,
      productions: [start],
      sync_tokens: grammar_empty_sync_tokens()
    }
  }
}

fn llvm_void_function_formal_production() -> v2.std.grammar.FormalProduction {
  v2.std.grammar.FormalProduction {
    lhs: grammar_formal_nonterminal(identity: ^llvm_production_void_function),
    rhs: [
      grammar_formal_terminal(identity: ^llvm_token_kw_define),
      grammar_formal_terminal(identity: ^llvm_token_kw_void),
      grammar_formal_terminal(identity: ^llvm_token_global_ident),
      grammar_formal_terminal(identity: ^llvm_token_lparen),
      grammar_formal_terminal(identity: ^llvm_token_rparen),
      grammar_formal_terminal(identity: ^llvm_token_lbrace),
      grammar_formal_terminal(identity: ^llvm_token_kw_ret),
      grammar_formal_terminal(identity: ^llvm_token_kw_void),
      grammar_formal_terminal(identity: ^llvm_token_rbrace)
    ]
  }
}

fn llvm_ir_ingest_grammar_schema() -> v2.std.grammar.GrammarSchema {
  v2.std.grammar.GrammarSchema {
    lex: llvm_lex(),
    grammar: llvm_ir_grammar()
  }
}

fn llvm_ir_ingest_grammar_probe() -> v2.std.grammar.GrammarSchemaProbeBinding {
  v2.std.grammar.GrammarSchemaProbeBinding {
    schema: llvm_ir_ingest_grammar_schema(),
    probe: v2.std.grammar.GrammarSchemaProbe {
      fixture: "define void @f() { ret void }",
      production: llvm_void_function_formal_production(),
      expected_parse_surface: grammar_atom(identity: ^llvm_surface_void_function)
    }
  }
}
