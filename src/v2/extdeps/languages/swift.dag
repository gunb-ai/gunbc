        grammar_formal_nonterminal_occurrence(identity: ^swift_production_expr),
        grammar_formal_terminal(identity: ^swift_token_rparen)
      ]
    ),
    grammar_formal_production(lhs: ^swift_production_expr_list, rhs: []),
    grammar_formal_production(
      lhs: ^swift_production_expr_list,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^swift_production_expr)]
    ),
    grammar_formal_production(
      lhs: ^swift_production_expr_list,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_expr),
        grammar_formal_terminal(identity: ^swift_token_comma),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_expr),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_expr_list_suffix)
      ]
    ),
    grammar_formal_production(lhs: ^swift_production_expr_list_suffix, rhs: []),
    grammar_formal_production(
      lhs: ^swift_production_expr_list_suffix,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_comma),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_expr),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_expr_list_suffix)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_production_call_expr,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^swift_production_primary_expr)]
    ),
    grammar_formal_production(
      lhs: ^swift_production_call_expr,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_primary_expr),
        grammar_formal_terminal(identity: ^swift_token_lparen),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_expr_list),
        grammar_formal_terminal(identity: ^swift_token_rparen),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_call_suffix)
      ]
    ),
    grammar_formal_production(lhs: ^swift_production_call_suffix, rhs: []),
    grammar_formal_production(
      lhs: ^swift_production_call_suffix,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_lparen),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_expr_list),
        grammar_formal_terminal(identity: ^swift_token_rparen),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_call_suffix)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_production_binary_expr,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^swift_production_call_expr)]
    ),
    grammar_formal_production(
      lhs: ^swift_production_binary_expr,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_call_expr),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_binary_suffix)
      ]
    ),
    grammar_formal_production(lhs: ^swift_production_binary_suffix, rhs: []),
    grammar_formal_production(
      lhs: ^swift_production_binary_suffix,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_operator),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_call_expr),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_binary_suffix)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_production_expr,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^swift_production_binary_expr)]
    ),
    grammar_formal_production(lhs: ^swift_production_return_stmt, rhs: [grammar_formal_terminal(identity: ^swift_token_kw_return)]),
    grammar_formal_production(
      lhs: ^swift_production_return_stmt,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_kw_return),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_expr)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_production_let_stmt,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_kw_let),
        grammar_formal_terminal(identity: ^swift_token_ident)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_production_let_stmt,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_kw_var),
        grammar_formal_terminal(identity: ^swift_token_ident)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_production_let_stmt,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_kw_let),
        grammar_formal_terminal(identity: ^swift_token_ident),
        grammar_formal_terminal(identity: ^swift_token_colon),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_type_expr)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_production_let_stmt,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_kw_var),
        grammar_formal_terminal(identity: ^swift_token_ident),
        grammar_formal_terminal(identity: ^swift_token_colon),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_type_expr)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_production_let_stmt,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_kw_let),
        grammar_formal_terminal(identity: ^swift_token_ident),
        grammar_formal_terminal(identity: ^swift_token_equal),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_expr)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_production_let_stmt,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_kw_var),
        grammar_formal_terminal(identity: ^swift_token_ident),
        grammar_formal_terminal(identity: ^swift_token_equal),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_expr)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_production_let_stmt,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_kw_let),
        grammar_formal_terminal(identity: ^swift_token_ident),
        grammar_formal_terminal(identity: ^swift_token_colon),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_type_expr),
        grammar_formal_terminal(identity: ^swift_token_equal),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_expr)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_production_let_stmt,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_kw_var),
        grammar_formal_terminal(identity: ^swift_token_ident),
        grammar_formal_terminal(identity: ^swift_token_colon),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_type_expr),
        grammar_formal_terminal(identity: ^swift_token_equal),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_expr)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_production_if_stmt,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_kw_if),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_expr),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_block)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_production_if_stmt,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_kw_if),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_expr),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_block),
        grammar_formal_terminal(identity: ^swift_token_kw_else),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_block)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_production_if_stmt,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_kw_if),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_expr),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_block),
        grammar_formal_terminal(identity: ^swift_token_kw_else),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_if_stmt)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_production_while_stmt,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_kw_while),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_expr),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_block)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_production_stmt,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^swift_production_return_stmt)]
    ),
    grammar_formal_production(
      lhs: ^swift_production_stmt,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^swift_production_let_stmt)]
    ),
    grammar_formal_production(
      lhs: ^swift_production_stmt,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^swift_production_if_stmt)]
    ),
    grammar_formal_production(
      lhs: ^swift_production_stmt,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^swift_production_while_stmt)]
    ),
    grammar_formal_production(
      lhs: ^swift_production_stmt,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^swift_production_expr)]
    ),
    grammar_formal_production(
      lhs: ^swift_production_block,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_lbrace),
        grammar_formal_terminal(identity: ^swift_token_rbrace)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_production_block,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_lbrace),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_stmt),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_block_stmt_sep_opt),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_block_stmt_suffix),
        grammar_formal_terminal(identity: ^swift_token_rbrace)
      ]
    ),
    grammar_formal_production(lhs: ^swift_production_block_stmt_suffix, rhs: []),
    grammar_formal_production(
      lhs: ^swift_production_block_stmt_suffix,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_stmt),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_block_stmt_sep_opt),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_block_stmt_suffix)
      ]
    ),
    grammar_formal_production(lhs: ^swift_production_block_stmt_sep_opt, rhs: []),
    grammar_formal_production(
      lhs: ^swift_production_block_stmt_sep_opt,
      rhs: [grammar_formal_terminal(identity: ^swift_token_semicolon)]
    ),
    grammar_formal_production(
      lhs: ^swift_production_fn_decl,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_kw_func),
        grammar_formal_terminal(identity: ^swift_token_ident),
        grammar_formal_terminal(identity: ^swift_token_lparen),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_param_list),
        grammar_formal_terminal(identity: ^swift_token_rparen),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_block)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_production_fn_decl,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_kw_func),
        grammar_formal_terminal(identity: ^swift_token_ident),
        grammar_formal_terminal(identity: ^swift_token_lparen),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_param_list),
        grammar_formal_terminal(identity: ^swift_token_rparen),
        grammar_formal_terminal(identity: ^swift_token_arrow),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_type_expr),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_block)
      ]
    ),
    swift_formal_production_fn_add()
  ]
}

fn swift_grammar_atom(id: v2.std.node.Symbol) -> Node {
  swift_atom(id: id)
}

fn swift_grammar_nonterminal(production: v2.std.node.Symbol) -> v2.std.grammar.GrammarExpr {
  v2.std.grammar.Nonterminal { production: production }
}

fn swift_grammar_sequence(left: v2.std.grammar.GrammarExpr, right: v2.std.grammar.GrammarExpr) -> v2.std.grammar.GrammarExpr {
  v2.std.grammar.Sequence { left: left, right: right }
}

fn swift_grammar_choice(left: v2.std.grammar.GrammarExpr, right: v2.std.grammar.GrammarExpr) -> v2.std.grammar.GrammarExpr {
  v2.std.grammar.Choice { left: left, right: right }
}

fn swift_grammar_optional(element: v2.std.grammar.GrammarExpr) -> v2.std.grammar.GrammarExpr {
  Optional { element: element }
}

fn swift_grammar_repeat(element: v2.std.grammar.GrammarExpr) -> v2.std.grammar.GrammarExpr {
  Repeat { element: element }
}

fn swift_grammar_type_expr() -> v2.std.grammar.GrammarExpr {
  swift_grammar_terminal(token_class: ^swift_token_ident)
}

fn swift_grammar_typed_param_expr() -> v2.std.grammar.GrammarExpr {
  swift_grammar_sequence(
    left: swift_grammar_terminal(token_class: ^swift_token_ident),
    right: swift_grammar_sequence(
      left: swift_grammar_terminal(token_class: ^swift_token_colon),
      right: swift_grammar_nonterminal(production: ^swift_production_type_expr)
    )
  )
}

fn swift_grammar_param_list_expr() -> v2.std.grammar.GrammarExpr {
  swift_grammar_optional(
    element: swift_grammar_sequence(
      left: swift_grammar_nonterminal(production: ^swift_production_typed_param),
      right: swift_grammar_repeat(
        element: swift_grammar_sequence(
          left: swift_grammar_terminal(token_class: ^swift_token_comma),
          right: swift_grammar_nonterminal(production: ^swift_production_typed_param)
        )
      )
    )
  )
}

fn swift_grammar_binary_operator_expr() -> v2.std.grammar.GrammarExpr {
  swift_grammar_terminal(token_class: ^swift_token_operator)
}

fn swift_grammar_expr_list_expr() -> v2.std.grammar.GrammarExpr {
  swift_grammar_optional(
    element: swift_grammar_sequence(
      left: swift_grammar_nonterminal(production: ^swift_production_expr),
      right: swift_grammar_repeat(
        element: swift_grammar_sequence(
          left: swift_grammar_terminal(token_class: ^swift_token_comma),
          right: swift_grammar_nonterminal(production: ^swift_production_expr)
        )
      )
    )
  )
}

fn swift_grammar_primary_expr() -> v2.std.grammar.GrammarExpr {
  swift_grammar_choice(
    left: swift_grammar_terminal(token_class: ^swift_token_ident),
    right: swift_grammar_choice(
      left: swift_grammar_terminal(token_class: ^swift_token_int_literal),
      right: swift_grammar_choice(
        left: swift_grammar_terminal(token_class: ^swift_token_string_literal),
        right: swift_grammar_choice(
          left: swift_grammar_terminal(token_class: ^swift_token_kw_true),
          right: swift_grammar_choice(
            left: swift_grammar_terminal(token_class: ^swift_token_kw_false),
            right: swift_grammar_sequence(
              left: swift_grammar_terminal(token_class: ^swift_token_lparen),
              right: swift_grammar_sequence(
                left: swift_grammar_nonterminal(production: ^swift_production_expr),
                right: swift_grammar_terminal(token_class: ^swift_token_rparen)
              )
            )
          )
        )
      )
    )
  )
}

fn swift_grammar_call_expr() -> v2.std.grammar.GrammarExpr {
  swift_grammar_sequence(
    left: swift_grammar_nonterminal(production: ^swift_production_primary_expr),
    right: swift_grammar_repeat(
      element: swift_grammar_sequence(
        left: swift_grammar_terminal(token_class: ^swift_token_lparen),
        right: swift_grammar_sequence(
          left: swift_grammar_expr_list_expr(),
          right: swift_grammar_terminal(token_class: ^swift_token_rparen)
        )
      )
    )
  )
}

fn swift_grammar_binary_expr() -> v2.std.grammar.GrammarExpr {
  swift_grammar_sequence(
    left: swift_grammar_nonterminal(production: ^swift_production_call_expr),
    right: swift_grammar_repeat(
      element: swift_grammar_sequence(
        left: swift_grammar_binary_operator_expr(),
        right: swift_grammar_nonterminal(production: ^swift_production_call_expr)
      )
    )
  )
}

fn swift_grammar_expr_expr() -> v2.std.grammar.GrammarExpr {
  swift_grammar_nonterminal(production: ^swift_production_binary_expr)
}

fn swift_grammar_return_stmt_expr() -> v2.std.grammar.GrammarExpr {
  swift_grammar_sequence(
    left: swift_grammar_terminal(token_class: ^swift_token_kw_return),
    right: swift_grammar_optional(
      element: swift_grammar_nonterminal(production: ^swift_production_expr)
    )
  )
}

fn swift_grammar_let_stmt_expr() -> v2.std.grammar.GrammarExpr {
  swift_grammar_sequence(
    left: swift_grammar_choice(
      left: swift_grammar_terminal(token_class: ^swift_token_kw_let),
      right: swift_grammar_terminal(token_class: ^swift_token_kw_var)
    ),
    right: swift_grammar_sequence(
      left: swift_grammar_terminal(token_class: ^swift_token_ident),
      right: swift_grammar_sequence(
        left: swift_grammar_optional(
          element: swift_grammar_sequence(
            left: swift_grammar_terminal(token_class: ^swift_token_colon),
            right: swift_grammar_nonterminal(production: ^swift_production_type_expr)
          )
        ),
        right: swift_grammar_optional(
          element: swift_grammar_sequence(
            left: swift_grammar_terminal(token_class: ^swift_token_equal),
            right: swift_grammar_nonterminal(production: ^swift_production_expr)
          )
        )
      )
    )
  )
}

fn swift_grammar_if_stmt_expr() -> v2.std.grammar.GrammarExpr {
  swift_grammar_sequence(
    left: swift_grammar_terminal(token_class: ^swift_token_kw_if),
    right: swift_grammar_sequence(
      left: swift_grammar_nonterminal(production: ^swift_production_expr),
      right: swift_grammar_sequence(
        left: swift_grammar_nonterminal(production: ^swift_production_block),
        right: swift_grammar_optional(
          element: swift_grammar_sequence(
            left: swift_grammar_terminal(token_class: ^swift_token_kw_else),
            right: swift_grammar_choice(
              left: swift_grammar_nonterminal(production: ^swift_production_block),
              right: swift_grammar_nonterminal(production: ^swift_production_if_stmt)
            )
          )
        )
      )
    )
  )
}

fn swift_grammar_while_stmt_expr() -> v2.std.grammar.GrammarExpr {
  swift_grammar_sequence(
    left: swift_grammar_terminal(token_class: ^swift_token_kw_while),
    right: swift_grammar_sequence(
      left: swift_grammar_nonterminal(production: ^swift_production_expr),
      right: swift_grammar_nonterminal(production: ^swift_production_block)
    )
  )
}

fn swift_grammar_stmt_expr() -> v2.std.grammar.GrammarExpr {
  swift_grammar_choice(
    left: swift_grammar_nonterminal(production: ^swift_production_return_stmt),
    right: swift_grammar_choice(
      left: swift_grammar_nonterminal(production: ^swift_production_let_stmt),
      right: swift_grammar_choice(
        left: swift_grammar_nonterminal(production: ^swift_production_if_stmt),
        right: swift_grammar_choice(
          left: swift_grammar_nonterminal(production: ^swift_production_while_stmt),
          right: swift_grammar_nonterminal(production: ^swift_production_expr)
        )
      )
    )
  )
}

fn swift_grammar_block_stmt_separator_expr() -> v2.std.grammar.GrammarExpr {
  swift_grammar_optional(
    element: swift_grammar_terminal(token_class: ^swift_token_semicolon)
  )
}

fn swift_grammar_block_expr() -> v2.std.grammar.GrammarExpr {
  swift_grammar_sequence(
    left: swift_grammar_terminal(token_class: ^swift_token_lbrace),
    right: swift_grammar_sequence(
      left: swift_grammar_repeat(
        element: swift_grammar_sequence(
          left: swift_grammar_nonterminal(production: ^swift_production_stmt),
          right: swift_grammar_block_stmt_separator_expr()
        )
      ),
      right: swift_grammar_terminal(token_class: ^swift_token_rbrace)
    )
  )
}

fn swift_grammar_fn_decl_expr() -> v2.std.grammar.GrammarExpr {
  swift_grammar_sequence(
    left: swift_grammar_terminal(token_class: ^swift_token_kw_func),
    right: swift_grammar_sequence(
      left: swift_grammar_terminal(token_class: ^swift_token_ident),
      right: swift_grammar_sequence(
        left: swift_grammar_terminal(token_class: ^swift_token_lparen),
        right: swift_grammar_sequence(
          left: swift_grammar_nonterminal(production: ^swift_production_param_list),
          right: swift_grammar_sequence(
            left: swift_grammar_terminal(token_class: ^swift_token_rparen),
            right: swift_grammar_sequence(
              left: swift_grammar_optional(
                element: swift_grammar_sequence(
                  left: swift_grammar_terminal(token_class: ^swift_token_arrow),
                  right: swift_grammar_nonterminal(production: ^swift_production_type_expr)
                )
              ),
              right: swift_grammar_nonterminal(production: ^swift_production_block)
            )
          )
        )
      )
    )
  )
}

