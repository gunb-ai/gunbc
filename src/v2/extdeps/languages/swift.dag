module v2.extdeps.languages.swift


type SwiftIntWidth
  = Bits8
  | Bits16
  | Bits32
  | Bits64
  | PointerWord

type SwiftIntSignedness
  = Signed
  | Unsigned

type SwiftFloatWidth
  = FloatBits32
  | FloatBits64

type SwiftStringRepresentation {
  tag: v2.std.node.Symbol
}

type SwiftCharacterRepresentation {
  tag: v2.std.node.Symbol
}

type SwiftUnitRepresentation {
  tag: v2.std.node.Symbol
}

type SwiftBoolRepresentation {
  tag: v2.std.node.Symbol
}

type SwiftIntegerOverflowSemantics {
  tag: v2.std.node.Symbol
}

type SwiftScalar
  = IntScalar { signedness: SwiftIntSignedness, width: SwiftIntWidth }
  | FloatScalar { width: SwiftFloatWidth }
  | BoolScalar
  | CharacterScalar
  | StringScalar
  | VoidScalar

type SwiftIntegerPrimitiveFacts {
  surface_spelling: v2.std.node.Symbol
  signedness: SwiftIntSignedness
  width: SwiftIntWidth
  overflow: SwiftIntegerOverflowSemantics
}

type SwiftFloatPrimitiveFacts {
  surface_spelling: v2.std.node.Symbol
  width: SwiftFloatWidth
  ieee754_binary: v2.std.node.Symbol
}

type SwiftNonNumericPrimitiveFacts
  = SwiftBoolPrimitiveFacts {
      surface_spelling: v2.std.node.Symbol
      representation: SwiftBoolRepresentation
    }
  | SwiftCharacterPrimitiveFacts {
      surface_spelling: v2.std.node.Symbol
      representation: SwiftCharacterRepresentation
    }
  | SwiftStringPrimitiveFacts {
      surface_spelling: v2.std.node.Symbol
      representation: SwiftStringRepresentation
    }
  | SwiftVoidPrimitiveFacts {
      surface_spelling: v2.std.node.Symbol
      representation: SwiftUnitRepresentation
    }

type SwiftGrammarRelationRow {
  production: v2.std.grammar.GrammarProduction
  emitted: Node
  tokens: List<v2.std.compilers.target_model.ConcreteSyntaxToken>
}
fn swift_concrete_tokens() -> List<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  [
    v2.std.compilers.target_model.FixedToken { token_class: ^swift_token_kw_func },
    v2.std.compilers.target_model.BoundToken { token_class: ^swift_token_ident, binding: ^swift_binding_fn_add },
    v2.std.compilers.target_model.FixedToken { token_class: ^swift_token_lparen },
    v2.std.compilers.target_model.BoundToken { token_class: ^swift_token_ident, binding: ^swift_binding_param_x },
    v2.std.compilers.target_model.FixedToken { token_class: ^swift_token_colon },
    v2.std.compilers.target_model.BoundToken { token_class: ^swift_token_ident, binding: ^swift_binding_ty_int32 },
    v2.std.compilers.target_model.FixedToken { token_class: ^swift_token_comma },
    v2.std.compilers.target_model.BoundToken { token_class: ^swift_token_ident, binding: ^swift_binding_param_y },
    v2.std.compilers.target_model.FixedToken { token_class: ^swift_token_colon },
    v2.std.compilers.target_model.BoundToken { token_class: ^swift_token_ident, binding: ^swift_binding_ty_int32 },
    v2.std.compilers.target_model.FixedToken { token_class: ^swift_token_rparen },
    v2.std.compilers.target_model.FixedToken { token_class: ^swift_token_arrow },
    v2.std.compilers.target_model.BoundToken { token_class: ^swift_token_ident, binding: ^swift_binding_ty_int32 },
    v2.std.compilers.target_model.FixedToken { token_class: ^swift_token_lbrace },
    v2.std.compilers.target_model.FixedToken { token_class: ^swift_token_kw_return },
    v2.std.compilers.target_model.BoundToken { token_class: ^swift_token_ident, binding: ^swift_binding_param_x },
    v2.std.compilers.target_model.BoundToken { token_class: ^swift_token_operator, binding: ^swift_binding_op_plus },
    v2.std.compilers.target_model.BoundToken { token_class: ^swift_token_ident, binding: ^swift_binding_param_y },
    v2.std.compilers.target_model.FixedToken { token_class: ^swift_token_rbrace }
  ]
}
data swift_source_text: String = "func add(x: Int32, y: Int32) -> Int32 { return x + y }"

data swift_integer_overflow_trap: SwiftIntegerOverflowSemantics = SwiftIntegerOverflowSemantics {
  tag: ^swift_tag_trap_on_overflow
}
data swift_bool_representation: SwiftBoolRepresentation = SwiftBoolRepresentation {
  tag: ^swift_tag_bool_representation
}
data swift_character_representation: SwiftCharacterRepresentation = SwiftCharacterRepresentation {
  tag: ^swift_tag_character_extended_grapheme_cluster
}
data swift_string_representation: SwiftStringRepresentation = SwiftStringRepresentation {
  tag: ^swift_tag_string_unicode_text
}
data swift_unit_representation: SwiftUnitRepresentation = SwiftUnitRepresentation {
  tag: ^swift_tag_void_empty_tuple
}

data swift_facts_int: SwiftIntegerPrimitiveFacts = SwiftIntegerPrimitiveFacts {
  surface_spelling: ^swift_surface_spelling_int,
  signedness: Signed,
  width: PointerWord,
  overflow: swift_integer_overflow_trap,
}

data swift_facts_int8: SwiftIntegerPrimitiveFacts = SwiftIntegerPrimitiveFacts {
  surface_spelling: ^swift_surface_spelling_int8,
  signedness: Signed,
  width: Bits8,
  overflow: swift_integer_overflow_trap,
}

data swift_facts_int16: SwiftIntegerPrimitiveFacts = SwiftIntegerPrimitiveFacts {
  surface_spelling: ^swift_surface_spelling_int16,
  signedness: Signed,
  width: Bits16,
  overflow: swift_integer_overflow_trap,
}

data swift_facts_int32: SwiftIntegerPrimitiveFacts = SwiftIntegerPrimitiveFacts {
  surface_spelling: ^swift_surface_spelling_int32,
  signedness: Signed,
  width: Bits32,
  overflow: swift_integer_overflow_trap,
}

data swift_facts_int64: SwiftIntegerPrimitiveFacts = SwiftIntegerPrimitiveFacts {
  surface_spelling: ^swift_surface_spelling_int64,
  signedness: Signed,
  width: Bits64,
  overflow: swift_integer_overflow_trap,
}

data swift_facts_uint: SwiftIntegerPrimitiveFacts = SwiftIntegerPrimitiveFacts {
  surface_spelling: ^swift_surface_spelling_uint,
  signedness: Unsigned,
  width: PointerWord,
  overflow: swift_integer_overflow_trap,
}

data swift_facts_uint8: SwiftIntegerPrimitiveFacts = SwiftIntegerPrimitiveFacts {
  surface_spelling: ^swift_surface_spelling_uint8,
  signedness: Unsigned,
  width: Bits8,
  overflow: swift_integer_overflow_trap,
}

data swift_facts_uint16: SwiftIntegerPrimitiveFacts = SwiftIntegerPrimitiveFacts {
  surface_spelling: ^swift_surface_spelling_uint16,
  signedness: Unsigned,
  width: Bits16,
  overflow: swift_integer_overflow_trap,
}

data swift_facts_uint32: SwiftIntegerPrimitiveFacts = SwiftIntegerPrimitiveFacts {
  surface_spelling: ^swift_surface_spelling_uint32,
  signedness: Unsigned,
  width: Bits32,
  overflow: swift_integer_overflow_trap,
}

data swift_facts_uint64: SwiftIntegerPrimitiveFacts = SwiftIntegerPrimitiveFacts {
  surface_spelling: ^swift_surface_spelling_uint64,
  signedness: Unsigned,
  width: Bits64,
  overflow: swift_integer_overflow_trap,
}

data swift_facts_float: SwiftFloatPrimitiveFacts = SwiftFloatPrimitiveFacts {
  surface_spelling: ^swift_surface_spelling_float,
  width: FloatBits32,
  ieee754_binary: ^swift_tag_ieee754_binary32,
}

data swift_facts_double: SwiftFloatPrimitiveFacts = SwiftFloatPrimitiveFacts {
  surface_spelling: ^swift_surface_spelling_double,
  width: FloatBits64,
  ieee754_binary: ^swift_tag_ieee754_binary64,
}

data swift_facts_bool: SwiftNonNumericPrimitiveFacts = SwiftBoolPrimitiveFacts {
  surface_spelling: ^swift_surface_spelling_bool,
  representation: swift_bool_representation,
}

data swift_facts_character: SwiftNonNumericPrimitiveFacts = SwiftCharacterPrimitiveFacts {
  surface_spelling: ^swift_surface_spelling_character,
  representation: swift_character_representation,
}

data swift_facts_string: SwiftNonNumericPrimitiveFacts = SwiftStringPrimitiveFacts {
  surface_spelling: ^swift_surface_spelling_string,
  representation: swift_string_representation,
}

data swift_facts_void: SwiftNonNumericPrimitiveFacts = SwiftVoidPrimitiveFacts {
  surface_spelling: ^swift_surface_spelling_void,
  representation: swift_unit_representation,
}

data swift_integer_facts_catalog: List<SwiftIntegerPrimitiveFacts> = [
  swift_facts_int,
  swift_facts_int8,
  swift_facts_int16,
  swift_facts_int32,
  swift_facts_int64,
  swift_facts_uint,
  swift_facts_uint8,
  swift_facts_uint16,
  swift_facts_uint32,
  swift_facts_uint64
]

data swift_float_facts_catalog: List<SwiftFloatPrimitiveFacts> = [
  swift_facts_float,
  swift_facts_double
]

data swift_nonnumeric_facts_catalog: List<SwiftNonNumericPrimitiveFacts> = [
  swift_facts_bool,
  swift_facts_character,
  swift_facts_string,
  swift_facts_void
]

data swift_bool_grounding: BooleanAlgebra<Bool> = bool_boolean_algebra

fn swift_atom(id: v2.std.node.Symbol) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn swift_named_edge(name: v2.std.node.Symbol, target: Node) -> v2.std.node.Edge {
  v2.std.node.Edge { label: Named { name: name }, target: target }
}

fn swift_signedness_node(signedness: SwiftIntSignedness) -> Node {
  match signedness {
    Signed => swift_atom(id: ^swift_tag_signed)
    Unsigned => swift_atom(id: ^swift_tag_unsigned)
  }
}

fn swift_width_node(width: SwiftIntWidth) -> Node {
  match width {
    Bits8 => swift_atom(id: ^swift_tag_bits8)
    Bits16 => swift_atom(id: ^swift_tag_bits16)
    Bits32 => swift_atom(id: ^swift_tag_bits32)
    Bits64 => swift_atom(id: ^swift_tag_bits64)
    PointerWord => swift_atom(id: ^swift_tag_pointer_word)
  }
}

fn swift_float_width_node(width: SwiftFloatWidth) -> Node {
  match width {
    FloatBits32 => swift_atom(id: ^swift_tag_bits32)
    FloatBits64 => swift_atom(id: ^swift_tag_bits64)
  }
}

fn swift_overflow_node(overflow: SwiftIntegerOverflowSemantics) -> Node {
  swift_atom(id: overflow.tag)
}

fn swift_scalar_node(scalar: SwiftScalar) -> Node {
  match scalar {
    IntScalar { signedness: _, width: _ } => swift_atom(id: ^swift_tag_scalar_int)
    FloatScalar { width: _ } => swift_atom(id: ^swift_tag_scalar_float)
    BoolScalar => swift_atom(id: ^swift_tag_scalar_bool)
    CharacterScalar => swift_atom(id: ^swift_tag_scalar_character)
    StringScalar => swift_atom(id: ^swift_tag_scalar_string)
    VoidScalar => swift_atom(id: ^swift_tag_scalar_void)
  }
}

fn swift_nonnumeric_representation_node(facts: SwiftNonNumericPrimitiveFacts) -> Node {
  match facts {
    SwiftBoolPrimitiveFacts { representation } => swift_atom(id: representation.tag)
    SwiftCharacterPrimitiveFacts { representation } => swift_atom(id: representation.tag)
    SwiftStringPrimitiveFacts { representation } => swift_atom(id: representation.tag)
    SwiftVoidPrimitiveFacts { representation } => swift_atom(id: representation.tag)
  }
}

fn swift_nonnumeric_scalar_classifier_node(facts: SwiftNonNumericPrimitiveFacts) -> Node {
  match facts {
    SwiftBoolPrimitiveFacts { surface_spelling: _, representation: _ } =>
      swift_atom(id: ^swift_tag_scalar_bool)
    SwiftCharacterPrimitiveFacts { surface_spelling: _, representation: _ } =>
      swift_atom(id: ^swift_tag_scalar_character)
    SwiftStringPrimitiveFacts { surface_spelling: _, representation: _ } =>
      swift_atom(id: ^swift_tag_scalar_string)
    SwiftVoidPrimitiveFacts { surface_spelling: _, representation: _ } =>
      swift_atom(id: ^swift_tag_scalar_void)
  }
}

fn swift_integer_facts_node(facts: SwiftIntegerPrimitiveFacts) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      swift_named_edge(
        name: ^swift_facts_field_surface_spelling,
        target: swift_atom(id: facts.surface_spelling)
      ),
      swift_named_edge(
        name: ^swift_facts_field_signedness,
        target: swift_signedness_node(signedness: facts.signedness)
      ),
      swift_named_edge(
        name: ^swift_facts_field_width,
        target: swift_width_node(width: facts.width)
      ),
      swift_named_edge(
        name: ^swift_facts_field_overflow,
        target: swift_overflow_node(overflow: facts.overflow)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn swift_float_facts_node(facts: SwiftFloatPrimitiveFacts) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      swift_named_edge(
        name: ^swift_facts_field_surface_spelling,
        target: swift_atom(id: facts.surface_spelling)
      ),
      swift_named_edge(
        name: ^swift_facts_field_width,
        target: swift_float_width_node(width: facts.width)
      ),
      swift_named_edge(
        name: ^swift_facts_field_ieee754_binary,
        target: swift_atom(id: facts.ieee754_binary)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn swift_nonnumeric_surface_spelling(facts: SwiftNonNumericPrimitiveFacts) -> v2.std.node.Symbol {
  match facts {
    SwiftBoolPrimitiveFacts { surface_spelling, representation: _ } => surface_spelling
    SwiftCharacterPrimitiveFacts { surface_spelling, representation: _ } => surface_spelling
    SwiftStringPrimitiveFacts { surface_spelling, representation: _ } => surface_spelling
    SwiftVoidPrimitiveFacts { surface_spelling, representation: _ } => surface_spelling
  }
}

fn swift_nonnumeric_facts_node(facts: SwiftNonNumericPrimitiveFacts) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      swift_named_edge(
        name: ^swift_facts_field_surface_spelling,
        target: swift_atom(id: swift_nonnumeric_surface_spelling(facts: facts))
      ),
      swift_named_edge(
        name: ^swift_facts_field_scalar,
        target: swift_nonnumeric_scalar_classifier_node(facts: facts)
      ),
      swift_named_edge(
        name: ^swift_facts_field_value_fact,
        target: swift_nonnumeric_representation_node(facts: facts)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn swift_integer_inhabitant_node(id: v2.std.node.Symbol, facts: SwiftIntegerPrimitiveFacts) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      swift_named_edge(name: ^swift_inhabitant_field_atom, target: swift_atom(id: id)),
      swift_named_edge(
        name: ^swift_inhabitant_field_facts,
        target: swift_integer_facts_node(facts: facts)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn swift_inhabitant_int32_node() -> Node {
  swift_integer_inhabitant_node(id: ^swift_inhabitant_int32, facts: swift_facts_int32)
}

fn swift_declared_inhabitants_root() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      swift_named_edge(name: ^swift_inhabitant_field_int32, target: swift_inhabitant_int32_node())
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn swift_selection_policy_node() -> Node {
  swift_inhabitant_int32_node()
}

fn swift_emitted_add_fn_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Arrow },
    children: [
      v2.std.node.Edge { label: Positional, target: swift_inhabitant_int32_node() },
      v2.std.node.Edge { label: Positional, target: swift_inhabitant_int32_node() },
      v2.std.node.Edge { label: Positional, target: swift_inhabitant_int32_node() }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn swift_source_text_authority() -> String {
  swift_source_text
}

fn swift_concrete_token_node(token: v2.std.compilers.target_model.ConcreteSyntaxToken) -> Node {

  concrete_syntax_token_to_node(token: token)
}

fn swift_serialize_source_prefix_edges() -> List<v2.std.node.Edge> {
  std.algebra.Cons {
    head: swift_named_edge(
      name: ^serialize_source_field_source_text,
      target: swift_atom(id: ^swift_source_literal)
    ),
    tail: std.algebra.Cons {
      head: swift_named_edge(
        name: ^serialize_source_field_source_grammar,
        target: swift_atom(id: ^swift_production_fn_add)
      ),
      tail: std.algebra.Empty
    }
  }
}

fn swift_serialize_source_children() -> List<v2.std.node.Edge> {
  list_append(
    left: swift_serialize_source_prefix_edges(),
    right: [
      swift_named_edge(
        name: ^grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: swift_concrete_tokens(),
          token_to_node: swift_concrete_token_node
        )
      )
    ]
  )
}

fn swift_serialize_source_node() -> Node {
  let _authority = swift_source_text_authority()
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: swift_serialize_source_children(),
    occurrence_id: SyntheticOccurrence
}
}

fn swift_grammar_terminal(token_class: v2.std.node.Symbol) -> v2.std.grammar.GrammarExpr {
  Terminal { token_class: token_class, stamp: StampClass }
}

fn swift_grammar_sequence_fold_step(acc: v2.std.grammar.GrammarExpr, token: v2.std.compilers.target_model.ConcreteSyntaxToken) -> v2.std.grammar.GrammarExpr {
  let token_class = concrete_syntax_token_class(token: token)
  if token_class == ^swift_token_kw_func {
    acc
  } else {
    v2.std.grammar.Sequence {
      left: swift_grammar_terminal(token_class: token_class),
      right: acc
    }
  }
}

fn swift_grammar_sequence_from_token_classes() -> v2.std.grammar.GrammarExpr {
  fold_list(
    xs: swift_concrete_tokens(),
    empty: swift_grammar_terminal(token_class: ^swift_token_kw_func),
    cons: fn(acc, token) {
      swift_grammar_sequence_fold_step(acc: acc, token: token)
    }
  )
}

fn swift_grammar_relation_row() -> SwiftGrammarRelationRow {
  SwiftGrammarRelationRow {
    production: swift_grammar_production_fn_add(),
    emitted: swift_emitted_add_fn_node(),
    tokens: swift_concrete_tokens()
  }
}

fn swift_grammar_relation_row_node(row: SwiftGrammarRelationRow) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      swift_named_edge(
        name: ^grammar_relation_field_production,
        target: grammar_production_to_node(production: row.production)
      ),
      swift_named_edge(name: ^grammar_relation_field_emitted, target: row.emitted),
      swift_named_edge(
        name: ^grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: row.tokens,
          token_to_node: swift_concrete_token_node
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn swift_translation_rules_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      swift_named_edge(
        name: ^swift_relation_rule_fn_add,
        target: swift_grammar_relation_row_node(row: swift_grammar_relation_row())
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn swift_target_model_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      swift_named_edge(
        name: ^target_model_edge_selection_policy,
        target: swift_selection_policy_node()
      ),
      swift_named_edge(
        name: ^target_model_edge_declared_inhabitants,
        target: swift_declared_inhabitants_root()
      ),
      swift_named_edge(
        name: ^target_model_edge_translation_rules,
        target: swift_translation_rules_node()
      ),
      swift_named_edge(
        name: ^target_model_edge_serialize_source,
        target: swift_serialize_source_node()
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn swift_binding_spellings() -> Map<v2.std.node.Symbol, String> {
  map_insert(
    map_insert(
      map_insert(
        map_insert(
          map_insert(empty_map(), ^swift_binding_fn_add, "add"),
          ^swift_binding_param_x,
          "x"
        ),
        ^swift_binding_param_y,
        "y"
      ),
      ^swift_binding_ty_int32,
      "Int32"
    ),
    ^swift_binding_op_plus,
    "+"
  )
}

fn swift_target_model() -> v2.std.compilers.target_model.TargetModel {
  v2.std.compilers.target_model.TargetModel {
    produced_decl_support: ProducedDeclUnwired,
    bundle: swift_target_model_node(),
    lex: swift_lex(),
    binding_spellings: swift_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: swift_source_text_authority(),
    runtime_row: target_emit_host_runtime_row_unconfigured
  }
}

fn swift_lex_rule(token_class: v2.std.node.Symbol, text: String) -> v2.std.compilers.lexing.LexRule {
  v2.std.compilers.lexing.TokenRule {
    token_class: token_class,
    pattern: v2.std.compilers.lexing.LiteralPattern { text: text }
  }
}

fn swift_keyword_lex_rule(token_class: v2.std.node.Symbol, text: String) -> v2.std.compilers.lexing.LexRule {
  v2.std.compilers.lexing.TokenRule {
    token_class: token_class,
    pattern: v2.std.compilers.lexing.KeywordPattern { text: text }
  }
}

fn swift_whitespace_trivia_rule() -> v2.std.compilers.lexing.LexRule {
  v2.std.compilers.lexing.TriviaRule {
    pattern: v2.std.compilers.lexing.OneOrMorePattern { element: v2.std.compilers.lexing.CharClassPattern { class: WhitespaceChar } }
  }
}

fn swift_ident_lex_pattern() -> v2.std.compilers.lexing.LexPattern {
  v2.std.compilers.lexing.SequencePattern {
    left: v2.std.compilers.lexing.CharClassPattern { class: IdentStartChar },
    right: v2.std.compilers.lexing.RepeatPattern { element: v2.std.compilers.lexing.CharClassPattern { class: IdentContinueChar } }
  }
}

fn swift_ident_lex_rule() -> v2.std.compilers.lexing.LexRule {
  v2.std.compilers.lexing.TokenRule {
    token_class: ^swift_token_ident,
    pattern: swift_ident_lex_pattern()
  }
}

fn swift_int_literal_lex_rule() -> v2.std.compilers.lexing.LexRule {
  v2.std.compilers.lexing.TokenRule {
    token_class: ^swift_token_int_literal,
    pattern: v2.std.compilers.lexing.OneOrMorePattern { element: v2.std.compilers.lexing.CharClassPattern { class: DigitChar } }
  }
}

fn swift_string_literal_lex_rule() -> v2.std.compilers.lexing.LexRule {
  v2.std.compilers.lexing.TokenRule {
    token_class: ^swift_token_string_literal,
    pattern: v2.std.compilers.lexing.DelimitedPattern {
      open: v2.std.compilers.lexing.LiteralPattern { text: "\"" },
      body: v2.std.compilers.lexing.RepeatPattern { element: v2.std.compilers.lexing.CharClassPattern { class: StringTextChar } },
      close: v2.std.compilers.lexing.LiteralPattern { text: "\"" }
    }
  }
}

fn swift_infix_operator_lex_pattern() -> v2.std.compilers.lexing.LexPattern {
  v2.std.compilers.lexing.ChoicePattern {
    left: v2.std.compilers.lexing.LiteralPattern { text: "==" },
    right: v2.std.compilers.lexing.ChoicePattern {
      left: v2.std.compilers.lexing.LiteralPattern { text: "!=" },
      right: v2.std.compilers.lexing.ChoicePattern {
        left: v2.std.compilers.lexing.LiteralPattern { text: "<=" },
        right: v2.std.compilers.lexing.ChoicePattern {
          left: v2.std.compilers.lexing.LiteralPattern { text: ">=" },
          right: v2.std.compilers.lexing.ChoicePattern {
            left: v2.std.compilers.lexing.LiteralPattern { text: "+" },
            right: v2.std.compilers.lexing.ChoicePattern {
              left: v2.std.compilers.lexing.LiteralPattern { text: "-" },
              right: v2.std.compilers.lexing.ChoicePattern {
                left: v2.std.compilers.lexing.LiteralPattern { text: "*" },
                right: v2.std.compilers.lexing.ChoicePattern {
                  left: v2.std.compilers.lexing.LiteralPattern { text: "/" },
                  right: v2.std.compilers.lexing.ChoicePattern {
                    left: v2.std.compilers.lexing.LiteralPattern { text: "%" },
                    right: v2.std.compilers.lexing.ChoicePattern {
                      left: v2.std.compilers.lexing.LiteralPattern { text: "<" },
                      right: v2.std.compilers.lexing.LiteralPattern { text: ">" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

fn swift_infix_operator_lex_rule() -> v2.std.compilers.lexing.LexRule {
  v2.std.compilers.lexing.TokenRule {
    token_class: ^swift_token_operator,
    pattern: swift_infix_operator_lex_pattern()
  }
}

fn swift_lex_rules() -> v2.std.compilers.lexing.LexRuleSet {
  v2.std.compilers.lexing.LexRuleSet {
    rules: [
      swift_whitespace_trivia_rule(),
      swift_string_literal_lex_rule(),
      swift_int_literal_lex_rule(),
      swift_ident_lex_rule(),
      swift_keyword_lex_rule(token_class: ^swift_token_kw_func, text: "func"),
      swift_keyword_lex_rule(token_class: ^swift_token_kw_return, text: "return"),
      swift_keyword_lex_rule(token_class: ^swift_token_kw_let, text: "let"),
      swift_keyword_lex_rule(token_class: ^swift_token_kw_var, text: "var"),
      swift_keyword_lex_rule(token_class: ^swift_token_kw_if, text: "if"),
      swift_keyword_lex_rule(token_class: ^swift_token_kw_else, text: "else"),
      swift_keyword_lex_rule(token_class: ^swift_token_kw_while, text: "while"),
      swift_keyword_lex_rule(token_class: ^swift_token_kw_for, text: "for"),
      swift_keyword_lex_rule(token_class: ^swift_token_kw_in, text: "in"),
      swift_keyword_lex_rule(token_class: ^swift_token_kw_struct, text: "struct"),
      swift_keyword_lex_rule(token_class: ^swift_token_kw_class, text: "class"),
      swift_keyword_lex_rule(token_class: ^swift_token_kw_enum, text: "enum"),
      swift_keyword_lex_rule(token_class: ^swift_token_kw_protocol, text: "protocol"),
      swift_keyword_lex_rule(token_class: ^swift_token_kw_extension, text: "extension"),
      swift_keyword_lex_rule(token_class: ^swift_token_kw_import, text: "import"),
      swift_keyword_lex_rule(token_class: ^swift_token_kw_true, text: "true"),
      swift_keyword_lex_rule(token_class: ^swift_token_kw_false, text: "false"),
      swift_infix_operator_lex_rule(),
      swift_lex_rule(token_class: ^swift_token_arrow, text: "->"),
      swift_lex_rule(token_class: ^swift_token_equal, text: "="),
      swift_lex_rule(token_class: ^swift_token_lbrace, text: "{"),
      swift_lex_rule(token_class: ^swift_token_rbrace, text: "}"),
      swift_lex_rule(token_class: ^swift_token_lparen, text: "("),
      swift_lex_rule(token_class: ^swift_token_rparen, text: ")"),
      swift_lex_rule(token_class: ^swift_token_lbracket, text: "["),
      swift_lex_rule(token_class: ^swift_token_rbracket, text: "]"),
      swift_lex_rule(token_class: ^swift_token_comma, text: ","),
      swift_lex_rule(token_class: ^swift_token_colon, text: ":"),
      swift_lex_rule(token_class: ^swift_token_dot, text: "."),
      swift_lex_rule(token_class: ^swift_token_semicolon, text: ";")
    ]
  }
}

fn swift_lex() -> v2.std.compilers.lexing.LexRules {
  v2.std.compilers.lexing.ModeledLexRules { root: swift_lex_rules() }
}

fn swift_formal_rhs_from_tokens(tokens: List<v2.std.compilers.target_model.ConcreteSyntaxToken>) -> List<v2.std.grammar.FormalGrammarSymbol> {
  list_map(xs: tokens, f: fn(token) {
    grammar_formal_terminal(identity: concrete_syntax_token_class(token: token))
  })
}

fn swift_formal_production_fn_add() -> v2.std.grammar.FormalProduction {
  grammar_formal_production(
    lhs: ^swift_production_fn_add,
    rhs: swift_formal_rhs_from_tokens(tokens: swift_concrete_tokens())
  )
}

fn swift_formal_productions() -> List<v2.std.grammar.FormalProduction> {
  [
    grammar_formal_production(lhs: ^swift_production_type_expr, rhs: [grammar_formal_terminal(identity: ^swift_token_ident)]),
    grammar_formal_production(
      lhs: ^swift_production_typed_param,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_ident),
        grammar_formal_terminal(identity: ^swift_token_colon),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_type_expr)
      ]
    ),
    grammar_formal_production(lhs: ^swift_production_param_list, rhs: []),
    grammar_formal_production(
      lhs: ^swift_production_param_list,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^swift_production_typed_param)]
    ),
    grammar_formal_production(
      lhs: ^swift_production_param_list,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_typed_param),
        grammar_formal_terminal(identity: ^swift_token_comma),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_typed_param),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_param_list_suffix)
      ]
    ),
    grammar_formal_production(lhs: ^swift_production_param_list_suffix, rhs: []),
    grammar_formal_production(
      lhs: ^swift_production_param_list_suffix,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_comma),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_typed_param),
        grammar_formal_nonterminal_occurrence(identity: ^swift_production_param_list_suffix)
      ]
    ),
    grammar_formal_production(lhs: ^swift_production_primary_expr, rhs: [grammar_formal_terminal(identity: ^swift_token_ident)]),
    grammar_formal_production(
      lhs: ^swift_production_primary_expr,
      rhs: [grammar_formal_terminal(identity: ^swift_token_int_literal)]
    ),
    grammar_formal_production(
      lhs: ^swift_production_primary_expr,
      rhs: [grammar_formal_terminal(identity: ^swift_token_string_literal)]
    ),
    grammar_formal_production(
      lhs: ^swift_production_primary_expr,
      rhs: [grammar_formal_terminal(identity: ^swift_token_kw_true)]
    ),
    grammar_formal_production(
      lhs: ^swift_production_primary_expr,
      rhs: [grammar_formal_terminal(identity: ^swift_token_kw_false)]
    ),
    grammar_formal_production(
      lhs: ^swift_production_primary_expr,
      rhs: [
