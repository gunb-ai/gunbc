fn swift_grammar_root() -> v2.std.grammar.GrammarRoot {
  let start = swift_grammar_production_fn_add()
  let fn_decl = swift_grammar_production_fn_decl()
  let typed_param = swift_grammar_production_typed_param()
  let param_list = swift_grammar_production_param_list()
  let type_expr = swift_grammar_production_type_expr()
  let block = swift_grammar_production_block()
  let stmt = swift_grammar_production_stmt()
  let return_stmt = swift_grammar_production_return_stmt()
  let let_stmt = swift_grammar_production_let_stmt()
  let if_stmt = swift_grammar_production_if_stmt()
  let while_stmt = swift_grammar_production_while_stmt()
  let expr = swift_grammar_production_expr()
  let binary_expr = swift_grammar_production_binary_expr()
  let call_expr = swift_grammar_production_call_expr()
  let primary_expr = swift_grammar_production_primary_expr()
  v2.std.grammar.GrammarRoot {
    start: ^swift_production_fn_decl,
    productions: [
      start,
      fn_decl,
      typed_param,
      param_list,
      type_expr,
      block,
      stmt,
      return_stmt,
      let_stmt,
      if_stmt,
      while_stmt,
      expr,
      binary_expr,
      call_expr,
      primary_expr
    ],
    sync_tokens: grammar_empty_sync_tokens()
  }
}

fn swift_grammar() -> v2.std.grammar.ParseGrammar {
  v2.std.grammar.ModeledGrammar { root: swift_grammar_root() }
}

fn swift_lex_token_symbol(sym: v2.std.node.Symbol) -> Bool {
  lex_rule_set_token_class_member(
    rules: swift_lex_rules(),
    token_class: sym
  )
}

fn swift_empty_primitive_spec_facts() -> Map<v2.std.node.Symbol, Node> {
  std.types.Map {
    lookup: fn(axis) {
      v2.std.optional.Absent
    }
  }
}

fn swift_primitive_fact_map_4(
  axis0: v2.std.node.Symbol,
  fact0: Node,
  axis1: v2.std.node.Symbol,
  fact1: Node,
  axis2: v2.std.node.Symbol,
  fact2: Node,
  axis3: v2.std.node.Symbol,
  fact3: Node
) -> Map<v2.std.node.Symbol, Node> {
  map_insert(
    map_insert(
      map_insert(
        map_insert(swift_empty_primitive_spec_facts(), axis0, fact0),
        axis1,
        fact1
      ),
      axis2,
      fact2
    ),
    axis3,
    fact3
  )
}

fn swift_primitive_fact_map_3(
  axis0: v2.std.node.Symbol,
  fact0: Node,
  axis1: v2.std.node.Symbol,
  fact1: Node,
  axis2: v2.std.node.Symbol,
  fact2: Node
) -> Map<v2.std.node.Symbol, Node> {
  map_insert(
    map_insert(
      map_insert(swift_empty_primitive_spec_facts(), axis0, fact0),
      axis1,
      fact1
    ),
    axis2,
    fact2
  )
}

fn swift_primitive_fact_map_2(
  axis0: v2.std.node.Symbol,
  fact0: Node,
  axis1: v2.std.node.Symbol,
  fact1: Node
) -> Map<v2.std.node.Symbol, Node> {
  map_insert(
    map_insert(swift_empty_primitive_spec_facts(), axis0, fact0),
    axis1,
    fact1
  )
}

fn swift_primitive_bundle_from_integer_facts(facts: SwiftIntegerPrimitiveFacts) -> v2.std.model_core.PrimitiveFactBundle {
  v2.std.model_core.PrimitiveFactBundle {
    substrate_carrier: swift_integer_facts_node(facts: facts),
    spec_facts: swift_primitive_fact_map_4(
      axis0: discriminant(v: v2.std.model_core.ModelCoreFactAxisSurfaceSpelling {}),
      fact0: swift_atom(id: facts.surface_spelling),
      axis1: discriminant(v: v2.std.model_core.ModelCoreFactAxisSignedness {}),
      fact1: swift_signedness_node(signedness: facts.signedness),
      axis2: discriminant(v: v2.std.model_core.ModelCoreFactAxisWidth {}),
      fact2: swift_width_node(width: facts.width),
      axis3: discriminant(v: v2.std.model_core.ModelCoreFactAxisOverflowDisposition {}),
      fact3: swift_overflow_node(overflow: facts.overflow)
    )
  }
}

fn swift_primitive_bundle_from_float_facts(facts: SwiftFloatPrimitiveFacts) -> v2.std.model_core.PrimitiveFactBundle {
  v2.std.model_core.PrimitiveFactBundle {
    substrate_carrier: swift_float_facts_node(facts: facts),
    spec_facts: swift_primitive_fact_map_3(
      axis0: discriminant(v: v2.std.model_core.ModelCoreFactAxisSurfaceSpelling {}),
      fact0: swift_atom(id: facts.surface_spelling),
      axis1: discriminant(v: v2.std.model_core.ModelCoreFactAxisWidth {}),
      fact1: swift_float_width_node(width: facts.width),
      axis2: discriminant(v: v2.std.model_core.ModelCoreFactAxisEncoding {}),
      fact2: swift_atom(id: facts.ieee754_binary)
    )
  }
}

fn swift_primitive_bundle_from_nonnumeric_facts(
  facts: SwiftNonNumericPrimitiveFacts
) -> v2.std.model_core.PrimitiveFactBundle {
  v2.std.model_core.PrimitiveFactBundle {
    substrate_carrier: swift_nonnumeric_facts_node(facts: facts),
    spec_facts: swift_primitive_fact_map_2(
      axis0: discriminant(v: v2.std.model_core.ModelCoreFactAxisSurfaceSpelling {}),
      fact0: swift_atom(id: swift_nonnumeric_surface_spelling(facts: facts)),
      axis1: ^swift_primitive_fact_axis_scalar_classifier,
      fact1: swift_nonnumeric_scalar_classifier_node(facts: facts)
    )
  }
}

fn swift_primitive_bundles_from_integer_catalog() -> List<v2.std.model_core.PrimitiveFactBundle> {
  list_map(xs: swift_integer_facts_catalog, f: fn(facts) {
    swift_primitive_bundle_from_integer_facts(facts: facts)
  })
}

fn swift_primitive_bundles_from_float_catalog() -> List<v2.std.model_core.PrimitiveFactBundle> {
  list_map(xs: swift_float_facts_catalog, f: fn(facts) {
    swift_primitive_bundle_from_float_facts(facts: facts)
  })
}

fn swift_primitive_bundles_from_nonnumeric_catalog() -> List<v2.std.model_core.PrimitiveFactBundle> {
  list_map(xs: swift_nonnumeric_facts_catalog, f: fn(facts) {
    swift_primitive_bundle_from_nonnumeric_facts(facts: facts)
  })
}

fn swift_primitive_fact_bundles() -> List<v2.std.model_core.PrimitiveFactBundle> {
  list_append(
    left: list_append(
      left: swift_primitive_bundles_from_integer_catalog(),
      right: swift_primitive_bundles_from_float_catalog()
    ),
    right: swift_primitive_bundles_from_nonnumeric_catalog()
  )
}

fn swift_integer_catalog_surface_symbol_step(
  sym: v2.std.node.Symbol,
  acc: Bool,
  facts: SwiftIntegerPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn swift_float_catalog_surface_symbol_step(
  sym: v2.std.node.Symbol,
  acc: Bool,
  facts: SwiftFloatPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn swift_nonnumeric_catalog_surface_symbol_step(
  sym: v2.std.node.Symbol,
  acc: Bool,
  facts: SwiftNonNumericPrimitiveFacts
) -> Bool {
  acc || sym == swift_nonnumeric_surface_spelling(facts: facts)
}

fn swift_integer_catalog_surface_symbol(sym: v2.std.node.Symbol) -> Bool {
  fold_list(
    xs: swift_integer_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      swift_integer_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn swift_float_catalog_surface_symbol(sym: v2.std.node.Symbol) -> Bool {
  fold_list(
    xs: swift_float_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      swift_float_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn swift_nonnumeric_catalog_surface_symbol(sym: v2.std.node.Symbol) -> Bool {
  fold_list(
    xs: swift_nonnumeric_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      swift_nonnumeric_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn swift_catalog_surface_symbol(sym: v2.std.node.Symbol) -> Bool {
  swift_integer_catalog_surface_symbol(sym: sym) ||
    swift_float_catalog_surface_symbol(sym: sym) ||
    swift_nonnumeric_catalog_surface_symbol(sym: sym)
}

fn swift_language_model_canonical_symbols() -> Set<v2.std.node.Symbol> {
  std.types.Set {
    member: fn(sym) {
      swift_catalog_surface_symbol(sym: sym) ||
        swift_lex_token_symbol(sym: sym) ||
        grammar_carries_symbol(grammar: swift_grammar(), sym: sym) ||
        sym == ^swift_source_literal
    }
  }
}

fn swift_primitive_model_core() -> v2.std.model_core.ModelCore {
  v2.std.model_core.ModelCore {
    primitives: swift_primitive_fact_bundles(),
    inhabitance: [],
    laws: [],
    effects: v2.std.model_core.EffectSemanticsDecl { operations: [] },
    partiality: v2.std.model_core.PartialitySemanticsDecl { operations: [] }
  }
}

fn swift_primitive_language_model() -> v2.std.language_model.LanguageModel {
  v2.std.language_model.LanguageModel {
    lex: VoidLexRules,
    grammar: VoidGrammar,
    language_identity: ^swift_language_model_surface_id,
    canonical_symbols: swift_language_model_canonical_symbols(),
    core: swift_primitive_model_core()
  }
}
fn swift_float_inhabitant_node(id: v2.std.node.Symbol, facts: SwiftFloatPrimitiveFacts) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      swift_named_edge(name: ^swift_inhabitant_field_atom, target: swift_atom(id: id)),
      swift_named_edge(
        name: ^swift_inhabitant_field_facts,
        target: swift_float_facts_node(facts: facts)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn swift_signed_int_algebra_witness_node(facts: SwiftIntegerPrimitiveFacts) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      swift_named_edge(
        name: ^swift_witness_signed_int_ordered_ring,
        target: swift_atom(id: ^swift_witness_signed_int_ordered_ring)
      ),
      swift_named_edge(
        name: ^swift_facts_field_signedness,
        target: swift_signedness_node(signedness: facts.signedness)
      ),
      swift_named_edge(
        name: ^swift_facts_field_width,
        target: swift_width_node(width: facts.width)
      ),
      swift_named_edge(
        name: ^swift_facts_field_overflow,
        target: swift_overflow_node(overflow: facts.overflow)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn swift_unsigned_int_algebra_witness_node(facts: SwiftIntegerPrimitiveFacts) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      swift_named_edge(
        name: ^swift_witness_unsigned_int_commutative_semiring,
        target: swift_atom(id: ^swift_witness_unsigned_int_commutative_semiring)
      ),
      swift_named_edge(
        name: ^swift_facts_field_signedness,
        target: swift_signedness_node(signedness: facts.signedness)
      ),
      swift_named_edge(
        name: ^swift_facts_field_width,
        target: swift_width_node(width: facts.width)
      ),
      swift_named_edge(
        name: ^swift_facts_field_overflow,
        target: swift_overflow_node(overflow: facts.overflow)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn swift_float_algebra_witness_node(facts: SwiftFloatPrimitiveFacts) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      swift_named_edge(
        name: ^swift_witness_float_approximate_field,
        target: swift_atom(id: ^swift_witness_float_approximate_field)
      ),
      swift_named_edge(
        name: ^swift_facts_field_ieee754_binary,
        target: swift_atom(id: facts.ieee754_binary)
      ),
      swift_named_edge(
        name: ^swift_facts_field_width,
        target: swift_float_width_node(width: facts.width)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn swift_bool_algebra_witness_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      swift_named_edge(
        name: ^swift_witness_bool_boolean_algebra,
        target: swift_atom(id: ^swift_witness_bool_boolean_algebra)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn swift_string_algebra_witness_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      swift_named_edge(
        name: ^swift_witness_string_free_monoid,
        target: swift_atom(id: ^swift_witness_string_free_monoid)
      ),
      swift_named_edge(
        name: ^swift_facts_field_value_fact,
        target: swift_atom(id: ^swift_tag_string_unicode_text)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn swift_integer_algebra_inhabitance(facts: SwiftIntegerPrimitiveFacts) -> v2.std.model_core.AlgebraInhabitanceDecl {
  let inhabitant = swift_integer_inhabitant_node(id: facts.surface_spelling, facts: facts)
  match facts.signedness {
    Signed => v2.std.model_core.AlgebraInhabitanceDecl {
      algebra: ordered_ring_type_node(inhabitant: inhabitant),
      inhabitant: inhabitant,
      witness: swift_signed_int_algebra_witness_node(facts: facts)
    }
    Unsigned => v2.std.model_core.AlgebraInhabitanceDecl {
      algebra: commutative_semiring_type_node(inhabitant: inhabitant),
      inhabitant: inhabitant,
      witness: swift_unsigned_int_algebra_witness_node(facts: facts)
    }
  }
}

fn swift_float_algebra_inhabitance(facts: SwiftFloatPrimitiveFacts) -> v2.std.model_core.AlgebraInhabitanceDecl {
  let inhabitant = swift_float_inhabitant_node(id: facts.surface_spelling, facts: facts)
  v2.std.model_core.AlgebraInhabitanceDecl {
    algebra: approximate_field_type_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: swift_float_algebra_witness_node(facts: facts)
  }
}

fn swift_bool_algebra_inhabitance() -> v2.std.model_core.AlgebraInhabitanceDecl {
  let inhabitant = swift_nonnumeric_facts_node(facts: swift_facts_bool)
  v2.std.model_core.AlgebraInhabitanceDecl {
    algebra: boolean_algebra_type_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: swift_bool_algebra_witness_node()
  }
}

fn swift_string_algebra_inhabitance() -> v2.std.model_core.AlgebraInhabitanceDecl {
  let inhabitant = swift_nonnumeric_facts_node(facts: swift_facts_string)
  let code_unit = swift_atom(id: ^swift_inhabitant_unicode_scalar)
  v2.std.model_core.AlgebraInhabitanceDecl {
    algebra: free_monoid_type_node(inhabitant: code_unit),
    inhabitant: inhabitant,
    witness: swift_string_algebra_witness_node()
  }
}

fn swift_integer_algebra_inhabitance_decls() -> List<v2.std.model_core.AlgebraInhabitanceDecl> {
  list_map(xs: swift_integer_facts_catalog, f: fn(facts) {
    swift_integer_algebra_inhabitance(facts: facts)
  })
}

fn swift_float_algebra_inhabitance_decls() -> List<v2.std.model_core.AlgebraInhabitanceDecl> {
  list_map(xs: swift_float_facts_catalog, f: fn(facts) {
    swift_float_algebra_inhabitance(facts: facts)
  })
}

fn swift_model_core_inhabitance_decls() -> List<v2.std.model_core.AlgebraInhabitanceDecl> {
  list_append(
    left: list_append(
      left: list_append(
        left: swift_integer_algebra_inhabitance_decls(),
        right: swift_float_algebra_inhabitance_decls()
      ),
      right: [swift_bool_algebra_inhabitance()]
    ),
    right: [swift_string_algebra_inhabitance()]
  )
}

type SwiftModelCoreLawKey
  = SwiftLawSignedIntAddAssociative
  | SwiftLawSignedIntAddCommutative
  | SwiftLawSignedIntMulAssociative
  | SwiftLawSignedIntMulCommutative
  | SwiftLawSignedIntDistributive
  | SwiftLawSignedIntTotalOrder
  | SwiftLawUnsignedIntAddAssociative
  | SwiftLawUnsignedIntAddCommutative
  | SwiftLawUnsignedIntMulAssociative
  | SwiftLawUnsignedIntMulCommutative
  | SwiftLawUnsignedIntDistributive
  | SwiftLawFloatIeee754Rounding
  | SwiftLawFloatNanInfCarriedByIeee754
  | SwiftLawBoolBoundedLattice
  | SwiftLawBoolComplement
  | SwiftLawStringConcatAssociative
  | SwiftLawStringConcatLeftIdentity
  | SwiftLawStringConcatRightIdentity

fn swift_model_core_law_node(witness: Node, algebra: Node, key: SwiftModelCoreLawKey) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      swift_named_edge(name: ^model_core_law_field_subject, target: witness),
      swift_named_edge(name: ^model_core_law_field_algebra, target: algebra),
      swift_named_edge(
        name: ^model_core_law_field_kind,
        target: swift_atom(id: discriminant(v: key))
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn swift_model_core_law_obligation(witness: Node, law: Node) -> v2.std.model_core.AlgebraLawObligation {
  v2.std.model_core.AlgebraLawObligation {
    inhabitance_witness: witness,
    law: law
  }
}

fn swift_signed_int_law_obligations(facts: SwiftIntegerPrimitiveFacts) -> List<v2.std.model_core.AlgebraLawObligation> {
  let inhabitant = swift_integer_inhabitant_node(id: facts.surface_spelling, facts: facts)
  let algebra = ordered_ring_type_node(inhabitant: inhabitant)
  let witness = swift_signed_int_algebra_witness_node(facts: facts)
  [
    swift_model_core_law_obligation(
      witness: witness,
      law: swift_model_core_law_node(witness: witness, algebra: algebra, key: SwiftLawSignedIntAddAssociative)
    ),
    swift_model_core_law_obligation(
      witness: witness,
      law: swift_model_core_law_node(witness: witness, algebra: algebra, key: SwiftLawSignedIntAddCommutative)
    ),
    swift_model_core_law_obligation(
      witness: witness,
      law: swift_model_core_law_node(witness: witness, algebra: algebra, key: SwiftLawSignedIntMulAssociative)
    ),
    swift_model_core_law_obligation(
      witness: witness,
      law: swift_model_core_law_node(witness: witness, algebra: algebra, key: SwiftLawSignedIntMulCommutative)
    ),
    swift_model_core_law_obligation(
      witness: witness,
      law: swift_model_core_law_node(witness: witness, algebra: algebra, key: SwiftLawSignedIntDistributive)
    ),
    swift_model_core_law_obligation(
      witness: witness,
      law: swift_model_core_law_node(witness: witness, algebra: algebra, key: SwiftLawSignedIntTotalOrder)
    )
  ]
}

fn swift_unsigned_int_law_obligations(facts: SwiftIntegerPrimitiveFacts) -> List<v2.std.model_core.AlgebraLawObligation> {
  let inhabitant = swift_integer_inhabitant_node(id: facts.surface_spelling, facts: facts)
  let algebra = commutative_semiring_type_node(inhabitant: inhabitant)
  let witness = swift_unsigned_int_algebra_witness_node(facts: facts)
  [
    swift_model_core_law_obligation(
      witness: witness,
      law: swift_model_core_law_node(witness: witness, algebra: algebra, key: SwiftLawUnsignedIntAddAssociative)
    ),
    swift_model_core_law_obligation(
      witness: witness,
      law: swift_model_core_law_node(witness: witness, algebra: algebra, key: SwiftLawUnsignedIntAddCommutative)
    ),
    swift_model_core_law_obligation(
      witness: witness,
      law: swift_model_core_law_node(witness: witness, algebra: algebra, key: SwiftLawUnsignedIntMulAssociative)
    ),
    swift_model_core_law_obligation(
      witness: witness,
      law: swift_model_core_law_node(witness: witness, algebra: algebra, key: SwiftLawUnsignedIntMulCommutative)
    ),
    swift_model_core_law_obligation(
      witness: witness,
      law: swift_model_core_law_node(witness: witness, algebra: algebra, key: SwiftLawUnsignedIntDistributive)
    )
  ]
}

fn swift_integer_law_obligations(facts: SwiftIntegerPrimitiveFacts) -> List<v2.std.model_core.AlgebraLawObligation> {
  match facts.signedness {
    Signed => swift_signed_int_law_obligations(facts: facts)
    Unsigned => swift_unsigned_int_law_obligations(facts: facts)
  }
}

fn swift_float_law_obligations(facts: SwiftFloatPrimitiveFacts) -> List<v2.std.model_core.AlgebraLawObligation> {
  let inhabitant = swift_float_inhabitant_node(id: facts.surface_spelling, facts: facts)
  let algebra = approximate_field_type_node(inhabitant: inhabitant)
  let witness = swift_float_algebra_witness_node(facts: facts)
  [
    swift_model_core_law_obligation(
      witness: witness,
      law: swift_model_core_law_node(witness: witness, algebra: algebra, key: SwiftLawFloatIeee754Rounding)
    ),
    swift_model_core_law_obligation(
      witness: witness,
      law: swift_model_core_law_node(witness: witness, algebra: algebra, key: SwiftLawFloatNanInfCarriedByIeee754)
    )
  ]
}

fn swift_bool_law_obligations() -> List<v2.std.model_core.AlgebraLawObligation> {
  let inhabitant = swift_nonnumeric_facts_node(facts: swift_facts_bool)
  let algebra = boolean_algebra_type_node(inhabitant: inhabitant)
  let witness = swift_bool_algebra_witness_node()
  [
    swift_model_core_law_obligation(
      witness: witness,
      law: swift_model_core_law_node(witness: witness, algebra: algebra, key: SwiftLawBoolBoundedLattice)
    ),
    swift_model_core_law_obligation(
      witness: witness,
      law: swift_model_core_law_node(witness: witness, algebra: algebra, key: SwiftLawBoolComplement)
    )
  ]
}

fn swift_string_law_obligations() -> List<v2.std.model_core.AlgebraLawObligation> {
  let inhabitant = swift_nonnumeric_facts_node(facts: swift_facts_string)
  let code_unit = swift_atom(id: ^swift_inhabitant_unicode_scalar)
  let algebra = free_monoid_type_node(inhabitant: code_unit)
  let witness = swift_string_algebra_witness_node()
  [
    swift_model_core_law_obligation(
      witness: witness,
      law: swift_model_core_law_node(witness: witness, algebra: algebra, key: SwiftLawStringConcatAssociative)
    ),
    swift_model_core_law_obligation(
      witness: witness,
      law: swift_model_core_law_node(witness: witness, algebra: algebra, key: SwiftLawStringConcatLeftIdentity)
    ),
    swift_model_core_law_obligation(
      witness: witness,
      law: swift_model_core_law_node(witness: witness, algebra: algebra, key: SwiftLawStringConcatRightIdentity)
    )
  ]
}

fn swift_integer_law_decls() -> List<v2.std.model_core.AlgebraLawObligation> {
  list_flat_map(xs: swift_integer_facts_catalog, f: fn(facts) {
    swift_integer_law_obligations(facts: facts)
  })
}

fn swift_float_law_decls() -> List<v2.std.model_core.AlgebraLawObligation> {
  list_flat_map(xs: swift_float_facts_catalog, f: fn(facts) {
    swift_float_law_obligations(facts: facts)
  })
}

fn swift_model_core_law_obligations() -> List<v2.std.model_core.AlgebraLawObligation> {
  list_append(
    left: list_append(
      left: list_append(
        left: swift_integer_law_decls(),
        right: swift_float_law_decls()
      ),
      right: swift_bool_law_obligations()
    ),
    right: swift_string_law_obligations()
  )
}
fn swift_pure_operation(operation: v2.std.node.Symbol) -> v2.std.model_core.PrimitiveOperationRef {
  v2.std.model_core.PrimitiveOperationRef {
    operation: swift_atom(id: operation),
    effect_signature: v2.std.model_core.EffectSignature {
      signature: swift_atom(id: ^swift_effect_signature_pure_value)
    }
  }
}

fn swift_effect_semantics() -> v2.std.model_core.EffectSemanticsDecl {
  v2.std.model_core.EffectSemanticsDecl {
    operations: [
      swift_pure_operation(operation: ^swift_op_int_add),
      swift_pure_operation(operation: ^swift_op_int_sub),
      swift_pure_operation(operation: ^swift_op_int_mul),
      swift_pure_operation(operation: ^swift_op_int_div),
      swift_pure_operation(operation: ^swift_op_int_rem),
      swift_pure_operation(operation: ^swift_op_int_neg),
      swift_pure_operation(operation: ^swift_op_int_compare),
      swift_pure_operation(operation: ^swift_op_uint_add),
      swift_pure_operation(operation: ^swift_op_uint_sub),
      swift_pure_operation(operation: ^swift_op_uint_mul),
      swift_pure_operation(operation: ^swift_op_uint_div),
      swift_pure_operation(operation: ^swift_op_uint_rem),
      swift_pure_operation(operation: ^swift_op_uint_compare),
      swift_pure_operation(operation: ^swift_op_float_add),
      swift_pure_operation(operation: ^swift_op_float_sub),
      swift_pure_operation(operation: ^swift_op_float_mul),
      swift_pure_operation(operation: ^swift_op_float_div),
      swift_pure_operation(operation: ^swift_op_float_neg),
      swift_pure_operation(operation: ^swift_op_float_compare),
      swift_pure_operation(operation: ^swift_op_bool_and),
      swift_pure_operation(operation: ^swift_op_bool_or),
      swift_pure_operation(operation: ^swift_op_bool_not),
      swift_pure_operation(operation: ^swift_op_string_concat)
    ]
  }
}
fn swift_fail_closed_partial_operation(
  operation: v2.std.node.Symbol,
  precondition: v2.std.node.Symbol,
  reason: v2.std.node.Symbol
) -> v2.std.model_core.PartialOperationDecl {
  v2.std.model_core.PartialOperationDecl {
    operation: swift_atom(id: operation),
    precondition: swift_atom(id: precondition),
    discharge: v2.std.model_core.FailClosedAtBoundary { reason: reason }
  }
}

fn swift_partiality_semantics() -> v2.std.model_core.PartialitySemanticsDecl {
  v2.std.model_core.PartialitySemanticsDecl {
    operations: [
      swift_fail_closed_partial_operation(
        operation: ^swift_op_int_div,
        precondition: ^swift_precondition_divisor_nonzero,
        reason: ^swift_partial_int_divide_by_zero
      ),
      swift_fail_closed_partial_operation(
        operation: ^swift_op_int_rem,
        precondition: ^swift_precondition_divisor_nonzero,
        reason: ^swift_partial_int_remainder_by_zero
      ),
      swift_fail_closed_partial_operation(
        operation: ^swift_op_int_div,
        precondition: ^swift_precondition_signed_division_not_min_over_negative_one,
        reason: ^swift_partial_signed_min_divide_by_negative_one
      ),
      swift_fail_closed_partial_operation(
        operation: ^swift_op_int_rem,
        precondition: ^swift_precondition_signed_division_not_min_over_negative_one,
        reason: ^swift_partial_signed_min_divide_by_negative_one
      ),
      swift_fail_closed_partial_operation(
        operation: ^swift_op_uint_div,
        precondition: ^swift_precondition_divisor_nonzero,
        reason: ^swift_partial_uint_divide_by_zero
      ),
      swift_fail_closed_partial_operation(
        operation: ^swift_op_uint_rem,
        precondition: ^swift_precondition_divisor_nonzero,
        reason: ^swift_partial_uint_remainder_by_zero
      ),
      swift_fail_closed_partial_operation(
        operation: ^swift_op_int_add,
        precondition: ^swift_precondition_no_overflow,
        reason: ^swift_partial_int_add_overflow
      ),
      swift_fail_closed_partial_operation(
        operation: ^swift_op_int_sub,
        precondition: ^swift_precondition_no_overflow,
        reason: ^swift_partial_int_sub_overflow
      ),
      swift_fail_closed_partial_operation(
        operation: ^swift_op_int_mul,
        precondition: ^swift_precondition_no_overflow,
        reason: ^swift_partial_int_mul_overflow
      ),
      swift_fail_closed_partial_operation(
        operation: ^swift_op_int_neg,
        precondition: ^swift_precondition_no_overflow,
        reason: ^swift_partial_int_neg_overflow
      ),
      swift_fail_closed_partial_operation(
        operation: ^swift_op_uint_add,
        precondition: ^swift_precondition_no_overflow,
        reason: ^swift_partial_uint_add_overflow
      ),
      swift_fail_closed_partial_operation(
        operation: ^swift_op_uint_sub,
        precondition: ^swift_precondition_no_overflow,
        reason: ^swift_partial_uint_sub_overflow
      ),
      swift_fail_closed_partial_operation(
        operation: ^swift_op_uint_mul,
        precondition: ^swift_precondition_no_overflow,
        reason: ^swift_partial_uint_mul_overflow
      ),
      swift_fail_closed_partial_operation(
        operation: ^swift_op_float_compare,
        precondition: ^swift_precondition_neither_arg_nan,
        reason: ^swift_partial_float_compare_nan
      )
    ]
  }
}

fn swift_model_core() -> v2.std.model_core.ModelCore {
  v2.std.model_core.ModelCore {
    primitives: swift_primitive_fact_bundles(),
    inhabitance: swift_model_core_inhabitance_decls(),
    laws: swift_model_core_law_obligations(),
    effects: swift_effect_semantics(),
    partiality: swift_partiality_semantics()
  }
}

fn swift_language_model() -> v2.std.language_model.LanguageModel {
  v2.std.language_model.LanguageModel {
    lex: VoidLexRules,
    grammar: VoidGrammar,
    language_identity: ^swift_language_model_surface_id,
    canonical_symbols: swift_language_model_canonical_symbols(),
    core: swift_model_core()
  }
}
