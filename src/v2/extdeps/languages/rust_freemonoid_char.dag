module v2.extdeps.languages.rust_freemonoid_char

import v2.std.compilers.target_model { PrimitiveRealizationsUnwired,
  TargetModel,
  ProducedDeclUnwired,
  target_model_emit_transforms_empty,
}
import v2.std.compilers.lexing { VoidLexRules }

import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import v2.std.node { Node, Edge, Authored, TypeNode, Conj, OccurrenceSynthetic, fold_list_node, NotADeclaration }
import std.algebra { Cons, Empty, empty_map }
import v2.extdeps.languages.rust {
  rust_type_expression_projection_bundle_node,
  rust_free_monoid_collection_realization_bundle_node,
}

fn fmc_fixture_target_model() -> TargetModel {
  TargetModel {
    primitive_realizations: PrimitiveRealizationsUnwired,
    produced_decl_support: ProducedDeclUnwired,
    bundle: fmc_fixture_bundle_core(),
    lex: VoidLexRules,
    binding_spellings: empty_map(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: "",
    runtime_row: target_emit_host_runtime_row_unconfigured
  }
}

fn fmc_fixture_bundle_core() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Authored { name: ^target_model_edge_type_expression_projection },
        target: rust_type_expression_projection_bundle_node(),
        declaration: NotADeclaration
      },
      Edge {
        label: Authored { name: ^target_model_edge_collection_realization },
        target: fmc_minimal_collection_realization_catalog(),
        declaration: NotADeclaration
      }
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn fmc_minimal_collection_realization_catalog() -> Node {
  fold_list_node(
    xs: Cons {
      head: rust_free_monoid_collection_realization_bundle_node(),
      tail: Empty
    },
    item_node: fn(row) { row }
  )
}
