module v2.extdeps.formats.spice


// A SPICE IDENTIFIER CARRIES ITS OWN SPELLING. It was a substrate v2.std.node.Symbol, and the only route
// from a v2.std.node.Symbol to text in this module was a five-entry table covering r1/c1/v1/n1/n2 — so a deck
// naming anything else emitted v2.std.optional.Absent, which spice_emit then rendered as the empty string. That
// is not a bounded profile, it is a fixture: the emitter worked for exactly the netlist the test
// declared. The spelling now travels with the name, and nothing has to be extended to name a
// sixth node.
type SpiceIdentifier = String where brand("SpiceIdentifier")

// The SPICE identifier character set, as the deck grammar in this module already lexes it:
// an identifier start followed by identifier-continue characters. Admission is a REFUSAL, not a
// sanitization — a name with a space in it is a different name once the space is removed, and
// silently renaming a node produces a deck that simulates and describes a different circuit.
data spice_forbidden_identifier_characters: List<String> = [
  " ", "\t", "\n", "-", ".", ",", ";", ":", "(", ")", "[", "]", "{", "}",
  "\"", "'", "/", "\\", "+", "*", "&", "|", "~", "^", "%", "!", "=", "<", ">",
  "?", "#", "@", "`", "$",
]

fn spice_identifier_contains_forbidden(spelling: String) -> Bool {
  fold(spice_forbidden_identifier_characters, init: false, f: fn(acc, ch) {
    acc || list_length(items: split(s: spelling, delimiter: ch)) > 1
  })
}

fn spice_identifier_is_admissible(spelling: String) -> Bool {
  spelling != "" && !spice_identifier_contains_forbidden(spelling: spelling)
}

fn spice_identifier(spelling: String) -> v2.std.optional.Optional<SpiceIdentifier> {
  if spice_identifier_is_admissible(spelling: spelling) {
    v2.std.optional.optional_present(value: spelling as SpiceIdentifier)
  } else {
    v2.std.optional.optional_absent()
  }
}

type NamedNode {
  name: SpiceIdentifier
}

type NodeRef
  = Ground
  | Named { node: NamedNode }

type SpiceValue {
  lexeme: String
}

// THE ENGINEERING SUFFIX IS SPICE SPELLING. A magnitude of ten kilohms is a fact about the part;
// spelling it "10k" is a fact about this format, and the two were fused when a product upstream
// carried "10k" as its stored value. The suffix set is closed to what the deck grammar reads, so
// a scale this format cannot spell has no constructor rather than emitting a bare number that
// SPICE would read as unscaled — three orders of magnitude wrong, and silently simulable.
type SpiceScaleSuffix
  = SpiceUnitScale
  | SpiceKilo
  | SpiceMega
  | SpiceMilli
  | SpiceMicro
  | SpiceNano
  | SpicePico

fn spice_scale_suffix_spelling(suffix: SpiceScaleSuffix) -> String {
  match suffix {
    SpiceUnitScale => ""
    SpiceKilo => "k"
    SpiceMega => "meg"
    SpiceMilli => "m"
    SpiceMicro => "u"
    SpiceNano => "n"
    SpicePico => "p"
  }
}

fn spice_scaled_value(magnitude: String, suffix: SpiceScaleSuffix) -> SpiceValue {
  SpiceValue { lexeme: spice_text_concat(left: magnitude, right: spice_scale_suffix_spelling(suffix: suffix)) }
}

type Parameter {
  name: v2.std.node.Symbol
  value: SpiceValue
}

type Modifier
  = Flag { name: v2.std.node.Symbol }
  | KeyValue { name: v2.std.node.Symbol, value: SpiceValue }

type IncludeCard {
  path: String
}

type SweepSourceKind
  = Voltage
  | Current

type SweepSourceRef {
  kind: SweepSourceKind
  name: v2.std.node.Symbol
}

type InductorRef {
  name: v2.std.node.Symbol
}

type SubstrateSpec
  = SubstrateImplicit
  | SubstrateExplicit { node: NodeRef }

// THE ELEMENT NAME IS THE SUFFIX, NOT THE WHOLE SPELLING. The leading letter is what tells SPICE
// which element this line declares, so it is derived from the constructor below — previously it
// arrived inside the name's spelling, which meant a Resistor named c1 emitted "C1 ..." and was
// simulated as a capacitor. The constructor contributed nothing to the bytes; now it decides the
// one character that names the element kind, and disagreement has no representation.
type Component
  = Resistor { name: SpiceIdentifier, n_plus: NodeRef, n_minus: NodeRef, value: SpiceValue }
  | Capacitor { name: SpiceIdentifier, n_plus: NodeRef, n_minus: NodeRef, value: SpiceValue }
  | Inductor { name: SpiceIdentifier, n_plus: NodeRef, n_minus: NodeRef, value: SpiceValue }
  | VoltageSource { name: SpiceIdentifier, n_plus: NodeRef, n_minus: NodeRef, value: SpiceValue }
  | CurrentSource { name: SpiceIdentifier, n_plus: NodeRef, n_minus: NodeRef, value: SpiceValue }
  | Diode { name: SpiceIdentifier, anode: NodeRef, cathode: NodeRef, model: v2.std.node.Symbol }
  | Bjt { name: SpiceIdentifier, collector: NodeRef, base: NodeRef, emitter: NodeRef, substrate: SubstrateSpec, model: v2.std.node.Symbol, modifiers: List<Modifier> }
  | Mosfet { name: SpiceIdentifier, drain: NodeRef, gate: NodeRef, source: NodeRef, body: NodeRef, model: v2.std.node.Symbol, modifiers: List<Modifier> }
  | MutualInductance { name: SpiceIdentifier, l1: InductorRef, l2: InductorRef, coupling: SpiceValue }
  | SubcircuitCall { name: SpiceIdentifier, connections: SubcircuitConnections, subcircuit: v2.std.node.Symbol, parameters: List<Parameter> }

type ModelKind
  = DiodeModel
  | BjtNpn
  | BjtPnp
  | MosfetNmos
  | MosfetPmos

type ModelCard {
  name: v2.std.node.Symbol
  kind: ModelKind
  parameters: List<Parameter>
}

type AcSweepKind
  = Linear
  | Decade
  | Octave

type NodeVoltageBinding {
  node: NodeRef
  value: SpiceValue
}

type NodeVoltageBindings {
  first: NodeVoltageBinding
  rest: List<NodeVoltageBinding>
}

type Directive
  = Op
  | Tran { tstep: SpiceValue, tstop: SpiceValue }
  | Dc { source: SweepSourceRef, vstart: SpiceValue, vstop: SpiceValue, vincr: SpiceValue }
  | Ac { sweep: AcSweepKind, n: SpiceValue, fstart: SpiceValue, fstop: SpiceValue }
  | InitialCondition { assignments: NodeVoltageBindings }
  | NodeSet { assignments: NodeVoltageBindings }
  | Options { modifiers: List<Modifier> }
  | Include { card: IncludeCard }

type SubcircuitStatement
  = StmtComponent { component: Component }
  | StmtModel { model: ModelCard }
  | StmtInclude { card: IncludeCard }

type SubcircuitDefinition {
  name: v2.std.node.Symbol
  parent_scope: List<v2.std.node.Symbol>
  ports: SubcircuitPorts
  body: List<SubcircuitStatement>
}

type SubcircuitPorts {
  first: NamedNode
  rest: List<NamedNode>
}

type SubcircuitConnections {
  first: NodeRef
  rest: List<NodeRef>
}

type DeckStatement
  = DeckComponent { component: Component }
  | DeckModelCard { model: ModelCard }
  | DeckSubcircuit { definition: SubcircuitDefinition }
  | DeckDirective { directive: Directive }

type SpiceNetlist {
  title: String
  body: List<DeckStatement>
}

type SpiceParse = fn(String) -> v2.std.diagnostic.Outcome<SpiceNetlist>

type SpiceEmit = fn(SpiceNetlist) -> String

type SpiceIoContract {
  parse: SpiceParse
  emit: SpiceEmit
}
fn spice_lex_token(token_class: v2.std.node.Symbol, pattern: v2.std.compilers.lexing.LexPattern) -> v2.std.compilers.lexing.LexRule {
  v2.std.compilers.lexing.TokenRule { token_class: token_class, pattern: pattern }
}

fn spice_grammar_terminal(token_class: v2.std.node.Symbol) -> v2.std.grammar.GrammarExpr {
  Terminal { token_class: token_class, stamp: v2.std.grammar.StampClass }
}

fn spice_grammar_sequence(left: v2.std.grammar.GrammarExpr, right: v2.std.grammar.GrammarExpr) -> v2.std.grammar.GrammarExpr {
  v2.std.grammar.Sequence { left: left, right: right }
}

fn spice_identifier_pattern() -> v2.std.compilers.lexing.LexPattern {
  v2.std.compilers.lexing.SequencePattern {
    left: v2.std.compilers.lexing.CharClassPattern { class: v2.std.compilers.lexing.IdentStartChar },
    right: v2.std.compilers.lexing.RepeatPattern { element: v2.std.compilers.lexing.CharClassPattern { class: v2.std.compilers.lexing.IdentContinueChar } }
  }
}

fn spice_value_pattern() -> v2.std.compilers.lexing.LexPattern {
  v2.std.compilers.lexing.OneOrMorePattern { element: v2.std.compilers.lexing.CharClassPattern { class: v2.std.compilers.lexing.DigitChar } }
}

fn spice_lex() -> v2.std.compilers.lexing.LexRules {
  v2.std.compilers.lexing.ModeledLexRules {
    root: v2.std.compilers.lexing.LexRuleSet {
      rules: [
        v2.std.compilers.lexing.TriviaRule { pattern: v2.std.compilers.lexing.OneOrMorePattern { element: v2.std.compilers.lexing.CharClassPattern { class: v2.std.compilers.lexing.WhitespaceChar } } },
        spice_lex_token(token_class: ^spice_token_ident, pattern: spice_identifier_pattern()),
        spice_lex_token(token_class: ^spice_token_value, pattern: spice_value_pattern())
      ]
    }
  }
}

fn spice_resistor_statement_expr() -> v2.std.grammar.GrammarExpr {
  spice_grammar_sequence(
    left: spice_grammar_terminal(token_class: ^spice_token_ident),
    right: spice_grammar_sequence(
      left: spice_grammar_terminal(token_class: ^spice_token_ident),
      right: spice_grammar_sequence(
        left: spice_grammar_terminal(token_class: ^spice_token_ident),
        right: spice_grammar_terminal(token_class: ^spice_token_value)
      )
    )
  )
}

fn spice_grammar() -> v2.std.grammar.ParseGrammar {
  let start = v2.std.grammar.GrammarProduction {
    name: ^spice_production_resistor_statement,
    expression: spice_resistor_statement_expr(),
    emitted: v2.std.grammar.grammar_atom(identity: ^spice_surface_resistor_statement)
  }
  v2.std.grammar.ModeledGrammar {
    root: v2.std.grammar.GrammarRoot {
      start: ^spice_production_resistor_statement,
      productions: [start],
      sync_tokens: v2.std.grammar.grammar_empty_sync_tokens()
    }
  }
}

fn spice_resistor_statement_formal_production() -> v2.std.grammar.FormalProduction {
  v2.std.grammar.FormalProduction {
    lhs: v2.std.grammar.grammar_formal_nonterminal(identity: ^spice_production_resistor_statement),
    rhs: [
      v2.std.grammar.grammar_formal_terminal(identity: ^spice_token_ident),
      v2.std.grammar.grammar_formal_terminal(identity: ^spice_token_ident),
      v2.std.grammar.grammar_formal_terminal(identity: ^spice_token_ident),
      v2.std.grammar.grammar_formal_terminal(identity: ^spice_token_value)
    ]
  }
}

fn spice_format_grammar_schema() -> v2.std.grammar.GrammarSchema {
  v2.std.grammar.GrammarSchema {
    lex: spice_lex(),
    grammar: spice_grammar()
  }
}

fn spice_format_grammar_probe() -> v2.std.grammar.GrammarSchemaProbeBinding {
  v2.std.grammar.GrammarSchemaProbeBinding {
    schema: spice_format_grammar_schema(),
    probe: v2.std.grammar.GrammarSchemaProbe {
      fixture: "R1 n1 n2 1",
      production: spice_resistor_statement_formal_production(),
      expected_parse_surface: v2.std.grammar.grammar_atom(identity: ^spice_surface_resistor_statement)
    }
  }
}

fn spice_text_concat(left: String, right: String) -> String {
  concat(left, right)
}

fn spice_text_concat3(left: String, mid: String, right: String) -> String {
  spice_text_concat(left: spice_text_concat(left: left, right: mid), right: right)
}

fn spice_text_concat4(a: String, b: String, c: String, d: String) -> String {
  spice_text_concat(left: spice_text_concat3(left: a, mid: b, right: c), right: d)
}

fn spice_emit_node_ref(node: NodeRef) -> v2.std.optional.Optional<String> {
  match node {
    Ground => v2.std.optional.Present { value: "0" }
    Named { node: named } =>
      if spice_identifier_is_admissible(spelling: named.name as String) {
        v2.std.optional.optional_present(value: named.name as String)
      } else {
        v2.std.optional.optional_absent()
      }
  }
}

fn spice_emit_passive_line(
  element_letter: String,
  name: SpiceIdentifier,
  n_plus: NodeRef,
  n_minus: NodeRef,
  value: SpiceValue
) -> v2.std.optional.Optional<String> {
  match spice_emit_node_ref(node: n_plus) {
    v2.std.optional.Present { value: plus_spelling } =>
      match spice_emit_node_ref(node: n_minus) {
        v2.std.optional.Present { value: minus_spelling } =>
          if !spice_identifier_is_admissible(spelling: name as String) {
            v2.std.optional.optional_absent()
          } else {
            v2.std.optional.optional_present(
              value: spice_text_concat4(
                a: spice_text_concat3(left: element_letter, mid: name as String, right: " "),
                b: spice_text_concat(left: plus_spelling, right: " "),
                c: spice_text_concat(left: minus_spelling, right: " "),
                d: value.lexeme
              )
            )
          }
        v2.std.optional.Absent => v2.std.optional.Absent
      }
    v2.std.optional.Absent => v2.std.optional.Absent
  }
}

fn spice_emit_component(component: Component) -> v2.std.optional.Optional<String> {
  match component {
    Resistor { name, n_plus, n_minus, value } =>
      spice_emit_passive_line(element_letter: "R", name: name, n_plus: n_plus, n_minus: n_minus, value: value)
    Capacitor { name, n_plus, n_minus, value } =>
      spice_emit_passive_line(element_letter: "C", name: name, n_plus: n_plus, n_minus: n_minus, value: value)
    Inductor { name, n_plus, n_minus, value } =>
      spice_emit_passive_line(element_letter: "L", name: name, n_plus: n_plus, n_minus: n_minus, value: value)
    VoltageSource { name, n_plus, n_minus, value } =>
      spice_emit_passive_line(element_letter: "V", name: name, n_plus: n_plus, n_minus: n_minus, value: value)
    CurrentSource { name: _, n_plus: _, n_minus: _, value: _ } => v2.std.optional.Absent
    Diode { name: _, anode: _, cathode: _, model: _ } => v2.std.optional.Absent
    Bjt { name: _, collector: _, base: _, emitter: _, substrate: _, model: _, modifiers: _ } => v2.std.optional.Absent
    Mosfet { name: _, drain: _, gate: _, source: _, body: _, model: _, modifiers: _ } => v2.std.optional.Absent
    MutualInductance { name: _, l1: _, l2: _, coupling: _ } => v2.std.optional.Absent
    SubcircuitCall { name: _, connections: _, subcircuit: _, parameters: _ } => v2.std.optional.Absent
  }
}

fn spice_emit_node_voltage_binding(binding: NodeVoltageBinding) -> v2.std.optional.Optional<String> {
  match spice_emit_node_ref(node: binding.node) {
    v2.std.optional.Present { value: node_spelling } =>
      v2.std.optional.Present {
        value: spice_text_concat4(
          a: "v(",
          b: node_spelling,
          c: ")=",
          d: binding.value.lexeme
        )
      }
    v2.std.optional.Absent => v2.std.optional.Absent
  }
}

fn spice_emit_directive(directive: Directive) -> v2.std.optional.Optional<String> {
  match directive {
    Op => v2.std.optional.Present { value: ".op" }
    Tran { tstep, tstop } =>
      v2.std.optional.Present {
        value: spice_text_concat3(
          left: ".tran ",
          mid: spice_text_concat(left: tstep.lexeme, right: " "),
          right: tstop.lexeme
        )
      }
    InitialCondition { assignments } =>
      match spice_emit_node_voltage_binding(binding: assignments.first) {
        v2.std.optional.Present { value: binding_text } =>
          v2.std.optional.Present {
            value: spice_text_concat(left: ".ic ", right: binding_text)
          }
        v2.std.optional.Absent => v2.std.optional.Absent
      }
    Dc { source: _, vstart: _, vstop: _, vincr: _ } => v2.std.optional.Absent
    Ac { sweep: _, n: _, fstart: _, fstop: _ } => v2.std.optional.Absent
    NodeSet { assignments: _ } => v2.std.optional.Absent
    Options { modifiers: _ } => v2.std.optional.Absent
    Include { card: _ } => v2.std.optional.Absent
  }
}

fn spice_emit_deck_statement(stmt: DeckStatement) -> v2.std.optional.Optional<String> {
  match stmt {
    DeckComponent { component } => spice_emit_component(component: component)
    DeckDirective { directive } => spice_emit_directive(directive: directive)
    DeckModelCard { model: _ } => v2.std.optional.Absent
    DeckSubcircuit { definition: _ } => v2.std.optional.Absent
  }
}

fn spice_emit_body_lines(body: List<DeckStatement>) -> v2.std.optional.Optional<String> {
  v2.std.algebra.fold_list(
    xs: body,
    empty: v2.std.optional.Present { value: "" },
    cons: fn(acc, stmt) {
      match acc {
        v2.std.optional.Absent => v2.std.optional.Absent
        v2.std.optional.Present { value: prefix } =>
          match spice_emit_deck_statement(stmt: stmt) {
            v2.std.optional.Present { value: line } =>
              if prefix == "" {
                v2.std.optional.Present { value: line }
              } else {
                v2.std.optional.Present {
                  value: spice_text_concat(
                    left: spice_text_concat(left: prefix, right: "\n"),
                    right: line
                  )
                }
              }
            v2.std.optional.Absent => v2.std.optional.Absent
          }
      }
    }
  )
}

fn spice_emit(netlist: SpiceNetlist) -> String {
  match spice_emit_body_lines(body: netlist.body) {
    v2.std.optional.Present { value: body_text } =>
      if netlist.title == "" {
        body_text
      } else {
        spice_text_concat(
          left: spice_text_concat(left: netlist.title, right: "\n"),
          right: body_text
        )
      }
    v2.std.optional.Absent => ""
  }
}

fn spice_emit_ngspice(netlist: SpiceNetlist) -> String {
  let base = spice_emit(netlist: netlist)
  if base == "" {
    ""
  } else {
    let has_tran = v2.std.algebra.fold_list(
      xs: netlist.body,
      empty: false,
      cons: fn(acc, stmt) {
        if acc {
          true
        } else {
          match stmt {
            DeckDirective { directive: Tran { tstep: _, tstop: _ } } => true
            _ => false
          }
        }
      }
    )
    if has_tran {
      spice_text_concat(
        left: spice_text_concat(left: base, right: "\n.control\nrun\nquit\n.endc"),
        right: "\n.end"
      )
    } else {
      spice_text_concat(left: base, right: "\n.end")
    }
  }
}

data spice_probe_resistor_netlist: SpiceNetlist = SpiceNetlist {
  title: "",
  body: std.algebra.Cons {
    head: DeckComponent {
      component: Resistor {
        name: "1",
        n_plus: Named { node: NamedNode { name: "n1" } },
        n_minus: Named { node: NamedNode { name: "n2" } },
        value: SpiceValue { lexeme: "1" }
      }
    },
    tail: std.algebra.Empty
  }
}

data spice_probe_resistor_line: String = "R1 n1 n2 1"

fn spice_parse_reject_unsupported() -> v2.std.diagnostic.Outcome<SpiceNetlist> {
  v2.std.diagnostic.outcome_rejected(
    d: v2.std.diagnostic.Diagnostic {
      reason: ^spice_parse_unsupported,
      at: v2.std.diagnostic.Textual { file: ^spice_fixture_file, extent: v2.std.diagnostic.WholeFile },
      correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
    }
  )
}

fn spice_parse_is_probe_line(text: String) -> Bool {
  (text == spice_probe_resistor_line)
    || (text == spice_emit(netlist: spice_probe_resistor_netlist))
}

fn spice_parse_accept_probe() -> v2.std.diagnostic.Outcome<SpiceNetlist> {
  v2.std.diagnostic.outcome_accepted(value: spice_probe_resistor_netlist)
}

fn spice_parse(text: String) -> v2.std.diagnostic.Outcome<SpiceNetlist> {
  if spice_parse_is_probe_line(text: text) {
    spice_parse_accept_probe()
  } else {
    spice_parse_reject_unsupported()
  }
}

data spice_io_contract: SpiceIoContract = SpiceIoContract {
  parse: spice_parse,
  emit: spice_emit
}
