module v2.extdeps.formats.openapi

import v2.extdeps.coordination { ExchangePattern, RequestReply }
import v2.extdeps.formats.json { JsonDocument, JsonValue }
import v2.extdeps.formats.json_schema { JsonSchema }
import v2.extdeps.formats.yaml { YamlDocument }
import v2.std.collection { Optional }
import v2.std.nat { Nat }
import v2.std.network {
  DELETE,
  GET,
  HEAD,
  HttpMethod,
  OPTIONS,
  PATCH,
  POST,
  PUT,
  TRACE,
  UriReference
}

type OpenApiSpecificationExtensionKey
  = OpenApiSpecExtensionOaiReserved { remainder: String }
  | OpenApiSpecExtensionOasReserved { remainder: String }
  | OpenApiSpecExtensionVendor { after_x_hyphen: String }

type OpenApiComponentsMapKey {
  name: String,
}

type OpenApiOpenapiObjectDeferredKey
  = OpenApiOpenapiDeferredServers
  | OpenApiOpenapiDeferredSecurity
  | OpenApiOpenapiDeferredTags
  | OpenApiOpenapiDeferredExternalDocs

type OpenApiOperationDeferredKey
  = OpenApiOpDeferredTags
  | OpenApiOpDeferredSummary
  | OpenApiOpDeferredDescription
  | OpenApiOpDeferredExternalDocs
  | OpenApiOpDeferredParameters
  | OpenApiOpDeferredRequestBody
  | OpenApiOpDeferredCallbacks
  | OpenApiOpDeferredSecurity
  | OpenApiOpDeferredServers
  | OpenApiOpDeferredDeprecated

type OpenApiPathItemDeferredKey
  = OpenApiPathDeferredDollarRef
  | OpenApiPathDeferredSummary
  | OpenApiPathDeferredDescription
  | OpenApiPathDeferredServers
  | OpenApiPathDeferredParameters

type OpenApiComponentsDeferredKey
  = OpenApiComponentsDeferredResponses
  | OpenApiComponentsDeferredParameters
  | OpenApiComponentsDeferredRequestBodies
  | OpenApiComponentsDeferredHeaders
  | OpenApiComponentsDeferredSecuritySchemes
  | OpenApiComponentsDeferredExamples
  | OpenApiComponentsDeferredLinks
  | OpenApiComponentsDeferredCallbacks

type OpenApiMediaTypeDeferredKey
  = OpenApiMediaDeferredExample
  | OpenApiMediaDeferredExamples
  | OpenApiMediaDeferredEncoding

type OpenApiHeaderDeferredKey
  = OpenApiHeaderDeferredStyle
  | OpenApiHeaderDeferredExplode
  | OpenApiHeaderDeferredExample
  | OpenApiHeaderDeferredExamples

type OpenApiLinkDeferredKey
  = OpenApiLinkDeferredParameters
  | OpenApiLinkDeferredRequestBody
  | OpenApiLinkDeferredServer

type OpenApiSchemaOasMemberKey
  = OpenApiSchemaOasDiscriminator
  | OpenApiSchemaOasXml
  | OpenApiSchemaOasExternalDocs
  | OpenApiSchemaOasExample

type OpenApiSchema {
  core: JsonSchema,
  openapi_schema_oas_members: Map<OpenApiSchemaOasMemberKey, JsonValue>,
  openapi_schema_specification_extensions: Map<OpenApiSpecificationExtensionKey, JsonValue>,
  openapi_schema_deferred_keyword_members: Map<String, JsonValue>,
}

type OpenApiAdmittedHttpMethod
  = OpenApiGet
  | OpenApiPut
  | OpenApiPost
  | OpenApiDelete
  | OpenApiOptions
  | OpenApiHead
  | OpenApiPatch
  | OpenApiTrace

fn openapi_admitted_to_http_method(method: OpenApiAdmittedHttpMethod) -> HttpMethod {
  match method {
    OpenApiGet     => GET
    OpenApiPut     => PUT
    OpenApiPost    => POST
    OpenApiDelete  => DELETE
    OpenApiOptions => OPTIONS
    OpenApiHead    => HEAD
    OpenApiPatch   => PATCH
    OpenApiTrace   => TRACE
  }
}

type OpenApiReferenceObject {
  dollar_ref: String,
  summary: Optional<String>,
  description: Optional<String>,
}

type OpenApiLinkTarget
  = OpenApiLinkTargetOperationId { operation_id: String }
  | OpenApiLinkTargetOperationRef { operation_ref: String }

type OpenApiLinkObject {
  target: OpenApiLinkTarget,
  description: Optional<String>,
  link_deferred_members: Map<OpenApiLinkDeferredKey, JsonValue>,
  link_specification_extensions: Map<OpenApiSpecificationExtensionKey, JsonValue>,
}

type OpenApiLinkOrReference
  = OpenApiLinkInline { link: OpenApiLinkObject }
  | OpenApiLinkReference { reference: OpenApiReferenceObject }

type OpenApiContact {
  name: Optional<String>,
  url: Optional<String>,
  email: Optional<String>,
  contact_extensions: Map<OpenApiSpecificationExtensionKey, JsonValue>,
}

type OpenApiLicenseUrlOrIdentifierSlot
  = OpenApiLicenseUrlPresent { url: UriReference }
  | OpenApiLicenseIdentifierPresent { identifier: String }
  | OpenApiLicenseUrlOrIdentifierNeither

type OpenApiLicense {
  name: String,
  url_or_identifier: OpenApiLicenseUrlOrIdentifierSlot,
  license_extensions: Map<OpenApiSpecificationExtensionKey, JsonValue>,
}

type OpenApiInfo {
  title: String,
  summary: Optional<String>,
  description: Optional<String>,
  terms_of_service: Optional<String>,
  contact: Optional<OpenApiContact>,
  license: Optional<OpenApiLicense>,
  version: String,
  info_specification_extensions: Map<OpenApiSpecificationExtensionKey, JsonValue>,
}

type OpenApiMediaType {
  schema_shape: Optional<OpenApiSchema>,
  media_type_deferred_members: Map<OpenApiMediaTypeDeferredKey, JsonValue>,
  media_type_specification_extensions: Map<OpenApiSpecificationExtensionKey, JsonValue>,
}

type OpenApiHeaderContentSingle {
  media_type: String,
  media: OpenApiMediaType,
}

type OpenApiHeaderPayloadSlot
  = OpenApiHeaderPayloadSchema { schema: OpenApiSchema }
  | OpenApiHeaderPayloadContent { content: OpenApiHeaderContentSingle }

type OpenApiHeaderObject {
  description: Optional<String>,
  required: Optional<Bool>,
  deprecated: Optional<Bool>,
  payload: OpenApiHeaderPayloadSlot,
  header_deferred_members: Map<OpenApiHeaderDeferredKey, JsonValue>,
  header_specification_extensions: Map<OpenApiSpecificationExtensionKey, JsonValue>,
}

type OpenApiHeaderOrReference
  = OpenApiHeaderInline { header: OpenApiHeaderObject }
  | OpenApiHeaderReference { reference: OpenApiReferenceObject }

type OpenApiResponse {
  description: String,
  content: Optional<Map<String, OpenApiMediaType>>,
  headers: Optional<Map<String, OpenApiHeaderOrReference>>,
  links: Optional<Map<String, OpenApiLinkOrReference>>,
  extensions: Map<OpenApiSpecificationExtensionKey, JsonValue>,
}

type OpenApiResponseOrReference
  = OpenApiResponseInline { response: OpenApiResponse }
  | OpenApiResponseReference { reference: OpenApiReferenceObject }

type OpenApiStatusDigit
  = OpenApiDigit0
  | OpenApiDigit1
  | OpenApiDigit2
  | OpenApiDigit3
  | OpenApiDigit4
  | OpenApiDigit5
  | OpenApiDigit6
  | OpenApiDigit7
  | OpenApiDigit8
  | OpenApiDigit9

type OpenApiStatusHundreds
  = OpenApiHundreds1
  | OpenApiHundreds2
  | OpenApiHundreds3
  | OpenApiHundreds4
  | OpenApiHundreds5

type OpenApiResponseKeyWildcardKind
  = OpenApiWildcard1xx
  | OpenApiWildcard2xx
  | OpenApiWildcard3xx
  | OpenApiWildcard4xx
  | OpenApiWildcard5xx

type OpenApiResponseKeyNonDefault
  = OpenApiResponseKeyExplicitHttpStatus { hundreds: OpenApiStatusHundreds, tens: OpenApiStatusDigit, ones: OpenApiStatusDigit }
  | OpenApiResponseKeyWildcard { kind: OpenApiResponseKeyWildcardKind }

type OpenApiResponseKey
  = OpenApiResponseKeyDefault
  | OpenApiResponseKeyOther { key: OpenApiResponseKeyNonDefault }

type OpenApiResponsesPrimaryEntry {
  status_key: OpenApiResponseKeyNonDefault,
  response: OpenApiResponseOrReference,
}

type OpenApiResponses {
  primary_response: OpenApiResponsesPrimaryEntry,
  default_response: Optional<OpenApiResponseOrReference>,
  additional_by_status: Map<OpenApiResponseKeyNonDefault, OpenApiResponseOrReference>,
  responses_object_extensions: Map<OpenApiSpecificationExtensionKey, JsonValue>,
}

type OpenApiOperation {
  operation_id: Optional<String>,
  responses: OpenApiResponses,
  operation_deferred_members: Map<OpenApiOperationDeferredKey, JsonValue>,
  operation_specification_extensions: Map<OpenApiSpecificationExtensionKey, JsonValue>,
}

type OpenApiPathItem {
  routes: Map<OpenApiAdmittedHttpMethod, OpenApiOperation>,
  path_deferred_members: Map<OpenApiPathItemDeferredKey, JsonValue>,
  path_specification_extensions: Map<OpenApiSpecificationExtensionKey, JsonValue>,
}

type OpenApiPathItemOrReference
  = OpenApiPathItemInline { path_item: OpenApiPathItem }
  | OpenApiPathItemReference { reference: OpenApiReferenceObject }

type OpenApiPathTemplateKey {
  after_slash: String,
}

type OpenApiPaths {
  routes: Map<OpenApiPathTemplateKey, OpenApiPathItem>,
  paths_extensions: Map<OpenApiSpecificationExtensionKey, JsonValue>,
}

type OpenApiComponents {
  schemas: Optional<Map<OpenApiComponentsMapKey, OpenApiSchema>>,
  path_items: Optional<Map<OpenApiComponentsMapKey, OpenApiPathItemOrReference>>,
  components_deferred_members: Map<OpenApiComponentsDeferredKey, JsonValue>,
  components_specification_extensions: Map<OpenApiSpecificationExtensionKey, JsonValue>,
}

type OpenApiWebhooks {
  routes: Map<String, OpenApiPathItemOrReference>,
  webhooks_extensions: Map<OpenApiSpecificationExtensionKey, JsonValue>,
}

type OpenApiDocumentRoot
  = OpenApiDocumentRootPathsPresent {
      paths: OpenApiPaths,
      components: Optional<OpenApiComponents>,
      webhooks: Optional<OpenApiWebhooks>,
    }
  | OpenApiDocumentRootComponentsWithoutPaths {
      components: OpenApiComponents,
      webhooks: Optional<OpenApiWebhooks>,
    }
  | OpenApiDocumentRootWebhooksOnly {
      webhooks: OpenApiWebhooks,
    }

type OpenApiOpenapiField3_1
  = OpenApiOpenapi31Patch { patch: v2.std.nat.Nat }

type OpenApiConcreteSyntaxAuthority
  = OpenApiJsonSyntax { json_document: JsonDocument }
  | OpenApiYamlSyntax { yaml_document: YamlDocument }

type OpenApiDocument {
  concrete_syntax: OpenApiConcreteSyntaxAuthority,
  openapi: OpenApiOpenapiField3_1,
  json_schema_dialect: Optional<String>,
  info: OpenApiInfo,
  root: OpenApiDocumentRoot,
  root_deferred_members: Map<OpenApiOpenapiObjectDeferredKey, JsonValue>,
  root_specification_extensions: Map<OpenApiSpecificationExtensionKey, JsonValue>,
}

type OpenApiOpenapi31MajorMinorFixedWitness {}

type OpenApiOpenapi31PatchNatCarrierWitness {}

type OpenApiNumericLexemeFacts {
  openapi_field_major_minor_fixed_3_1: OpenApiOpenapi31MajorMinorFixedWitness,
  openapi_field_patch_nat_carrier: OpenApiOpenapi31PatchNatCarrierWitness,
}

type OpenApiPathsRouteKeysUniqueWitness {}

type OpenApiPathItemHttpMethodsUniqueWitness {}

type OpenApiComponentsMapKeysUniqueWitness {}

type OpenApiResponsesStatusKeysUniqueWitness {}

type OpenApiWebhooksRouteKeysUniqueWitness {}

type OpenApiResponseContentMediaTypeKeysUniqueWitness {}

type OpenApiResponseHeadersKeysUniqueWitness {}

type OpenApiResponseLinksKeysUniqueWitness {}

type OpenApiUniqueNameProfileFacts {
  paths_route_keys_unique: OpenApiPathsRouteKeysUniqueWitness,
  path_item_http_methods_unique: OpenApiPathItemHttpMethodsUniqueWitness,
  components_map_keys_unique: OpenApiComponentsMapKeysUniqueWitness,
  responses_status_keys_unique: OpenApiResponsesStatusKeysUniqueWitness,
  webhooks_route_keys_unique: OpenApiWebhooksRouteKeysUniqueWitness,
  response_content_media_type_keys_unique: OpenApiResponseContentMediaTypeKeysUniqueWitness,
  response_headers_keys_unique: OpenApiResponseHeadersKeysUniqueWitness,
  response_links_keys_unique: OpenApiResponseLinksKeysUniqueWitness,
}

type OpenApiHttpStatusCodeBoundedRangeWitness {}

type OpenApiHttpStatusCodeFacts {
  hundreds: OpenApiStatusHundreds,
  tens: OpenApiStatusDigit,
  ones: OpenApiStatusDigit,
  bounded_100_to_599: OpenApiHttpStatusCodeBoundedRangeWitness,
}

fn openapi_status_digit_value(digit: OpenApiStatusDigit) -> v2.std.nat.Nat {
  match digit {
    OpenApiDigit0 => 0
    OpenApiDigit1 => 1
    OpenApiDigit2 => 2
    OpenApiDigit3 => 3
    OpenApiDigit4 => 4
    OpenApiDigit5 => 5
    OpenApiDigit6 => 6
    OpenApiDigit7 => 7
    OpenApiDigit8 => 8
    OpenApiDigit9 => 9
  }
}

fn openapi_status_hundreds_value(hundreds: OpenApiStatusHundreds) -> v2.std.nat.Nat {
  match hundreds {
    OpenApiHundreds1 => 100
    OpenApiHundreds2 => 200
    OpenApiHundreds3 => 300
    OpenApiHundreds4 => 400
    OpenApiHundreds5 => 500
  }
}

type OpenApiResponseKeyWildcardBridgeRow {
  kind: OpenApiResponseKeyWildcardKind,
  low: v2.std.nat.Nat,
  high: v2.std.nat.Nat,
}

data openapi_wildcard_bridge_1xx: OpenApiResponseKeyWildcardBridgeRow = {
  kind: OpenApiWildcard1xx,
  low: openapi_status_hundreds_value(hundreds: OpenApiHundreds1),
  high: openapi_status_hundreds_value(hundreds: OpenApiHundreds1) + 99,
}

data openapi_wildcard_bridge_2xx: OpenApiResponseKeyWildcardBridgeRow = {
  kind: OpenApiWildcard2xx,
  low: openapi_status_hundreds_value(hundreds: OpenApiHundreds2),
  high: openapi_status_hundreds_value(hundreds: OpenApiHundreds2) + 99,
}

data openapi_wildcard_bridge_3xx: OpenApiResponseKeyWildcardBridgeRow = {
  kind: OpenApiWildcard3xx,
  low: openapi_status_hundreds_value(hundreds: OpenApiHundreds3),
  high: openapi_status_hundreds_value(hundreds: OpenApiHundreds3) + 99,
}

data openapi_wildcard_bridge_4xx: OpenApiResponseKeyWildcardBridgeRow = {
  kind: OpenApiWildcard4xx,
  low: openapi_status_hundreds_value(hundreds: OpenApiHundreds4),
  high: openapi_status_hundreds_value(hundreds: OpenApiHundreds4) + 99,
}

data openapi_wildcard_bridge_5xx: OpenApiResponseKeyWildcardBridgeRow = {
  kind: OpenApiWildcard5xx,
  low: openapi_status_hundreds_value(hundreds: OpenApiHundreds5),
  high: openapi_status_hundreds_value(hundreds: OpenApiHundreds5) + 99,
}

data openapi_response_key_wildcard_bridge_catalog: List<OpenApiResponseKeyWildcardBridgeRow> = [
  openapi_wildcard_bridge_1xx,
  openapi_wildcard_bridge_2xx,
  openapi_wildcard_bridge_3xx,
  openapi_wildcard_bridge_4xx,
  openapi_wildcard_bridge_5xx,
]

fn openapi_http_status_code_value(
  hundreds: OpenApiStatusHundreds,
  tens: OpenApiStatusDigit,
  ones: OpenApiStatusDigit
) -> v2.std.nat.Nat {
  openapi_status_hundreds_value(hundreds: hundreds) + (openapi_status_digit_value(digit: tens) * 10) + openapi_status_digit_value(digit: ones)
}

data openapi_operation_exchange_request_reply: ExchangePattern = RequestReply

type OpenApiOperationWireContractFacts {
  admitted_method: OpenApiAdmittedHttpMethod,
  path_template: OpenApiPathTemplateKey,
}

type OpenApiDocumentWireContractFacts {
  openapi_version: OpenApiOpenapiField3_1,
  paths: Optional<OpenApiPaths>,
  unique_names: OpenApiUniqueNameProfileFacts,
}
