module v2.extdeps.formats.spice_passive_projection


fn passive_terminal_from_node_ref(node: v2.extdeps.formats.spice.NodeRef) -> v2.std.timeseries_signal.PotentialReference {
  match node {
    v2.extdeps.formats.spice.Ground => v2.std.timeseries_signal.GroundReference
    v2.extdeps.formats.spice.Named { node: v2.extdeps.formats.spice.NamedNode { name } } => v2.std.timeseries_signal.NodeReference { name: name as String as v2.std.timeseries_signal.CircuitNodeName }
  }
}

fn passive_value_from_spice(value: v2.extdeps.formats.spice.SpiceValue) -> v2.std.timeseries_signal.PassiveElementValue {
  v2.std.timeseries_signal.PassiveElementValue { lexeme: value.lexeme }
}

fn passive_topology_from_component(component: v2.extdeps.formats.spice.Component) -> v2.std.optional.Optional<v2.std.timeseries_signal.PassiveElementTopology> {
  match component {
    v2.extdeps.formats.spice.Resistor { name, n_plus, n_minus, value } => v2.std.optional.Present {
      value: v2.std.timeseries_signal.PassiveElementTopology {
        name: name as String as v2.std.timeseries_signal.CircuitNodeName,
        n_plus: passive_terminal_from_node_ref(node: n_plus),
        n_minus: passive_terminal_from_node_ref(node: n_minus),
        value: passive_value_from_spice(value: value)
      }
    }
    v2.extdeps.formats.spice.Capacitor { name, n_plus, n_minus, value } => v2.std.optional.Present {
      value: v2.std.timeseries_signal.PassiveElementTopology {
        name: name as String as v2.std.timeseries_signal.CircuitNodeName,
        n_plus: passive_terminal_from_node_ref(node: n_plus),
        n_minus: passive_terminal_from_node_ref(node: n_minus),
        value: passive_value_from_spice(value: value)
      }
    }
    v2.extdeps.formats.spice.Inductor { name, n_plus, n_minus, value } => v2.std.optional.Present {
      value: v2.std.timeseries_signal.PassiveElementTopology {
        name: name as String as v2.std.timeseries_signal.CircuitNodeName,
        n_plus: passive_terminal_from_node_ref(node: n_plus),
        n_minus: passive_terminal_from_node_ref(node: n_minus),
        value: passive_value_from_spice(value: value)
      }
    }
    _ => v2.std.optional.Absent
  }
}

fn passive_spec_from_component(component: v2.extdeps.formats.spice.Component) -> v2.std.optional.Optional<v2.std.timeseries_signal.PassiveComponentSpec> {
  match passive_topology_from_component(component: component) {
    v2.std.optional.Present { value: topology } => match component {
      v2.extdeps.formats.spice.Resistor { name: _, n_plus: _, n_minus: _, value: _ } => v2.std.optional.Present {
        value: v2.std.timeseries_signal.ResistorPassive { topology: topology }
      }
      v2.extdeps.formats.spice.Capacitor { name: _, n_plus: _, n_minus: _, value: _ } => v2.std.optional.Present {
        value: v2.std.timeseries_signal.CapacitorPassive { topology: topology }
      }
      v2.extdeps.formats.spice.Inductor { name: _, n_plus: _, n_minus: _, value: _ } => v2.std.optional.Present {
        value: v2.std.timeseries_signal.InductorPassive { topology: topology }
      }
      _ => v2.std.optional.Absent
    }
    v2.std.optional.Absent => v2.std.optional.Absent
  }
}
