module v2.extdeps.formats.spice_passive_projection

import std.optional {
  Optional,
  Absent,
  Present
}
import v2.std.timeseries_signal {
  CapacitorPassive,
  GroundReference,
  InductorPassive,
  NodeReference,
  PassiveComponentSpec,
  PassiveElementTopology,
  CircuitNodeName,
  PassiveElementValue,
  PotentialReference,
  ResistorPassive,
}
import v2.std.text { String }
import v2.extdeps.formats.spice {
  Capacitor,
  Component,
  Ground,
  Inductor,
  Named,
  NamedNode,
  NodeRef,
  Resistor,
  SpiceValue,
}

fn passive_terminal_from_node_ref(node: NodeRef) -> PotentialReference {
  match node {
    Ground => GroundReference
    Named { node: NamedNode { name } } => NodeReference { name: name as String as CircuitNodeName }
  }
}

fn passive_value_from_spice(value: SpiceValue) -> PassiveElementValue {
  PassiveElementValue { lexeme: value.lexeme }
}

fn passive_topology_from_component(component: Component) -> Optional<PassiveElementTopology> {
  match component {
    Resistor { name, n_plus, n_minus, value } => Present {
      value: PassiveElementTopology {
        name: name as String as CircuitNodeName,
        n_plus: passive_terminal_from_node_ref(node: n_plus),
        n_minus: passive_terminal_from_node_ref(node: n_minus),
        value: passive_value_from_spice(value: value)
      }
    }
    Capacitor { name, n_plus, n_minus, value } => Present {
      value: PassiveElementTopology {
        name: name as String as CircuitNodeName,
        n_plus: passive_terminal_from_node_ref(node: n_plus),
        n_minus: passive_terminal_from_node_ref(node: n_minus),
        value: passive_value_from_spice(value: value)
      }
    }
    Inductor { name, n_plus, n_minus, value } => Present {
      value: PassiveElementTopology {
        name: name as String as CircuitNodeName,
        n_plus: passive_terminal_from_node_ref(node: n_plus),
        n_minus: passive_terminal_from_node_ref(node: n_minus),
        value: passive_value_from_spice(value: value)
      }
    }
    VoltageSource { name: _, n_plus: _, n_minus: _, value: _ } => Absent
    CurrentSource { name: _, n_plus: _, n_minus: _, value: _ } => Absent
    Diode { name: _, anode: _, cathode: _, model: _ } => Absent
    Bjt {
      name: _,
      collector: _,
      base: _,
      emitter: _,
      substrate: _,
      model: _,
      modifiers: _,
    } => Absent
    Mosfet {
      name: _,
      drain: _,
      gate: _,
      source: _,
      body: _,
      model: _,
      modifiers: _,
    } => Absent
    MutualInductance { name: _, l1: _, l2: _, coupling: _ } => Absent
    SubcircuitCall {
      name: _,
      connections: _,
      subcircuit: _,
      parameters: _,
    } => Absent
  }
}

fn passive_spec_from_component(component: Component) -> Optional<PassiveComponentSpec> {
  match passive_topology_from_component(component: component) {
    Present { value: topology } => match component {
      Resistor { name: _, n_plus: _, n_minus: _, value: _ } => Present {
        value: ResistorPassive { topology: topology }
      }
      Capacitor { name: _, n_plus: _, n_minus: _, value: _ } => Present {
        value: CapacitorPassive { topology: topology }
      }
      Inductor { name: _, n_plus: _, n_minus: _, value: _ } => Present {
        value: InductorPassive { topology: topology }
      }
      VoltageSource { name: _, n_plus: _, n_minus: _, value: _ } => Absent
      CurrentSource { name: _, n_plus: _, n_minus: _, value: _ } => Absent
      Diode { name: _, anode: _, cathode: _, model: _ } => Absent
      Bjt {
        name: _,
        collector: _,
        base: _,
        emitter: _,
        substrate: _,
        model: _,
        modifiers: _,
      } => Absent
      Mosfet {
        name: _,
        drain: _,
        gate: _,
        source: _,
        body: _,
        model: _,
        modifiers: _,
      } => Absent
      MutualInductance { name: _, l1: _, l2: _, coupling: _ } => Absent
      SubcircuitCall {
        name: _,
        connections: _,
        subcircuit: _,
        parameters: _,
      } => Absent
    }
    Absent => Absent
  }
}
