// src/v2/extdeps/formats/yaml.dag
// Scope: YAML 1.2.2 structural value model — declarative only; parse/emit deferred.
// Status: parse/emit axes (gated on lex/parse/emit pipeline substrate), numeric-lexeme profile (§10.3.2 core schema),
//         canonical-key profile (§3.2.1.3 tag+canonical-content), anchor/alias resolution (§6.1/§7.1).
// Anchor: https://yaml.org/spec/1.2.2/

module v2.extdeps.formats.yaml

import v2.std.grammar { GrammarSchema }


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type YamlValue
  = YamlNull
  | YamlBool { value: Bool }
  | YamlInt { lexeme: String }
  | YamlFloat { lexeme: String }
  | YamlString { value: String }
  | YamlSequence { elements: List<YamlValue> }
  | YamlMapping { entries: Map<YamlValue, YamlValue> }


type YamlIntBase10DecimalOptionalSignWitness {}

type YamlIntBase8Octal0oPrefixNoSignWitness {}

type YamlIntBase16Hex0xPrefixNoSignWitness {}

type YamlIntLexemeFacts {
  base10_decimal_optional_sign: YamlIntBase10DecimalOptionalSignWitness,
  base8_octal_0o_prefix_no_sign: YamlIntBase8Octal0oPrefixNoSignWitness,
  base16_hex_0x_prefix_no_sign: YamlIntBase16Hex0xPrefixNoSignWitness,
}

type YamlFloatDecimalOrExponentOptionalSignWitness {}

type YamlFloatPositiveInfLexemeWitness {}

type YamlFloatNegativeInfLexemeWitness {}

type YamlFloatNanLexemeNoSignWitness {}

type YamlFloatLexemeFacts {
  decimal_or_exponent_optional_sign: YamlFloatDecimalOrExponentOptionalSignWitness,
  positive_inf_lexeme: YamlFloatPositiveInfLexemeWitness,
  negative_inf_lexeme: YamlFloatNegativeInfLexemeWitness,
  nan_lexeme_no_sign: YamlFloatNanLexemeNoSignWitness,
}

type YamlMappingKeyEqualityByTagAndCanonicalContentWitness {}

type YamlSameTagCanonicallyEqualDuplicateKeysRejectedWitness {}

type YamlDuplicateMappingKeyRejectedFailClosedWitness {}

type YamlCanonicalKeyProfileFacts {
  key_equality_by_tag_and_canonical_content: YamlMappingKeyEqualityByTagAndCanonicalContentWitness,
  same_tag_canonically_equal_duplicates_rejected: YamlSameTagCanonicallyEqualDuplicateKeysRejectedWitness,
  duplicate_mapping_key_rejected_fail_closed: YamlDuplicateMappingKeyRejectedFailClosedWitness,
}

type YamlAnchorNodeMarkedWithAmpersandWitness {}

type YamlAliasNodeMarkedWithAsteriskWitness {}

type YamlAliasResolvesToMostRecentSameAnchorWitness {}

type YamlUnresolvableAliasFailClosedWitness {}

type YamlRepresentationGraphAliasCyclePermittedWitness {}

type YamlAliasFreeProjectionAliasCycleRejectedWitness {}

type YamlAliasFreeProjectionByConstructionWitness {}

type YamlAnchorAliasResolutionFacts {
  anchor_node_marked_with_ampersand: YamlAnchorNodeMarkedWithAmpersandWitness,
  alias_node_marked_with_asterisk: YamlAliasNodeMarkedWithAsteriskWitness,
  alias_resolves_to_most_recent_same_anchor: YamlAliasResolvesToMostRecentSameAnchorWitness,
  unresolvable_alias_fail_closed: YamlUnresolvableAliasFailClosedWitness,
  representation_graph_alias_cycle_permitted: YamlRepresentationGraphAliasCyclePermittedWitness,
  alias_free_projection_alias_cycle_rejected: YamlAliasFreeProjectionAliasCycleRejectedWitness,
  alias_free_projection_by_construction: YamlAliasFreeProjectionByConstructionWitness,
}


type YamlDocument {
  grammar_schema: GrammarSchema,
  canonical_keys: YamlCanonicalKeyProfileFacts,
  anchor_alias_resolution: YamlAnchorAliasResolutionFacts,
  value: YamlValue,
}


