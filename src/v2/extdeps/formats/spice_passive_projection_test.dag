module v2.test.extdeps.formats.spice_passive_projection

import v2.std.collection { Absent, Present }
import v2.std.logic { Bool }
import v2.extdeps.formats.spice {
  Capacitor,
  Ground,
  Inductor,
  Named,
  NamedNode,
  Resistor,
  SpiceValue
}
import v2.extdeps.formats.spice_passive_projection {
  passive_spec_from_component,
  passive_topology_from_component,
}
import v2.std.timeseries_signal {
  CapacitorPassive,
  InductorPassive,
  ResistorPassive,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn spice_resistor_projects_resistor_passive_topology_holds() -> Bool {
  let component = Resistor {
    name: ^r1,
    n_plus: Named { node: NamedNode { name: ^n1 } },
    n_minus: Ground,
    value: SpiceValue { lexeme: "1000" }
  }
  match passive_spec_from_component(component: component) {
    Present { value: ResistorPassive { topology: topo } } => topo.name == ^r1
    _ => false
  }
}

test fn spice_capacitor_projects_capacitor_passive_arm_holds() -> Bool {
  let component = Capacitor {
    name: ^c1,
    n_plus: Named { node: NamedNode { name: ^n2 } },
    n_minus: Ground,
    value: SpiceValue { lexeme: "1e-6" }
  }
  match passive_spec_from_component(component: component) {
    Present { value: CapacitorPassive { topology: _ } } => true
    _ => false
  }
}

test fn spice_inductor_projects_inductor_passive_arm_holds() -> Bool {
  let component = Inductor {
    name: ^l1,
    n_plus: Named { node: NamedNode { name: ^n3 } },
    n_minus: Ground,
    value: SpiceValue { lexeme: "1e-3" }
  }
  match passive_spec_from_component(component: component) {
    Present { value: InductorPassive { topology: _ } } => true
    _ => false
  }
}

test fn passive_topology_preserves_component_name_holds() -> Bool {
  let component = Resistor {
    name: ^r9,
    n_plus: Named { node: NamedNode { name: ^n9 } },
    n_minus: Ground,
    value: SpiceValue { lexeme: "47" }
  }
  match passive_topology_from_component(component: component) {
    Present { value: topo } => topo.name == ^r9
    Absent => false
  }
}
