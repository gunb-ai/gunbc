module v2.extdeps.formats.csv


type CsvRfc4180DelimiterProfile {
  comma_field_separator: CsvRfc4180CommaFieldSep,
}

type CsvRfc4180QuoteProfile {
  double_quote_enclosure: CsvRfc4180DoubleQuoteEnclosure,
  doubled_quote_escape: CsvRfc4180EscapeDoubledQuote,
}

type CsvRfc4180LineTerminatorProfile {
  record_line_break: CsvRfc4180RecordLineBreak,
  last_record_ending_line_break_optional: CsvRfc4180LastRecordEndingLineBreakOptional,
}

type CsvRfc4180FieldTextProfile {
  newline_inside_quoted_field_only: CsvRfc4180NewlineInsideQuotedFieldOnly,
  unquoted_field_textdata_vs_tab: CsvRfc4180UnquotedFieldTextdataVsTab,
  empty_field_between_commas: CsvRfc4180EmptyFieldBetweenCommas,
}

type CsvAxisProfile {
  delimiter: CsvRfc4180DelimiterProfile,
  quote: CsvRfc4180QuoteProfile,
  line_terminator: CsvRfc4180LineTerminatorProfile,
  field_text: CsvRfc4180FieldTextProfile,
  header_row: CsvRfc4180HeaderRowOptional,
  registered_mime: CsvRfc4180RegisteredTextCsvMime,
}

type CsvNumericLexemeProfile {
  numeric_interpretation_is_consumer_defined: CsvNumericInterpretationConsumerDefinedWitness,
  field_payload_remains_text_lexeme: CsvFieldPayloadRemainsTextLexemeWitness,
}

type CsvUniqueNameProfile {
  header_names_are_not_required_unique_by_rfc4180: CsvHeaderNamesNotRequiredUniqueByRfc4180Witness,
  duplicate_header_name_policy_is_consumer_defined: CsvDuplicateHeaderNamePolicyConsumerDefinedWitness,
}

type CsvRecordShapeProfile {
  records_same_field_count_rfc4180_should: CsvRfc4180RecordsShouldHaveSameFieldCountWitness,
  rectangular_record_enforcement_is_consumer_defined: CsvRectangularRecordEnforcementConsumerDefinedWitness,
  header_same_field_count_as_records_rfc4180_should: CsvRfc4180HeaderShouldMatchRecordFieldCountWitness,
  header_width_enforcement_is_consumer_defined: CsvHeaderWidthEnforcementConsumerDefinedWitness,
}

type CsvDialect {
  parse_axis: CsvAxisProfile,
  emit_axis: CsvAxisProfile,
}

type CsvRow
  = CsvRowZ
  | CsvRowS { field: String, tail: CsvRow }

type CsvRfc4180FieldsSeparatedByCommaU002cWitness {}

type CsvRfc4180HorizontalTabRejectedAsFieldSeparatorWitness {}

type CsvRfc4180CommaFieldSep {
  fields_separated_by_comma_u002c: CsvRfc4180FieldsSeparatedByCommaU002cWitness,
  horizontal_tab_is_rejected_separator_for_this_slice: CsvRfc4180HorizontalTabRejectedAsFieldSeparatorWitness,
}

type CsvRfc4180DquoteMayEncloseEntireFieldWitness {}

type CsvRfc4180EnclosedFieldMayContainCommaCrlfOrLfWitness {}

type CsvRfc4180DoubleQuoteEnclosure {
  dquote_u0022_may_enclose_entire_field: CsvRfc4180DquoteMayEncloseEntireFieldWitness,
  enclosed_field_may_contain_comma_crlf_or_lf: CsvRfc4180EnclosedFieldMayContainCommaCrlfOrLfWitness,
}

type CsvRfc4180EscapeDoubledQuote {}

type CsvRfc4180RecordsSeparatedByAsciiCrlfPerRfc4180Witness {}

type CsvRfc4180GeneratorEmitsCrlfBetweenRecordsWitness {}

type CsvRfc4180RecordLineBreak {
  records_separated_by_ascii_crlf_u000d_u000a_per_rfc4180: CsvRfc4180RecordsSeparatedByAsciiCrlfPerRfc4180Witness,
  generator_should_emit_crlf_between_records_per_rfc4180: CsvRfc4180GeneratorEmitsCrlfBetweenRecordsWitness,
}

type CsvRfc4180RecordsShouldHaveSameFieldCountWitness {}

type CsvRectangularRecordEnforcementConsumerDefinedWitness {}

type CsvRfc4180HeaderShouldMatchRecordFieldCountWitness {}

type CsvHeaderWidthEnforcementConsumerDefinedWitness {}

type CsvRfc4180LastRecordEndingLineBreakOptional {}

type CsvRfc4180HeaderRowOptional {}

type CsvRfc4180NewlineInsideQuotedFieldOnly {}

type CsvRfc4180SpU0020TextdataOutsideUnquotedFieldWitness {}

type CsvRfc4180TabRejectedOutsideUnquotedFieldWitness {}

type CsvRfc4180UnquotedFieldTextdataVsTab {
  ascii_sp_u0020_outside_unquoted_field_is_textdata_field_char: CsvRfc4180SpU0020TextdataOutsideUnquotedFieldWitness,
  horizontal_tab_u0009_outside_unquoted_field_is_rejected_not_textdata: CsvRfc4180TabRejectedOutsideUnquotedFieldWitness,
}

type CsvRfc4180EmptyFieldBetweenCommas {}

type CsvRfc4180RegisteredTextCsvMime {}

type CsvNumericInterpretationConsumerDefinedWitness {}

type CsvFieldPayloadRemainsTextLexemeWitness {}

type CsvHeaderNamesNotRequiredUniqueByRfc4180Witness {}

type CsvDuplicateHeaderNamePolicyConsumerDefinedWitness {}

type CsvDocument {
  grammar_schema: GrammarSchema,
  dialect: CsvDialect,
  numeric_lexeme_profile: CsvNumericLexemeProfile,
  unique_name_profile: CsvUniqueNameProfile,
  record_shape_profile: CsvRecordShapeProfile,
  header: Optional<CsvRow>,
  records: List<CsvRow>,
}
