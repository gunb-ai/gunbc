// src/v2/extdeps/formats/sql.dag
// Scope: ISO/IEC 9075 SQL relational/DDL surface; Shape-B checked format — T-4.6 dsl extdeps port (migration.dag) + ISO spec.
// Status: DDL/relational facts + numeric lexeme (wave-1 bundles) landed; parse/emit axes + identifier/unique-name profile gated (SL-3229-T4-FORMAT-T6T7, SL-3229-SQL-IDENTIFIER-UNIQUENESS). Transport execution config (`SqlStatementKind`, `SqlParameterStyle`, `SqlTransactionMode`, `SqlTransportConfig`) remains sole authority in `dsl/extdeps/transports/sql.dag` until the v2 port retires the v3 split (#3224 single-authority ruling).
// Anchor: https://www.iso.org/standard/76583.html

module v2.extdeps.formats.sql


import v2.std.grammar { GrammarSchema }
import v2.std.algebra { fold_list, list_append }
import v2.std.collection { List, Map, Optional }
import v2.std.nat { Nat }
import v2.std.cardinality { NonZeroNat }
import v2.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.model_core {
  PrimitiveFactBundle,
  ModelCoreFactAxisEncoding,
  ModelCoreFactAxisSignedness,
  ModelCoreFactAxisSurfaceSpelling,
  primitive_fact_axis_unbound_diagnostic
}
import v2.std.witness { Holds, Violates }


// 🟡 coproduct dissolution — T-4.6-P4-SqlDialect.
type SqlDialect
  = SqlDialectIso9075
  | SqlDialectPostgreSql
  | SqlDialectSqlite
  | SqlDialectMySql


// 🟡 coproduct dissolution — T-4.6-P4-SqlIdentifier.
type SqlIdentifier
  = SqlRegularIdentifier { name: String }
  | SqlDelimitedIdentifier { name: String }


// 🟡 coproduct dissolution — T-4.6-P4-SqlDataType.
type SqlDataType
  = SqlTypeBoolean
  | SqlTypeSmallInt
  | SqlTypeInteger
  | SqlTypeBigInt
  | SqlTypeReal
  | SqlTypeDoublePrecision
  | SqlTypeNumeric { precision: NonZeroNat, scale: Nat }
  | SqlTypeCharacter { length: NonZeroNat }
  | SqlTypeCharacterVarying { length: NonZeroNat }
  | SqlTypeCharacterLargeObject
  | SqlTypeDate
  | SqlTypeTime
  | SqlTypeTimestamp
  | SqlTypeTimestampWithTimeZone


type SqlColumnConstraints {
  not_null: Bool,
}


// 🟡 coproduct dissolution — T-4.6-P4-SqlColumnDefault.
type SqlColumnDefault
  = SqlColumnDefaultAbsent
  | SqlColumnDefaultLiteral { literal: String }


type SqlColumnDefinition {
  name: SqlIdentifier,
  data_type: SqlDataType,
  constraints: SqlColumnConstraints,
  column_default: SqlColumnDefault,
}


// 🟡 coproduct dissolution — T-4.6-P4-SqlTableConstraint.
type SqlTableConstraint
  = SqlTableUnique { columns: List<SqlIdentifier> }
  | SqlTableForeignKey {
      columns: List<SqlIdentifier>,
      referenced_table: SqlIdentifier,
      referenced_columns: List<SqlIdentifier>,
    }


type SqlTableDefinition {
  name: SqlIdentifier,
  columns: List<SqlColumnDefinition>,
  primary_key: Optional<List<SqlIdentifier>>,
  table_constraints: List<SqlTableConstraint>,
}


// 🟡 coproduct dissolution — T-4.6-P4-SqlSchemaOperation.
type SqlSchemaOperation
  = SqlCreateTable { table: SqlTableDefinition }
  | SqlDropTable { table_name: SqlIdentifier }
  | SqlAddColumn { table_name: SqlIdentifier, column: SqlColumnDefinition }
  | SqlDropColumn { table_name: SqlIdentifier, column_name: SqlIdentifier }
  | SqlAlterTableConstraint { table_name: SqlIdentifier, constraint: SqlTableConstraint }
  | SqlCreateIndex {
      index_name: SqlIdentifier,
      table_name: SqlIdentifier,
      columns: List<SqlIdentifier>,
    }
  | SqlDropIndex { index_name: SqlIdentifier }
  | SqlAlterTableRaw { table_name: SqlIdentifier, alteration: String }
  | SqlRawStep { statement: String }


type SqlMigrationStep {
  name: String,
  operation: SqlSchemaOperation,
  dialect: SqlDialect,
  reversible: Bool,
}


type SqlMigrationScript {
  migration_id: String,
  wraps_transaction: Bool,
  steps: List<SqlMigrationStep>,
}


type SqlMigrationEmissionTarget {
  grammar_schema: GrammarSchema,
  database_name: String,
  migrations: List<SqlMigrationScript>,
}


// ISO/IEC 9075 §6 specifies SMALLINT/INTEGER/BIGINT as signed exact numeric
// types with implementation-defined precision, and REAL/DOUBLE PRECISION as
// approximate numerics with implementation-defined precision and encoding.
// Width and IEEE-754 binding are therefore implementation facts, not spec
// facts, and are deliberately not carried on these records.

type SqlIntegerPrimitiveFacts {
  surface_spelling: Symbol
}


type SqlFloatPrimitiveFacts {
  surface_spelling: Symbol
}


type SqlNonNumericPrimitiveFacts {
  surface_spelling: Symbol
  representation: Symbol
}


// ISO/IEC 9075 surface spellings.
// Representation identities — ISO/IEC 9075 §4 semantics (boolean three-valued,
// datetime, character large object). Approximate-numeric and exact-numeric
// representations are NOT bound (implementation-defined per ISO §6).
// Signedness — ISO/IEC 9075 §6 specifies SMALLINT/INTEGER/BIGINT as signed.
data sql_facts_smallint: SqlIntegerPrimitiveFacts = SqlIntegerPrimitiveFacts {
  surface_spelling: ^sql_surface_spelling_smallint,
}

data sql_facts_integer: SqlIntegerPrimitiveFacts = SqlIntegerPrimitiveFacts {
  surface_spelling: ^sql_surface_spelling_integer,
}

data sql_facts_bigint: SqlIntegerPrimitiveFacts = SqlIntegerPrimitiveFacts {
  surface_spelling: ^sql_surface_spelling_bigint,
}

data sql_facts_real: SqlFloatPrimitiveFacts = SqlFloatPrimitiveFacts {
  surface_spelling: ^sql_surface_spelling_real,
}

data sql_facts_double_precision: SqlFloatPrimitiveFacts = SqlFloatPrimitiveFacts {
  surface_spelling: ^sql_surface_spelling_double_precision,
}

data sql_facts_boolean: SqlNonNumericPrimitiveFacts = SqlNonNumericPrimitiveFacts {
  surface_spelling: ^sql_surface_spelling_boolean,
  representation: ^sql_repr_boolean_three_valued,
}

data sql_facts_character_large_object: SqlNonNumericPrimitiveFacts = SqlNonNumericPrimitiveFacts {
  surface_spelling: ^sql_surface_spelling_character_large_object,
  representation: ^sql_repr_character_large_object,
}

data sql_facts_date: SqlNonNumericPrimitiveFacts = SqlNonNumericPrimitiveFacts {
  surface_spelling: ^sql_surface_spelling_date,
  representation: ^sql_repr_date_calendar,
}

data sql_facts_time: SqlNonNumericPrimitiveFacts = SqlNonNumericPrimitiveFacts {
  surface_spelling: ^sql_surface_spelling_time,
  representation: ^sql_repr_time_of_day,
}

data sql_facts_timestamp: SqlNonNumericPrimitiveFacts = SqlNonNumericPrimitiveFacts {
  surface_spelling: ^sql_surface_spelling_timestamp,
  representation: ^sql_repr_timestamp,
}

data sql_facts_timestamp_with_time_zone: SqlNonNumericPrimitiveFacts = SqlNonNumericPrimitiveFacts {
  surface_spelling: ^sql_surface_spelling_timestamp_with_time_zone,
  representation: ^sql_repr_timestamp_with_time_zone,
}


// 🟡 needs-more-work — feature:sql-primitive-bundle-catalog-derivation — scaffold:T-4.6-sql-primitive-fact-bundles · dissolve-on: substrate gains coproduct-variant enumeration so the constant-arm subset of SqlDataType derives a homomorphism into List<PrimitiveFactBundle> and the three hand-enumerated catalogs below collapse into that derivation (single-authority over the SqlDataType constant arms; same gap on src/v2/extdeps/languages/rust.dag's per-category facts catalogs).
data sql_integer_facts_catalog: List<SqlIntegerPrimitiveFacts> = [
  sql_facts_smallint,
  sql_facts_integer,
  sql_facts_bigint,
]

data sql_float_facts_catalog: List<SqlFloatPrimitiveFacts> = [
  sql_facts_real,
  sql_facts_double_precision,
]

data sql_nonnumeric_facts_catalog: List<SqlNonNumericPrimitiveFacts> = [
  sql_facts_boolean,
  sql_facts_character_large_object,
  sql_facts_date,
  sql_facts_time,
  sql_facts_timestamp,
  sql_facts_timestamp_with_time_zone,
]


fn sql_inhabitant_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn sql_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn sql_integer_facts_node(facts: SqlIntegerPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      sql_named_edge(
        name: discriminant(v: ModelCoreFactAxisSurfaceSpelling {}),
        target: sql_inhabitant_atom(id: facts.surface_spelling),
      ),
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn sql_float_facts_node(facts: SqlFloatPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      sql_named_edge(
        name: discriminant(v: ModelCoreFactAxisSurfaceSpelling {}),
        target: sql_inhabitant_atom(id: facts.surface_spelling),
      ),
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn sql_nonnumeric_facts_node(facts: SqlNonNumericPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      sql_named_edge(
        name: discriminant(v: ModelCoreFactAxisSurfaceSpelling {}),
        target: sql_inhabitant_atom(id: facts.surface_spelling),
      ),
      sql_named_edge(
        name: discriminant(v: ModelCoreFactAxisEncoding {}),
        target: sql_inhabitant_atom(id: facts.representation),
      ),
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn sql_integer_spec_facts(facts: SqlIntegerPrimitiveFacts) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      if axis == discriminant(v: ModelCoreFactAxisSurfaceSpelling {}) {
          Holds { value: sql_inhabitant_atom(id: facts.surface_spelling) }
      } else if axis == discriminant(v: ModelCoreFactAxisSignedness {}) {
          Holds { value: sql_inhabitant_atom(id: ^sql_tag_signed) }
      } else {
          Violates {
            diagnostic: primitive_fact_axis_unbound_diagnostic(axis: axis)
          }
      }
    }
  }
}

fn sql_float_spec_facts(facts: SqlFloatPrimitiveFacts) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      if axis == discriminant(v: ModelCoreFactAxisSurfaceSpelling {}) {
          Holds { value: sql_inhabitant_atom(id: facts.surface_spelling) }
      } else {
          Violates {
            diagnostic: primitive_fact_axis_unbound_diagnostic(axis: axis)
          }
      }
    }
  }
}

fn sql_nonnumeric_spec_facts(facts: SqlNonNumericPrimitiveFacts) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      if axis == discriminant(v: ModelCoreFactAxisSurfaceSpelling {}) {
          Holds { value: sql_inhabitant_atom(id: facts.surface_spelling) }
      } else if axis == discriminant(v: ModelCoreFactAxisEncoding {}) {
          Holds { value: sql_inhabitant_atom(id: facts.representation) }
      } else {
          Violates {
            diagnostic: primitive_fact_axis_unbound_diagnostic(axis: axis)
          }
      }
    }
  }
}

fn sql_primitive_bundle_from_integer_facts(facts: SqlIntegerPrimitiveFacts) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: sql_integer_facts_node(facts: facts),
    spec_facts: sql_integer_spec_facts(facts: facts)
  }
}

fn sql_primitive_bundle_from_float_facts(facts: SqlFloatPrimitiveFacts) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: sql_float_facts_node(facts: facts),
    spec_facts: sql_float_spec_facts(facts: facts)
  }
}

fn sql_primitive_bundle_from_nonnumeric_facts(
  facts: SqlNonNumericPrimitiveFacts
) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: sql_nonnumeric_facts_node(facts: facts),
    spec_facts: sql_nonnumeric_spec_facts(facts: facts)
  }
}

// fold_list is a left fold, so cons-prepend folds reverse input order.
// reverse + cons-prepend recovers the input order — this is the order-preserving
// idiom for List<T> in v2 substrate today; list_append is canonical in
// std/algebra, while list_map remains local here.
fn sql_list_reverse<T>(xs: List<T>) -> List<T> {
  fold_list(
    xs: xs,
    empty: Empty,
    cons: fn(acc, item) {
      Cons { head: item, tail: acc }
    }
  )
}

fn sql_list_map<T, U>(xs: List<T>, f: fn(T) -> U) -> List<U> {
  sql_list_reverse(
    xs: fold_list(
      xs: xs,
      empty: Empty,
      cons: fn(acc, item) {
        Cons { head: f(item), tail: acc }
      }
    )
  )
}

fn sql_primitive_bundles_from_integer_catalog() -> List<PrimitiveFactBundle> {
  sql_list_map(
    xs: sql_integer_facts_catalog,
    f: sql_primitive_bundle_from_integer_facts
  )
}

fn sql_primitive_bundles_from_float_catalog() -> List<PrimitiveFactBundle> {
  sql_list_map(
    xs: sql_float_facts_catalog,
    f: sql_primitive_bundle_from_float_facts
  )
}

fn sql_primitive_bundles_from_nonnumeric_catalog() -> List<PrimitiveFactBundle> {
  sql_list_map(
    xs: sql_nonnumeric_facts_catalog,
    f: sql_primitive_bundle_from_nonnumeric_facts
  )
}

fn sql_wave1_primitive_fact_bundles() -> List<PrimitiveFactBundle> {
  list_append(
    left: list_append(
      left: sql_primitive_bundles_from_integer_catalog(),
      right: sql_primitive_bundles_from_float_catalog()
    ),
    right: sql_primitive_bundles_from_nonnumeric_catalog()
  )
}
