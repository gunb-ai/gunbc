// src/v2/extdeps/formats/json_schema.dag
// Scope: JSON Schema Draft 2020-12 instance shell + default-dialect keyword bundle; typed slots favor Core-shaped surface; additional_keywords enumerates keywords authorized by the meta-schema anchor.
// Status: scaffold
// Anchor: https://json-schema.org/draft/2020-12/schema

module v2.extdeps.formats.json_schema


import v2.extdeps.formats.json { JsonDocument, JsonValue }
import v2.std.collection { Map, Optional, Set }
import v2.std.witness { Witness }


// 🟡 coproduct dissolution — T-4.6-P4-JsonSchemaCoreTypeName.
type JsonSchemaCoreTypeName
  = JsonSchemaCoreTypeNull
  | JsonSchemaCoreTypeBoolean
  | JsonSchemaCoreTypeObject
  | JsonSchemaCoreTypeArray
  | JsonSchemaCoreTypeNumber
  | JsonSchemaCoreTypeString
  | JsonSchemaCoreTypeInteger


// 🟡 coproduct dissolution — T-4.6-P4-JsonSchemaTypeSlot.
type JsonSchemaTypeSlot
  = JsonSchemaTypeAbsent
  | JsonSchemaTypeSingle { core_type: JsonSchemaCoreTypeName }
  | JsonSchemaTypeUnion { first: JsonSchemaCoreTypeName, rest: Set<JsonSchemaCoreTypeName> }


// 🟡 coproduct dissolution — T-4.6-JSK.
type JsonSchemaAdditionalKeywordKey
  = JsonSchemaKwAllOf
  | JsonSchemaKwAnyOf
  | JsonSchemaKwOneOf
  | JsonSchemaKwNot
  | JsonSchemaKwIf
  | JsonSchemaKwThen
  | JsonSchemaKwElse
  | JsonSchemaKwDependentSchemas
  | JsonSchemaKwPrefixItems
  | JsonSchemaKwContains
  | JsonSchemaKwAdditionalProperties
  | JsonSchemaKwPatternProperties
  | JsonSchemaKwPropertyNames
  | JsonSchemaKwUnevaluatedItems
  | JsonSchemaKwUnevaluatedProperties
  | JsonSchemaKwEnum
  | JsonSchemaKwConst
  | JsonSchemaKwMultipleOf
  | JsonSchemaKwMaximum
  | JsonSchemaKwExclusiveMaximum
  | JsonSchemaKwMinimum
  | JsonSchemaKwExclusiveMinimum
  | JsonSchemaKwMaxLength
  | JsonSchemaKwMinLength
  | JsonSchemaKwPattern
  | JsonSchemaKwFormat
  | JsonSchemaKwMaxItems
  | JsonSchemaKwMinItems
  | JsonSchemaKwUniqueItems
  | JsonSchemaKwMaxContains
  | JsonSchemaKwMinContains
  | JsonSchemaKwMaxProperties
  | JsonSchemaKwMinProperties
  | JsonSchemaKwDependentRequired
  | JsonSchemaKwTitle
  | JsonSchemaKwDescription
  | JsonSchemaKwDefault
  | JsonSchemaKwDeprecated
  | JsonSchemaKwReadOnly
  | JsonSchemaKwWriteOnly
  | JsonSchemaKwExamples
  | JsonSchemaKwContentEncoding
  | JsonSchemaKwContentMediaType
  | JsonSchemaKwContentSchema
  | JsonSchemaKwDollarSchema
  | JsonSchemaKwDollarId
  | JsonSchemaKwDollarAnchor
  | JsonSchemaKwDollarDynamicAnchor
  | JsonSchemaKwDollarRef
  | JsonSchemaKwDollarDynamicRef
  | JsonSchemaKwDollarDefs
  | JsonSchemaKwDollarComment
  | JsonSchemaKwDollarVocabulary
  | JsonSchemaKwDefinitions
  | JsonSchemaKwDependencies


// 🟡 coproduct dissolution — T-4.6-P4-JsonSchema.
type JsonSchema
  = JsonSchemaTrue
  | JsonSchemaFalse
  | JsonSchemaInstance {
      instance_type: JsonSchemaTypeSlot,
      properties: Optional<Map<String, JsonSchema>>,
      required: Optional<Set<String>>,
      items: Optional<JsonSchema>,
      additional_keywords: Map<JsonSchemaAdditionalKeywordKey, JsonValue>,
    }


type JsonSchemaInterpretation {
  json_document: JsonDocument,
  schema: JsonSchema,
}


type JsonSchemaDocument {
  interpretation: Witness<JsonSchemaInterpretation>,
}
