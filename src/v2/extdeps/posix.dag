module v2.extdeps.posix

import v2.extdeps.file_system { AbsolutePath, Filesystem, PosixByteString }
import std.algebra { FreeMonoid }
import v2.std.diagnostic { Accepted, Locus, Outcome, Rejected }
import v2.std.integer { Int }
import v2.std.machine { Byte }
import v2.std.node { Symbol }
import v2.std.refinement { Refined, Validation, refine }

type ProcessId {
  refined: Refined<Int>
}

type ExitCode {
  refined: Refined<Int>
}

type SignalNum {
  refined: Refined<Int>
}
fn process_id_admits(value: Int) -> Bool {
  value > 0
}

fn exit_code_admits(value: Int) -> Bool {
  (value >= 0) && (value <= 255)
}

fn signal_num_admits(value: Int) -> Bool {

  value > 0
}

data process_id_validation: Validation<Int> = Validation {
  reason: ^process_id_out_of_range,
  admits: process_id_admits
}

data exit_code_validation: Validation<Int> = Validation {
  reason: ^exit_code_out_of_range,
  admits: exit_code_admits
}

data signal_num_validation: Validation<Int> = Validation {
  reason: ^signal_num_out_of_range,
  admits: signal_num_admits
}

fn make_process_id(value: Int, at: Locus) -> Outcome<ProcessId> {
  match refine(base: value, by: process_id_validation, at: at) {
    Accepted { value: refined, diagnostics } =>
      Accepted { value: ProcessId { refined: refined }, diagnostics: diagnostics }
    Rejected { diagnostics } => Rejected { diagnostics: diagnostics }
  }
}

fn make_exit_code(value: Int, at: Locus) -> Outcome<ExitCode> {
  match refine(base: value, by: exit_code_validation, at: at) {
    Accepted { value: refined, diagnostics } =>
      Accepted { value: ExitCode { refined: refined }, diagnostics: diagnostics }
    Rejected { diagnostics } => Rejected { diagnostics: diagnostics }
  }
}

fn make_signal_num(value: Int, at: Locus) -> Outcome<SignalNum> {
  match refine(base: value, by: signal_num_validation, at: at) {
    Accepted { value: refined, diagnostics } =>
      Accepted { value: SignalNum { refined: refined }, diagnostics: diagnostics }
    Rejected { diagnostics } => Rejected { diagnostics: diagnostics }
  }
}

type PosixArgument {
  bytes: PosixByteString
}

type PosixEnvironmentName {
  bytes: PosixByteString
}

type PosixEnvironmentValue {
  bytes: PosixByteString
}

type Command {
  program: AbsolutePath
  argv0: PosixArgument
  args: List<PosixArgument>
  env: Map<PosixEnvironmentName, PosixEnvironmentValue>
}

type Termination
  = Exited { code: ExitCode }
  | Signaled { signal: SignalNum }

type TerminatedProcessState {
  termination: Termination
}

type ProcessIdentity {
  id: ProcessId
  command: Command
  parent: ProcessId
}

type RunningProcess {
  identity: ProcessIdentity
  output: CapturedOutputPipes
}

type TerminatedProcess {
  identity: ProcessIdentity
  state: TerminatedProcessState
}

type WaitedTerminatedProcess {
  identity: ProcessIdentity
  state: TerminatedProcessState
  output: CapturedOutputPipes
}

type CaptureSource
  = Live { resources: ProcessResources, process: RunningProcess }
  | Waited { waited: WaitedProcess }

type ProcessTable

type ProcessResources {
  table: ProcessTable
  filesystem: Filesystem
}

type CapturedByteStream = FreeMonoid<Byte>

type CapturedOutputPipes {
  stdout: CapturedByteStream
  stderr: CapturedByteStream
}

type SpawnProcessRequest {
  resources: ProcessResources
  command: Command
}

type SpawnedProcess {
  resources: ProcessResources
  process: RunningProcess
}

type SpawnProcessResult = Outcome<SpawnedProcess>

type WaitProcessRequest {
  resources: ProcessResources
  process: RunningProcess
}

type WaitedProcess {
  resources: ProcessResources
  process: WaitedTerminatedProcess
}

type WaitProcessResult = Outcome<WaitedProcess>

type CapturedProcessOutput {
  output: CapturedOutputPipes
  resources: ProcessResources
  process: TerminatedProcess
}

type CaptureProcessRequest {
  source: CaptureSource
}

type CaptureProcessResult = Outcome<CapturedProcessOutput>

type ProcessOperations {
  spawn: fn(SpawnProcessRequest) -> SpawnProcessResult
  wait: fn(WaitProcessRequest) -> WaitProcessResult
  capture: fn(CaptureProcessRequest) -> CaptureProcessResult
}
