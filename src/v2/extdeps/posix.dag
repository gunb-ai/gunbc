module v2.extdeps.posix


type ProcessId {
  refined: Refined<v2.std.integer.Int>
}

type ExitCode {
  refined: Refined<v2.std.integer.Int>
}

type SignalNum {
  refined: Refined<v2.std.integer.Int>
}
fn process_id_admits(value: v2.std.integer.Int) -> Bool {
  value > 0
}

fn exit_code_admits(value: v2.std.integer.Int) -> Bool {
  (value >= 0) && (value <= 255)
}

fn signal_num_admits(value: v2.std.integer.Int) -> Bool {

  value > 0
}

data process_id_validation: Validation<v2.std.integer.Int> = v2.std.refinement.Validation {
  reason: ^process_id_out_of_range,
  admits: process_id_admits
}

data exit_code_validation: Validation<v2.std.integer.Int> = v2.std.refinement.Validation {
  reason: ^exit_code_out_of_range,
  admits: exit_code_admits
}

data signal_num_validation: Validation<v2.std.integer.Int> = v2.std.refinement.Validation {
  reason: ^signal_num_out_of_range,
  admits: signal_num_admits
}

fn make_process_id(value: v2.std.integer.Int, at: v2.std.diagnostic.Locus) -> Outcome<ProcessId> {
  match refine(base: value, by: process_id_validation, at: at) {
    Accepted { value: refined, diagnostics } =>
      v2.std.diagnostic.Accepted { value: ProcessId { refined: refined }, diagnostics: diagnostics }
    Rejected { diagnostics } => v2.std.diagnostic.Rejected { diagnostics: diagnostics }
  }
}

fn make_exit_code(value: v2.std.integer.Int, at: v2.std.diagnostic.Locus) -> Outcome<ExitCode> {
  match refine(base: value, by: exit_code_validation, at: at) {
    Accepted { value: refined, diagnostics } =>
      v2.std.diagnostic.Accepted { value: ExitCode { refined: refined }, diagnostics: diagnostics }
    Rejected { diagnostics } => v2.std.diagnostic.Rejected { diagnostics: diagnostics }
  }
}

fn make_signal_num(value: v2.std.integer.Int, at: v2.std.diagnostic.Locus) -> Outcome<SignalNum> {
  match refine(base: value, by: signal_num_validation, at: at) {
    Accepted { value: refined, diagnostics } =>
      v2.std.diagnostic.Accepted { value: SignalNum { refined: refined }, diagnostics: diagnostics }
    Rejected { diagnostics } => v2.std.diagnostic.Rejected { diagnostics: diagnostics }
  }
}

type PosixArgument {
  bytes: v2.extdeps.file_system.PosixByteString
}

type PosixEnvironmentName {
  bytes: v2.extdeps.file_system.PosixByteString
}

type PosixEnvironmentValue {
  bytes: v2.extdeps.file_system.PosixByteString
}

type Command {
  program: v2.extdeps.file_system.AbsolutePath
  argv0: PosixArgument
  args: List<PosixArgument>
  env: Map<PosixEnvironmentName, PosixEnvironmentValue>
}

type Termination
  = Exited { code: ExitCode }
  | Signaled { signal: SignalNum }

type TerminatedProcessState {
  termination: Termination
}

type ProcessIdentity {
  id: ProcessId
  command: Command
  parent: ProcessId
}

type RunningProcess {
  identity: ProcessIdentity
  output: CapturedOutputPipes
}

type TerminatedProcess {
  identity: ProcessIdentity
  state: TerminatedProcessState
}

type WaitedTerminatedProcess {
  identity: ProcessIdentity
  state: TerminatedProcessState
  output: CapturedOutputPipes
}

type CaptureSource
  = Live { resources: ProcessResources, process: RunningProcess }
  | Waited { waited: WaitedProcess }

type ProcessTable

type ProcessResources {
  table: ProcessTable
  filesystem: v2.extdeps.file_system.Filesystem
}

type CapturedByteStream = std.algebra.FreeMonoid<std.bit.Byte>

type CapturedOutputPipes {
  stdout: CapturedByteStream
  stderr: CapturedByteStream
}

type SpawnProcessRequest {
  resources: ProcessResources
  command: Command
}

type SpawnedProcess {
  resources: ProcessResources
  process: RunningProcess
}

type SpawnProcessResult = v2.std.diagnostic.Outcome<SpawnedProcess>

type WaitProcessRequest {
  resources: ProcessResources
  process: RunningProcess
}

type WaitedProcess {
  resources: ProcessResources
  process: WaitedTerminatedProcess
}

type WaitProcessResult = v2.std.diagnostic.Outcome<WaitedProcess>

type CapturedProcessOutput {
  output: CapturedOutputPipes
  resources: ProcessResources
  process: TerminatedProcess
}

type CaptureProcessRequest {
  source: CaptureSource
}

type CaptureProcessResult = v2.std.diagnostic.Outcome<CapturedProcessOutput>

type ProcessOperations {
  spawn: fn(SpawnProcessRequest) -> SpawnProcessResult
  wait: fn(WaitProcessRequest) -> WaitProcessResult
  capture: fn(CaptureProcessRequest) -> CaptureProcessResult
}
