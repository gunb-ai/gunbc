module v2.extdeps.toolchain_interference

import std.types { String }

// One host operation owns the concurrent fixture.  The caller cannot substitute shell text:
// the runtime creates both executable paths, starts the readers and hostile replacement, joins
// every participant, and returns one of these causes.
type ToolchainInterferenceProbeResult
  = ToolchainInterferenceDiscriminated
  | ToolchainInterferenceProbeRefused { cause: ToolchainInterferenceProbeRefusal }

type ToolchainInterferenceProbeRefusal
  = ToolchainPrivateHomeBindingMissing { observed: String, expected: String }
  | ToolchainSharedArmDidNotObserveInterference
  | ToolchainPrivateHomeIsolationBreached
  | ToolchainInterferenceFixtureFailed { detail: String }

fn toolchain_interference_probe_on_host() -> ToolchainInterferenceProbeResult {
  toolchain_home_interference_probe()
}
