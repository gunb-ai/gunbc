module v2.extdeps.bmc.lifecycle_fidelity


type SecretEpochNotInQuotient {}

data bmc_credentials_rotated_inverse_lossy_witness: SecretEpochNotInQuotient = SecretEpochNotInQuotient {}

fn bmc_credentials_rotated_inverse_lossy_reason() -> SecretEpochNotInQuotient {
  bmc_credentials_rotated_inverse_lossy_witness
}

fn bmc_lifecycle_modeled_fidelity_node() -> v2.std.node.Node {
  dag_grammar_atom(id: ^dag_fidelity_disposition_kind_modeled)
}

fn bmc_lifecycle_lossy_witness_grounded(_: SecretEpochNotInQuotient) -> v2.std.node.Symbol {
  ^bmc_lifecycle_lossy_secret_epoch_witness
}

fn bmc_lifecycle_lossy_witness_node(reason: SecretEpochNotInQuotient) -> v2.std.node.Node {
  dag_grammar_atom(id: bmc_lifecycle_lossy_witness_grounded(reason))
}

fn bmc_lifecycle_lossy_fidelity_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^dag_fidelity_disposition_kind_declared_normalized,
        target: dag_grammar_atom(id: ^dag_fidelity_disposition_kind_declared_normalized)
      ),
      dag_named_edge(
        name: ^dag_fidelity_disposition_field_feature,
        target: bmc_lifecycle_lossy_witness_node(
          reason: bmc_credentials_rotated_inverse_lossy_reason()
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn bmc_lifecycle_inverse_fidelity_quotient_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^bmc_lifecycle_fidelity_factory_default,
        target: bmc_lifecycle_modeled_fidelity_node()
      ),
      dag_named_edge(
        name: ^bmc_lifecycle_fidelity_credentials_rotated,
        target: bmc_lifecycle_lossy_fidelity_node()
      ),
      dag_named_edge(
        name: ^bmc_lifecycle_fidelity_os_installed,
        target: bmc_lifecycle_modeled_fidelity_node()
      ),
      dag_named_edge(
        name: ^bmc_lifecycle_fidelity_fabric_joined,
        target: bmc_lifecycle_modeled_fidelity_node()
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn bmc_lifecycle_inverse_fidelity_quotient_credentials_modeled_perturb_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^bmc_lifecycle_fidelity_factory_default,
        target: bmc_lifecycle_modeled_fidelity_node()
      ),
      dag_named_edge(
        name: ^bmc_lifecycle_fidelity_credentials_rotated,
        target: bmc_lifecycle_modeled_fidelity_node()
      ),
      dag_named_edge(
        name: ^bmc_lifecycle_fidelity_os_installed,
        target: bmc_lifecycle_modeled_fidelity_node()
      ),
      dag_named_edge(
        name: ^bmc_lifecycle_fidelity_fabric_joined,
        target: bmc_lifecycle_modeled_fidelity_node()
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn bmc_lifecycle_inverse_target_model_bundle_with_quotient(quotient: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^target_model_edge_fidelity_quotient,
        target: quotient
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn bmc_lifecycle_inverse_target_model_bundle() -> v2.std.node.Node {
  bmc_lifecycle_inverse_target_model_bundle_with_quotient(
    quotient: bmc_lifecycle_inverse_fidelity_quotient_node()
  )
}

data bmc_lifecycle_inverse_authority_source: String = "gunbc.bmc_onboarding lifecycle inverse roundtrip fidelity quotient"

fn bmc_lifecycle_inverse_target_model() -> v2.std.compilers.target_model.TargetModel {
  v2.std.compilers.target_model.TargetModel {
    produced_decl_support: ProducedDeclUnwired,
    bundle: bmc_lifecycle_inverse_target_model_bundle(),
    lex: VoidLexRules,
    binding_spellings: empty_map(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: bmc_lifecycle_inverse_authority_source,
    runtime_row: target_emit_host_runtime_row_unconfigured
  }
}

fn bmc_lifecycle_inverse_target_model_credentials_modeled_perturb() -> v2.std.compilers.target_model.TargetModel {
  v2.std.compilers.target_model.TargetModel {
    produced_decl_support: ProducedDeclUnwired,
    bundle: bmc_lifecycle_inverse_target_model_bundle_with_quotient(
      quotient: bmc_lifecycle_inverse_fidelity_quotient_credentials_modeled_perturb_node()
    ),
    lex: VoidLexRules,
    binding_spellings: empty_map(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: bmc_lifecycle_inverse_authority_source,
    runtime_row: target_emit_host_runtime_row_unconfigured
  }
}
