module v2.extdeps.file_system

import std.algebra { FreeMonoid }
import v2.std.diagnostic { Outcome }
import v2.std.machine { Byte }

type PosixByteString = FreeMonoid<Byte>

type NamedPathComponent {
  bytes: PosixByteString
}

type PathComponent
  = CurrentComponent
  | ParentComponent
  | NamedComponent { component: NamedPathComponent }

type AbsolutePath {
  components: List<PathComponent>
}

type RelativePathHead
  = ParentHead
  | NamedHead { component: NamedPathComponent }

type RelativePath
  = CurrentDirectory
  | CurrentDescendant { first: RelativePathHead, rest: List<PathComponent> }
  | RelativeDescendant { first: RelativePathHead, rest: List<PathComponent> }

type FilesystemPath
  = Absolute { path: AbsolutePath }
  | Relative { path: RelativePath }

type FileKind
  = RegularFile
  | Directory
  | Symlink

type FileKindResolutionPolicy
  = FollowSymlinks
  | DoNotFollowSymlinks

type Filesystem

type FileBody = FreeMonoid<Byte>

type FileResource {
  filesystem: Filesystem
}

type FilePath {
  path: FilesystemPath
}

fn path_component_is_parent(component: PathComponent) -> Bool {
  match component {
    ParentComponent => true
    CurrentComponent => false
    NamedComponent { component: _ } => false
  }
}

fn path_component_is_named(component: PathComponent) -> Bool {
  match component {
    NamedComponent { component: _ } => true
    CurrentComponent => false
    ParentComponent => false
  }
}

fn filesystem_path_is_absolute(path: FilesystemPath) -> Bool {
  match path {
    Absolute { path: _ } => true
    Relative { path: _ } => false
  }
}

fn filesystem_path_is_relative(path: FilesystemPath) -> Bool {
  !filesystem_path_is_absolute(path: path)
}

fn file_path_is_absolute(path: FilePath) -> Bool {
  filesystem_path_is_absolute(path: path.path)
}

fn file_path_is_relative(path: FilePath) -> Bool {
  !file_path_is_absolute(path: path)
}

fn file_kind_is_regular_file(kind: FileKind) -> Bool {
  match kind {
    RegularFile => true
    Directory => false
    Symlink => false
  }
}

fn file_kind_is_directory(kind: FileKind) -> Bool {
  match kind {
    Directory => true
    RegularFile => false
    Symlink => false
  }
}

type FileContent = FileBody

type FileRead {
  resource: FileResource,
  path: FilePath
}

type FileWrite {
  resource: FileResource,
  path: FilePath,
  content: FileContent
}

type FileReadReceipt {
  request: FileRead,
  content: FileContent
}

type FileWriteReceipt {
  request: FileWrite,
  resource: FileResource
}

type FileReadResult = Outcome<FileContent>

type FileWriteResult = Outcome<FileResource>

type ModeledFileEffects {
  file_read: fn(FileRead) -> FileReadResult
  file_write: fn(FileWrite) -> FileWriteResult
}

type ReadFileRequest {
  filesystem: Filesystem
  path: AbsolutePath
}

type ReadFileResult = Outcome<FileBody>

type WriteFileRequest {
  filesystem: Filesystem
  path: AbsolutePath
  body: FileBody
}

type WriteFileResult = Outcome<Filesystem>

type ListDirRequest {
  filesystem: Filesystem
  path: AbsolutePath
}

type ListDirResult = Outcome<List<PathComponent>>

type FileKindRequest {
  filesystem: Filesystem
  path: AbsolutePath
  resolution: FileKindResolutionPolicy
}

type FileKindResult = Outcome<FileKind>

type FileSystemOperations {
  read_file: fn(ReadFileRequest) -> ReadFileResult
  write_file: fn(WriteFileRequest) -> WriteFileResult
  list_dir: fn(ListDirRequest) -> ListDirResult
  file_kind: fn(FileKindRequest) -> FileKindResult
}
