fn python_l1_static_mypy_fixture_pair_wired() -> Bool {
  python_l1_static_mypy_fixture().claim_id == leaf_model_claim_python_l1_static_return_type
    && python_l1_static_mypy_fixture().surface_spelling_fact == ^python_surface_spelling_int
    && match leaf_model_python_static_happy_invocation(c: python_l1_static_mypy_fixture().happy).analysis_role {
         BlockingForRung => true
         Advisory => false
       }
    && match leaf_model_python_static_falsification_invocation(c: python_l1_static_mypy_fixture().falsification).analysis_role {
         BlockingForRung => true
         Advisory => false
       }
    && leaf_model_python_static_happy_invocation(c: python_l1_static_mypy_fixture().happy).tool_profile_ref == ^mypy_profile_l1_id
    && leaf_model_python_static_falsification_invocation(c: python_l1_static_mypy_fixture().falsification).tool_profile_ref == ^mypy_profile_l1_id
}

data claim_python_l1_static_mypy_fixture_pair_wired: TestClaim = EqualsClaim {
  label: "language_model/python_l1_static: mypy fixture pair binds L1 static claim id + BlockingForRung",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: python_l1_static_claim_bool_atom(b: python_l1_static_mypy_fixture_pair_wired()),
  rhs: python_l1_static_claim_bool_atom(b: true),
