}

fn python_l1_static_mypy_expected_verdicts_wired() -> Bool {
  match leaf_model_python_static_happy_verdict(_c: python_l1_static_mypy_fixture().happy) {
    StaticAnalysisAccepted => true
    StaticAnalysisRejected { tool_id: _, diagnostic_code: _ } => false
    StaticAnalysisAdvisory { tool_id: _, diagnostic_code: _ } => false
  }
  && match leaf_model_python_static_falsification_verdict(c: python_l1_static_mypy_fixture().falsification) {
       StaticAnalysisAccepted => false
       StaticAnalysisRejected { tool_id: t, diagnostic_code: d } =>
         t == ^mypy_tool_id && d == ^mypy_diag_return_value
       StaticAnalysisAdvisory { tool_id: _, diagnostic_code: _ } => false
     }
}

data claim_python_l1_static_mypy_expected_verdicts_wired: TestClaim = EqualsClaim {
  label: "language_model/python_l1_static: mypy happy=Accepted, falsification=Rejected(mypy, return-value)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: python_l1_static_claim_bool_atom(b: python_l1_static_mypy_expected_verdicts_wired()),
  rhs: python_l1_static_claim_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Boundary }
}
