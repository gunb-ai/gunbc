module v2.test.language_model.python_r3_external

fn python_r3_external_claim_bool_atom(b: Bool) -> Node {
  match b {
    true => Node { kind: TypeNode { connective: Atom { identity: ^python_r3_external_claim_bool_true } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => Node { kind: TypeNode { connective: Atom { identity: ^python_r3_external_claim_bool_false } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

data claim_python_r3_external_fixture_pair_wired: TestClaim = EqualsClaim {
  label: "language_model/python_r3_external: fixture pair references python_atom_realization_symbol fact",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: python_r3_external_claim_bool_atom(b: true),
  rhs: python_r3_external_claim_bool_atom(
    b: python_r3_external_fixture().claim_id == leaf_model_claim_python_r3_external_symbol_projection
      && python_r3_external_fixture().surface_spelling_fact == ^python_atom_realization_symbol
      && python_r3_external_fixture().encoding_spelling_fact == ^python_atom_realization_symbol
      && python_r3_external_fixture().happy.source == python_r3_external_happy_fixture_source
      && python_r3_external_fixture().falsification.fixture.source == python_r3_external_falsification_fixture_source
  ),
  classification: TestClassification { tier: Tier1, layer: Boundary }
}
fn python_r3_external_pending_verification_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^python_r3_external_pending_verification_reason,
    at: Textual { file: ^python_r3_external_pending_verification_reason, extent: WholeFile },
    correction: Unavailable { reason: UserInputBoundary }
  }
}

data python_r3_external_verification_run_receipt_default: LeafModelVerificationRunReceipt = LeafModelVerificationRunReceipt {
  claim_id: leaf_model_claim_python_r3_external_symbol_projection,
  happy_verdict: verdict_fail(
    actual: outcome_rejected(d: python_r3_external_pending_verification_diagnostic())
  ),
  falsification_verdict: verdict_fail(
    actual: outcome_rejected(d: python_r3_external_pending_verification_diagnostic())
  )
}

data claim_python_r3_external_verification_receipt_shape: TestClaim = EqualsClaim {
  label: "language_model/python_r3_external: verification receipt carriers happy + falsification verdict slots",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: python_r3_external_claim_bool_atom(
    b: python_r3_external_verification_run_receipt_default.claim_id == leaf_model_claim_python_r3_external_symbol_projection
  ),
  rhs: python_r3_external_claim_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Boundary }
}

data python_r3_external_modeled_falsification_expectation: TargetPythonExerciseVerdict = TargetPythonExecRejected {
  diagnostic_code: ^target_diagnostic_python_type_error_init_arity_mismatch
}
