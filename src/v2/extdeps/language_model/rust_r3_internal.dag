module v2.test.language_model.rust_r3_internal

fn rust_r3_internal_claim_bool_atom(b: Bool) -> Node {
  match b {
    true => Node { kind: TypeNode { connective: Atom { identity: ^rust_r3_internal_claim_bool_true } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => Node { kind: TypeNode { connective: Atom { identity: ^rust_r3_internal_claim_bool_false } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

fn rust_r3_internal_emit_coupling_fixture_wired() -> Bool {
  let receipt = rust_r3_internal_fixture()
  receipt.claim_id == leaf_model_claim_rust_r3_internal_symbol_coupling
  && receipt.atom_realization_fact == ^rust_atom_realization_symbol
  && rust_r3_internal_emit_coupling_both_projections_changed(receipt: receipt)
}

data claim_rust_r3_internal_emit_coupling_wired: TestClaim = EqualsClaim {
  label: "language_model/rust_r3_internal: emit-coupling receipt references rust_atom_realization_symbol and both projections change on row mutation",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: rust_r3_internal_claim_bool_atom(b: true),
  rhs: rust_r3_internal_claim_bool_atom(b: rust_r3_internal_emit_coupling_fixture_wired()),
  classification: TestClassification { tier: Tier1, layer: Boundary }
}
fn rust_r3_internal_pending_verification_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^rust_r3_internal_pending_verification_reason,
    at: Textual { file: ^rust_r3_internal_pending_verification_reason, extent: WholeFile },
    correction: Unavailable { reason: UserInputBoundary }
  }
}

data rust_r3_internal_verification_run_receipt_default: LeafModelVerificationRunReceipt = LeafModelVerificationRunReceipt {
  claim_id: leaf_model_claim_rust_r3_internal_symbol_coupling,
  happy_verdict: verdict_fail(
    actual: outcome_rejected(d: rust_r3_internal_pending_verification_diagnostic())
  ),
  falsification_verdict: verdict_fail(
    actual: outcome_rejected(d: rust_r3_internal_pending_verification_diagnostic())
  )
}

fn rust_r3_internal_verification_receipt_claim_id_wired() -> Bool {
  rust_r3_internal_verification_run_receipt_default.claim_id == leaf_model_claim_rust_r3_internal_symbol_coupling
}

data claim_rust_r3_internal_verification_receipt_shape: TestClaim = EqualsClaim {
  label: "language_model/rust_r3_internal: verification receipt carriers happy + falsification verdict slots",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: rust_r3_internal_claim_bool_atom(b: rust_r3_internal_verification_receipt_claim_id_wired()),
  rhs: rust_r3_internal_claim_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Boundary }
}

data rust_r3_internal_modeled_happy_expectation: TargetCompileVerdict = TargetCompileAccepted
