module v2.test.language_model.rust_r2a

fn rust_r2a_claim_bool_atom(b: Bool) -> Node {
  match b {
    true => Node { kind: TypeNode { connective: Atom { identity: ^rust_r2a_claim_bool_true } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => Node { kind: TypeNode { connective: Atom { identity: ^rust_r2a_claim_bool_false } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

data claim_rust_r2a_fixture_pair_wired: TestClaim = EqualsClaim {
  label: "language_model/rust_r2a: fixture pair references rust_integer_algebra_inhabitance_rust_facts_i32",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: rust_r2a_claim_bool_atom(b: true),
  rhs: rust_r2a_claim_bool_atom(
    b: rust_r2a_fixture().claim_id == leaf_model_claim_rust_r2a_i32_algebra_operations
      && rust_r2a_fixture().surface_spelling_fact == rust_integer_algebra_inhabitance_rust_facts_i32
      && rust_r2a_fixture().happy.source == rust_r2a_happy_fixture_source
      && rust_r2a_fixture().falsification.fixture.source == rust_r2a_falsification_fixture_source
  ),
  classification: TestClassification { tier: Tier1, layer: Boundary }
}
fn rust_r2a_pending_verification_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^rust_r2a_pending_verification_reason,
    at: Textual { file: ^rust_r2a_pending_verification_reason, extent: WholeFile },
    correction: Unavailable { reason: UserInputBoundary }
  }
}

data rust_r2a_verification_run_receipt_default: LeafModelVerificationRunReceipt = LeafModelVerificationRunReceipt {
  claim_id: leaf_model_claim_rust_r2a_i32_algebra_operations,
  happy_verdict: verdict_fail(
    actual: outcome_rejected(d: rust_r2a_pending_verification_diagnostic())
  ),
  falsification_verdict: verdict_fail(
    actual: outcome_rejected(d: rust_r2a_pending_verification_diagnostic())
  )
}

data claim_rust_r2a_verification_receipt_shape: TestClaim = EqualsClaim {
  label: "language_model/rust_r2a: verification receipt carriers happy + falsification verdict slots",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: rust_r2a_claim_bool_atom(
    b: rust_r2a_verification_run_receipt_default.claim_id == leaf_model_claim_rust_r2a_i32_algebra_operations
  ),
  rhs: rust_r2a_claim_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Boundary }
}

data rust_r2a_modeled_falsification_expectation: TargetCompileVerdict = TargetCompileRejected {
  diagnostic_code: ^target_diagnostic_e0599_method_not_found
}
