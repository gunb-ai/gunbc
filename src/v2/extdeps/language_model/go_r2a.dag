module v2.test.language_model.go_r2a

fn go_r2a_claim_bool_atom(b: Bool) -> Node {
  match b {
    true => v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^go_r2a_claim_bool_true } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^go_r2a_claim_bool_false } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

data claim_go_r2a_fixture_pair_wired: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "language_model/go_r2a: fixture pair references go_integer_algebra_inhabitance(go_facts_int)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: go_r2a_claim_bool_atom(b: true),
  rhs: go_r2a_claim_bool_atom(
    b: go_r2a_fixture().claim_id == leaf_model_claim_go_r2a_int_algebra_operations
      && go_r2a_fixture().fact_anchor == go_r2a_algebra_inhabitance_fact_node()
      && go_r2a_fixture().happy.source == go_r2a_happy_fixture_source
      && go_r2a_fixture().expected_happy_verdict == TargetCompileAccepted
      && go_r2a_fixture().falsification.fixture.source == go_r2a_falsification_fixture_source
      && go_r2a_fixture().falsification.expected_verdict == go_r2a_modeled_falsification_expectation
  ),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Boundary }
}
fn go_r2a_pending_verification_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^go_r2a_pending_verification_reason,
    at: v2.std.diagnostic.Textual { file: ^go_r2a_pending_verification_reason, extent: WholeFile },
    correction: v2.std.diagnostic.Unavailable { reason: UserInputBoundary }
  }
}

data go_r2a_verification_run_receipt_default: v2.std.leaf_model_verification.LeafModelVerificationRunReceipt = v2.std.leaf_model_verification.LeafModelVerificationRunReceipt {
  claim_id: leaf_model_claim_go_r2a_int_algebra_operations,
  happy_verdict: verdict_fail(
    actual: outcome_rejected(d: go_r2a_pending_verification_diagnostic())
  ),
  falsification_verdict: verdict_fail(
    actual: outcome_rejected(d: go_r2a_pending_verification_diagnostic())
  )
}

data claim_go_r2a_verification_receipt_shape: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "language_model/go_r2a: verification receipt carriers happy + falsification verdict slots",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: go_r2a_claim_bool_atom(
    b: go_r2a_verification_run_receipt_default.claim_id == leaf_model_claim_go_r2a_int_algebra_operations
  ),
  rhs: go_r2a_claim_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Boundary }
}

data go_r2a_modeled_falsification_expectation: v2.std.leaf_model_verification.TargetCompileVerdict = v2.std.leaf_model_verification.TargetCompileRejected {
  diagnostic_code: ^target_diagnostic_go_undefined_method
}
