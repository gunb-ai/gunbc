module v2.test.language_model.typescript_r2b

import v2.extdeps.languages.typescript { ts_bigint_algebra_inhabitance_ts_facts_bigint }
import v2.lens.leaf_model_verification {
  typescript_r2b_fixture,
  typescript_r2b_runtime_happy_fixture_source,
  typescript_r2b_runtime_falsification_fixture_source
}
import v2.std.diagnostic {
  Diagnostic,
  Textual,
  Unavailable,
  UserInputBoundary,
  WholeFile,
  outcome_rejected
}
import v2.std.leaf_model_verification {
  LeafModelVerificationRunReceipt,
  leaf_model_claim_ts_r2b_bigint_beyond_safe_integer
}
import v2.std.logic { Bool }
import v2.std.node { Atom, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.verdict { verdict_fail }
import v2.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Boundary,
  manual_claim_anchor
}
fn typescript_r2b_claim_bool_atom(b: Bool) -> Node {
  match b {
    true => Node { kind: TypeNode { connective: Atom { identity: ^typescript_r2b_claim_bool_true } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => Node { kind: TypeNode { connective: Atom { identity: ^typescript_r2b_claim_bool_false } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

data claim_typescript_r2b_fixture_pair_wired: TestClaim = EqualsClaim {
  label: "language_model/typescript_r2b: fixture references bigint algebra inhabitance + runtime sources",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: typescript_r2b_claim_bool_atom(b: true),
  rhs: typescript_r2b_claim_bool_atom(
    b: typescript_r2b_fixture().claim_id == leaf_model_claim_ts_r2b_bigint_beyond_safe_integer
      && typescript_r2b_fixture().surface_spelling_fact == ts_bigint_algebra_inhabitance_ts_facts_bigint
      && typescript_r2b_fixture().encoding_spelling_fact == ts_bigint_algebra_inhabitance_ts_facts_bigint
      && typescript_r2b_fixture().happy.source == typescript_r2b_runtime_happy_fixture_source
      && typescript_r2b_fixture().falsification.source == typescript_r2b_runtime_falsification_fixture_source
  ),
  classification: TestClassification { tier: Tier1, layer: Boundary }
}
fn typescript_r2b_pending_verification_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^typescript_r2b_pending_verification_reason,
    at: Textual { file: ^typescript_r2b_pending_verification_reason, extent: WholeFile },
    correction: Unavailable { reason: UserInputBoundary }
  }
}

data typescript_r2b_verification_run_receipt_default: LeafModelVerificationRunReceipt = LeafModelVerificationRunReceipt {
  claim_id: leaf_model_claim_ts_r2b_bigint_beyond_safe_integer,
  happy_verdict: verdict_fail(
    actual: outcome_rejected(d: typescript_r2b_pending_verification_diagnostic())
  ),
  falsification_verdict: verdict_fail(
    actual: outcome_rejected(d: typescript_r2b_pending_verification_diagnostic())
  )
}

data claim_typescript_r2b_verification_receipt_shape: TestClaim = EqualsClaim {
  label: "language_model/typescript_r2b: verification receipt carriers happy + falsification verdict slots",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: typescript_r2b_claim_bool_atom(
    b: typescript_r2b_verification_run_receipt_default.claim_id == leaf_model_claim_ts_r2b_bigint_beyond_safe_integer
  ),
  rhs: typescript_r2b_claim_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Boundary }
}
