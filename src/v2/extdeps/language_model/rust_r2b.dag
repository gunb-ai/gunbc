module v2.test.language_model.rust_r2b

fn rust_r2b_claim_bool_atom(b: Bool) -> Node {
  match b {
    true => Node { kind: TypeNode { connective: Atom { identity: ^rust_r2b_claim_bool_true } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => Node { kind: TypeNode { connective: Atom { identity: ^rust_r2b_claim_bool_false } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

data claim_rust_r2b_debug_fixture_pair_wired: TestClaim = EqualsClaim {
  label: "language_model/rust_r2b: debug-default fixture references overflow inhabitance fact + runtime source",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: rust_r2b_claim_bool_atom(b: true),
  rhs: rust_r2b_claim_bool_atom(
    b: rust_r2b_debug_fixture().claim_id == leaf_model_claim_rust_r2b_debug_default_overflow
      && rust_r2b_debug_fixture().surface_spelling_fact == rust_integer_algebra_inhabitance_rust_facts_i32
      && rust_r2b_debug_fixture().happy.source == rust_r2b_runtime_fixture_source
  ),
  classification: TestClassification { tier: Tier1, layer: Boundary }
}

data claim_rust_r2b_release_fixture_pair_wired: TestClaim = EqualsClaim {
  label: "language_model/rust_r2b: release-default fixture references overflow inhabitance fact + runtime source",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: rust_r2b_claim_bool_atom(b: true),
  rhs: rust_r2b_claim_bool_atom(
    b: rust_r2b_release_fixture().claim_id == leaf_model_claim_rust_r2b_release_default_overflow
      && rust_r2b_release_fixture().surface_spelling_fact == rust_integer_algebra_inhabitance_rust_facts_i32
      && rust_r2b_release_fixture().happy.source == rust_r2b_runtime_fixture_source
  ),
  classification: TestClassification { tier: Tier1, layer: Boundary }
}
fn rust_r2b_pending_verification_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^rust_r2b_pending_verification_reason,
    at: Textual { file: ^rust_r2b_pending_verification_reason, extent: WholeFile },
    correction: Unavailable { reason: UserInputBoundary }
  }
}

data rust_r2b_debug_verification_run_receipt_default: LeafModelVerificationRunReceipt = LeafModelVerificationRunReceipt {
  claim_id: leaf_model_claim_rust_r2b_debug_default_overflow,
  happy_verdict: verdict_fail(
    actual: outcome_rejected(d: rust_r2b_pending_verification_diagnostic())
  ),
  falsification_verdict: verdict_fail(
    actual: outcome_rejected(d: rust_r2b_pending_verification_diagnostic())
  )
}

data rust_r2b_release_verification_run_receipt_default: LeafModelVerificationRunReceipt = LeafModelVerificationRunReceipt {
  claim_id: leaf_model_claim_rust_r2b_release_default_overflow,
  happy_verdict: verdict_fail(
    actual: outcome_rejected(d: rust_r2b_pending_verification_diagnostic())
  ),
  falsification_verdict: verdict_fail(
    actual: outcome_rejected(d: rust_r2b_pending_verification_diagnostic())
  )
}

data claim_rust_r2b_verification_receipt_shapes: TestClaim = EqualsClaim {
  label: "language_model/rust_r2b: debug + release verification receipt carriers present",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: rust_r2b_claim_bool_atom(
    b: rust_r2b_debug_verification_run_receipt_default.claim_id == leaf_model_claim_rust_r2b_debug_default_overflow
      && rust_r2b_release_verification_run_receipt_default.claim_id == leaf_model_claim_rust_r2b_release_default_overflow
  ),
  rhs: rust_r2b_claim_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Boundary }
}
