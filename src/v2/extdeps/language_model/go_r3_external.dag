module v2.test.language_model.go_r3_external

fn go_r3_external_claim_bool_atom(b: Bool) -> Node {
  match b {
    true => Node { kind: TypeNode { connective: Atom { identity: ^go_r3_external_claim_bool_true } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => Node { kind: TypeNode { connective: Atom { identity: ^go_r3_external_claim_bool_false } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

data claim_go_r3_external_fixture_pair_wired: TestClaim = EqualsClaim {
  label: "language_model/go_r3_external: fixture pair references go_atom_realization_symbol",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: go_r3_external_claim_bool_atom(b: true),
  rhs: go_r3_external_claim_bool_atom(
    b: go_r3_external_fixture().claim_id == leaf_model_claim_go_r3_external_symbol_projection
      && go_r3_external_fixture().fact_anchor == go_leaf_model_fact_atom(id: ^go_atom_realization_symbol)
      && go_r3_external_fixture().happy.source == go_r3_external_happy_fixture_source
      && go_r3_external_fixture().expected_happy_verdict == TargetCompileAccepted
      && go_r3_external_fixture().falsification.fixture.source == go_r3_external_falsification_fixture_source
      && go_r3_external_fixture().falsification.expected_verdict == go_r3_external_modeled_falsification_expectation
  ),
  classification: TestClassification { tier: Tier1, layer: Boundary }
}
fn go_r3_external_pending_verification_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^go_r3_external_pending_verification_reason,
    at: Textual { file: ^go_r3_external_pending_verification_reason, extent: WholeFile },
    correction: Unavailable { reason: UserInputBoundary }
  }
}

data go_r3_external_verification_run_receipt_default: LeafModelVerificationRunReceipt = LeafModelVerificationRunReceipt {
  claim_id: leaf_model_claim_go_r3_external_symbol_projection,
  happy_verdict: verdict_fail(
    actual: outcome_rejected(d: go_r3_external_pending_verification_diagnostic())
  ),
  falsification_verdict: verdict_fail(
    actual: outcome_rejected(d: go_r3_external_pending_verification_diagnostic())
  )
}

data claim_go_r3_external_verification_receipt_shape: TestClaim = EqualsClaim {
  label: "language_model/go_r3_external: verification receipt carriers happy + falsification verdict slots",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: go_r3_external_claim_bool_atom(
    b: go_r3_external_verification_run_receipt_default.claim_id == leaf_model_claim_go_r3_external_symbol_projection
  ),
  rhs: go_r3_external_claim_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Boundary }
}

data go_r3_external_modeled_falsification_expectation: TargetCompileVerdict = TargetCompileRejected {
  diagnostic_code: ^target_diagnostic_go_invalid_conversion_arity
}
