module v2.test.language_model.python_cross_runtime_drift

import v2.lens.leaf_model_verification {
  python_cross_runtime_drift_probe,
  python_cross_runtime_drift_python_source,
  python_cross_runtime_drift_rust_source,
  python_cross_runtime_drift_go_source,
  python_cross_runtime_drift_arbitrary_precision_value,
  python_cross_runtime_drift_fixed_width_value
}
import v2.std.leaf_model_verification {
  LeafModelCrossRuntimeDriftProbe,
  leaf_model_claim_python_cross_runtime_drift_arbitrary_precision
}
import v2.std.logic { Bool }
import v2.std.node { Atom, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Boundary,
  manual_claim_anchor
}
fn python_cross_runtime_drift_claim_bool_atom(b: Bool) -> Node {
  match b {
    true => Node { kind: TypeNode { connective: Atom { identity: ^python_cross_runtime_drift_claim_bool_true } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => Node { kind: TypeNode { connective: Atom { identity: ^python_cross_runtime_drift_claim_bool_false } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

fn python_cross_runtime_drift_probe_is_wired(p: LeafModelCrossRuntimeDriftProbe) -> Bool {
  p.claim_id == leaf_model_claim_python_cross_runtime_drift_arbitrary_precision
    && p.arbitrary_precision_fact == ^python_repr_int_arbitrary_precision
    && p.fixed_width_rust_fact == ^rust_repr_integer_twos_complement
    && p.fixed_width_go_fact == ^go_repr_twos_complement_integer
    && p.arbitrary_precision_source == python_cross_runtime_drift_python_source
    && p.fixed_width_rust_source == python_cross_runtime_drift_rust_source
    && p.fixed_width_go_source == python_cross_runtime_drift_go_source
    && p.expected_divergence.expected == python_cross_runtime_drift_arbitrary_precision_value
    && p.expected_divergence.actual == python_cross_runtime_drift_fixed_width_value
}

fn python_cross_runtime_drift_probe_diverges(p: LeafModelCrossRuntimeDriftProbe) -> Bool {
  p.expected_divergence.expected != p.expected_divergence.actual
}

data claim_python_cross_runtime_drift_probe_wired: TestClaim = EqualsClaim {
  label: "language_model/python_cross_runtime_drift: probe wires drift claim id + per-target sources + ValueDiff divergence anchor",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: python_cross_runtime_drift_claim_bool_atom(b: true),
  rhs: python_cross_runtime_drift_claim_bool_atom(
    b: python_cross_runtime_drift_probe_is_wired(p: python_cross_runtime_drift_probe())
  ),
  classification: TestClassification { tier: Tier1, layer: Boundary }
}

data claim_python_cross_runtime_drift_is_positive_divergence: TestClaim = EqualsClaim {
  label: "language_model/python_cross_runtime_drift: arbitrary-precision value diverges from fixed-width value (drift is real)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: python_cross_runtime_drift_claim_bool_atom(b: true),
  rhs: python_cross_runtime_drift_claim_bool_atom(
    b: python_cross_runtime_drift_probe_diverges(p: python_cross_runtime_drift_probe())
  ),
  classification: TestClassification { tier: Tier1, layer: Boundary }
}
