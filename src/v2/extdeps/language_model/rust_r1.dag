module v2.test.language_model.rust_r1

fn rust_r1_claim_bool_atom(b: Bool) -> Node {
  match b {
    true => v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^rust_r1_claim_bool_true } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^rust_r1_claim_bool_false } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

data claim_rust_r1_fixture_pair_wired: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "language_model/rust_r1: fixture pair references rust_surface_spelling_i32 fact anchors",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: rust_r1_claim_bool_atom(b: true),
  rhs: rust_r1_claim_bool_atom(
    b: rust_r1_fixture().claim_id == leaf_model_claim_rust_r1_i32_surface_spelling
      && rust_r1_fixture().surface_spelling_fact == ^rust_surface_spelling_i32
      && rust_r1_fixture().coercion_spelling_fact == ^rust_coercion_field_i32_spelling
      && rust_r1_fixture().happy.source == rust_r1_happy_fixture_source
      && rust_r1_fixture().falsification.fixture.source == rust_r1_falsification_fixture_source
  ),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Boundary }
}
fn rust_r1_pending_verification_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^rust_r1_pending_verification_reason,
    at: v2.std.diagnostic.Textual { file: ^rust_r1_pending_verification_reason, extent: WholeFile },
    correction: v2.std.diagnostic.Unavailable { reason: UserInputBoundary }
  }
}

data rust_r1_verification_run_receipt_default: v2.std.leaf_model_verification.LeafModelVerificationRunReceipt = v2.std.leaf_model_verification.LeafModelVerificationRunReceipt {
  claim_id: leaf_model_claim_rust_r1_i32_surface_spelling,
  happy_verdict: verdict_fail(
    actual: outcome_rejected(d: rust_r1_pending_verification_diagnostic())
  ),
  falsification_verdict: verdict_fail(
    actual: outcome_rejected(d: rust_r1_pending_verification_diagnostic())
  )
}

data claim_rust_r1_verification_receipt_shape: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "language_model/rust_r1: verification receipt carriers happy + falsification verdict slots",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: rust_r1_claim_bool_atom(
    b: rust_r1_verification_run_receipt_default.claim_id == leaf_model_claim_rust_r1_i32_surface_spelling
  ),
  rhs: rust_r1_claim_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Boundary }
}

fn rust_r1_fixture_pair_carries_rust_dag_fact_anchors() -> Bool {
  rust_r1_fixture().surface_spelling_fact == ^rust_surface_spelling_i32
    && rust_r1_fixture().coercion_spelling_fact == ^rust_coercion_field_i32_spelling
}

data claim_rust_r1_surface_spelling_fact_ids_stable: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "language_model/rust_r1: fixture pair carries rust.dag i32 surface-spelling fact anchors",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: rust_r1_claim_bool_atom(b: rust_r1_fixture_pair_carries_rust_dag_fact_anchors()),
  rhs: rust_r1_claim_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Boundary }
}

data rust_r1_modeled_falsification_expectation: v2.std.leaf_model_verification.TargetCompileVerdict = v2.std.leaf_model_verification.TargetCompileRejected {
  diagnostic_code: ^target_diagnostic_e0308_type_mismatch
}
