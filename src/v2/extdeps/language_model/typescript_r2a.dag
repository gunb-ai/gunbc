module v2.test.language_model.typescript_r2a

fn typescript_r2a_claim_bool_atom(b: Bool) -> Node {
  match b {
    true => Node { kind: TypeNode { connective: Atom { identity: ^typescript_r2a_claim_bool_true } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => Node { kind: TypeNode { connective: Atom { identity: ^typescript_r2a_claim_bool_false } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

data claim_typescript_r2a_fixture_pair_wired: TestClaim = EqualsClaim {
  label: "language_model/typescript_r2a: fixture pair references ts_number_algebra_inhabitance_ts_facts_number",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: typescript_r2a_claim_bool_atom(b: true),
  rhs: typescript_r2a_claim_bool_atom(
    b: typescript_r2a_fixture().claim_id == leaf_model_claim_ts_r2a_number_algebra_operations
      && typescript_r2a_fixture().surface_spelling_fact == ts_number_algebra_inhabitance_ts_facts_number
      && typescript_r2a_fixture().encoding_spelling_fact == ts_number_algebra_inhabitance_ts_facts_number
      && typescript_r2a_fixture().happy.source == typescript_r2a_happy_fixture_source
      && typescript_r2a_fixture().falsification.fixture.source == typescript_r2a_falsification_fixture_source
  ),
  classification: TestClassification { tier: Tier1, layer: Boundary }
}
fn typescript_r2a_pending_verification_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^typescript_r2a_pending_verification_reason,
    at: Textual { file: ^typescript_r2a_pending_verification_reason, extent: WholeFile },
    correction: Unavailable { reason: UserInputBoundary }
  }
}

data typescript_r2a_verification_run_receipt_default: LeafModelVerificationRunReceipt = LeafModelVerificationRunReceipt {
  claim_id: leaf_model_claim_ts_r2a_number_algebra_operations,
  happy_verdict: verdict_fail(
    actual: outcome_rejected(d: typescript_r2a_pending_verification_diagnostic())
  ),
  falsification_verdict: verdict_fail(
    actual: outcome_rejected(d: typescript_r2a_pending_verification_diagnostic())
  )
}

data claim_typescript_r2a_verification_receipt_shape: TestClaim = EqualsClaim {
  label: "language_model/typescript_r2a: verification receipt carriers happy + falsification verdict slots",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: typescript_r2a_claim_bool_atom(
    b: typescript_r2a_verification_run_receipt_default.claim_id == leaf_model_claim_ts_r2a_number_algebra_operations
  ),
  rhs: typescript_r2a_claim_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Boundary }
}

data typescript_r2a_modeled_falsification_expectation: TargetTypeScriptCompileVerdict = TargetTypeScriptCompileRejected {
  diagnostic_code: ^target_diagnostic_ts2339_property_does_not_exist
}
