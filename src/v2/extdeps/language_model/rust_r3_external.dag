module v2.test.language_model.rust_r3_external

fn rust_r3_external_claim_bool_atom(b: Bool) -> Node {
  match b {
    true => v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^rust_r3_external_claim_bool_true } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^rust_r3_external_claim_bool_false } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

data claim_rust_r3_external_fixture_pair_wired: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "language_model/rust_r3_external: fixture pair references rust_atom_realization_symbol fact",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: rust_r3_external_claim_bool_atom(b: true),
  rhs: rust_r3_external_claim_bool_atom(
    b: rust_r3_external_fixture().claim_id == leaf_model_claim_rust_r3_external_symbol_projection
      && rust_r3_external_fixture().surface_spelling_fact == ^rust_atom_realization_symbol
      && rust_r3_external_fixture().happy.source == rust_r3_external_happy_fixture_source
      && rust_r3_external_fixture().falsification.fixture.source == rust_r3_external_falsification_fixture_source
  ),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Boundary }
}
fn rust_r3_external_pending_verification_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^rust_r3_external_pending_verification_reason,
    at: v2.std.diagnostic.Textual { file: ^rust_r3_external_pending_verification_reason, extent: WholeFile },
    correction: v2.std.diagnostic.Unavailable { reason: UserInputBoundary }
  }
}

data rust_r3_external_verification_run_receipt_default: v2.std.leaf_model_verification.LeafModelVerificationRunReceipt = v2.std.leaf_model_verification.LeafModelVerificationRunReceipt {
  claim_id: leaf_model_claim_rust_r3_external_symbol_projection,
  happy_verdict: verdict_fail(
    actual: outcome_rejected(d: rust_r3_external_pending_verification_diagnostic())
  ),
  falsification_verdict: verdict_fail(
    actual: outcome_rejected(d: rust_r3_external_pending_verification_diagnostic())
  )
}

data claim_rust_r3_external_verification_receipt_shape: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "language_model/rust_r3_external: verification receipt carriers happy + falsification verdict slots",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: rust_r3_external_claim_bool_atom(
    b: rust_r3_external_verification_run_receipt_default.claim_id == leaf_model_claim_rust_r3_external_symbol_projection
  ),
  rhs: rust_r3_external_claim_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Boundary }
}

data rust_r3_external_modeled_falsification_expectation: v2.std.leaf_model_verification.TargetCompileVerdict = v2.std.leaf_model_verification.TargetCompileRejected {
  diagnostic_code: ^target_diagnostic_e0423_expected_value_found_type
}
