module v2.test.language_model.go_r2b

fn go_r2b_claim_bool_atom(b: Bool) -> Node {
  match b {
    true => Node { kind: TypeNode { connective: Atom { identity: ^go_r2b_claim_bool_true } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => Node { kind: TypeNode { connective: Atom { identity: ^go_r2b_claim_bool_false } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

data claim_go_r2b_fixture_pair_wired: TestClaim = EqualsClaim {
  label: "language_model/go_r2b: fixture pair references go_facts_int64",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: go_r2b_claim_bool_atom(b: true),
  rhs: go_r2b_claim_bool_atom(
    b: go_r2b_fixture().claim_id == leaf_model_claim_go_r2b_int64_silent_overflow_truncates
      && go_r2b_fixture().fact_anchor == go_integer_facts_node(facts: go_facts_int64)
      && go_r2b_fixture().happy.source == go_r2b_happy_fixture_source
      && go_r2b_fixture().expected_happy_verdict == TargetRuntimeExerciseAccepted
      && go_r2b_fixture().falsification.fixture.source == go_r2b_falsification_fixture_source
      && go_r2b_fixture().falsification.expected_verdict == go_r2b_modeled_falsification_expectation
  ),
  classification: TestClassification { tier: Tier1, layer: Boundary }
}
fn go_r2b_pending_verification_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^go_r2b_pending_verification_reason,
    at: Textual { file: ^go_r2b_pending_verification_reason, extent: WholeFile },
    correction: Unavailable { reason: UserInputBoundary }
  }
}

data go_r2b_verification_run_receipt_default: LeafModelRuntimeVerificationRunReceipt = LeafModelRuntimeVerificationRunReceipt {
  claim_id: leaf_model_claim_go_r2b_int64_silent_overflow_truncates,
  happy_verdict: verdict_fail(
    actual: outcome_rejected(d: go_r2b_pending_verification_diagnostic())
  ),
  falsification_verdict: verdict_fail(
    actual: outcome_rejected(d: go_r2b_pending_verification_diagnostic())
  )
}

data claim_go_r2b_verification_receipt_shape: TestClaim = EqualsClaim {
  label: "language_model/go_r2b: verification receipt carriers happy + falsification verdict slots",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: go_r2b_claim_bool_atom(
    b: go_r2b_verification_run_receipt_default.claim_id == leaf_model_claim_go_r2b_int64_silent_overflow_truncates
  ),
  rhs: go_r2b_claim_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Boundary }
}

data go_r2b_modeled_falsification_expectation: TargetRuntimeExerciseVerdict = TargetRuntimeExerciseRejected {
  diagnostic_code: ^target_diagnostic_go_runtime_panic
}
