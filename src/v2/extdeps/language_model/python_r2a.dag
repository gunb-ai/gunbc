module v2.test.language_model.python_r2a

fn python_r2a_claim_bool_atom(b: Bool) -> Node {
  match b {
    true => v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^python_r2a_claim_bool_true } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^python_r2a_claim_bool_false } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

data claim_python_r2a_fixture_pair_wired: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "language_model/python_r2a: fixture pair references python_integer_algebra_inhabitance_python_facts_int",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: python_r2a_claim_bool_atom(b: true),
  rhs: python_r2a_claim_bool_atom(
    b: python_r2a_fixture().claim_id == leaf_model_claim_python_r2a_int_algebra_operations
      && python_r2a_fixture().surface_spelling_fact == python_integer_algebra_inhabitance_python_facts_int
      && python_r2a_fixture().encoding_spelling_fact == python_integer_algebra_inhabitance_python_facts_int
      && python_r2a_fixture().happy.source == python_r2a_happy_fixture_source
      && python_r2a_fixture().falsification.fixture.source == python_r2a_falsification_fixture_source
  ),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Boundary }
}
fn python_r2a_pending_verification_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^python_r2a_pending_verification_reason,
    at: v2.std.diagnostic.Textual { file: ^python_r2a_pending_verification_reason, extent: WholeFile },
    correction: v2.std.diagnostic.Unavailable { reason: UserInputBoundary }
  }
}

data python_r2a_verification_run_receipt_default: v2.std.leaf_model_verification.LeafModelVerificationRunReceipt = v2.std.leaf_model_verification.LeafModelVerificationRunReceipt {
  claim_id: leaf_model_claim_python_r2a_int_algebra_operations,
  happy_verdict: verdict_fail(
    actual: outcome_rejected(d: python_r2a_pending_verification_diagnostic())
  ),
  falsification_verdict: verdict_fail(
    actual: outcome_rejected(d: python_r2a_pending_verification_diagnostic())
  )
}

data claim_python_r2a_verification_receipt_shape: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "language_model/python_r2a: verification receipt carriers happy + falsification verdict slots",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: python_r2a_claim_bool_atom(
    b: python_r2a_verification_run_receipt_default.claim_id == leaf_model_claim_python_r2a_int_algebra_operations
  ),
  rhs: python_r2a_claim_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Boundary }
}

data python_r2a_modeled_falsification_expectation: v2.std.leaf_model_verification.TargetPythonExerciseVerdict = v2.std.leaf_model_verification.TargetPythonExecRejected {
  diagnostic_code: ^target_diagnostic_python_attribute_error_method_not_found
}
