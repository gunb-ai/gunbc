module v2.extdeps.typecheckers.mypy

import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.text { String }

type MypyConfig {
  mypy_version: String
  python_version: String
  strict: Bool
  show_error_codes: Bool
}

data mypy_profile_l1: MypyConfig = MypyConfig {
  mypy_version: "1.18.2",
  python_version: "3.11",
  strict: true,
  show_error_codes: true,
}

type MypyDiagnosticCode {
  code_id: Symbol
  code_name: String
}
data mypy_diagnostic_codes: List<MypyDiagnosticCode> = [
  MypyDiagnosticCode { code_id: ^mypy_diag_return_value, code_name: "return-value" },
]
