module v2.extdeps.formatters.gofmt

import v2.std.patch { ConfigPatchRecord, config_patch_layer }

type GofmtConfig {}

data gofmt_defaults: GofmtConfig = GofmtConfig {}

type GofmtConfigPatch = ConfigPatchRecord<GofmtConfig>

fn gofmt_layer(base: GofmtConfig, patch: GofmtConfigPatch) -> GofmtConfig {
  config_patch_layer(base: base, _patch: patch)
}
