// 🟡 gated — feature: formatter-cross-field-constraints — bind T-4.16 follow-on — dissolve-on-arrival: encode annotated formatter field dependencies as config-level refinements once dependent record predicates are available; forbidden: collapsing dependent fields into lossy enums or omitting companion fields required by the upstream formatter schema.
type ClangFormatConfig {
  access_modifier_offset: Int // upstream: Integer — LLVM default -2 is not a schema floor (ClangFormatStyleOptions#accessmodifieroffset)
  align_after_open_bracket: Bool
  align_array_of_structures: ClangFormatArrayInitializerAlignmentStyle
  align_consecutive_assignments: ClangFormatAlignConsecutiveStyle
  align_consecutive_bit_fields: ClangFormatAlignConsecutiveStyle
  align_consecutive_declarations: ClangFormatAlignConsecutiveStyle
  align_consecutive_macros: ClangFormatAlignConsecutiveStyle
  align_consecutive_short_case_statements: ClangFormatShortCaseStatementsAlignmentStyle
  align_consecutive_table_gen_breaking_dag_arg_colons: ClangFormatAlignConsecutiveStyle
  align_consecutive_table_gen_cond_operator_colons: ClangFormatAlignConsecutiveStyle
  align_consecutive_table_gen_definition_colons: ClangFormatAlignConsecutiveStyle
  align_escaped_newlines: ClangFormatEscapedNewlineAlignmentStyle
  align_operands: ClangFormatOperandAlignmentStyle
  align_trailing_comments: ClangFormatTrailingCommentsAlignmentStyle
  allow_all_arguments_on_next_line: Bool
  allow_all_constructor_initializers_on_next_line: Bool
  allow_all_parameters_of_declaration_on_next_line: Bool
  allow_break_before_noexcept_specifier: ClangFormatBreakBeforeNoexceptSpecifierStyle
  allow_break_before_qt_property: Bool
  allow_short_blocks_on_a_single_line: ClangFormatShortBlockStyle
  allow_short_case_expression_on_a_single_line: Bool
  allow_short_case_labels_on_a_single_line: Bool
  allow_short_compound_requirement_on_a_single_line: Bool
  allow_short_enums_on_a_single_line: Bool
  allow_short_functions_on_a_single_line: ClangFormatShortFunctionStyle
  allow_short_if_statements_on_a_single_line: ClangFormatShortIfStyle
  allow_short_lambdas_on_a_single_line: ClangFormatShortLambdaStyle
  allow_short_loops_on_a_single_line: Bool
  allow_short_namespaces_on_a_single_line: Bool
  allow_short_record_on_a_single_line: ClangFormatShortRecordStyle
  always_break_after_definition_return_type: ClangFormatDefinitionReturnTypeBreakingStyle
  always_break_after_return_type: ClangFormatReturnTypeBreakingStyle
  always_break_before_multiline_strings: Bool
  always_break_template_declarations: ClangFormatBreakTemplateDeclarationsStyle
  based_on_style: ClangFormatStyle
  bin_pack_arguments: Bool
  bin_pack_long_braced_list: Bool
  bin_pack_parameters: ClangFormatBinPackParametersStyle
  bit_field_colon_spacing: ClangFormatBitFieldColonSpacingStyle
  braced_initializer_indent_width: Int // upstream: negative/unset falls back to ContinuationIndentWidth
  brace_wrapping: ClangFormatBraceWrappingFlags
  break_adjacent_string_literals: Bool
  break_after_attributes: ClangFormatAttributeBreakingStyle
  break_after_java_field_annotations: Bool
  break_after_open_bracket_braced_list: Bool
  break_after_open_bracket_function: Bool
  break_after_open_bracket_if: Bool
  break_after_open_bracket_loop: Bool
  break_after_open_bracket_switch: Bool
  break_after_return_type: ClangFormatReturnTypeBreakingStyle
  break_arrays: Bool
  break_before_binary_operators: ClangFormatBinaryOperatorStyle
  break_before_braces: ClangFormatBraceBreakingStyle
  break_before_close_bracket_braced_list: Bool
  break_before_close_bracket_function: Bool
  break_before_close_bracket_if: Bool
  break_before_close_bracket_loop: Bool
  break_before_close_bracket_switch: Bool
  break_before_concept_declarations: ClangFormatBreakBeforeConceptDeclarationsStyle
  break_before_inline_asm_colon: ClangFormatBreakBeforeInlineASMColonStyle
  break_before_return_type: ClangFormatBreakBeforeReturnTypeStyle
  break_before_template_closer: Bool
  break_before_ternary_operators: Bool
  break_binary_operations: ClangFormatBreakBinaryOperationsOptions
  break_constructor_initializers: ClangFormatBreakConstructorInitializersStyle
  break_function_declaration_parameters: Bool
  break_function_definition_parameters: Bool
  break_inheritance_list: ClangFormatBreakInheritanceListStyle
  break_string_literals: Bool
  break_template_declarations: ClangFormatBreakTemplateDeclarationsStyle
  column_limit: Outcome<NonNegativeInt>
  comment_pragmas: String
  compact_namespaces: Bool
  constructor_initializer_all_on_one_line_or_one_per_line: Bool
  constructor_initializer_indent_width: Outcome<NonNegativeInt>
  continuation_indent_width: Outcome<NonNegativeInt>
  cpp11_braced_list_style: ClangFormatBracedListStyle
  derive_line_ending: Bool
  derive_pointer_alignment: Bool
  disable_format: Bool
  empty_line_after_access_modifier: ClangFormatEmptyLineAfterAccessModifierStyle
  empty_line_before_access_modifier: ClangFormatEmptyLineBeforeAccessModifierStyle
  enum_trailing_comma: ClangFormatEnumTrailingCommaStyle
  experimental_auto_detect_bin_packing: Bool
  fix_namespace_comments: Bool
  include_blocks: ClangFormatIncludeBlocksStyle
  include_is_main_regex: String
  include_is_main_source_regex: String
  indent_access_modifiers: Bool
  indent_case_blocks: Bool
  indent_case_labels: Bool
  indent_export_block: Bool
  indent_extern_block: ClangFormatIndentExternBlockStyle
  indent_goto_labels: ClangFormatIndentGotoLabelStyle
