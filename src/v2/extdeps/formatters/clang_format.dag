data clang_format_defaults: ClangFormatConfig = ClangFormatConfig {
  access_modifier_offset: -2,
  align_after_open_bracket: true,
  align_array_of_structures: ClangFormatArrayAlignNone,
  align_consecutive_assignments: ClangFormatAlignConsecutiveStyle { enabled: false, across_empty_lines: false, across_comments: false, align_compound: false, align_function_declarations: false, align_function_pointers: false, enum_assignments: false, pad_operators: false },
  align_consecutive_bit_fields: ClangFormatAlignConsecutiveStyle { enabled: false, across_empty_lines: false, across_comments: false, align_compound: false, align_function_declarations: false, align_function_pointers: false, enum_assignments: false, pad_operators: false },
  align_consecutive_declarations: ClangFormatAlignConsecutiveStyle { enabled: false, across_empty_lines: false, across_comments: false, align_compound: false, align_function_declarations: false, align_function_pointers: false, enum_assignments: false, pad_operators: false },
  align_consecutive_macros: ClangFormatAlignConsecutiveStyle { enabled: false, across_empty_lines: false, across_comments: false, align_compound: false, align_function_declarations: false, align_function_pointers: false, enum_assignments: false, pad_operators: false },
  align_consecutive_short_case_statements: ClangFormatShortCaseStatementsAlignmentStyle { enabled: false, across_empty_lines: false, across_comments: false, align_case_arrows: false, align_case_colons: false },
  align_consecutive_table_gen_breaking_dag_arg_colons: ClangFormatAlignConsecutiveStyle { enabled: false, across_empty_lines: false, across_comments: false, align_compound: false, align_function_declarations: false, align_function_pointers: false, enum_assignments: false, pad_operators: false },
  align_consecutive_table_gen_cond_operator_colons: ClangFormatAlignConsecutiveStyle { enabled: false, across_empty_lines: false, across_comments: false, align_compound: false, align_function_declarations: false, align_function_pointers: false, enum_assignments: false, pad_operators: false },
  align_consecutive_table_gen_definition_colons: ClangFormatAlignConsecutiveStyle { enabled: false, across_empty_lines: false, across_comments: false, align_compound: false, align_function_declarations: false, align_function_pointers: false, enum_assignments: false, pad_operators: false },
  align_escaped_newlines: ClangFormatEscapedNewlineRight,
  align_operands: ClangFormatOperandAlign,
  align_trailing_comments: ClangFormatTrailingCommentsAlignmentStyle { kind: ClangFormatTrailingCommentsAlways, over_empty_lines: non_negative_int_authoritative_literal(value: 0), align_pp_and_not_pp: false },
  allow_all_arguments_on_next_line: true,
  allow_all_constructor_initializers_on_next_line: true,
  allow_all_parameters_of_declaration_on_next_line: true,
  allow_break_before_noexcept_specifier: ClangFormatNoexceptNever,
  allow_break_before_qt_property: false,
  allow_short_blocks_on_a_single_line: ClangFormatShortBlockNever,
  allow_short_case_expression_on_a_single_line: false,
  allow_short_case_labels_on_a_single_line: false,
  allow_short_compound_requirement_on_a_single_line: true,
  allow_short_enums_on_a_single_line: true,
  allow_short_functions_on_a_single_line: ClangFormatShortFunctionAll,
  allow_short_if_statements_on_a_single_line: ClangFormatShortIfNever,
  allow_short_lambdas_on_a_single_line: ClangFormatShortLambdaAll,
  allow_short_loops_on_a_single_line: false,
  allow_short_namespaces_on_a_single_line: false,
  allow_short_record_on_a_single_line: ClangFormatShortRecordNever,
  always_break_after_definition_return_type: ClangFormatDefinitionReturnTypeNone,
  always_break_after_return_type: ClangFormatReturnTypeNone,
  always_break_before_multiline_strings: false,
  always_break_template_declarations: ClangFormatTemplateDeclarationsMultiLine,
  based_on_style: ClangFormatStyleLLVM,
  bin_pack_arguments: true,
  bin_pack_long_braced_list: true,
  bin_pack_parameters: ClangFormatBinPackParametersBinPack,
  bit_field_colon_spacing: ClangFormatBitFieldColonBoth,
  braced_initializer_indent_width: 2,
  brace_wrapping: ClangFormatBraceWrappingFlags { after_case_label: false, after_class: false, after_control_statement: ClangFormatBraceWrapAfterControlNever, after_enum: false, after_extern_block: false, after_function: false, after_namespace: false, after_obj_c_declaration: false, after_struct: false, after_union: false, before_catch: false, before_else: false, before_lambda_body: false, before_while: false, indent_braces: false, split_empty_function: true, split_empty_record: true, split_empty_namespace: true },
  break_adjacent_string_literals: true,
  break_after_attributes: ClangFormatAttributeBreakNever,
  break_after_java_field_annotations: false,
  break_after_open_bracket_braced_list: false,
  break_after_open_bracket_function: false,
  break_after_open_bracket_if: false,
  break_after_open_bracket_loop: false,
  break_after_open_bracket_switch: false,
  break_after_return_type: ClangFormatReturnTypeNone,
  break_arrays: true,
  break_before_binary_operators: ClangFormatBinaryOperatorNone,
  break_before_braces: ClangFormatBraceAttach,
  break_before_close_bracket_braced_list: false,
  break_before_close_bracket_function: false,
  break_before_close_bracket_if: false,
  break_before_close_bracket_loop: false,
  break_before_close_bracket_switch: false,
  break_before_concept_declarations: ClangFormatConceptBreakAlways,
  break_before_inline_asm_colon: ClangFormatInlineAsmColonOnlyMultiline,
  break_before_return_type: ClangFormatBeforeReturnTypeNone,
  break_before_template_closer: false,
  break_before_ternary_operators: true,
  break_binary_operations: ClangFormatBreakBinaryOperationsOptions { default_style: ClangFormatBreakBinaryNever, per_operator: [] },
  break_constructor_initializers: ClangFormatConstructorInitializersBeforeColon,
  break_function_declaration_parameters: false,
  break_function_definition_parameters: false,
  break_inheritance_list: ClangFormatInheritanceBeforeColon,
  break_string_literals: true,
  break_template_declarations: ClangFormatTemplateDeclarationsMultiLine,
  column_limit: non_negative_int_authoritative_literal(value: 80),
  comment_pragmas: "^ IWYU pragma:",
  compact_namespaces: false,
  constructor_initializer_all_on_one_line_or_one_per_line: false,
  constructor_initializer_indent_width: non_negative_int_authoritative_literal(value: 4),
  continuation_indent_width: non_negative_int_authoritative_literal(value: 4),
  cpp11_braced_list_style: ClangFormatBracedListFunctionCall,
  derive_line_ending: true,
  derive_pointer_alignment: false,
  disable_format: false,
  empty_line_after_access_modifier: ClangFormatEmptyLineAfterAccessNever,
  empty_line_before_access_modifier: ClangFormatEmptyLineBeforeAccessLogicalBlock,
  enum_trailing_comma: ClangFormatEnumTrailingCommaLeave,
  experimental_auto_detect_bin_packing: false,
  fix_namespace_comments: true,
  include_blocks: ClangFormatIncludeBlocksPreserve,
  include_is_main_regex: "(Test)?$",
  include_is_main_source_regex: "",
  indent_access_modifiers: false,
  indent_case_blocks: false,
  indent_case_labels: false,
  indent_export_block: true,
  indent_extern_block: ClangFormatIndentExternAfterExternBlock,
  indent_goto_labels: ClangFormatIndentGotoNoIndent,
  indent_pp_directives: ClangFormatPPDirectiveIndentNone,
  indent_requires_clause: true,
  indent_width: non_negative_int_authoritative_literal(value: 2),
  indent_wrapped_function_names: false,
  insert_braces: false,
  insert_newline_at_eof: false,
  insert_trailing_commas: ClangFormatTrailingCommaNone,
  integer_literal_separator: ClangFormatIntegerLiteralSeparatorStyle { binary: 0, binary_min_digits_insert: non_negative_int_authoritative_literal(value: 0), binary_max_digits_remove: non_negative_int_authoritative_literal(value: 0), decimal: 0, decimal_min_digits_insert: non_negative_int_authoritative_literal(value: 0), decimal_max_digits_remove: non_negative_int_authoritative_literal(value: 0), hex: 0, hex_min_digits_insert: non_negative_int_authoritative_literal(value: 0), hex_max_digits_remove: non_negative_int_authoritative_literal(value: 0) },
  java_script_quotes: ClangFormatJavaScriptQuoteLeave,
  java_script_wrap_imports: true,
  keep_empty_lines: ClangFormatKeepEmptyLinesStyle { at_end_of_file: false, at_start_of_block: true, at_start_of_file: true },
  keep_empty_lines_at_eof: false,
  keep_empty_lines_at_the_start_of_blocks: true,
  keep_form_feed: false,
  lambda_body_indentation: ClangFormatLambdaBodySignature,
  language: ClangFormatLanguageNone,
  line_ending: ClangFormatLineEndingDeriveLF,
  macro_block_begin: "",
  macro_block_end: "",
  main_include_char: ClangFormatMainIncludeAny,
  max_empty_lines_to_keep: non_negative_int_authoritative_literal(value: 1),
  namespace_indentation: ClangFormatNamespaceIndentNone,
  numeric_literal_case: ClangFormatNumericLiteralCaseStyle { exponent_letter: ClangFormatNumericLiteralLeave, hex_digit: ClangFormatNumericLiteralLeave, prefix: ClangFormatNumericLiteralLeave, suffix: ClangFormatNumericLiteralLeave },
  obj_c_bin_pack_protocol_list: ClangFormatBinPackAuto,
  obj_c_block_indent_width: non_negative_int_authoritative_literal(value: 2),
  obj_c_break_before_nested_block_param: true,
  obj_c_space_after_method_declaration_prefix: false,
  obj_c_space_after_property: false,
  obj_c_space_before_protocol_list: true,
  one_line_format_off_regex: "",
  pack_arguments: ClangFormatPackArgumentsBinPack,
  pack_constructor_initializers: ClangFormatPackConstructorBinPack,
  pack_parameters: ClangFormatBinPackParametersBinPack,
  penalty_break_assignment: non_negative_int_authoritative_literal(value: 2),
  penalty_break_before_first_call_parameter: non_negative_int_authoritative_literal(value: 19),
  penalty_break_before_member_access: non_negative_int_authoritative_literal(value: 150),
  penalty_break_comment: non_negative_int_authoritative_literal(value: 300),
  penalty_break_first_less_less: non_negative_int_authoritative_literal(value: 120),
  penalty_break_open_parenthesis: non_negative_int_authoritative_literal(value: 0),
  penalty_break_scope_resolution: non_negative_int_authoritative_literal(value: 500),
  penalty_break_string: non_negative_int_authoritative_literal(value: 1000),
  penalty_break_template_declaration: non_negative_int_authoritative_literal(value: 10),
  penalty_excess_character: non_negative_int_authoritative_literal(value: 1000000),
  penalty_indented_whitespace: non_negative_int_authoritative_literal(value: 0),
  penalty_return_type_on_its_own_line: non_negative_int_authoritative_literal(value: 60),
  pointer_alignment: ClangFormatPointerRight,
  pp_indent_width: at_least_minus_one_int_authoritative_literal(value: -1),
  qualifier_alignment: ClangFormatQualifierLeave,
  qualifier_order: [],
  reference_alignment: ClangFormatReferencePointer,
  reflow_comments: ClangFormatReflowCommentsAlways,
  remove_braces_llvm: false,
  remove_empty_lines_in_unwrapped_lines: false,
  remove_parentheses: ClangFormatRemoveParenthesesLeave,
  remove_semicolon: false,
  requires_clause_position: ClangFormatRequiresClauseOwnLine,
  requires_expression_indentation: ClangFormatRequiresExpressionOuterScope,
  separate_definition_blocks: ClangFormatSeparateDefinitionLeave,
  short_namespace_lines: non_negative_int_authoritative_literal(value: 1),
  skip_macro_definition_body: false,
  sort_includes: ClangFormatSortIncludesOptions { enabled: true, ignore_case: false, ignore_extension: false },
  sort_java_static_import: ClangFormatSortJavaStaticBefore,
  sort_using_declarations: ClangFormatSortUsingLexicographic,
  space_after_c_style_cast: false,
  space_after_logical_not: false,
  space_after_operator_keyword: false,
  space_after_template_keyword: true,
  space_around_pointer_qualifiers: ClangFormatSpaceAroundPointerQualifiersDefault,
  space_before_assignment_operators: true,
  space_before_case_colon: false,
  space_before_cpp11_braced_list: false,
  space_before_ctor_initializer_colon: true,
  space_before_enum_underlying_type_colon: true,
  space_before_inheritance_colon: true,
  space_before_json_colon: false,
  space_before_parens: ClangFormatSpaceBeforeParensControlStatements,
  space_before_parens_options: ClangFormatSpaceBeforeParensCustom { after_control_statements: true, after_foreach_macros: true, after_function_declaration_name: false, after_function_definition_name: false, after_if_macros: true, after_not: false, after_overloaded_operator: false, after_placement_operator: true, after_requires_in_clause: false, after_requires_in_expression: false, before_non_empty_parentheses: false },
  space_before_range_based_for_loop_colon: true,
  space_before_square_brackets: false,
  space_in_empty_block: false,
  space_in_empty_braces: ClangFormatSpaceInEmptyBracesNever,
  space_in_empty_parentheses: false,
  spaces_before_trailing_comments: non_negative_int_authoritative_literal(value: 1),
  spaces_in_angles: ClangFormatSpacesInAnglesNever,
  spaces_in_conditional_statement: false,
  spaces_in_container_literals: true,
  spaces_in_c_style_cast_parentheses: false,
  spaces_in_line_comment_prefix: ClangFormatSpacesInLineComment { minimum: non_negative_int_authoritative_literal(value: 1), maximum: at_least_minus_one_int_authoritative_literal(value: -1) },
  spaces_in_parens: ClangFormatSpacesInParensNever,
  spaces_in_parens_options: ClangFormatSpacesInParensCustom { except_double_parentheses: false, in_conditional_statements: false, in_c_style_casts: false, in_empty_parentheses: false, other: false },
  spaces_in_parentheses: false,
  spaces_in_square_brackets: false,
  standard: ClangFormatStandardLatest,
  table_gen_break_inside_dag_arg: ClangFormatDAGArgDontBreak,
  tab_width: non_negative_int_authoritative_literal(value: 8),
  use_crlf: false,
  use_tab: ClangFormatUseTabNever,
  verilog_break_between_instance_ports: false,
  wrap_namespace_body_with_empty_lines: ClangFormatWrapNamespaceBodyWithEmptyLinesNever,
}


type ClangFormatConfigPatch = ConfigPatchRecord<ClangFormatConfig>


fn clang_format_layer(base: ClangFormatConfig, patch: ClangFormatConfigPatch) -> ClangFormatConfig {
  config_patch_layer(base: base, patch: patch)
}
