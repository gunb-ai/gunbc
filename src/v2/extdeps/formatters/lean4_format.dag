module v2.extdeps.formatters.lean4_format


type Lean4NameValue
type Lean4SyntaxValue
type Lean4NatValue = v2.std.nat.Nat
fn lean4_format_authoritative_locus() -> v2.std.diagnostic.Locus {
  v2.std.diagnostic.port_locus(port: ^lean4_format_authoritative_locus_port)
}

fn lean4_nat_succ(n: v2.std.nat.Nat) -> v2.std.nat.Nat {
  v2.std.nat.Succ { prev: n }
}

fn lean4_nat_add_ten(n: v2.std.nat.Nat) -> v2.std.nat.Nat {
  lean4_nat_succ(
    n: lean4_nat_succ(
      n: lean4_nat_succ(
        n: lean4_nat_succ(
          n: lean4_nat_succ(
            n: lean4_nat_succ(
              n: lean4_nat_succ(
                n: lean4_nat_succ(
                  n: lean4_nat_succ(
                    n: lean4_nat_succ(n: n)
                  )
                )
              )
            )
          )
        )
      )
    )
  )
}

fn lean4_nat_max_materializable() -> Int {
  4096
}

fn lean4_nat_catalog_format_width() -> v2.std.nat.Nat {
  lean4_nat_add_ten(
    n: lean4_nat_add_ten(
      n: lean4_nat_add_ten(
        n: lean4_nat_add_ten(
          n: lean4_nat_add_ten(
            n: lean4_nat_add_ten(
              n: lean4_nat_add_ten(
                n: lean4_nat_add_ten(
                  n: lean4_nat_add_ten(
                    n: lean4_nat_add_ten(
                      n: lean4_nat_add_ten(n: lean4_nat_add_ten(n: v2.std.nat.Zero))
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
}

fn lean4_nat_catalog_format_indent() -> v2.std.nat.Nat {
  lean4_nat_succ(n: lean4_nat_succ(n: v2.std.nat.Zero))
}

fn lean4_nat_peano_from_non_negative_int(value: Int) -> v2.std.nat.Nat {
  if value == 0 {
    v2.std.nat.Zero
  } else {
    v2.std.nat.Succ { prev: lean4_nat_peano_from_non_negative_int(value: value - 1) }
  }
}

fn lean4_nat_materialize_non_negative_int(value: Int, at: v2.std.diagnostic.Locus) -> v2.std.diagnostic.Outcome<v2.std.nat.Nat> {
  if value < 0 {
    v2.std.diagnostic.Rejected {
      diagnostics: v2.std.diagnostic.diagnostics_singleton(
        d: v2.std.diagnostic.Diagnostic {
          reason: ^lean4_nat_out_of_range,
          at: at,
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.UserInputBoundary }
        }
      )
    }
  } else if value > lean4_nat_max_materializable() {
    v2.std.diagnostic.Rejected {
      diagnostics: v2.std.diagnostic.diagnostics_singleton(
        d: v2.std.diagnostic.Diagnostic {
          reason: ^lean4_nat_exceeds_ceiling,
          at: at,
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.UserInputBoundary }
        }
      )
    }
  } else {
    v2.std.diagnostic.Accepted {
      value: lean4_nat_peano_from_non_negative_int(value: value),
      diagnostics: v2.std.diagnostic.None
    }
  }
}

fn make_lean4_nat_value(value: Int, at: v2.std.diagnostic.Locus) -> v2.std.diagnostic.Outcome<Lean4NatValue> {
  if value < 0 {
    v2.std.diagnostic.Rejected {
      diagnostics: v2.std.diagnostic.diagnostics_singleton(
        d: v2.std.diagnostic.Diagnostic {
          reason: ^lean4_nat_out_of_range,
          at: at,
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.UserInputBoundary }
        }
      )
    }
  } else if value > lean4_nat_max_materializable() {
    v2.std.diagnostic.Rejected {
      diagnostics: v2.std.diagnostic.diagnostics_singleton(
        d: v2.std.diagnostic.Diagnostic {
          reason: ^lean4_nat_exceeds_ceiling,
          at: at,
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.UserInputBoundary }
        }
      )
    }
  } else if value == 2 {
    v2.std.diagnostic.Accepted { value: lean4_nat_catalog_format_indent(), diagnostics: v2.std.diagnostic.None }
  } else if value == 120 {
    v2.std.diagnostic.Accepted { value: lean4_nat_catalog_format_width(), diagnostics: v2.std.diagnostic.None }
  } else {
    lean4_nat_materialize_non_negative_int(value: value, at: at)
  }
}

fn lean4_nat_authoritative_literal(value: Int) -> v2.std.diagnostic.Outcome<Lean4NatValue> {
  make_lean4_nat_value(value: value, at: lean4_format_authoritative_locus())
}

type Lean4OptionValue
  = Lean4StringOption { value: String }
  | Lean4BoolOption { value: Bool }
  | Lean4NameOption { value: Lean4NameValue }
  | Lean4NatOption { value: Lean4NatValue }
  | Lean4IntOption { value: Int }
  | Lean4SyntaxOption { value: Lean4SyntaxValue }

type Lean4OptionAssignment {
  name: String
  value: Lean4OptionValue
}

type Lean4FormatConfig {
  format_width: v2.std.diagnostic.Outcome<Lean4NatValue>
  format_indent: v2.std.diagnostic.Outcome<Lean4NatValue>
  format_unicode: Bool
  pp_oneline: Bool
  lake_lean_options: List<Lean4OptionAssignment>
}

data lean4_format_defaults: Lean4FormatConfig = Lean4FormatConfig {
  format_width: lean4_nat_authoritative_literal(value: 120),
  format_indent: lean4_nat_authoritative_literal(value: 2),
  format_unicode: true,
  pp_oneline: false,
  lake_lean_options: [],
}

type Lean4FormatConfigPatch = v2.std.patch.ConfigPatchRecord<Lean4FormatConfig>

fn lean4_format_layer(base: Lean4FormatConfig, patch: Lean4FormatConfigPatch) -> Lean4FormatConfig {
  v2.std.patch.config_patch_layer(base: base, patch: patch)
}
