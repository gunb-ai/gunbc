// src/v2/extdeps/formatters/prettier.dag
// Scope: Prettier configuration file model (.prettierrc / package.json "prettier").
// Status: T-4.16 scaffold — Prettier stable config/options docs (v3 defaults).
// Anchor: https://prettier.io/docs/configuration
//         https://prettier.io/docs/options

module v2.extdeps.formatters.prettier

import v2.std.collection { List }
import v2.std.diagnostic { Outcome }
import v2.std.patch { ConfigPatchRecord, FieldPatch, apply_field_patch, config_patch_layer }
import v2.std.refinement {
  NonNegativeInt,
  non_negative_int_authoritative_literal,
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type PrettierTrailingComma
  = PrettierTrailingCommaAll
  | PrettierTrailingCommaEs5
  | PrettierTrailingCommaNone


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type PrettierQuoteProps
  = PrettierQuotePropsAsNeeded
  | PrettierQuotePropsConsistent
  | PrettierQuotePropsPreserve


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type PrettierArrowParens
  = PrettierArrowParensAlways
  | PrettierArrowParensAvoid


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type PrettierProseWrap
  = PrettierProseWrapAlways
  | PrettierProseWrapNever
  | PrettierProseWrapPreserve


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type PrettierHtmlWhitespaceSensitivity
  = PrettierHtmlWhitespaceCss
  | PrettierHtmlWhitespaceStrict
  | PrettierHtmlWhitespaceIgnore


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type PrettierEndOfLine
  = PrettierEndOfLineLf
  | PrettierEndOfLineCrlf
  | PrettierEndOfLineCr
  | PrettierEndOfLineAuto


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type PrettierEmbeddedLanguageFormatting
  = PrettierEmbeddedLanguageAuto
  | PrettierEmbeddedLanguageOff


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type PrettierObjectWrap
  = PrettierObjectWrapPreserve
  | PrettierObjectWrapCollapse


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type PrettierExperimentalOperatorPosition
  = PrettierOperatorPositionStart
  | PrettierOperatorPositionEnd


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type PrettierParser
  = PrettierParserBabel
  | PrettierParserBabelFlow
  | PrettierParserBabelTs
  | PrettierParserFlow
  | PrettierParserTypescript
  | PrettierParserEspree
  | PrettierParserMeriyah
  | PrettierParserAcorn
  | PrettierParserCss
  | PrettierParserScss
  | PrettierParserLess
  | PrettierParserJson
  | PrettierParserJson5
  | PrettierParserJsonc
  | PrettierParserJsonStringify
  | PrettierParserGraphql
  | PrettierParserMarkdown
  | PrettierParserMdx
  | PrettierParserHtml
  | PrettierParserVue
  | PrettierParserAngular
  | PrettierParserLwc
  | PrettierParserMjml
  | PrettierParserYaml



type PrettierFormattingOptions {
  print_width: Outcome<NonNegativeInt> // upstream range start 0 (prettier core-options.evaluate.js)
  tab_width: Outcome<NonNegativeInt> // upstream range start 0 (prettier core-options.evaluate.js)
  use_tabs: Bool
  semi: Bool
  single_quote: Bool
  quote_props: PrettierQuoteProps
  jsx_single_quote: Bool
  trailing_comma: PrettierTrailingComma
  bracket_spacing: Bool
  object_wrap: PrettierObjectWrap
  bracket_same_line: Bool
  arrow_parens: PrettierArrowParens
  require_pragma: Bool
  insert_pragma: Bool
  check_ignore_pragma: Bool
  prose_wrap: PrettierProseWrap
  html_whitespace_sensitivity: PrettierHtmlWhitespaceSensitivity
  vue_indent_script_and_style: Bool
  single_attribute_per_line: Bool
  end_of_line: PrettierEndOfLine
  embedded_language_formatting: PrettierEmbeddedLanguageFormatting
  experimental_ternaries: Bool
  experimental_operator_position: PrettierExperimentalOperatorPosition
}


// 🟡 gated — feature:prettier-override-options-hand-mirror — bind T-4.16 follow-on — dissolve-on-arrival: project PrettierOverrideOptions from PrettierFormattingOptions field set plus parser override field (extra `parser` beyond formatting options; not derivable from `ConfigPatchRecord<PrettierFormattingOptions>` alone).
type PrettierOverrideOptions {
  parser: FieldPatch<PrettierParser>
  print_width: FieldPatch<Outcome<NonNegativeInt>>
  tab_width: FieldPatch<Outcome<NonNegativeInt>>
  use_tabs: FieldPatch<Bool>
  semi: FieldPatch<Bool>
  single_quote: FieldPatch<Bool>
  quote_props: FieldPatch<PrettierQuoteProps>
  jsx_single_quote: FieldPatch<Bool>
  trailing_comma: FieldPatch<PrettierTrailingComma>
  bracket_spacing: FieldPatch<Bool>
  object_wrap: FieldPatch<PrettierObjectWrap>
  bracket_same_line: FieldPatch<Bool>
  arrow_parens: FieldPatch<PrettierArrowParens>
  require_pragma: FieldPatch<Bool>
  insert_pragma: FieldPatch<Bool>
  check_ignore_pragma: FieldPatch<Bool>
  prose_wrap: FieldPatch<PrettierProseWrap>
  html_whitespace_sensitivity: FieldPatch<PrettierHtmlWhitespaceSensitivity>
  vue_indent_script_and_style: FieldPatch<Bool>
  single_attribute_per_line: FieldPatch<Bool>
  end_of_line: FieldPatch<PrettierEndOfLine>
  embedded_language_formatting: FieldPatch<PrettierEmbeddedLanguageFormatting>
  experimental_ternaries: FieldPatch<Bool>
  experimental_operator_position: FieldPatch<PrettierExperimentalOperatorPosition>
}


type PrettierOverrideEntry {
  files: List<String>
  exclude_files: List<String>
  options: PrettierOverrideOptions
}


type PrettierConfig {
  options: PrettierFormattingOptions
  overrides: List<PrettierOverrideEntry>
}


data prettier_default_formatting: PrettierFormattingOptions = PrettierFormattingOptions {
  print_width: non_negative_int_authoritative_literal(value: 80),
  tab_width: non_negative_int_authoritative_literal(value: 2),
  use_tabs: false,
  semi: true,
  single_quote: false,
  quote_props: PrettierQuotePropsAsNeeded,
  jsx_single_quote: false,
  trailing_comma: PrettierTrailingCommaAll,
  bracket_spacing: true,
  object_wrap: PrettierObjectWrapPreserve,
  bracket_same_line: false,
  arrow_parens: PrettierArrowParensAlways,
  require_pragma: false,
  insert_pragma: false,
  check_ignore_pragma: false,
  prose_wrap: PrettierProseWrapPreserve,
  html_whitespace_sensitivity: PrettierHtmlWhitespaceCss,
  vue_indent_script_and_style: false,
  single_attribute_per_line: false,
  end_of_line: PrettierEndOfLineLf,
  embedded_language_formatting: PrettierEmbeddedLanguageAuto,
  experimental_ternaries: false,
  experimental_operator_position: PrettierOperatorPositionEnd,
}


data prettier_defaults: PrettierConfig = PrettierConfig {
  options: prettier_default_formatting,
  overrides: [],
}


type PrettierFormattingOptionsPatch = ConfigPatchRecord<PrettierFormattingOptions>


fn apply_prettier_formatting_options_patch(base: PrettierFormattingOptions, patch: PrettierFormattingOptionsPatch) -> PrettierFormattingOptions {
  config_patch_layer(base: base, patch: patch)
}


// 🟡 gated — feature:prettier-nested-config-patch — bind T-4.16 follow-on — dissolve-on-arrival: model `options` as `FieldPatch<PrettierFormattingOptions>` (or nested patch substrate) so `PrettierConfigPatch = ConfigPatchRecord<PrettierConfig>`; until then hand `prettier_layer` composes nested `PrettierFormattingOptionsPatch` + scalar `overrides`.
type PrettierConfigPatch {
  options: PrettierFormattingOptionsPatch
  overrides: FieldPatch<List<PrettierOverrideEntry>>
}


fn prettier_layer(base: PrettierConfig, patch: PrettierConfigPatch) -> PrettierConfig {
  PrettierConfig {
    options: apply_prettier_formatting_options_patch(base: base.options, patch: patch.options),
    overrides: apply_field_patch(base: base.overrides, patch: patch.overrides),
  }
}
