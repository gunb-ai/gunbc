module v2.extdeps.formatters.prettier


type PrettierTrailingComma
  = PrettierTrailingCommaAll
  | PrettierTrailingCommaEs5
  | PrettierTrailingCommaNone

type PrettierQuoteProps
  = PrettierQuotePropsAsNeeded
  | PrettierQuotePropsConsistent
  | PrettierQuotePropsPreserve

type PrettierArrowParens
  = PrettierArrowParensAlways
  | PrettierArrowParensAvoid

type PrettierProseWrap
  = PrettierProseWrapAlways
  | PrettierProseWrapNever
  | PrettierProseWrapPreserve

type PrettierHtmlWhitespaceSensitivity
  = PrettierHtmlWhitespaceCss
  | PrettierHtmlWhitespaceStrict
  | PrettierHtmlWhitespaceIgnore

type PrettierEndOfLine
  = PrettierEndOfLineLf
  | PrettierEndOfLineCrlf
  | PrettierEndOfLineCr
  | PrettierEndOfLineAuto

type PrettierEmbeddedLanguageFormatting
  = PrettierEmbeddedLanguageAuto
  | PrettierEmbeddedLanguageOff

type PrettierObjectWrap
  = PrettierObjectWrapPreserve
  | PrettierObjectWrapCollapse

type PrettierExperimentalOperatorPosition
  = PrettierOperatorPositionStart
  | PrettierOperatorPositionEnd

type PrettierParser
  = PrettierParserBabel
  | PrettierParserBabelFlow
  | PrettierParserBabelTs
  | PrettierParserFlow
  | PrettierParserTypescript
  | PrettierParserEspree
  | PrettierParserMeriyah
  | PrettierParserAcorn
  | PrettierParserCss
  | PrettierParserScss
  | PrettierParserLess
  | PrettierParserJson
  | PrettierParserJson5
  | PrettierParserJsonc
  | PrettierParserJsonStringify
  | PrettierParserGraphql
  | PrettierParserMarkdown
  | PrettierParserMdx
  | PrettierParserHtml
  | PrettierParserVue
  | PrettierParserAngular
  | PrettierParserLwc
  | PrettierParserMjml
  | PrettierParserYaml

type PrettierFormattingOptions {
  print_width: v2.std.diagnostic.Outcome<v2.std.refinement.NonNegativeInt>
  tab_width: v2.std.diagnostic.Outcome<v2.std.refinement.NonNegativeInt>
  use_tabs: Bool
  semi: Bool
  single_quote: Bool
  quote_props: PrettierQuoteProps
  jsx_single_quote: Bool
  trailing_comma: PrettierTrailingComma
  bracket_spacing: Bool
  object_wrap: PrettierObjectWrap
  bracket_same_line: Bool
  arrow_parens: PrettierArrowParens
  require_pragma: Bool
  insert_pragma: Bool
  check_ignore_pragma: Bool
  prose_wrap: PrettierProseWrap
  html_whitespace_sensitivity: PrettierHtmlWhitespaceSensitivity
  vue_indent_script_and_style: Bool
  single_attribute_per_line: Bool
  end_of_line: PrettierEndOfLine
  embedded_language_formatting: PrettierEmbeddedLanguageFormatting
  experimental_ternaries: Bool
  experimental_operator_position: PrettierExperimentalOperatorPosition
}

type PrettierOverrideOptions {
  parser: v2.std.patch.FieldPatch<PrettierParser>
  print_width: v2.std.patch.FieldPatch<v2.std.diagnostic.Outcome<v2.std.refinement.NonNegativeInt>>
  tab_width: v2.std.patch.FieldPatch<v2.std.diagnostic.Outcome<v2.std.refinement.NonNegativeInt>>
  use_tabs: v2.std.patch.FieldPatch<Bool>
  semi: v2.std.patch.FieldPatch<Bool>
  single_quote: v2.std.patch.FieldPatch<Bool>
  quote_props: v2.std.patch.FieldPatch<PrettierQuoteProps>
  jsx_single_quote: v2.std.patch.FieldPatch<Bool>
  trailing_comma: v2.std.patch.FieldPatch<PrettierTrailingComma>
  bracket_spacing: v2.std.patch.FieldPatch<Bool>
  object_wrap: v2.std.patch.FieldPatch<PrettierObjectWrap>
  bracket_same_line: v2.std.patch.FieldPatch<Bool>
  arrow_parens: v2.std.patch.FieldPatch<PrettierArrowParens>
  require_pragma: v2.std.patch.FieldPatch<Bool>
  insert_pragma: v2.std.patch.FieldPatch<Bool>
  check_ignore_pragma: v2.std.patch.FieldPatch<Bool>
  prose_wrap: v2.std.patch.FieldPatch<PrettierProseWrap>
  html_whitespace_sensitivity: v2.std.patch.FieldPatch<PrettierHtmlWhitespaceSensitivity>
  vue_indent_script_and_style: v2.std.patch.FieldPatch<Bool>
  single_attribute_per_line: v2.std.patch.FieldPatch<Bool>
  end_of_line: v2.std.patch.FieldPatch<PrettierEndOfLine>
  embedded_language_formatting: v2.std.patch.FieldPatch<PrettierEmbeddedLanguageFormatting>
  experimental_ternaries: v2.std.patch.FieldPatch<Bool>
  experimental_operator_position: v2.std.patch.FieldPatch<PrettierExperimentalOperatorPosition>
}

type PrettierOverrideEntry {
  files: List<String>
  exclude_files: List<String>
  options: PrettierOverrideOptions
}

type PrettierConfig {
  options: PrettierFormattingOptions
  overrides: List<PrettierOverrideEntry>
}

data prettier_default_formatting: PrettierFormattingOptions = PrettierFormattingOptions {
  print_width: v2.std.refinement.non_negative_int_authoritative_literal(value: 80),
  tab_width: v2.std.refinement.non_negative_int_authoritative_literal(value: 2),
  use_tabs: false,
  semi: true,
  single_quote: false,
  quote_props: PrettierQuotePropsAsNeeded,
  jsx_single_quote: false,
  trailing_comma: PrettierTrailingCommaAll,
  bracket_spacing: true,
  object_wrap: PrettierObjectWrapPreserve,
  bracket_same_line: false,
  arrow_parens: PrettierArrowParensAlways,
  require_pragma: false,
  insert_pragma: false,
  check_ignore_pragma: false,
  prose_wrap: PrettierProseWrapPreserve,
  html_whitespace_sensitivity: PrettierHtmlWhitespaceCss,
  vue_indent_script_and_style: false,
  single_attribute_per_line: false,
  end_of_line: PrettierEndOfLineLf,
  embedded_language_formatting: PrettierEmbeddedLanguageAuto,
  experimental_ternaries: false,
  experimental_operator_position: PrettierOperatorPositionEnd,
}

data prettier_defaults: PrettierConfig = PrettierConfig {
  options: prettier_default_formatting,
  overrides: [],
}

type PrettierFormattingOptionsPatch = v2.std.patch.ConfigPatchRecord<PrettierFormattingOptions>

fn apply_prettier_formatting_options_patch(base: PrettierFormattingOptions, patch: PrettierFormattingOptionsPatch) -> PrettierFormattingOptions {
  v2.std.patch.config_patch_layer(base: base, patch: patch)
}

type PrettierConfigPatch {
  options: PrettierFormattingOptionsPatch
  overrides: v2.std.patch.FieldPatch<List<PrettierOverrideEntry>>
}

fn prettier_layer(base: PrettierConfig, patch: PrettierConfigPatch) -> PrettierConfig {
  PrettierConfig {
    options: apply_prettier_formatting_options_patch(base: base.options, patch: patch.options),
    overrides: v2.std.patch.apply_field_patch(base: base.overrides, patch: patch.overrides),
  }
}
