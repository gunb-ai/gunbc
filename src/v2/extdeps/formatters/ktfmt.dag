module v2.extdeps.formatters.ktfmt


type KtfmtStyle
  = KtfmtMetaStyle
  | KtfmtGoogleStyle
  | KtfmtKotlinlangStyle

type KtfmtTrailingCommaManagementStrategy
  = KtfmtTrailingCommaNone
  | KtfmtTrailingCommaOnlyAdd
  | KtfmtTrailingCommaComplete

type KtfmtPositiveInt = v2.std.refinement.PositiveInt

fn make_ktfmt_positive_int(value: Int, at: v2.std.diagnostic.Locus) -> v2.std.diagnostic.Outcome<KtfmtPositiveInt> {
  v2.std.refinement.make_positive_int(value: value, at: at)
}

type KtfmtConfig {
  style: KtfmtStyle
  max_width: v2.std.diagnostic.Outcome<KtfmtPositiveInt>
  block_indent: v2.std.diagnostic.Outcome<KtfmtPositiveInt>
  continuation_indent: v2.std.diagnostic.Outcome<KtfmtPositiveInt>
  trailing_comma_management_strategy: KtfmtTrailingCommaManagementStrategy
  remove_unused_imports: Bool
  debugging_print_ops_after_formatting: Bool

  dry_run: Bool
  set_exit_if_changed: Bool
  stdin_name: String
  enable_editorconfig: Bool
  quiet: Bool

  editorconfig_max_line_length: v2.std.diagnostic.Outcome<KtfmtPositiveInt>
  editorconfig_indent_size: v2.std.diagnostic.Outcome<KtfmtPositiveInt>
  editorconfig_tab_width: v2.std.diagnostic.Outcome<KtfmtPositiveInt>
  editorconfig_ij_kotlin_indent_size: v2.std.diagnostic.Outcome<KtfmtPositiveInt>
  editorconfig_ij_continuation_indent_size: v2.std.diagnostic.Outcome<KtfmtPositiveInt>
  editorconfig_ij_kotlin_continuation_indent_size: v2.std.diagnostic.Outcome<KtfmtPositiveInt>
  editorconfig_ktfmt_trailing_comma_management_strategy: KtfmtTrailingCommaManagementStrategy
}

data ktfmt_defaults: KtfmtConfig = KtfmtConfig {
  style: KtfmtMetaStyle,
  max_width: v2.std.refinement.positive_int_authoritative_literal(value: 100),
  block_indent: v2.std.refinement.positive_int_authoritative_literal(value: 2),
  continuation_indent: v2.std.refinement.positive_int_authoritative_literal(value: 4),
  trailing_comma_management_strategy: KtfmtTrailingCommaOnlyAdd,
  remove_unused_imports: true,
  debugging_print_ops_after_formatting: false,

  dry_run: false,
  set_exit_if_changed: false,
  stdin_name: "",
  enable_editorconfig: false,
  quiet: false,

  editorconfig_max_line_length: v2.std.refinement.positive_int_authoritative_literal(value: 100),
  editorconfig_indent_size: v2.std.refinement.positive_int_authoritative_literal(value: 2),
  editorconfig_tab_width: v2.std.refinement.positive_int_authoritative_literal(value: 2),
  editorconfig_ij_kotlin_indent_size: v2.std.refinement.positive_int_authoritative_literal(value: 2),
  editorconfig_ij_continuation_indent_size: v2.std.refinement.positive_int_authoritative_literal(value: 4),
  editorconfig_ij_kotlin_continuation_indent_size: v2.std.refinement.positive_int_authoritative_literal(value: 4),
  editorconfig_ktfmt_trailing_comma_management_strategy: KtfmtTrailingCommaOnlyAdd,
}

type KtfmtConfigPatch = v2.std.patch.ConfigPatchRecord<KtfmtConfig>

fn ktfmt_layer(base: KtfmtConfig, patch: KtfmtConfigPatch) -> KtfmtConfig {
  v2.std.patch.config_patch_layer(base: base, patch: patch)
}
