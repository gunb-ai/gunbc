// v2 runtime template for Rust targets.
//
// Defines the Rust source text for the v2_rt runtime shim module.
// This is the single authority for runtime intrinsic implementations.
// The v1 V2_RUNTIME_SOURCE const in v2_runtime_shim.rs is bootstrap-only
// legacy and should not be extended.
//
// The emit layer calls rust_runtime_source() and writes the result as
// src/v2_rt.rs in the emitted crate.

module v2.compiler.runtime_rust

fn rt_header() -> String {
  concat(
    "//! Runtime shims for v2 compiler intrinsic operations.\n",
    "//! Generated by the v2 compiler -- do not edit.\n\n",
    "#![allow(unused_variables, dead_code)]\n\n",
    "use im::", "{", "OrdMap, OrdSet, Vector", "}", ";\n",
    "use std::rc::Rc;\n\n")
}

fn rt_concat_trait() -> String {
  concat(
    "pub trait V2Concat {\n",
    "    fn v2_concat(self, other: Self) -> Self;\n",
    "}\n\n",
    "impl V2Concat for String {\n",
    "    fn v2_concat(mut self, other: String) -> String { self.push_str(&other); self }\n",
    "}\n\n",
    "impl<T> V2Concat for Vector<T> {\n",
    "    fn v2_concat(mut self, other: Vector<T>) -> Vector<T> { self.extend(other); self }\n",
    "}\n\n",
    "pub fn concat<T: V2Concat>(a: T, b: T) -> T { a.v2_concat(b) }\n\n")
}

fn rt_string_ops() -> String {
  concat(
    "pub fn char_at(s: &str, pos: i64) -> String {\n",
    "    let pos = pos.max(0) as usize;\n",
    "    if s.is_ascii() {\n",
    "        let bytes = s.as_bytes();\n",
    "        if pos >= bytes.len() { return String::new(); }\n",
    "        return String::from(bytes[pos] as char);\n",
    "    }\n",
    "    s.chars().nth(pos).map(|ch| ch.to_string()).unwrap_or_default()\n",
    "}\n\n",
    "pub fn string_length(s: &str) -> i64 {\n",
    "    if s.is_ascii() { s.len() as i64 } else { s.chars().count() as i64 }\n",
    "}\n\n",
    "pub fn substring(s: &str, start: i64, end: i64) -> String {\n",
    "    let start = start.max(0) as usize;\n",
    "    let end = end.max(0) as usize;\n",
    "    if end <= start { return String::new(); }\n",
    "    if s.is_ascii() {\n",
    "        let len = s.len();\n",
    "        if start >= len { return String::new(); }\n",
    "        return s[start..end.min(len)].to_string();\n",
    "    }\n",
    "    s.chars().skip(start).take(end.saturating_sub(start)).collect()\n",
    "}\n\n",
    "pub fn string_contains(s: &str, sub: String) -> bool {\n",
    "    s.contains(&*sub)\n",
    "}\n\n",
    "pub fn contains(s: String, sub: String) -> bool { string_contains(&s, sub) }\n\n",
    "pub fn count<T>(items: Rc<Vector<T>>) -> i64 { items.len() as i64 }\n\n",
    "pub fn str_eq(a: String, b: String) -> bool { a == b }\n\n",
    "pub fn to_string(value: i64) -> String { value.to_string() }\n\n",
    "pub fn clamp(val: i64, min_val: i64, max_val: i64) -> i64 {\n",
    "    val.clamp(min_val, max_val)\n",
    "}\n\n")
}

fn rt_collection_ops() -> String {
  concat(
    "pub fn lookup<V: Clone>(table: &OrdMap<String, V>, key: String) -> Option<V> {\n",
    "    table.get(&key).cloned()\n",
    "}\n\n",
    "pub fn index_by<V: Clone, F: Fn(&V) -> String>(list: Vector<V>, key_fn: F) -> OrdMap<String, V> {\n",
    "    let mut map = OrdMap::new();\n",
    "    for item in list { let key = key_fn(&item); map.insert(key, item); }\n",
    "    map\n",
    "}\n\n",
    "pub fn empty_map<K: Ord, V>() -> OrdMap<K, V> { OrdMap::new() }\n\n",
    "pub fn map_insert<K: Ord, V>(mut map: OrdMap<K, V>, key: K, value: V) -> OrdMap<K, V> {\n",
    "    map.insert(key, value); map\n",
    "}\n\n",
    "pub fn map_merge<K: Ord, V>(mut base: OrdMap<K, V>, overlay: OrdMap<K, V>) -> OrdMap<K, V> {\n",
    "    base.extend(overlay); base\n",
    "}\n\n",
    "pub fn map_get<K: Ord, V: Clone>(m: &OrdMap<K, V>, key: K) -> Option<V> {\n",
    "    m.get(&key).cloned()\n",
    "}\n\n",
    "pub fn map_keys<K: Clone, V>(m: &OrdMap<K, V>) -> Vector<K> { m.keys().cloned().collect() }\n\n",
    "pub fn map_values<K, V: Clone>(m: &OrdMap<K, V>) -> Vector<V> { m.values().cloned().collect() }\n\n",
    "pub fn list_concat<T>(mut a: Vector<T>, b: Vector<T>) -> Vector<T> { a.extend(b); a }\n\n",
    "pub fn list_push<T>(mut list: Vector<T>, item: T) -> Vector<T> { list.push_back(item); list }\n\n",
    "pub fn append<T: Clone>(list: Rc<Vector<T>>, item: T) -> Vector<T> {\n",
    "    let mut v = (*list).clone();\n",
    "    v.push_back(item);\n",
    "    v\n",
    "}\n\n",
    "pub fn chars_to_string(chars: &Rc<Vector<i64>>, start: i64, end: i64) -> String {\n",
    "    let len = chars.len();\n",
    "    let start = (start.max(0) as usize).min(len);\n",
    "    let end = (end.max(0) as usize).min(len).max(start);\n",
    "    chars.iter()\n",
    "        .skip(start)\n",
    "        .take(end.saturating_sub(start))\n",
    "        .filter_map(|&cp| char::from_u32(cp as u32))\n",
    "        .collect()\n",
    "}\n\n",
    "pub fn parse_int(s: String) -> Option<i64> { s.parse::<i64>().ok() }\n\n",
    "pub fn map_contains_key<K: Ord, V>(m: &OrdMap<K, V>, key: K) -> bool {\n",
    "    m.contains_key(&key)\n",
    "}\n\n",
    "pub fn map_has<K: Ord, V>(m: &OrdMap<K, V>, key: K) -> bool {\n",
    "    m.contains_key(&key)\n",
    "}\n\n",
    "pub fn rc_empty_set<T: Ord>() -> Rc<OrdSet<T>> {\n",
    "    Rc::new(OrdSet::new())\n",
    "}\n\n",
    "pub fn rc_set_insert<T: Ord>(s: Rc<OrdSet<T>>, x: T) -> Rc<OrdSet<T>> {\n",
    "    Rc::new(s.update(x))\n",
    "}\n\n",
    "pub fn rc_set_union<T: Ord + Clone>(a: Rc<OrdSet<T>>, b: Rc<OrdSet<T>>) -> Rc<OrdSet<T>> {\n",
    "    let mut out = a.as_ref().clone();\n",
    "    for item in b.iter() { out.insert(item.clone()); }\n",
    "    Rc::new(out)\n",
    "}\n\n",
    "pub fn set_contains<T: Ord, S: AsRef<OrdSet<T>>>(s: S, x: T) -> bool {\n",
    "    s.as_ref().contains(&x)\n",
    "}\n\n",
    "pub fn reverse<T: Clone>(list: Rc<Vector<T>>) -> Rc<Vector<T>> {\n",
    "    Rc::new(list.iter().rev().cloned().collect())\n",
    "}\n\n",
    "pub fn replace(s: String, from: String, to: String) -> String {\n",
    "    s.replace(&from, &to)\n",
    "}\n\n")
}

fn rt_scanner_ops() -> String {
  concat(
    "pub fn scan_while(s: &str, start: i64, pred: impl Fn(String) -> bool) -> i64 {\n",
    "    let start = start.max(0) as usize;\n",
    "    if s.is_ascii() {\n",
    "        let bytes = s.as_bytes();\n",
    "        let mut pos = start.min(bytes.len());\n",
    "        while pos < bytes.len() && pred(String::from(bytes[pos] as char)) { pos += 1; }\n",
    "        return pos as i64;\n",
    "    }\n",
    "    let char_len = s.chars().count();\n",
    "    let start = start.min(char_len);\n",
    "    let mut pos = start;\n",
    "    for ch in s.chars().skip(start) {\n",
    "        if pred(ch.to_string()) { pos += 1; } else { break; }\n",
    "    }\n",
    "    pos as i64\n",
    "}\n\n",
    "pub fn skip_horizontal_ws(s: &str, start: i64) -> i64 {\n",
    "    let start = start.max(0) as usize;\n",
    "    if s.is_ascii() {\n",
    "        let bytes = s.as_bytes();\n",
    "        let mut pos = start.min(bytes.len());\n",
    "        while pos < bytes.len() && (bytes[pos] == b' ' || bytes[pos] == b'\\t') { pos += 1; }\n",
    "        return pos as i64;\n",
    "    }\n",
    "    let char_len = s.chars().count();\n",
    "    let start = start.min(char_len);\n",
    "    let mut pos = start;\n",
    "    for ch in s.chars().skip(start) {\n",
    "        if ch == ' ' || ch == '\\t' { pos += 1; } else { break; }\n",
    "    }\n",
    "    pos as i64\n",
    "}\n\n",
    "pub fn scan_to_eol(s: &str, start: i64) -> i64 {\n",
    "    let start = start.max(0) as usize;\n",
    "    if s.is_ascii() {\n",
    "        let bytes = s.as_bytes();\n",
    "        let start = start.min(bytes.len());\n",
    "        for i in start..bytes.len() { if bytes[i] == b'\\n' { return i as i64; } }\n",
    "        return bytes.len() as i64;\n",
    "    }\n",
    "    let char_len = s.chars().count();\n",
    "    let start = start.min(char_len);\n",
    "    let mut pos = start;\n",
    "    for ch in s.chars().skip(start) {\n",
    "        if ch == '\\n' { return pos as i64; }\n",
    "        pos += 1;\n",
    "    }\n",
    "    pos as i64\n",
    "}\n\n",
    "pub fn scan_string_end(s: &str, start: i64) -> i64 {\n",
    "    let start = start.max(0) as usize;\n",
    "    if s.is_ascii() {\n",
    "        let bytes = s.as_bytes();\n",
    "        let mut pos = start.min(bytes.len());\n",
    "        while pos < bytes.len() {\n",
    "            if bytes[pos] == b'\\\\' { pos += 2; }\n",
    "            else if bytes[pos] == b'\\\"' { return (pos + 1) as i64; }\n",
    "            else { pos += 1; }\n",
    "        }\n",
    "        return bytes.len() as i64;\n",
    "    }\n",
    "    let char_len = s.chars().count();\n",
    "    let start = start.min(char_len);\n",
    "    let mut pos = start;\n",
    "    let mut escaped = false;\n",
    "    for ch in s.chars().skip(start) {\n",
    "        if escaped {\n",
    "            escaped = false;\n",
    "            pos += 1;\n",
    "        } else if ch == '\\\\' {\n",
    "            escaped = true;\n",
    "            pos += 1;\n",
    "        } else if ch == '\\\"' {\n",
    "            return (pos + 1) as i64;\n",
    "        } else {\n",
    "            pos += 1;\n",
    "        }\n",
    "    }\n",
    "    pos as i64\n",
    "}\n\n")
}

fn rt_unicode_ops() -> String {
  concat(
    "pub fn code_point(c: String) -> i64 {\n",
    "    c.chars().next().map(|ch| ch as i64).unwrap_or(0)\n",
    "}\n\n",
    "pub fn from_code_point(cp: i64) -> String {\n",
    "    char::from_u32(cp as u32).map(|c| c.to_string()).unwrap_or_default()\n",
    "}\n\n")
}

fn rt_rc_container_ops() -> String {
  concat(
    "// -- Rc-wrapped container operations (FF-8) ---------------------------------\n",
    "// These mirror the bare Vector/OrdMap functions above but operate on Rc-wrapped\n",
    "// persistent containers for cheap structural sharing. Generated code using\n",
    "// Rc container templates will call these. Read-only functions (map_get,\n",
    "// map_keys, map_values, lookup, map_contains_key, map_has) work with\n",
    "// Rc<OrdMap> via auto-deref.\n\n",
    "pub fn rc_list_push<T>(list: Rc<Vector<T>>, item: T) -> Rc<Vector<T>> {\n",
    "    let mut out = (*list).clone();\n",
    "    out.push_back(item);\n",
    "    Rc::new(out)\n",
    "}\n\n",
    "pub fn rc_list_concat<T: Clone>(a: Rc<Vector<T>>, b: Rc<Vector<T>>) -> Rc<Vector<T>> {\n",
    "    Rc::new(a.iter().cloned().chain(b.iter().cloned()).collect())\n",
    "}\n\n",
    "pub fn rc_map_insert<K: Ord, V>(map: Rc<OrdMap<K, V>>, key: K, value: V) -> Rc<OrdMap<K, V>> {\n",
    "    Rc::new(map.update(key, value))\n",
    "}\n\n",
    "pub fn rc_map_merge<K: Ord + Clone, V: Clone>(base: Rc<OrdMap<K, V>>, overlay: Rc<OrdMap<K, V>>) -> Rc<OrdMap<K, V>> {\n",
    "    let mut out = base.as_ref().clone();\n",
    "    for (key, value) in overlay.iter() { out.insert(key.clone(), value.clone()); }\n",
    "    Rc::new(out)\n",
    "}\n\n",
    "pub fn rc_index_by<V: Clone, F: Fn(&V) -> String>(list: Rc<Vector<V>>, key_fn: F) -> Rc<OrdMap<String, V>> {\n",
    "    Rc::new(list.iter().map(|v| (key_fn(v), v.clone())).collect())\n",
    "}\n\n",
    "pub fn rc_empty_map<K: Ord, V>() -> Rc<OrdMap<K, V>> { Rc::new(OrdMap::new()) }\n\n",
    "impl<T: Clone> V2Concat for Rc<Vector<T>> {\n",
    "    fn v2_concat(self, other: Rc<Vector<T>>) -> Rc<Vector<T>> { rc_list_concat(self, other) }\n",
    "}\n\n")
}

fn rt_filesystem() -> String {
  concat(
    "#[derive(Debug, Clone)]\n",
    "pub struct FilesystemReadResult {\n",
    "    pub content: String,\n",
    "}\n\n",
    "pub fn filesystem_read(path: String) -> FilesystemReadResult {\n",
    "    let content = std::fs::read_to_string(&path)\n",
    "        .unwrap_or_else(|e| panic!(\"failed to read {}: {}\", path, e));\n",
    "    FilesystemReadResult { content }\n",
    "}\n")
}

fn rt_hash_ops() -> String {
  concat(
    "const FNV1A64_OFFSET: u64 = 0xcbf29ce484222325;\n",
    "const FNV1A64_PRIME: u64 = 0x100000001b3;\n\n",
    "fn fnv1a64(bytes: &[u8]) -> u64 {\n",
    "    let mut hash = FNV1A64_OFFSET;\n",
    "    for b in bytes {\n",
    "        hash ^= *b as u64;\n",
    "        hash = hash.wrapping_mul(FNV1A64_PRIME);\n",
    "    }\n",
    "    hash\n",
    "}\n\n",
    "pub type Hash = String;\n\n",
    "const HASH_DIGEST_LEN: usize = 16;\n\n",
    "pub fn is_hash_digest(s: &str) -> bool {\n",
    "    s.len() == HASH_DIGEST_LEN && s.bytes().all(|b| b.is_ascii_hexdigit())\n",
    "}\n\n",
    "fn expect_hash_digest(s: &str, arg: &str) {\n",
    "    if !is_hash_digest(s) {\n",
    "        panic!(\"{} must be a 16-char hex Hash digest\", arg);\n",
    "    }\n",
    "}\n\n",
    "pub fn atom_identity_hash(s: String) -> Hash {\n",
    "    format!(\"{:016x}\", fnv1a64(s.as_bytes()))\n",
    "}\n\n",
    "pub fn hash_combine(a: Hash, b: Hash) -> Hash {\n",
    "    expect_hash_digest(&a, \"a\");\n",
    "    expect_hash_digest(&b, \"b\");\n",
    "    let mut bytes = a.into_bytes();\n",
    "    bytes.push(0);\n",
    "    bytes.extend_from_slice(b.as_bytes());\n",
    "    format!(\"{:016x}\", fnv1a64(&bytes))\n",
    "}\n\n")
}

fn rust_runtime_source() -> String {
  concat(
    rt_header(),
    rt_concat_trait(),
    rt_string_ops(),
    rt_collection_ops(),
    rt_rc_container_ops(),
    rt_scanner_ops(),
    rt_unicode_ops(),
    rt_hash_ops(),
    rt_filesystem())
}
