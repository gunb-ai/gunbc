// v2 type checker/resolver — resolves Named type references to structural form.
//
// After this pass, no unresolved Named references survive in the typed graph.
// Every Named { name } is replaced by its structural expansion (Product,
// Coproduct, Container, Refined) or by Primitive { name } for kernel types.
//
// Exception: recursive types retain a Named reference to break the cycle,
// but the name is guaranteed to be defined in the module graph.
//
// Nominal identity is preserved: resolved types keep their name alongside
// the structural form for diagnostics and emission.
//
// Dependency chain:
//   v2.compiler.resolve (ModuleGraph, dependency order)
//     -> v2.compiler.typecheck (TypedGraph, resolved types)
//       -> v2.compiler.emit (target-language files)

module v2.compiler.typecheck

import std.types { SourceSpan }
import v2.std.core {
  Module, Node, TypedNode, ImportNames, ImportAll, ImportSpecific,
  TypeExpr, Field, Variant, Param,
  Connective, Conj, Disj,
  Expr, Diagnostic,
  Named, Product, Coproduct, Container, Refined, Optional, MapType, Primitive,
  ResourceUse,
  TransportBinding, ServiceConfig, AuthConfig, HeaderDef, EnvDef,
  Error,
  TypedExpr,
  TypedLiteral, TypedVar, TypedFieldAccess, TypedCall, TypedMethodCall,
  TypedMatch, TypedIf, TypedLet, TypedRecordLit, TypedListLit,
  TypedBinOp, TypedUnaryOp, TypedLambda, TypedStringInterp, TypedBlock,
  TypedCast, TypedForEach, TypedIndex, TypedSlice,
  TypedNamedArg, TypedMatchArm, TypedFieldInit, TypedStringPart,
  TypedText, TypedInterpolation,
  typed_expr_to_expr,
  type_expr_to_node, node_to_type_expr_full,
  FuncSig, FuncEnv,
  ForEach,
  LiteralValue, LitStr, LitInt, LitFloat, LitBool, LitNull,
  BinOpKind, Add, Sub, Mul, Div, Mod,
  BinEq, BinNe, BinLt, BinGt, BinLe, BinGe,
  BinAnd, BinOr, NullCoalesce,
  UnaryOpKind, Not, Neg,
  MatchArm, MatchPattern, FieldInit, NamedArg, StringPart,
  RestBinding, ShellBinding, FileBinding, LocalBinding,
  Text, Interpolation,
  Literal, Var, FieldAccess, Call, MethodCall,
  Match, If, Let, RecordLit, ListLit, BinOp, UnaryOp,
  Lambda, StringInterp, Block, Cast,
  Index, Slice
}
import v2.compiler.resolve { ModuleGraph, ResolvedModule, ResolvedImport }

// =========================================================================
// Typecheck output types
// =========================================================================

type TypedGraph {
  modules: List<TypedModule>
  diagnostics: List<Diagnostic>
}

type SpanType {
  start: Int
  end: Int
  resolved_type: TypeExpr
  // B1 migration: Node representation of the resolved type.
  resolved_type_node: Node?
}

type TypedModule {
  module: Module
  items: List<TypedNode>
  type_env: TypeEnv
  func_env: FuncEnv
  type_cache: List<SpanType>
}

type TypeEnv {
  bindings: Map<String, TypeBinding>
  recursive_types: List<String>
}

type TypeBinding {
  name: String
  resolved: TypeExpr
  // B1 migration: dual-write Node representation of the resolved type.
  // During migration, resolved_node is populated alongside resolved.
  // Once all consumers read from resolved_node, resolved will be removed.
  resolved_node: Node?
}

// Internal result type for threading diagnostics through resolution.
type ResolveResult {
  resolved: TypeExpr
  diagnostics: List<Diagnostic>
  // B1 migration: Node representation of the resolved type.
  resolved_node: Node?
}

// =========================================================================
// Expression inference types
// =========================================================================

// Lightweight operation entry for the service registry.
// Only the fields needed for type inference: name + outputs.
type OpEntry {
  name: String
  outputs: List<Field>
}

// Derive outputs from a Node's return_type (Optional<TypeExpr>).
// Outputs live in return_type:
//   - Single output: return_type is the TypeExpr directly
//   - Multiple outputs: return_type is Product { fields: outputs }
//   - No outputs: return_type is none
fn return_type_to_outputs(return_type: TypeExpr?, span: SourceSpan) -> List<Field> {
  match return_type {
    None => []
    Some { value: Product { name: pn, fields: fs, span: _ } } =>
      match pn {
        None => fs
        Some { value: _ } => [Field { name: "value", type_expr: return_type.value, optional: false, default_value: none, from_key: none, span: span }]
      }
    Some { value: te } => [Field { name: "value", type_expr: te, optional: false, default_value: none, from_key: none, span: span }]
  }
}

// Same as return_type_to_outputs but for TypedNode (non-optional return_type).
fn typed_return_type_to_outputs(return_type: TypeExpr, span: SourceSpan) -> List<Field> {
  match return_type {
    Product { name: pn, fields: fs, span: _ } =>
      match pn {
        None => fs
        Some { value: _ } => [Field { name: "value", type_expr: return_type, optional: false, default_value: none, from_key: none, span: span }]
      }
    Primitive { name: "Unit", span: _ } => []
    te => [Field { name: "value", type_expr: te, optional: false, default_value: none, from_key: none, span: span }]
  }
}

type InferScope {
  type_env: TypeEnv
  func_env: FuncEnv
  locals: Map<String, TypeBinding>
  module_name: String
  type_cache: Map<String, TypeExpr>
  service_registry: Map<String, List<OpEntry>>
}

type InferResult {
  typed: TypedExpr
  diagnostics: List<Diagnostic>
  type_entries: List<SpanType>
}

type BlockInferState {
  scope: InferScope
  diag_chunks: List<List<Diagnostic>>
  last_type: TypeExpr
  entry_chunks: List<List<SpanType>>
}

type TypedItemResult {
  item: TypedNode
  diagnostics: List<Diagnostic>
  type_entries: List<SpanType>
}

type AccessCheckResult {
  resolved_type: TypeExpr
  diagnostics: List<Diagnostic>
}

// Internal result type for item-level resolution.
type ItemResult {
  item: Node
  diagnostics: List<Diagnostic>
}

type BuildTypeEnvResult {
  env: TypeEnv
  diagnostics: List<Diagnostic>
}

type ParentModulesResult {
  modules: List<TypedModule>
  diagnostics: List<Diagnostic>
}

// Accumulator for the main typecheck loop, carrying both a list (for output)
// and a map index (for O(1) module lookup by name).
type TypecheckAccum {
  modules: List<TypedModule>
  module_index: Map<String, TypedModule>
  diagnostics: List<Diagnostic>
}

// Internal result type for field-level resolution.
type FieldResult {
  field: Field
  diagnostics: List<Diagnostic>
}

type ExprResolveResult {
  expr: Expr
  diagnostics: List<Diagnostic>
}

type NamedArgResolveResult {
  arg: NamedArg
  diagnostics: List<Diagnostic>
}

type MatchArmResolveResult {
  arm: MatchArm
  diagnostics: List<Diagnostic>
}

type FieldInitResolveResult {
  field_init: FieldInit
  diagnostics: List<Diagnostic>
}

type StringPartResolveResult {
  part: StringPart
  diagnostics: List<Diagnostic>
}

type TransportResolveResult {
  transport: TransportBinding
  diagnostics: List<Diagnostic>
}

type ServiceConfigResolveResult {
  config: ServiceConfig
  diagnostics: List<Diagnostic>
}

type AuthConfigResolveResult {
  config: AuthConfig
  diagnostics: List<Diagnostic>
}

type HeaderResolveResult {
  header: HeaderDef
  diagnostics: List<Diagnostic>
}

type EnvDefResolveResult {
  env_def: EnvDef
  diagnostics: List<Diagnostic>
}

// Internal result type for variant-level resolution.
type VariantResult {
  variant: Variant
  diagnostics: List<Diagnostic>
}

// Internal result type for param-level resolution.
type ParamResult {
  param: Param
  diagnostics: List<Diagnostic>
}

// Internal result type for resource-use resolution.
type ResourceUseResult {
  resource_use: ResourceUse
  diagnostics: List<Diagnostic>
}

// =========================================================================
// Build function environment from module items.
// Extracts signatures from Node items that have params.
// =========================================================================

// Unwrap an optional return type at a function boundary.
// The v1 codegen tracks optionality from field declarations and rejects
// assigning optional values to non-optional struct fields. This function
// boundary resets the tracking, allowing the result to be used as TypeExpr.
fn unwrap_return_type(rt: TypeExpr?) -> TypeExpr {
  // Use resolve_optional_type_expr pattern: the evaluator handles the
  // none check and returns the value; the compiled code needs the
  // .value accessor pattern. Both paths produce the same result.
  let result = resolve_optional_type_expr(
    expr: rt,
    env: TypeEnv { bindings: empty_map(), recursive_types: [] },
    module_name: ""
  )
  result.resolved
}

fn build_func_env(items: List<Node>) -> FuncEnv {
  // Called with resolved items (after resolve_item_types), so return_type
  // fields have already been resolved by resolve_optional_type_expr.
  let sigs = fold(items, init: empty_map(), f: (acc, item) =>
    if item.params |> count > 0 {
      let is_async = item.uses |> count > 0
      let rt = unwrap_return_type(rt: item.return_type)
      map_insert(acc, item.name, FuncSig { name: item.name, params: item.params, return_type: rt, is_async: is_async })
    } else {
      acc
    }
  )
  FuncEnv { signatures: sigs }
}

// =========================================================================
// Service namespace locals — S86 heuristic bridge
//
// Service names are dotted (e.g., "git.Core", "github.Gist"). Expressions
// reference the namespace root ("git") as a variable. This extracts
// namespace roots from service Node items and registers them as locals
// with a synthetic Named type so they're in scope during inference.
//
// This is a per-kind special case (debt per S86). Terminal fix: unified
// DAG node model where services participate in the expression namespace
// like any other node.
// =========================================================================

// find_dot_index: find the first "." in a string, or -1 if none.
// Used for extracting service namespace roots.
fn find_dot_index(name: String, index: Int) -> Int {
  if index >= string_length(name) {
    -1
  } else if char_at(name, index) == "." {
    index
  } else {
    find_dot_index(name: name, index: index + 1)
  }
}

// =========================================================================
// Service registry lookups
//
// Service calls use dotted paths (e.g., "git.Core.CurrentBranch()").
// The service_registry maps full service paths to their OpEntry lists.
// FieldAccess checks if base.field is a service path; MethodCall looks up
// the operation and returns its output type.
// =========================================================================

fn check_service_field_access(base_type: TypeExpr, field: String, scope: InferScope) -> TypeExpr? {
  match base_type {
    Named { name: svc_name, span: _ } =>
      let path = concat(svc_name, ".", field)
      match map_get(scope.service_registry, path) {
        Some { value: _ } => Some { value: Named { name: path, span: no_span() } }
        None => None
      }
    _ => None
  }
}

fn check_service_method_call(receiver_type: TypeExpr, method: String, scope: InferScope) -> TypeExpr? {
  match receiver_type {
    Named { name: svc_path, span: _ } =>
      match map_get(scope.service_registry, svc_path) {
        Some { value: ops } =>
          let matching = ops |> filter(op => op.name == method)
          match matching |> first {
            Some { value: op } =>
              if op.outputs |> count == 0 {
                Some { value: unit_type() }
              } else if op.outputs |> count == 1 {
                match op.outputs |> first {
                  Some { value: f } => Some { value: f.type_expr }
                  None => Some { value: unit_type() }
                }
              } else {
                Some { value: Product { name: none, fields: op.outputs, span: no_span() } }
              }
            None => None
          }
        None => None
      }
    _ => None
  }
}

// =========================================================================
// Expression inference — step 3 of the typed AST design
//
// Assigns a resolved TypeExpr to every Expr node in the AST, producing
// TypedExpr values. This is a single top-down pass (not Hindley-Milner);
// .dag has explicit type annotations on params and fields, so inference
// is propagation, not unification.
// =========================================================================

// -------------------------------------------------------------------------
// Helper: construct a no-span sentinel for synthesized types
// -------------------------------------------------------------------------

fn no_span() -> SourceSpan {
  SourceSpan { start: 0, end: 0 }
}

// -------------------------------------------------------------------------
// Helper: construct a unit TypeExpr
// -------------------------------------------------------------------------

fn unit_type() -> TypeExpr {
  Primitive { name: "Unit", span: no_span() }
}

// -------------------------------------------------------------------------
// Helpers for typed expression inference
// -------------------------------------------------------------------------

fn expr_span(expr: Expr) -> SourceSpan {
  match expr {
    Literal { span: s } => s
    Var { span: s } => s
    FieldAccess { span: s } => s
    Call { span: s } => s
    MethodCall { span: s } => s
    Match { span: s } => s
    If { span: s } => s
    Let { span: s } => s
    RecordLit { span: s } => s
    ListLit { span: s } => s
    BinOp { span: s } => s
    UnaryOp { span: s } => s
    Lambda { span: s } => s
    StringInterp { span: s } => s
    Block { span: s } => s
    Cast { span: s } => s
    ForEach { span: s } => s
    Index { span: s } => s
    Slice { span: s } => s
    _ => SourceSpan { start: 0, end: 0 }
  }
}

fn span_entry_typed(texpr: TypedExpr) -> SpanType {
  SpanType { start: texpr.span.start, end: texpr.span.end, resolved_type: texpr.resolved_type, resolved_type_node: none }
}

fn ok_infer(texpr: TypedExpr) -> InferResult {
  InferResult {
    typed: texpr,
    diagnostics: [],
    type_entries: [span_entry_typed(texpr: texpr)]
  }
}

// -------------------------------------------------------------------------
// lookup_in_scope: look up a variable name in lexical locals only.
//
// Function params are installed into locals by build_params_scope().
// -------------------------------------------------------------------------

fn lookup_in_scope(scope: InferScope, name: String) -> TypeExpr? {
  match map_get(scope.locals, name) {
    Some { value: binding } => Some { value: binding.resolved }
    None => None
  }
}

// -------------------------------------------------------------------------
// lookup_field_type: given a resolved type (Product), look up a field
// by name and return its type. Returns None if not found or not a Product.
// -------------------------------------------------------------------------

fn lookup_field_type(type_expr: TypeExpr, field_name: String) -> TypeExpr? {
  match type_expr {
    Product { name: _, fields: fields, span: _ } =>
      let matches = filter(fields, f => f.name == field_name)
      if count(matches) > 0 {
        let found = first(matches)
        match found {
          Some { value: f } =>
            if f.optional {
              Some { value: Optional { inner: f.type_expr, span: no_span() } }
            } else {
              Some { value: f.type_expr }
            }
          None => None
        }
      } else {
        None
      }
    // For Optional types, unwrap and look up in inner
    Optional { inner: inner, span: _ } =>
      match lookup_field_type(type_expr: inner, field_name: field_name) {
        Some { value: inner_result } =>
          Some { value: Optional { inner: inner_result, span: no_span() } }
        None => None
      }
    _ => None
  }
}

// -------------------------------------------------------------------------
// lookup_func_sig: look up a function signature by name
// -------------------------------------------------------------------------

fn lookup_func_sig(func_env: FuncEnv, name: String) -> FuncSig? {
  map_get(func_env.signatures, name)
}

// -------------------------------------------------------------------------
// infer_literal: resolve the type of a LiteralValue
// -------------------------------------------------------------------------

fn infer_literal(lit: LiteralValue) -> TypeExpr {
  match lit {
    LitStr { value: _ } => Primitive { name: "String", span: no_span() }
    LitInt { value: _ } => Primitive { name: "Int", span: no_span() }
    LitFloat { value: _ } => Primitive { name: "Float", span: no_span() }
    LitBool { value: _ } => Primitive { name: "Bool", span: no_span() }
    LitNull => Primitive { name: "Unit", span: no_span() }
  }
}

// -------------------------------------------------------------------------
// infer_binop_type: resolve the result type of a binary operation
// -------------------------------------------------------------------------

// -------------------------------------------------------------------------
// Index/Slice access helpers
// -------------------------------------------------------------------------

fn normalize_access_type(type_expr: TypeExpr) -> TypeExpr {
  match type_expr {
    Refined { base: base, predicates: _, span: _ } =>
      normalize_access_type(type_expr: base)
    _ => type_expr
  }
}

fn normalize_type_name(name: String) -> String {
  let base = match name |> split(delimiter: "<") |> first {
    Some { value: part } => part
    None => name
  }
  match base |> split(delimiter: ".") |> last {
    Some { value: short } => short
    None => base
  }
}

fn container_kind_name(kind: ContainerKind) -> String {
  match kind {
    List => "List"
    Set => "Set"
    NonEmptyList => "NonEmptyList"
    NonEmptySet => "NonEmptySet"
  }
}

fn type_expr_shape(type_expr: TypeExpr) -> String {
  match normalize_access_type(type_expr: type_expr) {
    Named { name: name, span: _ } => concat("Named(", normalize_type_name(name: name), ")")
    Primitive { name: name, span: _ } => concat("Primitive(", name, ")")
    Container { kind: kind, element: element, span: _ } =>
      concat("Container(", container_kind_name(kind: kind), ",", type_expr_shape(type_expr: element), ")")
    Optional { inner: inner, span: _ } =>
      concat("Optional(", type_expr_shape(type_expr: inner), ")")
    MapType { key: key, value: value, span: _ } =>
      concat("Map(", type_expr_shape(type_expr: key), ",", type_expr_shape(type_expr: value), ")")
    Product { name: name, fields: _, span: _ } =>
      if name == none { "Product(<anon>)" } else { concat("Product(", normalize_type_name(name: name.value), ")") }
    Coproduct { name: name, variants: _, span: _ } =>
      if name == none { "Coproduct(<anon>)" } else { concat("Coproduct(", normalize_type_name(name: name.value), ")") }
    Refined { base: _, predicates: _, span: _ } =>
      "Refined(<unreachable>)"
  }
}

fn type_expr_equals(left: TypeExpr, right: TypeExpr) -> Bool {
  let l = normalize_access_type(type_expr: left)
  let r = normalize_access_type(type_expr: right)
  match l {
    Named { name: ln, span: _ } =>
      match r {
        Named { name: rn, span: _ } => normalize_type_name(name: ln) == normalize_type_name(name: rn)
        Product { name: rn, fields: _, span: _ } =>
          if rn == none { false } else { normalize_type_name(name: ln) == normalize_type_name(name: rn.value) }
        Coproduct { name: rn, variants: _, span: _ } =>
          if rn == none { false } else { normalize_type_name(name: ln) == normalize_type_name(name: rn.value) }
        _ => false
      }
    Primitive { name: ln, span: _ } =>
      match r {
        Primitive { name: rn, span: _ } => ln == rn
        _ => false
      }
    Container { kind: lk, element: le, span: _ } =>
      match r {
        Container { kind: rk, element: re, span: _ } =>
          container_kind_name(kind: lk) == container_kind_name(kind: rk) && type_expr_equals(left: le, right: re)
        _ => false
      }
    Optional { inner: li, span: _ } =>
      match r {
        Optional { inner: ri, span: _ } => type_expr_equals(left: li, right: ri)
        _ => false
      }
    MapType { key: lk, value: lv, span: _ } =>
      match r {
        MapType { key: rk, value: rv, span: _ } =>
          type_expr_equals(left: lk, right: rk) && type_expr_equals(left: lv, right: rv)
        _ => false
      }
    Product { name: ln, fields: _, span: _ } =>
      match r {
        Named { name: rn, span: _ } =>
          if ln == none { false } else { normalize_type_name(name: ln.value) == normalize_type_name(name: rn) }
        Product { name: rn, fields: _, span: _ } =>
          if ln == none { false }
          else { if rn == none { false } else { normalize_type_name(name: ln.value) == normalize_type_name(name: rn.value) } }
        _ => false
      }
    Coproduct { name: ln, variants: _, span: _ } =>
      match r {
        Named { name: rn, span: _ } =>
          if ln == none { false } else { normalize_type_name(name: ln.value) == normalize_type_name(name: rn) }
        Coproduct { name: rn, variants: _, span: _ } =>
          if ln == none { false }
          else { if rn == none { false } else { normalize_type_name(name: ln.value) == normalize_type_name(name: rn.value) } }
        _ => false
      }
    Refined { base: _, predicates: _, span: _ } =>
      false
  }
}

// =========================================================================
// Node-based type utility functions (B1 migration)
//
// These are the Node equivalents of type_expr_equals, type_expr_shape,
// normalize_access_type, and type_expr_deps. They work on Nodes used
// as type representations rather than TypeExpr values.
//
// A Node-as-type uses:
//   - name: the type's name
//   - connective: Conj (product/record), Disj (coproduct/sum), none (leaf)
//   - children: fields or variants
//   - return_type: the field's type (for field children) or container element
//   - properties: metadata (container_kind, optional, map_type)
// =========================================================================

// Check if a type-Node represents a container type.
fn node_is_container(n: Node) -> Bool {
  n.properties |> any(p => p.name == "container_kind")
}

// Check if a type-Node represents an optional type.
fn node_is_optional(n: Node) -> Bool {
  n.properties |> any(p => p.name == "optional")
}

// Check if a type-Node represents a map type.
fn node_is_map(n: Node) -> Bool {
  n.properties |> any(p => p.name == "map_type")
}

// Check if a type-Node is a leaf (primitive or named reference).
fn node_is_leaf(n: Node) -> Bool {
  n.connective == none && n.children |> count == 0 && n.properties |> count == 0
}

// Check if a type-Node is a named reference (has return_type with Named).
fn node_is_named_ref(n: Node) -> Bool {
  if n.return_type == none { false }
  else {
    match n.return_type.value {
      Named { name: _, span: _ } => true
      _ => false
    }
  }
}

// Node-based shape description (equivalent to type_expr_shape).
fn node_type_shape(n: Node) -> String {
  if node_is_leaf(n: n) {
    if node_is_named_ref(n: n) {
      concat("Named(", normalize_type_name(name: n.name), ")")
    } else {
      concat("Primitive(", n.name, ")")
    }
  } else if n.connective != none {
    match n.connective.value {
      Conj =>
        if n.name == "" { "Product(<anon>)" } else { concat("Product(", normalize_type_name(name: n.name), ")") }
      Disj =>
        if n.name == "" { "Coproduct(<anon>)" } else { concat("Coproduct(", normalize_type_name(name: n.name), ")") }
    }
  } else if node_is_container(n: n) {
    let elem_shape = if n.return_type != none {
      type_expr_shape(type_expr: n.return_type.value)
    } else {
      "?"
    }
    concat("Container(", n.name, ",", elem_shape, ")")
  } else if node_is_optional(n: n) {
    let inner_shape = if n.return_type != none {
      type_expr_shape(type_expr: n.return_type.value)
    } else {
      "?"
    }
    concat("Optional(", inner_shape, ")")
  } else if node_is_map(n: n) {
    "Map(...)"
  } else {
    concat("Node(", n.name, ")")
  }
}

// Node-based type equality (equivalent to type_expr_equals).
// Two type-Nodes are equal if they represent the same type structure.
fn node_type_equals(left: Node, right: Node) -> Bool {
  // Both leaves: compare names (normalized)
  if node_is_leaf(n: left) && node_is_leaf(n: right) {
    normalize_type_name(name: left.name) == normalize_type_name(name: right.name)
  }
  // Both products: compare names
  else if left.connective != none && right.connective != none {
    normalize_type_name(name: left.name) == normalize_type_name(name: right.name)
  }
  // Leaf vs product/coproduct: compare leaf name with product/coproduct name
  else if node_is_leaf(n: left) && right.connective != none {
    normalize_type_name(name: left.name) == normalize_type_name(name: right.name)
  }
  else if left.connective != none && node_is_leaf(n: right) {
    normalize_type_name(name: left.name) == normalize_type_name(name: right.name)
  }
  // Both containers: compare kind and element
  else if node_is_container(n: left) && node_is_container(n: right) {
    if left.name != right.name { false }
    else if left.return_type != none && right.return_type != none {
      type_expr_equals(left: left.return_type.value, right: right.return_type.value)
    } else {
      false
    }
  }
  // Both optionals: compare inner
  else if node_is_optional(n: left) && node_is_optional(n: right) {
    if left.return_type != none && right.return_type != none {
      type_expr_equals(left: left.return_type.value, right: right.return_type.value)
    } else {
      false
    }
  }
  // Both maps: compare key and value
  else if node_is_map(n: left) && node_is_map(n: right) {
    if left.children |> count == 2 && right.children |> count == 2 {
      let left_first = match left.children |> first {
        Some { value: v } => v
        None => left
      }
      let right_first = match right.children |> first {
        Some { value: v } => v
        None => right
      }
      let left_key = node_to_type_expr_full(n: left_first)
      let right_key = node_to_type_expr_full(n: right_first)
      type_expr_equals(left: left_key, right: right_key)
    } else {
      false
    }
  }
  else {
    false
  }
}

// Node-based dependency extraction (equivalent to type_expr_deps).
// Returns the list of Named type references this type-Node depends on.
fn node_type_deps(n: Node) -> List<String> {
  if node_is_named_ref(n: n) {
    [n.name]
  } else if node_is_leaf(n: n) {
    []
  } else if n.connective != none {
    // Product or Coproduct: collect deps from children's return_types
    flat_map(n.children, child =>
      if child.return_type != none {
        type_expr_deps(expr: child.return_type.value)
      } else {
        []
      }
    )
  } else if n.return_type != none {
    // Container, Optional, Refined: deps from the element/inner type
    type_expr_deps(expr: n.return_type.value)
  } else {
    // Map or other: collect from children
    flat_map(n.children, child => node_type_deps(n: child))
  }
}

fn is_int_type(type_expr: TypeExpr) -> Bool {
  match normalize_access_type(type_expr: type_expr) {
    Primitive { name: name, span: _ } => name == "Int"
    _ => false
  }
}

fn is_string_type(type_expr: TypeExpr) -> Bool {
  match normalize_access_type(type_expr: type_expr) {
    Primitive { name: name, span: _ } => name == "String"
    _ => false
  }
}

fn access_error(message: String, span: SourceSpan, module_name: String) -> Diagnostic {
  Diagnostic {
    severity: Error,
    message: message,
    span: Some { value: span },
    module_name: Some { value: module_name }
  }
}

fn inference_error(message: String, span: SourceSpan, module_name: String) -> Diagnostic {
  Diagnostic {
    severity: Error,
    message: message,
    span: Some { value: span },
    module_name: Some { value: module_name }
  }
}

fn check_index_access(base_type: TypeExpr, index_type: TypeExpr, span: SourceSpan, module_name: String) -> AccessCheckResult {
  match normalize_access_type(type_expr: base_type) {
    Primitive { name: name, span: _ } =>
      if name == "String" {
        let diags = if is_int_type(type_expr: index_type) {
          []
        } else {
          [access_error(
            message: "string index requires an Int index",
            span: span,
            module_name: module_name
          )]
        }
        AccessCheckResult {
          resolved_type: Primitive { name: "String", span: no_span() },
          diagnostics: diags
        }
      } else {
        AccessCheckResult {
          resolved_type: unit_type(),
          diagnostics: [access_error(
            message: "indexing is only supported for String and Map values",
            span: span,
            module_name: module_name
          )]
        }
      }
    MapType { key: key, value: value, span: _ } =>
      let diags = if type_expr_equals(left: key, right: index_type) {
        []
      } else {
        [access_error(
          message: "map index key type does not match the map key type",
          span: span,
          module_name: module_name
        )]
      }
      AccessCheckResult {
        resolved_type: Optional { inner: value, span: no_span() },
        diagnostics: diags
      }
    _ =>
      AccessCheckResult {
        resolved_type: unit_type(),
        diagnostics: [access_error(
          message: "indexing is only supported for String and Map values",
          span: span,
          module_name: module_name
        )]
      }
  }
}

fn check_slice_access(base_type: TypeExpr, start_type: TypeExpr, end_type: TypeExpr, span: SourceSpan, module_name: String) -> AccessCheckResult {
  let base_diags = if is_string_type(type_expr: base_type) {
    []
  } else {
    [access_error(
      message: "slice is only supported for String values",
      span: span,
      module_name: module_name
    )]
  }
  let start_diags = if is_int_type(type_expr: start_type) {
    []
  } else {
    [access_error(
      message: "slice start requires an Int index",
      span: span,
      module_name: module_name
    )]
  }
  let end_diags = if is_int_type(type_expr: end_type) {
    []
  } else {
    [access_error(
      message: "slice end requires an Int index",
      span: span,
      module_name: module_name
    )]
  }
  AccessCheckResult {
    resolved_type: if is_string_type(type_expr: base_type) {
      Primitive { name: "String", span: no_span() }
    } else {
      unit_type()
    },
    diagnostics: concat(base_diags, start_diags, end_diags)
  }
}

fn infer_binop_type(op: BinOpKind, left_type: TypeExpr) -> TypeExpr {
  match op {
    // Arithmetic: result is same as left operand
    Add => left_type
    Sub => left_type
    Mul => left_type
    Div => left_type
    Mod => left_type
    // Comparison: result is Bool
    BinEq => Primitive { name: "Bool", span: no_span() }
    BinNe => Primitive { name: "Bool", span: no_span() }
    BinLt => Primitive { name: "Bool", span: no_span() }
    BinGt => Primitive { name: "Bool", span: no_span() }
    BinLe => Primitive { name: "Bool", span: no_span() }
    BinGe => Primitive { name: "Bool", span: no_span() }
    // Logical: result is Bool
    BinAnd => Primitive { name: "Bool", span: no_span() }
    BinOr => Primitive { name: "Bool", span: no_span() }
    // NullCoalesce: unwrap Optional to inner type
    NullCoalesce => extract_optional_inner(type_expr: left_type)
  }
}

// -------------------------------------------------------------------------
// extract_optional_inner: unwrap Optional<T> to T; if not Optional, return as-is
// -------------------------------------------------------------------------

fn extract_optional_inner(type_expr: TypeExpr) -> TypeExpr {
  match type_expr {
    Optional { inner: inner, span: _ } => inner
    _ => type_expr
  }
}

// -------------------------------------------------------------------------
// infer_method_call_type: compute result type for pipe methods
// -------------------------------------------------------------------------

fn infer_method_call_type(receiver_type: TypeExpr, method: String) -> TypeExpr {
  // Extract the element type from Container types
  let elem_type = match receiver_type {
    Container { kind: _, element: el, span: _ } => el
    _ => receiver_type
  }
  if method == "map" {
    // map preserves container kind but element type comes from context;
    // without bidirectional typing, return the same container shape
    receiver_type
  } else {
    if method == "filter" {
      // filter preserves the full container type
      receiver_type
    } else {
      if method == "fold" {
        // fold returns the accumulator type; without more info, Unit
        unit_type()
      } else {
        if method == "first" {
          // first returns Optional<element>
          Optional { inner: elem_type, span: no_span() }
        } else {
          if method == "last" {
            // last returns Optional<element>
            Optional { inner: elem_type, span: no_span() }
          } else {
            if method == "count" {
              Primitive { name: "Int", span: no_span() }
            } else {
              if method == "join" {
                Primitive { name: "String", span: no_span() }
              } else {
                if method == "any" {
                  Primitive { name: "Bool", span: no_span() }
                } else {
                  if method == "contains" {
                    Primitive { name: "Bool", span: no_span() }
                  } else {
                    if method == "enumerate" {
                      // enumerate wraps elements in (index, element) pairs;
                      // keep as container for now
                      receiver_type
                    } else {
                      // Unknown method — fall back to Unit
                      unit_type()
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

// -------------------------------------------------------------------------
// build_params_scope: add function params to locals in an InferScope
// -------------------------------------------------------------------------

fn build_params_scope(scope: InferScope, params: List<Param>) -> InferScope {
  let new_locals = fold(params, init: scope.locals, f: (acc, p) =>
    map_insert(acc, p.name, TypeBinding { name: p.name, resolved: p.type_expr, resolved_node: none })
  )
  InferScope {
    type_env: scope.type_env,
    func_env: scope.func_env,
    locals: new_locals,
    module_name: scope.module_name,
    type_cache: scope.type_cache,
    service_registry: scope.service_registry
  }
}

// -------------------------------------------------------------------------
// extend_scope: add a single local binding to an InferScope
// -------------------------------------------------------------------------

fn extend_scope(scope: InferScope, name: String, resolved: TypeExpr) -> InferScope {
  InferScope {
    type_env: scope.type_env,
    func_env: scope.func_env,
    locals: map_insert(scope.locals, name, TypeBinding { name: name, resolved: resolved, resolved_node: none }),
    module_name: scope.module_name,
    type_cache: scope.type_cache,
    service_registry: scope.service_registry
  }
}

fn scope_after_stmt(stmt: Expr, stmt_type: TypeExpr, scope: InferScope) -> InferScope {
  match stmt {
    Let { name: name, value: _, body: body, span: _ } =>
      if body == none {
        extend_scope(scope: scope, name: name, resolved: stmt_type)
      } else {
        scope
      }
    _ => scope
  }
}

fn for_each_element_type(type_expr: TypeExpr) -> TypeExpr {
  match normalize_access_type(type_expr: type_expr) {
    Container { kind: _, element: element, span: _ } => element
    Primitive { name: name, span: _ } =>
      if name == "String" {
        Primitive { name: "String", span: no_span() }
      } else {
        unit_type()
      }
    _ => unit_type()
  }
}

// -------------------------------------------------------------------------
// infer_expr: the main recursive function
//
// For each Expr variant, produce a TypedExpr wrapping the original expr
// with its resolved type. Diagnostics are threaded through for reporting.
// -------------------------------------------------------------------------

fn infer_expr(expr: Expr, scope: InferScope) -> InferResult {
  match expr {
    Literal { value: lit, span: span } =>
      ok_infer(texpr: TypedLiteral { value: lit, resolved_type: infer_literal(lit: lit), span: span })

    Var { name: name, span: span } =>
      let value_match = lookup_in_scope(scope: scope, name: name)
      match value_match {
        Some { value: resolved } =>
          ok_infer(texpr: TypedVar { name: name, resolved_type: resolved, span: span })
        None =>
          let texpr = TypedVar { name: name, resolved_type: unit_type(), span: span }
          InferResult {
            typed: texpr,
            diagnostics: [inference_error(
              message: concat("undefined variable '", name, "'"),
              span: span,
              module_name: scope.module_name
            )],
            type_entries: [span_entry_typed(texpr: texpr)]
          }
      }

    FieldAccess { base: base_expr, field: field_name, span: span } =>
      let base_result = infer_expr(expr: base_expr, scope: scope)
      let base_type = base_result.typed.resolved_type
      match lookup_field_type(type_expr: base_type, field_name: field_name) {
        Some { value: field_type } =>
          let texpr = TypedFieldAccess { base: base_result.typed, field: field_name, resolved_type: field_type, span: span }
          InferResult {
            typed: texpr,
            diagnostics: base_result.diagnostics,
            type_entries: concat(base_result.type_entries, [span_entry_typed(texpr: texpr)])
          }
        None =>
          match check_service_field_access(base_type: base_type, field: field_name, scope: scope) {
            Some { value: svc_type } =>
              let texpr = TypedFieldAccess { base: base_result.typed, field: field_name, resolved_type: svc_type, span: span }
              InferResult {
                typed: texpr,
                diagnostics: base_result.diagnostics,
                type_entries: concat(base_result.type_entries, [span_entry_typed(texpr: texpr)])
              }
            None =>
              let texpr = TypedFieldAccess { base: base_result.typed, field: field_name, resolved_type: unit_type(), span: span }
              InferResult {
                typed: texpr,
                diagnostics: concat(base_result.diagnostics, [inference_error(
                  message: concat("no field '", field_name, "' on type"),
                  span: span,
                  module_name: scope.module_name
                )]),
                type_entries: concat(base_result.type_entries, [span_entry_typed(texpr: texpr)])
              }
          }
      }

    Call { func: func_name, args: call_args, span: span } =>
      let arg_results = call_args |> map(a => infer_expr(expr: a.value, scope: scope))
      let typed_args = call_args |> enumerate |> map(pair =>
        let a = pair.second
        let ar = match skip(arg_results, pair.first) |> first {
          Some { value: r } => r
          None => ok_infer(texpr: TypedLiteral { value: LitNull, resolved_type: unit_type(), span: no_span() })
        }
        TypedNamedArg { name: a.name, value: ar.typed }
      )
      let arg_diags = flat_map(arg_results, r => r.diagnostics)
      let arg_entries = flat_map(arg_results, r => r.type_entries)
      let sig = lookup_func_sig(func_env: scope.func_env, name: func_name)
      let resolved_type = if sig == none {
        let type_match = lookup_type(env: scope.type_env, name: func_name)
        match type_match {
          Some { value: te } => te
          None => unit_type()
        }
      } else {
        match sig {
          Some { value: s } => s.return_type
          None => unit_type()
        }
      }
      let texpr = TypedCall { func: func_name, args: typed_args, resolved_type: resolved_type, span: span }
      InferResult {
        typed: texpr,
        diagnostics: arg_diags,
        type_entries: concat(arg_entries, [span_entry_typed(texpr: texpr)])
      }

    MethodCall { receiver: recv, method: method_name, args: mc_args, span: span } =>
      let recv_result = infer_expr(expr: recv, scope: scope)
      let recv_type = recv_result.typed.resolved_type
      let mc_arg_results = mc_args |> map(a => infer_expr(expr: a.value, scope: scope))
      let typed_mc_args = mc_args |> enumerate |> map(pair =>
        let a = pair.second
        let ar = match skip(mc_arg_results, pair.first) |> first {
          Some { value: r } => r
          None => ok_infer(texpr: TypedLiteral { value: LitNull, resolved_type: unit_type(), span: no_span() })
        }
        TypedNamedArg { name: a.name, value: ar.typed }
      )
      let mc_arg_diags = flat_map(mc_arg_results, r => r.diagnostics)
      let mc_arg_entries = flat_map(mc_arg_results, r => r.type_entries)
      let result_type = match check_service_method_call(receiver_type: recv_type, method: method_name, scope: scope) {
        Some { value: svc_type } => svc_type
        None => infer_method_call_type(receiver_type: recv_type, method: method_name)
      }
      let texpr = TypedMethodCall { receiver: recv_result.typed, method: method_name, args: typed_mc_args, resolved_type: result_type, span: span }
      InferResult {
        typed: texpr,
        diagnostics: concat(recv_result.diagnostics, mc_arg_diags),
        type_entries: concat(recv_result.type_entries, mc_arg_entries, [span_entry_typed(texpr: texpr)])
      }

    Match { scrutinee: scrut, arms: arms, span: span } =>
      let scrut_result = infer_expr(expr: scrut, scope: scope)
      let typed_arms = arms |> map(arm =>
        let guard_result = if arm.guard != none {
          Some { value: infer_expr(expr: arm.guard.value, scope: scope) }
        } else {
          none
        }
        let body_result = infer_expr(expr: arm.body, scope: scope)
        TypedMatchArm {
          pattern: arm.pattern,
          guard: if guard_result != none { Some { value: guard_result.value.typed } } else { none },
          body: body_result.typed
        }
      )
      let arm_body_results = arms |> map(arm => infer_expr(expr: arm.body, scope: scope))
      let arm_diags = flat_map(arm_body_results, ar => ar.diagnostics)
      let arm_entries = flat_map(arm_body_results, ar => ar.type_entries)
      let result_type = if count(arm_body_results) > 0 {
        match first(arm_body_results) {
          Some { value: ar } => ar.typed.resolved_type
          None => unit_type()
        }
      } else {
        unit_type()
      }
      let texpr = TypedMatch { scrutinee: scrut_result.typed, arms: typed_arms, resolved_type: result_type, span: span }
      InferResult {
        typed: texpr,
        diagnostics: concat(scrut_result.diagnostics, arm_diags),
        type_entries: concat(scrut_result.type_entries, arm_entries, [span_entry_typed(texpr: texpr)])
      }

    If { condition: cond, then_branch: then_expr, else_branch: else_expr, span: span } =>
      let cond_result = infer_expr(expr: cond, scope: scope)
      let then_result = infer_expr(expr: then_expr, scope: scope)
      match else_expr {
        Some { value: else_branch } =>
          let else_result = infer_expr(expr: else_branch, scope: scope)
          let branch_diags = if type_expr_equals(
            left: then_result.typed.resolved_type,
            right: else_result.typed.resolved_type
          ) {
            []
          } else {
            [inference_error(
              message: concat(
                "if branches resolve to incompatible types: ",
                type_expr_shape(type_expr: then_result.typed.resolved_type),
                " vs ",
                type_expr_shape(type_expr: else_result.typed.resolved_type)
              ),
              span: span,
              module_name: scope.module_name
            )]
          }
          let resolved_type = if count(branch_diags) > 0 {
            unit_type()
          } else {
            then_result.typed.resolved_type
          }
          let texpr = TypedIf { condition: cond_result.typed, then_branch: then_result.typed, else_branch: Some { value: else_result.typed }, resolved_type: resolved_type, span: span }
          InferResult {
            typed: texpr,
            diagnostics: concat(cond_result.diagnostics, then_result.diagnostics, else_result.diagnostics, branch_diags),
            type_entries: concat(cond_result.type_entries, then_result.type_entries, else_result.type_entries, [span_entry_typed(texpr: texpr)])
          }
        None =>
          let texpr = TypedIf { condition: cond_result.typed, then_branch: then_result.typed, else_branch: none, resolved_type: unit_type(), span: span }
          InferResult {
            typed: texpr,
            diagnostics: concat(cond_result.diagnostics, then_result.diagnostics),
            type_entries: concat(cond_result.type_entries, then_result.type_entries, [span_entry_typed(texpr: texpr)])
          }
      }

    Let { name: let_name, value: let_value, body: let_body, span: span } =>
      let val_result = infer_expr(expr: let_value, scope: scope)
      let val_type = val_result.typed.resolved_type
      if let_body == none {
        let texpr = TypedLet { name: let_name, value: val_result.typed, body: none, resolved_type: val_type, span: span }
        InferResult {
          typed: texpr,
          diagnostics: val_result.diagnostics,
          type_entries: concat(val_result.type_entries, [span_entry_typed(texpr: texpr)])
        }
      } else {
        let extended = extend_scope(scope: scope, name: let_name, resolved: val_type)
        let body_result = infer_expr(expr: let_body.value, scope: extended)
        let texpr = TypedLet { name: let_name, value: val_result.typed, body: Some { value: body_result.typed }, resolved_type: body_result.typed.resolved_type, span: span }
        InferResult {
          typed: texpr,
          diagnostics: concat(val_result.diagnostics, body_result.diagnostics),
          type_entries: concat(val_result.type_entries, body_result.type_entries, [span_entry_typed(texpr: texpr)])
        }
      }

    RecordLit { type_name: tn, fields: field_inits, span: span } =>
      infer_record_lit(type_name: tn, field_inits: field_inits, span: span, scope: scope)

    ListLit { elements: elements, span: span } =>
      let elem_results = elements |> map(e => infer_expr(expr: e, scope: scope))
      let typed_elements = elem_results |> map(r => r.typed)
      let elem_diags = flat_map(elem_results, r => r.diagnostics)
      let elem_entries = flat_map(elem_results, r => r.type_entries)
      let elem_type = if count(elem_results) > 0 {
        match first(elem_results) {
          Some { value: r } => r.typed.resolved_type
          None => unit_type()
        }
      } else {
        unit_type()
      }
      let list_type = Container { kind: List, element: elem_type, span: no_span() }
      let texpr = TypedListLit { elements: typed_elements, resolved_type: list_type, span: span }
      InferResult {
        typed: texpr,
        diagnostics: elem_diags,
        type_entries: concat(elem_entries, [span_entry_typed(texpr: texpr)])
      }

    BinOp { op: op, left: left_expr, right: right_expr, span: span } =>
      let left_result = infer_expr(expr: left_expr, scope: scope)
      let right_result = infer_expr(expr: right_expr, scope: scope)
      let result_type = infer_binop_type(op: op, left_type: left_result.typed.resolved_type)
      let texpr = TypedBinOp { op: op, left: left_result.typed, right: right_result.typed, resolved_type: result_type, span: span }
      InferResult {
        typed: texpr,
        diagnostics: concat(left_result.diagnostics, right_result.diagnostics),
        type_entries: concat(left_result.type_entries, right_result.type_entries, [span_entry_typed(texpr: texpr)])
      }

    UnaryOp { op: op, operand: operand_expr, span: span } =>
      let operand_result = infer_expr(expr: operand_expr, scope: scope)
      let result_type = match op {
        Not => Primitive { name: "Bool", span: no_span() }
        Neg => operand_result.typed.resolved_type
      }
      let texpr = TypedUnaryOp { op: op, operand: operand_result.typed, resolved_type: result_type, span: span }
      InferResult {
        typed: texpr,
        diagnostics: operand_result.diagnostics,
        type_entries: concat(operand_result.type_entries, [span_entry_typed(texpr: texpr)])
      }

    Lambda { params: lam_params, body: lam_body, span: span } =>
      let body_result = infer_expr(expr: lam_body, scope: scope)
      let texpr = TypedLambda { params: lam_params, body: body_result.typed, resolved_type: unit_type(), span: span }
      InferResult {
        typed: texpr,
        diagnostics: body_result.diagnostics,
        type_entries: concat(body_result.type_entries, [span_entry_typed(texpr: texpr)])
      }

    StringInterp { parts: str_parts, span: span } =>
      let typed_parts = str_parts |> map(p => match p {
        Text { value: v } => TypedText { value: v }
        Interpolation { expr: e } =>
          let r = infer_expr(expr: e, scope: scope)
          TypedInterpolation { expr: r.typed }
      })
      let interp_results = str_parts |> flat_map(p => match p {
        Interpolation { expr: e } => [infer_expr(expr: e, scope: scope)]
        _ => []
      })
      let interp_diags = flat_map(interp_results, r => r.diagnostics)
      let interp_entries = flat_map(interp_results, r => r.type_entries)
      let str_type = Primitive { name: "String", span: no_span() }
      let texpr = TypedStringInterp { parts: typed_parts, resolved_type: str_type, span: span }
      InferResult {
        typed: texpr,
        diagnostics: interp_diags,
        type_entries: concat(interp_entries, [span_entry_typed(texpr: texpr)])
      }

    Block { stmts: stmts, span: span } =>
      if count(stmts) > 0 {
        let state = fold(stmts, init: BlockInferState {
          scope: scope,
          diag_chunks: [],
          last_type: unit_type(),
          entry_chunks: []
        }, f: (acc, stmt) =>
          let stmt_result = infer_expr(expr: stmt, scope: acc.scope)
          let next_scope = scope_after_stmt(
            stmt: stmt,
            stmt_type: stmt_result.typed.resolved_type,
            scope: acc.scope
          )
          BlockInferState {
            scope: next_scope,
            diag_chunks: concat(acc.diag_chunks, [stmt_result.diagnostics]),
            last_type: stmt_result.typed.resolved_type,
            entry_chunks: concat(acc.entry_chunks, [stmt_result.type_entries])
          }
        )
        let block_stmts_typed = stmts |> map(s => (infer_expr(expr: s, scope: scope)).typed)
        let texpr = TypedBlock { stmts: block_stmts_typed, resolved_type: state.last_type, span: span }
        InferResult {
          typed: texpr,
          diagnostics: flat_map(state.diag_chunks, c => c),
          type_entries: concat(flat_map(state.entry_chunks, c => c), [span_entry_typed(texpr: texpr)])
        }
      } else {
        ok_infer(texpr: TypedBlock { stmts: [], resolved_type: unit_type(), span: span })
      }

    Cast { expr: cast_inner, target: target_type, span: span } =>
      let inner_result = infer_expr(expr: cast_inner, scope: scope)
      let texpr = TypedCast { expr: inner_result.typed, target: target_type, resolved_type: target_type, span: span }
      InferResult {
        typed: texpr,
        diagnostics: inner_result.diagnostics,
        type_entries: concat(inner_result.type_entries, [span_entry_typed(texpr: texpr)])
      }

    ForEach { variable: variable, collection: coll, body: body_expr, span: span } =>
      let coll_result = infer_expr(expr: coll, scope: scope)
      let elem_type = for_each_element_type(type_expr: coll_result.typed.resolved_type)
      let body_scope = extend_scope(scope: scope, name: variable, resolved: elem_type)
      let body_result = infer_expr(expr: body_expr, scope: body_scope)
      let texpr = TypedForEach { variable: variable, collection: coll_result.typed, body: body_result.typed, resolved_type: unit_type(), span: span }
      InferResult {
        typed: texpr,
        diagnostics: concat(coll_result.diagnostics, body_result.diagnostics),
        type_entries: concat(coll_result.type_entries, body_result.type_entries, [span_entry_typed(texpr: texpr)])
      }

    Index { base: base_expr, index: index_expr, span: span } =>
      let base_result = infer_expr(expr: base_expr, scope: scope)
      let index_result = infer_expr(expr: index_expr, scope: scope)
      let index_check = check_index_access(
        base_type: base_result.typed.resolved_type,
        index_type: index_result.typed.resolved_type,
        span: span,
        module_name: scope.module_name
      )
      let texpr = TypedIndex { base: base_result.typed, index: index_result.typed, resolved_type: index_check.resolved_type, span: span }
      InferResult {
        typed: texpr,
        diagnostics: concat(base_result.diagnostics, index_result.diagnostics, index_check.diagnostics),
        type_entries: concat(base_result.type_entries, index_result.type_entries, [span_entry_typed(texpr: texpr)])
      }

    Slice { base: base_expr, start: start_expr, end: end_expr, span: span } =>
      let base_result = infer_expr(expr: base_expr, scope: scope)
      let start_result = infer_expr(expr: start_expr, scope: scope)
      let end_result = infer_expr(expr: end_expr, scope: scope)
      let slice_check = check_slice_access(
        base_type: base_result.typed.resolved_type,
        start_type: start_result.typed.resolved_type,
        end_type: end_result.typed.resolved_type,
        span: span,
        module_name: scope.module_name
      )
      let texpr = TypedSlice { base: base_result.typed, start: start_result.typed, end: end_result.typed, resolved_type: slice_check.resolved_type, span: span }
      InferResult {
        typed: texpr,
        diagnostics: concat(base_result.diagnostics, start_result.diagnostics, end_result.diagnostics, slice_check.diagnostics),
        type_entries: concat(base_result.type_entries, start_result.type_entries, end_result.type_entries, [span_entry_typed(texpr: texpr)])
      }

    // Fallback for any unrecognized variant
    _ => ok_infer(texpr: TypedLiteral { value: LitNull, resolved_type: unit_type(), span: SourceSpan { start: 0, end: 0 } })
  }
}

// -------------------------------------------------------------------------
// infer_record_lit: helper for RecordLit inference
//
// type_name is String? — handle with == none check per v1 codegen limitation.
// If type_name given, look up in type_env; else construct anonymous Product.
// -------------------------------------------------------------------------

fn infer_record_lit(type_name: String?, field_inits: List<FieldInit>, span: SourceSpan, scope: InferScope) -> InferResult {
  let fi_results = map(field_inits, fi => infer_expr(expr: fi.value, scope: scope))
  let typed_fields = field_inits |> enumerate |> map(pair =>
    let fi = pair.second
    let fi_result = match skip(fi_results, pair.first) |> first {
      Some { value: p } => p
      None => ok_infer(texpr: TypedLiteral { value: LitNull, resolved_type: unit_type(), span: no_span() })
    }
    TypedFieldInit { name: fi.name, value: fi_result.typed }
  )
  let fi_diags = flat_map(fi_results, r => r.diagnostics)
  let fi_entries = flat_map(fi_results, r => r.type_entries)
  if type_name == none {
    // Anonymous record — construct Product from field inits
    let field_types = field_inits |> enumerate |> map(pair =>
      let fi = pair.second
      let fi_result = match skip(fi_results, pair.first) |> first {
        Some { value: p } => p
        None => ok_infer(texpr: TypedLiteral { value: LitNull, resolved_type: unit_type(), span: no_span() })
      }
      Field {
        name: fi.name,
        type_expr: fi_result.typed.resolved_type,
        optional: false,
        default_value: none,
        from_key: none,
        span: no_span()
      }
    )
    let anon_type = Product { name: none, fields: field_types, span: no_span() }
    let texpr = TypedRecordLit { type_name: none, fields: typed_fields, resolved_type: anon_type, span: span }
    InferResult {
      typed: texpr,
      diagnostics: fi_diags,
      type_entries: concat(fi_entries, [span_entry_typed(texpr: texpr)])
    }
  } else {
    // Named record — look up type in env
    let resolved_type = match lookup_type(env: scope.type_env, name: type_name.value) {
      Some { value: te } => te
      None => Named { name: type_name.value, span: no_span() }
    }
    let texpr = TypedRecordLit { type_name: type_name, fields: typed_fields, resolved_type: resolved_type, span: span }
    InferResult {
      typed: texpr,
      diagnostics: fi_diags,
      type_entries: concat(fi_entries, [span_entry_typed(texpr: texpr)])
    }
  }
}

// -------------------------------------------------------------------------
// infer_item: wraps each Node into its TypedNode counterpart
// -------------------------------------------------------------------------

fn infer_item(item: Node, scope: InferScope) -> TypedItemResult {
  // Type definition: has connective (record/sum) and is not a transport binding
  if item.connective != none && item.transport == none {
    TypedItemResult {
      item: TypedNode {
        name: item.name, span: item.span, children: item.children |> map(c => infer_item(item: c, scope: scope).item), params: item.params,
        return_type: unit_type(), uses: item.uses, body: none,
        connective: item.connective, transport: item.transport,
        properties: item.properties, type_annotation: item.type_annotation,
        config: item.config
      },
      diagnostics: [], type_entries: []
    }
  }
  // Function with body: infer body, resolve return type
  else if item.body != none && item.params |> count > 0 {
    let fn_scope = build_params_scope(scope: scope, params: item.params)
    let body_result = infer_expr(expr: item.body.value, scope: fn_scope)
    let resolved_ret = if item.return_type == none {
      body_result.typed.resolved_type
    } else {
      item.return_type.value
    }
    TypedItemResult {
      item: TypedNode {
        name: item.name, span: item.span, children: item.children |> map(c => infer_item(item: c, scope: scope).item), params: item.params,
        return_type: resolved_ret, uses: item.uses, body: Some { value: body_result.typed },
        connective: none, transport: item.transport,
        properties: item.properties, type_annotation: item.type_annotation,
        config: item.config
      },
      diagnostics: body_result.diagnostics, type_entries: body_result.type_entries
    }
  }
  // Data definition: has body but no params, has type_annotation
  else if item.body != none && item.params |> count == 0 {
    let val_result = infer_expr(expr: item.body.value, scope: scope)
    let resolved_ret = if item.type_annotation == none { val_result.typed.resolved_type } else { item.type_annotation.value }
    TypedItemResult {
      item: TypedNode {
        name: item.name, span: item.span, children: [], params: [],
        return_type: resolved_ret, uses: [], body: Some { value: val_result.typed },
        connective: none, transport: item.transport,
        properties: item.properties, type_annotation: item.type_annotation,
        config: item.config
      },
      diagnostics: val_result.diagnostics, type_entries: val_result.type_entries
    }
  }
  // Extern func: has params but no body
  else if item.params |> count > 0 && item.body == none {
    let resolved_ret = if item.return_type == none { unit_type() } else { item.return_type.value }
    TypedItemResult {
      item: TypedNode {
        name: item.name, span: item.span, children: item.children |> map(c => infer_item(item: c, scope: scope).item), params: item.params,
        return_type: resolved_ret, uses: item.uses, body: none,
        connective: none, transport: item.transport,
        properties: item.properties, type_annotation: item.type_annotation,
        config: item.config
      },
      diagnostics: [], type_entries: []
    }
  }
  // Service/Resource/other: pass through
  else {
    let resolved_ret = if item.return_type == none { unit_type() } else { item.return_type.value }
    TypedItemResult {
      item: TypedNode {
        name: item.name, span: item.span, children: item.children |> map(c => infer_item(item: c, scope: scope).item), params: item.params,
        return_type: resolved_ret, uses: item.uses, body: none,
        connective: item.connective, transport: item.transport,
        properties: item.properties, type_annotation: item.type_annotation,
        config: item.config
      },
      diagnostics: [], type_entries: []
    }
  }
}

// -------------------------------------------------------------------------
// infer_items: walk all items in a module and produce TypedNodes
// -------------------------------------------------------------------------

fn infer_items(items: List<Node>, scope: InferScope) -> List<TypedItemResult> {
  map(items, item => infer_item(item: item, scope: scope))
}

// =========================================================================
// Kernel type environment
//
// The 8 kernel primitives that have no structural expansion.
// These are the atoms of the type system — everything else is
// composed from them.
// =========================================================================

// Kernel primitives (String, Int, Bool, Float, Secret, Json, Unit, Bytes)
// are now defined as bare type declarations in dsl/std/types.dag.
// std.types is always first in compilation order, so all modules receive
// primitive bindings through imports.

// =========================================================================
// Type environment lookup
// =========================================================================

fn lookup_type(env: TypeEnv, name: String) -> TypeExpr? {
  // Normalize the query (strips module prefix, generic params) to match stored keys.
  // Stored binding names are already unqualified, so this is a single O(1) lookup.
  let canonical = normalize_type_name(name: name)
  match map_get(env.bindings, canonical) {
    Some { value: binding } => Some { value: binding.resolved }
    None => None
  }
}

// B1 migration: Node-based type lookup.
// Returns the Node representation of a type from the environment.
fn lookup_type_node(env: TypeEnv, name: String) -> Node? {
  let canonical = normalize_type_name(name: name)
  match map_get(env.bindings, canonical) {
    Some { value: binding } => binding.resolved_node
    None => None
  }
}

// =========================================================================
// Environment merging
//
// Combines multiple type environments. Later bindings shadow earlier ones
// (last-writer-wins), which matches the import resolution order: kernel
// first, then transitive deps, then direct imports, then local defs.
// =========================================================================

fn merge_envs(envs: List<TypeEnv>) -> TypeEnv {
  // Merge maps in order: later entries overwrite earlier ones (last-writer-wins),
  // matching the import resolution order: kernel < imports < local.
  fold(envs, init: TypeEnv { bindings: empty_map(), recursive_types: [] }, f: (acc, env) =>
    TypeEnv { bindings: map_merge(acc.bindings, env.bindings), recursive_types: [] }
  )
}

// =========================================================================
// Cycle detection: precompute which types participate in dependency cycles.
//
// Instead of threading a growing resolving list through resolution (O(d²)
// memory from repeated concat), we compute cycle membership once at env
// construction time. resolve_type_expr then uses the precomputed set:
// Named references to cycle members are kept as Named; all others expand.
// =========================================================================

// Extract Named type references from a TypeExpr (direct dependencies).
fn type_expr_deps(expr: TypeExpr) -> List<String> {
  match expr {
    Named { name: name, span: _ } => [name]
    Primitive { name: _, span: _ } => []
    Product { name: _, fields: fields, span: _ } =>
      flat_map(fields, f => type_expr_deps(expr: f.type_expr))
    Coproduct { name: _, variants: variants, span: _ } =>
      flat_map(variants, v => flat_map(v.fields, f => type_expr_deps(expr: f.type_expr)))
    Container { kind: _, element: element, span: _ } => type_expr_deps(expr: element)
    Optional { inner: inner, span: _ } => type_expr_deps(expr: inner)
    Refined { base: base, predicates: _, span: _ } => type_expr_deps(expr: base)
    MapType { key: key, value: value, span: _ } =>
      concat(type_expr_deps(expr: key), type_expr_deps(expr: value))
  }
}

// Check if a type name can reach itself through the dependency graph.
fn reaches_self(root: String, current: String, bindings: Map<String, TypeBinding>, visited: List<String>) -> Bool {
  if any(visited, v => v == current) {
    false
  } else {
    match map_get(bindings, current) {
      Some { value: binding } =>
        let deps = type_expr_deps(expr: binding.resolved)
        // Pre-compute outside the any() loop so visited is consumed once,
        // then next_visited is cloned per iteration (not visited).
        let next_visited = concat(visited, [current])
        any(deps, d =>
          if d == root { true }
          else { reaches_self(root: root, current: d, bindings: bindings, visited: next_visited) }
        )
      None => false
    }
  }
}

// Detect all type names that participate in dependency cycles.
// Split into two functions: detect_type_cycles consumes `bindings` for
// map_values AND passes it as an argument (use_count=2, emitter clones);
// filter_recursive_bindings receives its own copy for the lambda capture.
fn detect_type_cycles(bindings: Map<String, TypeBinding>) -> List<String> {
  let lookup = bindings
  filter_recursive_bindings(binding_list: map_values(bindings), bindings: lookup)
}

fn filter_recursive_bindings(binding_list: List<TypeBinding>, bindings: Map<String, TypeBinding>) -> List<String> {
  let recursive = filter(binding_list, b => reaches_self(root: b.name, current: b.name, bindings: bindings, visited: []))
  map(recursive, b => b.name)
}

// =========================================================================
// Build type environment for a single module
//
// Layers (in shadowing order, last wins):
//   1. Kernel primitives (String, Int, Bool, ...)
//   2. Imported types from parent environments
//   3. Local type definitions from the module's items
// =========================================================================

fn build_type_env(module: ResolvedModule, parent_index: Map<String, TypedModule>) -> BuildTypeEnvResult {
  // Seed the kernel with primitive types so they resolve even when
  // std.types is not in the compilation set (e.g., in isolated tests).
  let zero_span = SourceSpan { start: 0, end: 0 }
  let kernel_bindings = fold(
    ["String", "Int", "Bool", "Float", "Secret", "Json", "Unit", "Bytes"],
    init: empty_map(),
    f: (acc, name) => map_insert(acc, name, TypeBinding {
      name: name,
      resolved: Primitive { name: name, span: zero_span },
      resolved_node: Some { value: Node {
        name: name, span: zero_span, children: [], connective: none,
        params: [], return_type: none, uses: [], body: none,
        transport: none, properties: [], type_annotation: none, config: none
      } }
    })
  )
  let kernel = TypeEnv { bindings: kernel_bindings, recursive_types: [] }

  // Collect imported type bindings from parent modules.
  // For type resolution to work on imported types (e.g., FileClassification
  // has a field of type MimeType), we include ALL parent type bindings,
  // not just explicitly named ones. The import list controls what the
  // module author uses directly; resolution needs the transitive picture.
  let import_result = fold(module.resolved_imports, init: BuildTypeEnvResult {
    env: TypeEnv { bindings: empty_map(), recursive_types: [] },
    diagnostics: []
  }, f: (acc, imp) =>
    match map_get(parent_index, imp.module_path) {
      Some { value: typed_parent } =>
        BuildTypeEnvResult {
          env: TypeEnv { bindings: map_merge(acc.env.bindings, typed_parent.type_env.bindings), recursive_types: [] },
          diagnostics: acc.diagnostics
        }
      None =>
        BuildTypeEnvResult {
          env: acc.env,
          diagnostics: concat(acc.diagnostics, [Diagnostic {
            severity: Error,
            message: concat("missing parent environment for imported module '", imp.module_path, "' while typechecking '", module.module.name, "'"),
            span: imp.target_module.value.span,
            module_name: module.module.name
          }])
        }
    }
  )
  let import_env = import_result.env

  // Collect local type definitions from module items.
  // Nodes with capabilities are registered as nominal types so they can be
  // referenced in `uses` clauses (e.g., `uses net: Network`).
  let local_bindings = fold(module.module.items, init: empty_map(), f: (acc, item) =>
    if item.connective != none {
      let resolved = node_to_type_expr(name: item.name, item: item, span: item.span)
      // The source Node IS the type: use it directly as resolved_node
      let type_node = Node {
        name: item.name, span: item.span, children: item.children,
        connective: item.connective, params: [], return_type: none,
        uses: [], body: none, transport: none, properties: [],
        type_annotation: none, config: none
      }
      map_insert(acc, item.name, TypeBinding { name: item.name, resolved: resolved, resolved_node: Some { value: type_node } })
    } else if item.return_type != none && item.params |> count == 0 && item.body == none {
      // Type alias: connective is none, but return_type references the aliased type
      let resolved = match item.return_type.value {
        Primitive { name: _, span: _ } => item.return_type.value
        _ => Named { name: item.name, span: item.span }
      }
      // For aliases, create a leaf node referencing the aliased type
      let alias_node = Node {
        name: item.name, span: item.span, children: [],
        connective: none, params: [], return_type: item.return_type,
        uses: [], body: none, transport: none, properties: [],
        type_annotation: none, config: none
      }
      map_insert(acc, item.name, TypeBinding { name: item.name, resolved: resolved, resolved_node: Some { value: alias_node } })
    } else if item.transport == none && item.children |> count > 0 {
      let ref_node = Node {
        name: item.name, span: item.span, children: [],
        connective: none, params: [],
        return_type: Some { value: Named { name: item.name, span: item.span } },
        uses: [], body: none, transport: none, properties: [],
        type_annotation: none, config: none
      }
      map_insert(acc, item.name, TypeBinding { name: item.name, resolved: Named { name: item.name, span: item.span }, resolved_node: Some { value: ref_node } })
    } else {
      acc
    }
  )
  let local_env = TypeEnv { bindings: local_bindings, recursive_types: [] }

  // Merge in shadowing order: kernel < imports < local.
  let merged = merge_envs(envs: [kernel, import_env, local_env])
  // Precompute which types participate in cycles. Used by resolve_type_expr
  // to break recursive expansion without threading a growing resolving list.
  let cycle_set = detect_type_cycles(bindings: merged.bindings)
  BuildTypeEnvResult {
    env: TypeEnv { bindings: merged.bindings, recursive_types: cycle_set },
    diagnostics: import_result.diagnostics
  }
}

// =========================================================================
// Convert a Node (with connective) to a TypeExpr.
//
// This creates the initial (unresolved) structural form of a type
// definition. Named references within fields/variants remain as Named
// until resolve_type_expr processes them.
//
// Conj → Product (record: all children hold simultaneously)
// Disj → Coproduct (sum: exactly one child holds)
// none with return_type → alias (Primitive passthrough or Named)
// =========================================================================

fn node_to_type_expr(name: String, item: Node, span: SourceSpan) -> TypeExpr {
  match item.connective.value {
    Conj =>
      Product { name: name, fields: map(item.children, child => child_to_field(child: child)), span: span }
    Disj =>
      Coproduct { name: name, variants: map(item.children, child => child_to_variant(child: child)), span: span }
  }
}

// Convert a child Node (field of a record type) to a Field.
// The child's return_type becomes the field's type_expr.
// If return_type is Optional, unwrap to inner type and set optional: true.
fn child_to_field(child: Node) -> Field {
  if child.return_type == none {
    Field {
      name: child.name,
      type_expr: Named { name: child.name, span: child.span },
      optional: false,
      default_value: child.body,
      from_key: none,
      span: child.span
    }
  } else {
    match child.return_type.value {
      Optional { inner: inner, span: _ } =>
        Field {
          name: child.name,
          type_expr: inner,
          optional: true,
          default_value: child.body,
          from_key: none,
          span: child.span
        }
      _ =>
        Field {
          name: child.name,
          type_expr: child.return_type.value,
          optional: false,
          default_value: child.body,
          from_key: none,
          span: child.span
        }
    }
  }
}

// Convert a child Node (variant of a sum type) to a Variant.
// The variant's children are its fields.
fn child_to_variant(child: Node) -> Variant {
  Variant {
    name: child.name,
    fields: map(child.children, c => child_to_field(child: c)),
    span: child.span
  }
}

// =========================================================================
// Resolve a single TypeExpr
//
// Walks the type expression tree, replacing Named references with their
// structural definitions from the environment. Primitives are returned
// as-is. Compound types (Product, Coproduct, Container, etc.) are
// resolved recursively.
//
// Cycle detection uses env.recursive_types (precomputed by detect_type_cycles
// at env construction time). Named references to cycle members are kept
// as Named to break infinite expansion. This replaces the previous approach
// of threading a growing resolving list through all recursive calls.
// =========================================================================

fn resolve_type_expr(expr: TypeExpr, env: TypeEnv, module_name: String) -> ResolveResult {
  match expr {
    Named { name: name, span: span } =>
      // Cycle detection: if this type participates in a dependency cycle,
      // keep it as Named to break infinite expansion. Sound because the
      // name is guaranteed to be defined in the environment.
      if env.recursive_types |> any(r => r == name) {
        ResolveResult { resolved: expr, diagnostics: [], resolved_node: none }
      } else {
        match lookup_type(env: env, name: name) {
          Some { value: resolved } =>
            resolve_type_expr(expr: resolved, env: env, module_name: module_name)
          None =>
            ResolveResult {
              resolved: expr,
              diagnostics: [Diagnostic {
                severity: Error,
                message: concat("unresolved type '", name, "'"),
                span: span,
                module_name: module_name
              }],
              resolved_node: none
            }
        }
      }

    Primitive { name: _, span: _ } =>
      ResolveResult { resolved: expr, diagnostics: [], resolved_node: none }

    Product { name: prod_name, fields: fields, span: span } =>
      let field_results = map(fields, f => resolve_field(field: f, env: env, module_name: module_name))
      let resolved_fields = map(field_results, fr => fr.field)
      let all_diags = flat_map(field_results, fr => fr.diagnostics)
      ResolveResult {
        resolved: Product { name: prod_name, fields: resolved_fields, span: span },
        diagnostics: all_diags,
        resolved_node: none
      }

    Coproduct { name: coprod_name, variants: variants, span: span } =>
      let variant_results = map(variants, v => resolve_variant(variant: v, env: env, module_name: module_name))
      let resolved_variants = map(variant_results, vr => vr.variant)
      let all_diags = flat_map(variant_results, vr => vr.diagnostics)
      ResolveResult {
        resolved: Coproduct { name: coprod_name, variants: resolved_variants, span: span },
        diagnostics: all_diags,
        resolved_node: none
      }

    Container { kind: kind, element: element, span: span } =>
      let elem_result = resolve_type_expr(expr: element, env: env, module_name: module_name)
      ResolveResult {
        resolved: Container { kind: kind, element: elem_result.resolved, span: span },
        diagnostics: elem_result.diagnostics,
        resolved_node: none
      }

    Optional { inner: inner, span: span } =>
      let inner_result = resolve_type_expr(expr: inner, env: env, module_name: module_name)
      ResolveResult {
        resolved: Optional { inner: inner_result.resolved, span: span },
        diagnostics: inner_result.diagnostics,
        resolved_node: none
      }

    Refined { base: base, predicates: predicates, span: span } =>
      let base_result = resolve_type_expr(expr: base, env: env, module_name: module_name)
      ResolveResult {
        resolved: Refined { base: base_result.resolved, predicates: predicates, span: span },
        diagnostics: base_result.diagnostics,
        resolved_node: none
      }

    MapType { key: key, value: value, span: span } =>
      let key_result = resolve_type_expr(expr: key, env: env, module_name: module_name)
      let value_result = resolve_type_expr(expr: value, env: env, module_name: module_name)
      ResolveResult {
        resolved: MapType { key: key_result.resolved, value: value_result.resolved, span: span },
        diagnostics: concat(key_result.diagnostics, value_result.diagnostics),
        resolved_node: none
      }
  }
}

// =========================================================================
// Field resolution
// =========================================================================

fn resolve_field(field: Field, env: TypeEnv, module_name: String) -> FieldResult {
  let type_result = resolve_type_expr(expr: field.type_expr, env: env, module_name: module_name)
  let default_result = if field.default_value == none {
    ExprResolveResult { expr: Literal { value: LitNull, span: no_span() }, diagnostics: [] }
  } else {
    resolve_expr_types(expr: field.default_value.value, env: env, module_name: module_name)
  }
  FieldResult {
    field: Field {
      name: field.name,
      type_expr: type_result.resolved,
      optional: field.optional,
      default_value: if field.default_value == none { none } else { Some { value: default_result.expr } },
      from_key: field.from_key,
      span: field.span
    },
    diagnostics: concat(type_result.diagnostics, default_result.diagnostics)
  }
}

// =========================================================================
// Variant resolution
// =========================================================================

fn resolve_variant(variant: Variant, env: TypeEnv, module_name: String) -> VariantResult {
  let field_results = map(variant.fields, f => resolve_field(field: f, env: env, module_name: module_name))
  let resolved_fields = map(field_results, fr => fr.field)
  let all_diags = flat_map(field_results, fr => fr.diagnostics)
  VariantResult {
    variant: Variant {
      name: variant.name,
      fields: resolved_fields,
      span: variant.span
    },
    diagnostics: all_diags
  }
}

// =========================================================================
// Param resolution
// =========================================================================

fn resolve_param(param: Param, env: TypeEnv, module_name: String) -> ParamResult {
  let type_result = resolve_type_expr(expr: param.type_expr, env: env, module_name: module_name)
  let default_result = if param.default_value == none {
    ExprResolveResult { expr: Literal { value: LitNull, span: no_span() }, diagnostics: [] }
  } else {
    resolve_expr_types(expr: param.default_value.value, env: env, module_name: module_name)
  }
  ParamResult {
    param: Param {
      name: param.name,
      type_expr: type_result.resolved,
      default_value: if param.default_value == none { none } else { Some { value: default_result.expr } },
      span: param.span
    },
    diagnostics: concat(type_result.diagnostics, default_result.diagnostics)
  }
}

// =========================================================================
// Operation resolution
// =========================================================================

// =========================================================================
// ResourceUse resolution
// =========================================================================

fn resolve_resource_use(ru: ResourceUse, env: TypeEnv, module_name: String) -> ResourceUseResult {
  let type_result = resolve_type_expr(expr: ru.resource, env: env, module_name: module_name)
  ResourceUseResult {
    resource_use: ResourceUse {
      name: ru.name,
      resource: type_result.resolved,
      span: ru.span
    },
    diagnostics: type_result.diagnostics
  }
}

// =========================================================================
// Resolve optional TypeExpr (used for return types)
// =========================================================================

fn resolve_optional_type_expr(expr: TypeExpr?, env: TypeEnv, module_name: String) -> ResolveResult {
  // Use field access instead of match on Some/None — the evaluator
  // represents Optional as Map({"value": ...}) without _variant field,
  // so variant pattern matching (Some { value: te }) doesn't work.
  if expr == none {
    let no_span = SourceSpan { start: 0, end: 0 }
    ResolveResult {
      resolved: Primitive { name: "Unit", span: no_span },
      diagnostics: [],
      resolved_node: none
    }
  } else {
    resolve_type_expr(expr: expr.value, env: env, module_name: module_name)
  }
}

fn resolve_named_arg(arg: NamedArg, env: TypeEnv, module_name: String) -> NamedArgResolveResult {
  let value_result = resolve_expr_types(expr: arg.value, env: env, module_name: module_name)
  NamedArgResolveResult {
    arg: NamedArg { name: arg.name, value: value_result.expr },
    diagnostics: value_result.diagnostics
  }
}

fn resolve_field_init(field_init: FieldInit, env: TypeEnv, module_name: String) -> FieldInitResolveResult {
  let value_result = resolve_expr_types(expr: field_init.value, env: env, module_name: module_name)
  FieldInitResolveResult {
    field_init: FieldInit { name: field_init.name, value: value_result.expr },
    diagnostics: value_result.diagnostics
  }
}

fn resolve_match_arm(arm: MatchArm, env: TypeEnv, module_name: String) -> MatchArmResolveResult {
  let guard_result = if arm.guard == none {
    ExprResolveResult { expr: Literal { value: LitNull, span: no_span() }, diagnostics: [] }
  } else {
    resolve_expr_types(expr: arm.guard.value, env: env, module_name: module_name)
  }
  let body_result = resolve_expr_types(expr: arm.body, env: env, module_name: module_name)
  MatchArmResolveResult {
    arm: MatchArm {
      pattern: arm.pattern,
      guard: if arm.guard == none { none } else { Some { value: guard_result.expr } },
      body: body_result.expr
    },
    diagnostics: concat(guard_result.diagnostics, body_result.diagnostics)
  }
}

fn resolve_string_part(part: StringPart, env: TypeEnv, module_name: String) -> StringPartResolveResult {
  match part {
    Text { value: value } =>
      StringPartResolveResult {
        part: Text { value: value },
        diagnostics: []
      }
    Interpolation { expr: expr } =>
      let expr_result = resolve_expr_types(expr: expr, env: env, module_name: module_name)
      StringPartResolveResult {
        part: Interpolation { expr: expr_result.expr },
        diagnostics: expr_result.diagnostics
      }
  }
}

fn resolve_header_def(header: HeaderDef, env: TypeEnv, module_name: String) -> HeaderResolveResult {
  let value_result = resolve_expr_types(expr: header.value, env: env, module_name: module_name)
  HeaderResolveResult {
    header: HeaderDef { name: header.name, value: value_result.expr },
    diagnostics: value_result.diagnostics
  }
}

fn resolve_env_def(env_def: EnvDef, env: TypeEnv, module_name: String) -> EnvDefResolveResult {
  let value_result = resolve_expr_types(expr: env_def.value, env: env, module_name: module_name)
  EnvDefResolveResult {
    env_def: EnvDef { name: env_def.name, value: value_result.expr },
    diagnostics: value_result.diagnostics
  }
}

fn resolve_auth_config(config: AuthConfig, env: TypeEnv, module_name: String) -> AuthConfigResolveResult {
  let token_result = resolve_expr_types(expr: config.token_expr, env: env, module_name: module_name)
  AuthConfigResolveResult {
    config: AuthConfig {
      scheme: config.scheme,
      header: config.header,
      token_expr: token_result.expr
    },
    diagnostics: token_result.diagnostics
  }
}

fn resolve_service_config(config: ServiceConfig, env: TypeEnv, module_name: String) -> ServiceConfigResolveResult {
  let endpoint_result = resolve_expr_types(expr: config.endpoint, env: env, module_name: module_name)
  let auth_result = if config.auth == none {
    ExprResolveResult { expr: Literal { value: LitNull, span: no_span() }, diagnostics: [] }
  } else {
    resolve_expr_types(expr: config.auth.value, env: env, module_name: module_name)
  }
  let rate_result = if config.rate_limit == none {
    ExprResolveResult { expr: Literal { value: LitNull, span: no_span() }, diagnostics: [] }
  } else {
    resolve_expr_types(expr: config.rate_limit.value, env: env, module_name: module_name)
  }
  let retry_result = if config.retry == none {
    ExprResolveResult { expr: Literal { value: LitNull, span: no_span() }, diagnostics: [] }
  } else {
    resolve_expr_types(expr: config.retry.value, env: env, module_name: module_name)
  }
  ServiceConfigResolveResult {
    config: ServiceConfig {
      endpoint: endpoint_result.expr,
      auth: if config.auth == none { none } else { Some { value: auth_result.expr } },
      rate_limit: if config.rate_limit == none { none } else { Some { value: rate_result.expr } },
      retry: if config.retry == none { none } else { Some { value: retry_result.expr } }
    },
    diagnostics: concat(endpoint_result.diagnostics, auth_result.diagnostics, rate_result.diagnostics, retry_result.diagnostics)
  }
}

fn resolve_transport_binding(transport: TransportBinding, env: TypeEnv, module_name: String) -> TransportResolveResult {
  match transport {
    RestBinding { base_url: base_url, auth: auth, headers: headers } =>
      let base_result = resolve_expr_types(expr: base_url, env: env, module_name: module_name)
      let auth_result = if auth == none {
        AuthConfigResolveResult {
          config: AuthConfig { scheme: "", header: "", token_expr: Literal { value: LitNull, span: no_span() } },
          diagnostics: []
        }
      } else {
        resolve_auth_config(config: auth.value, env: env, module_name: module_name)
      }
      let header_results = map(headers, h => resolve_header_def(header: h, env: env, module_name: module_name))
      let resolved_headers = map(header_results, hr => hr.header)
      let header_diags = flat_map(header_results, hr => hr.diagnostics)
      TransportResolveResult {
        transport: RestBinding {
          base_url: base_result.expr,
          auth: if auth == none { none } else { Some { value: auth_result.config } },
          headers: resolved_headers
        },
        diagnostics: concat(base_result.diagnostics, auth_result.diagnostics, header_diags)
      }
    ShellBinding { argv: argv, env: env_defs } =>
      let argv_results = map(argv, arg => resolve_expr_types(expr: arg, env: env, module_name: module_name))
      let env_results = map(env_defs, entry => resolve_env_def(env_def: entry, env: env, module_name: module_name))
      let resolved_argv = map(argv_results, r => r.expr)
      let resolved_env_defs = map(env_results, r => r.env_def)
      let argv_diags = flat_map(argv_results, r => r.diagnostics)
      let env_diags = flat_map(env_results, r => r.diagnostics)
      TransportResolveResult {
        transport: ShellBinding { argv: resolved_argv, env: resolved_env_defs },
        diagnostics: concat(argv_diags, env_diags)
      }
    FileBinding { base_path: base_path } =>
      let base_result = resolve_expr_types(expr: base_path, env: env, module_name: module_name)
      TransportResolveResult {
        transport: FileBinding { base_path: base_result.expr },
        diagnostics: base_result.diagnostics
      }
    LocalBinding =>
      TransportResolveResult { transport: LocalBinding, diagnostics: [] }
  }
}

fn resolve_expr_types(expr: Expr, env: TypeEnv, module_name: String) -> ExprResolveResult {
  match expr {
    Literal { value: _, span: _ } =>
      ExprResolveResult { expr: expr, diagnostics: [] }
    Var { name: _, span: _ } =>
      ExprResolveResult { expr: expr, diagnostics: [] }

    FieldAccess { base: base, field: field, span: span } =>
      let base_result = resolve_expr_types(expr: base, env: env, module_name: module_name)
      ExprResolveResult {
        expr: FieldAccess { base: base_result.expr, field: field, span: span },
        diagnostics: base_result.diagnostics
      }

    Call { func: func, args: args, span: span } =>
      let arg_results = map(args, arg => resolve_named_arg(arg: arg, env: env, module_name: module_name))
      let resolved_args = map(arg_results, ar => ar.arg)
      let arg_diags = flat_map(arg_results, ar => ar.diagnostics)
      ExprResolveResult {
        expr: Call { func: func, args: resolved_args, span: span },
        diagnostics: arg_diags
      }

    MethodCall { receiver: receiver, method: method, args: args, span: span } =>
      let recv_result = resolve_expr_types(expr: receiver, env: env, module_name: module_name)
      let arg_results = map(args, arg => resolve_named_arg(arg: arg, env: env, module_name: module_name))
      let resolved_args = map(arg_results, ar => ar.arg)
      let arg_diags = flat_map(arg_results, ar => ar.diagnostics)
      ExprResolveResult {
        expr: MethodCall { receiver: recv_result.expr, method: method, args: resolved_args, span: span },
        diagnostics: concat(recv_result.diagnostics, arg_diags)
      }

    Match { scrutinee: scrutinee, arms: arms, span: span } =>
      let scrutinee_result = resolve_expr_types(expr: scrutinee, env: env, module_name: module_name)
      let arm_results = map(arms, arm => resolve_match_arm(arm: arm, env: env, module_name: module_name))
      let resolved_arms = map(arm_results, ar => ar.arm)
      let arm_diags = flat_map(arm_results, ar => ar.diagnostics)
      ExprResolveResult {
        expr: Match { scrutinee: scrutinee_result.expr, arms: resolved_arms, span: span },
        diagnostics: concat(scrutinee_result.diagnostics, arm_diags)
      }

    If { condition: condition, then_branch: then_branch, else_branch: else_branch, span: span } =>
      let cond_result = resolve_expr_types(expr: condition, env: env, module_name: module_name)
      let then_result = resolve_expr_types(expr: then_branch, env: env, module_name: module_name)
      let else_result = if else_branch == none {
        ExprResolveResult { expr: Literal { value: LitNull, span: no_span() }, diagnostics: [] }
      } else {
        resolve_expr_types(expr: else_branch.value, env: env, module_name: module_name)
      }
      ExprResolveResult {
        expr: If {
          condition: cond_result.expr,
          then_branch: then_result.expr,
          else_branch: if else_branch == none { none } else { Some { value: else_result.expr } },
          span: span
        },
        diagnostics: concat(cond_result.diagnostics, then_result.diagnostics, else_result.diagnostics)
      }

    Let { name: name, value: value, body: body, span: span } =>
      let value_result = resolve_expr_types(expr: value, env: env, module_name: module_name)
      let body_result = if body == none {
        ExprResolveResult { expr: Literal { value: LitNull, span: no_span() }, diagnostics: [] }
      } else {
        resolve_expr_types(expr: body.value, env: env, module_name: module_name)
      }
      ExprResolveResult {
        expr: Let {
          name: name,
          value: value_result.expr,
          body: if body == none { none } else { Some { value: body_result.expr } },
          span: span
        },
        diagnostics: concat(value_result.diagnostics, body_result.diagnostics)
      }

    RecordLit { type_name: type_name, fields: fields, span: span } =>
      let field_results = map(fields, field_init => resolve_field_init(field_init: field_init, env: env, module_name: module_name))
      let resolved_fields = map(field_results, fr => fr.field_init)
      let field_diags = flat_map(field_results, fr => fr.diagnostics)
      ExprResolveResult {
        expr: RecordLit { type_name: type_name, fields: resolved_fields, span: span },
        diagnostics: field_diags
      }

    ListLit { elements: elements, span: span } =>
      let element_results = map(elements, element => resolve_expr_types(expr: element, env: env, module_name: module_name))
      let resolved_elements = map(element_results, er => er.expr)
      let element_diags = flat_map(element_results, er => er.diagnostics)
      ExprResolveResult {
        expr: ListLit { elements: resolved_elements, span: span },
        diagnostics: element_diags
      }

    BinOp { op: op, left: left, right: right, span: span } =>
      let left_result = resolve_expr_types(expr: left, env: env, module_name: module_name)
      let right_result = resolve_expr_types(expr: right, env: env, module_name: module_name)
      ExprResolveResult {
        expr: BinOp { op: op, left: left_result.expr, right: right_result.expr, span: span },
        diagnostics: concat(left_result.diagnostics, right_result.diagnostics)
      }

    UnaryOp { op: op, operand: operand, span: span } =>
      let operand_result = resolve_expr_types(expr: operand, env: env, module_name: module_name)
      ExprResolveResult {
        expr: UnaryOp { op: op, operand: operand_result.expr, span: span },
        diagnostics: operand_result.diagnostics
      }

    Lambda { params: params, body: body, span: span } =>
      let body_result = resolve_expr_types(expr: body, env: env, module_name: module_name)
      ExprResolveResult {
        expr: Lambda { params: params, body: body_result.expr, span: span },
        diagnostics: body_result.diagnostics
      }

    StringInterp { parts: parts, span: span } =>
      let part_results = map(parts, part => resolve_string_part(part: part, env: env, module_name: module_name))
      let resolved_parts = map(part_results, pr => pr.part)
      let part_diags = flat_map(part_results, pr => pr.diagnostics)
      ExprResolveResult {
        expr: StringInterp { parts: resolved_parts, span: span },
        diagnostics: part_diags
      }

    Block { stmts: stmts, span: span } =>
      let stmt_results = map(stmts, stmt => resolve_expr_types(expr: stmt, env: env, module_name: module_name))
      let resolved_stmts = map(stmt_results, sr => sr.expr)
      let stmt_diags = flat_map(stmt_results, sr => sr.diagnostics)
      ExprResolveResult {
        expr: Block { stmts: resolved_stmts, span: span },
        diagnostics: stmt_diags
      }

    Cast { expr: inner, target: target, span: span } =>
      let expr_result = resolve_expr_types(expr: inner, env: env, module_name: module_name)
      let type_result = resolve_type_expr(expr: target, env: env, module_name: module_name)
      ExprResolveResult {
        expr: Cast { expr: expr_result.expr, target: type_result.resolved, span: span },
        diagnostics: concat(expr_result.diagnostics, type_result.diagnostics)
      }

    ForEach { variable: variable, collection: collection, body: body, span: span } =>
      let collection_result = resolve_expr_types(expr: collection, env: env, module_name: module_name)
      let body_result = resolve_expr_types(expr: body, env: env, module_name: module_name)
      ExprResolveResult {
        expr: ForEach {
          variable: variable,
          collection: collection_result.expr,
          body: body_result.expr,
          span: span
        },
        diagnostics: concat(collection_result.diagnostics, body_result.diagnostics)
      }

    Index { base: base, index: index, span: span } =>
      let base_result = resolve_expr_types(expr: base, env: env, module_name: module_name)
      let index_result = resolve_expr_types(expr: index, env: env, module_name: module_name)
      ExprResolveResult {
        expr: Index { base: base_result.expr, index: index_result.expr, span: span },
        diagnostics: concat(base_result.diagnostics, index_result.diagnostics)
      }

    Slice { base: base, start: start, end: end, span: span } =>
      let base_result = resolve_expr_types(expr: base, env: env, module_name: module_name)
      let start_result = resolve_expr_types(expr: start, env: env, module_name: module_name)
      let end_result = resolve_expr_types(expr: end, env: env, module_name: module_name)
      ExprResolveResult {
        expr: Slice {
          base: base_result.expr,
          start: start_result.expr,
          end: end_result.expr,
          span: span
        },
        diagnostics: concat(base_result.diagnostics, start_result.diagnostics, end_result.diagnostics)
      }
  }
}

// =========================================================================
// Resolve all type expressions within a single Node
//
// Walks through the item's type references (params, return types,
// field types, etc.) and resolves each one against the environment.
// =========================================================================

fn resolve_item_types(item: Node, env: TypeEnv, module_name: String) -> ItemResult {
  // Resolve params
  let param_results = map(item.params, p => resolve_param(param: p, env: env, module_name: module_name))
  let resolved_params = map(param_results, pr => pr.param)
  let param_diags = flat_map(param_results, pr => pr.diagnostics)

  // Resolve return type
  let ret_result = resolve_optional_type_expr(expr: item.return_type, env: env, module_name: module_name)
  let resolved_ret = if item.return_type == none { none } else { Some { value: ret_result.resolved } }

  // Resolve uses
  let use_results = map(item.uses, u => resolve_resource_use(ru: u, env: env, module_name: module_name))
  let resolved_uses = map(use_results, ur => ur.resource_use)
  let use_diags = flat_map(use_results, ur => ur.diagnostics)

  // Resolve body if present
  let body_resolved = if item.body == none {
    ExprResolveResult { expr: Literal { value: LitNull, span: no_span() }, diagnostics: [] }
  } else {
    resolve_expr_types(expr: item.body.value, env: env, module_name: module_name)
  }
  let resolved_body = if item.body == none { none } else { Some { value: body_resolved.expr } }
  let body_diags = body_resolved.diagnostics

  // Resolve type_annotation if present
  let anno_resolved = if item.type_annotation == none {
    ResolveResult { resolved: unit_type(), diagnostics: [], resolved_node: none }
  } else {
    resolve_type_expr(expr: item.type_annotation.value, env: env, module_name: module_name)
  }
  let resolved_anno = if item.type_annotation == none { none } else { Some { value: anno_resolved.resolved } }
  let anno_diags = anno_resolved.diagnostics

  // Resolve transport if present
  let transport_resolved = if item.transport == none {
    TransportResolveResult { transport: LocalBinding, diagnostics: [] }
  } else {
    resolve_transport_binding(transport: item.transport.value, env: env, module_name: module_name)
  }
  let resolved_transport = if item.transport == none { none } else { Some { value: transport_resolved.transport } }
  let transport_diags = transport_resolved.diagnostics

  // Resolve config if present
  let config_resolved = if item.config == none {
    ServiceConfigResolveResult {
      config: ServiceConfig { endpoint: Literal { value: LitNull, span: no_span() }, auth: none, rate_limit: none, retry: none },
      diagnostics: []
    }
  } else {
    resolve_service_config(config: item.config.value, env: env, module_name: module_name)
  }
  let resolved_config = if item.config == none { none } else { Some { value: config_resolved.config } }
  let config_diags = config_resolved.diagnostics

  // Resolve properties
  let prop_results = map(item.properties, p => resolve_field_init(field_init: p, env: env, module_name: module_name))
  let resolved_props = map(prop_results, pr => pr.field_init)
  let prop_diags = flat_map(prop_results, pr => pr.diagnostics)

  // Resolve children recursively (W11: operations/capabilities as child Nodes)
  let child_results = map(item.children, child => resolve_item_types(item: child, env: env, module_name: module_name))
  let resolved_children = map(child_results, cr => cr.item)
  let child_diags = flat_map(child_results, cr => cr.diagnostics)

  ItemResult {
    item: Node {
      name: item.name, span: item.span, children: resolved_children,
      params: resolved_params, return_type: resolved_ret,
      uses: resolved_uses, body: resolved_body,
      connective: item.connective, transport: resolved_transport,
      properties: resolved_props, type_annotation: resolved_anno,
      config: resolved_config
    },
    diagnostics: concat(param_diags, ret_result.diagnostics, use_diags, body_diags, anno_diags, transport_diags, config_diags, prop_diags, child_diags)
  }
}

// =========================================================================
// Typecheck a single module
//
// Builds the type environment, then resolves all type expressions in
// every item. Returns the typed module with its environment.
// =========================================================================

type TypecheckModuleResult {
  typed: TypedModule
  diagnostics: List<Diagnostic>
}

fn typecheck_module(resolved: ResolvedModule, parent_index: Map<String, TypedModule>) -> TypecheckModuleResult {
  let env_result = build_type_env(module: resolved, parent_index: parent_index)
  let env = env_result.env
  // Resolve all type expressions in every item against the environment.
  let item_results = map(resolved.module.items, item =>
    resolve_item_types(item: item, env: env, module_name: resolved.module.name)
  )
  let resolved_items = map(item_results, ir => ir.item)
  let item_diags = flat_map(item_results, ir => ir.diagnostics)

  // Rebuild the module with resolved items.
  let typed_module = Module {
    name: resolved.module.name,
    imports: resolved.module.imports,
    items: resolved_items,
    span: resolved.module.span
  }

  // Also resolve the types in the environment itself, so that all
  // bindings point to fully-resolved structural forms.
  let resolved_env = resolve_env_bindings(env: env, module_name: resolved.module.name)

  // Build func_env from the resolved items (return types resolved by now).
  let func_env = build_func_env(items: resolved_items)

  // Build service registry: map service paths to OpEntry lists from children.
  let local_svc_registry = fold(resolved_items, init: empty_map(), f: (acc, item) =>
    if item.transport != none && item.children |> count > 0 {
      let entries = item.children |> map(c =>
        OpEntry { name: c.name, outputs: return_type_to_outputs(return_type: c.return_type, span: c.span) }
      )
      map_insert(acc, item.name, entries)
    } else {
      acc
    }
  )
  let service_registry = fold(map_values(parent_index), init: local_svc_registry, f: (acc, typed_parent) =>
    fold(typed_parent.items, init: acc, f: (inner_acc, titem) =>
      if titem.transport != none && titem.children |> count > 0 {
        let entries = titem.children |> map(c =>
          OpEntry { name: c.name, outputs: typed_return_type_to_outputs(return_type: c.return_type, span: c.span) }
        )
        map_insert(inner_acc, titem.name, entries)
      } else {
        inner_acc
      }
    )
  )

  // Register service namespace roots as locals so expressions like
  // git.Core.CurrentBranch() can typecheck.
  let local_svc_locals = fold(resolved_items, init: empty_map(), f: (acc, item) =>
    if item.transport != none && item.children |> count > 0 {
      let svc_name = item.name
      let span = item.span
      let dot_pos = find_dot_index(name: svc_name, index: 0)
      let root = if dot_pos < 0 { svc_name } else { substring(svc_name, 0, dot_pos) }
      map_insert(acc, root, TypeBinding { name: root, resolved: Named { name: root, span: span }, resolved_node: none })
    } else {
      acc
    }
  )
  let service_locals = fold(map_values(parent_index), init: local_svc_locals, f: (acc, typed_parent) =>
    fold(typed_parent.items, init: acc, f: (inner_acc, titem) =>
      if titem.transport != none && titem.children |> count > 0 {
        let svc_name = titem.name
        let span = titem.span
        let dot_pos = find_dot_index(name: svc_name, index: 0)
        let root = if dot_pos < 0 { svc_name } else { substring(svc_name, 0, dot_pos) }
        map_insert(inner_acc, root, TypeBinding { name: root, resolved: Named { name: root, span: span }, resolved_node: none })
      } else {
        inner_acc
      }
    )
  )

  // Build the InferScope and infer all items to produce TypedNodes.
  let infer_scope = InferScope {
    type_env: resolved_env.env,
    func_env: func_env,
    locals: service_locals,
    module_name: resolved.module.name,
    type_cache: empty_map(),
    service_registry: service_registry
  }
  let typed_item_results = infer_items(items: resolved_items, scope: infer_scope)
  let typed_items = map(typed_item_results, tir => tir.item)
  let infer_diags = flat_map(typed_item_results, tir => tir.diagnostics)
  let all_type_entries = flat_map(typed_item_results, tir => tir.type_entries)

  TypecheckModuleResult {
    typed: TypedModule {
      module: typed_module,
      items: typed_items,
      type_env: resolved_env.env,
      func_env: func_env,
      type_cache: all_type_entries
    },
    diagnostics: concat(env_result.diagnostics, item_diags, resolved_env.diagnostics, infer_diags)
  }
}

// =========================================================================
// Resolve all bindings in a TypeEnv
//
// After building the initial environment (which may contain Named
// references within Product/Coproduct fields), resolve every binding
// so downstream consumers see fully-structural types.
// =========================================================================

type EnvResolveResult {
  env: TypeEnv
  diagnostics: List<Diagnostic>
}

// Result of resolving a single type binding — follows the same
// value+diagnostics pattern as ResolveResult, ItemResult, etc.
type BindingResult {
  binding: TypeBinding
  diagnostics: List<Diagnostic>
}

fn resolve_env_bindings(env: TypeEnv, module_name: String) -> EnvResolveResult {
  let results = map(map_values(env.bindings), b =>
    let result = resolve_type_expr(expr: b.resolved, env: env, module_name: module_name)
    // Preserve the resolved_node from the original binding
    BindingResult { binding: TypeBinding { name: b.name, resolved: result.resolved, resolved_node: b.resolved_node }, diagnostics: result.diagnostics }
  )
  let resolved_bindings = map(results, r => r.binding) |> fold(init: empty_map(), f: (acc, b) =>
    map_insert(acc, b.name, b)
  )
  let all_diags = flat_map(results, r => r.diagnostics)
  EnvResolveResult {
    env: TypeEnv { bindings: resolved_bindings, recursive_types: env.recursive_types },
    diagnostics: all_diags
  }
}

// =========================================================================
// Collect parent type environments for a module
//
// Gathers the TypeEnvs from all modules that this module imports from,
// by looking up already-typed modules in the completed list.
// =========================================================================

fn collect_parent_envs(resolved: ResolvedModule, module_index: Map<String, TypedModule>) -> ParentModulesResult {
  fold(resolved.resolved_imports, init: ParentModulesResult { modules: [], diagnostics: [] }, f: (acc, imp) =>
    match map_get(module_index, imp.module_path) {
      Some { value: typed } =>
        ParentModulesResult {
          modules: concat(acc.modules, [typed]),
          diagnostics: acc.diagnostics
        }
      None =>
        ParentModulesResult {
          modules: acc.modules,
          diagnostics: concat(acc.diagnostics, [Diagnostic {
            severity: Error,
            message: concat("missing parent environment for imported module '", imp.module_path, "' while ordering '", resolved.module.name, "'"),
            span: imp.target_module.value.span,
            module_name: resolved.module.name
          }])
        }
    }
  )
}

// =========================================================================
// Main entry point: typecheck
//
// Processes modules in dependency order (from the resolver's dep_order).
// Each module sees the type environments of all its dependencies.
//
// Invariant: after this function returns, no unresolved Named references
// survive (except recursive cycle-breakers that are guaranteed to be
// defined in the graph).
// =========================================================================

fn typecheck(graph: ModuleGraph) -> TypedGraph {
  // Process modules in dependency order. Each iteration adds one
  // TypedModule to the accumulator, making its types available to
  // subsequent modules. The module_index provides O(1) lookup by name.
  let result = fold(graph.modules, init: TypecheckAccum { modules: [], module_index: empty_map(), diagnostics: [] }, f: (acc, resolved) =>
    let parent_result = collect_parent_envs(resolved: resolved, module_index: acc.module_index)
    let tc_result = typecheck_module(resolved: resolved, parent_index: acc.module_index)
    TypecheckAccum {
      modules: concat(acc.modules, [tc_result.typed]),
      module_index: map_insert(acc.module_index, tc_result.typed.module.name, tc_result.typed),
      diagnostics: concat(acc.diagnostics, parent_result.diagnostics, tc_result.diagnostics)
    }
  )

  TypedGraph {
    modules: result.modules,
    diagnostics: result.diagnostics
  }
}

// =========================================================================
// Validation: check that no unresolved Named references survive
//
// Post-typecheck invariant checker. Walks every TypeExpr in every item
// of every module and reports any remaining Named references (which
// indicate a bug in the type checker).
// =========================================================================

fn validate_no_unresolved(graph: TypedGraph) -> List<Diagnostic> {
  // Collect all defined type names across the graph (for cycle-breaker detection).
  // Merge all module binding maps into a single Map for O(1) containment checks.
  let defined_names = fold(graph.modules, init: empty_map(), f: (acc, tm) =>
    map_merge(acc, tm.type_env.bindings)
  )
  fold(graph.modules, init: [], f: (acc, tm) =>
    // Check raw items (tm.module.items)
    let item_diags = fold(tm.module.items, init: [], f: (inner_acc, item) =>
      concat(inner_acc, collect_unresolved_in_item(item: item, module_name: tm.module.name, defined_names: defined_names))
    )
    // Also check typed items (tm.items) — these contain resolved_type on
    // TypedExpr bodies and the resolved return_type on TypedNode.
    let typed_item_diags = fold(tm.items, init: [], f: (inner_acc, titem) =>
      concat(inner_acc, collect_unresolved_in_typed_item(item: titem, module_name: tm.module.name, defined_names: defined_names))
    )
    concat(acc, item_diags, typed_item_diags)
  )
}

fn collect_unresolved_in_item(item: Node, module_name: String, defined_names: Map<String, TypeBinding>) -> List<Diagnostic> {
  let param_diags = fold(item.params, init: [], f: (acc, p) =>
    concat(acc, collect_unresolved_in_type_expr(expr: p.type_expr, module_name: module_name, defined_names: defined_names))
  )
  let ret_diags = if item.return_type == none { [] }
    else { collect_unresolved_in_type_expr(expr: item.return_type.value, module_name: module_name, defined_names: defined_names) }
  let use_diags = fold(item.uses, init: [], f: (acc, u) =>
    concat(acc, collect_unresolved_in_type_expr(expr: u.resource, module_name: module_name, defined_names: defined_names))
  )
  let body_diags = if item.body == none { [] }
    else { collect_unresolved_in_expr(expr: item.body.value, module_name: module_name, defined_names: defined_names) }
  let anno_diags = if item.type_annotation == none { [] }
    else { collect_unresolved_in_type_expr(expr: item.type_annotation.value, module_name: module_name, defined_names: defined_names) }
  let transport_diags = if item.transport == none { [] }
    else { collect_unresolved_in_transport_binding(transport: item.transport.value, module_name: module_name, defined_names: defined_names) }
  // Walk children for unresolved types (operations/capabilities as child Nodes)
  let child_diags = fold(item.children, init: [], f: (acc, child) =>
    concat(acc, collect_unresolved_in_item(item: child, module_name: module_name, defined_names: defined_names))
  )
  let config_diags = if item.config == none { [] }
    else { collect_unresolved_in_service_config(config: item.config.value, module_name: module_name, defined_names: defined_names) }
  let prop_diags = fold(item.properties, init: [], f: (acc, property) =>
    concat(acc, collect_unresolved_in_field_init(field_init: property, module_name: module_name, defined_names: defined_names))
  )
  concat(param_diags, ret_diags, use_diags, body_diags, anno_diags, transport_diags, child_diags, config_diags, prop_diags)
}

fn collect_unresolved_in_type_expr(expr: TypeExpr, module_name: String, defined_names: Map<String, TypeBinding>) -> List<Diagnostic> {
  match expr {
    Named { name: name, span: span } =>
      // Allow Named refs that are defined in the graph (recursive cycle-breakers)
      if map_contains_key(defined_names, name) {
        []
      } else {
        [Diagnostic {
          severity: Error,
          message: concat("unresolved type '", name, "' survived typecheck (internal error)"),
          span: span,
          module_name: module_name
        }]
      }

    Primitive { name: _, span: _ } => []

    Product { name: _, fields: fields, span: _ } =>
      fold(fields, init: [], f: (acc, f) =>
        concat(acc, collect_unresolved_in_type_expr(expr: f.type_expr, module_name: module_name, defined_names: defined_names))
      )

    Coproduct { name: _, variants: variants, span: _ } =>
      fold(variants, init: [], f: (acc, v) =>
        fold(v.fields, init: acc, f: (inner_acc, f) =>
          concat(inner_acc, collect_unresolved_in_type_expr(expr: f.type_expr, module_name: module_name, defined_names: defined_names))
        )
      )

    Container { kind: _, element: element, span: _ } =>
      collect_unresolved_in_type_expr(expr: element, module_name: module_name, defined_names: defined_names)

    Optional { inner: inner, span: _ } =>
      collect_unresolved_in_type_expr(expr: inner, module_name: module_name, defined_names: defined_names)

    Refined { base: base, predicates: _, span: _ } =>
      collect_unresolved_in_type_expr(expr: base, module_name: module_name, defined_names: defined_names)

    MapType { key: key, value: value, span: _ } =>
      concat(collect_unresolved_in_type_expr(expr: key, module_name: module_name, defined_names: defined_names),
        collect_unresolved_in_type_expr(expr: value, module_name: module_name, defined_names: defined_names))
  }
}

fn collect_unresolved_in_field_init(field_init: FieldInit, module_name: String, defined_names: Map<String, TypeBinding>) -> List<Diagnostic> {
  collect_unresolved_in_expr(expr: field_init.value, module_name: module_name, defined_names: defined_names)
}

fn collect_unresolved_in_named_arg(arg: NamedArg, module_name: String, defined_names: Map<String, TypeBinding>) -> List<Diagnostic> {
  collect_unresolved_in_expr(expr: arg.value, module_name: module_name, defined_names: defined_names)
}

fn collect_unresolved_in_string_part(part: StringPart, module_name: String, defined_names: Map<String, TypeBinding>) -> List<Diagnostic> {
  match part {
    Text { value: _ } => []
    Interpolation { expr: expr } =>
      collect_unresolved_in_expr(expr: expr, module_name: module_name, defined_names: defined_names)
  }
}

fn collect_unresolved_in_auth_config(config: AuthConfig, module_name: String, defined_names: Map<String, TypeBinding>) -> List<Diagnostic> {
  collect_unresolved_in_expr(expr: config.token_expr, module_name: module_name, defined_names: defined_names)
}

fn collect_unresolved_in_service_config(config: ServiceConfig, module_name: String, defined_names: Map<String, TypeBinding>) -> List<Diagnostic> {
  let endpoint_diags = collect_unresolved_in_expr(expr: config.endpoint, module_name: module_name, defined_names: defined_names)
  let auth_diags = if config.auth == none {
    []
  } else {
    collect_unresolved_in_expr(expr: config.auth.value, module_name: module_name, defined_names: defined_names)
  }
  let rate_diags = if config.rate_limit == none {
    []
  } else {
    collect_unresolved_in_expr(expr: config.rate_limit.value, module_name: module_name, defined_names: defined_names)
  }
  let retry_diags = if config.retry == none {
    []
  } else {
    collect_unresolved_in_expr(expr: config.retry.value, module_name: module_name, defined_names: defined_names)
  }
  concat(endpoint_diags, auth_diags, rate_diags, retry_diags)
}

fn collect_unresolved_in_transport_binding(transport: TransportBinding, module_name: String, defined_names: Map<String, TypeBinding>) -> List<Diagnostic> {
  match transport {
    RestBinding { base_url: base_url, auth: auth, headers: headers } =>
      let base_diags = collect_unresolved_in_expr(expr: base_url, module_name: module_name, defined_names: defined_names)
      let auth_diags = if auth == none {
        []
      } else {
        collect_unresolved_in_auth_config(config: auth.value, module_name: module_name, defined_names: defined_names)
      }
      let header_diags = fold(headers, init: [], f: (acc, header) =>
        concat(acc, collect_unresolved_in_expr(expr: header.value, module_name: module_name, defined_names: defined_names))
      )
      concat(base_diags, auth_diags, header_diags)
    ShellBinding { argv: argv, env: env_defs } =>
      let argv_diags = fold(argv, init: [], f: (acc, arg) =>
        concat(acc, collect_unresolved_in_expr(expr: arg, module_name: module_name, defined_names: defined_names))
      )
      let env_diags = fold(env_defs, init: [], f: (acc, env_def) =>
        concat(acc, collect_unresolved_in_expr(expr: env_def.value, module_name: module_name, defined_names: defined_names))
      )
      concat(argv_diags, env_diags)
    FileBinding { base_path: base_path } =>
      collect_unresolved_in_expr(expr: base_path, module_name: module_name, defined_names: defined_names)
    LocalBinding => []
  }
}

fn collect_unresolved_in_expr(expr: Expr, module_name: String, defined_names: Map<String, TypeBinding>) -> List<Diagnostic> {
  match expr {
    Literal { value: _, span: _ } => []
    Var { name: _, span: _ } => []
    FieldAccess { base: base, field: _, span: _ } =>
      collect_unresolved_in_expr(expr: base, module_name: module_name, defined_names: defined_names)
    Call { func: _, args: args, span: _ } =>
      fold(args, init: [], f: (acc, arg) =>
        concat(acc, collect_unresolved_in_named_arg(arg: arg, module_name: module_name, defined_names: defined_names))
      )
    MethodCall { receiver: receiver, method: _, args: args, span: _ } =>
      let recv_diags = collect_unresolved_in_expr(expr: receiver, module_name: module_name, defined_names: defined_names)
      let arg_diags = fold(args, init: [], f: (acc, arg) =>
        concat(acc, collect_unresolved_in_named_arg(arg: arg, module_name: module_name, defined_names: defined_names))
      )
      concat(recv_diags, arg_diags)
    Match { scrutinee: scrutinee, arms: arms, span: _ } =>
      let scrutinee_diags = collect_unresolved_in_expr(expr: scrutinee, module_name: module_name, defined_names: defined_names)
      let arm_diags = fold(arms, init: [], f: (acc, arm) =>
        let guard_diags = if arm.guard == none {
          []
        } else {
          collect_unresolved_in_expr(expr: arm.guard.value, module_name: module_name, defined_names: defined_names)
        }
        let body_diags = collect_unresolved_in_expr(expr: arm.body, module_name: module_name, defined_names: defined_names)
        concat(acc, guard_diags, body_diags)
      )
      concat(scrutinee_diags, arm_diags)
    If { condition: condition, then_branch: then_branch, else_branch: else_branch, span: _ } =>
      let cond_diags = collect_unresolved_in_expr(expr: condition, module_name: module_name, defined_names: defined_names)
      let then_diags = collect_unresolved_in_expr(expr: then_branch, module_name: module_name, defined_names: defined_names)
      let else_diags = if else_branch == none {
        []
      } else {
        collect_unresolved_in_expr(expr: else_branch.value, module_name: module_name, defined_names: defined_names)
      }
      concat(cond_diags, then_diags, else_diags)
    Let { name: _, value: value, body: body, span: _ } =>
      let value_diags = collect_unresolved_in_expr(expr: value, module_name: module_name, defined_names: defined_names)
      let body_diags = if body == none {
        []
      } else {
        collect_unresolved_in_expr(expr: body.value, module_name: module_name, defined_names: defined_names)
      }
      concat(value_diags, body_diags)
    RecordLit { type_name: _, fields: fields, span: _ } =>
      fold(fields, init: [], f: (acc, field_init) =>
        concat(acc, collect_unresolved_in_field_init(field_init: field_init, module_name: module_name, defined_names: defined_names))
      )
    ListLit { elements: elements, span: _ } =>
      fold(elements, init: [], f: (acc, element) =>
        concat(acc, collect_unresolved_in_expr(expr: element, module_name: module_name, defined_names: defined_names))
      )
    BinOp { op: _, left: left, right: right, span: _ } =>
      concat(
        collect_unresolved_in_expr(expr: left, module_name: module_name, defined_names: defined_names),
        collect_unresolved_in_expr(expr: right, module_name: module_name, defined_names: defined_names)
      )
    UnaryOp { op: _, operand: operand, span: _ } =>
      collect_unresolved_in_expr(expr: operand, module_name: module_name, defined_names: defined_names)
    Lambda { params: _, body: body, span: _ } =>
      collect_unresolved_in_expr(expr: body, module_name: module_name, defined_names: defined_names)
    StringInterp { parts: parts, span: _ } =>
      fold(parts, init: [], f: (acc, part) =>
        concat(acc, collect_unresolved_in_string_part(part: part, module_name: module_name, defined_names: defined_names))
      )
    Block { stmts: stmts, span: _ } =>
      fold(stmts, init: [], f: (acc, stmt) =>
        concat(acc, collect_unresolved_in_expr(expr: stmt, module_name: module_name, defined_names: defined_names))
      )
    Cast { expr: inner, target: target, span: _ } =>
      concat(
        collect_unresolved_in_expr(expr: inner, module_name: module_name, defined_names: defined_names),
        collect_unresolved_in_type_expr(expr: target, module_name: module_name, defined_names: defined_names)
      )
    ForEach { variable: _, collection: collection, body: body, span: _ } =>
      concat(
        collect_unresolved_in_expr(expr: collection, module_name: module_name, defined_names: defined_names),
        collect_unresolved_in_expr(expr: body, module_name: module_name, defined_names: defined_names)
      )
    Index { base: base, index: index, span: _ } =>
      concat(
        collect_unresolved_in_expr(expr: base, module_name: module_name, defined_names: defined_names),
        collect_unresolved_in_expr(expr: index, module_name: module_name, defined_names: defined_names)
      )
    Slice { base: base, start: start, end: end, span: _ } =>
      concat(
        collect_unresolved_in_expr(expr: base, module_name: module_name, defined_names: defined_names),
        collect_unresolved_in_expr(expr: start, module_name: module_name, defined_names: defined_names),
        collect_unresolved_in_expr(expr: end, module_name: module_name, defined_names: defined_names)
      )
  }
}

// =========================================================================
// Validation: check TypedNodes for unresolved types
//
// Walks the typed AST (TypedNode list) and checks that return types and
// inferred resolved_type fields on TypedExprs contain no unresolved Named.
// =========================================================================

fn collect_unresolved_in_typed_item(item: TypedNode, module_name: String, defined_names: Map<String, TypeBinding>) -> List<Diagnostic> {
  let param_diags = fold(item.params, init: [], f: (acc, p) =>
    concat(acc, collect_unresolved_in_type_expr(expr: p.type_expr, module_name: module_name, defined_names: defined_names))
  )
  let ret_diags = collect_unresolved_in_type_expr(expr: item.return_type, module_name: module_name, defined_names: defined_names)
  let use_diags = fold(item.uses, init: [], f: (acc, u) =>
    concat(acc, collect_unresolved_in_type_expr(expr: u.resource, module_name: module_name, defined_names: defined_names))
  )
  let body_diags = if item.body == none { [] }
    else { collect_unresolved_in_typed_expr(texpr: item.body.value, module_name: module_name, defined_names: defined_names) }
  let anno_diags = if item.type_annotation == none { [] }
    else { collect_unresolved_in_type_expr(expr: item.type_annotation.value, module_name: module_name, defined_names: defined_names) }
  let transport_diags = if item.transport == none { [] }
    else { collect_unresolved_in_transport_binding(transport: item.transport.value, module_name: module_name, defined_names: defined_names) }
  // Walk children for unresolved types (operations/capabilities as child Nodes)
  let child_diags = fold(item.children, init: [], f: (acc, child) =>
    concat(acc, collect_unresolved_in_typed_item(item: child, module_name: module_name, defined_names: defined_names))
  )
  let config_diags = if item.config == none { [] }
    else { collect_unresolved_in_service_config(config: item.config.value, module_name: module_name, defined_names: defined_names) }
  let prop_diags = fold(item.properties, init: [], f: (acc, property) =>
    concat(acc, collect_unresolved_in_field_init(field_init: property, module_name: module_name, defined_names: defined_names))
  )
  concat(param_diags, ret_diags, use_diags, body_diags, anno_diags, transport_diags, child_diags, config_diags, prop_diags)
}

fn collect_unresolved_in_typed_expr(texpr: TypedExpr, module_name: String, defined_names: Map<String, TypeBinding>) -> List<Diagnostic> {
  // Check the resolved_type attached to this TypedExpr node
  concat(
    collect_unresolved_in_type_expr(expr: texpr.resolved_type, module_name: module_name, defined_names: defined_names),
    collect_unresolved_in_expr(expr: typed_expr_to_expr(texpr: texpr), module_name: module_name, defined_names: defined_names)
  )
}

// =========================================================================
// Convenience: typecheck and validate in one call
//
// Returns the typed graph with any validation diagnostics appended.
// =========================================================================

fn typecheck_and_validate(graph: ModuleGraph) -> TypedGraph {
  let typed = typecheck(graph: graph)
  let validation_diags = validate_no_unresolved(graph: typed)
  TypedGraph {
    modules: typed.modules,
    diagnostics: concat(typed.diagnostics, validation_diags)
  }
}
