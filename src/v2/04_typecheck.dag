// v2 type checker/resolver — resolves Named type references to structural form.
//
// After this pass, no unresolved Named references survive in the typed graph.
// Every Named { name } is replaced by its structural expansion (Product,
// Coproduct, Container, Refined) or by Primitive { name } for kernel types.
//
// Exception: recursive types retain a Named reference to break the cycle,
// but the name is guaranteed to be defined in the module graph.
//
// Nominal identity is preserved: resolved types keep their name alongside
// the structural form for diagnostics and emission.
//
// Dependency chain:
//   v2.compiler.resolve (ModuleGraph, dependency order)
//     -> v2.compiler.typecheck (TypedGraph, resolved types)
//       -> v2.compiler.emit (target-language files)

module v2.compiler.typecheck

import std.types { SourceSpan }
import v2.std.core {
  Module, Item, ImportNames, ImportAll, ImportSpecific,
  TypeExpr, TypeBody, Field, Variant, Param,
  Expr, Diagnostic,
  TypeDef, FuncDef, FnDef, ServiceDef, ResourceDef, DataDef, ExternFuncDecl,
  Named, Product, Coproduct, Container, Refined, Optional, MapType, Primitive,
  Record, Sum, Alias,
  OperationDef, CapabilityDef, ResourceUse,
  ResponseMapping, ExitMapping,
  TransportBinding, ServiceConfig, AuthConfig, HeaderDef, EnvDef, MockResponseDef,
  Error,
  TypedExpr,
  TypedItem, TypedTypeDef, TypedFnDef, TypedFuncDef,
  TypedServiceDef, TypedResourceDef, TypedDataDef, TypedExternFuncDecl,
  FuncSig, FuncEnv,
  ForEach,
  LiteralValue, LitStr, LitInt, LitFloat, LitBool, LitNull,
  BinOpKind, Add, Sub, Mul, Div, Mod,
  BinEq, BinNe, BinLt, BinGt, BinLe, BinGe,
  BinAnd, BinOr, NullCoalesce,
  UnaryOpKind, Not, Neg,
  MatchArm, MatchPattern, FieldInit, NamedArg, StringPart,
  RestBinding, ShellBinding, FileBinding, LocalBinding,
  Text, Interpolation,
  Literal, Var, FieldAccess, Call, MethodCall,
  Match, If, Let, RecordLit, ListLit, BinOp, UnaryOp,
  Lambda, StringInterp, Block, Cast,
  Index, Slice
}
import v2.compiler.resolve { ModuleGraph, ResolvedModule, ResolvedImport }

// =========================================================================
// Typecheck output types
// =========================================================================

type TypedGraph {
  modules: List<TypedModule>
  diagnostics: List<Diagnostic>
}

type SpanType {
  start: Int
  end: Int
  resolved_type: TypeExpr
}

type TypedModule {
  module: Module
  items: List<TypedItem>
  type_env: TypeEnv
  func_env: FuncEnv
  type_cache: List<SpanType>
}

type TypeEnv {
  bindings: List<TypeBinding>
}

type TypeBinding {
  name: String
  resolved: TypeExpr
}

// Internal result type for threading diagnostics through resolution.
type ResolveResult {
  resolved: TypeExpr
  diagnostics: List<Diagnostic>
}

// =========================================================================
// Expression inference types
// =========================================================================

type InferScope {
  type_env: TypeEnv
  func_env: FuncEnv
  locals: List<TypeBinding>
  module_name: String
  type_cache: List<SpanType>
}

type InferResult {
  typed: TypedExpr
  diagnostics: List<Diagnostic>
  type_entries: List<SpanType>
}

type BlockInferState {
  scope: InferScope
  diagnostics: List<Diagnostic>
  last_type: TypeExpr
  type_entries: List<SpanType>
}

type TypedItemResult {
  item: TypedItem
  diagnostics: List<Diagnostic>
  type_entries: List<SpanType>
}

type AccessCheckResult {
  resolved_type: TypeExpr
  diagnostics: List<Diagnostic>
}

// Internal result type for item-level resolution.
type ItemResult {
  item: Item
  diagnostics: List<Diagnostic>
}

type BuildTypeEnvResult {
  env: TypeEnv
  diagnostics: List<Diagnostic>
}

type ParentModulesResult {
  modules: List<TypedModule>
  diagnostics: List<Diagnostic>
}

// Internal result type for field-level resolution.
type FieldResult {
  field: Field
  diagnostics: List<Diagnostic>
}

type ExprResolveResult {
  expr: Expr
  diagnostics: List<Diagnostic>
}

type NamedArgResolveResult {
  arg: NamedArg
  diagnostics: List<Diagnostic>
}

type MatchArmResolveResult {
  arm: MatchArm
  diagnostics: List<Diagnostic>
}

type FieldInitResolveResult {
  field_init: FieldInit
  diagnostics: List<Diagnostic>
}

type StringPartResolveResult {
  part: StringPart
  diagnostics: List<Diagnostic>
}

type TransportResolveResult {
  transport: TransportBinding
  diagnostics: List<Diagnostic>
}

type ServiceConfigResolveResult {
  config: ServiceConfig
  diagnostics: List<Diagnostic>
}

type AuthConfigResolveResult {
  config: AuthConfig
  diagnostics: List<Diagnostic>
}

type HeaderResolveResult {
  header: HeaderDef
  diagnostics: List<Diagnostic>
}

type EnvDefResolveResult {
  env_def: EnvDef
  diagnostics: List<Diagnostic>
}

type MockResponseResolveResult {
  mock_response: MockResponseDef
  diagnostics: List<Diagnostic>
}

type ResponseMappingResolveResult {
  response: ResponseMapping
  diagnostics: List<Diagnostic>
}

type ExitMappingResolveResult {
  exit_mapping: ExitMapping
  diagnostics: List<Diagnostic>
}

// Internal result type for variant-level resolution.
type VariantResult {
  variant: Variant
  diagnostics: List<Diagnostic>
}

// Internal result type for param-level resolution.
type ParamResult {
  param: Param
  diagnostics: List<Diagnostic>
}

// Internal result type for operation-level resolution.
type OperationResult {
  operation: OperationDef
  diagnostics: List<Diagnostic>
}

// Internal result type for capability-level resolution.
type CapabilityResult {
  capability: CapabilityDef
  diagnostics: List<Diagnostic>
}

// Internal result type for resource-use resolution.
type ResourceUseResult {
  resource_use: ResourceUse
  diagnostics: List<Diagnostic>
}

// =========================================================================
// Build function environment from module items.
// Extracts signatures from FnDef, FuncDef, and ExternFuncDecl items.
// =========================================================================

// Unwrap an optional return type at a function boundary.
// The v1 codegen tracks optionality from field declarations and rejects
// assigning optional values to non-optional struct fields. This function
// boundary resets the tracking, allowing the result to be used as TypeExpr.
fn unwrap_return_type(rt: TypeExpr?) -> TypeExpr {
  // Use resolve_optional_type_expr pattern: the evaluator handles the
  // none check and returns the value; the compiled code needs the
  // .value accessor pattern. Both paths produce the same result.
  let result = resolve_optional_type_expr(
    expr: rt,
    env: TypeEnv { bindings: [] },
    module_name: ""
  )
  result.resolved
}

fn build_func_env(items: List<Item>) -> FuncEnv {
  // Called with resolved items (after resolve_item_types), so return_type
  // fields have already been resolved by resolve_optional_type_expr.
  let sigs = fold(items, init: [], f: (acc, item) =>
    match item {
      FnDef { name: n, params: ps, return_type: rt, body: _, span: _ } =>
        concat(acc, [FuncSig { name: n, params: ps, return_type: unwrap_return_type(rt: rt), is_async: false }])
      FuncDef { name: n, params: ps, return_type: rt, uses: _, body: _, span: _ } =>
        concat(acc, [FuncSig { name: n, params: ps, return_type: unwrap_return_type(rt: rt), is_async: true }])
      ExternFuncDecl { name: n, params: ps, return_type: rt, span: _ } =>
        concat(acc, [FuncSig { name: n, params: ps, return_type: rt, is_async: false }])
      _ => acc
    }
  )
  FuncEnv { signatures: sigs }
}

// =========================================================================
// Expression inference — step 3 of the typed AST design
//
// Assigns a resolved TypeExpr to every Expr node in the AST, producing
// TypedExpr values. This is a single top-down pass (not Hindley-Milner);
// .dag has explicit type annotations on params and fields, so inference
// is propagation, not unification.
// =========================================================================

// -------------------------------------------------------------------------
// Helper: construct a no-span sentinel for synthesized types
// -------------------------------------------------------------------------

fn no_span() -> SourceSpan {
  SourceSpan { start: 0, end: 0 }
}

// -------------------------------------------------------------------------
// Helper: construct a unit TypeExpr
// -------------------------------------------------------------------------

fn unit_type() -> TypeExpr {
  Primitive { name: "Unit", span: no_span() }
}

// -------------------------------------------------------------------------
// Helper: wrap an Expr with a resolved type to produce a TypedExpr
// -------------------------------------------------------------------------

fn typed(expr: Expr, resolved_type: TypeExpr) -> TypedExpr {
  TypedExpr { expr: expr, resolved_type: resolved_type }
}

// -------------------------------------------------------------------------
// Helper: wrap an Expr+type into an InferResult with no diagnostics
// -------------------------------------------------------------------------

fn expr_span(expr: Expr) -> SourceSpan {
  match expr {
    Literal { span: s } => s
    Var { span: s } => s
    FieldAccess { span: s } => s
    Call { span: s } => s
    MethodCall { span: s } => s
    Match { span: s } => s
    If { span: s } => s
    Let { span: s } => s
    RecordLit { span: s } => s
    ListLit { span: s } => s
    BinOp { span: s } => s
    UnaryOp { span: s } => s
    Lambda { span: s } => s
    StringInterp { span: s } => s
    Block { span: s } => s
    Cast { span: s } => s
    ForEach { span: s } => s
    Index { span: s } => s
    Slice { span: s } => s
    _ => SourceSpan { start: 0, end: 0 }
  }
}

fn span_entry(expr: Expr, resolved_type: TypeExpr) -> SpanType {
  let s = expr_span(expr: expr)
  SpanType { start: s.start, end: s.end, resolved_type: resolved_type }
}

fn ok_infer(expr: Expr, resolved_type: TypeExpr) -> InferResult {
  InferResult {
    typed: typed(expr: expr, resolved_type: resolved_type),
    diagnostics: [],
    type_entries: [span_entry(expr: expr, resolved_type: resolved_type)]
  }
}

// -------------------------------------------------------------------------
// lookup_in_scope: look up a variable name in lexical locals only.
//
// Function params are installed into locals by build_params_scope().
// -------------------------------------------------------------------------

fn lookup_in_scope(scope: InferScope, name: String) -> TypeExpr? {
  let local_matches = filter(scope.locals, b => b.name == name)
  if count(local_matches) > 0 {
    let found = first(local_matches)
    match found {
      Some { value: binding } => Some { value: binding.resolved }
      None => None
    }
  } else {
    None
  }
}

// -------------------------------------------------------------------------
// lookup_field_type: given a resolved type (Product), look up a field
// by name and return its type. Returns None if not found or not a Product.
// -------------------------------------------------------------------------

fn lookup_field_type(type_expr: TypeExpr, field_name: String) -> TypeExpr? {
  match type_expr {
    Product { name: _, fields: fields, span: _ } =>
      let matches = filter(fields, f => f.name == field_name)
      if count(matches) > 0 {
        let found = first(matches)
        match found {
          Some { value: f } =>
            if f.optional {
              Some { value: Optional { inner: f.type_expr, span: no_span() } }
            } else {
              Some { value: f.type_expr }
            }
          None => None
        }
      } else {
        None
      }
    // For Optional types, unwrap and look up in inner
    Optional { inner: inner, span: _ } =>
      match lookup_field_type(type_expr: inner, field_name: field_name) {
        Some { value: inner_result } =>
          Some { value: Optional { inner: inner_result, span: no_span() } }
        None => None
      }
    _ => None
  }
}

// -------------------------------------------------------------------------
// lookup_func_sig: look up a function signature by name
// -------------------------------------------------------------------------

fn lookup_func_sig(func_env: FuncEnv, name: String) -> FuncSig? {
  let matches = filter(func_env.signatures, s => s.name == name)
  if count(matches) > 0 {
    first(matches)
  } else {
    None
  }
}

// -------------------------------------------------------------------------
// infer_literal: resolve the type of a LiteralValue
// -------------------------------------------------------------------------

fn infer_literal(lit: LiteralValue) -> TypeExpr {
  match lit {
    LitStr { value: _ } => Primitive { name: "String", span: no_span() }
    LitInt { value: _ } => Primitive { name: "Int", span: no_span() }
    LitFloat { value: _ } => Primitive { name: "Float", span: no_span() }
    LitBool { value: _ } => Primitive { name: "Bool", span: no_span() }
    LitNull => Primitive { name: "Unit", span: no_span() }
  }
}

// -------------------------------------------------------------------------
// infer_binop_type: resolve the result type of a binary operation
// -------------------------------------------------------------------------

// -------------------------------------------------------------------------
// Index/Slice access helpers
// -------------------------------------------------------------------------

fn normalize_access_type(type_expr: TypeExpr) -> TypeExpr {
  match type_expr {
    Refined { base: base, predicates: _, span: _ } =>
      normalize_access_type(type_expr: base)
    _ => type_expr
  }
}

fn container_kind_name(kind: ContainerKind) -> String {
  match kind {
    List => "List"
    Set => "Set"
    NonEmptyList => "NonEmptyList"
    NonEmptySet => "NonEmptySet"
  }
}

fn type_expr_shape(type_expr: TypeExpr) -> String {
  match normalize_access_type(type_expr: type_expr) {
    Named { name: name, span: _ } => concat("Named(", name, ")")
    Primitive { name: name, span: _ } => concat("Primitive(", name, ")")
    Container { kind: kind, element: element, span: _ } =>
      concat("Container(", container_kind_name(kind: kind), ",", type_expr_shape(type_expr: element), ")")
    Optional { inner: inner, span: _ } =>
      concat("Optional(", type_expr_shape(type_expr: inner), ")")
    MapType { key: key, value: value, span: _ } =>
      concat("Map(", type_expr_shape(type_expr: key), ",", type_expr_shape(type_expr: value), ")")
    Product { name: name, fields: _, span: _ } =>
      if name == none { "Product(<anon>)" } else { concat("Product(", name.value, ")") }
    Coproduct { name: name, variants: _, span: _ } =>
      if name == none { "Coproduct(<anon>)" } else { concat("Coproduct(", name.value, ")") }
    Refined { base: _, predicates: _, span: _ } =>
      "Refined(<unreachable>)"
  }
}

fn type_expr_equals(left: TypeExpr, right: TypeExpr) -> Bool {
  type_expr_shape(type_expr: left) == type_expr_shape(type_expr: right)
}

fn is_int_type(type_expr: TypeExpr) -> Bool {
  match normalize_access_type(type_expr: type_expr) {
    Primitive { name: name, span: _ } => name == "Int"
    _ => false
  }
}

fn is_string_type(type_expr: TypeExpr) -> Bool {
  match normalize_access_type(type_expr: type_expr) {
    Primitive { name: name, span: _ } => name == "String"
    _ => false
  }
}

fn access_error(message: String, span: SourceSpan, module_name: String) -> Diagnostic {
  Diagnostic {
    severity: Error,
    message: message,
    span: Some { value: span },
    module_name: Some { value: module_name }
  }
}

fn inference_error(message: String, span: SourceSpan, module_name: String) -> Diagnostic {
  Diagnostic {
    severity: Error,
    message: message,
    span: Some { value: span },
    module_name: Some { value: module_name }
  }
}

fn check_index_access(base_type: TypeExpr, index_type: TypeExpr, span: SourceSpan, module_name: String) -> AccessCheckResult {
  match normalize_access_type(type_expr: base_type) {
    Primitive { name: name, span: _ } =>
      if name == "String" {
        let diags = if is_int_type(type_expr: index_type) {
          []
        } else {
          [access_error(
            message: "string index requires an Int index",
            span: span,
            module_name: module_name
          )]
        }
        AccessCheckResult {
          resolved_type: Primitive { name: "String", span: no_span() },
          diagnostics: diags
        }
      } else {
        AccessCheckResult {
          resolved_type: unit_type(),
          diagnostics: [access_error(
            message: "indexing is only supported for String and Map values",
            span: span,
            module_name: module_name
          )]
        }
      }
    MapType { key: key, value: value, span: _ } =>
      let diags = if type_expr_equals(left: key, right: index_type) {
        []
      } else {
        [access_error(
          message: "map index key type does not match the map key type",
          span: span,
          module_name: module_name
        )]
      }
      AccessCheckResult {
        resolved_type: Optional { inner: value, span: no_span() },
        diagnostics: diags
      }
    _ =>
      AccessCheckResult {
        resolved_type: unit_type(),
        diagnostics: [access_error(
          message: "indexing is only supported for String and Map values",
          span: span,
          module_name: module_name
        )]
      }
  }
}

fn check_slice_access(base_type: TypeExpr, start_type: TypeExpr, end_type: TypeExpr, span: SourceSpan, module_name: String) -> AccessCheckResult {
  let base_diags = if is_string_type(type_expr: base_type) {
    []
  } else {
    [access_error(
      message: "slice is only supported for String values",
      span: span,
      module_name: module_name
    )]
  }
  let start_diags = if is_int_type(type_expr: start_type) {
    []
  } else {
    [access_error(
      message: "slice start requires an Int index",
      span: span,
      module_name: module_name
    )]
  }
  let end_diags = if is_int_type(type_expr: end_type) {
    []
  } else {
    [access_error(
      message: "slice end requires an Int index",
      span: span,
      module_name: module_name
    )]
  }
  AccessCheckResult {
    resolved_type: if is_string_type(type_expr: base_type) {
      Primitive { name: "String", span: no_span() }
    } else {
      unit_type()
    },
    diagnostics: concat(base_diags, start_diags, end_diags)
  }
}

fn infer_binop_type(op: BinOpKind, left_type: TypeExpr) -> TypeExpr {
  match op {
    // Arithmetic: result is same as left operand
    Add => left_type
    Sub => left_type
    Mul => left_type
    Div => left_type
    Mod => left_type
    // Comparison: result is Bool
    BinEq => Primitive { name: "Bool", span: no_span() }
    BinNe => Primitive { name: "Bool", span: no_span() }
    BinLt => Primitive { name: "Bool", span: no_span() }
    BinGt => Primitive { name: "Bool", span: no_span() }
    BinLe => Primitive { name: "Bool", span: no_span() }
    BinGe => Primitive { name: "Bool", span: no_span() }
    // Logical: result is Bool
    BinAnd => Primitive { name: "Bool", span: no_span() }
    BinOr => Primitive { name: "Bool", span: no_span() }
    // NullCoalesce: unwrap Optional to inner type
    NullCoalesce => extract_optional_inner(type_expr: left_type)
  }
}

// -------------------------------------------------------------------------
// extract_optional_inner: unwrap Optional<T> to T; if not Optional, return as-is
// -------------------------------------------------------------------------

fn extract_optional_inner(type_expr: TypeExpr) -> TypeExpr {
  match type_expr {
    Optional { inner: inner, span: _ } => inner
    _ => type_expr
  }
}

// -------------------------------------------------------------------------
// infer_method_call_type: compute result type for pipe methods
// -------------------------------------------------------------------------

fn infer_method_call_type(receiver_type: TypeExpr, method: String) -> TypeExpr {
  // Extract the element type from Container types
  let elem_type = match receiver_type {
    Container { kind: _, element: el, span: _ } => el
    _ => receiver_type
  }
  if method == "map" {
    // map preserves container kind but element type comes from context;
    // without bidirectional typing, return the same container shape
    receiver_type
  } else {
    if method == "filter" {
      // filter preserves the full container type
      receiver_type
    } else {
      if method == "fold" {
        // fold returns the accumulator type; without more info, Unit
        unit_type()
      } else {
        if method == "first" {
          // first returns Optional<element>
          Optional { inner: elem_type, span: no_span() }
        } else {
          if method == "last" {
            // last returns Optional<element>
            Optional { inner: elem_type, span: no_span() }
          } else {
            if method == "count" {
              Primitive { name: "Int", span: no_span() }
            } else {
              if method == "join" {
                Primitive { name: "String", span: no_span() }
              } else {
                if method == "any" {
                  Primitive { name: "Bool", span: no_span() }
                } else {
                  if method == "contains" {
                    Primitive { name: "Bool", span: no_span() }
                  } else {
                    if method == "enumerate" {
                      // enumerate wraps elements in (index, element) pairs;
                      // keep as container for now
                      receiver_type
                    } else {
                      // Unknown method — fall back to Unit
                      unit_type()
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

// -------------------------------------------------------------------------
// build_params_scope: add function params to locals in an InferScope
// -------------------------------------------------------------------------

fn build_params_scope(scope: InferScope, params: List<Param>) -> InferScope {
  let param_bindings = map(params, p =>
    TypeBinding { name: p.name, resolved: p.type_expr }
  )
  InferScope {
    type_env: scope.type_env,
    func_env: scope.func_env,
    locals: concat(param_bindings, scope.locals),
    module_name: scope.module_name,
    type_cache: scope.type_cache
  }
}

// -------------------------------------------------------------------------
// extend_scope: add a single local binding to an InferScope
// -------------------------------------------------------------------------

fn extend_scope(scope: InferScope, name: String, resolved: TypeExpr) -> InferScope {
  InferScope {
    type_env: scope.type_env,
    func_env: scope.func_env,
    locals: concat([TypeBinding { name: name, resolved: resolved }], scope.locals),
    module_name: scope.module_name,
    type_cache: scope.type_cache
  }
}

fn scope_after_stmt(stmt: Expr, stmt_type: TypeExpr, scope: InferScope) -> InferScope {
  match stmt {
    Let { name: name, value: _, body: body, span: _ } =>
      if body == none {
        extend_scope(scope: scope, name: name, resolved: stmt_type)
      } else {
        scope
      }
    _ => scope
  }
}

fn for_each_element_type(type_expr: TypeExpr) -> TypeExpr {
  match normalize_access_type(type_expr: type_expr) {
    Container { kind: _, element: element, span: _ } => element
    Primitive { name: name, span: _ } =>
      if name == "String" {
        Primitive { name: "String", span: no_span() }
      } else {
        unit_type()
      }
    _ => unit_type()
  }
}

// -------------------------------------------------------------------------
// infer_expr: the main recursive function
//
// For each Expr variant, produce a TypedExpr wrapping the original expr
// with its resolved type. Diagnostics are threaded through for reporting.
// -------------------------------------------------------------------------

fn infer_expr(expr: Expr, scope: InferScope) -> InferResult {
  match expr {
    Literal { value: lit, span: _ } =>
      ok_infer(expr: expr, resolved_type: infer_literal(lit: lit))

    Var { name: name, span: span } =>
      let value_match = lookup_in_scope(scope: scope, name: name)
      match value_match {
        Some { value: resolved } =>
          ok_infer(expr: expr, resolved_type: resolved)
        None =>
          InferResult {
            typed: typed(expr: expr, resolved_type: unit_type()),
            diagnostics: [inference_error(
              message: concat("undefined variable '", name, "'"),
              span: span,
              module_name: scope.module_name
            )],
            type_entries: [span_entry(expr: expr, resolved_type: unit_type())]
          }
      }

    FieldAccess { base: base_expr, field: field_name, span: span } =>
      let base_result = infer_expr(expr: base_expr, scope: scope)
      let base_type = base_result.typed.resolved_type
      match lookup_field_type(type_expr: base_type, field_name: field_name) {
        Some { value: field_type } =>
          InferResult {
            typed: typed(expr: expr, resolved_type: field_type),
            diagnostics: base_result.diagnostics,
            type_entries: concat(base_result.type_entries, [span_entry(expr: expr, resolved_type: field_type)])
          }
        None =>
          InferResult {
            typed: typed(expr: expr, resolved_type: unit_type()),
            diagnostics: concat(base_result.diagnostics, [inference_error(
              message: concat("no field '", field_name, "' on type"),
              span: span,
              module_name: scope.module_name
            )]),
            type_entries: concat(base_result.type_entries, [span_entry(expr: expr, resolved_type: unit_type())])
          }
      }

    Call { func: func_name, args: _, span: _ } =>
      let sig = lookup_func_sig(func_env: scope.func_env, name: func_name)
      if sig == none {
        // Unknown function — check if it's a type constructor
        let type_match = lookup_type(env: scope.type_env, name: func_name)
        match type_match {
          Some { value: te } =>
            ok_infer(expr: expr, resolved_type: te)
          None =>
            ok_infer(expr: expr, resolved_type: unit_type())
        }
      } else {
        match sig {
          Some { value: s } => ok_infer(expr: expr, resolved_type: s.return_type)
          None => ok_infer(expr: expr, resolved_type: unit_type())
        }
      }

    MethodCall { receiver: recv, method: method_name, args: _, span: _ } =>
      let recv_result = infer_expr(expr: recv, scope: scope)
      let recv_type = recv_result.typed.resolved_type
      let result_type = infer_method_call_type(receiver_type: recv_type, method: method_name)
      InferResult {
        typed: typed(expr: expr, resolved_type: result_type),
        diagnostics: recv_result.diagnostics,
        type_entries: concat(recv_result.type_entries, [span_entry(expr: expr, resolved_type: result_type)])
      }

    Match { scrutinee: scrut, arms: arms, span: _ } =>
      let scrut_result = infer_expr(expr: scrut, scope: scope)
      // Type the arms; return type is the type of the first arm body
      let arm_results = map(arms, arm =>
        infer_expr(expr: arm.body, scope: scope)
      )
      let arm_diags = fold(arm_results, init: [], f: (acc, ar) => concat(acc, ar.diagnostics))
      let arm_entries = fold(arm_results, init: [], f: (acc, ar) => concat(acc, ar.type_entries))
      // Result type: type of first arm body, or Unit if no arms
      let result_type = if count(arm_results) > 0 {
        let first_arm = first(arm_results)
        match first_arm {
          Some { value: ar } => ar.typed.resolved_type
          None => unit_type()
        }
      } else {
        unit_type()
      }
      InferResult {
        typed: typed(expr: expr, resolved_type: result_type),
        diagnostics: concat(scrut_result.diagnostics, arm_diags),
        type_entries: concat(scrut_result.type_entries, arm_entries, [span_entry(expr: expr, resolved_type: result_type)])
      }

    If { condition: cond, then_branch: then_expr, else_branch: else_expr, span: span } =>
      let cond_result = infer_expr(expr: cond, scope: scope)
      let then_result = infer_expr(expr: then_expr, scope: scope)
      match else_expr {
        Some { value: else_branch } =>
          let else_result = infer_expr(expr: else_branch, scope: scope)
          let branch_diags = if type_expr_equals(
            left: then_result.typed.resolved_type,
            right: else_result.typed.resolved_type
          ) {
            []
          } else {
            [inference_error(
              message: concat(
                "if branches resolve to incompatible types: ",
                type_expr_shape(type_expr: then_result.typed.resolved_type),
                " vs ",
                type_expr_shape(type_expr: else_result.typed.resolved_type)
              ),
              span: span,
              module_name: scope.module_name
            )]
          }
          let resolved_type = if count(branch_diags) > 0 {
            unit_type()
          } else {
            then_result.typed.resolved_type
          }
          InferResult {
            typed: typed(expr: expr, resolved_type: resolved_type),
            diagnostics: concat(cond_result.diagnostics, then_result.diagnostics, else_result.diagnostics, branch_diags),
            type_entries: concat(cond_result.type_entries, then_result.type_entries, else_result.type_entries, [span_entry(expr: expr, resolved_type: resolved_type)])
          }
        None =>
          InferResult {
            typed: typed(expr: expr, resolved_type: unit_type()),
            diagnostics: concat(cond_result.diagnostics, then_result.diagnostics),
            type_entries: concat(cond_result.type_entries, then_result.type_entries, [span_entry(expr: expr, resolved_type: unit_type())])
          }
      }

    Let { name: let_name, value: let_value, body: _, span: _ } =>
      let val_result = infer_expr(expr: let_value, scope: scope)
      let val_type = val_result.typed.resolved_type
      // body is Expr? — use == none check per v1 codegen limitation
      let let_body = infer_let_body(expr: expr, scope: scope, let_name: let_name, val_type: val_type)
      InferResult {
        typed: typed(expr: expr, resolved_type: let_body.resolved_type),
        diagnostics: concat(val_result.diagnostics, let_body.diagnostics),
        type_entries: concat(val_result.type_entries, let_body.type_entries, [span_entry(expr: expr, resolved_type: let_body.resolved_type)])
      }

    RecordLit { type_name: _, fields: _, span: _ } =>
      infer_record_lit(expr: expr, scope: scope)

    ListLit { elements: elements, span: _ } =>
      if count(elements) > 0 {
        let first_elem = first(elements)
        match first_elem {
          Some { value: elem } =>
            let elem_result = infer_expr(expr: elem, scope: scope)
            let elem_type = elem_result.typed.resolved_type
            let list_type = Container { kind: List, element: elem_type, span: no_span() }
            InferResult {
              typed: typed(expr: expr, resolved_type: list_type),
              diagnostics: elem_result.diagnostics,
              type_entries: concat(elem_result.type_entries, [span_entry(expr: expr, resolved_type: list_type)])
            }
          None =>
            ok_infer(expr: expr, resolved_type: Container { kind: List, element: unit_type(), span: no_span() })
        }
      } else {
        ok_infer(expr: expr, resolved_type: Container { kind: List, element: unit_type(), span: no_span() })
      }

    BinOp { op: op, left: left_expr, right: _, span: _ } =>
      let left_result = infer_expr(expr: left_expr, scope: scope)
      let result_type = infer_binop_type(op: op, left_type: left_result.typed.resolved_type)
      InferResult {
        typed: typed(expr: expr, resolved_type: result_type),
        diagnostics: left_result.diagnostics,
        type_entries: concat(left_result.type_entries, [span_entry(expr: expr, resolved_type: result_type)])
      }

    UnaryOp { op: op, operand: operand_expr, span: _ } =>
      let operand_result = infer_expr(expr: operand_expr, scope: scope)
      let result_type = match op {
        Not => Primitive { name: "Bool", span: no_span() }
        Neg => operand_result.typed.resolved_type
      }
      InferResult {
        typed: typed(expr: expr, resolved_type: result_type),
        diagnostics: operand_result.diagnostics,
        type_entries: concat(operand_result.type_entries, [span_entry(expr: expr, resolved_type: result_type)])
      }

    Lambda { params: _, body: _, span: _ } =>
      ok_infer(expr: expr, resolved_type: unit_type())

    StringInterp { parts: _, span: _ } =>
      ok_infer(expr: expr, resolved_type: Primitive { name: "String", span: no_span() })

    Block { stmts: stmts, span: _ } =>
      if count(stmts) > 0 {
        let state = fold(stmts, init: BlockInferState {
          scope: scope,
          diagnostics: [],
          last_type: unit_type(),
          type_entries: []
        }, f: (acc, stmt) =>
          let stmt_result = infer_expr(expr: stmt, scope: acc.scope)
          let next_scope = scope_after_stmt(
            stmt: stmt,
            stmt_type: stmt_result.typed.resolved_type,
            scope: acc.scope
          )
          BlockInferState {
            scope: next_scope,
            diagnostics: concat(acc.diagnostics, stmt_result.diagnostics),
            last_type: stmt_result.typed.resolved_type,
            type_entries: concat(acc.type_entries, stmt_result.type_entries)
          }
        )
        InferResult {
          typed: typed(expr: expr, resolved_type: state.last_type),
          diagnostics: state.diagnostics,
          type_entries: concat(state.type_entries, [span_entry(expr: expr, resolved_type: state.last_type)])
        }
      } else {
        ok_infer(expr: expr, resolved_type: unit_type())
      }

    Cast { expr: cast_inner, target: target_type, span: _ } =>
      let inner_result = infer_expr(expr: cast_inner, scope: scope)
      InferResult {
        typed: typed(expr: expr, resolved_type: target_type),
        diagnostics: inner_result.diagnostics,
        type_entries: concat(inner_result.type_entries, [span_entry(expr: expr, resolved_type: target_type)])
      }

    ForEach { variable: variable, collection: coll, body: body_expr, span: _ } =>
      let coll_result = infer_expr(expr: coll, scope: scope)
      let elem_type = for_each_element_type(type_expr: coll_result.typed.resolved_type)
      let body_scope = extend_scope(scope: scope, name: variable, resolved: elem_type)
      let body_result = infer_expr(expr: body_expr, scope: body_scope)
      InferResult {
        typed: typed(expr: expr, resolved_type: unit_type()),
        diagnostics: concat(coll_result.diagnostics, body_result.diagnostics),
        type_entries: concat(coll_result.type_entries, body_result.type_entries, [span_entry(expr: expr, resolved_type: unit_type())])
      }

    Index { base: base_expr, index: index_expr, span: span } =>
      let base_result = infer_expr(expr: base_expr, scope: scope)
      let index_result = infer_expr(expr: index_expr, scope: scope)
      let index_check = check_index_access(
        base_type: base_result.typed.resolved_type,
        index_type: index_result.typed.resolved_type,
        span: span,
        module_name: scope.module_name
      )
      InferResult {
        typed: typed(expr: expr, resolved_type: index_check.resolved_type),
        diagnostics: concat(base_result.diagnostics, index_result.diagnostics, index_check.diagnostics),
        type_entries: concat(base_result.type_entries, index_result.type_entries, [span_entry(expr: expr, resolved_type: index_check.resolved_type)])
      }

    Slice { base: base_expr, start: start_expr, end: end_expr, span: span } =>
      let base_result = infer_expr(expr: base_expr, scope: scope)
      let start_result = infer_expr(expr: start_expr, scope: scope)
      let end_result = infer_expr(expr: end_expr, scope: scope)
      let slice_check = check_slice_access(
        base_type: base_result.typed.resolved_type,
        start_type: start_result.typed.resolved_type,
        end_type: end_result.typed.resolved_type,
        span: span,
        module_name: scope.module_name
      )
      InferResult {
        typed: typed(expr: expr, resolved_type: slice_check.resolved_type),
        diagnostics: concat(base_result.diagnostics, start_result.diagnostics, end_result.diagnostics, slice_check.diagnostics),
        type_entries: concat(base_result.type_entries, start_result.type_entries, end_result.type_entries, [span_entry(expr: expr, resolved_type: slice_check.resolved_type)])
      }

    // Fallback for any unrecognized variant
    _ => ok_infer(expr: expr, resolved_type: unit_type())
  }
}

// -------------------------------------------------------------------------
// infer_let_body: helper for Let expression body inference
//
// Let body is Expr? — handle with == none check per v1 codegen limitation.
// If body is none, the Let's type is the value's type. Otherwise, extend
// scope and infer the body.
// -------------------------------------------------------------------------

type LetBodyResult {
  resolved_type: TypeExpr
  diagnostics: List<Diagnostic>
  type_entries: List<SpanType>
}

fn infer_let_body(expr: Expr, scope: InferScope, let_name: String, val_type: TypeExpr) -> LetBodyResult {
  // Extract the body from the Let expression
  // Due to v1 codegen limitation with optional fields in match destructuring,
  // we re-match to get the body field, then use == none check
  match expr {
    Let { name: _, value: _, body: body, span: _ } =>
      if body == none {
        LetBodyResult { resolved_type: val_type, diagnostics: [], type_entries: [] }
      } else {
        let extended = extend_scope(scope: scope, name: let_name, resolved: val_type)
        let body_result = infer_expr(expr: body.value, scope: extended)
        LetBodyResult {
          resolved_type: body_result.typed.resolved_type,
          diagnostics: body_result.diagnostics,
          type_entries: body_result.type_entries
        }
      }
    _ =>
      LetBodyResult { resolved_type: val_type, diagnostics: [], type_entries: [] }
  }
}

// -------------------------------------------------------------------------
// infer_record_lit: helper for RecordLit inference
//
// type_name is String? — handle with == none check per v1 codegen limitation.
// If type_name given, look up in type_env; else construct anonymous Product.
// -------------------------------------------------------------------------

fn infer_record_lit(expr: Expr, scope: InferScope) -> InferResult {
  match expr {
    RecordLit { type_name: tn, fields: field_inits, span: _ } =>
      if tn == none {
        // Anonymous record — construct Product from field inits
        let fi_results = map(field_inits, fi => infer_expr(expr: fi.value, scope: scope))
        let field_types = field_inits |> enumerate |> map(pair =>
          let fi = pair.second
          let fi_result = match fi_results |> enumerate |> filter(p => p.first == pair.first) |> first {
            Some { value: p } => p.second
            None => ok_infer(expr: fi.value, resolved_type: unit_type())
          }
          Field {
            name: fi.name,
            type_expr: fi_result.typed.resolved_type,
            optional: false,
            default_value: none,
            from_key: none,
            span: no_span()
          }
        )
        let fi_entries = fold(fi_results, init: [], f: (acc, r) => concat(acc, r.type_entries))
        let anon_type = Product { name: none, fields: field_types, span: no_span() }
        InferResult {
          typed: typed(expr: expr, resolved_type: anon_type),
          diagnostics: [],
          type_entries: concat(fi_entries, [span_entry(expr: expr, resolved_type: anon_type)])
        }
      } else {
        // Named record — look up type in env
        let type_match = lookup_type(env: scope.type_env, name: tn.value)
        match type_match {
          Some { value: te } =>
            ok_infer(expr: expr, resolved_type: te)
          None =>
            // Type not found — use a Named reference as placeholder
            ok_infer(expr: expr, resolved_type: Named { name: tn.value, span: no_span() })
        }
      }
    _ =>
      ok_infer(expr: expr, resolved_type: unit_type())
  }
}

// -------------------------------------------------------------------------
// infer_item: wraps each Item into its TypedItem counterpart
// -------------------------------------------------------------------------

fn infer_item(item: Item, scope: InferScope) -> TypedItemResult {
  match item {
    FnDef { name: name, params: params, return_type: ret_type, body: body, span: span } =>
      let fn_scope = build_params_scope(scope: scope, params: params)
      let body_result = infer_expr(expr: body, scope: fn_scope)
      // Resolve return type: use declared if present, else inferred from body
      let resolved_ret = if ret_type == none {
        body_result.typed.resolved_type
      } else {
        ret_type.value
      }
      TypedItemResult {
        item: TypedFnDef {
          name: name,
          params: params,
          return_type: resolved_ret,
          body: body_result.typed,
          span: span
        },
        diagnostics: body_result.diagnostics,
        type_entries: body_result.type_entries
      }

    FuncDef { name: name, params: params, return_type: ret_type, uses: uses, body: body, span: span } =>
      let func_scope = build_params_scope(scope: scope, params: params)
      let body_result = infer_expr(expr: body, scope: func_scope)
      let resolved_ret = if ret_type == none {
        body_result.typed.resolved_type
      } else {
        ret_type.value
      }
      TypedItemResult {
        item: TypedFuncDef {
          name: name,
          params: params,
          return_type: resolved_ret,
          uses: uses,
          body: body_result.typed,
          span: span
        },
        diagnostics: body_result.diagnostics,
        type_entries: body_result.type_entries
      }

    DataDef { name: name, type_expr: type_expr, value: value, span: span } =>
      let val_result = infer_expr(expr: value, scope: scope)
      TypedItemResult {
        item: TypedDataDef {
          name: name,
          type_expr: type_expr,
          value: val_result.typed,
          span: span
        },
        diagnostics: val_result.diagnostics,
        type_entries: val_result.type_entries
      }

    TypeDef { name: name, body: body, span: span } =>
      TypedItemResult {
        item: TypedTypeDef { name: name, body: body, span: span },
        diagnostics: [],
        type_entries: []
      }

    ServiceDef { name: name, transport: transport, config: config, operations: operations, span: span } =>
      TypedItemResult {
        item: TypedServiceDef {
          name: name,
          transport: transport,
          config: config,
          operations: operations,
          span: span
        },
        diagnostics: [],
        type_entries: []
      }

    ResourceDef { name: name, properties: props, capabilities: caps, span: span } =>
      TypedItemResult {
        item: TypedResourceDef {
          name: name,
          properties: props,
          capabilities: caps,
          span: span
        },
        diagnostics: [],
        type_entries: []
      }

    ExternFuncDecl { name: name, params: params, return_type: ret_type, span: span } =>
      TypedItemResult {
        item: TypedExternFuncDecl {
          name: name,
          params: params,
          return_type: ret_type,
          span: span
        },
        diagnostics: [],
        type_entries: []
      }
  }
}

// -------------------------------------------------------------------------
// infer_items: walk all items in a module and produce TypedItems
// -------------------------------------------------------------------------

fn infer_items(items: List<Item>, scope: InferScope) -> List<TypedItemResult> {
  map(items, item => infer_item(item: item, scope: scope))
}

// =========================================================================
// Kernel type environment
//
// The 8 kernel primitives that have no structural expansion.
// These are the atoms of the type system — everything else is
// composed from them.
// =========================================================================

fn kernel_type_env() -> TypeEnv {
  let no_span = SourceSpan { start: 0, end: 0 }
  TypeEnv { bindings: [
    TypeBinding { name: "String", resolved: Primitive { name: "String", span: no_span } },
    TypeBinding { name: "Int",    resolved: Primitive { name: "Int",    span: no_span } },
    TypeBinding { name: "Bool",   resolved: Primitive { name: "Bool",   span: no_span } },
    TypeBinding { name: "Float",  resolved: Primitive { name: "Float",  span: no_span } },
    TypeBinding { name: "Secret", resolved: Primitive { name: "Secret", span: no_span } },
    TypeBinding { name: "Json",   resolved: Primitive { name: "Json",   span: no_span } },
    TypeBinding { name: "Unit",   resolved: Primitive { name: "Unit",   span: no_span } },
    TypeBinding { name: "Bytes",  resolved: Primitive { name: "Bytes",  span: no_span } }
  ] }
}

// =========================================================================
// Type environment lookup
// =========================================================================

fn lookup_type(env: TypeEnv, name: String) -> TypeExpr? {
  let matches = filter(env.bindings, b => b.name == name)
  let n = count(matches)
  if n > 0 {
    match first(matches) {
      Some { value: binding } => Some { value: binding.resolved }
      None => None
    }
  } else {
    None
  }
}

// =========================================================================
// Environment merging
//
// Combines multiple type environments. Later bindings shadow earlier ones
// (last-writer-wins), which matches the import resolution order: kernel
// first, then transitive deps, then direct imports, then local defs.
// =========================================================================

// Fold accumulator for deduplication — tracks which names have been
// processed and the deduplicated result list.
type DedupeState {
  seen: List<String>
  result: List<TypeBinding>
}

fn merge_envs(envs: List<TypeEnv>) -> TypeEnv {
  let all_bindings = fold(envs, init: [], f: (acc, env) => concat(acc, env.bindings))
  // Deduplicate: keep last occurrence of each name (last-writer-wins).
  // Reverse, then fold left-to-right keeping only the first occurrence of each name.
  // Since the reversed list puts later bindings first, first-seen == last-writer.
  let reversed = reverse(all_bindings)
  let deduped = fold(reversed, init: DedupeState { seen: [], result: [] }, f: (acc, b) =>
    if contains(acc.seen, b.name) {
      acc
    } else {
      DedupeState { seen: concat([b.name], acc.seen), result: concat([b], acc.result) }
    }
  )
  TypeEnv { bindings: deduped.result }
}

// =========================================================================
// Build type environment for a single module
//
// Layers (in shadowing order, last wins):
//   1. Kernel primitives (String, Int, Bool, ...)
//   2. Imported types from parent environments
//   3. Local type definitions from the module's items
// =========================================================================

fn build_type_env(module: ResolvedModule, parent_modules: List<TypedModule>) -> BuildTypeEnvResult {
  let kernel = kernel_type_env()

  // Collect imported bindings from the specific target module env for each import.
  let import_result = fold(module.resolved_imports, init: BuildTypeEnvResult {
    env: TypeEnv { bindings: [] },
    diagnostics: []
  }, f: (acc, imp) =>
    match find_typed_module(modules: parent_modules, name: imp.module_path) {
      Some { value: typed_parent } =>
        let target_env = typed_parent.type_env
        let imported_result = match imp.names {
          ImportAll =>
            BuildTypeEnvResult {
              env: TypeEnv { bindings: target_env.bindings },
              diagnostics: []
            }
          ImportSpecific { names: specific_names } =>
            fold(specific_names, init: BuildTypeEnvResult {
              env: TypeEnv { bindings: [] },
              diagnostics: []
            }, f: (inner_acc, name) =>
              match lookup_type(env: target_env, name: name) {
                Some { value: resolved } =>
                  BuildTypeEnvResult {
                    env: TypeEnv { bindings: concat(inner_acc.env.bindings, [TypeBinding { name: name, resolved: resolved }]) },
                    diagnostics: inner_acc.diagnostics
                  }
                None =>
                  BuildTypeEnvResult {
                    env: inner_acc.env,
                    diagnostics: concat(inner_acc.diagnostics, [Diagnostic {
                      severity: Error,
                      message: concat("imported type '", name, "' not found in module '", imp.module_path, "'"),
                      span: imp.target_module.value.span,
                      module_name: module.module.name
                    }])
                  }
              }
            )
        }
        BuildTypeEnvResult {
          env: TypeEnv { bindings: concat(acc.env.bindings, imported_result.env.bindings) },
          diagnostics: concat(acc.diagnostics, imported_result.diagnostics)
        }
      None =>
        BuildTypeEnvResult {
          env: acc.env,
          diagnostics: concat(acc.diagnostics, [Diagnostic {
            severity: Error,
            message: concat("missing parent environment for imported module '", imp.module_path, "' while typechecking '", module.module.name, "'"),
            span: imp.target_module.value.span,
            module_name: module.module.name
          }])
        }
    }
  )
  let import_env = import_result.env

  // Collect local type definitions from module items.
  let local_bindings = fold(module.module.items, init: [], f: (acc, item) =>
    match item {
      TypeDef { name: name, body: body, span: span } =>
        let resolved = type_body_to_expr(name: name, body: body, span: span)
        concat(acc, [TypeBinding { name: name, resolved: resolved }])
      _ => acc
    }
  )
  let local_env = TypeEnv { bindings: local_bindings }

  // Merge in shadowing order: kernel < imports < local.
  BuildTypeEnvResult {
    env: merge_envs(envs: [kernel, import_env, local_env]),
    diagnostics: import_result.diagnostics
  }
}

// =========================================================================
// Convert a TypeBody (Record/Sum/Alias) to a TypeExpr.
//
// This creates the initial (unresolved) structural form of a type
// definition. Named references within fields/variants remain as Named
// until resolve_type_expr processes them.
// =========================================================================

fn type_body_to_expr(name: String, body: TypeBody, span: SourceSpan) -> TypeExpr {
  match body {
    Record { fields: fields } =>
      Product { name: name, fields: fields, span: span }
    Sum { variants: variants } =>
      Coproduct { name: name, variants: variants, span: span }
    Alias { base: base } =>
      Named { name: name, span: span }
  }
}

// =========================================================================
// Resolve a single TypeExpr
//
// Walks the type expression tree, replacing Named references with their
// structural definitions from the environment. Primitives are returned
// as-is. Compound types (Product, Coproduct, Container, etc.) are
// resolved recursively.
//
// Cycle detection: if a Named reference refers to a type that is
// currently being resolved (detected by checking if the expansion
// is itself a Named with the same name), it is kept as a Named
// reference to break the cycle. This is sound because the name IS
// defined in the environment.
// =========================================================================

fn resolve_type_expr(expr: TypeExpr, env: TypeEnv, module_name: String) -> ResolveResult {
  resolve_type_expr_with_resolving(expr: expr, env: env, module_name: module_name, resolving: [])
}

// resolve_type_expr_with_resolving: tracks names currently being resolved
// to detect mutual recursion cycles (not just self-reference).
fn resolve_type_expr_with_resolving(expr: TypeExpr, env: TypeEnv, module_name: String, resolving: List<String>) -> ResolveResult {
  match expr {
    Named { name: name, span: span } =>
      // Cycle detection: if name is in the resolving stack, break the cycle.
      if resolving |> any(r => r == name) {
        ResolveResult { resolved: expr, diagnostics: [] }
      } else {
        match lookup_type(env: env, name: name) {
          Some { value: resolved } =>
            // Check for self-reference (cycle breaker): if the resolved type
            // is a Named pointing to the same name, keep it to avoid infinite expansion.
            match resolved {
              Named { name: inner_name, span: _ } =>
                if inner_name == name {
                  ResolveResult { resolved: expr, diagnostics: [] }
                } else {
                  // Resolve the target with name added to resolving stack.
                  resolve_type_expr_with_resolving(expr: resolved, env: env, module_name: module_name, resolving: concat(resolving, [name]))
                }
              _ =>
                // Resolved to a structural form. Recursively resolve any
                // Named references inside it.
                resolve_type_expr_with_resolving(expr: resolved, env: env, module_name: module_name, resolving: concat(resolving, [name]))
            }
          None =>
            // Unresolved name — emit diagnostic.
            ResolveResult {
              resolved: expr,
              diagnostics: [Diagnostic {
                severity: Error,
                message: concat("unresolved type '", name, "'"),
                span: span,
                module_name: module_name
              }]
            }
        }
      }

    Primitive { name: _, span: _ } =>
      // Already fully resolved.
      ResolveResult { resolved: expr, diagnostics: [] }

    Product { name: prod_name, fields: fields, span: span } =>
      let field_results = map(fields, f => resolve_field(field: f, env: env, module_name: module_name))
      let resolved_fields = map(field_results, fr => fr.field)
      let all_diags = fold(field_results, init: [], f: (acc, fr) => concat(acc, fr.diagnostics))
      ResolveResult {
        resolved: Product { name: prod_name, fields: resolved_fields, span: span },
        diagnostics: all_diags
      }

    Coproduct { name: coprod_name, variants: variants, span: span } =>
      let variant_results = map(variants, v => resolve_variant(variant: v, env: env, module_name: module_name))
      let resolved_variants = map(variant_results, vr => vr.variant)
      let all_diags = fold(variant_results, init: [], f: (acc, vr) => concat(acc, vr.diagnostics))
      ResolveResult {
        resolved: Coproduct { name: coprod_name, variants: resolved_variants, span: span },
        diagnostics: all_diags
      }

    Container { kind: kind, element: element, span: span } =>
      let elem_result = resolve_type_expr_with_resolving(expr: element, env: env, module_name: module_name, resolving: resolving)
      ResolveResult {
        resolved: Container { kind: kind, element: elem_result.resolved, span: span },
        diagnostics: elem_result.diagnostics
      }

    Optional { inner: inner, span: span } =>
      let inner_result = resolve_type_expr_with_resolving(expr: inner, env: env, module_name: module_name, resolving: resolving)
      ResolveResult {
        resolved: Optional { inner: inner_result.resolved, span: span },
        diagnostics: inner_result.diagnostics
      }

    Refined { base: base, predicates: predicates, span: span } =>
      let base_result = resolve_type_expr_with_resolving(expr: base, env: env, module_name: module_name, resolving: resolving)
      ResolveResult {
        resolved: Refined { base: base_result.resolved, predicates: predicates, span: span },
        diagnostics: base_result.diagnostics
      }

    MapType { key: key, value: value, span: span } =>
      let key_result = resolve_type_expr_with_resolving(expr: key, env: env, module_name: module_name, resolving: resolving)
      let value_result = resolve_type_expr_with_resolving(expr: value, env: env, module_name: module_name, resolving: resolving)
      ResolveResult {
        resolved: MapType { key: key_result.resolved, value: value_result.resolved, span: span },
        diagnostics: concat(key_result.diagnostics, value_result.diagnostics)
      }
  }
}

// =========================================================================
// Field resolution
// =========================================================================

fn resolve_field(field: Field, env: TypeEnv, module_name: String) -> FieldResult {
  let type_result = resolve_type_expr(expr: field.type_expr, env: env, module_name: module_name)
  let default_result = if field.default_value == none {
    ExprResolveResult { expr: Literal { value: LitNull, span: no_span() }, diagnostics: [] }
  } else {
    resolve_expr_types(expr: field.default_value.value, env: env, module_name: module_name)
  }
  FieldResult {
    field: Field {
      name: field.name,
      type_expr: type_result.resolved,
      optional: field.optional,
      default_value: if field.default_value == none { none } else { Some { value: default_result.expr } },
      from_key: field.from_key,
      span: field.span
    },
    diagnostics: concat(type_result.diagnostics, default_result.diagnostics)
  }
}

// =========================================================================
// Variant resolution
// =========================================================================

fn resolve_variant(variant: Variant, env: TypeEnv, module_name: String) -> VariantResult {
  let field_results = map(variant.fields, f => resolve_field(field: f, env: env, module_name: module_name))
  let resolved_fields = map(field_results, fr => fr.field)
  let all_diags = fold(field_results, init: [], f: (acc, fr) => concat(acc, fr.diagnostics))
  VariantResult {
    variant: Variant {
      name: variant.name,
      fields: resolved_fields,
      span: variant.span
    },
    diagnostics: all_diags
  }
}

// =========================================================================
// Param resolution
// =========================================================================

fn resolve_param(param: Param, env: TypeEnv, module_name: String) -> ParamResult {
  let type_result = resolve_type_expr(expr: param.type_expr, env: env, module_name: module_name)
  let default_result = if param.default_value == none {
    ExprResolveResult { expr: Literal { value: LitNull, span: no_span() }, diagnostics: [] }
  } else {
    resolve_expr_types(expr: param.default_value.value, env: env, module_name: module_name)
  }
  ParamResult {
    param: Param {
      name: param.name,
      type_expr: type_result.resolved,
      default_value: if param.default_value == none { none } else { Some { value: default_result.expr } },
      span: param.span
    },
    diagnostics: concat(type_result.diagnostics, default_result.diagnostics)
  }
}

// =========================================================================
// Operation resolution
// =========================================================================

fn resolve_operation(op: OperationDef, env: TypeEnv, module_name: String) -> OperationResult {
  let input_results = map(op.inputs, f => resolve_field(field: f, env: env, module_name: module_name))
  let output_results = map(op.outputs, f => resolve_field(field: f, env: env, module_name: module_name))
  let resolved_inputs = map(input_results, fr => fr.field)
  let resolved_outputs = map(output_results, fr => fr.field)
  let input_diags = fold(input_results, init: [], f: (acc, fr) => concat(acc, fr.diagnostics))
  let output_diags = fold(output_results, init: [], f: (acc, fr) => concat(acc, fr.diagnostics))

  let response_results = map(op.response, rm =>
    resolve_response_mapping(mapping: rm, env: env, module_name: module_name)
  )
  let resolved_responses = map(response_results, rr => rr.response)
  let response_diags = fold(response_results, init: [], f: (acc, rr) => concat(acc, rr.diagnostics))

  let mock_results = map(op.mock_response, mock =>
    resolve_mock_response(mock_response: mock, env: env, module_name: module_name)
  )
  let resolved_mocks = map(mock_results, mr => mr.mock_response)
  let mock_diags = fold(mock_results, init: [], f: (acc, mr) => concat(acc, mr.diagnostics))

  let exit_results = map(op.exit_mappings, em =>
    resolve_exit_mapping(mapping: em, env: env, module_name: module_name)
  )
  let resolved_exits = map(exit_results, er => er.exit_mapping)
  let exit_diags = fold(exit_results, init: [], f: (acc, er) => concat(acc, er.diagnostics))

  let transport_result = if op.transport == none {
    TransportResolveResult { transport: LocalBinding, diagnostics: [] }
  } else {
    resolve_transport_binding(transport: op.transport.value, env: env, module_name: module_name)
  }

  OperationResult {
    operation: OperationDef {
      name: op.name,
      inputs: resolved_inputs,
      outputs: resolved_outputs,
      response: resolved_responses,
      mock_response: resolved_mocks,
      exit_mappings: resolved_exits,
      modifiers: op.modifiers,
      transport: if op.transport == none { none } else { Some { value: transport_result.transport } },
      span: op.span
    },
    diagnostics: concat(input_diags, output_diags, response_diags, mock_diags, exit_diags, transport_result.diagnostics)
  }
}

// =========================================================================
// Capability resolution
// =========================================================================

fn resolve_capability(cap: CapabilityDef, env: TypeEnv, module_name: String) -> CapabilityResult {
  let input_results = map(cap.inputs, f => resolve_field(field: f, env: env, module_name: module_name))
  let output_results = map(cap.outputs, f => resolve_field(field: f, env: env, module_name: module_name))
  let resolved_inputs = map(input_results, fr => fr.field)
  let resolved_outputs = map(output_results, fr => fr.field)
  let input_diags = fold(input_results, init: [], f: (acc, fr) => concat(acc, fr.diagnostics))
  let output_diags = fold(output_results, init: [], f: (acc, fr) => concat(acc, fr.diagnostics))
  CapabilityResult {
    capability: CapabilityDef {
      name: cap.name,
      inputs: resolved_inputs,
      outputs: resolved_outputs,
      span: cap.span
    },
    diagnostics: concat(input_diags, output_diags)
  }
}

// =========================================================================
// ResourceUse resolution
// =========================================================================

fn resolve_resource_use(ru: ResourceUse, env: TypeEnv, module_name: String) -> ResourceUseResult {
  let type_result = resolve_type_expr(expr: ru.resource, env: env, module_name: module_name)
  ResourceUseResult {
    resource_use: ResourceUse {
      name: ru.name,
      resource: type_result.resolved,
      span: ru.span
    },
    diagnostics: type_result.diagnostics
  }
}

// =========================================================================
// Resolve optional TypeExpr (used for return types)
// =========================================================================

fn resolve_optional_type_expr(expr: TypeExpr?, env: TypeEnv, module_name: String) -> ResolveResult {
  // Use field access instead of match on Some/None — the evaluator
  // represents Optional as Map({"value": ...}) without _variant field,
  // so variant pattern matching (Some { value: te }) doesn't work.
  if expr == none {
    let no_span = SourceSpan { start: 0, end: 0 }
    ResolveResult {
      resolved: Primitive { name: "Unit", span: no_span },
      diagnostics: []
    }
  } else {
    resolve_type_expr(expr: expr.value, env: env, module_name: module_name)
  }
}

fn resolve_named_arg(arg: NamedArg, env: TypeEnv, module_name: String) -> NamedArgResolveResult {
  let value_result = resolve_expr_types(expr: arg.value, env: env, module_name: module_name)
  NamedArgResolveResult {
    arg: NamedArg { name: arg.name, value: value_result.expr },
    diagnostics: value_result.diagnostics
  }
}

fn resolve_field_init(field_init: FieldInit, env: TypeEnv, module_name: String) -> FieldInitResolveResult {
  let value_result = resolve_expr_types(expr: field_init.value, env: env, module_name: module_name)
  FieldInitResolveResult {
    field_init: FieldInit { name: field_init.name, value: value_result.expr },
    diagnostics: value_result.diagnostics
  }
}

fn resolve_match_arm(arm: MatchArm, env: TypeEnv, module_name: String) -> MatchArmResolveResult {
  let guard_result = if arm.guard == none {
    ExprResolveResult { expr: Literal { value: LitNull, span: no_span() }, diagnostics: [] }
  } else {
    resolve_expr_types(expr: arm.guard.value, env: env, module_name: module_name)
  }
  let body_result = resolve_expr_types(expr: arm.body, env: env, module_name: module_name)
  MatchArmResolveResult {
    arm: MatchArm {
      pattern: arm.pattern,
      guard: if arm.guard == none { none } else { Some { value: guard_result.expr } },
      body: body_result.expr
    },
    diagnostics: concat(guard_result.diagnostics, body_result.diagnostics)
  }
}

fn resolve_string_part(part: StringPart, env: TypeEnv, module_name: String) -> StringPartResolveResult {
  match part {
    Text { value: value } =>
      StringPartResolveResult {
        part: Text { value: value },
        diagnostics: []
      }
    Interpolation { expr: expr } =>
      let expr_result = resolve_expr_types(expr: expr, env: env, module_name: module_name)
      StringPartResolveResult {
        part: Interpolation { expr: expr_result.expr },
        diagnostics: expr_result.diagnostics
      }
  }
}

fn resolve_header_def(header: HeaderDef, env: TypeEnv, module_name: String) -> HeaderResolveResult {
  let value_result = resolve_expr_types(expr: header.value, env: env, module_name: module_name)
  HeaderResolveResult {
    header: HeaderDef { name: header.name, value: value_result.expr },
    diagnostics: value_result.diagnostics
  }
}

fn resolve_env_def(env_def: EnvDef, env: TypeEnv, module_name: String) -> EnvDefResolveResult {
  let value_result = resolve_expr_types(expr: env_def.value, env: env, module_name: module_name)
  EnvDefResolveResult {
    env_def: EnvDef { name: env_def.name, value: value_result.expr },
    diagnostics: value_result.diagnostics
  }
}

fn resolve_auth_config(config: AuthConfig, env: TypeEnv, module_name: String) -> AuthConfigResolveResult {
  let token_result = resolve_expr_types(expr: config.token_expr, env: env, module_name: module_name)
  AuthConfigResolveResult {
    config: AuthConfig {
      scheme: config.scheme,
      header: config.header,
      token_expr: token_result.expr
    },
    diagnostics: token_result.diagnostics
  }
}

fn resolve_service_config(config: ServiceConfig, env: TypeEnv, module_name: String) -> ServiceConfigResolveResult {
  let endpoint_result = resolve_expr_types(expr: config.endpoint, env: env, module_name: module_name)
  let auth_result = if config.auth == none {
    ExprResolveResult { expr: Literal { value: LitNull, span: no_span() }, diagnostics: [] }
  } else {
    resolve_expr_types(expr: config.auth.value, env: env, module_name: module_name)
  }
  let rate_result = if config.rate_limit == none {
    ExprResolveResult { expr: Literal { value: LitNull, span: no_span() }, diagnostics: [] }
  } else {
    resolve_expr_types(expr: config.rate_limit.value, env: env, module_name: module_name)
  }
  let retry_result = if config.retry == none {
    ExprResolveResult { expr: Literal { value: LitNull, span: no_span() }, diagnostics: [] }
  } else {
    resolve_expr_types(expr: config.retry.value, env: env, module_name: module_name)
  }
  ServiceConfigResolveResult {
    config: ServiceConfig {
      endpoint: endpoint_result.expr,
      auth: if config.auth == none { none } else { Some { value: auth_result.expr } },
      rate_limit: if config.rate_limit == none { none } else { Some { value: rate_result.expr } },
      retry: if config.retry == none { none } else { Some { value: retry_result.expr } }
    },
    diagnostics: concat(endpoint_result.diagnostics, auth_result.diagnostics, rate_result.diagnostics, retry_result.diagnostics)
  }
}

fn resolve_transport_binding(transport: TransportBinding, env: TypeEnv, module_name: String) -> TransportResolveResult {
  match transport {
    RestBinding { base_url: base_url, auth: auth, headers: headers } =>
      let base_result = resolve_expr_types(expr: base_url, env: env, module_name: module_name)
      let auth_result = if auth == none {
        AuthConfigResolveResult {
          config: AuthConfig { scheme: "", header: "", token_expr: Literal { value: LitNull, span: no_span() } },
          diagnostics: []
        }
      } else {
        resolve_auth_config(config: auth.value, env: env, module_name: module_name)
      }
      let header_results = map(headers, h => resolve_header_def(header: h, env: env, module_name: module_name))
      let resolved_headers = map(header_results, hr => hr.header)
      let header_diags = fold(header_results, init: [], f: (acc, hr) => concat(acc, hr.diagnostics))
      TransportResolveResult {
        transport: RestBinding {
          base_url: base_result.expr,
          auth: if auth == none { none } else { Some { value: auth_result.config } },
          headers: resolved_headers
        },
        diagnostics: concat(base_result.diagnostics, auth_result.diagnostics, header_diags)
      }
    ShellBinding { argv: argv, env: env_defs } =>
      let argv_results = map(argv, arg => resolve_expr_types(expr: arg, env: env, module_name: module_name))
      let env_results = map(env_defs, entry => resolve_env_def(env_def: entry, env: env, module_name: module_name))
      let resolved_argv = map(argv_results, r => r.expr)
      let resolved_env_defs = map(env_results, r => r.env_def)
      let argv_diags = fold(argv_results, init: [], f: (acc, r) => concat(acc, r.diagnostics))
      let env_diags = fold(env_results, init: [], f: (acc, r) => concat(acc, r.diagnostics))
      TransportResolveResult {
        transport: ShellBinding { argv: resolved_argv, env: resolved_env_defs },
        diagnostics: concat(argv_diags, env_diags)
      }
    FileBinding { base_path: base_path } =>
      let base_result = resolve_expr_types(expr: base_path, env: env, module_name: module_name)
      TransportResolveResult {
        transport: FileBinding { base_path: base_result.expr },
        diagnostics: base_result.diagnostics
      }
    LocalBinding =>
      TransportResolveResult { transport: LocalBinding, diagnostics: [] }
  }
}

fn resolve_mock_response(mock_response: MockResponseDef, env: TypeEnv, module_name: String) -> MockResponseResolveResult {
  let status_result = resolve_expr_types(expr: mock_response.status, env: env, module_name: module_name)
  let body_result = resolve_expr_types(expr: mock_response.body, env: env, module_name: module_name)
  MockResponseResolveResult {
    mock_response: MockResponseDef {
      status: status_result.expr,
      body: body_result.expr,
      description: mock_response.description
    },
    diagnostics: concat(status_result.diagnostics, body_result.diagnostics)
  }
}

fn resolve_response_mapping(mapping: ResponseMapping, env: TypeEnv, module_name: String) -> ResponseMappingResolveResult {
  let status_result = resolve_expr_types(expr: mapping.status, env: env, module_name: module_name)
  let type_result = resolve_type_expr(expr: mapping.type_expr, env: env, module_name: module_name)
  ResponseMappingResolveResult {
    response: ResponseMapping {
      status: status_result.expr,
      type_expr: type_result.resolved
    },
    diagnostics: concat(status_result.diagnostics, type_result.diagnostics)
  }
}

fn resolve_exit_mapping(mapping: ExitMapping, env: TypeEnv, module_name: String) -> ExitMappingResolveResult {
  let code_result = resolve_expr_types(expr: mapping.code, env: env, module_name: module_name)
  let type_result = resolve_type_expr(expr: mapping.type_expr, env: env, module_name: module_name)
  ExitMappingResolveResult {
    exit_mapping: ExitMapping {
      code: code_result.expr,
      type_expr: type_result.resolved,
      description: mapping.description
    },
    diagnostics: concat(code_result.diagnostics, type_result.diagnostics)
  }
}

fn resolve_expr_types(expr: Expr, env: TypeEnv, module_name: String) -> ExprResolveResult {
  match expr {
    Literal { value: _, span: _ } =>
      ExprResolveResult { expr: expr, diagnostics: [] }
    Var { name: _, span: _ } =>
      ExprResolveResult { expr: expr, diagnostics: [] }

    FieldAccess { base: base, field: field, span: span } =>
      let base_result = resolve_expr_types(expr: base, env: env, module_name: module_name)
      ExprResolveResult {
        expr: FieldAccess { base: base_result.expr, field: field, span: span },
        diagnostics: base_result.diagnostics
      }

    Call { func: func, args: args, span: span } =>
      let arg_results = map(args, arg => resolve_named_arg(arg: arg, env: env, module_name: module_name))
      let resolved_args = map(arg_results, ar => ar.arg)
      let arg_diags = fold(arg_results, init: [], f: (acc, ar) => concat(acc, ar.diagnostics))
      ExprResolveResult {
        expr: Call { func: func, args: resolved_args, span: span },
        diagnostics: arg_diags
      }

    MethodCall { receiver: receiver, method: method, args: args, span: span } =>
      let recv_result = resolve_expr_types(expr: receiver, env: env, module_name: module_name)
      let arg_results = map(args, arg => resolve_named_arg(arg: arg, env: env, module_name: module_name))
      let resolved_args = map(arg_results, ar => ar.arg)
      let arg_diags = fold(arg_results, init: [], f: (acc, ar) => concat(acc, ar.diagnostics))
      ExprResolveResult {
        expr: MethodCall { receiver: recv_result.expr, method: method, args: resolved_args, span: span },
        diagnostics: concat(recv_result.diagnostics, arg_diags)
      }

    Match { scrutinee: scrutinee, arms: arms, span: span } =>
      let scrutinee_result = resolve_expr_types(expr: scrutinee, env: env, module_name: module_name)
      let arm_results = map(arms, arm => resolve_match_arm(arm: arm, env: env, module_name: module_name))
      let resolved_arms = map(arm_results, ar => ar.arm)
      let arm_diags = fold(arm_results, init: [], f: (acc, ar) => concat(acc, ar.diagnostics))
      ExprResolveResult {
        expr: Match { scrutinee: scrutinee_result.expr, arms: resolved_arms, span: span },
        diagnostics: concat(scrutinee_result.diagnostics, arm_diags)
      }

    If { condition: condition, then_branch: then_branch, else_branch: else_branch, span: span } =>
      let cond_result = resolve_expr_types(expr: condition, env: env, module_name: module_name)
      let then_result = resolve_expr_types(expr: then_branch, env: env, module_name: module_name)
      let else_result = if else_branch == none {
        ExprResolveResult { expr: Literal { value: LitNull, span: no_span() }, diagnostics: [] }
      } else {
        resolve_expr_types(expr: else_branch.value, env: env, module_name: module_name)
      }
      ExprResolveResult {
        expr: If {
          condition: cond_result.expr,
          then_branch: then_result.expr,
          else_branch: if else_branch == none { none } else { Some { value: else_result.expr } },
          span: span
        },
        diagnostics: concat(cond_result.diagnostics, then_result.diagnostics, else_result.diagnostics)
      }

    Let { name: name, value: value, body: body, span: span } =>
      let value_result = resolve_expr_types(expr: value, env: env, module_name: module_name)
      let body_result = if body == none {
        ExprResolveResult { expr: Literal { value: LitNull, span: no_span() }, diagnostics: [] }
      } else {
        resolve_expr_types(expr: body.value, env: env, module_name: module_name)
      }
      ExprResolveResult {
        expr: Let {
          name: name,
          value: value_result.expr,
          body: if body == none { none } else { Some { value: body_result.expr } },
          span: span
        },
        diagnostics: concat(value_result.diagnostics, body_result.diagnostics)
      }

    RecordLit { type_name: type_name, fields: fields, span: span } =>
      let field_results = map(fields, field_init => resolve_field_init(field_init: field_init, env: env, module_name: module_name))
      let resolved_fields = map(field_results, fr => fr.field_init)
      let field_diags = fold(field_results, init: [], f: (acc, fr) => concat(acc, fr.diagnostics))
      ExprResolveResult {
        expr: RecordLit { type_name: type_name, fields: resolved_fields, span: span },
        diagnostics: field_diags
      }

    ListLit { elements: elements, span: span } =>
      let element_results = map(elements, element => resolve_expr_types(expr: element, env: env, module_name: module_name))
      let resolved_elements = map(element_results, er => er.expr)
      let element_diags = fold(element_results, init: [], f: (acc, er) => concat(acc, er.diagnostics))
      ExprResolveResult {
        expr: ListLit { elements: resolved_elements, span: span },
        diagnostics: element_diags
      }

    BinOp { op: op, left: left, right: right, span: span } =>
      let left_result = resolve_expr_types(expr: left, env: env, module_name: module_name)
      let right_result = resolve_expr_types(expr: right, env: env, module_name: module_name)
      ExprResolveResult {
        expr: BinOp { op: op, left: left_result.expr, right: right_result.expr, span: span },
        diagnostics: concat(left_result.diagnostics, right_result.diagnostics)
      }

    UnaryOp { op: op, operand: operand, span: span } =>
      let operand_result = resolve_expr_types(expr: operand, env: env, module_name: module_name)
      ExprResolveResult {
        expr: UnaryOp { op: op, operand: operand_result.expr, span: span },
        diagnostics: operand_result.diagnostics
      }

    Lambda { params: params, body: body, span: span } =>
      let body_result = resolve_expr_types(expr: body, env: env, module_name: module_name)
      ExprResolveResult {
        expr: Lambda { params: params, body: body_result.expr, span: span },
        diagnostics: body_result.diagnostics
      }

    StringInterp { parts: parts, span: span } =>
      let part_results = map(parts, part => resolve_string_part(part: part, env: env, module_name: module_name))
      let resolved_parts = map(part_results, pr => pr.part)
      let part_diags = fold(part_results, init: [], f: (acc, pr) => concat(acc, pr.diagnostics))
      ExprResolveResult {
        expr: StringInterp { parts: resolved_parts, span: span },
        diagnostics: part_diags
      }

    Block { stmts: stmts, span: span } =>
      let stmt_results = map(stmts, stmt => resolve_expr_types(expr: stmt, env: env, module_name: module_name))
      let resolved_stmts = map(stmt_results, sr => sr.expr)
      let stmt_diags = fold(stmt_results, init: [], f: (acc, sr) => concat(acc, sr.diagnostics))
      ExprResolveResult {
        expr: Block { stmts: resolved_stmts, span: span },
        diagnostics: stmt_diags
      }

    Cast { expr: inner, target: target, span: span } =>
      let expr_result = resolve_expr_types(expr: inner, env: env, module_name: module_name)
      let type_result = resolve_type_expr(expr: target, env: env, module_name: module_name)
      ExprResolveResult {
        expr: Cast { expr: expr_result.expr, target: type_result.resolved, span: span },
        diagnostics: concat(expr_result.diagnostics, type_result.diagnostics)
      }

    ForEach { variable: variable, collection: collection, body: body, span: span } =>
      let collection_result = resolve_expr_types(expr: collection, env: env, module_name: module_name)
      let body_result = resolve_expr_types(expr: body, env: env, module_name: module_name)
      ExprResolveResult {
        expr: ForEach {
          variable: variable,
          collection: collection_result.expr,
          body: body_result.expr,
          span: span
        },
        diagnostics: concat(collection_result.diagnostics, body_result.diagnostics)
      }

    Index { base: base, index: index, span: span } =>
      let base_result = resolve_expr_types(expr: base, env: env, module_name: module_name)
      let index_result = resolve_expr_types(expr: index, env: env, module_name: module_name)
      ExprResolveResult {
        expr: Index { base: base_result.expr, index: index_result.expr, span: span },
        diagnostics: concat(base_result.diagnostics, index_result.diagnostics)
      }

    Slice { base: base, start: start, end: end, span: span } =>
      let base_result = resolve_expr_types(expr: base, env: env, module_name: module_name)
      let start_result = resolve_expr_types(expr: start, env: env, module_name: module_name)
      let end_result = resolve_expr_types(expr: end, env: env, module_name: module_name)
      ExprResolveResult {
        expr: Slice {
          base: base_result.expr,
          start: start_result.expr,
          end: end_result.expr,
          span: span
        },
        diagnostics: concat(base_result.diagnostics, start_result.diagnostics, end_result.diagnostics)
      }
  }
}

// =========================================================================
// Resolve all type expressions within a single Item
//
// Walks through the item's type references (params, return types,
// field types, etc.) and resolves each one against the environment.
// =========================================================================

fn resolve_item_types(item: Item, env: TypeEnv, module_name: String) -> ItemResult {
  match item {
    TypeDef { name: name, body: body, span: span } =>
      let body_result = resolve_type_body(body: body, env: env, module_name: module_name)
      ItemResult {
        item: TypeDef { name: name, body: body_result.body, span: span },
        diagnostics: body_result.diagnostics
      }

    FnDef { name: name, params: params, return_type: return_type, body: body, span: span } =>
      let param_results = map(params, p => resolve_param(param: p, env: env, module_name: module_name))
      let resolved_params = map(param_results, pr => pr.param)
      let param_diags = fold(param_results, init: [], f: (acc, pr) => concat(acc, pr.diagnostics))
      let ret_result = resolve_optional_type_expr(expr: return_type, env: env, module_name: module_name)
      let body_result = resolve_expr_types(expr: body, env: env, module_name: module_name)
      // Wrap resolved type back in Option to preserve return_type: TypeExpr? contract.
      let resolved_ret = if return_type == none { none } else { Some { value: ret_result.resolved } }
      ItemResult {
        item: FnDef {
          name: name,
          params: resolved_params,
          return_type: resolved_ret,
          body: body_result.expr,
          span: span
        },
        diagnostics: concat(param_diags, ret_result.diagnostics, body_result.diagnostics)
      }

    FuncDef { name: name, params: params, return_type: return_type, uses: uses, body: body, span: span } =>
      let param_results = map(params, p => resolve_param(param: p, env: env, module_name: module_name))
      let resolved_params = map(param_results, pr => pr.param)
      let param_diags = fold(param_results, init: [], f: (acc, pr) => concat(acc, pr.diagnostics))
      let ret_result = resolve_optional_type_expr(expr: return_type, env: env, module_name: module_name)
      let use_results = map(uses, u => resolve_resource_use(ru: u, env: env, module_name: module_name))
      let resolved_uses = map(use_results, ur => ur.resource_use)
      let use_diags = fold(use_results, init: [], f: (acc, ur) => concat(acc, ur.diagnostics))
      let body_result = resolve_expr_types(expr: body, env: env, module_name: module_name)
      // Wrap resolved type back in Option to preserve return_type: TypeExpr? contract.
      let resolved_ret = if return_type == none { none } else { Some { value: ret_result.resolved } }
      ItemResult {
        item: FuncDef {
          name: name,
          params: resolved_params,
          return_type: resolved_ret,
          uses: resolved_uses,
          body: body_result.expr,
          span: span
        },
        diagnostics: concat(param_diags, ret_result.diagnostics, use_diags, body_result.diagnostics)
      }

    ServiceDef { name: name, transport: transport, config: config, operations: operations, span: span } =>
      let transport_result = resolve_transport_binding(transport: transport, env: env, module_name: module_name)
      let config_result = if config == none {
        ServiceConfigResolveResult {
          config: ServiceConfig { endpoint: Literal { value: LitNull, span: no_span() }, auth: none, rate_limit: none, retry: none },
          diagnostics: []
        }
      } else {
        resolve_service_config(config: config.value, env: env, module_name: module_name)
      }
      let op_results = map(operations, op => resolve_operation(op: op, env: env, module_name: module_name))
      let resolved_ops = map(op_results, opr => opr.operation)
      let op_diags = fold(op_results, init: [], f: (acc, opr) => concat(acc, opr.diagnostics))
      ItemResult {
        item: ServiceDef {
          name: name,
          transport: transport_result.transport,
          config: if config == none { none } else { Some { value: config_result.config } },
          operations: resolved_ops,
          span: span
        },
        diagnostics: concat(transport_result.diagnostics, config_result.diagnostics, op_diags)
      }

    ResourceDef { name: name, properties: props, capabilities: capabilities, span: span } =>
      let prop_results = map(props, p => resolve_field_init(field_init: p, env: env, module_name: module_name))
      let resolved_props = map(prop_results, pr => pr.field_init)
      let prop_diags = fold(prop_results, init: [], f: (acc, pr) => concat(acc, pr.diagnostics))
      let cap_results = map(capabilities, c => resolve_capability(cap: c, env: env, module_name: module_name))
      let resolved_caps = map(cap_results, cr => cr.capability)
      let cap_diags = fold(cap_results, init: [], f: (acc, cr) => concat(acc, cr.diagnostics))
      ItemResult {
        item: ResourceDef {
          name: name,
          properties: resolved_props,
          capabilities: resolved_caps,
          span: span
        },
        diagnostics: concat(prop_diags, cap_diags)
      }

    DataDef { name: name, type_expr: type_expr, value: value, span: span } =>
      let type_result = resolve_type_expr(expr: type_expr, env: env, module_name: module_name)
      let value_result = resolve_expr_types(expr: value, env: env, module_name: module_name)
      ItemResult {
        item: DataDef {
          name: name,
          type_expr: type_result.resolved,
          value: value_result.expr,
          span: span
        },
        diagnostics: concat(type_result.diagnostics, value_result.diagnostics)
      }

    ExternFuncDecl { name: name, params: params, return_type: return_type, span: span } =>
      let param_results = map(params, p => resolve_param(param: p, env: env, module_name: module_name))
      let resolved_params = map(param_results, pr => pr.param)
      let param_diags = fold(param_results, init: [], f: (acc, pr) => concat(acc, pr.diagnostics))
      let ret_result = resolve_type_expr(expr: return_type, env: env, module_name: module_name)
      ItemResult {
        item: ExternFuncDecl {
          name: name,
          params: resolved_params,
          return_type: ret_result.resolved,
          span: span
        },
        diagnostics: concat(param_diags, ret_result.diagnostics)
      }
  }
}

// =========================================================================
// Resolve a TypeBody (Record/Sum/Alias)
// =========================================================================

type TypeBodyResult {
  body: TypeBody
  diagnostics: List<Diagnostic>
}

fn resolve_type_body(body: TypeBody, env: TypeEnv, module_name: String) -> TypeBodyResult {
  match body {
    Record { fields: fields } =>
      let field_results = map(fields, f => resolve_field(field: f, env: env, module_name: module_name))
      let resolved_fields = map(field_results, fr => fr.field)
      let all_diags = fold(field_results, init: [], f: (acc, fr) => concat(acc, fr.diagnostics))
      TypeBodyResult {
        body: Record { fields: resolved_fields },
        diagnostics: all_diags
      }

    Sum { variants: variants } =>
      let variant_results = map(variants, v => resolve_variant(variant: v, env: env, module_name: module_name))
      let resolved_variants = map(variant_results, vr => vr.variant)
      let all_diags = fold(variant_results, init: [], f: (acc, vr) => concat(acc, vr.diagnostics))
      TypeBodyResult {
        body: Sum { variants: resolved_variants },
        diagnostics: all_diags
      }

    Alias { base: base } =>
      let base_result = resolve_type_expr(expr: base, env: env, module_name: module_name)
      TypeBodyResult {
        body: Alias { base: base_result.resolved },
        diagnostics: base_result.diagnostics
      }
  }
}

// =========================================================================
// Typecheck a single module
//
// Builds the type environment, then resolves all type expressions in
// every item. Returns the typed module with its environment.
// =========================================================================

type TypecheckModuleResult {
  typed: TypedModule
  diagnostics: List<Diagnostic>
}

fn typecheck_module(resolved: ResolvedModule, parent_modules: List<TypedModule>) -> TypecheckModuleResult {
  let env_result = build_type_env(module: resolved, parent_modules: parent_modules)
  let env = env_result.env
  // Resolve all type expressions in every item against the environment.
  let item_results = map(resolved.module.items, item =>
    resolve_item_types(item: item, env: env, module_name: resolved.module.name)
  )
  let resolved_items = map(item_results, ir => ir.item)
  let item_diags = fold(item_results, init: [], f: (acc, ir) => concat(acc, ir.diagnostics))

  // Rebuild the module with resolved items.
  let typed_module = Module {
    name: resolved.module.name,
    imports: resolved.module.imports,
    items: resolved_items,
    span: resolved.module.span
  }

  // Also resolve the types in the environment itself, so that all
  // bindings point to fully-resolved structural forms.
  let resolved_env = resolve_env_bindings(env: env, module_name: resolved.module.name)

  // Build func_env from the resolved items (return types resolved by now).
  let func_env = build_func_env(items: resolved_items)

  // Build the InferScope and infer all items to produce TypedItems.
  let infer_scope = InferScope {
    type_env: resolved_env.env,
    func_env: func_env,
    locals: [],
    module_name: resolved.module.name,
    type_cache: []
  }
  let typed_item_results = infer_items(items: resolved_items, scope: infer_scope)
  let typed_items = map(typed_item_results, tir => tir.item)
  let infer_diags = fold(typed_item_results, init: [], f: (acc, tir) => concat(acc, tir.diagnostics))
  let rev_type_entries = fold(typed_item_results, init: [], f: (acc, tir) => concat(tir.type_entries, acc))
  let all_type_entries = reverse(rev_type_entries)

  TypecheckModuleResult {
    typed: TypedModule {
      module: typed_module,
      items: typed_items,
      type_env: resolved_env.env,
      func_env: func_env,
      type_cache: all_type_entries
    },
    diagnostics: concat(env_result.diagnostics, item_diags, resolved_env.diagnostics, infer_diags)
  }
}

// =========================================================================
// Resolve all bindings in a TypeEnv
//
// After building the initial environment (which may contain Named
// references within Product/Coproduct fields), resolve every binding
// so downstream consumers see fully-structural types.
// =========================================================================

type EnvResolveResult {
  env: TypeEnv
  diagnostics: List<Diagnostic>
}

// Result of resolving a single type binding — follows the same
// value+diagnostics pattern as ResolveResult, ItemResult, etc.
type BindingResult {
  binding: TypeBinding
  diagnostics: List<Diagnostic>
}

fn resolve_env_bindings(env: TypeEnv, module_name: String) -> EnvResolveResult {
  let results = map(env.bindings, b =>
    let result = resolve_type_expr(expr: b.resolved, env: env, module_name: module_name)
    BindingResult { binding: TypeBinding { name: b.name, resolved: result.resolved }, diagnostics: result.diagnostics }
  )
  let resolved_bindings = map(results, r => r.binding)
  let all_diags = fold(results, init: [], f: (acc, r) => concat(acc, r.diagnostics))
  EnvResolveResult {
    env: TypeEnv { bindings: resolved_bindings },
    diagnostics: all_diags
  }
}

// =========================================================================
// Find a TypedModule by name in the typed module list
// =========================================================================

fn find_typed_module(modules: List<TypedModule>, name: String) -> TypedModule? {
  let matches = filter(modules, m => m.module.name == name)
  let n = count(matches)
  if n > 0 {
    first(matches)
  } else {
    None
  }
}

// =========================================================================
// Collect parent type environments for a module
//
// Gathers the TypeEnvs from all modules that this module imports from,
// by looking up already-typed modules in the completed list.
// =========================================================================

fn collect_parent_envs(resolved: ResolvedModule, typed_modules: List<TypedModule>) -> ParentModulesResult {
  fold(resolved.resolved_imports, init: ParentModulesResult { modules: [], diagnostics: [] }, f: (acc, imp) =>
    match find_typed_module(modules: typed_modules, name: imp.module_path) {
      Some { value: typed } =>
        ParentModulesResult {
          modules: concat(acc.modules, [typed]),
          diagnostics: acc.diagnostics
        }
      None =>
        ParentModulesResult {
          modules: acc.modules,
          diagnostics: concat(acc.diagnostics, [Diagnostic {
            severity: Error,
            message: concat("missing parent environment for imported module '", imp.module_path, "' while ordering '", resolved.module.name, "'"),
            span: imp.target_module.value.span,
            module_name: resolved.module.name
          }])
        }
    }
  )
}

// =========================================================================
// Main entry point: typecheck
//
// Processes modules in dependency order (from the resolver's dep_order).
// Each module sees the type environments of all its dependencies.
//
// Invariant: after this function returns, no unresolved Named references
// survive (except recursive cycle-breakers that are guaranteed to be
// defined in the graph).
// =========================================================================

fn typecheck(graph: ModuleGraph) -> TypedGraph {
  // Process modules in dependency order. Each iteration adds one
  // TypedModule to the accumulator, making its types available to
  // subsequent modules.
  let result = fold(graph.modules, init: TypedGraph { modules: [], diagnostics: [] }, f: (acc, resolved) =>
    let parent_result = collect_parent_envs(resolved: resolved, typed_modules: acc.modules)
    let tc_result = typecheck_module(resolved: resolved, parent_modules: parent_result.modules)
    TypedGraph {
      modules: concat(acc.modules, [tc_result.typed]),
      diagnostics: concat(acc.diagnostics, parent_result.diagnostics, tc_result.diagnostics)
    }
  )

  TypedGraph {
    modules: result.modules,
    diagnostics: result.diagnostics
  }
}

// =========================================================================
// Validation: check that no unresolved Named references survive
//
// Post-typecheck invariant checker. Walks every TypeExpr in every item
// of every module and reports any remaining Named references (which
// indicate a bug in the type checker).
// =========================================================================

fn validate_no_unresolved(graph: TypedGraph) -> List<Diagnostic> {
  // Collect all defined type names across the graph (for cycle-breaker detection)
  let all_defined = fold(graph.modules, init: [], f: (acc, tm) => concat(acc, tm.type_env.bindings))
  let defined_names = map(all_defined, b => b.name)
  fold(graph.modules, init: [], f: (acc, tm) =>
    // Check raw items (tm.module.items)
    let item_diags = fold(tm.module.items, init: [], f: (inner_acc, item) =>
      concat(inner_acc, collect_unresolved_in_item(item: item, module_name: tm.module.name, defined_names: defined_names))
    )
    // Also check typed items (tm.items) — these contain resolved_type on
    // TypedExpr bodies and the resolved return_type on TypedFnDef/TypedFuncDef.
    let typed_item_diags = fold(tm.items, init: [], f: (inner_acc, titem) =>
      concat(inner_acc, collect_unresolved_in_typed_item(item: titem, module_name: tm.module.name, defined_names: defined_names))
    )
    concat(acc, item_diags, typed_item_diags)
  )
}

fn collect_unresolved_in_item(item: Item, module_name: String, defined_names: List<String>) -> List<Diagnostic> {
  match item {
    TypeDef { name: _, body: body, span: _ } =>
      collect_unresolved_in_type_body(body: body, module_name: module_name, defined_names: defined_names)

    FnDef { name: _, params: params, return_type: return_type, body: body, span: _ } =>
      let param_diags = fold(params, init: [], f: (acc, p) =>
        concat(acc, collect_unresolved_in_type_expr(expr: p.type_expr, module_name: module_name, defined_names: defined_names))
      )
      let ret_diags = if return_type == none { [] }
        else { collect_unresolved_in_type_expr(expr: return_type.value, module_name: module_name, defined_names: defined_names) }
      let body_diags = collect_unresolved_in_expr(expr: body, module_name: module_name, defined_names: defined_names)
      concat(param_diags, ret_diags, body_diags)

    FuncDef { name: _, params: params, return_type: return_type, uses: uses, body: body, span: _ } =>
      let param_diags = fold(params, init: [], f: (acc, p) =>
        concat(acc, collect_unresolved_in_type_expr(expr: p.type_expr, module_name: module_name, defined_names: defined_names))
      )
      let ret_diags = if return_type == none { [] }
        else { collect_unresolved_in_type_expr(expr: return_type.value, module_name: module_name, defined_names: defined_names) }
      let use_diags = fold(uses, init: [], f: (acc, u) =>
        concat(acc, collect_unresolved_in_type_expr(expr: u.resource, module_name: module_name, defined_names: defined_names))
      )
      let body_diags = collect_unresolved_in_expr(expr: body, module_name: module_name, defined_names: defined_names)
      concat(param_diags, ret_diags, use_diags, body_diags)

    ServiceDef { name: _, transport: transport, config: config, operations: operations, span: _ } =>
      let transport_diags = collect_unresolved_in_transport_binding(transport: transport, module_name: module_name, defined_names: defined_names)
      let config_diags = if config == none {
        []
      } else {
        collect_unresolved_in_service_config(config: config.value, module_name: module_name, defined_names: defined_names)
      }
      let op_diags = fold(operations, init: [], f: (acc, op) =>
        let input_diags = fold(op.inputs, init: [], f: (inner_acc, f) =>
          concat(inner_acc, collect_unresolved_in_type_expr(expr: f.type_expr, module_name: module_name, defined_names: defined_names))
        )
        let output_diags = fold(op.outputs, init: [], f: (inner_acc, f) =>
          concat(inner_acc, collect_unresolved_in_type_expr(expr: f.type_expr, module_name: module_name, defined_names: defined_names))
        )
        let response_diags = fold(op.response, init: [], f: (inner_acc, response) =>
          concat(inner_acc, collect_unresolved_in_response_mapping(mapping: response, module_name: module_name, defined_names: defined_names))
        )
        let mock_diags = fold(op.mock_response, init: [], f: (inner_acc, mock) =>
          concat(inner_acc, collect_unresolved_in_mock_response(mock_response: mock, module_name: module_name, defined_names: defined_names))
        )
        let exit_diags = fold(op.exit_mappings, init: [], f: (inner_acc, exit_mapping) =>
          concat(inner_acc, collect_unresolved_in_exit_mapping(mapping: exit_mapping, module_name: module_name, defined_names: defined_names))
        )
        let transport_diags = if op.transport == none {
          []
        } else {
          collect_unresolved_in_transport_binding(transport: op.transport.value, module_name: module_name, defined_names: defined_names)
        }
        concat(acc, input_diags, output_diags, response_diags, mock_diags, exit_diags, transport_diags)
      )
      concat(transport_diags, config_diags, op_diags)

    ResourceDef { name: _, properties: properties, capabilities: capabilities, span: _ } =>
      let property_diags = fold(properties, init: [], f: (acc, property) =>
        concat(acc, collect_unresolved_in_field_init(field_init: property, module_name: module_name, defined_names: defined_names))
      )
      let capability_diags = fold(capabilities, init: [], f: (acc, cap) =>
        let input_diags = fold(cap.inputs, init: [], f: (inner_acc, f) =>
          concat(inner_acc, collect_unresolved_in_type_expr(expr: f.type_expr, module_name: module_name, defined_names: defined_names))
        )
        let output_diags = fold(cap.outputs, init: [], f: (inner_acc, f) =>
          concat(inner_acc, collect_unresolved_in_type_expr(expr: f.type_expr, module_name: module_name, defined_names: defined_names))
        )
        concat(acc, input_diags, output_diags)
      )
      concat(property_diags, capability_diags)

    DataDef { name: _, type_expr: type_expr, value: value, span: _ } =>
      concat(
        collect_unresolved_in_type_expr(expr: type_expr, module_name: module_name, defined_names: defined_names),
        collect_unresolved_in_expr(expr: value, module_name: module_name, defined_names: defined_names)
      )

    ExternFuncDecl { name: _, params: params, return_type: return_type, span: _ } =>
      let param_diags = fold(params, init: [], f: (acc, p) =>
        concat(acc, collect_unresolved_in_type_expr(expr: p.type_expr, module_name: module_name, defined_names: defined_names))
      )
      concat(param_diags, collect_unresolved_in_type_expr(expr: return_type, module_name: module_name, defined_names: defined_names))
  }
}

fn collect_unresolved_in_type_body(body: TypeBody, module_name: String, defined_names: List<String>) -> List<Diagnostic> {
  match body {
    Record { fields: fields } =>
      fold(fields, init: [], f: (acc, f) =>
        concat(acc, collect_unresolved_in_type_expr(expr: f.type_expr, module_name: module_name, defined_names: defined_names))
      )
    Sum { variants: variants } =>
      fold(variants, init: [], f: (acc, v) =>
        fold(v.fields, init: acc, f: (inner_acc, f) =>
          concat(inner_acc, collect_unresolved_in_type_expr(expr: f.type_expr, module_name: module_name, defined_names: defined_names))
        )
      )
    Alias { base: base } =>
      collect_unresolved_in_type_expr(expr: base, module_name: module_name, defined_names: defined_names)
  }
}

fn collect_unresolved_in_type_expr(expr: TypeExpr, module_name: String, defined_names: List<String>) -> List<Diagnostic> {
  match expr {
    Named { name: name, span: span } =>
      // Allow Named refs that are defined in the graph (recursive cycle-breakers)
      if defined_names |> any(d => d == name) {
        []
      } else {
        [Diagnostic {
          severity: Error,
          message: concat("unresolved type '", name, "' survived typecheck (internal error)"),
          span: span,
          module_name: module_name
        }]
      }

    Primitive { name: _, span: _ } => []

    Product { name: _, fields: fields, span: _ } =>
      fold(fields, init: [], f: (acc, f) =>
        concat(acc, collect_unresolved_in_type_expr(expr: f.type_expr, module_name: module_name, defined_names: defined_names))
      )

    Coproduct { name: _, variants: variants, span: _ } =>
      fold(variants, init: [], f: (acc, v) =>
        fold(v.fields, init: acc, f: (inner_acc, f) =>
          concat(inner_acc, collect_unresolved_in_type_expr(expr: f.type_expr, module_name: module_name, defined_names: defined_names))
        )
      )

    Container { kind: _, element: element, span: _ } =>
      collect_unresolved_in_type_expr(expr: element, module_name: module_name, defined_names: defined_names)

    Optional { inner: inner, span: _ } =>
      collect_unresolved_in_type_expr(expr: inner, module_name: module_name, defined_names: defined_names)

    Refined { base: base, predicates: _, span: _ } =>
      collect_unresolved_in_type_expr(expr: base, module_name: module_name, defined_names: defined_names)

    MapType { key: key, value: value, span: _ } =>
      concat(collect_unresolved_in_type_expr(expr: key, module_name: module_name, defined_names: defined_names),
        collect_unresolved_in_type_expr(expr: value, module_name: module_name, defined_names: defined_names))
  }
}

fn collect_unresolved_in_field_init(field_init: FieldInit, module_name: String, defined_names: List<String>) -> List<Diagnostic> {
  collect_unresolved_in_expr(expr: field_init.value, module_name: module_name, defined_names: defined_names)
}

fn collect_unresolved_in_named_arg(arg: NamedArg, module_name: String, defined_names: List<String>) -> List<Diagnostic> {
  collect_unresolved_in_expr(expr: arg.value, module_name: module_name, defined_names: defined_names)
}

fn collect_unresolved_in_string_part(part: StringPart, module_name: String, defined_names: List<String>) -> List<Diagnostic> {
  match part {
    Text { value: _ } => []
    Interpolation { expr: expr } =>
      collect_unresolved_in_expr(expr: expr, module_name: module_name, defined_names: defined_names)
  }
}

fn collect_unresolved_in_auth_config(config: AuthConfig, module_name: String, defined_names: List<String>) -> List<Diagnostic> {
  collect_unresolved_in_expr(expr: config.token_expr, module_name: module_name, defined_names: defined_names)
}

fn collect_unresolved_in_service_config(config: ServiceConfig, module_name: String, defined_names: List<String>) -> List<Diagnostic> {
  let endpoint_diags = collect_unresolved_in_expr(expr: config.endpoint, module_name: module_name, defined_names: defined_names)
  let auth_diags = if config.auth == none {
    []
  } else {
    collect_unresolved_in_expr(expr: config.auth.value, module_name: module_name, defined_names: defined_names)
  }
  let rate_diags = if config.rate_limit == none {
    []
  } else {
    collect_unresolved_in_expr(expr: config.rate_limit.value, module_name: module_name, defined_names: defined_names)
  }
  let retry_diags = if config.retry == none {
    []
  } else {
    collect_unresolved_in_expr(expr: config.retry.value, module_name: module_name, defined_names: defined_names)
  }
  concat(endpoint_diags, auth_diags, rate_diags, retry_diags)
}

fn collect_unresolved_in_transport_binding(transport: TransportBinding, module_name: String, defined_names: List<String>) -> List<Diagnostic> {
  match transport {
    RestBinding { base_url: base_url, auth: auth, headers: headers } =>
      let base_diags = collect_unresolved_in_expr(expr: base_url, module_name: module_name, defined_names: defined_names)
      let auth_diags = if auth == none {
        []
      } else {
        collect_unresolved_in_auth_config(config: auth.value, module_name: module_name, defined_names: defined_names)
      }
      let header_diags = fold(headers, init: [], f: (acc, header) =>
        concat(acc, collect_unresolved_in_expr(expr: header.value, module_name: module_name, defined_names: defined_names))
      )
      concat(base_diags, auth_diags, header_diags)
    ShellBinding { argv: argv, env: env_defs } =>
      let argv_diags = fold(argv, init: [], f: (acc, arg) =>
        concat(acc, collect_unresolved_in_expr(expr: arg, module_name: module_name, defined_names: defined_names))
      )
      let env_diags = fold(env_defs, init: [], f: (acc, env_def) =>
        concat(acc, collect_unresolved_in_expr(expr: env_def.value, module_name: module_name, defined_names: defined_names))
      )
      concat(argv_diags, env_diags)
    FileBinding { base_path: base_path } =>
      collect_unresolved_in_expr(expr: base_path, module_name: module_name, defined_names: defined_names)
    LocalBinding => []
  }
}

fn collect_unresolved_in_response_mapping(mapping: ResponseMapping, module_name: String, defined_names: List<String>) -> List<Diagnostic> {
  concat(
    collect_unresolved_in_expr(expr: mapping.status, module_name: module_name, defined_names: defined_names),
    collect_unresolved_in_type_expr(expr: mapping.type_expr, module_name: module_name, defined_names: defined_names)
  )
}

fn collect_unresolved_in_mock_response(mock_response: MockResponseDef, module_name: String, defined_names: List<String>) -> List<Diagnostic> {
  concat(
    collect_unresolved_in_expr(expr: mock_response.status, module_name: module_name, defined_names: defined_names),
    collect_unresolved_in_expr(expr: mock_response.body, module_name: module_name, defined_names: defined_names)
  )
}

fn collect_unresolved_in_exit_mapping(mapping: ExitMapping, module_name: String, defined_names: List<String>) -> List<Diagnostic> {
  concat(
    collect_unresolved_in_expr(expr: mapping.code, module_name: module_name, defined_names: defined_names),
    collect_unresolved_in_type_expr(expr: mapping.type_expr, module_name: module_name, defined_names: defined_names)
  )
}

fn collect_unresolved_in_expr(expr: Expr, module_name: String, defined_names: List<String>) -> List<Diagnostic> {
  match expr {
    Literal { value: _, span: _ } => []
    Var { name: _, span: _ } => []
    FieldAccess { base: base, field: _, span: _ } =>
      collect_unresolved_in_expr(expr: base, module_name: module_name, defined_names: defined_names)
    Call { func: _, args: args, span: _ } =>
      fold(args, init: [], f: (acc, arg) =>
        concat(acc, collect_unresolved_in_named_arg(arg: arg, module_name: module_name, defined_names: defined_names))
      )
    MethodCall { receiver: receiver, method: _, args: args, span: _ } =>
      let recv_diags = collect_unresolved_in_expr(expr: receiver, module_name: module_name, defined_names: defined_names)
      let arg_diags = fold(args, init: [], f: (acc, arg) =>
        concat(acc, collect_unresolved_in_named_arg(arg: arg, module_name: module_name, defined_names: defined_names))
      )
      concat(recv_diags, arg_diags)
    Match { scrutinee: scrutinee, arms: arms, span: _ } =>
      let scrutinee_diags = collect_unresolved_in_expr(expr: scrutinee, module_name: module_name, defined_names: defined_names)
      let arm_diags = fold(arms, init: [], f: (acc, arm) =>
        let guard_diags = if arm.guard == none {
          []
        } else {
          collect_unresolved_in_expr(expr: arm.guard.value, module_name: module_name, defined_names: defined_names)
        }
        let body_diags = collect_unresolved_in_expr(expr: arm.body, module_name: module_name, defined_names: defined_names)
        concat(acc, guard_diags, body_diags)
      )
      concat(scrutinee_diags, arm_diags)
    If { condition: condition, then_branch: then_branch, else_branch: else_branch, span: _ } =>
      let cond_diags = collect_unresolved_in_expr(expr: condition, module_name: module_name, defined_names: defined_names)
      let then_diags = collect_unresolved_in_expr(expr: then_branch, module_name: module_name, defined_names: defined_names)
      let else_diags = if else_branch == none {
        []
      } else {
        collect_unresolved_in_expr(expr: else_branch.value, module_name: module_name, defined_names: defined_names)
      }
      concat(cond_diags, then_diags, else_diags)
    Let { name: _, value: value, body: body, span: _ } =>
      let value_diags = collect_unresolved_in_expr(expr: value, module_name: module_name, defined_names: defined_names)
      let body_diags = if body == none {
        []
      } else {
        collect_unresolved_in_expr(expr: body.value, module_name: module_name, defined_names: defined_names)
      }
      concat(value_diags, body_diags)
    RecordLit { type_name: _, fields: fields, span: _ } =>
      fold(fields, init: [], f: (acc, field_init) =>
        concat(acc, collect_unresolved_in_field_init(field_init: field_init, module_name: module_name, defined_names: defined_names))
      )
    ListLit { elements: elements, span: _ } =>
      fold(elements, init: [], f: (acc, element) =>
        concat(acc, collect_unresolved_in_expr(expr: element, module_name: module_name, defined_names: defined_names))
      )
    BinOp { op: _, left: left, right: right, span: _ } =>
      concat(
        collect_unresolved_in_expr(expr: left, module_name: module_name, defined_names: defined_names),
        collect_unresolved_in_expr(expr: right, module_name: module_name, defined_names: defined_names)
      )
    UnaryOp { op: _, operand: operand, span: _ } =>
      collect_unresolved_in_expr(expr: operand, module_name: module_name, defined_names: defined_names)
    Lambda { params: _, body: body, span: _ } =>
      collect_unresolved_in_expr(expr: body, module_name: module_name, defined_names: defined_names)
    StringInterp { parts: parts, span: _ } =>
      fold(parts, init: [], f: (acc, part) =>
        concat(acc, collect_unresolved_in_string_part(part: part, module_name: module_name, defined_names: defined_names))
      )
    Block { stmts: stmts, span: _ } =>
      fold(stmts, init: [], f: (acc, stmt) =>
        concat(acc, collect_unresolved_in_expr(expr: stmt, module_name: module_name, defined_names: defined_names))
      )
    Cast { expr: inner, target: target, span: _ } =>
      concat(
        collect_unresolved_in_expr(expr: inner, module_name: module_name, defined_names: defined_names),
        collect_unresolved_in_type_expr(expr: target, module_name: module_name, defined_names: defined_names)
      )
    ForEach { variable: _, collection: collection, body: body, span: _ } =>
      concat(
        collect_unresolved_in_expr(expr: collection, module_name: module_name, defined_names: defined_names),
        collect_unresolved_in_expr(expr: body, module_name: module_name, defined_names: defined_names)
      )
    Index { base: base, index: index, span: _ } =>
      concat(
        collect_unresolved_in_expr(expr: base, module_name: module_name, defined_names: defined_names),
        collect_unresolved_in_expr(expr: index, module_name: module_name, defined_names: defined_names)
      )
    Slice { base: base, start: start, end: end, span: _ } =>
      concat(
        collect_unresolved_in_expr(expr: base, module_name: module_name, defined_names: defined_names),
        collect_unresolved_in_expr(expr: start, module_name: module_name, defined_names: defined_names),
        collect_unresolved_in_expr(expr: end, module_name: module_name, defined_names: defined_names)
      )
  }
}

// =========================================================================
// Validation: check TypedItems for unresolved types
//
// Walks the typed AST (TypedItem list) and checks that return types and
// inferred resolved_type fields on TypedExprs contain no unresolved Named.
// =========================================================================

fn collect_unresolved_in_typed_item(item: TypedItem, module_name: String, defined_names: List<String>) -> List<Diagnostic> {
  match item {
    TypedTypeDef { name: _, body: body, span: _ } =>
      collect_unresolved_in_type_body(body: body, module_name: module_name, defined_names: defined_names)

    TypedFnDef { name: _, params: params, return_type: rt, body: body, span: _ } =>
      let param_diags = fold(params, init: [], f: (acc, p) =>
        concat(acc, collect_unresolved_in_type_expr(expr: p.type_expr, module_name: module_name, defined_names: defined_names))
      )
      let ret_diags = collect_unresolved_in_type_expr(expr: rt, module_name: module_name, defined_names: defined_names)
      let body_diags = collect_unresolved_in_typed_expr(texpr: body, module_name: module_name, defined_names: defined_names)
      concat(param_diags, ret_diags, body_diags)

    TypedFuncDef { name: _, params: params, return_type: rt, uses: uses, body: body, span: _ } =>
      let param_diags = fold(params, init: [], f: (acc, p) =>
        concat(acc, collect_unresolved_in_type_expr(expr: p.type_expr, module_name: module_name, defined_names: defined_names))
      )
      let ret_diags = collect_unresolved_in_type_expr(expr: rt, module_name: module_name, defined_names: defined_names)
      let use_diags = fold(uses, init: [], f: (acc, u) =>
        concat(acc, collect_unresolved_in_type_expr(expr: u.resource, module_name: module_name, defined_names: defined_names))
      )
      let body_diags = collect_unresolved_in_typed_expr(texpr: body, module_name: module_name, defined_names: defined_names)
      concat(param_diags, ret_diags, use_diags, body_diags)

    TypedServiceDef { name: _, transport: transport, config: config, operations: operations, span: _ } =>
      let transport_diags = collect_unresolved_in_transport_binding(transport: transport, module_name: module_name, defined_names: defined_names)
      let config_diags = if config == none {
        []
      } else {
        collect_unresolved_in_service_config(config: config.value, module_name: module_name, defined_names: defined_names)
      }
      let op_diags = fold(operations, init: [], f: (acc, op) =>
        let input_diags = fold(op.inputs, init: [], f: (inner_acc, f) =>
          concat(inner_acc, collect_unresolved_in_type_expr(expr: f.type_expr, module_name: module_name, defined_names: defined_names))
        )
        let output_diags = fold(op.outputs, init: [], f: (inner_acc, f) =>
          concat(inner_acc, collect_unresolved_in_type_expr(expr: f.type_expr, module_name: module_name, defined_names: defined_names))
        )
        let response_diags = fold(op.response, init: [], f: (inner_acc, response) =>
          concat(inner_acc, collect_unresolved_in_response_mapping(mapping: response, module_name: module_name, defined_names: defined_names))
        )
        let mock_diags = fold(op.mock_response, init: [], f: (inner_acc, mock) =>
          concat(inner_acc, collect_unresolved_in_mock_response(mock_response: mock, module_name: module_name, defined_names: defined_names))
        )
        let exit_diags = fold(op.exit_mappings, init: [], f: (inner_acc, exit_mapping) =>
          concat(inner_acc, collect_unresolved_in_exit_mapping(mapping: exit_mapping, module_name: module_name, defined_names: defined_names))
        )
        let transport_diags = if op.transport == none {
          []
        } else {
          collect_unresolved_in_transport_binding(transport: op.transport.value, module_name: module_name, defined_names: defined_names)
        }
        concat(acc, input_diags, output_diags, response_diags, mock_diags, exit_diags, transport_diags)
      )
      concat(transport_diags, config_diags, op_diags)

    TypedResourceDef { name: _, properties: properties, capabilities: capabilities, span: _ } =>
      let property_diags = fold(properties, init: [], f: (acc, property) =>
        concat(acc, collect_unresolved_in_field_init(field_init: property, module_name: module_name, defined_names: defined_names))
      )
      let capability_diags = fold(capabilities, init: [], f: (acc, cap) =>
        let input_diags = fold(cap.inputs, init: [], f: (inner_acc, f) =>
          concat(inner_acc, collect_unresolved_in_type_expr(expr: f.type_expr, module_name: module_name, defined_names: defined_names))
        )
        let output_diags = fold(cap.outputs, init: [], f: (inner_acc, f) =>
          concat(inner_acc, collect_unresolved_in_type_expr(expr: f.type_expr, module_name: module_name, defined_names: defined_names))
        )
        concat(acc, input_diags, output_diags)
      )
      concat(property_diags, capability_diags)

    TypedDataDef { name: _, type_expr: type_expr, value: body, span: _ } =>
      let type_diags = collect_unresolved_in_type_expr(expr: type_expr, module_name: module_name, defined_names: defined_names)
      let body_diags = collect_unresolved_in_typed_expr(texpr: body, module_name: module_name, defined_names: defined_names)
      concat(type_diags, body_diags)

    TypedExternFuncDecl { name: _, params: params, return_type: rt, span: _ } =>
      let param_diags = fold(params, init: [], f: (acc, p) =>
        concat(acc, collect_unresolved_in_type_expr(expr: p.type_expr, module_name: module_name, defined_names: defined_names))
      )
      concat(param_diags, collect_unresolved_in_type_expr(expr: rt, module_name: module_name, defined_names: defined_names))
  }
}

fn collect_unresolved_in_typed_expr(texpr: TypedExpr, module_name: String, defined_names: List<String>) -> List<Diagnostic> {
  // Check the resolved_type attached to this TypedExpr node
  concat(
    collect_unresolved_in_type_expr(expr: texpr.resolved_type, module_name: module_name, defined_names: defined_names),
    collect_unresolved_in_expr(expr: texpr.expr, module_name: module_name, defined_names: defined_names)
  )
}

// =========================================================================
// Convenience: typecheck and validate in one call
//
// Returns the typed graph with any validation diagnostics appended.
// =========================================================================

fn typecheck_and_validate(graph: ModuleGraph) -> TypedGraph {
  let typed = typecheck(graph: graph)
  let validation_diags = validate_no_unresolved(graph: typed)
  TypedGraph {
    modules: typed.modules,
    diagnostics: concat(typed.diagnostics, validation_diags)
  }
}
