// v2 type environment -- structural type bindings and lookup.
//
// Defines the TypeEnv and TypeBinding types used throughout inference
// and emit. Provides the core operations: lookup, merge, and cycle
// membership checks.
//
module v2.compiler.infer_env

import v2.std.core { Node, NewlineIndex, source_text_at, authored_name_at }

// =========================================================================
// Types
// =========================================================================

type TypeEnv {
  bindings: Map<String, TypeBinding>
  recursive_types: List<String>
  recursive_type_set: Map<String, Bool>
  recursive_variant_fields: Map<String, List<RecursiveVariantFieldWitness>>
  source_index: NewlineIndex?
}

type TypeBinding {
  name: String
  resolved: Node
}

type RecursiveVariantFieldWitness {
  variant_name: String
  field_name: String
}

// =========================================================================
// Environment operations
// =========================================================================

fn is_recursive_type(env: TypeEnv, name: String) -> Bool {
  match map_get(env.recursive_type_set, name) {
    Some { value: _ } => true
    _ => false
  }
}

fn lookup_type(env: TypeEnv, name: String) -> Node? {
  let canonical = name
  match map_get(env.bindings, canonical) {
    Some { value: binding } => Some { value: binding.resolved }
    None => None
  }
}

fn authored_name(env: TypeEnv, node: Node) -> String {
  authored_name_at(source_index: env.source_index, node: node)
}

// Node-based lookup accessors — encapsulate identity extraction so
// resolve callers use node-based API, not string-based. When
// Node.name is deleted (D6), only these functions change.
fn lookup_type_for(env: TypeEnv, node: Node) -> Node? {
  lookup_type(env: env, name: node.name)
}

fn is_recursive_type_for(env: TypeEnv, node: Node) -> Bool {
  is_recursive_type(env: env, name: node.name)
}

fn recursive_variant_field_witnesses(env: TypeEnv, type_name: String) -> List<RecursiveVariantFieldWitness> {
  match map_get(env.recursive_variant_fields, type_name) {
    Some { value: witnesses } => witnesses
    None => []
  }
}

fn is_recursive_variant_field(env: TypeEnv, type_name: String, variant_name: String, field_name: String) -> Bool {
  recursive_variant_field_witnesses(env: env, type_name: type_name)
    |> any(witness => witness.variant_name == variant_name && witness.field_name == field_name)
}

fn put_recursive_variant_field_witness(fields: Map<String, List<RecursiveVariantFieldWitness>>, type_name: String, variant_name: String, field_name: String) -> Map<String, List<RecursiveVariantFieldWitness>> {
  let existing = match map_get(fields, type_name) {
    Some { value: witnesses } => witnesses
    None => []
  }
  map_insert(fields, type_name, concat(existing, [RecursiveVariantFieldWitness { variant_name: variant_name, field_name: field_name }]))
}

fn merge_recursive_variant_fields(left: Map<String, List<RecursiveVariantFieldWitness>>, right: Map<String, List<RecursiveVariantFieldWitness>>) -> Map<String, List<RecursiveVariantFieldWitness>> {
  right |> map_keys |> fold(init: left, f: (acc, type_name) =>
    match map_get(right, type_name) {
      Some { value: incoming } =>
        let existing = match map_get(acc, type_name) {
          Some { value: witnesses } => witnesses
          None => []
        }
        map_insert(acc, type_name, concat(existing, incoming))
      None => acc
    }
  )
}

fn merge_envs(envs: List<TypeEnv>) -> TypeEnv {
  let merged_bindings = fold(envs, init: empty_map(), f: (acc, env) => map_merge(acc, env.bindings))
  let merged_recursive = fold(envs, init: [], f: (acc, env) => concat(acc, env.recursive_types))
  let merged_recursive_set = fold(envs, init: empty_map(), f: (acc, env) => map_merge(acc, env.recursive_type_set))
  let merged_recursive_variant_fields = fold(envs, init: empty_map(), f: (acc, env) => merge_recursive_variant_fields(left: acc, right: env.recursive_variant_fields))
  let source_index = fold(envs, init: none, f: (acc, env) =>
    if env.source_index != none { env.source_index } else { acc }
  )
  TypeEnv { bindings: merged_bindings, recursive_types: merged_recursive, recursive_type_set: merged_recursive_set, recursive_variant_fields: merged_recursive_variant_fields, source_index: source_index }
}
