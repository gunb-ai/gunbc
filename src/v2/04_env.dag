// v2 type environment -- structural type bindings and lookup.
module v2.compiler.infer_env

import v2.std.core { Node, SourceSpan, NewlineIndex, InternTable, empty_intern_table, merge_intern_tables, intern, intern_find, intern_str, source_text_at, authored_name_at, find_child_named }
import std.induction { InductiveField, RecursionShape, DirectRecursion, ListRecursion, OptionalRecursion, SubValueRelation, SubValueUnknown, PreservedValue }

// =========================================================================
// Types
// =========================================================================

type LookupCache {
  authored_names: Map<String, String>
  child_by_name: Map<String, Map<String, Node>>
  scrutinee_by_key: Map<String, Node>
  enriched_kernel: Map<String, Node>
}

type TypeEnv {
  bindings: Map<Int, TypeBinding>
  recursive_types: List<Int>
  recursive_type_set: Map<Int, Bool>
  inductive_fields: Map<String, List<InductiveField>>
  source_indices: Map<String, NewlineIndex>
  intern_table: InternTable
  lookup_cache: LookupCache
}

fn empty_lookup_cache() -> LookupCache {
  LookupCache {
    authored_names: empty_map(),
    child_by_name: empty_map(),
    scrutinee_by_key: empty_map(),
    enriched_kernel: empty_map()
  }
}

// Memo keys: span (file+start+end) or ident. Synthetic nodes bypass cache (#4274).
fn is_synthetic_node(node: Node) -> Bool {
  node.span.start == 0 && node.span.end == 0 && node.ident_span == none
}

fn span_cache_key(span: SourceSpan) -> String {
  concat(span.file, "|", to_string(span.start), "|", to_string(span.end))
}

fn node_identity_key(node: Node) -> String? {
  if is_synthetic_node(node: node) {
    none
  } else {
    match node.ident {
      Some { value: id } => Some { value: concat("id|", to_string(id)) }
      None => Some { value: span_cache_key(span: node.span) }
    }
  }
}

// Scrutinee memo: span-only keys — intern id can be rebound across TypeEnv updates (#4282).
fn scrutinee_cache_key(node: Node) -> String? {
  if is_synthetic_node(node: node) {
    none
  } else {
    Some { value: span_cache_key(span: node.span) }
  }
}

fn merge_lookup_caches(left: LookupCache, right: LookupCache) -> LookupCache {
  LookupCache {
    authored_names: map_merge(left.authored_names, right.authored_names),
    child_by_name: map_merge(left.child_by_name, right.child_by_name),
    scrutinee_by_key: map_merge(left.scrutinee_by_key, right.scrutinee_by_key),
    enriched_kernel: map_merge(left.enriched_kernel, right.enriched_kernel)
  }
}

fn lookup_cache_put_authored_name(cache: LookupCache, node: Node, source_indices: Map<String, NewlineIndex>) -> LookupCache {
  match node_identity_key(node: node) {
    None => cache
    Some { value: key } =>
      if map_get(cache.authored_names, key) != none { cache }
      else {
        LookupCache {
          authored_names: map_insert(cache.authored_names, key, authored_name_at(source_indices: source_indices, node: node)),
          child_by_name: cache.child_by_name,
          scrutinee_by_key: cache.scrutinee_by_key,
          enriched_kernel: cache.enriched_kernel
        }
      }
  }
}

fn lookup_cache_index_children(cache: LookupCache, parent: Node, source_indices: Map<String, NewlineIndex>) -> LookupCache {
  match node_identity_key(node: parent) {
    None => cache
    Some { value: parent_key } =>
      if map_get(cache.child_by_name, parent_key) != none { cache }
      else {
        let child_index = fold(parent.children, init: empty_map(), f: (acc, child) =>
          let child_name = authored_name_at(source_indices: source_indices, node: child)
          if child_name == "" { acc } else { map_insert(acc, child_name, child) }
        )
        LookupCache {
          authored_names: cache.authored_names,
          child_by_name: map_insert(cache.child_by_name, parent_key, child_index),
          scrutinee_by_key: cache.scrutinee_by_key,
          enriched_kernel: cache.enriched_kernel
        }
      }
  }
}

fn warm_lookup_cache_for_node(cache: LookupCache, node: Node, source_indices: Map<String, NewlineIndex>) -> LookupCache {
  let cache = lookup_cache_put_authored_name(cache: cache, node: node, source_indices: source_indices)
  let cache = if node.children |> count > 0 { lookup_cache_index_children(cache: cache, parent: node, source_indices: source_indices) } else { cache }
  fold(node.children, init: cache, f: (acc, child) => warm_lookup_cache_for_node(cache: acc, node: child, source_indices: source_indices))
}

fn warm_lookup_cache(env: TypeEnv, roots: List<Node>) -> TypeEnv {
  let cache = fold(roots, init: env.lookup_cache, f: (acc, root) =>
    warm_lookup_cache_for_node(cache: acc, node: root, source_indices: env.source_indices)
  )
  TypeEnv {
    bindings: env.bindings,
    recursive_types: env.recursive_types,
    recursive_type_set: env.recursive_type_set,
    inductive_fields: env.inductive_fields,
    source_indices: env.source_indices,
    intern_table: env.intern_table,
    lookup_cache: cache
  }
}

type TypeBinding {
  name: String
  resolved: Node
  provenance: SubValueRelation
}

// =========================================================================
// Environment operations
// =========================================================================

fn is_recursive_type(env: TypeEnv, ident: Int) -> Bool {
  match map_get(env.recursive_type_set, ident) {
    Some { value: _ } => true
    _ => false
  }
}

fn is_recursive_type_by_name(env: TypeEnv, name: String) -> Bool {
  match intern_find(table: env.intern_table, s: name) {
    Some { value: id } => is_recursive_type(env: env, ident: id)
    None => false
  }
}

fn lookup_type(env: TypeEnv, ident: Int) -> Node? {
  match map_get(env.bindings, ident) {
    Some { value: binding } => Some { value: binding.resolved }
    None => None
  }
}

fn lookup_type_by_name(env: TypeEnv, name: String) -> Node? {
  match intern_find(table: env.intern_table, s: name) {
    Some { value: id } => lookup_type(env: env, ident: id)
    None => None
  }
}

fn authored_name(env: TypeEnv, node: Node) -> String {
  if is_synthetic_node(node: node) {
    authored_name_at(source_indices: env.source_indices, node: node)
  } else {
    match node_identity_key(node: node) {
      None => authored_name_at(source_indices: env.source_indices, node: node)
      Some { value: key } =>
        match map_get(env.lookup_cache.authored_names, key) {
          Some { value: cached } => cached
          None => authored_name_at(source_indices: env.source_indices, node: node)
        }
    }
  }
}

fn find_child_in_env(env: TypeEnv, parent: Node, name: String) -> Node? {
  match node_identity_key(node: parent) {
    None => find_child_named(n: parent, name: name, source_indices: env.source_indices)
    Some { value: parent_key } =>
      match map_get(env.lookup_cache.child_by_name, parent_key) {
        Some { value: index } => map_get(index, name)
        None => find_child_named(n: parent, name: name, source_indices: env.source_indices)
      }
  }
}

fn has_child_in_env(env: TypeEnv, parent: Node, name: String) -> Bool {
  match find_child_in_env(env: env, parent: parent, name: name) {
    Some { value: _ } => true
    None => false
  }
}

fn lookup_cache_put_scrutinee(env: TypeEnv, key: String, resolved: Node) -> TypeEnv {
  if map_get(env.lookup_cache.scrutinee_by_key, key) != none { env }
  else {
    TypeEnv {
      bindings: env.bindings,
      recursive_types: env.recursive_types,
      recursive_type_set: env.recursive_type_set,
      inductive_fields: env.inductive_fields,
      source_indices: env.source_indices,
      intern_table: env.intern_table,
      lookup_cache: LookupCache {
        authored_names: env.lookup_cache.authored_names,
        child_by_name: env.lookup_cache.child_by_name,
        scrutinee_by_key: map_insert(env.lookup_cache.scrutinee_by_key, key, resolved),
        enriched_kernel: env.lookup_cache.enriched_kernel
      }
    }
  }
}

fn lookup_cache_get_scrutinee(env: TypeEnv, key: String) -> Node? {
  map_get(env.lookup_cache.scrutinee_by_key, key)
}

fn lookup_cache_put_enriched_kernel(env: TypeEnv, key: String, enriched: Node) -> TypeEnv {
  if map_get(env.lookup_cache.enriched_kernel, key) != none { env }
  else {
    TypeEnv {
      bindings: env.bindings,
      recursive_types: env.recursive_types,
      recursive_type_set: env.recursive_type_set,
      inductive_fields: env.inductive_fields,
      source_indices: env.source_indices,
      intern_table: env.intern_table,
      lookup_cache: LookupCache {
        authored_names: env.lookup_cache.authored_names,
        child_by_name: env.lookup_cache.child_by_name,
        scrutinee_by_key: env.lookup_cache.scrutinee_by_key,
        enriched_kernel: map_insert(env.lookup_cache.enriched_kernel, key, enriched)
      }
    }
  }
}

fn lookup_cache_get_enriched_kernel(env: TypeEnv, key: String) -> Node? {
  map_get(env.lookup_cache.enriched_kernel, key)
}

fn lookup_type_for(env: TypeEnv, node: Node) -> Node? {
  match node.ident {
    Some { value: id } => lookup_type(env: env, ident: id)
    None => lookup_type_by_name(env: env, name: authored_name(env: env, node: node))
  }
}

fn is_recursive_type_for(env: TypeEnv, node: Node) -> Bool {
  match node.ident {
    Some { value: id } => is_recursive_type(env: env, ident: id)
    None => is_recursive_type_by_name(env: env, name: authored_name(env: env, node: node))
  }
}

fn inductive_fields_for(env: TypeEnv, type_name: String) -> List<InductiveField> {
  match map_get(env.inductive_fields, type_name) {
    Some { value: fields } => fields
    None => []
  }
}

fn is_inductive_field(env: TypeEnv, type_name: String, variant_name: String, field_name: String) -> Bool {
  inductive_fields_for(env: env, type_name: type_name)
    |> any(f => f.variant_name == variant_name && f.field_name == field_name)
}

fn put_inductive_field(fields: Map<String, List<InductiveField>>, type_name: String, variant_name: String, field_name: String, shape: RecursionShape) -> Map<String, List<InductiveField>> {
  let existing = match map_get(fields, type_name) {
    Some { value: fs } => fs
    None => []
  }
  map_insert(fields, type_name, concat(existing, [InductiveField { type_name: type_name, variant_name: variant_name, field_name: field_name, shape: shape, element_type: type_name }]))
}

fn put_inductive_field_cross(fields: Map<String, List<InductiveField>>, type_name: String, variant_name: String, field_name: String, shape: RecursionShape, element_type: String) -> Map<String, List<InductiveField>> {
  let existing = match map_get(fields, type_name) {
    Some { value: fs } => fs
    None => []
  }
  map_insert(fields, type_name, concat(existing, [InductiveField { type_name: type_name, variant_name: variant_name, field_name: field_name, shape: shape, element_type: element_type }]))
}

fn merge_inductive_fields(left: Map<String, List<InductiveField>>, right: Map<String, List<InductiveField>>) -> Map<String, List<InductiveField>> {
  right |> map_keys |> fold(init: left, f: (acc, type_name) =>
    match map_get(right, type_name) {
      Some { value: incoming } =>
        let existing = match map_get(acc, type_name) {
          Some { value: fs } => fs
          None => []
        }
        map_insert(acc, type_name, concat(existing, incoming))
      None => acc
    }
  )
}

fn inductive_fields_list_to_map(fields: List<InductiveField>) -> Map<String, List<InductiveField>> {
  fields |> fold(init: empty_map(), f: (acc, field) =>
    let existing = match map_get(acc, field.type_name) {
      Some { value: fs } => fs
      None => []
    }
    map_insert(acc, field.type_name, concat(existing, [field]))
  )
}

fn merge_envs(envs: List<TypeEnv>) -> TypeEnv {
  let merged_bindings = fold(envs, init: empty_map(), f: (acc, env) => map_merge(acc, env.bindings))
  let merged_recursive = fold(envs, init: [], f: (acc, env) => concat(acc, env.recursive_types))
  let merged_recursive_set = fold(envs, init: empty_map(), f: (acc, env) => map_merge(acc, env.recursive_type_set))
  let merged_inductive_fields = fold(envs, init: empty_map(), f: (acc, env) => merge_inductive_fields(left: acc, right: env.inductive_fields))
  let merged_source_indices = fold(envs, init: empty_map(), f: (acc, env) => map_merge(acc, env.source_indices))
  let merged_intern_table = match envs |> first {
    Some { value: first_env } => first_env.intern_table
    None => empty_intern_table()
  }
  let merged_lookup_cache = fold(envs, init: empty_lookup_cache(), f: (acc, env) => merge_lookup_caches(left: acc, right: env.lookup_cache))
  TypeEnv { bindings: merged_bindings, recursive_types: merged_recursive, recursive_type_set: merged_recursive_set, inductive_fields: merged_inductive_fields, source_indices: merged_source_indices, intern_table: merged_intern_table, lookup_cache: merged_lookup_cache }
}
