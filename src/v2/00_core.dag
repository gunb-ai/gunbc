// v2 core types — the compiler's domain model.
//
// Imports shared types from std.types (the same types used by all DSL
// programs). Defines compiler-specific types (tokens, AST, expressions)
// that only the compiler needs.
//
// This module describes the COMPILER's data model, not a runtime or
// interpreter. The compiler reads .dag source files and emits target-
// language source files. There is no executable DAG IR here — the
// compiler's output is text files, not a graph to be interpreted.
//
// Dependency chain:
//   kernel primitives (String, Int, Bool, List, Map)
//     <- std.types (FilePath, NonEmptyStr, SourceSpan)
//       <- v2.std.core (Token, AST, Expr, CompileResult)
//         <- v2.compiler.* (tokenize, parse, typecheck, emit)

module v2.std.core

import std.types { FilePath, NonEmptyStr, SourceSpan }

// =========================================================================
// Tokens
//
// A token is an atomic unit of source text with a classification and
// a source location. The tokenizer produces a flat List<Token> from
// a source string.
// =========================================================================

type Token {
  kind: TokenKind
  span: SourceSpan
}

type TokenKind
  // Declaration keywords
  = KwModule | KwImport | KwType | KwFn | KwFunc
  | KwService | KwResource | KwData | KwExtern
  | KwInterface | KwPipeline | KwProfile | KwPattern
  // Control flow keywords
  | KwLet | KwReturn | KwMatch | KwIf | KwElse
  | KwFor | KwIn | KwWhere | KwWith
  // Literal keywords
  | KwTrue | KwFalse | KwNone
  // Resource lifecycle keywords
  | KwAcquire | KwRelease | KwCapability
  | KwOperation | KwInput | KwOutput
  // Modifier keywords
  | KwIdempotent | KwReadonly | KwHermetic
  // Paired delimiters
  | LBrace | RBrace | LParen | RParen | LBracket | RBracket
  // Relational / arrow
  | Lt | Gt | Le | Ge | FatArrow | Arrow
  // Separators
  | Colon | Comma | Dot | DotDot
  // Assignment / equality
  | Eq | EqEq | Ne
  // Arithmetic
  | Plus | Minus | Star | Slash | Percent
  // Logic
  | Bang | And | Or
  // Optionality
  | Question | NullCoalesce
  // Sum type separator / pipe arrow
  | Pipe
  | PipeArrow
  // Values
  | LitStr { value: String }
  | LitInt { value: Int }
  | LitFloat { value: String }
  | Ident { name: String }
  // String interpolation parts
  | StrBegin { value: String }
  | StrMid { value: String }
  | StrEnd { value: String }
  // Structure
  | Newline | Eof
  | Unknown { char: String }

// =========================================================================
// AST — Abstract Syntax Tree
//
// The parser produces an AST from a token list. The AST is a faithful
// representation of the source structure with no semantic interpretation.
// Names are strings, types are TypeExpr values, expressions are Expr
// values. Nothing is resolved or checked yet.
//
// Every node that a diagnostic might blame carries a SourceSpan for
// precise error locality.
// =========================================================================

type Module {
  name: String
  imports: List<Import>
  items: List<Node>
  span: SourceSpan
}

type ImportNames
  = ImportAll
  | ImportSpecific { names: List<String> }

type Import {
  module_path: String
  names: ImportNames
  span: SourceSpan
}

// =========================================================================
// Type expressions
//
// A TypeExpr is a VALUE that describes a type's structure. It is not a
// string key into a table. It is the type itself, represented as data.
//
// In v1, types were referenced by TypeId (a string) and resolved via
// TypeRegistry (a HashMap). In v2, TypeExpr is structural. No registry,
// no deferred lookup, no stale copies.
//
// After typechecking, no unresolved Named references survive — every
// Named { name } has been resolved to its structural form (Product,
// Coproduct, Container, Refined). Exception: recursive types may retain
// a Named reference to break the cycle, but the name is guaranteed to
// be defined in the module graph.
// =========================================================================

type TypeExpr
  = Named { name: String, span: SourceSpan }
  | Product { name: String?, fields: List<Field>, span: SourceSpan }
  | Coproduct { name: String?, variants: List<Variant>, span: SourceSpan }
  | Container { kind: ContainerKind, element: TypeExpr, span: SourceSpan }
  | Refined { base: TypeExpr, predicates: List<Predicate>, span: SourceSpan }
  | Optional { inner: TypeExpr, span: SourceSpan }
  // MapType allows arbitrary key types in the AST (pre-typecheck).
  // The typechecker enforces String-key constraint (S19).
  | MapType { key: TypeExpr, value: TypeExpr, span: SourceSpan }
  // Kernel types (String, Int, Bool, Float, Secret, Json, Unit, Bytes)
  // that have no structural expansion.
  | Primitive { name: String, span: SourceSpan }

type ContainerKind = List | Set | NonEmptyList | NonEmptySet

// Connective — the logical primitive for type structure.
// Conj = conjunction: all children hold simultaneously (record fields).
// Disj = disjunction: exactly one child holds (sum variants).
type Connective = Conj | Disj

type Field {
  name: String
  type_expr: TypeExpr
  optional: Bool
  default_value: Expr?
  from_key: String?
  span: SourceSpan
}

type Variant {
  name: String
  fields: List<Field>
  span: SourceSpan
}

type Param {
  name: String
  type_expr: TypeExpr
  default_value: Expr?
  span: SourceSpan
}

type ResourceUse {
  name: String
  resource: TypeExpr
  span: SourceSpan
}

// =========================================================================
// Predicates — type refinements
// =========================================================================

type Predicate
  = NonEmpty
  | Pattern { regex: String }
  | Range { min: Int?, max: Int? }
  | Brand { name: String }
  | ContentEncoding { encoding: String }
  | Format { name: String }
  | Domain { name: String }

// =========================================================================
// Expressions
// =========================================================================

type Expr
  = Literal { value: LiteralValue, span: SourceSpan }
  | Var { name: String, span: SourceSpan }
  | FieldAccess { base: Expr, field: String, span: SourceSpan }
  | Call { func: String, args: List<NamedArg>, span: SourceSpan }
  | MethodCall { receiver: Expr, method: String, args: List<NamedArg>, span: SourceSpan }
  | Match { scrutinee: Expr, arms: List<MatchArm>, span: SourceSpan }
  | If { condition: Expr, then_branch: Expr, else_branch: Expr?, span: SourceSpan }
  | Let { name: String, value: Expr, body: Expr?, span: SourceSpan }
  | RecordLit { type_name: String?, fields: List<FieldInit>, span: SourceSpan }
  | ListLit { elements: List<Expr>, span: SourceSpan }
  | BinOp { op: BinOpKind, left: Expr, right: Expr, span: SourceSpan }
  | UnaryOp { op: UnaryOpKind, operand: Expr, span: SourceSpan }
  | Lambda { params: List<String>, body: Expr, span: SourceSpan }
  | StringInterp { parts: List<StringPart>, span: SourceSpan }
  | Block { stmts: List<Expr>, span: SourceSpan }
  | Cast { expr: Expr, target: TypeExpr, span: SourceSpan }
  | ForEach { variable: String, collection: Expr, body: Expr, span: SourceSpan }
  | Index { base: Expr, index: Expr, span: SourceSpan }
  | Slice { base: Expr, start: Expr, end: Expr, span: SourceSpan }

type NamedArg { name: String?, value: Expr }
type MatchArm { pattern: MatchPattern, guard: Expr?, body: Expr }
type FieldInit { name: String, value: Expr }

type MatchPattern
  = Bind { name: String }
  | LitPattern { value: LiteralValue }
  | VariantPattern { name: String, field_bindings: List<FieldBinding> }
  | Wildcard

type FieldBinding {
  field_name: String
  binding: MatchPattern
}

type LiteralValue
  = LitStr { value: String }
  | LitInt { value: Int }
  | LitFloat { value: String }
  | LitBool { value: Bool }
  | LitNull

type BinOpKind
  = Add | Sub | Mul | Div | Mod
  | BinEq | BinNe | BinLt | BinGt | BinLe | BinGe
  | BinAnd | BinOr | NullCoalesce

type UnaryOpKind = Not | Neg

type StringPart
  = Text { value: String }
  | Interpolation { expr: Expr }

// =========================================================================
// Service / Transport
//
// Transport config is typed per transport kind, not a string-keyed bag.
// =========================================================================

type TransportBinding
  = RestBinding { base_url: Expr, auth: AuthConfig?, headers: List<HeaderDef> }
  | ShellBinding { argv: List<Expr>, env: List<EnvDef> }
  | FileBinding { base_path: Expr }
  | LocalBinding

type ServiceConfig {
  endpoint: Expr
  auth: Expr?
  rate_limit: Expr?
  retry: Expr?
}

type AuthConfig {
  scheme: String
  header: String
  token_expr: Expr
}

type HeaderDef { name: String, value: Expr }
type EnvDef { name: String, value: Expr }

// OperationDef: parse-intermediate type. The parser reads operations using this
// shape, then dissolves fields into Node properties and return_type.
type OperationDef {
  name: String
  inputs: List<Field>
  outputs: List<Field>
  response_props: List<FieldInit>
  mock_props: List<FieldInit>
  exit_props: List<FieldInit>
  modifier_props: List<FieldInit>
  transport: TransportBinding?
  span: SourceSpan
}

type OperationModifier = Idempotent | Readonly | Hermetic

type CapabilityDef {
  name: String
  inputs: List<Field>
  outputs: List<Field>
  span: SourceSpan
}

// =========================================================================
// Render target — which language the emitter produces.
// =========================================================================

type RenderTarget = Rust | Python | Go

// =========================================================================
// Compiler output
//
// The compiler produces files and diagnostics. No DAG, no IR, no
// executable artifact. The emitted files ARE the output.
// =========================================================================

type CompileResult {
  files: List<TextFile>
  diagnostics: List<Diagnostic>
}

type TextFile {
  path: FilePath
  content: String
}

type Diagnostic {
  severity: Severity
  message: String
  span: SourceSpan?
  module_name: String?
}

type Severity = Error | Warning

// =========================================================================
// Typed AST — produced by the typechecker after expression-level inference.
// Every expression carries its resolved TypeExpr.
// =========================================================================

type TypedExpr
  = TypedLiteral { value: LiteralValue, resolved_type: Node, span: SourceSpan }
  | TypedVar { name: String, resolved_type: Node, span: SourceSpan }
  | TypedFieldAccess { base: TypedExpr, field: String, resolved_type: Node, span: SourceSpan }
  | TypedCall { func: String, args: List<TypedNamedArg>, resolved_type: Node, span: SourceSpan }
  | TypedMethodCall { receiver: TypedExpr, method: String, args: List<TypedNamedArg>, resolved_type: Node, span: SourceSpan }
  | TypedMatch { scrutinee: TypedExpr, arms: List<TypedMatchArm>, resolved_type: Node, span: SourceSpan }
  | TypedIf { condition: TypedExpr, then_branch: TypedExpr, else_branch: TypedExpr?, resolved_type: Node, span: SourceSpan }
  | TypedLet { name: String, value: TypedExpr, body: TypedExpr?, resolved_type: Node, span: SourceSpan }
  | TypedRecordLit { type_name: String?, fields: List<TypedFieldInit>, resolved_type: Node, span: SourceSpan }
  | TypedListLit { elements: List<TypedExpr>, resolved_type: Node, span: SourceSpan }
  | TypedBinOp { op: BinOpKind, left: TypedExpr, right: TypedExpr, resolved_type: Node, span: SourceSpan }
  | TypedUnaryOp { op: UnaryOpKind, operand: TypedExpr, resolved_type: Node, span: SourceSpan }
  | TypedLambda { params: List<String>, body: TypedExpr, resolved_type: Node, span: SourceSpan }
  | TypedStringInterp { parts: List<TypedStringPart>, resolved_type: Node, span: SourceSpan }
  | TypedBlock { stmts: List<TypedExpr>, resolved_type: Node, span: SourceSpan }
  | TypedCast { expr: TypedExpr, target: Node, resolved_type: Node, span: SourceSpan }
  | TypedForEach { variable: String, collection: TypedExpr, body: TypedExpr, resolved_type: Node, span: SourceSpan }
  | TypedIndex { base: TypedExpr, index: TypedExpr, resolved_type: Node, span: SourceSpan }
  | TypedSlice { base: TypedExpr, start: TypedExpr, end: TypedExpr, resolved_type: Node, span: SourceSpan }

type TypedNamedArg { name: String?, value: TypedExpr }
type TypedMatchArm { pattern: MatchPattern, guard: TypedExpr?, body: TypedExpr }
type TypedFieldInit { name: String, value: TypedExpr }
type TypedStringPart = TypedText { value: String } | TypedInterpolation { expr: TypedExpr }

// Utility: strip TypedExpr back to Expr (needed for TCO analysis, service call collection)
fn typed_expr_to_expr(texpr: TypedExpr) -> Expr {
  match texpr {
    TypedLiteral { value: v, resolved_type: _, span: s } => Literal { value: v, span: s }
    TypedVar { name: n, resolved_type: _, span: s } => Var { name: n, span: s }
    TypedFieldAccess { base: b, field: f, resolved_type: _, span: s } => FieldAccess { base: typed_expr_to_expr(texpr: b), field: f, span: s }
    TypedCall { func: f, args: a, resolved_type: _, span: s } => Call { func: f, args: a |> map(ta => NamedArg { name: ta.name, value: typed_expr_to_expr(texpr: ta.value) }), span: s }
    TypedMethodCall { receiver: r, method: m, args: a, resolved_type: _, span: s } => MethodCall { receiver: typed_expr_to_expr(texpr: r), method: m, args: a |> map(ta => NamedArg { name: ta.name, value: typed_expr_to_expr(texpr: ta.value) }), span: s }
    TypedMatch { scrutinee: sc, arms: arms, resolved_type: _, span: s } => Match { scrutinee: typed_expr_to_expr(texpr: sc), arms: arms |> map(a => MatchArm { pattern: a.pattern, guard: if a.guard != none { Some { value: typed_expr_to_expr(texpr: a.guard.value) } } else { none }, body: typed_expr_to_expr(texpr: a.body) }), span: s }
    TypedIf { condition: c, then_branch: t, else_branch: e, resolved_type: _, span: s } => If { condition: typed_expr_to_expr(texpr: c), then_branch: typed_expr_to_expr(texpr: t), else_branch: if e != none { Some { value: typed_expr_to_expr(texpr: e.value) } } else { none }, span: s }
    TypedLet { name: n, value: v, body: b, resolved_type: _, span: s } => Let { name: n, value: typed_expr_to_expr(texpr: v), body: if b != none { Some { value: typed_expr_to_expr(texpr: b.value) } } else { none }, span: s }
    TypedRecordLit { type_name: tn, fields: fs, resolved_type: _, span: s } => RecordLit { type_name: tn, fields: fs |> map(fi => FieldInit { name: fi.name, value: typed_expr_to_expr(texpr: fi.value) }), span: s }
    TypedListLit { elements: els, resolved_type: _, span: s } => ListLit { elements: els |> map(e => typed_expr_to_expr(texpr: e)), span: s }
    TypedBinOp { op: o, left: l, right: r, resolved_type: _, span: s } => BinOp { op: o, left: typed_expr_to_expr(texpr: l), right: typed_expr_to_expr(texpr: r), span: s }
    TypedUnaryOp { op: o, operand: e, resolved_type: _, span: s } => UnaryOp { op: o, operand: typed_expr_to_expr(texpr: e), span: s }
    TypedLambda { params: ps, body: bd, resolved_type: _, span: s } => Lambda { params: ps, body: typed_expr_to_expr(texpr: bd), span: s }
    TypedStringInterp { parts: ps, resolved_type: _, span: s } => StringInterp { parts: ps |> map(p => match p { TypedText { value: v } => Text { value: v }, TypedInterpolation { expr: e } => Interpolation { expr: typed_expr_to_expr(texpr: e) } }), span: s }
    TypedBlock { stmts: ss, resolved_type: _, span: s } => Block { stmts: ss |> map(st => typed_expr_to_expr(texpr: st)), span: s }
    TypedCast { expr: e, target: t, resolved_type: _, span: s } => Cast { expr: typed_expr_to_expr(texpr: e), target: node_to_type_expr_full(n: t), span: s }
    TypedForEach { variable: v, collection: c, body: bd, resolved_type: _, span: s } => ForEach { variable: v, collection: typed_expr_to_expr(texpr: c), body: typed_expr_to_expr(texpr: bd), span: s }
    TypedIndex { base: b, index: i, resolved_type: _, span: s } => Index { base: typed_expr_to_expr(texpr: b), index: typed_expr_to_expr(texpr: i), span: s }
    TypedSlice { base: b, start: st, end: e, resolved_type: _, span: s } => Slice { base: typed_expr_to_expr(texpr: b), start: typed_expr_to_expr(texpr: st), end: typed_expr_to_expr(texpr: e), span: s }
  }
}

type FuncSig {
  name: String
  params: List<Param>
  return_type: Node
  is_async: Bool
}

type FuncEnv {
  signatures: Map<String, FuncSig>
}

// =========================================================================
// Node — unified recursive structure
//
// Everything is a node in DAG composition. Keywords (fn, type, service)
// are parse sugar that tell the parser what fields to expect. After
// parsing, everything is a Node. The checker validates edge constraints
// on node properties — never asks "what keyword?"
//
// The type is self-referential: children: List<Node>. An operation is a
// Node with params and return_type. A capability is a Node with
// input/output ports. OperationDef and CapabilityDef dissolve into Node.
// =========================================================================

type Node {
  name: String
  span: SourceSpan
  // Fractal composition — operations, capabilities, items are all children
  children: List<Node>
  // Logical connective — And (record/all-hold), Or (sum/one-holds), none (leaf)
  connective: Connective?
  // Ports — what flows in and out
  params: List<Param>
  return_type: TypeExpr?
  uses: List<ResourceUse>
  // Computation — how it executes (none = externally provided)
  body: Expr?
  // Binding — external execution strategy
  transport: TransportBinding?
  // Metadata
  properties: List<FieldInit>
  type_annotation: TypeExpr?
  config: ServiceConfig?
}

type TypedNode {
  name: String
  span: SourceSpan
  children: List<TypedNode>
  connective: Connective?
  params: List<Param>
  return_type: Node
  uses: List<ResourceUse>
  body: TypedExpr?
  transport: TransportBinding?
  properties: List<FieldInit>
  type_annotation: Node?
  config: ServiceConfig?
  is_self_recursive: Bool
  has_non_tail_self_call: Bool
}

// =========================================================================
// TypeExpr <-> Node conversion (B1 additive step)
//
// These functions bridge the gap between TypeExpr (8 variants) and Node
// (unified recursive structure). During the dual-write phase, both
// representations coexist. After migration, TypeExpr is deleted and only
// Node remains.
//
// Mapping:
//   Named { name, span }           -> Node { name, span }  (leaf, no connective)
//   Primitive { name, span }       -> Node { name, span }  (leaf, no connective)
//   Product { name?, fields, span } -> Node { name, span, connective: Conj, children: fields-as-nodes }
//   Coproduct { name?, variants, span } -> Node { name, span, connective: Disj, children: variants-as-nodes }
//   Container { kind, element, span } -> Node { name: kind_name, span, children: [element-as-node] }
//   Optional { inner, span }       -> Node { name: "Optional", span, connective: Disj, children: [inner-node, none-node] }
//   MapType { key, value, span }   -> Node { name: "Map", span, children: [key-node, value-node] }
//   Refined { base, predicates, span } -> Node { name: "Refined", span, connective: Conj, children: [base-node] }
// =========================================================================

fn empty_node(span: SourceSpan) -> Node {
  Node {
    name: "", span: span, children: [], connective: none,
    params: [], return_type: none, uses: [],
    body: none, transport: none, properties: [], type_annotation: none, config: none
  }
}

fn type_expr_to_node(te: TypeExpr) -> Node {
  match te {
    Named { name: n, span: s } =>
      type_expr_named_to_node(n: n, s: s)

    Primitive { name: n, span: s } =>
      type_expr_named_to_node(n: n, s: s)

    Product { name: pn, fields: fs, span: s } =>
      // Product.name is String? — extract name directly from the match binding.
      // In the evaluator, String? values are stored as the raw string (not
      // wrapped in Some), so we pass pn directly to the node constructor.
      type_expr_product_to_node(pn: pn, fs: fs, s: s)

    Coproduct { name: cn, variants: vs, span: s } =>
      type_expr_coproduct_to_node(cn: cn, vs: vs, s: s)

    Container { kind: k, element: el, span: s } =>
      let kind_name = match k {
        List => "List"
        Set => "Set"
        NonEmptyList => "NonEmptyList"
        NonEmptySet => "NonEmptySet"
      }
      Node {
        name: kind_name, span: s,
        children: [type_expr_to_node(te: el)],
        connective: none,
        params: [], return_type: none, uses: [],
        body: none, transport: none, properties: [], type_annotation: none, config: none
      }

    Optional { inner: inn, span: s } =>
      Node {
        name: "Optional", span: s,
        children: [type_expr_to_node(te: inn), type_expr_named_to_node(n: "None", s: s)],
        connective: Some { value: Disj },
        params: [], return_type: none, uses: [],
        body: none, transport: none, properties: [], type_annotation: none, config: none
      }

    MapType { key: k, value: v, span: s } =>
      Node {
        name: "Map", span: s,
        children: [type_expr_to_node(te: k), type_expr_to_node(te: v)],
        connective: none,
        params: [], return_type: none, uses: [],
        body: none, transport: none, properties: [], type_annotation: none, config: none
      }

    Refined { base: b, predicates: ps, span: s } =>
      Node {
        name: "Refined", span: s,
        children: [type_expr_to_node(te: b)],
        connective: Some { value: Conj },
        params: [], return_type: none, uses: [],
        body: none, transport: none,
        properties: map(ps, p => predicate_to_field_init(p: p)),
        type_annotation: none, config: none
      }
  }
}

fn type_expr_named_to_node(n: String, s: SourceSpan) -> Node {
  Node {
    name: n, span: s, children: [], connective: none,
    params: [], return_type: none, uses: [],
    body: none, transport: none, properties: [], type_annotation: none, config: none
  }
}

// For Product/Coproduct: the name field is String? in TypeExpr.
// Safely unwrap to "" when none.
fn opt_str_or_empty(s: String?) -> String {
  match s {
    Some { value: v } => v
    _ => ""
  }
}

fn type_expr_product_to_node(pn: String?, fs: List<Field>, s: SourceSpan) -> Node {
  Node {
    name: opt_str_or_empty(s: pn), span: s,
    children: map(fs, f => field_to_node(f: f)),
    connective: Some { value: Conj },
    params: [], return_type: none, uses: [],
    body: none, transport: none, properties: [], type_annotation: none, config: none
  }
}

fn type_expr_coproduct_to_node(cn: String?, vs: List<Variant>, s: SourceSpan) -> Node {
  Node {
    name: opt_str_or_empty(s: cn), span: s,
    children: map(vs, v => variant_to_node(v: v)),
    connective: Some { value: Disj },
    params: [], return_type: none, uses: [],
    body: none, transport: none, properties: [], type_annotation: none, config: none
  }
}

fn field_to_node(f: Field) -> Node {
  let type_node = type_expr_to_node(te: f.type_expr)
  Node {
    name: f.name, span: f.span,
    children: [],
    connective: none,
    params: [], return_type: Some { value: f.type_expr }, uses: [],
    body: f.default_value, transport: none,
    properties: if f.from_key != none {
      [FieldInit { name: "from_key", value: Literal { value: LitStr { value: f.from_key.value }, span: f.span } }]
    } else { [] },
    type_annotation: if f.optional { Some { value: Optional { inner: f.type_expr, span: f.span } } } else { none },
    config: none
  }
}

fn variant_to_node(v: Variant) -> Node {
  Node {
    name: v.name, span: v.span,
    children: map(v.fields, f => field_to_node(f: f)),
    connective: if v.fields |> count > 0 { Some { value: Conj } } else { none },
    params: [], return_type: none, uses: [],
    body: none, transport: none, properties: [], type_annotation: none, config: none
  }
}

fn predicate_to_field_init(p: Predicate) -> FieldInit {
  let zero_span = SourceSpan { start: 0, end: 0 }
  match p {
    NonEmpty => FieldInit { name: "NonEmpty", value: Literal { value: LitBool { value: true }, span: zero_span } }
    Pattern { regex: r } => FieldInit { name: "Pattern", value: Literal { value: LitStr { value: r }, span: zero_span } }
    Range { min: mn, max: mx } =>
      // Encode range as two separate int literals — avoids needing int-to-string
      FieldInit { name: "Range", value: Literal { value: LitStr { value: "range" }, span: zero_span } }
    Brand { name: n } => FieldInit { name: "Brand", value: Literal { value: LitStr { value: n }, span: zero_span } }
    ContentEncoding { encoding: e } => FieldInit { name: "ContentEncoding", value: Literal { value: LitStr { value: e }, span: zero_span } }
    Format { name: n } => FieldInit { name: "Format", value: Literal { value: LitStr { value: n }, span: zero_span } }
    Domain { name: n } => FieldInit { name: "Domain", value: Literal { value: LitStr { value: n }, span: zero_span } }
  }
}

// Convert a Node (type-level) back to TypeExpr.
// This is the inverse of type_expr_to_node, used during the dual-write
// phase when consumers still expect TypeExpr.
fn node_to_type_expr_full(n: Node) -> TypeExpr {
  node_to_type_expr_by_connective(n: n, conn: n.connective)
}

fn node_to_type_expr_by_connective(n: Node, conn: Connective?) -> TypeExpr {
  if conn == none {
    node_to_type_expr_leaf(n: n)
  } else {
    match conn.value {
      Conj => node_to_type_expr_conj(n: n)
      Disj => node_to_type_expr_disj(n: n)
    }
  }
}

fn node_to_type_expr_conj(n: Node) -> TypeExpr {
  if n.name == "Refined" {
    node_to_type_expr_refined(children: n.children, span: n.span)
  } else {
    Product {
      name: if n.name != "" { Some { value: n.name } } else { none },
      fields: map(n.children, child => node_child_to_field(child: child)),
      span: n.span
    }
  }
}

fn node_to_type_expr_refined(children: List<Node>, span: SourceSpan) -> TypeExpr {
  match children |> first {
    Some { value: base_child } =>
      Refined { base: node_to_type_expr_full(n: base_child), predicates: [], span: span }
    None =>
      Named { name: "Refined", span: span }
  }
}

fn node_to_type_expr_disj(n: Node) -> TypeExpr {
  if n.name == "Optional" {
    node_to_type_expr_optional(children: n.children, span: n.span)
  } else {
    Coproduct {
      name: if n.name != "" { Some { value: n.name } } else { none },
      variants: map(n.children, child => node_child_to_variant(child: child)),
      span: n.span
    }
  }
}

fn node_to_type_expr_optional(children: List<Node>, span: SourceSpan) -> TypeExpr {
  match children |> first {
    Some { value: inner_child } =>
      Optional { inner: node_to_type_expr_full(n: inner_child), span: span }
    None =>
      Named { name: "Optional", span: span }
  }
}

fn node_to_type_expr_leaf(n: Node) -> TypeExpr {
  if n.name == "Map" && n.children |> count == 2 {
    node_to_type_expr_map(children: n.children, span: n.span)
  } else if n.children |> count == 1 {
    node_to_type_expr_container(name: n.name, children: n.children, span: n.span)
  } else if is_primitive_name(name: n.name) {
    Primitive { name: n.name, span: n.span }
  } else {
    Named { name: n.name, span: n.span }
  }
}

fn is_primitive_name(name: String) -> Bool {
  name == "String" || name == "Int" || name == "Bool" || name == "Float"
    || name == "Secret" || name == "Json" || name == "Unit" || name == "Bytes"
}

fn node_to_type_expr_map(children: List<Node>, span: SourceSpan) -> TypeExpr {
  match children |> first {
    Some { value: key_child } =>
      match skip(children, 1) |> first {
        Some { value: val_child } =>
          MapType { key: node_to_type_expr_full(n: key_child), value: node_to_type_expr_full(n: val_child), span: span }
        None => Named { name: "Map", span: span }
      }
    None => Named { name: "Map", span: span }
  }
}

fn node_to_type_expr_container(name: String, children: List<Node>, span: SourceSpan) -> TypeExpr {
  match children |> first {
    Some { value: el_child } =>
      if name == "List" {
        Container { kind: List, element: node_to_type_expr_full(n: el_child), span: span }
      } else if name == "Set" {
        Container { kind: Set, element: node_to_type_expr_full(n: el_child), span: span }
      } else if name == "NonEmptyList" {
        Container { kind: NonEmptyList, element: node_to_type_expr_full(n: el_child), span: span }
      } else if name == "NonEmptySet" {
        Container { kind: NonEmptySet, element: node_to_type_expr_full(n: el_child), span: span }
      } else {
        Named { name: name, span: span }
      }
    None => Named { name: name, span: span }
  }
}

fn node_child_to_field(child: Node) -> Field {
  let from_key = node_from_key(props: child.properties)
  let annotated_optional = node_child_optional_annotation(child: child)
  if annotated_optional != none {
    Field {
      name: child.name,
      type_expr: annotated_optional.value,
      optional: true,
      default_value: child.body,
      from_key: from_key,
      span: child.span
    }
  } else if child.return_type == none {
    Field {
      name: child.name,
      type_expr: Named { name: child.name, span: child.span },
      optional: false,
      default_value: child.body,
      from_key: from_key,
      span: child.span
    }
  } else {
    match child.return_type.value {
      Optional { inner: inner, span: _ } =>
        Field {
          name: child.name,
          type_expr: inner,
          optional: true,
          default_value: child.body,
          from_key: from_key,
          span: child.span
        }
      _ =>
        Field {
          name: child.name,
          type_expr: child.return_type.value,
          optional: false,
          default_value: child.body,
          from_key: from_key,
          span: child.span
        }
    }
  }
}

fn node_child_optional_annotation(child: Node) -> TypeExpr? {
  if child.type_annotation == none {
    none
  } else {
    match child.type_annotation.value {
      Optional { inner: inner, span: _ } => Some { value: inner }
      _ => none
    }
  }
}

fn node_from_key(props: List<FieldInit>) -> String? {
  match props |> first {
    Some { value: fi } =>
      if fi.name == "from_key" {
        match fi.value {
          Literal { value: LitStr { value: v }, span: _ } => Some { value: v }
          _ => none
        }
      } else { none }
    None => none
  }
}

fn node_child_to_variant(child: Node) -> Variant {
  Variant {
    name: child.name,
    fields: map(child.children, c => node_child_to_field(child: c)),
    span: child.span
  }
}

// =========================================================================
// Typed self-call detection — TypedExpr walkers
//
// These functions walk TypedExpr trees to detect self-recursive calls
// and non-tail self-calls. Used by the typechecker to pre-compute
// is_self_recursive and has_non_tail_self_call on TypedNode.
// =========================================================================

fn typed_expr_has_self_call(texpr: TypedExpr, fn_name: String) -> Bool {
  match texpr {
    TypedCall { func: f, args: a, resolved_type: _, span: _ } =>
      if f == fn_name { true }
      else { a |> any(na => typed_expr_has_self_call(texpr: na.value, fn_name: fn_name)) }
    TypedVar { name: _, resolved_type: _, span: _ } => false
    TypedLiteral { value: _, resolved_type: _, span: _ } => false
    TypedFieldAccess { base: b, field: _, resolved_type: _, span: _ } =>
      typed_expr_has_self_call(texpr: b, fn_name: fn_name)
    TypedMethodCall { receiver: r, method: _, args: a, resolved_type: _, span: _ } =>
      typed_expr_has_self_call(texpr: r, fn_name: fn_name)
        || a |> any(na => typed_expr_has_self_call(texpr: na.value, fn_name: fn_name))
    TypedMatch { scrutinee: s, arms: arm_list, resolved_type: _, span: _ } =>
      typed_expr_has_self_call(texpr: s, fn_name: fn_name)
        || arm_list |> any(arm => typed_expr_has_self_call(texpr: arm.body, fn_name: fn_name))
    TypedIf { condition: c, then_branch: t, else_branch: e, resolved_type: _, span: _ } =>
      typed_expr_has_self_call(texpr: c, fn_name: fn_name)
        || typed_expr_has_self_call(texpr: t, fn_name: fn_name)
        || match e {
          Some { value: eb } => typed_expr_has_self_call(texpr: eb, fn_name: fn_name)
          None => false
        }
    TypedLet { name: _, value: v, body: bd, resolved_type: _, span: _ } =>
      typed_expr_has_self_call(texpr: v, fn_name: fn_name)
        || match bd {
          Some { value: b } => typed_expr_has_self_call(texpr: b, fn_name: fn_name)
          None => false
        }
    TypedBlock { stmts: ss, resolved_type: _, span: _ } =>
      ss |> any(s => typed_expr_has_self_call(texpr: s, fn_name: fn_name))
    TypedBinOp { op: _, left: l, right: r, resolved_type: _, span: _ } =>
      typed_expr_has_self_call(texpr: l, fn_name: fn_name)
        || typed_expr_has_self_call(texpr: r, fn_name: fn_name)
    TypedUnaryOp { op: _, operand: e, resolved_type: _, span: _ } =>
      typed_expr_has_self_call(texpr: e, fn_name: fn_name)
    TypedLambda { params: _, body: bd, resolved_type: _, span: _ } =>
      typed_expr_has_self_call(texpr: bd, fn_name: fn_name)
    TypedRecordLit { type_name: _, fields: fs, resolved_type: _, span: _ } =>
      fs |> any(fi => typed_expr_has_self_call(texpr: fi.value, fn_name: fn_name))
    TypedListLit { elements: els, resolved_type: _, span: _ } =>
      els |> any(el => typed_expr_has_self_call(texpr: el, fn_name: fn_name))
    TypedStringInterp { parts: ps, resolved_type: _, span: _ } =>
      ps |> any(p => match p {
        TypedInterpolation { expr: e } => typed_expr_has_self_call(texpr: e, fn_name: fn_name)
        TypedText { value: _ } => false
      })
    TypedCast { expr: e, target: _, resolved_type: _, span: _ } =>
      typed_expr_has_self_call(texpr: e, fn_name: fn_name)
    TypedForEach { variable: _, collection: c, body: bd, resolved_type: _, span: _ } =>
      typed_expr_has_self_call(texpr: c, fn_name: fn_name)
        || typed_expr_has_self_call(texpr: bd, fn_name: fn_name)
    TypedIndex { base: b, index: i, resolved_type: _, span: _ } =>
      typed_expr_has_self_call(texpr: b, fn_name: fn_name)
        || typed_expr_has_self_call(texpr: i, fn_name: fn_name)
    TypedSlice { base: b, start: s, end: e, resolved_type: _, span: _ } =>
      typed_expr_has_self_call(texpr: b, fn_name: fn_name)
        || typed_expr_has_self_call(texpr: s, fn_name: fn_name)
        || typed_expr_has_self_call(texpr: e, fn_name: fn_name)
  }
}

fn typed_has_non_tail_self_call(texpr: TypedExpr, fn_name: String, in_tail: Bool) -> Bool {
  match texpr {
    TypedCall { func: f, args: a, resolved_type: _, span: _ } =>
      if f == fn_name {
        if in_tail == false { true }
        else { a |> any(na => typed_has_non_tail_self_call(texpr: na.value, fn_name: fn_name, in_tail: false)) }
      } else {
        a |> any(na => typed_has_non_tail_self_call(texpr: na.value, fn_name: fn_name, in_tail: false))
      }
    TypedVar { name: _, resolved_type: _, span: _ } => false
    TypedLiteral { value: _, resolved_type: _, span: _ } => false
    TypedFieldAccess { base: b, field: _, resolved_type: _, span: _ } =>
      typed_has_non_tail_self_call(texpr: b, fn_name: fn_name, in_tail: false)
    TypedMethodCall { receiver: r, method: _, args: a, resolved_type: _, span: _ } =>
      typed_has_non_tail_self_call(texpr: r, fn_name: fn_name, in_tail: false)
        || a |> any(na => typed_has_non_tail_self_call(texpr: na.value, fn_name: fn_name, in_tail: false))
    TypedIf { condition: c, then_branch: t, else_branch: e, resolved_type: _, span: _ } =>
      // Condition is never tail; branches inherit tail context.
      typed_has_non_tail_self_call(texpr: c, fn_name: fn_name, in_tail: false)
        || typed_has_non_tail_self_call(texpr: t, fn_name: fn_name, in_tail: in_tail)
        || match e {
          Some { value: eb } => typed_has_non_tail_self_call(texpr: eb, fn_name: fn_name, in_tail: in_tail)
          None => false
        }
    TypedMatch { scrutinee: s, arms: arm_list, resolved_type: _, span: _ } =>
      // Scrutinee is never tail; arm bodies inherit tail context.
      typed_has_non_tail_self_call(texpr: s, fn_name: fn_name, in_tail: false)
        || arm_list |> any(arm =>
          typed_has_non_tail_self_call(texpr: arm.body, fn_name: fn_name, in_tail: in_tail))
    TypedLet { name: _, value: v, body: bd, resolved_type: _, span: _ } =>
      // Value is never tail; body (continuation) inherits tail context.
      typed_has_non_tail_self_call(texpr: v, fn_name: fn_name, in_tail: false)
        || match bd {
          Some { value: b } => typed_has_non_tail_self_call(texpr: b, fn_name: fn_name, in_tail: in_tail)
          None => false
        }
    TypedBlock { stmts: ss, resolved_type: _, span: _ } =>
      // Only the last statement in a block is in tail position.
      if ss |> count == 0 { false }
      else {
        let init_bad = ss |> enumerate
          |> filter(p => p.first < (ss |> count) - 1)
          |> any(p => typed_has_non_tail_self_call(texpr: p.second, fn_name: fn_name, in_tail: false))
        let last_bad = match ss |> last {
          Some { value: last_expr } =>
            typed_has_non_tail_self_call(texpr: last_expr, fn_name: fn_name, in_tail: in_tail)
          None => false
        }
        init_bad || last_bad
      }
    TypedBinOp { op: _, left: l, right: r, resolved_type: _, span: _ } =>
      typed_has_non_tail_self_call(texpr: l, fn_name: fn_name, in_tail: false)
        || typed_has_non_tail_self_call(texpr: r, fn_name: fn_name, in_tail: false)
    TypedUnaryOp { op: _, operand: e, resolved_type: _, span: _ } =>
      typed_has_non_tail_self_call(texpr: e, fn_name: fn_name, in_tail: false)
    TypedLambda { params: _, body: bd, resolved_type: _, span: _ } =>
      // Lambda bodies are separate contexts — self-calls inside are non-tail.
      typed_has_non_tail_self_call(texpr: bd, fn_name: fn_name, in_tail: false)
    TypedRecordLit { type_name: _, fields: fs, resolved_type: _, span: _ } =>
      fs |> any(fi => typed_has_non_tail_self_call(texpr: fi.value, fn_name: fn_name, in_tail: false))
    TypedListLit { elements: els, resolved_type: _, span: _ } =>
      els |> any(el => typed_has_non_tail_self_call(texpr: el, fn_name: fn_name, in_tail: false))
    TypedStringInterp { parts: ps, resolved_type: _, span: _ } =>
      ps |> any(p => match p {
        TypedInterpolation { expr: e } => typed_has_non_tail_self_call(texpr: e, fn_name: fn_name, in_tail: false)
        TypedText { value: _ } => false
      })
    TypedCast { expr: e, target: _, resolved_type: _, span: _ } =>
      typed_has_non_tail_self_call(texpr: e, fn_name: fn_name, in_tail: false)
    TypedForEach { variable: _, collection: c, body: bd, resolved_type: _, span: _ } =>
      typed_has_non_tail_self_call(texpr: c, fn_name: fn_name, in_tail: false)
        || typed_has_non_tail_self_call(texpr: bd, fn_name: fn_name, in_tail: false)
    TypedIndex { base: b, index: i, resolved_type: _, span: _ } =>
      typed_has_non_tail_self_call(texpr: b, fn_name: fn_name, in_tail: false)
        || typed_has_non_tail_self_call(texpr: i, fn_name: fn_name, in_tail: false)
    TypedSlice { base: b, start: s, end: e, resolved_type: _, span: _ } =>
      typed_has_non_tail_self_call(texpr: b, fn_name: fn_name, in_tail: false)
        || typed_has_non_tail_self_call(texpr: s, fn_name: fn_name, in_tail: false)
        || typed_has_non_tail_self_call(texpr: e, fn_name: fn_name, in_tail: false)
  }
}
