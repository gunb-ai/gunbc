// v2 core types -- the compiler's domain model.
//
// Imports shared types from std.types (the same types used by all DSL
// programs). Defines compiler-specific types (tokens, AST, expressions)
// that only the compiler needs.
//
// This module describes the COMPILER's data model, not a runtime or
// interpreter. The compiler reads .dag source files and emits target-
// language source files. There is no executable DAG IR here -- the
// compiler's output is text files, not a graph to be interpreted.
//
// Dependency chain:
//   kernel primitives (String, Int, Bool, List, Map)
//     <- std.types (FilePath, NonEmptyStr, SourceSpan)
//       <- v2.std.core (Token, AST, Expr, CompileResult)
//         <- v2.compiler.* (tokenize, parse, typecheck, emit)

module v2.std.core

import std.types { FilePath, NonEmptyStr, SourceSpan }

// =========================================================================
// Tokens
//
// A token is an atomic unit of source text with a classification and
// a source location. The tokenizer produces a flat List<Token> from
// a source string.
// =========================================================================

type Token {
  kind: TokenKind
  span: SourceSpan
}

type TokenKind
  // Declaration keywords
  = KwModule | KwImport | KwType | KwFn | KwFunc
  | KwService | KwResource | KwData | KwExtern
  | KwInterface | KwPipeline | KwProfile | KwPattern
  // Control flow keywords
  | KwLet | KwReturn | KwMatch | KwIf | KwElse
  | KwFor | KwIn | KwWhere | KwWith
  // Literal keywords
  | KwTrue | KwFalse | KwNone
  // Resource lifecycle keywords
  | KwAcquire | KwRelease | KwCapability
  | KwOperation | KwInput | KwOutput
  // Modifier keywords
  | KwIdempotent | KwReadonly | KwHermetic
  // Paired delimiters
  | LBrace | RBrace | LParen | RParen | LBracket | RBracket
  // Relational / arrow
  | Lt | Gt | Le | Ge | FatArrow | Arrow
  // Separators
  | Colon | Comma | Dot | DotDot
  // Assignment / equality
  | Eq | EqEq | Ne
  // Arithmetic
  | Plus | Minus | Star | Slash | Percent
  // Logic
  | Bang | And | Or
  // Optionality
  | Question | NullCoalesce
  // Sum type separator / pipe arrow
  | Pipe
  | PipeArrow
  // Values
  | LitStr { value: String }
  | LitInt { value: Int }
  | LitFloat { value: String }
  | Ident { name: String }
  // String interpolation parts
  | StrBegin { value: String }
  | StrMid { value: String }
  | StrEnd { value: String }
  // Structure
  | Newline | Eof
  | Unknown { char: String }

// =========================================================================
// AST -- Abstract Syntax Tree
//
// The parser produces an AST from a token list. The AST is a faithful
// representation of the source structure with no semantic interpretation.
// Names are strings, types are Node values, expressions are Expr
// values. Nothing is resolved or checked yet.
//
// Every node that a diagnostic might blame carries a SourceSpan for
// precise error locality.
// =========================================================================

type Module {
  name: String
  imports: List<Import>
  items: List<Node>
  span: SourceSpan
}

type ImportNames
  = ImportAll
  | ImportSpecific { names: List<String> }

type Import {
  module_path: String
  names: ImportNames
  span: SourceSpan
}

// Connective -- the logical primitive for type structure.
// Conj = conjunction: all children hold simultaneously (record fields).
// Disj = disjunction: exactly one child holds (sum variants).
type Connective = Conj | Disj

type Field {
  name: String
  type_expr: Node
  optional: Bool
  default_value: Expr?
  from_key: String?
  span: SourceSpan
}

type Variant {
  name: String
  fields: List<Field>
  span: SourceSpan
}

type Param {
  name: String
  type_expr: Node
  default_value: Expr?
  span: SourceSpan
}

type ResourceUse {
  name: String
  resource: Node
  span: SourceSpan
}

// =========================================================================
// Expressions
// =========================================================================

type Expr
  = Literal { value: LiteralValue, resolved_type: Node?, span: SourceSpan }
  | Var { name: String, resolved_type: Node?, span: SourceSpan }
  | FieldAccess { base: Expr, field: String, resolved_type: Node?, span: SourceSpan }
  | Call { func: String, args: List<NamedArg>, resolved_type: Node?, span: SourceSpan }
  | MethodCall { receiver: Expr, method: String, args: List<NamedArg>, resolved_type: Node?, span: SourceSpan }
  | Match { scrutinee: Expr, arms: List<MatchArm>, resolved_type: Node?, span: SourceSpan }
  | If { condition: Expr, then_branch: Expr, else_branch: Expr?, resolved_type: Node?, span: SourceSpan }
  | Let { name: String, value: Expr, body: Expr?, resolved_type: Node?, span: SourceSpan }
  | RecordLit { type_name: String?, fields: List<FieldInit>, resolved_type: Node?, span: SourceSpan }
  | ListLit { elements: List<Expr>, resolved_type: Node?, span: SourceSpan }
  | BinOp { op: BinOpKind, left: Expr, right: Expr, resolved_type: Node?, span: SourceSpan }
  | UnaryOp { op: UnaryOpKind, operand: Expr, resolved_type: Node?, span: SourceSpan }
  | Lambda { params: List<String>, body: Expr, resolved_type: Node?, span: SourceSpan }
  | StringInterp { parts: List<StringPart>, resolved_type: Node?, span: SourceSpan }
  | Block { stmts: List<Expr>, resolved_type: Node?, span: SourceSpan }
  | Cast { expr: Expr, target: Node, resolved_type: Node?, span: SourceSpan }
  | ForEach { variable: String, collection: Expr, body: Expr, resolved_type: Node?, span: SourceSpan }
  | Index { base: Expr, index: Expr, resolved_type: Node?, span: SourceSpan }
  | Slice { base: Expr, start: Expr, end: Expr, resolved_type: Node?, span: SourceSpan }

type NamedArg { name: String?, value: Expr }
type MatchArm { pattern: MatchPattern, guard: Expr?, body: Expr }
type FieldInit { name: String, value: Expr }

type MatchPattern
  = Bind { name: String }
  | LitPattern { value: LiteralValue }
  | VariantPattern { name: String, field_bindings: List<FieldBinding> }
  | Wildcard

type FieldBinding {
  field_name: String
  binding: MatchPattern
}

type LiteralValue
  = LitStr { value: String }
  | LitInt { value: Int }
  | LitFloat { value: String }
  | LitBool { value: Bool }
  | LitNull

type BinOpKind
  = Add | Sub | Mul | Div | Mod
  | BinEq | BinNe | BinLt | BinGt | BinLe | BinGe
  | BinAnd | BinOr | NullCoalesce

type UnaryOpKind = Not | Neg

type StringPart
  = Text { value: String }
  | Interpolation { expr: Expr }

// =========================================================================
// Service / Transport
//
// Transport config is typed per transport kind, not a string-keyed bag.
// =========================================================================

type TransportBinding
  = RestBinding { base_url: Expr, auth: AuthConfig?, headers: List<HeaderDef> }
  | ShellBinding { argv: List<Expr>, env: List<EnvDef> }
  | FileBinding { base_path: Expr }
  | LocalBinding

type ServiceConfig {
  endpoint: Expr
  auth: Expr?
  rate_limit: Expr?
  retry: Expr?
}

type AuthConfig {
  scheme: String
  header: String
  token_expr: Expr
}

type HeaderDef { name: String, value: Expr }
type EnvDef { name: String, value: Expr }

// OperationDef: parse-intermediate type. The parser reads operations using this
// shape, then dissolves fields into Node properties and return_type.
type OperationDef {
  name: String
  inputs: List<Field>
  outputs: List<Field>
  response_props: List<FieldInit>
  mock_props: List<FieldInit>
  exit_props: List<FieldInit>
  modifier_props: List<FieldInit>
  transport: TransportBinding?
  span: SourceSpan
}

type OperationModifier = Idempotent | Readonly | Hermetic

type CapabilityDef {
  name: String
  inputs: List<Field>
  outputs: List<Field>
  span: SourceSpan
}

// =========================================================================
// Render target -- which language the emitter produces.
// =========================================================================

type RenderTarget = Rust | Python | Go

// =========================================================================
// Compiler output
//
// The compiler produces files and diagnostics. No DAG, no IR, no
// executable artifact. The emitted files ARE the output.
// =========================================================================

type CompileResult {
  files: List<TextFile>
  diagnostics: List<Diagnostic>
}

type TextFile {
  path: FilePath
  content: String
}

type Diagnostic {
  severity: Severity
  message: String
  span: SourceSpan?
  module_name: String?
}

type Severity = Error | Warning

type FuncSig {
  name: String
  params: List<Param>
  return_type: Node
  is_async: Bool
}

type FuncEnv {
  signatures: Map<String, FuncSig>
}

// =========================================================================
// Node -- unified recursive structure
//
// Everything is a node in DAG composition. Keywords (fn, type, service)
// are parse sugar that tell the parser what fields to expect. After
// parsing, everything is a Node. The checker validates edge constraints
// on node properties -- never asks "what keyword?"
//
// The type is self-referential: children: List<Node>. An operation is a
// Node with params and return_type. A capability is a Node with
// input/output ports. OperationDef and CapabilityDef dissolve into Node.
// =========================================================================

type Node {
  name: String
  span: SourceSpan
  // Fractal composition -- operations, capabilities, items are all children
  children: List<Node>
  // Logical connective -- And (record/all-hold), Or (sum/one-holds), none (leaf)
  connective: Connective?
  // Ports -- what flows in and out
  params: List<Param>
  return_type: Node?
  uses: List<ResourceUse>
  // Computation -- how it executes (none = externally provided)
  body: Expr?
  // Binding -- external execution strategy
  transport: TransportBinding?
  // Metadata
  properties: List<FieldInit>
  type_annotation: Node?
  config: ServiceConfig?
  is_self_recursive: Bool
  has_non_tail_self_call: Bool
}

// =========================================================================
// Self-call detection -- Expr walkers
//
// These functions walk Expr trees to detect self-recursive calls
// and non-tail self-calls. Used by the reconciler to compute
// is_self_recursive and has_non_tail_self_call on Node.
// =========================================================================

fn expr_has_self_call(expr: Expr, fn_name: String) -> Bool {
  match expr {
    Call { func: f, args: a, resolved_type: _, span: _ } =>
      if f == fn_name { true }
      else { a |> any(na => expr_has_self_call(expr: na.value, fn_name: fn_name)) }
    Var { name: _, resolved_type: _, span: _ } => false
    Literal { value: _, resolved_type: _, span: _ } => false
    FieldAccess { base: b, field: _, resolved_type: _, span: _ } =>
      expr_has_self_call(expr: b, fn_name: fn_name)
    MethodCall { receiver: r, method: _, args: a, resolved_type: _, span: _ } =>
      expr_has_self_call(expr: r, fn_name: fn_name)
        || a |> any(na => expr_has_self_call(expr: na.value, fn_name: fn_name))
    Match { scrutinee: s, arms: arm_list, resolved_type: _, span: _ } =>
      expr_has_self_call(expr: s, fn_name: fn_name)
        || arm_list |> any(arm => expr_has_self_call(expr: arm.body, fn_name: fn_name))
    If { condition: c, then_branch: t, else_branch: e, resolved_type: _, span: _ } =>
      expr_has_self_call(expr: c, fn_name: fn_name)
        || expr_has_self_call(expr: t, fn_name: fn_name)
        || match e {
          Some { value: eb } => expr_has_self_call(expr: eb, fn_name: fn_name)
          None => false
        }
    Let { name: _, value: v, body: bd, resolved_type: _, span: _ } =>
      expr_has_self_call(expr: v, fn_name: fn_name)
        || match bd {
          Some { value: b } => expr_has_self_call(expr: b, fn_name: fn_name)
          None => false
        }
    Block { stmts: ss, resolved_type: _, span: _ } =>
      ss |> any(s => expr_has_self_call(expr: s, fn_name: fn_name))
    BinOp { op: _, left: l, right: r, resolved_type: _, span: _ } =>
      expr_has_self_call(expr: l, fn_name: fn_name)
        || expr_has_self_call(expr: r, fn_name: fn_name)
    UnaryOp { op: _, operand: e, resolved_type: _, span: _ } =>
      expr_has_self_call(expr: e, fn_name: fn_name)
    Lambda { params: _, body: bd, resolved_type: _, span: _ } =>
      expr_has_self_call(expr: bd, fn_name: fn_name)
    RecordLit { type_name: _, fields: fs, resolved_type: _, span: _ } =>
      fs |> any(fi => expr_has_self_call(expr: fi.value, fn_name: fn_name))
    ListLit { elements: els, resolved_type: _, span: _ } =>
      els |> any(el => expr_has_self_call(expr: el, fn_name: fn_name))
    StringInterp { parts: ps, resolved_type: _, span: _ } =>
      ps |> any(p => match p {
        Interpolation { expr: e } => expr_has_self_call(expr: e, fn_name: fn_name)
        Text { value: _ } => false
      })
    Cast { expr: e, target: _, resolved_type: _, span: _ } =>
      expr_has_self_call(expr: e, fn_name: fn_name)
    ForEach { variable: _, collection: c, body: bd, resolved_type: _, span: _ } =>
      expr_has_self_call(expr: c, fn_name: fn_name)
        || expr_has_self_call(expr: bd, fn_name: fn_name)
    Index { base: b, index: i, resolved_type: _, span: _ } =>
      expr_has_self_call(expr: b, fn_name: fn_name)
        || expr_has_self_call(expr: i, fn_name: fn_name)
    Slice { base: b, start: s, end: e, resolved_type: _, span: _ } =>
      expr_has_self_call(expr: b, fn_name: fn_name)
        || expr_has_self_call(expr: s, fn_name: fn_name)
        || expr_has_self_call(expr: e, fn_name: fn_name)
  }
}

fn expr_has_non_tail_self_call(expr: Expr, fn_name: String, in_tail: Bool) -> Bool {
  match expr {
    Call { func: f, args: a, resolved_type: _, span: _ } =>
      if f == fn_name {
        if in_tail == false { true }
        else { a |> any(na => expr_has_non_tail_self_call(expr: na.value, fn_name: fn_name, in_tail: false)) }
      } else {
        a |> any(na => expr_has_non_tail_self_call(expr: na.value, fn_name: fn_name, in_tail: false))
      }
    Var { name: _, resolved_type: _, span: _ } => false
    Literal { value: _, resolved_type: _, span: _ } => false
    FieldAccess { base: b, field: _, resolved_type: _, span: _ } =>
      expr_has_non_tail_self_call(expr: b, fn_name: fn_name, in_tail: false)
    MethodCall { receiver: r, method: _, args: a, resolved_type: _, span: _ } =>
      expr_has_non_tail_self_call(expr: r, fn_name: fn_name, in_tail: false)
        || a |> any(na => expr_has_non_tail_self_call(expr: na.value, fn_name: fn_name, in_tail: false))
    If { condition: c, then_branch: t, else_branch: e, resolved_type: _, span: _ } =>
      // Condition is never tail; branches inherit tail context.
      expr_has_non_tail_self_call(expr: c, fn_name: fn_name, in_tail: false)
        || expr_has_non_tail_self_call(expr: t, fn_name: fn_name, in_tail: in_tail)
        || match e {
          Some { value: eb } => expr_has_non_tail_self_call(expr: eb, fn_name: fn_name, in_tail: in_tail)
          None => false
        }
    Match { scrutinee: s, arms: arm_list, resolved_type: _, span: _ } =>
      // Scrutinee is never tail; arm bodies inherit tail context.
      expr_has_non_tail_self_call(expr: s, fn_name: fn_name, in_tail: false)
        || arm_list |> any(arm =>
          expr_has_non_tail_self_call(expr: arm.body, fn_name: fn_name, in_tail: in_tail))
    Let { name: _, value: v, body: bd, resolved_type: _, span: _ } =>
      // Value is never tail; body (continuation) inherits tail context.
      expr_has_non_tail_self_call(expr: v, fn_name: fn_name, in_tail: false)
        || match bd {
          Some { value: b } => expr_has_non_tail_self_call(expr: b, fn_name: fn_name, in_tail: in_tail)
          None => false
        }
    Block { stmts: ss, resolved_type: _, span: _ } =>
      // Only the last statement in a block is in tail position.
      let ss_count = ss |> count
      if ss_count == 0 { false }
      else {
        let init_bad = ss |> enumerate
          |> filter(p => p.first < ss_count - 1)
          |> any(p => expr_has_non_tail_self_call(expr: p.second, fn_name: fn_name, in_tail: false))
        let last_bad = match ss |> last {
          Some { value: last_expr } =>
            expr_has_non_tail_self_call(expr: last_expr, fn_name: fn_name, in_tail: in_tail)
          None => false
        }
        init_bad || last_bad
      }
    BinOp { op: _, left: l, right: r, resolved_type: _, span: _ } =>
      expr_has_non_tail_self_call(expr: l, fn_name: fn_name, in_tail: false)
        || expr_has_non_tail_self_call(expr: r, fn_name: fn_name, in_tail: false)
    UnaryOp { op: _, operand: e, resolved_type: _, span: _ } =>
      expr_has_non_tail_self_call(expr: e, fn_name: fn_name, in_tail: false)
    Lambda { params: _, body: bd, resolved_type: _, span: _ } =>
      // Lambda bodies are separate contexts -- self-calls inside are non-tail.
      expr_has_non_tail_self_call(expr: bd, fn_name: fn_name, in_tail: false)
    RecordLit { type_name: _, fields: fs, resolved_type: _, span: _ } =>
      fs |> any(fi => expr_has_non_tail_self_call(expr: fi.value, fn_name: fn_name, in_tail: false))
    ListLit { elements: els, resolved_type: _, span: _ } =>
      els |> any(el => expr_has_non_tail_self_call(expr: el, fn_name: fn_name, in_tail: false))
    StringInterp { parts: ps, resolved_type: _, span: _ } =>
      ps |> any(p => match p {
        Interpolation { expr: e } => expr_has_non_tail_self_call(expr: e, fn_name: fn_name, in_tail: false)
        Text { value: _ } => false
      })
    Cast { expr: e, target: _, resolved_type: _, span: _ } =>
      expr_has_non_tail_self_call(expr: e, fn_name: fn_name, in_tail: false)
    ForEach { variable: _, collection: c, body: bd, resolved_type: _, span: _ } =>
      expr_has_non_tail_self_call(expr: c, fn_name: fn_name, in_tail: false)
        || expr_has_non_tail_self_call(expr: bd, fn_name: fn_name, in_tail: false)
    Index { base: b, index: i, resolved_type: _, span: _ } =>
      expr_has_non_tail_self_call(expr: b, fn_name: fn_name, in_tail: false)
        || expr_has_non_tail_self_call(expr: i, fn_name: fn_name, in_tail: false)
    Slice { base: b, start: s, end: e, resolved_type: _, span: _ } =>
      expr_has_non_tail_self_call(expr: b, fn_name: fn_name, in_tail: false)
        || expr_has_non_tail_self_call(expr: s, fn_name: fn_name, in_tail: false)
        || expr_has_non_tail_self_call(expr: e, fn_name: fn_name, in_tail: false)
  }
}
