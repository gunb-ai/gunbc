// v2 core types -- the compiler's domain model.
//
// Imports shared types from std.types (the same types used by all DSL
// programs). Defines compiler-specific types (tokens, AST, expressions)
// that only the compiler needs.
//
// This module describes the COMPILER's data model, not a runtime or
// interpreter. The compiler reads .dag source files and emits target-
// language source files. There is no executable DAG IR here -- the
// compiler's output is text files, not a graph to be interpreted.
//
// Dependency chain:
//   kernel primitives (String, Int, Bool, List, Map)
//     <- std.types (FilePath, NonEmptyStr, SourceSpan)
//       <- v2.std.core (Token, AST, ExprData, CompileResult)
//         <- v2.compiler.* (tokenize, parse, typecheck, emit)

module v2.std.core

import std.types { FilePath, NonEmptyStr, SourceSpan }

// =========================================================================
// Tokens
//
// A token is an atomic unit of source text with a classification and
// a source location. The tokenizer produces a flat List<Token> from
// a source string.
// =========================================================================

type Token {
  kind: TokenKind
  span: SourceSpan
}

type TokenKind
  // Declaration keywords
  = KwModule | KwImport | KwType | KwFn | KwFunc
  | KwService | KwResource | KwData | KwExtern
  | KwInterface | KwPipeline | KwProfile | KwPattern
  // Control flow keywords
  | KwLet | KwReturn | KwMatch | KwIf | KwElse
  | KwFor | KwIn | KwWhere | KwWith
  // Literal keywords
  | KwTrue | KwFalse | KwNone
  // Resource lifecycle keywords
  | KwAcquire | KwRelease | KwCapability
  | KwOperation | KwInput | KwOutput
  // Modifier keywords
  | KwIdempotent | KwReadonly | KwHermetic
  // Paired delimiters
  | LBrace | RBrace | LParen | RParen | LBracket | RBracket
  // Relational / arrow
  | Lt | Gt | Le | Ge | FatArrow | Arrow
  // Separators
  | Colon | Comma | Dot | DotDot
  // Assignment / equality
  | Eq | EqEq | Ne
  // Arithmetic
  | Plus | Minus | Star | Slash | Percent
  // Logic
  | Bang | And | Or
  // Optionality
  | Question | NullCoalesce
  // Sum type separator / pipe arrow
  | Pipe
  | PipeArrow
  // Values
  | LitStr { value: String }
  | LitInt { value: Int }
  | LitFloat { value: String }
  | Ident { name: String }
  // String interpolation parts
  | StrBegin { value: String }
  | StrMid { value: String }
  | StrEnd { value: String }
  // Structure
  | Newline | Eof
  | Unknown { char: String }

// =========================================================================
// AST -- Abstract Syntax Tree
//
// The parser produces an AST from a token list. The AST is a faithful
// representation of the source structure with no semantic interpretation.
// Names are strings, types are Node values, expressions are Node
// values with ExprData. Nothing is resolved or checked yet.
//
// Every node that a diagnostic might blame carries a SourceSpan for
// precise error locality.
// =========================================================================

type Module {
  name: String
  imports: List<Import>
  items: List<Node>
  span: SourceSpan
}

type ImportNames
  = ImportAll
  | ImportSpecific { names: List<String> }

type Import {
  module_path: String
  names: ImportNames
  span: SourceSpan
}

// Connective -- the logical primitive for type structure.
// Conj = conjunction: all children hold simultaneously (record fields).
// Disj = disjunction: exactly one child holds (sum variants).
type Connective = Conj | Disj

type Field {
  name: String
  type_expr: Node
  optional: Bool
  default_value: Node?
  from_key: String?
  span: SourceSpan
}

type Variant {
  name: String
  fields: List<Field>
  span: SourceSpan
}

type Param {
  name: String
  type_expr: Node
  default_value: Node?
  span: SourceSpan
}

type ResourceUse {
  name: String
  resource: Node
  span: SourceSpan
}

type FieldAccessStyle = StoredField | EnumAccessor | OptionalUnwrap | TupleFirst | TupleSecond

type FieldValueShape = PlainValue | OptionalValue

type FieldSummary {
  access_style: FieldAccessStyle
  value_shape: FieldValueShape
}

// Canonical list of kernel-provided primitive types.
// Any stage that needs to recognize kernel names imports this list
// instead of redefining its own copy.
data kernel_types: List<String> = [
  "String", "Int", "Bool", "Float",
  "Secret", "Json", "Unit", "Bytes"
]

fn is_kernel_type(name: String) -> Bool {
  kernel_types |> any(t => t == name)
}

fn is_kernel_numeric(name: String) -> Bool {
  name == "Int" || name == "Float"
}

fn is_kernel_textual(name: String) -> Bool {
  name == "String" || name == "Secret"
}

type IntrinsicMethod
  = MethodCount
  | MethodJoin
  | MethodSplit
  | MethodLast
  | MethodFirst
  | MethodEnumerate
  | MethodChars
  | MethodStringContains
  | MethodConcat
  | MethodMap
  | MethodFilter
  | MethodAny
  | MethodAll
  | MethodFlatMap
  | MethodSkip
  | MethodTake
  | MethodFold
  | MethodSortBy
  | MethodAppend

type VarBindingKind
  = LocalValueBinding
  | FunctionValueBinding
  | VariantValueBinding { parent_enum: String }

type CallSemantics
  = PlainCallSemantics
  | LookupCallSemantics

type LambdaSemantics {
  param_types: List<Node>
}

type RuntimeBridgeMethod
  = BridgeGet
  | BridgeWith
  | BridgeListPush
  | BridgeMapInsert
  | BridgeMapMerge
  | BridgeMapGet
  | BridgeMapHas
  | BridgeEmitMapHas
  | BridgeMapValues
  | BridgeMapKeys
  | BridgeMapContainsKey
  | BridgeCharAt
  | BridgeStringAt
  | BridgeStringLength
  | BridgeLength
  | BridgeStartsWith
  | BridgeEndsWith
  | BridgeToString
  | BridgeTrim
  | BridgeToLower
  | BridgeToUpper
  | BridgeReplace
  | BridgeSubstring
  | BridgeToInt
  | BridgeEmptyMap
  | BridgeContains
  | BridgeReverse
  | BridgeLookup

fn runtime_bridge_method_name(method: RuntimeBridgeMethod) -> String {
  match method {
    BridgeGet => "get"
    BridgeWith => "with"
    BridgeListPush => "list_push"
    BridgeMapInsert => "map_insert"
    BridgeMapMerge => "map_merge"
    BridgeMapGet => "map_get"
    BridgeMapHas => "map_has"
    BridgeEmitMapHas => "emit_map_has"
    BridgeMapValues => "map_values"
    BridgeMapKeys => "map_keys"
    BridgeMapContainsKey => "map_contains_key"
    BridgeCharAt => "char_at"
    BridgeStringAt => "string_at"
    BridgeStringLength => "string_length"
    BridgeLength => "length"
    BridgeStartsWith => "starts_with"
    BridgeEndsWith => "ends_with"
    BridgeToString => "to_string"
    BridgeTrim => "trim"
    BridgeToLower => "to_lower"
    BridgeToUpper => "to_upper"
    BridgeReplace => "replace"
    BridgeSubstring => "substring"
    BridgeToInt => "to_int"
    BridgeEmptyMap => "empty_map"
    BridgeContains => "contains"
    BridgeReverse => "reverse"
    BridgeLookup => "lookup"
  }
}

type MethodSemantics
  = PlainMethodSemantics
  | IntrinsicMethodSemantics { intrinsic: IntrinsicMethod, fold_accumulator_type: Node? }
  | RuntimeBridgeSemantics { method: RuntimeBridgeMethod }
  | ServiceMethodSemantics { service_name: String }

type ExprErrorKind = ParseRecoveryError | SemanticExprError | InternalExprError

type TransportKind
  = LocalTransport
  | RestTransport
  | ShellTransport
  | FileTransport
  | CustomTransport { name: String }

type ConfigPropertyKey
  = ConfigBaseUrl
  | ConfigBasePath
  | ConfigAuthScheme
  | ConfigAuthHeader
  | ConfigAuthToken
  | ConfigOther { name: String }

// =========================================================================
// Expressions
// =========================================================================

// ExprData -- expression discriminator for Node-embedded expressions.
// When a Node carries computation (expr_data != NoExprData), the Node's
// return_type and span provide the resolved type and source location.
// Sub-expressions are Node values (not Expr).
type ExprData
  = NoExprData
  | ExprLiteral { value: LiteralValue }
  | ExprError { kind: ExprErrorKind, message: String }
  | ExprVar { name: String, binding_kind: VarBindingKind? }
  | ExprFieldAccess { base: Node, field: String, summary: FieldSummary? }
  | ExprCall { func: String, args: List<NamedArg>, call_semantics: CallSemantics? }
  | ExprMethodCall { receiver: Node, method: String, args: List<NamedArg>, method_semantics: MethodSemantics? }
  | ExprMatch { scrutinee: Node, arms: List<MatchArm> }
  | ExprIf { condition: Node, then_branch: Node, else_branch: Node? }
  | ExprLet { name: String, value: Node, body: Node? }
  | ExprRecordLit { type_name: String?, fields: List<FieldInit>, parent_enum: String? }
  | ExprListLit { elements: List<Node> }
  | ExprBinOp { op: BinOpKind, left: Node, right: Node }
  | ExprUnaryOp { op: UnaryOpKind, operand: Node }
  | ExprLambda { params: List<String>, body: Node, semantics: LambdaSemantics? }
  | ExprStringInterp { parts: List<StringPart> }
  | ExprBlock { stmts: List<Node> }
  | ExprCast { expr: Node, target: Node }
  | ExprForEach { variable: String, collection: Node, body: Node }
  | ExprIndex { base: Node, index: Node }
  | ExprSlice { base: Node, start: Node, end: Node }
  | ExprReturn { value: Node }

type NamedArg { name: String?, value: Node }
type MatchArm { pattern: MatchPattern, guard: Node?, body: Node }
type FieldInit { name: String, value: Node }

type MatchPattern
  = Bind { name: String }
  | LitPattern { value: LiteralValue }
  | VariantPattern { name: String, parent_enum: String?, field_bindings: List<FieldBinding> }
  | Wildcard

type FieldBinding {
  field_name: String
  binding: MatchPattern
}

type LiteralValue
  = LitStr { value: String }
  | LitInt { value: Int }
  | LitFloat { value: String }
  | LitBool { value: Bool }
  | LitNull

type BinOpKind
  = Add | Sub | Mul | Div | Mod
  | BinEq | BinNe | BinLt | BinGt | BinLe | BinGe
  | BinAnd | BinOr | NullCoalesce

type UnaryOpKind = Not | Neg

type StringPart
  = Text { value: String }
  | Interpolation { expr: Node }

// =========================================================================
// Service config
// =========================================================================

type ServiceConfig {
  endpoint: Node
  auth: Node?
  rate_limit: Node?
  retry: Node?
}

// OperationDef: parse-intermediate type. The parser reads operations using this
// shape, then dissolves fields into Node properties and return_type.
type OperationDef {
  name: String
  inputs: List<Field>
  outputs: List<Field>
  response_props: List<FieldInit>
  mock_props: List<FieldInit>
  exit_props: List<FieldInit>
  modifier_props: List<FieldInit>
  transport: Node?
  span: SourceSpan
}

type OperationModifier = Idempotent | Readonly | Hermetic

type CapabilityDef {
  name: String
  inputs: List<Field>
  outputs: List<Field>
  span: SourceSpan
}

// =========================================================================
// Compiler output
//
// The compiler produces files and diagnostics. No DAG, no IR, no
// executable artifact. The emitted files ARE the output.
// =========================================================================

type CompileResult {
  files: List<TextFile>
  diagnostics: List<Diagnostic>
}

type TextFile {
  path: FilePath
  content: String
}

type ErrorCategory
  = UnresolvedName
  | TypeMismatch
  | FieldNotFound
  | VariantNotFound
  | AmbiguousCall
  | InvalidOperation
  | CascadeError

type Diagnostic {
  severity: Severity
  message: String
  span: SourceSpan?
  module_name: String?
  category: ErrorCategory?
}

type Severity = Error | Warning

type DeclaredFuncSig {
  name: String
  params: List<Param>
  return_type: Node?
  is_async: Bool
}

type DeclaredFuncEnv {
  signatures: Map<String, DeclaredFuncSig>
}

// =========================================================================
// Node -- unified recursive structure
//
// Everything is a node in DAG composition. Keywords (fn, type, service)
// are parse sugar that tell the parser what fields to expect. After
// parsing, everything is a Node. The checker validates edge constraints
// on node properties -- never asks "what keyword?"
//
// The type is self-referential: children: List<Node>. An operation is a
// Node with params and return_type. A capability is a Node with
// input/output ports. OperationDef and CapabilityDef dissolve into Node.
// =========================================================================

type Node {
  name: String
  span: SourceSpan
  // Fractal composition -- operations, capabilities, items are all children
  children: List<Node>
  // Logical connective -- And (record/all-hold), Or (sum/one-holds), none (leaf)
  connective: Connective?
  // Ports -- what flows in and out
  params: List<Param>
  return_type: Node?
  uses: List<ResourceUse>
  // Computation -- how it executes (none = externally provided)
  body: Node?
  // Binding -- external execution strategy
  transport: Node?
  // Metadata
  properties: List<FieldInit>
  type_annotation: Node?
  config: ServiceConfig?
  is_self_recursive: Bool
  has_non_tail_self_call: Bool
  expr_data: ExprData
}

// Construct a Node carrying expression data (the Node-embedded form).
fn make_expr_node(expr_data: ExprData, return_type: Node?, span: SourceSpan) -> Node {
  Node {
    name: "", span: span, children: [], connective: none,
    params: [], return_type: return_type, uses: [], body: none,
    transport: none, properties: [], type_annotation: none,
    config: none, is_self_recursive: false, has_non_tail_self_call: false,
    expr_data: expr_data
  }
}

fn make_expr_error_node(kind: ExprErrorKind, message: String, span: SourceSpan) -> Node {
  let error_type = Node { name: "Error", span: SourceSpan { start: 0, end: 0 }, children: [], connective: none, params: [], return_type: none, uses: [], body: none, transport: none, properties: [], type_annotation: none, config: none, is_self_recursive: false, has_non_tail_self_call: false, expr_data: NoExprData }
  make_expr_node(
    expr_data: ExprError { kind: kind, message: message },
    return_type: Some { value: error_type },
    span: span
  )
}

// =========================================================================
// Transport Node constructors
//
// Transport is a Node where name = transport kind, properties = config,
// children = ordered argv (shell only).
// =========================================================================

fn make_transport_node(name: String, properties: List<FieldInit>, children: List<Node>, span: SourceSpan) -> Node {
  Node {
    name: name, span: span, children: children, connective: none,
    params: [], return_type: none, uses: [], body: none,
    transport: none, properties: properties, type_annotation: none,
    config: none, is_self_recursive: false, has_non_tail_self_call: false,
    expr_data: NoExprData
  }
}

fn local_transport_node(span: SourceSpan) -> Node {
  make_transport_node(name: transport_kind_name(kind: LocalTransport), properties: [], children: [], span: span)
}

fn rest_transport_node(base_url: Node, auth_props: List<FieldInit>, headers: List<FieldInit>, span: SourceSpan) -> Node {
  let url_field = FieldInit { name: config_property_name(key: ConfigBaseUrl), value: base_url }
  let props = concat([url_field], auth_props, headers)
  make_transport_node(name: transport_kind_name(kind: RestTransport), properties: props, children: [], span: span)
}

fn shell_transport_node(argv: List<Node>, env: List<FieldInit>, span: SourceSpan) -> Node {
  make_transport_node(name: transport_kind_name(kind: ShellTransport), properties: env, children: argv, span: span)
}

fn file_transport_node(base_path: Node, span: SourceSpan) -> Node {
  let path_field = FieldInit { name: config_property_name(key: ConfigBasePath), value: base_path }
  make_transport_node(name: transport_kind_name(kind: FileTransport), properties: [path_field], children: [], span: span)
}

// =========================================================================
// Transport Node accessors
// =========================================================================

fn find_property(props: List<FieldInit>, prop_name: String) -> Node? {
  match props |> filter(p => p.name == prop_name) |> first() {
    Some { value: fi } => Some { value: fi.value }
    None => none
  }
}

fn find_property_string(props: List<FieldInit>, prop_name: String) -> String? {
  match find_property(props: props, prop_name: prop_name) {
    Some { value: n } => match n.expr_data {
      ExprLiteral { value: LitStr { value: s } } => Some { value: s }
      _ => none
    }
    None => none
  }
}

fn config_property_name(key: ConfigPropertyKey) -> String {
  match key {
    ConfigBaseUrl => "base_url"
    ConfigBasePath => "base_path"
    ConfigAuthScheme => "auth_scheme"
    ConfigAuthHeader => "auth_header"
    ConfigAuthToken => "auth_token"
    ConfigOther { name: name } => name
  }
}

fn config_property_key(name: String) -> ConfigPropertyKey {
  if name == "base_url" { ConfigBaseUrl }
  else if name == "base_path" { ConfigBasePath }
  else if name == "auth_scheme" { ConfigAuthScheme }
  else if name == "auth_header" { ConfigAuthHeader }
  else if name == "auth_token" { ConfigAuthToken }
  else { ConfigOther { name: name } }
}

fn transport_kind_name(kind: TransportKind) -> String {
  match kind {
    LocalTransport => "local"
    RestTransport => "rest"
    ShellTransport => "shell"
    FileTransport => "file"
    CustomTransport { name: name } => name
  }
}

fn transport_kind(t: Node) -> TransportKind {
  if t.name == "local" { LocalTransport }
  else if t.name == "rest" { RestTransport }
  else if t.name == "shell" { ShellTransport }
  else if t.name == "file" { FileTransport }
  else { CustomTransport { name: t.name } }
}

fn is_transport_kind(t: Node, kind: TransportKind) -> Bool {
  transport_kind_name(kind: transport_kind(t)) == transport_kind_name(kind: kind)
}

fn field_init_operation_modifier(field_init: FieldInit) -> OperationModifier? {
  if field_init.name == "idempotent" { Some { value: Idempotent } }
  else if field_init.name == "readonly" { Some { value: Readonly } }
  else if field_init.name == "hermetic" { Some { value: Hermetic } }
  else { none }
}

fn operation_modifier_name(modifier: OperationModifier) -> String {
  match modifier {
    Idempotent => "idempotent"
    Readonly => "readonly"
    Hermetic => "hermetic"
  }
}

fn transport_base_url(t: Node) -> Node? {
  find_property(props: t.properties, prop_name: config_property_name(key: ConfigBaseUrl))
}

fn transport_auth_token(t: Node) -> Node? {
  find_property(props: t.properties, prop_name: config_property_name(key: ConfigAuthToken))
}

fn transport_auth_header_name(t: Node) -> String? {
  find_property_string(props: t.properties, prop_name: config_property_name(key: ConfigAuthHeader))
}

fn transport_has_auth(t: Node) -> Bool {
  match find_property(props: t.properties, prop_name: config_property_name(key: ConfigAuthToken)) {
    Some { value: _ } => true
    None => false
  }
}

fn transport_headers(t: Node) -> List<FieldInit> {
  t.properties |> filter(p =>
    let key = config_property_key(name: p.name)
    key != ConfigBaseUrl
      && key != ConfigBasePath
      && key != ConfigAuthScheme
      && key != ConfigAuthHeader
      && key != ConfigAuthToken
  )
}

fn transport_env(t: Node) -> List<FieldInit> {
  t.properties
}

// =========================================================================
// Self-call detection -- Node expression walkers
//
// These functions walk Node expr_data trees to detect self-recursive calls
// and non-tail self-calls. Used by the reconciler to compute
// is_self_recursive and has_non_tail_self_call on Node.
// =========================================================================

fn expr_has_self_call(texpr: Node, fn_name: String) -> Bool {
  match texpr.expr_data {
    ExprCall { func: f, args: a, call_semantics: _ } =>
      if f == fn_name { true }
      else { a |> any(na => expr_has_self_call(texpr: na.value, fn_name: fn_name)) }
    ExprError { kind: _, message: _ } => false
    ExprVar { name: _, binding_kind: _ } => false
    ExprLiteral { value: _ } => false
    ExprFieldAccess { base: b, field: _, summary: _ } =>
      expr_has_self_call(texpr: b, fn_name: fn_name)
    ExprMethodCall { receiver: r, method: _, args: a, method_semantics: _ } =>
      expr_has_self_call(texpr: r, fn_name: fn_name)
        || a |> any(na => expr_has_self_call(texpr: na.value, fn_name: fn_name))
    ExprMatch { scrutinee: s, arms: arm_list } =>
      expr_has_self_call(texpr: s, fn_name: fn_name)
        || arm_list |> any(arm => expr_has_self_call(texpr: arm.body, fn_name: fn_name))
    ExprIf { condition: c, then_branch: t, else_branch: e } =>
      expr_has_self_call(texpr: c, fn_name: fn_name)
        || expr_has_self_call(texpr: t, fn_name: fn_name)
        || match e {
          Some { value: eb } => expr_has_self_call(texpr: eb, fn_name: fn_name)
          None => false
        }
    ExprLet { name: _, value: v, body: bd } =>
      expr_has_self_call(texpr: v, fn_name: fn_name)
        || match bd {
          Some { value: b } => expr_has_self_call(texpr: b, fn_name: fn_name)
          None => false
        }
    ExprBlock { stmts: ss } =>
      ss |> any(s => expr_has_self_call(texpr: s, fn_name: fn_name))
    ExprBinOp { op: _, left: l, right: r } =>
      expr_has_self_call(texpr: l, fn_name: fn_name)
        || expr_has_self_call(texpr: r, fn_name: fn_name)
    ExprUnaryOp { op: _, operand: e } =>
      expr_has_self_call(texpr: e, fn_name: fn_name)
    ExprLambda { params: _, body: bd, semantics: _ } =>
      expr_has_self_call(texpr: bd, fn_name: fn_name)
    ExprRecordLit { type_name: _, fields: fs, parent_enum: _ } =>
      fs |> any(fi => expr_has_self_call(texpr: fi.value, fn_name: fn_name))
    ExprListLit { elements: els } =>
      els |> any(el => expr_has_self_call(texpr: el, fn_name: fn_name))
    ExprStringInterp { parts: ps } =>
      ps |> any(p => match p {
        Interpolation { expr: e } => expr_has_self_call(texpr: e, fn_name: fn_name)
        Text { value: _ } => false
      })
    ExprCast { expr: e, target: _ } =>
      expr_has_self_call(texpr: e, fn_name: fn_name)
    ExprForEach { variable: _, collection: c, body: bd } =>
      expr_has_self_call(texpr: c, fn_name: fn_name)
        || expr_has_self_call(texpr: bd, fn_name: fn_name)
    ExprIndex { base: b, index: i } =>
      expr_has_self_call(texpr: b, fn_name: fn_name)
        || expr_has_self_call(texpr: i, fn_name: fn_name)
    ExprSlice { base: b, start: s, end: e } =>
      expr_has_self_call(texpr: b, fn_name: fn_name)
        || expr_has_self_call(texpr: s, fn_name: fn_name)
        || expr_has_self_call(texpr: e, fn_name: fn_name)
    ExprReturn { value: v } =>
      expr_has_self_call(texpr: v, fn_name: fn_name)
    NoExprData => false
  }
}

fn expr_has_non_tail_self_call(texpr: Node, fn_name: String, in_tail: Bool) -> Bool {
  match texpr.expr_data {
    ExprCall { func: f, args: a, call_semantics: _ } =>
      if f == fn_name {
        if in_tail == false { true }
        else { a |> any(na => expr_has_non_tail_self_call(texpr: na.value, fn_name: fn_name, in_tail: false)) }
      } else {
        a |> any(na => expr_has_non_tail_self_call(texpr: na.value, fn_name: fn_name, in_tail: false))
      }
    ExprError { kind: _, message: _ } => false
    ExprVar { name: _, binding_kind: _ } => false
    ExprLiteral { value: _ } => false
    ExprFieldAccess { base: b, field: _, summary: _ } =>
      expr_has_non_tail_self_call(texpr: b, fn_name: fn_name, in_tail: false)
    ExprMethodCall { receiver: r, method: _, args: a, method_semantics: _ } =>
      expr_has_non_tail_self_call(texpr: r, fn_name: fn_name, in_tail: false)
        || a |> any(na => expr_has_non_tail_self_call(texpr: na.value, fn_name: fn_name, in_tail: false))
    ExprIf { condition: c, then_branch: t, else_branch: e } =>
      // Condition is never tail; branches inherit tail context.
      expr_has_non_tail_self_call(texpr: c, fn_name: fn_name, in_tail: false)
        || expr_has_non_tail_self_call(texpr: t, fn_name: fn_name, in_tail: in_tail)
        || match e {
          Some { value: eb } => expr_has_non_tail_self_call(texpr: eb, fn_name: fn_name, in_tail: in_tail)
          None => false
        }
    ExprMatch { scrutinee: s, arms: arm_list } =>
      // Scrutinee is never tail; arm bodies inherit tail context.
      expr_has_non_tail_self_call(texpr: s, fn_name: fn_name, in_tail: false)
        || arm_list |> any(arm =>
          expr_has_non_tail_self_call(texpr: arm.body, fn_name: fn_name, in_tail: in_tail))
    ExprLet { name: _, value: v, body: bd } =>
      // Value is never tail; body (continuation) inherits tail context.
      expr_has_non_tail_self_call(texpr: v, fn_name: fn_name, in_tail: false)
        || match bd {
          Some { value: b } => expr_has_non_tail_self_call(texpr: b, fn_name: fn_name, in_tail: in_tail)
          None => false
        }
    ExprBlock { stmts: ss } =>
      // Only the last statement in a block is in tail position.
      let ss_count = ss |> count
      if ss_count == 0 { false }
      else {
        let init_bad = ss |> enumerate
          |> filter(p => p.first < ss_count - 1)
          |> any(p => expr_has_non_tail_self_call(texpr: p.second, fn_name: fn_name, in_tail: false))
        let last_bad = match ss |> last {
          Some { value: last_expr } =>
            expr_has_non_tail_self_call(texpr: last_expr, fn_name: fn_name, in_tail: in_tail)
          None => false
        }
        init_bad || last_bad
      }
    ExprBinOp { op: _, left: l, right: r } =>
      expr_has_non_tail_self_call(texpr: l, fn_name: fn_name, in_tail: false)
        || expr_has_non_tail_self_call(texpr: r, fn_name: fn_name, in_tail: false)
    ExprUnaryOp { op: _, operand: e } =>
      expr_has_non_tail_self_call(texpr: e, fn_name: fn_name, in_tail: false)
    ExprLambda { params: _, body: bd, semantics: _ } =>
      // Lambda bodies are separate contexts -- self-calls inside are non-tail.
      expr_has_non_tail_self_call(texpr: bd, fn_name: fn_name, in_tail: false)
    ExprRecordLit { type_name: _, fields: fs, parent_enum: _ } =>
      fs |> any(fi => expr_has_non_tail_self_call(texpr: fi.value, fn_name: fn_name, in_tail: false))
    ExprListLit { elements: els } =>
      els |> any(el => expr_has_non_tail_self_call(texpr: el, fn_name: fn_name, in_tail: false))
    ExprStringInterp { parts: ps } =>
      ps |> any(p => match p {
        Interpolation { expr: e } => expr_has_non_tail_self_call(texpr: e, fn_name: fn_name, in_tail: false)
        Text { value: _ } => false
      })
    ExprCast { expr: e, target: _ } =>
      expr_has_non_tail_self_call(texpr: e, fn_name: fn_name, in_tail: false)
    ExprForEach { variable: _, collection: c, body: bd } =>
      expr_has_non_tail_self_call(texpr: c, fn_name: fn_name, in_tail: false)
        || expr_has_non_tail_self_call(texpr: bd, fn_name: fn_name, in_tail: false)
    ExprIndex { base: b, index: i } =>
      expr_has_non_tail_self_call(texpr: b, fn_name: fn_name, in_tail: false)
        || expr_has_non_tail_self_call(texpr: i, fn_name: fn_name, in_tail: false)
    ExprSlice { base: b, start: s, end: e } =>
      expr_has_non_tail_self_call(texpr: b, fn_name: fn_name, in_tail: false)
        || expr_has_non_tail_self_call(texpr: s, fn_name: fn_name, in_tail: false)
        || expr_has_non_tail_self_call(texpr: e, fn_name: fn_name, in_tail: false)
    ExprReturn { value: v } =>
      expr_has_non_tail_self_call(texpr: v, fn_name: fn_name, in_tail: false)
    NoExprData => false
  }
}

// =========================================================================
// Dissolution infrastructure -- Node-based representations of types that
// will eventually dissolve. Each type gets:
//   1. A Node constructor that encodes the type's fields as Node properties
//   2. Accessor functions that extract fields from the Node representation
//   3. A predicate that identifies nodes of this kind
//
// The migration path: producers switch to constructors, consumers switch
// to accessors, then the dedicated type definition is deleted.
// =========================================================================

// --- Diagnostic as Node ---
// A Diagnostic dissolves into a Node where:
//   name = message, properties encode severity/module_name/category,
//   span = the diagnostic's source span.

fn diagnostic_node(severity: Severity, message: String, span: SourceSpan, module_name: String?) -> Node {
  let sev_name = match severity { Error => "error"  Warning => "warning" }
  let sev_prop = FieldInit { name: "severity", value: make_expr_node(expr_data: ExprLiteral { value: LitStr { value: sev_name } }, return_type: none, span: SourceSpan { start: 0, end: 0 }) }
  let mod_prop = match module_name {
    Some { value: mn } => [FieldInit { name: "module_name", value: make_expr_node(expr_data: ExprLiteral { value: LitStr { value: mn } }, return_type: none, span: SourceSpan { start: 0, end: 0 }) }]
    None => []
  }
  Node {
    name: message, span: span, children: [], connective: none,
    params: [], return_type: none, uses: [], body: none,
    transport: none, properties: concat([sev_prop], mod_prop), type_annotation: none,
    config: none, is_self_recursive: false, has_non_tail_self_call: false,
    expr_data: NoExprData
  }
}

fn is_diagnostic_node(n: Node) -> Bool {
  n.properties |> any(p => p.name == "severity")
}

// --- Module as Node ---
// When dissolved, a Module becomes a Node where:
//   name = module name, children = item nodes, imports in properties.

fn is_module_node(n: Node) -> Bool {
  n.properties |> any(p => p.name == "is_module")
}

// --- Token as Node ---
// When dissolved, a Token becomes a Node where:
//   name = kind tag string, span = token span, properties encode payload.

fn is_token_node(n: Node) -> Bool {
  n.properties |> any(p => p.name == "is_token")
}
