// Shared helpers imported from v2.compiler.emit

fn emit_single_field_product_rust_type(field_node: Node, rc_types: Map<String, Bool>) -> String {
  if field_node.return_type == none {
    "compile_error!(\"anonymous product field missing return_type\")"
  } else {
    emit_rust_node_type(n: match rt_node(n: field_node) { Some { value: rt } => rt  None => leaf_node(name: "Unit") }, rc_types: rc_types)
  }
}

// Rust language facts (rust_reserved, rt_functions, rt_ref_map_functions)
// imported from extdeps.languages.rust.emit -- single source of truth.

// =========================================================================
// SG-9: Tail-recursive block statement emitters.
// Standalone list parameters avoid Rc refcount>1 deep clone on list_push.
// =========================================================================

// Process ALL statements in a block.
fn emit_rust_block_stmts(remaining: List<Node>, text: List<String>,
    scope: InferScope, registry: Map<String, ItemInfo>, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> BlockEmitState {
  match remaining |> first {
    None => BlockEmitState { text: text, scope: scope }
    Some { value: stmt } =>
      let line = emit_typed_expr(texpr: stmt, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
      let next_scope = scope_after_expr(texpr: stmt, scope: scope)
      emit_rust_block_stmts(remaining: remaining |> skip(1),
        text: list_push(text, line), scope: next_scope,
        registry: registry, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  }
}

// Process all but the last statement in a block.
fn emit_rust_init_block_stmts(remaining: List<Node>, text: List<String>,
    scope: InferScope, registry: Map<String, ItemInfo>, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> BlockEmitState {
  match remaining |> first {
    None => BlockEmitState { text: text, scope: scope }
    Some { value: stmt } =>
      let rest = remaining |> skip(1)
      match rest |> first {
        None => BlockEmitState { text: text, scope: scope }
        Some { value: _ } =>
          let line = emit_typed_expr(texpr: stmt, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
          let next_scope = scope_after_expr(texpr: stmt, scope: scope)
          emit_rust_init_block_stmts(remaining: rest,
            text: list_push(text, line), scope: next_scope,
            registry: registry, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
      }
  }
}

// =========================================================================
// RC1: Variant-to-enum resolution helpers
//
// Rust requires enum variants to be imported through their parent enum:
//   use crate::module::EnumName::{Variant1, Variant2};
// The .dag import lists include variant names directly. These helpers
// resolve variant names to their parent enums.
// =========================================================================

// Detect complex enum type_defs: types with at least one variant that has
// fields (connective != none on the variant child). This identifies enums
// like ExprData, MatchPattern where variant construction wrapping is needed.
// The v1 interpreter handles `!= none` on connective correctly even in
// nested lambdas. Struct fields and unit enum variants both have
// connective == none, so this only returns true for complex enums.
fn has_complex_variants(item: Node) -> Bool {
  if item.children |> count == 0 { false }
  else {
    item.children |> any(c => classify_type_structure(n: c) != TypeLeaf)
  }
}

// =========================================================================
// RC2: Rc type wrapping helpers
//
// Non-Copy types (structs, complex enums) are wrapped in Rc<T> in the
// emitted Rust code to match the DAG language's value semantics.
// Simple enums (all-unit variants) and a small exclusion list are exempt.
//
// rc_types is still derived inside the Rust emitter entry points instead of
// via a sibling helper that returns Map<String, Bool>. The bootstrap
// interpreter mis-handles empty map returns as "no outputs", which breaks
// modules with no Rc-wrapped user types.
// =========================================================================

fn type_summary_needs_rc(summary: TypeSummary) -> Bool {
  match summary.repr {
    StructRepr => true
    EnumRepr { unit_only: unit_only } => unit_only == false
  }
}

fn is_simple_disj(item: Node) -> Bool {
  // Simple enum: all variants are unit variants (no children)
  let complex = item.children |> filter(v => v.children |> count > 0)
  complex |> count == 0
}

// =========================================================================
// Entry point -- Rust target
// =========================================================================

fn emit_rust(typed: ResolvedGraph) -> EmitResult {
  let emit_info = build_emit_graph_info(modules: typed.modules)
  let vtoe = emit_info.variant_to_enum
  let rc_types = map_values(emit_info.type_summaries) |> fold(init: empty_map(), f: (acc, summary) =>
    if type_summary_needs_rc(summary: summary) {
      map_insert(acc, summary.name, true)
    } else {
      acc
    }
  )
  let registry = typed.item_registry
  let workflow_funcs = collect_workflow_funcs(modules: typed.modules, registry: registry)
  let workflow_default_diags = validate_workflow_param_defaults(workflow_funcs: workflow_funcs)
  if workflow_default_diags |> count > 0 {
    return EmitResult { files: [], diagnostics: workflow_default_diags }
  }
  let module_files = typed.modules |> map(tm => emit_module_full(typed_module: tm, registry: registry, emit_info: emit_info, vtoe: vtoe, rc_types: rc_types))
  let test_files = typed.modules
    |> map(tm => emit_test_file(typed_module: tm))
    |> filter(f => f.content != "")
  let has_services = has_service_items(typed: typed)
  let lib_file = emit_lib_rs(modules: typed.modules, has_services: has_services)
  let cargo = emit_cargo_toml(crate_name: "v2_compiled", has_services: has_services)
  let main_file = emit_main_rs(workflow_funcs: workflow_funcs, modules: typed.modules, has_services: has_services)
  let rt_file = emit_v2_rt_module()
  let dry_run_file = if has_services {
    [emit_dry_run_module()]
  } else {
    []
  }
  let files = concat([cargo, lib_file, main_file, rt_file], dry_run_file, module_files, test_files)
  EmitResult { files: files, diagnostics: [] }
}

// =========================================================================
// v2_rt runtime shim -- intrinsic function stubs
//
// The v2 emitter prefixes runtime intrinsic calls with `v2_rt::`.
// This module provides the function declarations so the emitted Rust
// crate compiles. Function bodies use todo!() since only cargo check
// is needed at this bootstrap stage; real implementations come from
// the v1 runtime shim during execution.
// =========================================================================

fn emit_v2_rt_module() -> TextFile {
  TextFile { path: "src/v2_rt.rs", content: rust_runtime_source() }
}

// =========================================================================
// lib.rs generation
// =========================================================================

fn emit_lib_rs(modules: List<TypedModule>, has_services: Bool) -> TextFile {
  let mod_decls = modules |> map(tm =>
    let raw_name = module_to_filename(name: tm.module.name)
    let mod_name = if raw_name == "main" { "main_mod" } else { raw_name }
    concat("pub mod ", mod_name, ";")
  )
  let dry_run_mod = if has_services {
    "\npub mod dry_run;"
  } else {
    ""
  }
  let content = concat("// Generated by v2 compiler -- do not edit.\n\n",
    "#![allow(unused_imports, unused_variables, unused_mut, dead_code, unreachable_patterns)]\n\n",
    mod_decls |> join(separator: "\n"), "\npub mod v2_rt;", dry_run_mod)
  TextFile { path: "src/lib.rs", content: concat(content, "\n") }
}

// =========================================================================
// Module emission
// =========================================================================

// Backwards-compatible wrapper for tests that call emit_module directly.
fn emit_module(typed_module: TypedModule, registry: Map<String, ItemInfo>) -> TextFile {
  let emit_info = build_emit_graph_info(modules: [typed_module])
  let rc_types = map_values(emit_info.type_summaries) |> fold(init: empty_map(), f: (acc, summary) =>
    if type_summary_needs_rc(summary: summary) {
      map_insert(acc, summary.name, true)
    } else {
      acc
    }
  )
  emit_module_full(typed_module: typed_module, registry: registry, emit_info: emit_info, vtoe: emit_info.variant_to_enum, rc_types: rc_types)
}

fn emit_module_full(typed_module: TypedModule, registry: Map<String, ItemInfo>, emit_info: EmitGraphInfo, vtoe: Map<String, String>, rc_types: Map<String, Bool>) -> TextFile {
  let m = typed_module.module
  // Build module-local vtoe: remap ambiguous variants based on this module's imports.
  let __all_imported = flat_map(m.imports, imp =>
    match imp.names {
      ImportSpecific { names: ns } => ns
      _ => []
    }
  )
  let __imported_enums = __all_imported |> filter(n =>
    is_enum_type_name(type_name: n, vtoe: vtoe)
  )
  let module_vtoe = fold(__all_imported, init: vtoe, f: (vtoe_acc, name) =>
    match map_get(vtoe_acc, name) {
      Some { value: current_parent } =>
        let parent_ok = __imported_enums |> any(e => e == current_parent)
        if parent_ok { vtoe_acc }
        else {
          let correct = __imported_enums |> filter(enum_name =>
            emit_map_has(m: emit_info.enum_variant_membership, key: concat(enum_name, "|", name))
          ) |> first
          match correct {
            Some { value: p } => map_insert(vtoe_acc, name, p)
            None => vtoe_acc
          }
        }
      None => vtoe_acc
    }
  )
  let scope = module_emit_scope(typed_module: typed_module)
  let prelude = emit_prelude()
  // Collect locally-defined type names so imports can skip them.
  let local_type_names = typed_module.items
    |> filter(item => classify_typed_item(item: item) == TypedItemTypeDef)
    |> map(item => item.name)
  let imports_str = emit_imports(imports: m.imports, vtoe: module_vtoe, registry: registry, local_names: local_type_names)
  let imports_section = if imports_str == "" { "" } else { concat("\n", imports_str) }
  // RC1: For enums defined in this module, add `use EnumName::*;` so
  // variant names are in scope without qualification.
  let local_enum_uses = typed_module.items
    |> filter(item => classify_typed_item(item: item) == TypedItemTypeDef && classify_type_structure(n: item) == TypeDisj)
    |> map(item => concat("use ", item.name, "::*;"))
  let local_uses_str = if local_enum_uses |> count == 0 { "" }
    else { concat("\n", local_enum_uses |> join(separator: "\n")) }
  let items_str = typed_module.items
    |> map(item => emit_typed_item(item: item, registry: registry, scope: scope, vtoe: module_vtoe, rc_types: rc_types, emit_info: emit_info))
    |> join(separator: "\n\n")
  let raw_filename = module_to_filename(name: m.name)
  // Avoid collision with the CLI entry point (src/main.rs)
  let filename = if raw_filename == "main" { "main_mod" } else { raw_filename }
  let content = concat("// Generated by v2 compiler -- do not edit.\n",
    "// Source module: ", m.name, "\n\n",
    prelude, imports_section, local_uses_str, "\n\n",
    items_str, "\n")
  TextFile { path: concat("src/", filename, ".rs"), content: content }
}

// =========================================================================
// Import emission
// =========================================================================

fn emit_imports(imports: List<Import>, vtoe: Map<String, String>, registry: Map<String, ItemInfo>, local_names: List<String>) -> String {
  if imports |> count == 0 {
    ""
  } else {
    let import_lines = imports |> map(imp =>
      let mod_name = module_to_filename(name: imp.module_path)
      match imp.names {
        ImportAll => concat("use crate::", mod_name, "::*;")
        ImportSpecific { names: specific_names } =>
          // Filter out names that are locally defined (local definition shadows import).
          let filtered_names = specific_names |> filter(n => local_names |> all(ln => ln != n))
          if filtered_names |> count == 0 {
            ""
          } else {
            // RC1: Separate top-level names from variant names.
            // Dedup first to handle NullCoalesce (variant in two enums).
            let deduped_names = unique_strings(items: filtered_names)
            // Top-level = not a variant, or is itself an enum name.
            let top_level = deduped_names |> filter(n =>
              match map_get(vtoe, n) {
                Some { value: _ } => is_enum_type_name(type_name: n, vtoe: vtoe)
                None => true
              }
            )
            // Collect unique parent enum names for variant imports.
            let all_parents = deduped_names |> map(n =>
              if is_enum_type_name(type_name: n, vtoe: vtoe) { "" }
              else {
                match map_get(vtoe, n) {
                  Some { value: parent } => parent
                  None => ""
                }
              }
            ) |> filter(p => p != "")
            let parent_list = unique_strings(items: all_parents)
            // Include parent enum names in top-level import so
            // qualified variant patterns (EnumName::Variant) work.
            let top_with_parents = unique_strings(items: concat(top_level, parent_list))
            // Emit top-level use line.
            let main_line = if top_with_parents |> count > 0 {
              let names_str = top_with_parents |> map(n =>
                match map_get(registry, n) {
                  Some { value: info } =>
                    let is_data = info.kind == DataItem
                    if is_data { to_screaming_snake(name: n) }
                    else { n }
                  None => n
                }
              ) |> join(separator: ", ")
              concat("pub use crate::", mod_name, "::{", names_str, "};")
            } else { "" }
            // Emit per-enum variant import lines for explicitly listed variants.
            let variant_lines = parent_list |> map(parent =>
              let variants = deduped_names |> filter(n =>
                if is_enum_type_name(type_name: n, vtoe: vtoe) { false }
                else {
                  match map_get(vtoe, n) {
                    Some { value: p } => p == parent
                    None => false
                  }
                }
              )
              let vars_str = variants |> join(separator: ", ")
              concat("use crate::", mod_name, "::", parent, "::{", vars_str, "};")
            )
            // RC1: For imported enum types whose variants aren't explicitly listed,
            // add wildcard imports so all variants are in scope.
            let imported_enums = top_level |> filter(n => is_enum_type_name(type_name: n, vtoe: vtoe))
            let wildcard_enum_lines = imported_enums
              |> filter(en => parent_list |> any(p => p == en) == false)
              |> map(en => concat("use crate::", mod_name, "::", en, "::*;"))
            // Combine all lines.
            let all_lines = if main_line != "" {
              concat([main_line], variant_lines |> filter(l => l != ""), wildcard_enum_lines)
            } else {
              concat(variant_lines |> filter(l => l != ""), wildcard_enum_lines)
            }
            all_lines |> join(separator: "\n")
          }
      }
    )
    import_lines |> filter(line => line != "") |> join(separator: "\n")
  }
}

// =========================================================================
// Prelude
// =========================================================================

fn emit_prelude() -> String {
  let serde_import = concat("use serde::{", "Serialize, Deserialize};")
  let imports = concat("use std::collections::BTreeMap;\nuse std::rc::Rc;\n", serde_import, "\nuse crate::v2_rt;")
  concat(imports, "\n\n", emit_non_empty_wrappers())
}

// Emit newtype wrapper definitions for NonEmptyVec and NonEmptyBTreeSet.
// These validate non-emptiness at construction time.
fn emit_non_empty_wrappers() -> String {
  let vec_wrapper = concat(
    "#[derive(Debug, Clone, PartialEq, Serialize)]\n",
    "pub struct NonEmptyVec<T>(Vec<T>);\n\n",
    "impl<T> NonEmptyVec<T> {\n",
    "    pub fn new(items: Vec<T>) -> Result<Self, &'static str> {\n",
    "        if items.is_empty() {\n",
    "            Err(\"NonEmptyVec requires at least one element\")\n",
    "        } else {\n",
    "            Ok(Self(items))\n",
    "        }\n",
    "    }\n\n",
    "    pub fn as_slice(&self) -> &[T] {\n",
    "        &self.0\n",
    "    }\n\n",
    "    pub fn into_vec(self) -> Vec<T> {\n",
    "        self.0\n",
    "    }\n",
    "}\n\n",
    "impl<'de, T> Deserialize<'de> for NonEmptyVec<T>\n",
    "where\n",
    "    T: Deserialize<'de>,\n",
    "{\n",
    "    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>\n",
    "    where\n",
    "        D: serde::Deserializer<'de>,\n",
    "    {\n",
    "        let items = Vec::<T>::deserialize(deserializer)?;\n",
    "        NonEmptyVec::new(items).map_err(serde::de::Error::custom)\n",
    "    }\n",
    "}"
  )
  let set_wrapper = concat(
    "#[derive(Debug, Clone, PartialEq, Serialize)]\n",
    "pub struct NonEmptyBTreeSet<T: Ord>(std::collections::BTreeSet<T>);\n\n",
    "impl<T: Ord> NonEmptyBTreeSet<T> {\n",
    "    pub fn new(items: std::collections::BTreeSet<T>) -> Result<Self, &'static str> {\n",
    "        if items.is_empty() {\n",
    "            Err(\"NonEmptyBTreeSet requires at least one element\")\n",
    "        } else {\n",
    "            Ok(Self(items))\n",
    "        }\n",
    "    }\n\n",
    "    pub fn as_set(&self) -> &std::collections::BTreeSet<T> {\n",
    "        &self.0\n",
    "    }\n\n",
    "    pub fn into_set(self) -> std::collections::BTreeSet<T> {\n",
    "        self.0\n",
    "    }\n",
    "}\n\n",
    "impl<'de, T> Deserialize<'de> for NonEmptyBTreeSet<T>\n",
    "where\n",
    "    T: Ord + Deserialize<'de>,\n",
    "{\n",
    "    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>\n",
    "    where\n",
    "        D: serde::Deserializer<'de>,\n",
    "    {\n",
    "        let items = std::collections::BTreeSet::<T>::deserialize(deserializer)?;\n",
    "        NonEmptyBTreeSet::new(items).map_err(serde::de::Error::custom)\n",
    "    }\n",
    "}"
  )
  concat(vec_wrapper, "\n\n", set_wrapper)
}

// =========================================================================
// Item dispatch
// =========================================================================

fn emit_typed_item(item: Node, registry: Map<String, ItemInfo>, scope: InferScope, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  let kind = classify_typed_item(item: item)
  if (kind == TypedItemTypeDef) {
    emit_type_def_from_connective(item: item, recursive_types: scope.type_env.recursive_type_set, rc_types: rc_types)
  } else if (kind == TypedItemTypeAlias) {
    concat("pub type ", item.name, " = ", emit_rust_node_type(n: match rt_node(n: item) { Some { value: rt } => rt  None => leaf_node(name: "Unit") }, rc_types: rc_types), ";")
  } else if (kind == TypedItemFunction) {
    if item.uses |> count > 0 {
      emit_func_def(name: item.name, params: item.params, return_type: match rt_node(n: item) { Some { value: rt } => rt  None => leaf_node(name: "Unit") }, uses: item.uses, body: item.body.value, registry: registry, scope: scope, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
    } else {
      emit_fn_def(name: item.name, params: item.params, return_type: match rt_node(n: item) { Some { value: rt } => rt  None => leaf_node(name: "Unit") }, body: item.body.value, registry: registry, scope: scope, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
    }
  } else if (kind == TypedItemDataDef) {
    emit_data_def(name: item.name, type_node: item.type_annotation.value, value: item.body.value, registry: registry, scope: scope, depth: 0, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  } else if (kind == TypedItemServiceDef) {
    emit_service_def(item: item, registry: registry)
  } else if (kind == TypedItemResourceDef) {
    emit_resource_def(item: item)
  } else if (kind == TypedItemExternFunc) {
    let params_str = emit_params(params: item.params, rc_types: rc_types)
    let ret_str = emit_return_type(return_type: match rt_node(n: item) { Some { value: rt } => rt  None => leaf_node(name: "Unit") }, rc_types: rc_types)
    concat("pub fn ", rust_ident(name: item.name), "(", params_str, ")", ret_str, " { todo!(\"extern func\") }")
  } else {
    concat("compile_error!(\"unhandled item: ", item.name, "\");")
  }
}

// =========================================================================
// Connective-based type emission -- dispatches on Node children
//
// Type structure is encoded as:
//   Records: connective=Conj, children = one Node per field
//   Sums:    connective=Disj, children = one Node per variant
//   Aliases: connective=none, return_type carries the aliased type
// =========================================================================

// Check if a type node references a recursive type that needs Box indirection.
// List and Map provide heap indirection naturally; Optional does not.
// RC2: Rc<T> also provides heap indirection, so skip Box for Rc-wrapped types.
fn needs_box_wrapping(n: Node, recursive_types: Map<String, Bool>, rc_types: Map<String, Bool>) -> Bool {
  if n.children |> count == 0 {
    if emit_map_has(m: rc_types, key: n.name) { false }
    else { emit_map_has(m: recursive_types, key: n.name) }
  } else if node_is_optional(n: n) {
    needs_box_wrapping(n: with_required_cardinality(n: n), recursive_types: recursive_types, rc_types: rc_types)
  } else {
    false
  }
}

fn emit_type_def_from_connective(item: Node, recursive_types: Map<String, Bool>, rc_types: Map<String, Bool>) -> String {
  let kind = classify_type_structure(n: item)
  if (kind == TypeConj) {
    emit_struct_from_children(name: item.name, children: item.children, recursive_types: recursive_types, rc_types: rc_types)
  } else {
    emit_enum_from_children(name: item.name, children: item.children, recursive_types: recursive_types, rc_types: rc_types)
  }
}

// is_type_alias_return_node is shared -- imported from v2.compiler.emit

fn emit_struct_from_children(name: String, children: List<Node>, recursive_types: Map<String, Bool>, rc_types: Map<String, Bool>) -> String {
  let derives = if emit_map_has(m: rc_types, key: name) {
    "#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]"
  } else {
    "#[derive(Debug, Clone, Copy, PartialEq, Serialize, Deserialize)]"
  }
  if children |> count == 0 {
    concat(derives, "\npub struct ", name, ";")
  } else {
    let field_lines = children |> map(child => emit_struct_field_from_child(child: child, recursive_types: recursive_types, rc_types: rc_types))
    let fields_str = field_lines |> join(separator: "\n")
    concat(derives, "\npub struct ", name, " {\n", fields_str, "\n}")
  }
}

fn emit_struct_field_from_child(child: Node, recursive_types: Map<String, Bool>, rc_types: Map<String, Bool>) -> String {
  // Struct fields use Rc-wrapped types for consistency with function signatures.
  let rt_child = match rt_node(n: child) { Some { value: rt } => rt  None => leaf_node(name: "Unit") }
  let ty = emit_rust_node_type(n: rt_child, rc_types: rc_types)
  let final_ty = if needs_box_wrapping(n: rt_child, recursive_types: recursive_types, rc_types: rc_types) {
    concat("Box<", ty, ">")
  } else { ty }
  // Check for from_key in child properties
  let rename_attr = match child.properties |> filter(p => p.name == "from_key") |> first {
    Some { value: prop } => match prop.value.expr_data {
      ExprLiteral { value: lv } => match lv {
        LitStr { value: key } => concat("    #[serde(rename = \"", key, "\")]\n")
        _ => ""
      }
      _ => ""
    }
    None => ""
  }
  concat(rename_attr, "    pub ", rust_ident(name: child.name), ": ", final_ty, ",")
}

fn enum_derives(children: List<Node>) -> String {
  let complex = children |> filter(v => v.children |> count > 0)
  match complex |> count == 0 {
    true => "#[derive(Debug, Clone, Copy, PartialEq, Serialize, Deserialize)]"
    false => "#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]"
  }
}

fn emit_enum_from_children(name: String, children: List<Node>, recursive_types: Map<String, Bool>, rc_types: Map<String, Bool>) -> String {
  let derives = enum_derives(children: children)
  let serde_tag = "#[serde(tag = \"_variant\")]"
  let variant_lines = children |> map(child => emit_variant_from_child(child: child, recursive_types: recursive_types, rc_types: rc_types))
  let variants_str = variant_lines |> join(separator: "\n")
  let enum_def = concat(derives, "\n", serde_tag, "\npub enum ", name, " {\n", variants_str, "\n}")
  // Generate accessor methods for shared fields (fields present in ALL variants).
  let accessor_impl = emit_enum_shared_accessors(name: name, children: children, recursive_types: recursive_types, rc_types: rc_types)
  if accessor_impl == "" { enum_def }
  else { concat(enum_def, "\n", accessor_impl) }
}

fn find_shared_enum_fields(children: List<Node>) -> List<String> {
  // Only consider variants with fields (skip unit variants).
  let fielded = children |> filter(child => child.children |> count > 0)
  if fielded |> count == 0 { return [] }
  // Get field names from first fielded variant.
  let first_fields = match fielded |> first {
    Some { value: v } => v.children |> map(f => f.name)
    None => []
  }
  // Keep only fields that appear in ALL fielded variants.
  first_fields |> filter(fname =>
    fielded |> all(variant =>
      variant.children |> any(f => f.name == fname)
    )
  )
}

fn emit_enum_shared_accessors(name: String, children: List<Node>, recursive_types: Map<String, Bool>, rc_types: Map<String, Bool>) -> String {
  let all_shared = find_shared_enum_fields(children: children)
  if all_shared |> count == 0 { return "" }
  // Only keep fields whose type is consistent across all fielded variants.
  let fielded = children |> filter(child => child.children |> count > 0)
  if fielded |> count == 0 { return "compile_error!(\"enum shared accessor missing fielded variant\")" }
  let first_fielded = (fielded |> first).value
  let shared = all_shared |> filter(fname =>
    let types = fielded |> map(variant =>
      match variant.children |> filter(f => f.name == fname) |> first {
        Some { value: f } => emit_rust_node_type(n: match rt_node(n: f) { Some { value: rt } => rt  None => leaf_node(name: "Unit") }, rc_types: rc_types)
        None => ""
      }
    )
    let first_type = match types |> first {
      Some { value: t } => t
      None => ""
    }
    types |> all(t => t == first_type)
  )
  if shared |> count == 0 { return "" }
  // For each shared field, generate an accessor method.
  let accessor_fns = shared |> map(fname =>
    let ty = match first_fielded.children |> filter(f => f.name == fname) |> first {
      Some { value: f } => emit_rust_node_type(n: match rt_node(n: f) { Some { value: rt } => rt  None => leaf_node(name: "Unit") }, rc_types: rc_types)
      None => "compile_error!(\"enum shared accessor missing field metadata\")"
    }
    // Generate match arms for each variant.
    let arms = children |> map(child =>
      if child.children |> count == 0 {
        concat("            ", name, "::", child.name, " => panic!(\"no ", fname, " on unit variant\"),")
      } else {
        concat("            ", name, "::", child.name, " { ", rust_ident(name: fname), ": __val, .. } => __val.clone(),")
      }
    )
    let arms_str = arms |> join(separator: "\n")
    concat("    pub fn ", rust_ident(name: fname), "(&self) -> ", ty, " {\n        match self {\n", arms_str, "\n        }\n    }")
  )
  let fns_str = accessor_fns |> join(separator: "\n")
  concat("impl ", name, " {\n", fns_str, "\n}")
}

fn emit_variant_from_child(child: Node, recursive_types: Map<String, Bool>, rc_types: Map<String, Bool>) -> String {
  if child.children |> count == 0 {
    // Unit variant -- no fields
    concat("    ", child.name, ",")
  } else {
    // Fielded variant -- child's children are the variant's fields
    let field_lines = child.children |> map(f =>
      let rt_f = match rt_node(n: f) { Some { value: rt } => rt  None => leaf_node(name: "Unit") }
      let ty = emit_rust_node_type(n: rt_f, rc_types: rc_types)
      let final_ty = if needs_box_wrapping(n: rt_f, recursive_types: recursive_types, rc_types: rc_types) {
        concat("Box<", ty, ">")
      } else { ty }
      concat("        ", rust_ident(name: f.name), ": ", final_ty, ",")
    )
    let fields_str = field_lines |> join(separator: "\n")
    concat("    ", child.name, " {\n", fields_str, "\n    },")
  }
}

// =========================================================================
// Node-based type emission
//
// These functions dispatch on Node structure (connective + name + children)
// to render Rust type syntax.
// =========================================================================

fn emit_rust_node_type(n: Node, rc_types: Map<String, Bool>) -> String {
  // Callable type: function used as a value -- emit impl Fn(ParamTypes) -> RetType.
  if n.name == "Callable" && n.params |> count > 0 {
    let param_types = n.params |> map(p => emit_rust_node_type(n: p.type_expr, rc_types: rc_types))
    let param_str = param_types |> join(separator: ", ")
    let ret_str = match n.return_type {
      Some { value: Resolved { node: rt } } => emit_rust_node_type(n: rt, rc_types: rc_types)
      _ => "()"
    }
    return concat("impl Fn(", param_str, ") -> ", ret_str)
  }
  if node_is_optional(n: n) {
    return rust_container(kind: "optional", inner: emit_rust_node_type(n: with_required_cardinality(n: n), rc_types: rc_types))
  }
  let kind = classify_type_structure(n: n)
  if (kind == TypeLeaf) {
    emit_rust_node_type_leaf(n: n, rc_types: rc_types)
  } else if (kind == TypeConj) {
    emit_rust_node_type_conj(n: n, rc_types: rc_types)
  } else {
    emit_rust_node_type_disj(n: n, rc_types: rc_types)
  }
}

fn emit_rust_node_type_leaf(n: Node, rc_types: Map<String, Bool>) -> String {
  if n.children |> count == 0 {
    let base = if n.name == "Dynamic" { "compile_error!(\"unresolved Dynamic type reached emit\")" }
      else if n.name == "Error" { "compile_error!(\"unresolved Error type reached emit\")" }
      else if n.name == "Map" { apply_type_template2(template: rust_map_template(), arg0: "_", arg1: "_") }
      else if n.name == "List" { "Vec<_>" }
      else if n.name == "Set" { "std::collections::BTreeSet<_>" }
      else { rust_primitive_type(name: n.name) }
    if emit_map_has(m: rc_types, key: n.name) {
      concat("Rc<", base, ">")
    } else {
      base
    }
  } else if node_is_map(n: n) {
    let k = match n.children |> first {
      Some { value: kn } => emit_rust_node_type(n: kn, rc_types: rc_types)
      None => "String"
    }
    let v = match skip(n.children, 1) |> first {
      Some { value: vn } => emit_rust_node_type(n: vn, rc_types: rc_types)
      None => "String"
    }
    apply_type_template2(template: rust_map_template(), arg0: k, arg1: v)
  } else if n.children |> count == 1 {
    let inner = match n.children |> first {
      Some { value: child } => emit_rust_node_type(n: child, rc_types: rc_types)
      None => "()"
    }
    if n.name == "NonEmptyList" {
      concat("NonEmptyVec<", inner, ">")
    } else if n.name == "NonEmptySet" {
      concat("NonEmptyBTreeSet<", inner, ">")
    } else {
      // "List" -> "list", "Set" -> "set" via to_snake
      rust_container(kind: to_snake(name: n.name), inner: inner)
    }
  } else {
    n.name
  }
}

fn emit_rust_node_type_conj(n: Node, rc_types: Map<String, Bool>) -> String {
  if n.name == "Refined" {
    // Refinements are erased at the Rust level -- just emit the base type.
    match n.children |> first {
      Some { value: base } => emit_rust_node_type(n: base, rc_types: rc_types)
      None => n.name
    }
  } else if n.name == "Tuple" {
    let first_str = match n.children |> first {
      Some { value: c } =>
        if c.return_type != none {
          emit_rust_node_type(n: match rt_node(n: c) { Some { value: rt } => rt  None => leaf_node(name: "Unit") }, rc_types: rc_types)
        } else {
          emit_rust_node_type(n: c, rc_types: rc_types)
        }
      None => "()"
    }
    let second_str = match skip(n.children, 1) |> first {
      Some { value: c } =>
        if c.return_type != none {
          emit_rust_node_type(n: match rt_node(n: c) { Some { value: rt } => rt  None => leaf_node(name: "Unit") }, rc_types: rc_types)
        } else {
          emit_rust_node_type(n: c, rc_types: rc_types)
        }
      None => "()"
    }
    concat("(", first_str, ", ", second_str, ")")
  } else if n.name != "" {
    if emit_map_has(m: rc_types, key: n.name) {
      concat("Rc<", n.name, ">")
    } else {
      n.name
    }
  } else {
    // Anonymous product.
    if n.children |> count == 1 {
      match n.children |> first {
        Some { value: field_node } => emit_single_field_product_rust_type(field_node: field_node, rc_types: rc_types)
        None => "compile_error!(\"anonymous product reached Node emitter\")"
      }
    } else {
      // Anonymous multi-field product → Rust tuple type.
      let field_types = n.children |> map(child =>
        if child.return_type != none {
          emit_rust_node_type(n: match rt_node(n: child) { Some { value: rt } => rt  None => leaf_node(name: "Unit") }, rc_types: rc_types)
        } else { "String" }
      )
      concat("(", field_types |> join(separator: ", "), ")")
    }
  }
}

fn emit_rust_node_type_disj(n: Node, rc_types: Map<String, Bool>) -> String {
  if n.name != "" {
    if emit_map_has(m: rc_types, key: n.name) {
      concat("Rc<", n.name, ">")
    } else {
      n.name
    }
  } else {
    "compile_error!(\"anonymous coproduct reached Node emitter\")"
  }
}

// =========================================================================
// Pure function (fn) emission
// =========================================================================

fn emit_fn_def(name: String, params: List<Param>, return_type: Node, body: Node, registry: Map<String, ItemInfo>, scope: InferScope, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  let params_str = emit_params(params: params, rc_types: rc_types)
  let ret_str = emit_return_type(return_type: return_type, rc_types: rc_types)
  let body_scope = build_params_scope(scope: scope, params: params)
  let depth = 0
  // Tail-call optimization: use cached analysis from item registry.
  let use_tco = match lookup_item(registry: registry, name: name) {
    Some { value: info } => info.is_self_recursive && info.has_non_tail_self_call == false
    None => {
      expr_has_self_call(texpr: body, fn_name: name)
        && expr_has_non_tail_self_call(texpr: body, fn_name: name, in_tail: true) == false
    }
  }
  // Stacker wrapping: recursive non-TCO functions need stack growth to avoid
  // overflow on large .dag files (e.g., 02_parse.dag at ~4000 lines).
  let is_recursive = match lookup_item(registry: registry, name: name) {
    Some { value: info } => info.is_self_recursive
    None => expr_has_self_call(texpr: body, fn_name: name)
  }
  let needs_stacker = is_recursive && use_tco == false
  if use_tco {
    let tco_params_str = emit_tco_params(params: params, rc_types: rc_types)
    let body_str = emit_typed_tco_body(texpr: body, fn_name: name, params: params, registry: registry, scope: body_scope, depth: depth + 1, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
    concat("pub fn ", rust_ident(name: name), "(", tco_params_str, ")", ret_str, " {\n",
      make_indent(level: depth + 1),body_str, "\n}")
  } else {
    emit_fn_def_non_tco(name: name, params_str: params_str, ret_str: ret_str, body: body, registry: registry, scope: body_scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info, needs_stacker: needs_stacker)
  }
}

// Emit a non-TCO function body, optionally wrapped in stacker::maybe_grow for recursive functions.
fn emit_fn_def_non_tco(name: String, params_str: String, ret_str: String, body: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo, needs_stacker: Bool) -> String {
  if needs_stacker {
    let body_str = emit_typed_expr(texpr: body, registry: registry, scope: scope, depth: depth + 2, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
    concat("pub fn ", rust_ident(name: name), "(", params_str, ")", ret_str, " {\n",
      make_indent(level: depth + 1), "stacker::maybe_grow(512 * 1024, 2 * 1024 * 1024, || {\n",
      make_indent(level: depth + 2), body_str, "\n",
      make_indent(level: depth + 1), "})\n}")
  } else {
    let body_str = emit_typed_expr(texpr: body, registry: registry, scope: scope, depth: depth + 1, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
    concat("pub fn ", rust_ident(name: name), "(", params_str, ")", ret_str, " {\n",
      make_indent(level: depth + 1), body_str, "\n}")
  }
}

// =========================================================================
// Workflow function (func) emission
// =========================================================================

fn emit_func_def(
  name: String,
  params: List<Param>,
  return_type: Node,
  uses: List<ResourceUse>,
  body: Node,
  registry: Map<String, ItemInfo>,
  scope: InferScope,
  vtoe: Map<String, String>,
  rc_types: Map<String, Bool>,
  emit_info: EmitGraphInfo
) -> String {
  let depth = 0
  let service_names = match lookup_item(registry: registry, name: name) {
    Some { value: info } => info.service_names
    None => []
  }
  let params_str = emit_func_params(params: params, uses: uses, service_names: service_names, rc_types: rc_types)
  let ret_str = emit_func_return_type(return_type: return_type, rc_types: rc_types)
  let body_scope = build_params_scope(scope: scope, params: params)
  let body_str = emit_func_body(body: body, registry: registry, scope: body_scope, depth: depth + 1, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  concat("pub async fn ", rust_ident(name: name),
    "(", params_str, ")", ret_str, " {\n",
    make_indent(level: depth + 1),body_str, "\n}")
}

// Emit a func body, wrapping the tail expression in Ok(...).
// For let-chains the leading bindings are emitted as statements,
// and only the final expression is wrapped.
fn emit_func_body(body: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  match body.expr_data {
    ExprLet { name: n, value: v, body: inner } => {
      let val_str = emit_typed_expr(texpr: v, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
      let let_line = concat("let ", rust_ident(name: n), " = ", val_str, ";")
      let next_scope = extend_scope(scope: scope, name: n, resolved: match rt_node(n: v) { Some { value: rt } => rt  None => leaf_node(name: "Unit") })
      match inner {
        Some { value: bd } =>
          concat(let_line, "\n", emit_func_body(body: bd, registry: registry, scope: next_scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info))
        None => let_line
      }
    }
    ExprBlock { stmts: ss } => {
      if ss |> count == 0 {
        "Ok(())"
      } else {
        let init_state = emit_rust_init_block_stmts(
          remaining: ss, text: [], scope: scope, registry: registry, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
        let last_stmt = ss |> last
        let last_str = match last_stmt {
          Some { value: s } => concat("Ok(", emit_typed_expr(texpr: s, registry: registry, scope: init_state.scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info), ")")
          None => "Ok(())"
        }
        if init_state.text |> count == 0 { last_str } else { concat(init_state.text |> join(separator: "\n"), "\n", last_str) }
      }
    }
    _ => concat("Ok(", emit_typed_expr(texpr: body, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info), ")")
  }
}

// =========================================================================
// Tail-Call Optimization (TCO) -- Rust rendering
//
// When a pure fn body contains self-recursive calls and every self-call
// is in tail position, we transform the emitted code from direct recursion
// to a loop+reassignment pattern:
//
//   pub fn f(mut x: T, mut y: U) -> R {
//       loop {
//           // ... original body ...
//           // tail call f(a, b) becomes:
//           //   { let __tco_0 = a; let __tco_1 = b; x = __tco_0; y = __tco_1; continue; }
//           // non-recursive return becomes: break result;
//       }
//   }
//
// Classification (expr_has_self_call, all_self_calls_are_tail) is shared
// and lives in 05_emit.dag. Only the Rust-specific rendering is here.
// =========================================================================

// Emit parameters with `mut` prefix for TCO-eligible functions.
fn emit_tco_params(params: List<Param>, rc_types: Map<String, Bool>) -> String {
  let strs = params |> map(p => emit_tco_param(param: p, rc_types: rc_types))
  strs |> join(separator: ", ")
}

fn emit_tco_param(param: Param, rc_types: Map<String, Bool>) -> String {
  let n = param.type_expr
  let ty = emit_rust_node_type(n: n, rc_types: rc_types)
  concat("mut ", rust_ident(name: param.name), ": ", ty)
}

fn emit_func_params(params: List<Param>, uses: List<ResourceUse>, service_names: List<String>, rc_types: Map<String, Bool>) -> String {
  let param_strs = params |> map(p => emit_param(param: p, rc_types: rc_types))
  let resource_strs = uses |> map(u =>
    concat(rust_ident(name: u.name), ": &", emit_rust_node_type(n: u.resource, rc_types: rc_types))
  )
  let service_strs = service_names |> map(sn =>
    concat(service_var_name(service_name: sn), ": &", sanitize_service_name(name: sn))
  )
  let all_params = concat(param_strs, resource_strs, service_strs)
  all_params |> join(separator: ", ")
}

fn emit_func_return_type(return_type: Node, rc_types: Map<String, Bool>) -> String {
  concat(" -> Result<", emit_rust_node_type(n: return_type, rc_types: rc_types), ", Box<dyn std::error::Error>>")
}

// =========================================================================
// Parameter emission
// =========================================================================

fn emit_params(params: List<Param>, rc_types: Map<String, Bool>) -> String {
  let strs = params |> map(p => emit_param(param: p, rc_types: rc_types))
  strs |> join(separator: ", ")
}

fn emit_param(param: Param, rc_types: Map<String, Bool>) -> String {
  let n = param.type_expr
  let ty = emit_rust_node_type(n: n, rc_types: rc_types)
  // All params are owned -- Rc-wrapped types are cheap to clone, and
  // the .clone() pattern in function bodies produces owned values.
  // Adding & to params creates reference/owned mismatches.
  concat(rust_ident(name: param.name), ": ", ty)
}

fn emit_return_type(return_type: Node, rc_types: Map<String, Bool>) -> String {
  concat(" -> ", emit_rust_node_type(n: return_type, rc_types: rc_types))
}

// Determine if a type should be passed by reference (Node-based).
// Primitives like i64, bool, f64, () are Copy -- pass by value.
// Everything else (String, Vec, BTreeMap, structs) -- pass by reference.
// A leaf Node with no connective and no children whose name is a
// primitive maps to a Copy type; everything else is by-reference.
fn needs_reference_node(n: Node) -> Bool {
  if classify_type_structure(n: n) != TypeLeaf || n.children |> count > 0 {
    true
  } else {
    let is_copy = is_int_type_node(n: n) || is_bool_type_node(n: n) || is_float_type_node(n: n)
      || (n.name == "Unit" && n.children |> count == 0)
    is_copy == false
  }
}

// =========================================================================
// Simple expression emission -- for transport binding / mock prop nodes
//
// Transport Node properties and mock properties
// use simple ExprData forms (not post-reconciliation expressions). These are always simple forms:
// ExprLiteral, ExprVar, ExprFieldAccess, ExprStringInterp. This function handles just
// those cases, replacing the full emit_expr tree.
// =========================================================================

fn emit_simple_expr(expr: Node) -> String {
  match expr.expr_data {
    ExprLiteral { value: v } => rust_literal(value: v)
    ExprError { kind: _, message: message } =>
      concat("compile_error!(", emit_string_literal(s: message, suffix: ""), ")")
    ExprVar { name: n, binding_kind: _ } => rust_ident(name: n)
    ExprFieldAccess { base: b, field: f, summary: _ } =>
      if is_typed_service_call_receiver(receiver: expr) {
        match extract_typed_service_name(receiver: expr) {
          Some { value: svc_name } => service_var_name(service_name: svc_name)
          None => concat(emit_simple_expr(expr: b), ".", rust_ident(name: f))
        }
      } else {
        concat(emit_simple_expr(expr: b), ".", rust_ident(name: f))
      }
    ExprStringInterp { parts: ps } =>
      emit_simple_string_interp(parts: ps)
    _ => concat("compile_error!(\"unsupported simple expr in transport binding\")")
  }
}

fn emit_simple_string_interp(parts: List<StringPart>) -> String {
  let fmt_parts = parts |> map(p => match p {
    Text { value: v } =>
      let escaped = v
        |> split(delimiter: "{") |> join(separator: "{{")
      let escaped2 = escaped
        |> split(delimiter: "}") |> join(separator: "}}")
      InterpPart { format_segment: escaped2, arg_expr: "" }
    Interpolation { expr: e } =>
      InterpPart { format_segment: "{}", arg_expr: emit_simple_expr(expr: e) }
  })
  let fmt_str = fmt_parts |> map(p => p.format_segment) |> join(separator: "")
  let args = fmt_parts
    |> map(p => p.arg_expr)
    |> filter(a => a != "")
  if args |> count == 0 {
    concat("\"", fmt_str, "\".to_string()")
  } else {
    let args_str = args |> join(separator: ", ")
    concat("format!(\"", fmt_str, "\", ", args_str, ")")
  }
}

// =========================================================================
// Pattern emission -- shared by ExprData match arms
// =========================================================================

// Check if a match pattern is a string literal.
fn is_string_lit_pattern(p: MatchPattern) -> Bool {
  match p {
    LitPattern { value: v } =>
      match v { LitStr { value: _ } => true  _ => false }
    _ => false
  }
}

// Collect guard conditions from string literal field bindings in a pattern.
// Returns "" if no string literal fields, or "f1 == \"v1\" && f2 == \"v2\"".
// This is needed because Rust can't match String fields with &str literals
// directly -- we use ref bindings + guards instead.
fn collect_pattern_string_guards(pattern: MatchPattern) -> String {
  match pattern {
    VariantPattern { name: n, parent_enum: _, field_bindings: fbs } =>
      if n == "Some" && fbs |> count == 1 {
        match fbs |> first {
          Some { value: fb } =>
            if is_string_lit_pattern(p: fb.binding) {
              match fb.binding {
                LitPattern { value: LitStr { value: s } } =>
                  concat("__some_val == ", emit_string_literal(s: s, suffix: ""))
                _ => ""
              }
            } else {
              collect_pattern_string_guards(pattern: fb.binding)
            }
          None => ""
        }
      } else {
        let str_bindings = fbs |> filter(fb => is_string_lit_pattern(p: fb.binding))
        let guards = str_bindings |> map(fb =>
          match fb.binding {
            LitPattern { value: LitStr { value: s } } =>
              concat(rust_ident(name: fb.field_name), " == ", emit_string_literal(s: s, suffix: ""))
            _ => ""
          }
        )
        guards |> join(separator: " && ")
      }
    _ => ""
  }
}

// Check if all match arms use string literal patterns (or wildcard).
// When true, the scrutinee needs .as_str() conversion for Rust matching.
fn all_arms_are_string_lit(arms: List<MatchArm>) -> Bool {
  arms |> all(arm =>
    match arm.pattern {
      LitPattern { value: v } =>
        match v { LitStr { value: _ } => true  _ => false }
      Wildcard => true
      _ => false
    }
  )
}

fn emit_pattern(pattern: MatchPattern, vtoe: Map<String, String>, rc_types: Map<String, Bool>, scrut_type: String) -> String {
  match pattern {
    Bind { name: n } => rust_ident(name: n)
    LitPattern { value: v } => rust_literal_for_pattern(value: v)
    VariantPattern { name: n, parent_enum: parent_enum, field_bindings: fbs } =>
      emit_variant_pattern(name: n, parent_enum: parent_enum, field_bindings: fbs, vtoe: vtoe, rc_types: rc_types, scrut_type: scrut_type)
    Wildcard => "_"
  }
}

fn pattern_parent_enum(name: String, parent_enum: String?, scrut_type: String, vtoe: Map<String, String>) -> String? {
  let scrut_is_known_enum = scrut_type != "" && is_enum_type_name(type_name: scrut_type, vtoe: vtoe)
  if name == "Some" || name == "None" {
    none
  } else if scrut_is_known_enum {
    Some { value: scrut_type }
  } else {
    parent_enum
  }
}

fn emit_variant_pattern(name: String, parent_enum: String?, field_bindings: List<FieldBinding>, vtoe: Map<String, String>, rc_types: Map<String, Bool>, scrut_type: String) -> String {
  // RC1: Qualify variant names with parent enum using scrutinee type.
  // Some/None are Rust builtins -- never qualify. For all others, use the
  // scrutinee type so that variant name collisions (e.g. LitStr in both
  // TokenKind and LiteralValue) are resolved correctly.
  let qualified = if name == "Some" || name == "None" { name }
    else {
      match pattern_parent_enum(name: name, parent_enum: parent_enum, scrut_type: scrut_type, vtoe: vtoe) {
        Some { value: parent } => concat(parent, "::", name)
        None => name
      }
    }
  if name == "Some" && field_bindings |> count == 1 {
    match field_bindings |> first {
      Some { value: fb } =>
        if is_string_lit_pattern(p: fb.binding) {
          "Some(ref __some_val)"
        } else {
          let inner_pat = emit_pattern(pattern: fb.binding, vtoe: vtoe, rc_types: rc_types, scrut_type: scrut_type)
          concat("Some(", inner_pat, ")")
        }
      None => qualified
    }
  } else if field_bindings |> count == 0 {
    qualified
  } else {
    let effective_bindings = field_bindings |> filter(fb =>
      match fb.binding { Wildcard => false  _ => true }
    )
    if effective_bindings |> count == 0 {
      concat(qualified, " { .. }")
    } else {
      let binding_strs = effective_bindings |> map(fb =>
        if is_string_lit_pattern(p: fb.binding) {
          concat("ref ", rust_ident(name: fb.field_name))
        } else {
            let pat_str = emit_pattern(pattern: fb.binding, vtoe: vtoe, rc_types: rc_types, scrut_type: "")
            concat(rust_ident(name: fb.field_name), ": ", pat_str)
        }
      )
      let bindings_str = binding_strs |> join(separator: ", ")
      concat(qualified, " { ", bindings_str, ", .. }")
    }
  }
}

// =========================================================================
// Rc-aware pattern matching
//
// When a variant field holds an Rc-wrapped type (e.g. ExprData::ExprLiteral.value
// is Rc<LiteralValue>), nested pattern matching fails in Rust. These helpers
// detect such fields, emit `ref field_name` in the pattern, and generate
// a let-else prelude that destructures via .as_ref().
// =========================================================================

type RcPatternAnalysis {
  matches_rc_variant: Bool
  matches_option_rc_variant: Bool
  needs_rc_pattern: Bool
  ref_bound_fields: List<String>
}

type RcMatchAnalysis {
  needs_option_deref: Bool
  needs_deref: Bool
}

fn empty_rc_pattern_analysis() -> RcPatternAnalysis {
  RcPatternAnalysis {
    matches_rc_variant: false,
    matches_option_rc_variant: false,
    needs_rc_pattern: false,
    ref_bound_fields: []
  }
}

fn field_needs_rc_ref(field_name: String, rc_analysis: RcPatternAnalysis) -> Bool {
  rc_analysis.ref_bound_fields |> any(name => name == field_name)
}

fn analyze_rc_pattern(pattern: MatchPattern, scrut_type: String, vtoe: Map<String, String>, rc_types: Map<String, Bool>) -> RcPatternAnalysis {
  match pattern {
    VariantPattern { name: n, parent_enum: parent_enum, field_bindings: fbs } =>
      // Some/None are handled by .as_deref().cloned() on the scrutinee --
      // the inner value is already unwrapped from Rc. Recurse into the
      // inner binding to check for deeper Rc-wrapped fields.
      if n == "Some" || n == "None" {
        if fbs |> count == 1 {
          match fbs |> first {
            Some { value: fb } =>
              let inner = analyze_rc_pattern(pattern: fb.binding, scrut_type: "", vtoe: vtoe, rc_types: rc_types)
              RcPatternAnalysis {
                matches_rc_variant: false,
                matches_option_rc_variant: n == "Some" && inner.matches_rc_variant,
                needs_rc_pattern: inner.needs_rc_pattern,
                ref_bound_fields: []
              }
            None => empty_rc_pattern_analysis()
          }
        } else { empty_rc_pattern_analysis() }
      } else {
        let matches_rc_variant = match pattern_parent_enum(name: n, parent_enum: parent_enum, scrut_type: scrut_type, vtoe: vtoe) {
          Some { value: enum_name } => emit_map_has(m: rc_types, key: enum_name)
          None => false
        }
        let ref_bound_fields = fbs |> flat_map(fb =>
          if analyze_rc_pattern(pattern: fb.binding, scrut_type: "", vtoe: vtoe, rc_types: rc_types).matches_rc_variant {
            [fb.field_name]
          } else { [] }
        )
        RcPatternAnalysis {
          matches_rc_variant: matches_rc_variant,
          matches_option_rc_variant: false,
          needs_rc_pattern: ref_bound_fields |> count > 0,
          ref_bound_fields: ref_bound_fields
        }
      }
    _ => empty_rc_pattern_analysis()
  }
}

fn analyze_rc_match(scrutinee: Node, arms: List<MatchArm>, scrut_type: String, vtoe: Map<String, String>, rc_types: Map<String, Bool>) -> RcMatchAnalysis {
  let arm_analyses = arms |> map(arm =>
    analyze_rc_pattern(pattern: arm.pattern, scrut_type: scrut_type, vtoe: vtoe, rc_types: rc_types)
  )
  let scrutinee_is_rc_wrapped = match scrutinee.return_type {
    Some { value: Resolved { node: rt } } =>
      if rt.children |> count == 0 && rt.name != "" {
        emit_map_has(m: rc_types, key: rt.name)
      } else { false }
    _ => false
  }
  RcMatchAnalysis {
    needs_option_deref: arm_analyses |> any(a => a.matches_option_rc_variant),
    needs_deref: scrutinee_is_rc_wrapped || arm_analyses |> any(a => a.matches_rc_variant)
  }
}

fn emit_pattern_rc_aware(pattern: MatchPattern, rc_analysis: RcPatternAnalysis, vtoe: Map<String, String>, rc_types: Map<String, Bool>, scrut_type: String) -> String {
  match pattern {
    Bind { name: n } => rust_ident(name: n)
    LitPattern { value: v } => rust_literal_for_pattern(value: v)
    VariantPattern { name: n, parent_enum: parent_enum, field_bindings: fbs } =>
      emit_variant_pattern_rc_aware(name: n, parent_enum: parent_enum, field_bindings: fbs, rc_analysis: rc_analysis, vtoe: vtoe, rc_types: rc_types, scrut_type: scrut_type)
    Wildcard => "_"
  }
}

fn emit_variant_pattern_rc_aware(name: String, parent_enum: String?, field_bindings: List<FieldBinding>, rc_analysis: RcPatternAnalysis, vtoe: Map<String, String>, rc_types: Map<String, Bool>, scrut_type: String) -> String {
  let qualified = if name == "Some" || name == "None" { name }
    else {
      match pattern_parent_enum(name: name, parent_enum: parent_enum, scrut_type: scrut_type, vtoe: vtoe) {
        Some { value: parent } => concat(parent, "::", name)
        None => name
      }
    }
  if name == "Some" && field_bindings |> count == 1 {
    match field_bindings |> first {
      Some { value: fb } =>
        if is_string_lit_pattern(p: fb.binding) {
          "Some(ref __some_val)"
        } else {
          let inner_analysis = analyze_rc_pattern(pattern: fb.binding, scrut_type: scrut_type, vtoe: vtoe, rc_types: rc_types)
          let inner_pat = emit_pattern_rc_aware(pattern: fb.binding, rc_analysis: inner_analysis, vtoe: vtoe, rc_types: rc_types, scrut_type: scrut_type)
          concat("Some(", inner_pat, ")")
        }
      None => qualified
    }
  } else if field_bindings |> count == 0 {
    qualified
  } else {
    let effective_bindings = field_bindings |> filter(fb =>
      match fb.binding { Wildcard => false  _ => true }
    )
    if effective_bindings |> count == 0 {
      concat(qualified, " { .. }")
    } else {
      let binding_strs = effective_bindings |> map(fb =>
        if is_string_lit_pattern(p: fb.binding) {
          concat("ref ", rust_ident(name: fb.field_name))
        } else {
          if field_needs_rc_ref(field_name: fb.field_name, rc_analysis: rc_analysis) {
            concat("ref ", rust_ident(name: fb.field_name))
          } else {
            let inner_analysis = analyze_rc_pattern(pattern: fb.binding, scrut_type: "", vtoe: vtoe, rc_types: rc_types)
            let pat_str = emit_pattern_rc_aware(pattern: fb.binding, rc_analysis: inner_analysis, vtoe: vtoe, rc_types: rc_types, scrut_type: "")
            concat(rust_ident(name: fb.field_name), ": ", pat_str)
          }
        }
      )
      let bindings_str = binding_strs |> join(separator: ", ")
      concat(qualified, " { ", bindings_str, ", .. }")
    }
  }
}

fn rc_pattern_preludes(pattern: MatchPattern, rc_analysis: RcPatternAnalysis, vtoe: Map<String, String>, rc_types: Map<String, Bool>) -> String {
  match pattern {
    VariantPattern { name: n, parent_enum: _, field_bindings: fbs } =>
      if n == "Some" || n == "None" {
        if fbs |> count == 1 {
          match fbs |> first {
            Some { value: fb } =>
              let inner_analysis = analyze_rc_pattern(pattern: fb.binding, scrut_type: "", vtoe: vtoe, rc_types: rc_types)
              rc_pattern_preludes(pattern: fb.binding, rc_analysis: inner_analysis, vtoe: vtoe, rc_types: rc_types)
            None => ""
          }
        } else { "" }
      } else {
        let preludes = fbs |> flat_map(fb =>
          if field_needs_rc_ref(field_name: fb.field_name, rc_analysis: rc_analysis) {
            [concat("let ", emit_pattern(pattern: fb.binding, vtoe: vtoe, rc_types: rc_types, scrut_type: ""), " = ", rust_ident(name: fb.field_name), ".as_ref() else { unreachable!() };")]
          } else { [] }
        )
        preludes |> join(separator: " ")
      }
    _ => ""
  }
}

// =========================================================================
// Record literal helpers -- shared by ExprRecordLit emission
// =========================================================================

fn explicit_record_struct_name(type_name: String?, inferred_node: Node, rc_types: Map<String, Bool>) -> String? {
  // Normalize: unwrap Refined nodes to their base
  let n = if inferred_node.name == "Refined" && (classify_type_structure(n: inferred_node) != TypeLeaf) {
    match inferred_node.children |> first {
      Some { value: base } => base
      None => inferred_node
    }
  } else { inferred_node }
  let n_kind = classify_type_structure(n: n)
  if n.name == "__EmitTypeCacheMiss" { type_name }
    else if n.name == "Error" { type_name }
    else if (n_kind == TypeConj) {
      if n.name == "" { type_name } else { Some { value: n.name } }
    } else if (n_kind == TypeDisj) {
      type_name
    } else if n.children |> count == 0 && n.name != "" {
      Some { value: n.name }
    } else {
      type_name
    }
}


// Returns true for primitive numeric types where Rust `as` is valid (Node-based).
fn is_primitive_numeric_node(n: Node) -> Bool {
  is_int_type_node(n: n) || is_float_type_node(n: n) || is_bool_type_node(n: n)
}

// =========================================================================
// Node expression emission -- reads return_type directly
//
// These functions operate on Node expr_data (the typed AST). Transport binding
// and mock property expressions (simple forms, not reconciled) use the
// emit_simple_expr helper above instead.
// =========================================================================

// RC1: Emit a Var reference. For unit variants of enums, qualify with parent
// enum name to avoid name collisions (e.g. NullCoalesce in both TokenKind and
// BinOpKind). Wrap in Rc::new() if parent enum is Rc-wrapped.
// For `none`, emit `None`.
fn variant_parent_from_binding_kind(binding_kind: VarBindingKind?) -> String? {
  match binding_kind {
    Some { value: VariantValueBinding { parent_enum: parent_enum } } => Some { value: parent_enum }
    _ => none
  }
}

fn emit_var_ref(name: String, binding_kind: VarBindingKind?, resolved_type: InferredNode?, vtoe: Map<String, String>, rc_types: Map<String, Bool>, registry: Map<String, ItemInfo>) -> String {
  if name == "none" || name == "None" { "None" }
  else if name == "true" || name == "false" { name }
  else {
    let variant_parent = variant_parent_from_binding_kind(binding_kind: binding_kind)
    let ref_str = match variant_parent {
      Some { value: enum_name } =>
        let qualified = concat(enum_name, "::", name)
        if emit_map_has(m: rc_types, key: enum_name) {
          concat("Rc::new(", qualified, ")")
        } else { qualified }
      None =>
        match map_get(registry, name) {
          Some { value: info } =>
            let is_data = info.kind == DataItem
            if is_data { concat(to_screaming_snake(name: name), ".clone()") }
            else {
              let is_function_value = match binding_kind {
                Some { value: FunctionValueBinding } => true
                _ => false
              }
              let ident = rust_ident(name: name)
              let ident_str = if is_function_value {
                ident
              } else { match resolved_type {
                Some { value: _ } => concat(ident, ".clone()")
                None => ident
              } }
              ident_str
            }
          None =>
            let ident = rust_ident(name: name)
            let ident_str = match resolved_type {
              Some { value: _ } => concat(ident, ".clone()")
              None => ident
            }
            ident_str
        }
    }
    ref_str
  }
}

// Emit a base expression for field access -- no .clone() on the outermost var
// because field access auto-borrows, and .clone() before field access both
// wastes a full struct copy and breaks Rust's type inference on match bindings.
fn emit_typed_expr_base(texpr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  match texpr.expr_data {
    ExprVar { name: n, binding_kind: binding_kind } =>
      // Emit var without .clone() for borrowing contexts.
      if n == "none" || n == "None" { "None" }
      else if n == "true" || n == "false" { n }
      else {
        let variant_parent = variant_parent_from_binding_kind(binding_kind: binding_kind)
        match variant_parent {
          Some { value: enum_name } =>
            let qualified = concat(enum_name, "::", n)
            if emit_map_has(m: rc_types, key: enum_name) {
              concat("Rc::new(", qualified, ")")
            } else { qualified }
          None =>
            match map_get(registry, n) {
              Some { value: info } =>
                let is_data = info.kind == DataItem
                if is_data { to_screaming_snake(name: n) }
                else { rust_ident(name: n) }
              None => rust_ident(name: n)
            }
        }
      }
    _ => emit_typed_expr(texpr: texpr, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  }
}

fn emit_typed_field_access(base: Node, field: String, summary: FieldSummary?, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  let base_str = emit_typed_expr_base(texpr: base, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  // Check if base type is an anonymous record — the emitter flattens these to their
  // inner type (single-field → bare type, multi-field → tuple), so field access must be
  // translated to the flattened representation.
  let base_is_anon_record = match base.return_type {
    Some { value: Resolved { node: bt } } =>
      let kind = classify_type_structure(n: bt)
      if (kind == TypeConj) && bt.name == "" { true } else { false }
    _ => false
  }
  if base_is_anon_record {
    let bt = match rt_node(n: base) { Some { value: rt } => rt  None => leaf_node(name: "Unit") }
    if bt.children |> count == 1 {
      // Single-field anonymous record: emitter unwraps to bare type, so elide field access.
      base_str
    } else {
      // Multi-field anonymous record: emitter emits tuple, convert to positional access.
      let matches = bt.children |> enumerate |> filter(pair => pair.second.name == field)
      match matches |> first {
        Some { value: m } =>
          if m.first == 0 { concat(base_str, ".0") }
          else if m.first == 1 { concat(base_str, ".1") }
          else if m.first == 2 { concat(base_str, ".2") }
          else if m.first == 3 { concat(base_str, ".3") }
          else { concat("compile_error!(\"anonymous record tuple index >= 4 for field: ", field, "\")") }
        None => concat("compile_error!(\"anonymous record field not found: ", field, "\")")
      }
    }
  } else {
    match summary {
      Some { value: field_summary } =>
        match field_summary.access_style {
          TupleFirst => concat(base_str, ".0.clone()")
          TupleSecond => concat(base_str, ".1.clone()")
          OptionalUnwrap => concat(base_str, ".clone().unwrap()")
          EnumAccessor => concat(base_str, ".", rust_ident(name: field), "()")
          StoredField => concat(base_str, ".", rust_ident(name: field), ".clone()")
        }
      // Every field access must have a summary set by reconcile.
      None => concat("compile_error!(\"field access missing reconcile summary for '", field, "'\")")
    }
  }
}

fn type_needs_rc(env: TypeEnv, type_node: Node) -> Bool {
  type_needs_rc_seen(env: env, type_node: type_node, seen: empty_map())
}

fn type_needs_rc_seen(env: TypeEnv, type_node: Node, seen: Map<String, Bool>) -> Bool {
  let normed = normalize_access_type_node(n: type_node)
  let normed_kind = classify_type_structure(n: normed)
  if (normed_kind == TypeConj) {
    true
  } else if (normed_kind == TypeDisj) {
    normed.children |> any(child => child.children |> count > 0)
  } else {
    let canonical = normed.name
    if normed.return_type != none {
      let next_seen = if canonical == "" { seen } else { map_insert(seen, canonical, true) }
      type_needs_rc_seen(env: env, type_node: match rt_node(n: normed) { Some { value: rt } => rt  None => leaf_node(name: "Unit") }, seen: next_seen)
    } else if canonical != "" && emit_map_has(m: seen, key: canonical) {
      false
    } else {
      let next_seen = if canonical == "" { seen } else { map_insert(seen, canonical, true) }
      let resolved = resolve_scrutinee_type_node(env: env, n: normed)
      if classify_type_structure(n: resolved) == TypeLeaf && resolved.return_type == none && resolved.name == normed.name && resolved.children |> count == 0 {
        false
      } else {
        type_needs_rc_seen(env: env, type_node: resolved, seen: next_seen)
      }
    }
  }
}

fn rust_map_value_type(receiver_type: Node, scope: InferScope) -> Node? {
  let resolved = resolve_scrutinee_type_node(env: scope.type_env, n: normalize_access_type_node(n: receiver_type))
  let map_type = normalize_access_type_node(n: resolved)
  if node_is_map(n: map_type) {
    match map_type.children |> skip(1) |> first {
      Some { value: value_type } => Some { value: value_type }
      None => none
    }
  } else {
    none
  }
}

fn rust_lookup_receiver_needs_rc_wrap(receiver: Node, scope: InferScope) -> Bool {
  let is_data_binding = match receiver.expr_data {
    ExprVar { name: binding_name, binding_kind: _ } =>
      match map_get(scope.item_registry, binding_name) {
        Some { value: info } => info.kind == DataItem
        None => false
      }
    _ => false
  }
  if is_data_binding == false {
    return false
  }
  match receiver.return_type {
    Some { value: Resolved { node: receiver_type } } =>
      match rust_map_value_type(receiver_type: receiver_type, scope: scope) {
        Some { value: value_type } => type_needs_rc(env: scope.type_env, type_node: value_type)
        None => false
      }
    _ => false
  }
}

fn rust_runtime_bridge_passes_receiver_by_ref(function_name: String) -> Bool {
  map_contains_key(rt_ref_map_functions, function_name)
}

fn rust_runtime_bridge_wraps_result_in_rc(function_name: String, receiver: Node, scope: InferScope) -> Bool {
  function_name == "map_get" && rust_lookup_receiver_needs_rc_wrap(receiver: receiver, scope: scope)
}

fn emit_typed_expr(texpr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  match texpr.expr_data {
    ExprLiteral { value: v } => rust_literal(value: v)
    ExprError { kind: _, message: message } =>
      concat("compile_error!(", emit_string_literal(s: message, suffix: ""), ")")
    ExprVar { name: n, binding_kind: binding_kind } =>
      emit_var_ref(name: n, binding_kind: binding_kind, resolved_type: texpr.return_type, vtoe: vtoe, rc_types: rc_types, registry: registry)
    ExprFieldAccess { base: b, field: f, summary: summary } =>
      if is_typed_service_call_receiver(receiver: texpr) {
        match extract_typed_service_name(receiver: texpr) {
          Some { value: svc_name } => service_var_name(service_name: svc_name)
          None => emit_typed_field_access(base: b, field: f, summary: summary, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
        }
      } else {
        emit_typed_field_access(base: b, field: f, summary: summary, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
      }
    ExprCall { func: f, args: a, call_semantics: call_semantics } =>
      let call_str = emit_typed_call(func: f, args: a, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
      let fallback_lookup_wrap = if f == "lookup" {
        let base_check = match a |> first {
          Some { value: receiver_arg } => rust_lookup_receiver_needs_rc_wrap(receiver: receiver_arg.value, scope: scope)
          None => false
        }
        if base_check { true }
        else {
          match texpr.return_type {
            Some { value: Resolved { node: ret_type } } =>
              let resolved_ret = resolve_scrutinee_type_node(env: scope.type_env, n: ret_type)
              if node_is_optional(n: resolved_ret) {
                type_needs_rc(env: scope.type_env, type_node: with_required_cardinality(n: resolved_ret))
              } else { false }
            _ => false
          }
        }
      } else {
        false
      }
      if fallback_lookup_wrap { concat(call_str, ".map(Rc::new)") } else { call_str }
    ExprMethodCall { receiver: r, method: m, args: a, method_semantics: method_semantics } =>
      emit_typed_method_call(receiver: r, method: m, args: a, method_semantics: method_semantics, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
    ExprMatch { scrutinee: s, arms: arm_list } =>
      emit_typed_match(scrutinee: s, arms: arm_list, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
    ExprIf { condition: c, then_branch: t, else_branch: e } =>
      emit_typed_if(condition: c, then_branch: t, else_branch: e, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
    ExprLet { name: n, value: v, body: bd } =>
      emit_typed_let(name: n, value: v, body: bd, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
    ExprRecordLit { type_name: tn, fields: fs, parent_enum: parent_enum } =>
      emit_typed_record_lit(type_name: tn, fields: fs, parent_enum: parent_enum, resolved_type: match rt_node(n: texpr) { Some { value: rt } => rt  None => leaf_node(name: "Unit") }, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
    ExprListLit { elements: els } =>
      emit_typed_list_lit(elements: els, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
    ExprBinOp { op: o, left: l, right: r } =>
      emit_typed_bin_op(op: o, left: l, right: r, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
    ExprUnaryOp { op: o, operand: e } =>
      emit_typed_unary_op(op: o, operand: e, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
    ExprLambda { params: ps, body: bd, semantics: _ } =>
      emit_typed_lambda(params: ps, body: bd, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
    ExprStringInterp { parts: ps } =>
      emit_typed_string_interp(parts: ps, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
    ExprBlock { stmts: ss } =>
      emit_typed_block(stmts: ss, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
    ExprCast { expr: e, target: t } =>
      emit_typed_cast(expr: e, target: t, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
    ExprForEach { variable: v, collection: c, body: bd } =>
      emit_typed_for_each(variable: v, collection: c, body: bd, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
    ExprIndex { base: b, index: i } =>
      emit_typed_index(base: b, index: i, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
    ExprSlice { base: b, start: s, end: e } =>
      emit_typed_slice(base: b, start: s, end: e, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
    ExprReturn { value: v } =>
      concat("return ", emit_typed_expr(texpr: v, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info))
    NoExprData => ""
  }
}

// Clone Var/FieldAccess arguments to prevent move issues in closures.
// Literals and call results are already owned, no clone needed.
fn emit_cloned_arg(texpr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  // emit_var_ref already adds .clone() to variable references.
  emit_typed_expr(texpr: texpr, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
}

// Check if a type name is an enum (appears as a value in the vtoe map).
fn is_enum_type_name(type_name: String, vtoe: Map<String, String>) -> Bool {
  map_values(vtoe) |> any(v => v == type_name)
}

fn is_map_typed_expr(texpr: Node) -> Bool {
  match texpr.return_type {
    Some { value: Resolved { node: n } } => node_is_map(n: n)
    _ => false
  }
}

fn emit_typed_call(func: String, args: List<NamedArg>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  // Built-in: get(list, index) -> list[index as usize].clone()
  if func == "get" {
    let get_args = order_typed_call_args(args: args, func: func, scope: scope)
    match get_args |> first {
      Some { value: list_arg } =>
        match get_args |> skip(1) |> first {
          Some { value: idx_arg } =>
            let list_str = emit_typed_expr(texpr: list_arg.value, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
            let index_str = emit_typed_expr(texpr: idx_arg.value, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
            return concat(list_str, ".get((", index_str, ") as usize).cloned()")
          None => return "compile_error!(\"get call missing index argument\")"
        }
      None => return "compile_error!(\"get call missing list argument\")"
    }
  }
  // Built-in: with(struct, { field: value }) -> StructName { field: value, ..struct.clone() }
  if func == "with" {
    let with_args = order_typed_call_args(args: args, func: func, scope: scope)
    if with_args |> count == 0 { return "compile_error!(\"with call missing base record\")" }
    let base_arg = (with_args |> first).value.value
    if with_args |> count < 2 { return "compile_error!(\"with call missing update record\")" }
    let update_arg = (with_args |> skip(1) |> first).value.value
    let base_str = emit_typed_expr(texpr: base_arg, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
    // Get the struct type name from the base argument's return_type.
    let type_name = if base_arg.return_type != none {
      match rt_node(n: base_arg) { Some { value: rt } => rt.name  None => "" }
    } else {
      "compile_error!(\"with call missing resolved record type\")"
    }
    // Extract field inits from the update argument (ExprRecordLit).
    let field_strs = match update_arg.expr_data {
      ExprRecordLit { fields: fs, type_name: _, parent_enum: _ } =>
        fs |> map(f => concat(rust_ident(name: f.name), ": ", emit_typed_expr(texpr: f.value, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)))
      _ => [emit_typed_expr(texpr: update_arg, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)]
    }
    let fields_str = field_strs |> join(separator: ", ")
    let needs_rc = emit_map_has(m: rc_types, key: type_name)
    let spread = if needs_rc { concat("(*", base_str, ").clone()") } else { concat(base_str, ".clone()") }
    let raw = concat(type_name, " { ", fields_str, ", ..", spread, " }")
    if needs_rc { return concat("Rc::new(", raw, ")") }
    else { return raw }
  }
  // For collection functions (map, filter, flat_map, fold), extend scope with the
  // lambda parameter bound to the collection element type. This enables Optional
  // detection inside lambda bodies where resolved_type is None.
  let collection_scope = if func == "map" || func == "filter" || func == "flat_map" || func == "fold" {
    let call_args = order_typed_call_args(args: args, func: func, scope: scope)
    match call_args |> last {
      Some { value: a } =>
        match a.value.expr_data {
          ExprLambda { params: lps, body: _, semantics: semantics } =>
            lambda_scope_from_semantics(scope: scope, params: lps, semantics: semantics)
          _ => scope
        }
      None => scope
    }
  } else { scope }
  let ordered_args = order_typed_call_args(args: args, func: func, scope: collection_scope)
  let is_rt = map_contains_key(rt_functions, func)
  // Runtime functions that take &BTreeMap (read-only map access).
  let is_rt_ref_map = map_contains_key(rt_ref_map_functions, func)
  // For runtime calls with &BTreeMap params, the first argument is always the map.
  // Pass it by reference (&) instead of by value.
  let arg_strs = ordered_args |> enumerate |> map(pair =>
    let idx = pair.first
    let a = pair.second
    if is_rt_ref_map && idx == 0 {
      let base = emit_typed_expr_base(texpr: a.value, registry: registry, scope: collection_scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
      concat("&", base)
    } else {
      emit_cloned_arg(texpr: a.value, registry: registry, scope: collection_scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
    }
  )
  let callee = lookup_item(registry: registry, name: func)
  let extra_args = match callee {
    Some { value: info } =>
      let is_func = info.kind == FuncItem
      if is_func {
        info.service_names |> map(sn => service_var_name(service_name: sn))
      } else { [] }
    None => []
  }
  let all_args = concat(arg_strs, extra_args)
  let args_str = all_args |> join(separator: ", ")
  let func_name = if is_rt { concat("v2_rt::", rust_ident(name: func)) }
    else { rust_ident(name: func) }
  // Special case: concat is variadic in DAG but binary in Rust.
  // Nest multi-arg concat calls: concat(a, b, c) becomes v2_rt::concat(v2_rt::concat(a, b), c)
  let call_str = if is_rt && func == "concat" && all_args |> count > 2 {
    emit_nested_rt_concat(remaining: all_args, acc: "", rc_types: rc_types)
  } else {
    concat(func_name, "(", args_str, ")")
  }
  match callee {
    Some { value: info } =>
      let is_func = info.kind == FuncItem
      if is_func { concat(call_str, ".await?") } else { call_str }
    None => call_str
  }
}

// Left-fold helper for nesting binary concat calls.
// concat(a, b, c) becomes v2_rt::concat(v2_rt::concat(a, b), c)
fn emit_nested_rt_concat(remaining: List<String>, acc: String, rc_types: Map<String, Bool>) -> String {
  match remaining |> first {
    None => acc
    Some { value: arg } =>
      let next_acc = if acc == "" { arg }
        else { concat("v2_rt::concat(", acc, ", ", arg, ")") }
      emit_nested_rt_concat(remaining: remaining |> skip(1), acc: next_acc, rc_types: rc_types)
  }
}

fn emit_typed_for_each(variable: String, collection: Node, body: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  let coll_str = emit_typed_expr(texpr: collection, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  let elem_type = for_each_element_type_node(n: match rt_node(n: collection) { Some { value: rt } => rt  None => leaf_node(name: "Unit") })
  let body_scope = extend_scope(scope: scope, name: variable, resolved: elem_type)
  let body_str = emit_typed_expr(texpr: body, registry: registry, scope: body_scope, depth: depth + 1, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  concat("for ", rust_ident(name: variable), " in ", coll_str, ".iter().cloned() {\n",
    make_indent(level: depth + 1),body_str, ";\n}")
}

fn emit_typed_index(base: Node, index: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  let base_str = emit_typed_expr(texpr: base, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  let index_str = emit_typed_expr(texpr: index, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  let base_node = normalize_access_type_node(n: match rt_node(n: base) { Some { value: rt } => rt  None => leaf_node(name: "Unit") })
  if is_string_type_node(n: base_node) {
    concat("v2_rt::char_at(&", base_str, ", ", index_str, ")")
  } else if node_is_map(n: base_node) {
    concat("(", base_str, ").get(&", index_str, ").cloned()")
  } else {
    "panic!(\"internal error: unsupported index base in emitter\")"
  }
}

fn emit_typed_slice(base: Node, start: Node, end: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  let base_str = emit_typed_expr(texpr: base, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  let start_str = emit_typed_expr(texpr: start, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  let end_str = emit_typed_expr(texpr: end, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  let base_node = normalize_access_type_node(n: match rt_node(n: base) { Some { value: rt } => rt  None => leaf_node(name: "Unit") })
  if is_string_type_node(n: base_node) {
    concat("v2_rt::substring(&", base_str, ", ", start_str, ", ", end_str, ")")
  } else {
    "panic!(\"internal error: unsupported slice base in emitter\")"
  }
}

// Extract element type string from a receiver's resolved_type (List<T> -> T's Rust type).
fn collection_element_type(receiver_type: InferredNode?, rc_types: Map<String, Bool>) -> String {
  match receiver_type {
    Some { value: Resolved { node: rt } } =>
      if node_is_container(n: rt) {
        match rt.children |> first {
          Some { value: elem_node } => emit_rust_node_type(n: elem_node, rc_types: rc_types)
          None => "_"
        }
      } else { "_" }
    _ => "_"
  }
}

fn lambda_scope_from_semantics(scope: InferScope, params: List<String>, semantics: LambdaSemantics?) -> InferScope {
  match semantics {
    Some { value: lambda_semantics } =>
      params |> enumerate |> fold(init: scope, f: (acc, pair) =>
        let idx = pair.first
        let param_name = pair.second
        let param_type = match lambda_semantics.param_types |> skip(idx) |> first {
          Some { value: resolved_type } => resolved_type
          None => leaf_node(name: "Dynamic")
        }
        extend_scope(scope: acc, name: param_name, resolved: param_type)
      )
    None => scope
  }
}

fn lambda_param_type_strs(params: List<String>, semantics: LambdaSemantics?, fallback_types: List<String>, rc_types: Map<String, Bool>) -> List<String> {
  params |> enumerate |> map(pair =>
    let idx = pair.first
    let param_name = pair.second
    let inferred_type = match semantics {
      Some { value: lambda_semantics } =>
        match lambda_semantics.param_types |> skip(idx) |> first {
          Some { value: param_type } =>
            if param_type.name == "Dynamic" || param_type.name == "Error" {
              none
            } else {
              Some { value: emit_rust_node_type(n: param_type, rc_types: rc_types) }
            }
          None => none
        }
      None => none
    }
    let fallback_type = match fallback_types |> skip(idx) |> first {
      Some { value: ty } => ty
      None => "_"
    }
    match inferred_type {
      Some { value: ty } => concat(rust_ident(name: param_name), ": ", ty)
      None => concat(rust_ident(name: param_name), ": ", fallback_type)
    }
  )
}


// Emit a lambda expression with typed parameters for use in collection methods.
// If the expression is a Lambda, annotate params with elem_type_str. Otherwise emit normally.
fn emit_typed_collection_lambda(lambda_expr: Node, elem_type_str: String, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  match lambda_expr.expr_data {
    ExprLambda { params: ps, body: bd, semantics: semantics } =>
      let param_strs = lambda_param_type_strs(params: ps, semantics: semantics, fallback_types: [elem_type_str], rc_types: rc_types)
      let params_str = param_strs |> join(separator: ", ")
      let lambda_scope = lambda_scope_from_semantics(scope: scope, params: ps, semantics: semantics)
      let body_str = emit_typed_expr(texpr: bd, registry: registry, scope: lambda_scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
      concat("|", params_str, "| ", body_str)
    _ => emit_typed_expr(texpr: lambda_expr, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  }
}

// Emit a fold lambda with typed accumulator and element parameters.
// The accumulator type is always emitted as `_` because the reconciler's inferred
// type for fold accumulators is often wrong (e.g. bare Map<String, String> instead
// of Map<String, Rc<T>>). Rust can infer the correct type from the init value and body.
fn emit_typed_fold_lambda(lambda_expr: Node, acc_type_str: String, elem_type_str: String, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  match lambda_expr.expr_data {
    ExprLambda { params: ps, body: bd, semantics: semantics } =>
      let fallback_types = ps |> enumerate |> map(pair =>
        if pair.first == 0 { "_" } else { elem_type_str }
      )
      let param_strs = lambda_param_type_strs(params: ps, semantics: none, fallback_types: fallback_types, rc_types: rc_types)
      let params_str = param_strs |> join(separator: ", ")
      let lambda_scope = lambda_scope_from_semantics(scope: scope, params: ps, semantics: semantics)
      let body_str = emit_typed_expr(texpr: bd, registry: registry, scope: lambda_scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
      concat("|", params_str, "| ", body_str)
    _ => emit_typed_expr(texpr: lambda_expr, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  }
}

fn emit_intrinsic_typed_method_call(intrinsic: IntrinsicMethod, fold_accumulator_type: Node?, receiver: Node, args: List<NamedArg>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  let recv_str = emit_typed_expr(texpr: receiver, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  let first_arg_str = emit_typed_first_arg(args: args, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  let elem_type_str = collection_element_type(receiver_type: receiver.return_type, rc_types: rc_types)
  match intrinsic {
    MethodCount => concat("(", recv_str, ".len() as i64)")
    MethodJoin => concat(recv_str, ".join(&", first_arg_str, ")")
    MethodSplit => concat(recv_str, ".split(&", first_arg_str, ").map(|s| s.to_string()).collect::<Vec<_>>()")
    MethodLast => concat(recv_str, ".last().cloned()")
    MethodFirst => concat(recv_str, ".first().cloned()")
    MethodEnumerate =>
      concat(recv_str, ".iter().cloned().enumerate().map(|(i, v)| (i as i64, v)).collect::<Vec<_>>()")
    MethodChars => concat(recv_str, ".chars().map(|c| c.to_string()).collect::<Vec<_>>()")
    MethodStringContains => concat("v2_rt::string_contains(", recv_str, ", ", first_arg_str, ")")
    MethodConcat => {
      let arg_strs = args |> map(a => emit_typed_expr(texpr: a.value, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info))
      let all_arg_strs = concat([recv_str], arg_strs)
      emit_nested_rt_concat(remaining: all_arg_strs, acc: "", rc_types: rc_types)
    }
    MethodMap =>
      // RC4: If the receiver is Optional, emit .map(|p| body) to preserve Option type.
      // Otherwise use the standard for-loop collect pattern for lists.
      let recv_is_optional = match receiver.return_type {
        Some { value: Resolved { node: rt } } => node_is_optional(n: resolve_scrutinee_type_node(env: scope.type_env, n: rt))
        _ => false
      }
      if recv_is_optional {
        match args |> first {
          Some { value: a } =>
            match a.value.expr_data {
              ExprLambda { params: ps, body: bd, semantics: semantics } =>
                let dag_name = match ps |> first { Some { value: n } => n  None => "__x" }
                let p = rust_ident(name: dag_name)
                let lambda_scope = lambda_scope_from_semantics(scope: scope, params: ps, semantics: semantics)
                let body_str = emit_typed_expr(texpr: bd, registry: registry, scope: lambda_scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
                concat(recv_str, ".map(|", p, "| ", body_str, ")")
              _ => concat(recv_str, ".map(", first_arg_str, ")")
            }
          None => concat(recv_str, ".map(", first_arg_str, ")")
        }
      } else {
        match args |> first {
          Some { value: a } =>
            match a.value.expr_data {
              ExprLambda { params: ps, body: bd, semantics: semantics } =>
                let dag_name = match ps |> first { Some { value: n } => n  None => "__x" }
                let p = rust_ident(name: dag_name)
                let lambda_scope = lambda_scope_from_semantics(scope: scope, params: ps, semantics: semantics)
                let body_str = emit_typed_expr(texpr: bd, registry: registry, scope: lambda_scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
                concat("{ let mut __result = Vec::new(); for ", p, " in ", recv_str, ".iter().cloned() { __result.push(", body_str, "); } __result }")
              _ => concat(recv_str, ".iter().cloned().map(", first_arg_str, ").collect::<Vec<_>>()")
            }
          None => concat(recv_str, ".iter().cloned().map(", first_arg_str, ").collect::<Vec<_>>()")
        }
      }
    MethodFilter =>
      match args |> first {
        Some { value: a } =>
          match a.value.expr_data {
            ExprLambda { params: ps, body: bd, semantics: semantics } =>
              let dag_name = match ps |> first { Some { value: n } => n  None => "__x" }
              let p = rust_ident(name: dag_name)
              let lambda_scope = lambda_scope_from_semantics(scope: scope, params: ps, semantics: semantics)
              let body_str = emit_typed_expr(texpr: bd, registry: registry, scope: lambda_scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
              concat("{ let mut __result = Vec::new(); for ", p, " in ", recv_str, ".iter().cloned() { if ", body_str, " { __result.push(", p, "); } } __result }")
            _ => concat(recv_str, ".iter().cloned().filter(", first_arg_str, ").collect::<Vec<_>>()")
          }
        None => concat(recv_str, ".iter().cloned().filter(", first_arg_str, ").collect::<Vec<_>>()")
      }
    MethodAny =>
      match args |> first {
        Some { value: a } =>
          match a.value.expr_data {
            ExprLambda { params: ps, body: bd, semantics: semantics } =>
              let dag_name = match ps |> first { Some { value: n } => n  None => "__x" }
              let p = rust_ident(name: dag_name)
              let lambda_scope = lambda_scope_from_semantics(scope: scope, params: ps, semantics: semantics)
              let body_str = emit_typed_expr(texpr: bd, registry: registry, scope: lambda_scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
              concat("{ let mut __found = false; for ", p, " in ", recv_str, ".iter().cloned() { if ", body_str, " { __found = true; break; } } __found }")
            _ => concat(recv_str, ".iter().cloned().any(", first_arg_str, ")")
          }
        None => concat(recv_str, ".iter().cloned().any(", first_arg_str, ")")
      }
    MethodAll =>
      match args |> first {
        Some { value: a } =>
          match a.value.expr_data {
            ExprLambda { params: ps, body: bd, semantics: semantics } =>
              let dag_name = match ps |> first { Some { value: n } => n  None => "__x" }
              let p = rust_ident(name: dag_name)
              let lambda_scope = lambda_scope_from_semantics(scope: scope, params: ps, semantics: semantics)
              let body_str = emit_typed_expr(texpr: bd, registry: registry, scope: lambda_scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
              concat("{ let mut __all = true; for ", p, " in ", recv_str, ".iter().cloned() { if !(", body_str, ") { __all = false; break; } } __all }")
            _ => concat(recv_str, ".iter().cloned().all(", first_arg_str, ")")
          }
        None => concat(recv_str, ".iter().cloned().all(", first_arg_str, ")")
      }
    MethodFlatMap =>
      match args |> first {
        Some { value: a } =>
          match a.value.expr_data {
            ExprLambda { params: ps, body: bd, semantics: semantics } =>
              let dag_name = match ps |> first { Some { value: n } => n  None => "__x" }
              let p = rust_ident(name: dag_name)
              let lambda_scope = lambda_scope_from_semantics(scope: scope, params: ps, semantics: semantics)
              let body_str = emit_typed_expr(texpr: bd, registry: registry, scope: lambda_scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
              concat("{ let mut __result = Vec::new(); for ", p, " in ", recv_str, ".iter().cloned() { __result.extend(", body_str, "); } __result }")
            _ => concat(recv_str, ".iter().cloned().flat_map(", first_arg_str, ").collect::<Vec<_>>()")
          }
        None => concat(recv_str, ".iter().cloned().flat_map(", first_arg_str, ").collect::<Vec<_>>()")
      }
    MethodSkip => concat(recv_str, ".iter().cloned().skip(", first_arg_str, " as usize).collect::<Vec<_>>()")
    MethodTake => concat(recv_str, ".iter().cloned().take(", first_arg_str, " as usize).collect::<Vec<_>>()")
    MethodFold => {
      let init_str = emit_typed_first_arg(args: args, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
      let fold_fn = match args |> skip(1) |> first {
        Some { value: a } =>
          let acc_type_str = match fold_accumulator_type {
            Some { value: acc_type } => emit_rust_node_type(n: acc_type, rc_types: rc_types)
            None =>
              // Fallback: infer accumulator type from init expression's return type
              match args |> first {
                Some { value: init_arg } =>
                  if init_arg.value.return_type != none {
                    let init_rt = match rt_node(n: init_arg.value) { Some { value: rt } => rt  None => leaf_node(name: "Unit") }
                    let init_type = emit_rust_node_type(n: init_rt, rc_types: rc_types)
                    if init_type != "" && init_type != "Dynamic" { init_type } else { "_" }
                  } else { "_" }
                None => "_"
              }
          }
          emit_typed_fold_lambda(lambda_expr: a.value, acc_type_str: acc_type_str, elem_type_str: elem_type_str, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
        None => "compile_error!(\"missing fold function argument\")"
      }
      concat(recv_str, ".iter().cloned().fold(", init_str, ", ", fold_fn, ")")
    }
    MethodSortBy =>
      // Annotate sort_by closure params with the element type to avoid E0282.
      let elem_type_str = match receiver.return_type {
        Some { value: Resolved { node: rt } } =>
          let resolved = resolve_scrutinee_type_node(env: scope.type_env, n: rt)
          let elem = for_each_element_type_node(n: resolved)
          if elem.name != "" && elem.name != "Dynamic" {
            emit_rust_node_type(n: elem, rc_types: rc_types)
          } else { "_" }
        _ => "_"
      }
      concat("{ let mut __sorted = ", recv_str, ".clone(); __sorted.sort_by(|a: &", elem_type_str, ", b: &", elem_type_str, "| { let __ka = (", first_arg_str, ")(a.clone()); let __kb = (", first_arg_str, ")(b.clone()); __ka.partial_cmp(&__kb).unwrap_or(std::cmp::Ordering::Equal) }); __sorted }")
    MethodAppend => concat("v2_rt::list_push(", recv_str, ", ", first_arg_str, ")")
  }
}

fn rust_bridge_fn_name(method: RuntimeBridgeMethod) -> String {
  match method {
    BridgeGet => "get"
    BridgeWith => "with"
    BridgeListPush => "list_push"
    BridgeMapInsert => "map_insert"
    BridgeMapMerge => "map_merge"
    BridgeMapGet => "map_get"
    BridgeMapHas => "map_has"
    BridgeEmitMapHas => "emit_map_has"
    BridgeMapValues => "map_values"
    BridgeMapKeys => "map_keys"
    BridgeMapContainsKey => "map_contains_key"
    BridgeCharAt => "char_at"
    BridgeStringAt => "string_at"
    BridgeStringLength => "string_length"
    BridgeLength => "length"
    BridgeStartsWith => "starts_with"
    BridgeEndsWith => "ends_with"
    BridgeToString => "to_string"
    BridgeTrim => "trim"
    BridgeToLower => "to_lower"
    BridgeToUpper => "to_upper"
    BridgeReplace => "replace"
    BridgeSubstring => "substring"
    BridgeToInt => "to_int"
    BridgeEmptyMap => "empty_map"
    BridgeContains => "contains"
    BridgeReverse => "reverse"
    BridgeLookup => "lookup"
  }
}

fn emit_runtime_bridge_method_call(method: RuntimeBridgeMethod, receiver: Node, args: List<NamedArg>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  let function_name = rust_bridge_fn_name(method: method)
  let lowered = if (method == BridgeGet) {
    let list_str = emit_typed_expr(texpr: receiver, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
    let index_str = match args |> first {
      Some { value: a } => emit_typed_expr(texpr: a.value, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
      None => "compile_error!(\"get method missing index\")"
    }
    concat(list_str, ".get((", index_str, ") as usize).cloned()")
  } else if (method == BridgeWith) {
    let base_str = emit_typed_expr(texpr: receiver, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
    let type_name = match receiver.return_type {
      Some { value: Resolved { node: rt } } =>
        if rt.name == "Error" || rt.name == "" {
          "compile_error!(\"with method missing resolved record type\")"
        } else { rt.name }
      _ => "compile_error!(\"with method missing resolved record type\")"
    }
    if args |> count == 0 { return "compile_error!(\"with method missing update record\")" }
    let update_arg = (args |> first).value.value
    let field_strs = match update_arg.expr_data {
      ExprRecordLit { fields: fs, type_name: _, parent_enum: _ } =>
        fs |> map(f => concat(rust_ident(name: f.name), ": ", emit_typed_expr(texpr: f.value, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)))
      _ => [emit_typed_expr(texpr: update_arg, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)]
    }
    let fields_str = field_strs |> join(separator: ", ")
    let needs_rc = emit_map_has(m: rc_types, key: type_name)
    let spread = if needs_rc { concat("(*", base_str, ").clone()") } else { concat(base_str, ".clone()") }
    let raw = concat(type_name, " { ", fields_str, ", ..", spread, " }")
    if needs_rc { concat("Rc::new(", raw, ")") } else { raw }
  } else {
    let recv_str = if rust_runtime_bridge_passes_receiver_by_ref(function_name: function_name) {
      concat("&", emit_typed_expr_base(texpr: receiver, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info))
    } else {
      emit_cloned_arg(texpr: receiver, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
    }
    let arg_strs = args |> map(a => emit_cloned_arg(texpr: a.value, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info))
    let all_strs = concat([recv_str], arg_strs)
    concat("v2_rt::", rust_ident(name: function_name), "(", all_strs |> join(separator: ", "), ")")
  }
  if method == BridgeMapGet && rust_lookup_receiver_needs_rc_wrap(receiver: receiver, scope: scope) {
    concat(lowered, ".map(Rc::new)")
  } else {
    lowered
  }
}

fn emit_typed_method_call(receiver: Node, method: String, args: List<NamedArg>, method_semantics: MethodSemantics?, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  match method_semantics {
    Some { value: ServiceMethodSemantics { service_name: svc_name } } => {
      let var_name = service_var_name(service_name: svc_name)
      let arg_strs = args |> map(a => emit_typed_expr(texpr: a.value, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info))
      let args_str = arg_strs |> join(separator: ", ")
      concat(var_name, ".", rust_ident(name: method), "(", args_str, ").await?")
    }
    Some { value: IntrinsicMethodSemantics { intrinsic: intrinsic, fold_accumulator_type: fold_accumulator_type } } => {
      let lowered = emit_intrinsic_typed_method_call(intrinsic: intrinsic, fold_accumulator_type: fold_accumulator_type, receiver: receiver, args: args, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
      lowered
    }
    Some { value: RuntimeBridgeSemantics { method: bridge_method } } =>
      emit_runtime_bridge_method_call(method: bridge_method, receiver: receiver, args: args, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
    Some { value: PlainMethodSemantics } =>
      let recv_str = emit_typed_expr(texpr: receiver, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
      let arg_strs = args |> map(a => emit_typed_expr(texpr: a.value, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info))
      let args_str = arg_strs |> join(separator: ", ")
      concat(recv_str, ".", rust_ident(name: method), "(", args_str, ")")
    None => "compile_error!(\"method call missing reconcile semantics\")"
  }
}

fn emit_typed_first_arg(args: List<NamedArg>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  match args |> first {
    Some { value: a } => emit_typed_expr(texpr: a.value, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
    None => "compile_error!(\"missing method argument\")"
  }
}

fn emit_typed_match(scrutinee: Node, arms: List<MatchArm>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  let scrut_str = emit_typed_expr(texpr: scrutinee, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  // Extract scrutinee type name for qualifying variant patterns.
  // For Optional<T>, unwrap to get T so inner patterns qualify correctly.
  let scrut_type = match scrutinee.return_type {
    Some { value: Resolved { node: rt } } =>
      if node_is_optional(n: rt) {
        with_required_cardinality(n: rt).name
      } else { rt.name }
    _ => ""
  }
  let rc_match = analyze_rc_match(scrutinee: scrutinee, arms: arms, scrut_type: scrut_type, vtoe: vtoe, rc_types: rc_types)
  let arm_strs = arms |> map(arm => emit_typed_match_arm(arm: arm, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info, scrut_type: scrut_type))
  let arms_str = arm_strs |> join(separator: "\n")
  // RC5: If scrutinee is Option<Rc<T>>, use .as_deref().cloned() to get Option<T>.
  // If scrutinee is Rc<T>, use (*s).clone() to get owned T.
  // When all arms are string literal patterns, convert scrutinee to &str
  // so Rust can match &str patterns against String values.
  let needs_as_str = all_arms_are_string_lit(arms: arms) && arms |> count > 0
  if rc_match.needs_option_deref {
    concat("match ", scrut_str, ".as_deref().cloned() {\n", arms_str, "\n}")
  } else if rc_match.needs_deref {
    concat("match (*", scrut_str, ").clone() {\n", arms_str, "\n}")
  } else if needs_as_str {
    concat("match ", scrut_str, ".as_str() {\n", arms_str, "\n}")
  } else {
    concat("match ", scrut_str, " {\n", arms_str, "\n}")
  }
}

fn emit_typed_match_arm(arm: MatchArm, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo, scrut_type: String) -> String {
  let rc_analysis = analyze_rc_pattern(pattern: arm.pattern, scrut_type: scrut_type, vtoe: vtoe, rc_types: rc_types)
  let pat_str = if rc_analysis.needs_rc_pattern {
    emit_pattern_rc_aware(pattern: arm.pattern, rc_analysis: rc_analysis, vtoe: vtoe, rc_types: rc_types, scrut_type: scrut_type)
  } else {
    emit_pattern(pattern: arm.pattern, vtoe: vtoe, rc_types: rc_types, scrut_type: scrut_type)
  }
  // Collect guards from string literal field bindings (ref field + guard).
  let field_guards = collect_pattern_string_guards(pattern: arm.pattern)
  let arm_guard = match arm.guard {
    Some { value: g } => emit_typed_expr(texpr: g, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
    None => ""
  }
  // Merge field guards with arm guard.
  let guard_str = if field_guards != "" && arm_guard != "" {
    concat(" if ", field_guards, " && ", arm_guard)
  } else if field_guards != "" {
    concat(" if ", field_guards)
  } else if arm_guard != "" {
    concat(" if ", arm_guard)
  } else { "" }
  let body_str = emit_typed_expr(texpr: arm.body, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  if rc_analysis.needs_rc_pattern {
    let prelude = rc_pattern_preludes(pattern: arm.pattern, rc_analysis: rc_analysis, vtoe: vtoe, rc_types: rc_types)
    concat("    ", pat_str, guard_str, " => { ", prelude, " ", body_str, " },")
  } else {
    concat("    ", pat_str, guard_str, " => ", body_str, ",")
  }
}

fn emit_typed_if(condition: Node, then_branch: Node, else_branch: Node?, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  let cond_str = emit_typed_expr(texpr: condition, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  let then_str = emit_typed_expr(texpr: then_branch, registry: registry, scope: scope, depth: depth + 1, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  match else_branch {
    Some { value: eb } => {
      let else_str = emit_typed_expr(texpr: eb, registry: registry, scope: scope, depth: depth + 1, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
      concat("if ", cond_str, " {\n",
        make_indent(level: depth + 1),then_str, "\n} else {\n",
        make_indent(level: depth + 1),else_str, "\n}")
    }
    None =>
      concat("if ", cond_str, " {\n",
        make_indent(level: depth + 1),then_str, "\n}")
  }
}

fn emit_typed_let(name: String, value: Node, body: Node?, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  let val_str = emit_typed_expr(texpr: value, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  let let_line = concat("let ", rust_ident(name: name), " = ", val_str, ";")
  match body {
    Some { value: bd } =>
      let next_scope = extend_scope(scope: scope, name: name, resolved: match rt_node(n: value) { Some { value: rt } => rt  None => leaf_node(name: "Unit") })
      concat(let_line, "\n", emit_typed_expr(texpr: bd, registry: registry, scope: next_scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info))
    None => let_line
  }
}

fn emit_record_lit_full(type_name: String?, fields: List<FieldInit>, span: SourceSpan, registry: Map<String, ItemInfo>, scope: InferScope, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  let inferred = infer_record_lit(type_name: type_name, field_inits: fields, span: span, scope: scope)
  match inferred.typed.expr_data {
    ExprRecordLit { type_name: tn, fields: fs, parent_enum: parent_enum } =>
      emit_typed_record_lit(type_name: tn, fields: fs, parent_enum: parent_enum, resolved_type: match rt_node(n: inferred.typed) { Some { value: rt } => rt  None => leaf_node(name: "Unit") }, registry: registry, scope: scope, depth: 0, vtoe: empty_map(), rc_types: rc_types, emit_info: emit_info)
    _ =>
      "compile_error!(\"internal error: infer_record_lit did not produce ExprRecordLit\")"
  }
}

fn is_optional_struct_field(emit_info: EmitGraphInfo, struct_name: String, field_name: String) -> Bool {
  match lookup_emit_type_summary(emit_info: emit_info, type_name: struct_name) {
    Some { value: summary } =>
      match map_get(summary.field_summaries, field_name) {
        Some { value: field_summary } =>
          match field_summary.value_shape {
            OptionalValue => true
            _ => false
          }
        None => false
      }
    None => false
  }
}

fn is_already_optional(texpr: Node, emit_info: EmitGraphInfo, scope: InferScope) -> Bool {
  match texpr.expr_data {
    ExprLiteral { value: v } => match v { LitNull => true, _ => false }
    ExprVar { name: n, binding_kind: _ } =>
      if n == "none" || n == "None" {
        true
      } else {
        match texpr.return_type {
          Some { value: Resolved { node: rt } } => node_is_optional(n: resolve_scrutinee_type_node(env: scope.type_env, n: rt))
          _ =>
            match map_get(scope.locals, n) {
              Some { value: binding } => node_is_optional(n: resolve_scrutinee_type_node(env: scope.type_env, n: binding.resolved))
              None => false
            }
        }
      }
    ExprRecordLit { type_name: tn, fields: _, parent_enum: _ } =>
      match tn {
        Some { value: name } => name == "Some" || name == "None"
        None => false
      }
    ExprFieldAccess { base: b, field: f, summary: fa_summary } =>
      // If the base type is known and this field has OptionalValue shape,
      // the result is already Option<T> — don't double-wrap in Some().
      // Check 1: field_summary from reconcile directly says OptionalValue
      let summary_says_optional = match fa_summary {
        Some { value: fs } => match fs.value_shape { OptionalValue => true, _ => false }
        None => false
      }
      if summary_says_optional { true }
      else {
        match b.return_type {
          Some { value: Resolved { node: base_type } } =>
            let resolved_base = resolve_scrutinee_type_node(env: scope.type_env, n: base_type)
            if is_optional_struct_field(emit_info: emit_info, struct_name: resolved_base.name, field_name: f) {
              true
            } else {
              // Fallback: struct may not be in type_summaries; check expression return type
              match texpr.return_type {
                Some { value: Resolved { node: rt } } => node_is_optional(n: resolve_scrutinee_type_node(env: scope.type_env, n: rt))
                _ => false
              }
            }
          _ =>
            match texpr.return_type {
              Some { value: Resolved { node: rt } } => node_is_optional(n: resolve_scrutinee_type_node(env: scope.type_env, n: rt))
              _ => false
            }
        }
      }
    _ =>
      match texpr.return_type {
        Some { value: Resolved { node: rt } } => node_is_optional(n: resolve_scrutinee_type_node(env: scope.type_env, n: rt))
        _ => false
      }
  }
}

// RC2: Look up the expected type of a field from the struct's type node children.
// Used to disambiguate variant constructors that exist in multiple enums
// (e.g. LitStr in both TokenKind and LiteralValue).
// Handles both Conj nodes (struct fields are direct children) and Disj nodes
// (need to find the variant first, then look in its children).
fn lookup_struct_field_type_name(struct_node: Node, field_name: String, variant_name: String?) -> String? {
  // First try: direct children (works for Conj/struct nodes)
  let direct = match struct_node.children |> filter(c => c.name == field_name) |> first {
    Some { value: field_child } =>
      if field_child.return_type != none {
        match rt_node(n: field_child) {
          Some { value: field_type } =>
            if field_type.name != "" && field_type.name != "Dynamic" {
              Some { value: field_type.name }
            } else { none }
          None => none
        }
      } else { none }
    None => none
  }
  match direct {
    Some { value: _ } => direct
    None =>
      // Second try: for Disj (enum) nodes, find the variant first then its fields
      match variant_name {
        Some { value: vn } =>
          match struct_node.children |> filter(c => c.name == vn) |> first {
            Some { value: variant_child } =>
              match variant_child.children |> filter(c => c.name == field_name) |> first {
                Some { value: field_child } =>
                  if field_child.return_type != none {
                    match rt_node(n: field_child) {
                      Some { value: field_type } =>
                        if field_type.name != "" && field_type.name != "Dynamic" {
                          Some { value: field_type.name }
                        } else { none }
                      None => none
                    }
                  } else { none }
                None => none
              }
            None => none
          }
        None => none
      }
  }
}

// RC2: Emit a field value with context-aware variant disambiguation.
// When a field value is a variant constructor and the variant exists in multiple enums,
// use the struct's expected field type to determine the correct parent enum.
fn emit_field_value_with_context(field_value: Node, struct_node: Node, outer_type_name: String?, field_name: String, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  match field_value.expr_data {
    ExprRecordLit { type_name: tn, fields: inner_fields, parent_enum: pe } =>
      match tn {
        Some { value: variant_name } =>
          // Try node-based lookup first, then fall back to field_type_names map
          let node_lookup = lookup_struct_field_type_name(struct_node: struct_node, field_name: field_name, variant_name: outer_type_name)
          let expected_type = match node_lookup {
            Some { value: _ } => node_lookup
            None =>
              // Fallback: use the field_type_names map from emit_info.
              // This handles cases where resolved_type is a leaf node without children
              // (e.g., Token struct where resolved_type has name "Token" but no field defs).
              if struct_node.name != "" {
                let ftn_key = concat(struct_node.name, "|", field_name)
                map_get(emit_info.field_type_names, ftn_key)
              } else { none }
          }
          let corrected_parent = match expected_type {
            Some { value: et } =>
              let key = concat(et, "|", variant_name)
              if emit_map_has(m: emit_info.enum_variant_membership, key: key) {
                Some { value: et }
              } else { pe }
            None => pe
          }
          emit_typed_record_lit(type_name: tn, fields: inner_fields, parent_enum: corrected_parent, resolved_type: match rt_node(n: field_value) { Some { value: rt } => rt  None => leaf_node(name: "Unit") }, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
        None =>
          emit_typed_expr(texpr: field_value, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
      }
    _ =>
      emit_typed_expr(texpr: field_value, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  }
}

fn emit_typed_record_lit(type_name: String?, fields: List<FieldInit>, parent_enum: String?, resolved_type: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  let struct_name = explicit_record_struct_name(type_name: type_name, inferred_node: resolved_type, rc_types: rc_types)
  let qualified_name = match struct_name {
    Some { value: sn } => Some { value: sn }
    None => none
  }
  match qualified_name {
    None =>
      // Anonymous record literal: emit as bare value (single-field) or tuple (multi-field).
      let kind = classify_type_structure(n: resolved_type)
      if (kind == TypeConj) && resolved_type.name == "" {
        if fields |> count == 1 {
          match fields |> first {
            Some { value: f } =>
              emit_typed_expr(texpr: f.value, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
            None => "compile_error!(\"empty anonymous record literal\")"
          }
        } else {
          // Multi-field anonymous record: emit as tuple.
          let vals = fields |> map(f =>
            emit_typed_expr(texpr: f.value, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
          )
          concat("(", vals |> join(separator: ", "), ")")
        }
      } else {
        "compile_error!(\"cannot resolve anonymous record type in emitter\")"
      }
    Some { value: tn } =>
      // RC1: Qualify variant names with parent enum to avoid name collisions
      // (e.g. LitFloat exists in both TokenKind and LiteralValue).
      // Prefer resolved_type.name (from return type inference) over parent_enum
      // (from variant_to_enum map) since the latter can be wrong due to
      // nondeterministic HashMap iteration order in v1-compiled stage0.
      let effective_parent = if resolved_type.name != "" && resolved_type.name != tn && resolved_type.name != "Dynamic" && resolved_type.name != "Error" {
        Some { value: resolved_type.name }
      } else {
        parent_enum
      }
      let display_tn = if tn == "Some" || tn == "None" { tn }
        else {
          match effective_parent {
            Some { value: resolved_parent_enum } => concat(resolved_parent_enum, "::", tn)
            None => tn
          }
        }
      if tn == "Some" && fields |> count == 1 {
        match fields |> first {
          Some { value: f } =>
            let inner = emit_typed_expr(texpr: f.value, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
            concat("Some(", inner, ")")
          None => concat(display_tn, " {}")
        }
      } else if fields |> count == 0 {
        let empty_raw = concat(display_tn, " {}")
        let record_parent_enum = match parent_enum {
          Some { value: en } => en
          None => ""
        }
        let needs_rc = emit_map_has(m: rc_types, key: tn) || emit_map_has(m: rc_types, key: resolved_type.name) || emit_map_has(m: rc_types, key: record_parent_enum)
        if needs_rc { concat("Rc::new(", empty_raw, ")") } else { empty_raw }
      } else {
        let field_strs = fields |> map(f =>
          let val_str = emit_field_value_with_context(field_value: f.value, struct_node: resolved_type, outer_type_name: type_name, field_name: f.name, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
          let needs_wrap = is_optional_struct_field(emit_info: emit_info, struct_name: tn, field_name: f.name)
            && is_already_optional(texpr: f.value, emit_info: emit_info, scope: scope) == false
          let field_val = if needs_wrap {
            concat("Some(", val_str, ")")
          } else { val_str }
          concat("    ", rust_ident(name: f.name), ": ", field_val, ",")
        )
        let all_field_strs = field_strs
        let fields_str = all_field_strs |> join(separator: "\n")
        let raw = concat(display_tn, " {\n", fields_str, "\n}")
        let record_parent_enum = match parent_enum {
          Some { value: en } => en
          None => ""
        }
        let needs_rc = emit_map_has(m: rc_types, key: tn) || emit_map_has(m: rc_types, key: resolved_type.name) || emit_map_has(m: rc_types, key: record_parent_enum)
        if needs_rc { concat("Rc::new(", raw, ")") } else { raw }
      }
  }
}

fn emit_typed_list_lit(elements: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  if elements |> count == 0 {
    "vec![]"
  } else {
    let el_strs = elements |> map(e => emit_typed_expr(texpr: e, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info))
    let els_str = el_strs |> join(separator: ", ")
    concat("vec![", els_str, "]")
  }
}

fn emit_typed_bin_op(op: BinOpKind, left: Node, right: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  let l_str = emit_typed_expr(texpr: left, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  let r_str = emit_typed_expr(texpr: right, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  if is_null_coalesce(op: op) {
    concat(l_str, ".unwrap_or_else(|| ", r_str, ")")
  } else {
    let op_str = rust_bin_op_symbol(op: op)
    if is_string_comparison(op: op, left: left, right: right) {
      concat("(", l_str, ".as_str() ", op_str, " ", r_str, ".as_str())")
    } else {
      concat("(", l_str, " ", op_str, " ", r_str, ")")
    }
  }
}

// RC3: Detect string equality/inequality comparisons.
fn is_string_comparison(op: BinOpKind, left: Node, right: Node) -> Bool {
  match op {
    BinEq => is_string_typed_expr(e: left) && is_string_typed_expr(e: right)
    BinNe => is_string_typed_expr(e: left) && is_string_typed_expr(e: right)
    _ => false
  }
}

// Check if an expression has String resolved_type or is a string literal.
fn is_string_typed_expr(e: Node) -> Bool {
  match e.return_type {
    Some { value: Resolved { node: rt } } => is_string_type_node(n: rt)
    _ => false
  }
}

fn emit_typed_unary_op(op: UnaryOpKind, operand: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  let expr_str = emit_typed_expr(texpr: operand, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  match op {
    Not => concat(rust_keyword(key: "not"), expr_str)
    Neg => concat("-", expr_str)
  }
}

fn emit_typed_lambda(params: List<String>, body: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  let param_strs = params |> map(p => rust_ident(name: p))
  let params_str = param_strs |> join(separator: ", ")
  let body_str = emit_typed_expr(texpr: body, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  concat("|", params_str, "| ", body_str)
}

fn emit_typed_string_interp(parts: List<StringPart>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  let fmt_parts = parts |> map(p => typed_interp_format_part(part: p, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info))
  let fmt_str = fmt_parts |> map(p => p.format_segment) |> join(separator: "")
  let args = fmt_parts
    |> map(p => p.arg_expr)
    |> filter(a => a != "")
  if args |> count == 0 {
    concat("\"", fmt_str, "\".to_string()")
  } else {
    let args_str = args |> join(separator: ", ")
    concat("format!(\"", fmt_str, "\", ", args_str, ")")
  }
}

fn typed_interp_format_part(part: StringPart, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> InterpPart {
  match part {
    Text { value: v } =>
      let escaped = v
        |> split(delimiter: "{") |> join(separator: "{{")
      let escaped2 = escaped
        |> split(delimiter: "}") |> join(separator: "}}")
      InterpPart { format_segment: escaped2, arg_expr: "" }
    Interpolation { expr: e } =>
      InterpPart { format_segment: "{}", arg_expr: emit_typed_expr(texpr: e, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info) }
  }
}

fn emit_typed_block(stmts: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  let state = emit_rust_block_stmts(
    remaining: stmts, text: [], scope: scope, registry: registry, depth: depth + 1, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  concat("{\n", make_indent(level: depth + 1),(state.text |> join(separator: "\n")), "\n}")
}

fn emit_typed_cast(expr: Node, target: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  let expr_str = emit_typed_expr(texpr: expr, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  let ty_str = emit_rust_node_type(n: target, rc_types: rc_types)
  if is_primitive_numeric_node(n: target) {
    concat(expr_str, " as ", ty_str)
  } else {
    concat("compile_error!(\"unsupported cast to ", ty_str, "\")")
  }
}

// =========================================================================
// Node TCO -- Rust rendering
//
// TCO functions that work directly on Node expr_data,
// reading return_type from sub-expressions instead of cache lookups.
// =========================================================================

// TCO-aware version of emit_rust_init_block_stmts.
// For Let statements that shadow a TCO parameter, emit assignment (no `let`).
fn emit_tco_init_block_stmts(remaining: List<Node>, text: List<String>,
    scope: InferScope, registry: Map<String, ItemInfo>, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo, params: List<Param>) -> BlockEmitState {
  match remaining |> first {
    None => BlockEmitState { text: text, scope: scope }
    Some { value: stmt } =>
      let rest = remaining |> skip(1)
      match rest |> first {
        None => BlockEmitState { text: text, scope: scope }
        Some { value: _ } =>
          let line = emit_tco_init_stmt(stmt: stmt, params: params, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
          let next_scope = scope_after_expr(texpr: stmt, scope: scope)
          emit_tco_init_block_stmts(remaining: rest,
            text: list_push(text, line), scope: next_scope,
            registry: registry, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info, params: params)
      }
  }
}

fn emit_tco_init_stmt(stmt: Node, params: List<Param>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  match stmt.expr_data {
    ExprLet { name: n, value: v, body: _ } =>
      let val_str = emit_typed_expr(texpr: v, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
      let is_param = params |> any(p => p.name == n)
      if is_param { concat(rust_ident(name: n), " = ", val_str, ";") }
      else { concat("let ", rust_ident(name: n), " = ", val_str, ";") }
    _ => emit_typed_expr(texpr: stmt, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  }
}

fn emit_typed_tco_body(texpr: Node, fn_name: String, params: List<Param>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  let inner = emit_typed_tco_expr(texpr: texpr, fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth + 1, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  concat("loop {\n", make_indent(level: depth + 1),inner, "\n}")
}

fn emit_typed_tco_expr(texpr: Node, fn_name: String, params: List<Param>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  match texpr.expr_data {
    ExprCall { func: f, args: a, call_semantics: _ } =>
      if f == fn_name {
        emit_typed_tco_reassign(args: a, params: params, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
      } else {
        let call_str = emit_typed_call(func: f, args: a, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
        concat("break ", call_str, ";")
      }
    ExprIf { condition: c, then_branch: t, else_branch: e } =>
      let cond_str = emit_typed_expr(texpr: c, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
      let then_str = emit_typed_tco_expr(texpr: t, fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth + 1, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
      match e {
        Some { value: eb } =>
          let else_str = emit_typed_tco_expr(texpr: eb, fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth + 1, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
          concat("if ", cond_str, " {\n",
            make_indent(level: depth + 1),then_str, "\n} else {\n",
            make_indent(level: depth + 1),else_str, "\n}")
        None =>
          concat("if ", cond_str, " {\n",
            make_indent(level: depth + 1),then_str, "\n}")
      }
    ExprMatch { scrutinee: s, arms: arm_list } =>
      let scrut_str = emit_typed_expr(texpr: s, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
      let tco_scrut_type = match s.return_type {
        Some { value: Resolved { node: rt } } =>
          if node_is_optional(n: rt) {
            with_required_cardinality(n: rt).name
          } else { rt.name }
        _ => ""
      }
      let rc_match = analyze_rc_match(scrutinee: s, arms: arm_list, scrut_type: tco_scrut_type, vtoe: vtoe, rc_types: rc_types)
      let arm_strs = arm_list |> map(arm =>
        emit_typed_tco_match_arm(arm: arm, fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info, scrut_type: tco_scrut_type))
      let arms_str = arm_strs |> join(separator: "\n")
      let tco_needs_as_str = all_arms_are_string_lit(arms: arm_list) && arm_list |> count > 0
      if rc_match.needs_option_deref {
        concat("match ", scrut_str, ".as_deref().cloned() {\n", arms_str, "\n}")
      } else if rc_match.needs_deref {
        concat("match (*", scrut_str, ").clone() {\n", arms_str, "\n}")
      } else if tco_needs_as_str {
        concat("match ", scrut_str, ".as_str() {\n", arms_str, "\n}")
      } else {
        concat("match ", scrut_str, " {\n", arms_str, "\n}")
      }
    ExprLet { name: n, value: v, body: bd } =>
      let val_str = emit_typed_expr(texpr: v, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
      let is_param = params |> any(p => p.name == n)
      let let_line = if is_param { concat(rust_ident(name: n), " = ", val_str, ";") } else { concat("let ", rust_ident(name: n), " = ", val_str, ";") }
      let next_scope = extend_scope(scope: scope, name: n, resolved: match rt_node(n: v) { Some { value: rt } => rt  None => leaf_node(name: "Unit") })
      match bd {
        Some { value: b } =>
          concat(let_line, "\n", emit_typed_tco_expr(texpr: b, fn_name: fn_name, params: params, registry: registry, scope: next_scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info))
        None => let_line
      }
    ExprBlock { stmts: ss } =>
      if ss |> count == 0 {
        "break;"
      } else {
        let init_state = emit_tco_init_block_stmts(
          remaining: ss, text: [], scope: scope, registry: registry, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info, params: params)
        let last_str = match ss |> last {
          Some { value: last_expr } =>
            emit_typed_tco_expr(texpr: last_expr, fn_name: fn_name, params: params, registry: registry, scope: init_state.scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
          None => "break;"
        }
        if init_state.text |> count == 0 { last_str } else { concat(init_state.text |> join(separator: "\n"), "\n", last_str) }
      }
    _ =>
      let val_str = emit_typed_expr(texpr: texpr, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
      concat("break ", val_str, ";")
  }
}

fn emit_typed_tco_match_arm(arm: MatchArm, fn_name: String, params: List<Param>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo, scrut_type: String) -> String {
  let rc_analysis = analyze_rc_pattern(pattern: arm.pattern, scrut_type: scrut_type, vtoe: vtoe, rc_types: rc_types)
  let pat_str = if rc_analysis.needs_rc_pattern {
    emit_pattern_rc_aware(pattern: arm.pattern, rc_analysis: rc_analysis, vtoe: vtoe, rc_types: rc_types, scrut_type: scrut_type)
  } else {
    emit_pattern(pattern: arm.pattern, vtoe: vtoe, rc_types: rc_types, scrut_type: scrut_type)
  }
  // Collect guards from string literal field bindings (ref field + guard).
  let field_guards = collect_pattern_string_guards(pattern: arm.pattern)
  let arm_guard = match arm.guard {
    Some { value: g } => emit_typed_expr(texpr: g, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
    None => ""
  }
  let guard_str = if field_guards != "" && arm_guard != "" {
    concat(" if ", field_guards, " && ", arm_guard)
  } else if field_guards != "" {
    concat(" if ", field_guards)
  } else if arm_guard != "" {
    concat(" if ", arm_guard)
  } else { "" }
  let body_str = emit_typed_tco_expr(texpr: arm.body, fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info)
  if rc_analysis.needs_rc_pattern {
    let prelude = rc_pattern_preludes(pattern: arm.pattern, rc_analysis: rc_analysis, vtoe: vtoe, rc_types: rc_types)
    concat("    ", pat_str, guard_str, " => { ", prelude, " ", body_str, " },")
  } else {
    concat("    ", pat_str, guard_str, " => { ", body_str, " },")
  }
}

fn emit_typed_tco_reassign(args: List<NamedArg>, params: List<Param>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  let ordered_args = args |> map(a => emit_typed_expr(texpr: a.value, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: rc_types, emit_info: emit_info))
  let param_names = params |> map(p => rust_ident(name: p.name))
  let temp_lets = ordered_args |> enumerate |> map(pair =>
    concat("let __tco_", to_string(value: pair.first), " = ", pair.second, ";"))
  let assigns = param_names |> enumerate |> map(pair =>
    concat(pair.second, " = __tco_", to_string(value: pair.first), ";"))
  let all_lines = concat(temp_lets, assigns, ["continue;"])
  concat("{\n", make_indent(level: depth + 1),(all_lines |> join(separator: "\n")), "\n}")
}

// =========================================================================
// Service definition emission
//
// Each service becomes:
//   - A client struct with config fields
//   - An impl block with one async method per operation
//   - Transport-specific call scaffolding (REST -> reqwest, Shell -> Command)
// =========================================================================

fn emit_service_def(
  item: Node,
  registry: Map<String, ItemInfo>
) -> String {
  let safe_name = sanitize_service_name(name: item.name)
  let fallback_transport = if item.transport == none { local_transport_node(span: item.span) } else { item.transport.value }
  let op_children = item.children
  let struct_def = emit_service_struct(name: safe_name, fallback_transport: fallback_transport, op_children: op_children, config: item.config)
  let impl_block = emit_service_impl(name: safe_name, transport: fallback_transport, op_children: op_children, registry: registry)
  concat(struct_def, "\n\n", impl_block)
}

// Check if any operation in the service (or the service-level fallback) uses a given transport kind.
fn service_uses_transport(fallback_transport: Node, op_children: List<Node>, kind: TransportKind) -> Bool {
  let from_fallback = is_transport_kind(t: fallback_transport, kind: kind)
  let from_ops = op_children |> any(op =>
    if op.transport != none { is_transport_kind(t: op.transport.value, kind: kind) } else { false }
  )
  from_fallback || from_ops
}

// Check if any REST operation (or the service-level fallback) has auth.
fn service_has_rest_auth(fallback_transport: Node, op_children: List<Node>) -> Bool {
  let from_fallback = if is_transport_kind(t: fallback_transport, kind: RestTransport) {
    transport_has_auth(t: fallback_transport)
  } else { false }
  let from_ops = op_children |> any(op =>
    if op.transport != none {
      let t = op.transport.value
      if is_transport_kind(t: t, kind: RestTransport) { transport_has_auth(t: t) } else { false }
    } else { false }
  )
  from_fallback || from_ops
}

fn emit_service_struct(name: String, fallback_transport: Node, op_children: List<Node>, config: ServiceConfig?) -> String {
  let derives = "#[derive(Debug, Clone)]"
  let config_fields = emit_service_config_fields(fallback_transport: fallback_transport, op_children: op_children, config: config)
  let dry_run_field = "\n    pub dry_run: crate::dry_run::DryRunMode,"
  concat(derives, "\npub struct ", name, " {\n", config_fields, dry_run_field, "\n}")
}

fn emit_service_config_fields(fallback_transport: Node, op_children: List<Node>, config: ServiceConfig?) -> String {
  let has_shell = service_uses_transport(fallback_transport: fallback_transport, op_children: op_children, kind: ShellTransport)
  let has_rest = service_uses_transport(fallback_transport: fallback_transport, op_children: op_children, kind: RestTransport)
  let has_file = service_uses_transport(fallback_transport: fallback_transport, op_children: op_children, kind: FileTransport)
  let has_auth = service_has_rest_auth(fallback_transport: fallback_transport, op_children: op_children)
  let shell_field = if has_shell { "    pub working_dir: Option<String>,\n" } else { "" }
  let rest_field = if has_rest { "    pub base_url: String,\n" } else { "" }
  let auth_field = if has_auth { "    pub auth_token: String,\n" } else { "" }
  let file_field = if has_file { "    pub base_path: String,\n" } else { "" }
  let fields = concat(shell_field, rest_field, auth_field, file_field)
  if fields == "" { "    // No configuration needed for local binding.\n" } else { fields }
}

fn emit_service_impl(name: String, transport: Node, op_children: List<Node>, registry: Map<String, ItemInfo>) -> String {
  let depth = 0
  let new_method = emit_service_new_method(name: name, fallback_transport: transport, op_children: op_children)
  let method_strs = op_children |> map(op_node =>
    emit_operation_method(service_name: name, transport: transport, op_node: op_node, registry: registry, depth: depth + 1)
  )
  let all_methods = concat([new_method], method_strs)
  let methods_str = all_methods |> join(separator: "\n\n")
  concat("impl ", name, " {\n", make_indent(level: depth + 1),methods_str, "\n}")
}

// Emit a `new` constructor for a service struct that accepts DryRunMode.
// Scans all operations to determine which transport fields to initialize.
fn emit_service_new_method(name: String, fallback_transport: Node, op_children: List<Node>) -> String {
  let has_shell = service_uses_transport(fallback_transport: fallback_transport, op_children: op_children, kind: ShellTransport)
  let has_rest = service_uses_transport(fallback_transport: fallback_transport, op_children: op_children, kind: RestTransport)
  let has_file = service_uses_transport(fallback_transport: fallback_transport, op_children: op_children, kind: FileTransport)
  let has_auth = service_has_rest_auth(fallback_transport: fallback_transport, op_children: op_children)
  // Find a default base_url from the service-level REST transport or from any REST op
  let base_url_default = if has_rest {
    let from_fallback = if is_transport_kind(t: fallback_transport, kind: RestTransport) {
      match transport_base_url(t: fallback_transport) {
        Some { value: bu } => match bu.expr_data {
          ExprLiteral { value: LitStr { value: s } } => s
          _ => ""
        }
        None => ""
      }
    } else { "" }
    if from_fallback != "" { from_fallback } else { "http://localhost" }
  } else { "" }
  let shell_init = if has_shell { "        working_dir: None,\n" } else { "" }
  let rest_init = if has_rest { concat("        base_url: \"", base_url_default, "\".to_string(),\n") } else { "" }
  let auth_init = if has_auth { "        auth_token: String::new(),\n" } else { "" }
  let file_init = if has_file { "        base_path: \".\".to_string(),\n" } else { "" }
  concat(
    "pub fn new(dry_run: crate::dry_run::DryRunMode) -> Self {\n",
    "    ", name, " {\n",
    shell_init, rest_init, auth_init, file_init,
    "        dry_run,\n",
    "    }\n",
    "}")
}

// Extract modifier names from properties.
fn extract_modifier_names(properties: List<FieldInit>) -> List<String> {
  properties |> flat_map(p =>
    match field_init_operation_modifier(field_init: p) {
      Some { value: modifier } => [operation_modifier_name(modifier: modifier)]
      None => []
    }
  )
}

fn emit_modifier_doc_from_props(properties: List<FieldInit>) -> String {
  let names = extract_modifier_names(properties: properties)
  if names |> count == 0 {
    ""
  } else {
    concat("/// Modifiers: ", names |> join(separator: ", "), "\n")
  }
}

fn emit_operation_method(service_name: String, transport: Node, op_node: Node, registry: Map<String, ItemInfo>, depth: Int) -> String {
  let input_params = op_node.params |> map(p =>
    concat(rust_ident(name: p.name), ": ", emit_rust_node_type(n: p.type_expr, rc_types: empty_map()))
  )
  let params_str = input_params |> join(separator: ", ")
  let all_params = if params_str == "" {
    "&self"
  } else {
    concat("&self, ", params_str)
  }
  let ret_type = emit_rust_node_type(n: match rt_node(n: op_node) { Some { value: rt } => rt  None => leaf_node(name: "Unit") }, rc_types: empty_map())
  // Use per-operation transport override if present, otherwise service-level transport.
  let effective_transport = match op_node.transport {
    Some { value: op_transport } => op_transport
    None => transport
  }
  let real_body = emit_transport_call(transport: effective_transport, op_name: op_node.name, registry: registry, depth: depth + 2)
  let mock_props = op_node.properties |> filter(p => has_mock_prefix(name: p.name))
  let dry_run_body = emit_dry_run_branch_from_props(op_name: op_node.name, return_type: match rt_node(n: op_node) { Some { value: rt } => rt  None => leaf_node(name: "Unit") }, mock_props: mock_props, registry: registry)
  let body = concat(
    "if self.dry_run.is_dry_run() {\n",
    make_indent(level: depth + 2),dry_run_body, "\n",
    "} else {\n",
    make_indent(level: depth + 2),real_body, "\n",
    "}")
  let modifier_doc = emit_modifier_doc_from_props(properties: op_node.properties)
  concat(modifier_doc, "pub async fn ", rust_ident(name: op_node.name),
    "(", all_params, ") -> Result<", ret_type, ", Box<dyn std::error::Error>> {\n",
    make_indent(level: depth + 1),body, "\n}")
}

// Emit the dry-run branch for an operation method.
// If mock data is available, use it. Otherwise, emit compile_error!().
fn emit_dry_run_branch_from_props(op_name: String, return_type: Node, mock_props: List<FieldInit>, registry: Map<String, ItemInfo>) -> String {
  let log_line = concat("eprintln!(\"[dry-run] ", op_name, "\");")
  if mock_props |> count > 0 {
    // Use the first mock property body as the dry-run return value
    let first_mock = mock_props |> first
    match first_mock {
      Some { value: mp } => {
        let mock_json = emit_data_value_json(value: mp.value)
        concat(log_line, "\n",
          "let mock_value: serde_json::Value = serde_json::from_str(r#\"", mock_json, "\"#)?;\n",
          "Ok(serde_json::from_value(mock_value)?)")
      }
      None => concat(log_line, "\ncompile_error!(\"mock property list was non-empty but first() returned None\")")
    }
  } else {
    concat(log_line, "\ncompile_error!(\"no mock data available for dry-run operation: ", op_name, "\")")
  }
}

fn emit_transport_call(transport: Node, op_name: String, registry: Map<String, ItemInfo>, depth: Int) -> String {
  if is_transport_kind(t: transport, kind: RestTransport) {
    emit_rest_call(op_name: op_name, transport: transport, registry: registry, depth: depth)
  } else if is_transport_kind(t: transport, kind: ShellTransport) {
    emit_shell_call(op_name: op_name, transport: transport, registry: registry, depth: depth)
  } else if is_transport_kind(t: transport, kind: FileTransport) {
    emit_file_call(op_name: op_name)
  } else {
    emit_local_call(op_name: op_name)
  }
}

fn emit_rest_call(op_name: String, transport: Node, registry: Map<String, ItemInfo>, depth: Int) -> String {
  let client_init = "let client = reqwest::Client::new();"
  let url_line = concat("let url = format!(\"{}/{}\", self.base_url, \"",
    rust_ident(name: op_name), "\");")
  let header_name = match transport_auth_header_name(t: transport) {
    Some { value: h } => h
    None => "Authorization"
  }
  let token_node = match transport_auth_token(t: transport) {
    Some { value: tn } => emit_simple_expr(expr: tn)
    None => "\"\""
  }
  let auth_line = if transport_has_auth(t: transport) {
    concat("let request = client.post(&url)\n    .header(\"",
      header_name, "\", ", token_node, ");")
  } else {
    "let request = client.post(&url);"
  }
  let headers = transport_headers(t: transport)
  let header_lines = headers |> map(h =>
    concat("let request = request.header(\"", h.name, "\", ",
      emit_simple_expr(expr: h.value), ");")
  )
  let send_line = "let response = request.send().await?;"
  let parse_line = "let result = response.json().await?;"
  let return_line = "Ok(result)"
  let all_lines = concat([client_init, url_line, auth_line],
    header_lines, [send_line, parse_line, return_line])
  all_lines |> join(separator: "\n")
}

fn emit_shell_call(op_name: String, transport: Node, registry: Map<String, ItemInfo>, depth: Int) -> String {
  let cmd_line = concat("let output = std::process::Command::new(\"",
    rust_ident(name: op_name), "\")")
  let env_entries = transport_env(t: transport)
  let env_lines = env_entries |> map(e =>
    concat("    .env(\"", e.name, "\", ", emit_simple_expr(expr: e.value), ")")
  )
  let wd_line = "    .current_dir(self.working_dir.as_deref().unwrap_or(\".\"))"
  let output_line = "    .output()?;"
  let check_line = "let stdout = String::from_utf8_lossy(&output.stdout).to_string();"
  let return_line = "Ok(stdout)"
  let all_lines = concat([cmd_line], env_lines, [wd_line, output_line, check_line, return_line])
  all_lines |> join(separator: "\n")
}

fn emit_file_call(op_name: String) -> String {
  concat("let path = format!(\"{}/{}\", self.base_path, \"",
    rust_ident(name: op_name), "\");\n",
    "let content = std::fs::read_to_string(&path)?;\n",
    "Ok(content)")
}

fn emit_local_call(op_name: String) -> String {
  concat("// Local binding -- direct function call\n",
    "Ok(", rust_ident(name: op_name), "())")
}

// =========================================================================
// Resource definition emission
//
// Resources become a trait with capability methods.
// =========================================================================

fn emit_resource_def(item: Node) -> String {
  let cap_children = item.children
  if cap_children |> count == 0 {
    // Resources without capabilities are emitted as unit structs.
    // They serve as capability markers passed by reference.
    concat("#[derive(Debug, Clone)]\npub struct ", item.name, ";")
  } else {
    let depth = 0
    let cap_methods = cap_children |> map(c => emit_capability_method(cap_node: c))
    let methods_str = cap_methods |> join(separator: "\n\n")
    concat("#[async_trait::async_trait]\npub trait ", item.name, " {\n",
      make_indent(level: depth + 1),methods_str, "\n}")
  }
}

fn emit_capability_method(cap_node: Node) -> String {
  let input_params = cap_node.params |> map(p =>
    concat(rust_ident(name: p.name), ": ", emit_rust_node_type(n: p.type_expr, rc_types: empty_map()))
  )
  let params_str = input_params |> join(separator: ", ")
  let all_params = if params_str == "" {
    "&self"
  } else {
    concat("&self, ", params_str)
  }
  let ret = emit_rust_node_type(n: match rt_node(n: cap_node) { Some { value: rt } => rt  None => leaf_node(name: "Unit") }, rc_types: empty_map())
  concat("async fn ", rust_ident(name: cap_node.name), "(", all_params, ") -> Result<", ret, ", Box<dyn std::error::Error>>;")
}

// =========================================================================
// Data definition emission
//
// data name: Type = value  ->  pub const/lazy_static
//
// Simple scalar data -> const. Complex data (lists, maps, records) ->
// lazy_static or a function that returns the value.
// =========================================================================

fn emit_data_def(name: String, type_node: Node, value: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, vtoe: Map<String, String>, rc_types: Map<String, Bool>, emit_info: EmitGraphInfo) -> String {
  // Data defs use lazy_static (requires Sync) or serde (requires Deserialize),
  // so render types without Rc wrapping.
  let ty_str = emit_rust_node_type(n: type_node, rc_types: empty_map())
  let upper_name = to_screaming_snake(name: name)
  if is_simple_type_node(n: type_node) {
    let val_str = emit_typed_expr(texpr: value, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: empty_map(), emit_info: emit_info)
    concat("pub const ", upper_name, ": ", ty_str, " = ", val_str, ";")
  } else if has_nested_records_node(n: type_node) {
    // Complex data with nested anonymous records -> serde deserialization
    let json_str = emit_typed_data_value_json(value: value)
    concat("pub fn ", to_snake(name: name), "() -> ", ty_str, " {\n",
      "    serde_json::from_value(serde_json::json!(", json_str, "))\n",
      "        .expect(\"valid data definition\")\n",
      "}")
  } else if node_is_map(n: type_node) {
    // Map data: emit as lazy_static with explicit insert() calls.
    // The value is a RecordLit whose field names are map keys and field values are map values.
    match value.expr_data {
      ExprRecordLit { fields: fs, type_name: _, parent_enum: _ } =>
        let inserts = fs |> map(f =>
          let val_str = emit_typed_expr(texpr: f.value, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: empty_map(), emit_info: emit_info)
          concat("        __m.insert(\"", f.name, "\".to_string(), ", val_str, ");")
        )
        let inserts_str = inserts |> join(separator: "\n")
        concat("lazy_static::lazy_static! {\n",
          "    pub static ref ", upper_name, ": ", ty_str, " = {\n",
          "        let mut __m = BTreeMap::new();\n",
          inserts_str, "\n",
          "        __m\n",
          "    };\n",
          "}")
      _ =>
        let val_str = emit_typed_expr(texpr: value, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: empty_map(), emit_info: emit_info)
        concat("lazy_static::lazy_static! {\n",
          "    pub static ref ", upper_name, ": ", ty_str, " = ", val_str, ";\n",
          "}")
    }
  } else {
    // Complex types use lazy_static for heap-allocated values
    let val_str = emit_typed_expr(texpr: value, registry: registry, scope: scope, depth: depth, vtoe: vtoe, rc_types: empty_map(), emit_info: emit_info)
    concat("lazy_static::lazy_static! {\n",
      "    pub static ref ", upper_name, ": ", ty_str, " = ", val_str, ";\n",
      "}")
  }
}

fn is_simple_type_node(n: Node) -> Bool {
  is_int_type_node(n: n) || is_bool_type_node(n: n) || is_float_type_node(n: n)
}

// =========================================================================
// Test file emission
//
// For modules with service operations that have mock_response data,
// emit a test file with one test per mock.
// =========================================================================

fn emit_test_file(typed_module: TypedModule) -> TextFile {
  let depth = 0
  let m = typed_module.module
  let service_items = typed_module.items |> filter(item => is_service_item(item: item))
  let test_fns = service_items
    |> flat_map(item => emit_typed_service_tests(item: item, registry: empty_map(), depth: depth + 1))
  if test_fns |> count == 0 {
    TextFile { path: "", content: "" }
  } else {
    let filename = module_to_filename(name: m.name)
    let tests_str = test_fns |> join(separator: "\n\n")
    let content = concat("// Generated tests -- do not edit.\n",
      "// Source module: ", m.name, "\n\n",
      "#[cfg(test)]\nmod tests {\n",
      "    use super::*;\n\n",
      make_indent(level: depth + 1),tests_str, "\n",
      "}\n")
    TextFile { path: concat("tests/", filename, "_test.rs"), content: content }
  }
}

// is_service_item is now shared -- imported from v2.compiler.emit

fn emit_typed_service_tests(item: Node, registry: Map<String, ItemInfo>, depth: Int) -> List<String> {
  if item.children |> count > 0 {
    let safe_name = sanitize_service_name(name: item.name)
    // Mock data lives in properties with "mock_" prefix
    item.children
      |> filter(c => c.properties |> any(p => has_mock_prefix(name: p.name)))
      |> map(c => emit_operation_test(service_name: safe_name, op_node: c, registry: registry, depth: depth))
  } else {
    []
  }
}

fn emit_operation_test(service_name: String, op_node: Node, registry: Map<String, ItemInfo>, depth: Int) -> String {
  let test_name = concat("test_", to_snake(name: service_name), "_", to_snake(name: op_node.name))
  let mock_props = op_node.properties |> filter(p => has_mock_prefix(name: p.name))
  let mock_setup = mock_props |> map(mp =>
    emit_mock_prop_setup(mock_prop: mp, registry: registry, depth: depth + 1)
  )
  let mock_str = mock_setup |> join(separator: "\n")
  concat("#[tokio::test]\nasync fn ", test_name, "() {\n",
    make_indent(level: depth + 1),mock_str, "\n",
    make_indent(level: depth + 1),"// Mock-based test: verifies operation contract with fixture data.", "\n",
    "}")
}

fn emit_mock_prop_setup(mock_prop: FieldInit, registry: Map<String, ItemInfo>, depth: Int) -> String {
  let body_str = emit_simple_expr(expr: mock_prop.value)
  concat("let ", mock_prop.name, " = ", body_str, ";")
}

// =========================================================================
// Identifier conversion -- Rust target
// =========================================================================

// Convert a DSL identifier to a valid Rust identifier.
// Handles reserved word escaping with r# prefix.
fn rust_ident(name: String) -> String {
  if rust_reserved |> any(r => r == name) {
    concat("r#", name)
  } else {
    to_snake(name: name)
  }
}

// =========================================================================
// Cargo.toml emission
//
// Generates a minimal Cargo.toml for the emitted crate.
// =========================================================================

fn emit_cargo_toml(crate_name: String, has_services: Bool) -> TextFile {
  let header = concat("[package]\nname = \"", crate_name, "\"\nversion = \"0.1.0\"\nedition = \"2021\"\n")
  let deps = "\n[dependencies]\nserde = { version = \"1\", features = [\"derive\", \"rc\"] }\nserde_json = \"1\"\nstacker = \"0.1\"\n"
  let cli_dep = "clap = { version = \"4\", features = [\"derive\"] }\n"
  let async_deps = if has_services {
    "tokio = { version = \"1\", features = [\"full\"] }\nreqwest = { version = \"0.12\", features = [\"json\"] }\nasync-trait = \"0.1\"\n"
  } else {
    ""
  }
  let lazy_dep = "lazy_static = \"1\"\n"
  TextFile { path: "Cargo.toml", content: concat(header, deps, cli_dep, async_deps, lazy_dep) }
}

// has_service_items is now shared -- imported from v2.compiler.emit

// =========================================================================
// Workflow function collection
//
// A "workflow function" is a `func` item (has body, has `uses`).
// These become CLI subcommands in main.rs.
// =========================================================================

type WorkflowFunc {
  name: String
  module_name: String
  params: List<Param>
  return_type: Node
  uses: List<ResourceUse>
  service_names: List<String>
}

fn to_workflow_func(item: Node, module_name: String, registry: Map<String, ItemInfo>) -> WorkflowFunc {
  let svc_names = match lookup_item(registry: registry, name: item.name) {
    Some { value: info } => info.service_names
    None => []
  }
  WorkflowFunc {
    name: item.name,
    module_name: module_name,
    params: item.params,
    return_type: match rt_node(n: item) { Some { value: rt } => rt  None => leaf_node(name: "Unit") },
    uses: item.uses,
    service_names: svc_names
  }
}

fn collect_workflow_funcs(modules: List<TypedModule>, registry: Map<String, ItemInfo>) -> List<WorkflowFunc> {
  modules |> flat_map(tm =>
    tm.items
      |> filter(item => item.body != none && item.uses |> count > 0)
      |> map(item => to_workflow_func(item: item, module_name: tm.module.name, registry: registry))
  )
}

fn cli_default_literal_value(expr: Node) -> String? {
  match expr.expr_data {
    ExprLiteral { value: v } => match v {
      LitStr { value: s } => Some { value: s }
      LitInt { value: i } => Some { value: to_string(value: i) }
      LitFloat { value: f } => Some { value: f }
      LitBool { value: b } => Some { value: if b { "true" } else { "false" } }
      LitNull => none
    }
    _ => none
  }
}

fn validate_workflow_param_defaults(workflow_funcs: List<WorkflowFunc>) -> List<Diagnostic> {
  workflow_funcs |> flat_map(wf =>
    wf.params |> flat_map(param =>
      match param.default_value {
        Some { value: dv } => match cli_default_literal_value(expr: dv) {
          Some { value: _ } => []
          None => [Diagnostic {
            severity: Error,
            message: concat(
              "workflow CLI default for parameter `",
              param.name,
              "` must be a string, int, float, or bool literal"
            ),
            span: Some { value: param.span },
            module_name: Some { value: wf.module_name },
            category: none
          }]
        }
        None => []
      }
    )
  )
}

// =========================================================================
// main.rs generation
//
// Generates a CLI entry point using clap with one subcommand per workflow
// function. Each subcommand accepts the function's params as CLI args
// plus a --dry-run flag that replaces service calls with mock responses.
// =========================================================================

fn emit_main_rs(workflow_funcs: List<WorkflowFunc>, modules: List<TypedModule>, has_services: Bool) -> TextFile {
  let has_pipeline = modules |> any(m => m.module.name == "v2.compiler.compile")
  let header = concat(
    "// Generated by v2 compiler -- do not edit.\n\n",
    concat("use clap::", "{", "Parser, Subcommand", "}", ";\n")
  )
  let crate_use = if has_services {
    "use v2_compiled::dry_run::DryRunMode;\n"
  } else {
    ""
  }
  let mod_uses = emit_main_mod_uses(workflow_funcs: workflow_funcs, has_pipeline: has_pipeline)
  let cli_struct = emit_cli_struct(workflow_funcs: workflow_funcs)
  let subcommand_enum = emit_subcommand_enum(workflow_funcs: workflow_funcs, has_pipeline: has_pipeline)
  let main_fn = emit_main_fn(workflow_funcs: workflow_funcs, has_services: has_services, has_pipeline: has_pipeline)
  let content = concat(
    header, crate_use, mod_uses, "\n",
    cli_struct, "\n\n",
    subcommand_enum, "\n\n",
    main_fn, "\n"
  )
  TextFile { path: "src/main.rs", content: content }
}

// Emit `use crate::module_name;` for each module that contains a workflow function.
// When has_pipeline is true, also imports pipeline and core modules for the compile subcommand.
fn emit_main_mod_uses(workflow_funcs: List<WorkflowFunc>, has_pipeline: Bool) -> String {
  let mod_names = workflow_funcs |> map(wf => module_to_filename(name: wf.module_name))
  let unique_mods = unique_strings(items: mod_names)
  let use_lines = unique_mods |> map(m => concat("use v2_compiled::", m, ";"))
  let base = use_lines |> join(separator: "\n")
  if has_pipeline {
    let pipeline_mod = module_to_filename(name: "v2.compiler.compile")
    let artifact_mod = module_to_filename(name: "v2.compiler.artifact")
    concat(base, "\nuse std::rc::Rc;\nuse v2_compiled::", pipeline_mod, ";\nuse v2_compiled::", artifact_mod, ";\n")
  } else {
    base
  }
}

// Emit the top-level CLI struct with clap derives.
fn emit_cli_struct(workflow_funcs: List<WorkflowFunc>) -> String {
  concat(
    "#[derive(Parser)]\n",
    "#[command(name = \"v2-compiled\", about = \"Generated CLI from DAG compiler\")]\n",
    "struct Cli {\n",
    "    #[command(subcommand)]\n",
    "    command: Commands,\n",
    "    /// Run in dry-run mode (mock all service calls)\n",
    "    #[arg(long, global = true)]\n",
    "    dry_run: bool,\n",
    "}"
  )
}

// Emit the Commands enum with one variant per workflow function.
// When has_pipeline is true, adds a Compile variant for bootstrap.
fn emit_subcommand_enum(workflow_funcs: List<WorkflowFunc>, has_pipeline: Bool) -> String {
  let depth = 0
  let variants = workflow_funcs |> map(wf => emit_subcommand_variant(wf: wf, depth: depth + 1))
  let compile_variant = if has_pipeline {
    concat(
      "/// Compile .dag source files to a target language\n",
      make_indent(level: depth + 1), "Compile {\n",
      make_indent(level: depth + 2), "#[arg(long)]\n",
      make_indent(level: depth + 2), "source_dir: String,\n",
      make_indent(level: depth + 2), "#[arg(long)]\n",
      make_indent(level: depth + 2), "output_dir: String,\n",
      make_indent(level: depth + 2), "/// Target language: rust, python, go\n",
      make_indent(level: depth + 2), "#[arg(long, default_value = \"rust\")]\n",
      make_indent(level: depth + 2), "target: String,\n",
      make_indent(level: depth + 1), "},")
  } else { "" }
  let all_variants = if has_pipeline { concat(variants, [compile_variant]) } else { variants }
  let variants_str = all_variants |> join(separator: "\n")
  concat(
    "#[derive(Subcommand)]\n",
    "enum Commands {\n",
    make_indent(level: depth + 1),variants_str, "\n",
    "}"
  )
}

// Emit one enum variant for a workflow function.
// `func gist(public: Bool = false)` becomes:
// ```
// /// Run the gist workflow
// Gist {
//     #[arg(long)]
//     public: bool,
// },
// ```
fn emit_subcommand_variant(wf: WorkflowFunc, depth: Int) -> String {
  let variant_name = capitalize_first(s: wf.name)
  let doc_line = concat("/// Run the ", wf.name, " workflow")
  if wf.params |> count == 0 {
    concat(doc_line, "\n", variant_name, ",")
  } else {
    let fields = wf.params |> map(p => emit_subcommand_field(param: p))
    let fields_str = fields |> join(separator: "\n")
    concat(doc_line, "\n", variant_name, " {\n",
      make_indent(level: depth + 1),fields_str, "\n",
      "},")
  }
}

// Emit a struct field inside a subcommand variant, with clap attributes.
fn emit_subcommand_field(param: Param) -> String {
  let field_name = rust_ident(name: param.name)
  let field_type = emit_cli_param_type_node(n: param.type_expr)
  let default_attr = match param.default_value {
    // Invalid defaults are rejected before file emission; this path only renders
    // literals that already passed validation.
    Some { value: dv } => match cli_default_literal_value(expr: dv) {
      Some { value: default_value } =>
        concat("#[arg(long, default_value = \"", default_value, "\")]\n")
      None => "#[arg(long)]\n"
    }
    None => "#[arg(long)]\n"
  }
  concat(default_attr, field_name, ": ", field_type, ",")
}

// Map DSL types to Rust CLI types.
// Bool -> bool, String -> String, Int -> i64, etc.
// Optional types get wrapped in Option<>.
fn emit_cli_param_type_node(n: Node) -> String {
  if node_is_optional(n: n) {
    concat("Option<", emit_cli_param_type_node(n: with_required_cardinality(n: n)), ">")
  } else if (classify_type_structure(n: n) != TypeLeaf) {
    "String"
  } else if n.children |> count == 0 {
    if is_bool_type_node(n: n) { "bool" }
    else if is_int_type_node(n: n) { "i64" }
    else if is_float_type_node(n: n) { "f64" }
    else { "String" }
  } else {
    "String"
  }
}

// Emit the main function body.
// When has_pipeline is true, adds a Compile match arm for bootstrap.
fn emit_main_fn(workflow_funcs: List<WorkflowFunc>, has_services: Bool, has_pipeline: Bool) -> String {
  let depth = 0
  let async_attr = if has_services { "#[tokio::main]\nasync fn main() " } else { "fn main() " }
  let parse_line = "let cli = Cli::parse();"
  let dry_run_line = if has_services {
    "let dry_run = DryRunMode(cli.dry_run);"
  } else {
    ""
  }
  let match_arms = workflow_funcs |> map(wf => emit_main_match_arm(wf: wf, has_services: has_services))
  let compile_arm = if has_pipeline { emit_compile_match_arm() } else { "" }
  let all_arms = if has_pipeline { concat(match_arms, [compile_arm]) } else { match_arms }
  let arms_str = all_arms |> join(separator: "\n")
  let match_block = concat("match cli.command {\n", make_indent(level: depth + 2),arms_str, "\n    }")
  let result_handling = if has_services {
    concat(
      "let result = ", match_block, ";\n",
      "match result {\n",
      "    Ok(value) => {\n",
      "        let json = serde_json::to_string_pretty(&value).unwrap_or_else(|_| format!(\"{:?}\", value));\n",
      "        println!(\"{}\", json);\n",
      "    }\n",
      "    Err(e) => {\n",
      "        eprintln!(\"Error: {}\", e);\n",
      "        std::process::exit(1);\n",
      "    }\n",
      "}"
    )
  } else {
    concat("let _result = ", match_block, ";")
  }
  let body_lines = if dry_run_line == "" {
    concat(parse_line, "\n", result_handling)
  } else {
    concat(parse_line, "\n", dry_run_line, "\n", result_handling)
  }
  concat(async_attr, "{\n", make_indent(level: depth + 1),body_lines, "\n}")
}

// A5: Emit the Compile match arm for the bootstrap compile subcommand.
// Reads .dag files from disk, runs the pipeline, writes output files.
fn emit_compile_match_arm() -> String {
  let pipeline_mod = module_to_filename(name: "v2.compiler.compile")
  let artifact_mod = module_to_filename(name: "v2.compiler.artifact")
  concat(
    "Commands::Compile { source_dir, output_dir, target } => {\n",
    "            let render_target = match target.as_str() {\n",
    "                \"rust\" => ", artifact_mod, "::RenderTarget::Rust,\n",
    "                \"python\" => ", artifact_mod, "::RenderTarget::Python,\n",
    "                \"go\" => ", artifact_mod, "::RenderTarget::Go,\n",
    "                other => {\n",
    "                    eprintln!(\"unknown target: {}. supported: rust, python, go\", other);\n",
    "                    std::process::exit(1);\n",
    "                }\n",
    "            };\n",
    "            let mut sources: Vec<Rc<", pipeline_mod, "::SourceFile>> = Vec::new();\n",
    "            let mut entries: Vec<_> = std::fs::read_dir(&source_dir)\n",
    "                .unwrap_or_else(|e| panic!(\"failed to read source dir {}: {}\", source_dir, e))\n",
    "                .filter_map(|e| e.ok())\n",
    "                .collect();\n",
    "            entries.sort_by_key(|e| e.file_name());\n",
    "            for entry in entries {\n",
    "                let path = entry.path();\n",
    "                if path.extension().map(|e| e == \"dag\").unwrap_or(false) {\n",
    "                    let content = std::fs::read_to_string(&path)\n",
    "                        .unwrap_or_else(|e| panic!(\"failed to read {:?}: {}\", path, e));\n",
    "                    let filename = path.file_name().unwrap().to_string_lossy().to_string();\n",
    "                    sources.push(Rc::new(", pipeline_mod, "::SourceFile {\n",
    "                        path: filename,\n",
    "                        content,\n",
    "                    }));\n",
    "                }\n",
    "            }\n",
    "            eprintln!(\"compiling {} .dag files from {} (target: {})\", sources.len(), source_dir, target);\n",
    "            let result = ", pipeline_mod, "::compile_sources(\n",
    "                sources,\n",
    "                render_target,\n",
    "            );\n",
    "            std::fs::create_dir_all(format!(\"{}/src\", output_dir))\n",
    "                .unwrap_or_else(|e| panic!(\"failed to create output dir: {}\", e));\n",
    "            for file in result.files.iter() {\n",
    "                let out_path = format!(\"{}/{}\", output_dir, file.path);\n",
    "                if let Some(parent) = std::path::Path::new(&out_path).parent() {\n",
    "                    std::fs::create_dir_all(parent).ok();\n",
    "                }\n",
    "                std::fs::write(&out_path, &*file.content)\n",
    "                    .unwrap_or_else(|e| panic!(\"failed to write {}: {}\", file.path, e));\n",
    "            }\n",
    "            eprintln!(\"compiled: {} files emitted, {} diagnostics\",\n",
    "                result.files.len(), result.diagnostics.len());\n",
    "            for (i, d) in result.diagnostics.iter().take(20).enumerate() {\n",
    "                eprintln!(\"  [{}]: {:?}\", i, d);\n",
    "            }\n",
    "            if result.files.is_empty() {\n",
    "                eprintln!(\"error: no files emitted\");\n",
    "                std::process::exit(1);\n",
    "            }\n",
    "        },")
}

// Emit one match arm in the main function for a workflow function.
fn emit_main_match_arm(wf: WorkflowFunc, has_services: Bool) -> String {
  let variant_name = capitalize_first(s: wf.name)
  let mod_name = module_to_filename(name: wf.module_name)
  let fn_name = rust_ident(name: wf.name)
  let await_suffix = if has_services { ".await" } else { "" }
  if wf.params |> count == 0 {
    let service_args = emit_main_service_args(wf: wf, has_services: has_services)
    concat("Commands::", variant_name, " => ",
      mod_name, "::", fn_name, "(", service_args, ")", await_suffix, ",")
  } else {
    let field_binds = wf.params |> map(p => rust_ident(name: p.name))
    let binds_str = field_binds |> join(separator: ", ")
    let call_args = emit_main_call_args(wf: wf, has_services: has_services)
    concat("Commands::", variant_name, " { ", binds_str, " } => ",
      mod_name, "::", fn_name, "(", call_args, ")", await_suffix, ",")
  }
}

// Emit the argument list for calling a workflow function from main.
// Includes the function's params, then service instance args.
fn emit_main_call_args(wf: WorkflowFunc, has_services: Bool) -> String {
  let param_args = wf.params |> map(p =>
    let arg_name = rust_ident(name: p.name)
    if needs_reference_node(n: p.type_expr) {
      concat("&", arg_name)
    } else {
      arg_name
    }
  )
  let service_args = emit_main_service_arg_list(wf: wf, has_services: has_services)
  let all_args = concat(param_args, service_args)
  all_args |> join(separator: ", ")
}

// Emit service args only (no user params) for zero-param workflow functions.
fn emit_main_service_args(wf: WorkflowFunc, has_services: Bool) -> String {
  let service_args = emit_main_service_arg_list(wf: wf, has_services: has_services)
  service_args |> join(separator: ", ")
}

// Build the list of service instance arguments for a workflow call.
// Each service gets constructed with `::new(dry_run.clone())` or `::new()`.
fn emit_main_service_arg_list(wf: WorkflowFunc, has_services: Bool) -> List<String> {
  let resource_args = wf.uses |> map(u =>
    concat("&compile_error!(\"resource argument requires explicit initialization: ", u.name, "\")")
  )
  let svc_args = wf.service_names |> map(sn =>
    let struct_name = sanitize_service_name(name: sn)
    if has_services {
      concat("&", struct_name, "::new(dry_run.clone())")
    } else {
      concat("&", struct_name, "::new()")
    }
  )
  concat(resource_args, svc_args)
}

// =========================================================================
// Dry-run module emission
//
// Generates src/dry_run.rs with the DryRunMode type.
// Service structs check this flag to decide whether to perform real I/O
// or return mock data.
// =========================================================================

fn emit_dry_run_module() -> TextFile {
  let content = concat(
    "// Generated by v2 compiler -- do not edit.\n",
    "//\n",
    "// Dry-run support: when DryRunMode(true), service methods return\n",
    "// mock data instead of performing real I/O.\n\n",
    "#[derive(Debug, Clone)]\n",
    "pub struct DryRunMode(pub bool);\n\n",
    "impl DryRunMode {\n",
    "    pub fn is_dry_run(&self) -> bool {\n",
    "        self.0\n",
    "    }\n",
    "}\n\n",
    "impl Default for DryRunMode {\n",
    "    fn default() -> Self {\n",
    "        DryRunMode(false)\n",
    "    }\n",
    "}\n"
  )
  TextFile { path: "src/dry_run.rs", content: content }
}
