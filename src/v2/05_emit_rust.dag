// v2 Rust renderer — emits Rust source files from a typed module graph.
//
// This module contains all Rust-specific rendering logic: Rust syntax
// generation, Rust type mapping, Rust reserved word handling, serde
// derives, reqwest calls, etc.
//
// Target-agnostic helpers (scope management, item registry, name
// conversion, indent, service call collection) live in 05_emit.dag.
//
// Invariant 6: "DAG nodes are facts, rendering is separate."
// This file IS the Rust rendering. Swapping to a different target
// means using a different renderer — 05_emit_python.dag, etc. — with
// no changes to the IR or 05_emit.dag.

module v2.compiler.emit_rust

import v2.std.core {
  Import, ImportAll, ImportSpecific,
  Node, TypedNode,
  TypeExpr, TypeBody, Field, Variant, Param, Expr, MatchArm,
  MatchPattern, FieldBinding, LiteralValue, TransportBinding, OperationDef,
  TextFile, Diagnostic, SourceSpan,
  CapabilityDef,
  ContainerKind, ResourceUse,
  BinOpKind, NullCoalesce,
  UnaryOpKind, StringPart, NamedArg, FieldInit,
  ServiceConfig, AuthConfig, HeaderDef, EnvDef,
  MockResponseDef, OperationModifier,
  ForEach, Index, Slice,
  FuncSig
}

import v2.compiler.typecheck {
  TypedGraph, TypedModule,
  TypeEnv, FuncEnv, TypeBinding, InferScope,
  build_params_scope, extend_scope,
  normalize_access_type, for_each_element_type
}

import v2.compiler.emit {
  EmitResult, BlockEmitState, ItemInfo, InterpPart,
  empty_emit_scope, module_emit_scope,
  infer_expr_type, scope_after_expr,
  build_item_registry, lookup_item, named_arg_matches, order_call_args,
  is_service_call_receiver, extract_service_name,
  collect_service_calls, collect_service_calls_from_args, unique_strings,
  has_nested_records, emit_data_value_json, escape_json_string,
  module_to_filename,
  indent, make_indent, to_string, to_string_helper,
  to_snake, to_screaming_snake, is_upper, to_lower_char, to_upper_char,
  capitalize_first, sanitize_service_name, service_var_name,
  expr_has_self_call, has_non_tail_self_call
}

// =========================================================================
// Rust reserved words — identifiers that need escaping with r# prefix
// =========================================================================

data rust_reserved: List<String> = [
  "as", "async", "await", "break", "const", "continue", "crate",
  "dyn", "else", "enum", "extern", "false", "fn", "for", "if",
  "impl", "in", "let", "loop", "match", "mod", "move", "mut",
  "pub", "ref", "return", "self", "Self", "static", "struct",
  "super", "trait", "true", "type", "unsafe", "use", "where",
  "while", "yield", "abstract", "become", "box", "do", "final",
  "macro", "override", "priv", "try", "typeof", "unsized",
  "virtual"
]

// =========================================================================
// Entry point — Rust target
// =========================================================================

fn emit_rust(typed: TypedGraph) -> EmitResult {
  let all_items = typed.modules |> flat_map(tm => tm.items)
  let registry = build_item_registry(items: all_items)
  let module_files = typed.modules |> map(tm => emit_module(typed_module: tm, registry: registry))
  let test_files = typed.modules
    |> map(tm => emit_test_file(typed_module: tm))
    |> filter(f => f.content != "")
  let lib_file = emit_lib_rs(modules: typed.modules)
  let cargo = emit_cargo_toml(crate_name: "v2_compiled", has_services: has_service_items(typed: typed))
  let files = concat([cargo, lib_file], module_files, test_files)
  EmitResult { files: files, diagnostics: [] }
}

// =========================================================================
// lib.rs generation
// =========================================================================

fn emit_lib_rs(modules: List<TypedModule>) -> TextFile {
  let mod_decls = modules |> map(tm =>
    let mod_name = module_to_filename(name: tm.module.name)
    concat("pub mod ", mod_name, ";")
  )
  let content = concat("// Generated by v2 compiler — do not edit.\n\n", mod_decls |> join(separator: "\n"))
  TextFile { path: "src/lib.rs", content: concat(content, "\n") }
}

// =========================================================================
// Module emission
// =========================================================================

fn emit_module(typed_module: TypedModule, registry: Map<String, ItemInfo>) -> TextFile {
  let m = typed_module.module
  let scope = module_emit_scope(typed_module: typed_module)
  let prelude = emit_prelude()
  let imports_str = emit_imports(imports: m.imports)
  let imports_section = if imports_str == "" { "" } else { concat("\n", imports_str) }
  let items_str = typed_module.items
    |> map(item => emit_typed_item(item: item, registry: registry, scope: scope))
    |> join(separator: "\n\n")
  let filename = module_to_filename(name: m.name)
  let content = concat("// Generated by v2 compiler — do not edit.\n",
    "// Source module: ", m.name, "\n\n",
    prelude, imports_section, "\n\n",
    items_str, "\n")
  TextFile { path: concat("src/", filename, ".rs"), content: content }
}

// =========================================================================
// Import emission
// =========================================================================

fn emit_imports(imports: List<Import>) -> String {
  if imports |> count == 0 {
    ""
  } else {
    let import_lines = imports |> map(imp =>
      let mod_name = module_to_filename(name: imp.module_path)
      match imp.names {
        ImportAll => concat("use crate::", mod_name, "::*;")
        ImportSpecific { names: specific_names } =>
          if specific_names |> count == 0 {
            ""
          } else {
            let names_str = specific_names |> join(separator: ", ")
            concat("use crate::", mod_name, "::{", names_str, "};")
          }
      }
    )
    import_lines |> filter(line => line != "") |> join(separator: "\n")
  }
}

// =========================================================================
// Prelude
// =========================================================================

fn emit_prelude() -> String {
  let serde_import = concat("use serde::{", "Serialize, Deserialize};")
  let imports = concat("use std::collections::BTreeMap;\n", serde_import)
  concat(imports, "\n\n", emit_non_empty_wrappers())
}

// Emit newtype wrapper definitions for NonEmptyVec and NonEmptyBTreeSet.
// These validate non-emptiness at construction time.
fn emit_non_empty_wrappers() -> String {
  let vec_wrapper = concat(
    "#[derive(Debug, Clone, PartialEq, Serialize)]\n",
    "pub struct NonEmptyVec<T>(Vec<T>);\n\n",
    "impl<T> NonEmptyVec<T> {\n",
    "    pub fn new(items: Vec<T>) -> Result<Self, &'static str> {\n",
    "        if items.is_empty() {\n",
    "            Err(\"NonEmptyVec requires at least one element\")\n",
    "        } else {\n",
    "            Ok(Self(items))\n",
    "        }\n",
    "    }\n\n",
    "    pub fn as_slice(&self) -> &[T] {\n",
    "        &self.0\n",
    "    }\n\n",
    "    pub fn into_vec(self) -> Vec<T> {\n",
    "        self.0\n",
    "    }\n",
    "}\n\n",
    "impl<'de, T> Deserialize<'de> for NonEmptyVec<T>\n",
    "where\n",
    "    T: Deserialize<'de>,\n",
    "{\n",
    "    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>\n",
    "    where\n",
    "        D: serde::Deserializer<'de>,\n",
    "    {\n",
    "        let items = Vec::<T>::deserialize(deserializer)?;\n",
    "        NonEmptyVec::new(items).map_err(serde::de::Error::custom)\n",
    "    }\n",
    "}"
  )
  let set_wrapper = concat(
    "#[derive(Debug, Clone, PartialEq, Serialize)]\n",
    "pub struct NonEmptyBTreeSet<T: Ord>(std::collections::BTreeSet<T>);\n\n",
    "impl<T: Ord> NonEmptyBTreeSet<T> {\n",
    "    pub fn new(items: std::collections::BTreeSet<T>) -> Result<Self, &'static str> {\n",
    "        if items.is_empty() {\n",
    "            Err(\"NonEmptyBTreeSet requires at least one element\")\n",
    "        } else {\n",
    "            Ok(Self(items))\n",
    "        }\n",
    "    }\n\n",
    "    pub fn as_set(&self) -> &std::collections::BTreeSet<T> {\n",
    "        &self.0\n",
    "    }\n\n",
    "    pub fn into_set(self) -> std::collections::BTreeSet<T> {\n",
    "        self.0\n",
    "    }\n",
    "}\n\n",
    "impl<'de, T> Deserialize<'de> for NonEmptyBTreeSet<T>\n",
    "where\n",
    "    T: Ord + Deserialize<'de>,\n",
    "{\n",
    "    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>\n",
    "    where\n",
    "        D: serde::Deserializer<'de>,\n",
    "    {\n",
    "        let items = std::collections::BTreeSet::<T>::deserialize(deserializer)?;\n",
    "        NonEmptyBTreeSet::new(items).map_err(serde::de::Error::custom)\n",
    "    }\n",
    "}"
  )
  concat(vec_wrapper, "\n\n", set_wrapper)
}

// =========================================================================
// Item dispatch
// =========================================================================

fn emit_typed_item(item: TypedNode, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  // Type definition: has shape
  if item.shape != none {
    emit_type_def(name: item.name, body: item.shape.value)
  }
  // Function with body: fn or func (distinguished from data by type_annotation)
  else if item.body != none && item.type_annotation == none {
    if item.uses |> count > 0 {
      // async func/pattern
      emit_func_def(name: item.name, params: item.params, return_type: item.return_type, uses: item.uses, body: item.body.value.expr, registry: registry, scope: scope)
    } else {
      // pure fn (including zero-param functions)
      emit_fn_def(name: item.name, params: item.params, return_type: item.return_type, body: item.body.value.expr, registry: registry, scope: scope)
    }
  }
  // Data: has body and type_annotation (data constant)
  else if item.body != none && item.type_annotation != none {
    emit_data_def(name: item.name, type_expr: item.type_annotation.value, value: item.body.value.expr, registry: registry, scope: scope)
  }
  // Service: has operations
  else if item.operations |> count > 0 {
    let svc_transport = if item.transport == none { LocalBinding } else { item.transport.value }
    emit_service_def(name: item.name, transport: svc_transport, config: item.config, operations: item.operations, registry: registry)
  }
  // Resource: has capabilities
  else if item.capabilities |> count > 0 {
    emit_resource_def(name: item.name, capabilities: item.capabilities)
  }
  // Extern func: has params but no body
  else if item.params |> count > 0 {
    let params_str = emit_params(params: item.params)
    let ret_str = emit_return_type(return_type: item.return_type)
    concat("pub fn ", rust_ident(name: item.name), "(", params_str, ")", ret_str, " { todo!(\"extern func\") }")
  }
  else {
    concat("// unhandled node: ", item.name)
  }
}

// =========================================================================
// Type definitions
// =========================================================================

fn emit_type_def(name: String, body: TypeBody) -> String {
  match body {
    Record { fields: fs } => emit_struct_def(name: name, fields: fs)
    Sum { variants: vs } => emit_enum_def(name: name, variants: vs)
    Alias { base: te } => emit_type_alias(name: name, base: te)
  }
}

fn emit_struct_def(name: String, fields: List<Field>) -> String {
  let derives = "#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]"
  let field_lines = fields |> map(f => emit_struct_field(field: f))
  let fields_str = field_lines |> join(separator: "\n")
  if fields |> count == 0 {
    concat(derives, "\npub struct ", name, ";")
  } else {
    concat(derives, "\npub struct ", name, " {\n", fields_str, "\n}")
  }
}

fn emit_struct_field(field: Field) -> String {
  let ty = if field.optional {
    concat("Option<", emit_type_expr(type_expr: field.type_expr), ">")
  } else {
    emit_type_expr(type_expr: field.type_expr)
  }
  let rename_attr = match field.from_key {
    Some { value: key } => concat("    #[serde(rename = \"", key, "\")]\n")
    None => ""
  }
  let default_doc = match field.default_value {
    Some { value: expr } => concat("    /// Default: ", emit_expr(expr: expr, registry: empty_map()), "\n")
    None => ""
  }
  concat(rename_attr, default_doc, "    pub ", rust_ident(name: field.name), ": ", ty, ",")
}

fn emit_enum_def(name: String, variants: List<Variant>) -> String {
  let derives = "#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]"
  let serde_tag = "#[serde(tag = \"_variant\")]"
  let variant_lines = variants |> map(v => emit_variant(variant: v))
  let variants_str = variant_lines |> join(separator: "\n")
  concat(derives, "\n", serde_tag, "\npub enum ", name, " {\n", variants_str, "\n}")
}

fn emit_variant(variant: Variant) -> String {
  if variant.fields |> count == 0 {
    concat("    ", variant.name, ",")
  } else {
    let field_lines = variant.fields |> map(f =>
      concat("        ", rust_ident(name: f.name), ": ", emit_field_type(field: f), ",")
    )
    let fields_str = field_lines |> join(separator: "\n")
    concat("    ", variant.name, " {\n", fields_str, "\n    },")
  }
}

fn emit_field_type(field: Field) -> String {
  if field.optional {
    concat("Option<", emit_type_expr(type_expr: field.type_expr), ">")
  } else {
    emit_type_expr(type_expr: field.type_expr)
  }
}

fn emit_type_alias(name: String, base: TypeExpr) -> String {
  concat("pub type ", name, " = ", emit_type_expr(type_expr: base), ";")
}

// =========================================================================
// Type expression emission
// =========================================================================

fn emit_type_expr(type_expr: TypeExpr) -> String {
  match type_expr {
    Primitive { name: n, span: _ } => emit_primitive_type(name: n)
    Named { name: n, span: _ } => n
    Container { kind: k, element: el, span: _ } =>
      emit_container_type(kind: k, element: el)
    Optional { inner: inn, span: _ } =>
      concat("Option<", emit_type_expr(type_expr: inn), ">")
    MapType { key: k, value: v, span: _ } =>
      concat("BTreeMap<", emit_type_expr(type_expr: k), ", ", emit_type_expr(type_expr: v), ">")
    Product { name: pn, fields: fs, span: _ } =>
      emit_product_type_expr(name: pn, fields: fs)
    Coproduct { name: cn, variants: vs, span: _ } =>
      emit_coproduct_type_expr(name: cn, variants: vs)
    Refined { base: b, predicates: _, span: _ } =>
      // Refinements are erased at the Rust level — just emit the base type
      emit_type_expr(type_expr: b)
  }
}

fn emit_primitive_type(name: String) -> String {
  if name == "String" { "String" }
  else if name == "Int" { "i64" }
  else if name == "Bool" { "bool" }
  else if name == "Float" { "f64" }
  else if name == "Secret" { "String" }
  else if name == "Json" { "serde_json::Value" }
  else if name == "Unit" { "()" }
  else if name == "Bytes" { "Vec<u8>" }
  else { name }
}

fn emit_container_type(kind: ContainerKind, element: TypeExpr) -> String {
  let inner = emit_type_expr(type_expr: element)
  match kind {
    List => concat("Vec<", inner, ">")
    Set => concat("std::collections::BTreeSet<", inner, ">")
    NonEmptyList => concat("NonEmptyVec<", inner, ">")
    NonEmptySet => concat("NonEmptyBTreeSet<", inner, ">")
  }
}

fn emit_product_type_expr(name: String?, fields: List<Field>) -> String {
  match name {
    Some { value: n } => n
    None => {
      // Anonymous product — no named Rust type exists.
      if fields |> count == 1 {
        // Single-field anonymous record -> emit as the field type directly
        match fields |> first {
          Some { value: f } => emit_type_expr(type_expr: f.type_expr)
          // Unreachable: count == 1 guarantees first succeeds.
          // Emit compile_error! so Rust rejects instead of silently fabricating.
          None => "compile_error!(\"anonymous product with count==1 but no first field — type system bug\")"
        }
      } else {
        // Multi-field anonymous record without a name means the type system
        // failed to name this product upstream. Emit compile_error! so the
        // generated Rust rejects rather than silently using a bag type.
        "compile_error!(\"anonymous multi-field product reached emitter — type system must name all multi-field records\")"
      }
    }
  }
}

fn emit_coproduct_type_expr(name: String?, variants: List<Variant>) -> String {
  match name {
    Some { value: n } => n
    None => {
      // Anonymous coproduct without a name means the type system failed to
      // name this coproduct upstream. Emit compile_error! so the generated
      // Rust rejects rather than silently using a bag type.
      "compile_error!(\"anonymous coproduct reached emitter — type system must name all coproducts\")"
    }
  }
}

// =========================================================================
// Pure function (fn) emission
// =========================================================================

fn emit_fn_def(name: String, params: List<Param>, return_type: TypeExpr, body: Expr, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let params_str = emit_params(params: params)
  let ret_str = emit_return_type(return_type: return_type)
  let body_scope = build_params_scope(scope: scope, params: params)
  // Tail-call optimization: use cached analysis from item registry.
  let use_tco = match lookup_item(registry: registry, name: name) {
    Some { value: info } => info.is_self_recursive && info.has_non_tail_self_call == false
    None => expr_has_self_call(expr: body, fn_name: name)
      && has_non_tail_self_call(expr: body, fn_name: name, in_tail: true) == false
  }
  if use_tco {
    let tco_params_str = emit_tco_params(params: params)
    let body_str = emit_tco_body(expr: body, fn_name: name, params: params, registry: registry, scope: body_scope)
    concat("pub fn ", rust_ident(name: name), "(", tco_params_str, ")", ret_str, " {\n",
      indent(text: body_str, level: 1), "\n}")
  } else {
    let body_str = emit_expr_in_scope(expr: body, registry: registry, scope: body_scope)
    concat("pub fn ", rust_ident(name: name), "(", params_str, ")", ret_str, " {\n",
      indent(text: body_str, level: 1), "\n}")
  }
}

// =========================================================================
// Workflow function (func) emission
// =========================================================================

fn emit_func_def(
  name: String,
  params: List<Param>,
  return_type: TypeExpr,
  uses: List<ResourceUse>,
  body: Expr,
  registry: Map<String, ItemInfo>,
  scope: InferScope
) -> String {
  let service_names = match lookup_item(registry: registry, name: name) {
    Some { value: info } => info.service_names
    None => unique_strings(items: collect_service_calls(expr: body))
  }
  let params_str = emit_func_params(params: params, uses: uses, service_names: service_names)
  let ret_str = emit_func_return_type(return_type: return_type)
  let body_scope = build_params_scope(scope: scope, params: params)
  let body_str = emit_func_body(body: body, registry: registry, scope: body_scope)
  concat("pub async fn ", rust_ident(name: name),
    "(", params_str, ")", ret_str, " {\n",
    indent(text: body_str, level: 1), "\n}")
}

// Emit a func body, wrapping the tail expression in Ok(...).
// For let-chains the leading bindings are emitted as statements,
// and only the final expression is wrapped.
fn emit_func_body(body: Expr, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  match body {
    Let { name: n, value: v, body: inner, span: _ } => {
      let val_str = emit_expr_in_scope(expr: v, registry: registry, scope: scope)
      let let_line = concat("let ", rust_ident(name: n), " = ", val_str, ";")
      let next_scope = extend_scope(scope: scope, name: n, resolved: infer_expr_type(expr: v, scope: scope))
      match inner {
        Some { value: bd } =>
          concat(let_line, "\n", emit_func_body(body: bd, registry: registry, scope: next_scope))
        None => let_line
      }
    }
    Block { stmts: ss, span: _ } => {
      if ss |> count == 0 {
        "Ok(())"
      } else {
        let init_state = ss |> enumerate
          |> filter(p => p.first < (ss |> count) - 1)
          |> fold(init: BlockEmitState { text: "", scope: scope }, f: fn(acc, pair) {
            let line = emit_expr_in_scope(expr: pair.second, registry: registry, scope: acc.scope)
            let next_scope = scope_after_expr(expr: pair.second, scope: acc.scope)
            let new_text = if acc.text == "" { line } else { concat(acc.text, "\n", line) }
            BlockEmitState { text: new_text, scope: next_scope }
          })
        let last_stmt = ss |> last
        let last_str = match last_stmt {
          Some { value: s } => concat("Ok(", emit_expr_in_scope(expr: s, registry: registry, scope: init_state.scope), ")")
          None => "Ok(())"
        }
        if init_state.text == "" { last_str } else { concat(init_state.text, "\n", last_str) }
      }
    }
    _ => concat("Ok(", emit_expr_in_scope(expr: body, registry: registry, scope: scope), ")")
  }
}

// =========================================================================
// Tail-Call Optimization (TCO) — Rust rendering
//
// When a pure fn body contains self-recursive calls and every self-call
// is in tail position, we transform the emitted code from direct recursion
// to a loop+reassignment pattern:
//
//   pub fn f(mut x: T, mut y: U) -> R {
//       loop {
//           // ... original body ...
//           // tail call f(a, b) becomes:
//           //   { let __tco_0 = a; let __tco_1 = b; x = __tco_0; y = __tco_1; continue; }
//           // non-recursive return becomes: break result;
//       }
//   }
//
// Classification (expr_has_self_call, all_self_calls_are_tail) is shared
// and lives in 05_emit.dag. Only the Rust-specific rendering is here.
// =========================================================================

// Emit parameters with `mut` prefix for TCO-eligible functions.
fn emit_tco_params(params: List<Param>) -> String {
  let strs = params |> map(p => emit_tco_param(param: p))
  strs |> join(separator: ", ")
}

fn emit_tco_param(param: Param) -> String {
  let ty = emit_type_expr(type_expr: param.type_expr)
  let ref_ty = if needs_reference(type_expr: param.type_expr) {
    concat("&", ty)
  } else {
    ty
  }
  concat("mut ", rust_ident(name: param.name), ": ", ref_ty)
}

// Emit the TCO-transformed body: wrap in loop { ... }.
fn emit_tco_body(expr: Expr, fn_name: String, params: List<Param>, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let inner = emit_tco_expr(expr: expr, fn_name: fn_name, params: params, registry: registry, scope: scope)
  concat("loop {\n", indent(text: inner, level: 1), "\n}")
}

// Emit an expression in TCO context: tail calls become reassignment+continue,
// non-recursive results become break.
fn emit_tco_expr(expr: Expr, fn_name: String, params: List<Param>, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  match expr {
    Call { func: f, args: a, span: _ } =>
      if f == fn_name {
        // Tail self-call: emit temporaries, reassign params, continue.
        emit_tco_reassign(args: a, params: params, registry: registry, scope: scope)
      } else {
        // Non-self call in tail position: break with result.
        let call_str = emit_call(func: f, args: a, registry: registry, scope: scope)
        concat("break ", call_str, ";")
      }
    If { condition: c, then_branch: t, else_branch: e, span: _ } =>
      let cond_str = emit_expr_in_scope(expr: c, registry: registry, scope: scope)
      let then_str = emit_tco_expr(expr: t, fn_name: fn_name, params: params, registry: registry, scope: scope)
      match e {
        Some { value: eb } =>
          let else_str = emit_tco_expr(expr: eb, fn_name: fn_name, params: params, registry: registry, scope: scope)
          concat("if ", cond_str, " {\n",
            indent(text: then_str, level: 1), "\n} else {\n",
            indent(text: else_str, level: 1), "\n}")
        None =>
          concat("if ", cond_str, " {\n",
            indent(text: then_str, level: 1), "\n}")
      }
    Match { scrutinee: s, arms: arm_list, span: _ } =>
      let scrut_str = emit_expr_in_scope(expr: s, registry: registry, scope: scope)
      let arm_strs = arm_list |> map(arm =>
        emit_tco_match_arm(arm: arm, fn_name: fn_name, params: params, registry: registry, scope: scope))
      let arms_str = arm_strs |> join(separator: "\n")
      concat("match ", scrut_str, " {\n", arms_str, "\n}")
    Let { name: n, value: v, body: bd, span: _ } =>
      let val_str = emit_expr_in_scope(expr: v, registry: registry, scope: scope)
      let let_line = concat("let ", rust_ident(name: n), " = ", val_str, ";")
      let next_scope = extend_scope(scope: scope, name: n, resolved: infer_expr_type(expr: v, scope: scope))
      match bd {
        Some { value: b } =>
          concat(let_line, "\n", emit_tco_expr(expr: b, fn_name: fn_name, params: params, registry: registry, scope: next_scope))
        None => let_line
      }
    Block { stmts: ss, span: _ } =>
      if ss |> count == 0 {
        "break;"
      } else {
        let init_state = ss |> enumerate
          |> filter(p => p.first < (ss |> count) - 1)
          |> fold(init: BlockEmitState { text: "", scope: scope }, f: fn(acc, pair) {
            let line = emit_expr_in_scope(expr: pair.second, registry: registry, scope: acc.scope)
            let next_scope = scope_after_expr(expr: pair.second, scope: acc.scope)
            let new_text = if acc.text == "" { line } else { concat(acc.text, "\n", line) }
            BlockEmitState { text: new_text, scope: next_scope }
          })
        let last_str = match ss |> last {
          Some { value: last_expr } =>
            emit_tco_expr(expr: last_expr, fn_name: fn_name, params: params, registry: registry, scope: init_state.scope)
          None => "break;"
        }
        if init_state.text == "" { last_str } else { concat(init_state.text, "\n", last_str) }
      }
    // Any other expression in tail position: not a self-call, so break.
    _ =>
      let val_str = emit_expr_in_scope(expr: expr, registry: registry, scope: scope)
      concat("break ", val_str, ";")
  }
}

fn emit_tco_match_arm(arm: MatchArm, fn_name: String, params: List<Param>, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let pat_str = emit_pattern(pattern: arm.pattern)
  let guard_str = match arm.guard {
    Some { value: g } => concat(" if ", emit_expr_in_scope(expr: g, registry: registry, scope: scope))
    None => ""
  }
  let body_str = emit_tco_expr(expr: arm.body, fn_name: fn_name, params: params, registry: registry, scope: scope)
  concat("    ", pat_str, guard_str, " => { ", body_str, " },")
}

// Emit the reassignment block for a tail self-call:
//   { let __tco_0 = arg0; let __tco_1 = arg1; param0 = __tco_0; param1 = __tco_1; continue; }
// Temporaries prevent order-dependent assignment issues (e.g., f(b, a)).
fn emit_tco_reassign(args: List<NamedArg>, params: List<Param>, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let ordered_args = args |> map(a => emit_expr_in_scope(expr: a.value, registry: registry, scope: scope))
  let param_names = params |> map(p => rust_ident(name: p.name))
  let temp_lets = ordered_args |> enumerate |> map(pair =>
    concat("let __tco_", to_string(value: pair.first), " = ", pair.second, ";"))
  let assigns = param_names |> enumerate |> map(pair =>
    concat(pair.second, " = __tco_", to_string(value: pair.first), ";"))
  let all_lines = concat(temp_lets, assigns, ["continue;"])
  concat("{\n", indent(text: all_lines |> join(separator: "\n"), level: 1), "\n}")
}

fn emit_func_params(params: List<Param>, uses: List<ResourceUse>, service_names: List<String>) -> String {
  let param_strs = params |> map(p => emit_param(param: p))
  let resource_strs = uses |> map(u =>
    concat(rust_ident(name: u.name), ": &", emit_type_expr(type_expr: u.resource))
  )
  let service_strs = service_names |> map(sn =>
    concat(service_var_name(service_name: sn), ": &", sanitize_service_name(name: sn))
  )
  let all_params = concat(param_strs, resource_strs, service_strs)
  all_params |> join(separator: ", ")
}

fn emit_func_return_type(return_type: TypeExpr) -> String {
  concat(" -> Result<", emit_type_expr(type_expr: return_type), ", Box<dyn std::error::Error>>")
}

// =========================================================================
// Parameter emission
// =========================================================================

fn emit_params(params: List<Param>) -> String {
  let strs = params |> map(p => emit_param(param: p))
  strs |> join(separator: ", ")
}

fn emit_param(param: Param) -> String {
  let ty = emit_type_expr(type_expr: param.type_expr)
  let ref_ty = if needs_reference(type_expr: param.type_expr) {
    concat("&", ty)
  } else {
    ty
  }
  concat(rust_ident(name: param.name), ": ", ref_ty)
}

fn emit_return_type(return_type: TypeExpr) -> String {
  concat(" -> ", emit_type_expr(type_expr: return_type))
}

// Determine if a type should be passed by reference.
// Primitives like i64, bool, f64, () are Copy — pass by value.
// Everything else (String, Vec, BTreeMap, structs) — pass by reference.
fn needs_reference(type_expr: TypeExpr) -> Bool {
  match type_expr {
    Primitive { name: n, span: _ } =>
      if n == "Int" { false }
      else if n == "Bool" { false }
      else if n == "Float" { false }
      else if n == "Unit" { false }
      else { true }
    _ => true
  }
}

// =========================================================================
// Expression emission
// =========================================================================

fn emit_expr(expr: Expr, registry: Map<String, ItemInfo>) -> String {
  emit_expr_in_scope(expr: expr, registry: registry, scope: empty_emit_scope())
}

fn emit_expr_in_scope(expr: Expr, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  match expr {
    Literal { value: v, span: _ } => emit_literal(value: v)
    Var { name: n, span: _ } => rust_ident(name: n)
    FieldAccess { base: b, field: f, span: _ } =>
      concat(emit_expr_in_scope(expr: b, registry: registry, scope: scope), ".", rust_ident(name: f))
    Call { func: f, args: a, span: _ } =>
      emit_call(func: f, args: a, registry: registry, scope: scope)
    MethodCall { receiver: r, method: m, args: a, span: _ } =>
      emit_method_call(receiver: r, method: m, args: a, registry: registry, scope: scope)
    Match { scrutinee: s, arms: arm_list, span: _ } =>
      emit_match(scrutinee: s, arms: arm_list, registry: registry, scope: scope)
    If { condition: c, then_branch: t, else_branch: e, span: _ } =>
      emit_if(condition: c, then_branch: t, else_branch: e, registry: registry, scope: scope)
    Let { name: n, value: v, body: bd, span: _ } =>
      emit_let(name: n, value: v, body: bd, registry: registry, scope: scope)
    RecordLit { type_name: tn, fields: fs, span: span } =>
      emit_record_lit(type_name: tn, fields: fs, span: span, registry: registry, scope: scope)
    ListLit { elements: els, span: _ } =>
      emit_list_lit(elements: els, registry: registry, scope: scope)
    BinOp { op: o, left: l, right: r, span: _ } =>
      emit_bin_op(op: o, left: l, right: r, registry: registry, scope: scope)
    UnaryOp { op: o, operand: e, span: _ } =>
      emit_unary_op(op: o, operand: e, registry: registry, scope: scope)
    Lambda { params: ps, body: bd, span: _ } =>
      emit_lambda(params: ps, body: bd, registry: registry, scope: scope)
    StringInterp { parts: ps, span: _ } =>
      emit_string_interp(parts: ps, registry: registry, scope: scope)
    Block { stmts: ss, span: _ } =>
      emit_block(stmts: ss, registry: registry, scope: scope)
    Cast { expr: e, target: t, span: _ } =>
      emit_cast(expr: e, target: t, registry: registry, scope: scope)
    ForEach { variable: v, collection: c, body: bd, span: _ } =>
      emit_for_each(variable: v, collection: c, body: bd, registry: registry, scope: scope)
    Index { base: b, index: i, span: _ } =>
      emit_index(base: b, index: i, registry: registry, scope: scope)
    Slice { base: b, start: s, end: e, span: _ } =>
      emit_slice(base: b, start: s, end: e, registry: registry, scope: scope)
  }
}

// =========================================================================
// Literal emission
// =========================================================================

fn emit_literal(value: LiteralValue) -> String {
  match value {
    LitStr { value: s } => emit_string_literal(s: s)
    LitInt { value: i } => to_string(value: i)
    LitFloat { value: f } => f
    LitBool { value: b } =>
      if b { "true" } else { "false" }
    LitNull => "None"
  }
}

fn emit_string_literal(s: String) -> String {
  // Escape backslashes and double quotes within the string
  let escaped = s
    |> split(delimiter: "\\") |> join(separator: "\\\\")
  let escaped2 = escaped
    |> split(delimiter: "\"") |> join(separator: "\\\"")
  concat("\"", escaped2, "\".to_string()")
}

// =========================================================================
// Call emission
// =========================================================================

fn emit_call(func: String, args: List<NamedArg>, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let ordered_args = order_call_args(args: args, func: func, scope: scope)
  let arg_strs = ordered_args |> map(a => emit_call_arg(arg: a, registry: registry, scope: scope))
  let callee = lookup_item(registry: registry, name: func)
  let extra_args = match callee {
    Some { value: info } =>
      if info.kind == "func" {
        info.service_names |> map(sn => service_var_name(service_name: sn))
      } else { [] }
    None => []
  }
  let all_args = concat(arg_strs, extra_args)
  let args_str = all_args |> join(separator: ", ")
  let call_str = concat(rust_ident(name: func), "(", args_str, ")")
  match callee {
    Some { value: info } =>
      if info.kind == "func" { concat(call_str, ".await?") } else { call_str }
    None => call_str
  }
}

// Emit a for-each loop from the ForEach AST node.
// Produces a Rust statement-level for loop (side effects, no return value).
fn emit_for_each(variable: String, collection: Expr, body: Expr, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let coll_str = emit_expr_in_scope(expr: collection, registry: registry, scope: scope)
  let elem_type = for_each_element_type(type_expr: infer_expr_type(expr: collection, scope: scope))
  let body_scope = extend_scope(scope: scope, name: variable, resolved: elem_type)
  let body_str = emit_expr_in_scope(expr: body, registry: registry, scope: body_scope)
  concat("for ", rust_ident(name: variable), " in ", coll_str, ".into_iter() {\n",
    indent(text: body_str, level: 1), ";\n}")
}

// Emit Index expression using the inferred base type.
fn emit_index(base: Expr, index: Expr, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let base_str = emit_expr_in_scope(expr: base, registry: registry, scope: scope)
  let index_str = emit_expr_in_scope(expr: index, registry: registry, scope: scope)
  let base_type = normalize_access_type(type_expr: infer_expr_type(expr: base, scope: scope))
  match base_type {
    Primitive { name: name, span: _ } =>
      if name == "String" {
        concat("v2_rt::char_at(&", base_str, ", ", index_str, ")")
      } else {
        "panic!(\"internal error: unsupported index base in emitter\")"
      }
    MapType { key: _, value: _, span: _ } =>
      concat("(", base_str, ").get(&", index_str, ").cloned()")
    _ =>
      "panic!(\"internal error: unsupported index base in emitter\")"
  }
}

// Emit Slice expression using the inferred base type.
fn emit_slice(base: Expr, start: Expr, end: Expr, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let base_str = emit_expr_in_scope(expr: base, registry: registry, scope: scope)
  let start_str = emit_expr_in_scope(expr: start, registry: registry, scope: scope)
  let end_str = emit_expr_in_scope(expr: end, registry: registry, scope: scope)
  let base_type = normalize_access_type(type_expr: infer_expr_type(expr: base, scope: scope))
  match base_type {
    Primitive { name: name, span: _ } =>
      if name == "String" {
        concat("v2_rt::substring(&", base_str, ", ", start_str, ", ", end_str, ")")
      } else {
        "panic!(\"internal error: unsupported slice base in emitter\")"
      }
    _ =>
      "panic!(\"internal error: unsupported slice base in emitter\")"
  }
}

fn emit_call_arg(arg: NamedArg, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  emit_expr_in_scope(expr: arg.value, registry: registry, scope: scope)
}

fn emit_method_call(receiver: Expr, method: String, args: List<NamedArg>, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  // Service call: git.Core.CurrentBranch() -> git_core.current_branch().await?
  if is_service_call_receiver(receiver: receiver) {
    match extract_service_name(receiver: receiver) {
      Some { value: svc_name } => {
        let var_name = service_var_name(service_name: svc_name)
        let arg_strs = args |> map(a => emit_call_arg(arg: a, registry: registry, scope: scope))
        let args_str = arg_strs |> join(separator: ", ")
        concat(var_name, ".", rust_ident(name: method), "(", args_str, ").await?")
      }
      None =>
        "todo!(\"unsupported service receiver\")"
    }
  } else {
    let recv_str = emit_expr_in_scope(expr: receiver, registry: registry, scope: scope)
    let first_arg_str = emit_first_arg(args: args, registry: registry, scope: scope)
    // Map known DSL pipe methods to Rust equivalents
    if method == "count" {
      concat(recv_str, ".len()")
    } else if method == "join" {
      concat(recv_str, ".join(&", first_arg_str, ")")
    } else if method == "split" {
      concat(recv_str, ".split(&", first_arg_str, ").map(|s| s.to_string()).collect::<Vec<_>>()")
    } else if method == "last" {
      concat(recv_str, ".last().cloned()")
    } else if method == "first" {
      concat(recv_str, ".first().cloned()")
    } else if method == "enumerate" {
      concat(recv_str, ".iter().enumerate().map(|(i, v)| (i, v.clone())).collect::<Vec<_>>()")
    } else if method == "chars" {
      concat(recv_str, ".chars().map(|c| c.to_string()).collect::<Vec<_>>()")
    } else {
      // Generic method call
      let arg_strs = args |> map(a => emit_call_arg(arg: a, registry: registry, scope: scope))
      let args_str = arg_strs |> join(separator: ", ")
      concat(recv_str, ".", rust_ident(name: method), "(", args_str, ")")
    }
  }
}

// Extract and emit the first argument from a named arg list, or empty string if no args.
fn emit_first_arg(args: List<NamedArg>, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  match args |> first {
    Some { value: a } => emit_call_arg(arg: a, registry: registry, scope: scope)
    None => "todo!(\"missing method argument\")"
  }
}

// =========================================================================
// Match emission
// =========================================================================

fn emit_match(scrutinee: Expr, arms: List<MatchArm>, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let scrut_str = emit_expr_in_scope(expr: scrutinee, registry: registry, scope: scope)
  let arm_strs = arms |> map(arm => emit_match_arm(arm: arm, registry: registry, scope: scope))
  let arms_str = arm_strs |> join(separator: "\n")
  concat("match ", scrut_str, " {\n", arms_str, "\n}")
}

fn emit_match_arm(arm: MatchArm, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let pat_str = emit_pattern(pattern: arm.pattern)
  let guard_str = match arm.guard {
    Some { value: g } => concat(" if ", emit_expr_in_scope(expr: g, registry: registry, scope: scope))
    None => ""
  }
  let body_str = emit_expr_in_scope(expr: arm.body, registry: registry, scope: scope)
  concat("    ", pat_str, guard_str, " => ", body_str, ",")
}

fn emit_pattern(pattern: MatchPattern) -> String {
  match pattern {
    Bind { name: n } => rust_ident(name: n)
    LitPattern { value: v } => emit_literal(value: v)
    VariantPattern { name: n, field_bindings: fbs } =>
      emit_variant_pattern(name: n, field_bindings: fbs)
    Wildcard => "_"
  }
}

fn emit_variant_pattern(name: String, field_bindings: List<FieldBinding>) -> String {
  if field_bindings |> count == 0 {
    name
  } else {
    let binding_strs = field_bindings |> map(fb =>
      let pat_str = emit_pattern(pattern: fb.binding)
      concat(rust_ident(name: fb.field_name), ": ", pat_str)
    )
    let bindings_str = binding_strs |> join(separator: ", ")
    concat(name, " { ", bindings_str, " }")
  }
}

// =========================================================================
// If/else emission
// =========================================================================

fn emit_if(condition: Expr, then_branch: Expr, else_branch: Expr?, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let cond_str = emit_expr_in_scope(expr: condition, registry: registry, scope: scope)
  let then_str = emit_expr_in_scope(expr: then_branch, registry: registry, scope: scope)
  match else_branch {
    Some { value: eb } => {
      let else_str = emit_expr_in_scope(expr: eb, registry: registry, scope: scope)
      concat("if ", cond_str, " {\n",
        indent(text: then_str, level: 1), "\n} else {\n",
        indent(text: else_str, level: 1), "\n}")
    }
    None =>
      concat("if ", cond_str, " {\n",
        indent(text: then_str, level: 1), "\n}")
  }
}

// =========================================================================
// Let binding emission
// =========================================================================

fn emit_let(name: String, value: Expr, body: Expr?, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let val_str = emit_expr_in_scope(expr: value, registry: registry, scope: scope)
  let let_line = concat("let ", rust_ident(name: name), " = ", val_str, ";")
  match body {
    Some { value: bd } =>
      let next_scope = extend_scope(scope: scope, name: name, resolved: infer_expr_type(expr: value, scope: scope))
      concat(let_line, "\n", emit_expr_in_scope(expr: bd, registry: registry, scope: next_scope))
    None => let_line
  }
}

// =========================================================================
// Record literal emission
// =========================================================================

fn explicit_record_struct_name(type_name: String?, inferred_type: TypeExpr) -> String? {
  match normalize_access_type(type_expr: inferred_type) {
    Named { name: name, span: _ } => Some { value: name }
    Product { name: name, fields: _, span: _ } =>
      if name == none { type_name } else { name }
    _ => type_name
  }
}

fn resolve_record_struct_name(type_name: String?, fields: List<FieldInit>, span: SourceSpan, scope: InferScope) -> String? {
  let inferred_type = infer_expr_type(
    expr: RecordLit { type_name: type_name, fields: fields, span: span },
    scope: scope
  )
  explicit_record_struct_name(type_name: type_name, inferred_type: inferred_type)
}

fn emit_record_lit(type_name: String?, fields: List<FieldInit>, span: SourceSpan, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  match resolve_record_struct_name(type_name: type_name, fields: fields, span: span, scope: scope) {
    None =>
      "compile_error!(\"cannot resolve anonymous record type in emitter\")"
    Some { value: tn } =>
      if fields |> count == 0 {
        concat(tn, " {}")
      } else {
        let field_strs = fields |> map(f =>
          concat("    ", rust_ident(name: f.name), ": ", emit_expr_in_scope(expr: f.value, registry: registry, scope: scope), ",")
        )
        let fields_str = field_strs |> join(separator: "\n")
        concat(tn, " {\n", fields_str, "\n}")
      }
  }
}

// =========================================================================
// List literal emission
// =========================================================================

fn emit_list_lit(elements: List<Expr>, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  if elements |> count == 0 {
    "vec![]"
  } else {
    let el_strs = elements |> map(e => emit_expr_in_scope(expr: e, registry: registry, scope: scope))
    let els_str = el_strs |> join(separator: ", ")
    concat("vec![", els_str, "]")
  }
}

// =========================================================================
// Binary operator emission
// =========================================================================

fn emit_bin_op(op: BinOpKind, left: Expr, right: Expr, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let l_str = emit_expr_in_scope(expr: left, registry: registry, scope: scope)
  let r_str = emit_expr_in_scope(expr: right, registry: registry, scope: scope)
  if is_null_coalesce_op(op: op) {
    // x ?? y  ->  x.unwrap_or_else(|| y)
    concat(l_str, ".unwrap_or_else(|| ", r_str, ")")
  } else {
    let op_str = emit_bin_op_symbol(op: op)
    concat("(", l_str, " ", op_str, " ", r_str, ")")
  }
}

fn emit_bin_op_symbol(op: BinOpKind) -> String {
  match op {
    Add => "+"
    Sub => "-"
    Mul => "*"
    Div => "/"
    Mod => "%"
    BinEq => "=="
    BinNe => "!="
    BinLt => "<"
    BinGt => ">"
    BinLe => "<="
    BinGe => ">="
    BinAnd => "&&"
    BinOr => "||"
    NullCoalesce => "??"
  }
}

fn is_null_coalesce_op(op: BinOpKind) -> Bool {
  match op {
    NullCoalesce => true
    _ => false
  }
}

// =========================================================================
// Unary operator emission
// =========================================================================

fn emit_unary_op(op: UnaryOpKind, operand: Expr, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let expr_str = emit_expr_in_scope(expr: operand, registry: registry, scope: scope)
  match op {
    Not => concat("!", expr_str)
    Neg => concat("-", expr_str)
  }
}

// =========================================================================
// Lambda emission
// =========================================================================

fn emit_lambda(params: List<String>, body: Expr, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let param_strs = params |> map(p => rust_ident(name: p))
  let params_str = param_strs |> join(separator: ", ")
  let body_str = emit_expr_in_scope(expr: body, registry: registry, scope: scope)
  concat("|", params_str, "| ", body_str)
}

// =========================================================================
// String interpolation emission
// =========================================================================

fn emit_string_interp(parts: List<StringPart>, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let fmt_parts = parts |> map(p => interp_format_part(part: p, registry: registry, scope: scope))
  let fmt_str = fmt_parts |> map(p => p.format_segment) |> join(separator: "")
  let args = fmt_parts
    |> map(p => p.arg_expr)
    |> filter(a => a != "")
  if args |> count == 0 {
    concat("\"", fmt_str, "\".to_string()")
  } else {
    let args_str = args |> join(separator: ", ")
    concat("format!(\"", fmt_str, "\", ", args_str, ")")
  }
}

fn interp_format_part(part: StringPart, registry: Map<String, ItemInfo>, scope: InferScope) -> InterpPart {
  match part {
    Text { value: v } =>
      // Escape braces in format strings
      let escaped = v
        |> split(delimiter: "{") |> join(separator: "{{")
      let escaped2 = escaped
        |> split(delimiter: "}") |> join(separator: "}}")
      InterpPart { format_segment: escaped2, arg_expr: "" }
    Interpolation { expr: e } =>
      InterpPart { format_segment: "{}", arg_expr: emit_expr_in_scope(expr: e, registry: registry, scope: scope) }
  }
}

// =========================================================================
// Block emission
// =========================================================================

fn emit_block(stmts: List<Expr>, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let state = stmts |> fold(init: BlockEmitState { text: "", scope: scope }, f: fn(acc, stmt) {
    let line = emit_expr_in_scope(expr: stmt, registry: registry, scope: acc.scope)
    let next_scope = scope_after_expr(expr: stmt, scope: acc.scope)
    let new_text = if acc.text == "" { line } else { concat(acc.text, "\n", line) }
    BlockEmitState { text: new_text, scope: next_scope }
  })
  concat("{\n", indent(text: state.text, level: 1), "\n}")
}

// =========================================================================
// Cast emission
// =========================================================================

fn emit_cast(expr: Expr, target: TypeExpr, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let expr_str = emit_expr_in_scope(expr: expr, registry: registry, scope: scope)
  let ty_str = emit_type_expr(type_expr: target)
  if is_primitive_numeric(type_expr: target) {
    concat(expr_str, " as ", ty_str)
  } else {
    // Non-primitive cast: `as` is only valid for numeric primitives in Rust.
    // Emit a compile-time failure so this is caught rather than silently wrong.
    concat("todo!(\"unsupported cast to ", ty_str, "\")")
  }
}

// Returns true for primitive numeric types where Rust `as` is valid.
fn is_primitive_numeric(type_expr: TypeExpr) -> Bool {
  match type_expr {
    Primitive { name: n, span: _ } =>
      if n == "Int" { true }
      else if n == "Float" { true }
      else if n == "Bool" { true }
      else { false }
    _ => false
  }
}

// =========================================================================
// Service definition emission
//
// Each service becomes:
//   - A client struct with config fields
//   - An impl block with one async method per operation
//   - Transport-specific call scaffolding (REST -> reqwest, Shell -> Command)
// =========================================================================

fn emit_service_def(
  name: String,
  transport: TransportBinding,
  config: ServiceConfig?,
  operations: List<OperationDef>,
  registry: Map<String, ItemInfo>
) -> String {
  let safe_name = sanitize_service_name(name: name)
  let struct_def = emit_service_struct(name: safe_name, transport: transport, config: config)
  let impl_block = emit_service_impl(name: safe_name, transport: transport, operations: operations, registry: registry)
  concat(struct_def, "\n\n", impl_block)
}

fn emit_service_struct(name: String, transport: TransportBinding, config: ServiceConfig?) -> String {
  let derives = "#[derive(Debug, Clone)]"
  let config_fields = emit_service_config_fields(transport: transport, config: config)
  concat(derives, "\npub struct ", name, " {\n", config_fields, "\n}")
}

fn emit_service_config_fields(transport: TransportBinding, config: ServiceConfig?) -> String {
  match transport {
    RestBinding { base_url: _, auth: a, headers: _ } => {
      let base = "    pub base_url: String,"
      let auth_field = match a {
        Some { value: _ } => "\n    pub auth_token: String,"
        None => ""
      }
      concat(base, auth_field)
    }
    ShellBinding { argv: _, env: _ } =>
      "    pub working_dir: Option<String>,"
    FileBinding { base_path: _ } =>
      "    pub base_path: String,"
    LocalBinding =>
      "    // No configuration needed for local binding."
  }
}

fn emit_service_impl(name: String, transport: TransportBinding, operations: List<OperationDef>, registry: Map<String, ItemInfo>) -> String {
  let method_strs = operations |> map(op =>
    emit_operation_method(service_name: name, transport: transport, operation: op, registry: registry)
  )
  let methods_str = method_strs |> join(separator: "\n\n")
  concat("impl ", name, " {\n", indent(text: methods_str, level: 1), "\n}")
}

fn emit_modifier_name(modifier: OperationModifier) -> String {
  match modifier {
    Idempotent => "idempotent"
    Readonly => "readonly"
    Hermetic => "hermetic"
  }
}

fn emit_modifier_doc(modifiers: List<OperationModifier>) -> String {
  if modifiers |> count == 0 {
    ""
  } else {
    let names = modifiers |> map(m => emit_modifier_name(modifier: m))
    concat("/// Modifiers: ", names |> join(separator: ", "), "\n")
  }
}

fn emit_operation_method(service_name: String, transport: TransportBinding, operation: OperationDef, registry: Map<String, ItemInfo>) -> String {
  let input_params = operation.inputs |> map(f =>
    concat(rust_ident(name: f.name), ": ", emit_field_type(field: f))
  )
  let params_str = input_params |> join(separator: ", ")
  let all_params = if params_str == "" {
    "&self"
  } else {
    concat("&self, ", params_str)
  }
  let ret_type = emit_operation_return_type(outputs: operation.outputs)
  // Use per-operation transport override if present, otherwise service-level transport.
  let effective_transport = match operation.transport {
    Some { value: op_transport } => op_transport
    None => transport
  }
  let body = emit_transport_call(transport: effective_transport, operation: operation, registry: registry)
  let modifier_doc = emit_modifier_doc(modifiers: operation.modifiers)
  concat(modifier_doc, "pub async fn ", rust_ident(name: operation.name),
    "(", all_params, ") -> Result<", ret_type, ", Box<dyn std::error::Error>> {\n",
    indent(text: body, level: 1), "\n}")
}

fn emit_operation_return_type(outputs: List<Field>) -> String {
  if outputs |> count == 0 {
    "()"
  } else if outputs |> count == 1 {
    let f = outputs |> first
    match f {
      Some { value: field } => emit_field_type(field: field)
      None => "()"
    }
  } else {
    // Multiple outputs -> return a tuple
    let tys = outputs |> map(f => emit_field_type(field: f))
    concat("(", tys |> join(separator: ", "), ")")
  }
}

fn emit_transport_call(transport: TransportBinding, operation: OperationDef, registry: Map<String, ItemInfo>) -> String {
  match transport {
    RestBinding { base_url: _, auth: a, headers: hs } =>
      emit_rest_call(operation: operation, auth: a, headers: hs, registry: registry)
    ShellBinding { argv: _, env: envs } =>
      emit_shell_call(operation: operation, env: envs, registry: registry)
    FileBinding { base_path: _ } =>
      emit_file_call(operation: operation)
    LocalBinding =>
      emit_local_call(operation: operation)
  }
}

fn emit_rest_call(operation: OperationDef, auth: AuthConfig?, headers: List<HeaderDef>, registry: Map<String, ItemInfo>) -> String {
  let client_init = "let client = reqwest::Client::new();"
  let url_line = concat("let url = format!(\"{}/{}\", self.base_url, \"",
    rust_ident(name: operation.name), "\");")
  let auth_line = match auth {
    Some { value: ac } =>
      concat("let request = client.post(&url)\n    .header(\"",
        ac.header, "\", ", emit_expr(expr: ac.token_expr, registry: registry), ");")
    None =>
      "let request = client.post(&url);"
  }
  let header_lines = headers |> map(h =>
    concat("let request = request.header(\"", h.name, "\", ",
      emit_expr(expr: h.value, registry: registry), ");")
  )
  let send_line = "let response = request.send().await?;"
  let parse_line = "let result = response.json().await?;"
  let return_line = "Ok(result)"
  let all_lines = concat([client_init, url_line, auth_line],
    header_lines, [send_line, parse_line, return_line])
  all_lines |> join(separator: "\n")
}

fn emit_shell_call(operation: OperationDef, env: List<EnvDef>, registry: Map<String, ItemInfo>) -> String {
  let cmd_line = concat("let output = std::process::Command::new(\"",
    rust_ident(name: operation.name), "\")")
  let env_lines = env |> map(e =>
    concat("    .env(\"", e.name, "\", ", emit_expr(expr: e.value, registry: registry), ")")
  )
  let wd_line = "    .current_dir(self.working_dir.as_deref().unwrap_or(\".\"))"
  let output_line = "    .output()?;"
  let check_line = "let stdout = String::from_utf8_lossy(&output.stdout).to_string();"
  let return_line = "Ok(stdout)"
  let all_lines = concat([cmd_line], env_lines, [wd_line, output_line, check_line, return_line])
  all_lines |> join(separator: "\n")
}

fn emit_file_call(operation: OperationDef) -> String {
  concat("let path = format!(\"{}/{}\", self.base_path, \"",
    rust_ident(name: operation.name), "\");\n",
    "let content = std::fs::read_to_string(&path)?;\n",
    "Ok(content)")
}

fn emit_local_call(operation: OperationDef) -> String {
  concat("// Local binding — direct function call\n",
    "Ok(", rust_ident(name: operation.name), "())")
}

// =========================================================================
// Resource definition emission
//
// Resources become a trait with capability methods.
// =========================================================================

fn emit_resource_def(name: String, capabilities: List<CapabilityDef>) -> String {
  let cap_methods = capabilities |> map(c => emit_capability_method(cap: c))
  let methods_str = cap_methods |> join(separator: "\n\n")
  concat("#[async_trait::async_trait]\npub trait ", name, " {\n",
    indent(text: methods_str, level: 1), "\n}")
}

fn emit_capability_method(cap: CapabilityDef) -> String {
  let input_params = cap.inputs |> map(f =>
    concat(rust_ident(name: f.name), ": ", emit_field_type(field: f))
  )
  let params_str = input_params |> join(separator: ", ")
  let all_params = if params_str == "" {
    "&self"
  } else {
    concat("&self, ", params_str)
  }
  let ret = emit_capability_return_type(outputs: cap.outputs)
  concat("async fn ", rust_ident(name: cap.name), "(", all_params, ") -> Result<", ret, ", Box<dyn std::error::Error>>;")
}

fn emit_capability_return_type(outputs: List<Field>) -> String {
  if outputs |> count == 0 {
    "()"
  } else if outputs |> count == 1 {
    let f = outputs |> first
    match f {
      Some { value: field } => emit_field_type(field: field)
      None => "()"
    }
  } else {
    let tys = outputs |> map(f => emit_field_type(field: f))
    concat("(", tys |> join(separator: ", "), ")")
  }
}

// =========================================================================
// Data definition emission
//
// data name: Type = value  ->  pub const/lazy_static
//
// Simple scalar data -> const. Complex data (lists, maps, records) ->
// lazy_static or a function that returns the value.
// =========================================================================

fn emit_data_def(name: String, type_expr: TypeExpr, value: Expr, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let ty_str = emit_type_expr(type_expr: type_expr)
  let upper_name = to_screaming_snake(name: name)
  if is_simple_type(type_expr: type_expr) {
    let val_str = emit_expr_in_scope(expr: value, registry: registry, scope: scope)
    concat("pub const ", upper_name, ": ", ty_str, " = ", val_str, ";")
  } else if has_nested_records(type_expr: type_expr) {
    // Complex data with nested anonymous records -> serde deserialization
    let json_str = emit_data_value_json(value: value)
    concat("pub fn ", to_snake(name: name), "() -> ", ty_str, " {\n",
      "    serde_json::from_value(serde_json::json!(", json_str, "))\n",
      "        .expect(\"valid data definition\")\n",
      "}")
  } else {
    // Complex types use lazy_static for heap-allocated values
    let val_str = emit_expr_in_scope(expr: value, registry: registry, scope: scope)
    concat("lazy_static::lazy_static! {\n",
      "    pub static ref ", upper_name, ": ", ty_str, " = ", val_str, ";\n",
      "}")
  }
}

fn is_simple_type(type_expr: TypeExpr) -> Bool {
  match type_expr {
    Primitive { name: n, span: _ } =>
      if n == "Int" { true }
      else if n == "Bool" { true }
      else if n == "Float" { true }
      else { false }
    _ => false
  }
}

// =========================================================================
// Test file emission
//
// For modules with service operations that have mock_response data,
// emit a test file with one test per mock.
// =========================================================================

fn emit_test_file(typed_module: TypedModule) -> TextFile {
  let m = typed_module.module
  let service_items = typed_module.items |> filter(item => is_typed_service_item(item: item))
  let test_fns = service_items
    |> map(item => emit_typed_service_tests(item: item, registry: empty_map()))
    |> fold(init: [], f: fn(acc, tests) { concat(acc, tests) })
  if test_fns |> count == 0 {
    TextFile { path: "", content: "" }
  } else {
    let filename = module_to_filename(name: m.name)
    let tests_str = test_fns |> join(separator: "\n\n")
    let content = concat("// Generated tests — do not edit.\n",
      "// Source module: ", m.name, "\n\n",
      "#[cfg(test)]\nmod tests {\n",
      "    use super::*;\n\n",
      indent(text: tests_str, level: 1), "\n",
      "}\n")
    TextFile { path: concat("tests/", filename, "_test.rs"), content: content }
  }
}

fn is_typed_service_item(item: TypedNode) -> Bool {
  item.operations |> count > 0
}

fn emit_typed_service_tests(item: TypedNode, registry: Map<String, ItemInfo>) -> List<String> {
  if item.operations |> count > 0 {
    let safe_name = sanitize_service_name(name: item.name)
    item.operations
      |> filter(op => op.mock_response |> count > 0)
      |> map(op => emit_operation_test(service_name: safe_name, operation: op, registry: registry))
  } else {
    []
  }
}

fn emit_operation_test(service_name: String, operation: OperationDef, registry: Map<String, ItemInfo>) -> String {
  let test_name = concat("test_", to_snake(name: service_name), "_", to_snake(name: operation.name))
  let mock_setup = operation.mock_response |> map(mr =>
    emit_mock_response_setup(mock: mr, registry: registry)
  )
  let mock_str = mock_setup |> join(separator: "\n")
  concat("#[tokio::test]\nasync fn ", test_name, "() {\n",
    indent(text: mock_str, level: 1), "\n",
    indent(text: "// Mock-based test: verifies operation contract with fixture data.", level: 1), "\n",
    "}")
}

fn emit_mock_response_setup(mock: MockResponseDef, registry: Map<String, ItemInfo>) -> String {
  let status_str = emit_expr(expr: mock.status, registry: registry)
  let body_str = emit_expr(expr: mock.body, registry: registry)
  let desc = match mock.description {
    Some { value: d } => concat("// ", d, "\n")
    None => ""
  }
  concat(desc, "let mock_status = ", status_str, ";\n",
    "let mock_body = ", body_str, ";")
}

// =========================================================================
// Identifier conversion — Rust target
// =========================================================================

// Convert a DSL identifier to a valid Rust identifier.
// Handles reserved word escaping with r# prefix.
fn rust_ident(name: String) -> String {
  if rust_reserved |> any(r => r == name) {
    concat("r#", name)
  } else {
    to_snake(name: name)
  }
}

// =========================================================================
// Cargo.toml emission
//
// Generates a minimal Cargo.toml for the emitted crate.
// =========================================================================

fn emit_cargo_toml(crate_name: String, has_services: Bool) -> TextFile {
  let header = concat("[package]\nname = \"", crate_name, "\"\nversion = \"0.1.0\"\nedition = \"2021\"\n")
  let deps = "\n[dependencies]\nserde = { version = \"1\", features = [\"derive\"] }\nserde_json = \"1\"\n"
  let async_deps = if has_services {
    "tokio = { version = \"1\", features = [\"full\"] }\nreqwest = { version = \"0.12\", features = [\"json\"] }\nasync-trait = \"0.1\"\n"
  } else {
    ""
  }
  let lazy_dep = "lazy_static = \"1\"\n"
  TextFile { path: "Cargo.toml", content: concat(header, deps, async_deps, lazy_dep) }
}

// Check if a typed graph has any service definitions (for Cargo.toml generation).
fn has_service_items(typed: TypedGraph) -> Bool {
  typed.modules |> any(tm =>
    tm.items |> any(item => is_typed_service_item(item: item))
  )
}
