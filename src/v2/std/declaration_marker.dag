module v2.std.declaration_marker

import v2.std.collection { List }
import v2.std.node { Symbol }

// The authored `test` marker segregates test code from serving code (owner ruling 2026-09-16/17), and
// name resolution CONSUMES it: a reference to a marked declaration is refused there. What it must not
// touch is the semantic tree -- a marked declaration's semantic graph and content hash are identical
// to an unmarked one's -- so it rides this channel beside the tree rather than as a child edge. It
// borrows the SHAPE of the DESIGN section 4c annotation channel (captured beside the semantic result,
// as annotations ride beside AuthoredParseArtifact.semantic), not its non-interference rule: 4c
// governs `//` prose, which may alter nothing downstream, while `test` is a declaration marker whose
// whole purpose is a refusal. v1 carries the same fact as v1.std.core DeclarationMarker on the Node
// itself; v2's Node has no field for it, and a structural child edge would change the content hash of
// every test declaration.
//
// Only marked declarations are rows. Absence is the unmarked arm, and it is decidable because the
// capture that produces this channel reads every top-level item of the module it is handed.
//
// Keyed by the declared member symbol, which is the key a reference binds on. Not by the authored
// occurrence id: lowering rebuilds each declaration as a synthetic named member, so that id does not
// survive to resolution and nothing downstream could join on it.
type TestMarkedDeclaration {
  name: Symbol
}

type TestMarkerChannel {
  marked: List<TestMarkedDeclaration>
}

fn test_marker_channel_marks(channel: TestMarkerChannel, name: Symbol) -> Bool {
  fold(channel.marked, init: false, f: fn(acc, row) { acc || (row.name == name) })
}

fn test_marker_channel_count(channel: TestMarkerChannel) -> Int {
  std.types.list_length(items: channel.marked)
}
