module v2.std.declaration_marker

import v2.std.collection { Absent, List, Map, Present, empty_map, map_insert, map_lookup }
import v2.std.node { Symbol }
import v2.std.qualified_name { QualifiedName, qualified_name_snoc }

// The authored `test` marker is source data of the DESIGN section 4c kind: it segregates test code
// from serving code, and it may not alter any semantic occurrence identity, semantic graph,
// resolution result or hash. So it rides this channel, beside the semantic tree and disjoint from
// it, exactly as the annotation channel rides beside AuthoredParseArtifact.semantic. v1 carries the
// same fact as v1.std.core DeclarationMarker on the Node itself; v2's Node has no field for it, and
// a structural child edge would change the content hash of every test declaration.
//
// Only marked declarations are rows. Absence is the unmarked arm, and it is decidable because the
// capture that produces this channel reads every top-level item of the module it is handed.
//
// Keyed by the declared member symbol, which is the key a reference binds on. Not by the authored
// occurrence id: lowering rebuilds each declaration as a synthetic named member, so that id does not
// survive to resolution and nothing downstream could join on it.
type TestMarkedDeclaration {
  name: Symbol
}

type TestMarkerChannel {
  marked: List<TestMarkedDeclaration>
}

// The channel of a module that declares no test code. Its consumers are the fixture doors that admit
// already-lowered roots, whose markers cannot be recovered (v2.compiler.normalized_tree
// admit_unmarked_normalized_roots and the fixture callers of admit_normalized_tree).
fn test_marker_channel_empty() -> TestMarkerChannel {
  TestMarkerChannel { marked: [] }
}

fn test_marker_channel_marks(channel: TestMarkerChannel, name: Symbol) -> Bool {
  fold(channel.marked, init: false, f: fn(acc, row) { acc || (row.name == name) })
}

fn test_marker_channel_count(channel: TestMarkerChannel) -> Int {
  std.types.list_length(items: channel.marked)
}

// THE RESOLUTION-SIDE READING OF THE CHANNEL: the compilation's marked declarations as the qualified
// paths a reference binds to. The key is the path v2.compiler.symbol_index_fill indexes (module path,
// then one segment per named member), so a binding answered by the symbol index is judged by the path
// it answered with and nothing else.
//
// ITEM-SCOPED, NOT MODULE-SCOPED. Test code is the declarations the author marked, and nothing else:
// an unmarked helper that happens to live in a module with tests is ordinary code, and a module-level
// rule ("any test in the module makes all of it test code") is wrong in both directions -- it refuses
// references to ordinary helpers and says nothing finer about the marked ones.
type TestCodeIndex {
  marked_paths: Map<QualifiedName, Bool>
}

type TestCodeReach
  = ReachesNoTestCode
  | ReachesTestMarkedDeclaration

fn test_code_index_empty() -> TestCodeIndex {
  TestCodeIndex { marked_paths: empty_map() }
}

fn test_code_index_add_module(
  index: TestCodeIndex,
  module_qn: QualifiedName,
  channel: TestMarkerChannel
) -> TestCodeIndex {
  TestCodeIndex {
    marked_paths: fold(channel.marked, init: index.marked_paths, f: fn(acc, row) {
      map_insert(m: acc, key: qualified_name_snoc(qn: module_qn, segment: row.name), value: true)
    })
  }
}

fn test_code_reach(index: TestCodeIndex, path: QualifiedName) -> TestCodeReach {
  match map_lookup(m: index.marked_paths, key: path) {
    Present { value: _ } => ReachesTestMarkedDeclaration
    Absent => ReachesNoTestCode
  }
}
