module v2.std.decl_facts_skeleton

import std.types { String, Bool }

data decl_facts_nullary_variant_value_identity_gap_note: String = "PARSE-ONLY decl_facts marshal surfaces outer record-literal variant constructors structurally (ExprRecordLit authored name on the AST node — Scaffold, Terminal, DeclarationRef, NamedField, etc.). Nullary coproduct variant VALUE references (ExprVar such as dissolves_to: SingleAuthority or field: WholeDeclaration) require infer-stamped VarBindingKind::VariantValueBinding from lookup_variant_parent_enum(InferScope, name), which needs a populated type_env and locals — v1.compiler.infer infer_var_binding_kind. The parse-only decl_facts_corpus_walk path never runs inference, so binding_kind stays None on every ExprVar and the marshaller cannot ground variant-value identity without a naming convention or arity heuristic. Dissolve-on: decl_facts data-init or fn-body marshal stamps VariantValueBinding via per-file import/type resolution before marshal_generic, or the corpus walk runs the infer binding-kind pass on each module before skeleton emission."

fn decl_facts_reflection_fixture_witness(case: String) -> Bool {
  decl_facts_reflection_fixture_witness_host(case: case)
}
