module v2.std.decl_facts_skeleton



type OuterRecordConstructorLexeme = String

type SkeletonMarshalAtomLexeme = String



data decl_facts_nullary_variant_value_identity_gap_note: String = "BOUNDED constructor-lexeme reflection (parse-only decl_facts_corpus_walk metadata): outer ExprRecordLit authored names surface as SkeletonMarshalAtomLexeme / OuterRecordConstructorLexeme atoms (Scaffold, Terminal, DeclarationRef, NamedField, etc.) — constructor SPELLING only, not parent coproduct or declaration identity. DataItem node marshaling in eval_decl_facts delegates to marshal_data_initializer_projection (ctx.lookup_fn_node on the resolved graph), so merge-blocking witnesses that read resolved nullary parent/arm identity through decl_facts() exercise the same typechecked seam as marshal_data_initializer_projection Rust tests — infer-stamped VarBindingKind::VariantValueBinding and InferredNode::Resolved on variant-value ExprVars. Remaining open at this grain: exact parent-variant occurrence identity (this lane lands ResolvedDeclarationLocator qualified-name parent/arm only, not occurrence coordinates). Dissolve-on: occurrence-grain projection or a single marshal authority that folds spelling atoms and resolved identity without a parse-only fork."

data decl_facts_outer_record_constructor_lexeme_authority_note: String = "OuterRecordConstructorLexeme is the honest name for ExprRecordLit-authored constructor spelling reflected in decl_facts skeleton atoms. It is not variant identity: parent coproduct, module, declaration, and variant resolution are separate open obligations. skeleton_contains_outer_record_constructor_lexeme reads the same marshal atom spine as skeleton_contains_marshal_atom_lexeme but types the query parameter honestly."

type DeclFactQualifiedNameResolution
  = DeclFactResolvedUnique { fact: v2.std.decl_index.DeclFact }
  | DeclFactResolvedMissing { qualified_name: String }
  | DeclFactResolvedAmbiguous { qualified_name: String, match_count: Int }

fn decl_facts_matching_qualified_name(qn: String, facts: List<v2.std.decl_index.DeclFact>) -> List<v2.std.decl_index.DeclFact> {
  list_reverse(xs: fold(facts, init: Empty, f: fn(acc, fact) {
    if fact.qualified_name == qn {
      std.algebra.Cons { head: fact, tail: acc }
    } else {
      acc
    }
  }))
}

fn resolve_decl_fact_by_qualified_name(
  facts: List<v2.std.decl_index.DeclFact>,
  qn: String
) -> DeclFactQualifiedNameResolution {
  let matches = decl_facts_matching_qualified_name(qn: qn, facts: facts)
  let n = length(xs: matches)
  if n == 0 {
    DeclFactResolvedMissing { qualified_name: qn }
  } else if n > 1 {
    DeclFactResolvedAmbiguous { qualified_name: qn, match_count: n }
  } else {
    match list_head(xs: matches) {
      HeadAbsent => DeclFactResolvedMissing { qualified_name: qn }
      HeadFound { value: sole } => DeclFactResolvedUnique { fact: sole }
    }
  }
}

fn skeleton_marshal_atom_lexeme_optional(node: Node) -> SkeletonMarshalAtomLexeme? {
  match node.kind {
    TypeNode { connective: Atom { identity: sym } } =>
      Present { value: symbol_lexeme(sym: sym) }
    TypeNode { connective: Conj } =>
      fold(
        node_positional_child_targets(node: node),
        init: Absent,
        f: fn(acc, nested) {
          match acc {
            Present { value: _ } => acc
            Absent => skeleton_marshal_atom_lexeme_optional(node: nested)
          }
        }
      )
    _ => Absent
  }
}

fn node_skeleton_edge_targets(node: Node) -> List<Node> {
  list_reverse(xs: fold(node.children, init: Empty, f: fn(acc, e) {
    std.algebra.Cons { head: e.target, tail: acc }
  }))
}

fn node_skeleton_marshal_atom_lexemes(node: Node) -> List<SkeletonMarshalAtomLexeme> {
  let child_lexemes = fold_list_right(
    xs: node_skeleton_edge_targets(node: node),
    empty: Empty,
    snoc: fn(acc, child) {
      fold_list_right(
        xs: node_skeleton_marshal_atom_lexemes(node: child),
        empty: acc,
        snoc: fn(inner_acc, lex) { std.algebra.Cons { head: lex, tail: inner_acc } }
      )
    }
  )
  match node.kind {
    TypeNode { connective: Atom { identity: sym } } =>
      std.algebra.Cons { head: symbol_lexeme(sym: sym), tail: child_lexemes }
    _ => child_lexemes
  }
}

fn skeleton_contains_marshal_atom_lexeme(node: Node, lexeme: SkeletonMarshalAtomLexeme) -> Bool {
  count_where(
    xs: node_skeleton_marshal_atom_lexemes(node: node),
    predicate: fn(lex) { lex == lexeme }
  ) > 0
}

fn skeleton_marshal_atom_lexeme_count(node: Node, lexeme: SkeletonMarshalAtomLexeme) -> Int {
  count_where(
    xs: node_skeleton_marshal_atom_lexemes(node: node),
    predicate: fn(lex) { lex == lexeme }
  )
}

fn skeleton_contains_outer_record_constructor_lexeme(
  node: Node,
  lexeme: OuterRecordConstructorLexeme
) -> Bool {
  skeleton_contains_marshal_atom_lexeme(node: node, lexeme: lexeme)
}

fn skeleton_outer_record_constructor_lexeme_count(
  node: Node,
  lexeme: OuterRecordConstructorLexeme
) -> Int {
  skeleton_marshal_atom_lexeme_count(node: node, lexeme: lexeme)
}

fn decl_fact_skeleton_for_resolution(
  resolution: DeclFactQualifiedNameResolution
) -> Node? {
  match resolution {
    DeclFactResolvedUnique { fact } => Present { value: fact.node }
    DeclFactResolvedMissing { qualified_name: _ } => Absent
    DeclFactResolvedAmbiguous { qualified_name: _, match_count: _ } => Absent
  }
}

data outer_record_constructor_lexeme_dissolve_on: std.dissolution.DissolutionCondition = unbound_dissolution(description: "Dissolve-on: a closed enum or branded digest for each outer record-constructor spelling atom, grounded on extdeps/languages/dag ingest productions, so String aliases at the skeleton marshal boundary become unwritable.")

data skeleton_marshal_atom_lexeme_dissolve_on: std.dissolution.DissolutionCondition = unbound_dissolution(description: "Dissolve-on: same closed spelling authority as outer_record_constructor_lexeme_dissolve_on — skeleton marshal atoms share one cited production roster rather than parallel String nicknames.")
