module v2.std.decl_facts_skeleton

import std.types { List, String }
import v2.std.algebra { Empty, list_append, list_snoc_item, length, count_where }
import v2.std.collection { Absent, Present, list_at_optional }
import v2.std.compilers.lexing { symbol_lexeme }
import v2.std.decl_index { DeclFact, decl_facts }
import v2.std.node { Node, TypeNode, Atom, Conj }
import v2.std.node_query { node_positional_child_targets }

data decl_facts_nullary_variant_value_identity_gap_note: String = "PARSE-ONLY decl_facts marshal surfaces outer record-literal variant constructors structurally (ExprRecordLit authored name on the AST node — Scaffold, Terminal, DeclarationRef, WholeDeclaration, NamedField, etc.). Nullary coproduct variant VALUE references (ExprVar such as dissolves_to: SingleAuthority) require infer-stamped VarBindingKind::VariantValueBinding from lookup_variant_parent_enum(InferScope, name), which needs a populated type_env and locals — v1.compiler.infer infer_var_binding_kind. The parse-only decl_facts_corpus_walk path never runs inference, so binding_kind stays None on every ExprVar and the marshaller cannot ground variant-value identity without a naming convention or arity heuristic. Dissolve-on: decl_facts data-init or fn-body marshal stamps VariantValueBinding via per-file import/type resolution before marshal_generic, or the corpus walk runs the infer binding-kind pass on each module before skeleton emission."

data decl_facts_reflection_fixture_pool_roots: List<String> = [
  "dag/test/fixture/decl_facts_reflection",
]

fn decl_facts_skeleton_atom_lexeme_optional(node: Node) -> String? {
  match node.kind {
    TypeNode { connective: Atom { identity: sym } } =>
      Present { value: symbol_lexeme(sym: sym) }
    TypeNode { connective: Conj } =>
      fold(
        node_positional_child_targets(node: node),
        init: Absent,
        f: fn(acc, nested) {
          match acc {
            Present { value: _ } => acc
            Absent => decl_facts_skeleton_atom_lexeme_optional(node: nested)
          }
        }
      )
    _ => Absent
  }
}

fn node_skeleton_edge_targets(node: Node) -> List<Node> {
  fold(node.children, init: Empty, f: fn(acc, e) {
    list_snoc_item(xs: acc, item: e.target)
  })
}

fn node_skeleton_atom_lexemes(node: Node) -> List<String> {
  let here = match node.kind {
    TypeNode { connective: Atom { identity: sym } } => [symbol_lexeme(sym: sym)]
    _ => []
  }
  fold(
    node_skeleton_edge_targets(node: node),
    init: here,
    f: fn(acc, child) {
      list_append(left: acc, right: node_skeleton_atom_lexemes(node: child))
    }
  )
}

fn skeleton_contains_atom_lexeme(node: Node, lexeme: String) -> Bool {
  count_where(
    xs: node_skeleton_atom_lexemes(node: node),
    predicate: fn(lex) { lex == lexeme }
  ) > 0
}

fn skeleton_atom_lexeme_count(node: Node, lexeme: String) -> Int {
  count_where(
    xs: node_skeleton_atom_lexemes(node: node),
    predicate: fn(lex) { lex == lexeme }
  )
}

fn decl_fact_for_qualified_name(facts: List<DeclFact>, qn: String) -> DeclFact? {
  fold(
    facts,
    init: Absent,
    f: fn(acc, fact) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match fact.qualified_name == qn {
            true => Present { value: fact }
            false => Absent
          }
      }
    }
  )
}

fn decl_fact_skeleton_for_qualified_name(
  facts: List<DeclFact>,
  qn: String
) -> Node? {
  match decl_fact_for_qualified_name(facts: facts, qn: qn) {
    Present { value: fact } => Present { value: fact.node }
    Absent => Absent
  }
}

fn decl_facts_reflection_fixture_facts() -> List<DeclFact> {
  decl_facts(pool_roots: decl_facts_reflection_fixture_pool_roots)
}
