// src/v2/std/access.dag — ownership & access over the node graph (Google Zanzibar / ReBAC).
//
// Status: 🟡 STAGED. The framework (relations, subjects, ownership resolution) is modeled and
// executed by access_test.dag; it is not yet runtime authority. Dissolution trigger: an
// enforcement lens (Step 3) resolves grants + inheritance + usersets over the real Node graph
// and gates CI, and the publication realization (Step 4) projects the labeled tree per audience.
//
// ANCHOR — Google Zanzibar / relationship-based access control (ReBAC). A relation tuple
// ⟨object, relation, subject⟩ is structurally a substrate Edge (relation = label, subject =
// target node), so the access graph is a SUBGRAPH of the node graph — not a side-store
// (DESIGN §2/§4). A subject is a Zanzibar userset: Everyone ('*', "globally readable" = public),
// a specific node (Is), or a userset (MembersOf{node, via} = members of an org / readers of a node).
//
// DECOMPOSITION RECEIPT (DESIGN §2/§3) — dissolves the nickname `repo == privacy`. Today the only
// privacy lever is which repo a file sits in. That fuses facts that must live apart:
//   * OWNERSHIP   — who owns a node (the root of authority; only the owner may grant). THIS FILE.
//   * VISIBILITY  — who may read/write a node (Reader/Writer relations). THIS FILE (Step 2).
//   * REPO        — where code is stored + its own access level. extdeps/github — referenced, not re-coined.
//   * PUBLICATION — (labeled tree + audience) → which units → which repo/CI (Step 4). The 2-repo split = one handler.
// Composes with SecretRef (orthogonal): SecretRef keeps secret *values* out of git; this keeps
// private *code/data* out of the public projection.
//
// GROUNDING — principals (users, orgs, agents) are real `.dag` nodes referenced by the existing
// node identity (Symbol), NOT a minted id (DESIGN §3 anti-nickname). See access_test.dag.

module v2.std.access

import v2.std.node { Symbol }
import v2.std.logic { Bool }

// Zanzibar relations. Owner is the root of authority (DAC: only a node's owner may author
// tuples about it — an invariant the Step-3 lens enforces). Member supports group/org usersets.
type Relation
  = Owner
  | Reader
  | Writer
  | Member

// The audience of a grant (Zanzibar userset).
type Subject
  = Everyone                                    // '*' — globally readable (public)
  | Is        { node: Symbol }                   // a specific user / org / "another node"
  | MembersOf { node: Symbol, via: Relation }    // members of an org, readers of a node

// A relation tuple ⟨object, relation, subject⟩ — structurally an Edge in the access graph.
type Grant {
  object:   Symbol
  relation: Relation
  subject:  Subject
}

// =========================================================================
// Ownership (Step 1) — the foundational relation; the root of authority.
// =========================================================================
//
// Resolution is fail-closed (DESIGN §5): an explicit, named Unowned state (NOT an
// Option overloaded to mean several things — avoids the state-space-conflation trap).
type OwnerResolution
  = Owned { owner: Symbol }    // a concrete owning entity
  | Unowned                    // no concrete owner found — caller falls closed (→ operator)

// Does this single grant name a concrete owner of `object`? Only Owner@Is{..} does;
// Owner@Everyone / Owner@MembersOf is not a concrete owner (fail-closed → Unowned).
fn owner_grant_subject(g: Grant, object: Symbol) -> OwnerResolution {
  match g.relation {
    Owner =>
      if g.object == object {
        match g.subject {
          Is { node: owner_node } => Owned { owner: owner_node }
          Everyone => Unowned
          MembersOf { node: _, via: _ } => Unowned
        }
      } else {
        Unowned
      }
    Reader => Unowned
    Writer => Unowned
    Member => Unowned
  }
}

// The owner of `object` per the grant set: the first concrete Owner tuple, else Unowned.
// (Step-3 lens enforces the "exactly one" invariant + inheritance along containment.)
fn owner_of(grants: List<Grant>, object: Symbol) -> OwnerResolution {
  fold(grants, init: Unowned, f: fn(acc, g) {
    match acc {
      Owned { owner: _ } => acc
      Unowned => owner_grant_subject(g: g, object: object)
    }
  })
}

// Fail-closed default (DESIGN §5): an unowned node belongs to the operator, never the public.
fn effective_owner(grants: List<Grant>, object: Symbol, operator: Symbol) -> Symbol {
  match owner_of(grants: grants, object: object) {
    Owned { owner: o } => o
    Unowned => operator
  }
}

// Does `subject` own `object`?
fn is_owner(grants: List<Grant>, subject: Symbol, object: Symbol) -> Bool {
  match owner_of(grants: grants, object: object) {
    Owned { owner: o } => o == subject
    Unowned => false
  }
}

// =========================================================================
// Visibility (Step 2) — read / write access, public, and the leak rule.
// =========================================================================
//
// Relation hierarchy (Zanzibar "userset rewrite"): Owner ⊒ Writer ⊒ Reader.
// Owning or writing a node implies the right to read it.
fn relation_grants_read(r: Relation) -> Bool {
  match r {
    Owner => true
    Writer => true
    Reader => true
    Member => false
  }
}

fn relation_grants_write(r: Relation) -> Bool {
  match r {
    Owner => true
    Writer => true
    Reader => false
    Member => false
  }
}

fn relation_eq(a: Relation, b: Relation) -> Bool {
  match a {
    Owner  => match b { Owner => true   Reader => false  Writer => false  Member => false }
    Reader => match b { Reader => true  Owner => false   Writer => false  Member => false }
    Writer => match b { Writer => true  Owner => false   Reader => false  Member => false }
    Member => match b { Member => true  Owner => false   Reader => false  Writer => false }
  }
}

// Does `who` hold `relation` directly on `object`? One-level membership (an `Is{who}`
// tuple). Recursive userset resolution — members of members — is a marked Step-3 extension.
fn grant_is_direct(g: Grant, who: Symbol, object: Symbol, relation: Relation) -> Bool {
  if g.object == object {
    if relation_eq(a: g.relation, b: relation) {
      match g.subject {
        Is { node: n } => n == who
        Everyone => false
        MembersOf { node: _, via: _ } => false
      }
    } else { false }
  } else { false }
}

fn has_relation(grants: List<Grant>, who: Symbol, object: Symbol, relation: Relation) -> Bool {
  fold(grants, init: false, f: fn(acc, g) {
    if acc { true } else { grant_is_direct(g: g, who: who, object: object, relation: relation) }
  })
}

// Does the grant's subject (a Zanzibar userset) admit `who`?
fn subject_admits(s: Subject, who: Symbol, grants: List<Grant>) -> Bool {
  match s {
    Everyone => true
    Is { node: n } => n == who
    MembersOf { node: n, via: r } => has_relation(grants: grants, who: who, object: n, relation: r)
  }
}

// Can `who` read `object`? Any read-granting tuple on `object` whose subject admits `who`.
fn read_grant_admits(g: Grant, who: Symbol, object: Symbol, grants: List<Grant>) -> Bool {
  if g.object == object {
    if relation_grants_read(r: g.relation) {
      subject_admits(s: g.subject, who: who, grants: grants)
    } else { false }
  } else { false }
}

fn can_read(grants: List<Grant>, who: Symbol, object: Symbol) -> Bool {
  fold(grants, init: false, f: fn(acc, g) {
    if acc { true } else { read_grant_admits(g: g, who: who, object: object, grants: grants) }
  })
}

// Can `who` write `object`?
fn write_grant_admits(g: Grant, who: Symbol, object: Symbol, grants: List<Grant>) -> Bool {
  if g.object == object {
    if relation_grants_write(r: g.relation) {
      subject_admits(s: g.subject, who: who, grants: grants)
    } else { false }
  } else { false }
}

fn can_write(grants: List<Grant>, who: Symbol, object: Symbol) -> Bool {
  fold(grants, init: false, f: fn(acc, g) {
    if acc { true } else { write_grant_admits(g: g, who: who, object: object, grants: grants) }
  })
}

// Is `object` readable by the public — an Everyone read-granting tuple?
fn grant_is_public(g: Grant, object: Symbol) -> Bool {
  if g.object == object {
    match g.subject {
      Everyone => relation_grants_read(r: g.relation)
      Is { node: _ } => false
      MembersOf { node: _, via: _ } => false
    }
  } else { false }
}

fn is_public(grants: List<Grant>, object: Symbol) -> Bool {
  fold(grants, init: false, f: fn(acc, g) {
    if acc { true } else { grant_is_public(g: g, object: object) }
  })
}

// THE LEAK RULE (DESIGN §5). A node is effectively public only if it is itself public
// AND every dependency it exposes is effectively public. The consumer walks the import
// DAG (`fold_node`) and passes each dependency's already-folded flag in here. Fail-closed:
// any private dependency drags the whole node out of the public projection — a public
// node that imports a private one cannot be published, so visibility never leaks.
fn effective_public(grants: List<Grant>, object: Symbol, dependency_public: List<Bool>) -> Bool {
  if is_public(grants: grants, object: object) {
    fold(dependency_public, init: true, f: fn(acc, d) { acc && d })
  } else {
    false
  }
}
