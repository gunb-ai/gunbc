// src/v2/std/measure.dag
// Scope: v2 compile-root MIRROR of the Measure carrier primitives (NOT landed authority).
// Canonical authority: `dsl/std/measure.dag`. Delete when v2 compile loads `dsl/std`
// directly. Ratchet: carrier shapes MUST match dsl authority (P2).
// Domain aliases (Voltage, Current, …) live in consumer modules — compute_fabric pattern.

module v2.std.measure

import v2.std.integer { Int }

// --- Quantity / Scale: phantom tags (subset mirrored for v2 SPICE consumers) ---

type Quantity =
    Time
  | ElectricPotential
  | ElectricCurrent
  | Resistance
  | Capacitance
  | Inductance
  | ElectricCharge
  | MagneticFlux

type Scale =
    Micro
  | One

// 🟢 PRIMITIVE — parametric dimensional carrier (mirror of dsl/std/measure.dag).
type Measure<Q, S, M> {
  count: M
}
