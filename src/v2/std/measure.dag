// src/v2/std/measure.dag
// Scope: v2 authority for the Measure<Q, S, M> carrier primitive (byte-sync de-fork slice 1a).
// Domain aliases (Voltage, Current, …) live in consumer modules — compute_fabric pattern.
// dsl/std/measure.dag re-exports dsl-tree Quantity/Scale vocabulary and aliases via cross-tree import.

module v2.std.measure

import v2.std.integer { Int }

// --- Quantity / Scale: phantom tags (subset mirrored for v2 SPICE consumers) ---

type Quantity =
    Time
  | ElectricPotential
  | ElectricCurrent
  | Resistance
  | Capacitance
  | Inductance
  | ElectricCharge
  | MagneticFlux

type Scale =
    Micro
  | One

// Parametric dimensional carrier (v2 authority; byte-sync de-fork slice 1a).
type Measure<Q, S, M> {
  count: M
}
