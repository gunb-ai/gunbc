module v2.std.collection

import std.algebra { PointwisePower }
import std.primitives { empty_map_contract, get_contract, lookup_contract, map_insert_contract, PrimitiveContract }
import v2.std.algebra { fold_list, is_empty }
import std.types { List, Set, Map }
import v2.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Unavailable,
  outcome_accepted,
  outcome_rejected,
  invariant_port_locus
}
import v2.std.node { Symbol }
import std.optional {
  Absent,
  Optional,
  Present,
  optional_absent,
  optional_present,
  optional_prefer_first_present
}
import v2.std.witness { Holds, Violates, Witness, witness_from_optional, witness_violates }

fn optional_absent_unwrap_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^optional_absent_unwrap,
    at: invariant_port_locus(port: ^optional_present_witness_port, invariant: ^optional_absent_unwrap),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn optional_present_witness<T>(opt: Optional<T>) -> Witness<T> {
  witness_from_optional(opt: opt, absent: optional_absent_unwrap_diagnostic())
}

data empty_map_host_binding: PrimitiveContract = empty_map_contract
data map_insert_host_binding: PrimitiveContract = map_insert_contract
data map_lookup_host_binding: PrimitiveContract = lookup_contract
data list_at_host_binding: PrimitiveContract = get_contract

type IndexedLookup<T> {
  index: Int
  value: Witness<T>
}

fn empty_map_primitive_delegate<K, V>() -> Map<K, V> {
  empty_map_primitive_delegate()
}
fn empty_map<K, V>() -> Map<K, V> {
  empty_map_primitive_delegate()
}
fn map_insert_primitive_delegate<K, V>(m: Map<K, V>, key: K, value: V) -> Map<K, V> {
  map_insert_primitive_delegate(m: m, key: key, value: value)
}
fn map_insert<K, V>(m: Map<K, V>, key: K, value: V) -> Map<K, V> {
  map_insert_primitive_delegate(m: m, key: key, value: value)
}

// LOOKUP IS TOTAL. A map either holds the key or does not, and both are answers — there is no
// third state in which the map fails to say. So the total form is the primitive and the
// Outcome-wrapped form below is a projection of it, not the other way round.
//
// The direction matters at the consumer. A caller reaching for `map_get_checked` must match a
// `Rejected` arm that no producer can construct, and the only arms available to it are the
// caller's own domain answers — so the unreachable arm gets bound to whichever domain answer is
// nearest, and a substrate failure would report as a domain fact. Exposing the total lookup
// removes the arm rather than asking every caller to dispose of it honestly.
fn map_lookup_primitive_delegate<K, V>(m: Map<K, V>, key: K) -> Optional<V> {
  map_lookup_primitive_delegate(m: m, key: key)
}
fn map_lookup<K, V>(m: Map<K, V>, key: K) -> Optional<V> {
  map_lookup_primitive_delegate(m: m, key: key)
}

// KEY MEMBERSHIP, the one presence predicate over a map: whether `key` has an entry, without its value.
// Callers that store a marker value (a map used as a set of paths) read membership here rather than
// each matching map_lookup's Optional to a Bool.
fn map_contains_key<K, V>(m: Map<K, V>, key: K) -> Bool {
  match map_lookup(m: m, key: key) {
    Present { value: _ } => true
    Absent => false
  }
}

fn map_get_checked<K, V>(m: Map<K, V>, key: K) -> Outcome<Optional<V>> {
  outcome_accepted(value: map_lookup(m: m, key: key))
}
fn list_nth<T>(xs: List<T>, wanted: Int, absent: Diagnostic) -> Witness<T> {
  fold_list(
    xs: xs,
    empty: IndexedLookup {
      index: 0,
      value: witness_violates(diagnostic: absent)
    },
    cons: fn(acc, item) {
      IndexedLookup {
        index: acc.index + 1,
        value: if acc.index == wanted {
          Holds { value: item }
        } else {
          acc.value
        }
      }
    }
  ).value
}
// THE INDEXED READ IS THE `get` PRIMITIVE, PROJECTED TOTAL. `std.primitives` `get_contract` already
// declares its cost -- constant work on an ephemeral carrier, `log n` on the persistent one this List
// is -- so the read inhabits that contract rather than minting a second indexed read. The projection
// is total in the same way `map_lookup` is: an index outside the list is an answer (`Absent`), never a
// sentinel. The body was a fold from the head, O(index) per read, so a caller walking positions paid
// the quadratic the lexer cursor exists to remove.
fn list_at_primitive_delegate<T>(xs: List<T>, index: Int) -> Optional<T> {
  list_at_primitive_delegate(xs: xs, index: index)
}
fn list_at_optional<T>(xs: List<T>, index: Int) -> Optional<T> {
  list_at_primitive_delegate(xs: xs, index: index)
}

// THE MODELED REFERENCE FOR THE NATIVE KERNEL, and its only consumer is the equivalence witness
// `gunbc.primitive_egress` owes the `get` row: the same fixture through this fold and through the
// realized `list_at_optional`, equal answers in and out of range. It is not a second indexed read
// for callers -- it is O(index) and nothing in production reaches it.
type ListAtLookup<T>
  = ListAtMissing { remaining: Int }
  | ListAtFound { value: T }

fn list_at_reference<T>(xs: List<T>, index: Int) -> Optional<T> {
  match fold_list(
    xs: xs,
    empty: ListAtMissing { remaining: index },
    cons: fn(acc, item) {
      match acc {
        ListAtFound { value: _ } => acc
        ListAtMissing { remaining: r } =>
          if r == 0 {
            ListAtFound { value: item }
          } else {
            ListAtMissing { remaining: r - 1 }
          }
      }
    }
  ) {
    ListAtFound { value: v } => optional_present(value: v)
    ListAtMissing { remaining: _ } => optional_absent()
  }
}

