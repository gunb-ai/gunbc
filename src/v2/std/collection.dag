module v2.std.collection


fn optional_absent_unwrap_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^optional_absent_unwrap,
    at: port_locus(port: ^optional_present_witness_port),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn optional_present_witness<T>(opt: v2.std.optional.Optional<T>) -> v2.std.witness.Witness<T> {
  witness_from_optional(opt: opt, absent: optional_absent_unwrap_diagnostic())
}

type List<T> = std.algebra.FreeMonoid<T>

data empty_map_host_binding: std.primitives.PrimitiveContract = empty_map_contract
data map_insert_host_binding: std.primitives.PrimitiveContract = map_insert_contract

type IndexedLookup<T> {
  index: Int
  value: v2.std.witness.Witness<T>
}

type ListAtLookup<T>
  = ListAtMissing { remaining: Int }
  | ListAtFound { value: T }
fn empty_map_primitive_delegate<K, V>() -> Map<K, V> {
  empty_map_primitive_delegate()
}
fn empty_map<K, V>() -> Map<K, V> {
  empty_map_primitive_delegate()
}
fn map_insert<K, V>(m: Map<K, V>, key: K, value: V) -> Map<K, V> {
  std.types.Map {
    lookup: fn(candidate) {
      match candidate == key {
        true => Present { value: value }
        false => m.lookup(candidate)
      }
    }
  }
}

// LOOKUP IS TOTAL. A map either holds the key or does not, and both are answers — there is no
// third state in which the map fails to say. So the total form is the primitive and the
// Outcome-wrapped form below is a projection of it, not the other way round.
//
// The direction matters at the consumer. A caller reaching for `map_get` must match a
// `Rejected` arm that no producer can construct, and the only arms available to it are the
// caller's own domain answers — so the unreachable arm gets bound to whichever domain answer is
// nearest, and a substrate failure would report as a domain fact. Exposing the total lookup
// removes the arm rather than asking every caller to dispose of it honestly.
fn map_lookup<K, V>(m: Map<K, V>, key: K) -> v2.std.optional.Optional<V> {
  m.lookup(key)
}

fn map_get<K, V>(m: Map<K, V>, key: K) -> Outcome<v2.std.optional.Optional<V>> {
  outcome_accepted(value: map_lookup(m: m, key: key))
}
fn list_nth<T>(xs: v2.std.collection.List<T>, wanted: Int, absent: v2.std.diagnostic.Diagnostic) -> v2.std.witness.Witness<T> {
  fold_list(
    xs: xs,
    empty: v2.std.collection.IndexedLookup {
      index: 0,
      value: v2.std.witness.Violates { diagnostic: absent }
    },
    cons: fn(acc, item) {
      IndexedLookup {
        index: acc.index + 1,
        value: if acc.index == wanted {
          v2.std.witness.Holds { value: item }
        } else {
          acc.value
        }
      }
    }
  ).value
}
fn list_at_optional<T>(xs: v2.std.collection.List<T>, index: Int) -> v2.std.optional.Optional<T> {
  match fold_list(
    xs: xs,
    empty: ListAtMissing { remaining: index },
    cons: fn(acc, item) {
      match acc {
        ListAtFound { value: _ } => acc
        ListAtMissing { remaining: r } =>
          if r == 0 {
            ListAtFound { value: item }
          } else {
            ListAtMissing { remaining: r - 1 }
          }
      }
    }
  ) {
    ListAtFound { value: v } => v2.std.optional.optional_present(value: v)
    ListAtMissing { remaining: _ } => v2.std.optional.optional_absent()
  }
}

type FiniteSet<T> {
  head: T
  tail: v2.std.collection.List<T>
}
type TotalMap<K, V> {
  lookup: fn(K) -> V
}
type TotalPolicy<K, Context, RowTemplate> {
  lookup: fn(K, Context) -> RowTemplate
}
