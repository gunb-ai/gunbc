module v2.std.collection

import std.algebra { FreeMonoid }
import std.primitives { empty_map_contract, map_insert_contract, PrimitiveContract }
import v2.std.algebra { fold_list, is_empty }
import std.types { Set, Map }
import v2.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Unavailable,
  outcome_accepted,
  outcome_rejected,
  port_locus
}
import v2.std.node { Symbol }
import v2.std.text { String }
import v2.std.optional {
  Absent,
  Optional,
  Present,
  optional_absent,
  optional_present,
  optional_prefer_first_present
}
import v2.std.witness { Holds, Violates, Witness, witness_from_optional }

fn optional_absent_unwrap_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^optional_absent_unwrap,
    at: port_locus(port: ^optional_present_witness_port),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn optional_present_witness<T>(opt: Optional<T>) -> Witness<T> {
  witness_from_optional(opt: opt, absent: optional_absent_unwrap_diagnostic())
}

type List<T> = std.algebra.FreeMonoid<T>

data empty_map_host_binding: PrimitiveContract = empty_map_contract
data map_insert_host_binding: PrimitiveContract = map_insert_contract

type IndexedLookup<T> {
  index: Int
  value: Witness<T>
}

type ListAtLookup<T>
  = ListAtMissing { remaining: Int }
  | ListAtFound { value: T }
fn empty_map_primitive_delegate<K, V>() -> Map<K, V> {
  empty_map_primitive_delegate()
}
fn empty_map<K, V>() -> Map<K, V> {
  empty_map_primitive_delegate()
}
fn map_insert<K, V>(m: Map<K, V>, key: K, value: V) -> Map<K, V> {
  Map {
    lookup: fn(candidate) {
      match candidate == key {
        true => Present { value: value }
        false => m.lookup(candidate)
      }
    }
  }
}

fn map_get<K, V>(m: Map<K, V>, key: K) -> Outcome<Optional<V>> {
  outcome_accepted(value: m.lookup(key))
}

data grouping_primitive_grounding_note: String = "GROUPING IS A PRIMITIVE, NOT A FOLD OVER map_insert. The modeled Map is a closure chain - map_insert nests one closure per entry and lookup walks them - so building an index by folding map_insert is linear per lookup and measured 33x slower than the linear scan it was meant to replace. The native HAMT that the empty_map delegate already reaches is the realization that makes an index worth building, and group_by is the operation the substrate was missing: index_by is last-wins, so it cannot carry a name that several declarations share.

THE SHAPE IS THE ONE empty_map ALREADY ESTABLISHED. A typed public declaration states the contract in the model; a private delegate whose body is its own name is intercepted at the collection-native grounding seam and never actually recurses. If the native binding is ever absent the delegate is a genuine unbounded self-call, which is why the seam refuses rather than answering - a missing primitive must stop the line, not degrade to a modeled fallback.

DUPLICATE KEYS ARE THE POINT. group_by preserves every item whose key collides, in input order, so the bucket for a name is the exact set a full scan filtered for. index_by keeps the last item per key and is a different operation with a different contract; neither is expressible as the other."

fn group_by_primitive_delegate<T, K>(xs: List<T>, key_fn: fn(T) -> K) -> Map<K, List<T>> {
  group_by_primitive_delegate(xs: xs, key_fn: key_fn)
}

fn group_by<T, K>(xs: List<T>, key_fn: fn(T) -> K) -> Map<K, List<T>> {
  group_by_primitive_delegate(xs: xs, key_fn: key_fn)
}

fn index_by_primitive_delegate<T, K>(xs: List<T>, key_fn: fn(T) -> K) -> Map<K, T> {
  index_by_primitive_delegate(xs: xs, key_fn: key_fn)
}

fn index_by<T, K>(xs: List<T>, key_fn: fn(T) -> K) -> Map<K, T> {
  index_by_primitive_delegate(xs: xs, key_fn: key_fn)
}
fn list_nth<T>(xs: List<T>, wanted: Int, absent: Diagnostic) -> Witness<T> {
  fold_list(
    xs: xs,
    empty: IndexedLookup {
      index: 0,
      value: Violates { diagnostic: absent }
    },
    cons: fn(acc, item) {
      IndexedLookup {
        index: acc.index + 1,
        value: if acc.index == wanted {
          Holds { value: item }
        } else {
          acc.value
        }
      }
    }
  ).value
}
fn list_at_optional<T>(xs: List<T>, index: Int) -> Optional<T> {
  match fold_list(
    xs: xs,
    empty: ListAtMissing { remaining: index },
    cons: fn(acc, item) {
      match acc {
        ListAtFound { value: _ } => acc
        ListAtMissing { remaining: r } =>
          if r == 0 {
            ListAtFound { value: item }
          } else {
            ListAtMissing { remaining: r - 1 }
          }
      }
    }
  ) {
    ListAtFound { value: v } => optional_present(value: v)
    ListAtMissing { remaining: _ } => optional_absent()
  }
}

type FiniteSet<T> {
  head: T
  tail: List<T>
}
type TotalMap<K, V> {
  lookup: fn(K) -> V
}
type TotalPolicy<K, Context, RowTemplate> {
  lookup: fn(K, Context) -> RowTemplate
}
