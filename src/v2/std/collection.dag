module v2.std.collection


import v2.std.algebra { FreeMonoid, PointwisePower, fold_list, is_empty }
import v2.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Unavailable,
  outcome_accepted,
  outcome_rejected,
  port_locus
}
import v2.std.node { Symbol }
import v2.std.witness { Holds, Violates, Witness }
// 🟢 coproduct dissolution — M6-Optional-generic.
// Anchor: initial algebra of F(X) = 1 + T; Haskell Maybe / Rust Option / ML option.
type Optional<T>
  = Absent
  | Present { value: T }
fn optional_absent<T>() -> Optional<T> {
  Absent
}
fn optional_present<T>(value: T) -> Optional<T> {
  Present { value: value }
}
fn optional_prefer_first_present<T>(left: Optional<T>, right: Optional<T>) -> Optional<T> {
  match left {
    Present { value: _ } => left
    Absent => right
  }
}
fn optional_absent_unwrap_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^optional_absent_unwrap,
    at: port_locus(port: ^optional_present_witness_port),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
// 🟡 gated — predicate-dissolution interim — feature:optional-present-witness — bind node://adhoc-2145db6b-69a — dissolve-on-arrival: substrate projects Optional<T> Present arm to Witness<T>; forbidden: returning a synthetic payload on Absent (fail-open unwrap).
fn optional_present_witness<T>(opt: Optional<T>) -> Witness<T> {
  match opt {
    Present { value: v } => Holds { value: v }
    Absent => Violates { diagnostic: optional_absent_unwrap_diagnostic() }
  }
}
// 🟡 bootstrap-limitation interim — feature:B-LIST-FREEMONOID-1 — owner:substrate dissolutions
// (ctrl#1476 B1) — bind v1_interpreter `expect_list`/`free_monoid_to_vec` chokepoint —
// dissolve-on-arrival: unified runtime representation so list ops need no per-site bridge;
// forbidden: direct `Value::List` consumption bypassing `expect_list` / `free_monoid_to_vec`.
// known asymmetry (B1 interim): `Value::Str` list operands stay atomic; Cons/Empty string
// encodings still flatten via the chokepoint until representation unifies.
type List<T> = FreeMonoid<T>
type Set<T> = PointwisePower<T>
// 🟡 bootstrap-limitation interim — feature:B-MAP-LOOKUP-OPTION-C-1 — Map=PartialFunction lookup alias honored
// per-operation via v2 `raw_map_lookup` dual-dispatch chokepoint (ctrl#1476 B6 Option-C); dissolve-on-arrival:
// unified runtime representation so lookup ops need no per-site bridge; forbidden: direct
// `Value::Map` key-probe bypassing `raw_map_lookup`.
type Map<K, V> {
  lookup: fn(K) -> Witness<V>
}
// Composite struct keys (e.g. { position: Int, production: Symbol }) use structural == in map_insert lookup.
type IndexedLookup<T> {
  index: Int
  value: Witness<T>
}
// 🟢 coproduct dissolution — generic list index lookup for Optional projection (M6 sibling to list_nth Witness path).
type ListAtLookup<T>
  = ListAtMissing { remaining: Int }
  | ListAtFound { value: T }
fn map_absent_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^map_key_absent,
    at: port_locus(port: ^map_lookup_port),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn empty_map<K, V>() -> Map<K, V> {
  Map {
    lookup: fn(_) {
      Violates { diagnostic: map_absent_diagnostic() }
    }
  }
}
fn map_insert<K, V>(m: Map<K, V>, key: K, value: V) -> Map<K, V> {
  Map {
    lookup: fn(candidate) {
      match candidate == key {
        true => Holds { value: value }
        false => m.lookup(candidate)
      }
    }
  }
}


// 🟡 gated — bootstrap-limitation interim — feature:B-LOOKUP-1 — map_get(Outcome<Optional<V>>);
// dissolve-on: bootstrap Witness<V> dispatch at Map.lookup (substrate Witness above); forbidden:
// ad hoc map_get outside v2.std.collection.
fn map_get<K, V>(m: Map<K, V>, key: K) -> Outcome<Optional<V>> {
  match m.lookup(key) {
    Holds { value: v } => outcome_accepted(value: Present { value: v })
    Violates { diagnostic: d } =>
      if d.reason == ^map_key_absent {
        outcome_accepted(value: Absent)
      } else {
        outcome_rejected(d: d)
      }
  }
}
// 🟡 gated — bootstrap-limitation interim — feature:B-MAP-CONTAINS-KEY-1 — host bridge via
// raw_map_lookup; dissolve-on: substrate-native key probe without Optional<V> unpack;
// forbidden: per-site map_get Present-branch key-presence tests when V is Node.
fn map_contains_key<K, V>(m: Map<K, V>, key: K) -> Bool {
  map_contains_key(m: m, key: key)
}
fn list_nth<T>(xs: List<T>, wanted: Int, absent: Diagnostic) -> Witness<T> {
  fold_list(
    xs: xs,
    empty: IndexedLookup {
      index: 0,
      value: Violates { diagnostic: absent }
    },
    cons: fn(acc, item) {
      IndexedLookup {
        index: acc.index + 1,
        value: if acc.index == wanted {
          Holds { value: item }
        } else {
          acc.value
        }
      }
    }
  ).value
}
fn list_at_optional<T>(xs: List<T>, index: Int) -> Optional<T> {
  match fold_list(
    xs: xs,
    empty: ListAtMissing { remaining: index },
    cons: fn(acc, item) {
      match acc {
        ListAtFound { value: _ } => acc
        ListAtMissing { remaining: r } =>
          if r == 0 {
            ListAtFound { value: item }
          } else {
            ListAtMissing { remaining: r - 1 }
          }
      }
    }
  ) {
    ListAtFound { value: v } => optional_present(value: v)
    ListAtMissing { remaining: _ } => optional_absent()
  }
}
// 🟡 needs-more-work — feature:finite-set-uniqueness-witness — dissolve-on: std/algebra derived unique: Witness<Holds> projection; FiniteSet binds structural unique field
type FiniteSet<T> {
  head: T
  tail: List<T>
}
type TotalMap<K, V> {
  lookup: fn(K) -> V
}
type TotalPolicy<K, Context, RowTemplate> {
  lookup: fn(K, Context) -> RowTemplate
}
