module v2.std.collection

import std.algebra { FreeMonoid }
import std.primitives { empty_map_contract, map_insert_contract, PrimitiveContract }
import std.algebra { fold_list, is_empty }
import std.types { Map, Set }
import v2.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Unavailable,
  outcome_accepted,
  outcome_rejected,
  port_locus
}
import v2.std.node { Symbol }
import v2.std.witness { Holds, Violates, Witness }

type Optional<T>
  = Absent
  | Present { value: T }
fn optional_absent<T>() -> Optional<T> {
  Absent
}
fn optional_present<T>(value: T) -> Optional<T> {
  Present { value: value }
}
fn optional_prefer_first_present<T>(left: Optional<T>, right: Optional<T>) -> Optional<T> {
  match left {
    Present { value: _ } => left
    Absent => right
  }
}
fn optional_absent_unwrap_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^optional_absent_unwrap,
    at: port_locus(port: ^optional_present_witness_port),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn optional_present_witness<T>(opt: Optional<T>) -> Witness<T> {
  match opt {
    Present { value: v } => Holds { value: v }
    Absent => Violates { diagnostic: optional_absent_unwrap_diagnostic() }
  }
}

type List<T> = std.algebra.FreeMonoid<T>
type Set<T> = std.types.Set<T>

data empty_map_host_binding: PrimitiveContract = empty_map_contract
data map_insert_host_binding: PrimitiveContract = map_insert_contract

type Map<K, V> = std.types.Map<K, V>

type IndexedLookup<T> {
  index: Int
  value: Witness<T>
}

type ListAtLookup<T>
  = ListAtMissing { remaining: Int }
  | ListAtFound { value: T }
fn map_absent_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^map_key_absent,
    at: port_locus(port: ^map_lookup_port),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn empty_map_primitive_delegate<K, V>() -> Map<K, V> {
  empty_map_primitive_delegate()
}
fn empty_map<K, V>() -> Map<K, V> {
  empty_map_primitive_delegate()
}
fn map_insert<K, V>(m: Map<K, V>, key: K, value: V) -> Map<K, V> {
  Map {
    lookup: fn(candidate) {
      match candidate == key {
        true => Holds { value: value }
        false => m.lookup(candidate)
      }
    }
  }
}

fn map_get<K, V>(m: Map<K, V>, key: K) -> Outcome<Optional<V>> {
  match m.lookup(key) {
    Holds { value: v } => outcome_accepted(value: Present { value: v })
    Violates { diagnostic: d } =>
      if d.reason == ^map_key_absent {
        outcome_accepted(value: Absent)
      } else {
        outcome_rejected(d: d)
      }
  }
}
fn list_nth<T>(xs: List<T>, wanted: Int, absent: Diagnostic) -> Witness<T> {
  fold_list(
    xs: xs,
    empty: IndexedLookup {
      index: 0,
      value: Violates { diagnostic: absent }
    },
    cons: fn(acc, item) {
      IndexedLookup {
        index: acc.index + 1,
        value: if acc.index == wanted {
          Holds { value: item }
        } else {
          acc.value
        }
      }
    }
  ).value
}
fn list_at_optional<T>(xs: List<T>, index: Int) -> Optional<T> {
  match fold_list(
    xs: xs,
    empty: ListAtMissing { remaining: index },
    cons: fn(acc, item) {
      match acc {
        ListAtFound { value: _ } => acc
        ListAtMissing { remaining: r } =>
          if r == 0 {
            ListAtFound { value: item }
          } else {
            ListAtMissing { remaining: r - 1 }
          }
      }
    }
  ) {
    ListAtFound { value: v } => optional_present(value: v)
    ListAtMissing { remaining: _ } => optional_absent()
  }
}

type FiniteSet<T> {
  head: T
  tail: List<T>
}
type TotalMap<K, V> {
  lookup: fn(K) -> V
}
type TotalPolicy<K, Context, RowTemplate> {
  lookup: fn(K, Context) -> RowTemplate
}
