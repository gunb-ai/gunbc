module v2.std.collection

import std.algebra { FreeMonoid, PointwisePower }
import std.primitives { empty_map_contract, map_insert_contract, PrimitiveContract }
import v2.std.algebra { fold_list, is_empty }
import std.types { Set, Map }
import v2.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Unavailable,
  outcome_accepted,
  outcome_rejected,
  invariant_port_locus
}
import v2.std.node { Symbol }
import v2.std.optional {
  Absent,
  Optional,
  Present,
  optional_absent,
  optional_present,
  optional_prefer_first_present
}
import v2.std.witness { Holds, Violates, Witness, witness_from_optional }

fn optional_absent_unwrap_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^optional_absent_unwrap,
    at: invariant_port_locus(port: ^optional_present_witness_port, invariant: ^optional_absent_unwrap),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn optional_present_witness<T>(opt: Optional<T>) -> Witness<T> {
  witness_from_optional(opt: opt, absent: optional_absent_unwrap_diagnostic())
}

type List<T> = std.algebra.FreeMonoid<T>

data empty_map_host_binding: PrimitiveContract = empty_map_contract
data map_insert_host_binding: PrimitiveContract = map_insert_contract

type IndexedLookup<T> {
  index: Int
  value: Witness<T>
}

type ListAtLookup<T>
  = ListAtMissing { remaining: Int }
  | ListAtFound { value: T }
fn empty_map_primitive_delegate<K, V>() -> Map<K, V> {
  empty_map_primitive_delegate()
}
fn empty_map<K, V>() -> Map<K, V> {
  empty_map_primitive_delegate()
}
fn map_insert<K, V>(m: Map<K, V>, key: K, value: V) -> Map<K, V> {
  Map {
    lookup: fn(candidate) {
      match candidate == key {
        true => Present { value: value }
        false => m.lookup(candidate)
      }
    }
  }
}

// LOOKUP IS TOTAL. A map either holds the key or does not, and both are answers — there is no
// third state in which the map fails to say. So the total form is the primitive and the
// Outcome-wrapped form below is a projection of it, not the other way round.
//
// The direction matters at the consumer. A caller reaching for `map_get` must match a
// `Rejected` arm that no producer can construct, and the only arms available to it are the
// caller's own domain answers — so the unreachable arm gets bound to whichever domain answer is
// nearest, and a substrate failure would report as a domain fact. Exposing the total lookup
// removes the arm rather than asking every caller to dispose of it honestly.
fn map_lookup<K, V>(m: Map<K, V>, key: K) -> Optional<V> {
  m.lookup(key)
}

// THIS RETURNS `Accepted` UNCONDITIONALLY, AND CONSUMERS HAVE BEEN WRITTEN AGAINST THAT FACT
// RATHER THAN AGAINST THE TYPE. The return type admits `Rejected`; this body cannot produce it,
// because `outcome_accepted` is the only constructor it reaches. Callers must still match the
// `Rejected` arm for exhaustiveness, and some of them answer it by CONTINUING SILENTLY -- in
// `v2.std.symbol_index`, `symbol_index_global_unique_lookup` renders it as the same
// `GlobalBareLookupUnbound` it uses for a genuine miss, and `symbol_index_track_global_bare`
// returns the index unchanged, which would drop a binding with no diagnostic anywhere.
//
// Those arms are DEAD TODAY and are not a defect today: no authorable input makes this function
// reject, so nothing reaches them. The hazard is that they are silent rather than refusing, so
// THE DAY THIS FUNCTION GAINS A REJECTION PATH -- a bounded map, a poisoned key, a fallible
// backing store -- they begin to fail open, at fill time as well as at read time, and no test
// will notice because no test can exist for them until that day.
//
// SO THE OBLIGATION IS ORDERED, and it is stated here rather than at the consumers because the
// author who creates the hazard is editing THIS function and has no reason to read them: before
// giving `map_get` any path to `Rejected`, convert those silent-continue arms into typed
// refusals. At that point their red becomes authorable and each is an ordinary change; before
// it, a witness over them would be permanently green by construction, which DESIGN section 4b
// calls worse than absent because it is cited as coverage.
fn map_get<K, V>(m: Map<K, V>, key: K) -> Outcome<Optional<V>> {
  outcome_accepted(value: map_lookup(m: m, key: key))
}
fn list_nth<T>(xs: List<T>, wanted: Int, absent: Diagnostic) -> Witness<T> {
  fold_list(
    xs: xs,
    empty: IndexedLookup {
      index: 0,
      value: Violates { diagnostic: absent }
    },
    cons: fn(acc, item) {
      IndexedLookup {
        index: acc.index + 1,
        value: if acc.index == wanted {
          Holds { value: item }
        } else {
          acc.value
        }
      }
    }
  ).value
}
fn list_at_optional<T>(xs: List<T>, index: Int) -> Optional<T> {
  match fold_list(
    xs: xs,
    empty: ListAtMissing { remaining: index },
    cons: fn(acc, item) {
      match acc {
        ListAtFound { value: _ } => acc
        ListAtMissing { remaining: r } =>
          if r == 0 {
            ListAtFound { value: item }
          } else {
            ListAtMissing { remaining: r - 1 }
          }
      }
    }
  ) {
    ListAtFound { value: v } => optional_present(value: v)
    ListAtMissing { remaining: _ } => optional_absent()
  }
}

type FiniteSet<T> {
  head: T
  tail: List<T>
}

