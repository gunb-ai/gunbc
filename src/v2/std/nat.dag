module v2.std.nat

type Nat
  = Zero
  | Succ { prev: Nat }
fn nat_cata<A>(n: Nat, zero: A, succ: fn(A) -> A) -> A {
  match n {
    Zero => zero
    Succ { prev: p } => succ(nat_cata(n: p, zero: zero, succ: succ))
  }
}
fn nat_add(a: Nat, b: Nat) -> Nat {
  nat_cata(n: a, zero: b, succ: fn(acc) { Succ { prev: acc } })
}
fn nat_mul(a: Nat, b: Nat) -> Nat {
  nat_cata(n: a, zero: Zero, succ: fn(acc) { nat_add(a: b, b: acc) })
}

fn nat_compare(a: Nat, b: Nat) -> std.algebra.Ordering {
  if a == b {
    Equal
  } else {
    if a < b {
      Less
    } else {
      Greater
    }
  }
}

fn is_zero(n: Nat) -> Bool {
  match n {
    Zero => true
    Succ { prev: _ } => false
  }
}

fn nat_lte(a: Nat, b: Nat) -> Bool {
  match nat_compare(a: a, b: b) {
    Less => true
    Equal => true
    Greater => false
  }
}

data nat_max_two_nat_authorities_note: String = "This is NOT a duplicate of std.nat nat_max, and the distinction is worth stating because the name alone suggests otherwise. std.nat Nat is CommutativeSemiring<Magnitude> - an algebra alias whose max is written with the host comparison operators - while v2.std.nat Nat is the Peano coproduct Zero | Succ, and the two are different types that no single function can serve. So this sits beside nat_add and nat_mul, which are forked for exactly the same reason and were not remarked on. What IS a real defect is that two Nat authorities exist at all; it predates this declaration and is the numeric-tower grounding thread's subject, not something a max function can close. Because v1-seed function names are not module-scoped, a bare nat_max reference in any closure containing both modules is ambiguous and must be qualified - v2.lens.cost.valuation does exactly that. Dissolve-on: one Nat authority, at which point one of the two nat_max declarations goes with it."

fn nat_max(a: Nat, b: Nat) -> Nat {
  match nat_compare(a: a, b: b) {
    Less => b
    Equal => a
    Greater => a
  }
}

fn nat_gte(a: Nat, b: Nat) -> Bool {
  match nat_compare(a: a, b: b) {
    Less => false
    Equal => true
    Greater => true
  }
}
data nat_additive_commutative_monoid: CommutativeMonoid<Nat> = std.algebra.CommutativeMonoid {
  op: nat_add,
  identity: Zero
}
data nat_semiring: CommutativeSemiring<Nat> = std.algebra.CommutativeSemiring {
  add: nat_add,
  zero: Zero,
  mul: nat_mul,
  one: Succ { prev: Zero }
}

type NatAlgebraLawObligation {
  algebra: v2.std.node.Symbol
  inhabitant: v2.std.node.Symbol
  law: v2.std.node.Symbol
}

fn nat_declared_algebra_law_obligations() -> List<NatAlgebraLawObligation> {
  [
    NatAlgebraLawObligation {
      algebra: ^nat_algebra_law_subject_symbol_additive_monoid,
      inhabitant: ^nat_algebra_law_subject_symbol_inhabitant_nat,
      law: ^law_nat_add_left_identity,
    },
    NatAlgebraLawObligation {
      algebra: ^nat_algebra_law_subject_symbol_additive_monoid,
      inhabitant: ^nat_algebra_law_subject_symbol_inhabitant_nat,
      law: ^law_nat_add_right_identity,
    },
    NatAlgebraLawObligation {
      algebra: ^nat_algebra_law_subject_symbol_additive_monoid,
      inhabitant: ^nat_algebra_law_subject_symbol_inhabitant_nat,
      law: ^law_nat_add_associativity,
    },
    NatAlgebraLawObligation {
      algebra: ^nat_algebra_law_subject_symbol_commutative_semiring,
      inhabitant: ^nat_algebra_law_subject_symbol_inhabitant_nat,
      law: ^law_nat_mul_left_identity,
    },
    NatAlgebraLawObligation {
      algebra: ^nat_algebra_law_subject_symbol_commutative_semiring,
      inhabitant: ^nat_algebra_law_subject_symbol_inhabitant_nat,
      law: ^law_nat_mul_annihilator,
    },
    NatAlgebraLawObligation {
      algebra: ^nat_algebra_law_subject_symbol_commutative_semiring,
      inhabitant: ^nat_algebra_law_subject_symbol_inhabitant_nat,
      law: ^law_nat_mul_associativity,
    },
  ]
}
