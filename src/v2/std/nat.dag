module v2.std.nat
import v2.std.algebra {
  Magma,
  Semigroup,
  Monoid,
  CommutativeMonoid,
  Semiring,
  CommutativeSemiring,
  Ordering,
  Less,
  Equal,
  Greater,
}
import v2.std.node { Symbol }
import v2.std.collection { List }

type Nat
  = Zero
  | Succ { prev: Nat }
fn nat_cata<A>(n: Nat, zero: A, succ: fn(A) -> A) -> A {
  match n {
    Zero => zero
    Succ { prev: p } => succ(nat_cata(n: p, zero: zero, succ: succ))
  }
}
fn nat_add(a: Nat, b: Nat) -> Nat {
  nat_cata(n: a, zero: b, succ: fn(acc) { Succ { prev: acc } })
}
fn nat_mul(a: Nat, b: Nat) -> Nat {
  nat_cata(n: a, zero: Zero, succ: fn(acc) { nat_add(a: b, b: acc) })
}

data nat_compare_grounding_note: String = "ordering-side grounding of the numeric tower (construction side landed in #5428: Nat values ARE native Ints at runtime). The prior arm-wise Peano recursion re-derived per-comparison what the grounded realization answers in one native op -- ~66 call frames per compare, 5.2M frames/min in the tokenize char-class path (.dag self-time profile). The realization's < and == on Int are the grounded surface; a genuinely Peano-shaped operand (extinct post-#5428) fails closed as a typed operator error, never a fabricated ordering."

fn nat_compare(a: Nat, b: Nat) -> Ordering {
  if a == b {
    Equal
  } else {
    if a < b {
      Less
    } else {
      Greater
    }
  }
}

fn is_zero(n: Nat) -> Bool {
  match n {
    Zero => true
    Succ { prev: _ } => false
  }
}

fn nat_lte(a: Nat, b: Nat) -> Bool {
  match nat_compare(a: a, b: b) {
    Less => true
    Equal => true
    Greater => false
  }
}

fn nat_gte(a: Nat, b: Nat) -> Bool {
  match nat_compare(a: a, b: b) {
    Less => false
    Equal => true
    Greater => true
  }
}
data nat_additive_commutative_monoid: CommutativeMonoid<Nat> = CommutativeMonoid {
  monoid: Monoid {
    semigroup: Semigroup { magma: Magma { op: nat_add } },
    identity: Zero
  }
}
data nat_semiring: CommutativeSemiring<Nat> = CommutativeSemiring {
  semiring: Semiring {
    add: nat_additive_commutative_monoid,
    mul: Monoid {
      semigroup: Semigroup { magma: Magma { op: nat_mul } },
      identity: Succ { prev: Zero }
    }
  }
}

type NatAlgebraLawObligation {
  algebra: Symbol
  inhabitant: Symbol
  law: Symbol
}

fn nat_declared_algebra_law_obligations() -> List<NatAlgebraLawObligation> {
  [
    NatAlgebraLawObligation {
      algebra: ^nat_algebra_law_subject_symbol_additive_monoid,
      inhabitant: ^nat_algebra_law_subject_symbol_inhabitant_nat,
      law: ^law_nat_add_left_identity,
    },
    NatAlgebraLawObligation {
      algebra: ^nat_algebra_law_subject_symbol_additive_monoid,
      inhabitant: ^nat_algebra_law_subject_symbol_inhabitant_nat,
      law: ^law_nat_add_right_identity,
    },
    NatAlgebraLawObligation {
      algebra: ^nat_algebra_law_subject_symbol_additive_monoid,
      inhabitant: ^nat_algebra_law_subject_symbol_inhabitant_nat,
      law: ^law_nat_add_associativity,
    },
    NatAlgebraLawObligation {
      algebra: ^nat_algebra_law_subject_symbol_commutative_semiring,
      inhabitant: ^nat_algebra_law_subject_symbol_inhabitant_nat,
      law: ^law_nat_mul_left_identity,
    },
    NatAlgebraLawObligation {
      algebra: ^nat_algebra_law_subject_symbol_commutative_semiring,
      inhabitant: ^nat_algebra_law_subject_symbol_inhabitant_nat,
      law: ^law_nat_mul_annihilator,
    },
    NatAlgebraLawObligation {
      algebra: ^nat_algebra_law_subject_symbol_commutative_semiring,
      inhabitant: ^nat_algebra_law_subject_symbol_inhabitant_nat,
      law: ^law_nat_mul_associativity,
    },
  ]
}
