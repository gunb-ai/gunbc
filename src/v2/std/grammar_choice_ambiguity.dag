module v2.std.grammar_choice_ambiguity

import std.algebra { FreeMonoid }
import v2.std.logic { Bool }
import v2.std.node { Symbol }

data grammar_choice_ambiguity_row_authority_note: String = "GrammarChoiceAmbiguityRow is the grammar-analysis authority for FIRST-set choice overlap facts. Compiler parse stage and frontier probe receipts import this module — not v2.compiler.parse — so probe instrumentation does not pull the parse implementation into generic receipt consumers."

type GrammarChoiceAmbiguityRow {
  production: Symbol
  left_first_terminals: FreeMonoid<Symbol>
  right_first_terminals: FreeMonoid<Symbol>
  overlap_terminals: FreeMonoid<Symbol>
  both_nullable: Bool
}

type NonEmptyGrammarChoiceAmbiguityRows {
  head: GrammarChoiceAmbiguityRow
  tail: FreeMonoid<GrammarChoiceAmbiguityRow>
}

data non_empty_grammar_choice_ambiguity_rows_dissolve_trigger: String = "migrate_when_nonempty_list_refinement_promoted — NonEmptyGrammarChoiceAmbiguityRows dissolves into NonEmptyList<GrammarChoiceAmbiguityRow> when the manual NonEmptyList refinement is promoted from v2.test.claim.manual.refinement_nonempty_list to std."
