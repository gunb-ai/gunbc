module v2.std.grammar_choice_ambiguity



data grammar_choice_ambiguity_row_authority_note: String = "GrammarChoiceAmbiguityRow is the grammar-analysis authority for FIRST-set choice overlap facts. Compiler parse stage and frontier probe receipts import this module — not v2.compiler.parse — so probe instrumentation does not pull the parse implementation into generic receipt consumers."

type GrammarChoiceAmbiguityRow {
  production: v2.std.node.Symbol
  left_first_terminals: FreeMonoid<v2.std.node.Symbol>
  right_first_terminals: FreeMonoid<v2.std.node.Symbol>
  overlap_terminals: FreeMonoid<v2.std.node.Symbol>
  both_nullable: Bool
}

type NonEmptyGrammarChoiceAmbiguityRows {
  head: GrammarChoiceAmbiguityRow
  tail: FreeMonoid<GrammarChoiceAmbiguityRow>
}

data non_empty_grammar_choice_ambiguity_rows_dissolve_trigger: std.dissolution.DissolutionCondition = unbound_dissolution(description: "migrate_when_free_semigroup_available — NonEmptyGrammarChoiceAmbiguityRows dissolves into std.algebra FreeSemigroup<GrammarChoiceAmbiguityRow>. RETARGETED: this trigger previously named the promotion of the manual Refined<List<T>> fixture to std, and the generic carrier that landed is a record with a head field rather than that refinement, with the NonEmptyList alias deliberately withheld while the fixture lives - so the event as previously spelled will not occur and this row would have stalled untracked. The construction wall is now available; see std.algebra free_semigroup_grounding_note.")
