module v2.std.operation_argv

import std.types { String, List, Bool }
import v2.std.algebra { list_map }
import v2.std.template { Template }

// An operation's transport argv is materialized by binding THAT OPERATION'S OWN DECLARED INPUTS, by
// name, from the declaration. The seed's prior materializer carried a fixed five-name vocabulary
// (package, bin, args, unit, property) hardwired in Rust: a second, impoverished representation of
// a fact the operation row already declares (DESIGN 3), which left 95 of the corpus's 139
// shell-transport operations unmaterializable (they reference an input outside those five names)
// and silently injected all five names into every operation regardless of what it declared. This
// module is the single authority for the binding vocabulary; the seed builtin
// shell_materialize_operation_argv reads the declaration and answers in these types.

// The executable position (argv[0]) is NOT bindable: it must be a string literal in the operation's
// own declaration. A generic binder that let a declared input decide WHICH PROGRAM RUNS would be
// strictly worse than the hardcoded list it replaces, so the class is refused, never sanitized and
// never escaped (DESIGN 5 construction-over-validation: the refusal has no arm that proceeds).
// Corpus-measured at authoring time: argv[0] is a declaration literal in 139 of 139 shell-transport
// operations, so the wall is zero-false-positive today.

// A binding the seed cannot DECODE is its own cause (BindingMalformed), separate from an argv
// element it cannot EVALUATE (ArgvExpressionUnsupported): they name different work and would be one
// state-space conflation if fused. A bindings argument that is not a list refuses here too --
// reading it as `no bindings` would silently turn a caller error into a DeclaredInputUnbound
// refusal against the wrong subject (DESIGN 5).

data operation_argv_expression_residue_note: String = "Materialization binds names; it does not EVALUATE argv element expressions. An argv element that is a call or a field access (7 operations at authoring time, e.g. git.Core.DiffUnified0's git_diff_range_argv(..) element) is refused as ArgvExpressionUnsupported -- typed, located, and counted, never absorbed into a fabricated argv. Those operations never materialized through the seed builtin before this module either; they execute through the interpreter's service-invocation path (dispatch_shell), which evaluates argv expressions in the full evaluator and is untouched here. Dissolves when argv element evaluation lands, which is a separate lane."

type OperationRef {
  path: String
  service: String
  operation: String
}

fn operation_ref_label(at: OperationRef) -> String {
  join([at.service, ".", at.operation], "")
}

// The one place an OperationRef becomes a sentence fragment. A module that needs to NAME the
// operation it was talking to - a refusal renderer, a diagnostic, a receipt - would otherwise reach
// for the literal `git.Core.LsRemoteHeads`, which is a second textual naming scheme for something
// the declaration already names, and which drifts silently when the operation is renamed (DESIGN
// 3). Referring to the operation by OperationRef instead makes staleness DECIDABLE:
// shell_transport_operation_rows enumerates the declared rows, each carrying its own `at`, so a ref
// that names nothing is findable, whereas a free string in a sentence is not reachable from that
// enumeration at all.\n\nThe label omits `path` on purpose. path locates the declaration for a
// mechanism resolving the ref; a human reading a refusal wants the operation, and including a file
// path would put a storage fact into a domain sentence.

// The identity of one declared operation input. Every place this module names an input -- a
// binding, a refusal cause, a declared-input row, a template hole -- carries this type, so a hole
// and a binding compare as one identity rather than as two spellings (DESIGN 3).
// In production, operation_argv_bind_text / operation_argv_bind_text_list are the only places that
// mint it from a String; a fixture may cast a literal with `as OperationInputName` directly.
type OperationInputName = String where brand("OperationInputName")

type OperationInputValue
  = InputText { text: String }
  | InputTextList { items: List<String> }

type OperationInputBinding {
  name: OperationInputName
  value: OperationInputValue
}

type BoundOperationInvocation {
  at: OperationRef
  bindings: List<OperationInputBinding>
}

// A bound operation invocation is exactly an existing OperationRef paired with the existing
// declaration-owned OperationInputBinding vocabulary. It carries no argv, process, target-language,
// registry, or path-alias fact: argv remains derived from the referenced extdeps declaration by
// shell_materialize_operation_argv, and a realization chooses whether/how to transport it.

fn bind_operation_invocation(
  at: OperationRef,
  bindings: List<OperationInputBinding>
) -> BoundOperationInvocation {
  BoundOperationInvocation {
    at: at,
    bindings: bindings
  }
}

type ArgvRefusalCause
  = OperationNotFound
  | ArgvEmpty
  | UndeclaredInputBound { name: OperationInputName }
  | DuplicateInputBinding { name: OperationInputName }
  | DeclaredInputUnbound { name: OperationInputName }
  | ExecutablePositionNotLiteral { detail: String }
  | TokenListInStringPosition { name: OperationInputName }
  | ArgvExpressionUnsupported { detail: String }
  | BindingMalformed { detail: String }

// A transport string that interpolates a declared input, as a value: holes are OperationInputName, resolved
// against the operation's declared inputs by its consumer (XL-2 3b-ii). An expression in a hole is
// not a name and refuses as ArgvExpressionUnsupported; a list input in a hole refuses as
// TokenListInStringPosition. No new refusal vocabulary.
type ArgvTemplate = Template<OperationInputName>

type ArgvMaterialization
  = ArgvMaterialized { argv: List<String> }
  | ArgvMaterializationRefused { at: OperationRef, cause: ArgvRefusalCause }

type ShellTransportOperationRow {
  at: OperationRef
  declared_inputs: List<OperationInputName>
  argv_input_refs: List<OperationInputName>
}

fn operation_argv_bind_text(name: String, text: String) -> OperationInputBinding {
  OperationInputBinding {
    name: name as OperationInputName,
    value: InputText { text: text }
  }
}

fn operation_argv_bind_text_list(name: String, items: List<String>) -> OperationInputBinding {
  OperationInputBinding {
    name: name as OperationInputName,
    value: InputTextList { items: items }
  }
}

// ONE tagged classification, not a family of coproduct-to-Bool predicates (review 42972, the std/
// predicate-dissolution rule: a Bool predicate erases WHICH arm answered and becomes a second
// surface over the coproduct). Consumers fold ArgvMaterialization through this in a single pass and
// match the tag; it also means a corpus row materializes ONCE per row rather than once per question
// asked about it.

type ArgvRowClassification
  = ArgvRowMaterialized
  | ArgvRowExpressionResidue
  | ArgvRowExecutablePositionRefused
  | ArgvRowOtherRefusal

fn operation_argv_classify_cause(cause: ArgvRefusalCause) -> ArgvRowClassification {
  match cause {
    ArgvExpressionUnsupported { detail: _ } => ArgvRowExpressionResidue
    ExecutablePositionNotLiteral { detail: _ } => ArgvRowExecutablePositionRefused
    OperationNotFound => ArgvRowOtherRefusal
    ArgvEmpty => ArgvRowOtherRefusal
    UndeclaredInputBound { name: _ } => ArgvRowOtherRefusal
    DuplicateInputBinding { name: _ } => ArgvRowOtherRefusal
    DeclaredInputUnbound { name: _ } => ArgvRowOtherRefusal
    TokenListInStringPosition { name: _ } => ArgvRowOtherRefusal
    BindingMalformed { detail: _ } => ArgvRowOtherRefusal
  }
}

fn operation_argv_classify(m: ArgvMaterialization) -> ArgvRowClassification {
  match m {
    ArgvMaterialized { argv: _ } => ArgvRowMaterialized
    ArgvMaterializationRefused { at: _, cause: c } => operation_argv_classify_cause(cause: c)
  }
}

fn operation_argv_cause_label(cause: ArgvRefusalCause) -> String {
  match cause {
    OperationNotFound => "OperationNotFound"
    ArgvEmpty => "ArgvEmpty"
    UndeclaredInputBound { name: n } => concat("UndeclaredInputBound:", n as String)
    DuplicateInputBinding { name: n } => concat("DuplicateInputBinding:", n as String)
    DeclaredInputUnbound { name: n } => concat("DeclaredInputUnbound:", n as String)
    ExecutablePositionNotLiteral { detail: d } => concat("ExecutablePositionNotLiteral:", d)
    TokenListInStringPosition { name: n } => concat("TokenListInStringPosition:", n as String)
    ArgvExpressionUnsupported { detail: d } => concat("ArgvExpressionUnsupported:", d)
    BindingMalformed { detail: d } => concat("BindingMalformed:", d)
  }
}

fn operation_argv_ref_label(at: OperationRef) -> String {
  concat(concat(concat(concat(at.path, " "), at.service), "."), at.operation)
}

fn operation_argv_refusal_label(m: ArgvMaterialization) -> String {
  match m {
    ArgvMaterialized { argv: _ } => ""
    ArgvMaterializationRefused { at: a, cause: c } =>
      concat(concat(operation_argv_ref_label(at: a), " => "), operation_argv_cause_label(cause: c))
  }
}

fn operation_argv_tokens_or_refusal_label(m: ArgvMaterialization) -> List<String> {
  match m {
    ArgvMaterialized { argv: a } => a
    ArgvMaterializationRefused { at: _, cause: _ } => [operation_argv_refusal_label(m: m)]
  }
}

fn operation_argv_row_binding_for_input(name: OperationInputName) -> OperationInputBinding {
  operation_argv_bind_text(name: name as String, text: concat("bound-", name as String))
}

fn operation_argv_row_bindings(row: ShellTransportOperationRow) -> List<OperationInputBinding> {
  list_map(
    xs: row.declared_inputs,
    f: fn(n) { operation_argv_row_binding_for_input(name: n) }
  )
}
