module v2.std.string_straddle_probe

// TEMPORARY PROBE — not for landing. Decisive experiment for the effects de-fork:
// does a kernel `String` (std.types, realized Value::Str) flow into a modeled
// `v2.std.text.String` (= FreeMonoid<Char>) parameter without a typed refusal?
//
// std.effects.KeySource carries the kernel String; v2's Node projection must
// intern it via symbol_intern_lexeme, whose Lexeme = v2.std.text.String.
// If this typechecks, the crossing is silent (the model<->realization straddle).

import std.effects { KeySource, PathParam, InputField, CompositeKey }
import v2.std.compilers.lexing { symbol_intern_lexeme }
import v2.std.node { Symbol }

fn probe_intern_kernel_string(k: KeySource) -> Symbol {
  match k {
    PathParam { param: p } => symbol_intern_lexeme(lexeme: p)
    InputField { field: f } => symbol_intern_lexeme(lexeme: f)
    CompositeKey { fields: fs } => symbol_intern_lexeme(lexeme: "composite")
  }
}
