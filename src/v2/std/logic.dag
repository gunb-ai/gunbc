module v2.std.logic


type Bool = True | False
type BoolWidthFact {}
type BoolEncodingFact {}
type BoolPrimitiveFacts {
  width: BoolWidthFact
  encoding: BoolEncodingFact
}
data bool_primitive_facts: BoolPrimitiveFacts = BoolPrimitiveFacts {
  width: BoolWidthFact {},
  encoding: BoolEncodingFact {}
}
data bool_boolean_algebra: BooleanAlgebra<Bool> = std.algebra.BooleanAlgebra {
  meet: fn(a, b) {
    match a {
      True => b
      False => False
    }
  },
  join: fn(a, b) {
    match a {
      True => True
      False => b
    }
  },
  complement: fn(a) {
    match a {
      True => False
      False => True
    }
  },
  top: True,
  bottom: False
}

fn bool_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^bool_node_symbol } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn bool_fact_atom(id: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn bool_named_edge(name: v2.std.node.Symbol, target: v2.std.node.Node) -> v2.std.node.Edge {
  v2.std.node.Edge { label: v2.std.node.Named { name: name }, target: target }
}

fn bool_width_fact_node(width: BoolWidthFact) -> v2.std.node.Node {
  let _width = width
  bool_fact_atom(id: ^bool_spec_fact_width_one_bit)
}

fn bool_encoding_fact_node(encoding: BoolEncodingFact) -> v2.std.node.Node {
  let _encoding = encoding
  bool_fact_atom(id: ^bool_spec_fact_encoding_classical_two_valued)
}

fn bool_primitive_facts_node(facts: BoolPrimitiveFacts) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      bool_named_edge(
        name: ^bool_facts_field_width,
        target: bool_width_fact_node(width: facts.width)
      ),
      bool_named_edge(
        name: ^bool_facts_field_encoding,
        target: bool_encoding_fact_node(encoding: facts.encoding)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn bool_boolean_algebra_type_node() -> v2.std.node.Node {
  boolean_algebra_type_node(inhabitant: bool_node())
}

fn bool_boolean_algebra_node() -> v2.std.node.Node {
  boolean_algebra_node(inhabitant: bool_node())
}
