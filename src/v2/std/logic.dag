module v2.std.logic

import v2.std.algebra {
  BooleanAlgebra,
  BoundedLattice,
  Lattice,
  boolean_algebra_node,
  boolean_algebra_type_node
}
import v2.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode, SyntheticOccurrence }

type Bool = True | False
type BoolWidthFact {}
type BoolEncodingFact {}
type BoolPrimitiveFacts {
  width: BoolWidthFact
  encoding: BoolEncodingFact
}
data bool_primitive_facts: BoolPrimitiveFacts = BoolPrimitiveFacts {
  width: BoolWidthFact {},
  encoding: BoolEncodingFact {}
}
data bool_boolean_algebra: BooleanAlgebra<Bool> = BooleanAlgebra {
  meet: fn(a, b) {
    match a {
      True => b
      False => False
    }
  },
  join: fn(a, b) {
    match a {
      True => True
      False => b
    }
  },
  complement: fn(a) {
    match a {
      True => False
      False => True
    }
  },
  top: True,
  bottom: False
}

fn bool_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^bool_node_symbol } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn bool_fact_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn bool_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn bool_width_fact_node(width: BoolWidthFact) -> Node {
  let _width = width
  bool_fact_atom(id: ^bool_spec_fact_width_one_bit)
}

fn bool_encoding_fact_node(encoding: BoolEncodingFact) -> Node {
  let _encoding = encoding
  bool_fact_atom(id: ^bool_spec_fact_encoding_classical_two_valued)
}

fn bool_primitive_facts_node(facts: BoolPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      bool_named_edge(
        name: ^bool_facts_field_width,
        target: bool_width_fact_node(width: facts.width)
      ),
      bool_named_edge(
        name: ^bool_facts_field_encoding,
        target: bool_encoding_fact_node(encoding: facts.encoding)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn bool_boolean_algebra_type_node() -> Node {
  boolean_algebra_type_node(inhabitant: bool_node())
}

fn bool_boolean_algebra_node() -> Node {
  boolean_algebra_node(inhabitant: bool_node())
}
