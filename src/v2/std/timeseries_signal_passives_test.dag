// Scope: canonical S1 witnesses — spice passive projection + torsor carriers.

module v2.test.std.timeseries_signal_passives

import v2.std.collection { Absent, Present }
import v2.std.logic { Bool }
import v2.std.nat { Zero }
import v2.std.timeseries_signal {
  BranchCurrent,
  CapacitorPassive,
  GroundReference,
  InductorPassive,
  PotentialDifference,
  ResistorPassive,
  Voltage,
  Current,
  absolute_potential_from_named_preserves_reference,
  branch_current_of_magnitude,
  named_affine_voltage,
  passive_spec_from_component,
  passive_topology_from_component,
  potential_difference_of_magnitude,
  potential_reference_eq,
  potential_reference_of_named,
  timeseries_witness_spice_approx_zero,
  voltage,
  current,
}
import v2.extdeps.formats.spice {
  Capacitor,
  Ground,
  Inductor,
  Named,
  NamedNode,
  Resistor,
  SpiceValue
}
import v2.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  CompilesClaim,
  ManualAnchorAbsent,
  StructuralEqualsClaim,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}

data witness_voltage_zero: Voltage = voltage(0)

data witness_current_zero: Current = current(0)

test fn spice_resistor_projects_resistor_passive_topology_holds() -> Bool {
  let component = Resistor {
    name: ^r1,
    n_plus: Named { node: NamedNode { name: ^n1 } },
    n_minus: Ground,
    value: SpiceValue { lexeme: "1000" }
  }
  match passive_spec_from_component(component: component) {
    Present { value: ResistorPassive { topology: topo } } => topo.name == ^r1
    _ => false
  }
}

fn spice_capacitor_projects_capacitor_passive_arm_holds() -> Bool {
  let component = Capacitor {
    name: ^c1,
    n_plus: Named { node: NamedNode { name: ^n2 } },
    n_minus: Ground,
    value: SpiceValue { lexeme: "1e-6" }
  }
  match passive_spec_from_component(component: component) {
    Present { value: CapacitorPassive { topology: _ } } => true
    _ => false
  }
}

fn spice_inductor_projects_inductor_passive_arm_holds() -> Bool {
  let component = Inductor {
    name: ^l1,
    n_plus: Named { node: NamedNode { name: ^n3 } },
    n_minus: Ground,
    value: SpiceValue { lexeme: "1e-3" }
  }
  match passive_spec_from_component(component: component) {
    Present { value: InductorPassive { topology: _ } } => true
    _ => false
  }
}

fn passive_topology_preserves_component_name_holds() -> Bool {
  let component = Resistor {
    name: ^r9,
    n_plus: Named { node: NamedNode { name: ^n9 } },
    n_minus: Ground,
    value: SpiceValue { lexeme: "47" }
  }
  match passive_topology_from_component(component: component) {
    Present { value: topo } => topo.name == ^r9
    Absent => false
  }
}

fn named_affine_voltage_preserves_ground_reference_holds() -> Bool {
  let named = named_affine_voltage(
    reference: GroundReference,
    approx: timeseries_witness_spice_approx_zero
  )
  potential_reference_eq(
    left: potential_reference_of_named(named: named),
    right: GroundReference
  )
}

fn absolute_potential_from_named_preserves_reference_holds() -> Bool {
  let named = named_affine_voltage(
    reference: GroundReference,
    approx: timeseries_witness_spice_approx_zero
  )
  absolute_potential_from_named_preserves_reference(
    named: named,
    magnitude: witness_voltage_zero
  )
}

data claim_spice_resistor_passive_spec: TestClaim = BoolWitnessClaim {
  label: "std/timeseries_signal: spice Resistor projects ResistorPassive topology",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  witness: BoolWitness { holds: spice_resistor_projects_resistor_passive_topology_holds() },
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_spice_capacitor_passive_arm: TestClaim = BoolWitnessClaim {
  label: "std/timeseries_signal: spice Capacitor projects CapacitorPassive arm",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  witness: BoolWitness { holds: spice_capacitor_projects_capacitor_passive_arm_holds() },
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_spice_inductor_passive_arm: TestClaim = BoolWitnessClaim {
  label: "std/timeseries_signal: spice Inductor projects InductorPassive arm",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  witness: BoolWitness { holds: spice_inductor_projects_inductor_passive_arm_holds() },
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_passive_topology_preserves_name: TestClaim = BoolWitnessClaim {
  label: "std/timeseries_signal: passive_topology_from_component preserves name",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  witness: BoolWitness { holds: passive_topology_preserves_component_name_holds() },
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_named_affine_voltage_preserves_reference: TestClaim = BoolWitnessClaim {
  label: "std/timeseries_signal: named_affine_voltage preserves GroundReference",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  witness: BoolWitness { holds: named_affine_voltage_preserves_ground_reference_holds() },
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_absolute_potential_preserves_reference: TestClaim = BoolWitnessClaim {
  label: "std/timeseries_signal: absolute_potential_from_named preserves reference",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  witness: BoolWitness { holds: absolute_potential_from_named_preserves_reference_holds() },
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_potential_difference_of_magnitude_structural: TestClaim = StructuralEqualsClaim {
  label: "std/timeseries_signal: potential_difference_of_magnitude is structural identity",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: PotentialDifference { magnitude: witness_voltage_zero },
  rhs: potential_difference_of_magnitude(magnitude: witness_voltage_zero),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_branch_current_of_magnitude_structural: TestClaim = StructuralEqualsClaim {
  label: "std/timeseries_signal: branch_current_of_magnitude is structural identity",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: BranchCurrent { magnitude: witness_current_zero },
  rhs: branch_current_of_magnitude(magnitude: witness_current_zero),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_timeseries_signal_module_compiles: TestClaim = CompilesClaim {
  label: "std/timeseries_signal: torsor + spice projection + map/fold passives compile",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: GroundReference,
  expected_value: GroundReference,
  classification: TestClassification { tier: Tier1, layer: Unit }
}
