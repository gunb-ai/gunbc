module v2.test.std.timeseries_signal_passives


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data witness_voltage_zero: Voltage = voltage(0)

data witness_current_zero: Current = current(0)

test fn named_affine_voltage_preserves_ground_reference_holds() -> Bool {
  let named = named_affine_voltage(
    reference: GroundReference,
    approx: timeseries_witness_approx_zero
  )
  potential_reference_eq(
    left: potential_reference_of_named(named: named),
    right: GroundReference
  )
}

test fn absolute_potential_from_named_preserves_reference_holds() -> Bool {
  let named = named_affine_voltage(
    reference: GroundReference,
    approx: timeseries_witness_approx_zero
  )
  absolute_potential_from_named_preserves_reference(
    named: named,
    magnitude: witness_voltage_zero
  )
}

data claim_potential_difference_of_magnitude_structural: TestClaim = StructuralEqualsClaim {
  label: "std/timeseries_signal: potential_difference_of_magnitude is structural identity",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: PotentialDifference { magnitude: witness_voltage_zero },
  rhs: potential_difference_of_magnitude(magnitude: witness_voltage_zero),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_branch_current_of_magnitude_structural: TestClaim = StructuralEqualsClaim {
  label: "std/timeseries_signal: branch_current_of_magnitude is structural identity",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: BranchCurrent { magnitude: witness_current_zero },
  rhs: branch_current_of_magnitude(magnitude: witness_current_zero),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_timeseries_signal_module_compiles: TestClaim = CompilesClaim {
  label: "std/timeseries_signal: torsor + passive topology + map/fold passives compile",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: GroundReference,
  expected_value: GroundReference,
  classification: TestClassification { tier: Tier1, layer: Unit }
}
