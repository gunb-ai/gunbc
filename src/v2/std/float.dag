module v2.std.float

type Float32Interchange = v2.std.machine.Word32
type Float64Interchange = v2.std.machine.Word64

type FloatSpecial
  = QuietNan
  | SignalingNan
  | PosInfinity
  | NegInfinity

type FloatBody
  = Finite {
      sign: std.bit.Bit
      biased_exponent: v2.std.nat.Nat
      trailing_significand: v2.std.nat.Nat
    }
  | NonFinite { tag: FloatSpecial }

type Float32 {
  body: FloatBody
}

type Float64 {
  body: FloatBody
}
type Float = Float64
fn sign_rank_lex(s: v2.std.machine.Bit) -> v2.std.nat.Nat {
  match s {
    true => v2.std.nat.Zero
    false => v2.std.nat.Succ { prev: v2.std.nat.Zero }
  }
}
fn ordering_invert(o: v2.std.algebra.Ordering) -> v2.std.algebra.Ordering {
  match o {
    Less => Greater
    Greater => Less
    Equal => Equal
  }
}
fn float_finite_unsigned_field_order(
  ea: v2.std.nat.Nat,
  fa: v2.std.nat.Nat,
  eb: v2.std.nat.Nat,
  fb: v2.std.nat.Nat,
) -> v2.std.algebra.Ordering {
  let o2 = v2.std.nat.nat_compare(a: ea, b: eb)
  match o2 {
    Less => Less
    Greater => Greater
    Equal => v2.std.nat.nat_compare(a: fa, b: fb)
  }
}

fn float_special_rank(t: FloatSpecial) -> v2.std.nat.Nat {
  match t {
    NegInfinity => v2.std.nat.Zero
    PosInfinity => v2.std.nat.Succ { prev: v2.std.nat.Zero }
    QuietNan => v2.std.nat.Succ { prev: v2.std.nat.Succ { prev: v2.std.nat.Zero } }
    SignalingNan => v2.std.nat.Succ { prev: v2.std.nat.Succ { prev: v2.std.nat.Succ { prev: v2.std.nat.Zero } } }
  }
}

fn float_body_is_nan(x: FloatBody) -> Bool {
  match x {
    NonFinite { tag: QuietNan } => true
    NonFinite { tag: SignalingNan } => true
    _ => false
  }
}
fn float_finite_magnitude_zero(e: v2.std.nat.Nat, f: v2.std.nat.Nat) -> Bool {
  is_zero(e) && is_zero(f)
}
fn float_body_compare_semantic_total(a: FloatBody, b: FloatBody) -> v2.std.algebra.Ordering {
  match a {
    Finite { sign: sa, biased_exponent: ea, trailing_significand: fa } => match b {
      Finite { sign: sb, biased_exponent: eb, trailing_significand: fb } => {
        let o = v2.std.nat.nat_compare(a: sign_rank_lex(sa), b: sign_rank_lex(sb))
        match o {
          Less => Less
          Greater => Greater
          Equal => {
            let mag = float_finite_unsigned_field_order(
              ea: ea,
              fa: fa,
              eb: eb,
              fb: fb,
            )
            match sa {
              true => ordering_invert(o: mag)
              false => mag
            }
          }
        }
      }
      NonFinite { tag: tb } => match tb {
        NegInfinity => Greater
        _ => Less
      }
    }
    NonFinite { tag: ta } => match b {
      Finite {
        sign: sb
        biased_exponent: eb
        trailing_significand: fb
      } => match ta {
        NegInfinity => Less
        _ => Greater
      }
      NonFinite { tag: tb } => v2.std.nat.nat_compare(
        a: float_special_rank(ta),
        b: float_special_rank(tb)
      )
    }
  }
}
fn float_body_compare_ieee_ordered_outcome(a: FloatBody, b: FloatBody) -> Outcome<v2.std.algebra.Ordering> {
  if float_body_is_nan(a) {
    float_ordered_compare_nan_rejected()
  } else {
    if float_body_is_nan(b) {
      float_ordered_compare_nan_rejected()
    } else {
      v2.std.diagnostic.Accepted { value: match a {
          Finite { sign: sa, biased_exponent: ea, trailing_significand: fa } => match b {
            Finite { sign: sb, biased_exponent: eb, trailing_significand: fb } => {
              if float_finite_magnitude_zero(e: ea, f: fa)
                && float_finite_magnitude_zero(e: eb, f: fb)
              {
                Equal
              } else {
                float_body_compare_semantic_total(a: a, b: b)
              }
            }
            NonFinite { tag: tb } => float_body_compare_semantic_total(a: a, b: b)
          }
          NonFinite { tag: ta } => float_body_compare_semantic_total(a: a, b: b)
        }, diagnostics: v2.std.diagnostic.None }
    }
  }
}
fn float_ordered_compare_nan_rejected() -> Outcome<v2.std.algebra.Ordering> {
  Rejected { diagnostics: diagnostics_singleton(d: v2.std.diagnostic.Diagnostic {
      reason: ^float_totalizer_reason_ieee754_nan_unordered,
      at: port_locus(port: ^float_totalizer_port_ieee754_nan_totalizer),
      correction: v2.std.diagnostic.Unavailable { reason: UserInputBoundary },
    }) }
}
fn float_ieee_ordered_compare_outcome(a: Float, b: Float) -> Outcome<v2.std.algebra.Ordering> {
  float_body_compare_ieee_ordered_outcome(a: a.body, b: b.body)
}
fn float_ordered_compare_tier2(a: Float, b: Float) -> Outcome<v2.std.algebra.Ordering> {
  float_ieee_ordered_compare_outcome(a: a, b: b)
}

type NaNPropagation
  = QuietNaNPropagation
  | SignalingNaNEnabled

type InfPropagation
  = IEEEInfinityPropagation
  | SaturatingInf

type FloatExceptionDisposition
  = SilentDefaultResult
  | TrapEnabled
  | FastMathUndefined
