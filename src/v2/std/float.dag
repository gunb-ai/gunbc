// src/v2/std/float.dag
// Scope: IEEE-754 Float32/Float64 interchange, specials, body carriers, and ordered compare semantics.
// Consumes: std/node.dag (Symbol); std/machine.dag (Bit, Word32, Word64); std/algebra.dag (Ordering, Less, Equal, Greater); std/diagnostic.dag (Diagnostic, Outcome, PortLocus, Produced, Rejected, Unavailable, UserInputBoundary); std/logic.dag (Bool); std/nat.dag (Nat, is_zero, nat_compare).
// Status: std float vocabulary (32/64, specials, IEEE-ordered compare).
// Anchor: https://en.wikipedia.org/wiki/IEEE_754
// Ledger: CP-3229-GREEN-TERMINAL, SL-3229-FLOAT-DISPOSITION, SL-3229-FLOAT-NOMINAL.
// 🟢

module v2.std.float


import v2.std.algebra { Ordering, Less, Equal, Greater }
import v2.std.diagnostic { Diagnostic, Outcome, port_locus, Unavailable, UserInputBoundary, Accepted, None, diagnostics_singleton }
import v2.std.logic { Bool }
import v2.std.machine { Bit, Word32, Word64 }
import v2.std.nat { Nat, nat_compare, is_zero }
import v2.std.node { Symbol }
type Float32Interchange = Word32
type Float64Interchange = Word64
// 🟢 coproduct dissolution · CP-3229-GREEN-TERMINAL.
type FloatSpecial
  = QuietNan
  | SignalingNan
  | PosInfinity
  | NegInfinity
// 🟢 coproduct dissolution · CP-3229-GREEN-TERMINAL.
type FloatBody
  = Finite {
      sign: Bit
      biased_exponent: Nat
      trailing_significand: Nat
    }
  | NonFinite { tag: FloatSpecial }

// 🟢 grounded.
type Float32 {
  body: FloatBody
}

// 🟢 grounded.
type Float64 {
  body: FloatBody
}
type Float = Float64
fn sign_rank_lex(s: Bit) -> Nat {
  match s {
    true => Zero
    false => Succ { prev: Zero }
  }
}
fn ordering_invert(o: Ordering) -> Ordering {
  match o {
    Less => Greater
    Greater => Less
    Equal => Equal
  }
}
fn float_finite_unsigned_field_order(
  ea: Nat,
  fa: Nat,
  eb: Nat,
  fb: Nat,
) -> Ordering {
  let o2 = nat_compare(a: ea, b: eb)
  match o2 {
    Less => Less
    Greater => Greater
    Equal => nat_compare(a: fa, b: fb)
  }
}


fn float_special_rank(t: FloatSpecial) -> Nat {
  match t {
    NegInfinity => Zero
    PosInfinity => Succ { prev: Zero }
    QuietNan => Succ { prev: Succ { prev: Zero } }
    SignalingNan => Succ { prev: Succ { prev: Succ { prev: Zero } } }
  }
}


fn float_body_is_nan(x: FloatBody) -> Bool {
  match x {
    NonFinite { tag: QuietNan } => true
    NonFinite { tag: SignalingNan } => true
    _ => false
  }
}
fn float_finite_magnitude_zero(e: Nat, f: Nat) -> Bool {
  is_zero(e) && is_zero(f)
}
fn float_body_compare_semantic_total(a: FloatBody, b: FloatBody) -> Ordering {
  match a {
    Finite { sign: sa, biased_exponent: ea, trailing_significand: fa } => match b {
      Finite { sign: sb, biased_exponent: eb, trailing_significand: fb } => {
        let o = nat_compare(a: sign_rank_lex(sa), b: sign_rank_lex(sb))
        match o {
          Less => Less
          Greater => Greater
          Equal => {
            let mag = float_finite_unsigned_field_order(
              ea: ea,
              fa: fa,
              eb: eb,
              fb: fb,
            )
            match sa {
              true => ordering_invert(o: mag)
              false => mag
            }
          }
        }
      }
      NonFinite { tag: tb } => match tb {
        NegInfinity => Greater
        _ => Less
      }
    }
    NonFinite { tag: ta } => match b {
      Finite {
        sign: sb
        biased_exponent: eb
        trailing_significand: fb
      } => match ta {
        NegInfinity => Less
        _ => Greater
      }
      NonFinite { tag: tb } => nat_compare(
        a: float_special_rank(ta),
        b: float_special_rank(tb)
      )
    }
  }
}
fn float_body_compare_ieee_ordered_outcome(a: FloatBody, b: FloatBody) -> Outcome<Ordering> {
  if float_body_is_nan(a) {
    float_ordered_compare_nan_rejected()
  } else {
    if float_body_is_nan(b) {
      float_ordered_compare_nan_rejected()
    } else {
      Accepted { value: match a {
          Finite { sign: sa, biased_exponent: ea, trailing_significand: fa } => match b {
            Finite { sign: sb, biased_exponent: eb, trailing_significand: fb } => {
              if float_finite_magnitude_zero(e: ea, f: fa)
                && float_finite_magnitude_zero(e: eb, f: fb)
              {
                Equal
              } else {
                float_body_compare_semantic_total(a: a, b: b)
              }
            }
            NonFinite { tag: tb } => float_body_compare_semantic_total(a: a, b: b)
          }
          NonFinite { tag: ta } => float_body_compare_semantic_total(a: a, b: b)
        }, diagnostics: None }
    }
  }
}
fn float_ordered_compare_nan_rejected() -> Outcome<Ordering> {
  Rejected { diagnostics: diagnostics_singleton(d: Diagnostic {
      reason: ^float_totalizer_reason_ieee754_nan_unordered,
      at: port_locus(port: ^float_totalizer_port_ieee754_nan_totalizer),
      correction: Unavailable { reason: UserInputBoundary },
    }) }
}
fn float_ieee_ordered_compare_outcome(a: Float, b: Float) -> Outcome<Ordering> {
  float_body_compare_ieee_ordered_outcome(a: a.body, b: b.body)
}
fn float_ordered_compare_tier2(a: Float, b: Float) -> Outcome<Ordering> {
  float_ieee_ordered_compare_outcome(a: a, b: b)
}


// 🟡 coproduct dissolution — SL-3229-FLOAT-DISPOSITION — feature:float-nan-propagation-semantics — dissolve-on-arrival: SignalingNaNEnabled gains a target-backed trap handler path consumed by a T-4 language fact-bundle.
type NaNPropagation
  = QuietNaNPropagation
  | SignalingNaNEnabled


// 🟡 coproduct dissolution — SL-3229-FLOAT-DISPOSITION — feature:float-inf-propagation-semantics — dissolve-on-arrival: SaturatingInf gains a target-backed clamp semantic consumed by a T-4 fact-bundle (e.g. DSP target).
type InfPropagation
  = IEEEInfinityPropagation
  | SaturatingInf


// 🟡 coproduct dissolution — SL-3229-FLOAT-DISPOSITION — feature:float-exception-disposition-semantics — dissolve-on-arrival: TrapEnabled or FastMathUndefined gain target-backed exception handler paths consumed by T-4 fact-bundles.
type FloatExceptionDisposition
  = SilentDefaultResult
  | TrapEnabled
  | FastMathUndefined
