module v2.std.inhabitant_bridge

import v2.std.node { Node, Edge, TypeNode, Conj, SyntheticOccurrence }

fn inhabitant_pair_node(atom_edge: Edge, facts_edge: Edge) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [atom_edge, facts_edge],
    occurrence_id: SyntheticOccurrence
  }
}
