module v2.std.probe_selector


type DiagnosticInterfaceKind
  = DiagnosticSsh
  | DiagnosticIpmi
  | DiagnosticRedfish
  | DiagnosticEdac
  | DiagnosticDockerReachability
  | DiagnosticBmcSensors

type DiagnosticCapabilityFacts {
  interfaces: List<DiagnosticInterfaceKind>
}

type HostSupplyProjectionInput {
  identity: String
  isolation_is_vm: Bool
}

type CostBudget {
  max_cost: Int
}

type SuspectedCausePrior<C> {
  hypothesis: C
}

type HostHealthHypothesis
  = HostHealthHypothesisReachability
  | HostHealthHypothesisStandoffCapVddq

type HostHealthProbeKind
  = HostHealthProbeDockerReachability
  | HostHealthProbeEdacSummary
  | HostHealthProbeEccWatchedStress

type ProbePrior
  = HostHealthPrior { hypothesis: HostHealthHypothesis }
  | CiAffectedPrior { affected: AffectedSet }
  | CiRerunPrior { frontier: List<Node> }
  | CiFailClosedPrior {}

type ProbeCatalogEntry {
  label: String
  coverage: Int
  cost: Int
  requires: List<DiagnosticInterfaceKind>
}

type ProbeCatalog<P> {
  entries: List<ProbeCatalogEntry>
}

type ProbeResult {
  passed: Bool
}

type TemporalAggregator {
  consecutive_failures: Int
  first_failed_at_ms: Int
  min_failures: Int
  min_down_ms: Int
}

data ci_probe_requires_none: List<DiagnosticInterfaceKind> = []

data probe_ci_unbounded_budget: CostBudget = CostBudget { max_cost: 1000000 }

data host_health_hypothesis_reachability: HostHealthHypothesis = HostHealthHypothesisReachability
data host_health_hypothesis_standoff_cap_vddq: HostHealthHypothesis = HostHealthHypothesisStandoffCapVddq

fn diagnostic_interface_kind_eq(
  left: DiagnosticInterfaceKind,
  right: DiagnosticInterfaceKind
) -> Bool {
  match left {
    DiagnosticSsh =>
      match right {
        DiagnosticSsh => true
        _ => false
      }
    DiagnosticIpmi =>
      match right {
        DiagnosticIpmi => true
        _ => false
      }
    DiagnosticRedfish =>
      match right {
        DiagnosticRedfish => true
        _ => false
      }
    DiagnosticEdac =>
      match right {
        DiagnosticEdac => true
        _ => false
      }
    DiagnosticDockerReachability =>
      match right {
        DiagnosticDockerReachability => true
        _ => false
      }
    DiagnosticBmcSensors =>
      match right {
        DiagnosticBmcSensors => true
        _ => false
      }
  }
}

fn diagnostic_capability_contains(
  available: DiagnosticCapabilityFacts,
  required: DiagnosticInterfaceKind
) -> Bool {
  contains(
    xs: available.interfaces,
    item: required,
    eq: diagnostic_interface_kind_eq
  )
}

fn diagnostic_all_requires_available(
  requires: List<DiagnosticInterfaceKind>,
  available: DiagnosticCapabilityFacts
) -> Bool {
  fold_list(
    xs: requires,
    empty: true,
    cons: fn(acc, req) {
      acc && diagnostic_capability_contains(available: available, required: req)
    }
  )
}

fn probe_catalog_entry_cost(entry: ProbeCatalogEntry) -> Int {
  entry.cost
}

fn probe_catalog_entry_coverage(entry: ProbeCatalogEntry) -> Int {
  entry.coverage
}

fn probe_catalog_entry_label(entry: ProbeCatalogEntry) -> String {
  entry.label
}

fn probe_catalog_entry_requires(
  entry: ProbeCatalogEntry
) -> List<DiagnosticInterfaceKind> {
  entry.requires
}

fn probe_catalog_entry_within_budget(
  entry: ProbeCatalogEntry,
  budget: CostBudget
) -> Bool {
  probe_catalog_entry_cost(entry: entry) <= budget.max_cost
}

fn probe_effective_coverage(entry: ProbeCatalogEntry, prior: ProbePrior) -> Int {
  match prior {
    HostHealthPrior { hypothesis: hypothesis } =>
      host_probe_effective_coverage_for_hypothesis(entry: entry, hypothesis: hypothesis)
    CiAffectedPrior { affected: _ } =>
      probe_catalog_entry_coverage(entry: entry)
    CiRerunPrior { frontier: _ } =>
      probe_catalog_entry_coverage(entry: entry)
    CiFailClosedPrior {} =>
      probe_catalog_entry_coverage(entry: entry)
  }
}

fn host_probe_effective_coverage_for_hypothesis(
  entry: ProbeCatalogEntry,
  hypothesis: HostHealthHypothesis
) -> Int {
  let base = probe_catalog_entry_coverage(entry: entry)
  match hypothesis {
    HostHealthHypothesisReachability =>
      if probe_catalog_entry_matches_host_probe(
        entry: entry,
        kind: HostHealthProbeDockerReachability
      ) {
        base
      } else {
        0
      }
    HostHealthHypothesisStandoffCapVddq =>
      if probe_catalog_entry_matches_host_probe(
        entry: entry,
        kind: HostHealthProbeEccWatchedStress
      ) {
        base
      } else {
        0
      }
  }
}

fn probe_discrimination_tied(
  left: ProbeCatalogEntry,
  right: ProbeCatalogEntry,
  left_coverage: Int,
  right_coverage: Int
) -> Bool {
  !probe_discrimination_beats_with_coverage(
    challenger: left,
    challenger_coverage: left_coverage,
    incumbent: right,
    incumbent_coverage: right_coverage
  )
    && !probe_discrimination_beats_with_coverage(
      challenger: right,
      challenger_coverage: right_coverage,
      incumbent: left,
      incumbent_coverage: left_coverage
    )
}

fn probe_discrimination_beats_with_coverage(
  challenger: ProbeCatalogEntry,
  challenger_coverage: Int,
  incumbent: ProbeCatalogEntry,
  incumbent_coverage: Int
) -> Bool {
  let challenger_cost = probe_catalog_entry_cost(entry: challenger)
  let incumbent_cost = probe_catalog_entry_cost(entry: incumbent)
  challenger_coverage * incumbent_cost > incumbent_coverage * challenger_cost
}

fn probe_select_best_under_budget(
  entries: List<ProbeCatalogEntry>,
  budget: CostBudget,
  available: DiagnosticCapabilityFacts,
  prior: ProbePrior
) -> List<ProbeCatalogEntry> {
  let eligible = filter(
    xs: entries,
    predicate: fn(entry) {
      let effective = probe_effective_coverage(entry: entry, prior: prior)
      diagnostic_all_requires_available(
        requires: probe_catalog_entry_requires(entry: entry),
        available: available
      )
        && effective > 0
        && probe_catalog_entry_cost(entry: entry) > 0
        && probe_catalog_entry_within_budget(entry: entry, budget: budget)
    }
  )
  let best_singleton = fold_list(
    xs: eligible,
    empty: Empty,
    cons: fn(best, entry) {
      match best {
        Empty =>
          Cons { head: entry, tail: Empty }
        Cons { head: current, tail: _ } =>
          match probe_discrimination_beats_with_coverage(
            challenger: entry,
            challenger_coverage: probe_effective_coverage(entry: entry, prior: prior),
            incumbent: current,
            incumbent_coverage: probe_effective_coverage(entry: current, prior: prior)
          ) {
            true => Cons { head: entry, tail: Empty }
            false => best
          }
      }
    }
  )
  match best_singleton {
    Empty => Empty
    Cons { head: best, tail: _ } =>
      filter(
        xs: eligible,
        predicate: fn(entry) {
          probe_discrimination_tied(
            left: entry,
            right: best,
            left_coverage: probe_effective_coverage(entry: entry, prior: prior),
            right_coverage: probe_effective_coverage(entry: best, prior: prior)
          )
        }
      )
  }
}

fn ci_test_claim_coverage_for_frontier(claim: TestClaim, frontier: List<Node>) -> Int {
  if test_claim_ci_selection_fail_closed(c: claim) {
    1
  } else {
    if test_claim_evaluation_touches_rerun_frontier(c: claim, frontier: frontier) {
      1
    } else {
      0
    }
  }
}

fn ci_test_claim_coverage_for_affected(claim: TestClaim, affected: AffectedSet) -> Int {
  if test_claim_ci_selection_fail_closed(c: claim) {
    1
  } else {
    match affected_set_rerun_nodes(affected_set_value: affected) {
      RerunNodeSetProduced { nodes: nodes } =>
        if test_claim_evaluation_touches_rerun_frontier(c: claim, frontier: nodes) {
          1
        } else {
          0
        }
      RerunNodeSetFailClosed { evidence: _ } => 1
    }
  }
}

fn ci_test_claim_coverage(claim: TestClaim, prior: ProbePrior) -> Int {
  match prior {
    HostHealthPrior { hypothesis: _ } => 0
    CiAffectedPrior { affected: affected } =>
      ci_test_claim_coverage_for_affected(claim: claim, affected: affected)
    CiRerunPrior { frontier: frontier } =>
      ci_test_claim_coverage_for_frontier(claim: claim, frontier: frontier)
    CiFailClosedPrior {} => 1
  }
}

fn ci_probe_catalog_entry_for_claim_with_prior(
  claim: TestClaim,
  prior: ProbePrior
) -> ProbeCatalogEntry {
  ProbeCatalogEntry {
    label: test_claim_label(c: claim),
    coverage: ci_test_claim_coverage(claim: claim, prior: prior),
    cost: 1,
    requires: ci_probe_requires_none
  }
}

fn ci_probe_catalog_entries_from_roster_with_prior(
  roster: List<TestClaim>,
  prior: ProbePrior
) -> List<ProbeCatalogEntry> {
  fold_list_right(
    xs: roster,
    empty: Empty,
    snoc: fn(acc, claim) {
      Cons {
        head: ci_probe_catalog_entry_for_claim_with_prior(claim: claim, prior: prior),
        tail: acc
      }
    }
  )
}

fn probe_catalog_for_prior(
  prior: ProbePrior,
  roster: List<TestClaim>
) -> ProbeCatalog<String> {
  match prior {
    HostHealthPrior { hypothesis: _ } =>
      host_health_probe_catalog
    CiAffectedPrior { affected: _ } =>
      ProbeCatalog { entries: ci_probe_catalog_entries_from_roster_with_prior(roster: roster, prior: prior) }
    CiRerunPrior { frontier: _ } =>
      ProbeCatalog { entries: ci_probe_catalog_entries_from_roster_with_prior(roster: roster, prior: prior) }
    CiFailClosedPrior {} =>
      ProbeCatalog { entries: ci_probe_catalog_entries_from_roster_with_prior(roster: roster, prior: prior) }
  }
}

fn probe_select(
  prior: ProbePrior,
  budget: CostBudget,
  available: DiagnosticCapabilityFacts,
  roster: List<TestClaim>
) -> List<ProbeCatalogEntry> {
  let catalog = probe_catalog_for_prior(prior: prior, roster: roster)
  probe_select_best_under_budget(
    entries: catalog.entries,
    budget: budget,
    available: available,
    prior: prior
  )
}

fn test_claim_selected_by_probe_catalog(
  claim: TestClaim,
  selected: List<ProbeCatalogEntry>
) -> Bool {
  probe_catalog_contains_label(
    selected: selected,
    label: test_claim_label(c: claim)
  )
}

fn probe_select_test_claims(
  roster: List<TestClaim>,
  prior: ProbePrior,
  budget: CostBudget,
  available: DiagnosticCapabilityFacts
) -> List<TestClaim> {
  let selected = probe_select(
    prior: prior,
    budget: budget,
    available: available,
    roster: roster
  )
  filter(
    xs: roster,
    predicate: fn(claim) {
      test_claim_selected_by_probe_catalog(claim: claim, selected: selected)
    }
  )
}

fn probe_select_affected_test_claims(
  roster: List<TestClaim>,
  affected: AffectedSet,
  budget: CostBudget,
  available: DiagnosticCapabilityFacts
) -> List<TestClaim> {
  probe_select_test_claims(
    roster: roster,
    prior: CiAffectedPrior { affected: affected },
    budget: budget,
    available: available
  )
}

fn probe_select_rerun_test_claims(
  roster: List<TestClaim>,
  frontier: List<Node>,
  budget: CostBudget,
  available: DiagnosticCapabilityFacts
) -> List<TestClaim> {
  probe_select_test_claims(
    roster: roster,
    prior: CiRerunPrior { frontier: frontier },
    budget: budget,
    available: available
  )
}

fn temporal_aggregator_drainable(
  agg: TemporalAggregator,
  now_ms: Int
) -> Bool {
  agg.consecutive_failures >= agg.min_failures
    && (now_ms - agg.first_failed_at_ms) >= agg.min_down_ms
}

fn host_supply_projection_input(
  identity: String,
  isolation_is_vm: Bool
) -> HostSupplyProjectionInput {
  HostSupplyProjectionInput {
    identity: identity,
    isolation_is_vm: isolation_is_vm
  }
}

data diagnostic_capability_ssh_only: List<DiagnosticInterfaceKind> = [
  DiagnosticSsh,
  DiagnosticDockerReachability
]

data diagnostic_capability_srv_bare_metal: List<DiagnosticInterfaceKind> = [
  DiagnosticSsh,
  DiagnosticIpmi,
  DiagnosticRedfish,
  DiagnosticEdac,
  DiagnosticDockerReachability,
  DiagnosticBmcSensors
]

fn diagnostic_capability_from_host_supply(
  input: HostSupplyProjectionInput
) -> DiagnosticCapabilityFacts {
  match input.isolation_is_vm {
    true =>
      DiagnosticCapabilityFacts { interfaces: diagnostic_capability_ssh_only }
    false =>
      DiagnosticCapabilityFacts { interfaces: diagnostic_capability_srv_bare_metal }
  }
}

data host_supply_srv1: HostSupplyProjectionInput = host_supply_projection_input(
  identity: "srv1",
  isolation_is_vm: false
)

data host_supply_srv2: HostSupplyProjectionInput = host_supply_projection_input(
  identity: "srv2",
  isolation_is_vm: false
)

data host_supply_cloud_vm: HostSupplyProjectionInput = host_supply_projection_input(
  identity: "hetzner:cax41",
  isolation_is_vm: true
)

fn diagnostic_capability_srv1() -> DiagnosticCapabilityFacts {
  diagnostic_capability_from_host_supply(input: host_supply_srv1)
}

fn diagnostic_capability_srv2() -> DiagnosticCapabilityFacts {
  diagnostic_capability_from_host_supply(input: host_supply_srv2)
}

fn diagnostic_capability_cloud_vm() -> DiagnosticCapabilityFacts {
  diagnostic_capability_from_host_supply(input: host_supply_cloud_vm)
}

fn diagnostic_capability_ci_in_repo() -> DiagnosticCapabilityFacts {
  DiagnosticCapabilityFacts {
    interfaces: Cons {
      head: DiagnosticSsh,
      tail: Cons { head: DiagnosticDockerReachability, tail: Empty }
    }
  }
}

data host_probe_docker_reachability: ProbeCatalogEntry = ProbeCatalogEntry {
  label: "docker-reachability",
  coverage: 10,
  cost: 1,
  requires: Cons { head: DiagnosticDockerReachability, tail: Empty }
}

data host_probe_edac_summary: ProbeCatalogEntry = ProbeCatalogEntry {
  label: "edac-correctable-summary",
  coverage: 40,
  cost: 2,
  requires: Cons { head: DiagnosticEdac, tail: Empty }
}

data host_probe_ipmi_ecc_stress: ProbeCatalogEntry = ProbeCatalogEntry {
  label: "ecc-watched-stress",
  coverage: 101,
  cost: 5,
  requires: Cons {
    head: DiagnosticIpmi,
    tail: Cons { head: DiagnosticBmcSensors, tail: Cons { head: DiagnosticEdac, tail: Empty } }
  }
}

data host_health_probe_catalog_entries: List<ProbeCatalogEntry> = [
  host_probe_docker_reachability,
  host_probe_edac_summary,
  host_probe_ipmi_ecc_stress
]

data host_health_probe_catalog: ProbeCatalog<String> = ProbeCatalog {
  entries: host_health_probe_catalog_entries
}

fn probe_catalog_entry_label_eq(entry: ProbeCatalogEntry, label: String) -> Bool {
  probe_catalog_entry_label(entry: entry) == label
}

fn probe_catalog_contains_label(
  selected: List<ProbeCatalogEntry>,
  label: String
) -> Bool {
  count_where(
    xs: selected,
    predicate: fn(entry) { probe_catalog_entry_label_eq(entry: entry, label: label) }
  ) > 0
}

fn host_health_probe_canonical_entry(kind: HostHealthProbeKind) -> ProbeCatalogEntry {
  match kind {
    HostHealthProbeDockerReachability => host_probe_docker_reachability
    HostHealthProbeEdacSummary => host_probe_edac_summary
    HostHealthProbeEccWatchedStress => host_probe_ipmi_ecc_stress
  }
}

fn probe_catalog_entry_matches_host_probe(
  entry: ProbeCatalogEntry,
  kind: HostHealthProbeKind
) -> Bool {
  let canonical = host_health_probe_canonical_entry(kind: kind)
  probe_catalog_entry_label_eq(
    entry: entry,
    label: probe_catalog_entry_label(entry: canonical)
  )
}

fn probe_catalog_contains_host_probe_kind(
  selected: List<ProbeCatalogEntry>,
  kind: HostHealthProbeKind
) -> Bool {
  count_where(
    xs: selected,
    predicate: fn(entry) {
      probe_catalog_entry_matches_host_probe(entry: entry, kind: kind)
    }
  ) > 0
}

fn probe_select_host_health(
  prior: SuspectedCausePrior<HostHealthHypothesis>,
  budget: CostBudget,
  available: DiagnosticCapabilityFacts
) -> List<ProbeCatalogEntry> {
  probe_select(
    prior: HostHealthPrior { hypothesis: prior.hypothesis },
    budget: budget,
    available: available,
    roster: Empty
  )
}

fn probe_ipmi_ecc_stress_unselectable_on_cloud_vm_holds() -> Bool {
  let selected = probe_select_host_health(
    prior: SuspectedCausePrior { hypothesis: host_health_hypothesis_standoff_cap_vddq },
    budget: CostBudget { max_cost: 100 },
    available: diagnostic_capability_cloud_vm()
  )
  !probe_catalog_contains_host_probe_kind(
    selected: selected,
    kind: HostHealthProbeEccWatchedStress
  )
}

fn probe_ipmi_ecc_stress_selectable_on_srv1_holds() -> Bool {
  let selected = probe_select_host_health(
    prior: SuspectedCausePrior { hypothesis: host_health_hypothesis_standoff_cap_vddq },
    budget: CostBudget { max_cost: 100 },
    available: diagnostic_capability_srv1()
  )
  probe_catalog_contains_host_probe_kind(
    selected: selected,
    kind: HostHealthProbeEccWatchedStress
  )
}

fn probe_degenerate_today_selects_docker_only_holds() -> Bool {
  let selected = probe_select_host_health(
    prior: SuspectedCausePrior { hypothesis: host_health_hypothesis_reachability },
    budget: CostBudget { max_cost: 100 },
    available: diagnostic_capability_ci_in_repo()
  )
  length(xs: selected) == 1
    && probe_catalog_contains_host_probe_kind(
      selected: selected,
      kind: HostHealthProbeDockerReachability
    )
}

fn probe_availability_conditioning_keystone_holds() -> Bool {
  probe_ipmi_ecc_stress_unselectable_on_cloud_vm_holds()
    && probe_ipmi_ecc_stress_selectable_on_srv1_holds()
}
