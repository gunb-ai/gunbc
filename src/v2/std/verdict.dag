module v2.std.verdict

import std.algebra { Monoid }
import v2.std.algebra { is_empty }
import v2.std.collection { List, Optional, Absent }
import v2.std.diagnostic { Diagnostic, Outcome }
import v2.std.nat { Nat, Succ, Zero, nat_add }
import v2.std.test_claim_falsification { FalsificationReceipt }
import v2.std.logic { Bool }

type Verdict<Subj, T>
  = Pass
  | SemanticMismatch {
      actual: Outcome<T>,
      falsification: Optional<FalsificationReceipt<Subj, T>>
    }
  | BuildFailed { actual: Outcome<T>, diagnostic: Diagnostic }
  | RunFailed { actual: Outcome<T>, diagnostic: Diagnostic }
  | Deferred { actual: Outcome<T>, diagnostic: Diagnostic }

fn verdict_semantic_mismatch<Subj, T>(
  actual: Outcome<T>,
  falsification: Optional<FalsificationReceipt<Subj, T>>
) -> Verdict<Subj, T> {
  SemanticMismatch { actual: actual, falsification: falsification }
}

fn verdict_build_failed<Subj, T>(actual: Outcome<T>, diagnostic: Diagnostic) -> Verdict<Subj, T> {
  BuildFailed { actual: actual, diagnostic: diagnostic }
}

fn verdict_run_failed<Subj, T>(actual: Outcome<T>, diagnostic: Diagnostic) -> Verdict<Subj, T> {
  RunFailed { actual: actual, diagnostic: diagnostic }
}

fn verdict_fail<Subj, T>(actual: Outcome<T>) -> Verdict<Subj, T> {
  verdict_semantic_mismatch(actual: actual, falsification: Absent)
}

fn verdict_combine<Subj, T>(a: Verdict<Subj, T>, b: Verdict<Subj, T>) -> Verdict<Subj, T> {
  match a {
    Pass => b
    SemanticMismatch { actual: fa, falsification: ff } =>
      SemanticMismatch { actual: fa, falsification: ff }
    BuildFailed { actual: fa, diagnostic: d } =>
      BuildFailed { actual: fa, diagnostic: d }
    RunFailed { actual: fa, diagnostic: d } =>
      RunFailed { actual: fa, diagnostic: d }
    Deferred { actual: da, diagnostic: diag } => match b {
      SemanticMismatch { actual: fb, falsification: bf } =>
        SemanticMismatch { actual: fb, falsification: bf }
      BuildFailed { actual: fb, diagnostic: bd } =>
        BuildFailed { actual: fb, diagnostic: bd }
      RunFailed { actual: fb, diagnostic: rd } =>
        RunFailed { actual: fb, diagnostic: rd }
      Deferred { actual: _, diagnostic: _ } => Deferred { actual: da, diagnostic: diag }
      Pass => Deferred { actual: da, diagnostic: diag }
    }
  }
}

fn verdict_monoid<Subj, T>() -> Monoid<Verdict<Subj, T>> {
  Monoid {
    op: verdict_combine,
    identity: Pass
  }
}

type VerdictTally {
  pass: v2.std.nat.Nat
  fail: v2.std.nat.Nat
  deferred: v2.std.nat.Nat
}

data verdict_tally_empty: VerdictTally = VerdictTally { pass: Zero, fail: Zero, deferred: Zero }

fn verdict_tally_add<Subj, T>(t: VerdictTally, v: Verdict<Subj, T>) -> VerdictTally {
  match v {
    Pass => VerdictTally { pass: Succ { prev: t.pass }, fail: t.fail, deferred: t.deferred }
    SemanticMismatch { actual: _, falsification: _ } =>
      VerdictTally { pass: t.pass, fail: Succ { prev: t.fail }, deferred: t.deferred }
    BuildFailed { actual: _, diagnostic: _ } =>
      VerdictTally { pass: t.pass, fail: Succ { prev: t.fail }, deferred: t.deferred }
    RunFailed { actual: _, diagnostic: _ } =>
      VerdictTally { pass: t.pass, fail: Succ { prev: t.fail }, deferred: t.deferred }
    Deferred { actual: _, diagnostic: _ } =>
      VerdictTally { pass: t.pass, fail: t.fail, deferred: Succ { prev: t.deferred } }
  }
}

fn verdict_tally<Subj, T>(vs: List<Verdict<Subj, T>>) -> VerdictTally {
  fold(vs, init: verdict_tally_empty, f: fn(acc, v) {
    verdict_tally_add(t: acc, v: v)
  })
}

fn verdict_tally_total(t: VerdictTally) -> v2.std.nat.Nat {
  nat_add(a: nat_add(a: t.pass, b: t.fail), b: t.deferred)
}

fn verdict_fold<Subj, T>(
  rs: List<Verdict<Subj, T>>,
  empty_verdict: Verdict<Subj, T>
) -> Verdict<Subj, T> {
  match is_empty(xs: rs) {
    true => empty_verdict
    false => fold(rs, init: Pass, f: fn(acc, v) {
      verdict_combine(a: acc, b: v)
    })
  }
}
