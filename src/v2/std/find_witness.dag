module v2.std.find_witness

type CandidateSet {
  candidates: List<Node>
  closedness: StructuralPropertyWitness
}
type PreservationPredicate {
  algebra: Node
  preservation_rule: Symbol
}
type FindWitnessResult {
  candidate: Node
  witness: StructuralPropertyWitness
  closedness: StructuralPropertyWitness
}

type TargetSelectionPolicy
  = TargetDeclaredPriority { priority: Node }
  | UserSelected { selection: Node }

type MultiplicityPolicy
  = UniqueOnly
  | TargetSelection { policy: TargetSelectionPolicy }
fn preservation_rule_is_realized(rule: Symbol) -> Bool {
  contains(
    xs: realized_preservation_rules(),
    item: rule,
    eq: fn(left, right) { left == right }
  )
}
fn realized_preservation_rules() -> List<Symbol> {
  [
    ^preservation_rule_constraint_satisfaction,
    ^preservation_rule_exact_structural_equality_zip_fold,
    ^preservation_rule_refinement_widening,
    ^preservation_rule_project_to_core
  ]
}
fn find_witness_no_candidate_diagnostic(source_facts: Node) -> Diagnostic {
  Diagnostic {
    reason: ^find_witness_reason_no_candidate,
    at: node_locus(node: source_facts),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn find_witness_ambiguous_candidate_diagnostic(source_facts: Node) -> Diagnostic {
  Diagnostic {
    reason: ^find_witness_reason_ambiguous_candidate,
    at: node_locus(node: source_facts),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn find_witness_not_realized_diagnostic(source_facts: Node) -> Diagnostic {
  Diagnostic {
    reason: ^find_witness_reason_not_realized,
    at: node_locus(node: source_facts),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn find_witness_invalid_witness_diagnostic(source_facts: Node) -> Diagnostic {
  Diagnostic {
    reason: ^find_witness_reason_invalid_witness,
    at: node_locus(node: source_facts),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn enumeration_candidate_list(
  candidates: CandidateSet,
  predicate: PreservationPredicate
) -> List<Node> {
  candidates.candidates
}
fn preservation_predicate_holds(
  source_facts: Node,
  candidate: Node,
  predicate: PreservationPredicate
) -> Bool {
  if predicate.preservation_rule == ^preservation_rule_constraint_satisfaction {
    constraint_satisfaction_preservation_holds(
      source_facts: source_facts,
      candidate: candidate,
      algebra: predicate.algebra
    )
  } else if predicate.preservation_rule == ^preservation_rule_exact_structural_equality_zip_fold {
    exact_structural_equality_zip_fold_preservation_holds(
      source_facts: source_facts,
      candidate: candidate,
      algebra: predicate.algebra
    )
  } else if predicate.preservation_rule == ^preservation_rule_refinement_widening {
    refinement_widening_preservation_holds(
      source_facts: source_facts,
      candidate: candidate,
      algebra: predicate.algebra
    )
  } else if predicate.preservation_rule == ^preservation_rule_project_to_core {
    project_to_core_preservation_holds(
      source_facts: source_facts,
      candidate: candidate,
      algebra: predicate.algebra
    )
  } else {
    false
  }
}

fn passing_candidate_count(
  source_facts: Node,
  candidates: CandidateSet,
  predicate: PreservationPredicate
) -> Int {
  fold(enumeration_candidate_list(candidates: candidates, predicate: predicate), init: 0, f: fn(acc, candidate) {
    if preservation_predicate_holds(
      source_facts: source_facts,
      candidate: candidate,
      predicate: predicate
    ) {
      acc + 1
    } else {
      acc
    }
  })
}
fn only_passing_candidate(
  source_facts: Node,
  candidates: CandidateSet,
  predicate: PreservationPredicate
) -> Outcome<Node> {
  match fold(enumeration_candidate_list(candidates: candidates, predicate: predicate), init: NoPassingCandidate, f: fn(acc, candidate) {
    if preservation_predicate_holds(
      source_facts: source_facts,
      candidate: candidate,
      predicate: predicate
    ) {
      match acc {
        NoPassingCandidate => OnePassingCandidate { candidate: candidate }
        OnePassingCandidate { candidate: _ } => ManyPassingCandidates
        ManyPassingCandidates => ManyPassingCandidates
      }
    } else {
      acc
    }
  }) {
    NoPassingCandidate =>
      outcome_rejected(find_witness_no_candidate_diagnostic(source_facts: source_facts))
    OnePassingCandidate { candidate: only } =>
      Accepted { value: only, diagnostics: None }
    ManyPassingCandidates =>
      outcome_rejected(find_witness_ambiguous_candidate_diagnostic(source_facts: source_facts))
  }
}
fn selected_candidate_count(
  source_facts: Node,
  candidates: CandidateSet,
  predicate: PreservationPredicate,
  selection: Node
) -> Int {
  fold(enumeration_candidate_list(candidates: candidates, predicate: predicate), init: 0, f: fn(acc, candidate) {
    if (candidate == selection) && preservation_predicate_holds(
      source_facts: source_facts,
      candidate: candidate,
      predicate: predicate
    ) {
      acc + 1
    } else {
      acc
    }
  })
}
fn accepted_witness_result(
  candidate: Node,
  candidates: CandidateSet,
  predicate: PreservationPredicate
) -> Outcome<FindWitnessResult> {
  Accepted {
    value: FindWitnessResult {
      candidate: candidate,
      witness: StructuralPropertyWitness {
        property: predicate.preservation_rule,
        evidence: candidate
      },
      closedness: candidates.closedness
    },
    diagnostics: None
  }
}
fn resolve_selected_candidate(
  source_facts: Node,
  candidates: CandidateSet,
  predicate: PreservationPredicate,
  selection: Node
) -> Outcome<FindWitnessResult> {
  match selected_candidate_count(
    source_facts: source_facts,
    candidates: candidates,
    predicate: predicate,
    selection: selection
  ) {
    1 => accepted_witness_result(
      candidate: selection,
      candidates: candidates,
      predicate: predicate
    )
    0 => outcome_rejected(find_witness_no_candidate_diagnostic(source_facts: source_facts))
    _ => outcome_rejected(find_witness_ambiguous_candidate_diagnostic(source_facts: source_facts))
  }
}
fn find_witness(
  source_facts: Node,
  candidates: CandidateSet,
  predicate: PreservationPredicate,
  multiplicity_policy: MultiplicityPolicy
) -> Outcome<FindWitnessResult> {
  if preservation_rule_is_realized(rule: predicate.preservation_rule) {
    find_witness_realized(
      source_facts: source_facts,
      candidates: candidates,
      predicate: predicate,
      multiplicity_policy: multiplicity_policy
    )
  } else {
    outcome_rejected(find_witness_not_realized_diagnostic(source_facts: source_facts))
  }
}
fn derivation_predicate_for_rule(
  source_facts: Node,
  derivation_algebra: Node,
  rule: Symbol
) -> PreservationPredicate {
  if rule == ^preservation_rule_project_to_core {
    PreservationPredicate {
      algebra: derivation_algebra,
      preservation_rule: rule
    }
  } else {
    PreservationPredicate {
      algebra: source_facts,
      preservation_rule: rule
    }
  }
}

fn find_witness_rejection_priority(reason: Symbol) -> Int {
  if reason == ^find_witness_reason_invalid_witness {
    3
  } else if reason == ^find_witness_reason_ambiguous_candidate {
    2
  } else if reason == ^find_witness_reason_not_realized {
    1
  } else {
    0
  }
}

fn find_witness_derivation_rejection_better(
  current: Outcome<FindWitnessResult>,
  candidate: Outcome<FindWitnessResult>
) -> Outcome<FindWitnessResult> {
  match current {
    Accepted { value: _, diagnostics: _ } => current
    Rejected { diagnostics: current_diagnostics } =>
      match candidate {
        Accepted { value: _, diagnostics: _ } => candidate
        Rejected { diagnostics: candidate_diagnostics } =>
          if find_witness_rejection_priority(reason: candidate_diagnostics.head.reason) > find_witness_rejection_priority(reason: current_diagnostics.head.reason) {
            candidate
          } else {
            current
          }
      }
  }
}

fn find_witness_derives(
  source_facts: Node,
  candidates: CandidateSet,
  derivation_algebra: Node,
  multiplicity_policy: MultiplicityPolicy
) -> Outcome<FindWitnessResult> {
  fold(
    realized_preservation_rules(),
    init: outcome_rejected(find_witness_no_candidate_diagnostic(source_facts: source_facts)),
    f: fn(acc, rule) {
	      match acc {
	        Accepted { value: _, diagnostics: _ } => acc
	        Rejected { diagnostics: _ } =>
	          match find_witness(
	            source_facts: source_facts,
	            candidates: candidates,
            predicate: derivation_predicate_for_rule(
              source_facts: source_facts,
              derivation_algebra: derivation_algebra,
              rule: rule
            ),
	            multiplicity_policy: multiplicity_policy
	          ) {
	            Accepted { value: fw, diagnostics: d } => Accepted { value: fw, diagnostics: d }
	            Rejected { diagnostics: r } =>
	              find_witness_derivation_rejection_better(
	                current: acc,
	                candidate: Rejected { diagnostics: r }
	              )
	          }
	      }
	    }
  )
}
fn find_witness_realized(
  source_facts: Node,
  candidates: CandidateSet,
  predicate: PreservationPredicate,
  multiplicity_policy: MultiplicityPolicy
) -> Outcome<FindWitnessResult> {
  if preservation_rule_is_realized(rule: predicate.preservation_rule) == false {
    outcome_rejected(find_witness_not_realized_diagnostic(source_facts: source_facts))
  } else {
  let passing_count = passing_candidate_count(
    source_facts: source_facts,
    candidates: candidates,
    predicate: predicate
  )
  match passing_count {
    0 => outcome_rejected(find_witness_no_candidate_diagnostic(source_facts: source_facts))
    1 => match only_passing_candidate(
      source_facts: source_facts,
      candidates: candidates,
      predicate: predicate
    ) {
      Accepted { value: only, diagnostics: _ } => accepted_witness_result(
        candidate: only,
        candidates: candidates,
        predicate: predicate
      )
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
    }
    _ => match multiplicity_policy {
      UniqueOnly =>
        outcome_rejected(find_witness_ambiguous_candidate_diagnostic(source_facts: source_facts))
      TargetSelection { policy: p } => match p {
        TargetDeclaredPriority { priority: priority } =>
          resolve_selected_candidate(
            source_facts: source_facts,
            candidates: candidates,
            predicate: predicate,
            selection: priority
          )
        UserSelected { selection: selection } =>
          resolve_selected_candidate(
            source_facts: source_facts,
            candidates: candidates,
            predicate: predicate,
            selection: selection
          )
      }
    }
  }
  }
}
fn verify_witness(
  source_facts: Node,
  candidate: Node,
  predicate: PreservationPredicate,
  witness: StructuralPropertyWitness
) -> Outcome<StructuralPropertyWitness> {
  if preservation_rule_is_realized(rule: predicate.preservation_rule) {
    verify_witness_realized(
      source_facts: source_facts,
      candidate: candidate,
      predicate: predicate,
      witness: witness
    )
  } else {
    outcome_rejected(find_witness_not_realized_diagnostic(source_facts: source_facts))
  }
}
fn verify_witness_realized(
  source_facts: Node,
  candidate: Node,
  predicate: PreservationPredicate,
  witness: StructuralPropertyWitness
) -> Outcome<StructuralPropertyWitness> {
  if preservation_predicate_holds(
    source_facts: source_facts,
    candidate: candidate,
    predicate: predicate
  ) && (witness.property == predicate.preservation_rule) && (witness.evidence == candidate) {
    Accepted { value: witness, diagnostics: None }
  } else {
    outcome_rejected(find_witness_invalid_witness_diagnostic(source_facts: source_facts))
  }
}
