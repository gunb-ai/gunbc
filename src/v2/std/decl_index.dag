module v2.std.decl_index
type ItemKind
  = FnItem
  | FuncItem
  | TypeItem
  | DataItem
  | ServiceItem
  | OtherItem

type DeclFact {
  qualified_name: String
  name: String
  kind: v2.std.decl_index.ItemKind
  node: Node
  rel_path: String
}

fn decl_facts(pool_roots: List<String>) -> List<v2.std.decl_index.DeclFact> {
  decl_facts(pool_roots: pool_roots)
}

fn export_signature_facts(pool_roots: List<String>) -> List<v2.std.decl_index.DeclFact> {
  export_signature_facts(pool_roots: pool_roots)
}

// A top-level `data` declaration with its DECLARED TYPE, keyed at declaration identity.
// `DeclFact` cannot answer this: for a DataItem its `node` is the initializer projection,
// which drops the type annotation, so no consumer of `decl_facts` can decide whether a
// declaration is still typed `String`. `module_path` is authored and UNSTRIPPED (`v2.`
// retained) so it composes with `DeclarationRef` directly.
type DataDeclTypeFact {
  module_path: String
  decl_name: String
  type_name: String
  rel_path: String
}

fn data_decl_type_facts(pool_roots: List<String>) -> List<v2.std.decl_index.DataDeclTypeFact> {
  data_decl_type_facts(pool_roots: pool_roots)
}

data export_signature_facts_host_scaffold_dissolution_trigger: std.disposition.Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "std.interface_summary",
    decl_name: "interface_summary_v0_dissolution_trigger",
    field: WholeDeclaration
  }
}

fn logical_qualified_name_from_module(module_name: String, name: String) -> String {
  let start = if module_name.starts_with(prefix: "v2.") { 3 } else { 0 }
  let logical = module_name.substring(start: start, end: module_name.length())
  if logical.length() == 0 {
    name
  } else {
    concat(logical, ".", name)
  }
}

fn decl_facts_is_fn_like(kind: v2.std.decl_index.ItemKind) -> Bool {
  match kind {
    FnItem => true
    FuncItem => true
    _ => false
  }
}

fn decl_fact_node_has_body(node: Node) -> Bool {
  (length(xs: node_labeled_child_edges(node: node)) > 0)
    || (length(xs: node_positional_child_targets(node: node)) > 0)
}

fn decl_facts_fn_items(facts: List<v2.std.decl_index.DeclFact>) -> List<v2.std.decl_index.DeclFact> {
  fold(facts, init: std.algebra.Empty, f: fn(acc, fact) {
    if decl_facts_is_fn_like(kind: fact.kind) {
      list_snoc_item(xs: acc, item: fact)
    } else {
      acc
    }
  })
}

fn decl_facts_count(pool_roots: List<String>) -> Int {
  length(xs: decl_facts(pool_roots: pool_roots))
}

fn decl_facts_fn_item_count(pool_roots: List<String>) -> Int {
  length(xs: decl_facts_fn_items(facts: decl_facts(pool_roots: pool_roots)))
}
