module v2.std.decl_index

import v2.std.algebra { Empty, length, list_snoc_item }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.node_query { node_labeled_child_edges, node_positional_child_targets }
import v2.std.text { String }

type ItemKind
  = FnItem
  | FuncItem
  | TypeItem
  | DataItem
  | ServiceItem
  | OtherItem

type DeclFact {
  qualified_name: String
  name: String
  kind: ItemKind
  node: Node
  rel_path: String
}

fn decl_facts(pool_roots: List<String>) -> List<DeclFact> {
  decl_facts(pool_roots: pool_roots)
}

fn logical_qualified_name_from_module(module_name: String, name: String) -> String {
  let start = if module_name.starts_with(prefix: "v2.") { 3 } else { 0 }
  let logical = module_name.substring(start: start, end: module_name.length())
  if logical.length() == 0 {
    name
  } else {
    concat(logical, ".", name)
  }
}

fn decl_facts_is_fn_like(kind: ItemKind) -> Bool {
  match kind {
    FnItem => true
    FuncItem => true
    _ => false
  }
}

fn decl_fact_node_has_body(node: Node) -> Bool {
  (length(xs: node_labeled_child_edges(node: node)) > 0)
    || (length(xs: node_positional_child_targets(node: node)) > 0)
}

fn decl_facts_fn_items(facts: List<DeclFact>) -> List<DeclFact> {
  fold(facts, init: Empty, f: fn(acc, fact) {
    if decl_facts_is_fn_like(kind: fact.kind) {
      list_snoc_item(xs: acc, item: fact)
    } else {
      acc
    }
  })
}

fn decl_facts_count(pool_roots: List<String>) -> Int {
  length(xs: decl_facts(pool_roots: pool_roots))
}

fn decl_facts_fn_item_count(pool_roots: List<String>) -> Int {
  length(xs: decl_facts_fn_items(facts: decl_facts(pool_roots: pool_roots)))
}
