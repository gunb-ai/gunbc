module v2.std.decl_index
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.non_fold_residue { nfr_dissolve_owning_fold, nfr_reason_typed_census_ca5ed1724b }
import std.types { List }
import v2.std.arrow_signature { declared_signature_arrow }
import std.algebra { Empty, list_snoc_item, list_at_optional, collection_concat_shape, collection_count_shape }
import v2.std.diagnostic { Diagnostic, ExternalContractUnknown, Outcome, Unavailable, bind_outcome, node_locus, outcome_accepted, outcome_rejected }
import v2.std.node { positional_child_target_nodes, Arrow, Conj, Node, TypeNode, all_edges_named, all_edges_positional }
import std.optional { Absent, Present }
import std.roster_frontier { FrontierRow, PathSubject }
import std.dissolution { DissolutionCondition, unbound_dissolution }
type ItemKind
  = FnItem
  | TypeItem
  | DataItem
  | ServiceItem
  | OtherItem

type DeclFact {
  qualified_name: String
  name: String
  kind: ItemKind
  node: Node
  rel_path: String
}

fn decl_facts(pool_roots: List<String>) -> List<DeclFact> {
  decl_facts(pool_roots: pool_roots)
}

// THE KEYED READ. `decl_facts` answers "what does the corpus declare"; this answers "what does the
// corpus declare under THESE keys", which is the question nearly every citation consumer actually
// asks. Both project one census, so a row here is a row there -- the filter runs on the host side
// of the seam, before any of it becomes interpreter values, which is where the cost was.
//
// A row is returned when its qualified_name is one of `qualified_names`, or when it is a type
// declaration whose bare name is one of `type_names`; each row once, in the census's canonical
// order. A caller joins each of its keys against the returned rows -- the qualified join is
// v2.std.decl_facts_skeleton decl_facts_matching_qualified_name, the type join is
// decl_facts_declaring_type below -- so zero rows for a key means no such declaration, and more
// than one is a real ambiguity and is CARRIED, because the resolver derives
// `DeclarationRefAmbiguous` from exactly that multiplicity.
//
// THE KEYS ARE SETS BECAUSE THE DEMANDS ARE. A fold over N citations holds all N keys before it
// asks any of them, so it reads once and joins N times. A one-key read asked once per element
// re-walked the whole pool per element wherever no census provider was registered -- measured on
// BuildBuddy 2026-10-25, one lookup 91s and six 506s inside one `gunbc run` -- which is DESIGN
// section 2's authored duplication, repaired at the demands' least common ancestor rather than by
// caching the later asks. The bare-spelling question (which modules declare this name as a type)
// was a second seam over the same pool, `type_declarer_qualified_names`, and it is this read's
// `type_names` arm: a bare name has no module, so no qualified key can express it, but it is one
// more membership filter over the same rows, and answering it with the rows rather than with their
// names lets a reflection establish multiplicity and read the node from ONE read instead of two.
//
// IT RETURNS THE CANDIDATES, NEVER A CHOICE: every type declaration answering a bare spelling comes
// back, so the multiplicity AND the candidate identities are both the caller's to judge, and the
// host never picks a match.
fn decl_facts_at(pool_roots: List<String>, qualified_names: List<String>, type_names: List<String>) -> List<DeclFact> {
  decl_facts_at(pool_roots: pool_roots, qualified_names: qualified_names, type_names: type_names)
}

// The type-name join over rows a keyed read returned: the TYPE declarations spelled `type_name`,
// in the order the read returned them. Kind is part of the key, as it is on the host side, so a
// function or data row sharing the spelling is never a type candidate.
fn decl_facts_declaring_type(type_name: String, facts: List<DeclFact>) -> List<DeclFact> {
  filter(xs: facts, predicate: fn(f) { f.kind == TypeItem && f.name == type_name })
}

fn export_signature_facts(pool_roots: List<String>) -> List<DeclFact> {
  export_signature_facts(pool_roots: pool_roots)
}

// THE EXPORTED SIGNATURE, IN THE ONE ARROW ENCODING. The host seam above hands a function's Arrow as
// [domain, return]: the domain a Conj of Named edges, one per value parameter, labelled with its
// authored name, in authored order, and no order edge. This lifts it through
// v2.std.arrow_signature declared_signature, the one constructor of a domain and its declared order,
// so an anonymous `_` becomes its minted binder and parameter order is carried by the order edge
// rather than by the Conj's sequence. The seam mints no second constructor; every consumer of an
// exported signature reads it here.
fn export_signature_declared_facts(pool_roots: List<String>) -> Outcome<List<DeclFact>> {
  fold(export_signature_facts(pool_roots: pool_roots), init: outcome_accepted(value: Empty), f: fn(acc, fact) {
    bind_outcome(o: acc, f: fn(facts) {
      match fact.kind {
        FnItem =>
          bind_outcome(o: export_signature_declared_arrow(arrow: fact.node), f: fn(node) {
            outcome_accepted(value: list_snoc_item(xs: facts, item: DeclFact {
              qualified_name: fact.qualified_name,
              name: fact.name,
              kind: fact.kind,
              node: node,
              rel_path: fact.rel_path
            }))
          })
        _ => outcome_accepted(value: list_snoc_item(xs: facts, item: fact))
      }
    })
  })
}

// The host's shape is exactly an Arrow whose OUTER children are two Positional edges, [domain, return],
// with the domain a Conj of Named edges. Anything else REFUSES at the node's locus rather than passing
// through: a node of another connective is never relabelled an Arrow, an extra outer edge (Named or
// Positional) is never dropped, and a host that regresses to positional types never reaches a
// fingerprint.
fn export_signature_declared_arrow(arrow: Node) -> Outcome<Node> {
  match arrow.kind {
    TypeNode { connective: Arrow } =>
      if (count(arrow.children) != 2) || !all_edges_positional(children: arrow.children) {
        outcome_rejected(d: export_signature_host_shape_diagnostic(arrow: arrow))
      } else {
        let targets = positional_child_target_nodes(node: arrow)
        match list_at_optional(xs: targets, index: 0) {
          Absent => outcome_rejected(d: export_signature_host_shape_diagnostic(arrow: arrow))
          Present { value: domain } =>
            match list_at_optional(xs: targets, index: 1) {
              Absent => outcome_rejected(d: export_signature_host_shape_diagnostic(arrow: arrow))
              Present { value: ret } =>
                match domain.kind {
                  TypeNode { connective: Conj } =>
                    if all_edges_named(children: domain.children) {
                      export_signature_declared_from(arrow: arrow, domain: domain, ret: ret)
                    } else {
                      outcome_rejected(d: export_signature_host_shape_diagnostic(arrow: arrow))
                    }
                  _ => outcome_rejected(d: export_signature_host_shape_diagnostic(arrow: arrow))
                }
            }
        }
      }
    _ => outcome_rejected(d: export_signature_host_shape_diagnostic(arrow: arrow))
  }
}

fn export_signature_declared_from(arrow: Node, domain: Node, ret: Node) -> Outcome<Node> {
  outcome_accepted(value: declared_signature_arrow(params: domain.children, codomain: ret, source: arrow))
}

fn export_signature_host_shape_diagnostic(arrow: Node) -> Diagnostic {
  Diagnostic {
    reason: ^export_signature_host_arrow_not_named_domain,
    at: node_locus(node: arrow),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

// A top-level `data` declaration with its DECLARED TYPE, keyed at declaration identity.
// `DeclFact` cannot answer this: for a DataItem its `node` is the initializer projection,
// which drops the type annotation, so no consumer of `decl_facts` can decide whether a
// declaration is still typed `String`. `module_path` is authored and UNSTRIPPED (`v2.`
// retained) so it composes with `DeclarationRef` directly.
type DataDeclTypeFact {
  module_path: String
  decl_name: String
  type_name: String
  rel_path: String
}

fn data_decl_type_facts(pool_roots: List<String>) -> List<DataDeclTypeFact> {
  data_decl_type_facts(pool_roots: pool_roots)
}

data export_signature_facts_host_scaffold_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "std.interface_summary",
    decl_name: "interface_summary_v0_dissolution_trigger",
    field: WholeDeclaration
  }
}

fn qualified_name_from_module(module_name: String, name: String) -> String {
  if module_name.length() == 0 {
    name
  } else {
    concat(module_name, ".", name)
  }
}

fn decl_facts_is_fn_like(kind: ItemKind) -> Bool {
  match kind {
    FnItem => true
    TypeItem => false
    DataItem => false
    ServiceItem => false
    OtherItem => false
  }
}

fn decl_fact_node_has_body(node: Node) -> Bool {
  (length(xs: node_labeled_child_edges(node: node)) > 0)
    || (length(xs: positional_child_target_nodes(node: node)) > 0)
}

fn decl_facts_fn_items(facts: List<DeclFact>) -> List<DeclFact> {
  fold(facts, init: std.algebra.Empty, f: fn(acc, fact) {
    if decl_facts_is_fn_like(kind: fact.kind) {
      list_snoc_item(xs: acc, item: fact)
    } else {
      acc
    }
  })
}

fn decl_facts_count(pool_roots: List<String>) -> Int {
  length(xs: decl_facts(pool_roots: pool_roots))
}

fn decl_facts_fn_item_count(pool_roots: List<String>) -> Int {
  length(xs: decl_facts_fn_items(facts: decl_facts(pool_roots: pool_roots)))
}

data non_fold_residue_frontier: List<FrontierRow> = [
  FrontierRow { subject: PathSubject { path: "export_signature_declared_arrow" }, reason: nfr_reason_typed_census_ca5ed1724b, dissolution: nfr_dissolve_owning_fold },
  FrontierRow { subject: PathSubject { path: "export_signature_declared_facts" }, reason: nfr_reason_typed_census_ca5ed1724b, dissolution: nfr_dissolve_owning_fold },
]
