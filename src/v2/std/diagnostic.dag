// src/v2/std/diagnostic.dag
// Scope: fail-closed diagnostic schema.
// Anchor: fail-closed "show the correct code" (DESIGN.md §5); one fold (DESIGN.md §6) — Ratified Q11.
// Status: T-3 modeled; Wave-2-BC3 Outcome ratification (Ratified Q11).


module v2.std.diagnostic


import v2.std.algebra { bag_eq, list_append, Magma, Monoid, Semigroup, list_snoc_item, fold_list, freemonoid_empty }
import v2.std.node { Node }
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type Extent
  = WholeFile
  | ByteRange { start: Int, end: Int }
// 🟢 coproduct dissolution — L1.4.b Pattern B: Node/Port payload tags
// are recoverable from the parameterized anchor type.
type LocusAnchor<T> {
  at: T
}
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type Locus
  = Textual { file: Symbol, extent: Extent }
  | NodeLocus { anchor: LocusAnchor<Node> }
  | PortLocus { anchor: LocusAnchor<Symbol> }
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type NoCorrectionReason
  = UserInputBoundary
  | AmbiguousIntent
  | ExternalContractUnknown
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type Correction
  = Suggested { node: Node }
  | Unavailable { reason: NoCorrectionReason }
type Diagnostic {
  reason: Symbol
  at: Locus
  correction: Correction
}
type NonEmptyDiagnostics {
  head: Diagnostic
  tail: List<Diagnostic>
}
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type Diagnostics
  = None
  | Some { diagnostics: NonEmptyDiagnostics }
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type Outcome<T>
  = Accepted { value: T, diagnostics: Diagnostics }
  | Rejected { diagnostics: NonEmptyDiagnostics }
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type DiagnosticAccumulation
  = Accumulate
  | ShortCircuit
type StageDiagnosticPolicy {
  accumulation: DiagnosticAccumulation
}
fn diagnostics_singleton(d: Diagnostic) -> NonEmptyDiagnostics {
  NonEmptyDiagnostics { head: d, tail: [] }
}
fn node_locus(node: Node) -> Locus {
  NodeLocus { anchor: LocusAnchor { at: node } }
}

fn port_locus(port: Symbol) -> Locus {
  PortLocus { anchor: LocusAnchor { at: port } }
}
fn outcome_accepted<T>(value: T) -> Outcome<T> {
  Accepted { value: value, diagnostics: None }
}
fn outcome_rejected<T>(d: Diagnostic) -> Outcome<T> {
  Rejected { diagnostics: diagnostics_singleton(d: d) }
}
// Named `extent_eq` (not bare `eq`) to follow the codebase's type-prefixed equality
// convention (locus_eq, node_eq, fact_eq, ...). A bare `eq` module item shadows the
// universal higher-order `eq:` comparison-function parameter (zip_eq/is_prefix_of/...) —
// the bootstrap interpreter resolves a call name to a module item BEFORE an env-bound
// lambda (v1_interpreter.rs eval_call: "module item wins over env-bound Value::Fn"), so a
// bare `eq` global silently captures every `eq(x, y)` invocation inside those combinators
// and crashes on non-Extent arguments. [Recurring class: multi-authority name resolution /
// higher-order-param shadowing — the authority fix (env-bound fn wins, or a dup-name gate)
// is tracked separately; this rename removes the one squatting name.]
fn extent_eq(a: Extent, b: Extent) -> Bool {
  match a {
    WholeFile => match b {
      WholeFile => true
      ByteRange { start: _, end: _ } => false
    }
    ByteRange { start: sa, end: ea } => match b {
      WholeFile => false
      ByteRange { start: sb, end: eb } => (sa == sb) && (ea == eb)
    }
  }
}
fn locus_eq(a: Locus, b: Locus) -> Bool {
  match a {
    Textual { file: fa, extent: ea } => match b {
      Textual { file: fb, extent: eb } => (fa == fb) && extent_eq(a: ea, b: eb)
      NodeLocus { anchor: _ } => false
      PortLocus { anchor: _ } => false
    }
    NodeLocus { anchor: na } => match b {
      Textual { file: _, extent: _ } => false
      NodeLocus { anchor: nb } => na.at == nb.at
      PortLocus { anchor: _ } => false
    }
    PortLocus { anchor: pa } => match b {
      Textual { file: _, extent: _ } => false
      NodeLocus { anchor: _ } => false
      PortLocus { anchor: pb } => pa.at == pb.at
    }
  }
}
fn correction_eq(a: Correction, b: Correction) -> Bool {
  match a {
    Suggested { node: na } => match b {
      Suggested { node: nb } => na == nb
      Unavailable { reason: _ } => false
    }
    Unavailable { reason: ra } => match b {
      Suggested { node: _ } => false
      Unavailable { reason: rb } => ra == rb
    }
  }
}
fn diagnostic_eq(a: Diagnostic, b: Diagnostic) -> Bool {
  (a.reason == b.reason)
    && locus_eq(a: a.at, b: b.at)
    && correction_eq(a: a.correction, b: b.correction)
}
// Tail bag/multiset equality: order-insensitive; delegates to algebra bag_eq.
fn diagnostic_tail_eq(a: List<Diagnostic>, b: List<Diagnostic>) -> Bool {
  bag_eq(xs: a, ys: b, eq: diagnostic_eq)
}
fn non_empty_diagnostics_eq(a: NonEmptyDiagnostics, b: NonEmptyDiagnostics) -> Bool {
  diagnostic_eq(a: a.head, b: b.head) && diagnostic_tail_eq(a: a.tail, b: b.tail)
}
// Monoid append over NonEmptyDiagnostics: list_append is the canonical FreeMonoid operation.
fn non_empty_diagnostics_append(
  a: NonEmptyDiagnostics,
  b: NonEmptyDiagnostics,
) -> NonEmptyDiagnostics {
  NonEmptyDiagnostics {
    head: a.head,
    tail: list_append(left: list_snoc_item(xs: a.tail, item: b.head), right: b.tail)
  }
}
fn diagnostics_merge(outer: Diagnostics, inner: Diagnostics) -> Diagnostics {
  match outer {
    None => inner
    Some { diagnostics: oa } => match inner {
      None => Some { diagnostics: oa }
      Some { diagnostics: ib } =>
        Some {
          diagnostics: non_empty_diagnostics_append(a: oa, b: ib)
        }
    }
  }
}
data diagnostics_monoid: Monoid<Diagnostics> = Monoid {
  semigroup: Semigroup { magma: Magma { op: diagnostics_merge } },
  identity: None
}
data non_empty_diagnostics_semigroup: Semigroup<NonEmptyDiagnostics> = Semigroup {
  magma: Magma { op: non_empty_diagnostics_append }
}
fn rejected_with_pending(
  pending: Diagnostics,
  rejected: NonEmptyDiagnostics,
) -> NonEmptyDiagnostics {
  match pending {
    None => rejected
    Some { diagnostics: p } => non_empty_diagnostics_append(a: p, b: rejected)
  }
}
fn diagnostics_eq(a: Diagnostics, b: Diagnostics) -> Bool {
  match a {
    None => match b {
      None => true
      Some { diagnostics: _ } => false
    }
    Some { diagnostics: da } => match b {
      None => false
      Some { diagnostics: db } => non_empty_diagnostics_eq(a: da, b: db)
    }
  }
}
fn outcome_node_eq(a: Outcome<Node>, b: Outcome<Node>) -> Bool {
  match a {
    Accepted { value: av, diagnostics: ad } => match b {
      Accepted { value: bv, diagnostics: bd } => (av == bv) && diagnostics_eq(a: ad, b: bd)
      Rejected { diagnostics: _ } => false
    }
    Rejected { diagnostics: ar } => match b {
      Accepted { value: _, diagnostics: _ } => false
      Rejected { diagnostics: br } => non_empty_diagnostics_eq(a: ar, b: br)
    }
  }
}
fn outcome_with_diagnostics<U>(value: U, diagnostics: Diagnostics) -> Outcome<U> {
  Accepted { value: value, diagnostics: diagnostics }
}
fn accepted_thread_diagnostics<T>(
  value: T,
  accumulated: Diagnostics,
  incoming: Diagnostics,
) -> Outcome<T> {
  Accepted {
    value: value,
    diagnostics: diagnostics_merge(outer: accumulated, inner: incoming)
  }
}
fn bind_outcome_accepted<U>(od: Diagnostics, inner: Outcome<U>) -> Outcome<U> {
  match inner {
    Accepted { value: u, diagnostics: ud } =>
      outcome_with_diagnostics(
        value: u,
        diagnostics: diagnostics_merge(outer: od, inner: ud)
      )
    Rejected { diagnostics: r } =>
      Rejected { diagnostics: rejected_with_pending(pending: od, rejected: r) }
  }
}
fn bind_outcome<T, U>(o: Outcome<T>, f: fn(T) -> Outcome<U>) -> Outcome<U> {
  match o {
    Accepted { value: v, diagnostics: od } => bind_outcome_accepted(od: od, inner: f(v))
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn absorb_outcome_diagnostics<T, U>(
  acc: Outcome<T>,
  child: Outcome<U>,
  policy: StageDiagnosticPolicy
) -> Outcome<T> {
  match policy.accumulation {
    ShortCircuit => match acc {
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
      Accepted { value: v, diagnostics: ad } => match child {
        Rejected { diagnostics: cr } =>
          Rejected { diagnostics: rejected_with_pending(pending: ad, rejected: cr) }
        Accepted { value: _, diagnostics: cd } =>
          accepted_thread_diagnostics(value: v, accumulated: ad, incoming: cd)
      }
    }
    Accumulate => match acc {
      Accepted { value: v, diagnostics: ad } => match child {
        Accepted { value: _, diagnostics: cd } =>
          accepted_thread_diagnostics(value: v, accumulated: ad, incoming: cd)
        Rejected { diagnostics: cr } =>
          Rejected { diagnostics: rejected_with_pending(pending: ad, rejected: cr) }
      }
      Rejected { diagnostics: r } => match child {
        Accepted { value: _, diagnostics: cd } =>
          Rejected { diagnostics: rejected_with_pending(pending: cd, rejected: r) }
        Rejected { diagnostics: cr } =>
          Rejected {
            diagnostics: non_empty_diagnostics_append(a: r, b: cr)
          }
      }
    }
  }
}

fn append_outcome_value<T>(
  acc: Outcome<List<T>>,
  child: Outcome<T>,
  policy: StageDiagnosticPolicy
) -> Outcome<List<T>> {
  match policy.accumulation {
    ShortCircuit => match acc {
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
      Accepted { value: values, diagnostics: ad } => match child {
        Rejected { diagnostics: cr } =>
          Rejected { diagnostics: rejected_with_pending(pending: ad, rejected: cr) }
        Accepted { value: child_value, diagnostics: cd } =>
          accepted_thread_diagnostics(
            value: list_snoc_item(xs: values, item: child_value),
            accumulated: ad,
            incoming: cd
          )
      }
    }
    Accumulate => match acc {
      Accepted { value: values, diagnostics: ad } => match child {
        Accepted { value: child_value, diagnostics: cd } =>
          accepted_thread_diagnostics(
            value: list_snoc_item(xs: values, item: child_value),
            accumulated: ad,
            incoming: cd
          )
        Rejected { diagnostics: cr } =>
          Rejected { diagnostics: rejected_with_pending(pending: ad, rejected: cr) }
      }
      Rejected { diagnostics: r } => match child {
        Accepted { value: _, diagnostics: cd } =>
          Rejected { diagnostics: rejected_with_pending(pending: cd, rejected: r) }
        Rejected { diagnostics: cr } =>
          Rejected {
            diagnostics: non_empty_diagnostics_append(a: r, b: cr)
          }
      }
    }
  }
}

// Collect a list of outcomes into an outcome of a list, respecting the stage
// diagnostic policy. ShortCircuit: first Rejected absorbs (pending warnings
// from earlier Accepted results are prepended). Accumulate: all Rejected
// diagnostics are merged before returning a final Rejected.
fn sequence_outcome<T>(
  xs: List<Outcome<T>>,
  policy: StageDiagnosticPolicy
) -> Outcome<List<T>> {
  fold_list(
    xs: xs,
    empty: outcome_accepted(value: freemonoid_empty()),
    cons: fn(acc, o) {
      append_outcome_value(acc: acc, child: o, policy: policy)
    }
  )
}
// traverse_outcome / traverse_node / sequence_node deferred: v2 bootstrap rejects
// fn(T) -> Outcome<U> and fn(Node) -> Outcome<R> in higher-order parameter types
// (Ratified Q4); land with fold_node-derived combinator when W-T-* consumes it.
fn outcome_eq<T>(a: Outcome<T>, b: Outcome<T>, payload_eq: fn(T, T) -> Bool) -> Bool {
  match a {
    Accepted { value: av, diagnostics: ad } => match b {
      Accepted { value: bv, diagnostics: bd } =>
        payload_eq(av, bv) && diagnostics_eq(a: ad, b: bd)
      Rejected { diagnostics: _ } => false
    }
    Rejected { diagnostics: ar } => match b {
      Accepted { value: _, diagnostics: _ } => false
      Rejected { diagnostics: br } => non_empty_diagnostics_eq(a: ar, b: br)
    }
  }
}

// =========================================================================
// Diagnostic-emission intent (Gap A — emission = ingestion⁻¹ past syntax).
// Anchor: docs/plans/emission-ingestion-inverse.md §4(A); DESIGN.md §3 (agnostic intent
// stays central; the per-medium realization migrates outward / dispatch lives in extdeps),
// §4 (emit = serialize_target ∘ translate — one grammar read backward), §5 (fail-closed).
//
// This is the MEDIUM-AGNOSTIC intent to SURFACE a diagnostic — distinct from `Diagnostic`
// above (the rich compiler finding: reason/locus/correction). `EmitDirective` is what an
// orchestration consumer actually expresses ("emit an Error-severity diagnostic"), and a
// per-medium realization renders it the row-driven way (`emit(intent, medium)`), dissolving
// hand-rolled forward emitters like the dead `render_log_annotation`.
//
// 🟡 SCAFFOLD — Bash-medium foundation only. The first realization is Bash
// (`v2.extdeps.languages.bash` → `echo <message> >&2`), grounded by execution in
// `v2.test.manual.emit_directive_bash`. The Bash transport is severity-INVARIANT (POSIX
// `sh` has no severity concept; the stream is the only axis), so `severity` is carried by
// the intent but realized only by a LATER medium layer.
// Named dissolution / deferred-payoff markers (Phase 2, witty-wolf GHA-as-Node-gated):
//   - severity REALIZATION: GitHub-Actions annotation prefix (severity Error → `::error`,
//     Warning → `::warning`) is the GHA medium layered over the Bash transport; lands with
//     the GHA-as-Node realization edge, NOT here.
//   - source LOCUS (file/line for the GHA annotation) is added as `Optional<Locus>` WITH that
//     GHA realizer (the only consumer that reads it); omitted now per JIT modeling (§6).
//   - the live consumers (`tools.build_step` ::error, `gunbc.ci_spec` ::warning) migrate onto
//     `emit(EmitDirective, GHA-over-Bash)` at that composed-arc landing, shrinking the §0
//     realization-vocab containment roster (the bright-gull MediumStructureLeak dissolve-on).
//
// `Notice` is intentionally ABSENT: it has zero live consumers (only the dead
// `render_log_annotation.AnnotationNotice`), so adding it now would be §5
// specification-without-execution. Add it the moment a live info-level consumer appears.
// Variants are prefixed (`SeverityError`/`SeverityWarning`) not bare `Error`/`Warning` to
// avoid the name-shadowing hazard this module documents (see `extent_eq` note above) and the
// distinct `std.behavioral.Severity` risk scale (Low|Medium|High|Critical) — a different
// concept, not a fork.
type DiagnosticSeverity = SeverityError | SeverityWarning

type EmitDirective {
  severity: DiagnosticSeverity
  message: String
}

fn diagnostic_severity_eq(a: DiagnosticSeverity, b: DiagnosticSeverity) -> Bool {
  match a {
    SeverityError => match b {
      SeverityError => true
      SeverityWarning => false
    }
    SeverityWarning => match b {
      SeverityError => false
      SeverityWarning => true
    }
  }
}

fn emit_directive_eq(a: EmitDirective, b: EmitDirective) -> Bool {
  diagnostic_severity_eq(a: a.severity, b: b.severity) && (a.message == b.message)
}
