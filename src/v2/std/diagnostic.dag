module v2.std.diagnostic


type Extent
  = WholeFile
  | ByteRange { start: Int, end: Int }

type LocusAnchor<T> {
  at: T
}

type Locus
  = Textual { file: v2.std.node.Symbol, extent: v2.std.diagnostic.Extent }
  | NodeLocus { anchor: v2.std.diagnostic.LocusAnchor<Node> }
  | PortLocus { anchor: v2.std.diagnostic.LocusAnchor<v2.std.node.Symbol> }

type NoCorrectionReason
  = UserInputBoundary
  | AmbiguousIntent
  | ExternalContractUnknown
  | CorrectionNotModeled

type Correction
  = Suggested { node: Node }
  | Unavailable { reason: v2.std.diagnostic.NoCorrectionReason }
type Diagnostic {
  reason: v2.std.node.Symbol
  at: v2.std.diagnostic.Locus
  correction: v2.std.diagnostic.Correction
}
type NonEmptyDiagnostics {
  head: v2.std.diagnostic.Diagnostic
  tail: List<v2.std.diagnostic.Diagnostic>
}

type Diagnostics
  = None
  | Some { diagnostics: v2.std.diagnostic.NonEmptyDiagnostics }

type Outcome<T>
  = Accepted { value: T, diagnostics: v2.std.diagnostic.Diagnostics }
  | Rejected { diagnostics: v2.std.diagnostic.NonEmptyDiagnostics }

type DiagnosticAccumulation
  = Accumulate
  | ShortCircuit
type StageDiagnosticPolicy {
  accumulation: v2.std.diagnostic.DiagnosticAccumulation
}
fn diagnostics_singleton(d: v2.std.diagnostic.Diagnostic) -> v2.std.diagnostic.NonEmptyDiagnostics {
  NonEmptyDiagnostics { head: d, tail: [] }
}
fn node_locus(node: Node) -> v2.std.diagnostic.Locus {
  NodeLocus { anchor: v2.std.diagnostic.LocusAnchor { at: node } }
}

fn port_locus(port: v2.std.node.Symbol) -> v2.std.diagnostic.Locus {
  PortLocus { anchor: v2.std.diagnostic.LocusAnchor { at: port } }
}

fn textual_whole_file_locus(file: v2.std.node.Symbol) -> v2.std.diagnostic.Locus {
  Textual { file: file, extent: WholeFile }
}

fn textual_whole_file_diagnostic(
  reason: v2.std.node.Symbol,
  module_file: v2.std.node.Symbol,
  correction: v2.std.diagnostic.Correction
) -> v2.std.diagnostic.Diagnostic {
  Diagnostic {
    reason: reason,
    at: textual_whole_file_locus(file: module_file),
    correction: correction
  }
}

fn module_unavailable_diagnostic(reason: v2.std.node.Symbol, module_file: v2.std.node.Symbol) -> v2.std.diagnostic.Diagnostic {
  textual_whole_file_diagnostic(
    reason: reason,
    module_file: module_file,
    correction: Unavailable { reason: ExternalContractUnknown }
  )
}

fn outcome_accepted<T>(value: T) -> v2.std.diagnostic.Outcome<T> {
  v2.std.diagnostic.Accepted { value: value, diagnostics: None }
}
fn outcome_rejected<T>(d: v2.std.diagnostic.Diagnostic) -> v2.std.diagnostic.Outcome<T> {
  v2.std.diagnostic.Rejected { diagnostics: diagnostics_singleton(d: d) }
}

fn extent_eq(a: v2.std.diagnostic.Extent, b: v2.std.diagnostic.Extent) -> Bool {
  match a {
    WholeFile => match b {
      WholeFile => true
      ByteRange { start: _, end: _ } => false
    }
    ByteRange { start: sa, end: ea } => match b {
      WholeFile => false
      ByteRange { start: sb, end: eb } => (sa == sb) && (ea == eb)
    }
  }
}
fn locus_eq(a: v2.std.diagnostic.Locus, b: v2.std.diagnostic.Locus) -> Bool {
  match a {
    Textual { file: fa, extent: ea } => match b {
      Textual { file: fb, extent: eb } => (fa == fb) && extent_eq(a: ea, b: eb)
      NodeLocus { anchor: _ } => false
      PortLocus { anchor: _ } => false
    }
    NodeLocus { anchor: na } => match b {
      Textual { file: _, extent: _ } => false
      NodeLocus { anchor: nb } => na.at == nb.at
      PortLocus { anchor: _ } => false
    }
    PortLocus { anchor: pa } => match b {
      Textual { file: _, extent: _ } => false
      NodeLocus { anchor: _ } => false
      PortLocus { anchor: pb } => pa.at == pb.at
    }
  }
}
fn correction_eq(a: v2.std.diagnostic.Correction, b: v2.std.diagnostic.Correction) -> Bool {
  match a {
    Suggested { node: na } => match b {
      Suggested { node: nb } => na == nb
      Unavailable { reason: _ } => false
    }
    Unavailable { reason: ra } => match b {
      Suggested { node: _ } => false
      Unavailable { reason: rb } => ra == rb
    }
  }
}
fn diagnostic_eq(a: v2.std.diagnostic.Diagnostic, b: v2.std.diagnostic.Diagnostic) -> Bool {
  (a.reason == b.reason)
    && locus_eq(a: a.at, b: b.at)
    && correction_eq(a: a.correction, b: b.correction)
}

fn diagnostic_tail_eq(a: List<v2.std.diagnostic.Diagnostic>, b: List<v2.std.diagnostic.Diagnostic>) -> Bool {
  bag_eq(xs: a, ys: b, eq: diagnostic_eq)
}
fn non_empty_diagnostics_eq(a: v2.std.diagnostic.NonEmptyDiagnostics, b: v2.std.diagnostic.NonEmptyDiagnostics) -> Bool {
  diagnostic_eq(a: a.head, b: b.head) && diagnostic_tail_eq(a: a.tail, b: b.tail)
}

fn non_empty_diagnostics_append(
  a: v2.std.diagnostic.NonEmptyDiagnostics,
  b: v2.std.diagnostic.NonEmptyDiagnostics,
) -> v2.std.diagnostic.NonEmptyDiagnostics {
  NonEmptyDiagnostics {
    head: a.head,
    tail: list_append(left: list_snoc_item(xs: a.tail, item: b.head), right: b.tail)
  }
}
fn diagnostics_merge(outer: v2.std.diagnostic.Diagnostics, inner: v2.std.diagnostic.Diagnostics) -> v2.std.diagnostic.Diagnostics {
  match outer {
    None => inner
    Some { diagnostics: oa } => match inner {
      None => Some { diagnostics: oa }
      Some { diagnostics: ib } =>
        Some {
          diagnostics: non_empty_diagnostics_append(a: oa, b: ib)
        }
    }
  }
}
data diagnostics_monoid: Monoid<v2.std.diagnostic.Diagnostics> = std.algebra.Monoid {
  op: diagnostics_merge,
  identity: None
}
data non_empty_diagnostics_semigroup: Semigroup<v2.std.diagnostic.NonEmptyDiagnostics> = std.algebra.Semigroup {
  op: non_empty_diagnostics_append
}
fn rejected_with_pending(
  pending: v2.std.diagnostic.Diagnostics,
  rejected: v2.std.diagnostic.NonEmptyDiagnostics,
) -> v2.std.diagnostic.NonEmptyDiagnostics {
  match pending {
    None => rejected
    Some { diagnostics: p } => non_empty_diagnostics_append(a: p, b: rejected)
  }
}
fn diagnostics_eq(a: v2.std.diagnostic.Diagnostics, b: v2.std.diagnostic.Diagnostics) -> Bool {
  match a {
    None => match b {
      None => true
      Some { diagnostics: _ } => false
    }
    Some { diagnostics: da } => match b {
      None => false
      Some { diagnostics: db } => non_empty_diagnostics_eq(a: da, b: db)
    }
  }
}
fn outcome_node_eq(a: v2.std.diagnostic.Outcome<Node>, b: v2.std.diagnostic.Outcome<Node>) -> Bool {
  match a {
    v2.std.diagnostic.Accepted { value: av, diagnostics: ad } => match b {
      v2.std.diagnostic.Accepted { value: bv, diagnostics: bd } => (av == bv) && diagnostics_eq(a: ad, b: bd)
      v2.std.diagnostic.Rejected { diagnostics: _ } => false
    }
    v2.std.diagnostic.Rejected { diagnostics: ar } => match b {
      v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
      v2.std.diagnostic.Rejected { diagnostics: br } => non_empty_diagnostics_eq(a: ar, b: br)
    }
  }
}
fn outcome_with_diagnostics<U>(value: U, diagnostics: v2.std.diagnostic.Diagnostics) -> v2.std.diagnostic.Outcome<U> {
  v2.std.diagnostic.Accepted { value: value, diagnostics: diagnostics }
}
fn accepted_thread_diagnostics<T>(
  value: T,
  accumulated: v2.std.diagnostic.Diagnostics,
  incoming: v2.std.diagnostic.Diagnostics,
) -> v2.std.diagnostic.Outcome<T> {
  v2.std.diagnostic.Accepted {
    value: value,
    diagnostics: diagnostics_merge(outer: accumulated, inner: incoming)
  }
}
fn bind_outcome_accepted<U>(od: v2.std.diagnostic.Diagnostics, inner: v2.std.diagnostic.Outcome<U>) -> v2.std.diagnostic.Outcome<U> {
  match inner {
    v2.std.diagnostic.Accepted { value: u, diagnostics: ud } =>
      outcome_with_diagnostics(
        value: u,
        diagnostics: diagnostics_merge(outer: od, inner: ud)
      )
    v2.std.diagnostic.Rejected { diagnostics: r } =>
      v2.std.diagnostic.Rejected { diagnostics: rejected_with_pending(pending: od, rejected: r) }
  }
}
fn bind_outcome<T, U>(o: v2.std.diagnostic.Outcome<T>, f: fn(T) -> v2.std.diagnostic.Outcome<U>) -> v2.std.diagnostic.Outcome<U> {
  match o {
    v2.std.diagnostic.Accepted { value: v, diagnostics: od } => bind_outcome_accepted(od: od, inner: f(v))
    v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn absorb_outcome_diagnostics<T, U>(
  acc: v2.std.diagnostic.Outcome<T>,
  child: v2.std.diagnostic.Outcome<U>,
  policy: v2.std.diagnostic.StageDiagnosticPolicy
) -> v2.std.diagnostic.Outcome<T> {
  match policy.accumulation {
    ShortCircuit => match acc {
      v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
      v2.std.diagnostic.Accepted { value: v, diagnostics: ad } => match child {
        v2.std.diagnostic.Rejected { diagnostics: cr } =>
          v2.std.diagnostic.Rejected { diagnostics: rejected_with_pending(pending: ad, rejected: cr) }
        v2.std.diagnostic.Accepted { value: _, diagnostics: cd } =>
          accepted_thread_diagnostics(value: v, accumulated: ad, incoming: cd)
      }
    }
    Accumulate => match acc {
      v2.std.diagnostic.Accepted { value: v, diagnostics: ad } => match child {
        v2.std.diagnostic.Accepted { value: _, diagnostics: cd } =>
          accepted_thread_diagnostics(value: v, accumulated: ad, incoming: cd)
        v2.std.diagnostic.Rejected { diagnostics: cr } =>
          v2.std.diagnostic.Rejected { diagnostics: rejected_with_pending(pending: ad, rejected: cr) }
      }
      v2.std.diagnostic.Rejected { diagnostics: r } => match child {
        v2.std.diagnostic.Accepted { value: _, diagnostics: cd } =>
          v2.std.diagnostic.Rejected { diagnostics: rejected_with_pending(pending: cd, rejected: r) }
        v2.std.diagnostic.Rejected { diagnostics: cr } =>
          v2.std.diagnostic.Rejected {
            diagnostics: non_empty_diagnostics_append(a: r, b: cr)
          }
      }
    }
  }
}

fn append_outcome_value<T>(
  acc: v2.std.diagnostic.Outcome<List<T>>,
  child: v2.std.diagnostic.Outcome<T>,
  policy: v2.std.diagnostic.StageDiagnosticPolicy
) -> v2.std.diagnostic.Outcome<List<T>> {
  match policy.accumulation {
    ShortCircuit => match acc {
      v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
      v2.std.diagnostic.Accepted { value: values, diagnostics: ad } => match child {
        v2.std.diagnostic.Rejected { diagnostics: cr } =>
          v2.std.diagnostic.Rejected { diagnostics: rejected_with_pending(pending: ad, rejected: cr) }
        v2.std.diagnostic.Accepted { value: child_value, diagnostics: cd } =>
          accepted_thread_diagnostics(
            value: list_snoc_item(xs: values, item: child_value),
            accumulated: ad,
            incoming: cd
          )
      }
    }
    Accumulate => match acc {
      v2.std.diagnostic.Accepted { value: values, diagnostics: ad } => match child {
        v2.std.diagnostic.Accepted { value: child_value, diagnostics: cd } =>
          accepted_thread_diagnostics(
            value: list_snoc_item(xs: values, item: child_value),
            accumulated: ad,
            incoming: cd
          )
        v2.std.diagnostic.Rejected { diagnostics: cr } =>
          v2.std.diagnostic.Rejected { diagnostics: rejected_with_pending(pending: ad, rejected: cr) }
      }
      v2.std.diagnostic.Rejected { diagnostics: r } => match child {
        v2.std.diagnostic.Accepted { value: _, diagnostics: cd } =>
          v2.std.diagnostic.Rejected { diagnostics: rejected_with_pending(pending: cd, rejected: r) }
        v2.std.diagnostic.Rejected { diagnostics: cr } =>
          v2.std.diagnostic.Rejected {
            diagnostics: non_empty_diagnostics_append(a: r, b: cr)
          }
      }
    }
  }
}

fn sequence_outcome<T>(
  xs: List<v2.std.diagnostic.Outcome<T>>,
  policy: v2.std.diagnostic.StageDiagnosticPolicy
) -> v2.std.diagnostic.Outcome<List<T>> {
  fold_list(
    xs: xs,
    empty: outcome_accepted(value: freemonoid_empty()),
    cons: fn(acc, o) {
      append_outcome_value(acc: acc, child: o, policy: policy)
    }
  )
}

fn outcome_eq<T>(a: v2.std.diagnostic.Outcome<T>, b: v2.std.diagnostic.Outcome<T>, payload_eq: fn(T, T) -> Bool) -> Bool {
  match a {
    v2.std.diagnostic.Accepted { value: av, diagnostics: ad } => match b {
      v2.std.diagnostic.Accepted { value: bv, diagnostics: bd } =>
        payload_eq(av, bv) && diagnostics_eq(a: ad, b: bd)
      v2.std.diagnostic.Rejected { diagnostics: _ } => false
    }
    v2.std.diagnostic.Rejected { diagnostics: ar } => match b {
      v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
      v2.std.diagnostic.Rejected { diagnostics: br } => non_empty_diagnostics_eq(a: ar, b: br)
    }
  }
}

type DiagnosticSeverity = SeverityError | SeverityWarning

type EmitDirective {
  severity: v2.std.diagnostic.DiagnosticSeverity
  message: String
}

fn diagnostic_severity_eq(a: v2.std.diagnostic.DiagnosticSeverity, b: v2.std.diagnostic.DiagnosticSeverity) -> Bool {
  match a {
    SeverityError => match b {
      SeverityError => true
      SeverityWarning => false
    }
    SeverityWarning => match b {
      SeverityError => false
      SeverityWarning => true
    }
  }
}

fn emit_directive_eq(a: v2.std.diagnostic.EmitDirective, b: v2.std.diagnostic.EmitDirective) -> Bool {
  diagnostic_severity_eq(a: a.severity, b: b.severity) && (a.message == b.message)
}
