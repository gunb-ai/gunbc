module v2.std.execution_mode

import v2.std.logic { Bool }

type ExecutionMode
  = Hermetic
  | Wet
  | Record

fn execution_mode_is_hermetic(mode: ExecutionMode) -> Bool {
  match mode {
    Hermetic => true
    Wet => false
    Record => false
  }
}

fn execution_mode_is_record(mode: ExecutionMode) -> Bool {
  match mode {
    Hermetic => false
    Wet => false
    Record => true
  }
}

fn execution_mode_is_wet_dispatch(mode: ExecutionMode) -> Bool {
  match mode {
    Hermetic => false
    Wet => true
    Record => true
  }
}
