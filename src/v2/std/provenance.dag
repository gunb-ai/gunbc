module v2.std.provenance


type OriginEvent
  = FromSource { locus: Locus }
  | DerivedBy { producer: Symbol, from: List<OccurrenceId> }
  | GeneratedBy { generator: GeneratorId, from: List<OccurrenceId> }

fn origin_event_from_source(locus: Locus) -> OriginEvent {
  FromSource { locus: locus }
}

type SpanIndex {
  entries: Map<OccurrenceId, OriginEvent>
}

fn span_index_empty() -> SpanIndex {
  SpanIndex { entries: empty_map() }
}

fn span_index_record(index: SpanIndex, id: OccurrenceId, event: OriginEvent) -> SpanIndex {
  SpanIndex {
    entries: map_insert(m: index.entries, key: id, value: event)
  }
}

fn span_index_occurrence_absent_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^span_index_occurrence_absent,
    at: port_locus(port: ^span_index_lookup_port),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn span_index_lookup(index: SpanIndex, id: OccurrenceId) -> Witness<OriginEvent> {
  match index.entries.lookup(id) {
    Holds { value: event } => Holds { value: event }
    Violates { diagnostic: _ } =>
      Violates { diagnostic: span_index_occurrence_absent_diagnostic() }
  }
}

fn span_index_merge(base: SpanIndex, incoming: SpanIndex) -> SpanIndex {
  SpanIndex {
    entries: fold_list(
      xs: incoming.entries.keys(),
      empty: base.entries,
      cons: fn(acc, id) {
        match acc.lookup(id) {
          Holds { value: _ } => acc
          Violates { diagnostic: _ } =>
            match incoming.entries.lookup(id) {
              Holds { value: event } => map_insert(m: acc, key: id, value: event)
              Violates { diagnostic: _ } => acc
            }
        }
      }
    )
  }
}

fn span_index_origin_chain_exhausted_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^span_index_origin_chain_exhausted,
    at: port_locus(port: ^span_index_lookup_port),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn span_index_resolve_textual_locus_from_ids(
  index: SpanIndex,
  ids: List<OccurrenceId>
) -> Witness<Locus> {
  fold_list(
    xs: ids,
    empty: Violates { diagnostic: span_index_origin_chain_exhausted_diagnostic() },
    cons: fn(acc, id) {
      match acc {
        Holds { value: _ } => acc
        Violates { diagnostic: _ } =>
          span_index_resolve_textual_locus(index: index, id: id)
      }
    }
  )
}

fn span_index_resolve_textual_locus(index: SpanIndex, id: OccurrenceId) -> Witness<Locus> {
  match span_index_lookup(index: index, id: id) {
    Holds { value: event } =>
      match event {
        FromSource { locus } =>
          match locus {
            Textual { file: _, extent: _ } => Holds { value: locus }
            _ => Violates { diagnostic: span_index_origin_chain_exhausted_diagnostic() }
          }
        DerivedBy { producer: _, from: from } =>
          span_index_resolve_textual_locus_from_ids(index: index, ids: from)
        GeneratedBy { generator: _, from: from } =>
          span_index_resolve_textual_locus_from_ids(index: index, ids: from)
      }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn node_artifact_provenance(node: Node, artifact: Artifact) -> NodeArtifactProvenance {
  NodeArtifactProvenance { node: node, artifact: artifact }
}
