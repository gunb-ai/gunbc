module v2.std.provenance

type OriginEvent
  = FromSource { locus: v2.std.diagnostic.Locus }
  | DerivedBy { producer: v2.std.node.Symbol, from: std.types.List<std.occurrence_identity.OccurrenceId> }
  | GeneratedBy { generator: v2.std.artifact.GeneratorId, from: std.types.List<std.occurrence_identity.OccurrenceId> }

fn origin_event_from_source(locus: v2.std.diagnostic.Locus) -> OriginEvent {
  FromSource { locus: locus }
}

type SpanIndex {
  entries: std.types.Map<std.occurrence_identity.OccurrenceId, OriginEvent>
}

fn span_index_empty() -> SpanIndex {
  SpanIndex { entries: v2.std.collection.empty_map() }
}

fn span_index_record(index: SpanIndex, id: std.occurrence_identity.OccurrenceId, event: OriginEvent) -> SpanIndex {
  SpanIndex {
    entries: v2.std.collection.map_insert(m: index.entries, key: id, value: event)
  }
}

fn span_index_occurrence_absent_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^span_index_occurrence_absent,
    at: v2.std.diagnostic.port_locus(port: ^span_index_lookup_port),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn span_index_lookup(index: SpanIndex, id: std.occurrence_identity.OccurrenceId) -> v2.std.witness.Witness<OriginEvent> {
  v2.std.witness.witness_from_optional(opt: index.entries.lookup(id), absent: span_index_occurrence_absent_diagnostic())
}

fn span_index_merge(base: SpanIndex, incoming: SpanIndex) -> SpanIndex {
  SpanIndex {
    entries: v2.std.algebra.fold_list(
      xs: map_keys(incoming.entries),
      empty: base.entries,
      cons: fn(acc, id) {
        match acc.lookup(id) {
          Present { value: _ } => acc
          Absent =>
            match incoming.entries.lookup(id) {
              Present { value: event } => v2.std.collection.map_insert(m: acc, key: id, value: event)
              Absent => acc
            }
        }
      }
    )
  }
}

fn span_index_origin_chain_exhausted_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^span_index_origin_chain_exhausted,
    at: v2.std.diagnostic.port_locus(port: ^span_index_lookup_port),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn span_index_resolve_textual_locus_from_ids(
  index: SpanIndex,
  ids: std.types.List<std.occurrence_identity.OccurrenceId>
) -> v2.std.witness.Witness<v2.std.diagnostic.Locus> {
  v2.std.algebra.fold_list(
    xs: ids,
    empty: v2.std.witness.Violates { diagnostic: span_index_origin_chain_exhausted_diagnostic() },
    cons: fn(acc, id) {
      match acc {
        Holds { value: _ } => acc
        v2.std.witness.Violates { diagnostic: _ } =>
          span_index_resolve_textual_locus(index: index, id: id)
      }
    }
  )
}

fn span_index_resolve_textual_locus(index: SpanIndex, id: std.occurrence_identity.OccurrenceId) -> v2.std.witness.Witness<v2.std.diagnostic.Locus> {
  match span_index_lookup(index: index, id: id) {
    Holds { value: event } =>
      match event {
        FromSource { locus } =>
          match locus {
            v2.std.diagnostic.Textual { file: _, extent: _ } => v2.std.witness.Holds { value: locus }
            _ => v2.std.witness.Violates { diagnostic: span_index_origin_chain_exhausted_diagnostic() }
          }
        DerivedBy { producer: _, from: from } =>
          span_index_resolve_textual_locus_from_ids(index: index, ids: from)
        GeneratedBy { generator: _, from: from } =>
          span_index_resolve_textual_locus_from_ids(index: index, ids: from)
      }
    v2.std.witness.Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
  }
}

fn node_artifact_provenance(node: v2.std.node.Node, artifact: v2.std.artifact.Artifact) -> v2.std.artifact.NodeArtifactProvenance {
  v2.std.artifact.NodeArtifactProvenance { node: node, artifact: artifact }
}
