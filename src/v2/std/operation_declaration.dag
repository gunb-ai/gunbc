module v2.std.operation_declaration

import std.decl_ref { DeclarationRef, decl_ref }
import std.types { Bool, List, Map }
import std.optional { Absent, Optional, Present }
import std.algebra { Cons, Empty, empty_map, fold_list, length, list_snoc_item, map_insert, map_lookup }
import std.effects { EffectShape, KeySource, ReadEffect, ExecuteEffect }
import v2.std.text { String }
import v2.std.integer { Int }
import v2.std.node { Symbol, symbol_intern_lexeme, symbol_lexeme }
import v2.std.qualified_name { QualifiedName, qualified_name_from_string_segments, qualified_name_init, qualified_name_last_segment, qualified_name_to_dotted_string }
import std.primitive_projection { primitive_projection_roster, HostRealizedSeam, ModeledProjection, DivergentProjection }
import v2.compiler.dependency_demand { RequirementClass, RequiresNone, RequiresResources, RequiresOpaque, RequiresUndeclared }

// ONE DECLARATION PER HOST-BOUNDARY OPERATION, keyed by its declaration path.
//
// THE MODELING OBLIGATION THIS DISCHARGES (demand_engine_program M2V, "Population and effects";
// D16 part (1), RULED 2026-10-25). An operation's execution semantics and its access shape used to be
// stated in v2.compiler.primitive_execution_semantics keyed by a PRIMITIVE-IDENTITY SLUG, while D13
// (v2.compiler.dependency_demand) joins operations by DECLARATION PATH -- two keyings of one concept,
// operation identity. The B0 census showed what that costs: its index is keyed by the slug string
// while the corpus's OperationFact paths are module-qualified, so the index never matched a walked
// corpus operation. The remedy named there is "that declaration, not a wider default": every fact
// about an operation is declared AT ITS DECLARATION, keyed by the same path D13 already keys by.
//
// THE HOME. std.primitive_projection is the seed-consumed authority for "this declaration is
// host-realized" (v1 imports it), and its import closure stops at std.decl_ref/std.types -- a shape
// fact needs std.effects (whose closure reaches extdeps) and a requirement fact reaches
// v2.compiler.dependency_demand's vocabulary, so NEITHER can live under that ceiling; the seed-safety
// boundary refuses them. This module is the next home up that both the census and the claims can
// read: it joins std.primitive_projection on the SAME key (std.decl_ref DeclarationRef) and adds the
// facts that half cannot carry. PrimitiveExecutionSemantics and EffectOperationDisposition are
// relocated HERE VERBATIM from v2.compiler.primitive_execution_semantics, which this change deletes:
// this is that roster relocated and re-keyed, not a second one (DESIGN 2).
//
// WHO OWES A ROW (D13 section 2.4: a transparent body's facts are DERIVED from its closure; a second
// statement of a derivable fact is the fork DESIGN 2 forbids). Rows are owed only at OPAQUE
// operation boundaries: the declarations std.primitive_projection projects as HostRealizedSeam (and
// the capability members the demand census synthesizes by path under std.resources). A row on a
// TRANSPARENT fn carries no row: the claim every_declaration_row_is_a_projected_host_seam
// (test.claim.compiler.operation_declaration_seam) holds every row's declaration to a
// HostRealizedSeam projection, so a row on a transparent fn reddens it. That is a claim over the
// live roster, not a refusal at construction; a data row cannot refuse, so the rung is
// mechanically preventable, not structurally guaranteed.
//
// ABSENCE NEVER DEFAULTS. An operation projected host-realized with no row here answers
// OperationDeclarationAbsent in every consumer, and that arm BLOCKS -- exactly as
// ExecutionSemanticsUnknown blocked from the deleted roster (a row missing from the roster blocked
// then; a row missing here blocks now). No consumer may read an absent row as Pure, as RequiresNone,
// or as effect-free.

// WHAT THE OPERATION DOES, kept strictly apart from what XL-1 intends to do about it. A boolean
// effectful flag would have been the obvious carrier and is the wrong one: it conflates an operation
// that must observe external state with one that merely happens to reach the host through its CURRENT
// realization, and those two have opposite remedies -- the first earns a transport, the second earns
// having its input bound or its consumer deleted. Pure and ReadsBoundInput are the arms that need no
// host boundary at all; ObservesHost and ActuatesHost are separated because reading external state and
// changing it carry different grants and different receipts, and a single arm would let an actuation
// ride an observation's admission. ExecutionSemanticsUnknown is not a default -- it is the arm that
// BLOCKS, and an operation sitting in it may not be implemented as a transport.
// (RELOCATED VERBATIM from v2.compiler.primitive_execution_semantics, M2V two-keyings.)
type PrimitiveExecutionSemantics
  = Pure
  | ReadsBoundInput { input_identity: Symbol }
  | ObservesHost { operation_identity: Symbol }
  | ActuatesHost { operation_identity: Symbol }
  | ExecutionSemanticsUnknown

// WHAT XL-1 WILL DO, which is a different subject from what the operation does and therefore a
// different carrier. An operation whose semantics is ObservesHost today may still be dispositioned
// BoundCompilerInput, because the semantics describes the realization that exists and the disposition
// describes the one that will. Collapsing them would make the classification unable to say the most
// useful thing it has to say: that six of the seven operations reach the host because of how they are
// realized and not because their answer requires external state. OperationDispositionUnclassified
// BLOCKS -- an operation in this arm is not implemented as a transport, which is the point of
// classifying before building.
// (RELOCATED VERBATIM from v2.compiler.primitive_execution_semantics, M2V two-keyings. The semantics/
// disposition separation is load-bearing: the disposition, with its blocking_question, is where the
// six corpus-fact operations carry the still-open question -- the semantics stays the TRUTH that
// their bodies observe the host, so closing the question never requires un-declaring a known fact.)
type EffectOperationDisposition
  = BoundCompilerInput { input_identity: Symbol }
  | NativeDerivedComputation { derived_from: Symbol }
  | NativeHostObservation { operation_identity: Symbol }
  | NativeHostActuation { operation_identity: Symbol }
  | OperationRetired { consumer: DeclarationRef }
  | OperationDispositionUnclassified { blocking_question: Symbol }

// THE ACCESS SHAPE, keyed at the declaration beside the requirement and the semantics (D16 part (1)).
// The shape AUTHORITY is std.effects.EffectShape and this only ever NAMES a shape from it -- a
// declaration states which EffectShape arm the operation's body has; it never mints a shape (DESIGN
// 3, no fork of the shape vocabulary; std.effect_grant keeps coarsening verbs from std.effects
// alone). NoResourceAccess is the declaration of an operation that touches NO resource (a Pure
// kernel seam, requirement RequiresNone): EffectShape has no arm for "no effect", and filling one
// with ReadEffect would grant a Read verb to a pure operator, so the absence is stated here, on the
// declaration, and is not an EffectShape. AccessShapeNotYetDeclared is NOT a default: like ExecutionSemanticsUnknown it BLOCKS, and
// its reason says which obligation owes the arm. Two are named in the plan and neither is minted
// here: the manifest/metadata read has no EffectShape arm (D16 part (3)'s ManifestPathRead /
// DeclaredManifestRoots obligation -- the five corpus-scan fact operations sit in this arm for
// exactly that reason), and ExecuteEffect's footprint is opaque (its resource_identifiers() is
// Empty, so an actuation's containment is part (3)'s obligation too).
type DeclaredAccessShape
  = DeclaredShape { shape: EffectShape<KeySource> }
  | NoResourceAccess
  | AccessShapeNotYetDeclared { reason: Symbol }

// THE DECLARATION ROW: one per host-boundary operation, keyed by its std.decl_ref DeclarationRef --
// the same key std.primitive_projection's HostRealizedSeam rows use, so the two halves join without
// a translation (and without a third identity). The requirement keeps D13's OWN vocabulary
// (v2.compiler.dependency_demand.RequirementClass): this is the extension of the existing
// requirement-declaration site D13 already reads, not a parallel table; RequiresUndeclared blocks
// there and the whole absent row blocks here.
type OperationDeclaration {
  declaration: DeclarationRef
  requirement: RequirementClass
  semantics: PrimitiveExecutionSemantics
  disposition: EffectOperationDisposition
  shape: DeclaredAccessShape
}

fn operation_declaration_row(
  module_path: String,
  decl_name: String,
  requirement: RequirementClass,
  semantics: PrimitiveExecutionSemantics,
  disposition: EffectOperationDisposition,
  shape: DeclaredAccessShape
) -> OperationDeclaration {
  OperationDeclaration {
    declaration: decl_ref(module_path: module_path, decl_name: decl_name),
    requirement: requirement,
    semantics: semantics,
    disposition: disposition,
    shape: shape
  }
}

// THE ROSTER: the population std.primitive_projection projects as HostRealizedSeam -- the seam fns
// this change adds for the six v1-builtin-only fact/read operations, plus the seam declarations that
// already existed. The seven M2V operations are the six plus filesystem_read. Semantics and
// disposition are copied from the deleted slug roster's rows verbatim (their identities moved, their
// content did not); requirements name the resource the operation's own body reads.
//
// THE SIX CORPUS-FACT OPERATIONS answer RequiresResources{std.resources.Filesystem}: their bodies
// walk the corpus tree from the roots they are handed. Their disposition is
// OperationDispositionUnclassified with the blocking_question the census recorded verbatim -- the
// open question "does lens execution bind a corpus snapshot" stays WHERE IT LIVES (the disposition),
// and effect_demand's blocked/implementable rosters keep deriving from the disposition, never from
// the semantics. Their shape is AccessShapeNotYetDeclared for the manifest-read reason above.
//
// THE PURE ARITHMETIC/TEXT SEAMS (map/list/string/algebra primitives under std.*) whose bodies are
// self-calls to kernel operators answer RequiresNone: they take their inputs as arguments and bind
// nothing outside them. That is a DERIVED-shaped fact stated at the boundary because the boundary is
// opaque (there is no body to walk); it is not a default, and a row for one that later grows a real
// host read must move, because the census reads THESE rows and not a fallback.
data operation_declaration_roster: List<OperationDeclaration> = [
