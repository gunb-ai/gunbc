// THE INDEX, built once per module: rows grouped under their declaration path. Every lookup below is
// a keyed read of this one value, so a reader asked about N operations does N keyed reads, never N
// scans of the roster. The seed is a variable feeding a fold accumulator (the form the emitter
// types), never `empty_map()` as a direct `map_lookup` argument.
data operation_declaration_index: Map<QualifiedName, List<OperationDeclaration>> = fold_list(
  xs: operation_declaration_roster,
  empty: empty_map(),
  cons: fn(m, row) {
    map_insert(
      m: m,
      key: operation_declaration_path(declaration: row.declaration),
      value: list_snoc_item(
        xs: operation_declaration_rows_at(index: m, declaration: row.declaration),
        item: row
      )
    )
  }
)

// THE HOST-SEAM POPULATION, indexed once by declaration path: the paths std.primitive_projection
// projects at HostRealizedSeam. D13's seam test is a keyed read of this value, so asking N walked
// declarations costs N keyed reads, never N folds of the projection roster (DESIGN.md section 6).
data host_seam_projection_index: Map<QualifiedName, DeclarationRef> = fold_list(
  xs: primitive_projection_roster(),
  empty: empty_map(),
  cons: fn(m, row) {
    match row.fidelity {
      HostRealizedSeam => map_insert(m: m, key: operation_declaration_path(declaration: row.declaration), value: row.declaration)
      ModeledProjection => m
      DivergentProjection { divergence: _ } => m
    }
  }
)

fn operation_declaration_projected_host_seam_at(declaration: DeclarationRef) -> Optional<DeclarationRef> {
  map_lookup(m: host_seam_projection_index, key: operation_declaration_path(declaration: declaration))
}

fn operation_declaration_rows_at(
  index: Map<QualifiedName, List<OperationDeclaration>>,
  declaration: DeclarationRef
) -> List<OperationDeclaration> {
  match map_lookup(m: index, key: operation_declaration_path(declaration: declaration)) {
    Present { value: rows } => rows
    Absent => Empty
  }
}

fn operation_declaration_for(
  declaration: DeclarationRef
) -> Optional<OperationDeclaration> {
  match operation_declaration_rows_at(index: operation_declaration_index, declaration: declaration) {
    Cons { head: row, tail: _ } => Present { value: row }
    Empty => Absent
  }
}

// A key declared by more than one row is AMBIGUOUS: the B0 census promoted ambiguous keys to nothing
// (the operation stayed Unknown and was counted) rather than pick; the same discipline holds here,
// and the count is what the census reports. Ambiguity here can only be an authoring error -- keys
// are declared paths, and one declaration is one operation.
fn operation_declaration_row_count_for(
  declaration: DeclarationRef
) -> Int {
  length(xs: operation_declaration_rows_at(index: operation_declaration_index, declaration: declaration))
}

fn operation_declaration_ambiguous_row_count() -> Int {
  fold_list(
    xs: operation_declaration_roster,
    empty: 0,
    cons: fn(n, row) {
      if operation_declaration_row_count_for(declaration: row.declaration) > 1 { n + 1 } else { n }
    }
  )
}

// THE KEY THE WHOLE CHANGE TURNS ON: the declaration path as the join key D13 and the B0 census
// already use. Kept here so a consumer never re-derives a QualifiedName from a string and the slug
// join cannot come back.
fn operation_declaration_path(
  declaration: DeclarationRef
) -> QualifiedName {
  qualified_name_from_string_segments(segments: [declaration.module_path, declaration.decl_name])
}

// THE PATH-JOINED LOOKUP the census and the B0 reach use: a walked operation's QualifiedName becomes
// the DeclarationRef (owning module segments -> module_path, last segment -> decl_name) and the row
// is read by that key. This is the single join between the walked corpus and the declarations; the
// deleted slug index did the same job by stringified path compared to a primitive slug, and matched
// nothing a module walk produced.
// An empty path names no declaration: the answer is Absent, never an invented key that could
// collide with a row.
fn declaration_ref_of_qualified_name(
  path: QualifiedName
) -> Optional<DeclarationRef> {
  match qualified_name_last_segment(qn: path) {
    Present { value: decl_sym } =>
      Present {
        value: decl_ref(
          module_path: qualified_name_to_dotted_string(qn: qualified_name_init(qn: path)),
          decl_name: symbol_lexeme(sym: decl_sym)
        )
      }
    Absent => Absent
  }
}

fn operation_declaration_for_path(
  path: QualifiedName
) -> Optional<OperationDeclaration> {
  match declaration_ref_of_qualified_name(path: path) {
    Present { value: declaration } => operation_declaration_for(declaration: declaration)
    Absent => Absent
  }
}

// THE M2V POPULATION, as a view over the roster: every declaration whose semantics OBSERVES or
// ACTUATES the host. Membership is the row's own semantics, not a list of names: declaring a new
// host-touching seam puts it in the population, and a Pure row cannot be in it. The full roster
// (every projected seam) is what D13 opacity reads.
fn operation_declaration_m2v_population() -> List<OperationDeclaration> {
  fold_list(
    xs: operation_declaration_roster,
    empty: [],
    cons: fn(acc, row) {
      match row.semantics {
        ObservesHost { operation_identity: _ } => list_snoc_item(xs: acc, item: row)
        ActuatesHost { operation_identity: _ } => list_snoc_item(xs: acc, item: row)
        Pure => acc
        ReadsBoundInput { input_identity: _ } => acc
        ExecutionSemanticsUnknown => acc
      }
    }
  )
}

// THE M2V CLASSIFICATION VIEW, the shape the M2V census reads. Same three facts the deleted roster
// carried -- operation identity, semantics, disposition -- with operation identity moved from a
// PRIMITIVE-IDENTITY SLUG to the DECLARATION. The census's derivations read row.disposition exactly
// as before, so the blocked/implementable split is unchanged; what changed is that the key is the path
// D13 joins by, making the two keyings of one concept into one. This is the deleted roster's data as a
// view over operation_declaration_roster, not a second roster (DESIGN 2, delete-first).
type EffectOperationClassification {
  declaration: DeclarationRef
  semantics: PrimitiveExecutionSemantics
  disposition: EffectOperationDisposition
}

fn effect_demand_operation_classification(
  module_path: String,
  decl_name: String,
  semantics: PrimitiveExecutionSemantics,
  disposition: EffectOperationDisposition
) -> EffectOperationClassification {
  EffectOperationClassification {
    declaration: decl_ref(module_path: module_path, decl_name: decl_name),
    semantics: semantics,
    disposition: disposition
  }
}

fn effect_demand_operation_classifications() -> List<EffectOperationClassification> {
  fold_list(
    xs: operation_declaration_m2v_population(),
    empty: [],
    cons: fn(acc, row) {
      list_snoc_item(
        xs: acc,
        item: EffectOperationClassification {
          declaration: row.declaration,
          semantics: row.semantics,
          disposition: row.disposition
        }
      )
    }
  )
}

// THE BIJECTION WITH std.primitive_projection is claimed, in both directions at identity grain, by
// test/claim/compiler/operation_declaration_seam (every_declaration_row_is_a_projected_host_seam_holds
// and every_host_realized_seam_carries_exactly_one_declaration_row_holds); no validator lives here.
