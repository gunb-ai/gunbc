  operation_declaration_row(
    module_path: "v2.std.live_read",
    decl_name: "filesystem_read",
    requirement: RequiresResources { resources: [qualified_name_from_string_segments(segments: ["std", "resources", "Filesystem"])] },
    semantics: ObservesHost { operation_identity: symbol_intern_lexeme(lexeme: "read_named_file") },
    disposition: NativeHostObservation { operation_identity: symbol_intern_lexeme(lexeme: "read_named_file") },
    shape: DeclaredShape { shape: ReadEffect }
