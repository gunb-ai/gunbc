module v2.std.witness

import v2.std.diagnostic { Diagnostic, ExternalContractUnknown, Outcome, Unavailable, outcome_accepted, invariant_port_locus }
import v2.std.node { Node, Symbol }
import std.optional { Absent, Optional, Present }
import std.algebra { fold_list, map_lookup }
import std.types { List, Map }

type Witness<C>
  = Holds { value: C }
  | Violates { diagnostic: Diagnostic }

fn witness_from_optional<T>(opt: Optional<T>, absent: Diagnostic) -> Witness<T> {
  match opt {
    Present { value: v } => Holds { value: v }
    Absent => Violates { diagnostic: absent }
  }
}

// A bare `Violates { .. }` construction nested inside a struct literal, fold seed, or call
// argument gives the v1 emitter no Witness-headed type to read its carrier from (the enclosing
// expression's type is what reaches the constructor, never the argument position's), so those
// sites emitted a located refusal. Constructing through this fn puts the variant in a
// Witness-headed position -- the same shape witness_from_optional already emits -- and lets the
// carrier unify at the call instead. Dissolves into bare constructions once inference records
// per-call type-argument substitutions (the next-rung trigger named in src/v1/05_emit_rust.dag's
// rust_witness_carrier_from_witness_headed_type_node note).
fn witness_violates<C>(diagnostic: Diagnostic) -> Witness<C> {
  Violates { diagnostic: diagnostic }
}

type StructuralPropertyWitness {
  property: Symbol
  evidence: Node
}
type HomomorphismWitness {
  rule: Symbol
  evidence: Node
}

fn optional_absent_unwrap_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^optional_absent_unwrap,
    at: invariant_port_locus(port: ^optional_present_witness_port, invariant: ^optional_absent_unwrap),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn optional_present_witness<T>(opt: Optional<T>) -> Witness<T> {
  witness_from_optional(opt: opt, absent: optional_absent_unwrap_diagnostic())
}

type IndexedLookup<T> {
  index: Int
  value: Witness<T>
}

fn map_get_checked<K, V>(m: Map<K, V>, key: K) -> Outcome<Optional<V>> {
  outcome_accepted(value: map_lookup(m: m, key: key))
}
fn list_nth<T>(xs: List<T>, wanted: Int, absent: Diagnostic) -> Witness<T> {
  fold_list(
    xs: xs,
    empty: IndexedLookup {
      index: 0,
      value: witness_violates(diagnostic: absent)
    },
    cons: fn(acc, item) {
      IndexedLookup {
        index: acc.index + 1,
        value: if acc.index == wanted {
          Holds { value: item }
        } else {
          acc.value
        }
      }
    }
  ).value
}
