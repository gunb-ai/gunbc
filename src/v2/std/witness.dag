module v2.std.witness


import v2.std.diagnostic { Diagnostic }
import v2.std.node { Node, Symbol }
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type Witness<C>
  = Holds { value: C }
  | Violates { diagnostic: Diagnostic }
type StructuralPropertyWitness {
  property: Symbol
  evidence: Node
}
type HomomorphismWitness {
  rule: Symbol
  evidence: Node
}
