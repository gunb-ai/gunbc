module v2.std.witness


type Witness<C>
  = Holds { value: C }
  | Violates { diagnostic: v2.std.diagnostic.Diagnostic }

fn witness_from_optional<T>(opt: v2.std.optional.Optional<T>, absent: v2.std.diagnostic.Diagnostic) -> Witness<T> {
  match opt {
    v2.std.optional.Present { value: v } => Holds { value: v }
    v2.std.optional.Absent => Violates { diagnostic: absent }
  }
}

type StructuralPropertyWitness {
  property: v2.std.node.Symbol
  evidence: v2.std.node.Node
}
type HomomorphismWitness {
  rule: v2.std.node.Symbol
  evidence: v2.std.node.Node
}
