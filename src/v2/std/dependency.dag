module v2.std.dependency


type DependencyKind
  = Contains
  | BindsTo
  | TypeDependsOn
  | DataDependsOn
  | EffectDependsOn
  | ResourceDependsOn
  | ModuleDependsOn
  | BarrierBefore
  | PlacementDependsOn
  | ModelDependsOn
  | ProjectionDependsOn
  | GeneratedFrom
  | VerifiedBy
  | PromotedBy
  | BootstrapDependsOn

type DependencyView {
  source: v2.std.node.Node
  dependent: v2.std.node.Node
  kind: DependencyKind
  usage_site: v2.std.node.Node
}

// THE PREREQUISITE RELATION, WITH ITS SUBJECT AS A PARAMETER.
//
// A dependency is a direction between two things plus what kind of dependence it is, and that shape
// does not vary with what the two things are. DependencyView above is the COMPILER'S instantiation
// of it: its subject is Node and it additionally carries usage_site, an AST occurrence that only
// means anything when the subject is program structure. Those extra facts are compiler metadata, not
// part of the relation, which is why the relation is extracted from underneath rather than
// DependencyView being widened -- widening it would push a Node-shaped carrier onto every consumer
// of a relation whose subject is not program structure at all.
//
// WHY THIS IS EXTRACTED RATHER THAN A SECOND GRAPH. Host convergence needs exactly this relation
// over planned operations: a unit file must exist before the manager can register it, a runtime must
// be materialized before a service that runs it can start. Answering that with its own graph would
// fork readiness, cycle detection and layering -- three things that are easy to reimplement and easy
// to reimplement subtly wrong -- and would leave two authorities answering one question, which is
// the violation this module exists on the correct side of. The kinds it needs are already in the
// closed vocabulary above (ResourceDependsOn for an enduring requirement, BarrierBefore for a
// procedural one), modelled before any consumer existed.
//
// The subject carries no equality constraint. Callers supply one, exactly as the membership spine
// takes key_eq rather than assuming its members are comparable.
type DependencyRelation<Subject> {
  prerequisite: Subject
  dependent: Subject
  kind: DependencyKind
}

// The compiler's view IS a relation over Node once its occurrence metadata is set aside. Naming the
// projection means the scheduler consumes one shape, and the Node case stays a caller of the general
// path rather than a parallel implementation of it.
fn dependency_view_relation(view: DependencyView) -> DependencyRelation<v2.std.node.Node> {
  DependencyRelation {
    prerequisite: view.source,
    dependent: view.dependent,
    kind: view.kind,
  }
}

fn dependency_view_relations(views: List<DependencyView>) -> List<DependencyRelation<v2.std.node.Node>> {
  fold(views, init: [], f: fn(acc, v) {
    v2.std.algebra.list_snoc_item(xs: acc, item: dependency_view_relation(view: v))
  })
}

type ClassifiedDependencyView<C> {
  dependency: DependencyView
  classification: C
}

type DependencyKindClassifier<C> {
  contains: C
  binds_to: C
  type_depends_on: C
  data_depends_on: C
  effect_depends_on: C
  resource_depends_on: C
  module_depends_on: C
  barrier_before: C
  placement_depends_on: C
  model_depends_on: C
  projection_depends_on: C
  generated_from: C
  verified_by: C
  promoted_by: C
  bootstrap_depends_on: C
}

fn classify_dependency_kind<C>(classifier: DependencyKindClassifier<C>, kind: DependencyKind) -> C {
  match kind {
    Contains => classifier.contains
    BindsTo => classifier.binds_to
    TypeDependsOn => classifier.type_depends_on
    DataDependsOn => classifier.data_depends_on
    EffectDependsOn => classifier.effect_depends_on
    ResourceDependsOn => classifier.resource_depends_on
    ModuleDependsOn => classifier.module_depends_on
    BarrierBefore => classifier.barrier_before
    PlacementDependsOn => classifier.placement_depends_on
    ModelDependsOn => classifier.model_depends_on
    ProjectionDependsOn => classifier.projection_depends_on
    GeneratedFrom => classifier.generated_from
    VerifiedBy => classifier.verified_by
    PromotedBy => classifier.promoted_by
    BootstrapDependsOn => classifier.bootstrap_depends_on
  }
}

fn classify_dependency_view<C>(
  classifier: DependencyKindClassifier<C>,
  view: DependencyView
) -> ClassifiedDependencyView<C> {
  ClassifiedDependencyView {
    dependency: view,
    classification: classify_dependency_kind(classifier: classifier, kind: view.kind)
  }
}

fn classified_source<C>(view: ClassifiedDependencyView<C>) -> v2.std.node.Node {
  view.dependency.source
}

fn classified_dependent<C>(view: ClassifiedDependencyView<C>) -> v2.std.node.Node {
  view.dependency.dependent
}

fn classified_usage_site<C>(view: ClassifiedDependencyView<C>) -> v2.std.node.Node {
  view.dependency.usage_site
}

fn classified_dependency_view_eq<C>(
  a: ClassifiedDependencyView<C>,
  b: ClassifiedDependencyView<C>,
  classification_eq: fn(C, C) -> Bool
) -> Bool {
  (a.dependency == b.dependency) && classification_eq(a.classification, b.classification)
}

type DependencyFoldState {
  current: v2.std.node.Node
  dependencies: List<DependencyView>
}

fn classify_named_edge_usage(parent: v2.std.node.Node, sym: v2.std.node.Symbol) -> DependencyKind {
  if sym == ^dependency_binds_to_edge {
    match parent.kind {
      v2.std.node.ComputationNode { behavior: v2.std.node.Bind } => Contains
      _ => BindsTo
    }
  } else if sym == ^dependency_module_import_edge {
    ModuleDependsOn
  } else if sym == ^dependency_bootstrap_depends_edge {
    BootstrapDependsOn
  } else {
    Contains
  }
}

fn classify_node_edge_usage(parent: v2.std.node.Node, edge: v2.std.node.Edge) -> DependencyKind {
  match edge.label {
    v2.std.node.Named { name: sym } => classify_named_edge_usage(parent: parent, sym: sym)
    v2.std.node.Positional => Contains
  }
}

fn dependency_view_for_edge(parent: v2.std.node.Node, edge: v2.std.node.Edge) -> DependencyView {
  let kind = classify_node_edge_usage(parent: parent, edge: edge)
  DependencyView {
    source: parent,
    dependent: edge.target,
    kind: kind,
    usage_site: edge.target
  }
}

fn append_dependency_views(left: List<DependencyView>, right: List<DependencyView>) -> List<DependencyView> {
  v2.std.algebra.list_append(left: left, right: right)
}

fn dependency_fold_init(n: v2.std.node.Node) -> DependencyFoldState {
  DependencyFoldState {
    current: n,
    dependencies: []
  }
}

fn dependency_fold_step(acc: DependencyFoldState, edge: v2.std.node.Edge, child_state: DependencyFoldState) -> DependencyFoldState {
  DependencyFoldState {
    current: acc.current,
    dependencies: append_dependency_views(
      left: v2.std.algebra.list_snoc_item(xs: acc.dependencies, item: dependency_view_for_edge(parent: acc.current, edge: edge)),
      right: child_state.dependencies
    )
  }
}

fn dependency_fold_algebra() -> v2.std.node.NodeFold<DependencyFoldState> {
  v2.std.node.NodeFold {
    init: dependency_fold_init,
    step: dependency_fold_step
  }
}

fn dependency_fold_dependencies(state: DependencyFoldState) -> List<DependencyView> {
  state.dependencies
}

fn dependency_lens(root: v2.std.node.Node) -> List<DependencyView> {
  dependency_fold_dependencies(
    state: v2.std.node.fold_node(
      n: root,
      algebra: dependency_fold_algebra()
    )
  )
}

// A layer is a set of subjects with no prerequisite among them still outstanding, so it is the same
// shape whatever the subjects are. Parameterized for the same reason the relation above is: the
// compiler schedules Nodes and host convergence schedules planned operations, and layering is one
// concept rather than one per subject.
type ReadinessLayer<Subject> {
  ready: List<Subject>
}

type ReadinessFoldState {
  current: v2.std.node.Node
  ready: List<v2.std.node.Node>
  layers: List<ReadinessLayer<v2.std.node.Node>>
}

fn readiness_fold_init(n: v2.std.node.Node) -> ReadinessFoldState {
  ReadinessFoldState {
    current: n,
    ready: [n],
    layers: []
  }
}

fn ready_set_fold_step(acc: ReadinessFoldState, _edge: v2.std.node.Edge, child_state: ReadinessFoldState) -> ReadinessFoldState {
  ReadinessFoldState {
    current: acc.current,
    ready: append_nodes(left: acc.ready, right: child_state.ready),
    layers: acc.layers
  }
}

fn ready_set_algebra() -> v2.std.node.NodeFold<ReadinessFoldState> {
  v2.std.node.NodeFold {
    init: readiness_fold_init,
    step: ready_set_fold_step
  }
}

fn readiness_fold_ready(state: ReadinessFoldState) -> List<v2.std.node.Node> {
  state.ready
}

fn ready_set(graph_node: v2.std.node.Node) -> List<v2.std.node.Node> {
  readiness_fold_ready(
    state: v2.std.node.fold_node(
      n: graph_node,
      algebra: ready_set_algebra()
    )
  )
}

fn append_nodes(left: List<v2.std.node.Node>, right: List<v2.std.node.Node>) -> List<v2.std.node.Node> {
  v2.std.algebra.list_append(left: left, right: right)
}

fn topological_layers_fold_init(n: v2.std.node.Node) -> ReadinessFoldState {
  ReadinessFoldState {
    current: n,
    ready: [n],
    layers: [
      ReadinessLayer {
        ready: [n]
      }
    ]
  }
}

fn topological_layers_fold_step(acc: ReadinessFoldState, _edge: v2.std.node.Edge, child_state: ReadinessFoldState) -> ReadinessFoldState {
  ReadinessFoldState {
    current: acc.current,
    ready: append_nodes(left: acc.ready, right: child_state.ready),
    layers: append_readiness_layers(left: acc.layers, right: child_state.layers)
  }
}

fn topological_layers_algebra() -> v2.std.node.NodeFold<ReadinessFoldState> {
  v2.std.node.NodeFold {
    init: topological_layers_fold_init,
    step: topological_layers_fold_step
  }
}

fn readiness_fold_layers(state: ReadinessFoldState) -> List<ReadinessLayer<v2.std.node.Node>> {
  state.layers
}

fn topological_layers(graph_node: v2.std.node.Node) -> List<ReadinessLayer<v2.std.node.Node>> {
  readiness_fold_layers(
    state: v2.std.node.fold_node(
      n: graph_node,
      algebra: topological_layers_algebra()
    )
  )
}

fn append_readiness_layers(left: List<ReadinessLayer<v2.std.node.Node>>, right: List<ReadinessLayer<v2.std.node.Node>>) -> List<ReadinessLayer<v2.std.node.Node>> {
  v2.std.algebra.list_append(left: left, right: right)
}
