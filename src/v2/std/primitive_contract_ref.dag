module v2.std.primitive_contract_ref

import std.optional { Absent, Optional, Present, optional_absent, optional_present }
import std.decl_ref { DeclarationRef, decl_ref }
import v2.std.node { Symbol, symbol_lexeme }
import v2.std.qualified_name { QualifiedName, qualified_name_from_dotted_string, qualified_name_from_string_segments, qualified_name_init, qualified_name_last_segment }

// THE NAMING OF A std.primitives CONTRACT DECLARATION, ONCE. A PrimitiveContract row is declared at
// std.primitives.<name>_contract and carries `name: "<name>"`; a call head names the primitive by that `name`.
// Two consumers need the head-to-declaration step: v2.compiler.primitive_authority finds the row for resolve, and
// v2.std.compilers.target_model keys a target's primitive-realization row by the same declaration. Neither may
// re-spell the rule (DESIGN 3), and target_model cannot import primitive_authority (it reaches extdeps.languages.dag,
// which imports target_model), so the rule lives here, below both.
fn primitive_contract_module_path() -> String {
  "std.primitives"
}

fn primitive_contract_declaration_name(head: Symbol) -> String {
  concat(symbol_lexeme(sym: head), "_contract", "")
}

fn primitive_contract_declaration_ref(head: Symbol) -> DeclarationRef {
  decl_ref(
    module_path: primitive_contract_module_path(),
    decl_name: primitive_contract_declaration_name(head: head)
  )
}

// THE CONTRACT DECLARATION'S QUALIFIED PATH, ONCE: resolve binds a primitive head to it and emission recognizes a
// resolved callee by structural equality with it, so neither re-spells the join of module and declaration name.
fn primitive_contract_qualified_name(head: Symbol) -> QualifiedName {
  qualified_name_from_dotted_string(
    dotted: concat(
      primitive_contract_module_path(),
      ".",
      primitive_contract_declaration_name(head: head)
    )
  )
}

// THE INVERSE, STRUCTURALLY: the declaration leaf (`<name>_contract`) of a path that is a std.primitives declaration,
// absent for every other path. It reads the path's segments, never strips a spelling, so a resolved callee is recognized
// as a primitive from the path resolve bound it to (review 82831: comparing the leaf to the contract path of the leaf
// built `<name>_contract_contract` and never matched).
fn primitive_contract_leaf_of_path(path: QualifiedName) -> Optional<Symbol> {
  match qualified_name_last_segment(qn: path) {
    Absent => optional_absent()
    Present { value: leaf } =>
      if qualified_name_init(qn: path) == qualified_name_from_string_segments(segments: ["std", "primitives"]) {
        optional_present(value: leaf)
      } else {
        optional_absent()
      }
  }
}

fn primitive_contract_declaration_ref_of_leaf(leaf: Symbol) -> DeclarationRef {
  decl_ref(module_path: primitive_contract_module_path(), decl_name: symbol_lexeme(sym: leaf))
}
