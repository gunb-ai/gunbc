module v2.std.list_introduction

import std.types { List }
import std.algebra { Empty, list_snoc_item }
import v2.std.algebra { skip }
import v2.std.collection { Absent, Present, list_at_optional }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.node { ComputationNode, Edge, Node, Positional, Transform, all_edges_positional, node_with_occurrence_id }
import v2.std.node_query { node_positional_child_targets }
import v2.std.optional { Optional, optional_absent, optional_present }
import v2.std.qualified_name { QualifiedName, declaration_reference_path_optional, qualified_name_from_node, qualified_name_spine_node, qualified_name_spine_shape_present }

// THE LIST-LITERAL INTRODUCTION, ONE AUTHORITY FOR BOTH DIRECTIONS. A list literal `[e1, .., en]`
// is ONE Transform whose head is the reference to the declaration of the free monoid, std.algebra
// FreeMonoid, and whose remaining positional children are the elements in order; `[]` is the head
// alone (the flat introduction std.literal_elaboration UnicodeScalarSequenceUnfold names). The head
// path, the constructor and the reader live here together so the producer
// (v2.compiler.body_lowering_fold body_lower_list_literal) and the consumer
// (v2.compiler.infer infer_transform_freemonoid_introduction) cannot disagree about which
// declaration heads a list: a second spelling of the path would let one side move while the other
// silently stopped recognising the form (review 70960).
fn list_introduction_head_path() -> QualifiedName {
  [^std, ^algebra, ^FreeMonoid]
}

fn lower_list_introduction(elements: List<Node>, source: Node) -> Node {
  node_with_occurrence_id(
    kind: ComputationNode { behavior: Transform },
    children: fold(
      elements,
      init: [
        Edge {
          label: Positional,
          target: qualified_name_spine_node(qn: list_introduction_head_path(), occurrence_id: source.occurrence_id)
        }
      ],
      f: fn(acc, element) { list_snoc_item(xs: acc, item: Edge { label: Positional, target: element }) }
    ),
    occurrence_id: source.occurrence_id
  )
}

// The elements of a list introduction, in order; Absent for any node that is not one. Every edge
// must be positional and the first target must read back as the head path.
// The head's path in EITHER form it takes: the marked declaration reference resolve mints, or the
// bare qualified-name spine body lowering writes before resolution (lower_list_introduction). Both
// are read, because the call reader (application_read) runs over lowered bodies as well as resolved
// ones. Reading a bare spine as a path is safe HERE only because the answer is compared for EXACT
// equality with the FreeMonoid path: a cons list that merely shares the spine shape -- an integer
// literal's digits (gunbc.recurring_failure_mode declaration_reference_recognised_by_a_shape_a_literal_also_has)
// -- cannot equal it.
fn list_introduction_head_path_optional(head: Node) -> Optional<QualifiedName> {
  match declaration_reference_path_optional(node: head) {
    Present { value: path } => optional_present(value: path)
    Absent =>
      if qualified_name_spine_shape_present(root: head) {
        match qualified_name_from_node(root: head) {
          Accepted { value: qn, diagnostics: _ } => optional_present(value: qn)
          Rejected { diagnostics: _ } => optional_absent()
        }
      } else {
        optional_absent()
      }
  }
}

fn list_introduction_elements_optional(node: Node) -> Optional<List<Node>> {
  match node.kind {
    ComputationNode { behavior: Transform } =>
      if all_edges_positional(children: node.children) {
        let targets = node_positional_child_targets(node: node)
        match list_at_optional(xs: targets, index: 0) {
          Absent => optional_absent()
          Present { value: head } =>
            match list_introduction_head_path_optional(head: head) {
              Present { value: path } =>
                if path == list_introduction_head_path() {
                  optional_present(value: skip(xs: targets, n: 1))
                } else {
                  optional_absent()
                }
              Absent => optional_absent()
            }
        }
      } else {
        optional_absent()
      }
    TypeNode { connective: _ } => optional_absent()
    ComputationNode { behavior: Value } => optional_absent()
    ComputationNode { behavior: Branch } => optional_absent()
    ComputationNode { behavior: Loop } => optional_absent()
    ComputationNode { behavior: Bind } => optional_absent()
    ComputationNode { behavior: Match } => optional_absent()
  }
}
