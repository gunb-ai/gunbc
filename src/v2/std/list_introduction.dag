module v2.std.list_introduction

import std.types { List }
import std.algebra { Empty, list_snoc_item, skip, list_at_optional }

import v2.std.node { positional_child_target_nodes, ComputationNode, Edge, Node, Positional, Transform, Value, Branch, Loop, Bind, Match, all_edges_positional, node_with_occurrence_id, NotADeclaration }
import std.occurrence_identity { NodeOccurrenceIdentity }
import std.optional { Optional, optional_absent, optional_present, Absent, Present }
import v2.std.qualified_name { QualifiedName, declaration_reference_node, declaration_reference_path_optional }

// THE LIST-LITERAL INTRODUCTION, ONE AUTHORITY FOR BOTH DIRECTIONS. A list literal `[e1, .., en]`
// is ONE Transform whose head is the reference to the declaration of the free monoid, std.algebra
// FreeMonoid, and whose remaining positional children are the elements in order; `[]` is the head
// alone (the flat introduction std.literal_elaboration UnicodeScalarSequenceUnfold names). The head
// path, the constructor and the reader live here together so the producer
// (v2.compiler.body_lowering_fold body_lower_list_literal) and the consumer
// (v2.compiler.infer infer_transform_freemonoid_introduction) cannot disagree about which
// declaration heads a list: a second spelling of the path would let one side move while the other
// silently stopped recognising the form (review 70960).
//
// THE HEAD IS A COMPILER-GENERATED REFERENCE AND CARRIES ITS DECLARATION'S IDENTITY FROM CONSTRUCTION
// (operator ruling 2026-10-15, v2-namespace-cutover N2). Lowering writes the marked declaration
// reference (v2.std.qualified_name declaration_reference_node), not a qualified-name spine, so the
// head never passes through source visibility, an authored import, or the spelling of the path: resolve
// answers it by declaring path (v2.compiler.resolve resolve_generated_declaration_reference). The
// occurrence on the marker is the list expression's own, as the map introduction's head carries its
// source's (v2.std.map_introduction).
fn list_introduction_head_path() -> QualifiedName {
  [^std, ^algebra, ^FreeMonoid]
}

fn lower_list_introduction(elements: List<Node>, source: Node) -> Node {
  lower_list_introduction_at(elements: elements, occurrence_id: source.occurrence_id)
}

// The introduction at an occurrence rather than a source node, for a producer that has no source
// expression to take one from (v2.compiler.namespace_graft's reconstructed declaration forest).
fn lower_list_introduction_at(elements: List<Node>, occurrence_id: NodeOccurrenceIdentity) -> Node {
  node_with_occurrence_id(
    kind: ComputationNode { behavior: Transform },
    children: fold(
      elements,
      init: [
        Edge {
          label: Positional,
          target: declaration_reference_node(qn: list_introduction_head_path(), occurrence_id: occurrence_id),
          declaration: NotADeclaration
        }
      ],
      f: fn(acc, element) { list_snoc_item(xs: acc, item: Edge { label: Positional, target: element, declaration: NotADeclaration }) }
    ),
    occurrence_id: occurrence_id
  )
}

// The elements of a list introduction, in order; Absent for any node that is not one. Every edge
// must be positional and the first target must be the marked declaration reference to the head path.
// A bare qualified-name spine that spells std.algebra.FreeMonoid is NOT a list head: no producer writes
// one, and reading it as one would be the fallback from identity to spelling the cutover forbids.
fn list_introduction_elements_optional(node: Node) -> Optional<List<Node>> {
  match node.kind {
    ComputationNode { behavior: Transform } =>
      if all_edges_positional(children: node.children) {
        let targets = positional_child_target_nodes(node: node)
        match list_at_optional(xs: targets, index: 0) {
          Absent => optional_absent()
          Present { value: head } =>
            match declaration_reference_path_optional(node: head) {
              Present { value: path } =>
                if path == list_introduction_head_path() {
                  optional_present(value: skip(xs: targets, n: 1))
                } else {
                  optional_absent()
                }
              Absent => optional_absent()
            }
        }
      } else {
        optional_absent()
      }
    TypeNode { connective: _ } => optional_absent()
    ComputationNode { behavior: Value } => optional_absent()
    ComputationNode { behavior: Branch } => optional_absent()
    ComputationNode { behavior: Loop } => optional_absent()
    ComputationNode { behavior: Bind } => optional_absent()
    ComputationNode { behavior: Match } => optional_absent()
  }
}
