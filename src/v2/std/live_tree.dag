module v2.std.live_tree

import v2.std.collection { List }

data live_tree_disposition_note: String = "Declared witness input-domain disposition (ROADMAP 2-host-scaffold-classifier-defork): a witness entry declares whether its evaluation reads the live host tree (filesystem/corpus state outside its resolved substrate closure). The single authority is a `data live_tree_disposition: LiveTreeDisposition = ...` row in the WITNESS ENTRY FILE itself - entry grain, so the fact holds no matter where the read hides behind imports. Undeclared = ReadsLiveTree (fail-closed): a row must declare SubstrateInputsOnly to become affected-set selection-eligible. A row that declares SubstrateInputsOnly while actually reading live state is NOT re-checked by any text scan; the nightly affected-set falsifier (predict-only cold run) is the enforcement - a lying row surfaces as a counted divergence within one cadence window. This dissolves the interim floor:host_scaffold marker and the Rust text classifier witness_test_fn_uses_live_host_scan (deleted with this model)."

data live_tree_disposition_stamp_provenance: String = "Migration stamp provenance (2026-07-11, machine-stamped batch): the initial corpus-wide SubstrateInputsOnly rows were stamped from the deleted entry-text classifier's verdict (entry file contains none of: floor:host_scaffold, layer_import_facts, _live(, _facts_live(, filesystem_read) - ENTRY-TEXT GRAIN, so they inherit that classifier's declared blind spot: a live read hidden behind an import was invisible to it (the former cli_run.rs cross-file deficit). A stamped row is therefore machine-vouched, not author-vouched. Enforcement is the nightly affected-set falsifier (counted divergence within one cadence window). Dissolves-at: G2 call-reachability live-read classification (import-closure walk over LiveReadCarrier registry + fn-arrow DependencyView) per docs/plans/live-read-witness-classification-design.md — when stamps can be re-derived from proven runtime-read closure."

data live_read_classification_authority_note: String = "G1 module-closure live-read classification (docs/plans/live-read-witness-classification-design.md P0): carrier homes are declared rows; v2.lens.live_read_classification walks import closure to detect runtime tree/host reads hidden behind carrier imports. Subsumes witness_cost_locality.ambient_read_carrier_modules_v0 at steady state; until G2 lands this is the structural over-approximation (module grain — a types-only carrier import over-flags, fail-closed default)."

type LiveTreeDisposition
  = ReadsLiveTree
  | SubstrateInputsOnly

type LiveReadCarrierKind
  = FilesystemReadCarrier
  | ModuleDeclarationFactsCarrier
  | DeclFactsReflectionCarrier

type LiveReadCarrierHome {
  module: String
  kind: LiveReadCarrierKind
}

type LiveReadClassification
  = LocalRead
  | RuntimeRead {
      carrier_homes: List<LiveReadCarrierHome>
    }

data live_read_carrier_homes_v0: List<LiveReadCarrierHome> = [
  LiveReadCarrierHome { module: "v2.lens.enforcement.cost_coverage", kind: FilesystemReadCarrier },
  LiveReadCarrierHome { module: "v2.lens.enforcement.grammar_coverage", kind: FilesystemReadCarrier },
  LiveReadCarrierHome { module: "v2.lens.complexity_accumulator_copy.roster_gate", kind: FilesystemReadCarrier },
  LiveReadCarrierHome { module: "v2.compiler.self_host", kind: FilesystemReadCarrier },
  LiveReadCarrierHome { module: "v2.std.decl_index", kind: DeclFactsReflectionCarrier },
  LiveReadCarrierHome { module: "v2.lens.module_graph", kind: ModuleDeclarationFactsCarrier },
  LiveReadCarrierHome { module: "tools.dag_compile_clean_shard_roster", kind: ModuleDeclarationFactsCarrier },
  LiveReadCarrierHome { module: "tools.dag_compile_clean_scope", kind: ModuleDeclarationFactsCarrier }
]
