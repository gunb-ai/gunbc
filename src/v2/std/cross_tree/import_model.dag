module v2.std.cross_tree.import_model

import v2.std.algebra { FreeMonoid, contains, fold_list }
import v2.std.layer { LayerPrefix, layer_prefix_ordinal }
import v2.std.logic { Bool }
import v2.std.text { String }

type SourceRootRef
  = V2Tree
  | DagTree

type SourceRootSet = FreeMonoid<SourceRootRef>

type CrossTreeImport {
  from_tree: SourceRootRef
  from_layer: LayerPrefix
  from_module: String
  to_tree: SourceRootRef
  to_layer: LayerPrefix
  to_module: String
}

type ImportClosure = FreeMonoid<CrossTreeImport>

type TreeFundamentalityOrder
  = MoreFundamental
  | LessFundamental
  | CoFundamental
  | FundamentalityUnknown

type CrossTreeDenialReason
  = CrossTreeFromTreeNotInRootSet
  | CrossTreeToTreeNotInRootSet
  | CrossTreeFundamentalityUnknownFailClosed
  | CrossTreeToTreeLessFundamental
  | CrossTreeLayerDirectionViolated

type CrossTreeAdmissionVerdict
  = CrossTreeAdmitted
  | CrossTreeDenied { reason: CrossTreeDenialReason }

fn source_root_ref_eq(a: SourceRootRef, b: SourceRootRef) -> Bool {
  match a {
    V2Tree => match b { V2Tree => true, DagTree => false }
    DagTree => match b { V2Tree => false, DagTree => true }
  }
}

fn source_root_set_contains(roots: SourceRootSet, r: SourceRootRef) -> Bool {
  contains(xs: roots, item: r, eq: source_root_ref_eq)
}

fn cross_tree_layer_direction_holds(edge: CrossTreeImport) -> Bool {
  layer_prefix_ordinal(l: edge.to_layer) <= layer_prefix_ordinal(l: edge.from_layer)
}

fn cross_tree_directional_admit(edge: CrossTreeImport) -> CrossTreeAdmissionVerdict {
  if cross_tree_layer_direction_holds(edge: edge) {
    CrossTreeAdmitted
  } else {
    CrossTreeDenied { reason: CrossTreeLayerDirectionViolated }
  }
}

fn cross_tree_import_admitted(
  edge: CrossTreeImport,
  roots: SourceRootSet,
  order: TreeFundamentalityOrder
) -> CrossTreeAdmissionVerdict {
  if !source_root_set_contains(roots: roots, r: edge.from_tree) {
    CrossTreeDenied { reason: CrossTreeFromTreeNotInRootSet }
  } else if !source_root_set_contains(roots: roots, r: edge.to_tree) {
    CrossTreeDenied { reason: CrossTreeToTreeNotInRootSet }
  } else {
    match order {
      FundamentalityUnknown =>
        CrossTreeDenied { reason: CrossTreeFundamentalityUnknownFailClosed }
      LessFundamental =>
        CrossTreeDenied { reason: CrossTreeToTreeLessFundamental }
      MoreFundamental =>
        cross_tree_directional_admit(edge: edge)
      CoFundamental =>
        cross_tree_directional_admit(edge: edge)
    }
  }
}

fn cross_tree_import_closure_admitted(
  closure: ImportClosure,
  roots: SourceRootSet,
  order: TreeFundamentalityOrder
) -> CrossTreeAdmissionVerdict {
  fold_list(
    xs: closure,
    empty: CrossTreeAdmitted,
    cons: fn(verdict, edge) {
      match verdict {
        CrossTreeDenied { reason: r } => CrossTreeDenied { reason: r }
        CrossTreeAdmitted =>
          cross_tree_import_admitted(edge: edge, roots: roots, order: order)
      }
    }
  )
}
