module v2.std.cross_tree.import_model

import std.algebra { FreeMonoid, contains, fold_list, map_contains_key }
import std.types { Map }
import v2.std.text { String }

type SourceRootRef
  = V2Tree
  | DagTree

type SourceRootSet = FreeMonoid<SourceRootRef>

// One import edge across the trees, named by the namespaces at its two ends: the rank is a namespace's
// (see cross_tree_import_admitted), so the namespace is what the edge carries.
type CrossTreeImport {
  from_tree: SourceRootRef
  from_namespace: String
  to_tree: SourceRootRef
  to_namespace: String
}

type ImportClosure = FreeMonoid<CrossTreeImport>

type CrossTreeDenialReason
  = CrossTreeFromTreeNotInRootSet
  | CrossTreeToTreeNotInRootSet
  | CrossTreeFundamentalityUnknownFailClosed

type CrossTreeAdmissionVerdict
  = CrossTreeAdmitted
  | CrossTreeDenied { reason: CrossTreeDenialReason }

fn source_root_ref_eq(a: SourceRootRef, b: SourceRootRef) -> Bool {
  match a {
    V2Tree => match b { V2Tree => true, DagTree => false }
    DagTree => match b { V2Tree => false, DagTree => true }
  }
}

fn source_root_set_contains(roots: SourceRootSet, r: SourceRootRef) -> Bool {
  contains(xs: roots, item: r, eq: source_root_ref_eq)
}

// THE ACTIVE-ROOT DENIALS: an edge from or to a tree the compile did not activate refuses, whichever
// namespaces it joins. This is the whole verdict wherever a module is already in hand (v2.compiler.name_resolve
// admit_import_cross_tree_gate, through v2.std.cross_tree.resolution cross_tree_edge_decision): reaching a
// module at all went through the storage lookup, which asked the rank below.
fn cross_tree_roots_admitted(
  from_tree: SourceRootRef,
  to_tree: SourceRootRef,
  roots: SourceRootSet
) -> CrossTreeAdmissionVerdict {
  if !source_root_set_contains(roots: roots, r: from_tree) {
    CrossTreeDenied { reason: CrossTreeFromTreeNotInRootSet }
  } else if !source_root_set_contains(roots: roots, r: to_tree) {
    CrossTreeDenied { reason: CrossTreeToTreeNotInRootSet }
  } else {
    CrossTreeAdmitted
  }
}

// THE RANK OF A NAMESPACE IS ITS ROW in gunbc.source_layout_namespaces, and there is no direction rule
// (ruling by sleek-owl-397, 2026-10-25, through tidy-ant-251). No cited ruling orders one declared
// namespace below another, and the import graph's only structural law is acyclicity (DESIGN section 3),
// so a crossing between two declared namespaces is admitted whichever way it points. A namespace with
// no row has no rank: the crossing refuses fail-closed as FundamentalityUnknown, and there is no default
// rank. The admission IS this membership check; an order type with one admitting member would be a
// carrier with nothing to say. The declared set is policy and arrives as a value; this model imports no
// repository fact. An edge within one tree is not a crossing and asks no rank. Its one enforcement site
// is the storage lookup (v2.compiler.source_authority storage_cross_tree_verdict), per DESIGN section 3.
fn cross_tree_import_admitted(
  edge: CrossTreeImport,
  roots: SourceRootSet,
  declared: Map<String, Bool>
) -> CrossTreeAdmissionVerdict {
  match cross_tree_roots_admitted(from_tree: edge.from_tree, to_tree: edge.to_tree, roots: roots) {
    CrossTreeDenied { reason: reason } => CrossTreeDenied { reason: reason }
    CrossTreeAdmitted =>
      if source_root_ref_eq(a: edge.from_tree, b: edge.to_tree) {
        CrossTreeAdmitted
      } else if map_contains_key(m: declared, key: edge.from_namespace) && map_contains_key(m: declared, key: edge.to_namespace) {
        CrossTreeAdmitted
      } else {
        CrossTreeDenied { reason: CrossTreeFundamentalityUnknownFailClosed }
      }
  }
}

fn cross_tree_import_closure_admitted(
  closure: ImportClosure,
  roots: SourceRootSet,
  declared: Map<String, Bool>
) -> CrossTreeAdmissionVerdict {
  fold_list(
    xs: closure,
    empty: CrossTreeAdmitted,
    cons: fn(verdict, edge) {
      match verdict {
        CrossTreeDenied { reason: r } => CrossTreeDenied { reason: r }
        CrossTreeAdmitted =>
          cross_tree_import_admitted(edge: edge, roots: roots, declared: declared)
      }
    }
  )
}
