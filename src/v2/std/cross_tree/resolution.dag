module v2.std.cross_tree.resolution
import v2.std.qualified_name { QualifiedName }
import v2.std.cross_tree.import_model { CrossTreeAdmitted, CrossTreeDenied, SourceRootRef, SourceRootSet, cross_tree_roots_admitted, source_root_ref_eq, source_root_set_contains }
import std.algebra { Cons, Empty, FreeMonoid, empty_map, map_insert, map_lookup }
import std.types { Map }
import std.optional { Absent, Present }

// WHICH SOURCE TREE EACH MODULE WAS READ FROM, KEYED BY MODULE. Every import's cross-tree gate asks
// it twice (the importer and the target), once per import of every module, so it is one map read per
// question; a list folded per question made the gate modules x imports x modules over a whole tree.
// A module bound to two DIFFERENT trees is ambiguous and stays so; binding it again to the same tree
// changes nothing. That judgment is made once, at insert, so lookup only reads it.
type SourceRootIndex {
  by_module: Map<QualifiedName, SourceRootLookup>
}

fn source_root_index_empty() -> SourceRootIndex {
  SourceRootIndex { by_module: empty_map() }
}

fn source_root_index_insert(
  index: SourceRootIndex,
  module: QualifiedName,
  root: SourceRootRef
) -> SourceRootIndex {
  SourceRootIndex {
    by_module: map_insert(
      m: index.by_module,
      key: module,
      value: match map_lookup(m: index.by_module, key: module) {
        Absent => SourceRootResolved { root: root }
        Present { value: SourceRootResolved { root: prev } } =>
          if source_root_ref_eq(a: prev, b: root) {
            SourceRootResolved { root: prev }
          } else {
            SourceRootAmbiguous
          }
        Present { value: SourceRootAmbiguous } => SourceRootAmbiguous
        Present { value: SourceRootAbsent } => SourceRootResolved { root: root }
      }
    )
  }
}

type SourceRootLookup
  = SourceRootResolved { root: SourceRootRef }
  | SourceRootAbsent
  | SourceRootAmbiguous

fn source_root_index_lookup(
  index: SourceRootIndex,
  module: QualifiedName
) -> SourceRootLookup {
  match map_lookup(m: index.by_module, key: module) {
    Present { value: found } => found
    Absent => SourceRootAbsent
  }
}

fn source_root_set_insert(
  roots: FreeMonoid<SourceRootRef>,
  r: SourceRootRef
) -> FreeMonoid<SourceRootRef> {
  if source_root_set_contains(roots: roots, r: r) {
    roots
  } else {
    Cons { head: r, tail: roots }
  }
}

// THE NAME-RESOLVE GATE OVER AN EDGE BETWEEN TWO MODULES ALREADY READ. It reads no namespace membership: that
// has one enforcement site, the storage lookup, which decides it before the read
// (v2.compiler.source_authority storage_cross_tree_verdict; DESIGN section 3). What stays here is what only
// the ingest knows: whether both trees are active roots, and whether a module was read from two trees.
type CrossTreeEdgeDecision
  = EdgeNormalResolution
  | EdgeCrossAdmitted
  | EdgeCrossDenied
  | EdgeCrossAmbiguous

fn cross_tree_edge_decision(
  index: SourceRootIndex,
  from_qn: QualifiedName,
  to_qn: QualifiedName,
  active_roots: SourceRootSet
) -> CrossTreeEdgeDecision {
  match source_root_index_lookup(index: index, module: from_qn) {
    SourceRootAbsent => EdgeNormalResolution
    SourceRootAmbiguous => EdgeCrossAmbiguous
    SourceRootResolved { root: from_tree } =>
      match source_root_index_lookup(index: index, module: to_qn) {
        SourceRootAbsent => EdgeNormalResolution
        SourceRootAmbiguous => EdgeCrossAmbiguous
        SourceRootResolved { root: to_tree } =>
          if source_root_ref_eq(a: from_tree, b: to_tree) {
            EdgeNormalResolution
          } else {
            match cross_tree_roots_admitted(from_tree: from_tree, to_tree: to_tree, roots: active_roots) {
              CrossTreeAdmitted => EdgeCrossAdmitted
              CrossTreeDenied { reason: _ } => EdgeCrossDenied
            }
          }
      }
  }
}
