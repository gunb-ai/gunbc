module v2.std.cross_tree.resolution

import v2.std.algebra { Cons, Empty, FreeMonoid, fold_list }
import v2.std.cross_tree.import_model {
  CoFundamental,
  CrossTreeAdmitted,
  CrossTreeDenied,
  CrossTreeImport,
  DagTree,
  LessFundamental,
  MoreFundamental,
  SourceRootRef,
  SourceRootSet,
  TreeFundamentalityOrder,
  V2Tree,
  cross_tree_import_admitted,
  source_root_ref_eq,
  source_root_set_contains
}
import v2.std.layer {
  LayerPrefix,
  LayerPrefixCompiler,
  LayerPrefixExtdeps,
  LayerPrefixStd,
  LayerPrefixWorkflow
}
import v2.std.logic { Bool }
import v2.std.qualified_name {
  QualifiedName,
  QnCons,
  QnEmpty,
  qualified_name_eq,
  qualified_name_from_dotted_string
}
import v2.std.text { String }

type SourceRootBinding {
  module: QualifiedName
  root: SourceRootRef
}

type SourceRootIndex = FreeMonoid<SourceRootBinding>

fn source_root_index_empty() -> SourceRootIndex {
  Empty
}

fn source_root_index_insert(
  index: SourceRootIndex,
  module: QualifiedName,
  root: SourceRootRef
) -> SourceRootIndex {
  Cons { head: SourceRootBinding { module: module, root: root }, tail: index }
}

type SourceRootLookup
  = SourceRootResolved { root: SourceRootRef }
  | SourceRootAbsent
  | SourceRootAmbiguous

fn source_root_index_lookup(
  index: SourceRootIndex,
  module: QualifiedName
) -> SourceRootLookup {
  fold_list(
    xs: index,
    empty: SourceRootAbsent,
    cons: fn(acc, binding) {
      if qualified_name_eq(a: binding.module, b: module) {
        match acc {
          SourceRootAbsent => SourceRootResolved { root: binding.root }
          SourceRootResolved { root: prev } =>
            if source_root_ref_eq(a: prev, b: binding.root) {
              SourceRootResolved { root: prev }
            } else {
              SourceRootAmbiguous
            }
          SourceRootAmbiguous => SourceRootAmbiguous
        }
      } else {
        acc
      }
    }
  )
}

fn tree_fundamentality_order(
  from_tree: SourceRootRef,
  to_tree: SourceRootRef
) -> TreeFundamentalityOrder {
  match from_tree {
    V2Tree =>
      match to_tree {
        V2Tree => CoFundamental
        DagTree => MoreFundamental
      }
    DagTree =>
      match to_tree {
        V2Tree => LessFundamental
        DagTree => CoFundamental
      }
  }
}

fn layer_prefix_from_dotted_qualified_name(qn: String) -> LayerPrefix {
  layer_prefix_from_qualified_name(
    qn: qualified_name_from_dotted_string(dotted: qn)
  )
}

fn layer_prefix_from_qualified_name(qn: QualifiedName) -> LayerPrefix {
  match qn {
    QnEmpty => LayerPrefixStd
    QnCons { head: h, tail: t } =>
      if h == ^v2 {
        match t {
          QnEmpty => LayerPrefixStd
          QnCons { head: h2, tail: _ } =>
            if h2 == ^std {
              LayerPrefixStd
            } else if h2 == ^extdeps {
              LayerPrefixExtdeps
            } else if h2 == ^compiler {
              LayerPrefixCompiler
            } else if h2 == ^workflow {
              LayerPrefixWorkflow
            } else if h2 == ^lens {
              LayerPrefixCompiler
            } else if h2 == ^test {
              LayerPrefixCompiler
            } else {
              LayerPrefixCompiler
            }
        }
      } else if h == ^extdeps {
        LayerPrefixExtdeps
      } else if h == ^std {
        LayerPrefixStd
      } else if h == ^compiler {
        LayerPrefixCompiler
      } else if h == ^lens {
        LayerPrefixCompiler
      } else if h == ^test {
        LayerPrefixCompiler
      } else if h == ^workflow {
        LayerPrefixWorkflow
      } else if h == ^gunbc {
        LayerPrefixWorkflow
      } else if h == ^tools {
        LayerPrefixWorkflow
      } else {
        LayerPrefixStd
      }
  }
}

fn source_root_set_insert(
  roots: FreeMonoid<SourceRootRef>,
  r: SourceRootRef
) -> FreeMonoid<SourceRootRef> {
  if source_root_set_contains(roots: roots, r: r) {
    roots
  } else {
    Cons { head: r, tail: roots }
  }
}

data cross_tree_module_path_interim: String = ""

type CrossTreeEdgeDecision
  = EdgeNormalResolution
  | EdgeCrossAdmitted
  | EdgeCrossDenied
  | EdgeCrossAmbiguous

fn cross_tree_edge_decision(
  index: SourceRootIndex,
  from_qn: QualifiedName,
  to_qn: QualifiedName,
  active_roots: SourceRootSet
) -> CrossTreeEdgeDecision {
  match source_root_index_lookup(index: index, module: from_qn) {
    SourceRootAbsent => EdgeNormalResolution
    SourceRootAmbiguous => EdgeCrossAmbiguous
    SourceRootResolved { root: from_tree } =>
      match source_root_index_lookup(index: index, module: to_qn) {
        SourceRootAbsent => EdgeNormalResolution
        SourceRootAmbiguous => EdgeCrossAmbiguous
        SourceRootResolved { root: to_tree } =>
          if source_root_ref_eq(a: from_tree, b: to_tree) {
            EdgeNormalResolution
          } else {
            match cross_tree_import_admitted(
              edge: CrossTreeImport {
                from_tree: from_tree,
                from_layer: layer_prefix_from_qualified_name(qn: from_qn),
                from_module: cross_tree_module_path_interim,
                to_tree: to_tree,
                to_layer: layer_prefix_from_qualified_name(qn: to_qn),
                to_module: cross_tree_module_path_interim
              },
              roots: active_roots,
              order: tree_fundamentality_order(from_tree: from_tree, to_tree: to_tree)
            ) {
              CrossTreeAdmitted => EdgeCrossAdmitted
              CrossTreeDenied { reason: _ } => EdgeCrossDenied
            }
          }
      }
  }
}
