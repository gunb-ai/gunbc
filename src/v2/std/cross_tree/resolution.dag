// src/v2/std/cross_tree/resolution.dag
//
// Route C Phase B — QualifiedName-grounded cross-tree resolution helpers.
// Bridges name_resolve admission to import_model without String module-path interim.
// Consumers: v2.compiler.name_resolve (namespace_for_subject cross-tree gate).

module v2.std.cross_tree.resolution

import v2.extdeps.languages.dag { qualified_name_from_module_node }
import v2.std.algebra { Cons, Empty, FreeMonoid, fold_list }
import v2.std.cross_tree.import_model {
  CrossTreeAdmitted,
  CrossTreeAdmissionVerdict,
  CrossTreeDenied,
  CrossTreeImport,
  DslTree,
  SourceRootRef,
  TreeFundamentalityOrder,
  V2Tree,
  cross_tree_import_admitted,
  source_root_ref_eq,
  source_root_set_contains
}
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.layer {
  LayerPrefix,
  LayerPrefixCompiler,
  LayerPrefixExtdeps,
  LayerPrefixStd,
  LayerPrefixWorkflow
}
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.qualified_name { QualifiedName, QnCons, QnEmpty }
import v2.std.text { String }


// ── Source-tree tagging from QualifiedName (§3 — no host path literals) ───────

// v2.* module paths live under src/v2/; all other declared module names are dsl-tree.
fn source_root_ref_from_qualified_name(qn: QualifiedName) -> SourceRootRef {
  match qn {
    QnEmpty => DslTree
    QnCons { head: h, tail: _ } =>
      if h == ^v2 {
        V2Tree
      } else {
        DslTree
      }
  }
}


// Layer tier from module QualifiedName — mirrors DESIGN.md §3 four-tier DAG.
fn layer_prefix_from_qualified_name(qn: QualifiedName) -> LayerPrefix {
  match qn {
    QnEmpty => LayerPrefixStd
    QnCons { head: h, tail: t } =>
      if h == ^v2 {
        match t {
          QnEmpty => LayerPrefixStd
          QnCons { head: h2, tail: _ } =>
            if h2 == ^std {
              LayerPrefixStd
            } else if h2 == ^extdeps {
              LayerPrefixExtdeps
            } else if h2 == ^compiler {
              LayerPrefixCompiler
            } else if h2 == ^workflow {
              LayerPrefixWorkflow
            } else if h2 == ^lens {
              LayerPrefixCompiler
            } else if h2 == ^test {
              LayerPrefixCompiler
            } else {
              LayerPrefixCompiler
            }
        }
      } else if h == ^extdeps {
        LayerPrefixExtdeps
      } else if h == ^gunbc {
        LayerPrefixWorkflow
      } else if h == ^tools {
        LayerPrefixWorkflow
      } else {
        LayerPrefixStd
      }
  }
}


fn source_root_set_insert(
  roots: FreeMonoid<SourceRootRef>,
  r: SourceRootRef
) -> FreeMonoid<SourceRootRef> {
  if source_root_set_contains(roots: roots, r: r) {
    roots
  } else {
    Cons { head: r, tail: roots }
  }
}


// Derive the active source-root set from the validated module-root pool.
fn source_root_set_from_module_roots(roots: FreeMonoid<Node>) -> FreeMonoid<SourceRootRef> {
  fold_list(
    xs: roots,
    empty: Empty,
    cons: fn(acc, root) {
      match qualified_name_from_module_node(root: root) {
        Accepted { value: qn, diagnostics: _ } =>
          source_root_set_insert(
            roots: acc,
            r: source_root_ref_from_qualified_name(qn: qn)
          )
        Rejected { diagnostics: _ } => acc
      }
    }
  )
}


// Interim empty module-path strings — CrossTreeImport admission ignores them;
// dissolve-on: bold-bee 3a.2 QualifiedName materialization replaces with QN render.
data cross_tree_module_path_interim: String = ""

// QualifiedName-grounded cross-tree admission (Phase B wiring surface).
fn cross_tree_import_admitted_qualified(
  from_qn: QualifiedName,
  to_qn: QualifiedName,
  roots: FreeMonoid<SourceRootRef>,
  order: TreeFundamentalityOrder
) -> CrossTreeAdmissionVerdict {
  cross_tree_import_admitted(
    edge: CrossTreeImport {
      from_tree: source_root_ref_from_qualified_name(qn: from_qn),
      from_layer: layer_prefix_from_qualified_name(qn: from_qn),
      from_module: cross_tree_module_path_interim,
      to_tree: source_root_ref_from_qualified_name(qn: to_qn),
      to_layer: layer_prefix_from_qualified_name(qn: to_qn),
      to_module: cross_tree_module_path_interim
    },
    roots: roots,
    order: order
  )
}


fn cross_tree_import_is_same_tree(from_qn: QualifiedName, to_qn: QualifiedName) -> Bool {
  source_root_ref_eq(
    a: source_root_ref_from_qualified_name(qn: from_qn),
    b: source_root_ref_from_qualified_name(qn: to_qn)
  )
}
