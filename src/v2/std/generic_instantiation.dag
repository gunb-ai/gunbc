module v2.std.generic_instantiation

import v2.std.collection {
  Absent,
  Map,
  Present,
  empty_map,
  map_get,
  map_insert
}
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Rejected,
  Unavailable,
  outcome_accepted,
  outcome_rejected,
  port_locus
}
import v2.std.node { Node, Symbol, content_hash }
import v2.std.text { String }

type GenericSubstitution = Map<String, Node>

data generic_substitution_bind_once_port: Symbol = generic_substitution_bind_once_port
data generic_substitution_bind_conflict: Symbol = generic_substitution_bind_conflict

fn empty_generic_substitution() -> GenericSubstitution {
  empty_map()
}

fn generic_substitution_bind_conflict_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^generic_substitution_bind_conflict,
    at: port_locus(port: ^generic_substitution_bind_once_port),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn generic_substitution_bind_once(
  subst: GenericSubstitution,
  name: String,
  concrete: Node,
) -> Outcome<GenericSubstitution> {
  match map_get(subst, name) {
    Accepted { value: Absent, diagnostics: _ } =>
      outcome_accepted(value: map_insert(subst, name, concrete))
    Accepted { value: Present { value: bound }, diagnostics: _ } =>
      if content_hash(n: bound) == content_hash(n: concrete) {
        outcome_accepted(value: subst)
      } else {
        outcome_rejected(d: generic_substitution_bind_conflict_diagnostic())
      }
    Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
  }
}
