module v2.std.projection

import v2.std.artifact { ArtifactKind }
import v2.std.node { Node, Symbol }

type ProjectionKind
  = TestClaimLens
  | BoundaryTestLens
  | TargetTestProjection
  | EmitProjection
  | DiagnosticProjection

type Projection {
  id: Symbol
  kind: ProjectionKind
  input: Node
  output_kind: ArtifactKind
}
