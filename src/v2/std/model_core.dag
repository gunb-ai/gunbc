// src/v2/std/model_core.dag
// Scope: Shared ModelCore substrate for LanguageModel and concrete runtime extdeps.
// Status: T-33 modeled.


module v2.std.model_core


import v2.std.collection { List, Map }
import v2.std.diagnostic {
  Diagnostic,
  Textual,
  Unavailable,
  UserInputBoundary,
  WholeFile
}
import v2.std.algebra {
  field_reciprocal_nonzero_precondition_node,
  field_reciprocal_operation,
  field_reciprocal_operation_node,
  fold_list
}
import v2.std.logic {
  BoolPrimitiveFacts,
  bool_boolean_algebra_node,
  bool_boolean_algebra_type_node,
  bool_encoding_fact_node,
  bool_node,
  bool_primitive_facts,
  bool_primitive_facts_node,
  bool_width_fact_node
}
import v2.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.witness { Holds, Violates, Witness }


// 🟢 terminal — closed model_core primitive fact-axis vocabulary.
// G.0 keys `PerLanguageFactBundleKey.fact_axis` here; target_model catalog axes widen in G.1.
type ModelCorePrimitiveFactAxis
  = ModelCoreFactAxisWidth {}
  | ModelCoreFactAxisSignedness {}
  | ModelCoreFactAxisRange {}
  | ModelCoreFactAxisEncoding {}
  | ModelCoreFactAxisSurfaceSpelling {}
  | ModelCoreFactAxisOverflowDisposition {}

// 🟡 predicate-dissolution interim — feature:model-core-primitive-fact-axis-role-classification — bound task: node://adhoc-248e4e6c-3da — dissolve-on-arrival: derive axis-role predicates from shared projection receipts and the closed fact-axis coproduct; forbidden: untracked parallel role-classifier predicates.
fn model_core_primitive_fact_axis_is_surface(axis: Symbol) -> Bool {
  axis == discriminant(v: ModelCoreFactAxisSurfaceSpelling {})
}

// 🟡 predicate-dissolution interim — feature:model-core-primitive-fact-axis-role-classification — bound task: node://adhoc-248e4e6c-3da — dissolve-on-arrival: derive axis-role predicates from shared projection receipts and the closed fact-axis coproduct; forbidden: untracked parallel role-classifier predicates.
fn model_core_primitive_fact_axis_is_core(axis: Symbol) -> Bool {
  (axis == discriminant(v: ModelCoreFactAxisEncoding {}))
    || (axis == discriminant(v: ModelCoreFactAxisWidth {}))
    || (axis == discriminant(v: ModelCoreFactAxisSignedness {}))
    || (axis == discriminant(v: ModelCoreFactAxisRange {}))
    || (axis == discriminant(v: ModelCoreFactAxisOverflowDisposition {}))
}


type PrimitiveFactBundle {
  substrate_carrier: Node
  spec_facts: Map<Symbol, Node>
}


data primitive_fact_axis_unbound_reason: Symbol = primitive_fact_axis_unbound_reason


fn primitive_fact_axis_unbound_diagnostic(axis: Symbol) -> Diagnostic {
  Diagnostic {
    reason: primitive_fact_axis_unbound_reason,
    at: Textual { file: axis, extent: WholeFile },
    correction: Unavailable { reason: UserInputBoundary }
  }
}


type AlgebraInhabitanceDecl {
  algebra: Node
  inhabitant: Node
  witness: Node
}


type AlgebraLawObligation {
  inhabitance_witness: Node
  law: Node
}


type ResourceAccess {
  resource: Node
}


type EffectSignature {
  signature: Node
}


type PrimitiveOperationRef {
  operation: Node
  effect_signature: EffectSignature
}


// 🟡 needs-more-work — feature:model-core-effect-semantics — scaffold:T-33-model-core · dissolve-on: T-33 (#3474) binds EffectSemanticsDecl.operations when first PrimitiveOperationRef carries non-trivial effect (bind gunbc#4764)
type EffectSemanticsDecl {
  operations: List<PrimitiveOperationRef>
}


type PartialOperationDecl {
  operation: Node
  precondition: Node
  discharge: PartialityDischarge
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type PartialityDischarge
  = FailClosedAtBoundary { reason: Symbol }
  | RefinementHonoring { validation: Node }


// 🟡 needs-more-work — feature:model-core-partiality-semantics — scaffold:T-33-model-core · dissolve-on: T-33 (#3474) populates PartialitySemanticsDecl.operations per operator partiality substrate (bind gunbc#4764)
type PartialitySemanticsDecl {
  operations: List<PartialOperationDecl>
}


fn field_partiality_decl() -> PartialitySemanticsDecl {
  PartialitySemanticsDecl {
    operations: [
      PartialOperationDecl {
        operation: field_reciprocal_operation_node(),
        precondition: field_reciprocal_nonzero_precondition_node(),
        discharge: FailClosedAtBoundary { reason: field_reciprocal_operation }
      }
    ]
  }
}


type ModelCore {
  primitives: List<PrimitiveFactBundle>
  inhabitance: List<AlgebraInhabitanceDecl>
  laws: List<AlgebraLawObligation>
  effects: EffectSemanticsDecl
  partiality: PartialitySemanticsDecl
}


// 🟡 needs-more-work — feature:model-core-law-expression-carrier — scaffold:T-33-wave2 · the law-kind symbols below are bounded schedule keys for BooleanAlgebra law obligations; the law Node also carries the structural algebra Node and inhabitance witness. dissolve-on: std/algebra exports typed law/equation Nodes for BooleanAlgebra laws, replacing these kind atoms with structural law expressions.
type ModelCoreWave1BoolLawKey
  = ModelCoreWave1BoolBoundedLatticeIdentities
  | ModelCoreWave1BoolDistributivity
  | ModelCoreWave1BoolComplementInvolution
  | ModelCoreWave1BoolComplementBounds
data model_core_wave1_law_field_subject: Symbol = model_core_wave1_law_field_subject
data model_core_wave1_law_field_algebra: Symbol = model_core_wave1_law_field_algebra
data model_core_wave1_law_field_kind: Symbol = model_core_wave1_law_field_kind


fn model_core_wave1_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}


fn model_core_wave1_bool_fact_lookup(facts: BoolPrimitiveFacts, axis: Symbol) -> Witness<Node> {
  if axis == discriminant(v: ModelCoreFactAxisWidth {}) {
    Holds { value: bool_width_fact_node(width: facts.width) }
  } else if axis == discriminant(v: ModelCoreFactAxisEncoding {}) {
    Holds { value: bool_encoding_fact_node(encoding: facts.encoding) }
  } else {
    Violates {
      diagnostic: primitive_fact_axis_unbound_diagnostic(axis: axis)
    }
  }
}


fn model_core_wave1_bool_spec_facts(facts: BoolPrimitiveFacts) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      model_core_wave1_bool_fact_lookup(facts: facts, axis: axis)
    }
  }
}


fn model_core_wave1_bool_primitive_bundle() -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: bool_primitive_facts_node(facts: bool_primitive_facts),
    spec_facts: model_core_wave1_bool_spec_facts(facts: bool_primitive_facts)
  }
}


fn model_core_wave1_bool_inhabitance_witness() -> Node {
  bool_boolean_algebra_node()
}


fn model_core_wave1_bool_algebra_node() -> Node {
  bool_boolean_algebra_type_node()
}


fn model_core_wave1_bool_inhabitance() -> AlgebraInhabitanceDecl {
  let witness = model_core_wave1_bool_inhabitance_witness()
  AlgebraInhabitanceDecl {
    algebra: model_core_wave1_bool_algebra_node(),
    inhabitant: bool_node(),
    witness: witness
  }
}


fn model_core_wave1_law_node(key: ModelCoreWave1BoolLawKey) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: model_core_wave1_law_field_subject },
        target: model_core_wave1_bool_inhabitance_witness()
      },
      Edge {
        label: Named { name: model_core_wave1_law_field_algebra },
        target: model_core_wave1_bool_algebra_node()
      },
      Edge {
        label: Named { name: model_core_wave1_law_field_kind },
        target: model_core_wave1_atom(id: discriminant(v: key))
      },
    ],
    occurrence_id: SyntheticOccurrence
}
}


fn model_core_wave1_bool_law_obligation(key: ModelCoreWave1BoolLawKey) -> AlgebraLawObligation {
  AlgebraLawObligation {
    inhabitance_witness: model_core_wave1_bool_inhabitance_witness(),
    law: model_core_wave1_law_node(key: key)
  }
}


fn wave1_model_core() -> ModelCore {
  ModelCore {
    primitives: [
      model_core_wave1_bool_primitive_bundle(),
    ],
    inhabitance: [
      model_core_wave1_bool_inhabitance(),
    ],
    laws: [
      model_core_wave1_bool_law_obligation(key: ModelCoreWave1BoolBoundedLatticeIdentities),
      model_core_wave1_bool_law_obligation(key: ModelCoreWave1BoolDistributivity),
      model_core_wave1_bool_law_obligation(key: ModelCoreWave1BoolComplementInvolution),
      model_core_wave1_bool_law_obligation(key: ModelCoreWave1BoolComplementBounds),
    ],
    effects: EffectSemanticsDecl { operations: [] },
    partiality: PartialitySemanticsDecl { operations: [] }
  }
}


fn wave1_void() -> ModelCore {
  wave1_model_core()
}


type PrimitiveBundleSubstrateHead
  = PrimitiveBundleSubstrateHeadMissing
  | PrimitiveBundleSubstrateHeadFound { substrate: Node }


fn model_core_empty_conj_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}


fn primitive_fact_bundle_substrate(bundle: PrimitiveFactBundle) -> Node {
  match bundle {
    PrimitiveFactBundle { substrate_carrier: substrate, spec_facts: _ } => substrate
  }
}


// 🟡 gated — feature:model-core-node-projection — consumer:v2.std.language_model.language_model_to_node —
// dissolve-on: ModelCore core edge projects primitives/inhabitance/laws/effects/partiality as named Conj facts;
// forbidden: lossy head-only primitive substrate projection without this gate (facts-flow-forward, DESIGN.md §3).
fn primitive_fact_bundle_list_head_substrate(bundles: List<PrimitiveFactBundle>) -> Node {
  match fold_list(
    xs: bundles,
    empty: PrimitiveBundleSubstrateHeadMissing,
    cons: fn(acc, bundle) {
      match acc {
        PrimitiveBundleSubstrateHeadFound { substrate: _ } => acc
        PrimitiveBundleSubstrateHeadMissing =>
          PrimitiveBundleSubstrateHeadFound {
            substrate: primitive_fact_bundle_substrate(bundle: bundle)
          }
      }
    }
  ) {
    PrimitiveBundleSubstrateHeadFound { substrate: node } => node
    PrimitiveBundleSubstrateHeadMissing => model_core_empty_conj_node()
  }
}


fn model_core_first_primitive_substrate(core: ModelCore) -> Node {
  primitive_fact_bundle_list_head_substrate(bundles: core.primitives)
}
