module v2.std.cardinality

import std.algebra { Cons, Empty }
import std.termination {
  DescentEvidence,
  Strict,
  NonIncreasing,
  DescentUnknown,
  descent_evidence_lattice_meet,
  evidence_rank
}
import v2.std.collection { Absent, List, Optional, Present }
import v2.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  node_locus,
  Unavailable
}
import v2.std.nat { Nat }
import v2.std.node {
  Arrow,
  Atom,
  Behavior,
  Bind,
  Branch,
  Cardinality,
  ComputationNode,
  Conj,
  Connective,
  Disj,
  Edge,
  Instantiation,
  Loop,
  Named,
  Node,
  NodeFold,
  Symbol,
  Transform,
  TypeNode,
  Value,
  fold_node,
  loop_behavior_edges_conform,
  loop_bound_measure_target,
  name_occurrences
}
import v2.std.witness { Holds, Violates, Witness }

type Never
type Unit
type NonZeroNat {
  prev: Nat
}

type NatLeWitness
  = LeqZero { upper: Nat }
  | LeqSucc { inner: NatLeWitness }
type UpperBoundedNat {
  le: NatLeWitness
}
type PositiveNatLeWitness
  = PositiveLeqSucc { inner: NatLeWitness }
type PositiveUpperBoundedNat {
  le: PositiveNatLeWitness
}
fn nat_le_witness_lower(w: NatLeWitness) -> Nat {
  match w {
    LeqZero { upper: _ } => Zero
    LeqSucc { inner } => Succ { prev: nat_le_witness_lower(w: inner) }
  }
}
fn nat_le_witness_upper(w: NatLeWitness) -> Nat {
  match w {
    LeqZero { upper } => upper
    LeqSucc { inner } => Succ { prev: nat_le_witness_upper(w: inner) }
  }
}
fn positive_nat_le_witness_lower(w: PositiveNatLeWitness) -> Nat {
  match w {
    PositiveLeqSucc { inner } => Succ { prev: nat_le_witness_lower(w: inner) }
  }
}
fn positive_nat_le_witness_upper(w: PositiveNatLeWitness) -> Nat {
  match w {
    PositiveLeqSucc { inner } => Succ { prev: nat_le_witness_upper(w: inner) }
  }
}
fn upper_bounded_nat_value(b: UpperBoundedNat) -> Nat {
  nat_le_witness_lower(w: b.le)
}
fn upper_bounded_nat_inclusive_max(b: UpperBoundedNat) -> Nat {
  nat_le_witness_upper(w: b.le)
}
fn positive_upper_bounded_nat_value(b: PositiveUpperBoundedNat) -> Nat {
  positive_nat_le_witness_lower(w: b.le)
}
fn positive_upper_bounded_nat_inclusive_max(b: PositiveUpperBoundedNat) -> Nat {
  positive_nat_le_witness_upper(w: b.le)
}
fn nat_le_witness_well_formed(w: NatLeWitness) -> Bool {
  match w {
    LeqZero { upper: _ } => true
    LeqSucc { inner } => nat_le_witness_well_formed(w: inner)
  }
}
fn upper_bounded_nat_well_formed(b: UpperBoundedNat) -> Bool {
  nat_le_witness_well_formed(w: b.le)
}
fn positive_nat_le_witness_well_formed(w: PositiveNatLeWitness) -> Bool {
  match w {
    PositiveLeqSucc { inner } => nat_le_witness_well_formed(w: inner)
  }
}
fn positive_upper_bounded_nat_well_formed(b: PositiveUpperBoundedNat) -> Bool {
  positive_nat_le_witness_well_formed(w: b.le)
}

type RankingDimension {
  measured: Symbol
}
type TerminationProof {
  non_increasing: List<RankingDimension>
  strict: RankingDimension
}

type LoopBound {
  measure: Node
  termination: Witness<TerminationProof>
}

fn loop_bound_measure(bound: LoopBound) -> Node {
  bound.measure
}

fn loop_bound_undeclared_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^cardinality_loop_bound_undeclared,
    at: node_locus(node: n),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn loop_bound_ambiguous_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^cardinality_loop_bound_ambiguous,
    at: node_locus(node: n),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn loop_bound_malformed_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^cardinality_loop_bound_malformed,
    at: node_locus(node: n),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn loop_bound_not_loop_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^cardinality_loop_bound_not_loop,
    at: node_locus(node: n),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn loop_measure_node(n: Node) -> Witness<Node> {
  match n.kind {
    ComputationNode { behavior: Loop } => {
      let bound_count = name_occurrences(name: ^loop_bound_edge, children: n.children)
      if bound_count == 0 {
        Violates { diagnostic: loop_bound_undeclared_diagnostic(n: n) }
      } else if bound_count > 1 {
        Violates { diagnostic: loop_bound_ambiguous_diagnostic(n: n) }
      } else if !loop_behavior_edges_conform(children: n.children) {
        Violates { diagnostic: loop_bound_malformed_diagnostic(n: n) }
      } else {
        match loop_bound_measure_target(children: n.children) {
          Found { target: measure } => Holds { value: measure }
          Ambiguous => Violates { diagnostic: loop_bound_ambiguous_diagnostic(n: n) }
          Absent => Violates { diagnostic: loop_bound_undeclared_diagnostic(n: n) }
        }
      }
    }
    _ => Violates { diagnostic: loop_bound_not_loop_diagnostic(n: n) }
  }
}

type Multiplicity
  = Bounded
  | RequiresTerminationProof
  | ProvenTermination { proof: TerminationProof }

fn structural_node_size_dimension() -> RankingDimension {
  RankingDimension { measured: ^cardinality_structural_node_size }
}

fn structural_node_size_termination_proof() -> TerminationProof {
  TerminationProof {
    non_increasing: [],
    strict: structural_node_size_dimension()
  }
}

fn multiplicity_termination_witness(n: Node, m: Multiplicity) -> Witness<TerminationProof> {
  match m {
    Bounded => Holds { value: structural_node_size_termination_proof() }
    RequiresTerminationProof =>
      Violates { diagnostic: cardinality_descent_not_proven_diagnostic(n: n) }
    ProvenTermination { proof } => Holds { value: proof }
  }
}

fn connective_multiplicity(c: Connective) -> Multiplicity {
  match c {
    Atom { identity: _ } => Bounded
    Conj => Bounded
    Disj => Bounded
    Arrow => Bounded
    Cardinality => RequiresTerminationProof
    Instantiation => Bounded
  }
}

fn behavior_multiplicity(b: Behavior) -> Multiplicity {
  match b {
    Value => Bounded
    Transform => Bounded
    Branch => Bounded
    Loop => RequiresTerminationProof
    Bind => Bounded
    Match => Bounded
  }
}

data measure_descent_registry_note: String = "Measure descent facts ground the loop termination derivation on the single DescentEvidence authority (std.termination — operator standing rule 2026-07-08: dag/std wins v2↔dag forks; body-lowering design Stage 2/T1). A measure Atom carries descent evidence only via a cited registry row; an unregistered symbol is DescentUnknown — the lattice bottom — so an unproven measure refuses, never fabricates. Copied-port facts use the same derive-not-hand-stamp discipline via v2.lens.cost.copied_port_derivation (Wave 1 Gate 1 C1)."

type MeasureDescentFact {
  measure: Symbol
  evidence: DescentEvidence
  citation: String
}

data measure_descent_fact_structural_node_size: MeasureDescentFact = {
  measure: ^cardinality_structural_node_size,
  evidence: Strict,
  citation: "v2.std.node.fold_node structural recursion: every child is a strict subtree of its parent — the dimension structural_node_size_termination_proof already names"
}

data measure_descent_fact_dag_loop_measure: MeasureDescentFact = {
  measure: ^dag_loop_measure_sym,
  evidence: Strict,
  citation: "loop-body producer's declared loop bound (v2.extdeps.languages.dag.dag_loop_measure_node); grounds the exact TerminationProof that loop_round_trip_test and loop_eval_by_execution_test previously hand-fabricated per test site"
}

data measure_descent_fact_fold_iteration: MeasureDescentFact = {
  measure: ^dag_surface_fold_iteration_measure,
  evidence: Strict,
  citation: "fold iteration over a finite collection descends by construction (std.termination DescentSource.FoldIteration: each step consumes one element of the folded list); the surface cost-shape lowering stamps this measure on every fold-family call it lowers to Loop (v2.extdeps.languages.dag)"
}

data measure_descent_fact_registry: List<MeasureDescentFact> = [
  measure_descent_fact_structural_node_size,
  measure_descent_fact_dag_loop_measure,
  measure_descent_fact_fold_iteration
]

fn measure_descent_some(e: DescentEvidence) -> Optional<DescentEvidence> {
  Present { value: e }
}

fn measure_descent_fact_for(registry: List<MeasureDescentFact>, s: Symbol) -> Optional<DescentEvidence> {
  fold(registry, init: Absent, f: fn(acc, row) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        if row.measure == s {
          measure_descent_some(e: row.evidence)
        } else {
          Absent
        }
    }
  })
}

fn measure_descent_evidence_for_symbol(registry: List<MeasureDescentFact>, s: Symbol) -> DescentEvidence {
  match measure_descent_fact_for(registry: registry, s: s) {
    Present { value: e } => e
    Absent => DescentUnknown
  }
}

type MeasureDimensionEvidence {
  dimension: RankingDimension
  evidence: DescentEvidence
}

fn measure_dimension_unknown_rows() -> List<MeasureDimensionEvidence> {
  [
    MeasureDimensionEvidence {
      dimension: RankingDimension { measured: ^cardinality_measure_shape_unknown },
      evidence: DescentUnknown
    }
  ]
}

fn measure_dimension_rows(registry: List<MeasureDescentFact>, measure: Node) -> List<MeasureDimensionEvidence> {
  match measure.kind {
    TypeNode { connective: c } =>
      match c {
        Atom { identity: s } =>
          [
            MeasureDimensionEvidence {
              dimension: RankingDimension { measured: s },
              evidence: measure_descent_evidence_for_symbol(registry: registry, s: s)
            }
          ]
        Conj =>
          fold(measure.children, init: Empty, f: fn(acc, e) {
            fold(measure_dimension_rows(registry: registry, measure: e.target), init: acc, f: fn(acc2, row) {
              Cons { head: row, tail: acc2 }
            })
          })
        Disj => measure_dimension_unknown_rows()
        Arrow => measure_dimension_unknown_rows()
        Cardinality => measure_dimension_unknown_rows()
        Instantiation => measure_dimension_unknown_rows()
      }
    ComputationNode { behavior: _ } => measure_dimension_unknown_rows()
  }
}

fn dimension_rows_meet(rows: List<MeasureDimensionEvidence>) -> DescentEvidence {
  fold(rows, init: Strict, f: fn(acc, row) {
    descent_evidence_lattice_meet(a: acc, b: row.evidence)
  })
}

fn dimension_row_is_strict(row: MeasureDimensionEvidence) -> Bool {
  evidence_rank(e: row.evidence) == evidence_rank(e: Strict)
}

fn ranking_dimension_some(d: RankingDimension) -> Optional<RankingDimension> {
  Present { value: d }
}

fn first_strict_dimension(rows: List<MeasureDimensionEvidence>) -> Optional<RankingDimension> {
  fold(rows, init: Absent, f: fn(acc, row) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        if dimension_row_is_strict(row: row) {
          ranking_dimension_some(d: row.dimension)
        } else {
          Absent
        }
    }
  })
}

type LexicographicSplit {
  strict_taken: Bool
  non_increasing: List<RankingDimension>
}

fn non_strict_dimensions_after_first(rows: List<MeasureDimensionEvidence>) -> List<RankingDimension> {
  let split = fold(rows, init: LexicographicSplit { strict_taken: false, non_increasing: Empty }, f: fn(acc, row) {
    if dimension_row_is_strict(row: row) && !acc.strict_taken {
      LexicographicSplit { strict_taken: true, non_increasing: acc.non_increasing }
    } else {
      LexicographicSplit {
        strict_taken: acc.strict_taken,
        non_increasing: Cons { head: row.dimension, tail: acc.non_increasing }
      }
    }
  })
  split.non_increasing
}

fn lexicographic_multiplicity(rows: List<MeasureDimensionEvidence>) -> Multiplicity {
  match first_strict_dimension(rows: rows) {
    Absent => RequiresTerminationProof
    Present { value: strict_dim } =>
      ProvenTermination {
        proof: TerminationProof {
          non_increasing: non_strict_dimensions_after_first(rows: rows),
          strict: strict_dim
        }
      }
  }
}

fn loop_multiplicity_from_rows(rows: List<MeasureDimensionEvidence>) -> Multiplicity {
  if count(rows) == 0 {
    RequiresTerminationProof
  } else {
    match dimension_rows_meet(rows: rows) {
      DescentUnknown => RequiresTerminationProof
      NonIncreasing => lexicographic_multiplicity(rows: rows)
      Strict => lexicographic_multiplicity(rows: rows)
    }
  }
}

fn loop_multiplicity_with(registry: List<MeasureDescentFact>, n: Node) -> Multiplicity {
  match loop_measure_node(n: n) {
    Violates { diagnostic: _ } => RequiresTerminationProof
    Holds { value: measure } =>
      loop_multiplicity_from_rows(rows: measure_dimension_rows(registry: registry, measure: measure))
  }
}

fn loop_multiplicity(n: Node) -> Multiplicity {
  loop_multiplicity_with(registry: measure_descent_fact_registry, n: n)
}

data loop_multiplicity_node_aware_note: String = "FLAG B (body-lowering design, operator-signed): Loop multiplicity is decided node-aware here while the other behaviors stay tag-only in behavior_multiplicity — a real distinction, not inconsistency: only Loop's termination depends on a node-level edge (the ^loop_bound_edge measure), which the Behavior tag structurally cannot carry. behavior_multiplicity(Loop) stays RequiresTerminationProof as the honest measure-less projection."

fn node_multiplicity(n: Node) -> Multiplicity {
  match n.kind {
    TypeNode { connective: c } => connective_multiplicity(c: c)
    ComputationNode { behavior: b } =>
      match b {
        Value => behavior_multiplicity(b: b)
        Transform => behavior_multiplicity(b: b)
        Branch => behavior_multiplicity(b: b)
        Loop => loop_multiplicity(n: n)
        Bind => behavior_multiplicity(b: b)
        Match => behavior_multiplicity(b: b)
      }
  }
}

fn cardinality_descent_not_proven_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^cardinality_descent_not_proven,
    at: node_locus(node: n),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn local_termination_proof_witness(n: Node) -> Witness<TerminationProof> {
  multiplicity_termination_witness(n: n, m: node_multiplicity(n: n))
}

fn termination_proof_fold_step(
  acc: Witness<TerminationProof>,
  _: Edge,
  child: Witness<TerminationProof>
) -> Witness<TerminationProof> {
  match acc {
    Violates { diagnostic: _ } => acc
    Holds { value: proof } =>
      match child {
        Violates { diagnostic: _ } => child
        Holds { value: _ } => Holds { value: proof }
      }
  }
}

fn termination_proof_witness_for_node(n: Node) -> Witness<TerminationProof> {
  fold_node(
    n: n,
    algebra: NodeFold {
      init: fn(n0) {
        local_termination_proof_witness(n: n0)
      },
      step: fn(acc, e, child) {
        termination_proof_fold_step(acc: acc, e: e, child: child)
      }
    }
  )
}

fn loop_bound_witness_for_node(n: Node) -> Witness<LoopBound> {
  match loop_measure_node(n: n) {
    Holds { value: measure } =>
      Holds {
        value: LoopBound {
          measure: measure,
          termination: termination_proof_witness_for_node(n: n)
        }
      }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}
