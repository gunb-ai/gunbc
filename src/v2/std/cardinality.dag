}
import v2.std.witness { Holds, Violates, Witness }

type Unit
type NonZeroNat {
  prev: Nat
}

type NatLeWitness
  = LeqZero { upper: Nat }
  | LeqSucc { inner: NatLeWitness }
type UpperBoundedNat {
  le: NatLeWitness
}
type PositiveNatLeWitness
  = PositiveLeqSucc { inner: NatLeWitness }
type PositiveUpperBoundedNat {
  le: PositiveNatLeWitness
}
fn nat_le_witness_lower(w: NatLeWitness) -> Nat {
  match w {
    LeqZero { upper: _ } => Zero
    LeqSucc { inner } => Succ { prev: nat_le_witness_lower(w: inner) }
  }
}
fn nat_le_witness_upper(w: NatLeWitness) -> Nat {
  match w {
    LeqZero { upper } => upper
    LeqSucc { inner } => Succ { prev: nat_le_witness_upper(w: inner) }
  }
}
fn positive_nat_le_witness_lower(w: PositiveNatLeWitness) -> Nat {
  match w {
    PositiveLeqSucc { inner } => Succ { prev: nat_le_witness_lower(w: inner) }
  }
}
fn positive_nat_le_witness_upper(w: PositiveNatLeWitness) -> Nat {
  match w {
    PositiveLeqSucc { inner } => Succ { prev: nat_le_witness_upper(w: inner) }
  }
}
fn upper_bounded_nat_value(b: UpperBoundedNat) -> Nat {
  nat_le_witness_lower(w: b.le)
}
fn upper_bounded_nat_inclusive_max(b: UpperBoundedNat) -> Nat {
  nat_le_witness_upper(w: b.le)
}
fn positive_upper_bounded_nat_value(b: PositiveUpperBoundedNat) -> Nat {
  positive_nat_le_witness_lower(w: b.le)
}
fn positive_upper_bounded_nat_inclusive_max(b: PositiveUpperBoundedNat) -> Nat {
  positive_nat_le_witness_upper(w: b.le)
}
fn nat_le_witness_well_formed(w: NatLeWitness) -> Bool {
  match w {
    LeqZero { upper: _ } => true
    LeqSucc { inner } => nat_le_witness_well_formed(w: inner)
  }
}
fn upper_bounded_nat_well_formed(b: UpperBoundedNat) -> Bool {
  nat_le_witness_well_formed(w: b.le)
}
fn positive_nat_le_witness_well_formed(w: PositiveNatLeWitness) -> Bool {
  match w {
    PositiveLeqSucc { inner } => nat_le_witness_well_formed(w: inner)
  }
}
fn positive_upper_bounded_nat_well_formed(b: PositiveUpperBoundedNat) -> Bool {
  positive_nat_le_witness_well_formed(w: b.le)
}

type RankingComponent {
  measured: Symbol
}
type TerminationProof {
  non_increasing: List<RankingComponent>
  strict: RankingComponent
}

type LoopBound {
  measure: Node
  termination: Witness<TerminationProof>
}

fn loop_bound_measure(bound: LoopBound) -> Node {
  bound.measure
}

fn loop_bound_undeclared_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^cardinality_loop_bound_undeclared,
    at: node_locus(node: n),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn loop_bound_ambiguous_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^cardinality_loop_bound_ambiguous,
    at: node_locus(node: n),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn loop_bound_malformed_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^cardinality_loop_bound_malformed,
    at: node_locus(node: n),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn loop_bound_not_loop_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^cardinality_loop_bound_not_loop,
    at: node_locus(node: n),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn loop_measure_node(n: Node) -> Witness<Node> {
  match n.kind {
    ComputationNode { behavior: Loop } => {
      let bound_count = core_occurrences(marker: LoopBoundEdge, children: n.children)
      if bound_count == 0 {
        Violates { diagnostic: loop_bound_undeclared_diagnostic(n: n) }
      } else if bound_count > 1 {
        Violates { diagnostic: loop_bound_ambiguous_diagnostic(n: n) }
      } else if !loop_behavior_edges_conform(children: n.children) {
        Violates { diagnostic: loop_bound_malformed_diagnostic(n: n) }
      } else {
        match loop_bound_measure_target(children: n.children) {
          Found { target: measure } => Holds { value: measure }
          Ambiguous => Violates { diagnostic: loop_bound_ambiguous_diagnostic(n: n) }
          NotFound => Violates { diagnostic: loop_bound_undeclared_diagnostic(n: n) }
        }
      }
    }
    ComputationNode { behavior: Value } => Violates { diagnostic: loop_bound_not_loop_diagnostic(n: n) }
    ComputationNode { behavior: Transform } => Violates { diagnostic: loop_bound_not_loop_diagnostic(n: n) }
    ComputationNode { behavior: Branch } => Violates { diagnostic: loop_bound_not_loop_diagnostic(n: n) }
    ComputationNode { behavior: Bind } => Violates { diagnostic: loop_bound_not_loop_diagnostic(n: n) }
    ComputationNode { behavior: Match } => Violates { diagnostic: loop_bound_not_loop_diagnostic(n: n) }
    TypeNode { connective: _ } => Violates { diagnostic: loop_bound_not_loop_diagnostic(n: n) }
  }
}

type Multiplicity
  = Bounded
  | RequiresTerminationProof
  | ProvenTermination { proof: TerminationProof }

fn structural_node_size_dimension() -> RankingComponent {
  RankingComponent { measured: ^cardinality_structural_node_size }
}

fn structural_node_size_termination_proof() -> TerminationProof {
  TerminationProof {
    non_increasing: [],
    strict: structural_node_size_dimension()
  }
}

fn multiplicity_termination_witness(n: Node, m: Multiplicity) -> Witness<TerminationProof> {
  match m {
    Bounded => Holds { value: structural_node_size_termination_proof() }
    RequiresTerminationProof =>
      Violates { diagnostic: cardinality_descent_not_proven_diagnostic(n: n) }
    ProvenTermination { proof } => Holds { value: proof }
  }
}

// Every connective is Bounded. A type node is never evaluated, so the only descent it owes is the
// structural fold over its own finite subtree (structural_node_size_termination_proof). A
// position's multiplicity (T?, collections) is carried by its Instantiation of the declaration; that is a fact
// about data, not a repetition of evaluation, so it carries no termination obligation. Repetition
// enters a program only through the Loop behavior (recursion is sugar over Loop, DESIGN §4), and
// loop_multiplicity remains the one subject that can answer RequiresTerminationProof.
fn connective_multiplicity(c: Connective) -> Multiplicity {
  match c {
    Atom { identity: _ } => Bounded
    Conj => Bounded
    Disj => Bounded
    Arrow => Bounded
    Instantiation => Bounded
  }
}

fn behavior_multiplicity(b: Behavior) -> Multiplicity {
  match b {
    Value => Bounded
    Transform => Bounded
    Branch => Bounded
    Loop => RequiresTerminationProof
    Bind => Bounded
    Match => Bounded
  }
}

// Measure descent facts ground the loop termination derivation on the single DescentEvidence
// authority (std.termination — operator standing rule 2026-07-08: dag/std wins v2↔dag forks;
// body-lowering design Stage 2/T1). A measure Atom carries descent evidence only via a cited
// registry row; an unregistered symbol is DescentUnknown — the lattice bottom — so an unproven
// measure refuses, never fabricates. Copied-port facts use the same derive-not-hand-stamp
// discipline via v2.lens.cost.copied_port_derivation (Wave 1 Gate 1 C1).

type MeasureDescentFact {
  measure: Symbol
  evidence: DescentEvidence
  citation: String
}

data measure_descent_fact_structural_node_size: MeasureDescentFact = {
  measure: ^cardinality_structural_node_size,
  evidence: Strict,
  citation: "v2.std.node.fold_node structural recursion: every child is a strict subtree of its parent — the dimension structural_node_size_termination_proof already names"
}

data measure_descent_fact_dag_loop_measure: MeasureDescentFact = {
  measure: ^dag_loop_measure_sym,
  evidence: Strict,
  citation: "loop-body producer's declared loop bound (v2.extdeps.languages.dag.dag_loop_measure_node); grounds the exact TerminationProof that loop_round_trip_test and loop_eval_by_execution_test previously hand-fabricated per test site"
}

data measure_descent_fact_fold_iteration: MeasureDescentFact = {
  measure: ^dag_surface_fold_iteration_measure,
  evidence: Strict,
  citation: "fold iteration over a finite collection descends by construction (std.termination DescentSource.FoldIteration: each step consumes one element of the folded list); the surface cost-shape lowering stamps this measure on every fold-family call it lowers to Loop (v2.extdeps.languages.dag)"
}

data measure_descent_fact_registry: List<MeasureDescentFact> = [
  measure_descent_fact_structural_node_size,
  measure_descent_fact_dag_loop_measure,
  measure_descent_fact_fold_iteration
]

fn measure_descent_some(e: DescentEvidence) -> Optional<DescentEvidence> {
  Present { value: e }
}

fn measure_descent_fact_for(registry: List<MeasureDescentFact>, s: Symbol) -> Optional<DescentEvidence> {
  fold(registry, init: Absent, f: fn(acc, row) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        if row.measure == s {
          measure_descent_some(e: row.evidence)
        } else {
          Absent
        }
    }
  })
}

fn measure_descent_evidence_for_symbol(registry: List<MeasureDescentFact>, s: Symbol) -> DescentEvidence {
  match measure_descent_fact_for(registry: registry, s: s) {
    Present { value: e } => e
    Absent => DescentUnknown
  }
}

type MeasureDimensionEvidence {
  dimension: RankingComponent
  evidence: DescentEvidence
}

fn measure_dimension_unknown_rows() -> List<MeasureDimensionEvidence> {
  [
    MeasureDimensionEvidence {
      dimension: RankingComponent { measured: ^cardinality_measure_shape_unknown },
      evidence: DescentUnknown
    }
  ]
}

fn measure_dimension_rows(registry: List<MeasureDescentFact>, measure: Node) -> List<MeasureDimensionEvidence> {
  match measure.kind {
    TypeNode { connective: c } =>
      match c {
        Atom { identity: s } =>
          [
            MeasureDimensionEvidence {
              dimension: RankingComponent { measured: s },
              evidence: measure_descent_evidence_for_symbol(registry: registry, s: s)
            }
          ]
        Conj =>
          fold(measure.children, init: Empty, f: fn(acc, e) {
            fold(measure_dimension_rows(registry: registry, measure: e.target), init: acc, f: fn(acc2, row) {
              Cons { head: row, tail: acc2 }
            })
          })
        Disj => measure_dimension_unknown_rows()
        Arrow => measure_dimension_unknown_rows()
        Instantiation => measure_dimension_unknown_rows()
      }
    ComputationNode { behavior: _ } => measure_dimension_unknown_rows()
  }
}

fn dimension_rows_meet(rows: List<MeasureDimensionEvidence>) -> DescentEvidence {
  fold(rows, init: Strict, f: fn(acc, row) {
    descent_evidence_lattice_meet(a: acc, b: row.evidence)
  })
}

fn dimension_row_is_strict(row: MeasureDimensionEvidence) -> Bool {
  evidence_rank(e: row.evidence) == evidence_rank(e: Strict)
}

fn ranking_dimension_some(d: RankingComponent) -> Optional<RankingComponent> {
  Present { value: d }
}

fn first_strict_dimension(rows: List<MeasureDimensionEvidence>) -> Optional<RankingComponent> {
  fold(rows, init: Absent, f: fn(acc, row) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        if dimension_row_is_strict(row: row) {
          ranking_dimension_some(d: row.dimension)
        } else {
          Absent
        }
    }
  })
}

type LexicographicSplit {
  strict_taken: Bool
  non_increasing: List<RankingComponent>
}

fn non_strict_dimensions_after_first(rows: List<MeasureDimensionEvidence>) -> List<RankingComponent> {
  let split = fold(rows, init: LexicographicSplit { strict_taken: false, non_increasing: Empty }, f: fn(acc, row) {
    if dimension_row_is_strict(row: row) && !acc.strict_taken {
      LexicographicSplit { strict_taken: true, non_increasing: acc.non_increasing }
    } else {
      LexicographicSplit {
        strict_taken: acc.strict_taken,
        non_increasing: Cons { head: row.dimension, tail: acc.non_increasing }
      }
    }
  })
  split.non_increasing
}

fn lexicographic_multiplicity(rows: List<MeasureDimensionEvidence>) -> Multiplicity {
  match first_strict_dimension(rows: rows) {
    Absent => RequiresTerminationProof
    Present { value: strict_dim } =>
      ProvenTermination {
        proof: TerminationProof {
          non_increasing: non_strict_dimensions_after_first(rows: rows),
          strict: strict_dim
        }
      }
  }
}

fn loop_multiplicity_from_rows(rows: List<MeasureDimensionEvidence>) -> Multiplicity {
  if count(rows) == 0 {
    RequiresTerminationProof
  } else {
    match dimension_rows_meet(rows: rows) {
      DescentUnknown => RequiresTerminationProof
      NonIncreasing => lexicographic_multiplicity(rows: rows)
      Strict => lexicographic_multiplicity(rows: rows)
    }
  }
}

fn loop_multiplicity_with(registry: List<MeasureDescentFact>, n: Node) -> Multiplicity {
  match loop_measure_node(n: n) {
    Violates { diagnostic: _ } => RequiresTerminationProof
    Holds { value: measure } =>
      loop_multiplicity_from_rows(rows: measure_dimension_rows(registry: registry, measure: measure))
  }
}

fn loop_multiplicity(n: Node) -> Multiplicity {
  loop_multiplicity_with(registry: measure_descent_fact_registry, n: n)
}

// FLAG B (body-lowering design, operator-signed): Loop multiplicity is decided node-aware here while the other behaviors stay tag-only in behavior_multiplicity — a real distinction, not inconsistency: only Loop's termination depends on a node-level edge (the ^loop_bound_edge measure), which the Behavior tag structurally cannot carry. behavior_multiplicity(Loop) stays RequiresTerminationProof as the honest measure-less projection.
fn node_multiplicity(n: Node) -> Multiplicity {
  match n.kind {
    TypeNode { connective: c } => connective_multiplicity(c: c)
    ComputationNode { behavior: b } =>
      match b {
        Value => behavior_multiplicity(b: b)
        Transform => behavior_multiplicity(b: b)
        Branch => behavior_multiplicity(b: b)
        Loop => loop_multiplicity(n: n)
        Bind => behavior_multiplicity(b: b)
        Match => behavior_multiplicity(b: b)
      }
  }
}

fn cardinality_descent_not_proven_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^cardinality_descent_not_proven,
    at: node_locus(node: n),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn local_termination_proof_witness(n: Node) -> Witness<TerminationProof> {
  multiplicity_termination_witness(n: n, m: node_multiplicity(n: n))
}

fn termination_proof_fold_step(
  acc: Witness<TerminationProof>,
  _e: Edge,
  child: Witness<TerminationProof>
) -> Witness<TerminationProof> {
  match acc {
    Violates { diagnostic: _ } => acc
    Holds { value: proof } =>
      match child {
        Violates { diagnostic: _ } => child
        Holds { value: _ } => Holds { value: proof }
      }
  }
}

fn termination_proof_witness_for_node(n: Node) -> Witness<TerminationProof> {
  fold_node(
    n: n,
    algebra: NodeFold {
      init: fn(n0) {
        local_termination_proof_witness(n: n0)
      },
      step: fn(acc, e, child) {
        termination_proof_fold_step(acc: acc, e: e, child: child)
      }
    }
  )
}

fn loop_bound_witness_for_node(n: Node) -> Witness<LoopBound> {
  match loop_measure_node(n: n) {
    Holds { value: measure } =>
      Holds {
        value: LoopBound {
          measure: measure,
          termination: termination_proof_witness_for_node(n: n)
        }
      }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

// THE NATURAL-COUNT CONSTRAINT DOMAIN (notes/cardinality-absence-analysis.md section 1). A finite count range
// IS std.interval OrderedClosedInterval<Nat>: its sole mint already refuses reversed endpoints, so no second
// pair carrier exists here. The two things that carrier cannot say are the empty set (Impossible: no count
// satisfies the constraint, the bottom of the join) and an unbounded upper end (AtLeast). AtLeast is NOT an
// interval with a sentinel upper endpoint: a sentinel Nat would be a fabricated count (DESIGN section 5)
// that width arithmetic would treat as real.
type CardinalityConstraint
  = CardinalityImpossible
  | CardinalityBounded { interval: OrderedClosedInterval<Nat> }
  | CardinalityAtLeast { lower: Nat }

fn nat_le(a: Nat, b: Nat) -> Bool {
  !(a > b)
}

fn cardinality_exact(count: Nat) -> CardinalityConstraint {
  CardinalityBounded { interval: degenerate_interval(point: count) }
}

// A reversed pair denotes no count at all, which is Impossible and not a swapped range.
fn cardinality_between(low: Nat, high: Nat) -> CardinalityConstraint {
  match closed_interval(low: low, high: high, le: nat_le) {
    IntervalReady { interval: i } => CardinalityBounded { interval: i }
    IntervalRefused { reason: _ } => CardinalityImpossible
  }
}

fn cardinality_lower(c: CardinalityConstraint) -> Optional<Nat> {
  match c {
    CardinalityImpossible => Absent
    CardinalityBounded { interval: i } => Present { value: interval_low(interval: i) }
    CardinalityAtLeast { lower: l } => Present { value: l }
  }
}

// map preserves the count.
fn cardinality_map(c: CardinalityConstraint) -> CardinalityConstraint {
  c
}

// filter keeps a subset: the lower bound floors to zero, the upper bound cannot increase.
fn cardinality_filter(c: CardinalityConstraint) -> CardinalityConstraint {
  match c {
    CardinalityImpossible => CardinalityImpossible
    CardinalityBounded { interval: i } => cardinality_between(low: Zero, high: interval_high(interval: i))
    CardinalityAtLeast { lower: _ } => CardinalityAtLeast { lower: Zero }
  }
}

// concat adds corresponding bounds; an unbounded side keeps only the summed lower bound.
fn cardinality_concat(a: CardinalityConstraint, b: CardinalityConstraint) -> CardinalityConstraint {
  match a {
    CardinalityImpossible => CardinalityImpossible
    CardinalityBounded { interval: ai } =>
      match b {
        CardinalityImpossible => CardinalityImpossible
        CardinalityBounded { interval: bi } =>
          cardinality_between(
            low: nat_add(a: interval_low(interval: ai), b: interval_low(interval: bi)),
            high: nat_add(a: interval_high(interval: ai), b: interval_high(interval: bi))
          )
        CardinalityAtLeast { lower: bl } =>
          CardinalityAtLeast { lower: nat_add(a: interval_low(interval: ai), b: bl) }
      }
    CardinalityAtLeast { lower: al } =>
      match b {
        CardinalityImpossible => CardinalityImpossible
        CardinalityBounded { interval: bi } =>
          CardinalityAtLeast { lower: nat_add(a: al, b: interval_low(interval: bi)) }
        CardinalityAtLeast { lower: bl } => CardinalityAtLeast { lower: nat_add(a: al, b: bl) }
      }
  }
}

// Branch join: the least upper bound; Impossible is the bottom.
fn cardinality_join(a: CardinalityConstraint, b: CardinalityConstraint) -> CardinalityConstraint {
  match a {
    CardinalityImpossible => b
    CardinalityBounded { interval: ai } =>
      match b {
        CardinalityImpossible => a
        CardinalityBounded { interval: bi } =>
          cardinality_between(
            low: nat_min(a: interval_low(interval: ai), b: interval_low(interval: bi)),
            high: nat_max(a: interval_high(interval: ai), b: interval_high(interval: bi))
          )
        CardinalityAtLeast { lower: bl } =>
          CardinalityAtLeast { lower: nat_min(a: interval_low(interval: ai), b: bl) }
      }
    CardinalityAtLeast { lower: al } =>
      match b {
        CardinalityImpossible => a
        CardinalityBounded { interval: bi } =>
          CardinalityAtLeast { lower: nat_min(a: al, b: interval_low(interval: bi)) }
        CardinalityAtLeast { lower: bl } => CardinalityAtLeast { lower: nat_min(a: al, b: bl) }
      }
  }
}

// The seam question for a FreeSemigroup consumer (1..inf): does EVERY admitted count satisfy lower >= 1?
// Impossible is vacuously nonempty (no value reaches the consumer).
fn cardinality_proves_nonempty(c: CardinalityConstraint) -> Bool {
  match cardinality_lower(c: c) {
    Absent => true
    Present { value: l } => Zero < l
  }
}

// PER-OPERATION COUNT LAWS, keyed by the std.algebra declaration's name (notes/cardinality-absence-analysis.md
// section 6: propagation follows declared operations). Every key names a declaration in std.algebra:
// the list functions by their own name, and filter/concat (builtin collection operations) by their
// AlgebraFieldTemplate declarations collection_filter_shape / collection_concat_shape. The key is a leaf
// symbol, so a consumer must match it against the RESOLVED std.algebra declaration, never a user function
// of the same leaf name. The rows live here
// because this module imports std.algebra (the carrier cannot sit below its own operands), so the dependency
// runs one way. An operation with no row has NO law: the answer is Absent (typed undecidable), never a guessed
// bound.
type CardinalityCountLaw
  = CountLiteralEmpty
  | CountPreserved
  | CountFloored
  | CountSummed
  | CountPlusOne
  | CountAtLeastZero

type CardinalityLawRow {
  operation: Symbol
  law: CardinalityCountLaw
}

data cardinality_operation_laws: List<CardinalityLawRow> = [
  CardinalityLawRow { operation: ^freemonoid_empty, law: CountLiteralEmpty },
  CardinalityLawRow { operation: ^list_append, law: CountSummed },
  CardinalityLawRow { operation: ^list_snoc_item, law: CountPlusOne },
  CardinalityLawRow { operation: ^list_map, law: CountPreserved },
  CardinalityLawRow { operation: ^list_reverse, law: CountPreserved },
  CardinalityLawRow { operation: ^collection_filter_shape, law: CountFloored },
  CardinalityLawRow { operation: ^collection_concat_shape, law: CountSummed },
  CardinalityLawRow { operation: ^list_flat_map, law: CountAtLeastZero }
]

fn cardinality_law_some(law: CardinalityCountLaw) -> Optional<CardinalityCountLaw> {
  Present { value: law }
}

fn cardinality_law_for(operation: Symbol) -> Optional<CardinalityCountLaw> {
  fold(cardinality_operation_laws, init: Absent, f: fn(acc, row) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        if row.operation == operation {
          cardinality_law_some(law: row.law)
        } else {
          Absent
        }
    }
  })
}

// Applies a law to the operand constraints (receiver first). A wrong operand arity is Absent, not a guess.
fn cardinality_apply_law(law: CardinalityCountLaw, operands: List<CardinalityConstraint>) -> Optional<CardinalityConstraint> {
  match law {
    CountLiteralEmpty =>
      match operands {
        Empty => Present { value: cardinality_exact(count: Zero) }
        Cons { head: _, tail: _ } => Absent
      }
    CountPreserved =>
      match operands {
        Cons { head: a, tail: Empty } => Present { value: cardinality_map(c: a) }
        _ => Absent
      }
    CountFloored =>
      match operands {
        Cons { head: a, tail: Empty } => Present { value: cardinality_filter(c: a) }
        _ => Absent
      }
    CountSummed =>
      match operands {
        Cons { head: a, tail: Cons { head: b, tail: Empty } } => Present { value: cardinality_concat(a: a, b: b) }
        _ => Absent
      }
    CountPlusOne =>
      match operands {
        Cons { head: a, tail: Empty } => Present { value: cardinality_concat(a: a, b: cardinality_exact(count: Succ { prev: Zero })) }
        _ => Absent
      }
    CountAtLeastZero =>
      match operands {
        Cons { head: a, tail: Empty } =>
          match a {
            CardinalityImpossible => Present { value: CardinalityImpossible }
            _ => Present { value: CardinalityAtLeast { lower: Zero } }
          }
        _ => Absent
      }
  }
}
