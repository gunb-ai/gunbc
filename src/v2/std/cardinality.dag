module v2.std.cardinality


type Never
type Unit
type NonZeroNat {
  prev: v2.std.nat.Nat
}

type NatLeWitness
  = LeqZero { upper: v2.std.nat.Nat }
  | LeqSucc { inner: NatLeWitness }
type UpperBoundedNat {
  le: NatLeWitness
}
type PositiveNatLeWitness
  = PositiveLeqSucc { inner: NatLeWitness }
type PositiveUpperBoundedNat {
  le: PositiveNatLeWitness
}
fn nat_le_witness_lower(w: NatLeWitness) -> v2.std.nat.Nat {
  match w {
    LeqZero { upper: _ } => Zero
    LeqSucc { inner } => Succ { prev: nat_le_witness_lower(w: inner) }
  }
}
fn nat_le_witness_upper(w: NatLeWitness) -> v2.std.nat.Nat {
  match w {
    LeqZero { upper } => upper
    LeqSucc { inner } => Succ { prev: nat_le_witness_upper(w: inner) }
  }
}
fn positive_nat_le_witness_lower(w: PositiveNatLeWitness) -> v2.std.nat.Nat {
  match w {
    PositiveLeqSucc { inner } => Succ { prev: nat_le_witness_lower(w: inner) }
  }
}
fn positive_nat_le_witness_upper(w: PositiveNatLeWitness) -> v2.std.nat.Nat {
  match w {
    PositiveLeqSucc { inner } => Succ { prev: nat_le_witness_upper(w: inner) }
  }
}
fn upper_bounded_nat_value(b: UpperBoundedNat) -> v2.std.nat.Nat {
  nat_le_witness_lower(w: b.le)
}
fn upper_bounded_nat_inclusive_max(b: UpperBoundedNat) -> v2.std.nat.Nat {
  nat_le_witness_upper(w: b.le)
}
fn positive_upper_bounded_nat_value(b: PositiveUpperBoundedNat) -> v2.std.nat.Nat {
  positive_nat_le_witness_lower(w: b.le)
}
fn positive_upper_bounded_nat_inclusive_max(b: PositiveUpperBoundedNat) -> v2.std.nat.Nat {
  positive_nat_le_witness_upper(w: b.le)
}
fn nat_le_witness_well_formed(w: NatLeWitness) -> Bool {
  match w {
    LeqZero { upper: _ } => true
    LeqSucc { inner } => nat_le_witness_well_formed(w: inner)
  }
}
fn upper_bounded_nat_well_formed(b: UpperBoundedNat) -> Bool {
  nat_le_witness_well_formed(w: b.le)
}
fn positive_nat_le_witness_well_formed(w: PositiveNatLeWitness) -> Bool {
  match w {
    PositiveLeqSucc { inner } => nat_le_witness_well_formed(w: inner)
  }
}
fn positive_upper_bounded_nat_well_formed(b: PositiveUpperBoundedNat) -> Bool {
  positive_nat_le_witness_well_formed(w: b.le)
}

type RankingDimension {
  measured: v2.std.node.Symbol
}
type TerminationProof {
  non_increasing: List<RankingDimension>
  strict: RankingDimension
}

type LoopBound {
  measure: v2.std.node.Node
  termination: Witness<TerminationProof>
}

fn loop_bound_measure(bound: LoopBound) -> v2.std.node.Node {
  bound.measure
}

fn loop_bound_undeclared_diagnostic(n: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^cardinality_loop_bound_undeclared,
    at: v2.std.diagnostic.node_locus(node: n),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn loop_bound_ambiguous_diagnostic(n: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^cardinality_loop_bound_ambiguous,
    at: v2.std.diagnostic.node_locus(node: n),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn loop_bound_malformed_diagnostic(n: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^cardinality_loop_bound_malformed,
    at: v2.std.diagnostic.node_locus(node: n),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn loop_bound_not_loop_diagnostic(n: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^cardinality_loop_bound_not_loop,
    at: v2.std.diagnostic.node_locus(node: n),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn loop_measure_node(n: v2.std.node.Node) -> Witness<v2.std.node.Node> {
  match n.kind {
    v2.std.node.ComputationNode { behavior: v2.std.node.Loop } => {
      let bound_count = v2.std.node.name_occurrences(name: ^loop_bound_edge, children: n.children)
      if bound_count == 0 {
        v2.std.witness.Violates { diagnostic: loop_bound_undeclared_diagnostic(n: n) }
      } else if bound_count > 1 {
        v2.std.witness.Violates { diagnostic: loop_bound_ambiguous_diagnostic(n: n) }
      } else if !v2.std.node.loop_behavior_edges_conform(children: n.children) {
        v2.std.witness.Violates { diagnostic: loop_bound_malformed_diagnostic(n: n) }
      } else {
        match v2.std.node.loop_bound_measure_target(children: n.children) {
          Found { target: measure } => v2.std.witness.Holds { value: measure }
          Ambiguous => v2.std.witness.Violates { diagnostic: loop_bound_ambiguous_diagnostic(n: n) }
          v2.std.optional.Absent => v2.std.witness.Violates { diagnostic: loop_bound_undeclared_diagnostic(n: n) }
        }
      }
    }
    _ => v2.std.witness.Violates { diagnostic: loop_bound_not_loop_diagnostic(n: n) }
  }
}

type Multiplicity
  = Bounded
  | RequiresTerminationProof
  | ProvenTermination { proof: TerminationProof }

fn structural_node_size_dimension() -> RankingDimension {
  RankingDimension { measured: ^cardinality_structural_node_size }
}

fn structural_node_size_termination_proof() -> TerminationProof {
  TerminationProof {
    non_increasing: [],
    strict: structural_node_size_dimension()
  }
}

fn multiplicity_termination_witness(n: v2.std.node.Node, m: Multiplicity) -> Witness<TerminationProof> {
  match m {
    Bounded => v2.std.witness.Holds { value: structural_node_size_termination_proof() }
    RequiresTerminationProof =>
      v2.std.witness.Violates { diagnostic: cardinality_descent_not_proven_diagnostic(n: n) }
    ProvenTermination { proof } => v2.std.witness.Holds { value: proof }
  }
}

fn connective_multiplicity(c: v2.std.node.Connective) -> Multiplicity {
  match c {
    v2.std.node.Atom { identity: _ } => Bounded
    v2.std.node.Conj => Bounded
    v2.std.node.Disj => Bounded
    v2.std.node.Arrow => Bounded
    v2.std.node.Cardinality => RequiresTerminationProof
    v2.std.node.Instantiation => Bounded
  }
}

fn behavior_multiplicity(b: v2.std.node.Behavior) -> Multiplicity {
  match b {
    v2.std.node.Value => Bounded
    v2.std.node.Transform => Bounded
    v2.std.node.Branch => Bounded
    v2.std.node.Loop => RequiresTerminationProof
    v2.std.node.Bind => Bounded
    Match => Bounded
  }
}

data measure_descent_registry_note: String = "Measure descent facts ground the loop termination derivation on the single DescentEvidence authority (std.termination — operator standing rule 2026-07-08: dag/std wins v2↔dag forks; body-lowering design Stage 2/T1). A measure Atom carries descent evidence only via a cited registry row; an unregistered symbol is DescentUnknown — the lattice bottom — so an unproven measure refuses, never fabricates. Copied-port facts use the same derive-not-hand-stamp discipline via v2.lens.cost.copied_port_derivation (Wave 1 Gate 1 C1)."

type MeasureDescentFact {
  measure: v2.std.node.Symbol
  evidence: std.termination.DescentEvidence
  citation: String
}

data measure_descent_fact_structural_node_size: MeasureDescentFact = {
  measure: ^cardinality_structural_node_size,
  evidence: std.termination.Strict,
  citation: "v2.std.node.fold_node structural recursion: every child is a strict subtree of its parent — the dimension structural_node_size_termination_proof already names"
}

data measure_descent_fact_dag_loop_measure: MeasureDescentFact = {
  measure: ^dag_loop_measure_sym,
  evidence: std.termination.Strict,
  citation: "loop-body producer's declared loop bound (v2.extdeps.languages.dag.dag_loop_measure_node); grounds the exact TerminationProof that loop_round_trip_test and loop_eval_by_execution_test previously hand-fabricated per test site"
}

data measure_descent_fact_fold_iteration: MeasureDescentFact = {
  measure: ^dag_surface_fold_iteration_measure,
  evidence: std.termination.Strict,
  citation: "fold iteration over a finite collection descends by construction (std.termination DescentSource.FoldIteration: each step consumes one element of the folded list); the surface cost-shape lowering stamps this measure on every fold-family call it lowers to Loop (v2.extdeps.languages.dag)"
}

data measure_descent_fact_registry: List<MeasureDescentFact> = [
  measure_descent_fact_structural_node_size,
  measure_descent_fact_dag_loop_measure,
  measure_descent_fact_fold_iteration
]

fn measure_descent_some(e: std.termination.DescentEvidence) -> v2.std.optional.Optional<std.termination.DescentEvidence> {
  v2.std.optional.Present { value: e }
}

fn measure_descent_fact_for(registry: List<MeasureDescentFact>, s: v2.std.node.Symbol) -> v2.std.optional.Optional<std.termination.DescentEvidence> {
  fold(registry, init: v2.std.optional.Absent, f: fn(acc, row) {
    match acc {
      v2.std.optional.Present { value: _ } => acc
      v2.std.optional.Absent =>
        if row.measure == s {
          measure_descent_some(e: row.evidence)
        } else {
          v2.std.optional.Absent
        }
    }
  })
}

fn measure_descent_evidence_for_symbol(registry: List<MeasureDescentFact>, s: v2.std.node.Symbol) -> std.termination.DescentEvidence {
  match measure_descent_fact_for(registry: registry, s: s) {
    v2.std.optional.Present { value: e } => e
    v2.std.optional.Absent => std.termination.DescentUnknown
  }
}

type MeasureDimensionEvidence {
  dimension: RankingDimension
  evidence: std.termination.DescentEvidence
}

fn measure_dimension_unknown_rows() -> List<MeasureDimensionEvidence> {
  [
    MeasureDimensionEvidence {
      dimension: RankingDimension { measured: ^cardinality_measure_shape_unknown },
      evidence: std.termination.DescentUnknown
    }
  ]
}

fn measure_dimension_rows(registry: List<MeasureDescentFact>, measure: v2.std.node.Node) -> List<MeasureDimensionEvidence> {
  match measure.kind {
    v2.std.node.TypeNode { connective: c } =>
      match c {
        v2.std.node.Atom { identity: s } =>
          [
            MeasureDimensionEvidence {
              dimension: RankingDimension { measured: s },
              evidence: measure_descent_evidence_for_symbol(registry: registry, s: s)
            }
          ]
        v2.std.node.Conj =>
          fold(measure.children, init: std.algebra.Empty, f: fn(acc, e) {
            fold(measure_dimension_rows(registry: registry, measure: e.target), init: acc, f: fn(acc2, row) {
              std.algebra.Cons { head: row, tail: acc2 }
            })
          })
        v2.std.node.Disj => measure_dimension_unknown_rows()
        v2.std.node.Arrow => measure_dimension_unknown_rows()
        v2.std.node.Cardinality => measure_dimension_unknown_rows()
        v2.std.node.Instantiation => measure_dimension_unknown_rows()
      }
    v2.std.node.ComputationNode { behavior: _ } => measure_dimension_unknown_rows()
  }
}

fn dimension_rows_meet(rows: List<MeasureDimensionEvidence>) -> std.termination.DescentEvidence {
  fold(rows, init: std.termination.Strict, f: fn(acc, row) {
    std.termination.descent_evidence_lattice_meet(a: acc, b: row.evidence)
  })
}

fn dimension_row_is_strict(row: MeasureDimensionEvidence) -> Bool {
  std.termination.evidence_rank(e: row.evidence) == std.termination.evidence_rank(e: std.termination.Strict)
}

fn ranking_dimension_some(d: RankingDimension) -> v2.std.optional.Optional<RankingDimension> {
  v2.std.optional.Present { value: d }
}

fn first_strict_dimension(rows: List<MeasureDimensionEvidence>) -> v2.std.optional.Optional<RankingDimension> {
  fold(rows, init: v2.std.optional.Absent, f: fn(acc, row) {
    match acc {
      v2.std.optional.Present { value: _ } => acc
      v2.std.optional.Absent =>
        if dimension_row_is_strict(row: row) {
          ranking_dimension_some(d: row.dimension)
        } else {
          v2.std.optional.Absent
        }
    }
  })
}

type LexicographicSplit {
  strict_taken: Bool
  non_increasing: List<RankingDimension>
}

fn non_strict_dimensions_after_first(rows: List<MeasureDimensionEvidence>) -> List<RankingDimension> {
  let split = fold(rows, init: LexicographicSplit { strict_taken: false, non_increasing: std.algebra.Empty }, f: fn(acc, row) {
    if dimension_row_is_strict(row: row) && !acc.strict_taken {
      LexicographicSplit { strict_taken: true, non_increasing: acc.non_increasing }
    } else {
      LexicographicSplit {
        strict_taken: acc.strict_taken,
        non_increasing: std.algebra.Cons { head: row.dimension, tail: acc.non_increasing }
      }
    }
  })
  split.non_increasing
}

fn lexicographic_multiplicity(rows: List<MeasureDimensionEvidence>) -> Multiplicity {
  match first_strict_dimension(rows: rows) {
    v2.std.optional.Absent => RequiresTerminationProof
    v2.std.optional.Present { value: strict_dim } =>
      ProvenTermination {
        proof: TerminationProof {
          non_increasing: non_strict_dimensions_after_first(rows: rows),
          strict: strict_dim
        }
      }
  }
}

fn loop_multiplicity_from_rows(rows: List<MeasureDimensionEvidence>) -> Multiplicity {
  if count(rows) == 0 {
    RequiresTerminationProof
  } else {
    match dimension_rows_meet(rows: rows) {
      std.termination.DescentUnknown => RequiresTerminationProof
      std.termination.NonIncreasing => lexicographic_multiplicity(rows: rows)
      std.termination.Strict => lexicographic_multiplicity(rows: rows)
    }
  }
}

fn loop_multiplicity_with(registry: List<MeasureDescentFact>, n: v2.std.node.Node) -> Multiplicity {
  match loop_measure_node(n: n) {
    v2.std.witness.Violates { diagnostic: _ } => RequiresTerminationProof
    v2.std.witness.Holds { value: measure } =>
      loop_multiplicity_from_rows(rows: measure_dimension_rows(registry: registry, measure: measure))
  }
}

fn loop_multiplicity(n: v2.std.node.Node) -> Multiplicity {
  loop_multiplicity_with(registry: measure_descent_fact_registry, n: n)
}

// FLAG B (body-lowering design, operator-signed): Loop multiplicity is decided node-aware here while the other behaviors stay tag-only in behavior_multiplicity — a real distinction, not inconsistency: only Loop's termination depends on a node-level edge (the ^loop_bound_edge measure), which the Behavior tag structurally cannot carry. behavior_multiplicity(Loop) stays RequiresTerminationProof as the honest measure-less projection.
fn node_multiplicity(n: v2.std.node.Node) -> Multiplicity {
  match n.kind {
    v2.std.node.TypeNode { connective: c } => connective_multiplicity(c: c)
    v2.std.node.ComputationNode { behavior: b } =>
      match b {
        v2.std.node.Value => behavior_multiplicity(b: b)
        v2.std.node.Transform => behavior_multiplicity(b: b)
        v2.std.node.Branch => behavior_multiplicity(b: b)
        v2.std.node.Loop => loop_multiplicity(n: n)
        v2.std.node.Bind => behavior_multiplicity(b: b)
        Match => behavior_multiplicity(b: b)
      }
  }
}

fn cardinality_descent_not_proven_diagnostic(n: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^cardinality_descent_not_proven,
    at: v2.std.diagnostic.node_locus(node: n),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn local_termination_proof_witness(n: v2.std.node.Node) -> Witness<TerminationProof> {
  multiplicity_termination_witness(n: n, m: node_multiplicity(n: n))
}

fn termination_proof_fold_step(
  acc: Witness<TerminationProof>,
  _: v2.std.node.Edge,
  child: Witness<TerminationProof>
) -> Witness<TerminationProof> {
  match acc {
    v2.std.witness.Violates { diagnostic: _ } => acc
    v2.std.witness.Holds { value: proof } =>
      match child {
        v2.std.witness.Violates { diagnostic: _ } => child
        v2.std.witness.Holds { value: _ } => v2.std.witness.Holds { value: proof }
      }
  }
}

fn termination_proof_witness_for_node(n: v2.std.node.Node) -> Witness<TerminationProof> {
  v2.std.node.fold_node(
    n: n,
    algebra: v2.std.node.NodeFold {
      init: fn(n0) {
        local_termination_proof_witness(n: n0)
      },
      step: fn(acc, e, child) {
        termination_proof_fold_step(acc: acc, e: e, child: child)
      }
    }
  )
}

fn loop_bound_witness_for_node(n: v2.std.node.Node) -> Witness<LoopBound> {
  match loop_measure_node(n: n) {
    v2.std.witness.Holds { value: measure } =>
      v2.std.witness.Holds {
        value: LoopBound {
          measure: measure,
          termination: termination_proof_witness_for_node(n: n)
        }
      }
    v2.std.witness.Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
  }
}
