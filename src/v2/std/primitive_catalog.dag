module v2.std.primitive_catalog

import v2.std.algebra { Empty, fold_list, list_append, list_snoc_item }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.model_core { PrimitiveFactBundle }
import v2.std.node { Symbol }

fn catalog_surface_symbol_matches_spelling(sym: Symbol, spelling: Symbol) -> Bool {
  sym == spelling
}

fn catalog_surface_symbol_in_rows<T>(
  sym: Symbol,
  rows: List<T>,
  row_surface_spelling: fn(T) -> Symbol
) -> Bool {
  fold_list(
    xs: rows,
    empty: false,
    cons: fn(acc, row) {
      acc || catalog_surface_symbol_matches_spelling(
        sym: sym,
        spelling: row_surface_spelling(row)
      )
    }
  )
}

fn primitive_fact_bundles_from_catalog_rows<T>(
  rows: List<T>,
  row_to_bundle: fn(T) -> PrimitiveFactBundle
) -> List<PrimitiveFactBundle> {
  fold_list(
    xs: rows,
    empty: Empty,
    cons: fn(acc, row) {
      list_snoc_item(xs: acc, item: row_to_bundle(row))
    }
  )
}

fn per_language_fact_bundle_entries_from_catalog_rows<T, E>(
  rows: List<T>,
  row_to_entries: fn(T) -> List<E>
) -> List<E> {
  fold_list(
    xs: rows,
    empty: Empty,
    cons: fn(acc, row) {
      list_append(left: acc, right: row_to_entries(row))
    }
  )
}
