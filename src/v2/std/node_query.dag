module v2.std.node_query


fn coproduct_arm_key_list_from_node(node: v2.std.node.Node) -> List<v2.std.node.Symbol> {
  fold(
    xs: node_labeled_child_edges(node: node),
    init: std.algebra.Empty,
    f: fn(acc, e) { v2.std.algebra.list_snoc_item(xs: acc, item: v2.std.node.named_edge_sort_key(e: e)) }
  )
}

fn coproduct_arm_keys(type_name: v2.std.node.Symbol) -> List<v2.std.node.Symbol> {
  coproduct_arm_key_list_from_node(node: v2.std.node.resolve_type_node(type_name: type_name))
}

fn node_is_coproduct(node: v2.std.node.Node) -> Bool {
  match node.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Disj } => true
    _ => false
  }
}

fn edge_field_type_name(target: v2.std.node.Node) -> v2.std.node.Symbol {
  match target.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: sym } } => sym
    _ => ^coproduct_unresolved_payload
  }
}

fn conj_payload_type_name_go(xs: std.algebra.FreeMonoid<v2.std.node.Edge>, acc: String) -> String {
  match xs {
    std.algebra.Empty => acc
    std.algebra.Cons { head: h, tail: t } =>
      let field_name = v2.std.node.named_edge_sort_key(e: h)
      let type_name = edge_field_type_name(target: h.target)
      let piece = concat(field_name, concat(": ", type_name))
      conj_payload_type_name_go(
        xs: t,
        acc: if acc == "{" { concat("{ ", piece) } else { concat(acc, concat(", ", piece)) }
      )
  }
}

fn conj_authored_payload_type_name(n: v2.std.node.Node) -> v2.std.node.Symbol {
  concat(concat(conj_payload_type_name_go(xs: n.children, acc: "{"), " "), "}")
}

fn arm_payload_from_target(target: v2.std.node.Node) -> v2.std.node.ArmPayload {
  match target.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      if count(target.children) == 0 {
        v2.std.node.Nullary
      } else {
        v2.std.node.Typed { target_ref: conj_authored_payload_type_name(n: target) }
      }
    v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: sym } } =>
      v2.std.node.Typed { target_ref: sym }
    _ => v2.std.node.Typed { target_ref: ^coproduct_unresolved_payload }
  }
}

fn arm_payload_type_name(payload: v2.std.node.ArmPayload) -> v2.std.node.Symbol {
  match payload {
    v2.std.node.Nullary => v2.std.node.coproduct_nullary_payload_type_name
    v2.std.node.Typed { target_ref: sym } => sym
  }
}

fn coproduct_arm_from_edge(e: v2.std.node.Edge) -> v2.std.node.CoproductArm {
  v2.std.node.CoproductArm {
    label: v2.std.node.named_edge_sort_key(e: e),
    payload: arm_payload_from_target(target: e.target)
  }
}

fn coproduct_arm_list_from_node(node: v2.std.node.Node) -> List<v2.std.node.CoproductArm> {
  fold(
    xs: node_labeled_child_edges(node: node),
    init: std.algebra.Empty,
    f: fn(acc, e) { v2.std.algebra.list_snoc_item(xs: acc, item: coproduct_arm_from_edge(e: e)) }
  )
}

fn coproduct_arms(type_name: v2.std.node.Symbol) -> List<v2.std.node.CoproductArm> {
  coproduct_arm_list_from_node(node: v2.std.node.resolve_type_node(type_name: type_name))
}

fn coproduct_arm_payload_pair_from_arm(arm: v2.std.node.CoproductArm) -> v2.std.node.CoproductArmPayloadPair {
  v2.std.node.CoproductArmPayloadPair {
    label: arm.label,
    payload_type_name: arm_payload_type_name(payload: arm.payload)
  }
}

fn coproduct_arm_payload_pairs(type_name: v2.std.node.Symbol) -> List<v2.std.node.CoproductArmPayloadPair> {
  fold(
    xs: coproduct_arms(type_name: type_name),
    init: std.algebra.Empty,
    f: fn(acc, arm) {
      v2.std.algebra.list_snoc_item(xs: acc, item: coproduct_arm_payload_pair_from_arm(arm: arm))
    }
  )
}

fn coproduct_nullary_inhabitants<T>(
  type_name: v2.std.node.Symbol,
  discriminant_of: fn(T) -> v2.std.node.Symbol
) -> v2.std.diagnostic.Outcome<List<T>> {
  coproduct_nullary_inhabitants(
    type_name: type_name,
    discriminant_of: discriminant_of
  )
}

type CoproductNullaryInhabitantLookup<T>
  = CoproductNullaryInhabitantMissing
  | CoproductNullaryInhabitantUnique { value: T }
  | CoproductNullaryInhabitantDuplicate

fn coproduct_nullary_inhabitant_lookup_step<T>(
  wanted: v2.std.node.Symbol,
  discriminant_of: fn(T) -> v2.std.node.Symbol,
  acc: CoproductNullaryInhabitantLookup<T>,
  inhabitant: T
) -> CoproductNullaryInhabitantLookup<T> {
  if discriminant_of(inhabitant) == wanted {
    match acc {
      CoproductNullaryInhabitantMissing =>
        CoproductNullaryInhabitantUnique { value: inhabitant }
      CoproductNullaryInhabitantUnique { value: _ } =>
        CoproductNullaryInhabitantDuplicate
      CoproductNullaryInhabitantDuplicate =>
        CoproductNullaryInhabitantDuplicate
    }
  } else {
    acc
  }
}

fn coproduct_nullary_inhabitant_lookup_all<T>(
  wanted: v2.std.node.Symbol,
  discriminant_of: fn(T) -> v2.std.node.Symbol,
  inhabitants: List<T>,
  acc: CoproductNullaryInhabitantLookup<T>
) -> CoproductNullaryInhabitantLookup<T> {
  v2.std.algebra.fold_list(
    xs: inhabitants,
    empty: acc,
    cons: fn(current, inhabitant) {
      coproduct_nullary_inhabitant_lookup_step(
        wanted: wanted,
        discriminant_of: discriminant_of,
        acc: current,
        inhabitant: inhabitant
      )
    }
  )
}

fn coproduct_nullary_inhabitant_lookup_diagnostic(
  type_name: v2.std.node.Symbol,
  reason: v2.std.node.Symbol
) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: reason,
    at: v2.std.diagnostic.node_locus(node: v2.std.node.resolve_type_node(type_name: type_name)),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn coproduct_nullary_inhabitant_by_discriminant<T>(
  type_name: v2.std.node.Symbol,
  discriminant_of: fn(T) -> v2.std.node.Symbol,
  wanted: v2.std.node.Symbol
) -> v2.std.diagnostic.Outcome<T> {
  match coproduct_nullary_inhabitants(
    type_name: type_name,
    discriminant_of: discriminant_of
  ) {
    v2.std.diagnostic.Accepted { value: inhabitants, diagnostics: _ } =>
      match coproduct_nullary_inhabitant_lookup_all(
        wanted: wanted,
        discriminant_of: discriminant_of,
        inhabitants: inhabitants,
        acc: CoproductNullaryInhabitantMissing
      ) {
        CoproductNullaryInhabitantMissing =>
          v2.std.diagnostic.outcome_rejected(coproduct_nullary_inhabitant_lookup_diagnostic(
            type_name: type_name,
            reason: ^coproduct_nullary_inhabitant_missing
          ))
        CoproductNullaryInhabitantUnique { value: inhabitant } =>
          v2.std.diagnostic.outcome_accepted(inhabitant)
        CoproductNullaryInhabitantDuplicate =>
          v2.std.diagnostic.outcome_rejected(coproduct_nullary_inhabitant_lookup_diagnostic(
            type_name: type_name,
            reason: ^coproduct_nullary_inhabitant_duplicate
          ))
      }
    v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn node_positional_child_targets(node: v2.std.node.Node) -> List<v2.std.node.Node> {
  fold(node.children, init: std.algebra.Empty, f: fn(acc, e) {
    match e.label {
      v2.std.node.Positional => v2.std.algebra.list_snoc_item(xs: acc, item: e.target)
      v2.std.node.Named { name: _ } => acc
    }
  })
}

fn node_labeled_child_edges(node: v2.std.node.Node) -> List<v2.std.node.Edge> {
  fold(node.children, init: std.algebra.Empty, f: fn(acc, e) {
    match e.label {
      v2.std.node.Named { name: _ } => v2.std.algebra.list_snoc_item(xs: acc, item: e)
      v2.std.node.Positional => acc
    }
  })
}

fn node_is_callee_reference(node: v2.std.node.Node) -> Bool {
  match node.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Arrow } => true
    v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: _ } } => true
    _ => false
  }
}

fn node_is_call(node: v2.std.node.Node) -> Bool {
  match node.kind {
    v2.std.node.ComputationNode { behavior: v2.std.node.Transform } =>
      match v2.std.collection.list_at_optional(xs: node_positional_child_targets(node: node), index: 0) {
        v2.std.collection.Present { value: callee } => node_is_callee_reference(node: callee)
        v2.std.collection.Absent => false
      }
    _ => false
  }
}

fn call_callee_target(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  if node_is_call(node: node) {
    match v2.std.collection.list_at_optional(xs: node_positional_child_targets(node: node), index: 0) {
      v2.std.collection.Present { value: callee } => v2.std.diagnostic.outcome_accepted(value: callee)
      v2.std.collection.Absent =>
        v2.std.diagnostic.outcome_rejected(d: v2.std.diagnostic.Diagnostic {
          reason: ^call_callee_absent,
          at: v2.std.diagnostic.node_locus(node: node),
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
        })
    }
  } else {
    v2.std.diagnostic.outcome_rejected(d: v2.std.diagnostic.Diagnostic {
      reason: ^node_not_a_call,
      at: v2.std.diagnostic.node_locus(node: node),
      correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
    })
  }
}

fn call_argument_targets(node: v2.std.node.Node) -> List<v2.std.node.Node> {
  match v2.std.algebra.list_tail(xs: node_positional_child_targets(node: node)) {
    v2.std.algebra.TailFound { tail: args } => args
    v2.std.algebra.TailAbsent => std.algebra.Empty
  }
}

fn node_envelope_without_named_coordinate_go(
  root: v2.std.node.Node,
  xs: std.algebra.FreeMonoid<v2.std.node.Edge>,
  coordinate: v2.std.node.Symbol,
  acc: std.algebra.FreeMonoid<v2.std.node.Edge>,
  saw_coordinate: Bool
) -> v2.std.diagnostic.Outcome<std.algebra.FreeMonoid<v2.std.node.Edge>> {
  match xs {
    std.algebra.Empty => v2.std.diagnostic.outcome_accepted(value: acc)
    std.algebra.Cons { head: h, tail: t } =>
      match h.label {
        v2.std.node.Named { name: n } =>
          if (n == coordinate) && saw_coordinate {
            v2.std.diagnostic.outcome_rejected(d: v2.std.diagnostic.Diagnostic {
              reason: ^named_child_ambiguous,
              at: v2.std.diagnostic.node_locus(node: root),
              correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
            })
          } else {
            node_envelope_without_named_coordinate_go(
              root: root,
              xs: t,
              coordinate: coordinate,
              acc: if n == coordinate { acc } else { v2.std.algebra.list_snoc_item(xs: acc, item: h) },
              saw_coordinate: saw_coordinate || (n == coordinate)
            )
          }
        v2.std.node.Positional =>
          node_envelope_without_named_coordinate_go(
            root: root,
            xs: t,
            coordinate: coordinate,
            acc: v2.std.algebra.list_snoc_item(xs: acc, item: h),
            saw_coordinate: saw_coordinate
          )
      }
  }
}

fn find_named_child(root: v2.std.node.Node, name: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match root.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      let count = v2.std.node.name_occurrences(name: name, children: root.children)
      if count == 1 {
        fold(
          root.children,
          init: v2.std.diagnostic.outcome_rejected(d: v2.std.diagnostic.Diagnostic {
            reason: ^named_child_missing,
            at: v2.std.diagnostic.node_locus(node: root),
            correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
          }),
          f: fn(acc, e) {
            match acc {
              v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => acc
              v2.std.diagnostic.Rejected { diagnostics: _ } =>
                match e.label {
                  v2.std.node.Named { name: edge_name } =>
                    if edge_name == name { v2.std.diagnostic.outcome_accepted(value: e.target) } else { acc }
                  v2.std.node.Positional => acc
                }
            }
          }
        )
      } else if count == 0 {
        v2.std.diagnostic.outcome_rejected(d: v2.std.diagnostic.Diagnostic {
          reason: ^named_child_missing,
          at: v2.std.diagnostic.node_locus(node: root),
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
        })
      } else {
        v2.std.diagnostic.outcome_rejected(d: v2.std.diagnostic.Diagnostic {
          reason: ^named_child_ambiguous,
          at: v2.std.diagnostic.node_locus(node: root),
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
        })
      }
    _ =>
      v2.std.diagnostic.outcome_rejected(d: v2.std.diagnostic.Diagnostic {
        reason: ^named_child_missing,
        at: v2.std.diagnostic.node_locus(node: root),
        correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
      })
  }
}

fn find_arrow_body_child(root: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match root.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Arrow } =>
      match v2.std.node.arrow_body_target_lookup(children: root.children) {
        v2.std.node.Found { target: body } => v2.std.diagnostic.outcome_accepted(value: body)
        v2.std.node.Ambiguous =>
          v2.std.diagnostic.outcome_rejected(d: v2.std.diagnostic.Diagnostic {
            reason: ^arrow_body_child_ambiguous,
            at: v2.std.diagnostic.node_locus(node: root),
            correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
          })
        _ =>
          v2.std.diagnostic.outcome_rejected(d: v2.std.diagnostic.Diagnostic {
            reason: ^arrow_body_child_missing,
            at: v2.std.diagnostic.node_locus(node: root),
            correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
          })
      }
    _ =>
      v2.std.diagnostic.outcome_rejected(d: v2.std.diagnostic.Diagnostic {
        reason: ^arrow_body_child_not_arrow,
        at: v2.std.diagnostic.node_locus(node: root),
        correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
      })
  }
}

fn node_query_domain_malformed_diagnostic(domain: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^arrow_domain_named_param_bindings_malformed,
    at: v2.std.diagnostic.node_locus(node: domain),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn conj_ordered_named_param_binding_ids(domain: v2.std.node.Node) -> v2.std.diagnostic.Outcome<List<v2.std.node.Symbol>> {
  match domain.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      match fold(domain.children, init: v2.std.diagnostic.outcome_accepted(value: std.algebra.Empty), f: fn(acc, edge) {
        match acc {
          v2.std.diagnostic.Accepted { value: bindings, diagnostics: d } =>
            match edge.label {
              v2.std.node.Named { name: sym } =>
                outcome_with_diagnostics(
                  value: v2.std.algebra.list_snoc_item(xs: bindings, item: sym),
                  diagnostics: d
                )
              v2.std.node.Positional =>
                v2.std.diagnostic.outcome_rejected(
                  d: node_query_domain_malformed_diagnostic(domain: domain)
                )
            }
          v2.std.diagnostic.Rejected { diagnostics: _ } => acc
        }
      }) {
        v2.std.diagnostic.Accepted { value: bindings, diagnostics: d } =>
          if v2.std.algebra.is_empty(xs: bindings) {
            v2.std.diagnostic.outcome_rejected(
              d: node_query_domain_malformed_diagnostic(domain: domain)
            )
          } else {
            outcome_with_diagnostics(value: bindings, diagnostics: d)
          }
        v2.std.diagnostic.Rejected { diagnostics: d } => v2.std.diagnostic.Rejected { diagnostics: d }
      }
    _ =>
      v2.std.diagnostic.outcome_rejected(
        d: node_query_domain_malformed_diagnostic(domain: domain)
      )
  }
}

fn arrow_domain_named_param_bindings(arrow: v2.std.node.Node) -> v2.std.diagnostic.Outcome<List<v2.std.node.Symbol>> {
  match arrow.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Arrow } =>
      match v2.std.collection.list_at_optional(xs: node_positional_child_targets(node: arrow), index: 0) {
        v2.std.collection.Present { value: domain } =>
          conj_ordered_named_param_binding_ids(domain: domain)
        v2.std.collection.Absent =>
          v2.std.diagnostic.outcome_rejected(d: v2.std.diagnostic.Diagnostic {
            reason: ^arrow_domain_named_param_bindings_missing,
            at: v2.std.diagnostic.node_locus(node: arrow),
            correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
          })
      }
    _ =>
      v2.std.diagnostic.outcome_rejected(d: v2.std.diagnostic.Diagnostic {
        reason: ^arrow_domain_named_param_bindings_not_arrow,
        at: v2.std.diagnostic.node_locus(node: arrow),
        correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
      })
  }
}
