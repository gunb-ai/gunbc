module v2.std.node_query

import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Rejected,
  Unavailable,
  node_locus,
  outcome_accepted,
  outcome_rejected
}
import std.algebra { Cons, Empty, FreeMonoid }
import v2.std.algebra { TailAbsent, TailFound, fold_list, is_empty, list_append, list_snoc_item, list_tail }
import v2.std.collection { Absent, List, Present, list_at_optional }
import v2.std.compilers.lexing { symbol_intern_lexeme }
import v2.std.node {
  Ambiguous,
  Atom,
  ArmPayload,
  Arrow,
  Behavior,
  Cardinality,
  ComputationNode,
  Conj,
  CoproductArm,
  CoproductArmPayloadPair,
  Disj,
  Edge,
  Found,
  Named,
  Node,
  Nullary,
  Positional,
  Symbol,
  Transform,
  TypeNode,
  Typed,
  arrow_body_target_lookup,
  coproduct_nullary_payload_type_name,
  named_edge_sort_key,
  node_with_occurrence_id
}
import v2.std.optional { Optional, optional_absent, optional_present }

fn coproduct_arm_key_list_from_node(node: Node) -> List<Symbol> {
  fold(
    xs: node_labeled_child_edges(node: node),
    init: Empty,
    f: fn(acc, e) { list_snoc_item(xs: acc, item: named_edge_sort_key(e: e)) }
  )
}

fn node_is_coproduct(node: Node) -> Bool {
  match node.kind {
    TypeNode { connective: Disj } => true
    _ => false
  }
}

fn edge_field_type_name(target: Node) -> Symbol {
  match target.kind {
    TypeNode { connective: Atom { identity: sym } } => sym
    _ => ^coproduct_unresolved_payload
  }
}

fn conj_payload_type_name_go(xs: FreeMonoid<Edge>, acc: String) -> String {
  match xs {
    Empty => acc
    Cons { head: h, tail: t } =>
      let field_name = named_edge_sort_key(e: h)
      let type_name = edge_field_type_name(target: h.target)
      let piece = concat(field_name, concat(": ", type_name))
      conj_payload_type_name_go(
        xs: t,
        acc: if acc == "{" { concat("{ ", piece) } else { concat(acc, concat(", ", piece)) }
      )
  }
}

fn conj_authored_payload_type_name(n: Node) -> Symbol {
  concat(concat(conj_payload_type_name_go(xs: n.children, acc: "{"), " "), "}")
}

fn arm_payload_from_target(target: Node) -> ArmPayload {
  match target.kind {
    TypeNode { connective: Conj } =>
      if count(target.children) == 0 {
        Nullary
      } else {
        Typed { target_ref: conj_authored_payload_type_name(n: target) }
      }
    TypeNode { connective: Atom { identity: sym } } =>
      Typed { target_ref: sym }
    _ => Typed { target_ref: ^coproduct_unresolved_payload }
  }
}

fn arm_payload_type_name(payload: ArmPayload) -> Symbol {
  match payload {
    Nullary => coproduct_nullary_payload_type_name
    Typed { target_ref: sym } => sym
  }
}

fn coproduct_arm_from_edge(e: Edge) -> CoproductArm {
  CoproductArm {
    label: named_edge_sort_key(e: e),
    payload: arm_payload_from_target(target: e.target)
  }
}

fn coproduct_arm_list_from_node(node: Node) -> List<CoproductArm> {
  fold(
    xs: node_labeled_child_edges(node: node),
    init: Empty,
    f: fn(acc, e) { list_snoc_item(xs: acc, item: coproduct_arm_from_edge(e: e)) }
  )
}

fn coproduct_arm_payload_pair_from_arm(arm: CoproductArm) -> CoproductArmPayloadPair {
  CoproductArmPayloadPair {
    label: arm.label,
    payload_type_name: arm_payload_type_name(payload: arm.payload)
  }
}

// THE DECLARED FIELD MODEL, AS THE SEED DECLARES IT. v1.compiler.core make_field_node gives a
// field a name, a type, a cardinality and an optional default; v1.compiler.parse
// parse_positional_variant_type_fields reads the positional payload `Name(T)` as exactly one
// Required field named "0". In the core a declared field IS a Named edge on the payload Conj:
// the label is the field identity, the target is the field's type. A Required field's target is
// the type itself; an Optional field (`f: T?`) targets a Cardinality node over it. A default is
// not admitted on a general field by the dag grammar (dag_grammar_field_decl_expr refuses it
// loudly), so the reader carries no default slot. Positional and record spellings are one shape:
// `A(T)` declares the field list [0: T] and `A { v: T }` declares [v: T]. Nullary is the empty
// payload Conj (arm_payload_from_target Nullary), not an absent one.
// CONSUMERS (DESIGN 3c): the producers (v2.compiler.body_lowering_fold) build the field edges
// directly; these READERS are consumed today by v2.test.parse.variant_field_lowering over real
// normalize output, and their production consumer is the declared frontier of the same lane:
// field projection off a receiver -- `expr.field` names a DECLARED field of the receiver's type
// or refuses, located -- and the construction/elimination typing that joins a positional operand
// to field "0" (the seed's infer_variant_constructor_call), both dispatched as the follow-up PR to
// gunbc#12033 in the native-route program. They are not a second lookup model: that PR reads
// declared_field_named and refuses on Absent.
// CARDINALITY IS CARRIED, NOT RE-SNIFFED BY EACH CONSUMER. An Optional field's edge targets a
// Cardinality node over its type, so exactly ONE reader decodes that -- declared_field_from_edge --
// and consumers read the decoded field. An earlier revision had every consumer re-derive it from
// the target's connective, which is DESIGN section 5's validation standing where construction was
// available: that check was satisfiable by editing the declaration while the realization lied.
// It is a Bool rather than the std.constructors Cardinality coproduct because this module already
// imports Cardinality from v2.std.node as the CONNECTIVE and the two names collide here; carrying
// the decoded fact still beats re-decoding it, and an import that disambiguates the two authorities
// is what dissolves the weaker spelling. The v1 model this tracks also has a DEFAULT slot, left out
// deliberately: the dag grammar refuses a default on a general field, so no consumer needs one.
type DeclaredField {
  name: Symbol
  type_node: Node
  required: Bool
}

fn positional_payload_field_name() -> Symbol {
  symbol_intern_lexeme(lexeme: "0")
}

// The wildcard pattern `_` binds nothing and names nothing (v1.compiler.parse parse_pattern).
fn pattern_wildcard_name() -> Symbol {
  symbol_intern_lexeme(lexeme: "_")
}

// THE ONE PLACE THE EDGE'S CARDINALITY IS DECODED. Every consumer reads DeclaredField.required
// rather than matching the target's connective again.
fn declared_field_required_from_target(target: Node) -> Bool {
  match target.kind {
    TypeNode { connective: Cardinality } => false
    _ => true
  }
}

fn declared_field_from_edge(e: Edge) -> Optional<DeclaredField> {
  match e.label {
    Named { name: field_name } =>
      Present {
        value: DeclaredField {
          name: field_name,
          type_node: e.target,
          required: declared_field_required_from_target(target: e.target)
        }
      }
    Positional => Absent
  }
}

// The field list a payload declares, in declaration order. Anything that is not a payload Conj
// declares no fields; a caller that needs to distinguish "nullary" from "not a payload" asks
// payload_is_nullary first.
fn declared_field_list(payload: Node) -> List<DeclaredField> {
  match payload.kind {
    TypeNode { connective: Conj } =>
      fold(payload.children, init: Empty, f: fn(acc, e) {
        match declared_field_from_edge(e: e) {
          Present { value: f } => list_snoc_item(xs: acc, item: f)
          Absent => acc
        }
      })
    _ => Empty
  }
}

fn payload_is_nullary(payload: Node) -> Bool {
  match payload.kind {
    TypeNode { connective: Conj } => count(payload.children) == 0
    _ => false
  }
}

fn declared_field_named(payload: Node, name: Symbol) -> Optional<DeclaredField> {
  fold(declared_field_list(payload: payload), init: Absent, f: fn(acc, f) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        match f.name == name {
          true => Present { value: f }
          false => Absent
        }
    }
  })
}

// A CONSTRUCT is the value-side twin of a payload: the same field edges, each targeting the
// value supplied for that field, behind one leading TAG edge whose label and target both name
// the constructor (`Rec { n: 1 }` is Conj { Rec: Atom(Rec), n: 1 }). It is the shape
// v2.std.node RecordConstructBody admits (arrow_body_record_construct_conforms: every edge Named,
// the first one an Atom) and the shape the language authority's fixtures build
// (v2.extdeps.languages.dag dag_rec_construct_body_node, dag_variant_holds_construct_node). A
// match-arm PATTERN over a fielded variant is the same construct whose field targets are the
// binders, so construction and elimination read one shape.
fn construct_tag_edge(tag: Symbol, source: Node) -> Edge {
  Edge {
    label: Named { name: tag },
    target: node_with_occurrence_id(
      kind: TypeNode { connective: Atom { identity: tag } },
      children: [],
      occurrence_id: source.occurrence_id
    )
  }
}

fn construct_node(tag: Symbol, field_edges: List<Edge>, source: Node) -> Node {
  node_with_occurrence_id(
    kind: TypeNode { connective: Conj },
    children: list_append(
      left: [construct_tag_edge(tag: tag, source: source)],
      right: field_edges
    ),
    occurrence_id: source.occurrence_id
  )
}

// The tag of a construct: its first edge, when that edge names the atom it targets. Anything
// else -- a payload Conj, a domain Conj, a bare record with no tag -- has no constructor tag.
fn construct_tag_optional(n: Node) -> Optional<Symbol> {
  match n.kind {
    TypeNode { connective: Conj } =>
      match first(n.children) {
        Present { value: e } =>
          match e.label {
            Named { name: label } =>
              match e.target.kind {
                TypeNode { connective: Atom { identity: id } } =>
                  match id == label {
                    true => Present { value: label }
                    false => Absent
                  }
                _ => Absent
              }
            Positional => Absent
          }
        Absent => Absent
      }
    _ => Absent
  }
}

// The field edges of a construct: every edge after the tag. Empty for a nullary construct and
// for a node that is not a construct.
fn construct_field_edges(n: Node) -> List<Edge> {
  match construct_tag_optional(n: n) {
    Absent => Empty
    Present { value: _ } =>
      match list_tail(xs: n.children) {
        TailFound { tail: rest } => rest
        TailAbsent => Empty
      }
  }
}

// FIELD PROJECTION OFF A COMPUTED RECEIVER: THE ELIMINATOR OF THE DECLARED FIELD ABOVE.
//
// `expr.f` where `expr` is a computed value rather than a name. It is a SEPARATE construct from
// the qualified-name spine, and the reason is structural rather than stylistic: v2.std.qualified_name
// QualifiedName is `FreeMonoid<Symbol>`, so a spine cannot carry a computed root at all -- there is
// no slot in it for a Node. `a.b.c` over bare segments stays the spine and the resolver decides
// what its head denotes (v2.compiler.body_lowering_fold body_lower_dotted_chain_lowered_optional
// states that contract); only a receiver the spine cannot represent reaches this shape.
//
// The relation is the seed's: v1.compiler.core ExprFieldAccess carries a base child and the
// field's authored name, and the emission side already reads exactly that pair
// (v2.std.compilers.target_model target_value_expr_field_access_base_from_wire /
// _field_from_wire, rendered through TargetFieldAccessShape). So the core shape is the same two
// facts and no third: a Conj with a BASE edge to the receiver's lowered node and a FIELD edge to
// the field-name atom.
//
// WHY THIS CANNOT BE CONFUSED WITH A CONSTRUCT, which is the only neighbouring Conj-of-Named
// shape: construct_tag_optional admits a Conj whose FIRST edge names the atom it targets, and
// `field_projection_base` never targets an atom named `field_projection_base`. Read in the other
// direction, field_projection_optional requires BOTH reserved labels, which construct_field_edges
// never produces because its labels are the declared field identities.
//
// WHAT THIS DOES NOT DO, stated because 12033's header promised the other half here: it does not
// check that `f` IS a declared field of the receiver's type. That check reads declared_field_named
// against the receiver's payload and needs a TYPE, which normalize does not have -- it is the
// typecheck stage's, over this node, and it is the declared frontier this shape exists to give a
// subject. Until it lands, a misspelled field is a resolve/typecheck-stage question and NOT
// silently answered here.
fn field_projection_base_name() -> Symbol {
  ^field_projection_base
}

fn field_projection_field_name() -> Symbol {
  ^field_projection_field
}

fn field_projection_node(base: Node, field: Symbol, source: Node) -> Node {
  node_with_occurrence_id(
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: field_projection_base_name() }, target: base },
      Edge {
        label: Named { name: field_projection_field_name() },
        target: node_with_occurrence_id(
          kind: TypeNode { connective: Atom { identity: field } },
          children: [],
          occurrence_id: source.occurrence_id
        )
      }
    ],
    occurrence_id: source.occurrence_id
  )
}

type FieldProjection {
  base: Node
  field: Symbol
}

fn field_projection_edge_base_optional(e: Edge) -> Optional<Node> {
  match e.label {
    Named { name: n } =>
      if n == field_projection_base_name() {
        optional_present(value: e.target)
      } else {
        optional_absent()
      }
    Positional => optional_absent()
  }
}

fn field_projection_edge_field_optional(e: Edge) -> Optional<Symbol> {
  match e.label {
    Named { name: n } =>
      if n == field_projection_field_name() {
        match e.target.kind {
          TypeNode { connective: Atom { identity: id } } => optional_present(value: id)
          _ => optional_absent()
        }
      } else {
        optional_absent()
      }
    Positional => optional_absent()
  }
}

// The reader: a two-edge Conj carrying exactly the base edge then the field edge. Anything else
// -- a construct, a payload, a spine, a one-edge variant declaration -- is not a projection, and
// the reader says so rather than guessing at a partial match.
fn field_projection_optional(n: Node) -> Optional<FieldProjection> {
  match n.kind {
    TypeNode { connective: Conj } =>
      match list_at_optional(xs: n.children, index: 0) {
        Absent => optional_absent()
        Present { value: base_edge } =>
          match list_at_optional(xs: n.children, index: 1) {
            Absent => optional_absent()
            Present { value: field_edge } =>
              match list_at_optional(xs: n.children, index: 2) {
                Present { value: _ } => optional_absent()
                Absent =>
                  match field_projection_edge_base_optional(e: base_edge) {
                    Absent => optional_absent()
                    Present { value: base } =>
                      match field_projection_edge_field_optional(e: field_edge) {
                        Absent => optional_absent()
                        Present { value: field } =>
                          optional_present(value: FieldProjection { base: base, field: field })
                      }
                  }
              }
          }
      }
    _ => optional_absent()
  }
}

// A DECLARED VARIANT, before the coproduct fold joins it to its siblings: one Named edge from the
// variant's label to its payload Conj, carried on a one-edge Conj so the sugar fold
// (v2.std.compilers.sugar sugar_variant_to_disj_edge) can read label and payload off it without
// re-walking the parse. A raw, unlowered variant is a parse sequence with two projection edges,
// never a one-edge Conj, so the two cannot be confused.
fn variant_declaration_node(label: Symbol, payload: Node, source: Node) -> Node {
  node_with_occurrence_id(
    kind: TypeNode { connective: Conj },
    children: [Edge { label: Named { name: label }, target: payload }],
    occurrence_id: source.occurrence_id
  )
}

fn variant_declaration_edge_optional(n: Node) -> Optional<Edge> {
  match n.kind {
    TypeNode { connective: Conj } =>
      match count(n.children) == 1 {
        false => optional_absent()
        true =>
          match first(n.children) {
            Present { value: e } =>
              match e.label {
                Named { name: _ } =>
                  match e.target.kind {
                    TypeNode { connective: Conj } => optional_present(value: e)
                    _ => optional_absent()
                  }
                Positional => optional_absent()
              }
            Absent => optional_absent()
          }
      }
    _ => optional_absent()
  }
}

type CoproductNullaryInhabitantLookup<T>
  = CoproductNullaryInhabitantMissing
  | CoproductNullaryInhabitantUnique { value: T }
  | CoproductNullaryInhabitantDuplicate

fn coproduct_nullary_inhabitant_lookup_step<T>(
  wanted: Symbol,
  discriminant_of: fn(T) -> Symbol,
  acc: CoproductNullaryInhabitantLookup<T>,
  inhabitant: T
) -> CoproductNullaryInhabitantLookup<T> {
  if discriminant_of(inhabitant) == wanted {
    match acc {
      CoproductNullaryInhabitantMissing =>
        CoproductNullaryInhabitantUnique { value: inhabitant }
      CoproductNullaryInhabitantUnique { value: _ } =>
        CoproductNullaryInhabitantDuplicate
      CoproductNullaryInhabitantDuplicate =>
        CoproductNullaryInhabitantDuplicate
    }
  } else {
    acc
  }
}

fn coproduct_nullary_inhabitant_lookup_all<T>(
  wanted: Symbol,
  discriminant_of: fn(T) -> Symbol,
  inhabitants: List<T>,
  acc: CoproductNullaryInhabitantLookup<T>
) -> CoproductNullaryInhabitantLookup<T> {
  fold_list(
    xs: inhabitants,
    empty: acc,
    cons: fn(current, inhabitant) {
      coproduct_nullary_inhabitant_lookup_step(
        wanted: wanted,
        discriminant_of: discriminant_of,
        acc: current,
        inhabitant: inhabitant
      )
    }
  )
}

// ROSTER-BACKED, NOT REFLECTION-BACKED, and the located refusal is why the change is a
// repair rather than a relocation. The former shape took a type NAME, asked the host for
// that type's nullary inhabitants, and located its refusal at the resolved type node --
// three facts a compiler emitted to a target does not have. The caller already holds the
// inhabitants (its own module declares them) and already holds the node it is decoding,
// which is a strictly better locus than the type declaration: a wire identity that names
// no arm is a defect in THAT node, not in the type. Both refusal arms survive the change,
// so the missing and duplicate distinctions are not erased by dropping reflection.
fn nullary_inhabitant_lookup_diagnostic(at: Node, reason: Symbol) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: at),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn nullary_inhabitant_by_discriminant<T>(
  inhabitants: List<T>,
  discriminant_of: fn(T) -> Symbol,
  wanted: Symbol,
  at: Node
) -> Outcome<T> {
  match coproduct_nullary_inhabitant_lookup_all(
    wanted: wanted,
    discriminant_of: discriminant_of,
    inhabitants: inhabitants,
    acc: CoproductNullaryInhabitantMissing
  ) {
    CoproductNullaryInhabitantMissing =>
      outcome_rejected(nullary_inhabitant_lookup_diagnostic(
        at: at,
        reason: ^coproduct_nullary_inhabitant_missing
      ))
    CoproductNullaryInhabitantUnique { value: inhabitant } =>
      outcome_accepted(inhabitant)
    CoproductNullaryInhabitantDuplicate =>
      outcome_rejected(nullary_inhabitant_lookup_diagnostic(
        at: at,
        reason: ^coproduct_nullary_inhabitant_duplicate
      ))
  }
}

fn node_positional_child_targets(node: Node) -> List<Node> {
  fold(node.children, init: Empty, f: fn(acc, e) {
    match e.label {
      Positional => list_snoc_item(xs: acc, item: e.target)
      Named { name: _ } => acc
    }
  })
}

fn node_labeled_child_edges(node: Node) -> List<Edge> {
  fold(node.children, init: Empty, f: fn(acc, e) {
    match e.label {
      Named { name: _ } => list_snoc_item(xs: acc, item: e)
      Positional => acc
    }
  })
}

fn node_is_callee_reference(node: Node) -> Bool {
  match node.kind {
    TypeNode { connective: Arrow } => true
    TypeNode { connective: Atom { identity: _ } } => true
    _ => false
  }
}

fn node_is_call(node: Node) -> Bool {
  match node.kind {
    ComputationNode { behavior: Transform } =>
      match list_at_optional(xs: node_positional_child_targets(node: node), index: 0) {
        Present { value: callee } => node_is_callee_reference(node: callee)
        Absent => false
      }
    _ => false
  }
}

fn call_callee_target(node: Node) -> Outcome<Node> {
  if node_is_call(node: node) {
    match list_at_optional(xs: node_positional_child_targets(node: node), index: 0) {
      Present { value: callee } => outcome_accepted(value: callee)
      Absent =>
        outcome_rejected(d: Diagnostic {
          reason: ^call_callee_absent,
          at: node_locus(node: node),
          correction: Unavailable { reason: ExternalContractUnknown }
        })
    }
  } else {
    outcome_rejected(d: Diagnostic {
      reason: ^node_not_a_call,
      at: node_locus(node: node),
      correction: Unavailable { reason: ExternalContractUnknown }
    })
  }
}

fn call_argument_targets(node: Node) -> List<Node> {
  match list_tail(xs: node_positional_child_targets(node: node)) {
    TailFound { tail: args } => args
    TailAbsent => Empty
  }
}

fn node_envelope_without_named_coordinate_go(
  root: Node,
  xs: FreeMonoid<Edge>,
  coordinate: Symbol,
  acc: FreeMonoid<Edge>,
  saw_coordinate: Bool
) -> Outcome<FreeMonoid<Edge>> {
  match xs {
    Empty => outcome_accepted(value: acc)
    Cons { head: h, tail: t } =>
      match h.label {
        Named { name: n } =>
          if (n == coordinate) && saw_coordinate {
            outcome_rejected(d: Diagnostic {
              reason: ^named_child_ambiguous,
              at: node_locus(node: root),
              correction: Unavailable { reason: ExternalContractUnknown }
            })
          } else {
            node_envelope_without_named_coordinate_go(
              root: root,
              xs: t,
              coordinate: coordinate,
              acc: if n == coordinate { acc } else { list_snoc_item(xs: acc, item: h) },
              saw_coordinate: saw_coordinate || (n == coordinate)
            )
          }
        Positional =>
          node_envelope_without_named_coordinate_go(
            root: root,
            xs: t,
            coordinate: coordinate,
            acc: list_snoc_item(xs: acc, item: h),
            saw_coordinate: saw_coordinate
          )
      }
  }
}

// A NAMED-CHILD LOOKUP IS TOTAL: a node has exactly one child under a name, none, or several, and all
// three are answers. So the lookup is the primitive and find_named_child's Outcome is its projection
// -- the direction v2.std.collection map_lookup already takes, for the same reason. The Outcome-first
// shape made two costs. Every probe built a Diagnostic (an interned reason and a node locus) whether
// or not anyone read it -- the fold even seeded itself with one on the hit path -- and callers that
// only wanted "is it there" paid that on every miss: parse_production_emitted_identity_optional under
// body lowering's subtree search put find_named_child at 12% of the native route's process (perf
// --children, bounded K=64 root, after C4). And a caller that needed the three states had to decode
// them back out of diagnostic reasons, which std.bounded_lattice_completeness did in its own
// BlNamedChildLookup. One pass over the children decides all three.
type NamedChildLookup
  = NamedChildFound { target: Node }
  | NamedChildMissing
  | NamedChildAmbiguous

fn named_child_lookup(root: Node, name: Symbol) -> NamedChildLookup {
  match root.kind {
    TypeNode { connective: Conj } =>
      fold(root.children, init: NamedChildMissing, f: fn(acc, e) {
        match e.label {
          Positional => acc
          Named { name: edge_name } =>
            if edge_name == name {
              match acc {
                NamedChildMissing => NamedChildFound { target: e.target }
                NamedChildFound { target: _ } => NamedChildAmbiguous
                NamedChildAmbiguous => NamedChildAmbiguous
              }
            } else {
              acc
            }
        }
      })
    _ => NamedChildMissing
  }
}

fn find_named_child(root: Node, name: Symbol) -> Outcome<Node> {
  match named_child_lookup(root: root, name: name) {
    NamedChildFound { target: target } => outcome_accepted(value: target)
    NamedChildMissing =>
      outcome_rejected(d: Diagnostic {
        reason: ^named_child_missing,
        at: node_locus(node: root),
        correction: Unavailable { reason: ExternalContractUnknown }
      })
    NamedChildAmbiguous =>
      outcome_rejected(d: Diagnostic {
        reason: ^named_child_ambiguous,
        at: node_locus(node: root),
        correction: Unavailable { reason: ExternalContractUnknown }
      })
  }
}

fn find_arrow_body_child(root: Node) -> Outcome<Node> {
  match root.kind {
    TypeNode { connective: Arrow } =>
      match arrow_body_target_lookup(children: root.children) {
        Found { target: body } => outcome_accepted(value: body)
        Ambiguous =>
          outcome_rejected(d: Diagnostic {
            reason: ^arrow_body_child_ambiguous,
            at: node_locus(node: root),
            correction: Unavailable { reason: ExternalContractUnknown }
          })
        _ =>
          outcome_rejected(d: Diagnostic {
            reason: ^arrow_body_child_missing,
            at: node_locus(node: root),
            correction: Unavailable { reason: ExternalContractUnknown }
          })
      }
    _ =>
      outcome_rejected(d: Diagnostic {
        reason: ^arrow_body_child_not_arrow,
        at: node_locus(node: root),
        correction: Unavailable { reason: ExternalContractUnknown }
      })
  }
}

fn node_query_domain_malformed_diagnostic(domain: Node) -> Diagnostic {
  Diagnostic {
    reason: ^arrow_domain_named_param_bindings_malformed,
    at: node_locus(node: domain),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn conj_ordered_named_param_binding_ids(domain: Node) -> Outcome<List<Symbol>> {
  match domain.kind {
    TypeNode { connective: Conj } =>
      match fold(domain.children, init: outcome_accepted(value: Empty), f: fn(acc, edge) {
        match acc {
          Accepted { value: bindings, diagnostics: d } =>
            match edge.label {
              Named { name: sym } =>
                outcome_with_diagnostics(
                  value: list_snoc_item(xs: bindings, item: sym),
                  diagnostics: d
                )
              Positional =>
                outcome_rejected(
                  d: node_query_domain_malformed_diagnostic(domain: domain)
                )
            }
          Rejected { diagnostics: _ } => acc
        }
      }) {
        Accepted { value: bindings, diagnostics: d } =>
          if is_empty(xs: bindings) {
            outcome_rejected(
              d: node_query_domain_malformed_diagnostic(domain: domain)
            )
          } else {
            outcome_with_diagnostics(value: bindings, diagnostics: d)
          }
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
      }
    _ =>
      outcome_rejected(
        d: node_query_domain_malformed_diagnostic(domain: domain)
      )
  }
}

fn arrow_domain_named_param_bindings(arrow: Node) -> Outcome<List<Symbol>> {
  match arrow.kind {
    TypeNode { connective: Arrow } =>
      match list_at_optional(xs: node_positional_child_targets(node: arrow), index: 0) {
        Present { value: domain } =>
          conj_ordered_named_param_binding_ids(domain: domain)
        Absent =>
          outcome_rejected(d: Diagnostic {
            reason: ^arrow_domain_named_param_bindings_missing,
            at: node_locus(node: arrow),
            correction: Unavailable { reason: ExternalContractUnknown }
          })
      }
    _ =>
      outcome_rejected(d: Diagnostic {
        reason: ^arrow_domain_named_param_bindings_not_arrow,
        at: node_locus(node: arrow),
        correction: Unavailable { reason: ExternalContractUnknown }
      })
  }
}
