module v2.std.orchestration_emit

import v2.std.compilers.target_model { TargetModel }
import v2.std.collection { Map }
import v2.std.diagnostic { Outcome }
import v2.std.node { Node, Symbol }
import v2.std.orchestration { Run }
import v2.std.text { String }

data orch_construct_run_rawline: Symbol = ^orch_construct_run_rawline
data orch_construct_run_env_prefixed: Symbol = ^orch_construct_run_env_prefixed
data orch_construct_run_env_unset: Symbol = ^orch_construct_run_env_unset
data orch_construct_seq2: Symbol = ^orch_construct_seq2
data orch_construct_retry: Symbol = ^orch_construct_retry
data orch_construct_retry_1level: Symbol = ^orch_construct_retry_1level
data orch_construct_retry_escalation_final: Symbol = ^orch_construct_retry_escalation_final
data orch_construct_retry_escalation_step: Symbol = ^orch_construct_retry_escalation_step
data orch_construct_if: Symbol = ^orch_construct_if
data orch_construct_if_else: Symbol = ^orch_construct_if_else
data orch_construct_if_block: Symbol = ^orch_construct_if_block
data orch_construct_if_else_block: Symbol = ^orch_construct_if_else_block
data orch_construct_while: Symbol = ^orch_construct_while
data orch_construct_procedure: Symbol = ^orch_construct_procedure
data orch_construct_call: Symbol = ^orch_construct_call
data orch_construct_cmdsubst_assign: Symbol = ^orch_construct_cmdsubst_assign
data orch_construct_let_assign: Symbol = ^orch_construct_let_assign

type OrchRunEmitPlan {
  construct_tag: Symbol
  target: TargetModel
}

// THE PREPARED EMIT PLAN. One row per (medium, construct), prepared once per production on the
// construct's first demand and carried for every later step and join that demands it again.
//
// Each field is a fact the per-call path was re-deriving from the medium's rows (DESIGN §6b chain
// re-derivation): the post-translate emitted row, the grammar relation row the serializer would
// otherwise re-select from the same rules by reverse-parsing the same program (the
// target_serialize_source_from_selected_row entry's own named second selection), and the
// translation-rules budget that measure walk re-counts. All three read only the row and the
// target's grammar facts -- never the payload spellings -- so the first call's target prepares
// what every later call consumes.
type OrchEmitPreparedRow {
  translated: Node
  selected_row: Node
  rules_budget: Int
}

// One prepared plan is scoped to a single medium/production: rows are keyed by the construct tag
// WITHIN that medium's registry, and the fold threads the plan through one orch_emit_pipeline
// call. A plan must never be reused across media (or across registries) -- a different medium's
// tag space would collide on these keys and hand one medium's grammar rows to another.
type OrchEmitPrepared {
  rows: Map<Symbol, OrchEmitPreparedRow>
}

// What an internal emitter hands back: the text it rendered and the plan it grew while doing so.
// The production fold threads `prepared`; a single-step caller starts from the empty plan and
// pays exactly what the unprepared path paid.
type OrchEmitCarried {
  text: String
  prepared: OrchEmitPrepared
}

type OrchestrationEmitMedium {
  authority: TargetModel
  realize_run_rawline: fn(String) -> TargetModel
  run_env_plan: fn(Run) -> OrchRunEmitPlan
  realize_seq2: fn(String, String) -> TargetModel
  realize_retry: fn(
    String,
    String,
    String,
    String,
    String,
    String,
    String,
    String
  ) -> TargetModel
  realize_retry_1level: fn(String, String, String, String, String) -> TargetModel
  realize_retry_escalation_final: fn(String, String) -> TargetModel
  realize_retry_escalation_step: fn(String, String, String, String, String) -> TargetModel
  realize_if: fn(String, String) -> Outcome<TargetModel>
  realize_if_else: fn(String, String, String) -> Outcome<TargetModel>
  realize_if_block: fn(String, String) -> Outcome<TargetModel>
  realize_if_else_block: fn(String, String, String) -> Outcome<TargetModel>
  realize_while: fn(String, String) -> Outcome<TargetModel>
  realize_procedure: fn(String, String) -> TargetModel
  realize_call: fn(String, String) -> TargetModel
  realize_cmdsubst_assign: fn(String, String) -> TargetModel
  realize_let_assign: fn(String, String) -> TargetModel
}
