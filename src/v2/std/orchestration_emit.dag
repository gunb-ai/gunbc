module v2.std.orchestration_emit


data orch_construct_run_rawline: v2.std.node.Symbol = ^orch_construct_run_rawline
data orch_construct_run_env_prefixed: v2.std.node.Symbol = ^orch_construct_run_env_prefixed
data orch_construct_run_env_unset: v2.std.node.Symbol = ^orch_construct_run_env_unset
data orch_construct_seq2: v2.std.node.Symbol = ^orch_construct_seq2
data orch_construct_retry: v2.std.node.Symbol = ^orch_construct_retry
data orch_construct_retry_1level: v2.std.node.Symbol = ^orch_construct_retry_1level
data orch_construct_retry_escalation_final: v2.std.node.Symbol = ^orch_construct_retry_escalation_final
data orch_construct_retry_escalation_step: v2.std.node.Symbol = ^orch_construct_retry_escalation_step
data orch_construct_if: v2.std.node.Symbol = ^orch_construct_if
data orch_construct_if_else: v2.std.node.Symbol = ^orch_construct_if_else
data orch_construct_if_block: v2.std.node.Symbol = ^orch_construct_if_block
data orch_construct_if_else_block: v2.std.node.Symbol = ^orch_construct_if_else_block
data orch_construct_while: v2.std.node.Symbol = ^orch_construct_while
data orch_construct_procedure: v2.std.node.Symbol = ^orch_construct_procedure
data orch_construct_call: v2.std.node.Symbol = ^orch_construct_call
data orch_construct_cmdsubst_assign: v2.std.node.Symbol = ^orch_construct_cmdsubst_assign
data orch_construct_let_assign: v2.std.node.Symbol = ^orch_construct_let_assign

type OrchRunEmitPlan {
  construct_tag: v2.std.node.Symbol
  target: v2.std.compilers.target_model.TargetModel
}

type OrchestrationEmitMedium {
  authority: v2.std.compilers.target_model.TargetModel
  realize_run_rawline: fn(String) -> TargetModel
  run_env_plan: fn(Run) -> OrchRunEmitPlan
  realize_seq2: fn(String, String) -> TargetModel
  realize_retry: fn(
    String,
    String,
    String,
    String,
    String,
    String,
    String,
    String
  ) -> TargetModel
  realize_retry_1level: fn(String, String, String, String, String) -> TargetModel
  realize_retry_escalation_final: fn(String, String) -> TargetModel
  realize_retry_escalation_step: fn(String, String, String, String, String) -> TargetModel
  realize_if: fn(String, String) -> Outcome<TargetModel>
  realize_if_else: fn(String, String, String) -> Outcome<TargetModel>
  realize_if_block: fn(String, String) -> Outcome<TargetModel>
  realize_if_else_block: fn(String, String, String) -> Outcome<TargetModel>
  realize_while: fn(String, String) -> Outcome<TargetModel>
  realize_procedure: fn(String, String) -> TargetModel
  realize_call: fn(String, String) -> TargetModel
  realize_cmdsubst_assign: fn(String, String) -> TargetModel
  realize_let_assign: fn(String, String) -> TargetModel
}
