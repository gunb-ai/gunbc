module v2.std.arrow_contract

import std.effects { EffectClaim, ReadonlyClaim, IdempotentClaim }
import std.execution_mode { ExecutionMode, Hermetic, Wet, Record }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.optional { Optional, Present, Absent, optional_present, optional_absent }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Found,
  Named,
  Node,
  Positional,
  Symbol,
  TypeNode,
  all_names_distinct,
  named_edge_target_lookup,
  symbol_intern_lexeme
}

// THE VOCABULARY OF AN ARROW'S CONTRACT EDGES (XL-2 PR2a; docs/plans/arrow-contract-edges.md).
// v2.std.node owns the edges' structure (at most one each, never a binder). This module checks their
// TARGETS against the vocabularies' homes: std.effects EffectClaim for ^arrow_effect_claims_edge and
// std.execution_mode ExecutionMode for ^arrow_execution_mode_claim_edge. Each label is the PROJECTION
// of one home variant, spelled once below as an exhaustive match, so a variant added to a home cannot
// be lowered or admitted without a spelling here. The spelling is the surface keyword the grammar
// admits (v2.extdeps.languages.dag dag_grammar_op_modifier_expr), so lowering and this check agree.

fn effect_claim_label(claim: EffectClaim) -> Symbol {
  match claim {
    ReadonlyClaim => symbol_intern_lexeme(lexeme: "readonly")
    IdempotentClaim => symbol_intern_lexeme(lexeme: "idempotent")
  }
}

// Only Hermetic is a claimable mode: `hermetic` declares that an operation is admissible on the
// hermetic route, and no surface spelling claims Wet or Record. The match is still exhaustive, so a
// mode added to std.execution_mode must be decided here, claimable or not.
fn execution_mode_claim_label(mode: ExecutionMode) -> Optional<Symbol> {
  match mode {
    Hermetic => optional_present(value: symbol_intern_lexeme(lexeme: "hermetic"))
    Wet => optional_absent()
    Record => optional_absent()
  }
}

fn arrow_contract_label_is(label: Symbol, projected: Optional<Symbol>) -> Bool {
  match projected {
    Present { value: l } => l == label
    Absent => false
  }
}

// THE INVERSE OF EACH PROJECTION, and the one place a home's variants are listed by hand: the language
// has no fold over a closed coproduct's constructors, so a label is read back by comparing it to each
// variant's projection. A variant missing here is refused, never admitted, so the residue fails closed.
// BOUNDED: two effect claims, three modes (only Hermetic projects to a label). OWNER: XL-2. TRIGGER: a language capability to enumerate a
// closed coproduct's constructors; this inverse is then derived from the projection and deleted.
fn effect_claim_of_label(label: Symbol) -> Optional<EffectClaim> {
  if label == effect_claim_label(claim: ReadonlyClaim) {
    optional_present(value: ReadonlyClaim)
  } else if label == effect_claim_label(claim: IdempotentClaim) {
    optional_present(value: IdempotentClaim)
  } else {
    optional_absent()
  }
}

fn execution_mode_of_claim_label(label: Symbol) -> Optional<ExecutionMode> {
  if arrow_contract_label_is(label: label, projected: execution_mode_claim_label(mode: Hermetic)) {
    optional_present(value: Hermetic)
  } else if arrow_contract_label_is(label: label, projected: execution_mode_claim_label(mode: Wet)) {
    optional_present(value: Wet)
  } else if arrow_contract_label_is(label: label, projected: execution_mode_claim_label(mode: Record)) {
    optional_present(value: Record)
  } else {
    optional_absent()
  }
}

fn arrow_contract_label_reads(read: Optional<EffectClaim>) -> Bool {
  match read {
    Present { value: _ } => true
    Absent => false
  }
}

fn arrow_contract_mode_reads(read: Optional<ExecutionMode>) -> Bool {
  match read {
    Present { value: _ } => true
    Absent => false
  }
}

// A self-named childless Atom: the Atom's identity is the label that reaches it.
fn arrow_contract_atom_is_self_named(label: Symbol, target: Node) -> Bool {
  match target.kind {
    TypeNode { connective: Atom { identity: id } } => (id == label) && (count(target.children) == 0)
    _ => false
  }
}

fn arrow_effect_claim_edge_conforms(e: Edge) -> Bool {
  match e.label {
    Positional => false
    Named { name: sym } => arrow_contract_label_reads(read: effect_claim_of_label(label: sym)) && arrow_contract_atom_is_self_named(label: sym, target: e.target)
  }
}

// The effect-claims target: a NONEMPTY Conj of self-named Atoms, each an EffectClaim's label, no claim
// twice. Nonempty because "no claims" has exactly one representation, the absent edge: an edge to an
// empty Conj would be a second identity for the same fact.
fn arrow_effect_claims_target_conforms(claims: Node) -> Bool {
  match claims.kind {
    TypeNode { connective: Conj } =>
      (count(claims.children) > 0)
        && all_names_distinct(children: claims.children)
        && fold(claims.children, init: true, f: fn(acc, c) { acc && arrow_effect_claim_edge_conforms(e: c) })
    _ => false
  }
}

// The execution-mode target: one childless Atom whose identity is an ExecutionMode's label.
fn arrow_execution_mode_claim_target_conforms(mode: Node) -> Bool {
  match mode.kind {
    TypeNode { connective: Atom { identity: id } } => arrow_contract_mode_reads(read: execution_mode_of_claim_label(label: id)) && (count(mode.children) == 0)
    _ => false
  }
}

// Every contract edge an Arrow carries reads in its home vocabulary. How many of each it may carry is
// v2.std.node arrow_signature_edges_conform's fact; a second edge refuses there.
fn arrow_contract_conforms(children: List<Edge>) -> Bool {
  arrow_effect_claims_edge_target_reads(children: children) && arrow_execution_mode_edge_target_reads(children: children)
}

fn arrow_effect_claims_edge_target_reads(children: List<Edge>) -> Bool {
  match named_edge_target_lookup(children: children, name: ^arrow_effect_claims_edge) {
    Found { target: claims } => arrow_effect_claims_target_conforms(claims: claims)
    _ => true
  }
}

fn arrow_execution_mode_edge_target_reads(children: List<Edge>) -> Bool {
  match named_edge_target_lookup(children: children, name: ^arrow_execution_mode_claim_edge) {
    Found { target: mode } => arrow_execution_mode_claim_target_conforms(mode: mode)
    _ => true
  }
}
