module v2.std.bounded_lattice_completeness


type BlNamedChildLookup
  = BlNamedChildFound { target: v2.std.node.Node }
  | BlNamedChildMissing
  | BlNamedChildAmbiguous

fn bl_named_child_lookup(root: v2.std.node.Node, name: v2.std.node.Symbol) -> v2.std.bounded_lattice_completeness.BlNamedChildLookup {
  match find_named_child(root: root, name: name) {
    Accepted { value: target, diagnostics: _ } => BlNamedChildFound { target: target }
    Rejected { diagnostics: d } =>
      if d.head.reason == ^named_child_missing {
        BlNamedChildMissing
      } else if d.head.reason == ^named_child_ambiguous {
        BlNamedChildAmbiguous
      } else {
        BlNamedChildMissing
      }
  }
}

fn bounded_lattice_lattice_field_completeness(lattice: v2.std.node.Node) -> v2.std.algebra.BoundedLatticeInstanceCompleteness {
  match bl_named_child_lookup(root: lattice, name: ^lattice_field_meet) {
    BlNamedChildMissing => v2.std.algebra.BoundedLatticePartial { missing: MissingMeet }
    BlNamedChildAmbiguous => v2.std.algebra.BoundedLatticePartial { missing: MissingMeet }
    BlNamedChildFound { target: _ } =>
      match bl_named_child_lookup(root: lattice, name: ^lattice_field_join) {
        BlNamedChildMissing => v2.std.algebra.BoundedLatticePartial { missing: MissingJoin }
        BlNamedChildAmbiguous => v2.std.algebra.BoundedLatticePartial { missing: MissingJoin }
        BlNamedChildFound { target: _ } => BoundedLatticeComplete
      }
  }
}

fn bounded_lattice_instance_completeness(instance: v2.std.node.Node) -> v2.std.algebra.BoundedLatticeInstanceCompleteness {
  match bl_named_child_lookup(root: instance, name: ^bounded_lattice_field_top) {
    BlNamedChildFound { target: _ } =>
      match bl_named_child_lookup(root: instance, name: ^bounded_lattice_field_bottom) {
        BlNamedChildFound { target: _ } =>
          match bl_named_child_lookup(root: instance, name: ^bounded_lattice_field_lattice) {
            BlNamedChildFound { target: lattice } =>
              bounded_lattice_lattice_field_completeness(lattice: lattice)
            BlNamedChildMissing => v2.std.algebra.BoundedLatticePartial { missing: MissingLatticeField }
            BlNamedChildAmbiguous => v2.std.algebra.BoundedLatticePartial { missing: MissingLatticeField }
          }
        BlNamedChildMissing => NotBoundedLatticeInstance
        BlNamedChildAmbiguous => NotBoundedLatticeInstance
      }
    BlNamedChildMissing => NotBoundedLatticeInstance
    BlNamedChildAmbiguous => NotBoundedLatticeInstance
  }
}

fn infer_bounded_lattice_partial_instance_diagnostic(
  at: v2.std.diagnostic.Locus,
  missing: v2.std.algebra.BoundedLatticeMissingWitness,
) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: discriminant(v: missing),
    at: at,
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn infer_bounded_lattice_consumer_partial_diagnostic(
  consumer: v2.std.node.Node,
  instance: v2.std.node.Node,
) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^infer_bounded_lattice_consumer_partial,
    at: node_locus(node: consumer),
    correction: v2.std.diagnostic.Suggested { node: instance }
  }
}

fn infer_bounded_lattice_completeness_rejects(
  instance: v2.std.node.Node,
  completeness: v2.std.algebra.BoundedLatticeInstanceCompleteness,
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match completeness {
    NotBoundedLatticeInstance =>
      v2.std.diagnostic.Accepted { value: instance, diagnostics: v2.std.diagnostic.None }
    BoundedLatticeComplete =>
      v2.std.diagnostic.Accepted { value: instance, diagnostics: v2.std.diagnostic.None }
    BoundedLatticePartial { missing: m } =>
      outcome_rejected(
        infer_bounded_lattice_partial_instance_diagnostic(
          at: node_locus(node: instance),
          missing: m
        )
      )
  }
}

fn infer_bounded_lattice_instance_gate(instance: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  infer_bounded_lattice_completeness_rejects(
    instance: instance,
    completeness: bounded_lattice_instance_completeness(instance: instance)
  )
}

fn infer_edge_consumes_bounded_lattice_partial(edge: v2.std.node.Edge, partials: List<v2.std.node.Node>) -> Bool {
  if any(xs: partials, predicate: fn(p) { edge.target == p }) {
    match edge.label {
      Named { name: sym } =>
        sym == ^algebra_edge
          || sym == ^inhabitant_edge
          || sym == ^lattice_field_meet
          || sym == ^lattice_field_join
          || sym == ^boolean_algebra_field_bounded_lattice
      Positional => false
    }
  } else {
    false
  }
}

fn infer_bounded_lattice_consumer_gate(
  consumer: v2.std.node.Node,
  partials: List<v2.std.node.Node>,
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match fold(consumer.children, init: outcome_accepted(value: consumer), f: fn(acc, e) {
    match acc {
      Rejected { diagnostics: r } =>
        if infer_edge_consumes_bounded_lattice_partial(edge: e, partials: partials) {
          v2.std.diagnostic.Rejected {
            diagnostics: non_empty_diagnostics_append(
              a: r,
              b: diagnostics_singleton(
                d: infer_bounded_lattice_consumer_partial_diagnostic(
                  consumer: consumer,
                  instance: e.target
                )
              )
            )
          }
        } else {
          v2.std.diagnostic.Rejected { diagnostics: r }
        }
      Accepted { value: _, diagnostics: d } =>
        if infer_edge_consumes_bounded_lattice_partial(edge: e, partials: partials) {
          outcome_rejected(
            infer_bounded_lattice_consumer_partial_diagnostic(
              consumer: consumer,
              instance: e.target
            )
          )
        } else {
          v2.std.diagnostic.Accepted { value: consumer, diagnostics: d }
        }
    }
  }) {
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
    Accepted { value: _, diagnostics: d } =>
      v2.std.diagnostic.Accepted { value: consumer, diagnostics: d }
  }
}

fn partial_bounded_lattice_instances_in_tree(tree: v2.std.node.Node) -> v2.std.collection.List<v2.std.node.Node> {
  fold_node(
    n: tree,
    algebra: v2.std.node.NodeFold {
      init: fn(n0) {
        match bounded_lattice_instance_completeness(instance: n0) {
          BoundedLatticePartial { missing: _ } => [n0]
          NotBoundedLatticeInstance => []
          BoundedLatticeComplete => []
        }
      },
      step: fn(acc, e, child) {
        fold_list_right(
          xs: child,
          empty: acc,
          snoc: fn(a, p) {
            list_snoc_item(xs: a, item: p)
          }
        )
      }
    }
  )
}
