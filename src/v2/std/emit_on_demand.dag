module v2.std.emit_on_demand


data emit_on_demand_scheduling_note: String = "Compiler-layer scheduling over the dag/std emit-on-demand artifact-store surface. witness_family_realize_width reads spine independence from a witness root and qualifies realize_pack width — lives here (not dag/std) so dag/std stays agnostic of v2.std.*."

fn witness_family_realize_width(
  bound_bytes: std.measure.ByteSize,
  budget: std.realize_pack.HostBudget,
  witness_root: v2.std.node.Node,
  independence_override: v2.std.integer.Int
) -> std.realize_pack.RealizeVerdict {
  let independence = if independence_override > 0 {
    independence_override
  } else {
    spine_receipt(root: witness_root).independence_width
  }
  std.realize_pack.realize_pack_width(
    bound: std.realize_pack.BoundDerived { bytes: bound_bytes },
    budget: budget,
    independence_width: independence
  )
}
