module v2.std.inhabitant_neutralization


fn inhabitant_neutralization_std_projection_missing_diagnostic(node: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^inhabitant_neutralization_std_projection_missing,
    at: v2.std.diagnostic.node_locus(node: node),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn inhabitant_neutralization_type_atom_missing_diagnostic(node: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^inhabitant_neutralization_type_atom_missing,
    at: v2.std.diagnostic.node_locus(node: node),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn inhabitant_neutralization_surface_spelling_missing_diagnostic(node: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^inhabitant_neutralization_surface_spelling_missing,
    at: v2.std.diagnostic.node_locus(node: node),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn inhabitant_neutralization_no_target_diagnostic(
  std_projection: v2.std.node.Symbol
) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^inhabitant_neutralization_no_target_inhabitant,
    at: v2.std.diagnostic.Textual { file: std_projection, extent: v2.std.diagnostic.WholeFile },
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn inhabitant_neutralization_ambiguous_target_diagnostic(
  std_projection: v2.std.node.Symbol
) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^inhabitant_neutralization_ambiguous_target_inhabitant,
    at: v2.std.diagnostic.Textual { file: std_projection, extent: v2.std.diagnostic.WholeFile },
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn inhabitant_facts_node_from_inhabitant(inhabitant: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  fold(
    v2.std.node_query.node_labeled_child_edges(node: inhabitant),
    init: v2.std.diagnostic.outcome_rejected(
      inhabitant_neutralization_std_projection_missing_diagnostic(node: inhabitant)
    ),
    f: fn(acc, edge) {
      match acc {
        Accepted { value: _, diagnostics: _ } => acc
        Rejected { diagnostics: _ } =>
          match v2.std.node_query.find_named_child(root: edge.target, name: ^facts_field_std_projection) {
            Accepted { value: _, diagnostics: _ } =>
              v2.std.diagnostic.Accepted { value: edge.target, diagnostics: v2.std.diagnostic.None }
            Rejected { diagnostics: _ } => acc
          }
      }
    }
  )
}

fn inhabitant_std_projection_symbol(inhabitant: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Symbol> {
  v2.std.diagnostic.bind_outcome(
    o: inhabitant_facts_node_from_inhabitant(inhabitant: inhabitant),
    f: fn(facts) {
      v2.std.diagnostic.bind_outcome(
        o: v2.std.node_query.find_named_child(root: facts, name: ^facts_field_std_projection),
        f: fn(atom_node) {
          match v2.std.grammar.node_atom_identity_optional(node: atom_node) {
            Present { value: sym } =>
              v2.std.diagnostic.Accepted { value: sym, diagnostics: v2.std.diagnostic.None }
            v2.std.optional.Absent =>
              v2.std.diagnostic.outcome_rejected(
                inhabitant_neutralization_std_projection_missing_diagnostic(node: inhabitant)
              )
          }
        }
      )
    }
  )
}

fn inhabitant_type_atom_symbol(inhabitant: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Symbol> {
  match v2.std.node_query.find_named_child(root: inhabitant, name: ^inhabitant_field_atom) {
    Accepted { value: atom_node, diagnostics: _ } =>
      match v2.std.grammar.node_atom_identity_optional(node: atom_node) {
        Present { value: sym } =>
          v2.std.diagnostic.Accepted { value: sym, diagnostics: v2.std.diagnostic.None }
        v2.std.optional.Absent =>
          v2.std.diagnostic.outcome_rejected(
            inhabitant_neutralization_type_atom_missing_diagnostic(node: inhabitant)
          )
      }
    Rejected { diagnostics: _ } =>
      v2.std.diagnostic.outcome_rejected(
        inhabitant_neutralization_type_atom_missing_diagnostic(node: inhabitant)
      )
  }
}

fn inhabitant_surface_spelling_symbol(inhabitant: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Symbol> {
  v2.std.diagnostic.bind_outcome(
    o: inhabitant_facts_node_from_inhabitant(inhabitant: inhabitant),
    f: fn(facts) {
      match v2.std.node_query.find_named_child(root: facts, name: ^facts_field_surface_spelling) {
        Accepted { value: atom_node, diagnostics: _ } =>
          match v2.std.grammar.node_atom_identity_optional(node: atom_node) {
            Present { value: sym } =>
              v2.std.diagnostic.Accepted { value: sym, diagnostics: v2.std.diagnostic.None }
            v2.std.optional.Absent =>
              v2.std.diagnostic.outcome_rejected(
                inhabitant_neutralization_surface_spelling_missing_diagnostic(
                  node: inhabitant
                )
              )
          }
        Rejected { diagnostics: _ } =>
          v2.std.diagnostic.outcome_rejected(
            inhabitant_neutralization_surface_spelling_missing_diagnostic(node: inhabitant)
          )
      }
    }
  )
}

fn inhabitant_width_node(inhabitant: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: inhabitant_facts_node_from_inhabitant(inhabitant: inhabitant),
    f: fn(facts) {
      v2.std.node_query.find_named_child(root: facts, name: ^facts_field_width)
    }
  )
}

fn inhabitant_aligns_with_selection_policy(candidate: v2.std.node.Node, selection: v2.std.node.Node) -> Bool {
  match inhabitant_type_atom_symbol(inhabitant: candidate) {
    Accepted { value: candidate_atom, diagnostics: _ } =>
      match inhabitant_type_atom_symbol(inhabitant: selection) {
        Accepted { value: selection_atom, diagnostics: _ } =>
          if candidate_atom != selection_atom {
            false
          } else {
            match inhabitant_surface_spelling_symbol(inhabitant: candidate) {
              Accepted { value: candidate_spelling, diagnostics: _ } =>
                match inhabitant_surface_spelling_symbol(inhabitant: selection) {
                  Accepted { value: selection_spelling, diagnostics: _ } =>
                    if candidate_spelling != selection_spelling {
                      false
                    } else {
                      match inhabitant_width_node(inhabitant: candidate) {
                        Accepted { value: candidate_width, diagnostics: _ } =>
                          match inhabitant_width_node(inhabitant: selection) {
                            Accepted { value: selection_width, diagnostics: _ } =>
                              candidate_width == selection_width
                            Rejected { diagnostics: _ } => false
                          }
                        Rejected { diagnostics: _ } => false
                      }
                    }
                  Rejected { diagnostics: _ } => false
                }
              Rejected { diagnostics: _ } => false
            }
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn target_inhabitant_selection_policy_fold_step(
  acc: v2.std.passing_candidate_fold.PassingCandidateFold<v2.std.node.Node>,
  candidate: v2.std.node.Node,
  std_projection: v2.std.node.Symbol,
  selection_policy: v2.std.node.Node
) -> v2.std.passing_candidate_fold.PassingCandidateFold<v2.std.node.Node> {
  match inhabitant_std_projection_symbol(inhabitant: candidate) {
    Accepted { value: proj, diagnostics: _ } =>
      if (proj == std_projection)
        && inhabitant_aligns_with_selection_policy(
          candidate: candidate,
          selection: selection_policy
        ) {
        match acc {
          v2.std.passing_candidate_fold.NoPassingCandidate => v2.std.passing_candidate_fold.OnePassingCandidate { candidate: candidate }
          OnePassingCandidate { candidate: _ } => v2.std.passing_candidate_fold.ManyPassingCandidates
          v2.std.passing_candidate_fold.ManyPassingCandidates => v2.std.passing_candidate_fold.ManyPassingCandidates
        }
      } else {
        acc
      }
    Rejected { diagnostics: _ } => acc
  }
}

fn target_inhabitant_for_std_projection_with_selection_policy(
  std_projection: v2.std.node.Symbol,
  inhabitants_root: v2.std.node.Node,
  selection_policy: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  let fold_result = fold(
    inhabitants_root.children,
    init: v2.std.passing_candidate_fold.NoPassingCandidate,
    f: fn(acc, edge) {
      target_inhabitant_selection_policy_fold_step(
        acc: acc,
        candidate: edge.target,
        std_projection: std_projection,
        selection_policy: selection_policy
      )
    }
  )
  match fold_result {
    v2.std.passing_candidate_fold.NoPassingCandidate =>
      v2.std.diagnostic.outcome_rejected(
        inhabitant_neutralization_no_target_diagnostic(std_projection: std_projection)
      )
    OnePassingCandidate { candidate: c } =>
      v2.std.diagnostic.Accepted { value: c, diagnostics: v2.std.diagnostic.None }
    v2.std.passing_candidate_fold.ManyPassingCandidates =>
      v2.std.diagnostic.outcome_rejected(
        inhabitant_neutralization_ambiguous_target_diagnostic(
          std_projection: std_projection
        )
      )
  }
}

fn target_inhabitant_fold_step(
  acc: v2.std.passing_candidate_fold.PassingCandidateFold<v2.std.node.Node>,
  candidate: v2.std.node.Node,
  std_projection: v2.std.node.Symbol
) -> v2.std.passing_candidate_fold.PassingCandidateFold<v2.std.node.Node> {
  match inhabitant_std_projection_symbol(inhabitant: candidate) {
    Accepted { value: proj, diagnostics: _ } =>
      if proj == std_projection {
        match acc {
          v2.std.passing_candidate_fold.NoPassingCandidate => v2.std.passing_candidate_fold.OnePassingCandidate { candidate: candidate }
          OnePassingCandidate { candidate: _ } => v2.std.passing_candidate_fold.ManyPassingCandidates
          v2.std.passing_candidate_fold.ManyPassingCandidates => v2.std.passing_candidate_fold.ManyPassingCandidates
        }
      } else {
        acc
      }
    Rejected { diagnostics: _ } => acc
  }
}

fn target_inhabitant_for_std_projection(
  std_projection: v2.std.node.Symbol,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: v2.std.node_query.find_named_child(root: target.bundle, name: ^target_model_edge_declared_inhabitants),
    f: fn(inhabitants_root) {
      let fold_result = fold(
        inhabitants_root.children,
        init: v2.std.passing_candidate_fold.NoPassingCandidate,
        f: fn(acc, edge) {
          target_inhabitant_fold_step(
            acc: acc,
            candidate: edge.target,
            std_projection: std_projection
          )
        }
      )
      match fold_result {
        v2.std.passing_candidate_fold.NoPassingCandidate =>
          v2.std.diagnostic.outcome_rejected(
            inhabitant_neutralization_no_target_diagnostic(
              std_projection: std_projection
            )
          )
        OnePassingCandidate { candidate: c } =>
          v2.std.diagnostic.Accepted { value: c, diagnostics: v2.std.diagnostic.None }
        v2.std.passing_candidate_fold.ManyPassingCandidates =>
          v2.std.diagnostic.bind_outcome(
            o: v2.std.node_query.find_named_child(
              root: target.bundle,
              name: ^target_model_edge_selection_policy
            ),
            f: fn(selection_policy) {
              target_inhabitant_for_std_projection_with_selection_policy(
                std_projection: std_projection,
                inhabitants_root: inhabitants_root,
                selection_policy: selection_policy
              )
            }
          )
      }
    }
  )
}

fn neutralize_inhabitant_node(
  inhabitant: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: inhabitant_std_projection_symbol(inhabitant: inhabitant),
    f: fn(proj) {
      target_inhabitant_for_std_projection(std_projection: proj, target: target)
    }
  )
}

fn neutralize_edges_for_target(
  edges: List<v2.std.node.Edge>,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<List<v2.std.node.Edge>> {
  fold(
    edges,
    init: v2.std.diagnostic.Accepted { value: std.algebra.Empty, diagnostics: v2.std.diagnostic.None },
    f: fn(acc, edge) {
      match acc {
        Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
        Accepted { value: rebuilt_edges, diagnostics: ad } =>
          v2.std.diagnostic.bind_outcome(
            o: neutralize_node_for_target(node: edge.target, target: target),
            f: fn(neutralized_target) {
              v2.std.diagnostic.Accepted {
                value: v2.std.algebra.list_snoc_item(
                  xs: rebuilt_edges,
                  item: v2.std.node.Edge { label: edge.label, target: neutralized_target }
                ),
                diagnostics: ad
              }
            }
          )
      }
    }
  )
}

fn neutralize_node_for_target(
  node: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match inhabitant_facts_node_from_inhabitant(inhabitant: node) {
    Accepted { value: _, diagnostics: _ } =>
      neutralize_inhabitant_node(inhabitant: node, target: target)
    Rejected { diagnostics: _ } =>
      v2.std.diagnostic.bind_outcome(
        o: neutralize_edges_for_target(edges: node.children, target: target),
        f: fn(children) {
          v2.std.diagnostic.Accepted {
            value: v2.std.node.node_rebuild(n: node, children: children),
            diagnostics: v2.std.diagnostic.None
          }
        }
      )
  }
}

fn neutralize_core_for_target(
  core: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  neutralize_node_for_target(node: core, target: target)
}
