module v2.std.inhabitant_neutralization

import v2.std.algebra { Empty, list_snoc_item }
import v2.std.collection { List }
import v2.std.collection { Absent, Present }
import v2.std.compilers.target_model {
  TargetModel,
}
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  Diagnostics,
  ExternalContractUnknown,
  Outcome,
  Rejected,
  Textual,
  Unavailable,
  WholeFile,
  bind_outcome,
  node_locus,
  outcome_rejected
}
import v2.std.grammar { node_atom_identity_optional }
import v2.std.node {
  Edge,
  Node,
  Symbol,
  node_rebuild
}
import v2.std.node_query { find_named_child, node_labeled_child_edges }
import v2.std.passing_candidate_fold {
  ManyPassingCandidates,
  NoPassingCandidate,
  OnePassingCandidate,
  PassingCandidateFold
}

fn inhabitant_neutralization_std_projection_missing_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: ^inhabitant_neutralization_std_projection_missing,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn inhabitant_neutralization_type_atom_missing_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: ^inhabitant_neutralization_type_atom_missing,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn inhabitant_neutralization_surface_spelling_missing_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: ^inhabitant_neutralization_surface_spelling_missing,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn inhabitant_neutralization_no_target_diagnostic(
  std_projection: Symbol
) -> Diagnostic {
  Diagnostic {
    reason: ^inhabitant_neutralization_no_target_inhabitant,
    at: Textual { file: std_projection, extent: WholeFile },
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn inhabitant_neutralization_ambiguous_target_diagnostic(
  std_projection: Symbol
) -> Diagnostic {
  Diagnostic {
    reason: ^inhabitant_neutralization_ambiguous_target_inhabitant,
    at: Textual { file: std_projection, extent: WholeFile },
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn inhabitant_facts_node_from_inhabitant(inhabitant: Node) -> Outcome<Node> {
  fold(
    node_labeled_child_edges(node: inhabitant),
    init: outcome_rejected(
      inhabitant_neutralization_std_projection_missing_diagnostic(node: inhabitant)
    ),
    f: fn(acc, edge) {
      match acc {
        Accepted { value: _, diagnostics: _ } => acc
        Rejected { diagnostics: _ } =>
          match find_named_child(root: edge.target, name: ^facts_field_std_projection) {
            Accepted { value: _, diagnostics: _ } =>
              Accepted { value: edge.target, diagnostics: None }
            Rejected { diagnostics: _ } => acc
          }
      }
    }
  )
}

fn inhabitant_std_projection_symbol(inhabitant: Node) -> Outcome<Symbol> {
  bind_outcome(
    o: inhabitant_facts_node_from_inhabitant(inhabitant: inhabitant),
    f: fn(facts) {
      bind_outcome(
        o: find_named_child(root: facts, name: ^facts_field_std_projection),
        f: fn(atom_node) {
          match node_atom_identity_optional(node: atom_node) {
            Present { value: sym } =>
              Accepted { value: sym, diagnostics: None }
            Absent =>
              outcome_rejected(
                inhabitant_neutralization_std_projection_missing_diagnostic(node: inhabitant)
              )
          }
        }
      )
    }
  )
}

fn inhabitant_type_atom_symbol(inhabitant: Node) -> Outcome<Symbol> {
  match find_named_child(root: inhabitant, name: ^inhabitant_field_atom) {
    Accepted { value: atom_node, diagnostics: _ } =>
      match node_atom_identity_optional(node: atom_node) {
        Present { value: sym } =>
          Accepted { value: sym, diagnostics: None }
        Absent =>
          outcome_rejected(
            inhabitant_neutralization_type_atom_missing_diagnostic(node: inhabitant)
          )
      }
    Rejected { diagnostics: _ } =>
      outcome_rejected(
        inhabitant_neutralization_type_atom_missing_diagnostic(node: inhabitant)
      )
  }
}

fn inhabitant_surface_spelling_symbol(inhabitant: Node) -> Outcome<Symbol> {
  bind_outcome(
    o: inhabitant_facts_node_from_inhabitant(inhabitant: inhabitant),
    f: fn(facts) {
      match find_named_child(root: facts, name: ^facts_field_surface_spelling) {
        Accepted { value: atom_node, diagnostics: _ } =>
          match node_atom_identity_optional(node: atom_node) {
            Present { value: sym } =>
              Accepted { value: sym, diagnostics: None }
            Absent =>
              outcome_rejected(
                inhabitant_neutralization_surface_spelling_missing_diagnostic(
                  node: inhabitant
                )
              )
          }
        Rejected { diagnostics: _ } =>
          outcome_rejected(
            inhabitant_neutralization_surface_spelling_missing_diagnostic(node: inhabitant)
          )
      }
    }
  )
}

fn inhabitant_width_node(inhabitant: Node) -> Outcome<Node> {
  bind_outcome(
    o: inhabitant_facts_node_from_inhabitant(inhabitant: inhabitant),
    f: fn(facts) {
      find_named_child(root: facts, name: ^facts_field_width)
    }
  )
}

fn inhabitant_aligns_with_selection_policy(candidate: Node, selection: Node) -> Bool {
  match inhabitant_type_atom_symbol(inhabitant: candidate) {
    Accepted { value: candidate_atom, diagnostics: _ } =>
      match inhabitant_type_atom_symbol(inhabitant: selection) {
        Accepted { value: selection_atom, diagnostics: _ } =>
          if candidate_atom != selection_atom {
            false
          } else {
            match inhabitant_surface_spelling_symbol(inhabitant: candidate) {
              Accepted { value: candidate_spelling, diagnostics: _ } =>
                match inhabitant_surface_spelling_symbol(inhabitant: selection) {
                  Accepted { value: selection_spelling, diagnostics: _ } =>
                    if candidate_spelling != selection_spelling {
                      false
                    } else {
                      match inhabitant_width_node(inhabitant: candidate) {
                        Accepted { value: candidate_width, diagnostics: _ } =>
                          match inhabitant_width_node(inhabitant: selection) {
                            Accepted { value: selection_width, diagnostics: _ } =>
                              candidate_width == selection_width
                            Rejected { diagnostics: _ } => false
                          }
                        Rejected { diagnostics: _ } => false
                      }
                    }
                  Rejected { diagnostics: _ } => false
                }
              Rejected { diagnostics: _ } => false
            }
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn target_inhabitant_selection_policy_fold_step(
  acc: PassingCandidateFold,
  candidate: Node,
  std_projection: Symbol,
  selection_policy: Node
) -> PassingCandidateFold {
  match inhabitant_std_projection_symbol(inhabitant: candidate) {
    Accepted { value: proj, diagnostics: _ } =>
      if (proj == std_projection)
        && inhabitant_aligns_with_selection_policy(
          candidate: candidate,
          selection: selection_policy
        ) {
        match acc {
          NoPassingCandidate => OnePassingCandidate { candidate: candidate }
          OnePassingCandidate { candidate: _ } => ManyPassingCandidates
          ManyPassingCandidates => ManyPassingCandidates
        }
      } else {
        acc
      }
    Rejected { diagnostics: _ } => acc
  }
}

fn target_inhabitant_for_std_projection_with_selection_policy(
  std_projection: Symbol,
  inhabitants_root: Node,
  selection_policy: Node
) -> Outcome<Node> {
  let fold_result = fold(
    inhabitants_root.children,
    init: NoPassingCandidate,
    f: fn(acc, edge) {
      target_inhabitant_selection_policy_fold_step(
        acc: acc,
        candidate: edge.target,
        std_projection: std_projection,
        selection_policy: selection_policy
      )
    }
  )
  match fold_result {
    NoPassingCandidate =>
      outcome_rejected(
        inhabitant_neutralization_no_target_diagnostic(std_projection: std_projection)
      )
    OnePassingCandidate { candidate: c } =>
      Accepted { value: c, diagnostics: None }
    ManyPassingCandidates =>
      outcome_rejected(
        inhabitant_neutralization_ambiguous_target_diagnostic(
          std_projection: std_projection
        )
      )
  }
}

fn target_inhabitant_fold_step(
  acc: PassingCandidateFold,
  candidate: Node,
  std_projection: Symbol
) -> PassingCandidateFold {
  match inhabitant_std_projection_symbol(inhabitant: candidate) {
    Accepted { value: proj, diagnostics: _ } =>
      if proj == std_projection {
        match acc {
          NoPassingCandidate => OnePassingCandidate { candidate: candidate }
          OnePassingCandidate { candidate: _ } => ManyPassingCandidates
          ManyPassingCandidates => ManyPassingCandidates
        }
      } else {
        acc
      }
    Rejected { diagnostics: _ } => acc
  }
}

fn target_inhabitant_for_std_projection(
  std_projection: Symbol,
  target: TargetModel
) -> Outcome<Node> {
  bind_outcome(
    o: find_named_child(root: target.bundle, name: ^target_model_edge_declared_inhabitants),
    f: fn(inhabitants_root) {
      let fold_result = fold(
        inhabitants_root.children,
        init: NoPassingCandidate,
        f: fn(acc, edge) {
          target_inhabitant_fold_step(
            acc: acc,
            candidate: edge.target,
            std_projection: std_projection
          )
        }
      )
      match fold_result {
        NoPassingCandidate =>
          outcome_rejected(
            inhabitant_neutralization_no_target_diagnostic(
              std_projection: std_projection
            )
          )
        OnePassingCandidate { candidate: c } =>
          Accepted { value: c, diagnostics: None }
        ManyPassingCandidates =>
          bind_outcome(
            o: find_named_child(
              root: target.bundle,
              name: ^target_model_edge_selection_policy
            ),
            f: fn(selection_policy) {
              target_inhabitant_for_std_projection_with_selection_policy(
                std_projection: std_projection,
                inhabitants_root: inhabitants_root,
                selection_policy: selection_policy
              )
            }
          )
      }
    }
  )
}

fn neutralize_inhabitant_node(
  inhabitant: Node,
  target: TargetModel
) -> Outcome<Node> {
  bind_outcome(
    o: inhabitant_std_projection_symbol(inhabitant: inhabitant),
    f: fn(proj) {
      target_inhabitant_for_std_projection(std_projection: proj, target: target)
    }
  )
}

fn neutralize_edges_for_target(
  edges: List<Edge>,
  target: TargetModel
) -> Outcome<List<Edge>> {
  fold(
    edges,
    init: Accepted { value: Empty, diagnostics: None },
    f: fn(acc, edge) {
      match acc {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: rebuilt_edges, diagnostics: ad } =>
          bind_outcome(
            o: neutralize_node_for_target(node: edge.target, target: target),
            f: fn(neutralized_target) {
              Accepted {
                value: list_snoc_item(
                  xs: rebuilt_edges,
                  item: Edge { label: edge.label, target: neutralized_target }
                ),
                diagnostics: ad
              }
            }
          )
      }
    }
  )
}

fn neutralize_node_for_target(
  node: Node,
  target: TargetModel
) -> Outcome<Node> {
  match inhabitant_facts_node_from_inhabitant(inhabitant: node) {
    Accepted { value: _, diagnostics: _ } =>
      neutralize_inhabitant_node(inhabitant: node, target: target)
    Rejected { diagnostics: _ } =>
      bind_outcome(
        o: neutralize_edges_for_target(edges: node.children, target: target),
        f: fn(children) {
          Accepted {
            value: node_rebuild(n: node, children: children),
            diagnostics: None
          }
        }
      )
  }
}

fn neutralize_core_for_target(
  core: Node,
  target: TargetModel
) -> Outcome<Node> {
  neutralize_node_for_target(node: core, target: target)
}
