fn approximate_field_type_node(inhabitant: Node) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      v2.std.node.Edge {
        label: Named { name: ^approximate_field_field_add },
        target: algebra_binary_fn_node(domain: inhabitant, codomain: inhabitant)
      },
      v2.std.node.Edge { label: Named { name: ^approximate_field_field_zero }, target: inhabitant },
      v2.std.node.Edge {
        label: Named { name: ^approximate_field_field_negate },
        target: algebra_unary_fn_node(domain: inhabitant, codomain: inhabitant)
      },
      v2.std.node.Edge {
        label: Named { name: ^approximate_field_field_mul },
        target: algebra_binary_fn_node(domain: inhabitant, codomain: inhabitant)
      },
      v2.std.node.Edge { label: Named { name: ^approximate_field_field_one }, target: inhabitant },
      v2.std.node.Edge {
        label: Named { name: ^approximate_field_field_compare },
        target: algebra_binary_fn_node(domain: inhabitant, codomain: ordering_type_node())
      },
    ],
    occurrence_id: SyntheticOccurrence
}
}

