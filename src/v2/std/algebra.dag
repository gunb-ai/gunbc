}
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type FreeMonoid<T>
  = Empty
  | Cons { head: T, tail: FreeMonoid<T> }
fn freemonoid_empty<T>() -> FreeMonoid<T> {
  Empty
}
type FreeMonoidUniqueState<T> {
  seen: FreeMonoid<T>
  unique: Bool
}
// Left fold: traverse head→tail, thread accumulator forward. Combinator order is `cons(acc, head)`.
// The naive list-rebuild combinator `fn(acc, h) { Cons { head: h, tail: acc } }` REVERSES input
// (head is prepended at each step but visited first). Use fold_list_right for order-preserving
// list-shaped output, or this fold with an explicit reverse pass for the same effect.
fn fold_list<T, A>(xs: FreeMonoid<T>, empty: A, cons: fn(A, T) -> A) -> A {
  match xs {
    Empty => empty
    Cons { head: h, tail: t } => fold_list(xs: t, empty: cons(empty, h), cons: cons)
  }
}
fn fold_non_empty<T>(head: T, tail: FreeMonoid<T>, cons: fn(T, T) -> T) -> T {
  fold_list(xs: tail, empty: head, cons: cons)
}
// Right fold: recurse to tail first, then combine. Combinator order is `snoc(tail_result, head)`.
// With `fn(acc, h) { Cons { head: h, tail: acc } }` the result PRESERVES input order — head is
// prepended last, after the tail has been rebuilt. Not tail-recursive; depth is O(|xs|).
fn fold_list_right<T, A>(xs: FreeMonoid<T>, empty: A, snoc: fn(A, T) -> A) -> A {
  match xs {
    Empty => empty
    Cons { head: h, tail: t } => snoc(fold_list_right(xs: t, empty: empty, snoc: snoc), h)
  }
}
// 🟡 coproduct dissolution — feature: FreeMonoid substrate tail<T> accessor; dissolves when stdlib provides substrate-derived tail projection returning Option<FreeMonoid<T>> directly, eliminating the per-use carrier type.
type ListTailResult<T>
  = TailFound { tail: FreeMonoid<T> }
  | TailAbsent

fn list_tail<T>(xs: FreeMonoid<T>) -> ListTailResult<T> {
  match xs {
    Empty => TailAbsent
    Cons { head: _, tail: t } => TailFound { tail: t }
  }
}
// 🟢 coproduct dissolution — feature: FreeMonoid substrate head<T> accessor; dissolves when stdlib provides substrate-derived head projection returning Option<T> directly, eliminating the per-use carrier type.
type ListHeadResult<T>
  = HeadFound { value: T }
  | HeadAbsent

fn first<T>(xs: FreeMonoid<T>) -> ListHeadResult<T> {
  match xs {
    Empty => HeadAbsent
    Cons { head: h, tail: _ } => HeadFound { value: h }
  }
}
// Skip the first n elements; n <= 0 is identity; n > length yields Empty.
fn skip<T>(xs: FreeMonoid<T>, n: Int) -> FreeMonoid<T> {
  if n <= 0 {
    xs
  } else {
    match xs {
      Empty => Empty
      Cons { head: _, tail: t } => skip(xs: t, n: n - 1)
    }
  }
}
fn fold_list_node<T>(
  xs: FreeMonoid<T>,
  item_node: fn(T) -> Node
) -> Node {
  fold_list_right(
    xs: xs,
    empty: Node { kind: TypeNode { connective: Conj }, children: [],
 occurrence_id: SyntheticOccurrence
},
    snoc: fn(tail_node, item) {
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge { label: Named { name: ^fold_list_node_head }, target: item_node(item) },
          Edge { label: Named { name: ^fold_list_node_tail }, target: tail_node },
        ],
        occurrence_id: SyntheticOccurrence
}
    }
  )
}


