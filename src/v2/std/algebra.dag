module v2.std.algebra


type ApproximateField<T> {
  add: fn(T, T) -> T
  zero: T
  negate: fn(T) -> T
  mul: fn(T, T) -> T
  one: T
  compare: fn(T, T) -> Ordering
}

type Equivalence<T> {
  eq: fn(T, T) -> Bool
}

fn freemonoid_empty<T>() -> std.algebra.FreeMonoid<T> {
  std.algebra.Empty
}
type FreeMonoidUniqueState<T> {
  seen: std.algebra.FreeMonoid<T>
  unique: Bool
}

fn fold_list<T, A>(xs: std.algebra.FreeMonoid<T>, empty: A, cons: fn(A, T) -> A) -> A {
  match xs {
    std.algebra.Empty => empty
    std.algebra.Cons { head: h, tail: t } => fold_list(xs: t, empty: cons(empty, h), cons: cons)
  }
}
fn fold_non_empty<T>(head: T, tail: std.algebra.FreeMonoid<T>, cons: fn(T, T) -> T) -> T {
  fold_list(xs: tail, empty: head, cons: cons)
}

fn fold_list_right<T, A>(xs: std.algebra.FreeMonoid<T>, empty: A, snoc: fn(A, T) -> A) -> A {
  match xs {
    std.algebra.Empty => empty
    std.algebra.Cons { head: h, tail: t } => snoc(fold_list_right(xs: t, empty: empty, snoc: snoc), h)
  }
}

fn list_reverse<T>(xs: std.algebra.FreeMonoid<T>) -> std.algebra.FreeMonoid<T> {
  fold_list(xs: xs, empty: std.algebra.Empty, cons: fn(acc, item) {
    std.algebra.Cons { head: item, tail: acc }
  })
}

fn list_map<T, U>(xs: std.algebra.FreeMonoid<T>, f: fn(T) -> U) -> std.algebra.FreeMonoid<U> {
  fold_list_right(xs: xs, empty: std.algebra.Empty, snoc: fn(acc, item) {
    std.algebra.Cons { head: f(item), tail: acc }
  })
}

fn list_flat_map<T, U>(xs: std.algebra.FreeMonoid<T>, f: fn(T) -> std.algebra.FreeMonoid<U>) -> std.algebra.FreeMonoid<U> {
  fold_list_right(xs: xs, empty: std.algebra.Empty, snoc: fn(acc, item) {
    fold_list_right(xs: f(item), empty: acc, snoc: fn(inner, produced) {
      std.algebra.Cons { head: produced, tail: inner }
    })
  })
}

type ListTailResult<T>
  = TailFound { tail: std.algebra.FreeMonoid<T> }
  | TailAbsent

fn list_tail<T>(xs: std.algebra.FreeMonoid<T>) -> ListTailResult<T> {
  match xs {
    std.algebra.Empty => TailAbsent
    std.algebra.Cons { head: _, tail: t } => TailFound { tail: t }
  }
}

type ListHeadResult<T>
  = HeadFound { value: T }
  | HeadAbsent

fn list_head<T>(xs: std.algebra.FreeMonoid<T>) -> ListHeadResult<T> {
  match xs {
    std.algebra.Empty => HeadAbsent
    std.algebra.Cons { head: h, tail: _ } => HeadFound { value: h }
  }
}

fn skip<T>(xs: std.algebra.FreeMonoid<T>, n: Int) -> std.algebra.FreeMonoid<T> {
  if n <= 0 {
    xs
  } else {
    match xs {
      std.algebra.Empty => std.algebra.Empty
      std.algebra.Cons { head: _, tail: t } => skip(xs: t, n: n - 1)
    }
  }
}
fn fold_list_node<T>(
  xs: std.algebra.FreeMonoid<T>,
  item_node: fn(T) -> Node
) -> Node {
  fold_list_right(
    xs: xs,
    empty: v2.std.node.Node { kind: v2.std.node.TypeNode { connective: Conj }, children: [],
 occurrence_id: SyntheticOccurrence
},
    snoc: fn(tail_node, item) {
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: Conj },
        children: [
          v2.std.node.Edge { label: Named { name: ^fold_list_node_head }, target: item_node(item) },
          v2.std.node.Edge { label: Named { name: ^fold_list_node_tail }, target: tail_node },
        ],
        occurrence_id: SyntheticOccurrence
}
    }
  )
}

fn algebra_empty_conj() -> Node {
  v2.std.node.Node { kind: v2.std.node.TypeNode { connective: Conj }, children: [],
 occurrence_id: SyntheticOccurrence
}
}

fn free_monoid_tail_type_fixpoint(inhabitant: Node) -> Node {
  algebra_inhabitance_node(
    algebra: v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: Conj },
      children: [
        v2.std.node.Edge { label: Named { name: ^free_monoid_type_fixpoint }, target: algebra_empty_conj() },
      ],
      occurrence_id: SyntheticOccurrence
},
    inhabitant: inhabitant,
  )
}

fn free_monoid_type_node(inhabitant: Node) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Disj },
    children: [
      v2.std.node.Edge { label: Named { name: ^free_monoid_variant_empty }, target: algebra_empty_conj() },
      v2.std.node.Edge {
        label: Named { name: ^free_monoid_variant_cons },
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: Conj },
          children: [
            v2.std.node.Edge { label: Named { name: ^free_monoid_field_head }, target: inhabitant },
            v2.std.node.Edge {
              label: Named { name: ^free_monoid_field_tail },
              target: free_monoid_tail_type_fixpoint(inhabitant: inhabitant),
            },
          ],
          occurrence_id: SyntheticOccurrence
},
      },
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn algebra_binary_fn_node(domain: Node, codomain: Node) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Arrow },
    children: [
      v2.std.node.Edge { label: Positional, target: domain },
      v2.std.node.Edge { label: Positional, target: domain },
      v2.std.node.Edge { label: Positional, target: codomain },
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn algebra_unary_fn_node(domain: Node, codomain: Node) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Arrow },
    children: [
      v2.std.node.Edge { label: Positional, target: domain },
      v2.std.node.Edge { label: Positional, target: codomain },
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn ordering_type_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Disj },
    children: [
      v2.std.node.Edge { label: Named { name: ^ordering_variant_less }, target: algebra_empty_conj() },
      v2.std.node.Edge { label: Named { name: ^ordering_variant_equal }, target: algebra_empty_conj() },
      v2.std.node.Edge { label: Named { name: ^ordering_variant_greater }, target: algebra_empty_conj() },
    ],
    occurrence_id: SyntheticOccurrence
}
}

