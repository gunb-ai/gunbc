// 🟢 coproduct dissolution — CP-AI1-BL-MISSING-WITNESS (MissingMeet/Join/LatticeField distinguish partial-instance gaps).
type BoundedLatticeMissingWitness
  = MissingMeet
  | MissingJoin
  | MissingLatticeField


// 🟢 coproduct dissolution — CP-AI1-BL-INSTANCE-COMPLETENESS (NotBL / Complete / Partial trichotomy).
type BoundedLatticeInstanceCompleteness
  = NotBoundedLatticeInstance
  | BoundedLatticeComplete
  | BoundedLatticePartial { missing: BoundedLatticeMissingWitness }


