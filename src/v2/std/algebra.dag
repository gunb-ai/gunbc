fn free_monoid_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Disj },
    children: [
      Edge { label: Named { name: ^free_monoid_variant_empty }, target: algebra_empty_conj() },
      Edge {
        label: Named { name: ^free_monoid_variant_cons },
        target: Node {
          kind: TypeNode { connective: Conj },
          children: [
            Edge { label: Named { name: ^free_monoid_field_head }, target: inhabitant },
            Edge {
              label: Named { name: ^free_monoid_field_tail },
              target: free_monoid_tail_type_fixpoint(inhabitant: inhabitant),
            },
          ],
          occurrence_id: SyntheticOccurrence
},
      },
    ],
    occurrence_id: SyntheticOccurrence
}
}


