}

fn is_empty<T>(xs: std.algebra.FreeMonoid<T>) -> Bool {
  match xs {
    std.algebra.Empty => true
    std.algebra.Cons { head: _, tail: _ } => false
  }
}

fn non_empty<T>(xs: std.algebra.FreeMonoid<T>) -> Bool {
  match is_empty(xs: xs) {
    true => false
    false => true
  }
}

fn length<T>(xs: std.algebra.FreeMonoid<T>) -> Int {
  fold_list(xs: xs, empty: 0, cons: fn(count, _) { count + 1 })
}

fn for_all<T>(xs: std.algebra.FreeMonoid<T>, predicate: fn(T) -> Bool) -> Bool {
  fold_list(xs: xs, empty: true, cons: fn(acc, item) {
    match acc {
      true => predicate(item)
      false => false
    }
  })
}

fn any<T>(xs: std.algebra.FreeMonoid<T>, predicate: fn(T) -> Bool) -> Bool {
  fold_list(xs: xs, empty: false, cons: fn(acc, item) {
    match acc {
      true => true
      false => predicate(item)
    }
  })
}

fn filter<T>(xs: std.algebra.FreeMonoid<T>, predicate: fn(T) -> Bool) -> std.algebra.FreeMonoid<T> {
  fold_list_right(xs: xs, empty: std.algebra.Empty, snoc: fn(acc, item) {
    match predicate(item) {
      true => std.algebra.Cons { head: item, tail: acc }
      false => acc
    }
  })
}

fn contains<T>(xs: std.algebra.FreeMonoid<T>, item: T, eq: fn(T, T) -> Bool) -> Bool {
  any(xs: xs, predicate: fn(candidate) { eq(candidate, item) })
}

fn count_where<T>(xs: std.algebra.FreeMonoid<T>, predicate: fn(T) -> Bool) -> Int {
  fold_list(xs: xs, empty: 0, cons: fn(count, item) {
    match predicate(item) {
      true => count + 1
      false => count
    }
  })
}

fn count_equal<T>(xs: std.algebra.FreeMonoid<T>, item: T, eq: fn(T, T) -> Bool) -> Int {
  count_where(xs: xs, predicate: fn(candidate) { eq(candidate, item) })
}

fn unique<T>(xs: std.algebra.FreeMonoid<T>, eq: fn(T, T) -> Bool) -> Bool {
  let state = fold_list(xs: xs, empty: FreeMonoidUniqueState { seen: std.algebra.Empty, unique: true }, cons: fn(acc, item) {
    match acc.unique {
      true => match count_equal(xs: acc.seen, item: item, eq: eq) {
        0 => FreeMonoidUniqueState { seen: std.algebra.Cons { head: item, tail: acc.seen }, unique: true }
        _ => FreeMonoidUniqueState { seen: acc.seen, unique: false }
      }
      false => acc
    }
  })
  state.unique
}

fn list_append<T>(left: std.algebra.FreeMonoid<T>, right: std.algebra.FreeMonoid<T>) -> std.algebra.FreeMonoid<T> {
  fold_list_right(xs: left, empty: right, snoc: fn(acc, item) {
    std.algebra.Cons { head: item, tail: acc }
  })
}

fn list_snoc_item<T>(xs: std.algebra.FreeMonoid<T>, item: T) -> std.algebra.FreeMonoid<T> {
  list_append(left: xs, right: std.algebra.Cons { head: item, tail: std.algebra.Empty })
}

data free_semigroup_grounding_note: String = "FreeSemigroup is the free SEMIGROUP over T exactly as FreeMonoid is the free MONOID over T, so the pair is one algebraic axis read at two identities rather than a second sequence vocabulary (DESIGN section 2). The head field is the construction wall: an empty inhabitant has no representation, so a nonempty-by-obligation collection is UNWRITABLE empty rather than validated nonempty - the structurally-impossible rung of DESIGN section 4b rather than the mechanically-preventable one. This is deliberately NOT the Refined<List<T>> spelling the manual fixture v2.test.claim.manual.refinement_nonempty_list carries: a refinement predicate is a validation that concedes the empty state is writable, and the NonEmptyList ALIAS is withheld while that fixture lives so one name never resolves to two declarations. CONVERGENCE DEBT, stated at the grain grep decides rather than at the grain that reads well. FIVE carriers in the tree are this same shape monomorphised: v2.std.diagnostic NonEmptyDiagnostics, v2.std.collection FiniteSet, gunbc.process_algebra NonEmptyProcessNodeIds, v2.compiler.self_host.frontier_probe_types NonEmptySymbolChain, and v2.std.grammar_choice_ambiguity NonEmptyGrammarChoiceAmbiguityRows. Only the last TWO carry a dissolution trigger today - non_empty_symbol_chain_dissolve_trigger and non_empty_grammar_choice_ambiguity_rows_dissolve_trigger, both retargeted onto this declaration by the change that landed it. The first three carry NO trigger and are therefore untracked stalls owed a follow-up row; an earlier revision of this note asserted all four of the carriers it named already carried one, which was false of two of them and is the cited-symbol class DESIGN section 3 names, sitting in the note that argues for single authority. The retarget was not tidying: both surviving triggers named the event as promoting the manual REFINEMENT to std, and the change that landed this declaration decided that promotion is not the mechanism, so those two carriers would otherwise have been left waiting on an event that cannot occur as spelled - an untracked stall wearing a tracked one's clothes. The migrations themselves are deliberately not carried by the lane that landed this authority, because a corpus-wide de-fork is not a consequence of the authority existing."

fn non_empty_singleton<T>(item: T) -> std.algebra.FreeSemigroup<T> {
  std.algebra.FreeSemigroup { head: item, tail: std.algebra.Empty }
}

fn non_empty_append<T>(left: std.algebra.FreeSemigroup<T>, right: std.algebra.FreeSemigroup<T>) -> std.algebra.FreeSemigroup<T> {
  std.algebra.FreeSemigroup {
    head: left.head,
    tail: list_append(
      left: list_snoc_item(xs: left.tail, item: right.head),
      right: right.tail
    )
  }
}

fn non_empty_to_list<T>(xs: std.algebra.FreeSemigroup<T>) -> std.algebra.FreeMonoid<T> {
  std.algebra.Cons { head: xs.head, tail: xs.tail }
}

fn list_init<T>(xs: std.algebra.FreeMonoid<T>) -> std.algebra.FreeMonoid<T> {
  match xs {
    std.algebra.Empty => std.algebra.Empty
    std.algebra.Cons { head: _, tail: std.algebra.Empty } => std.algebra.Empty
    std.algebra.Cons { head: h, tail: t } => std.algebra.Cons { head: h, tail: list_init(xs: t) }
  }
}

type CopiedPortFact {
  combiner: v2.std.node.Symbol
  copied_port_index: Int
}

data copied_port_fact_registry_dissolution_note: String = "Wave 1 Gate 1 C1: hand-stamped copied_port_fact_* rows and copied_port_fact_registry deleted — per-op indices derive from combiner Arrow citations via v2.lens.cost.copied_port_derivation (cost lens over ^arrow_body_edge only). classify_call reads copied_port_index_of from v2.lens.cost.copied_port_citations; unpriceable combiners stay ^combiner_unregistered_carrier_reaches fail-closed."

fn bag_eq<T>(xs: std.algebra.FreeMonoid<T>, ys: std.algebra.FreeMonoid<T>, eq: fn(T, T) -> Bool) -> Bool {
  if length(xs: xs) != length(xs: ys) {
    false
  } else {
    for_all(xs: xs, predicate: fn(item) {
      count_equal(xs: xs, item: item, eq: eq) == count_equal(xs: ys, item: item, eq: eq)
    })
  }
}

fn zip_eq<T>(
  a: std.algebra.FreeMonoid<T>,
  b: std.algebra.FreeMonoid<T>,
  eq: fn(T, T) -> Bool
) -> Bool {
  match a {
    std.algebra.Empty =>
      match b {
        std.algebra.Empty => true
        std.algebra.Cons { head: _, tail: _ } => false
      }
    std.algebra.Cons { head: ha, tail: ta } =>
      match b {
        std.algebra.Empty => false
        std.algebra.Cons { head: hb, tail: tb } =>
          eq(ha, hb) && zip_eq(a: ta, b: tb, eq: eq)
      }
  }
}

fn zip_map<A, B, C>(
  a: std.algebra.FreeMonoid<A>,
  b: std.algebra.FreeMonoid<B>,
  f: fn(A, B) -> C
) -> std.algebra.FreeMonoid<C> {
  match a {
    std.algebra.Empty => std.algebra.Empty
    std.algebra.Cons { head: ha, tail: ta } =>
      match b {
        std.algebra.Empty => std.algebra.Empty
        std.algebra.Cons { head: hb, tail: tb } =>
          std.algebra.Cons { head: f(ha, hb), tail: zip_map(a: ta, b: tb, f: f) }
      }
  }
}

fn reduce_or<T>(xs: std.algebra.FreeMonoid<T>, fallback: T, combine: fn(T, T) -> T) -> T {
  match xs {
    std.algebra.Empty => fallback
    std.algebra.Cons { head: h, tail: t } => fold_non_empty(head: h, tail: t, cons: combine)
  }
}

fn is_prefix_of<T>(
  prefix: std.algebra.FreeMonoid<T>,
  xs: std.algebra.FreeMonoid<T>,
  eq: fn(T, T) -> Bool
) -> Bool {
  match prefix {
    std.algebra.Empty => true
    std.algebra.Cons { head: h_prefix, tail: t_prefix } =>
      match xs {
        std.algebra.Empty => false
        std.algebra.Cons { head: h_xs, tail: t_xs } =>
          eq(h_prefix, h_xs) && is_prefix_of(prefix: t_prefix, xs: t_xs, eq: eq)
      }
  }
}

type Homomorphism<C, Source, Target> {
  source: C<Source>
  target: C<Target>
  map: fn(Source) -> Target
}
