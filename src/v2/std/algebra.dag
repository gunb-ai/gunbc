fn is_empty<T>(xs: FreeMonoid<T>) -> Bool {
  match xs {
    Empty => true
    Cons { head: _, tail: _ } => false
  }
}

fn non_empty<T>(xs: FreeMonoid<T>) -> Bool {
  match is_empty(xs: xs) {
    true => false
    false => true
  }
}

fn length<T>(xs: FreeMonoid<T>) -> Int {
  fold_list(xs: xs, empty: 0, cons: fn(count, _) { count + 1 })
}

fn for_all<T>(xs: FreeMonoid<T>, predicate: fn(T) -> Bool) -> Bool {
  fold_list(xs: xs, empty: true, cons: fn(acc, item) {
    match acc {
      true => predicate(item)
      false => false
    }
  })
}

fn any<T>(xs: FreeMonoid<T>, predicate: fn(T) -> Bool) -> Bool {
  fold_list(xs: xs, empty: false, cons: fn(acc, item) {
    match acc {
      true => true
      false => predicate(item)
    }
  })
}

fn filter<T>(xs: FreeMonoid<T>, predicate: fn(T) -> Bool) -> FreeMonoid<T> {
  fold_list_right(xs: xs, empty: Empty, snoc: fn(acc, item) {
    match predicate(item) {
      true => Cons { head: item, tail: acc }
      false => acc
    }
  })
}

fn contains<T>(xs: FreeMonoid<T>, item: T, eq: fn(T, T) -> Bool) -> Bool {
  any(xs: xs, predicate: fn(candidate) { eq(candidate, item) })
}

fn count_where<T>(xs: FreeMonoid<T>, predicate: fn(T) -> Bool) -> Int {
  fold_list(xs: xs, empty: 0, cons: fn(count, item) {
    match predicate(item) {
      true => count + 1
      false => count
    }
  })
}

fn count_equal<T>(xs: FreeMonoid<T>, item: T, eq: fn(T, T) -> Bool) -> Int {
  count_where(xs: xs, predicate: fn(candidate) { eq(candidate, item) })
}

fn unique<T>(xs: FreeMonoid<T>, eq: fn(T, T) -> Bool) -> Bool {
  let state = fold_list(xs: xs, empty: FreeMonoidUniqueState { seen: Empty, unique: true }, cons: fn(acc, item) {
    match acc.unique {
      true => match count_equal(xs: acc.seen, item: item, eq: eq) {
        0 => FreeMonoidUniqueState { seen: Cons { head: item, tail: acc.seen }, unique: true }
        _ => FreeMonoidUniqueState { seen: acc.seen, unique: false }
      }
      false => acc
    }
  })
  state.unique
}

fn list_append<T>(left: FreeMonoid<T>, right: FreeMonoid<T>) -> FreeMonoid<T> {
  fold_list_right(xs: left, empty: right, snoc: fn(acc, item) {
    Cons { head: item, tail: acc }
  })
}

fn list_snoc_item<T>(xs: FreeMonoid<T>, item: T) -> FreeMonoid<T> {
  list_append(left: xs, right: Cons { head: item, tail: Empty })
}

fn list_init<T>(xs: FreeMonoid<T>) -> FreeMonoid<T> {
  match xs {
    Empty => Empty
    Cons { head: _, tail: Empty } => Empty
    Cons { head: h, tail: t } => Cons { head: h, tail: list_init(xs: t) }
  }
}

type CopiedPortFact {
  combiner: Symbol
  copied_port_index: Int
}

data copied_port_fact_registry_dissolution_note: String = "Wave 1 Gate 1 C1: hand-stamped copied_port_fact_* rows and copied_port_fact_registry deleted — per-op indices derive from combiner Arrow citations via v2.lens.cost.copied_port_derivation (cost lens over ^arrow_body_edge only). classify_call reads copied_port_index_of from v2.lens.cost.copied_port_citations; unpriceable combiners stay ^combiner_unregistered_carrier_reaches fail-closed."

fn bag_eq<T>(xs: FreeMonoid<T>, ys: FreeMonoid<T>, eq: fn(T, T) -> Bool) -> Bool {
  if length(xs: xs) != length(xs: ys) {
    false
  } else {
    for_all(xs: xs, predicate: fn(item) {
      count_equal(xs: xs, item: item, eq: eq) == count_equal(xs: ys, item: item, eq: eq)
    })
  }
}

fn zip_eq<T>(
  a: FreeMonoid<T>,
  b: FreeMonoid<T>,
  eq: fn(T, T) -> Bool
) -> Bool {
  match a {
    Empty =>
      match b {
        Empty => true
        Cons { head: _, tail: _ } => false
      }
    Cons { head: ha, tail: ta } =>
      match b {
        Empty => false
        Cons { head: hb, tail: tb } =>
          eq(ha, hb) && zip_eq(a: ta, b: tb, eq: eq)
      }
  }
}

fn zip_map<A, B, C>(
  a: FreeMonoid<A>,
  b: FreeMonoid<B>,
  f: fn(A, B) -> C
) -> FreeMonoid<C> {
  match a {
    Empty => Empty
    Cons { head: ha, tail: ta } =>
      match b {
        Empty => Empty
        Cons { head: hb, tail: tb } =>
          Cons { head: f(ha, hb), tail: zip_map(a: ta, b: tb, f: f) }
      }
  }
}

fn reduce_or<T>(xs: FreeMonoid<T>, fallback: T, combine: fn(T, T) -> T) -> T {
  match xs {
    Empty => fallback
    Cons { head: h, tail: t } => fold_non_empty(head: h, tail: t, cons: combine)
  }
}

fn is_prefix_of<T>(
  prefix: FreeMonoid<T>,
  xs: FreeMonoid<T>,
  eq: fn(T, T) -> Bool
) -> Bool {
  match prefix {
    Empty => true
    Cons { head: h_prefix, tail: t_prefix } =>
      match xs {
        Empty => false
        Cons { head: h_xs, tail: t_xs } =>
          eq(h_prefix, h_xs) && is_prefix_of(prefix: t_prefix, xs: t_xs, eq: eq)
      }
  }
}

  source: C<Source>
  target: C<Target>
  map: fn(Source) -> Target
}
