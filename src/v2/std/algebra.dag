      v2.std.node.Edge { label: Named { name: ^bool_variant_true }, target: algebra_empty_conj() },
      v2.std.node.Edge { label: Named { name: ^bool_variant_false }, target: algebra_empty_conj() },
    ],
    occurrence_id: SyntheticOccurrence
}
}

