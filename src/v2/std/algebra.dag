type ApproximateField<T> {
  add: fn(T, T) -> T
  zero: T
  negate: fn(T) -> T
  mul: fn(T, T) -> T
  one: T
  compare: fn(T, T) -> Ordering
}

type Equivalence<T> {
  eq: fn(T, T) -> Bool
}

fn freemonoid_empty<T>() -> FreeMonoid<T> {
  Empty
}
type FreeMonoidUniqueState<T> {
  seen: FreeMonoid<T>
  unique: Bool
}

fn fold_list<T, A>(xs: FreeMonoid<T>, empty: A, cons: fn(A, T) -> A) -> A {
  match xs {
    Empty => empty
    Cons { head: h, tail: t } => fold_list(xs: t, empty: cons(empty, h), cons: cons)
  }
}
fn fold_non_empty<T>(head: T, tail: FreeMonoid<T>, cons: fn(T, T) -> T) -> T {
  fold_list(xs: tail, empty: head, cons: cons)
}

fn fold_list_right<T, A>(xs: FreeMonoid<T>, empty: A, snoc: fn(A, T) -> A) -> A {
  match xs {
    Empty => empty
    Cons { head: h, tail: t } => snoc(fold_list_right(xs: t, empty: empty, snoc: snoc), h)
  }
}

fn list_reverse<T>(xs: FreeMonoid<T>) -> FreeMonoid<T> {
  fold_list(xs: xs, empty: Empty, cons: fn(acc, item) {
    Cons { head: item, tail: acc }
  })
}

fn list_map<T, U>(xs: FreeMonoid<T>, f: fn(T) -> U) -> FreeMonoid<U> {
  fold_list_right(xs: xs, empty: Empty, snoc: fn(acc, item) {
    Cons { head: f(item), tail: acc }
  })
}

fn list_flat_map<T, U>(xs: FreeMonoid<T>, f: fn(T) -> FreeMonoid<U>) -> FreeMonoid<U> {
  fold_list_right(xs: xs, empty: Empty, snoc: fn(acc, item) {
    fold_list_right(xs: f(item), empty: acc, snoc: fn(inner, produced) {
      Cons { head: produced, tail: inner }
    })
  })
}

type ListTailResult<T>
  = TailFound { tail: FreeMonoid<T> }
  | TailAbsent

fn list_tail<T>(xs: FreeMonoid<T>) -> ListTailResult<T> {
  match xs {
    Empty => TailAbsent
    Cons { head: _, tail: t } => TailFound { tail: t }
  }
}

type ListHeadResult<T>
  = HeadFound { value: T }
  | HeadAbsent

fn list_head<T>(xs: FreeMonoid<T>) -> ListHeadResult<T> {
  match xs {
    Empty => HeadAbsent
    Cons { head: h, tail: _ } => HeadFound { value: h }
  }
}

fn skip<T>(xs: FreeMonoid<T>, n: Int) -> FreeMonoid<T> {
  if n <= 0 {
    xs
  } else {
    match xs {
      Empty => Empty
      Cons { head: _, tail: t } => skip(xs: t, n: n - 1)
    }
  }
}
fn fold_list_node<T>(
  xs: FreeMonoid<T>,
  item_node: fn(T) -> Node
) -> Node {
  fold_list_right(
    xs: xs,
    empty: Node { kind: TypeNode { connective: Conj }, children: [],
 occurrence_id: SyntheticOccurrence
},
    snoc: fn(tail_node, item) {
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge { label: Named { name: ^fold_list_node_head }, target: item_node(item) },
          Edge { label: Named { name: ^fold_list_node_tail }, target: tail_node },
        ],
        occurrence_id: SyntheticOccurrence
}
    }
  )
}

fn algebra_empty_conj() -> Node {
  Node { kind: TypeNode { connective: Conj }, children: [],
 occurrence_id: SyntheticOccurrence
}
}

fn free_monoid_tail_type_fixpoint(inhabitant: Node) -> Node {
  algebra_inhabitance_node(
    algebra: Node {
      kind: TypeNode { connective: Conj },
      children: [
        Edge { label: Named { name: ^free_monoid_type_fixpoint }, target: algebra_empty_conj() },
      ],
      occurrence_id: SyntheticOccurrence
},
    inhabitant: inhabitant,
  )
}

fn free_monoid_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Disj },
    children: [
      Edge { label: Named { name: ^free_monoid_variant_empty }, target: algebra_empty_conj() },
      Edge {
        label: Named { name: ^free_monoid_variant_cons },
        target: Node {
          kind: TypeNode { connective: Conj },
          children: [
            Edge { label: Named { name: ^free_monoid_field_head }, target: inhabitant },
            Edge {
              label: Named { name: ^free_monoid_field_tail },
              target: free_monoid_tail_type_fixpoint(inhabitant: inhabitant),
            },
          ],
          occurrence_id: SyntheticOccurrence
},
      },
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn algebra_binary_fn_node(domain: Node, codomain: Node) -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: domain },
      Edge { label: Positional, target: domain },
      Edge { label: Positional, target: codomain },
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn algebra_unary_fn_node(domain: Node, codomain: Node) -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: domain },
      Edge { label: Positional, target: codomain },
    ],
    occurrence_id: SyntheticOccurrence
}
}

