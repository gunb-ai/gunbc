}
type CommutativeSemiring<T> {
  semiring: Semiring<T>
}
type Ring<T> {
  add: AbelianGroup<T>
  mul: Monoid<T>
}
type CommutativeRing<T> {
  ring: Ring<T>
}
type OrderedRing<T> {
  ring: Ring<T>
  compare: fn(T, T) -> Ordering
}
type Field<T> {
  commutative_ring: CommutativeRing<T>
  reciprocal: fn(T) -> T
}
