module v2.std.concept_index


type FieldRef {
  field: String
  type_name: String
}

type ConceptStruct {
  name: String
  fields: List<FieldRef>
}

type QualifiedConcept {
  qualified_name: String
  concept: ConceptStruct
}

type ConceptDecl {
  qualified_name: String
  name: String
  node: v2.std.node.Node
}

type ConceptByName {
  name: String
  concepts: List<QualifiedConcept>
}

fn concept_decl_facts_live() -> List<ConceptDecl> {
  concept_decl_facts_live()
}

fn concept_decl_facts(pool_roots: List<String>) -> List<ConceptDecl> {
  concept_decl_facts(pool_roots: pool_roots)
}

fn field_refs_from_conj_node(node: v2.std.node.Node) -> List<FieldRef> {
  fold(v2.std.node_query.node_labeled_child_edges(node: node), init: std.algebra.Empty, f: fn(acc, e) {
    v2.std.algebra.list_snoc_item(
      xs: acc,
      item: FieldRef {
        field: v2.std.node.named_edge_sort_key(e: e),
        type_name: v2.std.node_query.edge_field_type_name(target: e.target)
      }
    )
  })
}

fn field_refs_from_node(node: v2.std.node.Node) -> List<FieldRef> {
  match node.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } => field_refs_from_conj_node(node: node)
    v2.std.node.TypeNode { connective: v2.std.node.Disj } =>
      fold(v2.std.node_query.coproduct_arm_list_from_node(node: node), init: std.algebra.Empty, f: fn(acc, arm) {
        let pair = v2.std.node_query.coproduct_arm_payload_pair_from_arm(arm: arm)
        v2.std.algebra.list_snoc_item(xs: acc, item: FieldRef { field: pair.label, type_name: pair.payload_type_name })
      })
    _ => std.algebra.Empty
  }
}

fn concept_from_decl(decl: ConceptDecl) -> QualifiedConcept {
  QualifiedConcept {
    qualified_name: decl.qualified_name,
    concept: ConceptStruct {
      name: decl.name,
      fields: field_refs_from_node(node: decl.node)
    }
  }
}

fn enumerate_concepts_from_decls(decls: List<ConceptDecl>) -> List<QualifiedConcept> {
  v2.std.algebra.list_map(xs: decls, f: fn(decl) { concept_from_decl(decl: decl) })
}

fn enumerate_concepts() -> List<QualifiedConcept> {
  enumerate_concepts_from_decls(decls: concept_decl_facts_live())
}

fn enumerate_concepts_in(pool_roots: List<String>) -> List<QualifiedConcept> {
  enumerate_concepts_from_decls(decls: concept_decl_facts(pool_roots: pool_roots))
}

fn list_contains_name_index(acc: List<ConceptByName>, name: String) -> Bool {
  fold(acc, init: false, f: fn(found, row) { found || (row.name == name) })
}

fn append_to_name_bucket(acc: List<ConceptByName>, qc: QualifiedConcept) -> List<ConceptByName> {
  fold(acc, init: std.algebra.Empty, f: fn(done, row) {
    if row.name == qc.concept.name {
      v2.std.algebra.list_snoc_item(
        xs: done,
        item: ConceptByName {
          name: row.name,
          concepts: v2.std.algebra.list_snoc_item(xs: row.concepts, item: qc)
        }
      )
    } else {
      v2.std.algebra.list_snoc_item(xs: done, item: row)
    }
  })
}

fn build_concept_name_index(idx: List<QualifiedConcept>) -> List<ConceptByName> {
  fold(idx, init: std.algebra.Empty, f: fn(acc, qc) {
    if list_contains_name_index(acc: acc, name: qc.concept.name) {
      append_to_name_bucket(acc: acc, qc: qc)
    } else {
      v2.std.algebra.list_snoc_item(xs: acc, item: ConceptByName { name: qc.concept.name, concepts: [qc] })
    }
  })
}

fn enumerate_coproduct_decls() -> List<ConceptDecl> {
  v2.std.algebra.filter(
    xs: concept_decl_facts_live(),
    predicate: fn(decl) { v2.std.node_query.node_is_coproduct(node: decl.node) }
  )
}
