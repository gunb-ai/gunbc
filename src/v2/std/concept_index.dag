module v2.std.concept_index

import v2.std.algebra { Empty, list_snoc_item }
import v2.std.collection { List }
import v2.std.node { Node }
import v2.std.node_query { CoproductArm, coproduct_arm_list_from_node, coproduct_arm_payload_pair_from_arm, node_is_coproduct }
import v2.std.text { String }

type FieldRef {
  field: String
  type_name: String
}

type ConceptStruct {
  name: String
  fields: List<FieldRef>
}

type QualifiedConcept {
  qualified_name: String
  concept: ConceptStruct
}

type ConceptDecl {
  qualified_name: String
  name: String
  node: Node
}

type ConceptByName {
  name: String
  concepts: List<QualifiedConcept>
}

fn concept_decl_facts_live() -> List<ConceptDecl> {
  concept_decl_facts_live()
}

fn concept_decl_facts(pool_roots: List<String>) -> List<ConceptDecl> {
  concept_decl_facts(pool_roots: pool_roots)
}

fn field_refs_from_node(node: Node) -> List<FieldRef> {
  fold(coproduct_arm_list_from_node(node: node), init: Empty, f: fn(acc, arm) {
    let pair = coproduct_arm_payload_pair_from_arm(arm: arm)
    list_snoc_item(xs: acc, item: FieldRef { field: pair.label, type_name: pair.payload_type_name })
  })
}

fn concept_from_decl(decl: ConceptDecl) -> QualifiedConcept {
  QualifiedConcept {
    qualified_name: decl.qualified_name,
    concept: ConceptStruct {
      name: decl.name,
      fields: field_refs_from_node(node: decl.node)
    }
  }
}

fn enumerate_concepts() -> List<QualifiedConcept> {
  fold(concept_decl_facts_live(), init: Empty, f: fn(acc, decl) {
    list_snoc_item(xs: acc, item: concept_from_decl(decl: decl))
  })
}

fn enumerate_concepts_in(pool_roots: List<String>) -> List<QualifiedConcept> {
  fold(concept_decl_facts(pool_roots: pool_roots), init: Empty, f: fn(acc, decl) {
    list_snoc_item(xs: acc, item: concept_from_decl(decl: decl))
  })
}

fn list_contains_name_index(acc: List<ConceptByName>, name: String) -> Bool {
  fold(acc, init: false, f: fn(found, row) { found || (row.name == name) })
}

fn append_to_name_bucket(acc: List<ConceptByName>, qc: QualifiedConcept) -> List<ConceptByName> {
  fold(acc, init: Empty, f: fn(done, row) {
    if row.name == qc.concept.name {
      list_snoc_item(
        xs: done,
        item: ConceptByName {
          name: row.name,
          concepts: list_snoc_item(xs: row.concepts, item: qc)
        }
      )
    } else {
      list_snoc_item(xs: done, item: row)
    }
  })
}

fn build_concept_name_index(idx: List<QualifiedConcept>) -> List<ConceptByName> {
  fold(idx, init: Empty, f: fn(acc, qc) {
    if list_contains_name_index(acc: acc, name: qc.concept.name) {
      append_to_name_bucket(acc: acc, qc: qc)
    } else {
      list_snoc_item(xs: acc, item: ConceptByName { name: qc.concept.name, concepts: [qc] })
    }
  })
}

fn enumerate_coproduct_decls() -> List<ConceptDecl> {
  fold(concept_decl_facts_live(), init: Empty, f: fn(acc, decl) {
    if node_is_coproduct(node: decl.node) {
      list_snoc_item(xs: acc, item: decl)
    } else {
      acc
    }
  })
}
