module v2.std.test_claim_falsification


type InterpreterTrace {
  pinned_eval_call: v2.std.node.Symbol
  diagnostics: List<v2.std.diagnostic.Diagnostic>
}

type ExecutionEvidence
  = Host { receipt: v2.std.host_run.EmitHostRunReceipt }
  | Interpreter { trace: InterpreterTrace }
  | EvidenceNone

type FalsificationReceipt<Subj, A> {
  subject: Subj
  expected: A
  actual: A
  divergence: v2.std.host_run.ValueDiff<A>
  evidence: ExecutionEvidence
}
