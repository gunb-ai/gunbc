module v2.std.node


type Symbol
type Hash = std.types.ContentHash

type OccurrenceId {
  value: Int
}

type NodeOccurrenceId
  = SyntheticOccurrence
  | MintedOccurrence { id: OccurrenceId }

fn node_occurrence_minted(id: OccurrenceId) -> NodeOccurrenceId {
  MintedOccurrence { id: id }
}

type Connective
  = Atom { identity: Symbol }
  | Conj
  | Disj
  | Arrow
  | Cardinality
  | Instantiation

type Behavior
  = Value
  | Transform
  | Branch
  | Loop
  | Bind
  | Match

fn resolve_type_node(type_name: Symbol) -> Node {
  resolve_type_node(type_name: type_name)
}

type ArmPayload
  = Nullary
  | Typed { target_ref: Symbol }

type CoproductArm {
  label: Symbol
  payload: ArmPayload
}

type CoproductArmPayloadPair {
  label: Symbol
  payload_type_name: Symbol
}

data coproduct_nullary_payload_type_name: Symbol = ^coproduct_nullary_payload

type ConnectiveCoproductVariant
  = ConnectiveAtomArm
  | ConnectiveConjArm
  | ConnectiveDisjArm
  | ConnectiveArrowArm
  | ConnectiveCardinalityArm
  | ConnectiveInstantiationArm

fn connective_coproduct_variant_keys() -> List<ConnectiveCoproductVariant> {
  [
    ConnectiveAtomArm,
    ConnectiveConjArm,
    ConnectiveDisjArm,
    ConnectiveArrowArm,
    ConnectiveCardinalityArm,
    ConnectiveInstantiationArm,
  ]
}

fn connective_from_coproduct_variant(
  variant: ConnectiveCoproductVariant,
  atom_identity: Symbol
) -> Connective {
  match variant {
    ConnectiveAtomArm => Atom { identity: atom_identity }
    ConnectiveConjArm => Conj
    ConnectiveDisjArm => Disj
    ConnectiveArrowArm => Arrow
    ConnectiveCardinalityArm => Cardinality
    ConnectiveInstantiationArm => Instantiation
  }
}

fn behavior_coproduct_variants() -> List<Behavior> {
  [Value, Transform, Branch, Loop, Bind, Match]
}

data match_arm_pattern: Symbol = ^match_arm_pattern
data match_arm_body: Symbol = ^match_arm_body

type NodeKind
  = TypeNode { connective: Connective }
  | ComputationNode { behavior: Behavior }

type EdgeLabel
  = Named { name: Symbol }
  | Positional
type Edge {
  label: EdgeLabel
  target: Node
}

type EdgeShape {
  label: EdgeLabel
  target: NodeShape
}
type NodeShape {
  kind: NodeKind
  children: List<EdgeShape>
}

fn node_with_occurrence_id(
  kind: NodeKind,
  children: List<Edge>,
  occurrence_id: NodeOccurrenceId
) -> Node {
  Node { kind: kind, children: children, occurrence_id: occurrence_id }
}

fn node_rebuild(n: Node, children: List<Edge>) -> Node {
  node_with_occurrence_id(
    kind: n.kind,
    children: children,
    occurrence_id: n.occurrence_id
  )
}

fn node_synthetic(kind: NodeKind, children: List<Edge>) -> Node {
  node_with_occurrence_id(
    kind: kind,
    children: children,
    occurrence_id: SyntheticOccurrence
  )
}

fn node_for_structural_equality(n: Node) -> Node {
  node_with_occurrence_id(
    kind: n.kind,
    children: n.children,
    occurrence_id: SyntheticOccurrence
  )
}

fn strip_provenance_fold_init(n: Node) -> Node {
  node_synthetic(kind: n.kind, children: [])
}

fn strip_provenance_fold_step(acc: Node, edge: Edge, child: Node) -> Node {
  node_rebuild(
    n: acc,
    children: concat(acc.children, [Edge { label: edge.label, target: child }])
  )
}

fn strip_provenance_fold_algebra() -> NodeFold<Node> {
  NodeFold {
    init: strip_provenance_fold_init,
    step: strip_provenance_fold_step
  }
}

fn canonicalize_node_strip_provenance(n: Node) -> Node {
  fold_node(n: n, algebra: strip_provenance_fold_algebra())
}

type Node {
  kind: NodeKind
  children: List<Edge>
  occurrence_id: NodeOccurrenceId
}
type NodeFold<R> {
  init: fn(Node) -> R
  step: fn(R, Edge, R) -> R
}
fn fold_node<R>(n: Node, algebra: NodeFold<R>) -> R {
  fold(n.children, init: algebra.init(n), f: fn(acc, e) {
    algebra.step(acc, e, fold_node(n: e.target, algebra: algebra))
  })
}

fn node_subtree_nodes(root: Node) -> List<Node> {
  fold_node(
    n: root,
    algebra: NodeFold {
      init: fn(self) { [self] },
      step: fn(acc, _edge, sub) { concat(acc, sub) }
    }
  )
}

fn node_subtree_count(n: Node) -> Int {
  fold_node(
    n: n,
    algebra: NodeFold {
      init: fn(_) { 1 },
      step: fn(acc, _edge, child_count) { acc + child_count }
    }
  )
}

type NodeFoldTopDown<A,R> {
  init: fn(Node, A) -> R
  child_context: fn(Node, A, Edge) -> A
  step: fn(R, Edge, R) -> R
}
fn fold_node_topdown<A,R>(n: Node, ctx: A, algebra: NodeFoldTopDown<A,R>) -> R {
  fold(n.children, init: algebra.init(n, ctx), f: fn(acc, e) {
    algebra.step(acc, e, fold_node_topdown(n: e.target, ctx: algebra.child_context(n, ctx, e), algebra: algebra))
  })
}

type EdgeDiscipline
  = NoEdges
  | LabeledEdges
  | PositionalEdges

  | LoopBoundEdges

  | ArrowBodyEdges

data atom_payload_labeled_edges_scaffold_note: String = "🟡 dissolve-on: Atom connectives with labeled payload children (int-literal magnitude on ^dag_token_int_literal via ^integer_literal_magnitude_field) — atom_connective_edge_discipline(child_count) is the single authority (NoEdges when child_count==0, LabeledEdges otherwise); connective_edge_discipline_for_children delegates Atom through it. Not a new connective: the payload is a typed named field, not an open Conj record. Reconcile when int-literal lowering lands a dedicated connective or magnitude lives only on the magnitude subnode without widening Atom discipline."

fn atom_connective_edge_discipline(child_count: Int) -> EdgeDiscipline {
  if child_count == 0 {
    NoEdges
  } else {
    LabeledEdges
  }
}

fn connective_edge_discipline(c: Connective) -> EdgeDiscipline {
  match c {
    Atom { identity: _ } => atom_connective_edge_discipline(child_count: 0)
    Conj => LabeledEdges
    Disj => LabeledEdges
    Arrow => ArrowBodyEdges
    Cardinality => PositionalEdges
    Instantiation => PositionalEdges
  }
}

fn connective_edge_discipline_for_children(c: Connective, children: List<Edge>) -> EdgeDiscipline {
  match c {
    Atom { identity: _ } =>
      atom_connective_edge_discipline(child_count: count(children))
    _ => connective_edge_discipline(c: c)
  }
}

fn is_named(e: Edge) -> Bool {
  match e.label {
    Named { name: _ } => true
    Positional => false
  }
}

fn is_positional(e: Edge) -> Bool {
  match e.label {
    Named { name: _ } => false
    Positional => true
  }
}

fn all_edges_named(children: List<Edge>) -> Bool {
  fold(children, init: true, f: fn(acc, e) {
    acc && is_named(e: e)
  })
}

fn all_edges_positional(children: List<Edge>) -> Bool {
  fold(children, init: true, f: fn(acc, e) {
    acc && is_positional(e: e)
  })
}
fn name_occurrences(name: Symbol, children: List<Edge>) -> Int {
  fold(children, init: 0, f: fn(acc, e) {
    match e.label {
      Named { name: n } => if n == name { acc + 1 } else { acc }
      Positional => acc
    }
  })
}
fn positional_child_count(children: List<Edge>) -> Int {
  fold(children, init: 0, f: fn(acc, e) {
    match e.label {
      Positional => acc + 1
      Named { name: _ } => acc
    }
  })
}

fn loop_positional_child_count(children: List<Edge>) -> Int {
  positional_child_count(children: children)
}

fn loop_body_edges_conform(children: List<Edge>) -> Bool {
  fold(children, init: true, f: fn(acc, e) {
    match e.label {
      Positional => acc
      Named { name: sym } => acc && ((sym == ^loop_bound_edge) || (sym == ^loop_carrier_edge))
    }
  })
}

fn loop_behavior_edges_conform(children: List<Edge>) -> Bool {
  let bound_edges = name_occurrences(name: ^loop_bound_edge, children: children)
  let carrier_edges = name_occurrences(name: ^loop_carrier_edge, children: children)
  (bound_edges == 1)
  && (carrier_edges <= 1)
  && loop_body_edges_conform(children: children)
  && (loop_positional_child_count(children: children) >= 1)
}

fn arrow_signature_edges_conform(children: List<Edge>) -> Bool {
  fold(children, init: true, f: fn(acc, e) {
    match e.label {
      Positional => acc
      Named { name: sym } => acc && (sym == ^arrow_body_edge)
    }
  })
}

type NamedEdgeTargetLookup
  = Found { target: Node }
  | Ambiguous
  | Absent

fn named_edge_target_lookup(children: List<Edge>, name: Symbol) -> NamedEdgeTargetLookup {
  fold(children, init: Absent, f: fn(acc, e) {
    match e.label {
      Named { name: sym } =>
        if sym == name {
          match acc {
            Absent => Found { target: e.target }
            Found { target: _ } => Ambiguous
            Ambiguous => Ambiguous
          }
        } else {
          acc
        }
      Positional => acc
    }
  })
}

fn arrow_body_target_lookup(children: List<Edge>) -> NamedEdgeTargetLookup {
  named_edge_target_lookup(children: children, name: ^arrow_body_edge)
}

fn arrow_body_record_construct_conforms(node: Node) -> Bool {
  match node.kind {
    TypeNode { connective: Conj } =>
      if !all_edges_named(children: node.children) {
        false
      } else {
        fold(node.children, init: false, f: fn(seen_first_named, edge) {
          if seen_first_named {
            seen_first_named
          } else {
            match edge.label {
              Named { name: _ } =>
                match edge.target.kind {
                  TypeNode { connective: Atom { identity: _ } } => true
                  _ => false
                }
              Positional => false
            }
          }
        })
      }
    _ => false
  }
}

fn arrow_body_target_is_valid_realization(target: Node) -> Bool {
  match target.kind {
    ComputationNode { behavior: _ } => true
    TypeNode { connective: Conj } => arrow_body_record_construct_conforms(node: target)
    _ => false
  }
}

fn arrow_body_target_conforms(children: List<Edge>) -> Bool {
  match arrow_body_target_lookup(children: children) {
    Absent => true
    Found { target: t } => arrow_body_target_is_valid_realization(target: t)
    Ambiguous => false
  }
}

fn arrow_body_edges_conform(children: List<Edge>) -> Bool {
  let body_edges = name_occurrences(name: ^arrow_body_edge, children: children)
  (body_edges <= 1)
  && arrow_signature_edges_conform(children: children)
  && (positional_child_count(children: children) >= 1)
  && arrow_body_target_conforms(children: children)
}
fn loop_bound_measure_target(children: List<Edge>) -> NamedEdgeTargetLookup {
  named_edge_target_lookup(children: children, name: ^loop_bound_edge)
}

fn loop_carrier_binder_target(children: List<Edge>) -> NamedEdgeTargetLookup {
  named_edge_target_lookup(children: children, name: ^loop_carrier_edge)
}

fn loop_edge_contributes_to_iteration_fold(parent: Node, e: Edge) -> Bool {
  match parent.kind {
    ComputationNode { behavior: Loop } =>
      match e.label {
        Positional => true
        Named { name: sym } => (sym != ^loop_bound_edge) && (sym != ^loop_carrier_edge)
      }
    _ =>
      match e.label {
        Positional => true
        Named { name: _ } => true
      }
  }
}

data edge_contributes_to_cost_fold_note: String = "Wave 1 Gate 1 C1: the symbolic cost fold prices only runtime work. Arrow signature/type positional children and domain Named edges are NOT runtime cost — only ^arrow_body_edge carries the body the fold must price (general-body-producer-design Stage C prerequisite). Loop keeps the iteration-fold edge discipline from loop_edge_contributes_to_iteration_fold; infer continues to use that function directly."

fn edge_contributes_to_cost_fold(parent: Node, e: Edge) -> Bool {
  match parent.kind {
    ComputationNode { behavior: Loop } =>
      match e.label {
        Positional => true
        Named { name: sym } => (sym != ^loop_bound_edge) && (sym != ^loop_carrier_edge)
      }
    TypeNode { connective: Arrow } =>
      match e.label {
        Positional => false
        Named { name: sym } => sym == ^arrow_body_edge
      }
    _ =>
      match e.label {
        Positional => true
        Named { name: _ } => true
      }
  }
}
fn all_names_distinct(children: List<Edge>) -> Bool {
  fold(children, init: true, f: fn(acc, e) {
    match e.label {
      Named { name: n } => acc && (name_occurrences(name: n, children: children) == 1)
      Positional => acc
    }
  })
}
fn edges_conform(children: List<Edge>, d: EdgeDiscipline) -> Bool {
  match d {
    NoEdges => count(children) == 0
    LabeledEdges =>
      all_edges_named(children: children) && all_names_distinct(children: children)
    PositionalEdges => all_edges_positional(children: children)
    LoopBoundEdges => loop_behavior_edges_conform(children: children)
    ArrowBodyEdges => arrow_body_edges_conform(children: children)
  }
}

fn connective_edges_conform(children: List<Edge>, c: Connective) -> Bool {
  match c {
    Atom { identity: _ } =>
      edges_conform(
        children: children,
        d: connective_edge_discipline_for_children(c: c, children: children)
      )
    Conj => edges_conform(children: children, d: LabeledEdges)
    Disj => edges_conform(children: children, d: LabeledEdges)
    Arrow => arrow_body_edges_conform(children: children)
    Cardinality =>
      edges_conform(children: children, d: PositionalEdges) && (count(children) >= 1)
    Instantiation =>
      edges_conform(children: children, d: PositionalEdges) && (count(children) >= 1)
  }
}

fn match_arm_node_conforms(arm: Node) -> Bool {
  match arm.kind {
    TypeNode { connective: Conj } =>
      name_occurrences(name: match_arm_pattern, children: arm.children) == 1
        && name_occurrences(name: match_arm_body, children: arm.children) == 1
    _ => false
  }
}

type MatchArmChildrenConformFold {
  ok: Bool
  skipped_scrutinee: Bool
}

fn match_arm_children_conform_skip_first(children: List<Edge>, skipped_scrutinee: Bool) -> Bool {
  let folded = fold(
    children,
    init: MatchArmChildrenConformFold { ok: true, skipped_scrutinee: skipped_scrutinee },
    f: fn(acc, edge) {
      if !acc.ok {
        acc
      } else {
        match edge.label {
          Positional =>
            if !acc.skipped_scrutinee {
              MatchArmChildrenConformFold { ok: true, skipped_scrutinee: true }
            } else if !match_arm_node_conforms(arm: edge.target) {
              MatchArmChildrenConformFold { ok: false, skipped_scrutinee: true }
            } else {
              MatchArmChildrenConformFold { ok: true, skipped_scrutinee: true }
            }
          Named { name: _ } => acc
        }
      }
    }
  )
  folded.ok && folded.skipped_scrutinee
}

fn behavior_edges_conform(children: List<Edge>, b: Behavior) -> Bool {
  match b {
    Value => count(children) == 0
    Transform => edges_conform(children: children, d: PositionalEdges) && (count(children) >= 1)
    Branch => edges_conform(children: children, d: PositionalEdges) && (count(children) >= 1)
    Loop => edges_conform(children: children, d: LoopBoundEdges)
    Bind => edges_conform(children: children, d: PositionalEdges) && (count(children) == 3)
    Match =>
      edges_conform(children: children, d: PositionalEdges)
        && (positional_child_count(children: children) >= 2)
        && match_arm_children_conform_skip_first(children: children, skipped_scrutinee: false)
  }
}
fn locally_well_formed(n: Node) -> Bool {
  match n.kind {
      TypeNode { connective: c } => connective_edges_conform(children: n.children, c: c)
      ComputationNode { behavior: b } => behavior_edges_conform(children: n.children, b: b)
    }
}
fn well_formed(n: Node) -> Bool {
  fold_node(
    n: n,
    algebra: NodeFold {
      init: fn(n0) {
        locally_well_formed(n: n0)
      },
      step: fn(acc, _, child_ok) {
        acc && child_ok
      }
    }
  )
}

fn is_empty_conj_root(n: Node) -> Bool {
  match n.kind {
    TypeNode { connective: Conj } => count(n.children) == 0
    _ => false
  }
}

fn behavior_edge_discipline(b: Behavior) -> EdgeDiscipline {
  match b {
    Value => NoEdges
    Transform => PositionalEdges
    Branch => PositionalEdges
    Loop => LoopBoundEdges
    Bind => PositionalEdges
    Match => PositionalEdges
  }
}
fn node_edge_discipline(n: Node) -> EdgeDiscipline {
  match n.kind {
    TypeNode { connective: c } =>
      connective_edge_discipline_for_children(c: c, children: n.children)
    ComputationNode { behavior: b } => behavior_edge_discipline(b: b)
  }
}
fn named_edge_sort_key(e: Edge) -> Symbol {
  match e.label {
    Named { name: sym } => sym
    Positional => ^canonical_tag_positional_edge
  }
}

fn arrow_signature_edges_for_content_hash(children: List<Edge>) -> List<Edge> {
  filter(children, fn(e) {
    match e.label {
      Positional => true
      Named { name: _ } => false
    }
  })
}
fn arrow_body_edges_for_content_hash(children: List<Edge>) -> List<Edge> {
  filter(children, fn(e) {
    match e.label {
      Named { name: sym } => sym == ^arrow_body_edge
      Positional => false
    }
  })
}
fn arrow_other_named_edges_for_content_hash(children: List<Edge>) -> List<Edge> {
  sort_by(
    filter(children, fn(e) {
      match e.label {
        Named { name: sym } => sym != ^arrow_body_edge
        Positional => false
      }
    }),
    fn(e) { named_edge_sort_key(e: e) }
  )
}
fn canonicalize_arrow_children_for_content_hash(children: List<Edge>) -> List<Edge> {
  concat(
    arrow_signature_edges_for_content_hash(children: children),
    concat(
      arrow_other_named_edges_for_content_hash(children: children),
      arrow_body_edges_for_content_hash(children: children)
    )
  )
}
fn loop_body_edges_for_content_hash(children: List<Edge>) -> List<Edge> {
  filter(children, fn(e) {
    match e.label {
      Positional => true
      Named { name: _ } => false
    }
  })
}
fn loop_bound_edges_for_content_hash(children: List<Edge>) -> List<Edge> {
  filter(children, fn(e) {
    match e.label {
      Named { name: sym } => sym == ^loop_bound_edge
      Positional => false
    }
  })
}
fn loop_other_named_edges_for_content_hash(children: List<Edge>) -> List<Edge> {
  sort_by(
    filter(children, fn(e) {
      match e.label {
        Named { name: sym } => sym != ^loop_bound_edge
        Positional => false
      }
    }),
    fn(e) { named_edge_sort_key(e: e) }
  )
}
fn canonicalize_loop_children_for_content_hash(children: List<Edge>) -> List<Edge> {
  concat(
    loop_body_edges_for_content_hash(children: children),
    concat(
      loop_other_named_edges_for_content_hash(children: children),
      loop_bound_edges_for_content_hash(children: children)
    )
  )
}
fn canonicalize_node_for_content_hash(n: Node) -> Node {
  let base = node_for_structural_equality(n: n)
  match node_edge_discipline(n: n) {
    LabeledEdges =>
      Node {
        kind: base.kind,
        children: sort_by(base.children, fn(e) { named_edge_sort_key(e: e) }),
        occurrence_id: SyntheticOccurrence
      }
    NoEdges =>
      Node {
        kind: base.kind,
        children: base.children,
        occurrence_id: SyntheticOccurrence
      }
    PositionalEdges =>
      Node {
        kind: base.kind,
        children: base.children,
        occurrence_id: SyntheticOccurrence
      }
    ArrowBodyEdges =>
      Node {
        kind: base.kind,
        children: canonicalize_arrow_children_for_content_hash(children: base.children),
        occurrence_id: SyntheticOccurrence
      }
    LoopBoundEdges =>
      Node {
        kind: base.kind,
        children: canonicalize_loop_children_for_content_hash(children: base.children),
        occurrence_id: SyntheticOccurrence
      }
  }
}

fn fold_node_content_hash<R>(n: Node, algebra: NodeFold<R>) -> R {
  let n = canonicalize_node_for_content_hash(n: n)
  fold(n.children, init: algebra.init(n), f: fn(acc, e) {
    algebra.step(acc, e, fold_node_content_hash(n: e.target, algebra: algebra))
  })
}

fn canonical_hash_of_connective(c: Connective) -> std.types.ContentHash {
  match c {
    Atom { identity: sym } =>
      std.content_hash.content_hash_combine(std.content_hash.content_hash_atom(value: ^canonical_tag_atom), std.content_hash.content_hash_atom(value: sym))
    Conj => std.content_hash.content_hash_atom(value: ^canonical_tag_conj)
    Disj => std.content_hash.content_hash_atom(value: ^canonical_tag_disj)
    Arrow => std.content_hash.content_hash_atom(value: ^canonical_tag_arrow)
    Cardinality => std.content_hash.content_hash_atom(value: ^canonical_tag_cardinality)
    Instantiation => std.content_hash.content_hash_atom(value: ^canonical_tag_instantiation)
  }
}

fn canonical_hash_of_behavior(b: Behavior) -> std.types.ContentHash {
  match b {
    Value => std.content_hash.content_hash_atom(value: ^canonical_tag_value)
    Transform => std.content_hash.content_hash_atom(value: ^canonical_tag_transform)
    Branch => std.content_hash.content_hash_atom(value: ^canonical_tag_branch)
    Loop => std.content_hash.content_hash_atom(value: ^canonical_tag_loop)
    Bind => std.content_hash.content_hash_atom(value: ^canonical_tag_bind)
    Match => std.content_hash.content_hash_atom(value: ^canonical_tag_match)
  }
}

fn canonical_hash_of_node_kind(kind: NodeKind) -> std.types.ContentHash {
  match kind {
    TypeNode { connective: c } =>
      std.content_hash.content_hash_combine(std.content_hash.content_hash_atom(value: ^canonical_tag_type_node), canonical_hash_of_connective(c: c))
    ComputationNode { behavior: b } =>
      std.content_hash.content_hash_combine(std.content_hash.content_hash_atom(value: ^canonical_tag_computation_node), canonical_hash_of_behavior(b: b))
  }
}

fn canonical_hash_of_edge_label(label: EdgeLabel) -> std.types.ContentHash {
  match label {
    Named { name: sym } =>
      std.content_hash.content_hash_combine(std.content_hash.content_hash_atom(value: ^canonical_tag_named_edge), std.content_hash.content_hash_atom(value: sym))
    Positional => std.content_hash.content_hash_atom(value: ^canonical_tag_positional_edge)
  }
}

fn symbol_identity_digest(sym: Symbol) -> std.types.ContentHash {
  std.content_hash.content_hash_atom(value: sym)
}

data byte_offset_residual_quotient_magnitude_shift_limbs: Int = 4

data byte_offset_residual_quotient_magnitude_max_shift: Int = 28
data byte_offset_cache_digest_max_limbs: Int = 9

data byte_offset_cache_digest_overflow_limbs: Int = 4

type ByteOffsetCacheDigestAuthority
  = ByteOffsetWithinCeiling { digest: std.types.ContentHash }
  | ByteOffsetOverCeiling {
      within_ceiling_digest: std.types.ContentHash,
      quotient: Int
    }
  | ByteOffsetCacheDigestIneligible {
      within_ceiling_digest: std.types.ContentHash,
      boundary_tag: Symbol,
      residual_quotient: Int
    }

type ByteOffsetCacheKey
  = ByteOffsetCacheEligible { digest: std.types.ContentHash }
  | ByteOffsetCacheIneligible {
      boundary_tag: Symbol,
      witness: std.types.ContentHash
    }

fn byte_limb_hash_peano_digest(limb: Int) -> std.types.ContentHash {
  if limb < 0 || limb > 255 {
    std.content_hash.content_hash_atom(value: ^canonical_tag_byte_limb_out_of_range)
  } else if limb == 0 {
    std.content_hash.content_hash_atom(value: ^canonical_tag_scalar_int_zero)
  } else {
    if limb == 1 {
      std.content_hash.content_hash_atom(value: ^canonical_tag_scalar_int_one)
    } else {
      std.content_hash.content_hash_combine(std.content_hash.content_hash_atom(value: ^canonical_tag_scalar_int_succ), byte_limb_hash_peano_digest(limb: limb - 1))
    }
  }
}

fn byte_offset_byte_digest(b: Int) -> std.types.ContentHash {
  std.content_hash.content_hash_combine(std.content_hash.content_hash_atom(value: ^canonical_tag_byte_offset_byte), byte_limb_hash_peano_digest(limb: b))
}

fn byte_offset_quotient_divide_by_256_steps(quotient: Int, steps: Int) -> Int {
  if steps <= 0 {
    quotient
  } else {
    byte_offset_quotient_divide_by_256_steps(quotient: quotient / 256, steps: steps - 1)
  }
}

fn byte_offset_residual_quotient_magnitude_window_digest(quotient: Int, shift_steps: Int) -> std.types.ContentHash {
  let shifted = byte_offset_quotient_divide_by_256_steps(quotient: quotient, steps: shift_steps)
  if shift_steps == byte_offset_residual_quotient_magnitude_max_shift && shifted >= 256 * 256 {
    std.content_hash.content_hash_combine(byte_offset_residual_quotient_limb_pair_digest(quotient: shifted), byte_offset_overflow_quotient_high_band_terminal_digest(
        quotient: shifted / 65536,
        limbs_remaining: byte_offset_cache_digest_overflow_limbs
      ))
  } else {
    byte_offset_residual_quotient_limb_pair_digest(quotient: shifted)
  }
}

fn byte_offset_residual_quotient_limb_pair_digest(quotient: Int) -> std.types.ContentHash {
  if quotient < 256 * 256 {
    std.content_hash.content_hash_combine(std.content_hash.content_hash_atom(value: ^canonical_tag_byte_offset_residual_quotient_limb_pair), std.content_hash.content_hash_combine(byte_offset_byte_digest(b: quotient - (quotient / 256) * 256), byte_offset_byte_digest(b: quotient / 256)))
  } else {
    std.content_hash.content_hash_combine(std.content_hash.content_hash_atom(value: ^canonical_tag_byte_offset_overflow_residual_discarded_high_truncated), std.content_hash.content_hash_combine(byte_offset_byte_digest(b: quotient - (quotient / 256) * 256), byte_offset_byte_digest(b: (quotient / 256) - (quotient / 65536) * 256)))
  }
}

fn byte_offset_residual_quotient_magnitude_digest(quotient: Int) -> std.types.ContentHash {
  std.content_hash.content_hash_combine(std.content_hash.content_hash_atom(value: ^canonical_tag_byte_offset_residual_quotient_magnitude), std.content_hash.content_hash_combine(byte_offset_residual_quotient_magnitude_window_digest(quotient: quotient, shift_steps: 0), std.content_hash.content_hash_combine(byte_offset_residual_quotient_magnitude_window_digest(
          quotient: quotient,
          shift_steps: byte_offset_residual_quotient_magnitude_shift_limbs
        ), std.content_hash.content_hash_combine(byte_offset_residual_quotient_magnitude_window_digest(quotient: quotient, shift_steps: 8), std.content_hash.content_hash_combine(byte_offset_residual_quotient_magnitude_window_digest(quotient: quotient, shift_steps: 12), std.content_hash.content_hash_combine(byte_offset_residual_quotient_magnitude_window_digest(quotient: quotient, shift_steps: 16), std.content_hash.content_hash_combine(byte_offset_residual_quotient_magnitude_window_digest(quotient: quotient, shift_steps: 20), std.content_hash.content_hash_combine(byte_offset_residual_quotient_magnitude_window_digest(quotient: quotient, shift_steps: 24), byte_offset_residual_quotient_magnitude_window_digest(
                    quotient: quotient,
                    shift_steps: byte_offset_residual_quotient_magnitude_max_shift
                  )))))))))
}

fn byte_offset_overflow_quotient_high_band_terminal_digest(quotient: Int, limbs_remaining: Int) -> std.types.ContentHash {
  if limbs_remaining == 0 {
    if quotient == 0 {
      std.content_hash.content_hash_atom(value: ^canonical_tag_byte_offset_zero)
    } else if quotient < 256 * 256 {
      std.content_hash.content_hash_combine(std.content_hash.content_hash_atom(value: ^canonical_tag_byte_offset_overflow_peel_exhausted), std.content_hash.content_hash_combine(byte_offset_byte_digest(b: quotient - (quotient / 256) * 256), byte_offset_byte_digest(b: quotient / 256)))
    } else {
      byte_offset_residual_quotient_limb_pair_digest(quotient: quotient)
    }
  } else if quotient == 0 {
    std.content_hash.content_hash_atom(value: ^canonical_tag_byte_offset_zero)
  } else {
    std.content_hash.content_hash_combine(byte_offset_byte_digest(b: quotient - (quotient / 256) * 256), byte_offset_overflow_quotient_high_band_terminal_digest(
        quotient: quotient / 256,
        limbs_remaining: limbs_remaining - 1
      ))
  }
}

fn byte_offset_overflow_quotient_high_band_digest(quotient: Int, limbs_remaining: Int) -> std.types.ContentHash {
  if limbs_remaining == 0 {
    if quotient == 0 {
      std.content_hash.content_hash_atom(value: ^canonical_tag_byte_offset_zero)
    } else if quotient < 256 * 256 {
      std.content_hash.content_hash_combine(std.content_hash.content_hash_atom(value: ^canonical_tag_byte_offset_overflow_peel_exhausted), std.content_hash.content_hash_combine(byte_offset_byte_digest(b: quotient - (quotient / 256) * 256), byte_offset_byte_digest(b: quotient / 256)))
    } else {
      byte_offset_overflow_quotient_high_band_terminal_digest(
        quotient: quotient,
        limbs_remaining: byte_offset_cache_digest_overflow_limbs
      )
    }
  } else if quotient == 0 {
    std.content_hash.content_hash_atom(value: ^canonical_tag_byte_offset_zero)
  } else {
    std.content_hash.content_hash_combine(byte_offset_byte_digest(b: quotient - (quotient / 256) * 256), byte_offset_overflow_quotient_high_band_digest(
        quotient: quotient / 256,
        limbs_remaining: limbs_remaining - 1
      ))
  }
}

fn byte_offset_overflow_residual_discarded_high_digest(quotient: Int) -> std.types.ContentHash {
  if quotient < 65536 {
    std.content_hash.content_hash_atom(value: ^canonical_tag_byte_offset_overflow_residual_discarded_high_zero)
  } else {
    std.content_hash.content_hash_combine(std.content_hash.content_hash_atom(value: ^canonical_tag_byte_offset_overflow_residual_discarded_high_band), byte_offset_overflow_quotient_high_band_digest(
        quotient: quotient / 65536,
        limbs_remaining: byte_offset_cache_digest_overflow_limbs
      ))
  }
}

fn byte_offset_cache_digest_ineligible_witness_digest(
  within_ceiling_digest: std.types.ContentHash,
  boundary_tag: Symbol,
  quotient: Int
) -> std.types.ContentHash {
  if boundary_tag == ^canonical_tag_byte_offset_overflow_residual_unrepresentable {
    byte_offset_cache_digest_ineligible_hash(
      within_ceiling_digest: std.content_hash.content_hash_combine(within_ceiling_digest, std.content_hash.content_hash_combine(byte_offset_overflow_residual_discarded_high_digest(quotient: quotient), byte_offset_residual_quotient_magnitude_digest(quotient: quotient))),
      boundary_tag: boundary_tag
    )
  } else {
    byte_offset_cache_digest_ineligible_hash(
      within_ceiling_digest: within_ceiling_digest,
      boundary_tag: boundary_tag
    )
  }
}

fn byte_offset_cache_digest_ineligible_hash(
  within_ceiling_digest: std.types.ContentHash,
  boundary_tag: Symbol
) -> std.types.ContentHash {
  std.content_hash.content_hash_combine(std.content_hash.content_hash_atom(value: ^canonical_tag_byte_offset_cache_digest_ineligible), std.content_hash.content_hash_combine(within_ceiling_digest, std.content_hash.content_hash_atom(value: boundary_tag)))
}

fn byte_offset_cache_digest_overflow_quotient_peel_bounded_authority(
  quotient: Int,
  limbs_remaining: Int
) -> ByteOffsetCacheDigestAuthority {
  if limbs_remaining == 0 {
    if quotient == 0 {
      ByteOffsetWithinCeiling {
        digest: std.content_hash.content_hash_atom(value: ^canonical_tag_byte_offset_zero)
      }
    } else if quotient < 256 * 256 {
      ByteOffsetWithinCeiling {
        digest: std.content_hash.content_hash_combine(std.content_hash.content_hash_atom(value: ^canonical_tag_byte_offset_overflow_peel_exhausted), std.content_hash.content_hash_combine(byte_offset_byte_digest(b: quotient - (quotient / 256) * 256), byte_offset_byte_digest(b: quotient / 256)))
      }
    } else {
      ByteOffsetCacheDigestIneligible {
        within_ceiling_digest: std.content_hash.content_hash_combine(std.content_hash.content_hash_atom(value: ^canonical_tag_byte_offset_overflow_peel_exhausted), std.content_hash.content_hash_combine(byte_offset_byte_digest(b: quotient - (quotient / 256) * 256), byte_offset_byte_digest(b: (quotient / 256) - (quotient / 65536) * 256))),
        boundary_tag: ^canonical_tag_byte_offset_overflow_residual_unrepresentable,
        residual_quotient: quotient
      }
    }
  } else if quotient == 0 {
    ByteOffsetWithinCeiling {
      digest: std.content_hash.content_hash_atom(value: ^canonical_tag_byte_offset_zero)
    }
  } else {
    match byte_offset_cache_digest_overflow_quotient_peel_bounded_authority(
      quotient: quotient / 256,
      limbs_remaining: limbs_remaining - 1
    ) {
      ByteOffsetWithinCeiling { digest: tail } =>
        ByteOffsetWithinCeiling {
          digest: std.content_hash.content_hash_combine(byte_offset_byte_digest(b: quotient - (quotient / 256) * 256), tail)
        }
      ByteOffsetCacheDigestIneligible {
        within_ceiling_digest: within_ceiling_digest,
        boundary_tag: boundary_tag,
        residual_quotient: residual_quotient
      } =>
        ByteOffsetCacheDigestIneligible {
          within_ceiling_digest: std.content_hash.content_hash_combine(byte_offset_byte_digest(b: quotient - (quotient / 256) * 256), within_ceiling_digest),
          boundary_tag: boundary_tag,
          residual_quotient: quotient
        }
      ByteOffsetOverCeiling {
        within_ceiling_digest: within_ceiling_digest,
        quotient: _
      } =>
        ByteOffsetCacheDigestIneligible {
          within_ceiling_digest: std.content_hash.content_hash_combine(byte_offset_byte_digest(b: quotient - (quotient / 256) * 256), within_ceiling_digest),
          boundary_tag: ^canonical_tag_byte_offset_overflow_residual_unrepresentable,
          residual_quotient: quotient
        }
    }
  }
}

fn byte_offset_cache_digest_overflow_tail_authority(quotient: Int) -> ByteOffsetCacheDigestAuthority {
  match byte_offset_cache_digest_nonneg_bounded_authority(
    i: quotient,
    limbs_remaining: byte_offset_cache_digest_overflow_limbs
  ) {
    ByteOffsetWithinCeiling { digest: digest } =>
      ByteOffsetWithinCeiling { digest: digest }
    ByteOffsetOverCeiling {
      within_ceiling_digest: prefix,
      quotient: tail
    } =>
      match byte_offset_cache_digest_overflow_quotient_peel_bounded_authority(
        quotient: tail,
        limbs_remaining: byte_offset_cache_digest_overflow_limbs
      ) {
        ByteOffsetWithinCeiling { digest: digest } =>
          ByteOffsetWithinCeiling {
            digest: std.content_hash.content_hash_combine(prefix, digest)
          }
        ByteOffsetCacheDigestIneligible {
          within_ceiling_digest: peel_within_ceiling_digest,
          boundary_tag: boundary_tag,
          residual_quotient: residual_quotient
        } =>
          ByteOffsetCacheDigestIneligible {
            within_ceiling_digest: std.content_hash.content_hash_combine(prefix, peel_within_ceiling_digest),
            boundary_tag: boundary_tag,
            residual_quotient: tail
          }
        ByteOffsetOverCeiling {
          within_ceiling_digest: peel_within_ceiling_digest,
          quotient: _
        } =>
          ByteOffsetCacheDigestIneligible {
            within_ceiling_digest: std.content_hash.content_hash_combine(prefix, peel_within_ceiling_digest),
            boundary_tag: ^canonical_tag_byte_offset_overflow_residual_unrepresentable,
            residual_quotient: tail
          }
      }
    ByteOffsetCacheDigestIneligible {
      within_ceiling_digest: within_ceiling_digest,
      boundary_tag: boundary_tag,
      residual_quotient: residual_quotient
    } =>
      ByteOffsetCacheDigestIneligible {
        within_ceiling_digest: within_ceiling_digest,
        boundary_tag: boundary_tag,
        residual_quotient: residual_quotient
      }
  }
}

fn byte_offset_cache_key_from_authority(auth: ByteOffsetCacheDigestAuthority) -> ByteOffsetCacheKey {
  match auth {
    ByteOffsetWithinCeiling { digest: digest } =>
      ByteOffsetCacheEligible { digest: digest }
    ByteOffsetCacheDigestIneligible {
      within_ceiling_digest: within_ceiling_digest,
      boundary_tag: boundary_tag,
      residual_quotient: residual_quotient
    } =>
      ByteOffsetCacheIneligible {
        boundary_tag: boundary_tag,
        witness: byte_offset_cache_digest_ineligible_witness_digest(
          within_ceiling_digest: within_ceiling_digest,
          boundary_tag: boundary_tag,
          quotient: residual_quotient
        )
      }
    ByteOffsetOverCeiling {
      within_ceiling_digest: within_ceiling_digest,
      quotient: quotient
    } =>
      match byte_offset_cache_digest_overflow_tail_authority(quotient: quotient) {
        ByteOffsetCacheDigestIneligible {
          within_ceiling_digest: tail_within_ceiling_digest,
          boundary_tag: boundary_tag,
          residual_quotient: residual_quotient
        } =>
          ByteOffsetCacheIneligible {
            boundary_tag: boundary_tag,
            witness: byte_offset_cache_digest_ineligible_witness_digest(
              within_ceiling_digest: std.content_hash.content_hash_combine(within_ceiling_digest, tail_within_ceiling_digest),
              boundary_tag: boundary_tag,
              quotient: residual_quotient
            )
          }
        ByteOffsetWithinCeiling { digest: tail_digest } =>
          ByteOffsetCacheEligible {
            digest: std.content_hash.content_hash_combine(std.content_hash.content_hash_atom(value: ^canonical_tag_byte_offset_out_of_ceiling), std.content_hash.content_hash_combine(within_ceiling_digest, tail_digest))
          }
        ByteOffsetOverCeiling {
          within_ceiling_digest: tail_within_ceiling_digest,
          quotient: _
        } =>
          ByteOffsetCacheIneligible {
            boundary_tag: ^canonical_tag_byte_offset_overflow_residual_unrepresentable,
            witness: byte_offset_cache_digest_ineligible_witness_digest(
              within_ceiling_digest: std.content_hash.content_hash_combine(within_ceiling_digest, tail_within_ceiling_digest),
              boundary_tag: ^canonical_tag_byte_offset_overflow_residual_unrepresentable,
              quotient: quotient
            )
          }
      }
  }
}

fn byte_offset_cache_digest_nonneg_bounded_authority(
  i: Int,
  limbs_remaining: Int
) -> ByteOffsetCacheDigestAuthority {
  if limbs_remaining == 0 {
    if i == 0 {
      ByteOffsetWithinCeiling {
        digest: std.content_hash.content_hash_atom(value: ^canonical_tag_byte_offset_zero)
      }
    } else {
      ByteOffsetOverCeiling {
        within_ceiling_digest: std.content_hash.content_hash_atom(value: ^canonical_tag_byte_offset_zero),
        quotient: i
      }
    }
  } else if i == 0 {
    ByteOffsetWithinCeiling {
      digest: std.content_hash.content_hash_atom(value: ^canonical_tag_byte_offset_zero)
    }
  } else {
    match byte_offset_cache_digest_nonneg_bounded_authority(
      i: i / 256,
      limbs_remaining: limbs_remaining - 1
    ) {
      ByteOffsetWithinCeiling { digest: tail } =>
        ByteOffsetWithinCeiling {
          digest: std.content_hash.content_hash_combine(byte_offset_byte_digest(b: i - (i / 256) * 256), tail)
        }
      ByteOffsetOverCeiling {
        within_ceiling_digest: prefix,
        quotient: quotient
      } =>
        ByteOffsetOverCeiling {
          within_ceiling_digest: std.content_hash.content_hash_combine(byte_offset_byte_digest(b: i - (i / 256) * 256), prefix),
          quotient: quotient
        }
      ByteOffsetCacheDigestIneligible {
        within_ceiling_digest: within_ceiling_digest,
        boundary_tag: boundary_tag,
        residual_quotient: residual_quotient
      } =>
        ByteOffsetCacheDigestIneligible {
          within_ceiling_digest: std.content_hash.content_hash_combine(byte_offset_byte_digest(b: i - (i / 256) * 256), within_ceiling_digest),
          boundary_tag: boundary_tag,
          residual_quotient: residual_quotient
        }
    }
  }
}

fn byte_offset_cache_digest_nonneg_authority(i: Int) -> ByteOffsetCacheDigestAuthority {
  byte_offset_cache_digest_nonneg_bounded_authority(
    i: i,
    limbs_remaining: byte_offset_cache_digest_max_limbs
  )
}

fn byte_offset_cache_digest_authority(i: Int) -> ByteOffsetCacheDigestAuthority {
  if i < 0 {
    match byte_offset_cache_digest_nonneg_authority(i: 0 - i) {
      ByteOffsetWithinCeiling { digest: digest } =>
        ByteOffsetWithinCeiling {
          digest: std.content_hash.content_hash_combine(std.content_hash.content_hash_atom(value: ^canonical_tag_byte_offset_neg), digest)
        }
      ByteOffsetOverCeiling {
        within_ceiling_digest: within_ceiling_digest,
        quotient: quotient
      } =>
        ByteOffsetOverCeiling {
          within_ceiling_digest: std.content_hash.content_hash_combine(std.content_hash.content_hash_atom(value: ^canonical_tag_byte_offset_neg), within_ceiling_digest),
          quotient: quotient
        }
      ByteOffsetCacheDigestIneligible {
        within_ceiling_digest: within_ceiling_digest,
        boundary_tag: boundary_tag,
        residual_quotient: residual_quotient
      } =>
        ByteOffsetCacheDigestIneligible {
          within_ceiling_digest: std.content_hash.content_hash_combine(std.content_hash.content_hash_atom(value: ^canonical_tag_byte_offset_neg), within_ceiling_digest),
          boundary_tag: boundary_tag,
          residual_quotient: residual_quotient
        }
    }
  } else {
    byte_offset_cache_digest_nonneg_authority(i: i)
  }
}

fn node_offset_atom(sym: Symbol) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Atom { identity: sym } },
    children: []
  )
}

fn node_offset_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn node_offset_conj(children: List<Edge>) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: children
  )
}

fn byte_offset_byte_limb_projection_node(limb: Int) -> Node {
  if limb < 0 || limb > 255 {
    node_offset_atom(sym: ^canonical_tag_byte_limb_out_of_range)
  } else if limb == 0 {
    node_offset_atom(sym: ^canonical_tag_scalar_int_zero)
  } else if limb == 1 {
    node_offset_atom(sym: ^canonical_tag_scalar_int_one)
  } else {
    node_offset_conj(children: [
      node_offset_named_edge(
        name: ^byte_offset_proj_succ_edge,
        target: node_offset_atom(sym: ^canonical_tag_scalar_int_succ)
      ),
      node_offset_named_edge(
        name: ^byte_offset_proj_pred_edge,
        target: byte_offset_byte_limb_projection_node(limb: limb - 1)
      )
    ])
  }
}

fn byte_offset_digest_nonneg_projection_bounded(i: Int, limbs_remaining: Int) -> Node {
  if limbs_remaining <= 0 {
    if i == 0 {
      node_offset_atom(sym: ^canonical_tag_byte_offset_zero)
    } else {
      node_offset_conj(children: [
        node_offset_named_edge(
          name: ^byte_offset_proj_out_of_ceiling_edge,
          target: node_offset_atom(sym: ^canonical_tag_byte_offset_out_of_ceiling)
        ),
        node_offset_named_edge(
          name: ^byte_offset_proj_authority_edge,
          target: node_offset_atom(sym: ^canonical_tag_byte_offset_zero)
        ),
        node_offset_named_edge(
          name: ^byte_offset_proj_byte_limb_edge,
          target: byte_offset_byte_limb_projection_node(limb: i - (i / 256) * 256)
        )
      ])
    }
  } else if i == 0 {
    node_offset_atom(sym: ^canonical_tag_byte_offset_zero)
  } else if i <= 255 {
    byte_offset_byte_limb_projection_node(limb: i)
  } else {
    node_offset_conj(children: [
      node_offset_named_edge(
        name: ^byte_offset_proj_out_of_ceiling_edge,
        target: node_offset_atom(sym: ^canonical_tag_byte_offset_out_of_ceiling)
      ),
      node_offset_named_edge(
        name: ^byte_offset_proj_authority_edge,
        target: byte_offset_digest_nonneg_projection_bounded(
          i: i / 256,
          limbs_remaining: limbs_remaining - 1
        )
      ),
      node_offset_named_edge(
        name: ^byte_offset_proj_byte_limb_edge,
        target: byte_offset_byte_limb_projection_node(limb: i - (i / 256) * 256)
      )
    ])
  }
}

fn byte_offset_cache_digest_authority_projection_node(i: Int) -> Node {
  if i < 0 {
    node_offset_conj(children: [
      node_offset_named_edge(
        name: ^byte_offset_proj_neg_edge,
        target: node_offset_atom(sym: ^canonical_tag_byte_offset_neg)
      ),
      node_offset_named_edge(
        name: ^byte_offset_proj_authority_edge,
        target: byte_offset_digest_nonneg_projection_bounded(
          i: 0 - i,
          limbs_remaining: byte_offset_cache_digest_max_limbs
        )
      )
    ])
  } else {
    byte_offset_digest_nonneg_projection_bounded(
      i: i,
      limbs_remaining: byte_offset_cache_digest_max_limbs
    )
  }
}

fn byte_offset_cache_key_projection_node(i: Int) -> Node {
  match byte_offset_cache_key(i: i) {
    ByteOffsetCacheEligible { digest: _ } =>
      match byte_offset_cache_digest_authority(i: i) {
        ByteOffsetWithinCeiling { digest: _ } =>
          node_offset_conj(children: [
            node_offset_named_edge(
              name: ^byte_offset_proj_key_eligible_edge,
              target: node_offset_atom(sym: ^canonical_tag_byte_offset_cache_key_eligible)
            ),
            node_offset_named_edge(
              name: ^byte_offset_proj_within_ceiling_edge,
              target: byte_offset_cache_digest_authority_projection_node(i: i)
            )
          ])
        ByteOffsetOverCeiling { within_ceiling_digest: _, quotient: _ } =>
          node_offset_conj(children: [
            node_offset_named_edge(
              name: ^byte_offset_proj_key_eligible_edge,
              target: node_offset_atom(sym: ^canonical_tag_byte_offset_cache_key_eligible)
            ),
            node_offset_named_edge(
              name: ^byte_offset_proj_over_ceiling_edge,
              target: node_offset_atom(sym: ^canonical_tag_byte_offset_out_of_ceiling)
            ),
            node_offset_named_edge(
              name: ^byte_offset_proj_authority_edge,
              target: byte_offset_cache_digest_authority_projection_node(i: i)
            )
          ])
        ByteOffsetCacheDigestIneligible {
          within_ceiling_digest: _,
          boundary_tag: boundary_tag,
          residual_quotient: _
        } =>
          node_offset_conj(children: [
            node_offset_named_edge(
              name: ^byte_offset_proj_key_eligible_edge,
              target: node_offset_atom(sym: ^canonical_tag_byte_offset_cache_key_eligible)
            ),
            node_offset_named_edge(
              name: ^byte_offset_proj_ineligible_authority_edge,
              target: node_offset_atom(sym: ^canonical_tag_byte_offset_cache_digest_ineligible)
            ),
            node_offset_named_edge(
              name: ^byte_offset_proj_boundary_edge,
              target: node_offset_atom(sym: boundary_tag)
            )
          ])
      }
    ByteOffsetCacheIneligible { boundary_tag: boundary_tag, witness: _ } =>
      node_offset_conj(children: [
        node_offset_named_edge(
          name: ^byte_offset_proj_key_ineligible_edge,
          target: node_offset_atom(sym: ^canonical_tag_byte_offset_cache_key_ineligible)
        ),
        node_offset_named_edge(
          name: ^byte_offset_proj_boundary_edge,
          target: node_offset_atom(sym: boundary_tag)
        ),
        node_offset_named_edge(
          name: ^byte_offset_proj_ineligible_authority_edge,
          target: node_offset_atom(sym: ^canonical_tag_byte_offset_cache_digest_ineligible)
        )
      ])
  }
}

fn byte_offset_cache_key(i: Int) -> ByteOffsetCacheKey {
  byte_offset_cache_key_from_authority(auth: byte_offset_cache_digest_authority(i: i))
}

fn byte_offset_cache_key_fingerprint(key: ByteOffsetCacheKey) -> std.types.ContentHash {
  match key {
    ByteOffsetCacheEligible { digest: digest } =>
      std.content_hash.content_hash_combine(std.content_hash.content_hash_atom(value: ^canonical_tag_byte_offset_cache_key_eligible), digest)
    ByteOffsetCacheIneligible {
      boundary_tag: boundary_tag,
      witness: witness
    } =>
      std.content_hash.content_hash_combine(std.content_hash.content_hash_atom(value: ^canonical_tag_byte_offset_cache_key_ineligible), std.content_hash.content_hash_combine(std.content_hash.content_hash_atom(value: boundary_tag), witness))
  }
}

fn bag_hash_digest(empty: std.types.ContentHash, xs: List<std.types.ContentHash>) -> std.types.ContentHash {
  fold(
    sort_by(xs, fn(h) { h }),
    init: empty,
    f: fn(acc, h) {
      std.content_hash.content_hash_combine(acc, h)
    }
  )
}

fn content_hash(n: Node) -> std.types.ContentHash {
  fold_node_content_hash(
    n: n,
    algebra: NodeFold {
      init: fn(n0) { canonical_hash_of_node_kind(kind: n0.kind) },
      step: fn(acc, e, child_hash) {
        std.content_hash.content_hash_combine(std.content_hash.content_hash_combine(acc, canonical_hash_of_edge_label(label: e.label)), child_hash)
      }
    }
  )
}

type NodeQuery
  = NodeQueryByConnective { connective: Connective }
  | NodeQueryByPath { at: Path }

type Path {
  steps: List<Symbol>
}
type Edit {
  at: Path
  replacement: Node
}
type Diff {
  edits: List<Edit>
}
