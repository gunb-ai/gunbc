module v2.std.node



type Symbol
type Hash = std.content_hash.Fnv1a64Structural


data node_occurrence_id_v2_facade_note: String = "TEMPORARY COMPATIBILITY: v2 callers still construct and match this source-compatible coproduct while v2.std.node.NodeOccurrenceId is the sole shared semantic authority. The total conversions below are the only bridge; new consumers use the shared carrier directly."

type NodeOccurrenceId
  = SyntheticOccurrence
  | MintedOccurrence { id: std.occurrence_identity.OccurrenceId }

fn node_occurrence_id_to_shared(
  occurrence: v2.std.node.NodeOccurrenceId
) -> std.occurrence_identity.NodeOccurrenceIdentity {
  match occurrence {
    SyntheticOccurrence =>
      std.occurrence_identity.OccurrenceSynthetic
    MintedOccurrence { id: id } =>
      std.occurrence_identity.OccurrenceMinted { id: id }
  }
}

fn node_occurrence_id_from_shared(
  occurrence: std.occurrence_identity.NodeOccurrenceIdentity
) -> v2.std.node.NodeOccurrenceId {
  match occurrence {
    std.occurrence_identity.OccurrenceSynthetic =>
      SyntheticOccurrence
    std.occurrence_identity.OccurrenceMinted { id: id } =>
      MintedOccurrence { id: id }
  }
}

fn node_occurrence_minted(id: std.occurrence_identity.OccurrenceId) -> v2.std.node.NodeOccurrenceId {
  node_occurrence_id_from_shared(
    occurrence: std.occurrence_identity.node_occurrence_identity_minted(id: id)
  )
}

type Connective
  = Atom { identity: v2.std.node.Symbol }
  | Conj
  | Disj
  | Arrow
  | Cardinality
  | Instantiation

type Behavior
  = Value
  | Transform
  | Branch
  | Loop
  | Bind
  | Match

fn resolve_type_node(type_name: v2.std.node.Symbol) -> v2.std.node.Node {
  resolve_type_node(type_name: type_name)
}

type ArmPayload
  = Nullary
  | Typed { target_ref: v2.std.node.Symbol }

type CoproductArm {
  label: v2.std.node.Symbol
  payload: v2.std.node.ArmPayload
}

type CoproductArmPayloadPair {
  label: v2.std.node.Symbol
  payload_type_name: v2.std.node.Symbol
}

data coproduct_nullary_payload_type_name: v2.std.node.Symbol = ^coproduct_nullary_payload

type ConnectiveCoproductVariant
  = ConnectiveAtomArm
  | ConnectiveConjArm
  | ConnectiveDisjArm
  | ConnectiveArrowArm
  | ConnectiveCardinalityArm
  | ConnectiveInstantiationArm

fn connective_coproduct_variant_keys() -> List<v2.std.node.ConnectiveCoproductVariant> {
  [
    ConnectiveAtomArm,
    ConnectiveConjArm,
    ConnectiveDisjArm,
    ConnectiveArrowArm,
    ConnectiveCardinalityArm,
    ConnectiveInstantiationArm,
  ]
}

fn connective_from_coproduct_variant(
  variant: v2.std.node.ConnectiveCoproductVariant,
  atom_identity: v2.std.node.Symbol
) -> v2.std.node.Connective {
  match variant {
    ConnectiveAtomArm => Atom { identity: atom_identity }
    ConnectiveConjArm => Conj
    ConnectiveDisjArm => Disj
    ConnectiveArrowArm => Arrow
    ConnectiveCardinalityArm => Cardinality
    ConnectiveInstantiationArm => Instantiation
  }
}

fn behavior_coproduct_variants() -> List<v2.std.node.Behavior> {
  [Value, Transform, Branch, Loop, Bind, Match]
}

data match_arm_pattern: v2.std.node.Symbol = ^match_arm_pattern
data match_arm_body: v2.std.node.Symbol = ^match_arm_body

type NodeKind
  = TypeNode { connective: v2.std.node.Connective }
  | ComputationNode { behavior: v2.std.node.Behavior }

type EdgeLabel
  = Named { name: v2.std.node.Symbol }
  | Positional
type Edge {
  label: v2.std.node.EdgeLabel
  target: v2.std.node.Node
}

type EdgeShape {
  label: v2.std.node.EdgeLabel
  target: v2.std.node.NodeShape
}
type NodeShape {
  kind: v2.std.node.NodeKind
  children: List<v2.std.node.EdgeShape>
}

fn node_with_occurrence_id(
  kind: v2.std.node.NodeKind,
  children: List<v2.std.node.Edge>,
  occurrence_id: v2.std.node.NodeOccurrenceId
) -> v2.std.node.Node {
  v2.std.node.Node { kind: kind, children: children, occurrence_id: occurrence_id }
}

fn node_rebuild(n: v2.std.node.Node, children: List<v2.std.node.Edge>) -> v2.std.node.Node {
  node_with_occurrence_id(
    kind: n.kind,
    children: children,
    occurrence_id: n.occurrence_id
  )
}

fn node_synthetic(kind: v2.std.node.NodeKind, children: List<v2.std.node.Edge>) -> v2.std.node.Node {
  node_with_occurrence_id(
    kind: kind,
    children: children,
    occurrence_id: SyntheticOccurrence
  )
}

fn node_for_structural_equality(n: v2.std.node.Node) -> v2.std.node.Node {
  node_with_occurrence_id(
    kind: n.kind,
    children: n.children,
    occurrence_id: SyntheticOccurrence
  )
}

fn strip_provenance_fold_init(n: v2.std.node.Node) -> v2.std.node.Node {
  node_synthetic(kind: n.kind, children: [])
}

fn strip_provenance_fold_step(acc: v2.std.node.Node, edge: v2.std.node.Edge, child: v2.std.node.Node) -> v2.std.node.Node {
  node_rebuild(
    n: acc,
    children: concat(acc.children, [Edge { label: edge.label, target: child }])
  )
}

fn strip_provenance_fold_algebra() -> v2.std.node.NodeFold<v2.std.node.Node> {
  NodeFold {
    init: strip_provenance_fold_init,
    step: strip_provenance_fold_step
  }
}

fn canonicalize_node_strip_provenance(n: v2.std.node.Node) -> v2.std.node.Node {
  fold_node(n: n, algebra: strip_provenance_fold_algebra())
}

type Node {
  kind: v2.std.node.NodeKind
  children: v2.std.collection.List<v2.std.node.Edge>
  occurrence_id: v2.std.node.NodeOccurrenceId
}
type NodeFold<R> {
  init: fn(v2.std.node.Node) -> R
  step: fn(R, v2.std.node.Edge, R) -> R
}
fn fold_node<R>(n: v2.std.node.Node, algebra: v2.std.node.NodeFold<R>) -> R {
  fold(n.children, init: algebra.init(n), f: fn(acc, e) {
    algebra.step(acc, e, fold_node(n: e.target, algebra: algebra))
  })
}

fn node_subtree_nodes(root: v2.std.node.Node) -> List<v2.std.node.Node> {
  fold_node(
    n: root,
    algebra: v2.std.node.NodeFold {
      init: fn(self) { [self] },
      step: fn(acc, _edge, sub) { concat(acc, sub) }
    }
  )
}

fn node_subtree_count(n: v2.std.node.Node) -> Int {
  fold_node(
    n: n,
    algebra: v2.std.node.NodeFold {
      init: fn(_) { 1 },
      step: fn(acc, _edge, child_count) { acc + child_count }
    }
  )
}

type NodeFoldTopDown<A,R> {
  init: fn(v2.std.node.Node, A) -> R
  child_context: fn(v2.std.node.Node, A, v2.std.node.Edge) -> A
  step: fn(R, v2.std.node.Edge, R) -> R
}
fn fold_node_topdown<A,R>(n: v2.std.node.Node, ctx: A, algebra: v2.std.node.NodeFoldTopDown<A,R>) -> R {
  fold(n.children, init: algebra.init(n, ctx), f: fn(acc, e) {
    algebra.step(acc, e, fold_node_topdown(n: e.target, ctx: algebra.child_context(n, ctx, e), algebra: algebra))
  })
}

type EdgeDiscipline
  = NoEdges
  | LabeledEdges
  | PositionalEdges

  | LoopBoundEdges

  | ArrowBodyEdges

data atom_payload_labeled_edges_scaffold_note: String = "🟡 dissolve-on: Atom connectives with labeled payload children (int-literal magnitude on ^dag_token_int_literal via ^integer_literal_magnitude_field) — atom_connective_edge_discipline(child_count) is the single authority (NoEdges when child_count==0, LabeledEdges otherwise); connective_edge_discipline_for_children delegates Atom through it. Not a new connective: the payload is a typed named field, not an open Conj record. Reconcile when int-literal lowering lands a dedicated connective or magnitude lives only on the magnitude subnode without widening Atom discipline."

fn atom_connective_edge_discipline(child_count: Int) -> v2.std.node.EdgeDiscipline {
  if child_count == 0 {
    NoEdges
  } else {
    LabeledEdges
  }
}

fn connective_edge_discipline(c: v2.std.node.Connective) -> v2.std.node.EdgeDiscipline {
  match c {
    Atom { identity: _ } => atom_connective_edge_discipline(child_count: 0)
    Conj => LabeledEdges
    Disj => LabeledEdges
    Arrow => ArrowBodyEdges
    Cardinality => PositionalEdges
    Instantiation => PositionalEdges
  }
}

fn connective_edge_discipline_for_children(c: v2.std.node.Connective, children: List<v2.std.node.Edge>) -> v2.std.node.EdgeDiscipline {
  match c {
    Atom { identity: _ } =>
      atom_connective_edge_discipline(child_count: count(children))
    _ => connective_edge_discipline(c: c)
  }
}

fn is_named(e: v2.std.node.Edge) -> Bool {
  match e.label {
    Named { name: _ } => true
    Positional => false
  }
}

fn is_positional(e: v2.std.node.Edge) -> Bool {
  match e.label {
    Named { name: _ } => false
    Positional => true
  }
}

fn all_edges_named(children: List<v2.std.node.Edge>) -> Bool {
  fold(children, init: true, f: fn(acc, e) {
    acc && is_named(e: e)
  })
}

fn all_edges_positional(children: List<v2.std.node.Edge>) -> Bool {
  fold(children, init: true, f: fn(acc, e) {
    acc && is_positional(e: e)
  })
}
fn name_occurrences(name: v2.std.node.Symbol, children: List<v2.std.node.Edge>) -> Int {
  fold(children, init: 0, f: fn(acc, e) {
    match e.label {
      Named { name: n } => if n == name { acc + 1 } else { acc }
      Positional => acc
    }
  })
}
fn positional_child_count(children: List<v2.std.node.Edge>) -> Int {
  fold(children, init: 0, f: fn(acc, e) {
    match e.label {
      Positional => acc + 1
      Named { name: _ } => acc
    }
  })
}

fn loop_positional_child_count(children: List<v2.std.node.Edge>) -> Int {
  positional_child_count(children: children)
}

fn loop_body_edges_conform(children: List<v2.std.node.Edge>) -> Bool {
  fold(children, init: true, f: fn(acc, e) {
    match e.label {
      Positional => acc
      Named { name: sym } => acc && ((sym == ^loop_bound_edge) || (sym == ^loop_carrier_edge))
    }
  })
}

fn loop_behavior_edges_conform(children: List<v2.std.node.Edge>) -> Bool {
  let bound_edges = name_occurrences(name: ^loop_bound_edge, children: children)
  let carrier_edges = name_occurrences(name: ^loop_carrier_edge, children: children)
  (bound_edges == 1)
  && (carrier_edges <= 1)
  && loop_body_edges_conform(children: children)
  && (loop_positional_child_count(children: children) >= 1)
}

fn arrow_signature_edges_conform(children: List<v2.std.node.Edge>) -> Bool {
  fold(children, init: true, f: fn(acc, e) {
    match e.label {
      Positional => acc
      Named { name: sym } => acc && (sym == ^arrow_body_edge)
    }
  })
}

type NamedEdgeTargetLookup
  = Found { target: v2.std.node.Node }
  | Ambiguous
  | Absent

fn named_edge_target_lookup(children: List<v2.std.node.Edge>, name: v2.std.node.Symbol) -> v2.std.node.NamedEdgeTargetLookup {
  fold(children, init: Absent, f: fn(acc, e) {
    match e.label {
      Named { name: sym } =>
        if sym == name {
          match acc {
            Absent => Found { target: e.target }
            Found { target: _ } => Ambiguous
            Ambiguous => Ambiguous
          }
        } else {
          acc
        }
      Positional => acc
    }
  })
}

fn arrow_body_target_lookup(children: List<v2.std.node.Edge>) -> v2.std.node.NamedEdgeTargetLookup {
  named_edge_target_lookup(children: children, name: ^arrow_body_edge)
}

// ArrowBodyForm classifies arrow-body targets for structural admission
// (arrow_body_target_is_valid_realization in well_formed) and eval entry
// (arrow_body_admits_eval_entry in v2.compiler.eval). It carries NO identity:
// arrow-body content identity is content_hash over the full body subtree
// (fold_node_content_hash), which preserves atom identity via
// canonical_hash_of_connective. Refusing a form-level digest that hashes only
// canonical_hash_of_behavior is deliberate — behavior tag alone erases Value
// payloads and repeats the InterpretationAlgebra fork where a partial slot digest
// lets distinct semantics share cache identity. Computation child/edge discipline
// is behavior_edges_conform in locally_well_formed only; ArrowBodyForm does not
// re-check computation edges. Record Conj field wiring is the only
// ArrowBodyForm-specific structural gate beyond classification
// (arrow_body_record_construct_conforms).
type ArrowBodyForm
  = DirectAtomBody
  | RecordConstructBody
  | ComputationBody { behavior: v2.std.node.Behavior }
  | UnsupportedArrowBody

fn classify_arrow_body_form(target: v2.std.node.Node) -> v2.std.node.ArrowBodyForm {
  match target.kind {
    TypeNode { connective: Atom { identity: _ } } => DirectAtomBody
    TypeNode { connective: Conj } => RecordConstructBody
    ComputationNode { behavior: b } => ComputationBody { behavior: b }
    _ => UnsupportedArrowBody
  }
}

fn arrow_body_admits_eval_entry(form: v2.std.node.ArrowBodyForm) -> Bool {
  match form {
    UnsupportedArrowBody => false
    DirectAtomBody => true
    RecordConstructBody => false
    ComputationBody { behavior: Value } => false
    ComputationBody { behavior: Transform } => true
    ComputationBody { behavior: Branch } => true
    ComputationBody { behavior: Loop } => true
    ComputationBody { behavior: Bind } => true
    ComputationBody { behavior: Match } => false
  }
}

fn arrow_body_record_construct_conforms(node: v2.std.node.Node) -> Bool {
  match node.kind {
    TypeNode { connective: Conj } =>
      if !all_edges_named(children: node.children) {
        false
      } else {
        fold(node.children, init: false, f: fn(seen_first_named, edge) {
          if seen_first_named {
            seen_first_named
          } else {
            match edge.label {
              Named { name: _ } =>
                match edge.target.kind {
                  TypeNode { connective: Atom { identity: _ } } => true
                  _ => false
                }
              Positional => false
            }
          }
        })
      }
    _ => false
  }
}

fn arrow_body_target_is_valid_realization(target: v2.std.node.Node) -> Bool {
  match classify_arrow_body_form(target: target) {
    UnsupportedArrowBody => false
    RecordConstructBody => arrow_body_record_construct_conforms(node: target)
    DirectAtomBody => true
    ComputationBody { behavior: _ } => true
  }
}

fn arrow_body_target_conforms(children: List<v2.std.node.Edge>) -> Bool {
  match arrow_body_target_lookup(children: children) {
    Absent => true
    Found { target: t } => arrow_body_target_is_valid_realization(target: t)
    Ambiguous => false
  }
}

fn arrow_body_edges_conform(children: List<v2.std.node.Edge>) -> Bool {
  let body_edges = name_occurrences(name: ^arrow_body_edge, children: children)
  (body_edges <= 1)
  && arrow_signature_edges_conform(children: children)
  && (positional_child_count(children: children) >= 1)
  && arrow_body_target_conforms(children: children)
}
fn loop_bound_measure_target(children: List<v2.std.node.Edge>) -> v2.std.node.NamedEdgeTargetLookup {
  named_edge_target_lookup(children: children, name: ^loop_bound_edge)
}

fn loop_carrier_binder_target(children: List<v2.std.node.Edge>) -> v2.std.node.NamedEdgeTargetLookup {
  named_edge_target_lookup(children: children, name: ^loop_carrier_edge)
}

fn loop_edge_contributes_to_iteration_fold(parent: v2.std.node.Node, e: v2.std.node.Edge) -> Bool {
  match parent.kind {
    ComputationNode { behavior: Loop } =>
      match e.label {
        Positional => true
        Named { name: sym } => (sym != ^loop_bound_edge) && (sym != ^loop_carrier_edge)
      }
    _ =>
      match e.label {
        Positional => true
        Named { name: _ } => true
      }
  }
}

data edge_contributes_to_cost_fold_note: String = "Wave 1 Gate 1 C1: the symbolic cost fold prices only runtime work. Arrow signature/type positional children and domain Named edges are NOT runtime cost — only ^arrow_body_edge carries the body the fold must price (general-body-producer-design Stage C prerequisite). Loop keeps the iteration-fold edge discipline from loop_edge_contributes_to_iteration_fold; infer continues to use that function directly."

fn edge_contributes_to_cost_fold(parent: v2.std.node.Node, e: v2.std.node.Edge) -> Bool {
  match parent.kind {
    ComputationNode { behavior: Loop } =>
      match e.label {
        Positional => true
        Named { name: sym } => (sym != ^loop_bound_edge) && (sym != ^loop_carrier_edge)
      }
    TypeNode { connective: Arrow } =>
      match e.label {
        Positional => false
        Named { name: sym } => sym == ^arrow_body_edge
      }
    _ =>
      match e.label {
        Positional => true
        Named { name: _ } => true
      }
  }
}
fn all_names_distinct(children: List<v2.std.node.Edge>) -> Bool {
  fold(children, init: true, f: fn(acc, e) {
    match e.label {
      Named { name: n } => acc && (name_occurrences(name: n, children: children) == 1)
      Positional => acc
    }
  })
}
fn edges_conform(children: List<v2.std.node.Edge>, d: v2.std.node.EdgeDiscipline) -> Bool {
  match d {
    NoEdges => count(children) == 0
    LabeledEdges =>
      all_edges_named(children: children) && all_names_distinct(children: children)
    PositionalEdges => all_edges_positional(children: children)
    LoopBoundEdges => loop_behavior_edges_conform(children: children)
    ArrowBodyEdges => arrow_body_edges_conform(children: children)
  }
}

fn connective_edges_conform(children: List<v2.std.node.Edge>, c: v2.std.node.Connective) -> Bool {
  match c {
    Atom { identity: _ } =>
      edges_conform(
        children: children,
        d: connective_edge_discipline_for_children(c: c, children: children)
      )
    Conj => edges_conform(children: children, d: LabeledEdges)
    Disj => edges_conform(children: children, d: LabeledEdges)
    Arrow => arrow_body_edges_conform(children: children)
    Cardinality =>
      edges_conform(children: children, d: PositionalEdges) && (count(children) >= 1)
    Instantiation =>
      edges_conform(children: children, d: PositionalEdges) && (count(children) >= 1)
  }
}

fn match_arm_node_conforms(arm: v2.std.node.Node) -> Bool {
  match arm.kind {
    TypeNode { connective: Conj } =>
      name_occurrences(name: match_arm_pattern, children: arm.children) == 1
        && name_occurrences(name: match_arm_body, children: arm.children) == 1
    _ => false
  }
}

type MatchArmChildrenConformFold {
  ok: Bool
  skipped_scrutinee: Bool
}

fn match_arm_children_conform_skip_first(children: List<v2.std.node.Edge>, skipped_scrutinee: Bool) -> Bool {
  let folded = fold(
    children,
    init: v2.std.node.MatchArmChildrenConformFold { ok: true, skipped_scrutinee: skipped_scrutinee },
    f: fn(acc, edge) {
      if !acc.ok {
        acc
      } else {
        match edge.label {
          Positional =>
            if !acc.skipped_scrutinee {
              MatchArmChildrenConformFold { ok: true, skipped_scrutinee: true }
            } else if !match_arm_node_conforms(arm: edge.target) {
              MatchArmChildrenConformFold { ok: false, skipped_scrutinee: true }
            } else {
              MatchArmChildrenConformFold { ok: true, skipped_scrutinee: true }
            }
          Named { name: _ } => acc
        }
      }
    }
  )
  folded.ok && folded.skipped_scrutinee
}

fn behavior_edges_conform(children: List<v2.std.node.Edge>, b: v2.std.node.Behavior) -> Bool {
  match b {
    Value => count(children) == 0
    Transform => edges_conform(children: children, d: PositionalEdges) && (count(children) >= 1)
    Branch => edges_conform(children: children, d: PositionalEdges) && (count(children) >= 1)
    Loop => edges_conform(children: children, d: LoopBoundEdges)
    Bind => edges_conform(children: children, d: PositionalEdges) && (count(children) == 3)
    Match =>
      edges_conform(children: children, d: PositionalEdges)
        && (positional_child_count(children: children) >= 2)
        && match_arm_children_conform_skip_first(children: children, skipped_scrutinee: false)
  }
}
fn locally_well_formed(n: v2.std.node.Node) -> Bool {
  match n.kind {
      TypeNode { connective: c } => connective_edges_conform(children: n.children, c: c)
      ComputationNode { behavior: b } => behavior_edges_conform(children: n.children, b: b)
    }
}
fn well_formed(n: v2.std.node.Node) -> Bool {
  fold_node(
    n: n,
    algebra: v2.std.node.NodeFold {
      init: fn(n0) {
        locally_well_formed(n: n0)
      },
      step: fn(acc, _, child_ok) {
        acc && child_ok
      }
    }
  )
}

fn is_empty_conj_root(n: v2.std.node.Node) -> Bool {
  match n.kind {
    TypeNode { connective: Conj } => count(n.children) == 0
    _ => false
  }
}

fn behavior_edge_discipline(b: v2.std.node.Behavior) -> v2.std.node.EdgeDiscipline {
  match b {
    Value => NoEdges
    Transform => PositionalEdges
    Branch => PositionalEdges
    Loop => LoopBoundEdges
    Bind => PositionalEdges
    Match => PositionalEdges
  }
}
fn node_edge_discipline(n: v2.std.node.Node) -> v2.std.node.EdgeDiscipline {
  match n.kind {
    TypeNode { connective: c } =>
      connective_edge_discipline_for_children(c: c, children: n.children)
    ComputationNode { behavior: b } => behavior_edge_discipline(b: b)
  }
}
fn named_edge_sort_key(e: v2.std.node.Edge) -> v2.std.node.Symbol {
  match e.label {
    Named { name: sym } => sym
    Positional => ^canonical_tag_positional_edge
  }
}

fn arrow_signature_edges_for_content_hash(children: List<v2.std.node.Edge>) -> List<v2.std.node.Edge> {
  filter(children, fn(e) {
    match e.label {
      Positional => true
      Named { name: _ } => false
    }
  })
}
fn arrow_body_edges_for_content_hash(children: List<v2.std.node.Edge>) -> List<v2.std.node.Edge> {
  filter(children, fn(e) {
    match e.label {
      Named { name: sym } => sym == ^arrow_body_edge
      Positional => false
    }
  })
}
fn arrow_other_named_edges_for_content_hash(children: List<v2.std.node.Edge>) -> List<v2.std.node.Edge> {
  sort_by(
    filter(children, fn(e) {
      match e.label {
        Named { name: sym } => sym != ^arrow_body_edge
        Positional => false
      }
    }),
    fn(e) { named_edge_sort_key(e: e) }
  )
}
fn canonicalize_arrow_children_for_content_hash(children: List<v2.std.node.Edge>) -> List<v2.std.node.Edge> {
  concat(
    arrow_signature_edges_for_content_hash(children: children),
    concat(
      arrow_other_named_edges_for_content_hash(children: children),
      arrow_body_edges_for_content_hash(children: children)
    )
  )
}
fn loop_body_edges_for_content_hash(children: List<v2.std.node.Edge>) -> List<v2.std.node.Edge> {
  filter(children, fn(e) {
    match e.label {
      Positional => true
      Named { name: _ } => false
    }
  })
}
fn loop_bound_edges_for_content_hash(children: List<v2.std.node.Edge>) -> List<v2.std.node.Edge> {
  filter(children, fn(e) {
    match e.label {
      Named { name: sym } => sym == ^loop_bound_edge
      Positional => false
    }
  })
}
fn loop_other_named_edges_for_content_hash(children: List<v2.std.node.Edge>) -> List<v2.std.node.Edge> {
  sort_by(
    filter(children, fn(e) {
      match e.label {
        Named { name: sym } => sym != ^loop_bound_edge
        Positional => false
      }
    }),
    fn(e) { named_edge_sort_key(e: e) }
  )
}
fn canonicalize_loop_children_for_content_hash(children: List<v2.std.node.Edge>) -> List<v2.std.node.Edge> {
  concat(
    loop_body_edges_for_content_hash(children: children),
    concat(
      loop_other_named_edges_for_content_hash(children: children),
      loop_bound_edges_for_content_hash(children: children)
    )
  )
}
fn canonicalize_node_for_content_hash(n: v2.std.node.Node) -> v2.std.node.Node {
  let base = node_for_structural_equality(n: n)
  match node_edge_discipline(n: n) {
    LabeledEdges =>
      v2.std.node.Node {
        kind: base.kind,
        children: sort_by(base.children, fn(e) { named_edge_sort_key(e: e) }),
        occurrence_id: SyntheticOccurrence
      }
    NoEdges =>
      v2.std.node.Node {
        kind: base.kind,
        children: base.children,
        occurrence_id: SyntheticOccurrence
      }
    PositionalEdges =>
      v2.std.node.Node {
        kind: base.kind,
        children: base.children,
        occurrence_id: SyntheticOccurrence
      }
    ArrowBodyEdges =>
      v2.std.node.Node {
        kind: base.kind,
        children: canonicalize_arrow_children_for_content_hash(children: base.children),
        occurrence_id: SyntheticOccurrence
      }
    LoopBoundEdges =>
      v2.std.node.Node {
        kind: base.kind,
        children: canonicalize_loop_children_for_content_hash(children: base.children),
        occurrence_id: SyntheticOccurrence
      }
  }
}

fn fold_node_content_hash<R>(n: v2.std.node.Node, algebra: v2.std.node.NodeFold<R>) -> R {
  let n = canonicalize_node_for_content_hash(n: n)
  fold(n.children, init: algebra.init(n), f: fn(acc, e) {
    algebra.step(acc, e, fold_node_content_hash(n: e.target, algebra: algebra))
  })
}

fn canonical_hash_of_connective(c: v2.std.node.Connective) -> std.content_hash.Fnv1a64Structural {
  match c {
    Atom { identity: sym } =>
      content_hash_combine_structural(
        left: content_hash_atom(value: ^canonical_tag_atom),
        right: content_hash_atom(value: sym)
      )
    Conj => content_hash_atom(value: ^canonical_tag_conj)
    Disj => content_hash_atom(value: ^canonical_tag_disj)
    Arrow => content_hash_atom(value: ^canonical_tag_arrow)
    Cardinality => content_hash_atom(value: ^canonical_tag_cardinality)
    Instantiation => content_hash_atom(value: ^canonical_tag_instantiation)
  }
}

fn canonical_hash_of_behavior(b: v2.std.node.Behavior) -> std.content_hash.Fnv1a64Structural {
  match b {
    Value => content_hash_atom(value: ^canonical_tag_value)
    Transform => content_hash_atom(value: ^canonical_tag_transform)
    Branch => content_hash_atom(value: ^canonical_tag_branch)
    Loop => content_hash_atom(value: ^canonical_tag_loop)
    Bind => content_hash_atom(value: ^canonical_tag_bind)
    Match => content_hash_atom(value: ^canonical_tag_match)
  }
}

fn canonical_hash_of_node_kind(kind: v2.std.node.NodeKind) -> std.content_hash.Fnv1a64Structural {
  match kind {
    TypeNode { connective: c } =>
      content_hash_combine_structural(
        left: content_hash_atom(value: ^canonical_tag_type_node),
        right: canonical_hash_of_connective(c: c)
      )
    ComputationNode { behavior: b } =>
      content_hash_combine_structural(
        left: content_hash_atom(value: ^canonical_tag_computation_node),
        right: canonical_hash_of_behavior(b: b)
      )
  }
}

fn canonical_hash_of_edge_label(label: v2.std.node.EdgeLabel) -> std.content_hash.Fnv1a64Structural {
  match label {
    Named { name: sym } =>
      content_hash_combine_structural(
        left: content_hash_atom(value: ^canonical_tag_named_edge),
        right: content_hash_atom(value: sym)
      )
    Positional => content_hash_atom(value: ^canonical_tag_positional_edge)
  }
}

fn combine_hash(a: std.content_hash.Fnv1a64Structural, b: std.content_hash.Fnv1a64Structural) -> std.content_hash.Fnv1a64Structural {
  content_hash_combine_structural(left: a, right: b)
}

fn symbol_identity_digest(sym: v2.std.node.Symbol) -> v2.std.node.Hash {
  content_hash_atom(value: sym)
}

data byte_offset_residual_quotient_magnitude_shift_limbs: Int = 4

data byte_offset_residual_quotient_magnitude_max_shift: Int = 28
data byte_offset_cache_digest_max_limbs: Int = 9

data byte_offset_cache_digest_overflow_limbs: Int = 4

type ByteOffsetCacheDigestAuthority
  = ByteOffsetWithinCeiling { digest: std.content_hash.Fnv1a64Structural }
  | ByteOffsetOverCeiling {
      within_ceiling_digest: std.content_hash.Fnv1a64Structural,
      quotient: Int
    }
  | ByteOffsetCacheDigestIneligible {
      within_ceiling_digest: std.content_hash.Fnv1a64Structural,
      boundary_tag: v2.std.node.Symbol,
      residual_quotient: Int
    }

type ByteOffsetCacheKey
  = ByteOffsetCacheEligible { digest: std.content_hash.Fnv1a64Structural }
  | ByteOffsetCacheIneligible {
      boundary_tag: v2.std.node.Symbol,
      witness: std.content_hash.Fnv1a64Structural
    }

fn byte_limb_hash_peano_digest(limb: Int) -> std.content_hash.Fnv1a64Structural {
  if limb < 0 || limb > 255 {
    content_hash_atom(value: ^canonical_tag_byte_limb_out_of_range)
  } else if limb == 0 {
    content_hash_atom(value: ^canonical_tag_scalar_int_zero)
  } else {
    if limb == 1 {
      content_hash_atom(value: ^canonical_tag_scalar_int_one)
    } else {
      combine_hash(
        a: content_hash_atom(value: ^canonical_tag_scalar_int_succ),
        b: byte_limb_hash_peano_digest(limb: limb - 1)
      )
    }
  }
}

fn byte_offset_byte_digest(b: Int) -> std.content_hash.Fnv1a64Structural {
  combine_hash(
    a: content_hash_atom(value: ^canonical_tag_byte_offset_byte),
    b: byte_limb_hash_peano_digest(limb: b)
  )
}

fn byte_offset_quotient_divide_by_256_steps(quotient: Int, steps: Int) -> Int {
  if steps <= 0 {
    quotient
  } else {
    byte_offset_quotient_divide_by_256_steps(quotient: quotient / 256, steps: steps - 1)
  }
}

fn byte_offset_residual_quotient_magnitude_window_digest(quotient: Int, shift_steps: Int) -> std.content_hash.Fnv1a64Structural {
  let shifted = byte_offset_quotient_divide_by_256_steps(quotient: quotient, steps: shift_steps)
  if shift_steps == byte_offset_residual_quotient_magnitude_max_shift && shifted >= 256 * 256 {
    combine_hash(
      a: byte_offset_residual_quotient_limb_pair_digest(quotient: shifted),
      b: byte_offset_overflow_quotient_high_band_terminal_digest(
        quotient: shifted / 65536,
        limbs_remaining: byte_offset_cache_digest_overflow_limbs
      )
    )
  } else {
    byte_offset_residual_quotient_limb_pair_digest(quotient: shifted)
  }
}

fn byte_offset_residual_quotient_limb_pair_digest(quotient: Int) -> std.content_hash.Fnv1a64Structural {
  if quotient < 256 * 256 {
    combine_hash(
      a: content_hash_atom(value: ^canonical_tag_byte_offset_residual_quotient_limb_pair),
      b: combine_hash(
        a: byte_offset_byte_digest(b: quotient - (quotient / 256) * 256),
        b: byte_offset_byte_digest(b: quotient / 256)
      )
    )
  } else {
    combine_hash(
      a: content_hash_atom(value: ^canonical_tag_byte_offset_overflow_residual_discarded_high_truncated),
      b: combine_hash(
        a: byte_offset_byte_digest(b: quotient - (quotient / 256) * 256),
        b: byte_offset_byte_digest(b: (quotient / 256) - (quotient / 65536) * 256)
      )
    )
  }
}

fn byte_offset_residual_quotient_magnitude_digest(quotient: Int) -> std.content_hash.Fnv1a64Structural {
  combine_hash(
    a: content_hash_atom(value: ^canonical_tag_byte_offset_residual_quotient_magnitude),
    b: combine_hash(
      a: byte_offset_residual_quotient_magnitude_window_digest(quotient: quotient, shift_steps: 0),
      b: combine_hash(
        a: byte_offset_residual_quotient_magnitude_window_digest(
          quotient: quotient,
          shift_steps: byte_offset_residual_quotient_magnitude_shift_limbs
        ),
        b: combine_hash(
          a: byte_offset_residual_quotient_magnitude_window_digest(quotient: quotient, shift_steps: 8),
          b: combine_hash(
            a: byte_offset_residual_quotient_magnitude_window_digest(quotient: quotient, shift_steps: 12),
            b: combine_hash(
              a: byte_offset_residual_quotient_magnitude_window_digest(quotient: quotient, shift_steps: 16),
              b: combine_hash(
                a: byte_offset_residual_quotient_magnitude_window_digest(quotient: quotient, shift_steps: 20),
                b: combine_hash(
                  a: byte_offset_residual_quotient_magnitude_window_digest(quotient: quotient, shift_steps: 24),
                  b: byte_offset_residual_quotient_magnitude_window_digest(
                    quotient: quotient,
                    shift_steps: byte_offset_residual_quotient_magnitude_max_shift
                  )
                )
              )
            )
          )
        )
      )
    )
  )
}

fn byte_offset_overflow_quotient_high_band_terminal_digest(quotient: Int, limbs_remaining: Int) -> std.content_hash.Fnv1a64Structural {
  if limbs_remaining == 0 {
    if quotient == 0 {
      content_hash_atom(value: ^canonical_tag_byte_offset_zero)
    } else if quotient < 256 * 256 {
      combine_hash(
        a: content_hash_atom(value: ^canonical_tag_byte_offset_overflow_peel_exhausted),
        b: combine_hash(
          a: byte_offset_byte_digest(b: quotient - (quotient / 256) * 256),
          b: byte_offset_byte_digest(b: quotient / 256)
        )
      )
    } else {
      byte_offset_residual_quotient_limb_pair_digest(quotient: quotient)
    }
  } else if quotient == 0 {
    content_hash_atom(value: ^canonical_tag_byte_offset_zero)
  } else {
    combine_hash(
      a: byte_offset_byte_digest(b: quotient - (quotient / 256) * 256),
      b: byte_offset_overflow_quotient_high_band_terminal_digest(
        quotient: quotient / 256,
        limbs_remaining: limbs_remaining - 1
      )
    )
  }
}

fn byte_offset_overflow_quotient_high_band_digest(quotient: Int, limbs_remaining: Int) -> std.content_hash.Fnv1a64Structural {
  if limbs_remaining == 0 {
    if quotient == 0 {
      content_hash_atom(value: ^canonical_tag_byte_offset_zero)
    } else if quotient < 256 * 256 {
      combine_hash(
        a: content_hash_atom(value: ^canonical_tag_byte_offset_overflow_peel_exhausted),
        b: combine_hash(
          a: byte_offset_byte_digest(b: quotient - (quotient / 256) * 256),
          b: byte_offset_byte_digest(b: quotient / 256)
        )
      )
    } else {
      byte_offset_overflow_quotient_high_band_terminal_digest(
        quotient: quotient,
        limbs_remaining: byte_offset_cache_digest_overflow_limbs
      )
    }
  } else if quotient == 0 {
    content_hash_atom(value: ^canonical_tag_byte_offset_zero)
  } else {
    combine_hash(
      a: byte_offset_byte_digest(b: quotient - (quotient / 256) * 256),
      b: byte_offset_overflow_quotient_high_band_digest(
        quotient: quotient / 256,
        limbs_remaining: limbs_remaining - 1
      )
    )
  }
}

fn byte_offset_overflow_residual_discarded_high_digest(quotient: Int) -> std.content_hash.Fnv1a64Structural {
  if quotient < 65536 {
    content_hash_atom(value: ^canonical_tag_byte_offset_overflow_residual_discarded_high_zero)
  } else {
    combine_hash(
      a: content_hash_atom(value: ^canonical_tag_byte_offset_overflow_residual_discarded_high_band),
      b: byte_offset_overflow_quotient_high_band_digest(
        quotient: quotient / 65536,
        limbs_remaining: byte_offset_cache_digest_overflow_limbs
      )
    )
  }
}

fn byte_offset_cache_digest_ineligible_witness_digest(
  within_ceiling_digest: std.content_hash.Fnv1a64Structural,
  boundary_tag: v2.std.node.Symbol,
  quotient: Int
) -> std.content_hash.Fnv1a64Structural {
  if boundary_tag == ^canonical_tag_byte_offset_overflow_residual_unrepresentable {
    byte_offset_cache_digest_ineligible_hash(
      within_ceiling_digest: combine_hash(
        a: within_ceiling_digest,
        b: combine_hash(
          a: byte_offset_overflow_residual_discarded_high_digest(quotient: quotient),
          b: byte_offset_residual_quotient_magnitude_digest(quotient: quotient)
        )
      ),
      boundary_tag: boundary_tag
    )
  } else {
    byte_offset_cache_digest_ineligible_hash(
      within_ceiling_digest: within_ceiling_digest,
      boundary_tag: boundary_tag
    )
  }
}

fn byte_offset_cache_digest_ineligible_hash(
  within_ceiling_digest: std.content_hash.Fnv1a64Structural,
  boundary_tag: v2.std.node.Symbol
) -> std.content_hash.Fnv1a64Structural {
  combine_hash(
    a: content_hash_atom(value: ^canonical_tag_byte_offset_cache_digest_ineligible),
    b: combine_hash(
      a: within_ceiling_digest,
      b: content_hash_atom(value: boundary_tag)
    )
  )
}

fn byte_offset_cache_digest_overflow_quotient_peel_bounded_authority(
  quotient: Int,
  limbs_remaining: Int
) -> v2.std.node.ByteOffsetCacheDigestAuthority {
  if limbs_remaining == 0 {
    if quotient == 0 {
      ByteOffsetWithinCeiling {
        digest: content_hash_atom(value: ^canonical_tag_byte_offset_zero)
      }
    } else if quotient < 256 * 256 {
      ByteOffsetWithinCeiling {
        digest: combine_hash(
          a: content_hash_atom(value: ^canonical_tag_byte_offset_overflow_peel_exhausted),
          b: combine_hash(
            a: byte_offset_byte_digest(b: quotient - (quotient / 256) * 256),
            b: byte_offset_byte_digest(b: quotient / 256)
          )
        )
      }
    } else {
      ByteOffsetCacheDigestIneligible {
        within_ceiling_digest: combine_hash(
          a: content_hash_atom(value: ^canonical_tag_byte_offset_overflow_peel_exhausted),
          b: combine_hash(
            a: byte_offset_byte_digest(b: quotient - (quotient / 256) * 256),
            b: byte_offset_byte_digest(b: (quotient / 256) - (quotient / 65536) * 256)
          )
        ),
        boundary_tag: ^canonical_tag_byte_offset_overflow_residual_unrepresentable,
        residual_quotient: quotient
      }
    }
  } else if quotient == 0 {
    ByteOffsetWithinCeiling {
      digest: content_hash_atom(value: ^canonical_tag_byte_offset_zero)
    }
  } else {
    match byte_offset_cache_digest_overflow_quotient_peel_bounded_authority(
      quotient: quotient / 256,
      limbs_remaining: limbs_remaining - 1
    ) {
      ByteOffsetWithinCeiling { digest: tail } =>
        ByteOffsetWithinCeiling {
          digest: combine_hash(
            a: byte_offset_byte_digest(b: quotient - (quotient / 256) * 256),
            b: tail
          )
        }
      ByteOffsetCacheDigestIneligible {
        within_ceiling_digest: within_ceiling_digest,
        boundary_tag: boundary_tag,
        residual_quotient: residual_quotient
      } =>
        ByteOffsetCacheDigestIneligible {
          within_ceiling_digest: combine_hash(
            a: byte_offset_byte_digest(b: quotient - (quotient / 256) * 256),
            b: within_ceiling_digest
          ),
          boundary_tag: boundary_tag,
          residual_quotient: quotient
        }
      ByteOffsetOverCeiling {
        within_ceiling_digest: within_ceiling_digest,
        quotient: _
      } =>
        ByteOffsetCacheDigestIneligible {
          within_ceiling_digest: combine_hash(
            a: byte_offset_byte_digest(b: quotient - (quotient / 256) * 256),
            b: within_ceiling_digest
          ),
          boundary_tag: ^canonical_tag_byte_offset_overflow_residual_unrepresentable,
          residual_quotient: quotient
        }
    }
  }
}

fn byte_offset_cache_digest_overflow_tail_authority(quotient: Int) -> v2.std.node.ByteOffsetCacheDigestAuthority {
  match byte_offset_cache_digest_nonneg_bounded_authority(
    i: quotient,
    limbs_remaining: byte_offset_cache_digest_overflow_limbs
  ) {
    ByteOffsetWithinCeiling { digest: digest } =>
      ByteOffsetWithinCeiling { digest: digest }
    ByteOffsetOverCeiling {
      within_ceiling_digest: prefix,
      quotient: tail
    } =>
      match byte_offset_cache_digest_overflow_quotient_peel_bounded_authority(
        quotient: tail,
        limbs_remaining: byte_offset_cache_digest_overflow_limbs
      ) {
        ByteOffsetWithinCeiling { digest: digest } =>
          ByteOffsetWithinCeiling {
            digest: combine_hash(a: prefix, b: digest)
          }
        ByteOffsetCacheDigestIneligible {
          within_ceiling_digest: peel_within_ceiling_digest,
          boundary_tag: boundary_tag,
          residual_quotient: residual_quotient
        } =>
          ByteOffsetCacheDigestIneligible {
            within_ceiling_digest: combine_hash(
              a: prefix,
              b: peel_within_ceiling_digest
            ),
            boundary_tag: boundary_tag,
            residual_quotient: tail
          }
        ByteOffsetOverCeiling {
          within_ceiling_digest: peel_within_ceiling_digest,
          quotient: _
        } =>
          ByteOffsetCacheDigestIneligible {
            within_ceiling_digest: combine_hash(a: prefix, b: peel_within_ceiling_digest),
            boundary_tag: ^canonical_tag_byte_offset_overflow_residual_unrepresentable,
            residual_quotient: tail
          }
      }
    ByteOffsetCacheDigestIneligible {
      within_ceiling_digest: within_ceiling_digest,
      boundary_tag: boundary_tag,
      residual_quotient: residual_quotient
    } =>
      ByteOffsetCacheDigestIneligible {
        within_ceiling_digest: within_ceiling_digest,
        boundary_tag: boundary_tag,
        residual_quotient: residual_quotient
      }
  }
}

fn byte_offset_cache_key_from_authority(auth: v2.std.node.ByteOffsetCacheDigestAuthority) -> v2.std.node.ByteOffsetCacheKey {
  match auth {
    ByteOffsetWithinCeiling { digest: digest } =>
      ByteOffsetCacheEligible { digest: digest }
    ByteOffsetCacheDigestIneligible {
      within_ceiling_digest: within_ceiling_digest,
      boundary_tag: boundary_tag,
      residual_quotient: residual_quotient
    } =>
      ByteOffsetCacheIneligible {
        boundary_tag: boundary_tag,
        witness: byte_offset_cache_digest_ineligible_witness_digest(
          within_ceiling_digest: within_ceiling_digest,
          boundary_tag: boundary_tag,
          quotient: residual_quotient
        )
      }
    ByteOffsetOverCeiling {
      within_ceiling_digest: within_ceiling_digest,
      quotient: quotient
    } =>
      match byte_offset_cache_digest_overflow_tail_authority(quotient: quotient) {
        ByteOffsetCacheDigestIneligible {
          within_ceiling_digest: tail_within_ceiling_digest,
          boundary_tag: boundary_tag,
          residual_quotient: residual_quotient
        } =>
          ByteOffsetCacheIneligible {
            boundary_tag: boundary_tag,
            witness: byte_offset_cache_digest_ineligible_witness_digest(
              within_ceiling_digest: combine_hash(
                a: within_ceiling_digest,
                b: tail_within_ceiling_digest
              ),
              boundary_tag: boundary_tag,
              quotient: residual_quotient
            )
          }
        ByteOffsetWithinCeiling { digest: tail_digest } =>
          ByteOffsetCacheEligible {
            digest: combine_hash(
              a: content_hash_atom(value: ^canonical_tag_byte_offset_out_of_ceiling),
              b: combine_hash(
                a: within_ceiling_digest,
                b: tail_digest
              )
            )
          }
        ByteOffsetOverCeiling {
          within_ceiling_digest: tail_within_ceiling_digest,
          quotient: _
        } =>
          ByteOffsetCacheIneligible {
            boundary_tag: ^canonical_tag_byte_offset_overflow_residual_unrepresentable,
            witness: byte_offset_cache_digest_ineligible_witness_digest(
              within_ceiling_digest: combine_hash(
                a: within_ceiling_digest,
                b: tail_within_ceiling_digest
              ),
              boundary_tag: ^canonical_tag_byte_offset_overflow_residual_unrepresentable,
              quotient: quotient
            )
          }
      }
  }
}

fn byte_offset_cache_digest_nonneg_bounded_authority(
  i: Int,
  limbs_remaining: Int
) -> v2.std.node.ByteOffsetCacheDigestAuthority {
  if limbs_remaining == 0 {
    if i == 0 {
      ByteOffsetWithinCeiling {
        digest: content_hash_atom(value: ^canonical_tag_byte_offset_zero)
      }
    } else {
      ByteOffsetOverCeiling {
        within_ceiling_digest: content_hash_atom(value: ^canonical_tag_byte_offset_zero),
        quotient: i
      }
    }
  } else if i == 0 {
    ByteOffsetWithinCeiling {
      digest: content_hash_atom(value: ^canonical_tag_byte_offset_zero)
    }
  } else {
    match byte_offset_cache_digest_nonneg_bounded_authority(
      i: i / 256,
      limbs_remaining: limbs_remaining - 1
    ) {
      ByteOffsetWithinCeiling { digest: tail } =>
        ByteOffsetWithinCeiling {
          digest: combine_hash(
            a: byte_offset_byte_digest(b: i - (i / 256) * 256),
            b: tail
          )
        }
      ByteOffsetOverCeiling {
        within_ceiling_digest: prefix,
        quotient: quotient
      } =>
        ByteOffsetOverCeiling {
          within_ceiling_digest: combine_hash(
            a: byte_offset_byte_digest(b: i - (i / 256) * 256),
            b: prefix
          ),
          quotient: quotient
        }
      ByteOffsetCacheDigestIneligible {
        within_ceiling_digest: within_ceiling_digest,
        boundary_tag: boundary_tag,
        residual_quotient: residual_quotient
      } =>
        ByteOffsetCacheDigestIneligible {
          within_ceiling_digest: combine_hash(
            a: byte_offset_byte_digest(b: i - (i / 256) * 256),
            b: within_ceiling_digest
          ),
          boundary_tag: boundary_tag,
          residual_quotient: residual_quotient
        }
    }
  }
}

fn byte_offset_cache_digest_nonneg_authority(i: Int) -> v2.std.node.ByteOffsetCacheDigestAuthority {
  byte_offset_cache_digest_nonneg_bounded_authority(
    i: i,
    limbs_remaining: byte_offset_cache_digest_max_limbs
  )
}

fn byte_offset_cache_digest_authority(i: Int) -> v2.std.node.ByteOffsetCacheDigestAuthority {
  if i < 0 {
    match byte_offset_cache_digest_nonneg_authority(i: 0 - i) {
      ByteOffsetWithinCeiling { digest: digest } =>
        ByteOffsetWithinCeiling {
          digest: combine_hash(
            a: content_hash_atom(value: ^canonical_tag_byte_offset_neg),
            b: digest
          )
        }
      ByteOffsetOverCeiling {
        within_ceiling_digest: within_ceiling_digest,
        quotient: quotient
      } =>
        ByteOffsetOverCeiling {
          within_ceiling_digest: combine_hash(
            a: content_hash_atom(value: ^canonical_tag_byte_offset_neg),
            b: within_ceiling_digest
          ),
          quotient: quotient
        }
      ByteOffsetCacheDigestIneligible {
        within_ceiling_digest: within_ceiling_digest,
        boundary_tag: boundary_tag,
        residual_quotient: residual_quotient
      } =>
        ByteOffsetCacheDigestIneligible {
          within_ceiling_digest: combine_hash(
            a: content_hash_atom(value: ^canonical_tag_byte_offset_neg),
            b: within_ceiling_digest
          ),
          boundary_tag: boundary_tag,
          residual_quotient: residual_quotient
        }
    }
  } else {
    byte_offset_cache_digest_nonneg_authority(i: i)
  }
}

fn node_offset_atom(sym: v2.std.node.Symbol) -> v2.std.node.Node {
  node_synthetic(
    kind: TypeNode { connective: Atom { identity: sym } },
    children: []
  )
}

fn node_offset_named_edge(name: v2.std.node.Symbol, target: v2.std.node.Node) -> v2.std.node.Edge {
  Edge { label: Named { name: name }, target: target }
}

fn node_offset_conj(children: List<v2.std.node.Edge>) -> v2.std.node.Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: children
  )
}

fn byte_offset_byte_limb_projection_node(limb: Int) -> v2.std.node.Node {
  if limb < 0 || limb > 255 {
    node_offset_atom(sym: ^canonical_tag_byte_limb_out_of_range)
  } else if limb == 0 {
    node_offset_atom(sym: ^canonical_tag_scalar_int_zero)
  } else if limb == 1 {
    node_offset_atom(sym: ^canonical_tag_scalar_int_one)
  } else {
    node_offset_conj(children: [
      node_offset_named_edge(
        name: ^byte_offset_proj_succ_edge,
        target: node_offset_atom(sym: ^canonical_tag_scalar_int_succ)
      ),
      node_offset_named_edge(
        name: ^byte_offset_proj_pred_edge,
        target: byte_offset_byte_limb_projection_node(limb: limb - 1)
      )
    ])
  }
}

fn byte_offset_digest_nonneg_projection_bounded(i: Int, limbs_remaining: Int) -> v2.std.node.Node {
  if limbs_remaining <= 0 {
    if i == 0 {
      node_offset_atom(sym: ^canonical_tag_byte_offset_zero)
    } else {
      node_offset_conj(children: [
        node_offset_named_edge(
          name: ^byte_offset_proj_out_of_ceiling_edge,
          target: node_offset_atom(sym: ^canonical_tag_byte_offset_out_of_ceiling)
        ),
        node_offset_named_edge(
          name: ^byte_offset_proj_authority_edge,
          target: node_offset_atom(sym: ^canonical_tag_byte_offset_zero)
        ),
        node_offset_named_edge(
          name: ^byte_offset_proj_byte_limb_edge,
          target: byte_offset_byte_limb_projection_node(limb: i - (i / 256) * 256)
        )
      ])
    }
  } else if i == 0 {
    node_offset_atom(sym: ^canonical_tag_byte_offset_zero)
  } else if i <= 255 {
    byte_offset_byte_limb_projection_node(limb: i)
  } else {
    node_offset_conj(children: [
      node_offset_named_edge(
        name: ^byte_offset_proj_out_of_ceiling_edge,
        target: node_offset_atom(sym: ^canonical_tag_byte_offset_out_of_ceiling)
      ),
      node_offset_named_edge(
        name: ^byte_offset_proj_authority_edge,
        target: byte_offset_digest_nonneg_projection_bounded(
          i: i / 256,
          limbs_remaining: limbs_remaining - 1
        )
      ),
      node_offset_named_edge(
        name: ^byte_offset_proj_byte_limb_edge,
        target: byte_offset_byte_limb_projection_node(limb: i - (i / 256) * 256)
      )
    ])
  }
}

fn byte_offset_cache_digest_authority_projection_node(i: Int) -> v2.std.node.Node {
  if i < 0 {
    node_offset_conj(children: [
      node_offset_named_edge(
        name: ^byte_offset_proj_neg_edge,
        target: node_offset_atom(sym: ^canonical_tag_byte_offset_neg)
      ),
      node_offset_named_edge(
        name: ^byte_offset_proj_authority_edge,
        target: byte_offset_digest_nonneg_projection_bounded(
          i: 0 - i,
          limbs_remaining: byte_offset_cache_digest_max_limbs
        )
      )
    ])
  } else {
    byte_offset_digest_nonneg_projection_bounded(
      i: i,
      limbs_remaining: byte_offset_cache_digest_max_limbs
    )
  }
}

fn byte_offset_cache_key_projection_node(i: Int) -> v2.std.node.Node {
  match byte_offset_cache_key(i: i) {
    ByteOffsetCacheEligible { digest: _ } =>
      match byte_offset_cache_digest_authority(i: i) {
        ByteOffsetWithinCeiling { digest: _ } =>
          node_offset_conj(children: [
            node_offset_named_edge(
              name: ^byte_offset_proj_key_eligible_edge,
              target: node_offset_atom(sym: ^canonical_tag_byte_offset_cache_key_eligible)
            ),
            node_offset_named_edge(
              name: ^byte_offset_proj_within_ceiling_edge,
              target: byte_offset_cache_digest_authority_projection_node(i: i)
            )
          ])
        ByteOffsetOverCeiling { within_ceiling_digest: _, quotient: _ } =>
          node_offset_conj(children: [
            node_offset_named_edge(
              name: ^byte_offset_proj_key_eligible_edge,
              target: node_offset_atom(sym: ^canonical_tag_byte_offset_cache_key_eligible)
            ),
            node_offset_named_edge(
              name: ^byte_offset_proj_over_ceiling_edge,
              target: node_offset_atom(sym: ^canonical_tag_byte_offset_out_of_ceiling)
            ),
            node_offset_named_edge(
              name: ^byte_offset_proj_authority_edge,
              target: byte_offset_cache_digest_authority_projection_node(i: i)
            )
          ])
        ByteOffsetCacheDigestIneligible {
          within_ceiling_digest: _,
          boundary_tag: boundary_tag,
          residual_quotient: _
        } =>
          node_offset_conj(children: [
            node_offset_named_edge(
              name: ^byte_offset_proj_key_eligible_edge,
              target: node_offset_atom(sym: ^canonical_tag_byte_offset_cache_key_eligible)
            ),
            node_offset_named_edge(
              name: ^byte_offset_proj_ineligible_authority_edge,
              target: node_offset_atom(sym: ^canonical_tag_byte_offset_cache_digest_ineligible)
            ),
            node_offset_named_edge(
              name: ^byte_offset_proj_boundary_edge,
              target: node_offset_atom(sym: boundary_tag)
            )
          ])
      }
    ByteOffsetCacheIneligible { boundary_tag: boundary_tag, witness: _ } =>
      node_offset_conj(children: [
        node_offset_named_edge(
          name: ^byte_offset_proj_key_ineligible_edge,
          target: node_offset_atom(sym: ^canonical_tag_byte_offset_cache_key_ineligible)
        ),
        node_offset_named_edge(
          name: ^byte_offset_proj_boundary_edge,
          target: node_offset_atom(sym: boundary_tag)
        ),
        node_offset_named_edge(
          name: ^byte_offset_proj_ineligible_authority_edge,
          target: node_offset_atom(sym: ^canonical_tag_byte_offset_cache_digest_ineligible)
        )
      ])
  }
}

fn byte_offset_cache_key(i: Int) -> v2.std.node.ByteOffsetCacheKey {
  byte_offset_cache_key_from_authority(auth: byte_offset_cache_digest_authority(i: i))
}

fn byte_offset_cache_key_fingerprint(key: v2.std.node.ByteOffsetCacheKey) -> v2.std.node.Hash {
  match key {
    ByteOffsetCacheEligible { digest: digest } =>
      combine_hash(
        a: content_hash_atom(value: ^canonical_tag_byte_offset_cache_key_eligible),
        b: digest
      )
    ByteOffsetCacheIneligible {
      boundary_tag: boundary_tag,
      witness: witness
    } =>
      combine_hash(
        a: content_hash_atom(value: ^canonical_tag_byte_offset_cache_key_ineligible),
        b: combine_hash(
          a: content_hash_atom(value: boundary_tag),
          b: witness
        )
      )
  }
}

fn bag_hash_digest(empty: v2.std.node.Hash, xs: List<v2.std.node.Hash>) -> v2.std.node.Hash {
  fold(
    sort_by(xs, fn(h) { h }),
    init: empty,
    f: fn(acc, h) {
      combine_hash(a: acc, b: h)
    }
  )
}

fn content_hash(n: v2.std.node.Node) -> v2.std.node.Hash {
  fold_node_content_hash(
    n: n,
    algebra: v2.std.node.NodeFold {
      init: fn(n0) { canonical_hash_of_node_kind(kind: n0.kind) },
      step: fn(acc, e, child_hash) {
        combine_hash(
          a: combine_hash(
            a: acc,
            b: canonical_hash_of_edge_label(label: e.label)
          ),
          b: child_hash
        )
      }
    }
  )
}

type NodeQuery
  = NodeQueryByConnective { connective: v2.std.node.Connective }
  | NodeQueryByPath { at: v2.std.node.Path }

type Path {
  steps: List<v2.std.node.Symbol>
}
type Edit {
  at: v2.std.node.Path
  replacement: v2.std.node.Node
}
type Diff {
  edits: List<v2.std.node.Edit>
}

data node_occurrence_id_v2_facade_dissolve_on: std.dissolution.DissolutionCondition = unbound_dissolution(description: "DISSOLVE-ON: the counted v2.std.node imports of NodeOccurrenceId, SyntheticOccurrence, and MintedOccurrence reach zero after the bounded v2 import migration; then delete this compatibility coproduct and its two conversions.")
