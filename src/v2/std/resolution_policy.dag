module v2.std.resolution_policy

type NameResolutionPolicy
  = ImportScoped
  | NamespaceOnlyY

fn default_name_resolution_policy() -> NameResolutionPolicy {
  ImportScoped
}

fn name_resolution_policy_is_namespace_only(policy: NameResolutionPolicy) -> Bool {
  match policy {
    NamespaceOnlyY => true
    ImportScoped => false
  }
}
