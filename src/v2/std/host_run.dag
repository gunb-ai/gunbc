// src/v2/std/host_run.dag
// Scope: emit-host run receipts (W2 / joint runner spec §4.2).
// Status: Host arm of ExecutionEvidence; falsification lives in test_claim_falsification.dag.

module v2.std.host_run


import v2.std.collection { List }
import v2.std.diagnostic {
  Outcome,
  Accepted,
  Rejected,
  None,
  diagnostics_singleton
}
import v2.std.machine { Byte }
import v2.std.compilers.target_model { TargetModel }
import v2.std.text { String }
import v2.std.witness { Witness, Holds, Violates }


type ByteString = List<Byte>

type BuildLog {
  lines: List<String>
}

type ExitOk {
  code: Int
}

// Named carrier (not a type alias): v2 compile rejects `type X = Outcome<Witness<…>>`.
type HostExit {
  outcome: Outcome<Witness<ExitOk>>
}

// Phase-typed logical-run stdout: only constructible when exit Holds (P2 host-process boundary).
type HostRunStdout {
  bytes: ByteString
}

// Success-only logical-run carrier: `Outcome<HostLogicalRun>` carries reject/diagnostic arms;
// the accepted payload is only `HostRunStdout` (no nested `Witness` — illegal Violates unrepresentable).
type HostLogicalRun {
  stdout: HostRunStdout
}

type EmitHostRunReceipt {
  target: TargetModel
  source_text: String
  exit: HostExit
  logical_run: Outcome<HostLogicalRun>
  stderr_bytes: ByteString
  build_log: BuildLog
}

fn host_logical_run_from_exit(exit: HostExit, stdout_bytes: ByteString) -> Outcome<HostLogicalRun> {
  match exit.outcome {
    Accepted { value: Holds { value: _ }, diagnostics: None } =>
      Accepted {
        value: HostLogicalRun {
          stdout: HostRunStdout { bytes: stdout_bytes }
        },
        diagnostics: None
      }
    Accepted { value: Violates { diagnostic: d }, diagnostics: None } =>
      Rejected { diagnostics: diagnostics_singleton(d: d) }
    Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
  }
}

type ValueDiff<A> {
  expected: A
  actual: A
}
