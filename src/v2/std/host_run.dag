module v2.std.host_run



type BuildLog {
  lines: List<String>
}

type ExitOk {
  code: Int
}

type HostExit {
  outcome: v2.std.diagnostic.Outcome<Witness<ExitOk>>
}

type HostRunStdout {
  bytes: v2.std.host_transport.ByteString
}

type HostLogicalRun {
  stdout: HostRunStdout
}

type EmitHostRunReceipt {
  target: v2.std.compilers.target_model.TargetModel
  source_text: String
  exit: HostExit
  logical_run: v2.std.diagnostic.Outcome<HostLogicalRun>
  stderr_bytes: v2.std.host_transport.ByteString
  build_log: BuildLog
  compile_skipped: Bool
}

fn host_logical_run_from_exit(exit: HostExit, stdout_bytes: v2.std.host_transport.ByteString) -> v2.std.diagnostic.Outcome<HostLogicalRun> {
  match exit.outcome {
    v2.std.diagnostic.Accepted { value: Holds { value: _ }, diagnostics: None } =>
      v2.std.diagnostic.Accepted {
        value: HostLogicalRun {
          stdout: HostRunStdout { bytes: stdout_bytes }
        },
        diagnostics: v2.std.diagnostic.None
      }
    v2.std.diagnostic.Accepted { value: Violates { diagnostic: d }, diagnostics: None } =>
      v2.std.diagnostic.Rejected { diagnostics: diagnostics_singleton(d: d) }
    v2.std.diagnostic.Rejected { diagnostics: ds } => v2.std.diagnostic.Rejected { diagnostics: ds }
  }
}

type ValueDiff<A> {
  expected: A
  actual: A
}
