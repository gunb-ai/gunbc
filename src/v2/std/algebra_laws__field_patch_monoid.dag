// Scope: TestClaim corpus for FieldPatch<T> right-biased optional-value patch monoid laws.
// Consumes: v2.std.patch v2.std.node v2.std.verification.

module v2.test.algebra_laws.field_patch_monoid

import v2.std.patch { FieldPatch, Override, Inherit, compose_field_patch, apply_field_patch, field_patch_monoid }
import v2.std.node { Atom, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.verification {
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}
fn fp_pass_node() -> Node {
  Node { kind: TypeNode { connective: Atom { identity: ^fp_pass_sym } }, children: [],
 occurrence_id: SyntheticOccurrence
}
}
fn fp_fail_node() -> Node {
  Node { kind: TypeNode { connective: Atom { identity: ^fp_fail_sym } }, children: [],
 occurrence_id: SyntheticOccurrence
}
}
fn fp_ok(b: Bool) -> Node {
  if b { fp_pass_node() } else { fp_fail_node() }
}


// Helpers that route through the monoid witness surface, not the raw helpers.
fn fp_monoid_op(left: FieldPatch<Bool>, right: FieldPatch<Bool>) -> FieldPatch<Bool> {
  let m = field_patch_monoid()
  m.semigroup.magma.op(left, right)
}
fn fp_monoid_identity() -> FieldPatch<Bool> {
  field_patch_monoid().identity
}


// ── Helper-level law witnesses (apply/compose directly) ───────────────────────

// Left identity: compose(Inherit, Override{v}) applies as Override{v}.
data witness_left_identity: Bool = apply_field_patch(base: false, patch: compose_field_patch(left: Inherit, right: Override { value: true })) == true

// Right identity: compose(Override{v}, Inherit) applies as Override{v}.
data witness_right_identity: Bool = apply_field_patch(base: false, patch: compose_field_patch(left: Override { value: true }, right: Inherit)) == true

// Right-bias: compose(Override{left}, Override{right}) applies as Override{right} (later layer wins).
data witness_right_bias: Bool = apply_field_patch(base: true, patch: compose_field_patch(left: Override { value: true }, right: Override { value: false })) == false

// Associativity: apply((a∘b)∘c, base) == apply(a∘(b∘c), base).
// a=Override{true}, b=Override{false}, c=Inherit → both sides yield false from base=true.
fn compose_assoc_lhs() -> Bool {
  apply_field_patch(base: true, patch: compose_field_patch(left: compose_field_patch(left: Override { value: true }, right: Override { value: false }), right: Inherit))
}
fn compose_assoc_rhs() -> Bool {
  apply_field_patch(base: true, patch: compose_field_patch(left: Override { value: true }, right: compose_field_patch(left: Override { value: false }, right: Inherit)))
}
data witness_associativity: Bool = compose_assoc_lhs() == compose_assoc_rhs()

// apply: Inherit defers to base.
data witness_inherit_preserves: Bool = apply_field_patch(base: true, patch: Inherit) == true

// apply: Override replaces base.
data witness_override_replaces: Bool = apply_field_patch(base: true, patch: Override { value: false }) == false


// ── Monoid witness consumers (via field_patch_monoid<T>().identity / .op) ─────

// Witness: monoid identity element preserves base (identity == Inherit semantically).
data witness_monoid_identity_preserves: Bool = apply_field_patch(base: true, patch: fp_monoid_identity()) == true

// Witness: monoid op left identity — op(identity, Override{v}) applies as Override{v}.
data witness_monoid_left_identity: Bool = apply_field_patch(base: false, patch: fp_monoid_op(left: fp_monoid_identity(), right: Override { value: true })) == true

// Witness: monoid op right identity — op(Override{v}, identity) applies as Override{v}.
data witness_monoid_right_identity: Bool = apply_field_patch(base: false, patch: fp_monoid_op(left: Override { value: true }, right: fp_monoid_identity())) == true

// Witness: monoid op right-bias — op(Override{left}, Override{right}) applies as Override{right}.
data witness_monoid_right_bias: Bool = apply_field_patch(base: true, patch: fp_monoid_op(left: Override { value: true }, right: Override { value: false })) == false


// ── Claims ────────────────────────────────────────────────────────────────────

data claim_left_identity: TestClaim = CompilesClaim {
  label: "field_patch/compose: Inherit is left identity",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: fp_ok(b: witness_left_identity),
  expected_value: fp_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_right_identity: TestClaim = CompilesClaim {
  label: "field_patch/compose: Inherit is right identity",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: fp_ok(b: witness_right_identity),
  expected_value: fp_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_right_bias: TestClaim = CompilesClaim {
  label: "field_patch/compose: right Override wins over left Override (later layer)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: fp_ok(b: witness_right_bias),
  expected_value: fp_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_associativity: TestClaim = CompilesClaim {
  label: "field_patch/compose: right-biased composition is associative",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: fp_ok(b: witness_associativity),
  expected_value: fp_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_inherit_preserves: TestClaim = CompilesClaim {
  label: "field_patch/apply: Inherit preserves base field value",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: fp_ok(b: witness_inherit_preserves),
  expected_value: fp_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_override_replaces: TestClaim = CompilesClaim {
  label: "field_patch/apply: Override replaces base field value",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: fp_ok(b: witness_override_replaces),
  expected_value: fp_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_monoid_identity_preserves: TestClaim = CompilesClaim {
  label: "field_patch/monoid: identity element preserves base (Monoid witness)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: fp_ok(b: witness_monoid_identity_preserves),
  expected_value: fp_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_monoid_left_identity: TestClaim = CompilesClaim {
  label: "field_patch/monoid: op(identity, p) == p (Monoid witness left identity)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: fp_ok(b: witness_monoid_left_identity),
  expected_value: fp_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_monoid_right_identity: TestClaim = CompilesClaim {
  label: "field_patch/monoid: op(p, identity) == p (Monoid witness right identity)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: fp_ok(b: witness_monoid_right_identity),
  expected_value: fp_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_monoid_right_bias: TestClaim = CompilesClaim {
  label: "field_patch/monoid: op(Override, Override) right-biased (later layer wins)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: fp_ok(b: witness_monoid_right_bias),
  expected_value: fp_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
