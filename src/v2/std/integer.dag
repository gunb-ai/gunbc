type Int = GroupCompletion<Nat>
type UInt = Nat

type Representation
  = TwosComplement
  | OnesComplement
  | SignMagnitude

type OverflowDisposition = Wrapping | Saturating | UndefinedBehavior | Trapping

type Int8 = Compose<Int, MachineWidth<8>>
type Int16 = Compose<Int, MachineWidth<16>>
type Int32 = Compose<Int, MachineWidth<32>>
type Int64 = Compose<Int, MachineWidth<64>>
type Int128 = Compose<Int, MachineWidth<128>>

type UInt8 = Compose<UInt, MachineWidth<8>>
type UInt16 = Compose<UInt, MachineWidth<16>>
type UInt32 = Compose<UInt, MachineWidth<32>>
type UInt64 = Compose<UInt, MachineWidth<64>>
type UInt128 = Compose<UInt, MachineWidth<128>>

type IntPlatform = Compose<Int, MachineWidth<PointerWidth>>
type UIntPlatform = Compose<UInt, MachineWidth<PointerWidth>>

fn integer_standard_integer_type_decode_invalid_diagnostic(source_carrier: Node) -> Diagnostic {
  Diagnostic {
    reason: ^integer_standard_integer_type_decode_invalid,
    at: node_locus(node: source_carrier),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn integer_signed_i32_le_decode_invalid_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^integer_standard_integer_type_decode_invalid,
    at: invariant_port_locus(port: ^integer_signed_i32_le_decode_invalid, invariant: ^integer_standard_integer_type_decode_invalid),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

type StandardIntegerTypeIntervalNode {
  standard_integer_type: StandardIntegerType
  node: Node
}

fn integer_standard_integer_type_interval_node_row(t: StandardIntegerType) -> StandardIntegerTypeIntervalNode {
  StandardIntegerTypeIntervalNode {
    standard_integer_type: t,
    node: integer_interval_spec_node(spec: integer_standard_integer_type_interval_spec(standard_integer_type: t))
  }
}

// One enumeration of the closed set: the roster above is the only place the ten types are listed,
// so a type added there reaches this table and the decoder without a second list to forget.
data integer_standard_integer_type_interval_nodes: List<StandardIntegerTypeIntervalNode> = list_map(xs: integer_standard_integer_type_roster, f: fn(t) { integer_standard_integer_type_interval_node_row(t: t) })

fn integer_standard_integer_type_from_node_step(
  node: Node,
  acc: Outcome<StandardIntegerType>,
  candidate: StandardIntegerTypeIntervalNode
) -> Outcome<StandardIntegerType> {
  match acc {
    Accepted { value: _, diagnostics: _ } => acc
    Rejected { diagnostics: _ } =>
      if node_same_occurrence(a: node, b: candidate.node) {
        Accepted { value: candidate.standard_integer_type, diagnostics: None }
      } else {
        acc
      }
  }
}

fn integer_standard_integer_type_from_node(node: Node) -> Outcome<StandardIntegerType> {
  fold_list(
    xs: integer_standard_integer_type_interval_nodes,
    empty: Rejected {
      diagnostics: diagnostics_singleton(
        d: integer_standard_integer_type_decode_invalid_diagnostic(source_carrier: node)
      )
    },
    cons: fn(acc, candidate) {
      integer_standard_integer_type_from_node_step(node: node, acc: acc, candidate: candidate)
    }
  )
}

fn integer_interval_spec_contains_decoded_node(container: IntegerExtent, contained: StandardIntegerType) -> Bool {
  integer_interval_spec_contains(
    container: container,
    contained: integer_standard_integer_type_interval_spec(standard_integer_type: contained)
  )
}

fn integer_interval_spec_node_contains(container: Node, contained: Node) -> Bool {
  match integer_standard_integer_type_from_node(node: container) {
    Accepted { value: decoded_container, diagnostics: _ } =>
      match integer_standard_integer_type_from_node(node: contained) {
        Accepted { value: decoded_contained, diagnostics: _ } =>
          integer_interval_spec_contains_decoded_node(
            container: integer_standard_integer_type_interval_spec(standard_integer_type: decoded_container),
            contained: decoded_contained
          )
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}
fn integer_inhabitant_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: [],
    occurrence_id: OccurrenceSynthetic
}
}

fn integer_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Authored { name: name }, target: target, declaration: NotADeclaration }
}

fn integer_bound_sign_node(sign: IntegerBoundSign) -> Node {
  match sign {
    IntegerBoundNegative => integer_inhabitant_atom(id: ^integer_tag_bound_negative)
    IntegerBoundNonNegative => integer_inhabitant_atom(id: ^integer_tag_bound_nonnegative)
  }
}

fn integer_signedness_node(signedness: Signedness) -> Node {
  match signedness {
    Signed => integer_inhabitant_atom(id: ^integer_tag_signed)
    Unsigned => integer_inhabitant_atom(id: ^integer_tag_unsigned)
  }
}

fn integer_range_endpoint_node(endpoint: IntegerRangeEndpoint) -> Node {
  match endpoint {
    IntegerRangeInclusiveMin => integer_inhabitant_atom(id: ^integer_tag_range_inclusive_min)
    IntegerRangeInclusiveMax => integer_inhabitant_atom(id: ^integer_tag_range_inclusive_max)
  }
}

// THE INT VALUE TYPE, AS A NODE. This module owns what `Int` denotes, exactly as v2.std.logic
// bool_node owns what `Bool` denotes: a language's binding join (v2.extdeps.languages.dag
// dag_binding_denotation) points here, and every consumer of an Int value's type -- infer's
// literal, add and branch rules, the evaluator's primitive type -- reads this one node. Its atom
// identity keeps the spelling `dag_binding_type_int` it carried before the authority moved here;
// that is the identity every consumer compares against, so renaming it is a separate migration.
fn integer_int_type_node() -> Node {
  integer_inhabitant_atom(id: ^dag_binding_type_int)
}

// THE TYPES OF A DECIMAL MAGNITUDE'S NODE ENCODING, AS NODES. integer_decimal_magnitude_node encodes
// a magnitude as fold_list_node over integer_decimal_digit_node: each digit atom is a DecimalDigit and
// each cons cell (and the empty tail) is a FreeMonoid<DecimalDigit>. v2.compiler.infer
// infer_literal_payload_entries grounds an accepted int literal's magnitude payload against these,
// so the resolved type it records for a payload node is that node's type in this authority, and not
// the literal that carries it.
fn integer_decimal_digit_type_node() -> Node {
  integer_inhabitant_atom(id: ^integer_type_decimal_digit)
}

fn integer_decimal_digits_type_node() -> Node {
  integer_inhabitant_atom(id: ^integer_type_decimal_digits)
}

fn integer_decimal_digit_node(digit: DecimalDigit) -> Node {
  match digit {
    D0 => integer_inhabitant_atom(id: ^integer_tag_digit_0)
    D1 => integer_inhabitant_atom(id: ^integer_tag_digit_1)
    D2 => integer_inhabitant_atom(id: ^integer_tag_digit_2)
    D3 => integer_inhabitant_atom(id: ^integer_tag_digit_3)
    D4 => integer_inhabitant_atom(id: ^integer_tag_digit_4)
    D5 => integer_inhabitant_atom(id: ^integer_tag_digit_5)
    D6 => integer_inhabitant_atom(id: ^integer_tag_digit_6)
    D7 => integer_inhabitant_atom(id: ^integer_tag_digit_7)
    D8 => integer_inhabitant_atom(id: ^integer_tag_digit_8)
    D9 => integer_inhabitant_atom(id: ^integer_tag_digit_9)
  }
}

fn integer_decimal_nonzero_node(magnitude: DecimalNonZeroMagnitude) -> Node {
  match magnitude {
    DecimalNonZeroMagnitude { lead, tail } =>
      fold_list_node(
        xs: Cons { head: integer_nonzero_decimal_digit_widen(digit: lead), tail: tail },
        item_node: fn(digit) { integer_decimal_digit_node(digit: digit) }
      )
  }
}

fn integer_decimal_magnitude_node(magnitude: DecimalMagnitude) -> Node {
  match magnitude {
    DecimalZero =>
      fold_list_node(
        xs: Cons { head: D0, tail: Empty },
        item_node: fn(digit) { integer_decimal_digit_node(digit: digit) }
      )
    DecimalNonZero { magnitude: nonzero } => integer_decimal_nonzero_node(magnitude: nonzero)
  }
}

fn integer_interval_bound_node(bound: IntegerIntervalBound) -> Node {
  match bound {
    IntegerConcreteZero => Node {
      kind: TypeNode { connective: Conj },
      children: [
        integer_named_edge(
          name: ^integer_bound_field_kind,
          target: integer_inhabitant_atom(id: ^integer_tag_bound_zero)
        )
      ],
      occurrence_id: OccurrenceSynthetic
}
    IntegerConcreteBound { sign, magnitude } => Node {
      kind: TypeNode { connective: Conj },
      children: [
        integer_named_edge(
          name: ^integer_bound_field_kind,
          target: integer_inhabitant_atom(id: ^integer_tag_bound_concrete)
        ),
        integer_named_edge(
          name: ^integer_bound_field_sign,
          target: integer_bound_sign_node(sign: sign)
        ),
        integer_named_edge(
          name: ^integer_bound_field_magnitude,
          target: integer_decimal_nonzero_node(magnitude: magnitude)
        )
      ],
      occurrence_id: OccurrenceSynthetic
}
    IntegerPointerWidthBound { signedness, endpoint } => Node {
      kind: TypeNode { connective: Conj },
      children: [
        integer_named_edge(
          name: ^integer_bound_field_kind,
          target: integer_inhabitant_atom(id: ^integer_tag_bound_pointer_width)
        ),
        integer_named_edge(
          name: ^integer_bound_field_signedness,
          target: integer_signedness_node(signedness: signedness)
        ),
        integer_named_edge(
          name: ^integer_bound_field_endpoint,
          target: integer_range_endpoint_node(endpoint: endpoint)
        )
      ],
      occurrence_id: OccurrenceSynthetic
}
  }
}

fn integer_interval_spec_node(spec: IntegerExtent) -> Node {
  match spec {
    EmptyIntegerExtent => integer_inhabitant_atom(id: ^integer_extent_empty)
    UnboundedIntegers => integer_inhabitant_atom(id: ^integer_extent_unbounded_integers)
    UnboundedNaturals => integer_inhabitant_atom(id: ^integer_extent_unbounded_naturals)
    BoundedIntegerInterval { inclusive_min: lo, inclusive_max: hi } => Node {
    kind: TypeNode { connective: Conj },
    children: [
      integer_named_edge(
        name: ^integer_interval_field_inclusive_min,
        target: integer_interval_bound_node(bound: lo)
      ),
      integer_named_edge(
        name: ^integer_interval_field_inclusive_max,
        target: integer_interval_bound_node(bound: hi)
      )
    ],
    occurrence_id: OccurrenceSynthetic
}
}
}
fn int_add(a: Int, b: Int) -> Int {
  a + b
}

fn int_negate(a: Int) -> Int {
  0 - a
}

fn int_mul(a: Int, b: Int) -> Int {
  a * b
}

fn int_compare(a: Int, b: Int) -> Ordering {
  if a < b {
    Less
  } else {
    if a == b {
      Equal
    } else {
      Greater
    }
  }
}

fn int_is_zero(a: Int) -> Bool {
  a == 0
}

fn int_sub(a: Int, b: Int) -> Int {
  int_add(a: a, b: int_negate(a: b))
}

fn int_eq(a: Int, b: Int) -> Bool {
  match int_compare(a: a, b: b) {
    Less => false
    Equal => true
    Greater => false
  }
}

fn int_ne(a: Int, b: Int) -> Bool {
  match int_compare(a: a, b: b) {
    Less => true
    Equal => false
    Greater => true
  }
}

fn int_lt(a: Int, b: Int) -> Bool {
  match int_compare(a: a, b: b) {
    Less => true
    Equal => false
    Greater => false
  }
}

fn int_le(a: Int, b: Int) -> Bool {
  match int_compare(a: a, b: b) {
    Less => true
    Equal => true
    Greater => false
  }
}

fn int_gt(a: Int, b: Int) -> Bool {
  match int_compare(a: a, b: b) {
    Less => false
    Equal => false
    Greater => true
  }
}

fn int_ge(a: Int, b: Int) -> Bool {
  match int_compare(a: a, b: b) {
    Greater => true
    Equal => true
    Less => false
  }
}

fn int_div_result(a: Int, b: Int) -> Result<Int, DivError> {
  if int_is_zero(a: b) {
    Err { value: DivideByZero }
  } else {
    Ok { value: a / b }
  }
}

data int_abelian_group: AbelianGroup<Int> = AbelianGroup {
  op: int_add,
  identity: 0,
  inverse: int_negate
}

data int_ordered_ring: OrderedRing<Int> = OrderedRing {
  add: int_add,
  sub: int_sub,
  zero: 0,
  negate: int_negate,
  mul: int_mul,
  div: int_div_result,
  one: 1,
  order: TotalOrder { compare: int_compare },
  eq: int_eq,
  ne: int_ne
}
fn integer_divide_by_zero_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: ^integer_div_by_zero,
    at: port_refusal_locus(at: at, port: ^integer_division_port, invariant: ^integer_div_by_zero),
    correction: Unavailable { reason: AmbiguousIntent }
  }
}

fn integer_modulo_by_zero_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: ^integer_modulo_by_zero,
    at: port_refusal_locus(at: at, port: ^integer_modulo_port, invariant: ^integer_modulo_by_zero),
    correction: Unavailable { reason: AmbiguousIntent }
  }
}
fn int_div(a: Int, b: Int, at: Locus) -> Outcome<Int> {
  if int_is_zero(a: b) {
    Rejected {
      diagnostics: diagnostics_singleton(d: integer_divide_by_zero_diagnostic(at: at))
    }
  } else {
    Accepted { value: a / b, diagnostics: None }
  }
}

fn int_mod(a: Int, b: Int, at: Locus) -> Outcome<Int> {
  if int_is_zero(a: b) {
    Rejected {
      diagnostics: diagnostics_singleton(d: integer_modulo_by_zero_diagnostic(at: at))
    }
  } else {
    Accepted { value: a % b, diagnostics: None }
  }
}

fn integer_char_code_to_decimal_digit_optional(c: Char) -> Optional<DecimalDigit> {
  if c == 48 {
    optional_present(value: D0)
  } else if c == 49 {
    optional_present(value: D1)
  } else if c == 50 {
    optional_present(value: D2)
  } else if c == 51 {
    optional_present(value: D3)
  } else if c == 52 {
    optional_present(value: D4)
  } else if c == 53 {
    optional_present(value: D5)
  } else if c == 54 {
    optional_present(value: D6)
  } else if c == 55 {
    optional_present(value: D7)
  } else if c == 56 {
    optional_present(value: D8)
  } else if c == 57 {
    optional_present(value: D9)
  } else {
    optional_absent()
  }
}

fn integer_decimal_digits_snoc(
  xs: FreeMonoid<DecimalDigit>,
  digit: DecimalDigit
) -> FreeMonoid<DecimalDigit> {
  match xs {
    Empty => Cons { head: digit, tail: Empty }
    Cons { head, tail } =>
      Cons { head: head, tail: integer_decimal_digits_snoc(xs: tail, digit: digit) }
  }
}

fn integer_string_to_decimal_digits_step(
  s: v2.std.text.String,
  acc: FreeMonoid<DecimalDigit>
) -> Optional<FreeMonoid<DecimalDigit>> {
  match string_head(s: s) {
    CharAbsent => optional_present(value: acc)
    CharFound { value: c } =>
      match integer_char_code_to_decimal_digit_optional(c: c) {
        Present { value: d } =>
          match string_tail(s: s) {
            Present { value: rest } =>
              integer_string_to_decimal_digits_step(
                s: rest,
                acc: integer_decimal_digits_snoc(xs: acc, digit: d)
              )
            Absent => optional_absent()
          }
        Absent => optional_absent()
      }
  }
}

fn integer_string_to_decimal_digits_optional(s: String) -> Optional<FreeMonoid<DecimalDigit>> {
  integer_string_to_decimal_digits_step(s: unicode_scalar_unfold(s: s), acc: Empty)
}

fn integer_decimal_nonzero_magnitude_to_int(m: DecimalNonZeroMagnitude) -> Int {
  fold_list(
    xs: m.tail,
    empty: decimal_digit_value(d: integer_nonzero_decimal_digit_widen(digit: m.lead)),
    cons: fn(acc, d) {
      int_add(a: int_mul(a: acc, b: 10), b: decimal_digit_value(d: d))
    }
  )
}

fn integer_decimal_magnitude_to_int(m: DecimalMagnitude) -> Int {
  match m {
    DecimalZero => 0
    DecimalNonZero { magnitude } =>
      integer_decimal_nonzero_magnitude_to_int(m: magnitude)
  }
}

fn integer_lexeme_to_int_optional(lexeme: String) -> Optional<Int> {
  match integer_string_to_decimal_digits_optional(s: lexeme) {
    Present { value: digits } =>
      optional_present(
        value: integer_decimal_magnitude_to_int(
          m: decimal_digits_to_magnitude(digits: digits)
        )
      )
    Absent => optional_absent()
  }
}

fn integer_u8_unit_to_bit(value: Int, shift: Int) -> Bool {
  (value / shift) % 2 == 1
}

fn integer_u8_to_byte(value: Int) -> Byte {
  Byte {
    bits: [
      integer_u8_unit_to_bit(value: value, shift: 1),
      integer_u8_unit_to_bit(value: value, shift: 2),
      integer_u8_unit_to_bit(value: value, shift: 4),
      integer_u8_unit_to_bit(value: value, shift: 8),
      integer_u8_unit_to_bit(value: value, shift: 16),
      integer_u8_unit_to_bit(value: value, shift: 32),
      integer_u8_unit_to_bit(value: value, shift: 64),
      integer_u8_unit_to_bit(value: value, shift: 128)
    ]
  }
}

fn integer_i32_modulus() -> Int {
  int_mul(a: 65536, b: 65536)
}

fn integer_int_normalize_i32_wire_unsigned(value: Int) -> Int {
  if value < 0 {
    integer_int_normalize_i32_wire_unsigned(
      value: int_add(a: value, b: integer_i32_modulus())
    )
  } else if value >= integer_i32_modulus() {
    integer_int_normalize_i32_wire_unsigned(
      value: int_add(a: value, b: int_negate(a: integer_i32_modulus()))
    )
  } else {
    value
  }
}

fn integer_int_to_signed_i32_le_bytes(value: Int) -> List<Byte> {
  let wire = integer_int_normalize_i32_wire_unsigned(value: value)
  [
    integer_u8_to_byte(value: wire % 256),
    integer_u8_to_byte(value: (wire / 256) % 256),
    integer_u8_to_byte(value: (wire / 65536) % 256),
    integer_u8_to_byte(value: (wire / 16777216) % 256)
  ]
}

fn integer_byte_bit_at(b: Byte, shift: Int) -> Int {
  match list_at_optional(xs: b.bits, index: shift) {
    Present { value: bit } => if bit { 1 } else { 0 }
    Absent => 0
  }
}

fn integer_u8_from_byte(b: Byte) -> Int {
  int_add(
    a: int_add(
      a: int_add(
        a: int_add(
          a: int_add(
            a: int_add(
              a: int_add(
                a: integer_byte_bit_at(b: b, shift: 0),
                b: int_mul(a: 2, b: integer_byte_bit_at(b: b, shift: 1))
              ),
              b: int_mul(a: 4, b: integer_byte_bit_at(b: b, shift: 2))
            ),
            b: int_mul(a: 8, b: integer_byte_bit_at(b: b, shift: 3))
          ),
          b: int_mul(a: 16, b: integer_byte_bit_at(b: b, shift: 4))
        ),
        b: int_mul(a: 32, b: integer_byte_bit_at(b: b, shift: 5))
      ),
      b: int_mul(a: 64, b: integer_byte_bit_at(b: b, shift: 6))
    ),
    b: int_mul(a: 128, b: integer_byte_bit_at(b: b, shift: 7))
  )
}

fn integer_signed_i32_le_bytes_to_int_value(b0: Int, b1: Int, b2: Int, b3: Int) -> Int {
  let unsigned = int_add(
    a: int_add(
      a: int_add(a: b0, b: int_mul(a: 256, b: b1)),
      b: int_mul(a: 65536, b: b2)
    ),
    b: int_mul(a: 16777216, b: b3)
  )
  if b3 >= 128 {
    int_add(a: unsigned, b: int_negate(a: integer_i32_modulus()))
  } else {
    unsigned
  }
}

fn integer_decimal_digit_from_tag_atom(id: Symbol) -> Optional<DecimalDigit> {
  if id == ^integer_tag_digit_0 {
    optional_present(value: D0)
  } else if id == ^integer_tag_digit_1 {
    optional_present(value: D1)
  } else if id == ^integer_tag_digit_2 {
    optional_present(value: D2)
  } else if id == ^integer_tag_digit_3 {
    optional_present(value: D3)
  } else if id == ^integer_tag_digit_4 {
    optional_present(value: D4)
  } else if id == ^integer_tag_digit_5 {
    optional_present(value: D5)
  } else if id == ^integer_tag_digit_6 {
    optional_present(value: D6)
  } else if id == ^integer_tag_digit_7 {
    optional_present(value: D7)
  } else if id == ^integer_tag_digit_8 {
    optional_present(value: D8)
  } else if id == ^integer_tag_digit_9 {
    optional_present(value: D9)
  } else {
    optional_absent()
  }
}

fn integer_decimal_digit_from_node_optional(node: Node) -> Optional<DecimalDigit> {
  match node.kind {
    TypeNode { connective: c } =>
      match c {
        Atom { identity: id } => integer_decimal_digit_from_tag_atom(id: id)
        Conj => optional_absent()
        Disj => optional_absent()
        Arrow => optional_absent()
        Instantiation => optional_absent()
      }
    ComputationNode { behavior: _ } => optional_absent()
  }
}

fn integer_fold_list_node_digits_optional(node: Node) -> Optional<FreeMonoid<DecimalDigit>> {
  if is_empty_conj_root(n: node) {
    optional_present(value: Empty)
  } else {
    match find_named_child(root: node, name: ^fold_list_node_head) {
      Accepted { value: head_node, diagnostics: _ } =>
        match integer_decimal_digit_from_node_optional(node: head_node) {
          Present { value: digit } =>
            match find_named_child(root: node, name: ^fold_list_node_tail) {
              Accepted { value: tail_node, diagnostics: _ } =>
                match integer_fold_list_node_digits_optional(node: tail_node) {
                  Present { value: tail_digits } =>
                    optional_present(value: Cons { head: digit, tail: tail_digits })
                  Absent => optional_absent()
                }
              Rejected { diagnostics: _ } => optional_absent()
            }
          Absent => optional_absent()
        }
      Rejected { diagnostics: _ } => optional_absent()
    }
  }
}

fn integer_decimal_magnitude_node_to_int(node: Node) -> Outcome<Int> {
  match integer_fold_list_node_digits_optional(node: node) {
    Present { value: digits } =>
      outcome_accepted(
        value: integer_decimal_magnitude_to_int(
          m: decimal_digits_to_magnitude(digits: digits)
        )
      )
    Absent =>
      outcome_rejected(
        d: integer_standard_integer_type_decode_invalid_diagnostic(source_carrier: node)
      )
  }
}

fn integer_signed_i32_le_bytes_to_int(bytes: List<Byte>) -> Outcome<Int> {
  if length(xs: bytes) == 4 {
    match list_at_optional(xs: bytes, index: 0) {
      Present { value: b0 } =>
        match list_at_optional(xs: bytes, index: 1) {
          Present { value: b1 } =>
            match list_at_optional(xs: bytes, index: 2) {
              Present { value: b2 } =>
                match list_at_optional(xs: bytes, index: 3) {
                  Present { value: b3 } =>
                    outcome_accepted(
                      value: integer_signed_i32_le_bytes_to_int_value(
                        b0: integer_u8_from_byte(b: b0),
                        b1: integer_u8_from_byte(b: b1),
                        b2: integer_u8_from_byte(b: b2),
                        b3: integer_u8_from_byte(b: b3)
                      )
                    )
                  Absent =>
                    outcome_rejected(d: integer_signed_i32_le_decode_invalid_diagnostic())
                }
              Absent =>
                outcome_rejected(d: integer_signed_i32_le_decode_invalid_diagnostic())
            }
          Absent =>
            outcome_rejected(d: integer_signed_i32_le_decode_invalid_diagnostic())
        }
      Absent =>
        outcome_rejected(d: integer_signed_i32_le_decode_invalid_diagnostic())
    }
  } else {
    outcome_rejected(d: integer_signed_i32_le_decode_invalid_diagnostic())
  }
}

// THE CONTENT IDENTITY OF AN Int, at cost proportional to its digits. The digests already in the
// corpus that take an integer are unary -- v2.std.node byte_limb_hash_peano_digest (one
// combine_hash per unit, one shared tag for every value outside 0..255) and the byte-offset cache
// key built on it -- so a consumer hashing arbitrary integers either paid the magnitude or
// collided. The canonical decimal spelling is injective over Int (a leading "-" only for
// negatives, no leading zeros), so its content atom is too.
fn integer_int_content_digest(value: Int) -> Fnv1a64Structural {
  content_hash_tagged_structural(
    tag: "integer-int-decimal",
    payload: content_hash_atom(value: int_to_decimal_string(value: value) as NonEmptyStr)
  )
}

// MODEL CONTRACT, not a new value wrapper. The source remains Compose<A,MachineWidth<N>>:
// its inhabitants are A intersected with the existing interval. Keeping Compose folded preserves
// infer_int_literal_value_at's existing width observation. No other Compose gets a value carrier.
// The ten std.integer aliases and ten v2.std.integer aliases express the same width axis. Their
// Int declarations have different current realizations; a width binding must not silently change
// either unbounded Int. No bounds are copied here: std.integer_interval owns the symbolic intervals; this module keeps their node codecs.
fn integer_width_domain(width: StandardIntegerType) -> IntegerExtent {
  integer_standard_integer_type_interval_spec(standard_integer_type: width)
}

// Same signedness AND interval inclusion: no implicit narrowing, signedness change, saturation,
// truncation or wrapping. This also makes all implicit widening chains denote the same value.
// UInt8 -> Int16 is total and exact but remains named under the recorded signedness rule in
// gunbc.recurring_failure_mode.a_width_constrained_integer_admits_a_value_outside_its_width;
// the prohibition is that rule, not a claim that this particular crossing loses information.
// The source policy is checked/trapping, independent of Rust debug/release overflow settings.
// A named checked arithmetic operation returns absence/refusal on a result outside the interval;
// ordinary width arithmetic must propagate a located refusal, never select target wrapping.
// Existing named wrapping operations remain explicit alternatives. This legacy disposition is
// the projection of std.integer IntegerOverflowSemantics' raise arm; it does not claim that a
// hardware trap, panic and typed refusal are one effect. The effectful consumer must retain its
// particular failure carrier. Saturating and wrapping are never implicit defaults.
fn integer_width_default_overflow() -> OverflowDisposition { Trapping }
