fn bool_type_node() -> Node {
  Node {
    kind: TypeNode { connective: Disj },
    children: [
      Edge { label: Authored { name: ^bool_variant_true }, target: algebra_empty_conj() },
      Edge { label: Authored { name: ^bool_variant_false }, target: algebra_empty_conj() },
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn equivalence_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      binder_edge(name: ^equivalence_field_eq, type_node: algebra_binary_fn_node(domain: inhabitant, codomain: bool_type_node())),
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn equivalence_node(inhabitant: Node) -> Node {
  algebra_inhabitance_node(
    algebra: equivalence_type_node(inhabitant: inhabitant),
    inhabitant: inhabitant
