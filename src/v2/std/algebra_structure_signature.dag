fn field_reciprocal_operation_node() -> Node {
  Node { kind: TypeNode { connective: Atom { identity: ^field_reciprocal_operation } }, children: [],
 occurrence_id: OccurrenceSynthetic
}
}

fn field_reciprocal_nonzero_precondition_node() -> Node {
  Node { kind: TypeNode { connective: Atom { identity: ^field_reciprocal_nonzero_precondition } }, children: [],
 occurrence_id: OccurrenceSynthetic
}
}

fn approximate_field_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      binder_edge(name: ^approximate_field_field_add, type_node: algebra_binary_fn_node(domain: inhabitant, codomain: inhabitant)),
      binder_edge(name: ^approximate_field_field_zero, type_node: inhabitant),
      binder_edge(name: ^approximate_field_field_negate, type_node: algebra_unary_fn_node(domain: inhabitant, codomain: inhabitant)),
      binder_edge(name: ^approximate_field_field_mul, type_node: algebra_binary_fn_node(domain: inhabitant, codomain: inhabitant)),
      binder_edge(name: ^approximate_field_field_one, type_node: inhabitant),
      binder_edge(name: ^approximate_field_field_compare, type_node: algebra_binary_fn_node(domain: inhabitant, codomain: ordering_type_node())),
    ],
    occurrence_id: OccurrenceSynthetic
}
}

