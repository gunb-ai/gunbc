  algebra_inhabitance_node(
    algebra: boolean_algebra_type_node(inhabitant: inhabitant),
    inhabitant: inhabitant
  )
}

fn bool_type_node() -> Node {
  Node {
    kind: TypeNode { connective: Disj },
    children: [
      Edge { label: Named { name: ^bool_variant_true }, target: algebra_empty_conj() },
      Edge { label: Named { name: ^bool_variant_false }, target: algebra_empty_conj() },
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn equivalence_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^equivalence_field_eq },
        target: algebra_binary_fn_node(domain: inhabitant, codomain: bool_type_node())
      },
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn equivalence_node(inhabitant: Node) -> Node {
  algebra_inhabitance_node(
    algebra: equivalence_type_node(inhabitant: inhabitant),
    inhabitant: inhabitant
  )
}

fn free_monoid_node(inhabitant: Node) -> Node {
  algebra_inhabitance_node(
    algebra: free_monoid_type_node(inhabitant: inhabitant),
    inhabitant: inhabitant
  )
}

// Bool inhabits BooleanAlgebra: the structure node over v2.std.logic bool_node. Homed here, not in
// v2.std.logic, because v2.std.logic sits beneath v2.std.arrow_signature.
fn bool_boolean_algebra_type_node() -> Node {
  boolean_algebra_type_node(inhabitant: bool_node())
}

fn bool_boolean_algebra_node() -> Node {
  boolean_algebra_node(inhabitant: bool_node())
}
