  )
}

// Bool inhabits BooleanAlgebra: the structure node over v2.std.logic bool_node. Homed here, not in
// v2.std.logic, because v2.std.logic sits beneath v2.std.arrow_signature.
fn bool_boolean_algebra_type_node() -> Node {
  boolean_algebra_type_node(inhabitant: bool_node())
}

fn bool_boolean_algebra_node() -> Node {
  boolean_algebra_node(inhabitant: bool_node())
}
