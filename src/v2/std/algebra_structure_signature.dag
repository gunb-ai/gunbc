  Node {
    kind: TypeNode { connective: Conj },
    children: [
      binder_edge(name: ^ring_field_add, type_node: abelian_group_type_node(inhabitant: inhabitant)),
      binder_edge(name: ^ring_field_mul, type_node: monoid_type_node(inhabitant: inhabitant)),
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn commutative_ring_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      binder_edge(name: ^commutative_ring_field_ring, type_node: ring_type_node(inhabitant: inhabitant)),
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn ordered_ring_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      binder_edge(name: ^ordered_ring_field_ring, type_node: ring_type_node(inhabitant: inhabitant)),
      binder_edge(name: ^ordered_ring_field_compare, type_node: algebra_binary_fn_node(domain: inhabitant, codomain: ordering_type_node())),
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn field_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      binder_edge(name: ^field_field_commutative_ring, type_node: commutative_ring_type_node(inhabitant: inhabitant)),
      binder_edge(name: ^field_field_reciprocal, type_node: algebra_unary_fn_node(domain: inhabitant, codomain: inhabitant)),
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn field_reciprocal_operation_node() -> Node {
  Node { kind: TypeNode { connective: Atom { identity: ^field_reciprocal_operation } }, children: [],
 occurrence_id: OccurrenceSynthetic
}
}

fn field_reciprocal_nonzero_precondition_node() -> Node {
  Node { kind: TypeNode { connective: Atom { identity: ^field_reciprocal_nonzero_precondition } }, children: [],
 occurrence_id: OccurrenceSynthetic
}
}

fn approximate_field_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      binder_edge(name: ^approximate_field_field_add, type_node: algebra_binary_fn_node(domain: inhabitant, codomain: inhabitant)),
      binder_edge(name: ^approximate_field_field_zero, type_node: inhabitant),
      binder_edge(name: ^approximate_field_field_negate, type_node: algebra_unary_fn_node(domain: inhabitant, codomain: inhabitant)),
      binder_edge(name: ^approximate_field_field_mul, type_node: algebra_binary_fn_node(domain: inhabitant, codomain: inhabitant)),
      binder_edge(name: ^approximate_field_field_one, type_node: inhabitant),
      binder_edge(name: ^approximate_field_field_compare, type_node: algebra_binary_fn_node(domain: inhabitant, codomain: ordering_type_node())),
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn lattice_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      binder_edge(name: ^lattice_field_meet, type_node: algebra_binary_fn_node(domain: inhabitant, codomain: inhabitant)),
      binder_edge(name: ^lattice_field_join, type_node: algebra_binary_fn_node(domain: inhabitant, codomain: inhabitant)),
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn bounded_lattice_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      binder_edge(name: ^bounded_lattice_field_lattice, type_node: lattice_type_node(inhabitant: inhabitant)),
      binder_edge(name: ^bounded_lattice_field_top, type_node: inhabitant),
      binder_edge(name: ^bounded_lattice_field_bottom, type_node: inhabitant),
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn boolean_algebra_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      binder_edge(name: ^boolean_algebra_field_bounded_lattice, type_node: bounded_lattice_type_node(inhabitant: inhabitant)),
      binder_edge(name: ^boolean_algebra_field_complement, type_node: algebra_unary_fn_node(domain: inhabitant, codomain: inhabitant)),
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn algebra_inhabitance_node(algebra: Node, inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Authored { name: ^algebra_edge }, target: algebra },
      Edge { label: Authored { name: ^inhabitant_edge }, target: inhabitant },
    ],
    occurrence_id: OccurrenceSynthetic
}
}

// WHICH OPERATION FIELDS A STRUCTURE DECLARES, read off the signature this module builds: a structure is a
// Conj of binder edges, and a binder whose type is itself a structure -- ordered_ring's ^ordered_ring_field_ring,
// boolean_algebra's ^boolean_algebra_field_bounded_lattice -- composes that structure's fields into its own. An
// OPERATION's type (an Arrow from algebra_binary_fn_node / algebra_unary_fn_node) and the inhabitant are not
// structures and are never entered, so a name occurring inside an operation's signature or inside the carrier
// is not a declared field. This is the one reading of "the structure declares field F"; a consumer asks it
// rather than searching the node.
fn algebra_inhabitance_declares_field(inhabitance: Node, field: Symbol) -> Bool {
  match named_child_lookup(root: inhabitance, name: ^algebra_edge) {
    NamedChildFound { target: algebra } =>
      match named_child_lookup(root: inhabitance, name: ^inhabitant_edge) {
        NamedChildFound { target: inhabitant } => algebra_structure_declares_field(structure: algebra, inhabitant: inhabitant, field: field)
        _ => false
      }
    _ => false
  }
}

fn algebra_structure_declares_field(structure: Node, inhabitant: Node, field: Symbol) -> Bool {
  match structure.kind {
    TypeNode { connective: Conj } =>
      if content_hash(n: structure).digest == content_hash(n: inhabitant).digest {
        false
      } else {
        fold(structure.children, init: false, f: fn(acc, e) {
          acc || match e.label {
            Authored { name: name } =>
              name == field || match binder_node_parts(n: e.target) {
                Present { value: parts } => algebra_structure_declares_field(structure: parts.type_node, inhabitant: inhabitant, field: field)
                Absent => false
              }
            _ => false
          }
        })
      }
    _ => false
  }
}

fn magma_node(inhabitant: Node) -> Node {
  algebra_inhabitance_node(
    algebra: magma_type_node(inhabitant: inhabitant),
    inhabitant: inhabitant
  )
}

