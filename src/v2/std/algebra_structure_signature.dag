module v2.std.algebra_structure_signature
import std.occurrence_identity { OccurrenceSynthetic }
import v2.std.algebra { algebra_empty_conj }
import v2.std.arrow_signature { anonymous_signature_arrow }
import v2.std.logic { bool_node }
import v2.std.node { Atom, Conj, Disj, Edge, Named, Node, TypeNode }

// THE ALGEBRA'S STRUCTURE SIGNATURES AS NODES: each algebraic structure std.algebra declares (magma
// through boolean algebra, equivalence, the free monoid) projected to the TypeNode its instances
// inhabit, and the inhabitance node joining a structure to its carrier. Homed ABOVE
// v2.std.arrow_signature because an operation's signature is an Arrow, built by
// anonymous_signature_arrow -- the one encoding -- and v2.std.algebra's list folds sit beneath it.

fn free_monoid_tail_type_fixpoint(inhabitant: Node) -> Node {
  algebra_inhabitance_node(
    algebra: Node {
      kind: TypeNode { connective: Conj },
      children: [
        Edge { label: Named { name: ^free_monoid_type_fixpoint }, target: algebra_empty_conj() },
      ],
      occurrence_id: OccurrenceSynthetic
},
    inhabitant: inhabitant,
  )
}

fn free_monoid_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Disj },
    children: [
      Edge { label: Named { name: ^free_monoid_variant_empty }, target: algebra_empty_conj() },
      Edge {
        label: Named { name: ^free_monoid_variant_cons },
        target: Node {
          kind: TypeNode { connective: Conj },
          children: [
            Edge { label: Named { name: ^free_monoid_field_head }, target: inhabitant },
            Edge {
              label: Named { name: ^free_monoid_field_tail },
              target: free_monoid_tail_type_fixpoint(inhabitant: inhabitant),
            },
          ],
          occurrence_id: OccurrenceSynthetic
},
      },
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn algebra_binary_fn_node(domain: Node, codomain: Node) -> Node {
  anonymous_signature_arrow(domain_types: [domain, domain], codomain: codomain, source: domain)
}

fn algebra_unary_fn_node(domain: Node, codomain: Node) -> Node {
  anonymous_signature_arrow(domain_types: [domain], codomain: codomain, source: domain)
}

fn ordering_type_node() -> Node {
  Node {
    kind: TypeNode { connective: Disj },
    children: [
      Edge { label: Named { name: ^ordering_variant_less }, target: algebra_empty_conj() },
      Edge { label: Named { name: ^ordering_variant_equal }, target: algebra_empty_conj() },
      Edge { label: Named { name: ^ordering_variant_greater }, target: algebra_empty_conj() },
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn magma_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^magma_field_op },
        target: algebra_binary_fn_node(domain: inhabitant, codomain: inhabitant)
      },
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn semigroup_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: ^semigroup_field_magma }, target: magma_type_node(inhabitant: inhabitant) },
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn monoid_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: ^monoid_field_semigroup }, target: semigroup_type_node(inhabitant: inhabitant) },
      Edge { label: Named { name: ^monoid_field_identity }, target: inhabitant },
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn commutative_monoid_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: ^commutative_monoid_field_monoid }, target: monoid_type_node(inhabitant: inhabitant) },
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn group_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: ^group_field_monoid }, target: monoid_type_node(inhabitant: inhabitant) },
      Edge {
        label: Named { name: ^group_field_inverse },
        target: algebra_unary_fn_node(domain: inhabitant, codomain: inhabitant)
      },
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn abelian_group_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: ^abelian_group_field_group }, target: group_type_node(inhabitant: inhabitant) },
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn semiring_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: ^semiring_field_add }, target: commutative_monoid_type_node(inhabitant: inhabitant) },
      Edge { label: Named { name: ^semiring_field_mul }, target: monoid_type_node(inhabitant: inhabitant) },
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn commutative_semiring_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: ^commutative_semiring_field_semiring }, target: semiring_type_node(inhabitant: inhabitant) },
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn ring_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: ^ring_field_add }, target: abelian_group_type_node(inhabitant: inhabitant) },
      Edge { label: Named { name: ^ring_field_mul }, target: monoid_type_node(inhabitant: inhabitant) },
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn commutative_ring_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: ^commutative_ring_field_ring }, target: ring_type_node(inhabitant: inhabitant) },
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn ordered_ring_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: ^ordered_ring_field_ring }, target: ring_type_node(inhabitant: inhabitant) },
      Edge {
        label: Named { name: ^ordered_ring_field_compare },
        target: algebra_binary_fn_node(domain: inhabitant, codomain: ordering_type_node())
      },
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn field_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: ^field_field_commutative_ring }, target: commutative_ring_type_node(inhabitant: inhabitant) },
      Edge { label: Named { name: ^field_field_reciprocal }, target: algebra_unary_fn_node(domain: inhabitant, codomain: inhabitant) },
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn field_reciprocal_operation_node() -> Node {
  Node { kind: TypeNode { connective: Atom { identity: ^field_reciprocal_operation } }, children: [],
 occurrence_id: OccurrenceSynthetic
}
}

fn field_reciprocal_nonzero_precondition_node() -> Node {
  Node { kind: TypeNode { connective: Atom { identity: ^field_reciprocal_nonzero_precondition } }, children: [],
 occurrence_id: OccurrenceSynthetic
}
}

fn approximate_field_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^approximate_field_field_add },
        target: algebra_binary_fn_node(domain: inhabitant, codomain: inhabitant)
      },
      Edge { label: Named { name: ^approximate_field_field_zero }, target: inhabitant },
      Edge {
        label: Named { name: ^approximate_field_field_negate },
        target: algebra_unary_fn_node(domain: inhabitant, codomain: inhabitant)
      },
      Edge {
        label: Named { name: ^approximate_field_field_mul },
        target: algebra_binary_fn_node(domain: inhabitant, codomain: inhabitant)
      },
      Edge { label: Named { name: ^approximate_field_field_one }, target: inhabitant },
      Edge {
        label: Named { name: ^approximate_field_field_compare },
        target: algebra_binary_fn_node(domain: inhabitant, codomain: ordering_type_node())
      },
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn lattice_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^lattice_field_meet },
        target: algebra_binary_fn_node(domain: inhabitant, codomain: inhabitant)
      },
      Edge {
        label: Named { name: ^lattice_field_join },
        target: algebra_binary_fn_node(domain: inhabitant, codomain: inhabitant)
      },
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn bounded_lattice_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: ^bounded_lattice_field_lattice }, target: lattice_type_node(inhabitant: inhabitant) },
      Edge { label: Named { name: ^bounded_lattice_field_top }, target: inhabitant },
      Edge { label: Named { name: ^bounded_lattice_field_bottom }, target: inhabitant },
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn boolean_algebra_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^boolean_algebra_field_bounded_lattice },
        target: bounded_lattice_type_node(inhabitant: inhabitant)
      },
      Edge {
        label: Named { name: ^boolean_algebra_field_complement },
        target: algebra_unary_fn_node(domain: inhabitant, codomain: inhabitant)
      },
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn algebra_inhabitance_node(algebra: Node, inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: ^algebra_edge }, target: algebra },
      Edge { label: Named { name: ^inhabitant_edge }, target: inhabitant },
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn magma_node(inhabitant: Node) -> Node {
  algebra_inhabitance_node(
    algebra: magma_type_node(inhabitant: inhabitant),
    inhabitant: inhabitant
  )
}

fn semigroup_node(inhabitant: Node) -> Node {
  algebra_inhabitance_node(
    algebra: semigroup_type_node(inhabitant: inhabitant),
    inhabitant: inhabitant
  )
}

