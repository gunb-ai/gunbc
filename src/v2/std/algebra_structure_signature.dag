fn algebra_inhabitance_node(algebra: Node, inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Authored { name: ^algebra_edge }, target: algebra },
      Edge { label: Authored { name: ^inhabitant_edge }, target: inhabitant },
    ],
    occurrence_id: OccurrenceSynthetic
}
}

// THE BINDERS THROUGH WHICH ONE STRUCTURE COMPOSES ANOTHER, DERIVED from the constructors rather than restated:
// each structure signature is built over an ATOM probe carrier -- which no structure can be mistaken for -- and a
// binder whose type is itself a structure (a Conj) is a composing field (ordered_ring's ^ordered_ring_field_ring,
// ring's ^ring_field_add). Every other binder is an operation (an Arrow) or the carrier. Deciding composition by a
// field's NAME from this derived set, never by the shape of the node at hand, keeps a record-shaped carrier from
// being taken for a sub-structure. The constructor roster below is the one place the structure set is listed.
fn algebra_structure_signatures_over(carrier: Node) -> List<Node> {
  [magma_type_node(inhabitant: carrier), semigroup_type_node(inhabitant: carrier), monoid_type_node(inhabitant: carrier),
   commutative_monoid_type_node(inhabitant: carrier), group_type_node(inhabitant: carrier), abelian_group_type_node(inhabitant: carrier),
   semiring_type_node(inhabitant: carrier), commutative_semiring_type_node(inhabitant: carrier), ring_type_node(inhabitant: carrier),
   commutative_ring_type_node(inhabitant: carrier), ordered_ring_type_node(inhabitant: carrier), field_type_node(inhabitant: carrier),
   approximate_field_type_node(inhabitant: carrier), lattice_type_node(inhabitant: carrier), bounded_lattice_type_node(inhabitant: carrier),
   boolean_algebra_type_node(inhabitant: carrier), equivalence_type_node(inhabitant: carrier), free_monoid_structure_type_node(inhabitant: carrier, generator: carrier)]
}

data algebra_structure_composing_fields: List<Symbol> = algebra_structure_typed_binders(structures: algebra_structure_signatures_over(carrier: Node { kind: TypeNode { connective: Atom { identity: ^algebra_signature_probe_carrier } }, children: [], occurrence_id: OccurrenceSynthetic }))

fn algebra_structure_typed_binders(structures: List<Node>) -> List<Symbol> {
  fold(structures, init: [], f: fn(acc, structure) {
    fold(structure.children, init: acc, f: fn(inner, e) {
      match e.label {
        Authored { name: name } =>
          match binder_node_parts(n: e.target) {
            Present { value: parts } =>
              match conj_children_optional(n: parts.type_node) {
                Present { value: _ } => list_snoc_item(xs: inner, item: name)
                Absent => inner
              }
            Absent => inner
          }
        StructuralLabel { label: _ } => inner
        Positional => inner
      }
    })
  })
}

// WHETHER AN INHABITANCE'S STRUCTURE DECLARES AN OPERATION FIELD -- typed, so a malformed inhabitance node is
// never mistaken for a structure that lacks the field (DESIGN section 5: no fabricated plausible answer). A
// field is declared when the structure binds it, or when a sub-structure it composes (through a binder in
// algebra_structure_composing_fields) declares it. An operation's signature and the carrier are never entered.
type AlgebraFieldDeclaration
  = FieldDeclared
  | FieldNotDeclared
  | InhabitanceMalformed { cause: Symbol }

// THE INHABITANCE'S CARRIER AND ITS ANSWER FOR ONE FIELD, READ TOGETHER FROM THE ONE NODE THAT STATES BOTH: the
// ^inhabitant_edge target IS the carrier the structure is over, so a consumer selecting an inhabitance by its
// carrier reads it here, and never from a second copy stored beside the node (which could disagree with it and
// would make the structure's fields answer for a type it is not over).
type AlgebraInhabitanceFieldReading
  = InhabitanceFieldRead { carrier: Node, declaration: AlgebraFieldDeclaration }
  | InhabitanceFieldReadMalformed { cause: Symbol }

fn algebra_inhabitance_field_reading(inhabitance: Node, field: Symbol) -> AlgebraInhabitanceFieldReading {
  match named_child_lookup(root: inhabitance, name: ^inhabitant_edge) {
    NamedChildMissing => InhabitanceFieldReadMalformed { cause: ^algebra_inhabitance_inhabitant_edge_missing }
    NamedChildAmbiguous => InhabitanceFieldReadMalformed { cause: ^algebra_inhabitance_inhabitant_edge_ambiguous }
    NamedChildFound { target: carrier } =>
      match named_child_lookup(root: inhabitance, name: ^algebra_edge) {
        NamedChildMissing => InhabitanceFieldReadMalformed { cause: ^algebra_inhabitance_algebra_edge_missing }
        NamedChildAmbiguous => InhabitanceFieldReadMalformed { cause: ^algebra_inhabitance_algebra_edge_ambiguous }
        NamedChildFound { target: algebra } =>
          InhabitanceFieldRead { carrier: carrier, declaration: algebra_structure_field_declaration(structure: algebra, field: field) }
      }
  }
}

fn algebra_inhabitance_field_declaration(inhabitance: Node, field: Symbol) -> AlgebraFieldDeclaration {
  match algebra_inhabitance_field_reading(inhabitance: inhabitance, field: field) {
    InhabitanceFieldReadMalformed { cause: c } => InhabitanceMalformed { cause: c }
    InhabitanceFieldRead { carrier: _, declaration: d } => d
  }
}

// THE STRUCTURE IS READ AS WHAT IT MUST BE, AND ANY OTHER SHAPE IS MALFORMED -- never a plausible answer. A
// structure is a Conj whose every child is an Authored BINDER; a field is declared only by a binder (a matching
// name on a non-binder edge is malformed, not declared); a composing field must carry a structure (a composing
// binder over an atom is malformed, not a structure lacking the field). EVERY member is classified, and every
// composing sub-structure validated, before an answer is given: per-member results combine with precedence
// InhabitanceMalformed > FieldDeclared > FieldNotDeclared, so a declared field never excuses a malformed member
// beside it or beneath it.
fn algebra_structure_field_declaration(structure: Node, field: Symbol) -> AlgebraFieldDeclaration {
  match conj_children_optional(n: structure) {
    Absent => InhabitanceMalformed { cause: ^algebra_structure_not_a_conj }
    Present { value: members } =>
      fold(members, init: FieldNotDeclared, f: fn(acc, e) {
        algebra_field_declaration_join(a: acc, b: algebra_structure_edge_field_declaration(e: e, field: field))
      })
  }
}

// The precedence join: the first malformed cause wins, then a declaration, then absence.
fn algebra_field_declaration_join(a: AlgebraFieldDeclaration, b: AlgebraFieldDeclaration) -> AlgebraFieldDeclaration {
  match a {
    InhabitanceMalformed { cause: _ } => a
    FieldDeclared =>
      match b {
        InhabitanceMalformed { cause: _ } => b
        FieldDeclared => a
        FieldNotDeclared => a
      }
    FieldNotDeclared => b
  }
}

fn algebra_structure_edge_field_declaration(e: Edge, field: Symbol) -> AlgebraFieldDeclaration {
  match e.label {
    Authored { name: name } =>
      match binder_node_parts(n: e.target) {
        Absent => InhabitanceMalformed { cause: ^algebra_structure_field_not_a_binder }
        Present { value: parts } =>
          algebra_field_declaration_join(
            a: if name == field { FieldDeclared } else { FieldNotDeclared },
            b: if algebra_field_composes_a_structure(name: name) {
              match conj_children_optional(n: parts.type_node) {
                Present { value: _ } => algebra_structure_field_declaration(structure: parts.type_node, field: field)
                Absent => InhabitanceMalformed { cause: ^algebra_composing_field_not_a_structure }
              }
            } else {
              FieldNotDeclared
            }
          )
      }
    StructuralLabel { label: _ } => InhabitanceMalformed { cause: ^algebra_structure_edge_not_authored }
    Positional => InhabitanceMalformed { cause: ^algebra_structure_edge_not_authored }
  }
}

fn algebra_field_composes_a_structure(name: Symbol) -> Bool {
  fold(algebra_structure_composing_fields, init: false, f: fn(acc, f) { acc || f == name })
}

