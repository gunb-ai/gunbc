module v2.std.algebra_structure_signature
import std.occurrence_identity { OccurrenceSynthetic }
import v2.std.algebra { algebra_empty_conj }
import v2.std.arrow_signature { anonymous_signature_arrow }
import v2.std.node_query { NamedChildAmbiguous, NamedChildFound, NamedChildMissing, binder_edge, conj_children_optional, binder_node_parts, named_child_lookup }
import v2.std.logic { bool_node }
import v2.std.node { Atom, Conj, Disj, Edge, Authored, Node, Positional, StructuralLabel, Symbol, TypeNode }
import std.algebra { list_snoc_item }
import v2.std.collection { List }
import v2.std.optional { Absent, Optional, Present, optional_absent, optional_present }

// THE ALGEBRA'S STRUCTURE SIGNATURES AS NODES: each algebraic structure std.algebra declares (magma
// through boolean algebra, equivalence, the free monoid) projected to the TypeNode its instances
// inhabit, and the inhabitance node joining a structure to its carrier. Homed ABOVE
// v2.std.arrow_signature because an operation's signature is an Arrow, built by
// anonymous_signature_arrow -- the one encoding -- and v2.std.algebra's list folds sit beneath it.

fn free_monoid_tail_type_fixpoint(inhabitant: Node) -> Node {
  algebra_inhabitance_node(
    algebra: Node {
      kind: TypeNode { connective: Conj },
      children: [
        Edge { label: Authored { name: ^free_monoid_type_fixpoint }, target: algebra_empty_conj() },
      ],
      occurrence_id: OccurrenceSynthetic
},
    inhabitant: inhabitant,
  )
}

fn free_monoid_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Disj },
    children: [
      Edge { label: Authored { name: ^free_monoid_variant_empty }, target: algebra_empty_conj() },
      Edge {
        label: Authored { name: ^free_monoid_variant_cons },
        target: Node {
          kind: TypeNode { connective: Conj },
          children: [
            binder_edge(name: ^free_monoid_field_head, type_node: inhabitant),
            binder_edge(name: ^free_monoid_field_tail, type_node: free_monoid_tail_type_fixpoint(inhabitant: inhabitant)),
          ],
          occurrence_id: OccurrenceSynthetic
},
      },
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn algebra_binary_fn_node(domain: Node, codomain: Node) -> Node {
  anonymous_signature_arrow(domain_types: [domain, domain], codomain: codomain, source: domain)
}

fn algebra_unary_fn_node(domain: Node, codomain: Node) -> Node {
  anonymous_signature_arrow(domain_types: [domain], codomain: codomain, source: domain)
}

// THE FREE MONOID AS A STRUCTURE, distinct from free_monoid_type_node (its CARRIER, the Empty|Cons
// coproduct). A monoid free over a generator set: its operation is concatenation, named by its OWN binder
// ^free_monoid_field_concat, never ^magma_field_op -- Int's ordered ring composes a (commutative, not free)
// monoid, and a field read by name through composed sub-structures (algebra_inhabitance_field_declaration)
// would otherwise take Int's + for concatenation. Inhabited by std.algebra FreeMonoid<T> and by the kernel
// host text (the free monoid over Unicode scalars, Ruling 3's FreeMonoid<Char> reading held on its own
// carrier), each by a declared row in v2.extdeps.languages.dag.
//
// A FREE monoid is free OVER A GENERATOR SET, so the structure carries its GENERATOR as a binder
// (^free_monoid_structure_field_generator): ONE model for every carrier (calm-boar-904, ruling B). For
// std.algebra FreeMonoid<T> the generator is T; the kernel host text INHABITS the structure with generator
// std.types Char -- inhabitance, not identity with v2's FreeMonoid<Char>, so Ruling 3's no-crossing holds.
// An element-reading operation over a bound carrier reads its element from this binder
// (free_monoid_structure_generator_optional), never from the carrier's spelling.
fn free_monoid_structure_type_node(inhabitant: Node, generator: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      binder_edge(name: ^free_monoid_structure_field_monoid, type_node: monoid_type_node(inhabitant: inhabitant)),
      binder_edge(name: ^free_monoid_field_concat, type_node: algebra_binary_fn_node(domain: inhabitant, codomain: inhabitant)),
      binder_edge(name: ^free_monoid_structure_field_generator, type_node: generator),
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn free_monoid_structure_node(inhabitant: Node, generator: Node) -> Node {
  algebra_inhabitance_node(
    algebra: free_monoid_structure_type_node(inhabitant: inhabitant, generator: generator),
    inhabitant: inhabitant
  )
}

// THE GENERATOR A FREE-MONOID INHABITANCE NODE DECLARES: the type its algebra's
// ^free_monoid_structure_field_generator binder carries. Absent for any node that is not exactly that (no
// algebra, no generator binder, or either ambiguous), so a caller refuses rather than guessing an element.
fn free_monoid_structure_generator_optional(inhabitance: Node) -> Optional<Node> {
  match named_child_lookup(root: inhabitance, name: ^algebra_edge) {
    NamedChildFound { target: algebra } =>
      match named_child_lookup(root: algebra, name: ^free_monoid_structure_field_generator) {
        NamedChildFound { target: binder } =>
          match binder_node_parts(n: binder) {
            Present { value: parts } => optional_present(value: parts.type_node)
            Absent => optional_absent()
          }
        NamedChildMissing => optional_absent()
        NamedChildAmbiguous => optional_absent()
      }
    NamedChildMissing => optional_absent()
    NamedChildAmbiguous => optional_absent()
  }
}

fn ordering_type_node() -> Node {
  Node {
    kind: TypeNode { connective: Disj },
    children: [
      Edge { label: Authored { name: ^ordering_variant_less }, target: algebra_empty_conj() },
      Edge { label: Authored { name: ^ordering_variant_equal }, target: algebra_empty_conj() },
      Edge { label: Authored { name: ^ordering_variant_greater }, target: algebra_empty_conj() },
    ],
    occurrence_id: OccurrenceSynthetic
}
}

