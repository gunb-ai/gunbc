  Node {
    kind: TypeNode { connective: Conj },
    children: [
      binder_edge(name: ^semiring_field_add, type_node: commutative_monoid_type_node(inhabitant: inhabitant)),
      binder_edge(name: ^semiring_field_mul, type_node: monoid_type_node(inhabitant: inhabitant)),
    ],
    occurrence_id: OccurrenceSynthetic
}
}

