  Node {
    kind: TypeNode { connective: Conj },
    children: [
      binder_edge(name: ^bounded_lattice_field_lattice, type_node: lattice_type_node(inhabitant: inhabitant)),
      binder_edge(name: ^bounded_lattice_field_top, type_node: inhabitant),
      binder_edge(name: ^bounded_lattice_field_bottom, type_node: inhabitant),
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn boolean_algebra_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      binder_edge(name: ^boolean_algebra_field_bounded_lattice, type_node: bounded_lattice_type_node(inhabitant: inhabitant)),
      binder_edge(name: ^boolean_algebra_field_complement, type_node: algebra_unary_fn_node(domain: inhabitant, codomain: inhabitant)),
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn algebra_inhabitance_node(algebra: Node, inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Authored { name: ^algebra_edge }, target: algebra },
      Edge { label: Authored { name: ^inhabitant_edge }, target: inhabitant },
    ],
    occurrence_id: OccurrenceSynthetic
}
}

// THE BINDERS THROUGH WHICH ONE STRUCTURE COMPOSES ANOTHER, declared once beside the constructors that build
// them: each names a binder whose type is another structure's *_type_node (ordered_ring's ^ordered_ring_field_ring
// is a ring; ring's ^ring_field_add is an abelian group). Every other binder is an OPERATION (an Arrow) or a
// fixpoint, and is never a structure to enter. Composition is therefore read from this declaration, never
// guessed from a node's shape -- a carrier that is itself a record is not mistaken for a sub-structure.
// v2.test.claim.dag_algebra_inhabitance holds this list equal to the constructors' structure-typed binders.
data algebra_structure_composing_fields: List<Symbol> = [
  ^abelian_group_field_group,
  ^boolean_algebra_field_bounded_lattice,
  ^bounded_lattice_field_lattice,
  ^commutative_monoid_field_monoid,
  ^commutative_ring_field_ring,
  ^commutative_semiring_field_semiring,
  ^field_field_commutative_ring,
  ^group_field_monoid,
  ^monoid_field_semigroup,
  ^ordered_ring_field_ring,
  ^ring_field_add,
  ^ring_field_mul,
  ^semigroup_field_magma,
  ^semiring_field_add,
  ^semiring_field_mul
]

// WHETHER AN INHABITANCE'S STRUCTURE DECLARES AN OPERATION FIELD -- typed, so a malformed inhabitance node is
// never mistaken for a structure that lacks the field (DESIGN section 5: no fabricated plausible answer). A
// field is declared when the structure binds it, or when a sub-structure it composes (through a binder in
// algebra_structure_composing_fields) declares it. An operation's signature and the carrier are never entered.
type AlgebraFieldDeclaration
  = FieldDeclared
  | FieldNotDeclared
  | InhabitanceMalformed { cause: Symbol }

fn algebra_inhabitance_field_declaration(inhabitance: Node, field: Symbol) -> AlgebraFieldDeclaration {
  match named_child_lookup(root: inhabitance, name: ^inhabitant_edge) {
    NamedChildMissing => InhabitanceMalformed { cause: ^algebra_inhabitance_inhabitant_edge_missing }
    NamedChildAmbiguous => InhabitanceMalformed { cause: ^algebra_inhabitance_inhabitant_edge_ambiguous }
    NamedChildFound { target: _ } =>
      match named_child_lookup(root: inhabitance, name: ^algebra_edge) {
        NamedChildMissing => InhabitanceMalformed { cause: ^algebra_inhabitance_algebra_edge_missing }
        NamedChildAmbiguous => InhabitanceMalformed { cause: ^algebra_inhabitance_algebra_edge_ambiguous }
        NamedChildFound { target: algebra } =>
          if algebra_structure_declares_field(structure: algebra, field: field) { FieldDeclared } else { FieldNotDeclared }
      }
  }
}

fn algebra_structure_declares_field(structure: Node, field: Symbol) -> Bool {
  fold(structure.children, init: false, f: fn(acc, e) {
    acc || match e.label {
      Authored { name: name } =>
        name == field || (algebra_field_composes_a_structure(name: name) && match binder_node_parts(n: e.target) {
          Present { value: parts } => algebra_structure_declares_field(structure: parts.type_node, field: field)
          Absent => false
        })
      StructuralLabel { label: _ } => false
      Positional => false
    }
  })
}

fn algebra_field_composes_a_structure(name: Symbol) -> Bool {
  fold(algebra_structure_composing_fields, init: false, f: fn(acc, f) { acc || f == name })
}

fn magma_node(inhabitant: Node) -> Node {
  algebra_inhabitance_node(
    algebra: magma_type_node(inhabitant: inhabitant),
    inhabitant: inhabitant
  )
}

