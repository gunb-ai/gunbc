    occurrence_id: OccurrenceSynthetic
}
}

fn group_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      binder_edge(name: ^group_field_monoid, type_node: monoid_type_node(inhabitant: inhabitant)),
      binder_edge(name: ^group_field_inverse, type_node: algebra_unary_fn_node(domain: inhabitant, codomain: inhabitant)),
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn abelian_group_type_node(inhabitant: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      binder_edge(name: ^abelian_group_field_group, type_node: group_type_node(inhabitant: inhabitant)),
