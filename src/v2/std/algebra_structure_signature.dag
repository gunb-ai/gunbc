      binder_edge(name: ^monoid_field_semigroup, type_node: semigroup_type_node(inhabitant: inhabitant)),
      binder_edge(name: ^monoid_field_identity, type_node: inhabitant),
    ],
    occurrence_id: OccurrenceSynthetic
}
}

