module v2.test.std_dependents.dependents_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = ReadsLiveTree

test fn dependents_untracked_is_unused() -> Bool {
  no_dependents(d: Untracked)
}

test fn dependents_empty_is_unused() -> Bool {
  no_dependents(d: v2.std.dependents.Tracked { uses: [] })
}

test fn dependents_with_use_is_live() -> Bool {
  match no_dependents(d: v2.std.dependents.Tracked { uses: [std.occurrence_identity.alloc_occurrence_id(alloc: std.occurrence_identity.occurrence_id_allocator_initial()).id] }) {
    true => false
    false => true
  }
}
