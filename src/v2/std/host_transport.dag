module v2.std.host_transport

type ByteString = std.types.List<v2.test.claim.byte_cardinality_grounding.Byte>

type RelPath = String

type WorkspaceContent
  = EmittedSource
  | FixedText { text: String }
  | EmittedWithSuffix { suffix: String }

type WorkspaceFile {
  path: RelPath
  content: WorkspaceContent
}

type MaterializedWorkspaceFile {
  path: RelPath
  text: String
}

type InvocationArg
  = LiteralArg { text: String }
  | WorkspacePath { path: RelPath }
  | ProducedArtifact { path: RelPath }

type ProcessProgram
  = HostToolProgram { executable: String }
  | ProducedProgram { path: RelPath }

type ProcessInvocation {
  program: ProcessProgram
  args: std.types.List<InvocationArg>
}

type RuntimeValueCodec
  = FixedWidthBytes { width: v2.std.integer.Int }
  | SignedI32Le

type HostTransportDescriptor {
  identity: v2.std.node.Symbol
  workspace: std.types.List<WorkspaceFile>
  build: std.types.List<ProcessInvocation>
  run: ProcessInvocation
  runtime_value_codec: RuntimeValueCodec
}

type EmitHostRuntimeRow {
  transport: HostTransportDescriptor
  runtime_primitive_type: v2.std.node.Node
}

type TargetEmitHostRuntimeRow
  = HostRuntimeRowPresent { row: EmitHostRuntimeRow }
  | HostRuntimeRowAbsent

data target_emit_host_runtime_row_unconfigured: TargetEmitHostRuntimeRow = HostRuntimeRowAbsent

fn emit_host_runtime_row_unconfigured_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^emit_host_runtime_row_unconfigured_reason,
    at: v2.std.diagnostic.port_locus(port: ^emit_host_runtime_row_unconfigured_reason),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.CorrectionNotModeled }
  }
}

fn emit_host_runtime_row_parse_byte_width_mismatch_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^emit_host_runtime_row_parse_byte_width_mismatch,
    at: v2.std.diagnostic.port_locus(port: ^emit_host_runtime_row_parse_byte_width_mismatch),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.CorrectionNotModeled }
  }
}

fn runtime_value_codec_expected_byte_count(codec: RuntimeValueCodec) -> v2.std.integer.Int {
  match codec {
    FixedWidthBytes { width: w } => w
    SignedI32Le => 4
  }
}

fn runtime_value_parse_from_row(
  row: EmitHostRuntimeRow,
  bytes: ByteString
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  let expected = runtime_value_codec_expected_byte_count(codec: row.transport.runtime_value_codec)
  if v2.std.algebra.length(xs: bytes) == expected {
    v2.std.diagnostic.Accepted {
      value: v2.std.runtime.RuntimePrimitive {
        value: {
          primitive_type: row.runtime_primitive_type,
          bytes: bytes
        }
      },
      diagnostics: v2.std.diagnostic.None
    }
  } else {
    v2.std.diagnostic.Rejected {
      diagnostics: v2.std.diagnostic.diagnostics_singleton(
        d: emit_host_runtime_row_parse_byte_width_mismatch_diagnostic()
      )
    }
  }
}

fn configured_emit_host_runtime_row_from_target_row(
  row: TargetEmitHostRuntimeRow
) -> v2.std.diagnostic.Outcome<EmitHostRuntimeRow> {
  match row {
    HostRuntimeRowPresent { row: configured } =>
      v2.std.diagnostic.Accepted { value: configured, diagnostics: v2.std.diagnostic.None }
    HostRuntimeRowAbsent =>
      v2.std.diagnostic.outcome_rejected(d: emit_host_runtime_row_unconfigured_diagnostic())
  }
}

type EmittedEffectFamily
  = FilesystemReadFamily
  | ShellExecRunFamily

fn emitted_family_runtime_row_gated(
  family: EmittedEffectFamily,
  present: EmitHostRuntimeRow
) -> TargetEmitHostRuntimeRow {
  match family {
    FilesystemReadFamily => HostRuntimeRowPresent { row: present }
    ShellExecRunFamily => HostRuntimeRowPresent { row: present }
  }
}
