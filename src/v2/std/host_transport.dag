// src/v2/std/host_transport.dag
// Scope: omni-emission host transport descriptor (design-omni-emission-transport.md §3.1).
// Status: B3 minimal substrate — modeled workspace/build/run + runtime-value codec; one generic
//   `run_host_process` primitive; executable host boundary is `dsl/tools/emit_host_gate.dag`.
//   T-22: TargetEmitHostRuntimeRow on TargetModel dissolves per-target authority_source_text
//   dispatch in emit_host.dag (gunbc#4750).

module v2.std.host_transport


import v2.std.algebra { length }
import v2.std.collection { List }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  Outcome,
  Rejected,
  None,
  diagnostics_singleton,
  outcome_rejected,
  port_locus
}
import v2.std.host_run { ByteString }
import v2.std.integer { Int }
import v2.std.node { Node, Symbol }
import v2.std.runtime { RuntimePrimitive, RuntimeValue }
import v2.std.text { String }


data host_tool_npx: Symbol = host_tool_npx
data host_tool_node: Symbol = host_tool_node
data host_tool_tsc: Symbol = host_tool_tsc
data host_tool_cargo: Symbol = host_tool_cargo
data host_tool_python3: Symbol = host_tool_python3
data host_tool_go: Symbol = host_tool_go

data emit_host_runtime_row_unconfigured_reason: Symbol = emit_host_runtime_row_unconfigured_reason
data emit_host_runtime_row_parse_byte_width_mismatch: Symbol = emit_host_runtime_row_parse_byte_width_mismatch

type RelPath = String

type WorkspaceContent
  = EmittedSource
  | FixedText { text: String }
  | EmittedWithSuffix { suffix: String }

type WorkspaceFile {
  path: RelPath
  content: WorkspaceContent
}

type InvocationArg
  = LiteralArg { text: String }
  | WorkspacePath { path: RelPath }
  | ProducedArtifact { path: RelPath }

type ProcessInvocation {
  tool: Symbol
  args: List<InvocationArg>
}

type RuntimeValueCodec
  = FixedWidthBytes { width: Int }
  | SignedI32Le

type HostTransportDescriptor {
  identity: Symbol
  workspace: List<WorkspaceFile>
  build: List<ProcessInvocation>
  run: ProcessInvocation
  runtime_value_codec: RuntimeValueCodec
}

// T-22 — per-target emit-host runtime row (gunbc#4750). Typed field on TargetModel; extdeps
// languages attach EmitHostRuntimeConfigured rows; absent targets stay Unconfigured (fail-closed).
type TargetEmitHostRuntimeRow
  = EmitHostRuntimeConfigured {
      transport: HostTransportDescriptor
      runtime_primitive_type: Node
    }
  | EmitHostRuntimeUnconfigured

data target_emit_host_runtime_row_unconfigured: TargetEmitHostRuntimeRow =
  EmitHostRuntimeUnconfigured

fn emit_host_runtime_row_unconfigured_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: emit_host_runtime_row_unconfigured_reason,
    at: port_locus(port: emit_host_runtime_row_unconfigured_reason),
    correction: None
  }
}

fn emit_host_runtime_row_parse_byte_width_mismatch_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: emit_host_runtime_row_parse_byte_width_mismatch,
    at: port_locus(port: emit_host_runtime_row_parse_byte_width_mismatch),
    correction: None
  }
}

fn runtime_value_codec_expected_byte_count(codec: RuntimeValueCodec) -> Int {
  match codec {
    FixedWidthBytes { width: w } => w
    SignedI32Le => 4
  }
}

fn runtime_value_parse_from_row(
  row: EmitHostRuntimeConfigured,
  bytes: ByteString
) -> Outcome<RuntimeValue> {
  let expected = runtime_value_codec_expected_byte_count(codec: row.transport.runtime_value_codec)
  if length(xs: bytes) == expected {
    Accepted {
      value: RuntimePrimitive {
        value: {
          primitive_type: row.runtime_primitive_type,
          bytes: bytes
        }
      },
      diagnostics: None
    }
  } else {
    Rejected {
      diagnostics: diagnostics_singleton(
        d: emit_host_runtime_row_parse_byte_width_mismatch_diagnostic()
      )
    }
  }
}

fn configured_emit_host_runtime_row_from_target_row(
  row: TargetEmitHostRuntimeRow
) -> Outcome<EmitHostRuntimeConfigured> {
  match row {
    EmitHostRuntimeConfigured { transport: t, runtime_primitive_type: p } =>
      Accepted {
        value: EmitHostRuntimeConfigured {
          transport: t,
          runtime_primitive_type: p
        },
        diagnostics: None
      }
    EmitHostRuntimeUnconfigured =>
      outcome_rejected(d: emit_host_runtime_row_unconfigured_diagnostic())
  }
}
