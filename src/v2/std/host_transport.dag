// src/v2/std/host_transport.dag
// Scope: omni-emission host transport descriptor (design-omni-emission-transport.md §3.1).
// Status: B3 minimal substrate — modeled workspace/build/run + runtime-value codec; one generic
//   `run_host_process` primitive; executable host boundary is `dsl/tools/emit_host_gate.dag`.

module v2.std.host_transport


import v2.std.collection { List }
import v2.std.integer { Int }
import v2.std.node { Symbol }
import v2.std.text { String }


data host_tool_npx: Symbol = host_tool_npx
data host_tool_node: Symbol = host_tool_node
data host_tool_tsc: Symbol = host_tool_tsc

type RelPath = String

type WorkspaceContent
  = EmittedSource
  | FixedText { text: String }
  | EmittedWithSuffix { suffix: String }

type WorkspaceFile {
  path: RelPath
  content: WorkspaceContent
}

type InvocationArg
  = LiteralArg { text: String }
  | WorkspacePath { path: RelPath }
  | ProducedArtifact { path: RelPath }

type ProcessInvocation {
  tool: Symbol
  args: List<InvocationArg>
}

type RuntimeValueCodec
  = FixedWidthBytes { width: Int }
  | SignedI32Le

type HostTransportDescriptor {
  identity: Symbol
  workspace: List<WorkspaceFile>
  build: List<ProcessInvocation>
  run: ProcessInvocation
  runtime_value_codec: RuntimeValueCodec
}
