module v2.std.host_transport

import v2.std.algebra { length }
import v2.std.collection { List }
import v2.std.integer { Int }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  Outcome,
  Rejected,
  CorrectionNotModeled,
  None,
  Unavailable,
  diagnostics_singleton,
  outcome_rejected,
  invariant_port_locus
}
import v2.std.machine { Byte }
import v2.std.node { Node, Symbol }
import v2.std.runtime { RuntimePrimitive, RuntimeValue }
import v2.std.text { String }

type ByteString = List<Byte>

type RelPath = String

type WorkspaceContent
  = EmittedSource
  | FixedText { text: String }
  | EmittedWithSuffix { suffix: String }

type WorkspaceFile {
  path: RelPath
  content: WorkspaceContent
}

type MaterializedWorkspaceFile {
  path: RelPath
  text: String
}

type InvocationArg
  = LiteralArg { text: String }
  | WorkspacePath { path: RelPath }
  | ProducedArtifact { path: RelPath }

type ProcessProgram
  = HostToolProgram { executable: String }
  | ProducedProgram { path: RelPath }

type ProcessInvocation {
  program: ProcessProgram
  args: List<InvocationArg>
}

type RuntimeValueCodec
  = FixedWidthBytes { width: Int }
  | SignedI32Le

type HostTransportDescriptor {
  identity: Symbol
  workspace: List<WorkspaceFile>
  build: List<ProcessInvocation>
  run: ProcessInvocation
  runtime_value_codec: RuntimeValueCodec
}

// THE EMITTED PROGRAM'S BUILD ENVIRONMENT IS A DECLARED ROW, NOT AN INHERITANCE. The host
// transport builds and runs the emitted program under env_clear() plus exactly the variables
// named here, admitted by exact name; every other ambient variable is refused by negation.
// Flag-bearing variables (RUSTFLAGS, RUSTDOCFLAGS, CARGO_ENCODED_RUSTFLAGS, CFLAGS, GOFLAGS,
// ...) are absent BY CONSTRUCTION of the list and deliberately not enumerated as exclusions:
// a build flag is policy, and a policy the emitted program's realization wants is a
// runtime_row field with its own RED, never something the ambient shell exported for
// compiling the seed. The seed used to admit RUST*/CARGO_*/*FLAGS by prefix (and the
// uncached transport inherited the whole environment), so the required floor's
// `RUSTFLAGS=-D warnings` -- exported for the SEED build -- reached the emitted program and
// four emit_host expected-red rows were red only in CI, on `-D dead-code` (gunbc#9727).
// Toolchain-location variables stay, because resolving `cargo`/`rustc`/`cc` is a fact about
// where the toolchain lives, not about how the program is compiled.
data host_build_environment_admitted_names: List<String> = [
  "PATH",
  "HOME",
  "TMPDIR",
  "CARGO_HOME",
  "RUSTUP_HOME",
  "RUSTUP_TOOLCHAIN",
  "CC",
  "CXX",
  "AR",
  "LD_LIBRARY_PATH",
  "LIBRARY_PATH",
  "CPATH",
  "PKG_CONFIG_PATH",
  "SDKROOT",
  "MACOSX_DEPLOYMENT_TARGET",
  "GOROOT",
  "GOPATH",
  "GOCACHE",
  "GOMODCACHE",
  "NODE_PATH",
  "PYTHONPATH",
  "PYTHONHOME"
]

type EmitHostRuntimeRow {
  transport: HostTransportDescriptor
  runtime_primitive_type: Node
}

type TargetEmitHostRuntimeRow
  = HostRuntimeRowPresent { row: EmitHostRuntimeRow }
  | HostRuntimeRowAbsent

data target_emit_host_runtime_row_unconfigured: TargetEmitHostRuntimeRow = HostRuntimeRowAbsent

fn emit_host_runtime_row_unconfigured_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^emit_host_runtime_row_unconfigured_reason,
    at: invariant_port_locus(
      port: ^emit_host_runtime_row_lookup_port,
      invariant: ^emit_host_runtime_row_unconfigured_reason
    ),
    correction: Unavailable { reason: CorrectionNotModeled }
  }
}

fn emit_host_runtime_row_parse_byte_width_mismatch_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^emit_host_runtime_row_parse_byte_width_mismatch,
    at: invariant_port_locus(
      port: ^emit_host_runtime_row_parse_port,
      invariant: ^emit_host_runtime_row_parse_byte_width_mismatch
    ),
    correction: Unavailable { reason: CorrectionNotModeled }
  }
}

fn runtime_value_codec_expected_byte_count(codec: RuntimeValueCodec) -> Int {
  match codec {
    FixedWidthBytes { width: w } => w
    SignedI32Le => 4
  }
}

fn runtime_value_parse_from_row(
  row: EmitHostRuntimeRow,
  bytes: ByteString
) -> Outcome<RuntimeValue> {
  let expected = runtime_value_codec_expected_byte_count(codec: row.transport.runtime_value_codec)
  if length(xs: bytes) == expected {
    Accepted {
      value: RuntimePrimitive {
        value: {
          primitive_type: row.runtime_primitive_type,
          bytes: bytes
        }
      },
      diagnostics: None
    }
  } else {
    Rejected {
      diagnostics: diagnostics_singleton(
        d: emit_host_runtime_row_parse_byte_width_mismatch_diagnostic()
      )
    }
  }
}

fn configured_emit_host_runtime_row_from_target_row(
  row: TargetEmitHostRuntimeRow
) -> Outcome<EmitHostRuntimeRow> {
  match row {
    HostRuntimeRowPresent { row: configured } =>
      Accepted { value: configured, diagnostics: None }
    HostRuntimeRowAbsent =>
      outcome_rejected(d: emit_host_runtime_row_unconfigured_diagnostic())
  }
}

type EmittedEffectFamily
  = FilesystemReadFamily
  | ShellExecRunFamily

fn emitted_family_runtime_row_gated(
  family: EmittedEffectFamily,
  present: EmitHostRuntimeRow
) -> TargetEmitHostRuntimeRow {
  match family {
    FilesystemReadFamily => HostRuntimeRowPresent { row: present }
    ShellExecRunFamily => HostRuntimeRowPresent { row: present }
  }
}
