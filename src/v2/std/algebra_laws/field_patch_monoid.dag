module v2.test.algebra_laws.field_patch_monoid

fn fp_pass_node() -> Node {
  v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^fp_pass_sym } }, children: [],
 occurrence_id: SyntheticOccurrence
}
}
fn fp_fail_node() -> Node {
  v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^fp_fail_sym } }, children: [],
 occurrence_id: SyntheticOccurrence
}
}
fn fp_ok(b: Bool) -> Node {
  if b { fp_pass_node() } else { fp_fail_node() }
}

fn fp_monoid_op(left: FieldPatch<Bool>, right: FieldPatch<Bool>) -> FieldPatch<Bool> {
  let m = field_patch_monoid()
  m.op(left, right)
}
fn fp_monoid_identity() -> FieldPatch<Bool> {
  field_patch_monoid().identity
}

data witness_left_identity: Bool = apply_field_patch(base: false, patch: compose_field_patch(left: Inherit, right: v2.std.patch.Override { value: true })) == true

data witness_right_identity: Bool = apply_field_patch(base: false, patch: compose_field_patch(left: v2.std.patch.Override { value: true }, right: Inherit)) == true

data witness_right_bias: Bool = apply_field_patch(base: true, patch: compose_field_patch(left: v2.std.patch.Override { value: true }, right: v2.std.patch.Override { value: false })) == false

fn compose_assoc_lhs() -> Bool {
  apply_field_patch(base: true, patch: compose_field_patch(left: compose_field_patch(left: v2.std.patch.Override { value: true }, right: v2.std.patch.Override { value: false }), right: Inherit))
}
fn compose_assoc_rhs() -> Bool {
  apply_field_patch(base: true, patch: compose_field_patch(left: v2.std.patch.Override { value: true }, right: compose_field_patch(left: v2.std.patch.Override { value: false }, right: Inherit)))
}
data witness_associativity: Bool = compose_assoc_lhs() == compose_assoc_rhs()

data witness_inherit_preserves: Bool = apply_field_patch(base: true, patch: Inherit) == true

data witness_override_replaces: Bool = apply_field_patch(base: true, patch: v2.std.patch.Override { value: false }) == false

data witness_monoid_identity_preserves: Bool = apply_field_patch(base: true, patch: fp_monoid_identity()) == true

data witness_monoid_left_identity: Bool = apply_field_patch(base: false, patch: fp_monoid_op(left: fp_monoid_identity(), right: v2.std.patch.Override { value: true })) == true

data witness_monoid_right_identity: Bool = apply_field_patch(base: false, patch: fp_monoid_op(left: v2.std.patch.Override { value: true }, right: fp_monoid_identity())) == true

data witness_monoid_right_bias: Bool = apply_field_patch(base: true, patch: fp_monoid_op(left: v2.std.patch.Override { value: true }, right: v2.std.patch.Override { value: false })) == false

data claim_left_identity: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "field_patch/compose: Inherit is left identity",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: fp_ok(b: witness_left_identity),
  expected_value: fp_pass_node(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_right_identity: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "field_patch/compose: Inherit is right identity",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: fp_ok(b: witness_right_identity),
  expected_value: fp_pass_node(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_right_bias: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "field_patch/compose: right Override wins over left Override (later layer)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: fp_ok(b: witness_right_bias),
  expected_value: fp_pass_node(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_associativity: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "field_patch/compose: right-biased composition is associative",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: fp_ok(b: witness_associativity),
  expected_value: fp_pass_node(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_inherit_preserves: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "field_patch/apply: Inherit preserves base field value",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: fp_ok(b: witness_inherit_preserves),
  expected_value: fp_pass_node(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_override_replaces: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "field_patch/apply: Override replaces base field value",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: fp_ok(b: witness_override_replaces),
  expected_value: fp_pass_node(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_monoid_identity_preserves: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "field_patch/monoid: identity element preserves base (Monoid witness)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: fp_ok(b: witness_monoid_identity_preserves),
  expected_value: fp_pass_node(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_monoid_left_identity: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "field_patch/monoid: op(identity, p) == p (Monoid witness left identity)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: fp_ok(b: witness_monoid_left_identity),
  expected_value: fp_pass_node(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_monoid_right_identity: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "field_patch/monoid: op(p, identity) == p (Monoid witness right identity)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: fp_ok(b: witness_monoid_right_identity),
  expected_value: fp_pass_node(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_monoid_right_bias: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "field_patch/monoid: op(Override, Override) right-biased (later layer wins)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: fp_ok(b: witness_monoid_right_bias),
  expected_value: fp_pass_node(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
