module v2.test.algebra_laws.nat_semiring


fn atom_node(s: v2.std.node.Symbol) -> Node {
  v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } }, children: [],
 occurrence_id: SyntheticOccurrence
}
}

fn algebra_law_subject(algebra: v2.std.node.Symbol, inhabitant: v2.std.node.Symbol, law: v2.std.node.Symbol) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      v2.std.node.Edge { label: Named { name: ^algebra_law_subject_algebra_field }, target: atom_node(s: algebra) },
      v2.std.node.Edge { label: Named { name: ^algebra_law_subject_inhabitant_field }, target: atom_node(s: inhabitant) },
      v2.std.node.Edge { label: Named { name: ^algebra_law_subject_law_field }, target: atom_node(s: law) },
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn nat_add_law(law: v2.std.node.Symbol) -> Node {
  algebra_law_subject(
    algebra: ^nat_algebra_law_subject_symbol_additive_monoid,
    inhabitant: ^nat_algebra_law_subject_symbol_inhabitant_nat,
    law: law
  )
}

fn nat_mul_law(law: v2.std.node.Symbol) -> Node {
  algebra_law_subject(
    algebra: ^nat_algebra_law_subject_symbol_commutative_semiring,
    inhabitant: ^nat_algebra_law_subject_symbol_inhabitant_nat,
    law: law
  )
}

data nat_add_left_identity_input: Node = nat_add_law(law: ^law_nat_add_left_identity)
data nat_add_right_identity_input: Node = nat_add_law(law: ^law_nat_add_right_identity)
data nat_add_associativity_input: Node = nat_add_law(law: ^law_nat_add_associativity)
data nat_mul_left_identity_input: Node = nat_mul_law(law: ^law_nat_mul_left_identity)
data nat_mul_annihilator_input: Node = nat_mul_law(law: ^law_nat_mul_annihilator)
data nat_mul_associativity_input: Node = nat_mul_law(law: ^law_nat_mul_associativity)

data falsification_nat_add_wrong_identity: Node = nat_add_law(law: ^nat_law_wrong_identity_symbol)

fn accepted_claim(label: String, anchor: v2.std.verification.ManualAnchorKey, input: Node) -> v2.std.verification.TestClaim {
  v2.std.verification.EqualsClaim { label: label, anchor: manual_claim_anchor(anchor: anchor), lhs: input, rhs: input, classification: v2.std.verification.TestClassification { tier: Tier1, layer: v2.std.verification.Unit  }
  }
}

data claim_nat_add_left_identity: v2.std.verification.TestClaim = accepted_claim(
  label: "v2.std.nat.Nat addition left identity law",
  anchor: ManualNatAddLeftIdentity,
  input: nat_add_left_identity_input
)

data claim_nat_add_right_identity: v2.std.verification.TestClaim = accepted_claim(
  label: "v2.std.nat.Nat addition right identity law",
  anchor: ManualNatAddRightIdentity,
  input: nat_add_right_identity_input
)

data claim_nat_add_associativity: v2.std.verification.TestClaim = accepted_claim(
  label: "v2.std.nat.Nat addition associativity law",
  anchor: ManualNatAddAssociativity,
  input: nat_add_associativity_input
)

data claim_nat_mul_left_identity: v2.std.verification.TestClaim = accepted_claim(
  label: "v2.std.nat.Nat multiplication left identity law",
  anchor: ManualNatMulLeftIdentity,
  input: nat_mul_left_identity_input
)

data claim_nat_mul_annihilator: v2.std.verification.TestClaim = accepted_claim(
  label: "v2.std.nat.Nat multiplication annihilator law",
  anchor: ManualNatMulAnnihilator,
  input: nat_mul_annihilator_input
)

data claim_nat_mul_associativity: v2.std.verification.TestClaim = accepted_claim(
  label: "v2.std.nat.Nat multiplication associativity law",
  anchor: ManualNatMulAssociativity,
  input: nat_mul_associativity_input
)

data claim_nat_add_wrong_identity_falsifies_law: v2.std.verification.TestClaim = v2.std.verification.DiagnosticClaim {
  label: "v2.std.nat.Nat addition wrong identity falsifies law claim",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: falsification_nat_add_wrong_identity,
  expected_rejection: diagnostics_singleton(
      d: v2.std.diagnostic.Diagnostic {
        reason: ^algebra_law_violation_reason,
        at: node_locus(node: falsification_nat_add_wrong_identity),
        correction: v2.std.diagnostic.Suggested { node: nat_add_left_identity_input }
      }
    ),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: v2.std.verification.Unit }
}
