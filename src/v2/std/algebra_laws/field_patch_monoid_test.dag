module v2.test.algebra_laws.field_patch_monoid


fn fp_monoid_op(left: v2.std.patch.FieldPatch<Bool>, right: v2.std.patch.FieldPatch<Bool>) -> v2.std.patch.FieldPatch<Bool> {
  let m = v2.std.patch.field_patch_monoid()
  m.op(left, right)
}
fn fp_monoid_identity() -> v2.std.patch.FieldPatch<Bool> {
  v2.std.patch.field_patch_monoid().identity
}

test fn witness_left_identity() -> Bool {
  v2.std.patch.apply_field_patch(base: false, patch: v2.std.patch.compose_field_patch(left: v2.std.patch.Inherit, right: v2.std.patch.Override { value: true })) == true
}

test fn witness_right_identity() -> Bool {
  v2.std.patch.apply_field_patch(base: false, patch: v2.std.patch.compose_field_patch(left: v2.std.patch.Override { value: true }, right: v2.std.patch.Inherit)) == true
}

test fn witness_right_bias() -> Bool {
  v2.std.patch.apply_field_patch(base: true, patch: v2.std.patch.compose_field_patch(left: v2.std.patch.Override { value: true }, right: v2.std.patch.Override { value: false })) == false
}

fn compose_assoc_lhs() -> Bool {
  v2.std.patch.apply_field_patch(base: true, patch: v2.std.patch.compose_field_patch(left: v2.std.patch.compose_field_patch(left: v2.std.patch.Override { value: true }, right: v2.std.patch.Override { value: false }), right: v2.std.patch.Inherit))
}
fn compose_assoc_rhs() -> Bool {
  v2.std.patch.apply_field_patch(base: true, patch: v2.std.patch.compose_field_patch(left: v2.std.patch.Override { value: true }, right: v2.std.patch.compose_field_patch(left: v2.std.patch.Override { value: false }, right: v2.std.patch.Inherit)))
}
test fn witness_associativity() -> Bool {
  compose_assoc_lhs() == compose_assoc_rhs()
}

test fn witness_inherit_preserves() -> Bool {
  v2.std.patch.apply_field_patch(base: true, patch: v2.std.patch.Inherit) == true
}

test fn witness_override_replaces() -> Bool {
  v2.std.patch.apply_field_patch(base: true, patch: v2.std.patch.Override { value: false }) == false
}

test fn witness_monoid_identity_preserves() -> Bool {
  v2.std.patch.apply_field_patch(base: true, patch: fp_monoid_identity()) == true
}

test fn witness_monoid_left_identity() -> Bool {
  v2.std.patch.apply_field_patch(base: false, patch: fp_monoid_op(left: fp_monoid_identity(), right: v2.std.patch.Override { value: true })) == true
}

test fn witness_monoid_right_identity() -> Bool {
  v2.std.patch.apply_field_patch(base: false, patch: fp_monoid_op(left: v2.std.patch.Override { value: true }, right: fp_monoid_identity())) == true
}

test fn witness_monoid_right_bias() -> Bool {
  v2.std.patch.apply_field_patch(base: true, patch: fp_monoid_op(left: v2.std.patch.Override { value: true }, right: v2.std.patch.Override { value: false })) == false
}
