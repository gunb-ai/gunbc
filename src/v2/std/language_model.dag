module v2.std.language_model


type LanguageModel {
  lex: v2.std.compilers.lexing.LexRules
  grammar: v2.std.grammar.ParseGrammar
  language_identity: v2.std.node.Symbol
  canonical_symbols: std.algebra.PointwisePower<v2.std.node.Symbol>
  core: v2.std.model_core.ModelCore
}

fn language_model_named_edge(name: v2.std.node.Symbol, target: v2.std.node.Node) -> v2.std.node.Edge {
  v2.std.node.Edge {
    label: v2.std.node.Named { name: name },
    target: target
  }
}

fn language_model_empty_canonical_symbols() -> std.algebra.PointwisePower<v2.std.node.Symbol> {
  std.algebra.PointwisePower {
    member: fn(_) {
      false
    }
  }
}

fn void_language_model(identity: v2.std.node.Symbol) -> LanguageModel {
  LanguageModel {
    lex: v2.std.compilers.lexing.VoidLexRules,
    grammar: v2.std.grammar.VoidGrammar,
    language_identity: identity,
    canonical_symbols: language_model_empty_canonical_symbols(),
    core: v2.std.model_core.bool_model_core()
  }
}

fn language_model_canonical_symbols_to_node(symbols: std.algebra.PointwisePower<v2.std.node.Symbol>) -> v2.std.node.Node {
  v2.std.grammar.grammar_empty_node()
}

fn language_model_to_node(lm: LanguageModel) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      language_model_named_edge(
        name: ^language_model_field_lex,
        target: v2.std.compilers.lexing.lex_rules_to_node(rules: lm.lex)
      ),
      language_model_named_edge(
        name: ^language_model_field_grammar,
        target: v2.std.grammar.grammar_to_node(grammar: lm.grammar)
      ),
      language_model_named_edge(
        name: ^language_model_field_language_identity,
        target: v2.std.grammar.grammar_atom(identity: lm.language_identity)
      ),
      language_model_named_edge(
        name: ^language_model_field_canonical_symbols,
        target: language_model_canonical_symbols_to_node(symbols: lm.canonical_symbols)
      ),
      language_model_named_edge(
        name: ^language_model_field_core,
        target: v2.std.model_core.model_core_first_primitive_substrate(core: lm.core)
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}
