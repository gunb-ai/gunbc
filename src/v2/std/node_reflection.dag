module v2.std.node_reflection

import v2.std.collection { List }
import v2.std.diagnostic { Outcome }
import v2.std.node { Node, Symbol }
import v2.std.node_query { coproduct_arm_key_list_from_node }

// THE HOST TYPE-REFLECTION SURFACE, AND WHY IT IS ITS OWN MODULE.
//
// Both declarations below are host seams: their whole body is a self-call, answered by
// the v1 interpreter's live declaration index (roster arms v4_bridge.resolve_type_node
// and v4_bridge.coproduct_nullary_inhabitants). Nothing in the substrate can give them a
// body, because neither the resolved Node for a type NAME nor an inhabitant of an
// arbitrary T is derivable from anything the caller hands them -- the answer is a fact
// about the running compiler's own source index, not about the arguments.
//
// They used to sit in v2.std.node and v2.std.node_query, which the v2 compiler's import
// closure carries. Emission is decided at MODULE grain, so both were emitted into the
// compiler's own Rust crate as panic!("unrealized host seam ..."): a declaration with no
// behaviour on that target, standing in a shipped compiler because rustc accepts a
// diverging body. Neither was reachable from a compile once its one call-reachable
// consumer (target_model's UriScheme node decode) was repointed at a declared inhabitant
// roster, so the residue was module membership and nothing else.
//
// Segregating them here is what makes that provable rather than argued: this module is
// imported only by lenses and witnesses, so a compile-closure declaration that reaches
// reflection again drags THIS module into the closure and the seam reappears in the
// emitted crate -- loudly, at the same grep the census reads. The rule the split states
// is that reflection is an INTERPRETER-time capability: available to a lens or a witness
// reading the live tree, never to a declaration the compiler must emit.
fn resolve_type_node(type_name: Symbol) -> Node {
  resolve_type_node(type_name: type_name)
}

fn coproduct_arm_keys(type_name: Symbol) -> List<Symbol> {
  coproduct_arm_key_list_from_node(node: resolve_type_node(type_name: type_name))
}

fn coproduct_nullary_inhabitants<T>(
  type_name: Symbol,
  discriminant_of: fn(T) -> Symbol
) -> Outcome<List<T>> {
  coproduct_nullary_inhabitants(
    type_name: type_name,
    discriminant_of: discriminant_of
  )
}
