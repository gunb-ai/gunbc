module v2.std.node_reflection

import std.decl_ref { DeclarationRef }
import v2.std.collection { List }
import v2.std.diagnostic {
  AmbiguousIntent,
  Diagnostic,
  Outcome,
  Unavailable,
  bind_outcome,
  invariant_port_locus,
  outcome_accepted,
  outcome_rejected
}
import v2.std.compilers.lexing { symbol_intern_lexeme, symbol_lexeme }
import v2.std.decl_index {
  DeclFact,
  decl_facts_at,
  logical_qualified_name_from_module,
  type_declarer_qualified_names
}
import v2.std.node { Node, Symbol }
import v2.std.node_query { coproduct_arm_key_list_from_node, node_is_coproduct }

// THE HOST TYPE-REFLECTION SURFACE, AND WHY IT IS ITS OWN MODULE.
//
// Both declarations below are host seams: their whole body is a self-call, answered by
// the v1 interpreter's live declaration index (roster arms v4_bridge.resolve_type_node
// and v4_bridge.coproduct_nullary_inhabitants). Nothing in the substrate can give them a
// body, because neither the resolved Node for a type NAME nor an inhabitant of an
// arbitrary T is derivable from anything the caller hands them -- the answer is a fact
// about the running compiler's own source index, not about the arguments.
//
// They used to sit in v2.std.node and v2.std.node_query, which the v2 compiler's import
// closure carries. Emission is decided at MODULE grain, so both were emitted into the
// compiler's own Rust crate as panic!("unrealized host seam ..."): a declaration with no
// behaviour on that target, standing in a shipped compiler because rustc accepts a
// diverging body. Neither was reachable from a compile once its one call-reachable
// consumer (target_model's UriScheme node decode) was repointed at a declared inhabitant
// roster, so the residue was module membership and nothing else.
//
// Segregating them here is what makes that provable rather than argued: this module is
// imported only by lenses and witnesses, so a compile-closure declaration that reaches
// reflection again drags THIS module into the closure and the seam reappears in the
// emitted crate -- loudly, at the same grep the census reads. The rule the split states
// is that reflection is an INTERPRETER-time capability: available to a lens or a witness
// reading the live tree, never to a declaration the compiler must emit.
fn resolve_type_node(type_name: Symbol) -> Node {
  resolve_type_node(type_name: type_name)
}

fn coproduct_arm_keys(type_name: Symbol) -> List<Symbol> {
  coproduct_arm_key_list_from_node(node: resolve_type_node(type_name: type_name))
}

fn coproduct_nullary_inhabitants<T>(
  type_name: Symbol,
  discriminant_of: fn(T) -> Symbol
) -> Outcome<List<T>> {
  coproduct_nullary_inhabitants(
    type_name: type_name,
    discriminant_of: discriminant_of
  )
}

// THE SCOPE-CARRYING ROUTE, AND WHY THE BARE ONE ABOVE CANNOT STAY THE ONLY ONE.
//
// `resolve_type_node` keys on a BARE spelling. Its host arm (v4_bridge.resolve_type_node,
// realized by v1.stage0.coproduct_reflection type_item_by_name) answers it by scanning the
// interpreter's loaded modules in order and returning the FIRST item whose authored name
// matches. When one spelling is declared as a closed coproduct in two modules, that scan
// returns whichever module the load order reached first -- a different arm set, with no
// diagnostic. It is DESIGN section 5 silent wrongness: not a refusal, a wrong answer that
// typechecks. The corpus inhabits the invalid state today, so this is a live class and not a
// hypothetical one; the discriminating pair enrolled against it is in
// `v2.test.manual.scoped_type_reflection_conformance`.
//
// The fix mints NO new identity and NO new host seam, which is the whole point (DESIGN
// section 3). The multiplicity that decides ambiguity is already a substrate fact:
// `v2.std.decl_index` decl_facts carries one row per declaration with its bare `name`, its
// `kind`, and its `qualified_name`. So the guard is derivable here, in `.dag`, from the index
// that `v2.std.decl_ref_resolution` already treats as the authority for exactly this question
// -- "how many declarations answer to this name" -- and whose five-arm refusal law this module
// deliberately does not restate.
//
// Consumers (DESIGN section 3c). Consumed by execution in this change: the conformance witness
// named above. Declared frontier, with its trigger stated: the floor's cross-claim memo and
// `coproduct_arm_keys`'s callers (`v2.lens.affected_set`, the generated coproduct witnesses)
// cut over to `coproduct_arm_keys_at` once a key shape is agreed with the floor-cost lane --
// that cutover is the trigger, and until it lands the bare pair above stays reachable and
// stays unguarded, which this annotation states rather than hides.
// WHY THIS IS A KEYED READ AND NOT A FOLD OVER decl_facts. The first version of this guard filtered
// the whole declaration corpus, which was correct and cost roughly 3.6s per call against 1ms for a
// keyed read, sharing at no grain -- four calls inside ONE claim frame cost four times one. That put
// the guard that makes reflection sound far above the floor's per-claim ceiling, and it was itself
// gunbc.recurring_failure_mode shared_precondition_re_derived_once_per_claim_frame in the very route
// meant to make the reflection memo key sound. v2.std.decl_index type_declarer_qualified_names is
// the keyed answer: the host filters the same memoized pool decl_facts_at reads and marshals no
// declaration nodes, and it returns EVERY candidate rather than choosing among them, so the
// multiplicity and the candidate identities are both decided here.
fn type_declarer_names(pool_roots: List<String>, type_name: Symbol) -> List<String> {
  type_declarer_qualified_names(
    pool_roots: pool_roots,
    bare_name: symbol_lexeme(sym: type_name)
  )
}

fn scoped_type_reflection_diagnostic(type_name: Symbol, invariant: Symbol) -> Diagnostic {
  Diagnostic {
    reason: invariant,
    at: invariant_port_locus(port: type_name, invariant: invariant),
    correction: Unavailable { reason: AmbiguousIntent }
  }
}

// THE ONLY PATH TO THE BARE HOST SEAM, SHARED BY BOTH ROUTES ON PURPOSE. review 65571 found that
// the shape check had been added to the spelling route and not to the citation route, so the
// citation route still reached the seam for a record and got an untyped host error -- the exact
// exit the sibling had just closed. Two copies of one acceptance law is the section 3 fork that
// produced that divergence, so there is now ONE copy and neither route may call the seam except
// through it.
//
// It establishes SHAPE after its caller has established uniqueness. decl_facts kind TypeItem does
// not separate a closed coproduct from a record -- this module's own UriScheme specimen depends on
// the v2.std.network RECORD counting as a candidate -- so uniqueness alone was never the contract
// the annotations claimed. No new authority: node_is_coproduct is v2.std.node_query's existing
// predicate, read from the node the keyed fact already carries.
fn accept_sole_declaration(
  pool_roots: List<String>,
  type_name: Symbol,
  sole_qualified_name: String
) -> Outcome<Node> {
  match list_head(xs: decl_facts_at(pool_roots: pool_roots, qualified_name: sole_qualified_name)) {
    HeadAbsent =>
      outcome_rejected(
        d: scoped_type_reflection_diagnostic(
          type_name: type_name,
          invariant: ^type_declaration_absent
        )
      )
    HeadFound { value: sole } =>
      if node_is_coproduct(node: sole.node) {
        outcome_accepted(value: sole.node)
      } else {
        outcome_rejected(
          d: scoped_type_reflection_diagnostic(
            type_name: type_name,
            invariant: ^type_spelling_is_not_a_closed_coproduct
          )
        )
      }
  }
}

// A bare spelling resolves ONLY where the index proves exactly one type declaration answers to
// it; zero and many each refuse, typed and located, rather than widening to a first match
// (DESIGN section 5 -- a failure arm refuses, never widens). The single-row arm is the only one
// that may reach the bare host seam, and it may do so precisely because uniqueness has been
// established BEFORE the call rather than assumed by it.
fn resolve_type_node_checked(pool_roots: List<String>, type_name: Symbol) -> Outcome<Node> {
  let candidates = type_declarer_names(pool_roots: pool_roots, type_name: type_name)
  let n = length(xs: candidates)
  if n == 0 {
    outcome_rejected(
      d: scoped_type_reflection_diagnostic(
        type_name: type_name,
        invariant: ^type_declaration_absent
      )
    )
  } else if n > 1 {
    outcome_rejected(
      d: scoped_type_reflection_diagnostic(
        type_name: type_name,
        invariant: ^type_spelling_ambiguous_across_modules
      )
    )
  } else {
    match list_head(xs: candidates) {
      HeadAbsent =>
        outcome_rejected(
          d: scoped_type_reflection_diagnostic(
            type_name: type_name,
            invariant: ^type_declaration_absent
          )
        )
      HeadFound { value: sole_qualified_name } =>
        accept_sole_declaration(
          pool_roots: pool_roots,
          type_name: type_name,
          sole_qualified_name: sole_qualified_name
        )
    }
  }
}

fn coproduct_arm_keys_checked(
  pool_roots: List<String>,
  type_name: Symbol
) -> Outcome<List<Symbol>> {
  bind_outcome(
    o: resolve_type_node_checked(pool_roots: pool_roots, type_name: type_name),
    f: fn(node) {
      outcome_accepted(value: coproduct_arm_key_list_from_node(node: node))
    }
  )
}

// THE ROUTE THAT MAKES A CALLER SAY WHICH MODULE IT MEANT. `resolve_type_node_checked` refuses an
// ambiguous spelling but cannot resolve one; a caller that legitimately means one of several
// same-spelled types names it by citation instead, reusing `std.decl_ref` DeclarationRef -- the
// corpus's existing carrier for "this declaration, in this module" -- so no second spelling of a
// scoped type identity is minted here. When PR #11264 lands its occurrence bindings, this is the
// declaration whose parameter becomes that binding: the citation is refined in place, not forked.
fn resolve_type_node_at(pool_roots: List<String>, ref: DeclarationRef) -> Outcome<Node> {
  let wanted = logical_qualified_name_from_module(
    module_name: ref.module_path as String,
    name: ref.decl_name as String
  )
  let type_name = symbol_intern_lexeme(lexeme: ref.decl_name as String)
  let candidates = type_declarer_names(pool_roots: pool_roots, type_name: type_name)
  let scoped = filter(xs: candidates, predicate: fn(qn) { qn == wanted })
  if length(xs: scoped) == 1 && length(xs: candidates) == 1 {
    accept_sole_declaration(
      pool_roots: pool_roots,
      type_name: type_name,
      sole_qualified_name: wanted
    )
  } else if length(xs: scoped) == 0 {
    outcome_rejected(
      d: scoped_type_reflection_diagnostic(
        type_name: type_name,
        invariant: ^cited_type_declaration_absent
      )
    )
  } else {
    outcome_rejected(
      d: scoped_type_reflection_diagnostic(
        type_name: type_name,
        invariant: ^cited_type_unreachable_through_bare_host_seam
      )
    )
  }
}
