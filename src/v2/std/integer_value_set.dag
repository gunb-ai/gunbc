module v2.std.integer_value_set


type IntegerValueSet
  = IntegerValueSetUnbounded
  | IntegerValueSetInterval { interval: v2.std.node.Node }

fn integer_value_set_atom(id: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn integer_unbounded_value_set_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^integer_value_set_field_kind },
        target: integer_value_set_atom(id: ^integer_value_set_kind_unbounded)
      }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn integer_interval_value_set_node(interval: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^integer_value_set_field_kind },
        target: integer_value_set_atom(id: ^integer_value_set_kind_interval)
      },
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^integer_value_set_field_interval },
        target: interval
      }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn integer_value_set_decode_diagnostic(reason: v2.std.node.Symbol, source_carrier: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: reason,
    at: v2.std.diagnostic.node_locus(node: source_carrier),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn integer_value_set_decode_rejected<T>(reason: v2.std.node.Symbol, source_carrier: v2.std.node.Node) -> v2.std.diagnostic.Outcome<T> {
  v2.std.diagnostic.Rejected {
    diagnostics: v2.std.diagnostic.diagnostics_singleton(
      d: integer_value_set_decode_diagnostic(reason: reason, source_carrier: source_carrier)
    )
  }
}

fn integer_value_set_decode_rejected_with_cause<T>(
  reason: v2.std.node.Symbol,
  source_carrier: v2.std.node.Node,
  cause: v2.std.diagnostic.NonEmptyDiagnostics
) -> v2.std.diagnostic.Outcome<T> {
  v2.std.diagnostic.Rejected {
    diagnostics: v2.std.diagnostic.non_empty_diagnostics_append(
      a: v2.std.diagnostic.diagnostics_singleton(
        d: integer_value_set_decode_diagnostic(reason: reason, source_carrier: source_carrier)
      ),
      b: cause
    )
  }
}

fn integer_value_set_from_node(value_set: v2.std.node.Node) -> v2.std.diagnostic.Outcome<IntegerValueSet> {
  if v2.std.node.well_formed(n: value_set) == false {
      integer_value_set_decode_rejected(
        reason: ^integer_value_set_carrier_not_well_formed,
        source_carrier: value_set
      )
  } else {
    match v2.std.node_query.find_named_child(root: value_set, name: ^integer_value_set_field_kind) {
      v2.std.diagnostic.Accepted { value: found_kind, diagnostics: kind_ds } =>
        if found_kind == integer_value_set_atom(id: ^integer_value_set_kind_unbounded) {
          if count(value_set.children) == 1 {
            match v2.std.node_query.find_named_child(root: value_set, name: ^integer_value_set_field_interval) {
              v2.std.diagnostic.Accepted { value: _, diagnostics: _ } =>
                integer_value_set_decode_rejected(
                  reason: ^integer_value_set_unbounded_carries_interval_field,
                  source_carrier: value_set
                )
              v2.std.diagnostic.Rejected { diagnostics: _ } =>
                v2.std.diagnostic.Accepted { value: IntegerValueSetUnbounded, diagnostics: kind_ds }
            }
          } else {
            integer_value_set_decode_rejected(
              reason: ^integer_value_set_unbounded_field_count_unexpected,
              source_carrier: value_set
            )
          }
        } else if found_kind == integer_value_set_atom(id: ^integer_value_set_kind_interval) {
          if count(value_set.children) == 2 {
            match v2.std.node_query.find_named_child(root: value_set, name: ^integer_value_set_field_interval) {
              v2.std.diagnostic.Accepted { value: interval, diagnostics: interval_ds } =>
                if v2.std.integer.integer_interval_spec_node_contains(container: interval, contained: interval) {
                  v2.std.diagnostic.Accepted {
                    value: IntegerValueSetInterval { interval: interval },
                    diagnostics: v2.std.diagnostic.diagnostics_merge(outer: kind_ds, inner: interval_ds)
                  }
                } else {
                  integer_value_set_decode_rejected(
                    reason: ^integer_value_set_interval_spec_malformed,
                    source_carrier: interval
                  )
                }
              v2.std.diagnostic.Rejected { diagnostics: interval_lookup_ds } =>
                integer_value_set_decode_rejected_with_cause(
                  reason: ^integer_value_set_interval_field_unresolved,
                  source_carrier: value_set,
                  cause: interval_lookup_ds
                )
            }
          } else {
            integer_value_set_decode_rejected(
              reason: ^integer_value_set_interval_field_count_unexpected,
              source_carrier: value_set
            )
          }
        } else {
          integer_value_set_decode_rejected(
            reason: ^integer_value_set_kind_unrecognized,
            source_carrier: found_kind
          )
        }
      v2.std.diagnostic.Rejected { diagnostics: kind_lookup_ds } =>
        integer_value_set_decode_rejected_with_cause(
          reason: ^integer_value_set_kind_field_unresolved,
          source_carrier: value_set,
          cause: kind_lookup_ds
        )
    }
  }
}

fn integer_value_set_contains_decoded(container: IntegerValueSet, contained: IntegerValueSet) -> Bool {
  match container {
    IntegerValueSetUnbounded =>
      true
    IntegerValueSetInterval { interval: container_interval } =>
      match contained {
        IntegerValueSetUnbounded => false
        IntegerValueSetInterval { interval: contained_interval } =>
          v2.std.integer.integer_interval_spec_node_contains(
            container: container_interval,
            contained: contained_interval
          )
      }
  }
}

fn integer_value_set_contains(container: v2.std.node.Node, contained: v2.std.node.Node) -> Bool {
  match integer_value_set_from_node(value_set: container) {
    v2.std.diagnostic.Accepted { value: decoded_container, diagnostics: _ } =>
      match integer_value_set_from_node(value_set: contained) {
        v2.std.diagnostic.Accepted { value: decoded_contained, diagnostics: _ } =>
          integer_value_set_contains_decoded(
            container: decoded_container,
            contained: decoded_contained
          )
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn integer_value_set_strictly_contains(container: v2.std.node.Node, contained: v2.std.node.Node) -> Bool {
  integer_value_set_contains(container: container, contained: contained)
    && !integer_value_set_contains(container: contained, contained: container)
}
