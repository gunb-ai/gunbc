module v2.std.integer_value_set

import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  NonEmptyDiagnostics,
  Rejected,
  diagnostics_merge,
  diagnostics_singleton,
  node_locus,
  non_empty_diagnostics_append,
  Unavailable
}
import v2.std.integer { integer_interval_spec_node_contains }
import v2.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode, well_formed, SyntheticOccurrence }
import v2.std.node_query { find_named_child }

type IntegerValueSet
  = IntegerValueSetUnbounded
  | IntegerValueSetInterval { interval: Node }

fn integer_value_set_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn integer_unbounded_value_set_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^integer_value_set_field_kind },
        target: integer_value_set_atom(id: ^integer_value_set_kind_unbounded)
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn integer_interval_value_set_node(interval: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^integer_value_set_field_kind },
        target: integer_value_set_atom(id: ^integer_value_set_kind_interval)
      },
      Edge {
        label: Named { name: ^integer_value_set_field_interval },
        target: interval
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn integer_value_set_decode_diagnostic(reason: Symbol, source_carrier: Node) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: source_carrier),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn integer_value_set_decode_rejected<T>(reason: Symbol, source_carrier: Node) -> Outcome<T> {
  Rejected {
    diagnostics: diagnostics_singleton(
      d: integer_value_set_decode_diagnostic(reason: reason, source_carrier: source_carrier)
    )
  }
}

fn integer_value_set_decode_rejected_with_cause<T>(
  reason: Symbol,
  source_carrier: Node,
  cause: NonEmptyDiagnostics
) -> Outcome<T> {
  Rejected {
    diagnostics: non_empty_diagnostics_append(
      a: diagnostics_singleton(
        d: integer_value_set_decode_diagnostic(reason: reason, source_carrier: source_carrier)
      ),
      b: cause
    )
  }
}

fn integer_value_set_from_node(value_set: Node) -> Outcome<IntegerValueSet> {
  if well_formed(n: value_set) == false {
      integer_value_set_decode_rejected(
        reason: ^integer_value_set_carrier_not_well_formed,
        source_carrier: value_set
      )
  } else {
    match find_named_child(root: value_set, name: ^integer_value_set_field_kind) {
      Accepted { value: found_kind, diagnostics: kind_ds } =>
        if found_kind == integer_value_set_atom(id: ^integer_value_set_kind_unbounded) {
          if count(value_set.children) == 1 {
            match find_named_child(root: value_set, name: ^integer_value_set_field_interval) {
              Accepted { value: _, diagnostics: _ } =>
                integer_value_set_decode_rejected(
                  reason: ^integer_value_set_unbounded_carries_interval_field,
                  source_carrier: value_set
                )
              Rejected { diagnostics: _ } =>
                Accepted { value: IntegerValueSetUnbounded, diagnostics: kind_ds }
            }
          } else {
            integer_value_set_decode_rejected(
              reason: ^integer_value_set_unbounded_field_count_unexpected,
              source_carrier: value_set
            )
          }
        } else if found_kind == integer_value_set_atom(id: ^integer_value_set_kind_interval) {
          if count(value_set.children) == 2 {
            match find_named_child(root: value_set, name: ^integer_value_set_field_interval) {
              Accepted { value: interval, diagnostics: interval_ds } =>
                if integer_interval_spec_node_contains(container: interval, contained: interval) {
                  Accepted {
                    value: IntegerValueSetInterval { interval: interval },
                    diagnostics: diagnostics_merge(outer: kind_ds, inner: interval_ds)
                  }
                } else {
                  integer_value_set_decode_rejected(
                    reason: ^integer_value_set_interval_spec_malformed,
                    source_carrier: interval
                  )
                }
              Rejected { diagnostics: interval_lookup_ds } =>
                integer_value_set_decode_rejected_with_cause(
                  reason: ^integer_value_set_interval_field_unresolved,
                  source_carrier: value_set,
                  cause: interval_lookup_ds
                )
            }
          } else {
            integer_value_set_decode_rejected(
              reason: ^integer_value_set_interval_field_count_unexpected,
              source_carrier: value_set
            )
          }
        } else {
          integer_value_set_decode_rejected(
            reason: ^integer_value_set_kind_unrecognized,
            source_carrier: found_kind
          )
        }
      Rejected { diagnostics: kind_lookup_ds } =>
        integer_value_set_decode_rejected_with_cause(
          reason: ^integer_value_set_kind_field_unresolved,
          source_carrier: value_set,
          cause: kind_lookup_ds
        )
    }
  }
}

fn integer_value_set_contains_decoded(container: IntegerValueSet, contained: IntegerValueSet) -> Bool {
  match container {
    IntegerValueSetUnbounded =>
      true
    IntegerValueSetInterval { interval: container_interval } =>
      match contained {
        IntegerValueSetUnbounded => false
        IntegerValueSetInterval { interval: contained_interval } =>
          integer_interval_spec_node_contains(
            container: container_interval,
            contained: contained_interval
          )
      }
  }
}

fn integer_value_set_contains(container: Node, contained: Node) -> Bool {
  match integer_value_set_from_node(value_set: container) {
    Accepted { value: decoded_container, diagnostics: _ } =>
      match integer_value_set_from_node(value_set: contained) {
        Accepted { value: decoded_contained, diagnostics: _ } =>
          integer_value_set_contains_decoded(
            container: decoded_container,
            contained: decoded_contained
          )
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn integer_value_set_strictly_contains(container: Node, contained: Node) -> Bool {
  integer_value_set_contains(container: container, contained: contained)
    && !integer_value_set_contains(container: contained, contained: container)
}
