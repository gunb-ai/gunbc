module v2.std.integer_value_set


type IntegerValueSet
  = IntegerValueSetUnbounded
  | IntegerValueSetInterval { interval: v2.std.node.Node }

fn integer_value_set_atom(id: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn integer_unbounded_value_set_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^integer_value_set_field_kind },
        target: integer_value_set_atom(id: ^integer_value_set_kind_unbounded)
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn integer_interval_value_set_node(interval: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^integer_value_set_field_kind },
        target: integer_value_set_atom(id: ^integer_value_set_kind_interval)
      },
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^integer_value_set_field_interval },
        target: interval
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn integer_value_set_decode_invalid_diagnostic(source_carrier: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^integer_value_set_decode_invalid,
    at: node_locus(node: source_carrier),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn integer_value_set_from_node(value_set: v2.std.node.Node) -> v2.std.diagnostic.Outcome<IntegerValueSet> {
  if well_formed(n: value_set) == false {
      v2.std.diagnostic.Rejected {
        diagnostics: diagnostics_singleton(
          d: integer_value_set_decode_invalid_diagnostic(source_carrier: value_set)
        )
      }
  } else {
    match find_named_child(root: value_set, name: ^integer_value_set_field_kind) {
      Accepted { value: found_kind, diagnostics: None } =>
        if found_kind == integer_value_set_atom(id: ^integer_value_set_kind_unbounded) {
          if count(value_set.children) == 1 {
            match find_named_child(root: value_set, name: ^integer_value_set_field_interval) {
              Accepted { value: _, diagnostics: None } =>
                v2.std.diagnostic.Rejected {
                  diagnostics: diagnostics_singleton(
                    d: integer_value_set_decode_invalid_diagnostic(source_carrier: value_set)
                  )
                }
              v2.std.diagnostic.Rejected { diagnostics: _ } =>
                v2.std.diagnostic.Accepted { value: IntegerValueSetUnbounded, diagnostics: v2.std.diagnostic.None }
            }
          } else {
            v2.std.diagnostic.Rejected {
              diagnostics: diagnostics_singleton(
                d: integer_value_set_decode_invalid_diagnostic(source_carrier: value_set)
              )
            }
          }
        } else if found_kind == integer_value_set_atom(id: ^integer_value_set_kind_interval) {
          if count(value_set.children) == 2 {
            match find_named_child(root: value_set, name: ^integer_value_set_field_interval) {
              Accepted { value: interval, diagnostics: None } =>
                if v2.std.integer.integer_interval_spec_node_contains(container: interval, contained: interval) {
                  v2.std.diagnostic.Accepted { value: IntegerValueSetInterval { interval: interval }, diagnostics: v2.std.diagnostic.None }
                } else {
                  v2.std.diagnostic.Rejected {
                    diagnostics: diagnostics_singleton(
                      d: integer_value_set_decode_invalid_diagnostic(source_carrier: value_set)
                    )
                  }
                }
              v2.std.diagnostic.Rejected { diagnostics: _ } =>
                v2.std.diagnostic.Rejected {
                  diagnostics: diagnostics_singleton(
                    d: integer_value_set_decode_invalid_diagnostic(source_carrier: value_set)
                  )
                }
            }
          } else {
            v2.std.diagnostic.Rejected {
              diagnostics: diagnostics_singleton(
                d: integer_value_set_decode_invalid_diagnostic(source_carrier: value_set)
              )
            }
          }
        } else {
          v2.std.diagnostic.Rejected {
            diagnostics: diagnostics_singleton(
              d: integer_value_set_decode_invalid_diagnostic(source_carrier: value_set)
            )
          }
        }
      v2.std.diagnostic.Rejected { diagnostics: _ } =>
        v2.std.diagnostic.Rejected {
          diagnostics: diagnostics_singleton(
            d: integer_value_set_decode_invalid_diagnostic(source_carrier: value_set)
          )
        }
    }
  }
}

fn integer_value_set_contains_decoded(container: IntegerValueSet, contained: IntegerValueSet) -> Bool {
  match container {
    IntegerValueSetUnbounded =>
      true
    IntegerValueSetInterval { interval: container_interval } =>
      match contained {
        IntegerValueSetUnbounded => false
        IntegerValueSetInterval { interval: contained_interval } =>
          v2.std.integer.integer_interval_spec_node_contains(
            container: container_interval,
            contained: contained_interval
          )
      }
  }
}

fn integer_value_set_contains(container: v2.std.node.Node, contained: v2.std.node.Node) -> Bool {
  match integer_value_set_from_node(value_set: container) {
    Accepted { value: decoded_container, diagnostics: None } =>
      match integer_value_set_from_node(value_set: contained) {
        Accepted { value: decoded_contained, diagnostics: None } =>
          integer_value_set_contains_decoded(
            container: decoded_container,
            contained: decoded_contained
          )
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn integer_value_set_strictly_contains(container: v2.std.node.Node, contained: v2.std.node.Node) -> Bool {
  integer_value_set_contains(container: container, contained: contained)
    && !integer_value_set_contains(container: contained, contained: container)
}
