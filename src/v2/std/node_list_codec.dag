module v2.std.node_list_codec

import std.algebra { Cons, Empty }
import v2.std.collection { List }
import v2.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Unavailable,
  bind_outcome,
  node_locus,
  outcome_accepted,
  outcome_rejected
}
import v2.std.node { Conj, Node, TypeNode, node_subtree_count }
import v2.std.node_query { find_named_child }

fn node_list_shape_malformed_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: ^node_list_shape_malformed,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn node_list_from_node_bounded<T>(
  remaining: Int,
  node: Node,
  decode_item: fn(Node) -> Outcome<T>
) -> Outcome<List<T>> {
  if remaining <= 0 {
    outcome_rejected(node_list_shape_malformed_diagnostic(node: node))
  } else {
    match node.kind {
      TypeNode { connective: Conj } =>
        if count(node.children) == 0 {
          outcome_accepted(Empty)
        } else if count(node.children) == 2 {
          bind_outcome(
            o: find_named_child(root: node, name: ^fold_list_node_head),
            f: fn(head_node) {
              bind_outcome(
                o: decode_item(head_node),
                f: fn(head_item) {
                  bind_outcome(
                    o: find_named_child(root: node, name: ^fold_list_node_tail),
                    f: fn(tail_node) {
                      bind_outcome(
                        o: node_list_from_node_bounded(
                          remaining: remaining - 1,
                          node: tail_node,
                          decode_item: decode_item
                        ),
                        f: fn(tail_items) {
                          outcome_accepted(Cons { head: head_item, tail: tail_items })
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        } else {
          outcome_rejected(node_list_shape_malformed_diagnostic(node: node))
        }
      _ => outcome_rejected(node_list_shape_malformed_diagnostic(node: node))
    }
  }
}

fn node_list_from_node<T>(
  node: Node,
  decode_item: fn(Node) -> Outcome<T>
) -> Outcome<List<T>> {
  node_list_from_node_bounded(
    remaining: node_subtree_count(n: node),
    node: node,
    decode_item: decode_item
  )
}
