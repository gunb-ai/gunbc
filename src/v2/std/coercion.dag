module v2.std.coercion

import v2.std.algebra { Empty, list_append, list_snoc_item }
import v2.std.collection { List }
import v2.std.constraints { CanonicalGrounding, CanonicalGroundingWitness }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  NonEmptyDiagnostics,
  diagnostics_singleton,
  non_empty_diagnostics_append,
  node_locus,
  Outcome,
  Rejected,
  Unavailable,
  outcome_rejected
}
import v2.std.find_witness {
  CandidateSet,
  FindWitnessResult,
  PreservationPredicate,
  TargetDeclaredPriority,
  TargetSelection,
  TargetSelectionPolicy,
  find_witness,
}
import v2.std.node { Conj, Edge, Named, Node, Symbol, TypeNode, well_formed, SyntheticOccurrence }
import v2.std.refinement_widening_predicate { refinement_widening_is_strict_coarsening }
import v2.std.witness { HomomorphismWitness, StructuralPropertyWitness }

type FindWitnessRejectionKind
  = FindWitnessNoCandidate
  | FindWitnessAmbiguousCandidate
  | FindWitnessNotRealized
  | FindWitnessInvalidWitness

type CoercionQuality
  = Identity
  | Exact
  | Widened

type CoercionMismatchKind
  = NoTargetCandidate
  | AmbiguousTargetCandidate
  | StructuralMismatch
  | WouldLoseInformation
type CoercionCandidateSet {
  set: CandidateSet
}
type CoercionResult {
  target: Node
  quality: CoercionQuality
  witness: CoercionWitness
}
type CoercionWitness {
  homomorphism: HomomorphismWitness
}
fn coercion_not_realized_diagnostic(
  source: CanonicalGrounding,
  kind: CoercionMismatchKind,
) -> Diagnostic {
  Diagnostic {
    reason: discriminant(v: kind),
    at: node_locus(node: source.node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn declared_candidates_for_algebra(
  target_model: Node,
  algebra_instance: Node,
) -> Outcome<CoercionCandidateSet> {
  outcome_rejected(
    coercion_not_realized_diagnostic(
      source: CanonicalGrounding {
        node: algebra_instance,
        witness: CanonicalGroundingWitness {
          structural: StructuralPropertyWitness {
            property: ^coercion_property_closed_candidate_set,
            evidence: target_model
          },

          closedness: StructuralPropertyWitness {
            property: ^coercion_property_candidate_set_closedness,
            evidence: target_model
          }
        }
      },
      kind: NoTargetCandidate
    )
  )
}
fn declared_inhabitant_candidates(inhabitants_root: Node) -> List<Node> {
  map(inhabitants_root.children, fn(e) { e.target })
}
fn coercion_candidate_set_not_closed_diagnostic(inhabitants_root: Node) -> Diagnostic {
  Diagnostic {
    reason: ^coercion_mismatch_candidate_set_not_closed,
    at: node_locus(node: inhabitants_root),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn coercion_candidate_set_from_declared_inhabitants(
  inhabitants_root: Node,
  closedness_property: Symbol,
) -> Outcome<CoercionCandidateSet> {
  if well_formed(n: inhabitants_root) {
    Accepted {
      value: CoercionCandidateSet {
        set: CandidateSet {
          candidates: declared_inhabitant_candidates(inhabitants_root: inhabitants_root),
          closedness: StructuralPropertyWitness {
            property: closedness_property,
            evidence: inhabitants_root
          }
        }
      },
      diagnostics: None
    }
  } else {
    outcome_rejected(
      coercion_candidate_set_not_closed_diagnostic(inhabitants_root: inhabitants_root)
    )
  }
}
fn coercion_quality_for_witness(
  source: CanonicalGrounding,
  fw: FindWitnessResult,
) -> CoercionQuality {
  if fw.candidate == source.node {
    Identity
  } else {
    Exact
  }
}
fn coercion_find_witness_reason_unmapped_diagnostic(
  source: CanonicalGrounding,
) -> Diagnostic {
  Diagnostic {
    reason: ^coercion_find_witness_reason_unmapped,
    at: node_locus(node: source.node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn find_witness_rejection_kind_from_reason(
  source: CanonicalGrounding,
  reason: Symbol
) -> Outcome<FindWitnessRejectionKind> {
  if reason == ^find_witness_reason_no_candidate {
    Accepted { value: FindWitnessNoCandidate, diagnostics: None }
  } else if reason == ^find_witness_reason_ambiguous_candidate {
    Accepted { value: FindWitnessAmbiguousCandidate, diagnostics: None }
  } else if reason == ^find_witness_reason_not_realized {
    Accepted { value: FindWitnessNotRealized, diagnostics: None }
  } else if reason == ^find_witness_reason_invalid_witness {
    Accepted { value: FindWitnessInvalidWitness, diagnostics: None }
  } else {
    outcome_rejected(
      coercion_find_witness_reason_unmapped_diagnostic(source: source)
    )
  }
}
fn coercion_mismatch_kind_for_find_witness_rejection_kind(
  kind: FindWitnessRejectionKind,
) -> CoercionMismatchKind {
  match kind {
    FindWitnessNoCandidate => NoTargetCandidate
    FindWitnessAmbiguousCandidate => AmbiguousTargetCandidate
    FindWitnessNotRealized => StructuralMismatch
    FindWitnessInvalidWitness => StructuralMismatch
  }
}
fn coercion_wrap_find_witness_rejection(
  source: CanonicalGrounding,
  upstream: NonEmptyDiagnostics,
) -> Outcome<NonEmptyDiagnostics> {
  match find_witness_rejection_kind_from_reason(
    source: source,
    reason: upstream.head.reason
  ) {
    Accepted { value: fw_kind, diagnostics: _ } =>
      Accepted {
        value: NonEmptyDiagnostics {
          head: coercion_not_realized_diagnostic(
            source: source,
            kind: coercion_mismatch_kind_for_find_witness_rejection_kind(kind: fw_kind)
          ),
          tail: list_append(
            left: list_snoc_item(xs: Empty, item: upstream.head),
            right: upstream.tail
          )
        },
        diagnostics: None
      }
    Rejected { diagnostics: coerce_r } =>
      Rejected {
        diagnostics: non_empty_diagnostics_append(a: upstream, b: coerce_r)
      }
  }
}
fn coercion_wrap_find_witness_rejection_with_refinement_algebra(
  source: CanonicalGrounding,
  upstream: NonEmptyDiagnostics,
  refinement_algebra: Node,
) -> Outcome<NonEmptyDiagnostics> {
  if refinement_widening_is_strict_coarsening(algebra: refinement_algebra) {
    Accepted {
      value: NonEmptyDiagnostics {
        head: coercion_not_realized_diagnostic(source: source, kind: WouldLoseInformation),
        tail: list_append(
          left: list_snoc_item(xs: Empty, item: upstream.head),
          right: upstream.tail
        )
      },
      diagnostics: None
    }
  } else {
    coercion_wrap_find_witness_rejection(source: source, upstream: upstream)
  }
}
fn coercion_homomorphism_evidence(
  source: CanonicalGrounding,
  fw: FindWitnessResult,
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: ^coercion_homomorphism_evidence_source }, target: source.node },
      Edge { label: Named { name: ^coercion_homomorphism_evidence_candidate }, target: fw.candidate },
      Edge { label: Named { name: ^coercion_homomorphism_evidence_find_witness }, target: fw.witness.evidence }
    ],
    occurrence_id: SyntheticOccurrence
}
}
fn coercion_fold_exact_structural(
  source: CanonicalGrounding,
  candidates: CoercionCandidateSet,
  policy: TargetSelectionPolicy,
) -> Outcome<CoercionResult> {
  match find_witness(
    source_facts: source.node,
    candidates: candidates.set,
    predicate: PreservationPredicate {
      algebra: source.node,
      preservation_rule: ^preservation_rule_exact_structural_equality_zip_fold
    },
    multiplicity_policy: TargetSelection { policy: policy }
  ) {
    Accepted { value: fw, diagnostics: fw_d } =>
      Accepted {
        value: CoercionResult {
          target: fw.candidate,
          quality: coercion_quality_for_witness(source: source, fw: fw),
          witness: CoercionWitness {
            homomorphism: HomomorphismWitness {
              rule: ^homomorphism_rule_exact_structural_equality,
              evidence: coercion_homomorphism_evidence(source: source, fw: fw)
            }
          }
        },
        diagnostics: fw_d
      }
    Rejected { diagnostics: r } =>
      match coercion_wrap_find_witness_rejection(source: source, upstream: r) {
        Accepted { value: wrapped, diagnostics: _ } =>
          Rejected { diagnostics: wrapped }
        Rejected { diagnostics: wrap_r } => Rejected { diagnostics: wrap_r }
      }
  }
}
fn coercion_fold(
  source: CanonicalGrounding,
  candidates: CoercionCandidateSet,
  policy: TargetSelectionPolicy,
) -> Outcome<CoercionResult> {
  coercion_fold_exact_structural(
    source: source,
    candidates: candidates,
    policy: policy
  )
}
fn coercion_fold_refinement_widening(
  source: CanonicalGrounding,
  candidates: CoercionCandidateSet,
  policy: TargetSelectionPolicy,
  predicate: PreservationPredicate,
) -> Outcome<CoercionResult> {
  match find_witness(
    source_facts: source.node,
    candidates: candidates.set,
    predicate: predicate,
    multiplicity_policy: TargetSelection { policy: policy }
  ) {
    Accepted { value: fw, diagnostics: fw_d } =>
      Accepted {
        value: CoercionResult {
          target: fw.candidate,
          quality: Widened,
          witness: CoercionWitness {
            homomorphism: HomomorphismWitness {
              rule: ^homomorphism_rule_refinement_widening,
              evidence: coercion_homomorphism_evidence(source: source, fw: fw)
            }
          }
        },
        diagnostics: fw_d
      }
    Rejected { diagnostics: r } =>
      match coercion_wrap_find_witness_rejection_with_refinement_algebra(
        source: source,
        upstream: r,
        refinement_algebra: predicate.algebra
      ) {
        Accepted { value: wrapped, diagnostics: _ } =>
          Rejected { diagnostics: wrapped }
        Rejected { diagnostics: wrap_r } => Rejected { diagnostics: wrap_r }
      }
  }
}
fn coercion_fold_with_declared_priority(
  source: CanonicalGrounding,
  candidates: CoercionCandidateSet,
  priority: Node,
) -> Outcome<CoercionResult> {
  coercion_fold(
    source: source,
    candidates: candidates,
    policy: TargetDeclaredPriority { priority: priority }
  )
}
fn coercion_fold_refinement_widening_with_declared_priority(
  source: CanonicalGrounding,
  candidates: CoercionCandidateSet,
  priority: Node,
  predicate: PreservationPredicate,
) -> Outcome<CoercionResult> {
  coercion_fold_refinement_widening(
    source: source,
    candidates: candidates,
    policy: TargetDeclaredPriority { priority: priority },
    predicate: predicate
  )
}
