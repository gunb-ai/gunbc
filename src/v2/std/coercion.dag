module v2.std.coercion


type FindWitnessRejectionKind
  = FindWitnessNoCandidate
  | FindWitnessAmbiguousCandidate
  | FindWitnessNotRealized
  | FindWitnessInvalidWitness

type CoercionQuality
  = Identity
  | Exact
  | Widened

type CoercionMismatchKind
  = NoTargetCandidate
  | AmbiguousTargetCandidate
  | StructuralMismatch
  | WouldLoseInformation
type CoercionCandidateSet {
  set: v2.std.find_witness.CandidateSet
}
type CoercionResult {
  target: v2.std.node.Node
  quality: CoercionQuality
  witness: CoercionWitness
}
type CoercionWitness {
  homomorphism: v2.std.witness.HomomorphismWitness
}
fn coercion_not_realized_diagnostic(
  source: v2.std.constraints.CanonicalGrounding,
  kind: CoercionMismatchKind,
) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: discriminant(v: kind),
    at: node_locus(node: source.node),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}
fn declared_candidates_for_algebra(
  target_model: v2.std.node.Node,
  algebra_instance: v2.std.node.Node,
) -> v2.std.diagnostic.Outcome<CoercionCandidateSet> {
  outcome_rejected(
    coercion_not_realized_diagnostic(
      source: v2.std.constraints.CanonicalGrounding {
        node: algebra_instance,
        witness: v2.std.constraints.CanonicalGroundingWitness {
          structural: v2.std.witness.StructuralPropertyWitness {
            property: ^coercion_property_closed_candidate_set,
            evidence: target_model
          },

          closedness: v2.std.witness.StructuralPropertyWitness {
            property: ^coercion_property_candidate_set_closedness,
            evidence: target_model
          }
        }
      },
      kind: NoTargetCandidate
    )
  )
}
fn declared_inhabitant_candidates(inhabitants_root: v2.std.node.Node) -> List<v2.std.node.Node> {
  map(inhabitants_root.children, fn(e) { e.target })
}
fn coercion_candidate_set_not_closed_diagnostic(inhabitants_root: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^coercion_mismatch_candidate_set_not_closed,
    at: node_locus(node: inhabitants_root),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}
fn coercion_candidate_set_from_declared_inhabitants(
  inhabitants_root: v2.std.node.Node,
  closedness_property: v2.std.node.Symbol,
) -> v2.std.diagnostic.Outcome<CoercionCandidateSet> {
  if well_formed(n: inhabitants_root) {
    v2.std.diagnostic.Accepted {
      value: CoercionCandidateSet {
        set: v2.std.find_witness.CandidateSet {
          candidates: declared_inhabitant_candidates(inhabitants_root: inhabitants_root),
          closedness: v2.std.witness.StructuralPropertyWitness {
            property: closedness_property,
            evidence: inhabitants_root
          }
        }
      },
      diagnostics: v2.std.diagnostic.None
    }
  } else {
    outcome_rejected(
      coercion_candidate_set_not_closed_diagnostic(inhabitants_root: inhabitants_root)
    )
  }
}
data identity_coercion_grounding_ruling: String = "Identity admission and semantic coercion are distinct judgments. coercion_identity_from_target_model accepts the TargetModel itself — never a caller-supplied CoercionCandidateSet — and reads its unique target_model_edge_declared_inhabitants and target_model_edge_selection_policy children inside this authority. Exact selection from that authored roster grounds CoercionQuality.Identity without claiming a resolved type for source. A candidate roster derived from source cannot enter this API; generic candidate sets remain available only to the semantic coercion path whose source is a compiler-derived CanonicalGrounding. This is the API-level wall between target-model membership and self-certification."

fn coercion_homomorphism_evidence_for_node(
  source: v2.std.node.Node,
  fw: v2.std.find_witness.FindWitnessResult,
) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      v2.std.node.Edge { label: Named { name: ^coercion_homomorphism_evidence_source }, target: source },
      v2.std.node.Edge { label: Named { name: ^coercion_homomorphism_evidence_candidate }, target: fw.candidate },
      v2.std.node.Edge {
        label: Named { name: ^coercion_homomorphism_evidence_find_witness },
        target: fw.witness.evidence
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn coercion_identity_from_target_model(
  source: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel,
) -> v2.std.diagnostic.Outcome<CoercionResult> {
  bind_outcome(
    o: target_model_declared_inhabitants(target: target),
    f: fn(inhabitants_root) {
      bind_outcome(
        o: target_model_selection_priority(target: target),
        f: fn(priority) {
          bind_outcome(
            o: coercion_candidate_set_from_declared_inhabitants(
              inhabitants_root: inhabitants_root,
              closedness_property: ^target_model_edge_declared_inhabitants
            ),
            f: fn(candidates) {
              match find_witness(
                source_facts: source,
                candidates: candidates.set,
                predicate: v2.std.find_witness.PreservationPredicate {
                  algebra: source,
                  preservation_rule: ^preservation_rule_exact_structural_equality_zip_fold
                },
                multiplicity_policy: v2.std.find_witness.TargetSelection {
                  policy: v2.std.find_witness.TargetDeclaredPriority { priority: priority }
                }
              ) {
                Accepted { value: fw, diagnostics: fw_d } =>
                  v2.std.diagnostic.Accepted {
                    value: CoercionResult {
                      target: fw.candidate,
                      quality: Identity,
                      witness: CoercionWitness {
                        homomorphism: v2.std.witness.HomomorphismWitness {
                          rule: ^homomorphism_rule_exact_structural_equality,
                          evidence: coercion_homomorphism_evidence_for_node(
                            source: source,
                            fw: fw
                          )
                        }
                      }
                    },
                    diagnostics: fw_d
                  }
                Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
              }
            }
          )
        }
      )
    }
  )
}
fn coercion_quality_for_witness(
  source: v2.std.constraints.CanonicalGrounding,
  fw: v2.std.find_witness.FindWitnessResult,
) -> CoercionQuality {
  if fw.candidate == source.node {
    Identity
  } else {
    Exact
  }
}
fn coercion_find_witness_reason_unmapped_diagnostic(
  source: v2.std.constraints.CanonicalGrounding,
) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^coercion_find_witness_reason_unmapped,
    at: node_locus(node: source.node),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}
fn find_witness_rejection_kind_from_reason(
  source: v2.std.constraints.CanonicalGrounding,
  reason: v2.std.node.Symbol
) -> v2.std.diagnostic.Outcome<FindWitnessRejectionKind> {
  if reason == ^find_witness_reason_no_candidate {
    v2.std.diagnostic.Accepted { value: FindWitnessNoCandidate, diagnostics: v2.std.diagnostic.None }
  } else if reason == ^find_witness_reason_ambiguous_candidate {
    v2.std.diagnostic.Accepted { value: FindWitnessAmbiguousCandidate, diagnostics: v2.std.diagnostic.None }
  } else if reason == ^find_witness_reason_not_realized {
    v2.std.diagnostic.Accepted { value: FindWitnessNotRealized, diagnostics: v2.std.diagnostic.None }
  } else if reason == ^find_witness_reason_invalid_witness {
    v2.std.diagnostic.Accepted { value: FindWitnessInvalidWitness, diagnostics: v2.std.diagnostic.None }
  } else {
    outcome_rejected(
      coercion_find_witness_reason_unmapped_diagnostic(source: source)
    )
  }
}
fn coercion_mismatch_kind_for_find_witness_rejection_kind(
  kind: FindWitnessRejectionKind,
) -> CoercionMismatchKind {
  match kind {
    FindWitnessNoCandidate => NoTargetCandidate
    FindWitnessAmbiguousCandidate => AmbiguousTargetCandidate
    FindWitnessNotRealized => StructuralMismatch
    FindWitnessInvalidWitness => StructuralMismatch
  }
}
fn coercion_wrap_find_witness_rejection(
  source: v2.std.constraints.CanonicalGrounding,
  upstream: v2.std.diagnostic.NonEmptyDiagnostics,
) -> v2.std.diagnostic.Outcome<v2.std.diagnostic.NonEmptyDiagnostics> {
  match find_witness_rejection_kind_from_reason(
    source: source,
    reason: upstream.head.reason
  ) {
    Accepted { value: fw_kind, diagnostics: _ } =>
      v2.std.diagnostic.Accepted {
        value: v2.std.diagnostic.NonEmptyDiagnostics {
          head: coercion_not_realized_diagnostic(
            source: source,
            kind: coercion_mismatch_kind_for_find_witness_rejection_kind(kind: fw_kind)
          ),
          tail: list_append(
            left: list_snoc_item(xs: std.algebra.Empty, item: upstream.head),
            right: upstream.tail
          )
        },
        diagnostics: v2.std.diagnostic.None
      }
    Rejected { diagnostics: coerce_r } =>
      v2.std.diagnostic.Rejected {
        diagnostics: non_empty_diagnostics_append(a: upstream, b: coerce_r)
      }
  }
}
fn coercion_wrap_find_witness_rejection_with_refinement_algebra(
  source: v2.std.constraints.CanonicalGrounding,
  upstream: v2.std.diagnostic.NonEmptyDiagnostics,
  refinement_algebra: v2.std.node.Node,
) -> v2.std.diagnostic.Outcome<v2.std.diagnostic.NonEmptyDiagnostics> {
  if v2.std.refinement_widening_predicate.refinement_widening_is_strict_coarsening(algebra: refinement_algebra) {
    v2.std.diagnostic.Accepted {
      value: v2.std.diagnostic.NonEmptyDiagnostics {
        head: coercion_not_realized_diagnostic(source: source, kind: WouldLoseInformation),
        tail: list_append(
          left: list_snoc_item(xs: std.algebra.Empty, item: upstream.head),
          right: upstream.tail
        )
      },
      diagnostics: v2.std.diagnostic.None
    }
  } else {
    coercion_wrap_find_witness_rejection(source: source, upstream: upstream)
  }
}
fn coercion_homomorphism_evidence(
  source: v2.std.constraints.CanonicalGrounding,
  fw: v2.std.find_witness.FindWitnessResult,
) -> v2.std.node.Node {
  coercion_homomorphism_evidence_for_node(source: source.node, fw: fw)
}
fn coercion_fold_exact_structural(
  source: v2.std.constraints.CanonicalGrounding,
  candidates: CoercionCandidateSet,
  policy: v2.std.find_witness.TargetSelectionPolicy,
) -> v2.std.diagnostic.Outcome<CoercionResult> {
  match find_witness(
    source_facts: source.node,
    candidates: candidates.set,
    predicate: v2.std.find_witness.PreservationPredicate {
      algebra: source.node,
      preservation_rule: ^preservation_rule_exact_structural_equality_zip_fold
    },
    multiplicity_policy: v2.std.find_witness.TargetSelection { policy: policy }
  ) {
    Accepted { value: fw, diagnostics: fw_d } =>
      v2.std.diagnostic.Accepted {
        value: CoercionResult {
          target: fw.candidate,
          quality: coercion_quality_for_witness(source: source, fw: fw),
          witness: CoercionWitness {
            homomorphism: v2.std.witness.HomomorphismWitness {
              rule: ^homomorphism_rule_exact_structural_equality,
              evidence: coercion_homomorphism_evidence(source: source, fw: fw)
            }
          }
        },
        diagnostics: fw_d
      }
    Rejected { diagnostics: r } =>
      match coercion_wrap_find_witness_rejection(source: source, upstream: r) {
        Accepted { value: wrapped, diagnostics: _ } =>
          v2.std.diagnostic.Rejected { diagnostics: wrapped }
        Rejected { diagnostics: wrap_r } => v2.std.diagnostic.Rejected { diagnostics: wrap_r }
      }
  }
}
fn coercion_fold(
  source: v2.std.constraints.CanonicalGrounding,
  candidates: CoercionCandidateSet,
  policy: v2.std.find_witness.TargetSelectionPolicy,
) -> v2.std.diagnostic.Outcome<CoercionResult> {
  coercion_fold_exact_structural(
    source: source,
    candidates: candidates,
    policy: policy
  )
}
fn coercion_fold_refinement_widening(
  source: v2.std.constraints.CanonicalGrounding,
  candidates: CoercionCandidateSet,
  policy: v2.std.find_witness.TargetSelectionPolicy,
  predicate: v2.std.find_witness.PreservationPredicate,
) -> v2.std.diagnostic.Outcome<CoercionResult> {
  match find_witness(
    source_facts: source.node,
    candidates: candidates.set,
    predicate: predicate,
    multiplicity_policy: v2.std.find_witness.TargetSelection { policy: policy }
  ) {
    Accepted { value: fw, diagnostics: fw_d } =>
      v2.std.diagnostic.Accepted {
        value: CoercionResult {
          target: fw.candidate,
          quality: Widened,
          witness: CoercionWitness {
            homomorphism: v2.std.witness.HomomorphismWitness {
              rule: ^homomorphism_rule_refinement_widening,
              evidence: coercion_homomorphism_evidence(source: source, fw: fw)
            }
          }
        },
        diagnostics: fw_d
      }
    Rejected { diagnostics: r } =>
      match coercion_wrap_find_witness_rejection_with_refinement_algebra(
        source: source,
        upstream: r,
        refinement_algebra: predicate.algebra
      ) {
        Accepted { value: wrapped, diagnostics: _ } =>
          v2.std.diagnostic.Rejected { diagnostics: wrapped }
        Rejected { diagnostics: wrap_r } => v2.std.diagnostic.Rejected { diagnostics: wrap_r }
      }
  }
}
fn coercion_fold_with_declared_priority(
  source: v2.std.constraints.CanonicalGrounding,
  candidates: CoercionCandidateSet,
  priority: v2.std.node.Node,
) -> v2.std.diagnostic.Outcome<CoercionResult> {
  coercion_fold(
    source: source,
    candidates: candidates,
    policy: v2.std.find_witness.TargetDeclaredPriority { priority: priority }
  )
}
fn coercion_fold_refinement_widening_with_declared_priority(
  source: v2.std.constraints.CanonicalGrounding,
  candidates: CoercionCandidateSet,
  priority: v2.std.node.Node,
  predicate: v2.std.find_witness.PreservationPredicate,
) -> v2.std.diagnostic.Outcome<CoercionResult> {
  coercion_fold_refinement_widening(
    source: source,
    candidates: candidates,
    policy: v2.std.find_witness.TargetDeclaredPriority { priority: priority },
    predicate: predicate
  )
}
