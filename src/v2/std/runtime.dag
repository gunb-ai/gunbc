module v2.std.runtime


type RuntimeIdentity {
  identity: v2.std.node.Symbol
}

type RuntimeFieldValue {
  field: v2.std.node.Symbol
  value: v2.std.runtime.RuntimeValue
}

type EnvironmentBindingKey {
  identity: v2.std.node.Symbol
}

fn environment_binding_key_for_symbol(sym: v2.std.node.Symbol) -> v2.std.runtime.EnvironmentBindingKey {
  EnvironmentBindingKey {
    identity: sym
  }
}

type EvaluationEnvironment {
  bindings: std.types.Map<v2.std.runtime.EnvironmentBindingKey, v2.std.runtime.RuntimeValue>
}

type RuntimePrimitiveValue {
  primitive_type: v2.std.node.Node
  bytes: std.types.List<std.bit.Byte>
}

type RuntimeAggregateValue {
  aggregate_type: v2.std.node.Node
  fields: std.types.List<v2.std.runtime.RuntimeFieldValue>
}

type RuntimeReferenceValue {
  reference_type: v2.std.node.Node
  identity: v2.std.runtime.RuntimeIdentity
  referent_type: v2.std.node.Node
}

type RuntimeClosureValue {
  arrow_type: v2.std.node.Node
  arrow: v2.std.node.Node
  environment: v2.std.runtime.EvaluationEnvironment
}

type RuntimeUnitValue {
  unit_type: v2.std.node.Node
}

type RuntimeValue
  = RuntimePrimitive { value: v2.std.runtime.RuntimePrimitiveValue }
  | RuntimeAggregate { value: v2.std.runtime.RuntimeAggregateValue }
  | RuntimeReference { value: v2.std.runtime.RuntimeReferenceValue }
  | RuntimeClosure { value: v2.std.runtime.RuntimeClosureValue }
  | RuntimeUnit { value: v2.std.runtime.RuntimeUnitValue }

type RuntimeOutcome
  = Panic { panic_classification: v2.std.node.Symbol }
  | Wrap
  | CheckedReturn { wrapped_value: v2.std.node.Node }
  | ExceptionRaise { exception_node: v2.std.node.Node }

type RuntimeValueNodeProjection
  = RuntimeValueNodeProjected { node: v2.std.node.Node }
  | RuntimeValueNodeUnrepresentable

type IdentityEvidence
  = ReferenceIdentical
  | StructurallyCompared { equal: Bool }

fn identity_evidence_equal(evidence: v2.std.runtime.IdentityEvidence) -> Bool {
  match evidence {
    ReferenceIdentical => true
    StructurallyCompared { equal: std.patterns.eq } => std.patterns.eq
  }
}

fn runtime_value_resolved_type(value: v2.std.runtime.RuntimeValue) -> v2.std.node.Node {
  match value {
    RuntimePrimitive { value: gunbc.plans.md_helpers.p } => p.primitive_type
    RuntimeAggregate { value: a } => a.aggregate_type
    RuntimeReference { value: r } => r.reference_type
    RuntimeClosure { value: c } => c.arrow_type
    RuntimeUnit { value: u } => u.unit_type
  }
}

fn runtime_value_named_edge(name: v2.std.node.Symbol, target: v2.std.node.Node) -> v2.std.node.Edge {
  v2.std.node.Edge { label: Named { name: name }, target: target }
}

fn runtime_value_conj_node(children: std.types.List<v2.std.node.Edge>) -> v2.std.node.Node {
  v2.std.node.node_synthetic(kind: v2.std.node.TypeNode { connective: Conj }, children: children)
}

fn runtime_value_symbol_atom(sym: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.node_synthetic(
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: sym } },
    children: []
  )
}

fn runtime_bit_node_projection(bit: Bool) -> v2.std.node.Node {
  match bit {
    true => runtime_value_symbol_atom(sym: ^runtime_bit_true_tag)
    false => runtime_value_symbol_atom(sym: ^runtime_bit_false_tag)
  }
}

fn runtime_bits_list_node(bits: std.types.List<Bool>) -> v2.std.node.Node {
  v2.std.algebra.fold_list_node(
    xs: bits,
    item_node: fn(bit) { runtime_bit_node_projection(bit: bit) }
  )
}

fn runtime_byte_node_projection(byte: std.bit.Byte) -> v2.std.node.Node {
  runtime_value_conj_node(children: [
    runtime_value_named_edge(
      name: ^runtime_byte_bits_node_projection,
      target: runtime_bits_list_node(bits: byte.bits)
    )
  ])
}

fn runtime_bytes_list_node(bytes: std.types.List<std.bit.Byte>) -> v2.std.node.Node {
  v2.std.algebra.fold_list_node(
    xs: bytes,
    item_node: fn(byte) { runtime_byte_node_projection(byte: byte) }
  )
}

fn runtime_primitive_value_node_projection(
  primitive: v2.std.runtime.RuntimePrimitiveValue
) -> v2.std.runtime.RuntimeValueNodeProjection {
  RuntimeValueNodeProjected {
    node: runtime_value_conj_node(children: [
      runtime_value_named_edge(
        name: ^runtime_primitive_type_node_projection,
        target: primitive.primitive_type
      ),
      runtime_value_named_edge(
        name: ^runtime_primitive_bytes_node_projection,
        target: runtime_bytes_list_node(bytes: primitive.bytes)
      )
    ])
  }
}

fn runtime_field_value_node_projection(
  field_value: v2.std.runtime.RuntimeFieldValue
) -> v2.std.runtime.RuntimeValueNodeProjection {
  match runtime_value_node_projection(value: field_value.value) {
    RuntimeValueNodeProjected { node: value_node } =>
      RuntimeValueNodeProjected {
        node: runtime_value_conj_node(children: [
          runtime_value_named_edge(
            name: ^runtime_field_value_field_node_projection,
            target: runtime_value_symbol_atom(sym: field_value.field)
          ),
          runtime_value_named_edge(
            name: ^runtime_field_value_value_node_projection,
            target: value_node
          )
        ])
      }
    RuntimeValueNodeUnrepresentable => RuntimeValueNodeUnrepresentable
  }
}

fn runtime_fields_list_node(fields: std.types.List<v2.std.runtime.RuntimeFieldValue>) -> v2.std.runtime.RuntimeValueNodeProjection {
  v2.std.algebra.fold_list(
    xs: fields,
    empty: RuntimeValueNodeProjected { node: v2.std.algebra.algebra_empty_conj() },
    cons: fn(acc, field_value) {
      match acc {
        RuntimeValueNodeProjected { node: tail_node } =>
          match runtime_field_value_node_projection(field_value: field_value) {
            RuntimeValueNodeProjected { node: head_node } =>
              RuntimeValueNodeProjected {
                node: runtime_value_conj_node(children: [
                  runtime_value_named_edge(
                    name: ^fold_list_node_head,
                    target: head_node
                  ),
                  runtime_value_named_edge(
                    name: ^fold_list_node_tail,
                    target: tail_node
                  )
                ])
              }
            RuntimeValueNodeUnrepresentable => RuntimeValueNodeUnrepresentable
          }
        RuntimeValueNodeUnrepresentable => RuntimeValueNodeUnrepresentable
      }
    }
  )
}

fn runtime_aggregate_value_node_projection(
  aggregate: v2.std.runtime.RuntimeAggregateValue
) -> v2.std.runtime.RuntimeValueNodeProjection {
  match runtime_fields_list_node(fields: aggregate.fields) {
    RuntimeValueNodeProjected { node: fields_node } =>
      RuntimeValueNodeProjected {
        node: runtime_value_conj_node(children: [
          runtime_value_named_edge(
            name: ^runtime_aggregate_type_node_projection,
            target: aggregate.aggregate_type
          ),
          runtime_value_named_edge(
            name: ^runtime_aggregate_fields_node_projection,
            target: fields_node
          )
        ])
      }
    RuntimeValueNodeUnrepresentable => RuntimeValueNodeUnrepresentable
  }
}

fn runtime_value_node_projection(value: v2.std.runtime.RuntimeValue) -> v2.std.runtime.RuntimeValueNodeProjection {
  match value {
    RuntimePrimitive { value: gunbc.plans.md_helpers.p } => runtime_primitive_value_node_projection(primitive: gunbc.plans.md_helpers.p)
    RuntimeAggregate { value: a } => runtime_aggregate_value_node_projection(aggregate: a)
    RuntimeReference { value: _ } => RuntimeValueNodeUnrepresentable
    RuntimeClosure { value: _ } => RuntimeValueNodeUnrepresentable
    RuntimeUnit { value: _ } => RuntimeValueNodeUnrepresentable
  }
}

type ValueRepresentationModel {
  represent_literal: fn(v2.std.node.Node, v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue>
  represent_result: fn(v2.std.runtime.RuntimeValue) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue>
}

type EvaluationFrame {
  current: v2.std.node.Node
  environment: v2.std.runtime.EvaluationEnvironment
}

type EvaluationCall {
  callee: v2.std.node.Node
  arguments: std.types.List<v2.std.runtime.RuntimeValue>
}

type ControlTransfer
  = Continue { value: v2.std.runtime.RuntimeValue }
  | Return { value: v2.std.runtime.RuntimeValue }
  | Raise { diagnostic: v2.std.diagnostic.Diagnostic }
  | Suspend { continuation: v2.std.runtime.EvaluationFrame }

type AllocationSemantics {
  allocate: fn(v2.std.runtime.RuntimeValue) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue>
}

type CallSemantics {
  call: fn(v2.std.runtime.EvaluationCall, v2.std.runtime.EvaluationFrame) -> v2.std.diagnostic.Outcome<v2.std.runtime.ControlTransfer>
  return_value: fn(v2.std.runtime.RuntimeValue, v2.std.runtime.EvaluationFrame) -> v2.std.diagnostic.Outcome<v2.std.runtime.ControlTransfer>
}

type ControlSemantics {
  transfer: fn(v2.std.runtime.ControlTransfer, v2.std.runtime.EvaluationFrame) -> v2.std.diagnostic.Outcome<v2.std.runtime.EvaluationFrame>
  terminal_value: fn(v2.std.runtime.ControlTransfer, v2.std.runtime.EvaluationFrame) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue>
}

type ExecutionSemantics {
  allocation: v2.std.runtime.AllocationSemantics
  calls: v2.std.runtime.CallSemantics
  control: v2.std.runtime.ControlSemantics
}

type ValueInterpreter {
  allocate_literal: fn(v2.std.node.Node, EvaluationEnvironment) -> v2.std.diagnostic.Outcome<RuntimeValue>
  identity: v2.std.node.Symbol
}

type TransformInterpreter {
  call_primitive: fn(v2.std.node.Node, std.types.List<RuntimeValue>, EvaluationEnvironment) -> v2.std.diagnostic.Outcome<RuntimeValue>
  identity: v2.std.node.Symbol
}

type BranchInterpreter {
  choose_branch: fn(v2.std.node.Node, RuntimeValue, EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.node.Node>
  identity: v2.std.node.Symbol
}

type LoopInterpreter {
  step_loop: fn(v2.std.node.Node, EvaluationEnvironment) -> v2.std.diagnostic.Outcome<ControlTransfer>
  identity: v2.std.node.Symbol
}

type BindInterpreter {
  bind_value: fn(EnvironmentBindingKey, RuntimeValue, EvaluationEnvironment) -> v2.std.diagnostic.Outcome<EvaluationEnvironment>
  identity: v2.std.node.Symbol
}

type MatchInterpreter {
  choose_arm: fn(v2.std.node.Node, RuntimeValue, EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.node.Node>
  identity: v2.std.node.Symbol}

type InterpretationAlgebra {
  value: v2.std.runtime.ValueInterpreter
  transform: v2.std.runtime.TransformInterpreter
  branch: v2.std.runtime.BranchInterpreter
  loop: v2.std.runtime.LoopInterpreter
  bind: v2.std.runtime.BindInterpreter
  match: v2.std.runtime.MatchInterpreter
}

type InterpretationStructureWitness {
  allocate_literal: v2.std.node.Symbol,
  call_primitive: v2.std.node.Symbol,
  choose_branch: v2.std.node.Symbol,
  step_loop: v2.std.node.Symbol,
  bind_value: v2.std.node.Symbol,
  choose_arm: v2.std.node.Symbol
}

type RuntimeBehaviorInterpreter
  = ValueRuntimeInterpreter { interpreter: v2.std.runtime.ValueInterpreter }
  | TransformRuntimeInterpreter { interpreter: v2.std.runtime.TransformInterpreter }
  | BranchRuntimeInterpreter { interpreter: v2.std.runtime.BranchInterpreter }
  | LoopRuntimeInterpreter { interpreter: v2.std.runtime.LoopInterpreter }
  | BindRuntimeInterpreter { interpreter: v2.std.runtime.BindInterpreter }
  | MatchRuntimeInterpreter { interpreter: v2.std.runtime.MatchInterpreter }

fn interpretation_behavior_dispatch(
  interpretation: v2.std.runtime.InterpretationAlgebra,
  behavior: v2.std.node.Behavior
) -> v2.std.runtime.RuntimeBehaviorInterpreter {
  match behavior {
    Value => ValueRuntimeInterpreter { interpreter: interpretation.value }
    Transform => TransformRuntimeInterpreter { interpreter: interpretation.transform }
    Branch => BranchRuntimeInterpreter { interpreter: interpretation.branch }
    Loop => LoopRuntimeInterpreter { interpreter: interpretation.loop }
    Bind => BindRuntimeInterpreter { interpreter: interpretation.bind }
    Match => MatchRuntimeInterpreter { interpreter: interpretation.match }
  }
}

data runtime_match_unimplemented: v2.std.node.Symbol = ^runtime_match_unimplemented

fn runtime_reject_match_arm(
  node: v2.std.node.Node,
  _value: v2.std.runtime.RuntimeValue,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.outcome_rejected(
    v2.std.diagnostic.Diagnostic {
      reason: runtime_match_unimplemented,
      at: v2.std.diagnostic.node_locus(node: node),
      correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
    }
  )
}

type BoundaryAllowance {
  operation: v2.std.model_core.PrimitiveOperationRef
  resource: v2.std.model_core.ResourceAccess
  allowed: Bool
}

type ResourceEffectBoundary {
  ffi: v2.std.runtime.BoundaryAllowance
  exceptions: v2.std.runtime.BoundaryAllowance
  async: v2.std.runtime.BoundaryAllowance
  concurrency: v2.std.runtime.BoundaryAllowance
  identity_reference: v2.std.runtime.BoundaryAllowance
}

type EffectRequestKind
  = ReadResource
  | WriteResource

type EffectRequest {
  kind: v2.std.runtime.EffectRequestKind
  operation: v2.std.model_core.PrimitiveOperationRef
  arguments: std.types.List<v2.std.runtime.RuntimeValue>
  continuation: v2.std.runtime.EvaluationFrame
}

type EffectHandler {
  handle: fn(v2.std.runtime.EffectRequest) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue>
}

type EffectHandlerBinding {
  read_resource: v2.std.runtime.EffectHandler
  write_resource: v2.std.runtime.EffectHandler
}

fn effect_handler_for_kind(binding: v2.std.runtime.EffectHandlerBinding, kind: v2.std.runtime.EffectRequestKind) -> v2.std.runtime.EffectHandler {
  match kind {
    ReadResource => binding.read_resource
    WriteResource => binding.write_resource
  }
}

type EffectReceipt {
  request: v2.std.runtime.EffectRequest
  result: v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue>
}

type EffectReceiptLog {
  entries: std.types.List<v2.std.runtime.EffectReceipt>
}
