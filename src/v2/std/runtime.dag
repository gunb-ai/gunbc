module v2.std.runtime

import v2.std.collection { List, Map, Optional, Present, optional_absent, optional_present }
import v2.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Unavailable,
  node_locus,
  outcome_rejected
}
import v2.std.algebra { fold_list, fold_list_node, algebra_empty_conj }
import v2.std.logic { Bool }
import v2.std.machine { Byte }
import v2.std.model_core { ModelCore, PrimitiveOperationRef, ResourceAccess }
import v2.std.node {
  Atom,
  Behavior,
  Conj,
  Edge,
  Named,
  Node,
  Symbol,
  TypeNode,
  node_synthetic
}

type RuntimeIdentity {
  identity: Symbol
}

type RuntimeFieldValue {
  field: Symbol
  value: RuntimeValue
}

type EnvironmentBindingKey {
  identity: Symbol
}

fn environment_binding_key_for_symbol(sym: Symbol) -> EnvironmentBindingKey {
  EnvironmentBindingKey {
    identity: sym
  }
}

type EvaluationEnvironment {
  bindings: Map<EnvironmentBindingKey, RuntimeValue>
}

type RuntimePrimitiveValue {
  primitive_type: Node
  bytes: List<Byte>
}

type RuntimeAggregateValue {
  aggregate_type: Node
  fields: List<RuntimeFieldValue>
}

type RuntimeReferenceValue {
  reference_type: Node
  identity: RuntimeIdentity
  referent_type: Node
}

type RuntimeClosureValue {
  arrow_type: Node
  arrow: Node
  environment: EvaluationEnvironment
}

type RuntimeUnitValue {
  unit_type: Node
}

type RuntimeValue
  = RuntimePrimitive { value: RuntimePrimitiveValue }
  | RuntimeAggregate { value: RuntimeAggregateValue }
  | RuntimeReference { value: RuntimeReferenceValue }
  | RuntimeClosure { value: RuntimeClosureValue }
  | RuntimeUnit { value: RuntimeUnitValue }

type RuntimeOutcome
  = Panic { panic_classification: Symbol }
  | Wrap
  | CheckedReturn { wrapped_value: Node }
  | ExceptionRaise { exception_node: Node }

type RuntimeValueNodeProjection
  = RuntimeValueNodeProjected { node: Node }
  | RuntimeValueNodeUnrepresentable

type IdentityEvidence
  = ReferenceIdentical
  | StructurallyCompared { equal: Bool }

fn identity_evidence_equal(evidence: IdentityEvidence) -> Bool {
  match evidence {
    ReferenceIdentical => true
    StructurallyCompared { equal: eq } => eq
  }
}

fn runtime_value_resolved_type(value: RuntimeValue) -> Node {
  match value {
    RuntimePrimitive { value: p } => p.primitive_type
    RuntimeAggregate { value: a } => a.aggregate_type
    RuntimeReference { value: r } => r.reference_type
    RuntimeClosure { value: c } => c.arrow_type
    RuntimeUnit { value: u } => u.unit_type
  }
}

fn runtime_value_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn runtime_value_conj_node(children: List<Edge>) -> Node {
  node_synthetic(kind: TypeNode { connective: Conj }, children: children)
}

fn runtime_value_symbol_atom(sym: Symbol) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Atom { identity: sym } },
    children: []
  )
}

fn runtime_bit_node_projection(bit: Bool) -> Node {
  match bit {
    true => runtime_value_symbol_atom(sym: ^runtime_bit_true_tag)
    false => runtime_value_symbol_atom(sym: ^runtime_bit_false_tag)
  }
}

fn runtime_bits_list_node(bits: List<Bool>) -> Node {
  fold_list_node(
    xs: bits,
    item_node: fn(bit) { runtime_bit_node_projection(bit: bit) }
  )
}

fn runtime_byte_node_projection(byte: Byte) -> Node {
  runtime_value_conj_node(children: [
    runtime_value_named_edge(
      name: ^runtime_byte_bits_node_projection,
      target: runtime_bits_list_node(bits: byte.bits)
    )
  ])
}

fn runtime_bytes_list_node(bytes: List<Byte>) -> Node {
  fold_list_node(
    xs: bytes,
    item_node: fn(byte) { runtime_byte_node_projection(byte: byte) }
  )
}

fn runtime_primitive_value_node_projection(
  primitive: RuntimePrimitiveValue
) -> RuntimeValueNodeProjection {
  RuntimeValueNodeProjected {
    node: runtime_value_conj_node(children: [
      runtime_value_named_edge(
        name: ^runtime_primitive_type_node_projection,
        target: primitive.primitive_type
      ),
      runtime_value_named_edge(
        name: ^runtime_primitive_bytes_node_projection,
        target: runtime_bytes_list_node(bytes: primitive.bytes)
      )
    ])
  }
}

fn runtime_field_value_node_projection(
  field_value: RuntimeFieldValue
) -> RuntimeValueNodeProjection {
  match runtime_value_node_projection(value: field_value.value) {
    RuntimeValueNodeProjected { node: value_node } =>
      RuntimeValueNodeProjected {
        node: runtime_value_conj_node(children: [
          runtime_value_named_edge(
            name: ^runtime_field_value_field_node_projection,
            target: runtime_value_symbol_atom(sym: field_value.field)
          ),
          runtime_value_named_edge(
            name: ^runtime_field_value_value_node_projection,
            target: value_node
          )
        ])
      }
    RuntimeValueNodeUnrepresentable => RuntimeValueNodeUnrepresentable
  }
}

fn runtime_fields_list_node(fields: List<RuntimeFieldValue>) -> RuntimeValueNodeProjection {
  fold_list(
    xs: fields,
    empty: RuntimeValueNodeProjected { node: algebra_empty_conj() },
    cons: fn(acc, field_value) {
      match acc {
        RuntimeValueNodeProjected { node: tail_node } =>
          match runtime_field_value_node_projection(field_value: field_value) {
            RuntimeValueNodeProjected { node: head_node } =>
              RuntimeValueNodeProjected {
                node: runtime_value_conj_node(children: [
                  runtime_value_named_edge(
                    name: ^fold_list_node_head,
                    target: head_node
                  ),
                  runtime_value_named_edge(
                    name: ^fold_list_node_tail,
                    target: tail_node
                  )
                ])
              }
            RuntimeValueNodeUnrepresentable => RuntimeValueNodeUnrepresentable
          }
        RuntimeValueNodeUnrepresentable => RuntimeValueNodeUnrepresentable
      }
    }
  )
}

fn runtime_aggregate_value_node_projection(
  aggregate: RuntimeAggregateValue
) -> RuntimeValueNodeProjection {
  match runtime_fields_list_node(fields: aggregate.fields) {
    RuntimeValueNodeProjected { node: fields_node } =>
      RuntimeValueNodeProjected {
        node: runtime_value_conj_node(children: [
          runtime_value_named_edge(
            name: ^runtime_aggregate_type_node_projection,
            target: aggregate.aggregate_type
          ),
          runtime_value_named_edge(
            name: ^runtime_aggregate_fields_node_projection,
            target: fields_node
          )
        ])
      }
    RuntimeValueNodeUnrepresentable => RuntimeValueNodeUnrepresentable
  }
}

fn runtime_value_node_projection(value: RuntimeValue) -> RuntimeValueNodeProjection {
  match value {
    RuntimePrimitive { value: p } => runtime_primitive_value_node_projection(primitive: p)
    RuntimeAggregate { value: a } => runtime_aggregate_value_node_projection(aggregate: a)
    RuntimeReference { value: _ } => RuntimeValueNodeUnrepresentable
    RuntimeClosure { value: _ } => RuntimeValueNodeUnrepresentable
    RuntimeUnit { value: _ } => RuntimeValueNodeUnrepresentable
  }
}

type ValueRepresentationModel {
  represent_literal: fn(Node, EvaluationEnvironment) -> Outcome<RuntimeValue>
  represent_result: fn(RuntimeValue) -> Outcome<RuntimeValue>
}

type EvaluationFrame {
  current: Node
  environment: EvaluationEnvironment
}

type EvaluationCall {
  callee: Node
  arguments: List<RuntimeValue>
}

type ControlTransfer
  = Continue { value: RuntimeValue }
  | Return { value: RuntimeValue }
  | Raise { diagnostic: Diagnostic }
  | Suspend { continuation: EvaluationFrame }

type AllocationSemantics {
  allocate: fn(RuntimeValue) -> Outcome<RuntimeValue>
}

type CallSemantics {
  call: fn(EvaluationCall, EvaluationFrame) -> Outcome<ControlTransfer>
  return_value: fn(RuntimeValue, EvaluationFrame) -> Outcome<ControlTransfer>
}

type ControlSemantics {
  transfer: fn(ControlTransfer, EvaluationFrame) -> Outcome<EvaluationFrame>
  terminal_value: fn(ControlTransfer, EvaluationFrame) -> Outcome<RuntimeValue>
}

type ExecutionSemantics {
  allocation: AllocationSemantics
  calls: CallSemantics
  control: ControlSemantics
}

type ValueInterpreter {
  allocate_literal: fn(Node, EvaluationEnvironment) -> Outcome<RuntimeValue>
}

type TransformInterpreter {
  call_primitive: fn(Node, List<RuntimeValue>, EvaluationEnvironment) -> Outcome<RuntimeValue>
}

type BranchInterpreter {
  choose_branch: fn(Node, RuntimeValue, EvaluationEnvironment) -> Outcome<Node>
}

type LoopInterpreter {
  step_loop: fn(Node, EvaluationEnvironment) -> Outcome<ControlTransfer>
}

type BindInterpreter {
  bind_value: fn(EnvironmentBindingKey, RuntimeValue, EvaluationEnvironment) -> Outcome<EvaluationEnvironment>
}

type MatchInterpreter {
  choose_arm: fn(Node, RuntimeValue, EvaluationEnvironment) -> Outcome<Node>
}

type InterpretationAlgebra {
  value: ValueInterpreter
  transform: TransformInterpreter
  branch: BranchInterpreter
  loop: LoopInterpreter
  bind: BindInterpreter
  match: MatchInterpreter
}

type InterpretationStructureWitness {
  allocate_literal: Symbol,
  call_primitive: Symbol,
  choose_branch: Symbol,
  step_loop: Symbol,
  bind_value: Symbol,
  choose_arm: Symbol
}

type RuntimeBehaviorInterpreter
  = ValueRuntimeInterpreter { interpreter: ValueInterpreter }
  | TransformRuntimeInterpreter { interpreter: TransformInterpreter }
  | BranchRuntimeInterpreter { interpreter: BranchInterpreter }
  | LoopRuntimeInterpreter { interpreter: LoopInterpreter }
  | BindRuntimeInterpreter { interpreter: BindInterpreter }
  | MatchRuntimeInterpreter { interpreter: MatchInterpreter }

fn interpretation_behavior_dispatch(
  interpretation: InterpretationAlgebra,
  behavior: Behavior
) -> RuntimeBehaviorInterpreter {
  match behavior {
    Value => ValueRuntimeInterpreter { interpreter: interpretation.value }
    Transform => TransformRuntimeInterpreter { interpreter: interpretation.transform }
    Branch => BranchRuntimeInterpreter { interpreter: interpretation.branch }
    Loop => LoopRuntimeInterpreter { interpreter: interpretation.loop }
    Bind => BindRuntimeInterpreter { interpreter: interpretation.bind }
    Match => MatchRuntimeInterpreter { interpreter: interpretation.match }
  }
}

data runtime_match_unimplemented: Symbol = ^runtime_match_unimplemented

fn runtime_reject_match_arm(
  node: Node,
  _value: RuntimeValue,
  _env: EvaluationEnvironment
) -> Outcome<Node> {
  outcome_rejected(
    Diagnostic {
      reason: runtime_match_unimplemented,
      at: node_locus(node: node),
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  )
}

type BoundaryAllowance {
  operation: PrimitiveOperationRef
  resource: ResourceAccess
  allowed: Bool
}

type ResourceEffectBoundary {
  ffi: BoundaryAllowance
  exceptions: BoundaryAllowance
  async: BoundaryAllowance
  concurrency: BoundaryAllowance
  identity_reference: BoundaryAllowance
}

type EffectRequestKind
  = ReadResource
  | WriteResource

type EffectRequest {
  kind: EffectRequestKind
  operation: PrimitiveOperationRef
  arguments: List<RuntimeValue>
  continuation: EvaluationFrame
}

type EffectHandler {
  handle: fn(EffectRequest) -> Outcome<RuntimeValue>
}

type EffectHandlerBinding {
  read_resource: EffectHandler
  write_resource: EffectHandler
}

fn effect_handler_for_kind(binding: EffectHandlerBinding, kind: EffectRequestKind) -> EffectHandler {
  match kind {
    ReadResource => binding.read_resource
    WriteResource => binding.write_resource
  }
}

type EffectReceipt {
  request: EffectRequest
  result: Outcome<RuntimeValue>
}

type EffectReceiptLog {
  entries: List<EffectReceipt>
}
