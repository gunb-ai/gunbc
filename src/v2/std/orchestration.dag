module v2.std.orchestration

import v2.std.text { String }
import std.nat { Nat }
import std.algebra { FreeMonoid }
import v2.std.collection {
  List
}
import v2.std.optional {
  Optional
}
import v2.std.diagnostic { EmitDirective }
import v2.std.node { Symbol }

type EnvBinding
  = EnvSet { name: String, value: String }
  | EnvUnset { name: String }

type RedirectSpec
  = StdoutAndStderr
  | DiscardAll
  | DiscardErr
  | ToFile { path: String }

data redirect_spec_to_file_note: String = "ToFile \{ path \} is the stdout-to-path carrier (\"> path\"). Added with live consumer ci_merge_admission_floor_disposition_stamp (bucket D PR2a) — dissolves the echo++concat redirect. bash_redir_to_file_* rows already existed on the fold side; this variant is the intent-side authority orch_emit_redir_suffix matches. path is emitted unquoted, so orch_emit_redir_suffix refuses anything outside the portable unquoted-word alphabet [A-Za-z0-9_./-@] (^orch_emit_to_file_path_invalid) — same fail-closed wall as ExitStatus binder / Comment multiline (spaces, newlines, and shell metacharacters cannot change meaning or inject a second command)."

type CaptureSpec
  = TeeTo { log: String }
  | CmdSubst
  | IgnoreFail
  | ExitStatus { binder: String }

data capture_spec_exit_status_note: String = "ExitStatus \{ binder \} captures $? into binder after a Run (emits \"\\nbinder=$?\"). binder must be a POSIX-ish shell identifier ([A-Za-z_][A-Za-z0-9_]*) — orch_emit_exit_status_bind refuses otherwise (^orch_emit_exit_status_binder_invalid), so newline injection cannot open an executable second line (same fail-closed wall as Comment multiline). Live consumer: ci_floor_stamp_merge_admission_script STAMP_EXIT (bucket D PR2a). FLOOR_EXIT=$? at fragment start stays a constant opaque Run.command — ambient prior-command capture outside this Pipeline; IntNe/Exit step carriers land in PR2b."

data capture_spec_tee_cmdsubst_finding: String = "FINDING (filed, unowned, not fixed here): CaptureSpec.CmdSubst is declared with zero constructors tree-wide — genuinely dead (ExprCmdSubst / CmdSubstLines are different types). CaptureSpec.TeeTo is NOT unreachable: ci_retry_body_run (dag/gunbc/ci_spec.dag) constructs capture: TeeTo \{ log: \"BUILD_LOG\" \}, but the declaration is INERT — orch_retry_step_command returns only r.command and orch_emit_retry_run rebuilds with redirect/capture Absent, while the identical tee semantics are hardcoded as fixed tokens at bash.dag orch_retry rows (~1093-1133). Editing log: \"BUILD_LOG\" changes no emitted bytes. §3 dual representation (model side inert; hardcode load-bearing). Contrast: ordinary Run emit refuses TeeTo/CmdSubst fail-closed and typed (^orch_emit_run_capture_unsupported). PR2a wall: orch_retry_run_redirect_capture_admitted admits only Absent/Absent and the legacy StdoutAndStderr±TeeTo shapes used by ci_retry_body_run — ToFile / ExitStatus / IgnoreFail / CmdSubst / Discard* on a Retry body are Absent→^orch_emit_retry_body_not_run (refuse, never silent drop). Discriminating experiment: rename the log in ci_retry_body_run, regen, show ci.yml byte-identical. Fix direction (not this PR): thread redirect/capture through the retry path and dissolve the hardcoded tokens."

type Run {
  command: String
  env: FreeMonoid<EnvBinding>
  redirect: Optional<RedirectSpec>
  capture: Optional<CaptureSpec>
}

type ValueSource
  = CmdSubstLines { run: Run }
  | Glob { pattern: String }
  | ModeledList { items: FreeMonoid<String> }

type Predicate
  = ExitZero { run: Run }
  | LogMatches { source: String, pattern: String }
  | StrEq { lhs: String, rhs: String }
  | StrEmpty { operand: String }
  | StrNonempty { operand: String }
  | Not { inner: Predicate }
  | And { lhs: Predicate, rhs: Predicate }
  | Or { lhs: Predicate, rhs: Predicate }

data predicate_string_test_note: String = "StrEq is binary [ lhs = rhs ]. Unary empty/nonempty tests are StrEmpty (-z) and StrNonempty (-n); do not encode them as StrEq with a literal \"\" operand."

type EscalationLevel {
  detect: Predicate
  warning: EmitDirective
  env: FreeMonoid<EnvBinding>
}

type FailurePolicy = FailFast | Continue

type Expr
  = ExprLit { spelling: String }
  | ExprVarRef { name: String }
  | ExprCmdSubst { callee: String, args: List<String> }

type Procedure {
  name: String
  body: Pipeline
}

type PipelineStep
  = Do { run: Run }
  | Comment { text: String }
  | If { cond: Predicate, then_: Pipeline, else_: Optional<Pipeline> }
  | For { binder: Symbol, over: ValueSource, body: Pipeline }
  | While { cond: Predicate, body: Pipeline }
  | BoundedPoll {
      max_attempts: v2.std.nat.Nat,
      body: Pipeline,
      success: Predicate
    }
  | Retry {
      body: Pipeline,
      escalations: FreeMonoid<EscalationLevel>,
      on_exhausted: Pipeline
    }
  | Let { name: String, value: Expr }
  | Call { callee: String, args: List<String> }

data pipeline_step_comment_note: String = "Comment \{ text \} is a non-command PipelineStep (comment body WITHOUT the leading \"# \"). Emission reuses the existing orch_construct_run_rawline / realize_run_rawline path (bash_fold_raw_line_target_model) — no new grammar row (operator PR2a ruling). Multiline text is REFUSED (^orch_emit_comment_multiline_refused): a newline would start an executable shell line after the \"# \" prefix, so the non-command invariant holds by construction (fail-closed), not by hoping authors stay single-line."

type Pipeline {
  steps: FreeMonoid<PipelineStep>
  on_failure: FailurePolicy
}

data pipeline_steps_empty_arm_note: String = "Pipeline.steps is a plain FreeMonoid<PipelineStep> with no NonEmpty variant and no smart constructor, so steps: Empty (a zero-step Pipeline) is legally constructible today -- consistent with orch_emit_pipeline's existing HeadAbsent -> \"\" no-op convention at the top level. Nested as an If arm, orch_emit_if_step spells an empty arm's body as the bash no-op \":\" (never an empty token span, which is invalid bash), uniformly for every arm shape including both arms empty -- a Predicate executes a command (ExitZero/LogMatches/StrEq/etc., v2.std.orchestration), so even a both-empty If is a real \"run the condition, discard the outcome\" intent, not dead code, and is never refused. A NonEmpty<PipelineStep> carrier was considered and declined: zero occurrences in tree today, and it would touch this type plus every Pipeline constructor for a currently-unexercised case (the purity trap, DESIGN.md sec 6) -- revisit if empty-Pipeline construction sites start appearing."

data orchestration_bash_emit_scaffold_note: String = "v2.std.orchestration Pipeline/PipelineStep is the bash-emit scaffold: Do-run leaves carry command strings for foreign-executor/bootstrap emission via v2.compiler.emit_orchestration. Runtime-present bounded composition authority is v2.std.effect_plan EffectPlan/Do-effect (host-effect-orchestration.md section 1b; #6903 Wave A2)."

data orchestration_to_effect_plan_dissolve_on: String = "🟡 dissolve-on: v2.std.orchestration — bash-emit Pipeline/PipelineStep scaffold (Do-run string leaves). Composition authority for bounded external effects is v2.std.effect_plan (landed #6903). DISSOLVES WHEN host-effect-orchestration.md Phase B: module renames/merges into std.effect_plan, Run.command leaves migrate onto typed EffectPlan Do-effect leaves and extdeps operations, and foreign-executor sites route through emit_orchestration only."
