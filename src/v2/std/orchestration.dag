module v2.std.orchestration

import v2.std.text { String }
import v2.std.algebra { FreeMonoid, Cons, Empty }
import v2.std.collection { Optional, Present, Absent }
import v2.std.cardinality { DescentEvidence }
import v2.std.diagnostic { EmitDirective }
import v2.std.node { Symbol }

type EnvBinding
  = EnvSet { name: String, value: String }
  | EnvUnset { name: String }

type RedirectSpec
  = StdoutAndStderr
  | DiscardAll
  | DiscardErr

type CaptureSpec
  = TeeTo { log: String }
  | CmdSubst
  | IgnoreFail

type Run {
  command: String
  env: FreeMonoid<EnvBinding>
  redirect: Optional<RedirectSpec>
  capture: Optional<CaptureSpec>
}

type ValueSource
  = CmdSubstLines { run: Run }
  | Glob { pattern: String }
  | ModeledList { items: FreeMonoid<String> }

type Predicate
  = ExitZero { run: Run }
  | LogMatches { source: String, pattern: String }
  | StrEq { lhs: String, rhs: String }
  | Not { inner: Predicate }
  | And { lhs: Predicate, rhs: Predicate }
  | Or { lhs: Predicate, rhs: Predicate }

type EscalationLevel {
  detect: Predicate
  warning: EmitDirective
  env: FreeMonoid<EnvBinding>
}

type FailurePolicy = FailFast | Continue

type Step
  = Do { run: Run }
  | If { cond: Predicate, then_: Pipeline, else_: Optional<Pipeline> }
  | For { binder: Symbol, over: ValueSource, body: Pipeline }
  | While { cond: Predicate, body: Pipeline, bound: DescentEvidence }
  | Retry {
      body: Pipeline,
      escalations: FreeMonoid<EscalationLevel>,
      on_exhausted: Pipeline
    }

type Pipeline {
  steps: FreeMonoid<Step>
  on_failure: FailurePolicy
}

fn predicate_log_pattern(pred: Predicate) -> Optional<String> {
  match pred {
    LogMatches { source: _, pattern: p } => Present { value: p }
    ExitZero { run: _ } => Absent
    StrEq { lhs: _, rhs: _ } => Absent
    Not { inner: _ } => Absent
    And { lhs: _, rhs: _ } => Absent
    Or { lhs: _, rhs: _ } => Absent
  }
}

fn pipeline_first_step(p: Pipeline) -> Optional<Step> {
  match p.steps {
    Cons { head: h, tail: _ } => Present { value: h }
    Empty => Absent
  }
}

fn step_command_spelling(step: Step) -> Optional<String> {
  match step {
    Do { run: r } => Present { value: r.command }
    If { cond: _, then_: _, else_: _ } => Absent
    For { binder: _, over: _, body: _ } => Absent
    While { cond: _, body: _, bound: _ } => Absent
    Retry { body: _, escalations: _, on_exhausted: _ } => Absent
  }
}

fn escalations_head(levels: FreeMonoid<EscalationLevel>) -> Optional<EscalationLevel> {
  match levels {
    Cons { head: h, tail: _ } => Present { value: h }
    Empty => Absent
  }
}

fn escalations_rest(levels: FreeMonoid<EscalationLevel>) -> FreeMonoid<EscalationLevel> {
  match levels {
    Cons { head: _, tail: t } => t
    Empty => []
  }
}
