module v2.std.decl_ref_resolution

import std.decl_ref { DeclarationRef, WholeDeclaration, NamedField }
import v2.std.decl_index { DeclFact, logical_qualified_name_from_module }

data decl_ref_resolution_authority_note: String = "G1 cited-symbol resolution (feature:cited-symbol-resolution): every typed DeclarationRef resolves to exactly one top-level declaration in decl_facts, or refuses with a typed cause. Qualified-name join uses logical_qualified_name_from_module — the same strip-v2. rule as decl_facts rows (coproduct_reflection decl_logical_qualified_name). AmbiguousBinding is the structural answer to double-bound decl_name rows in one module (extdeps.github.actions upload_artifact_action). dissolve-on: substrate construction refuses unresolvable DeclarationRef literals at definition sites; this module remains the runtime resolution authority for lens walks."

type DeclarationRefResolutionCause
  = DeclAbsent
  | AmbiguousBinding { match_count: Int }
  | NamedFieldAbsent { field_name: String }

type DeclarationRefResolution
  = Resolved { fact: DeclFact }
  | Refused { cause: DeclarationRefResolutionCause }

fn declaration_ref_target_qualified_name(ref: DeclarationRef) -> String {
  logical_qualified_name_from_module(
    module_name: ref.module_path as String,
    name: ref.decl_name as String
  )
}

fn decl_facts_matching_qualified_name(qn: String, facts: List<DeclFact>) -> List<DeclFact> {
  fold(facts, init: std.algebra.Empty, f: fn(acc, fact) {
    if fact.qualified_name == qn {
      list_snoc_item(xs: acc, item: fact)
    } else {
      acc
    }
  })
}

fn decl_ref_named_field_present(ref: DeclarationRef, fact: DeclFact) -> Bool {
  match ref.field {
    WholeDeclaration => true
    NamedField { field_name: fn } =>
      any(
        xs: node_labeled_child_edges(node: fact.node),
        predicate: fn(e) { named_edge_sort_key(e: e) == fn as String }
      )
  }
}

fn resolve_declaration_ref(ref: DeclarationRef, facts: List<DeclFact>) -> DeclarationRefResolution {
  let matches = decl_facts_matching_qualified_name(
    qn: declaration_ref_target_qualified_name(ref: ref),
    facts: facts
  )
  let n = length(xs: matches)
  if n == 0 {
    Refused { cause: DeclAbsent }
  } else if n > 1 {
    Refused { cause: AmbiguousBinding { match_count: n } }
  } else {
    match list_head(xs: matches) {
      HeadAbsent => Refused { cause: DeclAbsent }
      HeadFound { value: sole } =>
        if decl_ref_named_field_present(ref: ref, fact: sole) {
          Resolved { fact: sole }
        } else {
          match ref.field {
            NamedField { field_name: fn } =>
              Refused { cause: NamedFieldAbsent { field_name: fn as String } }
            WholeDeclaration => Refused { cause: DeclAbsent }
          }
        }
    }
  }
}

fn declaration_ref_resolves(ref: DeclarationRef, facts: List<DeclFact>) -> Bool {
  match resolve_declaration_ref(ref: ref, facts: facts) {
    Resolved { fact: _ } => true
    Refused { cause: _ } => false
  }
}

fn cited_declaration_ref_refusal_count(refs: List<DeclarationRef>, facts: List<DeclFact>) -> Int {
  count_where(
    xs: refs,
    predicate: fn(r) { !declaration_ref_resolves(ref: r, facts: facts) }
  )
}

fn declaration_refs_in_corpus(pool_roots: List<String>) -> List<DeclarationRef> {
  declaration_refs_in_corpus(pool_roots: pool_roots)
}
