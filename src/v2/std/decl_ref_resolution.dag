module v2.std.decl_ref_resolution


data decl_ref_resolution_authority_note: String = "G1 cited-symbol resolution (feature:cited-symbol-resolution): every typed DeclarationRef resolves to exactly one declaration_identity in decl_facts over a declared module, or refuses with one of five typed arms — module absent, declaration absent, field absent, ambiguous, or resolved. Qualified-name join uses logical_qualified_name_from_module — the same strip-v2. rule as decl_facts rows. Module membership reads module_declaration_facts — the containment-tree module census, not text scan. Ambiguity is its own arm: two or more decl_facts rows for one logical qualified name returns DeclarationRefAmbiguous with every candidate identity BEFORE any fact.node field walk — bounded refusal by construction, never a divergent chase. Witness modules must not name a test fn identically to an imported resolver helper (bare-name shadowing recurses to call depth, not an ambiguous corpus row). dissolve-on: substrate construction refuses unresolvable DeclarationRef literals at definition sites; this module remains the runtime resolution authority for lens walks."

type DeclarationIdentity {
  qualified_name: String
  name: String
  rel_path: String
  kind: v2.std.decl_index.ItemKind
}

type DeclarationRefResolution
  = DeclarationRefResolved { declaration_identity: DeclarationIdentity }
  | DeclarationRefModuleAbsent { reference: std.decl_ref.DeclarationRef }
  | DeclarationRefDeclarationAbsent { reference: std.decl_ref.DeclarationRef }
  | DeclarationRefFieldAbsent { reference: std.decl_ref.DeclarationRef }
  | DeclarationRefAmbiguous { reference: std.decl_ref.DeclarationRef, candidates: List<DeclarationIdentity> }

fn declaration_identity_from_fact(fact: v2.std.decl_index.DeclFact) -> DeclarationIdentity {
  DeclarationIdentity {
    qualified_name: fact.qualified_name,
    name: fact.name,
    rel_path: fact.rel_path,
    kind: fact.kind
  }
}

fn declaration_ref_target_qualified_name(ref: std.decl_ref.DeclarationRef) -> String {
  v2.std.decl_index.logical_qualified_name_from_module(
    module_name: ref.module_path as String,
    name: ref.decl_name as String
  )
}

fn module_path_declared(module_path: String, modules: List<v2.lens.module_graph.ModuleDeclarationFact>) -> Bool {
  any(xs: modules, predicate: fn(m) { m.module == module_path })
}


fn declaration_identities_from_facts(facts: List<v2.std.decl_index.DeclFact>) -> List<DeclarationIdentity> {
  list_map(xs: facts, f: fn(fact) { declaration_identity_from_fact(fact: fact) })
}

fn decl_ref_named_field_present(ref: std.decl_ref.DeclarationRef, fact: v2.std.decl_index.DeclFact) -> Bool {
  match ref.field {
    std.decl_ref.WholeDeclaration => true
    std.decl_ref.NamedField { field_name: f } =>
      any(
        xs: node_labeled_child_edges(node: fact.node),
        predicate: fn(e) { named_edge_sort_key(e: e) == f as String }
      )
  }
}

fn resolve_declaration_ref(
  ref: std.decl_ref.DeclarationRef,
  facts: List<v2.std.decl_index.DeclFact>,
  modules: List<v2.lens.module_graph.ModuleDeclarationFact>
) -> DeclarationRefResolution {
  if !module_path_declared(module_path: ref.module_path as String, modules: modules) {
    DeclarationRefModuleAbsent { reference: ref }
  } else {
    let matches = v2.std.decl_facts_skeleton.decl_facts_matching_qualified_name(
      qn: declaration_ref_target_qualified_name(ref: ref),
      facts: facts
    )
    let n = length(xs: matches)
    if n == 0 {
      DeclarationRefDeclarationAbsent { reference: ref }
    } else if n > 1 {
      DeclarationRefAmbiguous {
        reference: ref,
        candidates: declaration_identities_from_facts(facts: matches)
      }
    } else {
      match list_head(xs: matches) {
        HeadAbsent => DeclarationRefDeclarationAbsent { reference: ref }
        HeadFound { value: sole } =>
          if decl_ref_named_field_present(ref: ref, fact: sole) {
            DeclarationRefResolved {
              declaration_identity: declaration_identity_from_fact(fact: sole)
            }
          } else {
            DeclarationRefFieldAbsent { reference: ref }
          }
      }
    }
  }
}

fn declaration_ref_resolves(
  ref: std.decl_ref.DeclarationRef,
  facts: List<v2.std.decl_index.DeclFact>,
  modules: List<v2.lens.module_graph.ModuleDeclarationFact>
) -> Bool {
  match resolve_declaration_ref(ref: ref, facts: facts, modules: modules) {
    DeclarationRefResolved { declaration_identity: _ } => true
    DeclarationRefModuleAbsent { reference: _ } => false
    DeclarationRefDeclarationAbsent { reference: _ } => false
    DeclarationRefFieldAbsent { reference: _ } => false
    DeclarationRefAmbiguous { reference: _, candidates: _ } => false
  }
}

fn cited_declaration_ref_refusal_count(
  refs: List<std.decl_ref.DeclarationRef>,
  facts: List<v2.std.decl_index.DeclFact>,
  modules: List<v2.lens.module_graph.ModuleDeclarationFact>
) -> Int {
  count_where(
    xs: refs,
    predicate: fn(r) { !declaration_ref_resolves(ref: r, facts: facts, modules: modules) }
  )
}

type DeclarationRefResolutionCensus {
  resolved_count: Int
  module_absent_count: Int
  declaration_absent_count: Int
  field_absent_count: Int
  ambiguous_count: Int
}

fn declaration_ref_resolution_census(
  refs: List<std.decl_ref.DeclarationRef>,
  facts: List<v2.std.decl_index.DeclFact>,
  modules: List<v2.lens.module_graph.ModuleDeclarationFact>
) -> DeclarationRefResolutionCensus {
  fold(
    refs,
    init: DeclarationRefResolutionCensus {
      resolved_count: 0,
      module_absent_count: 0,
      declaration_absent_count: 0,
      field_absent_count: 0,
      ambiguous_count: 0
    },
    f: fn(acc, ref) {
      match resolve_declaration_ref(ref: ref, facts: facts, modules: modules) {
        DeclarationRefResolved { declaration_identity: _ } =>
          DeclarationRefResolutionCensus {
            resolved_count: acc.resolved_count + 1,
            module_absent_count: acc.module_absent_count,
            declaration_absent_count: acc.declaration_absent_count,
            field_absent_count: acc.field_absent_count,
            ambiguous_count: acc.ambiguous_count
          }
        DeclarationRefModuleAbsent { reference: _ } =>
          DeclarationRefResolutionCensus {
            resolved_count: acc.resolved_count,
            module_absent_count: acc.module_absent_count + 1,
            declaration_absent_count: acc.declaration_absent_count,
            field_absent_count: acc.field_absent_count,
            ambiguous_count: acc.ambiguous_count
          }
        DeclarationRefDeclarationAbsent { reference: _ } =>
          DeclarationRefResolutionCensus {
            resolved_count: acc.resolved_count,
            module_absent_count: acc.module_absent_count,
            declaration_absent_count: acc.declaration_absent_count + 1,
            field_absent_count: acc.field_absent_count,
            ambiguous_count: acc.ambiguous_count
          }
        DeclarationRefFieldAbsent { reference: _ } =>
          DeclarationRefResolutionCensus {
            resolved_count: acc.resolved_count,
            module_absent_count: acc.module_absent_count,
            declaration_absent_count: acc.declaration_absent_count,
            field_absent_count: acc.field_absent_count + 1,
            ambiguous_count: acc.ambiguous_count
          }
        DeclarationRefAmbiguous { reference: _, candidates: _ } =>
          DeclarationRefResolutionCensus {
            resolved_count: acc.resolved_count,
            module_absent_count: acc.module_absent_count,
            declaration_absent_count: acc.declaration_absent_count,
            field_absent_count: acc.field_absent_count,
            ambiguous_count: acc.ambiguous_count + 1
          }
      }
    }
  )
}
