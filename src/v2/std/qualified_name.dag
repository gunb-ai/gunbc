module v2.std.qualified_name


type QualifiedName = std.algebra.FreeMonoid<v2.std.node.Symbol>

type QnFoldStatus
  = QnFoldInit
  | QnFoldHeadSeen { sym: v2.std.node.Symbol }
  | QnFoldTailSeen { tail: QualifiedName }
  | QnFoldDone { qn: QualifiedName }
  | QnFoldError { diag: v2.std.diagnostic.Diagnostic }

fn qn_fold_init(n: v2.std.node.Node) -> QnFoldStatus {
  match n.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      if count(n.children) == 0 {
        QnFoldDone { qn: std.algebra.Empty }
      } else if count(n.children) == 2 {
        QnFoldInit
      } else {
        QnFoldError { diag: v2.std.diagnostic.Diagnostic {
          reason: ^qualified_name_structure_invalid,
          at: v2.std.diagnostic.node_locus(node: n),
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
        }}
      }
    v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: sym } } =>
      if count(n.children) == 0 {
        QnFoldDone { qn: std.algebra.Cons { head: sym, tail: std.algebra.Empty } }
      } else {
        QnFoldError { diag: v2.std.diagnostic.Diagnostic {
          reason: ^qualified_name_structure_invalid,
          at: v2.std.diagnostic.node_locus(node: n),
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
        }}
      }
    _ =>
      QnFoldError { diag: v2.std.diagnostic.Diagnostic {
        reason: ^qualified_name_structure_invalid,
        at: v2.std.diagnostic.node_locus(node: n),
        correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
      }}
  }
}

fn qn_fold_step(acc: QnFoldStatus, edge: v2.std.node.Edge, child: QnFoldStatus) -> QnFoldStatus {
  match acc {
    QnFoldError { diag: d } => QnFoldError { diag: d }
    _ =>
      match child {
        QnFoldError { diag: d } => QnFoldError { diag: d }
        QnFoldDone { qn: child_qn } =>
          match edge.label {
            v2.std.node.Named { name: ename } =>
              if ename == ^fold_list_node_head {
                match edge.target.kind {
                  v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: _ } } =>
                    match child_qn {
                      std.algebra.Cons { head: sym, tail: child_tail } =>
                        match v2.std.algebra.list_head(xs: child_tail) {
                          v2.std.algebra.HeadAbsent =>
                            match acc {
                              QnFoldInit => QnFoldHeadSeen { sym: sym }
                              QnFoldTailSeen { tail: tail_qn } => QnFoldDone { qn: std.algebra.Cons { head: sym, tail: tail_qn } }
                              _ => QnFoldError { diag: v2.std.diagnostic.Diagnostic {
                                reason: ^qualified_name_structure_invalid,
                                at: v2.std.diagnostic.node_locus(node: edge.target),
                                correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
                              }}
                            }
                          v2.std.algebra.HeadFound { value: _ } => QnFoldError { diag: v2.std.diagnostic.Diagnostic {
                            reason: ^qualified_name_structure_invalid,
                            at: v2.std.diagnostic.node_locus(node: edge.target),
                            correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
                          }}
                        }
                      _ => QnFoldError { diag: v2.std.diagnostic.Diagnostic {
                        reason: ^qualified_name_structure_invalid,
                        at: v2.std.diagnostic.node_locus(node: edge.target),
                        correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
                      }}
                    }
                  _ => QnFoldError { diag: v2.std.diagnostic.Diagnostic {
                    reason: ^qualified_name_structure_invalid,
                    at: v2.std.diagnostic.node_locus(node: edge.target),
                    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
                  }}
                }
              } else if ename == ^fold_list_node_tail {
                match edge.target.kind {
                  v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
                    match acc {
                      QnFoldInit => QnFoldTailSeen { tail: child_qn }
                      QnFoldHeadSeen { sym: sym } => QnFoldDone { qn: std.algebra.Cons { head: sym, tail: child_qn } }
                      _ => QnFoldError { diag: v2.std.diagnostic.Diagnostic {
                        reason: ^qualified_name_structure_invalid,
                        at: v2.std.diagnostic.node_locus(node: edge.target),
                        correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
                      }}
                    }
                  _ => QnFoldError { diag: v2.std.diagnostic.Diagnostic {
                    reason: ^qualified_name_structure_invalid,
                    at: v2.std.diagnostic.node_locus(node: edge.target),
                    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
                  }}
                }
              } else {
                QnFoldError { diag: v2.std.diagnostic.Diagnostic {
                  reason: ^qualified_name_structure_invalid,
                  at: v2.std.diagnostic.node_locus(node: edge.target),
                  correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
                }}
              }
            _ => QnFoldError { diag: v2.std.diagnostic.Diagnostic {
              reason: ^qualified_name_structure_invalid,
              at: v2.std.diagnostic.node_locus(node: edge.target),
              correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
            }}
          }
        _ => QnFoldError { diag: v2.std.diagnostic.Diagnostic {
          reason: ^qualified_name_structure_invalid,
          at: v2.std.diagnostic.node_locus(node: edge.target),
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
        }}
      }
  }
}

fn qualified_name_from_string_segments(segments: List<String>) -> std.algebra.FreeMonoid<v2.std.node.Symbol> {
  v2.std.algebra.fold_list_right(
    xs: segments,
    empty: std.algebra.Empty,
    snoc: fn(tail, segment) {
      std.algebra.Cons { head: v2.std.compilers.lexing.symbol_intern_lexeme(lexeme: segment), tail: tail }
    }
  )
}

fn qualified_name_from_dotted_string(dotted: String) -> std.algebra.FreeMonoid<v2.std.node.Symbol> {
  if v2.std.text.string_is_empty(s: dotted) {
    std.algebra.Empty
  } else {
    qualified_name_from_string_segments(segments: dotted.split(delimiter: "."))
  }
}

data qualified_name_from_dotted_string_host_disposition: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.RealizationDispatch,
  bind: std.decl_ref.DeclarationRef {
    module_path: "v2.std.qualified_name",
    decl_name: "qualified_name_from_dotted_string",
    field: std.decl_ref.WholeDeclaration
  }
}

fn qualified_name_to_dotted_string(qn: QualifiedName) -> String {
  match qn {
    std.algebra.Empty => ""
    std.algebra.Cons { head: sym, tail: rest } =>
      let segment = v2.std.compilers.lexing.symbol_lexeme(sym: sym)
      if v2.std.algebra.is_empty(xs: rest) {
        segment
      } else {
        concat(segment, ".", qualified_name_to_dotted_string(qn: rest))
      }
  }
}

fn qualified_name_init(qn: QualifiedName) -> QualifiedName {
  v2.std.algebra.list_init(xs: qn)
}

fn qualified_name_last_segment(qn: QualifiedName) -> v2.std.optional.Optional<v2.std.node.Symbol> {
  match qn {
    std.algebra.Empty => v2.std.optional.optional_absent()
    std.algebra.Cons { head: h, tail: t } =>
      if v2.std.algebra.is_empty(xs: t) {
        v2.std.optional.optional_present(value: h)
      } else {
        qualified_name_last_segment(qn: t)
      }
  }
}

fn qualified_name_snoc(qn: QualifiedName, segment: v2.std.node.Symbol) -> QualifiedName {
  v2.std.algebra.list_snoc_item(xs: qn, item: segment)
}

fn qualified_name_from_node(root: v2.std.node.Node) -> v2.std.diagnostic.Outcome<QualifiedName> {
  match root.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      let acc = v2.std.node.fold_node(n: root, algebra: v2.std.node.NodeFold { init: qn_fold_init, step: qn_fold_step })
      match acc {
        QnFoldDone { qn: qn } => v2.std.diagnostic.outcome_accepted(value: qn)
        QnFoldError { diag: d } => v2.std.diagnostic.outcome_rejected(d: d)
        _ => v2.std.diagnostic.outcome_rejected(d: v2.std.diagnostic.Diagnostic {
          reason: ^qualified_name_structure_invalid,
          at: v2.std.diagnostic.node_locus(node: root),
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
        })
      }
    _ => v2.std.diagnostic.outcome_rejected(d: v2.std.diagnostic.Diagnostic {
      reason: ^qualified_name_structure_invalid,
      at: v2.std.diagnostic.node_locus(node: root),
      correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
    })
  }
}
