module v2.std.qualified_name

import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Rejected,
  Unavailable,
  node_locus,
  outcome_accepted,
  outcome_rejected
}
import std.algebra { Cons, Empty, FreeMonoid }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.disposition { Disposition, Scaffold, RealizationDispatch }
import v2.std.algebra { HeadAbsent, HeadFound, fold_list_right, is_empty, list_head, list_init, list_snoc_item }
import v2.std.collection {
  List
}
import v2.std.optional {
  Absent,
  Optional,
  Present,
  optional_absent,
  optional_present
}
import v2.std.compilers.lexing { symbol_intern_lexeme, symbol_lexeme }
import v2.std.logic { Bool }
import v2.std.node { Atom, Conj, Edge, EdgeLabel, Named, Node, NodeFold, Positional, Symbol, TypeNode, fold_node }
import v2.std.text { String }

type QualifiedName = FreeMonoid<Symbol>

type QnFoldStatus
  = QnFoldInit
  | QnFoldHeadSeen { sym: Symbol }
  | QnFoldTailSeen { tail: QualifiedName }
  | QnFoldDone { qn: QualifiedName }
  | QnFoldError { diag: Diagnostic }

fn qn_fold_init(n: Node) -> QnFoldStatus {
  match n.kind {
    TypeNode { connective: Conj } =>
      if count(n.children) == 0 {
        QnFoldDone { qn: Empty }
      } else if count(n.children) == 2 {
        QnFoldInit
      } else {
        QnFoldError { diag: Diagnostic {
          reason: ^qualified_name_structure_invalid,
          at: node_locus(node: n),
          correction: Unavailable { reason: ExternalContractUnknown }
        }}
      }
    TypeNode { connective: Atom { identity: sym } } =>
      if count(n.children) == 0 {
        QnFoldDone { qn: Cons { head: sym, tail: Empty } }
      } else {
        QnFoldError { diag: Diagnostic {
          reason: ^qualified_name_structure_invalid,
          at: node_locus(node: n),
          correction: Unavailable { reason: ExternalContractUnknown }
        }}
      }
    _ =>
      QnFoldError { diag: Diagnostic {
        reason: ^qualified_name_structure_invalid,
        at: node_locus(node: n),
        correction: Unavailable { reason: ExternalContractUnknown }
      }}
  }
}

// THE SPINE LABEL SET, SPELLED ONCE. qn_fold_step consumes the role to choose its arm and
// qualified_name_spine_shape_present consumes it to gate; neither names ^fold_list_node_head
// or ^fold_list_node_tail itself (review 67072 on gunbc#11461: the gate had re-spelled the
// set the fold owns, so a renamed or added spine label would have narrowed acceptance silently).
type QnSpineRole
  = QnSpineHead
  | QnSpineTail
  | QnNotSpine

fn qn_spine_role(label: EdgeLabel) -> QnSpineRole {
  match label {
    Named { name: sym } =>
      if sym == ^fold_list_node_head {
        QnSpineHead
      } else if sym == ^fold_list_node_tail {
        QnSpineTail
      } else {
        QnNotSpine
      }
    Positional => QnNotSpine
  }
}

fn qn_fold_step(acc: QnFoldStatus, edge: Edge, child: QnFoldStatus) -> QnFoldStatus {
  match acc {
    QnFoldError { diag: d } => QnFoldError { diag: d }
    _ =>
      match child {
        QnFoldError { diag: d } => QnFoldError { diag: d }
        QnFoldDone { qn: child_qn } =>
          match qn_spine_role(label: edge.label) {
            QnSpineHead =>
                match edge.target.kind {
                  TypeNode { connective: Atom { identity: _ } } =>
                    match child_qn {
                      Cons { head: sym, tail: child_tail } =>
                        match list_head(xs: child_tail) {
                          HeadAbsent =>
                            match acc {
                              QnFoldInit => QnFoldHeadSeen { sym: sym }
                              QnFoldTailSeen { tail: tail_qn } => QnFoldDone { qn: Cons { head: sym, tail: tail_qn } }
                              _ => QnFoldError { diag: Diagnostic {
                                reason: ^qualified_name_structure_invalid,
                                at: node_locus(node: edge.target),
                                correction: Unavailable { reason: ExternalContractUnknown }
                              }}
                            }
                          HeadFound { value: _ } => QnFoldError { diag: Diagnostic {
                            reason: ^qualified_name_structure_invalid,
                            at: node_locus(node: edge.target),
                            correction: Unavailable { reason: ExternalContractUnknown }
                          }}
                        }
                      _ => QnFoldError { diag: Diagnostic {
                        reason: ^qualified_name_structure_invalid,
                        at: node_locus(node: edge.target),
                        correction: Unavailable { reason: ExternalContractUnknown }
                      }}
                    }
                  _ => QnFoldError { diag: Diagnostic {
                    reason: ^qualified_name_structure_invalid,
                    at: node_locus(node: edge.target),
                    correction: Unavailable { reason: ExternalContractUnknown }
                  }}
                }
            QnSpineTail =>
                match edge.target.kind {
                  TypeNode { connective: Conj } =>
                    match acc {
                      QnFoldInit => QnFoldTailSeen { tail: child_qn }
                      QnFoldHeadSeen { sym: sym } => QnFoldDone { qn: Cons { head: sym, tail: child_qn } }
                      _ => QnFoldError { diag: Diagnostic {
                        reason: ^qualified_name_structure_invalid,
                        at: node_locus(node: edge.target),
                        correction: Unavailable { reason: ExternalContractUnknown }
                      }}
                    }
                  _ => QnFoldError { diag: Diagnostic {
                    reason: ^qualified_name_structure_invalid,
                    at: node_locus(node: edge.target),
                    correction: Unavailable { reason: ExternalContractUnknown }
                  }}
                }
            QnNotSpine => QnFoldError { diag: Diagnostic {
              reason: ^qualified_name_structure_invalid,
              at: node_locus(node: edge.target),
              correction: Unavailable { reason: ExternalContractUnknown }
            }}
          }
        _ => QnFoldError { diag: Diagnostic {
          reason: ^qualified_name_structure_invalid,
          at: node_locus(node: edge.target),
          correction: Unavailable { reason: ExternalContractUnknown }
        }}
      }
  }
}

fn qualified_name_from_string_segments(segments: List<String>) -> FreeMonoid<Symbol> {
  fold_list_right(
    xs: segments,
    empty: Empty,
    snoc: fn(tail, segment) {
      Cons { head: symbol_intern_lexeme(lexeme: segment), tail: tail }
    }
  )
}

fn qualified_name_from_dotted_string(dotted: String) -> FreeMonoid<Symbol> {
  if string_length(s: dotted) == 0 {
    Empty
  } else {
    qualified_name_from_string_segments(segments: dotted.split(delimiter: "."))
  }
}

data qualified_name_from_dotted_string_host_disposition: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "v2.std.qualified_name",
    decl_name: "qualified_name_from_dotted_string",
    field: WholeDeclaration
  }
}

fn qualified_name_to_dotted_string(qn: QualifiedName) -> String {
  match qn {
    Empty => ""
    Cons { head: sym, tail: rest } =>
      let segment = symbol_lexeme(sym: sym)
      if is_empty(xs: rest) {
        segment
      } else {
        concat(segment, ".", qualified_name_to_dotted_string(qn: rest))
      }
  }
}

fn qualified_name_init(qn: QualifiedName) -> QualifiedName {
  list_init(xs: qn)
}

fn qualified_name_last_segment(qn: QualifiedName) -> Optional<Symbol> {
  match qn {
    Empty => optional_absent()
    Cons { head: h, tail: t } =>
      if is_empty(xs: t) {
        optional_present(value: h)
      } else {
        qualified_name_last_segment(qn: t)
      }
  }
}

fn qualified_name_snoc(qn: QualifiedName, segment: Symbol) -> QualifiedName {
  list_snoc_item(xs: qn, item: segment)
}

// THE O(1) SHAPE GATE LIVES INSIDE THE FOLD'S OWN ENTRY, NOT BESIDE IT. fold_node is a
// bottom-up catamorphism with no pruning, so a walker that folded every Conj re-folded every
// subtree it then descended into. The gate is the fold's first step so that no second surface
// re-spells which labels form the spine, and it is VERDICT-PRESERVING: the acceptance set of
// qualified_name_from_node is exactly what qn_fold_init / qn_fold_step already accepted -
// a zero-child Conj is the empty name, a two-child head/tail Conj is folded, and every other
// root is refused - only the refusal now happens before any child is folded.
fn qualified_name_spine_shape_present(root: Node) -> Bool {
  match root.kind {
    TypeNode { connective: Conj } =>
      if count(root.children) == 2 {
        fold(root.children, init: true, f: fn(acc, edge) {
          acc && (match qn_spine_role(label: edge.label) {
            QnNotSpine => false
            _ => true
          })
        })
      } else {
        false
      }
    _ => false
  }
}

fn qualified_name_from_node(root: Node) -> Outcome<QualifiedName> {
  match root.kind {
    TypeNode { connective: Conj } =>
      if count(root.children) == 0 {
        outcome_accepted(value: Empty)
      } else if qualified_name_spine_shape_present(root: root) {
        let acc = fold_node(n: root, algebra: NodeFold { init: qn_fold_init, step: qn_fold_step })
        match acc {
          QnFoldDone { qn: qn } => outcome_accepted(value: qn)
          QnFoldError { diag: d } => outcome_rejected(d: d)
          _ => outcome_rejected(d: Diagnostic {
            reason: ^qualified_name_structure_invalid,
            at: node_locus(node: root),
            correction: Unavailable { reason: ExternalContractUnknown }
          })
        }
      } else {
        outcome_rejected(d: Diagnostic {
          reason: ^qualified_name_structure_invalid,
          at: node_locus(node: root),
          correction: Unavailable { reason: ExternalContractUnknown }
        })
      }
    _ => outcome_rejected(d: Diagnostic {
      reason: ^qualified_name_structure_invalid,
      at: node_locus(node: root),
      correction: Unavailable { reason: ExternalContractUnknown }
    })
  }
}
