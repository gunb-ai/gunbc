module v2.std.qualified_name

import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Rejected,
  Unavailable,
  node_locus,
  outcome_accepted,
  outcome_rejected
}
import std.algebra { Cons, Empty, FreeMonoid }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.disposition { Disposition, Scaffold, RealizationDispatch }
import v2.std.algebra { HeadAbsent, HeadFound, fold_list_right, is_empty, is_prefix_of, list_head, list_init, list_snoc_item }
import v2.std.collection {
  List
}
import v2.std.optional {
  Absent,
  Optional,
  Present,
  optional_absent,
  optional_present
}
import v2.std.compilers.lexing { symbol_intern_lexeme, symbol_lexeme }
import v2.std.logic { Bool }
import v2.std.node { Atom, Conj, Edge, Named, Node, NodeFold, Symbol, TypeNode, fold_node }
import v2.std.text { String, string_is_empty }

type QualifiedName = FreeMonoid<Symbol>

type QnFoldStatus
  = QnFoldInit
  | QnFoldHeadSeen { sym: Symbol }
  | QnFoldTailSeen { tail: QualifiedName }
  | QnFoldDone { qn: QualifiedName }
  | QnFoldError { diag: Diagnostic }

fn qn_fold_init(n: Node) -> QnFoldStatus {
  match n.kind {
    TypeNode { connective: Conj } =>
      if count(n.children) == 0 {
        QnFoldDone { qn: Empty }
      } else if count(n.children) == 2 {
        QnFoldInit
      } else {
        QnFoldError { diag: Diagnostic {
          reason: ^qualified_name_structure_invalid,
          at: node_locus(node: n),
          correction: Unavailable { reason: ExternalContractUnknown }
        }}
      }
    TypeNode { connective: Atom { identity: sym } } =>
      if count(n.children) == 0 {
        QnFoldDone { qn: Cons { head: sym, tail: Empty } }
      } else {
        QnFoldError { diag: Diagnostic {
          reason: ^qualified_name_structure_invalid,
          at: node_locus(node: n),
          correction: Unavailable { reason: ExternalContractUnknown }
        }}
      }
    _ =>
      QnFoldError { diag: Diagnostic {
        reason: ^qualified_name_structure_invalid,
        at: node_locus(node: n),
        correction: Unavailable { reason: ExternalContractUnknown }
      }}
  }
}

fn qn_fold_step(acc: QnFoldStatus, edge: Edge, child: QnFoldStatus) -> QnFoldStatus {
  match acc {
    QnFoldError { diag: d } => QnFoldError { diag: d }
    _ =>
      match child {
        QnFoldError { diag: d } => QnFoldError { diag: d }
        QnFoldDone { qn: child_qn } =>
          match edge.label {
            Named { name: ename } =>
              if ename == ^fold_list_node_head {
                match edge.target.kind {
                  TypeNode { connective: Atom { identity: _ } } =>
                    match child_qn {
                      Cons { head: sym, tail: child_tail } =>
                        match list_head(xs: child_tail) {
                          HeadAbsent =>
                            match acc {
                              QnFoldInit => QnFoldHeadSeen { sym: sym }
                              QnFoldTailSeen { tail: tail_qn } => QnFoldDone { qn: Cons { head: sym, tail: tail_qn } }
                              _ => QnFoldError { diag: Diagnostic {
                                reason: ^qualified_name_structure_invalid,
                                at: node_locus(node: edge.target),
                                correction: Unavailable { reason: ExternalContractUnknown }
                              }}
                            }
                          HeadFound { value: _ } => QnFoldError { diag: Diagnostic {
                            reason: ^qualified_name_structure_invalid,
                            at: node_locus(node: edge.target),
                            correction: Unavailable { reason: ExternalContractUnknown }
                          }}
                        }
                      _ => QnFoldError { diag: Diagnostic {
                        reason: ^qualified_name_structure_invalid,
                        at: node_locus(node: edge.target),
                        correction: Unavailable { reason: ExternalContractUnknown }
                      }}
                    }
                  _ => QnFoldError { diag: Diagnostic {
                    reason: ^qualified_name_structure_invalid,
                    at: node_locus(node: edge.target),
                    correction: Unavailable { reason: ExternalContractUnknown }
                  }}
                }
              } else if ename == ^fold_list_node_tail {
                match edge.target.kind {
                  TypeNode { connective: Conj } =>
                    match acc {
                      QnFoldInit => QnFoldTailSeen { tail: child_qn }
                      QnFoldHeadSeen { sym: sym } => QnFoldDone { qn: Cons { head: sym, tail: child_qn } }
                      _ => QnFoldError { diag: Diagnostic {
                        reason: ^qualified_name_structure_invalid,
                        at: node_locus(node: edge.target),
                        correction: Unavailable { reason: ExternalContractUnknown }
                      }}
                    }
                  _ => QnFoldError { diag: Diagnostic {
                    reason: ^qualified_name_structure_invalid,
                    at: node_locus(node: edge.target),
                    correction: Unavailable { reason: ExternalContractUnknown }
                  }}
                }
              } else {
                QnFoldError { diag: Diagnostic {
                  reason: ^qualified_name_structure_invalid,
                  at: node_locus(node: edge.target),
                  correction: Unavailable { reason: ExternalContractUnknown }
                }}
              }
            _ => QnFoldError { diag: Diagnostic {
              reason: ^qualified_name_structure_invalid,
              at: node_locus(node: edge.target),
              correction: Unavailable { reason: ExternalContractUnknown }
            }}
          }
        _ => QnFoldError { diag: Diagnostic {
          reason: ^qualified_name_structure_invalid,
          at: node_locus(node: edge.target),
          correction: Unavailable { reason: ExternalContractUnknown }
        }}
      }
  }
}

fn qualified_name_from_string_segments(segments: List<String>) -> FreeMonoid<Symbol> {
  fold_list_right(
    xs: segments,
    empty: Empty,
    snoc: fn(tail, segment) {
      Cons { head: symbol_intern_lexeme(lexeme: segment), tail: tail }
    }
  )
}

fn qualified_name_from_dotted_string(dotted: String) -> FreeMonoid<Symbol> {
  if string_is_empty(s: dotted) {
    Empty
  } else {
    qualified_name_from_string_segments(segments: dotted.split(delimiter: "."))
  }
}

data qualified_name_from_dotted_string_host_disposition: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "v2.std.qualified_name",
    decl_name: "qualified_name_from_dotted_string",
    field: WholeDeclaration
  }
}

fn qualified_name_to_dotted_string(qn: QualifiedName) -> String {
  match qn {
    Empty => ""
    Cons { head: sym, tail: rest } =>
      let segment = symbol_lexeme(sym: sym)
      if is_empty(xs: rest) {
        segment
      } else {
        concat(segment, ".", qualified_name_to_dotted_string(qn: rest))
      }
  }
}

fn qualified_name_init(qn: QualifiedName) -> QualifiedName {
  list_init(xs: qn)
}

fn qualified_name_last_segment(qn: QualifiedName) -> Optional<Symbol> {
  match qn {
    Empty => optional_absent()
    Cons { head: h, tail: t } =>
      if is_empty(xs: t) {
        optional_present(value: h)
      } else {
        qualified_name_last_segment(qn: t)
      }
  }
}

// STRICT DESCENT UNDER A NAMESPACE CONTAINER, as a RELATION and deliberately not as an enumeration.
//
// A module is a containment subtree and the path-module binding is derived at parse, so whether one
// qualified name lies beneath another is a fact about NAMES and is decided here, at the authority
// that owns QualifiedName -- not at a storage index, which would couple a naming question to one
// realization of where modules are kept.
//
// WHY A RELATION AND NOT A LIST OF MEMBERS. Every caller that could ask "which modules are under X"
// already holds the finite population -- the index is supplied to it, not discovered by it -- so the
// only fact missing at the namespace layer is the containment decision. Returning a sequence would
// hand every consumer a realization order for free, and index order is exactly the positional
// history a consumer must NOT reconstruct: ordering has to be grounded independently, by a
// row-owned ordinal or equivalent. A comment asking consumers to ignore an exported order is the
// defect restated, so no order is exported. The consumer folds its own population and applies its
// own ordering, and this answers member-or-not.
//
// SEGMENT-WISE, NOT TEXTUAL: `gunbc.rowing` is not under `gunbc.row`, because containment is a
// relation on SEGMENTS and a dotted string is a rendering of them.
//
// STRICT: a name is a prefix of itself, and a container is not beneath itself. The neighbouring
// question -- whether a given module is present at all -- is exact-identity membership and is
// answered elsewhere; this is descent, and the two are disjoint rather than one refining the other.
fn qualified_name_is_strict_descendant(
  container: QualifiedName,
  candidate: QualifiedName
) -> Bool {
  is_prefix_of(prefix: container, xs: candidate, eq: fn(a, b) { a == b })
    && candidate != container
}

fn qualified_name_snoc(qn: QualifiedName, segment: Symbol) -> QualifiedName {
  list_snoc_item(xs: qn, item: segment)
}

fn qualified_name_from_node(root: Node) -> Outcome<QualifiedName> {
  match root.kind {
    TypeNode { connective: Conj } =>
      let acc = fold_node(n: root, algebra: NodeFold { init: qn_fold_init, step: qn_fold_step })
      match acc {
        QnFoldDone { qn: qn } => outcome_accepted(value: qn)
        QnFoldError { diag: d } => outcome_rejected(d: d)
        _ => outcome_rejected(d: Diagnostic {
          reason: ^qualified_name_structure_invalid,
          at: node_locus(node: root),
          correction: Unavailable { reason: ExternalContractUnknown }
        })
      }
    _ => outcome_rejected(d: Diagnostic {
      reason: ^qualified_name_structure_invalid,
      at: node_locus(node: root),
      correction: Unavailable { reason: ExternalContractUnknown }
    })
  }
}
