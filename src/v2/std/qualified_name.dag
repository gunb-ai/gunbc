module v2.std.qualified_name

import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Rejected,
  Unavailable,
  node_locus,
  outcome_accepted,
  outcome_rejected
}
import v2.std.logic { Bool }
import v2.std.node { Atom, Conj, Edge, Named, Node, NodeFold, Symbol, TypeNode, fold_node }

type QualifiedName
  = QnEmpty
  | QnCons { head: Symbol, tail: QualifiedName }

fn qualified_name_singleton(sym: Symbol) -> QualifiedName {
  QnCons { head: sym, tail: QnEmpty }
}

fn qualified_name_eq(a: QualifiedName, b: QualifiedName) -> Bool {
  match a {
    QnEmpty => match b { QnEmpty => true  QnCons { head: _, tail: _ } => false }
    QnCons { head: ha, tail: ta } =>
      match b {
        QnEmpty => false
        QnCons { head: hb, tail: tb } => ha == hb && qualified_name_eq(a: ta, b: tb)
      }
  }
}

fn qualified_name_for_all(qn: QualifiedName, predicate: fn(Symbol) -> Bool) -> Bool {
  match qn {
    QnEmpty => true
    QnCons { head: h, tail: t } => predicate(h) && qualified_name_for_all(qn: t, predicate: predicate)
  }
}

type QnFoldStatus
  = QnFoldInit
  | QnFoldHeadSeen { sym: Symbol }
  | QnFoldTailSeen { tail: QualifiedName }
  | QnFoldDone { qn: QualifiedName }
  | QnFoldError { diag: Diagnostic }

fn qn_fold_init(n: Node) -> QnFoldStatus {
  match n.kind {
    TypeNode { connective: Conj } =>
      if count(n.children) == 0 {
        QnFoldDone { qn: QnEmpty }
      } else if count(n.children) == 2 {
        QnFoldInit
      } else {
        QnFoldError { diag: Diagnostic {
          reason: ^qualified_name_structure_invalid,
          at: node_locus(node: n),
          correction: Unavailable { reason: ExternalContractUnknown }
        }}
      }
    TypeNode { connective: Atom { identity: sym } } =>
      if count(n.children) == 0 {
        QnFoldDone { qn: QnCons { head: sym, tail: QnEmpty } }
      } else {
        QnFoldError { diag: Diagnostic {
          reason: ^qualified_name_structure_invalid,
          at: node_locus(node: n),
          correction: Unavailable { reason: ExternalContractUnknown }
        }}
      }
    _ =>
      QnFoldError { diag: Diagnostic {
        reason: ^qualified_name_structure_invalid,
        at: node_locus(node: n),
        correction: Unavailable { reason: ExternalContractUnknown }
      }}
  }
}

fn qn_fold_step(acc: QnFoldStatus, edge: Edge, child: QnFoldStatus) -> QnFoldStatus {
  match acc {
    QnFoldError { diag: d } => QnFoldError { diag: d }
    _ =>
      match child {
        QnFoldError { diag: d } => QnFoldError { diag: d }
        QnFoldDone { qn: child_qn } =>
          match edge.label {
            Named { name: ename } =>
              if ename == ^fold_list_node_head {
                match edge.target.kind {
                  TypeNode { connective: Atom { identity: _ } } =>
                    match child_qn {
                      QnCons { head: sym, tail: QnEmpty } =>
                        match acc {
                          QnFoldInit => QnFoldHeadSeen { sym: sym }
                          QnFoldTailSeen { tail: tail_qn } => QnFoldDone { qn: QnCons { head: sym, tail: tail_qn } }
                          _ => QnFoldError { diag: Diagnostic {
                            reason: ^qualified_name_structure_invalid,
                            at: node_locus(node: edge.target),
                            correction: Unavailable { reason: ExternalContractUnknown }
                          }}
                        }
                      _ => QnFoldError { diag: Diagnostic {
                        reason: ^qualified_name_structure_invalid,
                        at: node_locus(node: edge.target),
                        correction: Unavailable { reason: ExternalContractUnknown }
                      }}
                    }
                  _ => QnFoldError { diag: Diagnostic {
                    reason: ^qualified_name_structure_invalid,
                    at: node_locus(node: edge.target),
                    correction: Unavailable { reason: ExternalContractUnknown }
                  }}
                }
              } else if ename == ^fold_list_node_tail {
                match edge.target.kind {
                  TypeNode { connective: Conj } =>
                    match acc {
                      QnFoldInit => QnFoldTailSeen { tail: child_qn }
                      QnFoldHeadSeen { sym: sym } => QnFoldDone { qn: QnCons { head: sym, tail: child_qn } }
                      _ => QnFoldError { diag: Diagnostic {
                        reason: ^qualified_name_structure_invalid,
                        at: node_locus(node: edge.target),
                        correction: Unavailable { reason: ExternalContractUnknown }
                      }}
                    }
                  _ => QnFoldError { diag: Diagnostic {
                    reason: ^qualified_name_structure_invalid,
                    at: node_locus(node: edge.target),
                    correction: Unavailable { reason: ExternalContractUnknown }
                  }}
                }
              } else {
                QnFoldError { diag: Diagnostic {
                  reason: ^qualified_name_structure_invalid,
                  at: node_locus(node: edge.target),
                  correction: Unavailable { reason: ExternalContractUnknown }
                }}
              }
            _ => QnFoldError { diag: Diagnostic {
              reason: ^qualified_name_structure_invalid,
              at: node_locus(node: edge.target),
              correction: Unavailable { reason: ExternalContractUnknown }
            }}
          }
        _ => QnFoldError { diag: Diagnostic {
          reason: ^qualified_name_structure_invalid,
          at: node_locus(node: edge.target),
          correction: Unavailable { reason: ExternalContractUnknown }
        }}
      }
  }
}

fn qualified_name_from_dotted_string(dotted: String) -> QualifiedName {
  qualified_name_from_dotted_string(dotted: dotted)
}

fn qualified_name_from_node(root: Node) -> Outcome<QualifiedName> {
  match root.kind {
    TypeNode { connective: Conj } =>
      let acc = fold_node(n: root, algebra: NodeFold { init: qn_fold_init, step: qn_fold_step })
      match acc {
        QnFoldDone { qn: qn } => outcome_accepted(value: qn)
        QnFoldError { diag: d } => outcome_rejected(d: d)
        _ => outcome_rejected(d: Diagnostic {
          reason: ^qualified_name_structure_invalid,
          at: node_locus(node: root),
          correction: Unavailable { reason: ExternalContractUnknown }
        })
      }
    _ => outcome_rejected(d: Diagnostic {
      reason: ^qualified_name_structure_invalid,
      at: node_locus(node: root),
      correction: Unavailable { reason: ExternalContractUnknown }
    })
  }
}
