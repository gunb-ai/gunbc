module v2.std.optional

import std.types { Bool }

type Optional<T>
  = Absent
  | Present { value: T }

fn optional_absent<T>() -> Optional<T> {
  Absent
}

fn optional_present<T>(value: T) -> Optional<T> {
  Present { value: value }
}

// Whether an Optional holds a value. The one presence fold; a caller asks it rather than matching
// Present => true / Absent => false itself.
fn optional_is_present<T>(o: Optional<T>) -> Bool {
  match o {
    Present { value: _ } => true
    Absent => false
  }
}

fn optional_prefer_first_present<T>(left: Optional<T>, right: Optional<T>) -> Optional<T> {
  match left {
    Present { value: _ } => left
    Absent => right
  }
}
