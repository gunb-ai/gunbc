module v2.std.optional

type Optional<T>
  = Absent
  | Present { value: T }

fn optional_absent<T>() -> Optional<T> {
  Absent
}

fn optional_present<T>(value: T) -> Optional<T> {
  Present { value: value }
}

fn optional_prefer_first_present<T>(left: Optional<T>, right: Optional<T>) -> Optional<T> {
  match left {
    Present { value: _ } => left
    Absent => right
  }
}

data optional_axis_note: String = "Canonical query surface for Optional<T> (predicate-dissolution rule): classify through optional_axis once and match the tag — not a family of hand-rolled optional_is_present Bool predicates over the same coproduct."

type OptionalAxis<T>
  = OptionalAbsent
  | OptionalPresent { value: T }

fn optional_axis<T>(opt: Optional<T>) -> OptionalAxis<T> {
  match opt {
    Absent => OptionalAbsent
    Present { value: value } => OptionalPresent { value: value }
  }
}
