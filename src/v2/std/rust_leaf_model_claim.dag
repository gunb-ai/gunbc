module v2.std.rust_leaf_model_claim

import v2.std.grammar { GrammarProduction }
import v2.std.leaf_model_verification { TargetInvocation }
import v2.std.compilers.lexing { LexRule }
import v2.std.logic { Bool }
import v2.std.model_core { AlgebraInhabitanceDecl }
import v2.std.node { Node, Symbol }
import v2.std.runtime { RuntimeOutcome }

// Phase-1 primitive subject axis (extension via modeling escalation only).
// `{}` on single-arm coproducts only (v2 export); multi-arm nullary variants export bare (cf. verdict.dag Pass).
type RustPrimitive
  = RustPrimitiveI32 {}

type AlgebraCarrier
  = AlgebraCarrierOrderedRing {}

data rust_leaf_phase1_primitive_i32: RustPrimitive = RustPrimitiveI32 {}
data rust_leaf_phase1_algebra_carrier_ordered_ring: AlgebraCarrier = AlgebraCarrierOrderedRing {}

// 🟡 gated — feature:rust-leaf-model-claim-subject — bind docs/planning/v2-leaf-model-verification-2026-05-30.md §7 Phase-1 —
// dissolve-on-arrival: modeling-escalation-only extension arms beyond Phase-1 inventory; forbidden: worker-initiative coproduct growth.
type RustClaimSubject
  = RustPrimitiveTypeSubject { primitive: RustPrimitive }
  | RustAlgebraInhabitanceSubject { inhabitance_decl: AlgebraInhabitanceDecl }
  | RustAtomRealizationSubject { atom: Node }
  // 🟡 gated — feature:rust-atom-realization-form-phase1 — bind docs/planning/v2-leaf-model-verification-2026-05-30.md §7 R3-external —
  // dissolve-on-arrival: AtomRealizationForm coproduct replaces declared_type_form/exercised_value_form Symbol pair; forbidden: closed Symbol pairs without a bounded dissolution receipt on this sub-shape.
  | RustAtomRealizationProjectionMismatchSubject {
      atom: Node
      declared_type_form: Symbol
      exercised_value_form: Symbol
    }
  | RustCollectionRealizationSubject { collection: Node }
  | RustGrammarProductionSubject { production: GrammarProduction }
  | RustLexRuleSubject { rule: LexRule }

// 🟡 gated — feature:rustc-error-code-leaf-model-phase1 — bind docs/planning/v2-leaf-model-verification-2026-05-30.md Phase 2 —
// dissolve-on-arrival: full RustcErrorCode coproduct owned by rust.dag leaf-model authority; forbidden: string-keyed parallel error tables.
type Rustc_ErrorCode_Phase1
  = E0107
  | E0308
  | E0423
  | E0599

data rust_leaf_phase1_err_e0107: Rustc_ErrorCode_Phase1 = E0107
data rust_leaf_phase1_err_e0308: Rustc_ErrorCode_Phase1 = E0308
data rust_leaf_phase1_err_e0423: Rustc_ErrorCode_Phase1 = E0423
data rust_leaf_phase1_err_e0599: Rustc_ErrorCode_Phase1 = E0599

// 🟡 gated — feature:rust-leaf-model-claim-expectation — bind docs/planning/v2-leaf-model-verification-2026-05-30.md §7 Phase-1 —
// dissolve-on-arrival: modeling-escalation-only extension arms beyond Phase-1 inventory; forbidden: parallel expectation vocab outside this coproduct.
type RustClaimExpectation
  = RustcAcceptsExpectation { invocation_form: TargetInvocation }
  | RustcRejectsExpectation {
      invocation_form: TargetInvocation
      expected_error_code: Rustc_ErrorCode_Phase1
    }
  | RustRuntimeBehaviorExpectation {
      invocation_form: TargetInvocation
      expected_outcome: RuntimeOutcome
    }
  | RustEmitProjectionEqualityExpectation {
      atom_realization_row: Node
      type_emit_must_change: Bool
      value_emit_must_change: Bool
    }
  | RustGrammarRoundTripExpectation { production: GrammarProduction }
