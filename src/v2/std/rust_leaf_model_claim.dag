module v2.std.rust_leaf_model_claim


type RustPrimitive
  = RustPrimitiveI32 {}

type AlgebraCarrier
  = AlgebraCarrierOrderedRing {}

data rust_leaf_phase1_primitive_i32: RustPrimitive = RustPrimitiveI32 {}
data rust_leaf_phase1_algebra_carrier_ordered_ring: AlgebraCarrier = AlgebraCarrierOrderedRing {}

type RustClaimSubject
  = RustPrimitiveTypeSubject { primitive: RustPrimitive }
  | RustAlgebraInhabitanceSubject { inhabitance_decl: v2.std.model_core.AlgebraInhabitanceDecl }
  | RustAtomRealizationSubject { atom: v2.std.node.Node }

  | RustAtomRealizationProjectionMismatchSubject {
      atom: v2.std.node.Node
      declared_type_form: v2.std.node.Symbol
      exercised_value_form: v2.std.node.Symbol
    }
  | RustCollectionRealizationSubject { collection: v2.std.node.Node }
  | RustGrammarProductionSubject { production: v2.std.grammar.GrammarProduction }
  | RustLexRuleSubject { rule: v2.std.compilers.lexing.LexRule }

type Rustc_ErrorCode_Phase1
  = E0107
  | E0308
  | E0423
  | E0599

data rust_leaf_phase1_err_e0107: Rustc_ErrorCode_Phase1 = E0107
data rust_leaf_phase1_err_e0308: Rustc_ErrorCode_Phase1 = E0308
data rust_leaf_phase1_err_e0423: Rustc_ErrorCode_Phase1 = E0423
data rust_leaf_phase1_err_e0599: Rustc_ErrorCode_Phase1 = E0599

type RustClaimExpectation
  = RustcAcceptsExpectation { invocation_form: v2.std.leaf_model_verification.TargetInvocation }
  | RustcRejectsExpectation {
      invocation_form: v2.std.leaf_model_verification.TargetInvocation
      expected_error_code: Rustc_ErrorCode_Phase1
    }
  | RustRuntimeBehaviorExpectation {
      invocation_form: v2.std.leaf_model_verification.TargetInvocation
      expected_outcome: v2.std.runtime.RuntimeOutcome
    }
  | RustEmitProjectionEqualityExpectation {
      atom_realization_row: v2.std.node.Node
      type_emit_must_change: v2.std.logic.Bool
      value_emit_must_change: v2.std.logic.Bool
    }
  | RustGrammarRoundTripExpectation { production: v2.std.grammar.GrammarProduction }
