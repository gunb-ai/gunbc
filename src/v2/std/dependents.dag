module v2.std.dependents

import v2.std.algebra { is_empty }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.node { OccurrenceId }

type Dependents
  = Untracked
  | Tracked { uses: List<OccurrenceId> }

fn no_dependents(d: Dependents) -> Bool {
  match d {
    Untracked => true
    Tracked { uses } => is_empty(xs: uses)
  }
}
