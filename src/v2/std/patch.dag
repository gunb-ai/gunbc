module v2.std.patch

import std.algebra { Monoid }

type ConfigPatchRecord<Config>

fn config_patch_layer<Config>(base: Config, patch: ConfigPatchRecord<Config>) -> Config {
  base
}

type FieldPatch<T>
  = Override { value: T }
  | Inherit

fn field_patch_inherit<T>() -> FieldPatch<T> {
  Inherit
}

fn apply_field_patch<T>(base: T, patch: FieldPatch<T>) -> T {
  match patch {
    Override { value: v } => v
    Inherit => base
  }
}

fn compose_field_patch<T>(left: FieldPatch<T>, right: FieldPatch<T>) -> FieldPatch<T> {
  match right {
    Override { value: v } => Override { value: v }
    Inherit => left
  }
}

fn field_patch_monoid<T>() -> Monoid<FieldPatch<T>> {
  Monoid {
    op: fn(left, right) { compose_field_patch(left: left, right: right) },
    identity: Inherit,
  }
}
