// src/v2/std/axiom.dag
// Scope: the project's axioms (A1-A3) and the §1-§7 consequence-chain, modeled as data,
//   plus the syllogism lens that mechanically verifies the grounding (replacing review).
// Authority: DESIGN.md §1 (the axioms) and its serial consequence-chain.
// Layering: std foundation — underlies everything the way logic does. No reverse imports.
//
// The point (DESIGN.md §5 "green by execution", §6 "enforce with lenses, not grep", and the
// open thread "model §1's axioms... have a lens enforce the syllogism"): design-conformance
// becomes a fact a lens decides, not a judgement a reviewer makes. An Axiom is irreducible
// (assumed, no premises). A DesignClaim holds BECAUSE of its premises — axioms or prior
// claims. `syllogism_holds` is fail-closed: every claim must chain back to an axiom, the
// graph must be acyclic, and no claim may be an orphan or cite a dangling premise.


module v2.std.axiom


import v2.std.text { String }
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.collection { List, Map, empty_map, map_get, map_insert, Present, Absent }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.algebra { fold_list, for_all, Empty, Cons }


// --- The model: axioms and grounded claims ---

// An axiom is irreducible: assumed, not derived. It grounds everything else (§1 — "assumed, not
// derived"). It has no `because` edge; the syllogism lens seeds the grounded set with the axioms.
type Axiom {
  id: Symbol
  statement: String
}


// A design claim is a consequence: it holds BECAUSE of its premises. `because` is the grounding
// edge — the syllogism made data. A claim is grounded only when every premise is itself grounded;
// the chain must terminate at axioms (§4 — "a DAG in the substrate, serial reasoning in the doc").
type DesignClaim {
  id: Symbol
  statement: String
  because: List<Symbol>
}


// --- The axioms (DESIGN.md §1) ---

data axiom_a1_goal: Symbol = axiom_a1_goal
data axiom_a2_time: Symbol = axiom_a2_time
data axiom_a3_agreement: Symbol = axiom_a3_agreement


fn design_axioms() -> List<Axiom> {
  [
    Axiom {
      id: axiom_a1_goal,
      statement: "A1 — there is a goal: to solve a problem presupposes an agent with a goal to satisfy."
    },
    Axiom {
      id: axiom_a2_time,
      statement: "A2 — time is the value: every agent intrinsically values time; time is life; the one value we may assume is shared."
    },
    Axiom {
      id: axiom_a3_agreement,
      statement: "A3 — agreement is temporal: intersubjective agreement holds only across time, and only on what stays stable under it."
    }
  ]
}


// --- The consequence-chain (a slice of §1-§7; each claim grounded `because` its premises) ---

data claim_minimal_safe_efficient: Symbol = claim_minimal_safe_efficient
data claim_grounding_intersubjective: Symbol = claim_grounding_intersubjective
data claim_fail_closed: Symbol = claim_fail_closed
data claim_self_defined_process_fail_closed: Symbol = claim_self_defined_process_fail_closed


fn design_claims() -> List<DesignClaim> {
  [
    // From A1 and A2: the solution is minimal, safe, efficient — time spent as cost, safety, complexity.
    DesignClaim {
      id: claim_minimal_safe_efficient,
      statement: "§1 — the solution is minimal, safe, efficient: time is spent as cost (to run), safety (to recover from a silent wrong answer), and complexity (to change).",
      because: [axiom_a1_goal, axiom_a2_time]
    },
    // From A2 and A3: grounding is intersubjective — point at a shared, time-stable framework.
    DesignClaim {
      id: claim_grounding_intersubjective,
      statement: "§1 — grounding is intersubjective: a fact is grounded only by pointing at a shared, time-stable framework, never an internal taxonomy.",
      because: [axiom_a2_time, axiom_a3_agreement]
    },
    // §5 fail-closed IS the safety axis of minimal/safe/efficient.
    DesignClaim {
      id: claim_fail_closed,
      statement: "§5 — fail-closed: a wrong answer is a loud error, never a warning; no fabricated plausible output. (The safety axis of §1.)",
      because: [claim_minimal_safe_efficient]
    },
    // §5 applied to a self-defined process (compile/bootstrap/ci): the obligation FALLS OUT, not chosen.
    DesignClaim {
      id: claim_self_defined_process_fail_closed,
      statement: "A self-defined process (compile/bootstrap/ci) must fail closed: its output feeds its own definition, so a silent wrong answer corrupts the definition irrecoverably (§5 applied).",
      because: [claim_fail_closed]
    }
  ]
}


// --- The syllogism lens (fail-closed; this IS the reviewer, decided by execution) ---

// Membership in the grounded set. map_get keys on Symbol equality, so no explicit symbol_eq is
// needed; a missing key (or a rejected lookup) is fail-closed to "not grounded".
fn grounded_has(grounded: Map<Symbol, Bool>, id: Symbol) -> Bool {
  match map_get(m: grounded, key: id) {
    Accepted { value: opt, diagnostics: _ } => match opt {
      Present { value: _ } => true
      Absent => false
    }
    Rejected { diagnostics: _ } => false
  }
}


// A claim becomes grounded this pass iff it has at least one premise AND every premise is already
// grounded. The non-empty guard is what makes an ORPHAN (a non-axiom claim with no premises) fail
// closed — "all of nothing" would otherwise be vacuously true.
fn claim_grounded_now(grounded: Map<Symbol, Bool>, c: DesignClaim) -> Bool {
  match c.because {
    Empty => false
    Cons { head: _, tail: _ } =>
      for_all(xs: c.because, predicate: fn(premise) { grounded_has(grounded: grounded, id: premise) })
  }
}


// One monotone pass: ground every not-yet-grounded claim whose premises are all grounded.
fn ground_pass(grounded: Map<Symbol, Bool>, claims: List<DesignClaim>) -> Map<Symbol, Bool> {
  fold_list(xs: claims, empty: grounded, cons: fn(acc, c) {
    match grounded_has(grounded: acc, id: c.id) {
      true => acc
      false => match claim_grounded_now(grounded: acc, c: c) {
        true => map_insert(m: acc, key: c.id, value: true)
        false => acc
      }
    }
  })
}


// Seed the grounded set with the axioms — grounded by fiat (assumed, not derived).
fn axiom_grounded_set(axioms: List<Axiom>) -> Map<Symbol, Bool> {
  fold_list(xs: axioms, empty: empty_map(), cons: fn(acc, a) {
    map_insert(m: acc, key: a.id, value: true)
  })
}


// Run ground_pass once per claim — length(claims) passes is ≥ the longest acyclic chain, so the
// fixpoint is reached. A CYCLE never converges (its claims wait on each other forever and stay
// ungrounded). Driving the iteration by folding the claim list as its own counter needs no Int
// arithmetic and stays bounded/forward (§4).
fn grounded_closure(axioms: List<Axiom>, claims: List<DesignClaim>) -> Map<Symbol, Bool> {
  fold_list(xs: claims, empty: axiom_grounded_set(axioms: axioms), cons: fn(acc, _c) {
    ground_pass(grounded: acc, claims: claims)
  })
}


// THE SYLLOGISM LENS. Fail-closed verdict: every design claim must chain back to an axiom —
// acyclic, no orphan, no dangling premise. False if ANY claim is ungrounded.
fn syllogism_holds(axioms: List<Axiom>, claims: List<DesignClaim>) -> Bool {
  let grounded = grounded_closure(axioms: axioms, claims: claims)
  for_all(xs: claims, predicate: fn(c) { grounded_has(grounded: grounded, id: c.id) })
}


// The project's own model, verified. This is the consequence that matters: "a self-defined process
// must fail closed" is now a lens-checked fact, not a reviewer's assertion.
fn design_syllogism_holds() -> Bool {
  syllogism_holds(axioms: design_axioms(), claims: design_claims())
}
