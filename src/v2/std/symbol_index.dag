module v2.std.symbol_index

import std.algebra { FreeMonoid }
import std.disposition { Accepted, Rejected }
import v2.std.algebra { fold_list, is_empty }
import v2.std.collection {
  Absent,
  Map,
  Optional,
  Present,
  empty_map,
  map_get,
  map_insert,
  optional_absent,
  optional_present
}
import v2.std.logic { Bool }
import v2.std.node { Node, Symbol }
import v2.std.qualified_name { QualifiedName, qualified_name_init, qualified_name_snoc }

type SymbolIndex {
  entries: Map<QualifiedName, Node>
}

fn empty_symbol_index() -> SymbolIndex {
  SymbolIndex { entries: empty_map() }
}

fn symbol_index_lookup(index: SymbolIndex, qualified_path: QualifiedName) -> Optional<Node> {
  match map_get(index.entries, qualified_path) {
    Accepted { value: opt, diagnostics: _ } => opt
    Rejected { diagnostics: _ } => optional_absent()
  }
}

fn symbol_index_insert(index: SymbolIndex, qualified_path: QualifiedName, resolved: Node) -> SymbolIndex {
  SymbolIndex {
    entries: map_insert(m: index.entries, key: qualified_path, value: resolved)
  }
}

fn symbol_index_try_lexical_at(
  index: SymbolIndex,
  position: QualifiedName,
  name: Symbol
) -> Optional<Node> {
  let candidate_path = qualified_name_snoc(qn: position, segment: name)
  symbol_index_lookup(index: index, qualified_path: candidate_path)
}

fn symbol_index_lexical_lookup(
  index: SymbolIndex,
  position: QualifiedName,
  name: Symbol
) -> Optional<Node> {
  match symbol_index_try_lexical_at(index: index, position: position, name: name) {
    Present { value: node } => optional_present(value: node)
    Absent =>
      if is_empty(xs: position) {
        optional_absent()
      } else {
        symbol_index_lexical_lookup(
          index: index,
          position: qualified_name_init(qn: position),
          name: name
        )
      }
  }
}
