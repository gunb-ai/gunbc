module v2.std.symbol_index


import std.algebra { Empty, FreeMonoid }
import std.content_hash { Fnv1a64Structural }
import std.occurrence_binding { BindingCandidate }
import std.occurrence_identity { OccurrenceId, ScopedOccurrenceRef }
import v2.std.algebra {
  HeadAbsent,
  HeadFound,
  is_empty,
  length,
  list_head,
  list_snoc_item
}
import v2.std.collection {
  Map,
  empty_map,
  map_get,
  map_insert
}
import v2.std.optional {
  Absent,
  Optional,
  Present,
  optional_absent,
  optional_present
}
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Node, Symbol }
import v2.std.qualified_name {
  QualifiedName,
  qualified_name_init,
  qualified_name_last_segment,
  qualified_name_snoc
}

// symbol_index_fill derives this accelerator from SymbolIndex.entries. Resolve
// projects the same candidate for bare and qualified references.
type GlobalBareBindingState
  = GlobalBareUnique { candidate: BindingCandidate<ScopedOccurrenceRef>, path: QualifiedName }
  | GlobalBareAmbiguous

// Consumed by resolve's bare-reference binding through occurrence_binding_from_candidates.
type GlobalBareLookup
  = GlobalBareHit { candidate: BindingCandidate<ScopedOccurrenceRef>, path: QualifiedName }
  | GlobalBareLookupAmbiguous
  | GlobalBareLookupUnbound

// Qualified-name search evidence for symbol_index_lexical_lookup; containment
// identity remains the existing BindingCandidate, not the searched spelling.
type LexicalBindingCandidate {
  path: QualifiedName
  candidate: BindingCandidate<ScopedOccurrenceRef>
}

// Consumed by resolve's lexical-reference binding. All successful searches expose
// the same candidate shape used by qualified lookup.
type LexicalLookup
  = LexicalHit { candidate: BindingCandidate<ScopedOccurrenceRef>, path: QualifiedName }
  | LexicalAmbiguous { candidates: FreeMonoid<LexicalBindingCandidate> }
  | LexicalUnbound

// A synthetic node cannot become an endpoint or ancestor of a binding path.
// symbol_index_fill and resolve use one conversion to a resolve Diagnostic with
// a resolve_reason symbol at node_locus, through the existing Rejected channel;
// resolve consumers never match a second failure channel beside Rejected. The
// known prefix locates the traversal without fabricating a terminal identity.
// MissingAuthoredOccurrenceIdentity requires a SourceSpan, which an untracked
// synthetic v2 node does not supply, so it cannot represent this boundary.
type SymbolIndexIdentityRefusal
  = SymbolIndexUntrackedSynthetic {
      node: Node,
      ancestors: FreeMonoid<ScopedOccurrenceRef>
    }

// The sole qualified-name candidate index, produced by symbol_index_fill and
// consumed by resolve. Its node storage is addressed by occurrence, not spelling;
// global_bare is a search projection of entries, not another binding authority.
// occurrence_domains uses the scope type's map-key equality to select a domain
// without scanning source files, then selects the ordinal within that domain.
// Explicit cross-domain joins use scoped_occurrence_ref_same_scope; no consumer
// compares raw digests. Containment paths store references, not ancestor subtrees.
type SymbolIndex {
  entries: Map<QualifiedName, BindingCandidate<ScopedOccurrenceRef>>
  occurrence_domains: Map<Fnv1a64Structural, Map<OccurrenceId, Node>>
  global_bare: Map<Symbol, GlobalBareBindingState>
}

fn empty_symbol_index() -> SymbolIndex {
  SymbolIndex {
    entries: empty_map(),
    global_bare: empty_map()
  }
}

fn symbol_index_lookup(index: SymbolIndex, qualified_path: QualifiedName) -> Optional<Node> {
  match v2.std.collection.map_get(index.entries, qualified_path) {
    Accepted { value: opt, diagnostics: _ } => opt
    Rejected { diagnostics: _ } => optional_absent()
  }
}

fn symbol_index_track_global_bare(
  index: SymbolIndex,
  qualified_path: QualifiedName,
  resolved: Node
) -> SymbolIndex {
  match qualified_name_last_segment(qn: qualified_path) {
    Absent => index
    Present { value: leaf } =>
      match v2.std.collection.map_get(index.global_bare, leaf) {
        Accepted { value: opt, diagnostics: _ } => match opt {
          Present { value: GlobalBareAmbiguous } => index
          Present { value: GlobalBareUnique { node: existing, path: existing_path } } =>
            if existing_path == qualified_path && existing == resolved {
              index
            } else {
              SymbolIndex {
                entries: index.entries,
                global_bare: map_insert(
                  m: index.global_bare,
                  key: leaf,
                  value: GlobalBareAmbiguous
                )
              }
            }
          Absent =>
            SymbolIndex {
              entries: index.entries,
              global_bare: map_insert(
                m: index.global_bare,
                key: leaf,
                value: GlobalBareUnique { node: resolved, path: qualified_path }
              )
            }
        }
        Rejected { diagnostics: _ } => index
      }
  }
}

fn symbol_index_insert(index: SymbolIndex, qualified_path: QualifiedName, resolved: Node) -> SymbolIndex {
  let with_entry = SymbolIndex {
    entries: map_insert(
      m: index.entries,
      key: qualified_path,
      value: resolved
    ),
    global_bare: index.global_bare
  }
  symbol_index_track_global_bare(
    index: with_entry,
    qualified_path: qualified_path,
    resolved: resolved
  )
}

fn symbol_index_global_unique_lookup(index: SymbolIndex, name: Symbol) -> GlobalBareLookup {
  match v2.std.collection.map_get(index.global_bare, name) {
    Accepted { value: opt, diagnostics: _ } => match opt {
      Present { value: GlobalBareUnique { node: n, path: p } } => GlobalBareHit { node: n, path: p }
      Present { value: GlobalBareAmbiguous } => GlobalBareLookupAmbiguous
      Absent => GlobalBareLookupUnbound
    }
    Rejected { diagnostics: _ } => GlobalBareLookupUnbound
  }
}

fn symbol_index_try_lexical_at(
  index: SymbolIndex,
  position: QualifiedName,
  name: Symbol
) -> Optional<Node> {
  let candidate_path = qualified_name_snoc(qn: position, segment: name)
  symbol_index_lookup(index: index, qualified_path: candidate_path)
}

fn symbol_index_lexical_collect(
  index: SymbolIndex,
  position: QualifiedName,
  name: Symbol,
  acc: FreeMonoid<LexicalBindingCandidate>
) -> FreeMonoid<LexicalBindingCandidate> {
  let with_current = match symbol_index_try_lexical_at(index: index, position: position, name: name) {
    Present { value: node } =>
      list_snoc_item(
        xs: acc,
        item: LexicalBindingCandidate {
          path: qualified_name_snoc(qn: position, segment: name),
          node: node
        }
      )
    Absent => acc
  }
  if is_empty(xs: position) {
    with_current
  } else {
    symbol_index_lexical_collect(
      index: index,
      position: qualified_name_init(qn: position),
      name: name,
      acc: with_current
    )
  }
}

fn symbol_index_lexical_lookup(
  index: SymbolIndex,
  position: QualifiedName,
  name: Symbol
) -> LexicalLookup {
  let candidates = symbol_index_lexical_collect(
    index: index,
    position: position,
    name: name,
    acc: Empty
  )
  match length(xs: candidates) {
    0 => LexicalUnbound
    1 =>
      match list_head(xs: candidates) {
        HeadFound { value: candidate } =>
          LexicalHit { node: candidate.node, path: candidate.path }
        HeadAbsent => LexicalUnbound
      }
    _ => LexicalAmbiguous { candidates: candidates }
  }
}
