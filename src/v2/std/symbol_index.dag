module v2.std.symbol_index

import std.algebra { Cons, Empty, FreeMonoid }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import v2.extdeps.languages.dag {
  dag_surface_module_header_metadata_edge,
  qualified_name_from_module_node
}
import v2.std.algebra { fold_list, length, list_snoc_item }
import v2.std.collection {
  Absent,
  Map,
  Optional,
  Present,
  empty_map,
  map_get,
  map_insert,
  optional_absent,
  optional_present
}
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  Conj,
  Disj,
  Edge,
  Named,
  Node,
  Positional,
  Symbol,
  TypeNode
}
import v2.std.qualified_name {
  QualifiedName,
  qualified_name_init,
  qualified_name_is_empty,
  qualified_name_snoc
}

type SymbolIndex {
  entries: Map<QualifiedName, Node>
}

fn empty_symbol_index() -> SymbolIndex {
  SymbolIndex { entries: empty_map() }
}

fn symbol_index_lookup(index: SymbolIndex, qualified_path: QualifiedName) -> Optional<Node> {
  match map_get(index.entries, qualified_path) {
    Accepted { value: opt, diagnostics: _ } => opt
    Rejected { diagnostics: _ } => optional_absent()
  }
}

fn symbol_index_insert(index: SymbolIndex, qualified_path: QualifiedName, resolved: Node) -> SymbolIndex {
  SymbolIndex {
    entries: map_insert(m: index.entries, key: qualified_path, value: resolved)
  }
}

data symbol_index_containment_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "v2.std.symbol_index",
    decl_name: "symbol_index_fill_containment_node",
    field: WholeDeclaration
  }
}

fn symbol_index_fill_containment_edge(
  index: SymbolIndex,
  path: QualifiedName,
  edge: Edge
) -> SymbolIndex {
  match edge.label {
    Named { name: sym } =>
      if dag_surface_module_header_metadata_edge(name: sym) {
        symbol_index_fill_containment_node(
          index: index,
          path: path,
          node: edge.target
        )
      } else {
        let child_path = qualified_name_snoc(qn: path, segment: sym)
        let with_binding = symbol_index_insert(
          index: index,
          qualified_path: child_path,
          resolved: edge.target
        )
        symbol_index_fill_containment_node(
          index: with_binding,
          path: child_path,
          node: edge.target
        )
      }
    Positional =>
      symbol_index_fill_containment_node(
        index: index,
        path: path,
        node: edge.target
      )
  }
}

fn symbol_index_fill_containment_node(
  index: SymbolIndex,
  path: QualifiedName,
  node: Node
) -> SymbolIndex {
  match node.kind {
    TypeNode { connective: Conj } =>
      fold(node.children, init: index, f: fn(acc, edge) {
        symbol_index_fill_containment_edge(index: acc, path: path, edge: edge)
      })
    TypeNode { connective: Disj } =>
      fold(node.children, init: index, f: fn(acc, edge) {
        match edge.label {
          Named { name: sym } =>
            let variant_path = qualified_name_snoc(qn: path, segment: sym)
            let with_variant = symbol_index_insert(
              index: acc,
              qualified_path: variant_path,
              resolved: edge.target
            )
            symbol_index_fill_containment_node(
              index: with_variant,
              path: variant_path,
              node: edge.target
            )
          Positional => acc
        }
      })
    _ => index
  }
}

fn symbol_index_fill_module_root(index: SymbolIndex, root: Node) -> SymbolIndex {
  match qualified_name_from_module_node(root: root) {
    Accepted { value: module_qn, diagnostics: _ } =>
      symbol_index_fill_containment_node(
        index: index,
        path: module_qn,
        node: root
      )
    Rejected { diagnostics: _ } => index
  }
}

fn symbol_index_fill_module_roots(
  index: SymbolIndex,
  roots: FreeMonoid<Node>
) -> SymbolIndex {
  fold_list(
    xs: roots,
    empty: index,
    cons: fn(acc, root) {
      symbol_index_fill_module_root(index: acc, root: root)
    }
  )
}

fn symbol_index_try_lexical_at(
  index: SymbolIndex,
  position: QualifiedName,
  name: Symbol
) -> Optional<Node> {
  let candidate_path = qualified_name_snoc(qn: position, segment: name)
  symbol_index_lookup(index: index, qualified_path: candidate_path)
}

fn symbol_index_lexical_lookup(
  index: SymbolIndex,
  position: QualifiedName,
  name: Symbol
) -> Optional<Node> {
  match symbol_index_try_lexical_at(index: index, position: position, name: name) {
    Present { value: node } => optional_present(value: node)
    Absent =>
      if qualified_name_is_empty(qn: position) {
        optional_absent()
      } else {
        symbol_index_lexical_lookup(
          index: index,
          position: qualified_name_init(qn: position),
          name: name
        )
      }
  }
}

fn symbol_index_has_path(index: SymbolIndex, qualified_path: QualifiedName) -> Bool {
  match symbol_index_lookup(index: index, qualified_path: qualified_path) {
    Present { value: _ } => true
    Absent => false
  }
}
