// src/v2/std/lens_verdict.dag
// Scope: tier-0 unified lens verdict carrier (ROADMAP: Lens universalization).
// Every lens projects its domain-specific fact into this closed sum; Unrealized
// is fail-closed until the producer lands. Violation and NotApplicable carry
// located diagnostics per DESIGN.md §5.

module v2.std.lens_verdict

import v2.std.diagnostic { Diagnostic, Locus, Textual, WholeFile }

type LensVerdict
  = Holds
  | Violation { diagnostic: Diagnostic }
  | NotApplicable { diagnostic: Diagnostic }
  | Unrealized { diagnostic: Diagnostic }

fn lens_verdict_is_fail_closed(verdict: LensVerdict) -> Bool {
  match verdict {
    Unrealized { diagnostic: _ } => true
    _ => false
  }
}

fn lens_verdict_is_violation(verdict: LensVerdict) -> Bool {
  match verdict {
    Violation { diagnostic: _ } => true
    _ => false
  }
}

fn lens_verdict_locus(verdict: LensVerdict) -> Locus {
  match verdict {
    Holds => Textual { file: ^lens_verdict_holds, extent: WholeFile }
    Violation { diagnostic: d } => d.at
    NotApplicable { diagnostic: d } => d.at
    Unrealized { diagnostic: d } => d.at
  }
}
