module v2.std.lens_verdict

import v2.std.compilers.lexing { symbol_intern_lexeme, symbol_lexeme }
import v2.std.diagnostic {
  ByteRange,
  CorrectionNotModeled,
  Diagnostic,
  Extent,
  NodeLocus,
  InvariantPortLocus,
  SourcePortLocus,
  Textual,
  Unavailable,
  WholeFile,
  textual_whole_file_diagnostic,
}
import v2.std.integer { integer_int_to_decimal_string }
import v2.std.node { Symbol }
import v2.std.text { String }

// LensVerdict is the shared fail-closed lattice for lenses that have not yet specialized to a
// mechanism-specific verdict authority (LadderVerdict, VacuityEvidence, …). Diagnostics ground on
// v2.std.diagnostic — the retired LensVerdictDiagnostic/LensVerdictLocus fork is dissolved (W1.2).

type LensVerdict
  = Holds
  | Violation { diagnostic: Diagnostic }
  | NotApplicable { diagnostic: Diagnostic }
  | Unrealized { diagnostic: Diagnostic }

fn lens_verdict_module_file(module_name: String) -> Symbol {
  symbol_intern_lexeme(lexeme: module_name)
}

fn lens_verdict_module_diagnostic(reason: Symbol, module_name: String) -> Diagnostic {
  textual_whole_file_diagnostic(
    reason: reason,
    module_file: lens_verdict_module_file(module_name: module_name),
    correction: Unavailable { reason: CorrectionNotModeled }
  )
}

fn lens_verdict_module_violation(reason: Symbol, module_name: String) -> LensVerdict {
  Violation {
    diagnostic: lens_verdict_module_diagnostic(reason: reason, module_name: module_name)
  }
}

fn lens_verdict_module_unrealized(reason: Symbol, module_name: String) -> LensVerdict {
  Unrealized {
    diagnostic: lens_verdict_module_diagnostic(reason: reason, module_name: module_name)
  }
}

fn lens_verdict_module_not_applicable(reason: Symbol, module_name: String) -> LensVerdict {
  NotApplicable {
    diagnostic: lens_verdict_module_diagnostic(reason: reason, module_name: module_name)
  }
}

fn lens_verdict_diagnostic_locus_module(d: Diagnostic) -> String {
  match d.at {
    Textual { file: module_file, extent: _ } => symbol_lexeme(sym: module_file)
    NodeLocus { anchor: _ } => ""
    SourcePortLocus { anchor: _, file: module_file, extent: _ } => symbol_lexeme(sym: module_file)
    InvariantPortLocus { anchor: _, invariant: _ } => ""
  }
}

// File + extent, for a reader who has to act. The module-name fold above remains the identity
// projection callers already consume; this sibling is the same Locus match with extent kept.
fn lens_verdict_extent_text(e: Extent) -> String {
  match e {
    WholeFile => "(whole file)"
    ByteRange { start: st, end: en } =>
      concat(
        concat("bytes ", integer_int_to_decimal_string(value: st)),
        concat("..", integer_int_to_decimal_string(value: en))
      )
  }
}

fn lens_verdict_diagnostic_locus_text(d: Diagnostic) -> String {
  match d.at {
    Textual { file: f, extent: e } =>
      concat(concat(symbol_lexeme(sym: f), " "), lens_verdict_extent_text(e: e))
    SourcePortLocus { anchor: _, file: f, extent: e } =>
      concat(concat(symbol_lexeme(sym: f), " "), lens_verdict_extent_text(e: e))
    NodeLocus { anchor: _ } => "<node locus, no file>"
    InvariantPortLocus { anchor: _, invariant: inv } =>
      concat("<invariant ", concat(symbol_lexeme(sym: inv), ">"))
  }
}
