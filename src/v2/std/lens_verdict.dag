module v2.std.lens_verdict

import v2.std.compilers.lexing { symbol_intern_lexeme, symbol_lexeme }
import v2.std.diagnostic {
  ByteRange,
  CorrectionNotModeled,
  Diagnostic,
  Extent,
  NodeLocus,
  InvariantPortLocus,
  SourcePortLocus,
  Textual,
  Unavailable,
  WholeFile,
  textual_whole_file_diagnostic,
}
import v2.std.integer { integer_int_to_decimal_string }
import v2.std.node { Symbol }
import v2.std.provenance { SpanIndex, span_index_textual_locus_optional }
import v2.std.optional { Absent, Present }
import std.occurrence_identity { OccurrenceId, OccurrenceMinted, OccurrenceProjected, OccurrenceSynthetic }
import v2.std.text { String }

// LensVerdict is the shared fail-closed lattice for lenses that have not yet specialized to a
// mechanism-specific verdict authority (LadderVerdict, VacuityEvidence, …). Diagnostics ground on
// v2.std.diagnostic — the retired LensVerdictDiagnostic/LensVerdictLocus fork is dissolved (W1.2).

type LensVerdict
  = Holds
  | Violation { diagnostic: Diagnostic }
  | NotApplicable { diagnostic: Diagnostic }
  | Unrealized { diagnostic: Diagnostic }

fn lens_verdict_module_file(module_name: String) -> Symbol {
  symbol_intern_lexeme(lexeme: module_name)
}

fn lens_verdict_module_diagnostic(reason: Symbol, module_name: String) -> Diagnostic {
  textual_whole_file_diagnostic(
    reason: reason,
    module_file: lens_verdict_module_file(module_name: module_name),
    correction: Unavailable { reason: CorrectionNotModeled }
  )
}

fn lens_verdict_module_violation(reason: Symbol, module_name: String) -> LensVerdict {
  Violation {
    diagnostic: lens_verdict_module_diagnostic(reason: reason, module_name: module_name)
  }
}

fn lens_verdict_module_unrealized(reason: Symbol, module_name: String) -> LensVerdict {
  Unrealized {
    diagnostic: lens_verdict_module_diagnostic(reason: reason, module_name: module_name)
  }
}

fn lens_verdict_module_not_applicable(reason: Symbol, module_name: String) -> LensVerdict {
  NotApplicable {
    diagnostic: lens_verdict_module_diagnostic(reason: reason, module_name: module_name)
  }
}

fn lens_verdict_diagnostic_locus_module(d: Diagnostic) -> String {
  match d.at {
    Textual { file: module_file, extent: _ } => symbol_lexeme(sym: module_file)
    NodeLocus { anchor: _ } => ""
    SourcePortLocus { anchor: _, file: module_file, extent: _ } => symbol_lexeme(sym: module_file)
    InvariantPortLocus { anchor: _, invariant: _ } => ""
  }
}

// File + extent, for a reader who has to act. The module-name fold above remains the identity
// projection callers already consume; this sibling is the same Locus match with extent kept.
fn lens_verdict_extent_text(e: Extent) -> String {
  match e {
    WholeFile => "(whole file)"
    ByteRange { start: st, end: en } =>
      concat(
        concat("bytes ", integer_int_to_decimal_string(value: st)),
        concat("..", integer_int_to_decimal_string(value: en))
      )
  }
}

// THE LOCATED RENDERER: THE ONE PLACE A NODE ANCHOR BECOMES A FILE, AND IT IS A LOOKUP.
//
// A `NodeLocus` names the node a stage refused at, and a node carries an OCCURRENCE, not a
// position. The ingest's span index is keyed by exactly that occurrence and its entries already
// carry the compilation unit each token was read from, so the whole join is: read the node's
// occurrence, look it up, render the Textual locus the existing sibling below already renders. No
// tree is walked and no node is compared -- searching the program for a structurally equal node
// would be a plausible guess about which file an occurrence came from, which DESIGN section 5
// forbids, and it is also the reason this takes an INDEX rather than a program.
//
// A DERIVED OCCURRENCE RESOLVES THROUGH ITS CAUSES, WHICH IS WHY INTERIOR NODES ANSWER AT ALL.
// `span_index_resolve_textual_locus` follows a `DerivedBy` origin to the ids it was derived from,
// so a production node minted over its captured children reports the span of the source those
// children came from. That is a recorded chain, not an inference.
//
// EVERY WAY OF NOT KNOWING RENDERS AS NOT KNOWING. A synthetic node has no occurrence; an
// occurrence absent from the index (a file the fold never reached, because assembly is fail-closed
// and stops at the first refusal) refuses at lookup; a chain that bottoms out in no textual origin
// refuses too. All three fall through to the unlocated text below, which says plainly that there is
// no file. None of them invents one.
fn lens_verdict_diagnostic_locus_text_located(d: Diagnostic, index: SpanIndex) -> String {
  match d.at {
    NodeLocus { anchor: a } =>
      match a.at.occurrence_id {
        OccurrenceSynthetic => lens_verdict_diagnostic_locus_text(d: d)
        OccurrenceMinted { id: id } =>
          lens_verdict_located_from_occurrence(d: d, index: index, id: id)
        OccurrenceProjected { id: id, caused_by: _ } =>
          lens_verdict_located_from_occurrence(d: d, index: index, id: id)
      }
    _ => lens_verdict_diagnostic_locus_text(d: d)
  }
}

fn lens_verdict_located_from_occurrence(
  d: Diagnostic,
  index: SpanIndex,
  id: OccurrenceId
) -> String {
  match span_index_textual_locus_optional(index: index, id: id) {
    Present { value: locus } =>
      match locus {
        Textual { file: f, extent: e } =>
          concat(concat(symbol_lexeme(sym: f), " "), lens_verdict_extent_text(e: e))
        _ => lens_verdict_diagnostic_locus_text(d: d)
      }
    Absent => lens_verdict_diagnostic_locus_text(d: d)
  }
}

fn lens_verdict_diagnostic_locus_text(d: Diagnostic) -> String {
  match d.at {
    Textual { file: f, extent: e } =>
      concat(concat(symbol_lexeme(sym: f), " "), lens_verdict_extent_text(e: e))
    SourcePortLocus { anchor: _, file: f, extent: e } =>
      concat(concat(symbol_lexeme(sym: f), " "), lens_verdict_extent_text(e: e))
    NodeLocus { anchor: _ } => "<node locus, no file>"
    InvariantPortLocus { anchor: _, invariant: inv } =>
      concat("<invariant ", concat(symbol_lexeme(sym: inv), ">"))
  }
}
