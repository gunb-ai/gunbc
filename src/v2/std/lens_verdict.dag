module v2.std.lens_verdict


data lens_verdict_home_note: String = "LensVerdict is the shared fail-closed lattice for lenses that have not yet specialized to a mechanism-specific verdict authority (LadderVerdict, VacuityEvidence, …). Diagnostics ground on v2.std.diagnostic — the retired LensVerdictDiagnostic/LensVerdictLocus fork is dissolved (W1.2)."

type LensVerdict
  = Holds
  | Violation { diagnostic: v2.std.diagnostic.Diagnostic }
  | NotApplicable { diagnostic: v2.std.diagnostic.Diagnostic }
  | Unrealized { diagnostic: v2.std.diagnostic.Diagnostic }

fn lens_verdict_module_file(module_name: String) -> v2.std.node.Symbol {
  v2.std.compilers.lexing.symbol_intern_lexeme(lexeme: module_name)
}

fn lens_verdict_module_diagnostic(reason: v2.std.node.Symbol, module_name: String) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.textual_whole_file_diagnostic(
    reason: reason,
    module_file: lens_verdict_module_file(module_name: module_name),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.CorrectionNotModeled }
  )
}

fn lens_verdict_module_violation(reason: v2.std.node.Symbol, module_name: String) -> LensVerdict {
  Violation {
    diagnostic: lens_verdict_module_diagnostic(reason: reason, module_name: module_name)
  }
}

fn lens_verdict_module_unrealized(reason: v2.std.node.Symbol, module_name: String) -> LensVerdict {
  Unrealized {
    diagnostic: lens_verdict_module_diagnostic(reason: reason, module_name: module_name)
  }
}

fn lens_verdict_module_not_applicable(reason: v2.std.node.Symbol, module_name: String) -> LensVerdict {
  NotApplicable {
    diagnostic: lens_verdict_module_diagnostic(reason: reason, module_name: module_name)
  }
}

fn lens_verdict_diagnostic_locus_module(d: v2.std.diagnostic.Diagnostic) -> String {
  match d.at {
    v2.std.diagnostic.Textual { file: module_file, extent: _ } => v2.std.compilers.lexing.symbol_lexeme(sym: module_file)
    v2.std.diagnostic.NodeLocus { anchor: _ } => ""
    v2.std.diagnostic.PortLocus { anchor: _ } => ""
  }
}
