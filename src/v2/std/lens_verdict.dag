module v2.std.lens_verdict

import std.occurrence_identity { OccurrenceMinted, OccurrenceProjected, OccurrenceSynthetic }
import v2.std.algebra { fold_list }
import v2.std.compilers.lexing { symbol_intern_lexeme, symbol_lexeme }
import v2.std.diagnostic {
  ByteRange,
  CorrectionNotModeled,
  DeclarationLocus,
  Diagnostic,
  Extent,
  NodeLocus,
  NonEmptyDiagnostics,
  InvariantPortLocus,
  SourcePortLocus,
  Textual,
  Unavailable,
  WholeFile,
  textual_whole_file_diagnostic,
}
import v2.std.integer { integer_int_to_decimal_string }
import v2.std.node { Node, Symbol }
import v2.std.optional { Absent, Optional, Present, optional_absent, optional_present }
import v2.std.provenance { SpanIndex, span_index_empty, span_index_textual_locus_optional }
import std.occurrence_identity { OccurrenceId }
import v2.std.qualified_name { qualified_name_to_dotted_string }
import v2.std.text { String }

// LensVerdict is the shared fail-closed lattice for lenses that have not yet specialized to a
// mechanism-specific verdict authority (LadderVerdict, VacuityEvidence, …). Diagnostics ground on
// v2.std.diagnostic — the retired LensVerdictDiagnostic/LensVerdictLocus fork is dissolved (W1.2).

type LensVerdict
  = Holds
  | Violation { diagnostic: Diagnostic }
  | NotApplicable { diagnostic: Diagnostic }
  | Unrealized { diagnostic: Diagnostic }

fn lens_verdict_module_file(module_name: String) -> Symbol {
  symbol_intern_lexeme(lexeme: module_name)
}

fn lens_verdict_module_diagnostic(reason: Symbol, module_name: String) -> Diagnostic {
  textual_whole_file_diagnostic(
    reason: reason,
    module_file: lens_verdict_module_file(module_name: module_name),
    correction: Unavailable { reason: CorrectionNotModeled }
  )
}

fn lens_verdict_module_violation(reason: Symbol, module_name: String) -> LensVerdict {
  Violation {
    diagnostic: lens_verdict_module_diagnostic(reason: reason, module_name: module_name)
  }
}

fn lens_verdict_module_unrealized(reason: Symbol, module_name: String) -> LensVerdict {
  Unrealized {
    diagnostic: lens_verdict_module_diagnostic(reason: reason, module_name: module_name)
  }
}

fn lens_verdict_module_not_applicable(reason: Symbol, module_name: String) -> LensVerdict {
  NotApplicable {
    diagnostic: lens_verdict_module_diagnostic(reason: reason, module_name: module_name)
  }
}

fn lens_verdict_diagnostic_locus_module(d: Diagnostic) -> String {
  match d.at {
    Textual { file: module_file, extent: _ } => symbol_lexeme(sym: module_file)
    NodeLocus { anchor: _ } => ""
    SourcePortLocus { anchor: _, file: module_file, extent: _ } => symbol_lexeme(sym: module_file)
    InvariantPortLocus { anchor: _, invariant: _ } => ""
    DeclarationLocus { declaration: _ } => ""
  }
}

// File + extent, for a reader who has to act. The module-name fold above remains the identity
// projection callers already consume; this sibling is the same Locus match with extent kept.
fn lens_verdict_extent_text(e: Extent) -> String {
  match e {
    WholeFile => "(whole file)"
    ByteRange { start: st, end: en } =>
      concat(
        concat("bytes ", integer_int_to_decimal_string(value: st)),
        concat("..", integer_int_to_decimal_string(value: en))
      )
  }
}

// A NODE LOCUS NAMES AN OCCURRENCE, AND THE OCCURRENCE IS WHAT THE READER GETS. The arm used to
// render "<node locus, no file>", which is true and useless: the anchor node carries its
// occurrence identity (std.occurrence_identity, the keying home DESIGN section 3b names for
// occurrence identity within one source graph), so the position the failing stage established
// was in hand and was rendered as its own absence. The ordinal is the parser's, scoped to the
// source graph that minted it; resolving it to a byte range needs that graph's SpanIndex, which
// the stages past parse do not carry -- so this renders the identity the diagnostic HAS rather
// than fabricating a file it does not.
fn lens_verdict_node_occurrence_text(node: Node) -> String {
  match node.occurrence_id {
    OccurrenceSynthetic => "<synthetic node occurrence>"
    OccurrenceMinted { id: id } =>
      concat("<node occurrence #", concat(integer_int_to_decimal_string(value: id.value), ">"))
    OccurrenceProjected { id: id, caused_by: _ } =>
      concat("<projected node occurrence #", concat(integer_int_to_decimal_string(value: id.value), ">"))
  }
}

// THE SAME QUESTION, ASKED BY A CALLER WHO HOLDS THE INDEX. The paragraph above says the ordinal
// can be resolved to a byte range given "that graph's SpanIndex, which the stages past parse do not
// carry" -- `v2.compiler.program_assembly` now carries it, so this is that sentence's other half
// rather than a second answer. The occurrence rendering above remains the ONE answer for every case
// this cannot resolve, and is called directly rather than restated: a synthetic node, an occurrence
// the index does not hold (assembly is fail-closed, so a file it never reached has no entries), and
// a derivation chain that bottoms out in no textual origin all render exactly as they did before.
// Nothing here can invent a file; it can only find one that was recorded.
fn lens_verdict_node_occurrence_text_in_spans(node: Node, index: SpanIndex) -> String {
  match lens_verdict_node_occurrence_id_optional(node: node) {
    Absent => lens_verdict_node_occurrence_text(node: node)
    Present { value: id } =>
      match span_index_textual_locus_optional(index: index, id: id) {
        Absent => lens_verdict_node_occurrence_text(node: node)
        Present { value: locus } =>
          match locus {
            Textual { file: f, extent: e } =>
              concat(concat(symbol_lexeme(sym: f), " "), lens_verdict_extent_text(e: e))
            _ => lens_verdict_node_occurrence_text(node: node)
          }
      }
  }
}

fn lens_verdict_node_occurrence_id_optional(node: Node) -> Optional<OccurrenceId> {
  match node.occurrence_id {
    OccurrenceSynthetic => optional_absent()
    OccurrenceMinted { id: id } => optional_present(value: id)
    OccurrenceProjected { id: id, caused_by: _ } => optional_present(value: id)
  }
}

// ONE `match d.at` IN THIS MODULE, AND THE INDEX-FREE DOOR IS ITS PROJECTION. A caller without a
// span index passes an empty one, every lookup finds nothing, and every arm renders exactly what it
// rendered before -- so the two doors cannot disagree about a locus, because there is only one set
// of arms to disagree with. Writing the second door as its own `match` is the section-3 fork this
// module's own CLI consumer was already warned about.
fn lens_verdict_diagnostic_locus_text(d: Diagnostic) -> String {
  lens_verdict_diagnostic_locus_text_in_spans(d: d, index: span_index_empty())
}

fn lens_verdict_diagnostic_locus_text_in_spans(d: Diagnostic, index: SpanIndex) -> String {
  match d.at {
    Textual { file: f, extent: e } =>
      concat(concat(symbol_lexeme(sym: f), " "), lens_verdict_extent_text(e: e))
    SourcePortLocus { anchor: _, file: f, extent: e } =>
      concat(concat(symbol_lexeme(sym: f), " "), lens_verdict_extent_text(e: e))
    NodeLocus { anchor: a } =>
      lens_verdict_node_occurrence_text_in_spans(node: a.at, index: index)
    InvariantPortLocus { anchor: _, invariant: inv } =>
      concat("<invariant ", concat(symbol_lexeme(sym: inv), ">"))
    DeclarationLocus { declaration: declaration } =>
      concat("declaration ", qualified_name_to_dotted_string(qn: declaration))
  }
}

// ONE DIAGNOSTIC, LOCATED: "reason @ locus". The reason alone was what every boundary that
// summarized a refusal kept, and the locus is what each of them dropped.
fn lens_verdict_diagnostic_located_text(d: Diagnostic) -> String {
  lens_verdict_diagnostic_located_text_in_spans(d: d, index: span_index_empty())
}

fn lens_verdict_diagnostic_located_text_in_spans(d: Diagnostic, index: SpanIndex) -> String {
  concat(
    symbol_lexeme(sym: d.reason),
    concat(" @ ", lens_verdict_diagnostic_locus_text_in_spans(d: d, index: index))
  )
}

// THE WHOLE CHAIN, EACH LINK LOCATED, IN CARRIAGE ORDER. The last link is the cause that
// refused (rejected_with_pending prepends advisories, so the fatal diagnostic is the tail);
// the earlier links are what rode along -- advisories, and for an ambiguous reference the
// lookup class and each competing declaration. Rendering only the fatal would drop exactly
// the detail those links exist to carry.
fn lens_verdict_diagnostics_located_chain_text(d: NonEmptyDiagnostics) -> String {
  lens_verdict_diagnostics_located_chain_text_in_spans(d: d, index: span_index_empty())
}

// EVERY LINK RESOLVED, NOT ONLY THE FATAL. The chain exists because the head is not the cause, and
// the same reasoning applies to position: a reader chasing an advisory link wants its file as much
// as the fatal's, and each link anchors on its own node.
fn lens_verdict_diagnostics_located_chain_text_in_spans(
  d: NonEmptyDiagnostics,
  index: SpanIndex
) -> String {
  fold_list(
    xs: d.tail,
    empty: lens_verdict_diagnostic_located_text_in_spans(d: d.head, index: index),
    cons: fn(acc, diag) {
      concat(acc, concat(" -> ", lens_verdict_diagnostic_located_text_in_spans(d: diag, index: index)))
    }
  )
}
