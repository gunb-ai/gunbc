module v2.std.optional_layers

import std.nat { Nat, Succ, Zero, nat_add }
import std.optional { Absent, Optional, Present, optional_absent, optional_present }
import std.occurrence_identity { OccurrenceSynthetic }
import v2.std.cardinality { NonZeroNat }
import v2.std.node {
  Cardinality,
  ComputationNode,
  Edge,
  Node,
  Positional,
  TypeNode
}
import v2.std.node_query { node_positional_child_targets }
import v2.std.collection { list_at_optional }

// WHAT NonZeroNat CANNOT CARRY (parent ruling B, smart-gull-336): zero optional layers
// (`Required`), compose/peel over Required mixed with a positive count, and the Node
// Cardinality-wrapper reading. Layer COUNT is v2.std.cardinality NonZeroNat { prev: Nat } — every
// value is a successor, so zero layers is unconstructible on CardOptional (gunbc#13488: `layers:
// Nat` was forbidden because Nat admits Zero). Mapping: OneLayer = NonZeroNat { prev: Zero };
// MoreLayers { inner: t } = NonZeroNat { prev: Succ corresponding to t }.
//
// CONSUMERS (DESIGN §3c): type_node_cardinality_read / wrap_type_node_cardinality; production
// v2.compiler.infer infer_match_generic_formal peels with peel_optional_layer;
// v2.std.inhabitance declared_type_inhabitance refuses two CardOptional counts that
// TypeCardinality equality (`==`) denies. Claims: test.claim.optional_layers_witness_test and
// v2.test.claim.compiler.optional_layers_test.
type TypeCardinality
  = Required
  | CardOptional { layers: NonZeroNat }

type TypeNodeCardinalityRead
  = TypeNodeCardinality { card: TypeCardinality, base: Node }
  | CardinalityWrapperMalformed { wrapper: Node }

fn one_optional_layer() -> TypeCardinality {
  CardOptional { layers: NonZeroNat { prev: Zero } }
}

fn two_optional_layers() -> TypeCardinality {
  CardOptional { layers: NonZeroNat { prev: Succ { prev: Zero } } }
}

fn compose_optional_layers(outer: TypeCardinality, inner: TypeCardinality) -> TypeCardinality {
  match outer {
    Required => inner
    CardOptional { layers: ol } =>
      match inner {
        Required => CardOptional { layers: ol }
        CardOptional { layers: il } =>
          CardOptional { layers: NonZeroNat { prev: Succ { prev: nat_add(a: ol.prev, b: il.prev) } } }
      }
  }
}

fn peel_optional_layer(card: TypeCardinality) -> Optional<TypeCardinality> {
  match card {
    Required => optional_absent()
    CardOptional { layers: n } =>
      match n {
        NonZeroNat { prev: e } =>
          match e {
            Zero => optional_present(value: Required)
            Succ { prev: rest } => optional_present(value: CardOptional { layers: NonZeroNat { prev: rest } })
          }
      }
  }
}

fn type_node_cardinality_child(n: Node) -> Optional<Node> {
  match n.kind {
    TypeNode { connective: Cardinality } =>
      match list_at_optional(xs: node_positional_child_targets(node: n), index: 0) {
        Present { value: inner } => optional_present(value: inner)
        Absent => optional_absent()
      }
    TypeNode { connective: _ } => optional_absent()
    ComputationNode { behavior: _ } => optional_absent()
  }
}

fn type_node_cardinality_read(n: Node) -> TypeNodeCardinalityRead {
  match type_node_cardinality_child(n: n) {
    Absent =>
      match n.kind {
        TypeNode { connective: Cardinality } => CardinalityWrapperMalformed { wrapper: n }
        TypeNode { connective: _ } => TypeNodeCardinality { card: Required, base: n }
        ComputationNode { behavior: _ } => TypeNodeCardinality { card: Required, base: n }
      }
    Present { value: inner } =>
      match type_node_cardinality_read(n: inner) {
        CardinalityWrapperMalformed { wrapper: w } => CardinalityWrapperMalformed { wrapper: w }
        TypeNodeCardinality { card: inner_card, base: base } =>
          TypeNodeCardinality { card: compose_optional_layers(outer: one_optional_layer(), inner: inner_card), base: base }
      }
  }
}

fn wrap_one_optional_layer(base: Node) -> Node {
  Node {
    kind: TypeNode { connective: Cardinality },
    children: [Edge { label: Positional, target: base }],
    occurrence_id: OccurrenceSynthetic
  }
}

fn wrap_nonzero_optional_layers(base: Node, layers: NonZeroNat) -> Node {
  match layers {
    NonZeroNat { prev: e } =>
      match e {
        Zero => wrap_one_optional_layer(base: base)
        Succ { prev: rest } => wrap_one_optional_layer(base: wrap_nonzero_optional_layers(base: base, layers: NonZeroNat { prev: rest }))
      }
  }
}

fn wrap_type_node_cardinality(base: Node, card: TypeCardinality) -> Node {
  match card {
    Required => base
    CardOptional { layers: layers } => wrap_nonzero_optional_layers(base: base, layers: layers)
  }
}
