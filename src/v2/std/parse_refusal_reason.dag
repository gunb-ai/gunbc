module v2.std.parse_refusal_reason

import v2.std.node { Symbol }

// THE PARSE STAGE'S REFUSAL-REASON VOCABULARY, CLOSED. A grammar row that names why it refuses
// (`v2.std.grammar` `Expect`) names one of these variants, so a misspelled or invented reason fails
// to typecheck instead of becoming a new reason; the type IS the roster, and there is no second
// list to drift from it. It is scoped to the parse stage, not to Expect: a later parse refusal
// joins this carrier as one more variant.
//
//   FnExpressionBodyMissingAfterEq -- an expression-bodied `fn ... =` with no expression after `=`.
//   DataValueMissingAfterEq        -- a `data name: Type =` with no value expression after `=`.
//   LayoutUnknownWithoutSource     -- a layout-conditioned production (v2.std.grammar
//                                     AfterLineBreak) was reached on a token stream that carries no
//                                     source, so whether a line break precedes the match has no
//                                     answer; the parse refuses rather than assume one line.
//   KeywordAsPathSegment           -- a declared module or import path continues with `.` and a
//                                     keyword the path-segment rule does not admit
//                                     (`module rt.match`); located at the keyword.
//   NewlineBeforeDualRoleOperator  -- a `-` (both prefix and infix) begins a line after a complete
//                                     operand. It could continue the expression or start a new one,
//                                     so it refuses, as the seed does (v1.compiler.parse
//                                     is_ambiguous_prefix_infix_newline_boundary): move the operator
//                                     before the newline, or parenthesize the unary expression.
//   LetInExpressionDropped         -- a `let NAME = value` continues with `in`. The expression form
//                                     `let x = e in body` was dropped (statement `let` only, per the
//                                     2026-10-02 zero-ambiguity decisions): bind with a statement
//                                     `let` and write the body as the following statement. Located
//                                     at the `in`.
//   DeclarationMarkerNotTest       -- an identifier other than `test` stands where the declaration
//                                     marker goes, before `fn` or `data` (`probe fn ..`); located at
//                                     the marker and the keyword after it.
//   KeywordAsValueName             -- a keyword stands where a VALUE NAME is introduced: a parameter
//                                     (`then: Node`), a `let` binder, a `node NAME` / `NAME =` binder,
//                                     or a field-pattern binder (`{ module: module }`, `{ module }`).
//                                     A keyword is not an identifier; a field LABEL may still be one
//                                     (`x.module`, `Rec { module: e }`). Located at the keyword.
//   TokenStartsNotIncreasing       -- the token stream handed to the parse does not have strictly
//                                     increasing token starts. A stream position IS its token's
//                                     start (v2.compiler.parse parse_current_position identifies a
//                                     stream position and decides repeat progress by it), so two
//                                     tokens at one start would be one position and the parse would
//                                     silently take one's progress for the other's. Located at the first token whose start
//                                     does not exceed its predecessor's.
type ParseRefusalReason =
    FnExpressionBodyMissingAfterEq
  | DataValueMissingAfterEq
  | LayoutUnknownWithoutSource
  | KeywordAsPathSegment
  | NewlineBeforeDualRoleOperator
  | LetInExpressionDropped
  | DeclarationMarkerNotTest
  | KeywordAsValueName
  | TokenStartsNotIncreasing

// The diagnostic identity each reason refuses under (`v2.std.diagnostic` `Diagnostic.reason`).
fn parse_refusal_reason_symbol(reason: ParseRefusalReason) -> Symbol {
  match reason {
    FnExpressionBodyMissingAfterEq => ^parse_fn_expression_body_missing_after_eq
    DataValueMissingAfterEq => ^parse_data_value_missing_after_eq
    LayoutUnknownWithoutSource => ^parse_layout_unknown_without_source
    KeywordAsPathSegment => ^parse_keyword_as_path_segment
    NewlineBeforeDualRoleOperator => ^parse_newline_before_dual_role_operator
    LetInExpressionDropped => ^parse_let_in_expression_dropped
    DeclarationMarkerNotTest => ^parse_declaration_marker_not_test
    KeywordAsValueName => ^parse_keyword_as_value_name
    TokenStartsNotIncreasing => ^parse_token_starts_not_increasing
  }
}
