module v2.std.parse_refusal_reason

import v2.std.node { Symbol }

// THE PARSE STAGE'S REFUSAL-REASON VOCABULARY, CLOSED. A grammar row that names why it refuses
// (`v2.std.grammar` `Expect`) names one of these variants, so a misspelled or invented reason fails
// to typecheck instead of becoming a new reason; the type IS the roster, and there is no second
// list to drift from it. It is scoped to the parse stage, not to Expect: a later parse refusal
// joins this carrier as one more variant.
//
//   FnExpressionBodyMissingAfterEq -- an expression-bodied `fn ... =` with no expression after `=`.
//   DataValueMissingAfterEq        -- a `data name: Type =` with no value expression after `=`.
//   LayoutUnknownWithoutSource     -- a layout-conditioned production (v2.std.grammar
//                                     AfterLineBreak) was reached on a token stream that carries no
//                                     source, so whether a line break precedes the match has no
//                                     answer; the parse refuses rather than assume one line.
//   KeywordAsPathSegment           -- a declared module or import path continues with `.` and a
//                                     keyword the path-segment rule does not admit
//                                     (`module rt.match`); located at the keyword.
type ParseRefusalReason =
    FnExpressionBodyMissingAfterEq
  | DataValueMissingAfterEq
  | LayoutUnknownWithoutSource
  | KeywordAsPathSegment

// The diagnostic identity each reason refuses under (`v2.std.diagnostic` `Diagnostic.reason`).
fn parse_refusal_reason_symbol(reason: ParseRefusalReason) -> Symbol {
  match reason {
    FnExpressionBodyMissingAfterEq => ^parse_fn_expression_body_missing_after_eq
    DataValueMissingAfterEq => ^parse_data_value_missing_after_eq
    LayoutUnknownWithoutSource => ^parse_layout_unknown_without_source
    KeywordAsPathSegment => ^parse_keyword_as_path_segment
  }
}
