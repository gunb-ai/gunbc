module v2.test.std_grounding.value_carrier_laws


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn sharing_unobservable_list_holds() -> Bool {
  let shared = [1, 2, 3]
  let aliased = concat(shared, shared)
  let fresh = [1, 2, 3, 1, 2, 3]
  aliased == fresh
}

test fn sharing_unobservable_map_holds() -> Bool {
  let base = v2.std.collection.empty_map() |> v2.std.collection.map_insert("k", 1)
  let alias = base
  alias == (v2.std.collection.empty_map() |> v2.std.collection.map_insert("k", 1))
}

test fn map_equality_insert_order_independent_holds() -> Bool {
  let abc = v2.std.collection.empty_map() |> v2.std.collection.map_insert("a", 1) |> v2.std.collection.map_insert("b", 2) |> v2.std.collection.map_insert("c", 3)
  let cba = v2.std.collection.empty_map() |> v2.std.collection.map_insert("c", 3) |> v2.std.collection.map_insert("b", 2) |> v2.std.collection.map_insert("a", 1)
  let bca = v2.std.collection.empty_map() |> v2.std.collection.map_insert("b", 2) |> v2.std.collection.map_insert("c", 3) |> v2.std.collection.map_insert("a", 1)
  (abc == cba) && (abc == bca)
}

test fn map_equality_overwrite_path_independent_holds() -> Bool {
  let direct = v2.std.collection.empty_map() |> v2.std.collection.map_insert("a", 2)
  let overwritten = v2.std.collection.empty_map() |> v2.std.collection.map_insert("a", 1) |> v2.std.collection.map_insert("a", 2)
  direct == overwritten
}

test fn freemonoid_association_unobservable_holds() -> Bool {
  let left_assoc = concat(concat([1], [2]), [3])
  let right_assoc = concat([1], concat([2], [3]))
  let flat = [1, 2, 3]
  (left_assoc == flat) && (right_assoc == flat)
}

test fn identity_law1_projection_holds() -> Bool {
  let ref_identical = v2.std.runtime.identity_evidence_equal(evidence: v2.std.runtime.ReferenceIdentical)
  let compared_equal = v2.std.runtime.identity_evidence_equal(evidence: v2.std.runtime.StructurallyCompared { equal: true })
  let compared_distinct = v2.std.runtime.identity_evidence_equal(evidence: v2.std.runtime.StructurallyCompared { equal: false })
  ref_identical && compared_equal && !compared_distinct
}

test fn declared_carriers_preserve_prior_versions_holds() -> Bool {
  let map_preserves = match map_carrier.update_persistence {
    v2.std.value_carrier.PersistentUpdate => true
    v2.std.value_carrier.EphemeralUpdate => false
  }
  let list_preserves = match list_carrier.update_persistence {
    v2.std.value_carrier.PersistentUpdate => true
    v2.std.value_carrier.EphemeralUpdate => false
  }
  map_preserves && list_preserves
}

test fn storage_and_update_persistence_axes_coexist_holds() -> Bool {
  let storage: extdeps.storage.types.PersistenceKind = extdeps.storage.types.Ephemeral
  let update: v2.std.value_carrier.UpdateVersionPersistence = v2.std.value_carrier.PersistentUpdate
  (storage == extdeps.storage.types.Ephemeral) && (update == v2.std.value_carrier.PersistentUpdate)
}

test fn name_interning_covers_all_domains_holds() -> Bool {
  let t = match type_name_interning.domain {
    v2.std.value_carrier.TypeNames => true
    v2.std.value_carrier.VariantNames => false
    v2.std.value_carrier.FieldNames => false
  }
  let v = match variant_name_interning.domain {
    v2.std.value_carrier.VariantNames => true
    v2.std.value_carrier.TypeNames => false
    v2.std.value_carrier.FieldNames => false
  }
  let f = match field_name_interning.domain {
    v2.std.value_carrier.FieldNames => true
    v2.std.value_carrier.TypeNames => false
    v2.std.value_carrier.VariantNames => false
  }
  t && v && f
}

test fn list_prior_version_survives_concat_holds() -> Bool {
  let base = [1, 2, 3]
  let extended = concat(base, [4])
  (base == [1, 2, 3]) && (extended == [1, 2, 3, 4])
}

test fn map_prior_version_survives_insert_holds() -> Bool {
  let base = v2.std.collection.empty_map() |> v2.std.collection.map_insert("k", 1)
  let updated = base |> v2.std.collection.map_insert("k", 2)
  let base_intact = base == (v2.std.collection.empty_map() |> v2.std.collection.map_insert("k", 1))
  let update_took = updated == (v2.std.collection.empty_map() |> v2.std.collection.map_insert("k", 2))
  base_intact && update_took && !(updated == base)
}
