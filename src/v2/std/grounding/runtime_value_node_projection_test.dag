module v2.test.std_grounding.runtime_value_node_projection


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn rvnp_test_type_node(sym: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: sym } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn rvnp_test_byte() -> std.bit.Byte {
  std.bit.Byte { bits: [true] }
}

fn rvnp_test_primitive_value() -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimePrimitive {
    value: v2.std.runtime.RuntimePrimitiveValue {
      primitive_type: rvnp_test_type_node(sym: ^rvnp_test_i64_sym),
      bytes: [rvnp_test_byte()]
    }
  }
}

fn rvnp_test_aggregate_value() -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimeAggregate {
    value: v2.std.runtime.RuntimeAggregateValue {
      aggregate_type: rvnp_test_type_node(sym: ^rvnp_test_pair_sym),
      fields: [
        v2.std.runtime.RuntimeFieldValue {
          field: ^rvnp_test_left_field,
          value: rvnp_test_primitive_value()
        },
        v2.std.runtime.RuntimeFieldValue {
          field: ^rvnp_test_right_field,
          value: rvnp_test_primitive_value()
        }
      ]
    }
  }
}

fn rvnp_test_aggregate_with_reference_field() -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimeAggregate {
    value: v2.std.runtime.RuntimeAggregateValue {
      aggregate_type: rvnp_test_type_node(sym: ^rvnp_test_pair_sym),
      fields: [
        v2.std.runtime.RuntimeFieldValue {
          field: ^rvnp_test_left_field,
          value: v2.std.runtime.RuntimeReference {
            value: v2.std.runtime.RuntimeReferenceValue {
              reference_type: rvnp_test_type_node(sym: ^rvnp_test_ref_sym),
              identity: v2.std.runtime.RuntimeIdentity { identity: ^rvnp_test_ref_id },
              referent_type: rvnp_test_type_node(sym: ^rvnp_test_i64_sym)
            }
          }
        }
      ]
    }
  }
}

fn rvnp_test_reference_value() -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimeReference {
    value: v2.std.runtime.RuntimeReferenceValue {
      reference_type: rvnp_test_type_node(sym: ^rvnp_test_ref_sym),
      identity: v2.std.runtime.RuntimeIdentity { identity: ^rvnp_test_ref_id },
      referent_type: rvnp_test_type_node(sym: ^rvnp_test_i64_sym)
    }
  }
}

fn rvnp_test_closure_value() -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimeClosure {
    value: v2.std.runtime.RuntimeClosureValue {
      arrow_type: rvnp_test_type_node(sym: ^rvnp_test_arrow_sym),
      arrow: rvnp_test_type_node(sym: ^rvnp_test_arrow_body_sym),
      environment: v2.std.runtime.EvaluationEnvironment { bindings: std.algebra.Empty }
    }
  }
}

fn rvnp_test_unit_value() -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimeUnit {
    value: v2.std.runtime.RuntimeUnitValue {
      unit_type: rvnp_test_type_node(sym: ^rvnp_test_unit_sym)
    }
  }
}

fn rvnp_test_is_projected(value: v2.std.runtime.RuntimeValue) -> v2.std.logic.Bool {
  match runtime_value_node_projection(value: value) {
    RuntimeValueNodeProjected { node: _ } => true
    RuntimeValueNodeUnrepresentable => false
  }
}

fn rvnp_test_is_unrepresentable(value: v2.std.runtime.RuntimeValue) -> v2.std.logic.Bool {
  match runtime_value_node_projection(value: value) {
    RuntimeValueNodeProjected { node: _ } => false
    RuntimeValueNodeUnrepresentable => true
  }
}

fn primitive_projection_type_and_bytes_round_trip(value: v2.std.runtime.RuntimeValue) -> v2.std.logic.Bool {
  let expected_type = rvnp_test_type_node(sym: ^rvnp_test_i64_sym)
  match runtime_value_node_projection(value: value) {
    RuntimeValueNodeProjected { node: projected } =>
      match find_named_child(root: projected, name: ^runtime_primitive_type_node_projection) {
        Accepted { value: type_node, diagnostics: _ } =>
          match find_named_child(root: projected, name: ^runtime_primitive_bytes_node_projection) {
            Accepted { value: _, diagnostics: _ } => type_node == expected_type
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    RuntimeValueNodeUnrepresentable => false
  }
}

fn primitive_projection_bytes_edge_present(value: v2.std.runtime.RuntimeValue) -> v2.std.logic.Bool {
  match runtime_value_node_projection(value: value) {
    RuntimeValueNodeProjected { node: projected } =>
      match find_named_child(root: projected, name: ^runtime_primitive_bytes_node_projection) {
        Accepted { value: _, diagnostics: _ } => true
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    RuntimeValueNodeUnrepresentable => false
  }
}

fn red_reference_fabrication_would_break_aggregate_fail_closed() -> v2.std.logic.Bool {
  rvnp_test_is_unrepresentable(value: rvnp_test_aggregate_with_reference_field())
}

test fn runtime_value_node_projection_honest_partial_holds() -> v2.std.logic.Bool {
  primitive_projection_type_and_bytes_round_trip(value: rvnp_test_primitive_value())
    && primitive_projection_bytes_edge_present(value: rvnp_test_primitive_value())
    && rvnp_test_is_projected(value: rvnp_test_aggregate_value())
    && rvnp_test_is_unrepresentable(value: rvnp_test_reference_value())
    && rvnp_test_is_unrepresentable(value: rvnp_test_closure_value())
    && rvnp_test_is_unrepresentable(value: rvnp_test_unit_value())
    && red_reference_fabrication_would_break_aggregate_fail_closed()
}
