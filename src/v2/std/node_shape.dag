module v2.std.node_shape

import v2.std.algebra { Empty, fold_list, list_snoc_item }
import v2.std.collection { List }
import v2.std.node {
  Atom,
  Behavior,
  ComputationNode,
  Connective,
  Edge,
  EdgeLabel,
  EdgeShape,
  Named,
  Node,
  NodeKind,
  NodeOccurrenceId,
  NodeShape,
  Positional,
  Symbol,
  SyntheticOccurrence,
  TypeNode,
  node_with_occurrence_id
}

fn edge_shape(label: EdgeLabel, target: NodeShape) -> EdgeShape {
  EdgeShape { label: label, target: target }
}

fn named_edge_shape(name: Symbol, target: NodeShape) -> EdgeShape {
  edge_shape(label: Named { name: name }, target: target)
}

fn positional_edge_shape(target: NodeShape) -> EdgeShape {
  edge_shape(label: Positional, target: target)
}

fn node_shape(kind: NodeKind, children: List<EdgeShape>) -> NodeShape {
  NodeShape { kind: kind, children: children }
}

fn type_shape(connective: Connective, children: List<EdgeShape>) -> NodeShape {
  node_shape(kind: TypeNode { connective: connective }, children: children)
}

fn atom_shape(identity: Symbol) -> NodeShape {
  type_shape(connective: Atom { identity: identity }, children: [])
}

fn computation_shape(behavior: Behavior, children: List<EdgeShape>) -> NodeShape {
  node_shape(kind: ComputationNode { behavior: behavior }, children: children)
}

fn stamp_edge_shape(e: EdgeShape) -> Edge {
  Edge { label: e.label, target: stamp_node_shape_synthetic(shape: e.target) }
}

fn stamp_edge_shape_list(shapes: List<EdgeShape>) -> List<Edge> {
  fold_list(
    xs: shapes,
    empty: Empty,
    cons: fn(acc, es) {
      list_snoc_item(xs: acc, item: stamp_edge_shape(e: es))
    }
  )
}

fn stamp_node_shape(shape: NodeShape, occurrence_id: NodeOccurrenceId) -> Node {
  node_with_occurrence_id(
    kind: shape.kind,
    children: stamp_edge_shape_list(shapes: shape.children),
    occurrence_id: occurrence_id
  )
}

fn stamp_node_shape_synthetic(shape: NodeShape) -> Node {
  stamp_node_shape(shape: shape, occurrence_id: SyntheticOccurrence)
}
