module v2.std.node_shape


fn edge_shape(label: v2.std.node.EdgeLabel, target: v2.std.node.NodeShape) -> v2.std.node.EdgeShape {
  v2.std.node.EdgeShape { label: label, target: target }
}

fn named_edge_shape(name: v2.std.node.Symbol, target: v2.std.node.NodeShape) -> v2.std.node.EdgeShape {
  edge_shape(label: Named { name: name }, target: target)
}

fn positional_edge_shape(target: v2.std.node.NodeShape) -> v2.std.node.EdgeShape {
  edge_shape(label: Positional, target: target)
}

fn node_shape(kind: v2.std.node.NodeKind, children: List<v2.std.node.EdgeShape>) -> v2.std.node.NodeShape {
  v2.std.node.NodeShape { kind: kind, children: children }
}

fn type_shape(connective: v2.std.node.Connective, children: List<v2.std.node.EdgeShape>) -> v2.std.node.NodeShape {
  node_shape(kind: v2.std.node.TypeNode { connective: connective }, children: children)
}

fn atom_shape(identity: v2.std.node.Symbol) -> v2.std.node.NodeShape {
  type_shape(connective: v2.std.node.Atom { identity: identity }, children: [])
}

fn computation_shape(behavior: v2.std.node.Behavior, children: List<v2.std.node.EdgeShape>) -> v2.std.node.NodeShape {
  node_shape(kind: v2.std.node.ComputationNode { behavior: behavior }, children: children)
}

fn stamp_edge_shape(e: v2.std.node.EdgeShape) -> v2.std.node.Edge {
  v2.std.node.Edge { label: e.label, target: stamp_node_shape_synthetic(shape: e.target) }
}

fn stamp_edge_shape_list(shapes: List<v2.std.node.EdgeShape>) -> List<v2.std.node.Edge> {
  fold_list(
    xs: shapes,
    empty: std.algebra.Empty,
    cons: fn(acc, es) {
      list_snoc_item(xs: acc, item: stamp_edge_shape(e: es))
    }
  )
}

fn stamp_node_shape(shape: v2.std.node.NodeShape, occurrence_id: v2.std.node.NodeOccurrenceId) -> Node {
  node_with_occurrence_id(
    kind: shape.kind,
    children: stamp_edge_shape_list(shapes: shape.children),
    occurrence_id: occurrence_id
  )
}

fn stamp_node_shape_synthetic(shape: v2.std.node.NodeShape) -> Node {
  stamp_node_shape(shape: shape, occurrence_id: SyntheticOccurrence)
}
