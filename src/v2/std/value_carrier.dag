module v2.std.value_carrier

import v2.std.node { Symbol }

type UpdateVersionPersistence = EphemeralUpdate | PersistentUpdate

data update_version_persistence_note: String = "UpdateVersionPersistence names the value-carrier axis it classifies: in the Driscoll/Sarnak/Sleator/Tarjan sense, PersistentUpdate means an update preserves the prior version for continued use and EphemeralUpdate means it does not. This is distinct from extdeps.storage.types.PersistenceKind, which describes the lifecycle of a storage device or medium. The subject-bearing type name removes the concept fork. Type-qualified UpdateVersionPersistence.Persistent and UpdateVersionPersistence.Ephemeral were attempted first, preserving the literature's bare variant names, but execution refused both as absent fields and variants. This is the corpus-wide language gap: dag/ and src/v2/ contain no type-to-variant projection; every accepted dotted constructor is a module-member path. The variants therefore carry the Update suffix because keeping bare Persistent and Ephemeral would leave references ambiguous with the storage variants until the namespace projection model admits its variant arm."

type CarrierCost {
  update_work: String
  lookup_work: String
}

type CarrierDeclaration {
  collection: Symbol
  carrier: Symbol
  update_persistence: UpdateVersionPersistence
  cost: CarrierCost
}

data map_carrier: CarrierDeclaration = {
  collection: ^map_collection,
  carrier: ^hash_array_mapped_trie,
  update_persistence: PersistentUpdate,
  cost: { update_work: "log32 n", lookup_work: "log32 n" }
}

data list_carrier: CarrierDeclaration = {
  collection: ^list_collection,
  carrier: ^relaxed_radix_balanced_tree,
  update_persistence: PersistentUpdate,
  cost: { update_work: "log n", lookup_work: "log n" }
}

type NameDomain = TypeNames | VariantNames | FieldNames

type NameInterningDeclaration {
  domain: NameDomain
  authority: Symbol
  representation: Symbol
}

data type_name_interning: NameInterningDeclaration = {
  domain: TypeNames,
  authority: ^resolved_graph_declared_types,
  representation: ^interned_symbol_id
}

data variant_name_interning: NameInterningDeclaration = {
  domain: VariantNames,
  authority: ^resolved_graph_declared_variants,
  representation: ^interned_symbol_id
}

data field_name_interning: NameInterningDeclaration = {
  domain: FieldNames,
  authority: ^resolved_graph_declared_fields,
  representation: ^positional_slot_in_declared_field_order
}
