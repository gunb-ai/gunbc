module v2.std.value_carrier


type UpdateVersionPersistence = EphemeralUpdate | PersistentUpdate

data update_version_persistence_note: String = "UpdateVersionPersistence names the value-carrier axis it classifies: in the Driscoll/Sarnak/Sleator/Tarjan sense, PersistentUpdate means an update preserves the prior version for continued use and EphemeralUpdate means it does not. This is distinct from extdeps.storage.types.PersistenceKind, which describes the lifecycle of a storage device or medium. The subject-bearing type name removes the concept fork. Type-qualified UpdateVersionPersistence.Persistent and UpdateVersionPersistence.Ephemeral were attempted first, preserving the literature's bare variant names, but execution refused both as absent fields and variants. This is the corpus-wide language gap: dag/ and src/v2/ contain no type-to-variant projection; every accepted dotted constructor is a module-member path. Until the gap closes, a consumer CANNOT rely on Type.Variant resolving from its lexical position, so variants imported into one scope must keep distinct bare names rather than depending on qualification to discharge ambiguity. The variants therefore carry the Update suffix. dissolve-on: feature:indexed-variant-path-projectable — the namespace-only-resolution lane makes the already-indexed type-to-variant containment path projectable from the referencing position; then this type restores Ephemeral | Persistent and every consumer projects those variants through UpdateVersionPersistence."

type CarrierCost {
  update_work: String
  lookup_work: String
}

type CarrierDeclaration {
  collection: Symbol
  carrier: Symbol
  update_persistence: UpdateVersionPersistence
  cost: CarrierCost
}

data map_carrier: CarrierDeclaration = {
  collection: ^map_collection,
  carrier: ^hash_array_mapped_trie,
  update_persistence: PersistentUpdate,
  cost: { update_work: "log32 n", lookup_work: "log32 n" }
}

data list_carrier: CarrierDeclaration = {
  collection: ^list_collection,
  carrier: ^relaxed_radix_balanced_tree,
  update_persistence: PersistentUpdate,
  cost: { update_work: "log n", lookup_work: "log n" }
}

type NameDomain = TypeNames | VariantNames | FieldNames

type NameInterningDeclaration {
  domain: NameDomain
  authority: Symbol
  representation: Symbol
}

data type_name_interning: NameInterningDeclaration = {
  domain: TypeNames,
  authority: ^resolved_graph_declared_types,
  representation: ^interned_symbol_id
}

data variant_name_interning: NameInterningDeclaration = {
  domain: VariantNames,
  authority: ^resolved_graph_declared_variants,
  representation: ^interned_symbol_id
}

data field_name_interning: NameInterningDeclaration = {
  domain: FieldNames,
  authority: ^resolved_graph_declared_fields,
  representation: ^positional_slot_in_declared_field_order
}
