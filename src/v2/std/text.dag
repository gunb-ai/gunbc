module v2.std.text

type String = std.algebra.FreeMonoid<std.types.Char>

type HostStringText {
  text: String
}

fn host_string_text(text: String) -> HostStringText {
  HostStringText { text: text }
}
fn host_string_text_value(value: HostStringText) -> String {
  value.text
}

fn host_string_text_from_rust_host(host: String) -> String {
  host_string_text_value(host_string_text(text: host))
}
fn host_string_text_to_rust_host(text: String) -> String {
  host_string_text_value(host_string_text(text: text))
}

type CharResult
  = CharFound { value: std.types.Char }
  | CharAbsent

fn string_is_empty(s: String) -> Bool {
  v2.std.algebra.is_empty(xs: s)
}
fn string_head(s: String) -> CharResult {
  match v2.std.algebra.list_head(xs: s) {
    v2.std.algebra.HeadFound { value: c } => CharFound { value: c }
    v2.std.algebra.HeadAbsent => CharAbsent
  }
}
fn string_tail(s: String) -> v2.std.algebra.ListTailResult<std.types.Char> {
  v2.std.algebra.list_tail(xs: s)
}

type SourceFold<R> {
  init: fn(String) -> R
  step: fn(R) -> R
  is_done: fn(R) -> Bool
}

fn fold_source<R>(src: String, algebra: SourceFold<R>) -> R {
  v2.std.algebra.fold_list(
    xs: src,
    empty: algebra.init(src),
    cons: fn(acc, _) {
      match algebra.is_done(acc) {
        true => acc
        false => algebra.step(acc)
      }
    }
  )
}
