module v2.std.text

import v2.std.algebra { FreeMonoid, ListTailResult, TailAbsent, TailFound, fold_list, fold_list_right, is_empty, list_tail }
import v2.std.logic { Bool }
import v2.std.nat { Nat }
import v2.std.node {
  Hash,
  atom_identity_hash,
  byte_limb_hash_peano_digest,
  combine_hash
}
type Char = Nat
type String = FreeMonoid<Char>

type HostStringText {
  text: String
}

fn host_string_text(text: String) -> HostStringText {
  HostStringText { text: text }
}
fn host_string_text_value(value: HostStringText) -> String {
  value.text
}

fn host_string_text_from_rust_host(host: String) -> String {
  host_string_text_value(host_string_text(text: host))
}
fn host_string_text_to_rust_host(text: String) -> String {
  host_string_text_value(host_string_text(text: text))
}

type CharResult
  = CharFound { value: Char }
  | CharAbsent

fn string_is_empty(s: String) -> Bool {
  is_empty(xs: s)
}
fn string_head(s: String) -> CharResult {
  fold_list_right(xs: s, empty: CharAbsent, snoc: fn(_acc, c) { CharFound { value: c } })
}
fn string_tail(s: String) -> ListTailResult<Char> {
  list_tail(xs: s)
}

type SourceFold<R> {
  init: fn(String) -> R
  step: fn(R) -> R
  is_done: fn(R) -> Bool
}

fn fold_source<R>(src: String, algebra: SourceFold<R>) -> R {
  fold_list(
    xs: src,
    empty: algebra.init(src),
    cons: fn(acc, _) {
      match algebra.is_done(acc) {
        true => acc
        false => algebra.step(acc)
      }
    }
  )
}

fn source_text_code_unit_digest(text: String) -> Hash {
  fold_list(
    xs: text,
    empty: atom_identity_hash(s: ^source_text_code_unit_digest_nil),
    cons: fn(acc, ch) {
      combine_hash(a: acc, b: byte_limb_hash_peano_digest(limb: ch))
    }
  )
}
