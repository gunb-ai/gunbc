module v2.std.type_binder

import std.types { List }
import std.algebra { Cons, Empty, list_snoc_item }
import v2.std.algebra { zip_map }
import v2.std.optional { Optional, Present, Absent, optional_present, optional_absent }
import v2.std.arrow_contract { arrow_contract_conforms }
import v2.std.arrow_signature { signature_order_edge, arrow_signature_order_head_is_list_introduction }
import v2.std.node_query { binder_node_parts }
import v2.std.node {
  MatchArmScopeExitEdge,
  arrow_named_edge_is_non_binder,
  arrow_first_positional_target,
  FirstPositionalFound,
  FirstPositionalAbsent,
  NotMarkedReference,
  resolved_reference_body_kind,
  Arrow,
  Atom,
  Instantiation,
  Behavior,
  Bind,
  ComputationNode,
  Conj,
  Edge,
  Authored,
  Node,
  Positional,
  Symbol,
  Transform,
  TypeNode,
  match_arm_pattern_edge,
  arrow_signature_order_label,
  arrow_named_edge_is_contract,
  node_subtree_nodes,
  node_synthetic,
  type_binder_conj_conforms,
  CastTargetEdge,
  TypeAliasEdge,
  TypeAnnotationEdge,
  TypeBodyEdge,
  TypeParamsEdge,
  BinderTypeEdge,
  arrow_signature_order_read,
  OrderAbsent,
  OrderLabels,
  OrderUnreadable,
  edge_is_core,
  core_edge_label,
  ArrowBodyEdge,
  ArrowSignatureOrderEdge,
  StructuralLabel,
  edge_is_core,
  is_positional,
}

// THE EDGE THAT CARRIES A DECLARATION'S TYPE PARAMETERS. One label for one concept: `fn f<T>` carries
// its binder Conj on its Arrow under this label, and `type Box<T>` / `type R<T> { .. }` carry theirs
// on the declaration, in the wrapper below, under the same label.
//
// THE LABEL IS UNAUTHORABLE, NOT MERELY REFUSED. This lexeme is not an identifier in the dag grammar
// -- the precedent is v2.std.qualified_name declaration_reference_marker -- so no authored field,
// variant, binder or name can carry it, and only the producers below write it. The shape of the Conj
// it targets is v2.std.node's (type_binder_conj_conforms).

// The wrapper's other edge: the declaration's member (the record's field Conj, the coproduct's Disj).

// The alias wrapper's other edge: the aliased type expression (`type List<T> = FreeMonoid<T>`). A
// distinct label from <type-body>, because an aliased expression is not a member -- it declares no
// fields or variants -- and a reader telling the two apart by the target's KIND would be the hidden
// sum gunbc#12240 review 71065 refused (a qualified head can lower to a Conj spine that reads as a
// record).

fn edge_is_type_alias(e: Edge) -> Bool {
  edge_is_core(e: e, marker: TypeAliasEdge)
}

fn edge_is_type_params(e: Edge) -> Bool {
  edge_is_core(e: e, marker: TypeParamsEdge)
}

fn edge_is_type_body(e: Edge) -> Bool {
  edge_is_core(e: e, marker: TypeBodyEdge)
}

// THE ONE PRODUCER of the edge on an Arrow (consumed by v2.compiler.body_lowering_fold).
fn type_params_edge(conj: Node) -> Edge {
  Edge { label: core_edge_label(marker: TypeParamsEdge), target: conj }
}

// A GENERIC TYPE DECLARATION'S TARGET IS A WRAPPER BESIDE ITS MEMBER, NEVER A MEMBER WITH ITS
// BINDERS MIXED IN. `type Box<T> = Full { value: T } | Empty` lowers its Named declaration edge to
// Conj { <type-parameters>: Conj { T: T }, <type-body>: Disj { Full: .., Empty: .. } }. The member's
// children stay exactly its authored fields or variants, so no reader of a member can meet a binder:
// the state "a binder edge among a member's children" has no producer, and
// type_binder_labels_conform refuses it on any tree resolve is handed (gunbc#12240 review 71065
// ruled the mixed-in shape a hidden sum). THE ONE PRODUCER of the wrapper.
fn type_decl_wrapper(binders: Node, member: Node) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: core_edge_label(marker: TypeParamsEdge), target: binders },
      Edge { label: core_edge_label(marker: TypeBodyEdge), target: member }
    ]
  )
}

// THE ONE UNWRAP, TYPED. A reader of a declaration target has four cases, and this function is the
// only place they are told apart: no reader pattern-matches the raw wrapper. Consumed by
// v2.compiler.symbol_index_fill (which indexes a member, never a wrapper) and
// v2.std.compilers.semantic_decl_emission (which renders a plain member and refuses the rest).
//
// FOUR SHAPES, TOLD APART BY EDGE LABEL AND NEVER BY A TARGET'S KIND: a generic member
// (<type-body>, type_decl_wrapper), an aliased type expression (<type-alias>, type_alias_wrapper), a
// bodyless declaration carrying its binders alone (type_opaque_wrapper), and a non-generic member --
// a record or coproduct -- which is its own target. THE ALIAS AND OPAQUE ARMS ARE CARDINALITY-NEUTRAL:
// every alias and every bodyless declaration is wrapped, and its binder Conj may be empty
// (v2.compiler.body_lowering_fold body_lower_decl_binders), so `TypeAlias` means "this name aliases
// that type expression", never "this declaration is generic". A reader that needs to know whether a
// declaration binds parameters asks the binders, not the arm. Before this, a plain alias or plain
// bodyless declaration was left as its parse shell and fell into PlainTypeDecl
// (gunbc.recurring_failure_mode plain_type_alias_left_as_a_parse_shell_in_v2); that producer is gone.
type TypeDeclView
  = GenericTypeDecl { binders: Node, member: Node }
  | TypeAlias { binders: Node, aliased: Node }
  | OpaqueTypeDecl { binders: Node }
  | PlainTypeDecl { member: Node }

// `type List<T> = std.algebra.FreeMonoid<T>` lowers its declaration edge to
// Conj { <type-parameters>: Conj { T: T }, <type-alias>: <the lowered type expression> }. THE ONE
// PRODUCER of the alias wrapper.
fn type_alias_wrapper(binders: Node, aliased: Node) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: core_edge_label(marker: TypeParamsEdge), target: binders },
      Edge { label: core_edge_label(marker: TypeAliasEdge), target: aliased }
    ]
  )
}

// `type MachineWidth<bits>` declares binders and no body: Conj { <type-parameters>: Conj { bits: bits } }.
// Not an empty member: an empty Conj body would assert a record with no fields, a different fact. The
// binders are carried because a use (`MachineWidth<64>`) is checked against them -- arity and kind --
// by type_application_conformance at v2.compiler.resolve resolve_type_application. Until that consumer
// landed this sentence claimed a check nothing performed. THE ONE PRODUCER of the opaque wrapper.
fn type_opaque_wrapper(binders: Node) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [Edge { label: core_edge_label(marker: TypeParamsEdge), target: binders }]
  )
}

fn type_wrapper_edge_count(n: Node, pick: fn(Edge) -> Bool) -> Int {
  fold(n.children, init: 0, f: fn(acc, e) { if pick(e) { acc + 1 } else { acc } })
}

fn type_decl_wrapper_params_once(n: Node) -> Bool {
  match n.kind {
    TypeNode { connective: Conj } => type_wrapper_edge_count(n: n, pick: fn(e) { edge_is_type_params(e: e) }) == 1
    _ => false
  }
}

fn type_decl_wrapper_is(n: Node) -> Bool {
  type_decl_wrapper_params_once(n: n)
    && (count(n.children) == 2)
    && (type_wrapper_edge_count(n: n, pick: fn(e) { edge_is_type_body(e: e) }) == 1)
}

fn type_alias_wrapper_is(n: Node) -> Bool {
  type_decl_wrapper_params_once(n: n)
    && (count(n.children) == 2)
    && (type_wrapper_edge_count(n: n, pick: fn(e) { edge_is_type_alias(e: e) }) == 1)
}

fn type_opaque_wrapper_is(n: Node) -> Bool {
  type_decl_wrapper_params_once(n: n) && (count(n.children) == 1)
}

fn type_decl_view(target: Node) -> TypeDeclView {
  if type_decl_wrapper_is(n: target) {
    GenericTypeDecl {
      binders: type_decl_wrapper_target(wrapper: target, pick: fn(e) { edge_is_type_params(e: e) }),
      member: type_decl_wrapper_target(wrapper: target, pick: fn(e) { edge_is_type_body(e: e) })
    }
  } else if type_alias_wrapper_is(n: target) {
    TypeAlias {
      binders: type_decl_wrapper_target(wrapper: target, pick: fn(e) { edge_is_type_params(e: e) }),
      aliased: type_decl_wrapper_target(wrapper: target, pick: fn(e) { edge_is_type_alias(e: e) })
    }
  } else if type_opaque_wrapper_is(n: target) {
    OpaqueTypeDecl {
      binders: type_decl_wrapper_target(wrapper: target, pick: fn(e) { edge_is_type_params(e: e) })
    }
  } else {
    PlainTypeDecl { member: target }
  }
}

// A DECLARATION'S BINDER EDGE: the <type-parameters> edge of a type-declaration wrapper -- a generic
// member, an alias or an opaque declaration, as type_decl_view classifies the parent -- never the same
// marker on an Arrow. It carries names the binder authority checks and resolve scopes, not values, so
// v2.compiler.infer does not derive its subtree (infer_declaration_binder_edge asks THIS predicate).
fn declaration_binder_edge(parent: Node, edge: Edge) -> Bool {
  edge_is_type_params(e: edge)
    && match type_decl_view(target: parent) {
      PlainTypeDecl { member: _ } => false
      GenericTypeDecl { binders: _, member: _ } => true
      TypeAlias { binders: _, aliased: _ } => true
      OpaqueTypeDecl { binders: _ } => true
    }
}

// THE NODES INFER DERIVES FACTS FOR: every node of the subtree except those under an Arrow's declared
// order edge (arrow_signature_order_label, parameter LABELS), under a declaration's binder edge
// (declaration_binder_edge, binder NAMES) and under a match arm's pattern edge
// (v2.std.node match_arm_pattern_edge, a binding form). v2.compiler.infer declines both subtrees and carries each as
// its parent's own evidence. Every stage that asks infer for a node's facts --
// v2.compiler.program_partition's closure, a census over derived products -- walks THIS set, so none
// demands facts infer was never asked to produce. It lives here, not in v2.std.node, because the binder
// edge's marker is this module's fact (v2.std.node cannot intern it). Before the binder edge was
// excluded, a module declaring an alias, a bodyless declaration or a generic declaration refused at the
// partition closure as partition_facts_miss on its binder nodes.
// A RESOLVED REFERENCE IS ONE TERM: the qualified-name cells under a DeclarationReferenceEdge or
// ParameterReferenceEdge core marker (v2.std.qualified_name resolved_reference_node_of_kind) name where the
// referent is declared, so they are not subterms. They are synthetic and alike across every reference
// to one path, so entered as facts they collide as one key carrying different facts
// (infer_facts_key_conflict). v2.compiler.infer's gather skips the same cells by the same accessor.
fn node_inferred_subtree_nodes(root: Node) -> List<Node> {
  fold(root.children, init: [root], f: fn(acc, e) {
    if (e.label == arrow_signature_order_label) || arrow_named_edge_is_contract(e: e) || declaration_binder_edge(parent: root, edge: e) || match_arm_pattern_edge(parent: root, edge: e) || (resolved_reference_body_kind(target: root) != NotMarkedReference) {
      acc
    } else {
      concat(acc, node_inferred_subtree_nodes(root: e.target))
    }
  })
}

fn type_decl_wrapper_target(wrapper: Node, pick: fn(Edge) -> Bool) -> Node {
  fold(wrapper.children, init: wrapper, f: fn(acc, e) {
    if pick(e) { e.target } else { acc }
  })
}

// The declared type-parameter names a node carries -- an Arrow, or a type-declaration wrapper -- in
// declaration order; empty when it carries none. A node carrying two marker edges is malformed
// (type_binder_labels_conform) and answers empty here.
fn type_param_names(n: Node) -> List<Symbol> {
  let carried = fold(n.children, init: Empty, f: fn(acc, e) {
    if edge_is_type_params(e: e) { list_snoc_item(xs: acc, item: e.target) } else { acc }
  })
  if count(carried) == 1 {
    fold(carried, init: Empty, f: fn(acc, t) { binder_conj_names(conj: t) })
  } else {
    Empty
  }
}

// THE KIND A TYPE PARAMETER DECLARES, read off its binder Atom: `bits: WidthResolution` lowers its
// binder to Atom{bits} carrying one BinderTypeEdge -> WidthResolution (v2.std.node
// type_binder_conforms admits exactly that child). Absent for an unkinded parameter.
fn type_param_kind_optional(binder: Node) -> Optional<Node> {
  fold(binder.children, init: optional_absent(), f: fn(acc, e) {
    if edge_is_core(e: e, marker: BinderTypeEdge) { optional_present(value: e.target) } else { acc }
  })
}

// WHAT A BINDER'S ANNOTATION BOUNDS IT BY, DERIVED FROM WHAT THE ANNOTATION IS -- never a tag stored beside
// the edge, so the reading and the annotation cannot disagree. The one BinderTypeEdge (type_param_kind_optional)
// is either a KIND -- a type expression whose inhabitants are the parameter's admissible arguments, judged at
// resolve by type_application_conformance -- or a STRUCTURE: a signature-world inhabitance node
// (v2.std.algebra_structure_signature algebra_inhabitance_node: a Conj of exactly the ^algebra_edge and
// ^inhabitant_edge), which the parameter's instance must inhabit, judged where the instance is known
// (v2.compiler.infer infer_application_structure_bounds). A kind expression never has that shape: resolve
// lowers an authored annotation as a type expression, so an authored `<M: Monoid>` is a KindBound naming
// std.algebra's Monoid record and is judged (and refused) as a kind -- the declared frontier whose trigger is
// gunbc.recurring_failure_mode algebra_structure_has_two_representations_with_no_declared_mapping.
type BinderBound
  = KindBound { kind: Node }
  | StructureBound { structure: Node }
  | Unbound

fn binder_annotation_is_structure(annotation: Node) -> Bool {
  match annotation.kind {
    TypeNode { connective: Conj } =>
      count(annotation.children) == 2
        && fold(annotation.children, init: true, f: fn(acc, e) {
          acc && (match e.label {
            Authored { name: n } => n == ^algebra_edge || n == ^inhabitant_edge
            StructuralLabel { label: _ } => false
            Positional => false
          })
        })
    TypeNode { connective: _ } => false
    ComputationNode { behavior: _ } => false
  }
}

fn type_param_bound(binder: Node) -> BinderBound {
  match type_param_kind_optional(binder: binder) {
    Absent => Unbound
    Present { value: annotation } =>
      if binder_annotation_is_structure(annotation: annotation) { StructureBound { structure: annotation } } else { KindBound { kind: annotation } }
  }
}

// WHETHER AN APPLIED TYPE ARGUMENT INHABITS A PARAMETER'S KIND, as the caller can establish it. The
// judgment needs the declarations the kind and argument resolve to, which only resolve holds, so it
// is supplied; the PAIRING it is applied over is decided here and nowhere else. ArgumentLiteralUnjudged
// is the language-level Nat literal rule: a literal is admitted in any kinded position and is NOT
// judged against the kind's roster. ArgumentTypeParameterUnjudged is an argument that is itself a type
// parameter of an enclosing declaration (`MachineWidth<bits>` inside a generic over bits): its
// instances are judged where that declaration is applied, not here. Both ADMIT without crediting
// inhabitance, and this module records no count of them: nothing would consume one. The honest
// record of what stays unjudged is the declared frontier std.machine_constraints
// machine_width_literal_roster_frontier, which states the rung this position sits at.
type KindInhabitance
  = ArgumentInhabitsKind
  | ArgumentLiteralUnjudged
  | ArgumentTypeParameterUnjudged
  | ArgumentOutsideKind
  | KindUnresolved

// A TYPE APPLICATION AGAINST ITS DECLARATION'S BINDERS. Exact bijection first: arguments pair with
// binders by position only once their counts agree, so a kind is never judged against an argument an
// arity error has shifted. Then each kinded binder's argument is judged in order and the first that
// is not inhabited refuses AT THAT ARGUMENT. An unkinded binder admits any argument, as before.
type TypeApplicationConformance
  = TypeApplicationConforms
  | TypeApplicationArityMismatch { declared: Int, supplied: Int }
  | TypeApplicationKindNotInhabited { argument: Node, kind: Node }
  | TypeApplicationKindUnresolved { argument: Node, kind: Node }
  | TypeApplicationBinderOrderMalformed

// THE ONE AUTHORITY for checking an applied type against the binders it instantiates, consumed by
// v2.compiler.resolve at the head->declaration join (resolve_type_application_conformance). Before it,
// this module's wrapper notes said a use's arity "is checked against" the binders while nothing
// performed the check.
fn type_application_conformance(
  binders: Node,
  arguments: List<Node>,
  inhabits: fn(Node, Node) -> KindInhabitance
) -> TypeApplicationConformance {
  match type_param_order(binders: binders) {
    TypeParamOrderMalformed => TypeApplicationBinderOrderMalformed
    TypeParamOrderDeclared { labels: labels } =>
      if count(labels) != count(arguments) {
        TypeApplicationArityMismatch { declared: count(labels), supplied: count(arguments) }
      } else {
        fold(zip_map(a: labels, b: arguments, f: fn(l, arg) { TypeParamArgument { name: l, argument: arg } }),
          init: TypeApplicationConforms,
          f: fn(acc, pa) { type_application_step(acc: acc, binders: binders, pa: pa, inhabits: inhabits) })
      }
  }
}

type TypeParamArgument {
  name: Symbol
  argument: Node
}

fn type_application_step(acc: TypeApplicationConformance, binders: Node, pa: TypeParamArgument, inhabits: fn(Node, Node) -> KindInhabitance) -> TypeApplicationConformance {
  match acc {
    TypeApplicationConforms =>
      match type_binder_target_of(binders: binders, name: pa.name) {
        Absent => TypeApplicationBinderOrderMalformed
        Present { value: binder } =>
          match type_param_bound(binder: binder) {
            Unbound => acc
            StructureBound { structure: _ } => acc
            KindBound { kind: kind } =>
              match inhabits(pa.argument, kind) {
                ArgumentInhabitsKind => acc
                ArgumentLiteralUnjudged => acc
                ArgumentTypeParameterUnjudged => acc
                ArgumentOutsideKind => TypeApplicationKindNotInhabited { argument: pa.argument, kind: kind }
                KindUnresolved => TypeApplicationKindUnresolved { argument: pa.argument, kind: kind }
              }
          }
      }
    TypeApplicationArityMismatch { declared: _, supplied: _ } => acc
    TypeApplicationKindNotInhabited { argument: _, kind: _ } => acc
    TypeApplicationKindUnresolved { argument: _, kind: _ } => acc
    TypeApplicationBinderOrderMalformed => acc
  }
}

// THE DECLARED ORDER OF A BINDER SET, read once. A set binds its names in AUTHORED order, carried by
// the set's one ^arrow_signature_order_edge (v2.std.node type_binder_conj_conforms) -- never by the
// stored sequence of its labelled edges, which content hashing sorts. A set binding no name has the
// empty order. Malformed is a set v2.std.node refuses; resolve refuses it before any reader runs
// (type_binder_labels_conform), so a reader meeting it here answers nothing rather than guessing.
type TypeParamOrder
  = TypeParamOrderDeclared { labels: List<Symbol> }
  | TypeParamOrderMalformed

fn type_param_order(binders: Node) -> TypeParamOrder {
  if !type_binder_conj_conforms(t: binders) {
    TypeParamOrderMalformed
  } else {
    match arrow_signature_order_read(children: binders.children) {
      OrderAbsent => TypeParamOrderDeclared { labels: Empty }
      OrderUnreadable => TypeParamOrderMalformed
      OrderLabels { labels: labels } =>
        if arrow_signature_order_head_is_list_introduction(arrow: binders) { TypeParamOrderDeclared { labels: labels } } else { TypeParamOrderMalformed }
    }
  }
}

// The names a binder set declares, IN DECLARED ORDER: every positional reader of type parameters
// (an application's pairing, an alias renaming, infer's instance zip through
// v2.std.symbol_index symbol_index_declared_type_params_at) reads them here.
fn binder_conj_names(conj: Node) -> List<Symbol> {
  match type_param_order(binders: conj) {
    TypeParamOrderDeclared { labels: labels } => labels
    TypeParamOrderMalformed => Empty
  }
}

// THE ONE MINT OF A BINDER SET'S EDGES: the binder edges as authored, plus -- when any name is bound --
// the order edge built from those same edges by the declared-signature carrier
// (v2.std.arrow_signature signature_order_edge), so the set and its order are one fact from one list.
// The caller wraps the result in its own located Conj.
fn type_binder_set_children(binders: List<Edge>, source: Node) -> List<Edge> {
  let names = fold(binders, init: Empty, f: fn(acc, e) {
    match e.label {
      Authored { name: sym } => list_snoc_item(xs: acc, item: sym)
      StructuralLabel { label: _ } => acc
      Positional => acc
    }
  })
  if count(names) == 0 { binders } else { list_snoc_item(xs: binders, item: signature_order_edge(order: names, source: source)) }
}

fn type_binder_target_of(binders: Node, name: Symbol) -> Optional<Node> {
  fold(binders.children, init: optional_absent(), f: fn(acc, e) {
    match e.label {
      Authored { name: sym } => if sym == name { optional_present(value: e.target) } else { acc }
      StructuralLabel { label: _ } => acc
      Positional => acc
    }
  })
}

// THE EDGE THAT CARRIES A CAST'S TARGET TYPE. `e as T` lowers to Transform[coerce, e] with this
// edge -> T beside its positional children (v2.compiler.body_lowering_fold). A cast is a COERCION
// -- v2.std.coercion decides whether e's type crosses to T, and the value may change -- so it is its
// own label and never a let's static ascription under a shared one (one name carrying two
// obligations). Unauthorable for the reason type_params_marker is.

// THE ONE PRODUCER of the edge.
fn cast_target_edge(target_type: Node) -> Edge {
  Edge { label: core_edge_label(marker: CastTargetEdge), target: target_type }
}

fn edge_is_cast_target(e: Edge) -> Bool {
  edge_is_core(e: e, marker: CastTargetEdge)
}

// THE ONE ACCESSOR: the cast target a Transform carries, Absent on any other node. A reader that
// folds a Transform's children as operands must view it through this and
// v2.std.node positional children -- the named edge is never an argument.
fn cast_target_optional(n: Node) -> Optional<Node> {
  match n.kind {
    ComputationNode { behavior: Transform } =>
      fold(n.children, init: optional_absent(), f: fn(acc, e) {
        if edge_is_cast_target(e: e) { optional_present(value: e.target) } else { acc }
      })
    _ => optional_absent()
  }
}

// THE EDGE THAT CARRIES A LET'S TYPE ANNOTATION. `let x: T = e` lowers to Bind[binder, value,
// body] with this edge -> T beside its three positionals (v2.compiler.body_lowering_fold). It is a
// static ASCRIPTION -- the bound value must already inhabit T, nothing is converted -- so it is its
// own label beside <cast-target> and never shares one with the coercion. Unauthorable for the
// reason type_params_marker is.

// THE ONE PRODUCER of the edge.
fn type_annotation_edge(annotation: Node) -> Edge {
  Edge { label: core_edge_label(marker: TypeAnnotationEdge), target: annotation }
}

// 🟡 dissolve-on: edge labels on behavior nodes becoming a closed coproduct owned by v2.std.node, the
// trigger of gunbc.recurring_failure_mode behavior_named_edge_label_validated_not_constructed (owner:
// the v2 type-binders lane under neat-boar-16, coordinated with the named-arguments edge-discipline
// coproduct). Until then an edge's marker is a Named Symbol and this compare is the one place a
// <type-annotation> edge is recognized, the same shape as edge_is_type_params and edge_is_cast_target;
// with typed labels it dissolves into a match on the label arm.
fn edge_is_type_annotation(e: Edge) -> Bool {
  edge_is_core(e: e, marker: TypeAnnotationEdge)
}

// THE ONE ACCESSOR: the annotation a Bind carries, Absent on an unannotated Bind and on any other
// node. A reader that walks a Bind's children by ordinal views them as positionals; this edge is
// never the binder, the value or the body.
fn type_annotation_optional(n: Node) -> Optional<Node> {
  match n.kind {
    ComputationNode { behavior: Bind } =>
      fold(n.children, init: optional_absent(), f: fn(acc, e) {
        if edge_is_type_annotation(e: e) { optional_present(value: e.target) } else { acc }
      })
    _ => optional_absent()
  }
}

// A BIND'S NAMED EDGES ARE ITS MARKERS AND NOTHING ELSE: its let annotation (the <type-annotation>
// marker) and v2.std.node MatchArmScopeExitEdge, each at most once, wherever they stand
// (v2.std.node PositionalPlusNamedMarkerEdges bounds the count; this states the labels).
fn bind_named_labels_conform(n: Node) -> Bool {
  let walk = fold(n.children, init: BindMarkerWalk { annotations: 0, scope_exits: 0, other: 0 }, f: fn(acc, e) {
    if is_positional(e: e) {
      acc
    } else if edge_is_type_annotation(e: e) {
      BindMarkerWalk { annotations: acc.annotations + 1, scope_exits: acc.scope_exits, other: acc.other }
    } else if edge_is_core(e: e, marker: MatchArmScopeExitEdge) {
      BindMarkerWalk { annotations: acc.annotations, scope_exits: acc.scope_exits + 1, other: acc.other }
    } else {
      BindMarkerWalk { annotations: acc.annotations, scope_exits: acc.scope_exits, other: acc.other + 1 }
    }
  })
  (walk.annotations <= 1) && (walk.scope_exits <= 1) && (walk.other == 0)
}

type BindMarkerWalk {
  annotations: Int
  scope_exits: Int
  other: Int
}

// WHICH NAMED LABELS A BEHAVIOR ADMITS. v2.std.node states the SHAPE of a Transform's children
// (positional_prefix_then_labeled_conform: positional first, then distinct Named edges); this is the
// label half for a Transform, and bind_named_labels_conform is it for a Bind. A Transform is one of two forms and never both: a CAST, whose
// one Named edge is the <cast-target> marker, or an APPLICATION, whose Named edges are named actuals
// labelled by the callee's parameter names (v2.compiler.body_lowering_fold body_lower_call_arg_edge).
// A Transform carrying the marker beside any other Named edge mixes the two and refuses here. Whether
// an application's label names a parameter is a binding question, decided against the callee's
// domain -- an unknown label refuses at infer (v2.std.arrow_signature application_binding_plan,
// application_argument_label_unknown) -- so no Accepted program holds a foreign label either way. Every
// other behavior's Named edges -- a Loop's bound and carrier -- are owned by its own v2.std.node edge
// discipline (loop_behavior_edges_conform), and a second, blanket rule here refusing labels that
// authority requires would fork it.
type TransformLabelWalk {
  markers: Int
  actuals: Int
}

fn transform_named_labels_conform(n: Node) -> Bool {
  let walk = fold(n.children, init: TransformLabelWalk { markers: 0, actuals: 0 }, f: fn(acc, e) {
    if is_positional(e: e) {
      acc
    } else if edge_is_cast_target(e: e) {
      TransformLabelWalk { markers: acc.markers + 1, actuals: acc.actuals }
    } else {
      TransformLabelWalk { markers: acc.markers, actuals: acc.actuals + 1 }
    }
  })
  (walk.markers == 0) || ((walk.markers == 1) && (walk.actuals == 0))
}

// WHERE THE MARKERS MAY STAND, stated over the whole tree. Which wrapper a node is, is decided ONCE,
// by type_decl_view: a node the view classifies as none of the three generic shapes is PlainTypeDecl,
// and a plain node carries no marker at all -- so a Conj holding <type-parameters> beside an
// unrelated edge is refused here because the view gives it no wrapper arm, not by a second list. The type-parameter edge sits only on an
// Arrow (a fn's signature) or in a type-declaration wrapper, once, targeting a well-formed binder
// Conj; the type-body and type-alias edges sit only in a wrapper; and an Arrow's non-body Named edge -- which
// v2.std.node admits by SHAPE -- is the type-parameter edge. So a member carrying a binder among its
// fields or variants is refused here, on the tree v2.compiler.resolve checks beside v2.std.node
// well_formed, not filtered by its readers.
fn type_binder_node_conforms(n: Node) -> Bool {
  let params = fold(n.children, init: 0, f: fn(acc, e) { if edge_is_type_params(e: e) { acc + 1 } else { acc } })
  let bodies = fold(n.children, init: 0, f: fn(acc, e) {
    if edge_is_type_body(e: e) || edge_is_type_alias(e: e) { acc + 1 } else { acc }
  })
  let params_ok = (params == 0) || ((params == 1) && marker_targets_conform(n: n))
  match n.kind {
    TypeNode { connective: Arrow } => params_ok && (bodies == 0) && arrow_named_labels_conform(n: n) && arrow_contract_conforms(children: n.children) && arrow_domain_members_are_binders(n: n)
    ComputationNode { behavior: Transform } => (params == 0) && (bodies == 0) && transform_named_labels_conform(n: n)
    ComputationNode { behavior: Bind } => (params == 0) && (bodies == 0) && bind_named_labels_conform(n: n)
    _ =>
      match type_decl_view(target: n) {
        PlainTypeDecl { member: _ } => (params == 0) && (bodies == 0)
        GenericTypeDecl { binders: _, member: _ } => params_ok
        TypeAlias { binders: _, aliased: _ } => params_ok
        OpaqueTypeDecl { binders: _ } => params_ok
      }
  }
}

fn marker_targets_conform(n: Node) -> Bool {
  fold(n.children, init: true, f: fn(acc, e) {
    acc && (!edge_is_type_params(e: e) || type_binder_conj_conforms(t: e.target))
  })
}

// THE BINDER WALL (XL-2 PR2b-3): every Named member of an Arrow's domain is a binder node (v2.std.node_query
// binder_node_parts), built by binder_edge, binder_edge_with_default or binder_relabelled. A hand-built
// name-to-type edge refuses here, at the Arrow, rather than being read as a parameter typed by its raw
// target. The binder readers refuse such a member too (declared_field_from_edge answers Absent), so a
// record payload this wall does not reach still fails closed at its first reader.
fn arrow_domain_members_are_binders(n: Node) -> Bool {
  match arrow_first_positional_target(children: n.children) {
    FirstPositionalFound { target: domain } =>
      fold(domain.children, init: true, f: fn(acc, e) { acc && arrow_domain_member_is_binder(e: e) })
    FirstPositionalAbsent => true
  }
}

fn arrow_domain_member_is_binder(e: Edge) -> Bool {
  match e.label {
    Positional => true
    StructuralLabel { label: _ } => false
    Authored { name: _ } =>
      match binder_node_parts(n: e.target) {
        Present { value: _ } => true
        Absent => false
      }
  }
}

fn arrow_named_labels_conform(n: Node) -> Bool {
  fold(n.children, init: true, f: fn(acc, e) {
    acc && (is_positional(e: e) || arrow_named_edge_is_non_binder(e: e) || edge_is_type_params(e: e))
  })
}

fn type_binder_labels_conform(root: Node) -> Bool {
  fold(node_subtree_nodes(root: root), init: true, f: fn(acc, n) { acc && type_binder_node_conforms(n: n) })
}

// The first node whose labels do not conform, so a refusal is located at it rather than at the root
// (a cast marker beside named actuals is refused at that Transform).
fn type_binder_first_mislabelled(root: Node) -> Optional<Node> {
  fold(node_subtree_nodes(root: root), init: optional_absent(), f: fn(acc, n) {
    match acc {
      Present { value: _ } => acc
      Absent => if type_binder_node_conforms(n: n) { acc } else { optional_present(value: n) }
    }
  })
}

// WHETHER AN ALIAS DECLARATION IS A PURE RENAMING, decided once, on the declaration
// (docs/plans/anonymous-record-literal-design.md, section Pure-renaming aliases). `type A<p1..pn> = H<p1..pn>` -- the aliased expression is a head applied
// to exactly the alias's own binders, in declared order, or `type A = H` with none -- denotes H with
// the same arguments in the same positions, so a reader that follows it substitutes nothing. Every
// other declaration is not a renaming: a reordering, constant or partially applied alias, a
// generic record, a plain type. v2.std.symbol_index records the answer when it records the
// declaration, and readers take it from there rather than re-deriving it at each use.
type AliasRenaming
  = PureRenamingOf { head: Symbol }
  | NotARenaming

fn type_alias_renaming(target: Node) -> AliasRenaming {
  match type_decl_view(target: target) {
    TypeAlias { binders: binders, aliased: aliased } =>
      type_alias_renaming_of(binders: binder_conj_names(conj: binders), aliased: aliased)
    _ => NotARenaming
  }
}

fn type_alias_renaming_of(binders: List<Symbol>, aliased: Node) -> AliasRenaming {
  match aliased.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if count(binders) == 0 { PureRenamingOf { head: id } } else { NotARenaming }
    TypeNode { connective: Instantiation } =>
      let scan = type_binder_instantiation_scan(n: aliased)
      match scan.head {
        Present { value: head } =>
          if scan.args_are_atoms && (scan.arg_ids == binders) { PureRenamingOf { head: head } } else { NotARenaming }
        Absent => NotARenaming
      }
    _ => NotARenaming
  }
}

// An instantiation read once, positionally: its head atom (if the head is one), the identities of
// its argument atoms in order, and whether every argument is an atom.
type TypeBinderInstantiationScan {
  seen: Int
  head: Optional<Symbol>
  arg_ids: List<Symbol>
  args_are_atoms: Bool
}

fn type_binder_instantiation_scan(n: Node) -> TypeBinderInstantiationScan {
  fold(n.children, init: TypeBinderInstantiationScan { seen: 0, head: optional_absent(), arg_ids: Empty, args_are_atoms: true }, f: fn(acc, e) {
    match e.label {
      Positional =>
        let id = type_binder_atom_identity_optional(n: e.target)
        if acc.seen == 0 {
          TypeBinderInstantiationScan { seen: 1, head: id, arg_ids: acc.arg_ids, args_are_atoms: acc.args_are_atoms }
        } else {
          match id {
            Present { value: a } => TypeBinderInstantiationScan { seen: acc.seen + 1, head: acc.head, arg_ids: list_snoc_item(xs: acc.arg_ids, item: a), args_are_atoms: acc.args_are_atoms }
            Absent => TypeBinderInstantiationScan { seen: acc.seen + 1, head: acc.head, arg_ids: acc.arg_ids, args_are_atoms: false }
          }
        }
      _ => acc
    }
  })
}

fn type_binder_atom_identity_optional(n: Node) -> Optional<Symbol> {
  match n.kind {
    TypeNode { connective: Atom { identity: id } } => optional_present(value: id)
    _ => optional_absent()
  }
}
