module v2.std.datetime

import v2.std.diagnostic { Locus, Outcome, bind_outcome, outcome_accepted }
import v2.std.algebra { fold_list }
import v2.std.collection { List }
import v2.std.nat { Nat }
import v2.std.node { Symbol }
import v2.std.refinement { Refined, Validation, refine, refined_base }

type Year {
  value: Refined<v2.std.nat.Nat>
}

type MonthOrdinal {
  value: Refined<v2.std.nat.Nat>
}

type DayOrdinal {
  value: Refined<v2.std.nat.Nat>
}

type HourOfDay {
  value: Refined<v2.std.nat.Nat>
}

type MinuteOfHour {
  value: Refined<v2.std.nat.Nat>
}

type SecondOfMinute {
  value: Refined<v2.std.nat.Nat>
}

type SecfracDigit {
  value: Refined<v2.std.nat.Nat>
}

type SecfracDigits {
  first: SecfracDigit
  rest: List<SecfracDigit>
}

type Subsecond
  = NoSubsecond
  | FractionalSecond { digits: SecfracDigits }

type TzOffsetSign
  = TzOffsetPlus
  | TzOffsetMinus

type TzOffsetHour {
  value: Refined<v2.std.nat.Nat>
}

type TzOffsetMinute {
  value: Refined<v2.std.nat.Nat>
}

type NumericTzOffset {
  sign: TzOffsetSign
  hour: TzOffsetHour
  minute: TzOffsetMinute
}

type TzOffset
  = UtcZ
  | SignedOffset { offset: NumericTzOffset }

type CalendarDateFields {
  year: Year
  month: MonthOrdinal
  day: DayOrdinal
}

type CalendarDateValidity {
  refined: Refined<CalendarDateFields>
}

type CalendarDate {
  validity: CalendarDateValidity
}

type ClockTimeFields {
  hour: HourOfDay
  minute: MinuteOfHour
  second: SecondOfMinute
  subsecond: Subsecond
}

type ClockTimeValidity {
  refined: Refined<ClockTimeFields>
}

type ClockTime {
  validity: ClockTimeValidity
}

type LocalDate {
  date: CalendarDate
}

type LocalTime {
  time: ClockTime
}

type LocalDateTime {
  date: CalendarDate
  time: ClockTime
}

type OrdinaryInstantFields {
  utc_date: CalendarDate
  utc_time: ClockTime
}

type LeapSecondAnnouncement {
  utc_date: CalendarDate
  utc_hour: HourOfDay
  utc_minute: MinuteOfHour
}

type LeapSecondInsertionOccurrenceFields {
  announcement: LeapSecondAnnouncement
}

type LeapSecondInsertionOccurrenceValidity {
  refined: Refined<LeapSecondInsertionOccurrenceFields>
}

type LeapSecondInsertionOccurrence {
  validity: LeapSecondInsertionOccurrenceValidity
}

type LeapSecondAuthoritySource {
  authority: Symbol
}

type LeapSecondInsertionDate {
  year: v2.std.nat.Nat
  month: v2.std.nat.Nat
  day: v2.std.nat.Nat
}

type LeapSecondInsertionTable {
  source: LeapSecondAuthoritySource
  dates: List<LeapSecondInsertionDate>
}

type LeapSecondInstantFields {
  occurrence: LeapSecondInsertionOccurrence
  second: SecondOfMinute
  subsecond: Subsecond
}

type LeapSecondOffsetDateTimeFields {
  occurrence: LeapSecondInsertionOccurrence
  local_date: CalendarDate
  local_hour: HourOfDay
  local_minute: MinuteOfHour
  second: SecondOfMinute
  subsecond: Subsecond
  offset: TzOffset
}

type OrdinaryInstantValidity {
  refined: Refined<OrdinaryInstantFields>
}

type LeapSecondInstantValidity {
  refined: Refined<LeapSecondInstantFields>
}

type LeapSecondOffsetDateTimeValidity {
  refined: Refined<LeapSecondOffsetDateTimeFields>
}

type Instant
  = OrdinaryInstant { validity: OrdinaryInstantValidity }
  | LeapSecondInstant { validity: LeapSecondInstantValidity }

type OffsetDateTime
  = OrdinaryOffsetDateTime { instant: OrdinaryInstantValidity, offset: TzOffset }
  | LeapSecondOffsetDateTime { validity: LeapSecondOffsetDateTimeValidity }
data positive_utc_leap_second_insertions: LeapSecondInsertionTable = LeapSecondInsertionTable {
  source: LeapSecondAuthoritySource { authority: ^iers_bulletin_c_leap_second_authority },
  dates: [
    leap_second_insertion_date(year: 1972, month: 6, day: 30),
    leap_second_insertion_date(year: 1972, month: 12, day: 31),
    leap_second_insertion_date(year: 1973, month: 12, day: 31),
    leap_second_insertion_date(year: 1974, month: 12, day: 31),
    leap_second_insertion_date(year: 1975, month: 12, day: 31),
    leap_second_insertion_date(year: 1976, month: 12, day: 31),
    leap_second_insertion_date(year: 1977, month: 12, day: 31),
    leap_second_insertion_date(year: 1978, month: 12, day: 31),
    leap_second_insertion_date(year: 1979, month: 12, day: 31),
    leap_second_insertion_date(year: 1981, month: 6, day: 30),
    leap_second_insertion_date(year: 1982, month: 6, day: 30),
    leap_second_insertion_date(year: 1983, month: 6, day: 30),
    leap_second_insertion_date(year: 1985, month: 6, day: 30),
    leap_second_insertion_date(year: 1987, month: 12, day: 31),
    leap_second_insertion_date(year: 1989, month: 12, day: 31),
    leap_second_insertion_date(year: 1990, month: 12, day: 31),
    leap_second_insertion_date(year: 1992, month: 6, day: 30),
    leap_second_insertion_date(year: 1993, month: 6, day: 30),
    leap_second_insertion_date(year: 1994, month: 6, day: 30),
    leap_second_insertion_date(year: 1995, month: 12, day: 31),
    leap_second_insertion_date(year: 1997, month: 6, day: 30),
    leap_second_insertion_date(year: 1998, month: 12, day: 31),
    leap_second_insertion_date(year: 2005, month: 12, day: 31),
    leap_second_insertion_date(year: 2008, month: 12, day: 31),
    leap_second_insertion_date(year: 2012, month: 6, day: 30),
    leap_second_insertion_date(year: 2015, month: 6, day: 30),
    leap_second_insertion_date(year: 2016, month: 12, day: 31),
  ]
}

fn year_value(year: Year) -> v2.std.nat.Nat {
  refined_base(r: year.value)
}

fn month_value(month: MonthOrdinal) -> v2.std.nat.Nat {
  refined_base(r: month.value)
}

fn day_value(day: DayOrdinal) -> v2.std.nat.Nat {
  refined_base(r: day.value)
}

fn second_value(second: SecondOfMinute) -> v2.std.nat.Nat {
  refined_base(r: second.value)
}

fn minute_value(minute: MinuteOfHour) -> v2.std.nat.Nat {
  refined_base(r: minute.value)
}

fn hour_value(hour: HourOfDay) -> v2.std.nat.Nat {
  refined_base(r: hour.value)
}

fn tz_offset_hour_value(hour: TzOffsetHour) -> v2.std.nat.Nat {
  refined_base(r: hour.value)
}

fn tz_offset_minute_value(minute: TzOffsetMinute) -> v2.std.nat.Nat {
  refined_base(r: minute.value)
}

fn secfrac_digit_value(digit: SecfracDigit) -> v2.std.nat.Nat {
  refined_base(r: digit.value)
}

fn leap_second_insertion_date(year: v2.std.nat.Nat, month: v2.std.nat.Nat, day: v2.std.nat.Nat) -> LeapSecondInsertionDate {
  LeapSecondInsertionDate {
    year: year,
    month: month,
    day: day
  }
}

fn year_admits(value: v2.std.nat.Nat) -> Bool {
  value <= 9999
}

fn month_admits(value: v2.std.nat.Nat) -> Bool {
  (value >= 1) && (value <= 12)
}

fn day_admits(value: v2.std.nat.Nat) -> Bool {
  (value >= 1) && (value <= 31)
}

fn hour_admits(value: v2.std.nat.Nat) -> Bool {
  value <= 23
}

fn minute_admits(value: v2.std.nat.Nat) -> Bool {
  value <= 59
}

fn second_admits(value: v2.std.nat.Nat) -> Bool {
  value <= 60
}

fn secfrac_digit_admits(value: v2.std.nat.Nat) -> Bool {
  value <= 9
}

fn tz_offset_hour_admits(value: v2.std.nat.Nat) -> Bool {
  value <= 23
}

fn tz_offset_minute_admits(value: v2.std.nat.Nat) -> Bool {
  value <= 59
}

fn divisible_by_4(value: v2.std.nat.Nat) -> Bool {
  (value % 4) == 0
}

fn divisible_by_100(value: v2.std.nat.Nat) -> Bool {
  (value % 100) == 0
}

fn divisible_by_400(value: v2.std.nat.Nat) -> Bool {
  (value % 400) == 0
}

fn leap_year(value: v2.std.nat.Nat) -> Bool {
  divisible_by_4(value: value)
    && (!divisible_by_100(value: value) || divisible_by_400(value: value))
}

fn calendar_date_admits(fields: CalendarDateFields) -> Bool {
  let year = year_value(year: fields.year)
  let month = month_value(month: fields.month)
  let day = day_value(day: fields.day)
  match month {
    1 => day <= 31
    2 => if leap_year(value: year) {
      day <= 29
    } else {
      day <= 28
    }
    3 => day <= 31
    4 => day <= 30
    5 => day <= 31
    6 => day <= 30
    7 => day <= 31
    8 => day <= 31
    9 => day <= 30
    10 => day <= 31
    11 => day <= 30
    12 => day <= 31
    _ => false
  }
}

fn calendar_date_fields(date: CalendarDate) -> CalendarDateFields {
  refined_base(r: date.validity.refined)
}

fn clock_time_fields(time: ClockTime) -> ClockTimeFields {
  refined_base(r: time.validity.refined)
}

fn leap_second_insertion_date_matches(fields: CalendarDateFields, date: LeapSecondInsertionDate) -> Bool {
  (year_value(year: fields.year) == date.year)
    && (month_value(month: fields.month) == date.month)
    && (day_value(day: fields.day) == date.day)
}

fn leap_second_announced_insertion_date(fields: CalendarDateFields) -> Bool {
  fold_list(
    xs: positive_utc_leap_second_insertions.dates,
    empty: false,
    cons: fn(acc, date) {
      acc || leap_second_insertion_date_matches(fields: fields, date: date)
    }
  )
}

fn same_calendar_date(left: CalendarDateFields, right: CalendarDateFields) -> Bool {
  (year_value(year: left.year) == year_value(year: right.year))
    && (month_value(month: left.month) == month_value(month: right.month))
    && (day_value(day: left.day) == day_value(day: right.day))
}

fn leap_second_next_day(utc: CalendarDateFields, local: CalendarDateFields) -> Bool {
  let utc_year = year_value(year: utc.year)
  let utc_month = month_value(month: utc.month)
  let local_year = year_value(year: local.year)
  let local_month = month_value(month: local.month)
  let local_day = day_value(day: local.day)
  match utc_month {
    3 =>
      (local_year == utc_year)
        && (local_month == 4)
        && (local_day == 1)
    6 =>
      (local_year == utc_year)
        && (local_month == 7)
        && (local_day == 1)
    9 =>
      (local_year == utc_year)
        && (local_month == 10)
        && (local_day == 1)
    12 =>
      (utc_year < 9999)
        && (local_year == (utc_year + 1))
        && (local_month == 1)
        && (local_day == 1)
    _ => false
  }
}

fn leap_second_announcement_admits(announcement: LeapSecondAnnouncement) -> Bool {
  let fields = calendar_date_fields(date: announcement.utc_date)
  let hour = hour_value(hour: announcement.utc_hour)
  let minute = minute_value(minute: announcement.utc_minute)
  (hour == 23) && (minute == 59) && leap_second_announced_insertion_date(fields: fields)
}

fn leap_second_insertion_occurrence_admits(fields: LeapSecondInsertionOccurrenceFields) -> Bool {
  leap_second_announcement_admits(announcement: fields.announcement)
}

fn leap_second_insertion_occurrence_fields(occurrence: LeapSecondInsertionOccurrence) -> LeapSecondInsertionOccurrenceFields {
  refined_base(r: occurrence.validity.refined)
}

fn leap_second_insertion_occurrence_announcement(occurrence: LeapSecondInsertionOccurrence) -> LeapSecondAnnouncement {
  let fields = leap_second_insertion_occurrence_fields(occurrence: occurrence)
  fields.announcement
}

fn minute_of_day(hour: v2.std.nat.Nat, minute: v2.std.nat.Nat) -> v2.std.nat.Nat {
  (hour * 60) + minute
}

fn tz_offset_minutes(offset: NumericTzOffset) -> v2.std.nat.Nat {
  (tz_offset_hour_value(hour: offset.hour) * 60) + tz_offset_minute_value(minute: offset.minute)
}

fn leap_second_local_matches_utc(announcement: LeapSecondAnnouncement, fields: LeapSecondOffsetDateTimeFields) -> Bool {
  let utc_date = calendar_date_fields(date: announcement.utc_date)
  let local_date = calendar_date_fields(date: fields.local_date)
  let local_total = minute_of_day(
    hour: hour_value(hour: fields.local_hour),
    minute: minute_value(minute: fields.local_minute)
  )
  match fields.offset {
    UtcZ =>
      same_calendar_date(left: utc_date, right: local_date)
        && (local_total == 1439)
    SignedOffset { offset: signed } =>
      match signed.sign {
        TzOffsetPlus =>
          let offset_total = tz_offset_minutes(offset: signed)
          if offset_total == 0 {
            same_calendar_date(left: utc_date, right: local_date)
              && (local_total == 1439)
          } else {
            leap_second_next_day(utc: utc_date, local: local_date)
              && ((local_total + 1) == offset_total)
          }
        TzOffsetMinus =>
          let offset_total = tz_offset_minutes(offset: signed)
          same_calendar_date(left: utc_date, right: local_date)
            && ((local_total + offset_total) == 1439)
      }
  }
}

fn ordinary_instant_admits(fields: OrdinaryInstantFields) -> Bool {
  let time = clock_time_fields(time: fields.utc_time)
  let second = second_value(second: time.second)
  second <= 59
}

fn clock_time_fields_admits(fields: ClockTimeFields) -> Bool {
  let second = second_value(second: fields.second)
  second <= 59
}

fn leap_second_instant_admits(fields: LeapSecondInstantFields) -> Bool {
  let second = second_value(second: fields.second)
  second == 60
}

fn leap_second_offset_datetime_admits(fields: LeapSecondOffsetDateTimeFields) -> Bool {
  let second = second_value(second: fields.second)
  let announcement = leap_second_insertion_occurrence_announcement(occurrence: fields.occurrence)
  (second == 60)
    && leap_second_local_matches_utc(announcement: announcement, fields: fields)
}

data year_validation: Validation<v2.std.nat.Nat> = Validation {
  reason: ^year_out_of_range,
  admits: year_admits
}

data month_validation: Validation<v2.std.nat.Nat> = Validation {
  reason: ^month_out_of_range,
  admits: month_admits
}

data day_validation: Validation<v2.std.nat.Nat> = Validation {
  reason: ^day_out_of_range,
  admits: day_admits
}

data hour_validation: Validation<v2.std.nat.Nat> = Validation {
  reason: ^hour_out_of_range,
  admits: hour_admits
}

data minute_validation: Validation<v2.std.nat.Nat> = Validation {
  reason: ^minute_out_of_range,
  admits: minute_admits
}

data second_validation: Validation<v2.std.nat.Nat> = Validation {
  reason: ^second_out_of_range,
  admits: second_admits
}

data secfrac_digit_validation: Validation<v2.std.nat.Nat> = Validation {
  reason: ^secfrac_digit_out_of_range,
  admits: secfrac_digit_admits
}

data tz_offset_hour_validation: Validation<v2.std.nat.Nat> = Validation {
  reason: ^tz_offset_hour_out_of_range,
  admits: tz_offset_hour_admits
}

data tz_offset_minute_validation: Validation<v2.std.nat.Nat> = Validation {
  reason: ^tz_offset_minute_out_of_range,
  admits: tz_offset_minute_admits
}

data calendar_date_validation: Validation<CalendarDateFields> = Validation {
  reason: ^calendar_date_invalid,
  admits: calendar_date_admits
}

data clock_time_validation: Validation<ClockTimeFields> = Validation {
  reason: ^clock_time_fields_invalid,
  admits: clock_time_fields_admits
}

data leap_second_insertion_occurrence_validation: Validation<LeapSecondInsertionOccurrenceFields> = Validation {
  reason: ^leap_second_insertion_occurrence_invalid,
  admits: leap_second_insertion_occurrence_admits
}

data ordinary_instant_validation: Validation<OrdinaryInstantFields> = Validation {
  reason: ^ordinary_instant_invalid,
  admits: ordinary_instant_admits
}

data leap_second_instant_validation: Validation<LeapSecondInstantFields> = Validation {
  reason: ^leap_second_instant_invalid,
  admits: leap_second_instant_admits
}

data leap_second_offset_datetime_validation: Validation<LeapSecondOffsetDateTimeFields> = Validation {
  reason: ^leap_second_offset_datetime_invalid,
  admits: leap_second_offset_datetime_admits
}

fn make_year(value: v2.std.nat.Nat, at: Locus) -> Outcome<Year> {
  bind_outcome(o: refine(base: value, by: year_validation, at: at), f: fn(refined) {
    outcome_accepted(value: Year { value: refined })
  })
}

fn make_month_ordinal(value: v2.std.nat.Nat, at: Locus) -> Outcome<MonthOrdinal> {
  bind_outcome(o: refine(base: value, by: month_validation, at: at), f: fn(refined) {
    outcome_accepted(value: MonthOrdinal { value: refined })
  })
}

fn make_day_ordinal(value: v2.std.nat.Nat, at: Locus) -> Outcome<DayOrdinal> {
  bind_outcome(o: refine(base: value, by: day_validation, at: at), f: fn(refined) {
    outcome_accepted(value: DayOrdinal { value: refined })
  })
}

fn make_hour_of_day(value: v2.std.nat.Nat, at: Locus) -> Outcome<HourOfDay> {
  bind_outcome(o: refine(base: value, by: hour_validation, at: at), f: fn(refined) {
    outcome_accepted(value: HourOfDay { value: refined })
  })
}

fn make_minute_of_hour(value: v2.std.nat.Nat, at: Locus) -> Outcome<MinuteOfHour> {
  bind_outcome(o: refine(base: value, by: minute_validation, at: at), f: fn(refined) {
    outcome_accepted(value: MinuteOfHour { value: refined })
  })
}

fn make_second_of_minute(value: v2.std.nat.Nat, at: Locus) -> Outcome<SecondOfMinute> {
  bind_outcome(o: refine(base: value, by: second_validation, at: at), f: fn(refined) {
    outcome_accepted(value: SecondOfMinute { value: refined })
  })
}

fn make_secfrac_digit(value: v2.std.nat.Nat, at: Locus) -> Outcome<SecfracDigit> {
  bind_outcome(o: refine(base: value, by: secfrac_digit_validation, at: at), f: fn(refined) {
    outcome_accepted(value: SecfracDigit { value: refined })
  })
}

fn make_subsecond(digits: SecfracDigits) -> Subsecond {
  FractionalSecond { digits: digits }
}

fn make_tz_offset_hour(value: v2.std.nat.Nat, at: Locus) -> Outcome<TzOffsetHour> {
  bind_outcome(o: refine(base: value, by: tz_offset_hour_validation, at: at), f: fn(refined) {
    outcome_accepted(value: TzOffsetHour { value: refined })
  })
}

fn make_tz_offset_minute(value: v2.std.nat.Nat, at: Locus) -> Outcome<TzOffsetMinute> {
  bind_outcome(o: refine(base: value, by: tz_offset_minute_validation, at: at), f: fn(refined) {
    outcome_accepted(value: TzOffsetMinute { value: refined })
  })
}

fn make_calendar_date(fields: CalendarDateFields, at: Locus) -> Outcome<CalendarDate> {
  bind_outcome(o: refine(base: fields, by: calendar_date_validation, at: at), f: fn(refined) {
    outcome_accepted(value: CalendarDate { validity: CalendarDateValidity { refined: refined } })
  })
}

fn make_clock_time(fields: ClockTimeFields, at: Locus) -> Outcome<ClockTime> {
  bind_outcome(o: refine(base: fields, by: clock_time_validation, at: at), f: fn(refined) {
    outcome_accepted(value: ClockTime { validity: ClockTimeValidity { refined: refined } })
  })
}

fn make_leap_second_insertion_occurrence(
  fields: LeapSecondInsertionOccurrenceFields,
  at: Locus
) -> Outcome<LeapSecondInsertionOccurrence> {
  bind_outcome(o: refine(base: fields, by: leap_second_insertion_occurrence_validation, at: at), f: fn(refined) {
    outcome_accepted(value: LeapSecondInsertionOccurrence { validity: LeapSecondInsertionOccurrenceValidity { refined: refined } })
  })
}

fn make_ordinary_instant(fields: OrdinaryInstantFields, at: Locus) -> Outcome<Instant> {
  bind_outcome(o: refine(base: fields, by: ordinary_instant_validation, at: at), f: fn(refined) {
    outcome_accepted(value: OrdinaryInstant { validity: OrdinaryInstantValidity { refined: refined } })
  })
}

fn make_leap_second_instant(fields: LeapSecondInstantFields, at: Locus) -> Outcome<Instant> {
  bind_outcome(o: refine(base: fields, by: leap_second_instant_validation, at: at), f: fn(refined) {
    outcome_accepted(value: LeapSecondInstant { validity: LeapSecondInstantValidity { refined: refined } })
  })
}

fn make_ordinary_offset_datetime(fields: OrdinaryInstantFields, offset: TzOffset, at: Locus) -> Outcome<OffsetDateTime> {
  bind_outcome(o: refine(base: fields, by: ordinary_instant_validation, at: at), f: fn(refined) {
    outcome_accepted(value: OrdinaryOffsetDateTime { instant: OrdinaryInstantValidity { refined: refined }, offset: offset })
  })
}

fn make_leap_second_offset_datetime(
  fields: LeapSecondOffsetDateTimeFields,
  at: Locus
) -> Outcome<OffsetDateTime> {
  bind_outcome(o: refine(base: fields, by: leap_second_offset_datetime_validation, at: at), f: fn(refined) {
    outcome_accepted(value: LeapSecondOffsetDateTime { validity: LeapSecondOffsetDateTimeValidity { refined: refined } })
  })
}
