module v2.std.refinement_widening_predicate

fn refinement_widening_predicate_algebra(
  source: Node,
  candidate: Node,
) -> Node {
  refinement_widening_predicate_algebra_for_value_sets(
    source: source,
    candidate: candidate,
    source_value_set: Node { kind: TypeNode { connective: Atom { identity: ^refinement_value_set_unknown } }, children: [],
 occurrence_id: SyntheticOccurrence
},
    candidate_value_set: Node { kind: TypeNode { connective: Atom { identity: ^refinement_value_set_unknown } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  )
}
fn refinement_widening_predicate_algebra_for_value_sets(
  source: Node,
  candidate: Node,
  source_value_set: Node,
  candidate_value_set: Node,
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^refinement_widening_field_source },
        target: source
      },
      Edge {
        label: Named { name: ^refinement_widening_field_candidate },
        target: candidate
      },
      Edge {
        label: Named { name: ^refinement_widening_field_source_facts },
        target: source
      },
      Edge {
        label: Named { name: ^refinement_widening_field_source_value_set },
        target: source_value_set
      },
      Edge {
        label: Named { name: ^refinement_widening_field_candidate_value_set },
        target: candidate_value_set
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn refinement_widening_value_sets_hold(algebra: Node) -> Bool {
  match find_named_child(root: algebra, name: ^refinement_widening_field_source_value_set) {
    Accepted { value: source_value_set, diagnostics: None } =>
      match find_named_child(root: algebra, name: ^refinement_widening_field_candidate_value_set) {
        Accepted { value: candidate_value_set, diagnostics: None } =>
          integer_value_set_strictly_contains(container: candidate_value_set, contained: source_value_set)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn refinement_widening_is_strict_coarsening(algebra: Node) -> Bool {
  match find_named_child(root: algebra, name: ^refinement_widening_field_source_value_set) {
    Accepted { value: source_value_set, diagnostics: None } =>
      match find_named_child(root: algebra, name: ^refinement_widening_field_candidate_value_set) {
        Accepted { value: candidate_value_set, diagnostics: None } =>
          integer_value_set_strictly_contains(container: source_value_set, contained: candidate_value_set)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn refinement_widening_bundle_holds(
  source_facts: Node,
  candidate: Node,
  algebra: Node,
) -> Bool {
  match find_named_child(root: algebra, name: ^refinement_widening_field_source) {
    Accepted { value: bundled_source, diagnostics: None } =>
      match find_named_child(root: algebra, name: ^refinement_widening_field_candidate) {
        Accepted { value: bundled_candidate, diagnostics: None } =>
          match find_named_child(root: algebra, name: ^refinement_widening_field_source_facts) {
            Accepted { value: bundled_source_facts, diagnostics: None } =>
              (bundled_source == source_facts)
                && (bundled_candidate == candidate)
                && (bundled_source_facts == source_facts)
                && (source_facts != candidate)
                && refinement_widening_value_sets_hold(algebra: algebra)
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn refinement_widening_preservation_holds(
  source_facts: Node,
  candidate: Node,
  algebra: Node,
) -> Bool {
  well_formed(n: source_facts)
    && well_formed(n: algebra)
    && well_formed(n: candidate)
    && refinement_widening_bundle_holds(
      source_facts: source_facts,
      candidate: candidate,
      algebra: algebra
    )
}
