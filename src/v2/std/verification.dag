data v2_std_verification_file: Symbol = v2_std_verification_file
data test_claim_expected_outcome_undeclared: Symbol = test_claim_expected_outcome_undeclared
data unified_test_claim_bool_witness_absent: Symbol = unified_test_claim_bool_witness_absent


fn test_claim_expected_outcome_undeclared_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: test_claim_expected_outcome_undeclared,
    at: Textual { file: v2_std_verification_file, extent: WholeFile },
    correction: Unavailable { reason: UserInputBoundary }
  }
}


fn unified_test_claim_bool_witness_absent_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: unified_test_claim_bool_witness_absent,
    at: Textual { file: v2_std_verification_file, extent: WholeFile },
    correction: Unavailable { reason: UserInputBoundary }
  }
}


