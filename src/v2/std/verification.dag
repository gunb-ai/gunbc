type ImpossibleBugClass
// 🟢 coproduct dissolution — LB-P4-3212
  = SuboptimalComplexity
  | IdempotencyContract
  | TransportTypeDrift
  | NestedOptionalFlatten
  | UnenumeratedEffects
  | UnhandledDiagnosticPaths


// 🟡 gated — feature:coproduct-variant-enumeration — bound target: coproduct reflection / variant-enumeration substrate (docs/design-dissolution-lens.md L1.1) — bind gunbc#4759 — dissolve-on-arrival: derive ImpossibleBugClass variant list from coproduct reflection in std/verification.dag; delete this mirror.
// forbidden: parallel hand-enumerated ImpossibleBugClass universes outside std/verification.dag.
