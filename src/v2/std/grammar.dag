module v2.std.grammar


type FormalTerminal {
  identity: v2.std.node.Symbol
}

type FormalNonterminal {
  identity: v2.std.node.Symbol
}

type FormalGrammarSymbol
  = FormalTerminalOccurrence { terminal: FormalTerminal, binding: v2.std.optional.Optional<v2.std.node.Symbol> }
  | FormalNonterminalOccurrence { nonterminal: FormalNonterminal }

type FormalProduction {
  lhs: FormalNonterminal
  rhs: v2.std.collection.List<FormalGrammarSymbol>
}

type FormalGrammar {
  nonterminals: v2.std.collection.Set<FormalNonterminal>
  terminals: v2.std.collection.Set<FormalTerminal>
  productions: v2.std.collection.List<FormalProduction>
  start: FormalNonterminal
}

type GrammarAlphabetEnumerationEvidence {
  blocker: v2.std.node.Symbol
}

fn grammar_alphabet_enumeration_deferred_4766() -> GrammarAlphabetEnumerationEvidence {
  GrammarAlphabetEnumerationEvidence { blocker: ^grammar_enumeration_deferred_4766 }
}

type WellFormedFormalGrammar {
  grammar: FormalGrammar
  alphabet_enumeration: GrammarAlphabetEnumerationEvidence
}

fn validate_grammar_diagnostic(reason: v2.std.node.Symbol) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: reason,
    at: v2.std.diagnostic.port_locus(port: ^validate_grammar_port),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn formal_grammar_symbol_in_alphabet(
  nonterminals: v2.std.collection.Set<FormalNonterminal>,
  terminals: v2.std.collection.Set<FormalTerminal>,
  symbol: FormalGrammarSymbol
) -> v2.Bool {
  match symbol {
    FormalTerminalOccurrence { terminal: terminal, binding: _ } =>
      terminals.member(terminal)
    FormalNonterminalOccurrence { nonterminal: nonterminal } =>
      nonterminals.member(nonterminal)
  }
}

fn formal_production_rhs_in_alphabet(
  nonterminals: v2.std.collection.Set<FormalNonterminal>,
  terminals: v2.std.collection.Set<FormalTerminal>,
  production: FormalProduction
) -> v2.Bool {
  v2.std.algebra.fold_list(
    xs: production.rhs,
    empty: true,
    cons: fn(acc, symbol) {
      acc
        && formal_grammar_symbol_in_alphabet(
          nonterminals: nonterminals,
          terminals: terminals,
          symbol: symbol
        )
    }
  )
}

fn validate_grammar_all_lhs_in_nonterminals(g: FormalGrammar) -> v2.Bool {
  v2.std.algebra.fold_list(
    xs: g.productions,
    empty: true,
    cons: fn(acc, production) {
      acc && g.nonterminals.member(production.lhs)
    }
  )
}

fn validate_grammar_all_rhs_in_alphabet(g: FormalGrammar) -> v2.Bool {
  v2.std.algebra.fold_list(
    xs: g.productions,
    empty: true,
    cons: fn(acc, production) {
      acc
        && formal_production_rhs_in_alphabet(
          nonterminals: g.nonterminals,
          terminals: g.terminals,
          production: production
        )
    }
  )
}

fn validate_grammar(g: FormalGrammar) -> v2.std.witness.Witness<WellFormedFormalGrammar> {
  if !g.nonterminals.member(g.start) {
    v2.std.witness.Violates {
      diagnostic: validate_grammar_diagnostic(reason: ^validate_grammar_start_not_in_nonterminals)
    }
  } else if !validate_grammar_all_lhs_in_nonterminals(g: g) {
    v2.std.witness.Violates {
      diagnostic: validate_grammar_diagnostic(reason: ^validate_grammar_lhs_not_in_nonterminals)
    }
  } else if !validate_grammar_all_rhs_in_alphabet(g: g) {
    v2.std.witness.Violates {
      diagnostic: validate_grammar_diagnostic(reason: ^validate_grammar_rhs_symbol_not_in_alphabet)
    }
  } else {
    v2.std.witness.Holds {
      value: WellFormedFormalGrammar {
        grammar: g,
        alphabet_enumeration: grammar_alphabet_enumeration_deferred_4766()
      }
    }
  }
}

type GrammarTerminalLexCoverageObligation {
  lex: v2.std.compilers.lexing.LexRules
  grammar: WellFormedFormalGrammar
}

type ConcreteSyntaxSchema {
  terminal_coverage: GrammarTerminalLexCoverageObligation
}

fn concrete_syntax_schema(
  terminal_coverage: GrammarTerminalLexCoverageObligation
) -> ConcreteSyntaxSchema {
  ConcreteSyntaxSchema {
    terminal_coverage: terminal_coverage
  }
}

fn concrete_syntax_schema_lex(schema: ConcreteSyntaxSchema) -> v2.std.compilers.lexing.LexRules {
  schema.terminal_coverage.lex
}

fn concrete_syntax_schema_grammar(schema: ConcreteSyntaxSchema) -> WellFormedFormalGrammar {
  schema.terminal_coverage.grammar
}

type TerminalStampMode
  = StampClass
  | StampBinding { binding: v2.std.node.Symbol }
  | StampLexeme

type GrammarExpr
  = Terminal { token_class: v2.std.node.Symbol, stamp: TerminalStampMode }
  | Nonterminal { production: v2.std.node.Symbol }
  | Sequence { left: GrammarExpr, right: GrammarExpr }
  | Choice { left: GrammarExpr, right: GrammarExpr }
  | Optional { element: GrammarExpr }
  | Repeat { element: GrammarExpr }

fn grammar_expr_optional(element: GrammarExpr) -> GrammarExpr {
  Optional { element: element }
}

fn grammar_expr_terminal(token_class: v2.std.node.Symbol) -> GrammarExpr {
  Terminal { token_class: token_class, stamp: StampClass }
}

fn grammar_expr_terminal_bound(token_class: v2.std.node.Symbol, binding: v2.std.node.Symbol) -> GrammarExpr {
  Terminal { token_class: token_class, stamp: StampBinding { binding: binding } }
}

fn grammar_expr_terminal_lexeme(token_class: v2.std.node.Symbol) -> GrammarExpr {
  Terminal { token_class: token_class, stamp: StampLexeme }
}

fn formal_grammar_symbol_to_grammar_expr(sym: FormalGrammarSymbol) -> GrammarExpr {
  match sym {
    FormalTerminalOccurrence { terminal: terminal, binding: binding } =>
      match binding {
        v2.std.optional.Present { value: b } =>
          if formal_binding_is_lexeme_stamp_slot(binding: b) {
            grammar_expr_terminal_lexeme(token_class: terminal.identity)
          } else {
            grammar_expr_terminal_bound(token_class: terminal.identity, binding: b)
          }
        v2.std.optional.Absent =>
          grammar_expr_terminal(token_class: terminal.identity)
      }
    FormalNonterminalOccurrence { nonterminal: nonterminal } =>
      Nonterminal { production: nonterminal.identity }
  }
}

type GrammarExprFold<R> {
  terminal: fn(v2.std.node.Symbol, TerminalStampMode) -> R
  nonterminal: fn(v2.std.node.Symbol) -> R
  sequence: fn(R, R) -> R
  choice: fn(R, R) -> R
  optional: fn(R) -> R
  repeat: fn(R) -> R
}

fn fold_grammar_expr<R>(expr: GrammarExpr, algebra: GrammarExprFold<R>) -> R {
  match expr {
    Terminal { token_class: token_class, stamp: stamp } =>
      algebra.terminal(token_class, stamp)
    Nonterminal { production: production } => algebra.nonterminal(production)
    Sequence { left: left, right: right } =>
      algebra.sequence(
        fold_grammar_expr(expr: left, algebra: algebra),
        fold_grammar_expr(expr: right, algebra: algebra)
      )
    Choice { left: left, right: right } =>
      algebra.choice(
        fold_grammar_expr(expr: left, algebra: algebra),
        fold_grammar_expr(expr: right, algebra: algebra)
      )
    Optional { element: element } =>
      algebra.optional(fold_grammar_expr(expr: element, algebra: algebra))
    Repeat { element: element } =>
      algebra.repeat(fold_grammar_expr(expr: element, algebra: algebra))
  }
}

type GrammarProduction {
  name: v2.std.node.Symbol
  expression: GrammarExpr
  emitted: v2.std.node.Node
}

// SYNC TOKENS ARE AN ENUMERATION, NOT A PREDICATE.
//
// A grammar's error-recovery sync tokens are finite and known at authoring time — every producer in
// the corpus writes either an empty set or a literal list of keyword classes. Carrying them as
// `v2.std.collection.Set<v2.std.node.Symbol>` made them a POINTWISE-POWER characteristic function (`std.types` grounds
// `v2.std.collection.Set<element> = PointwisePower<element>`), which is the right grounding for a set in general and
// the wrong carrier for six literal keywords: a characteristic function cannot be enumerated, so
// the whole grammar value became unhashable through this one field.
//
// That was not a theoretical loss. `prepare_grammar` is memoized cross-claim on
// (declaration identity, content hash of the grammar), and the interpreter's content-hash walk
// BAILS on a closure — so the memo could never form its key, never store, and never hit, for every
// language in the corpus and not only `.dag`. The measured consequence was a full ~12s grammar
// preparation on every parse, including of an empty module.
//
// The field is therefore the enumeration it always was. `v2.std.collection.Set` keeps its grounding untouched; what
// changed is that this field stopped borrowing a power-set to carry a list.
type GrammarRoot {
  start: v2.std.node.Symbol
  productions: v2.std.collection.List<GrammarProduction>
  sync_tokens: v2.std.collection.List<v2.std.node.Symbol>
}

type ValidatedGrammarRoot {
  root: GrammarRoot
}

type ParseGrammar
  = VoidGrammar
  | ModeledGrammar { root: GrammarRoot }

type GrammarSchema {
  lex: v2.std.compilers.lexing.LexRules
  grammar: ParseGrammar
}

type GrammarSchemaProbe {
  fixture: v2.std.text.String
  production: FormalProduction
  expected_parse_surface: v2.std.node.Node
}

type GrammarSchemaProbeBinding {
  schema: GrammarSchema
  probe: GrammarSchemaProbe
}

type GrammarRelationRow {
  production: FormalProduction
  emitted: v2.std.node.Node
}

type ParseTree = v2.std.node.Node

type GrammarSymbolFoldState {
  found: v2.Bool
}

fn grammar_atom(identity: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode {
      connective: v2.std.node.Atom { identity: identity }
    },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn grammar_named_edge(name: v2.std.node.Symbol, target: v2.std.node.Node) -> v2.std.node.Edge {
  v2.std.node.Edge {
    label: v2.std.node.Named { name: name },
    target: target
  }
}

fn grammar_empty_sync_tokens() -> v2.std.collection.List<v2.std.node.Symbol> {
  []
}

fn grammar_empty_node() -> v2.std.node.Node {
  v2.std.node_shape.stamp_node_shape_synthetic(shape: v2.std.node_shape.type_shape(connective: v2.std.node.Conj, children: []))
}

fn grammar_formal_nonterminal(identity: v2.std.node.Symbol) -> FormalNonterminal {
  FormalNonterminal { identity: identity }
}

fn grammar_formal_terminal(identity: v2.std.node.Symbol) -> FormalGrammarSymbol {
  FormalTerminalOccurrence {
    terminal: FormalTerminal { identity: identity },
    binding: v2.std.optional.optional_absent()
  }
}

fn grammar_formal_terminal_bound(identity: v2.std.node.Symbol, binding: v2.std.node.Symbol) -> FormalGrammarSymbol {
  FormalTerminalOccurrence {
    terminal: FormalTerminal { identity: identity },
    binding: v2.std.optional.optional_present(value: binding)
  }
}

data grammar_free_name_slot_binding: v2.std.node.Symbol = ^grammar_free_name_slot

data grammar_lexeme_stamp_slot_binding: v2.std.node.Symbol = ^grammar_lexeme_stamp_slot

fn formal_binding_is_free_name_slot(binding: v2.std.node.Symbol) -> v2.Bool {
  binding == ^grammar_free_name_slot
}

fn formal_binding_is_lexeme_stamp_slot(binding: v2.std.node.Symbol) -> v2.Bool {
  binding == ^grammar_lexeme_stamp_slot
}

fn formal_binding_is_emitted_atom_from_slot(binding: v2.std.node.Symbol) -> v2.Bool {
  formal_binding_is_free_name_slot(binding: binding)
    || formal_binding_is_lexeme_stamp_slot(binding: binding)
}

fn grammar_formal_terminal_free(identity: v2.std.node.Symbol) -> FormalGrammarSymbol {
  grammar_formal_terminal_bound(identity: identity, binding: ^grammar_free_name_slot)
}

fn grammar_formal_terminal_lexeme(identity: v2.std.node.Symbol) -> FormalGrammarSymbol {
  grammar_formal_terminal_bound(identity: identity, binding: ^grammar_lexeme_stamp_slot)
}

fn grammar_formal_nonterminal_occurrence(identity: v2.std.node.Symbol) -> FormalGrammarSymbol {
  FormalNonterminalOccurrence {
    nonterminal: FormalNonterminal { identity: identity }
  }
}

fn grammar_formal_production(lhs: v2.std.node.Symbol, rhs: v2.std.collection.List<FormalGrammarSymbol>) -> FormalProduction {
  FormalProduction {
    lhs: grammar_formal_nonterminal(identity: lhs),
    rhs: rhs
  }
}

fn formal_terminal_to_node(terminal: FormalTerminal) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode {
      connective: v2.std.node.Conj
    },
    children: [
      grammar_named_edge(name: ^formal_terminal_identity_node_projection, target: grammar_atom(identity: terminal.identity))
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn formal_terminal_occurrence_to_node(terminal: FormalTerminal, binding: v2.std.optional.Optional<v2.std.node.Symbol>) -> v2.std.node.Node {
  match binding {
    v2.std.optional.Present { value: binding } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode {
          connective: v2.std.node.Conj
        },
        children: [
          grammar_named_edge(
            name: ^formal_terminal_identity_node_projection,
            target: grammar_atom(identity: terminal.identity)
          ),
          grammar_named_edge(
            name: ^formal_terminal_occurrence_binding_node_projection,
            target: grammar_atom(identity: binding)
          )
        ],
        occurrence_id: v2.std.node.SyntheticOccurrence
}
    v2.std.optional.Absent => formal_terminal_to_node(terminal: terminal)
  }
}

fn formal_nonterminal_to_node(nonterminal: FormalNonterminal) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode {
      connective: v2.std.node.Conj
    },
    children: [
      grammar_named_edge(name: ^formal_nonterminal_identity_node_projection, target: grammar_atom(identity: nonterminal.identity))
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn formal_grammar_symbol_to_node(symbol: FormalGrammarSymbol) -> v2.std.node.Node {
  match symbol {
    FormalTerminalOccurrence { terminal: terminal, binding: binding } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode {
          connective: v2.std.node.Conj
        },
        children: [
          grammar_named_edge(
            name: ^formal_symbol_terminal_node_projection,
            target: formal_terminal_occurrence_to_node(terminal: terminal, binding: binding)
          )
        ],
        occurrence_id: v2.std.node.SyntheticOccurrence
}
    FormalNonterminalOccurrence { nonterminal: nonterminal } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode {
          connective: v2.std.node.Conj
        },
        children: [
          grammar_named_edge(name: ^formal_symbol_nonterminal_node_projection, target: formal_nonterminal_to_node(nonterminal: nonterminal))
        ],
        occurrence_id: v2.std.node.SyntheticOccurrence
}
  }
}

fn formal_rhs_to_edges(symbols: v2.std.collection.List<FormalGrammarSymbol>) -> v2.std.collection.List<v2.std.node.Edge> {
  v2.std.algebra.fold_list(
    xs: symbols,
    empty: std.algebra.Empty,
    cons: fn(acc, symbol) {
      v2.std.algebra.list_snoc_item(
        xs: acc,
        item: v2.std.node.Edge { label: v2.std.node.Positional, target: formal_grammar_symbol_to_node(symbol: symbol) }
      )
    }
  )
}

fn formal_production_to_node(production: FormalProduction) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode {
      connective: v2.std.node.Conj
    },
    children: [
      grammar_named_edge(name: ^formal_production_lhs_node_projection, target: formal_nonterminal_to_node(nonterminal: production.lhs)),
      grammar_named_edge(
        name: ^formal_production_rhs_node_projection,
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode {
            connective: v2.std.node.Conj
          },
          children: formal_rhs_to_edges(symbols: production.rhs),
          occurrence_id: v2.std.node.SyntheticOccurrence
}
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn grammar_atom_identity_from_node(node: v2.std.node.Node) -> v2.std.witness.Witness<v2.std.node.Symbol> {
  match node.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } } => v2.std.witness.Holds { value: id }
  _ =>
    v2.std.witness.Violates {
      diagnostic: v2.std.diagnostic.Diagnostic {
        reason: ^grammar_relation_production_not_found,
        at: v2.std.diagnostic.node_locus(node: node),
        correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
      }
    }
  }
}

fn formal_nonterminal_from_node(node: v2.std.node.Node) -> v2.std.witness.Witness<FormalNonterminal> {
  match node.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      match v2.std.node_query.find_named_child(root: node, name: ^formal_nonterminal_identity_node_projection) {
        v2.std.diagnostic.Accepted { value: identity_node, diagnostics: _ } =>
          match grammar_atom_identity_from_node(node: identity_node) {
            v2.std.witness.Holds { value: id } =>
              v2.std.witness.Holds { value: FormalNonterminal { identity: id } }
            v2.std.witness.Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
          }
        v2.std.diagnostic.Rejected { diagnostics: nd } =>
          v2.std.witness.Violates {
            diagnostic: v2.std.diagnostic.Diagnostic {
              reason: ^grammar_relation_production_not_found,
              at: v2.std.diagnostic.node_locus(node: node),
              correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
            }
          }
      }
    _ =>
      v2.std.witness.Violates {
        diagnostic: v2.std.diagnostic.Diagnostic {
          reason: ^grammar_relation_production_not_found,
          at: v2.std.diagnostic.node_locus(node: node),
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
        }
      }
  }
}

fn formal_terminal_from_node(node: v2.std.node.Node) -> v2.std.witness.Witness<FormalTerminal> {
  match node.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      match v2.std.node_query.find_named_child(root: node, name: ^formal_terminal_identity_node_projection) {
        v2.std.diagnostic.Accepted { value: identity_node, diagnostics: _ } =>
          match grammar_atom_identity_from_node(node: identity_node) {
            v2.std.witness.Holds { value: id } =>
              v2.std.witness.Holds { value: FormalTerminal { identity: id } }
            v2.std.witness.Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } =>
          v2.std.witness.Violates {
            diagnostic: v2.std.diagnostic.Diagnostic {
              reason: ^grammar_relation_production_not_found,
              at: v2.std.diagnostic.node_locus(node: node),
              correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
            }
          }
      }
    _ =>
      v2.std.witness.Violates {
        diagnostic: v2.std.diagnostic.Diagnostic {
          reason: ^grammar_relation_production_not_found,
          at: v2.std.diagnostic.node_locus(node: node),
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
        }
      }
  }
}

fn formal_terminal_occurrence_from_node(node: v2.std.node.Node) -> v2.std.witness.Witness<FormalGrammarSymbol> {
  match formal_terminal_from_node(node: node) {
    v2.std.witness.Holds { value: terminal } =>
      match v2.std.node_query.find_named_child(root: node, name: ^formal_terminal_occurrence_binding_node_projection) {
        v2.std.diagnostic.Accepted { value: binding_node, diagnostics: _ } =>
          match grammar_atom_identity_from_node(node: binding_node) {
            v2.std.witness.Holds { value: binding } =>
              v2.std.witness.Holds {
                value: FormalTerminalOccurrence {
                  terminal: terminal,
                  binding: v2.std.optional.optional_present(value: binding)
                }
              }
            v2.std.witness.Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } =>
          v2.std.witness.Holds {
            value: FormalTerminalOccurrence {
              terminal: terminal,
              binding: v2.std.optional.optional_absent()
            }
          }
      }
    v2.std.witness.Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
  }
}

fn formal_grammar_symbol_from_node(node: v2.std.node.Node) -> v2.std.witness.Witness<FormalGrammarSymbol> {
  match node.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      match v2.std.node_query.find_named_child(root: node, name: ^formal_symbol_terminal_node_projection) {
        v2.std.diagnostic.Accepted { value: terminal_node, diagnostics: _ } =>
          formal_terminal_occurrence_from_node(node: terminal_node)
        v2.std.diagnostic.Rejected { diagnostics: _ } =>
          match v2.std.node_query.find_named_child(root: node, name: ^formal_symbol_nonterminal_node_projection) {
            v2.std.diagnostic.Accepted { value: nonterminal_node, diagnostics: _ } =>
              match formal_nonterminal_from_node(node: nonterminal_node) {
                v2.std.witness.Holds { value: nonterminal } =>
                  v2.std.witness.Holds {
                    value: FormalNonterminalOccurrence { nonterminal: nonterminal }
                  }
                v2.std.witness.Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
              }
            v2.std.diagnostic.Rejected { diagnostics: _ } =>
              v2.std.witness.Violates {
                diagnostic: v2.std.diagnostic.Diagnostic {
                  reason: ^grammar_relation_production_not_found,
                  at: v2.std.diagnostic.node_locus(node: node),
                  correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
                }
              }
          }
      }
    _ =>
      v2.std.witness.Violates {
        diagnostic: v2.std.diagnostic.Diagnostic {
          reason: ^grammar_relation_production_not_found,
          at: v2.std.diagnostic.node_locus(node: node),
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
        }
      }
  }
}

fn formal_rhs_from_node(node: v2.std.node.Node) -> v2.std.witness.Witness<v2.std.collection.List<FormalGrammarSymbol>> {
  match node.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      match fold(
        node.children,
        init: v2.std.witness.Holds { value: std.algebra.Empty },
        f: fn(acc, edge) {
          match acc {
            v2.std.witness.Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
            v2.std.witness.Holds { value: symbols } =>
              match edge.label {
                v2.std.node.Positional =>
                  match formal_grammar_symbol_from_node(node: edge.target) {
                    v2.std.witness.Holds { value: symbol } =>
                      v2.std.witness.Holds {
                        value: v2.std.algebra.list_snoc_item(xs: symbols, item: symbol)
                      }
                    v2.std.witness.Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
                  }
                v2.std.node.Named { name: _ } => acc
              }
          }
        }
      ) {
        v2.std.witness.Holds { value: symbols } => v2.std.witness.Holds { value: symbols }
        v2.std.witness.Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
      }
    _ =>
      v2.std.witness.Violates {
        diagnostic: v2.std.diagnostic.Diagnostic {
          reason: ^grammar_relation_production_not_found,
          at: v2.std.diagnostic.node_locus(node: node),
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
        }
      }
  }
}

fn formal_production_from_node(node: v2.std.node.Node) -> v2.std.witness.Witness<FormalProduction> {
  match node.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      match v2.std.node_query.find_named_child(root: node, name: ^formal_production_lhs_node_projection) {
        v2.std.diagnostic.Accepted { value: lhs_node, diagnostics: _ } =>
          match v2.std.node_query.find_named_child(root: node, name: ^formal_production_rhs_node_projection) {
            v2.std.diagnostic.Accepted { value: rhs_node, diagnostics: _ } =>
              match formal_nonterminal_from_node(node: lhs_node) {
                v2.std.witness.Holds { value: lhs } =>
                  match formal_rhs_from_node(node: rhs_node) {
                    v2.std.witness.Holds { value: rhs } =>
                      v2.std.witness.Holds {
                        value: FormalProduction { lhs: lhs, rhs: rhs }
                      }
                    v2.std.witness.Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
                  }
                v2.std.witness.Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
              }
            v2.std.diagnostic.Rejected { diagnostics: _ } =>
              v2.std.witness.Violates {
                diagnostic: v2.std.diagnostic.Diagnostic {
                  reason: ^grammar_relation_production_not_found,
                  at: v2.std.diagnostic.node_locus(node: node),
                  correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
                }
              }
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } =>
          v2.std.witness.Violates {
            diagnostic: v2.std.diagnostic.Diagnostic {
              reason: ^grammar_relation_production_not_found,
              at: v2.std.diagnostic.node_locus(node: node),
              correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
            }
          }
      }
    _ =>
      v2.std.witness.Violates {
        diagnostic: v2.std.diagnostic.Diagnostic {
          reason: ^grammar_relation_production_not_found,
          at: v2.std.diagnostic.node_locus(node: node),
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
        }
      }
  }
}

fn grammar_relation_row_production_from_node(row: v2.std.node.Node) -> v2.std.witness.Witness<FormalProduction> {
  match v2.std.node_query.find_named_child(root: row, name: ^grammar_relation_field_production) {
    v2.std.diagnostic.Accepted { value: production_node, diagnostics: _ } =>
      formal_production_from_node(node: production_node)
    v2.std.diagnostic.Rejected { diagnostics: nd } =>
      v2.std.witness.Violates {
        diagnostic: v2.std.diagnostic.Diagnostic {
          reason: ^grammar_relation_production_not_found,
          at: v2.std.diagnostic.node_locus(node: row),
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
        }
      }
  }
}

fn grammar_relation_row_emitted_fixture(row: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.node_query.find_named_child(root: row, name: ^grammar_relation_field_emitted)
}

fn grammar_relation_rules_formal_productions_step(
  acc: v2.std.diagnostic.Outcome<v2.std.collection.List<FormalProduction>>,
  row: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<FormalProduction>> {
  v2.std.diagnostic.bind_outcome(
    o: acc,
    f: fn(productions) {
      match grammar_relation_row_production_from_node(row: row) {
        v2.std.witness.Holds { value: production } =>
          v2.std.diagnostic.outcome_accepted(value: v2.std.algebra.list_snoc_item(xs: productions, item: production))
        v2.std.witness.Violates { diagnostic: _ } => v2.std.diagnostic.outcome_accepted(value: productions)
      }
    }
  )
}

fn grammar_relation_rules_formal_productions_from_rows(rules: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.collection.List<FormalProduction>> {
  match rules.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      fold(
        rules.children,
        init: v2.std.diagnostic.outcome_accepted(value: std.algebra.Empty),
        f: fn(acc, edge) {
          match edge.label {
            v2.std.node.Named { name: n } =>
              if n == ^grammar_relation_rules_formal_productions {
                acc
              } else {
                grammar_relation_rules_formal_productions_step(acc: acc, row: edge.target)
              }
            v2.std.node.Positional => acc
          }
        }
      )
    _ =>
      v2.std.diagnostic.outcome_rejected(
        v2.std.diagnostic.Diagnostic {
          reason: ^grammar_relation_production_not_found,
          at: v2.std.diagnostic.node_locus(node: rules),
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
        }
      )
  }
}

fn formal_productions_catalog_to_node(productions: v2.std.collection.List<FormalProduction>) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode {
      connective: v2.std.node.Conj
    },
    children: v2.std.algebra.fold_list(
      xs: productions,
      empty: std.algebra.Empty,
      cons: fn(acc, production) {
        v2.std.algebra.list_snoc_item(
          xs: acc,
          item: v2.std.node.Edge {
            label: v2.std.node.Positional,
            target: formal_production_to_node(production: production)
          }
        )
      }
    ),
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn formal_productions_from_catalog_node(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.collection.List<FormalProduction>> {
  match node.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      fold(
        node.children,
        init: v2.std.diagnostic.outcome_accepted(value: std.algebra.Empty),
        f: fn(acc, edge) {
          v2.std.diagnostic.bind_outcome(
            o: acc,
            f: fn(productions) {
              match edge.label {
                v2.std.node.Positional =>
                  match formal_production_from_node(node: edge.target) {
                    v2.std.witness.Holds { value: production } =>
                      v2.std.diagnostic.outcome_accepted(
                        value: v2.std.algebra.list_snoc_item(xs: productions, item: production)
                      )
                    v2.std.witness.Violates { diagnostic: d } => v2.std.diagnostic.outcome_rejected(d)
                  }
                v2.std.node.Named { name: _ } => v2.std.diagnostic.outcome_accepted(value: productions)
              }
            }
          )
        }
      )
    _ =>
      v2.std.diagnostic.outcome_rejected(
        v2.std.diagnostic.Diagnostic {
          reason: ^grammar_relation_production_not_found,
          at: v2.std.diagnostic.node_locus(node: node),
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
        }
      )
  }
}

fn grammar_relation_rules_formal_productions(rules: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.collection.List<FormalProduction>> {
  match v2.std.node_query.find_named_child(root: rules, name: ^grammar_relation_rules_formal_productions) {
    v2.std.diagnostic.Accepted { value: catalog, diagnostics: _ } =>
      formal_productions_from_catalog_node(node: catalog)
    v2.std.diagnostic.Rejected { diagnostics: _ } =>
      grammar_relation_rules_formal_productions_from_rows(rules: rules)
  }
}

fn derive_grammar_relation_row(production: FormalProduction, emitted: v2.std.node.Node) -> GrammarRelationRow {
  GrammarRelationRow {
    production: production,
    emitted: emitted
  }
}

fn grammar_relation_row_to_node(row: GrammarRelationRow, tokens: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode {
      connective: v2.std.node.Conj
    },
    children: [
      grammar_named_edge(
        name: ^grammar_relation_field_production,
        target: formal_production_to_node(production: row.production)
      ),
      grammar_named_edge(name: ^grammar_relation_field_emitted, target: row.emitted),
      grammar_named_edge(name: ^grammar_relation_field_tokens, target: tokens)
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn grammar_relation_tokens_node<T>(
  tokens: v2.std.collection.List<T>,
  token_to_node: fn(T) -> v2.std.node.Node
) -> v2.std.node.Node {
  v2.std.algebra.fold_list_node(xs: tokens, item_node: token_to_node)
}

fn grammar_concrete_fixed_token_node(token_class: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.compilers.target_model.concrete_syntax_token_to_node(token: v2.std.compilers.target_model.FixedToken { token_class: token_class })
}

fn grammar_concrete_bound_token_node(token_class: v2.std.node.Symbol, binding: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.compilers.target_model.concrete_syntax_token_to_node(
    token: v2.std.compilers.target_model.BoundToken { token_class: token_class, binding: binding }
  )
}

fn grammar_terminal_occurrence_to_token_edge(terminal: FormalTerminal, binding: v2.std.optional.Optional<v2.std.node.Symbol>) -> v2.std.node.Edge {
  match binding {
    v2.std.optional.Present { value: binding } =>
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: grammar_concrete_bound_token_node(token_class: terminal.identity, binding: binding)
      }
    v2.std.optional.Absent =>
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: grammar_concrete_fixed_token_node(token_class: terminal.identity)
      }
  }
}

fn derive_grammar_relation_terminal_token_edges_step(
  acc: v2.std.collection.List<v2.std.node.Edge>,
  symbol: FormalGrammarSymbol
) -> v2.std.collection.List<v2.std.node.Edge> {
  match symbol {
    FormalTerminalOccurrence { terminal: terminal, binding: binding } =>
      v2.std.algebra.list_snoc_item(
        xs: acc,
        item: grammar_terminal_occurrence_to_token_edge(terminal: terminal, binding: binding)
      )
    FormalNonterminalOccurrence { nonterminal: _ } => acc
  }
}

fn derive_grammar_relation_terminal_token_edges(production: FormalProduction) -> v2.std.collection.List<v2.std.node.Edge> {
  v2.std.algebra.fold_list(
    xs: production.rhs,
    empty: std.algebra.Empty,
    cons: fn(acc, symbol) {
      derive_grammar_relation_terminal_token_edges_step(acc: acc, symbol: symbol)
    }
  )
}

fn conj_positional_child_count(children: v2.std.collection.List<v2.std.node.Node>) -> Int {
  v2.std.algebra.fold_list(
    xs: children,
    empty: 0,
    cons: fn(count, _) {
      count + 1
    }
  )
}

fn conj_positional_children(parent: v2.std.node.Node) -> v2.std.collection.List<v2.std.node.Node> {
  match parent.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      fold(
        parent.children,
        init: std.algebra.Empty,
        f: fn(acc, edge) {
          match edge.label {
            v2.std.node.Positional => v2.std.algebra.list_snoc_item(xs: acc, item: edge.target)
            v2.std.node.Named { name: _ } => acc
          }
        }
      )
    _ => std.algebra.Empty
  }
}

fn formal_production_emitted_slot_count_step(count: Int, symbol: FormalGrammarSymbol) -> Int {
  match symbol {
    FormalTerminalOccurrence { terminal: _, binding: binding } =>
      match binding {
        v2.std.optional.Present { value: _ } => count + 1
        v2.std.optional.Absent => count
      }
    FormalNonterminalOccurrence { nonterminal: _ } => count + 1
  }
}

fn formal_production_emitted_slot_count(production: FormalProduction) -> Int {
  v2.std.algebra.fold_list(
    xs: production.rhs,
    empty: 0,
    cons: formal_production_emitted_slot_count_step
  )
}

fn formal_production_lhs_matches(production: FormalProduction, lhs: v2.std.node.Symbol) -> v2.Bool {
  production.lhs.identity == lhs
}

fn formal_productions_for_lhs_step(
  acc: v2.std.collection.List<FormalProduction>,
  production: FormalProduction,
  lhs: v2.std.node.Symbol
) -> v2.std.collection.List<FormalProduction> {
  if formal_production_lhs_matches(production: production, lhs: lhs) {
    v2.std.algebra.list_snoc_item(xs: acc, item: production)
  } else {
    acc
  }
}

fn formal_productions_for_lhs(
  productions: v2.std.collection.List<FormalProduction>,
  lhs: v2.std.node.Symbol
) -> v2.std.collection.List<FormalProduction> {
  v2.std.algebra.fold_list(
    xs: productions,
    empty: std.algebra.Empty,
    cons: fn(acc, production) {
      formal_productions_for_lhs_step(acc: acc, production: production, lhs: lhs)
    }
  )
}

fn formal_production_matches_lhs_and_slot_count(
  production: FormalProduction,
  lhs: v2.std.node.Symbol,
  emitted_slot_count: Int
) -> v2.Bool {
  formal_production_lhs_matches(production: production, lhs: lhs) &&
    formal_production_emitted_slot_count(production: production) == emitted_slot_count
}

type RhsSingletonTerminalLookup
  = RhsSingletonTerminalNotSeen
  | RhsSingletonTerminalFound { identity: v2.std.node.Symbol }
  | RhsSingletonTerminalAmbiguous

fn formal_production_rhs_singleton_terminal_identity_step(
  state: RhsSingletonTerminalLookup,
  symbol: FormalGrammarSymbol
) -> RhsSingletonTerminalLookup {
  match state {
    RhsSingletonTerminalAmbiguous => state
    RhsSingletonTerminalFound { identity: _ } => RhsSingletonTerminalAmbiguous
    RhsSingletonTerminalNotSeen =>
      match symbol {
        FormalTerminalOccurrence { terminal: terminal, binding: binding } =>
          match binding {
            v2.std.optional.Absent => RhsSingletonTerminalFound { identity: terminal.identity }
            v2.std.optional.Present { value: _ } => RhsSingletonTerminalAmbiguous
          }
        FormalNonterminalOccurrence { nonterminal: _ } => RhsSingletonTerminalAmbiguous
      }
  }
}

fn formal_production_rhs_singleton_terminal_identity(production: FormalProduction) -> v2.std.node.Symbol? {
  match v2.std.algebra.fold_list(
    xs: production.rhs,
    empty: RhsSingletonTerminalNotSeen,
    cons: formal_production_rhs_singleton_terminal_identity_step
  ) {
    RhsSingletonTerminalFound { identity: id } => v2.std.optional.Present { value: id }
    _ => v2.std.optional.Absent
  }
}

type RhsSingletonBindingLookup
  = RhsSingletonBindingNotSeen
  | RhsSingletonBindingFound { binding: v2.std.node.Symbol }
  | RhsSingletonBindingAmbiguous

fn formal_production_rhs_singleton_binding_step(
  state: RhsSingletonBindingLookup,
  symbol: FormalGrammarSymbol
) -> RhsSingletonBindingLookup {
  match state {
    RhsSingletonBindingAmbiguous => state
    RhsSingletonBindingFound { binding: _ } => RhsSingletonBindingAmbiguous
    RhsSingletonBindingNotSeen =>
      match symbol {
        FormalTerminalOccurrence { terminal: _, binding: binding } =>
          match binding {
            v2.std.optional.Present { value: b } => RhsSingletonBindingFound { binding: b }
            v2.std.optional.Absent => RhsSingletonBindingAmbiguous
          }
        FormalNonterminalOccurrence { nonterminal: _ } => RhsSingletonBindingAmbiguous
      }
  }
}

fn formal_production_rhs_singleton_binding(production: FormalProduction) -> v2.std.node.Symbol? {
  match v2.std.algebra.fold_list(
    xs: production.rhs,
    empty: RhsSingletonBindingNotSeen,
    cons: formal_production_rhs_singleton_binding_step
  ) {
    RhsSingletonBindingFound { binding: b } => v2.std.optional.Present { value: b }
    _ => v2.std.optional.Absent
  }
}

fn node_atom_identity_optional(node: v2.std.node.Node) -> v2.std.node.Symbol? {
  match node.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } } => v2.std.optional.Present { value: id }
    _ => v2.std.optional.Absent
  }
}

type FormalBindingConjSlotArm
  = FormalBindingConjSlotEmittedAtom
  | FormalBindingConjSlotExactBinding

fn formal_binding_conj_slot_arm(binding: v2.std.node.Symbol) -> FormalBindingConjSlotArm {
  if formal_binding_is_emitted_atom_from_slot(binding: binding) {
    FormalBindingConjSlotEmittedAtom
  } else {
    FormalBindingConjSlotExactBinding
  }
}

fn grammar_relation_emitted_conj_slot_missing_diagnostic(emitted: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^grammar_relation_emitted_conj_slot_missing,
    at: v2.std.diagnostic.node_locus(node: emitted),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn formal_conj_child_atom_at_index(
  children: v2.std.collection.List<v2.std.node.Node>,
  index: Int,
  emitted: v2.std.node.Node
) -> v2.std.witness.Witness<v2.std.node.Node> {
  match v2.std.collection.list_nth(
    xs: children,
    wanted: index,
    absent: grammar_relation_emitted_conj_slot_missing_diagnostic(emitted: emitted)
  ) {
    v2.std.witness.Holds { value: slot_child } =>
      match node_atom_identity_optional(node: slot_child) {
        v2.std.optional.Present { value: _ } => v2.std.witness.Holds { value: slot_child }
        v2.std.optional.Absent =>
          v2.std.witness.Violates {
            diagnostic: grammar_relation_emitted_conj_slot_missing_diagnostic(emitted: emitted)
          }
      }
    v2.std.witness.Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
  }
}

type EmittedRhsMatchState
  = EmittedRhsMatchOk { children: v2.std.collection.List<v2.std.node.Node>, index: Int }
  | EmittedRhsMatchFail

fn formal_production_rhs_matches_emitted_conj_step(
  state: EmittedRhsMatchState,
  productions: v2.std.collection.List<FormalProduction>,
  emitted: v2.std.node.Node,
  symbol: FormalGrammarSymbol
) -> EmittedRhsMatchState {
  match state {
    EmittedRhsMatchFail => state
    EmittedRhsMatchOk { children: children, index: index } =>
      match symbol {
        FormalTerminalOccurrence { terminal: terminal, binding: binding } =>
          match binding {
            v2.std.optional.Present { value: binding_symbol } =>
              match formal_binding_conj_slot_arm(binding: binding_symbol) {
                FormalBindingConjSlotEmittedAtom =>
                  match formal_conj_child_atom_at_index(
                    children: children,
                    index: index,
                    emitted: emitted
                  ) {
                    v2.std.witness.Holds { value: _ } =>
                      EmittedRhsMatchOk { children: children, index: index + 1 }
                    v2.std.witness.Violates { diagnostic: _ } => EmittedRhsMatchFail
                  }
                FormalBindingConjSlotExactBinding =>
                  match formal_conj_child_atom_at_index(
                    children: children,
                    index: index,
                    emitted: emitted
                  ) {
                    v2.std.witness.Holds { value: slot_child } =>
                      match node_atom_identity_optional(node: slot_child) {
                        v2.std.optional.Present { value: atom_id } =>
                          if atom_id == binding_symbol {
                            EmittedRhsMatchOk { children: children, index: index + 1 }
                          } else {
                            EmittedRhsMatchFail
                          }
                        v2.std.optional.Absent => EmittedRhsMatchFail
                      }
                    v2.std.witness.Violates { diagnostic: _ } => EmittedRhsMatchFail
                  }
              }
            v2.std.optional.Absent =>
              EmittedRhsMatchOk { children: children, index: index }
          }
        FormalNonterminalOccurrence { nonterminal: nonterminal } =>
          match v2.std.collection.list_nth(
            xs: children,
            wanted: index,
            absent: v2.std.diagnostic.Diagnostic {
              reason: ^grammar_relation_emitted_conj_slot_missing,
              at: v2.std.diagnostic.node_locus(node: emitted),
              correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
            }
          ) {
            v2.std.witness.Holds { value: slot_child } =>
              match formal_production_for_lhs_exact(
                productions: productions,
                lhs: nonterminal.identity,
                child: slot_child
              ) {
                v2.std.witness.Holds { value: _ } =>
                  EmittedRhsMatchOk { children: children, index: index + 1 }
                v2.std.witness.Violates { diagnostic: _ } => EmittedRhsMatchFail
              }
            v2.std.witness.Violates { diagnostic: _ } => EmittedRhsMatchFail
          }
      }
  }
}

fn formal_production_rhs_matches_emitted_conj(
  production: FormalProduction,
  productions: v2.std.collection.List<FormalProduction>,
  emitted: v2.std.node.Node
) -> v2.Bool {
  match emitted.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      formal_production_rhs_matches_emitted_conj_conj(
        production: production,
        productions: productions,
        emitted: emitted
      )
    _ => false
  }
}

fn formal_production_rhs_matches_emitted_conj_conj(
  production: FormalProduction,
  productions: v2.std.collection.List<FormalProduction>,
  emitted: v2.std.node.Node
) -> v2.Bool {
  let children = conj_positional_children(parent: emitted)
  let child_count = conj_positional_child_count(children: children)
  match v2.std.algebra.fold_list(
    xs: production.rhs,
    empty: EmittedRhsMatchOk { children: children, index: 0 },
    cons: fn(state, symbol) {
      formal_production_rhs_matches_emitted_conj_step(
        state: state,
        productions: productions,
        emitted: emitted,
        symbol: symbol
      )
    }
  ) {
    EmittedRhsMatchOk { children: _, index: index } => index == child_count
    EmittedRhsMatchFail => false
  }
}

fn formal_production_matches_emitted_child(
  production: FormalProduction,
  productions: v2.std.collection.List<FormalProduction>,
  child: v2.std.node.Node
) -> v2.Bool {
  match child.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: atom_id } } =>
      match formal_production_rhs_singleton_terminal_identity(production: production) {
        v2.std.optional.Present { value: terminal_id } => atom_id == terminal_id
        v2.std.optional.Absent =>
          match formal_production_rhs_singleton_binding(production: production) {
            v2.std.optional.Present { value: binding } =>
              match formal_binding_conj_slot_arm(binding: binding) {
                FormalBindingConjSlotEmittedAtom => true
                FormalBindingConjSlotExactBinding => atom_id == binding
              }
            v2.std.optional.Absent => false
          }
      }
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      formal_production_rhs_matches_emitted_conj(
        production: production,
        productions: productions,
        emitted: child
      )
    _ => false
  }
}

fn emitted_shape_supported_for_lhs_exact(child: v2.std.node.Node) -> v2.Bool {
  match child.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } => true
    v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: _ } } => true
    _ => false
  }
}

fn formal_production_for_lhs_exact(
  productions: v2.std.collection.List<FormalProduction>,
  lhs: v2.std.node.Symbol,
  child: v2.std.node.Node
) -> v2.std.witness.Witness<FormalProduction> {
  if emitted_shape_supported_for_lhs_exact(child: child) {
    formal_production_for_lhs_exact_supported(
      productions: productions,
      lhs: lhs,
      child: child
    )
  } else {
    v2.std.witness.Violates {
      diagnostic: v2.std.diagnostic.Diagnostic {
        reason: ^grammar_relation_emitted_not_conj,
        at: v2.std.diagnostic.node_locus(node: child),
        correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
      }
    }
  }
}

fn formal_production_for_lhs_exact_supported(
  productions: v2.std.collection.List<FormalProduction>,
  lhs: v2.std.node.Symbol,
  child: v2.std.node.Node
) -> v2.std.witness.Witness<FormalProduction> {
  formal_production_unique_lhs_exact_match(
    productions: productions,
    lhs: lhs,
    child: child
  )
}

type DeriveGrammarRelationTokensProgress {
  edges: v2.std.collection.List<v2.std.node.Edge>
  conj_index: Int
  conj_children: v2.std.collection.List<v2.std.node.Node>
}

fn emitted_node_slot_count(emitted: v2.std.node.Node) -> Int {
  match emitted.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      conj_positional_child_count(children: conj_positional_children(parent: emitted))
    v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: _ } } => 0
    _ => 0 - 1
  }
}

fn derive_grammar_relation_token_edges_recursive_step(
  progress: v2.std.witness.Witness<DeriveGrammarRelationTokensProgress>,
  productions: v2.std.collection.List<FormalProduction>,
  emitted: v2.std.node.Node,
  symbol: FormalGrammarSymbol
) -> v2.std.witness.Witness<DeriveGrammarRelationTokensProgress> {
  match progress {
    v2.std.witness.Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
    v2.std.witness.Holds { value: DeriveGrammarRelationTokensProgress { edges: edges, conj_index: conj_index, conj_children: conj_children } } =>
      match symbol {
        FormalTerminalOccurrence { terminal: terminal, binding: binding } =>
          match binding {
            v2.std.optional.Present { value: binding_symbol } =>
              match formal_binding_conj_slot_arm(binding: binding_symbol) {
                FormalBindingConjSlotEmittedAtom =>
                  match formal_conj_child_atom_at_index(
                    children: conj_children,
                    index: conj_index,
                    emitted: emitted
                  ) {
                    v2.std.witness.Holds { value: slot_child } =>
                      match node_atom_identity_optional(node: slot_child) {
                        v2.std.optional.Present { value: atom_id } =>
                          v2.std.witness.Holds {
                            value: DeriveGrammarRelationTokensProgress {
                              edges: v2.std.algebra.list_snoc_item(
                                xs: edges,
                                item: grammar_terminal_occurrence_to_token_edge(
                                  terminal: terminal,
                                  binding: v2.std.optional.optional_present(value: atom_id)
                                )
                              ),
                              conj_index: conj_index + 1,
                              conj_children: conj_children
                            }
                          }
                        v2.std.optional.Absent =>
                          v2.std.witness.Violates {
                            diagnostic: grammar_relation_emitted_conj_slot_missing_diagnostic(
                              emitted: emitted
                            )
                          }
                      }
                    v2.std.witness.Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
                  }
                FormalBindingConjSlotExactBinding =>
                  v2.std.witness.Holds {
                    value: DeriveGrammarRelationTokensProgress {
                      edges: v2.std.algebra.list_snoc_item(
                        xs: edges,
                        item: grammar_terminal_occurrence_to_token_edge(
                          terminal: terminal,
                          binding: binding
                        )
                      ),
                      conj_index: conj_index + 1,
                      conj_children: conj_children
                    }
                  }
              }
            v2.std.optional.Absent =>
              v2.std.witness.Holds {
                value: DeriveGrammarRelationTokensProgress {
                  edges: v2.std.algebra.list_snoc_item(
                    xs: edges,
                    item: grammar_terminal_occurrence_to_token_edge(terminal: terminal, binding: binding)
                  ),
                  conj_index: conj_index,
                  conj_children: conj_children
                }
              }
          }
        FormalNonterminalOccurrence { nonterminal: nonterminal } =>
          match v2.std.collection.list_nth(
            xs: conj_children,
            wanted: conj_index,
            absent: v2.std.diagnostic.Diagnostic {
              reason: ^grammar_relation_emitted_conj_slot_missing,
              at: v2.std.diagnostic.node_locus(node: emitted),
              correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
            }
          ) {
            v2.std.witness.Holds { value: child } =>
              match formal_production_for_lhs_exact(
                productions: productions,
                lhs: nonterminal.identity,
                child: child
              ) {
                v2.std.witness.Holds { value: nested } =>
                  match derive_grammar_relation_token_edges_recursive(
                    production: nested,
                    productions: productions,
                    emitted: child
                  ) {
                    v2.std.witness.Holds { value: nested_edges } =>
                      v2.std.witness.Holds {
                        value: DeriveGrammarRelationTokensProgress {
                          edges: v2.std.algebra.list_append(left: edges, right: nested_edges),
                          conj_index: conj_index + 1,
                          conj_children: conj_children
                        }
                      }
                    v2.std.witness.Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
                  }
                v2.std.witness.Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
              }
            v2.std.witness.Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
          }
      }
  }
}

fn derive_grammar_relation_token_edges_recursive(
  production: FormalProduction,
  productions: v2.std.collection.List<FormalProduction>,
  emitted: v2.std.node.Node
) -> v2.std.witness.Witness<v2.std.collection.List<v2.std.node.Edge>> {
  let conj_children = conj_positional_children(parent: emitted)
  match v2.std.algebra.fold_list(
    xs: production.rhs,
    empty: v2.std.witness.Holds {
      value: DeriveGrammarRelationTokensProgress {
        edges: std.algebra.Empty,
        conj_index: 0,
        conj_children: conj_children
      }
    },
    cons: fn(progress, symbol) {
      derive_grammar_relation_token_edges_recursive_step(
        progress: progress,
        productions: productions,
        emitted: emitted,
        symbol: symbol
      )
    }
  ) {
    v2.std.witness.Holds { value: DeriveGrammarRelationTokensProgress { edges: result, conj_index: conj_index, conj_children: conj_children } } =>
      if conj_index == conj_positional_child_count(children: conj_children) {
        v2.std.witness.Holds { value: result }
      } else {
        v2.std.witness.Violates {
          diagnostic: v2.std.diagnostic.Diagnostic {
            reason: ^grammar_relation_emitted_conj_slot_surplus,
            at: v2.std.diagnostic.node_locus(node: emitted),
            correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
          }
        }
      }
    v2.std.witness.Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
  }
}

fn grammar_relation_token_edge_targets(edges: v2.std.collection.List<v2.std.node.Edge>) -> v2.std.collection.List<v2.std.node.Node> {
  fold(
    edges,
    init: std.algebra.Empty,
    f: fn(acc, e) {
      v2.std.algebra.list_snoc_item(xs: acc, item: e.target)
    }
  )
}

fn derive_grammar_relation_row_node(
  production: FormalProduction,
  productions: v2.std.collection.List<FormalProduction>,
  emitted: v2.std.node.Node
) -> v2.std.witness.Witness<v2.std.node.Node> {
  match emitted.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      match derive_grammar_relation_token_edges_recursive(
        production: production,
        productions: productions,
        emitted: emitted
      ) {
        v2.std.witness.Holds { value: token_edges } =>
          v2.std.witness.Holds {
            value: grammar_relation_row_to_node(
              row: derive_grammar_relation_row(production: production, emitted: emitted),
              tokens: grammar_relation_tokens_node(
                tokens: grammar_relation_token_edge_targets(edges: token_edges),
                token_to_node: fn(token_node) { token_node }
              )
            )
          }
        v2.std.witness.Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
      }
    _ =>
      v2.std.witness.Violates {
        diagnostic: v2.std.diagnostic.Diagnostic {
          reason: ^grammar_relation_emitted_not_conj,
          at: v2.std.diagnostic.node_locus(node: emitted),
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
        }
      }
  }
}

fn grammar_expr_node(children: v2.std.collection.List<v2.std.node.Edge>) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode {
      connective: v2.std.node.Conj
    },
    children: children,
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn grammar_expr_to_node(expr: GrammarExpr) -> v2.std.node.Node {
  fold_grammar_expr(
    expr: expr,
    algebra: GrammarExprFold {
      terminal: fn(token_class, stamp) {
        match stamp {
          StampBinding { binding: b } =>
            grammar_expr_node(children: [
              grammar_named_edge(name: ^grammar_terminal_token_class_node_projection, target: grammar_atom(identity: token_class)),
              grammar_named_edge(name: ^grammar_terminal_binding_node_projection, target: grammar_atom(identity: b))
            ])
          StampClass =>
            grammar_expr_node(children: [
              grammar_named_edge(name: ^grammar_terminal_token_class_node_projection, target: grammar_atom(identity: token_class))
            ])
          StampLexeme =>
            grammar_expr_node(children: [
              grammar_named_edge(name: ^grammar_terminal_token_class_node_projection, target: grammar_atom(identity: token_class)),
              grammar_named_edge(name: ^grammar_terminal_stamp_lexeme_node_projection, target: grammar_atom(identity: ^grammar_terminal_stamp_lexeme))
            ])
        }
      },
      nonterminal: fn(production) {
        grammar_expr_node(children: [
          grammar_named_edge(name: ^grammar_nonterminal_production_node_projection, target: grammar_atom(identity: production))
        ])
      },
      sequence: fn(left_node, right_node) {
        grammar_expr_node(children: [
          grammar_named_edge(name: ^grammar_sequence_left_node_projection, target: left_node),
          grammar_named_edge(name: ^grammar_sequence_right_node_projection, target: right_node)
        ])
      },
      choice: fn(left_node, right_node) {
        grammar_expr_node(children: [
          grammar_named_edge(name: ^grammar_choice_left_node_projection, target: left_node),
          grammar_named_edge(name: ^grammar_choice_right_node_projection, target: right_node)
        ])
      },
      optional: fn(element_node) {
        grammar_expr_node(children: [
          grammar_named_edge(name: ^grammar_optional_element_node_projection, target: element_node)
        ])
      },
      repeat: fn(element_node) {
        grammar_expr_node(children: [
          grammar_named_edge(name: ^grammar_repeat_element_node_projection, target: element_node)
        ])
      }
    }
  )
}

fn grammar_production_to_node(production: GrammarProduction) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode {
      connective: v2.std.node.Conj
    },
    children: [
      grammar_named_edge(name: ^grammar_production_name_node_projection, target: grammar_atom(identity: production.name)),
      grammar_named_edge(name: ^grammar_production_expression_node_projection, target: grammar_expr_to_node(expr: production.expression)),
      grammar_named_edge(name: ^grammar_production_emitted_node_projection, target: production.emitted)
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn grammar_production_to_list_step(acc: v2.std.collection.List<v2.std.node.Edge>, production: GrammarProduction) -> v2.std.collection.List<v2.std.node.Edge> {
  v2.std.algebra.list_snoc_item(
    xs: acc,
    item: grammar_named_edge(
      name: production.name,
      target: grammar_production_to_node(production: production)
    )
  )
}

fn grammar_productions_to_node(productions: v2.std.collection.List<GrammarProduction>) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode {
      connective: v2.std.node.Conj
    },
    children: v2.std.algebra.fold_list(
      xs: productions,
      empty: std.algebra.Empty,
      cons: fn(acc, production) {
        grammar_production_to_list_step(acc: acc, production: production)
      }
    ),
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn grammar_root_to_node(root: GrammarRoot) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode {
      connective: v2.std.node.Conj
    },
    children: [
      grammar_named_edge(name: ^grammar_root_start_production_node_projection, target: grammar_atom(identity: root.start)),
      grammar_named_edge(name: ^grammar_root_productions_node_projection, target: grammar_productions_to_node(productions: root.productions))
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn grammar_to_node(grammar: ParseGrammar) -> v2.std.node.Node {
  match grammar {
    VoidGrammar => grammar_empty_node()
    ModeledGrammar { root: root } => grammar_root_to_node(root: root)
  }
}

fn grammar_symbol_fold(sym: v2.std.node.Symbol) -> v2.std.node.NodeFold<GrammarSymbolFoldState> {
  v2.std.node.NodeFold {
    init: fn(n0) {
      grammar_symbol_fold_init(n: n0, sym: sym)
    },
    step: grammar_symbol_fold_step
  }
}

fn grammar_symbol_fold_init(n: v2.std.node.Node, sym: v2.std.node.Symbol) -> GrammarSymbolFoldState {
  match n.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } } =>
      GrammarSymbolFoldState { found: id == sym }
    _ =>
      GrammarSymbolFoldState { found: false }
  }
}

fn grammar_symbol_fold_step(
  acc: GrammarSymbolFoldState,
  edge: v2.std.node.Edge,
  child_has_symbol: GrammarSymbolFoldState
) -> GrammarSymbolFoldState {
  GrammarSymbolFoldState { found: acc.found || child_has_symbol.found }
}

fn grammar_symbol_fold_state(n: v2.std.node.Node, sym: v2.std.node.Symbol) -> GrammarSymbolFoldState {
  v2.std.node.fold_node(n: n, algebra: grammar_symbol_fold(sym: sym))
}

fn grammar_carries_symbol(grammar: ParseGrammar, sym: v2.std.node.Symbol) -> v2.Bool {
  grammar_symbol_fold_state(n: grammar_to_node(grammar: grammar), sym: sym).found
}

type GrammarInterpretationDirection
  = GrammarInterpretBackward
  | GrammarInterpretForward

type BidirectionalGrammarObligation
  = ObligationSlotBijection
  | ObligationForwardDeterminism
  | ObligationBackwardDeterminism
  | ObligationQuotientDeclaration

fn grammar_production_selection_predicate(direction: GrammarInterpretationDirection) -> v2.std.node.Symbol {
  match direction {
    GrammarInterpretBackward => ^grammar_selection_predicate_backward_lhs_shape
    GrammarInterpretForward => ^grammar_selection_predicate_forward_rhs_frontier
  }
}

type LhsExactProductionMatchFold
  = LhsExactProductionMatchNone
  | LhsExactProductionMatchOne { production: FormalProduction }
  | LhsExactProductionMatchMany

fn formal_production_matches_lhs_exact_child(
  productions: v2.std.collection.List<FormalProduction>,
  lhs: v2.std.node.Symbol,
  child: v2.std.node.Node,
  candidate: FormalProduction
) -> v2.Bool {
  if emitted_shape_supported_for_lhs_exact(child: child) {
    let emitted_slot_count = emitted_node_slot_count(emitted: child)
    formal_production_matches_lhs_and_slot_count(
      production: candidate,
      lhs: lhs,
      emitted_slot_count: emitted_slot_count
    ) &&
      formal_production_matches_emitted_child(
        production: candidate,
        productions: productions,
        child: child
      )
  } else {
    false
  }
}

fn lhs_exact_production_match_fold_step(
  acc: LhsExactProductionMatchFold,
  productions: v2.std.collection.List<FormalProduction>,
  lhs: v2.std.node.Symbol,
  child: v2.std.node.Node,
  candidate: FormalProduction
) -> LhsExactProductionMatchFold {
  if formal_production_matches_lhs_exact_child(
    productions: productions,
    lhs: lhs,
    child: child,
    candidate: candidate
  ) {
    match acc {
      LhsExactProductionMatchNone =>
        LhsExactProductionMatchOne { production: candidate }
      LhsExactProductionMatchOne { production: _ } => LhsExactProductionMatchMany
      LhsExactProductionMatchMany => LhsExactProductionMatchMany
    }
  } else {
    acc
  }
}

fn emitted_production_match_fold_step(
  acc: LhsExactProductionMatchFold,
  productions: v2.std.collection.List<FormalProduction>,
  child: v2.std.node.Node,
  candidate: FormalProduction
) -> LhsExactProductionMatchFold {
  if formal_production_matches_emitted_child(
    production: candidate,
    productions: productions,
    child: child
  ) {
    match acc {
      LhsExactProductionMatchNone =>
        LhsExactProductionMatchOne { production: candidate }
      LhsExactProductionMatchOne { production: _ } => LhsExactProductionMatchMany
      LhsExactProductionMatchMany => LhsExactProductionMatchMany
    }
  } else {
    acc
  }
}

fn formal_production_unique_emitted_match(
  productions: v2.std.collection.List<FormalProduction>,
  child: v2.std.node.Node
) -> v2.std.witness.Witness<FormalProduction> {
  if emitted_shape_supported_for_lhs_exact(child: child) {
    match v2.std.algebra.fold_list(
      xs: productions,
      empty: LhsExactProductionMatchNone,
      cons: fn(acc, candidate) {
        emitted_production_match_fold_step(
          acc: acc,
          productions: productions,
          child: child,
          candidate: candidate
        )
      }
    ) {
      LhsExactProductionMatchNone =>
        v2.std.witness.Violates {
          diagnostic: v2.std.diagnostic.Diagnostic {
            reason: ^grammar_relation_production_not_found,
            at: v2.std.diagnostic.node_locus(node: child),
            correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
          }
        }
      LhsExactProductionMatchMany =>
        v2.std.witness.Violates {
          diagnostic: v2.std.diagnostic.Diagnostic {
            reason: ^grammar_relation_row_backward_selection_ambiguous,
            at: v2.std.diagnostic.node_locus(node: child),
            correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
          }
        }
      LhsExactProductionMatchOne { production: production } =>
        v2.std.witness.Holds { value: production }
    }
  } else {
    v2.std.witness.Violates {
      diagnostic: v2.std.diagnostic.Diagnostic {
        reason: ^grammar_relation_emitted_not_conj,
        at: v2.std.diagnostic.node_locus(node: child),
        correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
      }
    }
  }
}

type RebuildRhsWalkState
  = RebuildRhsWalkOk { children: v2.std.collection.List<v2.std.node.Node>, token_index: Int }
  | RebuildRhsWalkFail

type RebuildEmittedResult
  = RebuildEmittedOk { emitted: v2.std.node.Node, token_index: Int }
  | RebuildEmittedFail

type RebuildProductionMatchFold
  = RebuildProductionMatchNone
  | RebuildProductionMatchOne { emitted: v2.std.node.Node, token_index: Int }
  | RebuildProductionMatchMany

fn rebuild_emitted_atom_node(identity: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: identity } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn rebuild_emitted_conj_node(children: v2.std.collection.List<v2.std.node.Node>) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: v2.std.algebra.fold_list(
      xs: children,
      empty: std.algebra.Empty,
      cons: fn(acc, child) {
        v2.std.algebra.list_snoc_item(
          xs: acc,
          item: v2.std.node.Edge { label: v2.std.node.Positional, target: child }
        )
      }
    ),
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn concrete_syntax_fixed_token_matches_terminal(
  token: v2.std.compilers.target_model.ConcreteSyntaxToken,
  terminal: v2.std.node.Symbol
) -> v2.Bool {
  match token {
    v2.std.compilers.target_model.FixedToken { token_class: token_class } => token_class == terminal
    v2.std.compilers.target_model.BoundToken { token_class: _, binding: _ } => false
  }
}

fn rebuild_emitted_rhs_walk_step(
  state: RebuildRhsWalkState,
  productions: v2.std.collection.List<FormalProduction>,
  tokens: v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>,
  symbol: FormalGrammarSymbol
) -> RebuildRhsWalkState {
  match state {
    RebuildRhsWalkFail => state
    RebuildRhsWalkOk { children: children, token_index: token_index } =>
      match symbol {
        FormalTerminalOccurrence { terminal: terminal, binding: binding } =>
          match binding {
            v2.std.optional.Absent =>
              match v2.std.collection.list_nth(
                xs: tokens,
                wanted: token_index,
                absent: v2.std.diagnostic.Diagnostic {
                  reason: ^grammar_relation_emitted_conj_slot_missing,
                  at: v2.std.diagnostic.node_locus(node: rebuild_emitted_conj_node(children: children)),
                  correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
                }
              ) {
                v2.std.witness.Holds { value: token } =>
                  if concrete_syntax_fixed_token_matches_terminal(
                    token: token,
                    terminal: terminal.identity
                  ) {
                    RebuildRhsWalkOk { children: children, token_index: token_index + 1 }
                  } else {
                    RebuildRhsWalkFail
                  }
                v2.std.witness.Violates { diagnostic: _ } => RebuildRhsWalkFail
              }
            v2.std.optional.Present { value: binding_symbol } =>
              match v2.std.collection.list_nth(
                xs: tokens,
                wanted: token_index,
                absent: v2.std.diagnostic.Diagnostic {
                  reason: ^grammar_relation_emitted_conj_slot_missing,
                  at: v2.std.diagnostic.node_locus(node: rebuild_emitted_conj_node(children: children)),
                  correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
                }
              ) {
                v2.std.witness.Holds { value: token } =>
                  match token {
                    v2.std.compilers.target_model.BoundToken { token_class: token_class, binding: binding } =>
                      if token_class == terminal.identity &&
                        (
                          formal_binding_is_emitted_atom_from_slot(binding: binding_symbol) ||
                            binding_symbol == binding
                        ) {
                        RebuildRhsWalkOk {
                          children: v2.std.algebra.list_snoc_item(
                            xs: children,
                            item: rebuild_emitted_atom_node(identity: binding)
                          ),
                          token_index: token_index + 1
                        }
                      } else {
                        RebuildRhsWalkFail
                      }
                    v2.std.compilers.target_model.FixedToken { token_class: _ } => RebuildRhsWalkFail
                  }
                v2.std.witness.Violates { diagnostic: _ } => RebuildRhsWalkFail
              }
          }
        FormalNonterminalOccurrence { nonterminal: nonterminal } =>
          match grammar_relation_emitted_rebuild_for_lhs(
            productions: productions,
            lhs: nonterminal.identity,
            tokens: tokens,
            token_index: token_index
          ) {
            v2.std.witness.Holds { value: RebuildEmittedOk { emitted: child, token_index: next_index } } =>
              RebuildRhsWalkOk {
                children: v2.std.algebra.list_snoc_item(xs: children, item: child),
                token_index: next_index
              }
            v2.std.witness.Violates { diagnostic: _ } => RebuildRhsWalkFail
          }
      }
  }
}

fn rebuild_emitted_from_production(
  production: FormalProduction,
  productions: v2.std.collection.List<FormalProduction>,
  tokens: v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>,
  token_index: Int
) -> v2.std.witness.Witness<RebuildEmittedResult> {
  match v2.std.algebra.fold_list(
    xs: production.rhs,
    empty: RebuildRhsWalkOk { children: std.algebra.Empty, token_index: token_index },
    cons: fn(state, symbol) {
      rebuild_emitted_rhs_walk_step(
        state: state,
        productions: productions,
        tokens: tokens,
        symbol: symbol
      )
    }
  ) {
    RebuildRhsWalkOk { children: children, token_index: end_index } =>
      v2.std.witness.Holds {
        value: RebuildEmittedOk {
          emitted: rebuild_emitted_conj_node(children: children),
          token_index: end_index
        }
      }
    RebuildRhsWalkFail =>
      v2.std.witness.Violates {
        diagnostic: v2.std.diagnostic.Diagnostic {
          reason: ^grammar_relation_production_not_found,
          at: v2.std.diagnostic.node_locus(node: rebuild_emitted_conj_node(children: std.algebra.Empty)),
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
        }
      }
  }
}

fn rebuild_production_match_fold_step(
  acc: RebuildProductionMatchFold,
  productions: v2.std.collection.List<FormalProduction>,
  tokens: v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>,
  token_index: Int,
  candidate: FormalProduction
) -> RebuildProductionMatchFold {
  match rebuild_emitted_from_production(
    production: candidate,
    productions: productions,
    tokens: tokens,
    token_index: token_index
  ) {
    v2.std.witness.Holds { value: RebuildEmittedOk { emitted: emitted, token_index: end_index } } =>
      match acc {
        RebuildProductionMatchNone =>
          RebuildProductionMatchOne { emitted: emitted, token_index: end_index }
        RebuildProductionMatchOne { emitted: _, token_index: _ } => RebuildProductionMatchMany
        RebuildProductionMatchMany => RebuildProductionMatchMany
      }
    v2.std.witness.Violates { diagnostic: _ } => acc
  }
}

fn grammar_relation_emitted_rebuild_for_lhs(
  productions: v2.std.collection.List<FormalProduction>,
  lhs: v2.std.node.Symbol,
  tokens: v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>,
  token_index: Int
) -> v2.std.witness.Witness<RebuildEmittedResult> {
  let lhs_productions = formal_productions_for_lhs(productions: productions, lhs: lhs)
  match v2.std.algebra.fold_list(
    xs: lhs_productions,
    empty: RebuildProductionMatchNone,
    cons: fn(acc, candidate) {
      rebuild_production_match_fold_step(
        acc: acc,
        productions: productions,
        tokens: tokens,
        token_index: token_index,
        candidate: candidate
      )
    }
  ) {
    RebuildProductionMatchNone =>
      v2.std.witness.Violates {
        diagnostic: v2.std.diagnostic.Diagnostic {
          reason: ^grammar_relation_production_not_found,
          at: v2.std.diagnostic.node_locus(node: rebuild_emitted_conj_node(children: std.algebra.Empty)),
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
        }
      }
    RebuildProductionMatchMany =>
      v2.std.witness.Violates {
        diagnostic: v2.std.diagnostic.Diagnostic {
          reason: ^grammar_relation_row_backward_selection_ambiguous,
          at: v2.std.diagnostic.node_locus(node: rebuild_emitted_conj_node(children: std.algebra.Empty)),
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
        }
      }
    RebuildProductionMatchOne { emitted: emitted, token_index: end_index } =>
      v2.std.witness.Holds {
        value: RebuildEmittedOk {
          emitted: emitted,
          token_index: end_index
        }
      }
  }
}

fn grammar_relation_emitted_rebuild_from_token_spine(
  productions: v2.std.collection.List<FormalProduction>,
  lhs: v2.std.node.Symbol,
  tokens: v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>
) -> v2.std.witness.Witness<v2.std.node.Node> {
  let token_count = v2.std.algebra.fold_list(
    xs: tokens,
    empty: 0,
    cons: fn(acc, _) { acc + 1 }
  )
  match grammar_relation_emitted_rebuild_for_lhs(
    productions: productions,
    lhs: lhs,
    tokens: tokens,
    token_index: 0
  ) {
    v2.std.witness.Holds { value: RebuildEmittedOk { emitted: emitted, token_index: end_index } } =>
      if end_index == token_count {
        v2.std.witness.Holds { value: emitted }
      } else {
        v2.std.witness.Violates {
          diagnostic: v2.std.diagnostic.Diagnostic {
            reason: ^grammar_relation_emitted_conj_slot_surplus,
            at: v2.std.diagnostic.node_locus(node: emitted),
            correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
          }
        }
      }
    v2.std.witness.Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
  }
}

fn grammar_relation_row_derived_from_productions(
  productions: v2.std.collection.List<FormalProduction>,
  emitted: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match formal_production_unique_emitted_match(productions: productions, child: emitted) {
    v2.std.witness.Holds { value: production } =>
      match derive_grammar_relation_row_node(
        production: production,
        productions: productions,
        emitted: emitted
      ) {
        v2.std.witness.Holds { value: row } => v2.std.diagnostic.outcome_accepted(value: row)
        v2.std.witness.Violates { diagnostic: d } => v2.std.diagnostic.outcome_rejected(d)
      }
    v2.std.witness.Violates { diagnostic: d } => v2.std.diagnostic.outcome_rejected(d)
  }
}

fn formal_production_unique_lhs_exact_match(
  productions: v2.std.collection.List<FormalProduction>,
  lhs: v2.std.node.Symbol,
  child: v2.std.node.Node
) -> v2.std.witness.Witness<FormalProduction> {
  if emitted_shape_supported_for_lhs_exact(child: child) {
    let lhs_productions = formal_productions_for_lhs(productions: productions, lhs: lhs)
    match v2.std.algebra.fold_list(
      xs: lhs_productions,
      empty: LhsExactProductionMatchNone,
      cons: fn(acc, candidate) {
        lhs_exact_production_match_fold_step(
          acc: acc,
          productions: productions,
          lhs: lhs,
          child: child,
          candidate: candidate
        )
      }
    ) {
      LhsExactProductionMatchNone =>
        v2.std.witness.Violates {
          diagnostic: v2.std.diagnostic.Diagnostic {
            reason: ^grammar_relation_production_not_found,
            at: v2.std.diagnostic.node_locus(node: child),
            correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
          }
        }
      LhsExactProductionMatchMany =>
        v2.std.witness.Violates {
          diagnostic: v2.std.diagnostic.Diagnostic {
            reason: ^grammar_relation_row_backward_selection_ambiguous,
            at: v2.std.diagnostic.node_locus(node: child),
            correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
          }
        }
      LhsExactProductionMatchOne { production: production } =>
        v2.std.witness.Holds { value: production }
    }
  } else {
    v2.std.witness.Violates {
      diagnostic: v2.std.diagnostic.Diagnostic {
        reason: ^grammar_relation_emitted_not_conj,
        at: v2.std.diagnostic.node_locus(node: child),
        correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
      }
    }
  }
}

fn grammar_relation_row_backward_selection(
  row: GrammarRelationRow,
  productions: v2.std.collection.List<FormalProduction>
) -> v2.std.witness.Witness<FormalProduction> {
  match formal_production_unique_lhs_exact_match(
    productions: productions,
    lhs: row.production.lhs.identity,
    child: row.emitted
  ) {
    v2.std.witness.Holds { value: selected } =>
      if selected == row.production {
        v2.std.witness.Holds { value: selected }
      } else {
        v2.std.witness.Violates {
          diagnostic: v2.std.diagnostic.Diagnostic {
            reason: ^grammar_relation_row_backward_selection_mismatch,
            at: v2.std.diagnostic.node_locus(node: row.emitted),
            correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
          }
        }
      }
    v2.std.witness.Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
  }
}

fn grammar_relation_row_emitted_reverse_parse_matches(
  row: v2.std.node.Node,
  productions: v2.std.collection.List<FormalProduction>,
  emitted: v2.std.node.Node
) -> v2.Bool {
  if emitted_shape_supported_for_lhs_exact(child: emitted) {
    match grammar_relation_row_production_from_node(row: row) {
      v2.std.witness.Holds { value: production } =>
        formal_production_matches_lhs_exact_child(
          productions: productions,
          lhs: production.lhs.identity,
          child: emitted,
          candidate: production
        )
      v2.std.witness.Violates { diagnostic: _ } => false
    }
  } else {
    match grammar_relation_row_emitted_fixture(row: row) {
      v2.std.diagnostic.Accepted { value: row_emitted, diagnostics: _ } => row_emitted == emitted
      v2.std.diagnostic.Rejected { diagnostics: _ } => false
    }
  }
}

type BackwardRowSelection
  = BackwardRowNone
  | BackwardRowOne { row: v2.std.node.Node }
  | BackwardRowMany

fn backward_row_select_step(
  acc: BackwardRowSelection,
  productions: v2.std.collection.List<FormalProduction>,
  emitted: v2.std.node.Node,
  row: v2.std.node.Node
) -> BackwardRowSelection {
  if grammar_relation_row_emitted_reverse_parse_matches(
    row: row,
    productions: productions,
    emitted: emitted
  ) {
    match acc {
      BackwardRowNone => BackwardRowOne { row: row }
      BackwardRowOne { row: _ } => BackwardRowMany
      BackwardRowMany => BackwardRowMany
    }
  } else {
    acc
  }
}

fn grammar_relation_row_reverse_parse_selection_not_found_diagnostic(emitted: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^grammar_relation_production_not_found,
    at: v2.std.diagnostic.node_locus(node: emitted),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn grammar_relation_row_reverse_parse_selection(rules: v2.std.node.Node, emitted: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: grammar_relation_rules_formal_productions(rules: rules),
    f: fn(productions) {
      match rules.kind {
        v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
          match fold(
            rules.children,
            init: BackwardRowNone,
            f: fn(acc, edge) {
              match edge.label {
                v2.std.node.Named { name: n } =>
                  if n == ^grammar_relation_rules_formal_productions {
                    acc
                  } else {
                    backward_row_select_step(
                      acc: acc,
                      productions: productions,
                      emitted: emitted,
                      row: edge.target
                    )
                  }
                v2.std.node.Positional => acc
              }
            }
          ) {
            BackwardRowOne { row: row } => v2.std.diagnostic.outcome_accepted(value: row)
            BackwardRowMany =>
              v2.std.diagnostic.outcome_rejected(
                v2.std.diagnostic.Diagnostic {
                  reason: ^grammar_relation_row_backward_selection_ambiguous,
                  at: v2.std.diagnostic.node_locus(node: emitted),
                  correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
                }
              )
            BackwardRowNone =>
              grammar_relation_row_derived_from_productions(
                productions: productions,
                emitted: emitted
              )
          }
        _ =>
          v2.std.diagnostic.outcome_rejected(
            grammar_relation_row_reverse_parse_selection_not_found_diagnostic(emitted: emitted)
          )
      }
    }
  )
}

type GrammarRelationForwardRowSelection
  = GrammarRelationForwardRowNone
  | GrammarRelationForwardRowOne { row: v2.std.node.Node }
  | GrammarRelationForwardRowMany

fn grammar_relation_forward_row_select_merge(
  acc: GrammarRelationForwardRowSelection,
  row: v2.std.node.Node,
  matches: v2.Bool
) -> GrammarRelationForwardRowSelection {
  if matches {
    match acc {
      GrammarRelationForwardRowNone => GrammarRelationForwardRowOne { row: row }
      GrammarRelationForwardRowOne { row: _ } => GrammarRelationForwardRowMany
      GrammarRelationForwardRowMany => GrammarRelationForwardRowMany
    }
  } else {
    acc
  }
}

fn grammar_relation_forward_row_select_skip_catalog_edge(name: v2.std.node.Symbol) -> v2.Bool {
  name == ^grammar_relation_rules_formal_productions
}

fn grammar_relation_row_forward_select(
  rules: v2.std.node.Node,
  row_matches: fn(v2.std.node.Node) -> v2.Bool
) -> GrammarRelationForwardRowSelection {
  match rules.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      fold(
        rules.children,
        init: GrammarRelationForwardRowNone,
        f: fn(acc, e) {
          match e.label {
            v2.std.node.Named { name: n } =>
              if grammar_relation_forward_row_select_skip_catalog_edge(name: n) {
                acc
              } else {
                grammar_relation_forward_row_select_merge(
                  acc: acc,
                  row: e.target,
                  matches: row_matches(e.target)
                )
              }
            v2.std.node.Positional => acc
          }
        }
      )
    _ => GrammarRelationForwardRowNone
  }
}

fn grammar_relation_forward_row_selection_outcome_row(
  rules: v2.std.node.Node,
  selection: GrammarRelationForwardRowSelection,
  none_reason: v2.std.node.Symbol,
  many_reason: v2.std.node.Symbol
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match selection {
    GrammarRelationForwardRowOne { row: row } => v2.std.diagnostic.outcome_accepted(value: row)
    GrammarRelationForwardRowMany =>
      v2.std.diagnostic.outcome_rejected(
        v2.std.diagnostic.Diagnostic {
          reason: many_reason,
          at: v2.std.diagnostic.node_locus(node: rules),
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
        }
      )
    GrammarRelationForwardRowNone =>
      v2.std.diagnostic.outcome_rejected(
        v2.std.diagnostic.Diagnostic {
          reason: none_reason,
          at: v2.std.diagnostic.node_locus(node: rules),
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
        }
      )
  }
}

fn grammar_relation_forward_row_selection_outcome_emitted(
  rules: v2.std.node.Node,
  selection: GrammarRelationForwardRowSelection
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match selection {
    GrammarRelationForwardRowOne { row: row } =>
      v2.std.node_query.find_named_child(root: row, name: ^grammar_relation_field_emitted)
    GrammarRelationForwardRowMany =>
      v2.std.diagnostic.outcome_rejected(
        v2.std.diagnostic.Diagnostic {
          reason: ^parse_tree_to_emitted_node_ambiguous_row,
          at: v2.std.diagnostic.node_locus(node: rules),
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
        }
      )
    GrammarRelationForwardRowNone =>
      v2.std.diagnostic.outcome_rejected(
        v2.std.diagnostic.Diagnostic {
          reason: ^parse_tree_to_emitted_node_no_matching_row,
          at: v2.std.diagnostic.node_locus(node: rules),
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
        }
      )
  }
}

fn grammar_relation_row_token_spine_classes(row: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.node.Symbol>> {
  v2.std.diagnostic.bind_outcome(
    o: v2.std.node_query.find_named_child(root: row, name: ^grammar_relation_field_tokens),
    f: fn(tokens_root) {
      v2.std.diagnostic.bind_outcome(
        o: v2.std.compilers.target_model.concrete_syntax_token_list_from_node(list_node: tokens_root),
        f: fn(tokens) {
          let classes = fold(
            tokens,
            init: std.algebra.Empty,
            f: fn(acc, t) {
              v2.std.algebra.list_append(left: acc, right: [v2.std.compilers.target_model.concrete_syntax_token_class(token: t)])
            }
          )
          v2.std.diagnostic.outcome_accepted(value: classes)
        }
      )
    }
  )
}

fn grammar_relation_row_forward_token_spine_selection(
  frontier: v2.std.collection.List<v2.std.node.Symbol>,
  rules: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match rules.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      grammar_relation_forward_row_selection_outcome_emitted(
        rules: rules,
        selection: grammar_relation_row_forward_select(
          rules: rules,
          row_matches: fn(row) {
            match grammar_relation_row_token_spine_classes(row: row) {
              v2.std.diagnostic.Rejected { diagnostics: _ } => false
              v2.std.diagnostic.Accepted { value: spine, diagnostics: _ } =>
                v2.std.algebra.zip_eq(a: frontier, b: spine, eq: fn(x, y) { x == y })
            }
          }
        )
      )
    _ =>
      v2.std.diagnostic.outcome_rejected(
        v2.std.diagnostic.Diagnostic {
          reason: ^parse_tree_to_emitted_node_no_matching_row,
          at: v2.std.diagnostic.node_locus(node: rules),
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
        }
      )
  }
}

fn grammar_node_carries_surface_identity(node: v2.std.node.Node, surface_identity: v2.std.node.Symbol) -> v2.Bool {
  match node.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } } => id == surface_identity
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      fold(node.children, init: false, f: fn(acc, e) {
        if acc {
          acc
        } else {
          match e.label {
            v2.std.node.Named { name: n } =>
              (n == surface_identity)
                || grammar_node_carries_surface_identity(
                  node: e.target,
                  surface_identity: surface_identity
                )
            v2.std.node.Positional =>
              grammar_node_carries_surface_identity(
                node: e.target,
                surface_identity: surface_identity
              )
          }
        }
      })
    _ => false
  }
}

fn grammar_relation_row_surface_identity_matches(row: v2.std.node.Node, surface_identity: v2.std.node.Symbol) -> v2.Bool {
  match grammar_relation_row_emitted_fixture(row: row) {
    v2.std.diagnostic.Accepted { value: emitted, diagnostics: _ } =>
      grammar_node_carries_surface_identity(node: emitted, surface_identity: surface_identity)
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn grammar_relation_row_forward_production_selection_not_found_diagnostic(
  surface_identity: v2.std.node.Symbol
) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^grammar_relation_row_forward_production_not_found,
    at: v2.std.diagnostic.node_locus(
      node: v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: surface_identity } },
        children: [],
        occurrence_id: v2.std.node.SyntheticOccurrence
      }
    ),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn grammar_relation_row_forward_production_selection(
  rules: v2.std.node.Node,
  surface_identity: v2.std.node.Symbol
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match rules.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      grammar_relation_forward_row_selection_outcome_row(
        rules: rules,
        selection: grammar_relation_row_forward_select(
          rules: rules,
          row_matches: fn(row) {
            grammar_relation_row_surface_identity_matches(
              row: row,
              surface_identity: surface_identity
            )
          }
        ),
        none_reason: ^grammar_relation_row_forward_production_not_found,
        many_reason: ^grammar_relation_row_forward_production_ambiguous
      )
    _ =>
      v2.std.diagnostic.outcome_rejected(
        grammar_relation_row_forward_production_selection_not_found_diagnostic(
          surface_identity: surface_identity
        )
      )
  }
}
