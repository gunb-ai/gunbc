module v2.std.witness_evaluation

import std.types { Bool, List }
import std.effect_grant { Envelope }
import extdeps.transports.rest { RestExchangeFixture }
import v2.std.diagnostic { Diagnostic }

data witness_evaluation_frame_note: String = "A witness evaluation is an ordinary scoped evaluation whose effects are supplied by an existing Envelope. Envelope already owns its Frame, so this carrier does not duplicate a separately writable frame field. The REST fixtures are temporary realization inputs selected through the envelope's HandlerBinding; they are not global interpreter state and must disappear when subject evaluation returns or refuses. This frame is deliberately not REST-specific in its result or control semantics: later deterministic environment and filesystem replay bindings extend the same carrier rather than minting another catch primitive."

type WitnessEvaluationFrame {
  envelope: Envelope
  rest_fixtures: List<RestExchangeFixture>
}

type WitnessEvaluation<A>
  = WitnessReturned { value: A }
  | WitnessRefused { diagnostic: Diagnostic }

data evaluate_in_witness_frame_seed_note: String = "The v1 interpreter realizes this generic boundary by installing the frame for the dynamic extent of subject(), returning its value or converting the interpreter refusal to a located Diagnostic, and removing the frame on both paths. The authored body is the pure success projection for emitted targets until their effect-handler/evaluation-frame realization lands. There are no test cases or REST judgments in the Rust realization; all fixture facts and assertions remain authored .dag values."

fn evaluate_in_witness_frame<A>(
  frame: WitnessEvaluationFrame,
  subject: fn(Bool) -> A,
) -> WitnessEvaluation<A> {
  WitnessReturned { value: subject(true) }
}

data witness_evaluation_frame_active_note: String = "An executing-scope observation proves that a temporary frame was removed. The pure/default answer is false; the interpreter realization returns true only while evaluate_in_witness_frame is applying its subject."

fn witness_evaluation_frame_active() -> Bool {
  false
}

data witness_diagnostic_rendered_reason_note: String = "Diagnostic.reason remains a Symbol in the shared diagnostic authority. This generic projection lets a witness compare an interpreter's full rendered refusal without weakening that authority to an arbitrary String carrier."

fn witness_diagnostic_rendered_reason(diagnostic: Diagnostic) -> String {
  ""
}
