module v2.std.layer

import v2.std.qualified_name { QualifiedName, qualified_name_from_dotted_string }
import std.algebra { Cons, Empty }
import v2.std.algebra { HeadAbsent, HeadFound, list_head }
import v2.std.text { String }

type LayerPrefix
  = LayerPrefixStd
  | LayerPrefixExtdeps
  | LayerPrefixCompiler
  | LayerPrefixWorkflow

// LayerPrefix classifies a module's browsing home (std / extdeps / compiler / workflow) — a folder
// convention, NOT an import law. The former strict layer DAG (std ← extdeps ← compiler ← workflow,
// imports point toward std) and its direction lens v2.lens.layering_imports were deleted by
// operator ruling 2026-07-24: the only structural law on the import graph is acyclicity, and a
// folder-prefix direction rule was convention standing where no necessity stood — it blocked
// correct grounding (a std surface citing the extdeps rows that ground it). The prefix and the fact
// rows below survive because the containment lenses (realization_vocabulary_containment,
// meta_exec_confinement) scan by browsing root; the extdeps citation duty
// (ExtdepsExternalAuthorityGate) is untouched.

type LayerImportFact {
  layer: LayerPrefix
  path: String
  import_module: String
}

fn layer_prefix_from_dotted_qualified_name(qn: String) -> LayerPrefix {
  layer_prefix_from_qualified_name(
    qn: qualified_name_from_dotted_string(dotted: qn)
  )
}

fn layer_prefix_from_qualified_name(qn: QualifiedName) -> LayerPrefix {
  match qn {
    Empty => LayerPrefixStd
    Cons { head: h, tail: t } =>
      if h == ^v2 {
        match list_head(xs: t) {
          HeadAbsent => LayerPrefixStd
          HeadFound { value: h2 } =>
            if h2 == ^std {
              LayerPrefixStd
            } else if h2 == ^extdeps {
              LayerPrefixExtdeps
            } else if h2 == ^compiler {
              LayerPrefixCompiler
            } else if h2 == ^workflow {
              LayerPrefixWorkflow
            } else if h2 == ^lens {
              LayerPrefixCompiler
            } else if h2 == ^test {
              LayerPrefixCompiler
            } else {
              LayerPrefixCompiler
            }
        }
      } else if h == ^extdeps {
        LayerPrefixExtdeps
      } else if h == ^std {
        LayerPrefixStd
      } else if h == ^compiler {
        LayerPrefixCompiler
      } else if h == ^lens {
        LayerPrefixCompiler
      } else if h == ^test {
        LayerPrefixCompiler
      } else if h == ^workflow {
        LayerPrefixWorkflow
      } else if h == ^gunbc {
        LayerPrefixWorkflow
      } else if h == ^tools {
        LayerPrefixWorkflow
      } else {
        LayerPrefixStd
      }
  }
}
