module v2.std.layer

type LayerPrefix
  = LayerPrefixStd
  | LayerPrefixExtdeps
  | LayerPrefixCompiler
  | LayerPrefixWorkflow

fn layer_prefix_ordinal(l: LayerPrefix) -> Int {
  match l {
    LayerPrefixStd => 0
    LayerPrefixExtdeps => 1
    LayerPrefixCompiler => 2
    LayerPrefixWorkflow => 3
  }
}
