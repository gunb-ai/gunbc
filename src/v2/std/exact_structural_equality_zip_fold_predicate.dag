module v2.std.exact_structural_equality_zip_fold_predicate


fn exact_structural_zip_fold_init(n: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.node_for_structural_equality(n: v2.std.node.node_rebuild(n: n, children: []))
}
fn exact_structural_zip_fold_step(acc: v2.std.node.Node, edge: v2.std.node.Edge, child: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.node_rebuild(
    n: acc,
    children: v2.std.algebra.list_snoc_item(xs: acc.children, item: v2.std.node.Edge { label: edge.label, target: child })
  )
}
fn exact_structural_zip_fold_algebra() -> v2.std.node.NodeFold<v2.std.node.Node> {
  v2.std.node.NodeFold {
    init: exact_structural_zip_fold_init,
    step: exact_structural_zip_fold_step
  }
}
fn exact_structural_zip_fold_canonical(n: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.fold_node(
    n: n,
    algebra: exact_structural_zip_fold_algebra()
  )
}
fn exact_structural_equality_zip_fold(source_facts: v2.std.node.Node, candidate: v2.std.node.Node) -> Bool {
  exact_structural_zip_fold_canonical(n: source_facts) == exact_structural_zip_fold_canonical(n: candidate)
}
fn exact_structural_equality_zip_fold_preservation_holds(
  source_facts: v2.std.node.Node,
  candidate: v2.std.node.Node,
  algebra: v2.std.node.Node,
) -> Bool {
  v2.std.node.well_formed(n: source_facts)
    && v2.std.node.well_formed(n: algebra)
    && v2.std.node.well_formed(n: candidate)

    && exact_structural_equality_zip_fold(
      source_facts: algebra,
      candidate: source_facts
    )
    && exact_structural_equality_zip_fold(
      source_facts: source_facts,
      candidate: candidate
    )
}
