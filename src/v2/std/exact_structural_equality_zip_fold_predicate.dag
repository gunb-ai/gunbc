module v2.std.exact_structural_equality_zip_fold_predicate


fn exact_structural_zip_fold_init(n: Node) -> Node {
  node_for_structural_equality(n: node_rebuild(n: n, children: []))
}
fn exact_structural_zip_fold_step(acc: Node, edge: Edge, child: Node) -> Node {
  node_rebuild(
    n: acc,
    children: list_snoc_item(xs: acc.children, item: Edge { label: edge.label, target: child })
  )
}
fn exact_structural_zip_fold_algebra() -> NodeFold<Node> {
  NodeFold {
    init: exact_structural_zip_fold_init,
    step: exact_structural_zip_fold_step
  }
}
fn exact_structural_zip_fold_canonical(n: Node) -> Node {
  fold_node(
    n: n,
    algebra: exact_structural_zip_fold_algebra()
  )
}
fn exact_structural_equality_zip_fold(source_facts: Node, candidate: Node) -> Bool {
  exact_structural_zip_fold_canonical(n: source_facts) == exact_structural_zip_fold_canonical(n: candidate)
}
fn exact_structural_equality_zip_fold_preservation_holds(
  source_facts: Node,
  candidate: Node,
  algebra: Node,
) -> Bool {
  well_formed(n: source_facts)
    && well_formed(n: algebra)
    && well_formed(n: candidate)

    && exact_structural_equality_zip_fold(
      source_facts: algebra,
      candidate: source_facts
    )
    && exact_structural_equality_zip_fold(
      source_facts: source_facts,
      candidate: candidate
    )
}
