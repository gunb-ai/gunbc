module v2.std.exact_structural_equality_zip_fold_predicate

import std.nat { Nat, Succ, Zero }
import std.types { List }
import std.optional {
  Absent,
  Optional,
  Present,
  optional_absent,
  optional_present,
  optional_prefer_first_present
}
import std.algebra { contains, length, list_head, list_snoc_item, skip, zip_map }
import v2.std.node { Edge, Node, Symbol, node_equal_ignoring_provenance, well_formed }

// WHY THE EXACT STRUCTURAL COMPARISON REFUSED IS PART OF THE ANSWER. This predicate is what
// v2.std.find_witness folds, and a Bool answered five different questions with one word: a malformed
// source fact, a malformed algebra, a malformed candidate, a root that differs, or an argument that
// differs. Downstream, a refusal that only says "no candidate matched" gets named after the POSITION it
// was asked at, so every shape that failed here shares one cause whatever question answered no
// (gunbc.recurring_failure_mode `declared_type_wall_keyed_on_the_value_being_a_kernel` and its sibling
// rows name the same cause for different mechanisms). Each conjunct is now an arm of a verdict, decided
// once here, and the Bool the fold asks for is DERIVED from that verdict -- never the reverse, so the
// fold and the reason cannot disagree about which question was asked.
//
// THE VERDICT'S ARMS FALL INTO TWO REFUSAL CLASSES, and the class is chosen in v2.std.inhabitance, not
// here. `ComparisonRootsDiffer`,
// `ComparisonArgumentCountDiffers` and `ComparisonArgumentsDiffer` are the arms that ANSWER the
// inhabitance question: the comparison ran and the produced type does not inhabit the declared one. The
// rest -- `ComparisonSourceFactsMalformed`, `ComparisonAlgebraMalformed`,
// `ComparisonCandidateMalformed`, `ComparisonAlgebraNotTheSourceFacts`, and `ComparisonHolds` reached
// while the witness fold still refused -- say the comparison did not produce a verdict on this pair: an
// upstream or internal defect. Those refuse under a different diagnostic class, so a reader is never sent
// to fix a type error the compiler never showed. `inhabitance_structural_decision_reason` in
// v2.std.inhabitance maps each arm to its refusal symbol and `inhabitance_refusal_diagnostic` gives each
// family its own class.

type ExactStructuralComparison
  = ComparisonHolds
  | ComparisonSourceFactsMalformed
  | ComparisonAlgebraMalformed
  | ComparisonCandidateMalformed
  | ComparisonAlgebraNotTheSourceFacts
  | ComparisonRootsDiffer { argument_ordinal_path: List<Nat> }
  | ComparisonArgumentCountDiffers { source_arity: Int, candidate_arity: Int, argument_ordinal_path: List<Nat> }
  | ComparisonArgumentsDiffer { argument_ordinal_path: List<Nat> }
  // A TYPE VARIABLE IS NOT A ROOT. Answering "the roots differ" about `K` against `Int` refuses a type the
  // relation holds no instance for, in the one decision, for the wrong reason. The scan keeps looking past
  // this arm: a DECIDED disagreement anywhere in the pair wins, and
  // this arm is the answer only when nothing decided -- "a disagreeing sibling beats an undecided one",
  // stated inside the decision rather than in each caller. Two occurrences of the SAME binder are equal by
  // node identity and never reach here; distinct binders, and a variable against a concrete type, do.
  | ComparisonUndecidedTypeVariable { argument_ordinal_path: List<Nat> }

// WHERE IN THE CANDIDATE THE ANSWER WAS DECIDED, on the three arms that answer the inhabitance question.
// The path runs from the pair this comparison was asked about down to the pair the arm was decided at,
// OUTERMOST ARGUMENT FIRST: [] is this pair itself, [0] is argument 0 of it, [0, 1] is argument 1 of
// argument 0. It is produced in the same branch that decides the arm, by the single descent below, so no
// consumer re-derives it -- `Foo<A>` versus `Foo<B>` is decided as
// `ComparisonRootsDiffer { argument_ordinal_path: [0] }` at the argument pair, and the outer level
// propagates THAT arm instead of flattening it to `ComparisonArgumentsDiffer`. The malformed and
// algebra-mismatch arms carry no path: they refuse before any pair is
// compared, so there is no position to name.

// One scan step: the verdict held so far and the ordinal of the child pair under examination. This corpus
// has no face that zips a list with its positions, and minting one was refused (tidy-ant-251), so the
// counter is carried in the accumulator from std.nat's own constructors.
type ExactStructuralScan {
  decided: Optional<ExactStructuralComparison>
  undecided: Optional<ExactStructuralComparison>
  ordinal: Nat
}

// A child pair of two nodes at the same position, the unit the descent decides.
type ExactStructuralChildPair {
  source: Edge
  candidate: Edge
}

fn exact_structural_equality_zip_fold(source_facts: Node, candidate: Node) -> Bool {
  node_equal_ignoring_provenance(a: source_facts, b: candidate)
}

// THE ONE DECISION. The arms follow the shape of `node_equal_ignoring_provenance` -- same root, then the
// labeled children zipped -- so the arms are exhaustive over a refusal rather than a sample of it: with
// the roots equal and the child counts equal, an unequal pair can only differ in a child edge, which is
// `ComparisonArgumentsDiffer`. Malformed operands are reported before any comparison: a node that is
// not well-formed does not get an opinion about which part of it differs.
fn exact_structural_comparison(
  source_facts: Node,
  algebra: Node,
  candidate: Node,
  // the type variables in scope at the judgment: an identity in this list is a variable, not a root, and
  // a pair carrying one is undecided at that position instead of a refusal
  type_variables: List<Symbol>
) -> ExactStructuralComparison {
  if !well_formed(n: source_facts) {
    ComparisonSourceFactsMalformed
  } else if !well_formed(n: algebra) {
    ComparisonAlgebraMalformed
  } else if !well_formed(n: candidate) {
    ComparisonCandidateMalformed
  } else if !exact_structural_equality_zip_fold(source_facts: algebra, candidate: source_facts) {
    ComparisonAlgebraNotTheSourceFacts
  } else {
    exact_structural_shape(source_facts: source_facts, candidate: candidate, argument_ordinal_path: [], type_variables: type_variables)
  }
}

// THE ARGUMENT CHILDREN OF A NODE. An application carries its type constructor as child 0 and its
// arguments after it -- this is the corpus's own reading: infer_type_head_and_args takes head = child 0
// and args = skip(children, 1). An ordinal that names an ARGUMENT is therefore counted over the children
// after the constructor; counting child slots instead is off by one on every application and would name
// the constructor edge as if it were an argument.
// The consumer matches the connective directly: the v2 corpus reads an application the same way wherever
// it needs one (`TypeNode { connective: Instantiation }` in body_lowering_fold, infer, and here), and a
// Bool-shaped predicate over the `NodeKind` sum would be a second, weaker name for one arm of that sum --
// it cannot carry the arm's payload, and callers that DO need the payload would have to re-match anyway.
fn exact_structural_argument_children(node: Node) -> List<Edge> {
  match node.kind {
    TypeNode { connective: Instantiation } => skip(xs: node.children, n: 1)
    _ => node.children
  }
}

// THE HEAD OF AN APPLICATION IS NOT AN ARGUMENT, AND IT IS COMPARED. The corpus puts the type
// constructor in child 0 (infer_type_head_and_args reads head = child 0, args = skip(children, 1)), and
// exact_structural_argument_children skips that child so an argument ordinal names an ARGUMENT and never
// a constructor slot. Skipping it in the ARGUMENTS must not drop it from the comparison: `Foo<A>` against
// `Bar<A>` has equal kind, equal arity and equal arguments, and the whole-tree equality the Bool used
// before this verdict existed -- node_equal_ignoring_provenance -- refuses it precisely because child 0
// differs. Leaving the head out would silently WIDEN the predicate: a value whose type has the wrong head
// would inhabit the declared type, and gunbc.design_argument::fail_closed says "no plausible output is
// fabricated". So the head pair is compared HERE, at its own level, and its refusal is ROOTS -- the head
// IS the root, and naming it with an argument ordinal would call a constructor an argument. A refusal
// found by descending inside a head target is still a refusal about the head, so it is reported at this
// level rather than with a path into the head's own arguments.
fn exact_structural_head_verdict(
  source_facts: Node,
  candidate: Node,
  argument_ordinal_path: List<Nat>,
  type_variables: List<Symbol>
) -> ExactStructuralComparison {
  match source_facts.kind {
    TypeNode { connective: Instantiation } => match list_head(xs: source_facts.children) {
      Absent => match list_head(xs: candidate.children) {
        // neither side carries a head edge: both children lists are empty, which the whole-tree equality
        // also calls equal, so nothing is decided here
        Absent => ComparisonHolds
        Present { value: _ } => ComparisonRootsDiffer { argument_ordinal_path: argument_ordinal_path }
      },
      Present { value: source_head } => match list_head(xs: candidate.children) {
        Absent => ComparisonRootsDiffer { argument_ordinal_path: argument_ordinal_path }
        Present { value: candidate_head } => match exact_structural_child_pair(
          pair: ExactStructuralChildPair { source: source_head, candidate: candidate_head },
          argument_ordinal_path: argument_ordinal_path,
          type_variables: type_variables
        ) {
          ComparisonHolds => ComparisonHolds
          ComparisonUndecidedTypeVariable { argument_ordinal_path: _ } =>
            ComparisonUndecidedTypeVariable { argument_ordinal_path: argument_ordinal_path }
          // any other refusal inside the head pair is a refusal ABOUT THE HEAD
          _ => ComparisonRootsDiffer { argument_ordinal_path: argument_ordinal_path }
        }
      }
    }
    // a non-application has no head child: its root already lived in `kind`, which the caller checked
    _ => ComparisonHolds
  }
}

// A node whose own root is one of the scoped variables: an Atom type node whose identity is a binder. The
// identity test is the corpus's own (`TypeNode { connective: Atom { identity: id } }`, the same shape
// inhabitance_node_mentions_type_variable reads); this one does not walk the subtree, because a variable
// DEEP inside a pair must not decide the outer position -- the descent has to reach it and name its path.
fn exact_structural_root_is_type_variable(node: Node, type_variables: List<Symbol>) -> Bool {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } => contains(xs: type_variables, item: id, eq: fn(x, y) { x == y })
    _ => false
  }
}

// ONE DESCENT, the whole cost of the verdict. The root KIND first, then the HEAD child pair of an
// application (the constructor, which is not an argument and is therefore not in the argument list), then
// arity, then the argument pairs in order: the first pair that does not hold is decided AT ITS OWN LEVEL
// and its arm carries the path to it, so the arm says the mechanism and the path says where. A DECIDED
// disagreement always wins over an undecided one, and of two undecided positions the OUTER one is the one
// reported -- the head before any argument of it. Once a verdict is held the scan stops comparing: it still
// walks the remaining pairs to advance the ordinal, but does no comparison work on them. This NEVER calls
// the whole-tree `exact_structural_equality_zip_fold` per level: a whole-tree equality test at every level
// and then a recursion into the differing child is quadratic in depth times size, which is the cost this
// descent avoids. The pair-wise identity tested here is the same one that Bool tests -- equal label, then
// equal targets, `declaration` ignored -- over the SAME pairs the Bool's whole-tree test walks, the head
// child included, so the verdict and the Bool the witness fold uses cannot disagree about which pair
// holds. All pairs holding IS the pair holding; no arm is invented for the case the scan cannot reach.
fn exact_structural_shape(
  source_facts: Node,
  candidate: Node,
  argument_ordinal_path: List<Nat>,
  type_variables: List<Symbol>
) -> ExactStructuralComparison {
  if source_facts.kind != candidate.kind {
    if exact_structural_root_is_type_variable(node: source_facts, type_variables: type_variables) || exact_structural_root_is_type_variable(node: candidate, type_variables: type_variables) {
      ComparisonUndecidedTypeVariable { argument_ordinal_path: argument_ordinal_path }
    } else {
      ComparisonRootsDiffer { argument_ordinal_path: argument_ordinal_path }
    }
  } else {
    // one computation of the head verdict, read two ways below
    let head_verdict = exact_structural_head_verdict(
      source_facts: source_facts,
      candidate: candidate,
      argument_ordinal_path: argument_ordinal_path,
      type_variables: type_variables
    )
    match exact_structural_head_decided_refusal(verdict: head_verdict) {
      // A DECIDED head refusal ends the level: the head IS the root, decided at THIS pair, and an argument
      // ordinal would misname it.
      Present { value: decided } => decided
      // No decided head refusal -- the head either holds or runs out on a type variable. KEEP SCANNING
      // either way, carrying any undecided head so it is reported only if nothing below decides. Sleek-owl-397's
      // source review caught the opposite ordering: returning an undecided head before the arity and
      // argument scan makes `K<Int>` against `Foo<String, Bool>` report Undecided when the honest answer is
      // ComparisonArgumentCountDiffers, which is the wrong refusal class on the inhabitance route.
      Absent => exact_structural_arity_then_arguments(
        source_facts: source_facts,
        candidate: candidate,
        argument_ordinal_path: argument_ordinal_path,
        type_variables: type_variables,
        carried_undecided: exact_structural_head_undecided(verdict: head_verdict)
      )
    }
  }
}

// THE REST OF ONE LEVEL: arity first, then the argument pairs. `carried_undecided` is the head running out
// at THIS position; it is reported only when nothing at this level or below decides, and it outranks a
// deeper undecided position because the head is the outer place the relation ran out.
fn exact_structural_arity_then_arguments(
  source_facts: Node,
  candidate: Node,
  argument_ordinal_path: List<Nat>,
  type_variables: List<Symbol>,
  carried_undecided: Optional<ExactStructuralComparison>
) -> ExactStructuralComparison {
  if count(exact_structural_argument_children(node: source_facts)) != count(exact_structural_argument_children(node: candidate)) {
    ComparisonArgumentCountDiffers {
      source_arity: count(exact_structural_argument_children(node: source_facts)),
      candidate_arity: count(exact_structural_argument_children(node: candidate)),
      argument_ordinal_path: argument_ordinal_path
    }
  } else {
    let scan = fold(
      zip_map(
        a: exact_structural_argument_children(node: source_facts),
        b: exact_structural_argument_children(node: candidate),
        f: fn(source_edge, candidate_edge) { ExactStructuralChildPair { source: source_edge, candidate: candidate_edge } }
      ),
      init: ExactStructuralScan { decided: optional_absent(), undecided: optional_absent(), ordinal: Zero },
      f: fn(acc, pair) {
        // the path grows at the tail as the descent goes deeper, which is what outermost-first means
        let at = list_snoc_item(xs: argument_ordinal_path, item: acc.ordinal)
        match acc.decided {
          // a decided disagreement is already held: the remaining pairs are walked only to advance the ordinal
          Present { value: held } => ExactStructuralScan { decided: optional_present(value: held), undecided: acc.undecided, ordinal: Succ { prev: acc.ordinal } }
          Absent => match exact_structural_child_pair(pair: pair, argument_ordinal_path: at, type_variables: type_variables) {
            ComparisonHolds => ExactStructuralScan { decided: acc.decided, undecided: acc.undecided, ordinal: Succ { prev: acc.ordinal } }
            ComparisonUndecidedTypeVariable { argument_ordinal_path: _ } => ExactStructuralScan {
              decided: optional_absent(),
              // the FIRST undecided position is the one kept: it is the outermost place the relation runs out
              undecided: match acc.undecided {
                Present { value: _ } => acc.undecided
                Absent => optional_present(value: ComparisonUndecidedTypeVariable { argument_ordinal_path: at })
              },
              ordinal: Succ { prev: acc.ordinal }
            }
            decided => ExactStructuralScan { decided: optional_present(value: decided), undecided: acc.undecided, ordinal: Succ { prev: acc.ordinal } }
          }
        }
      }
    )
    match scan.decided {
      Present { value: decided } => decided
      Absent => match optional_prefer_first_present(left: carried_undecided, right: scan.undecided) {
        Present { value: undecided } => undecided
        Absent => ComparisonHolds
      }
    }
  }
}

// THE HEAD VERDICT READ THE WAY THE SCAN READS A CHILD PAIR: a decided refusal, an undecided position, or
// nothing. `ComparisonHolds` and `ComparisonUndecidedTypeVariable` are constructors, so a match is how
// they are read -- never `==`.
fn exact_structural_head_decided_refusal(verdict: ExactStructuralComparison) -> Optional<ExactStructuralComparison> {
  match verdict {
    ComparisonHolds => optional_absent()
    ComparisonUndecidedTypeVariable { argument_ordinal_path: _ } => optional_absent()
    _ => optional_present(value: verdict)
  }
}

fn exact_structural_head_undecided(verdict: ExactStructuralComparison) -> Optional<ExactStructuralComparison> {
  match verdict {
    ComparisonUndecidedTypeVariable { argument_ordinal_path: path } =>
      optional_present(value: ComparisonUndecidedTypeVariable { argument_ordinal_path: path })
    _ => optional_absent()
  }
}

// ONE CHILD PAIR. Different labels at the same position IS the mechanism, and no descent into targets can
// say that, so this is the route to `ComparisonArgumentsDiffer` that names a position. Same label and equal
// targets: this pair holds. Same label, unequal targets: the descent continues into the targets, and the
// arm reported is the one the targets decide -- the innermost mechanism, not the outer symptom.
fn exact_structural_child_pair(
  pair: ExactStructuralChildPair,
  argument_ordinal_path: List<Nat>,
  type_variables: List<Symbol>
) -> ExactStructuralComparison {
  if pair.source.label != pair.candidate.label {
    ComparisonArgumentsDiffer { argument_ordinal_path: argument_ordinal_path }
  } else if node_equal_ignoring_provenance(a: pair.source.target, b: pair.candidate.target) {
    ComparisonHolds
  } else {
    // the algebra of a nested pair is its own source facts, the same identity the entry check enforces
    exact_structural_shape(source_facts: pair.source.target, candidate: pair.candidate.target, argument_ordinal_path: argument_ordinal_path, type_variables: type_variables)
  }
}

fn exact_structural_equality_zip_fold_preservation_holds(
  source_facts: Node,
  candidate: Node,
  algebra: Node,
) -> Bool {
  match exact_structural_comparison(source_facts: source_facts, algebra: algebra, candidate: candidate, type_variables: []) {
    ComparisonHolds => true
    _ => false
  }
}
