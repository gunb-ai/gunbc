// src/v2/std/exact_structural_equality_zip_fold_predicate.dag
// Scope: mechanical exact-structural-equality zip-fold preservation check (leaf — no find_witness import).
// Coercion fold; catamorphic zip-fold over canonical Node shape.
// Status: T-25-tail predicate prover — catamorphic zip-fold over canonical Node shape; decidable, no search.


module v2.std.exact_structural_equality_zip_fold_predicate


import v2.std.algebra { list_snoc_item }
import v2.std.node { Edge, Node, NodeFold, fold_node, node_for_structural_equality, node_rebuild, well_formed }
// occurrence_id is excluded from structural equality (node.dag
// node_for_structural_equality). The canonical seed normalizes each node's
// occurrence_id to SyntheticOccurrence here; because fold_node routes every node through
// init() as its seed and step() preserves the (already-normalized) accumulator id, the
// whole canonical tree is occurrence-id-insensitive — structurally identical trees with
// distinct minted ids compare EQUAL. (Was node_rebuild, which preserved minted ids.)
fn exact_structural_zip_fold_init(n: Node) -> Node {
  node_for_structural_equality(n: node_rebuild(n: n, children: []))
}
fn exact_structural_zip_fold_step(acc: Node, edge: Edge, child: Node) -> Node {
  node_rebuild(
    n: acc,
    children: list_snoc_item(xs: acc.children, item: Edge { label: edge.label, target: child })
  )
}
fn exact_structural_zip_fold_algebra() -> NodeFold<Node> {
  NodeFold {
    init: exact_structural_zip_fold_init,
    step: exact_structural_zip_fold_step
  }
}
fn exact_structural_zip_fold_canonical(n: Node) -> Node {
  fold_node(
    n: n,
    algebra: exact_structural_zip_fold_algebra()
  )
}
fn exact_structural_equality_zip_fold(source_facts: Node, candidate: Node) -> Bool {
  exact_structural_zip_fold_canonical(n: source_facts) == exact_structural_zip_fold_canonical(n: candidate)
}
fn exact_structural_equality_zip_fold_preservation_holds(
  source_facts: Node,
  candidate: Node,
  algebra: Node,
) -> Bool {
  well_formed(n: source_facts)
    && well_formed(n: algebra)
    && well_formed(n: candidate)
    // occurrence-id-insensitive identity check (was bare ==, which compared minted ids)
    && exact_structural_equality_zip_fold(
      source_facts: algebra,
      candidate: source_facts
    )
    && exact_structural_equality_zip_fold(
      source_facts: source_facts,
      candidate: candidate
    )
}
