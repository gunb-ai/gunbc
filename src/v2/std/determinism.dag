module v2.std.determinism

import std.determinism { Determinism }
import v2.std.node { Symbol }

type DeterminismFact {
  signature: Symbol,
  classification: DeterminismAxis
}

fn determinism_fact_classification(fact: DeterminismFact) -> DeterminismAxis {
  fact.classification
}

fn determinism_fact_signature(fact: DeterminismFact) -> Symbol {
  fact.signature
}
