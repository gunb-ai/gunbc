module v2.std.determinism

import v2.std.node { Symbol }

type NonDetSource
  = HashIteration
  | TimeRead
  | RandomRead
  | EnvRead

type DeterminismClass
  = Deterministic
  | NonDeterministic { source: NonDetSource }

type DeterminismFact {
  signature: Symbol,
  classification: DeterminismClass
}
