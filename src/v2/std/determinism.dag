module v2.std.determinism

import v2.std.collection { Optional, Absent, Present, optional_present }
import v2.std.logic { Bool }
import v2.std.node { Symbol }

type NonDetSource
  = HashIteration
  | TimeRead
  | RandomRead
  | EnvRead

type DeterminismClass
  = Deterministic
  | NonDeterministic { source: NonDetSource }

type DeterminismFact {
  signature: Symbol,
  classification: DeterminismClass
}

fn non_det_source_eq(a: NonDetSource, b: NonDetSource) -> Bool {
  match a {
    HashIteration => match b {
      HashIteration => true
      _ => false
    }
    TimeRead => match b {
      TimeRead => true
      _ => false
    }
    RandomRead => match b {
      RandomRead => true
      _ => false
    }
    EnvRead => match b {
      EnvRead => true
      _ => false
    }
  }
}

fn determinism_class_eq(a: DeterminismClass, b: DeterminismClass) -> Bool {
  match a {
    Deterministic => match b {
      Deterministic => true
      _ => false
    }
    NonDeterministic { source: sa } => match b {
      NonDeterministic { source: sb } => non_det_source_eq(a: sa, b: sb)
      _ => false
    }
  }
}

fn determinism_primitive_lookup(sig: Symbol) -> Optional<DeterminismClass> {
  if sig == ^pure_add {
    optional_present(value: Deterministic)
  } else if sig == ^sorted_export_set_map_keys {
    optional_present(value: Deterministic)
  } else if sig == ^unique_imported_variant_owner {
    optional_present(value: Deterministic)
  } else if sig == ^alpha_sorted_variant_fold {
    optional_present(value: Deterministic)
  } else if sig == ^find_struct_name_by_fields_disambiguation {
    optional_present(value: Deterministic)
  } else if sig == ^hash_map_keys_iter {
    optional_present(value: NonDeterministic { source: HashIteration })
  } else if sig == ^unordered_hash_map_iteration {
    optional_present(value: NonDeterministic { source: HashIteration })
  } else if sig == ^host_clock_now {
    optional_present(value: NonDeterministic { source: TimeRead })
  } else if sig == ^host_random_read {
    optional_present(value: NonDeterministic { source: RandomRead })
  } else if sig == ^host_env_var_read {
    optional_present(value: NonDeterministic { source: EnvRead })
  } else {
    Absent
  }
}

fn determinism_primitive_in_roster(sig: Symbol) -> Bool {
  match determinism_primitive_lookup(sig: sig) {
    Present { value: _ } => true
    Absent => false
  }
}

fn determinism_compose(outer: DeterminismClass, inner: DeterminismClass) -> DeterminismClass {
  match outer {
    NonDeterministic { source: source } => NonDeterministic { source: source }
    Deterministic => inner
  }
}

fn determinism_fact_for_signature(sig: Symbol) -> Optional<DeterminismFact> {
  match determinism_primitive_lookup(sig: sig) {
    Present { value: classification } =>
      optional_present(
        value: DeterminismFact {
          signature: sig,
          classification: classification
        }
      )
    Absent => Absent
  }
}

data witness_pure_add_is_deterministic: Bool = match determinism_primitive_lookup(sig: ^pure_add) {
  Present { value: classification } =>
    determinism_class_eq(a: classification, b: Deterministic)
  Absent => false
}

data witness_hash_map_keys_iter_is_hash_iteration_leak: Bool = match determinism_primitive_lookup(
  sig: ^hash_map_keys_iter
) {
  Present { value: classification } =>
    determinism_class_eq(
      a: classification,
      b: NonDeterministic { source: HashIteration }
    )
  Absent => false
}

data witness_unknown_primitive_absent_from_roster: Bool = match determinism_primitive_lookup(
  sig: ^unknown_determinism_roster_probe
) {
  Absent => true
  Present { value: _ } => false
}

data witness_deterministic_compose_is_deterministic: Bool = determinism_class_eq(
  a: determinism_compose(
    outer: Deterministic,
    inner: Deterministic
  ),
  b: Deterministic
)

data witness_nondeterministic_compose_propagates_left: Bool = determinism_class_eq(
  a: determinism_compose(
    outer: NonDeterministic { source: HashIteration },
    inner: Deterministic
  ),
  b: NonDeterministic { source: HashIteration }
)

data witness_nondeterministic_compose_propagates_right: Bool = determinism_class_eq(
  a: determinism_compose(
    outer: Deterministic,
    inner: NonDeterministic { source: TimeRead }
  ),
  b: NonDeterministic { source: TimeRead }
)

data witness_sorted_export_set_map_keys_is_deterministic: Bool = match determinism_primitive_lookup(
  sig: ^sorted_export_set_map_keys
) {
  Present { value: classification } =>
    determinism_class_eq(a: classification, b: Deterministic)
  Absent => false
}
