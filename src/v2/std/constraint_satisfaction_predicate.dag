module v2.std.constraint_satisfaction_predicate

fn constraint_satisfaction_preservation_holds(
  source_facts: v2.std.node.Node,
  candidate: v2.std.node.Node,
  algebra: v2.std.node.Node,
) -> Bool {
  v2.std.node.well_formed(n: source_facts)
    && v2.std.node.well_formed(n: algebra)
    && v2.std.node.well_formed(n: candidate)
    && (algebra == source_facts)
    && (candidate == source_facts)
}
