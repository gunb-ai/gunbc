module v2.std.constraint_satisfaction_predicate

import v2.std.node { node_equal_ignoring_provenance, Node, well_formed }
fn constraint_satisfaction_preservation_holds(
  source_facts: Node,
  candidate: Node,
  algebra: Node,
) -> Bool {
  well_formed(n: source_facts)
    && well_formed(n: algebra)
    && well_formed(n: candidate)
    && node_equal_ignoring_provenance(a: algebra, b: source_facts)
    && node_equal_ignoring_provenance(a: candidate, b: source_facts)
}
