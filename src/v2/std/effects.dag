module v2.std.effects


data defork_note: String = "v2.std.effects DISSOLVED onto the single std.effects authority (dag-v2 de-fork, docs/plans/dag-v2-defork-audit.md). The EffectShape<K> / CreateCause<K> TYPE is imported from std, never re-defined here -- what was the v2 fork (EffectShape = IsIdempotent | IsBreaking, a 2-level idempotency-class partition) is GONE: idempotency is DERIVED from the one flat EffectShape (DESIGN 4, ops from inhabitance). This module instantiates the type at K = SubstrateKeySource (interned Symbol) for the substrate-witness harness (idempotency conformance by apply-once == apply-twice Node graphs) and builds shapes by direct construction. It does NOT call std.effects's predicates: those are concrete to EffectShape<std.KeySource> by the emitter generic-function-bound frontier (see std.effects.generic_predicate_frontier_note), and the harness needs only the type + constructors, not the predicates."

data substrate_key_source_homonym_note: String = "Renamed from KeySource (P3a-1 self-fork collapse): the bare name KeySource is owned by std.effects (String REST derivation). This carrier is the Symbol substrate instantiation for the Node-witness harness only; no alias back to KeySource."

data key_source_representation_note: String = "v2's SubstrateKeySource is the SUBSTRATE key representation (interned Symbol), the K instantiation of the single std.effects.EffectShape<K> authority for the Node-witness harness -- NOT a fork of std.effects. The verb/cause/idempotency algebra is imported from std; only the key REPRESENTATION differs (Symbol here, String in std's REST derivation). The String/Symbol unification is deferred to the grants key/target re-grounding (docs/plans/effect-namespace-grants.md), never crossed at this seam. dissolve-on = grants grounds key/target on the containment tree (QualifiedName)."

type SubstrateKeySource
  = PathParam { param: v2.std.node.Symbol }
  | InputField { field: v2.std.node.Symbol }

type IdempotentOperationRef {
  callable: v2.std.node.Symbol
}

type ComposableIdempotentOperationSubject
  = ReadIdempotentSample { operation: IdempotentOperationRef }
  | UpsertIdempotentSample { operation: IdempotentOperationRef, key_source: SubstrateKeySource }
  | DeleteIdempotentSample { operation: IdempotentOperationRef, key_source: SubstrateKeySource }
  | CreateIfAbsentIdempotentSample { operation: IdempotentOperationRef, key_source: SubstrateKeySource }

type IdempotentOperationSubject
  = Composable(ComposableIdempotentOperationSubject)
  | LabelOnlyIdempotentInhabitance { shape: std.effects.EffectShape<SubstrateKeySource>, label: v2.std.node.Symbol }

data sample_state: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^sample_state_value } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data sample_read_operation: IdempotentOperationRef = IdempotentOperationRef {
  callable: ^sample_get_callable
}

data sample_upsert_operation: IdempotentOperationRef = IdempotentOperationRef {
  callable: ^sample_upsert_callable
}

data sample_delete_operation: IdempotentOperationRef = IdempotentOperationRef {
  callable: ^sample_delete_callable
}

data sample_create_if_absent_operation: IdempotentOperationRef = IdempotentOperationRef {
  callable: ^sample_create_if_absent_callable
}

data sample_upsert_key_source: SubstrateKeySource = InputField { field: ^sample_path_key_slug }

data sample_delete_key_source: SubstrateKeySource = InputField { field: ^sample_path_key_slug }

data sample_create_if_absent_key_source: SubstrateKeySource = InputField { field: ^sample_path_key_slug }

data sample_create_if_absent_key_b: SubstrateKeySource = InputField { field: ^sample_alt_path_key_slug }

data sample_read_composable: ComposableIdempotentOperationSubject = ReadIdempotentSample {
  operation: sample_read_operation
}

data sample_upsert_composable: ComposableIdempotentOperationSubject = UpsertIdempotentSample {
  operation: sample_upsert_operation,
  key_source: sample_upsert_key_source
}

data sample_delete_composable: ComposableIdempotentOperationSubject = DeleteIdempotentSample {
  operation: sample_delete_operation,
  key_source: sample_delete_key_source
}

data sample_create_if_absent_composable: ComposableIdempotentOperationSubject = CreateIfAbsentIdempotentSample {
  operation: sample_create_if_absent_operation,
  key_source: sample_create_if_absent_key_source
}

data sample_read_subject: IdempotentOperationSubject = Composable(sample_read_composable)

data sample_upsert_subject: IdempotentOperationSubject = Composable(sample_upsert_composable)

data sample_delete_subject: IdempotentOperationSubject = Composable(sample_delete_composable)

data sample_create_if_absent_subject: IdempotentOperationSubject = Composable(sample_create_if_absent_composable)

data sample_label_only_subject: IdempotentOperationSubject = LabelOnlyIdempotentInhabitance {
  shape: std.effects.ReadEffect,
  label: ^sample_label_only_callable
}

fn create_if_absent_shape(key_source: SubstrateKeySource) -> std.effects.EffectShape<SubstrateKeySource> {
  std.effects.CreateEffect { cause: std.effects.CreateIfAbsent { key_source: key_source } }
}

fn create_always_shape() -> std.effects.EffectShape<SubstrateKeySource> {
  std.effects.CreateEffect { cause: std.effects.PostAlways }
}

fn atom_node(s: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } }, children: [],
 occurrence_id: SyntheticOccurrence
}
}

fn key_source_node(key_source: SubstrateKeySource) -> v2.std.node.Node {
  match key_source {
    PathParam { param: p } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: Conj },
        children: [
          v2.std.node.Edge {
            label: v2.std.node.Named { name: ^key_source_path_param_field },
            target: v2.std.effects.atom_node(s: ^key_source_path_param_field)
          },
          v2.std.node.Edge {
            label: v2.std.node.Named { name: ^key_source_path_param_value_field },
            target: v2.std.effects.atom_node(s: p)
          },
        ],
        occurrence_id: SyntheticOccurrence
}
    InputField { field: f } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: Conj },
        children: [
          v2.std.node.Edge {
            label: v2.std.node.Named { name: ^key_source_input_field_field },
            target: v2.std.effects.atom_node(s: ^key_source_input_field_field)
          },
          v2.std.node.Edge {
            label: v2.std.node.Named { name: ^key_source_input_value_field },
            target: v2.std.effects.atom_node(s: f)
          },
        ],
        occurrence_id: SyntheticOccurrence
}
  }
}

fn keyed_shape_node(variant_marker: v2.std.node.Symbol, key_source: SubstrateKeySource) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Named { name: variant_marker },
        target: v2.std.effects.atom_node(s: variant_marker)
      },
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^idempotent_operation_key_source_field },
        target: key_source_node(key_source: key_source)
      },
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn effect_shape_node(shape: std.effects.EffectShape<SubstrateKeySource>) -> v2.std.node.Node {
  match shape {
    ReadEffect => v2.std.effects.atom_node(s: ^effect_shape_variant_read)
    UpsertEffect { key_source: key_source } =>
      keyed_shape_node(variant_marker: ^effect_shape_variant_upsert, key_source: key_source)
    DeleteEffect { key_source: key_source } =>
      keyed_shape_node(variant_marker: ^effect_shape_variant_delete, key_source: key_source)
    CreateEffect { cause: cause } =>
      match cause {
        CreateIfAbsent { key_source: key_source } =>
          keyed_shape_node(variant_marker: ^effect_shape_variant_create_if_absent, key_source: key_source)
        PostAlways => v2.std.effects.atom_node(s: ^effect_shape_variant_create_always)
        KeylessFallback { method: method } => v2.std.effects.atom_node(s: ^effect_shape_variant_create_keyless)
      }
    AppendEffect => v2.std.effects.atom_node(s: ^effect_shape_variant_append)
    ExecuteEffect => v2.std.effects.atom_node(s: ^effect_shape_variant_execute)
  }
}

fn classified_idempotent_effect_node(shape: std.effects.EffectShape<SubstrateKeySource>) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^effect_shape_is_idempotent_field },
        target: v2.std.effects.atom_node(s: ^effect_shape_is_idempotent_field)
      },
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^effect_shape_inner_field },
        target: effect_shape_node(shape: shape)
      },
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn idempotent_operation_ref_node(operation: IdempotentOperationRef) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^idempotent_operation_callable_field },
        target: v2.std.effects.atom_node(s: operation.callable)
      },
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn idempotent_operation_witness_node(subject: ComposableIdempotentOperationSubject) -> v2.std.node.Node {
  match subject {
    ReadIdempotentSample { operation: operation } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: Conj },
        children: [
          v2.std.node.Edge {
            label: v2.std.node.Named { name: ^effect_shape_inner_field },
            target: classified_idempotent_effect_node(shape: std.effects.ReadEffect)
          },
          v2.std.node.Edge {
            label: v2.std.node.Named { name: ^idempotent_operation_callable_field },
            target: idempotent_operation_ref_node(operation: operation)
          },
        ],
        occurrence_id: SyntheticOccurrence
}
    UpsertIdempotentSample { operation: operation, key_source: key_source } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: Conj },
        children: [
          v2.std.node.Edge {
            label: v2.std.node.Named { name: ^effect_shape_inner_field },
            target: classified_idempotent_effect_node(shape: std.effects.UpsertEffect { key_source: key_source })
          },
          v2.std.node.Edge {
            label: v2.std.node.Named { name: ^idempotent_operation_callable_field },
            target: idempotent_operation_ref_node(operation: operation)
          },
        ],
        occurrence_id: SyntheticOccurrence
}
    DeleteIdempotentSample { operation: operation, key_source: key_source } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: Conj },
        children: [
          v2.std.node.Edge {
            label: v2.std.node.Named { name: ^effect_shape_inner_field },
            target: classified_idempotent_effect_node(shape: std.effects.DeleteEffect { key_source: key_source })
          },
          v2.std.node.Edge {
            label: v2.std.node.Named { name: ^idempotent_operation_callable_field },
            target: idempotent_operation_ref_node(operation: operation)
          },
        ],
        occurrence_id: SyntheticOccurrence
}
    CreateIfAbsentIdempotentSample { operation: operation, key_source: key_source } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: Conj },
        children: [
          v2.std.node.Edge {
            label: v2.std.node.Named { name: ^effect_shape_inner_field },
            target: classified_idempotent_effect_node(
              shape: std.effects.CreateEffect { cause: std.effects.CreateIfAbsent { key_source: key_source } }
            )
          },
          v2.std.node.Edge {
            label: v2.std.node.Named { name: ^idempotent_operation_callable_field },
            target: idempotent_operation_ref_node(operation: operation)
          },
        ],
        occurrence_id: SyntheticOccurrence
}
  }
}

fn idempotent_operation_apply_node(state: v2.std.node.Node, subject: ComposableIdempotentOperationSubject) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: v2.std.node.Transform },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^idempotent_apply_state_field },
        target: state
      },
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^idempotent_apply_operation_field },
        target: idempotent_operation_witness_node(subject: subject)
      },
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn idempotent_operation_apply_once(state: v2.std.node.Node, subject: ComposableIdempotentOperationSubject) -> v2.std.node.Node {
  idempotent_operation_apply_node(state: state, subject: subject)
}

fn idempotent_operation_apply_twice(state: v2.std.node.Node, subject: ComposableIdempotentOperationSubject) -> v2.std.node.Node {
  idempotent_operation_apply_node(
    state: idempotent_operation_apply_node(state: state, subject: subject),
    subject: subject
  )
}
