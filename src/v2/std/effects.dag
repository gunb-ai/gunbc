module v2.std.effects

import v2.std.node { Atom, Conj, ComputationNode, Edge, Named, Node, Symbol, Transform, TypeNode, SyntheticOccurrence }

type IdempotentShape
  = ReadEffect
  | UpsertEffect { key_source: KeySource }
  | DeleteEffect { key_source: KeySource }
  | CreateIfAbsentEffect { key_source: KeySource }

type BreakingShape
  = CreateEffect { cause: BreakingCreateCause }
  | AppendEffect

type BreakingCreateCause
  = PostAlways
  | KeylessFallback { method: Symbol }

type CreateCause
  = PostAlways
  | KeylessFallback { method: Symbol }
  | CreateIfAbsent { key_source: KeySource }

type KeySource
  = PathParam { param: Symbol }
  | InputField { field: Symbol }

type EffectShape
  = IsIdempotent(IdempotentShape)
  | IsBreaking(BreakingShape)

type IdempotentOperationRef {
  callable: Symbol
}

type ComposableIdempotentOperationSubject
  = ReadIdempotentSample { operation: IdempotentOperationRef }
  | UpsertIdempotentSample { operation: IdempotentOperationRef, key_source: KeySource }
  | DeleteIdempotentSample { operation: IdempotentOperationRef, key_source: KeySource }
  | CreateIfAbsentIdempotentSample { operation: IdempotentOperationRef, key_source: KeySource }

type IdempotentOperationSubject
  = Composable(ComposableIdempotentOperationSubject)
  | LabelOnlyIdempotentInhabitance { shape: IdempotentShape, label: Symbol }

data sample_state: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^sample_state_value } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data sample_read_operation: IdempotentOperationRef = IdempotentOperationRef {
  callable: ^sample_get_callable
}

data sample_upsert_operation: IdempotentOperationRef = IdempotentOperationRef {
  callable: ^sample_upsert_callable
}

data sample_delete_operation: IdempotentOperationRef = IdempotentOperationRef {
  callable: ^sample_delete_callable
}

data sample_create_if_absent_operation: IdempotentOperationRef = IdempotentOperationRef {
  callable: ^sample_create_if_absent_callable
}

data sample_upsert_key_source: KeySource = InputField { field: ^sample_path_key_slug }

data sample_delete_key_source: KeySource = InputField { field: ^sample_path_key_slug }

data sample_create_if_absent_key_source: KeySource = InputField { field: ^sample_path_key_slug }

data sample_read_composable: ComposableIdempotentOperationSubject = ReadIdempotentSample {
  operation: sample_read_operation
}

data sample_upsert_composable: ComposableIdempotentOperationSubject = UpsertIdempotentSample {
  operation: sample_upsert_operation,
  key_source: sample_upsert_key_source
}

data sample_delete_composable: ComposableIdempotentOperationSubject = DeleteIdempotentSample {
  operation: sample_delete_operation,
  key_source: sample_delete_key_source
}

data sample_create_if_absent_composable: ComposableIdempotentOperationSubject = CreateIfAbsentIdempotentSample {
  operation: sample_create_if_absent_operation,
  key_source: sample_create_if_absent_key_source
}

data sample_read_subject: IdempotentOperationSubject = Composable(sample_read_composable)

data sample_upsert_subject: IdempotentOperationSubject = Composable(sample_upsert_composable)

data sample_delete_subject: IdempotentOperationSubject = Composable(sample_delete_composable)

data sample_create_if_absent_subject: IdempotentOperationSubject = Composable(sample_create_if_absent_composable)

data sample_label_only_subject: IdempotentOperationSubject = LabelOnlyIdempotentInhabitance {
  shape: ReadEffect,
  label: ^sample_label_only_callable
}

fn effect_shape_for_create_cause(cause: CreateCause) -> EffectShape {
  match cause {
    CreateIfAbsent { key_source: key_source } =>
      IsIdempotent(CreateIfAbsentEffect { key_source: key_source })
    PostAlways =>
      IsBreaking(CreateEffect { cause: PostAlways })
    KeylessFallback { method: method } =>
      IsBreaking(CreateEffect { cause: KeylessFallback { method: method } })
  }
}

fn key_source_eq(a: KeySource, b: KeySource) -> Bool {
  match a {
    PathParam { param: pa } => match b {
      PathParam { param: pb } => pa == pb
      _ => false
    }
    InputField { field: fa } => match b {
      InputField { field: fb } => fa == fb
      _ => false
    }
  }
}

fn create_effect_is_dedupable(shape: EffectShape) -> Bool {
  match shape {
    IsIdempotent(CreateIfAbsentEffect { key_source: key_source }) => true
    IsIdempotent(ReadEffect) => false
    IsIdempotent(UpsertEffect { key_source: key_source }) => false
    IsIdempotent(DeleteEffect { key_source: key_source }) => false
    IsBreaking(CreateEffect { cause: PostAlways }) => false
    IsBreaking(CreateEffect { cause: KeylessFallback { method: method } }) => false
    IsBreaking(AppendEffect) => false
  }
}

fn create_double_init_collapsible(a: EffectShape, b: EffectShape) -> Bool {
  match a {
    IsIdempotent(CreateIfAbsentEffect { key_source: ka }) =>
      match b {
        IsIdempotent(CreateIfAbsentEffect { key_source: kb }) =>
          key_source_eq(a: ka, b: kb)
        IsIdempotent(ReadEffect) => false
        IsIdempotent(UpsertEffect { key_source: key_source }) => false
        IsIdempotent(DeleteEffect { key_source: key_source }) => false
        IsBreaking(CreateEffect { cause: PostAlways }) => false
        IsBreaking(CreateEffect { cause: KeylessFallback { method: method } }) => false
        IsBreaking(AppendEffect) => false
      }
    IsIdempotent(ReadEffect) => false
    IsIdempotent(UpsertEffect { key_source: key_source }) => false
    IsIdempotent(DeleteEffect { key_source: key_source }) => false
    IsBreaking(CreateEffect { cause: PostAlways }) => false
    IsBreaking(CreateEffect { cause: KeylessFallback { method: method } }) => false
    IsBreaking(AppendEffect) => false
  }
}

data sample_create_if_absent_key_b: KeySource = InputField { field: ^sample_alt_path_key_slug }

fn create_if_absent_shape(key_source: KeySource) -> EffectShape {
  effect_shape_for_create_cause(cause: CreateIfAbsent { key_source: key_source })
}

fn create_always_shape() -> EffectShape {
  effect_shape_for_create_cause(cause: PostAlways)
}

fn atom_node(s: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: s } }, children: [],
 occurrence_id: SyntheticOccurrence
}
}

fn key_source_node(key_source: KeySource) -> Node {
  match key_source {
    PathParam { param: p } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge {
            label: Named { name: ^key_source_path_param_field },
            target: atom_node(s: ^key_source_path_param_field)
          },
          Edge {
            label: Named { name: ^key_source_path_param_value_field },
            target: atom_node(s: p)
          },
        ],
        occurrence_id: SyntheticOccurrence
}
    InputField { field: f } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge {
            label: Named { name: ^key_source_input_field_field },
            target: atom_node(s: ^key_source_input_field_field)
          },
          Edge {
            label: Named { name: ^key_source_input_value_field },
            target: atom_node(s: f)
          },
        ],
        occurrence_id: SyntheticOccurrence
}
  }
}

fn idempotent_shape_node(shape: IdempotentShape) -> Node {
  match shape {
    ReadEffect => atom_node(s: ^effect_shape_variant_read)
    UpsertEffect { key_source: key_source } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge {
            label: Named { name: ^effect_shape_variant_upsert },
            target: atom_node(s: ^effect_shape_variant_upsert)
          },
          Edge {
            label: Named { name: ^idempotent_operation_key_source_field },
            target: key_source_node(key_source: key_source)
          },
        ],
        occurrence_id: SyntheticOccurrence
}
    DeleteEffect { key_source: key_source } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge {
            label: Named { name: ^effect_shape_variant_delete },
            target: atom_node(s: ^effect_shape_variant_delete)
          },
          Edge {
            label: Named { name: ^idempotent_operation_key_source_field },
            target: key_source_node(key_source: key_source)
          },
        ],
        occurrence_id: SyntheticOccurrence
}
    CreateIfAbsentEffect { key_source: key_source } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge {
            label: Named { name: ^effect_shape_variant_create_if_absent },
            target: atom_node(s: ^effect_shape_variant_create_if_absent)
          },
          Edge {
            label: Named { name: ^idempotent_operation_key_source_field },
            target: key_source_node(key_source: key_source)
          },
        ],
        occurrence_id: SyntheticOccurrence
}
  }
}

fn classified_idempotent_effect_node(shape: IdempotentShape) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^effect_shape_is_idempotent_field },
        target: atom_node(s: ^effect_shape_is_idempotent_field)
      },
      Edge {
        label: Named { name: ^effect_shape_inner_field },
        target: idempotent_shape_node(shape: shape)
      },
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn idempotent_operation_ref_node(operation: IdempotentOperationRef) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^idempotent_operation_callable_field },
        target: atom_node(s: operation.callable)
      },
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn idempotent_operation_apply_node(state: Node, subject: ComposableIdempotentOperationSubject) -> Node {
  Node {
    kind: ComputationNode { behavior: Transform },
    children: [
      Edge {
        label: Named { name: ^idempotent_apply_state_field },
        target: state
      },
      Edge {
        label: Named { name: ^idempotent_apply_operation_field },
        target: idempotent_operation_witness_node(subject: subject)
      },
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn idempotent_operation_apply_once(state: Node, subject: ComposableIdempotentOperationSubject) -> Node {
  idempotent_operation_apply_node(state: state, subject: subject)
}

fn idempotent_operation_apply_twice(state: Node, subject: ComposableIdempotentOperationSubject) -> Node {
  idempotent_operation_apply_node(
    state: idempotent_operation_apply_node(state: state, subject: subject),
    subject: subject
  )
}

fn idempotent_operation_witness_node(subject: ComposableIdempotentOperationSubject) -> Node {
  match subject {
    ReadIdempotentSample { operation: operation } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge {
            label: Named { name: ^effect_shape_inner_field },
            target: classified_idempotent_effect_node(shape: ReadEffect)
          },
          Edge {
            label: Named { name: ^idempotent_operation_callable_field },
            target: idempotent_operation_ref_node(operation: operation)
          },
        ],
        occurrence_id: SyntheticOccurrence
}
    UpsertIdempotentSample { operation: operation, key_source: key_source } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge {
            label: Named { name: ^effect_shape_inner_field },
            target: classified_idempotent_effect_node(shape: UpsertEffect { key_source: key_source })
          },
          Edge {
            label: Named { name: ^idempotent_operation_callable_field },
            target: idempotent_operation_ref_node(operation: operation)
          },
        ],
        occurrence_id: SyntheticOccurrence
}
    DeleteIdempotentSample { operation: operation, key_source: key_source } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge {
            label: Named { name: ^effect_shape_inner_field },
            target: classified_idempotent_effect_node(shape: DeleteEffect { key_source: key_source })
          },
          Edge {
            label: Named { name: ^idempotent_operation_callable_field },
            target: idempotent_operation_ref_node(operation: operation)
          },
        ],
        occurrence_id: SyntheticOccurrence
}
    CreateIfAbsentIdempotentSample { operation: operation, key_source: key_source } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge {
            label: Named { name: ^effect_shape_inner_field },
            target: classified_idempotent_effect_node(
              shape: CreateIfAbsentEffect { key_source: key_source }
            )
          },
          Edge {
            label: Named { name: ^idempotent_operation_callable_field },
            target: idempotent_operation_ref_node(operation: operation)
          },
        ],
        occurrence_id: SyntheticOccurrence
}
  }
}

data witness_create_if_absent_cause_is_idempotent: Bool = match effect_shape_for_create_cause(
  cause: CreateIfAbsent { key_source: sample_create_if_absent_key_source }
) {
  IsIdempotent(CreateIfAbsentEffect { key_source: sample_create_if_absent_key_source }) => true
  IsBreaking(CreateEffect { cause: PostAlways }) => false
  IsBreaking(CreateEffect { cause: KeylessFallback { method: method } }) => false
  IsBreaking(AppendEffect) => false
  IsIdempotent(ReadEffect) => false
  IsIdempotent(UpsertEffect { key_source: key_source }) => false
  IsIdempotent(DeleteEffect { key_source: key_source }) => false
}

data witness_post_always_cause_is_breaking: Bool = match effect_shape_for_create_cause(cause: PostAlways) {
  IsBreaking(CreateEffect { cause: PostAlways }) => true
  IsIdempotent(CreateIfAbsentEffect { key_source: key_source }) => false
  IsBreaking(CreateEffect { cause: KeylessFallback { method: method } }) => false
  IsBreaking(AppendEffect) => false
  IsIdempotent(ReadEffect) => false
  IsIdempotent(UpsertEffect { key_source: key_source }) => false
  IsIdempotent(DeleteEffect { key_source: key_source }) => false
}
