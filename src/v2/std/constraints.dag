module v2.std.constraints


type ConstraintGraph {
  root: v2.std.node.Node
}

type CanonicalGrounding {
  node: v2.std.node.Node
  witness: CanonicalGroundingWitness
}
type ConstraintSatisfactionPredicate {
  algebra: v2.std.node.Node
}
type ConstraintSolvePolicy {
  graph: ConstraintGraph
}
type CanonicalGroundingCandidateSet {
  set: v2.std.find_witness.CandidateSet
}
type CanonicalGroundingWitness {
  structural: v2.std.witness.StructuralPropertyWitness

  closedness: v2.std.witness.StructuralPropertyWitness
}
fn constraints_not_realized_diagnostic(graph: ConstraintGraph) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^constraints_not_realized,
    at: v2.std.diagnostic.node_locus(node: graph.root),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}
fn constraints_ill_formed_root_diagnostic(graph: ConstraintGraph) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^constraints_ill_formed_root,
    at: v2.std.diagnostic.node_locus(node: graph.root),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

// v2.std.constraints.canonical_grounding_from_derived_type is the SINGLE construction authority for CanonicalGrounding: a grounding's structural evidence IS the node's resolved type (v2.compiler.infer.inferred_facts_resolved_type reads exactly this field), so a grounding whose evidence is the source node states 'this expression's type is itself' — source identity standing where a derivation belongs. That state is refused here rather than checked downstream (DESIGN §5 construction, not validation), which is why the refusal lives on the constructor and not in a lens. The derivations that legitimately inhabit it pass a type derived from the node's children (v2.compiler.infer's branch/match/loop derivations pass the unified arm type, the match body type, and the loop carrier type respectively, all via inferred_facts_from_derived_type; the claim fixtures in v2.lens.common.infer_fixture pass the declared i64/bool type node).
fn grounding_evidence_is_source_diagnostic(node: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^grounding_evidence_is_source,
    at: v2.std.diagnostic.node_locus(node: node),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn canonical_grounding_from_derived_type(
  node: v2.std.node.Node,
  derived_type: v2.std.node.Node,
) -> v2.std.diagnostic.Outcome<CanonicalGrounding> {
  if derived_type == node {
    v2.std.diagnostic.outcome_rejected(grounding_evidence_is_source_diagnostic(node: node))
  } else {
    v2.std.diagnostic.Accepted {
      value: CanonicalGrounding {
        node: node,
        witness: CanonicalGroundingWitness {
          structural: v2.std.witness.StructuralPropertyWitness {
            property: ^constraint_property_being_canonical,
            evidence: derived_type
          },
          closedness: v2.std.witness.StructuralPropertyWitness {
            property: ^constraint_property_candidate_set_closedness,
            evidence: node
          }
        }
      },
      diagnostics: v2.std.diagnostic.None
    }
  }
}

fn constraint_satisfaction_holds(
  source_facts: v2.std.node.Node,
  candidate: v2.std.node.Node,
  predicate: ConstraintSatisfactionPredicate,
) -> Bool {
  v2.std.constraint_satisfaction_predicate.constraint_satisfaction_preservation_holds(
    source_facts: source_facts,
    candidate: candidate,
    algebra: predicate.algebra
  )
}
fn constraint_satisfaction_predicate(algebra: v2.std.node.Node) -> ConstraintSatisfactionPredicate {
  ConstraintSatisfactionPredicate { algebra: algebra }
}
fn constraint_satisfaction_preservation_predicate(
  predicate: ConstraintSatisfactionPredicate,
) -> v2.std.find_witness.PreservationPredicate {
  v2.std.find_witness.PreservationPredicate {
    algebra: predicate.algebra,
    preservation_rule: ^preservation_rule_constraint_satisfaction
  }
}
fn canonical_grounding_candidate_set_closedness(root: v2.std.node.Node) -> v2.std.witness.StructuralPropertyWitness {
  v2.std.witness.StructuralPropertyWitness {
    property: ^constraint_property_candidate_set_closedness,
    evidence: root
  }
}

fn canonical_grounding_candidates(
  policy: ConstraintSolvePolicy,
) -> v2.std.diagnostic.Outcome<CanonicalGroundingCandidateSet> {
  if v2.std.node.well_formed(n: policy.graph.root) {
    v2.std.diagnostic.Accepted {
      value: CanonicalGroundingCandidateSet {
        set: v2.std.find_witness.CandidateSet {
          candidates: [policy.graph.root],
          closedness: canonical_grounding_candidate_set_closedness(root: policy.graph.root)
        }
      },
      diagnostics: v2.std.diagnostic.None
    }
  } else {
    v2.std.diagnostic.outcome_rejected(constraints_ill_formed_root_diagnostic(graph: policy.graph))
  }
}
fn solve_constraints(policy: ConstraintSolvePolicy) -> v2.std.diagnostic.Outcome<CanonicalGrounding> {
  v2.std.diagnostic.bind_outcome(
    o: canonical_grounding_candidates(policy: policy),
    f: fn(grounding_candidates) {
      match v2.std.find_witness.find_witness(
        source_facts: policy.graph.root,
        candidates: grounding_candidates.set,
        predicate: constraint_satisfaction_preservation_predicate(
          predicate: constraint_satisfaction_predicate(algebra: policy.graph.root)
        ),
        multiplicity_policy: v2.std.find_witness.UniqueOnly
      ) {
        v2.std.diagnostic.Accepted { value: fw, diagnostics: fw_d } =>
          v2.std.diagnostic.outcome_with_diagnostics(
            value: CanonicalGrounding {
              node: fw.candidate,
              witness: CanonicalGroundingWitness {
                structural: fw.witness,
                closedness: fw.closedness
              }
            },
            diagnostics: fw_d
          )
        v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
      }
    }
  )
}
