// src/v2/std/platform.dag
// Scope: cross-cutting platform vocabulary — OperatingSystem, Architecture, LibcEnv, Vendor.
//        These are domain-general types consumed by target-triple composition (std/target_triple),
//        platform-detection facts (extdeps/platform_detection), runtime/build pools (workflow/ci),
//        and binary distribution (install/install). Authority lives here per single authority
//        (DESIGN.md §3) — all consumers import; do not redeclare. Mirrors the layered modeling already established in
//        gunb-ai/the-gunbai (crates/gunbai-types/src/platform.rs +
//        crates/gunbai-integrations-contracts/src/understanding/rust_targets.rs).
// Status: Release Jun1 §5 Phase 1b prerequisite — modeled 2026-05-29.
// Anchor: https://doc.rust-lang.org/rustc/platform-support.html — Rust platform-support tiers,
//         which enumerate the closed sets the variants below model.

module v2.std.platform


// Anchor: https://doc.rust-lang.org/rustc/platform-support.html (Rust `os` axis of the target
// triple). The set is closed by Rust's grammar; OSes outside this list are not expressible as
// Rust target triples without substrate extension. "Macos" follows the Rust-CLI / cargo
// nomenclature ("apple-darwin" is the Rust target form; "macos" is the human label).
// 🟢 coproduct dissolution — OperatingSystem.
type OperatingSystem
  = Linux
  | Macos
  | Windows
  | Freebsd
  | Wasi


// Anchor: https://doc.rust-lang.org/rustc/platform-support.html (`arch` axis). Variants chosen
// for "all common platforms modeled from day 1" coverage; extension lands by adding variants
// when a new Rust target tier1/tier2 arch ships.
// 🟢 coproduct dissolution — Architecture.
type Architecture
  = X86_64
  | Aarch64
  | X86
  | Armv7
  | Riscv64
  | Wasm32


// Anchor: Rust target-triple `vendor` axis. UnknownVendor is the Rust-grammar placeholder used
// for Linux / BSD / Wasi target triples; Apple / Pc are the named vendors. The set is closed by
// the Rust target-triple grammar.
// 🟢 coproduct dissolution — Vendor.
type Vendor
  = UnknownVendor
  | Apple
  | Pc


// Anchor: Rust target-triple `env` axis — libc / runtime environment. Gnu / Musl for Linux,
// Msvc / Gnu for Windows, absent (NoneLibc) for Darwin / Wasi / Freebsd-default. NoneLibc is
// the "no env component" Rust-triple shape (e.g. `x86_64-apple-darwin` has no fourth field);
// kept as an explicit variant rather than Optional to preserve closed-set pattern matching.
// 🟢 coproduct dissolution — LibcEnv.
type LibcEnv
  = Gnu
  | Musl
  | Msvc
  | NoneLibc
