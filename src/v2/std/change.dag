module v2.std.change

import std.change {
  KeyedRow,
  KeyedPatch,
  KeyedDiffKind,
  KeyedDiffHunk,
  KeyedLeafVerdict,
  KeyedThreeWayPatch,
  KeyedThreeWayEntry,
  KeyedConvergePlan,
  keyed_three_way_leaf,
  keyed_two_way_diff,
  keyed_three_way_fold,
  keyed_apply_patch,
  keyed_apply_two_way_diff,
  keyed_retract_two_way_diff,
  keyed_invert_patch,
  keyed_patch_empty,
  keyed_patch_append,
  keyed_patch_fold,
  keyed_patch_singleton,
  keyed_patch_monoid,
  keyed_three_way_patch_append,
  keyed_three_way_patch_monoid,
  keyed_three_way_patch_singleton,
  keyed_leaf_verdict_join,
  keyed_patches_equal,
  keyed_rows_snapshot_equal,
  keyed_plan_from_verdict,
  keyed_plan_has_apply_arm,
}
import v2.std.collection { List }
import v2.std.dependency { DependencyKind, DependencyView, ReadinessLayer }
import v2.std.diagnostic { NonEmptyDiagnostics, Outcome }
import v2.std.node { Node, Path, Symbol }

type ChangeKind
  = NodeChanged
  | NodeAdded
  | NodeRemoved
  | ProjectionChanged
  | ArtifactChanged

type Change {
  kind: ChangeKind
  subject: Node
  at: Path
}

type ChangeSet {
  changes: List<Change>
}

type DependencyEndpoint
  = DependencySource
  | DependencyDependent

type AffectedDependency {
  change: Change
  dependency: DependencyView
  target: DependencyEndpoint
}

type AffectedExclusion {
  change: Change
  dependency: DependencyView
  usage_site: Node
  changed_dimension: Symbol
}

type AffectedSetEvidence
  = AffectedSetReason { reason: Symbol }
  | AffectedSetDiagnostics { diagnostics: NonEmptyDiagnostics }

type AffectedSet
  = AffectedSetProduced {
      changes: ChangeSet,
      affected: List<AffectedDependency>,
      exclusions: List<AffectedExclusion>,
      restricted_to: List<DependencyKind>
    }
  | AffectedSetFailClosed {
      changes: ChangeSet,
      evidence: AffectedSetEvidence
    }

type RecomputePlan {
  affected: AffectedSet
  layers: List<ReadinessLayer>
  diagnostic: Outcome<Symbol>
}
