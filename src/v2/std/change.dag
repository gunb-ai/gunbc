module v2.std.change


type ChangeKind
  = NodeChanged
  | NodeAdded
  | NodeRemoved
  | ProjectionChanged
  | ArtifactChanged

type Change {
  kind: ChangeKind
  subject: Node
  at: v2.std.node.Path
}

type ChangeSet {
  changes: List<Change>
}

type DependencyEndpoint
  = DependencySource
  | DependencyDependent

type AffectedDependency {
  change: Change
  dependency: v2.std.dependency.DependencyView
  target: DependencyEndpoint
}

type AffectedExclusion {
  change: Change
  dependency: v2.std.dependency.DependencyView
  usage_site: Node
  changed_dimension: v2.std.node.Symbol
}

type AffectedSetEvidence
  = AffectedSetReason { reason: v2.std.node.Symbol }
  | AffectedSetDiagnostics { diagnostics: v2.std.diagnostic.NonEmptyDiagnostics }

type AffectedSet
  = AffectedSetProduced {
      changes: ChangeSet,
      affected: List<AffectedDependency>,
      exclusions: List<AffectedExclusion>,
      restricted_to: List<v2.std.dependency.DependencyKind>
    }
  | AffectedSetFailClosed {
      changes: ChangeSet,
      evidence: AffectedSetEvidence
    }

type RecomputePlan {
  affected: AffectedSet
  layers: List<v2.std.dependency.ReadinessLayer>
  diagnostic: Outcome<v2.std.node.Symbol>
}
