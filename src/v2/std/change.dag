module v2.std.change


type ChangeKind
  = NodeChanged
  | NodeAdded
  | NodeRemoved
  | ProjectionChanged
  | ArtifactChanged

type Change {
  kind: v2.std.change.ChangeKind
  subject: v2.std.node.Node
  at: v2.std.node.Path
}

type ChangeSet {
  changes: std.types.List<Change>
}

type DependencyEndpoint
  = DependencySource
  | DependencyDependent

type AffectedDependency {
  change: Change
  dependency: v2.std.dependency.DependencyView
  target: DependencyEndpoint
}

type AffectedExclusion {
  change: Change
  dependency: v2.std.dependency.DependencyView
  usage_site: v2.std.node.Node
  changed_dimension: v2.std.node.Symbol
}

type AffectedSetEvidence
  = AffectedSetReason { reason: v2.std.node.Symbol }
  | AffectedSetDiagnostics { diagnostics: v2.std.diagnostic.NonEmptyDiagnostics }

type AffectedSet
  = AffectedSetProduced {
      changes: ChangeSet,
      affected: std.types.List<AffectedDependency>,
      exclusions: std.types.List<AffectedExclusion>,
      restricted_to: std.types.List<v2.std.dependency.DependencyKind>
    }
  | AffectedSetFailClosed {
      changes: ChangeSet,
      evidence: AffectedSetEvidence
    }

type RecomputePlan {
  affected: AffectedSet
  layers: std.types.List<v2.std.dependency.ReadinessLayer<v2.std.node.Node>>
  diagnostic: v2.std.diagnostic.Outcome<v2.std.node.Symbol>
}
