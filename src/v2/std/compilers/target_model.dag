// NEGATIVE TRIPWIRE — do NOT add `import v2.std.runtime` (or any closure-widening import:
// machine, model_core) here. target_model's large generic-type closure trips a v2 bootstrap
// generic-instantiation bug — Optional<T> variant lookup fails (62 "variant Present/Absent not
// found in type Optional" across target_model + 06_value_expression). Reuse the runtime effect
// vocabulary by DISCRIMINANT SYMBOL instead (TargetValueExprEffectApply stores the
// EffectRequestKind discriminant); do the typed EffectRequestKind/Read|WriteResource decode at
// the small-closure 06_value_expression projection boundary. Reintroducing this edge is caught
// by ci_floor_emit + v2_lens witnesses (they went red on it; head eed2a7a). v2 fix is tracked
// separately (work-item adhoc-708ea66d-bb3) — this absence assertion stands until that lands.

type TargetModel {
  bundle: Node
  lex: LexRules
  binding_spellings: Map<Symbol, String>
  authority_source_text: String
  runtime_row: TargetEmitHostRuntimeRow
}
type TargetModelBundle = TargetModel

fn runtime_row_from_target(target: TargetModel) -> Outcome<EmitHostRuntimeRow> {
  configured_emit_host_runtime_row_from_target_row(row: target.runtime_row)
}

// #g-bidir Q-G2 — per-target C5 quotient: Conj of per-feature FidelityDisposition inhabitants.
// T-11: the typed ConcreteSyntaxToken coproduct below is the single concrete-syntax-token
// authority. Per-language `*ConcreteSyntaxToken` coproducts dissolve into this carrier
// (src/v2/extdeps/languages/*.dag), dag.dag's emit_fixed_token/emit_bound_token construct it,
// and 06_translate matches it structurally. The `concrete_syntax_token_kind_{fixed,bound}`
// Symbols persist only as the serialized wire-form tags written by `concrete_syntax_token_to_node`
// and read back by the translate-side decoder — they are no longer dispatch discriminators.

// T-11 shared concrete-syntax-token carrier (single authority, DESIGN.md §3).
// FixedToken: a terminal whose spelling is the token class' literal lexeme.
// BoundToken: a terminal whose spelling is resolved from a binding (e.g. an identifier site).
// 🟢 coproduct dissolution — terminal sum, no further dissolution. FixedToken and BoundToken are
// genuine one-at-a-time alternatives (a concrete-syntax terminal is either a fixed lexeme or a
// binding-resolved terminal, never both) and the bound arm carries a `binding` payload the fixed
// arm lacks — an irreducible sum, not compressed record coordinates (a genuine coproduct vs a
// record; DESIGN.md §2). Inherits the 🟢 classification the dissolved per-language
// *ConcreteSyntaxToken coproducts carried before this carrier consolidated them.
type ConcreteSyntaxToken
  = FixedToken { token_class: Symbol }
  | BoundToken { token_class: Symbol, binding: Symbol }

// Sole serialization morphism: typed token -> Conj wire node carrying the
// concrete_syntax_token_field_* edges and concrete_syntax_token_kind_* tags. Both the
// per-language grammar-row builders and dag.dag's self-emission project through this function,
// so the wire shape has exactly one author.
fn concrete_syntax_token_to_node(token: ConcreteSyntaxToken) -> Node {
  match token {
    FixedToken { token_class: c } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge {
            label: Named { name: ^concrete_syntax_token_field_kind },
            target: Node {
              kind: TypeNode { connective: Atom { identity: ^concrete_syntax_token_kind_fixed } },
              children: [],
              occurrence_id: SyntheticOccurrence
}
          },
          Edge {
            label: Named { name: ^concrete_syntax_token_field_class },
            target: Node {
              kind: TypeNode { connective: Atom { identity: c } },
              children: [],
              occurrence_id: SyntheticOccurrence
}
          }
        ],
        occurrence_id: SyntheticOccurrence
}
    BoundToken { token_class: c, binding: b } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge {
            label: Named { name: ^concrete_syntax_token_field_kind },
            target: Node {
              kind: TypeNode { connective: Atom { identity: ^concrete_syntax_token_kind_bound } },
              children: [],
              occurrence_id: SyntheticOccurrence
}
          },
          Edge {
            label: Named { name: ^concrete_syntax_token_field_class },
            target: Node {
              kind: TypeNode { connective: Atom { identity: c } },
              children: [],
              occurrence_id: SyntheticOccurrence
}
          },
          Edge {
            label: Named { name: ^concrete_syntax_token_field_binding },
            target: Node {
              kind: TypeNode { connective: Atom { identity: b } },
              children: [],
              occurrence_id: SyntheticOccurrence
}
          }
        ],
        occurrence_id: SyntheticOccurrence
}
  }
}

fn concrete_syntax_token_class(token: ConcreteSyntaxToken) -> Symbol {
  match token {
    FixedToken { token_class: c } => c
    BoundToken { token_class: c, binding: _ } => c
  }
}

// Per-target lex + binding-spelling lookup (tokens/layout authority for translate serialize).

fn target_lex_rule_literal_not_found_diagnostic(token_class: Symbol) -> Diagnostic {
  Diagnostic {
    reason: ^target_lex_rule_literal_not_found,
    at: node_locus(node: Node {
      kind: TypeNode { connective: Atom { identity: token_class } },
      children: [],
      occurrence_id: SyntheticOccurrence
    }),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_binding_spelling_not_found_diagnostic(binding: Symbol) -> Diagnostic {
  Diagnostic {
    reason: ^target_binding_spelling_not_found,
    at: node_locus(node: Node {
      kind: TypeNode { connective: Atom { identity: binding } },
      children: [],
      occurrence_id: SyntheticOccurrence
    }),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_concrete_token_kind_invalid_diagnostic(token: Node) -> Diagnostic {
  Diagnostic {
    reason: ^target_concrete_token_kind_invalid,
    at: node_locus(node: token),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_optional_named_child(root: Node, name: Symbol) -> Outcome<Optional<Node>> {
  match find_named_child(root: root, name: name) {
    Accepted { value: child, diagnostics: d } =>
      Accepted { value: optional_present(value: child), diagnostics: d }
    Rejected { diagnostics: _ } => outcome_accepted(optional_absent())
  }
}

fn target_node_atom_identity(node: Node) -> Outcome<Symbol> {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } => outcome_accepted(id)
    _ => outcome_rejected(target_concrete_token_kind_invalid_diagnostic(token: node))
  }
}

// Single Symbol -> typed-variant decode boundary for concrete syntax tokens (T-11).
fn concrete_syntax_token_from_node(token: Node) -> Outcome<ConcreteSyntaxToken> {
  bind_outcome(
    o: find_named_child(root: token, name: ^concrete_syntax_token_field_kind),
    f: fn(kind_node) {
      bind_outcome(
        o: target_node_atom_identity(node: kind_node),
        f: fn(kind) {
          bind_outcome(
            o: find_named_child(root: token, name: ^concrete_syntax_token_field_class),
            f: fn(class_node) {
              bind_outcome(
                o: target_node_atom_identity(node: class_node),
                f: fn(token_class) {
                  bind_outcome(
                    o: target_optional_named_child(
                      root: token,
                      name: ^concrete_syntax_token_field_binding
                    ),
                    f: fn(binding_node) {
                      if kind == ^concrete_syntax_token_kind_fixed {
                        match binding_node {
                          Present { value: _ } =>
                            outcome_rejected(
                              target_concrete_token_kind_invalid_diagnostic(token: token)
                            )
                          Absent =>
                            outcome_accepted(
                              FixedToken { token_class: token_class }
                            )
                        }
                      } else {
                        if kind == ^concrete_syntax_token_kind_bound {
                          match binding_node {
                            Present { value: binding_child } =>
                              bind_outcome(
                                o: target_node_atom_identity(node: binding_child),
                                f: fn(binding) {
                                  outcome_accepted(
                                    BoundToken {
                                      token_class: token_class,
                                      binding: binding
                                    }
                                  )
                                }
                              )
                            Absent =>
                              outcome_rejected(
                                target_concrete_token_kind_invalid_diagnostic(token: token)
                              )
                          }
                        } else {
                          outcome_rejected(
                            target_concrete_token_kind_invalid_diagnostic(token: token)
                          )
                        }
                      }
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn target_type_expr_projection_bundle_malformed_diagnostic(bundle: Node) -> Diagnostic {
  Diagnostic {
    reason: ^target_type_expr_projection_bundle_malformed,
    at: node_locus(node: bundle),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_collection_shape_malformed_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: ^target_collection_shape_malformed,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_lex_rule_literal_step(
  acc: Outcome<String>,
  rule: LexRule,
  token_class: Symbol
) -> Outcome<String> {
  match acc {
    Accepted { value: _, diagnostics: _ } => acc
    Rejected { diagnostics: _ } =>
      match rule {
        TokenRule { token_class: c, pattern: pattern } =>
          if c == token_class {
            match pattern {
              LiteralPattern { text: text } =>
                Accepted { value: text, diagnostics: None }
              KeywordPattern { text: text } =>
                Accepted { value: text, diagnostics: None }
              _ =>
                Rejected {
                  diagnostics: diagnostics_singleton(
                    d: target_lex_rule_literal_not_found_diagnostic(token_class: token_class)
                  )
                }
            }
          } else {
            acc
          }
        TriviaRule { pattern: _ } => acc
      }
  }
}

fn lex_rules_literal_for_class(rules: LexRules, token_class: Symbol) -> Outcome<String> {
  match rules {
    VoidLexRules =>
      outcome_rejected(
        target_lex_rule_literal_not_found_diagnostic(token_class: token_class)
      )
    ModeledLexRules { root: set } =>
      fold_list(
        xs: set.rules,
        empty: Rejected {
          diagnostics: diagnostics_singleton(
            d: target_lex_rule_literal_not_found_diagnostic(token_class: token_class)
          )
        },
        cons: fn(acc, rule) {
          target_lex_rule_literal_step(acc: acc, rule: rule, token_class: token_class)
        }
      )
  }
}

fn lex_rules_literal(target: TargetModel, token_class: Symbol) -> Outcome<String> {
  lex_rules_literal_for_class(rules: target.lex, token_class: token_class)
}

fn target_binding_spelling_lookup(
  target: TargetModel,
  binding: Symbol
) -> Outcome<String> {
  match map_get(target.binding_spellings, binding) {
    Accepted { value: opt, diagnostics: pending } => match opt {
      Present { value: spelling } => Accepted { value: spelling, diagnostics: pending }
      Absent =>
        Rejected {
          diagnostics: rejected_with_pending(
            pending: pending,
            rejected: diagnostics_singleton(
              d: target_binding_spelling_not_found_diagnostic(binding: binding)
            )
          )
        }
    }
    Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
  }
}

fn token_spelling_from_model(target: TargetModel, token: Node) -> Outcome<String> {
  bind_outcome(
    o: concrete_syntax_token_from_node(token: token),
    f: fn(decoded) {
      match decoded {
        FixedToken { token_class: token_class } =>
          lex_rules_literal_for_class(rules: target.lex, token_class: token_class)
        BoundToken { token_class: _, binding: binding } =>
          target_binding_spelling_lookup(target: target, binding: binding)
      }
    }
  )
}

fn serialize_type_expr_arrow_param_spelling(
  target: TargetModel,
  label: Symbol
) -> Outcome<String> {
  target_binding_spelling_lookup(target: target, binding: label)
}


// SG-1b function-boundary signature realization catalog (per-language; Param/Return sites only).

// --- SG-1 atom realization vocabulary (M6 coproduct carriers with variant payloads) ---

type SourceAtomValue
  = SourceAtomSymbol { identity: Symbol }
  | SourceAtomBool { value: Bool }
  | SourceAtomChar { codepoint: Char }
  // 🟡 gated — feature:source-atom-string-canonical-carrier — owner:Modeling DFS / std.algebra lane —
  // bind TS-ATOM-REALIZATION String bridge — dissolve-on: std.algebra exposes a canonical
  // `String = FreeMonoid<Char>` value/projection carrier that target realization can name
  // directly; replace this encoded `Node` payload with that carrier and delete the paired
  // encoded-node projection below. forbidden: treating raw `Node` as the permanent string value
  // carrier or adding another string/FreeMonoid raw-node bridge outside this receipt.
  | SourceAtomString { value: Node }

// 🟢 coproduct dissolution — T6 value-expression Behavior arm-shape axis; BindingRef and
// PrimitiveApply are genuine one-at-a-time alternatives keyed to ComputationNode behavior forms.
// EffectApply is the emit-side projection of an applied v2.std.runtime EffectRequest (it
// attaches to the existing runtime EffectRequestKind concept — no parallel emit effect vocabulary).
// The carrier stores the effect kind as its discriminant Symbol; the typed runtime reuse
// (EffectRequestKind ↔ discriminant, ReadResource|WriteResource) lives at the value-expression
// projection boundary where effects are lowered, keeping this structural substrate import-free.
type TargetValueExpressionKind
  = TargetValueExprSymbolIdentity
  | TargetValueExprSymbolToOwnedString
  | TargetValueExprBoolLiteral
  | TargetValueExprCharUnicodeScalar
  | TargetValueExprStringLiteral
  | TargetValueExprReferenceRcNew
  | TargetValueExprReferenceBoxNew
  | TargetValueExprBindingRef
  | TargetValueExprPrimitiveApply
  | TargetValueExprEffectApply
  // Lane 2c — value-level function application `callee(arg, ...)` (positional). The head of a
  // Transform body that does NOT canonicalize to an operator is a callee reference (eval treats a
  // Transform with a non-operator Atom/Arrow head as a call, 05_eval eval_node_is_callee_reference);
  // args are arbitrary value-expressions, so a closure argument recurses through the same projector.
  | TargetValueExprCallableApply
  // Lane 2c — anonymous function value `fn(params) { body }`. Appears as an argument to a callable
  // apply (the fold-family `cons`/`f`/`step` closures); the body recurses through the value-expr
  // projector with the closure's own param domain as scope (nested-closure scoping).
  | TargetValueExprClosure
  | TargetValueExprConditional
  | TargetValueExprBindLet
  | TargetValueExprLoop
  | TargetValueExprRecordConstruct
  | TargetValueExprFieldAccess
  | TargetValueExprMatch

type TargetValueExpression {
  kind: TargetValueExpressionKind
  node: Node
}

// Bidirectional templates: emission and ingestion share the same row (§10.6).
// 🟢 coproduct dissolution — T6 value-expression ingestion twin axis; each arm pairs with
// its TargetValueExpressionKind emission counterpart on the shared template row.
type TargetValueTemplateKind
  = ValueSymbolIdentityPassthrough
  | ValueSymbolToOwnedString
  | ValueBoolLiteral
  | ValueCharUnicodeScalar
  | ValueStringLiteral
  | ValueBindingRef
  | ValuePrimitiveApply
  | ValueEffectApply
  | ValueConditional
  | ValueBindLet
  | ValueLoop
  | ValueRecordConstruct
  | ValueFieldAccess
  | ValueMatch

type TargetValueTemplate {
  kind: TargetValueTemplateKind
  node: Node
}

// T6 — closed canonical operation vocabulary (substrate-owned; arms land with producers).
// Q-V1 (design-value-emit-schema.md §7): each arm carries its algebra-field witness.
type CanonicalOperation
  = OpAdd { algebra_field: Symbol }

fn canonical_operation_op_add() -> CanonicalOperation {
  OpAdd { algebra_field: ^ring_field_add }
}

// T6 — per-language operator spelling shape axis.
// 🟢 coproduct dissolution — InfixToken, PrefixToken, CallIdent, and MethodIdent are genuine
// one-at-a-time alternatives for how a canonical operation is realized on a target surface; each
// arm carries a distinct spelling payload and none reduces to record coordinates.
type TargetOperatorShape
  = InfixToken { token: Symbol }
  | PrefixToken { token: Symbol }
  | CallIdent { ident: Symbol }
  | MethodIdent { ident: Symbol }

type TargetOperatorRealization {
  operation: CanonicalOperation
  shape: TargetOperatorShape
}

// T6 — per-language value-expression projection row (mirrors TargetTypeExpressionProjection).
type TargetBindingRefShape {
  ident_token: Symbol
}

type TargetPrimitiveApplyShape {
  open: Symbol
  close: Symbol
  separator: Symbol
}

type TargetCallApplyShape {
  callee_ident_token: Symbol
  open: Symbol
  separator: Symbol
  close: Symbol
}

// T6 — per-language applied-effect projection. The emit arm selects the host shim callee by the
// carrier's stored effect-kind discriminant Symbol — which equals `^ReadResource` / `^WriteResource`
// by identity (`discriminant(v: ReadResource {}) == ^ReadResource`, proven; same dispatch idiom as
// the canonical-operation `id == discriminant(v: OpAdd {})` at the catalog lookup below).
//
// One descriptor catalog row: an effect-kind discriminant Symbol bound to the host shim callee
// token that realizes that effect. Mirrors a `target_operator_realization` row — the catalog,
// not a shape field, is the per-effect authority, so a new EffectRequestKind variant extends the
// projection by exactly ONE row (Cost-of-Change = 1), never a new shape field or callee branch.
type TargetEffectCalleeRow {
  effect_kind: Symbol
  callee: Symbol
}

// `callees` is a data catalog of `TargetEffectCalleeRow` (effect-kind discriminant -> host shim
// callee token), mirroring `target_operator_realizations_catalog`. The emit arm resolves a
// carrier's stored discriminant (`^ReadResource` / `^WriteResource` by identity) by folding the
// catalog rows into a `Map<Symbol, Symbol>` and taking ONE fail-closed `map_get` — a miss is
// rejected, never silently emitted (anti-cement gunbc#4623: the stage hard-codes no per-effect
// callee). The catalog is a `List` (not an in-memory `Map`) so it round-trips through the wire
// projection bundle, which a closure-backed `Map` cannot. Operand binding refs are framed exactly
// like a primitive `CallIdent` apply (open / separator / close).
type TargetEffectApplyShape {
  callees: List<TargetEffectCalleeRow>
  open: Symbol
  close: Symbol
  separator: Symbol
}

// Lane 2c — per-language anonymous-function spelling. `fn ( p, ... ) { body }` for .dag; a target
// whose closures read `(p, ...) => body` supplies the same single-token framing fields with its own
// token classes. param_ident_token spells each param binding (via binding_spellings, like a
// binding-ref). Single-token fields keep the wire bundle flat (no token-list round-trip).
type TargetClosureShape {
  fn_token: Symbol
  open: Symbol
  separator: Symbol
  close: Symbol
  body_open: Symbol
  body_close: Symbol
  param_ident_token: Symbol
}

type TargetConditionalShape {
  if_token: Symbol
  then_token: Symbol
  else_token: Symbol
}

type TargetBindLetShape {
  let_token: Symbol
  assign_token: Symbol
  in_token: Symbol
}

type TargetLoopShape {
  loop_token: Symbol
}

type TargetRecordConstructShape {
  open: Symbol
  close: Symbol
  separator: Symbol
  assign: Symbol
}

type TargetFieldAccessShape {
  dot: Symbol
}

type TargetMatchShape {
  match_token: Symbol
  open: Symbol
  close: Symbol
  fat_arrow: Symbol
  arm_separator: Symbol
}

type TargetValueExpressionProjection {
  binding_ref_form: TargetBindingRefShape
  primitive_apply_form: TargetPrimitiveApplyShape
  callable_apply_form: TargetCallApplyShape
  closure_form: TargetClosureShape
  effect_apply_form: TargetEffectApplyShape
  conditional_form: TargetConditionalShape
  let_form: TargetBindLetShape
  loop_form: TargetLoopShape
  record_construct_form: TargetRecordConstructShape
  field_access_form: TargetFieldAccessShape
  match_form: TargetMatchShape
}

// T6 — per-language bodied-arrow statement scaffold (prefix/suffix around dynamic body tokens).
type TargetBodiedArrowStatementScaffold {
  prefix: List<ConcreteSyntaxToken>
  suffix: List<ConcreteSyntaxToken>
}




fn target_model_type_atom_node(identity: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: identity } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn target_model_type_conj_node(children: List<Edge>) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: children,
    occurrence_id: SyntheticOccurrence
  }
}

fn target_canonical_operation_wire_malformed_diagnostic(wire: Node) -> Diagnostic {
  Diagnostic {
    reason: ^target_canonical_operation_wire_malformed,
    at: node_locus(node: wire),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_model_canonical_operation_algebra_field_from_wire(wire: Node) -> Optional<Symbol> {
  match fold(
    wire.children,
    init: optional_absent(),
    f: fn(acc, edge) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match edge.label {
            Named { name: n } =>
              if n == ^target_canonical_operation_field_algebra_field {
                match edge.target.kind {
                  TypeNode { connective: Atom { identity: id } } =>
                    optional_present(value: id)
                  _ => acc
                }
              } else {
                acc
              }
            Positional => acc
          }
      }
    }
  ) {
    Present { value: field } => optional_present(value: field)
    Absent => optional_absent()
  }
}

fn target_model_canonical_operation_wire_node(operation: CanonicalOperation) -> Node {
  match operation {
    OpAdd { algebra_field: f } =>
      Node {
        kind: TypeNode { connective: Atom { identity: discriminant(v: OpAdd {}) } },
        children: [
          target_model_named_edge(
            name: ^target_canonical_operation_field_algebra_field,
            target: target_model_type_atom_node(identity: f)
          )
        ],
        occurrence_id: SyntheticOccurrence
      }
  }
}

fn canonical_operation_equal(
  left: CanonicalOperation,
  right: CanonicalOperation
) -> Bool {
  match left {
    OpAdd { algebra_field: lf } =>
      match right {
        OpAdd { algebra_field: rf } => lf == rf
      }
  }
}

fn canonical_operation_from_wire_node(wire: Node) -> Outcome<CanonicalOperation> {
  match wire.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id == discriminant(v: OpAdd {}) {
        match target_model_canonical_operation_algebra_field_from_wire(wire: wire) {
          Present { value: algebra_field } =>
            outcome_accepted(OpAdd { algebra_field: algebra_field })
          Absent =>
            outcome_rejected(
              target_canonical_operation_wire_malformed_diagnostic(wire: wire)
            )
        }
      } else {
        outcome_rejected(
          target_canonical_operation_wire_malformed_diagnostic(wire: wire)
        )
      }
    _ =>
      outcome_rejected(
        target_canonical_operation_wire_malformed_diagnostic(wire: wire)
      )
  }
}

// 🟡 gated — predicate-dissolution interim —
// feature:canonical-operation-wire-decode-bool — consumer:target_operator_realization_row_matches_canonical_op
// — bind: operator-catalog row operation wire match — owner: T6 value-expression (lively-badger-242) —
// lane: std/compilers/target_model — dissolve-on-arrival: Outcome-bearing wire decode propagates diagnostics
// in catalog lookup; forbidden: Rejected => false silent swallow in substrate Bool matchers.
fn canonical_operation_wire_matches_operation(
  wire: Node,
  operation: CanonicalOperation
) -> Bool {
  match canonical_operation_from_wire_node(wire: wire) {
    Accepted { value: decoded, diagnostics: _ } =>
      canonical_operation_equal(left: decoded, right: operation)
    Rejected { diagnostics: _ } => false
  }
}

fn target_model_operator_shape_wire_node(shape: TargetOperatorShape) -> Node {
  match shape {
    InfixToken { token: t } =>
      Node {
        kind: TypeNode { connective: Atom { identity: discriminant(v: InfixToken {}) } },
        children: [
          target_model_named_edge(
            name: ^target_operator_shape_field_token,
            target: target_model_type_atom_node(identity: t)
          )
        ],
        occurrence_id: SyntheticOccurrence
      }
    PrefixToken { token: t } =>
      Node {
        kind: TypeNode { connective: Atom { identity: discriminant(v: PrefixToken {}) } },
        children: [
          target_model_named_edge(
            name: ^target_operator_shape_field_token,
            target: target_model_type_atom_node(identity: t)
          )
        ],
        occurrence_id: SyntheticOccurrence
      }
    CallIdent { ident: i } =>
      Node {
        kind: TypeNode { connective: Atom { identity: discriminant(v: CallIdent {}) } },
        children: [
          target_model_named_edge(
            name: ^target_operator_shape_field_token,
            target: target_model_type_atom_node(identity: i)
          )
        ],
        occurrence_id: SyntheticOccurrence
      }
    MethodIdent { ident: i } =>
      Node {
        kind: TypeNode { connective: Atom { identity: discriminant(v: MethodIdent {}) } },
        children: [
          target_model_named_edge(
            name: ^target_operator_shape_field_token,
            target: target_model_type_atom_node(identity: i)
          )
        ],
        occurrence_id: SyntheticOccurrence
      }
  }
}

fn target_operator_shape_wire_malformed_diagnostic(wire: Node) -> Diagnostic {
  Diagnostic {
    reason: ^target_operator_shape_wire_malformed,
    at: node_locus(node: wire),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_operator_shape_wire_schema_valid(wire: Node) -> Outcome<Bool> {
  match wire.kind {
    TypeNode { connective: Atom { identity: _ } } =>
      if name_occurrences(
        name: ^target_operator_shape_field_token,
        children: wire.children
      ) != 1 {
        outcome_rejected(target_operator_shape_wire_malformed_diagnostic(wire: wire))
      } else {
        match fold(
          wire.children,
          init: true,
          f: fn(acc, edge) {
            if acc {
              match edge.label {
                Named { name: n } => n == ^target_operator_shape_field_token
                Positional => false
              }
            } else {
              false
            }
          }
        ) {
          true => outcome_accepted(true)
          false =>
            outcome_rejected(target_operator_shape_wire_malformed_diagnostic(wire: wire))
        }
      }
    _ =>
      outcome_rejected(target_operator_shape_wire_malformed_diagnostic(wire: wire))
  }
}

fn target_operator_shape_token_from_wire(wire: Node) -> Outcome<Symbol> {
  match fold(
    wire.children,
    init: optional_absent(),
    f: fn(acc, edge) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match edge.label {
            Named { name: n } =>
              if n == ^target_operator_shape_field_token {
                match edge.target.kind {
                  TypeNode { connective: Atom { identity: token } } =>
                    optional_present(value: token)
                  _ => acc
                }
              } else {
                acc
              }
            Positional => acc
          }
      }
    }
  ) {
    Present { value: token } => outcome_accepted(token)
    Absent =>
      outcome_rejected(target_operator_shape_wire_malformed_diagnostic(wire: wire))
  }
}

fn target_operator_shape_from_wire_node(wire: Node) -> Outcome<TargetOperatorShape> {
  bind_outcome(
    o: target_operator_shape_wire_schema_valid(wire: wire),
    f: fn(_) {
      match wire.kind {
        TypeNode { connective: Atom { identity: id } } =>
          bind_outcome(
            o: target_operator_shape_token_from_wire(wire: wire),
            f: fn(token) {
              if id == discriminant(v: InfixToken {}) {
                outcome_accepted(InfixToken { token: token })
              } else if id == discriminant(v: PrefixToken {}) {
                outcome_accepted(PrefixToken { token: token })
              } else if id == discriminant(v: CallIdent {}) {
                outcome_accepted(CallIdent { ident: token })
              } else if id == discriminant(v: MethodIdent {}) {
                outcome_accepted(MethodIdent { ident: token })
              } else {
                outcome_rejected(
                  target_operator_shape_wire_malformed_diagnostic(wire: wire)
                )
              }
            }
          )
        _ =>
          outcome_rejected(target_operator_shape_wire_malformed_diagnostic(wire: wire))
      }
    }
  )
}

fn target_operator_realization_wire_malformed_diagnostic(row: Node) -> Diagnostic {
  Diagnostic {
    reason: ^target_operator_realization_wire_malformed,
    at: node_locus(node: row),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_operator_realization_row_wire_schema_valid(row: Node) -> Outcome<Bool> {
  match row.kind {
    TypeNode { connective: Conj } =>
      if name_occurrences(
        name: ^target_operator_realization_field_operation,
        children: row.children
      ) != 1 {
        outcome_rejected(target_operator_realization_wire_malformed_diagnostic(row: row))
      } else if name_occurrences(
        name: ^target_operator_realization_field_shape,
        children: row.children
      ) != 1 {
        outcome_rejected(target_operator_realization_wire_malformed_diagnostic(row: row))
      } else {
        match fold(
          row.children,
          init: true,
          f: fn(acc, edge) {
            if acc {
              match edge.label {
                Named { name: n } =>
                  n == ^target_operator_realization_field_operation
                  || n == ^target_operator_realization_field_shape
                Positional => false
              }
            } else {
              false
            }
          }
        ) {
          true => outcome_accepted(true)
          false =>
            outcome_rejected(target_operator_realization_wire_malformed_diagnostic(row: row))
        }
      }
    _ =>
      outcome_rejected(target_operator_realization_wire_malformed_diagnostic(row: row))
  }
}

fn target_operator_realization_from_wire_row(row: Node) -> Outcome<TargetOperatorRealization> {
  bind_outcome(
    o: target_operator_realization_row_wire_schema_valid(row: row),
    f: fn(_) {
      bind_outcome(
        o: find_named_child(root: row, name: ^target_operator_realization_field_operation),
        f: fn(operation_wire) {
          bind_outcome(
            o: canonical_operation_from_wire_node(wire: operation_wire),
            f: fn(canonical_op) {
              bind_outcome(
                o: find_named_child(root: row, name: ^target_operator_realization_field_shape),
                f: fn(shape_wire) {
                  bind_outcome(
                    o: target_operator_shape_from_wire_node(wire: shape_wire),
                    f: fn(shape) {
                      outcome_accepted(
                        TargetOperatorRealization {
                          operation: canonical_op,
                          shape: shape
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn target_operator_realization_node(
  operation: CanonicalOperation,
  shape: TargetOperatorShape
) -> Node {
  target_model_type_conj_node(
    children: [
      target_model_named_edge(
        name: ^target_operator_realization_field_operation,
        target: target_model_canonical_operation_wire_node(operation: operation)
      ),
      target_model_named_edge(
        name: ^target_operator_realization_field_shape,
        target: target_model_operator_shape_wire_node(shape: shape)
      )
    ]
  )
}


fn target_operator_realizations_catalog_node(rows: List<Node>) -> Node {
  target_model_type_conj_node(
    children: fold_list(
      xs: rows,
      empty: Empty,
      cons: fn(acc, row) {
        Cons {
          head: target_model_named_edge(
            name: ^target_operator_realization_row_edge,
            target: row
          ),
          tail: acc
        }
      }
    )
  )
}

