type TargetValueExprFieldInitSlot {
  label: v2.std.node.Symbol
  value: v2.std.compilers.target_model.TargetValueExpression
}

fn target_value_expr_field_init_slot_edges(slots: v2.std.collection.List<v2.std.compilers.target_model.TargetValueExprFieldInitSlot>) -> v2.std.collection.List<v2.std.node.Edge> {
  fold(slots, init: std.algebra.Empty, f: fn(acc, slot) {
    list_snoc_item(
      xs: acc,
      item: target_model_named_edge(name: slot.label, target: slot.value.node)
    )
  })
}

fn target_value_expression_record_construct(
  type_name: v2.std.node.Symbol,
  fields: v2.std.collection.List<v2.std.compilers.target_model.TargetValueExprFieldInitSlot>
) -> v2.std.compilers.target_model.TargetValueExpression {
  TargetValueExpression {
    kind: TargetValueExprRecordConstruct,
    node: v2.std.node.Node {
      kind: v2.std.node.TypeNode {
        connective: v2.std.node.Atom { identity: ^target_value_expression_record_construct_atom }
      },
      children: list_append(
        left: [
          target_model_named_edge(
            name: ^target_value_expr_field_record_type,
            target: v2.std.node.Node {
              kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: type_name } },
              children: [],
              occurrence_id: SyntheticOccurrence
            }
          )
        ],
        right: target_value_expr_field_init_slot_edges(slots: fields)
      ),
      occurrence_id: SyntheticOccurrence
    }
  }
}

fn target_value_expression_field_access(
  base: v2.std.compilers.target_model.TargetValueExpression,
  field_name: v2.std.node.Symbol
) -> v2.std.compilers.target_model.TargetValueExpression {
  TargetValueExpression {
    kind: TargetValueExprFieldAccess,
    node: v2.std.node.Node {
      kind: v2.std.node.TypeNode {
        connective: v2.std.node.Atom { identity: ^target_value_expression_field_access_atom }
      },
      children: [
        target_model_named_edge(
          name: ^target_value_expr_field_field_access_base,
          target: base.node
        ),
        target_model_named_edge(
          name: ^target_value_expr_field_field_access_field,
          target: v2.std.node.Node {
            kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: field_name } },
            children: [],
            occurrence_id: SyntheticOccurrence
          }
        )
      ],
      occurrence_id: SyntheticOccurrence
    }
  }
}

type TargetValueExprMatchArmSlot {
  pattern: v2.std.compilers.target_model.TargetValueExpression
  body: v2.std.compilers.target_model.TargetValueExpression
}

type TargetValueExprMatchArmEdgeFold {
  edges: v2.std.collection.List<v2.std.node.Edge>
  skipped_scrutinee: Bool
}

fn target_value_expr_positional_child_optional(node: v2.std.node.Node, index: Int) -> v2.std.optional.Optional<v2.std.node.Node> {
  list_at_optional(xs: node_positional_child_targets(node: node), index: index)
}

fn target_value_expr_match_arm_edges_after_scrutinee(children: v2.std.collection.List<v2.std.node.Edge>) -> v2.std.collection.List<v2.std.node.Edge> {
  let folded = fold(
    children,
    init: v2.std.compilers.target_model.TargetValueExprMatchArmEdgeFold { edges: std.algebra.Empty, skipped_scrutinee: false },
    f: fn(acc, edge) {
      match edge.label {
        Positional =>
          if !acc.skipped_scrutinee {
            TargetValueExprMatchArmEdgeFold {
              edges: acc.edges,
              skipped_scrutinee: true
            }
          } else {
            TargetValueExprMatchArmEdgeFold {
              edges: list_snoc_item(xs: acc.edges, item: edge),
              skipped_scrutinee: true
            }
          }
        Named { name: _ } => acc
      }
    }
  )
  folded.edges
}

fn target_value_expr_match_arm_wire(arm: v2.std.compilers.target_model.TargetValueExprMatchArmSlot) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      target_model_named_edge(name: match_arm_pattern, target: arm.pattern.node),
      target_model_named_edge(name: match_arm_body, target: arm.body.node)
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn target_value_expr_match_arm_edges(arms: v2.std.collection.List<v2.std.compilers.target_model.TargetValueExprMatchArmSlot>) -> v2.std.collection.List<v2.std.node.Edge> {
  fold(arms, init: std.algebra.Empty, f: fn(acc, arm) {
    list_snoc_item(xs: acc, item: v2.std.node.Edge { label: Positional, target: target_value_expr_match_arm_wire(arm: arm) })
  })
}

fn target_value_expression_match(
  scrutinee: v2.std.compilers.target_model.TargetValueExpression,
  arms: v2.std.collection.List<v2.std.compilers.target_model.TargetValueExprMatchArmSlot>
) -> v2.std.compilers.target_model.TargetValueExpression {
  TargetValueExpression {
    kind: TargetValueExprMatch,
    node: v2.std.node.Node {
      kind: v2.std.node.TypeNode {
        connective: v2.std.node.Atom { identity: ^target_value_expression_match_atom }
      },
      children: list_append(
        left: [
          target_model_named_edge(
            name: ^target_value_expr_field_match_scrutinee,
            target: scrutinee.node
          )
        ],
        right: target_value_expr_match_arm_edges(arms: arms)
      ),
      occurrence_id: SyntheticOccurrence
    }
  }
}

fn target_value_expr_callable_arg_edges(
  args: v2.std.collection.List<v2.std.compilers.target_model.TargetValueExpression>
) -> v2.std.collection.List<v2.std.node.Edge> {
  fold_list_right(
    xs: args,
    empty: std.algebra.Empty,
    snoc: fn(acc, arg) {
      std.algebra.Cons {
        head: target_model_named_edge(
          name: ^target_value_expr_field_callable_arg,
          target: target_value_expression_node(expr: arg)
        ),
        tail: acc
      }
    }
  )
}

fn target_value_expression_callable_apply(
  callee: v2.std.node.Symbol,
  args: v2.std.collection.List<v2.std.compilers.target_model.TargetValueExpression>
) -> v2.std.compilers.target_model.TargetValueExpression {
  TargetValueExpression {
    kind: TargetValueExprCallableApply,
    node: v2.std.node.Node {
      kind: v2.std.node.TypeNode {
        connective: v2.std.node.Atom { identity: ^target_value_expression_callable_apply_atom }
      },
      children: list_append(
        left: [
          target_model_named_edge(
            name: ^target_value_expr_field_callee,
            target: target_model_type_atom_node(identity: callee)
          )
        ],
        right: target_value_expr_callable_arg_edges(args: args)
      ),
      occurrence_id: SyntheticOccurrence
    }
  }
}

fn target_value_expr_closure_param_edges(params: v2.std.collection.List<v2.std.node.Symbol>) -> v2.std.collection.List<v2.std.node.Edge> {
  fold_list_right(
    xs: params,
    empty: std.algebra.Empty,
    snoc: fn(acc, param) {
      std.algebra.Cons {
        head: target_model_named_edge(
          name: ^target_value_expr_field_closure_param,
          target: target_model_type_atom_node(identity: param)
        ),
        tail: acc
      }
    }
  )
}

fn target_value_expression_closure(
  params: v2.std.collection.List<v2.std.node.Symbol>,
  body: v2.std.compilers.target_model.TargetValueExpression
) -> v2.std.compilers.target_model.TargetValueExpression {
  TargetValueExpression {
    kind: TargetValueExprClosure,
    node: v2.std.node.Node {
      kind: v2.std.node.TypeNode {
        connective: v2.std.node.Atom { identity: ^target_value_expression_closure_atom }
      },
      children: list_append(
        left: target_value_expr_closure_param_edges(params: params),
        right: [
          target_model_named_edge(
            name: ^target_value_expr_field_closure_body,
            target: body.node
          )
        ]
      ),
      occurrence_id: SyntheticOccurrence
    }
  }
}

fn target_value_expression_emit_unsupported_kind_diagnostic(expr: v2.std.compilers.target_model.TargetValueExpression) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_value_expression_emit_unsupported_kind,
    at: node_locus(node: expr.node),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_value_expression_emit_operator_shape_unsupported_diagnostic(expr: v2.std.compilers.target_model.TargetValueExpression) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_value_expression_emit_operator_shape_unsupported,
    at: node_locus(node: expr.node),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_value_expression_emit_primitive_apply_arity_invalid_diagnostic(expr: v2.std.compilers.target_model.TargetValueExpression) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_value_expression_emit_primitive_apply_arity_invalid,
    at: node_locus(node: expr.node),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_operator_realization_catalog_miss_diagnostic(catalog: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_operator_realization_catalog_miss,
    at: node_locus(node: catalog),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_operator_realization_catalog_ambiguous_diagnostic(catalog: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_operator_realization_catalog_ambiguous,
    at: node_locus(node: catalog),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_operator_realization_row_matches_canonical_op(
  row: v2.std.node.Node,
  canonical_op: v2.std.compilers.target_model.CanonicalOperation
) -> Bool {
  match find_named_child(root: row, name: ^target_operator_realization_field_operation) {
    Accepted { value: operation_wire, diagnostics: _ } =>
      canonical_operation_wire_matches_operation(
        wire: operation_wire,
        operation: canonical_op
      )
    Rejected { diagnostics: _ } => false
  }
}

fn target_operator_realization_catalog_wire_schema_valid(catalog: v2.std.node.Node) -> v2.std.diagnostic.Outcome<Bool> {
  match catalog.kind {
    TypeNode { connective: Conj } =>
      match fold(
        catalog.children,
        init: true,
        f: fn(acc, e) {
          if acc {
            match e.label {
              Positional => false
              Named { name: n } => n == ^target_operator_realization_row_edge
            }
          } else {
            false
          }
        }
      ) {
        true => outcome_accepted(true)
        false =>
          outcome_rejected(
            target_operator_realization_catalog_miss_diagnostic(catalog: catalog)
          )
      }
    _ =>
      outcome_rejected(
        target_operator_realization_catalog_miss_diagnostic(catalog: catalog)
      )
  }
}

fn target_operator_realization_catalog_lookup_step(
  acc: v2.std.passing_candidate_fold.PassingCandidateFold<v2.std.node.Node>,
  row_node: v2.std.node.Node,
  canonical_op: v2.std.compilers.target_model.CanonicalOperation
) -> v2.std.passing_candidate_fold.PassingCandidateFold<v2.std.node.Node> {
  match target_operator_realization_row_wire_schema_valid(row: row_node) {
    Accepted { value: _, diagnostics: _ } =>
      if target_operator_realization_row_matches_canonical_op(
        row: row_node,
        canonical_op: canonical_op
      ) {
        match acc {
          v2.std.passing_candidate_fold.NoPassingCandidate => v2.std.passing_candidate_fold.OnePassingCandidate { candidate: row_node }
          OnePassingCandidate { candidate: _ } => v2.std.passing_candidate_fold.ManyPassingCandidates
          v2.std.passing_candidate_fold.ManyPassingCandidates => v2.std.passing_candidate_fold.ManyPassingCandidates
        }
      } else {
        acc
      }
    Rejected { diagnostics: _ } => acc
  }
}

fn target_operator_realization_catalog_lookup(
  catalog: v2.std.node.Node,
  canonical_op: v2.std.compilers.target_model.CanonicalOperation
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetOperatorRealization> {
  bind_outcome(
    o: target_operator_realization_catalog_wire_schema_valid(catalog: catalog),
    f: fn(_) {
      match catalog.kind {
        TypeNode { connective: Conj } =>
          match fold(
            catalog.children,
            init: v2.std.passing_candidate_fold.NoPassingCandidate,
            f: fn(acc, e) {
              match e.label {
                Named { name: n } =>
                  if n == ^target_operator_realization_row_edge {
                    target_operator_realization_catalog_lookup_step(
                      acc: acc,
                      row_node: e.target,
                      canonical_op: canonical_op
                    )
                  } else {
                    acc
                  }
                Positional => acc
              }
            }
          ) {
            v2.std.passing_candidate_fold.NoPassingCandidate =>
              outcome_rejected(
                target_operator_realization_catalog_miss_diagnostic(catalog: catalog)
              )
            OnePassingCandidate { candidate: row_node } =>
              target_operator_realization_from_wire_row(row: row_node)
            v2.std.passing_candidate_fold.ManyPassingCandidates =>
              outcome_rejected(
                target_operator_realization_catalog_ambiguous_diagnostic(catalog: catalog)
              )
          }
        _ =>
          outcome_rejected(
            target_operator_realization_catalog_miss_diagnostic(catalog: catalog)
          )
      }
    }
  )
}

fn target_value_expr_primitive_apply_operation_from_wire(wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.CanonicalOperation> {
  match fold(
    wire.children,
    init: optional_absent(),
    f: fn(acc, e) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match e.label {
            Named { name: n } =>
              if n == ^target_value_expr_field_operation {
                match canonical_operation_from_wire_node(wire: e.target) {
                  Accepted { value: canonical_op, diagnostics: _ } =>
                    optional_present(value: canonical_op)
                  Rejected { diagnostics: _ } => acc
                }
              } else {
                acc
              }
            Positional => acc
          }
      }
    }
  ) {
    Present { value: canonical_op } => outcome_accepted(canonical_op)
    Absent =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

fn target_value_expression_binding_ref_token(
  binding: v2.std.node.Symbol,
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection
) -> v2.std.compilers.target_model.ConcreteSyntaxToken {
  BoundToken {
    token_class: projection.binding_ref_form.ident_token,
    binding: binding
  }
}

fn target_value_expression_binding_refs_intersperse_separator(
  bindings: v2.std.collection.List<v2.std.node.Symbol>,
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection,
  separator: v2.std.node.Symbol
) -> v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  fold_list_right(
    xs: bindings,
    empty: std.algebra.Empty,
    snoc: fn(acc, binding) {
      let token = target_value_expression_binding_ref_token(
        binding: binding,
        projection: projection
      )
      match acc {
        Empty => std.algebra.Cons { head: token, tail: std.algebra.Empty }
        _ =>
          std.algebra.Cons {
            head: token,
            tail: std.algebra.Cons {
              head: FixedToken { token_class: separator },
              tail: acc
            }
          }
      }
    }
  )
}

fn target_operator_shape_emit_primitive_apply_tokens(
  shape: v2.std.compilers.target_model.TargetOperatorShape,
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection,
  bindings: v2.std.collection.List<v2.std.node.Symbol>,
  expr: v2.std.compilers.target_model.TargetValueExpression
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  match shape {
    InfixToken { token: op_token } =>
      if length(xs: bindings) != 2 {
        outcome_rejected(
          target_value_expression_emit_primitive_apply_arity_invalid_diagnostic(expr: expr)
        )
      } else {
        match list_at_optional(xs: bindings, index: 0) {
          Absent =>
            outcome_rejected(
              target_value_expression_emit_primitive_apply_arity_invalid_diagnostic(expr: expr)
            )
          Present { value: left_binding } =>
            match list_at_optional(xs: bindings, index: 1) {
              Absent =>
                outcome_rejected(
                  target_value_expression_emit_primitive_apply_arity_invalid_diagnostic(expr: expr)
                )
              Present { value: right_binding } =>
                outcome_accepted(
                  std.algebra.Cons {
                    head: target_value_expression_binding_ref_token(
                      binding: left_binding,
                      projection: projection
                    ),
                    tail: std.algebra.Cons {
                      head: FixedToken { token_class: op_token },
                      tail: std.algebra.Cons {
                        head: target_value_expression_binding_ref_token(
                          binding: right_binding,
                          projection: projection
                        ),
                        tail: std.algebra.Empty
                      }
                    }
                  }
                )
            }
        }
      }
    PrefixToken { token: op_token } =>
      if length(xs: bindings) != 1 {
        outcome_rejected(
          target_value_expression_emit_primitive_apply_arity_invalid_diagnostic(expr: expr)
        )
      } else {
        match list_at_optional(xs: bindings, index: 0) {
          Absent =>
            outcome_rejected(
              target_value_expression_emit_primitive_apply_arity_invalid_diagnostic(expr: expr)
            )
          Present { value: binding } =>
            outcome_accepted(
              std.algebra.Cons {
                head: FixedToken { token_class: op_token },
                tail: std.algebra.Cons {
                  head: target_value_expression_binding_ref_token(
                    binding: binding,
                    projection: projection
                  ),
                  tail: std.algebra.Empty
                }
              }
            )
        }
      }
    CallIdent { ident: callee } =>
      outcome_accepted(
        list_append(
          left: list_append(
            left: std.algebra.Cons {
              head: FixedToken { token_class: projection.primitive_apply_form.open },
              tail: std.algebra.Cons {
                head: FixedToken { token_class: callee },
                tail: std.algebra.Empty
              }
            },
            right: target_value_expression_binding_refs_intersperse_separator(
              bindings: bindings,
              projection: projection,
              separator: projection.primitive_apply_form.separator
            )
          ),
          right: std.algebra.Cons {
            head: FixedToken { token_class: projection.primitive_apply_form.close },
            tail: std.algebra.Empty
          }
        )
      )
    MethodIdent { ident: _ } =>
      outcome_rejected(
        target_value_expression_emit_operator_shape_unsupported_diagnostic(expr: expr)
      )
  }
}

fn target_value_expression_primitive_apply_to_concrete_tokens(
  expr: v2.std.compilers.target_model.TargetValueExpression,
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection,
  catalog: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  bind_outcome(
    o: target_value_expr_primitive_apply_wire_schema_valid(wire: expr.node),
    f: fn(_) {
      bind_outcome(
        o: target_value_expr_primitive_apply_operation_from_wire(wire: expr.node),
        f: fn(canonical_op) {
          bind_outcome(
            o: target_value_expr_primitive_apply_operand_bindings(wire: expr.node),
            f: fn(bindings) {
              bind_outcome(
                o: target_operator_realization_catalog_lookup(
                  catalog: catalog,
                  canonical_op: canonical_op
                ),
                f: fn(operator_row) {
                  target_operator_shape_emit_primitive_apply_tokens(
                    shape: operator_row.shape,
                    projection: projection,
                    bindings: bindings,
                    expr: expr
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn target_value_expression_binding_ref_to_concrete_tokens(
  expr: v2.std.compilers.target_model.TargetValueExpression,
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  bind_outcome(
    o: target_value_expr_binding_ref_binding_from_wire(wire: expr.node),
    f: fn(binding) {
      outcome_accepted(
        std.algebra.Cons {
          head: target_value_expression_binding_ref_token(
            binding: binding,
            projection: projection
          ),
          tail: std.algebra.Empty
        }
      )
    }
  )
}

fn target_value_expression_symbol_identity_from_wire(wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Symbol> {
  match fold(
    wire.children,
    init: optional_absent(),
    f: fn(acc, edge) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match edge.label {
            Named { name: n } =>
              if n == ^target_value_expression_field_identity {
                match edge.target.kind {
                  TypeNode { connective: Atom { identity: id } } =>
                    optional_present(value: id)
                  _ => acc
                }
              } else {
                acc
              }
            Positional => acc
          }
      }
    }
  ) {
    Present { value: id } => outcome_accepted(id)
    Absent =>
      outcome_rejected(
        target_value_expression_emit_unsupported_kind_diagnostic(
          expr: v2.std.compilers.target_model.TargetValueExpression {
            kind: TargetValueExprSymbolIdentity,
            node: wire
          }
        )
      )
  }
}

fn target_value_expression_reify_from_wire(wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression> {
  match wire.kind {
    TypeNode { connective: Atom { identity: atom_id } } =>
      if atom_id == ^target_value_expression_binding_ref_atom {
        outcome_accepted(
          TargetValueExpression {
            kind: TargetValueExprBindingRef,
            node: wire
          }
        )
      } else if atom_id == ^target_value_expression_symbol_identity_atom {
        outcome_accepted(
          TargetValueExpression {
            kind: TargetValueExprSymbolIdentity,
            node: wire
          }
        )
      } else if atom_id == ^target_value_expression_bool_literal_atom {
        outcome_accepted(
          TargetValueExpression {
            kind: TargetValueExprBoolLiteral,
            node: wire
          }
        )
      } else if atom_id == ^target_value_expression_conditional_atom {
        outcome_accepted(
          TargetValueExpression {
            kind: TargetValueExprConditional,
            node: wire
          }
        )
      } else if atom_id == ^target_value_expression_bind_let_atom {
        outcome_accepted(
          TargetValueExpression {
            kind: TargetValueExprBindLet,
            node: wire
          }
        )
      } else if atom_id == ^target_value_expression_loop_atom {
        outcome_accepted(
          TargetValueExpression {
            kind: TargetValueExprLoop,
            node: wire
          }
        )
      } else if atom_id == ^target_value_expression_primitive_apply_atom {
        outcome_accepted(
          TargetValueExpression {
            kind: TargetValueExprPrimitiveApply,
            node: wire
          }
        )
      } else if atom_id == ^target_value_expression_record_construct_atom {
        outcome_accepted(
          TargetValueExpression {
            kind: TargetValueExprRecordConstruct,
            node: wire
          }
        )
      } else if atom_id == ^target_value_expression_field_access_atom {
        outcome_accepted(
          TargetValueExpression {
            kind: TargetValueExprFieldAccess,
            node: wire
          }
        )
      } else if atom_id == ^target_value_expression_match_atom {
        outcome_accepted(
          TargetValueExpression {
            kind: TargetValueExprMatch,
            node: wire
          }
        )
      } else if atom_id == ^target_value_expression_callable_apply_atom {
        outcome_accepted(
          TargetValueExpression {
            kind: TargetValueExprCallableApply,
            node: wire
          }
        )
      } else if atom_id == ^target_value_expression_closure_atom {
        outcome_accepted(
          TargetValueExpression {
            kind: TargetValueExprClosure,
            node: wire
          }
        )
      } else {
        outcome_rejected(
          target_value_expression_emit_unsupported_kind_diagnostic(
            expr: v2.std.compilers.target_model.TargetValueExpression {
              kind: TargetValueExprSymbolIdentity,
              node: wire
            }
          )
        )
      }
    _ =>
      outcome_rejected(
        target_value_expression_emit_unsupported_kind_diagnostic(
          expr: v2.std.compilers.target_model.TargetValueExpression {
            kind: TargetValueExprSymbolIdentity,
            node: wire
          }
        )
      )
  }
}

fn target_value_expr_conditional_wire_schema_valid(wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<Bool> {
  match wire.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id != ^target_value_expression_conditional_atom {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else if name_occurrences(
        name: ^target_value_expr_field_branch_condition,
        children: wire.children
      ) != 1 {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else if name_occurrences(
        name: ^target_value_expr_field_branch_then_arm,
        children: wire.children
      ) != 1 {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else if name_occurrences(
        name: ^target_value_expr_field_branch_else_arm,
        children: wire.children
      ) != 1 {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else {
        outcome_accepted(true)
      }
    _ =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

fn target_value_expr_conditional_child_from_wire(
  wire: v2.std.node.Node,
  field: v2.std.node.Symbol
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression> {
  match fold(
    wire.children,
    init: optional_absent(),
    f: fn(acc, edge) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match edge.label {
            Named { name: n } =>
              if n == field {
                optional_present(value: edge.target)
              } else {
                acc
              }
            Positional => acc
          }
      }
    }
  ) {
    Present { value: child } =>
      target_value_expression_reify_from_wire(wire: child)
    Absent =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

fn target_value_expr_bind_let_wire_schema_valid(wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<Bool> {
  match wire.kind {
