fn target_value_expr_wire_atom_identity(wire: Node) -> Outcome<Symbol> {
  match wire.kind {
    TypeNode { connective: Atom { identity: id } } => outcome_accepted(id)
    _ =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

fn target_value_expr_record_construct_wire_schema_valid(wire: Node) -> Outcome<Bool> {
  match wire.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id != ^target_value_expression_record_construct_atom {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else if name_occurrences(
        name: ^target_value_expr_field_record_type,
        children: wire.children
      ) != 1 {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else if !all_edges_named(children: wire.children) {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else {
        outcome_accepted(true)
      }
    _ =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

fn target_value_expr_record_construct_type_from_wire(wire: Node) -> Outcome<Symbol> {
  match fold(
    wire.children,
    init: optional_absent(),
    f: fn(acc, edge) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match edge.label {
            Named { name: n } =>
              if n == ^target_value_expr_field_record_type {
                match edge.target.kind {
                  TypeNode { connective: Atom { identity: id } } =>
                    optional_present(value: id)
                  _ => acc
                }
              } else {
                acc
              }
            Positional => acc
          }
      }
    }
  ) {
    Present { value: type_name } => outcome_accepted(type_name)
    Absent =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

fn target_value_expr_record_construct_field_slots_from_wire(
  wire: Node
) -> Outcome<List<TargetValueExprFieldInitSlot>> {
  match fold(
    wire.children,
    init: Accepted { value: Empty, diagnostics: None },
    f: fn(acc, edge) {
      match acc {
        Rejected { diagnostics: r } => acc
        Accepted { value: slots, diagnostics: d } =>
          match edge.label {
            Named { name: n } =>
              if n == ^target_value_expr_field_record_type {
                acc
              } else {
                bind_outcome(
                  o: target_value_expression_reify_from_wire(wire: edge.target),
                  f: fn(value) {
                    outcome_accepted(
                      list_snoc_item(
                        xs: slots,
                        item: TargetValueExprFieldInitSlot { label: n, value: value }
                      )
                    )
                  }
                )
              }
            Positional =>
              outcome_rejected(
                target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
              )
          }
      }
    }
  ) {
    Accepted { value: slots, diagnostics: d } => Accepted { value: slots, diagnostics: d }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn target_value_expr_labeled_edge_head(labeled: List<Edge>) -> Optional<Edge> {
  fold(labeled, init: optional_absent(), f: fn(acc, edge) {
    match acc {
      Present { value: _ } => acc
      Absent => optional_present(value: edge)
    }
  })
}

fn target_value_expr_labeled_edges_tail(labeled: List<Edge>) -> List<Edge> {
  match list_tail(xs: labeled) {
    TailFound { tail: rest } => rest
    TailAbsent => Empty
  }
}

fn target_value_expr_record_construct_field_tokens(
  slots: List<TargetValueExprFieldInitSlot>,
  projection: TargetValueExpressionProjection,
  catalog: Node
) -> Outcome<List<ConcreteSyntaxToken>> {
  match fold(
    slots,
    init: Accepted { value: Empty, diagnostics: None },
    f: fn(acc, slot) {
      match acc {
        Rejected { diagnostics: r } => acc
        Accepted { value: prior_tokens, diagnostics: d } =>
          bind_outcome(
            o: target_value_expression_to_concrete_tokens(
              expr: slot.value,
              projection: projection,
              catalog: catalog
            ),
            f: fn(value_tokens) {
              let field_chunk = list_append(
                left: list_append(
                  left: Cons {
                    head: target_value_expression_binding_ref_token(
                      binding: slot.label,
                      projection: projection
                    ),
                    tail: Empty
                  },
                  right: Cons {
                    head: FixedToken {
                      token_class: projection.record_construct_form.assign
                    },
                    tail: Empty
                  }
                ),
                right: value_tokens
              )
              if is_empty(xs: prior_tokens) {
                outcome_accepted(field_chunk)
              } else {
                outcome_accepted(
                  list_append(
                    left: list_append(
                      left: prior_tokens,
                      right: Cons {
                        head: FixedToken {
                          token_class: projection.record_construct_form.separator
                        },
                        tail: Empty
                      }
                    ),
                    right: field_chunk
                  )
                )
              }
            }
          )
      }
    }
  ) {
    Accepted { value: tokens, diagnostics: d } => Accepted { value: tokens, diagnostics: d }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn target_value_expression_record_construct_to_concrete_tokens(
  expr: TargetValueExpression,
  projection: TargetValueExpressionProjection,
  catalog: Node
) -> Outcome<List<ConcreteSyntaxToken>> {
  bind_outcome(
    o: target_value_expr_record_construct_wire_schema_valid(wire: expr.node),
    f: fn(_) {
      bind_outcome(
        o: target_value_expr_record_construct_type_from_wire(wire: expr.node),
        f: fn(type_name) {
          bind_outcome(
            o: target_value_expr_record_construct_field_slots_from_wire(wire: expr.node),
            f: fn(field_slots) {
              bind_outcome(
                o: target_value_expr_record_construct_field_tokens(
                  slots: field_slots,
                  projection: projection,
                  catalog: catalog
                ),
                f: fn(field_tokens) {
                  outcome_accepted(
                    list_append(
                      left: list_append(
                        left: list_append(
                          left: list_append(
                            left: Cons {
                              head: target_value_expression_binding_ref_token(
                                binding: type_name,
                                projection: projection
                              ),
                              tail: Empty
                            },
                            right: Cons {
                              head: FixedToken {
                                token_class: projection.record_construct_form.open
                              },
                              tail: Empty
                            }
                          ),
                          right: field_tokens
                        ),
                        right: Cons {
                          head: FixedToken {
                            token_class: projection.record_construct_form.close
                          },
                          tail: Empty
                        }
                      ),
                      right: Empty
                    )
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn target_value_expr_field_access_wire_schema_valid(wire: Node) -> Outcome<Bool> {
  match wire.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id != ^target_value_expression_field_access_atom {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else if name_occurrences(
        name: ^target_value_expr_field_field_access_base,
        children: wire.children
      ) != 1 {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else if name_occurrences(
        name: ^target_value_expr_field_field_access_field,
        children: wire.children
      ) != 1 {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else {
        match fold(
          wire.children,
          init: true,
          f: fn(acc, edge) {
            if acc {
              match edge.label {
                Named { name: n } =>
                  n == ^target_value_expr_field_field_access_base
                  || n == ^target_value_expr_field_field_access_field
                Positional => false
              }
            } else {
              false
            }
          }
        ) {
          true => outcome_accepted(true)
          false =>
            outcome_rejected(
              target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
            )
        }
      }
    _ =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

fn target_value_expr_field_access_base_from_wire(
  wire: Node
) -> Outcome<TargetValueExpression> {
  target_value_expr_conditional_child_from_wire(
    wire: wire,
    field: ^target_value_expr_field_field_access_base
  )
}

fn target_value_expr_field_access_field_from_wire(wire: Node) -> Outcome<Symbol> {
  match fold(
    wire.children,
    init: optional_absent(),
    f: fn(acc, edge) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match edge.label {
            Named { name: n } =>
              if n == ^target_value_expr_field_field_access_field {
                match edge.target.kind {
                  TypeNode { connective: Atom { identity: id } } =>
                    optional_present(value: id)
                  _ => acc
                }
              } else {
                acc
              }
            Positional => acc
          }
      }
    }
  ) {
    Present { value: field_name } => outcome_accepted(field_name)
    Absent =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

fn target_value_expression_field_access_to_concrete_tokens(
  expr: TargetValueExpression,
  projection: TargetValueExpressionProjection,
  catalog: Node
) -> Outcome<List<ConcreteSyntaxToken>> {
  bind_outcome(
    o: target_value_expr_field_access_wire_schema_valid(wire: expr.node),
    f: fn(_) {
      bind_outcome(
        o: target_value_expr_field_access_base_from_wire(wire: expr.node),
        f: fn(base) {
          bind_outcome(
            o: target_value_expr_field_access_field_from_wire(wire: expr.node),
            f: fn(field_name) {
              bind_outcome(
                o: target_value_expression_to_concrete_tokens(
                  expr: base,
                  projection: projection,
                  catalog: catalog
                ),
                f: fn(base_tokens) {
                  outcome_accepted(
                    list_append(
                      left: list_append(
                        left: base_tokens,
                        right: Cons {
                          head: FixedToken {
                            token_class: projection.field_access_form.dot
                          },
                          tail: Empty
                        }
                      ),
                      right: Cons {
                        head: target_value_expression_binding_ref_token(
                          binding: field_name,
                          projection: projection
                        ),
                        tail: Empty
                      }
                    )
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn target_value_expr_match_arm_wire_schema_valid(arm_wire: Node) -> Outcome<Bool> {
  match arm_wire.kind {
    TypeNode { connective: Conj } =>
      if name_occurrences(name: match_arm_pattern, children: arm_wire.children) != 1 {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: arm_wire)
        )
      } else if name_occurrences(name: match_arm_body, children: arm_wire.children) != 1 {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: arm_wire)
        )
      } else {
        match fold(
          arm_wire.children,
          init: true,
          f: fn(acc, edge) {
            if acc {
              match edge.label {
                Named { name: n } =>
                  n == match_arm_pattern || n == match_arm_body
                Positional => false
              }
            } else {
              false
            }
          }
        ) {
          true => outcome_accepted(true)
          false =>
            outcome_rejected(
              target_value_expr_operand_wire_malformed_diagnostic(wire: arm_wire)
            )
        }
      }
    _ =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: arm_wire)
      )
  }
}

fn target_value_expr_match_wire_schema_valid(wire: Node) -> Outcome<Bool> {
  match wire.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id != ^target_value_expression_match_atom {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else if name_occurrences(
        name: ^target_value_expr_field_match_scrutinee,
        children: wire.children
      ) != 1 {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else {
        match fold(
          wire.children,
          init: Accepted { value: true, diagnostics: None },
          f: fn(acc, edge) {
            match acc {
              Rejected { diagnostics: r } => acc
              Accepted { value: ok, diagnostics: d } =>
                if !ok {
                  acc
                } else {
                  match edge.label {
                    Named { name: n } =>
                      if n == ^target_value_expr_field_match_scrutinee {
                        acc
                      } else {
                        outcome_rejected(
                          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
                        )
                      }
                    Positional =>
                      bind_outcome(
                        o: target_value_expr_match_arm_wire_schema_valid(arm_wire: edge.target),
                        f: fn(_) {
                          outcome_accepted(true)
                        }
                      )
                  }
                }
            }
          }
        ) {
          Accepted { value: true, diagnostics: d } => Accepted { value: true, diagnostics: d }
          Accepted { value: false, diagnostics: d } =>
            outcome_rejected(
              target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
            )
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
        }
      }
    _ =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

fn target_value_expr_match_scrutinee_from_wire(wire: Node) -> Outcome<TargetValueExpression> {
  target_value_expr_conditional_child_from_wire(
    wire: wire,
    field: ^target_value_expr_field_match_scrutinee
  )
}

fn target_value_expr_match_arm_slot_from_wire(arm_wire: Node) -> Outcome<TargetValueExprMatchArmSlot> {
  bind_outcome(
    o: target_value_expr_match_arm_wire_schema_valid(arm_wire: arm_wire),
    f: fn(_) {
      bind_outcome(
        o: find_named_child(root: arm_wire, name: match_arm_pattern),
        f: fn(pattern_wire) {
          bind_outcome(
            o: find_named_child(root: arm_wire, name: match_arm_body),
            f: fn(body_wire) {
              bind_outcome(
                o: target_value_expression_reify_from_wire(wire: pattern_wire),
                f: fn(pat_expr) {
                  bind_outcome(
                    o: target_value_expression_reify_from_wire(wire: body_wire),
                    f: fn(body_expr) {
                      outcome_accepted(
                        TargetValueExprMatchArmSlot {
                          pattern: pat_expr,
                          body: body_expr
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn target_value_expr_match_arms_from_wire(
  wire: Node
) -> Outcome<List<TargetValueExprMatchArmSlot>> {
  match fold(
    wire.children,
    init: Accepted { value: Empty, diagnostics: None },
    f: fn(acc, edge) {
      match acc {
        Rejected { diagnostics: r } => acc
        Accepted { value: arms, diagnostics: d } =>
          match edge.label {
            Named { name: _ } => acc
            Positional =>
              bind_outcome(
                o: target_value_expr_match_arm_slot_from_wire(arm_wire: edge.target),
                f: fn(arm) {
                  outcome_accepted(list_snoc_item(xs: arms, item: arm))
                }
              )
          }
      }
    }
  ) {
    Accepted { value: arms, diagnostics: d } => Accepted { value: arms, diagnostics: d }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn target_value_expr_match_arm_tokens(
  arms: List<TargetValueExprMatchArmSlot>,
  projection: TargetValueExpressionProjection,
  catalog: Node
) -> Outcome<List<ConcreteSyntaxToken>> {
  match fold(
    arms,
    init: Accepted { value: Empty, diagnostics: None },
    f: fn(acc, arm) {
      match acc {
        Rejected { diagnostics: r } => acc
        Accepted { value: prior_tokens, diagnostics: d } =>
          bind_outcome(
            o: target_value_expression_to_concrete_tokens(
              expr: arm.pattern,
              projection: projection,
              catalog: catalog
            ),
            f: fn(pattern_tokens) {
              bind_outcome(
                o: target_value_expression_to_concrete_tokens(
                  expr: arm.body,
                  projection: projection,
                  catalog: catalog
                ),
                f: fn(body_tokens) {
                  let arm_chunk = list_append(
                    left: list_append(
                      left: pattern_tokens,
                      right: Cons {
                        head: FixedToken {
                          token_class: projection.match_form.fat_arrow
                        },
                        tail: Empty
                      }
                    ),
                    right: body_tokens
                  )
                  if is_empty(xs: prior_tokens) {
                    outcome_accepted(arm_chunk)
                  } else {
                    outcome_accepted(
                      list_append(
                        left: list_append(
                          left: prior_tokens,
                          right: Cons {
                            head: FixedToken {
                              token_class: projection.match_form.arm_separator
                            },
                            tail: Empty
                          }
                        ),
                        right: arm_chunk
                      )
                    )
                  }
                }
              )
            }
          )
      }
    }
  ) {
    Accepted { value: tokens, diagnostics: d } => Accepted { value: tokens, diagnostics: d }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn target_value_expression_match_to_concrete_tokens(
  expr: TargetValueExpression,
  projection: TargetValueExpressionProjection,
  catalog: Node
) -> Outcome<List<ConcreteSyntaxToken>> {
  bind_outcome(
    o: target_value_expr_match_wire_schema_valid(wire: expr.node),
    f: fn(_) {
      bind_outcome(
        o: target_value_expr_match_scrutinee_from_wire(wire: expr.node),
        f: fn(scrutinee) {
          bind_outcome(
            o: target_value_expr_match_arms_from_wire(wire: expr.node),
            f: fn(arms) {
              bind_outcome(
                o: target_value_expression_to_concrete_tokens(
                  expr: scrutinee,
                  projection: projection,
                  catalog: catalog
                ),
                f: fn(scrutinee_tokens) {
                  bind_outcome(
                    o: target_value_expr_match_arm_tokens(
                      arms: arms,
                      projection: projection,
                      catalog: catalog
                    ),
                    f: fn(arm_tokens) {
                      outcome_accepted(
                        list_append(
                          left: list_append(
                            left: list_append(
                              left: list_append(
                                left: Cons {
                                  head: FixedToken {
                                    token_class: projection.match_form.match_token
                                  },
                                  tail: Empty
                                },
                                right: scrutinee_tokens
                              ),
                              right: Cons {
                                head: FixedToken {
                                  token_class: projection.match_form.open
                                },
                                tail: Empty
                              }
                            ),
                            right: arm_tokens
                          ),
                          right: Cons {
                            head: FixedToken {
                              token_class: projection.match_form.close
                            },
                            tail: Empty
                          }
                        )
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn target_value_expression_symbol_identity_to_concrete_tokens(
  expr: TargetValueExpression
) -> Outcome<List<ConcreteSyntaxToken>> {
  bind_outcome(
    o: target_value_expression_symbol_identity_from_wire(wire: expr.node),
    f: fn(token_class) {
      outcome_accepted(
        Cons {
          head: FixedToken { token_class: token_class },
          tail: Empty
        }
      )
    }
  )
}

fn target_value_expression_conditional_to_concrete_tokens(
  expr: TargetValueExpression,
  projection: TargetValueExpressionProjection,
  catalog: Node
) -> Outcome<List<ConcreteSyntaxToken>> {
  bind_outcome(
    o: target_value_expr_conditional_wire_schema_valid(wire: expr.node),
    f: fn(_) {
      bind_outcome(
        o: target_value_expr_conditional_child_from_wire(
          wire: expr.node,
          field: ^target_value_expr_field_branch_condition
        ),
        f: fn(condition) {
          bind_outcome(
            o: target_value_expr_conditional_child_from_wire(
              wire: expr.node,
              field: ^target_value_expr_field_branch_then_arm
            ),
            f: fn(then_arm) {
              bind_outcome(
                o: target_value_expr_conditional_child_from_wire(
                  wire: expr.node,
                  field: ^target_value_expr_field_branch_else_arm
                ),
                f: fn(else_arm) {
                  bind_outcome(
                    o: target_value_expression_to_concrete_tokens(
                      expr: condition,
                      projection: projection,
                      catalog: catalog
                    ),
                    f: fn(cond_tokens) {
                      bind_outcome(
                        o: target_value_expression_to_concrete_tokens(
                          expr: then_arm,
                          projection: projection,
                          catalog: catalog
                        ),
                        f: fn(then_tokens) {
                          bind_outcome(
                            o: target_value_expression_to_concrete_tokens(
                              expr: else_arm,
                              projection: projection,
                              catalog: catalog
                            ),
                            f: fn(else_tokens) {
                              outcome_accepted(
                                list_append(
                                  left: list_append(
                                    left: list_append(
                                      left: list_append(
                                        left: list_append(
                                          left: Cons {
                                            head: FixedToken {
                                              token_class: projection.conditional_form.if_token
                                            },
                                            tail: Empty
                                          },
                                          right: cond_tokens
                                        ),
                                        right: Cons {
                                          head: FixedToken {
                                            token_class: projection.conditional_form.then_token
                                          },
                                          tail: Empty
                                        }
                                      ),
                                      right: then_tokens
                                    ),
                                    right: Cons {
                                      head: FixedToken {
                                        token_class: projection.conditional_form.else_token
                                      },
                                      tail: Empty
                                    }
                                  ),
                                  right: else_tokens
                                )
                              )
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

// ── Lane 2c: callable-apply + closure extraction and emission ──────────────────

fn target_value_expr_callable_apply_callee_from_wire(wire: Node) -> Outcome<Symbol> {
  match fold(
    wire.children,
    init: optional_absent(),
    f: fn(acc, edge) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match edge.label {
            Named { name: n } =>
              if n == ^target_value_expr_field_callee {
                match edge.target.kind {
                  TypeNode { connective: Atom { identity: id } } =>
                    optional_present(value: id)
                  _ => acc
                }
              } else {
                acc
              }
            Positional => acc
          }
      }
    }
  ) {
    Present { value: callee } => outcome_accepted(callee)
    Absent =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

fn target_value_expr_callable_apply_args_from_wire(
  wire: Node
) -> Outcome<List<TargetValueExpression>> {
  fold(
    wire.children,
    init: Accepted { value: Empty, diagnostics: None },
    f: fn(acc, edge) {
      match acc {
        Rejected { diagnostics: _ } => acc
        Accepted { value: args, diagnostics: _ } =>
          match edge.label {
            Named { name: n } =>
              if n == ^target_value_expr_field_callable_arg {
                bind_outcome(
                  o: target_value_expression_reify_from_wire(wire: edge.target),
                  f: fn(arg) {
                    outcome_accepted(list_snoc_item(xs: args, item: arg))
                  }
                )
              } else if n == ^target_value_expr_field_callee {
                acc
              } else {
                outcome_rejected(
                  target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
                )
              }
            Positional =>
              outcome_rejected(
                target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
              )
          }
      }
    }
  )
}

// Recursively tokenize a list of value-expressions, interspersing one `separator` FixedToken
// between adjacent members (no leading/trailing separator). Fail-closed on any member.
fn target_value_expr_tokenize_intersperse(
  exprs: List<TargetValueExpression>,
  projection: TargetValueExpressionProjection,
  catalog: Node,
  separator: Symbol
) -> Outcome<List<ConcreteSyntaxToken>> {
  fold(
    exprs,
    init: Accepted { value: Empty, diagnostics: None },
    f: fn(acc, e) {
      match acc {
        Rejected { diagnostics: _ } => acc
        Accepted { value: toks, diagnostics: _ } =>
          bind_outcome(
            o: target_value_expression_to_concrete_tokens(
              expr: e,
              projection: projection,
              catalog: catalog
            ),
            f: fn(et) {
              match toks {
                Empty => outcome_accepted(et)
                _ =>
                  outcome_accepted(
                    list_append(
                      left: list_append(
                        left: toks,
                        right: Cons {
                          head: FixedToken { token_class: separator },
                          tail: Empty
                        }
                      ),
                      right: et
                    )
                  )
              }
            }
          )
      }
    }
  )
}

fn target_value_expression_callable_apply_to_concrete_tokens(
  expr: TargetValueExpression,
  projection: TargetValueExpressionProjection,
  catalog: Node
) -> Outcome<List<ConcreteSyntaxToken>> {
  bind_outcome(
    o: target_value_expr_callable_apply_callee_from_wire(wire: expr.node),
    f: fn(callee) {
      bind_outcome(
        o: target_value_expr_callable_apply_args_from_wire(wire: expr.node),
        f: fn(args) {
          bind_outcome(
            o: target_value_expr_tokenize_intersperse(
              exprs: args,
              projection: projection,
              catalog: catalog,
              separator: projection.callable_apply_form.separator
            ),
            f: fn(arg_tokens) {
              outcome_accepted(
                list_append(
                  left: list_append(
                    left: Cons {
                      head: BoundToken {
                        token_class: projection.callable_apply_form.callee_ident_token,
                        binding: callee
                      },
                      tail: Cons {
                        head: FixedToken {
                          token_class: projection.callable_apply_form.open
                        },
                        tail: Empty
                      }
                    },
                    right: arg_tokens
                  ),
                  right: Cons {
                    head: FixedToken {
                      token_class: projection.callable_apply_form.close
                    },
                    tail: Empty
                  }
                )
              )
            }
          )
        }
      )
    }
  )
}

fn target_value_expr_closure_params_from_wire(wire: Node) -> Outcome<List<Symbol>> {
  fold(
    wire.children,
    init: Accepted { value: Empty, diagnostics: None },
    f: fn(acc, edge) {
      match acc {
        Rejected { diagnostics: _ } => acc
        Accepted { value: ps, diagnostics: _ } =>
          match edge.label {
            Named { name: n } =>
              if n == ^target_value_expr_field_closure_param {
                match edge.target.kind {
                  TypeNode { connective: Atom { identity: id } } =>
                    outcome_accepted(list_snoc_item(xs: ps, item: id))
                  _ =>
                    outcome_rejected(
                      target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
                    )
                }
              } else if n == ^target_value_expr_field_closure_body {
                acc
              } else {
                outcome_rejected(
                  target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
                )
              }
            Positional =>
              outcome_rejected(
                target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
              )
          }
      }
    }
  )
}

fn target_value_expr_closure_body_from_wire(wire: Node) -> Outcome<TargetValueExpression> {
  target_value_expr_conditional_child_from_wire(
    wire: wire,
    field: ^target_value_expr_field_closure_body
  )
}

fn target_value_expr_closure_param_tokens(
  params: List<Symbol>,
  ident_token: Symbol,
  separator: Symbol
) -> List<ConcreteSyntaxToken> {
  fold_list_right(
    xs: params,
    empty: Empty,
    snoc: fn(acc, p) {
      let token = BoundToken { token_class: ident_token, binding: p }
      match acc {
        Empty => Cons { head: token, tail: Empty }
        _ =>
          Cons {
            head: token,
            tail: Cons {
              head: FixedToken { token_class: separator },
              tail: acc
            }
          }
      }
    }
  )
}

fn target_value_expression_closure_to_concrete_tokens(
  expr: TargetValueExpression,
  projection: TargetValueExpressionProjection,
  catalog: Node
) -> Outcome<List<ConcreteSyntaxToken>> {
  bind_outcome(
    o: target_value_expr_closure_params_from_wire(wire: expr.node),
    f: fn(params) {
      bind_outcome(
        o: target_value_expr_closure_body_from_wire(wire: expr.node),
        f: fn(body) {
          bind_outcome(
            o: target_value_expression_to_concrete_tokens(
              expr: body,
              projection: projection,
              catalog: catalog
            ),
            f: fn(body_tokens) {
              outcome_accepted(
                list_append(
                  left: list_append(
                    left: list_append(
                      left: Cons {
                        head: FixedToken {
                          token_class: projection.closure_form.fn_token
                        },
                        tail: Cons {
                          head: FixedToken {
                            token_class: projection.closure_form.open
                          },
                          tail: Empty
                        }
                      },
                      right: list_append(
                        left: target_value_expr_closure_param_tokens(
                          params: params,
                          ident_token: projection.closure_form.param_ident_token,
                          separator: projection.closure_form.separator
                        ),
                        right: Cons {
                          head: FixedToken {
                            token_class: projection.closure_form.close
                          },
                          tail: Cons {
                            head: FixedToken {
                              token_class: projection.closure_form.body_open
                            },
                            tail: Empty
                          }
                        }
                      )
                    ),
                    right: body_tokens
                  ),
                  right: Cons {
                    head: FixedToken {
                      token_class: projection.closure_form.body_close
                    },
                    tail: Empty
                  }
                )
              )
            }
          )
        }
      )
    }
  )
}

// Substrate fold — exhaustive match over TargetValueExpressionKind (design-value-emit-schema.md §4.4).
fn target_value_expression_to_concrete_tokens(
  expr: TargetValueExpression,
  projection: TargetValueExpressionProjection,
  catalog: Node
) -> Outcome<List<ConcreteSyntaxToken>> {
  match expr.kind {
    TargetValueExprBindingRef =>
      target_value_expression_binding_ref_to_concrete_tokens(
        expr: expr,
        projection: projection
      )
    TargetValueExprPrimitiveApply =>
      target_value_expression_primitive_apply_to_concrete_tokens(
        expr: expr,
        projection: projection,
        catalog: catalog
      )
    TargetValueExprEffectApply =>
      target_value_expression_effect_apply_to_concrete_tokens(
        expr: expr,
        projection: projection
      )
    TargetValueExprCallableApply =>
      target_value_expression_callable_apply_to_concrete_tokens(
        expr: expr,
        projection: projection,
        catalog: catalog
      )
    TargetValueExprClosure =>
      target_value_expression_closure_to_concrete_tokens(
        expr: expr,
        projection: projection,
        catalog: catalog
      )
    TargetValueExprSymbolIdentity =>
      target_value_expression_symbol_identity_to_concrete_tokens(expr: expr)
    TargetValueExprConditional =>
      target_value_expression_conditional_to_concrete_tokens(
        expr: expr,
        projection: projection,
        catalog: catalog
      )
    TargetValueExprBindLet =>
      target_value_expression_bind_let_to_concrete_tokens(
        expr: expr,
        projection: projection,
        catalog: catalog
      )
    TargetValueExprLoop =>
      target_value_expression_loop_to_concrete_tokens(
        expr: expr,
        projection: projection,
        catalog: catalog
      )
    TargetValueExprRecordConstruct =>
      target_value_expression_record_construct_to_concrete_tokens(
        expr: expr,
        projection: projection,
        catalog: catalog
      )
    TargetValueExprFieldAccess =>
      target_value_expression_field_access_to_concrete_tokens(
        expr: expr,
        projection: projection,
        catalog: catalog
      )
    TargetValueExprMatch =>
      target_value_expression_match_to_concrete_tokens(
        expr: expr,
        projection: projection,
        catalog: catalog
      )
    _ =>
      outcome_rejected(
        target_value_expression_emit_unsupported_kind_diagnostic(expr: expr)
      )
  }
}

fn target_declared_inhabitants_edge_targets(root: Node) -> List<Node> {
  match root.kind {
    TypeNode { connective: Conj } =>
      fold(root.children, init: Empty, f: fn(acc, edge) {
        list_snoc_item(xs: acc, item: edge.target)
      })
    _ => Empty
  }
}

fn target_inhabitant_wire_primary_atom_identity(wire: Node) -> Optional<Symbol> {
  match wire.kind {
    TypeNode { connective: Atom { identity: id } } => optional_present(value: id)
    TypeNode { connective: Conj } =>
      match fold(
        wire.children,
        init: optional_absent(),
        f: fn(acc, edge) {
          match acc {
            Present { value: _ } => acc
            Absent =>
              match edge.label {
                Named { name: _ } =>
                  match edge.target.kind {
                    TypeNode { connective: Atom { identity: id } } =>
                      optional_present(value: id)
                    _ => acc
                  }
                Positional => acc
              }
          }
        }
      ) {
        Present { value: id } => optional_present(value: id)
        Absent => optional_absent()
      }
    _ => optional_absent()
  }
}

// 🟡 gated — predicate-dissolution interim —
// feature:target-wave1-signature-declared-inhabitants — consumer:06_value_expression
// target_wave1_add_signature_matches — bind: COMPREP wave-1 Arrow signature slots vs
// declared_inhabitants catalog — owner: T6 value-expression (lively-badger-242) —
// lane: std/compilers/target_model — dissolve-on-arrival: Outcome-bearing substrate signature query
// replaces Bool fold predicates in std; forbidden: hand-rolled match/fold signature gates
// without per-function disposition in std/.
fn target_catalog_contains_node_shape(
  slot: Node,
  catalog_targets: List<Node>
) -> Bool {
  fold_list(
    xs: catalog_targets,
    empty: false,
    cons: fn(acc, candidate) {
      if acc {
        true
      } else if content_hash(n: slot) == content_hash(n: candidate) {
        true
      } else {
        false
      }
    }
  )
}

fn target_catalog_atom_identity_matches_inhabitant_wires(
  slot_atom: Symbol,
  catalog_targets: List<Node>
) -> Bool {
  fold_list(
    xs: catalog_targets,
    empty: false,
    cons: fn(acc, candidate) {
      if acc {
        true
      } else {
        match target_inhabitant_wire_primary_atom_identity(wire: candidate) {
          Present { value: inhabitant_atom } => slot_atom == inhabitant_atom
          Absent => false
        }
      }
    }
  )
}

fn target_wave1_signature_slot_matches_declared_inhabitants(
  slot: Node,
  inhabitants_root: Node
) -> Bool {
  let catalog_targets = target_declared_inhabitants_edge_targets(root: inhabitants_root)
  if target_catalog_contains_node_shape(slot: slot, catalog_targets: catalog_targets) {
    true
  } else {
    match slot.kind {
      TypeNode { connective: Atom { identity: slot_atom } } =>
        slot_atom == ^dag_binding_type_int
        || target_catalog_atom_identity_matches_inhabitant_wires(
          slot_atom: slot_atom,
          catalog_targets: catalog_targets
        )
      _ =>
        match target_inhabitant_wire_primary_atom_identity(wire: slot) {
          Present { value: slot_atom } =>
            target_catalog_atom_identity_matches_inhabitant_wires(
              slot_atom: slot_atom,
              catalog_targets: catalog_targets
            )
          Absent => false
        }
    }
  }
}

fn target_wave1_add_signature_slot_at(
  arrow: Node,
  index: Int,
  inhabitants_root: Node
) -> Bool {
  match list_at_optional(xs: node_positional_child_targets(node: arrow), index: index) {
    Present { value: slot } =>
      target_wave1_signature_slot_matches_declared_inhabitants(
        slot: slot,
        inhabitants_root: inhabitants_root
      )
    Absent => false
  }
}

fn target_wave1_add_signature_matches(
  arrow: Node,
  inhabitants_root: Node
) -> Bool {
  match arrow.kind {
    TypeNode { connective: Arrow } =>
      target_wave1_add_signature_slot_at(
        arrow: arrow,
        index: 0,
        inhabitants_root: inhabitants_root
      )
      && target_wave1_add_signature_slot_at(
        arrow: arrow,
        index: 1,
        inhabitants_root: inhabitants_root
      )
      && target_wave1_add_signature_slot_at(
        arrow: arrow,
        index: 2,
        inhabitants_root: inhabitants_root
      )
    _ => false
  }
}

fn value_expr_projection_bundle_node(projection: TargetValueExpressionProjection) -> Node {
  target_model_type_conj_node(
    children: [
      target_model_named_edge(
        name: ^target_value_expr_field_binding_ref,
        target: target_model_type_conj_node(
          children: [
            target_model_named_edge(
              name: ^target_value_expr_field_ident_token,
              target: target_model_type_atom_node(
                identity: projection.binding_ref_form.ident_token
              )
            )
          ]
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_primitive_apply,
        target: target_model_type_conj_node(
          children: [
            target_model_named_edge(
              name: ^target_value_expr_field_open,
              target: target_model_type_atom_node(
                identity: projection.primitive_apply_form.open
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_close,
              target: target_model_type_atom_node(
                identity: projection.primitive_apply_form.close
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_separator,
              target: target_model_type_atom_node(
                identity: projection.primitive_apply_form.separator
              )
            )
          ]
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_callable_apply,
        target: target_model_type_conj_node(
          children: [
            target_model_named_edge(
              name: ^target_value_expr_field_ident_token,
              target: target_model_type_atom_node(
                identity: projection.callable_apply_form.callee_ident_token
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_open,
              target: target_model_type_atom_node(
                identity: projection.callable_apply_form.open
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_close,
              target: target_model_type_atom_node(
                identity: projection.callable_apply_form.close
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_separator,
              target: target_model_type_atom_node(
                identity: projection.callable_apply_form.separator
              )
            )
          ]
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_closure,
        target: target_model_type_conj_node(
          children: [
            target_model_named_edge(
              name: ^target_value_expr_field_fn_token,
              target: target_model_type_atom_node(
                identity: projection.closure_form.fn_token
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_open,
              target: target_model_type_atom_node(
                identity: projection.closure_form.open
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_separator,
              target: target_model_type_atom_node(
                identity: projection.closure_form.separator
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_close,
              target: target_model_type_atom_node(
                identity: projection.closure_form.close
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_body_open,
              target: target_model_type_atom_node(
                identity: projection.closure_form.body_open
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_body_close,
              target: target_model_type_atom_node(
                identity: projection.closure_form.body_close
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_ident_token,
              target: target_model_type_atom_node(
                identity: projection.closure_form.param_ident_token
              )
            )
          ]
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_effect_apply,
        target: target_model_type_conj_node(
          // Serialize the effect-callee catalog as one row edge per `TargetEffectCalleeRow`,
          // followed by the shared open / close / separator framing. Decode inverts this in
          // `decode_effect_apply_shape_bundle`. Wire symmetry is why `callees` is a `List` and not
          // an in-memory closure-backed `Map` (which has no enumeration to serialize).
          children: list_append(
            left: fold_list(
              xs: projection.effect_apply_form.callees,
              empty: Empty,
              cons: fn(acc, row) {
                Cons {
                  head: target_model_named_edge(
                    name: ^target_value_expr_effect_callee_row_edge,
                    target: target_value_expr_effect_callee_row_node(row: row)
                  ),
                  tail: acc
                }
              }
            ),
            right: [
              target_model_named_edge(
                name: ^target_value_expr_field_open,
                target: target_model_type_atom_node(
                  identity: projection.effect_apply_form.open
                )
              ),
              target_model_named_edge(
                name: ^target_value_expr_field_close,
                target: target_model_type_atom_node(
                  identity: projection.effect_apply_form.close
                )
              ),
              target_model_named_edge(
                name: ^target_value_expr_field_separator,
                target: target_model_type_atom_node(
                  identity: projection.effect_apply_form.separator
                )
              )
            ]
          )
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_conditional,
        target: target_model_type_conj_node(
          children: [
            target_model_named_edge(
              name: ^target_value_expr_field_if_token,
              target: target_model_type_atom_node(
                identity: projection.conditional_form.if_token
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_then_token,
              target: target_model_type_atom_node(
                identity: projection.conditional_form.then_token
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_else_token,
              target: target_model_type_atom_node(
                identity: projection.conditional_form.else_token
              )
            )
          ]
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_bind_let,
        target: target_model_type_conj_node(
          children: [
            target_model_named_edge(
              name: ^target_value_expr_field_let_token,
              target: target_model_type_atom_node(
                identity: projection.let_form.let_token
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_assign_token,
              target: target_model_type_atom_node(
                identity: projection.let_form.assign_token
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_in_token,
              target: target_model_type_atom_node(
                identity: projection.let_form.in_token
              )
            )
          ]
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_loop,
        target: target_model_type_conj_node(
          children: [
            target_model_named_edge(
              name: ^target_value_expr_field_loop_token,
              target: target_model_type_atom_node(
                identity: projection.loop_form.loop_token
              )
            )
          ]
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_record_construct,
        target: target_model_type_conj_node(
          children: [
            target_model_named_edge(
              name: ^target_value_expr_field_record_open,
              target: target_model_type_atom_node(
                identity: projection.record_construct_form.open
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_record_close,
              target: target_model_type_atom_node(
                identity: projection.record_construct_form.close
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_record_separator,
              target: target_model_type_atom_node(
                identity: projection.record_construct_form.separator
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_record_assign,
              target: target_model_type_atom_node(
                identity: projection.record_construct_form.assign
              )
            )
          ]
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_field_access,
        target: target_model_type_conj_node(
          children: [
            target_model_named_edge(
              name: ^target_value_expr_field_field_access_dot,
              target: target_model_type_atom_node(
                identity: projection.field_access_form.dot
              )
            )
          ]
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_match,
        target: target_model_type_conj_node(
          children: [
            target_model_named_edge(
              name: ^target_value_expr_field_match_token,
              target: target_model_type_atom_node(
                identity: projection.match_form.match_token
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_match_open,
              target: target_model_type_atom_node(
                identity: projection.match_form.open
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_match_close,
              target: target_model_type_atom_node(
                identity: projection.match_form.close
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_match_fat_arrow,
              target: target_model_type_atom_node(
                identity: projection.match_form.fat_arrow
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_match_arm_separator,
              target: target_model_type_atom_node(
                identity: projection.match_form.arm_separator
              )
            )
          ]
        )
      )
    ]
  )
}

fn target_value_template_apply(
  template: TargetValueTemplate,
  value: SourceAtomValue,
  source_carrier: Node
) -> Outcome<TargetValueExpression> {
  match template.kind {
    ValueSymbolIdentityPassthrough =>
      match source_atom_value_as_symbol(value: value) {
        Absent =>
          outcome_rejected(
            target_value_template_mismatch_diagnostic(source_carrier: source_carrier)
          )
        Present { value: id } =>
          outcome_accepted(target_value_expression_symbol_identity(identity: id))
      }
    ValueSymbolToOwnedString =>
      match source_atom_value_as_symbol(value: value) {
        Absent =>
          outcome_rejected(
            target_value_template_mismatch_diagnostic(source_carrier: source_carrier)
          )
        Present { value: id } =>
          outcome_accepted(target_value_expression_symbol_to_owned_string(identity: id))
      }
    ValueBoolLiteral =>
      match source_atom_value_as_bool(value: value) {
        Absent =>
          outcome_rejected(
            target_value_template_mismatch_diagnostic(source_carrier: source_carrier)
          )
        Present { value: b } => outcome_accepted(target_value_expression_bool_literal(value: b))
      }
    ValueCharUnicodeScalar =>
      match source_atom_value_as_char(value: value) {
        Absent =>
          outcome_rejected(
            target_value_template_mismatch_diagnostic(source_carrier: source_carrier)
          )
        Present { value: c } =>
          outcome_accepted(target_value_expression_char_unicode_scalar(codepoint: c))
      }
    ValueStringLiteral =>
      match source_atom_value_as_string(value: value) {
        Absent =>
          outcome_rejected(
            target_value_template_mismatch_diagnostic(source_carrier: source_carrier)
          )
        Present { value: s } =>
          outcome_accepted(target_value_expression_string_literal(value: s))
      }
    ValueBindingRef =>
      outcome_rejected(
        target_value_template_mismatch_diagnostic(source_carrier: source_carrier)
      )
    ValuePrimitiveApply =>
      outcome_rejected(
        target_value_template_mismatch_diagnostic(source_carrier: source_carrier)
      )
    ValueEffectApply =>
      outcome_rejected(
        target_value_template_mismatch_diagnostic(source_carrier: source_carrier)
      )
    ValueConditional =>
      outcome_rejected(
        target_value_template_mismatch_diagnostic(source_carrier: source_carrier)
      )
    ValueBindLet =>
      outcome_rejected(
        target_value_template_mismatch_diagnostic(source_carrier: source_carrier)
      )
    ValueLoop =>
      outcome_rejected(
        target_value_template_mismatch_diagnostic(source_carrier: source_carrier)
      )
    ValueRecordConstruct =>
      outcome_rejected(
        target_value_template_mismatch_diagnostic(source_carrier: source_carrier)
      )
    ValueFieldAccess =>
      outcome_rejected(
        target_value_template_mismatch_diagnostic(source_carrier: source_carrier)
      )
    ValueMatch =>
      outcome_rejected(
        target_value_template_mismatch_diagnostic(source_carrier: source_carrier)
      )
  }
}

fn target_value_template_mismatch_diagnostic(source_carrier: Node) -> Diagnostic {
  Diagnostic {
    reason: ^target_value_template_mismatch,
    at: node_locus(node: source_carrier),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_atom_realization_lookup_step(
  acc: PassingCandidateFold,
  row: TargetAtomRealization,
  source_carrier: Node
) -> PassingCandidateFold {
  if content_hash(n: row.source_carrier) == content_hash(n: source_carrier) {
    match acc {
      NoPassingCandidate => OnePassingCandidate { candidate: row.source_carrier }
      OnePassingCandidate { candidate: _ } => ManyPassingCandidates
      ManyPassingCandidates => ManyPassingCandidates
    }
  } else {
    acc
  }
}

// Named step for the second-pass Optional fold: explicit row type pins v2 type inference.
// The v2 type-inferencer cannot resolve field access on a closure element whose type is
// constrained only through a polymorphic accumulator (optional_absent()); routing through
// a named function with an explicit 'row: TargetAtomRealization' annotation fixes it.
fn target_atom_realization_lookup_extract_row_step(
  acc: Optional<TargetAtomRealization>,
  row: TargetAtomRealization,
  source_carrier: Node
) -> Optional<TargetAtomRealization> {
  match acc {
    Present { value: _ } => acc
    Absent =>
      if content_hash(n: row.source_carrier) == content_hash(n: source_carrier) {
        optional_present(value: row)
      } else {
        acc
      }
  }
}

// Second-pass extraction for the typed-list path: after PassingCandidateFold confirms exactly
// one matching row, re-scan to retrieve the typed TargetAtomRealization.
fn target_atom_realization_lookup_extract_row(
  catalog: List<TargetAtomRealization>,
  source_carrier: Node
) -> Optional<TargetAtomRealization> {
  fold_list(
    xs: catalog,
    empty: optional_absent(),
    cons: fn(acc, item) {
      target_atom_realization_lookup_extract_row_step(
        acc: acc,
        row: item,
        source_carrier: source_carrier
      )
    }
  )
}

// Typed-list lookup for row authoring (e.g. rust_target_atom_realization_catalog before
// target_atom_realization_catalog_node encode). Translate consumers use the Node-keyed
// target_atom_realization_lookup_in_catalog_node path on the bundle catalog edge.
fn target_atom_realization_lookup_in_catalog(
  catalog: List<TargetAtomRealization>,
  source_carrier: Node
) -> Outcome<TargetAtomRealization> {
  match fold_list(
    xs: catalog,
    empty: NoPassingCandidate,
    cons: fn(acc, row) {
      target_atom_realization_lookup_step(
        acc: acc,
        row: row,
        source_carrier: source_carrier
      )
    }
  ) {
    NoPassingCandidate =>
      outcome_rejected(target_atom_realization_lookup_miss_diagnostic(source_carrier: source_carrier))
    OnePassingCandidate { candidate: _ } =>
      match target_atom_realization_lookup_extract_row(
        catalog: catalog,
        source_carrier: source_carrier
      ) {
        Present { value: row } => Accepted { value: row, diagnostics: None }
        Absent =>
          outcome_rejected(target_atom_realization_lookup_miss_diagnostic(source_carrier: source_carrier))
      }
    ManyPassingCandidates =>
      outcome_rejected(target_atom_realization_lookup_ambiguous_diagnostic(source_carrier: source_carrier))
  }
}

fn target_atom_realization_lookup_miss_diagnostic(source_carrier: Node) -> Diagnostic {
  Diagnostic {
    reason: ^target_atom_realization_lookup_miss,
    at: node_locus(node: source_carrier),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_atom_realization_lookup_ambiguous_diagnostic(source_carrier: Node) -> Diagnostic {
  Diagnostic {
    reason: ^target_atom_realization_lookup_ambiguous,
    at: node_locus(node: source_carrier),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_atom_value_expression(
  row: TargetAtomRealization,
  value: SourceAtomValue
) -> Outcome<TargetValueExpression> {
  target_value_template_apply(
    template: row.value_form,
    value: value,
    source_carrier: row.source_carrier
  )
}

fn target_value_expression_bool_atom(value: Bool) -> Node {
  match value {
    true =>
      Node {
        kind: TypeNode {
          connective: Atom { identity: ^target_value_expression_bool_true }
        },
        children: [],
        occurrence_id: SyntheticOccurrence
}
    false =>
      Node {
        kind: TypeNode {
          connective: Atom { identity: ^target_value_expression_bool_false }
        },
        children: [],
        occurrence_id: SyntheticOccurrence
}
  }
}

fn target_value_expression_node(expr: TargetValueExpression) -> Node {
  expr.node
}

fn target_value_template_node(template: TargetValueTemplate) -> Node {
  template.node
}

fn target_constructor_template_node(form: Optional<TargetConstructorTemplate>) -> Node {
  match form {
    Absent =>
      Node {
        kind: TypeNode {
          connective: Atom { identity: ^target_constructor_template_optional_absent }
        },
        children: [],
        occurrence_id: SyntheticOccurrence
}
    Present { value: template } =>
      match template {
        CtorTemplateUnit {} =>
          Node {
            kind: TypeNode {
              connective: Atom { identity: ^target_constructor_template_constructor_absent }
            },
            children: [],
            occurrence_id: SyntheticOccurrence
}
      }
  }
}

fn target_constructor_template_decode_invalid_diagnostic(source_carrier: Node) -> Diagnostic {
  Diagnostic {
    reason: ^target_constructor_template_decode_invalid,
    at: node_locus(node: source_carrier),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_constructor_template_from_node(
  n: Node,
  source_carrier: Node
) -> Outcome<Optional<TargetConstructorTemplate>> {
  match n.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id == ^target_constructor_template_optional_absent {
        outcome_accepted(optional_absent())
      } else if id == ^target_constructor_template_constructor_absent {
        outcome_accepted(optional_present(CtorTemplateUnit {}))
      } else {
        outcome_rejected(
          target_constructor_template_decode_invalid_diagnostic(source_carrier: source_carrier)
        )
      }
    _ =>
      outcome_rejected(
        target_constructor_template_decode_invalid_diagnostic(source_carrier: source_carrier)
      )
  }
}

fn target_model_bundle_core_keep_edge(acc: List<Edge>, edge: Edge) -> List<Edge> {
  match edge.label {
    Named { name: n } =>
      // Strip realization-catalog edges (atom SG-1 + signature SG-1b) so a row's encoded
      // host_bundle (pre-catalog core) structurally matches core(live host) regardless of
      // which catalogs the live host carries.
      match n == ^target_model_edge_atom_realizations
        || n == ^target_model_edge_signature_realizations {
        true => acc
        false => list_snoc_item(xs: acc, item: edge)
      }
    Positional => list_snoc_item(xs: acc, item: edge)
  }
}

fn target_model_bundle_core(host: TargetModel) -> Node {
  match host.bundle.kind {
    TypeNode { connective: Conj } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: fold_list(
          xs: host.bundle.children,
          empty: Empty,
          cons: fn(acc, edge) {
            target_model_bundle_core_keep_edge(acc: acc, edge: edge)
          }
        ),
        occurrence_id: SyntheticOccurrence
}
    _ => host.bundle
  }
}

// 🟡 gated — feature:SG-1-atom-realization-row-bundle-staging — bind PR #3956 / SG-1 dispatch —
// dissolve-on-arrival: catalog row encode always carries the full host TargetModel bundle
// (including target_model_edge_atom_realizations); decode matches via structural equality on
// that single shape only — delete target_model_bundle_core from this predicate and the
// content_hash disjunction. Until then, rows encode with host bundle minus
// atom_realizations (including collection_realization when on the live host); forbidden: a third bundle
// shape or widening the disjunction without modeling escalation.
fn target_atom_realization_bundle_matches_host(row_bundle: Node, host: TargetModel) -> Bool {
  content_hash(n: row_bundle) == content_hash(n: host.bundle)
  || content_hash(n: row_bundle) == content_hash(n: target_model_bundle_core(host: host))
}

fn target_atom_realization_to_node(row: TargetAtomRealization, host_bundle: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      target_model_named_edge(
        name: ^target_atom_realization_field_source_carrier,
        target: row.source_carrier
      ),
      target_model_named_edge(
        name: ^target_atom_realization_field_target_model_bundle,
        target: host_bundle
      ),
      target_model_named_edge(
        name: ^target_atom_realization_field_type_form,
        target: row.type_form.node
      ),
      target_model_named_edge(
        name: ^target_atom_realization_field_value_form,
        target: target_value_template_node(template: row.value_form)
      ),
      target_model_named_edge(
        name: ^target_atom_realization_field_constructor_form,
        target: target_constructor_template_node(form: row.constructor_form)
      ),
      target_model_named_edge(
        name: ^target_atom_realization_field_display_name,
        target: Node {
          kind: TypeNode { connective: Atom { identity: row.display_name } },
          children: [],
          occurrence_id: SyntheticOccurrence
}
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn target_atom_realization_catalog_edge(
  row: TargetAtomRealization,
  host_bundle: Node
) -> Edge {
  target_model_named_edge(
    name: row.display_name,
    target: target_atom_realization_to_node(row: row, host_bundle: host_bundle)
  )
}

fn target_atom_realization_catalog_snoc_edge(
  acc: List<Edge>,
  row: TargetAtomRealization,
  host_bundle: Node
) -> List<Edge> {
  list_snoc_item(
    xs: acc,
    item: target_atom_realization_catalog_edge(row: row, host_bundle: host_bundle)
  )
}

fn target_atom_realization_catalog_node(
  rows: List<TargetAtomRealization>,
  host_bundle: Node
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: fold_list(
      xs: rows,
      empty: Empty,
      cons: fn(acc, row) {
        target_atom_realization_catalog_snoc_edge(
          acc: acc,
          row: row,
          host_bundle: host_bundle
        )
      }
    ),
    occurrence_id: SyntheticOccurrence
}
}

fn target_atom_realization_target_model_bundle_mismatch_diagnostic(
  source_carrier: Node
) -> Diagnostic {
  Diagnostic {
    reason: ^target_atom_realization_target_model_bundle_mismatch,
    at: node_locus(node: source_carrier),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_atom_realization_catalog_row_decode_invalid_diagnostic(
  source_carrier: Node
) -> Diagnostic {
  Diagnostic {
    reason: ^target_atom_realization_catalog_row_decode_invalid,
    at: node_locus(node: source_carrier),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_atom_realization_catalog_lookup_step(
  acc: PassingCandidateFold,
  row_node: Node,
  source_carrier: Node,
  host_target_model: TargetModel
) -> PassingCandidateFold {
  match target_atom_realization_from_row_node(
    row_node: row_node,
    host_target_model: host_target_model
  ) {
    Accepted { value: row, diagnostics: _ } =>
      if content_hash(n: row.source_carrier) == content_hash(n: source_carrier) {
        match acc {
          NoPassingCandidate => OnePassingCandidate { candidate: row_node }
          OnePassingCandidate { candidate: _ } => ManyPassingCandidates
          ManyPassingCandidates => ManyPassingCandidates
        }
      } else {
        acc
      }
    Rejected { diagnostics: _ } => acc
  }
}

fn target_value_template_decode_invalid_diagnostic(source_carrier: Node) -> Diagnostic {
  Diagnostic {
    reason: ^target_value_template_decode_invalid,
    at: node_locus(node: source_carrier),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_type_expression_decode_invalid_diagnostic(source_carrier: Node) -> Diagnostic {
  Diagnostic {
    reason: ^target_type_expression_decode_invalid,
    at: node_locus(node: source_carrier),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_atom_realization_display_name_decode_invalid_diagnostic(
  source_carrier: Node
) -> Diagnostic {
  Diagnostic {
    reason: ^target_atom_realization_display_name_decode_invalid,
    at: node_locus(node: source_carrier),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_atom_realization_from_row_node(
  row_node: Node,
  host_target_model: TargetModel
) -> Outcome<TargetAtomRealization> {
  let source_carrier = target_atom_realization_conj_child(
    row_node: row_node,
    edge_name: ^target_atom_realization_field_source_carrier
  )
  let row_bundle = target_atom_realization_conj_child(
    row_node: row_node,
    edge_name: ^target_atom_realization_field_target_model_bundle
  )
  if target_atom_realization_bundle_matches_host(row_bundle: row_bundle, host: host_target_model) {
    match target_type_expression_from_node(
      n: target_atom_realization_conj_child(
        row_node: row_node,
        edge_name: ^target_atom_realization_field_type_form
      ),
      source_carrier: source_carrier
    ) {
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
      Accepted { value: type_form, diagnostics: _ } =>
        match target_value_template_from_node(
          n: target_atom_realization_conj_child(
            row_node: row_node,
            edge_name: ^target_atom_realization_field_value_form
          ),
          source_carrier: source_carrier
        ) {
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
          Accepted { value: value_form, diagnostics: _ } =>
            match target_constructor_template_from_node(
              n: target_atom_realization_conj_child(
                row_node: row_node,
                edge_name: ^target_atom_realization_field_constructor_form
              ),
              source_carrier: source_carrier
            ) {
              Rejected { diagnostics: r } => Rejected { diagnostics: r }
              Accepted { value: constructor_form, diagnostics: _ } =>
                match target_atom_realization_display_name_from_row(
                  row_node: row_node,
                  source_carrier: source_carrier
                ) {
                  Rejected { diagnostics: r } => Rejected { diagnostics: r }
                  Accepted { value: display_name, diagnostics: _ } =>
                    outcome_accepted(
                      TargetAtomRealization {
                        source_carrier: source_carrier,
                        target_model: host_target_model,
                        type_form: type_form,
                        value_form: value_form,
                        constructor_form: constructor_form,
                        display_name: display_name
                      }
                    )
                }
            }
        }
    }
  } else {
    outcome_rejected(
      target_atom_realization_target_model_bundle_mismatch_diagnostic(
        source_carrier: source_carrier
      )
    )
  }
}

fn target_atom_realization_conj_child(row_node: Node, edge_name: Symbol) -> Node {
  match row_node.kind {
    TypeNode { connective: Conj } =>
      fold(
        row_node.children,
        init: row_node,
        f: fn(acc, e) {
          match e.label {
            Named { name: n } =>
              if n == edge_name {
                e.target
              } else {
                acc
              }
            Positional => acc
          }
        }
      )
    _ => row_node
  }
}

fn target_type_expression_from_node(
  n: Node,
  source_carrier: Node
) -> Outcome<TargetTypeExpression> {
  match target_type_expr_emitted_kind(node: n) {
    TypeExprKindAuthority { value: kind } =>
      outcome_accepted(TargetTypeExpression { kind: kind, node: n })
    TypeExprKindNotEmitted =>
      outcome_rejected(
        target_type_expression_decode_invalid_diagnostic(source_carrier: source_carrier)
      )
    TypeExprKindAuthorityInvalid =>
      outcome_rejected(
        target_type_expression_decode_invalid_diagnostic(source_carrier: source_carrier)
      )
  }
}

fn target_value_template_from_node(
  n: Node,
  source_carrier: Node
) -> Outcome<TargetValueTemplate> {
  match n.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id == discriminant(v: ValueSymbolIdentityPassthrough) {
        outcome_accepted(
          TargetValueTemplate {
            kind: ValueSymbolIdentityPassthrough,
            node: n
          }
        )
      } else if id == discriminant(v: ValueSymbolToOwnedString) {
        outcome_accepted(
          TargetValueTemplate {
            kind: ValueSymbolToOwnedString,
            node: n
          }
        )
      } else if id == discriminant(v: ValueBoolLiteral) {
        outcome_accepted(
          TargetValueTemplate { kind: ValueBoolLiteral, node: n }
        )
      } else if id == discriminant(v: ValueCharUnicodeScalar) {
        outcome_accepted(
          TargetValueTemplate {
            kind: ValueCharUnicodeScalar,
            node: n
          }
        )
      } else if id == discriminant(v: ValueStringLiteral) {
        outcome_accepted(
          TargetValueTemplate {
            kind: ValueStringLiteral,
            node: n
          }
        )
      } else {
        outcome_rejected(
          target_value_template_decode_invalid_diagnostic(source_carrier: source_carrier)
        )
      }
    _ =>
      outcome_rejected(
        target_value_template_decode_invalid_diagnostic(source_carrier: source_carrier)
      )
  }
}

fn target_atom_realization_display_name_from_row(
  row_node: Node,
  source_carrier: Node
) -> Outcome<Symbol> {
  match target_atom_realization_conj_child(
    row_node: row_node,
    edge_name: ^target_atom_realization_field_display_name
  ).kind {
    TypeNode { connective: Atom { identity: id } } => outcome_accepted(id)
    _ =>
      outcome_rejected(
        target_atom_realization_display_name_decode_invalid_diagnostic(
          source_carrier: source_carrier
        )
      )
  }
}

fn target_atom_realization_lookup_in_catalog_node(
  catalog: Node,
  source_carrier: Node,
  host_target_model: TargetModel
) -> Outcome<TargetAtomRealization> {
  match catalog.kind {
    TypeNode { connective: Conj } =>
      match fold(
        catalog.children,
        init: NoPassingCandidate,
        f: fn(acc, e) {
          target_atom_realization_catalog_lookup_step(
            acc: acc,
            row_node: e.target,
            source_carrier: source_carrier,
            host_target_model: host_target_model
          )
        }
      ) {
        NoPassingCandidate =>
          outcome_rejected(target_atom_realization_lookup_miss_diagnostic(source_carrier: source_carrier))
        OnePassingCandidate { candidate: row_node } =>
          target_atom_realization_from_row_node(
            row_node: row_node,
            host_target_model: host_target_model
          )
        ManyPassingCandidates =>
          outcome_rejected(target_atom_realization_lookup_ambiguous_diagnostic(source_carrier: source_carrier))
      }
    _ =>
      outcome_rejected(
        target_atom_realization_catalog_row_decode_invalid_diagnostic(source_carrier: source_carrier)
      )
  }
}

// --- SG-1b function-boundary signature realization (sibling to SG-1; catalog label SG-1-FOLLOWON) ---
//
// TargetFunctionSignatureRealization supplies the signature_type_form for a fn entry/exit
// (Param/Return) site, keyed by the SAME source_carrier Node identity as the SG-1
// TargetAtomRealization row. It does NOT duplicate the atom catalog: per-language rows
// reference SG-1 type_form by field projection (see extdeps/languages/<lang>.dag), so changing
// one realization row moves both the signature annotation and the value body together.
//
// M6: FunctionBoundarySite is a pure nullary discriminator (mirror of TargetTypeExprKind);
// TargetFunctionSignatureRealization is a product (heterogeneous fields), not an N-arm
// identical-payload coproduct.



// 🟢 terminal coproduct — fn entry/exit site discriminator. The Arrow connective has exactly two
// boundary roles (domain = Param, codomain = Return); the axis is closed by Arrow's shape, so there
// is nothing further to dissolve. Nullary arms (no payload axis) — mirror of TargetTypeExprKind.
type FunctionBoundarySite
  = FunctionBoundaryParam
  | FunctionBoundaryReturn

// 🟢 product carrier (M6) — SG-1b function-boundary signature realization. Fields are heterogeneous
// (Node key, host model, boundary discriminator, SG-2 type expression); this is NOT an N-arm
// identical-payload coproduct. signature_type_form is sourced BY REFERENCE from the paired SG-1
// TargetAtomRealization (shared source_carrier), so it carries no second atom catalog.
type TargetFunctionSignatureRealization {
  source_carrier: Node
  target_model: TargetModel
  boundary_site: FunctionBoundarySite
  signature_type_form: TargetTypeExpression
}

fn target_function_boundary_site_to_node(site: FunctionBoundarySite) -> Node {
  Node {
    kind: TypeNode {
      connective: Atom { identity: discriminant(v: site) }
    },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn target_function_boundary_site_eq(a: FunctionBoundarySite, b: FunctionBoundarySite) -> Bool {
  discriminant(v: a) == discriminant(v: b)
}

fn target_function_signature_realization_lookup_miss_diagnostic(source_carrier: Node) -> Diagnostic {
  Diagnostic {
    reason: ^target_function_signature_realization_lookup_miss,
    at: node_locus(node: source_carrier),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_function_signature_realization_lookup_ambiguous_diagnostic(source_carrier: Node) -> Diagnostic {
  Diagnostic {
    reason: ^target_function_signature_realization_lookup_ambiguous,
    at: node_locus(node: source_carrier),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_function_signature_realization_row_decode_invalid_diagnostic(source_carrier: Node) -> Diagnostic {
  Diagnostic {
    reason: ^target_function_signature_realization_row_decode_invalid,
    at: node_locus(node: source_carrier),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_function_signature_realization_target_model_bundle_mismatch_diagnostic(source_carrier: Node) -> Diagnostic {
  Diagnostic {
    reason: ^target_function_signature_realization_target_model_bundle_mismatch,
    at: node_locus(node: source_carrier),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_function_boundary_site_decode_invalid_diagnostic(source_carrier: Node) -> Diagnostic {
  Diagnostic {
    reason: ^target_function_boundary_site_decode_invalid,
    at: node_locus(node: source_carrier),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_function_boundary_site_from_node(
  n: Node,
  source_carrier: Node
) -> Outcome<FunctionBoundarySite> {
  match n.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if is_empty(xs: n.children) {
        if id == discriminant(v: FunctionBoundaryParam) {
          outcome_accepted(FunctionBoundaryParam)
        } else if id == discriminant(v: FunctionBoundaryReturn) {
          outcome_accepted(FunctionBoundaryReturn)
        } else {
          outcome_rejected(
            target_function_boundary_site_decode_invalid_diagnostic(source_carrier: source_carrier)
          )
        }
      } else {
        outcome_rejected(
          target_function_boundary_site_decode_invalid_diagnostic(source_carrier: source_carrier)
        )
      }
    _ =>
      outcome_rejected(
        target_function_boundary_site_decode_invalid_diagnostic(source_carrier: source_carrier)
      )
  }
}

// Single host authority: the encoded bundle is derived from row.target_model (its catalog-stripped
// core), NOT a separately-threaded host_bundle that could disagree with the row's declared model.
// target_model_bundle_core strips realization-catalog edges so the encoded bundle matches
// core(live host) on decode regardless of which catalogs the live host carries.
fn target_function_signature_realization_to_node(
  row: TargetFunctionSignatureRealization
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      target_model_named_edge(
        name: ^target_function_signature_realization_field_source_carrier,
        target: row.source_carrier
      ),
      target_model_named_edge(
        name: ^target_function_signature_realization_field_target_model_bundle,
        target: target_model_bundle_core(host: row.target_model)
      ),
      target_model_named_edge(
        name: ^target_function_signature_realization_field_boundary_site,
        target: target_function_boundary_site_to_node(site: row.boundary_site)
      ),
      target_model_named_edge(
        name: ^target_function_signature_realization_field_signature_type_form,
        target: row.signature_type_form.node
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

// Catalog rows are POSITIONAL slots, not Named edges: the (source_carrier, boundary_site)
// lookup key lives inside each encoded row, so a Named edge keyed on either coordinate alone
// would alias a second row at the same boundary (or same carrier) into a duplicate Conj edge
// name. Positional slots keep every (carrier × site) row representable without collision.
fn target_function_signature_realization_catalog_edge(
  row: TargetFunctionSignatureRealization
) -> Edge {
  Edge {
    label: Positional,
    target: target_function_signature_realization_to_node(row: row)
  }
}

fn target_function_signature_realization_catalog_snoc_edge(
  acc: List<Edge>,
  row: TargetFunctionSignatureRealization
) -> List<Edge> {
  list_snoc_item(
    xs: acc,
    item: target_function_signature_realization_catalog_edge(row: row)
  )
}

fn target_function_signature_realization_catalog_node(
  rows: List<TargetFunctionSignatureRealization>
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: fold_list(
      xs: rows,
      empty: Empty,
      cons: fn(acc, row) {
        target_function_signature_realization_catalog_snoc_edge(
          acc: acc,
          row: row
        )
      }
    ),
    occurrence_id: SyntheticOccurrence
}
}

fn target_function_signature_realization_from_row_node(
  row_node: Node,
  host_target_model: TargetModel
) -> Outcome<TargetFunctionSignatureRealization> {
  let source_carrier = target_atom_realization_conj_child(
    row_node: row_node,
    edge_name: ^target_function_signature_realization_field_source_carrier
  )
  let row_bundle = target_atom_realization_conj_child(
    row_node: row_node,
    edge_name: ^target_function_signature_realization_field_target_model_bundle
  )
  if target_atom_realization_bundle_matches_host(row_bundle: row_bundle, host: host_target_model) {
    match target_function_boundary_site_from_node(
      n: target_atom_realization_conj_child(
        row_node: row_node,
        edge_name: ^target_function_signature_realization_field_boundary_site
      ),
      source_carrier: source_carrier
    ) {
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
      Accepted { value: boundary_site, diagnostics: _ } =>
        match target_type_expression_from_node(
          n: target_atom_realization_conj_child(
            row_node: row_node,
            edge_name: ^target_function_signature_realization_field_signature_type_form
          ),
          source_carrier: source_carrier
        ) {
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
          Accepted { value: signature_type_form, diagnostics: _ } =>
            outcome_accepted(
              TargetFunctionSignatureRealization {
                source_carrier: source_carrier,
                target_model: host_target_model,
                boundary_site: boundary_site,
                signature_type_form: signature_type_form
              }
            )
        }
    }
  } else {
    outcome_rejected(
      target_function_signature_realization_target_model_bundle_mismatch_diagnostic(
        source_carrier: source_carrier
      )
    )
  }
}

// 🟢 coproduct dissolution — internal fold state for the SG-1b signature-realization catalog scan
// (Result-style: heterogeneous arms — Unique carries a row payload, the other three are nullary
// outcome tags). Not an N-arm identical-payload coproduct; PassingCandidateFold does not apply here.
type TargetFunctionSignatureRealizationCatalogLookup
  = TargetFunctionSignatureRealizationCatalogMissing
  | TargetFunctionSignatureRealizationCatalogUnique { row: TargetFunctionSignatureRealization }
  | TargetFunctionSignatureRealizationCatalogAmbiguous
  | TargetFunctionSignatureRealizationCatalogInvalid

fn target_function_signature_realization_catalog_lookup_step(
  acc: TargetFunctionSignatureRealizationCatalogLookup,
  row_node: Node,
  source_carrier: Node,
  boundary_site: FunctionBoundarySite,
  host_target_model: TargetModel
) -> TargetFunctionSignatureRealizationCatalogLookup {
  match target_function_signature_realization_from_row_node(
    row_node: row_node,
    host_target_model: host_target_model
  ) {
    Accepted { value: row, diagnostics: _ } =>
      if content_hash(n: row.source_carrier) == content_hash(n: source_carrier)
        && target_function_boundary_site_eq(a: row.boundary_site, b: boundary_site) {
        match acc {
          TargetFunctionSignatureRealizationCatalogMissing =>
            TargetFunctionSignatureRealizationCatalogUnique { row: row }
          TargetFunctionSignatureRealizationCatalogUnique { row: _ } =>
            TargetFunctionSignatureRealizationCatalogAmbiguous
          TargetFunctionSignatureRealizationCatalogAmbiguous =>
            TargetFunctionSignatureRealizationCatalogAmbiguous
          TargetFunctionSignatureRealizationCatalogInvalid =>
            TargetFunctionSignatureRealizationCatalogInvalid
        }
      } else {
        acc
      }
    Rejected { diagnostics: _ } => TargetFunctionSignatureRealizationCatalogInvalid
  }
}

fn target_function_signature_realization_lookup_in_catalog_node(
  catalog: Node,
  source_carrier: Node,
  boundary_site: FunctionBoundarySite,
  host_target_model: TargetModel
) -> Outcome<TargetFunctionSignatureRealization> {
  match catalog.kind {
    TypeNode { connective: Conj } =>
      match fold(
        catalog.children,
        init: TargetFunctionSignatureRealizationCatalogMissing,
        f: fn(acc, e) {
          target_function_signature_realization_catalog_lookup_step(
            acc: acc,
            row_node: e.target,
            source_carrier: source_carrier,
            boundary_site: boundary_site,
            host_target_model: host_target_model
          )
        }
      ) {
        TargetFunctionSignatureRealizationCatalogMissing =>
          outcome_rejected(
            target_function_signature_realization_lookup_miss_diagnostic(source_carrier: source_carrier)
          )
        TargetFunctionSignatureRealizationCatalogUnique { row: row } =>
          Accepted { value: row, diagnostics: None }
        TargetFunctionSignatureRealizationCatalogAmbiguous =>
          outcome_rejected(
            target_function_signature_realization_lookup_ambiguous_diagnostic(source_carrier: source_carrier)
          )
        TargetFunctionSignatureRealizationCatalogInvalid =>
          outcome_rejected(
            target_function_signature_realization_row_decode_invalid_diagnostic(source_carrier: source_carrier)
          )
      }
    _ =>
      outcome_rejected(
        target_function_signature_realization_row_decode_invalid_diagnostic(source_carrier: source_carrier)
      )
  }
}
// TargetModel bundle edge — per-language TargetTypeExpressionProjection row (SG-2).

// Emitted type-expression Conj fields — declared kind coproduct tag + surface + positional slots.

// 🟢 coproduct dissolution — SG-2 emitted type-expression wire-shape tag (six projection row forms).
type TargetTypeExprKind
  = TargetTypeExprAtom
  | TargetTypeExprInstantiation
  | TargetTypeExprCardinality
  | TargetTypeExprRecord
  | TargetTypeExprSum
  | TargetTypeExprArrow

// TargetTypeExpressionProjection bundle edge keys (row stored on TargetModel bundle).

// 🟢 coproduct dissolution — SG-2 emitted arrow wire encodes positional inputs+codomain vs labeled param slots+codomain (authority: target_type_expr_arrow_wire_shape on emitted node).
type TargetTypeExprArrowWireShape
  = TargetTypeExprArrowPositionalWire
  | TargetTypeExprArrowLabeledWire

fn target_type_expr_arrow_wire_shape(node: Node) -> Outcome<TargetTypeExprArrowWireShape> {
  let positional = node_positional_child_targets(node: node)
  if is_empty(xs: positional) {
    match find_named_child(root: node, name: ^target_type_expr_field_codomain) {
      Accepted { value: _, diagnostics: d } =>
        Accepted { value: TargetTypeExprArrowLabeledWire, diagnostics: d }
      Rejected { diagnostics: _ } =>
        outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
    }
  } else {
    if length(xs: positional) >= 2 {
      match target_type_expr_fold_named_metadata_edges(node: node) {
        NamedMetadataFoldOk { kind_seen: true, surface_seen: true, extra_named: 0 } =>
          outcome_accepted(TargetTypeExprArrowPositionalWire)
        _ =>
          outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
      }
    } else {
      outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
    }
  }
}

// 🟢 coproduct dissolution — SG-2 labeled arrow parameter slot (label required; distinct from record TargetTypeExprFieldSlot).
type TargetTypeExprArrowParamSlot {
  label: Symbol
  type_expr: Node
}

// SG-2 — atom type name: bound ident from source Atom identity via binding_spellings.
type TargetAtomTypeShape {
  surface: Symbol
  ident_token: Symbol
}

// SG-2 — delimited-surface shape (generic apply F<A,B>, record { f: T }, shared open/separator/close).
type TargetGenericApply {
  surface: Symbol
  open: Symbol
  separator: Symbol
  field_label_separator: Optional<Symbol>
  close: Symbol
}

// SG-2 — sum / disj coproduct type.
type TargetSumTypeShape {
  surface: Symbol
  variant_separator: Symbol
}

// SG-2 — labeled Conj field slot (substrate LabeledEdges preserved through projection).
type TargetTypeExprFieldSlot {
  label: Symbol
  type_expr: Node
}

// SG-2 — labeled Disj variant slot (substrate LabeledEdges preserved through projection).
type TargetTypeExprVariantSlot {
  label: Symbol
  type_expr: Node
}

// SG-2 — function / arrow type (domain -> codomain).
type TargetFunctionTypeShape {
  surface: Symbol
  open: Symbol
  close: Symbol
  arrow: Symbol
  param_ident_token: Symbol
  param_type_separator: Symbol
  param_list_separator: Symbol
}

// 🟢 coproduct dissolution — SG-2 declared emitted type-expression wire authority (M6 product carrier; kind axis is TargetTypeExprKind).
type TargetTypeExpression {
  kind: TargetTypeExprKind
  node: Node
}

// SG-2 — canonical per-connective type-expression projection (one row per target language).
type TargetTypeExpressionProjection {
  atom_form: TargetAtomTypeShape
  conj_form: TargetGenericApply
  disj_form: TargetSumTypeShape
  arrow_form: TargetFunctionTypeShape
  cardinality_form: TargetGenericApply
  instantiation_form: TargetGenericApply
}

fn target_type_expr_surface_edge(surface: Symbol) -> Edge {
  Edge {
    label: Named { name: ^target_type_expr_field_surface },
    target: Node {
      kind: TypeNode { connective: Atom { identity: surface } },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

fn target_type_expr_kind_from_atom(id: Symbol) -> Optional<TargetTypeExprKind> {
  if id == discriminant(v: TargetTypeExprAtom) {
    optional_present(value: TargetTypeExprAtom)
  } else {
    if id == discriminant(v: TargetTypeExprInstantiation) {
      optional_present(value: TargetTypeExprInstantiation)
    } else {
      if id == discriminant(v: TargetTypeExprCardinality) {
        optional_present(value: TargetTypeExprCardinality)
      } else {
        if id == discriminant(v: TargetTypeExprRecord) {
          optional_present(value: TargetTypeExprRecord)
        } else {
          if id == discriminant(v: TargetTypeExprSum) {
            optional_present(value: TargetTypeExprSum)
          } else {
            if id == discriminant(v: TargetTypeExprArrow) {
              optional_present(value: TargetTypeExprArrow)
            } else {
              optional_absent()
            }
          }
        }
      }
    }
  }
}


// Emitted-wire kind authority probe — exactly-one decodable kind marker, or fail-closed invalid.
// 🟢 coproduct dissolution — SG-2 emitted type-expression kind authority read surface.
type TargetTypeExprKindProbe
  = TypeExprKindAuthority { value: TargetTypeExprKind }
  | TypeExprKindNotEmitted
  | TypeExprKindAuthorityInvalid

// 🟢 coproduct dissolution — internal fold state for target_type_expr_emitted_kind authority scan.
type TargetTypeExprKindAuthorityFold
  = KindAuthorityFoldNone
  | KindAuthorityFoldUnique { value: TargetTypeExprKind }
  | KindAuthorityFoldConflict

// 🟢 coproduct dissolution — internal edge decode for target_type_expr_emitted_kind authority scan.
type TargetTypeExprKindEdgeDecode
  = KindEdgeNotKindField
  | KindEdgeAuthority { value: TargetTypeExprKind }
  | KindEdgeAuthorityMalformed

fn target_type_expr_decode_kind_edge(edge: Edge) -> TargetTypeExprKindEdgeDecode {
  match edge.label {
    Named { name: n } =>
      if n == ^target_type_expr_field_kind {
        match edge.target.kind {
          TypeNode { connective: Atom { identity: id } } =>
            match target_type_expr_kind_from_atom(id: id) {
              Present { value: kind } => KindEdgeAuthority { value: kind }
              Absent => KindEdgeAuthorityMalformed
            }
          _ => KindEdgeAuthorityMalformed
        }
      } else {
        KindEdgeNotKindField
      }
    Positional => KindEdgeNotKindField
  }
}

fn target_type_expr_emitted_kind(node: Node) -> TargetTypeExprKindProbe {
  match node.kind {
    TypeNode { connective: Conj } =>
      match fold(node.children, init: KindAuthorityFoldNone, f: fn(acc, e) {
        match acc {
          KindAuthorityFoldConflict => acc
          KindAuthorityFoldNone =>
            match target_type_expr_decode_kind_edge(edge: e) {
              KindEdgeNotKindField => acc
              KindEdgeAuthorityMalformed => KindAuthorityFoldConflict
              KindEdgeAuthority { value: kind } =>
                KindAuthorityFoldUnique { value: kind }
            }
          KindAuthorityFoldUnique { value: _ } =>
            match target_type_expr_decode_kind_edge(edge: e) {
              KindEdgeNotKindField => acc
              KindEdgeAuthorityMalformed => KindAuthorityFoldConflict
              KindEdgeAuthority { value: _ } => KindAuthorityFoldConflict
            }
        }
      }) {
        KindAuthorityFoldNone => TypeExprKindNotEmitted
        KindAuthorityFoldUnique { value: kind } =>
          TypeExprKindAuthority { value: kind }
        KindAuthorityFoldConflict => TypeExprKindAuthorityInvalid
      }
    _ => TypeExprKindNotEmitted
  }
}

fn target_type_expr_kind_edge(kind: TargetTypeExprKind) -> Edge {
  Edge {
    label: Named { name: ^target_type_expr_field_kind },
    target: Node {
      kind: TypeNode {
        connective: Atom { identity: discriminant(v: kind) }
      },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

fn target_type_expr_positional_edges(children: List<Node>) -> List<Edge> {
  fold_list(
    xs: children,
    empty: Empty,
    cons: fn(acc, child) {
      list_snoc_item(
        xs: acc,
        item: Edge { label: Positional, target: child }
      )
    }
  )
}

fn target_type_expr_wrapped_emitted(
  kind: TargetTypeExprKind,
  surface: Symbol,
  children: List<Node>
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: list_snoc_item(
      xs: list_snoc_item(
        xs: target_type_expr_positional_edges(children: children),
        item: target_type_expr_surface_edge(surface: surface)
      ),
      item: target_type_expr_kind_edge(kind: kind)
    ),
    occurrence_id: SyntheticOccurrence
}
}

fn target_type_expr_atom_emitted(form: TargetAtomTypeShape, identity: Symbol) -> Node {
  target_type_expr_wrapped_emitted(
    kind: TargetTypeExprAtom,
    surface: form.surface,
    children: [
      Node {
        kind: TypeNode { connective: Atom { identity: identity } },
        children: [],
        occurrence_id: SyntheticOccurrence
}
    ]
  )
}

fn target_atom_alias_type_expression(
  spelling: Symbol,
  atom_form: TargetAtomTypeShape
) -> TargetTypeExpression {
  TargetTypeExpression {
    kind: TargetTypeExprAtom,
    node: target_type_expr_atom_emitted(form: atom_form, identity: spelling)
  }
}

fn target_type_expr_wrapped_emitted_labeled(
  kind: TargetTypeExprKind,
  surface: Symbol,
  slot_edges: List<Edge>
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: list_append(
      left: list_append(
        left: slot_edges,
        right: Cons { head: target_type_expr_surface_edge(surface: surface), tail: Empty }
      ),
      right: Cons { head: target_type_expr_kind_edge(kind: kind), tail: Empty }
    ),
    occurrence_id: SyntheticOccurrence
}
}

fn target_type_expr_instantiation_emitted(
  form: TargetGenericApply,
  head: Node,
  args: List<Node>
) -> Node {
  target_type_expr_wrapped_emitted(
    kind: TargetTypeExprInstantiation,
    surface: form.surface,
    children: list_append(
      left: Cons { head: head, tail: Empty },
      right: args
    )
  )
}

fn target_type_expr_cardinality_emitted(
  form: TargetGenericApply,
  head: Node,
  args: List<Node>
) -> Node {
  target_type_expr_wrapped_emitted(
    kind: TargetTypeExprCardinality,
    surface: form.surface,
    children: list_append(
      left: Cons { head: head, tail: Empty },
      right: args
    )
  )
}

fn target_type_expr_field_slot_edges(fields: List<TargetTypeExprFieldSlot>) -> List<Edge> {
  fold(fields, init: Empty, f: fn(acc, field) {
    list_snoc_item(
      xs: acc,
      item: Edge { label: Named { name: field.label }, target: field.type_expr }
    )
  })
}

fn target_type_expr_arrow_param_slot_edges(params: List<TargetTypeExprArrowParamSlot>) -> List<Edge> {
  fold(params, init: Empty, f: fn(acc, param) {
    list_snoc_item(
      xs: acc,
      item: Edge { label: Named { name: param.label }, target: param.type_expr }
    )
  })
}

fn target_type_expr_variant_slot_edges(variants: List<TargetTypeExprVariantSlot>) -> List<Edge> {
  fold(variants, init: Empty, f: fn(acc, variant) {
    list_snoc_item(
      xs: acc,
      item: Edge { label: Named { name: variant.label }, target: variant.type_expr }
    )
  })
}

fn target_type_expr_emitted_slot_type_nodes(node: Node) -> List<Node> {
  fold(node.children, init: Empty, f: fn(acc, e) {
    match e.label {
      Named { name: n } =>
        if n == ^target_type_expr_field_surface || n == ^target_type_expr_field_kind {
          acc
        } else {
          list_snoc_item(xs: acc, item: e.target)
        }
      Positional => acc
    }
  })
}

fn target_type_expr_emitted_shape_malformed_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: ^target_type_expr_emitted_shape_malformed,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

// 🟢 coproduct dissolution — internal fold state for emitted metadata edge scan.
type TargetTypeExprNamedMetadataFold
  = NamedMetadataFoldMalformed
  | NamedMetadataFoldOk { kind_seen: Bool, surface_seen: Bool, extra_named: Int }

fn target_type_expr_fold_named_metadata_edges(node: Node) -> TargetTypeExprNamedMetadataFold {
  match fold(node.children, init: NamedMetadataFoldOk { kind_seen: false, surface_seen: false, extra_named: 0 }, f: fn(acc, e) {
    match acc {
      NamedMetadataFoldMalformed => acc
      NamedMetadataFoldOk { kind_seen, surface_seen, extra_named } =>
        match e.label {
          Positional => acc
          Named { name: n } =>
            if n == ^target_type_expr_field_kind {
              if kind_seen {
                NamedMetadataFoldMalformed
              } else {
                match e.target.kind {
                  TypeNode { connective: Atom { identity: _ } } =>
                    NamedMetadataFoldOk { kind_seen: true, surface_seen, extra_named }
                  _ => NamedMetadataFoldMalformed
                }
              }
            } else {
              if n == ^target_type_expr_field_surface {
                if surface_seen {
                  NamedMetadataFoldMalformed
                } else {
                  match e.target.kind {
                    TypeNode { connective: Atom { identity: _ } } =>
                      NamedMetadataFoldOk { kind_seen, surface_seen: true, extra_named }
                    _ => NamedMetadataFoldMalformed
                  }
                }
              } else {
                NamedMetadataFoldOk { kind_seen, surface_seen, extra_named: extra_named + 1 }
              }
            }
        }
    }
  }) {
    NamedMetadataFoldOk { kind_seen, surface_seen, extra_named } =>
      if kind_seen && surface_seen {
        NamedMetadataFoldOk { kind_seen, surface_seen, extra_named }
      } else {
        NamedMetadataFoldMalformed
      }
    NamedMetadataFoldMalformed => NamedMetadataFoldMalformed
  }
}

fn target_type_expr_emitted_surface_identity(node: Node) -> Outcome<Symbol> {
  match find_named_child(root: node, name: ^target_type_expr_field_surface) {
    Accepted { value: child, diagnostics: d } =>
      match child.kind {
        TypeNode { connective: Atom { identity: id } } =>
          Accepted { value: id, diagnostics: d }
        _ => outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn target_type_expression_spelling(form: TargetTypeExpression) -> Symbol {
  match target_type_expr_emitted_surface_identity(node: form.node) {
    Accepted { value: surface, diagnostics: _ } => surface
    Rejected { diagnostics: _ } => ^target_type_expression_decode_invalid
  }
}

fn target_atom_type_spelling(row: TargetAtomRealization) -> Symbol {
  target_type_expression_spelling(form: row.type_form)
}

fn target_type_expr_expected_surface_for_kind(
  kind: TargetTypeExprKind,
  projection: TargetTypeExpressionProjection
) -> Symbol {
  match kind {
    TargetTypeExprAtom => projection.atom_form.surface
    TargetTypeExprInstantiation => projection.instantiation_form.surface
    TargetTypeExprCardinality => projection.cardinality_form.surface
    TargetTypeExprRecord => projection.conj_form.surface
    TargetTypeExprSum => projection.disj_form.surface
    TargetTypeExprArrow => projection.arrow_form.surface
  }
}

fn target_type_expr_emitted_validate_positional_arity(
  node: Node,
  kind: TargetTypeExprKind
) -> Outcome<Bool> {
  let positional = node_positional_child_targets(node: node)
  match kind {
    TargetTypeExprAtom =>
      if length(xs: positional) == 1 {
        Accepted { value: true, diagnostics: None }
      } else {
        outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
      }
    TargetTypeExprInstantiation =>
      if length(xs: positional) >= 1 {
        Accepted { value: true, diagnostics: None }
      } else {
        outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
      }
    TargetTypeExprCardinality =>
      if length(xs: positional) >= 1 {
        Accepted { value: true, diagnostics: None }
      } else {
        outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
      }
    TargetTypeExprArrow =>
      match target_type_expr_arrow_wire_shape(node: node) {
        Accepted { value: TargetTypeExprArrowPositionalWire, diagnostics: None } =>
          Accepted { value: true, diagnostics: None }
        Accepted { value: TargetTypeExprArrowLabeledWire, diagnostics: None } =>
          outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    TargetTypeExprRecord =>
      outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
    TargetTypeExprSum =>
      outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
  }
}

fn target_type_expr_emitted_validate_positional_wire(
  node: Node,
  kind: TargetTypeExprKind,
  projection: TargetTypeExpressionProjection
) -> Outcome<Bool> {
  match target_type_expr_emitted_kind(node: node) {
    TypeExprKindAuthority { value: decoded } =>
      if decoded == kind {
        match target_type_expr_fold_named_metadata_edges(node: node) {
          NamedMetadataFoldOk { kind_seen: true, surface_seen: true, extra_named: 0 } =>
            match target_type_expr_emitted_surface_identity(node: node) {
              Accepted { value: surface, diagnostics: d } =>
                if surface == target_type_expr_expected_surface_for_kind(kind: kind, projection: projection) {
                  match target_type_expr_emitted_validate_positional_arity(node: node, kind: kind) {
                    Accepted { value: true, diagnostics: d2 } =>
                      Accepted { value: true, diagnostics: diagnostics_merge(outer: d, inner: d2) }
                    Rejected { diagnostics: r } => Rejected { diagnostics: r }
                  }
                } else {
                  outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
                }
              Rejected { diagnostics: r } => Rejected { diagnostics: r }
            }
          _ => outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
        }
      } else {
        outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
      }
    TypeExprKindNotEmitted =>
      outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
    TypeExprKindAuthorityInvalid =>
      outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
  }
}

fn target_type_expr_emitted_validate_labeled_wire(
  node: Node,
  kind: TargetTypeExprKind,
  projection: TargetTypeExpressionProjection
) -> Outcome<Bool> {
  if is_empty(xs: node_positional_child_targets(node: node)) {
    match target_type_expr_emitted_kind(node: node) {
      TypeExprKindAuthority { value: decoded } =>
        if decoded == kind {
          match target_type_expr_fold_named_metadata_edges(node: node) {
            NamedMetadataFoldOk { kind_seen: true, surface_seen: true, extra_named: _ } =>
              match target_type_expr_emitted_surface_identity(node: node) {
                Accepted { value: surface, diagnostics: d } =>
                  if surface == target_type_expr_expected_surface_for_kind(kind: kind, projection: projection) {
                    Accepted { value: true, diagnostics: d }
                  } else {
                    outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
                  }
                Rejected { diagnostics: r } => Rejected { diagnostics: r }
              }
            _ => outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
          }
        } else {
          outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
        }
      TypeExprKindNotEmitted =>
        outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
      TypeExprKindAuthorityInvalid =>
        outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
    }
  } else {
    outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
  }
}

fn target_type_expr_emitted_validate_wire_shape(
  node: Node,
  kind: TargetTypeExprKind,
  projection: TargetTypeExpressionProjection
) -> Outcome<Bool> {
  match kind {
    TargetTypeExprRecord =>
      target_type_expr_emitted_validate_labeled_wire(
        node: node,
        kind: kind,
        projection: projection
      )
    TargetTypeExprSum =>
      target_type_expr_emitted_validate_labeled_wire(
        node: node,
        kind: kind,
        projection: projection
      )
    TargetTypeExprArrow =>
      match target_type_expr_arrow_wire_shape(node: node) {
        Accepted { value: TargetTypeExprArrowLabeledWire, diagnostics: None } =>
          target_type_expr_emitted_validate_labeled_wire(
            node: node,
            kind: kind,
            projection: projection
          )
        Accepted { value: TargetTypeExprArrowPositionalWire, diagnostics: None } =>
          target_type_expr_emitted_validate_positional_wire(
            node: node,
            kind: kind,
            projection: projection
          )
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    _ =>
      target_type_expr_emitted_validate_positional_wire(
        node: node,
        kind: kind,
        projection: projection
      )
  }
}

fn target_type_expr_emitted_wire_decode(
  node: Node,
  projection: TargetTypeExpressionProjection
) -> Outcome<TargetTypeExpression> {
  match target_type_expr_emitted_kind(node: node) {
    TypeExprKindAuthority { value: kind } =>
      match target_type_expr_emitted_validate_wire_shape(
        node: node,
        kind: kind,
        projection: projection
      ) {
        Accepted { value: _, diagnostics: d } =>
          Accepted {
            value: TargetTypeExpression { kind: kind, node: node },
            diagnostics: d
          }
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    TypeExprKindNotEmitted =>
      outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
    TypeExprKindAuthorityInvalid =>
      outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
  }
}

fn target_type_expr_emitted_labeled_slot_nodes(node: Node) -> Outcome<List<Node>> {
  if is_empty(xs: node_positional_child_targets(node: node)) {
    Accepted {
      value: target_type_expr_emitted_slot_type_nodes(node: node),
      diagnostics: None
    }
  } else {
    outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
  }
}

fn target_type_expr_emitted_labeled_slot_edges(node: Node) -> Outcome<List<Edge>> {
  if is_empty(xs: node_positional_child_targets(node: node)) {
    Accepted {
      value: fold(node.children, init: Empty, f: fn(acc, e) {
        match e.label {
          Named { name: n } =>
            if n == ^target_type_expr_field_surface || n == ^target_type_expr_field_kind {
              acc
            } else {
              list_snoc_item(xs: acc, item: e)
            }
          Positional => acc
        }
      }),
      diagnostics: None
    }
  } else {
    outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
  }
}

fn target_type_expr_record_emitted(
  form: TargetGenericApply,
  fields: List<TargetTypeExprFieldSlot>
) -> Node {
  target_type_expr_wrapped_emitted_labeled(
    kind: TargetTypeExprRecord,
    surface: form.surface,
    slot_edges: target_type_expr_field_slot_edges(fields: fields)
  )
}

fn target_type_expr_sum_emitted(
  form: TargetSumTypeShape,
  variants: List<TargetTypeExprVariantSlot>
) -> Node {
  target_type_expr_wrapped_emitted_labeled(
    kind: TargetTypeExprSum,
    surface: form.surface,
    slot_edges: target_type_expr_variant_slot_edges(variants: variants)
  )
}

fn target_type_expr_arrow_emitted(
  form: TargetFunctionTypeShape,
  inputs: List<Node>,
  output: Node
) -> Node {
  target_type_expr_wrapped_emitted(
    kind: TargetTypeExprArrow,
    surface: form.surface,
    children: list_append(left: inputs, right: Cons { head: output, tail: Empty })
  )
}

fn target_type_expr_arrow_emitted_named(
  form: TargetFunctionTypeShape,
  params: List<TargetTypeExprArrowParamSlot>,
  output: Node
) -> Node {
  target_type_expr_wrapped_emitted_labeled(
    kind: TargetTypeExprArrow,
    surface: form.surface,
    slot_edges: list_append(
      left: target_type_expr_arrow_param_slot_edges(params: params),
      right: Cons {
        head: Edge {
          label: Named { name: ^target_type_expr_field_codomain },
          target: output
        },
        tail: Empty
      }
    )
  )
}

fn target_type_expr_arrow_labeled_codomain(node: Node) -> Outcome<Node> {
  match target_type_expr_arrow_wire_shape(node: node) {
    Accepted { value: TargetTypeExprArrowLabeledWire, diagnostics: d } =>
      match find_named_child(root: node, name: ^target_type_expr_field_codomain) {
        Accepted { value: child, diagnostics: dc } =>
          Accepted {
            value: child,
            diagnostics: diagnostics_merge(outer: d, inner: dc)
          }
        Rejected { diagnostics: _ } =>
          outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
      }
    Accepted { value: TargetTypeExprArrowPositionalWire, diagnostics: _ } =>
      outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn target_type_expr_arrow_labeled_param_slots(node: Node) -> Outcome<List<TargetTypeExprArrowParamSlot>> {
  match target_type_expr_arrow_wire_shape(node: node) {
    Accepted { value: TargetTypeExprArrowLabeledWire, diagnostics: d } =>
      bind_outcome(
        o: target_type_expr_arrow_labeled_codomain(node: node),
        f: fn(_codomain) {
          if is_empty(xs: node_positional_child_targets(node: node)) {
            Accepted {
              value: fold(
                xs: node_labeled_child_edges(node: node),
                init: Empty,
                f: fn(acc, e) {
                  match e.label {
                    Named { name: label } =>
                      if label == ^target_type_expr_field_surface ||
                        label == ^target_type_expr_field_kind ||
                        label == ^target_type_expr_field_codomain {
                        acc
                      } else {
                        list_snoc_item(
                          xs: acc,
                          item: TargetTypeExprArrowParamSlot { label: label, type_expr: e.target }
                        )
                      }
                    Positional => acc
                  }
                }
              ),
              diagnostics: d
            }
          } else {
            outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
          }
        }
      )
    Accepted { value: TargetTypeExprArrowPositionalWire, diagnostics: _ } =>
      outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

// ═══ SG-5 — TargetCollectionRealization (canonical home) ═══


// 🟢 coproduct dissolution — SG-5 collection representation kind axis (M6 product; no duplicate-payload arms).
type TargetCollectionReprKind
  = TargetCollectionReprBTreeSet
  | TargetCollectionReprHashSet
  | TargetCollectionReprVec

// SG-5 — per-representation wire authority (kind + generic-apply shape; no fill-in String templates).
type TargetRepresentation {
  kind: TargetCollectionReprKind
  apply: TargetGenericApply
}

// 🟢 coproduct dissolution — SG-5 required-trait witness axis (illegal trait tags unrepresentable).
type RequiredTraitWitness
  = TargetCollectionWitnessOrd { type_param: Symbol }
  | TargetCollectionWitnessHash { type_param: Symbol }
  | TargetCollectionWitnessEq { type_param: Symbol }

type TargetRepresentationChoice {
  form: TargetRepresentation
  constraints: List<RequiredTraitWitness>
}

// SG-5 — canonical collection realization row (source_carrier is Node-keyed per DFS).
// Owning TargetModel is the translate caller's parameter — not stored on the row (avoids bundle back-edge).
type TargetCollectionRealization {
  source_carrier: Node
  primary: TargetRepresentationChoice
  alternatives: List<TargetRepresentationChoice>
  fallback_diagnostic: Diagnostic
}


fn target_collection_set_no_representation_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^target_collection_set_no_representation,
    at: port_locus(port: ^target_collection_set_no_representation_port),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_collection_free_monoid_no_representation_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^target_collection_free_monoid_no_representation,
    at: port_locus(port: ^target_collection_free_monoid_no_representation_port),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_collection_realization_lookup_miss_diagnostic(source_carrier: Node) -> Diagnostic {
  Diagnostic {
    reason: ^target_collection_realization_lookup_miss,
    at: node_locus(node: source_carrier),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_collection_realization_lookup_ambiguous_diagnostic(source_carrier: Node) -> Diagnostic {
  Diagnostic {
    reason: ^target_collection_realization_lookup_ambiguous,
    at: node_locus(node: source_carrier),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

// 🟢 coproduct dissolution — SG-5 collection realization lookup state (missing / unique / ambiguous).
type TargetCollectionRealizationLookup
  = TargetCollectionRealizationMissing
  | TargetCollectionRealizationUnique { row: TargetCollectionRealization }
  | TargetCollectionRealizationAmbiguous

fn target_collection_realization_lookup_step(
  acc: TargetCollectionRealizationLookup,
  row: TargetCollectionRealization,
  source_carrier: Node
) -> TargetCollectionRealizationLookup {
  if content_hash(n: row.source_carrier) == content_hash(n: source_carrier) {
    match acc {
      TargetCollectionRealizationMissing => TargetCollectionRealizationUnique { row: row }
      TargetCollectionRealizationUnique { row: _ } => TargetCollectionRealizationAmbiguous
      TargetCollectionRealizationAmbiguous => TargetCollectionRealizationAmbiguous
    }
  } else {
    acc
  }
}

fn target_collection_realization_lookup_in_catalog(
  catalog: FreeMonoid<TargetCollectionRealization>,
  source_carrier: Node
) -> Outcome<TargetCollectionRealization> {
  match fold_list(
    xs: catalog,
    empty: TargetCollectionRealizationMissing,
    cons: fn(acc, row) {
      target_collection_realization_lookup_step(
        acc: acc,
        row: row,
        source_carrier: source_carrier
      )
    }
  ) {
    TargetCollectionRealizationMissing =>
      outcome_rejected(target_collection_realization_lookup_miss_diagnostic(source_carrier: source_carrier))
    TargetCollectionRealizationUnique { row: row } => outcome_accepted(row)
    TargetCollectionRealizationAmbiguous =>
      outcome_rejected(target_collection_realization_lookup_ambiguous_diagnostic(source_carrier: source_carrier))
  }
}

fn target_collection_set_carrier_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^target_collection_set_carrier } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn target_collection_repr_kind_from_atom(id: Symbol) -> Optional<TargetCollectionReprKind> {
  if id == discriminant(v: TargetCollectionReprBTreeSet) {
    optional_present(value: TargetCollectionReprBTreeSet)
  } else {
    if id == discriminant(v: TargetCollectionReprHashSet) {
      optional_present(value: TargetCollectionReprHashSet)
    } else {
      if id == discriminant(v: TargetCollectionReprVec) {
        optional_present(value: TargetCollectionReprVec)
      } else {
        optional_absent()
      }
    }
  }
}

fn target_collection_node_atom_identity(node: Node) -> Outcome<Symbol> {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } => outcome_accepted(id)
    _ => outcome_rejected(target_collection_shape_malformed_diagnostic(node: node))
  }
}

fn target_collection_repr_from_node(node: Node) -> Outcome<TargetRepresentation> {
  bind_outcome(
    o: find_named_child(root: node, name: ^target_collection_repr_field_kind),
    f: fn(kind_node) {
      bind_outcome(
        o: target_collection_node_atom_identity(node: kind_node),
        f: fn(kind_sym) {
          match target_collection_repr_kind_from_atom(id: kind_sym) {
            Present { value: kind } =>
              bind_outcome(
                o: find_named_child(root: node, name: ^target_collection_repr_field_apply),
                f: fn(apply_node) {
                  bind_outcome(
                    o: decode_generic_apply_shape_bundle(bundle: apply_node),
                    f: fn(apply) {
                      outcome_accepted(
                        TargetRepresentation { kind: kind, apply: apply }
                      )
                    }
                  )
                }
              )
            Absent =>
              outcome_rejected(target_collection_shape_malformed_diagnostic(node: node))
          }
        }
      )
    }
  )
}

fn target_collection_witness_from_node(node: Node) -> Outcome<RequiredTraitWitness> {
  bind_outcome(
    o: find_named_child(root: node, name: ^target_collection_witness_field_trait_name),
    f: fn(trait_node) {
      bind_outcome(
        o: target_collection_node_atom_identity(node: trait_node),
        f: fn(trait_name) {
          bind_outcome(
            o: find_named_child(root: node, name: ^target_collection_witness_field_type_param),
            f: fn(param_node) {
              bind_outcome(
                o: target_collection_node_atom_identity(node: param_node),
                f: fn(type_param) {
                  if trait_name == ^target_collection_trait_ord {
                    outcome_accepted(
                      TargetCollectionWitnessOrd { type_param: type_param }
                    )
                  } else {
                    if trait_name == ^target_collection_trait_hash {
                      outcome_accepted(
                        TargetCollectionWitnessHash { type_param: type_param }
                      )
                    } else {
                      if trait_name == ^target_collection_trait_eq {
                        outcome_accepted(
                          TargetCollectionWitnessEq { type_param: type_param }
                        )
                      } else {
                        outcome_rejected(
                          target_collection_shape_malformed_diagnostic(node: node)
                        )
                      }
                    }
                  }
                }
              )
            }
          )
        }
      )
    }
  )
}

fn target_collection_fallback_from_node(node: Node) -> Outcome<Diagnostic> {
  bind_outcome(
    o: target_collection_node_atom_identity(node: node),
    f: fn(reason) {
      if reason == ^target_collection_set_no_representation {
        outcome_accepted(target_collection_set_no_representation_diagnostic())
      } else {
        if reason == ^target_collection_free_monoid_no_representation {
          outcome_accepted(target_collection_free_monoid_no_representation_diagnostic())
        } else {
          outcome_rejected(target_collection_shape_malformed_diagnostic(node: node))
        }
      }
    }
  )
}

// 🟡 gated — feature:SG-5-element-trait-eligibility — bind docs/planning/v2-sg5-sg6-collection-bounded-lattice-worksheet-2026-05-30.md §10.0 — dissolve-on: witness eligibility reads declared_inhabitants algebra witnesses instead of kernel atom tags.

// 🟡 gated — feature:SG-5-element-trait-eligibility — bind docs/planning/v2-sg5-sg6-collection-bounded-lattice-worksheet-2026-05-30.md §10.0 — dissolve-on: witness eligibility reads declared_inhabitants algebra witnesses instead of kernel atom tags.
fn target_collection_element_ord_eligible(elem: Node) -> Bool {
  match elem.kind {
    TypeNode { connective: Atom { identity: id } } =>
      id == ^target_collection_kernel_string
        || id == ^target_collection_kernel_int
        || id == ^target_collection_kernel_bool
        || id == ^target_collection_kernel_unit
    _ => false
  }
}

// 🟡 gated — feature:SG-5-element-trait-eligibility — MVP-1: same kernel set as Ord until declared_inhabitants witness wiring.
fn target_collection_element_hash_eligible(elem: Node) -> Bool {
  target_collection_element_ord_eligible(elem: elem)
}

// 🟡 gated — feature:SG-5-element-trait-eligibility — MVP-1: same kernel set as Hash until declared_inhabitants witness wiring.
fn target_collection_element_eq_eligible(elem: Node) -> Bool {
  target_collection_element_hash_eligible(elem: elem)
}

// 🟢 coproduct dissolution — SG-5 witness satisfaction fold over RequiredTraitWitness coproduct.
fn target_collection_trait_witness_satisfied(
  witness: RequiredTraitWitness,
  elem: Node
) -> Bool {
  match witness {
    TargetCollectionWitnessOrd { type_param: _ } =>
      target_collection_element_ord_eligible(elem: elem)
    TargetCollectionWitnessHash { type_param: _ } =>
      target_collection_element_hash_eligible(elem: elem)
    TargetCollectionWitnessEq { type_param: _ } =>
      target_collection_element_eq_eligible(elem: elem)
  }
}

fn target_collection_choice_constraints_satisfied(
  choice: TargetRepresentationChoice,
  elem: Node
) -> Bool {
  fold_list(
    xs: choice.constraints,
    empty: true,
    cons: fn(acc, witness) {
      acc && target_collection_trait_witness_satisfied(witness: witness, elem: elem)
    }
  )
}

fn target_collection_select_choice(
  primary: TargetRepresentationChoice,
  alternatives: List<TargetRepresentationChoice>,
  elem: Node
) -> Optional<TargetRepresentationChoice> {
  if target_collection_choice_constraints_satisfied(choice: primary, elem: elem) {
    optional_present(value: primary)
  } else {
    fold_list(
      xs: alternatives,
      empty: optional_absent(),
      cons: fn(acc, choice) {
        match acc {
          Present { value: _ } => acc
          Absent =>
            if target_collection_choice_constraints_satisfied(choice: choice, elem: elem) {
              optional_present(value: choice)
            } else {
              optional_absent()
            }
        }
      }
    )
  }
}

fn target_collection_set_carrier_head(node: Node) -> Optional<Node> {
  list_at_optional(xs: node_positional_child_targets(node: node), index: 0)
}

// 🟡 gated — predicate-dissolution interim — feature:SG-5-set-carrier-recognition — bind docs/planning/v2-sg5-sg6-collection-bounded-lattice-worksheet-2026-05-30.md §10.0 — dissolve-on: 06_translate Cardinality arm matches set_carrier structurally without Bool predicate over Node.kind.
fn target_collection_type_node_is_set_carrier(node: Node) -> Bool {
  match node.kind {
    TypeNode { connective: Cardinality } =>
      match target_collection_set_carrier_head(node: node) {
        Present { value: head } =>
          match head.kind {
            TypeNode { connective: Atom { identity: id } } => id == ^target_collection_set_carrier
            _ => false
          }
        Absent => false
      }
    _ => false
  }
}

fn target_collection_set_element_type_node(set_node: Node) -> Optional<Node> {
  list_at_optional(xs: node_positional_child_targets(node: set_node), index: 1)
}

fn target_collection_free_monoid_carrier_head(node: Node) -> Optional<Node> {
  list_at_optional(xs: node_positional_child_targets(node: node), index: 0)
}

// 🟡 gated — predicate-dissolution interim —
// owner: vivid-lynx-81 / Rust RCA SG critical path; lane: SG-COLLECTION-PROJECTION;
// planning-row: ROADMAP.md § "What v2 is building toward" rows `src/v2/std/` and
// `Compiler stages`; bind: PR #4218 / node://adhoc-2d1d6d4b-023. Dissolve-on:
// introduce a canonical collection-carrier projection returning `(kind, element)` once for
// Set and FreeMonoid, then delete the paired Bool predicates/accessors before a third
// collection carrier lands.
fn target_collection_type_node_is_free_monoid_carrier(node: Node) -> Bool {
  match node.kind {
    TypeNode { connective: Instantiation } =>
      match target_collection_free_monoid_carrier_head(node: node) {
        Present { value: head } =>
          match head.kind {
            TypeNode { connective: Atom { identity: id } } =>
              id == ^target_carrier_free_monoid
            _ => false
          }
        Absent => false
      }
    _ => false
  }
}

fn target_collection_free_monoid_element_type_node(free_monoid_node: Node) -> Optional<Node> {
  let positional = node_positional_child_targets(node: free_monoid_node)
  if length(xs: positional) == 2 {
    list_at_optional(xs: positional, index: 1)
  } else {
    optional_absent()
  }
}

// ═══ SG-RC — TargetUseSiteOwnershipRealization (canonical home) ═══



// Value-semantics (Copy) carrier set — the target-authored discrimination the
// use-site-ownership lookup short-circuits on (Copy ⇒ by-value). Atom-identity
// keyed, mirroring how the reference-ownership catalog matches carriers.

// 🟢 coproduct dissolution — SG-RC ownership boundary role axis (four use sites; not Node.kind).
type TargetOwnershipUseSite
  = OwnershipAtFunctionReturn
  | OwnershipAtFunctionParameter
  | OwnershipAtStructField
  | OwnershipAtBindingProjection

// 🟢 coproduct dissolution — SG-RC reference layer axis (owned / shared / indirect).
type TargetReferenceLayer
  = ReferenceLayerOwned
  | ReferenceLayerRc
  | ReferenceLayerBox

type TargetReferenceLayerTokens {
  rc_type_head: Symbol
  box_type_head: Symbol
  rc_new_ctor: Symbol
  box_new_ctor: Symbol
}

// 🟢 coproduct dissolution — TERMINAL. SG-RC ownership rows must distinguish exact-carrier
// identity from generic-family/head identity while still projecting the emitted shell through
// SG-2. This is not a derivable fact from Node alone: `Outcome<T>`/`TestClaimRun<S,A>` rows
// intentionally match by instantiation head, while `Node`, `Diagnostics`, and other rows match
// exact carriers. Encoding that choice in source_carrier would conflate carrier identity with
// lookup semantics; encoding it in the lookup would reintroduce consumer-local special cases.
// The row-authored sum is the canonical authority for the finite source-key semantics.
type TargetUseSiteOwnershipSourceProjection
  = UseSiteOwnershipExactCarrier
  | UseSiteOwnershipInstantiationHeadCarrier

type TargetUseSiteOwnershipRealization {
  source_carrier: Node
  source_projection: TargetUseSiteOwnershipSourceProjection
  use_site: TargetOwnershipUseSite
  reference_layer: TargetReferenceLayer
  display_name: Symbol
}

// 🟢 coproduct dissolution — value-vs-reference carrier semantics. A carrier is
// owned by value (Copy ⇒ defaults to by-value: no reference layer applied) or by
// reference (the SG-RC reference-layer realization applies). This is a DISTINCT
// axis from TargetReferenceLayer (Owned|Rc|Box, which lives WITHIN the by-reference
// arm) — reference_layer is inapplicable to value carriers, so it appears only in
// CarrierOwnershipByReference. The use-site-ownership lookup discriminates this at
// the authority: a value-semantics carrier short-circuits to ByValue before the
// reference-catalog lookup; a reference carrier with no row is still a fail-closed
// miss. Note: 'Copy ⇒ by-value default' is a default, not an absolute — a witness
// later needing &primitive is a consumer-triggered extension, not pre-built here.
type TargetCarrierOwnership
  = CarrierOwnershipByValue
  | CarrierOwnershipByReference { realization: TargetUseSiteOwnershipRealization }




// Kernel-ambient carrier keys (Node-keyed; not spelling-keyed tables).

fn target_carrier_type_node(identity: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: identity } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn target_carrier_diagnostics_node() -> Node {
  target_carrier_type_node(identity: ^target_carrier_diagnostics)
}

fn target_carrier_node_node() -> Node {
  target_carrier_type_node(identity: ^target_carrier_node)
}

fn target_carrier_test_claim_node() -> Node {
  target_carrier_type_node(identity: ^target_carrier_test_claim)
}

fn target_carrier_free_monoid_node() -> Node {
  target_carrier_type_node(identity: ^target_carrier_free_monoid)
}

fn target_carrier_outcome_node() -> Node {
  target_carrier_type_node(identity: ^target_carrier_outcome)
}

fn target_carrier_model_core_node() -> Node {
  target_carrier_type_node(identity: ^target_carrier_model_core)
}

fn target_carrier_algebra_inhabitance_decl_node() -> Node {
  target_carrier_type_node(identity: ^target_carrier_algebra_inhabitance_decl)
}

fn target_carrier_probe_heap_node() -> Node {
  target_carrier_type_node(identity: ^target_carrier_probe_heap)
}

fn target_ownership_use_site_from_atom(id: Symbol) -> Optional<TargetOwnershipUseSite> {
  if id == discriminant(v: OwnershipAtFunctionReturn) {
    optional_present(value: OwnershipAtFunctionReturn)
  } else {
    if id == discriminant(v: OwnershipAtFunctionParameter) {
      optional_present(value: OwnershipAtFunctionParameter)
    } else {
      if id == discriminant(v: OwnershipAtStructField) {
        optional_present(value: OwnershipAtStructField)
      } else {
        if id == discriminant(v: OwnershipAtBindingProjection) {
          optional_present(value: OwnershipAtBindingProjection)
        } else {
          optional_absent()
        }
      }
    }
  }
}

fn target_use_site_ownership_source_projection_from_atom(
  id: Symbol
) -> Optional<TargetUseSiteOwnershipSourceProjection> {
  if id == discriminant(v: UseSiteOwnershipExactCarrier) {
    optional_present(value: UseSiteOwnershipExactCarrier)
  } else {
    if id == discriminant(v: UseSiteOwnershipInstantiationHeadCarrier) {
      optional_present(value: UseSiteOwnershipInstantiationHeadCarrier)
    } else {
      optional_absent()
    }
  }
}

fn target_reference_layer_from_atom(id: Symbol) -> Optional<TargetReferenceLayer> {
  if id == discriminant(v: ReferenceLayerOwned) {
    optional_present(value: ReferenceLayerOwned)
  } else {
    if id == discriminant(v: ReferenceLayerRc) {
      optional_present(value: ReferenceLayerRc)
    } else {
      if id == discriminant(v: ReferenceLayerBox) {
        optional_present(value: ReferenceLayerBox)
      } else {
        optional_absent()
      }
    }
  }
}

fn target_use_site_ownership_lookup_miss_diagnostic(source_carrier: Node) -> Diagnostic {
  Diagnostic {
    reason: ^target_use_site_ownership_lookup_miss,
    at: node_locus(node: source_carrier),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_use_site_ownership_lookup_ambiguous_diagnostic(source_carrier: Node) -> Diagnostic {
  Diagnostic {
    reason: ^target_use_site_ownership_lookup_ambiguous,
    at: node_locus(node: source_carrier),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_use_site_ownership_catalog_row_decode_invalid_diagnostic(
  source_carrier: Node
) -> Diagnostic {
  Diagnostic {
    reason: ^target_use_site_ownership_catalog_row_decode_invalid,
    at: node_locus(node: source_carrier),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

// 🟢 coproduct dissolution — SG-RC list-catalog lookup fold state (missing / unique / ambiguous).
type TargetUseSiteOwnershipLookup
  = TargetUseSiteOwnershipMissing
  | TargetUseSiteOwnershipUnique { row: TargetUseSiteOwnershipRealization }
  | TargetUseSiteOwnershipAmbiguous

fn target_use_site_ownership_source_key(
  source_carrier: Node,
  projection: TargetUseSiteOwnershipSourceProjection
) -> Optional<Node> {
  match projection {
    UseSiteOwnershipExactCarrier => optional_present(value: source_carrier)
    UseSiteOwnershipInstantiationHeadCarrier =>
      match source_carrier.kind {
        TypeNode { connective: Instantiation } =>
          match list_at_optional(xs: node_positional_child_targets(node: source_carrier), index: 0) {
            Present { value: head } => optional_present(value: head)
            Absent => optional_absent()
          }
        _ => optional_absent()
      }
  }
}

// Lookup key: (content_hash(source_carrier), use_site) only — display_name is wire label, not part of the key.
fn target_use_site_ownership_lookup_step(
  acc: TargetUseSiteOwnershipLookup,
  row: TargetUseSiteOwnershipRealization,
  source_carrier: Node,
  use_site: TargetOwnershipUseSite
) -> TargetUseSiteOwnershipLookup {
  match target_use_site_ownership_source_key(
    source_carrier: source_carrier,
    projection: row.source_projection
  ) {
    Absent => acc
    Present { value: source_key } =>
      if content_hash(n: row.source_carrier) == content_hash(n: source_key)
        && row.use_site == use_site
      {
        match acc {
          TargetUseSiteOwnershipMissing => TargetUseSiteOwnershipUnique { row: row }
          TargetUseSiteOwnershipUnique { row: _ } => TargetUseSiteOwnershipAmbiguous
          TargetUseSiteOwnershipAmbiguous => TargetUseSiteOwnershipAmbiguous
        }
      } else {
        acc
      }
  }
}

fn target_use_site_ownership_lookup_in_catalog(
  catalog: List<TargetUseSiteOwnershipRealization>,
  source_carrier: Node,
  use_site: TargetOwnershipUseSite
) -> Outcome<TargetUseSiteOwnershipRealization> {
  match fold_list(
    xs: catalog,
    empty: TargetUseSiteOwnershipMissing,
    cons: fn(acc, row) {
      target_use_site_ownership_lookup_step(
        acc: acc,
        row: row,
        source_carrier: source_carrier,
        use_site: use_site
      )
    }
  ) {
    TargetUseSiteOwnershipMissing =>
      outcome_rejected(target_use_site_ownership_lookup_miss_diagnostic(source_carrier: source_carrier))
    TargetUseSiteOwnershipUnique { row: row } => outcome_accepted(row)
    TargetUseSiteOwnershipAmbiguous =>
      outcome_rejected(target_use_site_ownership_lookup_ambiguous_diagnostic(source_carrier: source_carrier))
  }
}

fn target_model_node_atom_identity(node: Node, source_carrier: Node) -> Outcome<Symbol> {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } => outcome_accepted(id)
    _ =>
      outcome_rejected(
        target_use_site_ownership_catalog_row_decode_invalid_diagnostic(
          source_carrier: source_carrier
        )
      )
  }
}

fn target_use_site_ownership_row_from_node(
  row_node: Node,
  display_name: Symbol,
  source_carrier: Node
) -> Outcome<TargetUseSiteOwnershipRealization> {
  let carrier_node = target_atom_realization_conj_child(
    row_node: row_node,
    edge_name: ^target_use_site_ownership_field_source_carrier
  )
  let source_projection_node = target_atom_realization_conj_child(
    row_node: row_node,
    edge_name: ^target_use_site_ownership_field_source_projection
  )
  let use_site_node = target_atom_realization_conj_child(
    row_node: row_node,
    edge_name: ^target_use_site_ownership_field_use_site
  )
  let layer_node = target_atom_realization_conj_child(
    row_node: row_node,
    edge_name: ^target_use_site_ownership_field_reference_layer
  )
  bind_outcome(
    o: target_model_node_atom_identity(node: source_projection_node, source_carrier: source_carrier),
    f: fn(source_projection_id) {
      match target_use_site_ownership_source_projection_from_atom(id: source_projection_id) {
        Absent =>
          outcome_rejected(
            target_use_site_ownership_catalog_row_decode_invalid_diagnostic(
              source_carrier: source_carrier
            )
          )
        Present { value: source_projection } =>
          bind_outcome(
            o: target_model_node_atom_identity(node: use_site_node, source_carrier: source_carrier),
            f: fn(use_site_id) {
              match target_ownership_use_site_from_atom(id: use_site_id) {
                Absent =>
                  outcome_rejected(
                    target_use_site_ownership_catalog_row_decode_invalid_diagnostic(
                      source_carrier: source_carrier
                    )
                  )
                Present { value: use_site } =>
                  bind_outcome(
                    o: target_model_node_atom_identity(node: layer_node, source_carrier: source_carrier),
                    f: fn(layer_id) {
                      match target_reference_layer_from_atom(id: layer_id) {
                        Absent =>
                          outcome_rejected(
                            target_use_site_ownership_catalog_row_decode_invalid_diagnostic(
                              source_carrier: source_carrier
                            )
                          )
                        Present { value: reference_layer } =>
                          outcome_accepted(
                            TargetUseSiteOwnershipRealization {
                              source_carrier: carrier_node,
                              source_projection: source_projection,
                              use_site: use_site,
                              reference_layer: reference_layer,
                              display_name: display_name
                            }
                          )
                      }
                    }
                  )
              }
            }
          )
      }
    }
  )
}

// 🟢 coproduct dissolution — SG-RC bundle-node catalog lookup fold state (missing / unique / ambiguous / invalid row decode).
type TargetUseSiteOwnershipCatalogLookup
  = TargetUseSiteOwnershipCatalogMissing
  | TargetUseSiteOwnershipCatalogUnique { row: TargetUseSiteOwnershipRealization }
  | TargetUseSiteOwnershipCatalogAmbiguous
  | TargetUseSiteOwnershipCatalogInvalid

fn target_use_site_ownership_catalog_lookup_step(
  acc: TargetUseSiteOwnershipCatalogLookup,
  edge: Edge,
  source_carrier: Node,
  use_site: TargetOwnershipUseSite
) -> TargetUseSiteOwnershipCatalogLookup {
  match acc {
    TargetUseSiteOwnershipCatalogInvalid => TargetUseSiteOwnershipCatalogInvalid
    _ =>
      match edge.label {
    Named { name: display_name } =>
      match target_use_site_ownership_row_from_node(
        row_node: edge.target,
        display_name: display_name,
        source_carrier: source_carrier
      ) {
    Accepted { value: row, diagnostics: _ } =>
      match target_use_site_ownership_lookup_step(
        acc: match acc {
          TargetUseSiteOwnershipCatalogMissing => TargetUseSiteOwnershipMissing
          TargetUseSiteOwnershipCatalogUnique { row: r } =>
            TargetUseSiteOwnershipUnique { row: r }
          TargetUseSiteOwnershipCatalogAmbiguous => TargetUseSiteOwnershipAmbiguous
          TargetUseSiteOwnershipCatalogInvalid => TargetUseSiteOwnershipCatalogInvalid
        },
        row: row,
        source_carrier: source_carrier,
        use_site: use_site
      ) {
        TargetUseSiteOwnershipMissing =>
          TargetUseSiteOwnershipCatalogMissing
        TargetUseSiteOwnershipUnique { row: row } =>
          TargetUseSiteOwnershipCatalogUnique { row: row }
        TargetUseSiteOwnershipAmbiguous => TargetUseSiteOwnershipCatalogAmbiguous
      }
    Rejected { diagnostics: _ } => TargetUseSiteOwnershipCatalogInvalid
    }
    Positional => TargetUseSiteOwnershipCatalogInvalid
      }
  }
}

// Reference-ownership catalog lookup (SG-RC): consult the per-carrier catalog for a
// reference realization. A carrier with no row is a fail-closed miss. Extracted so
// the value-semantics discrimination can live inline at the lookup authority below
// without a standalone is_* predicate.
fn target_use_site_ownership_reference_catalog_lookup(
  catalog: Node,
  source_carrier: Node,
  use_site: TargetOwnershipUseSite
) -> Outcome<TargetCarrierOwnership> {
  match catalog.kind {
    TypeNode { connective: Conj } =>
      match fold(
        catalog.children,
        init: TargetUseSiteOwnershipCatalogMissing,
        f: fn(acc, e) {
          target_use_site_ownership_catalog_lookup_step(
            acc: acc,
            edge: e,
            source_carrier: source_carrier,
            use_site: use_site
          )
        }
      ) {
        TargetUseSiteOwnershipCatalogMissing =>
          outcome_rejected(target_use_site_ownership_lookup_miss_diagnostic(source_carrier: source_carrier))
        TargetUseSiteOwnershipCatalogUnique { row: row } =>
          outcome_accepted(CarrierOwnershipByReference { realization: row })
        TargetUseSiteOwnershipCatalogAmbiguous =>
          outcome_rejected(target_use_site_ownership_lookup_ambiguous_diagnostic(source_carrier: source_carrier))
        TargetUseSiteOwnershipCatalogInvalid =>
          outcome_rejected(
            target_use_site_ownership_catalog_row_decode_invalid_diagnostic(
              source_carrier: source_carrier
            )
          )
      }
    _ =>
      outcome_rejected(
        target_use_site_ownership_catalog_row_decode_invalid_diagnostic(
          source_carrier: source_carrier
        )
      )
  }
}

fn target_use_site_ownership_lookup_in_catalog_node(
  catalog: Node,
  value_semantics_carriers: List<Symbol>,
  source_carrier: Node,
  use_site: TargetOwnershipUseSite
) -> Outcome<TargetCarrierOwnership> {
  // Discrimination AT THE AUTHORITY (no standalone is_* predicate): a value-semantics
  // (Copy) carrier — a bare atom whose identity is in the target's value-semantics set
  // — owns BY VALUE (Copy ⇒ by-value default), short-circuiting before the SG-RC
  // reference catalog so it does not wrongly miss for lacking a row. Every other
  // carrier (an atom not in the set, or a composite) falls through to the reference
  // catalog; a reference carrier with no row is still a fail-closed miss. Call sites
  // just call this lookup.
  match source_carrier.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if value_semantics_carriers |> any(c => c == id) {
        outcome_accepted(CarrierOwnershipByValue)
      } else {
        target_use_site_ownership_reference_catalog_lookup(
          catalog: catalog,
          source_carrier: source_carrier,
          use_site: use_site
        )
      }
    _ =>
      target_use_site_ownership_reference_catalog_lookup(
        catalog: catalog,
        source_carrier: source_carrier,
        use_site: use_site
      )
  }
}

fn target_use_site_ownership_realization_to_node(row: TargetUseSiteOwnershipRealization) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      target_model_named_edge(
        name: ^target_use_site_ownership_field_source_carrier,
        target: row.source_carrier
      ),
      target_model_named_edge(
        name: ^target_use_site_ownership_field_source_projection,
        target: Node {
          kind: TypeNode {
            connective: Atom {
              identity: discriminant(v: row.source_projection)
            }
          },
          children: [],
          occurrence_id: SyntheticOccurrence
}
      ),
      target_model_named_edge(
        name: ^target_use_site_ownership_field_use_site,
        target: Node {
          kind: TypeNode {
            connective: Atom { identity: discriminant(v: row.use_site) }
          },
          children: [],
          occurrence_id: SyntheticOccurrence
}
      ),
      target_model_named_edge(
        name: ^target_use_site_ownership_field_reference_layer,
        target: Node {
          kind: TypeNode {
            connective: Atom { identity: discriminant(v: row.reference_layer) }
          },
          children: [],
          occurrence_id: SyntheticOccurrence
}
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn target_use_site_ownership_catalog_edge(row: TargetUseSiteOwnershipRealization) -> Edge {
  target_model_named_edge(
    name: row.display_name,
    target: target_use_site_ownership_realization_to_node(row: row)
  )
}

fn target_use_site_ownership_catalog_snoc_edge(
  acc: List<Edge>,
  row: TargetUseSiteOwnershipRealization
) -> List<Edge> {
  list_snoc_item(xs: acc, item: target_use_site_ownership_catalog_edge(row: row))
}

fn target_use_site_ownership_catalog_node(
  rows: List<TargetUseSiteOwnershipRealization>
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: fold_list(
      xs: rows,
      empty: Empty,
      cons: fn(acc, row) { target_use_site_ownership_catalog_snoc_edge(acc: acc, row: row) }
    ),
    occurrence_id: SyntheticOccurrence
}
}

// Value-semantics carrier set encode/decode (a Conj of bare atom nodes keyed by
// identity — mirrors how carriers are encoded elsewhere). Encodes the target's
// Copy carrier atom-identities for the bundle; the lookup decodes + matches.
fn target_value_semantics_carrier_atom_node(id: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: id } }, children: Empty,
 occurrence_id: SyntheticOccurrence
}
}

fn target_value_semantics_carriers_node(atoms: List<Symbol>) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: fold_list(
      xs: atoms,
      empty: Empty,
      cons: fn(acc, id) {
        list_snoc_item(
          xs: acc,
          item: target_model_named_edge(name: id, target: target_value_semantics_carrier_atom_node(id: id))
        )
      }
    ),
    occurrence_id: SyntheticOccurrence
}
}

fn target_value_semantics_carrier_snoc(acc: List<Symbol>, edge: Edge) -> List<Symbol> {
  match edge.label {
    Named { name: n } => list_snoc_item(xs: acc, item: n)
    _ => acc
  }
}

fn target_value_semantics_carriers_from_node(node: Node) -> List<Symbol> {
  match node.kind {
    TypeNode { connective: Conj } =>
      fold_list(
        xs: node.children,
        empty: Empty,
        cons: fn(acc, edge) { target_value_semantics_carrier_snoc(acc: acc, edge: edge) }
      )
    _ => Empty
  }
}

fn target_reference_layer_tokens_decode_invalid_diagnostic(source_carrier: Node) -> Diagnostic {
  Diagnostic {
    reason: ^target_reference_layer_tokens_decode_invalid,
    at: node_locus(node: source_carrier),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_reference_layer_tokens_from_node(node: Node) -> Outcome<TargetReferenceLayerTokens> {
  match node.kind {
    TypeNode { connective: Conj } =>
      bind_outcome(
        o: target_model_node_atom_identity(
          node: target_atom_realization_conj_child(
            row_node: node,
            edge_name: ^target_reference_layer_tokens_field_rc_head
          ),
          source_carrier: node
        ),
        f: fn(rc_type_head) {
          bind_outcome(
            o: target_model_node_atom_identity(
              node: target_atom_realization_conj_child(
                row_node: node,
                edge_name: ^target_reference_layer_tokens_field_box_head
              ),
              source_carrier: node
            ),
            f: fn(box_type_head) {
              bind_outcome(
                o: target_model_node_atom_identity(
                  node: target_atom_realization_conj_child(
                    row_node: node,
                    edge_name: ^target_reference_layer_tokens_field_rc_new
                  ),
                  source_carrier: node
                ),
                f: fn(rc_new_ctor) {
                  bind_outcome(
                    o: target_model_node_atom_identity(
                      node: target_atom_realization_conj_child(
                        row_node: node,
                        edge_name: ^target_reference_layer_tokens_field_box_new
                      ),
                      source_carrier: node
                    ),
                    f: fn(box_new_ctor) {
                      outcome_accepted(
                        TargetReferenceLayerTokens {
                          rc_type_head: rc_type_head,
                          box_type_head: box_type_head,
                          rc_new_ctor: rc_new_ctor,
                          box_new_ctor: box_new_ctor
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    _ =>
      outcome_rejected(
        target_reference_layer_tokens_decode_invalid_diagnostic(source_carrier: node)
      )
  }
}


fn target_reference_layer_tokens_node(tokens: TargetReferenceLayerTokens) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      target_model_named_edge(
        name: ^target_reference_layer_tokens_field_rc_head,
        target: Node {
          kind: TypeNode { connective: Atom { identity: tokens.rc_type_head } },
          children: [],
          occurrence_id: SyntheticOccurrence
}
      ),
      target_model_named_edge(
        name: ^target_reference_layer_tokens_field_box_head,
        target: Node {
          kind: TypeNode { connective: Atom { identity: tokens.box_type_head } },
          children: [],
          occurrence_id: SyntheticOccurrence
}
      ),
      target_model_named_edge(
        name: ^target_reference_layer_tokens_field_rc_new,
        target: Node {
          kind: TypeNode { connective: Atom { identity: tokens.rc_new_ctor } },
          children: [],
          occurrence_id: SyntheticOccurrence
}
      ),
      target_model_named_edge(
        name: ^target_reference_layer_tokens_field_box_new,
        target: Node {
          kind: TypeNode { connective: Atom { identity: tokens.box_new_ctor } },
          children: [],
          occurrence_id: SyntheticOccurrence
}
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn target_reference_layer_apply_type_emitted(
  inner: Node,
  layer: TargetReferenceLayer,
  projection: TargetTypeExpressionProjection,
  tokens: TargetReferenceLayerTokens
) -> Node {
  match layer {
    ReferenceLayerOwned => inner
    ReferenceLayerRc =>
      target_type_expr_instantiation_emitted(
        form: projection.instantiation_form,
        head: target_type_expr_atom_emitted(
          form: projection.atom_form,
          identity: tokens.rc_type_head
        ),
        args: [inner]
      )
    ReferenceLayerBox =>
      target_type_expr_instantiation_emitted(
        form: projection.instantiation_form,
        head: target_type_expr_atom_emitted(
          form: projection.atom_form,
          identity: tokens.box_type_head
        ),
        args: [inner]
      )
  }
}

fn target_value_expression_reference_rc_new(
  inner: TargetValueExpression,
  ctor: Symbol
) -> TargetValueExpression {
  TargetValueExpression {
    kind: TargetValueExprReferenceRcNew,
    node: Node {
      kind: TypeNode { connective: Atom { identity: ctor } },
      children: [
        target_model_named_edge(
          name: ^target_value_expression_field_inner,
          target: target_value_expression_node(expr: inner)
        )
      ],
      occurrence_id: SyntheticOccurrence
}
  }
}

fn target_value_expression_reference_box_new(
  inner: TargetValueExpression,
  ctor: Symbol
) -> TargetValueExpression {
  TargetValueExpression {
    kind: TargetValueExprReferenceBoxNew,
    node: Node {
      kind: TypeNode {
        connective: Atom { identity: ctor }
      },
      children: [
        target_model_named_edge(
          name: ^target_value_expression_field_inner,
          target: target_value_expression_node(expr: inner)
        )
      ],
      occurrence_id: SyntheticOccurrence
}
  }
}

fn target_reference_layer_apply_value_expression(
  inner: TargetValueExpression,
  layer: TargetReferenceLayer,
  tokens: TargetReferenceLayerTokens
) -> TargetValueExpression {
  match layer {
    ReferenceLayerOwned => inner
    ReferenceLayerRc =>
      target_value_expression_reference_rc_new(inner: inner, ctor: tokens.rc_new_ctor)
    ReferenceLayerBox =>
      target_value_expression_reference_box_new(inner: inner, ctor: tokens.box_new_ctor)
  }
}

// 🟢 coproduct dissolution — SG-RC wrapped reference layers only (Rc|Box; Owned via ReferenceLayerProbeNotWrapped).
type TargetReferenceLayerWrapped
  = ReferenceLayerRc
  | ReferenceLayerBox

// 🟢 coproduct dissolution — SG-RC bidirectional read: outer instantiation head → reference layer.
type TargetReferenceLayerProbe
  = ReferenceLayerProbe { value: TargetReferenceLayerWrapped }
  | ReferenceLayerProbeNotWrapped
  | ReferenceLayerProbeInvalid

// 🟡 gated — call-site arg-name bug fix — feature:B-RC-PROBE-WIRE-DECODE-CALL-1 (ctrl#1476 B3-Gap2)
// — the SG-RC bidirectional read decodes the emitted wire via target_type_expr_emitted_wire_decode,
// whose signature is (node:, projection:). The named-arg `emitted:` was wrong and `projection:` was
// omitted, leaving `node` unbound at runtime ("undefined variable: node"). Uncaught because v2 has no
// call-site arg-name/arity check yet. dissolve-on: enforcement-B call-site arg-check makes misnamed/
// missing-arg calls compile-time errors (this mark + the manual guard then become redundant).
fn target_reference_layer_probe_from_emitted_type(
  emitted: Node,
  projection: TargetTypeExpressionProjection,
  tokens: TargetReferenceLayerTokens
) -> TargetReferenceLayerProbe {
  match target_type_expr_emitted_wire_decode(node: emitted, projection: projection) {
    Accepted { value: wire, diagnostics: _ } =>
      match wire.kind {
        TargetTypeExprInstantiation =>
          match list_at_optional(
            xs: node_positional_child_targets(node: wire.node),
            index: 0
          ) {
            Present { value: head } =>
              match target_model_node_atom_identity(node: head, source_carrier: emitted) {
                Accepted { value: head_id, diagnostics: _ } =>
                  if head_id == tokens.rc_type_head {
                    ReferenceLayerProbe { value: ReferenceLayerRc }
                  } else {
                    if head_id == tokens.box_type_head {
                      ReferenceLayerProbe { value: ReferenceLayerBox }
                    } else {
                      ReferenceLayerProbeNotWrapped
                    }
                  }
                Rejected { diagnostics: _ } => ReferenceLayerProbeInvalid
              }
            Absent => ReferenceLayerProbeInvalid
          }
        _ => ReferenceLayerProbeNotWrapped
      }
    Rejected { diagnostics: _ } => ReferenceLayerProbeInvalid
  }
}

// SG-2 fold — closed per-connective projection-row candidate algebra (std authority; translate consumer).

fn target_type_expr_symbol_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn target_type_expr_atom_shape_node(form: TargetAtomTypeShape) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      target_model_named_edge(
        name: ^target_type_expr_field_surface,
        target: target_type_expr_symbol_atom(id: form.surface)
      ),
      target_model_named_edge(
        name: ^target_type_expr_field_ident_token,
        target: target_type_expr_symbol_atom(id: form.ident_token)
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn target_type_expr_generic_apply_shape_node(form: TargetGenericApply) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: match form.field_label_separator {
      Present { value: s } =>
        list_snoc_item(
          xs: [
            target_model_named_edge(
              name: ^target_type_expr_field_surface,
              target: target_type_expr_symbol_atom(id: form.surface)
            ),
            target_model_named_edge(
              name: ^target_type_expr_field_open,
              target: target_type_expr_symbol_atom(id: form.open)
            ),
            target_model_named_edge(
              name: ^target_type_expr_field_separator,
              target: target_type_expr_symbol_atom(id: form.separator)
            ),
            target_model_named_edge(
              name: ^target_type_expr_field_close,
              target: target_type_expr_symbol_atom(id: form.close)
            )
          ],
          item: target_model_named_edge(
            name: ^target_type_expr_field_field_label_separator,
            target: target_type_expr_symbol_atom(id: s)
          )
        )
      Absent =>
        [
          target_model_named_edge(
            name: ^target_type_expr_field_surface,
            target: target_type_expr_symbol_atom(id: form.surface)
          ),
          target_model_named_edge(
            name: ^target_type_expr_field_open,
            target: target_type_expr_symbol_atom(id: form.open)
          ),
          target_model_named_edge(
            name: ^target_type_expr_field_separator,
            target: target_type_expr_symbol_atom(id: form.separator)
          ),
          target_model_named_edge(
            name: ^target_type_expr_field_close,
            target: target_type_expr_symbol_atom(id: form.close)
          )
        ]
    },
    occurrence_id: SyntheticOccurrence
  }
}

fn target_type_expr_sum_shape_node(form: TargetSumTypeShape) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      target_model_named_edge(
        name: ^target_type_expr_field_surface,
        target: target_type_expr_symbol_atom(id: form.surface)
      ),
      target_model_named_edge(
        name: ^target_type_expr_field_variant_separator,
        target: target_type_expr_symbol_atom(id: form.variant_separator)
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn target_type_expr_arrow_shape_node(form: TargetFunctionTypeShape) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      target_model_named_edge(
        name: ^target_type_expr_field_surface,
        target: target_type_expr_symbol_atom(id: form.surface)
      ),
      target_model_named_edge(
        name: ^target_type_expr_field_open,
        target: target_type_expr_symbol_atom(id: form.open)
      ),
      target_model_named_edge(
        name: ^target_type_expr_field_close,
        target: target_type_expr_symbol_atom(id: form.close)
      ),
      target_model_named_edge(
        name: ^target_type_expr_field_arrow,
        target: target_type_expr_symbol_atom(id: form.arrow)
      ),
      target_model_named_edge(
        name: ^target_type_expr_field_param_ident_token,
        target: target_type_expr_symbol_atom(id: form.param_ident_token)
      ),
      target_model_named_edge(
        name: ^target_type_expr_field_param_type_separator,
        target: target_type_expr_symbol_atom(id: form.param_type_separator)
      ),
      target_model_named_edge(
        name: ^target_type_expr_field_param_list_separator,
        target: target_type_expr_symbol_atom(id: form.param_list_separator)
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

// SG-2 fold — edge-discipline DATA per connective (connective_edge_discipline authority).
// TypeNode connectives never map to LoopBoundEdges (see node.dag connective_edge_discipline).
fn type_expr_projection_child_slot_discipline_atom(connective: Connective) -> Node {
  match connective_edge_discipline(c: connective) {
    NoEdges => target_type_expr_symbol_atom(id: ^target_type_expr_discipline_no_edges)
    LabeledEdges => target_type_expr_symbol_atom(id: ^target_type_expr_discipline_labeled)
    PositionalEdges => target_type_expr_symbol_atom(id: ^target_type_expr_discipline_positional)
    ArrowBodyEdges => target_type_expr_symbol_atom(id: ^target_type_expr_discipline_positional)
    LoopBoundEdges => target_type_expr_symbol_atom(id: ^target_type_expr_discipline_positional)
  }
}

fn type_expr_projection_row_shape_envelope(
  envelope: Node,
  connective: Connective
) -> Node {
  node_rebuild(
    n: envelope,
    children: list_append(
      left: envelope.children,
      right: Cons {
        head: target_model_named_edge(
          name: ^target_type_expr_field_child_slot_discipline,
          target: type_expr_projection_child_slot_discipline_atom(connective: connective)
        ),
        tail: Empty
      }
    )
  )
}

// SG-2 fold — substrate child slots as named coordinate (substrate TypeNode authority; not flat Conj mix).
fn type_expr_projection_graft_child_slots_coordinate(
  envelope: Node,
  facts: Node
) -> Node {
  node_rebuild(
    n: envelope,
    children: list_append(
      left: envelope.children,
      right: Cons {
        head: target_model_named_edge(
          name: ^target_type_expr_field_child_slots,
          target: facts
        ),
        tail: Empty
      }
    )
  )
}

// Row-shape authority — consumed by *type_expression_projection_bundle_node in language targets.
fn type_expr_projection_step_algebra(projection: TargetTypeExpressionProjection) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      target_model_named_edge(
        name: ^target_type_expr_field_atom,
        target: type_expr_projection_row_shape_envelope(
          envelope: target_type_expr_atom_shape_node(form: projection.atom_form),
          connective: Atom { identity: ^target_type_expr_field_atom }
        )
      ),
      target_model_named_edge(
        name: ^target_type_expr_field_conj,
        target: type_expr_projection_row_shape_envelope(
          envelope: target_type_expr_generic_apply_shape_node(form: projection.conj_form),
          connective: Conj
        )
      ),
      target_model_named_edge(
        name: ^target_type_expr_field_disj,
        target: type_expr_projection_row_shape_envelope(
          envelope: target_type_expr_sum_shape_node(form: projection.disj_form),
          connective: Disj
        )
      ),
      target_model_named_edge(
        name: ^target_type_expr_field_arrow,
        target: type_expr_projection_row_shape_envelope(
          envelope: target_type_expr_arrow_shape_node(form: projection.arrow_form),
          connective: Arrow
        )
      ),
      target_model_named_edge(
        name: ^target_type_expr_field_cardinality,
        target: type_expr_projection_row_shape_envelope(
          envelope: target_type_expr_generic_apply_shape_node(form: projection.cardinality_form),
          connective: Cardinality
        )
      ),
      target_model_named_edge(
        name: ^target_type_expr_field_instantiation,
        target: type_expr_projection_row_shape_envelope(
          envelope: target_type_expr_generic_apply_shape_node(form: projection.instantiation_form),
          connective: Instantiation
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn type_expr_projection_shape_for_connective(
  projection: TargetTypeExpressionProjection,
  connective: Connective
) -> Outcome<Node> {
  match connective {
    Atom { identity: _ } =>
      outcome_accepted(
        type_expr_projection_row_shape_envelope(
          envelope: target_type_expr_atom_shape_node(form: projection.atom_form),
          connective: connective
        )
      )
    Conj =>
      outcome_accepted(
        type_expr_projection_row_shape_envelope(
          envelope: target_type_expr_generic_apply_shape_node(form: projection.conj_form),
          connective: Conj
        )
      )
    Disj =>
      outcome_accepted(
        type_expr_projection_row_shape_envelope(
          envelope: target_type_expr_sum_shape_node(form: projection.disj_form),
          connective: Disj
        )
      )
    Arrow =>
      outcome_accepted(
        type_expr_projection_row_shape_envelope(
          envelope: target_type_expr_arrow_shape_node(form: projection.arrow_form),
          connective: Arrow
        )
      )
    Cardinality =>
      outcome_accepted(
        type_expr_projection_row_shape_envelope(
          envelope: target_type_expr_generic_apply_shape_node(form: projection.cardinality_form),
          connective: Cardinality
        )
      )
    Instantiation =>
      outcome_accepted(
        type_expr_projection_row_shape_envelope(
          envelope: target_type_expr_generic_apply_shape_node(form: projection.instantiation_form),
          connective: Instantiation
        )
      )
  }
}

fn type_expr_projection_candidate_for_connective(
  projection: TargetTypeExpressionProjection,
  connective: Connective
) -> Outcome<CandidateSet> {
  bind_outcome(
    o: type_expr_projection_shape_for_connective(
      projection: projection,
      connective: connective
    ),
    f: fn(shape) {
      outcome_accepted(
        CandidateSet {
          candidates: [shape],
          closedness: StructuralPropertyWitness {
            property: ^target_type_expr_projection_candidate_closedness,
            evidence: shape
          }
        }
      )
    }
  )
}

// SG-2 fold — anchored substrate TypeNode with projected positional children (checkpoint 3).
// Labeled Conj/Disj substrates keep node.children; positional connectives pass projected list.
fn type_expr_projection_substrate_facts(
  node: Node,
  projected_positional: List<Node>
) -> Node {
  match node.kind {
    TypeNode { connective: Conj } => node
    TypeNode { connective: Disj } => node
    _ =>
      node_rebuild(
        n: node,
        children: fold_list(
          xs: projected_positional,
          empty: Empty,
          cons: fn(acc, child) {
            list_snoc_item(
              xs: acc,
              item: Edge { label: Positional, target: child }
            )
          }
        )
      )
  }
}

// SG-2 fold — graft substrate child slots into row envelope (discipline + delimiter metadata).
fn type_expr_projection_graft_substrate_in_row_slot(
  projection: TargetTypeExpressionProjection,
  connective: Connective,
  node: Node,
  projected_positional: List<Node>
) -> Outcome<Node> {
  let facts = type_expr_projection_substrate_facts(
    node: node,
    projected_positional: projected_positional
  )
  bind_outcome(
    o: type_expr_projection_shape_for_connective(
      projection: projection,
      connective: connective
    ),
    f: fn(envelope) {
      outcome_accepted(
        type_expr_projection_graft_child_slots_coordinate(
          envelope: envelope,
          facts: facts
        )
      )
    }
  )
}

fn type_expr_projection_row_witness_gate_with_rule(
  source_facts: Node,
  projection: TargetTypeExpressionProjection,
  connective: Connective,
  preservation_rule: Symbol
) -> Outcome<Node> {
  bind_outcome(
    o: type_expr_projection_candidate_for_connective(
      projection: projection,
      connective: connective
    ),
    f: fn(candidates) {
      match find_witness(
        source_facts: source_facts,
        candidates: candidates,
        predicate: PreservationPredicate {
          algebra: source_facts,
          preservation_rule: preservation_rule
        },
        multiplicity_policy: UniqueOnly
      ) {
        Accepted { value: fw, diagnostics: d } =>
          outcome_accepted(fw.candidate)
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    }
  )
}

// SG-2 fold — bundle row-shape closedness (no graft child-slot coordinate; exact structural match).
fn type_expr_projection_row_shape_witness_gate(
  source_facts: Node,
  projection: TargetTypeExpressionProjection,
  connective: Connective
) -> Outcome<Node> {
  type_expr_projection_row_witness_gate_with_rule(
    source_facts: source_facts,
    projection: projection,
    connective: connective,
    preservation_rule: ^preservation_rule_exact_structural_equality_zip_fold
  )
}

// SG-2 fold — grafted substrate witness gate (requires child_slots coordinate; discipline zip-fold).
fn type_expr_projection_graft_witness_gate(
  source_facts: Node,
  projection: TargetTypeExpressionProjection,
  connective: Connective
) -> Outcome<Node> {
  type_expr_projection_row_witness_gate_with_rule(
    source_facts: source_facts,
    projection: projection,
    connective: connective,
    preservation_rule: ^preservation_rule_type_expr_projection_discipline_zip_fold
  )
}

// SG-2 fold — connective → step_algebra row slot field (uniform key for graft + bundle decode).
fn type_expr_projection_row_field_for_connective(connective: Connective) -> Symbol {
  match connective {
    Atom { identity: _ } => ^target_type_expr_field_atom
    Conj => ^target_type_expr_field_conj
    Disj => ^target_type_expr_field_disj
    Arrow => ^target_type_expr_field_arrow
    Cardinality => ^target_type_expr_field_cardinality
    Instantiation => ^target_type_expr_field_instantiation
  }
}

// SG-2 fold — connective shape node from TargetModel bundle (authority; not caller projection).
fn type_expr_projection_bundle_shape_for_connective(
  bundle: Node,
  connective: Connective
) -> Outcome<Node> {
  find_named_child(
    root: bundle,
    name: type_expr_projection_row_field_for_connective(connective: connective)
  )
}

// SG-2 fold — fail-close when caller projection row disagrees with bundle authority.
fn type_expr_projection_row_closedness_from_target(
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  connective: Connective
) -> Outcome<Node> {
  bind_outcome(
    o: find_named_child(
      root: target.bundle,
      name: ^target_model_edge_type_expression_projection
    ),
    f: fn(bundle) {
      bind_outcome(
        o: type_expr_projection_bundle_shape_for_connective(
          bundle: bundle,
          connective: connective
        ),
        f: fn(bundle_shape) {
          type_expr_projection_row_shape_witness_gate(
            source_facts: bundle_shape,
            projection: projection,
            connective: connective
          )
        }
      )
    }
  )
}

// ── Value-tier projection (§1.5 stage-fold: dissolved from v2.compiler.value_expression) ──────────
// Authority: design-value-emit-schema.md §4.1–§4.4.
// These functions were in 06_value_expression.dag and dissolved here via the §1.5 translate_algebra
// stage-fold. The surface decode (^dag_token_plus → CanonicalOperation) stays in the compiler/ layer
// (06_translate imports dag_surface_operator_canonicalization_member); functions that need it receive
// a pre-decoded canonical_op or a handle_transform callback threaded from 06_translate.
// The dissolution mark that read "authority: canonical_operation_from_wire_node" was imprecise:
// canonical_operation_from_wire_node decodes the WIRE discriminant format, not the surface token.
// The true authority for the Transform arm is a composition:
//   surface-decode (compiler/, extdep) → canonical_op → target_model apply (pre-decoded).


fn target_value_expr_diagnostic(reason: Symbol, node: Node) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_transform_positional_operand_binding_atom(child: Node) -> Outcome<Symbol> {
  match child.kind {
    TypeNode { connective: Atom { identity: id } } => outcome_accepted(id)
    _ =>
      outcome_rejected(
        target_value_expr_diagnostic(
          reason: ^target_value_expr_reason_transform_shape_invalid,
          node: child
        )
      )
  }
}

fn target_transform_positional_operand_binding(node: Node, index: Int) -> Outcome<Symbol> {
  match list_at_optional(xs: node_positional_child_targets(node: node), index: index) {
    Present { value: child } => target_transform_positional_operand_binding_atom(child: child)
    Absent =>
      outcome_rejected(
        target_value_expr_diagnostic(
          reason: ^target_value_expr_reason_transform_shape_invalid,
          node: node
        )
      )
  }
}

fn target_transform_surface_op_atom(node: Node) -> Outcome<Symbol> {
  target_transform_positional_operand_binding(node: node, index: 0)
}

fn target_value_expr_declared_inhabitants_from_target(target: TargetModel) -> Outcome<Node> {
  projection_bundle_child(bundle: target.bundle, name: ^target_model_edge_declared_inhabitants)
}

// 🟡 gated — predicate-dissolution interim —
// feature:target-wave1-signature-declared-inhabitants — consumer:target_value_expr_arrow_body_scope_binding —
// bind: COMPREP wave-1 Arrow signature vs TargetModel.declared_inhabitants —
// owner: T6 value-expression (lively-badger-242) —
// lane: compiler 06_value_expression + 06_translate —
// dissolve-on-arrival: substrate Outcome-bearing signature query replaces Bool fold + silent Rejected swallow;
// forbidden: parallel compiler-stage wave-1 signature matchers.
fn target_value_expr_wave1_add_signature_matches_for_target(
  arrow: Node,
  target: TargetModel
) -> Bool {
  match target_value_expr_declared_inhabitants_from_target(target: target) {
    Accepted { value: inhabitants_root, diagnostics: _ } =>
      target_wave1_add_signature_matches(
        arrow: arrow,
        inhabitants_root: inhabitants_root
      )
    Rejected { diagnostics: _ } => false
  }
}

