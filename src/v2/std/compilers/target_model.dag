}

fn record_literal_type_naming_to_symbol(naming: v2.std.compilers.target_model.RecordLiteralTypeNaming) -> v2.std.node.Symbol {
  match naming {
    Prepend => ^record_literal_type_naming_prepend
    Omit => ^record_literal_type_naming_omit
  }
}

fn record_literal_type_naming_from_symbol(symbol: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.RecordLiteralTypeNaming> {
  if symbol == ^record_literal_type_naming_prepend {
    outcome_accepted(Prepend)
  } else if symbol == ^record_literal_type_naming_omit {
    outcome_accepted(Omit)
  } else {
    outcome_rejected(
      target_value_expr_operand_wire_malformed_diagnostic(
        wire: target_model_type_atom_node(identity: symbol)
      )
    )
  }
}

fn block_evaluation_mode_to_node(mode: v2.std.compilers.target_model.BlockEvaluationMode) -> v2.std.node.Node {
  match mode {
    ValueProducing =>
      target_model_type_conj_node(
        children: [
          target_model_named_edge(
            name: ^target_value_expr_field_block_eval_kind,
            target: target_model_type_atom_node(
              identity: ^block_evaluation_mode_value_producing
            )
          )
        ]
      )
    StatementSequenced {
      return_token: return_token,
      statement_terminator: statement_terminator
    } =>
      target_model_type_conj_node(
        children: [
          target_model_named_edge(
            name: ^target_value_expr_field_block_eval_kind,
            target: target_model_type_atom_node(
              identity: ^block_evaluation_mode_statement_sequenced
            )
          ),
          target_model_named_edge(
            name: ^target_value_expr_field_block_eval_return_token,
            target: target_model_type_atom_node(identity: return_token)
          ),
          target_model_named_edge(
            name: ^target_value_expr_field_block_eval_terminator,
            target: target_model_type_atom_node(identity: statement_terminator)
          )
        ]
      )
  }
}

fn decode_block_evaluation_mode(bundle: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.BlockEvaluationMode> {
  bind_outcome(
    o: projection_bundle_symbol_field(
      bundle: bundle,
      field: ^target_value_expr_field_block_eval_kind
    ),
    f: fn(kind) {
      if kind == ^block_evaluation_mode_value_producing {
        outcome_accepted(ValueProducing)
      } else if kind == ^block_evaluation_mode_statement_sequenced {
        bind_outcome(
          o: projection_bundle_symbol_field(
            bundle: bundle,
            field: ^target_value_expr_field_block_eval_return_token
          ),
          f: fn(return_token) {
            bind_outcome(
              o: projection_bundle_symbol_field(
                bundle: bundle,
                field: ^target_value_expr_field_block_eval_terminator
              ),
              f: fn(statement_terminator) {
                outcome_accepted(
                  StatementSequenced {
                    return_token: return_token,
                    statement_terminator: statement_terminator
                  }
                )
              }
            )
          }
        )
      } else {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(
            wire: bundle
          )
        )
      }
    }
  )
}

fn decode_record_construct_shape_bundle(bundle: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetRecordConstructShape> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: bundle, field: ^target_value_expr_field_record_open),
    f: fn(open) {
      bind_outcome(
        o: projection_bundle_symbol_field(bundle: bundle, field: ^target_value_expr_field_record_close),
        f: fn(close) {
          bind_outcome(
            o: projection_bundle_symbol_field(bundle: bundle, field: ^target_value_expr_field_record_separator),
            f: fn(separator) {
              bind_outcome(
                o: projection_bundle_symbol_field(bundle: bundle, field: ^target_value_expr_field_record_assign),
                f: fn(assign) {
                  bind_outcome(
                    o: projection_bundle_symbol_field(
                      bundle: bundle,
                      field: ^target_value_expr_field_record_names_type
                    ),
                    f: fn(names_type_symbol) {
                      bind_outcome(
                        o: record_literal_type_naming_from_symbol(symbol: names_type_symbol),
                        f: fn(names_type) {
                          outcome_accepted(
                            TargetRecordConstructShape {
                              open: open,
                              close: close,
                              separator: separator,
                              assign: assign,
                              record_literal_names_type: names_type
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn decode_field_access_shape_bundle(bundle: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetFieldAccessShape> {
  bind_outcome(
