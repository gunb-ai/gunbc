fn decode_value_expression_projection_bundle(
  bundle: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpressionProjection> {
  match bundle.kind {
    TypeNode { connective: Conj } => decode_vep_chain_binding_ref(bundle: bundle)
    _ =>
      outcome_rejected(
        target_value_projection_bundle_malformed_diagnostic(bundle: bundle)
      )
  }
}

fn decode_optional_projection_bundle_symbol_field(
  bundle: v2.std.node.Node,
  field: v2.std.node.Symbol
) -> v2.std.diagnostic.Outcome<Optional<v2.std.node.Symbol>> {
  match find_named_child(root: bundle, name: field) {
    Accepted { value: child, diagnostics: d } =>
      match child.kind {
        TypeNode { connective: Atom { identity: id } } =>
          v2.std.diagnostic.Accepted { value: optional_present(value: id), diagnostics: d }
        _ =>
          outcome_rejected(
            target_type_expr_projection_bundle_malformed_diagnostic(bundle: bundle)
          )
      }
    Rejected { diagnostics: _ } => outcome_accepted(optional_absent())
  }
}

fn decode_atom_type_shape_bundle(bundle: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetAtomTypeShape> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: bundle, field: ^target_type_expr_field_surface),
    f: fn(surface) {
      bind_outcome(
        o: projection_bundle_symbol_field(
          bundle: bundle,
          field: ^target_type_expr_field_ident_token
        ),
        f: fn(ident_token) {
          outcome_accepted(
            TargetAtomTypeShape { surface: surface, ident_token: ident_token }
          )
        }
      )
    }
  )
}

fn decode_generic_apply_shape_bundle(bundle: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetGenericApply> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: bundle, field: ^target_type_expr_field_surface),
    f: fn(surface) {
      bind_outcome(
        o: projection_bundle_symbol_field(bundle: bundle, field: ^target_type_expr_field_open),
        f: fn(open) {
          bind_outcome(
            o: projection_bundle_symbol_field(
              bundle: bundle,
              field: ^target_type_expr_field_separator
            ),
            f: fn(separator) {
              bind_outcome(
                o: projection_bundle_symbol_field(
                  bundle: bundle,
                  field: ^target_type_expr_field_close
                ),
                f: fn(close) {
                  bind_outcome(
                    o: decode_optional_projection_bundle_symbol_field(
                      bundle: bundle,
                      field: ^target_type_expr_field_field_label_separator
                    ),
                    f: fn(field_label_separator) {
                      outcome_accepted(
                        TargetGenericApply {
                          surface: surface,
                          open: open,
                          separator: separator,
                          field_label_separator: field_label_separator,
                          close: close
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn decode_sum_type_shape_bundle(bundle: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetSumTypeShape> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: bundle, field: ^target_type_expr_field_surface),
    f: fn(surface) {
      bind_outcome(
        o: projection_bundle_symbol_field(
          bundle: bundle,
          field: ^target_type_expr_field_variant_separator
        ),
        f: fn(variant_separator) {
          outcome_accepted(
            TargetSumTypeShape {
              surface: surface,
              variant_separator: variant_separator
            }
          )
        }
      )
    }
  )
}

fn decode_function_type_shape_bundle(bundle: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetFunctionTypeShape> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: bundle, field: ^target_type_expr_field_surface),
    f: fn(surface) {
      bind_outcome(
        o: projection_bundle_symbol_field(bundle: bundle, field: ^target_type_expr_field_open),
        f: fn(open) {
          bind_outcome(
            o: projection_bundle_symbol_field(bundle: bundle, field: ^target_type_expr_field_close),
            f: fn(close) {
              bind_outcome(
                o: projection_bundle_symbol_field(bundle: bundle, field: ^target_type_expr_field_arrow),
                f: fn(arrow) {
                  bind_outcome(
                    o: projection_bundle_symbol_field(
                      bundle: bundle,
                      field: ^target_type_expr_field_param_ident_token
                    ),
                    f: fn(param_ident_token) {
                      bind_outcome(
                        o: projection_bundle_symbol_field(
                          bundle: bundle,
                          field: ^target_type_expr_field_param_type_separator
                        ),
                        f: fn(param_type_separator) {
                          bind_outcome(
                            o: projection_bundle_symbol_field(
                              bundle: bundle,
                              field: ^target_type_expr_field_param_list_separator
                            ),
                            f: fn(param_list_separator) {
                              outcome_accepted(
                                TargetFunctionTypeShape {
                                  surface: surface,
                                  open: open,
                                  close: close,
                                  arrow: arrow,
                                  param_ident_token: param_ident_token,
                                  param_type_separator: param_type_separator,
                                  param_list_separator: param_list_separator
                                }
                              )
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn decode_type_expression_projection_bundle(
  bundle: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetTypeExpressionProjection> {
  match bundle.kind {
    TypeNode { connective: Conj } =>
      bind_outcome(
        o: projection_bundle_child(bundle: bundle, name: ^target_type_expr_field_atom),
        f: fn(atom_bundle) {
          bind_outcome(
            o: decode_atom_type_shape_bundle(bundle: atom_bundle),
            f: fn(atom_form) {
              bind_outcome(
                o: projection_bundle_child(bundle: bundle, name: ^target_type_expr_field_conj),
                f: fn(conj_bundle) {
                  bind_outcome(
                    o: decode_generic_apply_shape_bundle(bundle: conj_bundle),
                    f: fn(conj_form) {
                      bind_outcome(
                        o: projection_bundle_child(bundle: bundle, name: ^target_type_expr_field_disj),
                        f: fn(disj_bundle) {
                          bind_outcome(
                            o: decode_sum_type_shape_bundle(bundle: disj_bundle),
                            f: fn(disj_form) {
                              bind_outcome(
                                o: projection_bundle_child(
                                  bundle: bundle,
                                  name: ^target_type_expr_field_arrow
                                ),
                                f: fn(arrow_bundle) {
                                  bind_outcome(
                                    o: decode_function_type_shape_bundle(bundle: arrow_bundle),
                                    f: fn(arrow_form) {
                                      bind_outcome(
                                        o: projection_bundle_child(
                                          bundle: bundle,
                                          name: ^target_type_expr_field_cardinality
                                        ),
                                        f: fn(card_bundle) {
                                          bind_outcome(
                                            o: decode_generic_apply_shape_bundle(bundle: card_bundle),
                                            f: fn(cardinality_form) {
                                              bind_outcome(
                                                o: projection_bundle_child(
                                                  bundle: bundle,
                                                  name: ^target_type_expr_field_instantiation
                                                ),
                                                f: fn(inst_bundle) {
                                                  bind_outcome(
                                                    o: decode_generic_apply_shape_bundle(
                                                      bundle: inst_bundle
                                                    ),
                                                    f: fn(instantiation_form) {
                                                      outcome_accepted(
                                                        TargetTypeExpressionProjection {
                                                          atom_form: atom_form,
                                                          conj_form: conj_form,
                                                          disj_form: disj_form,
                                                          arrow_form: arrow_form,
                                                          cardinality_form: cardinality_form,
                                                          instantiation_form: instantiation_form
                                                        }
                                                      )
                                                    }
                                                  )
                                                }
                                              )
                                            }
                                          )
                                        }
                                      )
                                    }
                                  )
                                }
                              )
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    _ =>
      outcome_rejected(
        target_type_expr_projection_bundle_malformed_diagnostic(bundle: bundle)
      )
  }
}

fn type_expression_projection_from_target(
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetTypeExpressionProjection> {
  bind_outcome(
    o: find_named_child(
      root: target.bundle,
      name: ^target_model_edge_type_expression_projection
    ),
    f: fn(bundle) {
      decode_type_expression_projection_bundle(bundle: bundle)
    }
  )
}

fn concrete_syntax_token_list_to_node(tokens: v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>) -> v2.std.node.Node {
  fold_list_node(xs: tokens, item_node: concrete_syntax_token_to_node)
}

fn grammar_relation_row_attach_bodied_scaffold(
  row: v2.std.node.Node,
  scaffold: v2.std.compilers.target_model.TargetBodiedArrowStatementScaffold
) -> v2.std.node.Node {
  target_model_type_conj_node(
    children: list_append(
      left: row.children,
      right: std.algebra.Cons {
        head: target_model_named_edge(
          name: ^grammar_relation_field_bodied_scaffold,
          target: bodied_arrow_statement_scaffold_bundle_node(scaffold: scaffold)
        ),
        tail: std.algebra.Empty
      }
    )
  )
}

fn bodied_arrow_statement_scaffold_bundle_node(
  scaffold: v2.std.compilers.target_model.TargetBodiedArrowStatementScaffold
) -> v2.std.node.Node {
  target_model_type_conj_node(
    children: [
      target_model_named_edge(
        name: ^target_bodied_arrow_scaffold_field_prefix,
        target: concrete_syntax_token_list_to_node(tokens: scaffold.prefix)
      ),
      target_model_named_edge(
        name: ^target_bodied_arrow_scaffold_field_suffix,
        target: concrete_syntax_token_list_to_node(tokens: scaffold.suffix)
      )
    ]
  )
}

fn grammar_relation_bodied_scaffold_missing_diagnostic(row: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^grammar_relation_bodied_scaffold_missing,
    at: node_locus(node: row),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_bodied_arrow_scaffold_bundle_malformed_diagnostic(bundle: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_bodied_arrow_scaffold_bundle_malformed,
    at: node_locus(node: bundle),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn bodied_arrow_scaffold_from_grammar_relation_row(
  row: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetBodiedArrowStatementScaffold> {
  match find_named_child(root: row, name: ^grammar_relation_field_bodied_scaffold) {
    Accepted { value: scaffold_bundle, diagnostics: d } =>
      bind_outcome(
        o: decode_bodied_arrow_statement_scaffold_bundle(bundle: scaffold_bundle),
        f: fn(scaffold) {
          v2.std.diagnostic.Accepted { value: scaffold, diagnostics: d }
        }
      )
    Rejected { diagnostics: r } =>
      v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn target_bodied_arrow_compose_statement_tokens(
  scaffold: v2.std.compilers.target_model.TargetBodiedArrowStatementScaffold,
  body: v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>
) -> v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  list_append(
    left: list_append(left: scaffold.prefix, right: body),
    right: scaffold.suffix
  )
}

fn concrete_syntax_token_node_targets_from_list_node(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.node.Node>> {
  match node.kind {
    TypeNode { connective: Conj } =>
      if v2.std.algebra.is_empty(xs: node.children) {
        outcome_accepted(std.algebra.Empty)
      } else {
        bind_outcome(
          o: find_named_child(root: node, name: ^fold_list_node_head),
          f: fn(head) {
            bind_outcome(
              o: find_named_child(root: node, name: ^fold_list_node_tail),
              f: fn(tail) {
                bind_outcome(
                  o: concrete_syntax_token_node_targets_from_list_node(node: tail),
                  f: fn(rest) {
                    outcome_accepted(std.algebra.Cons { head: head, tail: rest })
                  }
                )
              }
            )
          }
        )
      }
    _ =>
      outcome_rejected(
        target_bodied_arrow_scaffold_bundle_malformed_diagnostic(bundle: node)
      )
  }
}

fn concrete_syntax_token_list_from_node(list_node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  bind_outcome(
    o: concrete_syntax_token_node_targets_from_list_node(node: list_node),
    f: fn(token_nodes) {
      fold_list(
        xs: token_nodes,
        empty: v2.std.diagnostic.Accepted { value: std.algebra.Empty, diagnostics: v2.std.diagnostic.None },
        cons: fn(acc, token_node) {
          match acc {
            Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
            Accepted { value: partial, diagnostics: ad } =>
              bind_outcome(
                o: concrete_syntax_token_from_wire_node(token: token_node),
                f: fn(tok) {
                  outcome_accepted(
                    list_snoc_item(xs: partial, item: tok)
                  )
                }
              )
          }
        }
      )
    }
  )
}

fn decode_bodied_arrow_statement_scaffold_bundle(
  bundle: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetBodiedArrowStatementScaffold> {
  match bundle.kind {
    TypeNode { connective: Conj } =>
      bind_outcome(
        o: projection_bundle_child(
          bundle: bundle,
          name: ^target_bodied_arrow_scaffold_field_prefix
        ),
        f: fn(prefix_node) {
          bind_outcome(
            o: concrete_syntax_token_list_from_node(list_node: prefix_node),
            f: fn(prefix) {
              bind_outcome(
                o: projection_bundle_child(
                  bundle: bundle,
                  name: ^target_bodied_arrow_scaffold_field_suffix
                ),
                f: fn(suffix_node) {
                  bind_outcome(
                    o: concrete_syntax_token_list_from_node(list_node: suffix_node),
                    f: fn(suffix) {
                      outcome_accepted(
                        TargetBodiedArrowStatementScaffold {
                          prefix: prefix,
                          suffix: suffix
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    _ =>
      outcome_rejected(
        target_bodied_arrow_scaffold_bundle_malformed_diagnostic(bundle: bundle)
      )
  }
}

fn wire_conj_named_binding_atom(parent: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Symbol> {
  bind_outcome(
    o: find_named_child(root: parent, name: ^concrete_syntax_token_field_binding),
    f: fn(binding_node) {
      match binding_node.kind {
        TypeNode { connective: Atom { identity: binding } } =>
          outcome_accepted(binding)
        _ =>
          outcome_rejected(concrete_syntax_token_wire_malformed_diagnostic(token: parent))
      }
    }
  )
}

fn concrete_syntax_token_wire_malformed_diagnostic(token: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^concrete_syntax_token_wire_malformed,
    at: node_locus(node: token),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn concrete_syntax_token_wire_schema_valid(token: v2.std.node.Node) -> v2.std.diagnostic.Outcome<Bool> {
  match token.kind {
    TypeNode { connective: Conj } =>
      if name_occurrences(
        name: ^concrete_syntax_token_field_kind,
        children: token.children
      ) != 1 {
        outcome_rejected(concrete_syntax_token_wire_malformed_diagnostic(token: token))
      } else if name_occurrences(
        name: ^concrete_syntax_token_field_class,
        children: token.children
      ) != 1 {
        outcome_rejected(concrete_syntax_token_wire_malformed_diagnostic(token: token))
      } else {
        match fold(
          token.children,
          init: true,
          f: fn(acc, edge) {
            if acc {
              match edge.label {
                Named { name: n } =>
                  n == ^concrete_syntax_token_field_kind
                  || n == ^concrete_syntax_token_field_class
                  || n == ^concrete_syntax_token_field_binding
                Positional => false
              }
            } else {
              false
            }
          }
        ) {
          false =>
            outcome_rejected(concrete_syntax_token_wire_malformed_diagnostic(token: token))
          true =>
            bind_outcome(
              o: find_named_child(root: token, name: ^concrete_syntax_token_field_kind),
              f: fn(kind_node) {
                match kind_node.kind {
                  TypeNode { connective: Atom { identity: kind } } =>
                    if kind == ^concrete_syntax_token_kind_fixed {
                      if name_occurrences(
                        name: ^concrete_syntax_token_field_binding,
                        children: token.children
                      ) == 0 {
                        outcome_accepted(true)
                      } else {
                        outcome_rejected(
                          concrete_syntax_token_wire_malformed_diagnostic(token: token)
                        )
                      }
                    } else if kind == ^concrete_syntax_token_kind_bound {
                      if name_occurrences(
                        name: ^concrete_syntax_token_field_binding,
                        children: token.children
                      ) == 1 {
                        outcome_accepted(true)
                      } else {
                        outcome_rejected(
                          concrete_syntax_token_wire_malformed_diagnostic(token: token)
                        )
                      }
                    } else {
                      outcome_rejected(
                        concrete_syntax_token_wire_malformed_diagnostic(token: token)
                      )
                    }
                  _ =>
                    outcome_rejected(
                      concrete_syntax_token_wire_malformed_diagnostic(token: token)
                    )
                }
              }
            )
        }
      }
    _ =>
      outcome_rejected(concrete_syntax_token_wire_malformed_diagnostic(token: token))
  }
}

fn concrete_syntax_token_from_wire_node(token: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  bind_outcome(
    o: concrete_syntax_token_wire_schema_valid(token: token),
    f: fn(_) {
      bind_outcome(
        o: projection_bundle_child(bundle: token, name: ^concrete_syntax_token_field_kind),
        f: fn(kind_node) {
          bind_outcome(
            o: projection_bundle_symbol_field(
              bundle: token,
              field: ^concrete_syntax_token_field_class
            ),
            f: fn(token_class) {
              match kind_node.kind {
                TypeNode { connective: Atom { identity: kind } } =>
                  if kind == ^concrete_syntax_token_kind_fixed {
                    outcome_accepted(
                      FixedToken { token_class: token_class }
                    )
                  } else if kind == ^concrete_syntax_token_kind_bound {
                    bind_outcome(
                      o: wire_conj_named_binding_atom(parent: token),
                      f: fn(binding) {
                        outcome_accepted(
                          BoundToken {
                            token_class: token_class,
                            binding: binding
                          }
                        )
                      }
                    )
                  } else {
                    outcome_rejected(
                      concrete_syntax_token_wire_malformed_diagnostic(token: token)
                    )
                  }
                _ =>
                  outcome_rejected(
                    concrete_syntax_token_wire_malformed_diagnostic(token: token)
                  )
              }
            }
          )
        }
      )
    }
  )
}

fn target_value_projection_bundle_malformed_diagnostic(bundle: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_value_projection_bundle_malformed,
    at: node_locus(node: bundle),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

type TargetConstructorTemplate
  = CtorTemplateUnit {}

type TargetAtomRealization {
  source_carrier: v2.std.node.Node
  target_model: v2.std.compilers.target_model.TargetModel
  type_form: v2.std.compilers.target_model.TargetTypeExpression
  value_form: v2.std.compilers.target_model.TargetValueTemplate
  constructor_form: Optional<v2.std.compilers.target_model.TargetConstructorTemplate>
  display_name: v2.std.node.Symbol
}

fn symbol_kernel_type_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^symbol_kernel_type_atom } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn char_kernel_type_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^char_kernel_type_atom } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn source_atom_symbol(identity: v2.std.node.Symbol) -> v2.std.compilers.target_model.SourceAtomValue {
  SourceAtomSymbol { identity: identity }
}

fn source_atom_bool(value: Bool) -> v2.std.compilers.target_model.SourceAtomValue {
  SourceAtomBool { value: value }
}

fn source_atom_char(codepoint: std.types.Char) -> v2.std.compilers.target_model.SourceAtomValue {
  SourceAtomChar { codepoint: codepoint }
}

fn source_atom_char_projection_from_node(source: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.compilers.target_model.SourceAtomValue> {
  match source.kind {
    TypeNode { connective: Atom { identity: c } } =>
      if c == ^char_kernel_type_atom {
        optional_absent()
      } else {
        optional_present(source_atom_char(codepoint: c))
      }
    _ => optional_absent()
  }
}

fn source_atom_string_projection_from_node(source: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.compilers.target_model.SourceAtomValue> {
  source_atom_string_projection_from_node_bounded(source: source, fuel: source_atom_string_projection_node_count(source: source))
}

fn source_atom_string_projection_node_count(source: v2.std.node.Node) -> Int {
  fold_node(
    n: source,
    algebra: v2.std.node.NodeFold {
      init: fn(_) { 1 },
      step: fn(acc, _, child_count) { acc + child_count }
    }
  )
}

fn source_atom_string_projection_from_node_bounded(source: v2.std.node.Node, fuel: Int) -> v2.std.optional.Optional<v2.std.compilers.target_model.SourceAtomValue> {
  if fuel <= 0 {
    optional_absent()
  } else {
    match source.kind {
      TypeNode { connective: Atom { identity: id } } =>
        if id == ^free_monoid_variant_empty {
          optional_present(source_atom_string(value: source))
        } else {
          optional_absent()
        }
      TypeNode { connective: Conj } =>
        if length(xs: source.children) != 2 {
          optional_absent()
        } else {
          match find_named_child(root: source, name: ^free_monoid_field_head) {
            Accepted { value: head } =>
              match find_named_child(root: source, name: ^free_monoid_field_tail) {
                Accepted { value: tail } =>
                  match source_atom_char_projection_from_node(source: head) {
                    Present { value: _ } =>
                      match source_atom_string_projection_from_node_bounded(source: tail, fuel: fuel - 1) {
                        Present { value: _ } => optional_present(source_atom_string(value: source))
                        Absent => optional_absent()
                      }
                    Absent => optional_absent()
                  }
                Rejected { diagnostics: _ } => optional_absent()
              }
            Rejected { diagnostics: _ } => optional_absent()
          }
        }
      _ => optional_absent()
    }
  }
}

fn source_atom_string(value: v2.std.node.Node) -> v2.std.compilers.target_model.SourceAtomValue {
  SourceAtomString { value: value }
}

fn target_model_named_edge(name: v2.std.node.Symbol, target: v2.std.node.Node) -> v2.std.node.Edge {
  v2.std.node.Edge { label: Named { name: name }, target: target }
}

fn source_atom_symbol_projection_from_node(source: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.compilers.target_model.SourceAtomValue> {
  match source.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id == ^symbol_kernel_type_atom {
        optional_absent()
      } else {
        optional_present(source_atom_symbol(identity: id))
      }
    _ => optional_absent()
  }
}

fn source_atom_value_for_value_template(
  source: v2.std.node.Node,
  template: v2.std.compilers.target_model.TargetValueTemplate
) -> v2.std.optional.Optional<v2.std.compilers.target_model.SourceAtomValue> {
  match template.kind {
    ValueSymbolIdentityPassthrough =>
      source_atom_symbol_projection_from_node(source: source)
    ValueSymbolToOwnedString =>
      source_atom_symbol_projection_from_node(source: source)
    ValueBoolLiteral =>
      match source.kind {
        TypeNode { connective: Atom { identity: id } } =>
          if id == ^target_value_expression_bool_true {
            optional_present(source_atom_bool(value: true))
          } else if id == ^target_value_expression_bool_false {
            optional_present(source_atom_bool(value: false))
          } else {
            optional_absent()
          }
        _ => optional_absent()
      }
    ValueCharUnicodeScalar =>
      source_atom_char_projection_from_node(source: source)
    ValueStringLiteral =>
      source_atom_string_projection_from_node(source: source)
    ValueBindingRef =>
      optional_absent()
    ValuePrimitiveApply =>
      optional_absent()
    ValueEffectApply =>
      optional_absent()
    ValueConditional =>
      optional_absent()
    ValueBindLet =>
      optional_absent()
    ValueLoop =>
      optional_absent()
    ValueRecordConstruct =>
      optional_absent()
    ValueFieldAccess =>
      optional_absent()
    ValueMatch =>
      optional_absent()
  }
}

