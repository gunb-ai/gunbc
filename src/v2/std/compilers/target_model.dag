fn target_value_expr_primitive_apply_operand_edges(
  operands: v2.std.collection.List<v2.std.compilers.target_model.TargetValueExpression>
) -> v2.std.collection.List<v2.std.node.Edge> {
  fold_list_right(
    xs: operands,
    empty: std.algebra.Empty,
    snoc: fn(acc, operand) {
      std.algebra.Cons {
        head: target_model_named_edge(
          name: ^target_value_expr_field_operand,
          target: target_value_expression_node(expr: operand)
        ),
        tail: acc
      }
    }
  )
}

fn target_value_expr_operand_wire_malformed_diagnostic(wire: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_value_expr_operand_wire_malformed,
    at: node_locus(node: wire),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_value_expr_binding_ref_wire_schema_valid(wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<Bool> {
  match wire.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id == ^target_value_expression_binding_ref_atom {
        if name_occurrences(
          name: ^target_value_expr_field_binding,
          children: wire.children
        ) != 1 {
          outcome_rejected(
            target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
          )
        } else {
          match fold(
            wire.children,
            init: true,
            f: fn(acc, edge) {
              if acc {
                match edge.label {
                  Named { name: n } => n == ^target_value_expr_field_binding
                  Positional => false
                }
              } else {
                false
              }
            }
          ) {
            true => outcome_accepted(true)
            false =>
              outcome_rejected(
                target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
              )
          }
        }
      } else {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      }
    _ =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

fn target_value_expr_binding_ref_binding_from_wire(wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Symbol> {
  match fold(
    wire.children,
    init: optional_absent(),
    f: fn(acc, edge) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match edge.label {
            Named { name: n } =>
              if n == ^target_value_expr_field_binding {
                match edge.target.kind {
                  TypeNode { connective: Atom { identity: id } } =>
                    optional_present(value: id)
                  _ => acc
                }
              } else {
                acc
              }
            Positional => acc
          }
      }
    }
  ) {
    Present { value: binding } => outcome_accepted(binding)
    Absent =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

fn target_value_expr_operand_wire_binding(operand_wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Symbol> {
  bind_outcome(
    o: target_value_expr_binding_ref_wire_schema_valid(wire: operand_wire),
    f: fn(_) {
      target_value_expr_binding_ref_binding_from_wire(wire: operand_wire)
    }
  )
}

fn target_value_expr_primitive_apply_wire_schema_valid(wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<Bool> {
  match wire.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id != ^target_value_expression_primitive_apply_atom {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else if name_occurrences(
        name: ^target_value_expr_field_operation,
        children: wire.children
      ) != 1 {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else {
        match fold(
          wire.children,
          init: true,
          f: fn(acc, edge) {
            if acc {
              match edge.label {
                Named { name: n } =>
                  n == ^target_value_expr_field_operation
                  || n == ^target_value_expr_field_operand
                Positional => false
              }
            } else {
              false
            }
          }
        ) {
          true => outcome_accepted(true)
          false =>
            outcome_rejected(
              target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
            )
        }
      }
    _ =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

fn target_value_expr_primitive_apply_operand_bindings(wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.node.Symbol>> {
  bind_outcome(
    o: target_value_expr_primitive_apply_wire_schema_valid(wire: wire),
    f: fn(_) {
      match fold(
        wire.children,
        init: v2.std.diagnostic.Accepted { value: std.algebra.Empty, diagnostics: v2.std.diagnostic.None },
        f: fn(acc, edge) {
          match acc {
            Rejected { diagnostics: r } => acc
            Accepted { value: bindings, diagnostics: d } =>
              match edge.label {
                Named { name: n } =>
                  if n == ^target_value_expr_field_operation {
                    acc
                  } else if n == ^target_value_expr_field_operand {
                    bind_outcome(
                      o: target_value_expr_operand_wire_binding(operand_wire: edge.target),
                      f: fn(binding) {
                        outcome_accepted(
                          list_snoc_item(xs: bindings, item: binding)
                        )
                      }
                    )
                  } else {
                    outcome_rejected(
                      target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
                    )
                  }
                Positional =>
                  outcome_rejected(
                    target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
                  )
              }
          }
        }
      ) {
        Accepted { value: bindings, diagnostics: d } =>
          v2.std.diagnostic.Accepted { value: bindings, diagnostics: d }
        Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
      }
    }
  )
}

fn target_value_expression_primitive_apply(
  operation: v2.std.compilers.target_model.CanonicalOperation,
  operands: v2.std.collection.List<v2.std.compilers.target_model.TargetValueExpression>
) -> v2.std.compilers.target_model.TargetValueExpression {
  TargetValueExpression {
    kind: TargetValueExprPrimitiveApply,
    node: v2.std.node.Node {
      kind: v2.std.node.TypeNode {
        connective: v2.std.node.Atom { identity: ^target_value_expression_primitive_apply_atom }
      },
      children: list_append(
        left: [
          target_model_named_edge(
            name: ^target_value_expr_field_operation,
            target: target_model_canonical_operation_wire_node(operation: operation)
          )
        ],
        right: target_value_expr_primitive_apply_operand_edges(operands: operands)
      ),
      occurrence_id: SyntheticOccurrence
    }
  }
}

