}

fn target_value_expr_effect_apply_operand_bindings(wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.node.Symbol>> {
  bind_outcome(
    o: target_value_expr_effect_apply_wire_schema_valid(wire: wire),
    f: fn(_) {
      match fold(
        wire.children,
