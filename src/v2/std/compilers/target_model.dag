fn decode_match_shape_bundle(bundle: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetMatchShape> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: bundle, field: ^target_value_expr_field_match_token),
    f: fn(match_token) {
      bind_outcome(
        o: projection_bundle_symbol_field(
          bundle: bundle,
          field: ^target_value_expr_field_match_scrutinee_open
        ),
        f: fn(scrutinee_open) {
          bind_outcome(
            o: projection_bundle_symbol_field(
              bundle: bundle,
              field: ^target_value_expr_field_match_scrutinee_close
            ),
            f: fn(scrutinee_close) {
              bind_outcome(
                o: projection_bundle_symbol_field(bundle: bundle, field: ^target_value_expr_field_match_open),
                f: fn(open) {
                  bind_outcome(
                    o: projection_bundle_symbol_field(bundle: bundle, field: ^target_value_expr_field_match_close),
                    f: fn(close) {
                      bind_outcome(
                        o: projection_bundle_symbol_field(bundle: bundle, field: ^target_value_expr_field_match_fat_arrow),
                        f: fn(fat_arrow) {
                          bind_outcome(
                            o: projection_bundle_symbol_field(
                              bundle: bundle,
                              field: ^target_value_expr_field_match_arm_separator
                            ),
                            f: fn(arm_separator) {
                              outcome_accepted(
                                TargetMatchShape {
                                  match_token: match_token,
                                  scrutinee_open: scrutinee_open,
                                  scrutinee_close: scrutinee_close,
                                  open: open,
                                  close: close,
                                  fat_arrow: fat_arrow,
                                  arm_separator: arm_separator
                                }
                              )
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn decode_callable_apply_shape_bundle(bundle: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetCallApplyShape> {
  bind_outcome(
