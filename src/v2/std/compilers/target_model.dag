type TargetValueExprMatchArmSlot {
  pattern: TargetValueExpression
  body: TargetValueExpression
}

type TargetValueExprMatchArmEdgeFold {
  edges: List<Edge>
  skipped_scrutinee: Bool
}

fn target_value_expr_positional_child_optional(node: Node, index: Int) -> Optional<Node> {
  list_at_optional(xs: node_positional_child_targets(node: node), index: index)
}

fn target_value_expr_match_arm_edges_after_scrutinee(children: List<Edge>) -> List<Edge> {
  let folded = fold(
    children,
    init: TargetValueExprMatchArmEdgeFold { edges: Empty, skipped_scrutinee: false },
    f: fn(acc, edge) {
      match edge.label {
        Positional =>
          if !acc.skipped_scrutinee {
            TargetValueExprMatchArmEdgeFold {
              edges: acc.edges,
              skipped_scrutinee: true
            }
          } else {
            TargetValueExprMatchArmEdgeFold {
              edges: list_snoc_item(xs: acc.edges, item: edge),
              skipped_scrutinee: true
            }
          }
        Named { name: _ } => acc
      }
    }
  )
  folded.edges
}

fn target_value_expr_match_arm_wire(arm: TargetValueExprMatchArmSlot) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      target_model_named_edge(name: match_arm_pattern, target: arm.pattern.node),
      target_model_named_edge(name: match_arm_body, target: arm.body.node)
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn target_value_expr_match_arm_edges(arms: List<TargetValueExprMatchArmSlot>) -> List<Edge> {
  fold(arms, init: Empty, f: fn(acc, arm) {
    list_snoc_item(xs: acc, item: Edge { label: Positional, target: target_value_expr_match_arm_wire(arm: arm) })
  })
}

fn target_value_expression_match(
  scrutinee: TargetValueExpression,
