}

fn decode_closure_shape_bundle(bundle: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetClosureShape> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: bundle, field: ^target_value_expr_field_fn_token),
    f: fn(fn_token) {
      bind_outcome(
        o: projection_bundle_symbol_field(bundle: bundle, field: ^target_value_expr_field_open),
        f: fn(open) {
          bind_outcome(
            o: projection_bundle_symbol_field(
              bundle: bundle,
              field: ^target_value_expr_field_separator
            ),
            f: fn(separator) {
              bind_outcome(
                o: projection_bundle_symbol_field(
                  bundle: bundle,
                  field: ^target_value_expr_field_close
                ),
                f: fn(close) {
                  bind_outcome(
                    o: projection_bundle_symbol_field(
                      bundle: bundle,
                      field: ^target_value_expr_field_body_open
                    ),
                    f: fn(body_open) {
                      bind_outcome(
                        o: projection_bundle_symbol_field(
                          bundle: bundle,
                          field: ^target_value_expr_field_body_close
                        ),
                        f: fn(body_close) {
                          bind_outcome(
                            o: projection_bundle_symbol_field(
                              bundle: bundle,
                              field: ^target_value_expr_field_ident_token
                            ),
                            f: fn(param_ident_token) {
                              outcome_accepted(
                                TargetClosureShape {
                                  fn_token: fn_token,
                                  open: open,
                                  separator: separator,
                                  close: close,
                                  body_open: body_open,
                                  body_close: body_close,
                                  param_ident_token: param_ident_token
                                }
                              )
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn target_value_expr_effect_callee_row_node(row: v2.std.compilers.target_model.TargetEffectCalleeRow) -> v2.std.node.Node {
  target_model_type_conj_node(
    children: [
      target_model_named_edge(
        name: ^target_value_expr_field_effect_kind,
        target: target_model_type_atom_node(identity: row.effect_kind)
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_effect_callee,
        target: target_model_type_atom_node(identity: row.callee)
      )
    ]
  )
}

fn target_value_expr_effect_callee_row_from_wire(row: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetEffectCalleeRow> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: row, field: ^target_value_expr_field_effect_kind),
    f: fn(effect_kind) {
      bind_outcome(
        o: projection_bundle_symbol_field(bundle: row, field: ^target_value_expr_field_effect_callee),
        f: fn(callee) {
          outcome_accepted(
            TargetEffectCalleeRow { effect_kind: effect_kind, callee: callee }
          )
        }
      )
    }
  )
}

fn decode_effect_apply_callee_rows(bundle: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.TargetEffectCalleeRow>> {
  match fold(
    bundle.children,
    init: v2.std.diagnostic.Accepted { value: std.algebra.Empty, diagnostics: v2.std.diagnostic.None },
    f: fn(acc, edge) {
      match acc {
        Rejected { diagnostics: r } => acc
        Accepted { value: rows, diagnostics: d } =>
          match edge.label {
            Named { name: n } =>
              if n == ^target_value_expr_effect_callee_row_edge {
                bind_outcome(
                  o: target_value_expr_effect_callee_row_from_wire(row: edge.target),
                  f: fn(row) {
                    outcome_accepted(list_snoc_item(xs: rows, item: row))
                  }
                )
              } else {
                acc
              }
            Positional => acc
          }
      }
    }
  ) {
    Accepted { value: rows, diagnostics: d } => v2.std.diagnostic.Accepted { value: rows, diagnostics: d }
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn decode_effect_apply_shape_bundle(bundle: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetEffectApplyShape> {
  bind_outcome(
    o: decode_effect_apply_callee_rows(bundle: bundle),
    f: fn(callees) {
      bind_outcome(
        o: projection_bundle_symbol_field(bundle: bundle, field: ^target_value_expr_field_open),
        f: fn(open) {
          bind_outcome(
            o: projection_bundle_symbol_field(
              bundle: bundle,
              field: ^target_value_expr_field_close
            ),
            f: fn(close) {
              bind_outcome(
                o: projection_bundle_symbol_field(
                  bundle: bundle,
                  field: ^target_value_expr_field_separator
                ),
                f: fn(separator) {
                  outcome_accepted(
                    TargetEffectApplyShape {
                      callees: callees,
                      open: open,
                      close: close,
                      separator: separator
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

