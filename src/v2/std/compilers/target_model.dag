// Lane 2c — decode the closure spelling shape (fn / param framing / body framing).
fn decode_closure_shape_bundle(bundle: Node) -> Outcome<TargetClosureShape> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: bundle, field: ^target_value_expr_field_fn_token),
    f: fn(fn_token) {
      bind_outcome(
        o: projection_bundle_symbol_field(bundle: bundle, field: ^target_value_expr_field_open),
        f: fn(open) {
          bind_outcome(
            o: projection_bundle_symbol_field(
              bundle: bundle,
              field: ^target_value_expr_field_separator
            ),
            f: fn(separator) {
              bind_outcome(
                o: projection_bundle_symbol_field(
                  bundle: bundle,
                  field: ^target_value_expr_field_close
                ),
                f: fn(close) {
                  bind_outcome(
                    o: projection_bundle_symbol_field(
                      bundle: bundle,
                      field: ^target_value_expr_field_body_open
                    ),
                    f: fn(body_open) {
                      bind_outcome(
                        o: projection_bundle_symbol_field(
                          bundle: bundle,
                          field: ^target_value_expr_field_body_close
                        ),
                        f: fn(body_close) {
                          bind_outcome(
                            o: projection_bundle_symbol_field(
                              bundle: bundle,
                              field: ^target_value_expr_field_ident_token
                            ),
                            f: fn(param_ident_token) {
                              outcome_accepted(
                                TargetClosureShape {
                                  fn_token: fn_token,
                                  open: open,
                                  separator: separator,
                                  close: close,
                                  body_open: body_open,
                                  body_close: body_close,
                                  param_ident_token: param_ident_token
                                }
                              )
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

// Serialize one effect-callee catalog row (effect-kind discriminant + host shim callee Symbol).
fn target_value_expr_effect_callee_row_node(row: TargetEffectCalleeRow) -> Node {
  target_model_type_conj_node(
    children: [
      target_model_named_edge(
        name: ^target_value_expr_field_effect_kind,
        target: target_model_type_atom_node(identity: row.effect_kind)
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_effect_callee,
        target: target_model_type_atom_node(identity: row.callee)
      )
    ]
  )
}

// Decode one effect-callee catalog row (effect-kind discriminant + host shim callee Symbol).
fn target_value_expr_effect_callee_row_from_wire(row: Node) -> Outcome<TargetEffectCalleeRow> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: row, field: ^target_value_expr_field_effect_kind),
    f: fn(effect_kind) {
      bind_outcome(
        o: projection_bundle_symbol_field(bundle: row, field: ^target_value_expr_field_effect_callee),
        f: fn(callee) {
          outcome_accepted(
            TargetEffectCalleeRow { effect_kind: effect_kind, callee: callee }
          )
        }
      )
    }
  )
}

// Fold the effect-callee catalog rows off the wire bundle. Row edges carry
// `^target_value_expr_effect_callee_row_edge`; the open / close / separator framing edges are named
// differently and are skipped here (decoded by `decode_effect_apply_shape_bundle`). A malformed row
// fails the whole decode closed.
fn decode_effect_apply_callee_rows(bundle: Node) -> Outcome<List<TargetEffectCalleeRow>> {
  match fold(
    bundle.children,
    init: Accepted { value: Empty, diagnostics: None },
    f: fn(acc, edge) {
      match acc {
        Rejected { diagnostics: r } => acc
        Accepted { value: rows, diagnostics: d } =>
          match edge.label {
            Named { name: n } =>
              if n == ^target_value_expr_effect_callee_row_edge {
                bind_outcome(
                  o: target_value_expr_effect_callee_row_from_wire(row: edge.target),
                  f: fn(row) {
                    outcome_accepted(list_snoc_item(xs: rows, item: row))
                  }
                )
              } else {
                acc
              }
            Positional => acc
          }
      }
    }
  ) {
    Accepted { value: rows, diagnostics: d } => Accepted { value: rows, diagnostics: d }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn decode_effect_apply_shape_bundle(bundle: Node) -> Outcome<TargetEffectApplyShape> {
  bind_outcome(
    o: decode_effect_apply_callee_rows(bundle: bundle),
    f: fn(callees) {
      bind_outcome(
        o: projection_bundle_symbol_field(bundle: bundle, field: ^target_value_expr_field_open),
        f: fn(open) {
          bind_outcome(
            o: projection_bundle_symbol_field(
              bundle: bundle,
              field: ^target_value_expr_field_close
            ),
            f: fn(close) {
              bind_outcome(
                o: projection_bundle_symbol_field(
                  bundle: bundle,
                  field: ^target_value_expr_field_separator
                ),
                f: fn(separator) {
                  outcome_accepted(
                    TargetEffectApplyShape {
                      callees: callees,
                      open: open,
                      close: close,
                      separator: separator
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn decode_value_expression_projection_bundle(
  bundle: Node
) -> Outcome<TargetValueExpressionProjection> {
  match bundle.kind {
    TypeNode { connective: Conj } =>
      bind_outcome(
        o: projection_bundle_child(
          bundle: bundle,
          name: ^target_value_expr_field_binding_ref
        ),
        f: fn(binding_ref_bundle) {
          bind_outcome(
            o: decode_binding_ref_shape_bundle(bundle: binding_ref_bundle),
            f: fn(binding_ref_form) {
              bind_outcome(
                o: projection_bundle_child(
                  bundle: bundle,
                  name: ^target_value_expr_field_primitive_apply
                ),
                f: fn(primitive_bundle) {
                  bind_outcome(
                    o: decode_primitive_apply_shape_bundle(bundle: primitive_bundle),
                    f: fn(primitive_apply_form) {
                      bind_outcome(
                        o: projection_bundle_child(
                          bundle: bundle,
                          name: ^target_value_expr_field_callable_apply
                        ),
                        f: fn(callable_bundle) {
                          bind_outcome(
                            o: decode_callable_apply_shape_bundle(bundle: callable_bundle),
                            f: fn(callable_apply_form) {
                              bind_outcome(
                                o: projection_bundle_child(
                                  bundle: bundle,
                                  name: ^target_value_expr_field_closure
                                ),
                                f: fn(closure_bundle) {
                              bind_outcome(
                                o: decode_closure_shape_bundle(bundle: closure_bundle),
                                f: fn(closure_form) {
                              bind_outcome(
                                o: projection_bundle_child(
                                  bundle: bundle,
                                  name: ^target_value_expr_field_effect_apply
                                ),
                                f: fn(effect_bundle) {
                                  bind_outcome(
                                    o: decode_effect_apply_shape_bundle(bundle: effect_bundle),
                                    f: fn(effect_apply_form) {
                                      bind_outcome(
                                        o: projection_bundle_child(
                                          bundle: bundle,
                                          name: ^target_value_expr_field_conditional
                                        ),
                                        f: fn(conditional_bundle) {
                                          bind_outcome(
                                            o: decode_conditional_shape_bundle(
                                              bundle: conditional_bundle
                                            ),
                                            f: fn(conditional_form) {
                                              bind_outcome(
                                                o: projection_bundle_child(
                                                  bundle: bundle,
                                                  name: ^target_value_expr_field_bind_let
                                                ),
                                                f: fn(bind_let_bundle) {
                                                  bind_outcome(
                                                    o: decode_bind_let_shape_bundle(
                                                      bundle: bind_let_bundle
                                                    ),
                                                    f: fn(let_form) {
                                                      bind_outcome(
                                                        o: projection_bundle_child(
                                                          bundle: bundle,
                                                          name: ^target_value_expr_field_loop
                                                        ),
                                                        f: fn(loop_bundle) {
                                                          bind_outcome(
                                                            o: decode_loop_shape_bundle(
                                                              bundle: loop_bundle
                                                            ),
                                                            f: fn(loop_form) {
                                                              bind_outcome(
                                                                o: projection_bundle_child(
                                                                  bundle: bundle,
                                                                  name: ^target_value_expr_field_record_construct
                                                                ),
                                                                f: fn(record_bundle) {
                                                                  bind_outcome(
                                                                    o: decode_record_construct_shape_bundle(
                                                                      bundle: record_bundle
                                                                    ),
                                                                    f: fn(record_construct_form) {
                                                                      bind_outcome(
                                                                        o: projection_bundle_child(
                                                                          bundle: bundle,
                                                                          name: ^target_value_expr_field_field_access
                                                                        ),
                                                                        f: fn(field_access_bundle) {
                                                                          bind_outcome(
                                                                            o: decode_field_access_shape_bundle(
                                                                              bundle: field_access_bundle
                                                                            ),
                                                                            f: fn(field_access_form) {
                                                                              bind_outcome(
                                                                                o: projection_bundle_child(
                                                                                  bundle: bundle,
                                                                                  name: ^target_value_expr_field_match
                                                                                ),
                                                                                f: fn(match_bundle) {
                                                                                  bind_outcome(
                                                                                    o: decode_match_shape_bundle(
                                                                                      bundle: match_bundle
                                                                                    ),
                                                                                    f: fn(match_form) {
                                                                                      outcome_accepted(
                                                                                        TargetValueExpressionProjection {
                                                                                          binding_ref_form: binding_ref_form,
                                                                                          primitive_apply_form: primitive_apply_form,
                                                                                          callable_apply_form: callable_apply_form,
                                                                                          closure_form: closure_form,
                                                                                          effect_apply_form: effect_apply_form,
                                                                                          conditional_form: conditional_form,
                                                                                          let_form: let_form,
                                                                                          loop_form: loop_form,
                                                                                          record_construct_form: record_construct_form,
                                                                                          field_access_form: field_access_form,
                                                                                          match_form: match_form
                                                                                        }
                                                                                      )
                                                                                    }
                                                                                  )
                                                                                }
                                                                              )
                                                                            }
                                                                          )
                                                                        }
                                                                      )
                                                                    }
                                                                  )
                                                                }
                                                              )
                                                            }
                                                          )
                                                        }
                                                      )
                                                    }
                                                  )
                                                }
                                              )
                                            }
                                          )
                                        }
                                      )
                                    }
                                  )
                                }
                              )
                            }
                          )
                                }
                              )
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    _ =>
      outcome_rejected(
        target_value_projection_bundle_malformed_diagnostic(bundle: bundle)
      )
  }
}

fn decode_optional_projection_bundle_symbol_field(
  bundle: Node,
  field: Symbol
) -> Outcome<Optional<Symbol>> {
  match find_named_child(root: bundle, name: field) {
    Accepted { value: child, diagnostics: d } =>
      match child.kind {
        TypeNode { connective: Atom { identity: id } } =>
          Accepted { value: optional_present(value: id), diagnostics: d }
        _ =>
          outcome_rejected(
            target_type_expr_projection_bundle_malformed_diagnostic(bundle: bundle)
          )
      }
    Rejected { diagnostics: _ } => outcome_accepted(optional_absent())
  }
}

fn decode_atom_type_shape_bundle(bundle: Node) -> Outcome<TargetAtomTypeShape> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: bundle, field: ^target_type_expr_field_surface),
    f: fn(surface) {
      bind_outcome(
        o: projection_bundle_symbol_field(
          bundle: bundle,
          field: ^target_type_expr_field_ident_token
        ),
        f: fn(ident_token) {
          outcome_accepted(
            TargetAtomTypeShape { surface: surface, ident_token: ident_token }
          )
        }
      )
    }
  )
}

fn decode_generic_apply_shape_bundle(bundle: Node) -> Outcome<TargetGenericApply> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: bundle, field: ^target_type_expr_field_surface),
    f: fn(surface) {
      bind_outcome(
        o: projection_bundle_symbol_field(bundle: bundle, field: ^target_type_expr_field_open),
        f: fn(open) {
          bind_outcome(
            o: projection_bundle_symbol_field(
              bundle: bundle,
              field: ^target_type_expr_field_separator
            ),
            f: fn(separator) {
              bind_outcome(
                o: projection_bundle_symbol_field(
                  bundle: bundle,
                  field: ^target_type_expr_field_close
                ),
                f: fn(close) {
                  bind_outcome(
                    o: decode_optional_projection_bundle_symbol_field(
                      bundle: bundle,
                      field: ^target_type_expr_field_field_label_separator
                    ),
                    f: fn(field_label_separator) {
                      outcome_accepted(
                        TargetGenericApply {
                          surface: surface,
                          open: open,
                          separator: separator,
                          field_label_separator: field_label_separator,
                          close: close
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn decode_sum_type_shape_bundle(bundle: Node) -> Outcome<TargetSumTypeShape> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: bundle, field: ^target_type_expr_field_surface),
    f: fn(surface) {
      bind_outcome(
        o: projection_bundle_symbol_field(
          bundle: bundle,
          field: ^target_type_expr_field_variant_separator
        ),
        f: fn(variant_separator) {
          outcome_accepted(
            TargetSumTypeShape {
              surface: surface,
              variant_separator: variant_separator
            }
          )
        }
      )
    }
  )
}

fn decode_function_type_shape_bundle(bundle: Node) -> Outcome<TargetFunctionTypeShape> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: bundle, field: ^target_type_expr_field_surface),
    f: fn(surface) {
      bind_outcome(
        o: projection_bundle_symbol_field(bundle: bundle, field: ^target_type_expr_field_open),
        f: fn(open) {
          bind_outcome(
            o: projection_bundle_symbol_field(bundle: bundle, field: ^target_type_expr_field_close),
            f: fn(close) {
              bind_outcome(
                o: projection_bundle_symbol_field(bundle: bundle, field: ^target_type_expr_field_arrow),
                f: fn(arrow) {
                  bind_outcome(
                    o: projection_bundle_symbol_field(
                      bundle: bundle,
                      field: ^target_type_expr_field_param_ident_token
                    ),
                    f: fn(param_ident_token) {
                      bind_outcome(
                        o: projection_bundle_symbol_field(
                          bundle: bundle,
                          field: ^target_type_expr_field_param_type_separator
                        ),
                        f: fn(param_type_separator) {
                          bind_outcome(
                            o: projection_bundle_symbol_field(
                              bundle: bundle,
                              field: ^target_type_expr_field_param_list_separator
                            ),
                            f: fn(param_list_separator) {
                              outcome_accepted(
                                TargetFunctionTypeShape {
                                  surface: surface,
                                  open: open,
                                  close: close,
                                  arrow: arrow,
                                  param_ident_token: param_ident_token,
                                  param_type_separator: param_type_separator,
                                  param_list_separator: param_list_separator
                                }
                              )
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
