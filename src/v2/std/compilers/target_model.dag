fn target_value_expr_effect_apply_callee(
  effect_kind: v2.std.node.Symbol,
  shape: v2.std.compilers.target_model.TargetEffectApplyShape,
  expr: v2.std.compilers.target_model.TargetValueExpression
) -> v2.std.diagnostic.Outcome<v2.std.node.Symbol> {
  match v2.std.collection.map_get(
    m: fold_list(
      xs: shape.callees,
      empty: empty_map(),
      cons: fn(acc, row) { map_insert(acc, row.effect_kind, row.callee) }
    ),
    key: effect_kind
  ) {
    Accepted { value: found, diagnostics: _ } =>
      match found {
        Present { value: callee } => outcome_accepted(callee)
        Absent =>
          outcome_rejected(
            target_value_expression_emit_unsupported_kind_diagnostic(expr: expr)
          )
      }
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn target_value_expression_effect_apply_to_concrete_tokens(
  expr: v2.std.compilers.target_model.TargetValueExpression,
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  bind_outcome(
    o: target_value_expr_effect_apply_kind_from_wire(wire: expr.node),
    f: fn(effect_kind) {
      bind_outcome(
        o: target_value_expr_effect_apply_callee(
          effect_kind: effect_kind,
          shape: projection.effect_apply_form,
          expr: expr
        ),
        f: fn(callee) {
          bind_outcome(
            o: target_value_expr_effect_apply_operand_bindings(wire: expr.node),
            f: fn(bindings) {

              outcome_accepted(
                list_append(
                  left: list_append(
                    left: std.algebra.Cons {
                      head: FixedToken { token_class: callee },
                      tail: std.algebra.Cons {
                        head: FixedToken { token_class: projection.effect_apply_form.open },
                        tail: std.algebra.Empty
                      }
                    },
                    right: target_value_expression_binding_refs_intersperse_separator(
                      bindings: bindings,
                      projection: projection,
                      separator: projection.effect_apply_form.separator
                    )
                  ),
                  right: std.algebra.Cons {
                    head: FixedToken { token_class: projection.effect_apply_form.close },
                    tail: std.algebra.Empty
                  }
                )
              )
            }
          )
        }
      )
    }
  )
}

