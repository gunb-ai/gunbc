}

fn target_value_expr_bind_let_child_from_wire(
  wire: v2.std.node.Node,
  field: v2.std.node.Symbol
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression> {
  target_value_expr_conditional_child_from_wire(wire: wire, field: field)
}

fn bind_let_value_producing_tokens(
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection,
  key_tokens: v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>,
  value_tokens: v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>,
  body_tokens: v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>
) -> v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  list_append(
    left: list_append(
      left: list_append(
        left: list_append(
          left: list_append(
            left: [
              FixedToken { token_class: projection.let_form.let_token }
            ],
            right: key_tokens
          ),
          right: [
            FixedToken { token_class: projection.let_form.assign_token }
          ]
        ),
        right: value_tokens
      ),
      right: [
        FixedToken { token_class: projection.let_form.in_token }
      ]
    ),
    right: body_tokens
  )
}

fn bind_let_statement_sequenced_tokens(
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection,
  key_tokens: v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>,
  value_tokens: v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>,
  body_tokens: v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>,
  return_token: v2.std.node.Symbol,
  statement_terminator: v2.std.node.Symbol
) -> v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  list_append(
    left: list_append(
      left: list_append(
        left: list_append(
          left: list_append(
            left: list_append(
              left: [
                FixedToken { token_class: projection.primitive_apply_form.open },
                FixedToken { token_class: projection.closure_form.fn_token },
                FixedToken { token_class: projection.closure_form.open },
                FixedToken { token_class: projection.closure_form.close },
                FixedToken { token_class: projection.closure_form.body_open },
                FixedToken { token_class: projection.let_form.let_token }
              ],
              right: key_tokens
            ),
            right: [
              FixedToken { token_class: projection.let_form.assign_token }
            ]
          ),
          right: value_tokens
        ),
        right: [
          FixedToken { token_class: statement_terminator },
          FixedToken { token_class: return_token }
        ]
      ),
      right: body_tokens
    ),
    right: [
      FixedToken { token_class: statement_terminator },
      FixedToken { token_class: projection.closure_form.body_close },
      FixedToken { token_class: projection.primitive_apply_form.close },
      FixedToken { token_class: projection.primitive_apply_form.open },
      FixedToken { token_class: projection.primitive_apply_form.close }
    ]
  )
}

fn target_value_expression_bind_let_to_concrete_tokens(
  expr: v2.std.compilers.target_model.TargetValueExpression,
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection,
  catalog: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  bind_outcome(
    o: target_value_expr_bind_let_wire_schema_valid(wire: expr.node),
    f: fn(_) {
      bind_outcome(
        o: target_value_expr_bind_let_child_from_wire(
          wire: expr.node,
          field: ^target_value_expr_field_bind_key
        ),
        f: fn(bind_key) {
          bind_outcome(
            o: target_value_expr_bind_let_child_from_wire(
              wire: expr.node,
              field: ^target_value_expr_field_bind_value
            ),
            f: fn(bind_value) {
              bind_outcome(
                o: target_value_expr_bind_let_child_from_wire(
                  wire: expr.node,
                  field: ^target_value_expr_field_bind_body
                ),
                f: fn(bind_body) {
                  bind_outcome(
                    o: target_value_expression_to_concrete_tokens(
                      expr: bind_key,
                      projection: projection,
                      catalog: catalog
                    ),
                    f: fn(key_tokens) {
                      bind_outcome(
                        o: target_value_expression_to_concrete_tokens(
                          expr: bind_value,
                          projection: projection,
                          catalog: catalog
                        ),
                        f: fn(value_tokens) {
                          bind_outcome(
                            o: target_value_expression_to_concrete_tokens(
                              expr: bind_body,
                              projection: projection,
                              catalog: catalog
                            ),
                            f: fn(body_tokens) {
                              match projection.block_evaluation_mode {
                                ValueProducing =>
                                  outcome_accepted(
                                    bind_let_value_producing_tokens(
                                      projection: projection,
                                      key_tokens: key_tokens,
                                      value_tokens: value_tokens,
                                      body_tokens: body_tokens
                                    )
                                  )
                                StatementSequenced {
                                  return_token: return_token,
                                  statement_terminator: statement_terminator
                                } =>
                                  outcome_accepted(
                                    bind_let_statement_sequenced_tokens(
                                      projection: projection,
                                      key_tokens: key_tokens,
                                      value_tokens: value_tokens,
                                      body_tokens: body_tokens,
                                      return_token: return_token,
                                      statement_terminator: statement_terminator
                                    )
                                  )
                              }
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn target_value_expr_loop_wire_schema_valid(wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<Bool> {
  match wire.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id != ^target_value_expression_loop_atom {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else if name_occurrences(
        name: ^target_value_expr_field_loop_body,
        children: wire.children
      ) != 1 {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else {
        outcome_accepted(true)
      }
    _ =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

fn target_value_expr_loop_child_from_wire(wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression> {
  target_value_expr_conditional_child_from_wire(
    wire: wire,
    field: ^target_value_expr_field_loop_body
  )
}

fn statement_sequenced_block_construct_unwired_diagnostic(wire: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^statement_sequenced_block_construct_unwired,
    at: node_locus(node: wire),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn statement_sequenced_block_construct_guard(
  block_evaluation_mode: v2.std.compilers.target_model.BlockEvaluationMode,
  wire: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<Bool> {
  match block_evaluation_mode {
    ValueProducing => outcome_accepted(true)
    StatementSequenced {
      return_token: _,
      statement_terminator: _
    } =>
      outcome_rejected(
        statement_sequenced_block_construct_unwired_diagnostic(wire: wire)
      )
  }
}

fn target_value_expression_loop_to_concrete_tokens(
  expr: v2.std.compilers.target_model.TargetValueExpression,
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection,
  catalog: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  bind_outcome(
    o: statement_sequenced_block_construct_guard(
      block_evaluation_mode: projection.block_evaluation_mode,
      wire: expr.node
    ),
    f: fn(_) {
      target_value_expression_loop_to_concrete_tokens_inner(
        expr: expr,
        projection: projection,
        catalog: catalog
      )
    }
  )
}

fn target_value_expression_loop_to_concrete_tokens_inner(
  expr: v2.std.compilers.target_model.TargetValueExpression,
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection,
  catalog: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  bind_outcome(
    o: target_value_expr_loop_wire_schema_valid(wire: expr.node),
    f: fn(_) {
      bind_outcome(
        o: target_value_expr_loop_child_from_wire(wire: expr.node),
        f: fn(body) {
          bind_outcome(
            o: target_value_expression_to_concrete_tokens(
              expr: body,
              projection: projection,
              catalog: catalog
            ),
            f: fn(body_tokens) {
              outcome_accepted(
                list_append(
                  left: std.algebra.Cons {
                    head: FixedToken {
                      token_class: projection.loop_form.loop_token
                    },
                    tail: std.algebra.Empty
                  },
                  right: body_tokens
                )
              )
            }
          )
        }
      )
    }
  )
}

fn target_value_expr_wire_atom_identity(wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Symbol> {
  match wire.kind {
    TypeNode { connective: Atom { identity: id } } => outcome_accepted(id)
    _ =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

fn target_value_expr_record_construct_wire_schema_valid(wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<Bool> {
  match wire.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id != ^target_value_expression_record_construct_atom {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else if name_occurrences(
        name: ^target_value_expr_field_record_type,
        children: wire.children
      ) != 1 {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else if !all_edges_named(children: wire.children) {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else {
        outcome_accepted(true)
      }
    _ =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

fn target_value_expr_record_construct_type_from_wire(wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Symbol> {
  match fold(
    wire.children,
    init: optional_absent(),
    f: fn(acc, edge) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match edge.label {
            Named { name: n } =>
              if n == ^target_value_expr_field_record_type {
                match edge.target.kind {
                  TypeNode { connective: Atom { identity: id } } =>
                    optional_present(value: id)
                  _ => acc
                }
              } else {
                acc
              }
            Positional => acc
          }
      }
    }
  ) {
    Present { value: type_name } => outcome_accepted(type_name)
    Absent =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

fn target_value_expr_record_construct_field_slots_from_wire(
  wire: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.TargetValueExprFieldInitSlot>> {
  match fold(
    wire.children,
    init: v2.std.diagnostic.Accepted { value: std.algebra.Empty, diagnostics: v2.std.diagnostic.None },
    f: fn(acc, edge) {
      match acc {
        Rejected { diagnostics: r } => acc
        Accepted { value: slots, diagnostics: d } =>
          match edge.label {
            Named { name: n } =>
              if n == ^target_value_expr_field_record_type {
                acc
              } else {
                bind_outcome(
                  o: target_value_expression_reify_from_wire(wire: edge.target),
                  f: fn(value) {
                    outcome_accepted(
                      list_snoc_item(
                        xs: slots,
                        item: v2.std.compilers.target_model.TargetValueExprFieldInitSlot { label: n, value: value }
                      )
                    )
                  }
                )
              }
            Positional =>
              outcome_rejected(
                target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
              )
          }
      }
    }
  ) {
    Accepted { value: slots, diagnostics: d } => v2.std.diagnostic.Accepted { value: slots, diagnostics: d }
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn target_value_expr_labeled_edge_head(labeled: v2.std.collection.List<v2.std.node.Edge>) -> v2.std.optional.Optional<v2.std.node.Edge> {
  fold(labeled, init: optional_absent(), f: fn(acc, edge) {
    match acc {
      Present { value: _ } => acc
      Absent => optional_present(value: edge)
    }
  })
}

fn target_value_expr_labeled_edges_tail(labeled: v2.std.collection.List<v2.std.node.Edge>) -> v2.std.collection.List<v2.std.node.Edge> {
  match list_tail(xs: labeled) {
    TailFound { tail: rest } => rest
    TailAbsent => std.algebra.Empty
  }
}

fn target_value_expr_record_construct_field_tokens(
  slots: v2.std.collection.List<v2.std.compilers.target_model.TargetValueExprFieldInitSlot>,
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection,
  catalog: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  match fold(
    slots,
    init: v2.std.diagnostic.Accepted { value: std.algebra.Empty, diagnostics: v2.std.diagnostic.None },
    f: fn(acc, slot) {
      match acc {
        Rejected { diagnostics: r } => acc
        Accepted { value: prior_tokens, diagnostics: d } =>
          bind_outcome(
            o: target_value_expression_to_concrete_tokens(
              expr: slot.value,
              projection: projection,
              catalog: catalog
            ),
            f: fn(value_tokens) {
              let field_chunk = list_append(
                left: list_append(
                  left: std.algebra.Cons {
                    head: target_value_expression_binding_ref_token(
                      binding: slot.label,
                      projection: projection
                    ),
                    tail: std.algebra.Empty
                  },
                  right: std.algebra.Cons {
                    head: FixedToken {
                      token_class: projection.record_construct_form.assign
                    },
                    tail: std.algebra.Empty
                  }
                ),
                right: value_tokens
              )
              if v2.std.algebra.is_empty(xs: prior_tokens) {
                outcome_accepted(field_chunk)
              } else {
                outcome_accepted(
                  list_append(
                    left: list_append(
                      left: prior_tokens,
                      right: std.algebra.Cons {
                        head: FixedToken {
                          token_class: projection.record_construct_form.separator
                        },
                        tail: std.algebra.Empty
                      }
                    ),
                    right: field_chunk
                  )
                )
              }
            }
          )
      }
    }
  ) {
    Accepted { value: tokens, diagnostics: d } => v2.std.diagnostic.Accepted { value: tokens, diagnostics: d }
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn target_value_expression_record_construct_to_concrete_tokens(
  expr: v2.std.compilers.target_model.TargetValueExpression,
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection,
  catalog: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  bind_outcome(
    o: target_value_expr_record_construct_wire_schema_valid(wire: expr.node),
    f: fn(_) {
      bind_outcome(
        o: target_value_expr_record_construct_type_from_wire(wire: expr.node),
        f: fn(type_name) {
          bind_outcome(
            o: target_value_expr_record_construct_field_slots_from_wire(wire: expr.node),
            f: fn(field_slots) {
              bind_outcome(
                o: target_value_expr_record_construct_field_tokens(
                  slots: field_slots,
                  projection: projection,
                  catalog: catalog
                ),
                f: fn(field_tokens) {
                  let type_name_prefix_tokens = match projection.record_construct_form.record_literal_names_type {
                    Prepend => std.algebra.Cons {
                      head: target_value_expression_binding_ref_token(
                        binding: type_name,
                        projection: projection
                      ),
                      tail: std.algebra.Empty
                    }
                    Omit => std.algebra.Empty
                  }
                  outcome_accepted(
                    list_append(
                      left: list_append(
                        left: list_append(
                          left: type_name_prefix_tokens,
                          right: std.algebra.Cons {
                            head: FixedToken {
                              token_class: projection.record_construct_form.open
                            },
                            tail: std.algebra.Empty
                          }
                        ),
                        right: field_tokens
                      ),
                      right: std.algebra.Cons {
                        head: FixedToken {
                          token_class: projection.record_construct_form.close
                        },
                        tail: std.algebra.Empty
                      }
                    )
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn target_import_empty_names_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_import_names_empty,
    at: port_locus(port: ^target_import_names_empty),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_import_empty_path_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_import_path_empty,
    at: port_locus(port: ^target_import_path_empty),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_import_bound_tokens_intersperse(
  bindings: v2.std.collection.List<v2.std.node.Symbol>,
  ident_token: v2.std.node.Symbol,
  separator: v2.std.node.Symbol
) -> v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  fold(
    bindings,
    init: std.algebra.Empty,
    f: fn(acc, binding) {
      if v2.std.algebra.is_empty(xs: acc) {
        std.algebra.Cons { head: BoundToken { token_class: ident_token, binding: binding }, tail: std.algebra.Empty }
      } else {
        list_append(
          left: acc,
          right: std.algebra.Cons {
            head: FixedToken { token_class: separator },
            tail: std.algebra.Cons {
              head: BoundToken { token_class: ident_token, binding: binding },
              tail: std.algebra.Empty
            }
          }
        )
      }
    }
  )
}

fn target_import_to_concrete_tokens(
  import_value: v2.std.compilers.target_model.TargetImport,
  projection: v2.std.compilers.target_model.TargetModuleProjection
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  match projection.import_form {
    EsModuleImport {
      import_token: import_token,
      names_open: names_open,
      names_separator: names_separator,
      names_close: names_close,
      from_token: from_token,
      path_open: path_open,
      path_segment_separator: path_segment_separator,
      path_close: path_close,
      terminator: terminator,
      name_ident_token: name_ident_token,
      path_segment_token: path_segment_token
    } =>
      if is_empty(xs: import_value.names) {
        outcome_rejected(target_import_empty_names_diagnostic())
      } else if is_empty(xs: import_value.path_segments) {
        outcome_rejected(target_import_empty_path_diagnostic())
      } else {
        outcome_accepted(
          list_append(
            left: std.algebra.Cons {
              head: FixedToken { token_class: import_token },
              tail: std.algebra.Cons { head: FixedToken { token_class: names_open }, tail: std.algebra.Empty }
            },
            right: list_append(
              left: target_import_bound_tokens_intersperse(
                bindings: import_value.names,
                ident_token: name_ident_token,
                separator: names_separator
              ),
              right: list_append(
                left: std.algebra.Cons {
                  head: FixedToken { token_class: names_close },
                  tail: std.algebra.Cons {
                    head: FixedToken { token_class: from_token },
                    tail: std.algebra.Cons { head: FixedToken { token_class: path_open }, tail: std.algebra.Empty }
                  }
                },
                right: list_append(
                  left: target_import_bound_tokens_intersperse(
                    bindings: import_value.path_segments,
                    ident_token: path_segment_token,
                    separator: path_segment_separator
                  ),
                  right: std.algebra.Cons {
                    head: FixedToken { token_class: path_close },
                    tail: std.algebra.Cons { head: FixedToken { token_class: terminator }, tail: std.algebra.Empty }
                  }
                )
              )
            )
          )
        )
      }
  }
}

fn import_qualified_name_symbols(qn: v2.std.qualified_name.QualifiedName) -> v2.std.collection.List<v2.std.node.Symbol> {
  match qn {
    Empty => std.algebra.Empty
    Cons { head: h, tail: t } =>
      std.algebra.Cons { head: h, tail: import_qualified_name_symbols(qn: t) }
  }
}

fn import_name_symbols_from_block(block: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.node.Symbol>> {
  fold(
    node_positional_child_targets(node: block),
    init: outcome_accepted(value: std.algebra.Empty),
    f: fn(acc, nd) {
      bind_outcome(
        o: acc,
        f: fn(syms) {
          bind_outcome(
            o: target_node_atom_identity(node: nd),
            f: fn(sym) {
              outcome_accepted(
                value: list_append(left: syms, right: std.algebra.Cons { head: sym, tail: std.algebra.Empty })
              )
            }
          )
        }
      )
    }
  )
}

fn import_value_from_carrier(carrier: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetImport> {
  bind_outcome(
    o: find_named_child(root: carrier, name: ^dag_surface_import_decl_qualified_name),
    f: fn(qn_node) {
      bind_outcome(
        o: qualified_name_from_node(root: qn_node),
        f: fn(qn) {
          bind_outcome(
            o: find_named_child(root: carrier, name: ^dag_surface_import_decl_block),
            f: fn(block) {
              bind_outcome(
                o: import_name_symbols_from_block(block: block),
                f: fn(names) {
                  outcome_accepted(
                    value: v2.std.compilers.target_model.TargetImport {
                      path_segments: import_qualified_name_symbols(qn: qn),
                      names: names
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn module_import_projection_bundle_node(projection: v2.std.compilers.target_model.TargetModuleProjection) -> v2.std.node.Node {
  match projection.import_form {
    EsModuleImport {
      import_token: import_token,
      names_open: names_open,
      names_separator: names_separator,
      names_close: names_close,
      from_token: from_token,
      path_open: path_open,
      path_segment_separator: path_segment_separator,
      path_close: path_close,
      terminator: terminator,
      name_ident_token: name_ident_token,
      path_segment_token: path_segment_token
    } =>
      target_model_type_conj_node(
        children: [
          target_model_named_edge(
            name: ^target_module_import_field_import_token,
            target: target_model_type_atom_node(identity: import_token)
          ),
          target_model_named_edge(
            name: ^target_module_import_field_names_open,
            target: target_model_type_atom_node(identity: names_open)
          ),
          target_model_named_edge(
            name: ^target_module_import_field_names_separator,
            target: target_model_type_atom_node(identity: names_separator)
          ),
          target_model_named_edge(
            name: ^target_module_import_field_names_close,
            target: target_model_type_atom_node(identity: names_close)
          ),
          target_model_named_edge(
            name: ^target_module_import_field_from_token,
            target: target_model_type_atom_node(identity: from_token)
          ),
          target_model_named_edge(
            name: ^target_module_import_field_path_open,
            target: target_model_type_atom_node(identity: path_open)
          ),
          target_model_named_edge(
            name: ^target_module_import_field_path_segment_separator,
            target: target_model_type_atom_node(identity: path_segment_separator)
          ),
          target_model_named_edge(
            name: ^target_module_import_field_path_close,
            target: target_model_type_atom_node(identity: path_close)
          ),
          target_model_named_edge(
            name: ^target_module_import_field_terminator,
            target: target_model_type_atom_node(identity: terminator)
          ),
          target_model_named_edge(
            name: ^target_module_import_field_name_ident_token,
            target: target_model_type_atom_node(identity: name_ident_token)
          ),
          target_model_named_edge(
            name: ^target_module_import_field_path_segment_token,
            target: target_model_type_atom_node(identity: path_segment_token)
          )
        ]
      )
  }
}

fn decode_module_import_projection_bundle(
  bundle: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetModuleProjection> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: bundle, field: ^target_module_import_field_import_token),
    f: fn(import_token) {
      bind_outcome(
        o: projection_bundle_symbol_field(bundle: bundle, field: ^target_module_import_field_names_open),
        f: fn(names_open) {
          bind_outcome(
            o: projection_bundle_symbol_field(bundle: bundle, field: ^target_module_import_field_names_separator),
            f: fn(names_separator) {
              bind_outcome(
                o: projection_bundle_symbol_field(bundle: bundle, field: ^target_module_import_field_names_close),
                f: fn(names_close) {
                  bind_outcome(
                    o: projection_bundle_symbol_field(bundle: bundle, field: ^target_module_import_field_from_token),
                    f: fn(from_token) {
                      bind_outcome(
                        o: projection_bundle_symbol_field(bundle: bundle, field: ^target_module_import_field_path_open),
                        f: fn(path_open) {
                          bind_outcome(
                            o: projection_bundle_symbol_field(bundle: bundle, field: ^target_module_import_field_path_segment_separator),
                            f: fn(path_segment_separator) {
                              bind_outcome(
                                o: projection_bundle_symbol_field(bundle: bundle, field: ^target_module_import_field_path_close),
                                f: fn(path_close) {
                                  bind_outcome(
                                    o: projection_bundle_symbol_field(bundle: bundle, field: ^target_module_import_field_terminator),
                                    f: fn(terminator) {
                                      bind_outcome(
                                        o: projection_bundle_symbol_field(bundle: bundle, field: ^target_module_import_field_name_ident_token),
                                        f: fn(name_ident_token) {
                                          bind_outcome(
                                            o: projection_bundle_symbol_field(bundle: bundle, field: ^target_module_import_field_path_segment_token),
                                            f: fn(path_segment_token) {
                                              outcome_accepted(
                                                value: v2.std.compilers.target_model.TargetModuleProjection {
                                                  import_form: EsModuleImport {
                                                    import_token: import_token,
                                                    names_open: names_open,
                                                    names_separator: names_separator,
                                                    names_close: names_close,
                                                    from_token: from_token,
                                                    path_open: path_open,
                                                    path_segment_separator: path_segment_separator,
                                                    path_close: path_close,
                                                    terminator: terminator,
                                                    name_ident_token: name_ident_token,
                                                    path_segment_token: path_segment_token
                                                  }
                                                }
                                              )
                                            }
                                          )
                                        }
                                      )
                                    }
                                  )
                                }
                              )
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn module_import_projection_from_target(
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetModuleProjection> {
  bind_outcome(
    o: projection_bundle_child(
      bundle: target.bundle,
      name: ^target_model_edge_module_import_projection
    ),
    f: fn(bundle) {
      decode_module_import_projection_bundle(bundle: bundle)
    }
  )
}

fn target_value_expr_field_access_wire_schema_valid(wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<Bool> {
  match wire.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id != ^target_value_expression_field_access_atom {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else if name_occurrences(
        name: ^target_value_expr_field_field_access_base,
        children: wire.children
      ) != 1 {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else if name_occurrences(
        name: ^target_value_expr_field_field_access_field,
        children: wire.children
      ) != 1 {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else {
        match fold(
          wire.children,
          init: true,
          f: fn(acc, edge) {
            if acc {
              match edge.label {
                Named { name: n } =>
                  n == ^target_value_expr_field_field_access_base
                  || n == ^target_value_expr_field_field_access_field
                Positional => false
              }
            } else {
              false
            }
          }
        ) {
          true => outcome_accepted(true)
          false =>
            outcome_rejected(
              target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
            )
        }
      }
    _ =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

fn target_value_expr_field_access_base_from_wire(
  wire: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression> {
  target_value_expr_conditional_child_from_wire(
    wire: wire,
    field: ^target_value_expr_field_field_access_base
  )
}

fn target_value_expr_field_access_field_from_wire(wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Symbol> {
  match fold(
    wire.children,
    init: optional_absent(),
    f: fn(acc, edge) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match edge.label {
            Named { name: n } =>
              if n == ^target_value_expr_field_field_access_field {
                match edge.target.kind {
                  TypeNode { connective: Atom { identity: id } } =>
                    optional_present(value: id)
                  _ => acc
                }
              } else {
                acc
              }
            Positional => acc
          }
      }
    }
  ) {
    Present { value: field_name } => outcome_accepted(field_name)
    Absent =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

fn target_value_expression_field_access_to_concrete_tokens(
  expr: v2.std.compilers.target_model.TargetValueExpression,
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection,
  catalog: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  bind_outcome(
    o: target_value_expr_field_access_wire_schema_valid(wire: expr.node),
    f: fn(_) {
      bind_outcome(
        o: target_value_expr_field_access_base_from_wire(wire: expr.node),
        f: fn(base) {
          bind_outcome(
            o: target_value_expr_field_access_field_from_wire(wire: expr.node),
            f: fn(field_name) {
              bind_outcome(
                o: target_value_expression_to_concrete_tokens(
                  expr: base,
                  projection: projection,
                  catalog: catalog
                ),
                f: fn(base_tokens) {
                  outcome_accepted(
                    list_append(
                      left: list_append(
                        left: base_tokens,
                        right: std.algebra.Cons {
                          head: FixedToken {
                            token_class: projection.field_access_form.dot
                          },
                          tail: std.algebra.Empty
                        }
                      ),
                      right: std.algebra.Cons {
                        head: target_value_expression_binding_ref_token(
                          binding: field_name,
                          projection: projection
                        ),
                        tail: std.algebra.Empty
                      }
                    )
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn target_value_expr_match_arm_wire_schema_valid(arm_wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<Bool> {
  match arm_wire.kind {
    TypeNode { connective: Conj } =>
      if name_occurrences(name: match_arm_pattern, children: arm_wire.children) != 1 {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: arm_wire)
        )
      } else if name_occurrences(name: match_arm_body, children: arm_wire.children) != 1 {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: arm_wire)
        )
      } else {
        match fold(
          arm_wire.children,
          init: true,
          f: fn(acc, edge) {
            if acc {
              match edge.label {
                Named { name: n } =>
                  n == match_arm_pattern || n == match_arm_body
                Positional => false
              }
            } else {
              false
            }
          }
        ) {
          true => outcome_accepted(true)
          false =>
            outcome_rejected(
              target_value_expr_operand_wire_malformed_diagnostic(wire: arm_wire)
            )
        }
      }
    _ =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: arm_wire)
      )
  }
}

fn target_value_expr_match_wire_schema_valid(wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<Bool> {
  match wire.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id != ^target_value_expression_match_atom {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else if name_occurrences(
        name: ^target_value_expr_field_match_scrutinee,
        children: wire.children
      ) != 1 {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else {
        match fold(
          wire.children,
          init: v2.std.diagnostic.Accepted { value: true, diagnostics: v2.std.diagnostic.None },
          f: fn(acc, edge) {
            match acc {
              Rejected { diagnostics: r } => acc
              Accepted { value: ok, diagnostics: d } =>
                if !ok {
                  acc
                } else {
                  match edge.label {
                    Named { name: n } =>
                      if n == ^target_value_expr_field_match_scrutinee {
                        acc
                      } else {
                        outcome_rejected(
                          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
                        )
                      }
                    Positional =>
                      bind_outcome(
                        o: target_value_expr_match_arm_wire_schema_valid(arm_wire: edge.target),
                        f: fn(_) {
                          outcome_accepted(true)
                        }
                      )
                  }
                }
            }
          }
        ) {
          Accepted { value: true, diagnostics: d } => v2.std.diagnostic.Accepted { value: true, diagnostics: d }
          Accepted { value: false, diagnostics: d } =>
            outcome_rejected(
              target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
            )
          Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
        }
      }
    _ =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

fn target_value_expr_match_scrutinee_from_wire(wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression> {
  target_value_expr_conditional_child_from_wire(
    wire: wire,
    field: ^target_value_expr_field_match_scrutinee
  )
}

fn target_value_expr_match_arm_slot_from_wire(arm_wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExprMatchArmSlot> {
  bind_outcome(
    o: target_value_expr_match_arm_wire_schema_valid(arm_wire: arm_wire),
    f: fn(_) {
      bind_outcome(
        o: find_named_child(root: arm_wire, name: match_arm_pattern),
        f: fn(pattern_wire) {
          bind_outcome(
            o: find_named_child(root: arm_wire, name: match_arm_body),
            f: fn(body_wire) {
              bind_outcome(
                o: target_value_expression_reify_from_wire(wire: pattern_wire),
                f: fn(pat_expr) {
                  bind_outcome(
                    o: target_value_expression_reify_from_wire(wire: body_wire),
                    f: fn(body_expr) {
                      outcome_accepted(
                        TargetValueExprMatchArmSlot {
                          pattern: pat_expr,
                          body: body_expr
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn target_value_expr_match_arms_from_wire(
  wire: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.TargetValueExprMatchArmSlot>> {
  match fold(
    wire.children,
    init: v2.std.diagnostic.Accepted { value: std.algebra.Empty, diagnostics: v2.std.diagnostic.None },
    f: fn(acc, edge) {
      match acc {
        Rejected { diagnostics: r } => acc
        Accepted { value: arms, diagnostics: d } =>
          match edge.label {
            Named { name: _ } => acc
            Positional =>
              bind_outcome(
                o: target_value_expr_match_arm_slot_from_wire(arm_wire: edge.target),
                f: fn(arm) {
                  outcome_accepted(list_snoc_item(xs: arms, item: arm))
                }
              )
          }
      }
    }
  ) {
    Accepted { value: arms, diagnostics: d } => v2.std.diagnostic.Accepted { value: arms, diagnostics: d }
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn concrete_syntax_tokens_extend(
  acc: v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>,
  more: v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>
) -> v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  list_append(left: acc, right: more)
}

fn concrete_syntax_tokens_snoc_fixed(
  acc: v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>,
  token_class: v2.std.node.Symbol
) -> v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  list_snoc_item(
    xs: acc,
    item: FixedToken { token_class: token_class }
  )
}

fn target_value_expr_match_arm_tokens(
  arms: v2.std.collection.List<v2.std.compilers.target_model.TargetValueExprMatchArmSlot>,
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection,
  catalog: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  match fold(
    arms,
    init: v2.std.diagnostic.Accepted { value: std.algebra.Empty, diagnostics: v2.std.diagnostic.None },
    f: fn(acc, arm) {
      match acc {
        Rejected { diagnostics: r } => acc
        Accepted { value: prior_tokens, diagnostics: d } =>
          bind_outcome(
            o: target_value_expression_to_concrete_tokens(
              expr: arm.pattern,
              projection: projection,
              catalog: catalog
            ),
            f: fn(pattern_tokens) {
              bind_outcome(
                o: target_value_expression_to_concrete_tokens(
                  expr: arm.body,
                  projection: projection,
                  catalog: catalog
                ),
                f: fn(body_tokens) {
                  let arm_chunk = concrete_syntax_tokens_extend(
                    acc: concrete_syntax_tokens_snoc_fixed(
                      acc: pattern_tokens,
                      token_class: projection.match_form.fat_arrow
                    ),
                    more: body_tokens
                  )
                  if v2.std.algebra.is_empty(xs: prior_tokens) {
                    outcome_accepted(arm_chunk)
                  } else {
                    outcome_accepted(
                      concrete_syntax_tokens_extend(
                        acc: concrete_syntax_tokens_snoc_fixed(
                          acc: prior_tokens,
                          token_class: projection.match_form.arm_separator
                        ),
                        more: arm_chunk
                      )
                    )
                  }
                }
              )
            }
          )
      }
    }
  ) {
    Accepted { value: tokens, diagnostics: d } => v2.std.diagnostic.Accepted { value: tokens, diagnostics: d }
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

data target_value_expr_int_bool_octet_channel_dissolution_note: String = "Staging bridge only: inline scrutinee `x != 0` decodes Int wire to bool at the match seam. Ground on the modeled octet↔bool codec authority once inhabited ({0,1} domain, not general nonzero) — do not let this bridge harden into a second decode nickname. interim bindings: ^dag_binding_octet_zero/^dag_binding_octet_one spell 0/1 until codec rows land. scaffold-widen: infer half emits infer_match_int_scrutinee_bool_literal_scaffold diagnostic on Int-scrutinee bool-literal match (countable). paired-scaffold: infer half = infer_match_int_scrutinee_bool_literal_body_note (04_infer.dag) — dissolve both halves together on octet↔bool codec inhabitation."

fn target_value_expr_bool_literal_value_from_atom(node: v2.std.node.Node) -> v2.std.optional.Optional<Bool> {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id == ^target_value_expression_bool_true {
        optional_present(true)
      } else if id == ^target_value_expression_bool_false {
        optional_present(false)
      } else {
        optional_absent()
      }
    _ => optional_absent()
  }
}

fn target_value_expr_bool_literal_value_from_source_symbol(
  id: v2.std.node.Symbol,
  source_bool_form: v2.std.compilers.target_model.TargetBoolLiteralShape
) -> v2.std.optional.Optional<Bool> {
  if id == ^target_value_expression_bool_true || id == source_bool_form.true_token {
    optional_present(true)
  } else if id == ^target_value_expression_bool_false || id == source_bool_form.false_token {
    optional_present(false)
  } else {
    optional_absent()
  }
}

fn target_value_expression_bool_literal_value_from_wire(wire: v2.std.node.Node) -> v2.std.optional.Optional<Bool> {
  match fold(
    wire.children,
    init: optional_absent(),
    f: fn(acc, edge) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match edge.label {
            Named { name: n } =>
              if n == ^target_value_expression_field_value {
                target_value_expr_bool_literal_value_from_atom(node: edge.target)
              } else {
                acc
              }
            Positional => acc
          }
      }
    }
  ) {
    Present { value: b } => optional_present(value: b)
    Absent => optional_absent()
  }
}

fn target_value_expr_bool_literal_value_from_expression(
  expr: v2.std.compilers.target_model.TargetValueExpression,
  source_bool_form: v2.std.compilers.target_model.TargetBoolLiteralShape
) -> v2.std.optional.Optional<Bool> {
  match expr.kind {
    TargetValueExprBoolLiteral =>
      target_value_expression_bool_literal_value_from_wire(wire: expr.node)
    TargetValueExprSymbolIdentity =>
      match target_value_expression_symbol_identity_from_wire(wire: expr.node) {
        Accepted { value: id, diagnostics: _ } =>
          target_value_expr_bool_literal_value_from_source_symbol(
            id: id,
            source_bool_form: source_bool_form
          )
        Rejected { diagnostics: _ } => optional_absent()
      }
    _ => optional_absent()
  }
}

fn target_value_expr_is_bool_literal_expression(
  expr: v2.std.compilers.target_model.TargetValueExpression,
  source_bool_form: v2.std.compilers.target_model.TargetBoolLiteralShape
) -> Bool {
  match target_value_expr_bool_literal_value_from_expression(
    expr: expr,
    source_bool_form: source_bool_form
  ) {
    Present { value: _ } => true
    Absent => false
  }
}

fn target_value_expr_is_source_bool_literal_atom(
  node: v2.std.node.Node,
  source_bool_form: v2.std.compilers.target_model.TargetBoolLiteralShape
) -> Bool {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } =>
      match target_value_expr_bool_literal_value_from_source_symbol(
        id: id,
        source_bool_form: source_bool_form
      ) {
        Present { value: _ } => true
        Absent => false
      }
    _ => false
  }
}

fn target_value_expr_match_arms_are_int_bool_octet_channel(
  arms: v2.std.collection.List<v2.std.compilers.target_model.TargetValueExprMatchArmSlot>
) -> Bool {
  if is_empty(xs: arms) {
    false
  } else {
    !any(
      xs: arms,
      predicate: fn(arm) {
        arm.pattern.kind != TargetValueExprBoolLiteral
          || arm.body.kind != TargetValueExprBoolLiteral
      }
    )
  }
}

fn target_value_expr_match_is_int_bool_octet_channel(
  scrutinee: v2.std.compilers.target_model.TargetValueExpression,
  arms: v2.std.collection.List<v2.std.compilers.target_model.TargetValueExprMatchArmSlot>
) -> Bool {
  match scrutinee.kind {
    TargetValueExprBindingRef =>
      target_value_expr_match_arms_are_int_bool_octet_channel(arms: arms)
    _ => false
  }
}

fn target_value_expr_bool_literal_octet_body_tokens(
  expr: v2.std.compilers.target_model.TargetValueExpression,
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  match expr.kind {
    TargetValueExprBoolLiteral =>
      match target_value_expression_bool_literal_value_from_wire(wire: expr.node) {
        Present { value: false } =>
          outcome_accepted(
            std.algebra.Cons {
              head: target_value_expression_binding_ref_token(
                binding: ^dag_binding_octet_zero,
                projection: projection
              ),
              tail: std.algebra.Empty
            }
          )
        Present { value: true } =>
          outcome_accepted(
            std.algebra.Cons {
              head: target_value_expression_binding_ref_token(
                binding: ^dag_binding_octet_one,
                projection: projection
              ),
              tail: std.algebra.Empty
            }
          )
        Absent =>
          outcome_rejected(
            target_value_expr_diagnostic(
              reason: ^target_value_expr_reason_transform_shape_invalid,
              node: expr.node
            )
          )
      }
    _ =>
      outcome_rejected(
        target_value_expr_diagnostic(
          reason: ^target_value_expr_reason_transform_shape_invalid,
          node: expr.node
        )
      )
  }
}

fn target_value_expr_int_bool_octet_scrutinee_carrier_tokens(
  scrutinee_tokens: v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>,
  catalog: v2.std.node.Node,
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  bind_outcome(
    o: target_operator_realization_catalog_lookup(
      catalog: catalog,
      canonical_op: canonical_operation_op_ne()
    ),
    f: fn(ne_realization) {
      match ne_realization.shape {
        InfixToken { token: ne_token } =>
          outcome_accepted(
            concrete_syntax_tokens_extend(
              acc: concrete_syntax_tokens_extend(
                acc: scrutinee_tokens,
                more: std.algebra.Cons {
                  head: FixedToken { token_class: ne_token },
                  tail: std.algebra.Empty
                }
              ),
              more: std.algebra.Cons {
                head: target_value_expression_binding_ref_token(
                  binding: ^dag_binding_octet_zero,
                  projection: projection
                ),
                tail: std.algebra.Empty
              }
            )
          )
        _ =>
          outcome_rejected(
            target_operator_realization_catalog_miss_diagnostic(catalog: catalog)
          )
      }
    }
  )
}

fn target_value_expr_match_arm_tokens_int_bool_octet_channel(
  arms: v2.std.collection.List<v2.std.compilers.target_model.TargetValueExprMatchArmSlot>,
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection,
  catalog: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  match fold(
    arms,
    init: v2.std.diagnostic.Accepted { value: std.algebra.Empty, diagnostics: v2.std.diagnostic.None },
    f: fn(acc, arm) {
      match acc {
        Rejected { diagnostics: r } => acc
        Accepted { value: prior_tokens, diagnostics: d } =>
          bind_outcome(
            o: target_value_expression_to_concrete_tokens(
              expr: arm.pattern,
              projection: projection,
              catalog: catalog
            ),
            f: fn(pattern_tokens) {
              bind_outcome(
                o: target_value_expr_bool_literal_octet_body_tokens(
                  expr: arm.body,
                  projection: projection
                ),
                f: fn(body_tokens) {
                  let arm_chunk = concrete_syntax_tokens_extend(
                    acc: concrete_syntax_tokens_snoc_fixed(
                      acc: pattern_tokens,
                      token_class: projection.match_form.fat_arrow
                    ),
                    more: body_tokens
                  )
                  if v2.std.algebra.is_empty(xs: prior_tokens) {
                    outcome_accepted(arm_chunk)
                  } else {
                    outcome_accepted(
                      concrete_syntax_tokens_extend(
                        acc: concrete_syntax_tokens_snoc_fixed(
                          acc: prior_tokens,
                          token_class: projection.match_form.arm_separator
                        ),
                        more: arm_chunk
                      )
                    )
                  }
                }
              )
            }
          )
      }
    }
  ) {
    Accepted { value: tokens, diagnostics: d } => v2.std.diagnostic.Accepted { value: tokens, diagnostics: d }
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn target_value_expression_match_to_concrete_tokens(
  expr: v2.std.compilers.target_model.TargetValueExpression,
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection,
  catalog: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  bind_outcome(
    o: statement_sequenced_block_construct_guard(
      block_evaluation_mode: projection.block_evaluation_mode,
      wire: expr.node
    ),
    f: fn(_) {
      target_value_expression_match_to_concrete_tokens_inner(
        expr: expr,
        projection: projection,
        catalog: catalog
      )
    }
  )
}

fn target_value_expression_match_to_concrete_tokens_inner(
  expr: v2.std.compilers.target_model.TargetValueExpression,
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection,
  catalog: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  bind_outcome(
    o: target_value_expr_match_wire_schema_valid(wire: expr.node),
    f: fn(_) {
      bind_outcome(
        o: target_value_expr_match_scrutinee_from_wire(wire: expr.node),
        f: fn(scrutinee) {
          bind_outcome(
            o: target_value_expr_match_arms_from_wire(wire: expr.node),
            f: fn(arms) {
              bind_outcome(
                o: target_value_expression_to_concrete_tokens(
                  expr: scrutinee,
                  projection: projection,
                  catalog: catalog
                ),
                f: fn(scrutinee_tokens) {
                  if target_value_expr_match_is_int_bool_octet_channel(
                    scrutinee: scrutinee,
                    arms: arms
                  ) {
                    bind_outcome(
                      o: target_value_expr_int_bool_octet_scrutinee_carrier_tokens(
                        scrutinee_tokens: scrutinee_tokens,
                        catalog: catalog,
                        projection: projection
                      ),
                      f: fn(carrier_scrutinee_tokens) {
                        bind_outcome(
                          o: target_value_expr_match_arm_tokens_int_bool_octet_channel(
                            arms: arms,
                            projection: projection,
                            catalog: catalog
                          ),
                          f: fn(arm_tokens) {
                            outcome_accepted(
                              target_value_expression_match_concrete_token_shell(
                                scrutinee_tokens: carrier_scrutinee_tokens,
                                arm_tokens: arm_tokens,
                                projection: projection
                              )
                            )
                          }
                        )
                      }
                    )
                  } else {
                    bind_outcome(
                      o: target_value_expr_match_arm_tokens(
                        arms: arms,
                        projection: projection,
                        catalog: catalog
                      ),
                      f: fn(arm_tokens) {
                        outcome_accepted(
                          target_value_expression_match_concrete_token_shell(
                            scrutinee_tokens: scrutinee_tokens,
                            arm_tokens: arm_tokens,
                            projection: projection
                          )
                        )
                      }
                    )
                  }
                }
              )
            }
          )
        }
      )
    }
  )
}

fn target_value_expression_match_concrete_token_shell(
  scrutinee_tokens: v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>,
  arm_tokens: v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>,
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection
) -> v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  let prefix = concrete_syntax_tokens_snoc_fixed(
    acc: concrete_syntax_tokens_snoc_fixed(
      acc: std.algebra.Empty,
      token_class: projection.match_form.match_token
    ),
    token_class: projection.match_form.scrutinee_open
  )
  let with_scrutinee = concrete_syntax_tokens_extend(
    acc: prefix,
    more: scrutinee_tokens
  )
  let with_scrutinee_close = concrete_syntax_tokens_snoc_fixed(
    acc: with_scrutinee,
    token_class: projection.match_form.scrutinee_close
  )
  let with_open = concrete_syntax_tokens_snoc_fixed(
    acc: with_scrutinee_close,
    token_class: projection.match_form.open
  )
  let with_arms = concrete_syntax_tokens_extend(
    acc: with_open,
    more: arm_tokens
  )
  concrete_syntax_tokens_snoc_fixed(
    acc: with_arms,
    token_class: projection.match_form.close
  )
}

fn target_value_expression_bool_literal_to_concrete_tokens(
  expr: v2.std.compilers.target_model.TargetValueExpression,
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  match expr.kind {
    TargetValueExprBoolLiteral =>
      match target_value_expression_bool_literal_value_from_wire(wire: expr.node) {
        Present { value: true } =>
          outcome_accepted(
            std.algebra.Cons {
              head: FixedToken {
                token_class: projection.bool_literal_form.true_token
              },
              tail: std.algebra.Empty
            }
          )
        Present { value: false } =>
          outcome_accepted(
            std.algebra.Cons {
              head: FixedToken {
                token_class: projection.bool_literal_form.false_token
              },
              tail: std.algebra.Empty
            }
          )
        Absent =>
          outcome_rejected(
            target_value_expression_emit_unsupported_kind_diagnostic(expr: expr)
          )
      }
    _ =>
      outcome_rejected(
        target_value_expression_emit_unsupported_kind_diagnostic(expr: expr)
      )
  }
}

fn target_value_expression_symbol_identity_to_concrete_tokens(
  expr: v2.std.compilers.target_model.TargetValueExpression,
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  bind_outcome(
    o: target_value_expression_symbol_identity_from_wire(wire: expr.node),
    f: fn(token_class) {
      match target_value_expr_binding_ref_for_literal_atom(id: token_class) {
        Present { value: binding } =>
          outcome_accepted(
            std.algebra.Cons {
              head: target_value_expression_binding_ref_token(
                binding: binding,
                projection: projection
              ),
              tail: std.algebra.Empty
            }
          )
        Absent =>
          outcome_accepted(
            std.algebra.Cons {
              head: FixedToken { token_class: token_class },
              tail: std.algebra.Empty
            }
          )
      }
    }
  )
}

// if_token cond then_token then else_token else, and then a close only if the
// target declares one. Previously this fold ended at the else arm for every
// target, so a brace-closing language had no way to emit its own close.
fn conditional_delimited_tokens(
  conditional_form: v2.std.compilers.target_model.TargetConditionalShape,
  cond_tokens: v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>,
  then_tokens: v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>,
  else_tokens: v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>
) -> v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  let opened = list_append(
    left: list_append(
      left: list_append(
        left: list_append(
          left: list_append(
            left: [FixedToken { token_class: conditional_form.if_token }],
            right: cond_tokens
          ),
          right: [FixedToken { token_class: conditional_form.then_token }]
        ),
        right: then_tokens
      ),
      right: [FixedToken { token_class: conditional_form.else_token }]
    ),
    right: else_tokens
  )
  match conditional_form.delimiting {
    ConditionalSelfDelimiting => opened
    ConditionalClosedByToken { close_token: close_token } =>
      list_append(
        left: opened,
        right: [FixedToken { token_class: close_token }]
      )
  }
}

fn target_value_expression_conditional_to_concrete_tokens(
  expr: v2.std.compilers.target_model.TargetValueExpression,
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection,
  catalog: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  bind_outcome(
    o: target_value_expr_conditional_wire_schema_valid(wire: expr.node),
    f: fn(_) {
      bind_outcome(
        o: target_value_expr_conditional_child_from_wire(
          wire: expr.node,
          field: ^target_value_expr_field_branch_condition
        ),
        f: fn(condition) {
          bind_outcome(
            o: target_value_expr_conditional_child_from_wire(
              wire: expr.node,
              field: ^target_value_expr_field_branch_then_arm
            ),
            f: fn(then_arm) {
              bind_outcome(
                o: target_value_expr_conditional_child_from_wire(
                  wire: expr.node,
                  field: ^target_value_expr_field_branch_else_arm
                ),
                f: fn(else_arm) {
                  bind_outcome(
                    o: target_value_expression_to_concrete_tokens(
                      expr: condition,
                      projection: projection,
                      catalog: catalog
                    ),
                    f: fn(cond_tokens) {
                      bind_outcome(
                        o: target_value_expression_to_concrete_tokens(
                          expr: then_arm,
                          projection: projection,
                          catalog: catalog
                        ),
                        f: fn(then_tokens) {
                          bind_outcome(
                            o: target_value_expression_to_concrete_tokens(
                              expr: else_arm,
                              projection: projection,
                              catalog: catalog
                            ),
                            f: fn(else_tokens) {
                              outcome_accepted(
                                conditional_delimited_tokens(
                                  conditional_form: projection.conditional_form,
                                  cond_tokens: cond_tokens,
                                  then_tokens: then_tokens,
                                  else_tokens: else_tokens
                                )
                              )
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn target_value_expr_callable_apply_callee_from_wire(wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Symbol> {
  match fold(
    wire.children,
    init: optional_absent(),
    f: fn(acc, edge) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match edge.label {
            Named { name: n } =>
              if n == ^target_value_expr_field_callee {
                match edge.target.kind {
                  TypeNode { connective: Atom { identity: id } } =>
                    optional_present(value: id)
                  _ => acc
                }
              } else {
                acc
              }
            Positional => acc
          }
      }
    }
  ) {
    Present { value: callee } => outcome_accepted(callee)
    Absent =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

fn target_value_expr_callable_apply_args_from_wire(
  wire: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.TargetValueExpression>> {
  fold(
    wire.children,
    init: v2.std.diagnostic.Accepted { value: std.algebra.Empty, diagnostics: v2.std.diagnostic.None },
    f: fn(acc, edge) {
      match acc {
        Rejected { diagnostics: _ } => acc
        Accepted { value: args, diagnostics: _ } =>
          match edge.label {
            Named { name: n } =>
              if n == ^target_value_expr_field_callable_arg {
                bind_outcome(
                  o: target_value_expression_reify_from_wire(wire: edge.target),
                  f: fn(arg) {
                    outcome_accepted(list_snoc_item(xs: args, item: arg))
                  }
                )
              } else if n == ^target_value_expr_field_callee {
                acc
              } else {
                outcome_rejected(
                  target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
                )
              }
            Positional =>
              outcome_rejected(
                target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
              )
          }
      }
    }
  )
}

fn target_value_expr_tokenize_intersperse(
  exprs: v2.std.collection.List<v2.std.compilers.target_model.TargetValueExpression>,
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection,
  catalog: v2.std.node.Node,
  separator: v2.std.node.Symbol
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  fold(
    exprs,
    init: v2.std.diagnostic.Accepted { value: std.algebra.Empty, diagnostics: v2.std.diagnostic.None },
    f: fn(acc, e) {
      match acc {
        Rejected { diagnostics: _ } => acc
        Accepted { value: toks, diagnostics: _ } =>
          bind_outcome(
            o: target_value_expression_to_concrete_tokens(
              expr: e,
              projection: projection,
              catalog: catalog
            ),
            f: fn(et) {
              match toks {
                Empty => outcome_accepted(et)
                _ =>
                  outcome_accepted(
                    list_append(
                      left: list_append(
                        left: toks,
                        right: std.algebra.Cons {
                          head: FixedToken { token_class: separator },
                          tail: std.algebra.Empty
                        }
                      ),
                      right: et
                    )
                  )
              }
            }
          )
      }
    }
  )
}

fn target_value_expression_callable_apply_to_concrete_tokens(
  expr: v2.std.compilers.target_model.TargetValueExpression,
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection,
  catalog: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  bind_outcome(
    o: target_value_expr_callable_apply_callee_from_wire(wire: expr.node),
    f: fn(callee) {
      bind_outcome(
        o: target_value_expr_callable_apply_args_from_wire(wire: expr.node),
        f: fn(args) {
          bind_outcome(
            o: target_value_expr_tokenize_intersperse(
              exprs: args,
              projection: projection,
              catalog: catalog,
              separator: projection.callable_apply_form.separator
            ),
            f: fn(arg_tokens) {
              outcome_accepted(
                list_append(
                  left: list_append(
                    left: std.algebra.Cons {
                      head: BoundToken {
                        token_class: projection.callable_apply_form.callee_ident_token,
                        binding: callee
                      },
                      tail: std.algebra.Cons {
                        head: FixedToken {
                          token_class: projection.callable_apply_form.open
                        },
                        tail: std.algebra.Empty
                      }
                    },
                    right: arg_tokens
                  ),
                  right: std.algebra.Cons {
                    head: FixedToken {
                      token_class: projection.callable_apply_form.close
                    },
                    tail: std.algebra.Empty
                  }
                )
              )
            }
          )
        }
      )
    }
  )
}

fn target_value_expr_closure_params_from_wire(wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.node.Symbol>> {
  fold(
    wire.children,
    init: v2.std.diagnostic.Accepted { value: std.algebra.Empty, diagnostics: v2.std.diagnostic.None },
    f: fn(acc, edge) {
      match acc {
        Rejected { diagnostics: _ } => acc
        Accepted { value: ps, diagnostics: _ } =>
          match edge.label {
            Named { name: n } =>
              if n == ^target_value_expr_field_closure_param {
                match edge.target.kind {
                  TypeNode { connective: Atom { identity: id } } =>
                    outcome_accepted(list_snoc_item(xs: ps, item: id))
                  _ =>
                    outcome_rejected(
                      target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
                    )
                }
              } else if n == ^target_value_expr_field_closure_body {
                acc
              } else {
                outcome_rejected(
                  target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
                )
              }
            Positional =>
              outcome_rejected(
                target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
              )
          }
      }
    }
  )
}

fn target_value_expr_closure_body_from_wire(wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression> {
  target_value_expr_conditional_child_from_wire(
    wire: wire,
    field: ^target_value_expr_field_closure_body
  )
}

fn target_value_expr_closure_param_tokens(
  params: v2.std.collection.List<v2.std.node.Symbol>,
  ident_token: v2.std.node.Symbol,
  separator: v2.std.node.Symbol
) -> v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  fold_list_right(
    xs: params,
    empty: std.algebra.Empty,
    snoc: fn(acc, p) {
      let token = BoundToken { token_class: ident_token, binding: p }
      match acc {
        Empty => std.algebra.Cons { head: token, tail: std.algebra.Empty }
        _ =>
          std.algebra.Cons {
            head: token,
            tail: std.algebra.Cons {
              head: FixedToken { token_class: separator },
              tail: acc
            }
          }
      }
    }
  )
}

fn target_value_expression_closure_to_concrete_tokens(
  expr: v2.std.compilers.target_model.TargetValueExpression,
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection,
  catalog: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  bind_outcome(
    o: statement_sequenced_block_construct_guard(
      block_evaluation_mode: projection.block_evaluation_mode,
      wire: expr.node
    ),
    f: fn(_) {
      target_value_expression_closure_to_concrete_tokens_inner(
        expr: expr,
        projection: projection,
        catalog: catalog
      )
    }
  )
}

fn target_value_expression_closure_to_concrete_tokens_inner(
  expr: v2.std.compilers.target_model.TargetValueExpression,
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection,
  catalog: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  bind_outcome(
    o: target_value_expr_closure_params_from_wire(wire: expr.node),
    f: fn(params) {
      bind_outcome(
        o: target_value_expr_closure_body_from_wire(wire: expr.node),
        f: fn(body) {
          bind_outcome(
            o: target_value_expression_to_concrete_tokens(
              expr: body,
              projection: projection,
              catalog: catalog
            ),
            f: fn(body_tokens) {
              outcome_accepted(
                list_append(
                  left: list_append(
                    left: list_append(
                      left: std.algebra.Cons {
                        head: FixedToken {
                          token_class: projection.closure_form.fn_token
                        },
                        tail: std.algebra.Cons {
                          head: FixedToken {
                            token_class: projection.closure_form.open
                          },
                          tail: std.algebra.Empty
                        }
                      },
                      right: list_append(
                        left: target_value_expr_closure_param_tokens(
                          params: params,
                          ident_token: projection.closure_form.param_ident_token,
                          separator: projection.closure_form.separator
                        ),
                        right: std.algebra.Cons {
                          head: FixedToken {
                            token_class: projection.closure_form.close
                          },
                          tail: std.algebra.Cons {
                            head: FixedToken {
                              token_class: projection.closure_form.body_open
                            },
                            tail: std.algebra.Empty
                          }
                        }
                      )
                    ),
                    right: body_tokens
                  ),
                  right: std.algebra.Cons {
                    head: FixedToken {
                      token_class: projection.closure_form.body_close
                    },
                    tail: std.algebra.Empty
                  }
                )
              )
            }
          )
        }
      )
    }
  )
}

fn target_value_expression_to_concrete_tokens(
  expr: v2.std.compilers.target_model.TargetValueExpression,
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection,
  catalog: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  match expr.kind {
    TargetValueExprBindingRef =>
      target_value_expression_binding_ref_to_concrete_tokens(
        expr: expr,
        projection: projection
      )
    TargetValueExprPrimitiveApply =>
      target_value_expression_primitive_apply_to_concrete_tokens(
        expr: expr,
        projection: projection,
        catalog: catalog
      )
    TargetValueExprEffectApply =>
      target_value_expression_effect_apply_to_concrete_tokens(
        expr: expr,
        projection: projection
      )
    TargetValueExprCallableApply =>
      target_value_expression_callable_apply_to_concrete_tokens(
        expr: expr,
        projection: projection,
        catalog: catalog
      )
    TargetValueExprClosure =>
      target_value_expression_closure_to_concrete_tokens(
        expr: expr,
        projection: projection,
        catalog: catalog
      )
    TargetValueExprSymbolIdentity =>
      target_value_expression_symbol_identity_to_concrete_tokens(
        expr: expr,
        projection: projection
      )
    TargetValueExprBoolLiteral =>
      target_value_expression_bool_literal_to_concrete_tokens(
        expr: expr,
        projection: projection
      )
    TargetValueExprConditional =>
      target_value_expression_conditional_to_concrete_tokens(
        expr: expr,
        projection: projection,
        catalog: catalog
      )
    TargetValueExprBindLet =>
      target_value_expression_bind_let_to_concrete_tokens(
        expr: expr,
        projection: projection,
        catalog: catalog
      )
    TargetValueExprLoop =>
      target_value_expression_loop_to_concrete_tokens(
        expr: expr,
        projection: projection,
        catalog: catalog
      )
    TargetValueExprRecordConstruct =>
      target_value_expression_record_construct_to_concrete_tokens(
        expr: expr,
        projection: projection,
        catalog: catalog
      )
    TargetValueExprFieldAccess =>
      target_value_expression_field_access_to_concrete_tokens(
        expr: expr,
        projection: projection,
        catalog: catalog
      )
    TargetValueExprMatch =>
      target_value_expression_match_to_concrete_tokens(
        expr: expr,
        projection: projection,
        catalog: catalog
      )
    _ =>
      outcome_rejected(
        target_value_expression_emit_unsupported_kind_diagnostic(expr: expr)
      )
  }
}

fn target_declared_inhabitants_edge_targets(root: v2.std.node.Node) -> v2.std.collection.List<v2.std.node.Node> {
  match root.kind {
    TypeNode { connective: Conj } =>
      fold(root.children, init: std.algebra.Empty, f: fn(acc, edge) {
        list_snoc_item(xs: acc, item: edge.target)
      })
    _ => std.algebra.Empty
  }
}

fn target_inhabitant_wire_primary_atom_identity(wire: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Symbol> {
  match wire.kind {
    TypeNode { connective: Atom { identity: id } } => optional_present(value: id)
    TypeNode { connective: Conj } =>
      match fold(
        wire.children,
        init: optional_absent(),
        f: fn(acc, edge) {
          match acc {
            Present { value: _ } => acc
            Absent =>
              match edge.label {
                Named { name: _ } =>
                  match edge.target.kind {
                    TypeNode { connective: Atom { identity: id } } =>
                      optional_present(value: id)
                    _ => acc
                  }
                Positional => acc
              }
          }
        }
      ) {
        Present { value: id } => optional_present(value: id)
        Absent => optional_absent()
      }
    _ => optional_absent()
  }
}

fn target_catalog_contains_node_shape(
  slot: v2.std.node.Node,
  catalog_targets: v2.std.collection.List<v2.std.node.Node>
) -> Bool {
  fold_list(
    xs: catalog_targets,
    empty: false,
    cons: fn(acc, candidate) {
      if acc {
        true
      } else if content_hash(n: slot) == content_hash(n: candidate) {
        true
      } else {
        false
      }
    }
  )
}

fn target_catalog_atom_identity_matches_inhabitant_wires(
  slot_atom: v2.std.node.Symbol,
  catalog_targets: v2.std.collection.List<v2.std.node.Node>
) -> Bool {
  fold_list(
    xs: catalog_targets,
    empty: false,
    cons: fn(acc, candidate) {
      if acc {
        true
      } else {
        match target_inhabitant_wire_primary_atom_identity(wire: candidate) {
          Present { value: inhabitant_atom } => slot_atom == inhabitant_atom
          Absent => false
        }
      }
    }
  )
}

fn target_signature_slot_matches_declared_inhabitants(
  slot: v2.std.node.Node,
  inhabitants_root: v2.std.node.Node
) -> Bool {
  let catalog_targets = target_declared_inhabitants_edge_targets(root: inhabitants_root)
  if target_catalog_contains_node_shape(slot: slot, catalog_targets: catalog_targets) {
    true
  } else {
    match slot.kind {
      TypeNode { connective: Atom { identity: slot_atom } } =>
        slot_atom == ^dag_binding_type_int
        || target_catalog_atom_identity_matches_inhabitant_wires(
          slot_atom: slot_atom,
          catalog_targets: catalog_targets
        )
      _ =>
        match target_inhabitant_wire_primary_atom_identity(wire: slot) {
          Present { value: slot_atom } =>
            target_catalog_atom_identity_matches_inhabitant_wires(
              slot_atom: slot_atom,
              catalog_targets: catalog_targets
            )
          Absent => false
        }
    }
  }
}

fn target_add_signature_slot_at(
  arrow: v2.std.node.Node,
  index: Int,
  inhabitants_root: v2.std.node.Node
) -> Bool {
  match list_at_optional(xs: node_positional_child_targets(node: arrow), index: index) {
    Present { value: slot } =>
      target_signature_slot_matches_declared_inhabitants(
        slot: slot,
        inhabitants_root: inhabitants_root
      )
    Absent => false
  }
}

fn target_add_signature_matches(
  arrow: v2.std.node.Node,
  inhabitants_root: v2.std.node.Node
) -> Bool {
  match arrow.kind {
    TypeNode { connective: Arrow } =>
      target_add_signature_slot_at(
        arrow: arrow,
        index: 0,
        inhabitants_root: inhabitants_root
      )
      && target_add_signature_slot_at(
        arrow: arrow,
        index: 1,
        inhabitants_root: inhabitants_root
      )
      && target_add_signature_slot_at(
        arrow: arrow,
        index: 2,
        inhabitants_root: inhabitants_root
      )
    _ => false
  }
}

fn value_expr_projection_bundle_node(projection: v2.std.compilers.target_model.TargetValueExpressionProjection) -> v2.std.node.Node {
  target_model_type_conj_node(
    children: [
      target_model_named_edge(
        name: ^target_value_expr_field_binding_ref,
        target: target_model_type_conj_node(
          children: [
            target_model_named_edge(
              name: ^target_value_expr_field_ident_token,
              target: target_model_type_atom_node(
                identity: projection.binding_ref_form.ident_token
              )
            )
          ]
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_primitive_apply,
        target: target_model_type_conj_node(
          children: [
            target_model_named_edge(
              name: ^target_value_expr_field_open,
              target: target_model_type_atom_node(
                identity: projection.primitive_apply_form.open
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_close,
              target: target_model_type_atom_node(
                identity: projection.primitive_apply_form.close
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_separator,
              target: target_model_type_atom_node(
                identity: projection.primitive_apply_form.separator
              )
            )
          ]
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_callable_apply,
        target: target_model_type_conj_node(
          children: [
            target_model_named_edge(
              name: ^target_value_expr_field_ident_token,
              target: target_model_type_atom_node(
                identity: projection.callable_apply_form.callee_ident_token
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_open,
              target: target_model_type_atom_node(
                identity: projection.callable_apply_form.open
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_close,
              target: target_model_type_atom_node(
                identity: projection.callable_apply_form.close
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_separator,
              target: target_model_type_atom_node(
                identity: projection.callable_apply_form.separator
              )
            )
          ]
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_closure,
        target: target_model_type_conj_node(
          children: [
            target_model_named_edge(
              name: ^target_value_expr_field_fn_token,
              target: target_model_type_atom_node(
                identity: projection.closure_form.fn_token
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_open,
              target: target_model_type_atom_node(
                identity: projection.closure_form.open
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_separator,
              target: target_model_type_atom_node(
                identity: projection.closure_form.separator
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_close,
              target: target_model_type_atom_node(
                identity: projection.closure_form.close
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_body_open,
              target: target_model_type_atom_node(
                identity: projection.closure_form.body_open
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_body_close,
              target: target_model_type_atom_node(
                identity: projection.closure_form.body_close
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_ident_token,
              target: target_model_type_atom_node(
                identity: projection.closure_form.param_ident_token
              )
            )
          ]
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_effect_apply,
        target: target_model_type_conj_node(

          children: list_append(
            left: fold_list(
              xs: projection.effect_apply_form.callees,
              empty: std.algebra.Empty,
              cons: fn(acc, row) {
                std.algebra.Cons {
                  head: target_model_named_edge(
                    name: ^target_value_expr_effect_callee_row_edge,
                    target: target_value_expr_effect_callee_row_node(row: row)
                  ),
                  tail: acc
                }
              }
            ),
            right: [
              target_model_named_edge(
                name: ^target_value_expr_field_open,
                target: target_model_type_atom_node(
                  identity: projection.effect_apply_form.open
                )
              ),
              target_model_named_edge(
                name: ^target_value_expr_field_close,
                target: target_model_type_atom_node(
                  identity: projection.effect_apply_form.close
                )
              ),
              target_model_named_edge(
                name: ^target_value_expr_field_separator,
                target: target_model_type_atom_node(
                  identity: projection.effect_apply_form.separator
                )
              )
            ]
          )
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_conditional,
        target: target_model_type_conj_node(
          children: list_append(
            left: [
              target_model_named_edge(
                name: ^target_value_expr_field_if_token,
                target: target_model_type_atom_node(
                  identity: projection.conditional_form.if_token
                )
              ),
              target_model_named_edge(
                name: ^target_value_expr_field_then_token,
                target: target_model_type_atom_node(
                  identity: projection.conditional_form.then_token
                )
              ),
              target_model_named_edge(
                name: ^target_value_expr_field_else_token,
                target: target_model_type_atom_node(
                  identity: projection.conditional_form.else_token
                )
              )
            ],
            right: conditional_delimiting_edges(
              delimiting: projection.conditional_form.delimiting
            )
          )
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_bind_let,
        target: target_model_type_conj_node(
          children: [
            target_model_named_edge(
              name: ^target_value_expr_field_let_token,
              target: target_model_type_atom_node(
                identity: projection.let_form.let_token
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_assign_token,
              target: target_model_type_atom_node(
                identity: projection.let_form.assign_token
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_in_token,
              target: target_model_type_atom_node(
                identity: projection.let_form.in_token
              )
            )
          ]
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_loop,
        target: target_model_type_conj_node(
          children: [
            target_model_named_edge(
              name: ^target_value_expr_field_loop_token,
              target: target_model_type_atom_node(
                identity: projection.loop_form.loop_token
              )
            )
          ]
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_record_construct,
        target: target_model_type_conj_node(
          children: [
            target_model_named_edge(
              name: ^target_value_expr_field_record_open,
              target: target_model_type_atom_node(
                identity: projection.record_construct_form.open
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_record_close,
              target: target_model_type_atom_node(
                identity: projection.record_construct_form.close
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_record_separator,
              target: target_model_type_atom_node(
                identity: projection.record_construct_form.separator
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_record_assign,
              target: target_model_type_atom_node(
                identity: projection.record_construct_form.assign
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_record_names_type,
              target: target_model_type_atom_node(
                identity: record_literal_type_naming_to_symbol(
                  naming: projection.record_construct_form.record_literal_names_type
                )
              )
            )
          ]
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_field_access,
        target: target_model_type_conj_node(
          children: [
            target_model_named_edge(
              name: ^target_value_expr_field_field_access_dot,
              target: target_model_type_atom_node(
                identity: projection.field_access_form.dot
              )
            )
          ]
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_match,
        target: target_model_type_conj_node(
          children: [
            target_model_named_edge(
              name: ^target_value_expr_field_match_token,
              target: target_model_type_atom_node(
                identity: projection.match_form.match_token
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_match_scrutinee_open,
              target: target_model_type_atom_node(
                identity: projection.match_form.scrutinee_open
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_match_scrutinee_close,
              target: target_model_type_atom_node(
                identity: projection.match_form.scrutinee_close
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_match_open,
              target: target_model_type_atom_node(
                identity: projection.match_form.open
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_match_close,
              target: target_model_type_atom_node(
                identity: projection.match_form.close
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_match_fat_arrow,
              target: target_model_type_atom_node(
                identity: projection.match_form.fat_arrow
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_match_arm_separator,
              target: target_model_type_atom_node(
                identity: projection.match_form.arm_separator
              )
            )
          ]
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_bool_literal,
        target: target_model_type_conj_node(
          children: [
            target_model_named_edge(
              name: ^target_value_expr_field_bool_true_token,
              target: target_model_type_atom_node(
                identity: projection.bool_literal_form.true_token
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_bool_false_token,
              target: target_model_type_atom_node(
                identity: projection.bool_literal_form.false_token
              )
            )
          ]
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_block_eval,
        target: block_evaluation_mode_to_node(
          mode: projection.block_evaluation_mode
        )
      )
    ]
  )
}

fn target_value_template_apply(
  template: v2.std.compilers.target_model.TargetValueTemplate,
  value: v2.std.compilers.target_model.SourceAtomValue,
  source_carrier: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression> {
  match template.kind {
    ValueSymbolIdentityPassthrough =>
      match source_atom_value_as_symbol(value: value) {
        Absent =>
          outcome_rejected(
            target_value_template_mismatch_diagnostic(source_carrier: source_carrier)
          )
        Present { value: id } =>
          outcome_accepted(target_value_expression_symbol_identity(identity: id))
      }
    ValueSymbolToOwnedString =>
      match source_atom_value_as_symbol(value: value) {
        Absent =>
          outcome_rejected(
            target_value_template_mismatch_diagnostic(source_carrier: source_carrier)
          )
        Present { value: id } =>
          outcome_accepted(target_value_expression_symbol_to_owned_string(identity: id))
      }
    ValueBoolLiteral =>
      match source_atom_value_as_bool(value: value) {
        Absent =>
          outcome_rejected(
            target_value_template_mismatch_diagnostic(source_carrier: source_carrier)
          )
        Present { value: b } => outcome_accepted(target_value_expression_bool_literal(value: b))
      }
    ValueCharUnicodeScalar =>
      match source_atom_value_as_char(value: value) {
        Absent =>
          outcome_rejected(
            target_value_template_mismatch_diagnostic(source_carrier: source_carrier)
          )
        Present { value: c } =>
          outcome_accepted(target_value_expression_char_unicode_scalar(codepoint: c))
      }
    ValueStringLiteral =>
      match source_atom_value_as_string(value: value) {
        Absent =>
          outcome_rejected(
            target_value_template_mismatch_diagnostic(source_carrier: source_carrier)
          )
        Present { value: s } =>
          outcome_accepted(target_value_expression_string_literal(value: s))
      }
    ValueBindingRef =>
      outcome_rejected(
        target_value_template_mismatch_diagnostic(source_carrier: source_carrier)
      )
    ValuePrimitiveApply =>
      outcome_rejected(
        target_value_template_mismatch_diagnostic(source_carrier: source_carrier)
      )
    ValueEffectApply =>
      outcome_rejected(
        target_value_template_mismatch_diagnostic(source_carrier: source_carrier)
      )
    ValueConditional =>
      outcome_rejected(
        target_value_template_mismatch_diagnostic(source_carrier: source_carrier)
      )
    ValueBindLet =>
      outcome_rejected(
        target_value_template_mismatch_diagnostic(source_carrier: source_carrier)
      )
    ValueLoop =>
      outcome_rejected(
        target_value_template_mismatch_diagnostic(source_carrier: source_carrier)
      )
    ValueRecordConstruct =>
      outcome_rejected(
        target_value_template_mismatch_diagnostic(source_carrier: source_carrier)
      )
    ValueFieldAccess =>
      outcome_rejected(
        target_value_template_mismatch_diagnostic(source_carrier: source_carrier)
      )
    ValueMatch =>
      outcome_rejected(
        target_value_template_mismatch_diagnostic(source_carrier: source_carrier)
      )
  }
}

fn target_value_template_mismatch_diagnostic(source_carrier: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_value_template_mismatch,
    at: node_locus(node: source_carrier),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_atom_realization_lookup_step(
  acc: v2.std.passing_candidate_fold.PassingCandidateFold<v2.std.node.Node>,
  row: v2.std.compilers.target_model.TargetAtomRealization,
  source_carrier: v2.std.node.Node
) -> v2.std.passing_candidate_fold.PassingCandidateFold<v2.std.node.Node> {
  if content_hash(n: row.source_carrier) == content_hash(n: source_carrier) {
    match acc {
      v2.std.passing_candidate_fold.NoPassingCandidate => v2.std.passing_candidate_fold.OnePassingCandidate { candidate: row.source_carrier }
      OnePassingCandidate { candidate: _ } => v2.std.passing_candidate_fold.ManyPassingCandidates
      v2.std.passing_candidate_fold.ManyPassingCandidates => v2.std.passing_candidate_fold.ManyPassingCandidates
    }
  } else {
    acc
  }
}

fn target_atom_realization_lookup_extract_row_step(
  acc: Optional<v2.std.compilers.target_model.TargetAtomRealization>,
  row: v2.std.compilers.target_model.TargetAtomRealization,
  source_carrier: v2.std.node.Node
) -> v2.std.optional.Optional<v2.std.compilers.target_model.TargetAtomRealization> {
  match acc {
    Present { value: _ } => acc
    Absent =>
      if content_hash(n: row.source_carrier) == content_hash(n: source_carrier) {
        optional_present(value: row)
      } else {
        acc
      }
  }
}

fn target_atom_realization_lookup_extract_row(
  catalog: v2.std.collection.List<v2.std.compilers.target_model.TargetAtomRealization>,
  source_carrier: v2.std.node.Node
) -> v2.std.optional.Optional<v2.std.compilers.target_model.TargetAtomRealization> {
  fold(catalog, init: optional_absent(), f: fn(acc, item) {
    target_atom_realization_lookup_extract_row_step(
      acc: acc,
      row: item,
      source_carrier: source_carrier
    )
  })
}

fn target_atom_realization_lookup_in_catalog(
  catalog: v2.std.collection.List<v2.std.compilers.target_model.TargetAtomRealization>,
  source_carrier: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetAtomRealization> {
  match fold_list(
    xs: catalog,
    empty: v2.std.passing_candidate_fold.NoPassingCandidate,
    cons: fn(acc, row) {
      target_atom_realization_lookup_step(
        acc: acc,
        row: row,
        source_carrier: source_carrier
      )
    }
  ) {
    v2.std.passing_candidate_fold.NoPassingCandidate =>
      outcome_rejected(target_atom_realization_lookup_miss_diagnostic(source_carrier: source_carrier))
    OnePassingCandidate { candidate: _ } =>
      match target_atom_realization_lookup_extract_row(
        catalog: catalog,
        source_carrier: source_carrier
      ) {
        Present { value: row } => v2.std.diagnostic.Accepted { value: row, diagnostics: v2.std.diagnostic.None }
        Absent =>
          outcome_rejected(target_atom_realization_lookup_miss_diagnostic(source_carrier: source_carrier))
      }
    v2.std.passing_candidate_fold.ManyPassingCandidates =>
      outcome_rejected(target_atom_realization_lookup_ambiguous_diagnostic(source_carrier: source_carrier))
  }
}

fn target_atom_realization_lookup_miss_diagnostic(source_carrier: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_atom_realization_lookup_miss,
    at: node_locus(node: source_carrier),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_atom_realization_lookup_ambiguous_diagnostic(source_carrier: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_atom_realization_lookup_ambiguous,
    at: node_locus(node: source_carrier),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_atom_value_expression(
  row: v2.std.compilers.target_model.TargetAtomRealization,
  value: v2.std.compilers.target_model.SourceAtomValue
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression> {
  target_value_template_apply(
    template: row.value_form,
    value: value,
    source_carrier: row.source_carrier
  )
}

fn target_value_expression_bool_atom(value: Bool) -> v2.std.node.Node {
  match value {
    true =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode {
          connective: v2.std.node.Atom { identity: ^target_value_expression_bool_true }
        },
        children: [],
        occurrence_id: SyntheticOccurrence
}
    false =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode {
          connective: v2.std.node.Atom { identity: ^target_value_expression_bool_false }
        },
        children: [],
        occurrence_id: SyntheticOccurrence
}
  }
}

fn target_value_expression_node(expr: v2.std.compilers.target_model.TargetValueExpression) -> v2.std.node.Node {
  expr.node
}

fn target_value_template_node(template: v2.std.compilers.target_model.TargetValueTemplate) -> v2.std.node.Node {
  template.node
}

fn target_constructor_template_node(form: Optional<v2.std.compilers.target_model.TargetConstructorTemplate>) -> v2.std.node.Node {
  match form {
    Absent =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode {
          connective: v2.std.node.Atom { identity: ^target_constructor_template_optional_absent }
        },
        children: [],
        occurrence_id: SyntheticOccurrence
}
    Present { value: template } =>
      match template {
        CtorTemplateUnit {} =>
          v2.std.node.Node {
            kind: v2.std.node.TypeNode {
              connective: v2.std.node.Atom { identity: ^target_constructor_template_constructor_absent }
            },
            children: [],
            occurrence_id: SyntheticOccurrence
}
      }
  }
}

fn target_constructor_template_decode_invalid_diagnostic(source_carrier: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_constructor_template_decode_invalid,
    at: node_locus(node: source_carrier),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_constructor_template_from_node(
  n: v2.std.node.Node,
  source_carrier: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<Optional<v2.std.compilers.target_model.TargetConstructorTemplate>> {
  match n.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id == ^target_constructor_template_optional_absent {
        outcome_accepted(optional_absent())
      } else if id == ^target_constructor_template_constructor_absent {
        outcome_accepted(optional_present(CtorTemplateUnit {}))
      } else {
        outcome_rejected(
          target_constructor_template_decode_invalid_diagnostic(source_carrier: source_carrier)
        )
      }
    _ =>
      outcome_rejected(
        target_constructor_template_decode_invalid_diagnostic(source_carrier: source_carrier)
      )
  }
}

fn target_model_bundle_core_keep_edge(acc: v2.std.collection.List<v2.std.node.Edge>, edge: v2.std.node.Edge) -> v2.std.collection.List<v2.std.node.Edge> {
  match edge.label {
    Named { name: n } =>

      match n == ^target_model_edge_atom_realizations
        || n == ^target_model_edge_signature_realizations {
        true => acc
        false => list_snoc_item(xs: acc, item: edge)
      }
    Positional => list_snoc_item(xs: acc, item: edge)
  }
}

fn target_model_bundle_core(host: v2.std.compilers.target_model.TargetModel) -> v2.std.node.Node {
  match host.bundle.kind {
    TypeNode { connective: Conj } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: Conj },
        children: fold_list(
          xs: host.bundle.children,
          empty: std.algebra.Empty,
          cons: fn(acc, edge) {
            target_model_bundle_core_keep_edge(acc: acc, edge: edge)
          }
        ),
        occurrence_id: SyntheticOccurrence
}
    _ => host.bundle
  }
}

fn target_atom_realization_bundle_matches_host(row_bundle: v2.std.node.Node, host: v2.std.compilers.target_model.TargetModel) -> Bool {
  content_hash(n: row_bundle) == content_hash(n: host.bundle)
  || content_hash(n: row_bundle) == content_hash(n: target_model_bundle_core(host: host))
}

fn target_atom_realization_to_node(row: v2.std.compilers.target_model.TargetAtomRealization, host_bundle: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      target_model_named_edge(
        name: ^target_atom_realization_field_source_carrier,
        target: row.source_carrier
      ),
      target_model_named_edge(
        name: ^target_atom_realization_field_target_model_bundle,
        target: host_bundle
      ),
      target_model_named_edge(
        name: ^target_atom_realization_field_type_form,
        target: row.type_form.node
      ),
      target_model_named_edge(
        name: ^target_atom_realization_field_value_form,
        target: target_value_template_node(template: row.value_form)
      ),
      target_model_named_edge(
        name: ^target_atom_realization_field_constructor_form,
        target: target_constructor_template_node(form: row.constructor_form)
      ),
      target_model_named_edge(
        name: ^target_atom_realization_field_display_name,
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: row.display_name } },
          children: [],
          occurrence_id: SyntheticOccurrence
}
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn target_atom_realization_catalog_edge(
  row: v2.std.compilers.target_model.TargetAtomRealization,
  host_bundle: v2.std.node.Node
) -> v2.std.node.Edge {
  target_model_named_edge(
    name: row.display_name,
    target: target_atom_realization_to_node(row: row, host_bundle: host_bundle)
  )
}

fn target_atom_realization_catalog_snoc_edge(
  acc: v2.std.collection.List<v2.std.node.Edge>,
  row: v2.std.compilers.target_model.TargetAtomRealization,
  host_bundle: v2.std.node.Node
) -> v2.std.collection.List<v2.std.node.Edge> {
  list_snoc_item(
    xs: acc,
    item: target_atom_realization_catalog_edge(row: row, host_bundle: host_bundle)
  )
}

fn target_atom_realization_catalog_node(
  rows: v2.std.collection.List<v2.std.compilers.target_model.TargetAtomRealization>,
  host_bundle: v2.std.node.Node
) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: fold_list(
      xs: rows,
      empty: std.algebra.Empty,
      cons: fn(acc, row) {
        target_atom_realization_catalog_snoc_edge(
          acc: acc,
          row: row,
          host_bundle: host_bundle
        )
      }
    ),
    occurrence_id: SyntheticOccurrence
}
}

fn target_atom_realization_target_model_bundle_mismatch_diagnostic(
  source_carrier: v2.std.node.Node
) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_atom_realization_target_model_bundle_mismatch,
    at: node_locus(node: source_carrier),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_atom_realization_catalog_row_decode_invalid_diagnostic(
  source_carrier: v2.std.node.Node
) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_atom_realization_catalog_row_decode_invalid,
    at: node_locus(node: source_carrier),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_atom_realization_catalog_lookup_step(
  acc: v2.std.passing_candidate_fold.PassingCandidateFold<v2.std.node.Node>,
  row_node: v2.std.node.Node,
  source_carrier: v2.std.node.Node,
  host_target_model: v2.std.compilers.target_model.TargetModel
) -> v2.std.passing_candidate_fold.PassingCandidateFold<v2.std.node.Node> {
  match target_atom_realization_from_row_node(
    row_node: row_node,
    host_target_model: host_target_model
  ) {
    Accepted { value: row, diagnostics: _ } =>
      if content_hash(n: row.source_carrier) == content_hash(n: source_carrier) {
        match acc {
          v2.std.passing_candidate_fold.NoPassingCandidate => v2.std.passing_candidate_fold.OnePassingCandidate { candidate: row_node }
          OnePassingCandidate { candidate: _ } => v2.std.passing_candidate_fold.ManyPassingCandidates
          v2.std.passing_candidate_fold.ManyPassingCandidates => v2.std.passing_candidate_fold.ManyPassingCandidates
        }
      } else {
        acc
      }
    Rejected { diagnostics: _ } => acc
  }
}

fn target_value_template_decode_invalid_diagnostic(source_carrier: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_value_template_decode_invalid,
    at: node_locus(node: source_carrier),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_type_expression_decode_invalid_diagnostic(source_carrier: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_type_expression_decode_invalid,
    at: node_locus(node: source_carrier),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_atom_realization_display_name_decode_invalid_diagnostic(
  source_carrier: v2.std.node.Node
) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_atom_realization_display_name_decode_invalid,
    at: node_locus(node: source_carrier),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_atom_realization_from_row_node(
  row_node: v2.std.node.Node,
  host_target_model: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetAtomRealization> {
  let source_carrier = target_atom_realization_conj_child(
    row_node: row_node,
    edge_name: ^target_atom_realization_field_source_carrier
  )
  let row_bundle = target_atom_realization_conj_child(
    row_node: row_node,
    edge_name: ^target_atom_realization_field_target_model_bundle
  )
  if target_atom_realization_bundle_matches_host(row_bundle: row_bundle, host: host_target_model) {
    match target_type_expression_from_node(
      n: target_atom_realization_conj_child(
        row_node: row_node,
        edge_name: ^target_atom_realization_field_type_form
      ),
      source_carrier: source_carrier
    ) {
      Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
      Accepted { value: type_form, diagnostics: _ } =>
        match target_value_template_from_node(
          n: target_atom_realization_conj_child(
            row_node: row_node,
            edge_name: ^target_atom_realization_field_value_form
          ),
          source_carrier: source_carrier
        ) {
          Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
          Accepted { value: value_form, diagnostics: _ } =>
            match target_constructor_template_from_node(
              n: target_atom_realization_conj_child(
                row_node: row_node,
                edge_name: ^target_atom_realization_field_constructor_form
              ),
              source_carrier: source_carrier
            ) {
              Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
              Accepted { value: constructor_form, diagnostics: _ } =>
                match target_atom_realization_display_name_from_row(
                  row_node: row_node,
                  source_carrier: source_carrier
                ) {
                  Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
                  Accepted { value: display_name, diagnostics: _ } =>
                    outcome_accepted(
                      TargetAtomRealization {
                        source_carrier: source_carrier,
                        target_model: host_target_model,
                        type_form: type_form,
                        value_form: value_form,
                        constructor_form: constructor_form,
                        display_name: display_name
                      }
                    )
                }
            }
        }
    }
  } else {
    outcome_rejected(
      target_atom_realization_target_model_bundle_mismatch_diagnostic(
        source_carrier: source_carrier
      )
    )
  }
}

fn target_atom_realization_conj_child(row_node: v2.std.node.Node, edge_name: v2.std.node.Symbol) -> v2.std.node.Node {
  match row_node.kind {
    TypeNode { connective: Conj } =>
      fold(
        row_node.children,
        init: row_node,
        f: fn(acc, e) {
          match e.label {
            Named { name: n } =>
              if n == edge_name {
                e.target
              } else {
                acc
              }
            Positional => acc
          }
        }
      )
    _ => row_node
  }
}

fn target_type_expression_from_node(
  n: v2.std.node.Node,
  source_carrier: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetTypeExpression> {
  match target_type_expr_emitted_kind(node: n) {
    TypeExprKindAuthority { value: kind } =>
      outcome_accepted(TargetTypeExpression { kind: kind, node: n })
    TypeExprKindNotEmitted =>
      outcome_rejected(
        target_type_expression_decode_invalid_diagnostic(source_carrier: source_carrier)
      )
    TypeExprKindAuthorityInvalid =>
      outcome_rejected(
        target_type_expression_decode_invalid_diagnostic(source_carrier: source_carrier)
      )
  }
}

fn target_value_template_from_node(
  n: v2.std.node.Node,
  source_carrier: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueTemplate> {
  match n.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id == discriminant(v: ValueSymbolIdentityPassthrough) {
        outcome_accepted(
          TargetValueTemplate {
            kind: ValueSymbolIdentityPassthrough,
            node: n
          }
        )
      } else if id == discriminant(v: ValueSymbolToOwnedString) {
        outcome_accepted(
          TargetValueTemplate {
            kind: ValueSymbolToOwnedString,
            node: n
          }
        )
      } else if id == discriminant(v: ValueBoolLiteral) {
        outcome_accepted(
          TargetValueTemplate { kind: ValueBoolLiteral, node: n }
        )
      } else if id == discriminant(v: ValueCharUnicodeScalar) {
        outcome_accepted(
          TargetValueTemplate {
            kind: ValueCharUnicodeScalar,
            node: n
          }
        )
      } else if id == discriminant(v: ValueStringLiteral) {
        outcome_accepted(
          TargetValueTemplate {
            kind: ValueStringLiteral,
            node: n
          }
        )
      } else {
        outcome_rejected(
          target_value_template_decode_invalid_diagnostic(source_carrier: source_carrier)
        )
      }
    _ =>
      outcome_rejected(
        target_value_template_decode_invalid_diagnostic(source_carrier: source_carrier)
      )
  }
}

fn target_atom_realization_display_name_from_row(
  row_node: v2.std.node.Node,
  source_carrier: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.node.Symbol> {
  match target_atom_realization_conj_child(
    row_node: row_node,
    edge_name: ^target_atom_realization_field_display_name
  ).kind {
    TypeNode { connective: Atom { identity: id } } => outcome_accepted(id)
    _ =>
      outcome_rejected(
        target_atom_realization_display_name_decode_invalid_diagnostic(
          source_carrier: source_carrier
        )
      )
  }
}

fn target_atom_realization_lookup_in_catalog_node(
  catalog: v2.std.node.Node,
  source_carrier: v2.std.node.Node,
  host_target_model: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetAtomRealization> {
  match catalog.kind {
    TypeNode { connective: Conj } =>
      match fold(
        catalog.children,
        init: v2.std.passing_candidate_fold.NoPassingCandidate,
        f: fn(acc, e) {
          target_atom_realization_catalog_lookup_step(
            acc: acc,
            row_node: e.target,
            source_carrier: source_carrier,
            host_target_model: host_target_model
          )
        }
      ) {
        v2.std.passing_candidate_fold.NoPassingCandidate =>
          outcome_rejected(target_atom_realization_lookup_miss_diagnostic(source_carrier: source_carrier))
        OnePassingCandidate { candidate: row_node } =>
          target_atom_realization_from_row_node(
            row_node: row_node,
            host_target_model: host_target_model
          )
        v2.std.passing_candidate_fold.ManyPassingCandidates =>
          outcome_rejected(target_atom_realization_lookup_ambiguous_diagnostic(source_carrier: source_carrier))
      }
    _ =>
      outcome_rejected(
        target_atom_realization_catalog_row_decode_invalid_diagnostic(source_carrier: source_carrier)
      )
  }
}

type FunctionBoundarySite
  = FunctionBoundaryParam
  | FunctionBoundaryReturn

type TargetFunctionSignatureRealization {
  source_carrier: v2.std.node.Node
  target_model: v2.std.compilers.target_model.TargetModel
  boundary_site: v2.std.compilers.target_model.FunctionBoundarySite
  signature_type_form: v2.std.compilers.target_model.TargetTypeExpression
}

fn target_function_boundary_site_to_node(site: v2.std.compilers.target_model.FunctionBoundarySite) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode {
      connective: v2.std.node.Atom { identity: discriminant(v: site) }
    },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn target_function_boundary_site_eq(a: v2.std.compilers.target_model.FunctionBoundarySite, b: v2.std.compilers.target_model.FunctionBoundarySite) -> Bool {
  discriminant(v: a) == discriminant(v: b)
}

fn target_function_signature_realization_lookup_miss_diagnostic(source_carrier: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_function_signature_realization_lookup_miss,
    at: node_locus(node: source_carrier),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_function_signature_realization_lookup_ambiguous_diagnostic(source_carrier: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_function_signature_realization_lookup_ambiguous,
    at: node_locus(node: source_carrier),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_function_signature_realization_row_decode_invalid_diagnostic(source_carrier: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_function_signature_realization_row_decode_invalid,
    at: node_locus(node: source_carrier),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_function_signature_realization_target_model_bundle_mismatch_diagnostic(source_carrier: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_function_signature_realization_target_model_bundle_mismatch,
    at: node_locus(node: source_carrier),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_function_boundary_site_decode_invalid_diagnostic(source_carrier: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_function_boundary_site_decode_invalid,
    at: node_locus(node: source_carrier),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_function_boundary_site_from_node(
  n: v2.std.node.Node,
  source_carrier: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.FunctionBoundarySite> {
  match n.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if v2.std.algebra.is_empty(xs: n.children) {
        if id == discriminant(v: FunctionBoundaryParam) {
          outcome_accepted(FunctionBoundaryParam)
        } else if id == discriminant(v: FunctionBoundaryReturn) {
          outcome_accepted(FunctionBoundaryReturn)
        } else {
          outcome_rejected(
            target_function_boundary_site_decode_invalid_diagnostic(source_carrier: source_carrier)
          )
        }
      } else {
        outcome_rejected(
          target_function_boundary_site_decode_invalid_diagnostic(source_carrier: source_carrier)
        )
      }
    _ =>
      outcome_rejected(
        target_function_boundary_site_decode_invalid_diagnostic(source_carrier: source_carrier)
      )
  }
}

fn target_function_signature_realization_to_node(
  row: v2.std.compilers.target_model.TargetFunctionSignatureRealization
) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      target_model_named_edge(
        name: ^target_function_signature_realization_field_source_carrier,
        target: row.source_carrier
      ),
      target_model_named_edge(
        name: ^target_function_signature_realization_field_target_model_bundle,
        target: target_model_bundle_core(host: row.target_model)
      ),
      target_model_named_edge(
        name: ^target_function_signature_realization_field_boundary_site,
        target: target_function_boundary_site_to_node(site: row.boundary_site)
      ),
      target_model_named_edge(
        name: ^target_function_signature_realization_field_signature_type_form,
        target: row.signature_type_form.node
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn target_function_signature_realization_catalog_edge(
  row: v2.std.compilers.target_model.TargetFunctionSignatureRealization
) -> v2.std.node.Edge {
  v2.std.node.Edge {
    label: Positional,
    target: target_function_signature_realization_to_node(row: row)
  }
}

fn target_function_signature_realization_catalog_snoc_edge(
  acc: v2.std.collection.List<v2.std.node.Edge>,
  row: v2.std.compilers.target_model.TargetFunctionSignatureRealization
) -> v2.std.collection.List<v2.std.node.Edge> {
  list_snoc_item(
    xs: acc,
    item: target_function_signature_realization_catalog_edge(row: row)
  )
}

fn target_function_signature_realization_catalog_node(
  rows: v2.std.collection.List<v2.std.compilers.target_model.TargetFunctionSignatureRealization>
) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: fold_list(
      xs: rows,
      empty: std.algebra.Empty,
      cons: fn(acc, row) {
        target_function_signature_realization_catalog_snoc_edge(
          acc: acc,
          row: row
        )
      }
    ),
    occurrence_id: SyntheticOccurrence
}
}

fn target_function_signature_realization_from_row_node(
  row_node: v2.std.node.Node,
  host_target_model: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetFunctionSignatureRealization> {
  let source_carrier = target_atom_realization_conj_child(
    row_node: row_node,
    edge_name: ^target_function_signature_realization_field_source_carrier
  )
  let row_bundle = target_atom_realization_conj_child(
    row_node: row_node,
    edge_name: ^target_function_signature_realization_field_target_model_bundle
  )
  if target_atom_realization_bundle_matches_host(row_bundle: row_bundle, host: host_target_model) {
    match target_function_boundary_site_from_node(
      n: target_atom_realization_conj_child(
        row_node: row_node,
        edge_name: ^target_function_signature_realization_field_boundary_site
      ),
      source_carrier: source_carrier
    ) {
      Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
      Accepted { value: boundary_site, diagnostics: _ } =>
        match target_type_expression_from_node(
          n: target_atom_realization_conj_child(
            row_node: row_node,
            edge_name: ^target_function_signature_realization_field_signature_type_form
          ),
          source_carrier: source_carrier
        ) {
          Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
          Accepted { value: signature_type_form, diagnostics: _ } =>
            outcome_accepted(
              TargetFunctionSignatureRealization {
                source_carrier: source_carrier,
                target_model: host_target_model,
                boundary_site: boundary_site,
                signature_type_form: signature_type_form
              }
            )
        }
    }
  } else {
    outcome_rejected(
      target_function_signature_realization_target_model_bundle_mismatch_diagnostic(
        source_carrier: source_carrier
      )
    )
  }
}

type TargetFunctionSignatureRealizationCatalogLookup
  = TargetFunctionSignatureRealizationCatalogMissing
  | TargetFunctionSignatureRealizationCatalogUnique { row: v2.std.compilers.target_model.TargetFunctionSignatureRealization }
  | TargetFunctionSignatureRealizationCatalogAmbiguous
  | TargetFunctionSignatureRealizationCatalogInvalid

fn target_function_signature_realization_catalog_lookup_step(
  acc: v2.std.compilers.target_model.TargetFunctionSignatureRealizationCatalogLookup,
  row_node: v2.std.node.Node,
  source_carrier: v2.std.node.Node,
  boundary_site: v2.std.compilers.target_model.FunctionBoundarySite,
  host_target_model: v2.std.compilers.target_model.TargetModel
) -> v2.std.compilers.target_model.TargetFunctionSignatureRealizationCatalogLookup {
  match target_function_signature_realization_from_row_node(
    row_node: row_node,
    host_target_model: host_target_model
  ) {
    Accepted { value: row, diagnostics: _ } =>
      if content_hash(n: row.source_carrier) == content_hash(n: source_carrier)
        && target_function_boundary_site_eq(a: row.boundary_site, b: boundary_site) {
        match acc {
          TargetFunctionSignatureRealizationCatalogMissing =>
            TargetFunctionSignatureRealizationCatalogUnique { row: row }
          TargetFunctionSignatureRealizationCatalogUnique { row: _ } =>
            TargetFunctionSignatureRealizationCatalogAmbiguous
          TargetFunctionSignatureRealizationCatalogAmbiguous =>
            TargetFunctionSignatureRealizationCatalogAmbiguous
          TargetFunctionSignatureRealizationCatalogInvalid =>
            TargetFunctionSignatureRealizationCatalogInvalid
        }
      } else {
        acc
      }
    Rejected { diagnostics: _ } => TargetFunctionSignatureRealizationCatalogInvalid
  }
}

fn target_function_signature_realization_lookup_in_catalog_node(
  catalog: v2.std.node.Node,
  source_carrier: v2.std.node.Node,
  boundary_site: v2.std.compilers.target_model.FunctionBoundarySite,
  host_target_model: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetFunctionSignatureRealization> {
  match catalog.kind {
    TypeNode { connective: Conj } =>
      match fold(
        catalog.children,
        init: TargetFunctionSignatureRealizationCatalogMissing,
        f: fn(acc, e) {
          target_function_signature_realization_catalog_lookup_step(
            acc: acc,
            row_node: e.target,
            source_carrier: source_carrier,
            boundary_site: boundary_site,
            host_target_model: host_target_model
          )
        }
      ) {
        TargetFunctionSignatureRealizationCatalogMissing =>
          outcome_rejected(
            target_function_signature_realization_lookup_miss_diagnostic(source_carrier: source_carrier)
          )
        TargetFunctionSignatureRealizationCatalogUnique { row: row } =>
          v2.std.diagnostic.Accepted { value: row, diagnostics: v2.std.diagnostic.None }
        TargetFunctionSignatureRealizationCatalogAmbiguous =>
          outcome_rejected(
            target_function_signature_realization_lookup_ambiguous_diagnostic(source_carrier: source_carrier)
          )
        TargetFunctionSignatureRealizationCatalogInvalid =>
          outcome_rejected(
            target_function_signature_realization_row_decode_invalid_diagnostic(source_carrier: source_carrier)
          )
      }
    _ =>
      outcome_rejected(
        target_function_signature_realization_row_decode_invalid_diagnostic(source_carrier: source_carrier)
      )
  }
}

type TargetTypeExprKind
  = TargetTypeExprAtom
  | TargetTypeExprInstantiation
  | TargetTypeExprCardinality
  | TargetTypeExprRecord
  | TargetTypeExprSum
  | TargetTypeExprArrow

type TargetTypeExprArrowWireShape
  = TargetTypeExprArrowPositionalWire
  | TargetTypeExprArrowLabeledWire

fn target_type_expr_arrow_wire_shape(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetTypeExprArrowWireShape> {
  let positional = node_positional_child_targets(node: node)
  if is_empty(xs: positional) {
    match find_named_child(root: node, name: ^target_type_expr_field_codomain) {
      Accepted { value: _, diagnostics: d } =>
        v2.std.diagnostic.Accepted { value: TargetTypeExprArrowLabeledWire, diagnostics: d }
      Rejected { diagnostics: _ } =>
        outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
    }
  } else {
    if length(xs: positional) >= 2 {
      match target_type_expr_fold_named_metadata_edges(node: node) {
        NamedMetadataFoldOk { kind_seen: true, surface_seen: true, extra_named: 0 } =>
          outcome_accepted(TargetTypeExprArrowPositionalWire)
        _ =>
          outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
      }
    } else {
      outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
    }
  }
}

type TargetTypeExprArrowParamSlot {
  label: v2.std.node.Symbol
  type_expr: v2.std.node.Node
}

type TargetAtomTypeShape {
  surface: v2.std.node.Symbol
  ident_token: v2.std.node.Symbol
}

type TargetGenericApply {
  surface: v2.std.node.Symbol
  open: v2.std.node.Symbol
  separator: v2.std.node.Symbol
  field_label_separator: Optional<v2.std.node.Symbol>
  close: v2.std.node.Symbol
}

type TargetSumTypeShape {
  surface: v2.std.node.Symbol
  variant_separator: v2.std.node.Symbol
}

type TargetTypeExprFieldSlot {
  label: v2.std.node.Symbol
  type_expr: v2.std.node.Node
}

type TargetTypeExprVariantSlot {
  label: v2.std.node.Symbol
  type_expr: v2.std.node.Node
}

type TargetFunctionTypeShape {
  surface: v2.std.node.Symbol
  open: v2.std.node.Symbol
  close: v2.std.node.Symbol
  arrow: v2.std.node.Symbol
  param_ident_token: v2.std.node.Symbol
  param_type_separator: v2.std.node.Symbol
  param_list_separator: v2.std.node.Symbol
}

type TargetTypeExpression {
  kind: v2.std.compilers.target_model.TargetTypeExprKind
  node: v2.std.node.Node
}

type TargetTypeExpressionProjection {
  atom_form: v2.std.compilers.target_model.TargetAtomTypeShape
  conj_form: v2.std.compilers.target_model.TargetGenericApply
  disj_form: v2.std.compilers.target_model.TargetSumTypeShape
  arrow_form: v2.std.compilers.target_model.TargetFunctionTypeShape
  cardinality_form: v2.std.compilers.target_model.TargetGenericApply
  instantiation_form: v2.std.compilers.target_model.TargetGenericApply
}

fn target_type_expr_surface_edge(surface: v2.std.node.Symbol) -> v2.std.node.Edge {
  v2.std.node.Edge {
    label: Named { name: ^target_type_expr_field_surface },
    target: v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: surface } },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

fn target_type_expr_kind_from_atom(id: v2.std.node.Symbol) -> v2.std.optional.Optional<v2.std.compilers.target_model.TargetTypeExprKind> {
  if id == discriminant(v: TargetTypeExprAtom) {
    optional_present(value: TargetTypeExprAtom)
  } else {
    if id == discriminant(v: TargetTypeExprInstantiation) {
      optional_present(value: TargetTypeExprInstantiation)
    } else {
      if id == discriminant(v: TargetTypeExprCardinality) {
        optional_present(value: TargetTypeExprCardinality)
      } else {
        if id == discriminant(v: TargetTypeExprRecord) {
          optional_present(value: TargetTypeExprRecord)
        } else {
          if id == discriminant(v: TargetTypeExprSum) {
            optional_present(value: TargetTypeExprSum)
          } else {
            if id == discriminant(v: TargetTypeExprArrow) {
              optional_present(value: TargetTypeExprArrow)
            } else {
              optional_absent()
            }
          }
        }
      }
    }
  }
}

type TargetTypeExprKindProbe
  = TypeExprKindAuthority { value: v2.std.compilers.target_model.TargetTypeExprKind }
  | TypeExprKindNotEmitted
  | TypeExprKindAuthorityInvalid

type TargetTypeExprKindAuthorityFold
  = KindAuthorityFoldNone
  | KindAuthorityFoldUnique { value: v2.std.compilers.target_model.TargetTypeExprKind }
  | KindAuthorityFoldConflict

type TargetTypeExprKindEdgeDecode
  = KindEdgeNotKindField
  | KindEdgeAuthority { value: v2.std.compilers.target_model.TargetTypeExprKind }
  | KindEdgeAuthorityMalformed

fn target_type_expr_decode_kind_edge(edge: v2.std.node.Edge) -> v2.std.compilers.target_model.TargetTypeExprKindEdgeDecode {
  match edge.label {
    Named { name: n } =>
      if n == ^target_type_expr_field_kind {
        match edge.target.kind {
          TypeNode { connective: Atom { identity: id } } =>
            match target_type_expr_kind_from_atom(id: id) {
              Present { value: kind } => KindEdgeAuthority { value: kind }
              Absent => KindEdgeAuthorityMalformed
            }
          _ => KindEdgeAuthorityMalformed
        }
      } else {
        KindEdgeNotKindField
      }
    Positional => KindEdgeNotKindField
  }
}

fn target_type_expr_emitted_kind(node: v2.std.node.Node) -> v2.std.compilers.target_model.TargetTypeExprKindProbe {
  match node.kind {
    TypeNode { connective: Conj } =>
      match fold(node.children, init: KindAuthorityFoldNone, f: fn(acc, e) {
        match acc {
          KindAuthorityFoldConflict => acc
          KindAuthorityFoldNone =>
            match target_type_expr_decode_kind_edge(edge: e) {
              KindEdgeNotKindField => acc
              KindEdgeAuthorityMalformed => KindAuthorityFoldConflict
              KindEdgeAuthority { value: kind } =>
                KindAuthorityFoldUnique { value: kind }
            }
          KindAuthorityFoldUnique { value: _ } =>
            match target_type_expr_decode_kind_edge(edge: e) {
              KindEdgeNotKindField => acc
              KindEdgeAuthorityMalformed => KindAuthorityFoldConflict
              KindEdgeAuthority { value: _ } => KindAuthorityFoldConflict
            }
        }
      }) {
        KindAuthorityFoldNone => TypeExprKindNotEmitted
        KindAuthorityFoldUnique { value: kind } =>
          TypeExprKindAuthority { value: kind }
        KindAuthorityFoldConflict => TypeExprKindAuthorityInvalid
      }
    _ => TypeExprKindNotEmitted
  }
}

fn target_type_expr_kind_edge(kind: v2.std.compilers.target_model.TargetTypeExprKind) -> v2.std.node.Edge {
  v2.std.node.Edge {
    label: Named { name: ^target_type_expr_field_kind },
    target: v2.std.node.Node {
      kind: v2.std.node.TypeNode {
        connective: v2.std.node.Atom { identity: discriminant(v: kind) }
      },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

fn target_type_expr_positional_edges(children: v2.std.collection.List<v2.std.node.Node>) -> v2.std.collection.List<v2.std.node.Edge> {
  fold_list(
    xs: children,
    empty: std.algebra.Empty,
    cons: fn(acc, child) {
      list_snoc_item(
        xs: acc,
        item: v2.std.node.Edge { label: Positional, target: child }
      )
    }
  )
}

fn target_type_expr_wrapped_emitted(
  kind: v2.std.compilers.target_model.TargetTypeExprKind,
  surface: v2.std.node.Symbol,
  children: v2.std.collection.List<v2.std.node.Node>
) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: list_snoc_item(
      xs: list_snoc_item(
        xs: target_type_expr_positional_edges(children: children),
        item: target_type_expr_surface_edge(surface: surface)
      ),
      item: target_type_expr_kind_edge(kind: kind)
    ),
    occurrence_id: SyntheticOccurrence
}
}

fn target_type_expr_atom_emitted(form: v2.std.compilers.target_model.TargetAtomTypeShape, identity: v2.std.node.Symbol) -> v2.std.node.Node {
  target_type_expr_wrapped_emitted(
    kind: TargetTypeExprAtom,
    surface: form.surface,
    children: [
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: identity } },
        children: [],
        occurrence_id: SyntheticOccurrence
}
    ]
  )
}

fn target_atom_alias_type_expression(
  spelling: v2.std.node.Symbol,
  atom_form: v2.std.compilers.target_model.TargetAtomTypeShape
) -> v2.std.compilers.target_model.TargetTypeExpression {
  TargetTypeExpression {
    kind: TargetTypeExprAtom,
    node: target_type_expr_atom_emitted(form: atom_form, identity: spelling)
  }
}

fn target_type_expr_wrapped_emitted_labeled(
  kind: v2.std.compilers.target_model.TargetTypeExprKind,
  surface: v2.std.node.Symbol,
  slot_edges: v2.std.collection.List<v2.std.node.Edge>
) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: list_append(
      left: list_append(
        left: slot_edges,
        right: std.algebra.Cons { head: target_type_expr_surface_edge(surface: surface), tail: std.algebra.Empty }
      ),
      right: std.algebra.Cons { head: target_type_expr_kind_edge(kind: kind), tail: std.algebra.Empty }
    ),
    occurrence_id: SyntheticOccurrence
}
}

fn target_type_expr_instantiation_emitted(
  form: v2.std.compilers.target_model.TargetGenericApply,
  head: v2.std.node.Node,
  args: v2.std.collection.List<v2.std.node.Node>
) -> v2.std.node.Node {
  target_type_expr_wrapped_emitted(
    kind: TargetTypeExprInstantiation,
    surface: form.surface,
    children: list_append(
      left: std.algebra.Cons { head: head, tail: std.algebra.Empty },
      right: args
    )
  )
}

fn target_type_expr_cardinality_emitted(
  form: v2.std.compilers.target_model.TargetGenericApply,
  head: v2.std.node.Node,
  args: v2.std.collection.List<v2.std.node.Node>
) -> v2.std.node.Node {
  target_type_expr_wrapped_emitted(
    kind: TargetTypeExprCardinality,
    surface: form.surface,
    children: list_append(
      left: std.algebra.Cons { head: head, tail: std.algebra.Empty },
      right: args
    )
  )
}

fn target_type_expr_field_slot_edges(fields: v2.std.collection.List<v2.std.compilers.target_model.TargetTypeExprFieldSlot>) -> v2.std.collection.List<v2.std.node.Edge> {
  fold(fields, init: std.algebra.Empty, f: fn(acc, field) {
    list_snoc_item(
      xs: acc,
      item: v2.std.node.Edge { label: Named { name: field.label }, target: field.type_expr }
    )
  })
}

fn target_type_expr_arrow_param_slot_edges(params: v2.std.collection.List<v2.std.compilers.target_model.TargetTypeExprArrowParamSlot>) -> v2.std.collection.List<v2.std.node.Edge> {
  fold(params, init: std.algebra.Empty, f: fn(acc, param) {
    list_snoc_item(
      xs: acc,
      item: v2.std.node.Edge { label: Named { name: param.label }, target: param.type_expr }
    )
  })
}

fn target_type_expr_variant_slot_edges(variants: v2.std.collection.List<v2.std.compilers.target_model.TargetTypeExprVariantSlot>) -> v2.std.collection.List<v2.std.node.Edge> {
  fold(variants, init: std.algebra.Empty, f: fn(acc, variant) {
    list_snoc_item(
      xs: acc,
      item: v2.std.node.Edge { label: Named { name: variant.label }, target: variant.type_expr }
    )
  })
}

fn target_type_expr_emitted_slot_type_nodes(node: v2.std.node.Node) -> v2.std.collection.List<v2.std.node.Node> {
  fold(node.children, init: std.algebra.Empty, f: fn(acc, e) {
    match e.label {
      Named { name: n } =>
        if n == ^target_type_expr_field_surface || n == ^target_type_expr_field_kind {
          acc
        } else {
          list_snoc_item(xs: acc, item: e.target)
        }
      Positional => acc
    }
  })
}

fn target_type_expr_emitted_shape_malformed_diagnostic(node: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_type_expr_emitted_shape_malformed,
    at: node_locus(node: node),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

type TargetTypeExprNamedMetadataFold
  = NamedMetadataFoldMalformed
  | NamedMetadataFoldOk { kind_seen: Bool, surface_seen: Bool, extra_named: Int }

fn target_type_expr_fold_named_metadata_edges(node: v2.std.node.Node) -> v2.std.compilers.target_model.TargetTypeExprNamedMetadataFold {
  match fold(node.children, init: NamedMetadataFoldOk { kind_seen: false, surface_seen: false, extra_named: 0 }, f: fn(acc, e) {
    match acc {
      NamedMetadataFoldMalformed => acc
      NamedMetadataFoldOk { kind_seen: kind_seen, surface_seen: surface_seen, extra_named: extra_named } =>
        match e.label {
          Positional => acc
          Named { name: n } =>
            if n == ^target_type_expr_field_kind {
              if kind_seen {
                NamedMetadataFoldMalformed
              } else {
                match e.target.kind {
                  TypeNode { connective: Atom { identity: _ } } =>
                    NamedMetadataFoldOk { kind_seen: true, surface_seen: surface_seen, extra_named: extra_named }
                  _ => NamedMetadataFoldMalformed
                }
              }
            } else {
              if n == ^target_type_expr_field_surface {
                if surface_seen {
                  NamedMetadataFoldMalformed
                } else {
                  match e.target.kind {
                    TypeNode { connective: Atom { identity: _ } } =>
                      NamedMetadataFoldOk { kind_seen: kind_seen, surface_seen: true, extra_named: extra_named }
                    _ => NamedMetadataFoldMalformed
                  }
                }
              } else {
                NamedMetadataFoldOk { kind_seen: kind_seen, surface_seen: surface_seen, extra_named: extra_named + 1 }
              }
            }
        }
    }
  }) {
    NamedMetadataFoldOk { kind_seen: kind_seen, surface_seen: surface_seen, extra_named: extra_named } =>
      if kind_seen && surface_seen {
        NamedMetadataFoldOk { kind_seen: kind_seen, surface_seen: surface_seen, extra_named: extra_named }
      } else {
        NamedMetadataFoldMalformed
      }
    NamedMetadataFoldMalformed => NamedMetadataFoldMalformed
  }
}

fn target_type_expr_emitted_surface_identity(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Symbol> {
  match find_named_child(root: node, name: ^target_type_expr_field_surface) {
    Accepted { value: child, diagnostics: d } =>
      match child.kind {
        TypeNode { connective: Atom { identity: id } } =>
          v2.std.diagnostic.Accepted { value: id, diagnostics: d }
        _ => outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
      }
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn target_type_expression_spelling(form: v2.std.compilers.target_model.TargetTypeExpression) -> v2.std.node.Symbol {
  match target_type_expr_emitted_surface_identity(node: form.node) {
    Accepted { value: surface, diagnostics: _ } => surface
    Rejected { diagnostics: _ } => ^target_type_expression_decode_invalid
  }
}

fn target_atom_type_spelling(row: v2.std.compilers.target_model.TargetAtomRealization) -> v2.std.node.Symbol {
  target_type_expression_spelling(form: row.type_form)
}

fn target_type_expr_expected_surface_for_kind(
  kind: v2.std.compilers.target_model.TargetTypeExprKind,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection
) -> v2.std.node.Symbol {
  match kind {
    TargetTypeExprAtom => projection.atom_form.surface
    TargetTypeExprInstantiation => projection.instantiation_form.surface
    TargetTypeExprCardinality => projection.cardinality_form.surface
    TargetTypeExprRecord => projection.conj_form.surface
    TargetTypeExprSum => projection.disj_form.surface
    TargetTypeExprArrow => projection.arrow_form.surface
  }
}

fn target_type_expr_emitted_validate_positional_arity(
  node: v2.std.node.Node,
  kind: v2.std.compilers.target_model.TargetTypeExprKind
) -> v2.std.diagnostic.Outcome<Bool> {
  let positional = node_positional_child_targets(node: node)
  match kind {
    TargetTypeExprAtom =>
      if length(xs: positional) == 1 {
        v2.std.diagnostic.Accepted { value: true, diagnostics: v2.std.diagnostic.None }
      } else {
        outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
      }
    TargetTypeExprInstantiation =>
      if length(xs: positional) >= 1 {
        v2.std.diagnostic.Accepted { value: true, diagnostics: v2.std.diagnostic.None }
      } else {
        outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
      }
    TargetTypeExprCardinality =>
      if length(xs: positional) >= 1 {
        v2.std.diagnostic.Accepted { value: true, diagnostics: v2.std.diagnostic.None }
      } else {
        outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
      }
    TargetTypeExprArrow =>
      match target_type_expr_arrow_wire_shape(node: node) {
        Accepted { value: TargetTypeExprArrowPositionalWire, diagnostics: v2.std.diagnostic.None } =>
          v2.std.diagnostic.Accepted { value: true, diagnostics: v2.std.diagnostic.None }
        Accepted { value: TargetTypeExprArrowLabeledWire, diagnostics: v2.std.diagnostic.None } =>
          outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
        Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
      }
    TargetTypeExprRecord =>
      outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
    TargetTypeExprSum =>
      outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
  }
}

fn target_type_expr_emitted_validate_positional_wire(
  node: v2.std.node.Node,
  kind: v2.std.compilers.target_model.TargetTypeExprKind,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection
) -> v2.std.diagnostic.Outcome<Bool> {
  match target_type_expr_emitted_kind(node: node) {
    TypeExprKindAuthority { value: decoded } =>
      if decoded == kind {
        match target_type_expr_fold_named_metadata_edges(node: node) {
          NamedMetadataFoldOk { kind_seen: true, surface_seen: true, extra_named: 0 } =>
            match target_type_expr_emitted_surface_identity(node: node) {
              Accepted { value: surface, diagnostics: d } =>
                if surface == target_type_expr_expected_surface_for_kind(kind: kind, projection: projection) {
                  match target_type_expr_emitted_validate_positional_arity(node: node, kind: kind) {
                    Accepted { value: true, diagnostics: d2 } =>
                      v2.std.diagnostic.Accepted { value: true, diagnostics: diagnostics_merge(outer: d, inner: d2) }
                    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
                  }
                } else {
                  outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
                }
              Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
            }
          _ => outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
        }
      } else {
        outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
      }
    TypeExprKindNotEmitted =>
      outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
    TypeExprKindAuthorityInvalid =>
      outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
  }
}

fn target_type_expr_emitted_validate_labeled_wire(
  node: v2.std.node.Node,
  kind: v2.std.compilers.target_model.TargetTypeExprKind,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection
) -> v2.std.diagnostic.Outcome<Bool> {
  if is_empty(xs: node_positional_child_targets(node: node)) {
    match target_type_expr_emitted_kind(node: node) {
      TypeExprKindAuthority { value: decoded } =>
        if decoded == kind {
          match target_type_expr_fold_named_metadata_edges(node: node) {
            NamedMetadataFoldOk { kind_seen: true, surface_seen: true, extra_named: _ } =>
              match target_type_expr_emitted_surface_identity(node: node) {
                Accepted { value: surface, diagnostics: d } =>
                  if surface == target_type_expr_expected_surface_for_kind(kind: kind, projection: projection) {
                    v2.std.diagnostic.Accepted { value: true, diagnostics: d }
                  } else {
                    outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
                  }
                Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
              }
            _ => outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
          }
        } else {
          outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
        }
      TypeExprKindNotEmitted =>
        outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
      TypeExprKindAuthorityInvalid =>
        outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
    }
  } else {
    outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
  }
}

fn target_type_expr_emitted_validate_wire_shape(
  node: v2.std.node.Node,
  kind: v2.std.compilers.target_model.TargetTypeExprKind,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection
) -> v2.std.diagnostic.Outcome<Bool> {
  match kind {
    TargetTypeExprRecord =>
      target_type_expr_emitted_validate_labeled_wire(
        node: node,
        kind: kind,
        projection: projection
      )
    TargetTypeExprSum =>
      target_type_expr_emitted_validate_labeled_wire(
        node: node,
        kind: kind,
        projection: projection
      )
    TargetTypeExprArrow =>
      match target_type_expr_arrow_wire_shape(node: node) {
        Accepted { value: TargetTypeExprArrowLabeledWire, diagnostics: v2.std.diagnostic.None } =>
          target_type_expr_emitted_validate_labeled_wire(
            node: node,
            kind: kind,
            projection: projection
          )
        Accepted { value: TargetTypeExprArrowPositionalWire, diagnostics: v2.std.diagnostic.None } =>
          target_type_expr_emitted_validate_positional_wire(
            node: node,
            kind: kind,
            projection: projection
          )
        Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
      }
    _ =>
      target_type_expr_emitted_validate_positional_wire(
        node: node,
        kind: kind,
        projection: projection
      )
  }
}

fn target_type_expr_emitted_wire_decode(
  node: v2.std.node.Node,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetTypeExpression> {
  match target_type_expr_emitted_kind(node: node) {
    TypeExprKindAuthority { value: kind } =>
      match target_type_expr_emitted_validate_wire_shape(
        node: node,
        kind: kind,
        projection: projection
      ) {
        Accepted { value: _, diagnostics: d } =>
          v2.std.diagnostic.Accepted {
            value: v2.std.compilers.target_model.TargetTypeExpression { kind: kind, node: node },
            diagnostics: d
          }
        Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
      }
    TypeExprKindNotEmitted =>
      outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
    TypeExprKindAuthorityInvalid =>
      outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
  }
}

fn target_type_expr_emitted_labeled_slot_nodes(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.node.Node>> {
  if is_empty(xs: node_positional_child_targets(node: node)) {
    v2.std.diagnostic.Accepted {
      value: target_type_expr_emitted_slot_type_nodes(node: node),
      diagnostics: v2.std.diagnostic.None
    }
  } else {
    outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
  }
}

fn target_type_expr_emitted_labeled_slot_edges(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.node.Edge>> {
  if is_empty(xs: node_positional_child_targets(node: node)) {
    v2.std.diagnostic.Accepted {
      value: fold(node.children, init: std.algebra.Empty, f: fn(acc, e) {
        match e.label {
          Named { name: n } =>
            if n == ^target_type_expr_field_surface || n == ^target_type_expr_field_kind {
              acc
            } else {
              list_snoc_item(xs: acc, item: e)
            }
          Positional => acc
        }
      }),
      diagnostics: v2.std.diagnostic.None
    }
  } else {
    outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
  }
}

fn target_type_expr_record_emitted(
  form: v2.std.compilers.target_model.TargetGenericApply,
  fields: v2.std.collection.List<v2.std.compilers.target_model.TargetTypeExprFieldSlot>
) -> v2.std.node.Node {
  target_type_expr_wrapped_emitted_labeled(
    kind: TargetTypeExprRecord,
    surface: form.surface,
    slot_edges: target_type_expr_field_slot_edges(fields: fields)
  )
}

fn target_type_expr_sum_emitted(
  form: v2.std.compilers.target_model.TargetSumTypeShape,
  variants: v2.std.collection.List<v2.std.compilers.target_model.TargetTypeExprVariantSlot>
) -> v2.std.node.Node {
  target_type_expr_wrapped_emitted_labeled(
    kind: TargetTypeExprSum,
    surface: form.surface,
    slot_edges: target_type_expr_variant_slot_edges(variants: variants)
  )
}

fn target_type_expr_arrow_emitted(
  form: v2.std.compilers.target_model.TargetFunctionTypeShape,
  inputs: v2.std.collection.List<v2.std.node.Node>,
  output: v2.std.node.Node
) -> v2.std.node.Node {
  target_type_expr_wrapped_emitted(
    kind: TargetTypeExprArrow,
    surface: form.surface,
    children: list_append(left: inputs, right: std.algebra.Cons { head: output, tail: std.algebra.Empty })
  )
}

fn target_type_expr_arrow_emitted_named(
  form: v2.std.compilers.target_model.TargetFunctionTypeShape,
  params: v2.std.collection.List<v2.std.compilers.target_model.TargetTypeExprArrowParamSlot>,
  output: v2.std.node.Node
) -> v2.std.node.Node {
  target_type_expr_wrapped_emitted_labeled(
    kind: TargetTypeExprArrow,
    surface: form.surface,
    slot_edges: list_append(
      left: target_type_expr_arrow_param_slot_edges(params: params),
      right: std.algebra.Cons {
        head: v2.std.node.Edge {
          label: Named { name: ^target_type_expr_field_codomain },
          target: output
        },
        tail: std.algebra.Empty
      }
    )
  )
}

fn target_type_expr_arrow_labeled_codomain(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match target_type_expr_arrow_wire_shape(node: node) {
    Accepted { value: TargetTypeExprArrowLabeledWire, diagnostics: d } =>
      match find_named_child(root: node, name: ^target_type_expr_field_codomain) {
        Accepted { value: child, diagnostics: dc } =>
          v2.std.diagnostic.Accepted {
            value: child,
            diagnostics: diagnostics_merge(outer: d, inner: dc)
          }
        Rejected { diagnostics: _ } =>
          outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
      }
    Accepted { value: TargetTypeExprArrowPositionalWire, diagnostics: _ } =>
      outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn target_type_expr_arrow_labeled_param_slots(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.TargetTypeExprArrowParamSlot>> {
  match target_type_expr_arrow_wire_shape(node: node) {
    Accepted { value: TargetTypeExprArrowLabeledWire, diagnostics: d } =>
      bind_outcome(
        o: target_type_expr_arrow_labeled_codomain(node: node),
        f: fn(_codomain) {
          if is_empty(xs: node_positional_child_targets(node: node)) {
            v2.std.diagnostic.Accepted {
              value: fold(
                xs: node_labeled_child_edges(node: node),
                init: std.algebra.Empty,
                f: fn(acc, e) {
                  match e.label {
                    Named { name: label } =>
                      if label == ^target_type_expr_field_surface ||
                        label == ^target_type_expr_field_kind ||
                        label == ^target_type_expr_field_codomain {
                        acc
                      } else {
                        list_snoc_item(
                          xs: acc,
                          item: v2.std.compilers.target_model.TargetTypeExprArrowParamSlot { label: label, type_expr: e.target }
                        )
                      }
                    Positional => acc
                  }
                }
              ),
              diagnostics: d
            }
          } else {
            outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
          }
        }
      )
    Accepted { value: TargetTypeExprArrowPositionalWire, diagnostics: _ } =>
      outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

type TargetCollectionReprKind
  = TargetCollectionReprBTreeSet
  | TargetCollectionReprHashSet
  | TargetCollectionReprVec

type TargetRepresentation {
  kind: v2.std.compilers.target_model.TargetCollectionReprKind
  apply: v2.std.compilers.target_model.TargetGenericApply
}

data target_collection_choice_field_representation_parameters: v2.std.node.Symbol = ^target_collection_choice_field_representation_parameters
data target_collection_choice_field_supplemental_generic_bound_contracts: v2.std.node.Symbol = ^target_collection_choice_field_supplemental_generic_bound_contracts
data target_derive_supplemental_generic_bound_contract_field_derive_trait: v2.std.node.Symbol = ^target_derive_supplemental_generic_bound_contract_field_derive_trait
data target_derive_supplemental_generic_bound_contract_field_authority: v2.std.node.Symbol = ^target_derive_supplemental_generic_bound_contract_field_authority
data target_derive_supplemental_generic_bound_contract_field_requirements: v2.std.node.Symbol = ^target_derive_supplemental_generic_bound_contract_field_requirements
data target_derive_supplemental_generic_bound_requirement_field_representation_parameter: v2.std.node.Symbol = ^target_derive_supplemental_generic_bound_requirement_field_representation_parameter
data target_derive_supplemental_generic_bound_requirement_field_required_trait: v2.std.node.Symbol = ^target_derive_supplemental_generic_bound_requirement_field_required_trait
data target_derive_supplemental_generic_bound_requirement_field_authority: v2.std.node.Symbol = ^target_derive_supplemental_generic_bound_requirement_field_authority
data target_external_authority_field_uri_scheme: v2.std.node.Symbol = ^target_external_authority_field_uri_scheme
data target_external_authority_field_uri_locator: v2.std.node.Symbol = ^target_external_authority_field_uri_locator

type RequiredTraitWitness
  = TargetCollectionWitnessOrd { type_param: v2.std.node.Symbol }
  | TargetCollectionWitnessHash { type_param: v2.std.node.Symbol }
  | TargetCollectionWitnessEq { type_param: v2.std.node.Symbol }

type TargetDeriveTraitKey = v2.std.node.Symbol where brand("TargetDeriveTraitKey")

type TargetDeriveSupplementalGenericBoundRequirementAuthority {
  authority: extdeps.external_authority.ExternalAuthority
}

type TargetDeriveSupplementalGenericBoundRequirementSet =
  std.types.Map<v2.std.compilers.target_model.TargetDeriveTraitKey, v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementAuthority>

type TargetRepresentationParameterSlot {}

type TargetDeriveSupplementalGenericBoundContractAuthority {
  authority: extdeps.external_authority.ExternalAuthority
  requirements: Map<v2.std.node.Symbol, v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementSet>
}

type TargetRepresentationChoice {
  form: v2.std.compilers.target_model.TargetRepresentation
  representation_parameters: Map<v2.std.node.Symbol, v2.std.compilers.target_model.TargetRepresentationParameterSlot>
  constraints: v2.std.collection.List<v2.std.compilers.target_model.RequiredTraitWitness>
  supplemental_generic_bound_contracts: Map<v2.std.compilers.target_model.TargetDeriveTraitKey, v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContractAuthority>
}

type TargetTextCarrier {
  element_carrier: v2.std.node.Node
  emitted_type_node: v2.std.node.Node
}

type TargetCollectionRealization {
  source_carrier: v2.std.node.Node
  primary: v2.std.compilers.target_model.TargetRepresentationChoice
  alternatives: v2.std.collection.List<v2.std.compilers.target_model.TargetRepresentationChoice>
  fallback_diagnostic: v2.std.diagnostic.Diagnostic
  text_carrier: Optional<v2.std.compilers.target_model.TargetTextCarrier>
}

type TargetDeriveSupplementalGenericBoundContract {
  derive_trait: std.trait_derive_shape.ReprGroundingDeriveTrait
  authority: extdeps.external_authority.ExternalAuthority
  requirements: Map<v2.std.node.Symbol, v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementSet>
}

type TargetDeriveSupplementalGenericBoundRequirementWire {
  representation_parameter: v2.std.node.Symbol
  required_trait: std.trait_derive_shape.ReprGroundingDeriveTrait
  authority: extdeps.external_authority.ExternalAuthority
}

type TargetDeriveSupplementalGenericBoundContractWire {
  derive_trait: std.trait_derive_shape.ReprGroundingDeriveTrait
  authority: extdeps.external_authority.ExternalAuthority
  requirements: v2.std.collection.List<v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementWire>
}

type TargetDeriveSupplementalGenericBoundContractCatalog {
  representation_parameters: Map<v2.std.node.Symbol, v2.std.compilers.target_model.TargetRepresentationParameterSlot>
  contracts: Map<v2.std.compilers.target_model.TargetDeriveTraitKey, v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContractAuthority>
}

fn target_grounding_derive_trait_discriminant(
  derive_trait: std.trait_derive_shape.ReprGroundingDeriveTrait
) -> v2.std.node.Symbol {
  discriminant(v: derive_trait)
}

fn target_grounding_derive_trait_key(
  derive_trait: std.trait_derive_shape.ReprGroundingDeriveTrait
) -> v2.std.compilers.target_model.TargetDeriveTraitKey {
  target_grounding_derive_trait_discriminant(derive_trait: derive_trait)
}

fn target_derive_supplemental_generic_bound_requirement_set_empty() -> v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementSet {
  empty_map()
}

fn target_derive_supplemental_generic_bound_contract_requirements_empty() -> std.types.Map<v2.std.node.Symbol, v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementSet> {
  empty_map()
}

fn target_representation_parameter_slot_empty() -> v2.std.compilers.target_model.TargetRepresentationParameterSlot {
  TargetRepresentationParameterSlot {}
}

fn target_representation_parameter_slots_empty() -> std.types.Map<v2.std.node.Symbol, v2.std.compilers.target_model.TargetRepresentationParameterSlot> {
  empty_map()
}

fn target_derive_supplemental_generic_bound_contract_authorities_empty() -> std.types.Map<v2.std.compilers.target_model.TargetDeriveTraitKey, v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContractAuthority> {
  empty_map()
}

fn target_derive_supplemental_generic_bound_contract_authority_insert_with_requirements(
  contracts: Map<v2.std.compilers.target_model.TargetDeriveTraitKey, v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContractAuthority>,
  derive_trait: std.trait_derive_shape.ReprGroundingDeriveTrait,
  authority: extdeps.external_authority.ExternalAuthority,
  requirements: Map<v2.std.node.Symbol, v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementSet>
) -> std.types.Map<v2.std.compilers.target_model.TargetDeriveTraitKey, v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContractAuthority> {
  map_insert(
    m: contracts,
    key: target_grounding_derive_trait_key(derive_trait: derive_trait),
    value: v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContractAuthority {
      authority: authority,
      requirements: requirements
    }
  )
}

fn target_derive_supplemental_generic_bound_contract_authority_insert(
  contracts: Map<v2.std.compilers.target_model.TargetDeriveTraitKey, v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContractAuthority>,
  derive_trait: std.trait_derive_shape.ReprGroundingDeriveTrait,
  authority: extdeps.external_authority.ExternalAuthority
) -> std.types.Map<v2.std.compilers.target_model.TargetDeriveTraitKey, v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContractAuthority> {
  target_derive_supplemental_generic_bound_contract_authority_insert_with_requirements(
    contracts: contracts,
    derive_trait: derive_trait,
    authority: authority,
    requirements: target_derive_supplemental_generic_bound_contract_requirements_empty()
  )
}

fn target_derive_supplemental_generic_bound_contract_choice_malformed_diagnostic(
  at: v2.std.node.Node
) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_derive_supplemental_generic_bound_contract_choice_malformed,
    at: node_locus(node: at),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_uri_scheme_discriminant(scheme: v2.std.network.UriScheme) -> v2.std.node.Symbol {
  discriminant(v: scheme)
}

fn target_external_authority_bundle_node(authority: extdeps.external_authority.ExternalAuthority) -> v2.std.node.Node {
  target_model_type_conj_node(
    children: [
      target_model_named_edge(
        name: ^target_external_authority_field_uri_scheme,
        target: target_model_type_atom_node(
          identity: target_uri_scheme_discriminant(scheme: authority.uri.scheme)
        )
      ),
      target_model_named_edge(
        name: ^target_external_authority_field_uri_locator,
        target: target_model_type_atom_node(
          identity: symbol_intern_lexeme(lexeme: authority.uri.locator)
        )
      )
    ]
  )
}

fn target_external_authority_from_node(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<extdeps.external_authority.ExternalAuthority> {
  if count(node.children) == 2 {
    bind_outcome(
      o: find_named_child(
        root: node,
        name: ^target_external_authority_field_uri_scheme
      ),
      f: fn(scheme_node) {
        bind_outcome(
          o: target_collection_node_atom_identity(node: scheme_node),
          f: fn(scheme_id) {
            bind_outcome(
              o: coproduct_nullary_inhabitant_by_discriminant(
                type_name: ^UriScheme,
                discriminant_of: target_uri_scheme_discriminant,
                wanted: scheme_id
              ),
              f: fn(scheme) {
                bind_outcome(
                  o: find_named_child(
                    root: node,
                    name: ^target_external_authority_field_uri_locator
                  ),
                  f: fn(locator_node) {
                    bind_outcome(
                      o: target_collection_node_atom_identity(node: locator_node),
                      f: fn(locator_id) {
                        outcome_accepted(
                          extdeps.external_authority.ExternalAuthority {
                            uri: extdeps.uri.Uri {
                              scheme: scheme,
                              locator: symbol_lexeme(sym: locator_id)
                            }
                          }
                        )
                      }
                    )
                  }
                )
              }
            )
          }
        )
      }
    )
  } else {
    outcome_rejected(
      target_derive_supplemental_generic_bound_contract_choice_malformed_diagnostic(
        at: node
      )
    )
  }
}

fn target_grounding_derive_trait_from_node(
  node: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<std.trait_derive_shape.ReprGroundingDeriveTrait> {
  bind_outcome(
    o: target_collection_node_atom_identity(node: node),
    f: fn(derive_trait_id) {
      coproduct_nullary_inhabitant_by_discriminant(
        type_name: ^ReprGroundingDeriveTrait,
        discriminant_of: target_grounding_derive_trait_discriminant,
        wanted: derive_trait_id
      )
    }
  )
}

fn target_derive_supplemental_generic_bound_requirement_wire_node(
  representation_parameter: v2.std.node.Symbol,
  required_trait: std.trait_derive_shape.ReprGroundingDeriveTrait,
  authority: extdeps.external_authority.ExternalAuthority
) -> v2.std.node.Node {
  target_model_type_conj_node(
    children: [
      target_model_named_edge(
        name: ^target_derive_supplemental_generic_bound_requirement_field_representation_parameter,
        target: target_model_type_atom_node(identity: representation_parameter)
      ),
      target_model_named_edge(
        name: ^target_derive_supplemental_generic_bound_requirement_field_required_trait,
        target: target_model_type_atom_node(
          identity: target_grounding_derive_trait_discriminant(
            derive_trait: required_trait
          )
        )
      ),
      target_model_named_edge(
        name: ^target_derive_supplemental_generic_bound_requirement_field_authority,
        target: target_external_authority_bundle_node(authority: authority)
      )
    ]
  )
}

fn target_derive_supplemental_generic_bound_contract_wire_node(
  derive_trait: std.trait_derive_shape.ReprGroundingDeriveTrait,
  authority: extdeps.external_authority.ExternalAuthority,
  requirement_nodes: v2.std.collection.List<v2.std.node.Node>
) -> v2.std.node.Node {
  target_model_type_conj_node(
    children: [
      target_model_named_edge(
        name: ^target_derive_supplemental_generic_bound_contract_field_derive_trait,
        target: target_model_type_atom_node(
          identity: target_grounding_derive_trait_discriminant(
            derive_trait: derive_trait
          )
        )
      ),
      target_model_named_edge(
        name: ^target_derive_supplemental_generic_bound_contract_field_authority,
        target: target_external_authority_bundle_node(authority: authority)
      ),
      target_model_named_edge(
        name: ^target_derive_supplemental_generic_bound_contract_field_requirements,
        target: fold_list_node(
          xs: requirement_nodes,
          item_node: fn(requirement_node) { requirement_node }
        )
      )
    ]
  )
}

fn target_derive_supplemental_generic_bound_requirement_wire_from_node(
  node: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementWire> {
  if count(node.children) == 3 {
    bind_outcome(
      o: find_named_child(
        root: node,
        name: ^target_derive_supplemental_generic_bound_requirement_field_representation_parameter
      ),
      f: fn(parameter_node) {
        bind_outcome(
          o: target_collection_node_atom_identity(node: parameter_node),
          f: fn(representation_parameter) {
            bind_outcome(
              o: find_named_child(
                root: node,
                name: ^target_derive_supplemental_generic_bound_requirement_field_required_trait
              ),
              f: fn(required_trait_node) {
                bind_outcome(
                  o: target_grounding_derive_trait_from_node(
                    node: required_trait_node
                  ),
                  f: fn(required_trait) {
                    bind_outcome(
                      o: find_named_child(
                        root: node,
                        name: ^target_derive_supplemental_generic_bound_requirement_field_authority
                      ),
                      f: fn(authority_node) {
                        bind_outcome(
                          o: target_external_authority_from_node(
                            node: authority_node
                          ),
                          f: fn(authority) {
                            outcome_accepted(
                              TargetDeriveSupplementalGenericBoundRequirementWire {
                                representation_parameter: representation_parameter,
                                required_trait: required_trait,
                                authority: authority
                              }
                            )
                          }
                        )
                      }
                    )
                  }
                )
              }
            )
          }
        )
      }
    )
  } else {
    outcome_rejected(
      target_derive_supplemental_generic_bound_contract_choice_malformed_diagnostic(
        at: node
      )
    )
  }
}

fn target_derive_supplemental_generic_bound_contract_wire_from_node(
  node: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContractWire> {
  if count(node.children) == 3 {
    bind_outcome(
      o: find_named_child(
        root: node,
        name: ^target_derive_supplemental_generic_bound_contract_field_derive_trait
      ),
      f: fn(derive_trait_node) {
        bind_outcome(
          o: target_grounding_derive_trait_from_node(node: derive_trait_node),
          f: fn(derive_trait) {
            bind_outcome(
              o: find_named_child(
                root: node,
                name: ^target_derive_supplemental_generic_bound_contract_field_authority
              ),
              f: fn(authority_node) {
                bind_outcome(
                  o: target_external_authority_from_node(node: authority_node),
                  f: fn(authority) {
                    bind_outcome(
                      o: find_named_child(
                        root: node,
                        name: ^target_derive_supplemental_generic_bound_contract_field_requirements
                      ),
                      f: fn(requirements_node) {
                        bind_outcome(
                          o: node_list_from_node(
                            node: requirements_node,
                            decode_item: target_derive_supplemental_generic_bound_requirement_wire_from_node
                          ),
                          f: fn(requirements) {
                            outcome_accepted(
                              TargetDeriveSupplementalGenericBoundContractWire {
                                derive_trait: derive_trait,
                                authority: authority,
                                requirements: requirements
                              }
                            )
                          }
                        )
                      }
                    )
                  }
                )
              }
            )
          }
        )
      }
    )
  } else {
    outcome_rejected(
      target_derive_supplemental_generic_bound_contract_choice_malformed_diagnostic(
        at: node
      )
    )
  }
}

fn target_representation_parameter_slots_from_node(
  node: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<Map<v2.std.node.Symbol, v2.std.compilers.target_model.TargetRepresentationParameterSlot>> {
  bind_outcome(
    o: node_list_from_node(
      node: node,
      decode_item: target_collection_node_atom_identity
    ),
    f: fn(parameters) {
      fold_list(
        xs: parameters,
        empty: outcome_accepted(
          target_representation_parameter_slots_empty()
        ),
        cons: fn(acc, parameter) {
          match acc {
            Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
            Accepted { value: slots, diagnostics: _ } =>
              match slots.lookup(parameter) {
                Present { value: _ } =>
                  outcome_rejected(
                    target_derive_supplemental_generic_bound_contract_choice_malformed_diagnostic(
                      at: node
                    )
                  )
                Absent =>
                  outcome_accepted(
                    map_insert(
                      m: slots,
                      key: parameter,
                      value: target_representation_parameter_slot_empty()
                    )
                  )
              }
          }
        }
      )
    }
  )
}

fn target_derive_supplemental_generic_bound_contract_requirements_for_parameter(
  requirements: Map<v2.std.node.Symbol, v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementSet>,
  representation_parameter: v2.std.node.Symbol
) -> v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementSet {
  match requirements.lookup(representation_parameter) {
    Present { value: existing } => existing
    Absent => target_derive_supplemental_generic_bound_requirement_set_empty()
  }
}

fn target_derive_supplemental_generic_bound_contract_requirements_insert(
  requirements: Map<v2.std.node.Symbol, v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementSet>,
  representation_parameter: v2.std.node.Symbol,
  required_key: v2.std.compilers.target_model.TargetDeriveTraitKey,
  parameter_requirements: v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementSet,
  authority: extdeps.external_authority.ExternalAuthority
) -> std.types.Map<v2.std.node.Symbol, v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementSet> {
  map_insert(
    m: requirements,
    key: representation_parameter,
    value: map_insert(
      m: parameter_requirements,
      key: required_key,
      value: v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementAuthority {
        authority: authority
      }
    )
  )
}

fn target_derive_supplemental_generic_bound_wire_requirement_apply(
  acc: v2.std.diagnostic.Outcome<Map<v2.std.node.Symbol, v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementSet>>,
  representation_parameters: Map<v2.std.node.Symbol, v2.std.compilers.target_model.TargetRepresentationParameterSlot>,
  requirement: v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementWire,
  at: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<Map<v2.std.node.Symbol, v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementSet>> {
  match acc {
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
    Accepted { value: requirements, diagnostics: _ } =>
      match representation_parameters.lookup(requirement.representation_parameter) {
        Absent =>
          outcome_rejected(
            target_derive_supplemental_generic_bound_contract_choice_malformed_diagnostic(
              at: at
            )
          )
        Present { value: _ } =>
          let required_key = target_grounding_derive_trait_key(
            derive_trait: requirement.required_trait
          )
          let parameter_requirements = target_derive_supplemental_generic_bound_contract_requirements_for_parameter(
            requirements: requirements,
            representation_parameter: requirement.representation_parameter
          )
          match parameter_requirements.lookup(required_key) {
            Present { value: _ } =>
              outcome_rejected(
                target_derive_supplemental_generic_bound_contract_choice_malformed_diagnostic(
                  at: at
                )
              )
            Absent =>
              outcome_accepted(
                target_derive_supplemental_generic_bound_contract_requirements_insert(
                  requirements: requirements,
                  representation_parameter: requirement.representation_parameter,
                  required_key: required_key,
                  parameter_requirements: parameter_requirements,
                  authority: requirement.authority
                )
              )
          }
      }
  }
}

fn target_derive_supplemental_generic_bound_wire_requirements_apply(
  representation_parameters: Map<v2.std.node.Symbol, v2.std.compilers.target_model.TargetRepresentationParameterSlot>,
  requirements: v2.std.collection.List<v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementWire>,
  at: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<Map<v2.std.node.Symbol, v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementSet>> {
  fold_list(
    xs: requirements,
    empty: outcome_accepted(
      target_derive_supplemental_generic_bound_contract_requirements_empty()
    ),
    cons: fn(acc, requirement) {
      target_derive_supplemental_generic_bound_wire_requirement_apply(
        acc: acc,
        representation_parameters: representation_parameters,
        requirement: requirement,
        at: at
      )
    }
  )
}

fn target_derive_supplemental_generic_bound_contract_catalog_insert_wire(
  acc: v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContractCatalog>,
  row: v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContractWire,
  at: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContractCatalog> {
  match acc {
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
    Accepted { value: catalog, diagnostics: _ } =>
      let derive_key = target_grounding_derive_trait_key(
        derive_trait: row.derive_trait
      )
      match catalog.contracts.lookup(derive_key) {
        Present { value: _ } =>
          outcome_rejected(
            target_derive_supplemental_generic_bound_contract_choice_malformed_diagnostic(
              at: at
            )
          )
        Absent =>
          bind_outcome(
            o: target_derive_supplemental_generic_bound_wire_requirements_apply(
              representation_parameters: catalog.representation_parameters,
              requirements: row.requirements,
              at: at
            ),
            f: fn(requirements) {
              outcome_accepted(
                TargetDeriveSupplementalGenericBoundContractCatalog {
                  representation_parameters: catalog.representation_parameters,
                  contracts: map_insert(
                    m: catalog.contracts,
                    key: derive_key,
                    value: v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContractAuthority {
                      authority: row.authority,
                      requirements: requirements
                    }
                  )
                }
              )
            }
          )
      }
  }
}

fn target_derive_supplemental_generic_bound_contract_catalog_from_node(
  representation_parameters: Map<v2.std.node.Symbol, v2.std.compilers.target_model.TargetRepresentationParameterSlot>,
  node: v2.std.node.Node,
  at: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContractCatalog> {
  bind_outcome(
    o: node_list_from_node(
      node: node,
      decode_item: target_derive_supplemental_generic_bound_contract_wire_from_node
    ),
    f: fn(rows) {
      fold_list(
        xs: rows,
        empty: outcome_accepted(
          TargetDeriveSupplementalGenericBoundContractCatalog {
            representation_parameters: representation_parameters,
            contracts: target_derive_supplemental_generic_bound_contract_authorities_empty()
          }
        ),
        cons: fn(acc, row) {
          target_derive_supplemental_generic_bound_contract_catalog_insert_wire(
            acc: acc,
            row: row,
            at: at
          )
        }
      )
    }
  )
}

fn target_derive_supplemental_generic_bound_requirement_nodes_for_contract(
  contract_authority: v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContractAuthority
) -> v2.std.collection.List<v2.std.node.Node> {
  fold_list(
    xs: contract_authority.requirements.keys(),
    empty: std.algebra.Empty,
    cons: fn(acc, representation_parameter) {
      match contract_authority.requirements.lookup(representation_parameter) {
        Absent => acc
        Present { value: requirements } =>
          fold_list(
            xs: requirements.keys(),
            empty: acc,
            cons: fn(requirement_acc, required_key) {
              match requirements.lookup(required_key) {
                Absent => requirement_acc
                Present { value: requirement_authority } =>
                  list_snoc_item(
                    xs: requirement_acc,
                    item: target_model_type_conj_node(
                      children: [
                        target_model_named_edge(
                          name: ^target_derive_supplemental_generic_bound_requirement_field_representation_parameter,
                          target: target_model_type_atom_node(
                            identity: representation_parameter
                          )
                        ),
                        target_model_named_edge(
                          name: ^target_derive_supplemental_generic_bound_requirement_field_required_trait,
                          target: target_model_type_atom_node(
                            identity: required_key
                          )
                        ),
                        target_model_named_edge(
                          name: ^target_derive_supplemental_generic_bound_requirement_field_authority,
                          target: target_external_authority_bundle_node(
                            authority: requirement_authority.authority
                          )
                        )
                      ]
                    )
                  )
              }
            }
          )
      }
    }
  )
}

fn target_derive_supplemental_generic_bound_contract_node_from_key(
  derive_key: v2.std.compilers.target_model.TargetDeriveTraitKey,
  contract_authority: v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContractAuthority
) -> v2.std.node.Node {
  target_model_type_conj_node(
    children: [
      target_model_named_edge(
        name: ^target_derive_supplemental_generic_bound_contract_field_derive_trait,
        target: target_model_type_atom_node(identity: derive_key)
      ),
      target_model_named_edge(
        name: ^target_derive_supplemental_generic_bound_contract_field_authority,
        target: target_external_authority_bundle_node(
          authority: contract_authority.authority
        )
      ),
      target_model_named_edge(
        name: ^target_derive_supplemental_generic_bound_contract_field_requirements,
        target: fold_list_node(
          xs: target_derive_supplemental_generic_bound_requirement_nodes_for_contract(
            contract_authority: contract_authority
          ),
          item_node: fn(requirement_node) { requirement_node }
        )
      )
    ]
  )
}

fn target_representation_choice_parameters_bundle_node(
  choice: v2.std.compilers.target_model.TargetRepresentationChoice
) -> v2.std.node.Node {
  fold_list_node(
    xs: choice.representation_parameters.keys(),
    item_node: target_model_type_atom_node
  )
}

fn target_representation_choice_supplemental_generic_bound_contracts_bundle_node(
  choice: v2.std.compilers.target_model.TargetRepresentationChoice
) -> v2.std.node.Node {
  fold_list_node(
    xs: fold_list(
      xs: choice.supplemental_generic_bound_contracts.keys(),
      empty: std.algebra.Empty,
      cons: fn(acc, derive_key) {
        match choice.supplemental_generic_bound_contracts.lookup(derive_key) {
          Absent => acc
          Present { value: contract_authority } =>
            list_snoc_item(
              xs: acc,
              item: target_derive_supplemental_generic_bound_contract_node_from_key(
                derive_key: derive_key,
                contract_authority: contract_authority
              )
            )
        }
      }
    ),
    item_node: fn(contract_node) { contract_node }
  )
}

fn target_derive_supplemental_generic_bound_requirement_authority(
  contract: v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContract,
  representation_parameter: v2.std.node.Symbol,
  required_trait: std.trait_derive_shape.ReprGroundingDeriveTrait
) -> v2.std.optional.Optional<extdeps.external_authority.ExternalAuthority> {
  match contract.requirements.lookup(representation_parameter) {
    Absent => Absent
    Present { value: requirements } =>
      match requirements.lookup(
        target_grounding_derive_trait_key(derive_trait: required_trait)
      ) {
        Absent => Absent
        Present { value: row } => Present { value: row.authority }
      }
  }
}

fn target_derive_supplemental_generic_bound_contract_lookup_miss_diagnostic(
  source_carrier: v2.std.node.Node
) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_derive_supplemental_generic_bound_contract_lookup_miss,
    at: node_locus(node: source_carrier),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_derive_supplemental_generic_bound_contract_lookup_in_choice(
  choice: v2.std.compilers.target_model.TargetRepresentationChoice,
  source_carrier: v2.std.node.Node,
  derive_trait: std.trait_derive_shape.ReprGroundingDeriveTrait
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContract> {
  let derive_key = target_grounding_derive_trait_key(derive_trait: derive_trait)
  match choice.supplemental_generic_bound_contracts.lookup(derive_key) {
    Absent =>
      outcome_rejected(
        target_derive_supplemental_generic_bound_contract_lookup_miss_diagnostic(
          source_carrier: source_carrier
        )
      )
    Present { value: contract_authority } =>
      outcome_accepted(
        TargetDeriveSupplementalGenericBoundContract {
          derive_trait: derive_trait,
          authority: contract_authority.authority,
          requirements: contract_authority.requirements
        }
      )
  }
}

fn target_collection_set_no_representation_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_collection_set_no_representation,
    at: port_locus(port: ^target_collection_set_no_representation_port),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_collection_free_monoid_no_representation_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_collection_free_monoid_no_representation,
    at: port_locus(port: ^target_collection_free_monoid_no_representation_port),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_collection_realization_lookup_miss_diagnostic(source_carrier: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_collection_realization_lookup_miss,
    at: node_locus(node: source_carrier),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_collection_realization_lookup_ambiguous_diagnostic(source_carrier: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_collection_realization_lookup_ambiguous,
    at: node_locus(node: source_carrier),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

type TargetCollectionRealizationLookup
  = TargetCollectionRealizationMissing
  | TargetCollectionRealizationUnique { row: v2.std.compilers.target_model.TargetCollectionRealization }
  | TargetCollectionRealizationAmbiguous

fn target_collection_realization_lookup_step(
  acc: v2.std.compilers.target_model.TargetCollectionRealizationLookup,
  row: v2.std.compilers.target_model.TargetCollectionRealization,
  source_carrier: v2.std.node.Node
) -> v2.std.compilers.target_model.TargetCollectionRealizationLookup {
  if content_hash(n: row.source_carrier) == content_hash(n: source_carrier) {
    match acc {
      TargetCollectionRealizationMissing => TargetCollectionRealizationUnique { row: row }
      TargetCollectionRealizationUnique { row: _ } => TargetCollectionRealizationAmbiguous
      TargetCollectionRealizationAmbiguous => TargetCollectionRealizationAmbiguous
    }
  } else {
    acc
  }
}

fn target_collection_realization_lookup_in_catalog(
  catalog: FreeMonoid<v2.std.compilers.target_model.TargetCollectionRealization>,
  source_carrier: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetCollectionRealization> {
  match fold_list(
    xs: catalog,
    empty: TargetCollectionRealizationMissing,
    cons: fn(acc, row) {
      target_collection_realization_lookup_step(
        acc: acc,
        row: row,
        source_carrier: source_carrier
      )
    }
  ) {
    TargetCollectionRealizationMissing =>
      outcome_rejected(target_collection_realization_lookup_miss_diagnostic(source_carrier: source_carrier))
    TargetCollectionRealizationUnique { row: row } => outcome_accepted(row)
    TargetCollectionRealizationAmbiguous =>
      outcome_rejected(target_collection_realization_lookup_ambiguous_diagnostic(source_carrier: source_carrier))
  }
}

fn target_collection_set_carrier_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^target_collection_set_carrier } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn target_collection_repr_kind_from_atom(id: v2.std.node.Symbol) -> v2.std.optional.Optional<v2.std.compilers.target_model.TargetCollectionReprKind> {
  if id == discriminant(v: TargetCollectionReprBTreeSet) {
    optional_present(value: TargetCollectionReprBTreeSet)
  } else {
    if id == discriminant(v: TargetCollectionReprHashSet) {
      optional_present(value: TargetCollectionReprHashSet)
    } else {
      if id == discriminant(v: TargetCollectionReprVec) {
        optional_present(value: TargetCollectionReprVec)
      } else {
        optional_absent()
      }
    }
  }
}

fn target_collection_node_atom_identity(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Symbol> {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } => outcome_accepted(id)
    _ => outcome_rejected(target_collection_shape_malformed_diagnostic(node: node))
  }
}

fn target_collection_repr_from_node(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetRepresentation> {
  bind_outcome(
    o: find_named_child(root: node, name: ^target_collection_repr_field_kind),
    f: fn(kind_node) {
      bind_outcome(
        o: target_collection_node_atom_identity(node: kind_node),
        f: fn(kind_sym) {
          match target_collection_repr_kind_from_atom(id: kind_sym) {
            Present { value: kind } =>
              bind_outcome(
                o: find_named_child(root: node, name: ^target_collection_repr_field_apply),
                f: fn(apply_node) {
                  bind_outcome(
                    o: decode_generic_apply_shape_bundle(bundle: apply_node),
                    f: fn(apply) {
                      outcome_accepted(
                        TargetRepresentation { kind: kind, apply: apply }
                      )
                    }
                  )
                }
              )
            Absent =>
              outcome_rejected(target_collection_shape_malformed_diagnostic(node: node))
          }
        }
      )
    }
  )
}

fn target_derive_supplemental_generic_bound_contract_lookup_in_realization(
  row: v2.std.compilers.target_model.TargetCollectionRealization,
  elem: v2.std.node.Node,
  derive_trait: std.trait_derive_shape.ReprGroundingDeriveTrait
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContract> {
  match target_collection_select_choice(
    primary: row.primary,
    alternatives: row.alternatives,
    elem: elem
  ) {
    Present { value: choice } =>
      target_derive_supplemental_generic_bound_contract_lookup_in_choice(
        choice: choice,
        source_carrier: row.source_carrier,
        derive_trait: derive_trait
      )
    Absent => outcome_rejected(row.fallback_diagnostic)
  }
}

fn target_collection_witness_from_node(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.RequiredTraitWitness> {
  bind_outcome(
    o: find_named_child(root: node, name: ^target_collection_witness_field_trait_name),
    f: fn(trait_node) {
      bind_outcome(
        o: target_collection_node_atom_identity(node: trait_node),
        f: fn(trait_name) {
          bind_outcome(
            o: find_named_child(root: node, name: ^target_collection_witness_field_type_param),
            f: fn(param_node) {
              bind_outcome(
                o: target_collection_node_atom_identity(node: param_node),
                f: fn(type_param) {
                  if trait_name == ^target_collection_trait_ord {
                    outcome_accepted(
                      TargetCollectionWitnessOrd { type_param: type_param }
                    )
                  } else {
                    if trait_name == ^target_collection_trait_hash {
                      outcome_accepted(
                        TargetCollectionWitnessHash { type_param: type_param }
                      )
                    } else {
                      if trait_name == ^target_collection_trait_eq {
                        outcome_accepted(
                          TargetCollectionWitnessEq { type_param: type_param }
                        )
                      } else {
                        outcome_rejected(
                          target_collection_shape_malformed_diagnostic(node: node)
                        )
                      }
                    }
                  }
                }
              )
            }
          )
        }
      )
    }
  )
}

fn target_collection_fallback_from_node(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.diagnostic.Diagnostic> {
  bind_outcome(
    o: target_collection_node_atom_identity(node: node),
    f: fn(reason) {
      if reason == ^target_collection_set_no_representation {
        outcome_accepted(target_collection_set_no_representation_diagnostic())
      } else {
        if reason == ^target_collection_free_monoid_no_representation {
          outcome_accepted(target_collection_free_monoid_no_representation_diagnostic())
        } else {
          outcome_rejected(target_collection_shape_malformed_diagnostic(node: node))
        }
      }
    }
  )
}

fn target_collection_element_ord_eligible(elem: v2.std.node.Node) -> Bool {
  match elem.kind {
    TypeNode { connective: Atom { identity: id } } =>
      id == ^target_collection_kernel_string
        || id == ^target_collection_kernel_int
        || id == ^target_collection_kernel_bool
        || id == ^target_collection_kernel_unit
    _ => false
  }
}

fn target_collection_element_hash_eligible(elem: v2.std.node.Node) -> Bool {
  target_collection_element_ord_eligible(elem: elem)
}

fn target_collection_element_eq_eligible(elem: v2.std.node.Node) -> Bool {
  target_collection_element_hash_eligible(elem: elem)
}

fn target_collection_trait_witness_satisfied(
  witness: v2.std.compilers.target_model.RequiredTraitWitness,
  elem: v2.std.node.Node
) -> Bool {
  match witness {
    TargetCollectionWitnessOrd { type_param: _ } =>
      target_collection_element_ord_eligible(elem: elem)
    TargetCollectionWitnessHash { type_param: _ } =>
      target_collection_element_hash_eligible(elem: elem)
    TargetCollectionWitnessEq { type_param: _ } =>
      target_collection_element_eq_eligible(elem: elem)
  }
}

fn target_collection_choice_constraints_satisfied(
  choice: v2.std.compilers.target_model.TargetRepresentationChoice,
  elem: v2.std.node.Node
) -> Bool {
  fold_list(
    xs: choice.constraints,
    empty: true,
    cons: fn(acc, witness) {
      acc && target_collection_trait_witness_satisfied(witness: witness, elem: elem)
    }
  )
}

fn target_collection_select_choice(
  primary: v2.std.compilers.target_model.TargetRepresentationChoice,
  alternatives: v2.std.collection.List<v2.std.compilers.target_model.TargetRepresentationChoice>,
  elem: v2.std.node.Node
) -> v2.std.optional.Optional<v2.std.compilers.target_model.TargetRepresentationChoice> {
  if target_collection_choice_constraints_satisfied(choice: primary, elem: elem) {
    optional_present(value: primary)
  } else {
    fold(alternatives, init: optional_absent(), f: fn(acc, choice) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          if target_collection_choice_constraints_satisfied(choice: choice, elem: elem) {
            optional_present(value: choice)
          } else {
            optional_absent()
          }
      }
    })
  }
}

fn target_collection_set_carrier_head(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  list_at_optional(xs: node_positional_child_targets(node: node), index: 0)
}

fn target_collection_type_node_is_set_carrier(node: v2.std.node.Node) -> Bool {
  match node.kind {
    TypeNode { connective: Cardinality } =>
      match target_collection_set_carrier_head(node: node) {
        Present { value: head } =>
          match head.kind {
            TypeNode { connective: Atom { identity: id } } => id == ^target_collection_set_carrier
            _ => false
          }
        Absent => false
      }
    _ => false
  }
}

fn target_collection_set_element_type_node(set_node: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  list_at_optional(xs: node_positional_child_targets(node: set_node), index: 1)
}

fn target_collection_free_monoid_carrier_head(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  list_at_optional(xs: node_positional_child_targets(node: node), index: 0)
}

fn target_collection_type_node_is_free_monoid_carrier(node: v2.std.node.Node) -> Bool {
  match node.kind {
    TypeNode { connective: Instantiation } =>
      match target_collection_free_monoid_carrier_head(node: node) {
        Present { value: head } =>
          match head.kind {
            TypeNode { connective: Atom { identity: id } } =>
              id == ^target_carrier_free_monoid
            _ => false
          }
        Absent => false
      }
    _ => false
  }
}

fn target_collection_free_monoid_element_type_node(free_monoid_node: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  let positional = node_positional_child_targets(node: free_monoid_node)
  if length(xs: positional) == 2 {
    list_at_optional(xs: positional, index: 1)
  } else {
    optional_absent()
  }
}

type TargetOwnershipUseSite
  = OwnershipAtFunctionReturn
  | OwnershipAtFunctionParameter
  | OwnershipAtStructField
  | OwnershipAtBindingProjection

type TargetReferenceLayer
  = ReferenceLayerOwned
  | ReferenceLayerRc
  | ReferenceLayerBox

// The two grounded axes a reference layer is made of. TargetReferenceLayer enumerates the three
// layers a target spells, but "Rc" and "Box" are not atoms: each is a pair of independent facts,
// and every question anyone asks of a layer is really a question about one of the two. Modeling
// them separately is what lets the transition below be DERIVED from the layers rather than
// hand-enumerated over them -- nine pairs authored by hand is nine chances to author one wrong,
// and the ninth is exactly the arm nobody writes a witness for.
// It is also what leaves room for Arc without widening anything: Arc differs from Rc on a THREAD
// axis, not on indirection or sharing, so it enters as a third fact on this record and every arm
// below keeps its answer. That is the design's own open question (the floor_materialization P2
// note wants Arc for cross-process ResolvedGraph sharing) answered structurally in advance rather
// than deferred to a migration.
type TargetIndirection
  = IndirectionDirect
  | IndirectionIndirect

type TargetSharing
  = SharingUnique
  | SharingShared

type TargetReferenceLayerFacts {
  indirection: TargetIndirection
  sharing: TargetSharing
}

// The single authority for what each layer IS. Every arm below reads this and nothing else, so a
// layer's facts are stated once rather than re-decided per question.
fn target_reference_layer_facts(layer: TargetReferenceLayer) -> TargetReferenceLayerFacts {
  match layer {
    ReferenceLayerOwned =>
      TargetReferenceLayerFacts {
        indirection: IndirectionDirect,
        sharing: SharingUnique
      }
    ReferenceLayerBox =>
      TargetReferenceLayerFacts {
        indirection: IndirectionIndirect,
        sharing: SharingUnique
      }
    ReferenceLayerRc =>
      TargetReferenceLayerFacts {
        indirection: IndirectionIndirect,
        sharing: SharingShared
      }
  }
}

// Why a transition can be refused. Two distinct causes, kept apart because their remedies differ
// and collapsing them would be the state-space conflation DESIGN section 5 names.
//
// SharedValueDuplication: the source is shared and the destination is unique. The only realization
// is to clone the pointee, which produces a SECOND value where the program had one. Every other
// holder of the shared handle keeps observing the original, so any later write through either side
// diverges silently. This is unconvertible in the strong sense -- not missing work, but a
// conversion that would have to destroy the identity the sharing exists to express.
//
// UniqueIndirectionResharing: unique indirection to shared indirection (Box to Rc). This one is
// refused for a WEAKER reason and the difference is worth carrying in the type rather than hiding
// behind one cause: it is meaning-preserving in principle -- the box is unique, so no other holder
// exists to disagree -- but no grounded realization for it is cited anywhere in the target model
// today, and the emitted corpus that motivated this carrier contains no instance of the pair.
// Deriving it on the strength of "a target language happens to offer a conversion" would be
// reaching past the model into one realization's convenience, which is the layer inversion DESIGN
// section 3 forbids. So it refuses, loudly and with its own name, and dissolves the moment a cited
// realization row exists to derive it from.
type TargetLayerTransitionRefusal
  = SharedValueDuplication
  | UniqueIndirectionResharing

// A total function's worth of answers about delivering a value produced at one layer to a site
// that wants another. Total over all nine (from, to) pairs by construction: three identities, two
// wraps, one unwrap, three refusals.
type TargetLayerTransition
  = LayerTransitionIdentity
  | LayerTransitionWrap { into: TargetReferenceLayer }
  | LayerTransitionUnwrap { from: TargetReferenceLayer }
  | LayerTransitionRefused {
      from: TargetReferenceLayer,
      to: TargetReferenceLayer,
      cause: TargetLayerTransitionRefusal
    }

// R1's next rung, and the reason it is a DERIVATION rather than a table.
//
// wrap_decision_flow_gate (v2.compiler.wrap_decision) currently answers a producer/consumer pair by
// COMPARING the two positions' layers and refusing every disagreement. That is honest but blunt: a
// producer returning Rc<T> feeding a parameter that wants T is a disagreement the emitter can
// simply RESOLVE, by lowering at the boundary, and refusing it stops a line that had a correct
// continuation. The measured corpus is the argument -- ten types, fourteen occurrences, wrapped at
// every signature and bare at one or more fields, producing BOTH error directions from one
// inconsistency. Comparison sees six disagreeing pairs and refuses six. This function sees which
// three are genuinely unconvertible and refuses three, deriving the other three.
//
// The derivation reads the two axes and nothing else:
//   sharing Shared -> Unique              => refuse (SharedValueDuplication) -- Rc->Owned, Rc->Box
//   indirection Direct -> Indirect        => wrap                            -- Owned->Box, Owned->Rc
//   indirection Indirect -> Direct        => unwrap                          -- Box->Owned
//   indirection Indirect -> Indirect,
//     sharing Unique -> Shared            => refuse (UniqueIndirectionResharing) -- Box->Rc
//   from == to                            => identity
//
// Note which way the refusal points. Gaining sharing from an owned value is safe -- the produced
// handle is the first one, so there is nobody to disagree with. LOSING it is not, and that
// asymmetry is a fact about the sharing axis rather than a policy choice, which is precisely why
// it is derived here instead of asserted in a row someone could edit to say otherwise.
fn target_layer_transition(
  from: TargetReferenceLayer,
  to: TargetReferenceLayer
) -> TargetLayerTransition {
  if from == to {
    LayerTransitionIdentity
  } else {
    let from_facts = target_reference_layer_facts(layer: from)
    let to_facts = target_reference_layer_facts(layer: to)
    match from_facts.sharing {
      SharingShared =>
        match to_facts.sharing {
          SharingUnique =>
            LayerTransitionRefused {
              from: from,
              to: to,
              cause: SharedValueDuplication
            }
          SharingShared =>
            LayerTransitionRefused {
              from: from,
              to: to,
              cause: UniqueIndirectionResharing
            }
        }
      SharingUnique =>
        match from_facts.indirection {
          IndirectionDirect => LayerTransitionWrap { into: to }
          IndirectionIndirect =>
            match to_facts.indirection {
              IndirectionDirect => LayerTransitionUnwrap { from: from }
              IndirectionIndirect =>
                LayerTransitionRefused {
                  from: from,
                  to: to,
                  cause: UniqueIndirectionResharing
                }
            }
        }
    }
  }
}

// Whether a flow is deliverable at all -- the one question a consumer of the transition asks when
// it does not care HOW the boundary is realized. Kept as a projection of the transition rather
// than a second predicate over (from, to), so there is no way for the two to disagree.
fn target_layer_transition_is_deliverable(transition: TargetLayerTransition) -> Bool {
  match transition {
    LayerTransitionIdentity => true
    LayerTransitionWrap { into: _ } => true
    LayerTransitionUnwrap { from: _ } => true
    LayerTransitionRefused { from: _, to: _, cause: _ } => false
  }
}

type TargetReferenceLayerTokens {
  rc_type_head: v2.std.node.Symbol
  box_type_head: v2.std.node.Symbol
  rc_new_ctor: v2.std.node.Symbol
  box_new_ctor: v2.std.node.Symbol
}

type TargetUseSiteOwnershipSourceProjection
  = UseSiteOwnershipExactCarrier
  | UseSiteOwnershipInstantiationHeadCarrier

type TargetUseSiteOwnershipRealization {
  source_carrier: v2.std.node.Node
  source_projection: v2.std.compilers.target_model.TargetUseSiteOwnershipSourceProjection
  use_site: v2.std.compilers.target_model.TargetOwnershipUseSite
  reference_layer: v2.std.compilers.target_model.TargetReferenceLayer
  display_name: v2.std.node.Symbol
}

type TargetCarrierOwnership
  = CarrierOwnershipByValue
  | CarrierOwnershipByReference { realization: v2.std.compilers.target_model.TargetUseSiteOwnershipRealization }

type WrapDecision
  = WrapByValue
  | WrapByReference { layer: v2.std.compilers.target_model.TargetReferenceLayer }

type WrapDecisionGate
  = WrapGateInapplicable
  | WrapGateDecided { decision: v2.std.compilers.target_model.WrapDecision }

fn target_carrier_type_node(identity: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: identity } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn target_carrier_diagnostics_node() -> v2.std.node.Node {
  target_carrier_type_node(identity: ^target_carrier_diagnostics)
}

fn target_carrier_node_node() -> v2.std.node.Node {
  target_carrier_type_node(identity: ^target_carrier_node)
}

fn target_carrier_test_claim_node() -> v2.std.node.Node {
  target_carrier_type_node(identity: ^target_carrier_test_claim)
}

fn target_carrier_free_monoid_node() -> v2.std.node.Node {
  target_carrier_type_node(identity: ^target_carrier_free_monoid)
}

fn target_carrier_outcome_node() -> v2.std.node.Node {
  target_carrier_type_node(identity: ^target_carrier_outcome)
}

fn target_carrier_model_core_node() -> v2.std.node.Node {
  target_carrier_type_node(identity: ^target_carrier_model_core)
}

fn target_carrier_algebra_inhabitance_decl_node() -> v2.std.node.Node {
  target_carrier_type_node(identity: ^target_carrier_algebra_inhabitance_decl)
}

fn target_carrier_probe_heap_node() -> v2.std.node.Node {
  target_carrier_type_node(identity: ^target_carrier_probe_heap)
}

fn target_carrier_use_site_verdict_node() -> v2.std.node.Node {
  target_carrier_type_node(identity: ^target_carrier_use_site_verdict)
}

fn target_ownership_use_site_from_atom(id: v2.std.node.Symbol) -> v2.std.optional.Optional<v2.std.compilers.target_model.TargetOwnershipUseSite> {
  if id == discriminant(v: OwnershipAtFunctionReturn) {
    optional_present(value: OwnershipAtFunctionReturn)
  } else {
    if id == discriminant(v: OwnershipAtFunctionParameter) {
      optional_present(value: OwnershipAtFunctionParameter)
    } else {
      if id == discriminant(v: OwnershipAtStructField) {
        optional_present(value: OwnershipAtStructField)
      } else {
        if id == discriminant(v: OwnershipAtBindingProjection) {
          optional_present(value: OwnershipAtBindingProjection)
        } else {
          optional_absent()
        }
      }
    }
  }
}

fn target_use_site_ownership_source_projection_from_atom(
  id: v2.std.node.Symbol
) -> v2.std.optional.Optional<v2.std.compilers.target_model.TargetUseSiteOwnershipSourceProjection> {
  if id == discriminant(v: UseSiteOwnershipExactCarrier) {
    optional_present(value: UseSiteOwnershipExactCarrier)
  } else {
    if id == discriminant(v: UseSiteOwnershipInstantiationHeadCarrier) {
      optional_present(value: UseSiteOwnershipInstantiationHeadCarrier)
    } else {
      optional_absent()
    }
  }
}

fn target_reference_layer_from_atom(id: v2.std.node.Symbol) -> v2.std.optional.Optional<v2.std.compilers.target_model.TargetReferenceLayer> {
  if id == discriminant(v: ReferenceLayerOwned) {
    optional_present(value: ReferenceLayerOwned)
  } else {
    if id == discriminant(v: ReferenceLayerRc) {
      optional_present(value: ReferenceLayerRc)
    } else {
      if id == discriminant(v: ReferenceLayerBox) {
        optional_present(value: ReferenceLayerBox)
      } else {
        optional_absent()
      }
    }
  }
}

fn target_use_site_ownership_lookup_miss_diagnostic(source_carrier: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_use_site_ownership_lookup_miss,
    at: node_locus(node: source_carrier),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_use_site_ownership_lookup_ambiguous_diagnostic(source_carrier: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_use_site_ownership_lookup_ambiguous,
    at: node_locus(node: source_carrier),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_use_site_ownership_catalog_row_decode_invalid_diagnostic(
  source_carrier: v2.std.node.Node
) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_use_site_ownership_catalog_row_decode_invalid,
    at: node_locus(node: source_carrier),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

type TargetUseSiteOwnershipLookup
  = TargetUseSiteOwnershipMissing
  | TargetUseSiteOwnershipUnique { row: v2.std.compilers.target_model.TargetUseSiteOwnershipRealization }
  | TargetUseSiteOwnershipAmbiguous

fn target_use_site_ownership_source_key(
  source_carrier: v2.std.node.Node,
  projection: v2.std.compilers.target_model.TargetUseSiteOwnershipSourceProjection
) -> v2.std.optional.Optional<v2.std.node.Node> {
  match projection {
    UseSiteOwnershipExactCarrier => optional_present(value: source_carrier)
    UseSiteOwnershipInstantiationHeadCarrier =>
      match source_carrier.kind {
        TypeNode { connective: Instantiation } =>
          match list_at_optional(xs: node_positional_child_targets(node: source_carrier), index: 0) {
            Present { value: head } => optional_present(value: head)
            Absent => optional_absent()
          }
        _ => optional_absent()
      }
  }
}

fn target_use_site_ownership_lookup_step(
  acc: v2.std.compilers.target_model.TargetUseSiteOwnershipLookup,
  row: v2.std.compilers.target_model.TargetUseSiteOwnershipRealization,
  source_carrier: v2.std.node.Node,
  use_site: v2.std.compilers.target_model.TargetOwnershipUseSite
) -> v2.std.compilers.target_model.TargetUseSiteOwnershipLookup {
  match target_use_site_ownership_source_key(
    source_carrier: source_carrier,
    projection: row.source_projection
  ) {
    Absent => acc
    Present { value: source_key } =>
      if content_hash(n: row.source_carrier) == content_hash(n: source_key)
        && row.use_site == use_site
      {
        match acc {
          TargetUseSiteOwnershipMissing => TargetUseSiteOwnershipUnique { row: row }
          TargetUseSiteOwnershipUnique { row: _ } => TargetUseSiteOwnershipAmbiguous
          TargetUseSiteOwnershipAmbiguous => TargetUseSiteOwnershipAmbiguous
        }
      } else {
        acc
      }
  }
}

fn target_use_site_ownership_lookup_in_catalog(
  catalog: v2.std.collection.List<v2.std.compilers.target_model.TargetUseSiteOwnershipRealization>,
  source_carrier: v2.std.node.Node,
  use_site: v2.std.compilers.target_model.TargetOwnershipUseSite
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetUseSiteOwnershipRealization> {
  match fold_list(
    xs: catalog,
    empty: TargetUseSiteOwnershipMissing,
    cons: fn(acc, row) {
      target_use_site_ownership_lookup_step(
        acc: acc,
        row: row,
        source_carrier: source_carrier,
        use_site: use_site
      )
    }
  ) {
    TargetUseSiteOwnershipMissing =>
      outcome_rejected(target_use_site_ownership_lookup_miss_diagnostic(source_carrier: source_carrier))
    TargetUseSiteOwnershipUnique { row: row } => outcome_accepted(row)
    TargetUseSiteOwnershipAmbiguous =>
      outcome_rejected(target_use_site_ownership_lookup_ambiguous_diagnostic(source_carrier: source_carrier))
  }
}

fn target_model_node_atom_identity(node: v2.std.node.Node, source_carrier: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Symbol> {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } => outcome_accepted(id)
    _ =>
      outcome_rejected(
        target_use_site_ownership_catalog_row_decode_invalid_diagnostic(
          source_carrier: source_carrier
        )
      )
  }
}

fn target_use_site_ownership_row_from_node(
  row_node: v2.std.node.Node,
  display_name: v2.std.node.Symbol,
  source_carrier: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetUseSiteOwnershipRealization> {
  let carrier_node = target_atom_realization_conj_child(
    row_node: row_node,
    edge_name: ^target_use_site_ownership_field_source_carrier
  )
  let source_projection_node = target_atom_realization_conj_child(
    row_node: row_node,
    edge_name: ^target_use_site_ownership_field_source_projection
  )
  let use_site_node = target_atom_realization_conj_child(
    row_node: row_node,
    edge_name: ^target_use_site_ownership_field_use_site
  )
  let layer_node = target_atom_realization_conj_child(
    row_node: row_node,
    edge_name: ^target_use_site_ownership_field_reference_layer
  )
  bind_outcome(
    o: target_model_node_atom_identity(node: source_projection_node, source_carrier: source_carrier),
    f: fn(source_projection_id) {
      match target_use_site_ownership_source_projection_from_atom(id: source_projection_id) {
        Absent =>
          outcome_rejected(
            target_use_site_ownership_catalog_row_decode_invalid_diagnostic(
              source_carrier: source_carrier
            )
          )
        Present { value: source_projection } =>
          bind_outcome(
            o: target_model_node_atom_identity(node: use_site_node, source_carrier: source_carrier),
            f: fn(use_site_id) {
              match target_ownership_use_site_from_atom(id: use_site_id) {
                Absent =>
                  outcome_rejected(
                    target_use_site_ownership_catalog_row_decode_invalid_diagnostic(
                      source_carrier: source_carrier
                    )
                  )
                Present { value: use_site } =>
                  bind_outcome(
                    o: target_model_node_atom_identity(node: layer_node, source_carrier: source_carrier),
                    f: fn(layer_id) {
                      match target_reference_layer_from_atom(id: layer_id) {
                        Absent =>
                          outcome_rejected(
                            target_use_site_ownership_catalog_row_decode_invalid_diagnostic(
                              source_carrier: source_carrier
                            )
                          )
                        Present { value: reference_layer } =>
                          outcome_accepted(
                            TargetUseSiteOwnershipRealization {
                              source_carrier: carrier_node,
                              source_projection: source_projection,
                              use_site: use_site,
                              reference_layer: reference_layer,
                              display_name: display_name
                            }
                          )
                      }
                    }
                  )
              }
            }
          )
      }
    }
  )
}

type TargetUseSiteOwnershipCatalogLookup
  = TargetUseSiteOwnershipCatalogMissing
  | TargetUseSiteOwnershipCatalogUnique { row: v2.std.compilers.target_model.TargetUseSiteOwnershipRealization }
  | TargetUseSiteOwnershipCatalogAmbiguous
  | TargetUseSiteOwnershipCatalogInvalid

fn target_use_site_ownership_catalog_lookup_step(
  acc: v2.std.compilers.target_model.TargetUseSiteOwnershipCatalogLookup,
  edge: v2.std.node.Edge,
  source_carrier: v2.std.node.Node,
  use_site: v2.std.compilers.target_model.TargetOwnershipUseSite
) -> v2.std.compilers.target_model.TargetUseSiteOwnershipCatalogLookup {
  match acc {
    TargetUseSiteOwnershipCatalogInvalid => TargetUseSiteOwnershipCatalogInvalid
    _ =>
      match edge.label {
    Named { name: display_name } =>
      target_use_site_ownership_catalog_lookup_step_for_row(
        acc: acc,
        row_node: edge.target,
        display_name: display_name,
        source_carrier: source_carrier,
        use_site: use_site
      )
    Positional =>
      target_use_site_ownership_catalog_lookup_step_for_row(
        acc: acc,
        row_node: edge.target,
        display_name: ^target_use_site_ownership_derived_row,
        source_carrier: source_carrier,
        use_site: use_site
      )
      }
  }
}

fn target_use_site_ownership_catalog_lookup_step_for_row(
  acc: v2.std.compilers.target_model.TargetUseSiteOwnershipCatalogLookup,
  row_node: v2.std.node.Node,
  display_name: v2.std.node.Symbol,
  source_carrier: v2.std.node.Node,
  use_site: v2.std.compilers.target_model.TargetOwnershipUseSite
) -> v2.std.compilers.target_model.TargetUseSiteOwnershipCatalogLookup {
  match target_use_site_ownership_row_from_node(
    row_node: row_node,
    display_name: display_name,
    source_carrier: source_carrier
  ) {
    Accepted { value: row, diagnostics: _ } =>
      match target_use_site_ownership_lookup_step(
        acc: match acc {
          TargetUseSiteOwnershipCatalogMissing => TargetUseSiteOwnershipMissing
          TargetUseSiteOwnershipCatalogUnique { row: r } =>
            TargetUseSiteOwnershipUnique { row: r }
          TargetUseSiteOwnershipCatalogAmbiguous => TargetUseSiteOwnershipAmbiguous
          TargetUseSiteOwnershipCatalogInvalid => TargetUseSiteOwnershipCatalogInvalid
        },
        row: row,
        source_carrier: source_carrier,
        use_site: use_site
      ) {
        TargetUseSiteOwnershipMissing =>
          TargetUseSiteOwnershipCatalogMissing
        TargetUseSiteOwnershipUnique { row: row } =>
          TargetUseSiteOwnershipCatalogUnique { row: row }
        TargetUseSiteOwnershipAmbiguous => TargetUseSiteOwnershipCatalogAmbiguous
      }
    Rejected { diagnostics: _ } => TargetUseSiteOwnershipCatalogInvalid
  }
}

fn target_use_site_ownership_reference_catalog_lookup(
  catalog: v2.std.node.Node,
  source_carrier: v2.std.node.Node,
  use_site: v2.std.compilers.target_model.TargetOwnershipUseSite
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetCarrierOwnership> {
  match catalog.kind {
    TypeNode { connective: Conj } =>
      match fold(
        catalog.children,
        init: TargetUseSiteOwnershipCatalogMissing,
        f: fn(acc, e) {
          target_use_site_ownership_catalog_lookup_step(
            acc: acc,
            edge: e,
            source_carrier: source_carrier,
            use_site: use_site
          )
        }
      ) {
        TargetUseSiteOwnershipCatalogMissing =>
          outcome_rejected(target_use_site_ownership_lookup_miss_diagnostic(source_carrier: source_carrier))
        TargetUseSiteOwnershipCatalogUnique { row: row } =>
          outcome_accepted(CarrierOwnershipByReference { realization: row })
        TargetUseSiteOwnershipCatalogAmbiguous =>
          outcome_rejected(target_use_site_ownership_lookup_ambiguous_diagnostic(source_carrier: source_carrier))
        TargetUseSiteOwnershipCatalogInvalid =>
          outcome_rejected(
            target_use_site_ownership_catalog_row_decode_invalid_diagnostic(
              source_carrier: source_carrier
            )
          )
      }
    _ =>
      outcome_rejected(
        target_use_site_ownership_catalog_row_decode_invalid_diagnostic(
          source_carrier: source_carrier
        )
      )
  }
}

fn target_use_site_ownership_lookup_in_catalog_node(
  catalog: v2.std.node.Node,
  value_semantics_carriers: v2.std.collection.List<v2.std.node.Symbol>,
  source_carrier: v2.std.node.Node,
  use_site: v2.std.compilers.target_model.TargetOwnershipUseSite
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetCarrierOwnership> {

  match source_carrier.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if any(xs: value_semantics_carriers, predicate: fn(c) { c == id }) {
        outcome_accepted(CarrierOwnershipByValue)
      } else {
        target_use_site_ownership_reference_catalog_lookup(
          catalog: catalog,
          source_carrier: source_carrier,
          use_site: use_site
        )
      }
    _ =>
      target_use_site_ownership_reference_catalog_lookup(
        catalog: catalog,
        source_carrier: source_carrier,
        use_site: use_site
      )
  }
}

fn wrap_decision_from_carrier_ownership(
  ownership: v2.std.compilers.target_model.TargetCarrierOwnership
) -> v2.std.compilers.target_model.WrapDecision {
  match ownership {
    CarrierOwnershipByValue => WrapByValue
    CarrierOwnershipByReference { realization: row } =>
      match row.reference_layer {
        ReferenceLayerOwned => WrapByValue
        layer => WrapByReference { layer: layer }
      }
  }
}

fn wrap_decision_lookup_in_catalog_node(
  catalog: v2.std.node.Node,
  value_semantics_carriers: v2.std.collection.List<v2.std.node.Symbol>,
  source_carrier: v2.std.node.Node,
  use_site: v2.std.compilers.target_model.TargetOwnershipUseSite
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.WrapDecision> {
  bind_outcome(
    o: target_use_site_ownership_lookup_in_catalog_node(
      catalog: catalog,
      value_semantics_carriers: value_semantics_carriers,
      source_carrier: source_carrier,
      use_site: use_site
    ),
    f: fn(ownership) {
      outcome_accepted(
        wrap_decision_from_carrier_ownership(ownership: ownership)
      )
    }
  )
}

fn target_use_site_ownership_realization_to_node(row: v2.std.compilers.target_model.TargetUseSiteOwnershipRealization) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      target_model_named_edge(
        name: ^target_use_site_ownership_field_source_carrier,
        target: row.source_carrier
      ),
      target_model_named_edge(
        name: ^target_use_site_ownership_field_source_projection,
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode {
            connective: v2.std.node.Atom {
              identity: discriminant(v: row.source_projection)
            }
          },
          children: [],
          occurrence_id: SyntheticOccurrence
}
      ),
      target_model_named_edge(
        name: ^target_use_site_ownership_field_use_site,
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode {
            connective: v2.std.node.Atom { identity: discriminant(v: row.use_site) }
          },
          children: [],
          occurrence_id: SyntheticOccurrence
}
      ),
      target_model_named_edge(
        name: ^target_use_site_ownership_field_reference_layer,
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode {
            connective: v2.std.node.Atom { identity: discriminant(v: row.reference_layer) }
          },
          children: [],
          occurrence_id: SyntheticOccurrence
}
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn target_use_site_ownership_catalog_edge(row: v2.std.compilers.target_model.TargetUseSiteOwnershipRealization) -> v2.std.node.Edge {
  target_model_named_edge(
    name: row.display_name,
    target: target_use_site_ownership_realization_to_node(row: row)
  )
}

fn target_use_site_ownership_catalog_snoc_edge(
  acc: v2.std.collection.List<v2.std.node.Edge>,
  row: v2.std.compilers.target_model.TargetUseSiteOwnershipRealization
) -> v2.std.collection.List<v2.std.node.Edge> {
  list_snoc_item(xs: acc, item: target_use_site_ownership_catalog_edge(row: row))
}

fn target_use_site_ownership_catalog_node(
  rows: v2.std.collection.List<v2.std.compilers.target_model.TargetUseSiteOwnershipRealization>
) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: fold_list(
      xs: rows,
      empty: std.algebra.Empty,
      cons: fn(acc, row) { target_use_site_ownership_catalog_snoc_edge(acc: acc, row: row) }
    ),
    occurrence_id: SyntheticOccurrence
}
}

fn target_use_site_ownership_catalog_positional_edge(
  row: v2.std.compilers.target_model.TargetUseSiteOwnershipRealization
) -> v2.std.node.Edge {
  v2.std.node.Edge {
    label: Positional,
    target: target_use_site_ownership_realization_to_node(row: row)
  }
}

fn target_use_site_ownership_catalog_append_derived_rows(
  catalog: v2.std.node.Node,
  derived_rows: v2.std.collection.List<v2.std.compilers.target_model.TargetUseSiteOwnershipRealization>
) -> v2.std.node.Node {
  match catalog.kind {
    TypeNode { connective: Conj } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: Conj },
        children: fold_list(
          xs: derived_rows,
          empty: catalog.children,
          cons: fn(acc, row) {
            list_snoc_item(
              xs: acc,
              item: target_use_site_ownership_catalog_positional_edge(row: row)
            )
          }
        ),
        occurrence_id: SyntheticOccurrence
      }
    _ => catalog
  }
}

fn target_model_bundle_replace_edge_target(
  bundle: v2.std.node.Node,
  edge_name: v2.std.node.Symbol,
  new_target: v2.std.node.Node
) -> v2.std.node.Node {
  match bundle.kind {
    TypeNode { connective: Conj } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: Conj },
        children: fold(
          bundle.children,
          init: std.algebra.Empty,
          f: fn(acc, edge) {
            match edge.label {
              Named { name: n } =>
                if n == edge_name {
                  list_snoc_item(
                    xs: acc,
                    item: target_model_named_edge(name: n, target: new_target)
                  )
                } else {
                  list_snoc_item(xs: acc, item: edge)
                }
              Positional => list_snoc_item(xs: acc, item: edge)
            }
          }
        ),
        occurrence_id: SyntheticOccurrence
      }
    _ => bundle
  }
}

fn target_value_semantics_carrier_atom_seen(
  atoms: v2.std.collection.List<v2.std.node.Symbol>,
  atom: v2.std.node.Symbol
) -> Bool {
  any(xs: atoms, predicate: fn(id) { id == atom })
}

fn target_value_semantics_carriers_snoc_unique(
  atoms: v2.std.collection.List<v2.std.node.Symbol>,
  atom: v2.std.node.Symbol
) -> v2.std.collection.List<v2.std.node.Symbol> {
  if target_value_semantics_carrier_atom_seen(atoms: atoms, atom: atom) {
    atoms
  } else {
    list_snoc_item(xs: atoms, item: atom)
  }
}

fn target_value_semantics_carriers_merge_atoms(
  base: v2.std.collection.List<v2.std.node.Symbol>,
  extra: v2.std.collection.List<v2.std.node.Symbol>
) -> v2.std.collection.List<v2.std.node.Symbol> {
  fold_list(
    xs: extra,
    empty: base,
    cons: fn(acc, atom) {
      target_value_semantics_carriers_snoc_unique(atoms: acc, atom: atom)
    }
  )
}

// Installs a per-declaration body scaffold into the target's translation rules.
// The scaffold comes from the TARGET's own renderer, so nothing here knows the
// signature's shape; this only decides WHERE the rendered scaffold attaches.
// The base row is the BARE one carried by ProducedDeclWired, never the target's
// ordinary rule -- that one already has a fixed scaffold attached, and appending a
// second bodied-scaffold edge would let the fixed one win every lookup, emitting a
// single declaration's signature for every declaration.
fn target_model_with_produced_scaffold(
  target: v2.std.compilers.target_model.TargetModel,
  rule_name: v2.std.node.Symbol,
  base_row: v2.std.node.Node,
  scaffold: v2.std.compilers.target_model.TargetBodiedArrowStatementScaffold
) -> v2.std.compilers.target_model.TargetModel {
  TargetModel {
    produced_decl_support: target.produced_decl_support,
    bundle: target_model_bundle_replace_edge_target(
      bundle: target.bundle,
      edge_name: ^target_model_edge_translation_rules,
      new_target: target_model_type_conj_node(
        children: [
          target_model_named_edge(
            name: rule_name,
            target: grammar_relation_row_attach_bodied_scaffold(
              row: base_row,
              scaffold: scaffold
            )
          )
        ]
      )
    ),
    lex: target.lex,
    binding_spellings: target.binding_spellings,
    token_class_emit_transforms: target.token_class_emit_transforms,
    authority_source_text: target.authority_source_text,
    runtime_row: target.runtime_row
  }
}

fn target_model_augment_use_site_ownership_catalog(
  target: v2.std.compilers.target_model.TargetModel,
  derived_rows: v2.std.collection.List<v2.std.compilers.target_model.TargetUseSiteOwnershipRealization>
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetModel> {
  if is_empty(xs: derived_rows) {
    outcome_accepted(target)
  } else {
    match target.bundle.kind {
      TypeNode { connective: Conj } =>
        match fold(
          target.bundle.children,
          init: optional_absent(),
          f: fn(acc, edge) {
            match edge.label {
              Named { name: n } =>
                if n == ^target_model_edge_use_site_ownership_realizations {
                  optional_present(value: edge.target)
                } else {
                  acc
                }
              Positional => acc
            }
          }
        ) {
          Absent => outcome_accepted(target)
          Present { value: catalog } =>
            outcome_accepted(
              TargetModel {
                produced_decl_support: target.produced_decl_support,
                bundle: target_model_bundle_replace_edge_target(
                  bundle: target.bundle,
                  edge_name: ^target_model_edge_use_site_ownership_realizations,
                  new_target: target_use_site_ownership_catalog_append_derived_rows(
                    catalog: catalog,
                    derived_rows: derived_rows
                  )
                ),
                lex: target.lex,
                binding_spellings: target.binding_spellings,
                token_class_emit_transforms: target.token_class_emit_transforms,
                authority_source_text: target.authority_source_text,
                runtime_row: target.runtime_row
              }
            )
        }
      _ => outcome_accepted(target)
    }
  }
}

fn target_model_augment_value_semantics_carriers(
  target: v2.std.compilers.target_model.TargetModel,
  extra_atoms: v2.std.collection.List<v2.std.node.Symbol>
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetModel> {
  if is_empty(xs: extra_atoms) {
    outcome_accepted(target)
  } else {
    match target.bundle.kind {
      TypeNode { connective: Conj } =>
        match fold(
          target.bundle.children,
          init: optional_absent(),
          f: fn(acc, edge) {
            match edge.label {
              Named { name: n } =>
                if n == ^target_model_edge_value_semantics_carriers {
                  optional_present(value: edge.target)
                } else {
                  acc
                }
              Positional => acc
            }
          }
        ) {
          Absent => outcome_accepted(target)
          Present { value: carriers_node } =>
            outcome_accepted(
              TargetModel {
                produced_decl_support: target.produced_decl_support,
                bundle: target_model_bundle_replace_edge_target(
                  bundle: target.bundle,
                  edge_name: ^target_model_edge_value_semantics_carriers,
                  new_target: target_value_semantics_carriers_node(
                    atoms: target_value_semantics_carriers_merge_atoms(
                      base: target_value_semantics_carriers_from_node(node: carriers_node),
                      extra: extra_atoms
                    )
                  )
                ),
                lex: target.lex,
                binding_spellings: target.binding_spellings,
                token_class_emit_transforms: target.token_class_emit_transforms,
                authority_source_text: target.authority_source_text,
                runtime_row: target.runtime_row
              }
            )
        }
      _ => outcome_accepted(target)
    }
  }
}

fn target_value_semantics_carrier_atom_node(id: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } }, children: std.algebra.Empty,
 occurrence_id: SyntheticOccurrence
}
}

fn target_value_semantics_carriers_node(atoms: v2.std.collection.List<v2.std.node.Symbol>) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: fold_list(
      xs: atoms,
      empty: std.algebra.Empty,
      cons: fn(acc, id) {
        list_snoc_item(
          xs: acc,
          item: target_model_named_edge(name: id, target: target_value_semantics_carrier_atom_node(id: id))
        )
      }
    ),
    occurrence_id: SyntheticOccurrence
}
}

fn target_value_semantics_carrier_snoc(acc: v2.std.collection.List<v2.std.node.Symbol>, edge: v2.std.node.Edge) -> v2.std.collection.List<v2.std.node.Symbol> {
  match edge.label {
    Named { name: n } => list_snoc_item(xs: acc, item: n)
    _ => acc
  }
}

fn target_value_semantics_carriers_from_node(node: v2.std.node.Node) -> v2.std.collection.List<v2.std.node.Symbol> {
  match node.kind {
    TypeNode { connective: Conj } =>
      fold_list(
        xs: node.children,
        empty: std.algebra.Empty,
        cons: fn(acc, edge) { target_value_semantics_carrier_snoc(acc: acc, edge: edge) }
      )
    _ => std.algebra.Empty
  }
}

fn target_reference_layer_tokens_decode_invalid_diagnostic(source_carrier: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_reference_layer_tokens_decode_invalid,
    at: node_locus(node: source_carrier),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_reference_layer_tokens_from_node(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetReferenceLayerTokens> {
  match node.kind {
    TypeNode { connective: Conj } =>
      bind_outcome(
        o: target_model_node_atom_identity(
          node: target_atom_realization_conj_child(
            row_node: node,
            edge_name: ^target_reference_layer_tokens_field_rc_head
          ),
          source_carrier: node
        ),
        f: fn(rc_type_head) {
          bind_outcome(
            o: target_model_node_atom_identity(
              node: target_atom_realization_conj_child(
                row_node: node,
                edge_name: ^target_reference_layer_tokens_field_box_head
              ),
              source_carrier: node
            ),
            f: fn(box_type_head) {
              bind_outcome(
                o: target_model_node_atom_identity(
                  node: target_atom_realization_conj_child(
                    row_node: node,
                    edge_name: ^target_reference_layer_tokens_field_rc_new
                  ),
                  source_carrier: node
                ),
                f: fn(rc_new_ctor) {
                  bind_outcome(
                    o: target_model_node_atom_identity(
                      node: target_atom_realization_conj_child(
                        row_node: node,
                        edge_name: ^target_reference_layer_tokens_field_box_new
                      ),
                      source_carrier: node
                    ),
                    f: fn(box_new_ctor) {
                      outcome_accepted(
                        TargetReferenceLayerTokens {
                          rc_type_head: rc_type_head,
                          box_type_head: box_type_head,
                          rc_new_ctor: rc_new_ctor,
                          box_new_ctor: box_new_ctor
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    _ =>
      outcome_rejected(
        target_reference_layer_tokens_decode_invalid_diagnostic(source_carrier: node)
      )
  }
}

fn target_reference_layer_tokens_node(tokens: v2.std.compilers.target_model.TargetReferenceLayerTokens) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      target_model_named_edge(
        name: ^target_reference_layer_tokens_field_rc_head,
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: tokens.rc_type_head } },
          children: [],
          occurrence_id: SyntheticOccurrence
}
      ),
      target_model_named_edge(
        name: ^target_reference_layer_tokens_field_box_head,
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: tokens.box_type_head } },
          children: [],
          occurrence_id: SyntheticOccurrence
}
      ),
      target_model_named_edge(
        name: ^target_reference_layer_tokens_field_rc_new,
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: tokens.rc_new_ctor } },
          children: [],
          occurrence_id: SyntheticOccurrence
}
      ),
      target_model_named_edge(
        name: ^target_reference_layer_tokens_field_box_new,
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: tokens.box_new_ctor } },
          children: [],
          occurrence_id: SyntheticOccurrence
}
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn target_reference_layer_apply_type_emitted(
  inner: v2.std.node.Node,
  layer: v2.std.compilers.target_model.TargetReferenceLayer,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection,
  tokens: v2.std.compilers.target_model.TargetReferenceLayerTokens
) -> v2.std.node.Node {
  match layer {
    ReferenceLayerOwned => inner
    ReferenceLayerRc =>
      target_type_expr_instantiation_emitted(
        form: projection.instantiation_form,
        head: target_type_expr_atom_emitted(
          form: projection.atom_form,
          identity: tokens.rc_type_head
        ),
        args: [inner]
      )
    ReferenceLayerBox =>
      target_type_expr_instantiation_emitted(
        form: projection.instantiation_form,
        head: target_type_expr_atom_emitted(
          form: projection.atom_form,
          identity: tokens.box_type_head
        ),
        args: [inner]
      )
  }
}

fn target_value_expression_reference_rc_new(
  inner: v2.std.compilers.target_model.TargetValueExpression,
  ctor: v2.std.node.Symbol
) -> v2.std.compilers.target_model.TargetValueExpression {
  TargetValueExpression {
    kind: TargetValueExprReferenceRcNew,
    node: v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ctor } },
      children: [
        target_model_named_edge(
          name: ^target_value_expression_field_inner,
          target: target_value_expression_node(expr: inner)
        )
      ],
      occurrence_id: SyntheticOccurrence
}
  }
}

fn target_value_expression_reference_box_new(
  inner: v2.std.compilers.target_model.TargetValueExpression,
  ctor: v2.std.node.Symbol
) -> v2.std.compilers.target_model.TargetValueExpression {
  TargetValueExpression {
    kind: TargetValueExprReferenceBoxNew,
    node: v2.std.node.Node {
      kind: v2.std.node.TypeNode {
        connective: v2.std.node.Atom { identity: ctor }
      },
      children: [
        target_model_named_edge(
          name: ^target_value_expression_field_inner,
          target: target_value_expression_node(expr: inner)
        )
      ],
      occurrence_id: SyntheticOccurrence
}
  }
}

fn target_reference_layer_apply_value_expression(
  inner: v2.std.compilers.target_model.TargetValueExpression,
  layer: v2.std.compilers.target_model.TargetReferenceLayer,
  tokens: v2.std.compilers.target_model.TargetReferenceLayerTokens
) -> v2.std.compilers.target_model.TargetValueExpression {
  match layer {
    ReferenceLayerOwned => inner
    ReferenceLayerRc =>
      target_value_expression_reference_rc_new(inner: inner, ctor: tokens.rc_new_ctor)
    ReferenceLayerBox =>
      target_value_expression_reference_box_new(inner: inner, ctor: tokens.box_new_ctor)
  }
}

type TargetReferenceLayerWrapped
  = WrappedReferenceLayerRc
  | WrappedReferenceLayerBox

type TargetReferenceLayerProbe
  = ReferenceLayerProbe { value: v2.std.compilers.target_model.TargetReferenceLayerWrapped }
  | ReferenceLayerProbeNotWrapped
  | ReferenceLayerProbeInvalid

fn target_reference_layer_probe_from_emitted_type(
  emitted: v2.std.node.Node,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection,
  tokens: v2.std.compilers.target_model.TargetReferenceLayerTokens
) -> v2.std.compilers.target_model.TargetReferenceLayerProbe {
  match target_type_expr_emitted_wire_decode(node: emitted, projection: projection) {
    Accepted { value: wire, diagnostics: _ } =>
      match wire.kind {
        TargetTypeExprInstantiation =>
          match list_at_optional(
            xs: node_positional_child_targets(node: wire.node),
            index: 0
          ) {
            Present { value: head } =>
              match target_model_node_atom_identity(node: head, source_carrier: emitted) {
                Accepted { value: head_id, diagnostics: _ } =>
                  if head_id == tokens.rc_type_head {
                    ReferenceLayerProbe { value: WrappedReferenceLayerRc }
                  } else {
                    if head_id == tokens.box_type_head {
                      ReferenceLayerProbe { value: WrappedReferenceLayerBox }
                    } else {
                      ReferenceLayerProbeNotWrapped
                    }
                  }
                Rejected { diagnostics: _ } => ReferenceLayerProbeInvalid
              }
            Absent => ReferenceLayerProbeInvalid
          }
        _ => ReferenceLayerProbeNotWrapped
      }
    Rejected { diagnostics: _ } => ReferenceLayerProbeInvalid
  }
}

fn target_type_expr_symbol_atom(id: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn target_type_expr_atom_shape_node(form: v2.std.compilers.target_model.TargetAtomTypeShape) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      target_model_named_edge(
        name: ^target_type_expr_field_surface,
        target: target_type_expr_symbol_atom(id: form.surface)
      ),
      target_model_named_edge(
        name: ^target_type_expr_field_ident_token,
        target: target_type_expr_symbol_atom(id: form.ident_token)
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn target_type_expr_generic_apply_shape_node(form: v2.std.compilers.target_model.TargetGenericApply) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: match form.field_label_separator {
      Present { value: s } =>
        list_snoc_item(
          xs: [
            target_model_named_edge(
              name: ^target_type_expr_field_surface,
              target: target_type_expr_symbol_atom(id: form.surface)
            ),
            target_model_named_edge(
              name: ^target_type_expr_field_open,
              target: target_type_expr_symbol_atom(id: form.open)
            ),
            target_model_named_edge(
              name: ^target_type_expr_field_separator,
              target: target_type_expr_symbol_atom(id: form.separator)
            ),
            target_model_named_edge(
              name: ^target_type_expr_field_close,
              target: target_type_expr_symbol_atom(id: form.close)
            )
          ],
          item: target_model_named_edge(
            name: ^target_type_expr_field_field_label_separator,
            target: target_type_expr_symbol_atom(id: s)
          )
        )
      Absent =>
        [
          target_model_named_edge(
            name: ^target_type_expr_field_surface,
            target: target_type_expr_symbol_atom(id: form.surface)
          ),
          target_model_named_edge(
            name: ^target_type_expr_field_open,
            target: target_type_expr_symbol_atom(id: form.open)
          ),
          target_model_named_edge(
            name: ^target_type_expr_field_separator,
            target: target_type_expr_symbol_atom(id: form.separator)
          ),
          target_model_named_edge(
            name: ^target_type_expr_field_close,
            target: target_type_expr_symbol_atom(id: form.close)
          )
        ]
    },
    occurrence_id: SyntheticOccurrence
  }
}

fn target_type_expr_sum_shape_node(form: v2.std.compilers.target_model.TargetSumTypeShape) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      target_model_named_edge(
        name: ^target_type_expr_field_surface,
        target: target_type_expr_symbol_atom(id: form.surface)
      ),
      target_model_named_edge(
        name: ^target_type_expr_field_variant_separator,
        target: target_type_expr_symbol_atom(id: form.variant_separator)
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn target_type_expr_arrow_shape_node(form: v2.std.compilers.target_model.TargetFunctionTypeShape) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      target_model_named_edge(
        name: ^target_type_expr_field_surface,
        target: target_type_expr_symbol_atom(id: form.surface)
      ),
      target_model_named_edge(
        name: ^target_type_expr_field_open,
        target: target_type_expr_symbol_atom(id: form.open)
      ),
      target_model_named_edge(
        name: ^target_type_expr_field_close,
        target: target_type_expr_symbol_atom(id: form.close)
      ),
      target_model_named_edge(
        name: ^target_type_expr_field_arrow,
        target: target_type_expr_symbol_atom(id: form.arrow)
      ),
      target_model_named_edge(
        name: ^target_type_expr_field_param_ident_token,
        target: target_type_expr_symbol_atom(id: form.param_ident_token)
      ),
      target_model_named_edge(
        name: ^target_type_expr_field_param_type_separator,
        target: target_type_expr_symbol_atom(id: form.param_type_separator)
      ),
      target_model_named_edge(
        name: ^target_type_expr_field_param_list_separator,
        target: target_type_expr_symbol_atom(id: form.param_list_separator)
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn type_expr_projection_child_slot_discipline_atom(connective: v2.std.node.Connective) -> v2.std.node.Node {
  match connective_edge_discipline(c: connective) {
    NoEdges => target_type_expr_symbol_atom(id: ^target_type_expr_discipline_no_edges)
    LabeledEdges => target_type_expr_symbol_atom(id: ^target_type_expr_discipline_labeled)
    PositionalEdges => target_type_expr_symbol_atom(id: ^target_type_expr_discipline_positional)
    ArrowBodyEdges => target_type_expr_symbol_atom(id: ^target_type_expr_discipline_positional)
    LoopBoundEdges => target_type_expr_symbol_atom(id: ^target_type_expr_discipline_positional)
  }
}

fn type_expr_projection_row_shape_envelope(
  envelope: v2.std.node.Node,
  connective: v2.std.node.Connective
) -> v2.std.node.Node {
  node_rebuild(
    n: envelope,
    children: list_append(
      left: envelope.children,
      right: std.algebra.Cons {
        head: target_model_named_edge(
          name: ^target_type_expr_field_child_slot_discipline,
          target: type_expr_projection_child_slot_discipline_atom(connective: connective)
        ),
        tail: std.algebra.Empty
      }
    )
  )
}

fn type_expr_projection_step_algebra(projection: v2.std.compilers.target_model.TargetTypeExpressionProjection) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      target_model_named_edge(
        name: ^target_type_expr_field_atom,
        target: type_expr_projection_row_shape_envelope(
          envelope: target_type_expr_atom_shape_node(form: projection.atom_form),
          connective: v2.std.node.Atom { identity: ^target_type_expr_field_atom }
        )
      ),
      target_model_named_edge(
        name: ^target_type_expr_field_conj,
        target: type_expr_projection_row_shape_envelope(
          envelope: target_type_expr_generic_apply_shape_node(form: projection.conj_form),
          connective: Conj
        )
      ),
      target_model_named_edge(
        name: ^target_type_expr_field_disj,
        target: type_expr_projection_row_shape_envelope(
          envelope: target_type_expr_sum_shape_node(form: projection.disj_form),
          connective: Disj
        )
      ),
      target_model_named_edge(
        name: ^target_type_expr_field_arrow,
        target: type_expr_projection_row_shape_envelope(
          envelope: target_type_expr_arrow_shape_node(form: projection.arrow_form),
          connective: Arrow
        )
      ),
      target_model_named_edge(
        name: ^target_type_expr_field_cardinality,
        target: type_expr_projection_row_shape_envelope(
          envelope: target_type_expr_generic_apply_shape_node(form: projection.cardinality_form),
          connective: Cardinality
        )
      ),
      target_model_named_edge(
        name: ^target_type_expr_field_instantiation,
        target: type_expr_projection_row_shape_envelope(
          envelope: target_type_expr_generic_apply_shape_node(form: projection.instantiation_form),
          connective: Instantiation
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn type_expr_projection_shape_for_connective(
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection,
  connective: v2.std.node.Connective
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match connective {
    Atom { identity: _ } =>
      outcome_accepted(
        type_expr_projection_row_shape_envelope(
          envelope: target_type_expr_atom_shape_node(form: projection.atom_form),
          connective: connective
        )
      )
    Conj =>
      outcome_accepted(
        type_expr_projection_row_shape_envelope(
          envelope: target_type_expr_generic_apply_shape_node(form: projection.conj_form),
          connective: Conj
        )
      )
    Disj =>
      outcome_accepted(
        type_expr_projection_row_shape_envelope(
          envelope: target_type_expr_sum_shape_node(form: projection.disj_form),
          connective: Disj
        )
      )
    Arrow =>
      outcome_accepted(
        type_expr_projection_row_shape_envelope(
          envelope: target_type_expr_arrow_shape_node(form: projection.arrow_form),
          connective: Arrow
        )
      )
    Cardinality =>
      outcome_accepted(
        type_expr_projection_row_shape_envelope(
          envelope: target_type_expr_generic_apply_shape_node(form: projection.cardinality_form),
          connective: Cardinality
        )
      )
    Instantiation =>
      outcome_accepted(
        type_expr_projection_row_shape_envelope(
          envelope: target_type_expr_generic_apply_shape_node(form: projection.instantiation_form),
          connective: Instantiation
        )
      )
  }
}

fn type_expr_projection_candidate_for_connective(
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection,
  connective: v2.std.node.Connective
) -> v2.std.diagnostic.Outcome<v2.std.find_witness.CandidateSet> {
  bind_outcome(
    o: type_expr_projection_shape_for_connective(
      projection: projection,
      connective: connective
    ),
    f: fn(shape) {
      outcome_accepted(
        v2.std.find_witness.CandidateSet {
          candidates: [shape],
          closedness: v2.std.witness.StructuralPropertyWitness {
            property: ^target_type_expr_projection_candidate_closedness,
            evidence: shape
          }
        }
      )
    }
  )
}

fn type_expr_projection_row_witness_gate_with_rule(
  source_facts: v2.std.node.Node,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection,
  connective: v2.std.node.Connective,
  preservation_rule: v2.std.node.Symbol
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  bind_outcome(
    o: type_expr_projection_candidate_for_connective(
      projection: projection,
      connective: connective
    ),
    f: fn(candidates) {
      match find_witness(
        source_facts: source_facts,
        candidates: candidates,
        predicate: v2.std.find_witness.PreservationPredicate {
          algebra: source_facts,
          preservation_rule: preservation_rule
        },
        multiplicity_policy: UniqueOnly
      ) {
        Accepted { value: fw, diagnostics: d } =>
          outcome_accepted(fw.candidate)
        Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
      }
    }
  )
}

fn type_expr_projection_row_shape_witness_gate(
  source_facts: v2.std.node.Node,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection,
  connective: v2.std.node.Connective
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  type_expr_projection_row_witness_gate_with_rule(
    source_facts: source_facts,
    projection: projection,
    connective: connective,
    preservation_rule: ^preservation_rule_exact_structural_equality_zip_fold
  )
}

fn type_expr_projection_row_field_for_connective(connective: v2.std.node.Connective) -> v2.std.node.Symbol {
  match connective {
    Atom { identity: _ } => ^target_type_expr_field_atom
    Conj => ^target_type_expr_field_conj
    Disj => ^target_type_expr_field_disj
    Arrow => ^target_type_expr_field_arrow
    Cardinality => ^target_type_expr_field_cardinality
    Instantiation => ^target_type_expr_field_instantiation
  }
}

fn type_expr_projection_bundle_shape_for_connective(
  bundle: v2.std.node.Node,
  connective: v2.std.node.Connective
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  find_named_child(
    root: bundle,
    name: type_expr_projection_row_field_for_connective(connective: connective)
  )
}

fn type_expr_projection_row_closedness_from_target(
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection,
  connective: v2.std.node.Connective
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  bind_outcome(
    o: find_named_child(
      root: target.bundle,
      name: ^target_model_edge_type_expression_projection
    ),
    f: fn(bundle) {
      bind_outcome(
        o: type_expr_projection_bundle_shape_for_connective(
          bundle: bundle,
          connective: connective
        ),
        f: fn(bundle_shape) {
          type_expr_projection_row_shape_witness_gate(
            source_facts: bundle_shape,
            projection: projection,
            connective: connective
          )
        }
      )
    }
  )
}

fn target_value_expr_diagnostic(reason: v2.std.node.Symbol, node: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: reason,
    at: node_locus(node: node),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_transform_positional_operand_binding_atom(child: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Symbol> {
  match child.kind {
    TypeNode { connective: Atom { identity: id } } => outcome_accepted(id)
    _ =>
      outcome_rejected(
        target_value_expr_diagnostic(
          reason: ^target_value_expr_reason_transform_shape_invalid,
          node: child
        )
      )
  }
}

fn target_transform_positional_operand_binding(node: v2.std.node.Node, index: Int) -> v2.std.diagnostic.Outcome<v2.std.node.Symbol> {
  match list_at_optional(xs: node_positional_child_targets(node: node), index: index) {
    Present { value: child } => target_transform_positional_operand_binding_atom(child: child)
    Absent =>
      outcome_rejected(
        target_value_expr_diagnostic(
          reason: ^target_value_expr_reason_transform_shape_invalid,
          node: node
        )
      )
  }
}

fn target_transform_surface_op_atom(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Symbol> {
  target_transform_positional_operand_binding(node: node, index: 0)
}

fn target_value_expr_declared_inhabitants_from_target(target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  target_model_declared_inhabitants(target: target)
}

fn target_value_expr_add_signature_matches_for_target(
  arrow: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel
) -> Bool {
  match target_value_expr_declared_inhabitants_from_target(target: target) {
    Accepted { value: inhabitants_root, diagnostics: _ } =>
      target_add_signature_matches(
        arrow: arrow,
        inhabitants_root: inhabitants_root
      )
    Rejected { diagnostics: _ } => false
  }
}

fn target_value_expr_arrow_has_transform_body(arrow: v2.std.node.Node) -> Bool {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      match body.kind {
        ComputationNode { behavior: Transform } => true
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn target_value_expr_arrow_has_branch_body(arrow: v2.std.node.Node) -> Bool {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      match body.kind {
        ComputationNode { behavior: Branch } =>
          length(xs: node_positional_child_targets(node: body)) == 3
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn target_value_expr_arrow_has_bind_body(arrow: v2.std.node.Node) -> Bool {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      target_value_expr_bind_let_gate(node: body)
    Rejected { diagnostics: _ } => false
  }
}

fn target_value_expr_arrow_has_loop_body(arrow: v2.std.node.Node) -> Bool {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      target_value_expr_loop_gate(node: body)
    Rejected { diagnostics: _ } => false
  }
}

fn target_value_expr_arrow_has_match_body(arrow: v2.std.node.Node) -> Bool {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      target_value_expr_match_gate(node: body)
    Rejected { diagnostics: _ } => false
  }
}

fn target_value_expr_arrow_has_record_construct_body(arrow: v2.std.node.Node) -> Bool {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      target_value_expr_record_construct_gate(node: body)
    Rejected { diagnostics: _ } => false
  }
}

fn target_value_expr_arrow_has_value_expression_body(arrow: v2.std.node.Node) -> Bool {
  target_value_expr_arrow_has_transform_body(arrow: arrow)
    || target_value_expr_arrow_has_branch_body(arrow: arrow)
    || target_value_expr_arrow_has_bind_body(arrow: arrow)
    || target_value_expr_arrow_has_loop_body(arrow: arrow)
    || target_value_expr_arrow_has_match_body(arrow: arrow)
    || target_value_expr_arrow_has_record_construct_body(arrow: arrow)
}

fn target_value_expr_binding_in_declared_param_list(
  binding: v2.std.node.Symbol,
  bindings: v2.std.collection.List<v2.std.node.Symbol>
) -> Bool {
  fold_list(xs: bindings, empty: false, cons: fn(acc, sym) {
    if acc {
      true
    } else if sym == binding {
      true
    } else {
      false
    }
  })
}

fn target_value_expr_param_binding_for_referent(
  referent: v2.std.node.Symbol,
  bindings: v2.std.collection.List<v2.std.node.Symbol>,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.optional.Optional<v2.std.node.Symbol> {
  if target_value_expr_binding_in_declared_param_list(binding: referent, bindings: bindings) {
    optional_present(value: referent)
  } else {
    match target_binding_spelling_lookup(target: target, binding: referent) {
      Accepted { value: referent_spelling, diagnostics: _ } =>
        fold_list(
          xs: bindings,
          empty: optional_absent(),
          cons: fn(acc, param_binding) {
            match acc {
              Present { value: _ } => acc
              Absent =>
                match target_binding_spelling_lookup(
                  target: target,
                  binding: param_binding
                ) {
                  Accepted { value: param_spelling, diagnostics: _ } =>
                    if param_spelling == referent_spelling {
                      optional_present(value: param_binding)
                    } else {
                      acc
                    }
                  Rejected { diagnostics: _ } => acc
                }
            }
          }
        )
      Rejected { diagnostics: _ } => optional_absent()
    }
  }
}

fn target_value_expr_arrow_body_scope_binding(
  arrow: v2.std.node.Node,
  body: v2.std.node.Node,
  binding: v2.std.node.Symbol,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<v2.std.node.Symbol> {
  bind_outcome(
    o: arrow_domain_named_param_bindings(arrow: arrow),
    f: fn(bindings) {
      match target_value_expr_param_binding_for_referent(
        referent: binding,
        bindings: bindings,
        target: target
      ) {
        Present { value: scoped } =>
          if target_value_expr_add_signature_matches_for_target(arrow: arrow, target: target)
            || target_value_expr_arrow_has_transform_body(arrow: arrow)
            || target_value_expr_arrow_has_match_body(arrow: arrow) {
            outcome_accepted(scoped)
          } else {
            outcome_rejected(
              target_value_expr_diagnostic(
                reason: ^target_value_expr_reason_body_scope_binding_invalid,
                node: body
              )
            )
          }
        Absent =>
          outcome_rejected(
            target_value_expr_diagnostic(
              reason: ^target_value_expr_reason_body_scope_binding_invalid,
              node: body
            )
          )
      }
    }
  )
}

fn target_project_transform_primitive_apply_in_arrow_scope(
  arrow: v2.std.node.Node,
  body: v2.std.node.Node,
  canonical_op: v2.std.compilers.target_model.CanonicalOperation,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression> {
  if !all_edges_positional(children: body.children)
    || length(xs: node_positional_child_targets(node: body)) != 3 {
    outcome_rejected(
      target_value_expr_diagnostic(
        reason: ^target_value_expr_reason_transform_shape_invalid,
        node: body
      )
    )
  } else {
    bind_outcome(
      o: target_transform_positional_operand_binding(node: body, index: 1),
      f: fn(left_binding) {
        bind_outcome(
          o: target_value_expr_arrow_body_scope_binding(
            arrow: arrow,
            body: body,
            binding: left_binding,
            target: target
          ),
          f: fn(scoped_left_binding) {
            bind_outcome(
              o: target_transform_positional_operand_binding(node: body, index: 2),
              f: fn(right_binding) {
                bind_outcome(
                  o: target_value_expr_arrow_body_scope_binding(
                    arrow: arrow,
                    body: body,
                    binding: right_binding,
                    target: target
                  ),
                  f: fn(scoped_right_binding) {
                    outcome_accepted(
                      target_value_expression_primitive_apply(
                        operation: canonical_op,
                        operands: [
                          target_value_expression_binding_ref(
                            binding: scoped_left_binding
                          ),
                          target_value_expression_binding_ref(
                            binding: scoped_right_binding
                          )
                        ]
                      )
                    )
                  }
                )
              }
            )
          }
        )
      }
    )
  }
}

fn target_project_callable_arg_in_arrow_scope(
  arrow: v2.std.node.Node,
  body: v2.std.node.Node,
  arg: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel,
