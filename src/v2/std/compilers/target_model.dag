        target_model_named_edge(
          name: ^target_value_expression_field_value,
          target: value
        )
      ],
      occurrence_id: SyntheticOccurrence
}
  }
}

fn target_value_expression_binding_ref(binding: Symbol) -> TargetValueExpression {
  TargetValueExpression {
    kind: TargetValueExprBindingRef,
    node: Node {
      kind: TypeNode {
        connective: Atom { identity: ^target_value_expression_binding_ref_atom }
      },
      children: [
        target_model_named_edge(
          name: ^target_value_expr_field_binding,
          target: target_model_type_atom_node(identity: binding)
        )
      ],
      occurrence_id: SyntheticOccurrence
    }
  }
}

fn target_value_expr_primitive_apply_operand_edges(
  operands: List<TargetValueExpression>
) -> List<Edge> {
  fold_list_right(
    xs: operands,
    empty: Empty,
    snoc: fn(acc, operand) {
      Cons {
        head: target_model_named_edge(
          name: ^target_value_expr_field_operand,
          target: target_value_expression_node(expr: operand)
        ),
        tail: acc
      }
    }
  )
}

fn target_value_expr_operand_wire_malformed_diagnostic(wire: Node) -> Diagnostic {
  Diagnostic {
    reason: ^target_value_expr_operand_wire_malformed,
    at: node_locus(node: wire),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_value_expr_binding_ref_wire_schema_valid(wire: Node) -> Outcome<Bool> {
  match wire.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id == ^target_value_expression_binding_ref_atom {
        if name_occurrences(
          name: ^target_value_expr_field_binding,
          children: wire.children
        ) != 1 {
          outcome_rejected(
            target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
          )
        } else {
          match fold(
            wire.children,
            init: true,
            f: fn(acc, edge) {
              if acc {
                match edge.label {
                  Named { name: n } => n == ^target_value_expr_field_binding
                  Positional => false
                }
              } else {
                false
              }
            }
          ) {
            true => outcome_accepted(true)
            false =>
              outcome_rejected(
                target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
              )
          }
        }
      } else {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      }
    _ =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

fn target_value_expr_binding_ref_binding_from_wire(wire: Node) -> Outcome<Symbol> {
  match fold(
    wire.children,
    init: optional_absent(),
    f: fn(acc, edge) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match edge.label {
            Named { name: n } =>
              if n == ^target_value_expr_field_binding {
                match edge.target.kind {
                  TypeNode { connective: Atom { identity: id } } =>
                    optional_present(value: id)
                  _ => acc
                }
              } else {
                acc
              }
            Positional => acc
          }
      }
    }
  ) {
    Present { value: binding } => outcome_accepted(binding)
    Absent =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

fn target_value_expr_operand_wire_binding(operand_wire: Node) -> Outcome<Symbol> {
  bind_outcome(
    o: target_value_expr_binding_ref_wire_schema_valid(wire: operand_wire),
    f: fn(_) {
      target_value_expr_binding_ref_binding_from_wire(wire: operand_wire)
    }
  )
}

fn target_value_expr_primitive_apply_wire_schema_valid(wire: Node) -> Outcome<Bool> {
  match wire.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id != ^target_value_expression_primitive_apply_atom {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else if name_occurrences(
        name: ^target_value_expr_field_operation,
        children: wire.children
      ) != 1 {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else {
        match fold(
          wire.children,
          init: true,
          f: fn(acc, edge) {
            if acc {
              match edge.label {
                Named { name: n } =>
                  n == ^target_value_expr_field_operation
                  || n == ^target_value_expr_field_operand
                Positional => false
              }
            } else {
              false
            }
          }
        ) {
          true => outcome_accepted(true)
          false =>
            outcome_rejected(
              target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
            )
        }
      }
    _ =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

fn target_value_expr_primitive_apply_operand_bindings(wire: Node) -> Outcome<List<Symbol>> {
  bind_outcome(
    o: target_value_expr_primitive_apply_wire_schema_valid(wire: wire),
    f: fn(_) {
      match fold(
        wire.children,
        init: Accepted { value: Empty, diagnostics: None },
        f: fn(acc, edge) {
          match acc {
            Rejected { diagnostics: r } => acc
            Accepted { value: bindings, diagnostics: d } =>
              match edge.label {
                Named { name: n } =>
                  if n == ^target_value_expr_field_operation {
                    acc
                  } else if n == ^target_value_expr_field_operand {
                    bind_outcome(
                      o: target_value_expr_operand_wire_binding(operand_wire: edge.target),
                      f: fn(binding) {
                        outcome_accepted(
                          list_snoc_item(xs: bindings, item: binding)
                        )
                      }
                    )
                  } else {
                    outcome_rejected(
                      target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
                    )
                  }
                Positional =>
                  outcome_rejected(
                    target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
                  )
              }
          }
        }
      ) {
        Accepted { value: bindings, diagnostics: d } =>
          Accepted { value: bindings, diagnostics: d }
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    }
  )
}

fn target_value_expression_primitive_apply(
  operation: CanonicalOperation,
  operands: List<TargetValueExpression>
) -> TargetValueExpression {
  TargetValueExpression {
    kind: TargetValueExprPrimitiveApply,
    node: Node {
      kind: TypeNode {
        connective: Atom { identity: ^target_value_expression_primitive_apply_atom }
      },
      children: list_append(
        left: [
          target_model_named_edge(
            name: ^target_value_expr_field_operation,
            target: target_model_canonical_operation_wire_node(operation: operation)
          )
        ],
        right: target_value_expr_primitive_apply_operand_edges(operands: operands)
      ),
      occurrence_id: SyntheticOccurrence
    }
  }
}

// Emit-side constructor for an applied effect. `effect_kind_discriminant` is the discriminant
// Symbol of a v2.std.runtime EffectRequestKind (e.g. discriminant(v: ReadResource)); the caller
// at the value-expression projection boundary supplies it, so this structural substrate reuses
// the runtime effect vocabulary by identity without importing runtime (no parallel vocabulary).
// Operand edges mirror primitive_apply — the lowered effect application carries its argument
// value-expressions positionally for the projection arm (PR2) to emit through the host shim.
fn target_value_expression_effect_apply(
  effect_kind_discriminant: Symbol,
  operands: List<TargetValueExpression>
) -> TargetValueExpression {
  TargetValueExpression {
    kind: TargetValueExprEffectApply,
    node: Node {
      kind: TypeNode {
        connective: Atom { identity: ^target_value_expression_effect_apply_atom }
      },
      children: list_append(
        left: [
          target_model_named_edge(
            name: ^target_value_expr_field_effect_kind,
            target: target_model_type_atom_node(identity: effect_kind_discriminant)
          )
        ],
        right: target_value_expr_primitive_apply_operand_edges(operands: operands)
      ),
      occurrence_id: SyntheticOccurrence
    }
  }
}

// Carrier wire-schema guard for the effect-apply expression node — mirrors
// `target_value_expr_primitive_apply_wire_schema_valid`: the atom must be the effect-apply atom,
// the `effect_kind` discriminant edge must occur exactly once, and every child is either that
// `effect_kind` edge or an `operand` edge. Fail-closed for any other shape.
fn target_value_expr_effect_apply_wire_schema_valid(wire: Node) -> Outcome<Bool> {
  match wire.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id != ^target_value_expression_effect_apply_atom {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else if name_occurrences(
        name: ^target_value_expr_field_effect_kind,
        children: wire.children
      ) != 1 {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else {
        match fold(
          wire.children,
          init: true,
          f: fn(acc, edge) {
            if acc {
              match edge.label {
                Named { name: n } =>
                  n == ^target_value_expr_field_effect_kind
                  || n == ^target_value_expr_field_operand
                Positional => false
              }
            } else {
              false
            }
          }
        ) {
          true => outcome_accepted(true)
          false =>
            outcome_rejected(
              target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
            )
        }
      }
    _ =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

// Recover the stored effect-kind discriminant Symbol (== ^ReadResource / ^WriteResource by
// identity) from the effect-apply carrier wire.
fn target_value_expr_effect_apply_kind_from_wire(wire: Node) -> Outcome<Symbol> {
  match fold(
    wire.children,
    init: optional_absent(),
    f: fn(acc, edge) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match edge.label {
            Named { name: n } =>
              if n == ^target_value_expr_field_effect_kind {
                match edge.target.kind {
                  TypeNode { connective: Atom { identity: id } } =>
                    optional_present(value: id)
                  _ => acc
                }
              } else {
                acc
              }
            Positional => acc
          }
      }
    }
  ) {
    Present { value: kind } => outcome_accepted(kind)
    Absent =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

// Operand binding refs of the effect-apply carrier — mirrors
// `target_value_expr_primitive_apply_operand_bindings`, skipping the `effect_kind` edge instead
// of the `operation` edge. Operands are binding refs (the host shim receives them as arguments).
fn target_value_expr_effect_apply_operand_bindings(wire: Node) -> Outcome<List<Symbol>> {
  bind_outcome(
    o: target_value_expr_effect_apply_wire_schema_valid(wire: wire),
    f: fn(_) {
      match fold(
        wire.children,
        init: Accepted { value: Empty, diagnostics: None },
        f: fn(acc, edge) {
          match acc {
            Rejected { diagnostics: r } => acc
            Accepted { value: bindings, diagnostics: d } =>
              match edge.label {
                Named { name: n } =>
                  if n == ^target_value_expr_field_effect_kind {
                    acc
                  } else if n == ^target_value_expr_field_operand {
                    bind_outcome(
                      o: target_value_expr_operand_wire_binding(operand_wire: edge.target),
                      f: fn(binding) {
                        outcome_accepted(
                          list_snoc_item(xs: bindings, item: binding)
                        )
                      }
                    )
                  } else {
                    outcome_rejected(
                      target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
                    )
                  }
                Positional =>
                  outcome_rejected(
                    target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
                  )
              }
          }
        }
      ) {
        Accepted { value: bindings, diagnostics: d } =>
          Accepted { value: bindings, diagnostics: d }
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    }
  )
}

// Resolve the host shim callee for the stored effect-kind discriminant from the descriptor
// catalog: fold the `callees` rows into a `Map<Symbol, Symbol>`, then take ONE `map_get`. A miss
// fails closed (unsupported-kind diagnostic), never silently emitted. No effect kind is branched on
// or host token named here — the catalog is the sole per-effect authority, so a new
// EffectRequestKind variant extends `callees` by one row and this resolver is untouched.
fn target_value_expr_effect_apply_callee(
  effect_kind: Symbol,
  shape: TargetEffectApplyShape,
  expr: TargetValueExpression
) -> Outcome<Symbol> {
  match map_get(
    m: fold_list(
      xs: shape.callees,
      empty: empty_map(),
      cons: fn(acc, row) { map_insert(acc, row.effect_kind, row.callee) }
    ),
    key: effect_kind
  ) {
    Accepted { value: found, diagnostics: _ } =>
      match found {
        Present { value: callee } => outcome_accepted(callee)
        Absent =>
          outcome_rejected(
            target_value_expression_emit_unsupported_kind_diagnostic(expr: expr)
          )
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

// Emit arm for an applied effect: `callee(operand-binding-refs...)` framed by the descriptor's
// effect-apply shape (open / separator / close), with the callee chosen by the stored effect-kind
// discriminant. Structurally mirrors the primitive `CallIdent` shape.
fn target_value_expression_effect_apply_to_concrete_tokens(
  expr: TargetValueExpression,
  projection: TargetValueExpressionProjection
) -> Outcome<List<ConcreteSyntaxToken>> {
  bind_outcome(
    o: target_value_expr_effect_apply_kind_from_wire(wire: expr.node),
    f: fn(effect_kind) {
      bind_outcome(
        o: target_value_expr_effect_apply_callee(
          effect_kind: effect_kind,
          shape: projection.effect_apply_form,
          expr: expr
        ),
        f: fn(callee) {
          bind_outcome(
            o: target_value_expr_effect_apply_operand_bindings(wire: expr.node),
            f: fn(bindings) {
              // Host-call order: `callee ( args )` — callee precedes the open paren so the
              // emitted text is a valid target-language call expression (not Lisp-prefix).
              outcome_accepted(
                list_append(
                  left: list_append(
                    left: Cons {
                      head: FixedToken { token_class: callee },
                      tail: Cons {
                        head: FixedToken { token_class: projection.effect_apply_form.open },
                        tail: Empty
                      }
                    },
                    right: target_value_expression_binding_refs_intersperse_separator(
                      bindings: bindings,
                      projection: projection,
                      separator: projection.effect_apply_form.separator
                    )
                  ),
                  right: Cons {
                    head: FixedToken { token_class: projection.effect_apply_form.close },
                    tail: Empty
                  }
                )
              )
            }
          )
        }
      )
    }
  )
}

fn target_value_expression_conditional(
  condition: TargetValueExpression,
  then_arm: TargetValueExpression,
  else_arm: TargetValueExpression
) -> TargetValueExpression {
  TargetValueExpression {
    kind: TargetValueExprConditional,
    node: Node {
      kind: TypeNode {
        connective: Atom { identity: ^target_value_expression_conditional_atom }
      },
      children: [
        target_model_named_edge(
          name: ^target_value_expr_field_branch_condition,
          target: condition.node
        ),
        target_model_named_edge(
          name: ^target_value_expr_field_branch_then_arm,
          target: then_arm.node
        ),
        target_model_named_edge(
          name: ^target_value_expr_field_branch_else_arm,
          target: else_arm.node
        )
      ],
      occurrence_id: SyntheticOccurrence
    }
  }
}

fn target_value_expression_bind_let(
  bind_key: TargetValueExpression,
  bind_value: TargetValueExpression,
  bind_body: TargetValueExpression
) -> TargetValueExpression {
  TargetValueExpression {
    kind: TargetValueExprBindLet,
    node: Node {
      kind: TypeNode {
        connective: Atom { identity: ^target_value_expression_bind_let_atom }
      },
      children: [
        target_model_named_edge(
          name: ^target_value_expr_field_bind_key,
          target: bind_key.node
        ),
        target_model_named_edge(
          name: ^target_value_expr_field_bind_value,
          target: bind_value.node
        ),
        target_model_named_edge(
          name: ^target_value_expr_field_bind_body,
          target: bind_body.node
        )
      ],
      occurrence_id: SyntheticOccurrence
    }
  }
}

fn target_value_expression_loop(body: TargetValueExpression) -> TargetValueExpression {
  TargetValueExpression {
    kind: TargetValueExprLoop,
    node: Node {
      kind: TypeNode {
        connective: Atom { identity: ^target_value_expression_loop_atom }
      },
      children: [
        target_model_named_edge(
          name: ^target_value_expr_field_loop_body,
          target: body.node
        )
      ],
      occurrence_id: SyntheticOccurrence
    }
  }
}

type TargetValueExprFieldInitSlot {
  label: Symbol
  value: TargetValueExpression
}

fn target_value_expr_field_init_slot_edges(slots: List<TargetValueExprFieldInitSlot>) -> List<Edge> {
  fold(slots, init: Empty, f: fn(acc, slot) {
    list_snoc_item(
      xs: acc,
      item: target_model_named_edge(name: slot.label, target: slot.value.node)
    )
  })
}

fn target_value_expression_record_construct(
  type_name: Symbol,
  fields: List<TargetValueExprFieldInitSlot>
) -> TargetValueExpression {
  TargetValueExpression {
    kind: TargetValueExprRecordConstruct,
    node: Node {
      kind: TypeNode {
        connective: Atom { identity: ^target_value_expression_record_construct_atom }
      },
      children: list_append(
        left: [
          target_model_named_edge(
            name: ^target_value_expr_field_record_type,
            target: Node {
              kind: TypeNode { connective: Atom { identity: type_name } },
              children: [],
              occurrence_id: SyntheticOccurrence
            }
          )
        ],
        right: target_value_expr_field_init_slot_edges(slots: fields)
      ),
      occurrence_id: SyntheticOccurrence
    }
  }
}

fn target_value_expression_field_access(
  base: TargetValueExpression,
  field_name: Symbol
) -> TargetValueExpression {
  TargetValueExpression {
    kind: TargetValueExprFieldAccess,
    node: Node {
      kind: TypeNode {
        connective: Atom { identity: ^target_value_expression_field_access_atom }
      },
      children: [
        target_model_named_edge(
          name: ^target_value_expr_field_field_access_base,
          target: base.node
        ),
        target_model_named_edge(
          name: ^target_value_expr_field_field_access_field,
          target: Node {
            kind: TypeNode { connective: Atom { identity: field_name } },
            children: [],
            occurrence_id: SyntheticOccurrence
          }
        )
      ],
      occurrence_id: SyntheticOccurrence
    }
  }
}

type TargetValueExprMatchArmSlot {
  pattern: TargetValueExpression
  body: TargetValueExpression
}

type TargetValueExprMatchArmEdgeFold {
  edges: List<Edge>
  skipped_scrutinee: Bool
}

fn target_value_expr_positional_child_optional(node: Node, index: Int) -> Optional<Node> {
  list_at_optional(xs: node_positional_child_targets(node: node), index: index)
}

fn target_value_expr_match_arm_edges_after_scrutinee(children: List<Edge>) -> List<Edge> {
  let folded = fold(
    children,
    init: TargetValueExprMatchArmEdgeFold { edges: Empty, skipped_scrutinee: false },
    f: fn(acc, edge) {
      match edge.label {
        Positional =>
          if !acc.skipped_scrutinee {
            TargetValueExprMatchArmEdgeFold {
              edges: acc.edges,
              skipped_scrutinee: true
            }
          } else {
            TargetValueExprMatchArmEdgeFold {
              edges: list_snoc_item(xs: acc.edges, item: edge),
              skipped_scrutinee: true
            }
          }
        Named { name: _ } => acc
      }
    }
  )
  folded.edges
}

fn target_value_expr_match_arm_wire(arm: TargetValueExprMatchArmSlot) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      target_model_named_edge(name: match_arm_pattern, target: arm.pattern.node),
      target_model_named_edge(name: match_arm_body, target: arm.body.node)
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn target_value_expr_match_arm_edges(arms: List<TargetValueExprMatchArmSlot>) -> List<Edge> {
  fold(arms, init: Empty, f: fn(acc, arm) {
    list_snoc_item(xs: acc, item: Edge { label: Positional, target: target_value_expr_match_arm_wire(arm: arm) })
  })
}

fn target_value_expression_match(
  scrutinee: TargetValueExpression,
  arms: List<TargetValueExprMatchArmSlot>
) -> TargetValueExpression {
  TargetValueExpression {
    kind: TargetValueExprMatch,
    node: Node {
      kind: TypeNode {
        connective: Atom { identity: ^target_value_expression_match_atom }
      },
      children: list_append(
        left: [
          target_model_named_edge(
            name: ^target_value_expr_field_match_scrutinee,
            target: scrutinee.node
          )
        ],
        right: target_value_expr_match_arm_edges(arms: arms)
      ),
      occurrence_id: SyntheticOccurrence
    }
  }
}

// Lane 2c — callable-apply wire: a `callee` atom edge followed by one `callable_arg` edge per
// positional argument (order preserved; args extracted by an order-preserving fold, never by
// content_hash reorder). Mirrors primitive_apply's operand-edge layout but the head is a callee
// binding rather than a canonical-operation row.
fn target_value_expr_callable_arg_edges(
  args: List<TargetValueExpression>
) -> List<Edge> {
  fold_list_right(
    xs: args,
    empty: Empty,
    snoc: fn(acc, arg) {
      Cons {
        head: target_model_named_edge(
          name: ^target_value_expr_field_callable_arg,
          target: target_value_expression_node(expr: arg)
        ),
        tail: acc
      }
    }
  )
}

fn target_value_expression_callable_apply(
  callee: Symbol,
  args: List<TargetValueExpression>
) -> TargetValueExpression {
  TargetValueExpression {
    kind: TargetValueExprCallableApply,
    node: Node {
      kind: TypeNode {
        connective: Atom { identity: ^target_value_expression_callable_apply_atom }
      },
      children: list_append(
        left: [
          target_model_named_edge(
            name: ^target_value_expr_field_callee,
            target: target_model_type_atom_node(identity: callee)
          )
        ],
        right: target_value_expr_callable_arg_edges(args: args)
      ),
      occurrence_id: SyntheticOccurrence
    }
  }
}

// Lane 2c — closure wire: one `closure_param` atom edge per param (order preserved) followed by a
// single `closure_body` edge carrying the body value-expression.
fn target_value_expr_closure_param_edges(params: List<Symbol>) -> List<Edge> {
  fold_list_right(
    xs: params,
    empty: Empty,
    snoc: fn(acc, param) {
      Cons {
        head: target_model_named_edge(
          name: ^target_value_expr_field_closure_param,
          target: target_model_type_atom_node(identity: param)
        ),
        tail: acc
      }
    }
  )
}

fn target_value_expression_closure(
  params: List<Symbol>,
  body: TargetValueExpression
) -> TargetValueExpression {
  TargetValueExpression {
    kind: TargetValueExprClosure,
    node: Node {
      kind: TypeNode {
        connective: Atom { identity: ^target_value_expression_closure_atom }
      },
      children: list_append(
        left: target_value_expr_closure_param_edges(params: params),
        right: [
          target_model_named_edge(
            name: ^target_value_expr_field_closure_body,
            target: body.node
          )
        ]
      ),
      occurrence_id: SyntheticOccurrence
    }
  }
}


fn target_value_expression_emit_unsupported_kind_diagnostic(expr: TargetValueExpression) -> Diagnostic {
  Diagnostic {
    reason: ^target_value_expression_emit_unsupported_kind,
    at: node_locus(node: expr.node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_value_expression_emit_operator_shape_unsupported_diagnostic(expr: TargetValueExpression) -> Diagnostic {
  Diagnostic {
    reason: ^target_value_expression_emit_operator_shape_unsupported,
    at: node_locus(node: expr.node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_value_expression_emit_primitive_apply_arity_invalid_diagnostic(expr: TargetValueExpression) -> Diagnostic {
  Diagnostic {
    reason: ^target_value_expression_emit_primitive_apply_arity_invalid,
    at: node_locus(node: expr.node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_operator_realization_catalog_miss_diagnostic(catalog: Node) -> Diagnostic {
  Diagnostic {
    reason: ^target_operator_realization_catalog_miss,
    at: node_locus(node: catalog),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_operator_realization_catalog_ambiguous_diagnostic(catalog: Node) -> Diagnostic {
  Diagnostic {
    reason: ^target_operator_realization_catalog_ambiguous,
    at: node_locus(node: catalog),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_operator_realization_row_matches_canonical_op(
  row: Node,
  canonical_op: CanonicalOperation
) -> Bool {
  match find_named_child(root: row, name: ^target_operator_realization_field_operation) {
    Accepted { value: operation_wire, diagnostics: _ } =>
      canonical_operation_wire_matches_operation(
        wire: operation_wire,
        operation: canonical_op
      )
    Rejected { diagnostics: _ } => false
  }
}

fn target_operator_realization_catalog_wire_schema_valid(catalog: Node) -> Outcome<Bool> {
  match catalog.kind {
    TypeNode { connective: Conj } =>
      match fold(
        catalog.children,
        init: true,
        f: fn(acc, e) {
          if acc {
            match e.label {
              Positional => false
              Named { name: n } => n == ^target_operator_realization_row_edge
            }
          } else {
            false
          }
        }
      ) {
        true => outcome_accepted(true)
        false =>
          outcome_rejected(
            target_operator_realization_catalog_miss_diagnostic(catalog: catalog)
          )
      }
    _ =>
      outcome_rejected(
        target_operator_realization_catalog_miss_diagnostic(catalog: catalog)
      )
  }
}

fn target_operator_realization_catalog_lookup_step(
  acc: PassingCandidateFold,
  row_node: Node,
  canonical_op: CanonicalOperation
) -> PassingCandidateFold {
  match target_operator_realization_row_wire_schema_valid(row: row_node) {
    Accepted { value: _, diagnostics: _ } =>
      if target_operator_realization_row_matches_canonical_op(
        row: row_node,
        canonical_op: canonical_op
      ) {
        match acc {
          NoPassingCandidate => OnePassingCandidate { candidate: row_node }
          OnePassingCandidate { candidate: _ } => ManyPassingCandidates
          ManyPassingCandidates => ManyPassingCandidates
        }
      } else {
        acc
      }
    Rejected { diagnostics: _ } => acc
  }
}

fn target_operator_realization_catalog_lookup(
  catalog: Node,
  canonical_op: CanonicalOperation
) -> Outcome<TargetOperatorRealization> {
  bind_outcome(
    o: target_operator_realization_catalog_wire_schema_valid(catalog: catalog),
    f: fn(_) {
      match catalog.kind {
        TypeNode { connective: Conj } =>
          match fold(
            catalog.children,
            init: NoPassingCandidate,
            f: fn(acc, e) {
              match e.label {
                Named { name: n } =>
                  if n == ^target_operator_realization_row_edge {
                    target_operator_realization_catalog_lookup_step(
                      acc: acc,
                      row_node: e.target,
                      canonical_op: canonical_op
                    )
                  } else {
                    acc
                  }
                Positional => acc
              }
            }
          ) {
            NoPassingCandidate =>
              outcome_rejected(
                target_operator_realization_catalog_miss_diagnostic(catalog: catalog)
              )
            OnePassingCandidate { candidate: row_node } =>
              target_operator_realization_from_wire_row(row: row_node)
            ManyPassingCandidates =>
              outcome_rejected(
                target_operator_realization_catalog_ambiguous_diagnostic(catalog: catalog)
              )
          }
        _ =>
          outcome_rejected(
            target_operator_realization_catalog_miss_diagnostic(catalog: catalog)
          )
      }
    }
  )
}

fn target_value_expr_primitive_apply_operation_from_wire(wire: Node) -> Outcome<CanonicalOperation> {
  match fold(
    wire.children,
    init: optional_absent(),
    f: fn(acc, e) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match e.label {
            Named { name: n } =>
              if n == ^target_value_expr_field_operation {
                match canonical_operation_from_wire_node(wire: e.target) {
                  Accepted { value: canonical_op, diagnostics: _ } =>
                    optional_present(value: canonical_op)
                  Rejected { diagnostics: _ } => acc
                }
              } else {
                acc
              }
            Positional => acc
          }
      }
    }
  ) {
    Present { value: canonical_op } => outcome_accepted(canonical_op)
    Absent =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

fn target_value_expression_binding_ref_token(
  binding: Symbol,
  projection: TargetValueExpressionProjection
) -> ConcreteSyntaxToken {
  BoundToken {
    token_class: projection.binding_ref_form.ident_token,
    binding: binding
  }
}

fn target_value_expression_binding_refs_intersperse_separator(
  bindings: List<Symbol>,
  projection: TargetValueExpressionProjection,
  separator: Symbol
) -> List<ConcreteSyntaxToken> {
  fold_list_right(
    xs: bindings,
    empty: Empty,
    snoc: fn(acc, binding) {
      let token = target_value_expression_binding_ref_token(
        binding: binding,
        projection: projection
      )
      match acc {
        Empty => Cons { head: token, tail: Empty }
        _ =>
          Cons {
            head: token,
            tail: Cons {
              head: FixedToken { token_class: separator },
              tail: acc
            }
          }
      }
    }
  )
}

fn target_operator_shape_emit_primitive_apply_tokens(
  shape: TargetOperatorShape,
  projection: TargetValueExpressionProjection,
  bindings: List<Symbol>,
  expr: TargetValueExpression
) -> Outcome<List<ConcreteSyntaxToken>> {
  match shape {
    InfixToken { token: op_token } =>
      if length(xs: bindings) != 2 {
        outcome_rejected(
          target_value_expression_emit_primitive_apply_arity_invalid_diagnostic(expr: expr)
        )
      } else {
        match list_at_optional(xs: bindings, index: 0) {
          Absent =>
            outcome_rejected(
              target_value_expression_emit_primitive_apply_arity_invalid_diagnostic(expr: expr)
            )
          Present { value: left_binding } =>
            match list_at_optional(xs: bindings, index: 1) {
              Absent =>
                outcome_rejected(
                  target_value_expression_emit_primitive_apply_arity_invalid_diagnostic(expr: expr)
                )
              Present { value: right_binding } =>
                outcome_accepted(
                  Cons {
                    head: target_value_expression_binding_ref_token(
                      binding: left_binding,
                      projection: projection
                    ),
                    tail: Cons {
                      head: FixedToken { token_class: op_token },
                      tail: Cons {
                        head: target_value_expression_binding_ref_token(
                          binding: right_binding,
                          projection: projection
                        ),
                        tail: Empty
                      }
                    }
                  }
                )
            }
        }
      }
    PrefixToken { token: op_token } =>
      if length(xs: bindings) != 1 {
        outcome_rejected(
          target_value_expression_emit_primitive_apply_arity_invalid_diagnostic(expr: expr)
        )
      } else {
        match list_at_optional(xs: bindings, index: 0) {
          Absent =>
            outcome_rejected(
              target_value_expression_emit_primitive_apply_arity_invalid_diagnostic(expr: expr)
            )
          Present { value: binding } =>
            outcome_accepted(
              Cons {
                head: FixedToken { token_class: op_token },
                tail: Cons {
                  head: target_value_expression_binding_ref_token(
                    binding: binding,
                    projection: projection
                  ),
                  tail: Empty
                }
              }
            )
        }
      }
    CallIdent { ident: callee } =>
      outcome_accepted(
        list_append(
          left: list_append(
            left: Cons {
              head: FixedToken { token_class: projection.primitive_apply_form.open },
              tail: Cons {
                head: FixedToken { token_class: callee },
                tail: Empty
              }
            },
            right: target_value_expression_binding_refs_intersperse_separator(
              bindings: bindings,
              projection: projection,
              separator: projection.primitive_apply_form.separator
            )
          ),
          right: Cons {
            head: FixedToken { token_class: projection.primitive_apply_form.close },
            tail: Empty
          }
        )
      )
    MethodIdent { ident: _ } =>
      outcome_rejected(
        target_value_expression_emit_operator_shape_unsupported_diagnostic(expr: expr)
      )
  }
}

fn target_value_expression_primitive_apply_to_concrete_tokens(
  expr: TargetValueExpression,
  projection: TargetValueExpressionProjection,
  catalog: Node
) -> Outcome<List<ConcreteSyntaxToken>> {
  bind_outcome(
    o: target_value_expr_primitive_apply_wire_schema_valid(wire: expr.node),
    f: fn(_) {
      bind_outcome(
        o: target_value_expr_primitive_apply_operation_from_wire(wire: expr.node),
        f: fn(canonical_op) {
          bind_outcome(
            o: target_value_expr_primitive_apply_operand_bindings(wire: expr.node),
            f: fn(bindings) {
              bind_outcome(
                o: target_operator_realization_catalog_lookup(
                  catalog: catalog,
                  canonical_op: canonical_op
                ),
                f: fn(operator_row) {
                  target_operator_shape_emit_primitive_apply_tokens(
                    shape: operator_row.shape,
                    projection: projection,
                    bindings: bindings,
                    expr: expr
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn target_value_expression_binding_ref_to_concrete_tokens(
  expr: TargetValueExpression,
  projection: TargetValueExpressionProjection
) -> Outcome<List<ConcreteSyntaxToken>> {
  bind_outcome(
    o: target_value_expr_binding_ref_binding_from_wire(wire: expr.node),
    f: fn(binding) {
      outcome_accepted(
        Cons {
          head: target_value_expression_binding_ref_token(
            binding: binding,
            projection: projection
          ),
          tail: Empty
        }
      )
    }
  )
}

fn target_value_expression_symbol_identity_from_wire(wire: Node) -> Outcome<Symbol> {
  match fold(
    wire.children,
    init: optional_absent(),
    f: fn(acc, edge) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match edge.label {
            Named { name: n } =>
              if n == ^target_value_expression_field_identity {
                match edge.target.kind {
                  TypeNode { connective: Atom { identity: id } } =>
                    optional_present(value: id)
                  _ => acc
                }
              } else {
                acc
              }
            Positional => acc
          }
      }
    }
  ) {
    Present { value: id } => outcome_accepted(id)
    Absent =>
      outcome_rejected(
        target_value_expression_emit_unsupported_kind_diagnostic(
          expr: TargetValueExpression {
            kind: TargetValueExprSymbolIdentity,
            node: wire
          }
        )
      )
  }
}

fn target_value_expression_reify_from_wire(wire: Node) -> Outcome<TargetValueExpression> {
  match wire.kind {
    TypeNode { connective: Atom { identity: atom_id } } =>
      if atom_id == ^target_value_expression_binding_ref_atom {
        outcome_accepted(
          TargetValueExpression {
            kind: TargetValueExprBindingRef,
            node: wire
          }
        )
      } else if atom_id == ^target_value_expression_symbol_identity_atom {
        outcome_accepted(
          TargetValueExpression {
            kind: TargetValueExprSymbolIdentity,
            node: wire
          }
        )
      } else if atom_id == ^target_value_expression_conditional_atom {
        outcome_accepted(
          TargetValueExpression {
            kind: TargetValueExprConditional,
            node: wire
          }
        )
      } else if atom_id == ^target_value_expression_bind_let_atom {
        outcome_accepted(
          TargetValueExpression {
            kind: TargetValueExprBindLet,
            node: wire
          }
        )
      } else if atom_id == ^target_value_expression_loop_atom {
        outcome_accepted(
          TargetValueExpression {
            kind: TargetValueExprLoop,
            node: wire
          }
        )
      } else if atom_id == ^target_value_expression_primitive_apply_atom {
        outcome_accepted(
          TargetValueExpression {
            kind: TargetValueExprPrimitiveApply,
            node: wire
          }
        )
      } else if atom_id == ^target_value_expression_record_construct_atom {
        outcome_accepted(
          TargetValueExpression {
            kind: TargetValueExprRecordConstruct,
            node: wire
          }
        )
      } else if atom_id == ^target_value_expression_field_access_atom {
        outcome_accepted(
          TargetValueExpression {
            kind: TargetValueExprFieldAccess,
            node: wire
          }
        )
      } else if atom_id == ^target_value_expression_match_atom {
        outcome_accepted(
          TargetValueExpression {
            kind: TargetValueExprMatch,
            node: wire
          }
        )
      } else if atom_id == ^target_value_expression_callable_apply_atom {
        outcome_accepted(
          TargetValueExpression {
            kind: TargetValueExprCallableApply,
            node: wire
          }
        )
      } else if atom_id == ^target_value_expression_closure_atom {
        outcome_accepted(
          TargetValueExpression {
            kind: TargetValueExprClosure,
            node: wire
          }
        )
      } else {
        outcome_rejected(
          target_value_expression_emit_unsupported_kind_diagnostic(
            expr: TargetValueExpression {
              kind: TargetValueExprSymbolIdentity,
              node: wire
            }
          )
        )
      }
    _ =>
      outcome_rejected(
        target_value_expression_emit_unsupported_kind_diagnostic(
          expr: TargetValueExpression {
            kind: TargetValueExprSymbolIdentity,
            node: wire
          }
        )
      )
  }
}

fn target_value_expr_conditional_wire_schema_valid(wire: Node) -> Outcome<Bool> {
  match wire.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id != ^target_value_expression_conditional_atom {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else if name_occurrences(
        name: ^target_value_expr_field_branch_condition,
        children: wire.children
      ) != 1 {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else if name_occurrences(
        name: ^target_value_expr_field_branch_then_arm,
        children: wire.children
      ) != 1 {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else if name_occurrences(
        name: ^target_value_expr_field_branch_else_arm,
        children: wire.children
      ) != 1 {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else {
        outcome_accepted(true)
      }
    _ =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

fn target_value_expr_conditional_child_from_wire(
  wire: Node,
  field: Symbol
) -> Outcome<TargetValueExpression> {
  match fold(
    wire.children,
    init: optional_absent(),
    f: fn(acc, edge) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match edge.label {
            Named { name: n } =>
              if n == field {
                optional_present(value: edge.target)
              } else {
                acc
              }
            Positional => acc
          }
      }
    }
  ) {
    Present { value: child } =>
      target_value_expression_reify_from_wire(wire: child)
    Absent =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

fn target_value_expr_bind_let_wire_schema_valid(wire: Node) -> Outcome<Bool> {
  match wire.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id != ^target_value_expression_bind_let_atom {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else if name_occurrences(
        name: ^target_value_expr_field_bind_key,
        children: wire.children
      ) != 1 {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else if name_occurrences(
        name: ^target_value_expr_field_bind_value,
        children: wire.children
      ) != 1 {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else if name_occurrences(
        name: ^target_value_expr_field_bind_body,
        children: wire.children
      ) != 1 {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      } else {
        outcome_accepted(true)
      }
    _ =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

fn target_value_expr_bind_let_child_from_wire(
  wire: Node,
  field: Symbol
) -> Outcome<TargetValueExpression> {
  target_value_expr_conditional_child_from_wire(wire: wire, field: field)
}

fn target_value_expression_bind_let_to_concrete_tokens(
  expr: TargetValueExpression,
  projection: TargetValueExpressionProjection,
  catalog: Node
) -> Outcome<List<ConcreteSyntaxToken>> {
  bind_outcome(
    o: target_value_expr_bind_let_wire_schema_valid(wire: expr.node),
    f: fn(_) {
      bind_outcome(
        o: target_value_expr_bind_let_child_from_wire(
          wire: expr.node,
          field: ^target_value_expr_field_bind_key
        ),
        f: fn(bind_key) {
          bind_outcome(
            o: target_value_expr_bind_let_child_from_wire(
              wire: expr.node,
              field: ^target_value_expr_field_bind_value
            ),
            f: fn(bind_value) {
              bind_outcome(
                o: target_value_expr_bind_let_child_from_wire(
                  wire: expr.node,
                  field: ^target_value_expr_field_bind_body
                ),
                f: fn(bind_body) {
                  bind_outcome(
                    o: target_value_expression_to_concrete_tokens(
                      expr: bind_key,
                      projection: projection,
                      catalog: catalog
                    ),
                    f: fn(key_tokens) {
                      bind_outcome(
                        o: target_value_expression_to_concrete_tokens(
                          expr: bind_value,
                          projection: projection,
                          catalog: catalog
                        ),
                        f: fn(value_tokens) {
                          bind_outcome(
                            o: target_value_expression_to_concrete_tokens(
                              expr: bind_body,
                              projection: projection,
                              catalog: catalog
                            ),
                            f: fn(body_tokens) {
                              outcome_accepted(
                                list_append(
                                  left: list_append(
                                    left: list_append(
                                      left: list_append(
                                        left: list_append(
                                          left: Cons {
                                            head: FixedToken {
                                              token_class: projection.let_form.let_token
                                            },
                                            tail: Empty
                                          },
                                          right: key_tokens
                                        ),
                                        right: Cons {
                                          head: FixedToken {
                                            token_class: projection.let_form.assign_token
                                          },
                                          tail: Empty
                                        }
                                      ),
                                      right: value_tokens
                                    ),
                                    right: Cons {
                                      head: FixedToken {
                                        token_class: projection.let_form.in_token
                                      },
                                      tail: Empty
                                    }
                                  ),
                                  right: body_tokens
                                )
                              )
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

