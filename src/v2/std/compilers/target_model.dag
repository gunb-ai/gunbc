                node: base_node,
                target: target,
                source_bool_form: source_bool_form,
                handle_transform: handle_transform
              ),
              f: fn(projected_base) {
                match field_node.kind {
                  TypeNode { connective: Atom { identity: field_name } } =>
                    outcome_accepted(
                      target_value_expression_field_access(
                        base: projected_base,
                        field_name: field_name
                      )
                    )
                  _ =>
                    outcome_rejected(
                      target_value_expr_diagnostic(
                        reason: ^target_value_expr_reason_transform_shape_invalid,
                        node: body
                      )
                    )
                }
              }
            )
        }
    }
  }
}

fn target_value_expr_match_gate(node: v2.std.node.Node) -> Bool {
  match node.kind {
    ComputationNode { behavior: Match } =>
      length(xs: node_positional_child_targets(node: node)) == 3
        && match_arm_children_conform_skip_first(
          children: node.children,
          skipped_scrutinee: false
        )
    _ => false
  }
}

fn target_value_expr_match_arm_slot_from_arm_edge(
  arrow: v2.std.node.Node,
  arm_edge: v2.std.node.Edge,
  target: v2.std.compilers.target_model.TargetModel,
  source_bool_form: v2.std.compilers.target_model.TargetBoolLiteralShape,
  handle_transform: fn(v2.std.node.Node, v2.std.node.Node, v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression>
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExprMatchArmSlot> {
  bind_outcome(
    o: find_named_child(root: arm_edge.target, name: match_arm_pattern),
    f: fn(pattern_node) {
      bind_outcome(
        o: find_named_child(root: arm_edge.target, name: match_arm_body),
        f: fn(body_node) {
          bind_outcome(
            o: target_value_expr_project_body_subexpression(
              arrow: arrow,
              node: pattern_node,
              target: target,
              source_bool_form: source_bool_form,
              handle_transform: handle_transform
            ),
            f: fn(projected_pattern) {
              bind_outcome(
                o: target_value_expr_project_body_subexpression(
                  arrow: arrow,
                  node: body_node,
                  target: target,
                  source_bool_form: source_bool_form,
                  handle_transform: handle_transform
                ),
                f: fn(projected_body) {
                  outcome_accepted(
                    TargetValueExprMatchArmSlot {
                      pattern: projected_pattern,
                      body: projected_body
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn target_value_expr_match_project_arms(
  arrow: v2.std.node.Node,
  children: v2.std.collection.List<v2.std.node.Edge>,
  target: v2.std.compilers.target_model.TargetModel,
  source_bool_form: v2.std.compilers.target_model.TargetBoolLiteralShape,
  handle_transform: fn(v2.std.node.Node, v2.std.node.Node, v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression>
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.TargetValueExprMatchArmSlot>> {
  match fold(
    target_value_expr_match_arm_edges_after_scrutinee(children: children),
    init: v2.std.diagnostic.Accepted { value: std.algebra.Empty, diagnostics: v2.std.diagnostic.None },
    f: fn(acc, arm_edge) {
      match acc {
        Rejected { diagnostics: r } => acc
        Accepted { value: slots, diagnostics: d } =>
          bind_outcome(
            o: target_value_expr_match_arm_slot_from_arm_edge(
              arrow: arrow,
              arm_edge: arm_edge,
              target: target,
              source_bool_form: source_bool_form,
              handle_transform: handle_transform
            ),
            f: fn(arm) {
              outcome_accepted(list_snoc_item(xs: slots, item: arm))
            }
          )
      }
    }
  ) {
    Accepted { value: slots, diagnostics: d } => v2.std.diagnostic.Accepted { value: slots, diagnostics: d }
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn target_project_match(
  arrow: v2.std.node.Node,
  body: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel,
  source_bool_form: v2.std.compilers.target_model.TargetBoolLiteralShape,
  handle_transform: fn(v2.std.node.Node, v2.std.node.Node, v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression>
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression> {
  if !target_value_expr_match_gate(node: body) {
    outcome_rejected(
      target_value_expr_diagnostic(
        reason: ^target_value_expr_reason_transform_shape_invalid,
        node: body
      )
    )
  } else {
    match list_at_optional(xs: node_positional_child_targets(node: body), index: 0) {
      Absent =>
        outcome_rejected(
          target_value_expr_diagnostic(
            reason: ^target_value_expr_reason_transform_shape_invalid,
            node: body
          )
        )
      Present { value: scrutinee_node } =>
        bind_outcome(
          o: target_value_expr_project_body_subexpression(
            arrow: arrow,
            node: scrutinee_node,
            target: target,
            source_bool_form: source_bool_form,
            handle_transform: handle_transform
          ),
          f: fn(projected_scrutinee) {
            bind_outcome(
              o: target_value_expr_match_project_arms(
                arrow: arrow,
                children: body.children,
                target: target,
                source_bool_form: source_bool_form,
                handle_transform: handle_transform
              ),
              f: fn(projected_arms) {
                outcome_accepted(
                  target_value_expression_match(
                    scrutinee: projected_scrutinee,
                    arms: projected_arms
                  )
                )
              }
            )
          }
        )
    }
  }
}

fn target_project_branch_bool_if_else(
  arrow: v2.std.node.Node,
  body: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel,
  source_bool_form: v2.std.compilers.target_model.TargetBoolLiteralShape,
  handle_transform: fn(v2.std.node.Node, v2.std.node.Node, v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression>
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression> {
  bind_outcome(
    o: target_value_expression_projection_from_target(target: target),
    f: fn(projection) {
      if !target_value_expr_branch_bool_gate(node: body, source_bool_form: source_bool_form) {
        outcome_rejected(
          target_value_expr_diagnostic(
            reason: ^target_value_expr_reason_transform_shape_invalid,
            node: body
          )
        )
      } else {
        match list_at_optional(xs: node_positional_child_targets(node: body), index: 0) {
      Absent =>
        outcome_rejected(
          target_value_expr_diagnostic(
            reason: ^target_value_expr_reason_transform_shape_invalid,
            node: body
          )
        )
      Present { value: cond } =>
        match list_at_optional(xs: node_positional_child_targets(node: body), index: 1) {
          Absent =>
            outcome_rejected(
              target_value_expr_diagnostic(
                reason: ^target_value_expr_reason_transform_shape_invalid,
                node: body
              )
            )
          Present { value: then_arm } =>
            match list_at_optional(xs: node_positional_child_targets(node: body), index: 2) {
              Absent =>
                outcome_rejected(
                  target_value_expr_diagnostic(
                    reason: ^target_value_expr_reason_transform_shape_invalid,
                    node: body
                  )
                )
              Present { value: else_arm } =>
                bind_outcome(
                  o: target_value_expr_project_body_subexpression(
                    arrow: arrow,
                    node: cond,
                    target: target,
                    source_bool_form: source_bool_form,
                    handle_transform: handle_transform
                  ),
                  f: fn(projected_cond) {
                    bind_outcome(
                      o: target_value_expr_project_body_subexpression(
                        arrow: arrow,
                        node: then_arm,
                        target: target,
                        source_bool_form: source_bool_form,
                        handle_transform: handle_transform
                      ),
                      f: fn(projected_then) {
                        bind_outcome(
                          o: target_value_expr_project_body_subexpression(
                            arrow: arrow,
                            node: else_arm,
                            target: target,
                            source_bool_form: source_bool_form,
                            handle_transform: handle_transform
                          ),
                          f: fn(projected_else) {
                            outcome_accepted(
                              target_value_expression_conditional(
                                condition: projected_cond,
                                then_arm: projected_then,
                                else_arm: projected_else
                              )
                            )
                          }
                        )
                      }
                    )
                  }
                )
            }
        }
      }
      }
    }
  )
}

fn target_value_expr_bind_let_gate(node: v2.std.node.Node) -> Bool {
  match node.kind {
    ComputationNode { behavior: Bind } =>
      length(xs: node_positional_child_targets(node: node)) == 3
    _ => false
  }
}

fn target_value_expr_loop_gate(node: v2.std.node.Node) -> Bool {
  match node.kind {
    ComputationNode { behavior: Loop } =>
      length(xs: node_positional_child_targets(node: node)) >= 1
    _ => false
  }
}

fn target_project_bind_let(
  arrow: v2.std.node.Node,
  body: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel,
  source_bool_form: v2.std.compilers.target_model.TargetBoolLiteralShape,
  handle_transform: fn(v2.std.node.Node, v2.std.node.Node, v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression>
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression> {
  if !target_value_expr_bind_let_gate(node: body) {
    outcome_rejected(
      target_value_expr_diagnostic(
        reason: ^target_value_expr_reason_transform_shape_invalid,
        node: body
      )
    )
  } else {
    bind_outcome(
      o: target_transform_positional_operand_binding(node: body, index: 0),
      f: fn(key_binding) {
        bind_outcome(
          o: target_transform_positional_operand_binding(node: body, index: 2),
          f: fn(body_binding) {
            match list_at_optional(xs: node_positional_child_targets(node: body), index: 1) {
              Absent =>
                outcome_rejected(
                  target_value_expr_diagnostic(
                    reason: ^target_value_expr_reason_transform_shape_invalid,
                    node: body
                  )
                )
              Present { value: value_node } =>
                bind_outcome(
                  o: target_value_expr_project_body_subexpression(
                    arrow: arrow,
                    node: value_node,
                    target: target,
                    source_bool_form: source_bool_form,
                    handle_transform: handle_transform
                  ),
                  f: fn(projected_value) {
                    outcome_accepted(
                      target_value_expression_bind_let(
                        bind_key: target_value_expression_binding_ref(binding: key_binding),
                        bind_value: projected_value,
                        bind_body: target_value_expression_binding_ref(binding: body_binding)
                      )
                    )
                  }
                )
            }
          }
        )
      }
    )
  }
}

fn target_project_loop(
  arrow: v2.std.node.Node,
  body: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel,
  source_bool_form: v2.std.compilers.target_model.TargetBoolLiteralShape,
  handle_transform: fn(v2.std.node.Node, v2.std.node.Node, v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression>
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression> {
  if !target_value_expr_loop_gate(node: body) {
    outcome_rejected(
      target_value_expr_diagnostic(
        reason: ^target_value_expr_reason_transform_shape_invalid,
        node: body
      )
    )
  } else {
    match list_at_optional(xs: node_positional_child_targets(node: body), index: 0) {
      Absent =>
        outcome_rejected(
          target_value_expr_diagnostic(
            reason: ^target_value_expr_reason_transform_shape_invalid,
            node: body
          )
        )
      Present { value: literal_node } =>
        bind_outcome(
          o: target_value_expr_project_atom_literal(
          node: literal_node,
          source_bool_form: source_bool_form
        ),
          f: fn(projected_body) {
            outcome_accepted(
              target_value_expression_loop(body: projected_body)
            )
          }
        )
    }
  }
}

fn target_value_expr_project_body_subexpression(
  arrow: v2.std.node.Node,
  node: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel,
  source_bool_form: v2.std.compilers.target_model.TargetBoolLiteralShape,
  handle_transform: fn(v2.std.node.Node, v2.std.node.Node, v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression>
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression> {
  match node.kind {
    ComputationNode { behavior: Transform } =>
      if target_value_expr_field_access_gate(node: node) {
        target_project_field_access(
          arrow: arrow,
          body: node,
          target: target,
          source_bool_form: source_bool_form,
          handle_transform: handle_transform
        )
      } else {
        handle_transform(arrow, node, target)
      }
    ComputationNode { behavior: Branch } =>
      target_project_branch_bool_if_else(
        arrow: arrow,
        body: node,
        target: target,
        source_bool_form: source_bool_form,
        handle_transform: handle_transform
      )
    ComputationNode { behavior: Bind } =>
      target_project_bind_let(
        arrow: arrow,
        body: node,
        target: target,
        source_bool_form: source_bool_form,
        handle_transform: handle_transform
      )
    ComputationNode { behavior: Loop } =>
      target_project_loop(
        arrow: arrow,
        body: node,
        target: target,
        source_bool_form: source_bool_form,
        handle_transform: handle_transform
      )
    ComputationNode { behavior: Match } =>
      target_project_match(
        arrow: arrow,
        body: node,
        target: target,
        source_bool_form: source_bool_form,
        handle_transform: handle_transform
      )
    TypeNode { connective: Conj } =>
      if target_value_expr_record_construct_gate(node: node) {
        target_project_record_construct(
          arrow: arrow,
          body: node,
          target: target,
          source_bool_form: source_bool_form,
          handle_transform: handle_transform
        )
      } else {
        outcome_rejected(
          target_value_expr_diagnostic(
            reason: ^target_value_expr_reason_transform_shape_invalid,
            node: node
          )
        )
      }

    TypeNode { connective: Arrow } =>
      target_project_closure_in_arrow_scope(
        closure: node,
        target: target,
        source_bool_form: source_bool_form,
        handle_transform: handle_transform
      )
    TypeNode { connective: Atom { identity: _ } } =>
      target_value_expr_project_atom_in_arrow_scope(
        arrow: arrow,
        node: node,
        target: target,
        source_bool_form: source_bool_form
      )
    _ =>
      outcome_rejected(
        target_value_expr_diagnostic(
          reason: ^target_value_expr_reason_transform_shape_invalid,
          node: node
        )
      )
  }
}

fn target_project_closure_in_arrow_scope(
  closure: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel,
  source_bool_form: v2.std.compilers.target_model.TargetBoolLiteralShape,
  handle_transform: fn(v2.std.node.Node, v2.std.node.Node, v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression>
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression> {
  bind_outcome(
    o: arrow_domain_named_param_bindings(arrow: closure),
    f: fn(params) {
      match find_arrow_body_child(root: closure) {
        Accepted { value: body, diagnostics: _ } =>
          bind_outcome(
            o: target_value_expr_project_body_subexpression(
              arrow: closure,
              node: body,
              target: target,
              source_bool_form: source_bool_form,
              handle_transform: handle_transform
            ),
            f: fn(body_expr) {
              outcome_accepted(
                target_value_expression_closure(params: params, body: body_expr)
              )
            }
          )
        Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
      }
    }
  )
}

fn target_value_expression_projection_from_target(
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpressionProjection> {
  bind_outcome(
    o: projection_bundle_child(
      bundle: target.bundle,
      name: ^target_model_edge_value_expression_projection
    ),
    f: fn(bundle) {
      decode_value_expression_projection_bundle(bundle: bundle)
    }
  )
}

fn target_value_expression_tokens_from_target(
  expr: v2.std.compilers.target_model.TargetValueExpression,
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  bind_outcome(
    o: projection_bundle_child(
      bundle: target.bundle,
      name: ^target_model_edge_operator_realizations
    ),
    f: fn(catalog) {
      target_value_expression_to_concrete_tokens(
        expr: expr,
        projection: projection,
        catalog: catalog
      )
    }
  )
}

fn target_project_arrow_body_to_value_expression(
  arrow: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel,
  source_bool_form: v2.std.compilers.target_model.TargetBoolLiteralShape,
  handle_transform: fn(v2.std.node.Node, v2.std.node.Node, v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression>
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression> {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      match body.kind {
        ComputationNode { behavior: Transform } =>
          if target_value_expr_field_access_gate(node: body) {
            target_project_field_access(
              arrow: arrow,
              body: body,
              target: target,
              source_bool_form: source_bool_form,
              handle_transform: handle_transform
            )
          } else {
            handle_transform(arrow, body, target)
          }
        ComputationNode { behavior: Branch } =>
          target_project_branch_bool_if_else(
            arrow: arrow,
            body: body,
            target: target,
            source_bool_form: source_bool_form,
            handle_transform: handle_transform
          )
        ComputationNode { behavior: Bind } =>
          target_project_bind_let(
            arrow: arrow,
            body: body,
            target: target,
            source_bool_form: source_bool_form,
            handle_transform: handle_transform
          )
        ComputationNode { behavior: Loop } =>
          target_project_loop(
            arrow: arrow,
            body: body,
            target: target,
            source_bool_form: source_bool_form,
            handle_transform: handle_transform
          )
        ComputationNode { behavior: Match } =>
          target_project_match(
            arrow: arrow,
            body: body,
            target: target,
            source_bool_form: source_bool_form,
            handle_transform: handle_transform
          )
        TypeNode { connective: Conj } =>
          if target_value_expr_record_construct_gate(node: body) {
            target_project_record_construct(
              arrow: arrow,
              body: body,
              target: target,
              source_bool_form: source_bool_form,
              handle_transform: handle_transform
            )
          } else {
            outcome_rejected(
              target_value_expr_diagnostic(
                reason: ^target_value_expr_reason_transform_shape_invalid,
                node: body
              )
            )
          }
        _ =>
          outcome_rejected(
            target_value_expr_diagnostic(
              reason: ^target_value_expr_reason_transform_shape_invalid,
              node: body
            )
          )
      }
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

data target_value_expr_int_bool_octet_channel_dissolve_on: std.dissolution.DissolutionCondition = unbound_dissolution(description: "the modeled octet-to-bool codec authority is inhabited over the \{0,1} domain (NOT general nonzero), at which point this inline `x != 0` scrutinee staging bridge at the match seam grounds on it and deletes")
