// dissolve-on-arrival: bodied Arrow serialize routes through grammar relation-row / connective dispatch;
// delete transform-body Bool predicate steady-state;
// forbidden: ComputationNode behavior Transform match for binding-validation dispatch.
fn target_value_expr_arrow_has_transform_body(arrow: Node) -> Bool {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      match body.kind {
        ComputationNode { behavior: Transform } => true
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

// 🟡 gated — predicate-dissolution interim —
// feature:t6-value-expr-bodied-arrow-serialize — consumer:06_translate + program_partition —
// bind: bodied-arrow OR-dispatch (branch/bind/loop/match/record_construct) delegates to gated shape
// predicates below; combiner target_value_expr_arrow_has_value_expression_body —
// owner: Lane 2a value-expression (jolly-wren-91) —
// lane: compiler 06_value_expression + 06_translate —
// dissolve-on-arrival: bodied Arrow serialize routes through grammar relation-row / connective dispatch;
// delete per-behavior Bool has_* predicates steady-state;
// forbidden: ComputationNode behavior match for binding-validation dispatch past M0.
fn target_value_expr_arrow_has_branch_body(arrow: Node) -> Bool {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      match body.kind {
        ComputationNode { behavior: Branch } =>
          length(xs: node_positional_child_targets(node: body)) == 3
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn target_value_expr_arrow_has_bind_body(arrow: Node) -> Bool {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      target_value_expr_bind_let_gate(node: body)
    Rejected { diagnostics: _ } => false
  }
}

fn target_value_expr_arrow_has_loop_body(arrow: Node) -> Bool {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      target_value_expr_loop_gate(node: body)
    Rejected { diagnostics: _ } => false
  }
}

fn target_value_expr_arrow_has_match_body(arrow: Node) -> Bool {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      target_value_expr_match_gate(node: body)
    Rejected { diagnostics: _ } => false
  }
}

fn target_value_expr_arrow_has_record_construct_body(arrow: Node) -> Bool {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      target_value_expr_record_construct_gate(node: body)
    Rejected { diagnostics: _ } => false
  }
}

fn target_value_expr_arrow_has_value_expression_body(arrow: Node) -> Bool {
  target_value_expr_arrow_has_transform_body(arrow: arrow)
    || target_value_expr_arrow_has_branch_body(arrow: arrow)
    || target_value_expr_arrow_has_bind_body(arrow: arrow)
    || target_value_expr_arrow_has_loop_body(arrow: arrow)
    || target_value_expr_arrow_has_match_body(arrow: arrow)
    || target_value_expr_arrow_has_record_construct_body(arrow: arrow)
}

// 🟡 gated — predicate-dissolution interim —
// feature:arrow-domain-binding-list-membership —
// consumer:target_value_expr_arrow_body_scope_binding —
// bind: membership in arrow_domain_named_param_bindings ordered list —
// owner: T6 value-expression (lively-badger-242) —
// lane: compiler 06_value_expression —
// dissolve-on-arrival: std.collection symbol-list contains accessor;
// forbidden: local Bool fold membership predicates in compiler stages.
fn target_value_expr_binding_in_declared_param_list(
  binding: Symbol,
  bindings: List<Symbol>
) -> Bool {
  fold_list(xs: bindings, empty: false, cons: fn(acc, sym) {
    if acc {
      true
    } else if sym == binding {
      true
    } else {
      false
    }
  })
}

fn target_value_expr_arrow_body_scope_binding(
  arrow: Node,
  body: Node,
  binding: Symbol,
  target: TargetModel
) -> Outcome<Symbol> {
  bind_outcome(
    o: arrow_domain_named_param_bindings(arrow: arrow),
    f: fn(bindings) {
      if target_value_expr_binding_in_declared_param_list(binding: binding, bindings: bindings)
        && (
          target_value_expr_wave1_add_signature_matches_for_target(arrow: arrow, target: target)
          || target_value_expr_arrow_has_transform_body(arrow: arrow)
        ) {
        outcome_accepted(binding)
      } else {
        outcome_rejected(
          target_value_expr_diagnostic(
            reason: ^target_value_expr_reason_body_scope_binding_invalid,
            node: body
          )
        )
      }
    }
  )
}

// Surface decode (^dag_token_plus → CanonicalOperation) is the caller's responsibility.
// 06_translate imports dag_surface_operator_canonicalization_member (extdep), decodes the surface
// token, and passes the result as canonical_op. target_model stays extdep-free.
fn target_project_transform_primitive_apply_in_arrow_scope(
  arrow: Node,
  body: Node,
  canonical_op: CanonicalOperation,
  target: TargetModel
) -> Outcome<TargetValueExpression> {
  if !all_edges_positional(children: body.children)
    || length(xs: node_positional_child_targets(node: body)) != 3 {
    outcome_rejected(
      target_value_expr_diagnostic(
        reason: ^target_value_expr_reason_transform_shape_invalid,
        node: body
      )
    )
  } else {
    bind_outcome(
      o: target_transform_positional_operand_binding(node: body, index: 1),
      f: fn(left_binding) {
        bind_outcome(
          o: target_value_expr_arrow_body_scope_binding(
            arrow: arrow,
            body: body,
            binding: left_binding,
            target: target
          ),
          f: fn(scoped_left_binding) {
            bind_outcome(
              o: target_transform_positional_operand_binding(node: body, index: 2),
              f: fn(right_binding) {
                bind_outcome(
                  o: target_value_expr_arrow_body_scope_binding(
                    arrow: arrow,
                    body: body,
                    binding: right_binding,
                    target: target
                  ),
                  f: fn(scoped_right_binding) {
                    outcome_accepted(
                      target_value_expression_primitive_apply(
                        operation: canonical_op,
                        operands: [
                          target_value_expression_binding_ref(
                            binding: scoped_left_binding
                          ),
                          target_value_expression_binding_ref(
                            binding: scoped_right_binding
                          )
                        ]
                      )
                    )
                  }
                )
              }
            )
          }
        )
      }
    )
  }
}

// Lane 2c — project one call argument. A bare Atom argument is a binding reference (scope-checked
// against the enclosing arrow's params, like a primitive operand); any other shape (a nested call
// Transform, an inline closure Arrow, a branch, …) recurses through the subexpression projector.
fn target_project_callable_arg_in_arrow_scope(
  arrow: Node,
  body: Node,
  arg: Node,
  target: TargetModel,
  handle_transform: fn(Node, Node, TargetModel) -> Outcome<TargetValueExpression>
) -> Outcome<TargetValueExpression> {
  match arg.kind {
    TypeNode { connective: Atom { identity: id } } =>
      bind_outcome(
        o: target_value_expr_arrow_body_scope_binding(
          arrow: arrow,
          body: body,
          binding: id,
          target: target
        ),
        f: fn(scoped) {
          outcome_accepted(target_value_expression_binding_ref(binding: scoped))
        }
      )
    _ =>
      target_value_expr_project_body_subexpression(
        arrow: arrow,
        node: arg,
        target: target,
        handle_transform: handle_transform
      )
  }
}

// Lane 2c — project a call Transform (`callee(arg, ...)`) to a callable-apply value-expression. The
// caller (translate) routes here when the Transform head atom does NOT canonicalize to an operator;
// the head is then the callee binding and the remaining positional children are the arguments.
fn target_project_transform_callable_apply_in_arrow_scope(
  arrow: Node,
  body: Node,
  target: TargetModel,
  handle_transform: fn(Node, Node, TargetModel) -> Outcome<TargetValueExpression>
) -> Outcome<TargetValueExpression> {
  bind_outcome(
    o: target_transform_surface_op_atom(node: body),
    f: fn(callee) {
      match list_tail(xs: node_positional_child_targets(node: body)) {
        TailAbsent =>
          outcome_rejected(
            target_value_expr_diagnostic(
              reason: ^target_value_expr_reason_transform_shape_invalid,
              node: body
            )
          )
        TailFound { tail: arg_children } =>
          bind_outcome(
            o: fold_list(
              xs: arg_children,
              empty: Accepted { value: Empty, diagnostics: None },
              cons: fn(acc, arg) {
                match acc {
                  Rejected { diagnostics: _ } => acc
                  Accepted { value: args, diagnostics: _ } =>
                    bind_outcome(
                      o: target_project_callable_arg_in_arrow_scope(
                        arrow: arrow,
                        body: body,
                        arg: arg,
                        target: target,
                        handle_transform: handle_transform
                      ),
                      f: fn(a) {
                        outcome_accepted(list_snoc_item(xs: args, item: a))
                      }
                    )
                }
              }
            ),
            f: fn(args) {
              outcome_accepted(
                target_value_expression_callable_apply(callee: callee, args: args)
              )
            }
          )
      }
    }
  )
}

// 🟡 gated — predicate-dissolution interim —
// feature:value-expression-branch-bool-condition-m0 —
// consumer:target_value_expr_branch_bool_gate —
// bind: M0 bool-if-else branch condition (kw_true / kw_false TypeNode atoms) —
// lane: compiler 06_value_expression —
// dissolve-on: Q-B1 named pattern edges for branch (M0-B5);
// forbidden: hand-rolled symbol literal identity checks past grammar relation rows.
fn target_value_expr_cond_is_bool_atom(node: Node) -> Bool {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } =>
      id == ^dag_token_kw_true || id == ^dag_token_kw_false
    _ => false
  }
}

// ^dag_token_kw_true / ^dag_token_kw_false are symbol literals (no extdep import required).
// These inline the dag_mvp1_node_is_kw_true_atom / dag_mvp1_node_is_kw_false_atom predicates.
// 🟡 gated — predicate-dissolution interim —
// feature:value-expression-branch-bool-condition-m0 —
// consumer:target_project_branch_bool_if_else —
// bind: design-comprep-m0-branch-mapping.md §12.9(A) positional Branch + bool-literal condition —
// lane: compiler 06_value_expression —
// dissolve-on: Q-B1 named pattern edges for branch (M0-B5);
// forbidden: silent ordinal coupling past M0 Bool-if-else.
fn target_value_expr_branch_bool_gate(node: Node) -> Bool {
  if length(xs: node_positional_child_targets(node: node)) != 3 {
    false
  } else {
    match list_at_optional(xs: node_positional_child_targets(node: node), index: 0) {
      Present { value: cond } =>
        target_value_expr_cond_is_bool_atom(node: cond)
      Absent => false
    }
  }
}

// 🟡 gated — feature:value-expression-pick-literal-binding-ref —
// consumer:target_value_expr_project_atom_literal —
// bind:node://adhoc-ecf6bf2b-84c —
// dissolve-on: Q-B2 literal-arm binding table lands;
// forbidden: hand-rolled int-literal token_class projection for M0 pick arms past this interim map.
fn target_value_expr_project_pick_literal_atom(id: Symbol) -> Outcome<TargetValueExpression> {
  if id == ^dag_mvp1_pick_lit_one {
    outcome_accepted(
      target_value_expression_binding_ref(binding: ^dag_binding_mvp1_pick_lit_one)
    )
  } else if id == ^dag_mvp1_pick_lit_two {
    outcome_accepted(
      target_value_expression_binding_ref(binding: ^dag_binding_mvp1_pick_lit_two)
    )
  } else if id == ^dag_mvp1_rec_lit_nine {
    outcome_accepted(
      target_value_expression_binding_ref(binding: ^dag_binding_mvp1_rec_lit_nine)
    )
  } else if id == ^dag_binding_param_r {
    outcome_accepted(
      target_value_expression_binding_ref(binding: ^dag_binding_param_r)
    )
  } else if id == ^dag_binding_mvp1_rec_v {
    outcome_accepted(
      target_value_expression_binding_ref(binding: ^dag_binding_mvp1_rec_v)
    )
  } else {
    outcome_accepted(
      target_value_expression_symbol_identity(identity: id)
    )
  }
}

fn target_value_expr_project_atom_literal(node: Node) -> Outcome<TargetValueExpression> {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } =>
      target_value_expr_project_pick_literal_atom(id: id)
    _ =>
      outcome_rejected(
        target_value_expr_diagnostic(
          reason: ^target_value_expr_reason_transform_shape_invalid,
          node: node
        )
      )
  }
}

