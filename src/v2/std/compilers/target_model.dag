}

fn target_value_expr_match_arm_slot_from_arm_edge(
  arrow: Node,
  arm_edge: Edge,
  target: TargetModel,
  handle_transform: fn(Node, Node, TargetModel) -> Outcome<TargetValueExpression>
) -> Outcome<TargetValueExprMatchArmSlot> {
  bind_outcome(
    o: find_named_child(root: arm_edge.target, name: match_arm_pattern),
    f: fn(pattern_node) {
      bind_outcome(
        o: find_named_child(root: arm_edge.target, name: match_arm_body),
        f: fn(body_node) {
          bind_outcome(
            o: target_value_expr_project_body_subexpression(
              arrow: arrow,
              node: pattern_node,
              target: target,
              handle_transform: handle_transform
            ),
            f: fn(projected_pattern) {
              bind_outcome(
                o: target_value_expr_project_body_subexpression(
                  arrow: arrow,
                  node: body_node,
                  target: target,
                  handle_transform: handle_transform
                ),
                f: fn(projected_body) {
                  outcome_accepted(
                    TargetValueExprMatchArmSlot {
                      pattern: projected_pattern,
                      body: projected_body
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn target_value_expr_match_project_arms(
  arrow: Node,
  children: List<Edge>,
  target: TargetModel,
  handle_transform: fn(Node, Node, TargetModel) -> Outcome<TargetValueExpression>
) -> Outcome<List<TargetValueExprMatchArmSlot>> {
  match fold(
    target_value_expr_match_arm_edges_after_scrutinee(children: children),
    init: Accepted { value: Empty, diagnostics: None },
    f: fn(acc, arm_edge) {
      match acc {
        Rejected { diagnostics: r } => acc
        Accepted { value: slots, diagnostics: d } =>
          bind_outcome(
            o: target_value_expr_match_arm_slot_from_arm_edge(
              arrow: arrow,
              arm_edge: arm_edge,
              target: target,
              handle_transform: handle_transform
            ),
            f: fn(arm) {
              outcome_accepted(list_snoc_item(xs: slots, item: arm))
            }
          )
      }
    }
  ) {
    Accepted { value: slots, diagnostics: d } => Accepted { value: slots, diagnostics: d }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn target_project_match(
  arrow: Node,
  body: Node,
  target: TargetModel,
  handle_transform: fn(Node, Node, TargetModel) -> Outcome<TargetValueExpression>
) -> Outcome<TargetValueExpression> {
  if !target_value_expr_match_gate(node: body) {
    outcome_rejected(
      target_value_expr_diagnostic(
        reason: ^target_value_expr_reason_transform_shape_invalid,
        node: body
      )
    )
  } else {
    match list_at_optional(xs: node_positional_child_targets(node: body), index: 0) {
      Absent =>
        outcome_rejected(
          target_value_expr_diagnostic(
            reason: ^target_value_expr_reason_transform_shape_invalid,
            node: body
          )
        )
      Present { value: scrutinee_node } =>
        bind_outcome(
          o: target_value_expr_project_body_subexpression(
            arrow: arrow,
            node: scrutinee_node,
            target: target,
            handle_transform: handle_transform
          ),
          f: fn(projected_scrutinee) {
            bind_outcome(
              o: target_value_expr_match_project_arms(
                arrow: arrow,
                children: body.children,
                target: target,
                handle_transform: handle_transform
              ),
              f: fn(projected_arms) {
                outcome_accepted(
                  target_value_expression_match(
                    scrutinee: projected_scrutinee,
                    arms: projected_arms
                  )
                )
              }
            )
          }
        )
    }
  }
}

// 🟡 gated — feature:value-expression-branch-positional-m0 —
// consumer:target_value_expr_project_body_subexpression —
// bind: design-comprep-m0-branch-mapping.md §12.9(A) —
// dissolve-on: Q-B1 named pattern edges for match (M0-B5);
// forbidden: silent ordinal coupling past M0 Bool-if-else.
fn target_project_branch_bool_if_else(
  arrow: Node,
  body: Node,
  target: TargetModel,
  handle_transform: fn(Node, Node, TargetModel) -> Outcome<TargetValueExpression>
) -> Outcome<TargetValueExpression> {
  if !target_value_expr_branch_bool_gate(node: body) {
    outcome_rejected(
      target_value_expr_diagnostic(
        reason: ^target_value_expr_reason_transform_shape_invalid,
        node: body
      )
    )
  } else {
    match list_at_optional(xs: node_positional_child_targets(node: body), index: 0) {
      Absent =>
        outcome_rejected(
          target_value_expr_diagnostic(
            reason: ^target_value_expr_reason_transform_shape_invalid,
            node: body
          )
        )
      Present { value: cond } =>
        match list_at_optional(xs: node_positional_child_targets(node: body), index: 1) {
          Absent =>
            outcome_rejected(
              target_value_expr_diagnostic(
                reason: ^target_value_expr_reason_transform_shape_invalid,
                node: body
              )
            )
          Present { value: then_arm } =>
            match list_at_optional(xs: node_positional_child_targets(node: body), index: 2) {
              Absent =>
                outcome_rejected(
                  target_value_expr_diagnostic(
                    reason: ^target_value_expr_reason_transform_shape_invalid,
                    node: body
                  )
                )
              Present { value: else_arm } =>
                bind_outcome(
                  o: target_value_expr_project_body_subexpression(
                    arrow: arrow,
                    node: cond,
                    target: target,
                    handle_transform: handle_transform
                  ),
                  f: fn(projected_cond) {
                    bind_outcome(
                      o: target_value_expr_project_body_subexpression(
                        arrow: arrow,
                        node: then_arm,
                        target: target,
                        handle_transform: handle_transform
                      ),
                      f: fn(projected_then) {
                        bind_outcome(
                          o: target_value_expr_project_body_subexpression(
                            arrow: arrow,
                            node: else_arm,
                            target: target,
                            handle_transform: handle_transform
                          ),
                          f: fn(projected_else) {
                            outcome_accepted(
                              target_value_expression_conditional(
                                condition: projected_cond,
                                then_arm: projected_then,
                                else_arm: projected_else
                              )
                            )
                          }
                        )
                      }
                    )
                  }
                )
            }
        }
    }
  }
}

fn target_value_expr_bind_let_gate(node: Node) -> Bool {
  match node.kind {
    ComputationNode { behavior: Bind } =>
      length(xs: node_positional_child_targets(node: node)) == 3
    _ => false
  }
}

// 🟡 gated — predicate-dissolution interim — feature:value-expression-loop-positional-m0 —
// consumer:target_project_loop —
// bind: COMPREP wave-2 M0-Loop (symmetric w/ bind/branch §12.9) —
// dissolve-on: Q-B1 named pattern edges for Loop (M0-B5);
// forbidden: silent ordinal coupling past M0 loop body.
fn target_value_expr_loop_gate(node: Node) -> Bool {
  match node.kind {
    ComputationNode { behavior: Loop } =>
      length(xs: node_positional_child_targets(node: node)) >= 1
    _ => false
  }
}

// 🟡 gated — feature:value-expression-bind-positional-m0 —
// consumer:target_project_bind_let —
// bind: design-comprep-m0-bind-mapping (symmetric w/ branch §12.9) —
// dissolve-on: Q-B1 named pattern edges for Bind (M0-B5);
// forbidden: silent ordinal coupling past M0 let-in.
fn target_project_bind_let(
  arrow: Node,
  body: Node,
  target: TargetModel,
  handle_transform: fn(Node, Node, TargetModel) -> Outcome<TargetValueExpression>
) -> Outcome<TargetValueExpression> {
  if !target_value_expr_bind_let_gate(node: body) {
    outcome_rejected(
      target_value_expr_diagnostic(
        reason: ^target_value_expr_reason_transform_shape_invalid,
        node: body
      )
    )
  } else {
    bind_outcome(
      o: target_transform_positional_operand_binding(node: body, index: 0),
      f: fn(key_binding) {
        bind_outcome(
          o: target_transform_positional_operand_binding(node: body, index: 2),
          f: fn(body_binding) {
            match list_at_optional(xs: node_positional_child_targets(node: body), index: 1) {
              Absent =>
                outcome_rejected(
                  target_value_expr_diagnostic(
                    reason: ^target_value_expr_reason_transform_shape_invalid,
                    node: body
                  )
                )
              Present { value: value_node } =>
                bind_outcome(
                  o: target_value_expr_project_body_subexpression(
                    arrow: arrow,
                    node: value_node,
                    target: target,
                    handle_transform: handle_transform
                  ),
                  f: fn(projected_value) {
                    outcome_accepted(
                      target_value_expression_bind_let(
                        bind_key: target_value_expression_binding_ref(binding: key_binding),
                        bind_value: projected_value,
                        bind_body: target_value_expression_binding_ref(binding: body_binding)
                      )
                    )
                  }
                )
            }
          }
        )
      }
    )
  }
}

// 🟡 gated — feature:value-expression-loop-positional-m0 —
// consumer:target_project_loop —
// bind: COMPREP wave-2 M0-Loop (symmetric w/ bind/branch §12.9) —
// dissolve-on: Q-B1 named pattern edges for Loop (M0-B5);
// forbidden: silent ordinal coupling past M0 loop body.
fn target_project_loop(
  arrow: Node,
  body: Node,
  target: TargetModel,
  handle_transform: fn(Node, Node, TargetModel) -> Outcome<TargetValueExpression>
) -> Outcome<TargetValueExpression> {
  if !target_value_expr_loop_gate(node: body) {
    outcome_rejected(
      target_value_expr_diagnostic(
        reason: ^target_value_expr_reason_transform_shape_invalid,
        node: body
      )
    )
  } else {
    match list_at_optional(xs: node_positional_child_targets(node: body), index: 0) {
      Absent =>
        outcome_rejected(
          target_value_expr_diagnostic(
            reason: ^target_value_expr_reason_transform_shape_invalid,
            node: body
          )
        )
      Present { value: literal_node } =>
        bind_outcome(
          o: target_value_expr_project_atom_literal(node: literal_node),
          f: fn(projected_body) {
            outcome_accepted(
              target_value_expression_loop(body: projected_body)
            )
          }
        )
    }
  }
}

fn target_value_expr_project_body_subexpression(
  arrow: Node,
  node: Node,
  target: TargetModel,
  handle_transform: fn(Node, Node, TargetModel) -> Outcome<TargetValueExpression>
) -> Outcome<TargetValueExpression> {
  match node.kind {
    ComputationNode { behavior: Transform } =>
      if target_value_expr_field_access_gate(node: node) {
        target_project_field_access(
          arrow: arrow,
          body: node,
          target: target,
          handle_transform: handle_transform
        )
      } else {
        handle_transform(arrow, node, target)
      }
    ComputationNode { behavior: Branch } =>
      target_project_branch_bool_if_else(
        arrow: arrow,
        body: node,
        target: target,
        handle_transform: handle_transform
      )
    ComputationNode { behavior: Bind } =>
      target_project_bind_let(
        arrow: arrow,
        body: node,
        target: target,
        handle_transform: handle_transform
      )
    ComputationNode { behavior: Loop } =>
      target_project_loop(
        arrow: arrow,
        body: node,
        target: target,
        handle_transform: handle_transform
      )
    ComputationNode { behavior: Match } =>
      target_project_match(
        arrow: arrow,
        body: node,
        target: target,
        handle_transform: handle_transform
      )
    TypeNode { connective: Conj } =>
      if target_value_expr_record_construct_gate(node: node) {
        target_project_record_construct(
          arrow: arrow,
          body: node,
          target: target,
          handle_transform: handle_transform
        )
      } else {
        outcome_rejected(
          target_value_expr_diagnostic(
            reason: ^target_value_expr_reason_transform_shape_invalid,
            node: node
          )
        )
      }
    // Lane 2c — a `TypeNode { connective: Arrow }` appearing as an operand is an inline closure
    // (`fn(params) { body }`). Project its own param domain + body, with the closure itself as the
    // new scope arrow so the body's binding refs resolve against the closure params (nested-closure
    // scoping). Captures of the enclosing scope are a follow-up (only closure-local params today).
    TypeNode { connective: Arrow } =>
      target_project_closure_in_arrow_scope(
        closure: node,
        target: target,
        handle_transform: handle_transform
      )
    TypeNode { connective: Atom { identity: _ } } =>
      target_value_expr_project_atom_literal(node: node)
    _ =>
      outcome_rejected(
        target_value_expr_diagnostic(
          reason: ^target_value_expr_reason_transform_shape_invalid,
          node: node
        )
      )
  }
}

// Lane 2c — project an inline closure node to a closure value-expression. The body recurses through
// the same subexpression projector with `closure` as the scope arrow, so an operator/call inside the
// closure resolves its binding refs against the closure's own params.
fn target_project_closure_in_arrow_scope(
  closure: Node,
  target: TargetModel,
  handle_transform: fn(Node, Node, TargetModel) -> Outcome<TargetValueExpression>
) -> Outcome<TargetValueExpression> {
  bind_outcome(
    o: arrow_domain_named_param_bindings(arrow: closure),
    f: fn(params) {
      match find_arrow_body_child(root: closure) {
        Accepted { value: body, diagnostics: _ } =>
          bind_outcome(
            o: target_value_expr_project_body_subexpression(
              arrow: closure,
              node: body,
              target: target,
              handle_transform: handle_transform
            ),
            f: fn(body_expr) {
              outcome_accepted(
                target_value_expression_closure(params: params, body: body_expr)
              )
            }
          )
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    }
  )
}

fn target_value_expression_projection_from_target(
  target: TargetModel
) -> Outcome<TargetValueExpressionProjection> {
  bind_outcome(
    o: projection_bundle_child(
      bundle: target.bundle,
      name: ^target_model_edge_value_expression_projection
    ),
    f: fn(bundle) {
      decode_value_expression_projection_bundle(bundle: bundle)
    }
  )
}

fn target_value_expression_tokens_from_target(
  expr: TargetValueExpression,
  target: TargetModel,
  projection: TargetValueExpressionProjection
) -> Outcome<List<ConcreteSyntaxToken>> {
  bind_outcome(
    o: projection_bundle_child(
      bundle: target.bundle,
      name: ^target_model_edge_operator_realizations
    ),
    f: fn(catalog) {
      target_value_expression_to_concrete_tokens(
        expr: expr,
        projection: projection,
        catalog: catalog
      )
    }
  )
}

fn target_project_arrow_body_to_value_expression(
  arrow: Node,
  target: TargetModel,
  handle_transform: fn(Node, Node, TargetModel) -> Outcome<TargetValueExpression>
) -> Outcome<TargetValueExpression> {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      match body.kind {
        ComputationNode { behavior: Transform } =>
          if target_value_expr_field_access_gate(node: body) {
            target_project_field_access(
              arrow: arrow,
              body: body,
              target: target,
              handle_transform: handle_transform
            )
          } else {
            handle_transform(arrow, body, target)
          }
        ComputationNode { behavior: Branch } =>
          target_project_branch_bool_if_else(
            arrow: arrow,
            body: body,
            target: target,
            handle_transform: handle_transform
          )
        ComputationNode { behavior: Bind } =>
          target_project_bind_let(
            arrow: arrow,
            body: body,
            target: target,
            handle_transform: handle_transform
          )
        ComputationNode { behavior: Loop } =>
          target_project_loop(
            arrow: arrow,
            body: body,
            target: target,
            handle_transform: handle_transform
          )
        ComputationNode { behavior: Match } =>
          target_project_match(
            arrow: arrow,
            body: body,
            target: target,
            handle_transform: handle_transform
          )
        TypeNode { connective: Conj } =>
          if target_value_expr_record_construct_gate(node: body) {
            target_project_record_construct(
              arrow: arrow,
              body: body,
              target: target,
              handle_transform: handle_transform
            )
          } else {
            outcome_rejected(
              target_value_expr_diagnostic(
                reason: ^target_value_expr_reason_transform_shape_invalid,
                node: body
              )
            )
          }
        _ =>
          outcome_rejected(
            target_value_expr_diagnostic(
              reason: ^target_value_expr_reason_transform_shape_invalid,
              node: body
            )
          )
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}
