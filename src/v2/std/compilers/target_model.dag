      bind_outcome(
        o: target_value_expr_arrow_body_scope_binding(
          arrow: arrow,
          body: body,
          binding: id,
          target: target
        ),
        f: fn(scoped) {
          outcome_accepted(target_value_expression_binding_ref(binding: scoped))
        }
      )
    _ =>
      target_value_expr_project_body_subexpression(
        arrow: arrow,
        node: arg,
        target: target,
        source_bool_form: source_bool_form,
        handle_transform: handle_transform
      )
  }
}

fn target_project_transform_callable_apply_in_arrow_scope(
  arrow: v2.std.node.Node,
  body: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel,
  source_bool_form: v2.std.compilers.target_model.TargetBoolLiteralShape,
  handle_transform: fn(v2.std.node.Node, v2.std.node.Node, v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression>
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression> {
  bind_outcome(
    o: target_transform_surface_op_atom(node: body),
    f: fn(callee) {
      match list_tail(xs: node_positional_child_targets(node: body)) {
        TailAbsent =>
          outcome_rejected(
            target_value_expr_diagnostic(
              reason: ^target_value_expr_reason_transform_shape_invalid,
              node: body
            )
          )
        TailFound { tail: arg_children } =>
          bind_outcome(
            o: fold_list(
              xs: arg_children,
              empty: v2.std.diagnostic.Accepted { value: std.algebra.Empty, diagnostics: v2.std.diagnostic.None },
              cons: fn(acc, arg) {
                match acc {
                  Rejected { diagnostics: _ } => acc
                  Accepted { value: args, diagnostics: _ } =>
                    bind_outcome(
                      o: target_project_callable_arg_in_arrow_scope(
                        arrow: arrow,
                        body: body,
                        arg: arg,
                        target: target,
                        source_bool_form: source_bool_form,
                        handle_transform: handle_transform
                      ),
                      f: fn(a) {
                        outcome_accepted(list_snoc_item(xs: args, item: a))
                      }
                    )
                }
              }
            ),
            f: fn(args) {
              outcome_accepted(
                target_value_expression_callable_apply(callee: callee, args: args)
              )
            }
          )
      }
    }
  )
}

fn target_value_expr_branch_bool_gate(
  node: v2.std.node.Node,
  source_bool_form: v2.std.compilers.target_model.TargetBoolLiteralShape
) -> Bool {
  if length(xs: node_positional_child_targets(node: node)) != 3 {
    false
  } else {
    match list_at_optional(xs: node_positional_child_targets(node: node), index: 0) {
      Present { value: cond } =>
        target_value_expr_is_source_bool_literal_atom(
          node: cond,
          source_bool_form: source_bool_form
        )
      Absent => false
    }
  }
}

data target_value_expr_int_literal_predicate_dissolution_note: String = "See target_value_expr_int_literal_predicate_dissolution_note_dissolve_on for the lifecycle condition this row's rationale accompanies."

data target_value_expr_int_literal_predicate_dissolve_on: std.dissolution.DissolutionCondition = unbound_dissolution(description: "🟡 dissolve-on: target_value_expr_is_int_literal_atom and target_value_expr_int_literal_magnitude_node_optional duplicate dag_node_is_int_literal_atom / dag_int_literal_magnitude_node_optional in extdeps/languages/dag.dag — std/compilers cannot import extdeps (layer DAG); DISSOLVES WHEN int-literal atom predicates live in std as single authority both compiler and extdeps import.")

fn target_value_expr_is_int_literal_atom(node: v2.std.node.Node) -> Bool {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } => id == ^dag_token_int_literal
    _ => false
  }
}

fn target_value_expr_int_literal_magnitude_node_optional(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  if target_value_expr_is_int_literal_atom(node: node) {
    fold(node.children, init: optional_absent(), f: fn(acc, edge) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match edge {
            Edge { label: Named { name: field }, target: magnitude } =>
              if field == ^integer_literal_magnitude_field {
                optional_present(value: magnitude)
              } else {
                optional_absent()
              }
            Edge { label: Positional, target: _ } => optional_absent()
          }
      }
    })
  } else {
    optional_absent()
  }
}

fn target_value_expr_int_literal_magnitude_binding(magnitude: Int) -> v2.std.optional.Optional<v2.std.node.Symbol> {
  if magnitude == 1 {
    optional_present(value: ^dag_binding_pick_lit_one)
  } else if magnitude == 2 {
    optional_present(value: ^dag_binding_pick_lit_two)
  } else {
    optional_absent()
  }
}

data target_value_expr_int_literal_emit_scaffold_note: String = "🟡 dissolve-on: target_value_expr_int_literal_magnitude_binding maps only magnitudes 1/2 to legacy pick-lit bindings for existing emit round-trip witnesses; magnitudes 3+ refuse transform_shape_invalid until target int-literal emission lowers through a general decimal/text path (same authority as integer_lexeme_to_int / dag_int_literal_node_from_lexeme). DISSOLVES WHEN target_value_expr_project_int_literal_atom emits arbitrary magnitudes without per-value binding rows."

fn target_value_expr_project_int_literal_atom(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression> {
  match target_value_expr_int_literal_magnitude_node_optional(node: node) {
    Present { value: magnitude_node } =>
      match integer_decimal_magnitude_node_to_int(node: magnitude_node) {
        Accepted { value: magnitude, diagnostics: _ } =>
          match target_value_expr_int_literal_magnitude_binding(magnitude: magnitude) {
            Present { value: binding } =>
              outcome_accepted(
                target_value_expression_binding_ref(binding: binding)
              )
            Absent =>
              outcome_rejected(
                target_value_expr_diagnostic(
                  reason: ^target_value_expr_reason_transform_shape_invalid,
                  node: node
                )
              )
          }
        Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
      }
    Absent =>
      outcome_rejected(
        target_value_expr_diagnostic(
          reason: ^target_value_expr_reason_transform_shape_invalid,
          node: node
        )
      )
  }
}

fn target_value_expr_binding_ref_for_literal_atom(id: v2.std.node.Symbol) -> v2.std.optional.Optional<v2.std.node.Symbol> {
  if id == ^dag_pick_lit_one {
    optional_present(value: ^dag_binding_pick_lit_one)
  } else if id == ^dag_pick_lit_two {
    optional_present(value: ^dag_binding_pick_lit_two)
  } else if id == ^dag_rec_lit_nine {
    optional_present(value: ^dag_binding_rec_lit_nine)
  } else if id == ^dag_binding_param_r {
    optional_present(value: ^dag_binding_param_r)
  } else if id == ^dag_binding_param_x {
    optional_present(value: ^dag_binding_param_x)
  } else if id == ^dag_binding_param_y {
    optional_present(value: ^dag_binding_param_y)
  } else if id == ^rust_binding_param_x {
    optional_present(value: ^rust_binding_param_x)
  } else if id == ^rust_binding_param_y {
    optional_present(value: ^rust_binding_param_y)
  } else if id == ^dag_binding_rec_v {
    optional_present(value: ^dag_binding_rec_v)
  } else {
    optional_absent()
  }
}

fn target_value_expr_project_pick_literal_atom(
  id: v2.std.node.Symbol,
  source_bool_form: v2.std.compilers.target_model.TargetBoolLiteralShape
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression> {
  match target_value_expr_bool_literal_value_from_source_symbol(
    id: id,
    source_bool_form: source_bool_form
  ) {
    Present { value: b } =>
      outcome_accepted(target_value_expression_bool_literal(value: b))
    Absent =>
      match target_value_expr_binding_ref_for_literal_atom(id: id) {
        Present { value: binding } =>
          outcome_accepted(
            target_value_expression_binding_ref(binding: binding)
          )
        Absent =>
          outcome_accepted(
            target_value_expression_symbol_identity(identity: id)
          )
      }
  }
}

fn target_value_expr_project_atom_in_arrow_scope(
  arrow: v2.std.node.Node,
  node: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel,
  source_bool_form: v2.std.compilers.target_model.TargetBoolLiteralShape
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression> {
  bind_outcome(
    o: target_value_expression_projection_from_target(target: target),
    f: fn(projection) {
      match node.kind {
        TypeNode { connective: Atom { identity: id } } =>
          match target_value_expr_arrow_body_scope_binding(
            arrow: arrow,
            body: node,
            binding: id,
            target: target
          ) {
            Accepted { value: scoped, diagnostics: d } =>
              outcome_accepted(
                target_value_expression_binding_ref(binding: scoped)
              )
            Rejected { diagnostics: _ } =>
              target_value_expr_project_atom_literal(
                node: node,
                source_bool_form: source_bool_form
              )
          }
        _ =>
          outcome_rejected(
            target_value_expr_diagnostic(
              reason: ^target_value_expr_reason_transform_shape_invalid,
              node: node
            )
          )
      }
    }
  )
}

fn target_value_expr_project_atom_literal(
  node: v2.std.node.Node,
  source_bool_form: v2.std.compilers.target_model.TargetBoolLiteralShape
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression> {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id == ^target_value_expression_symbol_identity_atom {
        bind_outcome(
          o: target_value_expression_symbol_identity_from_wire(wire: node),
          f: fn(inner_id) {
            target_value_expr_project_pick_literal_atom(
              id: inner_id,
              source_bool_form: source_bool_form
            )
          }
        )
      } else if target_value_expr_is_int_literal_atom(node: node) {
        target_value_expr_project_int_literal_atom(node: node)
      } else {
        match target_value_expr_bool_literal_value_from_atom(node: node) {
          Present { value: b } =>
            outcome_accepted(target_value_expression_bool_literal(value: b))
          Absent =>
            target_value_expr_project_pick_literal_atom(
              id: id,
              source_bool_form: source_bool_form
            )
        }
      }
    _ =>
      outcome_rejected(
        target_value_expr_diagnostic(
          reason: ^target_value_expr_reason_transform_shape_invalid,
          node: node
        )
      )
  }
}

fn target_value_expr_record_construct_gate(node: v2.std.node.Node) -> Bool {
  match node.kind {
    TypeNode { connective: Conj } =>
      if !all_edges_named(children: node.children) {
        false
      } else {
        match target_value_expr_labeled_edge_head(
          labeled: node_labeled_child_edges(node: node)
        ) {
          Present { value: first_edge } =>
            match first_edge.target.kind {
              TypeNode { connective: Atom { identity: _ } } => true
              _ => false
            }
          Absent => false
        }
      }
    _ => false
  }
}

fn target_value_expr_record_construct_field_slots_from_edges(
  arrow: v2.std.node.Node,
  edges: v2.std.collection.List<v2.std.node.Edge>,
  target: v2.std.compilers.target_model.TargetModel,
  source_bool_form: v2.std.compilers.target_model.TargetBoolLiteralShape,
  handle_transform: fn(v2.std.node.Node, v2.std.node.Node, v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression>
) -> v2.std.diagnostic.Outcome<v2.std.collection.List<v2.std.compilers.target_model.TargetValueExprFieldInitSlot>> {
  match fold(
    edges,
    init: v2.std.diagnostic.Accepted { value: std.algebra.Empty, diagnostics: v2.std.diagnostic.None },
    f: fn(acc, edge) {
      match acc {
        Rejected { diagnostics: r } => acc
        Accepted { value: slots, diagnostics: d } =>
          match edge.label {
            Named { name: field_label } =>
              bind_outcome(
                o: target_value_expr_project_body_subexpression(
                  arrow: arrow,
                  node: edge.target,
                  target: target,
                  source_bool_form: source_bool_form,
                  handle_transform: handle_transform
                ),
                f: fn(projected_value) {
                  outcome_accepted(
                    list_snoc_item(
                      xs: slots,
                      item: v2.std.compilers.target_model.TargetValueExprFieldInitSlot {
                        label: field_label,
                        value: projected_value
                      }
                    )
                  )
                }
              )
            Positional =>
              outcome_rejected(
                target_value_expr_diagnostic(
                  reason: ^target_value_expr_reason_transform_shape_invalid,
                  node: edge.target
                )
              )
          }
      }
    }
  ) {
    Accepted { value: slots, diagnostics: d } => v2.std.diagnostic.Accepted { value: slots, diagnostics: d }
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn target_project_record_construct(
  arrow: v2.std.node.Node,
  body: v2.std.node.Node,
