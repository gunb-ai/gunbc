fn target_value_expr_effect_apply_kind_from_wire(wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Symbol> {
  match fold(
    wire.children,
    init: optional_absent(),
    f: fn(acc, edge) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match edge.label {
