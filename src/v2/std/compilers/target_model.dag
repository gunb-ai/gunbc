fn derive_bodied_arrow_scaffold(
  signature_with_open: List<ConcreteSyntaxToken>,
  block_close: List<ConcreteSyntaxToken>,
  mode: BlockEvaluationMode
) -> TargetBodiedArrowStatementScaffold {
  match mode {
    ValueProducing =>
      TargetBodiedArrowStatementScaffold {
        prefix: signature_with_open,
        suffix: block_close
      }
    StatementSequenced {
      return_token: return_token,
      statement_terminator: statement_terminator
    } =>
      TargetBodiedArrowStatementScaffold {
        prefix: list_snoc_item(
          xs: signature_with_open,
          item: FixedToken { token_class: return_token }
        ),
        suffix: list_append(
          left: [FixedToken { token_class: statement_terminator }],
          right: block_close
        )
      }
  }
}

fn target_model_type_atom_node(identity: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: identity } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn target_model_type_conj_node(children: List<Edge>) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: children,
    occurrence_id: SyntheticOccurrence
  }
}

fn target_canonical_operation_wire_malformed_diagnostic(wire: Node) -> Diagnostic {
  Diagnostic {
    reason: ^target_canonical_operation_wire_malformed,
    at: node_locus(node: wire),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_model_canonical_operation_atom_field_from_wire(
  wire: Node,
  field_name: Symbol
) -> Optional<Symbol> {
  match fold(
    wire.children,
    init: optional_absent(),
    f: fn(acc, edge) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match edge.label {
            Named { name: n } =>
              if n == field_name {
                match edge.target.kind {
                  TypeNode { connective: Atom { identity: id } } =>
                    optional_present(value: id)
                  _ => acc
                }
              } else {
                acc
              }
            Positional => acc
          }
      }
    }
  ) {
    Present { value: field } => optional_present(value: field)
    Absent => optional_absent()
  }
}

fn ordering_predicate_wire_symbol(predicate: OrderingPredicate) -> Symbol {
  match predicate {
    IsLess => ^ordering_predicate_is_less
    IsLessOrEqual => ^ordering_predicate_is_less_or_equal
    IsGreater => ^ordering_predicate_is_greater
    IsGreaterOrEqual => ^ordering_predicate_is_greater_or_equal
  }
}

fn ordering_predicate_from_wire_symbol(id: Symbol) -> Optional<OrderingPredicate> {
  if id == ^ordering_predicate_is_less {
    optional_present(value: IsLess)
  } else {
    if id == ^ordering_predicate_is_less_or_equal {
      optional_present(value: IsLessOrEqual)
    } else {
      if id == ^ordering_predicate_is_greater {
        optional_present(value: IsGreater)
      } else {
        if id == ^ordering_predicate_is_greater_or_equal {
          optional_present(value: IsGreaterOrEqual)
        } else {
          optional_absent()
        }
      }
    }
  }
}

fn ordering_predicate_equal(left: OrderingPredicate, right: OrderingPredicate) -> Bool {
  ordering_predicate_wire_symbol(predicate: left) == ordering_predicate_wire_symbol(predicate: right)
}

fn equality_predicate_wire_symbol(predicate: EqualityPredicate) -> Symbol {
  match predicate {
    IsEqual => ^equality_predicate_is_equal
    IsNotEqual => ^equality_predicate_is_not_equal
  }
}

fn equality_predicate_from_wire_symbol(id: Symbol) -> Optional<EqualityPredicate> {
  if id == ^equality_predicate_is_equal {
    optional_present(value: IsEqual)
  } else {
    if id == ^equality_predicate_is_not_equal {
      optional_present(value: IsNotEqual)
    } else {
      optional_absent()
    }
  }
}

fn equality_predicate_equal(left: EqualityPredicate, right: EqualityPredicate) -> Bool {
  equality_predicate_wire_symbol(predicate: left) == equality_predicate_wire_symbol(predicate: right)
}

fn target_model_canonical_operation_wire_node(operation: CanonicalOperation) -> Node {
  match operation {
    AlgebraPrimitive { algebra_field: f } =>
      Node {
        kind: TypeNode { connective: Atom { identity: discriminant(v: AlgebraPrimitive {}) } },
        children: [
          target_model_named_edge(
            name: ^target_canonical_operation_field_algebra_field,
            target: target_model_type_atom_node(identity: f)
          )
        ],
        occurrence_id: SyntheticOccurrence
      }
    AlgebraInverseCompose { binary_field: b, inverse_field: i } =>
      Node {
        kind: TypeNode { connective: Atom { identity: discriminant(v: AlgebraInverseCompose {}) } },
        children: [
          target_model_named_edge(
            name: ^target_canonical_operation_field_binary_field,
            target: target_model_type_atom_node(identity: b)
          ),
          target_model_named_edge(
            name: ^target_canonical_operation_field_inverse_field,
            target: target_model_type_atom_node(identity: i)
          )
        ],
        occurrence_id: SyntheticOccurrence
      }
    OrderingComparison { compare_field: c, predicate: p } =>
      Node {
        kind: TypeNode { connective: Atom { identity: discriminant(v: OrderingComparison {}) } },
        children: [
          target_model_named_edge(
            name: ^target_canonical_operation_field_compare_field,
            target: target_model_type_atom_node(identity: c)
          ),
          target_model_named_edge(
            name: ^target_canonical_operation_field_predicate,
            target: target_model_type_atom_node(identity: ordering_predicate_wire_symbol(predicate: p))
          )
        ],
        occurrence_id: SyntheticOccurrence
      }
    EqualityComparison { eq_field: e, predicate: p } =>
      Node {
        kind: TypeNode { connective: Atom { identity: discriminant(v: EqualityComparison {}) } },
        children: [
          target_model_named_edge(
            name: ^target_canonical_operation_field_eq_field,
            target: target_model_type_atom_node(identity: e)
          ),
          target_model_named_edge(
            name: ^target_canonical_operation_field_predicate,
            target: target_model_type_atom_node(identity: equality_predicate_wire_symbol(predicate: p))
          )
        ],
        occurrence_id: SyntheticOccurrence
      }
  }
}

fn canonical_operation_equal(
  left: CanonicalOperation,
  right: CanonicalOperation
) -> Bool {
  match left {
    AlgebraPrimitive { algebra_field: lf } =>
      match right {
        AlgebraPrimitive { algebra_field: rf } => lf == rf
        AlgebraInverseCompose { binary_field: _, inverse_field: _ } => false
        OrderingComparison { compare_field: _, predicate: _ } => false
        EqualityComparison { eq_field: _, predicate: _ } => false
      }
    AlgebraInverseCompose { binary_field: lb, inverse_field: li } =>
      match right {
        AlgebraPrimitive { algebra_field: _ } => false
        AlgebraInverseCompose { binary_field: rb, inverse_field: ri } =>
          lb == rb && li == ri
        OrderingComparison { compare_field: _, predicate: _ } => false
        EqualityComparison { eq_field: _, predicate: _ } => false
      }
    OrderingComparison { compare_field: lc, predicate: lp } =>
      match right {
        AlgebraPrimitive { algebra_field: _ } => false
        AlgebraInverseCompose { binary_field: _, inverse_field: _ } => false
        OrderingComparison { compare_field: rc, predicate: rp } =>
          lc == rc && ordering_predicate_equal(left: lp, right: rp)
        EqualityComparison { eq_field: _, predicate: _ } => false
      }
    EqualityComparison { eq_field: le, predicate: lp } =>
      match right {
        AlgebraPrimitive { algebra_field: _ } => false
        AlgebraInverseCompose { binary_field: _, inverse_field: _ } => false
        OrderingComparison { compare_field: _, predicate: _ } => false
        EqualityComparison { eq_field: re, predicate: rp } =>
          le == re && equality_predicate_equal(left: lp, right: rp)
      }
  }
}

fn canonical_operation_from_wire_node(wire: Node) -> Outcome<CanonicalOperation> {
  match wire.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id == discriminant(v: AlgebraPrimitive {}) {
        match target_model_canonical_operation_atom_field_from_wire(
          wire: wire,
          field_name: ^target_canonical_operation_field_algebra_field
        ) {
          Present { value: algebra_field } =>
            outcome_accepted(AlgebraPrimitive { algebra_field: algebra_field })
          Absent =>
            outcome_rejected(
              target_canonical_operation_wire_malformed_diagnostic(wire: wire)
            )
        }
      } else {
        if id == discriminant(v: AlgebraInverseCompose {}) {
          match target_model_canonical_operation_atom_field_from_wire(
            wire: wire,
            field_name: ^target_canonical_operation_field_binary_field
          ) {
            Present { value: binary_field } =>
              match target_model_canonical_operation_atom_field_from_wire(
                wire: wire,
                field_name: ^target_canonical_operation_field_inverse_field
              ) {
                Present { value: inverse_field } =>
                  outcome_accepted(
                    AlgebraInverseCompose {
                      binary_field: binary_field,
                      inverse_field: inverse_field
                    }
                  )
                Absent =>
                  outcome_rejected(
                    target_canonical_operation_wire_malformed_diagnostic(wire: wire)
                  )
              }
            Absent =>
              outcome_rejected(
                target_canonical_operation_wire_malformed_diagnostic(wire: wire)
              )
          }
        } else {
          if id == discriminant(v: OrderingComparison {}) {
            match target_model_canonical_operation_atom_field_from_wire(
              wire: wire,
              field_name: ^target_canonical_operation_field_compare_field
            ) {
              Present { value: compare_field } =>
                match target_model_canonical_operation_atom_field_from_wire(
                  wire: wire,
                  field_name: ^target_canonical_operation_field_predicate
                ) {
                  Present { value: predicate_id } =>
                    match ordering_predicate_from_wire_symbol(id: predicate_id) {
                      Present { value: predicate } =>
                        outcome_accepted(
                          OrderingComparison {
                            compare_field: compare_field,
                            predicate: predicate
                          }
                        )
                      Absent =>
                        outcome_rejected(
                          target_canonical_operation_wire_malformed_diagnostic(wire: wire)
                        )
                    }
                  Absent =>
                    outcome_rejected(
                      target_canonical_operation_wire_malformed_diagnostic(wire: wire)
                    )
                }
              Absent =>
                outcome_rejected(
                  target_canonical_operation_wire_malformed_diagnostic(wire: wire)
                )
            }
          } else {
            if id == discriminant(v: EqualityComparison {}) {
              match target_model_canonical_operation_atom_field_from_wire(
                wire: wire,
                field_name: ^target_canonical_operation_field_eq_field
              ) {
                Present { value: eq_field } =>
                  match target_model_canonical_operation_atom_field_from_wire(
                    wire: wire,
                    field_name: ^target_canonical_operation_field_predicate
                  ) {
                    Present { value: predicate_id } =>
                      match equality_predicate_from_wire_symbol(id: predicate_id) {
                        Present { value: predicate } =>
                          outcome_accepted(
                            EqualityComparison {
                              eq_field: eq_field,
                              predicate: predicate
                            }
                          )
                        Absent =>
                          outcome_rejected(
                            target_canonical_operation_wire_malformed_diagnostic(wire: wire)
                          )
                      }
                    Absent =>
                      outcome_rejected(
                        target_canonical_operation_wire_malformed_diagnostic(wire: wire)
                      )
                  }
                Absent =>
                  outcome_rejected(
                    target_canonical_operation_wire_malformed_diagnostic(wire: wire)
                  )
              }
            } else {
              outcome_rejected(
                target_canonical_operation_wire_malformed_diagnostic(wire: wire)
              )
            }
          }
        }
      }
    _ =>
      outcome_rejected(
        target_canonical_operation_wire_malformed_diagnostic(wire: wire)
      )
  }
}

fn canonical_operation_wire_matches_operation(
  wire: Node,
  operation: CanonicalOperation
) -> Bool {
  match canonical_operation_from_wire_node(wire: wire) {
    Accepted { value: decoded, diagnostics: _ } =>
      canonical_operation_equal(left: decoded, right: operation)
    Rejected { diagnostics: _ } => false
  }
}

fn target_model_operator_shape_wire_node(shape: TargetOperatorShape) -> Node {
  match shape {
    InfixToken { token: t } =>
      Node {
        kind: TypeNode { connective: Atom { identity: discriminant(v: InfixToken {}) } },
        children: [
          target_model_named_edge(
            name: ^target_operator_shape_field_token,
            target: target_model_type_atom_node(identity: t)
          )
        ],
        occurrence_id: SyntheticOccurrence
      }
    PrefixToken { token: t } =>
      Node {
        kind: TypeNode { connective: Atom { identity: discriminant(v: PrefixToken {}) } },
        children: [
          target_model_named_edge(
            name: ^target_operator_shape_field_token,
            target: target_model_type_atom_node(identity: t)
          )
        ],
        occurrence_id: SyntheticOccurrence
      }
    CallIdent { ident: i } =>
      Node {
        kind: TypeNode { connective: Atom { identity: discriminant(v: CallIdent {}) } },
        children: [
          target_model_named_edge(
            name: ^target_operator_shape_field_token,
            target: target_model_type_atom_node(identity: i)
          )
        ],
        occurrence_id: SyntheticOccurrence
      }
    MethodIdent { ident: i } =>
      Node {
        kind: TypeNode { connective: Atom { identity: discriminant(v: MethodIdent {}) } },
        children: [
          target_model_named_edge(
            name: ^target_operator_shape_field_token,
            target: target_model_type_atom_node(identity: i)
          )
        ],
        occurrence_id: SyntheticOccurrence
      }
  }
}

fn target_operator_shape_wire_malformed_diagnostic(wire: Node) -> Diagnostic {
  Diagnostic {
    reason: ^target_operator_shape_wire_malformed,
    at: node_locus(node: wire),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_operator_shape_wire_schema_valid(wire: Node) -> Outcome<Bool> {
  match wire.kind {
    TypeNode { connective: Atom { identity: _ } } =>
      if name_occurrences(
        name: ^target_operator_shape_field_token,
        children: wire.children
      ) != 1 {
        outcome_rejected(target_operator_shape_wire_malformed_diagnostic(wire: wire))
      } else {
        match fold(
          wire.children,
          init: true,
          f: fn(acc, edge) {
            if acc {
              match edge.label {
                Named { name: n } => n == ^target_operator_shape_field_token
                Positional => false
              }
            } else {
              false
            }
          }
        ) {
          true => outcome_accepted(true)
          false =>
            outcome_rejected(target_operator_shape_wire_malformed_diagnostic(wire: wire))
        }
      }
    _ =>
      outcome_rejected(target_operator_shape_wire_malformed_diagnostic(wire: wire))
  }
}

fn target_operator_shape_token_from_wire(wire: Node) -> Outcome<Symbol> {
  match fold(
    wire.children,
    init: optional_absent(),
    f: fn(acc, edge) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match edge.label {
            Named { name: n } =>
              if n == ^target_operator_shape_field_token {
                match edge.target.kind {
                  TypeNode { connective: Atom { identity: token } } =>
                    optional_present(value: token)
                  _ => acc
                }
              } else {
                acc
              }
            Positional => acc
          }
      }
    }
  ) {
    Present { value: token } => outcome_accepted(token)
    Absent =>
      outcome_rejected(target_operator_shape_wire_malformed_diagnostic(wire: wire))
  }
}

fn target_operator_shape_from_wire_node(wire: Node) -> Outcome<TargetOperatorShape> {
  bind_outcome(
    o: target_operator_shape_wire_schema_valid(wire: wire),
    f: fn(_) {
      match wire.kind {
        TypeNode { connective: Atom { identity: id } } =>
          bind_outcome(
            o: target_operator_shape_token_from_wire(wire: wire),
            f: fn(token) {
              if id == discriminant(v: InfixToken {}) {
                outcome_accepted(InfixToken { token: token })
              } else if id == discriminant(v: PrefixToken {}) {
                outcome_accepted(PrefixToken { token: token })
              } else if id == discriminant(v: CallIdent {}) {
                outcome_accepted(CallIdent { ident: token })
              } else if id == discriminant(v: MethodIdent {}) {
                outcome_accepted(MethodIdent { ident: token })
              } else {
                outcome_rejected(
                  target_operator_shape_wire_malformed_diagnostic(wire: wire)
                )
              }
            }
          )
        _ =>
          outcome_rejected(target_operator_shape_wire_malformed_diagnostic(wire: wire))
      }
    }
  )
}

fn target_operator_realization_wire_malformed_diagnostic(row: Node) -> Diagnostic {
  Diagnostic {
    reason: ^target_operator_realization_wire_malformed,
    at: node_locus(node: row),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_operator_realization_row_wire_schema_valid(row: Node) -> Outcome<Bool> {
  match row.kind {
    TypeNode { connective: Conj } =>
      if name_occurrences(
        name: ^target_operator_realization_field_operation,
        children: row.children
      ) != 1 {
        outcome_rejected(target_operator_realization_wire_malformed_diagnostic(row: row))
      } else if name_occurrences(
        name: ^target_operator_realization_field_shape,
        children: row.children
      ) != 1 {
        outcome_rejected(target_operator_realization_wire_malformed_diagnostic(row: row))
      } else {
        match fold(
          row.children,
          init: true,
          f: fn(acc, edge) {
            if acc {
              match edge.label {
                Named { name: n } =>
                  n == ^target_operator_realization_field_operation
                  || n == ^target_operator_realization_field_shape
                Positional => false
              }
            } else {
              false
            }
          }
        ) {
          true => outcome_accepted(true)
          false =>
            outcome_rejected(target_operator_realization_wire_malformed_diagnostic(row: row))
        }
      }
    _ =>
      outcome_rejected(target_operator_realization_wire_malformed_diagnostic(row: row))
  }
}

fn target_operator_realization_from_wire_row(row: Node) -> Outcome<TargetOperatorRealization> {
  bind_outcome(
    o: target_operator_realization_row_wire_schema_valid(row: row),
    f: fn(_) {
      bind_outcome(
        o: find_named_child(root: row, name: ^target_operator_realization_field_operation),
        f: fn(operation_wire) {
          bind_outcome(
            o: canonical_operation_from_wire_node(wire: operation_wire),
            f: fn(canonical_op) {
              bind_outcome(
                o: find_named_child(root: row, name: ^target_operator_realization_field_shape),
                f: fn(shape_wire) {
                  bind_outcome(
                    o: target_operator_shape_from_wire_node(wire: shape_wire),
                    f: fn(shape) {
                      outcome_accepted(
                        TargetOperatorRealization {
                          operation: canonical_op,
                          shape: shape
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn target_operator_realization_node(
  operation: CanonicalOperation,
  shape: TargetOperatorShape
) -> Node {
  target_model_type_conj_node(
    children: [
      target_model_named_edge(
        name: ^target_operator_realization_field_operation,
        target: target_model_canonical_operation_wire_node(operation: operation)
      ),
      target_model_named_edge(
        name: ^target_operator_realization_field_shape,
        target: target_model_operator_shape_wire_node(shape: shape)
      )
    ]
  )
}

fn target_operator_realizations_catalog_node(rows: List<Node>) -> Node {
  target_model_type_conj_node(
    children: fold_list(
      xs: rows,
      empty: Empty,
      cons: fn(acc, row) {
        Cons {
          head: target_model_named_edge(
            name: ^target_operator_realization_row_edge,
            target: row
          ),
          tail: acc
        }
      }
    )
  )
}

fn target_value_projection_field_missing_diagnostic(bundle: Node, _field: Symbol) -> Diagnostic {
  Diagnostic {
    reason: ^target_value_projection_field_missing,
    at: node_locus(node: bundle),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn projection_bundle_child(bundle: Node, name: Symbol) -> Outcome<Node> {
  find_named_child(root: bundle, name: name)
}

fn projection_bundle_symbol_field(bundle: Node, field: Symbol) -> Outcome<Symbol> {
  bind_outcome(
    o: find_named_child(root: bundle, name: field),
    f: fn(child) {
      match child.kind {
        TypeNode { connective: Atom { identity: id } } => outcome_accepted(id)
        _ =>
          outcome_rejected(
            target_value_projection_bundle_malformed_diagnostic(bundle: bundle)
          )
      }
    }
  )
}

fn decode_binding_ref_shape_bundle(bundle: Node) -> Outcome<TargetBindingRefShape> {
  bind_outcome(
    o: projection_bundle_symbol_field(
      bundle: bundle,
      field: ^target_value_expr_field_ident_token
    ),
    f: fn(ident_token) {
      outcome_accepted(
        TargetBindingRefShape { ident_token: ident_token }
      )
    }
  )
}

fn decode_primitive_apply_shape_bundle(bundle: Node) -> Outcome<TargetPrimitiveApplyShape> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: bundle, field: ^target_value_expr_field_open),
    f: fn(open) {
      bind_outcome(
        o: projection_bundle_symbol_field(bundle: bundle, field: ^target_value_expr_field_close),
        f: fn(close) {
          bind_outcome(
            o: projection_bundle_symbol_field(
              bundle: bundle,
              field: ^target_value_expr_field_separator
            ),
            f: fn(separator) {
              outcome_accepted(
                TargetPrimitiveApplyShape {
                  open: open,
                  close: close,
                  separator: separator
                }
              )
            }
          )
        }
      )
    }
  )
}

fn decode_conditional_shape_bundle(bundle: Node) -> Outcome<TargetConditionalShape> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: bundle, field: ^target_value_expr_field_if_token),
    f: fn(if_token) {
      bind_outcome(
        o: projection_bundle_symbol_field(
          bundle: bundle,
          field: ^target_value_expr_field_then_token
        ),
        f: fn(then_token) {
          bind_outcome(
            o: projection_bundle_symbol_field(
              bundle: bundle,
              field: ^target_value_expr_field_else_token
            ),
            f: fn(else_token) {
              outcome_accepted(
                TargetConditionalShape {
                  if_token: if_token,
                  then_token: then_token,
                  else_token: else_token
                }
              )
            }
          )
        }
      )
    }
  )
}

fn decode_bind_let_shape_bundle(bundle: Node) -> Outcome<TargetBindLetShape> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: bundle, field: ^target_value_expr_field_let_token),
    f: fn(let_token) {
      bind_outcome(
        o: projection_bundle_symbol_field(
          bundle: bundle,
          field: ^target_value_expr_field_assign_token
        ),
        f: fn(assign_token) {
          bind_outcome(
            o: projection_bundle_symbol_field(bundle: bundle, field: ^target_value_expr_field_in_token),
            f: fn(in_token) {
              outcome_accepted(
                TargetBindLetShape {
                  let_token: let_token,
                  assign_token: assign_token,
                  in_token: in_token
                }
              )
            }
          )
        }
      )
