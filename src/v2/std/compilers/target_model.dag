      children: list_append(
        left: [
          target_model_named_edge(
            name: ^target_value_expr_field_match_scrutinee,
            target: scrutinee.node
          )
        ],
        right: target_value_expr_match_arm_edges(arms: arms)
      ),
      occurrence_id: SyntheticOccurrence
    }
  }
}

