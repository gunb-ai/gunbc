module v2.std.compilers.target_model



// Produced-declaration support is a TARGET-owned rendering, opaque to the compiler.
// The compiler asks a target for a produced declaration and receives a bodied-arrow
// scaffold; it does not know whether a signature leads with a keyword or a return
// type, which side of a parameter the type sits on, whether a return arrow exists, or
// how the declaration closes. Rust owns Rust order in the Rust module, C owns C order
// in the C module, and a new target registers by supplying a renderer -- never by an
// edit here.
//
// Why this is not the debt that a compiler-side slot template would have been: a
// template puts ORDER in the compiler, so the terminal architecture deletes it. A
// renderer puts order in the TARGET, where realization belongs, so when the
// GrammarRelationRow forward reading lands each renderer's BODY changes to derive
// from rows while this SEAM -- compiler asks, target renders -- survives untouched.
// That is the test of whether the seam was cut in the right place.
//
// The limit that remains, named rather than left for a third target to discover: the
// compiler no longer knows how a declaration CLOSES, but still knows it is prefix then
// body then suffix, because that is TargetBodiedArrowStatementScaffold's shape -- a
// pre-existing type shared by every bodied arrow and consumed by 06_translate. A
// target whose signature follows its body needs the body-scaffold lane, not this seam.
//
// scaffold_relation_rule_name and scaffold_base_row carry no ordering, spelling or
// closing assumption: they name WHICH grammar row the scaffold attaches to and supply
// the bare row to attach it to. The compiler looks the name up and re-attaches
// opaquely. The row is deliberately BARE -- a target's ordinary translation rules
// already hold a row with a fixed scaffold attached, and re-attaching to that one
// would append a second bodied-scaffold edge whose first, fixed entry would win every
// lookup, emitting one declaration's signature for every declaration.
type ProducedDeclSupport
  = ProducedDeclUnwired
  | ProducedDeclWired {
      render: fn(v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetBodiedArrowStatementScaffold>
      scaffold_relation_rule_name: v2.std.node.Symbol
      scaffold_base_row: v2.std.node.Node
    }

type TargetModel {
  bundle: v2.std.node.Node
  lex: v2.std.compilers.lexing.LexRules
  binding_spellings: Map<v2.std.node.Symbol, String>
  token_class_emit_transforms: Map<v2.std.node.Symbol, fn(String) -> String>
  authority_source_text: String
  runtime_row: v2.std.host_transport.TargetEmitHostRuntimeRow
  produced_decl_support: v2.std.compilers.target_model.ProducedDeclSupport
}

fn target_model_declared_inhabitants(target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  projection_bundle_child(
    bundle: target.bundle,
    name: ^target_model_edge_declared_inhabitants
  )
}

fn target_model_selection_priority(target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  projection_bundle_child(
    bundle: target.bundle,
    name: ^target_model_edge_selection_policy
  )
}

data target_model_emit_transforms_empty: Map<v2.std.node.Symbol, fn(String) -> String> = empty_map()

fn target_model_make_with_emit_transforms(
  bundle: v2.std.node.Node,
  lex: v2.std.compilers.lexing.LexRules,
  binding_spellings: Map<v2.std.node.Symbol, String>,
  token_class_emit_transforms: Map<v2.std.node.Symbol, fn(String) -> String>,
  authority_source_text: String,
  runtime_row: v2.std.host_transport.TargetEmitHostRuntimeRow
) -> v2.std.compilers.target_model.TargetModel {
  TargetModel {
    produced_decl_support: ProducedDeclUnwired,
    bundle: bundle,
    lex: lex,
    binding_spellings: binding_spellings,
    token_class_emit_transforms: token_class_emit_transforms,
    authority_source_text: authority_source_text,
    runtime_row: runtime_row
  }
}

fn runtime_row_from_target(target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<v2.std.host_transport.EmitHostRuntimeRow> {
  configured_emit_host_runtime_row_from_target_row(row: target.runtime_row)
}

type ConcreteSyntaxToken
  = FixedToken { token_class: v2.std.node.Symbol }
  | BoundToken { token_class: v2.std.node.Symbol, binding: v2.std.node.Symbol }

fn concrete_syntax_token_to_node(token: v2.std.compilers.target_model.ConcreteSyntaxToken) -> v2.std.node.Node {
  match token {
    FixedToken { token_class: c } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: Conj },
        children: [
          v2.std.node.Edge {
            label: Named { name: ^concrete_syntax_token_field_kind },
            target: v2.std.node.Node {
              kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^concrete_syntax_token_kind_fixed } },
              children: [],
              occurrence_id: SyntheticOccurrence
}
          },
          v2.std.node.Edge {
            label: Named { name: ^concrete_syntax_token_field_class },
            target: v2.std.node.Node {
              kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: c } },
              children: [],
              occurrence_id: SyntheticOccurrence
}
          }
        ],
        occurrence_id: SyntheticOccurrence
}
    BoundToken { token_class: c, binding: b } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: Conj },
        children: [
          v2.std.node.Edge {
            label: Named { name: ^concrete_syntax_token_field_kind },
            target: v2.std.node.Node {
              kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^concrete_syntax_token_kind_bound } },
              children: [],
              occurrence_id: SyntheticOccurrence
}
          },
          v2.std.node.Edge {
            label: Named { name: ^concrete_syntax_token_field_class },
            target: v2.std.node.Node {
              kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: c } },
              children: [],
              occurrence_id: SyntheticOccurrence
}
          },
          v2.std.node.Edge {
            label: Named { name: ^concrete_syntax_token_field_binding },
            target: v2.std.node.Node {
              kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: b } },
              children: [],
              occurrence_id: SyntheticOccurrence
}
          }
        ],
        occurrence_id: SyntheticOccurrence
}
  }
}

fn concrete_syntax_token_class(token: v2.std.compilers.target_model.ConcreteSyntaxToken) -> v2.std.node.Symbol {
  match token {
    FixedToken { token_class: c } => c
    BoundToken { token_class: c, binding: _ } => c
  }
}

fn phrase_to_fixed_concrete_tokens(p: v2.std.compilers.lexing.LexicalPhrase) -> v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  fold_list(
    xs: p.spans,
    empty: std.algebra.Empty,
    cons: fn(acc, s) {
      list_snoc_item(xs: acc, item: FixedToken { token_class: s.token_class })
    }
  )
}

fn target_lex_rule_literal_not_found_diagnostic(token_class: v2.std.node.Symbol) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_lex_rule_literal_not_found,
    at: node_locus(node: v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: token_class } },
      children: [],
      occurrence_id: SyntheticOccurrence
    }),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_binding_spelling_not_found_diagnostic(binding: v2.std.node.Symbol) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_binding_spelling_not_found,
    at: node_locus(node: v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: binding } },
      children: [],
      occurrence_id: SyntheticOccurrence
    }),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_concrete_token_kind_invalid_diagnostic(token: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_concrete_token_kind_invalid,
    at: node_locus(node: token),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_optional_named_child(root: v2.std.node.Node, name: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<Optional<v2.std.node.Node>> {
  match find_named_child(root: root, name: name) {
    Accepted { value: child, diagnostics: d } =>
      v2.std.diagnostic.Accepted { value: optional_present(value: child), diagnostics: d }
    Rejected { diagnostics: _ } => outcome_accepted(optional_absent())
  }
}

fn target_node_atom_identity(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Symbol> {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } => outcome_accepted(id)
    _ => outcome_rejected(target_concrete_token_kind_invalid_diagnostic(token: node))
  }
}

fn concrete_syntax_token_from_node(token: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  bind_outcome(
    o: find_named_child(root: token, name: ^concrete_syntax_token_field_kind),
    f: fn(kind_node) {
      bind_outcome(
        o: target_node_atom_identity(node: kind_node),
        f: fn(kind) {
          bind_outcome(
            o: find_named_child(root: token, name: ^concrete_syntax_token_field_class),
            f: fn(class_node) {
              bind_outcome(
                o: target_node_atom_identity(node: class_node),
                f: fn(token_class) {
                  bind_outcome(
                    o: target_optional_named_child(
                      root: token,
                      name: ^concrete_syntax_token_field_binding
                    ),
                    f: fn(binding_node) {
                      if kind == ^concrete_syntax_token_kind_fixed {
                        match binding_node {
                          Present { value: _ } =>
                            outcome_rejected(
                              target_concrete_token_kind_invalid_diagnostic(token: token)
                            )
                          Absent =>
                            outcome_accepted(
                              FixedToken { token_class: token_class }
                            )
                        }
                      } else {
                        if kind == ^concrete_syntax_token_kind_bound {
                          match binding_node {
                            Present { value: binding_child } =>
                              bind_outcome(
                                o: target_node_atom_identity(node: binding_child),
                                f: fn(binding) {
                                  outcome_accepted(
                                    BoundToken {
                                      token_class: token_class,
                                      binding: binding
                                    }
                                  )
                                }
                              )
                            Absent =>
                              outcome_rejected(
                                target_concrete_token_kind_invalid_diagnostic(token: token)
                              )
                          }
                        } else {
                          outcome_rejected(
                            target_concrete_token_kind_invalid_diagnostic(token: token)
                          )
                        }
                      }
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn target_type_expr_projection_bundle_malformed_diagnostic(bundle: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_type_expr_projection_bundle_malformed,
    at: node_locus(node: bundle),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_collection_shape_malformed_diagnostic(node: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_collection_shape_malformed,
    at: node_locus(node: node),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_lex_rule_literal_step(
  acc: v2.std.diagnostic.Outcome<String>,
  rule: v2.std.compilers.lexing.LexRule,
  token_class: v2.std.node.Symbol
) -> v2.std.diagnostic.Outcome<String> {
  match acc {
    Accepted { value: _, diagnostics: _ } => acc
    Rejected { diagnostics: _ } =>
      match rule {
        TokenRule { token_class: c, pattern: pattern } =>
          if c == token_class {
            match pattern {
              LiteralPattern { text: text } =>
                v2.std.diagnostic.Accepted { value: text, diagnostics: v2.std.diagnostic.None }
              KeywordPattern { text: text } =>
                v2.std.diagnostic.Accepted { value: text, diagnostics: v2.std.diagnostic.None }
              _ =>
                v2.std.diagnostic.Rejected {
                  diagnostics: diagnostics_singleton(
                    d: target_lex_rule_literal_not_found_diagnostic(token_class: token_class)
                  )
                }
            }
          } else {
            acc
          }
        TriviaRule { pattern: _ } => acc
        AnnotationRule { annotation_class: _, pattern: _ } => acc
      }
  }
}

fn lex_rules_literal_for_class(rules: v2.std.compilers.lexing.LexRules, token_class: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<String> {
  match rules {
    VoidLexRules =>
      outcome_rejected(
        target_lex_rule_literal_not_found_diagnostic(token_class: token_class)
      )
    ModeledLexRules { root: set } =>
      fold_list(
        xs: set.rules,
        empty: v2.std.diagnostic.Rejected {
          diagnostics: diagnostics_singleton(
            d: target_lex_rule_literal_not_found_diagnostic(token_class: token_class)
          )
        },
        cons: fn(acc, rule) {
          target_lex_rule_literal_step(acc: acc, rule: rule, token_class: token_class)
        }
      )
  }
}

fn lex_rules_literal(target: v2.std.compilers.target_model.TargetModel, token_class: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<String> {
  lex_rules_literal_for_class(rules: target.lex, token_class: token_class)
}

fn bound_spelling_from_map(
  binding_spellings: Map<v2.std.node.Symbol, String>,
  binding: v2.std.node.Symbol
) -> v2.std.diagnostic.Outcome<String> {
  match v2.std.collection.map_get(binding_spellings, binding) {
    Accepted { value: opt, diagnostics: pending } => match opt {
      Present { value: spelling } => v2.std.diagnostic.Accepted { value: spelling, diagnostics: pending }
      Absent => symbol_interned_spelling(binding: binding)
    }
    Rejected { diagnostics: ds } => v2.std.diagnostic.Rejected { diagnostics: ds }
  }
}

data target_text_carrier_scaffold_note: String = "TargetText emit-seam carrier (Slice A1): v2.std.compilers.target_model.TargetText is the typed emit-seam carrier -- a nominal newtype over emitted source text, DISTINCT from String at the model layer, so emitted content flows as TargetText and a framing String fragment is a DIFFERENT type from it. ENFORCEMENT (corrected 2026-07-15, proven by execution): the type-level compile wall does NOT fire today -- neither the v1 seed nor v2 04_infer typechecks function-application argument types (04_infer carrier-checks only Branch/Match/Loop; there is no arg-vs-param unification), so a raw String passed where TargetText is declared compiles CLEAN (verified: injected smuggle at a live serialize site, full gate compile returned 0 diagnostics). Therefore this is a DESIGN.md §5 wall-AFTER-grounding (decidable, types declared and threaded, enforcement pending), NOT a wall-by-construction. Runtime guard only: .source field-access on a String fails at eval, fail-closed at runtime. The retired no-smuggled-programs / medium_structure_containment lens (#6831) is not live enforcement. Declared FRONTIER ROW, counted and prioritizable, not a silent escape hatch: DISSOLUTION TRIGGER = application-argument typechecking in 04_infer (does not exist today; its absence means EVERY type-based construction guarantee is unenforced at the call boundary -- the real root this frontier waits on). The language is NOT carried on the carrier -- it is already determined by the target: v2.std.compilers.target_model.TargetModel the serialize fold holds (operator ruling 2026-07-14: a lang tag would be a §3 nickname for the extdeps.languages module). Home is std/compilers BESIDE bound_tokens_source_text (operator ruling 2026-07-15) so that fold is carrier-NATIVE: the SINGLE String->carrier introduction is text_atom (one grammar-classified token = an atom), introduced INSIDE the token fold; the ONLY join is the grammar-owned token-sequence combinator target_text_seq (folding the grammar row's declared token order); the ONLY carrier->String exit is render_target_text (whole-value render at the artifact lift + at genuine String sinks like authority_source_text). There is deliberately NO String->v2.std.compilers.target_model.TargetText lift of an already-composed unit -- that direction is the smuggle the wall closes. Scaffold (seed-layer forward subset of the v2 TargetModel grammar rows, serialize_target's inverse); dissolution trigger for the scaffold itself = the grammar-row inverse subsuming it at self-host."

type TargetText { source: String }

data target_text_empty: v2.std.compilers.target_model.TargetText = TargetText { source: "" }

fn text_atom(lexeme: String) -> v2.std.compilers.target_model.TargetText {
  TargetText { source: lexeme }
}

fn target_text_seq(acc: v2.std.compilers.target_model.TargetText, next: v2.std.compilers.target_model.TargetText) -> v2.std.compilers.target_model.TargetText {
  TargetText { source: concat(acc.source, next.source) }
}

fn render_target_text(t: v2.std.compilers.target_model.TargetText) -> String {
  t.source
}

fn target_text_is_empty(t: v2.std.compilers.target_model.TargetText) -> Bool {
  is_empty(xs: t.source)
}

fn bound_tokens_source_text(
  tokens: v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>,
  lex: v2.std.compilers.lexing.LexRules,
  binding_spellings: Map<v2.std.node.Symbol, String>
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetText> {
  fold_list(
    xs: tokens,
    empty: v2.std.diagnostic.Accepted { value: target_text_empty, diagnostics: v2.std.diagnostic.None },
    cons: fn(acc, token) {
      match acc {
        Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
        Accepted { value: partial, diagnostics: ad } =>
          match token {
            FixedToken { token_class: tc } =>
              bind_outcome(
                o: lex_rules_literal_for_class(rules: lex, token_class: tc),
                f: fn(spelling) {
                  v2.std.diagnostic.Accepted { value: target_text_seq(acc: partial, next: text_atom(lexeme: spelling)), diagnostics: ad }
                }
              )
            BoundToken { token_class: _, binding: b } =>
              bind_outcome(
                o: bound_spelling_from_map(binding_spellings: binding_spellings, binding: b),
                f: fn(spelling) {
                  v2.std.diagnostic.Accepted { value: target_text_seq(acc: partial, next: text_atom(lexeme: spelling)), diagnostics: ad }
                }
              )
          }
      }
    }
  )
}

fn target_binding_spelling_lookup(
  target: v2.std.compilers.target_model.TargetModel,
  binding: v2.std.node.Symbol
) -> v2.std.diagnostic.Outcome<String> {
  bound_spelling_from_map(binding_spellings: target.binding_spellings, binding: binding)
}

fn symbol_interned_spelling(binding: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<String> {
  outcome_accepted(value: binding)
}

fn apply_emit_spelling_transform(
  transform: fn(String) -> String,
  spelling: String
) -> String {
  transform(spelling)
}

// A FIXED TOKEN'S SPELLING IS ITS LEXEME, THEN THE TARGET'S EMIT TRANSFORM. The transform map was
// consulted for bound tokens only, which left the serializer with NO source of layout for fixed
// ones: target_text_seq concatenates exactly, so a grammar whose punctuation is fixed emits
// "moduleboard_power_interlock(" and there was no target-owned way to say otherwise. Every
// existing target sets the map empty and is therefore byte-identical under this change.
//
// The asymmetry was the defect. A transform is a fact about how a TOKEN CLASS renders, and
// nothing about that is specific to whether the lexeme came from a binding or from the lexer —
// so the fixed arm consults the same map rather than a second layout mechanism growing beside it.
fn fixed_token_spelling_from_model(
  target: v2.std.compilers.target_model.TargetModel,
  token_class: v2.std.node.Symbol
) -> v2.std.diagnostic.Outcome<String> {
  bind_outcome(
    o: lex_rules_literal_for_class(rules: target.lex, token_class: token_class),
    f: fn(spelling) {
      match v2.std.collection.map_get(target.token_class_emit_transforms, token_class) {
        v2.std.diagnostic.Accepted { value: Present { value: transform }, diagnostics: d } =>
          outcome_with_diagnostics(
            value: apply_emit_spelling_transform(transform: transform, spelling: spelling),
            diagnostics: d
          )
        Accepted { value: Absent, diagnostics: d } =>
          outcome_with_diagnostics(value: spelling, diagnostics: d)
        Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
      }
    }
  )
}

fn bound_token_spelling_from_model(
  target: v2.std.compilers.target_model.TargetModel,
  token_class: v2.std.node.Symbol,
  binding: v2.std.node.Symbol
) -> v2.std.diagnostic.Outcome<String> {
  bind_outcome(
    o: target_binding_spelling_lookup(target: target, binding: binding),
    f: fn(spelling) {
      match v2.std.collection.map_get(target.token_class_emit_transforms, token_class) {
        v2.std.diagnostic.Accepted { value: Present { value: transform }, diagnostics: d } =>
          outcome_with_diagnostics(
            value: apply_emit_spelling_transform(transform: transform, spelling: spelling),
            diagnostics: d
          )
        Accepted { value: Absent, diagnostics: d } =>
          outcome_with_diagnostics(value: spelling, diagnostics: d)
        Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
      }
    }
  )
}

fn token_spelling_from_model(target: v2.std.compilers.target_model.TargetModel, token: v2.std.node.Node) -> v2.std.diagnostic.Outcome<String> {
  bind_outcome(
    o: concrete_syntax_token_from_node(token: token),
    f: fn(decoded) {
      match decoded {
        FixedToken { token_class: token_class } =>
          fixed_token_spelling_from_model(target: target, token_class: token_class)
        BoundToken { token_class: token_class, binding: binding } =>
          bound_token_spelling_from_model(
            target: target,
            token_class: token_class,
            binding: binding
          )
      }
    }
  )
}

fn serialize_type_expr_arrow_param_spelling(
  target: v2.std.compilers.target_model.TargetModel,
  label: v2.std.node.Symbol
) -> v2.std.diagnostic.Outcome<String> {
  target_binding_spelling_lookup(target: target, binding: label)
}

type SourceAtomValue
  = SourceAtomSymbol { identity: v2.std.node.Symbol }
  | SourceAtomBool { value: Bool }
  | SourceAtomChar { codepoint: std.types.Char }

  | SourceAtomString { value: v2.std.node.Node }

type TargetValueExpressionKind
  = TargetValueExprSymbolIdentity
  | TargetValueExprSymbolToOwnedString
  | TargetValueExprBoolLiteral
  | TargetValueExprCharUnicodeScalar
  | TargetValueExprStringLiteral
  | TargetValueExprReferenceRcNew
  | TargetValueExprReferenceBoxNew
  | TargetValueExprBindingRef
  | TargetValueExprPrimitiveApply
  | TargetValueExprEffectApply

  | TargetValueExprCallableApply

  | TargetValueExprClosure
  | TargetValueExprConditional
  | TargetValueExprBindLet
  | TargetValueExprLoop
  | TargetValueExprRecordConstruct
  | TargetValueExprFieldAccess
  | TargetValueExprMatch

type TargetValueExpression {
  kind: v2.std.compilers.target_model.TargetValueExpressionKind
  node: v2.std.node.Node
}

type TargetValueTemplateKind
  = ValueSymbolIdentityPassthrough
  | ValueSymbolToOwnedString
  | ValueBoolLiteral
  | ValueCharUnicodeScalar
  | ValueStringLiteral
  | ValueBindingRef
  | ValuePrimitiveApply
  | ValueEffectApply
  | ValueConditional
  | ValueBindLet
  | ValueLoop
  | ValueRecordConstruct
  | ValueFieldAccess
  | ValueMatch

type TargetValueTemplate {
  kind: v2.std.compilers.target_model.TargetValueTemplateKind
  node: v2.std.node.Node
}

type OrderingPredicate
  = IsLess
  | IsLessOrEqual
  | IsGreater
  | IsGreaterOrEqual

type EqualityPredicate
  = IsEqual
  | IsNotEqual

type CanonicalOperation
  = AlgebraPrimitive { algebra_field: v2.std.node.Symbol }
  | AlgebraInverseCompose { binary_field: v2.std.node.Symbol, inverse_field: v2.std.node.Symbol }
  | OrderingComparison { compare_field: v2.std.node.Symbol, predicate: v2.std.compilers.target_model.OrderingPredicate }
  | EqualityComparison { eq_field: v2.std.node.Symbol, predicate: v2.std.compilers.target_model.EqualityPredicate }

fn ordering_predicate_accepts(predicate: v2.std.compilers.target_model.OrderingPredicate) -> v2.std.collection.List<std.algebra.Ordering> {
  match predicate {
    IsLess => [Less]
    IsLessOrEqual => [Less, Equal]
    IsGreater => [Greater]
    IsGreaterOrEqual => [Equal, Greater]
  }
}

fn equality_predicate_accepts(predicate: v2.std.compilers.target_model.EqualityPredicate) -> Bool {
  match predicate {
    IsEqual => true
    IsNotEqual => false
  }
}

fn canonical_operation_op_add() -> v2.std.compilers.target_model.CanonicalOperation {
  AlgebraPrimitive { algebra_field: ^ring_field_add }
}

fn canonical_operation_op_mul() -> v2.std.compilers.target_model.CanonicalOperation {
  AlgebraPrimitive { algebra_field: ^ring_field_mul }
}

fn canonical_operation_op_negate() -> v2.std.compilers.target_model.CanonicalOperation {
  AlgebraPrimitive { algebra_field: ^group_field_inverse }
}

fn canonical_operation_op_and() -> v2.std.compilers.target_model.CanonicalOperation {
  AlgebraPrimitive { algebra_field: ^lattice_field_meet }
}

fn canonical_operation_op_or() -> v2.std.compilers.target_model.CanonicalOperation {
  AlgebraPrimitive { algebra_field: ^lattice_field_join }
}

fn canonical_operation_op_not() -> v2.std.compilers.target_model.CanonicalOperation {
  AlgebraPrimitive { algebra_field: ^boolean_algebra_field_complement }
}

fn canonical_operation_op_sub() -> v2.std.compilers.target_model.CanonicalOperation {
  AlgebraInverseCompose {
    binary_field: ^ring_field_add,
    inverse_field: ^group_field_inverse
  }
}

fn canonical_operation_op_div() -> v2.std.compilers.target_model.CanonicalOperation {
  AlgebraInverseCompose {
    binary_field: ^ring_field_mul,
    inverse_field: ^field_field_reciprocal
  }
}

fn canonical_operation_op_lt() -> v2.std.compilers.target_model.CanonicalOperation {
  OrderingComparison { compare_field: ^ordered_ring_field_compare, predicate: IsLess }
}

fn canonical_operation_op_le() -> v2.std.compilers.target_model.CanonicalOperation {
  OrderingComparison { compare_field: ^ordered_ring_field_compare, predicate: IsLessOrEqual }
}

fn canonical_operation_op_gt() -> v2.std.compilers.target_model.CanonicalOperation {
  OrderingComparison { compare_field: ^ordered_ring_field_compare, predicate: IsGreater }
}

fn canonical_operation_op_ge() -> v2.std.compilers.target_model.CanonicalOperation {
  OrderingComparison { compare_field: ^ordered_ring_field_compare, predicate: IsGreaterOrEqual }
}

fn canonical_operation_op_eq() -> v2.std.compilers.target_model.CanonicalOperation {
  EqualityComparison { eq_field: ^equivalence_field_eq, predicate: IsEqual }
}

fn canonical_operation_op_ne() -> v2.std.compilers.target_model.CanonicalOperation {
  EqualityComparison { eq_field: ^equivalence_field_eq, predicate: IsNotEqual }
}

type TargetOperatorShape
  = InfixToken { token: v2.std.node.Symbol }
  | PrefixToken { token: v2.std.node.Symbol }
  | CallIdent { ident: v2.std.node.Symbol }
  | MethodIdent { ident: v2.std.node.Symbol }

type TargetOperatorRealization {
  operation: v2.std.compilers.target_model.CanonicalOperation
  shape: v2.std.compilers.target_model.TargetOperatorShape
}

type TargetBindingRefShape {
  ident_token: v2.std.node.Symbol
}

type TargetPrimitiveApplyShape {
  open: v2.std.node.Symbol
  close: v2.std.node.Symbol
  separator: v2.std.node.Symbol
}

type TargetCallApplyShape {
  callee_ident_token: v2.std.node.Symbol
  open: v2.std.node.Symbol
  separator: v2.std.node.Symbol
  close: v2.std.node.Symbol
}

type TargetEffectCalleeRow {
  effect_kind: v2.std.node.Symbol
  callee: v2.std.node.Symbol
}

type TargetEffectApplyShape {
  callees: v2.std.collection.List<v2.std.compilers.target_model.TargetEffectCalleeRow>
  open: v2.std.node.Symbol
  close: v2.std.node.Symbol
  separator: v2.std.node.Symbol
}

type TargetClosureShape {
  fn_token: v2.std.node.Symbol
  open: v2.std.node.Symbol
  separator: v2.std.node.Symbol
  close: v2.std.node.Symbol
  body_open: v2.std.node.Symbol
  body_close: v2.std.node.Symbol
  param_ident_token: v2.std.node.Symbol
}

// Whether the construct needs a token AFTER its final arm. This is the axis the
// shapes previously did not carry, and its absence is why Rust's closing brace
// was smuggled into hand-authored declaration scaffolds ending in two rbrace:
// the expression left a brace open and the declaration closed it.
// The closing token is payload on the CLOSING arm only, so a self-delimiting
// target has no field in which to write a fictional token. That is the property
// an Optional<Symbol> would not have had -- there, Absent would mean both "this
// target is self-delimiting" and "nobody modeled it yet", the state-space
// conflation DESIGN forbids, and a missing close would read as fine again.
type ConditionalDelimiting
  = ConditionalClosedByToken { close_token: v2.std.node.Symbol }
  | ConditionalSelfDelimiting

type TargetConditionalShape {
  if_token: v2.std.node.Symbol
  then_token: v2.std.node.Symbol
  else_token: v2.std.node.Symbol
  delimiting: v2.std.compilers.target_model.ConditionalDelimiting
}

type TargetBindLetShape {
  let_token: v2.std.node.Symbol
  assign_token: v2.std.node.Symbol
  in_token: v2.std.node.Symbol
}

type TargetLoopShape {
  loop_token: v2.std.node.Symbol
}

type BlockEvaluationMode
  = ValueProducing
  | StatementSequenced {
      return_token: v2.std.node.Symbol
      statement_terminator: v2.std.node.Symbol
    }

type RecordLiteralTypeNaming
  = Prepend
  | Omit

type TargetRecordConstructShape {
  open: v2.std.node.Symbol
  close: v2.std.node.Symbol
  separator: v2.std.node.Symbol
  assign: v2.std.node.Symbol
  record_literal_names_type: v2.std.compilers.target_model.RecordLiteralTypeNaming
}

type TargetFieldAccessShape {
  dot: v2.std.node.Symbol
}

type TargetMatchShape {
  match_token: v2.std.node.Symbol
  scrutinee_open: v2.std.node.Symbol
  scrutinee_close: v2.std.node.Symbol
  open: v2.std.node.Symbol
  close: v2.std.node.Symbol
  fat_arrow: v2.std.node.Symbol
  arm_separator: v2.std.node.Symbol
}

type TargetBoolLiteralShape {
  true_token: v2.std.node.Symbol
  false_token: v2.std.node.Symbol
}

type TargetValueExpressionProjection {
  binding_ref_form: v2.std.compilers.target_model.TargetBindingRefShape
  primitive_apply_form: v2.std.compilers.target_model.TargetPrimitiveApplyShape
  callable_apply_form: v2.std.compilers.target_model.TargetCallApplyShape
  closure_form: v2.std.compilers.target_model.TargetClosureShape
  effect_apply_form: v2.std.compilers.target_model.TargetEffectApplyShape
  conditional_form: v2.std.compilers.target_model.TargetConditionalShape
  let_form: v2.std.compilers.target_model.TargetBindLetShape
  loop_form: v2.std.compilers.target_model.TargetLoopShape
  record_construct_form: v2.std.compilers.target_model.TargetRecordConstructShape
  field_access_form: v2.std.compilers.target_model.TargetFieldAccessShape
  match_form: v2.std.compilers.target_model.TargetMatchShape
  bool_literal_form: v2.std.compilers.target_model.TargetBoolLiteralShape
  block_evaluation_mode: v2.std.compilers.target_model.BlockEvaluationMode
}

type TargetBodiedArrowStatementScaffold {
  prefix: v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>
  suffix: v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>
}

type TargetImportShape
  = EsModuleImport {
      import_token: v2.std.node.Symbol
      names_open: v2.std.node.Symbol
      names_separator: v2.std.node.Symbol
      names_close: v2.std.node.Symbol
      from_token: v2.std.node.Symbol
      path_open: v2.std.node.Symbol
      path_segment_separator: v2.std.node.Symbol
      path_close: v2.std.node.Symbol
      terminator: v2.std.node.Symbol
      name_ident_token: v2.std.node.Symbol
      path_segment_token: v2.std.node.Symbol
    }

type TargetModuleProjection {
  import_form: v2.std.compilers.target_model.TargetImportShape
}

type TargetImport {
  path_segments: v2.std.collection.List<v2.std.node.Symbol>
  names: v2.std.collection.List<v2.std.node.Symbol>
}

fn derive_bodied_arrow_scaffold(
  signature_with_open: v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>,
  block_close: v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken>,
  mode: v2.std.compilers.target_model.BlockEvaluationMode
) -> v2.std.compilers.target_model.TargetBodiedArrowStatementScaffold {
  match mode {
    ValueProducing =>
      TargetBodiedArrowStatementScaffold {
        prefix: signature_with_open,
        suffix: block_close
      }
    StatementSequenced {
      return_token: return_token,
      statement_terminator: statement_terminator
    } =>
      TargetBodiedArrowStatementScaffold {
        prefix: list_snoc_item(
          xs: signature_with_open,
          item: FixedToken { token_class: return_token }
        ),
        suffix: list_append(
          left: [FixedToken { token_class: statement_terminator }],
          right: block_close
        )
      }
  }
}

fn target_model_type_atom_node(identity: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: identity } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn target_model_type_conj_node(children: v2.std.collection.List<v2.std.node.Edge>) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: children,
    occurrence_id: SyntheticOccurrence
  }
}

fn target_canonical_operation_wire_malformed_diagnostic(wire: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_canonical_operation_wire_malformed,
    at: node_locus(node: wire),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_model_canonical_operation_atom_field_from_wire(
  wire: v2.std.node.Node,
  field_name: v2.std.node.Symbol
) -> v2.std.optional.Optional<v2.std.node.Symbol> {
  match fold(
    wire.children,
    init: optional_absent(),
    f: fn(acc, edge) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match edge.label {
            Named { name: n } =>
              if n == field_name {
                match edge.target.kind {
                  TypeNode { connective: Atom { identity: id } } =>
                    optional_present(value: id)
                  _ => acc
                }
              } else {
                acc
              }
            Positional => acc
          }
      }
    }
  ) {
    Present { value: field } => optional_present(value: field)
    Absent => optional_absent()
  }
}

fn ordering_predicate_wire_symbol(predicate: v2.std.compilers.target_model.OrderingPredicate) -> v2.std.node.Symbol {
  match predicate {
    IsLess => ^ordering_predicate_is_less
    IsLessOrEqual => ^ordering_predicate_is_less_or_equal
    IsGreater => ^ordering_predicate_is_greater
    IsGreaterOrEqual => ^ordering_predicate_is_greater_or_equal
  }
}

fn ordering_predicate_from_wire_symbol(id: v2.std.node.Symbol) -> v2.std.optional.Optional<v2.std.compilers.target_model.OrderingPredicate> {
  if id == ^ordering_predicate_is_less {
    optional_present(value: IsLess)
  } else {
    if id == ^ordering_predicate_is_less_or_equal {
      optional_present(value: IsLessOrEqual)
    } else {
      if id == ^ordering_predicate_is_greater {
        optional_present(value: IsGreater)
      } else {
        if id == ^ordering_predicate_is_greater_or_equal {
          optional_present(value: IsGreaterOrEqual)
        } else {
          optional_absent()
        }
      }
    }
  }
}

fn ordering_predicate_equal(left: v2.std.compilers.target_model.OrderingPredicate, right: v2.std.compilers.target_model.OrderingPredicate) -> Bool {
  ordering_predicate_wire_symbol(predicate: left) == ordering_predicate_wire_symbol(predicate: right)
}

fn equality_predicate_wire_symbol(predicate: v2.std.compilers.target_model.EqualityPredicate) -> v2.std.node.Symbol {
  match predicate {
    IsEqual => ^equality_predicate_is_equal
    IsNotEqual => ^equality_predicate_is_not_equal
  }
}

fn equality_predicate_from_wire_symbol(id: v2.std.node.Symbol) -> v2.std.optional.Optional<v2.std.compilers.target_model.EqualityPredicate> {
  if id == ^equality_predicate_is_equal {
    optional_present(value: IsEqual)
  } else {
    if id == ^equality_predicate_is_not_equal {
      optional_present(value: IsNotEqual)
    } else {
      optional_absent()
    }
  }
}

fn equality_predicate_equal(left: v2.std.compilers.target_model.EqualityPredicate, right: v2.std.compilers.target_model.EqualityPredicate) -> Bool {
  equality_predicate_wire_symbol(predicate: left) == equality_predicate_wire_symbol(predicate: right)
}

fn target_model_canonical_operation_wire_node(operation: v2.std.compilers.target_model.CanonicalOperation) -> v2.std.node.Node {
  match operation {
    AlgebraPrimitive { algebra_field: f } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: discriminant(v: AlgebraPrimitive {}) } },
        children: [
          target_model_named_edge(
            name: ^target_canonical_operation_field_algebra_field,
            target: target_model_type_atom_node(identity: f)
          )
        ],
        occurrence_id: SyntheticOccurrence
      }
    AlgebraInverseCompose { binary_field: b, inverse_field: i } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: discriminant(v: AlgebraInverseCompose {}) } },
        children: [
          target_model_named_edge(
            name: ^target_canonical_operation_field_binary_field,
            target: target_model_type_atom_node(identity: b)
          ),
          target_model_named_edge(
            name: ^target_canonical_operation_field_inverse_field,
            target: target_model_type_atom_node(identity: i)
          )
        ],
        occurrence_id: SyntheticOccurrence
      }
    OrderingComparison { compare_field: c, predicate: p } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: discriminant(v: OrderingComparison {}) } },
        children: [
          target_model_named_edge(
            name: ^target_canonical_operation_field_compare_field,
            target: target_model_type_atom_node(identity: c)
          ),
          target_model_named_edge(
            name: ^target_canonical_operation_field_predicate,
            target: target_model_type_atom_node(identity: ordering_predicate_wire_symbol(predicate: p))
          )
        ],
        occurrence_id: SyntheticOccurrence
      }
    EqualityComparison { eq_field: e, predicate: p } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: discriminant(v: EqualityComparison {}) } },
        children: [
          target_model_named_edge(
            name: ^target_canonical_operation_field_eq_field,
            target: target_model_type_atom_node(identity: e)
          ),
          target_model_named_edge(
            name: ^target_canonical_operation_field_predicate,
            target: target_model_type_atom_node(identity: equality_predicate_wire_symbol(predicate: p))
          )
        ],
        occurrence_id: SyntheticOccurrence
      }
  }
}

fn canonical_operation_equal(
  left: v2.std.compilers.target_model.CanonicalOperation,
  right: v2.std.compilers.target_model.CanonicalOperation
) -> Bool {
  match left {
    AlgebraPrimitive { algebra_field: lf } =>
      match right {
        AlgebraPrimitive { algebra_field: rf } => lf == rf
        AlgebraInverseCompose { binary_field: _, inverse_field: _ } => false
        OrderingComparison { compare_field: _, predicate: _ } => false
        EqualityComparison { eq_field: _, predicate: _ } => false
      }
    AlgebraInverseCompose { binary_field: lb, inverse_field: li } =>
      match right {
        AlgebraPrimitive { algebra_field: _ } => false
        AlgebraInverseCompose { binary_field: rb, inverse_field: ri } =>
          lb == rb && li == ri
        OrderingComparison { compare_field: _, predicate: _ } => false
        EqualityComparison { eq_field: _, predicate: _ } => false
      }
    OrderingComparison { compare_field: lc, predicate: lp } =>
      match right {
        AlgebraPrimitive { algebra_field: _ } => false
        AlgebraInverseCompose { binary_field: _, inverse_field: _ } => false
        OrderingComparison { compare_field: rc, predicate: rp } =>
          lc == rc && ordering_predicate_equal(left: lp, right: rp)
        EqualityComparison { eq_field: _, predicate: _ } => false
      }
    EqualityComparison { eq_field: le, predicate: lp } =>
      match right {
        AlgebraPrimitive { algebra_field: _ } => false
        AlgebraInverseCompose { binary_field: _, inverse_field: _ } => false
        OrderingComparison { compare_field: _, predicate: _ } => false
        EqualityComparison { eq_field: re, predicate: rp } =>
          le == re && equality_predicate_equal(left: lp, right: rp)
      }
  }
}

fn canonical_operation_from_wire_node(wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.CanonicalOperation> {
  match wire.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id == discriminant(v: AlgebraPrimitive {}) {
        match target_model_canonical_operation_atom_field_from_wire(
          wire: wire,
          field_name: ^target_canonical_operation_field_algebra_field
        ) {
          Present { value: algebra_field } =>
            outcome_accepted(AlgebraPrimitive { algebra_field: algebra_field })
          Absent =>
            outcome_rejected(
              target_canonical_operation_wire_malformed_diagnostic(wire: wire)
            )
        }
      } else {
        if id == discriminant(v: AlgebraInverseCompose {}) {
          match target_model_canonical_operation_atom_field_from_wire(
            wire: wire,
            field_name: ^target_canonical_operation_field_binary_field
          ) {
            Present { value: binary_field } =>
              match target_model_canonical_operation_atom_field_from_wire(
                wire: wire,
                field_name: ^target_canonical_operation_field_inverse_field
              ) {
                Present { value: inverse_field } =>
                  outcome_accepted(
                    AlgebraInverseCompose {
                      binary_field: binary_field,
                      inverse_field: inverse_field
                    }
                  )
                Absent =>
                  outcome_rejected(
                    target_canonical_operation_wire_malformed_diagnostic(wire: wire)
                  )
              }
            Absent =>
              outcome_rejected(
                target_canonical_operation_wire_malformed_diagnostic(wire: wire)
              )
          }
        } else {
          if id == discriminant(v: OrderingComparison {}) {
            match target_model_canonical_operation_atom_field_from_wire(
              wire: wire,
              field_name: ^target_canonical_operation_field_compare_field
            ) {
              Present { value: compare_field } =>
                match target_model_canonical_operation_atom_field_from_wire(
                  wire: wire,
                  field_name: ^target_canonical_operation_field_predicate
                ) {
                  Present { value: predicate_id } =>
                    match ordering_predicate_from_wire_symbol(id: predicate_id) {
                      Present { value: predicate } =>
                        outcome_accepted(
                          OrderingComparison {
                            compare_field: compare_field,
                            predicate: predicate
                          }
                        )
                      Absent =>
                        outcome_rejected(
                          target_canonical_operation_wire_malformed_diagnostic(wire: wire)
                        )
                    }
                  Absent =>
                    outcome_rejected(
                      target_canonical_operation_wire_malformed_diagnostic(wire: wire)
                    )
                }
              Absent =>
                outcome_rejected(
                  target_canonical_operation_wire_malformed_diagnostic(wire: wire)
                )
            }
          } else {
            if id == discriminant(v: EqualityComparison {}) {
              match target_model_canonical_operation_atom_field_from_wire(
                wire: wire,
                field_name: ^target_canonical_operation_field_eq_field
              ) {
                Present { value: eq_field } =>
                  match target_model_canonical_operation_atom_field_from_wire(
                    wire: wire,
                    field_name: ^target_canonical_operation_field_predicate
                  ) {
                    Present { value: predicate_id } =>
                      match equality_predicate_from_wire_symbol(id: predicate_id) {
                        Present { value: predicate } =>
                          outcome_accepted(
                            EqualityComparison {
                              eq_field: eq_field,
                              predicate: predicate
                            }
                          )
                        Absent =>
                          outcome_rejected(
                            target_canonical_operation_wire_malformed_diagnostic(wire: wire)
                          )
                      }
                    Absent =>
                      outcome_rejected(
                        target_canonical_operation_wire_malformed_diagnostic(wire: wire)
                      )
                  }
                Absent =>
                  outcome_rejected(
                    target_canonical_operation_wire_malformed_diagnostic(wire: wire)
                  )
              }
            } else {
              outcome_rejected(
                target_canonical_operation_wire_malformed_diagnostic(wire: wire)
              )
            }
          }
        }
      }
    _ =>
      outcome_rejected(
        target_canonical_operation_wire_malformed_diagnostic(wire: wire)
      )
  }
}

fn canonical_operation_wire_matches_operation(
  wire: v2.std.node.Node,
  operation: v2.std.compilers.target_model.CanonicalOperation
) -> Bool {
  match canonical_operation_from_wire_node(wire: wire) {
    Accepted { value: decoded, diagnostics: _ } =>
      canonical_operation_equal(left: decoded, right: operation)
    Rejected { diagnostics: _ } => false
  }
}

fn target_model_operator_shape_wire_node(shape: v2.std.compilers.target_model.TargetOperatorShape) -> v2.std.node.Node {
  match shape {
    InfixToken { token: t } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: discriminant(v: InfixToken {}) } },
        children: [
          target_model_named_edge(
            name: ^target_operator_shape_field_token,
            target: target_model_type_atom_node(identity: t)
          )
        ],
        occurrence_id: SyntheticOccurrence
      }
    PrefixToken { token: t } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: discriminant(v: PrefixToken {}) } },
        children: [
          target_model_named_edge(
            name: ^target_operator_shape_field_token,
            target: target_model_type_atom_node(identity: t)
          )
        ],
        occurrence_id: SyntheticOccurrence
      }
    CallIdent { ident: i } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: discriminant(v: CallIdent {}) } },
        children: [
          target_model_named_edge(
            name: ^target_operator_shape_field_token,
            target: target_model_type_atom_node(identity: i)
          )
        ],
        occurrence_id: SyntheticOccurrence
      }
    MethodIdent { ident: i } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: discriminant(v: MethodIdent {}) } },
        children: [
          target_model_named_edge(
            name: ^target_operator_shape_field_token,
            target: target_model_type_atom_node(identity: i)
          )
        ],
        occurrence_id: SyntheticOccurrence
      }
  }
}

fn target_operator_shape_wire_malformed_diagnostic(wire: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_operator_shape_wire_malformed,
    at: node_locus(node: wire),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_operator_shape_wire_schema_valid(wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<Bool> {
  match wire.kind {
    TypeNode { connective: Atom { identity: _ } } =>
      if name_occurrences(
        name: ^target_operator_shape_field_token,
        children: wire.children
      ) != 1 {
        outcome_rejected(target_operator_shape_wire_malformed_diagnostic(wire: wire))
      } else {
        match fold(
          wire.children,
          init: true,
          f: fn(acc, edge) {
            if acc {
              match edge.label {
                Named { name: n } => n == ^target_operator_shape_field_token
                Positional => false
              }
            } else {
              false
            }
          }
        ) {
          true => outcome_accepted(true)
          false =>
            outcome_rejected(target_operator_shape_wire_malformed_diagnostic(wire: wire))
        }
      }
    _ =>
      outcome_rejected(target_operator_shape_wire_malformed_diagnostic(wire: wire))
  }
}

fn target_operator_shape_token_from_wire(wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Symbol> {
  match fold(
    wire.children,
    init: optional_absent(),
    f: fn(acc, edge) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match edge.label {
            Named { name: n } =>
              if n == ^target_operator_shape_field_token {
                match edge.target.kind {
                  TypeNode { connective: Atom { identity: token } } =>
                    optional_present(value: token)
                  _ => acc
                }
              } else {
                acc
              }
            Positional => acc
          }
      }
    }
  ) {
    Present { value: token } => outcome_accepted(token)
    Absent =>
      outcome_rejected(target_operator_shape_wire_malformed_diagnostic(wire: wire))
  }
}

fn target_operator_shape_from_wire_node(wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetOperatorShape> {
  bind_outcome(
    o: target_operator_shape_wire_schema_valid(wire: wire),
    f: fn(_) {
      match wire.kind {
        TypeNode { connective: Atom { identity: id } } =>
          bind_outcome(
            o: target_operator_shape_token_from_wire(wire: wire),
            f: fn(token) {
              if id == discriminant(v: InfixToken {}) {
                outcome_accepted(InfixToken { token: token })
              } else if id == discriminant(v: PrefixToken {}) {
                outcome_accepted(PrefixToken { token: token })
              } else if id == discriminant(v: CallIdent {}) {
                outcome_accepted(CallIdent { ident: token })
              } else if id == discriminant(v: MethodIdent {}) {
                outcome_accepted(MethodIdent { ident: token })
              } else {
                outcome_rejected(
                  target_operator_shape_wire_malformed_diagnostic(wire: wire)
                )
              }
            }
          )
        _ =>
          outcome_rejected(target_operator_shape_wire_malformed_diagnostic(wire: wire))
      }
    }
  )
}

fn target_operator_realization_wire_malformed_diagnostic(row: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_operator_realization_wire_malformed,
    at: node_locus(node: row),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_operator_realization_row_wire_schema_valid(row: v2.std.node.Node) -> v2.std.diagnostic.Outcome<Bool> {
  match row.kind {
    TypeNode { connective: Conj } =>
      if name_occurrences(
        name: ^target_operator_realization_field_operation,
        children: row.children
      ) != 1 {
        outcome_rejected(target_operator_realization_wire_malformed_diagnostic(row: row))
      } else if name_occurrences(
        name: ^target_operator_realization_field_shape,
        children: row.children
      ) != 1 {
        outcome_rejected(target_operator_realization_wire_malformed_diagnostic(row: row))
      } else {
        match fold(
          row.children,
          init: true,
          f: fn(acc, edge) {
            if acc {
              match edge.label {
                Named { name: n } =>
                  n == ^target_operator_realization_field_operation
                  || n == ^target_operator_realization_field_shape
                Positional => false
              }
            } else {
              false
            }
          }
        ) {
          true => outcome_accepted(true)
          false =>
            outcome_rejected(target_operator_realization_wire_malformed_diagnostic(row: row))
        }
      }
    _ =>
      outcome_rejected(target_operator_realization_wire_malformed_diagnostic(row: row))
  }
}

fn target_operator_realization_from_wire_row(row: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetOperatorRealization> {
  bind_outcome(
    o: target_operator_realization_row_wire_schema_valid(row: row),
    f: fn(_) {
      bind_outcome(
        o: find_named_child(root: row, name: ^target_operator_realization_field_operation),
        f: fn(operation_wire) {
          bind_outcome(
            o: canonical_operation_from_wire_node(wire: operation_wire),
            f: fn(canonical_op) {
              bind_outcome(
                o: find_named_child(root: row, name: ^target_operator_realization_field_shape),
                f: fn(shape_wire) {
                  bind_outcome(
                    o: target_operator_shape_from_wire_node(wire: shape_wire),
                    f: fn(shape) {
                      outcome_accepted(
                        TargetOperatorRealization {
                          operation: canonical_op,
                          shape: shape
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn target_operator_realization_node(
  operation: v2.std.compilers.target_model.CanonicalOperation,
  shape: v2.std.compilers.target_model.TargetOperatorShape
) -> v2.std.node.Node {
  target_model_type_conj_node(
    children: [
      target_model_named_edge(
        name: ^target_operator_realization_field_operation,
        target: target_model_canonical_operation_wire_node(operation: operation)
      ),
      target_model_named_edge(
        name: ^target_operator_realization_field_shape,
        target: target_model_operator_shape_wire_node(shape: shape)
      )
    ]
  )
}

fn target_operator_realizations_catalog_node(rows: v2.std.collection.List<v2.std.node.Node>) -> v2.std.node.Node {
  target_model_type_conj_node(
    children: fold_list(
      xs: rows,
      empty: std.algebra.Empty,
      cons: fn(acc, row) {
        std.algebra.Cons {
          head: target_model_named_edge(
            name: ^target_operator_realization_row_edge,
            target: row
          ),
          tail: acc
        }
      }
    )
  )
}

fn target_value_projection_field_missing_diagnostic(bundle: v2.std.node.Node, field: v2.std.node.Symbol) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^target_value_projection_field_missing,
    at: node_locus(node: bundle),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn projection_bundle_child(bundle: v2.std.node.Node, name: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  find_named_child(root: bundle, name: name)
}

fn projection_bundle_symbol_field(bundle: v2.std.node.Node, field: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<v2.std.node.Symbol> {
  bind_outcome(
    o: find_named_child(root: bundle, name: field),
    f: fn(child) {
      match child.kind {
        TypeNode { connective: Atom { identity: id } } => outcome_accepted(id)
        _ =>
          outcome_rejected(
            target_value_projection_bundle_malformed_diagnostic(bundle: bundle)
          )
      }
    }
  )
}

fn decode_binding_ref_shape_bundle(bundle: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetBindingRefShape> {
  bind_outcome(
    o: projection_bundle_symbol_field(
      bundle: bundle,
      field: ^target_value_expr_field_ident_token
    ),
    f: fn(ident_token) {
      outcome_accepted(
        TargetBindingRefShape { ident_token: ident_token }
      )
    }
  )
}

fn decode_primitive_apply_shape_bundle(bundle: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetPrimitiveApplyShape> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: bundle, field: ^target_value_expr_field_open),
    f: fn(open) {
      bind_outcome(
        o: projection_bundle_symbol_field(bundle: bundle, field: ^target_value_expr_field_close),
        f: fn(close) {
          bind_outcome(
            o: projection_bundle_symbol_field(
              bundle: bundle,
              field: ^target_value_expr_field_separator
            ),
            f: fn(separator) {
              outcome_accepted(
                TargetPrimitiveApplyShape {
                  open: open,
                  close: close,
                  separator: separator
                }
              )
            }
          )
        }
      )
    }
  )
}

// The encode side of the two decoders below. A closing target writes its token(s)
// beside the discriminant; a self-delimiting one writes only the discriminant, so
// there is no field for a fictional token even in the wire form.
fn conditional_delimiting_edges(delimiting: v2.std.compilers.target_model.ConditionalDelimiting) -> v2.std.collection.List<v2.std.node.Edge> {
  match delimiting {
    ConditionalSelfDelimiting =>
      [
        target_model_named_edge(
          name: ^target_value_expr_field_conditional_delimiting,
          target: target_model_type_atom_node(identity: ^conditional_self_delimiting)
        )
      ]
    ConditionalClosedByToken { close_token: close_token } =>
      [
        target_model_named_edge(
          name: ^target_value_expr_field_conditional_delimiting,
          target: target_model_type_atom_node(identity: ^conditional_closed_by_token)
        ),
        target_model_named_edge(
          name: ^target_value_expr_field_conditional_close_token,
          target: target_model_type_atom_node(identity: close_token)
        )
      ]
  }
}


// An unrecognised discriminant REFUSES. It does not fall back to self-delimiting,
// because the two states differ exactly where it matters: a target that closes and
// was decoded as self-delimiting emits a construct one token short and the defect
// surfaces as unbalanced output far from here.
fn decode_conditional_delimiting(bundle: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.ConditionalDelimiting> {
  bind_outcome(
    o: projection_bundle_symbol_field(
      bundle: bundle,
      field: ^target_value_expr_field_conditional_delimiting
    ),
    f: fn(discriminant) {
      if discriminant == ^conditional_self_delimiting {
        outcome_accepted(ConditionalSelfDelimiting)
      } else if discriminant == ^conditional_closed_by_token {
        bind_outcome(
          o: projection_bundle_symbol_field(
            bundle: bundle,
            field: ^target_value_expr_field_conditional_close_token
          ),
          f: fn(close_token) {
            outcome_accepted(ConditionalClosedByToken { close_token: close_token })
          }
        )
      } else {
        outcome_rejected(
          target_value_projection_bundle_malformed_diagnostic(bundle: bundle)
        )
      }
    }
  )
}


fn decode_conditional_shape_bundle(bundle: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetConditionalShape> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: bundle, field: ^target_value_expr_field_if_token),
    f: fn(if_token) {
      bind_outcome(
        o: projection_bundle_symbol_field(
          bundle: bundle,
          field: ^target_value_expr_field_then_token
        ),
        f: fn(then_token) {
          bind_outcome(
            o: projection_bundle_symbol_field(
              bundle: bundle,
              field: ^target_value_expr_field_else_token
            ),
            f: fn(else_token) {
              bind_outcome(
                o: decode_conditional_delimiting(bundle: bundle),
                f: fn(delimiting) {
                  outcome_accepted(
                    TargetConditionalShape {
                      if_token: if_token,
                      then_token: then_token,
                      else_token: else_token,
                      delimiting: delimiting
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn decode_bind_let_shape_bundle(bundle: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetBindLetShape> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: bundle, field: ^target_value_expr_field_let_token),
    f: fn(let_token) {
      bind_outcome(
        o: projection_bundle_symbol_field(
          bundle: bundle,
          field: ^target_value_expr_field_assign_token
        ),
        f: fn(assign_token) {
          bind_outcome(
            o: projection_bundle_symbol_field(bundle: bundle, field: ^target_value_expr_field_in_token),
            f: fn(in_token) {
              outcome_accepted(
                TargetBindLetShape {
                  let_token: let_token,
                  assign_token: assign_token,
                  in_token: in_token
                }
              )
            }
          )
        }
      )
    }
  )
}

fn decode_loop_shape_bundle(bundle: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetLoopShape> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: bundle, field: ^target_value_expr_field_loop_token),
    f: fn(loop_token) {
      outcome_accepted(
        TargetLoopShape {
          loop_token: loop_token
        }
      )
    }
