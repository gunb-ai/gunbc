module v2.std.compilers.semantic_decl_emission



type TargetSemanticDeclDecorationLine {
  surface_binding: v2.std.node.Symbol
}

type TargetSemanticDeclCoproductDecorationRule {
  shape_key: v2.std.node.Symbol
  decoration_lines: List<TargetSemanticDeclDecorationLine>
}

type TargetSemanticDeclCoproductSurfaceLayout
  = TargetSemanticDeclCoproductEnumSurface
  | TargetSemanticDeclCoproductTaggedUnionSurface {
      tag_field: v2.std.node.Symbol
      union_field: v2.std.node.Symbol
    }

type TargetSemanticDeclSurfaceProjection {
  record_decoration_lines: List<TargetSemanticDeclDecorationLine>
  coproduct_decoration_rules: List<TargetSemanticDeclCoproductDecorationRule>
  field_type_before_name: Bool
  type_expr_field_scope: Bool
  struct_typedef_name_after_fields: Bool
  enum_name_after_variants: Bool
  field_type_permit_only_int: Bool
  coproduct_layout: TargetSemanticDeclCoproductSurfaceLayout
}

type TargetSemanticDeclSerializeProfile {
  lex_rule_rows: List<v2.std.node.Node>
  binding_spelling_rows: List<v2.std.node.Node>
}

// Bundle row nodes are the single authority; lex and binding_spellings are derived at point of use via semantic_decl_profile_lex_rules / semantic_decl_profile_binding_spellings.
type SemanticDeclBindingSpellingRow {
  binding: v2.std.node.Symbol
  spelling: String
}

type TargetSemanticDeclEmission {
  identity: v2.std.node.Symbol
  enum_translation_rules: v2.std.node.Node
  struct_translation_rules: v2.std.node.Node
  enum_serialize_profile: TargetSemanticDeclSerializeProfile
  struct_serialize_profile: TargetSemanticDeclSerializeProfile
  surface: TargetSemanticDeclSurfaceProjection
}

fn semantic_decl_emission_bundle_malformed_diagnostic(bundle: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^semantic_decl_emission_bundle_malformed,
    at: v2.std.diagnostic.node_locus(node: bundle),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn semantic_decl_string_to_bundle_node(s: String) -> v2.std.node.Node {
  v2.std.algebra.fold_list(
    xs: s,
    empty: v2.std.compilers.target_model.target_model_type_atom_node(identity: ^free_monoid_variant_empty),
    cons: fn(tail, c) {
      v2.std.compilers.target_model.target_model_type_conj_node(
        children: [
          v2.std.compilers.target_model.target_model_named_edge(
            name: ^free_monoid_field_head,
            target: v2.std.compilers.target_model.target_model_type_atom_node(identity: c)
          ),
          v2.std.compilers.target_model.target_model_named_edge(
            name: ^free_monoid_field_tail,
            target: tail
          )
        ]
      )
    }
  )
}

fn semantic_decl_string_from_bundle_node(bundle: v2.std.node.Node) -> v2.std.diagnostic.Outcome<String> {
  match bundle.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } } =>
      if id == ^free_monoid_variant_empty {
        v2.std.diagnostic.outcome_accepted(value: "")
      } else {
        v2.std.diagnostic.outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: bundle)
        )
      }
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      v2.std.diagnostic.bind_outcome(
        o: v2.std.node_query.find_named_child(root: bundle, name: ^free_monoid_field_head),
        f: fn(head) {
          v2.std.diagnostic.bind_outcome(
            o: v2.std.node_query.find_named_child(root: bundle, name: ^free_monoid_field_tail),
            f: fn(tail) {
              match head.kind {
                v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: c } } =>
                  v2.std.diagnostic.bind_outcome(
                    o: semantic_decl_string_from_bundle_node(bundle: tail),
                    f: fn(rest) {
                      v2.std.diagnostic.outcome_accepted(value: concat(rest, from_code_point(cp: c)))
                    }
                  )
                _ =>
                  v2.std.diagnostic.outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: bundle)
                  )
              }
            }
          )
        }
      )
    _ =>
      v2.std.diagnostic.outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: bundle)
      )
  }
}

fn semantic_decl_ident_lex_pattern() -> v2.std.compilers.lexing.LexPattern {
  v2.std.compilers.lexing.SequencePattern {
    left: v2.std.compilers.lexing.CharClassPattern { class: v2.std.compilers.lexing.IdentStartChar },
    right: v2.std.compilers.lexing.RepeatPattern { element: v2.std.compilers.lexing.CharClassPattern { class: v2.std.compilers.lexing.IdentContinueChar } }
  }
}

fn semantic_decl_whitespace_trivia_pattern() -> v2.std.compilers.lexing.LexPattern {
  v2.std.compilers.lexing.OneOrMorePattern { element: v2.std.compilers.lexing.CharClassPattern { class: v2.std.compilers.lexing.WhitespaceChar } }
}

fn semantic_decl_lex_literal_row(token_class: v2.std.node.Symbol, text: String) -> v2.std.node.Node {
  v2.std.compilers.target_model.target_model_type_conj_node(
    children: [
      v2.std.compilers.target_model.target_model_named_edge(
        name: ^semantic_decl_lex_row_field_pattern_kind,
        target: v2.std.compilers.target_model.target_model_type_atom_node(identity: ^semantic_decl_lex_pattern_literal)
      ),
      v2.std.compilers.target_model.target_model_named_edge(
        name: ^semantic_decl_lex_row_field_token_class,
        target: v2.std.compilers.target_model.target_model_type_atom_node(identity: token_class)
      ),
      v2.std.compilers.target_model.target_model_named_edge(
        name: ^semantic_decl_lex_row_field_text,
        target: semantic_decl_string_to_bundle_node(s: text)
      )
    ]
  )
}

fn semantic_decl_lex_ident_row(token_class: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.compilers.target_model.target_model_type_conj_node(
    children: [
      v2.std.compilers.target_model.target_model_named_edge(
        name: ^semantic_decl_lex_row_field_pattern_kind,
        target: v2.std.compilers.target_model.target_model_type_atom_node(identity: ^semantic_decl_lex_pattern_ident)
      ),
      v2.std.compilers.target_model.target_model_named_edge(
        name: ^semantic_decl_lex_row_field_token_class,
        target: v2.std.compilers.target_model.target_model_type_atom_node(identity: token_class)
      )
    ]
  )
}

fn semantic_decl_lex_whitespace_trivia_row() -> v2.std.node.Node {
  v2.std.compilers.target_model.target_model_type_conj_node(
    children: [
      v2.std.compilers.target_model.target_model_named_edge(
        name: ^semantic_decl_lex_row_field_pattern_kind,
        target: v2.std.compilers.target_model.target_model_type_atom_node(identity: ^semantic_decl_lex_pattern_whitespace_trivia)
      )
    ]
  )
}

fn semantic_decl_lex_rules_catalog(rows: List<v2.std.node.Node>) -> v2.std.node.Node {
  v2.std.compilers.target_model.target_model_type_conj_node(
    children: v2.std.algebra.fold_list(
      xs: rows,
      empty: std.algebra.Empty,
      cons: fn(acc, row) {
        v2.std.algebra.list_snoc_item(
          xs: acc,
          item: v2.std.node.Edge { label: v2.std.node.Positional, target: row }
        )
      }
    )
  )
}

fn decode_semantic_decl_lex_rule_row(row: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.lexing.LexRule> {
  v2.std.diagnostic.bind_outcome(
    o: v2.std.compilers.target_model.projection_bundle_symbol_field(
      bundle: row,
      field: ^semantic_decl_lex_row_field_pattern_kind
    ),
    f: fn(pattern_kind) {
      if pattern_kind == ^semantic_decl_lex_pattern_literal {
        v2.std.diagnostic.bind_outcome(
          o: v2.std.compilers.target_model.projection_bundle_symbol_field(
            bundle: row,
            field: ^semantic_decl_lex_row_field_token_class
          ),
          f: fn(token_class) {
            v2.std.diagnostic.bind_outcome(
              o: v2.std.node_query.find_named_child(root: row, name: ^semantic_decl_lex_row_field_text),
              f: fn(text_node) {
                v2.std.diagnostic.bind_outcome(
                  o: semantic_decl_string_from_bundle_node(bundle: text_node),
                  f: fn(text) {
                    v2.std.diagnostic.outcome_accepted(
                      value: v2.std.compilers.lexing.TokenRule {
                        token_class: token_class,
                        pattern: v2.std.compilers.lexing.LiteralPattern { text: text }
                      }
                    )
                  }
                )
              }
            )
          }
        )
      } else if pattern_kind == ^semantic_decl_lex_pattern_ident {
        v2.std.diagnostic.bind_outcome(
          o: v2.std.compilers.target_model.projection_bundle_symbol_field(
            bundle: row,
            field: ^semantic_decl_lex_row_field_token_class
          ),
          f: fn(token_class) {
            v2.std.diagnostic.outcome_accepted(
              value: v2.std.compilers.lexing.TokenRule {
                token_class: token_class,
                pattern: semantic_decl_ident_lex_pattern()
              }
            )
          }
        )
      } else if pattern_kind == ^semantic_decl_lex_pattern_whitespace_trivia {
        v2.std.diagnostic.outcome_accepted(
          value: v2.std.compilers.lexing.TriviaRule { pattern: semantic_decl_whitespace_trivia_pattern() }
        )
      } else {
        v2.std.diagnostic.outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: row)
        )
      }
    }
  )
}

fn semantic_decl_lex_rule_rows_from_catalog(catalog: v2.std.node.Node) -> v2.std.diagnostic.Outcome<List<v2.std.node.Node>> {
  match catalog.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      fold(
        catalog.children,
        init: v2.std.diagnostic.outcome_accepted(value: std.algebra.Empty),
        f: fn(acc_o, edge) {
          v2.std.diagnostic.bind_outcome(
            o: acc_o,
            f: fn(acc) {
              match edge.label {
                v2.std.node.Positional =>
                  v2.std.diagnostic.outcome_accepted(value: v2.std.algebra.list_snoc_item(xs: acc, item: edge.target))
                _ =>
                  v2.std.diagnostic.outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: catalog)
                  )
              }
            }
          )
        }
      )
    _ =>
      v2.std.diagnostic.outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: catalog)
      )
  }
}

fn semantic_decl_lex_rules_from_rows(rows: List<v2.std.node.Node>) -> v2.std.diagnostic.Outcome<v2.std.compilers.lexing.LexRules> {
  v2.std.diagnostic.bind_outcome(
    o: v2.std.algebra.fold_list(
      xs: rows,
      empty: v2.std.diagnostic.outcome_accepted(value: std.algebra.Empty),
      cons: fn(acc_o, row) {
        v2.std.diagnostic.bind_outcome(
          o: acc_o,
          f: fn(acc) {
            v2.std.diagnostic.bind_outcome(
              o: decode_semantic_decl_lex_rule_row(row: row),
              f: fn(rule) {
                v2.std.diagnostic.outcome_accepted(value: v2.std.algebra.list_snoc_item(xs: acc, item: rule))
              }
            )
          }
        )
      }
    ),
    f: fn(rules) {
      v2.std.diagnostic.outcome_accepted(
        value: v2.std.compilers.lexing.ModeledLexRules { root: v2.std.compilers.lexing.LexRuleSet { rules: rules } }
      )
    }
  )
}

fn semantic_decl_lex_rules_from_catalog(catalog: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.lexing.LexRules> {
  v2.std.diagnostic.bind_outcome(
    o: semantic_decl_lex_rule_rows_from_catalog(catalog: catalog),
    f: fn(rows) {
      semantic_decl_lex_rules_from_rows(rows: rows)
    }
  )
}

fn semantic_decl_binding_spelling_row(binding: v2.std.node.Symbol, spelling: String) -> v2.std.node.Node {
  v2.std.compilers.target_model.target_model_type_conj_node(
    children: [
      v2.std.compilers.target_model.target_model_named_edge(
        name: ^semantic_decl_spelling_row_field_binding,
        target: v2.std.compilers.target_model.target_model_type_atom_node(identity: binding)
      ),
      v2.std.compilers.target_model.target_model_named_edge(
        name: ^semantic_decl_spelling_row_field_text,
        target: semantic_decl_string_to_bundle_node(s: spelling)
      )
    ]
  )
}

fn semantic_decl_binding_spellings_catalog(rows: List<v2.std.node.Node>) -> v2.std.node.Node {
  v2.std.compilers.target_model.target_model_type_conj_node(
    children: v2.std.algebra.fold_list(
      xs: rows,
      empty: std.algebra.Empty,
      cons: fn(acc, row) {
        v2.std.algebra.list_snoc_item(
          xs: acc,
          item: v2.std.node.Edge { label: v2.std.node.Positional, target: row }
        )
      }
    )
  )
}

fn decode_semantic_decl_binding_spelling_row(row: v2.std.node.Node) -> v2.std.diagnostic.Outcome<SemanticDeclBindingSpellingRow> {
  v2.std.diagnostic.bind_outcome(
    o: v2.std.compilers.target_model.projection_bundle_symbol_field(bundle: row, field: ^semantic_decl_spelling_row_field_binding),
    f: fn(binding) {
      v2.std.diagnostic.bind_outcome(
        o: v2.std.node_query.find_named_child(root: row, name: ^semantic_decl_spelling_row_field_text),
        f: fn(text_node) {
          v2.std.diagnostic.bind_outcome(
            o: semantic_decl_string_from_bundle_node(bundle: text_node),
            f: fn(spelling) {
              v2.std.diagnostic.outcome_accepted(
                value: SemanticDeclBindingSpellingRow {
                  binding: binding,
                  spelling: spelling
                }
              )
            }
          )
        }
      )
    }
  )
}

fn semantic_decl_binding_spelling_rows_from_catalog(catalog: v2.std.node.Node) -> v2.std.diagnostic.Outcome<List<SemanticDeclBindingSpellingRow>> {
  match catalog.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      fold(
        catalog.children,
        init: v2.std.diagnostic.outcome_accepted(value: std.algebra.Empty),
        f: fn(acc_o, edge) {
          v2.std.diagnostic.bind_outcome(
            o: acc_o,
            f: fn(acc) {
              match edge.label {
                v2.std.node.Positional =>
                  v2.std.diagnostic.bind_outcome(
                    o: decode_semantic_decl_binding_spelling_row(row: edge.target),
                    f: fn(row) {
                      v2.std.diagnostic.outcome_accepted(value: v2.std.algebra.list_snoc_item(xs: acc, item: row))
                    }
                  )
                _ =>
                  v2.std.diagnostic.outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: catalog)
                  )
              }
            }
          )
        }
      )
    _ =>
      v2.std.diagnostic.outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: catalog)
      )
  }
}

fn semantic_decl_binding_spellings_from_rows(
  rows: List<SemanticDeclBindingSpellingRow>
) -> Map<v2.std.node.Symbol, String> {
  v2.std.algebra.fold_list(
    xs: rows,
    empty: v2.std.collection.empty_map(),
    cons: fn(acc, row) {
      v2.std.collection.map_insert(m: acc, key: row.binding, value: row.spelling)
    }
  )
}

fn semantic_decl_binding_spelling_not_found_diagnostic(binding: v2.std.node.Symbol) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^semantic_decl_binding_spelling_not_found,
    at: v2.std.diagnostic.port_locus(port: binding),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn semantic_decl_binding_spelling_from_rows(
  rows: List<SemanticDeclBindingSpellingRow>,
  binding: v2.std.node.Symbol
) -> v2.std.diagnostic.Outcome<String> {
  v2.std.algebra.fold_list(
    xs: rows,
    empty: v2.std.diagnostic.outcome_rejected(d: semantic_decl_binding_spelling_not_found_diagnostic(binding: binding)
    ),
    cons: fn(acc, row) {
      if row.binding == binding {
        v2.std.diagnostic.outcome_accepted(value: row.spelling)
      } else {
        acc
      }
    }
  )
}

fn semantic_decl_binding_spelling_rows_from_row_nodes(
  rows: List<v2.std.node.Node>
) -> v2.std.diagnostic.Outcome<List<SemanticDeclBindingSpellingRow>> {
  v2.std.algebra.fold_list(
    xs: rows,
    empty: v2.std.diagnostic.outcome_accepted(value: std.algebra.Empty),
    cons: fn(acc_o, row) {
      v2.std.diagnostic.bind_outcome(
        o: acc_o,
        f: fn(acc) {
          v2.std.diagnostic.bind_outcome(
            o: decode_semantic_decl_binding_spelling_row(row: row),
            f: fn(decoded) {
              v2.std.diagnostic.outcome_accepted(value: v2.std.algebra.list_snoc_item(xs: acc, item: decoded))
            }
          )
        }
      )
    }
  )
}

fn semantic_decl_profile_lex_rules(
  profile: TargetSemanticDeclSerializeProfile
) -> v2.std.diagnostic.Outcome<v2.std.compilers.lexing.LexRules> {
  semantic_decl_lex_rules_from_rows(rows: profile.lex_rule_rows)
}

fn semantic_decl_profile_binding_spellings(
  profile: TargetSemanticDeclSerializeProfile
) -> v2.std.diagnostic.Outcome<Map<v2.std.node.Symbol, String>> {
  v2.std.diagnostic.bind_outcome(
    o: semantic_decl_binding_spelling_rows_from_row_nodes(
      rows: profile.binding_spelling_rows
    ),
    f: fn(rows) {
      v2.std.diagnostic.outcome_accepted(value: semantic_decl_binding_spellings_from_rows(rows: rows))
    }
  )
}

fn semantic_decl_binding_spelling_lookup(
  profile: TargetSemanticDeclSerializeProfile,
  binding: v2.std.node.Symbol
) -> v2.std.diagnostic.Outcome<String> {
  v2.std.diagnostic.bind_outcome(
    o: semantic_decl_profile_binding_spellings(profile: profile),
    f: fn(binding_spellings) {
      v2.std.compilers.target_model.bound_spelling_from_map(binding_spellings: binding_spellings, binding: binding)
    }
  )
}

fn semantic_decl_bound_tokens_source_text(
  profile: TargetSemanticDeclSerializeProfile,
  tokens: List<v2.std.compilers.target_model.ConcreteSyntaxToken>
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetText> {
  v2.std.diagnostic.bind_outcome(
    o: semantic_decl_profile_lex_rules(profile: profile),
    f: fn(lex) {
      v2.std.algebra.fold_list(
        xs: tokens,
        empty: Accepted { value: v2.std.compilers.target_model.target_text_empty, diagnostics: v2.std.diagnostic.None },
        cons: fn(acc, token) {
          match acc {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: partial, diagnostics: ad } =>
              match token {
                v2.std.compilers.target_model.FixedToken { token_class: tc } =>
                  v2.std.diagnostic.bind_outcome(
                    o: v2.std.compilers.target_model.lex_rules_literal_for_class(rules: lex, token_class: tc),
                    f: fn(spelling) {
                      Accepted {
                        value: v2.std.compilers.target_model.target_text_seq(acc: partial, next: v2.std.compilers.target_model.text_atom(lexeme: spelling)),
                        diagnostics: ad
                      }
                    }
                  )
                v2.std.compilers.target_model.BoundToken { token_class: _, binding: b } =>
                  v2.std.diagnostic.bind_outcome(
                    o: semantic_decl_binding_spelling_lookup(profile: profile, binding: b),
                    f: fn(spelling) {
                      Accepted {
                        value: v2.std.compilers.target_model.target_text_seq(acc: partial, next: v2.std.compilers.target_model.text_atom(lexeme: spelling)),
                        diagnostics: ad
                      }
                    }
                  )
              }
          }
        }
      )
    }
  )
}

fn semantic_decl_tokens_to_source_text(
  profile: TargetSemanticDeclSerializeProfile,
  tokens: List<v2.std.compilers.target_model.ConcreteSyntaxToken>
) -> v2.std.diagnostic.Outcome<String> {
  v2.std.diagnostic.bind_outcome(
    o: semantic_decl_bound_tokens_source_text(profile: profile, tokens: tokens),
    f: fn(t) {
      v2.std.diagnostic.outcome_accepted(value: v2.std.compilers.target_model.render_target_text(t: t))
    }
  )
}

fn semantic_decl_serialize_target(
  profile: TargetSemanticDeclSerializeProfile,
  rules: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetModel> {
  v2.std.diagnostic.bind_outcome(
    o: semantic_decl_profile_lex_rules(profile: profile),
    f: fn(lex) {
      v2.std.diagnostic.bind_outcome(
        o: semantic_decl_profile_binding_spellings(profile: profile),
        f: fn(binding_spellings) {
          v2.std.diagnostic.outcome_accepted(
            value: v2.std.compilers.target_model.TargetModel {
              produced_decl_support: v2.std.compilers.target_model.ProducedDeclUnwired,
              bundle: v2.std.compilers.target_model.target_model_type_conj_node(
                children: [
                  v2.std.compilers.target_model.target_model_named_edge(
                    name: ^target_model_edge_translation_rules,
                    target: rules
                  )
                ]
              ),
              lex: lex,
              binding_spellings: binding_spellings,
              token_class_emit_transforms: v2.std.compilers.target_model.target_model_emit_transforms_empty,
              authority_source_text: "",
              runtime_row: v2.std.host_transport.target_emit_host_runtime_row_unconfigured
            }
          )
        }
      )
    }
  )
}

fn semantic_decl_binding_spellings_from_catalog(catalog: v2.std.node.Node) -> v2.std.diagnostic.Outcome<Map<v2.std.node.Symbol, String>> {
  v2.std.diagnostic.bind_outcome(
    o: semantic_decl_binding_spelling_rows_from_catalog(catalog: catalog),
    f: fn(rows) {
      v2.std.diagnostic.outcome_accepted(value: semantic_decl_binding_spellings_from_rows(rows: rows))
    }
  )
}

fn semantic_decl_serialize_profile_bundle(
  lex_rows: List<v2.std.node.Node>,
  spelling_rows: List<v2.std.node.Node>
) -> v2.std.node.Node {
  v2.std.compilers.target_model.target_model_type_conj_node(
    children: [
      v2.std.compilers.target_model.target_model_named_edge(
        name: ^semantic_decl_profile_field_lex_rules,
        target: semantic_decl_lex_rules_catalog(rows: lex_rows)
      ),
      v2.std.compilers.target_model.target_model_named_edge(
        name: ^semantic_decl_profile_field_binding_spellings,
        target: semantic_decl_binding_spellings_catalog(rows: spelling_rows)
      )
    ]
  )
}

fn semantic_decl_emission_bundle(
  identity: v2.std.node.Symbol,
  enum_translation_rules: v2.std.node.Node,
  struct_translation_rules: v2.std.node.Node,
  enum_serialize_profile: v2.std.node.Node,
  struct_serialize_profile: v2.std.node.Node,
  surface: TargetSemanticDeclSurfaceProjection
) -> v2.std.node.Node {
  v2.std.compilers.target_model.target_model_type_conj_node(
    children: [
      v2.std.compilers.target_model.target_model_named_edge(
        name: ^semantic_decl_emission_field_identity,
        target: v2.std.compilers.target_model.target_model_type_atom_node(identity: identity)
      ),
      v2.std.compilers.target_model.target_model_named_edge(
        name: ^semantic_decl_emission_field_enum_translation_rules,
        target: enum_translation_rules
      ),
      v2.std.compilers.target_model.target_model_named_edge(
        name: ^semantic_decl_emission_field_struct_translation_rules,
        target: struct_translation_rules
      ),
      v2.std.compilers.target_model.target_model_named_edge(
        name: ^semantic_decl_emission_field_enum_serialize_profile,
        target: enum_serialize_profile
      ),
      v2.std.compilers.target_model.target_model_named_edge(
        name: ^semantic_decl_emission_field_struct_serialize_profile,
        target: struct_serialize_profile
      ),
      v2.std.compilers.target_model.target_model_named_edge(
        name: ^semantic_decl_emission_field_surface_projection,
        target: semantic_decl_surface_projection_bundle(projection: surface)
      )
    ]
  )
}

fn semantic_decl_decoration_line_row(line: TargetSemanticDeclDecorationLine) -> v2.std.node.Node {
  v2.std.compilers.target_model.target_model_type_conj_node(
    children: [
      v2.std.compilers.target_model.target_model_named_edge(
        name: ^semantic_decl_decoration_line_field_surface_binding,
        target: v2.std.compilers.target_model.target_model_type_atom_node(identity: line.surface_binding)
      )
    ]
  )
}

fn semantic_decl_decoration_lines_catalog_from_lines(
  lines: List<TargetSemanticDeclDecorationLine>
) -> v2.std.node.Node {
  v2.std.compilers.target_model.target_model_type_conj_node(
    children: v2.std.algebra.fold_list(
      xs: lines,
      empty: std.algebra.Empty,
      cons: fn(acc, line) {
        v2.std.algebra.list_snoc_item(
          xs: acc,
          item: v2.std.node.Edge {
            label: v2.std.node.Positional,
            target: semantic_decl_decoration_line_row(line: line)
          }
        )
      }
    )
  )
}

fn decode_semantic_decl_decoration_line_row(row: v2.std.node.Node) -> v2.std.diagnostic.Outcome<TargetSemanticDeclDecorationLine> {
  v2.std.diagnostic.bind_outcome(
    o: v2.std.compilers.target_model.projection_bundle_symbol_field(
      bundle: row,
      field: ^semantic_decl_decoration_line_field_surface_binding
    ),
    f: fn(surface_binding) {
      v2.std.diagnostic.outcome_accepted(
        value: TargetSemanticDeclDecorationLine { surface_binding: surface_binding }
      )
    }
  )
}

fn semantic_decl_decoration_lines_from_catalog(catalog: v2.std.node.Node) -> v2.std.diagnostic.Outcome<List<TargetSemanticDeclDecorationLine>> {
  match catalog.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      fold(
        catalog.children,
        init: v2.std.diagnostic.outcome_accepted(value: std.algebra.Empty),
        f: fn(acc_o, edge) {
          v2.std.diagnostic.bind_outcome(
            o: acc_o,
            f: fn(acc) {
              match edge.label {
                v2.std.node.Positional =>
                  v2.std.diagnostic.bind_outcome(
                    o: decode_semantic_decl_decoration_line_row(row: edge.target),
                    f: fn(line) {
                      v2.std.diagnostic.outcome_accepted(value: v2.std.algebra.list_snoc_item(xs: acc, item: line))
                    }
                  )
                _ =>
                  v2.std.diagnostic.outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: catalog)
                  )
              }
            }
          )
        }
      )
    _ =>
      v2.std.diagnostic.outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: catalog)
      )
  }
}

fn semantic_decl_coproduct_decoration_rule_row(rule: TargetSemanticDeclCoproductDecorationRule) -> v2.std.node.Node {
  v2.std.compilers.target_model.target_model_type_conj_node(
    children: [
      v2.std.compilers.target_model.target_model_named_edge(
        name: ^semantic_decl_coproduct_rule_field_shape_key,
        target: v2.std.compilers.target_model.target_model_type_atom_node(identity: rule.shape_key)
      ),
      v2.std.compilers.target_model.target_model_named_edge(
        name: ^semantic_decl_coproduct_rule_field_decoration_lines,
        target: semantic_decl_decoration_lines_catalog_from_lines(lines: rule.decoration_lines)
      )
    ]
  )
}

fn semantic_decl_coproduct_decoration_rules_catalog(
  rules: List<TargetSemanticDeclCoproductDecorationRule>
) -> v2.std.node.Node {
  v2.std.compilers.target_model.target_model_type_conj_node(
    children: v2.std.algebra.fold_list(
      xs: rules,
      empty: std.algebra.Empty,
      cons: fn(acc, rule) {
        v2.std.algebra.list_snoc_item(
          xs: acc,
          item: v2.std.node.Edge {
            label: v2.std.node.Positional,
            target: semantic_decl_coproduct_decoration_rule_row(rule: rule)
          }
        )
      }
    )
  )
}

fn decode_semantic_decl_coproduct_decoration_rule_row(
  row: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<TargetSemanticDeclCoproductDecorationRule> {
  v2.std.diagnostic.bind_outcome(
    o: v2.std.compilers.target_model.projection_bundle_symbol_field(
      bundle: row,
      field: ^semantic_decl_coproduct_rule_field_shape_key
    ),
    f: fn(shape_key) {
      v2.std.diagnostic.bind_outcome(
        o: v2.std.node_query.find_named_child(
          root: row,
          name: ^semantic_decl_coproduct_rule_field_decoration_lines
        ),
        f: fn(lines_catalog) {
          v2.std.diagnostic.bind_outcome(
            o: semantic_decl_decoration_lines_from_catalog(catalog: lines_catalog),
            f: fn(decoration_lines) {
              v2.std.diagnostic.outcome_accepted(
                value: TargetSemanticDeclCoproductDecorationRule {
                  shape_key: shape_key,
                  decoration_lines: decoration_lines
                }
              )
            }
          )
        }
      )
    }
  )
}

fn semantic_decl_coproduct_decoration_rules_from_catalog(
  catalog: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<List<TargetSemanticDeclCoproductDecorationRule>> {
  match catalog.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      fold(
        catalog.children,
        init: v2.std.diagnostic.outcome_accepted(value: std.algebra.Empty),
        f: fn(acc_o, edge) {
          v2.std.diagnostic.bind_outcome(
            o: acc_o,
            f: fn(acc) {
              match edge.label {
                v2.std.node.Positional =>
                  v2.std.diagnostic.bind_outcome(
                    o: decode_semantic_decl_coproduct_decoration_rule_row(row: edge.target),
                    f: fn(rule) {
                      v2.std.diagnostic.outcome_accepted(value: v2.std.algebra.list_snoc_item(xs: acc, item: rule))
                    }
                  )
                _ =>
                  v2.std.diagnostic.outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: catalog)
                  )
              }
            }
          )
        }
      )
    _ =>
      v2.std.diagnostic.outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: catalog)
      )
  }
}

fn semantic_decl_surface_projection_bundle(
  projection: TargetSemanticDeclSurfaceProjection
) -> v2.std.node.Node {
  v2.std.compilers.target_model.target_model_type_conj_node(
    children: v2.std.algebra.list_append(
      left: [
        v2.std.compilers.target_model.target_model_named_edge(
          name: ^semantic_decl_surface_field_record_decoration_lines,
          target: semantic_decl_decoration_lines_catalog_from_lines(
            lines: projection.record_decoration_lines
          )
        ),
        v2.std.compilers.target_model.target_model_named_edge(
          name: ^semantic_decl_surface_field_coproduct_decoration_rules,
          target: semantic_decl_coproduct_decoration_rules_catalog(
            rules: projection.coproduct_decoration_rules
          )
        ),
        v2.std.compilers.target_model.target_model_named_edge(
          name: ^semantic_decl_surface_field_type_before_name,
          target: semantic_decl_surface_projection_bool_flag_node(
            enabled: projection.field_type_before_name,
            true_id: ^semantic_decl_field_type_before_name_true,
            false_id: ^semantic_decl_field_type_before_name_false
          )
        ),
        v2.std.compilers.target_model.target_model_named_edge(
          name: ^semantic_decl_surface_field_type_expr_field_scope,
          target: semantic_decl_surface_projection_bool_flag_node(
            enabled: projection.type_expr_field_scope,
            true_id: ^semantic_decl_type_expr_field_scope_true,
            false_id: ^semantic_decl_type_expr_field_scope_false
          )
        ),
        v2.std.compilers.target_model.target_model_named_edge(
          name: ^semantic_decl_surface_field_struct_typedef_name_after_fields,
          target: semantic_decl_surface_projection_bool_flag_node(
            enabled: projection.struct_typedef_name_after_fields,
            true_id: ^semantic_decl_struct_typedef_name_after_fields_true,
            false_id: ^semantic_decl_struct_typedef_name_after_fields_false
          )
        ),
        v2.std.compilers.target_model.target_model_named_edge(
          name: ^semantic_decl_surface_field_enum_name_after_variants,
          target: semantic_decl_surface_projection_bool_flag_node(
            enabled: projection.enum_name_after_variants,
            true_id: ^semantic_decl_enum_name_after_variants_true,
            false_id: ^semantic_decl_enum_name_after_variants_false
          )
        ),
        v2.std.compilers.target_model.target_model_named_edge(
          name: ^semantic_decl_surface_field_type_permit_only_int,
          target: semantic_decl_surface_projection_bool_flag_node(
            enabled: projection.field_type_permit_only_int,
            true_id: ^semantic_decl_field_type_permit_only_int_true,
            false_id: ^semantic_decl_field_type_permit_only_int_false
          )
        ),
        v2.std.compilers.target_model.target_model_named_edge(
          name: ^semantic_decl_surface_field_coproduct_layout_kind,
          target: semantic_decl_surface_projection_coproduct_layout_kind_node(
            layout: projection.coproduct_layout
          )
        )
      ],
      right: semantic_decl_surface_projection_coproduct_layout_extra_edges(
        layout: projection.coproduct_layout
      )
    )
  )
}

fn semantic_decl_surface_projection_coproduct_layout_kind_node(
  layout: TargetSemanticDeclCoproductSurfaceLayout
) -> v2.std.node.Node {
  match layout {
    TargetSemanticDeclCoproductEnumSurface =>
      v2.std.compilers.target_model.target_model_type_atom_node(identity: ^semantic_decl_coproduct_layout_enum)
    TargetSemanticDeclCoproductTaggedUnionSurface { tag_field: _, union_field: _ } =>
      v2.std.compilers.target_model.target_model_type_atom_node(identity: ^semantic_decl_coproduct_layout_tagged_union)
  }
}

fn semantic_decl_surface_projection_coproduct_layout_extra_edges(
  layout: TargetSemanticDeclCoproductSurfaceLayout
) -> List<v2.std.node.Edge> {
  match layout {
    TargetSemanticDeclCoproductEnumSurface => std.algebra.Empty
    TargetSemanticDeclCoproductTaggedUnionSurface { tag_field: tag_field, union_field: union_field } =>
      [
        v2.std.compilers.target_model.target_model_named_edge(
          name: ^semantic_decl_surface_field_tagged_union_tag_field,
          target: v2.std.compilers.target_model.target_model_type_atom_node(identity: tag_field)
        ),
        v2.std.compilers.target_model.target_model_named_edge(
          name: ^semantic_decl_surface_field_tagged_union_union_field,
          target: v2.std.compilers.target_model.target_model_type_atom_node(identity: union_field)
        )
      ]
  }
}

fn semantic_decl_surface_projection_bool_flag_node(
  enabled: Bool,
  true_id: v2.std.node.Symbol,
  false_id: v2.std.node.Symbol
) -> v2.std.node.Node {
  v2.std.compilers.target_model.target_model_type_atom_node(identity: if enabled { true_id } else { false_id })
}

fn decode_semantic_decl_surface_projection_bool_flag(
  bundle: v2.std.node.Node,
  field: v2.std.node.Symbol,
  true_id: v2.std.node.Symbol,
  false_id: v2.std.node.Symbol
) -> v2.std.diagnostic.Outcome<Bool> {
  v2.std.diagnostic.bind_outcome(
    o: v2.std.node_query.find_named_child(root: bundle, name: field),
    f: fn(flag) {
      match flag.kind {
        v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } } =>
          if id == true_id {
            v2.std.diagnostic.outcome_accepted(value: true)
          } else if id == false_id {
            v2.std.diagnostic.outcome_accepted(value: false)
          } else {
            v2.std.diagnostic.outcome_rejected(
              d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: bundle)
            )
          }
        _ =>
          v2.std.diagnostic.outcome_rejected(
            d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: bundle)
          )
      }
    }
  )
}

fn decode_semantic_decl_surface_projection_coproduct_layout(
  bundle: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<TargetSemanticDeclCoproductSurfaceLayout> {
  v2.std.diagnostic.bind_outcome(
    o: v2.std.node_query.find_named_child(
      root: bundle,
      name: ^semantic_decl_surface_field_coproduct_layout_kind
    ),
    f: fn(kind_node) {
      match kind_node.kind {
        v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } } =>
          if id == ^semantic_decl_coproduct_layout_enum {
            v2.std.diagnostic.outcome_accepted(value: TargetSemanticDeclCoproductEnumSurface)
          } else if id == ^semantic_decl_coproduct_layout_tagged_union {
            v2.std.diagnostic.bind_outcome(
              o: v2.std.compilers.target_model.projection_bundle_symbol_field(
                bundle: bundle,
                field: ^semantic_decl_surface_field_tagged_union_tag_field
              ),
              f: fn(tag_field) {
                v2.std.diagnostic.bind_outcome(
                  o: v2.std.compilers.target_model.projection_bundle_symbol_field(
                    bundle: bundle,
                    field: ^semantic_decl_surface_field_tagged_union_union_field
                  ),
                  f: fn(union_field) {
                    v2.std.diagnostic.outcome_accepted(
                      value: TargetSemanticDeclCoproductTaggedUnionSurface {
                        tag_field: tag_field,
                        union_field: union_field
                      }
                    )
                  }
                )
              }
            )
          } else {
            v2.std.diagnostic.outcome_rejected(
              d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: bundle)
            )
          }
        _ =>
          v2.std.diagnostic.outcome_rejected(
            d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: bundle)
          )
      }
    }
  )
}

fn decode_semantic_decl_surface_projection_bundle(
  bundle: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<TargetSemanticDeclSurfaceProjection> {
  v2.std.diagnostic.bind_outcome(
    o: v2.std.node_query.find_named_child(
      root: bundle,
      name: ^semantic_decl_surface_field_record_decoration_lines
    ),
    f: fn(record_catalog) {
      v2.std.diagnostic.bind_outcome(
        o: semantic_decl_decoration_lines_from_catalog(catalog: record_catalog),
        f: fn(record_decoration_lines) {
          v2.std.diagnostic.bind_outcome(
            o: v2.std.node_query.find_named_child(
              root: bundle,
              name: ^semantic_decl_surface_field_coproduct_decoration_rules
            ),
            f: fn(rules_catalog) {
              v2.std.diagnostic.bind_outcome(
                o: semantic_decl_coproduct_decoration_rules_from_catalog(catalog: rules_catalog),
                f: fn(coproduct_decoration_rules) {
                  v2.std.diagnostic.bind_outcome(
                    o: decode_semantic_decl_surface_projection_bool_flag(
                      bundle: bundle,
                      field: ^semantic_decl_surface_field_type_before_name,
                      true_id: ^semantic_decl_field_type_before_name_true,
                      false_id: ^semantic_decl_field_type_before_name_false
                    ),
                    f: fn(field_type_before_name) {
                      v2.std.diagnostic.bind_outcome(
                        o: decode_semantic_decl_surface_projection_bool_flag(
                          bundle: bundle,
                          field: ^semantic_decl_surface_field_type_expr_field_scope,
                          true_id: ^semantic_decl_type_expr_field_scope_true,
                          false_id: ^semantic_decl_type_expr_field_scope_false
                        ),
                        f: fn(type_expr_field_scope) {
                          v2.std.diagnostic.bind_outcome(
                            o: decode_semantic_decl_surface_projection_bool_flag(
                              bundle: bundle,
                              field: ^semantic_decl_surface_field_struct_typedef_name_after_fields,
                              true_id: ^semantic_decl_struct_typedef_name_after_fields_true,
                              false_id: ^semantic_decl_struct_typedef_name_after_fields_false
                            ),
                            f: fn(struct_typedef_name_after_fields) {
                              v2.std.diagnostic.bind_outcome(
                                o: decode_semantic_decl_surface_projection_bool_flag(
                                  bundle: bundle,
                                  field: ^semantic_decl_surface_field_enum_name_after_variants,
                                  true_id: ^semantic_decl_enum_name_after_variants_true,
                                  false_id: ^semantic_decl_enum_name_after_variants_false
                                ),
                                f: fn(enum_name_after_variants) {
                                  v2.std.diagnostic.bind_outcome(
                                    o: decode_semantic_decl_surface_projection_bool_flag(
                                      bundle: bundle,
                                      field: ^semantic_decl_surface_field_type_permit_only_int,
                                      true_id: ^semantic_decl_field_type_permit_only_int_true,
                                      false_id: ^semantic_decl_field_type_permit_only_int_false
                                    ),
                                    f: fn(field_type_permit_only_int) {
                                      v2.std.diagnostic.bind_outcome(
                                        o: decode_semantic_decl_surface_projection_coproduct_layout(
                                          bundle: bundle
                                        ),
                                        f: fn(coproduct_layout) {
                                          v2.std.diagnostic.outcome_accepted(
                                            TargetSemanticDeclSurfaceProjection {
                                              record_decoration_lines: record_decoration_lines,
                                              coproduct_decoration_rules: coproduct_decoration_rules,
                                              field_type_before_name: field_type_before_name,
                                              type_expr_field_scope: type_expr_field_scope,
                                              struct_typedef_name_after_fields: struct_typedef_name_after_fields,
                                              enum_name_after_variants: enum_name_after_variants,
                                              field_type_permit_only_int: field_type_permit_only_int,
                                              coproduct_layout: coproduct_layout
                                            }
                                          )
                                        }
                                      )
                                    }
                                  )
                                }
                              )
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn decode_semantic_decl_serialize_profile_bundle(
  bundle: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<TargetSemanticDeclSerializeProfile> {
  v2.std.diagnostic.bind_outcome(
    o: v2.std.node_query.find_named_child(root: bundle, name: ^semantic_decl_profile_field_lex_rules),
    f: fn(lex_catalog) {
      v2.std.diagnostic.bind_outcome(
        o: semantic_decl_lex_rule_rows_from_catalog(catalog: lex_catalog),
        f: fn(lex_rule_rows) {
          v2.std.diagnostic.bind_outcome(
            o: v2.std.node_query.find_named_child(
              root: bundle,
              name: ^semantic_decl_profile_field_binding_spellings
            ),
            f: fn(spellings_catalog) {
              v2.std.diagnostic.bind_outcome(
                o: semantic_decl_lex_rule_rows_from_catalog(catalog: spellings_catalog),
                f: fn(binding_spelling_rows) {
                  v2.std.diagnostic.outcome_accepted(
                    TargetSemanticDeclSerializeProfile {
                      lex_rule_rows: lex_rule_rows,
                      binding_spelling_rows: binding_spelling_rows
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn decode_semantic_decl_emission_bundle(bundle: v2.std.node.Node) -> v2.std.diagnostic.Outcome<TargetSemanticDeclEmission> {
  v2.std.diagnostic.bind_outcome(
    o: v2.std.compilers.target_model.projection_bundle_symbol_field(
      bundle: bundle,
      field: ^semantic_decl_emission_field_identity
    ),
    f: fn(identity) {
      v2.std.diagnostic.bind_outcome(
        o: v2.std.node_query.find_named_child(
          root: bundle,
          name: ^semantic_decl_emission_field_enum_translation_rules
        ),
        f: fn(enum_rules) {
          v2.std.diagnostic.bind_outcome(
            o: v2.std.node_query.find_named_child(
              root: bundle,
              name: ^semantic_decl_emission_field_struct_translation_rules
            ),
            f: fn(struct_rules) {
              v2.std.diagnostic.bind_outcome(
                o: v2.std.node_query.find_named_child(
                  root: bundle,
                  name: ^semantic_decl_emission_field_enum_serialize_profile
                ),
                f: fn(enum_profile_bundle) {
                  v2.std.diagnostic.bind_outcome(
                    o: decode_semantic_decl_serialize_profile_bundle(bundle: enum_profile_bundle),
                    f: fn(enum_profile) {
                      v2.std.diagnostic.bind_outcome(
                        o: v2.std.node_query.find_named_child(
                          root: bundle,
                          name: ^semantic_decl_emission_field_struct_serialize_profile
                        ),
                        f: fn(struct_profile_bundle) {
                          v2.std.diagnostic.bind_outcome(
                            o: decode_semantic_decl_serialize_profile_bundle(
                              bundle: struct_profile_bundle
                            ),
                            f: fn(struct_profile) {
                              v2.std.diagnostic.bind_outcome(
                                o: v2.std.node_query.find_named_child(
                                  root: bundle,
                                  name: ^semantic_decl_emission_field_surface_projection
                                ),
                                f: fn(surface_bundle) {
                                  v2.std.diagnostic.bind_outcome(
                                    o: decode_semantic_decl_surface_projection_bundle(
                                      bundle: surface_bundle
                                    ),
                                    f: fn(surface) {
                                      v2.std.diagnostic.outcome_accepted(
                                        TargetSemanticDeclEmission {
                                          identity: identity,
                                          enum_translation_rules: enum_rules,
                                          struct_translation_rules: struct_rules,
                                          enum_serialize_profile: enum_profile,
                                          struct_serialize_profile: struct_profile,
                                          surface: surface
                                        }
                                      )
                                    }
                                  )
                                }
                              )
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn semantic_decl_emission_from_target(target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<TargetSemanticDeclEmission> {
  v2.std.diagnostic.bind_outcome(
    o: v2.std.compilers.target_model.projection_bundle_child(
      bundle: target.bundle,
      name: ^target_model_edge_semantic_decl_emission
    ),
    f: fn(bundle) {
      decode_semantic_decl_emission_bundle(bundle: bundle)
    }
  )
}

fn target_semantic_decl_surface_pos(target: v2.std.node.Node) -> v2.std.node.Edge {
  v2.std.node.Edge { label: v2.std.node.Positional, target: target }
}

fn target_semantic_decl_surface_conj(children: List<v2.std.node.Edge>) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: children,
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn target_semantic_decl_surface_atom(id: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn target_semantic_decl_surface_nil() -> v2.std.node.Node {
  target_semantic_decl_surface_conj(children: [])
}

fn target_semantic_decl_surface_cell(item: v2.std.node.Node, rest: v2.std.node.Node) -> v2.std.node.Node {
  target_semantic_decl_surface_conj(
    children: [
      target_semantic_decl_surface_pos(target: item),
      target_semantic_decl_surface_pos(target: rest)
    ]
  )
}

fn target_semantic_decl_surface_cons_list(items: List<v2.std.node.Node>) -> v2.std.node.Node {
  v2.std.algebra.fold_list_right(
    xs: items,
    empty: target_semantic_decl_surface_nil(),
    snoc: fn(acc, item) {
      target_semantic_decl_surface_cell(item: item, rest: acc)
    }
  )
}

fn target_semantic_decl_surface_type_expr(t: v2.std.node.Symbol) -> v2.std.node.Node {
  target_semantic_decl_surface_conj(
    children: [
      target_semantic_decl_surface_pos(
        target: target_semantic_decl_surface_conj(
          children: [ target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: t)) ]
        )
      )
    ]
  )
}

fn target_semantic_decl_surface_type_expr_scoped(scope: v2.std.node.Symbol, t: v2.std.node.Symbol) -> v2.std.node.Node {
  target_semantic_decl_surface_conj(
    children: [
      target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: scope)),
      target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: t))
    ]
  )
}

fn target_semantic_decl_surface_type_expr_for_field(
  name: v2.std.node.Symbol,
  t: v2.std.node.Symbol,
  type_expr_field_scope: Bool
) -> v2.std.node.Node {
  if type_expr_field_scope {
    target_semantic_decl_surface_type_expr_scoped(scope: name, t: t)
  } else {
    target_semantic_decl_surface_type_expr(t: t)
  }
}

fn target_semantic_decl_surface_field(
  name: v2.std.node.Symbol,
  t: v2.std.node.Symbol,
  type_before_name: Bool,
  type_expr_field_scope: Bool
) -> v2.std.node.Node {
  let type_node = target_semantic_decl_surface_type_expr_for_field(
    name: name,
    t: t,
    type_expr_field_scope: type_expr_field_scope
  )
  if type_before_name {
    target_semantic_decl_surface_conj(
      children: [
        target_semantic_decl_surface_pos(target: type_node),
        target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: name))
      ]
    )
  } else {
    target_semantic_decl_surface_conj(
      children: [
        target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: name)),
        target_semantic_decl_surface_pos(target: type_node)
      ]
    )
  }
}

fn target_semantic_decl_field_surface_from_edge(
  edge: v2.std.node.Edge,
  projection: TargetSemanticDeclSurfaceProjection
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match edge.label {
    v2.std.node.Named { name: fname } =>
      match edge.target.kind {
        v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: tid } } =>
          if projection.field_type_permit_only_int && tid != ^Int {
            v2.std.diagnostic.outcome_rejected(d: v2.std.diagnostic.Diagnostic {
                  reason: ^target_semantic_decl_field_type_primitive_unsupported,
                  at: v2.std.diagnostic.node_locus(node: edge.target),
                  correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
                })
          } else {
            v2.std.diagnostic.outcome_accepted(
              value: target_semantic_decl_surface_field(
                name: fname,
                t: tid,
                type_before_name: projection.field_type_before_name,
                type_expr_field_scope: projection.type_expr_field_scope
              )
            )
          }
        _ =>
          v2.std.diagnostic.outcome_rejected(d: v2.std.diagnostic.Diagnostic {
                reason: ^target_semantic_decl_field_type_not_atom,
                at: v2.std.diagnostic.node_locus(node: edge.target),
                correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
              })
      }
    v2.std.node.Positional =>
      v2.std.diagnostic.outcome_rejected(d: v2.std.diagnostic.Diagnostic {
            reason: ^target_semantic_decl_field_not_named,
            at: v2.std.diagnostic.node_locus(node: edge.target),
            correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
          })
  }
}

fn target_semantic_decl_surface_field_block(fields: List<v2.std.node.Node>) -> v2.std.node.Node {
  target_semantic_decl_surface_conj(
    children: [
      target_semantic_decl_surface_pos(
        target: target_semantic_decl_surface_cons_list(items: fields)
      )
    ]
  )
}

fn target_semantic_decl_surface_decoration_line(binding: v2.std.node.Symbol) -> v2.std.node.Node {
  target_semantic_decl_surface_conj(
    children: [ target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: binding)) ]
  )
}

fn target_semantic_decl_surface_decoration_pos_edges(
  lines: List<TargetSemanticDeclDecorationLine>
) -> List<v2.std.node.Edge> {
  v2.std.algebra.fold_list(
    xs: lines,
    empty: std.algebra.Empty,
    cons: fn(acc, line) {
      v2.std.algebra.list_snoc_item(
        xs: acc,
        item: target_semantic_decl_surface_pos(
          target: target_semantic_decl_surface_decoration_line(binding: line.surface_binding)
        )
      )
    }
  )
}

fn target_semantic_decl_surface_struct_name_field_edges(
  name: v2.std.node.Symbol,
  fields: List<v2.std.node.Node>,
  struct_typedef_name_after_fields: Bool
) -> List<v2.std.node.Edge> {
  if struct_typedef_name_after_fields {
    [
      target_semantic_decl_surface_pos(target: target_semantic_decl_surface_field_block(fields: fields)),
      target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: name))
    ]
  } else {
    [
      target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: name)),
      target_semantic_decl_surface_pos(target: target_semantic_decl_surface_field_block(fields: fields))
    ]
  }
}

fn target_semantic_decl_surface_struct_nongeneric(
  name: v2.std.node.Symbol,
  decoration_lines: List<TargetSemanticDeclDecorationLine>,
  fields: List<v2.std.node.Node>,
  struct_typedef_name_after_fields: Bool
) -> v2.std.node.Node {
  target_semantic_decl_surface_conj(
    children: v2.std.algebra.list_append(
      left: target_semantic_decl_surface_decoration_pos_edges(lines: decoration_lines),
      right: target_semantic_decl_surface_struct_name_field_edges(
        name: name,
        fields: fields,
        struct_typedef_name_after_fields: struct_typedef_name_after_fields
      )
    )
  )
}

fn target_semantic_decl_surface_struct_generic(
  name: v2.std.node.Symbol,
  decoration_lines: List<TargetSemanticDeclDecorationLine>,
  params: List<v2.std.node.Symbol>,
  fields: List<v2.std.node.Node>
) -> v2.std.node.Node {
  target_semantic_decl_surface_conj(
    children: v2.std.algebra.list_append(
      left: target_semantic_decl_surface_decoration_pos_edges(lines: decoration_lines),
      right: [
        target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: name)),
        target_semantic_decl_surface_pos(
          target: target_semantic_decl_surface_generic_params(params: params)
        ),
        target_semantic_decl_surface_pos(target: target_semantic_decl_surface_field_block(fields: fields))
      ]
    )
  )
}

fn target_semantic_decl_surface_enum_name_variant_edges(
  name: v2.std.node.Symbol,
  variants: List<v2.std.node.Node>,
  enum_name_after_variants: Bool
) -> List<v2.std.node.Edge> {
  if enum_name_after_variants {
    v2.std.algebra.list_append(
      left: [
        target_semantic_decl_surface_pos(
          target: target_semantic_decl_surface_variant_block(variants: variants)
        )
      ],
      right: [
        target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: name))
      ]
    )
  } else {
    v2.std.algebra.list_append(
      left: [
        target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: name))
      ],
      right: [
        target_semantic_decl_surface_pos(
          target: target_semantic_decl_surface_variant_block(variants: variants)
        )
      ]
    )
  }
}

fn target_semantic_decl_surface_enum_nongeneric(
  name: v2.std.node.Symbol,
  decoration_lines: List<TargetSemanticDeclDecorationLine>,
  variants: List<v2.std.node.Node>,
  enum_name_after_variants: Bool
) -> v2.std.node.Node {
  target_semantic_decl_surface_conj(
    children: v2.std.algebra.list_append(
      left: target_semantic_decl_surface_decoration_pos_edges(lines: decoration_lines),
      right: target_semantic_decl_surface_enum_name_variant_edges(
        name: name,
        variants: variants,
        enum_name_after_variants: enum_name_after_variants
      )
    )
  )
}

fn target_semantic_decl_surface_enum_generic(
  name: v2.std.node.Symbol,
  decoration_lines: List<TargetSemanticDeclDecorationLine>,
  params: List<v2.std.node.Symbol>,
  variants: List<v2.std.node.Node>,
  enum_name_after_variants: Bool
) -> v2.std.node.Node {
  if enum_name_after_variants {
    target_semantic_decl_surface_conj(
      children: v2.std.algebra.list_append(
        left: v2.std.algebra.list_append(
          left: target_semantic_decl_surface_decoration_pos_edges(lines: decoration_lines),
          right: [
            target_semantic_decl_surface_pos(
              target: target_semantic_decl_surface_generic_params(params: params)
            )
          ]
        ),
        right: target_semantic_decl_surface_enum_name_variant_edges(
          name: name,
          variants: variants,
          enum_name_after_variants: true
        )
      )
    )
  } else {
    target_semantic_decl_surface_conj(
      children: v2.std.algebra.list_append(
        left: target_semantic_decl_surface_decoration_pos_edges(lines: decoration_lines),
        right: [
          target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: name)),
          target_semantic_decl_surface_pos(
            target: target_semantic_decl_surface_generic_params(params: params)
          ),
          target_semantic_decl_surface_pos(
            target: target_semantic_decl_surface_variant_block(variants: variants)
          )
        ]
      )
    )
  }
}

fn target_semantic_decl_surface_union_member_payload(
  name: v2.std.node.Symbol,
  fields: List<v2.std.node.Node>
) -> v2.std.node.Node {
  target_semantic_decl_surface_conj(
    children: [
      target_semantic_decl_surface_pos(
        target: target_semantic_decl_surface_cons_list(items: fields)
      ),
      target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: name))
    ]
  )
}

fn target_semantic_decl_surface_tagged_union_union_body(
  variants: List<v2.std.node.Node>,
  union_field: v2.std.node.Symbol
) -> v2.std.node.Node {
  target_semantic_decl_surface_conj(
    children: [
      target_semantic_decl_surface_pos(
        target: target_semantic_decl_surface_cons_list(items: variants)
      ),
      target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: union_field))
    ]
  )
}

fn target_semantic_decl_surface_tagged_union_union_field(
  variants: List<v2.std.node.Node>,
  union_field: v2.std.node.Symbol
) -> v2.std.node.Node {
  target_semantic_decl_surface_conj(
    children: [
      target_semantic_decl_surface_pos(
        target: target_semantic_decl_surface_tagged_union_union_body(
          variants: variants,
          union_field: union_field
        )
      )
    ]
  )
}

fn target_semantic_decl_surface_tagged_union_body_fields(
  projection: TargetSemanticDeclSurfaceProjection,
  variants: List<v2.std.node.Node>
) -> List<v2.std.node.Node> {
  match projection.coproduct_layout {
    TargetSemanticDeclCoproductTaggedUnionSurface { tag_field: tag_field, union_field: union_field } =>
      [
        target_semantic_decl_surface_field(
          name: tag_field,
          t: ^Int,
          type_before_name: projection.field_type_before_name,
          type_expr_field_scope: projection.type_expr_field_scope
        ),
        target_semantic_decl_surface_tagged_union_union_field(
          variants: variants,
          union_field: union_field
        )
      ]
    TargetSemanticDeclCoproductEnumSurface => std.algebra.Empty
  }
}

fn target_semantic_decl_surface_tagged_union_nongeneric(
  name: v2.std.node.Symbol,
  decoration_lines: List<TargetSemanticDeclDecorationLine>,
  projection: TargetSemanticDeclSurfaceProjection,
  variants: List<v2.std.node.Node>
) -> v2.std.node.Node {
  target_semantic_decl_surface_conj(
    children: v2.std.algebra.list_append(
      left: target_semantic_decl_surface_decoration_pos_edges(lines: decoration_lines),
      right: target_semantic_decl_surface_struct_name_field_edges(
        name: name,
        fields: target_semantic_decl_surface_tagged_union_body_fields(
          projection: projection,
          variants: variants
        ),
        struct_typedef_name_after_fields: projection.struct_typedef_name_after_fields
      )
    )
  )
}

fn target_semantic_decl_surface_variant_nullary(name: v2.std.node.Symbol) -> v2.std.node.Node {
  target_semantic_decl_surface_conj(
    children: [ target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: name)) ]
  )
}

fn target_semantic_decl_surface_variant_block(variants: List<v2.std.node.Node>) -> v2.std.node.Node {
  target_semantic_decl_surface_conj(
    children: [
      target_semantic_decl_surface_pos(
        target: target_semantic_decl_surface_cons_list(items: variants)
      )
    ]
  )
}

fn target_semantic_decl_surface_variant_payload(name: v2.std.node.Symbol, fields: List<v2.std.node.Node>) -> v2.std.node.Node {
  target_semantic_decl_surface_conj(
    children: [
      target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: name)),
      target_semantic_decl_surface_pos(target: target_semantic_decl_surface_field_block(fields: fields))
    ]
  )
}

fn target_semantic_decl_surface_generic_params(params: List<v2.std.node.Symbol>) -> v2.std.node.Node {
  target_semantic_decl_surface_conj(
    children: [
      target_semantic_decl_surface_pos(
        target: target_semantic_decl_surface_cons_list(
          items: v2.std.algebra.fold_list(
            xs: params,
            empty: std.algebra.Empty,
            cons: fn(acc, p) { v2.std.algebra.list_snoc_item(xs: acc, item: target_semantic_decl_surface_atom(id: p)) }
          )
        )
      )
    ]
  )
}

data target_semantic_decl_shape_predicate_dissolution_note: String = "DISSOLVED 2026-07-24 (silent-badger-23): nullary/payload coproduct variant walk consolidated onto v2.std.compilers.coproduct_variant_shape (single authority)."

data target_semantic_decl_shape_predicate_dissolve_on: std.dissolution.DissolutionCondition = std.dissolution.unbound_dissolution(description: "Remaining dissolve-on: decoration rules key on typed surface facts from the bundle authority, not ad-hoc Conj-child heuristics at call sites.")

fn semantic_decl_coproduct_shape_key_unsupported_connective_diagnostic(
  coproduct: v2.std.node.Node
) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^semantic_decl_coproduct_shape_key_unsupported_connective,
    at: v2.std.diagnostic.node_locus(node: coproduct),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn target_semantic_decl_coproduct_shape_key(coproduct: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Symbol> {
  match coproduct.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Disj } =>
      if v2.std.compilers.coproduct_variant_shape.coproduct_all_variants_nullary(edges: coproduct.children) {
        v2.std.diagnostic.outcome_accepted(value: ^semantic_decl_coproduct_shape_all_variants_nullary)
      } else {
        v2.std.diagnostic.outcome_accepted(value: ^semantic_decl_coproduct_shape_default)
      }
    _ =>
      v2.std.diagnostic.outcome_rejected(
        d: semantic_decl_coproduct_shape_key_unsupported_connective_diagnostic(coproduct: coproduct)
      )
  }
}

fn target_semantic_decl_coproduct_rule_decoration_lines_if_shape(
  rule: TargetSemanticDeclCoproductDecorationRule,
  wanted_shape: v2.std.node.Symbol,
  acc: List<TargetSemanticDeclDecorationLine>
) -> List<TargetSemanticDeclDecorationLine> {
  if v2.std.algebra.is_empty(xs: acc) && rule.shape_key == wanted_shape {
    rule.decoration_lines
  } else {
    acc
  }
}

fn target_semantic_decl_decoration_lines_for_shape(
  rules: List<TargetSemanticDeclCoproductDecorationRule>,
  shape_key: v2.std.node.Symbol
) -> List<TargetSemanticDeclDecorationLine> {
  v2.std.algebra.fold_list(
    xs: rules,
    empty: std.algebra.Empty,
    cons: fn(acc, rule) {
      target_semantic_decl_coproduct_rule_decoration_lines_if_shape(
        rule: rule,
        wanted_shape: shape_key,
        acc: acc
      )
    }
  )
}

fn semantic_decl_coproduct_decoration_shape_unmatched_diagnostic(
  coproduct: v2.std.node.Node,
  shape_key: v2.std.node.Symbol
) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^semantic_decl_coproduct_decoration_shape_unmatched,
    at: v2.std.diagnostic.node_locus(node: coproduct),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn target_semantic_decl_coproduct_rule_matches_shape(
  rule: TargetSemanticDeclCoproductDecorationRule,
  shape_key: v2.std.node.Symbol
) -> Bool {
  rule.shape_key == shape_key
}

fn target_semantic_decl_coproduct_has_shape_rule(
  rules: List<TargetSemanticDeclCoproductDecorationRule>,
  shape_key: v2.std.node.Symbol
) -> Bool {
  v2.std.algebra.fold_list(
    xs: rules,
    empty: false,
    cons: fn(acc, rule) {
      if acc {
        true
      } else {
        target_semantic_decl_coproduct_rule_matches_shape(rule: rule, shape_key: shape_key)
      }
    }
  )
}

fn target_semantic_decl_coproduct_decoration_lines(
  projection: TargetSemanticDeclSurfaceProjection,
  coproduct: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<List<TargetSemanticDeclDecorationLine>> {
  if v2.std.algebra.is_empty(xs: projection.coproduct_decoration_rules) {
    v2.std.diagnostic.outcome_accepted(value: std.algebra.Empty)
  } else {
    v2.std.diagnostic.bind_outcome(
      o: target_semantic_decl_coproduct_shape_key(coproduct: coproduct),
      f: fn(shape_key) {
        if target_semantic_decl_coproduct_has_shape_rule(
          rules: projection.coproduct_decoration_rules,
          shape_key: shape_key
        ) {
          v2.std.diagnostic.outcome_accepted(
            value: target_semantic_decl_decoration_lines_for_shape(
              rules: projection.coproduct_decoration_rules,
              shape_key: shape_key
            )
          )
        } else {
          v2.std.diagnostic.outcome_rejected(d: semantic_decl_coproduct_decoration_shape_unmatched_diagnostic(
                coproduct: coproduct,
                shape_key: shape_key)
          )
        }
      }
    )
  }
}
fn target_semantic_decl_field_surfaces(
  edges: List<v2.std.node.Edge>,
  projection: TargetSemanticDeclSurfaceProjection
) -> v2.std.diagnostic.Outcome<List<v2.std.node.Node>> {
  v2.std.algebra.fold_list(
    xs: edges,
    empty: v2.std.diagnostic.outcome_accepted(value: std.algebra.Empty),
    cons: fn(acc_o, edge) {
      v2.std.diagnostic.bind_outcome(
        o: acc_o,
        f: fn(acc) {
          v2.std.diagnostic.bind_outcome(
            o: target_semantic_decl_field_surface_from_edge(
              edge: edge,
              projection: projection
            ),
            f: fn(fnode) {
              v2.std.diagnostic.outcome_accepted(value: v2.std.algebra.list_snoc_item(xs: acc, item: fnode))
            }
          )
        }
      )
    }
  )
}

fn target_semantic_decl_tagged_union_variant_surface_from_edge(
  edge: v2.std.node.Edge,
  projection: TargetSemanticDeclSurfaceProjection
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match edge.label {
    v2.std.node.Named { name: vname } =>
      if v2.std.compilers.coproduct_variant_shape.coproduct_variant_edge_has_payload(edge: edge) {
        v2.std.diagnostic.bind_outcome(
          o: target_semantic_decl_field_surfaces(
            edges: edge.target.children,
            projection: projection
          ),
          f: fn(fields) {
            v2.std.diagnostic.outcome_accepted(
              value: target_semantic_decl_surface_union_member_payload(
                name: vname,
                fields: fields
              )
            )
          }
        )
      } else {
        v2.std.diagnostic.outcome_accepted(value: target_semantic_decl_surface_variant_nullary(name: vname))
      }
    v2.std.node.Positional =>
      v2.std.diagnostic.outcome_rejected(d: v2.std.diagnostic.Diagnostic {
            reason: ^target_semantic_decl_variant_not_named,
            at: v2.std.diagnostic.node_locus(node: edge.target),
            correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
          })
  }
}

fn target_semantic_decl_tagged_union_variant_surfaces(
  edges: List<v2.std.node.Edge>,
  projection: TargetSemanticDeclSurfaceProjection
) -> v2.std.diagnostic.Outcome<List<v2.std.node.Node>> {
  v2.std.algebra.fold_list(
    xs: edges,
    empty: v2.std.diagnostic.outcome_accepted(value: std.algebra.Empty),
    cons: fn(acc_o, edge) {
      v2.std.diagnostic.bind_outcome(
        o: acc_o,
        f: fn(acc) {
          v2.std.diagnostic.bind_outcome(
            o: target_semantic_decl_tagged_union_variant_surface_from_edge(
              edge: edge,
              projection: projection
            ),
            f: fn(vnode) {
              v2.std.diagnostic.outcome_accepted(value: v2.std.algebra.list_snoc_item(xs: acc, item: vnode))
            }
          )
        }
      )
    }
  )
}

fn target_semantic_decl_variant_surface_from_edge(
  edge: v2.std.node.Edge,
  projection: TargetSemanticDeclSurfaceProjection
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match edge.label {
    v2.std.node.Named { name: vname } =>
      if v2.std.compilers.coproduct_variant_shape.coproduct_variant_edge_has_payload(edge: edge) {
        v2.std.diagnostic.bind_outcome(
          o: target_semantic_decl_field_surfaces(
            edges: edge.target.children,
            projection: projection
          ),
          f: fn(fields) {
            v2.std.diagnostic.outcome_accepted(
              value: target_semantic_decl_surface_variant_payload(name: vname, fields: fields)
            )
          }
        )
      } else {
        v2.std.diagnostic.outcome_accepted(value: target_semantic_decl_surface_variant_nullary(name: vname))
      }
    v2.std.node.Positional =>
      v2.std.diagnostic.outcome_rejected(d: v2.std.diagnostic.Diagnostic {
            reason: ^target_semantic_decl_variant_not_named,
            at: v2.std.diagnostic.node_locus(node: edge.target),
            correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
          })
  }
}

fn target_semantic_decl_variant_surfaces(
  edges: List<v2.std.node.Edge>,
  projection: TargetSemanticDeclSurfaceProjection
) -> v2.std.diagnostic.Outcome<List<v2.std.node.Node>> {
  v2.std.algebra.fold_list(
    xs: edges,
    empty: v2.std.diagnostic.outcome_accepted(value: std.algebra.Empty),
    cons: fn(acc_o, edge) {
      v2.std.diagnostic.bind_outcome(
        o: acc_o,
        f: fn(acc) {
          v2.std.diagnostic.bind_outcome(
            o: target_semantic_decl_variant_surface_from_edge(
              edge: edge,
              projection: projection
            ),
            f: fn(vnode) {
              v2.std.diagnostic.outcome_accepted(value: v2.std.algebra.list_snoc_item(xs: acc, item: vnode))
            }
          )
        }
      )
    }
  )
}

fn target_semantic_decl_coproduct_uses_tagged_union_layout(
  layout: TargetSemanticDeclCoproductSurfaceLayout
) -> Bool {
  match layout {
    TargetSemanticDeclCoproductTaggedUnionSurface { tag_field: _, union_field: _ } => true
    TargetSemanticDeclCoproductEnumSurface => false
  }
}

fn target_semantic_decl_variant_surfaces_for_coproduct(
  projection: TargetSemanticDeclSurfaceProjection,
  coproduct: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<List<v2.std.node.Node>> {
  if target_semantic_decl_coproduct_uses_tagged_union_layout(layout: projection.coproduct_layout)
    && !v2.std.compilers.coproduct_variant_shape.coproduct_all_variants_nullary(edges: coproduct.children)
  {
    target_semantic_decl_tagged_union_variant_surfaces(
      edges: coproduct.children,
      projection: projection
    )
  } else {
    target_semantic_decl_variant_surfaces(
      edges: coproduct.children,
      projection: projection
    )
  }
}

fn target_semantic_enum_surface_from_coproduct(
  projection: TargetSemanticDeclSurfaceProjection,
  name: v2.std.node.Symbol,
  params: List<v2.std.node.Symbol>,
  coproduct: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match coproduct.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Disj } =>
      v2.std.diagnostic.bind_outcome(
        o: target_semantic_decl_coproduct_decoration_lines(
          projection: projection,
          coproduct: coproduct
        ),
        f: fn(decoration_lines) {
          v2.std.diagnostic.bind_outcome(
            o: target_semantic_decl_variant_surfaces_for_coproduct(
              projection: projection,
              coproduct: coproduct
            ),
            f: fn(variants) {
              if target_semantic_decl_coproduct_uses_tagged_union_layout(
                    layout: projection.coproduct_layout
                  )
                && !v2.std.compilers.coproduct_variant_shape.coproduct_all_variants_nullary(edges: coproduct.children)
              {
                if v2.std.algebra.is_empty(xs: params) {
                  v2.std.diagnostic.outcome_accepted(
                    value: target_semantic_decl_surface_tagged_union_nongeneric(
                      name: name,
                      decoration_lines: decoration_lines,
                      projection: projection,
                      variants: variants
                    )
                  )
                } else {
                  v2.std.diagnostic.outcome_rejected(d: v2.std.diagnostic.Diagnostic {
                        reason: ^target_semantic_decl_tagged_union_generic_unsupported,
                        at: v2.std.diagnostic.node_locus(node: coproduct),
                        correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
                      })
                }
              } else if v2.std.algebra.is_empty(xs: params) {
                v2.std.diagnostic.outcome_accepted(
                  value: target_semantic_decl_surface_enum_nongeneric(
                    name: name,
                    decoration_lines: decoration_lines,
                    variants: variants,
                    enum_name_after_variants: projection.enum_name_after_variants
                  )
                )
              } else {
                v2.std.diagnostic.outcome_accepted(
                  value: target_semantic_decl_surface_enum_generic(
                    name: name,
                    decoration_lines: decoration_lines,
                    params: params,
                    variants: variants,
                    enum_name_after_variants: projection.enum_name_after_variants
                  )
                )
              }
            }
          )
        }
      )
    _ =>
      v2.std.diagnostic.outcome_rejected(d: v2.std.diagnostic.Diagnostic {
            reason: ^target_semantic_decl_enum_source_not_coproduct,
            at: v2.std.diagnostic.node_locus(node: coproduct),
            correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
          })
  }
}

fn target_semantic_struct_surface_from_record(
  projection: TargetSemanticDeclSurfaceProjection,
  name: v2.std.node.Symbol,
  params: List<v2.std.node.Symbol>,
  record: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match record.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      v2.std.diagnostic.bind_outcome(
        o: target_semantic_decl_field_surfaces(
          edges: record.children,
          projection: projection
        ),
        f: fn(fields) {
          if v2.std.algebra.is_empty(xs: params) {
            v2.std.diagnostic.outcome_accepted(
              value: target_semantic_decl_surface_struct_nongeneric(
                name: name,
                decoration_lines: projection.record_decoration_lines,
                fields: fields,
                struct_typedef_name_after_fields: projection.struct_typedef_name_after_fields
              )
            )
          } else {
            if projection.struct_typedef_name_after_fields {
              v2.std.diagnostic.outcome_rejected(d: v2.std.diagnostic.Diagnostic {
                    reason: ^target_semantic_decl_struct_generic_unsupported,
                    at: v2.std.diagnostic.node_locus(node: record),
                    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
                  })
            } else {
              v2.std.diagnostic.outcome_accepted(
                value: target_semantic_decl_surface_struct_generic(
                  name: name,
                  decoration_lines: projection.record_decoration_lines,
                  params: params,
                  fields: fields
                )
              )
            }
          }
        }
      )
    _ =>
      v2.std.diagnostic.outcome_rejected(d: v2.std.diagnostic.Diagnostic {
            reason: ^target_semantic_decl_struct_source_not_record,
            at: v2.std.diagnostic.node_locus(node: record),
            correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
          })
  }
}
