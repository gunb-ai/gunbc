type TargetSemanticDeclDecorationLine {
  surface_binding: Symbol
}

type TargetSemanticDeclCoproductDecorationRule {
  shape_key: Symbol
  decoration_lines: List<TargetSemanticDeclDecorationLine>
}

type TargetSemanticDeclCoproductSurfaceLayout
  = TargetSemanticDeclCoproductEnumSurface
  | TargetSemanticDeclCoproductTaggedUnionSurface {
      tag_field: Symbol
      union_field: Symbol
    }

type TargetSemanticDeclSurfaceProjection {
  record_decoration_lines: List<TargetSemanticDeclDecorationLine>
  coproduct_decoration_rules: List<TargetSemanticDeclCoproductDecorationRule>
  field_type_before_name: Bool
  type_expr_field_scope: Bool
  struct_typedef_name_after_fields: Bool
  enum_name_after_variants: Bool
  field_type_permit_only_int: Bool
  coproduct_layout: TargetSemanticDeclCoproductSurfaceLayout
  member_projection: TargetSemanticDeclMemberProjection
  import_projection: TargetSemanticDeclImportProjection
  header_projection: TargetSemanticDeclHeaderProjection
}

// WHERE A TARGET PUTS A DECLARATION'S HEADER, the leading comment lines a generated file states its origin with. The
// lines are typed text; the comment prefix is the target's own lex row, so no source annotation channel is involved
// and the declaration's graph, hashes and occurrence ids are unchanged -- only the emitted bytes differ.
type TargetSemanticDeclHeaderProjection
  = HeaderUnwired
  | HeaderLeadingLines

// WHERE A TARGET PUTS A DECLARATION'S IMPORTS, the one authority for import position. `ImportsLeading` places
// them before the declaration in the same emission; a target with no import spelling says so and an import
// refuses, located, rather than being dropped. `path` is the imported name as the target's own grammar prints it.
type TargetSemanticDeclImportProjection
  = ImportsUnwired
  | ImportsLeading

// A constant a declaration carries beside its fields: `name` is the member's identifier and `literal` the
// text of its string value (printed through the target's string-quote transform row). The member's type is
// the type of its literal, spelled by the target's own literal row, so there is no type column to disagree.
type TargetSemanticDeclMember {
  name: Symbol
  literal: Symbol
}

// WHERE A TARGET PUTS A DECLARATION'S MEMBERS, the one authority for member position. Every projection
// states its arm: a target whose declarations cannot carry members says so and a member refuses, located.
type TargetSemanticDeclMemberProjection
  = MembersUnwired
  | MembersInsideTypeBody
  | MembersInAssociatedBlock

type TargetSemanticDeclSerializeProfile {
  lex_rule_rows: List<Node>
  binding_spelling_rows: List<Node>
  emit_transform_rows: List<TargetSemanticDeclEmitTransformRow>
}

// A token class whose lexeme the target transforms on emit: the TokenClassEmitTransform rows a TargetModel
// carries, restricted to the two the declaration route is proven for. Every profile states its rows; a
// target whose declarations print on one line with no quoted text states the empty list.
type TargetSemanticDeclEmitTransformRow {
  token_class: Symbol
  transform: TargetSemanticDeclEmitTransform
}

type TargetSemanticDeclEmitTransform
  = DeclEmitLineBreaks { before: Int, after: Int }
  | DeclEmitStringQuote { open: String, close: String, escapes: List<TargetSemanticDeclEmitEscape> }

type TargetSemanticDeclEmitEscape {
  from: String
  to: String
}

// Bundle row nodes are the single authority; lex and binding_spellings are derived at point of use via semantic_decl_profile_lex_rules / semantic_decl_profile_binding_spellings.
type SemanticDeclBindingSpellingRow {
  binding: Symbol
  spelling: String
}

type TargetSemanticDeclEmission {
  identity: Symbol
  enum_translation_rules: Node
  struct_translation_rules: Node
  enum_serialize_profile: TargetSemanticDeclSerializeProfile
  struct_serialize_profile: TargetSemanticDeclSerializeProfile
  surface: TargetSemanticDeclSurfaceProjection
}

fn semantic_decl_emission_bundle_malformed_diagnostic(bundle: Node) -> Diagnostic {
  Diagnostic {
    reason: ^semantic_decl_emission_bundle_malformed,
    at: node_locus(node: bundle),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

// A char's text is decided by std.unicode.scalar from_code_point; a value it refuses becomes the
// typed marker below, which semantic_decl_string_from_bundle_node refuses as a malformed bundle,
// never a dropped or defaulted character.
fn semantic_decl_char_identity(c: Char) -> Symbol {
  match from_code_point(cp: c) {
    Ok { value: spelled } => spelled
    Err { value: _ } => ^semantic_decl_char_not_unicode_scalar
  }
}

// THE FREE-MONOID ENCODING READS CODE POINTS, SO THE STRING IS VIEWED AS ONE HERE.
//
// The parameter is an ordinary string and its callers are right to pass one -- `semantic_decl_emit`
// hands it a `text` and a `spelling`. What the BODY needs is the char-list view, because it folds
// each element through `std.unicode.scalar` `from_code_point`. `chars` is the conversion between the two, and it is the
// same one `v2.std.compilers.lexing` already uses when it builds a `LiteralPattern`.
//
// WITHOUT IT THE FOLD HAS NO ELEMENT TYPE TO INFER: `String` renders as the target's native string,
// `fold_list` is generic over `FreeMonoid<T>`, and rustc answers E0282 rather than naming the
// missing view. That diagnostic is what sent this to the `String`-fork program on first reading; it
// is a missing conversion at one site.
fn semantic_decl_string_to_bundle_node(s: String) -> Node {
  fold_list(
    xs: chars(text: s),
    empty: target_model_type_atom_node(identity: ^free_monoid_variant_empty),
    cons: fn(tail, c) {
      target_model_type_conj_node(
        children: [
          target_model_named_edge(
            name: ^free_monoid_field_head,
            target: target_model_type_atom_node(identity: semantic_decl_char_identity(c: c))
          ),
          target_model_named_edge(
            name: ^free_monoid_field_tail,
            target: tail
          )
        ]
      )
    }
  )
}

fn semantic_decl_string_from_bundle_node(bundle: Node) -> Outcome<String> {
  match bundle.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id == ^free_monoid_variant_empty {
        outcome_accepted(value: "")
      } else {
        outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: bundle)
        )
      }
    TypeNode { connective: Conj } =>
      bind_outcome(
        o: find_named_child(root: bundle, name: ^free_monoid_field_head),
        f: fn(head) {
          bind_outcome(
            o: find_named_child(root: bundle, name: ^free_monoid_field_tail),
            f: fn(tail) {
              match head.kind {
                TypeNode { connective: Atom { identity: c } } =>
                  if c == ^semantic_decl_char_not_unicode_scalar {
                    semantic_decl_string_from_bundle_node_otherwise(bundle: bundle)
                  } else {
                  bind_outcome(
                    o: semantic_decl_string_from_bundle_node(bundle: tail),
                    f: fn(rest) {
                      outcome_accepted(value: concat(rest, c))
                    }
                  )
                  }
                TypeNode { connective: Conj } => semantic_decl_string_from_bundle_node_otherwise(bundle: bundle)
                TypeNode { connective: Disj } => semantic_decl_string_from_bundle_node_otherwise(bundle: bundle)
                TypeNode { connective: Arrow } => semantic_decl_string_from_bundle_node_otherwise(bundle: bundle)
                TypeNode { connective: Instantiation } => semantic_decl_string_from_bundle_node_otherwise(bundle: bundle)
                ComputationNode { behavior: _ } => semantic_decl_string_from_bundle_node_otherwise(bundle: bundle)
              }
            }
          )
        }
      )
    TypeNode { connective: Disj } => semantic_decl_string_from_bundle_node_otherwise(bundle: bundle)
    TypeNode { connective: Arrow } => semantic_decl_string_from_bundle_node_otherwise(bundle: bundle)
    TypeNode { connective: Instantiation } => semantic_decl_string_from_bundle_node_otherwise(bundle: bundle)
    ComputationNode { behavior: _ } => semantic_decl_string_from_bundle_node_otherwise(bundle: bundle)
  }
}

fn semantic_decl_string_from_bundle_node_otherwise(bundle: Node) -> Outcome<String> {
  outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: bundle)
  )
}

fn semantic_decl_ident_lex_pattern() -> LexPattern {
  SequencePattern {
    left: CharClassPattern { class: IdentStartChar },
    right: RepeatPattern { element: CharClassPattern { class: IdentContinueChar } }
  }
}

fn semantic_decl_whitespace_trivia_pattern() -> LexPattern {
  OneOrMorePattern { element: CharClassPattern { class: WhitespaceChar } }
}

fn semantic_decl_lex_literal_row(token_class: Symbol, text: String) -> Node {
  target_model_type_conj_node(
    children: [
      target_model_named_edge(
        name: ^semantic_decl_lex_row_field_pattern_kind,
        target: target_model_type_atom_node(identity: ^semantic_decl_lex_pattern_literal)
      ),
      target_model_named_edge(
        name: ^semantic_decl_lex_row_field_token_class,
        target: target_model_type_atom_node(identity: token_class)
      ),
      target_model_named_edge(
        name: ^semantic_decl_lex_row_field_text,
        target: semantic_decl_string_to_bundle_node(s: text)
      )
    ]
  )
}

fn semantic_decl_lex_ident_row(token_class: Symbol) -> Node {
  target_model_type_conj_node(
    children: [
      target_model_named_edge(
        name: ^semantic_decl_lex_row_field_pattern_kind,
        target: target_model_type_atom_node(identity: ^semantic_decl_lex_pattern_ident)
      ),
      target_model_named_edge(
        name: ^semantic_decl_lex_row_field_token_class,
        target: target_model_type_atom_node(identity: token_class)
      )
    ]
  )
}

fn semantic_decl_lex_whitespace_trivia_row() -> Node {
  target_model_type_conj_node(
    children: [
      target_model_named_edge(
        name: ^semantic_decl_lex_row_field_pattern_kind,
        target: target_model_type_atom_node(identity: ^semantic_decl_lex_pattern_whitespace_trivia)
      )
    ]
  )
}

fn semantic_decl_lex_rules_catalog(rows: List<Node>) -> Node {
  target_model_type_conj_node(
    children: fold_list(
      xs: rows,
      empty: Empty,
      cons: fn(acc, row) {
        list_snoc_item(
          xs: acc,
          item: Edge { label: Positional, target: row }
        )
      }
    )
  )
}

fn decode_semantic_decl_lex_rule_row(row: Node) -> Outcome<LexRule> {
  bind_outcome(
    o: projection_bundle_symbol_field(
      bundle: row,
      field: ^semantic_decl_lex_row_field_pattern_kind
    ),
    f: fn(pattern_kind) {
      if pattern_kind == ^semantic_decl_lex_pattern_literal {
        bind_outcome(
          o: projection_bundle_symbol_field(
            bundle: row,
            field: ^semantic_decl_lex_row_field_token_class
          ),
          f: fn(token_class) {
            bind_outcome(
              o: find_named_child(root: row, name: ^semantic_decl_lex_row_field_text),
              f: fn(text_node) {
                bind_outcome(
                  o: semantic_decl_string_from_bundle_node(bundle: text_node),
                  f: fn(text) {
                    outcome_accepted(
                      value: TokenRule {
                        token_class: token_class,
                        pattern: LiteralPattern { text: chars(text: text) }
                      }
                    )
                  }
                )
              }
            )
          }
        )
      } else if pattern_kind == ^semantic_decl_lex_pattern_ident {
        bind_outcome(
          o: projection_bundle_symbol_field(
            bundle: row,
            field: ^semantic_decl_lex_row_field_token_class
          ),
          f: fn(token_class) {
            outcome_accepted(
              value: TokenRule {
                token_class: token_class,
                pattern: semantic_decl_ident_lex_pattern()
              }
            )
          }
        )
      } else if pattern_kind == ^semantic_decl_lex_pattern_whitespace_trivia {
        outcome_accepted(
          value: TriviaRule { pattern: semantic_decl_whitespace_trivia_pattern() }
        )
      } else {
        outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: row)
        )
      }
    }
  )
}

fn semantic_decl_lex_rule_rows_from_catalog(catalog: Node) -> Outcome<List<Node>> {
  match catalog.kind {
    TypeNode { connective: Conj } =>
      fold(
        catalog.children,
        init: outcome_accepted(value: Empty),
        f: fn(acc_o, edge) {
          bind_outcome(
            o: acc_o,
            f: fn(acc) {
              match edge.label {
                Positional =>
                  outcome_accepted(value: list_snoc_item(xs: acc, item: edge.target))
                Authored { name: _ } =>
                  outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: catalog)
                  )
                StructuralLabel { label: _ } =>
                  outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: catalog)
                  )
              }
            }
          )
        }
      )
    TypeNode { connective: Atom { identity: _ } } => semantic_decl_lex_rule_rows_from_catalog_otherwise(catalog: catalog)
    TypeNode { connective: Disj } => semantic_decl_lex_rule_rows_from_catalog_otherwise(catalog: catalog)
    TypeNode { connective: Arrow } => semantic_decl_lex_rule_rows_from_catalog_otherwise(catalog: catalog)
    TypeNode { connective: Instantiation } => semantic_decl_lex_rule_rows_from_catalog_otherwise(catalog: catalog)
    ComputationNode { behavior: _ } => semantic_decl_lex_rule_rows_from_catalog_otherwise(catalog: catalog)
  }
}

fn semantic_decl_lex_rule_rows_from_catalog_otherwise(catalog: Node) -> Outcome<List<Node>> {
  outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: catalog)
  )
}

fn semantic_decl_lex_rules_from_rows(rows: List<Node>) -> Outcome<LexRules> {
  bind_outcome(
    o: fold_list(
      xs: rows,
      empty: outcome_accepted(value: Empty),
      cons: fn(acc_o, row) {
        bind_outcome(
          o: acc_o,
          f: fn(acc) {
            bind_outcome(
              o: decode_semantic_decl_lex_rule_row(row: row),
              f: fn(rule) {
                outcome_accepted(value: list_snoc_item(xs: acc, item: rule))
              }
            )
          }
        )
      }
    ),
    f: fn(rules) {
      outcome_accepted(
        value: ModeledLexRules { root: LexRuleSet { rules: rules, modes: [] } }
      )
    }
  )
}

fn semantic_decl_lex_rules_from_catalog(catalog: Node) -> Outcome<LexRules> {
  bind_outcome(
    o: semantic_decl_lex_rule_rows_from_catalog(catalog: catalog),
    f: fn(rows) {
      semantic_decl_lex_rules_from_rows(rows: rows)
    }
  )
}

fn semantic_decl_binding_spelling_row(binding: Symbol, spelling: String) -> Node {
  target_model_type_conj_node(
    children: [
      target_model_named_edge(
        name: ^semantic_decl_spelling_row_field_binding,
        target: target_model_type_atom_node(identity: binding)
      ),
      target_model_named_edge(
        name: ^semantic_decl_spelling_row_field_text,
        target: semantic_decl_string_to_bundle_node(s: spelling)
      )
    ]
  )
}

fn semantic_decl_binding_spellings_catalog(rows: List<Node>) -> Node {
  target_model_type_conj_node(
    children: fold_list(
      xs: rows,
      empty: Empty,
      cons: fn(acc, row) {
        list_snoc_item(
          xs: acc,
          item: Edge { label: Positional, target: row }
        )
      }
    )
  )
}

fn decode_semantic_decl_binding_spelling_row(row: Node) -> Outcome<SemanticDeclBindingSpellingRow> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: row, field: ^semantic_decl_spelling_row_field_binding),
    f: fn(binding) {
      bind_outcome(
        o: find_named_child(root: row, name: ^semantic_decl_spelling_row_field_text),
        f: fn(text_node) {
          bind_outcome(
            o: semantic_decl_string_from_bundle_node(bundle: text_node),
            f: fn(spelling) {
              outcome_accepted(
                value: SemanticDeclBindingSpellingRow {
                  binding: binding,
                  spelling: spelling
                }
              )
            }
          )
        }
      )
    }
  )
}

fn semantic_decl_binding_spelling_rows_from_catalog(catalog: Node) -> Outcome<List<SemanticDeclBindingSpellingRow>> {
  match catalog.kind {
    TypeNode { connective: Conj } =>
      fold(
        catalog.children,
        init: outcome_accepted(value: Empty),
        f: fn(acc_o, edge) {
          bind_outcome(
            o: acc_o,
            f: fn(acc) {
              match edge.label {
                Positional =>
                  bind_outcome(
                    o: decode_semantic_decl_binding_spelling_row(row: edge.target),
                    f: fn(row) {
                      outcome_accepted(value: list_snoc_item(xs: acc, item: row))
                    }
                  )
                Authored { name: _ } =>
                  outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: catalog)
                  )
                StructuralLabel { label: _ } =>
                  outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: catalog)
                  )
              }
            }
          )
        }
      )
    TypeNode { connective: Atom { identity: _ } } => semantic_decl_binding_spelling_rows_from_catalog_otherwise(catalog: catalog)
    TypeNode { connective: Disj } => semantic_decl_binding_spelling_rows_from_catalog_otherwise(catalog: catalog)
    TypeNode { connective: Arrow } => semantic_decl_binding_spelling_rows_from_catalog_otherwise(catalog: catalog)
    TypeNode { connective: Instantiation } => semantic_decl_binding_spelling_rows_from_catalog_otherwise(catalog: catalog)
    ComputationNode { behavior: _ } => semantic_decl_binding_spelling_rows_from_catalog_otherwise(catalog: catalog)
  }
}

fn semantic_decl_binding_spelling_rows_from_catalog_otherwise(catalog: Node) -> Outcome<List<SemanticDeclBindingSpellingRow>> {
  outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: catalog)
  )
}

fn semantic_decl_binding_spellings_from_rows(
  rows: List<SemanticDeclBindingSpellingRow>
) -> Map<Symbol, String> {
  semantic_decl_binding_spellings_from_rows_over(rows: rows, base: empty_map())
}

// The profile's rows laid over a base map: the host target's own binding_spellings, so a field type the
// resolver bound to a target spelling (`i32`, `bool`) is spelled by the one map that owns it, and the
// profile adds only its derive bindings.
fn semantic_decl_binding_spellings_from_rows_over(
  rows: List<SemanticDeclBindingSpellingRow>,
  base: Map<Symbol, String>
) -> Map<Symbol, String> {
  fold_list(
    xs: rows,
    empty: base,
    cons: fn(acc, row) {
      map_insert(m: acc, key: row.binding, value: row.spelling)
    }
  )
}

fn semantic_decl_binding_spelling_not_found_diagnostic(binding: Symbol) -> Diagnostic {
  Diagnostic {
    reason: ^semantic_decl_binding_spelling_not_found,
    at: invariant_port_locus(port: binding, invariant: ^semantic_decl_binding_spelling_not_found),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn semantic_decl_binding_spelling_from_rows(
  rows: List<SemanticDeclBindingSpellingRow>,
  binding: Symbol
) -> Outcome<String> {
  fold_list(
    xs: rows,
    empty: outcome_rejected(d: semantic_decl_binding_spelling_not_found_diagnostic(binding: binding)
    ),
    cons: fn(acc, row) {
      if row.binding == binding {
        outcome_accepted(value: row.spelling)
      } else {
        acc
      }
    }
  )
}

fn semantic_decl_binding_spelling_rows_from_row_nodes(
  rows: List<Node>
) -> Outcome<List<SemanticDeclBindingSpellingRow>> {
  fold_list(
    xs: rows,
    empty: outcome_accepted(value: Empty),
    cons: fn(acc_o, row) {
      bind_outcome(
        o: acc_o,
        f: fn(acc) {
          bind_outcome(
            o: decode_semantic_decl_binding_spelling_row(row: row),
            f: fn(decoded) {
              outcome_accepted(value: list_snoc_item(xs: acc, item: decoded))
            }
          )
        }
      )
    }
  )
}

fn semantic_decl_profile_lex_rules(
  profile: TargetSemanticDeclSerializeProfile
) -> Outcome<LexRules> {
  semantic_decl_lex_rules_from_rows(rows: profile.lex_rule_rows)
}

fn semantic_decl_profile_binding_spellings(
  profile: TargetSemanticDeclSerializeProfile
) -> Outcome<Map<Symbol, String>> {
  semantic_decl_profile_binding_spellings_over(profile: profile, base: empty_map())
}

// The spellings a declaration is SERIALIZED with: the profile's rows over the host target's own map. The
// serializer (semantic_decl_serialize_target) and the type resolver that admits a field type
// (v2.compiler.emit_semantic_decl emit_semantic_type_decl) both read this one map, so a type is admitted
// exactly when the serialization that follows can spell it.
fn semantic_decl_profile_binding_spellings_over(
  profile: TargetSemanticDeclSerializeProfile,
  base: Map<Symbol, String>
) -> Outcome<Map<Symbol, String>> {
  bind_outcome(
    o: semantic_decl_binding_spelling_rows_from_row_nodes(
      rows: profile.binding_spelling_rows
    ),
    f: fn(rows) {
      outcome_accepted(value: semantic_decl_binding_spellings_from_rows_over(rows: rows, base: base))
    }
  )
}

fn semantic_decl_binding_spelling_lookup(
  profile: TargetSemanticDeclSerializeProfile,
  binding: Symbol
) -> Outcome<String> {
  bind_outcome(
    o: semantic_decl_profile_binding_spellings(profile: profile),
    f: fn(binding_spellings) {
      bound_spelling_from_map(binding_spellings: binding_spellings, binding: binding)
    }
  )
}

fn semantic_decl_bound_tokens_source_text(
  profile: TargetSemanticDeclSerializeProfile,
  tokens: List<ConcreteSyntaxToken>
) -> Outcome<TargetText> {
  bind_outcome(
    o: semantic_decl_profile_lex_rules(profile: profile),
    f: fn(lex) {
      fold_list(
        xs: tokens,
        empty: Accepted { value: target_text_empty, diagnostics: None },
        cons: fn(acc, token) {
          match acc {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: partial, diagnostics: ad } =>
              match token {
                FixedToken { token_class: tc } =>
                  bind_outcome(
                    o: lex_rules_literal_for_class(rules: lex, token_class: tc),
                    f: fn(spelling) {
                      Accepted {
                        value: target_text_seq(acc: partial, next: text_atom(lexeme: spelling)),
                        diagnostics: ad
                      }
                    }
                  )
                BoundToken { token_class: _, binding: b } =>
                  bind_outcome(
                    o: semantic_decl_binding_spelling_lookup(profile: profile, binding: b),
                    f: fn(spelling) {
                      Accepted {
                        value: target_text_seq(acc: partial, next: text_atom(lexeme: spelling)),
                        diagnostics: ad
                      }
                    }
                  )
              }
          }
        }
      )
    }
  )
}

fn semantic_decl_tokens_to_source_text(
  profile: TargetSemanticDeclSerializeProfile,
  tokens: List<ConcreteSyntaxToken>
) -> Outcome<String> {
  bind_outcome(
    o: semantic_decl_bound_tokens_source_text(profile: profile, tokens: tokens),
    f: fn(t) {
      outcome_accepted(value: render_target_text(t: t))
    }
  )
}

fn semantic_decl_serialize_target(
  profile: TargetSemanticDeclSerializeProfile,
  rules: Node,
  host_binding_spellings: Map<Symbol, String>
) -> Outcome<TargetModel> {
  bind_outcome(
    o: semantic_decl_profile_lex_rules(profile: profile),
    f: fn(lex) {
      bind_outcome(
        o: semantic_decl_profile_binding_spellings_over(profile: profile, base: host_binding_spellings),
        f: fn(binding_spellings) {
          outcome_accepted(
            value: TargetModel {
              primitive_realizations: PrimitiveRealizationsUnwired,
              produced_decl_support: ProducedDeclUnwired,
              bundle: target_model_type_conj_node(
                children: [
                  target_model_named_edge(
                    name: ^target_model_edge_translation_rules,
                    target: rules
                  )
                ]
              ),
              lex: lex,
              binding_spellings: binding_spellings,
              token_class_emit_transforms: semantic_decl_emit_transforms(rows: profile.emit_transform_rows),
              authority_source_text: "",
              runtime_row: target_emit_host_runtime_row_unconfigured
            }
          )
        }
      )
    }
  )
}

fn semantic_decl_binding_spellings_from_catalog(catalog: Node) -> Outcome<Map<Symbol, String>> {
  bind_outcome(
    o: semantic_decl_binding_spelling_rows_from_catalog(catalog: catalog),
    f: fn(rows) {
      outcome_accepted(value: semantic_decl_binding_spellings_from_rows(rows: rows))
    }
  )
}

fn semantic_decl_serialize_profile_bundle(
  lex_rows: List<Node>,
  spelling_rows: List<Node>,
  emit_transform_rows: List<TargetSemanticDeclEmitTransformRow>
) -> Node {
  target_model_type_conj_node(
    children: [
      target_model_named_edge(
        name: ^semantic_decl_profile_field_lex_rules,
        target: semantic_decl_lex_rules_catalog(rows: lex_rows)
      ),
      target_model_named_edge(
        name: ^semantic_decl_profile_field_binding_spellings,
        target: semantic_decl_binding_spellings_catalog(rows: spelling_rows)
      ),
      target_model_named_edge(
        name: ^semantic_decl_profile_field_emit_transforms,
        target: semantic_decl_emit_transform_rows_catalog(rows: emit_transform_rows)
      )
    ]
  )
}

// A count is a conj of that many unit atoms: the bundle has no Int node, and a count read back is the
// children's length, so the encoding cannot disagree with itself.
fn semantic_decl_count_node(n: Int) -> Node {
  target_model_type_conj_node(
    children: if n <= 0 { Empty } else { list_append(left: semantic_decl_count_node(n: n - 1).children, right: [Edge { label: Positional, target: target_model_type_atom_node(identity: ^semantic_decl_count_unit) }]) }
  )
}

fn semantic_decl_count_from_node(n: Node) -> Int {
  fold(n.children, init: 0, f: fn(acc, e) { acc + 1 })
}

fn semantic_decl_emit_escape_node(e: TargetSemanticDeclEmitEscape) -> Node {
  target_model_type_conj_node(
    children: [
      target_model_named_edge(name: ^semantic_decl_emit_escape_field_from, target: semantic_decl_string_to_bundle_node(s: e.from)),
      target_model_named_edge(name: ^semantic_decl_emit_escape_field_to, target: semantic_decl_string_to_bundle_node(s: e.to))
    ]
  )
}

fn semantic_decl_emit_transform_node(t: TargetSemanticDeclEmitTransform) -> Node {
  match t {
    DeclEmitLineBreaks { before: b, after: a } =>
      target_model_type_conj_node(
        children: [
          target_model_named_edge(name: ^semantic_decl_emit_transform_field_kind, target: target_model_type_atom_node(identity: ^semantic_decl_emit_transform_line_breaks)),
          target_model_named_edge(name: ^semantic_decl_emit_transform_field_before, target: semantic_decl_count_node(n: b)),
          target_model_named_edge(name: ^semantic_decl_emit_transform_field_after, target: semantic_decl_count_node(n: a))
        ]
      )
    DeclEmitStringQuote { open: o, close: c, escapes: es } =>
      target_model_type_conj_node(
        children: [
          target_model_named_edge(name: ^semantic_decl_emit_transform_field_kind, target: target_model_type_atom_node(identity: ^semantic_decl_emit_transform_string_quote)),
          target_model_named_edge(name: ^semantic_decl_emit_transform_field_open, target: semantic_decl_string_to_bundle_node(s: o)),
          target_model_named_edge(name: ^semantic_decl_emit_transform_field_close, target: semantic_decl_string_to_bundle_node(s: c)),
          target_model_named_edge(
            name: ^semantic_decl_emit_transform_field_escapes,
            target: target_model_type_conj_node(
              children: fold_list(
                xs: es,
                empty: Empty,
                cons: fn(acc, e) { list_snoc_item(xs: acc, item: Edge { label: Positional, target: semantic_decl_emit_escape_node(e: e) }) }
              )
            )
          )
        ]
      )
  }
}

fn semantic_decl_emit_transform_row(row: TargetSemanticDeclEmitTransformRow) -> Node {
  target_model_type_conj_node(
    children: [
      target_model_named_edge(name: ^semantic_decl_emit_row_field_token_class, target: target_model_type_atom_node(identity: row.token_class)),
      target_model_named_edge(name: ^semantic_decl_emit_row_field_transform, target: semantic_decl_emit_transform_node(t: row.transform))
    ]
  )
}

fn semantic_decl_emit_transform_rows_catalog(rows: List<TargetSemanticDeclEmitTransformRow>) -> Node {
  target_model_type_conj_node(
    children: fold_list(
      xs: rows,
      empty: Empty,
      cons: fn(acc, row) {
        list_snoc_item(xs: acc, item: Edge { label: Positional, target: semantic_decl_emit_transform_row(row: row) })
      }
    )
  )
}

fn decode_semantic_decl_emit_escape(row: Node) -> Outcome<TargetSemanticDeclEmitEscape> {
  bind_outcome(
    o: find_named_child(root: row, name: ^semantic_decl_emit_escape_field_from),
    f: fn(from_node) {
      bind_outcome(
        o: semantic_decl_string_from_bundle_node(bundle: from_node),
        f: fn(from) {
          bind_outcome(
            o: find_named_child(root: row, name: ^semantic_decl_emit_escape_field_to),
            f: fn(to_node) {
              bind_outcome(
                o: semantic_decl_string_from_bundle_node(bundle: to_node),
                f: fn(to) { outcome_accepted(value: TargetSemanticDeclEmitEscape { from: from, to: to }) }
              )
            }
          )
        }
      )
    }
  )
}

fn decode_semantic_decl_emit_escapes(catalog: Node) -> Outcome<List<TargetSemanticDeclEmitEscape>> {
  fold(
    catalog.children,
    init: outcome_accepted(value: Empty),
    f: fn(acc_o, edge) {
      bind_outcome(
        o: acc_o,
        f: fn(acc) {
          bind_outcome(
            o: decode_semantic_decl_emit_escape(row: edge.target),
            f: fn(e) { outcome_accepted(value: list_snoc_item(xs: acc, item: e)) }
          )
        }
      )
    }
  )
}

fn decode_semantic_decl_emit_transform(t: Node) -> Outcome<TargetSemanticDeclEmitTransform> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: t, field: ^semantic_decl_emit_transform_field_kind),
    f: fn(kind) {
      if kind == ^semantic_decl_emit_transform_line_breaks {
        bind_outcome(
          o: find_named_child(root: t, name: ^semantic_decl_emit_transform_field_before),
          f: fn(before) {
            bind_outcome(
              o: find_named_child(root: t, name: ^semantic_decl_emit_transform_field_after),
              f: fn(after) {
                outcome_accepted(value: DeclEmitLineBreaks { before: semantic_decl_count_from_node(n: before), after: semantic_decl_count_from_node(n: after) })
              }
            )
          }
        )
      } else if kind == ^semantic_decl_emit_transform_string_quote {
        bind_outcome(
          o: find_named_child(root: t, name: ^semantic_decl_emit_transform_field_open),
          f: fn(open_node) {
            bind_outcome(
              o: semantic_decl_string_from_bundle_node(bundle: open_node),
              f: fn(open) {
                bind_outcome(
                  o: find_named_child(root: t, name: ^semantic_decl_emit_transform_field_close),
                  f: fn(close_node) {
                    bind_outcome(
                      o: semantic_decl_string_from_bundle_node(bundle: close_node),
                      f: fn(close) {
                        bind_outcome(
                          o: find_named_child(root: t, name: ^semantic_decl_emit_transform_field_escapes),
                          f: fn(esc_node) {
                            bind_outcome(
                              o: decode_semantic_decl_emit_escapes(catalog: esc_node),
                              f: fn(escapes) { outcome_accepted(value: DeclEmitStringQuote { open: open, close: close, escapes: escapes }) }
                            )
                          }
                        )
                      }
                    )
                  }
                )
              }
            )
          }
        )
      } else {
        outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: t))
      }
    }
  )
}

fn decode_semantic_decl_emit_transform_row(row: Node) -> Outcome<TargetSemanticDeclEmitTransformRow> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: row, field: ^semantic_decl_emit_row_field_token_class),
    f: fn(token_class) {
      bind_outcome(
        o: find_named_child(root: row, name: ^semantic_decl_emit_row_field_transform),
        f: fn(t) {
          bind_outcome(
            o: decode_semantic_decl_emit_transform(t: t),
            f: fn(transform) { outcome_accepted(value: TargetSemanticDeclEmitTransformRow { token_class: token_class, transform: transform }) }
          )
        }
      )
    }
  )
}

fn decode_semantic_decl_emit_transform_rows_catalog(catalog: Node) -> Outcome<List<TargetSemanticDeclEmitTransformRow>> {
  fold(
    catalog.children,
    init: outcome_accepted(value: Empty),
    f: fn(acc_o, edge) {
      bind_outcome(
        o: acc_o,
        f: fn(acc) {
          bind_outcome(
            o: decode_semantic_decl_emit_transform_row(row: edge.target),
            f: fn(row) { outcome_accepted(value: list_snoc_item(xs: acc, item: row)) }
          )
        }
      )
    }
  )
}

fn semantic_decl_emit_transform_to_token_class_transform(t: TargetSemanticDeclEmitTransform) -> TokenClassEmitTransform {
  match t {
    DeclEmitLineBreaks { before: b, after: a } => EmitLineBreaks { before: b, after: a }
    DeclEmitStringQuote { open: o, close: c, escapes: es } =>
      EmitSpellingQuote {
        prefix: "",
        open: o,
        close: c,
        escapes: fold_list(
          xs: es,
          empty: Empty,
          cons: fn(acc, e) { list_snoc_item(xs: acc, item: EmitSpellingEscape { from: chars(text: e.from), to: chars(text: e.to) }) }
        )
      }
  }
}

// The profile's rows as the TargetModel's emit transforms.
fn semantic_decl_emit_transforms(rows: List<TargetSemanticDeclEmitTransformRow>) -> Map<Symbol, TokenClassEmitTransform> {
  fold_list(
    xs: rows,
    empty: target_model_emit_transforms_empty,
    cons: fn(acc, row) {
      map_insert(m: acc, key: row.token_class, value: semantic_decl_emit_transform_to_token_class_transform(t: row.transform))
    }
  )
}

fn semantic_decl_emission_bundle(
  identity: Symbol,
  enum_translation_rules: Node,
  struct_translation_rules: Node,
  enum_serialize_profile: Node,
  struct_serialize_profile: Node,
  surface: TargetSemanticDeclSurfaceProjection
) -> Node {
  target_model_type_conj_node(
    children: [
      target_model_named_edge(
        name: ^semantic_decl_emission_field_identity,
        target: target_model_type_atom_node(identity: identity)
      ),
      target_model_named_edge(
        name: ^semantic_decl_emission_field_enum_translation_rules,
        target: enum_translation_rules
      ),
      target_model_named_edge(
        name: ^semantic_decl_emission_field_struct_translation_rules,
        target: struct_translation_rules
      ),
      target_model_named_edge(
        name: ^semantic_decl_emission_field_enum_serialize_profile,
        target: enum_serialize_profile
      ),
      target_model_named_edge(
        name: ^semantic_decl_emission_field_struct_serialize_profile,
        target: struct_serialize_profile
      ),
      target_model_named_edge(
        name: ^semantic_decl_emission_field_surface_projection,
        target: semantic_decl_surface_projection_bundle(projection: surface)
      )
    ]
  )
}

fn semantic_decl_decoration_line_row(line: TargetSemanticDeclDecorationLine) -> Node {
  target_model_type_conj_node(
    children: [
      target_model_named_edge(
        name: ^semantic_decl_decoration_line_field_surface_binding,
        target: target_model_type_atom_node(identity: line.surface_binding)
      )
    ]
  )
}

fn semantic_decl_decoration_lines_catalog_from_lines(
  lines: List<TargetSemanticDeclDecorationLine>
) -> Node {
  target_model_type_conj_node(
    children: fold_list(
      xs: lines,
      empty: Empty,
      cons: fn(acc, line) {
        list_snoc_item(
          xs: acc,
          item: Edge {
            label: Positional,
            target: semantic_decl_decoration_line_row(line: line)
          }
        )
      }
    )
  )
}

fn decode_semantic_decl_decoration_line_row(row: Node) -> Outcome<TargetSemanticDeclDecorationLine> {
  bind_outcome(
    o: projection_bundle_symbol_field(
      bundle: row,
      field: ^semantic_decl_decoration_line_field_surface_binding
    ),
    f: fn(surface_binding) {
      outcome_accepted(
        value: TargetSemanticDeclDecorationLine { surface_binding: surface_binding }
      )
    }
  )
}

fn semantic_decl_decoration_lines_from_catalog(catalog: Node) -> Outcome<List<TargetSemanticDeclDecorationLine>> {
  match catalog.kind {
    TypeNode { connective: Conj } =>
      fold(
        catalog.children,
        init: outcome_accepted(value: Empty),
        f: fn(acc_o, edge) {
          bind_outcome(
            o: acc_o,
            f: fn(acc) {
              match edge.label {
                Positional =>
                  bind_outcome(
                    o: decode_semantic_decl_decoration_line_row(row: edge.target),
                    f: fn(line) {
                      outcome_accepted(value: list_snoc_item(xs: acc, item: line))
                    }
                  )
                Authored { name: _ } =>
                  outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: catalog)
                  )
                StructuralLabel { label: _ } =>
                  outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: catalog)
                  )
              }
            }
          )
        }
      )
    TypeNode { connective: Atom { identity: _ } } => semantic_decl_decoration_lines_from_catalog_otherwise(catalog: catalog)
    TypeNode { connective: Disj } => semantic_decl_decoration_lines_from_catalog_otherwise(catalog: catalog)
    TypeNode { connective: Arrow } => semantic_decl_decoration_lines_from_catalog_otherwise(catalog: catalog)
    TypeNode { connective: Instantiation } => semantic_decl_decoration_lines_from_catalog_otherwise(catalog: catalog)
    ComputationNode { behavior: _ } => semantic_decl_decoration_lines_from_catalog_otherwise(catalog: catalog)
  }
}

fn semantic_decl_decoration_lines_from_catalog_otherwise(catalog: Node) -> Outcome<List<TargetSemanticDeclDecorationLine>> {
  outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: catalog)
  )
}

fn semantic_decl_coproduct_decoration_rule_row(rule: TargetSemanticDeclCoproductDecorationRule) -> Node {
  target_model_type_conj_node(
    children: [
      target_model_named_edge(
        name: ^semantic_decl_coproduct_rule_field_shape_key,
        target: target_model_type_atom_node(identity: rule.shape_key)
      ),
      target_model_named_edge(
        name: ^semantic_decl_coproduct_rule_field_decoration_lines,
        target: semantic_decl_decoration_lines_catalog_from_lines(lines: rule.decoration_lines)
      )
    ]
  )
}

fn semantic_decl_coproduct_decoration_rules_catalog(
  rules: List<TargetSemanticDeclCoproductDecorationRule>
) -> Node {
  target_model_type_conj_node(
    children: fold_list(
      xs: rules,
      empty: Empty,
      cons: fn(acc, rule) {
        list_snoc_item(
          xs: acc,
          item: Edge {
            label: Positional,
            target: semantic_decl_coproduct_decoration_rule_row(rule: rule)
          }
        )
      }
    )
  )
}

fn decode_semantic_decl_coproduct_decoration_rule_row(
  row: Node
) -> Outcome<TargetSemanticDeclCoproductDecorationRule> {
  bind_outcome(
    o: projection_bundle_symbol_field(
      bundle: row,
      field: ^semantic_decl_coproduct_rule_field_shape_key
    ),
    f: fn(shape_key) {
      bind_outcome(
        o: find_named_child(
          root: row,
          name: ^semantic_decl_coproduct_rule_field_decoration_lines
        ),
        f: fn(lines_catalog) {
          bind_outcome(
            o: semantic_decl_decoration_lines_from_catalog(catalog: lines_catalog),
            f: fn(decoration_lines) {
              outcome_accepted(
                value: TargetSemanticDeclCoproductDecorationRule {
                  shape_key: shape_key,
                  decoration_lines: decoration_lines
                }
              )
            }
          )
        }
      )
    }
  )
}

fn semantic_decl_coproduct_decoration_rules_from_catalog(
  catalog: Node
) -> Outcome<List<TargetSemanticDeclCoproductDecorationRule>> {
  match catalog.kind {
    TypeNode { connective: Conj } =>
      fold(
        catalog.children,
        init: outcome_accepted(value: Empty),
        f: fn(acc_o, edge) {
          bind_outcome(
            o: acc_o,
            f: fn(acc) {
              match edge.label {
                Positional =>
                  bind_outcome(
                    o: decode_semantic_decl_coproduct_decoration_rule_row(row: edge.target),
                    f: fn(rule) {
                      outcome_accepted(value: list_snoc_item(xs: acc, item: rule))
                    }
                  )
                Authored { name: _ } =>
                  outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: catalog)
                  )
                StructuralLabel { label: _ } =>
                  outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: catalog)
                  )
              }
            }
          )
        }
      )
    TypeNode { connective: Atom { identity: _ } } => semantic_decl_coproduct_decoration_rules_from_catalog_otherwise(catalog: catalog)
    TypeNode { connective: Disj } => semantic_decl_coproduct_decoration_rules_from_catalog_otherwise(catalog: catalog)
    TypeNode { connective: Arrow } => semantic_decl_coproduct_decoration_rules_from_catalog_otherwise(catalog: catalog)
    TypeNode { connective: Instantiation } => semantic_decl_coproduct_decoration_rules_from_catalog_otherwise(catalog: catalog)
    ComputationNode { behavior: _ } => semantic_decl_coproduct_decoration_rules_from_catalog_otherwise(catalog: catalog)
  }
}

fn semantic_decl_coproduct_decoration_rules_from_catalog_otherwise(catalog: Node) -> Outcome<List<TargetSemanticDeclCoproductDecorationRule>> {
  outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: catalog)
  )
}

fn semantic_decl_surface_projection_bundle(
  projection: TargetSemanticDeclSurfaceProjection
) -> Node {
  target_model_type_conj_node(
    children: list_append(
      left: [
        target_model_named_edge(
          name: ^semantic_decl_surface_field_record_decoration_lines,
          target: semantic_decl_decoration_lines_catalog_from_lines(
            lines: projection.record_decoration_lines
          )
        ),
        target_model_named_edge(
          name: ^semantic_decl_surface_field_coproduct_decoration_rules,
          target: semantic_decl_coproduct_decoration_rules_catalog(
            rules: projection.coproduct_decoration_rules
          )
        ),
        target_model_named_edge(
          name: ^semantic_decl_surface_field_type_before_name,
          target: semantic_decl_surface_projection_bool_flag_node(
            enabled: projection.field_type_before_name,
            true_id: ^semantic_decl_field_type_before_name_true,
            false_id: ^semantic_decl_field_type_before_name_false
          )
        ),
        target_model_named_edge(
          name: ^semantic_decl_surface_field_type_expr_field_scope,
          target: semantic_decl_surface_projection_bool_flag_node(
            enabled: projection.type_expr_field_scope,
            true_id: ^semantic_decl_type_expr_field_scope_true,
            false_id: ^semantic_decl_type_expr_field_scope_false
          )
        ),
        target_model_named_edge(
          name: ^semantic_decl_surface_field_struct_typedef_name_after_fields,
          target: semantic_decl_surface_projection_bool_flag_node(
            enabled: projection.struct_typedef_name_after_fields,
            true_id: ^semantic_decl_struct_typedef_name_after_fields_true,
            false_id: ^semantic_decl_struct_typedef_name_after_fields_false
          )
        ),
        target_model_named_edge(
          name: ^semantic_decl_surface_field_enum_name_after_variants,
          target: semantic_decl_surface_projection_bool_flag_node(
            enabled: projection.enum_name_after_variants,
            true_id: ^semantic_decl_enum_name_after_variants_true,
            false_id: ^semantic_decl_enum_name_after_variants_false
          )
        ),
        target_model_named_edge(
          name: ^semantic_decl_surface_field_type_permit_only_int,
          target: semantic_decl_surface_projection_bool_flag_node(
            enabled: projection.field_type_permit_only_int,
            true_id: ^semantic_decl_field_type_permit_only_int_true,
            false_id: ^semantic_decl_field_type_permit_only_int_false
          )
        ),
        target_model_named_edge(
          name: ^semantic_decl_surface_field_coproduct_layout_kind,
          target: semantic_decl_surface_projection_coproduct_layout_kind_node(
            layout: projection.coproduct_layout
          )
        ),
        target_model_named_edge(
          name: ^semantic_decl_surface_field_member_projection,
          target: semantic_decl_member_projection_node(projection: projection.member_projection)
        ),
        target_model_named_edge(
          name: ^semantic_decl_surface_field_import_projection,
          target: semantic_decl_import_projection_node(projection: projection.import_projection)
        ),
        target_model_named_edge(
          name: ^semantic_decl_surface_field_header_projection,
          target: semantic_decl_header_projection_node(projection: projection.header_projection)
        )
      ],
      right: semantic_decl_surface_projection_coproduct_layout_extra_edges(
        layout: projection.coproduct_layout
      )
    )
  )
}

fn semantic_decl_member_projection_node(projection: TargetSemanticDeclMemberProjection) -> Node {
  match projection {
    MembersUnwired => target_model_type_atom_node(identity: ^semantic_decl_members_unwired)
    MembersInsideTypeBody => target_model_type_atom_node(identity: ^semantic_decl_members_inside_type_body)
    MembersInAssociatedBlock => target_model_type_atom_node(identity: ^semantic_decl_members_in_associated_block)
  }
}

fn semantic_decl_header_projection_node(projection: TargetSemanticDeclHeaderProjection) -> Node {
  match projection {
    HeaderUnwired => target_model_type_atom_node(identity: ^semantic_decl_header_unwired)
    HeaderLeadingLines => target_model_type_atom_node(identity: ^semantic_decl_header_leading_lines)
  }
}

fn decode_semantic_decl_header_projection(bundle: Node) -> Outcome<TargetSemanticDeclHeaderProjection> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: bundle, field: ^semantic_decl_surface_field_header_projection),
    f: fn(id) {
      if id == ^semantic_decl_header_unwired {
        outcome_accepted(value: HeaderUnwired)
      } else if id == ^semantic_decl_header_leading_lines {
        outcome_accepted(value: HeaderLeadingLines)
      } else {
        outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: bundle))
      }
    }
  )
}

fn semantic_decl_import_projection_node(projection: TargetSemanticDeclImportProjection) -> Node {
  match projection {
    ImportsUnwired => target_model_type_atom_node(identity: ^semantic_decl_imports_unwired)
    ImportsLeading => target_model_type_atom_node(identity: ^semantic_decl_imports_leading)
  }
}

fn decode_semantic_decl_import_projection(bundle: Node) -> Outcome<TargetSemanticDeclImportProjection> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: bundle, field: ^semantic_decl_surface_field_import_projection),
    f: fn(id) {
      if id == ^semantic_decl_imports_unwired {
        outcome_accepted(value: ImportsUnwired)
      } else if id == ^semantic_decl_imports_leading {
        outcome_accepted(value: ImportsLeading)
      } else {
        outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: bundle))
      }
    }
  )
}

fn decode_semantic_decl_member_projection(bundle: Node) -> Outcome<TargetSemanticDeclMemberProjection> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: bundle, field: ^semantic_decl_surface_field_member_projection),
    f: fn(id) {
      if id == ^semantic_decl_members_unwired {
        outcome_accepted(value: MembersUnwired)
      } else if id == ^semantic_decl_members_inside_type_body {
        outcome_accepted(value: MembersInsideTypeBody)
      } else if id == ^semantic_decl_members_in_associated_block {
        outcome_accepted(value: MembersInAssociatedBlock)
      } else {
        outcome_rejected(d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: bundle))
      }
    }
  )
}

fn semantic_decl_surface_projection_coproduct_layout_kind_node(
  layout: TargetSemanticDeclCoproductSurfaceLayout
) -> Node {
  match layout {
    TargetSemanticDeclCoproductEnumSurface =>
      target_model_type_atom_node(identity: ^semantic_decl_coproduct_layout_enum)
    TargetSemanticDeclCoproductTaggedUnionSurface { tag_field: _, union_field: _ } =>
      target_model_type_atom_node(identity: ^semantic_decl_coproduct_layout_tagged_union)
  }
}

fn semantic_decl_surface_projection_coproduct_layout_extra_edges(
  layout: TargetSemanticDeclCoproductSurfaceLayout
) -> List<Edge> {
  match layout {
    TargetSemanticDeclCoproductEnumSurface => Empty
    TargetSemanticDeclCoproductTaggedUnionSurface { tag_field: tag_field, union_field: union_field } =>
      [
        target_model_named_edge(
          name: ^semantic_decl_surface_field_tagged_union_tag_field,
          target: target_model_type_atom_node(identity: tag_field)
        ),
        target_model_named_edge(
          name: ^semantic_decl_surface_field_tagged_union_union_field,
          target: target_model_type_atom_node(identity: union_field)
        )
      ]
  }
}

fn semantic_decl_surface_projection_bool_flag_node(
  enabled: Bool,
  true_id: Symbol,
  false_id: Symbol
) -> Node {
  target_model_type_atom_node(identity: if enabled { true_id } else { false_id })
}

fn decode_semantic_decl_surface_projection_bool_flag(
  bundle: Node,
  field: Symbol,
  true_id: Symbol,
  false_id: Symbol
) -> Outcome<Bool> {
  bind_outcome(
    o: find_named_child(root: bundle, name: field),
    f: fn(flag) {
      match flag.kind {
        TypeNode { connective: Atom { identity: id } } =>
          if id == true_id {
            outcome_accepted(value: true)
          } else if id == false_id {
            outcome_accepted(value: false)
          } else {
            outcome_rejected(
              d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: bundle)
            )
          }
        TypeNode { connective: Conj } => decode_semantic_decl_surface_projection_bool_flag_otherwise(bundle: bundle)
        TypeNode { connective: Disj } => decode_semantic_decl_surface_projection_bool_flag_otherwise(bundle: bundle)
        TypeNode { connective: Arrow } => decode_semantic_decl_surface_projection_bool_flag_otherwise(bundle: bundle)
        TypeNode { connective: Instantiation } => decode_semantic_decl_surface_projection_bool_flag_otherwise(bundle: bundle)
        ComputationNode { behavior: _ } => decode_semantic_decl_surface_projection_bool_flag_otherwise(bundle: bundle)
      }
    }
  )
}

fn decode_semantic_decl_surface_projection_bool_flag_otherwise(bundle: Node) -> Outcome<Bool> {
  outcome_rejected(
    d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: bundle)
  )
}

fn decode_semantic_decl_surface_projection_coproduct_layout(
  bundle: Node
) -> Outcome<TargetSemanticDeclCoproductSurfaceLayout> {
  bind_outcome(
    o: find_named_child(
      root: bundle,
      name: ^semantic_decl_surface_field_coproduct_layout_kind
    ),
    f: fn(kind_node) {
      match kind_node.kind {
        TypeNode { connective: Atom { identity: id } } =>
          if id == ^semantic_decl_coproduct_layout_enum {
            outcome_accepted(value: TargetSemanticDeclCoproductEnumSurface)
          } else if id == ^semantic_decl_coproduct_layout_tagged_union {
            bind_outcome(
              o: projection_bundle_symbol_field(
                bundle: bundle,
                field: ^semantic_decl_surface_field_tagged_union_tag_field
              ),
              f: fn(tag_field) {
                bind_outcome(
                  o: projection_bundle_symbol_field(
                    bundle: bundle,
                    field: ^semantic_decl_surface_field_tagged_union_union_field
                  ),
                  f: fn(union_field) {
                    outcome_accepted(
                      value: TargetSemanticDeclCoproductTaggedUnionSurface {
                        tag_field: tag_field,
                        union_field: union_field
                      }
                    )
                  }
                )
              }
            )
          } else {
            outcome_rejected(
              d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: bundle)
            )
          }
        TypeNode { connective: Conj } => decode_semantic_decl_surface_projection_coproduct_layout_otherwise(bundle: bundle)
        TypeNode { connective: Disj } => decode_semantic_decl_surface_projection_coproduct_layout_otherwise(bundle: bundle)
        TypeNode { connective: Arrow } => decode_semantic_decl_surface_projection_coproduct_layout_otherwise(bundle: bundle)
        TypeNode { connective: Instantiation } => decode_semantic_decl_surface_projection_coproduct_layout_otherwise(bundle: bundle)
        ComputationNode { behavior: _ } => decode_semantic_decl_surface_projection_coproduct_layout_otherwise(bundle: bundle)
      }
    }
  )
}

fn decode_semantic_decl_surface_projection_coproduct_layout_otherwise(bundle: Node) -> Outcome<TargetSemanticDeclCoproductSurfaceLayout> {
  outcome_rejected(
    d: semantic_decl_emission_bundle_malformed_diagnostic(bundle: bundle)
  )
}

fn decode_semantic_decl_surface_projection_bundle(
  bundle: Node
) -> Outcome<TargetSemanticDeclSurfaceProjection> {
  bind_outcome(
    o: find_named_child(
      root: bundle,
      name: ^semantic_decl_surface_field_record_decoration_lines
    ),
    f: fn(record_catalog) {
      bind_outcome(
        o: semantic_decl_decoration_lines_from_catalog(catalog: record_catalog),
        f: fn(record_decoration_lines) {
          bind_outcome(
            o: find_named_child(
              root: bundle,
              name: ^semantic_decl_surface_field_coproduct_decoration_rules
            ),
            f: fn(rules_catalog) {
              bind_outcome(
                o: semantic_decl_coproduct_decoration_rules_from_catalog(catalog: rules_catalog),
                f: fn(coproduct_decoration_rules) {
                  bind_outcome(
                    o: decode_semantic_decl_surface_projection_bool_flag(
                      bundle: bundle,
                      field: ^semantic_decl_surface_field_type_before_name,
                      true_id: ^semantic_decl_field_type_before_name_true,
                      false_id: ^semantic_decl_field_type_before_name_false
                    ),
                    f: fn(field_type_before_name) {
                      bind_outcome(
                        o: decode_semantic_decl_surface_projection_bool_flag(
                          bundle: bundle,
                          field: ^semantic_decl_surface_field_type_expr_field_scope,
                          true_id: ^semantic_decl_type_expr_field_scope_true,
                          false_id: ^semantic_decl_type_expr_field_scope_false
                        ),
                        f: fn(type_expr_field_scope) {
                          bind_outcome(
                            o: decode_semantic_decl_surface_projection_bool_flag(
                              bundle: bundle,
                              field: ^semantic_decl_surface_field_struct_typedef_name_after_fields,
                              true_id: ^semantic_decl_struct_typedef_name_after_fields_true,
                              false_id: ^semantic_decl_struct_typedef_name_after_fields_false
                            ),
                            f: fn(struct_typedef_name_after_fields) {
                              bind_outcome(
                                o: decode_semantic_decl_surface_projection_bool_flag(
                                  bundle: bundle,
                                  field: ^semantic_decl_surface_field_enum_name_after_variants,
                                  true_id: ^semantic_decl_enum_name_after_variants_true,
                                  false_id: ^semantic_decl_enum_name_after_variants_false
                                ),
                                f: fn(enum_name_after_variants) {
                                  bind_outcome(
                                    o: decode_semantic_decl_surface_projection_bool_flag(
                                      bundle: bundle,
                                      field: ^semantic_decl_surface_field_type_permit_only_int,
                                      true_id: ^semantic_decl_field_type_permit_only_int_true,
                                      false_id: ^semantic_decl_field_type_permit_only_int_false
                                    ),
                                    f: fn(field_type_permit_only_int) {
                                      bind_outcome(
                                        o: decode_semantic_decl_surface_projection_coproduct_layout(
                                          bundle: bundle
                                        ),
                                        f: fn(coproduct_layout) {
                                          bind_outcome(
                                            o: decode_semantic_decl_member_projection(bundle: bundle),
                                            f: fn(member_projection) {
                                          bind_outcome(
                                            o: decode_semantic_decl_import_projection(bundle: bundle),
                                            f: fn(import_projection) {
                                          bind_outcome(
                                            o: decode_semantic_decl_header_projection(bundle: bundle),
                                            f: fn(header_projection) {
                                          outcome_accepted(
                                            TargetSemanticDeclSurfaceProjection {
                                              record_decoration_lines: record_decoration_lines,
                                              coproduct_decoration_rules: coproduct_decoration_rules,
                                              field_type_before_name: field_type_before_name,
                                              type_expr_field_scope: type_expr_field_scope,
                                              struct_typedef_name_after_fields: struct_typedef_name_after_fields,
                                              enum_name_after_variants: enum_name_after_variants,
                                              field_type_permit_only_int: field_type_permit_only_int,
                                              coproduct_layout: coproduct_layout,
                                              member_projection: member_projection,
                                              import_projection: import_projection,
                                              header_projection: header_projection
                                            }
                                          )
                                            }
                                          )
                                            }
                                          )
                                            }
                                          )
                                        }
                                      )
                                    }
                                  )
                                }
                              )
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn decode_semantic_decl_serialize_profile_bundle(
  bundle: Node
) -> Outcome<TargetSemanticDeclSerializeProfile> {
  bind_outcome(
    o: find_named_child(root: bundle, name: ^semantic_decl_profile_field_lex_rules),
    f: fn(lex_catalog) {
      bind_outcome(
        o: semantic_decl_lex_rule_rows_from_catalog(catalog: lex_catalog),
        f: fn(lex_rule_rows) {
          bind_outcome(
            o: find_named_child(
              root: bundle,
              name: ^semantic_decl_profile_field_binding_spellings
            ),
            f: fn(spellings_catalog) {
              bind_outcome(
                o: semantic_decl_lex_rule_rows_from_catalog(catalog: spellings_catalog),
                f: fn(binding_spelling_rows) {
                  bind_outcome(
                    o: find_named_child(root: bundle, name: ^semantic_decl_profile_field_emit_transforms),
                    f: fn(emit_transform_catalog) {
                      bind_outcome(
                        o: decode_semantic_decl_emit_transform_rows_catalog(catalog: emit_transform_catalog),
                        f: fn(emit_transform_rows) {
                          outcome_accepted(
                            TargetSemanticDeclSerializeProfile {
                              lex_rule_rows: lex_rule_rows,
                              binding_spelling_rows: binding_spelling_rows,
                              emit_transform_rows: emit_transform_rows
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn decode_semantic_decl_emission_bundle(bundle: Node) -> Outcome<TargetSemanticDeclEmission> {
  bind_outcome(
    o: projection_bundle_symbol_field(
      bundle: bundle,
      field: ^semantic_decl_emission_field_identity
    ),
    f: fn(identity) {
      bind_outcome(
        o: find_named_child(
          root: bundle,
          name: ^semantic_decl_emission_field_enum_translation_rules
        ),
        f: fn(enum_rules) {
          bind_outcome(
            o: find_named_child(
              root: bundle,
              name: ^semantic_decl_emission_field_struct_translation_rules
            ),
            f: fn(struct_rules) {
              bind_outcome(
                o: find_named_child(
                  root: bundle,
                  name: ^semantic_decl_emission_field_enum_serialize_profile
                ),
                f: fn(enum_profile_bundle) {
                  bind_outcome(
                    o: decode_semantic_decl_serialize_profile_bundle(bundle: enum_profile_bundle),
                    f: fn(enum_profile) {
                      bind_outcome(
                        o: find_named_child(
                          root: bundle,
                          name: ^semantic_decl_emission_field_struct_serialize_profile
                        ),
                        f: fn(struct_profile_bundle) {
                          bind_outcome(
                            o: decode_semantic_decl_serialize_profile_bundle(
                              bundle: struct_profile_bundle
                            ),
                            f: fn(struct_profile) {
                              bind_outcome(
                                o: find_named_child(
                                  root: bundle,
                                  name: ^semantic_decl_emission_field_surface_projection
                                ),
                                f: fn(surface_bundle) {
                                  bind_outcome(
                                    o: decode_semantic_decl_surface_projection_bundle(
                                      bundle: surface_bundle
                                    ),
                                    f: fn(surface) {
                                      outcome_accepted(
                                        TargetSemanticDeclEmission {
                                          identity: identity,
                                          enum_translation_rules: enum_rules,
                                          struct_translation_rules: struct_rules,
                                          enum_serialize_profile: enum_profile,
                                          struct_serialize_profile: struct_profile,
                                          surface: surface
                                        }
                                      )
                                    }
                                  )
                                }
                              )
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn semantic_decl_emission_from_target(target: TargetModel) -> Outcome<TargetSemanticDeclEmission> {
  bind_outcome(
    o: projection_bundle_child(
      bundle: target.bundle,
      name: ^target_model_edge_semantic_decl_emission
    ),
    f: fn(bundle) {
      decode_semantic_decl_emission_bundle(bundle: bundle)
    }
  )
}

fn target_semantic_decl_surface_pos(target: Node) -> Edge {
  Edge { label: Positional, target: target }
}

fn target_semantic_decl_surface_conj(children: List<Edge>) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: children,
    occurrence_id: OccurrenceSynthetic
  }
}

fn target_semantic_decl_surface_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: [],
    occurrence_id: OccurrenceSynthetic
  }
}

fn target_semantic_decl_surface_nil() -> Node {
  target_semantic_decl_surface_conj(children: [])
}

fn target_semantic_decl_surface_cell(item: Node, rest: Node) -> Node {
  target_semantic_decl_surface_conj(
    children: [
      target_semantic_decl_surface_pos(target: item),
      target_semantic_decl_surface_pos(target: rest)
    ]
  )
}

fn target_semantic_decl_surface_cons_list(items: List<Node>) -> Node {
  fold_list_right(
    xs: items,
    empty: target_semantic_decl_surface_nil(),
    snoc: fn(acc, item) {
      target_semantic_decl_surface_cell(item: item, rest: acc)
    }
  )
}

fn target_semantic_decl_surface_type_expr(t: Symbol) -> Node {
  target_semantic_decl_surface_conj(
    children: [
      target_semantic_decl_surface_pos(
        target: target_semantic_decl_surface_conj(
          children: [ target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: t)) ]
        )
      )
    ]
  )
}

fn target_semantic_decl_surface_type_expr_scoped(scope: Symbol, t: Symbol) -> Node {
  target_semantic_decl_surface_conj(
    children: [
      target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: scope)),
      target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: t))
    ]
  )
}

fn target_semantic_decl_surface_type_expr_for_field(
  name: Symbol,
  t: Symbol,
  type_expr_field_scope: Bool
) -> Node {
  if type_expr_field_scope {
    target_semantic_decl_surface_type_expr_scoped(scope: name, t: t)
  } else {
    target_semantic_decl_surface_type_expr(t: t)
  }
}

fn target_semantic_decl_surface_field(
  name: Symbol,
  t: Symbol,
  type_before_name: Bool,
  type_expr_field_scope: Bool
) -> Node {
  let type_node = target_semantic_decl_surface_type_expr_for_field(
    name: name,
    t: t,
    type_expr_field_scope: type_expr_field_scope
  )
  if type_before_name {
    target_semantic_decl_surface_conj(
      children: [
        target_semantic_decl_surface_pos(target: type_node),
        target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: name))
      ]
    )
  } else {
    target_semantic_decl_surface_conj(
      children: [
        target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: name)),
        target_semantic_decl_surface_pos(target: type_node)
      ]
    )
  }
}

// A FIELD'S TYPE IS SPELLED BY THE CALLER'S type_binding -- the same resolver a function signature's types
// go through (v2.compiler.emit_produced produced_type_binding): a declared type's reference by the target's
// declaration-reference form, a kernel carrier by its atom realization, else an explicit target spelling,
// else refused. It was bound as the raw atom, so `a: Int` emitted `a: dag_binding_type_int`.
fn target_semantic_decl_field_surface_resolved(
  name: Symbol,
  type_node: Node,
  projection: TargetSemanticDeclSurfaceProjection,
  type_binding: fn(Node) -> Outcome<Symbol>
) -> Outcome<Node> {
  bind_outcome(
    o: type_binding(type_node),
    f: fn(t) {
      outcome_accepted(
        value: target_semantic_decl_surface_field(
          name: name,
          t: t,
          type_before_name: projection.field_type_before_name,
          type_expr_field_scope: projection.type_expr_field_scope
        )
      )
    }
  )
}

fn target_semantic_decl_field_surface_from_edge(
  edge: Edge,
  projection: TargetSemanticDeclSurfaceProjection,
  type_binding: fn(Node) -> Outcome<Symbol>
) -> Outcome<Node> {
  match declared_field_from_edge(e: edge) {
    Present { value: binder } =>
      match binder.default {
        Present { value: default } =>
          outcome_rejected(d: Diagnostic {
            reason: ^target_semantic_decl_field_default_unrealized,
            at: node_locus(node: default),
            correction: Unavailable { reason: ExternalContractUnknown }
          })
        Absent =>
      match binder.type_node.kind {
        TypeNode { connective: Atom { identity: tid } } =>
          if projection.field_type_permit_only_int && tid != ^Int {
            outcome_rejected(d: Diagnostic {
                  reason: ^target_semantic_decl_field_type_primitive_unsupported,
                  at: node_locus(node: binder.type_node),
                  correction: Unavailable { reason: ExternalContractUnknown }
                })
          } else {
            target_semantic_decl_field_surface_resolved(name: binder.name, type_node: binder.type_node, projection: projection, type_binding: type_binding)
          }
        TypeNode { connective: Conj } => target_semantic_decl_field_surface_from_edge_otherwise(name: binder.name, type_node: binder.type_node, projection: projection, type_binding: type_binding)
        TypeNode { connective: Disj } => target_semantic_decl_field_surface_from_edge_otherwise(name: binder.name, type_node: binder.type_node, projection: projection, type_binding: type_binding)
        TypeNode { connective: Arrow } => target_semantic_decl_field_surface_from_edge_otherwise(name: binder.name, type_node: binder.type_node, projection: projection, type_binding: type_binding)
        TypeNode { connective: Instantiation } => target_semantic_decl_field_surface_from_edge_otherwise(name: binder.name, type_node: binder.type_node, projection: projection, type_binding: type_binding)
        ComputationNode { behavior: _ } => target_semantic_decl_field_surface_from_edge_otherwise(name: binder.name, type_node: binder.type_node, projection: projection, type_binding: type_binding)
      }
      }
    Absent =>
      outcome_rejected(d: Diagnostic {
            reason: ^target_semantic_decl_field_not_named,
            at: node_locus(node: edge.target),
            correction: Unavailable { reason: ExternalContractUnknown }
          })
  }
}

fn target_semantic_decl_field_surface_from_edge_otherwise(
  name: Symbol,
  type_node: Node,
  projection: TargetSemanticDeclSurfaceProjection,
  type_binding: fn(Node) -> Outcome<Symbol>
) -> Outcome<Node> {
  match declaration_reference_path_optional(node: type_node) {
    Present { value: _ } =>
      target_semantic_decl_field_surface_resolved(name: name, type_node: type_node, projection: projection, type_binding: type_binding)
    Absent =>
      outcome_rejected(d: Diagnostic {
        reason: ^target_semantic_decl_field_type_not_atom,
        at: node_locus(node: type_node),
        correction: Unavailable { reason: ExternalContractUnknown }
      })
  }
}

fn target_semantic_decl_surface_field_block(fields: List<Node>) -> Node {
  target_semantic_decl_surface_field_block_with(fields: fields, body_edges: Empty)
}

fn target_semantic_decl_surface_field_block_with(fields: List<Node>, body_edges: List<Edge>) -> Node {
  target_semantic_decl_surface_conj(
    children: list_append(
      left: [
        target_semantic_decl_surface_pos(
          target: target_semantic_decl_surface_cons_list(items: fields)
        )
      ],
      right: body_edges
    )
  )
}

fn target_semantic_decl_surface_decoration_line(binding: Symbol) -> Node {
  target_semantic_decl_surface_conj(
    children: [ target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: binding)) ]
  )
}

fn target_semantic_decl_surface_decoration_pos_edges(
  lines: List<TargetSemanticDeclDecorationLine>
) -> List<Edge> {
  fold_list(
    xs: lines,
    empty: Empty,
    cons: fn(acc, line) {
      list_snoc_item(
        xs: acc,
        item: target_semantic_decl_surface_pos(
          target: target_semantic_decl_surface_decoration_line(binding: line.surface_binding)
        )
      )
    }
  )
}

fn target_semantic_decl_surface_struct_name_field_edges(
  name: Symbol,
  fields: List<Node>,
  body_edges: List<Edge>,
  struct_typedef_name_after_fields: Bool
) -> List<Edge> {
  if struct_typedef_name_after_fields {
    [
      target_semantic_decl_surface_pos(target: target_semantic_decl_surface_field_block_with(fields: fields, body_edges: body_edges)),
      target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: name))
    ]
  } else {
    [
      target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: name)),
      target_semantic_decl_surface_pos(target: target_semantic_decl_surface_field_block_with(fields: fields, body_edges: body_edges))
    ]
  }
}

fn target_semantic_decl_surface_struct_nongeneric(
  name: Symbol,
  decoration_lines: List<TargetSemanticDeclDecorationLine>,
  fields: List<Node>,
  body_member_edges: List<Edge>,
  trailing_member_edges: List<Edge>,
  struct_typedef_name_after_fields: Bool
) -> Node {
  target_semantic_decl_surface_conj(
    children: list_append(
      left: target_semantic_decl_surface_decoration_pos_edges(lines: decoration_lines),
      right: list_append(
        left: target_semantic_decl_surface_struct_name_field_edges(
          name: name,
          fields: fields,
          body_edges: body_member_edges,
          struct_typedef_name_after_fields: struct_typedef_name_after_fields
        ),
        right: trailing_member_edges
      )
    )
  )
}

fn target_semantic_decl_import_surface(path: Symbol) -> Node {
  target_semantic_decl_surface_conj(
    children: [ target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: path)) ]
  )
}

// The imports a declaration leads with, one arm per import projection. Under a wired target the leading edge is
// ALWAYS present (an empty list is the nil terminator the target's nullable import list consumes), so a
// declaration without imports prints nothing extra; under an unwired target an import refuses, located.
fn target_semantic_decl_surface_with_imports(
  projection: TargetSemanticDeclSurfaceProjection,
  imports: List<Symbol>,
  surface: Node
) -> Outcome<Node> {
  match projection.import_projection {
    ImportsUnwired =>
      if is_empty(xs: imports) {
        outcome_accepted(value: surface)
      } else {
        outcome_rejected(d: Diagnostic {
              reason: ^target_semantic_decl_imports_unwired,
              at: node_locus(node: surface),
              correction: Unavailable { reason: ExternalContractUnknown }
            })
      }
    ImportsLeading =>
      outcome_accepted(
        value: Node {
          kind: surface.kind,
          children: list_append(
            left: [
              target_semantic_decl_surface_pos(
                target: target_semantic_decl_surface_cons_list(
                  items: fold_list(
                    xs: imports,
                    empty: Empty,
                    cons: fn(acc, path) { list_snoc_item(xs: acc, item: target_semantic_decl_import_surface(path: path)) }
                  )
                )
              )
            ],
            right: surface.children
          ),
          occurrence_id: surface.occurrence_id
        }
      )
  }
}

// A leading line is ONE line of the target's line comment: a line break inside it ends the comment and the rest
// of the text would print as code, so such a line refuses (located) rather than printing.
data target_semantic_decl_line_break_alphabet: String = "\n\r"

fn target_semantic_decl_lines_break(lines: List<String>) -> Bool {
  !(for_all(xs: lines, predicate: fn(line) { !string_any_char_in(s: line, alphabet: target_semantic_decl_line_break_alphabet) }))
}

fn target_semantic_decl_header_line_surface(line: String) -> Node {
  target_semantic_decl_surface_conj(
    children: [ target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: symbol_intern_lexeme(lexeme: line))) ]
  )
}

// The header lines a declaration leads with, one arm per header projection. Under a wired target the leading edge
// is ALWAYS present (an empty list is the nil the target's nullable header list consumes); under an unwired target
// a line refuses, located. Applied last, so the header leads the imports.
fn target_semantic_decl_surface_with_header(
  projection: TargetSemanticDeclSurfaceProjection,
  header: List<String>,
  surface: Node
) -> Outcome<Node> {
  match projection.header_projection {
    HeaderUnwired =>
      if is_empty(xs: header) {
        outcome_accepted(value: surface)
      } else {
        outcome_rejected(d: Diagnostic {
              reason: ^target_semantic_decl_header_unwired,
              at: node_locus(node: surface),
              correction: Unavailable { reason: ExternalContractUnknown }
            })
      }
    HeaderLeadingLines =>
      if target_semantic_decl_lines_break(lines: header) {
        outcome_rejected(d: Diagnostic {
              reason: ^target_semantic_decl_header_line_break,
              at: node_locus(node: surface),
              correction: Unavailable { reason: ExternalContractUnknown }
            })
      } else {
      outcome_accepted(
        value: Node {
          kind: surface.kind,
          children: list_append(
            left: [
              target_semantic_decl_surface_pos(
                target: target_semantic_decl_surface_cons_list(
                  items: fold_list(
                    xs: header,
                    empty: Empty,
                    cons: fn(acc, line) { list_snoc_item(xs: acc, item: target_semantic_decl_header_line_surface(line: line)) }
                  )
                )
              )
            ],
            right: surface.children
          ),
          occurrence_id: surface.occurrence_id
        }
      )
      }
  }
}

fn target_semantic_decl_member_surface(m: TargetSemanticDeclMember) -> Node {
  target_semantic_decl_surface_conj(
    children: [
      target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: m.name)),
      target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: m.literal))
    ]
  )
}

fn target_semantic_decl_member_block_edge(members: List<TargetSemanticDeclMember>) -> Edge {
  target_semantic_decl_surface_pos(
    target: target_semantic_decl_surface_cons_list(
      items: fold_list(
        xs: members,
        empty: Empty,
        cons: fn(acc, m) { list_snoc_item(xs: acc, item: target_semantic_decl_member_surface(m: m)) }
      )
    )
  )
}

// The trailing surface children a declaration's members add, one arm per member projection. No members adds
// nothing under any arm; members under an unwired target refuse, located, rather than being dropped.
fn target_semantic_decl_member_edges(
  projection: TargetSemanticDeclSurfaceProjection,
  name: Symbol,
  members: List<TargetSemanticDeclMember>,
  inside_body: Bool,
  at: Node
) -> Outcome<List<Edge>> {
  if is_empty(xs: members) {
    outcome_accepted(value: Empty)
  } else {
    match projection.member_projection {
      MembersUnwired =>
        outcome_rejected(d: Diagnostic {
              reason: ^target_semantic_decl_members_unwired,
              at: node_locus(node: at),
              correction: Unavailable { reason: ExternalContractUnknown }
            })
      MembersInsideTypeBody =>
        outcome_accepted(
          value: if inside_body { [target_semantic_decl_member_block_edge(members: members)] } else { [] }
        )
      MembersInAssociatedBlock =>
        outcome_accepted(
          value: if inside_body {
            []
          } else {
            [
              target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: name)),
              target_semantic_decl_member_block_edge(members: members)
            ]
          }
        )
    }
  }
}

fn target_semantic_decl_surface_struct_generic(
  name: Symbol,
  decoration_lines: List<TargetSemanticDeclDecorationLine>,
  params: List<Symbol>,
  fields: List<Node>
) -> Node {
  target_semantic_decl_surface_conj(
    children: list_append(
      left: target_semantic_decl_surface_decoration_pos_edges(lines: decoration_lines),
      right: [
        target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: name)),
        target_semantic_decl_surface_pos(
          target: target_semantic_decl_surface_generic_params(params: params)
        ),
        target_semantic_decl_surface_pos(target: target_semantic_decl_surface_field_block(fields: fields))
      ]
    )
  )
}

fn target_semantic_decl_surface_enum_name_variant_edges(
  name: Symbol,
  variants: List<Node>,
  enum_name_after_variants: Bool
) -> List<Edge> {
  if enum_name_after_variants {
    list_append(
      left: [
        target_semantic_decl_surface_pos(
          target: target_semantic_decl_surface_variant_block(variants: variants)
        )
      ],
      right: [
        target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: name))
      ]
    )
  } else {
    list_append(
      left: [
        target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: name))
      ],
      right: [
        target_semantic_decl_surface_pos(
          target: target_semantic_decl_surface_variant_block(variants: variants)
        )
      ]
    )
  }
}

fn target_semantic_decl_surface_enum_nongeneric(
  name: Symbol,
  decoration_lines: List<TargetSemanticDeclDecorationLine>,
  variants: List<Node>,
  enum_name_after_variants: Bool
) -> Node {
  target_semantic_decl_surface_conj(
    children: list_append(
      left: target_semantic_decl_surface_decoration_pos_edges(lines: decoration_lines),
      right: target_semantic_decl_surface_enum_name_variant_edges(
        name: name,
        variants: variants,
        enum_name_after_variants: enum_name_after_variants
      )
    )
  )
}

fn target_semantic_decl_surface_enum_generic(
  name: Symbol,
  decoration_lines: List<TargetSemanticDeclDecorationLine>,
  params: List<Symbol>,
  variants: List<Node>,
  enum_name_after_variants: Bool
) -> Node {
  if enum_name_after_variants {
    target_semantic_decl_surface_conj(
      children: list_append(
        left: list_append(
          left: target_semantic_decl_surface_decoration_pos_edges(lines: decoration_lines),
          right: [
            target_semantic_decl_surface_pos(
              target: target_semantic_decl_surface_generic_params(params: params)
            )
          ]
        ),
        right: target_semantic_decl_surface_enum_name_variant_edges(
          name: name,
          variants: variants,
          enum_name_after_variants: true
        )
      )
    )
  } else {
    target_semantic_decl_surface_conj(
      children: list_append(
        left: target_semantic_decl_surface_decoration_pos_edges(lines: decoration_lines),
        right: [
          target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: name)),
          target_semantic_decl_surface_pos(
            target: target_semantic_decl_surface_generic_params(params: params)
          ),
          target_semantic_decl_surface_pos(
            target: target_semantic_decl_surface_variant_block(variants: variants)
          )
        ]
      )
    )
  }
}

fn target_semantic_decl_surface_union_member_payload(
  name: Symbol,
  fields: List<Node>
) -> Node {
  target_semantic_decl_surface_conj(
    children: [
      target_semantic_decl_surface_pos(
        target: target_semantic_decl_surface_cons_list(items: fields)
      ),
      target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: name))
    ]
  )
}

fn target_semantic_decl_surface_tagged_union_union_body(
  variants: List<Node>,
  union_field: Symbol
) -> Node {
  target_semantic_decl_surface_conj(
    children: [
      target_semantic_decl_surface_pos(
        target: target_semantic_decl_surface_cons_list(items: variants)
      ),
      target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: union_field))
    ]
  )
}

fn target_semantic_decl_surface_tagged_union_union_field(
  variants: List<Node>,
  union_field: Symbol
) -> Node {
  target_semantic_decl_surface_conj(
    children: [
      target_semantic_decl_surface_pos(
        target: target_semantic_decl_surface_tagged_union_union_body(
          variants: variants,
          union_field: union_field
        )
      )
    ]
  )
}

fn target_semantic_decl_surface_tagged_union_body_fields(
  projection: TargetSemanticDeclSurfaceProjection,
  variants: List<Node>
) -> List<Node> {
  match projection.coproduct_layout {
    TargetSemanticDeclCoproductTaggedUnionSurface { tag_field: tag_field, union_field: union_field } =>
      [
        target_semantic_decl_surface_field(
          name: tag_field,
          t: ^Int,
          type_before_name: projection.field_type_before_name,
          type_expr_field_scope: projection.type_expr_field_scope
        ),
        target_semantic_decl_surface_tagged_union_union_field(
          variants: variants,
          union_field: union_field
        )
      ]
    TargetSemanticDeclCoproductEnumSurface => Empty
  }
}

fn target_semantic_decl_surface_tagged_union_nongeneric(
  name: Symbol,
  decoration_lines: List<TargetSemanticDeclDecorationLine>,
  projection: TargetSemanticDeclSurfaceProjection,
  variants: List<Node>
) -> Node {
  target_semantic_decl_surface_conj(
    children: list_append(
      left: target_semantic_decl_surface_decoration_pos_edges(lines: decoration_lines),
      right: target_semantic_decl_surface_struct_name_field_edges(
        name: name,
        fields: target_semantic_decl_surface_tagged_union_body_fields(
          projection: projection,
          variants: variants
        ),
        body_edges: Empty,
        struct_typedef_name_after_fields: projection.struct_typedef_name_after_fields
      )
    )
  )
}

fn target_semantic_decl_surface_variant_nullary(name: Symbol) -> Node {
  target_semantic_decl_surface_conj(
    children: [ target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: name)) ]
  )
}

fn target_semantic_decl_surface_variant_block(variants: List<Node>) -> Node {
  target_semantic_decl_surface_conj(
    children: [
      target_semantic_decl_surface_pos(
        target: target_semantic_decl_surface_cons_list(items: variants)
      )
    ]
  )
}

fn target_semantic_decl_surface_variant_payload(name: Symbol, fields: List<Node>) -> Node {
  target_semantic_decl_surface_conj(
    children: [
      target_semantic_decl_surface_pos(target: target_semantic_decl_surface_atom(id: name)),
      target_semantic_decl_surface_pos(target: target_semantic_decl_surface_field_block(fields: fields))
    ]
  )
}

fn target_semantic_decl_surface_generic_params(params: List<Symbol>) -> Node {
  target_semantic_decl_surface_conj(
    children: [
      target_semantic_decl_surface_pos(
        target: target_semantic_decl_surface_cons_list(
          items: fold_list(
            xs: params,
            empty: Empty,
            cons: fn(acc, p) { list_snoc_item(xs: acc, item: target_semantic_decl_surface_atom(id: p)) }
          )
        )
      )
    ]
  )
}

data target_semantic_decl_shape_predicate_dissolution_note: String = "DISSOLVED 2026-07-24 (silent-badger-23): nullary/payload coproduct variant walk consolidated onto v2.std.compilers.coproduct_variant_shape (single authority)."

data target_semantic_decl_shape_predicate_dissolve_on: DissolutionCondition = unbound_dissolution(description: "Remaining dissolve-on: decoration rules key on typed surface facts from the bundle authority, not ad-hoc Conj-child heuristics at call sites.")

fn semantic_decl_coproduct_shape_key_unsupported_connective_diagnostic(
  coproduct: Node
) -> Diagnostic {
  Diagnostic {
    reason: ^semantic_decl_coproduct_shape_key_unsupported_connective,
    at: node_locus(node: coproduct),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_semantic_decl_coproduct_shape_key(coproduct: Node) -> Outcome<Symbol> {
  match coproduct.kind {
    TypeNode { connective: Disj } =>
      if coproduct_all_variants_nullary(edges: coproduct.children) {
        outcome_accepted(value: ^semantic_decl_coproduct_shape_all_variants_nullary)
      } else {
        outcome_accepted(value: ^semantic_decl_coproduct_shape_default)
      }
    TypeNode { connective: Atom { identity: _ } } => target_semantic_decl_coproduct_shape_key_otherwise(coproduct: coproduct)
    TypeNode { connective: Conj } => target_semantic_decl_coproduct_shape_key_otherwise(coproduct: coproduct)
    TypeNode { connective: Arrow } => target_semantic_decl_coproduct_shape_key_otherwise(coproduct: coproduct)
    TypeNode { connective: Instantiation } => target_semantic_decl_coproduct_shape_key_otherwise(coproduct: coproduct)
    ComputationNode { behavior: _ } => target_semantic_decl_coproduct_shape_key_otherwise(coproduct: coproduct)
  }
}

fn target_semantic_decl_coproduct_shape_key_otherwise(coproduct: Node) -> Outcome<Symbol> {
  outcome_rejected(
    d: semantic_decl_coproduct_shape_key_unsupported_connective_diagnostic(coproduct: coproduct)
  )
}

fn target_semantic_decl_coproduct_rule_decoration_lines_if_shape(
  rule: TargetSemanticDeclCoproductDecorationRule,
  wanted_shape: Symbol,
  acc: List<TargetSemanticDeclDecorationLine>
) -> List<TargetSemanticDeclDecorationLine> {
  if is_empty(xs: acc) && rule.shape_key == wanted_shape {
    rule.decoration_lines
  } else {
    acc
  }
}

fn target_semantic_decl_decoration_lines_for_shape(
  rules: List<TargetSemanticDeclCoproductDecorationRule>,
  shape_key: Symbol
) -> List<TargetSemanticDeclDecorationLine> {
  fold_list(
    xs: rules,
    empty: Empty,
    cons: fn(acc, rule) {
      target_semantic_decl_coproduct_rule_decoration_lines_if_shape(
        rule: rule,
        wanted_shape: shape_key,
        acc: acc
      )
    }
  )
}

fn semantic_decl_coproduct_decoration_shape_unmatched_diagnostic(
  coproduct: Node,
  shape_key: Symbol
) -> Diagnostic {
  Diagnostic {
    reason: ^semantic_decl_coproduct_decoration_shape_unmatched,
    at: node_locus(node: coproduct),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_semantic_decl_coproduct_rule_matches_shape(
  rule: TargetSemanticDeclCoproductDecorationRule,
  shape_key: Symbol
) -> Bool {
  rule.shape_key == shape_key
}

fn target_semantic_decl_coproduct_has_shape_rule(
  rules: List<TargetSemanticDeclCoproductDecorationRule>,
  shape_key: Symbol
) -> Bool {
  fold_list(
    xs: rules,
    empty: false,
    cons: fn(acc, rule) {
      if acc {
        true
      } else {
        target_semantic_decl_coproduct_rule_matches_shape(rule: rule, shape_key: shape_key)
      }
    }
  )
}

fn target_semantic_decl_coproduct_decoration_lines(
  projection: TargetSemanticDeclSurfaceProjection,
  coproduct: Node
) -> Outcome<List<TargetSemanticDeclDecorationLine>> {
  if is_empty(xs: projection.coproduct_decoration_rules) {
    outcome_accepted(value: Empty)
  } else {
    bind_outcome(
      o: target_semantic_decl_coproduct_shape_key(coproduct: coproduct),
      f: fn(shape_key) {
        if target_semantic_decl_coproduct_has_shape_rule(
          rules: projection.coproduct_decoration_rules,
          shape_key: shape_key
        ) {
          outcome_accepted(
            value: target_semantic_decl_decoration_lines_for_shape(
              rules: projection.coproduct_decoration_rules,
              shape_key: shape_key
            )
          )
        } else {
          outcome_rejected(d: semantic_decl_coproduct_decoration_shape_unmatched_diagnostic(
                coproduct: coproduct,
                shape_key: shape_key)
          )
        }
      }
    )
  }
}
fn target_semantic_decl_field_surfaces(
  edges: List<Edge>,
  projection: TargetSemanticDeclSurfaceProjection,
  type_binding: fn(Node) -> Outcome<Symbol>
) -> Outcome<List<Node>> {
  fold_list(
    xs: edges,
    empty: outcome_accepted(value: Empty),
    cons: fn(acc_o, edge) {
      bind_outcome(
        o: acc_o,
        f: fn(acc) {
          bind_outcome(
            o: target_semantic_decl_field_surface_from_edge(
              edge: edge,
              projection: projection,
              type_binding: type_binding
            ),
            f: fn(fnode) {
              outcome_accepted(value: list_snoc_item(xs: acc, item: fnode))
            }
          )
        }
      )
    }
  )
}

fn target_semantic_decl_tagged_union_variant_surface_from_edge(
  edge: Edge,
  projection: TargetSemanticDeclSurfaceProjection,
  type_binding: fn(Node) -> Outcome<Symbol>
) -> Outcome<Node> {
  match edge.label {
    Authored { name: vname } =>
      if coproduct_variant_edge_has_payload(edge: edge) {
        bind_outcome(
          o: target_semantic_decl_field_surfaces(
            edges: edge.target.children,
            projection: projection,
            type_binding: type_binding
          ),
          f: fn(fields) {
            outcome_accepted(
              value: target_semantic_decl_surface_union_member_payload(
                name: vname,
                fields: fields
              )
            )
          }
        )
      } else {
        outcome_accepted(value: target_semantic_decl_surface_variant_nullary(name: vname))
      }
    StructuralLabel { label: _ } =>
      outcome_rejected(d: Diagnostic {
            reason: ^target_semantic_decl_variant_not_named,
            at: node_locus(node: edge.target),
            correction: Unavailable { reason: ExternalContractUnknown }
          })
    Positional =>
      outcome_rejected(d: Diagnostic {
            reason: ^target_semantic_decl_variant_not_named,
            at: node_locus(node: edge.target),
            correction: Unavailable { reason: ExternalContractUnknown }
          })
  }
}

fn target_semantic_decl_tagged_union_variant_surfaces(
  edges: List<Edge>,
  projection: TargetSemanticDeclSurfaceProjection,
  type_binding: fn(Node) -> Outcome<Symbol>
) -> Outcome<List<Node>> {
  fold_list(
    xs: edges,
    empty: outcome_accepted(value: Empty),
    cons: fn(acc_o, edge) {
      bind_outcome(
        o: acc_o,
        f: fn(acc) {
          bind_outcome(
            o: target_semantic_decl_tagged_union_variant_surface_from_edge(
              edge: edge,
              projection: projection,
              type_binding: type_binding
            ),
            f: fn(vnode) {
              outcome_accepted(value: list_snoc_item(xs: acc, item: vnode))
            }
          )
        }
      )
    }
  )
}

fn target_semantic_decl_variant_surface_from_edge(
  edge: Edge,
  projection: TargetSemanticDeclSurfaceProjection,
  type_binding: fn(Node) -> Outcome<Symbol>
) -> Outcome<Node> {
  match edge.label {
    Authored { name: vname } =>
      if coproduct_variant_edge_has_payload(edge: edge) {
        bind_outcome(
          o: target_semantic_decl_field_surfaces(
            edges: edge.target.children,
            projection: projection,
            type_binding: type_binding
          ),
          f: fn(fields) {
            outcome_accepted(
              value: target_semantic_decl_surface_variant_payload(name: vname, fields: fields)
            )
          }
        )
      } else {
        outcome_accepted(value: target_semantic_decl_surface_variant_nullary(name: vname))
      }
    StructuralLabel { label: _ } =>
      outcome_rejected(d: Diagnostic {
            reason: ^target_semantic_decl_variant_not_named,
            at: node_locus(node: edge.target),
            correction: Unavailable { reason: ExternalContractUnknown }
          })
    Positional =>
      outcome_rejected(d: Diagnostic {
            reason: ^target_semantic_decl_variant_not_named,
            at: node_locus(node: edge.target),
            correction: Unavailable { reason: ExternalContractUnknown }
          })
  }
}

fn target_semantic_decl_variant_surfaces(
  edges: List<Edge>,
  projection: TargetSemanticDeclSurfaceProjection,
  type_binding: fn(Node) -> Outcome<Symbol>
) -> Outcome<List<Node>> {
  fold_list(
    xs: edges,
    empty: outcome_accepted(value: Empty),
    cons: fn(acc_o, edge) {
      bind_outcome(
        o: acc_o,
        f: fn(acc) {
          bind_outcome(
            o: target_semantic_decl_variant_surface_from_edge(
              edge: edge,
              projection: projection,
              type_binding: type_binding
            ),
            f: fn(vnode) {
              outcome_accepted(value: list_snoc_item(xs: acc, item: vnode))
            }
          )
        }
      )
    }
  )
}

fn target_semantic_decl_coproduct_uses_tagged_union_layout(
  layout: TargetSemanticDeclCoproductSurfaceLayout
) -> Bool {
  match layout {
    TargetSemanticDeclCoproductTaggedUnionSurface { tag_field: _, union_field: _ } => true
    TargetSemanticDeclCoproductEnumSurface => false
  }
}

fn target_semantic_decl_variant_surfaces_for_coproduct(
  projection: TargetSemanticDeclSurfaceProjection,
  coproduct: Node,
  type_binding: fn(Node) -> Outcome<Symbol>
) -> Outcome<List<Node>> {
  if target_semantic_decl_coproduct_uses_tagged_union_layout(layout: projection.coproduct_layout)
    && !coproduct_all_variants_nullary(edges: coproduct.children)
  {
    target_semantic_decl_tagged_union_variant_surfaces(
      edges: coproduct.children,
      projection: projection,
      type_binding: type_binding
    )
  } else {
    target_semantic_decl_variant_surfaces(
      edges: coproduct.children,
      projection: projection,
      type_binding: type_binding
    )
  }
}

// A GENERIC DECLARATION IS REFUSED BEFORE ANY FIELD OR VARIANT IS PROJECTED. Handed a generic type
// declaration's target -- the v2.std.type_binder wrapper -- these surfaces read it through the typed
// view and refuse, because the `params` they render are the caller's, not the declaration's. Refusing with the translator's own reason
// (v2.compiler.translate translate_type_expression_project) keeps one refusal for one missing
// capability: a target grammar row rendering the member's binder roster.
fn semantic_decl_generic_member_not_rendered_diagnostic(member: Node) -> Diagnostic {
  Diagnostic {
    reason: ^translate_reason_generic_type_decl_not_rendered,
    at: node_locus(node: member),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

// AN ALIAS OR BODYLESS DECLARATION IS NOT A MEMBER, whatever its binder count: it declares no field or
// variant for a struct or enum surface to project. It is refused here under its own reason rather than
// the generic-declaration one, which would be false for a zero-binder alias
// (v2.std.type_binder TypeAlias / OpaqueTypeDecl are cardinality-neutral).
fn semantic_decl_not_a_member_diagnostic(decl: Node) -> Diagnostic {
  Diagnostic {
    reason: ^semantic_decl_reason_alias_or_opaque_is_not_a_member,
    at: node_locus(node: decl),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_semantic_enum_surface_from_coproduct(
  projection: TargetSemanticDeclSurfaceProjection,
  name: Symbol,
  params: List<Symbol>,
  coproduct: Node,
  type_binding: fn(Node) -> Outcome<Symbol>
) -> Outcome<Node> {
  match type_decl_view(target: coproduct) {
    GenericTypeDecl { binders: _, member: _ } =>
      outcome_rejected(d: semantic_decl_generic_member_not_rendered_diagnostic(member: coproduct))
    TypeAlias { binders: _, aliased: _ } =>
      outcome_rejected(d: semantic_decl_not_a_member_diagnostic(decl: coproduct))
    OpaqueTypeDecl { binders: _ } =>
      outcome_rejected(d: semantic_decl_not_a_member_diagnostic(decl: coproduct))
    NotATypeDecl =>
      outcome_rejected(d: semantic_decl_not_a_member_diagnostic(decl: coproduct))
    PlainTypeDecl { member: m } =>
      target_semantic_enum_surface_from_coproduct_admitted(projection: projection, name: name, params: params, coproduct: m, type_binding: type_binding)
  }
}

fn target_semantic_enum_surface_from_coproduct_admitted(
  projection: TargetSemanticDeclSurfaceProjection,
  name: Symbol,
  params: List<Symbol>,
  coproduct: Node,
  type_binding: fn(Node) -> Outcome<Symbol>
) -> Outcome<Node> {
  match coproduct.kind {
    TypeNode { connective: Disj } =>
      bind_outcome(
        o: target_semantic_decl_coproduct_decoration_lines(
          projection: projection,
          coproduct: coproduct
        ),
        f: fn(decoration_lines) {
          bind_outcome(
            o: target_semantic_decl_variant_surfaces_for_coproduct(
              projection: projection,
              coproduct: coproduct,
              type_binding: type_binding
            ),
            f: fn(variants) {
              if target_semantic_decl_coproduct_uses_tagged_union_layout(
                    layout: projection.coproduct_layout
                  )
                && !coproduct_all_variants_nullary(edges: coproduct.children)
              {
                if is_empty(xs: params) {
                  outcome_accepted(
                    value: target_semantic_decl_surface_tagged_union_nongeneric(
                      name: name,
                      decoration_lines: decoration_lines,
                      projection: projection,
                      variants: variants
                    )
                  )
                } else {
                  outcome_rejected(d: Diagnostic {
                        reason: ^target_semantic_decl_tagged_union_generic_unsupported,
                        at: node_locus(node: coproduct),
                        correction: Unavailable { reason: ExternalContractUnknown }
                      })
                }
              } else if is_empty(xs: params) {
                outcome_accepted(
                  value: target_semantic_decl_surface_enum_nongeneric(
                    name: name,
                    decoration_lines: decoration_lines,
                    variants: variants,
                    enum_name_after_variants: projection.enum_name_after_variants
                  )
                )
              } else {
                outcome_accepted(
                  value: target_semantic_decl_surface_enum_generic(
                    name: name,
                    decoration_lines: decoration_lines,
                    params: params,
                    variants: variants,
                    enum_name_after_variants: projection.enum_name_after_variants
                  )
                )
              }
            }
          )
        }
      )
    TypeNode { connective: Atom { identity: _ } } => target_semantic_enum_surface_from_coproduct_admitted_otherwise(coproduct: coproduct)
    TypeNode { connective: Conj } => target_semantic_enum_surface_from_coproduct_admitted_otherwise(coproduct: coproduct)
    TypeNode { connective: Arrow } => target_semantic_enum_surface_from_coproduct_admitted_otherwise(coproduct: coproduct)
    TypeNode { connective: Instantiation } => target_semantic_enum_surface_from_coproduct_admitted_otherwise(coproduct: coproduct)
    ComputationNode { behavior: _ } => target_semantic_enum_surface_from_coproduct_admitted_otherwise(coproduct: coproduct)
  }
}

fn target_semantic_enum_surface_from_coproduct_admitted_otherwise(coproduct: Node) -> Outcome<Node> {
  outcome_rejected(d: Diagnostic {
        reason: ^target_semantic_decl_enum_source_not_coproduct,
        at: node_locus(node: coproduct),
        correction: Unavailable { reason: ExternalContractUnknown }
      })
}

fn target_semantic_struct_surface_from_record(
  projection: TargetSemanticDeclSurfaceProjection,
  name: Symbol,
  params: List<Symbol>,
  record: Node,
  members: List<TargetSemanticDeclMember>,
  type_binding: fn(Node) -> Outcome<Symbol>
) -> Outcome<Node> {
  match type_decl_view(target: record) {
    GenericTypeDecl { binders: _, member: _ } =>
      outcome_rejected(d: semantic_decl_generic_member_not_rendered_diagnostic(member: record))
    TypeAlias { binders: _, aliased: _ } =>
      outcome_rejected(d: semantic_decl_not_a_member_diagnostic(decl: record))
    OpaqueTypeDecl { binders: _ } =>
      outcome_rejected(d: semantic_decl_not_a_member_diagnostic(decl: record))
    NotATypeDecl =>
      outcome_rejected(d: semantic_decl_not_a_member_diagnostic(decl: record))
    PlainTypeDecl { member: m } =>
      target_semantic_struct_surface_from_record_admitted(projection: projection, name: name, params: params, record: m, members: members, type_binding: type_binding)
  }
}

fn target_semantic_struct_surface_from_record_admitted(
  projection: TargetSemanticDeclSurfaceProjection,
  name: Symbol,
  params: List<Symbol>,
  record: Node,
  members: List<TargetSemanticDeclMember>,
  type_binding: fn(Node) -> Outcome<Symbol>
) -> Outcome<Node> {
  match record.kind {
    TypeNode { connective: Conj } =>
      bind_outcome(
        o: target_semantic_decl_field_surfaces(
          edges: record.children,
          projection: projection,
          type_binding: type_binding
        ),
        f: fn(fields) {
        bind_outcome(
        o: target_semantic_decl_member_edges(projection: projection, name: name, members: members, inside_body: true, at: record),
        f: fn(body_member_edges) {
        bind_outcome(
        o: target_semantic_decl_member_edges(projection: projection, name: name, members: members, inside_body: false, at: record),
        f: fn(trailing_member_edges) {
          if is_empty(xs: params) {
            outcome_accepted(
              value: target_semantic_decl_surface_struct_nongeneric(
                name: name,
                decoration_lines: projection.record_decoration_lines,
                fields: fields,
                body_member_edges: body_member_edges,
                trailing_member_edges: trailing_member_edges,
                struct_typedef_name_after_fields: projection.struct_typedef_name_after_fields
              )
            )
          } else if !is_empty(xs: members) {
            outcome_rejected(d: Diagnostic {
                  reason: ^target_semantic_decl_members_on_generic_unsupported,
                  at: node_locus(node: record),
                  correction: Unavailable { reason: ExternalContractUnknown }
                })
          } else {
            if projection.struct_typedef_name_after_fields {
              outcome_rejected(d: Diagnostic {
                    reason: ^target_semantic_decl_struct_generic_unsupported,
                    at: node_locus(node: record),
                    correction: Unavailable { reason: ExternalContractUnknown }
                  })
            } else {
              outcome_accepted(
                value: target_semantic_decl_surface_struct_generic(
                  name: name,
                  decoration_lines: projection.record_decoration_lines,
                  params: params,
                  fields: fields
                )
              )
            }
          }
        }
        )
        }
        )
        }
      )
    TypeNode { connective: Atom { identity: _ } } => target_semantic_struct_surface_from_record_admitted_otherwise(record: record)
    TypeNode { connective: Disj } => target_semantic_struct_surface_from_record_admitted_otherwise(record: record)
    TypeNode { connective: Arrow } => target_semantic_struct_surface_from_record_admitted_otherwise(record: record)
    TypeNode { connective: Instantiation } => target_semantic_struct_surface_from_record_admitted_otherwise(record: record)
    ComputationNode { behavior: _ } => target_semantic_struct_surface_from_record_admitted_otherwise(record: record)
  }
}

fn target_semantic_struct_surface_from_record_admitted_otherwise(record: Node) -> Outcome<Node> {
  outcome_rejected(d: Diagnostic {
        reason: ^target_semantic_decl_struct_source_not_record,
        at: node_locus(node: record),
        correction: Unavailable { reason: ExternalContractUnknown }
      })
}
