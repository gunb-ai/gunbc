module v2.std.compilers.compilation_unit

import std.algebra { Empty }
import std.types { ContentHash, NonEmptyStr, List, Bool, String, Int }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.disposition { SingleAuthority }
import v2.lens.common.construction_justification { ConstructionJustification, WallNow }
import v2.std.algebra { any, fold_list, length }
import v2.std.collection { Absent, Optional, Present, map_get, optional_present }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Symbol,
  TypeNode,
  content_hash,
  node_subtree_nodes,
  node_synthetic,
}

type ModuleId = NonEmptyStr where brand("ModuleId")
type CompilationUnitId = ContentHash where brand("CompilationUnitId")
type CompilationUnitArtifactId = ContentHash where brand("CompilationUnitArtifactId")

type PartitionProvenance
  = HandExplicit
  | PolicyDerived { policy: DeclarationRef }

type ModuleDagEdge {
  from: ModuleId
  to: ModuleId
}

type ModuleDag {
  modules: List<ModuleId>
  edges: List<ModuleDagEdge>
  exports: Map<ModuleId, List<Node>>
  type_definitions: Map<ModuleId, List<Node>>
}

type CompilationUnit {
  id: CompilationUnitId
  members: List<ModuleId>
  interface: List<Node>
  deps: List<CompilationUnitId>
  artifact: CompilationUnitArtifactId
}

type PartitionR4ValidityCause {
  tag: NonEmptyStr
  detail: String
}

type PartitionR4ValidityVerdict
  = PartitionR4Valid
  | PartitionR4Refused { cause: PartitionR4ValidityCause }

data compilation_unit_home_note: String = "Shared home for the agnostic unit of separate compilation and linkage (crate / translation-unit / package / assembly are target nicknames). partition_fold is the sole producer of interface + deps; members and artifact identity are inputs via the assignment map. interface carries declaration CONTENT as Node carriers (not name lists), including the transitive by-value type-definition closure needed to render cross-unit boundaries (Rust crate visibility, C header struct layout). Default: home supplies the full referenced-declaration set; each target R3 projects what it needs from that superset. R4 validity is an interface only — each target realization supplies validate_partition_r4."

data partition_interface_derivation_note: String = "interface derivation (partition_fold): (1) collect exported declaration Nodes from member modules referenced across the partition boundary; (2) close transitively under by-value type references — for each declaration, walk its type subtree for grounded type atoms and include the matching type-definition Nodes from member modules even when the type is not itself exported; (3) canonicalize as a set (dedupe by content_hash, sort by hash). Reference-only targets may project a subset at R3; the home default is full content + by-value type defs."

data partition_r4_validity_interface_note: String = "R4 validity interface (locked 2026-07-16, eager-ferret-110): realizations implement fn validate_partition_r4(module_dag: ModuleDag, assignment: Map<ModuleId, CompilationUnitId>, units: List<CompilationUnit>) -> PartitionR4ValidityVerdict. Rust realization refuses SCC-split and cyclic unit graphs; C realization is permissive on linkage cycles. The home exposes only PartitionR4ValidityVerdict + PartitionR4ValidityCause carriers — never a hardcoded acyclic check here."

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallNow {
    mechanism: SingleAuthority,
    authority: DeclarationRef {
      module_path: "v2.std.compilers.compilation_unit",
      decl_name: "partition_fold",
      field: WholeDeclaration,
    }
  }
}

fn partition_provenance_hand_explicit() -> PartitionProvenance {
  HandExplicit
}

fn partition_provenance_policy_derived(policy: DeclarationRef) -> PartitionProvenance {
  PolicyDerived { policy: policy }
}

fn partition_provenance_eq(left: PartitionProvenance, right: PartitionProvenance) -> Bool {
  match left {
    HandExplicit => match right {
      HandExplicit => true
      PolicyDerived { policy: _ } => false
    }
    PolicyDerived { policy: lp } => match right {
      HandExplicit => false
      PolicyDerived { policy: rp } =>
        (lp.module_path == rp.module_path)
          && (lp.decl_name == rp.decl_name)
    }
  }
}

fn partition_r4_validity_verdict_valid(verdict: PartitionR4ValidityVerdict) -> Bool {
  match verdict {
    PartitionR4Valid => true
    PartitionR4Refused { cause: _ } => false
  }
}

fn compilation_unit_artifact_id(unit_id: CompilationUnitId) -> CompilationUnitArtifactId {
  unit_id as CompilationUnitArtifactId
}

fn module_unit_id(
  assignment: Map<ModuleId, CompilationUnitId>,
  module: ModuleId
) -> Optional<CompilationUnitId> {
  match map_get(assignment, module) {
    Accepted { value: opt, diagnostics: _ } => opt
    Rejected { diagnostics: _ } => Absent
  }
}

fn module_in_unit(
  assignment: Map<ModuleId, CompilationUnitId>,
  module: ModuleId,
  unit_id: CompilationUnitId
) -> Bool {
  match module_unit_id(assignment: assignment, module: module) {
    Present { value: assigned } => assigned == unit_id
    Absent => false
  }
}

fn list_snoc_unique(items: List<CompilationUnitId>, item: CompilationUnitId) -> List<CompilationUnitId> {
  if any(xs: items, predicate: fn(id) { id == item }) {
    items
  } else {
    items |> list_push(item)
  }
}

fn list_snoc_unique_module(items: List<ModuleId>, item: ModuleId) -> List<ModuleId> {
  if any(xs: items, predicate: fn(id) { id == item }) {
    items
  } else {
    items |> list_push(item)
  }
}

fn list_snoc_unique_symbol(items: List<Symbol>, item: Symbol) -> List<Symbol> {
  if any(xs: items, predicate: fn(sym) { sym == item }) {
    items
  } else {
    items |> list_push(item)
  }
}

fn list_snoc_unique_node(items: List<Node>, item: Node) -> List<Node> {
  let item_hash = content_hash(n: item)
  if any(xs: items, predicate: fn(n) { content_hash(n: n) == item_hash }) {
    items
  } else {
    items |> list_push(item)
  }
}

fn list_unique_sorted_ids(items: List<CompilationUnitId>) -> List<CompilationUnitId> {
  items
    |> fold(init: [], f: fn(acc, item) { list_snoc_unique(items: acc, item: item) })
    |> sort_by(id => id)
}

fn node_sort_key(n: Node) -> ContentHash {
  content_hash(n: n)
}

fn list_unique_sorted_nodes(items: List<Node>) -> List<Node> {
  items
    |> fold(init: [], f: fn(acc, item) { list_snoc_unique_node(items: acc, item: item) })
    |> sort_by(node_sort_key)
}

fn module_list_from_map(
  module_dag: ModuleDag,
  module: ModuleId,
  field: Map<ModuleId, List<Node>>
) -> List<Node> {
  match map_get(field, module) {
    Accepted { value: opt, diagnostics: _ } =>
      match opt {
        Present { value: nodes } => nodes
        Absent => []
      }
    Rejected { diagnostics: _ } => []
  }
}

fn module_export_declarations(module_dag: ModuleDag, module: ModuleId) -> List<Node> {
  module_list_from_map(module_dag: module_dag, module: module, field: module_dag.exports)
}

fn module_type_definitions(module_dag: ModuleDag, module: ModuleId) -> List<Node> {
  module_list_from_map(module_dag: module_dag, module: module, field: module_dag.type_definitions)
}

fn type_definition_root_identity(defn: Node) -> Optional<Symbol> {
  match defn.kind {
    TypeNode { connective: Atom { identity: id } } => Present { value: id }
    _ => Absent
  }
}

fn type_atom_identity(node: Node) -> Optional<Symbol> {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } => Present { value: id }
    _ => Absent
  }
}

fn partition_unit_members(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>,
  unit_id: CompilationUnitId
) -> List<ModuleId> {
  module_dag.modules
    |> filter(module => module_in_unit(assignment: assignment, module: module, unit_id: unit_id))
    |> sort_by(module => module)
}

fn partition_unit_dep_from_edge(
  assignment: Map<ModuleId, CompilationUnitId>,
  unit_id: CompilationUnitId,
  edge: ModuleDagEdge
) -> Optional<CompilationUnitId> {
  if module_in_unit(assignment: assignment, module: edge.from, unit_id: unit_id)
    && !module_in_unit(assignment: assignment, module: edge.to, unit_id: unit_id) {
    module_unit_id(assignment: assignment, module: edge.to)
  } else {
    Absent
  }
}

fn partition_unit_deps(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>,
  unit_id: CompilationUnitId
) -> List<CompilationUnitId> {
  module_dag.edges
    |> fold(init: [], f: fn(acc, edge) {
      match partition_unit_dep_from_edge(assignment: assignment, unit_id: unit_id, edge: edge) {
        Present { value: dep } => list_snoc_unique(items: acc, item: dep)
        Absent => acc
      }
    })
    |> sort_by(id => id)
}

fn module_referenced_from_outside_unit(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>,
  unit_id: CompilationUnitId,
  member: ModuleId
) -> Bool {
  module_dag.edges |> any(edge =>
    (edge.to == member)
      && !module_in_unit(assignment: assignment, module: edge.from, unit_id: unit_id)
  )
}

fn partition_cross_boundary_exports_for_member(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>,
  unit_id: CompilationUnitId,
  member: ModuleId,
  acc: List<Node>
) -> List<Node> {
  if module_referenced_from_outside_unit(
    module_dag: module_dag,
    assignment: assignment,
    unit_id: unit_id,
    member: member
  ) {
    module_export_declarations(module_dag: module_dag, module: member)
      |> fold(init: acc, f: fn(inner, decl) { list_snoc_unique_node(items: inner, item: decl) })
  } else {
    acc
  }
}

fn partition_cross_boundary_exports(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>,
  unit_id: CompilationUnitId,
  members: List<ModuleId>
) -> List<Node> {
  members
    |> fold(init: [], f: fn(acc, member) {
      partition_cross_boundary_exports_for_member(
        module_dag: module_dag,
        assignment: assignment,
        unit_id: unit_id,
        member: member,
        acc: acc
      )
    })
}

fn type_atoms_in_declaration(declaration: Node) -> List<Symbol> {
  node_subtree_nodes(root: declaration)
    |> fold(init: [], f: fn(acc, node) {
      match type_atom_identity(node: node) {
        Present { value: sym } => list_snoc_unique_symbol(items: acc, item: sym)
        Absent => acc
      }
    })
    |> sort_by(sym => sym)
}

fn type_definition_for_identity_in_module(
  module_dag: ModuleDag,
  member: ModuleId,
  identity: Symbol
) -> Optional<Node> {
  fold_list(
    xs: module_type_definitions(module_dag: module_dag, module: member),
    empty: Absent,
    cons: fn(acc, defn) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match type_definition_root_identity(defn: defn) {
            Present { value: id } =>
              if id == identity {
                optional_present(value: defn)
              } else {
                Absent
              }
            Absent => Absent
          }
      }
    }
  )
}

fn type_definition_for_identity_in_members(
  module_dag: ModuleDag,
  members: List<ModuleId>,
  identity: Symbol
) -> Optional<Node> {
  fold_list(
    xs: members,
    empty: Absent,
    cons: fn(acc, member) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          type_definition_for_identity_in_module(
            module_dag: module_dag,
            member: member,
            identity: identity
          )
      }
    }
  )
}

fn partition_interface_closure_grow_once(
  seeds: List<Node>,
  module_dag: ModuleDag,
  members: List<ModuleId>
) -> List<Node> {
  seeds
    |> fold(init: seeds, f: fn(acc, declaration) {
      type_atoms_in_declaration(declaration: declaration)
        |> fold(init: acc, f: fn(inner, sym) {
          match type_definition_for_identity_in_members(
            module_dag: module_dag,
            members: members,
            identity: sym
          ) {
            Present { value: defn } => list_snoc_unique_node(items: inner, item: defn)
            Absent => inner
          }
        })
    })
}

fn partition_interface_closure_fixpoint(
  seeds: List<Node>,
  module_dag: ModuleDag,
  members: List<ModuleId>,
  depth: Int
) -> List<Node> {
  if depth <= 0 {
    list_unique_sorted_nodes(items: seeds)
  } else {
    let grown = partition_interface_closure_grow_once(
      seeds: seeds,
      module_dag: module_dag,
      members: members
    )
    if length(xs: grown) == length(xs: seeds) {
      list_unique_sorted_nodes(items: grown)
    } else {
      partition_interface_closure_fixpoint(
        seeds: grown,
        module_dag: module_dag,
        members: members,
        depth: depth - 1
      )
    }
  }
}

fn partition_unit_interface(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>,
  unit_id: CompilationUnitId,
  members: List<ModuleId>
) -> List<Node> {
  let seeds = partition_cross_boundary_exports(
    module_dag: module_dag,
    assignment: assignment,
    unit_id: unit_id,
    members: members
  )
  partition_interface_closure_fixpoint(
    seeds: seeds,
    module_dag: module_dag,
    members: members,
    depth: 16
  )
}

fn compilation_unit_from_partition(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>,
  unit_id: CompilationUnitId
) -> CompilationUnit {
  let members = partition_unit_members(
    module_dag: module_dag,
    assignment: assignment,
    unit_id: unit_id
  )
  CompilationUnit {
    id: unit_id
    members: members
    interface: partition_unit_interface(
      module_dag: module_dag,
      assignment: assignment,
      unit_id: unit_id,
      members: members
    )
    deps: partition_unit_deps(
      module_dag: module_dag,
      assignment: assignment,
      unit_id: unit_id
    )
    artifact: compilation_unit_artifact_id(unit_id: unit_id)
  }
}

fn partition_fold(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>
) -> List<CompilationUnit> {
  list_unique_sorted_ids(items: assignment |> map_values)
    |> map(unit_id =>
      compilation_unit_from_partition(
        module_dag: module_dag,
        assignment: assignment,
        unit_id: unit_id
      )
    )
}

fn partition_boundary_dep_targets(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>,
  unit_id: CompilationUnitId
) -> List<CompilationUnitId> {
  partition_unit_deps(
    module_dag: module_dag,
    assignment: assignment,
    unit_id: unit_id
  )
}

fn partition_unit_by_id(
  units: List<CompilationUnit>,
  unit_id: CompilationUnitId
) -> Optional<CompilationUnit> {
  match units |> filter(unit => unit.id == unit_id) |> first {
    Present { value: unit } => Present { value: unit }
    Absent => Absent
  }
}

fn partition_fold_deps_match_boundary_edges(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>
) -> Bool {
  let units = partition_fold(module_dag: module_dag, assignment: assignment)
  list_unique_sorted_ids(items: assignment |> map_values)
    |> fold(init: true, f: fn(ok, unit_id) {
      if !ok {
        false
      } else {
        match partition_unit_by_id(units: units, unit_id: unit_id) {
          Present { value: unit } => {
            let expected = partition_boundary_dep_targets(
              module_dag: module_dag,
              assignment: assignment,
              unit_id: unit_id
            )
            unit.deps == expected
          }
          Absent => false
        }
      }
    })
}

fn partition_interface_contains_node(interface: List<Node>, needle: Node) -> Bool {
  let needle_hash = content_hash(n: needle)
  any(xs: interface, predicate: fn(n) { content_hash(n: n) == needle_hash })
}
