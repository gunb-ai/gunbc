module v2.std.compilers.compilation_unit

import std.types { ContentHash, NonEmptyStr, List, Bool, String }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.interface_summary { InterfaceSummary, ExportEntry }
import std.disposition { SingleAuthority }
import v2.lens.common.construction_justification { ConstructionJustification, WallNow }
import v2.std.algebra { any }
import v2.std.collection { Absent, Optional, Present, map_get }
import v2.std.diagnostic { Accepted, Rejected }

type ModuleId = NonEmptyStr where brand("ModuleId")
type CompilationUnitId = ContentHash where brand("CompilationUnitId")
type CompilationUnitArtifactId = ContentHash where brand("CompilationUnitArtifactId")

type PartitionProvenance
  = HandExplicit
  | PolicyDerived { policy: DeclarationRef }

type ModuleDagEdge {
  from: ModuleId
  to: ModuleId
}

type ModuleDag {
  modules: List<ModuleId>
  edges: List<ModuleDagEdge>
  interfaces: Map<ModuleId, InterfaceSummary>
}

type CompilationUnit {
  id: CompilationUnitId
  members: List<ModuleId>
  interface: List<ExportEntry>
  deps: List<CompilationUnitId>
  artifact: CompilationUnitArtifactId
}

type PartitionR4ValidityCause {
  tag: NonEmptyStr
  detail: String
}

type PartitionR4ValidityVerdict
  = PartitionR4Valid
  | PartitionR4Refused { cause: PartitionR4ValidityCause }

data compilation_unit_home_note: String = "Shared home for the agnostic unit of separate compilation and linkage (crate / translation-unit / package / assembly are target nicknames). partition_fold is the sole producer of interface + deps; members and artifact identity are inputs via the assignment map. R4 validity is an interface only — each target realization supplies validate_partition_r4; this module never bakes acyclicity or SCC policy."

data partition_r4_validity_interface_note: String = "R4 validity interface (locked 2026-07-16, eager-ferret-110): realizations implement fn validate_partition_r4(module_dag: ModuleDag, assignment: Map<ModuleId, CompilationUnitId>, units: List<CompilationUnit>) -> PartitionR4ValidityVerdict. Rust realization refuses SCC-split and cyclic unit graphs; C realization is permissive on linkage cycles. The home exposes only PartitionR4ValidityVerdict + PartitionR4ValidityCause carriers — never a hardcoded acyclic check here."

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallNow {
    mechanism: SingleAuthority,
    authority: DeclarationRef {
      module_path: "v2.std.compilers.compilation_unit",
      decl_name: "partition_fold",
      field: WholeDeclaration,
    }
  }
}

fn partition_provenance_hand_explicit() -> PartitionProvenance {
  HandExplicit
}

fn partition_provenance_policy_derived(policy: DeclarationRef) -> PartitionProvenance {
  PolicyDerived { policy: policy }
}

fn partition_provenance_eq(left: PartitionProvenance, right: PartitionProvenance) -> Bool {
  match left {
    HandExplicit => match right {
      HandExplicit => true
      PolicyDerived { policy: _ } => false
    }
    PolicyDerived { policy: lp } => match right {
      HandExplicit => false
      PolicyDerived { policy: rp } =>
        (lp.module_path == rp.module_path)
          && (lp.decl_name == rp.decl_name)
    }
  }
}

fn partition_r4_validity_verdict_valid(verdict: PartitionR4ValidityVerdict) -> Bool {
  match verdict {
    PartitionR4Valid => true
    PartitionR4Refused { cause: _ } => false
  }
}

fn compilation_unit_artifact_id(unit_id: CompilationUnitId) -> CompilationUnitArtifactId {
  unit_id as CompilationUnitArtifactId
}

fn module_unit_id(
  assignment: Map<ModuleId, CompilationUnitId>,
  module: ModuleId
) -> Optional<CompilationUnitId> {
  match map_get(assignment, module) {
    Accepted { value: opt, diagnostics: _ } => opt
    Rejected { diagnostics: _ } => Absent
  }
}

fn module_in_unit(
  assignment: Map<ModuleId, CompilationUnitId>,
  module: ModuleId,
  unit_id: CompilationUnitId
) -> Bool {
  match module_unit_id(assignment: assignment, module: module) {
    Present { value: assigned } => assigned == unit_id
    Absent => false
  }
}

fn list_snoc_unique(items: List<CompilationUnitId>, item: CompilationUnitId) -> List<CompilationUnitId> {
  if any(xs: items, predicate: fn(id) { id == item }) {
    items
  } else {
    items |> list_push(item)
  }
}

fn list_snoc_unique_module(items: List<ModuleId>, item: ModuleId) -> List<ModuleId> {
  if any(xs: items, predicate: fn(id) { id == item }) {
    items
  } else {
    items |> list_push(item)
  }
}

fn list_snoc_unique_export(items: List<ExportEntry>, item: ExportEntry) -> List<ExportEntry> {
  if any(xs: items, predicate: fn(entry) { entry.name == item.name }) {
    items
  } else {
    items |> list_push(item)
  }
}

fn list_unique_sorted_ids(items: List<CompilationUnitId>) -> List<CompilationUnitId> {
  items
    |> fold(init: [], f: fn(acc, item) { list_snoc_unique(items: acc, item: item) })
    |> sort_by(id => id)
}

fn partition_unit_members(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>,
  unit_id: CompilationUnitId
) -> List<ModuleId> {
  module_dag.modules
    |> filter(module => module_in_unit(assignment: assignment, module: module, unit_id: unit_id))
    |> sort_by(module => module)
}

fn partition_unit_dep_from_edge(
  assignment: Map<ModuleId, CompilationUnitId>,
  unit_id: CompilationUnitId,
  edge: ModuleDagEdge
) -> Optional<CompilationUnitId> {
  if module_in_unit(assignment: assignment, module: edge.from, unit_id: unit_id)
    && !module_in_unit(assignment: assignment, module: edge.to, unit_id: unit_id) {
    module_unit_id(assignment: assignment, module: edge.to)
  } else {
    Absent
  }
}

fn partition_unit_deps(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>,
  unit_id: CompilationUnitId
) -> List<CompilationUnitId> {
  module_dag.edges
    |> fold(init: [], f: fn(acc, edge) {
      match partition_unit_dep_from_edge(assignment: assignment, unit_id: unit_id, edge: edge) {
        Present { value: dep } => list_snoc_unique(items: acc, item: dep)
        Absent => acc
      }
    })
    |> sort_by(id => id)
}

fn module_interface_exports(
  module_dag: ModuleDag,
  module: ModuleId
) -> List<ExportEntry> {
  match map_get(module_dag.interfaces, module) {
    Accepted { value: opt, diagnostics: _ } =>
      match opt {
        Present { value: summary } => summary.exports
        Absent => []
      }
    Rejected { diagnostics: _ } => []
  }
}

fn export_entry_sort_key(entry: ExportEntry) -> NonEmptyStr {
  entry.name
}

fn export_referenced_from_outside_unit(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>,
  unit_id: CompilationUnitId,
  member: ModuleId
) -> Bool {
  module_dag.edges |> any(edge =>
    (edge.to == member)
      && !module_in_unit(assignment: assignment, module: edge.from, unit_id: unit_id)
  )
}

fn partition_unit_interface_exports_for_member(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>,
  unit_id: CompilationUnitId,
  member: ModuleId,
  acc: List<ExportEntry>
) -> List<ExportEntry> {
  module_interface_exports(module_dag: module_dag, module: member)
    |> fold(init: acc, f: fn(inner, export_entry) {
      if export_referenced_from_outside_unit(
        module_dag: module_dag,
        assignment: assignment,
        unit_id: unit_id,
        member: member
      ) {
        list_snoc_unique_export(items: inner, item: export_entry)
      } else {
        inner
      }
    })
}

fn partition_unit_interface(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>,
  unit_id: CompilationUnitId,
  members: List<ModuleId>
) -> List<ExportEntry> {
  members
    |> fold(init: [], f: fn(acc, member) {
      partition_unit_interface_exports_for_member(
        module_dag: module_dag,
        assignment: assignment,
        unit_id: unit_id,
        member: member,
        acc: acc
      )
    })
    |> sort_by(export_entry_sort_key)
}

fn compilation_unit_from_partition(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>,
  unit_id: CompilationUnitId
) -> CompilationUnit {
  let members = partition_unit_members(
    module_dag: module_dag,
    assignment: assignment,
    unit_id: unit_id
  )
  CompilationUnit {
    id: unit_id
    members: members
    interface: partition_unit_interface(
      module_dag: module_dag,
      assignment: assignment,
      unit_id: unit_id,
      members: members
    )
    deps: partition_unit_deps(
      module_dag: module_dag,
      assignment: assignment,
      unit_id: unit_id
    )
    artifact: compilation_unit_artifact_id(unit_id: unit_id)
  }
}

fn partition_fold(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>
) -> List<CompilationUnit> {
  list_unique_sorted_ids(items: assignment |> map_values)
    |> map(unit_id =>
      compilation_unit_from_partition(
        module_dag: module_dag,
        assignment: assignment,
        unit_id: unit_id
      )
    )
}

fn partition_boundary_dep_targets(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>,
  unit_id: CompilationUnitId
) -> List<CompilationUnitId> {
  partition_unit_deps(
    module_dag: module_dag,
    assignment: assignment,
    unit_id: unit_id
  )
}

fn partition_unit_by_id(
  units: List<CompilationUnit>,
  unit_id: CompilationUnitId
) -> Optional<CompilationUnit> {
  match units |> filter(unit => unit.id == unit_id) |> first {
    Present { value: unit } => Present { value: unit }
    Absent => Absent
  }
}

fn partition_fold_deps_match_boundary_edges(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>
) -> Bool {
  let units = partition_fold(module_dag: module_dag, assignment: assignment)
  list_unique_sorted_ids(items: assignment |> map_values)
    |> fold(init: true, f: fn(ok, unit_id) {
      if !ok {
        false
      } else {
        match partition_unit_by_id(units: units, unit_id: unit_id) {
          Present { value: unit } => {
            let expected = partition_boundary_dep_targets(
              module_dag: module_dag,
              assignment: assignment,
              unit_id: unit_id
            )
            unit.deps == expected
          }
          Absent => false
        }
      }
    })
}
