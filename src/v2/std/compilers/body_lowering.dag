module v2.std.compilers.body_lowering

import std.algebra { Cons, Empty, FreeMonoid }
import v2.std.algebra { fold_list, list_append, list_snoc_item }
import v2.std.collection { Absent, List, Present, list_at_optional }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  NonEmptyDiagnostics,
  diagnostics_singleton,
  Rejected,
  ExternalContractUnknown,
  Outcome,
  Unavailable,
  node_locus,
  outcome_accepted,
  outcome_rejected
}
import v2.std.logic { Bool }
import v2.std.integer { Int }
import v2.std.optional { Optional }
import v2.std.node {
  Bind,
  Branch,
  ComputationNode,
  Conj,
  Edge,
  Loop,
  Match,
  Atom,
  Arrow,
  Named,
  Node,
  Positional,
  Symbol,
  Transform,
  TypeNode,
  is_empty_conj_root,
  node_synthetic
}
import v2.std.compilers.sugar { sugar_sequence_pair_optional }
import v2.std.node_query { NamedChildAmbiguous, NamedChildFound, NamedChildMissing, named_child_lookup }

fn body_lowering_diagnostic(reason: Symbol, n: Node) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: n),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn lower_binary_infix(left: Node, operator: Node, right: Node) -> Node {
  node_synthetic(
    kind: ComputationNode { behavior: Transform },
    children: [
      Edge { label: Positional, target: operator },
      Edge { label: Positional, target: left },
      Edge { label: Positional, target: right }
    ]
  )
}

// A PREFIX OPERATOR APPLIED TO ONE OPERAND: the same Transform shape lower_binary_infix builds, with
// the operator first and the single operand after it.
fn lower_unary_prefix(operator: Node, operand: Node) -> Node {
  node_synthetic(
    kind: ComputationNode { behavior: Transform },
    children: [
      Edge { label: Positional, target: operator },
      Edge { label: Positional, target: operand }
    ]
  )
}

fn lower_branch(condition: Node, then_arm: Node, else_arm: Node) -> Node {
  node_synthetic(
    kind: ComputationNode { behavior: Branch },
    children: [
      Edge { label: Positional, target: condition },
      Edge { label: Positional, target: then_arm },
      Edge { label: Positional, target: else_arm }
    ]
  )
}

fn lower_loop(value: Node, bound: Node) -> Node {
  node_synthetic(
    kind: ComputationNode { behavior: Loop },
    children: [
      Edge { label: Positional, target: value },
      Edge { label: Named { name: ^loop_bound_edge }, target: bound }
    ]
  )
}

fn lower_bind(key_binding: Node, value: Node, body_binding: Node) -> Node {
  node_synthetic(
    kind: ComputationNode { behavior: Bind },
    children: [
      Edge { label: Positional, target: key_binding },
      Edge { label: Positional, target: value },
      Edge { label: Positional, target: body_binding }
    ]
  )
}

fn lower_match(scrutinee: Node, arms: List<Node>) -> Node {
  node_synthetic(
    kind: ComputationNode { behavior: Match },
    children: list_append(
      left: [Edge { label: Positional, target: scrutinee }],
      right: fold(arms, init: Empty, f: fn(acc, arm) {
        list_snoc_item(xs: acc, item: Edge { label: Positional, target: arm })
      })
    )
  )
}

fn lower_block_body_atoms(atoms: List<Node>, witness: Node) -> Outcome<Node> {
  match list_at_optional(xs: atoms, index: 0) {
    Present { value: left } =>
      match list_at_optional(xs: atoms, index: 1) {
        Present { value: operator } =>
          match list_at_optional(xs: atoms, index: 2) {
            Present { value: right } =>
              if count(atoms) == 3 {
                outcome_accepted(value: lower_binary_infix(left: left, operator: operator, right: right))
              } else {
                outcome_rejected(
                  d: body_lowering_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: witness)
                )
              }
            Absent =>
              outcome_rejected(
                d: body_lowering_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: witness)
              )
          }
        Absent =>
          outcome_rejected(
            d: body_lowering_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: witness)
          )
      }
    Absent =>
      outcome_rejected(
        d: body_lowering_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: witness)
      )
  }
}

// ADMITTED SEMANTIC VIEWS OVER A LOWERED BODY. Each constructor above writes one shape; each view
// below is that constructor read backwards, and it lives here, beside the constructor, so the shape
// has one home. A view is NOT a second AST: it holds the very Node it was admitted from (`site`) and
// the very child Nodes it names, with nothing rebuilt, so a consumer that wants provenance, an
// occurrence or a locus still reads it from the Node.
//
// WHAT A VIEW ESTABLISHES, AND WHAT IT CANNOT. A view admits the Node in hand only if that Node is
// internally consistent with the constructor's shape: every edge carries the expected label, the
// child count matches, and no child is surface residue (an empty Conj, a grammar sequence, or an
// unconsumed production capture) standing where a lowered operand belongs. Anything else refuses,
// typed and located at the offending node. The piecewise readers this replaced
// (v2.std.node_query node_is_call, call_callee_target, call_argument_targets, now deleted) answered
// one question each and did not check this.
//
// A VIEW DOES NOT ESTABLISH SOURCE-TO-LOWERED COMPLETENESS, and must not be cited as if it did. It
// sees only the Node, never the source it came from, so a loss the lowering already committed is
// invisible to it: `f(x)` lowered to Transform[f] is a well-formed nullary application, and
// application_read admits it. Whether the lowered Node carries everything the source authored is
// established elsewhere: by the production-fed shape contracts
// (v2.test.claim.namespace_xl0.body_shape_contract), which compare against the authored source; by
// v2.compiler.reference_conservation; and by MQ-5. A view is how those claims read a Node, not a
// substitute for them.

// CALL AND OPERATOR ARE ONE SUBSTRATE SHAPE, and the substrate does not distinguish them: both are
// Transform(head, operands...). What separates them is whether the head is one of
// the language's operator terminals, which is a fact of the GRAMMAR, not of Node -- so the two views that
// refine application_read take the operator roster as a supplied value and never carry a copy of it. A caller over the .dag
// language passes v2.compiler.body_lowering_fold body_lower_binary_operators and
// body_lower_prefix_operators, which derive the roster from the grammar rows.

type MatchArmView {
  arm: Node
  pattern: Node
  body: Node
}

type MatchView {
  site: Node
  scrutinee: Node
  arms: List<MatchArmView>
}

type BindView {
  site: Node
  key: Node
  key_identity: Symbol
  value: Node
  body: Node
}

type BranchView {
  site: Node
  condition: Node
  then_arm: Node
  else_arm: Node
}

fn view_refusal<T>(reason: Symbol, at: Node) -> Outcome<T> {
  outcome_rejected(d: body_lowering_diagnostic(reason: reason, n: at))
}

// An operand that is not lowered substrate: an empty Conj, a grammar sequence, or a production
// capture the fold never consumed (one capture edge or, ambiguously, several -- never read as
// "no capture"). Each is surface syntax standing where a lowered operand belongs.
// Refusing it keeps the Node internally consistent; it does not detect an operand that was dropped
// outright (see the note above the views).
fn view_is_surface_residue(n: Node) -> Bool {
  is_empty_conj_root(n: n)
    || (match sugar_sequence_pair_optional(node: n) { Present { value: _ } => true  Absent => false })
    || (match named_child_lookup(root: n, name: ^grammar_production_captured_node_projection) {
          NamedChildFound { target: _ } => true
          NamedChildAmbiguous => true
          NamedChildMissing => false
        })
}

// Every child of `site`, in order, provided every edge is positional and no child is an
// empty-Conj residue; the first defect refuses at the node that carries it.
fn view_whole_positional_children(site: Node) -> Outcome<List<Node>> {
  fold(site.children, init: outcome_accepted(value: Empty), f: fn(acc, e) {
    match acc {
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
      Accepted { value: xs, diagnostics: _ } =>
        match e.label {
          Named { name: _ } => view_refusal(reason: ^body_view_unexpected_named_edge, at: site)
          Positional =>
            if view_is_surface_residue(n: e.target) {
              view_refusal(reason: ^body_view_operand_residue, at: e.target)
            } else {
              outcome_accepted(value: list_snoc_item(xs: xs, item: e.target))
            }
        }
    }
  })
}

fn view_atom_identity_optional(n: Node) -> Optional<Symbol> {
  match n.kind {
    TypeNode { connective: Atom { identity: id } } =>
      match n.children {
        Empty => Present { value: id }
        Cons { head: _, tail: _ } => Absent
      }
    _ => Absent
  }
}

fn view_symbol_listed(id: Symbol, xs: List<Symbol>) -> Bool {
  fold_list(xs: xs, empty: false, cons: fn(acc, x) { acc || (x == id) })
}

// ONE CALL READER. application_read replaced v2.std.node_query node_is_call / call_callee_target /
// call_argument_targets, which were deleted in the same change that cut their six production
// consumers over (v2.std.fn_index and the determinism, machine_shape, fn_index_depth_agreement,
// production_qualification_origin_probe and no_dual_representation lenses); each surfaces
// ApplicationRefused through its own refusal channel rather than reading it as "not a call".

// THE SHARED BASE: AN APPLICATION, READ WITHOUT ANY OPERATOR ROSTER. Every call and every operator
// lowers to Transform(head, operands...), so "what is applied here, to what" is a question about
// Node alone, and a walker that asks it of every node needs three answers, not two: this node is
// not an application at all; it is a well-formed application; or it is a Transform that is not
// well formed. Folding the last two together is how a malformed call used to read as "not a call" and drop out of every
// lens silently, so they are separate arms here and in each view built on this one.
//
// The head is an atom (a name, before or after resolution) or an Arrow (a resolved callee). Which
// it is, is carried as a coproduct rather than an optional identity, so a consumer that wants a
// name must say what it does with an Arrow head.
type ApplicationHead
  = AtomHead { identity: Symbol }
  | ArrowHead

type ApplicationView {
  head: Node
  head_identity: ApplicationHead
  operands: List<Node>
}

type ApplicationRead
  = NotApplication
  | Application { view: ApplicationView }
  | ApplicationRefused { diagnostics: NonEmptyDiagnostics }

fn application_head_optional(n: Node) -> Optional<ApplicationHead> {
  match n.kind {
    TypeNode { connective: Arrow } => Present { value: ArrowHead }
    _ =>
      match view_atom_identity_optional(n: n) {
        Present { value: id } => Present { value: AtomHead { identity: id } }
        Absent => Absent
      }
  }
}

fn application_refused(reason: Symbol, at: Node) -> ApplicationRead {
  ApplicationRefused { diagnostics: diagnostics_singleton(d: body_lowering_diagnostic(reason: reason, n: at)) }
}

// THE ONE BASE READ under application_read. It decides everything about an application except
// whether its OPERANDS are whole: a residue operand is marked here rather than refused. That split
// exists for the no_dual_representation scan, which reads the first operand and must tell residue
// from a value; readers whose question is the head alone take the head layer below and classify
// nothing; application_read refuses the first residue operand. Every other defect -- a named edge,
// a missing or non-callee head, a residue head -- refuses here.
type OperandSlot
  = WholeOperand { node: Node }
  | ResidueOperand { node: Node }

type ApplicationSlots {
  head: Node
  head_identity: ApplicationHead
  operands: List<OperandSlot>
}

type ApplicationSlotsRead
  = NotApplicationSlots
  | ApplicationSlotsFound { slots: ApplicationSlots }
  | ApplicationSlotsRefused { diagnostics: NonEmptyDiagnostics }

}

fn application_positional_targets(site: Node) -> Outcome<List<Node>> {
  fold(site.children, init: outcome_accepted(value: Empty), f: fn(acc, e) {
    match acc {
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
      Accepted { value: xs, diagnostics: _ } =>
        match e.label {
          Named { name: _ } => view_refusal(reason: ^body_view_unexpected_named_edge, at: site)
          Positional => outcome_accepted(value: list_snoc_item(xs: xs, item: e.target))
        }
    }
  })
}

fn operand_slot_of(n: Node) -> OperandSlot {
  if view_is_surface_residue(n: n) { ResidueOperand { node: n } } else { WholeOperand { node: n } }
}

// THE HEAD LAYER of the base read: the edges are all positional and the first is a callee. An Atom
// head is admitted only childless (view_atom_identity_optional), so it cannot be residue and skips
// that check; an Arrow or a rejected head is still checked, so a residue head keeps its reason. It
// does not classify operands at all -- their residue check costs a sequence probe and a named-child
// search per operand -- so a reader whose question is the head alone (the determinism and
// machine_shape gates, the v2.std.fn_index call walk) pays nothing for operands it never reads.
type ApplicationHeadRead
  = NotApplicationHead
  | ApplicationHeadFound { head: Node, head_identity: ApplicationHead, operands: List<Node> }
  | ApplicationHeadRefused { diagnostics: NonEmptyDiagnostics }

fn application_head_refused(reason: Symbol, at: Node) -> ApplicationHeadRead {
  ApplicationHeadRefused { diagnostics: diagnostics_singleton(d: body_lowering_diagnostic(reason: reason, n: at)) }
}

fn application_head_read(site: Node) -> ApplicationHeadRead {
  match site.kind {
    ComputationNode { behavior: Transform } =>
      match application_positional_targets(site: site) {
        Rejected { diagnostics: r } => ApplicationHeadRefused { diagnostics: r }
        Accepted { value: children, diagnostics: _ } =>
          match children {
            Empty => application_head_refused(reason: ^body_view_transform_head_absent, at: site)
            Cons { head: head, tail: rest } =>
              match application_head_optional(n: head) {
                Present { value: AtomHead { identity: id } } =>
                  ApplicationHeadFound { head: head, head_identity: AtomHead { identity: id }, operands: rest }
                Present { value: ArrowHead } =>
                  if view_is_surface_residue(n: head) {
                    application_head_refused(reason: ^body_view_operand_residue, at: head)
                  } else {
                    ApplicationHeadFound { head: head, head_identity: ArrowHead, operands: rest }
                  }
                Absent =>
                  if view_is_surface_residue(n: head) {
                    application_head_refused(reason: ^body_view_operand_residue, at: head)
                  } else {
                    application_head_refused(reason: ^body_view_transform_head_not_callee, at: head)
                  }
              }
          }
      }
    _ => NotApplicationHead
  }
}

// The slots layer: the head layer, then each operand classified whole or residue.
fn application_slots(site: Node) -> ApplicationSlotsRead {
  match application_head_read(site: site) {
    NotApplicationHead => NotApplicationSlots
    ApplicationHeadRefused { diagnostics: d } => ApplicationSlotsRefused { diagnostics: d }
    ApplicationHeadFound { head: head, head_identity: identity, operands: rest } =>
      ApplicationSlotsFound {
        slots: ApplicationSlots {
          head: head,
          head_identity: identity,
          operands: fold(rest, init: Empty, f: fn(xs, n) { list_snoc_item(xs: xs, item: operand_slot_of(n: n)) })
        }
      }
  }
}

// On a lowered body every residue operand is a partial read, so the first one refuses, located.
fn application_read(site: Node) -> ApplicationRead {
  match application_slots(site: site) {
    NotApplicationSlots => NotApplication
    ApplicationSlotsRefused { diagnostics: d } => ApplicationRefused { diagnostics: d }
    ApplicationSlotsFound { slots: sl } =>
      match fold(sl.operands, init: outcome_accepted(value: Empty), f: fn(acc, slot) {
        match acc {
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
          Accepted { value: xs, diagnostics: _ } =>
            match slot {
              WholeOperand { node: n } => outcome_accepted(value: list_snoc_item(xs: xs, item: n))
              ResidueOperand { node: n } => view_refusal(reason: ^body_view_operand_residue, at: n)
            }
        }
      }) {
        Rejected { diagnostics: r } => ApplicationRefused { diagnostics: r }
        Accepted { value: operands, diagnostics: _ } =>
          Application { view: ApplicationView { head: sl.head, head_identity: sl.head_identity, operands: operands } }
      }
  }
}

// A CALL is an application whose head is not one of the language's operator terminals. The roster
// is a grammar fact, supplied by the caller (for .dag: v2.compiler.body_lowering_fold
// body_lower_binary_operators and body_lower_prefix_operators, derived from the grammar rows), and
// only these two refinements need it.
type CallView {
  site: Node
  callee: Node
  callee_identity: ApplicationHead
  arguments: List<Node>
}

type CallRead
  = NotCall
  | Call { view: CallView }
  | CallRefused { diagnostics: NonEmptyDiagnostics }

type OperatorView {
  site: Node
  operator: Symbol
  operands: List<Node>
}

type OperatorRead
  = NotOperator
  | Operator { view: OperatorView }
  | OperatorRefused { diagnostics: NonEmptyDiagnostics }

fn call_read(site: Node, operators: List<Symbol>) -> CallRead {
  match application_read(site: site) {
    NotApplication => NotCall
    ApplicationRefused { diagnostics: r } => CallRefused { diagnostics: r }
    Application { view: a } =>
      let call = Call { view: CallView { site: site, callee: a.head, callee_identity: a.head_identity, arguments: a.operands } }
      match a.head_identity {
        AtomHead { identity: id } => if view_symbol_listed(id: id, xs: operators) { NotCall } else { call }
        ArrowHead => call
      }
  }
}

// An OPERATOR application: a binary terminal with exactly two whole operands, or a prefix terminal
// with exactly one. Arity is checked against the roster the head came from, so a binary terminal
// carrying one operand refuses rather than answering NotOperator. That catches an inconsistent
// Node; an operand lowering dropped along with its operator is not visible here.
fn operator_read(site: Node, binary_operators: List<Symbol>, prefix_operators: List<Symbol>) -> OperatorRead {
  match application_read(site: site) {
    NotApplication => NotOperator
    ApplicationRefused { diagnostics: r } => OperatorRefused { diagnostics: r }
    Application { view: a } =>
      match a.head_identity {
        ArrowHead => NotOperator
        AtomHead { identity: id } =>
          let arity = count(a.operands)
          let binary = view_symbol_listed(id: id, xs: binary_operators)
          let prefix = view_symbol_listed(id: id, xs: prefix_operators)
          if (binary && arity == 2) || (prefix && arity == 1) {
            Operator { view: OperatorView { site: site, operator: id, operands: a.operands } }
          } else if binary || prefix {
            OperatorRefused { diagnostics: diagnostics_singleton(d: body_lowering_diagnostic(reason: ^body_view_operator_arity, n: site)) }
          } else {
            NotOperator
          }
      }
  }
}

fn match_arm_view(arm: Node) -> Outcome<MatchArmView> {
  match arm.kind {
    TypeNode { connective: Conj } =>
      if count(arm.children) == 2 {
        match list_at_optional(xs: arm.children, index: 0) {
          Present { value: p } =>
            match list_at_optional(xs: arm.children, index: 1) {
              Present { value: b } =>
                match p.label {
                  Named { name: pn } =>
                    match b.label {
                      Named { name: bn } =>
                        if (pn == ^match_arm_pattern) && (bn == ^match_arm_body) {
                          if view_is_surface_residue(n: b.target) {
                            view_refusal(reason: ^body_view_operand_residue, at: b.target)
                          } else {
                            outcome_accepted(value: MatchArmView { arm: arm, pattern: p.target, body: b.target })
                          }
                        } else {
                          view_refusal(reason: ^body_view_match_arm_malformed, at: arm)
                        }
                      Positional => view_refusal(reason: ^body_view_match_arm_malformed, at: arm)
                    }
                  Positional => view_refusal(reason: ^body_view_match_arm_malformed, at: arm)
                }
              Absent => view_refusal(reason: ^body_view_match_arm_malformed, at: arm)
            }
          Absent => view_refusal(reason: ^body_view_match_arm_malformed, at: arm)
        }
      } else {
        view_refusal(reason: ^body_view_match_arm_malformed, at: arm)
      }
    _ => view_refusal(reason: ^body_view_match_arm_malformed, at: arm)
  }
}

// A match: a whole scrutinee and at least one arm, each arm exactly (pattern, body).
fn match_view(site: Node) -> Outcome<MatchView> {
  match site.kind {
    ComputationNode { behavior: Match } =>
      match view_whole_positional_children(site: site) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: children, diagnostics: _ } =>
          match children {
            Empty => view_refusal(reason: ^body_view_match_scrutinee_absent, at: site)
            Cons { head: scrutinee, tail: arm_nodes } =>
              match arm_nodes {
                Empty => view_refusal(reason: ^body_view_match_arms_absent, at: site)
                Cons { head: _, tail: _ } =>
                  match fold(arm_nodes, init: outcome_accepted(value: Empty), f: fn(acc, arm) {
                    match acc {
                      Rejected { diagnostics: r } => Rejected { diagnostics: r }
                      Accepted { value: xs, diagnostics: _ } =>
                        match match_arm_view(arm: arm) {
                          Rejected { diagnostics: r } => Rejected { diagnostics: r }
                          Accepted { value: a, diagnostics: _ } =>
                            outcome_accepted(value: list_snoc_item(xs: xs, item: a))
                        }
                    }
                  }) {
                    Rejected { diagnostics: r } => Rejected { diagnostics: r }
                    Accepted { value: arms, diagnostics: _ } =>
                      outcome_accepted(value: MatchView { site: site, scrutinee: scrutinee, arms: arms })
                  }
              }
          }
      }
    _ => view_refusal(reason: ^body_view_not_match, at: site)
  }
}

type ViewTriple {
  first: Node
  second: Node
  third: Node
}

// Exactly three whole positional children, destructured; any other count refuses at `site`, so no
// child position is ever filled by a stand-in.
fn view_exactly_three(site: Node, reason: Symbol) -> Outcome<ViewTriple> {
  match view_whole_positional_children(site: site) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: children, diagnostics: _ } =>
      match children {
        Cons { head: first, tail: Cons { head: second, tail: Cons { head: third, tail: Empty } } } =>
          outcome_accepted(value: ViewTriple { first: first, second: second, third: third })
        _ => view_refusal(reason: reason, at: site)
      }
  }
}

// A bind: an atom key, a whole value, and a whole body in which the key is bound.
fn bind_view(site: Node) -> Outcome<BindView> {
  match site.kind {
    ComputationNode { behavior: Bind } =>
      match view_exactly_three(site: site, reason: ^body_view_bind_arity) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: t, diagnostics: _ } =>
          match view_atom_identity_optional(n: t.first) {
            Absent => view_refusal(reason: ^body_view_bind_key_not_atom, at: t.first)
            Present { value: id } =>
              outcome_accepted(value: BindView {
                site: site,
                key: t.first,
                key_identity: id,
                value: t.second,
                body: t.third
              })
          }
      }
    _ => view_refusal(reason: ^body_view_not_bind, at: site)
  }
}

// A branch: a whole condition and both whole arms.
fn branch_view(site: Node) -> Outcome<BranchView> {
  match site.kind {
    ComputationNode { behavior: Branch } =>
      match view_exactly_three(site: site, reason: ^body_view_branch_arity) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: t, diagnostics: _ } =>
          outcome_accepted(value: BranchView {
            site: site,
            condition: t.first,
            then_arm: t.second,
            else_arm: t.third
          })
      }
    _ => view_refusal(reason: ^body_view_not_branch, at: site)
  }
}
