// src/v2/std/compilers/lexing.dag
// Scope: canonical lexical model shared by compiler stages and target-language specs.
// Anchor: https://en.wikipedia.org/wiki/Lexical_analysis + gunbc#4761.
// Status: T-6 lexical data carriers; lexer implementation remains in v2.compiler.tokenize.

module v2.std.compilers.lexing

import v2.std.algebra { fold_list }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.node { Atom, Conj, Node, Symbol, SyntheticOccurrence, TypeNode }
import v2.std.node_shape { stamp_node_shape_synthetic, type_shape }
import v2.std.text { Char, String }

type Lexeme = String

// 🟡 coproduct dissolution — feature:t6-lex-char-class-morphism — consumer:v2.compiler.tokenize.char_in_class — bind gunbc#4761 — dissolve-on-arrival: substrate-derived LexCharClass membership morphism replaces per-arm character-range predicates; forbidden: adding LexCharClass arms without the morphism consumer.
type LexCharClass
  = WhitespaceChar
  | DigitChar
  | HexDigitChar
  | IdentStartChar
  | IdentContinueChar
  | StringTextChar
  | LineCommentTextChar
  | BlockCommentTextChar


// 🟡 coproduct dissolution — feature:CP-1b-bidirectional-grammar-carrier — consumer:v2.compiler.tokenize.lex_match_pattern/v2.std.compilers.target_model.lex_rules_literal_for_class — bind docs/design-bidirectional-coercion.md §4 + docs/planning/v2-g-bidir-emit-ingest-unification-scoping-worksheet-2026-06-10.md Phase G — dissolve-on-arrival: LexPattern projects from ConcreteSyntaxSchema alongside grammar projection; forbidden: treating LexPattern as a second concrete-syntax authority or adding parallel lexical and grammar production algebras without explicit structural justification.
type LexPattern
  = EmptyPattern
  | LiteralPattern { text: String }
  | KeywordPattern { text: String }
  | CharPattern { char: Char }
  | CharClassPattern { class: LexCharClass }
  | SequencePattern { left: LexPattern, right: LexPattern }
  | ChoicePattern { left: LexPattern, right: LexPattern }
  | OptionalPattern { element: LexPattern }
  | RepeatPattern { element: LexPattern }
  | OneOrMorePattern { element: LexPattern }
  | DelimitedPattern { open: LexPattern, body: LexPattern, close: LexPattern }


// 🟡 coproduct dissolution — feature:t6-lex-rule-morphism — consumer:v2.compiler.tokenize.lex_try_rule/std.lexing.lex_rule_token_class_member — bind gunbc#4761 — dissolve-on-arrival: substrate-derived LexRule fold/projection covers token/trivia rule consumers; forbidden: duplicating LexRule arm matches outside this std query and tokenizer walk.
type LexRule
  = TokenRule { token_class: Symbol, pattern: LexPattern }
  | TriviaRule { pattern: LexPattern }


// Maximal munch: compiler tokenization selects the accepting rule with the longest lexeme;
// equal-length ties prefer the later rule (specific literals/keywords after ident).
type LexRuleSet {
  rules: List<LexRule>
}


// 🟡 coproduct dissolution — feature:t6-lex-rules-language-projection — consumer:v2.compiler.tokenize.tokenize/v2.compiler.target_carriers.TargetModel.lex — bind gunbc#4761 — dissolve-on-arrival: LanguageModel lexical projection carries explicit non-empty rule-set or void-language evidence, replacing VoidLexRules staging; forbidden: treating VoidLexRules as an unbounded default.
type LexRules
  = VoidLexRules
  | ModeledLexRules { root: LexRuleSet }


type Token {
  class: Symbol
  lexeme: Lexeme
  file: Symbol
  start: Int
  end: Int
}


type TokenStream {
  tokens: List<Token>
}


// 🟡 gated — predicate-dissolution interim — feature:lex-rule-token-class-query — bound task: gunbc#4761 (owner/lane: std lexing substrate follow-up) — dissolve-on-arrival: first PR landing substrate-derived LexRule token_class projection + TokenRule discriminant query deletes this hand-written arm match and routes lex_rule_set_token_class_member through that query in the same commit train; forbidden: duplicating LexRule arm matches outside this std query or laundering through local folds.
fn lex_rule_token_class_member(rule: LexRule, token_class: Symbol) -> Bool {
  match rule {
    TokenRule { token_class: c, pattern: _ } => c == token_class
    TriviaRule { pattern: _ } => false
  }
}


fn lex_rule_set_token_class_member(rules: LexRuleSet, token_class: Symbol) -> Bool {
  fold_list(
    xs: rules.rules,
    empty: false,
    cons: fn(acc, rule) {
      acc || lex_rule_token_class_member(rule: rule, token_class: token_class)
    }
  )
}


// LexPatternFold<R>: algebra for fold_lex_pattern<R>. One handler per LexPattern variant.
// Leaf handlers receive the raw payload; recursive handlers receive already-reduced R values
// (EAGER catamorphism — children are reduced before the handler fires, same as fold_grammar_expr).
// empty is a direct R value (not fn) because EmptyPattern has no payload.
type LexPatternFold<R> {
  empty:       R
  literal:     fn(String) -> R
  keyword:     fn(String) -> R
  char:        fn(Char) -> R
  char_class:  fn(LexCharClass) -> R
  sequence:    fn(R, R) -> R
  choice:      fn(R, R) -> R
  optional:    fn(R) -> R
  repeat:      fn(R) -> R
  one_or_more: fn(R) -> R
  delimited:   fn(R, R, R) -> R
}


// fold_lex_pattern<R>: EAGER catamorphism over LexPattern. Subterms are reduced to R before
// the handler fires. Terminates by structural descent on the finite LexPattern tree.
// Concept home: std/compilers/lexing (fold lives with the type it folds — same as fold_grammar_expr/std/grammar).
fn fold_lex_pattern<R>(pattern: LexPattern, algebra: LexPatternFold<R>) -> R {
  match pattern {
    EmptyPattern =>
      algebra.empty
    LiteralPattern { text: text } =>
      algebra.literal(text)
    KeywordPattern { text: text } =>
      algebra.keyword(text)
    CharPattern { char: c } =>
      algebra.char(c)
    CharClassPattern { class: class } =>
      algebra.char_class(class)
    SequencePattern { left: left, right: right } =>
      algebra.sequence(
        fold_lex_pattern(pattern: left, algebra: algebra),
        fold_lex_pattern(pattern: right, algebra: algebra)
      )
    ChoicePattern { left: left, right: right } =>
      algebra.choice(
        fold_lex_pattern(pattern: left, algebra: algebra),
        fold_lex_pattern(pattern: right, algebra: algebra)
      )
    OptionalPattern { element: element } =>
      algebra.optional(fold_lex_pattern(pattern: element, algebra: algebra))
    RepeatPattern { element: element } =>
      algebra.repeat(fold_lex_pattern(pattern: element, algebra: algebra))
    OneOrMorePattern { element: element } =>
      algebra.one_or_more(fold_lex_pattern(pattern: element, algebra: algebra))
    DelimitedPattern { open: open, body: body, close: close } =>
      algebra.delimited(
        fold_lex_pattern(pattern: open, algebra: algebra),
        fold_lex_pattern(pattern: body, algebra: algebra),
        fold_lex_pattern(pattern: close, algebra: algebra)
      )
  }
}


fn lex_empty_node() -> Node {
  stamp_node_shape_synthetic(shape: type_shape(connective: Conj, children: []))
}




fn lex_void_lex_rules_evidence_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^lex_void_lex_rules_evidence } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}


// 🟡 gated — feature:t6-lex-rules-node-projection — consumer:v2.std.language_model.language_model_to_node —
// dissolve-on: ModeledLexRules projects LexRuleSet fold to named Conj edges; VoidLexRules maps to void evidence node.
fn lex_rules_to_node(rules: LexRules) -> Node {
  match rules {
    VoidLexRules => lex_void_lex_rules_evidence_node()
    ModeledLexRules { root: _ } => lex_empty_node()
  }
}
