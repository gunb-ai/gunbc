module v2.std.compilers.lexing


type Lexeme = String

type LexCharClass
  = WhitespaceChar
  | DigitChar
  | HexDigitChar
  | IdentStartChar
  | IdentContinueChar
  | StringTextChar
  | LineCommentTextChar
  | BlockCommentTextChar

type LexPattern
  = EmptyPattern
  | LiteralPattern { text: String }
  | KeywordPattern { text: String }
  | CharPattern { char: std.types.Char }
  | CharClassPattern { class: LexCharClass }
  | SequencePattern { left: LexPattern, right: LexPattern }
  | ChoicePattern { left: LexPattern, right: LexPattern }
  | OptionalPattern { element: LexPattern }
  | RepeatPattern { element: LexPattern }
  | OneOrMorePattern { element: LexPattern }
  | DelimitedPattern { open: LexPattern, body: LexPattern, close: LexPattern }

data lex_rule_third_channel_note: String = "A lexeme reaches exactly one of three destinations, and the third exists because the other two are both wrong for a comment. TriviaRule consumes text and emits nothing, so a comment routed through it is invisible to every parser, lens, census, migration, and SCM operation — readable to humans and absent from the model. TokenRule emits into the SEMANTIC token stream, so a comment routed through it becomes something every parser must filter, perturbs token order, and sits in the path of occurrence allocation. AnnotationRule captures the lexeme as authored-source data that is real, addressable by authoring machinery, and absent from the semantic stream. See DESIGN 4c: source annotations are captured authored-source data, not semantic program data and not discarded trivia."

type LexRule
  = TokenRule { token_class: v2.std.node.Symbol, pattern: LexPattern }
  | TriviaRule { pattern: LexPattern }
  | AnnotationRule { annotation_class: v2.std.node.Symbol, pattern: LexPattern }

type LexRuleSet {
  rules: List<LexRule>
}

type LexRules
  = VoidLexRules
  | ModeledLexRules { root: LexRuleSet }

type TokenSpan {
  token_class: v2.std.node.Symbol
  fragment: String
}

type LexicalPhrase {
  spans: List<TokenSpan>
}

fn span(text: String, class: v2.std.node.Symbol) -> TokenSpan {
  TokenSpan { token_class: class, fragment: text }
}

fn phrase(spans: List<TokenSpan>) -> LexicalPhrase {
  LexicalPhrase { spans: spans }
}

fn phrase_to_lex_rule_set(p: LexicalPhrase) -> LexRuleSet {
  LexRuleSet {
    rules: fold_list(
      xs: p.spans,
      empty: Empty,
      cons: fn(acc, s) {
        list_snoc_item(
          xs: acc,
          item: TokenRule {
            token_class: s.token_class,
            pattern: LiteralPattern { text: s.fragment }
          }
        )
      }
    )
  }
}

fn phrase_to_lex_rules(p: LexicalPhrase) -> LexRules {
  ModeledLexRules { root: phrase_to_lex_rule_set(p: p) }
}

fn phrase_to_source_text(p: LexicalPhrase) -> String {
  fold_list(
    xs: p.spans,
    empty: "",
    cons: fn(acc, s) { concat(acc, s.fragment) }
  )
}

type Token {
  class: v2.std.node.Symbol
  lexeme: Lexeme
  file: v2.std.node.Symbol
  start: Int
  end: Int
}

type TokenStream {
  all: List<Token>
  pos: Int
}

fn token_stream_new(all: List<Token>) -> TokenStream {
  TokenStream { all: all, pos: 0 }
}

fn token_stream_empty() -> TokenStream {
  TokenStream { all: Empty, pos: 0 }
}

fn token_stream_position(stream: TokenStream) -> Int {
  stream.pos
}

fn token_stream_all(stream: TokenStream) -> List<Token> {
  stream.all
}

fn token_stream_remaining_count(stream: TokenStream) -> Int {
  length(xs: stream.all) - stream.pos
}

fn token_stream_remaining(stream: TokenStream) -> List<Token> {
  skip(xs: stream.all, n: stream.pos)
}

fn token_stream_first(stream: TokenStream) -> Optional<Token> {
  list_at_optional(xs: stream.all, index: stream.pos)
}

fn token_stream_get(stream: TokenStream, offset: Int) -> Optional<Token> {
  list_at_optional(xs: stream.all, index: stream.pos + offset)
}

fn token_stream_advance(stream: TokenStream, n: Int) -> TokenStream {
  TokenStream { all: stream.all, pos: stream.pos + n }
}

data annotation_placement_reexport_note: String = "AnnotationPlacement is NOT declared here. It is the language-agnostic concept and its authority is std.source_annotation, which the v1 seed tokenizer imports too — a second spelling in this module would be the nicknaming defect the source-annotation lane exists to remove. This module owns only what is lexical: the rule variant, the unbound capture, and the artifact."

// Captured at the lexical boundary, before any structural subject is known — hence UNBOUND. It carries no identity of its own: binding it to a subject is the parser's job, and minting an identity for it would draw from the semantic occurrence allocator, which is exactly what DESIGN 4c forbids (adding a comment could then shift declaration identities in the same source and in later-parsed modules). Consecutive leading captures group into one ordered block at attachment; this row is one physical line.
type UnboundSourceAnnotation {
  annotation_class: v2.std.node.Symbol
  lexeme: Lexeme
  placement: std.source_annotation.AnnotationPlacement
  file: v2.std.node.Symbol
  start: Int
  end: Int
}

// The authored lexical result: the semantic token stream PLUS what the annotation channel captured. Semantic consumers project out `tokens` and see exactly what they saw before this channel existed; annotation-aware consumers take the whole artifact. The projection is the erasure boundary at the lexical layer, mirroring AuthoredParseArtifact at the parse layer.
type LexArtifact {
  tokens: TokenStream
  annotations: List<UnboundSourceAnnotation>
}

fn lex_artifact_semantic_tokens(artifact: LexArtifact) -> TokenStream {
  artifact.tokens
}

fn lex_artifact_annotations(artifact: LexArtifact) -> List<UnboundSourceAnnotation> {
  artifact.annotations
}

fn lex_artifact_new(tokens: TokenStream, annotations: List<UnboundSourceAnnotation>) -> LexArtifact {
  LexArtifact { tokens: tokens, annotations: annotations }
}

fn lex_rule_token_class_member(rule: LexRule, token_class: v2.std.node.Symbol) -> Bool {
  match rule {
    TokenRule { token_class: c, pattern: _ } => c == token_class
    TriviaRule { pattern: _ } => false
    AnnotationRule { annotation_class: _, pattern: _ } => false
  }
}

fn lex_rule_set_token_class_member(rules: LexRuleSet, token_class: v2.std.node.Symbol) -> Bool {
  fold_list(
    xs: rules.rules,
    empty: false,
    cons: fn(acc, rule) {
      acc || lex_rule_token_class_member(rule: rule, token_class: token_class)
    }
  )
}

type LexPatternFold<R> {
  empty:       R
  literal:     fn(String) -> R
  keyword:     fn(String) -> R
  char:        fn(Char) -> R
  char_class:  fn(LexCharClass) -> R
  sequence:    fn(R, R) -> R
  choice:      fn(R, R) -> R
  optional:    fn(R) -> R
  repeat:      fn(R) -> R
  one_or_more: fn(R) -> R
  delimited:   fn(R, R, R) -> R
}

fn fold_lex_pattern<R>(pattern: LexPattern, algebra: LexPatternFold<R>) -> R {
  match pattern {
    EmptyPattern =>
      algebra.empty
    LiteralPattern { text: text } =>
      algebra.literal(text)
    KeywordPattern { text: text } =>
      algebra.keyword(text)
    CharPattern { char: c } =>
      algebra.char(c)
    CharClassPattern { class: class } =>
      algebra.char_class(class)
    SequencePattern { left: left, right: right } =>
      algebra.sequence(
        fold_lex_pattern(pattern: left, algebra: algebra),
        fold_lex_pattern(pattern: right, algebra: algebra)
      )
    ChoicePattern { left: left, right: right } =>
      algebra.choice(
        fold_lex_pattern(pattern: left, algebra: algebra),
        fold_lex_pattern(pattern: right, algebra: algebra)
      )
    OptionalPattern { element: element } =>
      algebra.optional(fold_lex_pattern(pattern: element, algebra: algebra))
    RepeatPattern { element: element } =>
      algebra.repeat(fold_lex_pattern(pattern: element, algebra: algebra))
    OneOrMorePattern { element: element } =>
      algebra.one_or_more(fold_lex_pattern(pattern: element, algebra: algebra))
    DelimitedPattern { open: open, body: body, close: close } =>
      algebra.delimited(
        fold_lex_pattern(pattern: open, algebra: algebra),
        fold_lex_pattern(pattern: body, algebra: algebra),
        fold_lex_pattern(pattern: close, algebra: algebra)
      )
  }
}

fn lex_empty_node() -> Node {
  stamp_node_shape_synthetic(shape: type_shape(connective: Conj, children: []))
}

fn lex_void_lex_rules_evidence_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^lex_void_lex_rules_evidence } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn lex_rules_to_node(rules: LexRules) -> Node {
  match rules {
    VoidLexRules => lex_void_lex_rules_evidence_node()
    ModeledLexRules { root: _ } => lex_empty_node()
  }
}

fn symbol_intern_lexeme(lexeme: Lexeme) -> v2.std.node.Symbol {
  symbol_intern_lexeme(lexeme: lexeme)
}

data symbol_lexeme_host_disposition: std.disposition.Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: std.decl_ref.DeclarationRef {
    module_path: "v2.std.compilers.lexing",
    decl_name: "symbol_lexeme",
    field: WholeDeclaration
  }
}

fn symbol_lexeme(sym: v2.std.node.Symbol) -> String {
  symbol_lexeme(sym: sym)
}
