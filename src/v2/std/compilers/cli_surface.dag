module v2.std.compilers.cli_surface

import std.algebra { Empty }
import std.types { String }
import v2.std.algebra { fold_list, list_snoc_item }
import v2.std.collection { List, Map }
import v2.std.compilers.target_model {
  BoundToken,
  ConcreteSyntaxToken,
  FixedToken,
  LexRules,
  bound_spelling_from_map,
  lex_rules_literal_for_class
}
import v2.std.diagnostic {
  Accepted,
  None,
  Outcome,
  Rejected,
  bind_outcome,
  outcome_accepted
}
import v2.std.node { Symbol }


// WHY THIS EXISTS, and why it is a sibling rather than a transform of the text carrier.
//
// v2.std.compilers.target_model.bound_tokens_source_text folds a grammar-selected token sequence
// into TargetText, resolving each token to its spelling and joining with target_text_seq, which is
// concatenation. Concatenation is the step that DESTROYS argument boundaries: once the tokens are
// one String, "a b" and ["a", "b"] are the same value, and every consumer downstream must
// re-derive a boundary that the grammar already knew. That re-derivation is what shell_quote is,
// at 36 sites.
//
// This module folds the SAME tokens with the SAME spelling resolution and a DIFFERENT join: one
// argument per token. Nothing about the grammar walk changes; only whether the boundary survives.
// That is the whole claim the CLI-invocation-emission design rests on, reduced to the smallest
// thing that can be executed -- see docs/plans/cli-invocation-emission-design.md, Wave 0.
//
// NOT A SECOND EMITTER. It consumes what translate already produced. A target model that wants
// argument boundaries selects this serializer; one that wants source text selects the existing
// one. Both read one grammar.

// SEALED AT THE RECORD, NOT AT THE MINT -- and the difference is a live hole, stated here
// because an earlier revision of this comment claimed the opposite and was wrong.
//
// WHAT HOLDS: sole_constructor means no other module can write CliSurface { arguments: ... } or
// cast into one. The record literal and the cast are both closed (04_infer
// sole_constructor_construction_diags judges the two forms through one authority).
//
// WHAT DOES NOT HOLD: bound_tokens_cli_arguments below is public and takes tokens, lex rules AND
// binding spellings FROM ITS CALLER, so any module can synthesize whatever token sequence and lex
// table it likes and receive a sealed CliSurface carrying arbitrary content. You cannot author
// the record; you can author its contents. That is the mint-function hole gunbc.guarantee_probe_corpus
// already enumerates as sole_ctor_mint_fn_hole_probe, reproduced here.
//
// SO THE EARLIER CLAIM WAS BACKWARDS. This is WEAKER than extdeps.shell.exec TransportScript, not
// stronger: transport_script_seal is admit_callers-restricted to two named production decls, while
// this fold admits everyone. The claim was made, reviewed, and corroborated once before anyone
// checked it -- which is why it is written down here rather than quietly amended.
//
// WHY IT IS NOT CLOSED IN THIS COMMIT: the fix is to stop taking caller-supplied grammar at all --
// the fold should be reachable only already bound to a target model, so the lex table is the
// target's rather than the caller's -- and that shape is decided by whether the jq path consumes
// translate's target model or bypasses it entirely. Sealing to an admit_callers roster now would
// admit only this probe, which is a wall around an empty room. DISSOLVES WITH: the wave that adds
// the first production consumer, which is also the wave that answers the target-model question.

type CliArgument sole_constructor { text: String }

type CliSurface sole_constructor { arguments: List<CliArgument> }

fn cli_surface_arguments(surface: CliSurface) -> List<CliArgument> {
  surface.arguments
}

fn cli_argument_text(argument: CliArgument) -> String {
  argument.text
}

// The sibling fold. Structurally identical to bound_tokens_source_text except that the
// accumulator is a list of arguments and each resolved spelling is snoc'd as its own argument
// rather than concatenated onto a running string.
fn bound_tokens_cli_arguments(
  tokens: List<ConcreteSyntaxToken>,
  lex: LexRules,
  binding_spellings: Map<Symbol, String>
) -> Outcome<CliSurface> {
  bind_outcome(
    o: fold_list(
      xs: tokens,
      empty: Accepted { value: Empty, diagnostics: None },
      cons: fn(acc, token) {
        match acc {
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
          Accepted { value: partial, diagnostics: ad } =>
            match token {
              FixedToken { token_class: tc } =>
                bind_outcome(
                  o: lex_rules_literal_for_class(rules: lex, token_class: tc),
                  f: fn(spelling) {
                    Accepted {
                      value: list_snoc_item(xs: partial, item: CliArgument { text: spelling }),
                      diagnostics: ad
                    }
                  }
                )
              BoundToken { token_class: _, binding: b } =>
                bind_outcome(
                  o: bound_spelling_from_map(binding_spellings: binding_spellings, binding: b),
                  f: fn(spelling) {
                    Accepted {
                      value: list_snoc_item(xs: partial, item: CliArgument { text: spelling }),
                      diagnostics: ad
                    }
                  }
                )
            }
        }
      }
    ),
    f: fn(arguments) {
      outcome_accepted(CliSurface { arguments: arguments })
    }
  )
}
