module v2.std.compilers.sugar

import v2.std.algebra {
  Cons,
  Empty,
  FreeMonoid,
  fold_list,
  is_empty,
  length,
  list_append,
  list_snoc_item
}
import v2.std.collection { Absent, Present, optional_absent, optional_present }
import v2.std.diagnostic {
  Diagnostic,
  node_locus,
  Outcome,
  UserInputBoundary,
  Accepted,
  None,
  Rejected,
  bind_outcome,
  diagnostics_singleton,
  outcome_accepted
}
import v2.std.grammar { node_atom_identity_optional }
import v2.std.node_query { find_named_child }
import v2.std.node {
  Arrow,
  Atom,
  Conj,
  Connective,
  Disj,
  Edge,
  EdgeDiscipline,
  LabeledEdges,
  Named,
  Node,
  PositionalEdges,
  Symbol,
  TypeNode,
  edges_conform,
  is_empty_conj_root,
  is_positional
}

type SugarLowering
  = SugarRewriteConnective { connective: Connective, edges: EdgeDiscipline }
  | SugarUnwrapPositionalChild {}

type SugarRule {
  surface_atom: Symbol
  lowering: SugarLowering
}

data sugar_rule_service: SugarRule = SugarRule {
  surface_atom: ^dag_c3_surface_sugar_service,
  lowering: SugarRewriteConnective { connective: Conj, edges: LabeledEdges }
}
data sugar_rule_fn: SugarRule = SugarRule {
  surface_atom: ^dag_c3_surface_sugar_fn,
  lowering: SugarRewriteConnective { connective: Arrow, edges: PositionalEdges }
}
data sugar_rule_type: SugarRule = SugarRule {
  surface_atom: ^dag_c3_surface_sugar_type,
  lowering: SugarUnwrapPositionalChild {}
}
data sugar_rule_operation: SugarRule = SugarRule {
  surface_atom: ^dag_c3_surface_sugar_operation,
  lowering: SugarRewriteConnective { connective: Arrow, edges: PositionalEdges }
}

fn sugar_rules() -> List<SugarRule> {
  [
    sugar_rule_service,
    sugar_rule_fn,
    sugar_rule_type,
    sugar_rule_operation
  ]
}

fn no_sugar_rule() -> SugarRule? {
  optional_absent()
}

fn sugar_rule_for_atom(id: Symbol, rule: SugarRule) -> SugarRule? {
  if id == rule.surface_atom {
    optional_present(value: rule)
  } else {
    optional_absent()
  }
}

fn classify_sugar(n: Node) -> SugarRule? {
  match n.kind {
    TypeNode { connective: Atom { identity: id } } =>
      fold(sugar_rules(), init: no_sugar_rule(), f: fn(acc, rule) {
        match acc {
          Present { value: _ } => acc
          Absent => sugar_rule_for_atom(id: id, rule: rule)
        }
      })
    TypeNode { connective: _ } => no_sugar_rule()
    ComputationNode { behavior: _ } => no_sugar_rule()
  }
}

fn sugar_malformed_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^sugar_reason_malformed,
    at: node_locus(node: n),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn sugar_type_node(connective: Connective, children: List<Edge>, n: Node) -> Node {
  Node {
    kind: TypeNode { connective: connective },
    children: children,
    occurrence_id: n.occurrence_id
  }
}

fn sugar_positional_unwrap_child(children: List<Edge>) -> Node? {
  if count(children) == 1 {
    match children |> first {
      Present { value: e0 } =>
        if is_positional(e: e0) {
          optional_present(value: e0.target)
        } else {
          optional_absent()
        }
      Absent => optional_absent()
    }
  } else {
    optional_absent()
  }
}

fn sugar_named_child_optional(root: Node, name: Symbol) -> Node? {
  match find_named_child(root: root, name: name) {
    Accepted { value: child, diagnostics: _ } => optional_present(value: child)
    Rejected { diagnostics: _ } => optional_absent()
  }
}

type SugarSequencePair {
  left: Node
  right: Node
}

fn sugar_sequence_pair_optional(node: Node) -> SugarSequencePair? {
  match sugar_named_child_optional(root: node, name: ^grammar_sequence_left_node_projection) {
    Present { value: left } =>
      match sugar_named_child_optional(root: node, name: ^grammar_sequence_right_node_projection) {
        Present { value: right } =>
          optional_present(value: SugarSequencePair { left: left, right: right })
        Absent => optional_absent()
      }
    Absent => optional_absent()
  }
}

fn sugar_pipe_sequence_variant_optional(node: Node) -> Node? {
  match sugar_sequence_pair_optional(node: node) {
    Present { value: pair } => optional_present(value: pair.right)
    Absent => optional_present(value: node)
  }
}

fn sugar_collect_pipe_chain_variants(spine: Node) -> FreeMonoid<Node> {
  if is_empty_conj_root(n: spine) {
    Empty
  } else {
    match sugar_sequence_pair_optional(node: spine) {
      Present { value: pair } =>
        match sugar_pipe_sequence_variant_optional(node: pair.left) {
          Present { value: variant } =>
            list_snoc_item(
              xs: sugar_collect_pipe_chain_variants(spine: pair.right),
              item: variant
            )
          Absent => sugar_collect_pipe_chain_variants(spine: pair.right)
        }
      Absent => Empty
    }
  }
}

fn sugar_all_coproduct_variants(captured: Node) -> FreeMonoid<Node> {
  match sugar_sequence_pair_optional(node: captured) {
    Absent => Empty
    Present { value: pair } =>
      list_append(
        left: Cons { head: pair.left, tail: Empty },
        right: sugar_collect_pipe_chain_variants(spine: pair.right)
      )
  }
}

fn sugar_unwrap_production_shell(node: Node) -> Node {
  match sugar_named_child_optional(root: node, name: ^grammar_production_captured_node_projection) {
    Present { value: captured } => sugar_unwrap_production_shell(node: captured)
    Absent => node
  }
}

fn sugar_first_atom_identity_optional(node: Node) -> Symbol? {
  let stripped = sugar_unwrap_production_shell(node: node)
  match node_atom_identity_optional(node: stripped) {
    Present { value: sym } => optional_present(value: sym)
    Absent =>
      fold(
        stripped.children,
        init: optional_absent(),
        f: fn(acc, e) {
          match acc {
            Present { value: _ } => acc
            Absent => sugar_first_atom_identity_optional(node: e.target)
          }
        }
      )
  }
}

fn sugar_variant_to_disj_edge(variant_node: Node) -> Outcome<Edge> {
  let variant = sugar_unwrap_production_shell(node: variant_node)
  match sugar_first_atom_identity_optional(node: variant) {
    Present { value: name } =>
      Accepted {
        value: Edge { label: Named { name: name }, target: variant },
        diagnostics: None
      }
    Absent =>
      Rejected { diagnostics: diagnostics_singleton(d: sugar_malformed_diagnostic(n: variant_node)) }
  }
}

fn sugar_variants_to_disj_edges(variants: FreeMonoid<Node>) -> Outcome<FreeMonoid<Edge>> {
  fold_list(
    xs: variants,
    empty: outcome_accepted(Empty),
    cons: fn(acc_outcome, variant) {
      bind_outcome(o: acc_outcome, f: fn(edges) {
        bind_outcome(o: sugar_variant_to_disj_edge(variant_node: variant), f: fn(edge) {
          outcome_accepted(list_snoc_item(xs: edges, item: edge))
        })
      })
    }
  )
}

fn sugar_fold_coproduct_pipe_chain(captured: Node, shell: Node) -> Outcome<Node> {
  let variants = sugar_all_coproduct_variants(captured: captured)
  if length(xs: variants) < 2 {
    Accepted { value: captured, diagnostics: None }
  } else {
    match sugar_variants_to_disj_edges(variants: variants) {
      Accepted { value: edges, diagnostics: d } =>
        if edges_conform(children: edges, d: LabeledEdges) {
          Accepted {
            value: sugar_type_node(connective: Disj, children: edges, n: shell),
            diagnostics: d
          }
        } else {
          Rejected { diagnostics: diagnostics_singleton(d: sugar_malformed_diagnostic(n: shell)) }
        }
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
    }
  }
}

fn apply_sugar(rule: SugarRule, n: Node, children: List<Edge>) -> Outcome<Node> {
  match rule.lowering {
    SugarRewriteConnective { connective: connective, edges: discipline } =>
      if edges_conform(children: children, d: discipline) {
        Accepted {
          value: sugar_type_node(connective: connective, children: children, n: n),
          diagnostics: None
        }
      } else {
        Rejected { diagnostics: diagnostics_singleton(d: sugar_malformed_diagnostic(n: n)) }
      }
    SugarUnwrapPositionalChild {} =>
      match sugar_positional_unwrap_child(children: children) {
        Present { value: child } =>
          Accepted { value: child, diagnostics: None }
        Absent =>
          Rejected { diagnostics: diagnostics_singleton(d: sugar_malformed_diagnostic(n: n)) }
      }
  }
}
