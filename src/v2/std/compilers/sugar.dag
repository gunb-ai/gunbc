// src/v2/std/compilers/sugar.dag
// Scope: surface sugar — sugar-rule lowering to kernel connective + edge discipline.
// M9 concept-DAG home: std/compilers/ (compiler-pipeline transformation models); imports node.dag for Connective, EdgeDiscipline, edges_conform.
// Surface atom IDENTITY (^dag_c3_surface_sugar_* prelude) is language-specific extdep;
// this module owns the TRANSFORMATION model only, keyed by-reference to those atoms.
// Status: T-8 modeled — data-table authority for surface_atom → SugarLowering.
// 🟡 gated — feature:CP-1b-surface-sugar-language-model — bind gunbc#4766 / LanguageModel — dissolve-on: surface_atom identity lookup owned by LanguageModel carrier; forbidden: parallel Atom identity classifier outside this table + LanguageModel projection.

module v2.std.compilers.sugar

import v2.std.collection { Absent, Present, optional_absent, optional_present }
import v2.std.diagnostic {
  Diagnostic,
  node_locus,
  Outcome,
  UserInputBoundary,
  Accepted,
  None,
  diagnostics_singleton
}
import v2.std.node {
  Arrow,
  Conj,
  Connective,
  Edge,
  EdgeDiscipline,
  LabeledEdges,
  Node,
  PositionalEdges,
  Symbol,
  TypeNode,
  edges_conform,
  is_positional
}

data sugar_reason_malformed: Symbol = sugar_reason_malformed

// 🟢 TERMINAL — sugar lowering kinds: rewrite to kernel connective + edge discipline, or unwrap single positional child (irreducible transformation arms for surface sugar dissolution).
type SugarLowering
  = SugarRewriteConnective { connective: Connective, edges: EdgeDiscipline }
  | SugarUnwrapPositionalChild {}

type SugarRule {
  surface_atom: Symbol
  lowering: SugarLowering
}

data sugar_rule_service: SugarRule = SugarRule {
  surface_atom: ^dag_c3_surface_sugar_service,
  lowering: SugarRewriteConnective { connective: Conj, edges: LabeledEdges }
}
data sugar_rule_fn: SugarRule = SugarRule {
  surface_atom: ^dag_c3_surface_sugar_fn,
  lowering: SugarRewriteConnective { connective: Arrow, edges: PositionalEdges }
}
data sugar_rule_type: SugarRule = SugarRule {
  surface_atom: ^dag_c3_surface_sugar_type,
  lowering: SugarUnwrapPositionalChild {}
}
data sugar_rule_operation: SugarRule = SugarRule {
  surface_atom: ^dag_c3_surface_sugar_operation,
  lowering: SugarRewriteConnective { connective: Arrow, edges: PositionalEdges }
}

fn sugar_rules() -> List<SugarRule> {
  [
    sugar_rule_service,
    sugar_rule_fn,
    sugar_rule_type,
    sugar_rule_operation
  ]
}

fn no_sugar_rule() -> SugarRule? {
  optional_absent()
}

fn sugar_rule_for_atom(id: Symbol, rule: SugarRule) -> SugarRule? {
  if id == rule.surface_atom {
    optional_present(value: rule)
  } else {
    optional_absent()
  }
}

fn classify_sugar(n: Node) -> SugarRule? {
  match n.kind {
    TypeNode { connective: Atom { identity: id } } =>
      fold(sugar_rules(), init: no_sugar_rule(), f: fn(acc, rule) {
        match acc {
          Present { value: _ } => acc
          Absent => sugar_rule_for_atom(id: id, rule: rule)
        }
      })
    TypeNode { connective: _ } => no_sugar_rule()
    ComputationNode { behavior: _ } => no_sugar_rule()
  }
}

fn sugar_malformed_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: sugar_reason_malformed,
    at: node_locus(node: n),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn sugar_type_node(connective: Connective, children: List<Edge>, n: Node) -> Node {
  Node {
    kind: TypeNode { connective: connective },
    children: children,
    occurrence_id: n.occurrence_id
  }
}

fn sugar_positional_unwrap_child(children: List<Edge>) -> Node? {
  if count(children) == 1 {
    match children |> first {
      Present { value: e0 } =>
        if is_positional(e: e0) {
          optional_present(value: e0.target)
        } else {
          optional_absent()
        }
      Absent => optional_absent()
    }
  } else {
    optional_absent()
  }
}

fn apply_sugar(rule: SugarRule, n: Node, children: List<Edge>) -> Outcome<Node> {
  match rule.lowering {
    SugarRewriteConnective { connective: connective, edges: discipline } =>
      if edges_conform(children: children, d: discipline) {
        Accepted {
          value: sugar_type_node(connective: connective, children: children, n: n),
          diagnostics: None
        }
      } else {
        Rejected { diagnostics: diagnostics_singleton(d: sugar_malformed_diagnostic(n: n)) }
      }
    SugarUnwrapPositionalChild {} =>
      match sugar_positional_unwrap_child(children: children) {
        Present { value: child } =>
          Accepted { value: child, diagnostics: None }
        Absent =>
          Rejected { diagnostics: diagnostics_singleton(d: sugar_malformed_diagnostic(n: n)) }
      }
  }
}
