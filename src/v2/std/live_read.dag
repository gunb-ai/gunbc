module v2.std.live_read


data live_read_classification_authority_note: String = "G2 call-reachability live-read classification (docs/plans/live-read-witness-classification-design.md P1): carrier invocations are derived from fn-arrow DependencyView facts (fn_arrow_decl_facts_live) over call-reachable bodies, not module import alone. Path patterns are LiteralPath when a string literal is statable in the reachable skeleton, ParamRef when a filesystem_read path argument is a parameter, UnknownPath fail-closed otherwise. Subsumes witness_cost_locality.ambient_read_carrier_modules_v0 at steady state. Lives in v2.std.live_read (not v2.std.live_tree) so the widely-imported disposition module stays import-free."

type LiveReadCarrierKind
  = FilesystemReadCarrier
  | ModuleDeclarationFactsCarrier
  | DeclFactsReflectionCarrier

type LiveReadCarrierHome {
  module: String
  kind: LiveReadCarrierKind
}

type PathPattern
  = LiteralPath { path: String }
  | ParamRef { name: String }
  | UnknownPath

type LiveReadCarrier
  = FilesystemReadPath { path_pattern: PathPattern }
  | ModuleDeclarationFactsScan
  | DeclFactsReflection { home: String }

type LiveReadClassification
  = LocalRead
  | RuntimeRead {
      carriers: List<LiveReadCarrier>
    }

data live_read_carrier_homes_v0: List<LiveReadCarrierHome> = [
  LiveReadCarrierHome { module: "v2.lens.enforcement.cost_coverage", kind: FilesystemReadCarrier },
  LiveReadCarrierHome { module: "v2.lens.enforcement.grammar_coverage", kind: FilesystemReadCarrier },
  LiveReadCarrierHome { module: "v2.lens.complexity_accumulator_copy.roster_gate", kind: FilesystemReadCarrier },
  LiveReadCarrierHome { module: "v2.compiler.self_host", kind: FilesystemReadCarrier },
  LiveReadCarrierHome { module: "v2.std.decl_index", kind: DeclFactsReflectionCarrier },
  LiveReadCarrierHome { module: "v2.lens.module_graph", kind: ModuleDeclarationFactsCarrier },
  LiveReadCarrierHome { module: "tools.dag_compile_clean_shard_roster", kind: ModuleDeclarationFactsCarrier },
  LiveReadCarrierHome { module: "tools.dag_compile_clean_scope", kind: ModuleDeclarationFactsCarrier }
]

