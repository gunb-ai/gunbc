// src/v2/std/target_triple.dag
// Scope: Rust target-triple substrate — TargetTriple fact-bundle composing the
//        v2.std.platform vocabulary (Architecture × Vendor × OperatingSystem × LibcEnv), plus
//        canonical tier1 / tier2 published-triple constants. Single authority (DESIGN.md §3).
//        Consumers (install/install, runtime selection, build matrix projection) import; do not
//        redeclare.
// Status: Release Jun1 §5 Phase 1b prerequisite — modeled 2026-05-29.
// Anchor: https://doc.rust-lang.org/cargo/appendix/glossary.html#target — Cargo target glossary
//         (target-triple grammar `{arch}-{vendor}-{os}-{env}`).
// Anchor: https://doc.rust-lang.org/rustc/platform-support.html — tier1 / tier2 enumeration.

module v2.std.target_triple


import v2.std.platform { Aarch64, Apple, Architecture, Gnu, LibcEnv, Linux, Macos, Msvc, Musl, NoneLibc, OperatingSystem, Pc, UnknownVendor, Vendor, Windows, X86_64 }


// Anchor: https://doc.rust-lang.org/cargo/appendix/glossary.html#target. The Rust target-triple
// grammar carries four facts (arch, vendor, os, env); each is a closed-set carrier declared in
// v2.std.platform. TargetTriple is the named-edge fact-bundle that consumes those carriers
// — Cargo / rustc accept this exact shape via the `--target` flag.
type TargetTriple {
  arch: Architecture
  vendor: Vendor
  os: OperatingSystem
  env: LibcEnv
}


// Tier 1 published triples (https://doc.rust-lang.org/rustc/platform-support.html#tier-1-with-host-tools).
// Tier 1 = guaranteed-to-work + official release binaries + automated testing. These constants
// are the published authorities downstream channel projections (release.yml build matrix,
// install.sh case arms, Formula.rb arch blocks) iterate over.

data tier1_linux_x86_64_gnu: TargetTriple = TargetTriple {
  arch: X86_64,
  vendor: UnknownVendor,
  os: Linux,
  env: Gnu
}

data tier1_macos_x86_64: TargetTriple = TargetTriple {
  arch: X86_64,
  vendor: Apple,
  os: Macos,
  env: NoneLibc
}

data tier1_macos_aarch64: TargetTriple = TargetTriple {
  arch: Aarch64,
  vendor: Apple,
  os: Macos,
  env: NoneLibc
}

data tier1_windows_x86_64_msvc: TargetTriple = TargetTriple {
  arch: X86_64,
  vendor: Pc,
  os: Windows,
  env: Msvc
}


// Tier 2 published triples (https://doc.rust-lang.org/rustc/platform-support.html#tier-2-with-host-tools).
// Tier 2 = guaranteed-to-build; not all have automated testing. Phase 1 gunbc release uses
// `*-unknown-linux-musl` for hermetic Linux builds.

data tier2_linux_aarch64_gnu: TargetTriple = TargetTriple {
  arch: Aarch64,
  vendor: UnknownVendor,
  os: Linux,
  env: Gnu
}

data tier2_linux_x86_64_musl: TargetTriple = TargetTriple {
  arch: X86_64,
  vendor: UnknownVendor,
  os: Linux,
  env: Musl
}

data tier2_linux_aarch64_musl: TargetTriple = TargetTriple {
  arch: Aarch64,
  vendor: UnknownVendor,
  os: Linux,
  env: Musl
}

data tier2_windows_aarch64_msvc: TargetTriple = TargetTriple {
  arch: Aarch64,
  vendor: Pc,
  os: Windows,
  env: Msvc
}
