// WHAT A FORMAL IS DECLARED AS, READ AGAINST ITS OWN ARROW. A formal declared as one of the
// callee Arrow's type parameters (v2.std.type_binder type_param_names) is a DECLARED TYPE VARIABLE:
// universally quantified at the declaration and instantiated afresh at each application. It is
// its own constructor, never an inference variable -- the conflation
// gunbc.recurring_failure_mode type_variable_means_both_declared_generic_and_inference_variable
// rosters in v1's InferredNode TypeVariable. Reading it off the Arrow is sound because
// v2.compiler.resolve refuses a type parameter that would shadow a visible name, so inside the
// Arrow the spelling `T` can mean nothing but its binder.
type FormalDeclaration
  = DeclaredTypeVariable { binder: Symbol }
  | DeclaredType { declared: Node }

fn inhabitance_formal_declaration(declared: Node, type_params: List<Symbol>) -> FormalDeclaration {
  match declared.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if (count(declared.children) == 0)
        && fold(type_params, init: false, f: fn(acc, p) { acc || (p == id) }) {
        DeclaredTypeVariable { binder: id }
      } else {
        DeclaredType { declared: declared }
      }
    TypeNode { connective: Conj } => DeclaredType { declared: declared }
    TypeNode { connective: Disj } => DeclaredType { declared: declared }
    TypeNode { connective: Arrow } => DeclaredType { declared: declared }
    TypeNode { connective: Instantiation } => DeclaredType { declared: declared }
    ComputationNode { behavior: _ } => DeclaredType { declared: declared }
  }
}

// ONE APPLICATION'S INSTANTIATION: the type each declared type variable took at its first
// derived argument. It is built per application and discarded with it, so two applications of
// one generic fn -- or two generic fns spelling the same `T` -- never share an instance.
type TypeVariableInstance {
  binder: Symbol
  instance: Node
}

fn type_variable_instance_lookup(
  instances: List<TypeVariableInstance>,
  binder: Symbol
) -> Optional<Node> {
  fold(instances, init: Absent, f: fn(acc, i) {
    match acc {
      Present { value: _ } => acc
      Absent => if i.binder == binder { optional_present(value: i.instance) } else { Absent }
    }
  })
}

// type_variables are the declaring Arrow's type parameters (v2.std.type_binder type_param_names):
// the only atoms in `declared` that name no type, and so the only thing that keeps an
// Instantiation from being decided structurally.
type DeclaredTypeObligation {
  position: DeclaredTypePosition
  parameter_identity: Symbol
  declared: Node
  produced: Node
  produced_declared_carrier: Optional<Node>
  application: Node
  type_variables: List<Symbol>
}

type InhabitanceFormal {
  parameter_identity: Symbol
  declared: Node
}

type InhabitanceUndecidableReason
  = UndecidableGenericFormal
  | UndecidableFormalUnresolved
  | UndecidableArgumentTypeNotDerived
  | UndecidableWherePredicateSubjectUnmodelled

type InhabitanceVerdict
  = Inhabits { homomorphism: HomomorphismWitness }
  // `find_witness_reason` is the DECISION that refused: which arm of the one structural comparison
  // answered no, or one of v2.std.find_witness's own decisions (the preservation rule is not realized,
  // the candidate set is ambiguous). It is deliberately not the POSITION: the position is its own field
  // on the obligation, its own field on this verdict, and its own slot on the diagnostic
  // (Locus::InhabitanceJudgmentLocus, read through v2.std.diagnostic's diagnostic_inhabitance_position),
  // and naming a
  // refusal by position is what let one symbol stand for nine different mechanisms. See
  // v2.std.exact_structural_equality_zip_fold_predicate.
  // `refusal_class` is set once, by the decision that produced `find_witness_reason` -- never re-derived
  // from the symbol afterwards, so there is one authority for which class a refusal is (keen-heron-809's
  // condition on this PR).
  // `position` is the judgment site, its OWN field: the reason says what answered no, the position says
  // where, and neither is inferred from the other (keen-heron-809's ruling on this PR, which deleted the
  // position-named reason symbols for exactly that reason). It carries the argument ordinal path of the
  // decision that refused, so a nested mismatch says which argument it was decided at.
  | InhabitanceRefused { find_witness_reason: Symbol, refusal_class: InhabitanceRefusalClass, position: DeclaredTypePosition }
  | InhabitanceUndecidable { reason: InhabitanceUndecidableReason }

// Five producers, one relation: v2.compiler.infer builds PositionDirectCallArgument per argument of
// an application, PositionDeclaredReturn per Arrow body against its declared return, and
// PositionRecordField per field value of a record construct against the field the record declares,
// and PositionLetAnnotation per annotated let's bound value against its annotation, and all four
// hand the obligation to declared_type_inhabitance. A record field's position carries
// the construct's resolved constructor reference, so its refusal names the record as well as the
// field (the obligation's parameter_identity) and the two types.
// A position is built where the judgment is ASKED, so it starts at the position itself; the ordinal path
// is written later, by the refusal that knows which argument answered no (inhabitance_position_with_argument_path).
fn position_direct_call_argument() -> DeclaredTypePosition {
  PositionDirectCallArgument { argument_ordinal_path: [] }
}

fn position_declared_return() -> DeclaredTypePosition {
  PositionDeclaredReturn { argument_ordinal_path: [] }
}

fn position_record_field(record: Node) -> DeclaredTypePosition {
  PositionRecordField { record: record }
}

fn position_match_coverage(match_node: Node, scrutinee: Node) -> DeclaredTypePosition {
  PositionMatchCoverage { match_node: match_node, scrutinee: scrutinee }
}

// An annotated let (`let x: T = e`) is a declared position like the others, not a cast. Its
// obligation is located at the authored annotation (the declared type the author wrote, as a
// declared return is located at the body it judges), and the position names the bound value e
// whose type did not inhabit it.
fn position_let_annotation(bound: Node) -> DeclaredTypePosition {
  PositionLetAnnotation { bound: bound }
}

// A binder's default (XL-2 PR2c-ii) is a declared position like the others: its value is judged at the
// binder's declared type, the type an omitted argument or field is declared to have. The obligation is
// located at the default, and the position names it.
fn position_binder_default(default: Node) -> DeclaredTypePosition {
  PositionBinderDefault { default: default }
}

fn inhabitance_position_symbol(position: DeclaredTypePosition) -> Symbol {
  match position {
    PositionDirectCallArgument { argument_ordinal_path: _ } => ^position_direct_call_argument
    PositionDeclaredReturn { argument_ordinal_path: _ } => ^position_declared_return
    PositionRecordField { record: _ } => ^position_record_field
    PositionLetAnnotation { bound: _ } => ^position_let_annotation
    PositionBinderDefault { default: _ } => ^position_binder_default
    PositionMatchCoverage { match_node: _, scrutinee: _ } => ^position_match_coverage
  }
}

fn inhabitance_declared_singleton(declared: Node) -> CandidateSet {
  CandidateSet {
    candidates: [declared],
    closedness: StructuralPropertyWitness {
      property: ^inhabitance_declared_singleton_closed,
      evidence: declared
    }
  }
}

// A TYPE MENTIONS A TYPE VARIABLE WHEN ANY ATOM IN IT IS SPELLED AS ONE. v2.compiler.resolve refuses
// a type parameter that shadows a visible name, so inside the declaring Arrow that spelling means
// the binder and nothing else -- whether it stands bare (`x: T`) or as an Instantiation's head
// or argument (`Box<T>`, `T` lowered as Instantiation[T]).
fn inhabitance_node_mentions_type_variable(n: Node, type_variables: List<Symbol>) -> Bool {
  fold(node_subtree_nodes(root: n), init: false, f: fn(acc, m) {
    acc || (match m.kind {
      TypeNode { connective: Atom { identity: id } } =>
        fold(type_variables, init: false, f: fn(found, v) { found || (v == id) })
      _ => false
    })
  })
}

// A TYPE IS DECIDED UNLESS IT MENTIONS A TYPE VARIABLE. An applied type whose constructor and
// arguments are all established (`Outcome<Node>`) is a type node like any other, and
// exact_structural_equality_zip_fold compares it argument by argument, so `Outcome<Record>` at
// `Outcome<Node>` refuses. A type that mentions one of the declaring Arrow's type variables -- bare
// (`-> T`) or inside an Instantiation (`Box<T>`) -- stays UndecidableGenericFormal: this relation
// holds no instance for the variable, and comparing its spelling against a concrete type would
// refuse for the wrong reason. The check reads the variable first, so no connective arm can decide
// a type that carries one.
fn inhabitance_node_undecidable_reason(
  n: Node,
  type_variables: List<Symbol>
) -> Optional<InhabitanceUndecidableReason> {
  if inhabitance_node_mentions_type_variable(n: n, type_variables: type_variables) {
    optional_present(value: UndecidableGenericFormal)
  } else {
    Absent
  }
}

fn inhabitance_pair_undecidable_reason_declared_then_produced(
  declared: Node,
  produced: Node,
  type_variables: List<Symbol>
) -> Optional<InhabitanceUndecidableReason> {
  match inhabitance_node_undecidable_reason(n: declared, type_variables: type_variables) {
    Present { value: reason } => optional_present(value: reason)
    Absent => inhabitance_node_undecidable_reason(n: produced, type_variables: type_variables)
  }
}

// THE NOMINAL HEAD OF A TYPE: the declaration an Instantiation applies (its first positional target), or
// the node itself. Absent when the head is not a declaration reference (a type variable, a kernel atom).
fn inhabitance_declaration_head(t: Node) -> Optional<QualifiedName> {
  match declaration_denotation_of_type(t: t) {
    Absent => Absent
    Present { value: denotation } => Present { value: denotation.declaration }
  }
}

// TWO DISTINCT NOMINAL DECLARATIONS ARE DECIDED WHATEVER THEIR ARGUMENTS. Introduction is nominal, so no
// instantiation of a type variable inside `FreeMonoid<T>` makes it a `FreeSemigroup<Int>`: a variable in
// the arguments undecides the argument comparison, never a head mismatch. This is what lets a produced
// generic nullary variant (`Empty`) refuse at a product position instead of being counted unread.
fn inhabitance_declaration_heads_differ(declared: Node, produced: Node) -> Bool {
  match inhabitance_declaration_head(t: declared) {
    Absent => false
    Present { value: d } =>
      match inhabitance_declaration_head(t: produced) {
        Absent => false
        Present { value: p } => !(d == p)
      }
  }
}

// A CONCRETE PAIR (no type variable on either side) DISAGREES WHEN THE EXACT STRUCTURAL COMPARISON REFUSES IT:
// the same find_witness fold declared_type_inhabitance_exact runs, asked only for its refusal.
fn inhabitance_concrete_pair_disagrees(declared: Node, produced: Node) -> Bool {
  match find_witness(
    source_facts: produced,
    candidates: inhabitance_declared_singleton(declared: declared),
    predicate: PreservationPredicate {
      algebra: produced,
      preservation_rule: ^preservation_rule_exact_structural_equality_zip_fold
    },
    multiplicity_policy: UniqueOnly
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

// THREE-VALUED PER POSITION: a type variable undecides only ITS OWN POSITION, never its siblings. A pair
// DISAGREES when some position that mentions no variable is concretely refused, or two distinct nominal
// heads meet; a position that mentions a variable and agrees in head is read argument by argument. A
// disagreeing sibling wins over an undecided position (`Map<K, String>` at `Map<K, Int>` refuses on V
// whatever K is); where no sibling disagrees the pair stays undecided, because the variable's position
// may still disagree once instantiated.
fn inhabitance_positions_disagree(declared: Node, produced: Node, type_variables: List<Symbol>) -> Bool {
  if inhabitance_node_mentions_type_variable(n: declared, type_variables: type_variables)
    || inhabitance_node_mentions_type_variable(n: produced, type_variables: type_variables) {
    if inhabitance_declaration_heads_differ(declared: declared, produced: produced) {
      true
    } else {
      match declaration_denotation_of_type(t: declared) {
        Absent => false
        Present { value: dd } =>
          match declaration_denotation_of_type(t: produced) {
            Absent => false
            Present { value: pd } =>
              inhabitance_argument_lists_disagree(declared: dd.type_arguments, produced: pd.type_arguments, type_variables: type_variables)
          }
      }
    }
  } else {
    inhabitance_concrete_pair_disagrees(declared: declared, produced: produced)
  }
}

fn inhabitance_argument_lists_disagree(declared: List<Node>, produced: List<Node>, type_variables: List<Symbol>) -> Bool {
  match declared {
    Empty => false
    Cons { head: d, tail: dt } =>
      match produced {
        Empty => false
        Cons { head: p, tail: pt } =>
          inhabitance_positions_disagree(declared: d, produced: p, type_variables: type_variables)
            || inhabitance_argument_lists_disagree(declared: dt, produced: pt, type_variables: type_variables)
      }
  }
}

fn inhabitance_pair_undecidable_reason(
  declared: Node,
  produced: Node,
  type_variables: List<Symbol>
) -> Optional<InhabitanceUndecidableReason> {
  if inhabitance_declaration_heads_differ(declared: declared, produced: produced)
    || inhabitance_positions_disagree(declared: declared, produced: produced, type_variables: type_variables) {
    Absent
  } else {
    inhabitance_pair_undecidable_reason_declared_then_produced(declared: declared, produced: produced, type_variables: type_variables)
  }
}

// DIVERGES FROM v2.std.coercion coercion_fold / coercion_fold_exact_structural (§3b).
// Same procedure: find_witness over candidates with preservation_rule_exact_structural_equality_zip_fold
// and HomomorphismWitness { rule: homomorphism_rule_exact_structural_equality }. Different question:
// coercion_fold selects a target-language inhabitant spelling (CoercionCandidateSet, TargetSelectionPolicy,
// CoercionMismatchKind, CanonicalGrounding source). This fold asks whether one produced type inhabits one
// declared formal (UniqueOnly over the singleton {declared}). Routing through coercion_fold would nickname
// target-selection as typechecking. Application refusal maps find_witness_reason_no_candidate to
// application_argument_does_not_inhabit, not CoercionMismatchKind.NoTargetCandidate.
// DIVERGES FROM v2.std.refinement_widening_predicate refinement_widening_preservation_holds (§3b, §4d).
// That rule is realized in find_witness's roster, but it preserves a value-set algebra
// (refinement_widening_predicate_algebra_for_value_sets), not a pair of application type nodes.
// Calling it with algebra: produced would never hold, so it would not admit a widening-legal argument.
// Rung, ceiling, and next-rung triggers live in
// gunbc.recurring_failure_mode.argument_type_obligation_absent_while_the_route_advances.
// AN OPTIONAL PRODUCED AT A REQUIRED DECLARED TYPE IS DECIDED: IT DOES NOT INHABIT. `T?` admits
// absence and a required type admits no absent value, so a produced std.optional Instantiation (the type
// `T?` lowers to; v2.std.node_query declared_field_cardinality_of_target reads the same node as
// Optional) inhabits no required declared type, whatever T is. UndecidableOptionalCarrier was
// written for the LIFT direction -- a produced `T` at a declared `T?` -- and, read off either side,
// it swallowed this converse and admitted it with an advisory
// (gunbc.recurring_failure_mode optional_admitted_where_a_required_value_is_declared; the seed's
// relation refuses the same pair, v1.compiler.infer optional_produced_at_required_declared).
//
// THE DECLARED SIDE IS KNOWN REQUIRED ONLY WHEN IT IS AN ATOM THAT IS NOT A TYPE VARIABLE: a kernel
// value type as the judge's denotation hands it over. A declared type variable may be instantiated
// at an optional. A declared declaration reference may name an alias of an optional type
// (`type Maybe = Int?`), and a declared Instantiation may be the nominal Optional, and this
// relation unfolds neither -- so against those a produced optional stays the counted
// UndecidableOptionalCarrier it was, never refused on a guess. A declared `T?` is the lift and
// optional-at-optional cases, unchanged.
fn inhabitance_optional_produced_at_required_declared(
  declared: Node,
  produced: Node,
  type_variables: List<Symbol>
) -> Bool {
  match declaration_denotation_of_type(t: produced) {
    Present { value: denotation } =>
      declaration_denotation_is_optional(denotation: denotation)
        && (match declared.kind {
          TypeNode { connective: Atom { identity: _ } } =>
            (count(declared.children) == 0)
              && !inhabitance_node_mentions_type_variable(n: declared, type_variables: type_variables)
          _ => false
        })
    Absent => false
  }
}

fn inhabitance_optional_at_required_reason() -> Symbol {
  ^inhabitance_optional_produced_at_required_declared
}

fn inhabitance_optional_layer_depth_mismatch_reason() -> Symbol {
  ^inhabitance_optional_layer_depth_mismatch
}

fn inhabitance_optional_layer_wrapper_malformed_reason() -> Symbol {
  ^inhabitance_optional_layer_wrapper_malformed
}

// Malformed is not "no depth mismatch": a Bool false conflated those arms.
type OptionalLayerInhabitanceVerdict
  = OptionalLayerInhabitanceHolds
  | OptionalLayerDepthMismatch
  | OptionalLayerWrapperMalformed

fn inhabitance_optional_layer_judgement(declared: Node, produced: Node) -> OptionalLayerInhabitanceVerdict {
  match type_node_occupancy_read(n: declared) {
    OccupancyWrapperMalformed { wrapper: _ } => OptionalLayerWrapperMalformed
    TypeNodeOccupancy { depth: dc, base: _ } =>
      match type_node_occupancy_read(n: produced) {
        OccupancyWrapperMalformed { wrapper: _ } => OptionalLayerWrapperMalformed
        TypeNodeOccupancy { depth: pc, base: _ } =>
          match dc {
            Zero => OptionalLayerInhabitanceHolds
            Succ { prev: _ } =>
              match pc {
                Zero => OptionalLayerInhabitanceHolds
                Succ { prev: _ } =>
                  if dc == pc {
                    OptionalLayerInhabitanceHolds
                  } else {
                    OptionalLayerDepthMismatch
                  }
              }
          }
      }
  }
}

fn declared_type_inhabitance(obligation: DeclaredTypeObligation) -> InhabitanceVerdict {
  if inhabitance_optional_produced_at_required_declared(
    declared: obligation.declared,
    produced: obligation.produced,
    type_variables: obligation.type_variables
  ) {
    InhabitanceRefused { find_witness_reason: inhabitance_optional_at_required_reason(), refusal_class: RefusalStructuralMismatch, position: obligation.position }
  } else {
    match inhabitance_optional_layer_judgement(declared: obligation.declared, produced: obligation.produced) {
      OptionalLayerDepthMismatch =>
        InhabitanceRefused { find_witness_reason: inhabitance_optional_layer_depth_mismatch_reason(), refusal_class: RefusalStructuralMismatch, position: obligation.position }
      OptionalLayerWrapperMalformed =>
        InhabitanceRefused { find_witness_reason: inhabitance_optional_layer_wrapper_malformed_reason(), refusal_class: RefusalStructuralMismatch, position: obligation.position }
      OptionalLayerInhabitanceHolds => declared_type_inhabitance_optional(obligation: obligation)
    }
  }
}

// AN ARROW AT AN ARROW IS ITS DOMAIN TYPES, POSITIONALLY, AND ITS RETURN. Parameter names and a body are
// not part of what a callable inhabits: a named fn `fn(n: Int) -> Bool` and a lambda spelled `fn(x: Int)`
// are one signature, so both sides are re-assembled through anonymous_signature_arrow (the one assembler
// of a bodiless signature, whose binders are positional) and compared by the same exact structural
// equality as every other type. This is the ONE judge for argument, declared-return and record-field
// positions. A signature this arm does not normalize -- one that declares type parameters, whose order
// cannot be read, or whose domain or return itself holds an Arrow -- stays on the exact comparison it
// had before, which decides and may refuse; it is never widened to an advisory acceptance. Recursive
// normalization of a nested Arrow is the climb.
type ArrowSignatureRead
  = ArrowSignatureTypes { domain_types: List<Node>, codomain: Node }
  | ArrowSignatureUnreadable

fn inhabitance_arrow_signature_read(arrow: Node) -> ArrowSignatureRead {
  if fold(arrow.children, init: false, f: fn(acc, e) { acc || edge_is_type_params(e: e) }) {
    ArrowSignatureUnreadable
  } else {
    match arrow_declared_parameter_order(arrow: arrow) {
      ArrowParameterOrderAbsent => ArrowSignatureUnreadable
      ArrowParameterOrderMalformed => ArrowSignatureUnreadable
      ArrowParameterOrderDeclared { labels: labels } =>
        let positional = positional_child_target_nodes(node: arrow)
        match list_at_optional(xs: positional, index: 0) {
          Absent => ArrowSignatureUnreadable
          Present { value: domain } =>
            match list_at_optional(xs: positional, index: 1) {
              Absent => ArrowSignatureUnreadable
              Present { value: codomain } =>
                inhabitance_arrow_signature_types(domain: domain, codomain: codomain, labels: labels)
            }
        }
    }
  }
}

fn inhabitance_arrow_signature_types(domain: Node, codomain: Node, labels: List<Symbol>) -> ArrowSignatureRead {
  let types_by_label = fold(domain.children, init: empty_map(), f: fn(acc, e) {
    match declared_field_from_edge(e: e) {
      Present { value: binder } => map_insert(m: acc, key: binder.name, value: binder.type_node)
      Absent => acc
    }
  })
  let ordered = fold(labels, init: Present { value: Empty }, f: fn(acc, l) {
    match acc {
      Absent => Absent
      Present { value: types } =>
        match map_lookup(m: types_by_label, key: l) {
          Present { value: t } => Present { value: list_snoc_item(xs: types, item: t) }
          Absent => Absent
        }
    }
  })
  match ordered {
    Absent => ArrowSignatureUnreadable
    Present { value: types } =>
      if inhabitance_signature_holds_arrow(domain_types: types, codomain: codomain) {
        ArrowSignatureUnreadable
      } else {
        ArrowSignatureTypes { domain_types: types, codomain: codomain }
      }
  }
}

fn inhabitance_signature_holds_arrow(domain_types: List<Node>, codomain: Node) -> Bool {
  fold(node_subtree_nodes(root: codomain), init: false, f: fn(acc, m) { acc || node_is_arrow(n: m) })
    || fold(domain_types, init: false, f: fn(acc, t) {
      acc || fold(node_subtree_nodes(root: t), init: false, f: fn(a, m) { a || node_is_arrow(n: m) })
    })
}

fn inhabitance_with_payloads(obligation: DeclaredTypeObligation, declared: Node, produced: Node, carrier: Optional<Node>) -> DeclaredTypeObligation {
  DeclaredTypeObligation {
    position: obligation.position,
    parameter_identity: obligation.parameter_identity,
    declared: declared,
    produced: produced,
    produced_declared_carrier: carrier,
    application: obligation.application,
    type_variables: obligation.type_variables
  }
}

// AN OPTIONAL IS JUDGED AS THE std.optional INSTANCE IT DENOTES, SO ITS PAYLOAD IS JUDGED. `T?` (Occupancy)
// and an applied `Optional<T>` (Instantiation) are two spellings of one declaration, and
// v2.std.qualified_name declaration_denotation_of_type reads both as optional_declaration_identity()
// applied to one payload. The relation therefore peels the optional layer on the declared side by
// declaration identity (v2.std.optional_layers type_node_occupancy_child) and judges the payload at the payload: an optional produced at an optional
// compares payloads (`Optional<String>` at `Int?` refuses on String against Int), and a value that is
// not an optional is NOT lifted: the authoring policy is explicit Present (gunbc.design_ruling
// explicit_present_is_the_authoring_policy), so it is judged structurally against the optional and refuses. A produced optional layer
// against a declared payload that is not an optional is the optional-at-required refusal; a declared
// payload that is an optional against a produced payload that is not one is a depth mismatch
// (only the lift from a non-optional spans several layers). The class is
// gunbc.recurring_failure_mode optional_admitted_where_a_required_value_is_declared (its v2 route).
fn declared_type_inhabitance_optional(obligation: DeclaredTypeObligation) -> InhabitanceVerdict {
  match type_node_occupancy_child(n: obligation.declared) {
    Absent => declared_type_inhabitance_structural(obligation: obligation)
    Present { value: declared_payload } =>
      match type_node_occupancy_child(n: obligation.produced) {
        Present { value: produced_payload } =>
          match type_node_occupancy_child(n: declared_payload) {
            Present { value: _ } =>
              match type_node_occupancy_child(n: produced_payload) {
                Absent => InhabitanceRefused { find_witness_reason: inhabitance_optional_layer_depth_mismatch_reason(), refusal_class: RefusalStructuralMismatch, position: obligation.position }
                Present { value: _ } =>
                  declared_type_inhabitance(obligation: inhabitance_with_payloads(obligation: obligation, declared: declared_payload, produced: produced_payload, carrier: Absent))
              }
            Absent =>
              declared_type_inhabitance(obligation: inhabitance_with_payloads(obligation: obligation, declared: declared_payload, produced: produced_payload, carrier: Absent))
          }
        Absent => declared_type_inhabitance_structural(obligation: obligation)
      }
  }
}

// A RIGID TYPE VARIABLE IS DECIDED AGAINST A TYPE THAT MENTIONS NONE. Inside the declaring Arrow a type
// parameter names exactly one unknown type, so no concrete declared type is inhabited by a produced type
// that mentions it: `fn r<T>(x: T) -> Int? { Present { value: x } }` produces T at a declared `Int`, and
// that refuses by the structural comparison like any other mismatch. Only a call argument position keeps
// the variables flexible (the callee's formals, instantiated or not yet instantiated at that call), so
// only there does a mention stay UndecidableGenericFormal.
fn inhabitance_judged_type_variables(obligation: DeclaredTypeObligation) -> List<Symbol> {
  match obligation.position {
    PositionDirectCallArgument { argument_ordinal_path: _ } => obligation.type_variables
    PositionDeclaredReturn { argument_ordinal_path: _ } => inhabitance_rigid_type_variables(obligation: obligation)
    PositionRecordField { record: _ } => inhabitance_rigid_type_variables(obligation: obligation)
    PositionLetAnnotation { bound: _ } => inhabitance_rigid_type_variables(obligation: obligation)
    PositionBinderDefault { default: _ } => inhabitance_rigid_type_variables(obligation: obligation)
    PositionMatchCoverage { match_node: _, scrutinee: _ } => inhabitance_rigid_type_variables(obligation: obligation)
  }
}

fn inhabitance_rigid_type_variables(obligation: DeclaredTypeObligation) -> List<Symbol> {
  if inhabitance_node_mentions_type_variable(n: obligation.declared, type_variables: obligation.type_variables) {
    obligation.type_variables
  } else {
    []
  }
}

fn declared_type_inhabitance_structural(obligation: DeclaredTypeObligation) -> InhabitanceVerdict {
  match inhabitance_pair_undecidable_reason(
    declared: obligation.declared,
    produced: obligation.produced,
    type_variables: inhabitance_judged_type_variables(obligation: obligation)
  ) {
    Present { value: reason } => InhabitanceUndecidable { reason: reason }
    Absent =>
      if node_is_arrow(n: obligation.declared) && node_is_arrow(n: obligation.produced) {
        declared_type_inhabitance_arrow(obligation: obligation)
      } else {
        declared_type_inhabitance_exact(obligation: obligation)
      }
  }
}

fn declared_type_inhabitance_arrow(obligation: DeclaredTypeObligation) -> InhabitanceVerdict {
  match inhabitance_arrow_signature_read(arrow: obligation.declared) {
    ArrowSignatureUnreadable => declared_type_inhabitance_exact(obligation: obligation)
    ArrowSignatureTypes { domain_types: dd, codomain: dc } =>
      match inhabitance_arrow_signature_read(arrow: obligation.produced) {
        ArrowSignatureUnreadable => declared_type_inhabitance_exact(obligation: obligation)
        ArrowSignatureTypes { domain_types: pd, codomain: pc } =>
          declared_type_inhabitance_exact(obligation: DeclaredTypeObligation {
            position: obligation.position,
            parameter_identity: obligation.parameter_identity,
            declared: anonymous_signature_arrow(domain_types: dd, codomain: dc, source: obligation.declared),
            produced: anonymous_signature_arrow(domain_types: pd, codomain: pc, source: obligation.produced),
            produced_declared_carrier: obligation.produced_declared_carrier,
            application: obligation.application,
            type_variables: obligation.type_variables
          })
      }
  }
}

fn declared_type_inhabitance_exact(obligation: DeclaredTypeObligation) -> InhabitanceVerdict {
  match inhabitance_pair_undecidable_reason(
    declared: obligation.declared,
    produced: obligation.produced,
    type_variables: inhabitance_judged_type_variables(obligation: obligation)
  ) {
    Present { value: reason } => InhabitanceUndecidable { reason: reason }
    Absent =>
      match find_witness(
        source_facts: obligation.produced,
        candidates: inhabitance_declared_singleton(declared: obligation.declared),
        predicate: PreservationPredicate {
          algebra: obligation.produced,
          preservation_rule: ^preservation_rule_exact_structural_equality_zip_fold
        },
        multiplicity_policy: UniqueOnly
      ) {
        Accepted { value: fw, diagnostics: _ } =>
          Inhabits {
            homomorphism: HomomorphismWitness {
              rule: ^homomorphism_rule_exact_structural_equality,
              evidence: fw.witness.evidence
            }
          }
        Rejected { diagnostics: r } =>
          declared_type_inhabitance_declared_carrier(
            obligation: obligation,
            exact_refusal: declared_type_inhabitance_refusal(
              obligation: obligation,
              find_witness_reason: diagnostics_fatal_reason(d: r)
            )
          )
      }
  }
}

// A REFINED VALUE INHABITS ITS DECLARED CARRIER (subsumption). `type Pos = Int where positive`: every
// Pos is an Int, so a produced Pos inhabits a declared Int. Reached only after the exact comparison
// refused, and only for the carrier the refinement's declaration states -- one step, never walked:
// a produced Pos2 (`type Pos2 = Pos where ..`) inhabits Pos and not Int, and a sibling refinement of
// the same carrier (Neg at Pos) refuses. The carrier is SUPPLIED by the producer of the obligation
// (v2.compiler.infer refinement_declared_carrier over ResolvedTree.resolved_declarations), because
// reading a declaration is resolution's fact, not this relation's; Absent -- not a refinement, or a
// lookup miss -- leaves the exact refusal standing, never admits. No predicate is evaluated: widening
// forgets the predicate, it does not check one. The optional-at-required refusal is decided before
// this half (declared_type_inhabitance), so a refinement of an optional cannot widen past it.
fn declared_type_inhabitance_declared_carrier(
  obligation: DeclaredTypeObligation,
  exact_refusal: InhabitanceVerdict
) -> InhabitanceVerdict {
  match obligation.produced_declared_carrier {
    Absent => exact_refusal
    Present { value: carrier } =>
      match find_witness(
        source_facts: carrier,
        candidates: inhabitance_declared_singleton(declared: obligation.declared),
        predicate: PreservationPredicate {
          algebra: carrier,
          preservation_rule: ^preservation_rule_exact_structural_equality_zip_fold
        },
        multiplicity_policy: UniqueOnly
      ) {
        Accepted { value: fw, diagnostics: _ } =>
          Inhabits {
            homomorphism: HomomorphismWitness {
              rule: ^homomorphism_rule_refinement_declared_carrier,
              evidence: fw.witness.evidence
            }
          }
        Rejected { diagnostics: _ } => exact_refusal
      }
  }
}

// WHAT A POSITION ADDS TO ITS REFUSAL BEYOND THE SITE, THE FORMAL AND THE TWO TYPES. A record field
// names the record it is a field of; an argument and a declared return are already named by the
// site they are located at.
fn inhabitance_position_context_edges(position: DeclaredTypePosition) -> List<Edge> {
  match position {
    PositionDirectCallArgument { argument_ordinal_path: _ } => []
    PositionDeclaredReturn { argument_ordinal_path: _ } => []
    PositionRecordField { record: record } => [Edge { label: Authored { name: ^inhabitance_record }, target: record, declaration: NotADeclaration }]
    PositionLetAnnotation { bound: bound } => [Edge { label: Authored { name: ^inhabitance_bound_value }, target: bound, declaration: NotADeclaration }]
    PositionBinderDefault { default: default } => [Edge { label: Authored { name: ^inhabitance_default_value }, target: default, declaration: NotADeclaration }]
    PositionMatchCoverage { match_node: _, scrutinee: scrutinee } => [Edge { label: Authored { name: ^inhabitance_scrutinee }, target: scrutinee, declaration: NotADeclaration }]
  }
}

// WHY THE REFUSAL IS NAMED BY WHAT DECIDED IT. v2.std.find_witness folds a Bool, so on refusal it can
// only report "no candidate matched"; the old code renamed that by the POSITION it was asked at, which
// told a reader where the question was asked and nothing about which question answered no. Nine
// gunbc.recurring_failure_mode rows then cited one position-named reason -- the old
// `arrow body does not inhabit the declared return` symbol, retired by this change -- for nine different
// mechanisms, and no row could say which shape refused for which reason. The decision comes
// from the same two nodes the fold just compared, through the one verdict in
// v2.std.exact_structural_equality_zip_fold_predicate, so there is one decision and not two. The class of
// the refusal travels with the reason it produced: nothing re-derives it from the symbol later.
fn declared_type_inhabitance_refusal(
  obligation: DeclaredTypeObligation,
  find_witness_reason: Symbol
) -> InhabitanceVerdict {
  let refusal_decision = declared_type_inhabitance_refusal_decision(obligation: obligation, find_witness_reason: find_witness_reason)
  InhabitanceRefused {
    find_witness_reason: refusal_decision.reason,
    refusal_class: refusal_decision.refusal_class,
    // the site the obligation names, with the path the decision came through written into it
    position: inhabitance_position_with_argument_path(position: obligation.position, argument_ordinal_path: refusal_decision.argument_ordinal_path)
  }
}

// The decision for a refusal of the exact comparison: when the fold itself declined for a reason of its
// own (a preservation rule that is not realized, an ambiguous candidate set, an invalid witness) that
// reason carries its own class; when the fold found no candidate the structural verdict says which
// question answered no and which class that question is.
fn declared_type_inhabitance_refusal_decision(
  obligation: DeclaredTypeObligation,
  find_witness_reason: Symbol
) -> InhabitanceStructuralDecision {
  if find_witness_reason == ^find_witness_reason_no_candidate {
    inhabitance_structural_decision(comparison: exact_structural_comparison(source_facts: obligation.produced, algebra: obligation.produced, candidate: obligation.declared, type_variables: obligation.type_variables))
  } else {
    InhabitanceStructuralDecision { refusal_class: RefusalWitnessSearchDecision, reason: find_witness_reason, argument_ordinal_path: [] }
  }
}

// WHICH CLASS A REFUSAL BELONGS TO, decided exhaustively over every arm the verdict can have
// (keen-heron-809's condition on this PR). A closed set of symbols plus a default would let the next arm
// anyone adds inherit "does not inhabit" silently; this match has no default, so adding an arm to
// ExactStructuralComparison breaks the build until its class is named.
type InhabitanceRefusalClass
  = RefusalStructuralMismatch
  | RefusalComparisonCouldNotRun
  | RefusalWitnessSearchDecision

// `argument_ordinal_path` is the path the answering arm carries: [] when the arm was decided at this
// pair, or at a refusal that never compared a pair at all (the could-not-run family, and a fold's own
// decision), where there is no position to name.
type InhabitanceStructuralDecision { refusal_class: InhabitanceRefusalClass, reason: Symbol, argument_ordinal_path: List<Nat> }

// A nested pair's decision, reported at the pair that contains it: the mechanism and the arm are the
// nested one's, and the path grows by the ordinal of the argument it came through. This is the ONLY way a
// containment level touches a decision, and it never changes which arm answered no -- the level above does
// not get to relabel a roots-differ as its own `arguments_differ` symptom (keen-heron-809: `Foo<A>` versus
// `Foo<B>` is roots_differ at [0], propagated, not flattened).
fn inhabitance_decision_through_argument(
  decision: InhabitanceStructuralDecision,
  ordinal: Nat
) -> InhabitanceStructuralDecision {
  InhabitanceStructuralDecision {
    refusal_class: decision.refusal_class,
    reason: decision.reason,
    argument_ordinal_path: list_snoc_item(xs: decision.argument_ordinal_path, item: ordinal)
  }
}

// The position the refusal names: the obligation's site with the decision's path written into the arms
// that can nest. The four node-carrying arms pass through unchanged -- their position IS a node, and an
// argument ordinal of a type is not a fact about a record field, a binding, a default or an arm cover.
fn inhabitance_position_with_argument_path(
  position: DeclaredTypePosition,
  argument_ordinal_path: List<Nat>
) -> DeclaredTypePosition {
  match position {
    PositionDirectCallArgument { argument_ordinal_path: _ } => PositionDirectCallArgument { argument_ordinal_path: argument_ordinal_path }
    PositionDeclaredReturn { argument_ordinal_path: _ } => PositionDeclaredReturn { argument_ordinal_path: argument_ordinal_path }
    PositionRecordField { record: record } => PositionRecordField { record: record }
    PositionLetAnnotation { bound: bound } => PositionLetAnnotation { bound: bound }
    PositionBinderDefault { default: default } => PositionBinderDefault { default: default }
    PositionMatchCoverage { match_node: match_node, scrutinee: scrutinee } => PositionMatchCoverage { match_node: match_node, scrutinee: scrutinee }
  }
}

fn inhabitance_structural_decision(comparison: ExactStructuralComparison) -> InhabitanceStructuralDecision {
  match comparison {
    // THE COMPARISON-COULD-NOT-RUN FAMILY: these arms do not answer the inhabitance question. They say the
    // structural comparison produced no verdict on the pair -- an input was not a well-formed node, the
    // algebra was not the source facts, or the fold declined while the two sides agreed, which is an
    // internal defect. An upstream or internal defect, and never a claim that the value's type is wrong.
    ComparisonHolds =>
      InhabitanceStructuralDecision { refusal_class: RefusalComparisonCouldNotRun, reason: ^inhabitance_comparison_witness_absent_under_holding_comparison, argument_ordinal_path: [] }
    ComparisonSourceFactsMalformed =>
      InhabitanceStructuralDecision { refusal_class: RefusalComparisonCouldNotRun, reason: ^inhabitance_comparison_source_facts_malformed, argument_ordinal_path: [] }
    ComparisonAlgebraMalformed =>
      InhabitanceStructuralDecision { refusal_class: RefusalComparisonCouldNotRun, reason: ^inhabitance_comparison_algebra_malformed, argument_ordinal_path: [] }
    ComparisonCandidateMalformed =>
      InhabitanceStructuralDecision { refusal_class: RefusalComparisonCouldNotRun, reason: ^inhabitance_comparison_candidate_malformed, argument_ordinal_path: [] }
    ComparisonAlgebraNotTheSourceFacts =>
      InhabitanceStructuralDecision { refusal_class: RefusalComparisonCouldNotRun, reason: ^inhabitance_comparison_algebra_not_source_facts, argument_ordinal_path: [] }
    // THE MISMATCH FAMILY: the only arms that answer the inhabitance question. The comparison ran and the
    // produced type does not inhabit the declared one, which is a type error at the obligation.
    // the path travels with the arm that answered no, so a decision never loses where it was decided
    ComparisonRootsDiffer { argument_ordinal_path: argument_ordinal_path } =>
      InhabitanceStructuralDecision { refusal_class: RefusalStructuralMismatch, reason: ^inhabitance_structural_roots_differ, argument_ordinal_path: argument_ordinal_path }
    ComparisonArgumentCountDiffers { source_arity: _, candidate_arity: _, argument_ordinal_path: argument_ordinal_path } =>
      InhabitanceStructuralDecision { refusal_class: RefusalStructuralMismatch, reason: ^inhabitance_structural_argument_count_differs, argument_ordinal_path: argument_ordinal_path }
    ComparisonArgumentsDiffer { argument_ordinal_path: argument_ordinal_path } =>
      InhabitanceStructuralDecision { refusal_class: RefusalStructuralMismatch, reason: ^inhabitance_structural_arguments_differ, argument_ordinal_path: argument_ordinal_path }
    // The comparison ran out at a position it holds no instance for. The relation answers Undecidable for
    // that today through its own variable check; this arm is the same fact coming out of the ONE decision,
    // and #15903 turns that check into a consumer of it (its separate fold over the argument list is the
    // same rule twice, which keen-heron-809 ruled a fork to delete). Classed as could-not-run because that
    // is exactly what happened: no pair at that position could be compared.
    ComparisonUndecidedTypeVariable { argument_ordinal_path: argument_ordinal_path } =>
      InhabitanceStructuralDecision { refusal_class: RefusalComparisonCouldNotRun, reason: ^inhabitance_comparison_pair_undecided_type_variable, argument_ordinal_path: argument_ordinal_path }
  }
}

// THE DIAGNOSTIC SHARED BY REFUSALS THAT DO NOT ANSWER THE INHABITANCE QUESTION. No suggested node: the
// value's type is not what is wrong, so there is no edit at this site that would make it inhabit. For a
// comparison-could-not-run refusal the fix lives in whatever produced the unreadable input; for a reason
// whose class no decision named, the honest answer is that this site does not know what kind of refusal it
// is, and it must not borrow a type-error diagnostic to look like one.
fn inhabitance_refusal_without_suggestion_diagnostic(
  obligation: DeclaredTypeObligation,
  find_witness_reason: Symbol,
  // the judgment position of this refusal, already carrying the argument ordinal path of the decision
  // that refused: it travels with the verdict, so the diagnostic never re-derives it
  position: DeclaredTypePosition
) -> Diagnostic {
  Diagnostic {
    reason: find_witness_reason,
    at: inhabitance_judgment_locus(position: position, node: obligation.application),
    correction: Unavailable { reason: CorrectionNotModeled }
  }
}

// THE DIAGNOSTIC CLASS, chosen in std beside the reasons rather than at the reporting site (criterion: the
// decision lives in inhabitance). A structural mismatch, or a refusal whose own decision already named what
// it declined, keeps application_argument_does_not_inhabit_diagnostic -- its suggested node is the evidence
// of the shape difference, and claims read its ^inhabitance_produced_type edge. Everything else is refused
// without a suggestion, so a reader is never sent to fix a type error the compiler never showed.
fn inhabitance_refusal_diagnostic(
  obligation: DeclaredTypeObligation,
  refusal_class: InhabitanceRefusalClass,
  find_witness_reason: Symbol,
  // the judgment position of this refusal, already carrying the argument ordinal path of the decision that
  // refused; it is written into the diagnostic's own slot, so a reader of a refusal about a nested
  // argument sees that argument and not only the outer position
  position: DeclaredTypePosition
) -> Diagnostic {
  match refusal_class {
    RefusalStructuralMismatch => application_argument_does_not_inhabit_diagnostic(obligation: obligation, find_witness_reason: find_witness_reason, position: position)
    RefusalWitnessSearchDecision => application_argument_does_not_inhabit_diagnostic(obligation: obligation, find_witness_reason: find_witness_reason, position: position)
    RefusalComparisonCouldNotRun => inhabitance_refusal_without_suggestion_diagnostic(obligation: obligation, find_witness_reason: find_witness_reason, position: position)
  }
}

fn undecidable_formal_unresolved() -> InhabitanceUndecidableReason {
  UndecidableFormalUnresolved
}

fn undecidable_argument_type_not_derived() -> InhabitanceUndecidableReason {
  UndecidableArgumentTypeNotDerived
}

fn undecidable_where_predicate_subject_unmodelled() -> InhabitanceUndecidableReason {
  UndecidableWherePredicateSubjectUnmodelled
}

fn inhabitance_undecidable_reason_symbol(
  reason: InhabitanceUndecidableReason
) -> Symbol {
  match reason {
    UndecidableGenericFormal => ^inhabitance_undecidable_generic_formal
    UndecidableFormalUnresolved => ^inhabitance_undecidable_formal_unresolved
    UndecidableArgumentTypeNotDerived => ^inhabitance_undecidable_argument_type_not_derived
    UndecidableWherePredicateSubjectUnmodelled => ^inhabitance_undecidable_where_predicate_subject_unmodelled
  }
}

fn inhabitance_undecidable_diagnostic(
  application: Node,
  reason: InhabitanceUndecidableReason
) -> Diagnostic {
  Diagnostic {
    reason: inhabitance_undecidable_reason_symbol(reason: reason),
    at: node_locus(node: application),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn application_positional_surplus_reason() -> Symbol {
  ^application_positional_surplus
}

fn application_positional_deficit_reason() -> Symbol {
  ^application_positional_deficit
}

fn application_positional_arity_reason(formal_count: Int, argument_count: Int) -> Symbol {
  if argument_count > formal_count {
    application_positional_surplus_reason()
  } else {
    application_positional_deficit_reason()
  }
}

// POSITIONAL BINDING HAS NO DECLARED ORDER TO READ. The callee's domain is a Conj, sorted by label,
// so its stored sequence is not the order the author wrote; the order lives only on the Arrow's
// ^arrow_signature_order_edge (v2.std.arrow_signature arrow_declared_parameter_order). An
// Arrow without one, or with one that is not a permutation of its binders, refuses here, located at
// the application, and is never bound by label order.
fn application_parameter_order_absent_reason() -> Symbol {
  ^application_parameter_order_absent
}

fn application_parameter_order_malformed_reason() -> Symbol {
  ^application_parameter_order_malformed
}

fn application_parameter_order_diagnostic(application: Node, reason: Symbol) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: application),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn application_positional_arity_mismatch_diagnostic(
  application: Node,
  formal_count: Int,
  argument_count: Int
) -> Diagnostic {
  Diagnostic {
    reason: application_positional_arity_reason(
      formal_count: formal_count,
      argument_count: argument_count
    ),
    at: node_locus(node: application),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn application_argument_does_not_inhabit_diagnostic(
  obligation: DeclaredTypeObligation,
  find_witness_reason: Symbol,
  // the judgment position of this refusal, already carrying the argument ordinal path of the decision
  // that refused: it travels with the verdict, so the diagnostic never re-derives it
  position: DeclaredTypePosition
) -> Diagnostic {
  Diagnostic {
    reason: find_witness_reason,
    at: inhabitance_judgment_locus(position: position, node: obligation.application),
    correction: Suggested {
      node: Node {
        kind: TypeNode { connective: Conj },
        children: list_append(left: [
          Edge {
            label: Authored { name: inhabitance_position_symbol(position: obligation.position) },
            target: obligation.application,
            declaration: NotADeclaration
          },
          Edge {
            label: Authored { name: obligation.parameter_identity },
            target: obligation.declared,
            declaration: NotADeclaration
          },
          Edge {
            label: Authored { name: ^inhabitance_produced_type },
            target: obligation.produced,
            declaration: NotADeclaration
          },
          Edge {
            label: Authored { name: find_witness_reason },
            target: obligation.produced,
            declaration: NotADeclaration
          }
        ], right: inhabitance_position_context_edges(position: obligation.position)),
        occurrence_id: obligation.application.occurrence_id
      }
    }
  }
}

data non_fold_residue_frontier: List<FrontierRow> = [
  FrontierRow { subject: PathSubject { path: "inhabitance_node_mentions_type_variable" }, reason: nfr_reason_typed_census_ca5ed1724b, dissolution: nfr_dissolve_owning_fold },
  FrontierRow { subject: PathSubject { path: "inhabitance_node_undecidable_reason" }, reason: nfr_reason_typed_census_ca5ed1724b, dissolution: nfr_dissolve_owning_fold },
  FrontierRow { subject: PathSubject { path: "inhabitance_optional_produced_at_required_declared" }, reason: nfr_reason_typed_census_ca5ed1724b, dissolution: nfr_dissolve_owning_fold },
]
