module v2.std.inhabitance

import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Suggested,
  Unavailable,
  node_locus
}
import v2.std.find_witness {
  CandidateSet,
  PreservationPredicate,
  UniqueOnly,
  find_witness
}
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  Cardinality,
  Conj,
  Edge,
  Instantiation,
  Named,
  Node,
  Symbol,
  TypeNode
}
import v2.std.optional { Absent, Optional, Present }
import v2.std.witness { HomomorphismWitness, StructuralPropertyWitness }

type DeclaredTypePosition
  = PositionDirectCallArgument

type DeclaredTypeObligation {
  position: DeclaredTypePosition
  parameter_identity: Symbol
  declared: Node
  produced: Node
  application: Node
}

type InhabitanceFormal {
  parameter_identity: Symbol
  declared: Node
}

type InhabitanceUndecidableReason
  = UndecidableGenericFormal
  | UndecidableOptionalCarrier
  | UndecidableRefinementChain
  | UndecidableKernelNumeric
  | UndecidableFormalUnresolved

type InhabitanceVerdict
  = Inhabits { homomorphism: HomomorphismWitness }
  | InhabitanceRefused { find_witness_reason: Symbol }
  | InhabitanceUndecidable { reason: InhabitanceUndecidableReason }

fn position_direct_call_argument() -> DeclaredTypePosition {
  PositionDirectCallArgument
}

fn inhabitance_declared_singleton(declared: Node) -> CandidateSet {
  CandidateSet {
    candidates: [declared],
    closedness: StructuralPropertyWitness {
      property: ^inhabitance_declared_singleton_closed,
      evidence: declared
    }
  }
}

fn inhabitance_node_is_instantiation(n: Node) -> Bool {
  match n.kind {
    TypeNode { connective: Instantiation } => true
    _ => false
  }
}

fn inhabitance_node_is_cardinality(n: Node) -> Bool {
  match n.kind {
    TypeNode { connective: Cardinality } => true
    _ => false
  }
}

fn inhabitance_pair_undecidable_reason(
  declared: Node,
  produced: Node
) -> Optional<InhabitanceUndecidableReason> {
  if inhabitance_node_is_cardinality(n: declared)
    || inhabitance_node_is_cardinality(n: produced) {
    Present { value: UndecidableOptionalCarrier }
  } else if inhabitance_node_is_instantiation(n: declared)
    || inhabitance_node_is_instantiation(n: produced) {
    Present { value: UndecidableGenericFormal }
  } else {
    Absent
  }
}

fn declared_type_inhabitance(obligation: DeclaredTypeObligation) -> InhabitanceVerdict {
  match inhabitance_pair_undecidable_reason(
    declared: obligation.declared,
    produced: obligation.produced
  ) {
    Present { value: reason } => InhabitanceUndecidable { reason: reason }
    Absent =>
      match find_witness(
        source_facts: obligation.produced,
        candidates: inhabitance_declared_singleton(declared: obligation.declared),
        predicate: PreservationPredicate {
          algebra: obligation.produced,
          preservation_rule: ^preservation_rule_exact_structural_equality_zip_fold
        },
        multiplicity_policy: UniqueOnly
      ) {
        Accepted { value: fw, diagnostics: _ } =>
          Inhabits {
            homomorphism: HomomorphismWitness {
              rule: ^homomorphism_rule_exact_structural_equality,
              evidence: fw.witness.evidence
            }
          }
        Rejected { diagnostics: r } =>
          InhabitanceRefused { find_witness_reason: r.head.reason }
      }
  }
}

fn inhabitance_inhabits_homomorphism(
  verdict: InhabitanceVerdict
) -> Optional<HomomorphismWitness> {
  match verdict {
    Inhabits { homomorphism: h } => Present { value: h }
    InhabitanceRefused { find_witness_reason: _ } => Absent
    InhabitanceUndecidable { reason: _ } => Absent
  }
}

fn inhabitance_refused_find_witness_reason(
  verdict: InhabitanceVerdict
) -> Optional<Symbol> {
  match verdict {
    InhabitanceRefused { find_witness_reason: r } => Present { value: r }
    Inhabits { homomorphism: _ } => Absent
    InhabitanceUndecidable { reason: _ } => Absent
  }
}

fn inhabitance_undecidable_reason(
  verdict: InhabitanceVerdict
) -> Optional<InhabitanceUndecidableReason> {
  match verdict {
    InhabitanceUndecidable { reason: r } => Present { value: r }
    Inhabits { homomorphism: _ } => Absent
    InhabitanceRefused { find_witness_reason: _ } => Absent
  }
}

fn undecidable_formal_unresolved() -> InhabitanceUndecidableReason {
  UndecidableFormalUnresolved
}

fn inhabitance_undecidable_reason_symbol(
  reason: InhabitanceUndecidableReason
) -> Symbol {
  match reason {
    UndecidableGenericFormal => ^inhabitance_undecidable_generic_formal
    UndecidableOptionalCarrier => ^inhabitance_undecidable_optional_carrier
    UndecidableRefinementChain => ^inhabitance_undecidable_refinement_chain
    UndecidableKernelNumeric => ^inhabitance_undecidable_kernel_numeric
    UndecidableFormalUnresolved => ^inhabitance_undecidable_formal_unresolved
  }
}

fn inhabitance_undecidable_diagnostic(
  application: Node,
  reason: InhabitanceUndecidableReason
) -> Diagnostic {
  Diagnostic {
    reason: inhabitance_undecidable_reason_symbol(reason: reason),
    at: node_locus(node: application),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn application_argument_does_not_inhabit_diagnostic(
  application: Node,
  parameter_identity: Symbol,
  argument_type: Node,
  parameter_type: Node,
) -> Diagnostic {
  Diagnostic {
    reason: ^application_argument_does_not_inhabit,
    at: node_locus(node: application),
    correction: Suggested {
      node: Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge { label: Named { name: parameter_identity }, target: parameter_type },
          Edge { label: Named { name: ^inhabitance_produced_type }, target: argument_type }
        ],
        occurrence_id: application.occurrence_id
      }
    }
  }
}

fn application_argument_type_not_derived_diagnostic(
  application: Node,
  argument: Node,
) -> Diagnostic {
  Diagnostic {
    reason: ^application_argument_type_not_derived,
    at: node_locus(node: application),
    correction: Suggested { node: argument }
  }
}

fn application_arity_mismatch_diagnostic(application: Node) -> Diagnostic {
  Diagnostic {
    reason: ^application_arity_mismatch,
    at: node_locus(node: application),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
