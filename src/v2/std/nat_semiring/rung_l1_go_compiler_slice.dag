  occurrence_id: SyntheticOccurrence
}

fn phase1_l1_go_compiler_slice_claim(label: String) -> TestClaim {
  CompilesClaim {
    label: label,
    anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
    input: phase1_nat_semiring_l1_go_compiler_slice_subject,
    expected_value: phase1_nat_semiring_l1_go_compiler_slice_subject,
    classification: TestClassification { tier: Tier3, layer: Integration }
  }
}

data claim_phase1_nat_semiring_l1_go_compiler_slice_compile: TestClaim = phase1_l1_go_compiler_slice_claim(
  label: "fixture=phase1/nat_semiring rung=l1 target=go slice=^go_l1_nat_semiring_rung2 predicate=R-L1-go-compiler-slice-compile"
