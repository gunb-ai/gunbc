data phase1_nat_semiring_l1_python_runtime_fixture_subject: Node = Node {
  kind: TypeNode {
    connective: Atom { identity: ^phase1_nat_semiring_l1_python_runtime_fixture_symbol }
  },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn phase1_l1_python_runtime_fixture_claim(label: String) -> TestClaim {
  EqualsClaim {
    label: label,
    anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
    lhs: phase1_nat_semiring_l1_python_runtime_fixture_subject,
    rhs: phase1_nat_semiring_l1_python_runtime_fixture_subject,
    classification: TestClassification { tier: Tier3, layer: Integration }
  }
}

fn phase1_l1_python_runtime_claim(label: String, law_input: Node) -> TestClaim {
  EqualsClaim {
    label: label,
    anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
    lhs: law_input,
    rhs: law_input,
    classification: TestClassification { tier: Tier3, layer: Integration }
  }
}

data claim_phase1_nat_semiring_l1_python_runtime_fixture_coverage: TestClaim = phase1_l1_python_runtime_fixture_claim(
  label: "fixture=phase1/nat_semiring rung=l1 target=python predicate=R-L1-python-runtime-fixture-coverage"
)

