// PY-L1-STATIC-STRUCTURAL fixture carriers. Polarity AND role are STRUCTURAL, not prose:
//  - the two cases are distinct types so illegal fixture states are unrepresentable —
//    a happy case can only mean StaticAnalysisAccepted, a falsification case can only mean
//    a blocking StaticAnalysisRejected. Neither carries a free TargetStaticAnalysisVerdict.
//  - neither case stores a free TargetStaticAnalysisInvocation: storing one would let a
//    blocking fixture be built with analysis_role: Advisory. Instead each case carries only
//    the artifact + the per-tool PROFILE reference (tool_profile_ref → an extdeps profile
//    row, e.g. pyright_profile_l1_id — distinct from the verdict's tool_id), and the
//    invocation is CONSTRUCTED with analysis_role: BlockingForRung by the accessor fns
//    below. So the BlockingForRung role and the profile/tool distinction are guaranteed by
//    construction, not accepted as free fields.
type LeafModelPythonStaticHappyCase {
  artifact: TargetArtifact
  tool_profile_ref: Symbol
}

// A falsification case carries the artifact, the profile reference, and the blocking-rejection
// detail (tool + diagnostic). Its verdict is StaticAnalysisRejected { tool_id, diagnostic_code }
// and its invocation role is BlockingForRung, both by construction (accessor fns below).
type LeafModelPythonStaticFalsificationCase {
  artifact: TargetArtifact
  tool_profile_ref: Symbol
  tool_id: Symbol
  diagnostic_code: Symbol
}

type LeafModelPythonStaticFixturePair {
  claim_id: LeafModelClaimId
  surface_spelling_fact: Symbol
  happy: LeafModelPythonStaticHappyCase
  falsification: LeafModelPythonStaticFalsificationCase
}

// Single-authority construction of each case's BlockingForRung invocation — the role is
// baked in here, never stored as a free field on the case.
fn leaf_model_python_static_happy_invocation(
  c: LeafModelPythonStaticHappyCase
) -> TargetStaticAnalysisInvocation {
  TargetStaticAnalysisInvocation {
    tool_profile_ref: c.tool_profile_ref,
    input_artifact: c.artifact,
    analysis_role: BlockingForRung
  }
}

fn leaf_model_python_static_falsification_invocation(
  c: LeafModelPythonStaticFalsificationCase
) -> TargetStaticAnalysisInvocation {
  TargetStaticAnalysisInvocation {
    tool_profile_ref: c.tool_profile_ref,
    input_artifact: c.artifact,
    analysis_role: BlockingForRung
  }
}

// Single-authority reconstruction of each case's expected verdict from its typed shape.
fn leaf_model_python_static_happy_verdict(
  c: LeafModelPythonStaticHappyCase
) -> TargetStaticAnalysisVerdict {
  StaticAnalysisAccepted
}

fn leaf_model_python_static_falsification_verdict(
  c: LeafModelPythonStaticFalsificationCase
) -> TargetStaticAnalysisVerdict {
  StaticAnalysisRejected { tool_id: c.tool_id, diagnostic_code: c.diagnostic_code }
}

