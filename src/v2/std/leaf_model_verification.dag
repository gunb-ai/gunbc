type LeafModelPythonStaticHappyCase {
  artifact: TargetArtifact
  tool_profile_ref: Symbol
}

type LeafModelPythonStaticFalsificationCase {
  artifact: TargetArtifact
  tool_profile_ref: Symbol
  tool_id: Symbol
  diagnostic_code: Symbol
}

type LeafModelPythonStaticFixturePair {
  claim_id: LeafModelClaimId
  surface_spelling_fact: Symbol
  happy: LeafModelPythonStaticHappyCase
  falsification: LeafModelPythonStaticFalsificationCase
}

fn leaf_model_python_static_happy_invocation(
  c: LeafModelPythonStaticHappyCase
) -> TargetStaticAnalysisInvocation {
  TargetStaticAnalysisInvocation {
    tool_profile_ref: c.tool_profile_ref,
    input_artifact: c.artifact,
    analysis_role: BlockingForRung
  }
}

fn leaf_model_python_static_falsification_invocation(
  c: LeafModelPythonStaticFalsificationCase
) -> TargetStaticAnalysisInvocation {
  TargetStaticAnalysisInvocation {
    tool_profile_ref: c.tool_profile_ref,
    input_artifact: c.artifact,
    analysis_role: BlockingForRung
  }
}

fn leaf_model_python_static_happy_verdict(
  _c: LeafModelPythonStaticHappyCase
) -> TargetStaticAnalysisVerdict {
  StaticAnalysisAccepted
}

fn leaf_model_python_static_falsification_verdict(
  c: LeafModelPythonStaticFalsificationCase
) -> TargetStaticAnalysisVerdict {
  StaticAnalysisRejected { tool_id: c.tool_id, diagnostic_code: c.diagnostic_code }
}

type LeafModelTypeScriptFixture {
  source: String
}

type LeafModelTypeScriptFalsificationCase {
  fixture: LeafModelTypeScriptFixture
  expected_verdict: TargetTypeScriptCompileVerdict
}

type LeafModelTypeScriptFixturePair {
  claim_id: LeafModelClaimId
  surface_spelling_fact: Symbol
  encoding_spelling_fact: Symbol
  happy: LeafModelTypeScriptFixture
  expected_happy_verdict: TargetTypeScriptCompileVerdict
  falsification: LeafModelTypeScriptFalsificationCase
}

type LeafModelTypeScriptRuntimeFixture {
  source: String
}

type LeafModelTypeScriptRuntimeFixturePair {
  claim_id: LeafModelClaimId
  surface_spelling_fact: Symbol
  encoding_spelling_fact: Symbol
  happy: LeafModelTypeScriptRuntimeFixture
  expected_happy_verdict: TargetRuntimeExerciseVerdict
  falsification: LeafModelTypeScriptRuntimeFixture
  expected_falsification_verdict: TargetRuntimeExerciseVerdict
}

type LeafModelVerificationRunReceipt {
  claim_id: LeafModelClaimId
  happy_verdict: Verdict<LeafModelClaimId, TargetCompileVerdict>
  falsification_verdict: Verdict<LeafModelClaimId, TargetCompileVerdict>
}

type LeafModelRuntimeVerificationRunReceipt {
  claim_id: LeafModelClaimId
  happy_verdict: Verdict<LeafModelClaimId, TargetRuntimeExerciseVerdict>
  falsification_verdict: Verdict<LeafModelClaimId, TargetRuntimeExerciseVerdict>
}

fn leaf_model_verification_claim_passes(
  receipt: LeafModelVerificationRunReceipt
) -> Verdict<LeafModelClaimId, TargetCompileVerdict> {
  verdict_combine(a: receipt.happy_verdict, b: receipt.falsification_verdict)
}

fn leaf_model_verification_combine_runs(
  runs: List<LeafModelVerificationRunReceipt>
) -> Verdict<LeafModelClaimId, TargetCompileVerdict> {
  fold(
    runs,
    init: Pass,
    f: fn(acc, r) {
      verdict_combine(a: acc, b: leaf_model_verification_claim_passes(receipt: r))
    }
  )
}
