type LeafModelGoRuntimeFalsificationCase {
  fixture: LeafModelGoRunFixture
  expected_verdict: TargetRuntimeExerciseVerdict
}

type LeafModelGoRuntimeFixturePair {
  claim_id: LeafModelClaimId
  fact_anchor: Node
  happy: LeafModelGoRunFixture
  expected_happy_verdict: TargetRuntimeExerciseVerdict
  falsification: LeafModelGoRuntimeFalsificationCase
