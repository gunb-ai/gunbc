// src/v2/std/leaf_model_verification.dag
// Scope: Leaf-model verification carriers — claim / falsification / fixture / report.
// Status: Phase 1 substrate.
// Authority: leaf model owns FACTS (stable fact_id in extdeps); this module owns OBLIGA shape.
// Co-authored with Modeling DFS (proud-pike-680) — consume Verdict<Subj,T> from verdict.dag (PR #3961).
// R1 rustc slice: concrete fixture-pair + compile verdict carriers (PR #3972).
// R1 python slice: concrete fixture-pair + exec verdict carriers (W2.6 / PR #3938 §11.4).

module v2.std.leaf_model_verification

import v2.std.collection { List }
import v2.std.host_run { ValueDiff }
import v2.std.nat { Nat }
import v2.std.node { Node, Symbol }
import v2.std.text { String }
import v2.std.verdict { Verdict, verdict_combine }

// Layer A boundary: OBLIGA rows reference model facts structurally (Node projection of declared bindings).
type LeafModelClaim<M, Subject, Expectation> {
  model: M
  fact_id: Node
  subject: Subject
  expectation: Expectation
  falsification_case: FalsificationCase<Subject, Expectation>
}

// REQUIRED paired probe — claim without falsification is not verifiable (planning doc §5).
type FalsificationCase<Subject, Expectation> {
  subject_variant: Subject
  expected_failure_mode: Expectation
}

// 🟡 gated — feature:leaf-model-fixture-runner — bind gunbc#4762 —
// dissolve-on: testgen emits LeafModelFixture rows and runner exercises target toolchain;
// forbidden: parallel fixture vocabulary outside this carrier.
type TargetArtifact {
  source_text: String
}

// 🟡 gated — feature:leaf-model-fixture-runner — bind gunbc#4762 —
// dissolve-on: TargetToolchain / TargetEdition / TargetBuildProfile / TargetOverflowDispositionField coproducts replace these Symbol scaffolds;
// forbidden: parallel invocation vocab outside this carrier.
type TargetInvocation {
  toolchain: Symbol
  edition: Symbol
  build_profile: Symbol
  overflow_disposition_field: Symbol
}

type LeafModelFixture<C> {
  claim: C
  artifact: TargetArtifact
  invocation: TargetInvocation
  expected_verdict: Verdict<Symbol, Symbol>
  falsification_artifact: TargetArtifact
  expected_falsification_verdict: Verdict<Symbol, Symbol>
}

type LeafModelClaimVerdictRow {
  claim_id: Symbol
  verdict: Verdict<Symbol, Symbol>
  falsification_verdict: Verdict<Symbol, Symbol>
}

type LeafModelVerificationTotals {
  proven: Nat
  model_failed: Nat
  falsification_caught: Nat
  falsification_missed: Nat
  not_checked: Nat
}

// 🟡 gated — feature:leaf-model-verification-report — dissolve-on: runner fold over report.claims.
type LeafModelVerificationReport<M> {
  model: M
  claims: List<LeafModelClaimVerdictRow>
}

// --- PR #3972 R1 rustc compile slice (happy/falsification fixtures + boundary runner) ---

// 🟢 coproduct dissolution — CP-LMV-TARGET-COMPILE-VERDICT-PHASE1 (Phase 1 R1 rustc gate; widen per target).
type TargetCompileVerdict
  = TargetCompileAccepted
  | TargetCompileRejected { diagnostic_code: Symbol }

// Phase 1 python CPython boundary — py_compile and python3 exec are distinct authorities.
type TargetPythonExerciseVerdict
  = TargetPythonExerciseAccepted
  | TargetPythonCompileRejected { diagnostic_code: Symbol }
  | TargetPythonExecRejected { diagnostic_code: Symbol }

// 🟢 coproduct dissolution — CP-LMV-TARGET-RUNTIME-EXERCISE-VERDICT-PHASE1 (generalizes Go + TypeScript R2b runtime;
// dissolved CP-LMV-TARGET-TYPESCRIPT-RUNTIME-VERDICT-PHASE1 and CP-LMV-TARGET-GO-RUNTIME-VERDICT-PHASE1 on main).
// dissolve-on-arrival: fold into LeafModelFixture<C>.expected_verdict once T-22 run_target_verification lands.
type TargetRuntimeExerciseVerdict
  = TargetRuntimeExerciseAccepted
  | TargetRuntimeExerciseRejected { diagnostic_code: Symbol }

// --- PY-L1-STATIC-STRUCTURAL: shared cross-target static-analysis carriers ---
// Arbiter ruling (Modeling DFS, proud-fox-405, msg_41813c03): static structural
// analysis by a third-party type checker is a SHARED cross-target authority — one
// carrier pair reused by pyright/mypy now and tsc --noEmit later — DISTINCT from
// BOTH CPython compile (TargetPythonCompileRejected) and runtime exec
// (TargetPythonExecRejected). Three authorities, never collapsed. Per-tool profiles
// and diagnostic-code Symbols live in extdeps/typecheckers/*; these carriers
// reference the tool profile / diagnostic by Symbol only (no shared cross-tool
// diagnostic namespace). host_run stays runtime stdout/exit; no static facts there.

// Whether a static-analysis finding blocks a rung or is advisory evidence only
// (fail-closed: BlockingForRung + advisory-only finding on the falsification path = MISS).
// 🟢 terminal — CP-PYL1-STATIC-ANALYSIS-ROLE-TERMINAL (dissolution analysis: PR #4158 review).
type TargetStaticAnalysisRole
  = Advisory
  | BlockingForRung

type TargetStaticAnalysisInvocation {
  tool_profile_ref: Symbol
  input_artifact: TargetArtifact
  analysis_role: TargetStaticAnalysisRole
}

// Accepted (no finding) / Rejected (blocking) / Advisory (non-blocking evidence); the
// richer per-tool detail is carried by tool_id + diagnostic_code. Never a compile/runtime
// verdict and never an L2 behavioral-parity claim.
// 🟢 terminal — CP-PYL1-STATIC-ANALYSIS-VERDICT-TERMINAL (dissolution analysis: PR #4158 review).
type TargetStaticAnalysisVerdict
  = StaticAnalysisAccepted
  | StaticAnalysisRejected { tool_id: Symbol, diagnostic_code: Symbol }
  | StaticAnalysisAdvisory { tool_id: Symbol, diagnostic_code: Symbol }

// 🟢 coproduct dissolution — CP-LMV-TARGET-TYPESCRIPT-COMPILE-VERDICT-PHASE1 (Phase 1 tsc gate; widen per target).
type TargetTypeScriptCompileVerdict
  = TargetTypeScriptCompileAccepted
  | TargetTypeScriptCompileRejected { diagnostic_code: Symbol }

