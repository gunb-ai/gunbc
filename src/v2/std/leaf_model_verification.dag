type LeafModelCrossRuntimeDriftProbe {
  claim_id: LeafModelClaimId

  arbitrary_precision_fact: Symbol
  fixed_width_rust_fact: Symbol
  fixed_width_go_fact: Symbol
  arbitrary_precision_source: String
  fixed_width_rust_source: String
  fixed_width_go_source: String
  expected_divergence: ValueDiff<String>
}

type LeafModelCrossTargetParityProbe {
  claim_id: LeafModelClaimId

  python_fact: Symbol
  rust_fact: Symbol
  go_fact: Symbol
  python_source: String
  rust_source: String
  go_source: String
  expected_parity: ValueDiff<String>
}

type LeafModelRustCrateType = Symbol

data leaf_model_rust_crate_type_lib: LeafModelRustCrateType = leaf_model_rust_crate_type_lib
data leaf_model_rust_crate_type_bin: LeafModelRustCrateType = leaf_model_rust_crate_type_bin

