module v2.std.leaf_model_verification

import v2.std.collection { List }
import v2.std.host_run { ValueDiff }
import v2.std.nat { Nat }
import v2.std.node { Node, Symbol }
import v2.std.text { String }
import v2.std.verdict { Verdict, verdict_combine }

type LeafModelClaim<M, Subject, Expectation> {
  model: M
  fact_id: Node
  subject: Subject
  expectation: Expectation
  falsification_case: FalsificationCase<Subject, Expectation>
}

type FalsificationCase<Subject, Expectation> {
  subject_variant: Subject
  expected_failure_mode: Expectation
}

type TargetArtifact {
  source_text: String
}

type TargetInvocation {
  toolchain: Symbol
  edition: Symbol
  build_profile: Symbol
  overflow_disposition_field: Symbol
}

type LeafModelFixture<C> {
  claim: C
  artifact: TargetArtifact
  invocation: TargetInvocation
  expected_verdict: Verdict<Symbol, Symbol>
  falsification_artifact: TargetArtifact
  expected_falsification_verdict: Verdict<Symbol, Symbol>
}

type LeafModelClaimVerdictRow {
  claim_id: Symbol
  verdict: Verdict<Symbol, Symbol>
  falsification_verdict: Verdict<Symbol, Symbol>
}

type LeafModelVerificationTotals {
  proven: Nat
  model_failed: Nat
  falsification_caught: Nat
  falsification_missed: Nat
  not_checked: Nat
}

type LeafModelVerificationReport<M> {
  model: M
  claims: List<LeafModelClaimVerdictRow>
}

type TargetCompileVerdict
  = TargetCompileAccepted
  | TargetCompileRejected { diagnostic_code: Symbol }

type TargetPythonExerciseVerdict
  = TargetPythonExerciseAccepted
  | TargetPythonCompileRejected { diagnostic_code: Symbol }
  | TargetPythonExecRejected { diagnostic_code: Symbol }

type TargetRuntimeExerciseVerdict
  = TargetRuntimeExerciseAccepted
  | TargetRuntimeExerciseRejected { diagnostic_code: Symbol }

type TargetStaticAnalysisRole
  = Advisory
  | BlockingForRung

type TargetStaticAnalysisInvocation {
  tool_profile_ref: Symbol
  input_artifact: TargetArtifact
  analysis_role: TargetStaticAnalysisRole
}

type TargetStaticAnalysisVerdict
  = StaticAnalysisAccepted
  | StaticAnalysisRejected { tool_id: Symbol, diagnostic_code: Symbol }
  | StaticAnalysisAdvisory { tool_id: Symbol, diagnostic_code: Symbol }

type TargetTypeScriptCompileVerdict
  = TargetTypeScriptCompileAccepted
  | TargetTypeScriptCompileRejected { diagnostic_code: Symbol }

type LeafModelClaimId = Symbol

