module v2.test.qualified_name.from_node

fn qn_sym_node(sym: v2.std.node.Symbol) -> Node {
  v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: sym } }, children: [],
 occurrence_id: SyntheticOccurrence
}
}

fn qn_bool_atom(b: Bool) -> Node {
  match b {
    true => v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^qn_bool_true_sym } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^qn_bool_false_sym } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

fn qn_outcome_accepted(out: Outcome<v2.std.qualified_name.QualifiedName>) -> Bool {
  match out {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn qn_value_eq(out: Outcome<v2.std.qualified_name.QualifiedName>, expected: v2.std.qualified_name.QualifiedName) -> Bool {
  match out {
    Rejected { diagnostics: _ } => false
    Accepted { value: actual, diagnostics: _ } => actual == expected
  }
}

data qn_atom_node: Node = v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^qn_sym_a } }, children: [],
 occurrence_id: SyntheticOccurrence
}

data qn_empty_conj_node: Node = v2.std.node.Node { kind: v2.std.node.TypeNode { connective: Conj }, children: [],
 occurrence_id: SyntheticOccurrence
}

data qn_single_list_node: Node = fold_list_node(
  xs: std.algebra.Cons { head: ^qn_sym_a, tail: Empty },
  item_node: fn(sym) { qn_sym_node(sym: sym) }
)

data qn_three_list_node: Node = fold_list_node(
  xs: std.algebra.Cons { head: ^qn_sym_a, tail: std.algebra.Cons { head: ^qn_sym_b, tail: std.algebra.Cons { head: ^qn_sym_c, tail: Empty } } },
  item_node: fn(sym) { qn_sym_node(sym: sym) }
)

data qn_tail_only_node: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [v2.std.node.Edge { label: Named { name: ^fold_list_node_tail }, target: qn_empty_conj_node }],
  occurrence_id: SyntheticOccurrence
}

data qn_atom_with_children: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^qn_sym_a } },
  children: [v2.std.node.Edge { label: Named { name: ^qn_sym_b }, target: qn_empty_conj_node }],
  occurrence_id: SyntheticOccurrence
}

data qn_single_malformed_head_node: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [
    v2.std.node.Edge { label: Named { name: ^fold_list_node_head }, target: qn_atom_with_children },
    v2.std.node.Edge { label: Named { name: ^fold_list_node_tail }, target: qn_empty_conj_node }
  ],
  occurrence_id: SyntheticOccurrence
}

data qn_tail_to_atom_node: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [
    v2.std.node.Edge { label: Named { name: ^fold_list_node_head }, target: v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^qn_sym_a } }, children: [],
occurrence_id: SyntheticOccurrence
} },
    v2.std.node.Edge { label: Named { name: ^fold_list_node_tail }, target: v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^qn_sym_b } }, children: [],
occurrence_id: SyntheticOccurrence
} }
  ],
  occurrence_id: SyntheticOccurrence
}

data qn_single_reversed_node: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [
    v2.std.node.Edge { label: Named { name: ^fold_list_node_tail }, target: qn_empty_conj_node },
    v2.std.node.Edge { label: Named { name: ^fold_list_node_head }, target: v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^qn_sym_a } }, children: [],
occurrence_id: SyntheticOccurrence
} }
  ],
  occurrence_id: SyntheticOccurrence
}

data qn_head_to_conj_node: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [
    v2.std.node.Edge { label: Named { name: ^fold_list_node_head }, target: qn_empty_conj_node },
    v2.std.node.Edge { label: Named { name: ^fold_list_node_tail }, target: qn_empty_conj_node }
  ],
  occurrence_id: SyntheticOccurrence
}

data qn_double_head_node: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [
    v2.std.node.Edge { label: Named { name: ^fold_list_node_head }, target: v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^qn_sym_a } }, children: [],
occurrence_id: SyntheticOccurrence
} },
    v2.std.node.Edge { label: Named { name: ^fold_list_node_head }, target: v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^qn_sym_b } }, children: [],
occurrence_id: SyntheticOccurrence
} }
  ],
  occurrence_id: SyntheticOccurrence
}

data claim_from_node_non_list_rejected: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "qualified_name_from_node returns Rejected for a plain Atom node (not a Conj)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: qn_bool_atom(b: qn_outcome_accepted(out: qualified_name_from_node(root: qn_atom_node))),
  rhs: qn_bool_atom(b: false),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_from_node_empty_list_accepted: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "qualified_name_from_node returns Accepted { value: Empty } for empty Conj (fold_list_node base case)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: qn_bool_atom(b: qn_outcome_accepted(out: qualified_name_from_node(root: qn_empty_conj_node))),
  rhs: qn_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_from_node_single_accepted: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "qualified_name_from_node returns Accepted with [^qn_sym_a] for single-element fold_list_node",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: qn_bool_atom(b: qn_value_eq(
    out: qualified_name_from_node(root: qn_single_list_node),
    expected: std.algebra.Cons { head: ^qn_sym_a, tail: Empty }
  )),
  rhs: qn_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_from_node_multi_accepted: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "qualified_name_from_node returns Accepted with [^qn_sym_a, ^qn_sym_b, ^qn_sym_c] for three-element fold_list_node",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: qn_bool_atom(b: qn_value_eq(
    out: qualified_name_from_node(root: qn_three_list_node),
    expected: std.algebra.Cons { head: ^qn_sym_a, tail: std.algebra.Cons { head: ^qn_sym_b, tail: std.algebra.Cons { head: ^qn_sym_c, tail: Empty } } }
  )),
  rhs: qn_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_from_node_malformed_conj_rejected: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "qualified_name_from_node returns Rejected for Conj with tail-only edge (no head — malformed fold_list_node)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: qn_bool_atom(b: qn_outcome_accepted(out: qualified_name_from_node(root: qn_tail_only_node))),
  rhs: qn_bool_atom(b: false),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_from_node_malformed_atom_segment_rejected: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "qualified_name_from_node returns Rejected when head segment Atom has non-empty children (malformed segment)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: qn_bool_atom(b: qn_outcome_accepted(out: qualified_name_from_node(root: qn_single_malformed_head_node))),
  rhs: qn_bool_atom(b: false),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_from_node_duplicate_head_rejected: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "qualified_name_from_node returns Rejected for Conj with two head edges and no tail (duplicate head is invalid fold_list_node shape)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: qn_bool_atom(b: qn_outcome_accepted(out: qualified_name_from_node(root: qn_double_head_node))),
  rhs: qn_bool_atom(b: false),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_from_node_tail_to_atom_rejected: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "qualified_name_from_node returns Rejected when fold_list_node_tail points to bare Atom instead of Conj list-spine",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: qn_bool_atom(b: qn_outcome_accepted(out: qualified_name_from_node(root: qn_tail_to_atom_node))),
  rhs: qn_bool_atom(b: false),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_from_node_reversed_order_accepted: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "qualified_name_from_node accepts [tail, head] child ordering — LabeledEdges: storage order must not matter",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: qn_bool_atom(b: qn_value_eq(
    out: qualified_name_from_node(root: qn_single_reversed_node),
    expected: std.algebra.Cons { head: ^qn_sym_a, tail: Empty }
  )),
  rhs: qn_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_from_node_head_to_conj_rejected: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "qualified_name_from_node returns Rejected when fold_list_node_head points to Conj list-spine instead of Atom segment",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: qn_bool_atom(b: qn_outcome_accepted(out: qualified_name_from_node(root: qn_head_to_conj_node))),
  rhs: qn_bool_atom(b: false),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
