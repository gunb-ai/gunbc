module v2.std.types

import v2.std.collection { List }
import v2.std.text { String }

// 🟡 staged — dissolve-on: `dsl/std/types.dag` `GlobSegment` / `GlobPattern` brand substrate.
type GlobSegment = String

type GlobPattern {
  segments: List<GlobSegment>
}

// 🟡 staged — feature:repository-root-brand — authority boundary for repo root (NOT node substrate).
// Ingress path literals: `v2.lens.edit_locus.RepoPath`; normalize to `RepoRoot` at authority.
// Forbidden: arbitrary String at authority boundary; forbidden: homing in `v2.std.node`.
type RepoRoot = String

type RepositoryRoot = RepoRoot
