// src/v2/std/access_test.dag — executed witnesses for ownership (Step 1) + visibility (Step 2).
// Auto-enrolled in the CI floor by `*_test.dag` naming. Principals are real `.dag` nodes
// (declared here) referenced by their node identity (Symbol) — no minted id (DESIGN §3).

module v2.test.std_access.access_test

import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.access {
  Grant, Owner, Reader, Writer, Member, Everyone, Is, MembersOf,
  is_owner, effective_owner,
  can_read, can_write, is_public, effective_public
}

// Principals are literally `.dag` nodes; their identity is their node id.
data operator: Symbol = ^operator
data gunb_ai_org: Symbol = ^gunb_ai_org
data alice: Symbol = ^alice
data bob: Symbol = ^bob

// Example grant set:
//   module_a — operator owns it; public-readable.
//   module_b — org owns it; otherwise private.
//   module_c — readable by members of the org.
//   module_d — alice may write it (⇒ read it); otherwise private.
//   org membership — alice is a member of the org.
data example_grants: List<Grant> = [
  Grant { object: ^module_a, relation: Owner,  subject: Is { node: operator } },
  Grant { object: ^module_a, relation: Reader, subject: Everyone },
  Grant { object: ^module_b, relation: Owner,  subject: Is { node: gunb_ai_org } },
  Grant { object: ^module_c, relation: Reader, subject: MembersOf { node: gunb_ai_org, via: Member } },
  Grant { object: ^module_d, relation: Writer, subject: Is { node: alice } },
  Grant { object: ^gunb_ai_org, relation: Member, subject: Is { node: alice } }
]

// ---- Ownership (Step 1) ----------------------------------------------------

test fn owner_of_resolves_declared_owner() -> Bool {
  is_owner(grants: example_grants, subject: operator, object: ^module_a)
}

test fn owner_of_resolves_org_owner() -> Bool {
  is_owner(grants: example_grants, subject: gunb_ai_org, object: ^module_b)
}

// Discriminating: the org does NOT own module_a (the operator does).
test fn non_owner_is_not_owner() -> Bool {
  match is_owner(grants: example_grants, subject: gunb_ai_org, object: ^module_a) {
    true => false
    false => true
  }
}

// Fail-closed (DESIGN §5): an unowned node's effective owner is the operator, never public.
test fn unowned_falls_closed_to_operator() -> Bool {
  effective_owner(grants: example_grants, object: ^module_unowned, operator: operator) == operator
}

// ---- Visibility (Step 2) ---------------------------------------------------

// Public node is readable by anyone.
test fn public_node_readable_by_anyone() -> Bool {
  can_read(grants: example_grants, who: bob, object: ^module_a)
}

// Private node is NOT readable by a stranger (discriminating).
test fn private_node_unreadable_by_stranger() -> Bool {
  match can_read(grants: example_grants, who: bob, object: ^module_b) {
    true => false
    false => true
  }
}

// Owning implies reading (Owner ⊒ Reader).
test fn owner_can_read_own_node() -> Bool {
  can_read(grants: example_grants, who: gunb_ai_org, object: ^module_b)
}

// Org member can read an org-readable node (userset resolution).
test fn org_member_can_read() -> Bool {
  can_read(grants: example_grants, who: alice, object: ^module_c)
}

// Non-member cannot (discriminating — the userset actually filters).
test fn non_member_cannot_read() -> Bool {
  match can_read(grants: example_grants, who: bob, object: ^module_c) {
    true => false
    false => true
  }
}

// Writer can write; a stranger cannot (discriminating).
test fn writer_can_write() -> Bool {
  can_write(grants: example_grants, who: alice, object: ^module_d)
}

test fn stranger_cannot_write() -> Bool {
  match can_write(grants: example_grants, who: bob, object: ^module_d) {
    true => false
    false => true
  }
}

// Writing implies reading (Writer ⊒ Reader).
test fn writer_can_read() -> Bool {
  can_read(grants: example_grants, who: alice, object: ^module_d)
}

// Public classification discriminates.
test fn is_public_true_for_public_node() -> Bool {
  is_public(grants: example_grants, object: ^module_a)
}

test fn is_public_false_for_private_node() -> Bool {
  match is_public(grants: example_grants, object: ^module_b) {
    true => false
    false => true
  }
}

// THE LEAK RULE: a public node exposing a private dependency is NOT effectively public.
test fn leak_rule_private_dependency_blocks_publication() -> Bool {
  match effective_public(grants: example_grants, object: ^module_a, dependency_public: [false]) {
    true => false
    false => true
  }
}

// A public node whose dependencies are all public stays effectively public.
test fn leak_rule_all_public_dependencies_ok() -> Bool {
  effective_public(grants: example_grants, object: ^module_a, dependency_public: [true])
}

// A non-public node is never effectively public, regardless of dependencies.
test fn leak_rule_nonpublic_self_never_public() -> Bool {
  match effective_public(grants: example_grants, object: ^module_b, dependency_public: [true]) {
    true => false
    false => true
  }
}
