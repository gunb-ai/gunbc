module v2.std.timeseries_signal

import std.algebra { Cons, Empty }
import v2.std.algebra { fold_list, fold_list_right }
import v2.std.collection { List, Optional, Absent, Present }
import v2.std.diagnostic { Accepted, None, Outcome, Rejected, port_locus }
import v2.std.integer { Int, int_add, int_div, int_mul }
import v2.std.logic { Bool }
import std.measure {
  Measure,
  Capacitance,
  ElectricCharge,
  ElectricCurrent,
  ElectricPotential,
  Inductance,
  MagneticFlux,
  Micro,
  Resistance,
  Time,
}
import v2.std.nat { Nat }
import v2.std.node { Symbol }
import v2.std.text { String }

type Voltage = Measure<ElectricPotential, Micro, Int>
type Current = Measure<ElectricCurrent, Micro, Int>
type ResistanceMicro = Measure<Resistance, Micro, Int>
type CapacitanceMicro = Measure<Capacitance, Micro, Int>
type InductanceMicro = Measure<Inductance, Micro, Int>
type ChargeMicro = Measure<ElectricCharge, Micro, Int>
type FluxMicro = Measure<MagneticFlux, Micro, Int>

type DurationMicro = Measure<Time, Micro, Int>

fn voltage(n: Int) -> Voltage {
  Voltage { count: n }
}

fn voltage_count(v: Voltage) -> Int {
  v.count
}

fn current(n: Int) -> Current {
  Current { count: n }
}

fn current_count(c: Current) -> Int {
  c.count
}

fn resistance_micro(n: Int) -> ResistanceMicro {
  ResistanceMicro { count: n }
}

fn resistance_micro_count(r: ResistanceMicro) -> Int {
  r.count
}

fn capacitance_micro(n: Int) -> CapacitanceMicro {
  CapacitanceMicro { count: n }
}

fn capacitance_micro_count(c: CapacitanceMicro) -> Int {
  c.count
}

fn inductance_micro(n: Int) -> InductanceMicro {
  InductanceMicro { count: n }
}

fn inductance_micro_count(l: InductanceMicro) -> Int {
  l.count
}

fn charge_micro(n: Int) -> ChargeMicro {
  ChargeMicro { count: n }
}

fn charge_micro_count(q: ChargeMicro) -> Int {
  q.count
}

fn flux_micro(n: Int) -> FluxMicro {
  FluxMicro { count: n }
}

fn flux_micro_count(phi: FluxMicro) -> Int {
  phi.count
}

fn duration_micro(n: Int) -> DurationMicro {
  DurationMicro { count: n }
}

fn duration_micro_count(t: DurationMicro) -> Int {
  t.count
}

type PotentialReference
  = GroundReference
  | NodeReference { name: Symbol }

type AbsolutePotential {
  reference: PotentialReference
  magnitude: Voltage
}

type PotentialDifference {
  magnitude: Voltage
}

type BranchCurrent {
  magnitude: Current
}

type ApproxVoltageUnit {}

type ApproxVoltage {
  magnitude_lexeme: String
  unit: ApproxVoltageUnit
}

type NamedAffineVoltage {
  reference: PotentialReference
  approx: ApproxVoltage
}

data timeseries_witness_approx_zero: ApproxVoltage = ApproxVoltage {
  magnitude_lexeme: "0",
  unit: ApproxVoltageUnit {}
}

type PassiveElementValue {
  lexeme: String
}

type PassiveElementTopology {
  name: Symbol
  n_plus: PotentialReference
  n_minus: PotentialReference
  value: PassiveElementValue
}

type PassiveComponentSpec
  = ResistorPassive { topology: PassiveElementTopology }
  | CapacitorPassive { topology: PassiveElementTopology }
  | InductorPassive { topology: PassiveElementTopology }

fn potential_reference_eq(
  left: PotentialReference,
  right: PotentialReference
) -> Bool {
  match left {
    GroundReference => match right {
      GroundReference => true
      NodeReference { name: _ } => false
    }
    NodeReference { name: left_name } => match right {
      GroundReference => false
      NodeReference { name: right_name } => left_name == right_name
    }
  }
}

fn potential_reference_of_absolute(potential: AbsolutePotential) -> PotentialReference {
  potential.reference
}

fn potential_reference_of_named(named: NamedAffineVoltage) -> PotentialReference {
  named.reference
}

fn named_affine_voltage(
  reference: PotentialReference,
  approx: ApproxVoltage
) -> NamedAffineVoltage {
  NamedAffineVoltage {
    reference: reference,
    approx: approx
  }
}

fn absolute_potential_from_named(
  named: NamedAffineVoltage,
  magnitude: Voltage
) -> AbsolutePotential {
  AbsolutePotential {
    reference: named.reference,
    magnitude: magnitude
  }
}

fn absolute_potential_from_named_preserves_reference(
  named: NamedAffineVoltage,
  magnitude: Voltage
) -> Bool {
  let absolute = absolute_potential_from_named(named: named, magnitude: magnitude)
  potential_reference_eq(
    left: potential_reference_of_named(named: named),
    right: potential_reference_of_absolute(potential: absolute)
  )
}

fn potential_difference_of_magnitude(magnitude: Voltage) -> PotentialDifference {
  PotentialDifference {
    magnitude: magnitude
  }
}

fn branch_current_of_magnitude(magnitude: Current) -> BranchCurrent {
  BranchCurrent {
    magnitude: magnitude
  }
}

data timeseries_passive_fold_step_locus: Symbol = ^timeseries_passive_fold_step

type CircuitPrimitiveKind
  = MapStep
  | FoldStep
  | SolveStep

type TimeStep {
  dt_microseconds: DurationMicro
}

type StepCurrent {
  microamperes: Current
}

type StepPotentialDifference {
  microvolts: Voltage
}

type StepBranchVoltage {
  difference: StepPotentialDifference
}

type TimeSeriesSample {
  tick: v2.std.nat.Nat
  microvolts: Voltage
}

type TimeSeriesSignal = List<TimeSeriesSample>

fn time_series_append(
  signal: TimeSeriesSignal,
  sample: TimeSeriesSample,
) -> TimeSeriesSignal {
  fold_list_right(
    xs: signal,
    empty: Cons { head: sample, tail: Empty },
    snoc: fn(acc, item) { Cons { head: item, tail: acc } }
  )
}

type ResistorRating {
  microohms: ResistanceMicro
}

type ResistorMap {
  kind: MapStep
  rating: ResistorRating
}

fn resistor_map_voltage(
  element: ResistorMap,
  current: StepCurrent,
) -> StepBranchVoltage {
  StepBranchVoltage {
    difference: StepPotentialDifference {
      microvolts: voltage(
        int_mul(
          a: resistance_micro_count(element.rating.microohms),
          b: current_count(current.microamperes),
        )
      )
    }
  }
}

type CapacitorRating {
  microfarads: CapacitanceMicro
}

type CapacitorState {
  voltage: StepPotentialDifference
  charge_microcoulombs: ChargeMicro
}

type CapacitorFold {
  kind: FoldStep
  rating: CapacitorRating
}

fn capacitor_fold_step(
  element: CapacitorFold,
  state: CapacitorState,
  current: StepCurrent,
  dt: TimeStep,
) -> Outcome<CapacitorState> {
  let charge_delta = int_mul(
    a: current_count(current.microamperes),
    b: duration_micro_count(dt.dt_microseconds),
  )
  let new_charge = int_add(
    a: charge_micro_count(state.charge_microcoulombs),
    b: charge_delta,
  )
  match int_div(
    a: new_charge,
    b: capacitance_micro_count(element.rating.microfarads),
    at: port_locus(port: timeseries_passive_fold_step_locus),
  ) {
    Accepted { value: v, diagnostics: _ } =>
      Accepted {
        value: CapacitorState {
          voltage: StepPotentialDifference {
            microvolts: voltage(v)
          }
          charge_microcoulombs: charge_micro(new_charge)
        }
        diagnostics: v2.std.diagnostic.None
      }
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}

fn fold_capacitor_transient(
  element: CapacitorFold,
  initial: CapacitorState,
  currents: List<StepCurrent>,
  dt: TimeStep,
) -> Outcome<CapacitorState> {
  fold_list(
    xs: currents,
    empty: Accepted { value: initial, diagnostics: v2.std.diagnostic.None },
    cons: fn(acc, current) {
      match acc {
        Accepted { value: state, diagnostics: _ } =>
          capacitor_fold_step(
            element: element,
            state: state,
            current: current,
            dt: dt,
          )
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
      }
    }
  )
}

type InductorRating {
  microhenries: InductanceMicro
}

type InductorState {
  current: StepCurrent
  flux_microwebers: FluxMicro
}

type InductorFold {
  kind: FoldStep
  rating: InductorRating
}

fn inductor_fold_step(
  element: InductorFold,
  state: InductorState,
  voltage: StepBranchVoltage,
  dt: TimeStep,
) -> Outcome<InductorState> {
  let flux_delta = int_mul(
    a: voltage_count(voltage.difference.microvolts),
    b: duration_micro_count(dt.dt_microseconds),
  )
  let new_flux = int_add(
    a: flux_micro_count(state.flux_microwebers),
    b: flux_delta,
  )
  match int_div(
    a: new_flux,
    b: inductance_micro_count(element.rating.microhenries),
    at: port_locus(port: timeseries_passive_fold_step_locus),
  ) {
    Accepted { value: i, diagnostics: _ } =>
      Accepted {
        value: InductorState {
          current: StepCurrent {
            microamperes: current(i)
          }
          flux_microwebers: flux_micro(new_flux)
        }
        diagnostics: v2.std.diagnostic.None
      }
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}
