module v2.std.project_to_core_predicate


fn project_to_core_axis_is_core(name: v2.std.node.Symbol) -> Bool {
  v2.std.model_core.model_core_primitive_fact_axis_is_core(axis: name)
}

fn project_to_core_axis_is_surface(name: v2.std.node.Symbol) -> Bool {
  v2.std.model_core.model_core_primitive_fact_axis_is_surface(axis: name)
}

fn project_to_core_init(n: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.node_rebuild(n: n, children: [])
}

fn project_to_core_step(acc: v2.std.node.Node, edge: v2.std.node.Edge, child: v2.std.node.Node) -> v2.std.node.Node {
  let projected_target = if count(edge.target.children) == 0 { edge.target } else { child }
  match edge.label {
    v2.std.node.Named { name: edge_name } =>
      if project_to_core_axis_is_surface(name: edge_name) {
        acc
      } else {
        v2.std.node.node_rebuild(
          n: acc,
          children: v2.std.algebra.list_snoc_item(
            xs: acc.children,
            item: v2.std.node.Edge { label: edge.label, target: projected_target }
          )
        )
      }
    v2.std.node.Positional =>
      v2.std.node.node_rebuild(
        n: acc,
        children: v2.std.algebra.list_snoc_item(
          xs: acc.children,
          item: v2.std.node.Edge { label: edge.label, target: projected_target }
        )
      )
  }
}

fn project_to_core_algebra() -> v2.std.node.NodeFold<v2.std.node.Node> {
  v2.std.node.NodeFold {
    init: project_to_core_init,
    step: project_to_core_step
  }
}

fn project_to_core_node(n: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.fold_node(n: n, algebra: project_to_core_algebra())
}

fn project_to_core_has_core_fact_init(_: v2.std.node.Node) -> Bool {
  false
}

fn project_to_core_has_core_fact_step(acc: Bool, edge: v2.std.node.Edge, child: Bool) -> Bool {
  match edge.label {
    v2.std.node.Named { name: edge_name } =>
      if project_to_core_axis_is_surface(name: edge_name) {
        acc
      } else {
        acc || child || project_to_core_axis_is_core(name: edge_name)
      }
    v2.std.node.Positional => acc || child
  }
}

fn project_to_core_has_core_fact_algebra() -> v2.std.node.NodeFold<Bool> {
  v2.std.node.NodeFold {
    init: project_to_core_has_core_fact_init,
    step: project_to_core_has_core_fact_step
  }
}

fn project_to_core_has_core_fact(n: v2.std.node.Node) -> Bool {
  v2.std.node.fold_node(n: n, algebra: project_to_core_has_core_fact_algebra())
}

fn project_to_core_preservation_holds(
  source_facts: v2.std.node.Node,
  candidate: v2.std.node.Node,
  algebra: v2.std.node.Node,
) -> Bool {
  v2.std.node.well_formed(n: source_facts)
    && v2.std.node.well_formed(n: candidate)
    && v2.std.node.well_formed(n: algebra)
    && project_to_core_has_core_fact(n: source_facts)
    && project_to_core_has_core_fact(n: candidate)
    && v2.std.exact_structural_equality_zip_fold_predicate.exact_structural_equality_zip_fold(
      source_facts: project_to_core_node(n: source_facts),
      candidate: project_to_core_node(n: candidate)
    )
}
