// src/v2/std/report.dag
// Scope: advisory report carrier.
// Status: T-17 closed ReportReason; T-23 adds ReportSuggestion + diagnostic seam.
// Anchor: docs/r4-carve-out-routing.md

module v2.std.report

import v2.std.diagnostic { Locus }
import v2.std.node { Symbol }

// 🟢 coproduct dissolution
type ReportReason
  = SynthesisGapDecisionTree
  | SynthesisGapInformationTheoretic

type Report {
  reason: ReportReason
  at: Locus
}

fn report_reason_to_diagnostic_reason(reason: ReportReason) -> Symbol {
  discriminant(v: reason)
}

type ReportSuggestion {
  report: Report
  detail: Symbol
}
