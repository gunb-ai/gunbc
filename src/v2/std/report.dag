module v2.std.report


type ReportReason
  = SynthesisGapDecisionTree
  | SynthesisGapInformationTheoretic

type Report {
  reason: ReportReason
  at: v2.std.diagnostic.Locus
}

fn report_reason_to_diagnostic_reason(reason: ReportReason) -> v2.std.node.Symbol {
  discriminant(v: reason)
}

type ReportSuggestion {
  report: Report
  detail: v2.std.node.Symbol
}
