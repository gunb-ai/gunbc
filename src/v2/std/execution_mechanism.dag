module v2.std.execution_mechanism

import std.types { String }

data execution_mechanism_authority_note: String = "The mechanism behind the legacy `transport shell` spelling is derived from what the realization DOES, never copied from that spelling and never hand-labelled at each operation. This module owns only the agnostic five-way result shape; executable, wrapper, shell-interpreter, and OpenSSH recognition is realization dispatch in extdeps.execution.mechanism. RemoteStructuredExecution is deliberately distinct and currently uninhabited by a handler: it requires a future receiver that accepts a structured invocation and calls exec without shell reinterpretation. ForeignShellArtifact is not execution by this runtime at all: shell text is emitted for GitHub Actions run steps, cron, git hooks, or another foreign executor. These five mechanisms are orthogonal to Placement and Materialization in std.realization: where work occurs and whether it is shared do not say how an operation crosses its execution boundary."

type ExecutionMechanism
  = LocalProcess
  | LocalShellScript
  | RemoteShellCommand
  | RemoteStructuredExecution
  | ForeignShellArtifact
