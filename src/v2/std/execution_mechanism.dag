module v2.std.execution_mechanism

import std.types { String }

data execution_mechanism_authority_note: String = "The mechanism behind the legacy `transport shell` spelling is derived from what the realization DOES, never copied from that spelling and never hand-labelled at each operation. The seed's dispatch_shell calls std::process::Command::new(argv[0]): an ordinary executable is LocalProcess; a local shell interpreter reads a script as LocalShellScript; OpenSSH is RemoteShellCommand because its remote command is reconstructed and interpreted by the far-side shell. RemoteStructuredExecution is deliberately distinct and currently uninhabited by a handler: it requires a future receiver that accepts a structured invocation and calls exec without shell reinterpretation. ForeignShellArtifact is not execution by this runtime at all: shell text is emitted for GitHub Actions run steps, cron, git hooks, or another foreign executor. These five mechanisms are orthogonal to Placement and Materialization in std.realization: where work occurs and whether it is shared do not say how an operation crosses its execution boundary."

type ExecutionMechanism
  = LocalProcess
  | LocalShellScript
  | RemoteShellCommand
  | RemoteStructuredExecution
  | ForeignShellArtifact

type ExecutionMechanismEvidence
  = SpawnExecutable { executable: String }
  | SendStructuredInvocationToRemoteReceiver
  | EmitShellTextForForeignExecutor

fn executable_is(executable: String, name: String) -> Bool {
  (executable == name) || ends_with(s: executable, suffix: concat("/", name))
}

fn spawned_executable_mechanism(executable: String) -> ExecutionMechanism {
  if executable_is(executable: executable, name: "ssh") {
    RemoteShellCommand
  } else if executable_is(executable: executable, name: "sh")
    || executable_is(executable: executable, name: "bash")
    || executable_is(executable: executable, name: "dash")
    || executable_is(executable: executable, name: "ksh")
    || executable_is(executable: executable, name: "zsh") {
    LocalShellScript
  } else {
    LocalProcess
  }
}

fn execution_mechanism_from_evidence(evidence: ExecutionMechanismEvidence) -> ExecutionMechanism {
  match evidence {
    SpawnExecutable { executable: executable } =>
      spawned_executable_mechanism(executable: executable)
    SendStructuredInvocationToRemoteReceiver => RemoteStructuredExecution
    EmitShellTextForForeignExecutor => ForeignShellArtifact
  }
}
