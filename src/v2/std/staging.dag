module v2.std.staging

import std.cache_identity { CacheInterfaceId }
import v2.std.diagnostic { Outcome, bind_outcome, outcome_accepted }
import std.realization { Materialization }
import v2.std.materialization_carriers {
  compile_stage_memo_provider_id,
  compile_stage_memo_materialization,
}

fn then_outcome<A, B, C>(
  f: fn(A) -> Outcome<B>,
  g: fn(B) -> Outcome<C>
) -> fn(A) -> Outcome<C> {
  fn(x) { bind_outcome(o: f(x), f: g) }
}

type CacheProbe<B>
  = Miss
  | Hit { value: B }

fn resolve_probe<A, B>(
  probe: CacheProbe<B>,
  stage: fn(A) -> Outcome<B>,
  x: A
) -> Outcome<B> {
  match probe {
    Hit { value: hit } => outcome_accepted(value: hit)
    Miss => stage(x)
  }
}

type CachedStageRealization {
  provider_id: CacheInterfaceId
  materialization: Materialization
}

fn cached_stage_realization() -> CachedStageRealization {
  CachedStageRealization {
    provider_id: compile_stage_memo_provider_id(),
    materialization: compile_stage_memo_materialization(),
  }
}

fn cached_stage<A, B>(
  lookup: fn(A) -> CacheProbe<B>,
  stage: fn(A) -> Outcome<B>
) -> fn(A) -> Outcome<B> {
  fn(x) {
    resolve_probe(probe: lookup(x), stage: stage, x: x)
  }
}
