module v2.std.staging


fn then_outcome<A, B, C>(
  f: fn(A) -> v2.std.diagnostic.Outcome<B>,
  g: fn(B) -> v2.std.diagnostic.Outcome<C>
) -> fn(A) -> v2.std.diagnostic.Outcome<C> {
  fn(x) { v2.std.diagnostic.bind_outcome(o: f(x), f: g) }
}

type CacheProbe<B>
  = Miss
  | Hit { value: B }

fn resolve_probe<A, B>(
  probe: CacheProbe<B>,
  stage: fn(A) -> v2.std.diagnostic.Outcome<B>,
  x: A
) -> v2.std.diagnostic.Outcome<B> {
  match probe {
    Hit { value: hit } => v2.std.diagnostic.outcome_accepted(value: hit)
    Miss => stage(x)
  }
}

fn cached_stage<A, B>(
  lookup: fn(A) -> CacheProbe<B>,
  stage: fn(A) -> v2.std.diagnostic.Outcome<B>
) -> fn(A) -> v2.std.diagnostic.Outcome<B> {
  fn(x) {
    resolve_probe(probe: lookup(x), stage: stage, x: x)
  }
}
