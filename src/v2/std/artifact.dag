module v2.std.artifact

import v2.std.diagnostic { Accepted, Locus, Outcome, Rejected }
import v2.std.node { Node, Symbol }
import v2.std.refinement { Refined, Validation, refine }
import v2.std.text { String }

type ArtifactKind
  = SourceFile
  | GeneratedSource
  | TestClaimArtifact
  | ProjectionArtifact
  | Stage0Candidate
  | CorePackage
  | WitnessBundle

type Artifact {
  kind: ArtifactKind
  id: Symbol
  file_path: String
}

type GeneratorId = Symbol

type GeneratedArtifact {
  refined: Refined<Artifact>
}

fn artifact_is_generated(a: Artifact) -> Bool {
  match a.kind {
    GeneratedSource => true
    TestClaimArtifact => true
    SourceFile => false
    ProjectionArtifact => false
    Stage0Candidate => false
    CorePackage => false
    WitnessBundle => false
  }
}

data generated_artifact_validation: Validation<Artifact> = Validation {
  reason: ^generator_provenance_artifact_not_generated,
  admits: artifact_is_generated
}

fn make_generated_artifact(base: Artifact, at: Locus) -> Outcome<GeneratedArtifact> {
  match refine(base: base, by: generated_artifact_validation, at: at) {
    Accepted { value: refined, diagnostics } =>
      Accepted { value: GeneratedArtifact { refined: refined }, diagnostics: diagnostics }
    Rejected { diagnostics } => Rejected { diagnostics: diagnostics }
  }
}

fn test_claim_generated_artifact(id: Symbol, file_path: String) -> GeneratedArtifact {
  GeneratedArtifact {
    refined: Refined {
      base: Artifact { kind: TestClaimArtifact, id: id, file_path: file_path }
    }
  }
}

type GeneratorProvenance {
  generator_id: GeneratorId
  artifact: GeneratedArtifact
}

type NodeArtifactProvenance {
  node: Node
  artifact: Artifact
}
