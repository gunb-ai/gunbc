module v2.workflow.orchestration_bash_emit_support


data orchestration_bash_emit_support_note: String = "Shared run/do/comment/emit_pipeline helpers for v2.workflow.ci_*_emit modules (bucket D). Each emit module keeps its own refused_poison string; this module holds the byte-identical plumbing only. Pre-existing ci_*_emit forks migrate onto these helpers in a later slice. orch_bash_comment_line uses PipelineStep.Comment (non-command), not a fake Do-run."

fn orch_bash_run(command: String) -> v2.std.orchestration.Run {
  v2.std.orchestration.Run {
    command: command,
    env: Empty,
    redirect: v2.std.collection.Absent,
    capture: v2.std.collection.Absent
  }
}

fn orch_bash_do(command: String) -> v2.std.orchestration.PipelineStep {
  v2.std.orchestration.Do { run: orch_bash_run(command: command) }
}

fn orch_bash_comment_line(text: String) -> v2.std.orchestration.PipelineStep {
  v2.std.orchestration.Comment { text: text }
}

fn orch_bash_emit_pipeline(p: v2.std.orchestration.Pipeline, refused_poison: String) -> String {
  match v2.compiler.emit_orchestration.orch_emit_pipeline(p: p, medium: v2.extdeps.languages.bash_orchestration_emit.bash_orchestration_emit_medium()) {
    v2.std.diagnostic.Accepted { value: source, diagnostics: d } =>
      match d {
        v2.std.diagnostic.None => source.carried
        v2.std.diagnostic.Some { diagnostics: _ } => refused_poison
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => refused_poison
  }
}
