module v2.workflow.wet_evidence

import std.types { List, Map }
import std.algebra { list_append, contains, empty_map, fold_list, length, map_contains_key, map_insert, map_lookup }
import v2.std.decl_index { DeclFact }
import std.optional { Absent, Present }
import v2.std.text { String }
import v2.std.integer { Int }
import v2.workflow.floor2_prepared_subject { WitnessIdentity, witness_identity_qualified_name }
import v2.workflow.floor_terminal_ledger {
  ClaimAttemptTerminal, ClaimExpectation, ClaimTerminalRow, ClaimDisposition,
  ExpectedToHold, ExpectedRed,
  Passed, Failed, KnownRedHeld, KnownRedNowPassing, BudgetRefusedBeforeVerdict,
  PassedOverBudget, BudgetTerminalWithoutSafetyCause, HostToolUnresolvedBeforeVerdict,
  RouteGapBeforeVerdict, RuntimeErroredBeforeVerdict, PanickedBeforeVerdict,
  NotAttemptedAfterAbort, ObservationUnreadableBeforeVerdict, SubjectUnresolvedBeforeVerdict,
  claim_disposition
}

// THE ONE WET-ADMISSION INTERFACE, AND THE REASON IT IS NOT A THIRD VOCABULARY.
//
// Two routes produce wet evidence for the required floor's changed-witness fold, and until this
// module they each answered "did the wet evidence hold" with their own types:
// `v2.workflow.local_repo_wet_terminal` for a co-resident execution the floor runs itself, and
// `v2.workflow.floor_wet_route` for a receipt transported from a lane that ran elsewhere. One
// question, two authorities, both imported by one fold -- the meaning fork DESIGN section 3
// forbids, and the reason its consumer could not state which relation admitted a row.
//
// THE TERMINAL VOCABULARY IS NOT MINTED HERE AND MUST NEVER BE. `v2.workflow.floor_terminal_ledger`
// already owns the raw attempt terminal, the observed-verdict versus unreadable-observation split,
// the expectation, and the thirteen derived dispositions -- and `v2.workflow.floor_changed_witness`,
// the fold both routes feed, already imports it. Replacing two parallel terminal types with a third
// would be the same fork wearing a new name, so this module IMPORTS that vocabulary and adds only
// what is genuinely absent from it: which evidential relation bound the terminal to this tree.
//
// THE COINCIDENCE THAT ESTABLISHED THE SHARED VOCABULARY WAS PROVEN, NOT ARGUED. Four independent
// arrivals at one distinction: the ledger derives `PassedOverBudget` and `KnownRedNowPassing` from
// a completed-past-limit terminal by expectation; the floor's own seed keeps
// `completed_over_cost_requirement` apart from `interrupted_before_verdict`;
// `local_repo_wet_terminal` un-collapsed `LocalRepoWetCompletedOverBudget` out of its nonterminal
// arm; and `floor_wet_route` separated cost debt from no-verdict the same week, each without
// reading the others. DESIGN section 6 asks for proven coincidence before unifying vocabulary, and
// four arrivals is that proof -- a far better argument than reasoning about elegance.

// WHICH ROUTE PRODUCED A ROW. Not decoration: the two routes have DIFFERENT DRY ANTECEDENTS (see
// `WetRouteAntecedent`) and different bindings, so a row that cannot say which route it came from cannot
// be validated against the right relation. It is also what makes the cross-route disjointness wall
// below expressible at all.
type WetRoute
  = LocalRepoCoResidentRoute
  | SelfHostTransportedRoute

// WHAT THE DRY SIDE OF THIS IDENTITY ACTUALLY DID -- FUSED WITH THE ROUTE, because the two facts
// are not independent and a type that lets them vary separately admits states that cannot exist.
//
// The co-resident route SUPPLEMENTS a real hermetic attempt: the identity was planned, executed,
// reached a host effect the hermetic route has no arm for, and produced a genuine
// route-gap-before-verdict terminal. The transported route REPLACES a deliberate non-execution:
// the identity was declined and routed to the wet lane, so no hermetic attempt was ever made.
//
// Same evidence, different antecedent. A content-free "wet passed" arm would erase that difference
// and let a deliberate decline read exactly like an observed route gap -- the state-space
// conflation that makes "this witness executed nowhere" indistinguishable from "this witness tried
// and could not reach its subject".
//
// THIS WAS TWO INDEPENDENT FIELDS FOR ONE COMMIT AND THAT WAS A DEFECT. `route: WetRoute` beside
// `dry_source: WetDrySource` admitted two pairings with no referent -- a co-resident execution
// after a deliberate decline, and a transported receipt after an observed hermetic route gap --
// and nothing read the second field, so the distinction was COMMENTARY a realization could
// contradict. An ordinary data row whose only function is to say something is what DESIGN section
// 4c forbids, and a check standing where construction was available is what section 5 forbids.
//
// The repair is structural rather than a validator: the invalid combinations have NO CONSTRUCTOR.
// The route is DERIVED from the antecedent below, so the two can no longer disagree -- rung 4
// rather than the rung 2 an exhaustive mismatch refusal would have bought, and it costs no witness
// because there is no invalid state left to witness.
type WetRouteAntecedent
  = LocalRepoAfterHermeticRouteGap
  | SelfHostAfterDirectWetDecline

// THE ROUTE IS A PROJECTION OF THE ANTECEDENT, never a field beside it. Total, so a new antecedent
// arm must decide its route here rather than defaulting to one.
fn wet_route_of_antecedent(antecedent: WetRouteAntecedent) -> WetRoute {
  match antecedent {
    LocalRepoAfterHermeticRouteGap => LocalRepoCoResidentRoute {}
    SelfHostAfterDirectWetDecline => SelfHostTransportedRoute {}
  }
}

// WHAT BINDS A TERMINAL TO THIS TREE, TYPED BY WHICH RELATION PRODUCED IT.
//
// This is the load-bearing decision of the convergence. `local_repo_wet_terminal` had a
// `candidate: String` compared with `==`, which DID decide admission -- so it was a validity key
// and not provenance -- but a bare String cannot say WHICH validity relation produced it, so a
// consumer could not tell a prepared-subject identity from a transported receipt's subject digest,
// and the two are not interchangeable facts.
//
// The arms are asymmetric ON PURPOSE, and pushing either side's fields onto the other would be a
// modeling error rather than a generalization:
//
//   CO-RESIDENT. The execution ran inside the floor, against the subject the floor prepared. The
//   binding is that prepared subject and nothing else. Executor-contract identity and receipt
//   freshness are MEANINGLESS here -- there is no second executor and no elapsed time between
//   production and consumption, so carrying them would be fields no arm can populate honestly.
//
//   TRANSPORTED. The receipt was produced by another process, at another time, possibly by another
//   build of the executor. The semantic subject says the TREE agreed; the executor contract says
//   the PRODUCER agreed. Both are required, because a receipt produced by a different executor over
//   the same tree is a different evidential fact -- which is exactly the hole an absent executor
//   contract re-opens.
//
// So `executor_contract` is a required field of the transported arm and NOT an optional one. An
// absent executor contract has no constructor here; it cannot be defaulted permissively, and a
// producer that has not got one refuses rather than binding.
type WetEvidenceBinding
  = CoResidentPreparedSubject { prepared_subject: String }
  | TransportedReceiptSubject { semantic_subject: String, executor_contract: String }

// THE BATCH-LEVEL REQUIREMENT, AND WHY THE BINDING IS NO LONGER A FREE PARAMETER.
//
// THIS IS THE SAME DEFECT AS `dry_source`, ONE LEVEL UP, AND IT SURVIVED THE FIRST REPAIR FOR A
// REASON WORTH WRITING DOWN: that fix fused the two facts that were adjacent IN THE TYPE, while the
// third fact entered through a different door -- as an ARGUMENT. Fusing a coproduct closes the
// pairings inside it; it does not close a parameter supplied beside it.
//
// Concretely, the batch below was constructible and ADMITTED: a schedule whose antecedent is
// `LocalRepoAfterHermeticRouteGap`, a required binding of `TransportedReceiptSubject`, and
// terminals carrying that same transported binding. Every pairwise check passed -- the terminal's
// route matched the schedule's antecedent, and the observed binding matched the required binding --
// so nothing refused, and a co-resident schedule was satisfied by transported evidence. The inverse
// was equally writable. `WetBindingRelationMismatch` never fired, because it compares OBSERVED
// against REQUIRED and both agreed; what disagreed was ROUTE against REQUIRED RELATION, and those
// two never met.
//
// The repair is structural for the third time rather than a fourth validator: ONE authority per
// batch, from which route, antecedent and required binding are ALL derived totally. There is no
// longer a way to say "local schedule, transported requirement", because the requirement IS the
// route. The arms carry exactly the fields their relation needs, which is why they are not a
// re-spelling of `WetEvidenceBinding`: the binding says what a terminal must match, the requirement
// says which relation the whole batch is being validated under.
type WetEvidenceRequirement
  = LocalRepoCoResidentRequirement { prepared_subject: String }
  | SelfHostTransportedRequirement { semantic_subject: String, executor_contract: String }

fn wet_antecedent_of_requirement(requirement: WetEvidenceRequirement) -> WetRouteAntecedent {
  match requirement {
    LocalRepoCoResidentRequirement { prepared_subject: _ } => LocalRepoAfterHermeticRouteGap {}
    SelfHostTransportedRequirement { semantic_subject: _, executor_contract: _ } => SelfHostAfterDirectWetDecline {}
  }
}

fn wet_binding_of_requirement(requirement: WetEvidenceRequirement) -> WetEvidenceBinding {
  match requirement {
    LocalRepoCoResidentRequirement { prepared_subject: p } =>
      CoResidentPreparedSubject { prepared_subject: p }
    SelfHostTransportedRequirement { semantic_subject: s, executor_contract: x } =>
      TransportedReceiptSubject { semantic_subject: s, executor_contract: x }
  }
}

fn wet_route_of_requirement(requirement: WetEvidenceRequirement) -> WetRoute {
  wet_route_of_antecedent(antecedent: wet_antecedent_of_requirement(requirement: requirement))
}

// ONE SCHEDULED CLAIM. Expectation is the LEDGER's, carrying both arms, and the width is deliberate:
// a shared type being ABLE to represent expected-red does not assert that any given route schedules
// one. The co-resident roster constructs only `ExpectedToHold` -- that narrowness is ROSTER POLICY
// and survives this convergence untouched -- while the transported route derives `ExpectedRed` from
// the canonical enrollment authority. Narrowing the shared type to the narrower roster would make
// the wider route unrepresentable; widening the narrow roster would be rung inflation. Neither
// happens, because policy lives in the roster and not in the type.
type WetScheduledClaim {
  identity: WitnessIdentity
  entry: String
  function: String
  expectation: ClaimExpectation
}

// A HOST PREMISE: a fact about the RUNNER that a scheduled claim needs before its subject can be
// reached at all, and that the claim neither creates nor supplies. It is declared, never inferred
// from a failure: a premise read after the claim failed would be an excuse authored by the
// verdict, so the executor reads it BEFORE invoking the claim and records which one it read.
//
// The arms name premises, not probes. How a premise is read back is realized where its authority
// lives (`gunbc.runner.wet_host_premise_readback`), so this vocabulary stays free of the runner modules
// and the join below can be validated against supplied readings.
type WetHostPremise
  = RunnerBrowserToolchainReadyForJobUser {}

fn wet_host_premise_name(premise: WetHostPremise) -> String {
  match premise {
    RunnerBrowserToolchainReadyForJobUser => "runner-browser-toolchain-ready-for-job-user"
  }
}

// ONE DECLARED PREMISE PER CLAIM, keyed by identity. A separate keyed roster rather than a field on
// `WetScheduledClaim`: the premise is a fact about the RUNNER the claim lands on, not about what the
// claim asserts, and almost every scheduled claim declares none. A claim absent from the roster has
// no premise, and its failures stay `WetTerminalVerdictNotExpected` exactly as before.
type WetPremisedClaim {
  identity: WitnessIdentity
  premise: WetHostPremise
}

// WHAT THE PREMISE READBACK ANSWERED, in the premise authority's own words when it is unmet. Unmet
// carries those words verbatim -- the toolchain's readback standing names the path and what was
// missing -- because a generic "premise unmet" would send the reader to the runner without saying
// which part of it.
type WetHostPremiseReading
  = WetHostPremiseMet { premise: WetHostPremise }
  | WetHostPremiseUnmet { premise: WetHostPremise, words: String }

// WHAT THE EXECUTOR DID WITH ONE SCHEDULED IDENTITY. FUSED, like the route and its antecedent: an
// unmet premise means the claim was NEVER INVOKED, so there is no attempt terminal to carry, and a
// row that held both "premise unmet" and an attempt terminal would describe a state that cannot
// exist. A met premise, or no declared premise, leads to an attempt, and that attempt is the
// ledger's terminal unchanged.
type WetTerminal
  = WetClaimAttempted { attempt: ClaimAttemptTerminal }
  | WetPremiseUnmetBeforeAttempt { premise: WetHostPremise, words: String }

// ONE TERMINAL ROW. `observed_entry` and `observed_function` are what the executor ACTUALLY
// resolved and invoked, never the scheduled row echoed back -- recopying them makes the foreign-
// resolution join below tautological, so the producer must record what it resolved.
// `route` STAYS AN INDEPENDENT FIELD HERE, and deliberately so -- it is not the same fact as the
// requirement's derived route. The requirement says which route this batch is being validated
// UNDER; this field says which route the executor reports it ACTUALLY ran. Deriving it away would
// make the foreign-route refusal below unreachable by construction, which is the decoration DESIGN
// section 4b warns about: a check whose RED cannot be authored. So the schedule's route is derived
// and the observation's route is carried, and the join between them is load-bearing.
type WetTerminalRow {
  route: WetRoute
  identity: WitnessIdentity
  observed_entry: String
  observed_function: String
  terminal: WetTerminal
  binding: WetEvidenceBinding
}

// THE REFUSALS, SEPARATED BY REMEDY. Each names a different thing to go and fix, and collapsing any
// two of them into a generic "evidence invalid" cause -- or into a detail string, which is not a
// typed cause and cannot be joined on -- erases a correctness distinction. The three binding
// mismatches in particular stay three: a prepared-subject difference, a semantic-subject difference
// and an executor-contract difference send a reader to three different places.
type WetEvidenceRefusal
  = WetTerminalMissing { identity: String }
  | WetTerminalDuplicated { identity: String, occurrences: Int }
  | WetTerminalUnscheduled { identity: String }
  | WetTerminalForeignEntry { identity: String, observed: String, required: String }
  | WetTerminalForeignFunction { identity: String, observed: String, required: String }
  | WetTerminalVerdictNotExpected { identity: String, disposition: ClaimDisposition }
  | WetTerminalHostPremiseUnmet { identity: String, premise: WetHostPremise, words: String }
  | WetTerminalForeignRoute { identity: String }
  | WetBindingPreparedSubjectDiffers { identity: String, observed: String, required: String }
  | WetBindingSemanticSubjectDiffers { identity: String, observed: String, required: String }
  | WetBindingExecutorContractDiffers { identity: String, observed: String, required: String }
  | WetBindingRelationMismatch { identity: String }
  | WetCrossRouteIdentityOverlap { identity: String }
  | WetScheduledIdentityDuplicated { identity: String, occurrences: Int }
  | WetScheduledFunctionNotDeclared { identity: String, entry: String, function: String }

type WetEvidenceValidation
  = WetEvidenceAdmitted { binding: WetEvidenceBinding, terminals: List<WetTerminalRow> }
  | WetEvidenceRefused { causes: List<WetEvidenceRefusal> }

// THE BINDING COMPARISON IS AN EXHAUSTIVE MATCH ON BOTH SIDES, which is the whole reason the
// binding is typed. The off-diagonal cells are `WetBindingRelationMismatch`: a transported receipt
// offered where a co-resident execution was required is not a digest that happens to differ, it is
// evidence of the wrong KIND, and a String comparison could only ever have reported "not equal".
fn wet_binding_causes(identity: String, observed: WetEvidenceBinding, required: WetEvidenceBinding) -> List<WetEvidenceRefusal> {
  match required {
    CoResidentPreparedSubject { prepared_subject: r } =>
      match observed {
        CoResidentPreparedSubject { prepared_subject: o } =>
          if o == r { [] } else { [WetBindingPreparedSubjectDiffers { identity: identity, observed: o, required: r }] }
        TransportedReceiptSubject { semantic_subject: _, executor_contract: _ } =>
          [WetBindingRelationMismatch { identity: identity }]
      }
    TransportedReceiptSubject { semantic_subject: rs, executor_contract: rx } =>
      match observed {
        CoResidentPreparedSubject { prepared_subject: _ } =>
          [WetBindingRelationMismatch { identity: identity }]
        TransportedReceiptSubject { semantic_subject: os, executor_contract: ox } =>
          if os != rs {
            [WetBindingSemanticSubjectDiffers { identity: identity, observed: os, required: rs }]
          } else {
            if ox != rx {
              [WetBindingExecutorContractDiffers { identity: identity, observed: ox, required: rx }]
            } else {
              []
            }
          }
      }
  }
}

// WHETHER THE OBSERVED TERMINAL MEETS THE SCHEDULED EXPECTATION IS THE LEDGER'S DERIVATION, NOT A
// SECOND ONE. `claim_disposition` already folds terminal and expectation into thirteen
// dispositions, including the completed-past-limit split this convergence was partly about, so
// asking it here is what keeps the cost-versus-defect distinction from being re-implemented for a
// third time. Exactly two dispositions are agreement: the claim held as expected, or it is an
// enrolled red observed red. Every other disposition is a refusal that names WHICH one it was,
// which is what a Bool could never carry.
fn wet_disposition_is_agreement(d: ClaimDisposition) -> Bool {
  match d {
    Passed => true
    KnownRedHeld => true
    Failed => false
    KnownRedNowPassing => false
    BudgetRefusedBeforeVerdict => false
    PassedOverBudget => false
    BudgetTerminalWithoutSafetyCause => false
    HostToolUnresolvedBeforeVerdict => false
    RouteGapBeforeVerdict => false
    RuntimeErroredBeforeVerdict => false
    PanickedBeforeVerdict => false
    NotAttemptedAfterAbort => false
    ObservationUnreadableBeforeVerdict => false
    SubjectUnresolvedBeforeVerdict => false
  }
}

fn wet_route_eq(a: WetRoute, b: WetRoute) -> Bool {
  match a {
    LocalRepoCoResidentRoute =>
      match b { LocalRepoCoResidentRoute => true  SelfHostTransportedRoute => false }
    SelfHostTransportedRoute =>
      match b { LocalRepoCoResidentRoute => false SelfHostTransportedRoute => true }
  }
}

fn wet_identity_name(identity: WitnessIdentity) -> String {
  witness_identity_qualified_name(identity: identity)
}

fn wet_terminals_for(name: String, terminals: List<WetTerminalRow>) -> List<WetTerminalRow> {
  filter(xs: terminals, predicate: fn(t) { wet_identity_name(identity: t.identity) == name })
}

// THE FORWARD JOIN: every scheduled claim has exactly one terminal, produced by the route that
// scheduled it, bound to this tree by the required relation, naming the entry and function that
// were actually resolved, with a disposition the expectation admits. A claim never invoked because
// its declared host premise read back unmet refuses as `WetTerminalHostPremiseUnmet`: the runner,
// not the subject. Still a refusal -- never a pass, a skip or a widen (DESIGN section 5) -- but its
// remedy is the host the lane ran on.
fn wet_forward_causes(
  scheduled: List<WetScheduledClaim>,
  terminals: List<WetTerminalRow>,
  requirement: WetEvidenceRequirement
) -> List<WetEvidenceRefusal> {
  let required = wet_binding_of_requirement(requirement: requirement)
  let required_route = wet_route_of_requirement(requirement: requirement)
  fold_list(
    xs: scheduled,
    empty: [],
    cons: fn(acc, s) {
      let name = wet_identity_name(identity: s.identity)
      let hits = wet_terminals_for(name: name, terminals: terminals)
      let n = length(xs: hits)
      if n == 0 {
        list_append(left: acc, right: [WetTerminalMissing { identity: name }])
      } else {
        if n > 1 {
          list_append(left: acc, right: [WetTerminalDuplicated { identity: name, occurrences: n }])
        } else {
          fold_list(
            xs: hits,
            empty: acc,
            cons: fn(inner, t) {
              if !wet_route_eq(a: t.route, b: required_route) {
                list_append(left: inner, right: [WetTerminalForeignRoute { identity: name }])
              } else {
                let binding_causes = wet_binding_causes(identity: name, observed: t.binding, required: required)
                if length(xs: binding_causes) != 0 {
                  list_append(left: inner, right: binding_causes)
                } else {
                  if t.observed_entry != s.entry {
                    list_append(left: inner, right: [WetTerminalForeignEntry { identity: name, observed: t.observed_entry, required: s.entry }])
                  } else {
                    if t.observed_function != s.function {
                      list_append(left: inner, right: [WetTerminalForeignFunction { identity: name, observed: t.observed_function, required: s.function }])
                    } else {
                      match t.terminal {
                        WetPremiseUnmetBeforeAttempt { premise: p, words: w } =>
                          list_append(left: inner, right: [WetTerminalHostPremiseUnmet { identity: name, premise: p, words: w }])
                        WetClaimAttempted { attempt: a } => {
                          let disposition = claim_disposition(
                            row: ClaimTerminalRow { identity: s.identity, expectation: s.expectation, terminal: a }
                          )
                          if wet_disposition_is_agreement(d: disposition) {
                            inner
                          } else {
                            list_append(left: inner, right: [WetTerminalVerdictNotExpected { identity: name, disposition: disposition }])
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          )
        }
      }
    }
  )
}

// THE REVERSE JOIN, which is what makes this a SET EQUALITY and not a coverage count. A terminal for
// an identity nobody scheduled means the executor ran something no roster describes, and admitting
// it would let an unscheduled row supply evidence for itself.
fn wet_reverse_causes(
  scheduled: List<WetScheduledClaim>,
  terminals: List<WetTerminalRow>
) -> List<WetEvidenceRefusal> {
  let scheduled_names = fold_list(
    xs: scheduled,
    empty: [],
    cons: fn(acc, s) { list_append(left: acc, right: [wet_identity_name(identity: s.identity)]) }
  )
  fold_list(
    xs: terminals,
    empty: [],
    cons: fn(acc, t) {
      let name = wet_identity_name(identity: t.identity)
      if contains(xs: scheduled_names, item: name, eq: wet_string_eq) {
        acc
      } else {
        list_append(left: acc, right: [WetTerminalUnscheduled { identity: name }])
      }
    }
  )
}

// The second pass of the fold below accumulates causes AND the names already emitted, so each
// duplicated identity is named exactly once and in first-occurrence order.
type WetScheduleDuplicateSweep {
  causes: List<WetEvidenceRefusal>
  emitted: List<String>
}

// THE SCHEDULE'S OWN UNIQUENESS, CHECKED WHERE THE SCHEDULE IS CONSUMED.
//
// THE HOLE THIS CLOSES: the forward join walks SCHEDULED, so one identity written twice finds the
// same single terminal twice -- each row sees exactly n==1 and passes -- and the reverse join sees a
// scheduled name that is present. The sibling roster claims miss it too:
// every_roster_row_spells_its_function_the_same_way_twice reads WITHIN a row, and
// the_local_roster_is_not_empty compares length(identities) to length(schedule), which is a map --
// equal over a duplicate. The executor's own builder refuses this at its grain
// (`local_repo_wet_schedule` in cli_run/required_floor_runner.rs refuses "duplicate scheduled
// identity" with a seen-guard) -- THE SEED PRECEDENT -- but the executor is one caller of this fold
// and the fold is the authority: any fixture schedule, or future caller, handing one identity twice
// must refuse HERE, naming it, and not silently pass.
//
// WHY A MAP FOLD AND NOT THE PAIRWISE SCAN THE DEFERRAL MEMO MEASURED (the memo at
// v2.test.claim.local_repo_wet_terminal, above the roster claims): the memo's premise -- "not
// made linear by any construction available -- the substrate offers no set and no sort over String"
// -- is falsified by std.algebra's HAMT map: empty_map/map_insert/map_lookup, used in production
// through fold_list by v2.lens.text_string_importer_census (map_over_paths) and
// v2.lens.module_impact_query (build_impact_pool_index). This fold is two linear passes; no O(n^2)
// scan is involved.
// The emitted order is FIRST-OCCURRENCE order of the schedule (the second pass walks scheduled and
// emits each duplicated name once, tracked by an emitted-name list), never a map-iteration order.
fn wet_scheduled_identity_duplicate_causes(
  scheduled: List<WetScheduledClaim>
) -> List<WetEvidenceRefusal> {
  let counts: Map<String, Int> = fold_list(
    xs: scheduled,
    empty: empty_map(),
    cons: fn(m, s) {
      let name = wet_identity_name(identity: s.identity)
      match map_lookup(m: m, key: name) {
        Absent => map_insert(m: m, key: name, value: 1)
        Present { value: prior } => map_insert(m: m, key: name, value: prior + 1)
      }
    }
  )
  let swept = fold_list(
    xs: scheduled,
    empty: WetScheduleDuplicateSweep { causes: [], emitted: [] },
    cons: fn(acc, s) {
      let name = wet_identity_name(identity: s.identity)
      match map_lookup(m: counts, key: name) {
        Absent => acc
        Present { value: n } =>
          if n > 1 && !contains(xs: acc.emitted, item: name, eq: wet_string_eq) {
            WetScheduleDuplicateSweep {
              causes: list_append(
                left: acc.causes,
                right: [WetScheduledIdentityDuplicated { identity: name, occurrences: n }]
              ),
              emitted: list_append(left: acc.emitted, right: [name])
            }
          } else {
            acc
          }
      }
    }
  )
  swept.causes
}

fn wet_string_eq(a: String, b: String) -> Bool {
  a == b
}

// The second pass accumulates causes AND the keys already emitted, so one dangling (entry, function)
// pair is named exactly once and in first-occurrence order. `emitted` is a key SET, not a log: the
// only question ever asked of it is "have I reported this key", which is a membership question, and
// DESIGN §6 admits no copied-accumulator list scan where a map lookup does the same job (a
// quadratic fold is fixed regardless of realized n).
type WetScheduledDeclarationSweep {
  causes: List<WetEvidenceRefusal>
  emitted: Map<String, Int>
}

// THE SCHEDULE'S OTHER DANGLE: A ROW WHOSE ENTRY NEVER DECLARES ITS FUNCTION.
//
// THE HOLE THIS CLOSES (parent-confirmed by execution, msg_6e4fb4e8): a schedule row naming a
// function that does not exist in its entry file passes everything. The forward join compares the
// row to ITSELF (both sides read s.identity), so it cannot see the name is fiction, and the
// enumerating witness fails to lower. The executor's own grain refuses it --
// `validate_explicit_functions` in src/v1/stage0/src/bin/claim_batch.rs parses the entry, keeps the
// FnItem names, and exits 2 naming what is missing (THE SEED PRECEDENT) -- but the executor is one
// caller of this fold and the fold is the authority: any fixture schedule, or future caller, handing
// a row whose function is never declared must refuse HERE, naming it.
//
// WHY THE POPULATION IS A PARAMETER AND NOT A READ. This fold is pure over `declared`, the same
// way `execution` is handed to `local_repo_wet_finalize`: fixtures stay fixtures. The population is
// v2.std.decl_index's declaration census -- the EXISTING index, not a grep and not a second parser.
// The real-schedule control claim reads it ONCE and binds it (the fleet precedent,
// test.claim.fleet.runtime_identity_match_witness.test_axis_table_citations_resolve_against_the_declaration_census:
// an unbound per-row census read cost ~3.6s each and looked like a hang; one bound read is the
// measured shape). WHICH roots the control passes is decided there, at the call site, by the fleet's
// own authority gunbc.ci.ci_layer_roots.witness_layer_roots -- the same roots the fleet itself is
// invoked with, so the census can never be narrower than the entry population. This comment names
// that authority rather than restating its contents (§4c); what it does fix is the boundary the
// choice must never cross: NOT `src` (CensusNotRunnable poison, keen-owl-704) and NOT a wider pool
// paid for per probe.
//
// WHY MEMBERSHIP IS (rel_path, name) AND NOT A KIND FILTER. The executor's seed filters
// `item_kind == FnItem`, and `item_kind` (src/v1/stage0/src/v1_compiler_infer_items.rs) classifies a
// body-carrying item with a return annotation and NO parameters as DataItem -- so every one of the
// 515 real schedule rows, which are zero-parameter `test fn` claims returning Bool, is DataItem in
// this census. A kind gate would false-refuse the entire wet route. What the fold needs is not
// "is this a function" but "does this entry file DECLARE this name at all": a type or data
// declaration wearing the claimed name is still a collision worth refusing over, and a claim whose
// name is nowhere in the file is the dangle. That is the strongest fact the index supports at this
// grain, and the seed's own refusal message -- "does not declare requested function(s)" -- is a
// declaration-membership question, which is what is mirrored here.
//
// THE KEY IS AN AUTHORING KEY, not the index's logical qualified name: the schedule carries a file
// path (`entry`), not a module, and the index carries both a rel_path and a module-derived
// qualified_name. Joining path-to-path needs no string surgery and no v2.-prefix rule; joining
// identity-to-qualified_name would have to re-derive the module from the path, a second authority
// over one fact. Emission order is FIRST-OCCURRENCE order of the schedule, never a map order.
fn wet_scheduled_function_declared_causes(
  scheduled: List<WetScheduledClaim>,
  declared: List<DeclFact>
) -> List<WetEvidenceRefusal> {
  let membership: Map<String, Int> = fold_list(
    xs: declared,
    empty: empty_map(),
    cons: fn(m, f) { map_insert(m: m, key: concat(concat(f.rel_path, "#"), f.name), value: 1) }
  )
  let swept = fold_list(
    xs: scheduled,
    empty: WetScheduledDeclarationSweep { causes: [], emitted: empty_map() },
    cons: fn(acc, s) {
      let key = concat(concat(s.entry, "#"), s.function)
      if !map_contains_key(m: membership, key: key)
        && !map_contains_key(m: acc.emitted, key: key) {
        WetScheduledDeclarationSweep {
          causes: list_append(
            left: acc.causes,
            right: [WetScheduledFunctionNotDeclared {
              identity: wet_identity_name(identity: s.identity),
              entry: s.entry,
              function: s.function
            }]
          ),
          emitted: map_insert(m: acc.emitted, key: key, value: 1)
        }
      } else {
        acc
      }
    }
  )
  swept.causes
}


// THE CROSS-ROUTE WALL, DERIVED FROM THE TWO ROSTERS AND NEVER TRANSCRIBED AS A THIRD.
//
// An identity evidenced by both routes would be admitted twice by two different relations, and the
// weaker admission would silently carry the stronger one's obligation. The union is DERIVED here
// rather than maintained as its own roster, because a transcribed union is a second authority that
// drifts from the two it summarizes. If an identity ever genuinely needs both routes it gets one
// explicit route-selection authority, not two independent evidences.
fn wet_cross_route_overlap_causes(
  local_identities: List<String>,
  transported_identities: List<String>
) -> List<WetEvidenceRefusal> {
  fold_list(
    xs: local_identities,
    empty: [],
    cons: fn(acc, id) {
      if contains(xs: transported_identities, item: id, eq: wet_string_eq) {
        list_append(left: acc, right: [WetCrossRouteIdentityOverlap { identity: id }])
      } else {
        acc
      }
    }
  )
}

// ONE BATCH PER REQUIREMENT, NEVER BOTH ROUTES CONCATENATED INTO ONE CALL. The two routes require
// different binding relations, so a merged call would have to WEAKEN the requirement to admit both
// -- widening instead of refusing, which is the absorbing-fallback arm DESIGN section 5 forbids.
// Callers validate once per requirement and aggregate the typed results afterward.
//
// AND A CONSEQUENCE FOR CONSUMERS: `WetEvidenceRefused` must NOT be read wholesale as "the receipt
// is invalid". Binding, identity, route, entry and function mismatches mean the EVIDENCE itself is
// invalid, and those are never waivable. `WetTerminalVerdictNotExpected` means the opposite -- the
// evidence is VALID and the semantic outcome is known, whether that is an unexpected failure, a
// now-passing enrolled red, completed-over-budget cost debt, or no verdict. A valid FAILING attempt
// must still be publishable, or latest-attempt silently degrades into latest-SUCCESS, which is the
// exact failure the freshness algebra exists to prevent.
//
// THE WHOLE VALIDATION, both directions plus the binding. Empty scheduled and empty terminals is the
// positive control: no rows in, no causes out, and the lane holds with nothing claimed -- which is
// why a route whose roster is empty proves nothing and must be walled elsewhere, not here.
fn wet_evidence_validate(
  scheduled: List<WetScheduledClaim>,
  declared: List<DeclFact>,
  terminals: List<WetTerminalRow>,
  requirement: WetEvidenceRequirement
) -> WetEvidenceValidation {
  let causes = list_append(
    left: wet_forward_causes(scheduled: scheduled, terminals: terminals, requirement: requirement),
    right: list_append(
      left: wet_reverse_causes(scheduled: scheduled, terminals: terminals),
      right: list_append(
        left: wet_scheduled_identity_duplicate_causes(scheduled: scheduled),
        right: wet_scheduled_function_declared_causes(scheduled: scheduled, declared: declared)
      )
    )
  )
  if length(xs: causes) == 0 {
    WetEvidenceAdmitted { binding: wet_binding_of_requirement(requirement: requirement), terminals: terminals }
  } else {
    WetEvidenceRefused { causes: causes }
  }
}

fn wet_evidence_admits(v: WetEvidenceValidation) -> Bool {
  match v {
    WetEvidenceAdmitted { binding: _, terminals: _ } => true
    WetEvidenceRefused { causes: _ } => false
  }
}
