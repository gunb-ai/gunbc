module v2.workflow.floor_terminal_ledger_test

import v2.std.logic { Bool }
import v2.workflow.floor2_prepared_subject { WitnessIdentity }
import v2.workflow.floor_terminal_ledger {
  ClaimExpectation,
  ClaimTerminalRow,
  ExpectedRed,
  ExpectedToHold,
  Failed,
  Interrupted,
  InterruptedBeforeVerdict,
  KnownRedHeld,
  KnownRedNowPassing,
  LedgerFinalized,
  LedgerPartial,
  LedgerReconciliation,
  EvidenceComplete,
  EvidenceFooterCountDisagrees,
  EvidenceReconciliationFailed,
  EvidenceUnfinalized,
  ObservationUnrepresentable,
  ObservedVerdict,
  Passed,
  RefusedBeforeVerdict,
  Returned,
  claim_disposition,
  ledger_is_complete,
  ledger_green_admission
}

fn ident(f: String) -> WitnessIdentity {
  WitnessIdentity { module_path: "test.claim.example", function: f }
}

fn row(f: String, expectation: ClaimExpectation, holds: Bool) -> ClaimTerminalRow {
  ClaimTerminalRow {
    identity: ident(f: f),
    ordinal: 0,
    expectation: expectation,
    terminal: Returned { observation: ObservedVerdict { holds: holds } }
  }
}

fn empty_reconciliation() -> LedgerReconciliation {
  LedgerReconciliation {
    planned_without_terminal: [],
    terminal_without_planned: [],
    terminal_duplicated: []
  }
}

// THE PROJECTION IS TOTAL OVER (expectation x observation), and each of the four cells is asserted
// to a DISTINCT disposition rather than to a Bool. A Boolean assertion here would pass for three
// different wrong mappings; naming the constructor each cell must produce is what makes the test
// able to fail for the right reason.
test fn the_four_verdict_cells_project_to_four_distinct_dispositions() -> Bool {
  claim_disposition(row: row(f: "a", expectation: ExpectedToHold, holds: 0 == 0)) == Passed
    && claim_disposition(row: row(f: "b", expectation: ExpectedToHold, holds: 0 == 1)) == Failed
    && claim_disposition(row: row(f: "c", expectation: ExpectedRed, holds: 0 == 1)) == KnownRedHeld
    && claim_disposition(row: row(f: "d", expectation: ExpectedRed, holds: 0 == 0)) == KnownRedNowPassing
}

// AN ATTEMPT THAT RETURNED WITHOUT A READABLE VERDICT IS NOT A FAILING WITNESS. Collapsing
// `ObservationUnrepresentable` into `Failed` is the fabricated plausible output -- it reports a
// witness that answered wrongly where the truth is a witness whose answer was never in a shape the
// floor could read, and the two have different remedies.
test fn an_unreadable_observation_is_refused_not_failed() -> Bool {
  claim_disposition(row: ClaimTerminalRow {
    identity: ident(f: "e"),
    ordinal: 0,
    expectation: ExpectedToHold,
    terminal: Returned { observation: ObservationUnrepresentable { reason: "not-a-process-exit" } }
  }) == RefusedBeforeVerdict
}

// THE LOAD-BEARING TEST: A DUPLICATE REPLACING AN OMISSION, WITH EVERY COUNT UNCHANGED.
//
// One planned identity never reached the ledger and another was written twice. Row count equals
// planned count. Every aggregate in the run summary is identical to a correct run. A count-based
// completeness check is GREEN over this, and the missing witness is reported as covered.
//
// This is the discriminating RED for the whole reconciliation: replace the identity join with
// `terminal_rows.length() == planned.length()` and this test goes green while the ledger is wrong.
test fn a_duplicate_replacing_an_omission_is_caught_though_no_count_moves() -> Bool {
  let swapped = LedgerReconciliation {
    planned_without_terminal: [ident(f: "lost")],
    terminal_without_planned: [],
    terminal_duplicated: [ident(f: "written_twice")]
  }
  !ledger_is_complete(r: swapped)
    && ledger_is_complete(r: empty_reconciliation())
    && ledger_green_admission(
         publication: LedgerFinalized { row_count: 2, digest: "d" },
         reconciliation: swapped,
         planned: [ident(f: "lost"), ident(f: "written_twice")]
       ) == EvidenceReconciliationFailed { reconciliation: swapped }
}

// A FAILED PUBLICATION IS NOT GREEN EVEN WHEN EVERY WITNESS PASSED. Otherwise the instrumentation
// is optional exactly when it fails, which is the failure arm that widens instead of refusing.
test fn a_partial_ledger_is_not_green_over_a_perfect_reconciliation() -> Bool {
  ledger_green_admission(
    publication: LedgerPartial { reason: "killed-before-finalize" },
    reconciliation: empty_reconciliation(),
    planned: [ident(f: "a")]
  ) == EvidenceUnfinalized { reason: "killed-before-finalize" }
}

// THE FOOTER COUNT IS CHECKED AGAINST THE PLANNED POPULATION, not against itself. A truncation
// that dropped rows and rewrote the footer to match would agree with itself; it cannot agree with
// the planned population the caller independently holds.
test fn a_footer_count_below_the_planned_population_is_not_green() -> Bool {
  ledger_green_admission(
    publication: LedgerFinalized { row_count: 1, digest: "d" },
    reconciliation: empty_reconciliation(),
    planned: [ident(f: "a"), ident(f: "b")]
  ) == EvidenceFooterCountDisagrees { footer_rows: 1, planned_rows: 2 }
    && ledger_green_admission(
         publication: LedgerFinalized { row_count: 2, digest: "d" },
         reconciliation: empty_reconciliation(),
         planned: [ident(f: "a"), ident(f: "b")]
       ) == EvidenceComplete
}
