module v2.test.workflow.branch_dispatch_rung8_eval

import v2.std.algebra { is_empty }
import v2.std.logic { Bool }
import v2.std.nat { Zero }
import v2.test.branch_dispatch.rung_8 { phase4_branch_dispatch_rung8_runtime_value_rows }
import v2.test.workflow.testclaim_corpus_runner {
  CorpusEvalReport,
  corpus_entries_from_node_runtime_value_runs,
  corpus_report_tally
}

fn run_branch_dispatch_rung8_eval() -> CorpusEvalReport {
  CorpusEvalReport {
    entries: corpus_entries_from_node_runtime_value_runs(
      runs: phase4_branch_dispatch_rung8_runtime_value_rows
    )
  }
}

fn branch_dispatch_rung8_gate(report: CorpusEvalReport) -> Bool {
  if is_empty(xs: report.entries) {
    false
  } else {
    branch_dispatch_rung8_zero_deferred(report: report)
  }
}

fn branch_dispatch_rung8_zero_deferred(report: CorpusEvalReport) -> Bool {
  corpus_report_tally(r: report).deferred == Zero
}

data witness_branch_dispatch_rung8_gate_closed: Bool = branch_dispatch_rung8_gate(report: run_branch_dispatch_rung8_eval())
