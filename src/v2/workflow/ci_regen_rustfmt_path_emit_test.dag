module v2.workflow.ci_regen_rustfmt_path_emit_test

import v2.workflow.ci_regen_rustfmt_path_emit {
  ci_regen_ensure_rustfmt_path_script,
  ci_regen_ensure_rustfmt_path_shell_emit_scaffold,
}
import std.disposition { Scaffold }

data ci_regen_ensure_rustfmt_path_golden: String = concat(
  concat("# 🟡 dissolve-on: ci_regen_ensure_rustfmt_path_script — foreign-executor PATH ensure for regen_stage0 on hosts with a cargo shim and no CARGO_HOME/bin (receipt CI #7290 srv3-03); control flow is If/Predicate/Exit/Let via orch bash-emit; leaf test -x / command -v / export PATH / dirname strings remain until FileExists + session-EnvExport (PR2b) or the regen job shares isolate+pin by construction; DISSOLVES WHEN rustfmt resolution is a typed toolchain probe on host_effect_apply rather than emitted bash (#5828 / ROADMAP 6-shell-slice0)\n"),
  concat(
    concat("# Prepend a locatable rustfmt dir onto PATH before regen_stage0's standalone rustfmt spawn (hosts that expose a cargo shim without CARGO_HOME/bin — receipt CI #7290 srv3-03). Probe order: CARGO_HOME/bin, /opt/cargo/bin, HOME/.cargo/bin, rustup which; refuse if still absent.\n"),
    concat(
      concat("if [ -n \"$CARGO_HOME\" ] && [ -x \"$CARGO_HOME/bin/rustfmt\" ]; then export PATH=\"$CARGO_HOME/bin:$PATH\"; fi\n"),
      concat(
        concat("if ! command -v rustfmt >/dev/null 2>&1 && [ -x /opt/cargo/bin/rustfmt ]; then export PATH=\"/opt/cargo/bin:$PATH\"; fi\n"),
        concat(
          concat("if ! command -v rustfmt >/dev/null 2>&1 && [ -x \"$HOME/.cargo/bin/rustfmt\" ]; then export PATH=\"$HOME/.cargo/bin:$PATH\"; fi\n"),
          concat(
            concat("if ! command -v rustfmt >/dev/null 2>&1; then\n"),
            concat(
              concat("RF=$(/opt/cargo/bin/rustup which rustfmt) 2>/dev/null || true\n"),
              concat(
                concat("if [ -n \"$RF\" ] && [ -x \"$RF\" ]; then\n"),
                concat(
                  concat("RF_DIR=\"$(dirname \"$RF\")\"\n"),
                  concat(
                    concat("export PATH=\"$RF_DIR:$PATH\"\n"),
                    concat(
                      concat("fi\n"),
                      concat(
                        concat("fi\n"),
                        concat(
                          concat("if ! command -v rustfmt >/dev/null 2>&1; then\n"),
                          concat(
                            concat("echo \"::error::rustfmt not on PATH for regen_stage0 standalone spawn (hosts with a cargo shim and no CARGO_HOME/bin — receipt CI #7290 srv3-03)\"\n"),
                            concat("exit 1\n", "fi")
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

test fn ci_regen_ensure_rustfmt_path_emit_matches_golden_holds() -> Bool {
  ci_regen_ensure_rustfmt_path_script() == ci_regen_ensure_rustfmt_path_golden
}

test fn ci_regen_ensure_rustfmt_path_shell_emit_is_scaffold_holds() -> Bool {
  match ci_regen_ensure_rustfmt_path_shell_emit_scaffold {
    Scaffold { dissolves_to: _, bind: _ } => true
    _ => false
  }
}

test fn ci_regen_ensure_rustfmt_path_emit_carries_dissolve_marker_holds() -> Bool {
  string_contains(s: ci_regen_ensure_rustfmt_path_script(), pattern: "🟡 dissolve-on: ci_regen_ensure_rustfmt_path_script")
}

test fn ci_regen_ensure_rustfmt_path_emit_uses_structural_if_holds() -> Bool {
  string_contains(s: ci_regen_ensure_rustfmt_path_script(), pattern: "if [ -n \"$CARGO_HOME\" ] && [ -x \"$CARGO_HOME/bin/rustfmt\" ]; then")
    && string_contains(s: ci_regen_ensure_rustfmt_path_script(), pattern: "exit 1")
}

test fn ci_regen_ensure_rustfmt_path_emit_red_when_control_flow_is_opaque_string_holds() -> Bool {
  !string_contains(
    s: "if [ -n \"$CARGO_HOME\" ] && [ -x \"$CARGO_HOME/bin/rustfmt\" ]; then export PATH=\"$CARGO_HOME/bin:$PATH\"; elif [ -x /opt/cargo/bin/rustfmt ]; then export PATH=\"/opt/cargo/bin:$PATH\"; fi",
    pattern: "🟡 dissolve-on:"
  )
}
