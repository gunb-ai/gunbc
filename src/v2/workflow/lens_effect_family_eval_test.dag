// Status: discovered fail-closed family eval for the effect lens (DESIGN.md §6 inert-lens hygiene:
// every lens is a discovered fail-closed witness or deleted). Folds the lens_effect witness — the
// structural EffectDependsOn classification AND its run_test_claim runtime verdict — fail-closed:
// the gate is `true` only when the lens classifies correctly and its claim run Passes.

module v2.test.workflow.lens_effect_family_eval

import v2.std.logic { Bool }
import v2.test.lens_effect.effect_depends_on {
  effect_depends_on_claim_passes
}

// Fail-closed: the effect lens classifies the EffectDependsOn dependency correctly — its witness
// returns Violates with the expected EffectFact. A broken effect lens (wrong classification, or no
// Violates) makes effect_depends_on_claim_passes false => RED.
fn lens_effect_family_gate() -> Bool {
  effect_depends_on_claim_passes
}

test data witness_lens_effect_family_gate_closed: Bool = lens_effect_family_gate()
