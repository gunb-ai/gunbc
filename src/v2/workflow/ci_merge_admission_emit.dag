module v2.workflow.ci_merge_admission_emit

import gunbc.merge_admission_produce {
  ci_floor_disposition_marker_init_shell_emit_dissolution_trigger,
  ci_floor_disposition_marker_init_note,
  merge_admission_floor_disposition_floor_running,
  ci_floor_disposition_marker_path,
  ci_repo_root_shell,
  gunbc_run_bin_shell,
  merge_admission_v1_tool_source_flags,
}
import v2.workflow.orchestration_bash_emit_support {
  orch_bash_comment_line,
  orch_bash_do,
  orch_bash_emit_pipeline
}
import v2.std.orchestration {
  Do,
  EnvSet,
  ExitStatus,
  FailFast,
  Pipeline,
  PipelineStep,
  Run,
  ToFile
}
import v2.std.collection { Absent, Present }

data ci_merge_admission_emit_authority_note: String = "Foreign-executor shell emission for gunbc.merge_admission_produce script surfaces (bucket D). Intent stays out of dag/gunbc/merge_admission_produce; bash medium binding lives here per shell→intent routing. PR2a carriers: ToFile (stamp), Comment (comment lines), ExitStatus (STAMP_EXIT). PR2b: FileExists + Exit + IntNe for remaining concat surfaces."

data ci_merge_admission_emit_refused_poison: String = "__GUNBC_ORCH_EMIT_REFUSED__ merge-admission run-step emission was rejected by v2.compiler.emit_orchestration; this marker is not valid workflow shell, so the committed ci.yml drift gate goes red rather than a hand-spelled fallback masking the refusal (DESIGN 5: refuse, never widen)\n"

data ci_floor_disposition_marker_mkdir_command: String = "mkdir -p target"

data ci_floor_disposition_stamp_echo_command: String = concat("echo ", merge_admission_floor_disposition_floor_running)

fn ci_floor_disposition_marker_stamp_step() -> PipelineStep {
  Do {
    run: Run {
      command: ci_floor_disposition_stamp_echo_command,
      env: [],
      redirect: Present { value: ToFile { path: ci_floor_disposition_marker_path } },
      capture: Absent
    }
  }
}

fn ci_floor_disposition_marker_init_intent() -> Pipeline {
  Pipeline {
    steps: [
      orch_bash_comment_line(text: ci_floor_disposition_marker_init_shell_emit_dissolution_trigger),
      orch_bash_comment_line(text: ci_floor_disposition_marker_init_note),
      orch_bash_do(command: ci_floor_disposition_marker_mkdir_command),
      ci_floor_disposition_marker_stamp_step()
    ],
    on_failure: FailFast
  }
}

fn ci_floor_disposition_marker_init_script() -> String {
  orch_bash_emit_pipeline(
    p: ci_floor_disposition_marker_init_intent(),
    refused_poison: ci_merge_admission_emit_refused_poison
  )
}

data ci_floor_stamp_ambient_exit_command: String = "FLOOR_EXIT=$?"

data ci_floor_stamp_root_command: String = concat("ROOT=", ci_repo_root_shell())

data ci_floor_stamp_gunbc_command: String = concat(
  concat(gunbc_run_bin_shell(), merge_admission_v1_tool_source_flags()),
  " --entry dag/tools/merge_admission_stamp.dag --function main"
)

data ci_floor_stamp_propagate_floor_exit_command: String = "if [ \"$FLOOR_EXIT\" -ne 0 ]; then exit \"$FLOOR_EXIT\"; fi"

data ci_floor_stamp_exit_stamp_command: String = "exit \"$STAMP_EXIT\""

data ci_floor_stamp_pr2b_residue_note: String = "PR2a leaves the IntNe/Exit concat lines as constant opaque Run.command (decision rule: carriers for those land in PR2b with FileExists). ExitStatus is live on the stamp invoke (STAMP_EXIT). FLOOR_EXIT=$? is ambient prior-command capture — constant opaque, not CaptureSpec-on-Run."

fn ci_floor_stamp_merge_admission_intent() -> Pipeline {
  let _note = ci_floor_stamp_pr2b_residue_note
  Pipeline {
    steps: [
      orch_bash_do(command: ci_floor_stamp_ambient_exit_command),
      orch_bash_do(command: ci_floor_stamp_root_command),
      Do {
        run: Run {
          command: ci_floor_stamp_gunbc_command,
          env: [EnvSet { name: "CI_FLOOR_EXIT", value: "$FLOOR_EXIT" }],
          redirect: Absent,
          capture: Present { value: ExitStatus { binder: "STAMP_EXIT" } }
        }
      },
      orch_bash_do(command: ci_floor_stamp_propagate_floor_exit_command),
      orch_bash_do(command: ci_floor_stamp_exit_stamp_command)
    ],
    on_failure: FailFast
  }
}

fn ci_floor_stamp_merge_admission_script() -> String {
  orch_bash_emit_pipeline(
    p: ci_floor_stamp_merge_admission_intent(),
    refused_poison: ci_merge_admission_emit_refused_poison
  )
}
