module v2.workflow.ci_merge_admission_emit

import gunbc.merge_admission_produce {
  ci_repo_root_shell,
  merge_admission_stamp_command,
}
import v2.workflow.orchestration_bash_emit_support {
  orch_bash_do,
  orch_bash_emit_pipeline
}
import v2.std.orchestration {
  Do,
  EnvSet,
  Exit,
  ExitStatus,
  FailFast,
  If,
  IntNe,
  Pipeline,
  PipelineStep,
  Run
}
import v2.std.collection { Absent, Present }

data ci_merge_admission_emit_authority_note: String = "Foreign-executor shell emission for gunbc.merge_admission_produce script surfaces (bucket D). Intent stays out of dag/gunbc/merge_admission_produce; bash medium binding lives here per shell→intent routing. PR2a carriers: ExitStatus (STAMP_EXIT), IntNe + Exit (floor_stamp propagate/final). The former ToFile/Comment floor-disposition marker consumer retired atomically with its unreachable documentation-only readers; remaining residue is the ambient prior-exit command plus the floor-tail stamp composer. The GATE composer left this module in Wave B (#7363): it now lives in v2.workflow.ci_merge_admission_gate_emit on the typed EffectPlan<BoundOperationInvocation> carrier, which shares no arm vocabulary with this module's Pipeline/Run carrier — the two coproducts both spell an arm `Do`, so one module cannot bind both, and the gate's migrated form gets its own module rather than a renamed alias of either. What remains here is the floor-tail stamp, explicitly out of Wave B's scope."

data ci_merge_admission_emit_refused_poison: String = "__GUNBC_ORCH_EMIT_REFUSED__ merge-admission run-step emission was rejected by v2.compiler.emit_orchestration; this marker is not valid workflow shell, so the committed ci.yml drift gate goes red rather than a hand-spelled fallback masking the refusal (DESIGN 5: refuse, never widen)\n"

data ci_floor_stamp_ambient_exit_command: String = "FLOOR_EXIT=$?"

data ci_floor_stamp_root_command: String = concat("ROOT=", ci_repo_root_shell())

data ci_floor_stamp_pr2b_residue_note: String = "DECLARED SCAFFOLD remaining after PR2a IntNe/Exit expansion: ambient FLOOR_EXIT=$? stays constant opaque Run.command (prior-command capture outside this Pipeline — not CaptureSpec-on-Run). The unreachable documentation-only disposition reader family retired instead of gaining FileExists/typed-read models. 🟡 dissolve-on: typed ambient-prior-exit carrier and emission of the two independent merge-admission composers."

fn ci_floor_stamp_propagate_floor_exit_step() -> PipelineStep {
  If {
    cond: IntNe { lhs: "\"$FLOOR_EXIT\"", rhs: "0" },
    then_: Pipeline {
      steps: [Exit { status: "\"$FLOOR_EXIT\"" }],
      on_failure: FailFast
    },
    else_: Absent
  }
}

fn ci_floor_stamp_merge_admission_intent() -> Pipeline {
  let _note = ci_floor_stamp_pr2b_residue_note
  Pipeline {
    steps: [
      orch_bash_do(command: ci_floor_stamp_ambient_exit_command),
      orch_bash_do(command: ci_floor_stamp_root_command),
      Do {
        run: Run {
          command: merge_admission_stamp_command(),
          env: [EnvSet { name: "CI_FLOOR_EXIT", value: "$FLOOR_EXIT" }],
          redirect: Absent,
          capture: Present { value: ExitStatus { binder: "STAMP_EXIT" } }
        }
      },
      ci_floor_stamp_propagate_floor_exit_step(),
      Exit { status: "\"$STAMP_EXIT\"" }
    ],
    on_failure: FailFast
  }
}

fn ci_floor_stamp_merge_admission_script() -> String {
  orch_bash_emit_pipeline(
    p: ci_floor_stamp_merge_admission_intent(),
    refused_poison: ci_merge_admission_emit_refused_poison
  )
}
