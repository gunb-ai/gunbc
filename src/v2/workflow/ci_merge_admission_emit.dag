module v2.workflow.ci_merge_admission_emit

import v2.compiler.emit_orchestration { orch_emit_pipeline }
import v2.extdeps.languages.bash_orchestration_emit { bash_orchestration_emit_medium }
import gunbc.merge_admission_produce {
  ci_floor_disposition_marker_init_shell_emit_dissolution_trigger,
  ci_floor_disposition_marker_init_note,
  merge_admission_floor_disposition_floor_running,
  ci_floor_disposition_marker_path,
}
import v2.std.orchestration {
  Do,
  FailFast,
  Pipeline,
  PipelineStep,
  Run
}
import v2.std.diagnostic { Accepted, Rejected, None, Some }

data ci_merge_admission_emit_authority_note: String = "Foreign-executor shell emission for gunbc.merge_admission_produce script surfaces (bucket D). Intent stays out of dag/gunbc/merge_admission_produce; bash medium binding lives here per shell→intent routing."

data ci_merge_admission_emit_refused_poison: String = "__GUNBC_ORCH_EMIT_REFUSED__ merge-admission run-step emission was rejected by v2.compiler.emit_orchestration; this marker is not valid workflow shell, so the committed ci.yml drift gate goes red rather than a hand-spelled fallback masking the refusal (DESIGN 5: refuse, never widen)\n"

data ci_floor_disposition_marker_mkdir_command: String = "mkdir -p target"

fn ci_merge_admission_floor_disposition_stamp_command() -> String {
  concat(
    concat("echo ", merge_admission_floor_disposition_floor_running),
    concat(" > ", ci_floor_disposition_marker_path)
  )
}

fn ci_merge_admission_run(command: String) -> Run {
  Run {
    command: command,
    env: [],
    redirect: Absent,
    capture: Absent
  }
}

fn ci_merge_admission_do(command: String) -> PipelineStep {
  Do { run: ci_merge_admission_run(command: command) }
}

fn ci_merge_admission_comment_line(text: String) -> PipelineStep {
  ci_merge_admission_do(command: concat("# ", text))
}

fn ci_merge_admission_emit_pipeline(p: Pipeline) -> String {
  match orch_emit_pipeline(p: p, medium: bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: d } =>
      match d {
        None => source.carried
        Some { diagnostics: _ } => ci_merge_admission_emit_refused_poison
      }
    Rejected { diagnostics: _ } => ci_merge_admission_emit_refused_poison
  }
}

fn ci_floor_disposition_marker_init_intent() -> Pipeline {
  Pipeline {
    steps: [
      ci_merge_admission_comment_line(text: ci_floor_disposition_marker_init_shell_emit_dissolution_trigger),
      ci_merge_admission_comment_line(text: ci_floor_disposition_marker_init_note),
      ci_merge_admission_do(command: ci_floor_disposition_marker_mkdir_command),
      ci_merge_admission_do(command: ci_merge_admission_floor_disposition_stamp_command())
    ],
    on_failure: FailFast
  }
}

fn ci_floor_disposition_marker_init_script() -> String {
  ci_merge_admission_emit_pipeline(p: ci_floor_disposition_marker_init_intent())
}
