module v2.workflow.floor2_prepared_subject

import v2.std.algebra { fold_list, length, list_snoc_item }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.text { String }

// FLOOR2 — the floor as ONE prepared subject and N claims against it, modeled
// here rather than in the runner. The seed retains exactly two host primitives:
// build an evaluable context from a source set, and evaluate one qualified name
// in it. Which witnesses run, what identity each has, what refuses, and what the
// run's verdict is are facts of this module.
//
// WHY THE MODEL EXISTS AT ALL, in one measured sentence: the runner spent 1927.6s
// preparing 1137 entry-private compiler worlds to enable 148.1s of evaluation
// (run 31745991795, resolve_ms grouped once per entry against summed
// eval_wall_ms). One preparation serving every claim is the same work with the
// entry removed from the key.

type PreparedSubjectSpec {
  source_roots: List<String>
  exclusions: List<String>
}

// The exclusion set is PART OF THE SUBJECT, so it is declared beside the roots and
// never borrowed from a roster that answers a different question. The probe exclusion
// roster is pattern rows UNION a derived strict-resolve failure closure, and its
// pattern half exists to keep witnesses OUT of a probe over production code. Borrowed
// here it prepared 1611 of 3621 modules and 9057 of 9317 witnesses could not find
// their own code — a subject that resolves cleanly while being the wrong subject.
//
// THERE IS NO GROUND MEANING "IT FAILED TO RESOLVE". Two arms were deleted rather than
// kept for completeness: ExcludedDerivedFailureClosure readmitted the self-growing
// closure under a name, and a generic ExcludedCannotStrictResolve let an accidental
// breakage wear the same badge as a deliberately invalid fixture — which is exactly
// the move that hid ~150 undeclared imports for however long. The remaining two grounds
// say what the case IS, not what happened when it was tried:
//
// A deliberately-invalid fixture carries the WITNESS that consumes its invalidity. If
// nothing reads the refusal, the file is not a fixture, it is a broken module, and the
// field is what makes that distinction checkable instead of asserted. An out-of-roots
// module carries the root that WOULD contain it, so the exclusion names its own
// dissolution: add that root and the row is unnecessary.
type SubjectExclusionGround
  = ExcludedDeliberatelyInvalidFixture { property_witness: Symbol }
  | ExcludedOutsideDeclaredSourceRoots { containing_root: Symbol }

type WitnessSite {
  entry: String
  function: String
}

// WITNESS IDENTITY IS `module.function`, NEVER the bare function name.
//
// The host resolves an invocation through a name-keyed map. Per-entry that is
// safe: one context holds one closure, so one name means one node. Under a
// SHARED prepared subject it is not — two entries declaring the same test fn name
// collapse to a single map entry, so one runs twice and the other never runs, AT
// AN UNCHANGED ROW COUNT. The receipt is then indistinguishable from a healthy
// run, which is silent wrongness rather than a degradation.
//
// Measured on the live roster: 30 names covering 63 rows. Predicted first from
// the CI receipt at the same 30/63 and reproduced by execution.
//
// Qualification is CONSTRUCTION, not validation: the ambiguous call has no
// representation here, so no consumer can express it. The refusal arms below are
// only for the residue where identity genuinely cannot be derived.
type WitnessIdentity {
  module_path: String
  function: String
}

type WitnessIdentityRefusal
  = ModulePathNotUnique { site: WitnessSite }
  | QualifiedIdentityClaimedByManySites { qualified: String, sites: List<WitnessSite> }

type ResolvedWitness
  = WitnessIdentified { identity: WitnessIdentity, site: WitnessSite }
  | WitnessIdentityRefused { refusal: WitnessIdentityRefusal }

type Floor2Plan {
  subject: PreparedSubjectSpec
  claims: List<ResolvedWitness>
}

// A plan whose claim list carries ANY refusal is not a runnable plan. This is the
// fail-closed arm: the run does not proceed with the identifiable subset and
// report on the rest, because a partial roster reported as a roster is the same
// silent narrowing the identity rule exists to prevent.
type Floor2PlanAdmission
  = Floor2PlanRunnable { plan: Floor2Plan }
  | Floor2PlanRefused { refusals: List<WitnessIdentityRefusal> }

fn witness_identity_qualified_name(identity: WitnessIdentity) -> String {
  concat(concat(identity.module_path, "."), identity.function)
}

fn resolved_witness_refusals(
  acc: List<WitnessIdentityRefusal>,
  resolved: ResolvedWitness
) -> List<WitnessIdentityRefusal> {
  match resolved {
    WitnessIdentified { identity: _, site: _ } => acc
    WitnessIdentityRefused { refusal: r } => list_snoc_item(xs: acc, item: r)
  }
}

// The fold's empty case is DECLARED rather than written as a bare literal: an
// empty list literal carries no element type, so the accumulator's identity would
// come from inference at the call site rather than from the type this fold is
// about.
data floor2_no_refusals: List<WitnessIdentityRefusal> = []

fn floor2_plan_refusals(plan: Floor2Plan) -> List<WitnessIdentityRefusal> {
  fold_list(xs: plan.claims, empty: floor2_no_refusals, cons: resolved_witness_refusals)
}

// EXACTLY TWO HOST PRIMITIVES REMAIN, and naming them is what keeps this model honest
// rather than aspirational: build an evaluable context from a declared source set, and
// evaluate one qualified name in that context. Both are interpreter capability, not
// floor policy, and neither can be modeled here until self-hosting closes — a .dag
// function cannot construct the interpreter that runs it. Everything else the runner
// used to decide — roster grouping, witness identity, refusal arms, admission, and the
// verdict fold — is a fact of this module, so changing floor policy is a row edit rather
// than a Rust edit.
//
// CUTOVER STANDING, stated at the scope it actually has. The required floor's DISCOVERED
// witness corpus now executes this way: cli_run's run_discovery_corpus_with_options_inner
// routes to run_discovery_rows_against_prepared_subject when selection is Off and the
// roster was walked from scan_dirs, which is every ordinary merge-critical witness batch
// (ci_floor_plan corpus_runnable_for). That branch returns BEFORE the entry-major
// machinery, so the corpus index build, the per-roster pre-resolve closure walk, the
// frontier attribution and the width governor are not merely unused on it -- they are not
// reached. There is no width to govern when there is one subject, so the path is width-one
// by construction rather than by policy.
//
// WHAT IS NOT CLAIMED, because two populations still run entry-major and saying otherwise
// would be rung inflation. Selection-bearing lanes (the falsifier cadence, the expect-red
// quarantine probes, the v1 scoped batch) need per-entry frontier evaluation, which is
// exactly what an entry-private context supplies; retiring that is the follow-on that
// removes node_frontier_selection from Runnable, not this change. And the explicit-entry
// lanes (the Wet execution corpus, the bin-witness corpus) name around ten entries each,
// where one whole-tree preparation serving ten is the same cost-shape defect pointing the
// other way. This note does not say the floor is one subject -- it says the batch that cost
// 1927.6s of preparation is.
//
// CORRECTED (review 52333): an earlier revision ended "so run_discovery_rows is NOT deleted",
// and by then it was. The seed's dispatcher now always routes to
// run_discovery_rows_against_prepared_subject and the entry-major function is gone, so the
// model asserted a seed it no longer describes. What survives of the point is the residue
// named on the next line: that path prepares ONE WHOLE-TREE context and evaluates every
// witness in it, rather than projecting a scope per claim the way run_required_floor does --
// so the bare-name collision documented at cli_run.rs claim_scope_for is still reachable
// there. Dissolve-on: the discovery path takes its frames from claim_scope_for too.

fn admit_floor2_plan(plan: Floor2Plan) -> Floor2PlanAdmission {
  let refusals = floor2_plan_refusals(plan: plan)
  if length(xs: refusals) == 0 {
    Floor2PlanRunnable { plan: plan }
  } else {
    Floor2PlanRefused { refusals: refusals }
  }
}

// Zero per-entry graph resolves holds two ways, and only one of them is a check.
// CONSTRUCTION: the prepared subject is named once by PreparedSubjectSpec and the claim
// carries only an identity, so nothing a consumer holds can name a source root, an
// index, a resolver, or an entry path — an entry-private compiler world is
// unrepresentable rather than merely counted. COUNTER: the host still reports its
// resolve count, which catches a regression in the seed below this model. Dissolve-on:
// the seed's context construction becomes a modeled realization, at which point the
// counter has no independent subject and deletes.
//
// And per-entry graph construction has no representation here AT ALL: no field,
// arm, or function in this module names an entry-private resolve, so a consumer
// of this plan cannot request one.
//
// THE PREPARATION COUNT IS A PROPERTY OF THE PLAN, not an observation of the run.
// One plan names one subject, so a plan cannot express two preparations and a
// consumer cannot accidentally perform a second one. "prepared_subject_count == 1"
// therefore holds by the shape of Floor2Plan; the runner's counter is a
// regression control over the host, not the guarantee.
fn floor2_prepared_subject_count(plan: Floor2Plan) -> Int {
  1
}

// WHICH EXECUTION KEY A BATCH GETS IS FLOOR POLICY, so it is a row here rather than a
// condition in the seed. The note above claims changing floor policy is a row edit and not
// a Rust edit; landing the routing rule only in cli_run would have made that sentence false
// in the same change that wrote it.
//
// ONE INPUT DECIDES, and it used to be two. An earlier revision of this rule also read
// roster provenance -- walked from scan_dirs versus named by the batch -- because a batch
// naming ten entries would have paid a whole-tree preparation to serve them, which is the
// entry-major cost-shape defect pointing the other way. That ground was real and it is now
// dissolved rather than merely unused: ExecutionMode is not an input to resolution, so the
// seed memoizes the resolved graph by its source digest and a second consumer over the same
// tree pays a file walk and builds its own context. The distinction bought nothing once the
// cost it named was gone, so FloorRosterProvenance and the
// WholeTreePreparationNotAmortized ground are DELETED here rather than left standing beside
// the climb that obsoleted them.
type FloorSelectionPosture
  = NoSelectionMachinery
  | SelectionRequiresPerEntryFrontier

// The surviving entry-major arm names its own dissolution in its constructor: a
// selection-bearing lane evaluates a per-entry frontier, and an entry-private context is
// what supplies one. It retires when node_frontier_selection leaves Runnable, at which point
// this coproduct collapses to a single inhabitant and deletes with it.
type FloorExecutionKey
  = OnePreparedSubjectKey { subject: PreparedSubjectSpec }
  | EntryMajorUntilFrontierRetires

fn floor_execution_key(
  posture: FloorSelectionPosture,
  subject: PreparedSubjectSpec
) -> FloorExecutionKey {
  match posture {
    SelectionRequiresPerEntryFrontier => EntryMajorUntilFrontierRetires
    NoSelectionMachinery => OnePreparedSubjectKey { subject: subject }
  }
}

// A DECLARED RUNG CHANGE, and its DIRECTION WAS REVERSED BY MEASUREMENT (2026-08-15).
//
// WHAT THIS ROW SAID FIRST, and why it is retracted rather than edited quietly: it declared a
// REGRESSION on the ground that "under one prepared subject every module of the tree is present
// at once, which is the most permissive name pool that can exist", so an undeclared cross-module
// reference would bind and the floor could no longer see the ambient-pool class. That described
// a FLAT whole-subject frame. The seed no longer evaluates in one: `claim_scope_for` projects
// each claim's own module plus the compiler's transitive import closure (`func_env.parents`),
// and a fresh frame is built per claim over exactly that population. The note was written
// against an earlier shape of this change and kept asserting it afterwards -- the §3 stale-claim
// class, in a row whose whole subject is rung honesty, and a review has already cited it as
// discharging §4b(3) that it no longer discharges.
//
// WHAT THE FIRST COMPLETE RUN MEASURED. 9,649 claims, 1,973 failures, and 1,901 of those are
// `no such function: <name>` -- 792 distinct names across 431 witness modules. The scoped frame
// is STRICTER than the entry-major pool, not looser: DESIGN's Class B records that a module's
// bare cross-module references bound exactly when some unrelated import elsewhere in the
// assembled closure had already dragged the target into the pool, and a per-claim closure has
// no unrelated entries in it. So the ambient-pool class is not newly invisible here; it is
// newly LOUD, at a scale nothing had counted before.
//
// SO THE ROW IS NOT A REGRESSION AND MUST NOT BE READ AS ONE. Binding got stricter and
// deterministic -- it no longer depends on which unrelated entries happen to share a closure,
// so a module binds the same way on every run. What that strictness EXPOSES is the open
// question, and it is not a rung this change lowers: 431 modules use symbols they never
// declare. Whether each is an under-declared module or a legitimately bare reference the
// resolver bound from provenance the closure does not carry is exactly what the namespace-only
// lane decides, and DESIGN already treats this class as blocking further import-stripping until
// a closure-independent binding fix lands.
//
// POPULATION: 792 distinct unresolved names across 431 modules, measured, not estimated.
//
// TRIGGER: the floor is green on this path only when each claim's scope is derived from what
// the resolver ACTUALLY bound for that module, or the 431 modules declare what they use. The
// first is the construction answer -- the compiler resolves every reference already, so
// recording what it bound turns a coincidence into a fact -- and the second is only correct
// once the first says those references were genuinely undeclared.

type FloorBindingStrictnessRegression {
  previous: Symbol
  current: Symbol
  population: Symbol
  restoration_trigger: Symbol
}

data floor2_binding_strictness_regression: FloorBindingStrictnessRegression = FloorBindingStrictnessRegression {
    previous: ^narrow_accidental_pool_binding,
    current: ^per_claim_declared_import_closure_binding,
    population: ^seven_hundred_ninety_two_names_across_four_hundred_thirty_one_modules,
    restoration_trigger: ^scope_derived_from_resolver_binding_provenance
  }
