module v2.workflow.cli


type GunbcCliRouteSemantics
  = SourceAuthorityRoute
  | RuntimeTestClaimRoute
  | BoundaryDebugRoute

type GunbcTestgenRoute {
  generator: v2.std.artifact.GeneratorId
}

type GunbcTestRoute {
  selection_fn: v2.std.node.Symbol
}

fn gunbc_testgen_route_name_of(_route: GunbcTestgenRoute) -> v2.std.node.Symbol {
  ^gunbc_testgen_route_name
}

fn gunbc_test_route_name_of(_route: GunbcTestRoute) -> v2.std.node.Symbol {
  ^gunbc_test_route_name
}

fn gunbc_test_corpus_harness_route_name_of(_route: GunbcTestCorpusHarnessRoute) -> v2.std.node.Symbol {
  ^gunbc_test_corpus_harness_route_name
}

type GunbcTestCorpusHarnessRoute {
  harness: v2.workflow.bootstrap.BootstrapEvaluatorCorpusHarnessEntry
}

fn gunbc_testgen_route_semantics(_route: GunbcTestgenRoute) -> GunbcCliRouteSemantics {
  RuntimeTestClaimRoute
}

fn gunbc_test_route_semantics(_route: GunbcTestRoute) -> GunbcCliRouteSemantics {
  RuntimeTestClaimRoute
}

fn gunbc_test_corpus_harness_route_semantics(_route: GunbcTestCorpusHarnessRoute) -> GunbcCliRouteSemantics {
  RuntimeTestClaimRoute
}

fn gunbc_testgen_route_provenance(
  route: GunbcTestgenRoute,
  artifact: v2.std.artifact.GeneratedArtifact
) -> v2.std.artifact.GeneratorProvenance {
  v2.std.artifact.GeneratorProvenance {
    generator_id: route.generator,
    artifact: artifact
  }
}

data gunbc_test_manual_corpus_harness_route: GunbcTestCorpusHarnessRoute = GunbcTestCorpusHarnessRoute {
  harness: bootstrap_manual_corpus_harness
}

fn gunbc_test_manual_corpus_harness_route_well_formed() -> Bool {
  (gunbc_test_manual_corpus_harness_route.harness == bootstrap_manual_corpus_harness)
    && (gunbc_test_manual_corpus_harness_route.harness.entry_fn == ^run_manual_testclaim_corpus_eval)
    && witness_bootstrap_evaluator_corpus_harness_well_formed
}
