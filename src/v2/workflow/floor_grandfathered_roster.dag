fn floor_grandfathered_roster() -> List<String> {
  list_flat_map(xs: floor_grandfathered_chunks(), f: fn(c) { c })
}

// MEMBERSHIP AT IDENTITY GRAIN. Whole-identity equality, never a prefix and never a count: a prefix
// test would grandfather every future witness in an already-enrolled module, which is the addition
// this contract forbids wearing a different shape.
//
// THREE SPELLINGS WERE MEASURED. The one standing here is a STATED INTERIM, not the design.
//
// All three answer the same question over the same 3,795 rows; the numbers are from this
// repository's own `[witness]` line on the authoring host.
//
//   (1) `any(xs: floor_grandfathered_roster(), ...)` -- flattens first, so every membership
//       question MATERIALISES A SECOND COPY of all 3,795 rows before comparing the first one.
//       92,490 eval steps, ~148ms. Above this file's own new-witness ceiling: the roster's evidence
//       would have been refused by the tier the roster exists to serve.
//
//   (2) MAP-BACKED, via `v2.std.collection` `empty_map` / `map_insert` / `map_lookup`. 39,940 eval
//       steps -- the FEWEST of the three, and symmetric between hit and miss -- AND 36,000ms of CPU.
//       `map_insert` returns a new map, so folding n rows in is O(n^2) host work, and NONE OF IT IS
//       AN EVAL STEP because it happens inside a primitive. It would pass the eval-step ceiling
//       comfortably and breach the 8,000ms wall deadline.
//
//   (3) STANDING: a short-circuiting descent over the chunks that never flattens them. 8,066 eval
//       steps and 19ms on a hit, 43,583 and 76ms on a miss -- the cheapest form on BOTH clocks, and
//       the only one under the new-witness ceiling on both.
//
// SPELLING (2) IS A REALIZATION DEFECT AND IS FILED AS ONE, NOT ROUTED AROUND HERE. The map-backed
// join is the correct shape for an identity join; what is wrong is the map's realization, which has
// no bulk constructor, so the idiom is expressed as an insert fold. The repair is a bulk
// construct -- `map_from_list` / `map_from_pairs` as one primitive call, or a persistent structure
// with structural sharing so insert is O(log n) -- and it belongs to the primitive's lane
// (clever-fox-89, gunbc#11121), not to every author who writes a join. The class is at
// `gunbc.recurring_failure_mode` `nested_membership_scan_where_a_map_primitive_exists`.
//
// SO THIS IS AN INTERIM WITH A NAMED END (fierce-lark-661, 2026-09-13): until the bulk constructor
// lands, the roster build uses whichever measured form is cheapest on both clocks, with the
// measurement cited. When it lands, this descent is replaced by the map-backed join and the numbers
// above are the baseline it must beat. An earlier revision of this comment presented the descent as
// the considered design and offered authors an n-dependent rule for choosing between the two; both
// were refused, because pricing a per-site exception around a cost-shape defect is the move DESIGN
// section 6 forbids by name.
//
// MEMBERSHIP IS AT IDENTITY GRAIN in every spelling: whole-identity equality, never a prefix and
// never a count. A prefix test would grandfather every future witness in an already-enrolled
// module, which is the addition this contract forbids wearing a different shape.
fn floor_grandfathered_holds(name: String) -> Bool {
  grandfathered_in_chunks(name: name, chunks: floor_grandfathered_chunks())
}

fn grandfathered_in_chunks(name: String, chunks: List<List<String>>) -> Bool {
  match chunks {
    Empty {} => false
    Cons { head: c, tail: rest } =>
      if grandfathered_in_chunk(name: name, rows: c) {
        true
      } else {
        grandfathered_in_chunks(name: name, chunks: rest)
      }
  }
}

fn grandfathered_in_chunk(name: String, rows: List<String>) -> Bool {
  match rows {
    Empty {} => false
    Cons { head: r, tail: rest } =>
      if r == name {
        true
      } else {
        grandfathered_in_chunk(name: name, rows: rest)
      }
  }
}

// THE SIZE, AS A PRODUCER RATHER THAN A LITERAL. `v2.workflow.floor_cost_debt` records what a
// transcribed roster count costs: its prose carried three different figures, no two agreeing, none
// of them the roster's length, while the roster itself was correct throughout. This folds the same
// chunks the roster folds, so it cannot disagree with what the floor consults.
fn floor_grandfathered_roster_size() -> Int {
  grandfathered_roster_length(rows: floor_grandfathered_roster())
}

fn grandfathered_roster_length(rows: List<String>) -> Int {
  match rows {
    Empty {} => 0
    Cons { head: _, tail: t } => int_add(a: 1, b: grandfathered_roster_length(rows: t))
  }
}

// ── THE MONOTONE CONTRACT, AS AN EXECUTING VERDICT RATHER THAN AS THE PROSE ABOVE ──────────
//
// DESIGN section 5 admits a monotone debt contract only when the subject universe is independently
// discovered and closed, membership is checked at identity grain, and EVERY REMOVAL CARRIES A TYPED
// DISPOSITION. The first two are properties of how this file was generated; the third is a property
// of how it CHANGES, and a property of change cannot be established by a file that only describes
// its current state. This fold is where that third condition is decidable.
//
// IT TAKES BOTH ROSTERS AS PARAMETERS rather than reading the live one, for two reasons that point
// the same way. It makes the contract testable at fixture scale -- the witnesses plant three-row
// rosters and get the same answers the 3,795-row one would give -- and it keeps the fold free of
// the quadratic cost a live self-comparison would carry.
//
// THE ADDITION ARM IS THE ONE THAT MATTERS. A roster that can grow is not a debt contract; it is a
// list, and every expensive new witness would join it on the day it landed, which is precisely the
// exemption the new-witness tier exists to deny. So an addition REFUSES -- it is not reported, not
// warned about, and not admitted with a note.
//
// DECLARED FRONTIER (DESIGN section 3c): the executing consumer today is
// `test.claim.floor_eval_step_budget_witness_test`. The consumer that lands next is the roster's
// own regeneration gate, which must run this verdict against the discovery producer's current
// output before writing the file -- so that a regen which would ADD a row refuses instead of
// silently resetting the baseline. Trigger: the first change that re-derives this roster.
type RosterChangeVerdict =
    RosterChangeAdmitted
  | RosterAdditionRefused { added: String }
  | RosterRemovalWithoutDisposition { removed: String }

fn roster_change_verdict(
  current: List<String>,
  proposed: List<String>,
  removals: List<GrandfatheredRemoval>,
) -> RosterChangeVerdict {
  match first_addition(current: current, proposed: proposed) {
    Present { value: added } => RosterAdditionRefused { added: added }
    Absent =>
      match first_undisposed_removal(current: current, proposed: proposed, removals: removals) {
        Present { value: removed } => RosterRemovalWithoutDisposition { removed: removed }
        Absent => RosterChangeAdmitted {}
      }
  }
}

// A PROPOSED ROW THAT IS NOT IN THE CURRENT ROSTER IS AN ADDITION. Returns the FIRST one rather
// than a Bool: the identity is the whole finding, and a caller told only that "something was added"
// cannot name it in a refusal.
fn first_addition(current: List<String>, proposed: List<String>) -> Optional<String> {
  match proposed {
    Empty {} => optional_absent()
    Cons { head: p, tail: rest } =>
      if string_in_rows(name: p, rows: current) {
        first_addition(current: current, proposed: rest)
      } else {
        optional_present(value: p)
      }
  }
}

// A CURRENT ROW ABSENT FROM THE PROPOSED ROSTER MUST BE NAMED BY A TYPED DISPOSITION. Absent from
// both the proposal and the disposition list is a row that went quietly missing, which is the state
// the contract exists to make impossible.
fn first_undisposed_removal(
  current: List<String>,
  proposed: List<String>,
  removals: List<GrandfatheredRemoval>,
) -> Optional<String> {
  match current {
    Empty {} => optional_absent()
    Cons { head: c, tail: rest } =>
      if string_in_rows(name: c, rows: proposed) {
        first_undisposed_removal(current: rest, proposed: proposed, removals: removals)
      } else {
        if removal_names(identity: c, removals: removals) {
          first_undisposed_removal(current: rest, proposed: proposed, removals: removals)
        } else {
          optional_present(value: c)
        }
      }
  }
}

fn string_in_rows(name: String, rows: List<String>) -> Bool {
  match rows {
    Empty {} => false
    Cons { head: r, tail: rest } =>
      if r == name {
        true
      } else {
        string_in_rows(name: name, rows: rest)
      }
  }
}

// WHICH ARM OF THE DISPOSITION NAMES THIS IDENTITY. A rename names the PREVIOUS identity, because
// that is the row leaving the roster; the new identity is not a roster member and must not be
// admitted by the same row.
fn removal_names(identity: String, removals: List<GrandfatheredRemoval>) -> Bool {
  match removals {
    Empty {} => false
    Cons { head: r, tail: rest } =>
      if removal_identity(removal: r) == identity {
        true
      } else {
        removal_names(identity: identity, removals: rest)
      }
  }
}

fn removal_identity(removal: GrandfatheredRemoval) -> String {
  match removal {
    WitnessDeleted { identity: i, deleted_in: _ } => i
    WitnessRenamed { previous_identity: p, new_identity: _, renamed_in: _ } => p
    WitnessNowInsideNewTier { identity: i, observed_eval_steps: _, measured_by: _ } => i
  }
}

fn roster_change_admitted(verdict: RosterChangeVerdict) -> Bool {
  match verdict {
    RosterChangeAdmitted => true
    RosterAdditionRefused { added: _ } => false
    RosterRemovalWithoutDisposition { removed: _ } => false
  }
}
