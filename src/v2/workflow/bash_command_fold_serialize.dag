module v2.workflow.bash_command_fold_serialize
import std.optional { Absent, Optional, Present }
import v2.std.grammar { node_atom_identity_optional }
import std.types { List, Map }
import v2.compiler.target_serialize { target_serialize_source_from_model, target_serialize_source_from_selected_row }
import v2.extdeps.languages.bash { bash_stmt_andor_emitted, bash_stmt_andor_target_model, bash_stmt_assign_emitted, bash_stmt_assign_target_model, bash_stmt_exit_emitted, bash_stmt_exit_target_model, bash_stmt_if_emitted, bash_stmt_if_target_model, bash_stmt_negation_emitted, bash_stmt_negation_target_model, bash_stmt_pipe_emitted, bash_stmt_pipe_target_model, bash_stmt_subshell_emitted, bash_stmt_subshell_target_model, bash_redir_stderr_to_file_source_text, bash_redir_from_file_source_text, bash_redir_to_file_source_text, bash_redir_append_to_file_source_text, bash_stmt_with_redir_emitted, bash_stmt_with_redir_target_model, bash_word_cmdsubst_emitted, bash_word_cmdsubst_target_model , bash_stmt_brace_group_emitted, bash_stmt_brace_group_target_model, bash_stmt_seq_emitted, bash_stmt_seq_target_model, bash_stmt_function_def_emitted, bash_stmt_function_def_target_model, bash_stmt_case_emitted, bash_stmt_case_target_model, bash_stmt_case_clause_block_emitted, bash_stmt_case_clause_block_target_model, bash_stmt_case_clause_inline_emitted, bash_stmt_case_clause_inline_target_model, bash_stmt_comment_emitted, bash_stmt_comment_target_model, bash_stmt_for_emitted, bash_stmt_for_target_model, bash_stmt_array_assign_emitted, bash_stmt_array_assign_target_model, bash_word_bare_emitted, bash_word_bare_target_model, bash_word_array_expansion_emitted, bash_word_array_expansion_target_model, bash_word_param_error_emitted, bash_word_param_error_target_model, bash_word_positional_all_emitted, bash_word_positional_all_target_model, bash_word_positional_emitted, bash_word_positional_target_model, bash_word_var_bare_emitted, bash_word_var_bare_target_model, bash_word_double_quoted_emitted, bash_word_double_quoted_target_model, bash_word_quoted_text_emitted, bash_word_quoted_text_target_model }
import v2.extdeps.languages.bash_build { bash_build_stmt_list_single, bash_build_subshell, bash_build_is_bare_word, bash_build_is_name, bash_build_is_digits, bash_build_is_positional_all, bash_build_is_positional, bash_build_is_quoted_text }
import v2.extdeps.languages.bash_orch_if { bash_stmt_if_else_emitted, bash_stmt_if_else_target_model }
import v2.extdeps.languages.bash_command_fold { bash_fold_serialize_refused, bash_fold_relation_row_witness, bash_fold_target_model_for_row, bash_fold_translation_rules_budget_for_row, bash_fold_unsupported_variant_diagnostic }
import std.algebra { list_head, list_tail, list_at_optional }
import v2.std.text { string_is_empty }
import v2.std.compilers.target_model { TargetModel }
import v2.std.diagnostic { Accepted, Diagnostic, ExternalContractUnknown, None, Outcome, Rejected, Some, Unavailable, bind_outcome, diagnostics_singleton, node_locus }
import v2.std.node { positional_child_target_nodes, Atom, Node, Symbol, TypeNode }
import v2.std.witness { Holds, Violates, Witness }




// Emit realization for bash_command_fold grammar rows lives in workflow (serialize_target ∘ translate over pre-built TargetModel rows). Grammar productions and target-model witnesses stay in v2.extdeps.languages.bash_command_fold per layer DAG (extdeps must not import compiler).
fn bash_fold_serialize_emit_from_node(emitted: Node, target: TargetModel) -> Outcome<String> {
  match target_serialize_source_from_model(target: target, emitted: emitted) {
    Accepted { value: source, diagnostics: d } =>
      match d {
        None => Accepted { value: source.carried, diagnostics: None }
        Some { diagnostics: r } => Rejected { diagnostics: r }
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn bash_fold_built_stmt_production_binding(stmt: Node) -> Symbol {
  match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 0) {
    Present { value: tag } =>
      match node_atom_identity_optional(node: tag) {
        Present { value: binding } => binding
        Absent => ^bash_production_fold_unsupported
      }
    Absent => ^bash_production_fold_unsupported
  }
}

// ONE ROW PER LEAF. The row is derived from the emitted node once, the target model is spelled from
// it, and the serializer is handed that row rather than asked to select it again from rules built
// out of it (v2.compiler.target_serialize target_serialize_source_from_selected_row).
// THE ONE PATH THAT CANNOT SPELL THE SUBSTITUTION'S SPACE, AND WHAT IT REFUSES. A substitution whose body
// opens with `(` is valid bash and the language module spells it with the separating space
// (v2.extdeps.languages.bash::bash_cmdsubst_body_spelling), so `$((` -- bash's arithmetic opener, which dies at
// run time with `syntax error: operand expected` -- cannot be produced wherever that text is used. This module
// spells a node's bytes from its GRAMMAR ROW, where `$(` and the body are SEPARATE TOKENS and every arm of
// TokenClassEmitTransform is unconditional (v2.std.compilers.target_model::apply_emit_spelling_transform): no
// rule can reach between them, so this render refuses that operand shape rather than emit bytes bash cannot
// read. The refusal is therefore scoped to the one path where the evidence lives, and it is taken at the ONE
// choke point every row render passes through (bash_fold_serialize_leaf_node) rather than as a list of
// constructs to remember -- a command, a concatenation and any future row-rendered form all pass this way, so
// the invariant is structural, not hand-kept. The walk stops at the first collision and runs once per row
// render, over the same subtree the row serializer itself walks to spell the node.
//
// NAMED TRIGGER FOR THE REMAINING WORK -- `bash_fold_subtree_reaches_cmdsubst_subshell`, named here and at its
// call site. When the row render is taught the space (a substitution-scoped token for the operand's opening
// paren, so the emit transform can be scoped, with round-trip evidence for the parser), delete this guard and
// move the command and concatenation controls from refusal rows to the spaced goldens the word path already
// carries. Until that exists, this guard is load-bearing: deleting it reddens exactly those two rows.
fn bash_fold_cmdsubst_subshell_operand_refused() -> Outcome<String> {
  bash_fold_serialize_refused(variant: ^bash_fold_serialize_cmdsubst_subshell_operand_refused)
}

// IS THIS NODE THE SUBSHELL PRODUCTION? Asked of the SAME relation-row authority the dispatcher uses, so
// the guard cannot disagree with what the serializer itself would render.
fn bash_fold_node_is_fold_subshell(node: Node) -> Bool {
  match bash_fold_relation_row_witness(emitted: node, lhs: ^bash_production_fold_subshell) {
    Holds { value: _ } => true
    Violates { diagnostic: _ } => false
  }
}

// IS THIS WORD A SUBSTITUTION CARRYING A SUBSHELL? The word's kind tag and its body child, read the same way
// the word speller reads them.
fn bash_fold_word_is_cmdsubst_carrying_subshell(word: Node) -> Bool {
  match list_at_optional(xs: positional_child_target_nodes(node: word), index: 0) {
    Present { value: kind_node } =>
      match node_atom_identity_optional(node: kind_node) {
        Present { value: kind } =>
          if kind == ^bash_fold_word_kind_cmdsubst {
            match list_at_optional(xs: positional_child_target_nodes(node: word), index: 1) {
              Present { value: body } => bash_fold_node_is_fold_subshell(node: body)
              Absent => false
            }
          } else {
            false
          }
        Absent => false
      }
    Absent => false
  }
}

// DOES THIS SUBTREE REACH SUCH A WORD? Walked ONCE per command or concatenation -- the node about to be
// rendered from its row -- which is the same subtree the row serializer itself walks to spell it. It is not
// placed in bash_fold_serialize_node, which runs at every level of the recursion.
fn bash_fold_subtree_reaches_cmdsubst_subshell(node: Node) -> Bool {
  if bash_fold_word_is_cmdsubst_carrying_subshell(word: node) {
    true
  } else {
    bash_fold_children_reach_cmdsubst_subshell(children: positional_child_target_nodes(node: node))
  }
}

fn bash_fold_children_reach_cmdsubst_subshell(children: List<Node>) -> Bool {
  match list_head(xs: children) {
    Present { value: child } =>
      if bash_fold_subtree_reaches_cmdsubst_subshell(node: child) {
        true
      } else {
        match list_tail(xs: children) {
          Present { value: rest } => bash_fold_children_reach_cmdsubst_subshell(children: rest)
          Absent => false
        }
      }
    Absent => false
  }
}

fn bash_fold_serialize_leaf_node(
  emitted: Node,
  production_binding: Symbol,
  rule_name: Symbol
) -> Outcome<String> {
  if bash_fold_subtree_reaches_cmdsubst_subshell(node: emitted) {
    bash_fold_cmdsubst_subshell_operand_refused()
  } else {
    match bash_fold_relation_row_witness(emitted: emitted, lhs: production_binding) {
    Holds { value: row } =>
      match bash_fold_target_model_for_row(
        row: row,
        source_literal: ^bash_fold_dynamic_source_literal,
        source_text: "",
        production_binding: production_binding,
        rule_name: rule_name
      ) {
        Holds { value: target } =>
          bash_fold_serialize_selected_row(emitted: emitted, target: target, row: row)
        Violates { diagnostic: d } => Rejected { diagnostics: diagnostics_singleton(d: d) }
      }
      Violates { diagnostic: d } => Rejected { diagnostics: diagnostics_singleton(d: d) }
    }
  }
}

fn bash_fold_serialize_selected_row(emitted: Node, target: TargetModel, row: Node) -> Outcome<String> {
  match target_serialize_source_from_selected_row(
    target: target,
    emitted: emitted,
    row: row,
    rules_budget: bash_fold_translation_rules_budget_for_row(row: row)
  ) {
    Accepted { value: source, diagnostics: d } =>
      match d {
        None => Accepted { value: source.carried, diagnostics: None }
        Some { diagnostics: r } => Rejected { diagnostics: r }
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn bash_fold_serialize_stmts_semi_from(
  acc: String,
  first: Bool,
  rest: List<Node>
) -> Outcome<String> {
  match list_head(xs: rest) {
    Absent => Accepted { value: acc, diagnostics: None }
    Present { value: s } =>
      bind_outcome(
        o: bash_fold_serialize_node(stmt: s),
        f: fn(part) {
          let next = if first { part } else { concat(acc, concat("; ", part)) }
          match list_tail(xs: rest) {
            Present { value: t } =>
              bash_fold_serialize_stmts_semi_from(acc: next, first: false, rest: t)
            Absent => Accepted { value: next, diagnostics: None }
          }
        }
      )
  }
}

fn bash_fold_serialize_stmts_semi(stmts: List<Node>) -> Outcome<String> {
  bash_fold_serialize_stmts_semi_from(acc: "", first: true, rest: stmts)
}

// Statement-list encoding is a nonempty cons spine: one statement child, or
// (prefix-list, statement). Zero children is Bash-illegal as a subshell or then/else
// body (`( )` / empty `then`). bash_build_stmt_list_from_nodes([]) / word_list_from_nodes([])
// plant a one-child refused-empty placeholder; that is not a statement or word and must
// refuse here, not serialize as a member. A tagged statement (first child an Atom) and
// any third child are not that encoding. Reading only children 0 and 1 of an or_else
// body used to keep left and drop right (gunbc.design_argument::fail_closed).
fn bash_fold_stmt_list_shape_refused(list_node: Node) -> Outcome<List<Node>> {
  Rejected {
    diagnostics: diagnostics_singleton(
      d: Diagnostic {
        reason: ^bash_fold_serialize_stmt_list_shape_refused,
        at: node_locus(node: list_node),
        correction: Unavailable { reason: ExternalContractUnknown }
      }
    )
  }
}

fn bash_fold_refused_empty_word_placeholder(node: Node) -> Bool {
  match list_at_optional(xs: positional_child_target_nodes(node: node), index: 0) {
    Present { value: kind } =>
      match node_atom_identity_optional(node: kind) {
        Present { value: binding } => binding == ^bash_build_refused_empty_word_list
        Absent => false
      }
    Absent => false
  }
}

fn bash_fold_flatten_stmt_list(list_node: Node) -> Outcome<List<Node>> {
  match list_at_optional(xs: positional_child_target_nodes(node: list_node), index: 2) {
    Present { value: _ } => bash_fold_stmt_list_shape_refused(list_node: list_node)
    Absent =>
      match list_at_optional(xs: positional_child_target_nodes(node: list_node), index: 0) {
        Present { value: first } =>
          match list_at_optional(xs: positional_child_target_nodes(node: list_node), index: 1) {
            Present { value: second } =>
              match node_atom_identity_optional(node: first) {
                Present { value: _ } => bash_fold_stmt_list_shape_refused(list_node: list_node)
                Absent =>
                  bind_outcome(
                    o: bash_fold_flatten_stmt_list(list_node: first),
                    f: fn(prefix) {
                      Accepted { value: concat(prefix, [second]), diagnostics: None }
                    }
                  )
              }
            Absent =>
              match node_atom_identity_optional(node: first) {
                Present { value: _ } => bash_fold_stmt_list_shape_refused(list_node: list_node)
                Absent =>
                  if bash_fold_refused_empty_word_placeholder(node: first) {
                    bash_fold_stmt_list_shape_refused(list_node: list_node)
                  } else {
                    Accepted { value: [first], diagnostics: None }
                  }
              }
          }
        Absent => bash_fold_stmt_list_shape_refused(list_node: list_node)
      }
  }
}

fn bash_fold_serialize_stmt_list_semi(list_node: Node) -> Outcome<String> {
  bind_outcome(
    o: bash_fold_flatten_stmt_list(list_node: list_node),
    f: fn(stmts) {
      bash_fold_serialize_stmts_semi(stmts: stmts)
    }
  )
}

fn bash_fold_serialize_with_redir_file(stmt: Node, stmt_spelling: String, redir_of: fn(String) -> String) -> Outcome<String> {
  match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 3) {
    Present { value: path_node } =>
      bind_outcome(
        o: bash_fold_serialize_word_node(word: path_node),
        f: fn(path_spelling) {
          bash_fold_serialize_emit_from_node(
            emitted: bash_stmt_with_redir_emitted,
            target: bash_stmt_with_redir_target_model(stmt: stmt_spelling, redir: redir_of(path_spelling))
          )
        }
      )
    Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
  }
}

fn bash_fold_serialize_with_redir_node(stmt: Node) -> Outcome<String> {
  match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 1) {
    Present { value: inner } =>
      match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 2) {
        Present { value: redir_tag } =>
          match node_atom_identity_optional(node: redir_tag) {
            Present { value: redir_binding } =>
              bind_outcome(
                o: bash_fold_serialize_node(stmt: inner),
                f: fn(stmt_spelling) {
                  if redir_binding == ^bash_production_fold_redir_stderr_null {
                    bash_fold_serialize_emit_from_node(
                      emitted: bash_stmt_with_redir_emitted,
                      target: bash_stmt_with_redir_target_model(
                        stmt: stmt_spelling,
                        redir: "2>/dev/null"
                      )
                    )
                  } else if redir_binding == ^bash_production_fold_redir_stdout_and_stderr_null {
                    bash_fold_serialize_emit_from_node(
                      emitted: bash_stmt_with_redir_emitted,
                      target: bash_stmt_with_redir_target_model(
                        stmt: stmt_spelling,
                        redir: ">/dev/null 2>&1"
                      )
                    )
                  } else if redir_binding == ^bash_production_fold_redir_stdout_to_stderr {
                    bash_fold_serialize_emit_from_node(
                      emitted: bash_stmt_with_redir_emitted,
                      target: bash_stmt_with_redir_target_model(
                        stmt: stmt_spelling,
                        redir: ">&2"
                      )
                    )
                  } else if redir_binding == ^bash_production_fold_redir_stderr_to_stdout {
                    bash_fold_serialize_emit_from_node(
                      emitted: bash_stmt_with_redir_emitted,
                      target: bash_stmt_with_redir_target_model(
                        stmt: stmt_spelling,
                        redir: "2>&1"
                      )
                    )
                  } else if redir_binding == ^bash_production_fold_redir_to_file {
                    bash_fold_serialize_with_redir_file(stmt: stmt, stmt_spelling: stmt_spelling, redir_of: fn(p) { bash_redir_to_file_source_text(path: p) })
                  } else if redir_binding == ^bash_production_fold_redir_stderr_to_file {
                    bash_fold_serialize_with_redir_file(stmt: stmt, stmt_spelling: stmt_spelling, redir_of: fn(p) { bash_redir_stderr_to_file_source_text(path: p) })
                  } else if redir_binding == ^bash_production_fold_redir_append_to_file {
                    bash_fold_serialize_with_redir_file(
                      stmt: stmt,
                      stmt_spelling: stmt_spelling,
                      redir_of: fn(p) { bash_redir_append_to_file_source_text(path: p) }
                    )
                  } else if redir_binding == ^bash_production_fold_redir_from_file {
                    bash_fold_serialize_with_redir_file(stmt: stmt, stmt_spelling: stmt_spelling, redir_of: fn(p) { bash_redir_from_file_source_text(path: p) })
                  } else {
                    bash_fold_serialize_refused(variant: ^bash_fold_serialize_redir_binding_unsupported)
                  }
                }
              )
            Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_node_shape_refused)
          }
        Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
      }
    Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
  }
}

fn bash_fold_serialize_word_node(word: Node) -> Outcome<String> {
  match list_at_optional(xs: positional_child_target_nodes(node: word), index: 0) {
    Present { value: kind_node } =>
      match node_atom_identity_optional(node: kind_node) {
        Present { value: kind } =>
          if kind == ^bash_fold_word_kind_lit {
            bash_fold_serialize_leaf_node(
              emitted: word,
              production_binding: ^bash_production_fold_lit_word,
              rule_name: ^bash_production_fold_lit_word
            )
          } else if kind == ^bash_fold_word_kind_concat {
            match list_at_optional(xs: positional_child_target_nodes(node: word), index: 1) {
              Present { value: parts } =>
                bind_outcome(
                  o: bash_fold_flatten_stmt_list(list_node: parts),
                  f: fn(_) {
                    bash_fold_serialize_leaf_node(
                      emitted: word,
                      production_binding: ^bash_production_fold_concat_word,
                      rule_name: ^bash_production_fold_concat_word
                    )
                  }
                )
              Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
            }
          } else if kind == ^bash_fold_word_kind_cmdsubst {
            match list_at_optional(xs: positional_child_target_nodes(node: word), index: 1) {
              Present { value: body } =>
                bind_outcome(
                  o: bash_fold_serialize_node(stmt: body),
                  f: fn(body_spelling) {
                    // Any operand the grammar admits, a subshell included: the substitution's own text carries
                    // the separating space (v2.extdeps.languages.bash::bash_cmdsubst_body_spelling), so the
                    // bytes are the compound command and never an arithmetic expression.
                    bash_fold_serialize_emit_from_node(
                      emitted: bash_word_cmdsubst_emitted,
                      target: bash_word_cmdsubst_target_model(body: body_spelling)
                    )
                  }
                )
              Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
            }
          } else if kind == ^bash_fold_word_kind_bare {
            match list_at_optional(xs: positional_child_target_nodes(node: word), index: 1) {
              Present { value: text_node } =>
                match node_atom_identity_optional(node: text_node) {
                  Present { value: text } =>
                    if bash_build_is_bare_word(text: text) {
                      // The node is the grammar's own word: the row for this
                      // production supplies the spelling, so the emit side and the
                      // ingest side read one declaration.
                      bash_fold_serialize_leaf_node(
                        emitted: word,
                        production_binding: ^bash_production_fold_bare_word,
                        rule_name: ^bash_production_fold_bare_word
                      )
                    } else {
                      bash_fold_serialize_refused(variant: ^bash_fold_serialize_bare_unsafe)
                    }
                  Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_node_shape_refused)
                }
              Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
            }
          } else if kind == ^bash_fold_word_kind_array_expansion {
            match list_at_optional(xs: positional_child_target_nodes(node: word), index: 1) {
              Present { value: text_node } =>
                match node_atom_identity_optional(node: text_node) {
                  Present { value: text } =>
                    if bash_build_is_name(text: text) {
                      // The node is the grammar's own word: the row for this
                      // production supplies the spelling, so the emit side and the
                      // ingest side read one declaration.
                      bash_fold_serialize_leaf_node(
                        emitted: word,
                        production_binding: ^bash_production_fold_array_expansion_word,
                        rule_name: ^bash_production_fold_array_expansion_word
                      )
                    } else {
                      bash_fold_serialize_refused(variant: ^bash_fold_serialize_array_expansion_unsafe)
                    }
                  Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_node_shape_refused)
                }
              Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
            }
          } else if kind == ^bash_fold_word_kind_param_error {
            match list_at_optional(xs: positional_child_target_nodes(node: word), index: 1) {
              Present { value: index_node } =>
                match node_atom_identity_optional(node: index_node) {
                  Present { value: index } =>
                    match list_at_optional(xs: positional_child_target_nodes(node: word), index: 2) {
                      Present { value: word_node } =>
                        match node_atom_identity_optional(node: word_node) {
                          Present { value: message } =>
                            if bash_build_is_digits(text: index) {
                              bash_fold_serialize_emit_from_node(
                                emitted: bash_word_param_error_emitted,
                                target: bash_word_param_error_target_model(
                                  index: index,
                                  word: message
                                )
                              )
                            } else {
                              bash_fold_serialize_refused(
                                variant: ^bash_fold_serialize_param_error_index_refused
                              )
                            }
                          Absent => bash_fold_serialize_refused(
                            variant: ^bash_fold_serialize_node_shape_refused
                          )
                        }
                      Absent => bash_fold_serialize_refused(
                        variant: ^bash_fold_serialize_positional_child_absent
                      )
                    }
                  Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_node_shape_refused)
                }
              Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
            }
          } else if kind == ^bash_fold_word_kind_positional {
            match list_at_optional(xs: positional_child_target_nodes(node: word), index: 1) {
              Present { value: text_node } =>
                match node_atom_identity_optional(node: text_node) {
                  Present { value: text } =>
                    if bash_build_is_positional(index: text) {
                      bash_fold_serialize_leaf_node(
                        emitted: word,
                        production_binding: ^bash_production_fold_positional_word,
                        rule_name: ^bash_production_fold_positional_word
                      )
                    } else {
                      bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_unsafe)
                    }
                  Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_node_shape_refused)
                }
              Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
            }
          } else if kind == ^bash_fold_word_kind_positional_all {
            match list_at_optional(xs: positional_child_target_nodes(node: word), index: 1) {
              Present { value: text_node } =>
                match node_atom_identity_optional(node: text_node) {
                  Present { value: text } =>
                    if bash_build_is_positional_all(which: text) {
                      // The node is the grammar's own word: the row for this
                      // production supplies the spelling, so the emit side and the
                      // ingest side read one declaration.
                      bash_fold_serialize_leaf_node(
                        emitted: word,
                        production_binding: ^bash_production_fold_positional_all_word,
                        rule_name: ^bash_production_fold_positional_all_word
                      )
                    } else {
                      bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_all_unsafe)
                    }
                  Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_node_shape_refused)
                }
              Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
            }
          } else if kind == ^bash_fold_word_kind_var_bare {
            match list_at_optional(xs: positional_child_target_nodes(node: word), index: 1) {
              Present { value: text_node } =>
                match node_atom_identity_optional(node: text_node) {
                  Present { value: text } =>
                    if bash_build_is_name(text: text) {
                      // The node is the grammar's own word: the row for this
                      // production supplies the spelling, so the emit side and the
                      // ingest side read one declaration.
                      bash_fold_serialize_leaf_node(
                        emitted: word,
                        production_binding: ^bash_production_fold_var_bare_word,
                        rule_name: ^bash_production_fold_var_bare_word
                      )
                    } else {
                      bash_fold_serialize_refused(variant: ^bash_fold_serialize_var_bare_unsafe)
                    }
                  Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_node_shape_refused)
                }
              Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
            }
          } else if kind == ^bash_fold_word_kind_quoted_text {
            match list_at_optional(xs: positional_child_target_nodes(node: word), index: 1) {
              Present { value: text_node } =>
                match node_atom_identity_optional(node: text_node) {
                  Present { value: text } =>
                    if bash_build_is_quoted_text(text: text) {
                      // The node is the grammar's own word: the row for this
                      // production supplies the spelling, so the emit side and the
                      // ingest side read one declaration.
                      bash_fold_serialize_leaf_node(
                        emitted: word,
                        production_binding: ^bash_production_fold_quoted_text_word,
                        rule_name: ^bash_production_fold_quoted_text_word
                      )
                    } else {
                      bash_fold_serialize_refused(variant: ^bash_fold_serialize_quoted_text_unsafe)
                    }
                  Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_node_shape_refused)
                }
              Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
            }
          } else if kind == ^bash_fold_word_kind_double_quoted {
            match list_at_optional(xs: positional_child_target_nodes(node: word), index: 1) {
              Present { value: parts } =>
                // The parts are serialized FIRST, and only as a refusal check: a part
                // whose word kind has no arm (an unsupported kind, an unsafe quoted text,
                // a cmdsubst body that is not a command) rejects here with its own
                // diagnostic instead of being silently dropped by the grammar route.
                // Its SPELLING is deliberately not used, because the bytes of this word
                // come from one place -- the grammar row for
                // ^bash_production_fold_double_quoted_word, which supplies the two quotes
                // around the parts (gunbc.design_argument::single_authority). Splicing the
                // concatenated parts in here would render `"$X"` from two authorities: the
                // parts from this function, the quotes from the row.
                match bash_fold_serialize_word_parts_concatenated(parts: parts) {
                  Accepted { value: _, diagnostics: pd } =>
                    match pd {
                      None =>
                        bash_fold_serialize_leaf_node(
                          emitted: word,
                          production_binding: ^bash_production_fold_double_quoted_word,
                          rule_name: ^bash_production_fold_double_quoted_word
                        )
                      Some { diagnostics: r } => Rejected { diagnostics: r }
                    }
                  Rejected { diagnostics: r } => Rejected { diagnostics: r }
                }
              Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
            }
          } else if kind == ^bash_build_refused_var_name {
            Rejected {
              diagnostics: diagnostics_singleton(
                d: bash_fold_unsupported_variant_diagnostic(
                  variant: ^bash_build_refused_var_name
                )
              )
            }
          } else if kind == ^bash_build_refused_double_quoted {
            Rejected {
              diagnostics: diagnostics_singleton(
                d: bash_fold_unsupported_variant_diagnostic(
                  variant: ^bash_build_refused_double_quoted
                )
              )
            }
          } else if kind == ^bash_build_refused_builder_declined {
            Rejected {
              diagnostics: diagnostics_singleton(
                d: bash_fold_unsupported_variant_diagnostic(
                  variant: ^bash_build_refused_builder_declined
                )
              )
            }
          } else if kind == ^bash_build_refused_empty_word_list {
            Rejected {
              diagnostics: diagnostics_singleton(
                d: bash_fold_unsupported_variant_diagnostic(
                  variant: ^bash_build_refused_empty_word_list
                )
              )
            }
          } else {
            bash_fold_serialize_refused(variant: ^bash_fold_serialize_word_kind_unsupported)
          }
        Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_node_shape_refused)
      }
    Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
  }
}

// The parts of a double-quoted word are concatenated with NOTHING between them:
// a separator would end the word (bash manual, node "Words").
fn bash_fold_serialize_word_parts_concatenated_from(
  acc: String,
  parts: List<Node>,
  index: Int
) -> Outcome<String> {
  match list_at_optional(xs: parts, index: index) {
    Absent => Accepted { value: acc, diagnostics: None }
    Present { value: part } =>
      bind_outcome(
        o: bash_fold_serialize_word_node(word: part),
        f: fn(spelling) {
          bash_fold_serialize_word_parts_concatenated_from(
            acc: concat(acc, spelling),
            parts: parts,
            index: index + 1
          )
        }
      )
  }
}

fn bash_fold_serialize_word_parts_concatenated(parts: Node) -> Outcome<String> {
  bind_outcome(
    o: bash_fold_flatten_stmt_list(list_node: parts),
    f: fn(part_nodes) {
      bash_fold_serialize_word_parts_concatenated_from(acc: "", parts: part_nodes, index: 0)
    }
  )
}

fn bash_fold_serialize_word_list_spelling_from(
  acc: String,
  first: Bool,
  rest: List<Node>
) -> Outcome<String> {
  match list_head(xs: rest) {
    Absent => Accepted { value: acc, diagnostics: None }
    Present { value: w } =>
      bind_outcome(
        o: bash_fold_serialize_word_node(word: w),
        f: fn(part) {
          let next = if first { part } else { concat(acc, part) }
          match list_tail(xs: rest) {
            Present { value: t } =>
              bash_fold_serialize_word_list_spelling_from(acc: next, first: false, rest: t)
            Absent => Accepted { value: next, diagnostics: None }
          }
        }
      )
  }
}

fn bash_fold_serialize_word_list_spelling(parts: Node) -> Outcome<String> {
  bind_outcome(
    o: bash_fold_flatten_stmt_list(list_node: parts),
    f: fn(words) {
      bash_fold_serialize_word_list_spelling_from(
        acc: "",
        first: true,
        rest: words
      )
    }
  )
}

// A COMMAND'S WORDS ARE CHECKED BEFORE THE ROW SPEAKS. The bytes of a command come from
// one authority -- the grammar row for ^bash_production_fold_command -- and this function
// deliberately does NOT splice word spellings in, for the same reason the double-quoted
// arm does not: two authorities on the same bytes. But deriving the spelling purely from
// the row meant a word the builders had marked refused (a variable name bash would not
// accept, a declined builder's marker, an unsupported kind) was rendered anyway, with its
// raw text interpolated by the row's binding -- fail-open, exactly what review 93289
// (gunbc.design_argument::fail_closed) says a checked builder must never allow. So each
// word is run through `bash_fold_serialize_word_node` first, and its result is used ONLY
// as a refusal check: any rejection propagates with the word's own diagnostic, and an
// acceptance is thrown away before the row supplies the spelling.
fn bash_fold_serialize_command_node(stmt: Node) -> Outcome<String> {
  match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 1) {
    Present { value: words } =>
      match bash_fold_serialize_word_parts_concatenated(parts: words) {
        Accepted { value: _, diagnostics: wd } =>
          match wd {
            None =>
              bash_fold_serialize_leaf_node(
                emitted: stmt,
                production_binding: ^bash_production_fold_command,
                rule_name: ^bash_relation_rule_fold_command
              )
            Some { diagnostics: r } => Rejected { diagnostics: r }
          }
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
  }
}

fn bash_fold_serialize_assign_node(stmt: Node) -> Outcome<String> {
  match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 1) {
    Present { value: name_node } =>
      match node_atom_identity_optional(node: name_node) {
        Present { value: name } =>
          match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 2) {
            Present { value: value } =>
              bind_outcome(
                o: bash_fold_serialize_word_node(word: value),
                f: fn(value_spelling) {
                  bash_fold_serialize_emit_from_node(
                    emitted: bash_stmt_assign_emitted,
                    target: bash_stmt_assign_target_model(
                      name: name,
                      value: value_spelling
                    )
                  )
                }
              )
            Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
          }
        Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_node_shape_refused)
      }
    Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
  }
}

fn bash_fold_serialize_exit_node(stmt: Node) -> Outcome<String> {
  match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 1) {
    Present { value: code_node } =>
      match node_atom_identity_optional(node: code_node) {
        Present { value: code } =>
          bash_fold_serialize_emit_from_node(
            emitted: bash_stmt_exit_emitted,
            target: bash_stmt_exit_target_model(code: code)
          )
        Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_node_shape_refused)
      }
    Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
  }
}

fn bash_fold_serialize_grouped_stmt(stmt: Node) -> Outcome<String> {
  bash_fold_serialize_node(
    stmt: bash_build_subshell(body: bash_build_stmt_list_single(stmt: stmt))
  )
}

fn bash_fold_serialize_andor_operand(stmt: Node, group_binding: Symbol) -> Outcome<String> {
  let binding = bash_fold_built_stmt_production_binding(stmt: stmt)
  if binding == group_binding {
    bash_fold_serialize_grouped_stmt(stmt: stmt)
  } else if binding == ^bash_build_stmt_negation {
    bash_fold_serialize_grouped_stmt(stmt: stmt)
  } else {
    bash_fold_serialize_node(stmt: stmt)
  }
}

// ONLY THE RIGHT OPERAND CAN RE-ASSOCIATE. The Bash Reference Manual's "Lists of Commands"
// puts `&&` and `||` at ONE precedence level, left-associative: `a && b || c` reads back as
// `or_else(and_then(a, b), c)` and `a || b && c` as `and_then(or_else(a, b), c)`. So the left
// operand of either operator re-reads as itself and never needs parentheses, while a right
// operand that is itself an and/or re-reads as the PARENT's operator and does. Grouping the
// left operand too -- what this did -- emitted `( [ -s a ] && [ -s b ] ) || openssl ...` for
// the container command's TLS guard, where the installed artifact carries no parentheses.
fn bash_fold_serialize_andor_pair(left: Node, right: Node, op: String, group_binding: Symbol) -> Outcome<String> {
  bind_outcome(
    o: bash_fold_serialize_node(stmt: left),
    f: fn(left_spelling) {
      bind_outcome(
        o: bash_fold_serialize_andor_operand(stmt: right, group_binding: group_binding),
        f: fn(right_spelling) {
          bash_fold_serialize_emit_from_node(
            emitted: bash_stmt_andor_emitted,
            target: bash_stmt_andor_target_model(
              left: left_spelling,
              op: op,
              right: right_spelling
            )
          )
        }
      )
    }
  )
}

fn bash_fold_serialize_and_then_node(stmt: Node) -> Outcome<String> {
  match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 1) {
    Present { value: left } =>
      match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 2) {
        Present { value: right } =>
          bash_fold_serialize_andor_pair(
            left: left,
            right: right,
            op: "&&",
            group_binding: ^bash_production_fold_or_else
          )
        Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
      }
    Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
  }
}

fn bash_fold_serialize_or_else_node(stmt: Node) -> Outcome<String> {
  match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 1) {
    Present { value: left } =>
      match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 2) {
        Present { value: right } =>
          bash_fold_serialize_andor_pair(
            left: left,
            right: right,
            op: "||",
            group_binding: ^bash_production_fold_and_then
          )
        Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
      }
    Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
  }
}

fn bash_fold_serialize_pipe_node(stmt: Node) -> Outcome<String> {
  match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 1) {
    Present { value: left } =>
      match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 2) {
        Present { value: right } =>
          bind_outcome(
            o: bash_fold_serialize_node(stmt: left),
            f: fn(left_spelling) {
              bind_outcome(
                o: bash_fold_serialize_node(stmt: right),
                f: fn(right_spelling) {
                  bash_fold_serialize_emit_from_node(
                    emitted: bash_stmt_pipe_emitted,
                    target: bash_stmt_pipe_target_model(
                      left: left_spelling,
                      right: right_spelling
                    )
                  )
                }
              )
            }
          )
        Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
      }
    Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
  }
}

fn bash_fold_serialize_if_node(stmt: Node) -> Outcome<String> {
  match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 1) {
    Present { value: cond } =>
      match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 2) {
        Present { value: body } =>
          bind_outcome(
            o: bash_fold_serialize_node(stmt: cond),
            f: fn(cond_spelling) {
              bind_outcome(
                o: bash_fold_serialize_stmt_list_semi(list_node: body),
                f: fn(body_spelling) {
                  bind_outcome(
                    o: bash_stmt_if_target_model(
                      cond: cond_spelling,
                      body: body_spelling
                    ),
                    f: fn(target) {
                      bash_fold_serialize_emit_from_node(
                        emitted: bash_stmt_if_emitted,
                        target: target
                      )
                    }
                  )
                }
              )
            }
          )
        Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
      }
    Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
  }
}

fn bash_fold_serialize_if_else_node(stmt: Node) -> Outcome<String> {
  match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 1) {
    Present { value: cond } =>
      match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 2) {
        Present { value: then_body } =>
          match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 3) {
            Present { value: else_body } =>
              bind_outcome(
                o: bash_fold_serialize_node(stmt: cond),
                f: fn(cond_spelling) {
                  bind_outcome(
                    o: bash_fold_serialize_stmt_list_semi(list_node: then_body),
                    f: fn(then_spelling) {
                      bind_outcome(
                        o: bash_fold_serialize_stmt_list_semi(list_node: else_body),
                        f: fn(else_spelling) {
                          bind_outcome(
                            o: bash_stmt_if_else_target_model(
                              cond: cond_spelling,
                              then_body: then_spelling,
                              else_body: else_spelling
                            ),
                            f: fn(target) {
                              bash_fold_serialize_emit_from_node(
                                emitted: bash_stmt_if_else_emitted,
                                target: target
                              )
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
          }
        Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
      }
    Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
  }
}

fn bash_fold_serialize_subshell_node(stmt: Node) -> Outcome<String> {
  match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 1) {
    Present { value: body } =>
      bind_outcome(
        o: bash_fold_serialize_stmt_list_semi(list_node: body),
        f: fn(body_spelling) {
          bash_fold_serialize_emit_from_node(
            emitted: bash_stmt_subshell_emitted,
            target: bash_stmt_subshell_target_model(body: body_spelling)
          )
        }
      )
    Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
  }
}

fn bash_fold_serialize_negation_inner(inner: Node) -> Outcome<String> {
  let binding = bash_fold_built_stmt_production_binding(stmt: inner)
  if binding == ^bash_production_fold_or_else {
    bash_fold_serialize_grouped_stmt(stmt: inner)
  } else if binding == ^bash_production_fold_and_then {
    bash_fold_serialize_grouped_stmt(stmt: inner)
  } else if binding == ^bash_production_fold_pipe {
    bash_fold_serialize_grouped_stmt(stmt: inner)
  } else if binding == ^bash_build_stmt_negation {
    bash_fold_serialize_grouped_stmt(stmt: inner)
  } else {
    bash_fold_serialize_node(stmt: inner)
  }
}

fn bash_fold_serialize_negation_node(stmt: Node) -> Outcome<String> {
  match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 1) {
    Present { value: inner } =>
      bind_outcome(
        o: bash_fold_serialize_negation_inner(inner: inner),
        f: fn(inner_spelling) {
          bash_fold_serialize_emit_from_node(
            emitted: bash_stmt_negation_emitted,
            target: bash_stmt_negation_target_model(inner: inner_spelling)
          )
        }
      )
    Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
  }
}

fn bash_fold_serialize_node(stmt: Node) -> Outcome<String> {
  let binding = bash_fold_built_stmt_production_binding(stmt: stmt)
  if binding == ^bash_production_fold_command {
    bash_fold_serialize_command_node(stmt: stmt)
  } else if binding == ^bash_production_fold_assign {
    bash_fold_serialize_assign_node(stmt: stmt)
  } else if binding == ^bash_production_fold_exit {
    bash_fold_serialize_exit_node(stmt: stmt)
  } else if binding == ^bash_production_fold_and_then {
    bash_fold_serialize_and_then_node(stmt: stmt)
  } else if binding == ^bash_production_fold_or_else {
    bash_fold_serialize_or_else_node(stmt: stmt)
  } else if binding == ^bash_production_fold_pipe {
    bash_fold_serialize_pipe_node(stmt: stmt)
  } else if binding == ^bash_production_fold_if {
    bash_fold_serialize_if_node(stmt: stmt)
  } else if binding == ^bash_build_stmt_if_else {
    bash_fold_serialize_if_else_node(stmt: stmt)
  } else if binding == ^bash_production_fold_subshell {
    bash_fold_serialize_subshell_node(stmt: stmt)
  } else if binding == ^bash_production_fold_with_redir {
    bash_fold_serialize_with_redir_node(stmt: stmt)
  } else if binding == ^bash_build_stmt_negation {
    bash_fold_serialize_negation_node(stmt: stmt)
  } else if binding == ^bash_production_fold_function_def {
    bash_fold_serialize_function_def_node(stmt: stmt)
  } else if binding == ^bash_production_fold_seq {
    bash_fold_serialize_seq_node(stmt: stmt)
  } else if binding == ^bash_production_fold_brace_group {
    bash_fold_serialize_brace_group_node(stmt: stmt)
  } else if binding == ^bash_production_fold_comment {
    bash_fold_serialize_comment_node(stmt: stmt)
  } else if binding == ^bash_production_fold_case {
    bash_fold_serialize_case_node(stmt: stmt)
  } else if binding == ^bash_production_fold_for {
    bash_fold_serialize_for_node(stmt: stmt)
  } else if binding == ^bash_production_fold_array_assign {
    bash_fold_serialize_array_assign_node(stmt: stmt)
  } else if binding == ^bash_build_refused_empty_stmt_list {
    Rejected {
      diagnostics: diagnostics_singleton(
        d: bash_fold_unsupported_variant_diagnostic(
          variant: ^bash_build_refused_empty_stmt_list
        )
      )
    }
  } else {
    bash_fold_serialize_leaf_node(
      emitted: stmt,
      production_binding: binding,
      rule_name: ^bash_relation_rule_fold_unsupported
    )
  }
}

fn bash_fold_serialize_body(stmts: List<Node>) -> Outcome<String> {
  match list_head(xs: stmts) {
    Absent => Accepted { value: "", diagnostics: None }
    Present { value: s } =>
      bind_outcome(
        o: bash_fold_serialize_node(stmt: s),
        f: fn(part) {
          match list_tail(xs: stmts) {
            Present { value: t } =>
              bind_outcome(
                o: bash_fold_serialize_body(stmts: t),
                f: fn(rest) {
                  Accepted { value: concat(concat(part, "\n"), rest), diagnostics: None }
                }
              )
            Absent => Accepted { value: concat(part, "\n"), diagnostics: None }
          }
        }
      )
  }
}

fn bash_fold_serialize_program(stmts: List<Node>, set_e: Bool) -> Outcome<String> {
  bind_outcome(
    o: bash_fold_serialize_body(stmts: stmts),
    f: fn(body) {
      if set_e {
        Accepted { value: concat("set -e\n", body), diagnostics: None }
      } else {
        Accepted { value: body, diagnostics: None }
      }
    }
  )
}

// ───────────────────────────────────────────────────────────────────────────
// Serializer arms for the srv1 boot-path constructs. Each arm reads the node
// structurally (positional children, never a substring of already-rendered
// text), serializes its children recursively, and emits through the construct's
// own target model in v2.extdeps.languages.bash. A node of the wrong shape is
// refused, not guessed at.
// ───────────────────────────────────────────────────────────────────────────

fn bash_fold_serialize_function_def_node(stmt: Node) -> Outcome<String> {
  match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 1) {
    Present { value: name_node } =>
      match node_atom_identity_optional(node: name_node) {
        Present { value: name } =>
          match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 2) {
            Present { value: body } =>
              bind_outcome(
                o: bash_fold_serialize_stmt_list_semi(list_node: body),
                f: fn(body_spelling) {
                  bash_fold_serialize_emit_from_node(
                    emitted: bash_stmt_function_def_emitted,
                    target: bash_stmt_function_def_target_model(
                      name: name,
                      body: body_spelling
                    )
                  )
                }
              )
            Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
          }
        Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_node_shape_refused)
      }
    Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
  }
}

fn bash_fold_serialize_seq_node(stmt: Node) -> Outcome<String> {
  match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 1) {
    Present { value: body } =>
      bind_outcome(
        o: bash_fold_serialize_stmt_list_semi(list_node: body),
        f: fn(body_spelling) {
          bash_fold_serialize_emit_from_node(
            emitted: bash_stmt_seq_emitted,
            target: bash_stmt_seq_target_model(body: body_spelling)
          )
        }
      )
    Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
  }
}

fn bash_fold_serialize_brace_group_node(stmt: Node) -> Outcome<String> {
  match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 1) {
    Present { value: body } =>
      bind_outcome(
        o: bash_fold_serialize_stmt_list_semi(list_node: body),
        f: fn(body_spelling) {
          bash_fold_serialize_emit_from_node(
            emitted: bash_stmt_brace_group_emitted,
            target: bash_stmt_brace_group_target_model(body: body_spelling)
          )
        }
      )
    Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
  }
}

fn bash_fold_serialize_comment_node(stmt: Node) -> Outcome<String> {
  match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 1) {
    Present { value: text_node } =>
      match node_atom_identity_optional(node: text_node) {
        Present { value: text } =>
          bash_fold_serialize_emit_from_node(
            emitted: bash_stmt_comment_emitted,
            target: bash_stmt_comment_target_model(text: text)
          )
        Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_node_shape_refused)
      }
    Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
  }
}

// One arm of a case statement, block or inline, from the arm's own node.
fn bash_fold_serialize_case_clause_node(clause: Node) -> Outcome<String> {
  match list_at_optional(xs: positional_child_target_nodes(node: clause), index: 0) {
    Present { value: tag_node } =>
      match node_atom_identity_optional(node: tag_node) {
        Present { value: tag } =>
          match list_at_optional(xs: positional_child_target_nodes(node: clause), index: 1) {
            Present { value: pattern_node } =>
              match node_atom_identity_optional(node: pattern_node) {
                Present { value: pattern } =>
                  match list_at_optional(xs: positional_child_target_nodes(node: clause), index: 2) {
                    Present { value: body } =>
                      bind_outcome(
                        o: bash_fold_serialize_stmt_list_semi(list_node: body),
                        f: fn(body_spelling) {
                          if tag == ^bash_production_fold_case_clause_block {
                            bash_fold_serialize_emit_from_node(
                              emitted: bash_stmt_case_clause_block_emitted,
                              target: bash_stmt_case_clause_block_target_model(
                                pattern: pattern,
                                body: body_spelling
                              )
                            )
                          } else if tag == ^bash_production_fold_case_clause_inline {
                            bash_fold_serialize_emit_from_node(
                              emitted: bash_stmt_case_clause_inline_emitted,
                              target: bash_stmt_case_clause_inline_target_model(
                                pattern: pattern,
                                body: body_spelling
                              )
                            )
                          } else {
                            bash_fold_serialize_refused(
                              variant: ^bash_fold_serialize_case_clause_tag_unknown
                            )
                          }
                        }
                      )
                    Absent => bash_fold_serialize_refused(
                      variant: ^bash_fold_serialize_positional_child_absent
                    )
                  }
                Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_node_shape_refused)
              }
            Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
          }
        Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_node_shape_refused)
      }
    Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
  }
}

fn bash_fold_serialize_case_clause_list_from(acc: String, rest: List<Node>) -> Outcome<String> {
  match list_head(xs: rest) {
    Absent => Accepted { value: acc, diagnostics: None }
    Present { value: clause } =>
      bind_outcome(
        o: bash_fold_serialize_case_clause_node(clause: clause),
        f: fn(spelling) {
          match list_tail(xs: rest) {
            Present { value: t } =>
              bash_fold_serialize_case_clause_list_from(acc: concat(acc, spelling), rest: t)
            Absent => Accepted { value: concat(acc, spelling), diagnostics: None }
          }
        }
      )
  }
}

fn bash_fold_serialize_case_clause_list(list_node: Node) -> Outcome<String> {
  bind_outcome(
    o: bash_fold_flatten_stmt_list(list_node: list_node),
    f: fn(clauses) {
      match list_head(xs: clauses) {
        // bash accepts 'case w in esac', but an arm-less case in a rendered
        // launcher is a bug in whoever built it: refuse rather than emit it.
        Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_case_has_no_clauses)
        Present { value: _ } =>
          bash_fold_serialize_case_clause_list_from(acc: "", rest: clauses)
      }
    }
  )
}

fn bash_fold_serialize_case_node(stmt: Node) -> Outcome<String> {
  match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 1) {
    Present { value: word } =>
      match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 2) {
        Present { value: clauses } =>
          bind_outcome(
            o: bash_fold_serialize_word_node(word: word),
            f: fn(word_spelling) {
              bind_outcome(
                o: bash_fold_serialize_case_clause_list(list_node: clauses),
                f: fn(arms_spelling) {
                  bash_fold_serialize_emit_from_node(
                    emitted: bash_stmt_case_emitted,
                    target: bash_stmt_case_target_model(
                      word: word_spelling,
                      arms: arms_spelling
                    )
                  )
                }
              )
            }
          )
        Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
      }
    Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
  }
}

fn bash_fold_serialize_for_node(stmt: Node) -> Outcome<String> {
  match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 1) {
    Present { value: name_node } =>
      match node_atom_identity_optional(node: name_node) {
        Present { value: name } =>
          match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 2) {
            Present { value: words } =>
              match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 3) {
                Present { value: body } =>
                  bind_outcome(
                    o: bash_fold_serialize_leaf_node(
                      emitted: words,
                      production_binding: ^bash_production_fold_command_words,
                      rule_name: ^bash_relation_rule_fold_command_words
                    ),
                    f: fn(words_spelling) {
                      bind_outcome(
                        o: bash_fold_serialize_stmt_list_semi(list_node: body),
                        f: fn(body_spelling) {
                          bash_fold_serialize_emit_from_node(
                            emitted: bash_stmt_for_emitted,
                            target: bash_stmt_for_target_model(
                              name: name,
                              words: words_spelling,
                              body: body_spelling
                            )
                          )
                        }
                      )
                    }
                  )
                Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
              }
            Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
          }
        Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_node_shape_refused)
      }
    Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
  }
}

fn bash_fold_serialize_array_assign_node(stmt: Node) -> Outcome<String> {
  match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 1) {
    Present { value: name_node } =>
      match node_atom_identity_optional(node: name_node) {
        Present { value: name } =>
          match list_at_optional(xs: positional_child_target_nodes(node: stmt), index: 2) {
            Present { value: elements } =>
              bind_outcome(
                o: bash_fold_serialize_leaf_node(
                  emitted: elements,
                  production_binding: ^bash_production_fold_command_words,
                  rule_name: ^bash_relation_rule_fold_command_words
                ),
                f: fn(elements_spelling) {
                  if string_is_empty(s: elements_spelling) {
                    // 'name=()' is an empty-array assignment, not what any
                    // render here means; the builder refuses it too.
                    bash_fold_serialize_refused(
                      variant: ^bash_fold_serialize_array_assign_empty
                    )
                  } else {
                    bash_fold_serialize_emit_from_node(
                      emitted: bash_stmt_array_assign_emitted,
                      target: bash_stmt_array_assign_target_model(
                        name: name,
                        elements: elements_spelling
                      )
                    )
                  }
                }
              )
            Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
          }
        Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_node_shape_refused)
      }
    Absent => bash_fold_serialize_refused(variant: ^bash_fold_serialize_positional_child_absent)
  }
}
