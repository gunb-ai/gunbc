data v2_stage0_hash: Hash = v2_stage0_hash
data v2_stage1_hash: Hash = v2_stage1_hash
data v2_stage2_hash: Hash = v2_stage2_hash
data pinned_v4_fixed_point_hash: Hash = pinned_v4_fixed_point_hash

type BootstrapHashPin {
  digest: Hash
  pin: Symbol
}

type BootstrapConstruct {
  identity: Symbol
}

type SeedCapability {
  language_model: LanguageModel
  constructs: List<BootstrapConstruct>
  frozen_at: Symbol
}

type BootstrapSourceSnapshot {
  root: Node
  language_model: LanguageModel
  content_hash: BootstrapHashPin
}

type BootstrapProjectionInputs {
  snapshot: BootstrapSourceSnapshot
  target_model: TargetModel
  runtime_model: V4EvaluatorRuntime
}

type BootstrapFootprint {
  inputs: BootstrapProjectionInputs
  closure_hash: Hash
  constructs: List<BootstrapConstruct>
}

type BootstrapCapabilityExact {
  footprint: BootstrapFootprint
  capability: SeedCapability
}

type PhysicalExecutionAxiom {
  machine_model: Symbol
  executes_as_modeled: Symbol
}

type DiverseCompilationRun {
  source: Symbol
  compiler: Symbol
  output: Symbol
  output_hash: BootstrapHashPin
}

type IndependentCompilerEvidence
  = IndependentCompilerEvidenceUnavailable { correction: Unavailable }

type IndependentCompilerPair {
  primary: Symbol
  secondary: Symbol
}

type DiverseCompilationAgreement {
  primary: DiverseCompilationRun
  secondary: DiverseCompilationRun
  independent_compilers: IndependentCompilerPair
  agreed_hash: BootstrapHashPin
}

type CompileStage {
  consumes: List<Symbol>
  produces: Symbol
  produces_hash: BootstrapHashPin
  compiled_by: Symbol
}

type FixptStage1Stage2 {
  left: Symbol
  left_hash: BootstrapHashPin
  right: Symbol
  right_hash: BootstrapHashPin
  pinned_hash: BootstrapHashPin
}

type SeedHonestyDischarge {
  seed_honesty_axiom: Symbol
  diverse_double_compilation: DiverseCompilationAgreement
}

type SeedSelfVerifyReceipt {
  claim: DiverseCompilationRun
  check: DiverseCompilationRun
}

type SeedHonestyDecision
  = SeedHonestyUndecided
  | IndependentRebuildRequiredFirst { rationale: NonEmptyStr }
  | FixedPointTrustSufficient { rationale: NonEmptyStr }

data seed_honesty_decision: SeedHonestyDecision = FixedPointTrustSufficient {
  rationale: "OPERATOR VERDICT 2026-08-02. V1 deletion does not require an independently implemented second compiler. It requires an explicit generation-admission pipeline: each compiler stage executes against a declared requirement revision, binds its exact inputs, outputs, producer and verdict, and prevents downstream use when its local requirements fail. A candidate generation may be produced and inspected but cannot promote itself. Promotion requires declared requirement changes, complete stage and behavioral receipts, no undeclared v1 fallback, and a retained known-good recovery path. Breaking requirement changes require an expand-migrate-contract bridge. The previous generation remains available until the promoted compiler demonstrates that it can produce a valid CHANGED successor, not merely reproduce itself.\n\nWHY DIVERSE DOUBLE COMPILATION IS NOT A PREREQUISITE, STATED SO THE CLASS IT LEAVES OPEN IS NOT UNDERSOLD. DDC protects against compiler-correlated or malicious miscompilation that readable-source review and ordinary fixed-point evidence do NOT rule out. Readability of the seed source is not the defense and must not be cited as one: the classic attack is precisely a binary that miscompiles readable source, and a stage1-equals-stage2 fixed point is exactly what a self-reproducing defect also produces. What is claimed here is narrower and is a mitigation, not a proof. The seed is hand-written Rust in this repository with full readable history; the Rust it emits is committed as plain text and compared against freshly emitted output by the required regen gate on every run; so a perpetuated defect must appear in a readable diff AND survive human review of it, rather than living only in an opaque artifact nobody reads. That is review quality at a declared boundary, and DESIGN 4b places such a class outside the ladder rather than admitting a weak implementation onto it as a rung. The residual accepted by this verdict is explicit: a defect that reproduces itself through both rustc and the emitted text without ever surfacing in that diff is excluded by nothing stated here. It is ranked below the generation-admission program because deleting v1 does not enlarge it -- the exposure is a property of the seed and its host toolchain, which deletion shrinks rather than grows. DDC is retained as a separate trust-hardening program with no prerequisite edge to any v1-exit finish line.\n\nWHAT THIS VERDICT DOES NOT PROTECT, DISPOSED EXPLICITLY RATHER THAN IMPLIED. First: a fixed point does not defeat a self-reproducing defect. Stage1 equalling stage2 is exactly what a defect that reproduces itself also produces, so this verdict ACCEPTS that residual rather than claiming the fixed point rules it out. Second: seed_self_verify_check is a proven decision procedure and NOT the live trust-path authority -- the realized-comparison and regen paths do not route their artifact identities through it. This verdict does not wire that path and must not be read as protecting it; the generation-admission program named above owns it. Third: rollback and fix-forward are different guarantees. Committed emitted Rust gives rollback to any earlier generation, but it does not by itself give fix-forward once a requirements revision has changed what the previous generation can read. The bootstrap reachability invariant in that program is what addresses this, and it is unbuilt today." as NonEmptyStr
}

data independent_compiler_evidence_dissolve_on_note: DissolutionCondition = unbound_dissolution(description: "Dissolve-on: a future Available arm requires grounded independent-compiler provenance plus executed output bytes/digests under a separately ruled DDC/reference-compiler slice. Until then the evidence carrier is Unavailable-only, and the bootstrap discharge wall must refuse every current construction.")

data bootstrap_seed_honesty_disconnected_digest_note: String = "The self_host_bytes_digest_source_perturb_teeth_holds witness stays green; this unavailable-only seed-honesty carrier is disconnected from canonical_emitted_bytes_digest in this PR."

fn independent_compiler_evidence_unavailable() -> IndependentCompilerEvidence {
  IndependentCompilerEvidenceUnavailable {
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

type BootstrapPlan {
  seed: CompileStage
  self0: CompileStage
  self1: CompileStage
  fixpt: FixptStage1Stage2
}

type ConvergenceLadder {
  entry_seed: Symbol
  plan: BootstrapPlan
  fixed_point: FixptStage1Stage2
}
fn bs_diagnostic(reason: Symbol) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: Textual { file: ^bootstrap_workflow_file, extent: WholeFile },
    correction: Unavailable { reason: AmbiguousIntent }
  }
}

fn bs_symbol_eq(left: Symbol, right: Symbol) -> Bool {
  left == right
}

fn bootstrap_construct_eq(left: BootstrapConstruct, right: BootstrapConstruct) -> Bool {
  left.identity == right.identity
}

fn bootstrap_construct_snoc_dedup(
  acc: List<BootstrapConstruct>,
  item: BootstrapConstruct
) -> List<BootstrapConstruct> {
  match contains(xs: acc, item: item, eq: bootstrap_construct_eq) {
    true => acc
    false => list_snoc_item(xs: acc, item: item)
  }
}

fn bootstrap_construct_list_append_unique(
  left: List<BootstrapConstruct>,
  right: List<BootstrapConstruct>
) -> List<BootstrapConstruct> {
  fold_list(
    xs: right,
    empty: left,
    cons: fn(acc, item) { bootstrap_construct_snoc_dedup(acc: acc, item: item) }
  )
}

fn seed_capability_language_model() -> LanguageModel {
  void_language_model(identity: ^bootstrap_seed_language_model_identity)
}

fn bootstrap_construct_subset_node(identity: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: identity } },
    children: [],
    occurrence_id: OccurrenceSynthetic
}
}

fn bootstrap_source_snapshot_root() -> Node {
  bootstrap_construct_subset_node(identity: ^bootstrap_construct_source_language_subset)
}

fn bootstrap_seed_capability_inventory_root() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^bootstrap_construct_source_language_subset },
        target: bootstrap_construct_subset_node(identity: ^bootstrap_construct_source_language_subset)
      },
      Edge {
        label: Named { name: ^bootstrap_construct_target_model_subset },
        target: bootstrap_construct_subset_node(identity: ^bootstrap_construct_target_model_subset)
      },
      Edge {
        label: Named { name: ^bootstrap_construct_runtime_model_subset },
        target: bootstrap_construct_subset_node(identity: ^bootstrap_construct_runtime_model_subset)
      },
      Edge {
        label: Named { name: ^bootstrap_construct_lowering_subset },
        target: bootstrap_construct_subset_node(identity: ^bootstrap_construct_lowering_subset)
      }
    ],
    occurrence_id: OccurrenceSynthetic
}
}

type BootstrapConstructFoldState {
  constructs: List<BootstrapConstruct>
}

fn bootstrap_construct_fold_init(n: Node) -> BootstrapConstructFoldState {
  match n.kind {
    TypeNode { connective: Atom { identity: sym } } =>
      BootstrapConstructFoldState {
        constructs: [BootstrapConstruct { identity: sym }]
      }
    _ => BootstrapConstructFoldState { constructs: [] }
  }
}

fn bootstrap_construct_fold_step(
  acc: BootstrapConstructFoldState,
  edge: Edge,
  child: BootstrapConstructFoldState
) -> BootstrapConstructFoldState {
  BootstrapConstructFoldState {
    constructs: bootstrap_construct_list_append_unique(left: acc.constructs, right: child.constructs)
  }
}

fn bootstrap_construct_fold_algebra() -> NodeFold<BootstrapConstructFoldState> {
  NodeFold {
    init: bootstrap_construct_fold_init,
    step: bootstrap_construct_fold_step
  }
}

fn bootstrap_construct_fold_state(root: Node) -> BootstrapConstructFoldState {
  fold_node(n: root, algebra: bootstrap_construct_fold_algebra())
}

fn bootstrap_footprint_constructs_from_node(root: Node) -> List<BootstrapConstruct> {
  bootstrap_construct_fold_state(root: root).constructs
}

fn bootstrap_target_model_bundle_construct_facet(label: Symbol) -> List<BootstrapConstruct> {
  if label == ^target_model_edge_selection_policy {
    [BootstrapConstruct { identity: ^bootstrap_construct_target_model_subset }]
  } else if label == ^target_model_edge_translation_rules {
    [BootstrapConstruct { identity: ^bootstrap_construct_lowering_subset }]
  } else {
    []
  }
}

fn bootstrap_target_model_bundle_construct_fold_init(n: Node) -> BootstrapConstructFoldState {
  BootstrapConstructFoldState { constructs: [] }
}

fn bootstrap_target_model_bundle_construct_fold_step(
  acc: BootstrapConstructFoldState,
  edge: Edge,
  child: BootstrapConstructFoldState
) -> BootstrapConstructFoldState {
  let facet_constructs = match edge.label {
    Named { name: label } => bootstrap_target_model_bundle_construct_facet(label: label)
    Positional => []
  }

  BootstrapConstructFoldState {
    constructs: bootstrap_construct_list_append_unique(left: acc.constructs, right: facet_constructs)
  }
}

fn bootstrap_target_model_bundle_construct_fold_algebra() -> NodeFold<BootstrapConstructFoldState> {
  NodeFold {
    init: bootstrap_target_model_bundle_construct_fold_init,
    step: bootstrap_target_model_bundle_construct_fold_step
  }
}

fn bootstrap_target_model_bundle_construct_fold_state(root: Node) -> BootstrapConstructFoldState {
  fold_node(n: root, algebra: bootstrap_target_model_bundle_construct_fold_algebra())
}

fn bootstrap_target_model_construct_inventory(target: TargetModel) -> List<BootstrapConstruct> {
  bootstrap_target_model_bundle_construct_fold_state(root: target.bundle).constructs
}

fn bootstrap_runtime_model_construct_inventory(runtime: V4EvaluatorRuntime) -> List<BootstrapConstruct> {
  if runtime.runtime_identity == ^v2_evaluator_runtime_id {
    [BootstrapConstruct { identity: ^bootstrap_construct_runtime_model_subset }]
  } else {
    [BootstrapConstruct { identity: runtime.runtime_identity }]
  }
}

fn bootstrap_snapshot_construct_inventory(snapshot: BootstrapSourceSnapshot) -> List<BootstrapConstruct> {
  bootstrap_footprint_constructs_from_node(root: snapshot.root)
}

fn bootstrap_footprint_constructs_from_projection_inputs(
  inputs: BootstrapProjectionInputs
) -> List<BootstrapConstruct> {
  bootstrap_construct_list_append_unique(
    left: bootstrap_construct_list_append_unique(
      left: bootstrap_snapshot_construct_inventory(snapshot: inputs.snapshot),
      right: bootstrap_target_model_construct_inventory(target: inputs.target_model)
    ),
    right: bootstrap_runtime_model_construct_inventory(runtime: inputs.runtime_model)
  )
}

fn bootstrap_construct_inventory_unique(constructs: List<BootstrapConstruct>) -> Bool {
  unique(xs: constructs, eq: bootstrap_construct_eq)
}

fn bootstrap_canonical_snapshot_content_hash() -> BootstrapHashPin {
  BootstrapHashPin { digest: pinned_v4_fixed_point_hash, pin: ^pinned_v4_fixed_point_hash_pin }
}

fn bs_list_eq(a: List<Symbol>, b: List<Symbol>) -> Bool {
  bag_eq(xs: a, ys: b, eq: bs_symbol_eq)
}

fn bootstrap_constructs_eq(left: List<BootstrapConstruct>, right: List<BootstrapConstruct>) -> Bool {
  bag_eq(xs: left, ys: right, eq: bootstrap_construct_eq)
}

fn bootstrap_projection_runtime_identity_node(runtime: V4EvaluatorRuntime) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: runtime.runtime_identity } },
    children: [],
    occurrence_id: OccurrenceSynthetic
}
}

fn bootstrap_projection_snapshot_content_hash_pin_node(pin: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: pin } },
    children: [],
    occurrence_id: OccurrenceSynthetic
}
}
fn bootstrap_hash_digest_in_fixture_constants(digest: Hash) -> Bool {
  (digest == v2_stage0_hash)
    || (digest == v2_stage1_hash)
    || (digest == v2_stage2_hash)
    || (digest == pinned_v4_fixed_point_hash)
}

fn bootstrap_hash_digest_fixture_atom_node(digest: Hash) -> Node {
  if digest == v2_stage0_hash {
    Node {
      kind: TypeNode { connective: Atom { identity: v2_stage0_hash } },
      children: [],
      occurrence_id: OccurrenceSynthetic
}
  } else if digest == v2_stage1_hash {
    Node {
      kind: TypeNode { connective: Atom { identity: v2_stage1_hash } },
      children: [],
      occurrence_id: OccurrenceSynthetic
}
  } else if digest == v2_stage2_hash {
    Node {
      kind: TypeNode { connective: Atom { identity: v2_stage2_hash } },
      children: [],
      occurrence_id: OccurrenceSynthetic
}
  } else {
    Node {
      kind: TypeNode { connective: Atom { identity: pinned_v4_fixed_point_hash } },
      children: [],
      occurrence_id: OccurrenceSynthetic
}
  }
}

fn bootstrap_hash_pin_pair_projection_node(pin: Symbol, digest: Hash) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^bootstrap_projection_hash_pin_slot_edge },
        target: Node {
          kind: TypeNode { connective: Atom { identity: pin } },
          children: [],
          occurrence_id: OccurrenceSynthetic
}
      },
      Edge {
        label: Named { name: ^bootstrap_projection_hash_digest_slot_edge },
        target: bootstrap_hash_digest_fixture_atom_node(digest: digest)
      }
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn bootstrap_hash_pin_projection_node(pin: BootstrapHashPin) -> Outcome<Node> {
  if bootstrap_hash_digest_in_fixture_constants(digest: pin.digest) {
    if (pin.pin == ^v2_stage0_hash_pin) && (pin.digest == v2_stage0_hash) {
      Accepted {
        value: bootstrap_hash_pin_pair_projection_node(pin: pin.pin, digest: pin.digest),
        diagnostics: None
      }
    } else if (pin.pin == ^v2_stage1_hash_pin) && (pin.digest == v2_stage1_hash) {
      Accepted {
        value: bootstrap_hash_pin_pair_projection_node(pin: pin.pin, digest: pin.digest),
        diagnostics: None
      }
    } else if (pin.pin == ^v2_stage2_hash_pin) && (pin.digest == v2_stage2_hash) {
      Accepted {
        value: bootstrap_hash_pin_pair_projection_node(pin: pin.pin, digest: pin.digest),
        diagnostics: None
      }
    } else if (pin.pin == ^v2_stage2_hash_pin) && (pin.digest == v2_stage1_hash) {
      Accepted {
        value: bootstrap_hash_pin_pair_projection_node(pin: pin.pin, digest: pin.digest),
        diagnostics: None
      }
    } else if (pin.pin == ^pinned_v4_fixed_point_hash_pin) && (pin.digest == pinned_v4_fixed_point_hash) {
      Accepted {
        value: bootstrap_hash_pin_pair_projection_node(pin: pin.pin, digest: pin.digest),
        diagnostics: None
      }
    } else if (pin.pin == ^pinned_v4_fixed_point_hash_pin) && (pin.digest == v2_stage1_hash) {
      Accepted {
        value: bootstrap_hash_pin_pair_projection_node(pin: pin.pin, digest: pin.digest),
        diagnostics: None
      }
    } else {
      Rejected {
        diagnostics: diagnostics_singleton(d: bs_diagnostic(reason: ^bootstrap_hash_pin_digest_pair_unbound))
      }
    }
  } else {
    Rejected {
      diagnostics: diagnostics_singleton(d: bs_diagnostic(reason: ^bootstrap_hash_digest_not_in_fixture_constants))
    }
  }
}

fn bootstrap_plan_accepted_hash_pins_projectable(plan: BootstrapPlan) -> Bool {
  match bootstrap_hash_pin_projection_node(pin: plan.seed.produces_hash) {
    Accepted { value: _, diagnostics: _ } =>
      match bootstrap_hash_pin_projection_node(pin: plan.self0.produces_hash) {
        Accepted { value: _, diagnostics: _ } =>
          match bootstrap_hash_pin_projection_node(pin: plan.self1.produces_hash) {
            Accepted { value: _, diagnostics: _ } =>
              match bootstrap_hash_pin_projection_node(pin: plan.fixpt.left_hash) {
                Accepted { value: _, diagnostics: _ } =>
                  match bootstrap_hash_pin_projection_node(pin: plan.fixpt.right_hash) {
                    Accepted { value: _, diagnostics: _ } =>
                      match bootstrap_hash_pin_projection_node(pin: plan.fixpt.pinned_hash) {
                        Accepted { value: _, diagnostics: _ } => true
                        Rejected { diagnostics: _ } => false
                      }
                    Rejected { diagnostics: _ } => false
                  }
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn bootstrap_plan_accepted_hash_pins_projectable_ok() -> Bool {
  match bootstrap_plan {
    Accepted { value: plan, diagnostics: _ } => bootstrap_plan_accepted_hash_pins_projectable(plan: plan)
    Rejected { diagnostics: _ } => false
  }
}

data bootstrap_plan_accepted_hash_pins_projectable_witness: Bool = bootstrap_plan_accepted_hash_pins_projectable_ok()

fn bootstrap_projection_closure_node(inputs: BootstrapProjectionInputs) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^bootstrap_projection_snapshot_root_edge },
        target: inputs.snapshot.root
      },
      Edge {
        label: Named { name: ^bootstrap_projection_snapshot_language_model_edge },
        target: language_model_to_node(lm: inputs.snapshot.language_model)
      },
      Edge {
        label: Named { name: ^bootstrap_projection_snapshot_content_hash_edge },
        target: bootstrap_projection_snapshot_content_hash_pin_node(pin: inputs.snapshot.content_hash.pin)
      },
      Edge {
        label: Named { name: ^bootstrap_projection_target_bundle_edge },
        target: inputs.target_model.bundle
      },
      Edge {
        label: Named { name: ^bootstrap_projection_runtime_identity_edge },
        target: bootstrap_projection_runtime_identity_node(runtime: inputs.runtime_model)
      }
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn bootstrap_projection_inputs_well_formed(inputs: BootstrapProjectionInputs) -> Bool {
  (inputs.snapshot.root == bootstrap_source_snapshot_root())
    && (inputs.snapshot.language_model == seed_capability_language_model())
    && (inputs.snapshot.content_hash == bootstrap_canonical_snapshot_content_hash())
    && (inputs.target_model == rust_target_model())
    && (inputs.runtime_model == v2_evaluator_runtime())
}

fn bootstrap_footprint(inputs: BootstrapProjectionInputs) -> Witness<BootstrapFootprint> {
  let closure_hash = content_hash(n: bootstrap_projection_closure_node(inputs: inputs))
  let constructs = bootstrap_footprint_constructs_from_projection_inputs(inputs: inputs)
  if bootstrap_projection_inputs_well_formed(inputs: inputs)
       && bootstrap_construct_inventory_unique(constructs: constructs) {
    Holds {
      value: BootstrapFootprint {
        inputs: inputs,
        closure_hash: closure_hash,
        constructs: constructs
      }
    }
  } else {
    Violates { diagnostic: bs_diagnostic(reason: ^bootstrap_footprint_not_realized) }
  }
}

fn bootstrap_seed_capability_matches_footprint(
  footprint: Witness<BootstrapFootprint>,
  capability: SeedCapability
) -> Witness<BootstrapCapabilityExact> {
  match footprint {
    Holds { value: fp } =>
      if bootstrap_construct_inventory_unique(constructs: capability.constructs)
           && bootstrap_constructs_eq(left: fp.constructs, right: capability.constructs) {
        Holds { value: BootstrapCapabilityExact { footprint: fp, capability: capability } }
      } else {
        Violates { diagnostic: bs_diagnostic(reason: ^bootstrap_capability_not_minimal) }
      }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn bootstrap_convergence_ladder(plan: Outcome<BootstrapPlan>) -> Witness<ConvergenceLadder> {
  match plan {
    Accepted { value: bp, diagnostics: _ } =>
      Holds { value: ConvergenceLadder { entry_seed: ^v1_pipeline, plan: bp, fixed_point: bp.fixpt } }
    Rejected { diagnostics: _ } =>
      Violates { diagnostic: bs_diagnostic(reason: ^bootstrap_plan_unavailable_for_ladder) }
  }
}

fn independent_compiler_pair_witness(
  primary: Symbol,
  secondary: Symbol,
  evidence: IndependentCompilerEvidence
) -> Witness<IndependentCompilerPair> {
  match evidence {
    IndependentCompilerEvidenceUnavailable { correction: _ } =>
      Violates { diagnostic: bs_diagnostic(reason: ^bootstrap_diverse_compilation_mismatch) }
  }
}

fn seed_self_verify_check(
  claim: DiverseCompilationRun,
  check: DiverseCompilationRun
) -> Outcome<SeedSelfVerifyReceipt> {
  if claim.output == check.output {
    Rejected {
      diagnostics: diagnostics_singleton(
        d: bs_diagnostic(reason: ^bootstrap_self_verify_same_artifact)
      )
    }
  } else if !(claim.source == check.source)
    || !(claim.compiler == check.compiler)
    || !(claim.output_hash.pin == check.output_hash.pin) {
    Rejected {
      diagnostics: diagnostics_singleton(
        d: bs_diagnostic(reason: ^bootstrap_self_verify_provenance_mismatch)
      )
    }
  } else if !(claim.output_hash.digest == check.output_hash.digest) {
    Rejected {
      diagnostics: diagnostics_singleton(
        d: bs_diagnostic(reason: ^bootstrap_self_verify_diverged)
      )
    }
  } else {
    Accepted {
      value: SeedSelfVerifyReceipt { claim: claim, check: check },
      diagnostics: None
    }
  }
}

fn diverse_compilation_agreement_witness(
  primary: DiverseCompilationRun,
  secondary: DiverseCompilationRun,
  independent_compilers: Witness<IndependentCompilerPair>,
  evidence: IndependentCompilerEvidence,
  agreed_hash: BootstrapHashPin
) -> Witness<DiverseCompilationAgreement> {
  match evidence {
    IndependentCompilerEvidenceUnavailable { correction: _ } =>
      Violates { diagnostic: bs_diagnostic(reason: ^bootstrap_diverse_compilation_mismatch) }
  }
}

fn bootstrap_seed_honesty_discharge_witness(
  axiom: Symbol,
  diverse_double_compilation: Witness<DiverseCompilationAgreement>
) -> Witness<SeedHonestyDischarge> {
  match diverse_double_compilation {
    Holds { value: _ } =>
      Violates { diagnostic: bs_diagnostic(reason: ^bootstrap_diverse_compilation_mismatch) }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn bootstrap_fixpt_witness(f: FixptStage1Stage2) -> Witness<FixptStage1Stage2> {
  if (f.left == ^v2_stage1_binary)
       && (f.right == ^v2_stage2_binary)
       && (f.left_hash.pin == ^v2_stage1_hash_pin)
       && (f.right_hash.pin == ^v2_stage2_hash_pin)
       && (f.pinned_hash.pin == ^pinned_v4_fixed_point_hash_pin)
       && (f.left_hash.digest == f.right_hash.digest)
       && (f.pinned_hash.digest == f.left_hash.digest) {
    Holds { value: f }
  } else {
    Violates { diagnostic: bs_diagnostic(reason: ^bootstrap_mis_wired) }
  }
}

data seed_capability: SeedCapability = SeedCapability {
  language_model: seed_capability_language_model(),
  constructs: bootstrap_footprint_constructs_from_node(root: bootstrap_seed_capability_inventory_root()),
  frozen_at: ^bootstrap_phase1_frozen_submodel
}

data bootstrap_projection_inputs: BootstrapProjectionInputs = BootstrapProjectionInputs {
  snapshot: BootstrapSourceSnapshot {
    root: bootstrap_source_snapshot_root(),
    language_model: seed_capability_language_model(),
    content_hash: bootstrap_canonical_snapshot_content_hash()
  },
  target_model: rust_target_model(),
  runtime_model: v2_evaluator_runtime()
}

data bootstrap_footprint_witness: Witness<BootstrapFootprint> = bootstrap_footprint(inputs: bootstrap_projection_inputs)

data bootstrap_seed_capability_gate: Witness<BootstrapCapabilityExact> = bootstrap_seed_capability_matches_footprint(
  footprint: bootstrap_footprint_witness,
  capability: seed_capability
)

data bootstrap_physical_axiom: PhysicalExecutionAxiom = PhysicalExecutionAxiom {
  machine_model: ^physical_machine_model_axiom,
  executes_as_modeled: ^physical_machine_executes_isa_as_modeled
}

data bootstrap_seed_honesty_discharge: Witness<SeedHonestyDischarge> = bootstrap_seed_honesty_discharge_witness(
  axiom: ^seed_honesty_axiom,
  diverse_double_compilation: diverse_compilation_agreement_witness(
    primary: DiverseCompilationRun {
      source: ^v2_dag_source,
      compiler: ^v1_pipeline,
      output: ^diverse_compile_fixed_point_output,
      output_hash: BootstrapHashPin { digest: pinned_v4_fixed_point_hash, pin: ^pinned_v4_fixed_point_hash_pin }
    },
    secondary: DiverseCompilationRun {
      source: ^v2_dag_source,
      compiler: ^independent_compiler_witness,
      output: ^diverse_compile_fixed_point_output,
      output_hash: BootstrapHashPin { digest: pinned_v4_fixed_point_hash, pin: ^pinned_v4_fixed_point_hash_pin }
    },
    independent_compilers: independent_compiler_pair_witness(
      primary: ^v1_pipeline,
      secondary: ^independent_compiler_witness,
      evidence: independent_compiler_evidence_unavailable()
    ),
    evidence: independent_compiler_evidence_unavailable(),
    agreed_hash: BootstrapHashPin { digest: pinned_v4_fixed_point_hash, pin: ^pinned_v4_fixed_point_hash_pin }
  )
)

fn bootstrap_stage_output(plan: Outcome<BootstrapPlan>, s: Symbol) -> Bool {
  match plan {
    Accepted { value: bp, diagnostics: _ } =>
      (s == bp.seed.produces) || (s == bp.self0.produces) || (s == bp.self1.produces)
    Rejected { diagnostics: _ } => false
  }
}

fn bootstrap_plan_well_formed(p: BootstrapPlan) -> Outcome<BootstrapPlan> {
  match bootstrap_fixpt_witness(f: p.fixpt) {
    Holds { value: _ } =>
      if bs_list_eq(a: p.seed.consumes, b: [^v2_dag_source])
           && (p.seed.produces == ^v2_stage0_binary)
           && (p.seed.compiled_by == ^v1_pipeline)
           && bs_list_eq(a: p.self0.consumes, b: [^v2_dag_source, ^v2_stage0_binary])
           && (p.self0.produces == ^v2_stage1_binary)
           && (p.self0.compiled_by == ^v2_stage0_binary)
           && bs_list_eq(a: p.self1.consumes, b: [^v2_dag_source, ^v2_stage1_binary])
           && (p.self1.produces == ^v2_stage2_binary)
           && (p.self1.compiled_by == ^v2_stage1_binary)
           && (p.seed.produces_hash.pin == ^v2_stage0_hash_pin)
           && (p.self0.produces_hash.pin == ^v2_stage1_hash_pin)
           && (p.self1.produces_hash.pin == ^v2_stage2_hash_pin)
           && (p.self0.produces_hash.digest == p.self1.produces_hash.digest)
           && (p.fixpt.left_hash.digest == p.self0.produces_hash.digest)
           && (p.fixpt.right_hash.digest == p.self1.produces_hash.digest)
           && (p.fixpt.pinned_hash.digest == p.self0.produces_hash.digest) {
        Accepted { value: p, diagnostics: None }
      } else {
        Rejected { diagnostics: diagnostics_singleton(d: bs_diagnostic(reason: ^bootstrap_mis_wired)) }
      }
    Violates { diagnostic: d } => Rejected { diagnostics: diagnostics_singleton(d: d) }
  }
}

data bootstrap_plan_fixpt_digest_mismatch_rejects: Outcome<BootstrapPlan> = bootstrap_plan_well_formed(p: BootstrapPlan {
  seed: CompileStage {
    consumes: [^v2_dag_source],
    produces: ^v2_stage0_binary,
    produces_hash: BootstrapHashPin { digest: v2_stage0_hash, pin: ^v2_stage0_hash_pin },
    compiled_by: ^v1_pipeline
  },
  self0: CompileStage {
    consumes: [^v2_dag_source, ^v2_stage0_binary],
    produces: ^v2_stage1_binary,
    produces_hash: BootstrapHashPin { digest: v2_stage1_hash, pin: ^v2_stage1_hash_pin },
    compiled_by: ^v2_stage0_binary
  },
  self1: CompileStage {
    consumes: [^v2_dag_source, ^v2_stage1_binary],
    produces: ^v2_stage2_binary,
    produces_hash: BootstrapHashPin { digest: v2_stage2_hash, pin: ^v2_stage2_hash_pin },
    compiled_by: ^v2_stage1_binary
  },
  fixpt: FixptStage1Stage2 {
    left: ^v2_stage1_binary,
    left_hash: BootstrapHashPin { digest: v2_stage1_hash, pin: ^v2_stage1_hash_pin },
    right: ^v2_stage2_binary,
    right_hash: BootstrapHashPin { digest: v2_stage2_hash, pin: ^v2_stage2_hash_pin },
    pinned_hash: BootstrapHashPin { digest: pinned_v4_fixed_point_hash, pin: ^pinned_v4_fixed_point_hash_pin }
  }
})

data bootstrap_plan: Outcome<BootstrapPlan> = bootstrap_plan_well_formed(p: BootstrapPlan {
  seed: CompileStage {
    consumes: [^v2_dag_source],
    produces: ^v2_stage0_binary,
    produces_hash: BootstrapHashPin { digest: v2_stage0_hash, pin: ^v2_stage0_hash_pin },
    compiled_by: ^v1_pipeline
  },
  self0: CompileStage {
    consumes: [^v2_dag_source, ^v2_stage0_binary],
    produces: ^v2_stage1_binary,
    produces_hash: BootstrapHashPin { digest: v2_stage1_hash, pin: ^v2_stage1_hash_pin },
    compiled_by: ^v2_stage0_binary
  },
  self1: CompileStage {
    consumes: [^v2_dag_source, ^v2_stage1_binary],
    produces: ^v2_stage2_binary,
    produces_hash: BootstrapHashPin { digest: v2_stage1_hash, pin: ^v2_stage2_hash_pin },
    compiled_by: ^v2_stage1_binary
  },
  fixpt: FixptStage1Stage2 {
    left: ^v2_stage1_binary,
    left_hash: BootstrapHashPin { digest: v2_stage1_hash, pin: ^v2_stage1_hash_pin },
    right: ^v2_stage2_binary,
    right_hash: BootstrapHashPin { digest: v2_stage1_hash, pin: ^v2_stage2_hash_pin },
    pinned_hash: BootstrapHashPin { digest: v2_stage1_hash, pin: ^pinned_v4_fixed_point_hash_pin }
  }
})

data bootstrap_convergence_ladder_witness: Witness<ConvergenceLadder> = bootstrap_convergence_ladder(plan: bootstrap_plan)

data bootstrap_plan_fixpt_witness: Witness<FixptStage1Stage2> = match bootstrap_plan {
  Accepted { value: bp, diagnostics: _ } => bootstrap_fixpt_witness(f: bp.fixpt)
  Rejected { diagnostics: nd } => Violates { diagnostic: nd.head }
}

// ============================================================================
// RECEIPT-BACKED GENERATION ADMISSION: THE CHANGED SUCCESSOR.
//
// Everything above this line admits a candidate that REPRODUCES the seed's
// behavior. That is necessary and it is not sufficient, and the gap is not a
// refinement of the bar -- it is a different claim. A compiler that only ever
// reproduces itself has demonstrated that it can read the source it was built
// from. It has demonstrated nothing about reading a source it was NOT built
// from, which is the only capability that makes the previous generation
// releasable: once a requirement revision moves, fix-forward needs a compiler
// that can consume the CHANGED input, and reproduction evidence is silent
// about that. Rollback and fix-forward are different guarantees; retaining an
// emitted-source history gives the first and does not give the second.
//
// So promotion here consumes the reproduction outcome above AND a changed
// successor receipt, and the two are joined rather than alternated: a chain
// that reproduces but cannot build a changed successor refuses, and a chain
// that builds a changed successor without a reproduction fixed point refuses.
//
// THE DECLARED DELTA IS NOT THE EVIDENCE. A requirement revision is authored,
// so a delta derived from two authored revisions establishes only that someone
// SAID the requirements moved. What admits is the observation that the
// successor's output actually differs on the changed surface, plus conformance
// measured against the NEW roster. The declared delta is the necessary
// precondition that makes those observations interpretable, never a substitute
// for them.
// ============================================================================

// Six axes again, and for the same reason generation identity has six: a single
// opaque requirements digest can report THAT the bar moved and cannot report
// WHICH obligation moved, so every per-axis control collapses into one
// indistinguishable refusal. Each field is the digest of the authority that owns
// that fact, not a prose description of it, so the delta is one comparison per
// axis rather than a reader's judgement.
//
// TWO source coordinates, one join key. source_tree is the FloorDiscoveryTreeId the
// generation was produced over and is the ONLY source fact the delta and the upstream
// cross-checks (XL-1 EffectDemandEvidenceStanding, XL-3 ConformanceAdmission) join on.
// source_revision is the CommitSha that measurement ran at and is informational:
// squash-merge rewrites every commit id, so a commit is not a stable identity across
// the merge and a commit-only mismatch is never a refusal. Carrying the commit
// beside the tree keeps the run locatable without letting a rewritten id masquerade
// as a source change (ruling msg_120bdb6d).
//
// toolchain_context is a Hash rather than a label deliberately: it is JOINED
// against the generation identity's toolchain axis below. A prose toolchain
// string beside an unrelated toolchain digest is two authorities for one fact,
// and the failure it admits is precisely the brief's -- a toolchain that moved
// while the receipt that vouched for it did not.
type CompilerRequirementRevision {
  source_revision: CommitSha
  source_tree: FloorDiscoveryTreeId
  language_model_revision: Hash
  target_model_revision: Hash
  effect_closure_digest: Hash
  conformance_roster_digest: Hash
  toolchain_context: Hash
}

type RequirementAxis
  = SourceTreeAxis
  | LanguageModelRevisionAxis
  | TargetModelRevisionAxis
  | EffectClosureAxis
  | ConformanceRosterAxis
  | ToolchainContextAxis

data requirement_axes: List<RequirementAxis> = [
  SourceTreeAxis,
  LanguageModelRevisionAxis,
  TargetModelRevisionAxis,
  EffectClosureAxis,
  ConformanceRosterAxis,
  ToolchainContextAxis
]

fn requirement_axis_agrees(
  left: CompilerRequirementRevision,
  right: CompilerRequirementRevision,
  axis: RequirementAxis
) -> Bool {
  match axis {
    SourceTreeAxis =>
      git_object_id_eq(left: left.source_tree.object_id, right: right.source_tree.object_id)
    LanguageModelRevisionAxis => left.language_model_revision == right.language_model_revision
    TargetModelRevisionAxis => left.target_model_revision == right.target_model_revision
    EffectClosureAxis => left.effect_closure_digest == right.effect_closure_digest
    ConformanceRosterAxis => left.conformance_roster_digest == right.conformance_roster_digest
    ToolchainContextAxis => left.toolchain_context == right.toolchain_context
  }
}

fn requirement_axis_symbol(axis: RequirementAxis) -> Symbol {
  match axis {
    SourceTreeAxis => ^requirement_axis_source_tree
    LanguageModelRevisionAxis => ^requirement_axis_language_model_revision
    TargetModelRevisionAxis => ^requirement_axis_target_model_revision
    EffectClosureAxis => ^requirement_axis_effect_closure
    ConformanceRosterAxis => ^requirement_axis_conformance_roster
    ToolchainContextAxis => ^requirement_axis_toolchain_context
  }
}

// The CHANGED axes, derived. Nothing authors this list: a bundle cannot claim a
// delta its two revisions do not exhibit, and cannot hide one they do.
fn requirement_revision_changed_axes(
  left: CompilerRequirementRevision,
  right: CompilerRequirementRevision
) -> List<RequirementAxis> {
  fold_list(
    xs: requirement_axes,
    empty: freemonoid_empty(),
    cons: fn(acc, axis) {
      if requirement_axis_agrees(left: left, right: right, axis: axis) {
        acc
      } else {
        list_snoc_item(xs: acc, item: axis)
      }
    }
  )
}

// A generation's requirements are a receipt joined on the generation, not a field
// the generation asserts about itself. Same discipline as every other receipt in
// this module: the subject is checked against the identity admission already fixed,
// so requirements carried over from an earlier compiler refuse as stale and name
// the axis that moved.
type RequirementBindingReceipt {
  subject: GenerationIdentity
  requirements: CompilerRequirementRevision
}

// Conformance is measured against the DECLARED ROSTER of the requirement revision
// in force, not against a previous generation. That is what distinguishes it from
// BehavioralEquivalenceReceipt above, which is a two-generation agreement fact: a
// changed successor is EXPECTED to disagree with its parent on the changed surface,
// so joining it to an oracle generation would refuse exactly the successor that
// proves the capability. The roster digest is carried so a receipt cannot be
// measured against one roster and credited against another.
type ConformanceReceipt {
  subject: GenerationIdentity
  roster_digest: Hash
  corpus: BehavioralCorpus
  cases_compared: Int
  outcome: ObservedVerdict<EquivalenceOutcome>
}

// The observation that the change is REAL in the output, distinguished from the
// two states that are not it. ChangedOutputAbsent is the reproduction-only case
// and refuses by name. It is deliberately not folded into the unavailable arm:
// "we ran the comparison and the output did not move" and "we never ran the
// comparison" have different owners and different repairs.
type ChangedOutputOutcome
  = ChangedOutputObserved { at_case: String }
  | ChangedOutputAbsent

// A successor produced under CHANGED requirements. parent_requirements and
// successor_requirements are receipts about the two generations rather than bare
// revisions, so the delta is anchored to the generations the rest of admission
// already joined on.
//
// compiled_further is the second half of the brief's capability, and it is not
// redundant with successor_build: "the successor binary exists" and "the successor
// consumed a valid input it was not built from" are different facts, and only the
// second is fix-forward. A successor that builds and cannot compile anything is
// exactly the artifact a partially emitted compiler produces.
type ChangedSuccessorReceipt {
  parent: CandidateGeneration
  successor: SuccessorGeneration
  parent_requirements: RequirementBindingReceipt
  successor_requirements: RequirementBindingReceipt
  changed_source_observed: ObservedVerdict<ChangedOutputOutcome>
  successor_build: BuildReceipt
  successor_conformance: ConformanceReceipt
  compiled_further: ObservedVerdict<BuildOutcome>
}

// THE FIXED POINT, WITH BYTE IDENTITY KEPT IN ITS PLACE.
//
// This module's opening note refuses byte identity as the admission criterion and
// that stands: a byte-identical-but-wrong generation must not be admitted, and a
// cleaner-emitting behaviorally-identical one must not be refused. What is added
// here is narrower. Artifact-digest equality between the two self-hosted stages is
// a DETERMINISM observation about one build pipeline, and it is admissible as such
// only when determinism itself was witnessed -- a Rust debug binary embeds its build
// directory (gunbc#8181), so two equal digests across different build locations are
// not comparable and two unequal ones are not a divergence.
//
// Hence the gate: with DeterminismUnwitnessed the digest comparison is never
// consulted and the stage agreement rests on the behavioral receipts alone. It can
// only ever ADD a refusal, never supply an admission the behavior did not.
type DeterminismWitness
  = DeterminismWitnessed { at_build_configuration: Hash }
  | DeterminismUnwitnessed { cause: Symbol }

type FixedPointReceipt {
  left: GenerationIdentity
  right: GenerationIdentity
  determinism: DeterminismWitness
}

// The retained known-good path. It is a SEPARATE generation from everything in the
// promotion, and it is checked to be separate: naming the candidate or the successor
// as the recovery is a recovery path that dies with the thing it is supposed to
// recover from.
type RecoveryGeneration
  = RecoveryRetained { identity: GenerationIdentity }
  | RecoveryUnavailable { cause: Symbol }

// v1 fallback is an OBSERVATION with three states, not a Bool. "No fallback was
// observed" and "we did not look" are the same value in a Bool and different facts
// here, and the second must not admit.
type FallbackObservation
  = NoFallbackObserved
  | FallbackObserved { at_stage: Symbol }

// WHO ADMITS. The brief's condition is that an authority other than the candidate
// admits the candidate, and the only way to make that decidable is to carry the
// admitting authority's own generation identity and join it against the subject.
// Without it, "the candidate did not admit itself" is a claim about a process no
// value records.
type AdmissionAuthority {
  identity: GenerationIdentity
}

// THE GENERATION RECEIPT: what one stage established about the CANDIDATE, with the
// upstream admissions it consumed carried as typed evidence rather than restated.
// gunbc.semantic_conformance owns what conformance means and derives its own admission;
// this receipt owns only the JOIN -- that the evidence is about this tree, that it is on
// its admitted arm, and that the omitted-arm triple was judged over the candidate.
//
// effect_evidence is NOT yet a field, and that absence is named rather than papered:
// its carrier is v2.compiler.effect_demand EffectDemandEvidenceStanding (gunbc#9669),
// not on main at this revision. Until it lands, admit_generation can mint an
// ActiveCompiler without effect evidence, which is exactly the incomplete sole
// constructor the HOLD on gunbc#9674 exists for -- the field, its tree join and its
// refused/absent/mismatch causes land in the same commit that imports the carrier.
type GenerationReceipt {
  requirements: CompilerRequirementRevision
  producer: GenerationIdentity
  subject: GenerationIdentity
  build: BuildReceipt
  conformance_evidence: ConformanceAdmission
  fallback: FallbackObservation
}

type GenerationAdmissionRequest {
  reproduction: SelfHostCandidate
  candidate_receipt: GenerationReceipt
  changed_successor: ChangedSuccessorReceipt
  fixed_point: FixedPointReceipt
  recovery: RecoveryGeneration
  previous_active: GenerationIdentity
  authority: AdmissionAuthority
}

// A requirement binding is joined on its subject like every other receipt, and then
// on the ONE axis it shares with generation identity. The toolchain appears in both
// carriers -- as a declared requirement and as a built fact -- and if they are never
// compared the requirement revision can move its toolchain while the identity that
// vouched for the build did not, which is a receipt about a toolchain nobody built
// with.
fn requirement_binding_causes(
  receipt: Symbol,
  r: RequirementBindingReceipt,
  expected: GenerationIdentity
) -> List<PromotionRefusalCause> {
  let stale = stale_causes_for(receipt: receipt, subject: r.subject, expected: expected)
  if r.requirements.toolchain_context == expected.toolchain {
    stale
  } else {
    list_snoc_item(xs: stale, item: RequirementToolchainAxisUnbound { receipt: receipt })
  }
}

// Conformance carries the same empty-corpus and population joins as equivalence --
// a roster of zero cases is agreement over nothing, and a run that compared a
// different number of cases than the roster declares did not execute the roster it
// names -- plus the roster-digest join that keeps the receipt from being credited
// against a revision it was not measured against.
fn conformance_receipt_causes(
  receipt: Symbol,
  r: ConformanceReceipt,
  expected: GenerationIdentity,
  declared: CompilerRequirementRevision
) -> List<PromotionRefusalCause> {
  let stale = stale_causes_for(receipt: receipt, subject: r.subject, expected: expected)
  let rostered = if r.roster_digest == declared.conformance_roster_digest {
    stale
  } else {
    list_snoc_item(
      xs: stale,
      item: ConformanceRosterNotDeclaredRevision { receipt: receipt }
    )
  }
  let declared_population = if r.corpus.expected_cases <= 0 {
    list_snoc_item(xs: rostered, item: EmptyBehavioralCorpus { receipt: receipt })
  } else {
    rostered
  }
  let sized = if r.cases_compared == r.corpus.expected_cases {
    declared_population
  } else {
    list_snoc_item(
      xs: declared_population,
      item: CorpusPopulationMismatch {
        receipt: receipt,
        expected: r.corpus.expected_cases,
        compared: r.cases_compared
      }
    )
  }
  match r.outcome {
    ObservationUnavailable { cause: c } =>
      list_snoc_item(
        xs: sized,
        item: ReceiptObservationUnavailable { receipt: receipt, cause: c }
      )
    Observed { value: v } =>
      match v {
        BehaviorAgrees => sized
        BehaviorDiverges { at_case: a } =>
          list_snoc_item(
            xs: sized,
            item: ConformanceDivergedFromRoster { receipt: receipt, at_case: a }
          )
      }
  }
}

fn changed_output_causes(
  receipt: Symbol,
  o: ObservedVerdict<ChangedOutputOutcome>
) -> List<PromotionRefusalCause> {
  match o {
    ObservationUnavailable { cause: c } =>
      [ReceiptObservationUnavailable { receipt: receipt, cause: c }]
    Observed { value: v } =>
      match v {
        ChangedOutputObserved { at_case: _ } => freemonoid_empty()
        ChangedOutputAbsent => [ChangedOutputNotObserved { receipt: receipt }]
      }
  }
}

fn compiled_further_causes(
  receipt: Symbol,
  o: ObservedVerdict<BuildOutcome>
) -> List<PromotionRefusalCause> {
  match o {
    ObservationUnavailable { cause: c } =>
      [ReceiptObservationUnavailable { receipt: receipt, cause: c }]
    Observed { value: v } =>
      match v {
        BuildGreen => freemonoid_empty()
        BuildFailed { cause: _ } =>
          [SuccessorDidNotCompileFurtherInput { receipt: receipt }]
      }
  }
}

// THE CHANGED-SUCCESSOR OBLIGATION, ASSEMBLED.
//
// The order the causes are gathered in is not the order they are checked in --
// every one is computed -- so a bundle that fails five ways reports five causes
// rather than the first. That is deliberate: the operator restarting a stopped
// line analyses the whole stop, and a first-cause-only refusal makes the analysis
// iterative for no reason.
fn changed_successor_causes(
  r: ChangedSuccessorReceipt,
  declared_parent: CandidateGeneration
) -> List<PromotionRefusalCause> {
  let parent_identity = r.parent.identity
  let successor_identity = r.successor.identity
  let parent_join = if length(
    xs: generation_identity_mismatched_axes(
      left: declared_parent.identity,
      right: parent_identity
    )
  ) == 0 && length(
    xs: generation_identity_mismatched_axes(
      left: declared_parent.identity,
      right: r.successor.produced_by_candidate.identity
    )
  ) == 0 {
    freemonoid_empty()
  } else {
    [ChangedSuccessorParentNotCandidate]
  }
  let changed = if length(
    xs: requirement_revision_changed_axes(
      left: r.parent_requirements.requirements,
      right: r.successor_requirements.requirements
    )
  ) == 0 {
    [SuccessorRequirementsUnchanged]
  } else {
    freemonoid_empty()
  }
  concat_causes(
    parts: [
      parent_join,
      changed,
      artifact_causes(receipt: ^subject_changed_successor, identity: successor_identity),
      requirement_binding_causes(
        receipt: ^receipt_parent_requirements,
        r: r.parent_requirements,
        expected: parent_identity
      ),
      requirement_binding_causes(
        receipt: ^receipt_successor_requirements,
        r: r.successor_requirements,
        expected: successor_identity
      ),
      changed_output_causes(
        receipt: ^receipt_changed_source_observation,
        o: r.changed_source_observed
      ),
      build_receipt_causes(
        receipt: ^receipt_changed_successor_build,
        r: r.successor_build,
        expected: successor_identity
      ),
      conformance_receipt_causes(
        receipt: ^receipt_changed_successor_conformance,
        r: r.successor_conformance,
        expected: successor_identity,
        declared: r.successor_requirements.requirements
      ),
      compiled_further_causes(
        receipt: ^receipt_changed_successor_compiled_further,
        o: r.compiled_further
      )
    ]
  )
}

// The fixed point is consulted for its DIGEST only under a witnessed determinism
// arm; unwitnessed, the two stages' agreement rests entirely on the behavioral
// receipts the reproduction bundle already carries, and this contributes nothing.
// It can add a refusal. It can never supply an admission.
fn fixed_point_causes(f: FixedPointReceipt) -> List<PromotionRefusalCause> {
  match f.determinism {
    DeterminismUnwitnessed { cause: _ } => freemonoid_empty()
    DeterminismWitnessed { at_build_configuration: _ } =>
      fold_list(
        xs: generation_identity_mismatched_axes(left: f.left, right: f.right),
        empty: freemonoid_empty(),
        cons: fn(acc, axis) {
          list_snoc_item(
            xs: acc,
            item: FixedPointStagesDisagree { axis: generation_axis_symbol(axis: axis) }
          )
        }
      )
  }
}

// A recovery path that IS one of the generations under promotion recovers nothing,
// and a recovery path that does not retain what was active before is not a rollback
// target. Both are checked here rather than left to the operator, because both are
// satisfiable by an author who wants the promotion to pass.
fn recovery_retained_causes(
  retained: GenerationIdentity,
  previous_active: GenerationIdentity,
  candidate: GenerationIdentity,
  successor: GenerationIdentity
) -> List<PromotionRefusalCause> {
  let not_subject = if length(
    xs: generation_identity_mismatched_axes(left: retained, right: candidate)
  ) == 0 {
    [RecoveryPathIsPromotionSubject { subject: ^subject_candidate }]
  } else if length(
    xs: generation_identity_mismatched_axes(left: retained, right: successor)
  ) == 0 {
    [RecoveryPathIsPromotionSubject { subject: ^subject_successor }]
  } else {
    freemonoid_empty()
  }
  let retains = if length(
    xs: generation_identity_mismatched_axes(left: retained, right: previous_active)
  ) == 0 {
    freemonoid_empty()
  } else {
    [RecoveryDoesNotRetainPreviousActive]
  }
  concat_causes(parts: [not_subject, retains])
}

fn recovery_causes(
  recovery: RecoveryGeneration,
  previous_active: GenerationIdentity,
  candidate: GenerationIdentity,
  successor: GenerationIdentity
) -> List<PromotionRefusalCause> {
  match recovery {
    RecoveryUnavailable { cause: c } => [RecoveryPathUnavailable { cause: c }]
    RecoveryRetained { identity: r } =>
      recovery_retained_causes(
        retained: r,
        previous_active: previous_active,
        candidate: candidate,
        successor: successor
      )
  }
}

fn fallback_causes(f: FallbackObservation) -> List<PromotionRefusalCause> {
  match f {
    NoFallbackObserved => freemonoid_empty()
    FallbackObserved { at_stage: s } => [V1FallbackObservedAfterGenesis { at_stage: s }]
  }
}

// The candidate may not be its own admitting authority, and neither may the
// successor it produced -- a successor admitting the chain that produced it is the
// same self-authorization one link further down.
fn authority_causes(
  authority: AdmissionAuthority,
  candidate: GenerationIdentity,
  successor: GenerationIdentity
) -> List<PromotionRefusalCause> {
  if length(
    xs: generation_identity_mismatched_axes(left: authority.identity, right: candidate)
  ) == 0 {
    [AdmissionAuthorityIsSubject { subject: ^subject_candidate }]
  } else if length(
    xs: generation_identity_mismatched_axes(left: authority.identity, right: successor)
  ) == 0 {
    [AdmissionAuthorityIsSubject { subject: ^subject_successor }]
  } else {
    freemonoid_empty()
  }
}

// Conformance evidence is joined on THREE facts, each its own cause. The tree join
// (msg_120bdb6d): the admission must be about the tree this generation was produced
// over -- a commit-only difference is not consulted. The route (XL-3): an admission
// earned with the evaluator off the promoted route is not the same claim as one with
// it on, so it is carried through and refused here. The omitted-arm triple
// (msg_c205c352): on the admitted arm a fail-open has no constructor, so the only join
// left is WHICH generation the held triple was judged over -- it must be the candidate;
// on the refused arm the verdict's fail-open and unobserved states are each named so
// the deficit stays countable rather than folding into "conformance refused".
fn conformance_evidence_causes(
  c: ConformanceAdmission,
  tree: FloorDiscoveryTreeId,
  candidate_tree: FloorDiscoveryTreeId
) -> List<PromotionRefusalCause> {
  match c {
    ConformanceAdmitted {
      source_revision: _,
      source_tree: t,
      omitted_arm: held,
      judged_route: route,
      subject_count: _,
      producer: _
    } => {
      let on_tree = if git_object_id_eq(left: t.object_id, right: tree.object_id) {
        freemonoid_empty()
      } else {
        [ConformanceEvidenceTreeMismatch]
      }
      let on_candidate = if git_object_id_eq(
        left: held.judged_generation_tree.object_id,
        right: candidate_tree.object_id
      ) {
        on_tree
      } else {
        list_snoc_item(xs: on_tree, item: ConformanceOmittedArmJudgedOtherGeneration)
      }
      match route {
        EvaluatorOnPromotedRoute => on_candidate
        EvaluatorOffPromotedRoute =>
          list_snoc_item(xs: on_candidate, item: ConformanceJudgedOffPromotedRoute)
      }
    }
    ConformanceRefused {
      source_revision: _,
      source_tree: _,
      omitted_arm: v,
      judged_route: _,
      blocking_dispositions: blocking,
      unmeasured_areas: unmeasured,
      producer: _
    } => {
      let base = [
        ConformanceEvidenceRefused {
          blocking_dispositions: blocking,
          unmeasured_areas: unmeasured
        }
      ]
      match v {
        OmittedArmHeld { held: _ } => base
        OmittedArmFailedOpen { judged_generation_tree: _, detail: d } =>
          list_snoc_item(xs: base, item: ConformanceOmittedArmFailedOpen { detail: d })
        OmittedArmUnobserved { reason: r } =>
          list_snoc_item(xs: base, item: ConformanceOmittedArmUnobserved { reason: r })
      }
    }
  }
}

// The receipt is about the candidate and nothing else: its subject joins the declared
// candidate identity, its requirements must be the SAME revision the changed-successor
// receipt bound to the candidate as parent (two claims about one generation's
// requirements that disagree are two generations), and its evidence joins on that
// revision's tree.
fn generation_receipt_causes(
  r: GenerationReceipt,
  candidate: GenerationIdentity,
  parent_requirements: CompilerRequirementRevision
) -> List<PromotionRefusalCause> {
  let tree = r.requirements.source_tree
  let same_requirements = if length(
    xs: requirement_revision_changed_axes(left: r.requirements, right: parent_requirements)
  ) == 0 {
    freemonoid_empty()
  } else {
    [CandidateReceiptRequirementsDisagree]
  }
  concat_causes(
    parts: [
      stale_causes_for(receipt: ^receipt_candidate_generation, subject: r.subject, expected: candidate),
      same_requirements,
      requirement_binding_causes(
        receipt: ^receipt_candidate_generation_requirements,
        r: RequirementBindingReceipt { subject: r.subject, requirements: r.requirements },
        expected: candidate
      ),
      build_receipt_causes(
        receipt: ^receipt_candidate_generation_build,
        r: r.build,
        expected: candidate
      ),
      conformance_evidence_causes(c: r.conformance_evidence, tree: tree, candidate_tree: tree),
      fallback_causes(f: r.fallback)
    ]
  )
}

fn generation_admission_causes(
  request: GenerationAdmissionRequest
) -> List<PromotionRefusalCause> {
  let candidate_identity = request.reproduction.candidate.identity
  let successor_identity = request.reproduction.successor.identity
  concat_causes(
    parts: [
      promotion_refusal_causes(c: request.reproduction),
      generation_receipt_causes(
        r: request.candidate_receipt,
        candidate: candidate_identity,
        parent_requirements: request.changed_successor.parent_requirements.requirements
      ),
      changed_successor_causes(
        r: request.changed_successor,
        declared_parent: request.reproduction.candidate
      ),
      fixed_point_causes(f: request.fixed_point),
      recovery_causes(
        recovery: request.recovery,
        previous_active: request.previous_active,
        candidate: candidate_identity,
        successor: successor_identity
      ),
      authority_causes(
        authority: request.authority,
        candidate: candidate_identity,
        successor: successor_identity
      )
    ]
  )
}

// THE WALL. GenerationAdmission is sole_constructor and this module mints it at
// exactly one site -- the arm below where the cause list is empty. Nothing outside
// this module can author one, so an ActiveCompiler cannot be assembled by a caller
// who merely believes the receipts were fine. The invalid state has no constructor
// rather than being validated after the fact (DESIGN 4b rung 4 for the
// self-authorized-promotion class; the receipt CONTENTS remain rung 2-3, since a
// receipt still reports an observation made outside the model).
type GenerationAdmission sole_constructor {
  promoted: SuccessorGeneration
  changed_successor: ChangedSuccessorReceipt
  recovery: GenerationIdentity
  previous_active: GenerationIdentity
  admitted_by: AdmissionAuthority
  candidate_receipt: GenerationReceipt
}

type PromotionDecision
  = PromotionAdmitted { admission: GenerationAdmission }
  | PromotionDenied { causes: List<PromotionRefusalCause> }

// Admission is again the ABSENCE of every cause. The recovery identity is
// re-derived from the retained arm rather than copied from the request, so an
// admission cannot carry a recovery the causes never inspected; the unavailable
// arm is unreachable here because recovery_causes already refused it, and it
// refuses under its own name rather than fabricating an identity.
fn admit_generation(request: GenerationAdmissionRequest) -> PromotionDecision {
  let causes = generation_admission_causes(request: request)
  if length(xs: causes) == 0 {
    match request.recovery {
      RecoveryRetained { identity: r } =>
        PromotionAdmitted {
          admission: GenerationAdmission {
            promoted: request.reproduction.successor,
            changed_successor: request.changed_successor,
            recovery: r,
            previous_active: request.previous_active,
            admitted_by: request.authority,
            candidate_receipt: request.candidate_receipt
          }
        }
      RecoveryUnavailable { cause: c } =>
        PromotionDenied { causes: [RecoveryPathUnavailable { cause: c }] }
    }
  } else {
    PromotionDenied { causes: causes }
  }
}

// The compiler every downstream consumer is required to route through. It is
// sole_constructor and minted only from an admitted decision, so "which compiler is
// authoritative" cannot be answered by a path lookup, an environment default, or a
// caller's assertion -- the only value that answers it carries the admission that
// produced it.
type ActiveCompiler sole_constructor {
  generation: SuccessorGeneration
  admission: GenerationAdmission
}

// A standing rather than an optional. "No compiler has been admitted" is a state
// with a located reason, not an absence: an Absent would tell a consumer to look
// elsewhere, and looking elsewhere is the v1 fallback this program exists to close.
type ActiveCompilerStanding
  = ActiveCompilerAdmitted { active: ActiveCompiler }
  | ActiveCompilerUnavailable { reason: Symbol, causes: List<PromotionRefusalCause> }

fn active_compiler_standing(decision: PromotionDecision) -> ActiveCompilerStanding {
  match decision {
    PromotionAdmitted { admission: a } =>
      ActiveCompilerAdmitted {
        active: ActiveCompiler { generation: a.promoted, admission: a }
      }
    PromotionDenied { causes: cs } =>
      ActiveCompilerUnavailable {
        reason: ^active_compiler_promotion_denied,
        causes: cs
      }
  }
}

fn generation_admission_carries(decision: PromotionDecision, cause: Symbol) -> Bool {
  match decision {
    PromotionAdmitted { admission: _ } => false
    PromotionDenied { causes: cs } =>
      fold_list(
        xs: cs,
        empty: false,
        cons: fn(acc, c) { acc || promotion_refusal_cause_symbol(c: c) == cause }
      )
  }
}

// ============================================================================
// THE BOOTSTRAP CHAIN'S BINDING TO GENERATION ADMISSION.
//
// Everything above this line models the bootstrap PLAN -- which stage consumes
// what, which produces what, and that stage1 and stage2 pin the same digest. A
// plan is a statement about a shape. It is not a statement that any of it ran,
// and it cannot answer the only question a consumer actually asks: WHICH
// COMPILER IS AUTHORITATIVE RIGHT NOW.
//
// That question is answered by v2.compiler.self_host.promotion_admission and by
// nothing here. This module deliberately does not restate the admission rules --
// a second bootstrap ledger with its own notion of promotion is the fork DESIGN
// section 3 exists to prevent, and the failure mode is specific rather than
// stylistic: two authorities for "is this generation admitted" diverge on the
// first requirement change, and the plan-shaped one always looks satisfied
// because a plan cannot fail. What this module contributes is the BINDING: the
// bootstrap chain either produced an admission request or it did not, and the
// second state is named.
//
// THE DIRECTION IS FAIL-CLOSED AND CURRENTLY REFUSES. No native v2 generation
// chain has been executed, so the observation below is BootstrapChainNotExecuted
// and the standing is unavailable with a located reason. That is the correct
// value, not a placeholder: a consumer asking for the active compiler today gets
// a refusal it must handle, never a path lookup, an environment default, or the
// v1 seed standing in silently.
//
// RUNG (DESIGN 4b): the self-authorized-promotion class is at rung 4 --
// ActiveCompiler is sole_constructor and reachable only through an admitted
// decision, so an unadmitted active compiler has no constructor. The chain
// BINDING is at rung 1: nothing yet forces a consumer to read this standing
// rather than resolve a compiler some other way. NEXT-RUNG TRIGGER: the capability
// that compile, test, execute and CI entry all resolve their compiler through an
// ActiveCompiler value -- not the landing of any single call site, since a route
// that closes one door while the others stay open restores nothing.
type BootstrapGenerationChainObservation
  = BootstrapChainExecuted { request: GenerationAdmissionRequest }
  | BootstrapChainNotExecuted { cause: Symbol }

fn bootstrap_active_compiler_standing_of(
  observation: BootstrapGenerationChainObservation
) -> ActiveCompilerStanding {
  match observation {
    BootstrapChainExecuted { request: r } =>
      active_compiler_standing(decision: admit_generation(request: r))
    BootstrapChainNotExecuted { cause: c } =>
      ActiveCompilerUnavailable { reason: c, causes: [] }
  }
}

data bootstrap_generation_chain: BootstrapGenerationChainObservation = BootstrapChainNotExecuted { cause: ^bootstrap_native_generation_chain_not_executed }

data bootstrap_active_compiler_standing: ActiveCompilerStanding = bootstrap_active_compiler_standing_of(observation: bootstrap_generation_chain)
