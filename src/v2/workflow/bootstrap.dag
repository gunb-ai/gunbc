module v2.workflow.bootstrap



data v2_stage0_hash: v2.std.node.Hash = v2_stage0_hash
data v2_stage1_hash: v2.std.node.Hash = v2_stage1_hash
data v2_stage2_hash: v2.std.node.Hash = v2_stage2_hash
data pinned_v4_fixed_point_hash: v2.std.node.Hash = pinned_v4_fixed_point_hash

type BootstrapHashPin {
  digest: v2.std.node.Hash
  pin: v2.std.node.Symbol
}

type BootstrapConstruct {
  identity: v2.std.node.Symbol
}

type SeedCapability {
  language_model: v2.std.language_model.LanguageModel
  constructs: List<BootstrapConstruct>
  frozen_at: v2.std.node.Symbol
}

type BootstrapSourceSnapshot {
  root: v2.std.node.Node
  language_model: v2.std.language_model.LanguageModel
  content_hash: BootstrapHashPin
}

type BootstrapProjectionInputs {
  snapshot: BootstrapSourceSnapshot
  target_model: v2.std.compilers.target_model.TargetModel
  runtime_model: v2.extdeps.runtimes.v2_evaluator.V4EvaluatorRuntime
}

type BootstrapFootprint {
  inputs: BootstrapProjectionInputs
  closure_hash: v2.std.node.Hash
  constructs: List<BootstrapConstruct>
}

type BootstrapCapabilityExact {
  footprint: BootstrapFootprint
  capability: SeedCapability
}

type PhysicalExecutionAxiom {
  machine_model: v2.std.node.Symbol
  executes_as_modeled: v2.std.node.Symbol
}

type DiverseCompilationRun {
  source: v2.std.node.Symbol
  compiler: v2.std.node.Symbol
  output: v2.std.node.Symbol
  output_hash: BootstrapHashPin
}

type IndependentCompilerEvidence
  = IndependentCompilerEvidenceUnavailable { correction: v2.std.diagnostic.Unavailable }

type IndependentCompilerPair {
  primary: v2.std.node.Symbol
  secondary: v2.std.node.Symbol
}

type DiverseCompilationAgreement {
  primary: DiverseCompilationRun
  secondary: DiverseCompilationRun
  independent_compilers: IndependentCompilerPair
  agreed_hash: BootstrapHashPin
}

type CompileStage {
  consumes: List<v2.std.node.Symbol>
  produces: v2.std.node.Symbol
  produces_hash: BootstrapHashPin
  compiled_by: v2.std.node.Symbol
}

type FixptStage1Stage2 {
  left: v2.std.node.Symbol
  left_hash: BootstrapHashPin
  right: v2.std.node.Symbol
  right_hash: BootstrapHashPin
  pinned_hash: BootstrapHashPin
}

type SeedHonestyDischarge {
  seed_honesty_axiom: v2.std.node.Symbol
  diverse_double_compilation: DiverseCompilationAgreement
}

type SeedSelfVerifyReceipt {
  claim: DiverseCompilationRun
  check: DiverseCompilationRun
}

type SeedHonestyDecision
  = SeedHonestyUndecided
  | IndependentRebuildRequiredFirst { rationale: std.types.NonEmptyStr }
  | FixedPointTrustSufficient { rationale: std.types.NonEmptyStr }

data seed_honesty_decision: SeedHonestyDecision = FixedPointTrustSufficient {
  rationale: "OPERATOR VERDICT 2026-08-02. V1 deletion does not require an independently implemented second compiler. It requires an explicit generation-admission pipeline: each compiler stage executes against a declared requirement revision, binds its exact inputs, outputs, producer and verdict, and prevents downstream use when its local requirements fail. A candidate generation may be produced and inspected but cannot promote itself. Promotion requires declared requirement changes, complete stage and behavioral receipts, no undeclared v1 fallback, and a retained known-good recovery path. Breaking requirement changes require an expand-migrate-contract bridge. The previous generation remains available until the promoted compiler demonstrates that it can produce a valid CHANGED successor, not merely reproduce itself.\n\nWHY DIVERSE DOUBLE COMPILATION IS NOT A PREREQUISITE, STATED SO THE CLASS IT LEAVES OPEN IS NOT UNDERSOLD. DDC protects against compiler-correlated or malicious miscompilation that readable-source review and ordinary fixed-point evidence do NOT rule out. Readability of the seed source is not the defense and must not be cited as one: the classic attack is precisely a binary that miscompiles readable source, and a stage1-equals-stage2 fixed point is exactly what a self-reproducing defect also produces. What is claimed here is narrower and is a mitigation, not a proof. The seed is hand-written Rust in this repository with full readable history; the Rust it emits is committed as plain text and compared against freshly emitted output by the required regen gate on every run; so a perpetuated defect must appear in a readable diff AND survive human review of it, rather than living only in an opaque artifact nobody reads. That is review quality at a declared boundary, and DESIGN 4b places such a class outside the ladder rather than admitting a weak implementation onto it as a rung. The residual accepted by this verdict is explicit: a defect that reproduces itself through both rustc and the emitted text without ever surfacing in that diff is excluded by nothing stated here. It is ranked below the generation-admission program because deleting v1 does not enlarge it -- the exposure is a property of the seed and its host toolchain, which deletion shrinks rather than grows. DDC is retained as a separate trust-hardening program with no prerequisite edge to any v1-exit finish line.\n\nWHAT THIS VERDICT DOES NOT PROTECT, DISPOSED EXPLICITLY RATHER THAN IMPLIED. First: a fixed point does not defeat a self-reproducing defect. Stage1 equalling stage2 is exactly what a defect that reproduces itself also produces, so this verdict ACCEPTS that residual rather than claiming the fixed point rules it out. Second: seed_self_verify_check is a proven decision procedure and NOT the live trust-path authority -- the realized-comparison and regen paths do not route their artifact identities through it. This verdict does not wire that path and must not be read as protecting it; the generation-admission program named above owns it. Third: rollback and fix-forward are different guarantees. Committed emitted Rust gives rollback to any earlier generation, but it does not by itself give fix-forward once a requirements revision has changed what the previous generation can read. The bootstrap reachability invariant in that program is what addresses this, and it is unbuilt today." as std.types.NonEmptyStr
}

data independent_compiler_evidence_dissolve_on_note: std.dissolution.DissolutionCondition = unbound_dissolution(description: "Dissolve-on: a future Available arm requires grounded independent-compiler provenance plus executed output bytes/digests under a separately ruled DDC/reference-compiler slice. Until then the evidence carrier is Unavailable-only, and the bootstrap discharge wall must refuse every current construction.")

data bootstrap_seed_honesty_disconnected_digest_note: String = "The self_host_bytes_digest_source_perturb_teeth_holds witness stays green; this unavailable-only seed-honesty carrier is disconnected from canonical_emitted_bytes_digest in this PR."

fn independent_compiler_evidence_unavailable() -> IndependentCompilerEvidence {
  IndependentCompilerEvidenceUnavailable {
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

type BootstrapPlan {
  seed: CompileStage
  self0: CompileStage
  self1: CompileStage
  fixpt: FixptStage1Stage2
}

type ConvergenceLadder {
  entry_seed: v2.std.node.Symbol
  plan: BootstrapPlan
  fixed_point: FixptStage1Stage2
}
fn bs_diagnostic(reason: v2.std.node.Symbol) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: reason,
    at: v2.std.diagnostic.Textual { file: ^bootstrap_workflow_file, extent: WholeFile },
    correction: v2.std.diagnostic.Unavailable { reason: AmbiguousIntent }
  }
}

fn bs_symbol_eq(left: v2.std.node.Symbol, right: v2.std.node.Symbol) -> Bool {
  left == right
}

fn bootstrap_construct_eq(left: BootstrapConstruct, right: BootstrapConstruct) -> Bool {
  left.identity == right.identity
}

fn bootstrap_construct_snoc_dedup(
  acc: List<BootstrapConstruct>,
  item: BootstrapConstruct
) -> List<BootstrapConstruct> {
  match contains(xs: acc, item: item, eq: bootstrap_construct_eq) {
    true => acc
    false => list_snoc_item(xs: acc, item: item)
  }
}

fn bootstrap_construct_list_append_unique(
  left: List<BootstrapConstruct>,
  right: List<BootstrapConstruct>
) -> List<BootstrapConstruct> {
  fold_list(
    xs: right,
    empty: left,
    cons: fn(acc, item) { bootstrap_construct_snoc_dedup(acc: acc, item: item) }
  )
}

fn seed_capability_language_model() -> v2.std.language_model.LanguageModel {
  void_language_model(identity: ^bootstrap_seed_language_model_identity)
}

fn bootstrap_construct_subset_node(identity: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: identity } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn bootstrap_source_snapshot_root() -> v2.std.node.Node {
  bootstrap_construct_subset_node(identity: ^bootstrap_construct_source_language_subset)
}

fn bootstrap_seed_capability_inventory_root() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      v2.std.node.Edge {
        label: Named { name: ^bootstrap_construct_source_language_subset },
        target: bootstrap_construct_subset_node(identity: ^bootstrap_construct_source_language_subset)
      },
      v2.std.node.Edge {
        label: Named { name: ^bootstrap_construct_target_model_subset },
        target: bootstrap_construct_subset_node(identity: ^bootstrap_construct_target_model_subset)
      },
      v2.std.node.Edge {
        label: Named { name: ^bootstrap_construct_runtime_model_subset },
        target: bootstrap_construct_subset_node(identity: ^bootstrap_construct_runtime_model_subset)
      },
      v2.std.node.Edge {
        label: Named { name: ^bootstrap_construct_lowering_subset },
        target: bootstrap_construct_subset_node(identity: ^bootstrap_construct_lowering_subset)
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

type BootstrapConstructFoldState {
  constructs: List<BootstrapConstruct>
}

fn bootstrap_construct_fold_init(n: v2.std.node.Node) -> BootstrapConstructFoldState {
  match n.kind {
    TypeNode { connective: Atom { identity: sym } } =>
      BootstrapConstructFoldState {
        constructs: [BootstrapConstruct { identity: sym }]
      }
    _ => BootstrapConstructFoldState { constructs: [] }
  }
}

fn bootstrap_construct_fold_step(
  acc: BootstrapConstructFoldState,
  edge: v2.std.node.Edge,
  child: BootstrapConstructFoldState
) -> BootstrapConstructFoldState {
  BootstrapConstructFoldState {
    constructs: bootstrap_construct_list_append_unique(left: acc.constructs, right: child.constructs)
  }
}

fn bootstrap_construct_fold_algebra() -> NodeFold<BootstrapConstructFoldState> {
  v2.std.node.NodeFold {
    init: bootstrap_construct_fold_init,
    step: bootstrap_construct_fold_step
  }
}

fn bootstrap_construct_fold_state(root: v2.std.node.Node) -> BootstrapConstructFoldState {
  fold_node(n: root, algebra: bootstrap_construct_fold_algebra())
}

fn bootstrap_footprint_constructs_from_node(root: v2.std.node.Node) -> List<BootstrapConstruct> {
  bootstrap_construct_fold_state(root: root).constructs
}

fn bootstrap_target_model_bundle_construct_facet(label: v2.std.node.Symbol) -> List<BootstrapConstruct> {
  if label == ^target_model_edge_selection_policy {
    [BootstrapConstruct { identity: ^bootstrap_construct_target_model_subset }]
  } else if label == ^target_model_edge_translation_rules {
    [BootstrapConstruct { identity: ^bootstrap_construct_lowering_subset }]
  } else {
    []
  }
}

fn bootstrap_target_model_bundle_construct_fold_init(n: v2.std.node.Node) -> BootstrapConstructFoldState {
  BootstrapConstructFoldState { constructs: [] }
}

fn bootstrap_target_model_bundle_construct_fold_step(
  acc: BootstrapConstructFoldState,
  edge: v2.std.node.Edge,
  child: BootstrapConstructFoldState
) -> BootstrapConstructFoldState {
  let facet_constructs = match edge.label {
    Named { name: label } => bootstrap_target_model_bundle_construct_facet(label: label)
    Positional => []
  }

  BootstrapConstructFoldState {
    constructs: bootstrap_construct_list_append_unique(left: acc.constructs, right: facet_constructs)
  }
}

fn bootstrap_target_model_bundle_construct_fold_algebra() -> NodeFold<BootstrapConstructFoldState> {
  v2.std.node.NodeFold {
    init: bootstrap_target_model_bundle_construct_fold_init,
    step: bootstrap_target_model_bundle_construct_fold_step
  }
}

fn bootstrap_target_model_bundle_construct_fold_state(root: v2.std.node.Node) -> BootstrapConstructFoldState {
  fold_node(n: root, algebra: bootstrap_target_model_bundle_construct_fold_algebra())
}

fn bootstrap_target_model_construct_inventory(target: v2.std.compilers.target_model.TargetModel) -> List<BootstrapConstruct> {
  bootstrap_target_model_bundle_construct_fold_state(root: target.bundle).constructs
}

fn bootstrap_runtime_model_construct_inventory(runtime: v2.extdeps.runtimes.v2_evaluator.V4EvaluatorRuntime) -> List<BootstrapConstruct> {
  if runtime.runtime_identity == ^v2_evaluator_runtime_id {
    [BootstrapConstruct { identity: ^bootstrap_construct_runtime_model_subset }]
  } else {
    [BootstrapConstruct { identity: runtime.runtime_identity }]
  }
}

fn bootstrap_snapshot_construct_inventory(snapshot: BootstrapSourceSnapshot) -> List<BootstrapConstruct> {
  bootstrap_footprint_constructs_from_node(root: snapshot.root)
}

fn bootstrap_footprint_constructs_from_projection_inputs(
  inputs: BootstrapProjectionInputs
) -> List<BootstrapConstruct> {
  bootstrap_construct_list_append_unique(
    left: bootstrap_construct_list_append_unique(
      left: bootstrap_snapshot_construct_inventory(snapshot: inputs.snapshot),
      right: bootstrap_target_model_construct_inventory(target: inputs.target_model)
    ),
    right: bootstrap_runtime_model_construct_inventory(runtime: inputs.runtime_model)
  )
}

fn bootstrap_construct_inventory_unique(constructs: List<BootstrapConstruct>) -> Bool {
  unique(xs: constructs, eq: bootstrap_construct_eq)
}

fn bootstrap_canonical_snapshot_content_hash() -> BootstrapHashPin {
  BootstrapHashPin { digest: pinned_v4_fixed_point_hash, pin: ^pinned_v4_fixed_point_hash_pin }
}

fn bs_list_eq(a: List<v2.std.node.Symbol>, b: List<v2.std.node.Symbol>) -> Bool {
  bag_eq(xs: a, ys: b, eq: bs_symbol_eq)
}

fn bootstrap_constructs_eq(left: List<BootstrapConstruct>, right: List<BootstrapConstruct>) -> Bool {
  bag_eq(xs: left, ys: right, eq: bootstrap_construct_eq)
}

fn bootstrap_projection_runtime_identity_node(runtime: v2.extdeps.runtimes.v2_evaluator.V4EvaluatorRuntime) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: runtime.runtime_identity } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn bootstrap_projection_snapshot_content_hash_pin_node(pin: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: pin } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}
fn bootstrap_hash_digest_in_fixture_constants(digest: v2.std.node.Hash) -> Bool {
  (digest == v2_stage0_hash)
    || (digest == v2_stage1_hash)
    || (digest == v2_stage2_hash)
    || (digest == pinned_v4_fixed_point_hash)
}

fn bootstrap_hash_digest_fixture_atom_node(digest: v2.std.node.Hash) -> v2.std.node.Node {
  if digest == v2_stage0_hash {
    v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: v2_stage0_hash } },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  } else if digest == v2_stage1_hash {
    v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: v2_stage1_hash } },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  } else if digest == v2_stage2_hash {
    v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: v2_stage2_hash } },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  } else {
    v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: pinned_v4_fixed_point_hash } },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

fn bootstrap_hash_pin_pair_projection_node(pin: v2.std.node.Symbol, digest: v2.std.node.Hash) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      v2.std.node.Edge {
        label: Named { name: ^bootstrap_projection_hash_pin_slot_edge },
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: pin } },
          children: [],
          occurrence_id: SyntheticOccurrence
}
      },
      v2.std.node.Edge {
        label: Named { name: ^bootstrap_projection_hash_digest_slot_edge },
        target: bootstrap_hash_digest_fixture_atom_node(digest: digest)
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn bootstrap_hash_pin_projection_node(pin: BootstrapHashPin) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  if bootstrap_hash_digest_in_fixture_constants(digest: pin.digest) {
    if (pin.pin == ^v2_stage0_hash_pin) && (pin.digest == v2_stage0_hash) {
      v2.std.diagnostic.Accepted {
        value: bootstrap_hash_pin_pair_projection_node(pin: pin.pin, digest: pin.digest),
        diagnostics: v2.std.diagnostic.None
      }
    } else if (pin.pin == ^v2_stage1_hash_pin) && (pin.digest == v2_stage1_hash) {
      v2.std.diagnostic.Accepted {
        value: bootstrap_hash_pin_pair_projection_node(pin: pin.pin, digest: pin.digest),
        diagnostics: v2.std.diagnostic.None
      }
    } else if (pin.pin == ^v2_stage2_hash_pin) && (pin.digest == v2_stage2_hash) {
      v2.std.diagnostic.Accepted {
        value: bootstrap_hash_pin_pair_projection_node(pin: pin.pin, digest: pin.digest),
        diagnostics: v2.std.diagnostic.None
      }
    } else if (pin.pin == ^v2_stage2_hash_pin) && (pin.digest == v2_stage1_hash) {
      v2.std.diagnostic.Accepted {
        value: bootstrap_hash_pin_pair_projection_node(pin: pin.pin, digest: pin.digest),
        diagnostics: v2.std.diagnostic.None
      }
    } else if (pin.pin == ^pinned_v4_fixed_point_hash_pin) && (pin.digest == pinned_v4_fixed_point_hash) {
      v2.std.diagnostic.Accepted {
        value: bootstrap_hash_pin_pair_projection_node(pin: pin.pin, digest: pin.digest),
        diagnostics: v2.std.diagnostic.None
      }
    } else if (pin.pin == ^pinned_v4_fixed_point_hash_pin) && (pin.digest == v2_stage1_hash) {
      v2.std.diagnostic.Accepted {
        value: bootstrap_hash_pin_pair_projection_node(pin: pin.pin, digest: pin.digest),
        diagnostics: v2.std.diagnostic.None
      }
    } else {
      v2.std.diagnostic.Rejected {
        diagnostics: diagnostics_singleton(d: bs_diagnostic(reason: ^bootstrap_hash_pin_digest_pair_unbound))
      }
    }
  } else {
    v2.std.diagnostic.Rejected {
      diagnostics: diagnostics_singleton(d: bs_diagnostic(reason: ^bootstrap_hash_digest_not_in_fixture_constants))
    }
  }
}

fn bootstrap_plan_accepted_hash_pins_projectable(plan: BootstrapPlan) -> Bool {
  match bootstrap_hash_pin_projection_node(pin: plan.seed.produces_hash) {
    Accepted { value: _, diagnostics: _ } =>
      match bootstrap_hash_pin_projection_node(pin: plan.self0.produces_hash) {
        Accepted { value: _, diagnostics: _ } =>
          match bootstrap_hash_pin_projection_node(pin: plan.self1.produces_hash) {
            Accepted { value: _, diagnostics: _ } =>
              match bootstrap_hash_pin_projection_node(pin: plan.fixpt.left_hash) {
                Accepted { value: _, diagnostics: _ } =>
                  match bootstrap_hash_pin_projection_node(pin: plan.fixpt.right_hash) {
                    Accepted { value: _, diagnostics: _ } =>
                      match bootstrap_hash_pin_projection_node(pin: plan.fixpt.pinned_hash) {
                        Accepted { value: _, diagnostics: _ } => true
                        Rejected { diagnostics: _ } => false
                      }
                    Rejected { diagnostics: _ } => false
                  }
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn bootstrap_plan_accepted_hash_pins_projectable_ok() -> Bool {
  match bootstrap_plan {
    Accepted { value: plan, diagnostics: _ } => bootstrap_plan_accepted_hash_pins_projectable(plan: plan)
    Rejected { diagnostics: _ } => false
  }
}

data bootstrap_plan_accepted_hash_pins_projectable_witness: Bool = bootstrap_plan_accepted_hash_pins_projectable_ok()

fn bootstrap_projection_closure_node(inputs: BootstrapProjectionInputs) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      v2.std.node.Edge {
        label: Named { name: ^bootstrap_projection_snapshot_root_edge },
        target: inputs.snapshot.root
      },
      v2.std.node.Edge {
        label: Named { name: ^bootstrap_projection_snapshot_language_model_edge },
        target: language_model_to_node(lm: inputs.snapshot.language_model)
      },
      v2.std.node.Edge {
        label: Named { name: ^bootstrap_projection_snapshot_content_hash_edge },
        target: bootstrap_projection_snapshot_content_hash_pin_node(pin: inputs.snapshot.content_hash.pin)
      },
      v2.std.node.Edge {
        label: Named { name: ^bootstrap_projection_target_bundle_edge },
        target: inputs.target_model.bundle
      },
      v2.std.node.Edge {
        label: Named { name: ^bootstrap_projection_runtime_identity_edge },
        target: bootstrap_projection_runtime_identity_node(runtime: inputs.runtime_model)
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn bootstrap_projection_inputs_well_formed(inputs: BootstrapProjectionInputs) -> Bool {
  (inputs.snapshot.root == bootstrap_source_snapshot_root())
    && (inputs.snapshot.language_model == seed_capability_language_model())
    && (inputs.snapshot.content_hash == bootstrap_canonical_snapshot_content_hash())
    && (inputs.target_model == rust_target_model())
    && (inputs.runtime_model == v2_evaluator_runtime())
}

fn bootstrap_footprint(inputs: BootstrapProjectionInputs) -> Witness<BootstrapFootprint> {
  let closure_hash = content_hash(n: bootstrap_projection_closure_node(inputs: inputs))
  let constructs = bootstrap_footprint_constructs_from_projection_inputs(inputs: inputs)
  if bootstrap_projection_inputs_well_formed(inputs: inputs)
       && bootstrap_construct_inventory_unique(constructs: constructs) {
    v2.std.witness.Holds {
      value: BootstrapFootprint {
        inputs: inputs,
        closure_hash: closure_hash,
        constructs: constructs
      }
    }
  } else {
    v2.std.witness.Violates { diagnostic: bs_diagnostic(reason: ^bootstrap_footprint_not_realized) }
  }
}

fn bootstrap_seed_capability_matches_footprint(
  footprint: Witness<BootstrapFootprint>,
  capability: SeedCapability
) -> Witness<BootstrapCapabilityExact> {
  match footprint {
    Holds { value: fp } =>
      if bootstrap_construct_inventory_unique(constructs: capability.constructs)
           && bootstrap_constructs_eq(left: fp.constructs, right: capability.constructs) {
        v2.std.witness.Holds { value: BootstrapCapabilityExact { footprint: fp, capability: capability } }
      } else {
        v2.std.witness.Violates { diagnostic: bs_diagnostic(reason: ^bootstrap_capability_not_minimal) }
      }
    Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
  }
}

fn bootstrap_convergence_ladder(plan: v2.std.diagnostic.Outcome<BootstrapPlan>) -> Witness<ConvergenceLadder> {
  match plan {
    Accepted { value: bp, diagnostics: _ } =>
      v2.std.witness.Holds { value: ConvergenceLadder { entry_seed: ^v1_pipeline, plan: bp, fixed_point: bp.fixpt } }
    Rejected { diagnostics: _ } =>
      v2.std.witness.Violates { diagnostic: bs_diagnostic(reason: ^bootstrap_plan_unavailable_for_ladder) }
  }
}

fn independent_compiler_pair_witness(
  primary: v2.std.node.Symbol,
  secondary: v2.std.node.Symbol,
  evidence: IndependentCompilerEvidence
) -> Witness<IndependentCompilerPair> {
  match evidence {
    IndependentCompilerEvidenceUnavailable { correction: _ } =>
      v2.std.witness.Violates { diagnostic: bs_diagnostic(reason: ^bootstrap_diverse_compilation_mismatch) }
  }
}

fn seed_self_verify_check(
  claim: DiverseCompilationRun,
  check: DiverseCompilationRun
) -> v2.std.diagnostic.Outcome<v2.workflow.bootstrap.SeedSelfVerifyReceipt> {
  if claim.output == check.output {
    v2.std.diagnostic.Rejected {
      diagnostics: diagnostics_singleton(
        d: bs_diagnostic(reason: ^bootstrap_self_verify_same_artifact)
      )
    }
  } else if !(claim.source == check.source)
    || !(claim.compiler == check.compiler)
    || !(claim.output_hash.pin == check.output_hash.pin) {
    v2.std.diagnostic.Rejected {
      diagnostics: diagnostics_singleton(
        d: bs_diagnostic(reason: ^bootstrap_self_verify_provenance_mismatch)
      )
    }
  } else if !(claim.output_hash.digest == check.output_hash.digest) {
    v2.std.diagnostic.Rejected {
      diagnostics: diagnostics_singleton(
        d: bs_diagnostic(reason: ^bootstrap_self_verify_diverged)
      )
    }
  } else {
    v2.std.diagnostic.Accepted {
      value: v2.workflow.bootstrap.SeedSelfVerifyReceipt { claim: claim, check: check },
      diagnostics: v2.std.diagnostic.None
    }
  }
}

fn diverse_compilation_agreement_witness(
  primary: DiverseCompilationRun,
  secondary: DiverseCompilationRun,
  independent_compilers: Witness<IndependentCompilerPair>,
  evidence: IndependentCompilerEvidence,
  agreed_hash: BootstrapHashPin
) -> Witness<DiverseCompilationAgreement> {
  match evidence {
    IndependentCompilerEvidenceUnavailable { correction: _ } =>
      v2.std.witness.Violates { diagnostic: bs_diagnostic(reason: ^bootstrap_diverse_compilation_mismatch) }
  }
}

fn bootstrap_seed_honesty_discharge_witness(
  axiom: v2.std.node.Symbol,
  diverse_double_compilation: Witness<DiverseCompilationAgreement>
) -> Witness<SeedHonestyDischarge> {
  match diverse_double_compilation {
    Holds { value: _ } =>
      v2.std.witness.Violates { diagnostic: bs_diagnostic(reason: ^bootstrap_diverse_compilation_mismatch) }
    Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
  }
}

fn bootstrap_fixpt_witness(f: FixptStage1Stage2) -> Witness<FixptStage1Stage2> {
  if (f.left == ^v2_stage1_binary)
       && (f.right == ^v2_stage2_binary)
       && (f.left_hash.pin == ^v2_stage1_hash_pin)
       && (f.right_hash.pin == ^v2_stage2_hash_pin)
       && (f.pinned_hash.pin == ^pinned_v4_fixed_point_hash_pin)
       && (f.left_hash.digest == f.right_hash.digest)
       && (f.pinned_hash.digest == f.left_hash.digest) {
    v2.std.witness.Holds { value: f }
  } else {
    v2.std.witness.Violates { diagnostic: bs_diagnostic(reason: ^bootstrap_mis_wired) }
  }
}

data seed_capability: SeedCapability = SeedCapability {
  language_model: seed_capability_language_model(),
  constructs: bootstrap_footprint_constructs_from_node(root: bootstrap_seed_capability_inventory_root()),
  frozen_at: ^bootstrap_phase1_frozen_submodel
}

data bootstrap_projection_inputs: BootstrapProjectionInputs = BootstrapProjectionInputs {
  snapshot: BootstrapSourceSnapshot {
    root: bootstrap_source_snapshot_root(),
    language_model: seed_capability_language_model(),
    content_hash: bootstrap_canonical_snapshot_content_hash()
  },
  target_model: rust_target_model(),
  runtime_model: v2_evaluator_runtime()
}

type BootstrapEvaluatorCorpusHarnessEntry {
  runtime_model: v2.extdeps.runtimes.v2_evaluator.V4EvaluatorRuntime
  stage0_binary: v2.std.node.Symbol
  source_root: v2.std.node.Symbol
  entry_fn: v2.std.node.Symbol
  entry_module: v2.std.node.Symbol
}

fn bootstrap_evaluator_corpus_harness_entry() -> BootstrapEvaluatorCorpusHarnessEntry {
  BootstrapEvaluatorCorpusHarnessEntry {
    runtime_model: v2_evaluator_runtime(),
    stage0_binary: ^v2_stage0_binary,
    source_root: ^v2_dag_source,
    entry_fn: ^run_manual_testclaim_corpus_eval,
    entry_module: ^v2_test_claim_workflow_testclaim_corpus_runner
  }
}

fn bootstrap_evaluator_corpus_harness_well_formed(entry: BootstrapEvaluatorCorpusHarnessEntry) -> Bool {
  (entry.runtime_model == v2_evaluator_runtime())
    && (entry.stage0_binary == ^v2_stage0_binary)
    && (entry.source_root == ^v2_dag_source)
    && (entry.entry_fn == ^run_manual_testclaim_corpus_eval)
    && (entry.entry_module == ^v2_test_claim_workflow_testclaim_corpus_runner)
}

data bootstrap_manual_corpus_harness: BootstrapEvaluatorCorpusHarnessEntry = bootstrap_evaluator_corpus_harness_entry()

data witness_bootstrap_evaluator_corpus_harness_well_formed: Bool = bootstrap_evaluator_corpus_harness_well_formed(entry: bootstrap_manual_corpus_harness)

data bootstrap_footprint_witness: Witness<BootstrapFootprint> = bootstrap_footprint(inputs: bootstrap_projection_inputs)

data bootstrap_seed_capability_gate: Witness<BootstrapCapabilityExact> = bootstrap_seed_capability_matches_footprint(
  footprint: bootstrap_footprint_witness,
  capability: seed_capability
)

data bootstrap_physical_axiom: PhysicalExecutionAxiom = PhysicalExecutionAxiom {
  machine_model: ^physical_machine_model_axiom,
  executes_as_modeled: ^physical_machine_executes_isa_as_modeled
}

data bootstrap_seed_honesty_discharge: Witness<SeedHonestyDischarge> = bootstrap_seed_honesty_discharge_witness(
  axiom: ^seed_honesty_axiom,
  diverse_double_compilation: diverse_compilation_agreement_witness(
    primary: DiverseCompilationRun {
      source: ^v2_dag_source,
      compiler: ^v1_pipeline,
      output: ^diverse_compile_fixed_point_output,
      output_hash: BootstrapHashPin { digest: pinned_v4_fixed_point_hash, pin: ^pinned_v4_fixed_point_hash_pin }
    },
    secondary: DiverseCompilationRun {
      source: ^v2_dag_source,
      compiler: ^independent_compiler_witness,
      output: ^diverse_compile_fixed_point_output,
      output_hash: BootstrapHashPin { digest: pinned_v4_fixed_point_hash, pin: ^pinned_v4_fixed_point_hash_pin }
    },
    independent_compilers: independent_compiler_pair_witness(
      primary: ^v1_pipeline,
      secondary: ^independent_compiler_witness,
      evidence: independent_compiler_evidence_unavailable()
    ),
    evidence: independent_compiler_evidence_unavailable(),
    agreed_hash: BootstrapHashPin { digest: pinned_v4_fixed_point_hash, pin: ^pinned_v4_fixed_point_hash_pin }
  )
)

fn bootstrap_stage_output(plan: v2.std.diagnostic.Outcome<BootstrapPlan>, s: v2.std.node.Symbol) -> Bool {
  match plan {
    Accepted { value: bp, diagnostics: _ } =>
      (s == bp.seed.produces) || (s == bp.self0.produces) || (s == bp.self1.produces)
    Rejected { diagnostics: _ } => false
  }
}

fn bootstrap_plan_well_formed(p: BootstrapPlan) -> v2.std.diagnostic.Outcome<BootstrapPlan> {
  match bootstrap_fixpt_witness(f: p.fixpt) {
    Holds { value: _ } =>
      if bs_list_eq(a: p.seed.consumes, b: [^v2_dag_source])
           && (p.seed.produces == ^v2_stage0_binary)
           && (p.seed.compiled_by == ^v1_pipeline)
           && bs_list_eq(a: p.self0.consumes, b: [^v2_dag_source, ^v2_stage0_binary])
           && (p.self0.produces == ^v2_stage1_binary)
           && (p.self0.compiled_by == ^v2_stage0_binary)
           && bs_list_eq(a: p.self1.consumes, b: [^v2_dag_source, ^v2_stage1_binary])
           && (p.self1.produces == ^v2_stage2_binary)
           && (p.self1.compiled_by == ^v2_stage1_binary)
           && (p.seed.produces_hash.pin == ^v2_stage0_hash_pin)
           && (p.self0.produces_hash.pin == ^v2_stage1_hash_pin)
           && (p.self1.produces_hash.pin == ^v2_stage2_hash_pin)
           && (p.self0.produces_hash.digest == p.self1.produces_hash.digest)
           && (p.fixpt.left_hash.digest == p.self0.produces_hash.digest)
           && (p.fixpt.right_hash.digest == p.self1.produces_hash.digest)
           && (p.fixpt.pinned_hash.digest == p.self0.produces_hash.digest) {
        v2.std.diagnostic.Accepted { value: p, diagnostics: v2.std.diagnostic.None }
      } else {
        v2.std.diagnostic.Rejected { diagnostics: diagnostics_singleton(d: bs_diagnostic(reason: ^bootstrap_mis_wired)) }
      }
    Violates { diagnostic: d } => v2.std.diagnostic.Rejected { diagnostics: diagnostics_singleton(d: d) }
  }
}

data bootstrap_plan_fixpt_digest_mismatch_rejects: Outcome<BootstrapPlan> = bootstrap_plan_well_formed(p: BootstrapPlan {
  seed: CompileStage {
    consumes: [^v2_dag_source],
    produces: ^v2_stage0_binary,
    produces_hash: BootstrapHashPin { digest: v2_stage0_hash, pin: ^v2_stage0_hash_pin },
    compiled_by: ^v1_pipeline
  },
  self0: CompileStage {
    consumes: [^v2_dag_source, ^v2_stage0_binary],
    produces: ^v2_stage1_binary,
    produces_hash: BootstrapHashPin { digest: v2_stage1_hash, pin: ^v2_stage1_hash_pin },
    compiled_by: ^v2_stage0_binary
  },
  self1: CompileStage {
    consumes: [^v2_dag_source, ^v2_stage1_binary],
    produces: ^v2_stage2_binary,
    produces_hash: BootstrapHashPin { digest: v2_stage2_hash, pin: ^v2_stage2_hash_pin },
    compiled_by: ^v2_stage1_binary
  },
  fixpt: FixptStage1Stage2 {
    left: ^v2_stage1_binary,
    left_hash: BootstrapHashPin { digest: v2_stage1_hash, pin: ^v2_stage1_hash_pin },
    right: ^v2_stage2_binary,
    right_hash: BootstrapHashPin { digest: v2_stage2_hash, pin: ^v2_stage2_hash_pin },
    pinned_hash: BootstrapHashPin { digest: pinned_v4_fixed_point_hash, pin: ^pinned_v4_fixed_point_hash_pin }
  }
})

data bootstrap_plan: v2.std.diagnostic.Outcome<BootstrapPlan> = bootstrap_plan_well_formed(p: BootstrapPlan {
  seed: CompileStage {
    consumes: [^v2_dag_source],
    produces: ^v2_stage0_binary,
    produces_hash: BootstrapHashPin { digest: v2_stage0_hash, pin: ^v2_stage0_hash_pin },
    compiled_by: ^v1_pipeline
  },
  self0: CompileStage {
    consumes: [^v2_dag_source, ^v2_stage0_binary],
    produces: ^v2_stage1_binary,
    produces_hash: BootstrapHashPin { digest: v2_stage1_hash, pin: ^v2_stage1_hash_pin },
    compiled_by: ^v2_stage0_binary
  },
  self1: CompileStage {
    consumes: [^v2_dag_source, ^v2_stage1_binary],
    produces: ^v2_stage2_binary,
    produces_hash: BootstrapHashPin { digest: v2_stage1_hash, pin: ^v2_stage2_hash_pin },
    compiled_by: ^v2_stage1_binary
  },
  fixpt: FixptStage1Stage2 {
    left: ^v2_stage1_binary,
    left_hash: BootstrapHashPin { digest: v2_stage1_hash, pin: ^v2_stage1_hash_pin },
    right: ^v2_stage2_binary,
    right_hash: BootstrapHashPin { digest: v2_stage1_hash, pin: ^v2_stage2_hash_pin },
    pinned_hash: BootstrapHashPin { digest: v2_stage1_hash, pin: ^pinned_v4_fixed_point_hash_pin }
  }
})

data bootstrap_convergence_ladder_witness: Witness<ConvergenceLadder> = bootstrap_convergence_ladder(plan: bootstrap_plan)

data bootstrap_plan_fixpt_witness: Witness<FixptStage1Stage2> = match bootstrap_plan {
  Accepted { value: bp, diagnostics: _ } => bootstrap_fixpt_witness(f: bp.fixpt)
  Rejected { diagnostics: nd } => v2.std.witness.Violates { diagnostic: nd.head }
}
