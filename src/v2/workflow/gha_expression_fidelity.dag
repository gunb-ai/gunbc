module v2.workflow.gha_expression_fidelity


fn gha_expression_core_roundtrip_fidelity() -> Outcome<DecodeFidelity> {
  decode_fidelity_from_target(target: gha_expression_roundtrip_target_model())
}

fn gha_expression_core_advertises_lossless() -> Bool {
  match gha_expression_core_roundtrip_fidelity() {
    Accepted { value: fidelity, diagnostics: _ } =>
      match fidelity {
        Lossless => true
        Lossy => false
      }
    Rejected { diagnostics: _ } => false
  }
}
