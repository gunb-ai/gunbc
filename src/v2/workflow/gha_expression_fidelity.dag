module v2.workflow.gha_expression_fidelity


fn gha_expression_core_roundtrip_fidelity() -> v2.std.diagnostic.Outcome<extdeps.communication.medium.DecodeFidelity> {
  v2.compiler.target_carriers.decode_fidelity_from_target(target: v2.extdeps.github.expression_fidelity.gha_expression_roundtrip_target_model())
}

fn gha_expression_core_advertises_lossless() -> Bool {
  match gha_expression_core_roundtrip_fidelity() {
    v2.std.diagnostic.Accepted { value: fidelity, diagnostics: _ } =>
      match fidelity {
        extdeps.communication.medium.Lossless => true
        extdeps.communication.medium.Lossy => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}
