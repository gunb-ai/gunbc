module v2.workflow.floor_preparation_capture_runner

// THE CAPTURE RUNNER, MODELLED. This module is the re-derivation entry point the node's handback
// names, and it replaces the hand-written shell that used to drive the preparation measurement.
// Per the lane ruling (royal-newt-240: HOLD on any shell scaffold), every step that DECIDES lives
// here as .dag, and the three operations an earlier escalation called "residues" are realized on
// admitted extdeps surfaces rather than in a script:
//
//   (a) invoking the pinned binaries and reading real exit codes -- shell.Exec.RunArgv, a declared
//       service operation whose realization spawns the process and returns exit_code / stdout /
//       stderr as typed output (dag/extdeps/shell/exec.dag); the wet witnesses
//       (dag/test/claim/cursor_runtime_root_wet_witness.dag, dag/test/claim/
//       dispatch_credential_acquisition_witness.dag) establish this surface executes for real;
//   (b) acquiring and releasing the machine-wide heavy slot -- RunArgv on /usr/bin/env carrying
//       HEAVY_OWNER=<session> as an argv environment binding with $HOME/bin/heavy-slot as the next
//       word, so the slot wrapper is the outermost program of every leg and the evidence rule's
//       "exported outside and before heavy-slot" is satisfied by construction;
//   (c) moving bytes from run output into artifact files -- Filesystem.Read / Filesystem.Write
//       (dag/extdeps/filesystem/filesystem_io.dag).
//
// WORKFLOW, NOT AN INSTRUMENT (gunbc.design_ruling::instrument_is_a_row_not_a_flag asked and
// answered here): this module adds no measurement program -- it spawns NO new binary and makes no
// measurement of its own. Every verdict it reads comes from instruments already rostered as rows
// of gunbc.instrument_targets through gunbc.target_binding TargetProducers (claim_batch and the
// v2-native gunbc, the same instruments the required floor workflow drives, itself a workflow and
// not a row). Its own three duties are not measurements: supply verification (digests below),
// slot acquisition through the machine limiter, and byte movement. The ruling's three naming
// duties are named where they bind: real consumer = the 22-claim roster in
// dag/test/claim/floor/floor_preparation_split_witness.dag plus this node's fold; discriminator =
// the red control (a planted floor-claim break is refused on the landing revision, raw in the
// EXECUTION-BLOCK); acceptable cost = the wall bounds on the leg receipts, executed on the
// heavy-slot limiter. Adding a NEW producer arm for this module would require a Rust seed change,
// outside this node's authority, and is not warranted: there is no new program to address.
//
// There is no bash script. Re-deriving the split is one command a reader can paste (layout from
// the caller's environment, see the required variables below):
//
//   gunbc run --source-root dag --source-root src/v1 --source-root src/v2 \
//     --entry src/v2/workflow/floor_preparation_capture_runner.dag \
//     --function floor_preparation_capture_run
//
// run from the checkout the pins point at. The split itself is read by the fold in
// `v2.workflow.floor_preparation_split`, which this module calls and never reimplements: the shell
// that used to fold at module grain in its own vocabulary is gone, and the fold is one function.

import std.types { Bool, Int, List, Present, Absent, String }
import std.algebra { length, list_push }
import std.measure { Millisecond, millisecond, millisecond_count, ByteSize, byte_size, byte_size_count, Second, second, second_count }
import std.checked_arithmetic { checked_int_to_nat }
import extdeps.shell
import extdeps.shell.exec
import extdeps.filesystem.filesystem_io { Filesystem }
import v2.workflow.floor_preparation_split {
  floor_preparation_strip_prefix,
  floor_preparation_strip_suffix,
  floor_preparation_has_exact_row,
  floor_preparation_any_row_starts_with,
  floor_preparation_split_report,
  floor_preparation_ask,
  floor_preparation_report_sentinel,
  floor_preparation_report_prefix,
  floor_preparation_classify_report_line,
  floor_preparation_contains,
  FloorPreparationPopulationRow,
  floor_preparation_population_rows,
  floor_preparation_pass_prefix,
  floor_preparation_fail_prefix,
  floor_preparation_unobserved_prefix,
  floor_preparation_witness_prefix,
  floor_preparation_cause_refused,
  floor_preparation_cause_unobserved,
  floor_preparation_cause_no_verdict,
  floor_preparation_graded_disposition,
  floor_preparation_excluded_disposition
}
import v2.workflow.floor_preparation_diff_scope {
  floor_preparation_scope_line_parse,
  floor_preparation_scope_planned_entries,
  FloorPreparationScopePlanned,
  Planned,
  Refused,
}

// ----------------------------------------------------------------------------------------------
// SUPPLY DATA. Paths and digests the measurement is pinned to. One authority, read by every leg;
// the digests are NOT trusted from here -- each is recomputed from disk at run time by sha256sum
// through RunArgv and compared to these values, and the run refuses before spawning any leg when
// a supply disagrees, is 0 bytes, or hashes to the empty-string digest. The model's PIN is the
// authority; agreement with a locally-held copy of release-bins.manifest is CORROBORATION only,
// so the receipt renders the manifest as a token -- `manifest=matched` when the local line equals
// the recomputed digest, `manifest=absent` when no line exists -- never as a claim that the
// manifest was consulted when it was not. No release-bins.manifest ships in the repo and no
// downloadable release-bins artifact exists on main today, so "manifest-pinned" is never claimed:
// the binaries are release-bins UNPACKED, pinned by the values below, cross-checked against the
// caller-supplied manifest copy when one is present. A 0-byte download that exits 0 has fooled this lane; the byte count is checked beside
// the digest for exactly that reason.
// ----------------------------------------------------------------------------------------------

// No operator path, no session id, and NO host layout is written into this module -- not even as
// a fallback (reviews 97807 / 97828 / 97845 / 97851 converged here): layout is workflow policy,
// and policy enters only through the caller's environment, which is the parameter channel for an
// entry point that takes no argv. The caller MUST set: FLOOR_CHECKOUT (the checkout under
// measurement), FLOOR_HEAVY_SLOT (the shared limiter's location), FLOOR_CLAIM_BATCH, FLOOR_GUNBC
// (the pinned release binaries, release-bins UNPACKED -- the model pins are the authority) and
// FLOOR_MANIFEST (a copy of release-bins.manifest used only for cross-checking; a supply whose
// manifest has no line for it renders manifest=absent, never a fabricated match); HEAVY_OWNER carries the slot attribution, and the limiter itself refuses an unset
// owner with exit 64, so no leg can run unattributed. When a required variable is unset the run
// refuses on the verify-pinned-supplies receipt NAMING the variables -- no invented default can
// quietly point a measurement at the wrong tree. The pasteable entry point therefore carries its
// layout from the caller's shell, e.g. on the shared host:
//
//   export FLOOR_CHECKOUT=$HOME/scratch/$HEAVY_OWNER/pr \
//     FLOOR_HEAVY_SLOT=$HOME/bin/heavy-slot \
//     FLOOR_CLAIM_BATCH=$HOME/scratch/$HEAVY_OWNER/bin/unpacked/claim_batch \
//     FLOOR_GUNBC=$HOME/scratch/$HEAVY_OWNER/bin/unpacked/gunbc \
//     FLOOR_LEG_DRIVER=$HOME/scratch/$HEAVY_OWNER/bin/eagle-leg-driver-v3 \
//     FLOOR_MANIFEST=$HOME/scratch/$HEAVY_OWNER/bin/bins/release-bins.manifest
//   gunbc run --source-root dag --source-root src/v1 --source-root src/v2 \
//     --entry src/v2/workflow/floor_preparation_capture_runner.dag \
//     --function floor_preparation_capture_run
//
// The leg driver is this fixed text (its sha256 is the pinned supply value above; recreate with
// cat > "$FLOOR_LEG_DRIVER" exactly, chmod +x, and the supply gate re-derives the sha at run time):
//
//   #!/usr/bin/sh
//   LOG="$1"
//   shift
//   : > "$LOG"
//   exec >>"$LOG" 2>&1 "$@"
//
// The digests below pin the RELEASE, not a machine, so a reader on any host re-derives the split
// against the same release.
fn floor_preparation_env_value(name: String) -> String {
  let ran = floor_preparation_spawn_plain(binary: "/usr/bin/printenv", args: [name])
  match floor_preparation_lines(text: ran.stdout).first() {
    Present { value: v } => v
    Absent {} => ""
  }
}

fn floor_preparation_session_owner() -> String {
  floor_preparation_env_value(name: "HEAVY_OWNER")
}

fn floor_preparation_required_env_missing() -> String {
  let missing = filter(
    ["FLOOR_CHECKOUT", "FLOOR_HEAVY_SLOT", "FLOOR_CLAIM_BATCH", "FLOOR_GUNBC", "FLOOR_MANIFEST", "FLOOR_LEG_DRIVER", "HEAVY_OWNER"],
    predicate: fn(v) { floor_preparation_env_value(name: v) == "" })
  if length(xs: missing) > 0 { join(missing, ",") } else { "" }
}

fn floor_preparation_runner_root() -> String {
  floor_preparation_env_value(name: "FLOOR_CHECKOUT")
}

fn floor_preparation_heavy_slot_binary() -> String {
  floor_preparation_env_value(name: "FLOOR_HEAVY_SLOT")
}

fn floor_preparation_pinned_claim_batch() -> String {
  floor_preparation_env_value(name: "FLOOR_CLAIM_BATCH")
}

fn floor_preparation_pinned_gunbc() -> String {
  floor_preparation_env_value(name: "FLOOR_GUNBC")
}

fn floor_preparation_manifest_path() -> String {
  floor_preparation_env_value(name: "FLOOR_MANIFEST")
}

fn floor_preparation_leg_driver_binary() -> String {
  floor_preparation_env_value(name: "FLOOR_LEG_DRIVER")
}


data floor_preparation_timeout_binary: String = "/usr/bin/timeout"

data floor_preparation_env_binary: String = "/usr/bin/env"

// The pty wrapper that writes a leg's complete stream to disk (see spawn_slot_captured).

data floor_preparation_sha256_binary: String = "/usr/bin/sha256sum"

data floor_preparation_pinned_claim_batch_sha: String =
  "b395a556775931296f8f8aa8b9307f304d34442579f88d749189e273a4b0aee5"

data floor_preparation_pinned_gunbc_sha: String =
  "3283cc8aeccd690d175a349d23eacd2c2a5d4c8215557dcdadad4f703bed6e7f"

// THE LEG DRIVER (run9e). The seed's RunArgv host keeps stdout to 8 MiB but reduces STDERR to a
// 16 KiB TAIL (v1_interpreter.rs MAX_STDERR_TRACE = 16384, measured 2026-11-26: a leg's early
// [floor-phase] lines were gone from the in-memory stream while its PASS lines -- stdout, not
// tailed -- survived). The phase lines ARE the measurement, so a leg must write its COMPLETE
// stream to disk itself. /usr/bin/script cannot do it in argv form (util-linux 2.39.3 rejects
// `script -qef LOG -- CMD` outright; the -c form would route every leg argument through a shell
// string -- a second authority over argv, refused). The driver is a pinned, sha256-verified
// supply like claim_batch: argv[1] is the log path, the rest is program+arguments passed verbatim
// to exec with the streams appended to that file. No shell string is built from leg data; the
// driver is a fixed lane tool, not generated text, and a tampered driver cannot fake the verdict
// lines the census claim cross-checks against the retained log. v3 (the pinned sha below) also
// enforces the claim_batch pin AT THE LEG LAYER -- the leg refuses (exit 97) rather than exec a
// claim_batch whose on-disk sha256 is not the model's pinned release -- and prints the
// acquisition-identity block (pid/owner, cgroup, HEAD/TREE/TRACKED_DIRTY with tracked dirt only
// per the repo_self_build.dag:302-311 doctrine, and sha256+bytes of every file operand) from the
// leg's own process, so the log itself carries what the leg judged.
data floor_preparation_pinned_leg_driver_sha: String =
  "c09c3bf1754104cf0871e2eff617f7234c22f4b8322db003213c9a782a80da3c"

data floor_preparation_source_roots: List<String> = ["dag", "src/v1", "src/v2"]

data floor_preparation_witness_module: String =
  "dag/test/claim/floor/floor_preparation_split_witness.dag"

data floor_preparation_authority_path: String = "src/v2/workflow/floor_preparation_split.dag"


data floor_preparation_retained_file: String =
  "dag/test/claim/floor/floor_preparation_split_retained.txt"

data floor_preparation_empty_sha: String =
  "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"

data floor_preparation_block_begin: String = "BEGIN GENERATED CAPTURE BLOCK"

data floor_preparation_block_end: String = "END GENERATED CAPTURE BLOCK"

// Transport keeps, as MODEL DATA. The shell carried this as a grep regex; the fold classifies
// what these rows are, and this list only decides which stdout lines are retained. A row the fold
// must see that no keep matches is a runner defect, and the fold refusing such a row catches it.
data floor_preparation_keep_prefixes: List<String> = [
  "[floor-phase] ", "[resolve] ", "[witness] ", "[floor-reach-probe] ", "[floor-shared-fill] ",
  "PASS ", "FAIL ", "UNOBSERVED ", "claim_batch: resolving "
]

// timeout(1) enforces these as a real process, and exit 124 is reported as a KILL and never as
// a refusal -- a wall-clock timeout is not gunbc refusing.
// WALL BOUNDS ARE TYPED DURATIONS, not bare Ints. run8 is the cautionary artifact: a Millisecond
// number was handed where seconds were wanted and `timeout 2400000` meant 27 days -- no bound at
// all, wearing the costume of one. DESIGN gunbc.design_argument::single_authority assigns durations
// to the shared quantity model (std.measure::Second), so a bound CANNOT be a unitless number here;
// the seconds spelling exists only at the timeout(1) transport, one checked conversion away, and an
// operand large enough to be a milliseconds number smuggled in is REFUSED there rather than obeyed.

fn floor_preparation_untrimmed_bound() -> Second {
  second(count: 14400)
}

fn floor_preparation_graded_bound() -> Second {
  // run9o: the graded leg carried 11 entry groups in ONE claim_batch invocation and was killed
  // at the bound -- its provenance line printed rc=124 kept_rows=97. A timeout is the transport
  // ending the process, not gunbc refusing: not a verdict, and it truncates the very evidence the
  // census and cache witnesses read. The graded leg re-runs every entry that carries a passing
  // claim, so its population tracks the untrimmed one -- it gets the same order of bound.
  second(count: 10800)
}

fn floor_preparation_claims_bound() -> Second {
  second(count: 900)
}

fn floor_preparation_report_bound() -> Second {
  second(count: 600)
}

// THE ONE CHECKED CONVERSION to the timeout(1) transport. A bound is meaningful only inside
// [1, one day) of seconds: 0 means no bound, and anything a day or longer is the run8 shape -- a
// milliseconds figure that lost its units on the way here. Absent is a typed refusal; the caller
// refuses the leg rather than spawning an unbounded process.
fn floor_preparation_bound_operand(bound: Second) -> Optional<String> {
  let n = second_count(s: bound)
  if n < 1 {
    Absent
  } else {
    if n > 86399 {
      Absent
    } else {
      Present { value: to_string(n) }
    }
  }
}

// A refused bound is reported as what it is: a leg that cannot run, with the bound's own digits in
// the cause. Never a verdict about the claims.
fn floor_preparation_bound_refused(bound: Second) -> FloorPreparationSpawnObservation {
  FloorPreparationSpawnObservation {
    rc: 97,
    stdout: "",
    stderr: concat("bound refused: ", concat(to_string(second_count(s: bound)),
      " seconds is outside [1,86400) -- a wall bound this large or small is a unit error, not a bound")),
  }
}

