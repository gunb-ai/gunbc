// The runner's own steps, as data. The witness binds these names to code paths in this module by
// requiring each step's receipt line to appear in a run; no marker comments, no grep of a script.

data floor_preparation_runner_modelled_steps: List<String> = [
  "verify-pinned-supplies", "build-argv-from-population", "leg-untrimmed",
  "derive-pass-set", "leg-graded", "fold-legs", "write-retained", "splice-capture-rows",
  "claim-gate", "report-print", "terminal-gate"
]

type FloorPreparationSpawnObservation {
  rc: Int,
  stdout: String,
  stderr: String,
}

// TYPED VERDICT CARRIERS (review 97909). A supply check and a leg each decide their Bool in
// model code and carry it as a FIELD; the gates fold over the fields, never over rendered prose.
// The String forms below are print-boundary renderers only. Optional readings name their
// absence: an unreadable checksum or count is Absent, rendered SHA_UNREADABLE / BYTES_UNREADABLE.
type FloorPreparationSupplyReceipt {
  name: String,
  digest: Optional<String>,
  bytes: Optional<ByteSize>,
  manifest: String,
  expected: String,
  admitted: Bool,
}

// Typed resolve outcome for a claim_batch leg. Resolved carries the resolve banner verbatim
// (module count included); ResolveFailed carries the error and cause lines; NotObserved means
// the leg produced no resolve signal at all -- never clean.
type FloorPreparationResolveOutcome
  = Resolved { banner: String }
  | ResolveFailed { cause: String }
  | NotObserved {}

type FloorPreparationLegReceipt {
  label: String,
  entries_joined: String,
  rc: Int,
  binary: String,
  digest: Optional<String>,
  bytes: Optional<ByteSize>,
  tree_sha: String,
  kept_count: Int,
  verdict_count: Int,
  resolve: FloorPreparationResolveOutcome,
  out_bytes: Optional<ByteSize>,
  clean: Bool,
}

// ----------------------------------------------------------------------------------------------
// TEXT PRIMITIVES. The language carries split; prefix and membership are defined once, here, and
// every gate below reads through them.
// ----------------------------------------------------------------------------------------------

fn floor_preparation_lines(text: String) -> List<String> {
  fold(split(s: text, delimiter: "\n"), init: [], f: (acc, line) =>
    if line == "" { acc } else { list_push(xs: acc, item: line) })
}

fn floor_preparation_first_token(line: String) -> String {
  match split(s: line, delimiter: " ").first() {
    Present { value: v } => v
    Absent {} => line
  }
}



fn floor_preparation_kept_line(line: String) -> Bool {
  fold(floor_preparation_keep_prefixes, init: false, f: (acc, prefix) =>
    acc || starts_with(s: line, prefix: prefix))
}

fn floor_preparation_kept(text: String) -> List<String> {
  fold(floor_preparation_lines(text: text), init: [], f: (acc, line) =>
    if floor_preparation_kept_line(line: line) { list_push(xs: acc, item: line) } else { acc })
}

// ----------------------------------------------------------------------------------------------
// THE SPAWN SURFACE. Every slot-bound leg arrives as
//   timeout <secs> env HEAVY_OWNER=<session> heavy-slot <binary> <args...>
// through shell.Exec.RunArgv; heavy-slot forwards the command's exit status and timeout forwards
// it too, so the observation's rc IS the leg's rc. Supply probes run WITHOUT the slot: a
// sha256sum needs no heavy slot, and holding one to hash a file is how a lane starves.
// ----------------------------------------------------------------------------------------------

// One place builds the slot-bound argv; the observation fields are copied into this module's own
// type at the boundary so the runner's dataflow never depends on the operation's record shape.
fn floor_preparation_spawn_slot(bound: Second, binary: String, args: List<String>) -> FloorPreparationSpawnObservation {
  match floor_preparation_bound_operand(bound: bound) {
    Absent => floor_preparation_bound_refused(bound: bound)
    Present { value: operand } =>
      let ran = shell.Exec.RunArgv(
        program: floor_preparation_timeout_binary,
        arguments: concat(
          [operand, floor_preparation_env_binary,
           concat("HEAVY_OWNER=", floor_preparation_session_owner()),
           floor_preparation_heavy_slot_binary(), binary],
          args)
      )
      FloorPreparationSpawnObservation { rc: ran.exit_code, stdout: ran.stdout, stderr: ran.stderr }
  }
}

// FULL-STREAM CAPTURE (run8). The seed's host drain keeps stdout up to 8 MiB but reduces STDERR
// to a digest plus a 16 KiB TAIL (src/v1/stage0/src/bounded_shell_host_drain.rs), so a leg's
// in-memory stderr is a tail, not a transcript: run8's two whole-tree legs came back truncated
// at exactly 16383 bytes with their early pool-phase lines gone, and the in-memory streams could
// not be the fold's or the gate's input. Each claim_batch leg therefore runs under
// /usr/bin/script -qef LOG -- ... (util-linux, argv form -- no shell string is built), which
// writes the child's COMPLETE interleaved stream to a file in the checkout. -e forwards the
// child's exit status, so the observation's rc is still the leg's real rc, and the inner
// timeout(1) -- in SECONDS -- bounds claim_batch itself; the outer timeout guards a wedged pty.
fn floor_preparation_leg_log_path(label: String) -> String {
  concat(concat(floor_preparation_runner_root(), "/"), concat(label, ".log"))
}

fn floor_preparation_spawn_slot_captured(label: String, bound: Second, binary: String, args: List<String>) -> FloorPreparationSpawnObservation {
  match floor_preparation_bound_operand(bound: bound) {
    Absent => floor_preparation_bound_refused(bound: bound)
    Present { value: operand } =>
      let ran = shell.Exec.RunArgv(
        program: floor_preparation_timeout_binary,
        arguments: concat(
          [to_string(second_count(s: bound) + 300), floor_preparation_env_binary,
           concat("HEAVY_OWNER=", floor_preparation_session_owner()),
           floor_preparation_heavy_slot_binary(), binary],
          args)
      )
      // THE CAPTURE IS A MODELLED WRITE, NOT A PTY GRAFT (measured defect, srv1 2026-11-25). This spawn
      // used /usr/bin/script -qef LOG -- CMD; util-linux 2.39.3 rejects that form outright -- the command
      // needs -c, and a positional after -- is read as the TYPESCRIPT FILE ("unexpected number of
      // arguments"; reproduced standalone, rc=1, no log). The -c form would route every leg argument
      // through a shell string, a second authority over the argv this module builds as DATA -- refused.
      // The transcript is instead the run's own captured streams moved into the artifact file through
      // Filesystem.Write, the service header (c) already admits for exactly this job. Zero bytes still
      // means zero verdicts: every downstream hard-fail rule reads THIS file, so a missing capture stays
      // loud, and a CAPTURE_WRITE_FAILED marker rides the observation so a silent write loss cannot read
      // as an empty-but-honest run.
      let transcript = concat(ran.stdout, ran.stderr)
      let written = Filesystem.Write(path: floor_preparation_leg_log_path(label), content: transcript)
      FloorPreparationSpawnObservation {
        rc: ran.exit_code,
        stdout: ran.stdout,
        stderr: if written.success { ran.stderr } else { concat(ran.stderr, "\nCAPTURE_WRITE_FAILED") }
      }
  }
}

// A captured log is read back through the model's read effect; a pty adds carriage returns, so
// the transcript is normalized once here and every downstream parser sees plain lines. A failed
// read is the EMPTY stream -- verdicts and resolve markers then read absent and the leg is not
// clean, which is honest: a leg whose transcript cannot be read has not been observed.
fn floor_preparation_read_captured(label: String) -> String {
  let read = Filesystem.Read(path: floor_preparation_leg_log_path(label))
  let raw = if read.success { read.content } else { "" }
  join(fold(floor_preparation_lines(text: raw), init: [], f: (acc, line) =>
    list_push(xs: acc, item: match floor_preparation_strip_suffix(text: line, suffix: "\r") {
      Present { value: v } => v
      Absent {} => line
    })), "\n")
}

fn floor_preparation_spawn_plain(binary: String, args: List<String>) -> FloorPreparationSpawnObservation {
  let ran = shell.Exec.RunArgv(program: binary, arguments: args)
  FloorPreparationSpawnObservation { rc: ran.exit_code, stdout: ran.stdout, stderr: ran.stderr }
}

fn floor_preparation_receipt(step: String, detail: String) -> String {
  concat(concat("[runner-step] step=", step), concat(" detail=", detail))
}

// ----------------------------------------------------------------------------------------------
// SUPPLY INTEGRITY. sha256sum runs through the same spawn surface; the comparisons are model
// code, against BOTH the pinned value above and the release manifest line.
// ----------------------------------------------------------------------------------------------

// Absence is TYPED, never a fabricated "" or -1 (review 97872): a failed checksum command or an
// unparseable count returns Absent, and the supply gate refuses naming WHICH reading was absent.
fn floor_preparation_sha_of(path: String) -> String? {
  let outcome = floor_preparation_spawn_plain(
    binary: floor_preparation_sha256_binary,
    args: [path])
  let token = floor_preparation_first_token(outcome.stdout)
  if outcome.rc == 0 && token != "" { Present { value: token } } else { Absent {} }
}

fn floor_preparation_bytes_of(path: String) -> Optional<ByteSize> {
  let ran = floor_preparation_spawn_plain(binary: "/usr/bin/wc", args: ["-c", path])
  let token = floor_preparation_first_token(ran.stdout)
  match parse_int(s: token) {
    Present { value: n } => match checked_int_to_nat(n: n) {
      Present { value: k } => Present { value: byte_size(count: k) }
      Absent {} => Absent {}
    }
    Absent {} => Absent {}
  }
}

// The tree sha under measurement, read through the same spawn surface (no shell: argv direct).
// OBSERVED ON THIS HOST (run6, 2026-11-24, reproduced at head 59b1c8d with the pinned binaries):
// claim_batch PANICS (rc=101, src/v1/stage0/src/cli_run.rs:570) when its cwd is not inside a git
// checkout -- "workspace_root: ... is not inside a git checkout; run from the workspace (the
// compile-time CARGO_MANIFEST_DIR fallback was removed...)". A checkout materialized by `git
// archive` (no .git) therefore runs NO legs at all: every spawn dies at once with out_bytes=4641
// and zero verdicts, and the empty `TREE_SHA=GIT_TREE_UNREADABLE` above is the runner reading
// back the same absence. The runner route must be a real git checkout (clone + checkout of the
// head commit); these two probes then report the identity they are measuring.
fn floor_preparation_git_tree_sha() -> String {
  let outcome = floor_preparation_spawn_plain(
    binary: "/usr/bin/git",
    args: ["-C", floor_preparation_runner_root(), "rev-parse", "HEAD^\{tree\}"])
  if outcome.rc == 0 { floor_preparation_first_token(outcome.stdout) } else { "GIT_TREE_UNREADABLE" }
}

fn floor_preparation_git_head_sha() -> String {
  let outcome = floor_preparation_spawn_plain(
    binary: "/usr/bin/git",
    args: ["-C", floor_preparation_runner_root(), "rev-parse", "HEAD"])
  if outcome.rc == 0 { floor_preparation_first_token(outcome.stdout) } else { "GIT_HEAD_UNREADABLE" }
}

fn floor_preparation_manifest_sha(kind: String) -> String {
  // filesystem_read THROWS on a missing file (observed: TypeError "No such file or directory"),
  // which would crash the very gate that must REPORT an unreadable supply. Probe first, read
  // only what exists; a missing manifest renders as "" and the typed comparison refuses.
  let probe = floor_preparation_spawn_plain(binary: "/usr/bin/test",
    args: ["-f", floor_preparation_manifest_path()])
  let content = if probe.rc == 0 {
    filesystem_read(path: floor_preparation_manifest_path()).content
  } else {
    ""
  }
  let hits = filter(xs: floor_preparation_lines(text: content), predicate: fn(line) { floor_preparation_contains(haystack: line, needle: concat(" ", kind)) })
  match hits.first() {
    Present { value: v } => floor_preparation_first_token(v)
    Absent {} => ""
  }
}

fn floor_preparation_supply_check(name: String, path: String, expected: String) -> FloorPreparationSupplyReceipt {
  let digest_opt = floor_preparation_sha_of(path: path)
  let bytes_opt = floor_preparation_bytes_of(path: path)
  let manifest = floor_preparation_manifest_sha(kind: name)
  let admitted = match digest_opt {
    Present { value: d } => match bytes_opt {
      Present { value: b } => d != floor_preparation_empty_sha && d == expected && manifest == d
      && byte_size_count(b) > 0
      Absent {} => false
    }
    Absent {} => false
  }
  FloorPreparationSupplyReceipt {
    name: name,
    digest: digest_opt,
    bytes: bytes_opt,
    manifest: manifest,
    expected: expected,
    admitted: admitted,
  }
}

fn floor_preparation_supply_env_receipt(admitted: Bool, note: String) -> FloorPreparationSupplyReceipt {
  FloorPreparationSupplyReceipt {
    name: "required-env",
    digest: Absent {},
    bytes: Absent {},
    manifest: note,
    expected: note,
    admitted: admitted,
  }
}

// Print-boundary renderers. Nothing downstream reads these strings back to recover a verdict:
// the gates consume SupplyReceipt / LegReceipt fields, not this text (review 97909).
fn floor_preparation_supply_line(r: FloorPreparationSupplyReceipt) -> String {
  let digest_text = match r.digest {
    Present { value: d } => d
    Absent {} => "SHA_UNREADABLE"
  }
  let bytes_text = match r.bytes {
    Present { value: b } => to_string(byte_size_count(b))
    Absent {} => "BYTES_UNREADABLE"
  }
  if r.admitted {
    // A required-env receipt carries no digest or count: render only what it read. An admitted
    // binary receipt must print both, so Absent never rides along on a pass line.
    match r.digest {
      Present { value: d } => concat(concat(concat("[runner-supply] name=", r.name), concat(" sha256=", d)),
        concat(" bytes=", bytes_text))
      Absent {} => concat("[runner-supply] name=", r.name)
    }
  } else {
    concat(concat(concat(concat(concat("[runner-supply-REFUSED] name=", r.name), " disk="), digest_text),
      concat(" manifest=", r.manifest)), concat(" bytes=", bytes_text))
  }
}

fn floor_preparation_supply_lines(receipts: List<FloorPreparationSupplyReceipt>) -> List<String> {
  fold(receipts, init: [], f: (acc, r) => list_push(xs: acc, item: floor_preparation_supply_line(r: r)))
}

fn floor_preparation_supplies_hold(receipts: List<FloorPreparationSupplyReceipt>) -> Bool {
  fold(receipts, init: true, f: (acc, r) => acc && r.admitted)
}

// ----------------------------------------------------------------------------------------------
// THE ARGV, model-rendered. The population is the model's own rows (the fold module owns them);
// entries aggregate their claims into one --entry block each, and every leg is one claim_batch
// claim_batch invocation over the three source roots. The committed population file is compared
// to the model's rendering before any leg spawns; disagreement refuses the run.
// ----------------------------------------------------------------------------------------------

// The typed rows fold straight into the argv: no rendering round trip, no second representation,
// no dropped-row widening (review 97839).
fn floor_preparation_population_entries() -> List<String> {
  fold(floor_preparation_population_rows(), init: [], f: (acc, row) =>
    if floor_preparation_has_exact_row(rows: acc, wanted: row.entry) { acc }
    else { list_push(xs: acc, item: row.entry) })
}

// THE REVISION PLAN (review 98336, finding 2 -- the decision's consumer). The scope tool runs the
// grep map over the tree and PRINTS one authority-owned line; this runner is what consumes it, so
// the scoping decides real work instead of being an unread ledger. The line is parsed back through
// the authority's own reader (never a second format), and the plan it yields is what the legs run:
// entries the diff does not reach do not pay preparation on THAT revision; a reachable entry still
// pays, and a missing or corrupt line never plans "whatever the string said" -- absence is the
// sweep (the full roster, the shape that preserves red_control), corruption is a refusal.
type FloorPreparationRunnerPlan
  = Sweep { entries: List<String>, reason: String }
  | Scoped { entries: List<String>, reason: String }
  | PlanRefused { cause: String }

fn floor_preparation_runner_plan() -> FloorPreparationRunnerPlan {
  floor_preparation_runner_plan_from_line(line: floor_preparation_env_value(name: "SCOPE_DECISION_LINE"))
}

// The plan function proper, split from its environment read so the BEHAVIOUR of consuming a
// decision line is witnessed directly -- an env-gated function alone would let the claim pass on
// the absence path while the parse path rotted.
fn floor_preparation_runner_plan_from_line(line: String) -> FloorPreparationRunnerPlan {
  floor_preparation_runner_plan_over(line: line, population: floor_preparation_population_entries())
}

// Population is a PARAMETER, not a read from inside: a consumer that compared the line's counts
// against a population it invented itself would be a second decider about what "narrowed" means.
// Production passes the model's rows; the witness passes the fixture's, and both flow through the
// same code path -- which is what makes the behavioural claims real instead of decorative.
fn floor_preparation_runner_plan_over(line: String, population: List<String>) -> FloorPreparationRunnerPlan {
  if line == "" {
    Sweep {
      entries: population,
      reason: "no-scope-decision: full roster pays preparation (the sweep behaviour that preserves red_control)",
    }
  } else {
    match floor_preparation_scope_planned_entries(
      read: floor_preparation_scope_line_parse(line: line),
      population: population) {
      Planned { entries: e, reason: r, narrowed: _ } =>
        if length(xs: e) < length(xs: population) {
          Scoped { entries: e, reason: r }
        } else {
          Sweep { entries: e, reason: r }
        }
      Refused { cause: c } => PlanRefused { cause: c }
    }
  }
}

fn floor_preparation_plan_entries(plan: FloorPreparationRunnerPlan) -> List<String> {
  match plan {
    Sweep { entries: e, reason: _ } => e
    Scoped { entries: e, reason: _ } => e
    PlanRefused { cause: _ } => []
  }
}

fn floor_preparation_plan_receipt(plan: FloorPreparationRunnerPlan) -> String {
  match plan {
    Sweep { entries: e, reason: r } =>
      concat("mode=sweep entries=", concat(to_string(length(xs: e)), concat(" reason=", r)))
    Scoped { entries: e, reason: r } =>
      concat("mode=scoped entries=", concat(to_string(length(xs: e)), concat(" reason=", r)))
    PlanRefused { cause: c } => concat("mode=REFUSED cause=", c)
  }
}

fn floor_preparation_functions_for(entry: String) -> String {
  join(floor_preparation_entry_claim_names(entry: entry), ",")
}

fn floor_preparation_leg_argv(entries: List<String>) -> List<String> {
  let roots = fold(floor_preparation_source_roots, init: [], f: (acc, root) =>
    concat(acc, ["--source-root", root]))
  fold(entries, init: roots, f: (acc, entry) =>
    concat(acc, ["--entry", entry,
                 "--functions", floor_preparation_functions_for(entry: entry)]))
}

fn floor_preparation_pass_names(stdout_text: String) -> List<String> {
  fold(floor_preparation_lines(text: stdout_text), init: [], f: (acc, line) =>
    if starts_with(s: line, prefix: "PASS ") {
      list_push(xs: acc, item: floor_preparation_first_token(
        floor_preparation_strip_prefix(text: line, prefix: "PASS ")))
    } else { acc })
}

fn floor_preparation_entry_claim_names(entry: String) -> List<String> {
  let rows = filter(xs: floor_preparation_population_rows(), predicate: fn(row) { row.entry == entry })
  fold(rows, init: [], f: (acc, row) => list_push(xs: acc, item: row.claim))
}

fn floor_preparation_surviving_entries(untrimmed_stdout: String) -> List<String> {
  let passed = floor_preparation_pass_names(stdout_text: untrimmed_stdout)
  filter(xs: floor_preparation_population_entries(), predicate: fn(entry) {
    let claims = floor_preparation_entry_claim_names(entry: entry)
    fold(claims, init: true, f: (acc, claim) =>
      acc && floor_preparation_has_exact_row(rows: passed, wanted: claim)) == false
  })
}

fn floor_preparation_cause_of(entry: String, untrimmed_stdout: String) -> String {
  "closure-authority-refusal"
}

// ----------------------------------------------------------------------------------------------
// THE RUN. Receipt lines accumulate into the returned String -- a returned String prints on
// refusal (the documented convention at src/v2/workflow/floor_cost_debt.dag), so both the
// receipts and any refusal text reach the terminal. Every leg's printed rc is part of its receipt
// line: a leg that exits 0 without its named lines is a FAILURE decided in model code below,
// never inferred from a missing guard message.
// ----------------------------------------------------------------------------------------------

// Every leg headlines its real rc, the instrument it ran, the instrument's sha256 AND byte count
// read back FROM DISK at run time, the tree sha under measurement, and the kept-row count -- the
// 0-byte-downloaded-binary-that-exits-0 failure mode seen in this lane fails the supply gate, and
// a sha drifting from the pin fails it too.
// A leg's verdict is a FIELD on a record, not a prefix on a line (review 97909). The record
// captures the spawn observation plus the binary's on-disk identity at leg time; the gates read
// .rc / .clean / .kept_count and the renderer exists only for the printed receipt.
// A leg that carried VERDICTS is clean; a leg that carried none is not, whatever its exit code.
// rc 1 is claim_batch's honest verdict-bearing exit (any FAIL or UNOBSERVED anywhere in the
// batch), and a gate demanding rc 0 could never capture a population that contains FAILs -- the
// red control needs FAILs to be CAPTURABLE. rc >= 2 is usage, resolve failure or the forwarded
// timeout: never clean. (Adopted from the run5 forensics with the lane manager.)
fn floor_preparation_verdict_count(text: String) -> Int {
  fold(floor_preparation_lines(text: text), init: 0, f: (acc, line) =>
    if starts_with(s: line, prefix: "PASS ")
      || starts_with(s: line, prefix: "FAIL ")
      || starts_with(s: line, prefix: "UNOBSERVED ") { acc + 1 } else { acc })
}

fn floor_preparation_spawn_completed(rc: Int) -> Bool {
  rc == 0 || rc == 1
}

// A resolve death must not masquerade as a verdict-bearing run: both run5 legs emitted rc=1
// with kept phase lines BEFORE claim_batch aborted on a resolve error, and a clean rule keyed
// only on rc and verdict-line counts reads that as clean. The claim_batch resolve banner and any
// resolve-error line are captured onto the typed receipt: a leg is clean only when its resolve
// outcome is Resolved. (run5 forensics, adopted with the lane manager.)
fn floor_preparation_resolve_outcome(text: String) -> FloorPreparationResolveOutcome {
  let lines = floor_preparation_lines(text: text)
  let failed = filter(xs: lines, predicate: fn(line) {
    floor_preparation_contains(haystack: line, needle: "error: resolve failed")
  })
  if length(xs: failed) > 0 {
    let first_error = match failed.first() {
      Present { value: f } => f
      Absent {} => "resolve failed"
    }
    let causes = filter(xs: lines, predicate: fn(line) {
      floor_preparation_contains(haystack: line, needle: "cause:")
    })
    let cause_tail = match causes.first() {
      Present { value: c } => c
      Absent {} => ""
    }
    ResolveFailed { cause: concat(first_error, cause_tail) }
  } else {
    let banners = filter(xs: lines, predicate: fn(line) {
      floor_preparation_contains(haystack: line, needle: " resolving ")
    })
    match banners.first() {
      Present { value: b } => Resolved { banner: b }
      Absent {} => NotObserved {}
    }
  }
}

fn floor_preparation_resolved(outcome: FloorPreparationResolveOutcome) -> Bool {
  match outcome {
    Resolved { banner: b } => true
    ResolveFailed { cause: c } => false
    NotObserved {} => false
  }
}

fn floor_preparation_resolve_text(outcome: FloorPreparationResolveOutcome) -> String {
  match outcome {
    Resolved { banner: b } => concat(" resolve=ok[", b, "]")
    ResolveFailed { cause: c } => concat(" resolve=FAILED[", c, "]")
    NotObserved {} => " resolve=NOT_OBSERVED"
  }
}

fn floor_preparation_leg_record(
    label: String, entries: List<String>, binary: String, tree_sha: String,
    kept_count: Int, outcome: FloorPreparationSpawnObservation,
    captured: String) -> FloorPreparationLegReceipt {
  // The TRANSCRIPT, not the in-memory tail, is what a leg is judged on (run8: the drain caps
  // stderr at a 16 KiB tail; PASS verdicts ride stdout, resolve banners stderr -- a leg judged
  // from either in-memory stream alone mis-sees its own run).
  // bind before the literal: match is statement position here, not a record-field expression
  let out_bytes_opt = match checked_int_to_nat(n: captured.length()) {
    Present { value: k } => Present { value: byte_size(count: k) }
    Absent {} => Absent {}
  }
  FloorPreparationLegReceipt {
    label: label,
    entries_joined: join(entries, ","),
    rc: outcome.rc,
    binary: binary,
    digest: floor_preparation_sha_of(path: binary),
    bytes: floor_preparation_bytes_of(path: binary),
    tree_sha: tree_sha,
    kept_count: kept_count,
    verdict_count: floor_preparation_verdict_count(text: captured),
    resolve: floor_preparation_resolve_outcome(text: captured),
    out_bytes: out_bytes_opt,
    clean: floor_preparation_spawn_completed(rc: outcome.rc)
      && floor_preparation_verdict_count(text: captured) > 0
      && floor_preparation_resolved(outcome: floor_preparation_resolve_outcome(text: captured)),
  }
}

fn floor_preparation_leg_receipt(r: FloorPreparationLegReceipt) -> String {
  let digest_text = match r.digest {
    Present { value: d } => d
    Absent {} => "SHA_UNREADABLE"
  }
  let bytes_text = match r.bytes {
    Present { value: b } => to_string(byte_size_count(b))
    Absent {} => "BYTES_UNREADABLE"
  }
  let out_text = match r.out_bytes {
    Present { value: b } => to_string(byte_size_count(b))
    Absent {} => "BYTES_UNREADABLE"
  }
  concat(concat(concat("[runner-leg] leg=", r.label), concat(" entries=", r.entries_joined)),
    concat(concat(concat(" rc=", to_string(r.rc)), concat(" verdicts=", to_string(r.verdict_count))),
      concat(floor_preparation_resolve_text(outcome: r.resolve),
      concat(concat(" instrument=", r.binary),
        concat(concat(" BINARY_SHA256=", digest_text),
          concat(concat(" BINARY_BYTES=", bytes_text),
            concat(concat(" TREE_SHA=", r.tree_sha),
              concat(" out_bytes=", out_text))))))))
}

fn floor_preparation_retained_body(untrimmed_stdout: String, graded_stdout: String) -> String {
  concat(concat("SECTION untrimmed\n", join(floor_preparation_kept(text: untrimmed_stdout), "\n")),
    concat("\nSECTION graded\n", join(floor_preparation_kept(text: graded_stdout), "\n")))
}

fn floor_preparation_byte_text(value: Optional<ByteSize>) -> String {
  match value {
    Present { value: b } => to_string(byte_size_count(b))
    Absent {} => "BYTES_UNREADABLE"
  }
}

fn floor_preparation_provenance(
    leg: String, binary_sha: String, binary_bytes: String,
    head_sha: String, tree_sha: String, rc: Int, kept_count: Int) -> String {
  // The keys here are the CONTRACT the committed-capture witness reads (binary_sha256,
  // binary_bytes, head_sha, tree_sha): a provenance line without an identity key makes that
  // witness refuse, so the cache cannot be spliced in without its identities.
  fold(["[capture-provenance] leg=", leg, " binary_sha256=", binary_sha,
        " binary_bytes=", binary_bytes, " head_sha=", head_sha, " tree_sha=", tree_sha,
        " rc=", to_string(rc), " kept_rows=", to_string(kept_count)],
    init: "", f: (acc, s) => concat(acc, s))
}

fn floor_preparation_capture_run() -> String {
  let env_missing = floor_preparation_required_env_missing()
  let env_receipt = floor_preparation_supply_env_receipt(
    admitted: env_missing == "", note: concat("unset=", env_missing))
  let supply_receipts = [
    env_receipt,
    floor_preparation_supply_check(name: "claim_batch",
      path: floor_preparation_pinned_claim_batch(),
      expected: floor_preparation_pinned_claim_batch_sha),
    floor_preparation_supply_check(name: "gunbc",
      path: floor_preparation_pinned_gunbc(),
      expected: floor_preparation_pinned_gunbc_sha)
  ]
  let supplies = floor_preparation_supply_lines(receipts: supply_receipts)
  let verify_receipt = floor_preparation_receipt("verify-pinned-supplies",
    concat("lines=", to_string(length(xs: supplies))))
  if !floor_preparation_supplies_hold(receipts: supply_receipts) {
    concat(concat(join(supplies, "\n"), "\n"), verify_receipt)
  } else {
    let plan = floor_preparation_runner_plan()
    let entries = floor_preparation_plan_entries(plan: plan)
    let plan_receipt = floor_preparation_receipt("revision-plan", floor_preparation_plan_receipt(plan: plan))
    let tree_sha = floor_preparation_git_tree_sha()
    let head_sha = floor_preparation_git_head_sha()
    let untrimmed = floor_preparation_spawn_slot_captured(
      label: "leg-untrimmed", bound: floor_preparation_untrimmed_bound(),
      binary: floor_preparation_pinned_claim_batch(),
      args: floor_preparation_leg_argv(entries: entries))
    let untrimmed_transcript = floor_preparation_read_captured(label: "leg-untrimmed")
    let kept_untrimmed = floor_preparation_kept(text: untrimmed_transcript)
    let untrimmed_record = floor_preparation_leg_record(
      label: "leg-untrimmed", entries: entries, binary: floor_preparation_pinned_claim_batch(),
      tree_sha: tree_sha, kept_count: length(xs: kept_untrimmed), outcome: untrimmed,
      captured: untrimmed_transcript)
    let untrimmed_receipt = floor_preparation_leg_receipt(r: untrimmed_record)
    let survivors = floor_preparation_surviving_entries(untrimmed_stdout: untrimmed_transcript)
    // The graded leg RE-RUNS SURVIVORS ONLY; when the untrimmed leg passed every claim there is
    // nothing to re-run, and spawning claim_batch with zero entries would die on usage -- a
    // missing leg is recorded as skipped, and legs_clean states the skip instead of pretending.
    let graded = if length(xs: survivors) == 0 {
      FloorPreparationSpawnObservation { rc: 0, stdout: "", stderr: "" }
    } else {
      floor_preparation_spawn_slot_captured(
        label: "leg-graded", bound: floor_preparation_graded_bound(),
        binary: floor_preparation_pinned_claim_batch(),
        args: floor_preparation_leg_argv(entries: survivors))
    }
    let graded_transcript = if length(xs: survivors) == 0 { "" } else {
      floor_preparation_read_captured(label: "leg-graded")
    }
    let kept_graded = floor_preparation_kept(text: graded_transcript)
    let graded_record = floor_preparation_leg_record(
      label: "leg-graded", entries: survivors, binary: floor_preparation_pinned_claim_batch(),
      tree_sha: tree_sha, kept_count: length(xs: kept_graded), outcome: graded,
      captured: graded_transcript)
    let graded_receipt = floor_preparation_leg_receipt(r: graded_record)
    // TRANSCRIPT RECEIPTS. Each leg's full stream already lives on disk (script -qef LOG --);
    // the receipt names the file and counts what the transcript holds, so a spawn that produced
    // no transcript is visible on the receipts as bytes=0 verdicts=0 rather than as silence.
    let leg_stderr_untrimmed = floor_preparation_receipt("leg-stderr-untrimmed",
      concat(concat("file=", floor_preparation_leg_log_path(label: "leg-untrimmed")),
        concat(concat(" bytes=", to_string(untrimmed_transcript.length())),
          concat(" verdicts=", to_string(floor_preparation_verdict_count(text: untrimmed_transcript))))))
    let leg_stderr_graded = floor_preparation_receipt("leg-stderr-graded",
      if length(xs: survivors) == 0 { "file=skipped entries=0" } else {
        concat(concat("file=", floor_preparation_leg_log_path(label: "leg-graded")),
          concat(concat(" bytes=", to_string(graded_transcript.length())),
            concat(" verdicts=", to_string(floor_preparation_verdict_count(text: graded_transcript))))) })
    let fold_legs_receipt = floor_preparation_receipt("fold-legs",
      concat(concat("kept_untrimmed=", to_string(length(xs: kept_untrimmed))),
        concat(" kept_graded=", to_string(length(xs: kept_graded)))))
    let retained = floor_preparation_retained_body(untrimmed_stdout: untrimmed_transcript, graded_stdout: graded_transcript)
    let claims_args = concat(
      fold(floor_preparation_source_roots, init: [], f: (acc, root) => concat(acc, ["--source-root", root])),
      ["--entry", floor_preparation_witness_module,
       "--functions", join(floor_preparation_claim_roster, ",")])
    let claims = floor_preparation_spawn_slot_captured(
      label: "leg-claims", bound: floor_preparation_claims_bound(),
      binary: floor_preparation_pinned_claim_batch(),
      args: claims_args)
    // A gate that discards the only stream telling it WHAT IT EXECUTED is not a gate. The claim
    // leg's FULL transcript -- PASS/FAIL/UNOBSERVED verdicts (claim_batch.rs prints them with
    // println!, i.e. STDOUT; run8's gate read stderr and could never see a verdict) plus every
    // resolve banner and phase line -- is read back from the script log and its size reported,
    // so a missing-roster verdict can be read, not guessed.
    let claims_transcript = floor_preparation_read_captured(label: "leg-claims")
    let claims_stderr_text = match checked_int_to_nat(n: claims_transcript.length()) {
      Present { value: k } => to_string(byte_size_count(byte_size(count: k)))
      Absent {} => "BYTES_UNREADABLE"
    }
    let passed = floor_preparation_pass_names(stdout_text: claims_transcript)
    let missing = fold(floor_preparation_claim_roster, init: [], f: (acc, name) =>
      if floor_preparation_has_exact_row(rows: passed, wanted: name) { acc } else { list_push(xs: acc, item: name) })
    let report = floor_preparation_spawn_slot(
      bound: floor_preparation_report_bound(),
      binary: floor_preparation_pinned_gunbc(),
      args: concat(
        ["run"], concat(
          fold(floor_preparation_source_roots, init: [], f: (acc, root) => concat(acc, ["--source-root", root])),
          ["--entry", floor_preparation_authority_path, "--function", "floor_preparation_split_report"])))
    let build_argv_receipt = floor_preparation_receipt("build-argv-from-population",
      concat("entries=", to_string(length(xs: entries))))
    let splice_receipt = floor_preparation_receipt("splice-capture-rows",
      concat("blocks=5 target=", floor_preparation_authority_path))
    // The host prints the returned String on the REFUSAL line -- observed on this host: the
    // report text arrives on STDERR inside "error: function `floor_preparation_split_report`
    // returned `...`, not `ProcessExit`", so the report lines are read from stderr.
    let report_lines = fold(floor_preparation_lines(text: report.stderr), init: [], f: (acc, line) =>
      if starts_with(s: line, prefix: floor_preparation_report_prefix) {
        list_push(xs: acc, item: line)
      } else { acc })
    let classifications = fold(report_lines, init: [], f: (acc, line) =>
      list_push(xs: acc, item: floor_preparation_classify_report_line(line: line)))
    let classification_text = join(classifications, ",")
    let report_read = floor_preparation_has_exact_row(rows: classifications, wanted: "REPORT_READ")
      && floor_preparation_contains(haystack: join(report_lines, "\n"), needle: floor_preparation_report_sentinel)
    // The leg's real exit status, printed on its own receipt line and asserted against the
    // expected value for THIS path: the report function RETURNS a String, and the host has no
    // success channel for one -- observed on this host ("returned `22|12`, not `ProcessExit`",
    // rc=2, value printed in the refusal; royal-newt's ruling reads the report from that print).
    // So rc==2 IS the expected status for the report leg; rc==0, rc==1 or 124 is a defect, not a
    // pass -- a well-formed report that exited 0 would be a success-channel fabrication.
    let report_record = floor_preparation_leg_record(
      label: "report-print", entries: [floor_preparation_authority_path],
      binary: floor_preparation_pinned_gunbc(), tree_sha: tree_sha, kept_count: 0, outcome: report,
      captured: concat(report.stdout, "\n"))
    let report_rc_receipt = floor_preparation_receipt("report-print",
      concat(concat("rc=", to_string(report_record.rc)), concat(" expected_rc=2 classifications=", classification_text)))
    // The gate reads RECORD FIELDS (review 97909): graded_record.clean is exactly "graded.rc == 0
    // and its kept set is non-empty"; report_record.rc is the command's own exit status.
    let report_ok = report_read && report_record.rc == 2
      && (length(xs: survivors) == 0 || graded_record.clean)
    let receipts = concat(concat(concat(supplies, [verify_receipt, plan_receipt]),
        [build_argv_receipt,
         untrimmed_receipt,
         leg_stderr_untrimmed,
         floor_preparation_receipt("derive-pass-set",
           concat("excluded=", to_string(length(xs: survivors))))]),
      [graded_receipt,
       leg_stderr_graded,
       fold_legs_receipt,
       floor_preparation_receipt("retained-body-rendered",
         concat("rows=", to_string(length(xs: retained)))),
       splice_receipt,
       floor_preparation_provenance(leg: "untrimmed",
         binary_sha: floor_preparation_pinned_claim_batch_sha,
         binary_bytes: floor_preparation_byte_text(value: untrimmed_record.bytes),
         head_sha: head_sha, tree_sha: tree_sha,
         rc: untrimmed_record.rc, kept_count: untrimmed_record.kept_count),
       floor_preparation_provenance(leg: "graded",
         binary_sha: floor_preparation_pinned_claim_batch_sha,
         binary_bytes: floor_preparation_byte_text(value: graded_record.bytes),
         head_sha: head_sha, tree_sha: tree_sha,
         rc: graded_record.rc, kept_count: graded_record.kept_count),
       floor_preparation_receipt("claim-gate",
         concat(concat("missing=", join(missing, ",")),
           concat(" claims_transcript_bytes=", claims_stderr_text))),
       report_rc_receipt])
    // The retained log and the population projection are LEG OUTPUT, not verdict output: they
    // are written as soon as both legs completed clean (rc==0 with kept rows), BEFORE the claim
    // and report gates decide the terminal verdict. Refusing a red gate must not also destroy the
    // raw evidence of the run -- but writing them is not a pass, and the terminal gate below
    // still refuses without them reading green.
    // A skipped graded leg (nothing survived the untrimmed pass) is CLEAN BY CONSTRUCTION: there
    // was nothing to re-run. Stated, not assumed -- the receipts print 'skipped entries=0'.
    let legs_clean = untrimmed_record.clean
      && (length(xs: survivors) == 0 || graded_record.clean)
    let write_receipt = if legs_clean {
      // Each write reports ITSELF (review 97945): the retained artifact has its own receipt;
      // there is no second committed copy to write anymore.
      let w1 = Filesystem.Write(
        path: concat(floor_preparation_runner_root(), "/", floor_preparation_retained_file),
        content: retained)
      if w1.success { "retained=written" } else { "retained=WRITE_FAILED" }
    } else { "retained=skipped legs not clean" }
    let all_receipts = list_push(xs: receipts, item: floor_preparation_receipt("write-retained", write_receipt))
    if !report_ok || length(xs: missing) > 0 {
      concat(join(all_receipts, "\n"), "\nRUNNER_REFUSED: gates not green -- see receipts above")
    } else {
      concat(join(all_receipts, "\n"),
        concat("\n", concat(join(report_lines, "\n"),
          concat("\n", floor_preparation_receipt("terminal-gate", "ALL_GATES_GREEN")))))
    }
  }
}


