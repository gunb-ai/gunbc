module v2.workflow.ci_merge_admission_emit_test

import v2.workflow.ci_merge_admission_emit { ci_floor_disposition_marker_init_script }
import gunbc.merge_admission_produce {
  ci_floor_disposition_marker_init_shell_emit_dissolution_trigger,
  ci_floor_disposition_marker_init_note,
  merge_admission_floor_disposition_floor_running,
  ci_floor_disposition_marker_path,
}

data ci_merge_admission_emit_golden_note: String = "Hand-authored golden independent of grammar row spellings; byte test compares emit output against this literal (#6467 pattern)."

fn ci_floor_disposition_marker_init_concat_golden() -> String {
  concat(
    concat("# ", concat(ci_floor_disposition_marker_init_shell_emit_dissolution_trigger, "\n")),
    concat(
      concat("# ", concat(ci_floor_disposition_marker_init_note, "\n")),
      concat(
        concat("mkdir -p target\n"),
        concat(
          concat("echo ", merge_admission_floor_disposition_floor_running),
          concat(" > ", concat(ci_floor_disposition_marker_path, "\n"))
        )
      )
    )
  )
}

test fn ci_floor_disposition_marker_init_emit_matches_concat_golden_holds() -> Bool {
  ci_floor_disposition_marker_init_script() == ci_floor_disposition_marker_init_concat_golden()
}
