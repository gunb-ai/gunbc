test fn orch_retry_body_exit_step_refused_holds() -> Bool {
  match orch_emit_step(
    s: Retry {
      body: Pipeline {
        steps: [Exit { status: "\"$STAMP_EXIT\"" }],
        on_failure: FailFast
      },
      escalations: [orch_retry_body_carrier_probe_escalation()],
      on_exhausted: Pipeline {
        steps: [Do { run: Run { command: "exit 1", env: [], redirect: Absent, capture: Absent } }],
        on_failure: FailFast
      }
    },
    medium: bash_orchestration_emit_medium()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

test fn orch_int_ne_then_exit_emit_matches_inline_holds() -> Bool {
  match orch_emit_step(
    s: If {
      cond: IntNe { lhs: "\"$FLOOR_EXIT\"", rhs: "0" },
      then_: Pipeline {
        steps: [Exit { status: "\"$FLOOR_EXIT\"" }],
        on_failure: FailFast
      },
      else_: Absent
    },
    medium: bash_orchestration_emit_medium()
  ) {
    Accepted { value: source, diagnostics: _ } =>
      source.carried == "if [ \"$FLOOR_EXIT\" -ne 0 ]; then exit \"$FLOOR_EXIT\"; fi"
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_int_ne_operand_injection_refused_holds() -> Bool {
  match orch_emit_step(
    s: If {
      cond: IntNe { lhs: "0 ] || injected_command #", rhs: "0" },
      then_: Pipeline {
        steps: [Exit { status: "\"$FLOOR_EXIT\"" }],
        on_failure: FailFast
      },
      else_: Absent
    },
    medium: bash_orchestration_emit_medium()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

test fn orch_exit_step_emit_matches_golden_holds() -> Bool {
  match orch_emit_step(s: Exit { status: "\"$STAMP_EXIT\"" }, medium: bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: _ } => source.carried == "exit \"$STAMP_EXIT\""
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_exit_step_metachar_refused_holds() -> Bool {
  match orch_emit_step(
    s: Exit { status: "1; rm -rf /" },
    medium: bash_orchestration_emit_medium()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

data ci_floor_stamp_merge_admission_golden: String = concat(
  "FLOOR_EXIT=$?\n",
  concat(
    "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)\n",
    concat(
      "CI_FLOOR_EXIT=$FLOOR_EXIT \"$ROOT/target/release/gunbc\" run --source-root dag --entry dag/tools/merge_admission_stamp.dag --function main\n",
      concat(
        "STAMP_EXIT=$?\n",
        concat(
          "if [ \"$FLOOR_EXIT\" -ne 0 ]; then exit \"$FLOOR_EXIT\"; fi\n",
          "exit \"$STAMP_EXIT\""
        )
      )
    )
  )
)

test fn ci_floor_stamp_merge_admission_emit_matches_golden_holds() -> Bool {
  ci_floor_stamp_merge_admission_script() == ci_floor_stamp_merge_admission_golden
}
