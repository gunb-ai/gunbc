module v2.workflow.ci_merge_admission_emit_test

import v2.workflow.ci_merge_admission_emit {
  ci_floor_stamp_merge_admission_script
}
import v2.workflow.orchestration_bash_emit_support {
  orch_bash_comment_line,
  orch_bash_emit_pipeline
}
import v2.compiler.emit_orchestration { orch_emit_step }
import v2.extdeps.languages.bash_orchestration_emit { bash_orchestration_emit_medium }
import v2.std.orchestration {
  BoundedPoll,
  Call,
  Comment,
  Do,
  EscalationLevel,
  Exit,
  ExitStatus,
  FailFast,
  For,
  If,
  IntNe,
  Let,
  LogMatches,
  Pipeline,
  PipelineStep,
  Retry,
  Run,
  TeeTo,
  ToFile,
  While
}
import v2.std.collection { Absent, Present }
import v2.std.diagnostic { Accepted, EmitDirective, Rejected, SeverityWarning }

data ci_merge_admission_emit_golden_note: String = "Hand-authored golden independent of grammar row spellings; byte test compares emit output against this literal (#6467 pattern)."

data orch_to_file_fixture_command: String = "echo receipt_ready"
data orch_to_file_fixture_path: String = "target/orchestration-receipt.txt"

data orch_to_file_redirect_golden: String = "echo receipt_ready > target/orchestration-receipt.txt"

fn orch_to_file_redirect_step() -> PipelineStep {
  Do {
    run: Run {
      command: orch_to_file_fixture_command,
      env: [],
      redirect: Present { value: ToFile { path: orch_to_file_fixture_path } },
      capture: Absent
    }
  }
}

fn orch_to_file_redirect_emit() -> String {
  match orch_emit_step(s: orch_to_file_redirect_step(), medium: bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: _ } => source.carried
    Rejected { diagnostics: _ } => "__TO_FILE_EMIT_REJECTED__"
  }
}

test fn orch_to_file_redirect_emit_matches_golden_holds() -> Bool {
  orch_to_file_redirect_emit() == orch_to_file_redirect_golden
}

test fn orch_to_file_redirect_emit_red_when_path_wrong_holds() -> Bool {
  let wrong = Do {
    run: Run {
      command: orch_to_file_fixture_command,
      env: [],
      redirect: Present { value: ToFile { path: "target/WRONG-path.txt" } },
      capture: Absent
    }
  }
  match orch_emit_step(s: wrong, medium: bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: _ } =>
      !(source.carried == orch_to_file_redirect_golden)
      && string_contains(s: source.carried, pattern: "WRONG-path")
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_to_file_path_newline_refused_holds() -> Bool {
  match orch_emit_step(
    s: Do {
      run: Run {
        command: orch_to_file_fixture_command,
        env: [],
        redirect: Present { value: ToFile { path: "target/x.txt\nrm -rf /" } },
        capture: Absent
      }
    },
    medium: bash_orchestration_emit_medium()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

test fn orch_to_file_path_metachar_refused_holds() -> Bool {
  match orch_emit_step(
    s: Do {
      run: Run {
        command: orch_to_file_fixture_command,
        env: [],
        redirect: Present { value: ToFile { path: "target/x;echo injected" } },
        capture: Absent
      }
    },
    medium: bash_orchestration_emit_medium()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

test fn orch_to_file_path_space_refused_holds() -> Bool {
  match orch_emit_step(
    s: Do {
      run: Run {
        command: orch_to_file_fixture_command,
        env: [],
        redirect: Present { value: ToFile { path: "target/has space.txt" } },
        capture: Absent
      }
    },
    medium: bash_orchestration_emit_medium()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } =>
      orch_to_file_redirect_emit() == orch_to_file_redirect_golden
  }
}

data orch_comment_step_golden: String = "# carrier-comment-body"

fn orch_comment_step_emit() -> String {
  match orch_emit_step(s: Comment { text: "carrier-comment-body" }, medium: bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: _ } => source.carried
    Rejected { diagnostics: _ } => "__COMMENT_EMIT_REJECTED__"
  }
}

test fn orch_comment_step_emit_matches_golden_holds() -> Bool {
  orch_comment_step_emit() == orch_comment_step_golden
}

test fn orch_comment_step_emit_red_when_hash_dropped_holds() -> Bool {
  let fake_command = Do {
    run: Run {
      command: "carrier-comment-body",
      env: [],
      redirect: Absent,
      capture: Absent
    }
  }
  match orch_emit_step(s: fake_command, medium: bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: _ } =>
      source.carried == "carrier-comment-body"
      && !(source.carried == orch_comment_step_golden)
      && orch_comment_step_emit() == orch_comment_step_golden
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_comment_multiline_refused_holds() -> Bool {
  match orch_emit_step(
    s: Comment { text: "note\nrm -rf /" },
    medium: bash_orchestration_emit_medium()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

test fn orch_comment_multiline_refused_is_not_executable_second_line_holds() -> Bool {
  match orch_emit_step(
    s: Comment { text: "innocent\necho injected" },
    medium: bash_orchestration_emit_medium()
  ) {
    Accepted { value: source, diagnostics: _ } =>
      string_contains(s: source.carried, pattern: "\necho injected")
        && false
    Rejected { diagnostics: _ } =>
      orch_comment_step_emit() == orch_comment_step_golden
  }
}

test fn orch_bash_comment_line_is_comment_step_holds() -> Bool {
  match orch_bash_comment_line(text: "x") {
    Comment { text: t } => t == "x"
    Do { run: _ } => false
    Exit { status: _ } => false
    If { cond: _, then_: _, else_: _ } => false
    For { binder: _, over: _, body: _ } => false
    While { cond: _, body: _ } => false
    BoundedPoll { max_attempts: _, body: _, success: _ } => false
    Retry { body: _, escalations: _, on_exhausted: _ } => false
    Let { name: _, value: _ } => false
    Call { callee: _, args: _ } => false
  }
}

data orch_exit_status_capture_golden: String = "true\nSTAMP_EXIT=$?"

fn orch_exit_status_capture_intent() -> PipelineStep {
  Do {
    run: Run {
      command: "true",
      env: [],
      redirect: Absent,
      capture: Present { value: ExitStatus { binder: "STAMP_EXIT" } }
    }
  }
}

fn orch_exit_status_capture_emit() -> String {
  match orch_emit_step(s: orch_exit_status_capture_intent(), medium: bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: _ } => source.carried
    Rejected { diagnostics: _ } => "__EXIT_STATUS_EMIT_REJECTED__"
  }
}

test fn orch_exit_status_capture_emit_matches_golden_holds() -> Bool {
  orch_exit_status_capture_emit() == orch_exit_status_capture_golden
}

test fn orch_exit_status_capture_emit_red_when_binder_wrong_holds() -> Bool {
  let wrong = Do {
    run: Run {
      command: "true",
      env: [],
      redirect: Absent,
      capture: Present { value: ExitStatus { binder: "WRONG_EXIT" } }
    }
  }
  match orch_emit_step(s: wrong, medium: bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: _ } =>
      !(source.carried == orch_exit_status_capture_golden)
      && string_contains(s: source.carried, pattern: "WRONG_EXIT=$?")
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_exit_status_binder_newline_refused_holds() -> Bool {
  match orch_emit_step(
    s: Do {
      run: Run {
        command: "true",
        env: [],
        redirect: Absent,
        capture: Present { value: ExitStatus { binder: "STATUS\nsome_command" } }
      }
    },
    medium: bash_orchestration_emit_medium()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

test fn orch_exit_status_binder_newline_not_executable_second_line_holds() -> Bool {
  match orch_emit_step(
    s: Do {
      run: Run {
        command: "true",
        env: [],
        redirect: Absent,
        capture: Present { value: ExitStatus { binder: "STATUS\necho injected" } }
      }
    },
    medium: bash_orchestration_emit_medium()
  ) {
    Accepted { value: source, diagnostics: _ } =>
      string_contains(s: source.carried, pattern: "\necho injected")
        && false
    Rejected { diagnostics: _ } =>
      orch_exit_status_capture_emit() == orch_exit_status_capture_golden
  }
}

data orch_to_file_then_exit_status_golden: String = "echo receipt_ready > target/orchestration-receipt.txt\nSTAMP_EXIT=$?"

fn orch_to_file_then_exit_status_intent() -> PipelineStep {
  Do {
    run: Run {
      command: orch_to_file_fixture_command,
      env: [],
      redirect: Present { value: ToFile { path: orch_to_file_fixture_path } },
      capture: Present { value: ExitStatus { binder: "STAMP_EXIT" } }
    }
  }
}

test fn orch_to_file_then_exit_status_emit_matches_golden_holds() -> Bool {
  match orch_emit_step(s: orch_to_file_then_exit_status_intent(), medium: bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: _ } =>
      source.carried == orch_to_file_then_exit_status_golden
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_to_file_then_exit_status_invalid_path_refuses_whole_holds() -> Bool {
  match orch_emit_step(
    s: Do {
      run: Run {
        command: orch_to_file_fixture_command,
        env: [],
        redirect: Present { value: ToFile { path: "target/x;injected" } },
        capture: Present { value: ExitStatus { binder: "STAMP_EXIT" } }
      }
    },
    medium: bash_orchestration_emit_medium()
  ) {
    Accepted { value: source, diagnostics: _ } =>
      string_contains(s: source.carried, pattern: "STAMP_EXIT=$?")
        && false
    Rejected { diagnostics: _ } => true
  }
}

fn orch_retry_body_carrier_probe_escalation() -> EscalationLevel {
  EscalationLevel {
    detect: LogMatches { source: "BUILD_LOG", pattern: "PAT" },
    warning: EmitDirective {
      severity: SeverityWarning,
      message: "probe"
    },
    env: []
  }
}

fn orch_retry_with_body_run(r: Run) -> PipelineStep {
  Retry {
    body: Pipeline {
      steps: [Do { run: r }],
      on_failure: FailFast
    },
    escalations: [orch_retry_body_carrier_probe_escalation()],
    on_exhausted: Pipeline {
      steps: [Do { run: Run { command: "exit 1", env: [], redirect: Absent, capture: Absent } }],
      on_failure: FailFast
    }
  }
}

test fn orch_retry_body_to_file_refused_holds() -> Bool {
  match orch_emit_step(
    s: orch_retry_with_body_run(
      r: Run {
        command: "true",
        env: [],
        redirect: Present { value: ToFile { path: "target/x.txt" } },
        capture: Absent
      }
    ),
    medium: bash_orchestration_emit_medium()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

