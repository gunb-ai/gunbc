module v2.workflow.ci_floor_evidence_native_controls_emit

import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.types { List }
import v2.std.effect_plan { Do, EffectPlan }
import v2.std.operation_argv {
  OperationRef,
  operation_argv_bind_text_list
}
import v2.std.orchestration { FailFast }
import v2.std.text { String }
import v2.workflow.effect_plan_bash_materialize {
  BashBoundOperationInvocation,
  EffectPlanBashMaterializationRefused,
  EffectPlanBashMaterialized,
  bash_bind_operation_invocation_host_env_executable,
  effect_plan_bash_materialize,
  effect_plan_bash_refusal_label
}

data ci_floor_evidence_native_controls_extra_args_note: String = "#7785 commit 4A, blocker 7: the required CI must actually EXECUTE the floor-evidence native controls (claim_executor_floor_evidence.rs #[cfg(test)] module) rather than merely compile them - every prior claim about symlink removal, atomic observation fragments, fail-closed writes, and the fingerprint pairing is asserted only by this module's own unit tests, so a required CI job that never runs cargo test on it could regress silently under a change that still compiles. --test-threads=1 matches this module's own CWD_LOCK serialization (the tests share std::env::set_current_dir)."

data ci_floor_evidence_native_controls_extra_args: List<String> = [
  "-p",
  "v1-compiler",
  "--bin",
  "claim_executor",
  "floor_evidence::",
  "--",
  "--test-threads=1"
]

data ci_floor_evidence_native_controls_cargo_path: String = "dag/extdeps/rust/cargo_build.dag"
data ci_floor_evidence_native_controls_cargo_service: String = "cargo.Build"
data ci_floor_evidence_native_controls_cargo_operation: String = "Test"
data ci_floor_evidence_native_controls_cargo_bin_env_var: String = "CARGO_BIN"

data ci_floor_evidence_native_controls_refusal_prefix: String = "__GUNBC_EFFECT_PLAN_BASH_REFUSED__ floor-evidence native controls: "

data ci_floor_evidence_native_controls_authority_note: String = "Build-job executed-controls step for claim_executor_floor_evidence.rs (#7785 commit 4A, blocker 7). Same typed-carrier shape as ci_v1_compiler_tests_compile_gate_emit (one extdeps.cargo_build invocation bound by name, HostEnvVar CARGO_BIN from the same pin-rustup prelude the build job already ran before this step). Unlike the compile gate, this one actually RUNS the tests (cargo.Build.Test, not Check) — the point is execution, not compilation."

data ci_floor_evidence_native_controls_shell_emit_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "v2.workflow.ci_floor_evidence_native_controls_emit",
    decl_name: "ci_floor_evidence_native_controls_script",
    field: WholeDeclaration
  }
}

data ci_floor_evidence_native_controls_shell_emit_dissolution_trigger: String = "🟡 dissolve-on: ci_floor_evidence_native_controls_script — foreign-executor (GitHub Actions run:) shell transport for extdeps.cargo_build cargo.Build.Test(extra_args: ci_floor_evidence_native_controls_extra_args); DISSOLVES WHEN bash-emit (#5828 / ROADMAP 6-shell-slice0 / shell→intent Phase 2) binds the build-job step to orchestration emit over the typed cargo operation — the same de-fork ci_v1_compiler_tests_compile_gate_script awaits"

fn ci_floor_evidence_native_controls_test_step() -> BashBoundOperationInvocation {
  bash_bind_operation_invocation_host_env_executable(
    at: OperationRef {
      path: ci_floor_evidence_native_controls_cargo_path,
      service: ci_floor_evidence_native_controls_cargo_service,
      operation: ci_floor_evidence_native_controls_cargo_operation
    },
    bindings: [
      operation_argv_bind_text_list(
        name: "extra_args",
        items: ci_floor_evidence_native_controls_extra_args
      )
    ],
    env_var: ci_floor_evidence_native_controls_cargo_bin_env_var
  )
}

fn ci_floor_evidence_native_controls_intent() -> EffectPlan<BashBoundOperationInvocation> {
  EffectPlan {
    steps: [Do { effect: ci_floor_evidence_native_controls_test_step() }],
    on_failure: FailFast
  }
}

fn ci_floor_evidence_native_controls_render(
  plan: EffectPlan<BashBoundOperationInvocation>
) -> String {
  match effect_plan_bash_materialize(plan: plan) {
    EffectPlanBashMaterialized { source: source } => source
    EffectPlanBashMaterializationRefused { refusal: refusal } =>
      concat(
        ci_floor_evidence_native_controls_refusal_prefix,
        effect_plan_bash_refusal_label(refusal: refusal)
      )
  }
}

fn ci_floor_evidence_native_controls_script() -> String {
  concat(
    concat("# ", concat(ci_floor_evidence_native_controls_shell_emit_dissolution_trigger, "\n")),
    concat(ci_floor_evidence_native_controls_render(plan: ci_floor_evidence_native_controls_intent()), "\n")
  )
}
