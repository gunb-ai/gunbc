module v2.workflow.effect_plan_bash_materialize


data effect_plan_bash_materialize_authority_note: String = "Wave A realization edge: EffectPlan<BashBoundOperationInvocation> lowers to the existing Bash command/and-then grammar nodes, then emits through bash_command_fold_serialize. Each leaf's operation intent is the agnostic BoundOperationInvocation (operation ref + declaration bindings only); argv is derived from that declaration by shell_materialize_operation_argv. Bash-only executable_position on BashBoundOperationInvocation chooses how argv[0] RENDERS in this foreign-executor transport — DeclarationLiteral emits the declaration literal; HostEnvVar emits bash_build_word_var for pin-rustup prelude paths such as CARGO_BIN — without fusing transport policy into the generic invocation substrate (DESIGN §3). FailFast is the Bash grammar's && relation. Wave B (#7363) gave it its first production consumer — the CI merge-admission gate step."

type BashShellExecutablePosition
  = DeclarationLiteral
  | HostEnvVar { name: String }

type BashBoundOperationInvocation {
  invocation: v2.std.operation_argv.BoundOperationInvocation
  executable_position: BashShellExecutablePosition
}

data bash_bound_operation_invocation_authority_note: String = "Bash realization wrapper over the agnostic BoundOperationInvocation. executable_position is transport-only: it cannot change which operation row is named or which declared inputs bind; it only selects whether argv[0] emits as the declaration literal or as a grammar-owned host env var reference."

fn bash_bind_operation_invocation(
  at: v2.std.operation_argv.OperationRef,
  bindings: List<v2.std.operation_argv.OperationInputBinding>
) -> BashBoundOperationInvocation {
  BashBoundOperationInvocation {
    invocation: bind_operation_invocation(at: at, bindings: bindings),
    executable_position: DeclarationLiteral
  }
}

fn bash_bind_operation_invocation_host_env_executable(
  at: v2.std.operation_argv.OperationRef,
  bindings: List<v2.std.operation_argv.OperationInputBinding>,
  env_var: String
) -> BashBoundOperationInvocation {
  BashBoundOperationInvocation {
    invocation: bind_operation_invocation(at: at, bindings: bindings),
    executable_position: HostEnvVar { name: env_var }
  }
}

data effect_plan_bash_refusal_label_note: String = "The refusal LABEL lives with the refusal TYPE, exactly as operation_argv_cause_label lives with ArgvRefusalCause (§3): a consumer that needs to render a refusal reads this, rather than minting a second vocabulary for the same coproduct. It renders the located triple a consumer needs to act — which step index, which operation (when one is known), and which cause — and it is TOTAL, so a new arm cannot be rendered as a blank."

type EffectPlanBashUnsupportedStep
  = UnsupportedIf
  | UnsupportedFor
  | UnsupportedWhile
  | UnsupportedRetry
  | UnsupportedLet
  | UnsupportedCall

type EffectPlanBashRefusalCause
  = UnsupportedFailurePolicy { policy: v2.std.orchestration.FailurePolicy }
  | UnsupportedEffectPlanStep { kind: EffectPlanBashUnsupportedStep }
  | OperationArgvRefused { cause: v2.std.operation_argv.ArgvRefusalCause }
  | ArgumentContainsNul { argument_index: Int }
  | BashGrammarEmissionRefused { diagnostics: v2.std.diagnostic.NonEmptyDiagnostics }

type EffectPlanBashRefusal {
  step_index: Int
  operation: Optional<v2.std.operation_argv.OperationRef>
  cause: EffectPlanBashRefusalCause
}

type EffectPlanBashEncoding
  = EffectPlanBashEmpty
  | EffectPlanBashEncoded { statement: Node }

type EffectPlanBashEncodeResult
  = EffectPlanBashEncodingAccepted { encoding: EffectPlanBashEncoding }
  | EffectPlanBashEncodingRefused { refusal: EffectPlanBashRefusal }

type EffectPlanBashMaterialization
  = EffectPlanBashMaterialized { source: String }
  | EffectPlanBashMaterializationRefused { refusal: EffectPlanBashRefusal }

fn effect_plan_bash_refuse(
  step_index: Int,
  operation: Optional<v2.std.operation_argv.OperationRef>,
  cause: EffectPlanBashRefusalCause
) -> EffectPlanBashEncodeResult {
  EffectPlanBashEncodingRefused {
    refusal: EffectPlanBashRefusal {
      step_index: step_index,
      operation: operation,
      cause: cause
    }
  }
}

fn effect_plan_bash_argv_nul_index(
  argv: List<String>,
  index: Int
) -> Optional<Int> {
  match list_at_optional(xs: argv, index: index) {
    Present { value: argument } =>
      if string_contains(s: argument, pattern: "\u{0000}") {
        optional_present(value: index)
      } else {
        effect_plan_bash_argv_nul_index(argv: argv, index: index + 1)
      }
    Absent => optional_absent()
  }
}

fn effect_plan_bash_command_from_argv(
  argv: List<String>,
  executable_position: BashShellExecutablePosition
) -> Node {
  match executable_position {
    DeclarationLiteral => bash_build_command_from_lits(lits: argv)
    HostEnvVar { name: env_var } =>
      match list_head(xs: argv) {
        HeadAbsent => bash_build_command_from_lits(lits: [])
        HeadFound { value: _ } =>
          bash_build_command(
            words: bash_build_command_words_from_lits_suffix(
              lits: argv,
              accumulated: bash_build_command_words_single(
                word: bash_build_word_var(name: env_var)
              ),
              index: 1
            )
          )
      }
  }
}

fn effect_plan_bash_encode_invocation(
  bound: BashBoundOperationInvocation,
  step_index: Int
) -> EffectPlanBashEncodeResult {
  let invocation = bound.invocation
  let at = invocation.at
  match shell_materialize_operation_argv(
    at.path,
    at.service,
    at.operation,
    invocation.bindings
  ) {
    ArgvMaterialized { argv: argv } =>
      match effect_plan_bash_argv_nul_index(argv: argv, index: 0) {
        Present { value: argument_index } =>
          effect_plan_bash_refuse(
            step_index: step_index,
            operation: Present { value: at },
            cause: ArgumentContainsNul { argument_index: argument_index }
          )
        Absent =>
          EffectPlanBashEncodingAccepted {
            encoding: EffectPlanBashEncoded {
              statement: effect_plan_bash_command_from_argv(
                argv: argv,
                executable_position: bound.executable_position
              )
            }
          }
      }
    ArgvMaterializationRefused { at: refused_at, cause: cause } =>
      effect_plan_bash_refuse(
        step_index: step_index,
        operation: Present { value: refused_at },
        cause: OperationArgvRefused { cause: cause }
      )
  }
}

fn effect_plan_bash_encode_step(
  step: v2.std.effect_plan.EffectPlanStep<BashBoundOperationInvocation>,
  step_index: Int
) -> EffectPlanBashEncodeResult {
  match step {
    v2.std.effect_plan.Do { effect: bound } =>
      effect_plan_bash_encode_invocation(
        bound: bound,
        step_index: step_index
      )
    v2.std.effect_plan.If { cond: _, then_: _, else_: _ } =>
      effect_plan_bash_refuse(
        step_index: step_index,
        operation: Absent,
        cause: UnsupportedEffectPlanStep {
          kind: UnsupportedIf
        }
      )
    v2.std.effect_plan.For { binder: _, over: _, body: _ } =>
      effect_plan_bash_refuse(
        step_index: step_index,
        operation: Absent,
        cause: UnsupportedEffectPlanStep {
          kind: UnsupportedFor
        }
      )
    v2.std.effect_plan.While { cond: _, body: _ } =>
      effect_plan_bash_refuse(
        step_index: step_index,
        operation: Absent,
        cause: UnsupportedEffectPlanStep {
          kind: UnsupportedWhile
        }
      )
    v2.std.effect_plan.Retry { body: _, escalations: _, on_exhausted: _ } =>
      effect_plan_bash_refuse(
        step_index: step_index,
        operation: Absent,
        cause: UnsupportedEffectPlanStep {
          kind: UnsupportedRetry
        }
      )
    v2.std.effect_plan.Let { name: _, value: _ } =>
      effect_plan_bash_refuse(
        step_index: step_index,
        operation: Absent,
        cause: UnsupportedEffectPlanStep {
          kind: UnsupportedLet
        }
      )
    v2.std.effect_plan.Call { callee: _, args: _ } =>
      effect_plan_bash_refuse(
        step_index: step_index,
        operation: Absent,
        cause: UnsupportedEffectPlanStep {
          kind: UnsupportedCall
        }
      )
  }
}

fn effect_plan_bash_and_then(
  left: EffectPlanBashEncoding,
  right: EffectPlanBashEncoding
) -> EffectPlanBashEncoding {
  match left {
    EffectPlanBashEmpty => right
    EffectPlanBashEncoded { statement: left_statement } =>
      match right {
        EffectPlanBashEmpty => left
        EffectPlanBashEncoded { statement: right_statement } =>
          EffectPlanBashEncoded {
            statement: bash_build_and_then(
              left: left_statement,
              right: right_statement
            )
          }
      }
  }
}

fn effect_plan_bash_encode_steps(
  steps: List<v2.std.effect_plan.EffectPlanStep<BashBoundOperationInvocation>>,
  step_index: Int
) -> EffectPlanBashEncodeResult {
  match list_head(xs: steps) {
    HeadAbsent =>
      EffectPlanBashEncodingAccepted { encoding: EffectPlanBashEmpty }
    HeadFound { value: step } =>
      match effect_plan_bash_encode_step(step: step, step_index: step_index) {
        EffectPlanBashEncodingRefused { refusal: refusal } =>
          EffectPlanBashEncodingRefused { refusal: refusal }
        EffectPlanBashEncodingAccepted { encoding: first } =>
          match list_tail(xs: steps) {
            TailAbsent =>
              EffectPlanBashEncodingAccepted { encoding: first }
            TailFound { tail: rest } =>
              match effect_plan_bash_encode_steps(
                steps: rest,
                step_index: step_index + 1
              ) {
                EffectPlanBashEncodingRefused { refusal: refusal } =>
                  EffectPlanBashEncodingRefused { refusal: refusal }
                EffectPlanBashEncodingAccepted { encoding: tail_encoding } =>
                  EffectPlanBashEncodingAccepted {
                    encoding: effect_plan_bash_and_then(
                      left: first,
                      right: tail_encoding
                    )
                  }
              }
          }
      }
  }
}

fn effect_plan_bash_encode(
  plan: v2.std.effect_plan.EffectPlan<BashBoundOperationInvocation>
) -> EffectPlanBashEncodeResult {
  match plan.on_failure {
    Continue =>
      effect_plan_bash_refuse(
        step_index: -1,
        operation: Absent,
        cause: UnsupportedFailurePolicy { policy: Continue }
      )
    FailFast =>
      effect_plan_bash_encode_steps(steps: plan.steps, step_index: 0)
  }
}

fn effect_plan_bash_unsupported_step_label(
  kind: EffectPlanBashUnsupportedStep
) -> String {
  match kind {
    UnsupportedIf => "If"
    UnsupportedFor => "For"
    UnsupportedWhile => "While"
    UnsupportedRetry => "Retry"
    UnsupportedLet => "Let"
    UnsupportedCall => "Call"
  }
}

fn effect_plan_bash_failure_policy_label(policy: v2.std.orchestration.FailurePolicy) -> String {
  match policy {
    Continue => "Continue"
    FailFast => "FailFast"
  }
}

fn effect_plan_bash_cause_label(cause: EffectPlanBashRefusalCause) -> String {
  match cause {
    UnsupportedFailurePolicy { policy: policy } =>
      concat(
        "UnsupportedFailurePolicy:",
        effect_plan_bash_failure_policy_label(policy: policy)
      )
    UnsupportedEffectPlanStep { kind: kind } =>
      concat(
        "UnsupportedEffectPlanStep:",
        effect_plan_bash_unsupported_step_label(kind: kind)
      )
    OperationArgvRefused { cause: argv_cause } =>
      concat(
        "OperationArgvRefused:",
        operation_argv_cause_label(cause: argv_cause)
      )
    ArgumentContainsNul { argument_index: argument_index } =>
      concat("ArgumentContainsNul:", to_string(argument_index))
    BashGrammarEmissionRefused { diagnostics: _ } =>
      "BashGrammarEmissionRefused"
  }
}

fn effect_plan_bash_operation_label(
  operation: Optional<v2.std.operation_argv.OperationRef>
) -> String {
  match operation {
    Present { value: at } => concat(" at ", operation_argv_ref_label(at: at))
    Absent => ""
  }
}

fn effect_plan_bash_refusal_label(refusal: EffectPlanBashRefusal) -> String {
  let _note = effect_plan_bash_refusal_label_note
  concat(
    concat(
      concat("step ", to_string(refusal.step_index)),
      effect_plan_bash_operation_label(operation: refusal.operation)
    ),
    concat(": ", effect_plan_bash_cause_label(cause: refusal.cause))
  )
}

fn effect_plan_bash_materialize(
  plan: v2.std.effect_plan.EffectPlan<BashBoundOperationInvocation>
) -> EffectPlanBashMaterialization {
  match effect_plan_bash_encode(plan: plan) {
    EffectPlanBashEncodingRefused { refusal: refusal } =>
      EffectPlanBashMaterializationRefused { refusal: refusal }
    EffectPlanBashEncodingAccepted { encoding: encoding } =>
      match encoding {
        EffectPlanBashEmpty =>
          EffectPlanBashMaterialized { source: "" }
        EffectPlanBashEncoded { statement: statement } =>
          match bash_fold_serialize_node(stmt: statement) {
            Accepted { value: source, diagnostics: _ } =>
              EffectPlanBashMaterialized { source: source }
            Rejected { diagnostics: diagnostics } =>
              EffectPlanBashMaterializationRefused {
                refusal: EffectPlanBashRefusal {
                  step_index: -1,
                  operation: Absent,
                  cause: BashGrammarEmissionRefused {
                    diagnostics: diagnostics
                  }
                }
              }
          }
      }
  }
}
