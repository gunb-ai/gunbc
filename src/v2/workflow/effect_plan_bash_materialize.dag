module v2.workflow.effect_plan_bash_materialize

import std.types { List }
import v2.extdeps.languages.bash_build { bash_build_and_then, bash_build_assign, bash_build_assign_lit, bash_build_assign_var, bash_build_command, bash_build_command_from_lits, bash_build_command_words_from_lits_suffix, bash_build_command_words_single, bash_build_command_with_words, bash_build_exit, bash_build_pipe, bash_build_subshell_from_stmts, bash_build_if, bash_build_if_else, bash_build_negation, bash_build_or_else, bash_build_stmt_list_single, bash_build_test_bracket, bash_build_word_cmdsubst, bash_build_word_lit, bash_build_word_var }
import std.algebra { list_head, list_tail, list_at_optional }
import v2.std.text { string_all_chars_in, string_any_char_in }
import v2.std.diagnostic { Accepted, NonEmptyDiagnostics, Rejected }
import v2.std.effect_plan { Call, Do, EffectPlan, EffectPlanStep, For, If, Let, Retry, While }
import v2.std.node { Node }
import std.operation_argv { ArgvMaterialization, ArgvMaterializationRefused, ArgvMaterialized, ArgvRefusalCause, BoundOperationInvocation, OperationInputBinding, operation_argv_bind_text, OperationRef, bind_operation_invocation, operation_argv_cause_label, operation_argv_ref_label, shell_materialize_operation_argv }
import std.optional { Absent, Optional, Present, optional_absent, optional_present }
import v2.std.orchestration { And, Continue, ExitZero, Expr, ExprCmdSubst, ExprLit, ExprVarRef, FailFast, FailurePolicy, IntNe, LogMatches, Not, Or, Predicate, StrEmpty, StrEq, StrNonempty }
import v2.std.effect_plan_observed_sha256 { DigestShapeInvalid, ObservationFailed, ObservedSha256FailureCause, ObservedSha256EnvWrite, observed_sha256_failure_exit_status }
import v2.workflow.effect_plan_bash_hex_ere { effect_plan_bash_sha256_line_ere }
import std.content_hash { sha256_hex_digit_count }
import extdeps.tools.grep { grep_program }
import extdeps.tools.gnu_coreutils { coreutils_install_binary_name, coreutils_install_group_flag, coreutils_install_mode_flag, coreutils_install_owner_flag, printf_program }
import v2.workflow.bash_command_fold_serialize { bash_fold_serialize_node }
import extdeps.posix.shell_command_language { posix_name_ok }
import extdeps.sudo.elevation { sudo_elevate_argv }

// Wave A realization edge: EffectPlan<BashPlanEffect> lowers to the existing Bash
// command/and-then grammar nodes, then emits through bash_command_fold_serialize. Each leaf's
// operation intent is the agnostic BoundOperationInvocation (operation ref + declaration bindings
// only); argv is derived from that declaration by shell_materialize_operation_argv. Bash-only
// executable_position on BashBoundOperationInvocation chooses how argv[0] RENDERS in this
// foreign-executor transport — DeclarationLiteral emits the declaration literal; HostEnvVar emits
// bash_build_word_var for pin-rustup prelude paths such as CARGO_BIN — without fusing transport
// policy into the generic invocation substrate (DESIGN §3). FailFast is the Bash grammar's &&
// relation. Wave B (#7363) gave it its first production consumer — the CI merge-admission gate
// step. If, Let and Call lower through the same grammar rows (test bracket, assign, command,
// if/if-else) for gunbc-private#60, whose shell steps are carried as strings until this transport
// accepts them; For, While and Retry keep refusing, since nothing demands them.

type BashShellExecutablePosition
  = DeclarationLiteral
  | HostEnvVar { name: String }
  | ElevatedDeclarationLiteral

// ElevatedDeclarationLiteral is the third RENDERING of argv[0], not a third kind of operation. The
// operation row is named and bound exactly as DeclarationLiteral names and binds it; what differs
// is that this foreign-executor transport crosses a privilege boundary, so the declaration literal
// is executed THROUGH sudo. The words are extdeps.sudo.elevation sudo_elevate's -- the module that
// owns sudo's calling convention (which binary, which flag, in which position) -- so this arm reads
// an authority rather than respelling "sudo" and "-n" as two literals here, which is how the
// corpus previously carried four copies of the same two tokens.
//
// It cannot elevate something the caller could not otherwise name: sudo_elevate transforms an argv
// that is still derived from the operation declaration, and this arm has no parameter through which
// a caller could substitute a different program. Elevation is therefore visible in the emitted
// bytes and decided at the authoring leaf, never inside argv materialization.

type BashBoundOperationInvocation {
  invocation: BoundOperationInvocation
  executable_position: BashShellExecutablePosition
}

// THE CLOSED EFFECT SUM OF THIS MATERIALIZER. A plan's Do leaf is either a named extdeps operation
// or the observed-SHA-256 env write, and effect_plan_bash_encode_step gives each case exactly one
// arm; there is no second materializer and no open extension point.
type BashPlanEffect
  = BashOperationEffect { bound: BashBoundOperationInvocation }
  | ObservedSha256EnvWriteEffect { write: ObservedSha256EnvWrite }

// Bash realization wrapper over the agnostic BoundOperationInvocation. executable_position is
// transport-only: it cannot change which operation row is named or which declared inputs bind; it
// only selects whether argv[0] emits as the declaration literal or as a grammar-owned host env var
// reference.

fn bash_bind_operation_invocation(
  at: OperationRef,
  bindings: List<OperationInputBinding>
) -> BashPlanEffect {
  BashOperationEffect { bound: BashBoundOperationInvocation {
    invocation: bind_operation_invocation(at: at, bindings: bindings),
    executable_position: DeclarationLiteral
  } }
}

fn bash_bind_operation_invocation_elevated(
  at: OperationRef,
  bindings: List<OperationInputBinding>
) -> BashPlanEffect {
  BashOperationEffect { bound: BashBoundOperationInvocation {
    invocation: bind_operation_invocation(at: at, bindings: bindings),
    executable_position: ElevatedDeclarationLiteral
  } }
}

fn bash_bind_operation_invocation_host_env_executable(
  at: OperationRef,
  bindings: List<OperationInputBinding>,
  env_var: String
) -> BashPlanEffect {
  BashOperationEffect { bound: BashBoundOperationInvocation {
    invocation: bind_operation_invocation(at: at, bindings: bindings),
    executable_position: HostEnvVar { name: env_var }
  } }
}

data effect_plan_bash_refusal_label_note: String = "The refusal LABEL lives with the refusal TYPE, exactly as operation_argv_cause_label lives with ArgvRefusalCause (§3): a consumer that needs to render a refusal reads this, rather than minting a second vocabulary for the same coproduct. It renders the located triple a consumer needs to act — which step index, which operation (when one is known), and which cause — and it is TOTAL, so a new arm cannot be rendered as a blank."

// UnsupportedIf / UnsupportedLet / UnsupportedCall were arms here until the If / Let / Call climb
// (gunbc-private#60 trigger); the climb deleted them as obsoleted production machinery (DESIGN
// 4b(4)) and their former expecting-red assertions stay enrolled in
// effect_plan_bash_materialize_test as the permanent regression control that each arm materializes.
type EffectPlanBashUnsupportedStep
  = UnsupportedFor
  | UnsupportedWhile
  | UnsupportedRetry

type EffectPlanBashIfBranch
  = ThenBranch
  | ElseBranch

// The two Predicate arms whose operands are not values: ExitZero carries a Run whose command is a
// raw shell string (the anemic leaf std.effect_plan names), and LogMatches realizes as a grep argv
// whose flag policy has no argv authority yet (extdeps.tools.grep is a tool row only). Both refuse
// with their kind; nothing demands them (gunbc-private#60 needs comparison predicates).

type EffectPlanBashUnsupportedPredicate
  = ExitZeroRunPredicate
  | LogMatchesPredicate

// Predicate operands are Strings, and the Pipeline string tier (05_emit_orchestration) reads them as
// raw shell spellings -- authors there write lhs: "\"$X\"". This transport reads an operand as a
// VALUE and single-quotes it, so the same spelling would compare the four literal characters
// instead of expanding X: a silent meaning fork (DESIGN 3). Operands carrying any of the POSIX
// quoting or expansion characters therefore refuse with PredicateOperandCarriesShellSpelling
// rather than being quoted. That is over-prohibition of a quotable literal, bounded to these five
// characters and loud; it dissolves when Predicate carries Expr operands (ExprLit | ExprVarRef |
// ExprCmdSubst) so that a variable reference is a typed arm and a literal is unambiguous.
data effect_plan_bash_predicate_operand_shell_spelling_chars: String = "$`\"'\\"

type EffectPlanBashRefusalCause
  = UnsupportedFailurePolicy { policy: FailurePolicy }
  | UnsupportedEffectPlanStep { kind: EffectPlanBashUnsupportedStep }
  | OperationArgvRefused { cause: ArgvRefusalCause }
  | ArgumentContainsNul { argument_index: Int }
  | BashGrammarEmissionRefused { diagnostics: NonEmptyDiagnostics }
  | UnsupportedPredicate { kind: EffectPlanBashUnsupportedPredicate }
  | PredicateOperandCarriesShellSpelling { operand: String }
  | IntNeOperandNotDecimalInteger { operand: String }
  | ShellNameInvalid { name: String }
  | CallCalleeEmpty
  | IfBranchEmpty { branch: EffectPlanBashIfBranch }
  | NestedBranchRefused { branch: EffectPlanBashIfBranch, refusal: EffectPlanBashRefusal }

type EffectPlanBashRefusal {
  step_index: Int
  operation: Optional<OperationRef>
  cause: EffectPlanBashRefusalCause
}

type EffectPlanBashEncoding
  = EffectPlanBashEmpty
  | EffectPlanBashEncoded { statement: Node }

type EffectPlanBashEncodeResult
  = EffectPlanBashEncodingAccepted { encoding: EffectPlanBashEncoding }
  | EffectPlanBashEncodingRefused { refusal: EffectPlanBashRefusal }

type EffectPlanBashMaterialization
  = EffectPlanBashMaterialized { source: String }
  | EffectPlanBashMaterializationRefused { refusal: EffectPlanBashRefusal }

fn effect_plan_bash_refuse(
  step_index: Int,
  operation: Optional<OperationRef>,
  cause: EffectPlanBashRefusalCause
) -> EffectPlanBashEncodeResult {
  EffectPlanBashEncodingRefused {
    refusal: EffectPlanBashRefusal {
      step_index: step_index,
      operation: operation,
      cause: cause
    }
  }
}

fn effect_plan_bash_argv_nul_index(
  argv: List<String>,
  index: Int
) -> Optional<Int> {
  match list_at_optional(xs: argv, index: index) {
    Present { value: argument } =>
      if string_contains(s: argument, pattern: "\u{0000}") {
        optional_present(value: index)
      } else {
        effect_plan_bash_argv_nul_index(argv: argv, index: index + 1)
      }
    Absent => optional_absent()
  }
}

fn effect_plan_bash_command_from_argv(
  argv: List<String>,
  executable_position: BashShellExecutablePosition
) -> Node {
  match executable_position {
    DeclarationLiteral => bash_build_command_from_lits(lits: argv)
    ElevatedDeclarationLiteral =>
      bash_build_command_from_lits(lits: sudo_elevate_argv(command: argv))
    HostEnvVar { name: env_var } =>
      match list_head(xs: argv) {
        Absent => bash_build_command_from_lits(lits: [])
        Present { value: _ } =>
          bash_build_command(
            words: bash_build_command_words_from_lits_suffix(
              lits: argv,
              accumulated: bash_build_command_words_single(
                word: bash_build_word_var(name: env_var)
              ),
              index: 1
            )
          )
      }
  }
}

fn effect_plan_bash_encode_invocation(
  bound: BashBoundOperationInvocation,
  step_index: Int
) -> EffectPlanBashEncodeResult {
  let invocation = bound.invocation
  let at = invocation.at
  match shell_materialize_operation_argv(
    at.path,
    at.service,
    at.operation,
    invocation.bindings
  ) {
    ArgvMaterialized { argv: argv } =>
      match effect_plan_bash_argv_nul_index(argv: argv, index: 0) {
        Present { value: argument_index } =>
          effect_plan_bash_refuse(
            step_index: step_index,
            operation: Present { value: at },
            cause: ArgumentContainsNul { argument_index: argument_index }
          )
        Absent =>
          EffectPlanBashEncodingAccepted {
            encoding: EffectPlanBashEncoded {
              statement: effect_plan_bash_command_from_argv(
                argv: argv,
                executable_position: bound.executable_position
              )
            }
          }
      }
    ArgvMaterializationRefused { at: refused_at, cause: cause } =>
      effect_plan_bash_refuse(
        step_index: step_index,
        operation: Present { value: refused_at },
        cause: OperationArgvRefused { cause: cause }
      )
  }
}

fn effect_plan_bash_encode_step(
  step: EffectPlanStep<BashPlanEffect>,
  step_index: Int
) -> EffectPlanBashEncodeResult {
  match step {
    Do { effect: effect } =>
      match effect {
        BashOperationEffect { bound: bound } =>
          effect_plan_bash_encode_invocation(
            bound: bound,
            step_index: step_index
          )
        ObservedSha256EnvWriteEffect { write: write } =>
          effect_plan_bash_encode_observed_sha256_env_write(
            write: write,
            step_index: step_index
          )
      }
    If { cond: cond, then_: then_, else_: else_ } =>
      effect_plan_bash_encode_if(
        cond: cond,
        then_: then_,
        else_: else_,
        step_index: step_index
      )
    For { binder: _, over: _, body: _ } =>
      effect_plan_bash_refuse(
        step_index: step_index,
        operation: Absent,
        cause: UnsupportedEffectPlanStep {
          kind: UnsupportedFor
        }
      )
    While { cond: _, body: _ } =>
      effect_plan_bash_refuse(
        step_index: step_index,
        operation: Absent,
        cause: UnsupportedEffectPlanStep {
          kind: UnsupportedWhile
        }
      )
    Retry { body: _, escalations: _, on_exhausted: _ } =>
      effect_plan_bash_refuse(
        step_index: step_index,
        operation: Absent,
        cause: UnsupportedEffectPlanStep {
          kind: UnsupportedRetry
        }
      )
    Let { name: name, value: value } =>
      effect_plan_bash_encode_let(name: name, value: value, step_index: step_index)
    Call { callee: callee, args: args } =>
      effect_plan_bash_encode_call(callee: callee, args: args, step_index: step_index)
  }
}


// ---- ObservedSha256EnvWrite ---------------------------------------------------------------
//
// The one arm that lowers the observed-SHA-256 env write. Three statements joined by the grammar's
// && relation, each failing CLOSED before the next:
//   1. the observation: the canonical extdeps.tools.sha256sum DigestFile argv, run in a command
//      substitution into a variable only this statement chain names; a nonzero read exits with
//      ObservationFailed's status;
//   2. the shape guard: the variable piped to grep -Eq with the pattern derived from
//      std.content_hash' alphabet (effect_plan_bash_sha256_line_ere); no match exits with
//      DigestShapeInvalid's status, before anything is written;
//   3. the write: the digest's first sha256_hex_digit_count characters (what the guard admitted) as
//      `NAME=<digest>`, piped into root-owned install at the declared mode and owner.
// The variable is a shell-side word; the model never reads it. Statically decidable faults (env
// name not a POSIX name, NUL in a path, an observer argv that does not materialize) refuse here,
// with the same typed causes the other arms use.

data effect_plan_bash_observed_digest_var: String = "_gunbc_observed_digest"
data effect_plan_bash_sha256sum_operation_path: String = "dag/extdeps/tools/sha256sum.dag"
data effect_plan_bash_sha256sum_operation_service: String = "sha256sum.Sha256"
data effect_plan_bash_sha256sum_digest_file_operation: String = "DigestFile"
data effect_plan_bash_sha256sum_path_input: String = "path"

fn effect_plan_bash_observed_exit(cause: ObservedSha256FailureCause) -> Node {
  bash_build_exit(code: observed_sha256_failure_exit_status(cause: cause))
}

fn effect_plan_bash_observed_digest_word() -> Node {
  bash_build_word_var(name: effect_plan_bash_observed_digest_var)
}

fn effect_plan_bash_observed_printf(format: String) -> Node {
  bash_build_command_with_words(words: [
    bash_build_word_lit(text: printf_program().invocation as String),
    bash_build_word_lit(text: format),
    effect_plan_bash_observed_digest_word()
  ])
}

fn effect_plan_bash_observed_statement(
  write: ObservedSha256EnvWrite,
  observer_argv: List<String>
) -> Node {
  bash_build_subshell_from_stmts(stmts: [
    bash_build_or_else(
      left: bash_build_assign(
        name: effect_plan_bash_observed_digest_var,
        value: bash_build_word_cmdsubst(body: bash_build_command_from_lits(lits: observer_argv))
      ),
      right: effect_plan_bash_observed_exit(cause: ObservationFailed)
    ),
    bash_build_or_else(
      left: bash_build_pipe(
        left: effect_plan_bash_observed_printf(format: "%s"),
        right: bash_build_command_from_lits(lits: [
          grep_program().invocation as String,
          "-Eq",
          effect_plan_bash_sha256_line_ere()
        ])
      ),
      right: effect_plan_bash_observed_exit(cause: DigestShapeInvalid)
    ),
    bash_build_pipe(
      left: effect_plan_bash_observed_printf(
        format: concat(write.env_name, concat("=%.", concat(to_string(sha256_hex_digit_count), "s\\n")))
      ),
      right: bash_build_command_from_lits(lits: concat(
        sudo_elevate_argv(command: [
          coreutils_install_binary_name as String,
          coreutils_install_mode_flag as String,
          write.mode as String,
          coreutils_install_owner_flag as String,
          write.owner as String,
          coreutils_install_group_flag as String,
          write.owner as String
        ]),
        ["/dev/stdin", write.dest]
      ))
    )
  ])
}

fn effect_plan_bash_encode_observed_sha256_env_write(
  write: ObservedSha256EnvWrite,
  step_index: Int
) -> EffectPlanBashEncodeResult {
  let at = OperationRef {
    path: effect_plan_bash_sha256sum_operation_path,
    service: effect_plan_bash_sha256sum_operation_service,
    operation: effect_plan_bash_sha256sum_digest_file_operation
  }
  effect_plan_bash_shell_name_checked(
    name: write.env_name,
    step_index: step_index,
    accepted: effect_plan_bash_lits_nul_checked(
      lits: [write.path, write.dest, write.mode as String, write.owner as String],
      step_index: step_index,
      accepted: match shell_materialize_operation_argv(
        at.path,
        at.service,
        at.operation,
        [operation_argv_bind_text(
          name: effect_plan_bash_sha256sum_path_input,
          text: write.path
        )]
      ) {
        ArgvMaterialized { argv: argv } =>
          effect_plan_bash_accept_statement(
            statement: effect_plan_bash_observed_statement(write: write, observer_argv: argv)
          )
        ArgvMaterializationRefused { at: refused_at, cause: cause } =>
          effect_plan_bash_refuse(
            step_index: step_index,
            operation: Present { value: refused_at },
            cause: OperationArgvRefused { cause: cause }
          )
      }
    )
  )
}

// ---- Let ----------------------------------------------------------------------------------
//
// Let binds a shell variable. The name renders unquoted in `name=...` and later as "$name", so it
// must be a POSIX name (XBD 3.235: letters, digits, underscore, no leading digit); anything else
// refuses, since a name is the one position the quoting authority cannot cover. The value goes
// through the same word grammar the Do arm uses: ExprLit is a single-quoted lit word, ExprVarRef is
// the grammar's "$name" var word (its name is checked the same way), ExprCmdSubst is $( command )
// over lit words. NUL is the one byte no quoting can carry and refuses as it does for argv.
// posix_name_ok is the POSIX name rule's one home (extdeps.posix.shell_command_language), read
// here rather than respelled (DESIGN 3).

fn effect_plan_bash_shell_name_checked(
  name: String,
  step_index: Int,
  accepted: EffectPlanBashEncodeResult
) -> EffectPlanBashEncodeResult {
  if posix_name_ok(name: name) {
    accepted
  } else {
    effect_plan_bash_refuse(
      step_index: step_index,
      operation: Absent,
      cause: ShellNameInvalid { name: name }
    )
  }
}

fn effect_plan_bash_lits_nul_checked(
  lits: List<String>,
  step_index: Int,
  accepted: EffectPlanBashEncodeResult
) -> EffectPlanBashEncodeResult {
  match effect_plan_bash_argv_nul_index(argv: lits, index: 0) {
    Present { value: argument_index } =>
      effect_plan_bash_refuse(
        step_index: step_index,
        operation: Absent,
        cause: ArgumentContainsNul { argument_index: argument_index }
      )
    Absent => accepted
  }
}

fn effect_plan_bash_accept_statement(statement: Node) -> EffectPlanBashEncodeResult {
  EffectPlanBashEncodingAccepted {
    encoding: EffectPlanBashEncoded { statement: statement }
  }
}

fn effect_plan_bash_command_words(callee: String, args: List<String>) -> List<String> {
  concat([callee], args)
}

fn effect_plan_bash_encode_let(
  name: String,
  value: Expr,
  step_index: Int
) -> EffectPlanBashEncodeResult {
  effect_plan_bash_shell_name_checked(
    name: name,
    step_index: step_index,
    accepted: match value {
      ExprLit { spelling: spelling } =>
        effect_plan_bash_lits_nul_checked(
          lits: [spelling],
          step_index: step_index,
          accepted: effect_plan_bash_accept_statement(
            statement: bash_build_assign_lit(name: name, text: spelling)
          )
        )
      ExprVarRef { name: source } =>
        effect_plan_bash_shell_name_checked(
          name: source,
          step_index: step_index,
          accepted: effect_plan_bash_accept_statement(
            statement: bash_build_assign_var(name: name, var_name: source)
          )
        )
      ExprCmdSubst { callee: callee, args: args } =>
        effect_plan_bash_callee_checked(
          callee: callee,
          args: args,
          step_index: step_index,
          accepted: effect_plan_bash_accept_statement(
            statement: bash_build_assign(
              name: name,
              value: bash_build_word_cmdsubst(
                body: bash_build_command_from_lits(
                  lits: effect_plan_bash_command_words(callee: callee, args: args)
                )
              )
            )
          )
        )
    }
  )
}

// ---- Call ---------------------------------------------------------------------------------
//
// Call names a shell function (or command) by its literal name and passes each arg as one
// single-quoted word: the same command production the Do arm emits, with the callee as argv[0]. A
// callee is never interpreted as a command LINE -- "f x" is the two-character-named callee and
// fails as command-not-found rather than running f. An empty callee is a plan that calls nothing
// and refuses before the grammar sees it.

fn effect_plan_bash_callee_checked(
  callee: String,
  args: List<String>,
  step_index: Int,
  accepted: EffectPlanBashEncodeResult
) -> EffectPlanBashEncodeResult {
  if callee == "" {
    effect_plan_bash_refuse(
      step_index: step_index,
      operation: Absent,
      cause: CallCalleeEmpty
    )
  } else {
    effect_plan_bash_lits_nul_checked(
      lits: effect_plan_bash_command_words(callee: callee, args: args),
      step_index: step_index,
      accepted: accepted
    )
  }
}

fn effect_plan_bash_encode_call(
  callee: String,
  args: List<String>,
  step_index: Int
) -> EffectPlanBashEncodeResult {
  effect_plan_bash_callee_checked(
    callee: callee,
    args: args,
    step_index: step_index,
    accepted: effect_plan_bash_accept_statement(
      statement: bash_build_command_from_lits(
        lits: effect_plan_bash_command_words(callee: callee, args: args)
      )
    )
  )
}

// ---- If -----------------------------------------------------------------------------------
//
// If tests a Predicate and runs one of two nested plans. The comparison arms lower to the grammar's
// test-bracket command with every operand a single-quoted lit word; Not / And / Or are the
// grammar's negation / && / || over the operand statements (the serializer groups mixed operators).
// Each branch is encoded by the same fold as the top-level plan, so FailFast inside a branch is the
// same && relation, and a refusal inside a branch surfaces at the If step's index wrapped as
// NestedBranchRefused with the inner refusal (its step_index is branch-relative). An empty branch
// has no bash spelling (`then ; fi` is a syntax error) and refuses as IfBranchEmpty.

fn effect_plan_bash_operand_carries_shell_spelling(operand: String) -> Bool {
  string_any_char_in(
    s: operand,
    alphabet: effect_plan_bash_predicate_operand_shell_spelling_chars
  )
}

data effect_plan_bash_decimal_digit_alphabet: String = "0123456789"

// The sign is carried as a one-character alphabet rather than a Char literal: the substrate has no
// Char literal spelling, and membership in a one-character alphabet is the same question.
data effect_plan_bash_decimal_sign: String = "-"

// A NON-EMPTY run of decimal digits. The emptiness test is what refuses a bare sign, which the index
// walk expressed as an `n > 1` guard at the call site instead. `s` is host text (the kernel String
// this module's unbound spelling binds), so the test is the host length and the alphabet fold takes
// the declared unfold at its argument. A `match s { Empty .. Cons { head, tail } .. }` here was a
// FreeMonoid walk over host text with no unfold: the seed admitted it and emitted `(*__fm)[0]` over
// a Rust String (gunbc.rung_drop text_boundary_identity_wall, the match-pattern population).
fn effect_plan_bash_decimal_digits_ok(s: String) -> Bool {
  if string_length(s: s) == 0 {
    false
  } else {
    string_all_chars_in(s: s, alphabet: effect_plan_bash_decimal_digit_alphabet)
  }
}

// `[ a -ne b ]` on a non-integer prints an error and takes the ELSE branch with status 2, which is
// a wrong answer wearing a diagnostic; so an IntNe literal operand must be a decimal integer.
// A leading `-` is dropped by host substring and the rest must be a non-empty digit run, so no
// separate length guard carries that fact.
fn effect_plan_bash_decimal_integer_ok(s: String) -> Bool {
  if starts_with(s: s, prefix: effect_plan_bash_decimal_sign) {
    effect_plan_bash_decimal_digits_ok(s: substring(s: s, start: 1, end: string_length(s: s)))
  } else {
    effect_plan_bash_decimal_digits_ok(s: s)
  }
}

fn effect_plan_bash_operands_checked(
  operands: List<String>,
  step_index: Int,
  accepted: EffectPlanBashPredicateEncoding
) -> EffectPlanBashPredicateEncoding {
  match list_head(xs: operands) {
    Absent => accepted
    Present { value: operand } =>
      if effect_plan_bash_operand_carries_shell_spelling(operand: operand) {
        effect_plan_bash_predicate_refuse(
          step_index: step_index,
          cause: PredicateOperandCarriesShellSpelling { operand: operand }
        )
      } else {
        match list_tail(xs: operands) {
          Absent => accepted
          Present { value: rest } =>
            effect_plan_bash_operands_checked(
              operands: rest,
              step_index: step_index,
              accepted: accepted
            )
        }
      }
  }
}

// A predicate always yields one statement or refuses; it has no empty encoding, so it carries its
// own result type rather than EffectPlanBashEncodeResult's EffectPlanBashEmpty arm.
type EffectPlanBashPredicateEncoding
  = PredicateEncoded { statement: Node }
  | PredicateRefused { refusal: EffectPlanBashRefusal }

fn effect_plan_bash_predicate_refuse(
  step_index: Int,
  cause: EffectPlanBashRefusalCause
) -> EffectPlanBashPredicateEncoding {
  PredicateRefused {
    refusal: EffectPlanBashRefusal {
      step_index: step_index,
      operation: Absent,
      cause: cause
    }
  }
}

fn effect_plan_bash_test_words(words: List<String>) -> Node {
  bash_build_test_bracket(
    words: fold(words, init: [], f: fn(acc, w) { concat(acc, [bash_build_word_lit(text: w)]) })
  )
}

fn effect_plan_bash_encode_test(
  operands: List<String>,
  words: List<String>,
  step_index: Int
) -> EffectPlanBashPredicateEncoding {
  match effect_plan_bash_argv_nul_index(argv: operands, index: 0) {
    Present { value: argument_index } =>
      effect_plan_bash_predicate_refuse(
        step_index: step_index,
        cause: ArgumentContainsNul { argument_index: argument_index }
      )
    Absent =>
      effect_plan_bash_operands_checked(
        operands: operands,
        step_index: step_index,
        accepted: PredicateEncoded {
          statement: effect_plan_bash_test_words(words: words)
        }
      )
  }
}

fn effect_plan_bash_encode_predicate_pair(
  lhs: Predicate,
  rhs: Predicate,
  step_index: Int,
  join: fn(Node, Node) -> Node
) -> EffectPlanBashPredicateEncoding {
  match effect_plan_bash_encode_predicate(predicate: lhs, step_index: step_index) {
    PredicateRefused { refusal: refusal } => PredicateRefused { refusal: refusal }
    PredicateEncoded { statement: left } =>
      match effect_plan_bash_encode_predicate(predicate: rhs, step_index: step_index) {
        PredicateRefused { refusal: refusal } => PredicateRefused { refusal: refusal }
        PredicateEncoded { statement: right } =>
          PredicateEncoded { statement: join(left, right) }
      }
  }
}

fn effect_plan_bash_encode_predicate(
  predicate: Predicate,
  step_index: Int
) -> EffectPlanBashPredicateEncoding {
  match predicate {
    ExitZero { run: _ } =>
      effect_plan_bash_predicate_refuse(
        step_index: step_index,
        cause: UnsupportedPredicate { kind: ExitZeroRunPredicate }
      )
    LogMatches { source: _, pattern: _ } =>
      effect_plan_bash_predicate_refuse(
        step_index: step_index,
        cause: UnsupportedPredicate { kind: LogMatchesPredicate }
      )
    StrEq { lhs: lhs, rhs: rhs } =>
      effect_plan_bash_encode_test(
        operands: [lhs, rhs],
        words: [lhs, "=", rhs],
        step_index: step_index
      )
    StrEmpty { operand: operand } =>
      effect_plan_bash_encode_test(
        operands: [operand],
        words: ["-z", operand],
        step_index: step_index
      )
    StrNonempty { operand: operand } =>
      effect_plan_bash_encode_test(
        operands: [operand],
        words: ["-n", operand],
        step_index: step_index
      )
    IntNe { lhs: lhs, rhs: rhs } =>
      if !effect_plan_bash_decimal_integer_ok(s: lhs) {
        effect_plan_bash_predicate_refuse(
          step_index: step_index,
          cause: IntNeOperandNotDecimalInteger { operand: lhs }
        )
      } else if !effect_plan_bash_decimal_integer_ok(s: rhs) {
        effect_plan_bash_predicate_refuse(
          step_index: step_index,
          cause: IntNeOperandNotDecimalInteger { operand: rhs }
        )
      } else {
        effect_plan_bash_encode_test(
          operands: [lhs, rhs],
          words: [lhs, "-ne", rhs],
          step_index: step_index
        )
      }
    Not { inner: inner } =>
      match effect_plan_bash_encode_predicate(predicate: inner, step_index: step_index) {
        PredicateRefused { refusal: refusal } => PredicateRefused { refusal: refusal }
        PredicateEncoded { statement: statement } =>
          PredicateEncoded { statement: bash_build_negation(inner: statement) }
      }
    And { lhs: lhs, rhs: rhs } =>
      effect_plan_bash_encode_predicate_pair(
        lhs: lhs,
        rhs: rhs,
        step_index: step_index,
        join: fn(l, r) { bash_build_and_then(left: l, right: r) }
      )
    Or { lhs: lhs, rhs: rhs } =>
      effect_plan_bash_encode_predicate_pair(
        lhs: lhs,
        rhs: rhs,
        step_index: step_index,
        join: fn(l, r) { bash_build_or_else(left: l, right: r) }
      )
  }
}

type EffectPlanBashBranchEncoding
  = BranchEncoded { body: Node }
  | BranchRefused { refusal: EffectPlanBashRefusal }

fn effect_plan_bash_encode_branch(
  plan: EffectPlan<BashPlanEffect>,
  branch: EffectPlanBashIfBranch,
  step_index: Int
) -> EffectPlanBashBranchEncoding {
  match effect_plan_bash_encode(plan: plan) {
    EffectPlanBashEncodingRefused { refusal: inner } =>
      BranchRefused {
        refusal: EffectPlanBashRefusal {
          step_index: step_index,
          operation: Absent,
          cause: NestedBranchRefused { branch: branch, refusal: inner }
        }
      }
    EffectPlanBashEncodingAccepted { encoding: encoding } =>
      match encoding {
        EffectPlanBashEmpty =>
          BranchRefused {
            refusal: EffectPlanBashRefusal {
              step_index: step_index,
              operation: Absent,
              cause: IfBranchEmpty { branch: branch }
            }
          }
        EffectPlanBashEncoded { statement: statement } =>
          BranchEncoded { body: bash_build_stmt_list_single(stmt: statement) }
      }
  }
}

fn effect_plan_bash_encode_if(
  cond: Predicate,
  then_: EffectPlan<BashPlanEffect>,
  else_: Optional<EffectPlan<BashPlanEffect>>,
  step_index: Int
) -> EffectPlanBashEncodeResult {
  match effect_plan_bash_encode_predicate(predicate: cond, step_index: step_index) {
    PredicateRefused { refusal: refusal } =>
      EffectPlanBashEncodingRefused { refusal: refusal }
    PredicateEncoded { statement: cond_statement } =>
      match effect_plan_bash_encode_branch(
        plan: then_,
        branch: ThenBranch,
        step_index: step_index
      ) {
        BranchRefused { refusal: refusal } =>
          EffectPlanBashEncodingRefused { refusal: refusal }
        BranchEncoded { body: then_body } =>
          match else_ {
            Absent =>
              effect_plan_bash_accept_statement(
                statement: bash_build_if(cond: cond_statement, body: then_body)
              )
            Present { value: else_plan } =>
              match effect_plan_bash_encode_branch(
                plan: else_plan,
                branch: ElseBranch,
                step_index: step_index
              ) {
                BranchRefused { refusal: refusal } =>
                  EffectPlanBashEncodingRefused { refusal: refusal }
                BranchEncoded { body: else_body } =>
                  effect_plan_bash_accept_statement(
                    statement: bash_build_if_else(
                      cond: cond_statement,
                      then_body: then_body,
                      else_body: else_body
                    )
                  )
              }
          }
      }
  }
}

fn effect_plan_bash_and_then(
  left: EffectPlanBashEncoding,
  right: EffectPlanBashEncoding
) -> EffectPlanBashEncoding {
  match left {
    EffectPlanBashEmpty => right
    EffectPlanBashEncoded { statement: left_statement } =>
      match right {
        EffectPlanBashEmpty => left
        EffectPlanBashEncoded { statement: right_statement } =>
          EffectPlanBashEncoded {
            statement: bash_build_and_then(
              left: left_statement,
              right: right_statement
            )
          }
      }
  }
}

fn effect_plan_bash_encode_steps(
  steps: List<EffectPlanStep<BashPlanEffect>>,
  step_index: Int
) -> EffectPlanBashEncodeResult {
  match list_head(xs: steps) {
    Absent =>
      EffectPlanBashEncodingAccepted { encoding: EffectPlanBashEmpty }
    Present { value: step } =>
      match effect_plan_bash_encode_step(step: step, step_index: step_index) {
        EffectPlanBashEncodingRefused { refusal: refusal } =>
          EffectPlanBashEncodingRefused { refusal: refusal }
        EffectPlanBashEncodingAccepted { encoding: first } =>
          match list_tail(xs: steps) {
            Absent =>
              EffectPlanBashEncodingAccepted { encoding: first }
            Present { value: rest } =>
              match effect_plan_bash_encode_steps(
                steps: rest,
                step_index: step_index + 1
              ) {
                EffectPlanBashEncodingRefused { refusal: refusal } =>
                  EffectPlanBashEncodingRefused { refusal: refusal }
                EffectPlanBashEncodingAccepted { encoding: tail_encoding } =>
                  EffectPlanBashEncodingAccepted {
                    encoding: effect_plan_bash_and_then(
                      left: first,
                      right: tail_encoding
                    )
                  }
              }
          }
      }
  }
}

fn effect_plan_bash_encode(
  plan: EffectPlan<BashPlanEffect>
) -> EffectPlanBashEncodeResult {
  match plan.on_failure {
    Continue =>
      effect_plan_bash_refuse(
        step_index: -1,
        operation: Absent,
        cause: UnsupportedFailurePolicy { policy: Continue }
      )
    FailFast =>
      effect_plan_bash_encode_steps(steps: plan.steps, step_index: 0)
  }
}

fn effect_plan_bash_unsupported_step_label(
  kind: EffectPlanBashUnsupportedStep
) -> String {
  match kind {
    UnsupportedFor => "For"
    UnsupportedWhile => "While"
    UnsupportedRetry => "Retry"
  }
}

fn effect_plan_bash_failure_policy_label(policy: FailurePolicy) -> String {
  match policy {
    Continue => "Continue"
    FailFast => "FailFast"
  }
}

fn effect_plan_bash_cause_label(cause: EffectPlanBashRefusalCause) -> String {
  match cause {
    UnsupportedFailurePolicy { policy: policy } =>
      concat(
        "UnsupportedFailurePolicy:",
        effect_plan_bash_failure_policy_label(policy: policy)
      )
    UnsupportedEffectPlanStep { kind: kind } =>
      concat(
        "UnsupportedEffectPlanStep:",
        effect_plan_bash_unsupported_step_label(kind: kind)
      )
    OperationArgvRefused { cause: argv_cause } =>
      concat(
        "OperationArgvRefused:",
        operation_argv_cause_label(cause: argv_cause)
      )
    ArgumentContainsNul { argument_index: argument_index } =>
      concat("ArgumentContainsNul:", to_string(argument_index))
    BashGrammarEmissionRefused { diagnostics: _ } =>
      "BashGrammarEmissionRefused"
    UnsupportedPredicate { kind: kind } =>
      concat(
        "UnsupportedPredicate:",
        effect_plan_bash_unsupported_predicate_label(kind: kind)
      )
    PredicateOperandCarriesShellSpelling { operand: operand } =>
      concat("PredicateOperandCarriesShellSpelling:", operand)
    IntNeOperandNotDecimalInteger { operand: operand } =>
      concat("IntNeOperandNotDecimalInteger:", operand)
    ShellNameInvalid { name: name } => concat("ShellNameInvalid:", name)
    CallCalleeEmpty => "CallCalleeEmpty"
    IfBranchEmpty { branch: branch } =>
      concat("IfBranchEmpty:", effect_plan_bash_if_branch_label(branch: branch))
    NestedBranchRefused { branch: branch, refusal: inner } =>
      concat(
        concat(
          concat("NestedBranchRefused:", effect_plan_bash_if_branch_label(branch: branch)),
          ":"
        ),
        effect_plan_bash_refusal_label(refusal: inner)
      )
  }
}

fn effect_plan_bash_unsupported_predicate_label(
  kind: EffectPlanBashUnsupportedPredicate
) -> String {
  match kind {
    ExitZeroRunPredicate => "ExitZero"
    LogMatchesPredicate => "LogMatches"
  }
}

fn effect_plan_bash_if_branch_label(branch: EffectPlanBashIfBranch) -> String {
  match branch {
    ThenBranch => "Then"
    ElseBranch => "Else"
  }
}

fn effect_plan_bash_operation_label(
  operation: Optional<OperationRef>
) -> String {
  match operation {
    Present { value: at } => concat(" at ", operation_argv_ref_label(at: at))
    Absent => ""
  }
}

fn effect_plan_bash_refusal_label(refusal: EffectPlanBashRefusal) -> String {
  let _note = effect_plan_bash_refusal_label_note
  concat(
    concat(
      concat("step ", to_string(refusal.step_index)),
      effect_plan_bash_operation_label(operation: refusal.operation)
    ),
    concat(": ", effect_plan_bash_cause_label(cause: refusal.cause))
  )
}

fn effect_plan_bash_materialize(
  plan: EffectPlan<BashPlanEffect>
) -> EffectPlanBashMaterialization {
  match effect_plan_bash_encode(plan: plan) {
    EffectPlanBashEncodingRefused { refusal: refusal } =>
      EffectPlanBashMaterializationRefused { refusal: refusal }
    EffectPlanBashEncodingAccepted { encoding: encoding } =>
      match encoding {
        EffectPlanBashEmpty =>
          EffectPlanBashMaterialized { source: "" }
        EffectPlanBashEncoded { statement: statement } =>
          match bash_fold_serialize_node(stmt: statement) {
            Accepted { value: source, diagnostics: _ } =>
              EffectPlanBashMaterialized { source: source }
            Rejected { diagnostics: diagnostics } =>
              EffectPlanBashMaterializationRefused {
                refusal: EffectPlanBashRefusal {
                  step_index: -1,
                  operation: Absent,
                  cause: BashGrammarEmissionRefused {
                    diagnostics: diagnostics
                  }
                }
              }
          }
      }
  }
}
