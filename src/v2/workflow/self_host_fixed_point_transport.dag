module v2.workflow.self_host_fixed_point_transport

import extdeps.shell
import std.disposition { Disposition, RealizationDispatch, Scaffold }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.logic { Bool }
import extdeps.languages.bash.program {
  ShellProgram, ShellStmt,
  Command,
  lit, var_ref, command, serialize_bash
}
import tools.host_prelude { ensure_regen_stage0_built }
import tools.regen_verify_transport { run_regen_verify }

data self_host_fixpoint_native_runner_disposition: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "tools.regen_verify_transport",
    decl_name: "run_regen_verify",
    field: WholeDeclaration
  }
}

fn self_host_fixpoint_verify_program() -> ShellProgram {
  let root = var_ref(name: "ROOT")
  let regen = var_ref(name: "REGEN_STAGE0")
  ShellProgram {
    set_e: true,
    statements: concat(ensure_regen_stage0_built(), [
      command(words: [lit(text: "cd"), root]),
      command(words: [regen, lit(text: "--verify")])
    ])
  }
}

fn run_native_self_host_fixpoint_verify() -> Bool {
  run_regen_verify()
}

fn run_native_self_host_fixpoint_verify_direct() -> Bool {
  let result = shell.Exec.Run(script: serialize_bash(p: self_host_fixpoint_verify_program()))
  result.success
}
