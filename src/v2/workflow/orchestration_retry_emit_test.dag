module v2.workflow.orchestration_retry_emit_test

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data orch_retry_golden_note: String = "ci_cargo_eagain_retry_core_golden below is the HAND-AUTHORED spelling of the CI EAGAIN-retry construct, moved here verbatim when production gunbc.ci_spec cut over to emit(Retry, Bash). It is deliberately independent of the grammar rows and segment spellings: the byte tests compare the emitter (and the production seam) against this golden, so a row/segment/emitter regression cannot go green by perturbing both sides at once. The committed .github/workflows/ci.yml drift gate is the corpus-level twin of this oracle."

fn ci_cargo_eagain_retry_core_golden(command: String) -> String {
  concat(
    concat(
      concat("BUILD_LOG=$(mktemp)\n", "if ! ("),
      concat(command, ") 2>&1 | tee \"$BUILD_LOG\"; then\n")
    ),
    concat(
      concat(
        concat(concat("  if grep -qiE '", gunbc.ci_failure_class.infra_retry_grep_alternation()), "' \"$BUILD_LOG\"; then\n"),
        "    echo \"::warning::cargo/sccache EAGAIN under fleet pressure; cold retry CARGO_BUILD_JOBS=1 (keep sccache)\"\n"
      ),
      concat(
        concat("    CARGO_BUILD_JOBS=1 ", concat(command, "\n")),
        concat(
          concat("  else\n", "    exit 1\n"),
          concat("  fi\n", concat("fi\n", "rm -f \"$BUILD_LOG\"\n"))
        )
      )
    )
  )
}

fn orch_retry_probe_facts(key: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  v2.std.optional.optional_absent()
}

test fn orch_retry_row_direct_emit_accepted_holds() -> Bool {
  match v2.compiler.emit.emit(
    tree: v2.compiler.inferred_tree.InferredTree {
      test.claim.extdeps_llm_claude_trust_witness.root: v2.extdeps.languages.bash.orch_retry_emitted_command,
      facts: std.algebra.PartialFunction { lookup: orch_retry_probe_facts }
    },
    target: v2.extdeps.languages.bash.orch_retry_target_model(
      occ1: "cmd",
      occ2: "E=1 cmd",
      occ3: "env -u W E=1 cmd",
      pattern1: "pat",
      pattern2: "pat",
      warn1: "w1",
      warn2: "w2",
      exhausted: "exit 1"
    )
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn orch_retry_perturbed_level2() -> v2.std.orchestration.EscalationLevel {
  v2.std.orchestration.EscalationLevel {
    detect: v2.std.orchestration.LogMatches { source: "RETRY_LOG", pattern: gunbc.ci_failure_class.infra_retry_grep_alternation() },
    warning: v2.std.diagnostic.EmitDirective {
      severity: v2.std.diagnostic.SeverityWarning,
      message: "cargo/sccache still failing; retry without RUSTC_WRAPPER"
    },
    env: [
      v2.std.orchestration.EnvUnset { name: "RUSTC_WRAPPER" },
      v2.std.orchestration.EnvSet { name: "CARGO_BUILD_JOBS", value: "2" }
    ]
  }
}

fn orch_retry_level1_from(e: std.algebra.FreeMonoid<v2.std.orchestration.EscalationLevel>) -> v2.std.orchestration.EscalationLevel {
  match v2.std.algebra.list_head(xs: e) {
    HeadFound { value: l } => l
    HeadAbsent => orch_retry_perturbed_level2()
  }
}

fn orch_retry_perturbed_intent() -> v2.std.orchestration.PipelineStep {
  match v2.test.manual.retry_eagain_bash.retry_eagain_intent() {
    Retry { body: b, escalations: e, on_exhausted: x } =>
      v2.std.orchestration.Retry {
        body: b,
        escalations: [orch_retry_level1_from(e: e), orch_retry_perturbed_level2()],
        on_exhausted: x
      }
    Do { run: _ } => v2.test.manual.retry_eagain_bash.retry_eagain_intent()
    Comment { text: _ } => v2.test.manual.retry_eagain_bash.retry_eagain_intent()
    Exit { status: _ } => v2.test.manual.retry_eagain_bash.retry_eagain_intent()
    If { cond: _, then_: _, else_: _ } => v2.test.manual.retry_eagain_bash.retry_eagain_intent()
    For { binder: _, over: _, body: _ } => v2.test.manual.retry_eagain_bash.retry_eagain_intent()
    While { cond: _, body: _ } => v2.test.manual.retry_eagain_bash.retry_eagain_intent()
    Let { name: _, value: _ } => v2.test.manual.retry_eagain_bash.retry_eagain_intent()
    Call { callee: _, args: _ } => v2.test.manual.retry_eagain_bash.retry_eagain_intent()
  }
}

test fn orch_retry_byte_identical_to_hand_authored_holds() -> Bool {
  match v2.compiler.emit_orchestration.orch_emit_step(s: v2.test.manual.retry_eagain_bash.retry_eagain_intent(), medium: v2.extdeps.languages.bash_orchestration_emit.bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: dg } =>
      (source.carried == ci_cargo_eagain_retry_core_golden(command: v2.test.manual.retry_eagain_bash.retry_eagain_example_command))
        && (dg == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_retry_production_seam_matches_golden_holds() -> Bool {
  let produced = v2.workflow.ci_retry_emit.ci_cargo_eagain_retry_core(command: v2.test.manual.retry_eagain_bash.retry_eagain_example_command)
  produced == ci_cargo_eagain_retry_core_golden(command: v2.test.manual.retry_eagain_bash.retry_eagain_example_command)
}

test fn orch_retry_env_value_has_teeth_holds() -> Bool {
  match v2.compiler.emit_orchestration.orch_emit_step(s: orch_retry_perturbed_intent(), medium: v2.extdeps.languages.bash_orchestration_emit.bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: _ } =>
      source.carried != ci_cargo_eagain_retry_core_golden(command: v2.test.manual.retry_eagain_bash.retry_eagain_example_command)
    Rejected { diagnostics: _ } => false
  }
}

fn orch_retry_perturbed_exhausted_intent() -> v2.std.orchestration.PipelineStep {
  match v2.test.manual.retry_eagain_bash.retry_eagain_intent() {
    Retry { body: b, escalations: e, on_exhausted: _ } =>
      v2.std.orchestration.Retry {
        body: b,
        escalations: e,
        on_exhausted: v2.std.orchestration.Pipeline {
          steps: [v2.std.orchestration.Do { run: v2.std.orchestration.Run { command: "exit 2", env: Empty, redirect: v2.std.optional.Absent, capture: v2.std.optional.Absent } }],
          on_failure: v2.std.orchestration.FailFast
        }
      }
    Do { run: _ } => v2.test.manual.retry_eagain_bash.retry_eagain_intent()
    Comment { text: _ } => v2.test.manual.retry_eagain_bash.retry_eagain_intent()
    Exit { status: _ } => v2.test.manual.retry_eagain_bash.retry_eagain_intent()
    If { cond: _, then_: _, else_: _ } => v2.test.manual.retry_eagain_bash.retry_eagain_intent()
    For { binder: _, over: _, body: _ } => v2.test.manual.retry_eagain_bash.retry_eagain_intent()
    While { cond: _, body: _ } => v2.test.manual.retry_eagain_bash.retry_eagain_intent()
    Let { name: _, value: _ } => v2.test.manual.retry_eagain_bash.retry_eagain_intent()
    Call { callee: _, args: _ } => v2.test.manual.retry_eagain_bash.retry_eagain_intent()
  }
}

test fn orch_retry_exhausted_has_teeth_holds() -> Bool {
  match v2.compiler.emit_orchestration.orch_emit_step(s: orch_retry_perturbed_exhausted_intent(), medium: v2.extdeps.languages.bash_orchestration_emit.bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: _ } =>
      source.carried != ci_cargo_eagain_retry_core_golden(command: v2.test.manual.retry_eagain_bash.retry_eagain_example_command)
    Rejected { diagnostics: _ } => false
  }
}

data orch_retry_1level_probe_command: String = "probe_cmd"

data orch_retry_1level_exhausted_command: String = "exit 9"

fn orch_retry_1level_escalation() -> v2.std.orchestration.EscalationLevel {
  v2.std.orchestration.EscalationLevel {
    detect: v2.std.orchestration.LogMatches { source: "BUILD_LOG", pattern: "PAT1" },
    warning: v2.std.diagnostic.EmitDirective {
      severity: v2.std.diagnostic.SeverityWarning,
      message: "w1"
    },
    env: [v2.std.orchestration.EnvSet { name: "E1", value: "1" }]
  }
}

fn orch_retry_1level_intent() -> v2.std.orchestration.PipelineStep {
  v2.std.orchestration.Retry {
    body: v2.std.orchestration.Pipeline {
      steps: [
        v2.std.orchestration.Do {
          run: v2.std.orchestration.Run {
            command: orch_retry_1level_probe_command,
            env: Empty,
            redirect: v2.std.optional.Absent,
            capture: v2.std.optional.Absent
          }
        }
      ],
      on_failure: v2.std.orchestration.FailFast
    },
    escalations: [orch_retry_1level_escalation()],
    on_exhausted: v2.std.orchestration.Pipeline {
      steps: [
        v2.std.orchestration.Do {
          run: v2.std.orchestration.Run {
            command: orch_retry_1level_exhausted_command,
            env: Empty,
            redirect: v2.std.optional.Absent,
            capture: v2.std.optional.Absent
          }
        }
      ],
      on_failure: v2.std.orchestration.FailFast
    }
  }
}

fn orch_retry_1level_golden() -> String {
  concat(
    concat(
      concat("BUILD_LOG=$(mktemp)\n", "if ! ("),
      concat(orch_retry_1level_probe_command, ") 2>&1 | tee \"$BUILD_LOG\"; then\n")
    ),
    concat(
      concat(
        concat(concat("  if grep -qiE 'PAT1' \"$BUILD_LOG\"; then\n", "    echo \"::warning::w1\"\n"),
        concat("    E1=1 ", concat(orch_retry_1level_probe_command, "\n")))
      ),
      concat(
        concat(concat("  else\n    ", orch_retry_1level_exhausted_command), "\n"),
        concat("  fi\n", "fi\nrm -f \"$BUILD_LOG\"\n")
      )
    )
  )
}

fn orch_retry_1level_perturbed_intent() -> v2.std.orchestration.PipelineStep {
  match orch_retry_1level_intent() {
    Retry { body: b, escalations: e, on_exhausted: x } =>
      v2.std.orchestration.Retry {
        body: b,
        escalations: [
          v2.std.orchestration.EscalationLevel {
            detect: v2.std.orchestration.LogMatches { source: "BUILD_LOG", pattern: "PAT1" },
            warning: v2.std.diagnostic.EmitDirective {
              severity: v2.std.diagnostic.SeverityWarning,
              message: "w1"
            },
            env: [v2.std.orchestration.EnvSet { name: "E1", value: "2" }]
          }
        ],
        on_exhausted: x
      }
    Do { run: _ } => orch_retry_1level_intent()
    Comment { text: _ } => orch_retry_1level_intent()
    Exit { status: _ } => orch_retry_1level_intent()
    If { cond: _, then_: _, else_: _ } => orch_retry_1level_intent()
    For { binder: _, over: _, body: _ } => orch_retry_1level_intent()
    While { cond: _, body: _ } => orch_retry_1level_intent()
    Let { name: _, value: _ } => orch_retry_1level_intent()
    Call { callee: _, args: _ } => orch_retry_1level_intent()
  }
}

test fn orch_retry_1level_emit_matches_golden_holds() -> Bool {
  match v2.compiler.emit_orchestration.orch_emit_step(s: orch_retry_1level_intent(), medium: v2.extdeps.languages.bash_orchestration_emit.bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: dg } =>
      (source.carried == orch_retry_1level_golden()) && (dg == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_retry_1level_emit_has_teeth_holds() -> Bool {
  match v2.compiler.emit_orchestration.orch_emit_step(s: orch_retry_1level_perturbed_intent(), medium: v2.extdeps.languages.bash_orchestration_emit.bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: _ } =>
      source.carried != orch_retry_1level_golden()
    Rejected { diagnostics: _ } => false
  }
}

