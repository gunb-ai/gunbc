import gunbc.ci_failure_class { infra_retry_grep_alternation }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data orch_retry_golden_note: String = "ci_cargo_eagain_retry_core_golden below is the HAND-AUTHORED spelling of the CI EAGAIN-retry construct, moved here verbatim when production gunbc.ci_spec cut over to emit(Retry, Bash). It is deliberately independent of the grammar rows and segment spellings: the byte tests compare the emitter (and the production seam) against this golden, so a row/segment/emitter regression cannot go green by perturbing both sides at once. The committed .github/workflows/ci.yml drift gate is the corpus-level twin of this oracle."

fn ci_cargo_eagain_retry_core_golden(command: String) -> String {
  concat(
    concat(
      concat("BUILD_LOG=$(mktemp)\n", "if ! ("),
      concat(command, ") 2>&1 | tee \"$BUILD_LOG\"; then\n")
    ),
    concat(
      concat(
        concat(concat("  if grep -qiE '", infra_retry_grep_alternation()), "' \"$BUILD_LOG\"; then\n"),
        "    echo \"::warning::cargo/sccache EAGAIN under fleet pressure; cold retry CARGO_BUILD_JOBS=1 (keep sccache)\"\n"
      ),
      concat(
        concat("    CARGO_BUILD_JOBS=1 ", concat(command, "\n")),
        concat(
          concat("  else\n", "    exit 1\n"),
          concat("  fi\n", concat("fi\n", "rm -f \"$BUILD_LOG\"\n"))
        )
      )
    )
  )
}

fn orch_retry_probe_facts(key: Node) -> Optional<InferredFacts> {
  optional_absent()
}

test fn orch_retry_row_direct_emit_accepted_holds() -> Bool {
  match emit(
    tree: InferredTree {
      root: orch_retry_emitted_command,
      facts: Map { lookup: orch_retry_probe_facts }
    },
    target: orch_retry_target_model(
      occ1: "cmd",
      occ2: "E=1 cmd",
      occ3: "env -u W E=1 cmd",
      pattern1: "pat",
      pattern2: "pat",
      warn1: "w1",
      warn2: "w2",
      exhausted: "exit 1"
    )
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn orch_retry_perturbed_level2() -> EscalationLevel {
  EscalationLevel {
    detect: LogMatches { source: "RETRY_LOG", pattern: infra_retry_grep_alternation() },
    warning: EmitDirective {
      severity: SeverityWarning,
      message: "cargo/sccache still failing; retry without RUSTC_WRAPPER"
    },
    env: [
      EnvUnset { name: "RUSTC_WRAPPER" },
      EnvSet { name: "CARGO_BUILD_JOBS", value: "2" }
    ]
  }
}

fn orch_retry_level1_from(e: FreeMonoid<EscalationLevel>) -> EscalationLevel {
  match list_head(xs: e) {
    HeadFound { value: l } => l
    HeadAbsent => orch_retry_perturbed_level2()
  }
}

fn orch_retry_perturbed_intent() -> PipelineStep {
  match retry_eagain_intent() {
    Retry { body: b, escalations: e, on_exhausted: x } =>
      Retry {
        body: b,
        escalations: [orch_retry_level1_from(e: e), orch_retry_perturbed_level2()],
        on_exhausted: x
      }
    Do { run: _ } => retry_eagain_intent()
    Comment { text: _ } => retry_eagain_intent()
    If { cond: _, then_: _, else_: _ } => retry_eagain_intent()
    For { binder: _, over: _, body: _ } => retry_eagain_intent()
    While { cond: _, body: _ } => retry_eagain_intent()
    BoundedPoll { max_attempts: _, body: _, success: _ } => retry_eagain_intent()
    Let { name: _, value: _ } => retry_eagain_intent()
    Call { callee: _, args: _ } => retry_eagain_intent()
  }
}

test fn orch_retry_byte_identical_to_hand_authored_holds() -> Bool {
  match orch_emit_step(s: retry_eagain_intent(), medium: bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: dg } =>
      (source.carried == ci_cargo_eagain_retry_core_golden(command: retry_eagain_example_command))
        && (dg == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_retry_production_seam_matches_golden_holds() -> Bool {
  let produced = ci_cargo_eagain_retry_core(command: retry_eagain_example_command)
  produced == ci_cargo_eagain_retry_core_golden(command: retry_eagain_example_command)
}

test fn orch_retry_env_value_has_teeth_holds() -> Bool {
  match orch_emit_step(s: orch_retry_perturbed_intent(), medium: bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: _ } =>
      source.carried != ci_cargo_eagain_retry_core_golden(command: retry_eagain_example_command)
    Rejected { diagnostics: _ } => false
  }
}

fn orch_retry_perturbed_exhausted_intent() -> PipelineStep {
  match retry_eagain_intent() {
    Retry { body: b, escalations: e, on_exhausted: _ } =>
      Retry {
        body: b,
        escalations: e,
        on_exhausted: Pipeline {
          steps: [Do { run: Run { command: "exit 2", env: [], redirect: Absent, capture: Absent } }],
          on_failure: FailFast
        }
      }
    Do { run: _ } => retry_eagain_intent()
    Comment { text: _ } => retry_eagain_intent()
    If { cond: _, then_: _, else_: _ } => retry_eagain_intent()
    For { binder: _, over: _, body: _ } => retry_eagain_intent()
    While { cond: _, body: _ } => retry_eagain_intent()
    BoundedPoll { max_attempts: _, body: _, success: _ } => retry_eagain_intent()
    Let { name: _, value: _ } => retry_eagain_intent()
    Call { callee: _, args: _ } => retry_eagain_intent()
  }
}

test fn orch_retry_exhausted_has_teeth_holds() -> Bool {
  match orch_emit_step(s: orch_retry_perturbed_exhausted_intent(), medium: bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: _ } =>
      source.carried != ci_cargo_eagain_retry_core_golden(command: retry_eagain_example_command)
    Rejected { diagnostics: _ } => false
  }
}

data orch_retry_1level_probe_command: String = "probe_cmd"

data orch_retry_1level_exhausted_command: String = "exit 9"

fn orch_retry_1level_escalation() -> EscalationLevel {
  EscalationLevel {
    detect: LogMatches { source: "BUILD_LOG", pattern: "PAT1" },
    warning: EmitDirective {
      severity: SeverityWarning,
      message: "w1"
    },
    env: [EnvSet { name: "E1", value: "1" }]
  }
}

fn orch_retry_1level_intent() -> PipelineStep {
  Retry {
    body: Pipeline {
      steps: [
        Do {
          run: Run {
            command: orch_retry_1level_probe_command,
            env: [],
            redirect: Absent,
            capture: Absent
          }
        }
      ],
      on_failure: FailFast
    },
    escalations: [orch_retry_1level_escalation()],
    on_exhausted: Pipeline {
      steps: [
        Do {
          run: Run {
            command: orch_retry_1level_exhausted_command,
            env: [],
            redirect: Absent,
            capture: Absent
          }
        }
      ],
      on_failure: FailFast
    }
  }
}

fn orch_retry_1level_golden() -> String {
  concat(
    concat(
      concat("BUILD_LOG=$(mktemp)\n", "if ! ("),
      concat(orch_retry_1level_probe_command, ") 2>&1 | tee \"$BUILD_LOG\"; then\n")
    ),
    concat(
      concat(
        concat(concat("  if grep -qiE 'PAT1' \"$BUILD_LOG\"; then\n", "    echo \"::warning::w1\"\n"),
        concat("    E1=1 ", concat(orch_retry_1level_probe_command, "\n")))
      ),
      concat(
        concat(concat("  else\n    ", orch_retry_1level_exhausted_command), "\n"),
        concat("  fi\n", "fi\nrm -f \"$BUILD_LOG\"\n")
      )
    )
  )
}

fn orch_retry_1level_perturbed_intent() -> PipelineStep {
  match orch_retry_1level_intent() {
    Retry { body: b, escalations: e, on_exhausted: x } =>
      Retry {
        body: b,
        escalations: [
          EscalationLevel {
            detect: LogMatches { source: "BUILD_LOG", pattern: "PAT1" },
            warning: EmitDirective {
              severity: SeverityWarning,
              message: "w1"
            },
            env: [EnvSet { name: "E1", value: "2" }]
          }
        ],
        on_exhausted: x
      }
    Do { run: _ } => orch_retry_1level_intent()
    Comment { text: _ } => orch_retry_1level_intent()
    If { cond: _, then_: _, else_: _ } => orch_retry_1level_intent()
    For { binder: _, over: _, body: _ } => orch_retry_1level_intent()
    While { cond: _, body: _ } => orch_retry_1level_intent()
    BoundedPoll { max_attempts: _, body: _, success: _ } => orch_retry_1level_intent()
    Let { name: _, value: _ } => orch_retry_1level_intent()
    Call { callee: _, args: _ } => orch_retry_1level_intent()
  }
}

test fn orch_retry_1level_emit_matches_golden_holds() -> Bool {
  match orch_emit_step(s: orch_retry_1level_intent(), medium: bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: dg } =>
      (source.carried == orch_retry_1level_golden()) && (dg == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_retry_1level_emit_has_teeth_holds() -> Bool {
  match orch_emit_step(s: orch_retry_1level_perturbed_intent(), medium: bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: _ } =>
      source.carried != orch_retry_1level_golden()
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_retry_escalation_final_row_emit_holds() -> Bool {
  match emit(
    tree: InferredTree {
      root: orch_retry_escalation_final_emitted_command,
      facts: Map { lookup: orch_retry_probe_facts }
    },
    target: orch_retry_escalation_final_target_model(
      occ: "E3=1 cmd",
      exhausted: "exit 9"
    )
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_retry_escalation_step_row_emit_holds() -> Bool {
  match emit(
    tree: InferredTree {
      root: orch_retry_escalation_step_emitted_command,
      facts: Map { lookup: orch_retry_probe_facts }
    },
    target: orch_retry_escalation_step_target_model(
      occ: "E2=1 cmd",
      pattern: "PAT2",
      warn: "w2",
      inner: "E3=1 cmd || exit 9",
      exhausted: "exit 9"
    )
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_retry_1level_row_direct_emit_accepted_holds() -> Bool {
  match emit(
    tree: InferredTree {
      root: orch_retry_1level_emitted_command,
      facts: Map { lookup: orch_retry_probe_facts }
    },
    target: orch_retry_1level_target_model(
      occ1: "cmd",
      occ2: "E=1 cmd",
      pattern1: "pat",
      warn1: "w1",
      exhausted: "exit 1"
    )
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn orch_retry_level2_escalation() -> EscalationLevel {
  EscalationLevel {
    detect: LogMatches { source: "RETRY_LOG", pattern: "PAT2" },
    warning: EmitDirective {
      severity: SeverityWarning,
      message: "w2"
    },
    env: [EnvSet { name: "E2", value: "1" }]
  }
}

fn orch_retry_level3_escalation() -> EscalationLevel {
  EscalationLevel {
    detect: LogMatches { source: "RETRY_LOG", pattern: "PAT3" },
    warning: EmitDirective {
      severity: SeverityWarning,
      message: "w3"
    },
    env: [EnvSet { name: "E3", value: "1" }]
  }
}

fn orch_retry_3level_intent() -> PipelineStep {
  Retry {
    body: Pipeline {
      steps: [
        Do {
          run: Run {
            command: orch_retry_1level_probe_command,
            env: [],
            redirect: Absent,
            capture: Absent
          }
        }
      ],
      on_failure: FailFast
    },
    escalations: [
      orch_retry_1level_escalation(),
      orch_retry_level2_escalation(),
      orch_retry_level3_escalation()
    ],
    on_exhausted: Pipeline {
      steps: [
        Do {
          run: Run {
            command: orch_retry_1level_exhausted_command,
            env: [],
            redirect: Absent,
            capture: Absent
          }
        }
      ],
      on_failure: FailFast
    }
  }
}

fn orch_retry_3level_golden() -> String {
  concat(
    concat(
      concat("BUILD_LOG=$(mktemp)\n", "if ! ("),
      concat(orch_retry_1level_probe_command, ") 2>&1 | tee \"$BUILD_LOG\"; then\n")
    ),
    concat(
      concat(
        concat(concat("  if grep -qiE 'PAT1' \"$BUILD_LOG\"; then\n", "    echo \"::warning::w1\"\n"),
        concat(
          concat("    RETRY_LOG=$(mktemp)\n", "    if ! ( "),
          concat(
            concat("E2=1 ", concat(orch_retry_1level_probe_command, " ) 2>&1 | tee \"$RETRY_LOG\"; then\n")),
            concat(
              concat(
                concat(concat("      if grep -qiE 'PAT2' \"$RETRY_LOG\"; then\n", "        echo \"::warning::w2\"\n"),
                concat("        E3=1 ", concat(orch_retry_1level_probe_command, " || ")))
              ),
              concat(
                concat(orch_retry_1level_exhausted_command, "\n"),
                concat(
                  concat("      else\n        ", orch_retry_1level_exhausted_command),
                  concat(
                    concat("\n      fi\n    fi\n", "    rm -f \"$RETRY_LOG\""),
                    concat(
                      concat("\n  else\n    ", orch_retry_1level_exhausted_command),
                      concat("\n  fi\nfi\nrm -f \"$BUILD_LOG\"\n", "")
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  ))
}

fn orch_retry_3level_perturbed_intent() -> PipelineStep {
  match orch_retry_3level_intent() {
    Retry { body: b, escalations: e, on_exhausted: x } =>
      Retry {
        body: b,
        escalations: [
          orch_retry_1level_escalation(),
          orch_retry_level2_escalation(),
          EscalationLevel {
            detect: LogMatches { source: "RETRY_LOG", pattern: "PAT3" },
            warning: EmitDirective {
              severity: SeverityWarning,
              message: "w3"
            },
            env: [EnvSet { name: "E3", value: "9" }]
          }
        ],
        on_exhausted: x
      }
    Do { run: _ } => orch_retry_3level_intent()
    Comment { text: _ } => orch_retry_3level_intent()
    If { cond: _, then_: _, else_: _ } => orch_retry_3level_intent()
    For { binder: _, over: _, body: _ } => orch_retry_3level_intent()
    While { cond: _, body: _ } => orch_retry_3level_intent()
    BoundedPoll { max_attempts: _, body: _, success: _ } => orch_retry_3level_intent()
    Let { name: _, value: _ } => orch_retry_3level_intent()
    Call { callee: _, args: _ } => orch_retry_3level_intent()
  }
}

test fn orch_retry_3level_emit_matches_golden_holds() -> Bool {
  match orch_emit_step(s: orch_retry_3level_intent(), medium: bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: dg } =>
      (source.carried == orch_retry_3level_golden()) && (dg == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_retry_3level_emit_has_teeth_holds() -> Bool {
  match orch_emit_step(s: orch_retry_3level_perturbed_intent(), medium: bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: _ } =>
      source.carried != orch_retry_3level_golden()
    Rejected { diagnostics: _ } => false
  }
}
