fn orch_retry_level2_escalation() -> v2.std.orchestration.EscalationLevel {
  v2.std.orchestration.EscalationLevel {
    detect: v2.std.orchestration.LogMatches { source: "RETRY_LOG", pattern: "PAT2" },
    warning: v2.std.diagnostic.EmitDirective {
      severity: v2.std.diagnostic.SeverityWarning,
      message: "w2"
    },
    env: [v2.std.orchestration.EnvSet { name: "E2", value: "1" }]
  }
}

fn orch_retry_level3_escalation() -> v2.std.orchestration.EscalationLevel {
  v2.std.orchestration.EscalationLevel {
    detect: v2.std.orchestration.LogMatches { source: "RETRY_LOG", pattern: "PAT3" },
    warning: v2.std.diagnostic.EmitDirective {
      severity: v2.std.diagnostic.SeverityWarning,
      message: "w3"
    },
    env: [v2.std.orchestration.EnvSet { name: "E3", value: "1" }]
  }
}

fn orch_retry_3level_intent() -> v2.std.orchestration.PipelineStep {
  v2.std.orchestration.Retry {
    body: v2.std.orchestration.Pipeline {
      steps: [
        v2.std.orchestration.Do {
          run: v2.std.orchestration.Run {
            command: orch_retry_1level_probe_command,
            env: Empty,
            redirect: v2.std.optional.Absent,
            capture: v2.std.optional.Absent
          }
        }
      ],
      on_failure: v2.std.orchestration.FailFast
    },
    escalations: [
      orch_retry_1level_escalation(),
      orch_retry_level2_escalation(),
      orch_retry_level3_escalation()
    ],
    on_exhausted: v2.std.orchestration.Pipeline {
      steps: [
        v2.std.orchestration.Do {
          run: v2.std.orchestration.Run {
            command: orch_retry_1level_exhausted_command,
            env: Empty,
            redirect: v2.std.optional.Absent,
            capture: v2.std.optional.Absent
          }
        }
      ],
      on_failure: v2.std.orchestration.FailFast
    }
  }
}

data orch_retry_3level_refuse_note: String = "Three-level Retry previously emitted via orch_emit_retry_multilevel, which silently dropped level1.env (E1) and the final level's LogMatches.pattern. review 43629 — refuse (^orch_emit_retry_multilevel_unsupported) until a faithful N-level template lands."

test fn orch_retry_3level_refused_holds() -> Bool {
  match v2.compiler.emit_orchestration.orch_emit_step(s: orch_retry_3level_intent(), medium: v2.extdeps.languages.bash_orchestration_emit.bash_orchestration_emit_medium()) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } =>
      d.head.reason == ^orch_emit_retry_multilevel_unsupported
  }
}

fn orch_retry_probe_escalation(source: String) -> v2.std.orchestration.EscalationLevel {
  v2.std.orchestration.EscalationLevel {
    detect: v2.std.orchestration.LogMatches { source: source, pattern: "PAT" },
    warning: v2.std.diagnostic.EmitDirective {
      severity: v2.std.diagnostic.SeverityWarning,
      message: "probe"
    },
    env: Empty
  }
}

fn orch_retry_probe_exhausted() -> v2.std.orchestration.Pipeline {
  v2.std.orchestration.Pipeline {
    steps: [
      v2.std.orchestration.Do {
        run: v2.std.orchestration.Run {
          command: "exit 1",
          env: Empty,
          redirect: v2.std.optional.Absent,
          capture: v2.std.optional.Absent
        }
      }
    ],
    on_failure: v2.std.orchestration.FailFast
  }
}

fn orch_retry_probe_with_body(steps: std.algebra.FreeMonoid<v2.std.orchestration.PipelineStep>, source: String) -> v2.std.orchestration.PipelineStep {
  v2.std.orchestration.Retry {
    body: v2.std.orchestration.Pipeline {
      steps: steps,
      on_failure: v2.std.orchestration.FailFast
    },
    escalations: [orch_retry_probe_escalation(source: source)],
    on_exhausted: orch_retry_probe_exhausted()
  }
}

fn orch_retry_probe_single_do(r: v2.std.orchestration.Run, source: String) -> v2.std.orchestration.PipelineStep {
  orch_retry_probe_with_body(
    steps: [v2.std.orchestration.Do { run: r }],
    source: source
  )
}

test fn orch_retry_body_multi_step_refused_holds() -> Bool {
  match v2.compiler.emit_orchestration.orch_emit_step(
    s: orch_retry_probe_with_body(
      steps: [
        v2.std.orchestration.Do {
          run: v2.std.orchestration.Run {
            command: "true",
            env: Empty,
            redirect: v2.std.optional.Absent,
            capture: v2.std.optional.Absent
          }
        },
        v2.std.orchestration.Do {
          run: v2.std.orchestration.Run {
            command: "false",
            env: Empty,
            redirect: v2.std.optional.Absent,
            capture: v2.std.optional.Absent
          }
        }
      ],
      source: "BUILD_LOG"
    ),
    medium: v2.extdeps.languages.bash_orchestration_emit.bash_orchestration_emit_medium()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } =>
      d.head.reason == ^orch_emit_retry_body_multi_step
  }
}

