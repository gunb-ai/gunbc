test fn orch_retry_body_env_present_refused_holds() -> Bool {
  match v2.compiler.emit_orchestration.orch_emit_step(
    s: orch_retry_probe_single_do(
      r: v2.std.orchestration.Run {
        command: "true",
        env: [v2.std.orchestration.EnvSet { name: "BODY_ENV", value: "1" }],
        redirect: v2.std.optional.Absent,
        capture: v2.std.optional.Absent
      },
      source: "BUILD_LOG"
    ),
    medium: v2.extdeps.languages.bash_orchestration_emit.bash_orchestration_emit_medium()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } =>
      d.head.reason == ^orch_emit_retry_body_env_present
  }
}

test fn orch_retry_body_env_empty_accepted_holds() -> Bool {
  match v2.compiler.emit_orchestration.orch_emit_step(
    s: orch_retry_probe_single_do(
      r: v2.std.orchestration.Run {
        command: "true",
        env: Empty,
        redirect: v2.std.optional.Absent,
        capture: v2.std.optional.Absent
      },
      source: "BUILD_LOG"
    ),
    medium: v2.extdeps.languages.bash_orchestration_emit.bash_orchestration_emit_medium()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}
