module v2.workflow.ci_workflow_run_emit

import std.dissolution { DissolutionCondition, dissolution_description, unbound_dissolution }

import v2.compiler.emit_orchestration { orch_emit_pipeline }
import v2.extdeps.languages.bash_orchestration_emit { bash_orchestration_emit_medium }
import v2.workflow.ci_materialization_emit { ci_sccache_provider_shell_injection }
import gunbc.merge_admission_produce { ci_repo_root_shell }
import v2.std.orchestration {
  Comment,
  Do,
  Exit,
  ExprCmdSubst,
  FailFast,
  If,
  Let,
  Pipeline,
  PipelineStep,
  Run,
  StrEq
}
import v2.std.collection { Absent }
import v2.std.diagnostic { Accepted, Rejected, None, Some }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data ci_workflow_run_emit_refused_poison: String = "__GUNBC_ORCH_EMIT_REFUSED__ ci_workflow run-step emission was rejected by v2.compiler.emit_orchestration; this marker is not valid workflow shell, so the committed ci.yml drift gate goes red rather than a hand-spelled fallback masking the refusal (DESIGN 5: refuse, never widen)\n"

data ci_isolate_rm_rustup_cargo_command: String = "rm -rf \"$RUNNER_TEMP/rustup\" \"$RUNNER_TEMP/cargo\""

data ci_isolate_echo_home_command: String = "echo \"HOME=$RUNNER_TEMP\" >> \"$GITHUB_ENV\""

data ci_isolate_echo_cargo_home_command: String = "echo \"CARGO_HOME=$RUNNER_TEMP/cargo\" >> \"$GITHUB_ENV\""

data ci_isolate_echo_rustup_home_command: String = "echo \"RUSTUP_HOME=$RUNNER_TEMP/rustup\" >> \"$GITHUB_ENV\""

data ci_isolate_echo_makeflags_command: String = "echo \"MAKEFLAGS=\" >> \"$GITHUB_ENV\""

data ci_native_cache_root_note: String = "Durable native-artifact cache root (extdeps.realization.native_artifact_cache, PerRunnerFilesystem): RUNNER_TOOL_CACHE survives the per-run RUNNER_TEMP wipe on self-hosted runners, so emit-on-demand cargo workspaces warm across runs (compile_skipped receipts). The cached transport rebases only the declared /tmp/gunbc_ scratch prefix onto this root; content-hash path components stay the key, so cross-branch sharing on one runner is benign-by-identity. The rustc-version segment derived after setup-rust-toolchain remains a coarse operator-readable partition; correctness no longer depends on it because extdeps.realization.emit_on_demand_host places the host-observed resolved build-context identity (tools + constructed environment + Cargo configuration) beneath each input realization before .native_ready is consulted. Fail-closed: rustc -V must succeed — a fabricated toolchain-unresolved slug would poison every native-cache write into one shared root (DESIGN 5). Falsifier cold control: GUNBC_CI_NATIVE_CACHE_COLD_CONTROL."

data ci_native_cache_root_toolchain_segment_capture_command: String = "if ! GUNBC_TOOLCHAIN_SEG_RAW=$(rustc -V 2>/dev/null); then echo \"::error::rustc -V failed after setup-rust-toolchain: cannot derive native-cache toolchain segment\"; exit 1; fi"

data ci_native_cache_root_toolchain_segment_transform_command: String = "GUNBC_TOOLCHAIN_SEG=$(echo \"$GUNBC_TOOLCHAIN_SEG_RAW\" | tr ' ' '-')"

data ci_native_cache_root_toolchain_segment_missing_command: String = "if [ -z \"$GUNBC_TOOLCHAIN_SEG\" ]; then echo \"::error::rustc -V produced an empty native-cache toolchain segment after setup-rust-toolchain\"; exit 1; fi"

data ci_native_cache_root_mkdir_command: String = "mkdir -p \"$RUNNER_TOOL_CACHE/gunbc-native/$GUNBC_TOOLCHAIN_SEG\""

data ci_native_cache_root_echo_command: String = "echo \"GUNBC_NATIVE_CACHE_ROOT=$RUNNER_TOOL_CACHE/gunbc-native/$GUNBC_TOOLCHAIN_SEG\" >> \"$GITHUB_ENV\""

fn ci_pin_rustup_default_command() -> String {
  concat(
    "rustup default \"$(rustup show active-toolchain | awk '",
    concat(concat("{", "print $1; exit"), concat("}", "')\""))
  )
}

data ci_pin_rustup_cargo_bin_resolve_command: String = "if [ -x \"$CARGO_HOME/bin/cargo\" ]; then CARGO_BIN=\"$CARGO_HOME/bin/cargo\"; else CARGO_BIN=\"$(command -v cargo || true)\"; fi"

data ci_pin_rustup_cargo_bin_missing_command: String = "if [ -z \"$CARGO_BIN\" ]; then echo \"::error::no cargo binary: neither the isolated $CARGO_HOME/bin/cargo shim nor PATH carries one\"; exit 1; fi"

data ci_pin_rustup_echo_cargo_bin_command: String = "echo \"CARGO_BIN=$CARGO_BIN\" >> \"$GITHUB_ENV\""

// THE REFUSAL LIVES BESIDE ITS SIBLINGS, NOT IN THE CONSUMER. review 56091 caught this authored as
// hand-built control flow inside a concat chain in gunbc.witness_floor_workflow -- the
// medium-as-string form. It is a command row here, in the same shape and the same place as
// ci_pin_rustup_cargo_bin_missing_command, so the probe composes it rather than spelling shell.
data ci_toolchain_homes_isolated_or_refuse_command: String = "if [ -z \"$\{CARGO_HOME:-}\" ] || [ -z \"$\{RUSTUP_HOME:-}\" ]; then echo \"::error::ToolchainHomesNotIsolated CARGO_HOME=$\{CARGO_HOME:-unset} RUSTUP_HOME=$\{RUSTUP_HOME:-unset} -- the isolation step did not run, so this job shares a toolchain with every other runner slot on this host and a concurrent install can replace a binary mid-run\" >&2; exit 1; fi"

fn ci_workflow_run(command: String) -> Run {
  Run {
    command: command,
    env: Empty,
    redirect: Absent,
    capture: Absent
  }
}

fn ci_workflow_do(command: String) -> PipelineStep {
  Do { run: ci_workflow_run(command: command) }
}

fn ci_workflow_run_emit_pipeline(p: Pipeline) -> String {
  match orch_emit_pipeline(p: p, medium: bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: d } =>
      match d {
        None => source.carried
        Some { diagnostics: _ } => ci_workflow_run_emit_refused_poison
      }
    Rejected { diagnostics: _ } => ci_workflow_run_emit_refused_poison
  }
}

fn ci_isolate_cargo_build_jobs_command(build_jobs_count: Int) -> String {
  concat(
    "echo \"CARGO_BUILD_JOBS=",
    concat(to_string(build_jobs_count), "\" >> \"$GITHUB_ENV\"")
  )
}

// THREE CONCEPTS WERE RIDING IN ONE STEP, AND ONLY THE FIRST FIXES THE OUTAGE. Toolchain-home
// isolation is what stops concurrent runner slots sharing one $HOME/.cargo and rewriting a
// toolchain under a running job; MAKEFLAGS, CARGO_BUILD_JOBS and the sccache binding are
// fleet-build TUNING decisions that happen to have been spelled beside it. A consumer that needs
// only the first must not silently inherit the other two -- CARGO_BUILD_JOBS in particular is
// derived from the SELECTED runner target's RAM-speed budget, so importing it elsewhere imposes a
// number computed for a different subject.
//
// THE COMPOSED PIPELINE IS BYTE-IDENTICAL BY CONSTRUCTION, not by inspection: the same seven steps
// in the same order through the same builder. That is the discriminating check on this refactor --
// fleet-converge.yml must not move a byte.
fn ci_toolchain_home_isolation_steps() -> List<PipelineStep> {
  [
    ci_workflow_do(command: ci_isolate_rm_rustup_cargo_command),
    ci_workflow_do(command: ci_isolate_echo_home_command),
    ci_workflow_do(command: ci_isolate_echo_cargo_home_command),
    ci_workflow_do(command: ci_isolate_echo_rustup_home_command)
  ]
}

fn ci_fleet_build_tuning_steps(build_jobs_count: Int) -> List<PipelineStep> {
  [
    ci_workflow_do(command: ci_isolate_echo_makeflags_command),
    ci_workflow_do(command: ci_isolate_cargo_build_jobs_command(build_jobs_count: build_jobs_count)),
    ci_workflow_do(command: ci_sccache_provider_shell_injection())
  ]
}

fn ci_toolchain_home_isolation_intent() -> Pipeline {
  Pipeline {
    steps: ci_toolchain_home_isolation_steps(),
    on_failure: FailFast
  }
}

fn ci_toolchain_home_isolation_script() -> String {
  concat(
    concat("# ", concat(dissolution_description(condition: ci_toolchain_home_isolation_shell_emit_dissolution_trigger), "\n")),
    ci_workflow_run_emit_pipeline(p: ci_toolchain_home_isolation_intent())
  )
}

// MARKED ON REQUEST (review 56091), and the honest scope is narrower than "a new shell carrier".
// This function authors NO new shell: it emits four pre-existing command rows
// (ci_isolate_rm_rustup_cargo_command and the three echo rows), unchanged, that
// ci_isolate_toolchain_script already emitted. What is new is the COMPOSITION, not the medium.
//
// The marker is still correct, because the carrier really is orch-emitted foreign-executor shell
// pending the same shell-to-intent migration ci_native_cache_root_script names. WORTH RECORDING:
// ci_isolate_toolchain_script shares this obligation because it shares the terminal construction --
// the trigger below names it, so nothing is left implicit. ci_pin_rustup_default_script does NOT,
// and now carries its own: it waits on a toolchain-SELECTION effect, so the effect this carrier
// waits on could land and leave the pin shell standing.
data ci_toolchain_home_isolation_shell_emit_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "v2.workflow.ci_workflow_run_emit",
    decl_name: "ci_toolchain_home_isolation_script",
    field: WholeDeclaration
  }
}

data ci_toolchain_home_isolation_shell_emit_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: "dissolve-on: ci_toolchain_home_isolation_script -- orch-emitted foreign-executor prelude step wiping and setting HOME/CARGO_HOME/RUSTUP_HOME under RUNNER_TEMP so concurrent runner slots stop sharing one toolchain; leaf rm/echo strings remain until a typed per-job filesystem-and-environment effect lands on host_effect_apply (shell-to-intent Phase 2). This obligation covers THIS carrier and ci_isolate_toolchain_script, which share that terminal construction; ci_pin_rustup_default_script carries its own obligation because it does not")

// ONE OBLIGATION COVERS ONE INDEPENDENTLY REMOVABLE UNIT, and the pin script is a different unit
// from the isolation carrier above (review 56168, and the reviewer is right on the doctrine).
// docs/plans/scaffold-admission-doctrine.md admits a shared obligation only where the artifacts
// have the same terminal construction, fire on the same observation, AND CANNOT SURVIVE ONE
// ANOTHER. The pin script fails the first and third: it selects a TOOLCHAIN via rustup, which is
// not the per-job filesystem-and-environment effect the isolation carrier waits on, so when that
// effect lands the isolation shell dissolves and this one is still standing. An earlier revision of
// the trigger above swept it in as a sibling that "dissolves together"; that was the single broad
// trigger laundering an expanding collection of temporary work the doctrine names, so the claim is
// withdrawn rather than reworded.
data ci_pin_rustup_default_shell_emit_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "v2.workflow.ci_workflow_run_emit",
    decl_name: "ci_pin_rustup_default_script",
    field: WholeDeclaration
  }
}

data ci_pin_rustup_default_shell_emit_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: "dissolve-on: ci_pin_rustup_default_script -- orch-emitted foreign-executor step selecting a rustup default toolchain inside an isolated RUSTUP_HOME, which starts with none, and resolving the cargo binary that selection implies. The leaf rustup/command/echo strings remain until a typed TOOLCHAIN-SELECTION effect lands on host_effect_apply -- NOT the filesystem-and-environment effect ci_toolchain_home_isolation_script waits on, which is why this is a separate obligation: that effect landing alone would leave this carrier standing")

fn ci_isolate_toolchain_intent(build_jobs_count: Int) -> Pipeline {
  Pipeline {
    steps: concat(
      ci_toolchain_home_isolation_steps(),
      ci_fleet_build_tuning_steps(build_jobs_count: build_jobs_count)
    ),
    on_failure: FailFast
  }
}

fn ci_isolate_toolchain_script(build_jobs_count: Int) -> String {
  ci_workflow_run_emit_pipeline(p: ci_isolate_toolchain_intent(build_jobs_count: build_jobs_count))
}

fn ci_native_cache_root_intent() -> Pipeline {
  Pipeline {
    steps: [
      ci_workflow_do(command: ci_native_cache_root_toolchain_segment_capture_command),
      ci_workflow_do(command: ci_native_cache_root_toolchain_segment_transform_command),
      ci_workflow_do(command: ci_native_cache_root_toolchain_segment_missing_command),
      ci_workflow_do(command: ci_native_cache_root_mkdir_command),
      ci_workflow_do(command: ci_native_cache_root_echo_command)
    ],
    on_failure: FailFast
  }
}

fn ci_native_cache_root_script() -> String {
  concat(
    concat("# ", concat(dissolution_description(condition: ci_native_cache_root_shell_emit_dissolution_trigger), "\n")),
    ci_workflow_run_emit_pipeline(p: ci_native_cache_root_intent())
  )
}

data ci_native_cache_root_shell_emit_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "v2.workflow.ci_workflow_run_emit",
    decl_name: "ci_native_cache_root_script",
    field: WholeDeclaration
  }
}

data ci_native_cache_root_shell_emit_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: "🟡 dissolve-on: ci_native_cache_root_script — orch-emitted foreign-executor prelude step deriving GUNBC_NATIVE_CACHE_ROOT from rustc -V after setup-rust-toolchain; leaf rustc/tr/mkdir/echo strings remain until typed toolchain probe lands on host_effect_apply (#5828 / shell→intent Phase 2)")

data ci_native_cache_fabricated_segment_literal: String = "toolchain-unresolved"

fn ci_native_cache_segment_script_refuses_fabrication(script: String) -> Bool {
  string_contains(s: script, pattern: "if ! GUNBC_TOOLCHAIN_SEG_RAW=$(rustc -V") &&
    string_contains(s: script, pattern: "GUNBC_TOOLCHAIN_SEG=$(echo \"$GUNBC_TOOLCHAIN_SEG_RAW\" | tr ' ' '-')") &&
    string_contains(s: script, pattern: "exit 1") &&
    !string_contains(s: script, pattern: ci_native_cache_fabricated_segment_literal) &&
    !string_contains(s: script, pattern: "if ! GUNBC_TOOLCHAIN_SEG=$(rustc -V")
}

fn ci_isolate_toolchain_script_excludes_segment_derivation(isolate_script: String) -> Bool {
  !string_contains(s: isolate_script, pattern: "rustc -V") &&
    !string_contains(s: isolate_script, pattern: "GUNBC_TOOLCHAIN_SEG") &&
    !string_contains(s: isolate_script, pattern: "GUNBC_NATIVE_CACHE_ROOT") &&
    !string_contains(s: isolate_script, pattern: ci_native_cache_fabricated_segment_literal)
}

fn ci_pin_rustup_default_intent() -> Pipeline {
  Pipeline {
    steps: [
      ci_workflow_do(command: ci_pin_rustup_default_command()),
      ci_workflow_do(command: ci_pin_rustup_cargo_bin_resolve_command),
      ci_workflow_do(command: ci_pin_rustup_cargo_bin_missing_command),
      ci_workflow_do(command: ci_pin_rustup_echo_cargo_bin_command)
    ],
    on_failure: FailFast
  }
}

fn ci_pin_rustup_default_script() -> String {
  concat(
    concat("# ", concat(dissolution_description(condition: ci_pin_rustup_default_shell_emit_dissolution_trigger), "\n")),
    ci_workflow_run_emit_pipeline(p: ci_pin_rustup_default_intent())
  )
}

// THIS IS DELIBERATELY A TWO-ARM CONTROL. Two readers that merely use private homes prove
// nothing: the retired cooperation protocol also passed while every participant cooperated. The
// shared arm below makes the readers execute the exact path the antagonist replaces and MUST
// observe interference. The private arm changes only the reader home, deriving it from the live
// isolation binding, while the antagonist keeps replacing the legacy fixture; it MUST remain
// unaffected. If the isolation step is deleted, CARGO_HOME no longer names RUNNER_TEMP/cargo and
// the private arm collapses onto the legacy fixture, so the check has an authorable RED.
fn ci_hostile_legacy_writer_discriminator_script() -> String {
  concat(
    concat("# ", concat(dissolution_description(condition: ci_hostile_legacy_writer_discriminator_shell_emit_dissolution_trigger), "\n")),
    join([
      "set -u\n",
      "ROOT=\"$RUNNER_TEMP/gunbc-hostile-toolchain-writer\"\n",
      "rm -rf \"$ROOT\"\n",
      "mkdir -p \"$ROOT\"\n",
      "run_arm() {\n",
      "  ARM=$1; READER_HOME=$2; LEGACY_HOME=$3\n",
      "  mkdir -p \"$READER_HOME/bin\" \"$LEGACY_HOME/bin\" \"$ARM\"\n",
      "  printf '#!/bin/sh\\nprintf safe\\n' > \"$READER_HOME/bin/toolchain-probe\"\n",
      "  chmod +x \"$READER_HOME/bin/toolchain-probe\"\n",
      "  ( while [ ! -e \"$ARM/writer-ready\" ]; do sleep 0.01; done; [ \"$(\"$READER_HOME/bin/toolchain-probe\")\" = safe ] ) & A=$!\n",
      "  ( while [ ! -e \"$ARM/writer-ready\" ]; do sleep 0.01; done; [ \"$(\"$READER_HOME/bin/toolchain-probe\")\" = safe ] ) & B=$!\n",
      "  ( printf '#!/bin/sh\\nprintf hostile\\n' > \"$ARM/reinstall\"; chmod +x \"$ARM/reinstall\"; mv -f \"$ARM/reinstall\" \"$LEGACY_HOME/bin/toolchain-probe\"; touch \"$ARM/writer-ready\"; while [ ! -e \"$ARM/readers-done\" ]; do sleep 0.01; done ) & C=$!\n",
      "  if wait \"$A\"; then AS=0; else AS=$?; fi; if wait \"$B\"; then BS=0; else BS=$?; fi; touch \"$ARM/readers-done\"; wait \"$C\"\n",
      "  [ \"$AS\" -eq 0 ] && [ \"$BS\" -eq 0 ]\n",
      "}\n",
      "SHARED=\"$ROOT/shared\"\n",
      "if run_arm \"$ROOT/shared-arm\" \"$SHARED\" \"$SHARED\"; then echo '::error::hostile writer shared-arm control unexpectedly passed' >&2; exit 1; fi\n",
      "LEGACY=\"$ROOT/legacy\"\n",
      "case \"${CARGO_HOME:-}\" in \"$RUNNER_TEMP/cargo\") PRIVATE_READER=\"$CARGO_HOME\" ;; *) PRIVATE_READER=\"$LEGACY\" ;; esac\n",
      "if ! run_arm \"$ROOT/private-arm\" \"$PRIVATE_READER\" \"$LEGACY\"; then echo '::error::hostile legacy writer affected private-home readers' >&2; exit 1; fi\n",
    ], "")
  )
}

data ci_hostile_legacy_writer_discriminator_shell_emit_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "v2.workflow.ci_workflow_run_emit",
    decl_name: "ci_hostile_legacy_writer_discriminator_script",
    field: WholeDeclaration
  }
}

data ci_hostile_legacy_writer_discriminator_shell_emit_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: "dissolve-on: ci_hostile_legacy_writer_discriminator_script -- foreign-executor concurrency control proving readers sharing a mutable toolchain path are disrupted by a hostile reinstall while readers bound to the job-private CARGO_HOME are unaffected. Its process synchronization, executable replacement, and observations remain shell until a typed concurrent filesystem/tool-execution interference probe effect lands on host_effect_apply (shell-to-intent Phase 2); neither the environment-binding effect nor the toolchain-selection effect can replace this observation")
