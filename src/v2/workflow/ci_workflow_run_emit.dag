module v2.workflow.ci_workflow_run_emit



data ci_workflow_run_emit_refused_poison: String = "__GUNBC_ORCH_EMIT_REFUSED__ ci_workflow run-step emission was rejected by v2.compiler.emit_orchestration; this marker is not valid workflow shell, so the committed ci.yml drift gate goes red rather than a hand-spelled fallback masking the refusal (DESIGN 5: refuse, never widen)\n"

data ci_isolate_rm_rustup_cargo_command: String = "rm -rf \"$RUNNER_TEMP/rustup\" \"$RUNNER_TEMP/cargo\""

data ci_isolate_echo_home_command: String = "echo \"HOME=$RUNNER_TEMP\" >> \"$GITHUB_ENV\""

data ci_isolate_echo_cargo_home_command: String = "echo \"CARGO_HOME=$RUNNER_TEMP/cargo\" >> \"$GITHUB_ENV\""

data ci_isolate_echo_rustup_home_command: String = "echo \"RUSTUP_HOME=$RUNNER_TEMP/rustup\" >> \"$GITHUB_ENV\""

data ci_isolate_echo_makeflags_command: String = "echo \"MAKEFLAGS=\" >> \"$GITHUB_ENV\""

data ci_native_cache_root_note: String = "Durable native-artifact cache root (extdeps.realization.native_artifact_cache, PerRunnerFilesystem): RUNNER_TOOL_CACHE survives the per-run RUNNER_TEMP wipe on self-hosted runners, so emit-on-demand cargo workspaces warm across runs (compile_skipped receipts). The cached transport rebases only the declared /tmp/gunbc_ scratch prefix onto this root; content-hash path components stay the key, so cross-branch sharing on one runner is benign-by-identity. The rustc-version segment derived after setup-rust-toolchain remains a coarse operator-readable partition; correctness no longer depends on it because extdeps.realization.emit_on_demand_host places the host-observed resolved build-context identity (tools + constructed environment + Cargo configuration) beneath each input realization before .native_ready is consulted. Fail-closed: rustc -V must succeed — a fabricated toolchain-unresolved slug would poison every native-cache write into one shared root (DESIGN 5). Falsifier cold control: GUNBC_CI_NATIVE_CACHE_COLD_CONTROL."

data ci_native_cache_root_toolchain_segment_capture_command: String = "if ! GUNBC_TOOLCHAIN_SEG_RAW=$(rustc -V 2>/dev/null); then echo \"::error::rustc -V failed after setup-rust-toolchain: cannot derive native-cache toolchain segment\"; exit 1; fi"

data ci_native_cache_root_toolchain_segment_transform_command: String = "GUNBC_TOOLCHAIN_SEG=$(echo \"$GUNBC_TOOLCHAIN_SEG_RAW\" | tr ' ' '-')"

data ci_native_cache_root_toolchain_segment_missing_command: String = "if [ -z \"$GUNBC_TOOLCHAIN_SEG\" ]; then echo \"::error::rustc -V produced an empty native-cache toolchain segment after setup-rust-toolchain\"; exit 1; fi"

data ci_native_cache_root_mkdir_command: String = "mkdir -p \"$RUNNER_TOOL_CACHE/gunbc-native/$GUNBC_TOOLCHAIN_SEG\""

data ci_native_cache_root_echo_command: String = "echo \"GUNBC_NATIVE_CACHE_ROOT=$RUNNER_TOOL_CACHE/gunbc-native/$GUNBC_TOOLCHAIN_SEG\" >> \"$GITHUB_ENV\""

data ci_selection_control_witness_invoke_command: String = "\"$ROOT/target/release/floor_skip_discovery_witness\""

fn ci_pin_rustup_default_command() -> String {
  concat(
    "rustup default \"$(rustup show active-toolchain | awk '",
    concat(concat("{", "print $1; exit"), concat("}", "')\""))
  )
}

data ci_pin_rustup_cargo_bin_resolve_command: String = "if [ -x \"$CARGO_HOME/bin/cargo\" ]; then CARGO_BIN=\"$CARGO_HOME/bin/cargo\"; else CARGO_BIN=\"$(command -v cargo || true)\"; fi"

data ci_pin_rustup_cargo_bin_missing_command: String = "if [ -z \"$CARGO_BIN\" ]; then echo \"::error::no cargo binary: neither the isolated $CARGO_HOME/bin/cargo shim nor PATH carries one\"; exit 1; fi"

data ci_pin_rustup_echo_cargo_bin_command: String = "echo \"CARGO_BIN=$CARGO_BIN\" >> \"$GITHUB_ENV\""

fn ci_workflow_run(command: String) -> Run {
  Run {
    command: command,
    env: [],
    redirect: Absent,
    capture: Absent
  }
}

fn ci_workflow_do(command: String) -> PipelineStep {
  Do { run: ci_workflow_run(command: command) }
}

fn ci_workflow_run_emit_pipeline(p: Pipeline) -> String {
  match orch_emit_pipeline(p: p, medium: bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: d } =>
      match d {
        None => source.carried
        Some { diagnostics: _ } => ci_workflow_run_emit_refused_poison
      }
    Rejected { diagnostics: _ } => ci_workflow_run_emit_refused_poison
  }
}

fn ci_isolate_cargo_build_jobs_command(build_jobs_count: Int) -> String {
  concat(
    "echo \"CARGO_BUILD_JOBS=",
    concat(to_string(build_jobs_count), "\" >> \"$GITHUB_ENV\"")
  )
}

fn ci_isolate_toolchain_intent(build_jobs_count: Int) -> Pipeline {
  Pipeline {
    steps: [
      ci_workflow_do(command: ci_isolate_rm_rustup_cargo_command),
      ci_workflow_do(command: ci_isolate_echo_home_command),
      ci_workflow_do(command: ci_isolate_echo_cargo_home_command),
      ci_workflow_do(command: ci_isolate_echo_rustup_home_command),
      ci_workflow_do(command: ci_isolate_echo_makeflags_command),
      ci_workflow_do(command: ci_isolate_cargo_build_jobs_command(build_jobs_count: build_jobs_count)),
      ci_workflow_do(command: ci_sccache_provider_shell_injection())
    ],
    on_failure: FailFast
  }
}

fn ci_isolate_toolchain_script(build_jobs_count: Int) -> String {
  ci_workflow_run_emit_pipeline(p: ci_isolate_toolchain_intent(build_jobs_count: build_jobs_count))
}

fn ci_native_cache_root_intent() -> Pipeline {
  Pipeline {
    steps: [
      ci_workflow_do(command: ci_native_cache_root_toolchain_segment_capture_command),
      ci_workflow_do(command: ci_native_cache_root_toolchain_segment_transform_command),
      ci_workflow_do(command: ci_native_cache_root_toolchain_segment_missing_command),
      ci_workflow_do(command: ci_native_cache_root_mkdir_command),
      ci_workflow_do(command: ci_native_cache_root_echo_command)
    ],
    on_failure: FailFast
  }
}

fn ci_native_cache_root_script() -> String {
  concat(
    concat("# ", concat(dissolution_description(condition: ci_native_cache_root_shell_emit_dissolution_trigger), "\n")),
    ci_workflow_run_emit_pipeline(p: ci_native_cache_root_intent())
  )
}

data ci_native_cache_root_shell_emit_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "v2.workflow.ci_workflow_run_emit",
    decl_name: "ci_native_cache_root_script",
    field: WholeDeclaration
  }
}

data ci_native_cache_root_shell_emit_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: "🟡 dissolve-on: ci_native_cache_root_script — orch-emitted foreign-executor prelude step deriving GUNBC_NATIVE_CACHE_ROOT from rustc -V after setup-rust-toolchain; leaf rustc/tr/mkdir/echo strings remain until typed toolchain probe lands on host_effect_apply (#5828 / shell→intent Phase 2)")

data ci_native_cache_fabricated_segment_literal: String = "toolchain-unresolved"

fn ci_native_cache_segment_script_refuses_fabrication(script: String) -> Bool {
  string_contains(s: script, pattern: "if ! GUNBC_TOOLCHAIN_SEG_RAW=$(rustc -V") &&
    string_contains(s: script, pattern: "GUNBC_TOOLCHAIN_SEG=$(echo \"$GUNBC_TOOLCHAIN_SEG_RAW\" | tr ' ' '-')") &&
    string_contains(s: script, pattern: "exit 1") &&
    !string_contains(s: script, pattern: ci_native_cache_fabricated_segment_literal) &&
    !string_contains(s: script, pattern: "if ! GUNBC_TOOLCHAIN_SEG=$(rustc -V")
}

fn ci_isolate_toolchain_script_excludes_segment_derivation(isolate_script: String) -> Bool {
  !string_contains(s: isolate_script, pattern: "rustc -V") &&
    !string_contains(s: isolate_script, pattern: "GUNBC_TOOLCHAIN_SEG") &&
    !string_contains(s: isolate_script, pattern: "GUNBC_NATIVE_CACHE_ROOT") &&
    !string_contains(s: isolate_script, pattern: ci_native_cache_fabricated_segment_literal)
}

fn ci_pin_rustup_default_intent() -> Pipeline {
  Pipeline {
    steps: [
      ci_workflow_do(command: ci_pin_rustup_default_command()),
      ci_workflow_do(command: ci_pin_rustup_cargo_bin_resolve_command),
      ci_workflow_do(command: ci_pin_rustup_cargo_bin_missing_command),
      ci_workflow_do(command: ci_pin_rustup_echo_cargo_bin_command)
    ],
    on_failure: FailFast
  }
}

fn ci_pin_rustup_default_script() -> String {
  ci_workflow_run_emit_pipeline(p: ci_pin_rustup_default_intent())
}

fn ci_selection_control_root_command() -> String {
  concat("ROOT=", ci_repo_root_shell())
}

fn ci_selection_control_tail_command() -> String {
  ci_selection_control_witness_invoke_command
}

data ci_selection_control_skip_witness_invoke_command: String = "\"$ROOT/target/release/selection_control_skip_witness\""

data ci_selection_control_skip_label: String = "selection_control_not_affected_skip"

data ci_selection_control_skip_binder: String = "_ci_selection_skip"

data ci_selection_control_skip_policy_note: String = "Affected-set-scoped selection-control admission (pull_request only) — the selection mechanism applied to itself. selection_control_skip_witness intersects the merge-base diff with the control suite's input closure (cli_run::selection_control_input_sources: the suite's declared .dag entries plus their import closure through [src/v2, dag], the src/v1/** prefix covering the selection implementation and the witness bin, the Cargo/toolchain build config, and EVERY markdown path). The markdown arm is not incidental: the suite's declared entry dag/test/claim/doc_reachability_witness_test.dag declares LiveTreeDisposition = ReadsLiveTree and folds the live doc graph (gunbc.doc_graph_roots.doc_graph_roots_all) to decide doc_graph_has_no_orphan_docs, asserting the orphan wall green against the REAL tree — so a .md add/edit/delete genuinely changes this suite's verdict, and a live-tree read is not an import edge, so no closure walk can discover that reach. It is a structural over-approximation computed AS the answer (DESIGN §5: a closure superset is the precision frontier), not a widening failure arm. Found by review 44682 on this PR, whose first draft skipped docs-only diffs while its green control asserted that skip. A PR diff touching none of those provably cannot change the suite's verdict, so the step exits 0 immediately. NOT circular: the skip decision is a coarse path/import-closure intersection, never the node-frontier selector the suite verifies, so a broken selector cannot suppress its own control. TWO KINDS OF ARM, and the difference is the whole fail-closed story. STRUCTURAL arms — empty diff, ANY departed path (no docs carve-out — deleting a doc is the direction the orphan/dangling wall is most sensitive to, and regen's/compile-clean's docs exemption is correct only because markdown is outside THEIR closures), any markdown path, and any closure intersection — are label-valued: the diff WAS observed, so the answer is computed, and the witness exits 0 printing run_selection_control. REFUSAL arms — diff-observation failure and input-closure failure — do NOT run the suite and do NOT print a label: they STOP THE LINE. The witness prints a typed, located, countable diagnostic (SELECTION_CONTROL_REFUSED cause=DiffObservationFailed or cause=InputClosureFailed) to stderr and exits NON-ZERO, so the step goes RED. That is DESIGN §5's rule that a failure arm must refuse, never widen: 'can't compute the affected set → rerun everything' is the named absorbing fallback, conflating ⊤-as-ignorance with ⊤-as-answer, and it fails open twice — the deficit's frequency is zeroed by construction so it never ranks for fixing, and the cost is denominated in the corpus rather than the change. It is also the ruling already recorded in floor_diff_baseline_law (src/v2/workflow/floor_diff_observe.dag): a BaselineRefused → NameStatusDiffFail HALTS with a typed AFFECTED-SET REFUSAL, refusing every enrolled row rather than widening to a full-corpus run (operator ruling 2026-07-05). Corrected here after review 44768 caught this note still claiming the failure arms ran the suite — a §3 single-authority violation, since the note is emitted into ci.yml and would have been the authoritative description of the opposite behaviour. TWO DISTINCT fail-closed mechanisms sit outside that, and they are not the same arm: (a) the witness exits 0 but prints anything other than the skip label — the string comparison fails and the suite runs; (b) the witness exits NON-zero — either a deliberate typed REFUSAL (the two computation-failure arms above) or a panic (e.g. the workspace chdir failing) — GitHub runs this step under bash -e, so the command substitution's failure aborts the step RED rather than falling through. (b) is deliberately unlike the regen precedent, which suppresses stderr and defaults with a shell fallback; here a crashing skip witness stops the line loudly instead of being papered over, and stderr is left unredirected so the witness's own typed explanation of WHICH arm fired lands in the job log. COLD CONTROL: the skip is gated to pull_request events via GITHUB_EVENT_NAME, so push-to-main and workflow_dispatch run the suite UNCONDITIONALLY. A wrong closure that lets a PR wrongly skip therefore surfaces on the very next merge to main (the one-merge acceptance window, the regen-skip shape). MEASURED BASIS, including the part that makes this a trade rather than a free win. The step costs 9m02s per PR (run 30482171871, job 90679506428) against the 80s local basis gunbc.ci_workflow's step note declares. The skip witness itself costs ~100s per invocation (three local runs: 100.0s, 100.3s, 103.1s), because selection_control_skip_label_for_ci observes the diff through cli_run::floor_git_diff_name_status_range, which resolves floor_diff_observe.dag with a COLD whole-pool index — that observation, not the closure walk, is essentially the whole 100s. So: a skipping PR pays ~100s instead of 542s (saves ~7m22s); a NON-skipping PR pays 542s + ~100s (a ~100s REGRESSION, stated because it is real). SKIP RATE, MEASURED AGAINST THE REAL CLOSURE (corrected 2026-07-29, third revision — read the correction history, it is the point): over the last 100 origin/main commits, 35 touch src/v1/**, 36 touch markdown, 1 touches Cargo/toolchain, and of the 36 that survive those arms, 13 intersect the suite's actual 391-file import closure. TRUE SKIP RATE 23 of 100, so expected value is about -25s/PR (0.23 x -442s + 0.77 x +100s) — roughly 1.2 percent of a 33.6-minute ci job. Two earlier claims in this note were WRONG and are superseded: -7.7 min/PR from an unmeasured 85 percent skip rate, then -4.3 min/PR from a partially-measured <=66 percent ceiling that extrapolated the src/v1/** prefix alone and had not yet counted markdown or the closure. Each is recorded rather than quietly replaced, because the drift this very note documents (an 80s basis left standing against a 542s reality) is the same failure mode. CONSEQUENCE, stated plainly: the cost win alone does NOT justify this scaffold's hand-Rust under DESIGN §6 (denominate the benefit in displaced cost). What ruins the mean is the ~100s cold diff observation — the 🟡 deficit below, paid twice per PR — not the mechanism; dissolve that and the same code is about -102s/PR at near-zero cost. The teardown removal (-11.2s every PR) and this note's own measured corrections stand independently of the skip. 🟡 dissolve-on: the ~100s diff observation is now paid TWICE per PR, once here and once by regen_floor_skip_witness in the regen job, and both pay it as a cold whole-pool index build in a fresh process. It dissolves with the same persistent content-keyed node store gunbc.ci_materialization's resolve-receipt note names as the terminal condition for the per-entry cold resolve class; until then the double payment is counted here rather than hidden, and the non-skipping regression above is its visible cost."

data ci_selection_control_skip_echo_command: String = "echo \"gunbc ci selection control: pull_request diff does not intersect the control suite's input closure — its verdict is provably unchanged; skipping (push-to-main runs it unconditionally as the cold control)\""

fn ci_selection_control_skip_bind_step() -> PipelineStep {
  Let {
    name: ci_selection_control_skip_binder,
    value: ExprCmdSubst {
      callee: ci_selection_control_skip_witness_invoke_command,
      args: []
    }
  }
}

fn ci_selection_control_skip_taken_then() -> Pipeline {
  Pipeline {
    steps: [
      ci_workflow_do(command: ci_selection_control_skip_echo_command),
      Exit { status: "0" }
    ],
    on_failure: FailFast
  }
}

fn ci_selection_control_skip_decide_step() -> PipelineStep {
  If {
    cond: StrEq {
      lhs: concat("\"$", concat(ci_selection_control_skip_binder, "\"")),
      rhs: ci_selection_control_skip_label
    },
    then_: ci_selection_control_skip_taken_then(),
    else_: Absent
  }
}

fn ci_selection_control_skip_step() -> PipelineStep {
  If {
    cond: StrEq { lhs: "\"$GITHUB_EVENT_NAME\"", rhs: "pull_request" },
    then_: Pipeline {
      steps: [
        ci_selection_control_skip_bind_step(),
        ci_selection_control_skip_decide_step()
      ],
      on_failure: FailFast
    },
    else_: Absent
  }
}

fn ci_selection_control_intent() -> Pipeline {
  Pipeline {
    steps: [
      Comment { text: ci_selection_control_skip_policy_note },
      ci_workflow_do(command: ci_selection_control_root_command()),
      ci_selection_control_skip_step(),
      ci_workflow_do(command: ci_selection_control_tail_command())
    ],
    on_failure: FailFast
  }
}

fn ci_selection_control_script() -> String {
  ci_workflow_run_emit_pipeline(p: ci_selection_control_intent())
}
