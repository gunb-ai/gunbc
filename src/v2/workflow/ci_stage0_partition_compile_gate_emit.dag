module v2.workflow.ci_stage0_partition_compile_gate_emit


data ci_stage0_partition_compile_gate_cargo_path: String = "dag/extdeps/rust/cargo_build.dag"
data ci_stage0_partition_compile_gate_cargo_service: String = "cargo.Build"
data ci_stage0_partition_compile_gate_cargo_operation: String = "Check"
data ci_stage0_partition_compile_gate_cargo_bin_env_var: String = "CARGO_BIN"

data ci_stage0_partition_compile_gate_refusal_prefix: String = "__GUNBC_EFFECT_PLAN_BASH_REFUSED__ stage0 partition compile gate: "

data ci_stage0_partition_compile_gate_authority_note: String = "Build-job compile gate for all seven interim stage0 partition crates (v2.workflow.rust_crate_partition stage0_partition_crate_rows). One extdeps.cargo_build cargo.Build.Check per package_name, FailFast chain — interim backstop that cargo-checks every generated partition crate so a roster or emit drift cannot rot silently off main. Package list is declaration-derived from stage0_partition_package_names, never hand-listed in this emit module."

data ci_stage0_partition_compile_gate_shell_emit_scaffold: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "v2.workflow.ci_stage0_partition_compile_gate_emit",
    decl_name: "ci_stage0_partition_compile_gate_script",
    field: std.decl_ref.WholeDeclaration
  }
}

data ci_stage0_partition_compile_gate_shell_emit_dissolution_trigger: std.dissolution.DissolutionCondition = std.dissolution.unbound_dissolution(description: "🟡 dissolve-on: ci_stage0_partition_compile_gate_script — foreign-executor (GitHub Actions run:) shell transport for seven partition-crate cargo.Build.Check invocations; DISSOLVES WHEN bash-emit (#5828 / shell→intent Phase 2) binds the build-job step to orchestration emit over the typed cargo operations — same de-fork as ci_v1_compiler_tests_compile_gate_script and ci_fmt_gate_line")

fn ci_stage0_partition_compile_gate_extra_args(package_name: String) -> List<String> {
  ["-p", package_name]
}

fn ci_stage0_partition_compile_gate_check_step(package_name: String) -> v2.workflow.effect_plan_bash_materialize.BashBoundOperationInvocation {
  bash_bind_operation_invocation_host_env_executable(
    at: v2.std.operation_argv.OperationRef {
      path: ci_stage0_partition_compile_gate_cargo_path,
      service: ci_stage0_partition_compile_gate_cargo_service,
      operation: ci_stage0_partition_compile_gate_cargo_operation
    },
    bindings: [
      operation_argv_bind_text_list(
        name: "extra_args",
        items: ci_stage0_partition_compile_gate_extra_args(package_name: package_name)
      )
    ],
    env_var: ci_stage0_partition_compile_gate_cargo_bin_env_var
  )
}

fn ci_stage0_partition_compile_gate_steps() -> List<EffectPlanStep<v2.workflow.effect_plan_bash_materialize.BashBoundOperationInvocation>> {
  stage0_partition_package_names()
    |> map(package_name => v2.std.effect_plan.Do { effect: ci_stage0_partition_compile_gate_check_step(package_name: package_name) })
}

fn ci_stage0_partition_compile_gate_intent() -> EffectPlan<v2.workflow.effect_plan_bash_materialize.BashBoundOperationInvocation> {
  v2.std.effect_plan.EffectPlan {
    steps: ci_stage0_partition_compile_gate_steps(),
    on_failure: FailFast
  }
}

fn ci_stage0_partition_compile_gate_render(
  plan: EffectPlan<v2.workflow.effect_plan_bash_materialize.BashBoundOperationInvocation>
) -> String {
  match effect_plan_bash_materialize(plan: plan) {
    EffectPlanBashMaterialized { source: source } => source
    EffectPlanBashMaterializationRefused { refusal: refusal } =>
      concat(
        ci_stage0_partition_compile_gate_refusal_prefix,
        effect_plan_bash_refusal_label(refusal: refusal)
      )
  }
}

fn ci_stage0_partition_compile_gate_script() -> String {
  concat(
    concat("# ", concat(std.dissolution.dissolution_description(condition: ci_stage0_partition_compile_gate_shell_emit_dissolution_trigger), "\n")),
    concat(ci_stage0_partition_compile_gate_render(plan: ci_stage0_partition_compile_gate_intent()), "\n")
  )
}

fn ci_stage0_partition_compile_gate_package_count_holds() -> Bool {
  (stage0_partition_package_names() |> count) == rust_crate_partition_declared_core_target
}
