module v2.workflow.ci_v1_compiler_tests_compile_gate_emit

import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.types { List }
import v2.std.effect_plan { Do, EffectPlan }
import v2.std.operation_argv {
  OperationRef,
  operation_argv_bind_text_list
}
import v2.std.orchestration { FailFast }
import v2.std.text { String }
import v2.workflow.effect_plan_bash_materialize {
  BashBoundOperationInvocation,
  EffectPlanBashMaterializationRefused,
  EffectPlanBashMaterialized,
  bash_bind_operation_invocation_host_env_executable,
  effect_plan_bash_materialize,
  effect_plan_bash_refusal_label
}
import std.dissolution { DissolutionCondition, dissolution_description, unbound_dissolution }

data ci_v1_compiler_tests_compile_gate_extra_args: List<String> = [
  "-p",
  "v1-compiler-tests",
  "--release",
  "--no-run"
]

data interpreter_parity_controls_note: String = "THE COMPILE GATE PROVES COMPILATION, WHICH IS NOT EXECUTION. cargo test --no-run builds the test crate and runs nothing, so every #[cfg(test)] control inside the v1-compiler lib - including the value_hash parity oracle that decides HAML key identity, and the grouping delegate binding - was compiled and never executed. That is DESIGN section 5's specification-without-execution exactly: a control that has never run is not evidence, and a typecheck is not a consumer.

THIS STEP EXECUTES A NARROW, NAMED SET. It is deliberately not the whole lib suite: the heavyweight producer module resolves the live tree and has been observed to exhaust memory when run as a group, so enrolling everything would trade an unexecuted control for an unreliable job. --lib excludes the integration-test crates, the two filters name the modules, and --test-threads=1 serializes them because the parity control reads process-global interpreter state. The crate is already built by the step before this one, so the marginal cost is the run itself."

data ci_interpreter_parity_controls_extra_args: List<String> = [
  "-p",
  "v1-compiler",
  "--release",
  "--lib",
  "--",
  "value_hash_materialization",
  "grouping_primitive",
  "--test-threads=1"
]

data ci_v1_compiler_tests_compile_gate_cargo_path: String = "dag/extdeps/rust/cargo_build.dag"
data ci_v1_compiler_tests_compile_gate_cargo_service: String = "cargo.Build"
data ci_v1_compiler_tests_compile_gate_cargo_operation: String = "Test"
data ci_v1_compiler_tests_compile_gate_cargo_bin_env_var: String = "CARGO_BIN"

data ci_v1_compiler_tests_compile_gate_refusal_prefix: String = "__GUNBC_EFFECT_PLAN_BASH_REFUSED__ v1-compiler-tests compile gate: "

data ci_v1_compiler_tests_compile_gate_authority_note: String = "Build-job compile-contract gate for the v1-compiler-tests workspace crate. Wave B typed carrier: one extdeps.cargo_build cargo.Build.Test invocation (--release --no-run) bound by name; runs after the release build so v1-compiler is compiled once in release with the same feature set as the test crate. Bash realization supplies HostEnvVar for ci_v1_compiler_tests_compile_gate_cargo_bin_env_var so the pin-rustup prelude env var renders through bash_build_word_var in effect_plan_bash_materialize — not a post-emission string substitution and not fused into the agnostic BoundOperationInvocation substrate. argv tail tokens remain declaration-derived; GitHub Actions run: is still a foreign-executor shell transport scaffold awaiting full orchestration emit."

data ci_v1_compiler_tests_compile_gate_shell_emit_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "v2.workflow.ci_v1_compiler_tests_compile_gate_emit",
    decl_name: "ci_v1_compiler_tests_compile_gate_script",
    field: WholeDeclaration
  }
}

data ci_v1_compiler_tests_compile_gate_shell_emit_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: "🟡 dissolve-on: ci_v1_compiler_tests_compile_gate_script — foreign-executor (GitHub Actions run:) shell transport for extdeps.cargo_build cargo.Build.Test(extra_args: ci_v1_compiler_tests_compile_gate_extra_args); the EAGAIN retry wrapper lives in gunbc.ci_workflow ci_v1_compiler_tests_compile_gate_run_script (same seam as ci_release_build_script); DISSOLVES WHEN bash-emit (#5828 / ROADMAP 6-shell-slice0 / shell→intent Phase 2) binds the build-job step to orchestration emit over the typed cargo operation — the same de-fork ci_fmt_gate_line and ci_release_build_script await")

fn ci_v1_compiler_tests_compile_gate_check_step() -> BashBoundOperationInvocation {
  bash_bind_operation_invocation_host_env_executable(
    at: OperationRef {
      path: ci_v1_compiler_tests_compile_gate_cargo_path,
      service: ci_v1_compiler_tests_compile_gate_cargo_service,
      operation: ci_v1_compiler_tests_compile_gate_cargo_operation
    },
    bindings: [
      operation_argv_bind_text_list(
        name: "extra_args",
        items: ci_v1_compiler_tests_compile_gate_extra_args
      )
    ],
    env_var: ci_v1_compiler_tests_compile_gate_cargo_bin_env_var
  )
}

fn ci_v1_compiler_tests_compile_gate_intent() -> EffectPlan<BashBoundOperationInvocation> {
  EffectPlan {
    steps: [Do { effect: ci_v1_compiler_tests_compile_gate_check_step() }],
    on_failure: FailFast
  }
}

fn ci_v1_compiler_tests_compile_gate_render(
  plan: EffectPlan<BashBoundOperationInvocation>
) -> String {
  match effect_plan_bash_materialize(plan: plan) {
    EffectPlanBashMaterialized { source: source } => source
    EffectPlanBashMaterializationRefused { refusal: refusal } =>
      concat(
        ci_v1_compiler_tests_compile_gate_refusal_prefix,
        effect_plan_bash_refusal_label(refusal: refusal)
      )
  }
}

fn ci_v1_compiler_tests_compile_gate_command() -> String {
  ci_v1_compiler_tests_compile_gate_render(plan: ci_v1_compiler_tests_compile_gate_intent())
}

fn ci_v1_compiler_tests_compile_gate_script() -> String {
  concat(
    concat("# ", concat(dissolution_description(condition: ci_v1_compiler_tests_compile_gate_shell_emit_dissolution_trigger), "\n")),
    concat(ci_v1_compiler_tests_compile_gate_command(), "\n")
  )
}

data ci_interpreter_parity_controls_shell_emit_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci_workflow",
    decl_name: "ci_interpreter_parity_controls_run_script",
    field: WholeDeclaration
  }
}

data ci_interpreter_parity_controls_shell_emit_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: "🟡 dissolve-on: ci_interpreter_parity_controls_run_script — foreign-executor (GitHub Actions run:) shell transport for extdeps.cargo_build cargo.Build.Test(extra_args: ci_interpreter_parity_controls_extra_args); this is the SECOND build-job consumer of the same seam as ci_v1_compiler_tests_compile_gate_script, not an independent transport class, and it dissolves with it WHEN bash-emit (#5828 / ROADMAP 6-shell-slice0 / shell→intent Phase 2) binds the build-job steps to orchestration emit over the typed cargo operation. It shares the ci_cargo_eagain_retry_script level-1 retry seam, so it also joins the srvN STEP 2 population ci_v1_compiler_tests_compile_gate_eagain_retry_note tracks for removal")

fn ci_interpreter_parity_controls_check_step() -> BashBoundOperationInvocation {
  bash_bind_operation_invocation_host_env_executable(
    at: OperationRef {
      path: ci_v1_compiler_tests_compile_gate_cargo_path,
      service: ci_v1_compiler_tests_compile_gate_cargo_service,
      operation: ci_v1_compiler_tests_compile_gate_cargo_operation
    },
    bindings: [
      operation_argv_bind_text_list(
        name: "extra_args",
        items: ci_interpreter_parity_controls_extra_args
      )
    ],
    env_var: ci_v1_compiler_tests_compile_gate_cargo_bin_env_var
  )
}

fn ci_interpreter_parity_controls_intent() -> EffectPlan<BashBoundOperationInvocation> {
  EffectPlan {
    steps: [Do { effect: ci_interpreter_parity_controls_check_step() }],
    on_failure: FailFast
  }
}

fn ci_interpreter_parity_controls_command() -> String {
  ci_v1_compiler_tests_compile_gate_render(plan: ci_interpreter_parity_controls_intent())
}
