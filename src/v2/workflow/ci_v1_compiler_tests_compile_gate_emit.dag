module v2.workflow.ci_v1_compiler_tests_compile_gate_emit


data ci_v1_compiler_tests_compile_gate_extra_args: List<String> = [
  "-p",
  "v1-compiler-tests",
  "--release"
]

data ci_v1_compiler_tests_compile_gate_cargo_path: String = "dag/extdeps/rust/cargo_build.dag"
data ci_v1_compiler_tests_compile_gate_cargo_service: String = "cargo.Build"
data ci_v1_compiler_tests_compile_gate_cargo_operation: String = "Test"
data ci_v1_compiler_tests_compile_gate_cargo_bin_env_var: String = "CARGO_BIN"

data ci_v1_compiler_tests_compile_gate_refusal_prefix: String = "__GUNBC_EFFECT_PLAN_BASH_REFUSED__ v1-compiler-tests compile gate: "

data ci_v1_compiler_tests_compile_gate_authority_note: String = "Build-job RETAINED-KERNEL EXECUTION gate for the v1-compiler-tests workspace crate. --no-run was removed 2026-08-11: the crate is now the declared retained kernel (test.retirement.model retained_legacy_rust_test_modules), so the gate RUNS the tests rather than only typechecking their bodies. There is no compile-only arm — a retained test either executes or the gate refuses. Wave B typed carrier: one extdeps.cargo_build cargo.Build.Test invocation (--release) bound by name; runs after the release build so v1-compiler is compiled once in release with the same feature set as the test crate. Bash realization supplies HostEnvVar for ci_v1_compiler_tests_compile_gate_cargo_bin_env_var so the pin-rustup prelude env var renders through bash_build_word_var in effect_plan_bash_materialize — not a post-emission string substitution and not fused into the agnostic BoundOperationInvocation substrate. argv tail tokens remain declaration-derived; GitHub Actions run: is still a foreign-executor shell transport scaffold awaiting full orchestration emit."

data ci_v1_compiler_tests_compile_gate_shell_emit_scaffold: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "v2.workflow.ci_v1_compiler_tests_compile_gate_emit",
    decl_name: "ci_v1_compiler_tests_compile_gate_script",
    field: std.decl_ref.WholeDeclaration
  }
}

data ci_v1_compiler_tests_compile_gate_shell_emit_dissolution_trigger: std.dissolution.DissolutionCondition = std.dissolution.unbound_dissolution(description: "🟡 dissolve-on: ci_v1_compiler_tests_compile_gate_script — foreign-executor (GitHub Actions run:) shell transport for extdeps.cargo_build cargo.Build.Test(extra_args: ci_v1_compiler_tests_compile_gate_extra_args); the EAGAIN retry wrapper lives in gunbc.ci_workflow ci_v1_compiler_tests_compile_gate_run_script (same seam as ci_release_build_script); DISSOLVES WHEN bash-emit (#5828 / ROADMAP 6-shell-slice0 / shell→intent Phase 2) binds the build-job step to orchestration emit over the typed cargo operation — the same de-fork ci_fmt_gate_line and ci_release_build_script await")

fn ci_v1_compiler_tests_compile_gate_check_step() -> v2.workflow.effect_plan_bash_materialize.BashBoundOperationInvocation {
  bash_bind_operation_invocation_host_env_executable(
    at: v2.std.operation_argv.OperationRef {
      path: ci_v1_compiler_tests_compile_gate_cargo_path,
      service: ci_v1_compiler_tests_compile_gate_cargo_service,
      operation: ci_v1_compiler_tests_compile_gate_cargo_operation
    },
    bindings: [
      operation_argv_bind_text_list(
        name: "extra_args",
        items: ci_v1_compiler_tests_compile_gate_extra_args
      )
    ],
    env_var: ci_v1_compiler_tests_compile_gate_cargo_bin_env_var
  )
}

fn ci_v1_compiler_tests_compile_gate_intent() -> EffectPlan<v2.workflow.effect_plan_bash_materialize.BashBoundOperationInvocation> {
  v2.std.effect_plan.EffectPlan {
    steps: [v2.std.effect_plan.Do { effect: ci_v1_compiler_tests_compile_gate_check_step() }],
    on_failure: FailFast
  }
}

fn ci_v1_compiler_tests_compile_gate_render(
  plan: EffectPlan<v2.workflow.effect_plan_bash_materialize.BashBoundOperationInvocation>
) -> String {
  match effect_plan_bash_materialize(plan: plan) {
    EffectPlanBashMaterialized { source: source } => source
    EffectPlanBashMaterializationRefused { refusal: refusal } =>
      concat(
        ci_v1_compiler_tests_compile_gate_refusal_prefix,
        effect_plan_bash_refusal_label(refusal: refusal)
      )
  }
}

fn ci_v1_compiler_tests_compile_gate_command() -> String {
  ci_v1_compiler_tests_compile_gate_render(plan: ci_v1_compiler_tests_compile_gate_intent())
}

fn ci_v1_compiler_tests_compile_gate_script() -> String {
  concat(
    concat("# ", concat(std.dissolution.dissolution_description(condition: ci_v1_compiler_tests_compile_gate_shell_emit_dissolution_trigger), "\n")),
    concat(ci_v1_compiler_tests_compile_gate_command(), "\n")
  )
}
