module v2.workflow.floor_cost_debt_edit

import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_language_model }
import v2.std.compilers.lexing { LexRules, Token, token_stream_all }
import v2.std.collection { List }
import v2.std.algebra { Cons, Empty, any, contains, ListHeadResult, HeadFound, HeadAbsent, list_head, ListTailResult, TailFound, TailAbsent, list_tail, list_reverse }
import v2.std.optional { Optional, Absent, Present, optional_absent, optional_present }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.integer { Int }
import v2.std.node { Symbol }
import v2.std.text { String }
import std.measure { EvalStepCount }
import std.types { GitRef, FilePath }
import extdeps.git
import v2.workflow.required_floor {
  ClaimCeilingTier,
  GrandfatheredTier,
  NewWitnessTier,
  claim_ceiling_eval_step_budget
}

// WHICH CEILING A CHANGED COST-DEBT WITNESS IS JUDGED AGAINST (operator ruling, 2026-09-19, relayed
// by proud-tern-736): "NARROW YES. A touched cost-debt witness keeps its rostered budget tier ONLY
// when the edit's sole change is removing test-fn references (conjuncts/calls); any other edit to it
// still re-judges at the new-witness tier."
//
// A COST-DEBT ROW HAS NO TIER OF ITS OWN, so "rostered tier" needs a reading, and this is it. The
// grandfathered cut (`v2.workflow.floor_grandfathered_roster`) took only identities the floor
// PLANNED, and a debt row is never planned -- it is withheld (`DeclinedCostDebt`). The budget it was
// withheld against is the ceiling of its era, the 500ms-equivalent `GrandfatheredTier`, so that is
// the tier a pure removal keeps. The row still EXECUTES for its verdict: the 2026-08-30 rule that a
// changed witness must answer stands, and keeping the row withheld would pass an edited witness by
// not running it (snappy-koi-46, 2026-09-19). The wall deadline stays armed on both arms.
//
// "PURE REMOVAL" IS DECIDED FROM STRUCTURE AND FROM NOTHING THE AUTHOR WRITES. Both sides of the
// declaration are read through the corpus's own lexer (`v2.compiler.tokenize` over
// `dag_language_model`), and the head token stream must be the base stream with one or more WHOLE
// CALL CONJUNCTS deleted and nothing else changed -- so the head's references are a subset of the
// base's by construction. A conjunct is `&& path(args)` (trailing) or `path(args) &&` (leading),
// with `path` one or more dotted identifiers and `args` balanced. Signature, literals, operators,
// order and every surviving token must be identical. Any other difference, including an edit that
// removes a conjunct AND adds anything, re-judges.
//
// PRECEDENCE IS WHY THE NEIGHBOURS ARE CHECKED, not only the deleted tokens. Deleting `&& f()` from
// `a && f() == b` leaves `a == b`, which is not `a` with a conjunct removed. So a trailing deletion
// must be followed by a token that binds no tighter than `&&` (another `&&` or `||`, a closing
// bracket, a comma, an identifier starting the next arm, or the end), and a leading deletion must be
// preceded by one that opens an operand (`(`, `{`, `[`, `,`, `=`, `=>`, `&&`, `||`, `if`, `then`,
// `else`, `return`, or the start). Everything outside those sets refuses: the lists are allowlists,
// so an unforeseen neighbour re-judges rather than keeps the tier.
//
// THIS IS A DIVERGENCE FROM THE GRAMMAR, STATED WITH ITS REASON (review 68240). The two allowlists
// and the declaration scan re-state, lexically, facts `v2.extdeps.languages.dag`'s grammar owns --
// what is a conjunct of an `&&` chain, where a declaration ends. The faithful reading compares the
// parsed conjunct lists of the `test fn` at base and head through `v2.compiler.parse`. It is not
// used because it does not fit the floor this rule serves: parsing two one-line `test fn`s through
// `parse_module` measured above the NEW-WITNESS eval-step ceiling on its own, before any tree walk,
// so no witness of a parse-based rule could run on the required floor, and preparing the grammar
// explicitly cost roughly ten times that ceiling. Re-derive both by running a claim that parses two
// such sources under `claim_batch` and reading its `eval_steps`. The lexical reading is the
// conservative one -- every neighbour it does not list re-judges -- so the divergence can only
// withhold the grandfathered tier, never grant it wrongly.
//
// DISSOLVES WHEN parsing a single `test fn` declaration at base and head fits inside the new-witness
// ceiling with room for its tree walk -- a served prepared grammar, or a declaration-grain parse
// entry. Then this module compares parsed conjunct lists and resolves callees through the resolved
// namespace, and the allowlists, `decl_scan_step` and the import scan are deleted rather than kept
// beside the parse.
//
// THE CALLEE MUST BE A TEST FN, as the ruling says. Every removed call is resolved lexically against
// the base file and must name an identity in the floor's own discovered test-fn population; a call
// that resolves to anything else, or to nothing, re-judges (see `removed_call_is_test_fn`).
//
// THE HOST'S SHARE IS READING THE HEAD FILE, KNOWING WHICH WITNESS SITES ARE CHANGED DEBT ROWS, AND
// PASSING THE FLOOR'S DISCOVERED TEST-FN IDENTITIES, which it already holds.
// The base is read here (`git.Core.Show` at the floor's resolved comparison base, the same read
// `v2.workflow.floor_diff_observe` `floor_run_base_test_decl_census` performs), and the decision and
// the tier are this module's.

type CostDebtEditReJudgeCause =
    WitnessNotDeclaredAtBase
  | WitnessNotDeclaredAtHead
  | WitnessSourceDidNotTokenize
  | WitnessTokensUnchanged
  | EditIsNotAConjunctRemoval
  | RemovedCallIsNotATestFn

type CostDebtWitnessEdit =
    PureConjunctRemoval { removed_conjuncts: Int }
  | ReJudgedAsNewWitness { cause: CostDebtEditReJudgeCause }

// WHAT THE HOST CONSUMES, AND NOTHING ELSE (review 68218): `label` is the receipt wording the host
// prints (the edit's projection, so the host formats nothing) and `budget` is the tier's ceiling.
// The edit and the tier are not carried beside them -- each would be a second representation of a
// fact a read field already carries, with no reader of its own.
type CostDebtChangedWitnessCeiling {
  label: String
  budget: EvalStepCount
}

fn cost_debt_edit_tier(edit: CostDebtWitnessEdit) -> ClaimCeilingTier {
  match edit {
    PureConjunctRemoval { removed_conjuncts: _ } => GrandfatheredTier {}
    ReJudgedAsNewWitness { cause: _ } => NewWitnessTier {}
  }
}

fn cost_debt_changed_witness_ceiling(edit: CostDebtWitnessEdit) -> CostDebtChangedWitnessCeiling {
  CostDebtChangedWitnessCeiling {
    label: cost_debt_edit_label(edit: edit),
    budget: claim_ceiling_eval_step_budget(tier: cost_debt_edit_tier(edit: edit))
  }
}

fn cost_debt_edit_cause_label(cause: CostDebtEditReJudgeCause) -> String {
  match cause {
    WitnessNotDeclaredAtBase => "witness_not_declared_at_base"
    WitnessNotDeclaredAtHead => "witness_not_declared_at_head"
    WitnessSourceDidNotTokenize => "witness_source_did_not_tokenize"
    WitnessTokensUnchanged => "witness_tokens_unchanged"
    EditIsNotAConjunctRemoval => "edit_is_not_a_conjunct_removal"
    RemovedCallIsNotATestFn => "removed_call_is_not_a_test_fn"
  }
}

fn cost_debt_edit_label(edit: CostDebtWitnessEdit) -> String {
  match edit {
    PureConjunctRemoval { removed_conjuncts: _ } => "pure_conjunct_removal"
    ReJudgedAsNewWitness { cause: c } => join(["rejudged_as_new_witness cause=", cost_debt_edit_cause_label(cause: c)], "")
  }
}

// ---- tokens of one declaration ----

fn cost_debt_edit_source_tokens(source: String, rules: LexRules) -> Optional<List<Token>> {
  match tokenize(text: source, file: ^cost_debt_edit_source, rules: rules) {
    Accepted { value: stream, diagnostics: _ } => optional_present(value: token_stream_all(stream: stream))
    Rejected { diagnostics: _ } => optional_absent()
  }
}

type DeclScanPhase =
    DeclSeeking
  | DeclSawTest
  | DeclSawFn
  | DeclInSignature
  | DeclInBody { depth: Int }
  | DeclDone

// `tokens` is accumulated IN REVERSE (cons, then one `list_reverse` at the end): an append per
// token would copy the accumulator every step, the quadratic shape DESIGN section 6 always fixes.
type DeclScan {
  phase: DeclScanPhase
  tokens: List<Token>
}

fn decl_scan_seek(tok: Token) -> DeclScan {
  if tok.class == ^dag_token_ident && tok.lexeme == "test" {
    DeclScan { phase: DeclSawTest {}, tokens: Cons { head: tok, tail: Empty } }
  } else {
    DeclScan { phase: DeclSeeking {}, tokens: [] }
  }
}

fn decl_scan_step(acc: DeclScan, tok: Token, function: String) -> DeclScan {
  match acc.phase {
    DeclDone => acc
    DeclSeeking => decl_scan_seek(tok: tok)
    DeclSawTest =>
      if tok.class == ^dag_token_kw_fn {
        DeclScan { phase: DeclSawFn {}, tokens: Cons { head: tok, tail: acc.tokens } }
      } else {
        decl_scan_seek(tok: tok)
      }
    DeclSawFn =>
      if tok.class == ^dag_token_ident && tok.lexeme == function {
        DeclScan { phase: DeclInSignature {}, tokens: Cons { head: tok, tail: acc.tokens } }
      } else {
        decl_scan_seek(tok: tok)
      }
    DeclInSignature =>
      if tok.class == ^dag_token_lbrace {
        DeclScan { phase: DeclInBody { depth: 1 }, tokens: Cons { head: tok, tail: acc.tokens } }
      } else {
        DeclScan { phase: DeclInSignature {}, tokens: Cons { head: tok, tail: acc.tokens } }
      }
    DeclInBody { depth: d } => {
      let tokens = Cons { head: tok, tail: acc.tokens }
      if tok.class == ^dag_token_lbrace {
        DeclScan { phase: DeclInBody { depth: d + 1 }, tokens: tokens }
      } else if tok.class == ^dag_token_rbrace {
        if d == 1 {
          DeclScan { phase: DeclDone {}, tokens: tokens }
        } else {
          DeclScan { phase: DeclInBody { depth: d - 1 }, tokens: tokens }
        }
      } else {
        DeclScan { phase: DeclInBody { depth: d }, tokens: tokens }
      }
    }
  }
}

// The whole `test fn <function> ... { ... }` declaration, signature included, so a signature edit
// is a difference like any other. Absent when the declaration is not found closed.
fn cost_debt_edit_decl_tokens(tokens: List<Token>, function: String) -> Optional<List<Token>> {
  let scan = fold(tokens, init: DeclScan { phase: DeclSeeking {}, tokens: [] }, f: fn(acc, tok) {
    decl_scan_step(acc: acc, tok: tok, function: function)
  })
  match scan.phase {
    DeclDone => optional_present(value: list_reverse(xs: scan.tokens))
    DeclSeeking => optional_absent()
    DeclSawTest => optional_absent()
    DeclSawFn => optional_absent()
    DeclInSignature => optional_absent()
    DeclInBody { depth: _ } => optional_absent()
  }
}

// ---- the removal walk ----

type ConjunctForm =
    TrailingConjunct
  | LeadingConjunct

type RemovalPhase =
    WalkAligned
  | WalkAfterAndAnd
  | WalkCallName { form: ConjunctForm }
  | WalkCallDot { form: ConjunctForm }
  | WalkCallArgs { form: ConjunctForm, depth: Int }
  | WalkLeadingNeedsAndAnd
  | WalkBroken

type RemovalWalk {
  head: List<Token>
  phase: RemovalPhase
  removed: Int
  prev_kept: Optional<Symbol>
  follower_pending: Bool
  call_path: String
  call_dotted: Bool
  removed_calls: List<RemovedCall>
}

// One deleted call, as authored. A dotted path names its module in full; a bare name is resolved
// against the base file (its own module, then its import blocks) by `removed_call_candidates`.
type RemovedCall {
  path: String
  dotted: Bool
}

fn removal_tokens_equal(a: Token, b: Token) -> Bool {
  a.class == b.class && a.lexeme == b.lexeme
}

fn removal_safe_follower(class: Symbol) -> Bool {
  class == ^dag_token_and_and
    || class == ^dag_token_or_or
    || class == ^dag_token_rparen
    || class == ^dag_token_rbrace
    || class == ^dag_token_rbracket
    || class == ^dag_token_comma
    || class == ^dag_token_ident
}

fn removal_operand_opener(prev: Optional<Symbol>) -> Bool {
  match prev {
    Absent => true
    Present { value: class } =>
      class == ^dag_token_and_and
        || class == ^dag_token_or_or
        || class == ^dag_token_lparen
        || class == ^dag_token_lbrace
        || class == ^dag_token_lbracket
        || class == ^dag_token_comma
        || class == ^dag_token_eq
        || class == ^dag_token_fat_arrow
        || class == ^dag_token_kw_if
        || class == ^dag_token_kw_then
        || class == ^dag_token_kw_else
        || class == ^dag_token_kw_return
  }
}

fn removal_walk_with_phase(w: RemovalWalk, phase: RemovalPhase) -> RemovalWalk {
  RemovalWalk { head: w.head, phase: phase, removed: w.removed, prev_kept: w.prev_kept, follower_pending: w.follower_pending, call_path: w.call_path, call_dotted: w.call_dotted, removed_calls: w.removed_calls }
}

// The removed call's path, as authored: one identifier, or dotted identifiers.
fn removal_walk_start_call(w: RemovalWalk, form: ConjunctForm, name: String) -> RemovalWalk {
  RemovalWalk { head: w.head, phase: WalkCallName { form: form }, removed: w.removed, prev_kept: w.prev_kept, follower_pending: w.follower_pending, call_path: name, call_dotted: false, removed_calls: w.removed_calls }
}

fn removal_walk_extend_call(w: RemovalWalk, form: ConjunctForm, name: String) -> RemovalWalk {
  RemovalWalk { head: w.head, phase: WalkCallName { form: form }, removed: w.removed, prev_kept: w.prev_kept, follower_pending: w.follower_pending, call_path: join([w.call_path, ".", name], ""), call_dotted: true, removed_calls: w.removed_calls }
}

fn removal_walk_commit_call(w: RemovalWalk, follower_pending: Bool) -> RemovalWalk {
  RemovalWalk { head: w.head, phase: WalkAligned {}, removed: w.removed + 1, prev_kept: w.prev_kept, follower_pending: follower_pending, call_path: "", call_dotted: false, removed_calls: Cons { head: RemovedCall { path: w.call_path, dotted: w.call_dotted }, tail: w.removed_calls } }
}

fn removal_walk_broken(w: RemovalWalk) -> RemovalWalk {
  removal_walk_with_phase(w: w, phase: WalkBroken {})
}

fn removal_walk_aligned_step(w: RemovalWalk, b: Token) -> RemovalWalk {
  if w.follower_pending && !removal_safe_follower(class: b.class) {
    removal_walk_broken(w: w)
  } else {
    let cleared = RemovalWalk { head: w.head, phase: WalkAligned {}, removed: w.removed, prev_kept: w.prev_kept, follower_pending: false, call_path: w.call_path, call_dotted: w.call_dotted, removed_calls: w.removed_calls }
    let head_matches = match list_head(xs: cleared.head) {
      HeadAbsent => false
      HeadFound { value: h } => removal_tokens_equal(a: h, b: b)
    }
    if head_matches {
      let rest = match list_tail(xs: cleared.head) {
        TailAbsent => []
        TailFound { tail: t } => t
      }
      RemovalWalk { head: rest, phase: WalkAligned {}, removed: cleared.removed, prev_kept: optional_present(value: b.class), follower_pending: false, call_path: cleared.call_path, call_dotted: cleared.call_dotted, removed_calls: cleared.removed_calls }
    } else if b.class == ^dag_token_and_and {
      removal_walk_with_phase(w: cleared, phase: WalkAfterAndAnd {})
    } else if b.class == ^dag_token_ident && removal_operand_opener(prev: cleared.prev_kept) {
      removal_walk_start_call(w: cleared, form: LeadingConjunct {}, name: b.lexeme)
    } else {
      removal_walk_broken(w: cleared)
    }
  }
}

fn removal_walk_call_closed(w: RemovalWalk, form: ConjunctForm) -> RemovalWalk {
  match form {
    TrailingConjunct =>
      removal_walk_commit_call(w: w, follower_pending: true)
    LeadingConjunct => removal_walk_with_phase(w: w, phase: WalkLeadingNeedsAndAnd {})
  }
}

fn removal_walk_step(w: RemovalWalk, b: Token) -> RemovalWalk {
  match w.phase {
    WalkBroken => w
    WalkAligned => removal_walk_aligned_step(w: w, b: b)
    WalkAfterAndAnd =>
      if b.class == ^dag_token_ident {
        removal_walk_start_call(w: w, form: TrailingConjunct {}, name: b.lexeme)
      } else {
        removal_walk_broken(w: w)
      }
    WalkCallName { form: f } =>
      if b.class == ^dag_token_dot {
        removal_walk_with_phase(w: w, phase: WalkCallDot { form: f })
      } else if b.class == ^dag_token_lparen {
        removal_walk_with_phase(w: w, phase: WalkCallArgs { form: f, depth: 1 })
      } else {
        removal_walk_broken(w: w)
      }
    WalkCallDot { form: f } =>
      if b.class == ^dag_token_ident {
        removal_walk_extend_call(w: w, form: f, name: b.lexeme)
      } else {
        removal_walk_broken(w: w)
      }
    WalkCallArgs { form: f, depth: d } =>
      if b.class == ^dag_token_lparen {
        removal_walk_with_phase(w: w, phase: WalkCallArgs { form: f, depth: d + 1 })
      } else if b.class == ^dag_token_rparen {
        if d == 1 {
          removal_walk_call_closed(w: w, form: f)
        } else {
          removal_walk_with_phase(w: w, phase: WalkCallArgs { form: f, depth: d - 1 })
        }
      } else {
        w
      }
    WalkLeadingNeedsAndAnd =>
      if b.class == ^dag_token_and_and {
        removal_walk_commit_call(w: w, follower_pending: false)
      } else {
        removal_walk_broken(w: w)
      }
  }
}

// THE DECISION OVER TWO TOKEN STREAMS. The claim-grain interface: witnesses supply the streams'
// sources directly (DESIGN section 3, a witness discriminates at one interface).
fn cost_debt_edit_from_decl_tokens(
  base: List<Token>,
  head: List<Token>,
  resolution: BaseResolution,
  test_fn_identities: List<String>
) -> CostDebtWitnessEdit {
  let walk = fold(base, init: RemovalWalk { head: head, phase: WalkAligned {}, removed: 0, prev_kept: optional_absent(), follower_pending: false, call_path: "", call_dotted: false, removed_calls: [] }, f: fn(acc, b) {
    removal_walk_step(w: acc, b: b)
  })
  let head_exhausted = match list_head(xs: walk.head) {
    HeadAbsent => true
    HeadFound { value: _ } => false
  }
  let aligned = match walk.phase {
    WalkAligned => true
    WalkAfterAndAnd => false
    WalkCallName { form: _ } => false
    WalkCallDot { form: _ } => false
    WalkCallArgs { form: _, depth: _ } => false
    WalkLeadingNeedsAndAnd => false
    WalkBroken => false
  }
  if !(aligned && head_exhausted) {
    ReJudgedAsNewWitness { cause: EditIsNotAConjunctRemoval {} }
  } else if walk.removed == 0 {
    ReJudgedAsNewWitness { cause: WitnessTokensUnchanged {} }
  } else if any(xs: walk.removed_calls, predicate: fn(c) {
    !removed_call_is_test_fn(call: c, resolution: resolution, test_fn_identities: test_fn_identities)
  }) {
    ReJudgedAsNewWitness { cause: RemovedCallIsNotATestFn {} }
  } else {
    PureConjunctRemoval { removed_conjuncts: walk.removed }
  }
}

// ---- resolving a removed call against the base file ----
//
// THE RULING NAMES TEST-FN REFERENCES, AND THIS IS WHERE THAT NARROWING IS ENFORCED (snappy-koi-46,
// 2026-09-19). A removed call qualifies only when it resolves to an identity in the floor's own
// discovered test-fn population, which the host passes in unchanged. Resolution is lexical over the
// base file: a dotted path is taken as fully qualified; a bare name is tried as a test fn of the
// witness's own module, then through every `import M { name }` block. An aliased import (`as`) is
// dropped rather than followed, so its callee resolves to nothing and the edit re-judges. Anything
// that does not resolve re-judges: the failure direction is always the stricter tier.

type ImportedName {
  local: String
  qualified: String
}

type BaseResolution {
  module_path: String
  imports: List<ImportedName>
}

type ImportScanPhase =
    ImportIdle
  | ImportModulePath { path: String, expect_segment: Bool }
  | ImportItems { module_path: String, pending: Optional<String>, aliasing: Bool }

type ImportScan {
  phase: ImportScanPhase
  names: List<ImportedName>
}

fn import_scan_commit(names: List<ImportedName>, module_path: String, pending: Optional<String>) -> List<ImportedName> {
  match pending {
    Absent => names
    Present { value: local } => Cons { head: ImportedName { local: local, qualified: join([module_path, ".", local], "") }, tail: names }
  }
}

fn import_scan_step(acc: ImportScan, tok: Token) -> ImportScan {
  match acc.phase {
    ImportIdle =>
      if tok.class == ^dag_token_kw_import {
        ImportScan { phase: ImportModulePath { path: "", expect_segment: true }, names: acc.names }
      } else {
        acc
      }
    ImportModulePath { path: path, expect_segment: expect_segment } =>
      if tok.class == ^dag_token_ident && expect_segment {
        let next = if path == "" { tok.lexeme } else { join([path, ".", tok.lexeme], "") }
        ImportScan { phase: ImportModulePath { path: next, expect_segment: false }, names: acc.names }
      } else if tok.class == ^dag_token_dot && !expect_segment {
        ImportScan { phase: ImportModulePath { path: path, expect_segment: true }, names: acc.names }
      } else if tok.class == ^dag_token_lbrace && !expect_segment {
        ImportScan { phase: ImportItems { module_path: path, pending: optional_absent(), aliasing: false }, names: acc.names }
      } else if tok.class == ^dag_token_kw_import {
        ImportScan { phase: ImportModulePath { path: "", expect_segment: true }, names: acc.names }
      } else {
        ImportScan { phase: ImportIdle {}, names: acc.names }
      }
    ImportItems { module_path: m, pending: pending, aliasing: aliasing } =>
      if tok.class == ^dag_token_ident {
        if aliasing {
          ImportScan { phase: ImportItems { module_path: m, pending: optional_absent(), aliasing: false }, names: acc.names }
        } else {
          ImportScan { phase: ImportItems { module_path: m, pending: optional_present(value: tok.lexeme), aliasing: false }, names: import_scan_commit(names: acc.names, module_path: m, pending: pending) }
        }
      } else if tok.class == ^dag_token_kw_as {
        ImportScan { phase: ImportItems { module_path: m, pending: optional_absent(), aliasing: true }, names: acc.names }
      } else if tok.class == ^dag_token_comma {
        ImportScan { phase: ImportItems { module_path: m, pending: optional_absent(), aliasing: false }, names: import_scan_commit(names: acc.names, module_path: m, pending: pending) }
      } else if tok.class == ^dag_token_rbrace {
        ImportScan { phase: ImportIdle {}, names: import_scan_commit(names: acc.names, module_path: m, pending: pending) }
      } else {
        acc
      }
  }
}

// A dotted path is identifiers SEPARATED BY DOTS: `expect_segment` is true at the start and after a
// dot, so an identifier arriving where a dot was due ends the path rather than joining it (the
// header `module m` followed by `test fn` is the module `m`, not `m.test`).
type ModuleScan =
    ModuleSeeking
  | ModuleReading { path: String, expect_segment: Bool }
  | ModuleRead { path: String }

fn module_scan_step(acc: ModuleScan, tok: Token) -> ModuleScan {
  match acc {
    ModuleRead { path: _ } => acc
    ModuleSeeking =>
      if tok.class == ^dag_token_kw_module {
        ModuleReading { path: "", expect_segment: true }
      } else {
        acc
      }
    ModuleReading { path: path, expect_segment: expect_segment } =>
      if tok.class == ^dag_token_ident && expect_segment {
        if path == "" { ModuleReading { path: tok.lexeme, expect_segment: false } } else { ModuleReading { path: join([path, ".", tok.lexeme], ""), expect_segment: false } }
      } else if tok.class == ^dag_token_dot && !expect_segment {
        ModuleReading { path: path, expect_segment: true }
      } else {
        ModuleRead { path: path }
      }
  }
}

fn cost_debt_edit_base_resolution(tokens: List<Token>) -> BaseResolution {
  let module_path = match fold(tokens, init: ModuleSeeking {}, f: fn(acc, tok) { module_scan_step(acc: acc, tok: tok) }) {
    ModuleSeeking => ""
    ModuleReading { path: p, expect_segment: _ } => p
    ModuleRead { path: p } => p
  }
  let imports = fold(tokens, init: ImportScan { phase: ImportIdle {}, names: [] }, f: fn(acc, tok) {
    import_scan_step(acc: acc, tok: tok)
  })
  BaseResolution { module_path: module_path, imports: imports.names }
}

fn identity_is_test_fn(identity: String, test_fn_identities: List<String>) -> Bool {
  contains(xs: test_fn_identities, item: identity, eq: fn(a, b) { a == b })
}

fn removed_call_is_test_fn(call: RemovedCall, resolution: BaseResolution, test_fn_identities: List<String>) -> Bool {
  if call.dotted {
    identity_is_test_fn(identity: call.path, test_fn_identities: test_fn_identities)
  } else if resolution.module_path != "" && identity_is_test_fn(identity: join([resolution.module_path, ".", call.path], ""), test_fn_identities: test_fn_identities) {
    true
  } else {
    any(xs: resolution.imports, predicate: fn(imported) {
      imported.local == call.path && identity_is_test_fn(identity: imported.qualified, test_fn_identities: test_fn_identities)
    })
  }
}

type DeclReading =
    DeclSourceUntokenizable
  | DeclNotFound
  | DeclFound { tokens: List<Token>, file_tokens: List<Token> }

fn cost_debt_edit_decl_of(source: String, function: String, rules: LexRules) -> DeclReading {
  match cost_debt_edit_source_tokens(source: source, rules: rules) {
    Absent => DeclSourceUntokenizable {}
    Present { value: tokens } =>
      match cost_debt_edit_decl_tokens(tokens: tokens, function: function) {
        Absent => DeclNotFound {}
        Present { value: decl } => DeclFound { tokens: decl, file_tokens: tokens }
      }
  }
}

// THE DECISION OVER TWO FILE SOURCES, which is what the witnesses exercise and what the wet entry
// below calls once the base is read.
// The language model is built ONCE per decision and lent to both sides.
fn cost_debt_edit_from_sources(
  base_source: String,
  head_source: String,
  function: String,
  test_fn_identities: List<String>
) -> CostDebtWitnessEdit {
  let rules = dag_language_model().lex
  match cost_debt_edit_decl_of(source: base_source, function: function, rules: rules) {
    DeclSourceUntokenizable => ReJudgedAsNewWitness { cause: WitnessSourceDidNotTokenize {} }
    DeclNotFound => ReJudgedAsNewWitness { cause: WitnessNotDeclaredAtBase {} }
    DeclFound { tokens: base_decl, file_tokens: base_file } =>
      match cost_debt_edit_decl_of(source: head_source, function: function, rules: rules) {
        DeclSourceUntokenizable => ReJudgedAsNewWitness { cause: WitnessSourceDidNotTokenize {} }
        DeclNotFound => ReJudgedAsNewWitness { cause: WitnessNotDeclaredAtHead {} }
        DeclFound { tokens: head_decl, file_tokens: _ } =>
          cost_debt_edit_from_decl_tokens(
            base: base_decl,
            head: head_decl,
            resolution: cost_debt_edit_base_resolution(tokens: base_file),
            test_fn_identities: test_fn_identities
          )
      }
  }
}

// THE WET ENTRY THE HOST CALLS for a changed cost-debt witness. A base that cannot be shown -- the
// path absent at the base, a rename, a failed read -- is not a pure removal, so it re-judges; it
// never keeps the tier by default.
fn cost_debt_changed_witness_ceiling_at_base(
  base: String,
  path: String,
  function: String,
  head_source: String,
  test_fn_identities: List<String>
) -> CostDebtChangedWitnessCeiling {
  let shown = git.Core.Show(ref: base as GitRef, path: path as FilePath)
  if !shown.success {
    cost_debt_changed_witness_ceiling(edit: ReJudgedAsNewWitness { cause: WitnessNotDeclaredAtBase {} })
  } else {
    cost_debt_changed_witness_ceiling(
      edit: cost_debt_edit_from_sources(base_source: shown.content, head_source: head_source, function: function, test_fn_identities: test_fn_identities)
    )
  }
}
