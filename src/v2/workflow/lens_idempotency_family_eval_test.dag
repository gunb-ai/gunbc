module v2.test.workflow.lens_idempotency_family_eval

import v2.compiler.eval {
  TestClaimRun,
  test_claim_run_verdict
}
import v2.std.algebra { is_empty }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.nat { Zero }
import v2.std.node { Node }
import v2.std.runtime { RuntimeValue }
import v2.std.verdict {
  Pass,
  VerdictTally,
  verdict_tally_add,
  verdict_tally_empty
}
import v2.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}
import v2.std.witness { Holds, Violates }
import v2.lens.idempotency { idempotency_witness }
import v2.test.lens_idempotency.write_effect { idempotency_claim_tree }
import v2.test.lens_idempotency.family_receipt {
  lens_idempotency_runtime_value_rows
}

fn idempotency_control_empty_resolves() -> Bool {
  match idempotency_witness(tree: idempotency_claim_tree(), dependencies: []) {
    Holds { value: _ } => true
    Violates { diagnostic: _ } => false
  }
}

fn idempotency_discriminating_controls_pass() -> Bool {
  idempotency_control_empty_resolves()
}

type LensFamilyEvalEntry {
  run: TestClaimRun<Node, RuntimeValue>
}

type LensFamilyEvalReport {
  entries: List<LensFamilyEvalEntry>
}

fn lens_family_eval_report_tally(r: LensFamilyEvalReport) -> VerdictTally {
  fold(r.entries, init: verdict_tally_empty, f: fn(acc, e) {
    verdict_tally_add(t: acc, v: test_claim_run_verdict(run: e.run))
  })
}

fn run_lens_idempotency_family_eval() -> LensFamilyEvalReport {
  LensFamilyEvalReport {
    entries: map(
      lens_idempotency_runtime_value_rows,
      fn(run) { LensFamilyEvalEntry { run: run } }
    )
  }
}

fn lens_idempotency_family_all_pass(report: LensFamilyEvalReport) -> Bool {
  let tally = lens_family_eval_report_tally(r: report)
  (tally.fail == Zero) && (tally.deferred == Zero)
}

fn lens_idempotency_family_gate(report: LensFamilyEvalReport) -> Bool {
  if is_empty(xs: report.entries) {
    false
  } else {
    lens_idempotency_family_all_pass(report: report)
      && idempotency_discriminating_controls_pass()
  }
}

test data witness_lens_idempotency_family_gate_closed: Bool = lens_idempotency_family_gate(
  report: run_lens_idempotency_family_eval()
)
