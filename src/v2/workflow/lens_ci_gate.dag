// src/v2/workflow/lens_ci_gate.dag
//
// Minimal lens-CI claim-run transport authority.
//
// History: extracted verbatim from the deleted `v2.workflow.ci` model (`src/v2/workflow/ci.dag`).
// That ~6,300-line model was a descriptive-only CI mirror with no runtime consumer (see
// docs/planning/thin-shim-ci-a3-runall-blocker-report-2026-06-08.md) and was deleted wholesale per
// operator GO. The only fragment with a real consumer is this lens-CI claim-run roster: the must-pass
// `v2_lens_gate` CI job (`the ci-claim-gate host (gate-3)` → uniform `ci-claim-gate` host) evaluates
// `lens_ci_claim_run_rows_tsv` via the v2 interpreter — no shell awk/grep text projection. `.github/workflows/ci.yml`
// is the direct hand-edited CI authority; this file owns only the lens claim-run roster the gate consumes.

module v2.workflow.lens_ci_gate

import v2.std.collection { List }
import v2.std.algebra { fold_list_right }

// M2 Lens-CI claim-run transport authority. `lens_ci_claim_run_rows` is the sole roster;
// `lens_ci_claim_run_rows_tsv()` projects it for the `ci-claim-gate` host (no shell awk/grep).
type LensCiClaimRunRow {
  label: String
  entry: String
  function: String
}

data lens_ci_claim_run_row_cost_atom_zero: LensCiClaimRunRow = LensCiClaimRunRow {
  label: "lens_cost/atom_zero",
  entry: "src/v2/lens/cost/atom_zero.dag",
  function: "atom_zero_claim_holds"
}

