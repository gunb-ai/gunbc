// unit-modeling lens (B1) — discriminating pass+fail witnesses. The flag/pass
// pair (same `ram_bytes` field, bare Int vs ByteSize carrier) proves the lens
// keys on the resolved type, not the name; the two exempt rows prove it does not
// over-flag (electrical is GATE-2-pending with no carrier; a coordinate is not a
// count). All ExpectPass (the `*_holds` Bool asserts the gate verdict).
data lens_ci_claim_run_row_unit_modeling_flat_scalar_flagged: LensCiClaimRunRow = LensCiClaimRunRow {
  label: "lens_unit_modeling/flat_scalar_unit_leaf_flagged",
  entry: "src/v2/lens/unit_modeling/flat_scalar_unit_leaf_flagged.dag",
  function: "flat_scalar_unit_leaf_flagged_holds"
}

