// Registration witnesses: unit_modeling_lens is wired into always_required_lenses()
// (the roster validate_then_compile runs fail-closed). Paired FAIL/PASS arms prove the
// lens is live in the roster — a fact-bearing flat-scalar unit leaf is rejected with the
// unit-modeling reason (fact_density accepts, so the rejecter is unit_modeling); a modeled
// ByteSize field is admitted.
data lens_ci_claim_run_row_unit_modeling_registration_blocked: LensCiClaimRunRow = LensCiClaimRunRow {
  label: "lens_unit_modeling/unit_modeling_blocked_via_always_required_lenses",
  entry: "src/v2/lens/unit_modeling/unit_modeling_blocked_via_always_required_lenses.dag",
  function: "unit_modeling_blocked_via_always_required_lenses_holds"
}

data lens_ci_claim_run_row_unit_modeling_registration_passes: LensCiClaimRunRow = LensCiClaimRunRow {
  label: "lens_unit_modeling/modeled_unit_field_admitted_via_always_required_lenses",
  entry: "src/v2/lens/unit_modeling/modeled_unit_field_admitted_via_always_required_lenses.dag",
  function: "modeled_unit_field_admitted_via_always_required_lenses_holds"
}

data lens_ci_claim_run_rows: List<LensCiClaimRunRow> = [
  lens_ci_claim_run_row_cost_atom_zero,
  lens_ci_claim_run_row_synthesis_polynomial_dominates_linear,
  lens_ci_claim_run_row_coverage_hollow_type_defect_key,
  lens_ci_claim_run_row_structural_resolution_binds_to_resolved,
  lens_ci_claim_run_row_provenance_occurrence_id_model,
  lens_ci_claim_run_row_provenance_parse_stamp_span_index,
  lens_ci_claim_run_row_complexity_gate_source_bridged_add,
  lens_ci_claim_run_row_complexity_gate_budget_roster_completeness,
  lens_ci_claim_run_row_coproduct_reflection_connective_path3,
  lens_ci_claim_run_row_coproduct_reflection_behavior_path3,
  lens_ci_claim_run_row_coproduct_reflection_connective_pair_path3,
  lens_ci_claim_run_row_coproduct_reflection_behavior_pair_path3,
  lens_ci_claim_run_row_coproduct_reflection_behavior_nullary_inhabitants,
  lens_ci_claim_run_row_coproduct_reflection_connective_nullary_failclosed,
  lens_ci_claim_run_row_coproduct_reflection_distinct_arm_sets,
  lens_ci_claim_run_row_coproduct_reflection_conformance,
  lens_ci_claim_run_row_unit_modeling_flat_scalar_flagged,
  lens_ci_claim_run_row_unit_modeling_modeled_field_passes,
  lens_ci_claim_run_row_unit_modeling_novel_flagged,
  lens_ci_claim_run_row_unit_modeling_label_exempt,
  lens_ci_claim_run_row_unit_modeling_coordinate_exempt,
  lens_ci_claim_run_row_unit_modeling_electrical_blocked,
  lens_ci_claim_run_row_unit_modeling_bitwidth_flagged,
  lens_ci_claim_run_row_unit_modeling_bitwidth_passes,
  lens_ci_claim_run_row_unit_modeling_registration_blocked,
  lens_ci_claim_run_row_unit_modeling_registration_passes
]

// Uniform CI claim-gate transport: one TSV line per row, `label\tentry\tfunction`.
// Consumed by `ci-claim-gate` (tools/ci_claim_gate) via the v2 interpreter — dissolves the
// hand-maintained awk/grep roster projection in the shell gate scripts.
fn lens_ci_claim_run_rows_tsv() -> String {
  fold_list_right(
    xs: lens_ci_claim_run_rows,
    empty: "",
    snoc: fn(acc, row) {
      concat(acc,
        concat(row.label,
          concat("\t",
            concat(row.entry,
              concat("\t",
                concat(row.function, "\n"))))))
    }
  )
}
