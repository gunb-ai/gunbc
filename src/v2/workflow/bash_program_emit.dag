module v2.workflow.bash_program_emit

import extdeps.languages.bash.program { ShellProgram, ShellStmt }
import v2.compiler.emit { emit }
import v2.compiler.infer { InferredFacts, InferredTree }
import v2.extdeps.languages.bash_command_fold {
  bash_fold_stmt_emitted_witness,
  bash_fold_target_model_for_stmt_witness
}
import v2.std.algebra { list_head, list_tail, HeadFound, HeadAbsent, TailFound, TailAbsent }
import v2.std.collection { List, Map }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Some,
  Unavailable,
  bind_outcome,
  node_locus
}
import v2.std.node { Node }
import v2.std.text { String }
import v2.std.witness { Holds, Violates, Witness }

data bash_program_emit_cost_wall_note: String = "Cost wall, measured 2026-07-10: serializing through the whole-tree fold path is superlinear in stmt nesting depth (~1s flat stmt; 64s for the single depth-4 assign_root_stmt; the ~depth-7 witness_bin_program did not finish in 8min). Root: formal_production_unique_lhs_exact_match deep-validates every lhs candidate's whole subtree per level to prove uniqueness, and the descent re-validates each level again (~alternatives^depth, alternatives≈16 for the fold operand). Byte-identity of row-emit vs serialize_bash for Concat/CmdSubst/WithRedir and deep nesting IS proven by execution (depth-2 oracle tests + manual assign_root probe in v2.test.claim.bash_program_fold). Consequence: flipping runtime witness-transport serialization onto this bridge is blocked on either (a) a backward-selection cost fix in v2.std.grammar (shallow one-level discrimination or memoized matching), or (b) the shell-emission-model end state where runtime-present sites become typed argv invocations and stop serializing bash entirely. Immediate successor for THIS module: promote the compositional serializer that already exists test-locally (bash_fold_fold_serialize_stmt + bash_fold_delegated_fold_serialize in v2.test.claim.bash_command_fold) into this bridge - per-construct flat row emits composed by recursion are linear in node count and byte-oracle-proven for WithRedir/Heredoc/Negation/EnvPrefixed/RawLine; word Concat/CmdSubst compose the same way through bash_word_cmdsubst_target_model plus a to-be-added juxtaposition row."

fn bash_program_emit_facts_lookup(key: Node) -> Witness<InferredFacts> {
  Violates {
    diagnostic: Diagnostic {
      reason: ^bash_program_emit_facts_unexpected_consultation,
      at: node_locus(node: key),
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  }
}

fn bash_program_serialize_stmt(stmt: ShellStmt) -> Outcome<String> {
  match bash_fold_stmt_emitted_witness(stmt: stmt) {
    Holds { value: emitted } =>
      match bash_fold_target_model_for_stmt_witness(stmt: stmt) {
        Holds { value: target } =>
          match emit(
            tree: InferredTree {
              root: emitted,
              facts: Map { lookup: bash_program_emit_facts_lookup }
            },
            target: target
          ) {
            Accepted { value: source, diagnostics: d } =>
              match d {
                None => Accepted { value: source.carried, diagnostics: None }
                Some { diagnostics: r } => Rejected { diagnostics: r }
              }
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
          }
        Violates { diagnostic: dd } => Rejected { diagnostics: Some { diagnostics: [dd] } }
      }
    Violates { diagnostic: dd } => Rejected { diagnostics: Some { diagnostics: [dd] } }
  }
}

fn bash_program_serialize_body(stmts: List<ShellStmt>) -> Outcome<String> {
  match list_head(xs: stmts) {
    HeadAbsent => Accepted { value: "", diagnostics: None }
    HeadFound { value: s } =>
      bind_outcome(
        o: bash_program_serialize_stmt(stmt: s),
        f: fn(part) {
          match list_tail(xs: stmts) {
            TailFound { tail: t } =>
              bind_outcome(
                o: bash_program_serialize_body(stmts: t),
                f: fn(rest) {
                  Accepted { value: concat(concat(part, "\n"), rest), diagnostics: None }
                }
              )
            TailAbsent => Accepted { value: concat(part, "\n"), diagnostics: None }
          }
        }
      )
  }
}

fn bash_program_serialize(p: ShellProgram) -> Outcome<String> {
  bind_outcome(
    o: bash_program_serialize_body(stmts: p.statements),
    f: fn(body) {
      if p.set_e {
        Accepted { value: concat("set -e\n", body), diagnostics: None }
      } else {
        Accepted { value: body, diagnostics: None }
      }
    }
  )
}
