module v2.workflow.regen_convergence_transaction

import std.types { Bool, Int, List, String }

// A convergence transaction promotes generated surfaces through buildable seed states. The three axes below are deliberately independent: being compiled into the seed does not make a surface a producer of the next generation, and sharing a crate partition does not prove that a compatibility cut is complete.
type RegenGenerationRole
  = GenerationInput
  | BootstrapSourceMirror
  | GenerationSubject
  | NonSeedGeneratedOutput
  | UnresolvedGenerationRole { reason: String }

type RegenSeedMembership
  = SeedEmbedded
  | OutsideSeed
  | UnresolvedSeedMembership { reason: String }

type RegenSurfaceIdentity {
  declaring_module: String
  projected_path: String
}

type RegenCandidateIdentity {
  producer_generation_id: String
  candidate_tree_id: String
  candidate_tree_digest: String
  surface: RegenSurfaceIdentity
  candidate_digest: String
}

type RegenChangedSurface {
  identity: RegenSurfaceIdentity
  generation_role: RegenGenerationRole
  seed_membership: RegenSeedMembership
  dependency_closure_id: String
  pre_stage_digest: String
  candidate: RegenCandidateIdentity
}

// The affected-set authority answers before stage planning. A whole-population run and a
// narrowed run are distinct admitted inputs; an unlocatable edit is a refusal, never permission
// to widen. The narrowed member list names the maximum population staging may observe.
type RegenAffectedBound
  = CompleteCandidatePopulation
  | AffectedCandidatePopulation { projected_paths: List<String> }
  | AffectedCandidatePopulationRefused { reason: String }

type RegenAffectedBoundAdmission
  = RegenAffectedBoundAdmitted
  | RegenAffectedBoundRefused { refusal: RegenConvergenceRefusal }

type RegenStageKind
  = PromoteGenerationInputs
  | InstallSeedCompatibilityCut
  | PublishNonSeedOutputs

type RegenDeferredReason
  = AwaitingPromotedProducer
  | AwaitingSeedCompatibilityCut
  | AwaitingBuildableSeedGeneration

type RegenDeferredSurface {
  identity: RegenSurfaceIdentity
  reason: RegenDeferredReason
}

type RegenStagePlan {
  ordinal: Int
  kind: RegenStageKind
  producer_generation_id: String
  candidate_tree_id: String
  candidate_tree_digest: String
  planned_surfaces: List<RegenChangedSurface>
  deferred_surfaces: List<RegenDeferredSurface>
  dependency_closure_id: String
  build_target: String
  build_invocation: String
}

type RegenConvergenceRefusal
  = SurfaceOwnershipUnresolved { path: String }
  | SurfaceOwnershipAmbiguous { path: String, modules: List<String> }
  | GenerationRoleUnresolved { surface: RegenSurfaceIdentity, reason: String }
  | SeedMembershipUnresolved { surface: RegenSurfaceIdentity, reason: String }
  | SurfaceInIncompatibleStageRoles { surface: RegenSurfaceIdentity }
  | StageDependencyClosureIncomplete { closure_id: String, missing: List<RegenSurfaceIdentity> }
  | CandidateFromDifferentSeed { candidate: RegenCandidateIdentity, expected_generation_id: String }
  | CandidateStaleAfterProducerRebuild { candidate: RegenCandidateIdentity, current_generation_id: String }
  | PreInstallDigestMismatch { surface: RegenSurfaceIdentity, expected: String, observed: String }
  | InstalledDigestMismatch { surface: RegenSurfaceIdentity, expected: String, observed: String }
  | StagePlannedExecutedMismatch { planned: List<RegenSurfaceIdentity>, executed: List<RegenSurfaceIdentity> }
  | UnplannedPathMutated { path: String }
  | NoBuildableProducerCut { reason: String }
  | StageSeedBuildRefused { ordinal: Int, reason: String }
  | StageOutputExecutableUnbound { ordinal: Int, reason: String }
  | GenerationMadeNoProgress { generation_id: String }
  | GenerationCycleDetected { seed_digest: String, candidate_tree_digest: String }
  | GenerationBoundExceeded { bound: Int }
  | FinalRegenerationStillDrifts { surfaces: List<RegenSurfaceIdentity> }
  | FinalRustConsistencyInstrumentRefused { reason: String }
  | TransactionRestoreRefused { reason: String }
  | AffectedSetBoundRefused { reason: String }
  | AffectedSetStagePopulationDisagrees {
      changed: List<RegenSurfaceIdentity>
      outside_bound: List<RegenSurfaceIdentity>
    }

fn regen_affected_bound_lists(bound: RegenAffectedBound, path: String) -> Bool {
  match bound {
    CompleteCandidatePopulation => true
    AffectedCandidatePopulation { projected_paths: paths } => paths |> any(p => p == path)
    AffectedCandidatePopulationRefused { reason: _ } => false
  }
}

fn regen_admit_affected_bound(
  bound: RegenAffectedBound,
  changed: List<RegenChangedSurface>
) -> RegenAffectedBoundAdmission {
  match bound {
    AffectedCandidatePopulationRefused { reason: reason } =>
      RegenAffectedBoundRefused { refusal: AffectedSetBoundRefused { reason: reason } }
    CompleteCandidatePopulation => RegenAffectedBoundAdmitted
    AffectedCandidatePopulation { projected_paths: paths } => {
      let admitted = AffectedCandidatePopulation { projected_paths: paths }
      let outside = changed
        |> filter(row => !regen_affected_bound_lists(bound: admitted, path: row.identity.projected_path))
        |> map(row => row.identity)
      if count(outside) == 0 {
        RegenAffectedBoundAdmitted
      } else {
        RegenAffectedBoundRefused {
          refusal: AffectedSetStagePopulationDisagrees {
            changed: changed |> map(row => row.identity),
            outside_bound: outside
          }
        }
      }
    }
  }
}

fn regen_affected_bound_admission_label(admission: RegenAffectedBoundAdmission) -> String {
  match admission {
    RegenAffectedBoundAdmitted => "Admitted"
    RegenAffectedBoundRefused { refusal: _ } => "Refused"
  }
}

type RegenStagePlanOutcome
  = RegenStagePlanned { stage: RegenStagePlan }
  | RegenStagePlanningRefused { refusal: RegenConvergenceRefusal }
  | RegenConvergenceTerminal

fn regen_surface_identity_eq(a: RegenSurfaceIdentity, b: RegenSurfaceIdentity) -> Bool {
  a.declaring_module == b.declaring_module && a.projected_path == b.projected_path
}

fn regen_changed_surface_identity(row: RegenChangedSurface) -> RegenSurfaceIdentity {
  row.identity
}

fn regen_deferred(row: RegenChangedSurface, reason: RegenDeferredReason) -> RegenDeferredSurface {
  RegenDeferredSurface { identity: row.identity, reason: reason }
}

fn regen_surface_has_generation_role(row: RegenChangedSurface, kind: RegenStageKind) -> Bool {
  match kind {
    PromoteGenerationInputs => match row.generation_role {
      GenerationInput => true
      BootstrapSourceMirror => true
      GenerationSubject => false
      NonSeedGeneratedOutput => false
      UnresolvedGenerationRole { reason: _ } => false
    }
    InstallSeedCompatibilityCut => match row.generation_role {
      GenerationInput => false
      BootstrapSourceMirror => false
      GenerationSubject => match row.seed_membership {
        SeedEmbedded => true
        OutsideSeed => false
        UnresolvedSeedMembership { reason: _ } => false
      }
      NonSeedGeneratedOutput => false
      UnresolvedGenerationRole { reason: _ } => false
    }
    PublishNonSeedOutputs => match row.seed_membership {
      OutsideSeed => true
      SeedEmbedded => false
      UnresolvedSeedMembership { reason: _ } => false
    }
  }
}

fn regen_first_unresolved(rows: List<RegenChangedSurface>) -> List<RegenConvergenceRefusal> {
  fold(rows, init: [], f: fn(acc, row) {
    if count(acc) > 0 {
      acc
    } else {
      match row.generation_role {
        UnresolvedGenerationRole { reason: reason } =>
          [GenerationRoleUnresolved { surface: row.identity, reason: reason }]
        GenerationInput => match row.seed_membership {
          UnresolvedSeedMembership { reason: reason } =>
            [SeedMembershipUnresolved { surface: row.identity, reason: reason }]
          SeedEmbedded => []
          OutsideSeed => []
        }
        BootstrapSourceMirror => []
        GenerationSubject => match row.seed_membership {
          UnresolvedSeedMembership { reason: reason } =>
            [SeedMembershipUnresolved { surface: row.identity, reason: reason }]
          SeedEmbedded => []
          OutsideSeed => []
        }
        NonSeedGeneratedOutput => []
      }
    }
  })
}

fn regen_stage_deferred_reason(kind: RegenStageKind) -> RegenDeferredReason {
  match kind {
    PromoteGenerationInputs => AwaitingPromotedProducer
    InstallSeedCompatibilityCut => AwaitingSeedCompatibilityCut
    PublishNonSeedOutputs => AwaitingBuildableSeedGeneration
  }
}

fn regen_stage_closure_id(rows: List<RegenChangedSurface>) -> String {
  fold(rows, init: "", f: fn(acc, row) {
    if acc == "" { row.dependency_closure_id } else { acc }
  })
}

fn regen_plan_stage(
  ordinal: Int,
  kind: RegenStageKind,
  producer_generation_id: String,
  candidate_tree_id: String,
  candidate_tree_digest: String,
  changed: List<RegenChangedSurface>,
  build_target: String,
  build_invocation: String
) -> RegenStagePlanOutcome {
  let unresolved = regen_first_unresolved(rows: changed)
  if count(unresolved) > 0 {
    RegenStagePlanningRefused {
      refusal: fold(
        unresolved,
        init: NoBuildableProducerCut { reason: "unreachable empty refusal population" },
        f: fn(acc, row) { row }
      )
    }
  } else {
    let planned = changed |> filter(row => regen_surface_has_generation_role(row: row, kind: kind))
    if count(planned) == 0 {
      RegenConvergenceTerminal
    } else {
      let deferred = changed
        |> filter(row => !regen_surface_has_generation_role(row: row, kind: kind))
        |> map(row => regen_deferred(row: row, reason: regen_stage_deferred_reason(kind: kind)))
      RegenStagePlanned {
        stage: RegenStagePlan {
          ordinal: ordinal,
          kind: kind,
          producer_generation_id: producer_generation_id,
          candidate_tree_id: candidate_tree_id,
          candidate_tree_digest: candidate_tree_digest,
          planned_surfaces: planned,
          deferred_surfaces: deferred,
          dependency_closure_id: regen_stage_closure_id(rows: planned),
          build_target: build_target,
          build_invocation: build_invocation
        }
      }
    }
  }
}

fn regen_plan_next_stage(
  ordinal: Int,
  producer_generation_id: String,
  candidate_tree_id: String,
  candidate_tree_digest: String,
  changed: List<RegenChangedSurface>,
  build_target: String,
  build_invocation: String
) -> RegenStagePlanOutcome {
  let has_producer = changed |> any(row => match row.generation_role {
    GenerationInput => true
    BootstrapSourceMirror => true
    GenerationSubject => false
    NonSeedGeneratedOutput => false
    UnresolvedGenerationRole { reason: _ } => false
  })
  let has_seed_subject = changed |> any(row => match row.generation_role {
    GenerationSubject => match row.seed_membership {
      SeedEmbedded => true
      OutsideSeed => false
      UnresolvedSeedMembership { reason: _ } => false
    }
    GenerationInput => false
    BootstrapSourceMirror => false
    NonSeedGeneratedOutput => false
    UnresolvedGenerationRole { reason: _ } => false
  })
  let kind = if has_producer {
    PromoteGenerationInputs
  } else if has_seed_subject {
    InstallSeedCompatibilityCut
  } else {
    PublishNonSeedOutputs
  }
  regen_plan_stage(
    ordinal: ordinal,
    kind: kind,
    producer_generation_id: producer_generation_id,
    candidate_tree_id: candidate_tree_id,
    candidate_tree_digest: candidate_tree_digest,
    changed: changed,
    build_target: build_target,
    build_invocation: build_invocation
  )
}

fn regen_stage_plan_surface_paths(outcome: RegenStagePlanOutcome) -> List<String> {
  match outcome {
    RegenStagePlanned { stage: stage } => stage.planned_surfaces |> map(row => row.identity.projected_path)
    RegenStagePlanningRefused { refusal: _ } => []
    RegenConvergenceTerminal => []
  }
}

fn regen_stage_plan_kind_label(outcome: RegenStagePlanOutcome) -> String {
  match outcome {
    RegenStagePlanned { stage: stage } => match stage.kind {
      PromoteGenerationInputs => "PromoteGenerationInputs"
      InstallSeedCompatibilityCut => "InstallSeedCompatibilityCut"
      PublishNonSeedOutputs => "PublishNonSeedOutputs"
    }
    RegenStagePlanningRefused { refusal: _ } => "Refused"
    RegenConvergenceTerminal => "Terminal"
  }
}

type RegenSurfaceExecutionReceipt {
  identity: RegenSurfaceIdentity
  pre_stage_digest: String
  candidate_digest: String
  installed_digest: String
  planned: Bool
  executed: Bool
  terminal: Bool
  passed: Bool
}

type RegenStageBuildTerminal
  = RegenStageBuildPassed
  | RegenStageBuildFailed { reason: String }

type RegenStageReceipt {
  receipt_id: String
  ordinal: Int
  kind: RegenStageKind
  input_seed_digest: String
  input_candidate_tree_id: String
  input_candidate_tree_digest: String
  producer_generation_id: String
  surfaces: List<RegenSurfaceExecutionReceipt>
  deferred_surfaces: List<RegenDeferredSurface>
  dependency_closure_id: String
  build_target: String
  build_invocation: String
  build_terminal: RegenStageBuildTerminal
  output_seed_digest: String
  next_generation_receipt_id: String
}

type RegenFixedPointVerdict
  = RegenFixedPointReached
  | RegenFixedPointRefused { refusal: RegenConvergenceRefusal }

type RegenConvergenceTransactionReceipt {
  schema_version: String
  starting_commit: String
  source_authority_digest: String
  starting_generated_surface_digest: String
  stage_plan_authority_digest: String
  generation_role_authority_digest: String
  ownership_authority_digest: String
  initial_seed_digest: String
  ordered_stage_receipt_ids: List<String>
  terminal_seed_digest: String
  terminal_surface_digest: String
  fixed_point: RegenFixedPointVerdict
}

fn regen_stage_receipt_all_passed(receipt: RegenStageReceipt) -> Bool {
  receipt.surfaces |> all(row => row.planned && row.executed && row.terminal && row.passed)
}

type RegenStageExecutionObservation {
  planned: List<RegenSurfaceIdentity>
  executed: List<RegenSurfaceIdentity>
  input_generation_id: String
  observed_candidate_generation_id: String
  expected_candidate_digest: String
  observed_candidate_digest: String
  build_terminal: RegenStageBuildTerminal
}

type RegenStageExecutionAdmission
  = RegenStageExecutionAdmitted
  | RegenStageExecutionRefused { refusal: RegenConvergenceRefusal }

fn regen_identity_population_eq(a: List<RegenSurfaceIdentity>, b: List<RegenSurfaceIdentity>) -> Bool {
  count(a) == count(b)
    && a |> all(left => b |> any(right => regen_surface_identity_eq(a: left, b: right)))
    && b |> all(right => a |> any(left => regen_surface_identity_eq(a: left, b: right)))
}

fn regen_admit_stage_execution(observation: RegenStageExecutionObservation) -> RegenStageExecutionAdmission {
  if !regen_identity_population_eq(a: observation.planned, b: observation.executed) {
    RegenStageExecutionRefused {
      refusal: StagePlannedExecutedMismatch {
        planned: observation.planned,
        executed: observation.executed
      }
    }
  } else if observation.input_generation_id != observation.observed_candidate_generation_id {
    RegenStageExecutionRefused {
      refusal: CandidateStaleAfterProducerRebuild {
        candidate: RegenCandidateIdentity {
          producer_generation_id: observation.observed_candidate_generation_id,
          candidate_tree_id: "observed",
          candidate_tree_digest: observation.observed_candidate_digest,
          surface: fold(
            observation.planned,
            init: RegenSurfaceIdentity { declaring_module: "empty", projected_path: "empty" },
            f: fn(acc, row) { row }
          ),
          candidate_digest: observation.observed_candidate_digest
        },
        current_generation_id: observation.input_generation_id
      }
    }
  } else if observation.expected_candidate_digest != observation.observed_candidate_digest {
    RegenStageExecutionRefused {
      refusal: InstalledDigestMismatch {
        surface: fold(
          observation.planned,
          init: RegenSurfaceIdentity { declaring_module: "empty", projected_path: "empty" },
          f: fn(acc, row) { row }
        ),
        expected: observation.expected_candidate_digest,
        observed: observation.observed_candidate_digest
      }
    }
  } else {
    match observation.build_terminal {
      RegenStageBuildPassed => RegenStageExecutionAdmitted
      RegenStageBuildFailed { reason: reason } => RegenStageExecutionRefused {
        refusal: StageSeedBuildRefused { ordinal: 0, reason: reason }
      }
    }
  }
}

type RegenConvergenceFixture {
  g0_changed: List<RegenChangedSurface>
  producer_stage_build: RegenStageBuildTerminal
  g1_changed: List<RegenChangedSurface>
  subject_stage_build: RegenStageBuildTerminal
  g2_changed: List<RegenChangedSurface>
}

type RegenConvergenceFixtureOutcome
  = RegenFixtureReachedFixedPoint { stage_kinds: List<RegenStageKind> }
  | RegenFixtureRefused { refusal: RegenConvergenceRefusal }

type RegenGenerationProgressAdmission
  = RegenGenerationProgressAdmitted
  | RegenGenerationProgressRefused { refusal: RegenConvergenceRefusal }

fn regen_admit_generation_progress(
  seen_state_keys: List<String>,
  seed_digest: String,
  candidate_tree_digest: String,
  ordinal: Int,
  bound: Int
) -> RegenGenerationProgressAdmission {
  let key = concat(seed_digest, concat(":", candidate_tree_digest))
  if ordinal >= bound {
    RegenGenerationProgressRefused { refusal: GenerationBoundExceeded { bound: bound } }
  } else if seen_state_keys |> any(seen => seen == key) {
    RegenGenerationProgressRefused {
      refusal: GenerationCycleDetected {
        seed_digest: seed_digest,
        candidate_tree_digest: candidate_tree_digest
      }
    }
  } else {
    RegenGenerationProgressAdmitted
  }
}

fn regen_fixture_build_refusal(ordinal: Int, terminal: RegenStageBuildTerminal) -> List<RegenConvergenceRefusal> {
  match terminal {
    RegenStageBuildPassed => []
    RegenStageBuildFailed { reason: reason } => [StageSeedBuildRefused { ordinal: ordinal, reason: reason }]
  }
}

// The executable fixture producer follows the same P -> rebuilt generation -> S -> rebuilt
// generation ordering as the host. It is deliberately generic: the fixture supplies identities,
// roles and build terminals, never repository paths or Measure-specific knowledge.
fn regen_execute_convergence_fixture(fixture: RegenConvergenceFixture) -> RegenConvergenceFixtureOutcome {
  let p = regen_plan_next_stage(
    ordinal: 1,
    producer_generation_id: "g0",
    candidate_tree_id: "tree-g0",
    candidate_tree_digest: "digest-g0",
    changed: fixture.g0_changed,
    build_target: "fixture-seed",
    build_invocation: "fixture-build"
  )
  match p {
    RegenStagePlanningRefused { refusal: refusal } => RegenFixtureRefused { refusal: refusal }
    RegenConvergenceTerminal => RegenFixtureReachedFixedPoint { stage_kinds: [] }
    RegenStagePlanned { stage: producer } => {
      let p_failures = regen_fixture_build_refusal(ordinal: 1, terminal: fixture.producer_stage_build)
      if count(p_failures) > 0 {
        RegenFixtureRefused {
          refusal: fold(p_failures, init: NoBuildableProducerCut { reason: "unreachable" }, f: fn(acc, row) { row })
        }
      } else {
        let s = regen_plan_next_stage(
          ordinal: 2,
          producer_generation_id: "g1",
          candidate_tree_id: "tree-g1",
          candidate_tree_digest: "digest-g1",
          changed: fixture.g1_changed,
          build_target: "fixture-seed",
          build_invocation: "fixture-build"
        )
        match s {
          RegenStagePlanningRefused { refusal: refusal } => RegenFixtureRefused { refusal: refusal }
          RegenConvergenceTerminal => RegenFixtureReachedFixedPoint { stage_kinds: [producer.kind] }
          RegenStagePlanned { stage: subject } => {
            let s_failures = regen_fixture_build_refusal(ordinal: 2, terminal: fixture.subject_stage_build)
            if count(s_failures) > 0 {
              RegenFixtureRefused {
                refusal: fold(s_failures, init: NoBuildableProducerCut { reason: "unreachable" }, f: fn(acc, row) { row })
              }
            } else if count(fixture.g2_changed) > 0 {
              RegenFixtureRefused {
                refusal: FinalRegenerationStillDrifts {
                  surfaces: fixture.g2_changed |> map(row => row.identity)
                }
              }
            } else {
              RegenFixtureReachedFixedPoint { stage_kinds: [producer.kind, subject.kind] }
            }
          }
        }
      }
    }
  }
}
