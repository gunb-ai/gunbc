// RULING-B ROSTER IMPORT SWEEP (#14003 / #14017), computed from the PARSED program, not from text.
//
// A bare free call to a collection kernel head binds natively only when its shape is import-visible
// from std.algebra. This module reads each file the way the compiler does (tokenize, parse, normalize),
// takes the file's own reference sites with their lexical head classification, and computes the
// std.algebra import as a VALUE: the names its existing import declaration binds, plus the shape each
// lexically-unbound roster head needs, deduplicated by Symbol identity. The import declaration is then
// rendered from that value and addressed by its parsed source extent, so a malformed block has no
// construction (the c.dag:866 defect was a spliced block, #14017). Output is rows, never writes:
//   EDIT <path> <start> <end> <replacement>     replacement has newlines escaped as \n
//   REFUSE <path> <cause>
// roster_import_sweep_apply_exit is the committed apply step (stale-read check under an apply lock, then Filesystem.Write).
// This module IS the row-driven wave generator of the NAMESPACE-XL sweeps: roster_head_rows is its row table, the
// HOME TABLE rows are added there as data, and no control flow changes when a row is added. Its controls are the
// gunbc test //gunbc/instruments:roster-import-sweep-controls instrument. Driven as
//   gunbc run --source-root dag --source-root src/v2 --entry src/v2/workflow/roster_import_sweep.dag
//     --function roster_import_sweep_for_paths --arg paths_csv=<comma-separated paths>
// and applied with roster_import_sweep_apply_exit --arg root_dir=<absolute worktree root> --arg paths_csv=<paths relative to the root>
//
// Pending rows leave the process through roster_import_sweep_exit's reason channel.
// SCOPE: the ruling-B shapes only (concat/count/map/join). map_get -> map_lookup is NOT swept: map_lookup is not a drop-in for
// map_get under the seed (dag/std/graph.dag stops resolving: match arms typed String vs List<String>), so the
// rename is a Map-home question held for the operator's table, with the collection-op signatures. Homes for
// chars, List, list_push or Map wait for the operator's home table; the table below is the single
// place a row would be added.

// ONE ROW PER AMBIENT NAME: the bare call spelling, the name the import binds, and the name's ONE declared home module.
// The generator is home-agnostic; a wave is a row here (NAMESPACE-XL), never a branch.
type RosterHeadRow {
  call: String
  import_name: String
  home: QualifiedName
  labels: List<RosterLabelRename>
}

// THE ARGUMENT LABELS A ROW'S HOME RENAMES at its call sites: a field of the row, so the call and the home a rename belongs
// to are the row's own facts, stated once (review 82024).
type RosterLabelRename {
  from: String
  to: String
}

// WHICH HOMES ONE RUN MAY TOUCH. A wave moves one name, so its run is OneHome; AllHomes is the generator's whole table.
// A closed sum, so "every home" is not an in-band spelling a typo could collide with (review 82002).
type RosterHomeScope
  = AllHomes
  | OneHome { home: QualifiedName }

fn roster_scope_admits(scope: RosterHomeScope, home: QualifiedName) -> Bool {
  match scope {
    AllHomes => true
    OneHome { home: h } => roster_qn_text(qn: h) == roster_qn_text(qn: home)
  }
}

fn roster_qn_text(qn: QualifiedName) -> String {
  roster_join(xs: list_map(xs: qn, f: fn(s) { symbol_lexeme(sym: s) }), sep: ".")
}

// THE CLOSED SET OF REFUSAL REASONS of this module; every REFUSE row is rendered from one by roster_refusal_text,
// the sole place a reason becomes protocol text. Admission is Optional (Absent = admitted), never a member of this set.
type RosterRefusalReason
  = RefusalTokenizeRefused
  | RefusalParseRefused
  | RefusalNormalizeRefused
  | RefusalShapeNameBoundElsewhere
  | RefusalNoImportAnchor
  | RefusalExtentNotOnCharBoundary
  | RefusalExtentMismatch
  | RefusalExtentHasAnnotation
  | RefusalRootNotAbsoluteCanonical
  | RefusalRootNotGitToplevel
  | RefusalApplyLockUnavailable
  | RefusalApplyLockNotReleased
  | RefusalLockWriteFailed
  | RefusalGenerationHistoryUnestablished
  | RefusalPathOutsideRoot
  | RefusalLockNotHeld
  | RefusalTargetNotTrackedRegular
  | RefusalTargetIndexFlagged
  | RefusalTargetModified
  | RefusalTargetAncestorChanged
  | RefusalGitUnobservable
  | RefusalStaleRead
  | RefusalWriteFailed
  | RefusalUnreadable
  | RefusalGrammarUnprepared
  | RefusalLabelSitesAmbiguous
  | RefusalHomeNameLocallyBound

fn roster_refusal_text(reason: RosterRefusalReason) -> String {
  match reason {
    RefusalTokenizeRefused => "tokenize-refused"
    RefusalParseRefused => "parse-refused"
    RefusalNormalizeRefused => "normalize-refused"
    RefusalShapeNameBoundElsewhere => "shape-name-bound-elsewhere"
    RefusalNoImportAnchor => "no-import-anchor"
    RefusalExtentNotOnCharBoundary => "extent-not-on-char-boundary"
    RefusalExtentMismatch => "extent-mismatch"
    RefusalExtentHasAnnotation => "extent-has-annotation"
    RefusalRootNotAbsoluteCanonical => "root-not-absolute-canonical"
    RefusalRootNotGitToplevel => "root-not-git-toplevel"
    RefusalApplyLockUnavailable => "apply-lock-unavailable"
    RefusalApplyLockNotReleased => "apply-lock-not-released"
    RefusalLockWriteFailed => "lock-write-failed"
    RefusalGenerationHistoryUnestablished => "generation-history-unestablished"
    RefusalPathOutsideRoot => "path-outside-root"
    RefusalLockNotHeld => "lock-not-held"
    RefusalTargetNotTrackedRegular => "target-not-tracked-regular"
    RefusalTargetIndexFlagged => "target-index-flagged"
    RefusalTargetModified => "target-modified"
    RefusalTargetAncestorChanged => "target-ancestor-changed"
    RefusalGitUnobservable => "git-unobservable"
    RefusalStaleRead => "stale-read"
    RefusalWriteFailed => "write-failed"
    RefusalUnreadable => "unreadable"
    RefusalGrammarUnprepared => "grammar-unprepared"
    RefusalLabelSitesAmbiguous => "label-sites-ambiguous"
    RefusalHomeNameLocallyBound => "home-name-locally-bound"
  }
}

fn roster_refuse_row(path: String, reason: RosterRefusalReason) -> String {
  "REFUSE " + path + " " + roster_refusal_text(reason: reason) + "\n"
}

type RosterOutcome
  = RosterClean
  | RosterEdit { start: Int, end: Int, text: String, own_line: Bool }
  | RosterLabelEdits { edits: List<RosterLabelEdit> }
  | RosterEditWithLabels { start: Int, end: Int, text: String, own_line: Bool, labels: List<RosterLabelEdit> }
  | RosterRefused { reason: RosterRefusalReason }

// AN ARGUMENT-LABEL RENAME, its own edit kind (tidy-ant-251's wave-1 ruling): a call to a row's home declaration
// whose authored label is the old parameter name gets the home's parameter name. One edit replaces exactly one label
// token; the apply re-checks that the bytes at the extent are still `from`.
type RosterLabelEdit {
  start: Int
  end: Int
  from: String
  to: String
}

fn roster_head_rows() -> List<RosterHeadRow> {
  [
    RosterHeadRow { call: "concat", import_name: "collection_concat_shape", home: qualified_name_from_dotted_string(dotted: "std.algebra"), labels: [] },
    RosterHeadRow { call: "count", import_name: "collection_count_shape", home: qualified_name_from_dotted_string(dotted: "std.algebra"), labels: [] },
    RosterHeadRow { call: "map", import_name: "collection_map_shape", home: qualified_name_from_dotted_string(dotted: "std.algebra"), labels: [] },
    RosterHeadRow { call: "join", import_name: "collection_join_shape", home: qualified_name_from_dotted_string(dotted: "std.algebra"), labels: [] },
    // NAMESPACE-XL wave 1 (tidy-ant-251's H2/H4 rulings, #14233): chars has one declared home.
    RosterHeadRow {
      call: "chars",
      import_name: "chars",
      home: qualified_name_from_dotted_string(dotted: "std.host_text"),
      // std.host_text declares fn chars(text: HostText); the ambient spelling's callers wrote s:.
      labels: [RosterLabelRename { from: "s", to: "text" }]
    },
    RosterHeadRow { call: "List", import_name: "List", home: qualified_name_from_dotted_string(dotted: "std.types"), labels: [] },
    RosterHeadRow { call: "Map", import_name: "Map", home: qualified_name_from_dotted_string(dotted: "std.types"), labels: [] },
    RosterHeadRow { call: "Set", import_name: "Set", home: qualified_name_from_dotted_string(dotted: "std.types"), labels: [] }
  ]
}

// THE VERDICT IS CONVERGENCE: no pending rows is ExitSuccess (the post-apply re-run), pending rows
// are an ExitFailure whose reason IS the rows, so a refused or unconverged sweep cannot read as done.
fn roster_import_sweep_exit(paths_csv: String) -> ProcessExit {
  let rows = roster_import_sweep_for_paths(paths_csv: paths_csv)
  if (rows == "") { ExitSuccess } else { exit_failure(reason: rows) }
}

// ONE WAVE'S ROWS: the same generator restricted to the rows whose home is `home` (a NAMESPACE-XL wave moves one name;
// a file's pending rows for other homes are another wave's and are neither emitted nor applied here). The dotted argument is
// read into a QualifiedName at this boundary, once.
fn roster_import_sweep_home_exit(paths_csv: String, home: String) -> ProcessExit {
  let scope = OneHome { home: qualified_name_from_dotted_string(dotted: home) }
  let rows = match dag_prepared_grammar() {
    Rejected { diagnostics: _ } => roster_refuse_row(path: "*", reason: RefusalGrammarUnprepared)
    Accepted { value: prepared, diagnostics: _ } => roster_sweep_all(paths_csv: paths_csv, prepared: prepared, lex: dag_prepared_lex(), scope: scope)
  }
  if (rows == "") { ExitSuccess } else { exit_failure(reason: rows) }
}

fn roster_import_sweep_apply_home_exit(root_dir: String, paths_csv: String, home: String) -> ProcessExit {
  let report = roster_apply_for_paths(root_dir: root_dir, paths_csv: paths_csv, scope: OneHome { home: qualified_name_from_dotted_string(dotted: home) })
  if (report == "") { ExitSuccess } else { exit_failure(reason: report) }
}

fn roster_rows_for_scope(scope: RosterHomeScope) -> List<RosterHeadRow> {
  fold_list(xs: roster_head_rows(), empty: [], cons: fn(acc, r) { if roster_scope_admits(scope: scope, home: r.home) { list_snoc_item(xs: acc, item: r) } else { acc } })
}

// The grammar and lex rules are prepared ONCE per run and passed down: preparing them per file
// re-derived the same compiled ground for every path (the cost that made an 83-file run take 25+ minutes).
fn roster_import_sweep_for_paths(paths_csv: String) -> String {
  match dag_prepared_grammar() {
    Rejected { diagnostics: _ } => roster_refuse_row(path: "*", reason: RefusalGrammarUnprepared)
    Accepted { value: prepared, diagnostics: _ } =>
      roster_sweep_all(paths_csv: paths_csv, prepared: prepared, lex: dag_prepared_lex(), scope: AllHomes)
  }
}

fn roster_sweep_all(paths_csv: String, prepared: PreparedGrammar, lex: PreparedLexRules, scope: RosterHomeScope) -> String {
  fold_list(
    xs: split(s: paths_csv, delimiter: ","),
    empty: "",
    cons: fn(acc, path) { acc + roster_sweep_path(path: path, prepared: prepared, lex: lex, scope: scope) }
  )
}

fn roster_sweep_path(path: String, prepared: PreparedGrammar, lex: PreparedLexRules, scope: RosterHomeScope) -> String {
  let read = Filesystem.Read(path: path)
  if read.success {
    roster_render_outcome(path: path, outcome: roster_sweep_text_scoped(path: path, text: read.content, prepared: prepared, lex: lex, scope: scope))
  } else {
    roster_refuse_row(path: path, reason: RefusalUnreadable)
  }
}

// THE APPLY STEP, in the same entry family as the generator: the file is read, the outcome computed,
// the file re-read and required byte-identical to what the outcome was computed from (a stale-read check; the apply
// holds an exclusive create-new lock file for its whole run, so two appliers cannot interleave, but a writer that is
// not this applier and writes between the re-read and the write is outside the contract: the worktree must be
// exclusively owned for the run, std.durable_compare_and_set being a generation-slot store that cannot reach a source file),
// the extent required to hold what the parsed decl said it holds, and only then written with
// Filesystem.Write. Anything else is a REFUSE row and the file is untouched. Success is silent, so the
// exit reason is exactly the refusals.
fn roster_import_sweep_apply_exit(root_dir: String, paths_csv: String) -> ProcessExit {
  let report = roster_apply_for_paths(root_dir: root_dir, paths_csv: paths_csv, scope: AllHomes)
  if (report == "") { ExitSuccess } else { exit_failure(reason: report) }
}

// THE LOCK IDENTITY is derived from the worktree root the caller names (an absolute path with no `.`, `..` or empty
// segment), never from the working directory: two invocations from different directories on the same root contend for
// the same file. Every target is a relative path confined under that root (no leading `/`, no `.`, `..` or empty segment);
// a target that is not is refused before any read. The effectful steps take a RosterHeldLock, whose only constructor is
// roster_lock_acquire, and roster_apply_edit re-checks that the lock file still exists before it writes, so an entry
// that never acquired the lock refuses `lock-not-held` and writes nothing. The root and every target are then checked
// against git itself (roster_root_is_toplevel, roster_target_refusal), which also covers symlinks.
// WHY NOT std.durable_exclusive_hold / std.temporal_effect::HeldLease (DESIGN §3b leasing home): durable_hold_*_assess
// and held_lease are pure assessments over a caller-supplied observation; none of them takes or releases anything, and no
// durable store for a source tree exists to observe. Using them first needs that store plus holder-liveness reporting,
// which is more machinery than the apply they would guard. The cost of the lock file is a stuck lock after a killed run:
// loud (every later apply refuses `apply-lock-unavailable` naming the root, writing nothing) and cleared by the root's
// single owner deleting `<root>/.roster_import_sweep.lock`. Expiry and stale-holder recovery are not built.
// TRIGGER to move onto the hold home: the first apply run by more than one writer or unattended (CI), when the
// durable-hold store and liveness report exist.
type RosterHeldLock sole_constructor {
  root: String
  nonce: String
}

type RosterLockAcquisition
  = RosterLockAcquired { held: RosterHeldLock }
  | RosterLockRefused { reason: RosterRefusalReason }

fn roster_segments_admitted(segments: List<String>) -> Bool {
  fold_list(xs: segments, empty: true, cons: fn(ok, seg) { ok && seg != "" && seg != "." && seg != ".." })
}

fn roster_root_admitted(root_dir: String) -> Bool {
  match split(s: root_dir, delimiter: "/") {
    Cons { head: first, tail: rest } => first == "" && !is_empty(xs: rest) && roster_segments_admitted(segments: rest)
    Empty => false
  }
}

fn roster_path_admitted(path: String) -> Bool {
  roster_segments_admitted(segments: split(s: path, delimiter: "/"))
}

fn roster_lock_file(root: String) -> String {
  root + "/.roster_import_sweep.lock"
}

fn roster_generation_file(root: String) -> String {
  root + "/.roster_import_sweep.generation"
}

fn roster_lock_body(nonce: String) -> String {
  "roster_import_sweep_apply nonce=" + nonce + "\n"
}

// THE ROOT IS WHAT GIT SAYS IT IS. `git rev-parse --show-toplevel` (git.Inspect.Toplevel, the declared git tool) answers the
// real toplevel of the working directory, symlinks resolved; the root must equal it, so a symlinked or subdirectory
// spelling of the same worktree is refused and one worktree has one lock identity. Toplevel takes no input: the
// observation is of the CLI's working directory, which is why the target checks below also require the root to be it.
fn roster_root_is_toplevel(root_dir: String) -> Bool {
  let top = git.Inspect.Toplevel().path as String
  top == root_dir
}

// A TARGET IS WRITTEN ONLY IF GIT TRACKS IT AS A REGULAR UNMODIFIED FILE. `git ls-tree HEAD -- <path>` names the entry's mode
// (100644 regular; 120000 a symlink; nothing for an untracked path or one behind a symlinked directory, which git does not
// track through), and `git status --porcelain` must not name the path (unmodified, so the sweep never lands on someone's
// uncommitted work). Both are git's own observation; nothing here resolves a path itself. Returns Absent when admitted, else the reason.
fn roster_target_refusal(root: String, path: String) -> Optional<RosterRefusalReason> {
  if !roster_root_is_toplevel(root_dir: root) {
    Present { value: RefusalRootNotGitToplevel }
  } else {
    let tree = git.Inspect.ListTreeEntryAtPath(ref: "HEAD" as GitRef, path: path)
    let status = git.Inspect.WorkingTreeStatus(repository_path: root)
    let flags = git.Inspect.IndexFlagsIn(repository_path: root, path: path)
    if !tree.success || !status.success || !flags.success {
      Present { value: RefusalGitUnobservable }
    } else if string_length(s: tree.entries_nul) < 12 || substring(s: tree.entries_nul, start: 0, end: 12) != "100644 blob " {
      Present { value: RefusalTargetNotTrackedRegular }
    } else if flags.entries_nul != "H " + path + "\u{0}" {
      Present { value: RefusalTargetIndexFlagged }
    } else if roster_status_names_path(entries_nul: status.entries_nul, path: path) {
      Present { value: RefusalTargetModified }
    } else if roster_status_names_ancestor(entries_nul: status.entries_nul, path: path) {
      Present { value: RefusalTargetAncestorChanged }
    } else {
      Absent
    }
  }
}

fn roster_ends_with_space_path(field: String, path: String) -> Bool {
  let n = string_length(s: field)
  let m = string_length(s: path)
  n > m && substring(s: field, start: n - m - 1, end: n) == " " + path
}

// ANY status entry naming a directory above the target (`?? src` for a replaced directory, a typechange, a deletion) refuses the
// target: the committed tree says nothing about what the worktree path now resolves through.
fn roster_status_names_ancestor(entries_nul: String, path: String) -> Bool {
  fold_list(xs: split(s: entries_nul, delimiter: "\u{0}"), empty: false, cons: fn(hit, f) { hit || roster_names_ancestor(candidate: f, path: path) || (string_length(s: f) > 3 && substring(s: f, start: 2, end: 3) == " " && roster_names_ancestor(candidate: substring(s: f, start: 3, end: string_length(s: f)), path: path)) })
}

fn roster_names_ancestor(candidate: String, path: String) -> Bool {
  let dir = if string_length(s: candidate) > 0 && substring(s: candidate, start: string_length(s: candidate) - 1, end: string_length(s: candidate)) == "/" { candidate } else { candidate + "/" }
  string_length(s: candidate) > 0 && string_length(s: path) > string_length(s: dir) && substring(s: path, start: 0, end: string_length(s: dir)) == dir
}

// porcelain v1 -z fields are "XY path", and a rename source is the bare path: either spelling names the path.
fn roster_status_names_path(entries_nul: String, path: String) -> Bool {
  fold_list(xs: split(s: entries_nul, delimiter: "\u{0}"), empty: false, cons: fn(hit, f) { hit || f == path || roster_ends_with_space_path(field: f, path: path) })
}

// The generation history is either established or it is not: an ABSENT file is the first use of this root; any other read
// failure leaves the history unestablished, and acquisition refuses rather than restarting the count (which would let an
// old token's nonce match again).
type RosterGenerationHistory
  = RosterHistoryKnown { content: String }
  | RosterHistoryUnestablished

fn roster_generation_history(success: Bool, content: String, error_kind: String) -> RosterGenerationHistory {
  if success {
    RosterHistoryKnown { content: content }
  } else if error_kind == "not_found" {
    RosterHistoryKnown { content: "" }
  } else {
    RosterHistoryUnestablished
  }
}

// ONE NONCE PER ACQUISITION. The generation file is written only while the lock is held, one more character per
// acquisition, so the nonce is the count of acquisitions on this root and a token from an earlier holder never equals
// the current lock's nonce. (Neither lock file nor generation file is tracked; both are scratch beside the tree.)
fn roster_lock_acquire(root_dir: String) -> RosterLockAcquisition {
  if !roster_root_admitted(root_dir: root_dir) {
    RosterLockRefused { reason: RefusalRootNotAbsoluteCanonical }
  } else if !roster_root_is_toplevel(root_dir: root_dir) {
    RosterLockRefused { reason: RefusalRootNotGitToplevel }
  } else {
    roster_lock_take(root_dir: root_dir)
  }
}

// The lock-file mechanics alone, with no claim about the root: acquire is the only caller that admits a root; the controls
// call this on a scratch directory that is not a git toplevel.
fn roster_lock_take(root_dir: String) -> RosterLockAcquisition {
  if !Filesystem.WriteCreateNew(path: roster_lock_file(root: root_dir), content: "roster_import_sweep_apply pending\n").success {
    RosterLockRefused { reason: RefusalApplyLockUnavailable }
  } else {
    let prior = Filesystem.Read(path: roster_generation_file(root: root_dir))
    match roster_generation_history(success: prior.success, content: prior.content, error_kind: prior.error_kind) {
      RosterHistoryUnestablished => {
        let undone = Filesystem.Delete(path: roster_lock_file(root: root_dir))
        RosterLockRefused { reason: RefusalGenerationHistoryUnestablished }
      }
      RosterHistoryKnown { content: before } => {
        let nonce = int_to_decimal_string(value: string_length(s: before) + 1)
        if Filesystem.Write(path: roster_generation_file(root: root_dir), content: before + "x").success && Filesystem.Write(path: roster_lock_file(root: root_dir), content: roster_lock_body(nonce: nonce)).success {
          RosterLockAcquired { held: RosterHeldLock { root: root_dir, nonce: nonce } }
        } else {
          let undone = Filesystem.Delete(path: roster_lock_file(root: root_dir))
          RosterLockRefused { reason: RefusalLockWriteFailed }
        }
      }
    }
  }
}

fn roster_lock_still_held(held: RosterHeldLock) -> Bool {
  let now = Filesystem.Read(path: roster_lock_file(root: held.root))
  now.success && now.content == roster_lock_body(nonce: held.nonce)
}

// Release only what this acquisition owns: a token whose nonce no longer matches the lock file deletes nothing.
fn roster_lock_release(held: RosterHeldLock) -> Bool {
  roster_lock_still_held(held: held) && Filesystem.Delete(path: roster_lock_file(root: held.root)).success
}

fn roster_apply_for_paths(root_dir: String, paths_csv: String, scope: RosterHomeScope) -> String {
  match roster_lock_acquire(root_dir: root_dir) {
    RosterLockRefused { reason: reason } => roster_refuse_row(path: "*", reason: reason)
    RosterLockAcquired { held: held } => {
      let report = roster_apply_locked(held: held, paths_csv: paths_csv, scope: scope)
      if roster_lock_release(held: held) { report } else { report + roster_refuse_row(path: "*", reason: RefusalApplyLockNotReleased) }
    }
  }
}

fn roster_apply_locked(held: RosterHeldLock, paths_csv: String, scope: RosterHomeScope) -> String {
  match dag_prepared_grammar() {
    Rejected { diagnostics: _ } => roster_refuse_row(path: "*", reason: RefusalGrammarUnprepared)
    Accepted { value: prepared, diagnostics: _ } =>
      fold_list(
        xs: split(s: paths_csv, delimiter: ","),
        empty: "",
        cons: fn(acc, path) { acc + roster_apply_path(held: held, path: path, prepared: prepared, lex: dag_prepared_lex(), scope: scope) }
      )
  }
}

fn roster_apply_path(held: RosterHeldLock, path: String, prepared: PreparedGrammar, lex: PreparedLexRules, scope: RosterHomeScope) -> String {
  if !roster_path_admitted(path: path) {
    roster_refuse_row(path: path, reason: RefusalPathOutsideRoot)
  } else {
    let read = Filesystem.Read(path: held.root + "/" + path)
    if read.success {
      match roster_sweep_text_scoped(path: path, text: read.content, prepared: prepared, lex: lex, scope: scope) {
        RosterClean => ""
        RosterRefused { reason: reason } => roster_refuse_row(path: path, reason: reason)
        RosterEdit { start: start, end: end, text: text, own_line: own_line } =>
          roster_apply_edit(held: held, path: path, before: read.content, outcome: RosterEdit { start: start, end: end, text: text, own_line: own_line })
        RosterLabelEdits { edits: edits } =>
          roster_apply_edit(held: held, path: path, before: read.content, outcome: RosterLabelEdits { edits: edits })
        RosterEditWithLabels { start: st, end: en, text: tx, own_line: ol, labels: ls } =>
          roster_apply_edit(held: held, path: path, before: read.content, outcome: RosterEditWithLabels { start: st, end: en, text: tx, own_line: ol, labels: ls })
      }
    } else {
      roster_refuse_row(path: path, reason: RefusalUnreadable)
    }
  }
}

fn roster_apply_edit(held: RosterHeldLock, path: String, before: String, outcome: RosterOutcome) -> String {
  if !roster_path_admitted(path: path) {
    roster_refuse_row(path: path, reason: RefusalPathOutsideRoot)
  } else if !roster_lock_still_held(held: held) {
    roster_refuse_row(path: path, reason: RefusalLockNotHeld)
  } else {
    match roster_target_refusal(root: held.root, path: path) {
      Present { value: refusal } => roster_refuse_row(path: path, reason: refusal)
      Absent =>
        if !roster_target_unchanged(root: held.root, path: path, before: before) {
          roster_refuse_row(path: path, reason: RefusalStaleRead)
        } else {
          match roster_applied(before: before, outcome: outcome) {
            RosterApplyRefused { reason: reason } => roster_refuse_row(path: path, reason: reason)
            RosterApplyWritten { content: content } =>
              if content == before {
                ""
              } else if Filesystem.Write(path: held.root + "/" + path, content: content).success {
                ""
              } else {
                roster_refuse_row(path: path, reason: RefusalWriteFailed)
              }
          }
        }
    }
  }
}

fn roster_target_unchanged(root: String, path: String, before: String) -> Bool {
  let now = Filesystem.Read(path: root + "/" + path)
  now.success && now.content == before
}

type RosterApplied
  = RosterApplyWritten { content: String }
  | RosterApplyRefused { reason: RosterRefusalReason }

// THE PURE SPLICE the apply step performs, separate from its filesystem effects so the controls run it on text.
fn roster_applied(before: String, outcome: RosterOutcome) -> RosterApplied {
  match outcome {
    RosterClean => RosterApplyWritten { content: before }
    RosterRefused { reason: reason } => RosterApplyRefused { reason: reason }
    RosterEdit { start: start, end: end, text: text, own_line: own_line } =>
      roster_splice(before: before, start: start, end: end, replacement: (if own_line { "\n" } else { "" }) + text)
    RosterLabelEdits { edits: edits } => roster_label_splices(before: before, edits: edits)
    // THE LABELS LAND IN THE SAME WRITE AS THE IMPORT THAT MAKES THEM NECESSARY: a file with the import and the old label
    // does not resolve (the home's parameter is `text`), and a file the generator itself loads would stop the generator.
    // The labels sit below the import, so they are spliced first and the import's offsets stay valid.
    RosterEditWithLabels { start: start, end: end, text: text, own_line: own_line, labels: labels } =>
      match roster_label_splices(before: before, edits: labels) {
        RosterApplyRefused { reason: r } => RosterApplyRefused { reason: r }
        RosterApplyWritten { content: relabelled } =>
          if roster_labels_below(labels: labels, at: end) {
            roster_splice(before: relabelled, start: start, end: end, replacement: (if own_line { "\n" } else { "" }) + text)
          } else {
            RosterApplyRefused { reason: RefusalExtentMismatch }
          }
      }
  }
}

// Label edits are applied last-first, so an earlier edit's offsets are unaffected by a later one's length change. Each
// extent must land on scalar boundaries and hold exactly its `from` label; any other byte refuses the whole file.
fn roster_labels_below(labels: List<RosterLabelEdit>, at: Int) -> Bool {
  fold_list(xs: labels, empty: true, cons: fn(ok, e) { ok && e.start >= at })
}

fn roster_label_splices(before: String, edits: List<RosterLabelEdit>) -> RosterApplied {
  let octets = bytes_octets(b: utf8_encode_bytes(s: before))
  fold_list(
    xs: list_reverse(xs: edits),
    empty: RosterApplyWritten { content: before },
    cons: fn(acc, e) {
      match acc {
        RosterApplyRefused { reason: r } => RosterApplyRefused { reason: r }
        RosterApplyWritten { content: content } =>
          let from = roster_scalar_boundary(octets: octets, byte: e.start)
          let to = roster_scalar_boundary(octets: octets, byte: e.end)
          if from < 0 || to < from {
            RosterApplyRefused { reason: RefusalExtentNotOnCharBoundary }
          } else if substring(s: content, start: from, end: to) != e.from {
            RosterApplyRefused { reason: RefusalExtentMismatch }
          } else {
            RosterApplyWritten { content: substring(s: content, start: 0, end: from) + e.to + substring(s: content, start: to, end: string_length(s: content)) }
          }
      }
    }
  )
}

fn roster_splice(before: String, start: Int, end: Int, replacement: String) -> RosterApplied {
  let octets = bytes_octets(b: utf8_encode_bytes(s: before))
  let from = roster_scalar_boundary(octets: octets, byte: start)
  let to = roster_scalar_boundary(octets: octets, byte: end)
  if from < 0 || to < from {
    RosterApplyRefused { reason: RefusalExtentNotOnCharBoundary }
  } else if !roster_extent_holds(before: before, start: from, end: to) {
    RosterApplyRefused { reason: RefusalExtentMismatch }
  } else if length(xs: split(s: substring(s: before, start: from, end: to), delimiter: "//")) > 1 {
    RosterApplyRefused { reason: RefusalExtentHasAnnotation }
  } else {
    RosterApplyWritten { content: substring(s: before, start: 0, end: from) + replacement + substring(s: before, start: to, end: string_length(s: before)) }
  }
}

// ByteRange comes from the parser in UTF-8 bytes; substring indexes Unicode scalars. A byte offset converts to the
// scalar offset that precedes it (the count of non-continuation octets before it) and is valid only when it falls
// on a scalar boundary; -1 otherwise.
fn roster_scalar_boundary(octets: List<Int>, byte: Int) -> Int {
  let total = length(xs: octets)
  if byte < 0 || byte > total {
    0 - 1
  } else if byte == total {
    roster_scalar_count_before(octets: octets, byte: byte)
  } else {
    match list_at_optional(xs: octets, index: byte) {
      Present { value: o } => if roster_is_continuation(octet: o) { 0 - 1 } else { roster_scalar_count_before(octets: octets, byte: byte) }
      Absent => -1
    }
  }
}

// The scalars that start before `byte`, in ONE fold over the octets: a prefix copy (take_prefix) recursed once per byte and
// exceeded the evaluator's call depth on a 132 KB file (v2.extdeps.languages.rust_fixtures), so the count is accumulated.
type RosterScalarScan {
  index: Int
  scalars: Int
}

fn roster_scalar_count_before(octets: List<Int>, byte: Int) -> Int {
  fold_list(
    xs: octets,
    empty: RosterScalarScan { index: 0, scalars: 0 },
    cons: fn(acc, o) {
      RosterScalarScan {
        index: acc.index + 1,
        scalars: if acc.index < byte && !roster_is_continuation(octet: o) { acc.scalars + 1 } else { acc.scalars }
      }
    }
  ).scalars
}

fn roster_scalar_count(octets: List<Int>) -> Int {
  fold_list(xs: octets, empty: 0, cons: fn(n, o) { if roster_is_continuation(octet: o) { n } else { n + 1 } })
}

fn roster_is_continuation(octet: Int) -> Bool {
  octet >= 128 && octet < 192
}

// A replaced extent is a whole std.algebra import declaration (it opens with the keyword and the module and ends at
// its closing brace (roster_apply_edit also refuses an extent carrying a `//` annotation, which the replacement would erase); an insertion point is the end of an import block. Offsets here are scalar offsets.
fn roster_extent_holds(before: String, start: Int, end: Int) -> Bool {
  if start == end {
    substring(s: before, start: start - 1, end: start) == "}"
  } else {
    substring(s: before, start: start, end: start + 7) == "import " && substring(s: before, start: end - 1, end: end) == "}"
  }
}

// The one rendering of an outcome as protocol rows: replacement newlines are escaped as \n.
fn roster_render_outcome(path: String, outcome: RosterOutcome) -> String {
  match outcome {
    RosterClean => ""
    RosterEdit { start: start, end: end, text: text, own_line: own_line } =>
      "EDIT " + path + " " + int_to_decimal_string(value: start) + " " + int_to_decimal_string(value: end) + " "
        + (if own_line { "\\n" } else { "" }) + text + "\n"
    RosterEditWithLabels { start: start, end: end, text: text, own_line: own_line, labels: labels } =>
      roster_render_outcome(path: path, outcome: RosterEdit { start: start, end: end, text: text, own_line: own_line })
        + roster_render_outcome(path: path, outcome: RosterLabelEdits { edits: labels })
    RosterLabelEdits { edits: edits } =>
      fold_list(xs: edits, empty: "", cons: fn(acc, e) {
        acc + "LABEL " + path + " " + int_to_decimal_string(value: e.start) + " " + int_to_decimal_string(value: e.end) + " " + e.from + " " + e.to + "\n"
      })
    RosterRefused { reason: reason } => roster_refuse_row(path: path, reason: reason)
  }
}

fn roster_sweep_text(path: String, text: String, prepared: PreparedGrammar, lex: PreparedLexRules) -> RosterOutcome {
  roster_sweep_text_scoped(path: path, text: text, prepared: prepared, lex: lex, scope: AllHomes)
}

fn roster_sweep_text_scoped(path: String, text: String, prepared: PreparedGrammar, lex: PreparedLexRules, scope: RosterHomeScope) -> RosterOutcome {
      match tokenize_prepared(text: text, file: symbol_intern_lexeme(lexeme: path), prepared: lex) {
        Rejected { diagnostics: _ } => RosterRefused { reason: RefusalTokenizeRefused }
        Accepted { value: stream, diagnostics: _ } =>
          match parse_module_prepared(tokens: stream, prepared: prepared) {
            Rejected { diagnostics: _ } => RosterRefused { reason: RefusalParseRefused }
            Accepted { value: artifact, diagnostics: _ } =>
              match normalize_with(parse_tree: artifact.tree, source: NormalizeWithIsolatedAllocator, spans: artifact.span_index) {
                Rejected { diagnostics: _ } => RosterRefused { reason: RefusalNormalizeRefused }
                Accepted { value: scoped, diagnostics: _ } =>
                  match roster_sweep_rows(
                    parse_root: artifact.tree,
                    spans: artifact.span_index,
                    normalized_root: scoped.tree.root,
                    imported: scoped.tree.import_bindings,
                    scope: scope
                  ) {
                    RosterClean => roster_label_outcome(parse_root: artifact.tree, spans: artifact.span_index, normalized_root: scoped.tree.root, imported: scoped.tree.import_bindings, scope: scope)
                    other => other
                  }
              }
          }
      }
}

// THE LABEL SITES ARE READ FROM RESOLUTION, NOT FROM LEXEMES (review 82002). A label edit is selected only at a call whose
// head is the row's spelling as a FREE name: the parse tree's primary-expression heads spelled `call` are counted against the
// reference-site collector's own head classification of that spelling (v2.compiler.reference_site_collector), and the
// counts must agree. A bound occurrence (a parameter, a local), a method or field spelling, or anything the parse tree
// shows as a head that the collector does not classify as the free name makes them disagree, and the file REFUSES with
// label-sites-ambiguous rather than relabelling what it cannot place. The free name is any occurrence no lexical frame binds
// (roster_head_is_free); that it is the row's HOME is decided by roster_symbol_imported, never by the head class.
type RosterLabelPlan
  = LabelsSelected { edits: List<RosterLabelEdit> }
  | LabelsAmbiguous
  | LabelsLocallyBound

fn roster_label_plan(parse_root: Node, spans: SpanIndex, normalized_root: Node, imported: List<AliasBindingRow>, row: RosterHeadRow, rename: RosterLabelRename) -> RosterLabelPlan {
  let sites = collect_scoped_module_reference_sites(root: normalized_root, imported: list_map(xs: imported, f: fn(b) { b.binding })).sites
  let free = fold_list(xs: sites, empty: 0, cons: fn(n, st) { if roster_head_is_free(head: st.head, imported_from_home: roster_symbol_imported(imported: imported, row: row)) && roster_spelling_is(qn: st.site.spelling, call: row.call) { n + 1 } else { n } })
  let heads = roster_primary_heads(parse_root: parse_root, call: row.call)
  if length(xs: heads) != free {
    LabelsAmbiguous
  } else {
    fold_list(xs: heads, empty: LabelsSelected { edits: [] }, cons: fn(acc, head) {
      match acc {
        LabelsAmbiguous => LabelsAmbiguous
        LabelsLocallyBound => LabelsLocallyBound
        LabelsSelected { edits: es } =>
          fold_list(xs: dag_call_direct_arg_slots(node: head), empty: LabelsSelected { edits: es }, cons: fn(inner, slot) {
            match inner {
              LabelsAmbiguous => LabelsAmbiguous
              LabelsLocallyBound => LabelsLocallyBound
              LabelsSelected { edits: es2 } =>
                // An argument whose capture does not read could be the label this row renames; it is never skipped.
                match slot {
                  Absent => LabelsAmbiguous
                  Present { value: arg } =>
                match dag_named_arg_name_node_optional(arg_capture: arg) {
                  Absent => inner
                  Present { value: name_node } =>
                    match node_atom_identity_optional(node: name_node) {
                      Present { value: label } =>
                        if symbol_lexeme(sym: label) == rename.from {
                          match roster_node_byte_range(node: name_node, spans: spans) {
                            Present { value: r } => LabelsSelected { edits: list_snoc_item(xs: es2, item: RosterLabelEdit { start: r.start, end: r.end, from: rename.from, to: rename.to }) }
                            Absent => LabelsAmbiguous
                          }
                        } else {
                          inner
                        }
                      Absent => inner
                    }
                }
                }
            }
          })
      }
    })
  }
}

// THE ONE FREE-NAME CLASSIFIER, used by the import count (roster_sites_count) and the label plan alike (review 82014). A
// site's spelling is the row's free name when no frame binds it: before the home import exists the collector reports
// HeadLexicallyUnbound; once the spelling is import-bound from the row's home it reports HeadBindingUndecided
// (v2.compiler.reference_site_collector site_head_is_undecided reads the imported names). Anything else -- frame-bound,
// root-bound by a module declaration, or undecided for any other reason -- is not the free name.
fn roster_head_is_free(head: SiteHeadBinding, imported_from_home: Bool) -> Bool {
  match head {
    HeadLexicallyUnbound => true
    HeadBindingUndecided => imported_from_home
    HeadBoundAtRootValue => false
    HeadBoundInFrame => false
    // THE DEFECT #14338 GUARDS AGAINST, GONE AT ITS ROOT. A head the collector reads as sitting at a
    // TYPE ANNOTATION, a LABEL or a PATTERN TAG is not a free name: those are the three positions a
    // value frame is never consulted about, and #14338's sweep mistook one of them -- a declaration's
    // own binder spelling, reached as the ArrowSignatureOrder mention of its parameter, which the
    // authority answers TypeAnnotationPosition -- for a free name. So such a head never counts toward a
    // needed import and never enters the label plan. It is read from the position authority
    // (v2.compiler.occurrence_role reference_position_of) over the site's own recorded position, not
    // from a second name scan here.
    HeadNotAValuePosition => false
  }
}

// Every primary-expression capture whose head (the sequence's left atom) is spelled `call`: a bare `call(...)` or a bare
// `call` reference. A method or field spelling sits in a postfix suffix, not at a primary-expression head.
fn roster_primary_heads(parse_root: Node, call: String) -> List<Node> {
  fold_list(xs: node_subtree_nodes(root: parse_root), empty: [], cons: fn(acc, n) {
    match parse_production_emitted_identity_optional(node: n) {
      Present { value: id } =>
        if id == ^dag_surface_primary_expr {
          match parse_production_captured_child_optional(node: n) {
            Present { value: cap } =>
              match find_named_child(root: cap, name: ^grammar_sequence_left_node_projection) {
                Accepted { value: left, diagnostics: _ } =>
                  match node_atom_identity_optional(node: left) {
                    Present { value: sym } => if symbol_lexeme(sym: sym) == call { list_snoc_item(xs: acc, item: cap) } else { acc }
                    Absent => acc
                  }
                Rejected { diagnostics: _ } => acc
              }
            Absent => acc
          }
        } else {
          acc
        }
      Absent => acc
    }
  })
}

// THE LABEL PLAN OF A SET OF ROWS: every rename of every row, in one fold. A row whose call this module binds locally refuses
// (roster_name_locally_bound) before any site is planned.
fn roster_rows_label_plan(parse_root: Node, spans: SpanIndex, normalized_root: Node, imported: List<AliasBindingRow>, rows: List<RosterHeadRow>) -> RosterLabelPlan {
  fold_list(xs: rows, empty: LabelsSelected { edits: [] }, cons: fn(acc, row) {
    match acc {
      LabelsAmbiguous => LabelsAmbiguous
      LabelsLocallyBound => LabelsLocallyBound
      LabelsSelected { edits: es } =>
        if is_empty(xs: row.labels) {
          acc
        } else if roster_name_locally_bound(normalized_root: normalized_root, call: row.call) {
          LabelsLocallyBound
        } else {
          fold_list(xs: row.labels, empty: LabelsSelected { edits: es }, cons: fn(inner, rename) {
            match inner {
              LabelsAmbiguous => LabelsAmbiguous
              LabelsLocallyBound => LabelsLocallyBound
              LabelsSelected { edits: es2 } =>
                match roster_label_plan(parse_root: parse_root, spans: spans, normalized_root: normalized_root, imported: imported, row: row, rename: rename) {
                  LabelsAmbiguous => LabelsAmbiguous
                  LabelsLocallyBound => LabelsLocallyBound
                  LabelsSelected { edits: more } => LabelsSelected { edits: list_append(left: es2, right: more) }
                }
            }
          })
        }
    }
  })
}

// THE LABEL PASS for a file whose imports are already converged: the in-scope rows whose call is import-visible from their home.
fn roster_label_outcome(parse_root: Node, spans: SpanIndex, normalized_root: Node, imported: List<AliasBindingRow>, scope: RosterHomeScope) -> RosterOutcome {
  let rows = fold_list(xs: roster_rows_for_scope(scope: scope), empty: [], cons: fn(acc, row) {
    if roster_symbol_imported(imported: imported, row: row) { list_snoc_item(xs: acc, item: row) } else { acc }
  })
  match roster_rows_label_plan(parse_root: parse_root, spans: spans, normalized_root: normalized_root, imported: imported, rows: rows) {
    LabelsAmbiguous => RosterRefused { reason: RefusalLabelSitesAmbiguous }
    LabelsLocallyBound => RosterRefused { reason: RefusalHomeNameLocallyBound }
    LabelsSelected { edits: es } => if is_empty(xs: es) { RosterClean } else { RosterLabelEdits { edits: es } }
  }
}

// THE LABELS THE IMPORT EDIT MAKES NECESSARY ride the same outcome: exactly the renames of the rows that edit imports, passed
// in by the import row that rendered it (no home is compared or re-read; reviews 82002 and 82024).
fn roster_with_pending_labels(parse_root: Node, spans: SpanIndex, normalized_root: Node, imported: List<AliasBindingRow>, rows: List<RosterHeadRow>, edit: RosterOutcome) -> RosterOutcome {
  match roster_rows_label_plan(parse_root: parse_root, spans: spans, normalized_root: normalized_root, imported: imported, rows: rows) {
    LabelsAmbiguous => RosterRefused { reason: RefusalLabelSitesAmbiguous }
    LabelsLocallyBound => RosterRefused { reason: RefusalHomeNameLocallyBound }
    LabelsSelected { edits: labels } =>
      match edit {
        RosterEdit { start: st, end: en, text: tx, own_line: ol } =>
          if is_empty(xs: labels) { edit } else { RosterEditWithLabels { start: st, end: en, text: tx, own_line: ol, labels: labels } }
        other => other
      }
  }
}

// The roster rows whose call head is lexically unbound in this file: the heads ruling B refuses
// natively without an import. HeadLexicallyUnbound is the collector's own classification, so a local
// binding, a module-level declaration or an existing import of the same spelling is never swept.
fn roster_needed_rows(normalized_root: Node, imported: List<AliasBindingRow>, scope: RosterHomeScope) -> List<RosterHeadRow> {
  let sites = collect_scoped_module_reference_sites(root: normalized_root, imported: list_map(xs: imported, f: fn(row) { row.binding })).sites
  fold_list(
    xs: roster_rows_for_scope(scope: scope),
    empty: [],
    cons: fn(acc, row) {
      if roster_sites_count(sites: sites, call: row.call) > 0 && !roster_symbol_imported(imported: imported, row: row) {
        list_snoc_item(xs: acc, item: row)
      } else {
        acc
      }
    }
  )
}

// The import binds the SHAPE name, not the call spelling, so the collector keeps classifying the bare call as
// unbound after the import is present. A row is needed only while its shape name is not yet import-visible.
// The shape counts as imported only when the binding's declaring module is std.algebra: a same-named shape bound
// from elsewhere (target not std.algebra.<name>) leaves the std.algebra import required.
fn roster_symbol_imported(imported: List<AliasBindingRow>, row: RosterHeadRow) -> Bool {
  fold_list(xs: imported, empty: false, cons: fn(found, b) { found || (symbol_lexeme(sym: b.binding) == row.import_name && roster_target_is_home(qn: b.target, row: row)) })
}

// The binding's target is exactly <home>.<import_name>.
fn roster_target_is_home(qn: QualifiedName, row: RosterHeadRow) -> Bool {
  roster_qn_text(qn: qn) == roster_qn_text(qn: row.home) + "." + row.import_name
}

// The import row is needed only while its name is not yet import-visible, so its sites are counted in the pre-import phase of
// the one classifier (roster_head_is_free).
fn roster_sites_count(sites: FreeMonoid<ScopedReferenceSite>, call: String) -> Int {
  fold_list(
    xs: sites,
    empty: 0,
    cons: fn(n, s) {
      if roster_head_is_free(head: s.head, imported_from_home: false) && roster_spelling_is(qn: s.site.spelling, call: call) { n + 1 } else { n }
    }
  )
}

// THE INTERIM GUARD (tidy-ant-251's ruling C on #14338): a module that binds a row's call spelling ANYWHERE -- a fn or lambda
// parameter, a `let`, a match-arm binder -- REFUSES home-name-locally-bound, for the import row and the label pass alike. It is
// read from the binders themselves (v2.compiler.lexical_scope arrow_domain_binder_names, bind_binder,
// match_arm_candidate_names over the normalized tree), never from the collector's head classification. WHY IT WAS WRITTEN: the
// classifier had no way to say "no value frame is consulted here", so #14338's specimen row read as a free name and the sweep
// emitted an import for it (gunbc.recurring_failure_mode
// a_roster_sweep_counts_a_bound_or_label_spelling_as_an_unbound_call). THAT CAUSE IS NOW REPAIRED AT THE CLASSIFIER (the
// HeadNotAValuePosition arm above, fed by v2.compiler.occurrence_role reference_position_of), which makes this guard a second
// path beside the modeled one -- DESIGN 3. It stays ONLY because it only ever refuses (never admits), so it cannot let a wrong
// edit through, and because its removal must be landed with its controls, not after them.
// TRACKED DISSOLUTION TRIGGER (tidy-ant-251: the dissolution is its own PR, after this classifier fix merges): the guard is
// deleted by removing roster_name_locally_bound's two call sites here (roster_rows_label_plan's locally-bound refusal and the
// import row's RefusalHomeNameLocallyBound), and the retirement is PROVEN by the controls the recurring-failure-mode row
// enrols -- its specimen and called-parameter controls must come back Clean and correctly relabelled with the guard removed,
// exactly as the row's measured rows in v2.test.claim.lexical_scope (the_called_parameter_head_at_the_call_is_bound_in_the_frame,
// a_parameter_is_not_bound_in_a_sibling_parameter_type, a_type_annotation_sees_no_value_binder) already pin both readings. The
// row's `evidence` refs name the capability; when the dissolution PR lands, the guard and the refusal variant come out with it.
fn roster_name_locally_bound(normalized_root: Node, call: String) -> Bool {
  fold_list(xs: node_subtree_nodes(root: normalized_root), empty: false, cons: fn(found, n) {
    found || roster_node_binds(n: n, call: call)
  })
}

fn roster_node_binds(n: Node, call: String) -> Bool {
  let arrow = fold_list(xs: arrow_domain_binder_names(n: n), empty: false, cons: fn(f, b) { f || symbol_lexeme(sym: b) == call })
  let bind = match bind_binder(n: n) {
    Present { value: b } => symbol_lexeme(sym: b.name) == call
    Absent => false
  }
  let arms = match n.kind {
    ComputationNode { behavior: Match } =>
      fold_list(xs: n.children, empty: false, cons: fn(f, e) { f || roster_arm_binds(e: e, call: call) })
    _ => false
  }
  arrow || bind || arms
}

fn roster_arm_binds(e: Edge, call: String) -> Bool {
  fold_list(xs: match_arm_candidate_names(arm: e.target), empty: false, cons: fn(f, b) { f || symbol_lexeme(sym: b) == call })
}

fn roster_spelling_is(qn: QualifiedName, call: String) -> Bool {
  match qn {
    Cons { head: h, tail: Empty } => (symbol_lexeme(sym: h) == call)
    _ => false
  }
}

fn roster_sweep_rows(
  parse_root: Node,
  spans: SpanIndex,
  normalized_root: Node,
  imported: List<AliasBindingRow>,
  scope: RosterHomeScope
) -> RosterOutcome {
  let needed = roster_needed_rows(normalized_root: normalized_root, imported: imported, scope: scope)
  if is_empty(xs: needed) {
    RosterClean
  } else if fold_list(xs: needed, empty: false, cons: fn(f, r) { f || roster_name_locally_bound(normalized_root: normalized_root, call: r.call) }) {
    RosterRefused { reason: RefusalHomeNameLocallyBound }
  } else if roster_any_needed_bound_elsewhere(needed: needed, imported: imported) {
    RosterRefused { reason: RefusalShapeNameBoundElsewhere }
  } else {
    roster_import_row(parse_root: parse_root, spans: spans, normalized_root: normalized_root, imported: imported, needed: needed)
  }
}

// A needed shape name this module already binds to a DIFFERENT declaration: adding the std.algebra import would give one
// local name two targets, so the sweep names the conflict and leaves the file unchanged.
fn roster_any_needed_bound_elsewhere(needed: List<RosterHeadRow>, imported: List<AliasBindingRow>) -> Bool {
  fold_list(
    xs: needed,
    empty: false,
    cons: fn(found, row) {
      found || fold_list(xs: imported, empty: false, cons: fn(hit, b) { hit || symbol_lexeme(sym: b.binding) == row.import_name })
    }
  )
}

// ONE EXISTING std.algebra IMPORT: its bound names are the value's base. NONE: the value starts empty
// and the block is inserted after the last import declaration. TWO OR MORE std.algebra imports refuse
// (a merge would choose which declaration survives).
type ImportDeclFact {
  module_name: String
  names: List<String>
  start: Int
  end: Int
}

// ONE HOME PER OUTCOME: the needed rows of the FIRST home in table order are rendered; a file that needs a second home
// still has pending rows after the apply, so the convergence re-run (roster_import_sweep_exit) emits that home's edit next.
fn roster_import_row(parse_root: Node, spans: SpanIndex, normalized_root: Node, imported: List<AliasBindingRow>, needed: List<RosterHeadRow>) -> RosterOutcome {
  match needed {
    Empty => RosterClean
    Cons { head: first, tail: _ } =>
      let home_rows = fold_list(xs: needed, empty: [], cons: fn(acc, r) { if roster_qn_text(qn: r.home) == roster_qn_text(qn: first.home) { list_snoc_item(xs: acc, item: r) } else { acc } })
      roster_with_pending_labels(
        parse_root: parse_root,
        spans: spans,
        normalized_root: normalized_root,
        imported: imported,
        rows: home_rows,
        edit: roster_import_row_home(parse_root: parse_root, spans: spans, home: first.home, needed: home_rows)
      )
  }
}

fn roster_import_row_home(parse_root: Node, spans: SpanIndex, home: QualifiedName, needed: List<RosterHeadRow>) -> RosterOutcome {
  let decls = roster_import_decl_facts(parse_root: parse_root, spans: spans)
  let algebra = roster_filter_module(decls: decls, module_name: roster_qn_text(qn: home))
  let wanted = list_map(xs: needed, f: fn(r) { r.import_name })
  match length(xs: algebra) {
    0 =>
      match roster_last_decl_end(decls: decls) {
        Present { value: at } =>
          RosterEdit { start: at, end: at, text: roster_render_import(home: home, names: roster_dedupe(base: [], more: wanted)), own_line: true }
        Absent => RosterRefused { reason: RefusalNoImportAnchor }
      }
    _ =>
      // Several std.algebra imports make the same names visible; the first one is extended and the rest stay as authored.
      fold_list(
        xs: algebra,
        empty: RosterClean,
        cons: fn(acc, d) {
          match acc {
            RosterClean =>
              RosterEdit { start: d.start, end: d.end, text: roster_render_import(home: home, names: roster_dedupe(base: d.names, more: wanted)), own_line: false }
            _ => acc
          }
        }
      )
  }
}

fn roster_render_import(home: QualifiedName, names: List<String>) -> String {
  "import " + roster_qn_text(qn: home) + " { " + roster_join(xs: names, sep: ", ") + " }"
}

// Deduplicated by spelling identity; the existing names keep their order, new names follow.
fn roster_dedupe(base: List<String>, more: List<String>) -> List<String> {
  fold_list(
    xs: more,
    empty: base,
    cons: fn(acc, name) {
      if roster_contains(xs: acc, name: name) { acc } else { list_snoc_item(xs: acc, item: name) }
    }
  )
}

fn roster_contains(xs: List<String>, name: String) -> Bool {
  fold_list(xs: xs, empty: false, cons: fn(found, x) { found || (x == name) })
}

fn roster_filter_module(decls: List<ImportDeclFact>, module_name: String) -> List<ImportDeclFact> {
  fold_list(
    xs: decls,
    empty: [],
    cons: fn(acc, d) {
      if (d.module_name == module_name) { list_snoc_item(xs: acc, item: d) } else { acc }
    }
  )
}

fn roster_last_decl_end(decls: List<ImportDeclFact>) -> Int? {
  fold_list(
    xs: decls,
    empty: Absent,
    cons: fn(acc, d) { Present { value: d.end } }
  )
}

fn roster_import_decl_facts(parse_root: Node, spans: SpanIndex) -> List<ImportDeclFact> {
  fold_list(
    xs: node_subtree_nodes(root: parse_root),
    empty: [],
    cons: fn(acc, n) {
      match parse_production_emitted_identity_optional(node: n) {
        Present { value: id } =>
          if id == ^dag_surface_import_decl {
            match roster_import_decl_fact(decl: n, root: parse_root, spans: spans) {
              Present { value: fact } => list_snoc_item(xs: acc, item: fact)
              Absent => acc
            }
          } else {
            acc
          }
        Absent => acc
      }
    }
  )
}

fn roster_import_decl_fact(decl: Node, root: Node, spans: SpanIndex) -> ImportDeclFact? {
  match import_decl_target_module(decl: decl, module_root: root) {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: target, diagnostics: _ } =>
      match parse_import_block_idents(import_decl_node: decl, root: root) {
        Rejected { diagnostics: _ } => Absent
        Accepted { value: names, diagnostics: _ } =>
          match roster_node_byte_range(node: decl, spans: spans) {
            Present { value: range } =>
              Present {
                value: ImportDeclFact {
                  module_name: roster_join(xs: list_map(xs: target, f: fn(s) { symbol_lexeme(sym: s) }), sep: "."),
                  names: list_map(xs: names, f: fn(s) { symbol_lexeme(sym: s) }),
                  start: range.start,
                  end: range.end
                }
              }
            Absent => Absent
          }
      }
  }
}

type RosterByteRange {
  start: Int
  end: Int
}

fn roster_node_byte_range(node: Node, spans: SpanIndex) -> RosterByteRange? {
  match node.occurrence_id {
    OccurrenceMinted { id: id } => roster_id_byte_range(id: id, spans: spans)
    OccurrenceProjected { id: id, caused_by: _ } => roster_id_byte_range(id: id, spans: spans)
    OccurrenceSynthetic => Absent
    OccurrencePending { caused_by: _ } => Absent
  }
}

fn roster_id_byte_range(id: OccurrenceId, spans: SpanIndex) -> RosterByteRange? {
  match span_index_extent(index: spans, id: id) {
    Present { value: recorded } =>
      match recorded {
        SourceExtentKnown { locus: Textual { file: _, extent: ByteRange { start: s, end: e } } } =>
          Present { value: RosterByteRange { start: s, end: e } }
        _ => Absent
      }
    Absent => Absent
  }
}

fn roster_join(xs: List<String>, sep: String) -> String {
  fold_list(xs: xs, empty: "", cons: fn(acc, x) { if acc == "" { x } else { acc + sep + x } })
}

// THE CONTROLS, run as `gunbc run --entry src/v2/workflow/roster_import_sweep.dag --function roster_import_sweep_controls_exit`.
// Each case is source text pushed through the same tokenize/parse/normalize route and the same pure splice the apply step
// performs, so a divergence between parser coordinates and applier coordinates fails here with the case named.
//   homonym:  a same-named shape imported from another module does not satisfy the std.algebra import (an EDIT, not Clean).
//   present:  the std.algebra import already carries the shape (Clean).
//   multibyte: UTF-8 text before and after the import; byte extents must land on scalar boundaries and everything outside
//             the extent is preserved byte for byte.
//   annotation: a `//` inside the replaced import would be erased, so the splice refuses.
fn roster_import_sweep_controls_exit() -> ProcessExit {
  let report = roster_controls_report()
  if (report == "") { ExitSuccess } else { exit_failure(reason: report) }
}

// THE GATED ENTRY: `gunbc test //gunbc/instruments:roster-import-sweep-controls` (gunbc.instrument_targets
// roster_import_sweep_controls_binding, a CliWireProgramProducer row). It runs the pure controls; the effectful lock controls
// need a caller-made empty directory and stay a hand-run entry.
fn roster_import_sweep_controls_wire() -> CliWireResponse {
  let report = roster_controls_report()
  if (report == "") {
    CliWirePrintable { bytes: "roster-import-sweep controls held\n", exit: ExitSuccess }
  } else {
    CliWirePrintable { bytes: report, exit: exit_failure(reason: report) }
  }
}

// THE BOUNDARY CONTROLS USE AN OTHERWISE VALID EDIT: an import the splice accepts (roster_control_edit_splices proves
// it on the text), so a refusal at the write boundary can only be the boundary's own, never an invalid splice's.
fn roster_control_source(module_name: String) -> String {
  "module " + module_name + "\n\nimport std.algebra { Cons }\n\nfn f(xs: List<String>) -> Int {\n  count(xs: xs)\n}\n"
}

fn roster_control_valid_edit(module_name: String) -> RosterOutcome {
  let start = string_length(s: "module " + module_name + "\n\n")
  RosterEdit { start: start, end: start + 27, text: "import std.algebra { Cons, collection_count_shape }", own_line: false }
}

fn roster_control_edit_splices() -> String {
  match roster_applied(before: roster_control_source(module_name: "c.unheld"), outcome: roster_control_valid_edit(module_name: "c.unheld")) {
    RosterApplyWritten { content: content } =>
      if content == "module c.unheld\n\nimport std.algebra { Cons, collection_count_shape }\n\nfn f(xs: List<String>) -> Int {\n  count(xs: xs)\n}\n" { "" } else { "CONTROL-FAIL valid-edit: spliced to unexpected text\n" }
    RosterApplyRefused { reason: reason } => "CONTROL-FAIL valid-edit: refused " + roster_refusal_text(reason: reason) + "\n"
  }
}

fn roster_controls_report() -> String {
  match dag_prepared_grammar() {
    Rejected { diagnostics: _ } => "CONTROL-FAIL grammar-unprepared\n"
    Accepted { value: prepared, diagnostics: _ } =>
      roster_control_homonym(prepared: prepared, lex: dag_prepared_lex())
        + roster_control_present(prepared: prepared, lex: dag_prepared_lex())
        + roster_control_multibyte(prepared: prepared, lex: dag_prepared_lex())
        + roster_control_annotation(prepared: prepared, lex: dag_prepared_lex())
        + roster_control_home_converges(prepared: prepared, lex: dag_prepared_lex())
        + roster_control_label_local_call(prepared: prepared, lex: dag_prepared_lex())
        + roster_control_label_method_spelling(prepared: prepared, lex: dag_prepared_lex())
        + roster_control_label_bound_occurrence(prepared: prepared, lex: dag_prepared_lex())
        + roster_control_specimen(prepared: prepared, lex: dag_prepared_lex())
        + roster_control_called_parameter(prepared: prepared, lex: dag_prepared_lex())
        + roster_control_nested_call_label(prepared: prepared, lex: dag_prepared_lex())
        + roster_control_label_sites_disagree(prepared: prepared, lex: dag_prepared_lex())
        + roster_control_positional_past_unreadable()
        + roster_control_edit_splices()
        + roster_control_generation()
        + roster_control_status_names()
        + roster_control_ancestor()
  }
}

// A HOME OTHER THAN std.algebra, in ONE write: pass 1 inserts `import std.host_text { chars }` after the last import AND
// renames each `chars(s:` label to `text:` (a file with the import and the old label does not resolve), leaving a non-call
// `s:` and a call to another function alone; pass 2 is Clean. Multibyte text after the call checks the label extents.
fn roster_control_home_converges(prepared: PreparedGrammar, lex: PreparedLexRules) -> String {
  let before = "module c.host\n\nimport std.algebra { Cons, collection_count_shape }\n\nfn f(x: String) -> Int {\n  g(s: x) + count(xs: chars(s: x)) + count(xs: chars(s: \"é😀\"))\n}\n"
  let after = "module c.host\n\nimport std.algebra { Cons, collection_count_shape }\nimport std.host_text { chars }\n\nfn f(x: String) -> Int {\n  g(s: x) + count(xs: chars(text: x)) + count(xs: chars(text: \"é😀\"))\n}\n"
  match roster_applied(before: before, outcome: roster_sweep_text(path: "control/host.dag", text: before, prepared: prepared, lex: lex)) {
    RosterApplyRefused { reason: r } => "CONTROL-FAIL home-converges: pass 1 refused " + roster_refusal_text(reason: r) + "\n"
    RosterApplyWritten { content: c1 } =>
      if c1 != after { "CONTROL-FAIL home-converges: pass 1 did not write the std.host_text import and exactly the chars(s: relabels\n" } else {
        match roster_sweep_text(path: "control/host.dag", text: c1, prepared: prepared, lex: lex) {
          RosterClean => ""
          _ => "CONTROL-FAIL home-converges: pass 2 is not Clean\n"
        }
      }
  }
}

// A METHOD SPELLING IS NOT THE FREE NAME: `x.chars(s: y)` beside a free `chars(s: x)` relabels only the free call (review
// 82002's specimen). The method's label keeps `s:`.
fn roster_control_label_method_spelling(prepared: PreparedGrammar, lex: PreparedLexRules) -> String {
  let before = "module c.method\n\nimport std.algebra { Cons, collection_count_shape }\n\nfn f(x: String, y: Box) -> Int {\n  count(xs: chars(s: x)) + y.chars(s: x)\n}\n"
  let after = "module c.method\n\nimport std.algebra { Cons, collection_count_shape }\nimport std.host_text { chars }\n\nfn f(x: String, y: Box) -> Int {\n  count(xs: chars(text: x)) + y.chars(s: x)\n}\n"
  match roster_applied(before: before, outcome: roster_sweep_text(path: "control/method.dag", text: before, prepared: prepared, lex: lex)) {
    RosterApplyRefused { reason: r } => "CONTROL-FAIL label-method-spelling: refused " + roster_refusal_text(reason: r) + "\n"
    RosterApplyWritten { content: c } => if c == after { "" } else { "CONTROL-FAIL label-method-spelling: the method call's label was renamed, or the free call's was not\n" }
  }
}

// THE INTERIM GUARD'S THREE SHAPES, each with ONE expected outcome (tidy-ant-251's ruling C; review 82014):
//   bound occurrence: a parameter named chars read in a body, beside a free chars(s: x) -> refuses home-name-locally-bound;
//   specimen (gunbc.recurring_failure_mode a_roster_sweep_counts_a_bound_or_label_spelling_as_an_unbound_call): chars only as a
//     parameter read and an argument label, no free call -> refuses home-name-locally-bound (the import is never written);
//   called parameter: fn u(chars: fn(String) -> Int, x: String) { chars(s: x) } -> refuses home-name-locally-bound (neither
//     the import nor the relabel of the parameter's call is written).
// The free-call positive is roster_control_home_converges.
fn roster_control_refuses_locally_bound(name: String, text: String, prepared: PreparedGrammar, lex: PreparedLexRules) -> String {
  match roster_sweep_text(path: "control/" + name + ".dag", text: text, prepared: prepared, lex: lex) {
    RosterRefused { reason: r } => if roster_refusal_text(reason: r) == "home-name-locally-bound" { "" } else { "CONTROL-FAIL " + name + ": refused for " + roster_refusal_text(reason: r) + "\n" }
    _ => "CONTROL-FAIL " + name + ": a module that binds chars locally was swept instead of refused home-name-locally-bound\n"
  }
}

fn roster_control_label_bound_occurrence(prepared: PreparedGrammar, lex: PreparedLexRules) -> String {
  roster_control_refuses_locally_bound(name: "label-bound-occurrence", text: "module c.bound\n\nimport std.algebra { Cons, collection_count_shape }\n\nfn f(x: String) -> Int {\n  count(xs: chars(s: x))\n}\n\nfn g(chars: Int) -> Int {\n  h(s: chars)\n}\n", prepared: prepared, lex: lex)
}

fn roster_control_specimen(prepared: PreparedGrammar, lex: PreparedLexRules) -> String {
  roster_control_refuses_locally_bound(name: "specimen", text: "module c.spec\n\nimport std.algebra { Cons, collection_join_shape }\n\nfn v(s: String, chars: List<String>) -> String {\n  join(chars, \"\")\n}\n\nfn w(s: String) -> String {\n  v(s: s, chars: [])\n}\n", prepared: prepared, lex: lex)
}

fn roster_control_called_parameter(prepared: PreparedGrammar, lex: PreparedLexRules) -> String {
  roster_control_refuses_locally_bound(name: "called-parameter", text: "module c.called\n\nimport std.algebra { Cons }\n\nfn u(chars: fn(String) -> Int, x: String) -> Int {\n  chars(s: x)\n}\n", prepared: prepared, lex: lex)
}

// A NESTED CALL'S LABEL IS NOT THE OUTER CALL'S: chars(s: g(s: x)) relabels only chars's own direct argument; the inner g's
// s: is an argument of g (the stopping rule of v2.extdeps.languages.dag dag_call_direct_args).
fn roster_control_nested_call_label(prepared: PreparedGrammar, lex: PreparedLexRules) -> String {
  let before = "module c.nested\n\nimport std.algebra { Cons, collection_count_shape }\n\nfn f(x: String) -> Int {\n  count(xs: chars(s: g(s: x)))\n}\n"
  let after = "module c.nested\n\nimport std.algebra { Cons, collection_count_shape }\nimport std.host_text { chars }\n\nfn f(x: String) -> Int {\n  count(xs: chars(text: g(s: x)))\n}\n"
  match roster_applied(before: before, outcome: roster_sweep_text(path: "control/nested.dag", text: before, prepared: prepared, lex: lex)) {
    RosterApplyWritten { content: c } => if c == after { "" } else { "CONTROL-FAIL nested-call-label: the inner call's label was renamed, or the outer call's was not\n" }
    RosterApplyRefused { reason: r } => "CONTROL-FAIL nested-call-label: refused " + roster_refusal_text(reason: r) + "\n"
  }
}

// THE COUNT-AGREEMENT DISCRIMINATOR, with NO local binder named chars (so home-name-locally-bound cannot answer first): chars
// also occurs in a TYPE position, `y: chars`, which the reference-site collector records as a free site but which is not a
// primary-expression head, so the two counts disagree and the label plan must refuse exactly label-sites-ambiguous.
fn roster_control_label_sites_disagree(prepared: PreparedGrammar, lex: PreparedLexRules) -> String {
  match roster_sweep_text(path: "control/disagree.dag", text: "module c.disagree\n\nimport std.algebra { Cons, collection_count_shape }\n\nfn f(x: String, y: chars) -> Int {\n  count(xs: chars(s: x))\n}\n", prepared: prepared, lex: lex) {
    RosterRefused { reason: r } => if roster_refusal_text(reason: r) == "label-sites-ambiguous" { "" } else { "CONTROL-FAIL label-sites-disagree: refused for " + roster_refusal_text(reason: r) + "\n" }
    _ => "CONTROL-FAIL label-sites-disagree: a count disagreement between free sites and call heads did not refuse label-sites-ambiguous\n"
  }
}

// A POSITIONAL READ PAST AN UNREADABLE ARGUMENT keeps its slot (v2.extdeps.languages.dag dag_call_direct_arg_slots). Both
// unreadable kinds parse_production_captured_child_optional maps to Absent are covered: a MISSING capture and an AMBIGUOUS one
// (two captured edges). Each is followed by a valid positional argument that must not be selected for the unreadable slot.
// The call's direct arguments are readable, missing, readable, ambiguous, readable -- a shape no parse produces, so they are
// SUPPLIED here, at the producer's own interface: positions 1 and 3 answer Absent, positions 2 and 4 answer their own
// arguments, never a neighbour. Dropping unreadable slots shifted every later position (side chat on #14338).
type RosterSynthCapture
  = SynthCaptured { node: Node }
  | SynthCaptureMissing
  | SynthCaptureAmbiguous { first: Node, second: Node }

fn roster_control_positional_past_unreadable() -> String {
  let call = roster_synth_conj(children: [
    Edge { label: Positional, target: roster_synth_arg(capture: SynthCaptured { node: roster_synth_atom(id: ^roster_slot_first) }) },
    Edge { label: Positional, target: roster_synth_arg(capture: SynthCaptureMissing) },
    Edge { label: Positional, target: roster_synth_arg(capture: SynthCaptured { node: roster_synth_atom(id: ^roster_slot_third) }) },
    Edge { label: Positional, target: roster_synth_arg(capture: SynthCaptureAmbiguous { first: roster_synth_atom(id: ^roster_slot_ambiguous_a), second: roster_synth_atom(id: ^roster_slot_ambiguous_b) }) },
    Edge { label: Positional, target: roster_synth_arg(capture: SynthCaptured { node: roster_synth_atom(id: ^roster_slot_fifth) }) }
  ])
  if roster_position_absent(call: call, position: 1)
    && roster_position_is(call: call, position: 2, want: ^roster_slot_third)
    && roster_position_absent(call: call, position: 3)
    && roster_position_is(call: call, position: 4, want: ^roster_slot_fifth) {
    ""
  } else {
    "CONTROL-FAIL positional-past-unreadable: a positional read past a missing or ambiguous capture shifted onto its neighbour\n"
  }
}

fn roster_position_absent(call: Node, position: Int) -> Bool {
  match dag_call_positional_arg_value_optional(node: call, position: position) { Absent => true  Present { value: _ } => false }
}

fn roster_position_is(call: Node, position: Int, want: Symbol) -> Bool {
  match dag_call_positional_arg_value_optional(node: call, position: position) {
    Present { value: n } => match node_atom_identity_optional(node: n) { Present { value: id } => id == want  Absent => false }
    Absent => false
  }
}

fn roster_synth_atom(id: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: id } }, children: [], occurrence_id: OccurrenceSynthetic }
}

fn roster_synth_conj(children: List<Edge>) -> Node {
  Node { kind: TypeNode { connective: Conj }, children: children, occurrence_id: OccurrenceSynthetic }
}

fn roster_synth_captured_edge(target: Node) -> Edge {
  Edge { label: Authored { name: ^grammar_production_captured_node_projection }, target: target }
}

// An ^dag_surface_arg production: its identity edge, and zero, one or two captured edges.
fn roster_synth_arg(capture: RosterSynthCapture) -> Node {
  let identity = Edge { label: Authored { name: ^grammar_production_identity_node_projection }, target: roster_synth_atom(id: ^dag_surface_arg) }
  match capture {
    SynthCaptured { node: c } => roster_synth_conj(children: [identity, roster_synth_captured_edge(target: c)])
    SynthCaptureMissing => roster_synth_conj(children: [identity])
    SynthCaptureAmbiguous { first: a, second: b } => roster_synth_conj(children: [identity, roster_synth_captured_edge(target: a), roster_synth_captured_edge(target: b)])
  }
}

// A MODULE THAT DECLARES ITS OWN chars is not a caller of the home: no import is needed, so no label is renamed.
fn roster_control_label_local_call(prepared: PreparedGrammar, lex: PreparedLexRules) -> String {
  match roster_sweep_text(path: "control/local.dag", text: "module c.local\n\nimport std.algebra { Cons }\n\nfn chars(s: String) -> Int {\n  1\n}\n\nfn f(x: String) -> Int {\n  chars(s: x)\n}\n", prepared: prepared, lex: lex) {
    RosterClean => ""
    _ => "CONTROL-FAIL label-local-call: a module-local chars was swept\n"
  }
}

fn roster_control_homonym(prepared: PreparedGrammar, lex: PreparedLexRules) -> String {
  match roster_sweep_text(path: "control/homonym.dag", text: "module c.homonym\n\nimport examples.decoy { collection_concat_shape }\n\nfn f(xs: List<String>, ys: List<String>) -> List<String> {\n  concat(a: xs, b: ys)\n}\n", prepared: prepared, lex: lex) {
    RosterRefused { reason: reason } =>
      if roster_refusal_text(reason: reason) == "shape-name-bound-elsewhere" { "" } else { "CONTROL-FAIL homonym: refused for " + roster_refusal_text(reason: reason) + "\n" }
    _ => "CONTROL-FAIL homonym: a shape name bound to another declaration was not refused as a conflict\n"
  }
}

fn roster_control_present(prepared: PreparedGrammar, lex: PreparedLexRules) -> String {
  match roster_sweep_text(path: "control/present.dag", text: "module c.present\n\nimport std.algebra { collection_concat_shape }\n\nfn f(xs: List<String>, ys: List<String>) -> List<String> {\n  concat(a: xs, b: ys)\n}\n", prepared: prepared, lex: lex) {
    RosterClean => ""
    _ => "CONTROL-FAIL present: an existing std.algebra import was not recognised\n"
  }
}

fn roster_control_multibyte(prepared: PreparedGrammar, lex: PreparedLexRules) -> String {
  let before = "module c.multibyte\n\n// 😀 é 日本 before the import\nimport std.algebra { Cons }\n\nfn f(xs: List<String>) -> Int {\n  count(xs: xs)\n}\n\nfn g() -> String {\n  \"tail 😀 é\"\n}\n"
  let expected = "module c.multibyte\n\n// 😀 é 日本 before the import\nimport std.algebra { Cons, collection_count_shape }\n\nfn f(xs: List<String>) -> Int {\n  count(xs: xs)\n}\n\nfn g() -> String {\n  \"tail 😀 é\"\n}\n"
  match roster_applied(before: before, outcome: roster_sweep_text(path: "control/multibyte.dag", text: before, prepared: prepared, lex: lex)) {
    RosterApplyWritten { content: content } =>
      if content == expected { "" } else { "CONTROL-FAIL multibyte: spliced text differs from the expected text outside or inside the extent\n" }
    RosterApplyRefused { reason: reason } => "CONTROL-FAIL multibyte: refused " + roster_refusal_text(reason: reason) + "\n"
  }
}

// An unreadable generation file leaves the history unestablished (no restart of the nonce count); only an absent one is first use.
fn roster_control_generation() -> String {
  let first = roster_generation_history(success: false, content: "", error_kind: "not_found")
  let denied = roster_generation_history(success: false, content: "", error_kind: "permission_denied")
  let other = roster_generation_history(success: false, content: "", error_kind: "other")
  let known = roster_generation_history(success: true, content: "xx", error_kind: "")
  let first_ok = match first {
    RosterHistoryKnown { content: c } => c == ""
    RosterHistoryUnestablished => false
  }
  let denied_bad = match denied {
    RosterHistoryKnown { content: c } => false
    RosterHistoryUnestablished => true
  }
  let other_bad = match other {
    RosterHistoryKnown { content: c } => false
    RosterHistoryUnestablished => true
  }
  let known_ok = match known {
    RosterHistoryKnown { content: c } => c == "xx"
    RosterHistoryUnestablished => false
  }
  if first_ok && denied_bad && other_bad && known_ok { "" } else { "CONTROL-FAIL generation: an unreadable history was read as empty\n" }
}

fn roster_control_status_names() -> String {
  let entries = " M src/a.dag\u{0}?? src/b.dag\u{0}R  new.dag\u{0}old.dag\u{0}"
  if roster_status_names_path(entries_nul: entries, path: "src/a.dag") && roster_status_names_path(entries_nul: entries, path: "old.dag") && !roster_status_names_path(entries_nul: entries, path: "src/c.dag") && !roster_status_names_path(entries_nul: entries, path: "a.dag") {
    ""
  } else {
    "CONTROL-FAIL status: porcelain fields misread\n"
  }
}

fn roster_control_ancestor() -> String {
  let entries = "?? src\u{0} D docs/x.dag\u{0}?? srcx\u{0}"
  if roster_status_names_ancestor(entries_nul: entries, path: "src/f.dag") && roster_status_names_ancestor(entries_nul: "?? src/\u{0}", path: "src/a/f.dag") && !roster_status_names_ancestor(entries_nul: entries, path: "srcy/f.dag") && !roster_status_names_ancestor(entries_nul: entries, path: "src") {
    ""
  } else {
    "CONTROL-FAIL ancestor: status entry naming a parent directory misread\n"
  }
}

fn roster_control_annotation(prepared: PreparedGrammar, lex: PreparedLexRules) -> String {
  let before = "module c.annotation\n\nimport std.algebra {\n  // 😀 kept\n  Cons\n}\n\nfn f(xs: List<String>) -> Int {\n  count(xs: xs)\n}\n"
  match roster_applied(before: before, outcome: roster_sweep_text(path: "control/annotation.dag", text: before, prepared: prepared, lex: lex)) {
    RosterApplyRefused { reason: reason } =>
      if roster_refusal_text(reason: reason) == "extent-has-annotation" { "" } else { "CONTROL-FAIL annotation: refused for " + roster_refusal_text(reason: reason) + "\n" }
    RosterApplyWritten { content: _ } => "CONTROL-FAIL annotation: the splice erased an annotation\n"
  }
}

// THE LOCK CONTROLS (effectful), run as `gunbc run … --function roster_import_sweep_lock_controls_exit --arg root_dir=<absolute scratch dir>`.
// The scratch dir must be one the caller just created EMPTY (no mkdir operation is reachable from a .dag effect, so the controls
// cannot create it themselves): a non-empty dir, or one with a `.git` entry, is refused before anything is touched. The controls
// create and delete only the files they created in it (`.roster_control_*`, the lock and the generation file), never a `.git`,
// and never touch the real worktree: they take the lock with roster_lock_take, which makes no claim about the root.
//   unheld:   a token built without roster_lock_acquire (no lock file) refuses `lock-not-held`; the target keeps its bytes.
//   stale:    a token from an earlier acquisition refuses `lock-not-held` while another acquisition holds the lock.
//   contend:  with the lock held, a second take on the same root is refused.
//   traversal: roster_apply_edit itself (the write boundary) refuses `../outside.dag` under a held lock and creates nothing.
//   spellings: the scratch dir and a subdirectory of the real toplevel are not the git toplevel, so acquire refuses `root-not-git-toplevel`
//             and creates no lock; a relative or non-canonical root is refused.
//   (the pure controls cover an unreadable generation history and the porcelain reader; the git admission of a target
//   (symlink 120000, untracked, modified) is exercised by the real apply run, not by a planted observation.)
fn roster_import_sweep_lock_controls_exit(root_dir: String) -> ProcessExit {
  let listed = Filesystem.List(path: root_dir)
  if !roster_root_admitted(root_dir: root_dir) || !listed.success || listed.entries != "" {
    exit_failure(reason: "CONTROL-FAIL scratch dir must be an absolute, existing, EMPTY directory the caller just created\n")
  } else {
    let report = roster_lock_controls_report(root_dir: root_dir)
    let cleaned = Filesystem.Delete(path: roster_generation_file(root: root_dir))
    let left = Filesystem.List(path: root_dir)
    if report == "" && cleaned.success && left.success && left.entries == "" { ExitSuccess } else { exit_failure(reason: report + "CONTROL-FAIL scratch dir not left empty\n") }
  }
}

fn roster_lock_controls_report(root_dir: String) -> String {
  roster_control_unheld(root_dir: root_dir)
    + roster_control_stale(root_dir: root_dir)
    + roster_control_contend(root_dir: root_dir)
    + roster_control_traversal(root_dir: root_dir)
    + roster_control_spellings(root_dir: root_dir)
}

fn roster_control_unheld(root_dir: String) -> String {
  let before = roster_control_source(module_name: "c.unheld")
  let target = ".roster_control_unheld.dag"
  if !Filesystem.WriteCreateNew(path: root_dir + "/" + target, content: before).success {
    "CONTROL-FAIL unheld: scratch target could not be created\n"
  } else {
    let refused = roster_apply_edit(
      held: RosterHeldLock { root: root_dir, nonce: "forged" },
      path: target,
      before: before,
      outcome: roster_control_valid_edit(module_name: "c.unheld")
    )
    let after = Filesystem.Read(path: root_dir + "/" + target)
    let removed = Filesystem.Delete(path: root_dir + "/" + target)
    if refused != roster_refuse_row(path: target, reason: RefusalLockNotHeld) {
      "CONTROL-FAIL unheld: got " + refused
    } else if !after.success || after.content != before {
      "CONTROL-FAIL unheld: the target changed without the lock\n"
    } else {
      ""
    }
  }
}

fn roster_control_stale(root_dir: String) -> String {
  let before = roster_control_source(module_name: "c.stale")
  let target = ".roster_control_stale.dag"
  match roster_lock_take(root_dir: root_dir) {
    RosterLockRefused { reason: reason } => "CONTROL-FAIL stale: first acquire refused " + roster_refusal_text(reason: reason) + "\n"
    RosterLockAcquired { held: first } =>
      if !roster_lock_release(held: first) {
        "CONTROL-FAIL stale: first release failed\n"
      } else {
        match roster_lock_take(root_dir: root_dir) {
          RosterLockRefused { reason: reason } => "CONTROL-FAIL stale: second acquire refused " + roster_refusal_text(reason: reason) + "\n"
          RosterLockAcquired { held: second } =>
            if !Filesystem.WriteCreateNew(path: root_dir + "/" + target, content: before).success {
              "CONTROL-FAIL stale: scratch target could not be created\n"
            } else {
              let refused = roster_apply_edit(
                held: first,
                path: target,
                before: before,
                outcome: roster_control_valid_edit(module_name: "c.stale")
              )
              let after = Filesystem.Read(path: root_dir + "/" + target)
              let removed = Filesystem.Delete(path: root_dir + "/" + target)
              let stale_release = roster_lock_release(held: first)
              let released = roster_lock_release(held: second)
              if first.nonce == second.nonce {
                "CONTROL-FAIL stale: two acquisitions shared a nonce\n"
              } else if refused != roster_refuse_row(path: target, reason: RefusalLockNotHeld) {
                "CONTROL-FAIL stale: got " + refused
              } else if !after.success || after.content != before {
                "CONTROL-FAIL stale: a stale token changed the target\n"
              } else if stale_release || !released {
                "CONTROL-FAIL stale: a stale token released the current holder's lock\n"
              } else {
                ""
              }
            }
        }
      }
  }
}

fn roster_control_contend(root_dir: String) -> String {
  match roster_lock_take(root_dir: root_dir) {
    RosterLockRefused { reason: reason } => "CONTROL-FAIL contend: first acquire refused " + roster_refusal_text(reason: reason) + "\n"
    RosterLockAcquired { held: held } => {
      let second = match roster_lock_take(root_dir: root_dir) {
        RosterLockRefused { reason: reason } => roster_refusal_text(reason: reason)
        RosterLockAcquired { held: _ } => "acquired"
      }
      let released = roster_lock_release(held: held)
      if second == "apply-lock-unavailable" && released { "" } else { "CONTROL-FAIL contend: second acquire answered " + second + "\n" }
    }
  }
}

fn roster_control_traversal(root_dir: String) -> String {
  match roster_lock_take(root_dir: root_dir) {
    RosterLockRefused { reason: reason } => "CONTROL-FAIL traversal: acquire refused " + roster_refusal_text(reason: reason) + "\n"
    RosterLockAcquired { held: held } => {
      let edit = roster_control_valid_edit(module_name: "c.traversal")
      let source = roster_control_source(module_name: "c.traversal")
      let up = roster_apply_edit(held: held, path: "../roster_control_outside.dag", before: source, outcome: edit)
      let abs = roster_apply_edit(held: held, path: "/tmp/roster_control_outside.dag", before: source, outcome: edit)
      let made = Filesystem.Read(path: root_dir + "/../roster_control_outside.dag")
      let released = roster_lock_release(held: held)
      if up == roster_refuse_row(path: "../roster_control_outside.dag", reason: RefusalPathOutsideRoot) && abs == roster_refuse_row(path: "/tmp/roster_control_outside.dag", reason: RefusalPathOutsideRoot) && !made.success && released {
        ""
      } else {
        "CONTROL-FAIL traversal: got " + up + abs
      }
    }
  }
}

fn roster_control_spellings(root_dir: String) -> String {
  let top = git.Inspect.Toplevel().path as String
  let scratch = match roster_lock_acquire(root_dir: root_dir) {
    RosterLockRefused { reason: reason } => roster_refusal_text(reason: reason)
    RosterLockAcquired { held: _ } => "acquired"
  }
  let sub = match roster_lock_acquire(root_dir: top + "/src") {
    RosterLockRefused { reason: reason } => roster_refusal_text(reason: reason)
    RosterLockAcquired { held: _ } => "acquired"
  }
  let lock_made = Filesystem.Read(path: roster_lock_file(root: root_dir))
  if scratch == "root-not-git-toplevel" && sub == "root-not-git-toplevel" && !lock_made.success && !roster_root_admitted(root_dir: "relative/dir") && !roster_root_admitted(root_dir: "/a/../b") && !roster_root_admitted(root_dir: "/a//b") && roster_root_admitted(root_dir: "/a/b") {
    ""
  } else {
    "CONTROL-FAIL spellings: scratch answered " + scratch + ", subdirectory answered " + sub + "\n"
  }
}

fn zz_w2_fixture() -> String {
  "module w2.fixture\n\nimport std.algebra { Empty }\n\nfn f(xs: List<Int>) -> List<Int> {\n  xs\n}\n"
}

fn zz_w2_probe_exit() -> ProcessExit {
  let text = zz_w2_fixture()
  match dag_prepared_grammar() {
    Rejected { diagnostics: _ } => exit_failure(reason: "W2 grammar")
    Accepted { value: prepared, diagnostics: _ } =>
      let lex = dag_prepared_lex()
      match tokenize_prepared(text: text, file: symbol_intern_lexeme(lexeme: "w2.dag"), prepared: lex) {
        Rejected { diagnostics: _ } => exit_failure(reason: "W2 tokenize")
        Accepted { value: stream, diagnostics: _ } =>
          match parse_module_prepared(tokens: stream, prepared: prepared) {
            Rejected { diagnostics: _ } => exit_failure(reason: "W2 parse")
            Accepted { value: artifact, diagnostics: _ } =>
              match normalize_with(parse_tree: artifact.tree, source: NormalizeWithIsolatedAllocator, spans: artifact.span_index) {
                Rejected { diagnostics: _ } => exit_failure(reason: "W2 normalize")
                Accepted { value: scoped, diagnostics: _ } =>
                  let sites = collect_scoped_module_reference_sites(root: scoped.tree.root, imported: list_map(xs: scoped.tree.import_bindings, f: fn(b) { b.binding })).sites
                  let spelled = fold_list(xs: sites, empty: 0, cons: fn(n, st) { if roster_spelling_is(qn: st.site.spelling, call: "List") { n + 1 } else { n } })
                  let free = roster_sites_count(sites: sites, call: "List")
                  let heads = fold_list(xs: sites, empty: "", cons: fn(acc, st) { if roster_spelling_is(qn: st.site.spelling, call: "List") { acc + " [" + zz_head_name(head: st.head) + " path=" + roster_join(xs: list_map(xs: st.site.position, f: fn(l) { symbol_lexeme(sym: label_sort_key(label: l)) }), sep: "/") + " pos=" + zz_pos_name(p: reference_position_of(position: st.site.position)) + " free=" + (if roster_head_is_free(head: st.head, imported_from_home: false) { "yes" } else { "no" }) + "]" } else { acc } })
                  let outcome = roster_render_outcome(path: "w2.dag", outcome: roster_sweep_text_scoped(path: "w2.dag", text: text, prepared: prepared, lex: lex, scope: OneHome { home: qualified_name_from_dotted_string(dotted: "std.types") }))
                  exit_failure(reason: "W2 sites_total=" + int_to_decimal_string(value: length(xs: sites)) + " list_sites=" + int_to_decimal_string(value: spelled) + " list_free=" + int_to_decimal_string(value: free) + " heads=" + heads + " outcome=[" + outcome + "]")
              }
          }
      }
  }
}

fn zz_head_name(head: SiteHeadBinding) -> String {
  match head {
    HeadLexicallyUnbound => "unbound"
    HeadBindingUndecided => "undecided"
    HeadBoundAtRootValue => "root-value"
    HeadBoundInFrame => "in-frame"
    HeadNotAValuePosition => "not-value-position"
  }
}

fn zz_pos_name(p: ReferencePosition) -> String {
  match p {
    ValuePosition => "value"
    TypeAnnotationPosition => "type-annotation"
    LabelPosition => "label"
    PatternTagPosition => "pattern-tag"
  }
}
