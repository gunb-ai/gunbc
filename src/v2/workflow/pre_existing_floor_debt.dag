module v2.workflow.pre_existing_floor_debt

import v2.std.algebra { Cons, Empty, list_flat_map, list_map }
import v2.std.collection { List }
import v2.std.text { String }

// Newly visible, pre-existing witness debt exposed by removing DeclinedLiveTree.
//
// This is an identity-grain inventory, not an expected-red roster. Fails means the witness
// reached its assertion and answered false. Throws means it produced no verdict. The required
// floor discovers the observed population independently, joins it to these rows, and refuses
// both directions: an unlisted failure/throw is growth; a row whose identity no longer exhibits
// its authored disposition is spent and must be deleted. The terminal state is an empty roster.
type PreExistingFloorDebtDisposition =
    Fails
  | Throws

type PreExistingFloorDebtRow {
  identity: String,
  disposition: PreExistingFloorDebtDisposition,
}

