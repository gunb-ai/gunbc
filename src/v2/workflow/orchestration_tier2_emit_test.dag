fn decide_verdict_procedure_body() -> v2.std.orchestration.Pipeline {
  v2.std.orchestration.Pipeline {
    steps: [
      v2.std.orchestration.If {
        cond: v2.std.orchestration.StrEmpty { operand: "\"$1\"" },
        then_: v2.std.orchestration.Pipeline {
          steps: [v2.std.orchestration.Let { name: "verdict", value: v2.std.orchestration.ExprLit { spelling: "absent" } }],
          on_failure: FailFast
        },
        else_: v2.std.optional.Absent
      }
    ],
    on_failure: FailFast
  }
}

fn decide_verdict_procedure_intent() -> v2.std.orchestration.Procedure {
  v2.std.orchestration.Procedure { name: "decide_verdict", body: decide_verdict_procedure_body() }
}

fn decide_verdict_procedure_partial_golden() -> String {
  "decide_verdict() {\n  if [ -z \"$1\" ]; then verdict=absent; fi\n}"
}

test fn orch_tier2_procedure_definition_band_holds() -> Bool {
  match orch_emit_procedure(
    proc: decide_verdict_procedure_intent(),
    medium: bash_orchestration_emit_medium()
  ) {
    Accepted { value: src, diagnostics: dg } =>
      (src.carried == decide_verdict_procedure_partial_golden()) && (dg == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_tier2_cmdsubst_assign_has_teeth_holds() -> Bool {
