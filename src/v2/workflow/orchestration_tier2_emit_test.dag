module v2.workflow.orchestration_tier2_emit_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data orch_tier2_golden_note: String = "Goldens below are hand-authored bytes from fleet_converge_emit.dag converge_gunbc_pinned_tree fresh_standup arm ONLY (docs/plans/shell-to-dag-residual-census-and-arc-completion.md §1B frontier rows). Ubuntu-media for/heredoc sites are EXCLUDED per purity-trap fence (FLAG B1). Each test compares emit against its golden independently of the grammar rows."

fn fresh_standup_cmdsubst_assign_intent() -> v2.std.orchestration.PipelineStep {
  v2.std.orchestration.Let {
    name: "dag_pin",
    value: v2.std.orchestration.ExprCmdSubst {
      callee: "converge_read_gunbc_host_pin",
      args: ["\"$checkout\""]
    }
  }
}

fn fresh_standup_cmdsubst_assign_golden() -> String {
  "dag_pin=\"$(converge_read_gunbc_host_pin \"$checkout\")\""
}

test fn orch_tier2_fresh_standup_cmdsubst_assign_holds() -> Bool {
  match orch_emit_step(
    s: fresh_standup_cmdsubst_assign_intent(),
    medium: bash_orchestration_emit_medium()
  ) {
    Accepted { value: src, diagnostics: dg } =>
      (src.carried == fresh_standup_cmdsubst_assign_golden()) && (dg == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

fn fresh_standup_decide_verdict_call_intent() -> v2.std.orchestration.PipelineStep {
  v2.std.orchestration.Call {
    callee: "decide_verdict",
    args: ["\"$dag_pin\"", "\"$desired_pin\""]
  }
}

fn fresh_standup_decide_verdict_call_golden() -> String {
  "decide_verdict \"$dag_pin\" \"$desired_pin\""
}

test fn orch_tier2_fresh_standup_procedure_call_holds() -> Bool {
  match orch_emit_step(
    s: fresh_standup_decide_verdict_call_intent(),
    medium: bash_orchestration_emit_medium()
  ) {
    Accepted { value: src, diagnostics: dg } =>
      (src.carried == fresh_standup_decide_verdict_call_golden()) && (dg == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

