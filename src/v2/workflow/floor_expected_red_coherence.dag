module v2.workflow.floor_expected_red_coherence


// AUTHORED-VS-EVALUATED COHERENCE for a chunk/aggregator/roster roster shape such as
// floor_expected_red.dag's. #8437 severed one chunk out of the std.algebra.Cons chain that links
// chunk_NN() calls into the aggregator: the chunk still authored its identities, the
// aggregator stayed well-formed, and the roster stayed non-empty, so nothing observed
// that identities had silently stopped being evaluated. This module reads the SAME
// declaration facts the corpus already exposes and asserts two things a hand-authored
// Cons chain cannot assert of itself: every identity a chunk body authors is present
// in the evaluated roster, and every declared chunk function is actually called from
// the aggregator body — both at identity/lexeme grain, never by count.

// A single declared chunk to check: its fully qualified decl-fact lookup key, and the
// short identifier spelling the aggregator body must contain if the chunk is linked.
type ChunkDeclRef {
  qualified_name: String
  short_name: String
}

type ChunkCoherenceRefusal
  = ChunkDeclarationUnresolved { qualified_name: String, resolution: v2.std.decl_facts_skeleton.DeclFactQualifiedNameResolution }
  | AggregatorDeclarationUnresolved { qualified_name: String, resolution: v2.std.decl_facts_skeleton.DeclFactQualifiedNameResolution }
  | ChunkNotLinkedIntoAggregator { chunk_qualified_name: String, chunk_short_name: String, aggregator_qualified_name: String }
  | AuthoredIdentityMissingFromRoster { identity: String, source_chunk_qualified_name: String, message: String }
  | RosterIdentityMissingFromAuthoredChunks { identity: String, message: String }

type ChunkCoherenceVerdict
  = ChunkCoherenceCoherent { checked_chunk_count: Int, checked_identity_count: Int }
  | ChunkCoherenceRefused { causes: List<ChunkCoherenceRefusal> }

// The refusal message a maintainer meets when a chunk body authors an identity the
// evaluated roster does not contain. It names WHY the mismatch is dangerous to paper
// over and WHERE the real fix belongs, so the cheapest available reaction is not an
// exclusion list re-inventing the lexeme-shape heuristic this derivation was built to
// avoid (DESIGN §4/§5).
fn authored_identity_missing_from_roster_message(identity: String, source_chunk_qualified_name: String) -> String {
  concat(
    "identity '",
    concat(
      identity,
      concat(
        "' is authored inside ",
        concat(
          source_chunk_qualified_name,
          " but does not appear in the evaluated roster. If this is not an authored roster identity, the chunk body v2.std.algebra.contains a construction that v2.std.decl_facts_skeleton.node_skeleton_authored_non_construction_atom_lexemes does not yet model as a non-authored atom kind (a call, a parameter reference, a nullary-variant-value binding, or similar) -- the fix is to model that atom kind at that derivation, in decl_facts_skeleton.dag, NOT to add an exclusion lexeme here or anywhere else. An exclusion list is exactly the lexeme-shape heuristic this check exists to avoid, reintroduced one identity at a time by whoever meets this refusal next."
        )
      )
    )
  )
}

fn roster_identity_missing_from_authored_chunks_message(identity: String) -> String {
  concat(
    "identity '",
    concat(
      identity,
      "' is present in the evaluated roster but was not found authored in any checked chunk body. Either the checked chunk-declaration roster passed to this check is incomplete (a chunk exists that this call site did not enumerate), or the roster is built from something other than the chunk bodies this check was told to read -- widen the checked chunk-declaration list to match, do not weaken this side of the comparison."
    )
  )
}

fn chunk_short_name_linked(node: v2.std.node.Node, chunk: ChunkDeclRef) -> Bool {
  v2.std.decl_facts_skeleton.skeleton_contains_marshal_atom_lexeme(node: node, lexeme: chunk.short_name)
}

fn chunk_authored_identities_against_roster(
  node: v2.std.node.Node,
  chunk: ChunkDeclRef,
  roster: List<String>
) -> List<ChunkCoherenceRefusal> {
  let authored = v2.std.decl_facts_skeleton.node_skeleton_authored_non_construction_atom_lexemes(node: node)
  v2.std.algebra.list_reverse(xs: fold(authored, init: std.algebra.Empty, f: fn(acc, identity) {
    if v2.std.algebra.contains(xs: roster, item: identity, eq: fn(a, b) { a == b }) {
      acc
    } else {
      std.algebra.Cons {
        head: AuthoredIdentityMissingFromRoster {
          identity: identity,
          source_chunk_qualified_name: chunk.qualified_name,
          message: authored_identity_missing_from_roster_message(
            identity: identity,
            source_chunk_qualified_name: chunk.qualified_name
          )
        },
        tail: acc
      }
    }
  }))
}

fn all_checked_chunk_authored_identities(
  facts: List<v2.std.decl_index.DeclFact>,
  chunks: List<ChunkDeclRef>
) -> List<String> {
  v2.std.algebra.list_reverse(xs: fold(chunks, init: std.algebra.Empty, f: fn(acc, chunk) {
    let resolution = v2.std.decl_facts_skeleton.resolve_decl_fact_by_qualified_name(facts: facts, qn: chunk.qualified_name)
    match v2.std.decl_facts_skeleton.decl_fact_skeleton_for_resolution(resolution: resolution) {
      v2.std.optional.Present { value: node } =>
        fold(v2.std.decl_facts_skeleton.node_skeleton_authored_non_construction_atom_lexemes(node: node), init: acc, f: fn(inner_acc, identity) {
          if v2.std.algebra.contains(xs: inner_acc, item: identity, eq: fn(a, b) { a == b }) {
            inner_acc
          } else {
            std.algebra.Cons { head: identity, tail: inner_acc }
          }
        })
      v2.std.optional.Absent => acc
    }
  }))
}

fn roster_identities_missing_from_authored_chunks(
  facts: List<v2.std.decl_index.DeclFact>,
  chunks: List<ChunkDeclRef>,
  roster: List<String>
) -> List<ChunkCoherenceRefusal> {
  let union_authored = all_checked_chunk_authored_identities(facts: facts, chunks: chunks)
  v2.std.algebra.list_reverse(xs: fold(roster, init: std.algebra.Empty, f: fn(acc, identity) {
    if v2.std.algebra.contains(xs: union_authored, item: identity, eq: fn(a, b) { a == b }) {
      acc
    } else {
      std.algebra.Cons {
        head: RosterIdentityMissingFromAuthoredChunks {
          identity: identity,
          message: roster_identity_missing_from_authored_chunks_message(identity: identity)
        },
        tail: acc
      }
    }
  }))
}

// Fail-closed by construction: an unresolved chunk or aggregator declaration is a
// refusal in its own right, never treated as "no identities to check" (the
// empty-observation narrow DESIGN §5 forbids) and never silently skipped.
//
// SCOPE, stated positively rather than as a dissolution condition (this is a
// permanent property of the check, not debt with a lifecycle): this function is
// complete for the chunks it is GIVEN via the `chunks` parameter. The caller
// decides which declarations count as chunks and enumerates them by hand -- there
// is no derivation of "which functions are chunks" from decl_facts alone, because
// that would require a naming-convention heuristic over declaration names, which
// is the same class of shape-based inference DESIGN §4 forbids for atom lexemes
// (the substrate has no closed vocabulary that marks "chunk" as a structural
// property; it is a role the caller assigns).
//
// BLIND SPOT this scope creates, named rather than left implicit: a chunk that is
// declared in the checked module (e.g. floor_expected_red.dag) but is absent from
// the call site's `chunks: List<ChunkDeclRef>` roster is invisible to this check --
// it is not one of the `facts` this function ever resolves, so it can neither
// contribute a cause nor be reported missing. Such an omission returns
// ChunkCoherenceCoherent exactly as if the chunk had never existed, which is the
// same empty-observation-narrow shape (DESIGN's "Recurring failure modes") the
// severed-aggregator RED above exists to catch, now sitting one level up at the
// call site instead of inside the aggregator body. Closing it would mean deriving
// the chunk roster from decl_facts instead of taking it as a parameter -- and
// deriving it without a naming heuristic requires the same fresh whole-module
// decl_facts parse the live join already needs (see
// live_floor_expected_red_coherence_join_gap_note below: verifying a caller's
// roster against floor_expected_red.dag's actual declarations costs the identical
// ~56s parse as verifying the roster's identities do, because both need decl_facts
// over the same pool root). So this is not a second, separate gap with its own
// cheaper fix -- it is the same live-join gap, restated from the roster-omission
// angle rather than the roster-content angle, and it dissolves with that work's
// preparation-time consumer, not separately.
fn floor_expected_red_chunk_coherence_check(
  facts: List<v2.std.decl_index.DeclFact>,
  chunks: List<ChunkDeclRef>,
  aggregator_qualified_name: String,
  evaluated_roster: List<String>
) -> ChunkCoherenceVerdict {
  let aggregator_resolution = v2.std.decl_facts_skeleton.resolve_decl_fact_by_qualified_name(facts: facts, qn: aggregator_qualified_name)
  let aggregator_causes = match aggregator_resolution {
    DeclFactResolvedUnique { fact: _ } => std.algebra.Empty
    _ => std.algebra.Cons {
      head: AggregatorDeclarationUnresolved { qualified_name: aggregator_qualified_name, resolution: aggregator_resolution },
      tail: std.algebra.Empty
    }
  }

  let per_chunk_causes = v2.std.algebra.list_reverse(xs: fold(chunks, init: std.algebra.Empty, f: fn(acc, chunk) {
    let resolution = v2.std.decl_facts_skeleton.resolve_decl_fact_by_qualified_name(facts: facts, qn: chunk.qualified_name)
    match v2.std.decl_facts_skeleton.decl_fact_skeleton_for_resolution(resolution: resolution) {
      v2.std.optional.Absent =>
        std.algebra.Cons {
          head: ChunkDeclarationUnresolved { qualified_name: chunk.qualified_name, resolution: resolution },
          tail: acc
        }
      v2.std.optional.Present { value: chunk_node } => {
        let identity_causes = chunk_authored_identities_against_roster(node: chunk_node, chunk: chunk, roster: evaluated_roster)
        let link_causes = match v2.std.decl_facts_skeleton.decl_fact_skeleton_for_resolution(resolution: aggregator_resolution) {
          v2.std.optional.Present { value: aggregator_node } =>
            if chunk_short_name_linked(node: aggregator_node, chunk: chunk) {
              std.algebra.Empty
            } else {
              std.algebra.Cons {
                head: ChunkNotLinkedIntoAggregator {
                  chunk_qualified_name: chunk.qualified_name,
                  chunk_short_name: chunk.short_name,
                  aggregator_qualified_name: aggregator_qualified_name
                },
                tail: std.algebra.Empty
              }
            }
          v2.std.optional.Absent => std.algebra.Empty
        }
        v2.std.algebra.list_append(left: identity_causes, right: v2.std.algebra.list_append(left: link_causes, right: acc))
      }
    }
  }))

  let roster_causes = roster_identities_missing_from_authored_chunks(facts: facts, chunks: chunks, roster: evaluated_roster)

  let all_causes = v2.std.algebra.list_append(left: aggregator_causes, right: v2.std.algebra.list_append(left: per_chunk_causes, right: roster_causes))
  if v2.std.algebra.length(xs: all_causes) > 0 {
    ChunkCoherenceRefused { causes: all_causes }
  } else {
    ChunkCoherenceCoherent {
      checked_chunk_count: v2.std.algebra.length(xs: chunks),
      checked_identity_count: v2.std.algebra.length(xs: evaluated_roster)
    }
  }
}

// MECHANISM ON FIXTURES, per the decomposition rule witness_deferral_freeze_witness_note
// already states for this exact situation: a corpus census may be irreducible but a
// mechanism never is. This module's fixture-scale witnesses
// (dag/test/claim/floor_expected_red_coherence_witness_test.dag) are the complete,
// permanent evidence for floor_expected_red_chunk_coherence_check itself: they are
// cheap, they execute every PR, and they discriminate the #8437 incident shape (a
// severed chunk still authoring identities into a well-formed, non-empty roster).
// The mechanism is finished, not deferred -- there is no dissolution condition here
// because the fixture witnesses are not scaffolding for a later replacement; per
// DESIGN §4b a climb deletes redundant lower-rung PRODUCTION machinery and never the
// evidence, so these RED controls stay enrolled exactly as they are even after a live
// census exists on top of them.
data floor_expected_red_chunk_coherence_check_note: String = "MECHANISM ON FIXTURES: floor_expected_red_chunk_coherence_check is proven by execution against planted rosters in dag/test/claim/floor_expected_red_coherence_witness_test.dag -- a severed-aggregator RED, its cause-naming RED siblings, and a linked-chunks-only positive control. That is the complete claim this module makes about the mechanism; it is not partial."

// SEPARATE, PRE-EXISTING, UNOWNED OBLIGATION -- not debt this module introduces.
// Folding floor_expected_red.dag's own real 20 chunks through the same check is a
// distinct, much larger claim: it requires a fresh
// decl_facts(pool_roots: ["src/v2/workflow"]) parse (measured: ~56s process wall,
// dominated by the parse itself, ~36x the 1552ms per-PR floor ceiling), so per
// DESIGN §5/§6 that cost may not be paid inside an ordinary per-PR claim, in
// test/claim/long/ without cadence enrollment, or as an unenrolled-but-honest
// UnexecutedDeferredWitness record (the gunbc#7762 shape). Before this module
// existed, nothing in the tree could see a severed aggregator at all; after it,
// strictly more of the #8437 incident shape is covered than before -- this is a
// partial fix of a gap that predates this module, not an introduction of new debt,
// so no admission verdict is owed for it (AcknowledgePreexistingDebt, DESIGN
// 2026-08-10). The live join's natural home is where its cost is already paid: the
// required-floor run resolves the whole corpus during preparation before any claim
// executes, so re-deriving decl_facts fresh inside a claim duplicates work the floor
// has already done -- the #8470 shape one level up. Building that preparation-time
// consumer is its own future work item with its own owner, not a continuation of
// this one.
data live_floor_expected_red_coherence_join_gap_note: String = "PRE-EXISTING, UNOWNED GAP (not this module's debt): the live join of floor_expected_red.dag's own 20 chunks against its own evaluated roster is not a per-PR witness in floor_expected_red_coherence_witness_test.dag, and was not checkable by anything before this module existed either. This single gap has two faces, not two gaps: a checked chunk's identities may drift from the roster (the content face, this note's original subject), and a chunk may be missing from the caller's ChunkDeclRef roster entirely (the omission face, named on floor_expected_red_chunk_coherence_check's own SCOPE comment) -- closing either face requires the identical fresh decl_facts parse over floor_expected_red.dag's module, so one preparation-time consumer closes both. See floor_expected_red_chunk_coherence_check_note and the comment above it for why the mechanism itself is complete, and for the measured cost and natural home (a required-floor preparation-time consumer) of the still-open live-census gap."
