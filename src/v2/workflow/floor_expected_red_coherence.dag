module v2.workflow.floor_expected_red_coherence

import std.dissolution { DissolutionCondition, unbound_dissolution }
import std.types { Bool, List, String }
import v2.std.algebra { Cons, Empty, contains, fold_list_right, length, list_reverse }
import v2.std.decl_facts_skeleton {
  DeclFactQualifiedNameResolution,
  DeclFactResolvedAmbiguous,
  DeclFactResolvedMissing,
  DeclFactResolvedUnique,
  decl_fact_skeleton_for_resolution,
  node_skeleton_authored_non_construction_atom_lexemes,
  resolve_decl_fact_by_qualified_name,
  skeleton_contains_marshal_atom_lexeme,
}
import v2.std.collection { Absent, Present }
import v2.std.decl_index { DeclFact }
import v2.std.node { Node }

// AUTHORED-VS-EVALUATED COHERENCE for a chunk/aggregator/roster roster shape such as
// floor_expected_red.dag's. #8437 severed one chunk out of the Cons chain that links
// chunk_NN() calls into the aggregator: the chunk still authored its identities, the
// aggregator stayed well-formed, and the roster stayed non-empty, so nothing observed
// that identities had silently stopped being evaluated. This module reads the SAME
// declaration facts the corpus already exposes and asserts two things a hand-authored
// Cons chain cannot assert of itself: every identity a chunk body authors is present
// in the evaluated roster, and every declared chunk function is actually called from
// the aggregator body — both at identity/lexeme grain, never by count.

// A single declared chunk to check: its fully qualified decl-fact lookup key, and the
// short identifier spelling the aggregator body must contain if the chunk is linked.
type ChunkDeclRef {
  qualified_name: String
  short_name: String
}

type ChunkCoherenceRefusal
  = ChunkDeclarationUnresolved { qualified_name: String, resolution: DeclFactQualifiedNameResolution }
  | AggregatorDeclarationUnresolved { qualified_name: String, resolution: DeclFactQualifiedNameResolution }
  | ChunkNotLinkedIntoAggregator { chunk_qualified_name: String, chunk_short_name: String, aggregator_qualified_name: String }
  | AuthoredIdentityMissingFromRoster { identity: String, source_chunk_qualified_name: String, message: String }
  | RosterIdentityMissingFromAuthoredChunks { identity: String, message: String }

type ChunkCoherenceVerdict
  = ChunkCoherenceCoherent { checked_chunk_count: Int, checked_identity_count: Int }
  | ChunkCoherenceRefused { causes: List<ChunkCoherenceRefusal> }

// The refusal message a maintainer meets when a chunk body authors an identity the
// evaluated roster does not contain. It names WHY the mismatch is dangerous to paper
// over and WHERE the real fix belongs, so the cheapest available reaction is not an
// exclusion list re-inventing the lexeme-shape heuristic this derivation was built to
// avoid (DESIGN §4/§5).
fn authored_identity_missing_from_roster_message(identity: String, source_chunk_qualified_name: String) -> String {
  concat(
    "identity '",
    concat(
      identity,
      concat(
        "' is authored inside ",
        concat(
          source_chunk_qualified_name,
          " but does not appear in the evaluated roster. If this is not an authored roster identity, the chunk body contains a construction that v2.std.decl_facts_skeleton.node_skeleton_authored_non_construction_atom_lexemes does not yet model as a non-authored atom kind (a call, a parameter reference, a nullary-variant-value binding, or similar) -- the fix is to model that atom kind at that derivation, in decl_facts_skeleton.dag, NOT to add an exclusion lexeme here or anywhere else. An exclusion list is exactly the lexeme-shape heuristic this check exists to avoid, reintroduced one identity at a time by whoever meets this refusal next."
        )
      )
    )
  )
}

fn roster_identity_missing_from_authored_chunks_message(identity: String) -> String {
  concat(
    "identity '",
    concat(
      identity,
      "' is present in the evaluated roster but was not found authored in any checked chunk body. Either the checked chunk-declaration roster passed to this check is incomplete (a chunk exists that this call site did not enumerate), or the roster is built from something other than the chunk bodies this check was told to read -- widen the checked chunk-declaration list to match, do not weaken this side of the comparison."
    )
  )
}

fn list_append(a: List<ChunkCoherenceRefusal>, b: List<ChunkCoherenceRefusal>) -> List<ChunkCoherenceRefusal> {
  fold_list_right(xs: a, empty: b, snoc: fn(acc, item) { Cons { head: item, tail: acc } })
}

fn chunk_short_name_linked(node: Node, chunk: ChunkDeclRef) -> Bool {
  skeleton_contains_marshal_atom_lexeme(node: node, lexeme: chunk.short_name)
}

fn chunk_authored_identities_against_roster(
  node: Node,
  chunk: ChunkDeclRef,
  roster: List<String>
) -> List<ChunkCoherenceRefusal> {
  let authored = node_skeleton_authored_non_construction_atom_lexemes(node: node)
  list_reverse(xs: fold(authored, init: Empty, f: fn(acc, identity) {
    if contains(xs: roster, item: identity, eq: fn(a, b) { a == b }) {
      acc
    } else {
      Cons {
        head: AuthoredIdentityMissingFromRoster {
          identity: identity,
          source_chunk_qualified_name: chunk.qualified_name,
          message: authored_identity_missing_from_roster_message(
            identity: identity,
            source_chunk_qualified_name: chunk.qualified_name
          )
        },
        tail: acc
      }
    }
  }))
}

fn all_checked_chunk_authored_identities(
  facts: List<DeclFact>,
  chunks: List<ChunkDeclRef>
) -> List<String> {
  list_reverse(xs: fold(chunks, init: Empty, f: fn(acc, chunk) {
    let resolution = resolve_decl_fact_by_qualified_name(facts: facts, qn: chunk.qualified_name)
    match decl_fact_skeleton_for_resolution(resolution: resolution) {
      Present { value: node } =>
        fold(node_skeleton_authored_non_construction_atom_lexemes(node: node), init: acc, f: fn(inner_acc, identity) {
          if contains(xs: inner_acc, item: identity, eq: fn(a, b) { a == b }) {
            inner_acc
          } else {
            Cons { head: identity, tail: inner_acc }
          }
        })
      Absent => acc
    }
  }))
}

fn roster_identities_missing_from_authored_chunks(
  facts: List<DeclFact>,
  chunks: List<ChunkDeclRef>,
  roster: List<String>
) -> List<ChunkCoherenceRefusal> {
  let union_authored = all_checked_chunk_authored_identities(facts: facts, chunks: chunks)
  list_reverse(xs: fold(roster, init: Empty, f: fn(acc, identity) {
    if contains(xs: union_authored, item: identity, eq: fn(a, b) { a == b }) {
      acc
    } else {
      Cons {
        head: RosterIdentityMissingFromAuthoredChunks {
          identity: identity,
          message: roster_identity_missing_from_authored_chunks_message(identity: identity)
        },
        tail: acc
      }
    }
  }))
}

// Fail-closed by construction: an unresolved chunk or aggregator declaration is a
// refusal in its own right, never treated as "no identities to check" (the
// empty-observation narrow DESIGN §5 forbids) and never silently skipped.
fn floor_expected_red_chunk_coherence_check(
  facts: List<DeclFact>,
  chunks: List<ChunkDeclRef>,
  aggregator_qualified_name: String,
  evaluated_roster: List<String>
) -> ChunkCoherenceVerdict {
  let aggregator_resolution = resolve_decl_fact_by_qualified_name(facts: facts, qn: aggregator_qualified_name)
  let aggregator_causes = match aggregator_resolution {
    DeclFactResolvedUnique { fact: _ } => Empty
    _ => Cons {
      head: AggregatorDeclarationUnresolved { qualified_name: aggregator_qualified_name, resolution: aggregator_resolution },
      tail: Empty
    }
  }

  let per_chunk_causes = list_reverse(xs: fold(chunks, init: Empty, f: fn(acc, chunk) {
    let resolution = resolve_decl_fact_by_qualified_name(facts: facts, qn: chunk.qualified_name)
    match decl_fact_skeleton_for_resolution(resolution: resolution) {
      Absent =>
        Cons {
          head: ChunkDeclarationUnresolved { qualified_name: chunk.qualified_name, resolution: resolution },
          tail: acc
        }
      Present { value: chunk_node } => {
        let identity_causes = chunk_authored_identities_against_roster(node: chunk_node, chunk: chunk, roster: evaluated_roster)
        let link_causes = match decl_fact_skeleton_for_resolution(resolution: aggregator_resolution) {
          Present { value: aggregator_node } =>
            if chunk_short_name_linked(node: aggregator_node, chunk: chunk) {
              Empty
            } else {
              Cons {
                head: ChunkNotLinkedIntoAggregator {
                  chunk_qualified_name: chunk.qualified_name,
                  chunk_short_name: chunk.short_name,
                  aggregator_qualified_name: aggregator_qualified_name
                },
                tail: Empty
              }
            }
          Absent => Empty
        }
        list_append(identity_causes, list_append(link_causes, acc))
      }
    }
  }))

  let roster_causes = roster_identities_missing_from_authored_chunks(facts: facts, chunks: chunks, roster: evaluated_roster)

  let all_causes = list_append(aggregator_causes, list_append(per_chunk_causes, roster_causes))
  if length(xs: all_causes) > 0 {
    ChunkCoherenceRefused { causes: all_causes }
  } else {
    ChunkCoherenceCoherent {
      checked_chunk_count: length(xs: chunks),
      checked_identity_count: length(xs: evaluated_roster)
    }
  }
}

data floor_expected_red_chunk_coherence_check_dissolve_on: DissolutionCondition = unbound_dissolution(description: "Dissolve-on: the checked ChunkDeclRef roster is authored at each call site (this module names no fixed chunk count). If floor_expected_red.dag's chunk count changes, the call site enumerating its 20 ChunkDeclRef rows must be updated by hand -- there is no derivation of 'which functions are chunks' from decl_facts alone, because that would require a naming-convention heuristic over declaration names, which is the same class of shape-based inference DESIGN §4 forbids for atom lexemes. Widens if a future consumer wants the chunk roster itself derived rather than declared.")

// OWED, deliberately not landed as a witness. This module's fixture-scale witnesses
// (dag/test/claim/floor_expected_red_coherence_witness_test.dag) are the whole
// per-PR claim: they are cheap, they execute every PR, and they discriminate the
// #8437 incident shape (a severed chunk still authoring identities into a
// well-formed, non-empty roster). Folding floor_expected_red.dag's own real 20
// chunks through this same check is a SEPARATE, much larger claim -- it requires a
// fresh decl_facts(pool_roots: ["src/v2/workflow"]) parse (measured: ~56s process
// wall, dominated by the parse itself, ~36x the 1552ms per-PR floor ceiling) -- and
// per DESIGN §5/§6 that cost may not be paid inside an ordinary per-PR claim, in
// test/claim/long/, or as an unenrolled-but-honest UnexecutedDeferredWitness record
// (the gunbc#7762 shape: a file retained, coverage deleted, admission still green).
// The live join belongs where its cost is already paid: the required-floor run
// already resolves the whole corpus during preparation (3662 modules on a recent
// run) before any claim executes, so re-deriving decl_facts fresh over 84 modules
// inside a claim duplicates work the floor has already done -- the #8470 shape one
// level up. Its future home is a check at that preparation-time corpus join, not a
// witness in this file. Dissolve-on: that preparation-time consumer exists and
// checks floor_expected_red.dag's real chunk/aggregator/roster triple against it.
data live_floor_expected_red_coherence_join_owed_note: String = "OWED: the live join of floor_expected_red.dag's own 20 chunks against its own evaluated roster is not a per-PR witness in floor_expected_red_coherence_witness_test.dag. It is deferred to a future consumer of the required-floor run's already-resolved whole-corpus decl_facts (the #8470 shape one level up), not re-derived fresh inside a claim. See this module's own dissolve-on note immediately above for the reasoning and the measured cost that ruled out landing it as a claim."
