module v2.workflow.realization_runner


type RunnerOrderingResult = RunnerOrderingOnly {}

data runner_ordering_only: RunnerOrderingResult = RunnerOrderingOnly {}

type NodeKeyedStoreEntry<V> {
  node: v2.std.node.Node
  value: V
}

type NodeKeyedStore<V> {
  entries: List<NodeKeyedStoreEntry<V>>
}

fn node_keyed_store_empty<V>() -> NodeKeyedStore<V> {
  NodeKeyedStore { entries: [] }
}

fn node_keyed_store_has_node<V>(store: NodeKeyedStore<V>, node: v2.std.node.Node) -> v2.std.logic.Bool {
  fold(store.entries, init: false, f: fn(found, entry) {
    found || (entry.node == node)
  })
}

fn node_keyed_store_put<V>(store: NodeKeyedStore<V>, node: v2.std.node.Node, value: V) -> NodeKeyedStore<V> {
  NodeKeyedStore {
    entries: list_snoc_item(
      xs: store.entries,
      item: NodeKeyedStoreEntry { node: node, value: value }
    )
  }
}

fn node_keyed_store_node_count<V>(store: NodeKeyedStore<V>) -> Int {
  fold(store.entries, init: 0, f: fn(count, _) { count + 1 })
}

data node_keyed_graph_artifact_note: String = "NodeKeyedGraphArtifact is the persistent/streamed form of NodeKeyedStore (the S2b store shape, landed early as the settled encoding authority — inherited from the S2a lane, bound 2026-07-10). CODEC RULING (settled): a tree codec over the Rc-shared graph un-shares every shared subtree — the resolved-graph cache write measured a ~3.4GiB working set expanding to 17GiB under serde_json::to_vec; serde-streaming and packed-binary-tree keep the unsharing, so both are WRONG. The artifact form is an interned content-keyed node table: each node encoded exactly ONCE, keyed by its content hash, children referenced BY HASH and never inline; a decode rebuilds the structural sharing. Witness homes, precisely: the SIZE/TOPOLOGY/REFUSAL witnesses (shared-row-counted-once with the tree-double-count RED, missing-ref refusals, interning check) execute in v2.test.claim.realization_runner_witness; the two SHARING witnesses are pointer-identity facts only a host realization can observe, so they executed in the seed test module src/v1/tests/src/node_keyed_graph_artifact_codec_test.rs, DELETED 2026-08-11 by the gunbc#8146 test-suite cutover — that module was gated by --no-run and never actually ran, so the sharing claims are now UNWITNESSED rather than newly so (decode-rebuilds-sharing via Rc ptr-eq with a deliberately unshared tree-decode RED control, and reencode-byte-identity). ROWS CARRY ROW-LOCAL FACTS ONLY (encoded body length): a stored transitive size would be a dual representation of the child_refs topology, so transitive footprint is DERIVED, never stored. The reachable-set fold node_keyed_graph_transitive_bytes IS the single value-size authority — the eval-memo byte-cap admission (extdeps.realization.eval_memo) and the space-lens predictor both bind to it, and no parallel size walk may exist anywhere. Content hashes ground on the fnv1a64 authority surfaced by std.content_hash / the v1 intrinsics (DESIGN section 3 convergence thread) — this schema must not mint a third hash surface; ContentHash here is the std.types carrier. Failure arms REFUSE, never widen: a child ref with no row refuses with the missing hash, never a fabricated size. The walk is fuel-bounded by row count and settles within the fuel by construction (each pass either visits a new interned row or empties the frontier — a visited ref is skipped, so even a cyclic row table converges to its reachable set); the Unsettled arm is the typed fail-closed backstop should that bound argument ever be violated, not a reachable state we can construct. Artifact well-formedness itself (interning — at most one row per hash — and acyclicity via child-before-parent row order) is the codec's obligation: node_keyed_graph_rows_interned checks the former, and the hash-consed single-pass decode refuses a forward or missing child ref, which makes an encoded cycle unrepresentable."

data node_keyed_graph_codec_seed_disposition: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.RealizationDispatch,
  bind: std.decl_ref.DeclarationRef {
    module_path: "v2.workflow.realization_runner",
    decl_name: "NodeKeyedGraphArtifact",
    field: std.decl_ref.WholeDeclaration
  }
}

data node_keyed_graph_codec_seed_note: String = "Seed-retained frontier row (DESIGN section 7: seed-retained = declared, with reason and migration trigger, never silent). The byte codec realizing NodeKeyedGraphArtifact — trait NodeKeyedGraphEncode plus node_keyed_graph_encode/node_keyed_graph_decode/node_keyed_graph_row_facts in src/v1/stage0/src/resolved_graph_cache.rs (hand-maintained registry), with its sharing witnesses formerly in src/v1/tests/src/node_keyed_graph_artifact_codec_test.rs (deleted 2026-08-11, gunbc#8146; unwitnessed pending a host surface that can observe rebuilt sharing) — is HOST RUST because it is realization, not model: byte-level IO plus Rc pointer identity, neither expressible in the substrate today (no bytes carrier; pointer sharing is a host-realization fact the model deliberately does not carry). Reason it exists at all: the tree-codec un-sharing defect at the resolved-graph cache write (3.4GiB working set -> 17GiB encode). Dissolution trigger, concrete: when the section-4 one-grammar-both-directions emission rows extend to a binary medium (a bytes carrier + extdeps/languages-style row table for this format), the kernel becomes row-derived emission dispatched from THIS schema (RealizationDispatch via the bound declaration) and the hand-Rust retires with the seed; the sharing witnesses migrate to whatever surface can then observe rebuilt sharing. Until that trigger, the kernel rides the resolved_graph_cache.rs hand-maintained registry row and this disposition is its count."

type NodeKeyedGraphRow {
  content_hash: std.content_hash.ContentHash
  encoded_length: std.measure.ByteSize
  child_refs: List<std.content_hash.ContentHash>
}

type NodeKeyedGraphArtifactEntry {
  store_node: std.content_hash.ContentHash
  value_root: std.content_hash.ContentHash
}

type NodeKeyedGraphArtifact {
  rows: List<NodeKeyedGraphRow>
  entries: List<NodeKeyedGraphArtifactEntry>
}

fn node_keyed_graph_contains_hash(hashes: List<std.content_hash.ContentHash>, content_hash: std.content_hash.ContentHash) -> v2.std.logic.Bool {
  contains(xs: hashes, item: content_hash, eq: fn(left, right) { left == right })
}

type NodeKeyedGraphInternCheck {
  seen: List<std.content_hash.ContentHash>
  interned: v2.std.logic.Bool
}

fn node_keyed_graph_rows_interned(rows: List<NodeKeyedGraphRow>) -> v2.std.logic.Bool {
  let checked = fold(rows, init: NodeKeyedGraphInternCheck { seen: [], interned: true }, f: fn(check, row) {
    if node_keyed_graph_contains_hash(hashes: check.seen, content_hash: row.content_hash) {
      NodeKeyedGraphInternCheck { seen: check.seen, interned: false }
    } else {
      NodeKeyedGraphInternCheck {
        seen: list_snoc_item(xs: check.seen, item: row.content_hash),
        interned: check.interned
      }
    }
  })
  checked.interned
}

fn node_keyed_graph_artifact_total_bytes(artifact: NodeKeyedGraphArtifact) -> std.measure.ByteSize {
  fold(artifact.rows, init: std.measure.byte_size(count: 0), f: fn(total, row) {
    std.measure.measure_add(a: total, b: row.encoded_length)
  })
}

type NodeKeyedGraphRowLookup
  = NodeKeyedGraphRowFound { row: NodeKeyedGraphRow }
  | NodeKeyedGraphRowMissing { content_hash: std.content_hash.ContentHash }

fn node_keyed_graph_row_lookup(rows: List<NodeKeyedGraphRow>, content_hash: std.content_hash.ContentHash) -> NodeKeyedGraphRowLookup {
  fold(rows, init: NodeKeyedGraphRowMissing { content_hash: content_hash }, f: fn(found, row) {
    match found {
      NodeKeyedGraphRowFound { row: _ } => found
      NodeKeyedGraphRowMissing { content_hash: wanted } =>
        if row.content_hash == wanted {
          NodeKeyedGraphRowFound { row: row }
        } else {
          found
        }
    }
  })
}

type NodeKeyedGraphReachState
  = NodeKeyedGraphReachActive {
      visited: List<std.content_hash.ContentHash>,
      frontier: List<std.content_hash.ContentHash>,
      bytes: std.measure.ByteSize
    }
  | NodeKeyedGraphReachMissingRow { missing: std.content_hash.ContentHash }

fn node_keyed_graph_reach_step(
  rows: List<NodeKeyedGraphRow>,
  state: NodeKeyedGraphReachState
) -> NodeKeyedGraphReachState {
  match state {
    NodeKeyedGraphReachMissingRow { missing: _ } => state
    NodeKeyedGraphReachActive { visited: visited, frontier: frontier, bytes: bytes } =>
      fold(frontier, init: NodeKeyedGraphReachActive { visited: visited, frontier: [], bytes: bytes }, f: fn(step_state, content_hash) {
        match step_state {
          NodeKeyedGraphReachMissingRow { missing: _ } => step_state
          NodeKeyedGraphReachActive { visited: seen, frontier: next, bytes: acc } =>
            if node_keyed_graph_contains_hash(hashes: seen, content_hash: content_hash) {
              step_state
            } else {
              match node_keyed_graph_row_lookup(rows: rows, content_hash: content_hash) {
                NodeKeyedGraphRowMissing { content_hash: missing } =>
                  NodeKeyedGraphReachMissingRow { missing: missing }
                NodeKeyedGraphRowFound { row: row } =>
                  NodeKeyedGraphReachActive {
                    visited: list_snoc_item(xs: seen, item: content_hash),
                    frontier: list_append(left: next, right: row.child_refs),
                    bytes: std.measure.measure_add(a: acc, b: row.encoded_length)
                  }
              }
            }
        }
      })
  }
}

type NodeKeyedGraphTransitiveBytes
  = NodeKeyedGraphTransitiveBytesSettled { bytes: std.measure.ByteSize }
  | NodeKeyedGraphTransitiveBytesMissingRow { missing: std.content_hash.ContentHash }
  | NodeKeyedGraphTransitiveBytesUnsettled { pending: List<std.content_hash.ContentHash> }

fn node_keyed_graph_transitive_bytes(
  artifact: NodeKeyedGraphArtifact,
  root: std.content_hash.ContentHash
) -> NodeKeyedGraphTransitiveBytes {
  let seeded = node_keyed_graph_reach_step(
    rows: artifact.rows,
    state: NodeKeyedGraphReachActive {
      visited: [],
      frontier: [root],
      bytes: std.measure.byte_size(count: 0)
    }
  )
  let walked = fold(artifact.rows, init: seeded, f: fn(state, _) {
    node_keyed_graph_reach_step(rows: artifact.rows, state: state)
  })
  match walked {
    NodeKeyedGraphReachMissingRow { missing: missing } =>
      NodeKeyedGraphTransitiveBytesMissingRow { missing: missing }
    NodeKeyedGraphReachActive { visited: _, frontier: frontier, bytes: bytes } =>
      if non_empty(xs: frontier) {
        NodeKeyedGraphTransitiveBytesUnsettled { pending: frontier }
      } else {
        NodeKeyedGraphTransitiveBytesSettled { bytes: bytes }
      }
  }
}

fn node_keyed_graph_entry_value_bytes(
  artifact: NodeKeyedGraphArtifact,
  entry: NodeKeyedGraphArtifactEntry
) -> NodeKeyedGraphTransitiveBytes {
  node_keyed_graph_transitive_bytes(artifact: artifact, root: entry.value_root)
}

fn runner_execution_dependencies(dependencies: List<v2.std.dependency.DependencyView>) -> List<v2.std.dependency.DependencyView> {
  scheduler_execution_dependencies(dependencies: dependencies)
}

fn runner_dependency_satisfied<V>(
  dependency: v2.std.dependency.DependencyView,
  store: NodeKeyedStore<V>,
  candidate: v2.std.node.Node
) -> v2.std.logic.Bool {
  if dependency.dependent == candidate {
    node_keyed_store_has_node(store: store, node: dependency.source)
  } else {
    true
  }
}

fn runner_node_ready<V>(
  dependencies: List<v2.std.dependency.DependencyView>,
  store: NodeKeyedStore<V>,
  candidate: v2.std.node.Node
) -> v2.std.logic.Bool {
  fold(dependencies, init: true, f: fn(ok, dependency) {
    ok && runner_dependency_satisfied(
      dependency: dependency,
      store: store,
      candidate: candidate
    )
  })
}

type RunnerBlockedEvidence
  = RunnerMissingDependency { node: v2.std.node.Node, prerequisite: v2.std.node.Node }
  | RunnerExecutorBlocked { evidence: v2.workflow.executor.ExecutorBlockedEvidence }

type RunnerMissingPrerequisite
  = RunnerPrerequisiteNotFoundYet {}
  | RunnerPrerequisiteMissing { node: v2.std.node.Node }

fn runner_first_missing_dependency<V>(
  dependencies: List<v2.std.dependency.DependencyView>,
  store: NodeKeyedStore<V>,
  candidate: v2.std.node.Node
) -> v2.std.node.Node {
  match fold(dependencies, init: RunnerPrerequisiteNotFoundYet {}, f: fn(found, dependency) {
    match found {
      RunnerPrerequisiteMissing { node: _ } => found
      RunnerPrerequisiteNotFoundYet {} =>
        if dependency.dependent == candidate {
          if node_keyed_store_has_node(store: store, node: dependency.source) {
            RunnerPrerequisiteNotFoundYet {}
          } else {
            RunnerPrerequisiteMissing { node: dependency.source }
          }
        } else {
          RunnerPrerequisiteNotFoundYet {}
        }
    }
  }) {
    RunnerPrerequisiteMissing { node: node } => node
    RunnerPrerequisiteNotFoundYet {} => candidate
  }
}

type RunnerDispatchOutcome<V>
  = RunnerDispatchOk { store: NodeKeyedStore<V> }
  | RunnerDispatchBlocked { evidence: RunnerBlockedEvidence }

fn runner_dispatch_job<V>(
  job: v2.workflow.executor.ExecutorJob,
  dependencies: List<v2.std.dependency.DependencyView>,
  store: NodeKeyedStore<V>,
  value: V
) -> RunnerDispatchOutcome<V> {
  if runner_node_ready(dependencies: dependencies, store: store, candidate: job.node) {
    RunnerDispatchOk {
      store: node_keyed_store_put(store: store, node: job.node, value: value)
    }
  } else {
    RunnerDispatchBlocked {
      evidence: RunnerMissingDependency {
        node: job.node,
        prerequisite: runner_first_missing_dependency(
          dependencies: dependencies,
          store: store,
          candidate: job.node
        )
      }
    }
  }
}

fn runner_dispatch_jobs<V>(
  jobs: List<v2.workflow.executor.ExecutorJob>,
  dependencies: List<v2.std.dependency.DependencyView>,
  store: NodeKeyedStore<V>,
  value: V
) -> RunnerDispatchOutcome<V> {
  fold(jobs, init: RunnerDispatchOk { store: store }, f: fn(outcome, job) {
    match outcome {
      RunnerDispatchOk { store: current } =>
        runner_dispatch_job(
          job: job,
          dependencies: dependencies,
          store: current,
          value: value
        )
      RunnerDispatchBlocked { evidence: evidence } =>
        RunnerDispatchBlocked { evidence: evidence }
    }
  })
}

fn runner_dispatch_batch<V>(
  batch: v2.workflow.executor.ExecutorBatch,
  dependencies: List<v2.std.dependency.DependencyView>,
  store: NodeKeyedStore<V>,
  value: V
) -> RunnerDispatchOutcome<V> {
  runner_dispatch_jobs(
    jobs: batch.jobs,
    dependencies: dependencies,
    store: store,
    value: value
  )
}

fn runner_walk_batches<V>(
  batches: List<v2.workflow.executor.ExecutorBatch>,
  dependencies: List<v2.std.dependency.DependencyView>,
  store: NodeKeyedStore<V>,
  value: V
) -> RunnerDispatchOutcome<V> {
  fold(batches, init: RunnerDispatchOk { store: store }, f: fn(outcome, batch) {
    match outcome {
      RunnerDispatchOk { store: current } =>
        runner_dispatch_batch(
          batch: batch,
          dependencies: dependencies,
          store: current,
          value: value
        )
      RunnerDispatchBlocked { evidence: evidence } =>
        RunnerDispatchBlocked { evidence: evidence }
    }
  })
}

type RunnerSchedulePlan<V>
  = RunnerScheduleComplete {
      batches: List<v2.workflow.executor.ExecutorBatch>,
      store: NodeKeyedStore<V>
    }
  | RunnerScheduleBlocked { evidence: RunnerBlockedEvidence }

fn runner_schedule_plan_from_dependencies<V>(
  nodes: List<v2.std.node.Node>,
  dependencies: List<v2.std.dependency.DependencyView>,
  value: V
) -> RunnerSchedulePlan<V> {
  let execution_dependencies = runner_execution_dependencies(dependencies: dependencies)
  match parallel_executor_plan_from_dependencies(
    nodes: nodes,
    dependencies: dependencies,
    scheduled: []
  ) {
    ExecutorRunComplete { batches: batches, scheduled: _ } =>
      match runner_walk_batches(
        batches: batches,
        dependencies: execution_dependencies,
        store: node_keyed_store_empty(),
        value: value
      ) {
        RunnerDispatchOk { store: store } =>
          RunnerScheduleComplete { batches: batches, store: store }
        RunnerDispatchBlocked { evidence: evidence } =>
          RunnerScheduleBlocked { evidence: evidence }
      }
    ExecutorRunRunnable { batch: _, scheduled: _, remaining: _ } =>
      RunnerScheduleBlocked {
        evidence: RunnerExecutorBlocked { evidence: v2.workflow.executor.ExecutorEmptyFrontier {} }
      }
    ExecutorRunBlocked { evidence: evidence, batches: _, scheduled: _, remaining: _ } =>
      RunnerScheduleBlocked {
        evidence: RunnerExecutorBlocked { evidence: evidence }
      }
  }
}

fn runner_schedule_store_covers_nodes<V>(
  store: NodeKeyedStore<V>,
  nodes: List<v2.std.node.Node>
) -> v2.std.logic.Bool {
  fold(nodes, init: true, f: fn(ok, node) {
    ok && node_keyed_store_has_node(store: store, node: node)
  })
}

fn runner_schedule_batch_count(batches: List<v2.workflow.executor.ExecutorBatch>) -> Int {
  fold(batches, init: 0, f: fn(count, _) { count + 1 })
}

fn runner_schedule_contains_batch(
  batches: List<v2.workflow.executor.ExecutorBatch>,
  batch: v2.workflow.executor.ExecutorBatch
) -> v2.std.logic.Bool {
  contains(xs: batches, item: batch, eq: fn(left, right) { left == right })
}
