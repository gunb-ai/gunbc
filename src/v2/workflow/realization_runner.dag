module v2.workflow.realization_runner

import v2.std.algebra { contains, list_snoc_item, non_empty }
import v2.std.collection { List }
import v2.std.dependency { DependencyView }
import std.types { Int }
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.workflow.executor {
  ExecutorBatch,
  ExecutorJob,
  ExecutorRunBlocked,
  ExecutorRunComplete,
  ExecutorRunRunnable,
  ExecutorBlockedEvidence,
  ExecutorEmptyFrontier,
  parallel_executor_plan_from_dependencies
}
import v2.workflow.scheduler { scheduler_execution_dependencies }

type RunnerOrderingResult = RunnerOrderingOnly {}

data runner_ordering_only: RunnerOrderingResult = RunnerOrderingOnly {}

type NodeKeyedStoreEntry<V> {
  node: Node
  value: V
}

type NodeKeyedStore<V> {
  entries: List<NodeKeyedStoreEntry<V>>
}

fn node_keyed_store_empty<V>() -> NodeKeyedStore<V> {
  NodeKeyedStore { entries: [] }
}

fn node_keyed_store_has_node<V>(store: NodeKeyedStore<V>, node: Node) -> Bool {
  fold(store.entries, init: false, f: fn(found, entry) {
    found || (entry.node == node)
  })
}

fn node_keyed_store_put<V>(store: NodeKeyedStore<V>, node: Node, value: V) -> NodeKeyedStore<V> {
  NodeKeyedStore {
    entries: list_snoc_item(
      xs: store.entries,
      item: NodeKeyedStoreEntry { node: node, value: value }
    )
  }
}

fn node_keyed_store_node_count<V>(store: NodeKeyedStore<V>) -> Int {
  fold(store.entries, init: 0, f: fn(count, _) { count + 1 })
}

fn runner_execution_dependencies(dependencies: List<DependencyView>) -> List<DependencyView> {
  scheduler_execution_dependencies(dependencies: dependencies)
}

fn runner_dependency_satisfied<V>(
  dependency: DependencyView,
  store: NodeKeyedStore<V>,
  candidate: Node
) -> Bool {
  if dependency.dependent == candidate {
    node_keyed_store_has_node(store: store, node: dependency.source)
  } else {
    true
  }
}

fn runner_node_ready<V>(
  dependencies: List<DependencyView>,
  store: NodeKeyedStore<V>,
  candidate: Node
) -> Bool {
  fold(dependencies, init: true, f: fn(ok, dependency) {
    ok && runner_dependency_satisfied(
      dependency: dependency,
      store: store,
      candidate: candidate
    )
  })
}

type RunnerBlockedEvidence
  = RunnerMissingDependency { node: Node, prerequisite: Node }
  | RunnerExecutorBlocked { evidence: ExecutorBlockedEvidence }

type RunnerMissingPrerequisite
  = RunnerPrerequisiteNotFoundYet {}
  | RunnerPrerequisiteMissing { node: Node }

fn runner_first_missing_dependency<V>(
  dependencies: List<DependencyView>,
  store: NodeKeyedStore<V>,
  candidate: Node
) -> Node {
  match fold(dependencies, init: RunnerPrerequisiteNotFoundYet {}, f: fn(found, dependency) {
    match found {
      RunnerPrerequisiteMissing { node: _ } => found
      RunnerPrerequisiteNotFoundYet {} =>
        if dependency.dependent == candidate {
          if node_keyed_store_has_node(store: store, node: dependency.source) {
            RunnerPrerequisiteNotFoundYet {}
          } else {
            RunnerPrerequisiteMissing { node: dependency.source }
          }
        } else {
          RunnerPrerequisiteNotFoundYet {}
        }
    }
  }) {
    RunnerPrerequisiteMissing { node: node } => node
    RunnerPrerequisiteNotFoundYet {} => candidate
  }
}

type RunnerDispatchOutcome<V>
  = RunnerDispatchOk { store: NodeKeyedStore<V> }
  | RunnerDispatchBlocked { evidence: RunnerBlockedEvidence }

fn runner_dispatch_job<V>(
  job: ExecutorJob,
  dependencies: List<DependencyView>,
  store: NodeKeyedStore<V>,
  value: V
) -> RunnerDispatchOutcome<V> {
  if runner_node_ready(dependencies: dependencies, store: store, candidate: job.node) {
    RunnerDispatchOk {
      store: node_keyed_store_put(store: store, node: job.node, value: value)
    }
  } else {
    RunnerDispatchBlocked {
      evidence: RunnerMissingDependency {
        node: job.node,
        prerequisite: runner_first_missing_dependency(
          dependencies: dependencies,
          store: store,
          candidate: job.node
        )
      }
    }
  }
}

fn runner_dispatch_jobs<V>(
  jobs: List<ExecutorJob>,
  dependencies: List<DependencyView>,
  store: NodeKeyedStore<V>,
  value: V
) -> RunnerDispatchOutcome<V> {
  fold(jobs, init: RunnerDispatchOk { store: store }, f: fn(outcome, job) {
    match outcome {
      RunnerDispatchOk { store: current } =>
        runner_dispatch_job(
          job: job,
          dependencies: dependencies,
          store: current,
          value: value
        )
      RunnerDispatchBlocked { evidence: evidence } =>
        RunnerDispatchBlocked { evidence: evidence }
    }
  })
}

fn runner_dispatch_batch<V>(
  batch: ExecutorBatch,
  dependencies: List<DependencyView>,
  store: NodeKeyedStore<V>,
  value: V
) -> RunnerDispatchOutcome<V> {
  runner_dispatch_jobs(
    jobs: batch.jobs,
    dependencies: dependencies,
    store: store,
    value: value
  )
}

fn runner_walk_batches<V>(
  batches: List<ExecutorBatch>,
  dependencies: List<DependencyView>,
  store: NodeKeyedStore<V>,
  value: V
) -> RunnerDispatchOutcome<V> {
  fold(batches, init: RunnerDispatchOk { store: store }, f: fn(outcome, batch) {
    match outcome {
      RunnerDispatchOk { store: current } =>
        runner_dispatch_batch(
          batch: batch,
          dependencies: dependencies,
          store: current,
          value: value
        )
      RunnerDispatchBlocked { evidence: evidence } =>
        RunnerDispatchBlocked { evidence: evidence }
    }
  })
}

type RunnerSchedulePlan<V>
  = RunnerScheduleComplete {
      batches: List<ExecutorBatch>,
      store: NodeKeyedStore<V>
    }
  | RunnerScheduleBlocked { evidence: RunnerBlockedEvidence }

fn runner_schedule_plan_from_dependencies<V>(
  nodes: List<Node>,
  dependencies: List<DependencyView>,
  value: V
) -> RunnerSchedulePlan<V> {
  let execution_dependencies = runner_execution_dependencies(dependencies: dependencies)
  match parallel_executor_plan_from_dependencies(
    nodes: nodes,
    dependencies: dependencies,
    scheduled: []
  ) {
    ExecutorRunComplete { batches: batches, scheduled: _ } =>
      match runner_walk_batches(
        batches: batches,
        dependencies: execution_dependencies,
        store: node_keyed_store_empty(),
        value: value
      ) {
        RunnerDispatchOk { store: store } =>
          RunnerScheduleComplete { batches: batches, store: store }
        RunnerDispatchBlocked { evidence: evidence } =>
          RunnerScheduleBlocked { evidence: evidence }
      }
    ExecutorRunRunnable { batch: _, scheduled: _, remaining: _ } =>
      RunnerScheduleBlocked {
        evidence: RunnerExecutorBlocked { evidence: ExecutorEmptyFrontier {} }
      }
    ExecutorRunBlocked { evidence: evidence, batches: _, scheduled: _, remaining: _ } =>
      RunnerScheduleBlocked {
        evidence: RunnerExecutorBlocked { evidence: evidence }
      }
  }
}

fn runner_schedule_store_covers_nodes<V>(
  store: NodeKeyedStore<V>,
  nodes: List<Node>
) -> Bool {
  fold(nodes, init: true, f: fn(ok, node) {
    ok && node_keyed_store_has_node(store: store, node: node)
  })
}

fn runner_schedule_batch_count(batches: List<ExecutorBatch>) -> Int {
  fold(batches, init: 0, f: fn(count, _) { count + 1 })
}

fn runner_schedule_contains_batch(
  batches: List<ExecutorBatch>,
  batch: ExecutorBatch
) -> Bool {
  contains(xs: batches, item: batch, eq: fn(left, right) { left == right })
}
