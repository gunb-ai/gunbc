module v2.workflow.ci_floor_evidence_native_controls_emit_test

import v2.std.effect_plan { Do, EffectPlan }
import v2.std.operation_argv {
  OperationRef,
  operation_argv_bind_text_list
}
import v2.std.orchestration { Continue, FailFast }
import v2.workflow.ci_floor_evidence_native_controls_emit {
  ci_floor_evidence_native_controls_extra_args,
  ci_floor_evidence_native_controls_intent,
  ci_floor_evidence_native_controls_refusal_prefix,
  ci_floor_evidence_native_controls_render,
  ci_floor_evidence_native_controls_script,
  ci_floor_evidence_native_controls_shell_emit_dissolution_trigger,
  ci_floor_evidence_native_controls_shell_emit_scaffold,
  ci_floor_evidence_native_controls_test_step,
}
import v2.workflow.effect_plan_bash_materialize {
  BashBoundOperationInvocation,
  EffectPlanBashMaterializationRefused,
  EffectPlanBashMaterialized,
  bash_bind_operation_invocation,
  effect_plan_bash_materialize
}
import std.disposition { Scaffold }

fn controls_materialized_render(plan: EffectPlan<BashBoundOperationInvocation>) -> String {
  ci_floor_evidence_native_controls_render(plan: plan)
}

fn controls_plan_refuses(plan: EffectPlan<BashBoundOperationInvocation>) -> Bool {
  match effect_plan_bash_materialize(plan: plan) {
    EffectPlanBashMaterialized { source: _ } => false
    EffectPlanBashMaterializationRefused { refusal: _ } => true
  }
}

test fn ci_floor_evidence_native_controls_shell_emit_is_scaffold_holds() -> Bool {
  match ci_floor_evidence_native_controls_shell_emit_scaffold {
    Scaffold { dissolves_to: _, bind: _ } => true
    _ => false
  }
}

test fn ci_floor_evidence_native_controls_emit_carries_dissolve_marker_holds() -> Bool {
  string_contains(
    s: ci_floor_evidence_native_controls_script(),
    pattern: "🟡 dissolve-on: ci_floor_evidence_native_controls_script"
  )
}

test fn ci_floor_evidence_native_controls_script_is_typed_plan_plus_marker() -> Bool {
  let expected = concat(
    concat(
      "# ",
      concat(ci_floor_evidence_native_controls_shell_emit_dissolution_trigger, "\n")
    ),
    concat(
      controls_materialized_render(plan: ci_floor_evidence_native_controls_intent()),
      "\n"
    )
  )
  ci_floor_evidence_native_controls_script() == expected
}

test fn ci_floor_evidence_native_controls_uses_cargo_bin_and_test_args() -> Bool {
  let script = ci_floor_evidence_native_controls_script()
  string_contains(s: script, pattern: "\"$CARGO_BIN\"")
    && string_contains(s: script, pattern: "'test'")
    && string_contains(s: script, pattern: "'-p'")
    && string_contains(s: script, pattern: "'v1-compiler'")
    && string_contains(s: script, pattern: "'--bin'")
    && string_contains(s: script, pattern: "'claim_executor'")
    && string_contains(s: script, pattern: "'floor_evidence::'")
    && string_contains(s: script, pattern: "'--test-threads=1'")
    && !string_contains(s: script, pattern: "'check'")
    && !string_contains(s: script, pattern: "nextest")
}

test fn ci_floor_evidence_native_controls_RED_continue_policy_refuses() -> Bool {
  let refused_plan = EffectPlan {
    steps: [Do { effect: ci_floor_evidence_native_controls_test_step() }],
    on_failure: Continue
  }
  controls_plan_refuses(plan: refused_plan)
    && string_contains(
      s: controls_materialized_render(plan: refused_plan),
      pattern: ci_floor_evidence_native_controls_refusal_prefix
    )
}

test fn ci_floor_evidence_native_controls_RED_missing_operation_refuses() -> Bool {
  let bad_step = bash_bind_operation_invocation(
    at: OperationRef {
      path: "dag/extdeps/rust/cargo_build.dag",
      service: "cargo.Build",
      operation: "NoSuchTest"
    },
    bindings: [
      operation_argv_bind_text_list(
        name: "extra_args",
        items: ci_floor_evidence_native_controls_extra_args
      )
    ]
  )
  let refused_plan = EffectPlan {
    steps: [Do { effect: bad_step }],
    on_failure: FailFast
  }
  controls_plan_refuses(plan: refused_plan)
    && string_contains(
      s: controls_materialized_render(plan: refused_plan),
      pattern: ci_floor_evidence_native_controls_refusal_prefix
    )
}
