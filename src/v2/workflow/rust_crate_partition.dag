// The corpus-owned source-to-target binding rows sit between the extdeps-languages
// layer they cite and the coercion module that reads them, so they land in the
// v1-infer unit: gunbc_rust_source_type_bindings references
// extdeps_languages_rust_representation, which the extdeps-languages unit owns, and
// is referenced by v1_compiler_coercion, which this unit owns. Named separately from
// the v1_compiler_* pipeline modules because the layer is a different one -- the
// grouping is physical (one crate) while the name records what the module actually is.
fn stage0_gunbc_binding_modules() -> List<String> {
  ["gunbc_rust_source_type_bindings", "gunbc_structural_realization_bindings"]
}

// THE INFER STAGE MOVED HERE AS ONE CRATE-INTERNAL CLOSURE. A generated mirror resolves its
// cross-module references as crate:: paths, which resolve only within a single crate root, so a
// module can join a partition only together with every monolith-owned module it names.
// v1_compiler_infer -- the stage-04 root -- names the infer_* sibling stages (access, cycle,
// lookup, method, patterns) and reaches v1_compiler_resolve (stage 03) and v1_compiler_ownership;
// ownership in turn calls v1_compiler_emit_core_support's to_string. The regen round's
// partition-rebuild scope refuses any changed mirror that has no owning package, so the first
// edit to 04_infer.dag forced the whole set to take an owner together: none of them may stay
// monolith-owned once infer is here, because the monolith is not a crate this unit may depend on.
// emit_core_support's own references (infer_env/items/service/types in this unit, artifact and
// languages in v1-artifact) all resolve here, so it joins as an OWNED module. The transitive
// closure was computed over the generated mirrors and is self-contained: every crate:: reference
// of every moved module lands in this unit or in a foundation crate it re-exports.
//
// v1_compiler_parse lands in this unit because v1_compiler_emit_core_support calls
// parsed_item_carries_resource_entries on it. That module is still compiled twice from one file
// -- now inside v1-stage0-v1-infer (owned) and inside v1-stage0-emit-core (the #[path] copy the
// emit shell hosts rather than re-exports) -- so its reachable set is the INTERSECTION of two
// crate roots and a name present in only one resolves in one compilation and not the other. The
// emit-core crate's own purpose is to host that module WITHOUT COPYING SEMANTICS: the
// alternatives were to fork the predicate into a module that cannot see the minting vocabulary it
// is defined against, or to scatter the exclusion across the 24 call expressions in 12 functions
// that read the emit-side type predicates. Both are the failure v1.compiler.parse's own note
// predicts. The unit is chosen for LAYER and not convenience -- parse is a pipeline stage and
// sits beside v1_compiler_coercion and the infer modules, not beside the artifact/languages rows
// -- and parse is a SOURCE here: nothing in this unit is reachable from it, so the unit graph
// gains no edge back.
fn stage0_v1_infer_modules() -> List<String> {
  stage0_gunbc_binding_modules()
    |> concat([
    "v1_compiler_parse",
    "v1_compiler_coercion",
    "v1_compiler_compiler_tests_rust",
    "v1_compiler_resolve",
    "v1_compiler_infer",
    "v1_compiler_infer_access",
    "v1_compiler_infer_cycle",
    "v1_compiler_infer_emit_info",
    "v1_compiler_infer_env",
    "v1_compiler_infer_items",
    "v1_compiler_infer_lookup",
    "v1_compiler_infer_method",
    "v1_compiler_infer_occurrence_binding",
    "v1_compiler_infer_patterns",
    "v1_compiler_infer_resolve",
    "v1_compiler_infer_service",
    "v1_compiler_infer_sigs",
    "v1_compiler_infer_types",
    "v1_compiler_ownership",
    "v1_compiler_emit_core_support",
    "v1_compiler_type_head_exposure"
  ])
}

fn stage0_v1_artifact_modules() -> List<String> {
  ["v1_compiler_artifact", "v1_compiler_languages"]
}

fn stage0_r3_emit_reexport_surface_modules() -> List<String> {
  [
    "v1_compiler_artifact",
    "v1_compiler_infer_env",
    "v1_compiler_infer_items",
    "v1_compiler_infer_service",
    "v1_compiler_infer_types",
    "v1_compiler_languages",
    "v1_compiler_parse",
    "v1_rt",
    "v1_std_core"
  ]
}

fn stage0_all_partitioned_modules() -> List<String> {
  stage0_runtime_modules()
    |> concat(stage0_std_core_modules())
    |> concat(stage0_std_surface_modules())
    |> concat(stage0_extdeps_modules())
    |> concat(stage0_v1_artifact_modules())
    |> concat(stage0_v1_infer_modules())
}

fn stage0_assign_modules_to_unit(
  assignment: Map<ModuleId, CompilationUnitId>,
  modules: List<String>,
  unit_id: CompilationUnitId
) -> Map<ModuleId, CompilationUnitId> {
  modules
    |> fold(init: assignment, f: fn(acc, basename) {
      map_insert(acc, stage0_module_id(basename: basename), unit_id)
    })
}

fn stage0_interim_explicit_assignment() -> Map<ModuleId, CompilationUnitId> {
  stage0_assign_modules_to_unit(
    assignment: stage0_assign_modules_to_unit(
      assignment: stage0_assign_modules_to_unit(
        assignment: stage0_assign_modules_to_unit(
          assignment: stage0_assign_modules_to_unit(
            assignment: stage0_assign_modules_to_unit(
              assignment: empty_map(),
              modules: stage0_runtime_modules(),
              unit_id: stage0_unit_runtime
            ),
            modules: stage0_std_core_modules(),
            unit_id: stage0_unit_std_core
          ),
          modules: stage0_std_surface_modules(),
          unit_id: stage0_unit_std_surface
        ),
        modules: stage0_extdeps_language_modules(),
        unit_id: stage0_unit_extdeps_languages
      ),
      modules: stage0_v1_artifact_modules(),
      unit_id: stage0_unit_v1_artifact
    ),
    modules: stage0_v1_infer_modules(),
    unit_id: stage0_unit_v1_infer
  )
}

fn stage0_interim_explicit_partition() -> ExplicitPartition {
  ExplicitPartition { assignment: stage0_interim_explicit_assignment() }
}

fn stage0_partition_parameter() -> PartitionParameter {
  ExplicitPartitionParam { partition: stage0_interim_explicit_partition() }
}

fn stage0_partition_provenance() -> PartitionProvenance {
  partition_provenance_hand_explicit()
}

fn stage0_module_dag_edge(from: String, to: String) -> ModuleDagEdge {
  ModuleDagEdge {
    from: stage0_module_id(basename: from),
    to: stage0_module_id(basename: to),
  }
}

