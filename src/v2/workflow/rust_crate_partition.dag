}
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.node { Node, Symbol }

type PartitionPolicy {
  target_crate_count: Int
}

type ExplicitPartition {
  assignment: Map<ModuleId, CompilationUnitId>
}

type PartitionParameter
  = ExplicitPartitionParam { partition: ExplicitPartition }
  | DerivedStage0PartitionParam
  | PolicyPartitionParam { policy: PartitionPolicy }

type PolicyResolverUnimplemented {
  policy: PartitionPolicy
}

type ResolvePartitionRefusalCause
  = PolicyResolverUnimplemented { policy: PartitionPolicy }
  | Stage0DerivedMembershipRefused {
      cause: Stage0UnitMembershipFoldRefusalCause
    }

type ResolvePartitionOutcome
  = ResolvePartitionOk { assignment: Map<ModuleId, CompilationUnitId> }
  | ResolvePartitionRefused { cause: ResolvePartitionRefusalCause }

type Stage0PartitionReceiptOutcome
  = Stage0PartitionReceiptOk { units: List<CompilationUnit> }
  | Stage0PartitionReceiptResolveRefused { cause: ResolvePartitionRefusalCause }
  | Stage0PartitionReceiptFoldRefused { cause: PartitionFoldRefusalCause }

type Stage0PartitionCrateKind
  = Stage0FoundationCrate
  | Stage0LayeredCoreCrate
  | Stage0EmitCoreCrate

type Stage0PartitionCrateRowsOutcome
  = Stage0PartitionCrateRowsOk { rows: List<Stage0PartitionCrateRow> }
  | Stage0PartitionCrateRowsRefused {
      cause: Stage0UnitMembershipFoldRefusalCause
    }

type Stage0PartitionCrateRow {
  unit_id: CompilationUnitId
  package_name: String
  crate_dir: String
  kind: Stage0PartitionCrateKind
  modules: List<String>
  reexport_packages: List<String>
  carries_non_empty_wrappers: Bool
}

type ModuleDagForwardClosureRefusalCause
  = ModuleDagForwardClosureNonConvergent { steps_budget: Int }

type ModuleDagForwardClosureOutcome
  = ModuleDagForwardClosureOk { closure: List<ModuleId> }
  | ModuleDagForwardClosureRefused { cause: ModuleDagForwardClosureRefusalCause }

type Stage0PartitionAssignmentCollisionCause {
  module: ModuleId
  reachers: List<CompilationUnitId>
}

type Stage0PartitionReachDisposition
  = Stage0PartitionReachMember
  | Stage0PartitionSharedDependencyThroughPackage {
      module: ModuleId
      owner_package: String
    }
  | Stage0PartitionUnroutedCrossUnitReach {
      module: ModuleId
      claimer: CompilationUnitId
      owner: CompilationUnitId
    }
  | Stage0PartitionAssignmentConflict {
      collision: Stage0PartitionAssignmentCollisionCause
    }

type Stage0UnitMembershipFoldOutcome
  = Stage0UnitMembershipFoldOk {
      members: List<ModuleId>
      assignment: Map<ModuleId, CompilationUnitId>
    }
  | Stage0UnitMembershipFoldRefused {
      cause: Stage0UnitMembershipFoldRefusalCause
    }

type Stage0UnitMembershipFoldRefusalCause
  = Stage0UnitMembershipNonConvergent { steps_budget: Int }
  | Stage0UnitMembershipReachRefused {
      disposition: Stage0PartitionReachDisposition
    }
  | Stage0PartitionMissingRawReachPopulation {
      unit_id: CompilationUnitId
    }
  | Stage0PartitionMissingAssignment {
      module: ModuleId
    }

type Stage0UnitModuleReachDispositionRow {
  module: ModuleId
  disposition: Stage0PartitionReachDisposition
}

type Stage0DerivedPartitionOutcome
  = Stage0DerivedPartitionOk {
      assignment: Map<ModuleId, CompilationUnitId>
      members_by_unit: Map<CompilationUnitId, List<ModuleId>>
      reach_dispositions_by_unit: Map<CompilationUnitId, List<Stage0UnitModuleReachDispositionRow>>
    }
  | Stage0DerivedPartitionRefused {
      cause: Stage0UnitMembershipFoldRefusalCause
    }

type Stage0UnitRawReachOutcome
  = Stage0UnitRawReachOk { members: List<ModuleId> }
  | Stage0UnitRawReachRefused {
      cause: Stage0UnitMembershipFoldRefusalCause
    }

type Stage0ModuleOwnershipOutcome
  = Stage0ModuleOwnershipOk { owner: CompilationUnitId }
  | Stage0ModuleOwnershipConflict {
      module: ModuleId
      reachers: List<CompilationUnitId>
    }

data rust_crate_partition_note: String = "Rust R3 workflow realization of the shared CompilationUnit home (emitted-crate-partition-design.md §2/§13). resolve_partition_outcome is the sole entry for the assignment Map; partition_fold_outcome is the sole producer of interface + deps. Phase 0: HandExplicit provenance + ExplicitPartition interim ~8-crate layered grouping (dissolves to PolicyPartition when balanced crates≈cores policy lands)."

data rust_crate_partition_dissolve_on: String = "dissolve-on: rust_crate_partition_interim_explicit — replace ExplicitPartition assignment with PolicyPartition { target_crate_count: declared_core_target } when balanced partition policy lands; provenance flips HandExplicit → PolicyDerived."

data stage0_partition_membership_closure_note: String = "C2: per-crate module membership is DERIVED order-independently — each unit's raw_reach is computed in isolation, then a global owner rule assigns each module. SharedDependencyThroughPackage is the reach arm when a unit's raw closure touches a module owned elsewhere via a declared reexport package (Cargo dep — not same-crate membership). AssignmentConflict refuses genuine ambiguity. Convergence budget is |partition domain| — never a fixed step truncate."

data stage0_partition_closure_collision_policy_note: String = "C2 collision policy is explicit: SharedDependencyThroughPackage | AssignmentConflict. Import-order and layer-order first-wins are forbidden — ownership is a global function of raw reaches plus declared package deps."

data stage0_partition_map_lookup_refusal_note: String = "C2 issue-7: production partition folds refuse on every missing map population — absent raw-reach by unit, absent assignment for a module in raw reach, or absent reach-disposition row. Lookup-unavailable-then-keep-accumulator is forbidden; each omission is Stage0PartitionMissingRawReachPopulation or Stage0PartitionMissingAssignment, never a silently smaller answer."

data stage0_partition_emit_core_exemption_note: String = "Emit-core is structurally outside the membership fold: stage0_unit_emit_core is excluded from stage0_module_bearing_unit_ids and partition_fold CompilationUnits. Stage0EmitCoreCrate is a reexport shell (stage0_r3_emit_shell_crate_row); its modules list is the declared public reexport surface (stage0_r3_emit_reexport_surface_modules), with totality enforced by stage0_partition_row_lookups_resolved — every listed basename must resolve to an owner in module-bearing rows. C3 emitted-reference oracle is sharp-cat-359; C2 does not run the owner fold on emit-core."

data rust_crate_partition_declared_core_target: Int = 7

data rust_crate_partition_module_bearing_unit_target: Int = 6

data stage0_r3_emit_shell_note: String = "R3-only emit shell crate (reexport surface, NOT a partition_fold CompilationUnit): modules list is the reexport bundle for render at cutover; those modules remain owned by module-bearing units in stage0_derived_partition_outcome. Physical crate count = module_bearing (6) + emit_shell (1) = declared_core_target (7)."

data stage0_unit_runtime: CompilationUnitId = "stage0-unit-runtime" as CompilationUnitId
data stage0_unit_std_primitives: CompilationUnitId = "stage0-unit-std-primitives" as CompilationUnitId
data stage0_unit_std_core: CompilationUnitId = "stage0-unit-std-core" as CompilationUnitId
data stage0_unit_std_surface: CompilationUnitId = "stage0-unit-std-surface" as CompilationUnitId
data stage0_unit_extdeps: CompilationUnitId = "stage0-unit-extdeps" as CompilationUnitId
data stage0_unit_v1_infer: CompilationUnitId = "stage0-unit-v1-infer" as CompilationUnitId
data stage0_unit_extdeps_languages: CompilationUnitId = "stage0-unit-extdeps-languages" as CompilationUnitId
data stage0_unit_v1_artifact: CompilationUnitId = "stage0-unit-v1-artifact" as CompilationUnitId
data stage0_unit_emit_core: CompilationUnitId = "stage0-unit-emit-core" as CompilationUnitId

data stage0_planted_unit_low: CompilationUnitId = "stage0-planted-unit-low" as CompilationUnitId
data stage0_planted_unit_high: CompilationUnitId = "stage0-planted-unit-high" as CompilationUnitId
data stage0_planted_basename_l: String = "stage0_planted_mod_l"
data stage0_planted_basename_h: String = "stage0_planted_mod_h"
data stage0_planted_pkg_low: String = "stage0-planted-pkg-low"
data stage0_planted_pkg_high: String = "stage0-planted-pkg-high"

type Stage0PlantedPartitionVariant
  = Stage0PlantedLowHighSharedDependency
  | Stage0PlantedLowHighAssignmentConflict
  | Stage0PlantedLowHighSeparated
  | Stage0PlantedLowHighConvergenceChain
  | Stage0PlantedThreeUnitUnroutedReach

data stage0_planted_unit_mid: CompilationUnitId = "stage0-planted-unit-mid" as CompilationUnitId
data stage0_planted_basename_m: String = "stage0_planted_mod_m"
data stage0_planted_pkg_mid: String = "stage0-planted-pkg-mid"

type Stage0PartitionDerivationContext
  = Stage0PartitionDerivationContextEnrolled
  | Stage0PartitionDerivationContextPlanted {
      variant: Stage0PlantedPartitionVariant
    }

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: RealizationDispatch }
}

type Stage0ModuleDagInterfaceGrounding
  = Stage0ModuleDagInterfaceFrontierGrounded
  | Stage0ModuleDagInterfaceUngrounded {
      exports_map: ExportsMapNotFrontierGrounded
      type_definitions_map: TypeDefinitionsMapNotFrontierGrounded
    }

type ExportsMapNotFrontierGrounded {
  dissolve_target: DeclarationRef
}

type TypeDefinitionsMapNotFrontierGrounded {
  dissolve_target: DeclarationRef
}

data stage0_module_dag_interface_grounding_debt_dissolve_on: String = "dissolve-on: stage0_module_dag_interface_grounding — populate ModuleDag.exports with frontier-derived cross-module export Nodes and type_definitions with by-value ModuleTypeDefinitionRow rows when stage0 module ingest provides them; until then R3 render uses Stage0PartitionCrateRow.modules + reexport_packages wildcard pub-use chain (not CompilationUnit.interface Nodes)."

data rust_crate_partition_interface_deferred_note: String = "Interim: ModuleDag.exports + type_definitions carry per-module keys with empty lists (structural scaffold for partition_fold only). R3 render uses Stage0PartitionCrateRow.modules + reexport_packages wildcard pub-use chain — not CompilationUnit.interface Nodes. Full Node-carrier exports blocked on stage0 module ingest (frontier-grounding dependency)."

data rust_crate_partition_r4_by_value_type_cycle_note: String = "Rust R4 primary refusals on current main: SccSplit + UnitGraphCycle (LinkageCycle permissive). ByValueTypeCycle arm lands with #6744 rebase — refuse type-layout cycles via ByValueTypeCycle { detail } ONLY, never SccSplit. Exhaustive PartitionR4ValidityCause matches must add the 4th arm on rebase."

fn stage0_frontier_grounding_target() -> DeclarationRef {
  DeclarationRef {
    module_path: "v2.compiler.self_host.frontier" as NonEmptyStr,
    decl_name: "compiler_frontier_roster" as NonEmptyStr,
    field: WholeDeclaration,
  }
}

fn stage0_module_dag_interface_grounding() -> Stage0ModuleDagInterfaceGrounding {
  Stage0ModuleDagInterfaceUngrounded {
    exports_map: ExportsMapNotFrontierGrounded {
      dissolve_target: stage0_frontier_grounding_target()
    },
    type_definitions_map: TypeDefinitionsMapNotFrontierGrounded {
      dissolve_target: stage0_frontier_grounding_target()
    }
  }
}

fn stage0_module_dag_interface_grounding_is_debt() -> Bool {
  match stage0_module_dag_interface_grounding() {
    Stage0ModuleDagInterfaceFrontierGrounded => false
    Stage0ModuleDagInterfaceUngrounded { exports_map: _, type_definitions_map: _ } => true
  }
}

fn stage0_module_dag_exports_map() -> Map<ModuleId, List<Node>> {
  stage0_all_partitioned_modules()
    |> fold(init: empty_map(), f: fn(acc, basename) {
      map_insert(acc, stage0_module_id(basename: basename), Empty)
    })
}

fn stage0_module_dag_type_definitions_map() -> Map<ModuleId, List<ModuleTypeDefinitionRow>> {
  stage0_all_partitioned_modules()
    |> fold(init: empty_map(), f: fn(acc, basename) {
      map_insert(acc, stage0_module_id(basename: basename), Empty)
    })
}

fn stage0_module_id(basename: String) -> ModuleId {
  basename as NonEmptyStr
}

fn stage0_module_id_list_contains(xs: List<ModuleId>, item: ModuleId) -> Bool {
  any(xs: xs, predicate: fn(m) { m == item })
}

fn stage0_module_id_list_snoc_unique(xs: List<ModuleId>, item: ModuleId) -> List<ModuleId> {
  if stage0_module_id_list_contains(xs: xs, item: item) {
    xs
  } else {
    xs |> concat([item])
  }
}

fn stage0_package_name_list_contains(xs: List<String>, package: String) -> Bool {
  any(xs: xs, predicate: fn(p) { p == package })
}

fn stage0_package_name_for_unit(unit_id: CompilationUnitId) -> String {
  if unit_id == stage0_unit_runtime {
    "v1-stage0-runtime"
  } else if unit_id == stage0_unit_std_core {
    "v1-stage0-std-core"
  } else if unit_id == stage0_unit_std_surface {
    "v1-stage0-std-surface"
  } else if unit_id == stage0_unit_extdeps_languages {
    "v1-stage0-extdeps-languages"
  } else if unit_id == stage0_unit_v1_infer {
    "v1-stage0-v1-infer"
  } else if unit_id == stage0_unit_v1_artifact {
    "v1-stage0-v1-artifact"
  } else if unit_id == stage0_unit_emit_core {
    "v1-stage0-emit-core"
  } else {
    ""
  }
}

fn stage0_unit_runtime_seed_basenames() -> List<String> {
  ["v1_rt"]
}

fn stage0_unit_std_core_seed_basenames() -> List<String> {
  [
    "std_content_hash",
    "std_coercion",
    "std_currency",
    "std_disposition",
    "std_emit_model",
    "std_http_path",
