    "std_measure",
    "std_lens_verdict",
    "std_nat",
    "std_syntax",
    "std_iteration",
    "std_graph",
    "extdeps_external_authority",
    "extdeps_container_oci_digest",
    "extdeps_units_dimensionless",
    "extdeps_units_iec_80000_13",
    "extdeps_units_iso8601",
    "v1_std_core"
  ]
}

fn stage0_unit_std_surface_seed_basenames() -> List<String> {
  [
    "std_effects",
    "std_execution_mode",
    "std_interface_summary",
    "std_pareto",
    "std_realization_schedule",
    "std_trait_derive_shape"
  ]
}

fn stage0_unit_extdeps_languages_seed_basenames() -> List<String> {
  [
    "extdeps_languages_dag_emit",
    "extdeps_languages_dag_syntax",
    "extdeps_languages_dag_types",
    "extdeps_languages_go_emit",
    "extdeps_languages_go_syntax",
    "extdeps_languages_go_types",
    "extdeps_languages_python_emit",
    "extdeps_languages_python_syntax",
    "extdeps_languages_python_types",
    "extdeps_languages_rust_emit",
    "extdeps_languages_rust_syntax",
    "extdeps_languages_rust_types"
  ]
}

fn stage0_unit_v1_infer_seed_basenames() -> List<String> {
  [
    "v1_compiler_infer_emit_info",
    "v1_compiler_infer_env",
    "v1_compiler_infer_items",
    "v1_compiler_infer_occurrence_binding",
    "v1_compiler_infer_service",
    "v1_compiler_infer_sigs",
    "v1_compiler_infer_types"
  ]
}

fn stage0_unit_v1_artifact_seed_basenames() -> List<String> {
  ["v1_compiler_artifact", "v1_compiler_languages"]
}

fn stage0_unit_seed_basenames(unit_id: CompilationUnitId) -> List<String> {
  if unit_id == stage0_unit_runtime {
    stage0_unit_runtime_seed_basenames()
  } else if unit_id == stage0_unit_std_core {
    stage0_unit_std_core_seed_basenames()
  } else if unit_id == stage0_unit_std_surface {
    stage0_unit_std_surface_seed_basenames()
  } else if unit_id == stage0_unit_extdeps_languages {
    stage0_unit_extdeps_languages_seed_basenames()
  } else if unit_id == stage0_unit_v1_infer {
    stage0_unit_v1_infer_seed_basenames()
  } else if unit_id == stage0_unit_v1_artifact {
    stage0_unit_v1_artifact_seed_basenames()
  } else {
    []
  }
}

fn stage0_unit_reexport_packages(unit_id: CompilationUnitId) -> List<String> {
  if unit_id == stage0_unit_runtime {
    []
  } else if unit_id == stage0_unit_std_core {
    ["v1-stage0-runtime"]
  } else if unit_id == stage0_unit_std_surface {
    ["v1-stage0-runtime", "v1-stage0-std-core"]
  } else if unit_id == stage0_unit_extdeps_languages {
    ["v1-stage0-runtime", "v1-stage0-std-core", "v1-stage0-std-surface"]
  } else if unit_id == stage0_unit_v1_infer {
    [
      "v1-stage0-runtime",
      "v1-stage0-std-core",
      "v1-stage0-std-surface",
      "v1-stage0-extdeps-languages"
    ]
  } else if unit_id == stage0_unit_v1_artifact {
    [
      "v1-stage0-runtime",
      "v1-stage0-std-core",
      "v1-stage0-std-surface",
      "v1-stage0-extdeps-languages",
      "v1-stage0-v1-infer"
    ]
  } else {
    []
  }
}

fn stage0_module_bearing_unit_ids() -> List<CompilationUnitId> {
  [
    stage0_unit_runtime,
    stage0_unit_std_core,
    stage0_unit_std_surface,
    stage0_unit_extdeps_languages,
    stage0_unit_v1_infer,
    stage0_unit_v1_artifact
  ]
}

fn stage0_planted_low_high_unit_ids() -> List<CompilationUnitId> {
  [stage0_planted_unit_low, stage0_planted_unit_high]
}

fn stage0_planted_three_unit_ids() -> List<CompilationUnitId> {
  [stage0_planted_unit_low, stage0_planted_unit_mid, stage0_planted_unit_high]
}

fn stage0_derivation_unit_ids(ctx: Stage0PartitionDerivationContext) -> List<CompilationUnitId> {
  match ctx {
    Stage0PartitionDerivationContextEnrolled => stage0_module_bearing_unit_ids()
    Stage0PartitionDerivationContextPlanted { variant: variant } =>
      match variant {
        Stage0PlantedThreeUnitUnroutedReach => stage0_planted_three_unit_ids()
        _ => stage0_planted_low_high_unit_ids()
      }
  }
}

fn stage0_derivation_package_name(
  ctx: Stage0PartitionDerivationContext,
  unit_id: CompilationUnitId
) -> String {
  match ctx {
    Stage0PartitionDerivationContextEnrolled =>
      stage0_package_name_for_unit(unit_id: unit_id)
    Stage0PartitionDerivationContextPlanted { variant: variant } =>
      if unit_id == stage0_planted_unit_low {
        stage0_planted_pkg_low
      } else if unit_id == stage0_planted_unit_mid {
        stage0_planted_pkg_mid
      } else if unit_id == stage0_planted_unit_high {
        stage0_planted_pkg_high
      } else {
        ""
      }
  }
}

fn stage0_derivation_reexport_packages(
  ctx: Stage0PartitionDerivationContext,
  unit_id: CompilationUnitId
) -> List<String> {
  match ctx {
    Stage0PartitionDerivationContextEnrolled =>
      stage0_unit_reexport_packages(unit_id: unit_id)
    Stage0PartitionDerivationContextPlanted { variant: variant } =>
      if unit_id == stage0_planted_unit_high {
        match variant {
          Stage0PlantedLowHighSharedDependency => [stage0_planted_pkg_low]
          Stage0PlantedLowHighAssignmentConflict => []
          Stage0PlantedLowHighSeparated => [stage0_planted_pkg_low]
          Stage0PlantedLowHighConvergenceChain => [stage0_planted_pkg_low]
          Stage0PlantedThreeUnitUnroutedReach => [stage0_planted_pkg_low]
        }
      } else {
        []
      }
  }
}

fn stage0_derivation_seed_basenames(
  ctx: Stage0PartitionDerivationContext,
  unit_id: CompilationUnitId
) -> List<String> {
  match ctx {
    Stage0PartitionDerivationContextEnrolled =>
      stage0_unit_seed_basenames(unit_id: unit_id)
    Stage0PartitionDerivationContextPlanted { variant: variant } =>
      if unit_id == stage0_planted_unit_low {
        [stage0_planted_basename_l]
      } else if unit_id == stage0_planted_unit_mid {
        match variant {
          Stage0PlantedThreeUnitUnroutedReach => [stage0_planted_basename_m]
          _ => []
        }
      } else if unit_id == stage0_planted_unit_high {
        [stage0_planted_basename_h]
      } else {
        []
      }
  }
}

fn stage0_planted_chain_basenames() -> List<String> {
  [
    "stage0_planted_chain_1",
    "stage0_planted_chain_2",
    "stage0_planted_chain_3",
    "stage0_planted_chain_4",
    "stage0_planted_chain_5"
  ]
}

fn stage0_derivation_domain_basenames(ctx: Stage0PartitionDerivationContext) -> List<String> {
  match ctx {
    Stage0PartitionDerivationContextEnrolled => stage0_partition_domain_module_basenames()
    Stage0PartitionDerivationContextPlanted { variant: variant } =>
      match variant {
        Stage0PlantedLowHighSharedDependency =>
          [stage0_planted_basename_h, stage0_planted_basename_l]
        Stage0PlantedLowHighAssignmentConflict =>
          [stage0_planted_basename_h, stage0_planted_basename_l]
        Stage0PlantedLowHighSeparated =>
          [stage0_planted_basename_h, stage0_planted_basename_l]
        Stage0PlantedLowHighConvergenceChain =>
          [stage0_planted_basename_h]
            |> concat(stage0_planted_chain_basenames())
            |> concat([stage0_planted_basename_l])
        Stage0PlantedThreeUnitUnroutedReach =>
          [stage0_planted_basename_h, stage0_planted_basename_m, stage0_planted_basename_l]
      }
  }
}

fn stage0_derivation_edges(ctx: Stage0PartitionDerivationContext) -> List<ModuleDagEdge> {
  match ctx {
    Stage0PartitionDerivationContextEnrolled => stage0_cross_unit_import_edges()
    Stage0PartitionDerivationContextPlanted { variant: variant } =>
      match variant {
        Stage0PlantedLowHighSharedDependency =>
          [
            stage0_module_dag_edge(
              from: stage0_planted_basename_h,
              to: stage0_planted_basename_l
            )
          ]
        Stage0PlantedLowHighAssignmentConflict =>
          [
            stage0_module_dag_edge(
              from: stage0_planted_basename_h,
              to: stage0_planted_basename_l
            )
          ]
        Stage0PlantedLowHighSeparated => []
        Stage0PlantedLowHighConvergenceChain =>
          [
            stage0_module_dag_edge(
              from: stage0_planted_basename_h,
              to: "stage0_planted_chain_1"
            ),
            stage0_module_dag_edge(
              from: "stage0_planted_chain_1",
              to: "stage0_planted_chain_2"
            ),
            stage0_module_dag_edge(
              from: "stage0_planted_chain_2",
              to: "stage0_planted_chain_3"
            ),
            stage0_module_dag_edge(
              from: "stage0_planted_chain_3",
              to: "stage0_planted_chain_4"
            ),
            stage0_module_dag_edge(
              from: "stage0_planted_chain_4",
              to: "stage0_planted_chain_5"
            ),
            stage0_module_dag_edge(
              from: "stage0_planted_chain_5",
              to: stage0_planted_basename_l
            )
          ]
        Stage0PlantedThreeUnitUnroutedReach =>
          [
            stage0_module_dag_edge(
              from: stage0_planted_basename_h,
              to: stage0_planted_basename_m
            )
          ]
      }
  }
}

fn stage0_derivation_closure_budget(ctx: Stage0PartitionDerivationContext) -> Int {
  stage0_derivation_domain_basenames(ctx: ctx) |> count
}

fn stage0_derivation_unit_reexports_package(
  ctx: Stage0PartitionDerivationContext,
  claimer: CompilationUnitId,
  owner: CompilationUnitId
) -> Bool {
  stage0_package_name_list_contains(
    xs: stage0_derivation_reexport_packages(ctx: ctx, unit_id: claimer),
    package: stage0_derivation_package_name(ctx: ctx, unit_id: owner)
  )
}

data stage0_string_lists_equal_as_sets_note: String = "Duplicate-safe exact-set equality: both operands are normalized to unique membership via stage0_string_list_to_unique_set before comparison. A duplicate in one list cannot substitute for a missing element in the other — [a,a] vs [a,b] normalizes to singleton-a vs pair-a-b and reports unequal. Order after normalization is ignored; [a,b] vs [b,a] reports equal. Shared authority for partition baseline and member comparisons; import this symbol rather than reimplementing length-plus-membership."

fn stage0_string_list_to_unique_set(xs: List<String>) -> List<String> {
  fold_list(
    xs: xs,
    empty: Empty,
    cons: fn(acc, item) { stage0_snoc_unique_string(xs: acc, item: item) }
  )
}

fn stage0_module_id_list_to_unique_set(xs: List<ModuleId>) -> List<ModuleId> {
  fold_list(
    xs: xs,
    empty: Empty,
    cons: fn(acc, item) { stage0_module_id_list_snoc_unique(xs: acc, item: item) }
  )
}

fn stage0_string_lists_equal_as_sets(
  left: List<String>,
  right: List<String>
) -> Bool {
  let left_norm = stage0_string_list_to_unique_set(xs: left)
  let right_norm = stage0_string_list_to_unique_set(xs: right)
  (left_norm |> count) == (right_norm |> count)
    && left_norm
      |> fold(init: true, f: fn(ok, item) {
        ok && any(xs: right_norm, predicate: fn(s) { s == item })
      })
}

fn stage0_snoc_unique_string(xs: List<String>, item: String) -> List<String> {
  if any(xs: xs, predicate: fn(s) { s == item }) {
    xs
  } else {
    xs |> concat([item])
  }
}

fn stage0_partition_domain_module_basenames() -> List<String> {
  let seed_basenames = stage0_unit_runtime_seed_basenames()
    |> concat(stage0_unit_std_core_seed_basenames())
    |> concat(stage0_unit_std_surface_seed_basenames())
    |> concat(stage0_unit_extdeps_languages_seed_basenames())
    |> concat(stage0_unit_v1_infer_seed_basenames())
    |> concat(stage0_unit_v1_artifact_seed_basenames())
  stage0_cross_unit_import_edges()
    |> fold(init: seed_basenames, f: fn(acc, edge) {
      stage0_snoc_unique_string(
        xs: stage0_snoc_unique_string(xs: acc, item: edge.from as String),
        item: edge.to as String
      )
    })
}

fn stage0_partition_closure_step_budget() -> Int {
  stage0_partition_domain_module_basenames() |> count
}

fn stage0_compilation_unit_id_list_contains(
  xs: List<CompilationUnitId>,
  item: CompilationUnitId
) -> Bool {
  any(xs: xs, predicate: fn(unit_id) { unit_id == item })
}

fn stage0_compilation_unit_id_list_snoc_unique(
  xs: List<CompilationUnitId>,
  item: CompilationUnitId
) -> List<CompilationUnitId> {
  if stage0_compilation_unit_id_list_contains(xs: xs, item: item) {
    xs
  } else {
    xs |> concat([item])
  }
}

fn stage0_module_id_lists_equal_as_sets(
  left: List<ModuleId>,
  right: List<ModuleId>
) -> Bool {
  let left_norm = stage0_module_id_list_to_unique_set(xs: left)
  let right_norm = stage0_module_id_list_to_unique_set(xs: right)
  (left_norm |> count) == (right_norm |> count)
    && left_norm
      |> fold(init: true, f: fn(ok, member_module) {
        ok && stage0_module_id_list_contains(xs: right_norm, item: member_module)
      })
}

fn stage0_unit_raw_reach_extend_once(
  members: List<ModuleId>,
  edges: List<ModuleDagEdge>
) -> List<ModuleId> {
  fold_list(
    xs: edges,
    empty: members,
    cons: fn(acc, edge) {
      if !stage0_module_id_list_contains(xs: acc, item: edge.from)
        || stage0_module_id_list_contains(xs: acc, item: edge.to) {
        acc
      } else {
        stage0_module_id_list_snoc_unique(xs: acc, item: edge.to)
      }
    }
  )
}

fn stage0_unit_raw_reach_fixpoint(
  members: List<ModuleId>,
  edges: List<ModuleDagEdge>,
  remaining_steps: Int
) -> Stage0UnitRawReachOutcome {
  let next_members = stage0_unit_raw_reach_extend_once(members: members, edges: edges)
  if (next_members |> count) == (members |> count) {
    Stage0UnitRawReachOk { members: next_members }
  } else if remaining_steps == 0 {
    Stage0UnitRawReachRefused {
      cause: Stage0UnitMembershipNonConvergent {
        steps_budget: stage0_partition_closure_step_budget()
      }
    }
  } else {
    stage0_unit_raw_reach_fixpoint(
      members: next_members,
      edges: edges,
      remaining_steps: remaining_steps - 1
    )
  }
}

fn stage0_unit_raw_reach_outcome(
  unit_id: CompilationUnitId,
  edges: List<ModuleDagEdge>,
  ctx: Stage0PartitionDerivationContext
) -> Stage0UnitRawReachOutcome {
  let seeds = stage0_derivation_seed_basenames(ctx: ctx, unit_id: unit_id)
    |> map(basename => stage0_module_id(basename: basename))
  stage0_unit_raw_reach_fixpoint(
    members: seeds,
    edges: edges,
    remaining_steps: stage0_derivation_closure_budget(ctx: ctx)
  )
}

fn stage0_unit_raw_reach_outcome_enrolled(
  unit_id: CompilationUnitId,
  edges: List<ModuleDagEdge>
) -> Stage0UnitRawReachOutcome {
  stage0_unit_raw_reach_outcome(
    unit_id: unit_id,
    edges: edges,
    ctx: Stage0PartitionDerivationContextEnrolled
  )
}

type Stage0UnitIdsReachingModuleOutcome
  = Stage0UnitIdsReachingModuleOk { reachers: List<CompilationUnitId> }
  | Stage0UnitIdsReachingModuleRefused {
      cause: Stage0UnitMembershipFoldRefusalCause
    }

type Stage0OwnedMembersFromRawReachOutcome
  = Stage0OwnedMembersFromRawReachOk { members: List<ModuleId> }
  | Stage0OwnedMembersFromRawReachRefused {
      cause: Stage0UnitMembershipFoldRefusalCause
    }

type Stage0UnitReachDispositionsOutcome
  = Stage0UnitReachDispositionsOk {
      rows: List<Stage0UnitModuleReachDispositionRow>
    }
  | Stage0UnitReachDispositionsRefused {
      cause: Stage0UnitMembershipFoldRefusalCause
    }

fn stage0_unit_ids_reaching_module_from_raw_reach_outcome(
  module: ModuleId,
  unit_ids: List<CompilationUnitId>,
  raw_members_by_unit: Map<CompilationUnitId, List<ModuleId>>
) -> Stage0UnitIdsReachingModuleOutcome {
  fold_list(
    xs: unit_ids,
    empty: Stage0UnitIdsReachingModuleOk { reachers: [] },
    cons: fn(acc, unit_id) {
      match acc {
        Stage0UnitIdsReachingModuleRefused { cause: _ } => acc
        Stage0UnitIdsReachingModuleOk { reachers: reachers } =>
          match map_get(raw_members_by_unit, unit_id) {
            Accepted { value: Present { value: members }, diagnostics: _ } =>
              if stage0_module_id_list_contains(xs: members, item: module) {
                Stage0UnitIdsReachingModuleOk {
                  reachers: stage0_compilation_unit_id_list_snoc_unique(
                    xs: reachers,
                    item: unit_id
                  )
                }
              } else {
                Stage0UnitIdsReachingModuleOk { reachers: reachers }
              }
            Accepted { value: Absent, diagnostics: _ } =>
              Stage0UnitIdsReachingModuleRefused {
                cause: Stage0PartitionMissingRawReachPopulation { unit_id: unit_id }
              }
            Rejected { diagnostics: _ } =>
              Stage0UnitIdsReachingModuleRefused {
                cause: Stage0PartitionMissingRawReachPopulation { unit_id: unit_id }
              }
          }
      }
    }
  )
}

fn stage0_collect_raw_members_by_unit(
  unit_ids: List<CompilationUnitId>,
  edges: List<ModuleDagEdge>,
  ctx: Stage0PartitionDerivationContext
) -> Stage0DerivedPartitionOutcome {
  fold_list(
    xs: unit_ids,
    empty: Stage0DerivedPartitionOk {
      assignment: empty_map(),
      members_by_unit: empty_map(),
      reach_dispositions_by_unit: empty_map()
    },
    cons: fn(acc, unit_id) {
      match acc {
        Stage0DerivedPartitionRefused { cause: _ } => acc
        Stage0DerivedPartitionOk { assignment: _, members_by_unit: raw_members_by_unit, reach_dispositions_by_unit: _ } =>
          match stage0_unit_raw_reach_outcome(
            unit_id: unit_id,
            edges: edges,
            ctx: ctx
          ) {
            Stage0UnitRawReachRefused { cause: cause } =>
              Stage0DerivedPartitionRefused { cause: cause }
            Stage0UnitRawReachOk { members: members } =>
              Stage0DerivedPartitionOk {
                assignment: empty_map(),
                members_by_unit: map_insert(raw_members_by_unit, unit_id, members),
                reach_dispositions_by_unit: empty_map()
              }
          }
      }
    }
  )
}

fn stage0_reach_disposition_for_unit_module(
  ctx: Stage0PartitionDerivationContext,
  unit_id: CompilationUnitId,
  module: ModuleId,
  owner: CompilationUnitId
) -> Stage0PartitionReachDisposition {
  if owner == unit_id {
    Stage0PartitionReachMember
  } else if stage0_derivation_unit_reexports_package(
    ctx: ctx,
    claimer: unit_id,
    owner: owner
  ) {
    Stage0PartitionSharedDependencyThroughPackage {
      module: module,
      owner_package: stage0_derivation_package_name(ctx: ctx, unit_id: owner)
    }
  } else {
    Stage0PartitionUnroutedCrossUnitReach {
      module: module,
      claimer: unit_id,
      owner: owner
    }
  }
}

type Stage0UnroutedReachScanOutcome
  = Stage0UnroutedReachAbsent
  | Stage0UnroutedReachFound {
      cause: Stage0UnitMembershipFoldRefusalCause
    }

fn stage0_scan_rows_for_unrouted_refusal(
  rows: List<Stage0UnitModuleReachDispositionRow>
) -> Stage0UnroutedReachScanOutcome {
  fold_list(
    xs: rows,
    empty: Stage0UnroutedReachAbsent,
    cons: fn(acc, row) {
      match acc {
        Stage0UnroutedReachFound { cause: _ } => acc
        Stage0UnroutedReachAbsent =>
          match row.disposition {
            Stage0PartitionUnroutedCrossUnitReach {
              module: module,
              claimer: claimer,
              owner: owner
            } =>
              Stage0UnroutedReachFound {
                cause: Stage0UnitMembershipReachRefused {
                  disposition: Stage0PartitionUnroutedCrossUnitReach {
                    module: module,
                    claimer: claimer,
                    owner: owner
                  }
                }
              }
            _ => Stage0UnroutedReachAbsent
          }
      }
    }
  )
}

fn stage0_owned_members_from_raw_reach_outcome(
  unit_id: CompilationUnitId,
  raw_members: List<ModuleId>,
  assignment: Map<ModuleId, CompilationUnitId>
) -> Stage0OwnedMembersFromRawReachOutcome {
  fold_list(
    xs: raw_members,
    empty: Stage0OwnedMembersFromRawReachOk { members: [] },
    cons: fn(acc, member) {
      match acc {
        Stage0OwnedMembersFromRawReachRefused { cause: _ } => acc
        Stage0OwnedMembersFromRawReachOk { members: members } =>
          match map_get(assignment, member) {
            Accepted { value: Present { value: owner }, diagnostics: _ } =>
              if owner == unit_id {
                Stage0OwnedMembersFromRawReachOk {
                  members: stage0_module_id_list_snoc_unique(xs: members, item: member)
                }
              } else {
                Stage0OwnedMembersFromRawReachOk { members: members }
              }
            Accepted { value: Absent, diagnostics: _ } =>
              Stage0OwnedMembersFromRawReachRefused {
                cause: Stage0PartitionMissingAssignment { module: member }
              }
            Rejected { diagnostics: _ } =>
              Stage0OwnedMembersFromRawReachRefused {
                cause: Stage0PartitionMissingAssignment { module: member }
              }
          }
      }
    }
  )
}

fn stage0_build_unit_reach_dispositions_outcome(
  ctx: Stage0PartitionDerivationContext,
  unit_id: CompilationUnitId,
  raw_members: List<ModuleId>,
  assignment: Map<ModuleId, CompilationUnitId>
) -> Stage0UnitReachDispositionsOutcome {
  fold_list(
    xs: raw_members,
    empty: Stage0UnitReachDispositionsOk { rows: [] },
    cons: fn(acc, member) {
      match acc {
        Stage0UnitReachDispositionsRefused { cause: _ } => acc
        Stage0UnitReachDispositionsOk { rows: rows } =>
          match map_get(assignment, member) {
            Accepted { value: Present { value: owner }, diagnostics: _ } =>
              Stage0UnitReachDispositionsOk {
                rows: rows
                  |> concat([
                    Stage0UnitModuleReachDispositionRow {
                      module: member,
                      disposition: stage0_reach_disposition_for_unit_module(
                        ctx: ctx,
                        unit_id: unit_id,
                        module: member,
                        owner: owner
                      )
                    }
                  ])
              }
            Accepted { value: Absent, diagnostics: _ } =>
              Stage0UnitReachDispositionsRefused {
                cause: Stage0PartitionMissingAssignment { module: member }
              }
            Rejected { diagnostics: _ } =>
              Stage0UnitReachDispositionsRefused {
                cause: Stage0PartitionMissingAssignment { module: member }
              }
          }
      }
    }
  )
}

fn stage0_derived_partition_assign_module(
  ctx: Stage0PartitionDerivationContext,
  assignment: Map<ModuleId, CompilationUnitId>,
  member_module: ModuleId,
  unit_ids: List<CompilationUnitId>,
  raw_members_by_unit: Map<CompilationUnitId, List<ModuleId>>
) -> Stage0DerivedPartitionOutcome {
  match stage0_unit_ids_reaching_module_from_raw_reach_outcome(
    module: member_module,
    unit_ids: unit_ids,
    raw_members_by_unit: raw_members_by_unit
  ) {
    Stage0UnitIdsReachingModuleRefused { cause: cause } =>
      Stage0DerivedPartitionRefused { cause: cause }
    Stage0UnitIdsReachingModuleOk { reachers: reachers } =>
      match stage0_module_owner_from_reachers(
        ctx: ctx,
        module: member_module,
        reachers: reachers
      ) {
        Stage0ModuleOwnershipConflict { module: _, reachers: conflict_reachers } =>
          Stage0DerivedPartitionRefused {
            cause: Stage0UnitMembershipReachRefused {
              disposition: Stage0PartitionAssignmentConflict {
                collision: Stage0PartitionAssignmentCollisionCause {
                  module: member_module,
                  reachers: conflict_reachers
                }
              }
            }
          }
        Stage0ModuleOwnershipOk { owner: owner } =>
          Stage0DerivedPartitionOk {
            assignment: map_insert(assignment, member_module, owner),
            members_by_unit: empty_map(),
            reach_dispositions_by_unit: empty_map()
          }
      }
  }
}

fn stage0_derived_partition_build_assignment(
  ctx: Stage0PartitionDerivationContext,
  unit_ids: List<CompilationUnitId>,
  domain_modules: List<ModuleId>,
  raw_members_by_unit: Map<CompilationUnitId, List<ModuleId>>
) -> Stage0DerivedPartitionOutcome {
  fold_list(
    xs: domain_modules,
    empty: Stage0DerivedPartitionOk {
      assignment: empty_map(),
      members_by_unit: empty_map(),
      reach_dispositions_by_unit: empty_map()
    },
    cons: fn(acc, member_module) {
      match acc {
        Stage0DerivedPartitionRefused { cause: _ } => acc
        Stage0DerivedPartitionOk { assignment: assignment, members_by_unit: _, reach_dispositions_by_unit: _ } =>
          stage0_derived_partition_assign_module(
            ctx: ctx,
            assignment: assignment,
            member_module: member_module,
            unit_ids: unit_ids,
            raw_members_by_unit: raw_members_by_unit
          )
      }
    }
  )
}

fn stage0_derived_partition_build_result(
  ctx: Stage0PartitionDerivationContext,
  assignment: Map<ModuleId, CompilationUnitId>,
  unit_ids: List<CompilationUnitId>,
  raw_members_by_unit: Map<CompilationUnitId, List<ModuleId>>
) -> Stage0DerivedPartitionOutcome {
  fold_list(
    xs: unit_ids,
    empty: Stage0DerivedPartitionOk {
      assignment: assignment,
      members_by_unit: empty_map(),
      reach_dispositions_by_unit: empty_map()
    },
    cons: fn(acc, unit_id) {
      match acc {
        Stage0DerivedPartitionRefused { cause: _ } => acc
        Stage0DerivedPartitionOk { assignment: kept_assignment, members_by_unit: members_by_unit, reach_dispositions_by_unit: reach_dispositions_by_unit } =>
          match map_get(raw_members_by_unit, unit_id) {
            Accepted { value: Present { value: raw_members }, diagnostics: _ } =>
              match stage0_build_unit_reach_dispositions_outcome(
                ctx: ctx,
                unit_id: unit_id,
                raw_members: raw_members,
                assignment: kept_assignment
              ) {
                Stage0UnitReachDispositionsRefused { cause: cause } =>
                  Stage0DerivedPartitionRefused { cause: cause }
                Stage0UnitReachDispositionsOk { rows: disposition_rows } =>
                  match stage0_scan_rows_for_unrouted_refusal(rows: disposition_rows) {
                    Stage0UnroutedReachFound { cause: cause } =>
                      Stage0DerivedPartitionRefused { cause: cause }
                    Stage0UnroutedReachAbsent =>
                      match stage0_owned_members_from_raw_reach_outcome(
                        unit_id: unit_id,
                        raw_members: raw_members,
                        assignment: kept_assignment
                      ) {
                        Stage0OwnedMembersFromRawReachRefused { cause: cause } =>
                          Stage0DerivedPartitionRefused { cause: cause }
                        Stage0OwnedMembersFromRawReachOk { members: owned_members } =>
                          Stage0DerivedPartitionOk {
                            assignment: kept_assignment,
                            members_by_unit: map_insert(
                              members_by_unit,
                              unit_id,
                              owned_members
                            ),
                            reach_dispositions_by_unit: map_insert(
                              reach_dispositions_by_unit,
                              unit_id,
                              disposition_rows
                            )
                          }
                      }
                  }
              }
            Accepted { value: Absent, diagnostics: _ } =>
              Stage0DerivedPartitionRefused {
                cause: Stage0PartitionMissingRawReachPopulation { unit_id: unit_id }
              }
            Rejected { diagnostics: _ } =>
              Stage0DerivedPartitionRefused {
                cause: Stage0PartitionMissingRawReachPopulation { unit_id: unit_id }
              }
          }
      }
    }
  )
}

fn stage0_derived_partition_outcome_for_context(
  ctx: Stage0PartitionDerivationContext,
  unit_ids: List<CompilationUnitId>
) -> Stage0DerivedPartitionOutcome {
  let edges = stage0_derivation_edges(ctx: ctx)
  let domain_modules = stage0_derivation_domain_basenames(ctx: ctx)
    |> map(basename => stage0_module_id(basename: basename))
  match stage0_collect_raw_members_by_unit(
    unit_ids: unit_ids,
    edges: edges,
    ctx: ctx
  ) {
    Stage0DerivedPartitionRefused { cause: cause } =>
      Stage0DerivedPartitionRefused { cause: cause }
    Stage0DerivedPartitionOk { assignment: _, members_by_unit: raw_members_by_unit, reach_dispositions_by_unit: _ } =>
      match stage0_derived_partition_build_assignment(
        ctx: ctx,
        unit_ids: unit_ids,
        domain_modules: domain_modules,
        raw_members_by_unit: raw_members_by_unit
      ) {
        Stage0DerivedPartitionRefused { cause: cause } =>
          Stage0DerivedPartitionRefused { cause: cause }
        Stage0DerivedPartitionOk { assignment: assignment, members_by_unit: _, reach_dispositions_by_unit: _ } =>
          stage0_derived_partition_build_result(
            ctx: ctx,
            assignment: assignment,
            unit_ids: unit_ids,
            raw_members_by_unit: raw_members_by_unit
          )
      }
  }
}

fn stage0_derived_partition_outcome_for_unit_order(
  unit_ids: List<CompilationUnitId>
) -> Stage0DerivedPartitionOutcome {
  stage0_derived_partition_outcome_for_context(
    ctx: Stage0PartitionDerivationContextEnrolled,
    unit_ids: unit_ids
  )
}

fn stage0_module_owner_candidate_valid(
  ctx: Stage0PartitionDerivationContext,
  candidate: CompilationUnitId,
  reachers: List<CompilationUnitId>
) -> Bool {
  reachers
    |> fold(init: true, f: fn(ok, other) {
      if other == candidate {
        ok
      } else {
        ok
          && !stage0_derivation_unit_reexports_package(
            ctx: ctx,
            claimer: candidate,
            owner: other
          )
      }
    })
}

fn stage0_module_owner_from_reachers(
  ctx: Stage0PartitionDerivationContext,
  module: ModuleId,
  reachers: List<CompilationUnitId>
) -> Stage0ModuleOwnershipOutcome {
  let reacher_count = reachers |> count
  if reacher_count == 0 {
    Stage0ModuleOwnershipConflict { module: module, reachers: [] }
  } else if reacher_count == 1 {
    match list_head(xs: reachers) {
      HeadAbsent =>
        Stage0ModuleOwnershipConflict { module: module, reachers: reachers }
      HeadFound { value: owner } =>
        Stage0ModuleOwnershipOk { owner: owner }
    }
  } else {
    let owner_candidates = reachers
      |> fold(init: [], f: fn(acc, candidate) {
        if stage0_module_owner_candidate_valid(
          ctx: ctx,
          candidate: candidate,
          reachers: reachers
        ) {
          stage0_compilation_unit_id_list_snoc_unique(xs: acc, item: candidate)
        } else {
          acc
        }
      })
    match owner_candidates |> count {
      1 =>
        match list_head(xs: owner_candidates) {
          HeadAbsent =>
            Stage0ModuleOwnershipConflict { module: module, reachers: reachers }
          HeadFound { value: owner } =>
            Stage0ModuleOwnershipOk { owner: owner }
        }
      _ => Stage0ModuleOwnershipConflict { module: module, reachers: reachers }
    }
  }
}

fn stage0_modules_owned_by_unit(
  assignment: Map<ModuleId, CompilationUnitId>,
  unit_id: CompilationUnitId,
  domain_modules: List<ModuleId>
) -> List<ModuleId> {
  domain_modules
    |> fold(init: [], f: fn(acc, member_module) {
      match map_get(assignment, member_module) {
        Accepted { value: owner_opt, diagnostics: _ } =>
          match owner_opt {
            Present { value: owner } =>
              if owner == unit_id {
                stage0_module_id_list_snoc_unique(xs: acc, item: member_module)
              } else {
                acc
              }
            Absent => acc
          }
        Rejected { diagnostics: _ } => acc
      }
    })
}

fn stage0_members_by_unit_lists_equal_for_unit(
  left: Map<CompilationUnitId, List<ModuleId>>,
  right: Map<CompilationUnitId, List<ModuleId>>,
  unit_id: CompilationUnitId
) -> Bool {
  match map_get(left, unit_id) {
    Accepted { value: left_opt, diagnostics: _ } =>
      match map_get(right, unit_id) {
        Accepted { value: right_opt, diagnostics: _ } =>
          match left_opt {
            Present { value: left_members } =>
              match right_opt {
                Present { value: right_members } =>
                  stage0_module_id_lists_equal_as_sets(
                    left: left_members,
                    right: right_members
                  )
                Absent => false
              }
            Absent =>
              match right_opt {
                Absent => true
                Present { value: _ } => false
              }
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn stage0_members_by_unit_equal(
  left: Map<CompilationUnitId, List<ModuleId>>,
  right: Map<CompilationUnitId, List<ModuleId>>,
  unit_ids: List<CompilationUnitId>
) -> Bool {
  unit_ids
    |> fold(init: true, f: fn(ok, unit_id) {
      ok
        && stage0_members_by_unit_lists_equal_for_unit(
          left: left,
          right: right,
          unit_id: unit_id
        )
    })
}

fn stage0_derived_partition_outcome() -> Stage0DerivedPartitionOutcome {
  stage0_derived_partition_outcome_for_unit_order(
    unit_ids: stage0_module_bearing_unit_ids()
  )
}

fn stage0_derived_assignment_succeeds_on_enrolled_graph() -> Bool {
  match stage0_derived_partition_outcome() {
    Stage0DerivedPartitionOk { assignment: _, members_by_unit: _, reach_dispositions_by_unit: _ } => true
    Stage0DerivedPartitionRefused { cause: _ } => false
  }
}

fn stage0_module_id_list_to_basenames(modules: List<ModuleId>) -> List<String> {
  modules
    |> fold(init: [], f: fn(acc, member_id) {
      acc |> concat([member_id as String])
    })
}

fn stage0_module_id_list_to_canonical_basenames(modules: List<ModuleId>) -> List<String> {
  stage0_module_id_list_to_basenames(modules: modules)
    |> sort_by(basename => basename)
}

fn stage0_derived_unit_member_basenames_from_members(
  members_by_unit: Map<CompilationUnitId, List<ModuleId>>,
  unit_id: CompilationUnitId
) -> List<String> {
  match map_get(members_by_unit, unit_id) {
    Accepted { value: members_opt, diagnostics: _ } =>
      match members_opt {
        Present { value: members } =>
          stage0_module_id_list_to_canonical_basenames(modules: members)
        Absent => []
      }
    Rejected { diagnostics: _ } => []
  }
}

fn stage0_interim_explicit_assignment_outcome() -> ResolvePartitionOutcome {
  match stage0_derived_partition_outcome() {
    Stage0DerivedPartitionRefused { cause: cause } =>
      ResolvePartitionRefused {
        cause: Stage0DerivedMembershipRefused { cause: cause }
      }
    Stage0DerivedPartitionOk { assignment: assignment, members_by_unit: _, reach_dispositions_by_unit: _ } =>
      ResolvePartitionOk { assignment: assignment }
  }
}

data stage0_partition_derived_membership_production_refusal_note: String = "Production partition membership is obtained only through outcome-shaped surfaces: stage0_derived_partition_outcome, stage0_partition_crate_rows_outcome, stage0_interim_explicit_assignment_outcome, and stage0_partition_receipt_outcome. stage0_partition_receipt_outcome and stage0_partition_r4_valid resolve through stage0_interim_explicit_assignment_outcome — not through an ExplicitPartition carrying assignment. Collapsing list/map projections of Stage0DerivedPartitionRefused are deleted from this carrier."

fn stage0_string_set_equality_duplicate_substitution_refuses_holds() -> Bool {
  !stage0_string_lists_equal_as_sets(left: ["a", "a"], right: ["a", "b"])
}

fn stage0_string_set_equality_order_independent_holds() -> Bool {
  stage0_string_lists_equal_as_sets(left: ["a", "b"], right: ["b", "a"])
}

fn stage0_string_set_equality_identical_holds() -> Bool {
  stage0_string_lists_equal_as_sets(left: ["a", "b"], right: ["a", "b"])
}

fn stage0_partition_missing_assignment_population_refuses_holds() -> Bool {
  let missing_module = stage0_module_id(basename: "stage0_partition_missing_assignment_probe")
  match stage0_owned_members_from_raw_reach_outcome(
    unit_id: stage0_unit_runtime,
    raw_members: [missing_module],
    assignment: empty_map()
  ) {
    Stage0OwnedMembersFromRawReachRefused {
      cause: Stage0PartitionMissingAssignment { module: module }
    } => module == missing_module
    _ => false
  }
}

fn stage0_partition_missing_raw_reach_population_refuses_holds() -> Bool {
  let probe_module = stage0_module_id(basename: "stage0_partition_missing_raw_reach_probe")
  match stage0_unit_ids_reaching_module_from_raw_reach_outcome(
    module: probe_module,
    unit_ids: [stage0_unit_runtime],
    raw_members_by_unit: empty_map()
  ) {
    Stage0UnitIdsReachingModuleRefused {
      cause: Stage0PartitionMissingRawReachPopulation { unit_id: unit_id }
    } => unit_id == stage0_unit_runtime
    _ => false
  }
}

fn stage0_partition_membership_closure_covers_seeds() -> Bool {
  match stage0_derived_partition_outcome() {
    Stage0DerivedPartitionOk { assignment: _, members_by_unit: members_by_unit, reach_dispositions_by_unit: _ } =>
      stage0_module_bearing_unit_ids()
        |> fold(init: true, f: fn(ok, unit_id) {
          let seeds = stage0_unit_seed_basenames(unit_id: unit_id)
            |> map(basename => stage0_module_id(basename: basename))
          match map_get(members_by_unit, unit_id) {
            Accepted { value: members_opt, diagnostics: _ } =>
              match members_opt {
                Present { value: members } =>
                  ok && seeds
                    |> fold(init: true, f: fn(seed_ok, seed) {
                      seed_ok && stage0_module_id_list_contains(xs: members, item: seed)
                    })
                Absent => false
              }
            Rejected { diagnostics: _ } => false
          }
        })
    Stage0DerivedPartitionRefused { cause: _ } => false
  }
}

fn stage0_partition_membership_order_independence() -> Bool {
  let unit_ids = stage0_module_bearing_unit_ids()
  let forward = stage0_derived_partition_outcome_for_unit_order(unit_ids: unit_ids)
  let reversed = stage0_derived_partition_outcome_for_unit_order(
    unit_ids: list_reverse(xs: unit_ids)
  )
  match forward {
    Stage0DerivedPartitionOk { assignment: _, members_by_unit: forward_members, reach_dispositions_by_unit: _ } =>
      match reversed {
        Stage0DerivedPartitionOk { assignment: _, members_by_unit: reversed_members, reach_dispositions_by_unit: _ } =>
          stage0_members_by_unit_equal(
            left: forward_members,
            right: reversed_members,
            unit_ids: unit_ids
          )
        Stage0DerivedPartitionRefused { cause: _ } => false
      }
    Stage0DerivedPartitionRefused { cause: _ } => false
  }
}

fn stage0_planted_partition_outcome(
  variant: Stage0PlantedPartitionVariant
) -> Stage0DerivedPartitionOutcome {
  stage0_derived_partition_outcome_for_context(
    ctx: Stage0PartitionDerivationContextPlanted { variant: variant },
    unit_ids: stage0_planted_low_high_unit_ids()
  )
}

fn stage0_reach_disposition_rows_contain_shared_dependency(
  rows: List<Stage0UnitModuleReachDispositionRow>,
  module: ModuleId
) -> Bool {
  fold_list(
    xs: rows,
    empty: false,
    cons: fn(found, row) {
      found
        || (row.module == module
          && match row.disposition {
            Stage0PartitionSharedDependencyThroughPackage { module: _, owner_package: _ } => true
            _ => false
          })
    }
  )
}

fn stage0_unit_has_shared_dependency_disposition(
  outcome: Stage0DerivedPartitionOutcome,
  unit_id: CompilationUnitId,
  module: ModuleId
) -> Bool {
  match outcome {
    Stage0DerivedPartitionRefused { cause: _ } => false
    Stage0DerivedPartitionOk { assignment: _, members_by_unit: _, reach_dispositions_by_unit: reach_dispositions_by_unit } =>
      match map_get(reach_dispositions_by_unit, unit_id) {
        Accepted { value: Present { value: rows }, diagnostics: _ } =>
          stage0_reach_disposition_rows_contain_shared_dependency(
            rows: rows,
            module: module
          )
        _ => false
      }
  }
}

fn stage0_planted_shared_dependency_fixture_holds() -> Bool {
  let l = stage0_module_id(basename: stage0_planted_basename_l)
  match stage0_planted_partition_outcome(
    variant: Stage0PlantedLowHighSharedDependency
  ) {
    Stage0DerivedPartitionRefused { cause: _ } => false
    Stage0DerivedPartitionOk { assignment: assignment, members_by_unit: members_by_unit, reach_dispositions_by_unit: _ } =>
      match map_get(assignment, l) {
        Accepted { value: Present { value: owner }, diagnostics: _ } =>
          owner == stage0_planted_unit_low
            && match map_get(members_by_unit, stage0_planted_unit_high) {
              Accepted { value: Present { value: high_raw }, diagnostics: _ } =>
                match stage0_owned_members_from_raw_reach_outcome(
                  unit_id: stage0_planted_unit_high,
                  raw_members: high_raw,
                  assignment: assignment
                ) {
                  Stage0OwnedMembersFromRawReachOk { members: owned_members } =>
                    !stage0_module_id_list_contains(xs: owned_members, item: l)
                  Stage0OwnedMembersFromRawReachRefused { cause: _ } => false
                }
              _ => false
            }
            && stage0_unit_has_shared_dependency_disposition(
              outcome: stage0_planted_partition_outcome(
                variant: Stage0PlantedLowHighSharedDependency
              ),
              unit_id: stage0_planted_unit_high,
              module: l
            )
        _ => false
      }
  }
}

fn stage0_planted_order_independence_holds() -> Bool {
  let unit_ids = stage0_planted_low_high_unit_ids()
  let ctx = Stage0PartitionDerivationContextPlanted {
    variant: Stage0PlantedLowHighSharedDependency
  }
  let forward = stage0_derived_partition_outcome_for_context(
    ctx: ctx,
    unit_ids: unit_ids
  )
  let reversed = stage0_derived_partition_outcome_for_context(
    ctx: ctx,
    unit_ids: list_reverse(xs: unit_ids)
  )
  match forward {
    Stage0DerivedPartitionOk { assignment: _, members_by_unit: forward_members, reach_dispositions_by_unit: _ } =>
      match reversed {
        Stage0DerivedPartitionOk { assignment: _, members_by_unit: reversed_members, reach_dispositions_by_unit: _ } =>
          stage0_members_by_unit_equal(
            left: forward_members,
            right: reversed_members,
            unit_ids: unit_ids
          )
        Stage0DerivedPartitionRefused { cause: _ } => false
      }
    Stage0DerivedPartitionRefused { cause: _ } => false
  }
}

fn stage0_planted_assignment_conflict_holds() -> Bool {
  match stage0_planted_partition_outcome(
    variant: Stage0PlantedLowHighAssignmentConflict
  ) {
    Stage0DerivedPartitionRefused {
      cause: Stage0UnitMembershipReachRefused {
        disposition: Stage0PartitionAssignmentConflict { collision: _ }
      }
    } => true
    _ => false
  }
}

fn stage0_planted_three_unit_unrouted_reach_refuses_holds() -> Bool {
  let ctx = Stage0PartitionDerivationContextPlanted {
    variant: Stage0PlantedThreeUnitUnroutedReach
  }
  let module_m = stage0_module_id(basename: stage0_planted_basename_m)
  let disposition = stage0_reach_disposition_for_unit_module(
    ctx: ctx,
    unit_id: stage0_planted_unit_high,
    module: module_m,
    owner: stage0_planted_unit_mid
  )
  let disposition_ok = match disposition {
    Stage0PartitionUnroutedCrossUnitReach {
      module: _,
      claimer: claimer,
      owner: owner
    } =>
      claimer == stage0_planted_unit_high && owner == stage0_planted_unit_mid
    Stage0PartitionSharedDependencyThroughPackage { module: _, owner_package: _ } => false
    _ => false
  }
  let scan_ok = match stage0_scan_rows_for_unrouted_refusal(
    rows: [
      Stage0UnitModuleReachDispositionRow {
        module: module_m,
        disposition: disposition
      }
    ]
  ) {
    Stage0UnroutedReachFound { cause: _ } => true
    Stage0UnroutedReachAbsent => false
  }
  disposition_ok && scan_ok
}

fn stage0_planted_separated_membership_differs_holds() -> Bool {
  let ctx_shared = Stage0PartitionDerivationContextPlanted {
    variant: Stage0PlantedLowHighSharedDependency
  }
  let ctx_separated = Stage0PartitionDerivationContextPlanted {
    variant: Stage0PlantedLowHighSeparated
  }
  match stage0_unit_raw_reach_outcome(
    unit_id: stage0_planted_unit_high,
    edges: stage0_derivation_edges(ctx: ctx_shared),
    ctx: ctx_shared
  ) {
    Stage0UnitRawReachRefused { cause: _ } => false
    Stage0UnitRawReachOk { members: shared_raw } =>
      match stage0_unit_raw_reach_outcome(
        unit_id: stage0_planted_unit_high,
        edges: stage0_derivation_edges(ctx: ctx_separated),
        ctx: ctx_separated
      ) {
        Stage0UnitRawReachRefused { cause: _ } => false
        Stage0UnitRawReachOk { members: separated_raw } =>
          !stage0_string_lists_equal_as_sets(
            left: stage0_module_id_list_to_basenames(modules: shared_raw),
            right: stage0_module_id_list_to_basenames(modules: separated_raw)
          )
      }
  }
}

fn stage0_planted_convergence_chain_succeeds_holds() -> Bool {
  match stage0_planted_partition_outcome(
    variant: Stage0PlantedLowHighConvergenceChain
  ) {
    Stage0DerivedPartitionOk { assignment: _, members_by_unit: _, reach_dispositions_by_unit: _ } => true
    Stage0DerivedPartitionRefused { cause: _ } => false
  }
}

data stage0_partition_witness_unit_a: CompilationUnitId = "stage0-partition-witness-unit-a" as CompilationUnitId
data stage0_partition_witness_unit_b: CompilationUnitId = "stage0-partition-witness-unit-b" as CompilationUnitId

fn stage0_partition_witness_shared_dependency_v1_rt_not_in_std_core_holds() -> Bool {
  match stage0_derived_partition_outcome() {
    Stage0DerivedPartitionRefused { cause: _ } => false
    Stage0DerivedPartitionOk { assignment: _, members_by_unit: members_by_unit, reach_dispositions_by_unit: _ } =>
      stage0_partition_witness_shared_dependency_v1_rt_not_in_std_core_from_members(
        members_by_unit: members_by_unit
      )
  }
}

fn stage0_partition_witness_shared_dependency_v1_rt_not_in_std_core_from_members(
  members_by_unit: Map<CompilationUnitId, List<ModuleId>>
) -> Bool {
  let std_core_members = stage0_derived_unit_member_basenames_from_members(
    members_by_unit: members_by_unit,
    unit_id: stage0_unit_std_core
  )
  !any(xs: std_core_members, predicate: fn(basename) { basename == "v1_rt" })
    && any(xs: std_core_members, predicate: fn(basename) { basename == "v1_std_core" })
}

fn stage0_partition_witness_nonconvergence_refuses_holds() -> Bool {
  let witness_seed = stage0_module_id(basename: "stage0_partition_witness_closure_seed")
  let witness_edges = [
    stage0_module_dag_edge(
      from: "stage0_partition_witness_closure_seed",
      to: "stage0_partition_witness_closure_tail"
    )
  ]
  match stage0_unit_raw_reach_fixpoint(
    members: [witness_seed],
    edges: witness_edges,
    remaining_steps: 0
  ) {
    Stage0UnitRawReachRefused {
      cause: Stage0UnitMembershipNonConvergent { steps_budget: _ }
    } => true
    _ => false
  }
}

fn stage0_partition_witness_assignment_conflict_refuses_holds() -> Bool {
  let witness_module = stage0_module_id(basename: "stage0_partition_witness_conflict_shared")
  let reachers = [
    stage0_partition_witness_unit_a,
    stage0_partition_witness_unit_b
  ]
  match stage0_module_owner_from_reachers(
    ctx: Stage0PartitionDerivationContextEnrolled,
    module: witness_module,
    reachers: reachers
  ) {
    Stage0ModuleOwnershipConflict { module: conflict_module, reachers: conflict_reachers } =>
      conflict_module == witness_module
        && (conflict_reachers |> count) == 2
        && stage0_compilation_unit_id_list_contains(
          xs: conflict_reachers,
          item: stage0_partition_witness_unit_a
        )
        && stage0_compilation_unit_id_list_contains(
          xs: conflict_reachers,
          item: stage0_partition_witness_unit_b
        )
    _ => false
  }
}

fn stage0_partition_witness_assignment_conflict_cause_carries_reachers_holds() -> Bool {
  let witness_module = stage0_module_id(basename: "stage0_partition_witness_conflict_shared")
  let raw_members_by_unit = map_insert(
    map_insert(
      empty_map(),
      stage0_partition_witness_unit_a,
      [witness_module]
    ),
    stage0_partition_witness_unit_b,
    [witness_module]
  )
  match stage0_derived_partition_assign_module(
    ctx: Stage0PartitionDerivationContextEnrolled,
    assignment: empty_map(),
    member_module: witness_module,
    unit_ids: [
      stage0_partition_witness_unit_a,
      stage0_partition_witness_unit_b
    ],
    raw_members_by_unit: raw_members_by_unit
  ) {
    Stage0DerivedPartitionRefused {
      cause: Stage0UnitMembershipReachRefused {
        disposition: Stage0PartitionAssignmentConflict {
          collision: Stage0PartitionAssignmentCollisionCause {
            module: conflict_module,
            reachers: conflict_reachers
          }
        }
      }
    } =>
      conflict_module == witness_module
        && (conflict_reachers |> count) == 2
        && stage0_compilation_unit_id_list_contains(
          xs: conflict_reachers,
          item: stage0_partition_witness_unit_a
        )
        && stage0_compilation_unit_id_list_contains(
          xs: conflict_reachers,
          item: stage0_partition_witness_unit_b
        )
    _ => false
  }
}

data stage0_partition_red_control_synthetic_module: String = "synthetic_unassigned_module"

fn stage0_string_list_contains(xs: List<String>, item: String) -> Bool {
  any(xs: xs, predicate: fn(s) { s == item })
}

fn stage0_partition_red_control_synthetic_module_not_in_derived_holds() -> Bool {
  match stage0_derived_partition_outcome() {
    Stage0DerivedPartitionRefused { cause: _ } => false
    Stage0DerivedPartitionOk { assignment: _, members_by_unit: members_by_unit, reach_dispositions_by_unit: _ } =>
      stage0_module_bearing_unit_ids()
        |> fold(init: true, f: fn(ok, unit_id) {
          let derived = stage0_derived_unit_member_basenames_from_members(
            members_by_unit: members_by_unit,
            unit_id: unit_id
          )
          ok
            && !stage0_string_list_contains(
              xs: derived,
              item: stage0_partition_red_control_synthetic_module
            )
        })
  }
}

fn stage0_partition_derived_refusal_propagates_to_receipt_holds() -> Bool {
  match stage0_derived_partition_outcome() {
    Stage0DerivedPartitionRefused { cause: _ } =>
      match stage0_partition_receipt_outcome() {
        Stage0PartitionReceiptResolveRefused {
          cause: Stage0DerivedMembershipRefused { cause: _ }
        } => true
        _ => false
      }
    Stage0DerivedPartitionOk { assignment: _, members_by_unit: _, reach_dispositions_by_unit: _ } =>
      match stage0_partition_receipt_outcome() {
        Stage0PartitionReceiptOk { units: units } => (units |> count) > 0
        _ => false
      }
  }
}

fn stage0_partition_crate_rows_refusal_propagates_holds() -> Bool {
  match stage0_derived_partition_outcome() {
    Stage0DerivedPartitionRefused { cause: _ } =>
      match stage0_partition_crate_rows_outcome() {
        Stage0PartitionCrateRowsRefused { cause: _ } => true
        Stage0PartitionCrateRowsOk { rows: _ } => false
      }
    Stage0DerivedPartitionOk { assignment: _, members_by_unit: _, reach_dispositions_by_unit: _ } =>
      match stage0_partition_crate_rows_outcome() {
        Stage0PartitionCrateRowsOk { rows: rows } => (rows |> count) == rust_crate_partition_declared_core_target
        Stage0PartitionCrateRowsRefused { cause: _ } => false
      }
  }
}

