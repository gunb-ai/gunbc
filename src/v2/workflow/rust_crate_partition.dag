  [
    stage0_module_dag_edge(from: "std_algebra", to: "std_error_primitives"),
    stage0_module_dag_edge(from: "std_nat", to: "std_algebra"),
    stage0_module_dag_edge(from: "std_node", to: "std_induction"),
    stage0_module_dag_edge(from: "std_syntax", to: "std_node"),
    stage0_module_dag_edge(from: "std_computation", to: "std_algebra"),
    stage0_module_dag_edge(from: "std_computation", to: "std_termination"),
    stage0_module_dag_edge(from: "std_termination", to: "std_algebra"),
    stage0_module_dag_edge(from: "std_induction", to: "std_computation"),
    stage0_module_dag_edge(from: "std_induction", to: "std_termination"),
    stage0_module_dag_edge(from: "std_graph", to: "std_termination"),
    stage0_module_dag_edge(from: "std_effects", to: "std_types"),
    stage0_module_dag_edge(from: "std_execution_mode", to: "std_types"),
    stage0_module_dag_edge(from: "std_interface_summary", to: "std_decl_ref"),
    stage0_module_dag_edge(from: "std_interface_summary", to: "std_disposition"),
    stage0_module_dag_edge(from: "std_pareto", to: "std_algebra"),
    stage0_module_dag_edge(from: "std_realization_schedule", to: "std_execution_mode"),
    stage0_module_dag_edge(from: "std_realization_schedule", to: "std_measure"),
    stage0_module_dag_edge(from: "std_realization_schedule", to: "std_pareto"),
    stage0_module_dag_edge(from: "extdeps_external_authority", to: "extdeps_uri"),
    stage0_module_dag_edge(from: "extdeps_languages_dag_syntax", to: "std_syntax"),
    stage0_module_dag_edge(from: "extdeps_languages_go_syntax", to: "std_syntax"),
    stage0_module_dag_edge(from: "extdeps_languages_python_syntax", to: "std_syntax"),
    stage0_module_dag_edge(from: "extdeps_languages_rust_syntax", to: "std_syntax"),
    stage0_module_dag_edge(from: "v1_compiler_infer_sigs", to: "std_induction"),
    stage0_module_dag_edge(from: "v1_compiler_infer_service", to: "v1_compiler_infer_items"),
    stage0_module_dag_edge(from: "v1_compiler_infer_types", to: "v1_compiler_infer_items"),
