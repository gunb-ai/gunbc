type PartitionPolicy {
  target_crate_count: Int
}

type ExplicitPartition {
  assignment: Map<ModuleId, CompilationUnitId>
}

type PartitionParameter
  = ExplicitPartitionParam { partition: ExplicitPartition }
  | PolicyPartitionParam { policy: PartitionPolicy }

// Every refusal names the module or the Rust rule it is about. An assignment is admitted only when
// every module of the DAG has exactly one owner (the Map gives uniqueness; coverage and the absence
// of strangers are checked here) and the R4 verdict is valid -- on BOTH arms, because a partition an
// author supplied is no more trusted than one the policy derived.
type ResolvePartitionRefusalCause
  = PolicyTargetCountNotPositive { policy: PartitionPolicy }
  | AssignmentOmitsModule { module_id: ModuleId }
  | AssignmentNamesModuleOutsideDag { module_id: ModuleId }
  | PartitionRustAdmissibilityRefused { cause: PartitionR4ValidityCause }

type ResolvePartitionOutcome
  = ResolvePartitionOk {
      assignment: Map<ModuleId, CompilationUnitId>
      provenance: PartitionProvenance
    }
  | ResolvePartitionRefused { cause: ResolvePartitionRefusalCause }

type Stage0PartitionReceiptOutcome
  = Stage0PartitionReceiptOk { units: List<CompilationUnit> }
  | Stage0PartitionReceiptResolveRefused { cause: ResolvePartitionRefusalCause }
  | Stage0PartitionReceiptFoldRefused { cause: PartitionFoldRefusalCause }

type Stage0PartitionCrateKind
  = Stage0FoundationCrate
  | Stage0LayeredCoreCrate
  | Stage0EmitCoreCrate

type Stage0PartitionCrateRow {
  unit_id: CompilationUnitId
  package_name: String
  crate_dir: String
  kind: Stage0PartitionCrateKind
  modules: List<String>
  reexport_packages: List<String>
  carries_non_empty_wrappers: Bool
}

// Rust R3 workflow realization of the shared CompilationUnit home
// (emitted-crate-partition-design.md §2/§13). resolve_partition_outcome is the sole entry for the
// assignment Map; partition_fold_outcome is the sole producer of interface + deps. Phase 0:
// HandExplicit provenance + ExplicitPartition interim ~8-crate layered grouping (dissolves to
// PolicyPartition when balanced crates≈cores policy lands).

data rust_crate_partition_declared_core_target: Int = 7

data rust_crate_partition_module_bearing_unit_target: Int = 6

// R3-only emit shell crate (reexport surface, NOT a partition_fold_outcome CompilationUnit): modules list
// is the reexport bundle for render at cutover; those modules remain owned by module-bearing units
// in stage0_interim_explicit_assignment. Physical crate count = module_bearing (6) + emit_shell (1)
// = declared_core_target (7).

data stage0_unit_runtime: CompilationUnitId = "stage0-unit-runtime" as CompilationUnitId
data stage0_unit_std_primitives: CompilationUnitId = "stage0-unit-std-primitives" as CompilationUnitId
data stage0_unit_std_core: CompilationUnitId = "stage0-unit-std-core" as CompilationUnitId
data stage0_unit_std_surface: CompilationUnitId = "stage0-unit-std-surface" as CompilationUnitId
data stage0_unit_extdeps: CompilationUnitId = "stage0-unit-extdeps" as CompilationUnitId
data stage0_unit_v1_infer: CompilationUnitId = "stage0-unit-v1-infer" as CompilationUnitId
data stage0_unit_extdeps_languages: CompilationUnitId = "stage0-unit-extdeps-languages" as CompilationUnitId
data stage0_unit_v1_artifact: CompilationUnitId = "stage0-unit-v1-artifact" as CompilationUnitId
data stage0_unit_emit_core: CompilationUnitId = "stage0-unit-emit-core" as CompilationUnitId

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: RealizationDispatch }
}

type Stage0ModuleDagInterfaceGrounding
  = Stage0ModuleDagInterfaceSourceGrounded
  | Stage0ModuleDagInterfaceUngrounded {
      exports_map: ExportsMapNotSourceGrounded
      type_definitions_map: TypeDefinitionsMapNotSourceGrounded
    }

type ExportsMapNotSourceGrounded {
  capability: InterfaceGroundingCapability
}

type TypeDefinitionsMapNotSourceGrounded {
  capability: InterfaceGroundingCapability
}

// The capability that retires this debt, as STRUCTURE rather than prose. A DeclarationRef names a
// declaration and nothing else, so one ref could only ever pin the supply; the other two halves of
// the trigger -- that the supply be host-emitted, and the population it must be sufficient for --
// were a String a program could only grep. Each is a field here so a reader matches on it.
//   host_emission     joins the dissolution already declared for the supply's hand host handler,
//                     rather than opening a second one for the same event.
//   contents_supply   the supply whose rows must carry per-module declaration contents; today they
//                     carry module, provenance and root only, which is why this is still debt.
//   population        the derivation whose closure the contents must be complete for -- the emitted
//                     compiler closure, not a fixture.
// Named by ref, not imported: v2.workflow.emitted_closure_crate_partition imports this module.
type InterfaceGroundingCapability {
  host_emission: DeclarationRef
  contents_supply: DeclarationRef
  population: DeclarationRef
}

// Interim: ModuleDag.exports + type_definitions carry per-module keys with empty lists (structural
// scaffold for partition_fold_outcome only). R3 render uses Stage0PartitionCrateRow.modules +
// reexport_packages wildcard pub-use chain — not CompilationUnit.interface Nodes, which is why the
// R3 crate rendering does NOT wait on this debt. Full Node-carrier exports are blocked on the
// module-binding SUPPLY carrying per-module declaration contents at closure scale; the index
// itself cannot supply them, and this sentence used to say it could (the annotation above
// stage0_module_interface_grounding_target records why two dissolve targets got that wrong).

// Rust R4 primary refusals: SccSplit + UnitGraphCycle (LinkageCycle permissive). ByValueTypeCycle
// has LANDED on the home coproduct and is refused by the C realization, not by Rust — type-layout
// cycles use ByValueTypeCycle { detail } ONLY, never SccSplit. The sentence this replaces still
// described that arm as arriving with a rebase and instructed exhaustive PartitionR4ValidityCause
// matches to add a fourth arm on it; both were already done.

// REPOINTED TWICE, AND THE SECOND TARGET WAS WRONG IN THE SAME WAY AS THE FIRST. This debt's
// dissolution first named v2.compiler.self_host.frontier compiler_frontier_roster, on the premise
// that the self-host roster would eventually carry each module's exports and type definitions. It
// never could: a roster row carried a module path and a self-host disposition and nothing else, so
// the pointer named an authority that was not going to supply the fact even in principle.
//
// It was then repointed at v2.compiler.source_authority ModuleStorageIndex, reasoning that this is
// where module identity is DERIVED at parse rather than authored. That pointer failed the same
// test. A ModuleStorageBinding carries a module QualifiedName, a ModuleStorageProvenance and a
// SourceRootRef; the provenance carries an Artifact, which is kind, id and file_path. So a row
// carries a NAME, a LOCATION and a source root, and no declaration appears anywhere in that
// closure. It cannot supply exported declaration Nodes or ModuleTypeDefinitionRows any more than a
// roster row could.
//
// THE TELL, so a third repoint does not repeat it: a dissolve target is not checked by whether the
// fact is derived at the right TIME but by whether the named authority CARRIES the right FACT.
// Module IDENTITY derived at parse is the wrong property; what the interface maps need is module
// CONTENTS derived at parse. The first note diagnosed exactly this and then named another
// module-to-location authority.
//
// WHERE THE FACT ACTUALLY IS, and it is not missing. source_authority already parses every module:
// module_storage_binding_from_read_prepared tokenizes and calls parse_module_prepared, and
// module_storage_binding_from_parse_artifact hands artifact.tree to
// module_storage_binding_from_provenance as `node:`. The module root is IN HAND at the mint site
// and dropped there, deliberately -- module_storage_binding_authority_note earns that scope by
// saying the binding never needed file CONTENTS, only module and path. So the projection belongs
// at that mint site and needs no second read of the source, let alone a third.
//
// WHY IT IS STILL DEBT is not restated here. The operative trigger lives on the typed carrier,
// stage0_module_dag_interface_grounding_debt_dissolve_on, because that is the declaration a
// program can read; an annotation is never evidence that a machine claim holds (DESIGN 4c), and a
// second prose copy of the trigger would be the §3 fork a disclaimer cannot talk its way out of.
// What is above is the irreducible rationale for the SHAPE of that trigger -- why two earlier
// targets were named and why both could not work -- which is what this channel is for.
fn stage0_module_interface_grounding_target() -> DeclarationRef {
  DeclarationRef {
    module_path: "v2.compiler.source_authority" as NonEmptyStr,
    decl_name: "module_storage_bindings_for_source_roots" as NonEmptyStr,
    field: WholeDeclaration,
  }
}

fn stage0_module_interface_grounding_capability() -> InterfaceGroundingCapability {
  InterfaceGroundingCapability {
    host_emission: DeclarationRef {
      module_path: "v2.compiler.source_authority" as NonEmptyStr,
      decl_name: "module_storage_supply_dissolution_trigger" as NonEmptyStr,
      field: WholeDeclaration,
    },
    contents_supply: stage0_module_interface_grounding_target(),
    population: DeclarationRef {
      module_path: "v2.workflow.emitted_closure_crate_partition" as NonEmptyStr,
      decl_name: "module_dag_from_dependency_facts" as NonEmptyStr,
      field: WholeDeclaration,
    }
  }
}

fn stage0_module_dag_interface_grounding() -> Stage0ModuleDagInterfaceGrounding {
  Stage0ModuleDagInterfaceUngrounded {
    exports_map: ExportsMapNotSourceGrounded {
      capability: stage0_module_interface_grounding_capability()
    },
    type_definitions_map: TypeDefinitionsMapNotSourceGrounded {
      capability: stage0_module_interface_grounding_capability()
    }
  }
}

fn stage0_module_dag_interface_grounding_is_debt() -> Bool {
  match stage0_module_dag_interface_grounding() {
    Stage0ModuleDagInterfaceSourceGrounded => false
    Stage0ModuleDagInterfaceUngrounded { exports_map: _, type_definitions_map: _ } => true
  }
}

fn stage0_module_dag_exports_map() -> Map<ModuleId, List<Node>> {
  stage0_all_partitioned_modules()
    |> fold(init: empty_map(), f: fn(acc, basename) {
      map_insert(acc, stage0_module_id(basename: basename), Empty)
    })
}

fn stage0_module_dag_type_definitions_map() -> Map<ModuleId, List<ModuleTypeDefinitionRow>> {
  stage0_all_partitioned_modules()
    |> fold(init: empty_map(), f: fn(acc, basename) {
      map_insert(acc, stage0_module_id(basename: basename), Empty)
    })
}

fn stage0_module_id(basename: String) -> ModuleId {
  basename as NonEmptyStr
}

fn stage0_runtime_modules() -> List<String> {
  ["v1_rt"]
}

// std_lens_verdict WAS ON THIS LIST AND IS NOT A MODULE THE PARTITION MAY OWN.
// stage0 lib.rs does not declare it: v2.compiler.self_host.stage0_crate_layout registers
// it as a SeedRetainedIntrinsicRegistration with has_pub_mod false, so the monolith
// deliberately leaves it out while every partition crate carrying the row compiled it
// through a path include. That is one file with two compilation stories, which is the
// divergence this list must not author. Its source module std.lens_verdict no longer
// exists -- the live authority is v2.std.lens_verdict -- and nothing in the stage0 tree
// names crate::std_lens_verdict, so the row was answering for a module that had already
// stopped being one. The FILE's disposition (dead source retained under an undeclared
// reason in v2.compiler.self_host.seed_retention_frontier) is settled separately from
// this roster, because deleting it moves the layout authority and the retention frontier
// and this list is not where that decision lives.
