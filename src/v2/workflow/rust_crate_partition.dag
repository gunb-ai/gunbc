fn stage0_all_partitioned_modules() -> List<String> {
  stage0_runtime_modules()
    |> concat(stage0_std_primitive_modules())
    |> concat(stage0_std_structure_modules())
    |> concat(stage0_std_compute_modules())
    |> concat(stage0_std_surface_modules())
    |> concat(stage0_extdeps_modules())
    |> concat(stage0_v1_compiler_modules())
}

fn stage0_assign_modules_to_unit(
  assignment: Map<ModuleId, CompilationUnitId>,
  modules: List<String>,
  unit_id: CompilationUnitId
) -> Map<ModuleId, CompilationUnitId> {
  modules
    |> fold(init: assignment, f: fn(acc, basename) {
      map_insert(acc, stage0_module_id(basename: basename), unit_id)
    })
}

fn stage0_interim_explicit_assignment() -> Map<ModuleId, CompilationUnitId> {
  empty_map()
    |> stage0_assign_modules_to_unit(modules: stage0_runtime_modules(), unit_id: stage0_unit_runtime)
    |> stage0_assign_modules_to_unit(modules: stage0_std_primitive_modules(), unit_id: stage0_unit_std_primitives)
    |> stage0_assign_modules_to_unit(modules: stage0_std_structure_modules(), unit_id: stage0_unit_std_structure)
    |> stage0_assign_modules_to_unit(modules: stage0_std_compute_modules(), unit_id: stage0_unit_std_compute)
    |> stage0_assign_modules_to_unit(modules: stage0_std_surface_modules(), unit_id: stage0_unit_std_surface)
    |> stage0_assign_modules_to_unit(modules: stage0_extdeps_modules(), unit_id: stage0_unit_extdeps)
    |> stage0_assign_modules_to_unit(modules: stage0_v1_compiler_modules(), unit_id: stage0_unit_v1_compiler)
}

fn stage0_interim_explicit_partition() -> ExplicitPartition {
  ExplicitPartition { assignment: stage0_interim_explicit_assignment() }
}

fn stage0_partition_parameter() -> PartitionParameter {
  ExplicitPartitionParam { partition: stage0_interim_explicit_partition() }
}

fn stage0_partition_provenance() -> PartitionProvenance {
  partition_provenance_hand_explicit()
}

fn stage0_module_dag_edge(from: String, to: String) -> ModuleDagEdge {
  ModuleDagEdge {
    from: stage0_module_id(basename: from),
    to: stage0_module_id(basename: to),
  }
}

