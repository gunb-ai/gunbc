module v2.workflow.rust_crate_partition



type PartitionPolicy {
  target_crate_count: Int
}

type ExplicitPartition {
  assignment: Map<v2.std.compilers.compilation_unit.ModuleId, v2.std.compilers.compilation_unit.CompilationUnitId>
}

type PartitionParameter
  = ExplicitPartitionParam { partition: ExplicitPartition }
  | PolicyPartitionParam { policy: PartitionPolicy }

type PolicyResolverUnimplemented {
  policy: PartitionPolicy
}

type ResolvePartitionRefusalCause
  = PolicyResolverUnimplemented { policy: PartitionPolicy }

type ResolvePartitionOutcome
  = ResolvePartitionOk { assignment: Map<v2.std.compilers.compilation_unit.ModuleId, v2.std.compilers.compilation_unit.CompilationUnitId> }
  | ResolvePartitionRefused { cause: ResolvePartitionRefusalCause }

type Stage0PartitionReceiptOutcome
  = Stage0PartitionReceiptOk { units: List<v2.std.compilers.compilation_unit.CompilationUnit> }
  | Stage0PartitionReceiptResolveRefused { cause: ResolvePartitionRefusalCause }
  | Stage0PartitionReceiptFoldRefused { cause: v2.std.compilers.compilation_unit.PartitionFoldRefusalCause }

type Stage0PartitionCrateKind
  = Stage0FoundationCrate
  | Stage0LayeredCoreCrate
  | Stage0EmitCoreCrate

type Stage0PartitionCrateRow {
  unit_id: v2.std.compilers.compilation_unit.CompilationUnitId
  package_name: String
  crate_dir: String
  kind: Stage0PartitionCrateKind
  modules: List<String>
  reexport_packages: List<String>
  carries_non_empty_wrappers: Bool
}

data rust_crate_partition_note: String = "Rust R3 workflow realization of the shared CompilationUnit home (emitted-crate-partition-design.md §2/§13). resolve_partition_outcome is the sole entry for the assignment Map; partition_fold_outcome is the sole producer of interface + deps. Phase 0: HandExplicit provenance + ExplicitPartition interim ~8-crate layered grouping (dissolves to PolicyPartition when balanced crates≈cores policy lands)."

data rust_crate_partition_declared_core_target: Int = 7

data rust_crate_partition_module_bearing_unit_target: Int = 6

data stage0_r3_emit_shell_note: String = "R3-only emit shell crate (reexport surface, NOT a partition_fold CompilationUnit): modules list is the reexport bundle for render at cutover; those modules remain owned by module-bearing units in stage0_interim_explicit_assignment. Physical crate count = module_bearing (6) + emit_shell (1) = declared_core_target (7)."

data stage0_unit_runtime: v2.std.compilers.compilation_unit.CompilationUnitId = "stage0-unit-runtime" as v2.std.compilers.compilation_unit.CompilationUnitId
data stage0_unit_std_primitives: v2.std.compilers.compilation_unit.CompilationUnitId = "stage0-unit-std-primitives" as v2.std.compilers.compilation_unit.CompilationUnitId
data stage0_unit_std_core: v2.std.compilers.compilation_unit.CompilationUnitId = "stage0-unit-std-core" as v2.std.compilers.compilation_unit.CompilationUnitId
data stage0_unit_std_surface: v2.std.compilers.compilation_unit.CompilationUnitId = "stage0-unit-std-surface" as v2.std.compilers.compilation_unit.CompilationUnitId
data stage0_unit_extdeps: v2.std.compilers.compilation_unit.CompilationUnitId = "stage0-unit-extdeps" as v2.std.compilers.compilation_unit.CompilationUnitId
data stage0_unit_v1_infer: v2.std.compilers.compilation_unit.CompilationUnitId = "stage0-unit-v1-infer" as v2.std.compilers.compilation_unit.CompilationUnitId
data stage0_unit_extdeps_languages: v2.std.compilers.compilation_unit.CompilationUnitId = "stage0-unit-extdeps-languages" as v2.std.compilers.compilation_unit.CompilationUnitId
data stage0_unit_v1_artifact: v2.std.compilers.compilation_unit.CompilationUnitId = "stage0-unit-v1-artifact" as v2.std.compilers.compilation_unit.CompilationUnitId
data stage0_unit_emit_core: v2.std.compilers.compilation_unit.CompilationUnitId = "stage0-unit-emit-core" as v2.std.compilers.compilation_unit.CompilationUnitId

data construction_justification: v2.lens.common.construction_justification.ConstructionJustification = v2.lens.common.construction_justification.ConstructionJustification {
  class: v2.lens.common.construction_justification.WallAfterGrounding { dissolves_to: RealizationDispatch }
}

type Stage0ModuleDagInterfaceGrounding
  = Stage0ModuleDagInterfaceFrontierGrounded
  | Stage0ModuleDagInterfaceUngrounded {
      exports_map: ExportsMapNotFrontierGrounded
      type_definitions_map: TypeDefinitionsMapNotFrontierGrounded
    }

type ExportsMapNotFrontierGrounded {
  dissolve_target: std.decl_ref.DeclarationRef
}

type TypeDefinitionsMapNotFrontierGrounded {
  dissolve_target: std.decl_ref.DeclarationRef
}

data rust_crate_partition_interface_deferred_note: String = "Interim: ModuleDag.exports + type_definitions carry per-module keys with empty lists (structural scaffold for partition_fold only). R3 render uses Stage0PartitionCrateRow.modules + reexport_packages wildcard pub-use chain — not CompilationUnit.interface Nodes. Full Node-carrier exports blocked on stage0 module ingest supplying them through the path-module binding index (see stage0_grounding_target_repointed_note)."

data rust_crate_partition_r4_by_value_type_cycle_note: String = "Rust R4 primary refusals on current main: SccSplit + UnitGraphCycle (LinkageCycle permissive). ByValueTypeCycle arm lands with #6744 rebase — refuse type-layout cycles via ByValueTypeCycle { detail } ONLY, never SccSplit. Exhaustive PartitionR4ValidityCause matches must add the 4th arm on rebase."

data stage0_grounding_target_repointed_note: String = "REPOINTED, and the old target was wrong before it was deleted. This debt's dissolution used to name v2.compiler.self_host.frontier compiler_frontier_roster, on the premise that the self-host roster would eventually carry each module's exports and type definitions. It never could: a roster row carried a module path and a self-host disposition and nothing else, so the pointer named an authority that was not going to supply the fact even in principle. The roster is deleted, which is what surfaced the mispointing rather than causing it.

The real dependency is the path-module binding authority, which is where module identity is DERIVED at parse rather than authored — v2.compiler.source_authority module_storage_binding_authority_note states that the hand-authored qualified-module rows project from it, not the other way round. So the interface maps ground when stage0 module ingest supplies real Node-carrier exports through that index."

fn stage0_frontier_grounding_target() -> std.decl_ref.DeclarationRef {
  std.decl_ref.DeclarationRef {
    module_path: "v2.compiler.source_authority" as std.types.NonEmptyStr,
    decl_name: "ModuleStorageIndex" as std.types.NonEmptyStr,
    field: std.decl_ref.WholeDeclaration,
  }
}

fn stage0_module_dag_interface_grounding() -> Stage0ModuleDagInterfaceGrounding {
  Stage0ModuleDagInterfaceUngrounded {
    exports_map: ExportsMapNotFrontierGrounded {
      dissolve_target: stage0_frontier_grounding_target()
    },
    type_definitions_map: TypeDefinitionsMapNotFrontierGrounded {
      dissolve_target: stage0_frontier_grounding_target()
    }
  }
}

fn stage0_module_dag_interface_grounding_is_debt() -> Bool {
  match stage0_module_dag_interface_grounding() {
    Stage0ModuleDagInterfaceFrontierGrounded => false
    Stage0ModuleDagInterfaceUngrounded { exports_map: _, type_definitions_map: _ } => true
  }
}

fn stage0_module_dag_exports_map() -> Map<v2.std.compilers.compilation_unit.ModuleId, List<Node>> {
  stage0_all_partitioned_modules()
    |> fold(init: empty_map(), f: fn(acc, basename) {
      map_insert(acc, stage0_module_id(basename: basename), std.algebra.Empty)
    })
}

fn stage0_module_dag_type_definitions_map() -> Map<v2.std.compilers.compilation_unit.ModuleId, List<v2.std.compilers.compilation_unit.ModuleTypeDefinitionRow>> {
  stage0_all_partitioned_modules()
    |> fold(init: empty_map(), f: fn(acc, basename) {
      map_insert(acc, stage0_module_id(basename: basename), std.algebra.Empty)
    })
}

fn stage0_module_id(basename: String) -> v2.std.compilers.compilation_unit.ModuleId {
  basename as std.types.NonEmptyStr
}

