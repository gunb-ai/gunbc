      kind: Stage0LayeredCoreCrate,
      modules: stage0_v1_compiler_modules(),
      reexport_packages: [
        "v1-stage0-runtime",
        "v1-stage0-std-primitives",
        "v1-stage0-std-structure",
        "v1-stage0-std-compute",
