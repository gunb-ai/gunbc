}

fn stage0_r3_emit_shell_crate_row() -> Stage0PartitionCrateRow {
  Stage0PartitionCrateRow {
    unit_id: stage0_unit_emit_core,
    package_name: "v1-stage0-emit-core",
    crate_dir: "src/v1/stage0_emit_core",
    kind: Stage0EmitCoreCrate,
    modules: stage0_r3_emit_reexport_surface_modules(),
    reexport_packages: [],
    carries_non_empty_wrappers: false
  }
}

fn stage0_partition_crate_rows() -> List<Stage0PartitionCrateRow> {
  stage0_module_bearing_crate_rows()
    |> concat([stage0_r3_emit_shell_crate_row()])
}

fn stage0_partition_package_names() -> List<String> {
  stage0_partition_crate_rows() |> map(row => row.package_name)
}

fn stage0_physical_crate_count() -> Int {
  stage0_partition_crate_rows() |> count
}

fn stage0_module_bearing_unit_count() -> Int {
  stage0_module_bearing_crate_rows() |> count
}

fn stage0_module_owner_resolved_in_module_bearing_rows(module_basename: String) -> Bool {
  stage0_module_bearing_crate_rows()
    |> any(row => row.modules |> any(m => m == module_basename))
}

fn stage0_package_resolved_in_partition_rows(package_name: String) -> Bool {
  stage0_partition_crate_rows()
    |> any(row => row.package_name == package_name)
}

fn stage0_partition_row_lookups_resolved() -> Bool {
  let layered_ok = stage0_module_bearing_crate_rows()
    |> fold(init: true, f: fn(ok, row) {
      ok && row.reexport_packages
        |> fold(init: true, f: fn(p_ok, pkg) {
          p_ok && stage0_package_resolved_in_partition_rows(package_name: pkg)
        })
    })
  let emit_shell_ok = stage0_r3_emit_reexport_surface_modules()
    |> fold(init: true, f: fn(m_ok, module_basename) {
      m_ok && stage0_module_owner_resolved_in_module_bearing_rows(module_basename: module_basename)
    })
  layered_ok && emit_shell_ok
}

fn stage0_partition_r4_valid() -> Bool {
  let dag = stage0_module_dag()
  match resolve_partition_outcome(
    parameter: stage0_partition_parameter(),
    module_dag: dag
  ) {
    ResolvePartitionOk { assignment: assignment } =>
      match partition_fold_outcome(module_dag: dag, assignment: assignment) {
        PartitionFoldOk { units: units } =>
          match validate_partition_r4(module_dag: dag, assignment: assignment, units: units) {
            PartitionR4Valid => true
            PartitionR4Refused { cause: _ } => false
          }
        PartitionFoldRefused { cause: _ } => false
      }
    ResolvePartitionRefused { cause: _ } => false
  }
}

fn stage0_partition_fold_ok() -> Bool {
  match stage0_partition_receipt_outcome() {
    Stage0PartitionReceiptOk { units: units } =>
      (units |> count) == stage0_module_bearing_unit_count()
    Stage0PartitionReceiptResolveRefused { cause: _ } => false
    Stage0PartitionReceiptFoldRefused { cause: _ } => false
  }
}

data rust_crate_partition_dissolve_on: std.dissolution.DissolutionCondition = std.dissolution.unbound_dissolution(description: "dissolve-on: rust_crate_partition_interim_explicit — replace ExplicitPartition assignment with PolicyPartition \{ target_crate_count: declared_core_target } when balanced partition policy lands; provenance flips HandExplicit → PolicyDerived.")

data stage0_compilation_units_list_wrapper_dissolve_on: std.dissolution.DissolutionCondition = std.dissolution.unbound_dissolution(description: "dissolve-on: stage0_compilation_units — removed; receipt paths must call stage0_partition_receipt_outcome (§5 List wrapper collapses resolve/fold refusal to [], indistinguishable from empty partition). Witnesses read units from Stage0PartitionReceiptOk only.")

data stage0_module_dag_interface_grounding_debt_dissolve_on: std.dissolution.DissolutionCondition = std.dissolution.unbound_dissolution(description: "dissolve-on: stage0_module_dag_interface_grounding — populate ModuleDag.exports with frontier-derived cross-module export Nodes and type_definitions with by-value ModuleTypeDefinitionRow rows when stage0 module ingest provides them; until then R3 render uses Stage0PartitionCrateRow.modules + reexport_packages wildcard pub-use chain (not CompilationUnit.interface Nodes).")
