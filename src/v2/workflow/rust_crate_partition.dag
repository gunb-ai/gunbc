}

fn stage0_module_dag() -> ModuleDag {
  ModuleDag {
    modules: stage0_all_partitioned_modules()
      |> map(basename => stage0_module_id(basename: basename)),
    edges: stage0_cross_unit_import_edges(),
    exports: stage0_module_dag_exports_map(),
    type_definitions: stage0_module_dag_type_definitions_map(),
  }
}

fn resolve_partition_outcome(
  parameter: PartitionParameter,
  module_dag: ModuleDag
) -> ResolvePartitionOutcome {
  match parameter {
    ExplicitPartitionParam { partition: partition } =>
      ResolvePartitionOk { assignment: partition.assignment }
    DerivedStage0PartitionParam => stage0_interim_explicit_assignment_outcome()
    PolicyPartitionParam { policy: policy } =>
      ResolvePartitionRefused {
        cause: PolicyResolverUnimplemented { policy: policy }
      }
  }
}

fn stage0_partition_parameter() -> PartitionParameter {
  DerivedStage0PartitionParam
}

fn stage0_partition_receipt_outcome() -> Stage0PartitionReceiptOutcome {
  let dag = stage0_module_dag()
  match stage0_interim_explicit_assignment_outcome() {
    ResolvePartitionOk { assignment: assignment } =>
      match partition_fold_outcome(module_dag: dag, assignment: assignment) {
        PartitionFoldOk { units: units } =>
          Stage0PartitionReceiptOk { units: units }
        PartitionFoldRefused { cause: cause } =>
          Stage0PartitionReceiptFoldRefused { cause: cause }
      }
    ResolvePartitionRefused { cause: cause } =>
      Stage0PartitionReceiptResolveRefused { cause: cause }
  }
}

fn module_dag_reaches(
  edges: List<ModuleDagEdge>,
  from: ModuleId,
  to: ModuleId
) -> Bool {
  if from == to {
    true
  } else {
    edges
      |> filter(edge => edge.from == from)
      |> any(edge => module_dag_reaches(edges: edges, from: edge.to, to: to))
  }
}

fn module_pair_in_same_scc(
  edges: List<ModuleDagEdge>,
  left: ModuleId,
  right: ModuleId
) -> Bool {
  (left != right)
    && module_dag_reaches(edges: edges, from: left, to: right)
    && module_dag_reaches(edges: edges, from: right, to: left)
}

fn assignment_has_scc_split(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>
) -> Bool {
  module_dag.modules |> any(left =>
    module_dag.modules |> any(right => {
      if !module_pair_in_same_scc(edges: module_dag.edges, left: left, right: right) {
        false
      } else {
        match v2.std.collection.map_get(assignment, left) {
          Accepted { value: Present { value: left_unit }, diagnostics: _ } =>
            match v2.std.collection.map_get(assignment, right) {
              Accepted { value: Present { value: right_unit }, diagnostics: _ } =>
                left_unit != right_unit
              Rejected { diagnostics: _ } => false
              Accepted { value: Absent, diagnostics: _ } => false
            }
          Rejected { diagnostics: _ } => false
          Accepted { value: Absent, diagnostics: _ } => false
        }
      }
    })
  )
}

fn unit_graph_has_cycle(units: List<CompilationUnit>) -> Bool {
  let unit_names = units |> map(unit => unit.id as String)
  let edges = units
    |> flat_map(unit =>
      unit.deps
        |> map(dep => GraphEdge { caller: unit.id as String, callee: dep as String })
    )
  graph_has_multi_node_scc(
    names: unit_names,
    graph: CallGraph { edges: edges }
  )
}

fn validate_partition_r4(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>,
  units: List<CompilationUnit>
) -> PartitionR4ValidityVerdict {
  if assignment_has_scc_split(module_dag: module_dag, assignment: assignment) {
    PartitionR4Refused {
      cause: SccSplit { detail: "Rust R4: mutually dependent modules assigned to different compilation units" }
    }
  } else if unit_graph_has_cycle(units: units) {
    PartitionR4Refused {
      cause: UnitGraphCycle { detail: "Rust R4: compilation-unit dependency graph is cyclic" }
    }
  } else {
    PartitionR4Valid
  }
}

data stage0_compilation_units_list_wrapper_dissolve_on: String = "dissolve-on: stage0_compilation_units — removed; receipt paths must call stage0_partition_receipt_outcome (§5 List wrapper collapses resolve/fold refusal to [], indistinguishable from empty partition). Witnesses read units from Stage0PartitionReceiptOk only."

fn stage0_single_crate_assignment() -> Map<ModuleId, CompilationUnitId> {
  stage0_assign_modules_to_unit(
    assignment: empty_map(),
    modules: stage0_all_partitioned_modules(),
    unit_id: stage0_unit_runtime
  )
}

fn stage0_single_crate_fold_outcome() -> PartitionFoldOutcome {
  let dag = stage0_module_dag()
  partition_fold_outcome(
    module_dag: dag,
    assignment: stage0_single_crate_assignment()
  )
}

fn compilation_unit_member_count(units: List<CompilationUnit>) -> Int {
  units |> flat_map(unit => unit.members) |> count
}

fn stage0_partition_member_coverage_consistent(
  left: PartitionFoldOutcome,
  right: Stage0PartitionReceiptOutcome
) -> Bool {
  match left {
    PartitionFoldOk { units: left_units } =>
      match right {
        Stage0PartitionReceiptOk { units: right_units } => {
          let left_count = compilation_unit_member_count(units: left_units)
          let right_count = compilation_unit_member_count(units: right_units)
          left_count == right_count
        }
        Stage0PartitionReceiptResolveRefused { cause: _ } => false
        Stage0PartitionReceiptFoldRefused { cause: _ } => false
      }
    PartitionFoldRefused { cause: _ } => false
  }
}

fn stage0_module_bearing_crate_row(
  unit_id: CompilationUnitId,
  members_by_unit: Map<CompilationUnitId, List<ModuleId>>,
  package_name: String,
  crate_dir: String,
  kind: Stage0PartitionCrateKind,
  carries_non_empty_wrappers: Bool
) -> Stage0PartitionCrateRow {
  Stage0PartitionCrateRow {
    unit_id: unit_id,
    package_name: package_name,
    crate_dir: crate_dir,
    kind: kind,
    modules: stage0_derived_unit_member_basenames_from_members(
      members_by_unit: members_by_unit,
      unit_id: unit_id
    ),
    reexport_packages: stage0_unit_reexport_packages(unit_id: unit_id),
    carries_non_empty_wrappers: carries_non_empty_wrappers
  }
}

fn stage0_module_bearing_crate_rows_from_members_by_unit(
  members_by_unit: Map<CompilationUnitId, List<ModuleId>>
) -> List<Stage0PartitionCrateRow> {
  [
    stage0_module_bearing_crate_row(
      unit_id: stage0_unit_runtime,
      members_by_unit: members_by_unit,
      package_name: "v1-stage0-runtime",
      crate_dir: "src/v1/stage0_runtime",
      kind: Stage0FoundationCrate,
      carries_non_empty_wrappers: true
    ),
    stage0_module_bearing_crate_row(
      unit_id: stage0_unit_std_core,
      members_by_unit: members_by_unit,
      package_name: "v1-stage0-std-core",
      crate_dir: "src/v1/stage0_std_core",
      kind: Stage0LayeredCoreCrate,
      carries_non_empty_wrappers: false
    ),
    stage0_module_bearing_crate_row(
      unit_id: stage0_unit_std_surface,
      members_by_unit: members_by_unit,
      package_name: "v1-stage0-std-surface",
      crate_dir: "src/v1/stage0_std_surface",
      kind: Stage0LayeredCoreCrate,
      carries_non_empty_wrappers: false
    ),
    stage0_module_bearing_crate_row(
      unit_id: stage0_unit_extdeps_languages,
      members_by_unit: members_by_unit,
      package_name: "v1-stage0-extdeps-languages",
      crate_dir: "src/v1/stage0_extdeps_languages",
      kind: Stage0LayeredCoreCrate,
      carries_non_empty_wrappers: false
    ),
    stage0_module_bearing_crate_row(
      unit_id: stage0_unit_v1_infer,
      members_by_unit: members_by_unit,
      package_name: "v1-stage0-v1-infer",
      crate_dir: "src/v1/stage0_v1_infer",
      kind: Stage0LayeredCoreCrate,
      carries_non_empty_wrappers: false
    ),
    stage0_module_bearing_crate_row(
      unit_id: stage0_unit_v1_artifact,
      members_by_unit: members_by_unit,
      package_name: "v1-stage0-v1-artifact",
      crate_dir: "src/v1/stage0_v1_artifact",
      kind: Stage0LayeredCoreCrate,
      carries_non_empty_wrappers: false
    )
  ]
}

fn stage0_members_by_unit_populated_for_units_outcome(
  members_by_unit: Map<CompilationUnitId, List<ModuleId>>,
  unit_ids: List<CompilationUnitId>
) -> Stage0DerivedPartitionOutcome {
  fold_list(
    xs: unit_ids,
    empty: Stage0DerivedPartitionOk {
      assignment: empty_map(),
      members_by_unit: empty_map(),
      reach_dispositions_by_unit: empty_map()
    },
    cons: fn(acc, unit_id) {
      match acc {
        Stage0DerivedPartitionRefused { cause: _ } => acc
        Stage0DerivedPartitionOk { assignment: _, members_by_unit: _, reach_dispositions_by_unit: _ } =>
          match map_get(members_by_unit, unit_id) {
            Accepted { value: Present { value: _ }, diagnostics: _ } => acc
            Accepted { value: Absent, diagnostics: _ } =>
              Stage0DerivedPartitionRefused {
                cause: Stage0PartitionMissingRawReachPopulation { unit_id: unit_id }
              }
            Rejected { diagnostics: _ } =>
              Stage0DerivedPartitionRefused {
                cause: Stage0PartitionMissingRawReachPopulation { unit_id: unit_id }
              }
          }
      }
    }
  )
}

fn stage0_module_bearing_crate_rows_outcome() -> Stage0PartitionCrateRowsOutcome {
  match stage0_derived_partition_outcome() {
    Stage0DerivedPartitionRefused { cause: cause } =>
      Stage0PartitionCrateRowsRefused { cause: cause }
    Stage0DerivedPartitionOk { assignment: _, members_by_unit: members_by_unit, reach_dispositions_by_unit: _ } =>
      match stage0_members_by_unit_populated_for_units_outcome(
        members_by_unit: members_by_unit,
        unit_ids: stage0_module_bearing_unit_ids()
      ) {
        Stage0DerivedPartitionRefused { cause: cause } =>
          Stage0PartitionCrateRowsRefused { cause: cause }
        Stage0DerivedPartitionOk { assignment: _, members_by_unit: _, reach_dispositions_by_unit: _ } =>
          Stage0PartitionCrateRowsOk {
            rows: stage0_module_bearing_crate_rows_from_members_by_unit(
              members_by_unit: members_by_unit
            )
          }
      }
  }
}

fn stage0_r3_emit_shell_crate_row() -> Stage0PartitionCrateRow {
  Stage0PartitionCrateRow {
    unit_id: stage0_unit_emit_core,
    package_name: "v1-stage0-emit-core",
    crate_dir: "src/v1/stage0_emit_core",
    kind: Stage0EmitCoreCrate,
    modules: stage0_r3_emit_reexport_surface_modules(),
    reexport_packages: stage0_unit_reexport_packages(unit_id: stage0_unit_emit_core),
    carries_non_empty_wrappers: false
  }
}

fn stage0_partition_crate_rows_outcome() -> Stage0PartitionCrateRowsOutcome {
  match stage0_module_bearing_crate_rows_outcome() {
    Stage0PartitionCrateRowsRefused { cause: cause } =>
      Stage0PartitionCrateRowsRefused { cause: cause }
    Stage0PartitionCrateRowsOk { rows: module_bearing_rows } =>
      Stage0PartitionCrateRowsOk {
        rows: module_bearing_rows |> concat([stage0_r3_emit_shell_crate_row()])
      }
  }
}

fn stage0_partition_package_names() -> List<String> {
  match stage0_partition_crate_rows_outcome() {
    Stage0PartitionCrateRowsOk { rows: rows } =>
      rows |> map(row => row.package_name)
    Stage0PartitionCrateRowsRefused { cause: _ } => []
  }
}

fn stage0_physical_crate_count() -> Int {
  match stage0_partition_crate_rows_outcome() {
    Stage0PartitionCrateRowsOk { rows: rows } => rows |> count
    Stage0PartitionCrateRowsRefused { cause: _ } => 0
  }
}

fn stage0_physical_crate_count_holds(expected: Int) -> Bool {
  match stage0_partition_crate_rows_outcome() {
    Stage0PartitionCrateRowsOk { rows: rows } => (rows |> count) == expected
    Stage0PartitionCrateRowsRefused { cause: _ } => false
  }
}

fn stage0_module_bearing_unit_count_holds(expected: Int) -> Bool {
  match stage0_module_bearing_crate_rows_outcome() {
    Stage0PartitionCrateRowsOk { rows: rows } => (rows |> count) == expected
    Stage0PartitionCrateRowsRefused { cause: _ } => false
  }
}

fn stage0_module_owner_resolved_in_module_bearing_rows(
  rows: List<Stage0PartitionCrateRow>,
  module_basename: String
) -> Bool {
  rows |> any(row => row.modules |> any(m => m == module_basename))
}

fn stage0_package_resolved_in_partition_rows(
  rows: List<Stage0PartitionCrateRow>,
  package_name: String
) -> Bool {
  rows |> any(row => row.package_name == package_name)
}

fn stage0_partition_row_lookups_resolved() -> Bool {
  match stage0_derived_partition_outcome() {
    Stage0DerivedPartitionRefused { cause: _ } => false
    Stage0DerivedPartitionOk { assignment: _, members_by_unit: _, reach_dispositions_by_unit: _ } =>
      stage0_partition_row_lookups_resolved_on_enrolled_graph()
  }
}

fn stage0_partition_row_lookups_resolved_for_rows(
  all_rows: List<Stage0PartitionCrateRow>,
  module_bearing_rows: List<Stage0PartitionCrateRow>
) -> Bool {
  let layered_ok = module_bearing_rows
    |> fold(init: true, f: fn(ok, row) {
      ok && row.reexport_packages
        |> fold(init: true, f: fn(p_ok, pkg) {
          p_ok
            && stage0_package_resolved_in_partition_rows(
              rows: all_rows,
              package_name: pkg
            )
        })
    })
  let emit_shell_ok = stage0_r3_emit_reexport_surface_modules()
    |> fold(init: true, f: fn(m_ok, module_basename) {
      m_ok
        && stage0_module_owner_resolved_in_module_bearing_rows(
          rows: module_bearing_rows,
          module_basename: module_basename
        )
    })
  layered_ok && emit_shell_ok
}

fn stage0_partition_row_lookups_resolved_on_enrolled_graph() -> Bool {
  match stage0_partition_crate_rows_outcome() {
    Stage0PartitionCrateRowsRefused { cause: _ } => false
    Stage0PartitionCrateRowsOk { rows: all_rows } =>
      match stage0_module_bearing_crate_rows_outcome() {
        Stage0PartitionCrateRowsRefused { cause: _ } => false
        Stage0PartitionCrateRowsOk { rows: module_bearing_rows } =>
          stage0_partition_row_lookups_resolved_for_rows(
            all_rows: all_rows,
            module_bearing_rows: module_bearing_rows
          )
      }
  }
}

fn stage0_partition_r4_valid() -> Bool {
  let dag = stage0_module_dag()
  match stage0_interim_explicit_assignment_outcome() {
    ResolvePartitionOk { assignment: assignment } =>
      match partition_fold_outcome(module_dag: dag, assignment: assignment) {
        PartitionFoldOk { units: units } =>
          match validate_partition_r4(module_dag: dag, assignment: assignment, units: units) {
            PartitionR4Valid => true
            PartitionR4Refused { cause: _ } => false
          }
        PartitionFoldRefused { cause: _ } => false
      }
    ResolvePartitionRefused { cause: _ } => false
  }
}

fn stage0_partition_fold_ok() -> Bool {
  match stage0_partition_receipt_outcome() {
    Stage0PartitionReceiptOk { units: units } =>
      match stage0_module_bearing_crate_rows_outcome() {
        Stage0PartitionCrateRowsOk { rows: rows } => (units |> count) == (rows |> count)
        Stage0PartitionCrateRowsRefused { cause: _ } => false
      }
    Stage0PartitionReceiptResolveRefused { cause: _ } => false
    Stage0PartitionReceiptFoldRefused { cause: _ } => false
  }
}
