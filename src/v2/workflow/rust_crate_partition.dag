type PartitionPolicy {
  target_crate_count: Int
}

type ExplicitPartition {
  assignment: Map<ModuleId, CompilationUnitId>
}

type PartitionParameter
  = ExplicitPartitionParam { partition: ExplicitPartition }
  | PolicyPartitionParam { policy: PartitionPolicy }

// Every refusal names the module or the Rust rule it is about. An assignment is admitted only when
// every module of the DAG has exactly one owner (the Map gives uniqueness; coverage and the absence
// of strangers are checked here) and the R4 verdict is valid -- on BOTH arms, because a partition an
// author supplied is no more trusted than one the policy derived.
type ResolvePartitionRefusalCause
  = PolicyTargetCountNotPositive { policy: PartitionPolicy }
  | AssignmentOmitsModule { module_id: ModuleId }
  | AssignmentNamesModuleOutsideDag { module_id: ModuleId }
  | PartitionRustAdmissibilityRefused { cause: PartitionR4ValidityCause }

type ResolvePartitionOutcome
  = ResolvePartitionOk {
      assignment: Map<ModuleId, CompilationUnitId>
      provenance: PartitionProvenance
    }
  | ResolvePartitionRefused { cause: ResolvePartitionRefusalCause }

type Stage0PartitionReceiptOutcome
  = Stage0PartitionReceiptOk { units: List<CompilationUnit> }
  | Stage0PartitionReceiptResolveRefused { cause: ResolvePartitionRefusalCause }
  | Stage0PartitionReceiptFoldRefused { cause: PartitionFoldRefusalCause }

type Stage0PartitionCrateKind
  = Stage0FoundationCrate
  | Stage0LayeredCoreCrate
  | Stage0EmitCoreCrate

type Stage0PartitionCrateRow {
  unit_id: CompilationUnitId
  package_name: String
  crate_dir: String
  kind: Stage0PartitionCrateKind
  modules: List<String>
  reexport_packages: List<String>
  carries_non_empty_wrappers: Bool
}

// Rust R3 workflow realization of the shared CompilationUnit home
// (emitted-crate-partition-design.md §2/§13). resolve_partition_outcome is the sole entry for the
// assignment Map; partition_fold_outcome is the sole producer of interface + deps. Phase 0:
// HandExplicit provenance + ExplicitPartition interim ~8-crate layered grouping (dissolves to
// PolicyPartition when balanced crates≈cores policy lands).

data rust_crate_partition_declared_core_target: Int = 7

data rust_crate_partition_module_bearing_unit_target: Int = 6

// R3-only emit shell crate (reexport surface, NOT a partition_fold CompilationUnit): modules list
// is the reexport bundle for render at cutover; those modules remain owned by module-bearing units
// in stage0_interim_explicit_assignment. Physical crate count = module_bearing (6) + emit_shell (1)
// = declared_core_target (7).

data stage0_unit_runtime: CompilationUnitId = "stage0-unit-runtime" as CompilationUnitId
data stage0_unit_std_primitives: CompilationUnitId = "stage0-unit-std-primitives" as CompilationUnitId
data stage0_unit_std_core: CompilationUnitId = "stage0-unit-std-core" as CompilationUnitId
data stage0_unit_std_surface: CompilationUnitId = "stage0-unit-std-surface" as CompilationUnitId
data stage0_unit_extdeps: CompilationUnitId = "stage0-unit-extdeps" as CompilationUnitId
data stage0_unit_v1_infer: CompilationUnitId = "stage0-unit-v1-infer" as CompilationUnitId
data stage0_unit_extdeps_languages: CompilationUnitId = "stage0-unit-extdeps-languages" as CompilationUnitId
data stage0_unit_v1_artifact: CompilationUnitId = "stage0-unit-v1-artifact" as CompilationUnitId
data stage0_unit_emit_core: CompilationUnitId = "stage0-unit-emit-core" as CompilationUnitId

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: RealizationDispatch }
}

type Stage0ModuleDagInterfaceGrounding
  = Stage0ModuleDagInterfaceFrontierGrounded
  | Stage0ModuleDagInterfaceUngrounded {
      exports_map: ExportsMapNotFrontierGrounded
      type_definitions_map: TypeDefinitionsMapNotFrontierGrounded
    }

type ExportsMapNotFrontierGrounded {
  dissolve_target: DeclarationRef
}

type TypeDefinitionsMapNotFrontierGrounded {
  dissolve_target: DeclarationRef
}

// Interim: ModuleDag.exports + type_definitions carry per-module keys with empty lists (structural
// scaffold for partition_fold only). R3 render uses Stage0PartitionCrateRow.modules +
// reexport_packages wildcard pub-use chain — not CompilationUnit.interface Nodes. Full Node-carrier
// exports blocked on stage0 module ingest supplying them through the path-module binding index (see
// stage0_grounding_target_repointed_note).

// Rust R4 primary refusals on current main: SccSplit + UnitGraphCycle (LinkageCycle permissive).
// ByValueTypeCycle arm lands with #6744 rebase — refuse type-layout cycles via ByValueTypeCycle {
// detail } ONLY, never SccSplit. Exhaustive PartitionR4ValidityCause matches must add the 4th arm
// on rebase.

data stage0_grounding_target_repointed_note: String = "REPOINTED, and the old target was wrong before it was deleted. This debt's dissolution used to name v2.compiler.self_host.frontier compiler_frontier_roster, on the premise that the self-host roster would eventually carry each module's exports and type definitions. It never could: a roster row carried a module path and a self-host disposition and nothing else, so the pointer named an authority that was not going to supply the fact even in principle. The roster is deleted, which is what surfaced the mispointing rather than causing it.

The real dependency is the path-module binding authority, which is where module identity is DERIVED at parse rather than authored — v2.compiler.source_authority module_storage_binding_authority_note states that the hand-authored qualified-module rows project from it, not the other way round. So the interface maps ground when stage0 module ingest supplies real Node-carrier exports through that index."

fn stage0_frontier_grounding_target() -> DeclarationRef {
  DeclarationRef {
    module_path: "v2.compiler.source_authority" as NonEmptyStr,
    decl_name: "ModuleStorageIndex" as NonEmptyStr,
    field: WholeDeclaration,
  }
}

fn stage0_module_dag_interface_grounding() -> Stage0ModuleDagInterfaceGrounding {
  Stage0ModuleDagInterfaceUngrounded {
    exports_map: ExportsMapNotFrontierGrounded {
      dissolve_target: stage0_frontier_grounding_target()
    },
    type_definitions_map: TypeDefinitionsMapNotFrontierGrounded {
      dissolve_target: stage0_frontier_grounding_target()
    }
  }
}

fn stage0_module_dag_interface_grounding_is_debt() -> Bool {
  match stage0_module_dag_interface_grounding() {
    Stage0ModuleDagInterfaceFrontierGrounded => false
    Stage0ModuleDagInterfaceUngrounded { exports_map: _, type_definitions_map: _ } => true
  }
}

fn stage0_module_dag_exports_map() -> Map<ModuleId, List<Node>> {
  stage0_all_partitioned_modules()
    |> fold(init: empty_map(), f: fn(acc, basename) {
      map_insert(acc, stage0_module_id(basename: basename), Empty)
    })
}

fn stage0_module_dag_type_definitions_map() -> Map<ModuleId, List<ModuleTypeDefinitionRow>> {
  stage0_all_partitioned_modules()
    |> fold(init: empty_map(), f: fn(acc, basename) {
      map_insert(acc, stage0_module_id(basename: basename), Empty)
    })
}

fn stage0_module_id(basename: String) -> ModuleId {
  basename as NonEmptyStr
}

fn stage0_runtime_modules() -> List<String> {
  ["v1_rt"]
}

// std_lens_verdict WAS ON THIS LIST AND IS NOT A MODULE THE PARTITION MAY OWN.
// stage0 lib.rs does not declare it: v2.compiler.self_host.stage0_crate_layout registers
// it as a SeedRetainedIntrinsicRegistration with has_pub_mod false, so the monolith
// deliberately leaves it out while every partition crate carrying the row compiled it
// through a path include. That is one file with two compilation stories, which is the
// divergence this list must not author. Its source module std.lens_verdict no longer
// exists -- the live authority is v2.std.lens_verdict -- and nothing in the stage0 tree
// names crate::std_lens_verdict, so the row was answering for a module that had already
// stopped being one. The FILE's disposition (dead source retained under an undeclared
// reason in v2.compiler.self_host.seed_retention_frontier) is settled separately from
// this roster, because deleting it moves the layout authority and the retention frontier
// and this list is not where that decision lives.
fn stage0_std_primitive_modules() -> List<String> {
  [
    "std_content_hash",
    "std_coercion",
    "extdeps_currency_currency",
    "std_decl_ref",
    "std_keyed_row",
    "std_keyed_roster",
    "std_roster_frontier",
    "std_dissolution",
    "std_disposition",
    "std_error_primitives",
    "std_emit_model",
    "std_magnitude",
    "std_measure",
    "std_types",
    "std_unicode_types"
  ]
}

