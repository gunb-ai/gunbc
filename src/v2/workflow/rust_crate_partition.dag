    stage0_module_dag_edge(from: "v1_compiler_parse", to: "std_algebra"),
    stage0_module_dag_edge(from: "v1_compiler_parse", to: "std_import"),
    stage0_module_dag_edge(from: "v1_compiler_parse", to: "std_occurrence_identity"),
    stage0_module_dag_edge(from: "v1_compiler_parse", to: "std_syntax"),
    stage0_module_dag_edge(from: "v1_compiler_parse", to: "std_types"),
    stage0_module_dag_edge(from: "v1_compiler_parse", to: "extdeps_languages_dag_syntax"),
    stage0_module_dag_edge(from: "v1_compiler_parse", to: "v1_rt"),
    stage0_module_dag_edge(from: "v1_compiler_parse", to: "v1_std_core"),
  ]
}

data stage0_module_dag: ModuleDag = ModuleDag {
    modules: stage0_all_partitioned_modules()
      |> map(basename => stage0_module_id(basename: basename)),
    edges: stage0_cross_unit_import_edges(),
    exports: stage0_module_dag_exports_map(),
    type_definitions: stage0_module_dag_type_definitions_map(),
  }

fn resolve_partition_outcome(
  parameter: PartitionParameter,
  module_dag: ModuleDag
) -> ResolvePartitionOutcome {
  match parameter {
    ExplicitPartitionParam { partition: explicit } =>
      admit_partition_assignment(
        module_dag: module_dag,
        assignment: explicit.assignment,
        provenance: partition_provenance_hand_explicit()
      )
    PolicyPartitionParam { policy: policy } =>
      if policy.target_crate_count < 1 {
        ResolvePartitionRefused { cause: PolicyTargetCountNotPositive { policy: policy } }
      } else {
        admit_partition_assignment(
          module_dag: module_dag,
          assignment: policy_partition_assignment(module_dag: module_dag, policy: policy),
          provenance: partition_provenance_policy_derived(policy: policy_partition_resolver_ref())
        )
      }
  }
}

fn policy_partition_resolver_ref() -> DeclarationRef {
  DeclarationRef {
    module_path: "v2.workflow.rust_crate_partition" as NonEmptyStr,
    decl_name: "policy_partition_assignment" as NonEmptyStr,
    field: WholeDeclaration,
  }
}

fn module_dag_call_graph(module_dag: ModuleDag) -> CallGraph {
  CallGraph {
    edges: module_dag.edges
      |> map(edge => GraphEdge { caller: edge.from as String, callee: edge.to as String })
  }
}

// The strongly connected components of the module DAG, dependencies first. Kosaraju yields them
// importers first (std.graph graph_strongly_connected_components), so this reverses once.
fn module_dag_components_dependencies_first(module_dag: ModuleDag) -> List<List<String>> {
  graph_strongly_connected_components(
    names: module_dag.modules |> map(module_id => module_id as String),
    graph: module_dag_call_graph(module_dag: module_dag)
  ) |> reverse
}

type PolicyPartitionFill {
  assignment: Map<ModuleId, CompilationUnitId>
  unit_index: Int
  filled: Int
}

fn policy_partition_unit_id(unit_index: Int) -> CompilationUnitId {
  ("policy-unit-" + to_string(unit_index)) as CompilationUnitId
}

// THE BALANCED POLICY, AND WHY IT CANNOT PRODUCE AN INADMISSIBLE PARTITION. Components are laid out
// dependencies first and cut into contiguous runs of about ceil(modules / target) members, so:
// a component is never divided (no SccSplit), and every module edge runs from a later run to an
// earlier or the same one, so the unit graph points strictly backwards (no UnitGraphCycle). The R4
// verdict is still asked of the result in admit_partition_assignment -- the argument above is why
// the policy should pass, and the verdict is what establishes that it did.
fn policy_partition_assignment(
  module_dag: ModuleDag,
  policy: PartitionPolicy
) -> Map<ModuleId, CompilationUnitId> {
  let quota = (length(module_dag.modules) + policy.target_crate_count - 1) / policy.target_crate_count
  let filled = module_dag_components_dependencies_first(module_dag: module_dag)
    |> fold(init: PolicyPartitionFill { assignment: empty_map(), unit_index: 0, filled: 0 }, f: fn(acc, component) {
      let opens_next_unit = (acc.filled >= quota) && (acc.unit_index + 1 < policy.target_crate_count)
      let unit_index = if opens_next_unit { acc.unit_index + 1 } else { acc.unit_index }
      let already = if opens_next_unit { 0 } else { acc.filled }
      let unit_id = policy_partition_unit_id(unit_index: unit_index)
      PolicyPartitionFill {
        assignment: component |> fold(init: acc.assignment, f: fn(inner, member) {
          map_insert(inner, member as ModuleId, unit_id)
        }),
        unit_index: unit_index,
        filled: already + length(component)
      }
    })
  filled.assignment
}

fn assignment_owner(
  assignment: Map<ModuleId, CompilationUnitId>,
  module_id: ModuleId
) -> Optional<CompilationUnitId> {
  match map_get(assignment, module_id) {
    Accepted { value: owner, diagnostics: _ } => owner
    Rejected { diagnostics: _ } => Absent
  }
}

fn assignment_first_omitted_module(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>
) -> Optional<ModuleId> {
  module_dag.modules |> fold(init: Absent, f: fn(acc, module_id) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        match assignment_owner(assignment: assignment, module_id: module_id) {
          Present { value: _ } => Absent
          Absent => Present { value: module_id }
        }
    }
  })
}

fn assignment_first_stranger(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>
) -> Optional<ModuleId> {
  let known = module_dag.modules |> fold(init: empty_map(), f: fn(acc, module_id) {
    map_insert(acc, module_id, true)
  })
  map_keys(assignment) |> fold(init: Absent, f: fn(acc, module_id) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        match map_get(known, module_id) {
          Accepted { value: Present { value: _ }, diagnostics: _ } => Absent
          Accepted { value: Absent, diagnostics: _ } => Present { value: module_id }
          Rejected { diagnostics: _ } => Present { value: module_id }
        }
    }
  })
}

fn admit_partition_assignment(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>,
  provenance: PartitionProvenance
) -> ResolvePartitionOutcome {
  match assignment_first_omitted_module(module_dag: module_dag, assignment: assignment) {
    Present { value: module_id } =>
      ResolvePartitionRefused { cause: AssignmentOmitsModule { module_id: module_id } }
    Absent =>
      match assignment_first_stranger(module_dag: module_dag, assignment: assignment) {
        Present { value: module_id } =>
          ResolvePartitionRefused { cause: AssignmentNamesModuleOutsideDag { module_id: module_id } }
        Absent =>
          match validate_partition_r4(module_dag: module_dag, assignment: assignment) {
            PartitionR4Refused { cause: cause } =>
              ResolvePartitionRefused { cause: PartitionRustAdmissibilityRefused { cause: cause } }
            PartitionR4Valid =>
              ResolvePartitionOk { assignment: assignment, provenance: provenance }
          }
      }
  }
}

// THE RESOLVE IS ONE FACT, SO IT IS ONE BINDING. Both the receipt below and
// stage0_partition_r4_valid need the assignment this produces, and they are two demands with a
// shared-state least common ancestor -- DESIGN section 2 calls that authored duplication, not a
// caching opportunity, and says to carry the first value rather than let the second recompute it.
// Binding it here is the same move this change makes for stage0_module_dag one declaration up.
data stage0_resolve_partition_outcome: ResolvePartitionOutcome = resolve_partition_outcome(
  parameter: stage0_partition_parameter(),
  module_dag: stage0_module_dag
)

data stage0_partition_receipt_outcome: Stage0PartitionReceiptOutcome = match stage0_resolve_partition_outcome {
  ResolvePartitionOk { assignment: assignment, provenance: _ } =>
    match partition_fold_outcome(module_dag: stage0_module_dag, assignment: assignment) {
      PartitionFoldOk { units: units } =>
        Stage0PartitionReceiptOk { units: units }
      PartitionFoldRefused { cause: cause } =>
        Stage0PartitionReceiptFoldRefused { cause: cause }
    }
  ResolvePartitionRefused { cause: cause } =>
    Stage0PartitionReceiptResolveRefused { cause: cause }
}

// SCC membership is read from the components, not re-derived per pair: the pairwise reachability
// walk this replaces had no visited set, so on a cyclic DAG it did not terminate, and it paid a walk
// per ordered pair besides.
fn assignment_has_scc_split(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>
) -> Bool {
  module_dag_components_dependencies_first(module_dag: module_dag)
    |> any(component => {
      let owners = component |> fold(init: [], f: fn(acc, member) {
        match assignment_owner(assignment: assignment, module_id: member as ModuleId) {
          Present { value: owner } => if acc |> any(seen => seen == owner) { acc } else { acc |> list_push(owner) }
          Absent => acc
        }
      })
      length(owners) > 1
    })
}

// The unit graph is the module edges projected through the assignment -- the same fact
// partition_fold_outcome derives as CompilationUnit.deps, read here without asking for interfaces.
fn assignment_unit_graph_has_cycle(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>
) -> Bool {
  let unit_edges = module_dag.edges |> fold(init: [], f: fn(acc, edge) {
    match assignment_owner(assignment: assignment, module_id: edge.from) {
      Present { value: from_unit } =>
        match assignment_owner(assignment: assignment, module_id: edge.to) {
          Present { value: to_unit } =>
            if from_unit == to_unit {
              acc
            } else {
              acc |> list_push(GraphEdge { caller: from_unit as String, callee: to_unit as String })
            }
          Absent => acc
        }
      Absent => acc
    }
  })
  graph_has_multi_node_scc(
    names: map_values(assignment) |> fold(init: [], f: fn(acc, unit) {
      if acc |> any(seen => seen == (unit as String)) { acc } else { acc |> list_push(unit as String) }
    }),
    graph: CallGraph { edges: unit_edges }
  )
}

fn validate_partition_r4(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>
) -> PartitionR4ValidityVerdict {
  if assignment_has_scc_split(module_dag: module_dag, assignment: assignment) {
    PartitionR4Refused {
      cause: SccSplit { detail: "Rust R4: mutually dependent modules assigned to different compilation units" }
    }
  } else if assignment_unit_graph_has_cycle(module_dag: module_dag, assignment: assignment) {
    PartitionR4Refused {
      cause: UnitGraphCycle { detail: "Rust R4: compilation-unit dependency graph is cyclic" }
    }
  } else {
    PartitionR4Valid
  }
}

fn stage0_single_crate_assignment() -> Map<ModuleId, CompilationUnitId> {
  stage0_assign_modules_to_unit(
    assignment: empty_map(),
    modules: stage0_all_partitioned_modules(),
    unit_id: stage0_unit_runtime
  )
}

fn stage0_single_crate_fold_outcome() -> PartitionFoldOutcome {
  partition_fold_outcome(
    module_dag: stage0_module_dag,
    assignment: stage0_single_crate_assignment()
  )
}

fn compilation_unit_member_count(units: List<CompilationUnit>) -> Int {
  units |> flat_map(unit => unit.members) |> count
}

fn stage0_partition_member_coverage_consistent(
  left: PartitionFoldOutcome,
  right: Stage0PartitionReceiptOutcome
) -> Bool {
  match left {
    PartitionFoldOk { units: left_units } =>
      match right {
        Stage0PartitionReceiptOk { units: right_units } => {
          let left_count = compilation_unit_member_count(units: left_units)
          let right_count = compilation_unit_member_count(units: right_units)
          left_count == right_count
        }
        Stage0PartitionReceiptResolveRefused { cause: _ } => false
        Stage0PartitionReceiptFoldRefused { cause: _ } => false
      }
    PartitionFoldRefused { cause: _ } => false
  }
}

fn stage0_module_bearing_crate_rows() -> List<Stage0PartitionCrateRow> {
  [
    Stage0PartitionCrateRow {
      unit_id: stage0_unit_runtime,
      package_name: "v1-stage0-runtime",
      crate_dir: "src/v1/stage0_runtime",
      kind: Stage0FoundationCrate,
      modules: stage0_runtime_modules(),
      reexport_packages: [],
      carries_non_empty_wrappers: true
    },
    Stage0PartitionCrateRow {
      unit_id: stage0_unit_std_core,
      package_name: "v1-stage0-std-core",
      crate_dir: "src/v1/stage0_std_core",
      kind: Stage0LayeredCoreCrate,
      modules: stage0_std_core_modules(),
      reexport_packages: ["v1-stage0-runtime"],
      carries_non_empty_wrappers: false
    },
    Stage0PartitionCrateRow {
      unit_id: stage0_unit_std_surface,
      package_name: "v1-stage0-std-surface",
      crate_dir: "src/v1/stage0_std_surface",
      kind: Stage0LayeredCoreCrate,
      modules: stage0_std_surface_modules(),
      reexport_packages: [
        "v1-stage0-runtime",
        "v1-stage0-std-core"
      ],
      carries_non_empty_wrappers: false
    },
    Stage0PartitionCrateRow {
      unit_id: stage0_unit_extdeps_languages,
      package_name: "v1-stage0-extdeps-languages",
      crate_dir: "src/v1/stage0_extdeps_languages",
      kind: Stage0LayeredCoreCrate,
      modules: stage0_extdeps_language_modules(),
      reexport_packages: [
        "v1-stage0-runtime",
        "v1-stage0-std-core",
        "v1-stage0-std-surface"
      ],
      carries_non_empty_wrappers: false
    },
    Stage0PartitionCrateRow {
      unit_id: stage0_unit_v1_artifact,
      package_name: "v1-stage0-v1-artifact",
      crate_dir: "src/v1/stage0_v1_artifact",
      kind: Stage0LayeredCoreCrate,
      modules: stage0_v1_artifact_modules(),
      reexport_packages: [
        "v1-stage0-runtime",
        "v1-stage0-std-core",
        "v1-stage0-std-surface",
        "v1-stage0-extdeps-languages"
      ],
      carries_non_empty_wrappers: false
    },
    Stage0PartitionCrateRow {
      unit_id: stage0_unit_v1_infer,
      package_name: "v1-stage0-v1-infer",
      crate_dir: "src/v1/stage0_v1_infer",
      kind: Stage0LayeredCoreCrate,
      modules: stage0_v1_infer_modules(),
      reexport_packages: [
        "v1-stage0-runtime",
        "v1-stage0-std-core",
        "v1-stage0-std-surface",
        "v1-stage0-extdeps-languages",
        "v1-stage0-v1-artifact"
      ],
      carries_non_empty_wrappers: false
    }
  ]
}

fn stage0_r3_emit_shell_crate_row() -> Stage0PartitionCrateRow {
  Stage0PartitionCrateRow {
    unit_id: stage0_unit_emit_core,
    package_name: "v1-stage0-emit-core",
    crate_dir: "src/v1/stage0_emit_core",
    kind: Stage0EmitCoreCrate,
    modules: stage0_r3_emit_reexport_surface_modules(),
    reexport_packages: [],
    carries_non_empty_wrappers: false
  }
}

fn stage0_partition_crate_rows() -> List<Stage0PartitionCrateRow> {
  stage0_module_bearing_crate_rows()
    |> concat([stage0_r3_emit_shell_crate_row()])
}

fn stage0_partition_package_names() -> List<String> {
  stage0_partition_crate_rows() |> map(row => row.package_name)
}

fn stage0_physical_crate_count() -> Int {
  stage0_partition_crate_rows() |> count
}

fn stage0_module_bearing_unit_count() -> Int {
  stage0_module_bearing_crate_rows() |> count
}

fn stage0_module_owner_resolved_in_module_bearing_rows(module_basename: String) -> Bool {
  stage0_module_bearing_crate_rows()
    |> any(row => row.modules |> any(m => m == module_basename))
}

fn stage0_package_resolved_in_partition_rows(package_name: String) -> Bool {
  stage0_partition_crate_rows()
    |> any(row => row.package_name == package_name)
}

fn stage0_partition_row_lookups_resolved() -> Bool {
  let layered_ok = stage0_module_bearing_crate_rows()
    |> fold(init: true, f: fn(ok, row) {
      ok && row.reexport_packages
        |> fold(init: true, f: fn(p_ok, pkg) {
          p_ok && stage0_package_resolved_in_partition_rows(package_name: pkg)
        })
    })
  let emit_shell_ok = stage0_r3_emit_reexport_surface_modules()
    |> fold(init: true, f: fn(m_ok, module_basename) {
      m_ok && stage0_module_owner_resolved_in_module_bearing_rows(module_basename: module_basename)
    })
  layered_ok && emit_shell_ok
}

// resolve_partition_outcome admits an assignment only through the R4 verdict, so an Ok resolve IS
// the valid verdict; asking validate_partition_r4 again here would pay the same verdict twice.
fn stage0_partition_r4_valid() -> Bool {
  match stage0_resolve_partition_outcome {
    ResolvePartitionOk { assignment: _, provenance: _ } => true
    ResolvePartitionRefused { cause: _ } => false
  }
}

fn stage0_partition_fold_ok() -> Bool {
  match stage0_partition_receipt_outcome {
    Stage0PartitionReceiptOk { units: units } =>
      (units |> count) == stage0_module_bearing_unit_count()
    Stage0PartitionReceiptResolveRefused { cause: _ } => false
    Stage0PartitionReceiptFoldRefused { cause: _ } => false
  }
}

data rust_crate_partition_dissolve_on: DissolutionCondition = unbound_dissolution(description: "dissolve-on: rust_crate_partition_interim_explicit — the balanced policy has landed (resolve_partition_outcome PolicyPartitionParam, policy_partition_assignment), so it is no longer what holds stage0 on the explicit arm. What does: stage0_module_dag's edges and module lists are authored (stage0_cross_unit_import_edges, the stage0_*_modules lists) over v1 mirror basenames, not derived, so a policy over them would balance an incomplete graph. Stage0 flips to PolicyPartition \{ target_crate_count: declared_core_target } with provenance PolicyDerived when its ModuleDag is derived from the mirrors' resolved dependency facts the way v2.workflow.emitted_closure_crate_partition module_dag_from_dependency_facts derives the emitted closure's.")

data stage0_compilation_units_list_wrapper_dissolve_on: DissolutionCondition = unbound_dissolution(description: "dissolve-on: stage0_compilation_units — removed; receipt paths must call stage0_partition_receipt_outcome (§5 List wrapper collapses resolve/fold refusal to [], indistinguishable from empty partition). Witnesses read units from Stage0PartitionReceiptOk only.")

data stage0_module_dag_interface_grounding_debt_dissolve_on: DissolutionCondition = unbound_dissolution(description: "dissolve-on: stage0_module_dag_interface_grounding — populate ModuleDag.exports with frontier-derived cross-module export Nodes and type_definitions with by-value ModuleTypeDefinitionRow rows when stage0 module ingest provides them; until then R3 render uses Stage0PartitionCrateRow.modules + reexport_packages wildcard pub-use chain (not CompilationUnit.interface Nodes).")
