    stage0_module_dag_edge(from: "v1_compiler_infer_emit_info", to: "v1_compiler_infer_items"),
    stage0_module_dag_edge(from: "v1_compiler_artifact", to: "v1_compiler_languages"),
  ]
}

fn stage0_module_dag() -> ModuleDag {
  ModuleDag {
    modules: stage0_all_partitioned_modules()
      |> map(basename => stage0_module_id(basename: basename)),
    edges: stage0_cross_unit_import_edges(),
    exports: empty_map(),
    type_definitions: empty_map(),
  }
}

fn resolve_partition(
  parameter: PartitionParameter,
  module_dag: ModuleDag
) -> Map<ModuleId, CompilationUnitId> {
  match parameter {
    ExplicitPartitionParam { partition: explicit } => explicit.assignment
    PolicyPartitionParam { policy: _ } =>
      stage0_interim_explicit_assignment()
  }
}

fn proof_edge_from_module_edge(edge: ModuleDagEdge) -> ProofEdge {
  ProofEdge {
    caller: edge.from as String,
    callee: edge.to as String,
    evidence: [],
  }
}

fn assignment_has_scc_split(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>
) -> Bool {
  let proof_edges = module_dag.edges |> map(proof_edge_from_module_edge)
  let members = module_dag.modules |> map(module => module as String)
  if !graph_has_multi_node_scc(names: members, graph: build_call_graph_from_proof_edges(names: members, edges: proof_edges)) {
    false
  } else {
    let scc_probe = module_dag.edges
      |> any(edge => {
        match map_get(assignment, edge.from) {
          Accepted { value: Present { value: from_unit }, diagnostics: _ } =>
            match map_get(assignment, edge.to) {
              Accepted { value: Present { value: to_unit }, diagnostics: _ } =>
                from_unit != to_unit
              Rejected { diagnostics: _ } => false
              Accepted { value: Absent, diagnostics: _ } => false
            }
          Rejected { diagnostics: _ } => false
          Accepted { value: Absent, diagnostics: _ } => false
        }
      })
    scc_probe
  }
}

fn unit_graph_has_cycle(units: List<CompilationUnit>) -> Bool {
  let unit_names = units |> map(unit => unit.id as String)
  let edges = units
    |> flat_map(unit =>
      unit.deps
        |> map(dep => GraphEdge { caller: unit.id as String, callee: dep as String })
    )
  graph_has_multi_node_scc(
    names: unit_names,
    graph: CallGraph { edges: edges }
  )
}

fn validate_partition_r4(
  module_dag: ModuleDag,
  assignment: Map<ModuleId, CompilationUnitId>,
  units: List<CompilationUnit>
) -> PartitionR4ValidityVerdict {
  if assignment_has_scc_split(module_dag: module_dag, assignment: assignment) {
    PartitionR4Refused {
      cause: SccSplit { detail: "Rust R4: mutually dependent modules assigned to different compilation units" }
    }
  } else if unit_graph_has_cycle(units: units) {
    PartitionR4Refused {
      cause: UnitGraphCycle { detail: "Rust R4: compilation-unit dependency graph is cyclic" }
    }
  } else {
    PartitionR4Valid
  }
}

fn stage0_compilation_units() -> List<CompilationUnit> {
  let dag = stage0_module_dag()
  let assignment = resolve_partition(parameter: stage0_partition_parameter(), module_dag: dag)
  partition_fold(module_dag: dag, assignment: assignment)
}

