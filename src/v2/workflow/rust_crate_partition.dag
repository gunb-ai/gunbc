import std.types { List, String, Bool, Int, NonEmptyStr }
import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }
import v2.std.algebra { any, fold_list, length, list_head, list_reverse, HeadAbsent, HeadFound }
import v2.std.collection {
  empty_map,
  map_get,
