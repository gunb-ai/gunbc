type Stage0PartitionReceiptOutcome
  = Stage0PartitionReceiptOk { units: List<CompilationUnit> }
  | Stage0PartitionReceiptResolveRefused { cause: ResolvePartitionRefusalCause }
  | Stage0PartitionReceiptSourceRefused { cause: Stage0PartitionDerivationRefusal }
  | Stage0PartitionReceiptFoldRefused { cause: PartitionFoldRefusalCause }

data rust_crate_partition_module_bearing_unit_target: Int = 6

// R3-only emit shell crate (reexport surface, NOT a partition_fold_outcome CompilationUnit): modules list
// is the reexport bundle for render at cutover; those modules remain owned by module-bearing units
// by stage0_partition_derivation. Physical crate count = module_bearing (6) + emit_shell (1)
// = declared_core_target (7).

data stage0_unit_runtime: CompilationUnitId = "stage0-unit-runtime" as CompilationUnitId
data stage0_unit_std_primitives: CompilationUnitId = "stage0-unit-std-primitives" as CompilationUnitId
data stage0_unit_std_core: CompilationUnitId = "stage0-unit-std-core" as CompilationUnitId
data stage0_unit_std_surface: CompilationUnitId = "stage0-unit-std-surface" as CompilationUnitId
data stage0_unit_extdeps: CompilationUnitId = "stage0-unit-extdeps" as CompilationUnitId
data stage0_unit_v1_infer: CompilationUnitId = "stage0-unit-v1-infer" as CompilationUnitId
data stage0_unit_extdeps_languages: CompilationUnitId = "stage0-unit-extdeps-languages" as CompilationUnitId
data stage0_unit_v1_artifact: CompilationUnitId = "stage0-unit-v1-artifact" as CompilationUnitId
data stage0_unit_emit_core: CompilationUnitId = "stage0-unit-emit-core" as CompilationUnitId

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: RealizationDispatch }
}

type Stage0ModuleDagInterfaceGrounding
  = Stage0ModuleDagInterfaceSourceGrounded
  | Stage0ModuleDagInterfaceUngrounded {
      exports_map: ExportsMapNotSourceGrounded
      type_definitions_map: TypeDefinitionsMapNotSourceGrounded
    }

type ExportsMapNotSourceGrounded {
  capability: InterfaceGroundingCapability
}

type TypeDefinitionsMapNotSourceGrounded {
  capability: InterfaceGroundingCapability
}

// The capability that retires this debt, as STRUCTURE rather than prose. A DeclarationRef names a
// declaration and nothing else, so one ref could only ever pin the supply; the other half of the
// trigger -- the population it must be sufficient for -- was a String a program could only grep.
// Each is a field here so a reader matches on it.
//   contents_supply   the supply whose members must carry per-module declaration contents; today a
//                     member carries its source text and the requests its text made, and the tree
//                     its front end normalized to read them is dropped, which is why this is still
//                     debt.
//   population        the derivation whose closure the contents must be complete for -- the emitted
//                     compiler closure, not a fixture.
// There is no host-emission field: the hand host handler the earlier supply had was deleted with
// that supply, and the acquirer reads through the filesystem handler emitted from .dag.
// Named by ref, not imported: v2.workflow.emitted_closure_crate_partition imports this module.
type InterfaceGroundingCapability {
  contents_supply: DeclarationRef
  population: DeclarationRef
}

// Interim: ModuleDag.exports + type_definitions carry per-module keys with empty lists (structural
// scaffold for partition_fold_outcome only). R3 render uses Stage0PartitionCrateRow.modules +
// reexport_packages wildcard pub-use chain — not CompilationUnit.interface Nodes, which is why the
// R3 crate rendering does NOT wait on this debt. Full Node-carrier exports are blocked on the
// module ACQUIRER's supply carrying per-module declaration contents at closure scale; the index
// itself cannot supply them, and this sentence used to say it could (the annotation above
// stage0_module_interface_grounding_target records why the dissolve targets got that wrong).

// Rust R4 primary refusals: SccSplit + UnitGraphCycle (LinkageCycle permissive). ByValueTypeCycle
// has LANDED on the home coproduct and is refused by the C realization, not by Rust — type-layout
// cycles use ByValueTypeCycle { detail } ONLY, never SccSplit. The sentence this replaces still
// described that arm as arriving with a rebase and instructed exhaustive PartitionR4ValidityCause
// matches to add a fourth arm on it; both were already done.

// REPOINTED TWICE, AND THE SECOND TARGET WAS WRONG IN THE SAME WAY AS THE FIRST. This debt's
// dissolution first named v2.compiler.self_host.frontier compiler_frontier_roster, on the premise
// that the self-host roster would eventually carry each module's exports and type definitions. It
// never could: a roster row carried a module path and a self-host disposition and nothing else, so
// the pointer named an authority that was not going to supply the fact even in principle.
//
// It was then repointed at v2.compiler.source_authority ModuleStorageIndex, reasoning that this is
// where module identity is DERIVED at parse rather than authored. That pointer failed the same
// test. A ModuleStorageBinding carries a module QualifiedName, a ModuleStorageProvenance and a
// SourceRootRef; the provenance carries an Artifact, which is kind, id and file_path. So a row
// carries a NAME, a LOCATION and a source root, and no declaration appears anywhere in that
// closure. It cannot supply exported declaration Nodes or ModuleTypeDefinitionRows any more than a
// roster row could.
//
// THE TELL, so a third repoint does not repeat it: a dissolve target is not checked by whether the
// fact is derived at the right TIME but by whether the named authority CARRIES the right FACT.
// Module IDENTITY derived at parse is the wrong property; what the interface maps need is module
// CONTENTS derived at parse. The first note diagnosed exactly this and then named another
// module-to-location authority.
//
// THE THIRD TARGET WAS DELETED, NOT WRONG. It was the whole-tree module-binding supply, and the
// source-layout cutover removed that supply with every other whole-tree producer: a compile now
// acquires the modules it was asked for (v2.compiler.module_acquisition), so the supply a
// partition can read per-module contents from is the acquirer's, and the target names it.
//
// WHERE THE FACT ACTUALLY IS, and it is not missing. source_authority already parses every module:
// module_storage_binding_from_read_prepared tokenizes and calls parse_module_prepared, and
// module_storage_binding_from_parse_artifact hands artifact.tree to
// module_storage_binding_from_provenance as `node:`. The module root is IN HAND at the mint site
// and dropped there, deliberately -- module_storage_binding_authority_note earns that scope by
// saying the binding never needed file CONTENTS, only module and path. So the projection belongs
// at that mint site and needs no second read of the source, let alone a third.
//
// WHY IT IS STILL DEBT is not restated here. The operative trigger lives on the typed carrier,
// stage0_module_dag_interface_grounding_debt_dissolve_on, because that is the declaration a
// program can read; an annotation is never evidence that a machine claim holds (gunbc.design_argument::source_annotations), and a
// second prose copy of the trigger would be the gunbc.design_argument::single_authority fork a disclaimer cannot talk its way out of.
// What is above is the irreducible rationale for the SHAPE of that trigger -- why two earlier
// targets were named and why both could not work -- which is what this channel is for.
fn stage0_module_interface_grounding_target() -> DeclarationRef {
  DeclarationRef {
    module_path: "v2.compiler.module_acquisition" as NonEmptyStr,
    decl_name: "acquire_closure_of" as NonEmptyStr,
    field: WholeDeclaration,
  }
}

fn stage0_module_interface_grounding_capability() -> InterfaceGroundingCapability {
  InterfaceGroundingCapability {
    contents_supply: stage0_module_interface_grounding_target(),
    population: DeclarationRef {
      module_path: "v2.workflow.rust_crate_partition" as NonEmptyStr,
      decl_name: "module_dag_from_dependency_facts" as NonEmptyStr,
      field: WholeDeclaration,
    }
  }
}

fn stage0_module_dag_interface_grounding() -> Stage0ModuleDagInterfaceGrounding {
  Stage0ModuleDagInterfaceUngrounded {
    exports_map: ExportsMapNotSourceGrounded {
      capability: stage0_module_interface_grounding_capability()
    },
    type_definitions_map: TypeDefinitionsMapNotSourceGrounded {
      capability: stage0_module_interface_grounding_capability()
    }
  }
}

fn stage0_module_dag_interface_grounding_is_debt() -> Bool {
  match stage0_module_dag_interface_grounding() {
    Stage0ModuleDagInterfaceSourceGrounded => false
    Stage0ModuleDagInterfaceUngrounded { exports_map: _, type_definitions_map: _ } => true
  }
}
fn stage0_module_dag_exports_map(modules: List<String>) -> Map<ModuleId, List<Node>> {
  modules
    |> fold(init: empty_map(), f: fn(acc, basename) {
      map_insert(acc, stage0_module_id(basename: basename), Empty)
    })
}

fn stage0_module_dag_type_definitions_map(modules: List<String>) -> Map<ModuleId, List<ModuleTypeDefinitionRow>> {
  modules
    |> fold(init: empty_map(), f: fn(acc, basename) {
      map_insert(acc, stage0_module_id(basename: basename), Empty)
    })
}

// THE STAGE0 PARTITION IS DERIVED FROM THE SOURCES: WHICH MODULES IT HOLDS, WHERE EACH SITS, AND
// THE EDGES BETWEEN THEM. Three facts are authored, and each is a choice rather than a fact the
// sources already carry:
//   stage0_partition_source_roots  the source entry points the partition is grown from;
//   stage0_unit_order              the order of the units, each re-exporting every unit below it;
//   stage0_unit_floors             the lowest unit a namespace (or one module) may be placed in.
// Everything else is read from v2.lens.module_graph's dependency facts, the one edge-source seam
// v2.workflow.emitted_closure_crate_partition also reads. The ROSTER is the roots plus every module
// they depend on, directly or not, plus the emitter's runtime. The PLACEMENT is, per strongly
// connected component taken dependencies first, the latest of its members' floors and of the
// units its dependencies were placed in -- the earliest unit every crate:: path of the component
// can resolve from, since a unit re-exports only the units below it. So a new import is a new
// member or a raised placement the next time this runs, and no list is edited for it.
//
// The hand lists this replaced (stage0_runtime_modules, stage0_std_primitive_modules,
// stage0_std_core_modules, stage0_std_surface_modules, stage0_extdeps_language_modules,
// stage0_gunbc_binding_modules, stage0_v1_infer_modules, stage0_v1_artifact_modules) held 100
// modules; over main at 09d6c4f9 this rule gives the same 100 modules in the same units. The
// reasons several of them carried for a module's unit are now the floor rows below or a
// dependency the rule reads.
//
// WHAT IT DOES NOT CARRY, stated so its absence is not read as a fact: the inline crate paths the
// expression emitter writes without a source dependency (one specimen: v1_compiler_parse naming
// std_types, whose units are joined by other edges anyway) are the stall
// gunbc.guarantee_stall.emitted_inline_crate_path_edges_unreturned_stall, exactly as for the
// emitted closure; the runtime edges come from the emitter's prelude rows in the merge below.
data stage0_source_pool_roots: List<String> = ["dag", "src/v1"]

// The seed modules the stage0 crates exist to compile apart from the monolith, by module name.
// Nothing else in the partition is named: a module is a member because one of these reaches it.
data stage0_partition_source_roots: List<String> = [
  "extdeps.posix.clock_gettime",
  "std.effects",
  "std.graph",
  "std.source_annotation",
  "v1.compiler.compiler_tests_rust",
  "v1.compiler.infer",
  "v1.compiler.parse",
  "v1.compiler.rest_cause_text"
]

data stage0_unit_order: List<CompilationUnitId> = [
  stage0_unit_runtime,
  stage0_unit_std_core,
  stage0_unit_std_surface,
  stage0_unit_extdeps_languages,
  stage0_unit_v1_artifact,
  stage0_unit_v1_infer
]

// The lowest unit a module may sit in, keyed by a module-name prefix on whole segments; the most
// specific prefix that matches a module is its floor. A namespace row places a layer; a row naming
// one module raises that module above what its dependencies alone would give it, and each says why.
type Stage0UnitFloor {
  prefix: String
  unit_id: CompilationUnitId
}

data stage0_unit_floors: List<Stage0UnitFloor> = [
  Stage0UnitFloor { prefix: "std", unit_id: stage0_unit_std_core },
  Stage0UnitFloor { prefix: "extdeps", unit_id: stage0_unit_std_core },
  Stage0UnitFloor { prefix: "gunbc", unit_id: stage0_unit_std_core },
  Stage0UnitFloor { prefix: "v1.std", unit_id: stage0_unit_std_core },
  // The surface unit: the modules std.effects is built over, kept out of std-core so the core crate
  // does not compile them.
  Stage0UnitFloor { prefix: "extdeps.uri_path", unit_id: stage0_unit_std_surface },
  Stage0UnitFloor { prefix: "std.interface_summary", unit_id: stage0_unit_std_surface },
  Stage0UnitFloor { prefix: "std.trait_derive_shape", unit_id: stage0_unit_std_surface },
  Stage0UnitFloor { prefix: "extdeps.languages", unit_id: stage0_unit_extdeps_languages },
  Stage0UnitFloor { prefix: "v1.compiler", unit_id: stage0_unit_v1_infer },
  Stage0UnitFloor { prefix: "v1.compiler.artifact", unit_id: stage0_unit_v1_artifact },
  Stage0UnitFloor { prefix: "v1.compiler.languages", unit_id: stage0_unit_v1_artifact },
  // The corpus-owned source-to-target binding rows sit between the extdeps-languages layer they
  // cite and the coercion module that reads them: v1_compiler_coercion, in v1-infer, references
  // them, so they are one crate with it.
  Stage0UnitFloor { prefix: "gunbc.rust_source_type_bindings", unit_id: stage0_unit_v1_infer },
  Stage0UnitFloor { prefix: "gunbc.structural_realization_bindings", unit_id: stage0_unit_v1_infer }
]

// EVERY WAY THE DERIVATION CAN FAIL IS A REFUSAL, NEVER A SMALLER PARTITION. Dropping a module or
// an edge would hand the R4 verdict and every crate row a partition that resolves cleanly and reads
// as complete, which is the absorbing fallback gunbc.design_argument::fail_closed forbids.
type Stage0PartitionDerivationRefusal
  = Stage0SourceRootUndeclared { module_name: String }
  | Stage0SourceRootAmbiguous { module_name: String, paths: List<String> }
  | Stage0SourceDependencyUnresolved { importer_path: String, target_module: String }
  | Stage0PartitionedBasenameAmbiguous { basename: String, modules: List<String> }
  | Stage0UnitFloorMissing { module_name: String }
  | Stage0UnitFloorAmbiguous { module_name: String, prefix: String }
  | Stage0UnitFloorUnranked { prefix: String, unit_id: CompilationUnitId }
  | Stage0DerivationLookupRejected { key: String }

type Stage0Placement {
  basename: String
  unit_id: CompilationUnitId
}

type Stage0PartitionDerivation
  = Stage0PartitionDerived { module_dag: ModuleDag, placements: List<Stage0Placement> }
  | Stage0PartitionDerivationRefused { cause: Stage0PartitionDerivationRefusal }

fn stage0_partition_derivation_refusal_line(cause: Stage0PartitionDerivationRefusal) -> String {
  match cause {
    Stage0SourceRootUndeclared { module_name: m } =>
      concat("stage0 partition: source root ", m, " is declared by no module of the pool")
    Stage0SourceRootAmbiguous { module_name: m, paths: ps } =>
      concat("stage0 partition: source root ", m, " is declared at more than one path: ", join(ps, ", "))
    Stage0SourceDependencyUnresolved { importer_path: p, target_module: t } =>
      concat("stage0 partition: ", p, " depends on ", t, ", which no module of the pool declares")
    Stage0PartitionedBasenameAmbiguous { basename: b, modules: ms } =>
      concat("stage0 partition: modules ", join(ms, ", "), " all emit to the mirror ", b)
    Stage0UnitFloorMissing { module_name: m } =>
      concat("stage0 partition: no stage0_unit_floors row covers ", m)
    Stage0UnitFloorAmbiguous { module_name: m, prefix: p } =>
      concat("stage0 partition: stage0_unit_floors has two rows for ", p, ", the floor of ", m)
    Stage0UnitFloorUnranked { prefix: p, unit_id: u } =>
      concat("stage0 partition: the floor row for ", p, " names ", u as String, ", which stage0_unit_order does not list")
    Stage0DerivationLookupRejected { key: k } =>
      concat("stage0 partition: a map read of ", k, " was rejected")
  }
}

// THE CLOSURE OF A SET OF ENTRIES, AS A MODULE DAG: the one rule both fact-reading partitions call
// (this stage0 one with its source roots, v2.workflow.emitted_closure_crate_partition with its one
// entry). Nodes are the declared modules the entries reach, under their own names; edges are the
// shared projection's. An undeclared entry refuses, and every dependency of a reached module must
// resolve to a declared module, the first that does not refusing with its importer and target --
// a closure that skipped it would be a SMALLER graph that partitions cleanly. Modules of the pool
// no entry reaches are never inspected.
type ModuleDagDerivationRefusal
  = ClosureEntryUndeclared { entry_path: String }
  | ClosureDependencyUnresolved { importer_path: String, target_module: String }
  | ClosureFactLookupRejected { key: String }

type ModuleDagDerivation
  = ModuleDagDerived { module_dag: ModuleDag }
  | ModuleDagDerivationRefused { cause: ModuleDagDerivationRefusal }

fn closure_entry_declared(entry_path: String, declarations: List<ModuleDeclarationFact>) -> Bool {
  declarations |> any(decl => decl.path == entry_path)
}

fn closure_refusal_of(cause: DependencyEdgeProjectionRefusal) -> ModuleDagDerivationRefusal {
  match cause {
    ProjectedDependencyUnresolved { importer_path: path, target_module: target } =>
      ClosureDependencyUnresolved { importer_path: path, target_module: target }
    ProjectedDependencyOutsideNodes { importer_path: path, importer: _, target_module: target } =>
      ClosureDependencyUnresolved { importer_path: path, target_module: target }
    ProjectedFactLookupRejected { key: key } =>
      ClosureFactLookupRejected { key: key }
  }
}

fn closure_path_set(entry_paths: List<String>, adjacency: Map<String, List<String>>) -> Map<String, Bool> {
  entry_paths |> fold(init: empty_map(), f: fn(acc, entry) {
    dependency_closure_over_adjacency(entry_path: entry, adjacency: adjacency)
      |> fold(init: acc, f: fn(inner, path) { map_insert(inner, path, true) })
  })
}

fn closure_module_by_path(declarations: List<ModuleDeclarationFact>, closure: Map<String, Bool>) -> Map<String, String> {
  declarations |> fold(init: empty_map(), f: fn(acc, decl) {
    match map_get_checked(closure, decl.path) {
      Accepted { value: Present { value: _ }, diagnostics: _ } => map_insert(acc, decl.path, decl.module)
      Accepted { value: Absent, diagnostics: _ } => acc
      Rejected { diagnostics: _ } => acc
    }
  })
}

fn closure_module_at(by_path: Map<String, String>, path: String) -> Optional<String> {
  match map_get_checked(by_path, path) {
    Accepted { value: found, diagnostics: _ } => found
    Rejected { diagnostics: _ } => Absent
  }
}

fn module_dag_from_dependency_facts(
  entry_paths: List<String>,
  edges: List<ModuleDependencyEdge>,
  declarations: List<ModuleDeclarationFact>
) -> ModuleDagDerivation {
  let undeclared = entry_paths |> filter(path => !closure_entry_declared(entry_path: path, declarations: declarations))
  match undeclared {
    Cons { head: path, tail: _ } => ModuleDagDerivationRefused { cause: ClosureEntryUndeclared { entry_path: path } }
    Empty => {
      let closure = closure_path_set(entry_paths: entry_paths, adjacency: build_dependency_adjacency(edges: edges, nodes: declarations))
      let by_path = closure_module_by_path(declarations: declarations, closure: closure)
      let modules = declarations |> fold(init: [], f: fn(acc, decl) {
        match closure_module_at(by_path: by_path, path: decl.path) {
          Present { value: module_id } => acc |> list_push(module_id as ModuleId)
          Absent => acc
        }
      })
      let node_by_module = modules |> fold(init: empty_map(), f: fn(acc, module_id) { map_insert(acc, module_id as String, module_id as String) })
      match project_dependency_edges(importer_node_by_path: by_path, node_by_module: node_by_module, dependencies: edges) {
        DependencyEdgesRefused { cause: cause } => ModuleDagDerivationRefused { cause: closure_refusal_of(cause: cause) }
        DependencyEdgesProjected { edges: projected } =>
          ModuleDagDerived {
            module_dag: ModuleDag {
              modules: modules,
              edges: projected,
              exports: empty_map(),
              type_definitions: empty_map(),
            }
          }
      }
    }
  }
}

// The roots by module name, read to the paths the closure walks from: each must be declared exactly
// once in the pool.
type Stage0RootPaths
  = Stage0RootPathsResolved { paths: List<String> }
  | Stage0RootPathsRefused { cause: Stage0PartitionDerivationRefusal }

fn stage0_root_paths(roots: List<String>, declarations: List<ModuleDeclarationFact>) -> Stage0RootPaths {
  roots |> fold(init: Stage0RootPathsResolved { paths: [] }, f: fn(acc, root) {
    match acc {
      Stage0RootPathsRefused { cause: _ } => acc
      Stage0RootPathsResolved { paths: found } => {
        let declared = declarations |> filter(decl => decl.module == root) |> map(decl => decl.path)
        match declared {
          Empty => Stage0RootPathsRefused { cause: Stage0SourceRootUndeclared { module_name: root } }
          Cons { head: path, tail: Empty } => Stage0RootPathsResolved { paths: found |> list_push(path) }
          Cons { head: _, tail: Cons { head: _, tail: _ } } =>
            Stage0RootPathsRefused { cause: Stage0SourceRootAmbiguous { module_name: root, paths: declared } }
        }
      }
    }
  })
}

fn stage0_refusal_of_closure(cause: ModuleDagDerivationRefusal) -> Stage0PartitionDerivationRefusal {
  match cause {
    ClosureEntryUndeclared { entry_path: path } => Stage0SourceRootUndeclared { module_name: path }
    ClosureDependencyUnresolved { importer_path: path, target_module: target } =>
      Stage0SourceDependencyUnresolved { importer_path: path, target_module: target }
    ClosureFactLookupRejected { key: key } => Stage0DerivationLookupRejected { key: key }
  }
}

// Each member module's mirror basename, by the emitter's own filename rule. The runtime is the
// emitter's prelude rather than a .dag module, so it holds its basename before any module is read,
// and a module that would emit to the same file -- the runtime's or another module's -- refuses.
type Stage0BasenameIndex {
  by_module: Map<String, String>
  module_by_basename: Map<String, String>
  refusal: Optional<Stage0PartitionDerivationRefusal>
}

fn stage0_basename_index(modules: List<ModuleId>) -> Stage0BasenameIndex {
  let init = Stage0BasenameIndex {
    by_module: empty_map(),
    module_by_basename: map_insert(empty_map(), rust_runtime_prelude_module, rust_runtime_prelude_module),
    refusal: Absent
  }
  modules |> fold(init: init, f: fn(acc, module_id) {
    match acc.refusal {
      Present { value: _ } => acc
      Absent => {
        let module_name = module_id as String
        let basename = rust_module_emit_filename(module_name: module_name)
        match map_get_checked(acc.module_by_basename, basename) {
          Rejected { diagnostics: _ } =>
            Stage0BasenameIndex { by_module: acc.by_module, module_by_basename: acc.module_by_basename, refusal: Present { value: Stage0DerivationLookupRejected { key: basename } } }
          Accepted { value: Present { value: other }, diagnostics: _ } =>
            Stage0BasenameIndex { by_module: acc.by_module, module_by_basename: acc.module_by_basename, refusal: Present { value: Stage0PartitionedBasenameAmbiguous { basename: basename, modules: [other, module_name] } } }
          Accepted { value: Absent, diagnostics: _ } =>
            Stage0BasenameIndex {
              by_module: map_insert(acc.by_module, module_name, basename),
              module_by_basename: map_insert(acc.module_by_basename, basename, module_name),
              refusal: Absent
            }
        }
      }
    }
  })
}

type Stage0RankRead
  = Stage0RankFound { rank: Int }
  | Stage0RankRefused { cause: Stage0PartitionDerivationRefusal }

fn stage0_unit_rank(order: List<CompilationUnitId>, unit_id: CompilationUnitId) -> Optional<Int> {
  let found = order |> fold(init: Stage0RankScan { index: 0, rank: Absent }, f: fn(acc, unit) {
    match acc.rank {
      Present { value: _ } => acc
      Absent =>
        if unit == unit_id {
          Stage0RankScan { index: acc.index + 1, rank: Present { value: acc.index } }
        } else {
          Stage0RankScan { index: acc.index + 1, rank: Absent }
        }
    }
  })
  found.rank
}

type Stage0RankScan {
  index: Int
  rank: Optional<Int>
}

fn stage0_unit_at(order: List<CompilationUnitId>, rank: Int) -> Optional<CompilationUnitId> {
  let found = order |> fold(init: Stage0UnitScan { index: 0, unit: Absent }, f: fn(acc, unit) {
    if acc.index == rank {
      Stage0UnitScan { index: acc.index + 1, unit: Present { value: unit } }
    } else {
      Stage0UnitScan { index: acc.index + 1, unit: acc.unit }
    }
  })
  found.unit
}

type Stage0UnitScan {
  index: Int
  unit: Optional<CompilationUnitId>
}

fn stage0_floor_covers(floor: Stage0UnitFloor, module_name: String) -> Bool {
  module_name == floor.prefix || starts_with(s: module_name, prefix: concat(floor.prefix, "."))
}

// The most specific covering row: the covering prefixes of one module form a chain, so it is the
// one no other covering row extends. Two rows with one prefix have no most specific member.
fn stage0_floor_rank(module_name: String, floors: List<Stage0UnitFloor>, order: List<CompilationUnitId>) -> Stage0RankRead {
  let covering = floors |> filter(floor => stage0_floor_covers(floor: floor, module_name: module_name))
  let most_specific = covering |> filter(floor =>
    !(covering |> any(other => starts_with(s: other.prefix, prefix: concat(floor.prefix, "."))))
  )
  match most_specific {
    Empty => Stage0RankRefused { cause: Stage0UnitFloorMissing { module_name: module_name } }
    Cons { head: floor, tail: Cons { head: _, tail: _ } } =>
      Stage0RankRefused { cause: Stage0UnitFloorAmbiguous { module_name: module_name, prefix: floor.prefix } }
    Cons { head: floor, tail: Empty } =>
      match stage0_unit_rank(order: order, unit_id: floor.unit_id) {
        Present { value: rank } => Stage0RankFound { rank: rank }
        Absent => Stage0RankRefused { cause: Stage0UnitFloorUnranked { prefix: floor.prefix, unit_id: floor.unit_id } }
      }
  }
}

fn stage0_rank_max(acc: Stage0RankRead, next: Stage0RankRead) -> Stage0RankRead {
  match acc {
    Stage0RankRefused { cause: _ } => acc
    Stage0RankFound { rank: a } =>
      match next {
        Stage0RankRefused { cause: _ } => next
        Stage0RankFound { rank: b } => if b > a { next } else { acc }
      }
  }
}

fn stage0_placed_rank(rank_by_module: Map<String, Int>, module_name: String) -> Stage0RankRead {
  match map_get_checked(rank_by_module, module_name) {
    Accepted { value: Present { value: rank }, diagnostics: _ } => Stage0RankFound { rank: rank }
    Accepted { value: Absent, diagnostics: _ } => Stage0RankRefused { cause: Stage0DerivationLookupRejected { key: module_name } }
    Rejected { diagnostics: _ } => Stage0RankRefused { cause: Stage0DerivationLookupRejected { key: module_name } }
  }
}

fn stage0_component_has(component: List<String>, module_name: String) -> Bool {
  component |> any(member => member == module_name)
}

type Stage0PlacementFold {
  rank_by_module: Map<String, Int>
  placements: List<Stage0Placement>
  refusal: Optional<Stage0PartitionDerivationRefusal>
}

fn stage0_placement_refused(acc: Stage0PlacementFold, cause: Stage0PartitionDerivationRefusal) -> Stage0PlacementFold {
  Stage0PlacementFold { rank_by_module: acc.rank_by_module, placements: acc.placements, refusal: Present { value: cause } }
}

// One component, placed together: the latest of its members' floors and of the units its
// dependencies outside it were already placed in (components arrive dependencies first, so each
// such dependency has a rank). A cycle therefore has one unit whatever order its members are read in.
fn stage0_place_component(
  acc: Stage0PlacementFold,
  component: List<String>,
  edges: List<ModuleDagEdge>,
  by_module: Map<String, String>,
  floors: List<Stage0UnitFloor>,
  order: List<CompilationUnitId>
) -> Stage0PlacementFold {
  match acc.refusal {
    Present { value: _ } => acc
    Absent => {
      let floor_rank = component |> fold(init: Stage0RankFound { rank: 0 }, f: fn(rank, module_name) {
        stage0_rank_max(acc: rank, next: stage0_floor_rank(module_name: module_name, floors: floors, order: order))
      })
      let read = edges
        |> filter(edge => stage0_component_has(component: component, module_name: edge.from as String) && !stage0_component_has(component: component, module_name: edge.to as String))
        |> fold(init: floor_rank, f: fn(rank, edge) {
          stage0_rank_max(acc: rank, next: stage0_placed_rank(rank_by_module: acc.rank_by_module, module_name: edge.to as String))
        })
      match read {
        Stage0RankRefused { cause: cause } => stage0_placement_refused(acc: acc, cause: cause)
        Stage0RankFound { rank: rank } =>
          match stage0_unit_at(order: order, rank: rank) {
            Absent => stage0_placement_refused(acc: acc, cause: Stage0DerivationLookupRejected { key: "stage0_unit_order" })
            Present { value: unit_id } =>
              component |> fold(init: acc, f: fn(placed, module_name) {
                match placed.refusal {
                  Present { value: _ } => placed
                  Absent =>
                    match map_get_checked(by_module, module_name) {
                      Accepted { value: Present { value: basename }, diagnostics: _ } =>
                        Stage0PlacementFold {
                          rank_by_module: map_insert(placed.rank_by_module, module_name, rank),
                          placements: placed.placements |> list_push(Stage0Placement { basename: basename, unit_id: unit_id }),
                          refusal: Absent
                        }
                      Accepted { value: Absent, diagnostics: _ } => stage0_placement_refused(acc: placed, cause: Stage0DerivationLookupRejected { key: module_name })
                      Rejected { diagnostics: _ } => stage0_placement_refused(acc: placed, cause: Stage0DerivationLookupRejected { key: module_name })
                    }
                }
              })
          }
      }
    }
  }
}

// Pure over its supplied facts and policy, so every refusal arm is drivable from a fixture; the
// live binding below is the only caller that reads the tree. The placements are in basename order
// -- the order the crate rows list their modules in -- and the runtime is placed in the first unit.
fn stage0_partition_derivation_over(
  roots: List<String>,
  floors: List<Stage0UnitFloor>,
  order: List<CompilationUnitId>,
  declarations: List<ModuleDeclarationFact>,
  dependencies: List<ModuleDependencyEdge>
) -> Stage0PartitionDerivation {
  match stage0_root_paths(roots: roots, declarations: declarations) {
    Stage0RootPathsRefused { cause: cause } => Stage0PartitionDerivationRefused { cause: cause }
    Stage0RootPathsResolved { paths: paths } =>
      match module_dag_from_dependency_facts(entry_paths: paths, edges: dependencies, declarations: declarations) {
        ModuleDagDerivationRefused { cause: cause } => Stage0PartitionDerivationRefused { cause: stage0_refusal_of_closure(cause: cause) }
        ModuleDagDerived { module_dag: closure } => {
          let index = stage0_basename_index(modules: closure.modules)
          match index.refusal {
            Present { value: cause } => Stage0PartitionDerivationRefused { cause: cause }
            Absent => {
              let placed = partition_components_dependencies_first(modules: closure.modules, edges: closure.edges)
                |> fold(init: Stage0PlacementFold { rank_by_module: empty_map(), placements: [], refusal: Absent }, f: fn(acc, component) {
                  stage0_place_component(acc: acc, component: component, edges: closure.edges, by_module: index.by_module, floors: floors, order: order)
                })
              match placed.refusal {
                Present { value: cause } => Stage0PartitionDerivationRefused { cause: cause }
                Absent =>
                  match stage0_unit_at(order: order, rank: 0) {
                    Absent => Stage0PartitionDerivationRefused { cause: Stage0DerivationLookupRejected { key: "stage0_unit_order" } }
                    Present { value: runtime_unit } =>
                      stage0_partition_derived(
                        closure: closure,
                        by_module: index.by_module,
                        placements: list_sort_by_key(
                          xs: placed.placements |> list_push(Stage0Placement { basename: rust_runtime_prelude_module, unit_id: runtime_unit }),
                          key: placement => placement.basename,
                          order: string_total_order()
                        )
                      )
                  }
              }
            }
          }
        }
      }
  }
}

// The closure's DAG under mirror basenames, with the runtime as a node: the shape the resolve, the
// fold and the emitted-edge merge take.
fn stage0_partition_derived(
  closure: ModuleDag,
  by_module: Map<String, String>,
  placements: List<Stage0Placement>
) -> Stage0PartitionDerivation {
  let renamed = closure.edges |> fold(init: Stage0EdgeRename { edges: [], refusal: Absent }, f: fn(acc, edge) {
    match acc.refusal {
      Present { value: _ } => acc
      Absent =>
        match stage0_basename_of(by_module: by_module, module_name: edge.from as String) {
          Absent => Stage0EdgeRename { edges: acc.edges, refusal: Present { value: Stage0DerivationLookupRejected { key: edge.from as String } } }
          Present { value: from } =>
            match stage0_basename_of(by_module: by_module, module_name: edge.to as String) {
              Absent => Stage0EdgeRename { edges: acc.edges, refusal: Present { value: Stage0DerivationLookupRejected { key: edge.to as String } } }
              Present { value: to } =>
                Stage0EdgeRename { edges: acc.edges |> list_push(ModuleDagEdge { from: stage0_module_id(basename: from), to: stage0_module_id(basename: to) }), refusal: Absent }
            }
        }
    }
  })
  match renamed.refusal {
    Present { value: cause } => Stage0PartitionDerivationRefused { cause: cause }
    Absent => {
      let basenames = placements |> map(placement => placement.basename)
      Stage0PartitionDerived {
        module_dag: ModuleDag {
          modules: basenames |> map(basename => stage0_module_id(basename: basename)),
          edges: renamed.edges,
          exports: stage0_module_dag_exports_map(modules: basenames),
          type_definitions: stage0_module_dag_type_definitions_map(modules: basenames),
        },
        placements: placements
      }
    }
  }
}

type Stage0EdgeRename {
  edges: List<ModuleDagEdge>
  refusal: Optional<Stage0PartitionDerivationRefusal>
}

fn stage0_basename_of(by_module: Map<String, String>, module_name: String) -> Optional<String> {
  match map_get_checked(by_module, module_name) {
    Accepted { value: found, diagnostics: _ } => found
    Rejected { diagnostics: _ } => Absent
  }
}

// THE LIVE FACTS ARE READ FROM THE ROOTS OUTWARD, NOT OFF THE WHOLE POOL. The partition is about a
// hundred modules of a pool of thousands, and the population read
// (v2.lens.module_graph dependency_resolution_facts_live) resolves every file's references to
// answer it: measured on the seed at b4c9972 over dag and src/v1, about 575 s, on a path heal's host
// takes several times a round. So this walk asks the one edge producer's keyed reads for exactly the
// modules the roots reach -- each module's declaration (module_declaration_facts_at_live) and its
// importer edges (dependency_resolution_facts_at_live), which are the population read narrowed to
// one key and carry the same rows -- and hands what it read to the same pure derivation. It decides
// nothing: an undeclared root reads no declaration and an unresolved target is not followed, and
// stage0_partition_derivation_over refuses both from the facts the walk collected.
type Stage0FactWalk {
  declarations: List<ModuleDeclarationFact>
  dependencies: List<ModuleDependencyEdge>
  seen: Map<String, Bool>
  queue: List<String>
}

fn stage0_fact_walk_absorb(acc: Stage0FactWalk, target: String) -> Stage0FactWalk {
  match map_get_checked(acc.seen, target) {
    Accepted { value: Present { value: _ }, diagnostics: _ } => acc
    Accepted { value: Absent, diagnostics: _ } =>
      Stage0FactWalk { declarations: acc.declarations, dependencies: acc.dependencies, seen: map_insert(acc.seen, target, true), queue: acc.queue |> list_push(target) }
    // A rejected read re-reads the target rather than skipping it: reading a module twice repeats
    // facts the derivation deduplicates, while skipping one would shrink the closure.
    Rejected { diagnostics: _ } =>
      Stage0FactWalk { declarations: acc.declarations, dependencies: acc.dependencies, seen: acc.seen, queue: acc.queue |> list_push(target) }
  }
}

fn stage0_fact_walk(state: Stage0FactWalk, pool_roots: List<String>) -> Stage0FactWalk {
  match state.queue |> first {
    Absent => state
    Present { value: name } => {
      let declared = module_declaration_facts_at_live(pool_roots: pool_roots, module_path: name)
      let facts = declared |> flat_map(decl => dependency_resolution_facts_at_live(pool_roots: pool_roots, importer_path: decl.path, exclude_substrings: []))
      let read = Stage0FactWalk {
        declarations: state.declarations |> concat(declared),
        dependencies: state.dependencies |> concat(facts),
        seen: state.seen,
        queue: state.queue |> skip(1)
      }
      stage0_fact_walk(
        state: facts |> filter(fact => fact.target_declared) |> fold(init: read, f: fn(acc, fact) { stage0_fact_walk_absorb(acc: acc, target: fact.target_module) }),
        pool_roots: pool_roots
      )
    }
  }
}

fn stage0_partition_facts_live(roots: List<String>, pool_roots: List<String>) -> Stage0FactWalk {
  stage0_fact_walk(
    state: Stage0FactWalk {
      declarations: [],
      dependencies: [],
      seen: roots |> fold(init: empty_map(), f: fn(acc, root) { map_insert(acc, root, true) }),
      queue: roots
    },
    pool_roots: pool_roots
  )
}

data stage0_partition_live_facts: Stage0FactWalk = stage0_partition_facts_live(
  roots: stage0_partition_source_roots,
  pool_roots: stage0_source_pool_roots
)

data stage0_partition_derivation: Stage0PartitionDerivation = stage0_partition_derivation_over(
  roots: stage0_partition_source_roots,
  floors: stage0_unit_floors,
  order: stage0_unit_order,
  declarations: stage0_partition_live_facts.declarations,
  dependencies: stage0_partition_live_facts.dependencies
)

fn stage0_partition_policy_ref() -> DeclarationRef {
  DeclarationRef {
    module_path: "v2.workflow.rust_crate_partition" as NonEmptyStr,
    decl_name: "stage0_partition_derivation_over" as NonEmptyStr,
    field: WholeDeclaration,
  }
}

fn stage0_partition_provenance() -> PartitionProvenance {
  partition_provenance_policy_derived(policy: stage0_partition_policy_ref())
}

fn stage0_partition_assignment(placements: List<Stage0Placement>) -> Map<ModuleId, CompilationUnitId> {
  placements |> fold(init: empty_map(), f: fn(acc, placement) {
    map_insert(acc, stage0_module_id(basename: placement.basename), placement.unit_id)
  })
}

fn stage0_partition_parameter(placements: List<Stage0Placement>) -> PartitionParameter {
  ExplicitPartitionParam { partition: ExplicitPartition { assignment: stage0_partition_assignment(placements: placements) } }
}

fn stage0_unit_modules(placements: List<Stage0Placement>, unit_id: CompilationUnitId) -> List<String> {
  placements |> filter(placement => placement.unit_id == unit_id) |> map(placement => placement.basename)
}

// THE ONE RULE FOR PROJECTING DEPENDENCY FACTS ONTO A MODULE DAG. Both partitions that read
// v2.lens.module_graph facts -- this stage0 one and v2.workflow.emitted_closure_crate_partition's
// emitted closure -- call it, and differ only in which declared modules are nodes and what each
// node is called, which they pass as data. A fact whose importer is not a node is not inspected.
// For one whose importer is a node: an undeclared target refuses; a declared target that is not a
// node refuses (a node depending on a module outside the graph is an edge the graph cannot
// carry); a self dependency is no edge; several facts joining one pair (an import and a reference
// to the same module) are ONE edge, keyed rather than searched; and a rejected map read refuses,
// because reading it as absent would skip an importer or drop an edge and hand the verdict a
// smaller graph -- the absorbing fallback gunbc.design_argument::fail_closed forbids.
type DependencyEdgeProjectionRefusal
  = ProjectedDependencyUnresolved { importer_path: String, target_module: String }
  | ProjectedDependencyOutsideNodes { importer_path: String, importer: String, target_module: String }
  | ProjectedFactLookupRejected { key: String }

type DependencyEdgeProjection
  = DependencyEdgesProjected { edges: List<ModuleDagEdge> }
  | DependencyEdgesRefused { cause: DependencyEdgeProjectionRefusal }

type DependencyEdgeProjectionFold {
  edges: List<ModuleDagEdge>
  seen: Map<String, Bool>
  refusal: Optional<DependencyEdgeProjectionRefusal>
}

fn projection_refused(acc: DependencyEdgeProjectionFold, cause: DependencyEdgeProjectionRefusal) -> DependencyEdgeProjectionFold {
  DependencyEdgeProjectionFold { edges: acc.edges, seen: acc.seen, refusal: Present { value: cause } }
}

fn project_dependency_edge_step(
  acc: DependencyEdgeProjectionFold,
  edge: ModuleDependencyEdge,
  importer_node_by_path: Map<String, String>,
  node_by_module: Map<String, String>
) -> DependencyEdgeProjectionFold {
  match acc.refusal {
    Present { value: _ } => acc
    Absent =>
      match map_get_checked(importer_node_by_path, edge.path) {
        Rejected { diagnostics: _ } => projection_refused(acc: acc, cause: ProjectedFactLookupRejected { key: edge.path })
        Accepted { value: Absent, diagnostics: _ } => acc
        Accepted { value: Present { value: importer }, diagnostics: _ } =>
          if !edge.target_declared {
            projection_refused(acc: acc, cause: ProjectedDependencyUnresolved { importer_path: edge.path, target_module: edge.target_module })
          } else {
            match map_get_checked(node_by_module, edge.target_module) {
              Rejected { diagnostics: _ } => projection_refused(acc: acc, cause: ProjectedFactLookupRejected { key: edge.target_module })
              Accepted { value: Absent, diagnostics: _ } =>
                projection_refused(acc: acc, cause: ProjectedDependencyOutsideNodes { importer_path: edge.path, importer: importer, target_module: edge.target_module })
              Accepted { value: Present { value: target }, diagnostics: _ } =>
                if target == importer {
                  acc
                } else {
                  let key = concat(importer, " -> ", target)
                  match map_get_checked(acc.seen, key) {
                    Rejected { diagnostics: _ } => projection_refused(acc: acc, cause: ProjectedFactLookupRejected { key: key })
                    Accepted { value: Present { value: _ }, diagnostics: _ } => acc
                    Accepted { value: Absent, diagnostics: _ } =>
                      DependencyEdgeProjectionFold {
                        edges: acc.edges |> list_push(ModuleDagEdge { from: importer as ModuleId, to: target as ModuleId }),
                        seen: map_insert(acc.seen, key, true),
                        refusal: Absent
                      }
                  }
                }
            }
          }
      }
  }
}

fn project_dependency_edges(
  importer_node_by_path: Map<String, String>,
  node_by_module: Map<String, String>,
  dependencies: List<ModuleDependencyEdge>
) -> DependencyEdgeProjection {
  let folded = dependencies |> fold(init: DependencyEdgeProjectionFold { edges: [], seen: empty_map(), refusal: Absent }, f: fn(acc, edge) {
    project_dependency_edge_step(acc: acc, edge: edge, importer_node_by_path: importer_node_by_path, node_by_module: node_by_module)
  })
  match folded.refusal {
    Present { value: cause } => DependencyEdgesRefused { cause: cause }
    Absent => DependencyEdgesProjected { edges: folded.edges }
  }
}

// The stage0 DAG the partition decides over is the source edges PLUS the edges the emitter writes
// into every emitted module, read from the emitter's own row producer. The runtime edges this
// derives were three hand rows in the old edge list -- a partial second list of a fact the emitter
// decides for every module -- and they were deleted in favour of it.
fn stage0_module_dag_merge_over(source: ModuleDag) -> ModuleDagEmittedMerge {
  module_dag_with_emitted_edges(
    module_dag: source,
    emitted: module_dag_runtime_prelude_edges(module_dag: source)
  )
}

type ModuleDagEmittedMerge
  = ModuleDagEmittedMerged { module_dag: ModuleDag }
  | ModuleDagEmittedRefused { cause: EmittedEdgeRefusal }

fn module_dag_runtime_prelude_edges(module_dag: ModuleDag) -> List<EmittedEdge> {
  module_dag.modules |> flat_map(module_id => rust_prelude_emitted_edges(module: module_id as String))
}

// The MODULE DAG's adapters onto gunbc.crate_partition, which owns every rule below over a graph's
// modules and edges: the DAG's interface maps ride through unchanged.
fn module_dag_with_emitted_edges(module_dag: ModuleDag, emitted: List<EmittedEdge>) -> ModuleDagEmittedMerge {
  match merge_emitted_edges(modules: module_dag.modules, edges: module_dag.edges, emitted: emitted) {
    EmittedEdgesRefused { cause: cause } => ModuleDagEmittedRefused { cause: cause }
    EmittedEdgesMerged { edges: edges } =>
      ModuleDagEmittedMerged {
        module_dag: ModuleDag {
          modules: module_dag.modules,
          edges: edges,
          exports: module_dag.exports,
          type_definitions: module_dag.type_definitions,
        }
      }
  }
}

fn resolve_partition_outcome(parameter: PartitionParameter, module_dag: ModuleDag) -> ResolvePartitionOutcome {
  resolve_partition_over(parameter: parameter, modules: module_dag.modules, edges: module_dag.edges)
}

fn policy_partition_assignment(
  module_dag: ModuleDag,
  components: List<List<String>>,
  policy: PartitionPolicy
) -> Map<ModuleId, CompilationUnitId> {
  policy_partition_assignment_over(modules: module_dag.modules, components: components, policy: policy)
}

fn assignment_unit_dep_edges(module_dag: ModuleDag, assignment: Map<ModuleId, CompilationUnitId>) -> List<UnitDepEdge> {
  assignment_unit_dep_edges_over(edges: module_dag.edges, assignment: assignment)
}

// THE RESOLVE IS ONE FACT, SO IT IS ONE BINDING. Both the receipt below and
// stage0_partition_r4_valid need the assignment this produces, and they are two demands with a
// shared-state least common ancestor -- gunbc.design_argument::minimize_redundancy calls that authored duplication, not a
// caching opportunity, and says to carry the first value rather than let the second recompute it.
// The resolve carries the merged DAG it decided over, so the receipt and the re-export derivation
// read that DAG from the resolution rather than re-matching the merge: a source-edge or
// emitted-edge refusal is answered once, here, and has no second arm downstream to exist at.
type Stage0PartitionResolve
  = Stage0PartitionResolved {
      module_dag: ModuleDag
      assignment: Map<ModuleId, CompilationUnitId>
      placements: List<Stage0Placement>
    }
  | Stage0PartitionResolveRefused { cause: ResolvePartitionRefusalCause }
  | Stage0PartitionSourceRefused { cause: Stage0PartitionDerivationRefusal }

data stage0_resolve_partition_outcome: Stage0PartitionResolve = match stage0_partition_derivation {
  Stage0PartitionDerivationRefused { cause: cause } =>
    Stage0PartitionSourceRefused { cause: cause }
  Stage0PartitionDerived { module_dag: source, placements: placements } =>
    match stage0_module_dag_merge_over(source: source) {
      ModuleDagEmittedRefused { cause: cause } =>
        Stage0PartitionResolveRefused { cause: PartitionEmittedEdgeRefused { cause: cause } }
      ModuleDagEmittedMerged { module_dag: module_dag } =>
        match resolve_partition_outcome(parameter: stage0_partition_parameter(placements: placements), module_dag: module_dag) {
          ResolvePartitionOk { assignment: assignment, provenance: _ } =>
            Stage0PartitionResolved { module_dag: module_dag, assignment: assignment, placements: placements }
          ResolvePartitionRefused { cause: cause } =>
            Stage0PartitionResolveRefused { cause: cause }
        }
    }
}

data stage0_partition_receipt_outcome: Stage0PartitionReceiptOutcome = match stage0_resolve_partition_outcome {
  Stage0PartitionResolved { module_dag: module_dag, assignment: assignment, placements: _ } =>
    match partition_fold_outcome(module_dag: module_dag, assignment: assignment) {
      PartitionFoldOk { units: units } =>
        Stage0PartitionReceiptOk { units: units }
      PartitionFoldRefused { cause: cause } =>
        Stage0PartitionReceiptFoldRefused { cause: cause }
    }
  Stage0PartitionResolveRefused { cause: cause } =>
    Stage0PartitionReceiptResolveRefused { cause: cause }
  Stage0PartitionSourceRefused { cause: cause } =>
    Stage0PartitionReceiptSourceRefused { cause: cause }
}

fn validate_partition_r4(
  module_dag: ModuleDag,
  components: List<List<String>>,
  assignment: Map<ModuleId, CompilationUnitId>
) -> PartitionR4ValidityVerdict {
  validate_partition_r4_over(edges: module_dag.edges, components: components, assignment: assignment)
}

fn stage0_single_crate_assignment(modules: List<String>) -> Map<ModuleId, CompilationUnitId> {
  modules |> fold(init: empty_map(), f: fn(acc, basename) {
    map_insert(acc, stage0_module_id(basename: basename), stage0_unit_runtime)
  })
}

// MEMBERSHIP ONLY, SO IT TAKES THE ROSTER AND NO EDGES. Its one consumer compares member counts
// against the receipt over the same derived roster; a single unit has no cross-unit edge to fold.
fn stage0_single_crate_fold_outcome(modules: List<String>) -> PartitionFoldOutcome {
  partition_fold_outcome(
    module_dag: ModuleDag {
      modules: modules |> map(basename => stage0_module_id(basename: basename)),
      edges: [],
      exports: stage0_module_dag_exports_map(modules: modules),
      type_definitions: stage0_module_dag_type_definitions_map(modules: modules),
    },
    assignment: stage0_single_crate_assignment(modules: modules)
  )
}

fn compilation_unit_member_count(units: List<CompilationUnit>) -> Int {
  units |> flat_map(unit => unit.members) |> count
}

fn stage0_partition_member_coverage_consistent(
  left: PartitionFoldOutcome,
  right: Stage0PartitionReceiptOutcome
) -> Bool {
  match left {
    PartitionFoldOk { units: left_units } =>
      match right {
        Stage0PartitionReceiptOk { units: right_units } => {
          let left_count = compilation_unit_member_count(units: left_units)
          let right_count = compilation_unit_member_count(units: right_units)
          left_count == right_count
        }
        Stage0PartitionReceiptResolveRefused { cause: _ } => false
        Stage0PartitionReceiptSourceRefused { cause: _ } => false
        Stage0PartitionReceiptFoldRefused { cause: _ } => false
      }
    PartitionFoldRefused { cause: _ } => false
  }
}

// THE CRATES, WITHOUT THEIR MODULES. Which packages exist, where they live and what each re-exports
// is authored and does not move when a module does; which modules each one owns is the derivation's
// answer. So a consumer that needs only a crate's identity reads these specs and depends on no
// source fact, and only a consumer that reads membership has a refusal to carry.
type Stage0PartitionCrateSpec {
  unit_id: CompilationUnitId
  package_name: String
  crate_dir: String
  kind: Stage0PartitionCrateKind
  reexport_packages: List<String>
  carries_non_empty_wrappers: Bool
}

fn stage0_module_bearing_crate_specs() -> List<Stage0PartitionCrateSpec> {
  [
    Stage0PartitionCrateSpec {
      unit_id: stage0_unit_runtime,
      package_name: "v1-stage0-runtime",
      crate_dir: "src/v1/stage0_runtime",
      kind: Stage0FoundationCrate,
      reexport_packages: [],
      carries_non_empty_wrappers: true
    },
    Stage0PartitionCrateSpec {
      unit_id: stage0_unit_std_core,
      package_name: "v1-stage0-std-core",
      crate_dir: "src/v1/stage0_std_core",
      kind: Stage0LayeredCoreCrate,
      reexport_packages: ["v1-stage0-runtime"],
      carries_non_empty_wrappers: false
    },
    Stage0PartitionCrateSpec {
      unit_id: stage0_unit_std_surface,
      package_name: "v1-stage0-std-surface",
      crate_dir: "src/v1/stage0_std_surface",
      kind: Stage0LayeredCoreCrate,
      reexport_packages: [
        "v1-stage0-runtime",
        "v1-stage0-std-core"
      ],
      carries_non_empty_wrappers: false
    },
    Stage0PartitionCrateSpec {
      unit_id: stage0_unit_extdeps_languages,
      package_name: "v1-stage0-extdeps-languages",
      crate_dir: "src/v1/stage0_extdeps_languages",
      kind: Stage0LayeredCoreCrate,
      reexport_packages: [
        "v1-stage0-runtime",
        "v1-stage0-std-core",
        "v1-stage0-std-surface"
      ],
      carries_non_empty_wrappers: false
    },
    Stage0PartitionCrateSpec {
      unit_id: stage0_unit_v1_artifact,
      package_name: "v1-stage0-v1-artifact",
      crate_dir: "src/v1/stage0_v1_artifact",
      kind: Stage0LayeredCoreCrate,
      reexport_packages: [
        "v1-stage0-runtime",
        "v1-stage0-std-core",
        "v1-stage0-std-surface",
        "v1-stage0-extdeps-languages"
      ],
      carries_non_empty_wrappers: false
    },
    Stage0PartitionCrateSpec {
      unit_id: stage0_unit_v1_infer,
      package_name: "v1-stage0-v1-infer",
      crate_dir: "src/v1/stage0_v1_infer",
      kind: Stage0LayeredCoreCrate,
      reexport_packages: [
        "v1-stage0-runtime",
        "v1-stage0-std-core",
        "v1-stage0-std-surface",
        "v1-stage0-extdeps-languages",
        "v1-stage0-v1-artifact"
      ],
      carries_non_empty_wrappers: false
    }
  ]
}

// THE EMIT-CORE SHELL OWNS NO MODULE; IT RE-EXPORTS ONE. It hosts v1_compiler_parse by #[path]
// rather than copying its semantics, and this list is the public surface that hosting needs: each
// entry becomes a pub use of the module from its owning crate. It is authored, not derived, and it
// is checked rather than trusted -- every entry must be owned by a module-bearing crate
// (stage0_partition_row_lookups_resolved), so a module leaving the partition reds here instead of
// silently shrinking the surface.
fn stage0_r3_emit_reexport_surface_modules() -> List<String> {
  [
    "gunbc_rust_emitted_crate",
    "gunbc_rust_emitted_edge",
    "std_unicode_scalar",
    "v1_compiler_artifact",
    "v1_compiler_infer_env",
    "v1_compiler_infer_items",
    "v1_compiler_infer_service",
    "v1_compiler_infer_types",
    "v1_compiler_languages",
    "v1_compiler_parse",
    "v1_rt",
    "v1_std_core"
  ]
}

fn stage0_r3_emit_shell_crate_spec() -> Stage0PartitionCrateSpec {
  Stage0PartitionCrateSpec {
    unit_id: stage0_unit_emit_core,
    package_name: "v1-stage0-emit-core",
    crate_dir: "src/v1/stage0_emit_core",
    kind: Stage0EmitCoreCrate,
    reexport_packages: [],
    carries_non_empty_wrappers: false
  }
}

fn stage0_partition_crate_specs() -> List<Stage0PartitionCrateSpec> {
  stage0_module_bearing_crate_specs()
    |> concat([stage0_r3_emit_shell_crate_spec()])
}

fn stage0_crate_row_of(spec: Stage0PartitionCrateSpec, modules: List<String>) -> Stage0PartitionCrateRow {
  Stage0PartitionCrateRow {
    unit_id: spec.unit_id,
    package_name: spec.package_name,
    crate_dir: spec.crate_dir,
    kind: spec.kind,
    modules: modules,
    reexport_packages: spec.reexport_packages,
    carries_non_empty_wrappers: spec.carries_non_empty_wrappers
  }
}

fn stage0_module_bearing_crate_rows_over(placements: List<Stage0Placement>) -> List<Stage0PartitionCrateRow> {
  stage0_module_bearing_crate_specs()
    |> map(spec => stage0_crate_row_of(spec: spec, modules: stage0_unit_modules(placements: placements, unit_id: spec.unit_id)))
}

fn stage0_partition_crate_rows_over(placements: List<Stage0Placement>) -> List<Stage0PartitionCrateRow> {
  stage0_module_bearing_crate_rows_over(placements: placements)
    |> concat([stage0_crate_row_of(spec: stage0_r3_emit_shell_crate_spec(), modules: stage0_r3_emit_reexport_surface_modules())])
}

// THE ROWS ARE THE DERIVATION'S, SO THEY CARRY ITS REFUSAL. There is no list to fall back to, and an
// empty one would read as a partition owning nothing.
type Stage0PartitionRows
  = Stage0PartitionRowsDerived { rows: List<Stage0PartitionCrateRow> }
  | Stage0PartitionRowsRefused { cause: Stage0PartitionDerivationRefusal }

fn stage0_module_bearing_crate_rows() -> Stage0PartitionRows {
  match stage0_partition_derivation {
    Stage0PartitionDerivationRefused { cause: cause } => Stage0PartitionRowsRefused { cause: cause }
    Stage0PartitionDerived { module_dag: _, placements: placements } =>
      Stage0PartitionRowsDerived { rows: stage0_module_bearing_crate_rows_over(placements: placements) }
  }
}

fn stage0_partition_crate_rows() -> Stage0PartitionRows {
  match stage0_partition_derivation {
    Stage0PartitionDerivationRefused { cause: cause } => Stage0PartitionRowsRefused { cause: cause }
    Stage0PartitionDerived { module_dag: _, placements: placements } =>
      Stage0PartitionRowsDerived { rows: stage0_partition_crate_rows_over(placements: placements) }
  }
}

fn stage0_partition_package_names() -> List<String> {
  stage0_partition_crate_specs() |> map(spec => spec.package_name)
}

fn stage0_physical_crate_count() -> Int {
  stage0_partition_crate_specs() |> count
}

fn stage0_module_bearing_unit_count() -> Int {
  stage0_module_bearing_crate_specs() |> count
}

fn stage0_package_resolved_in_partition_specs(package_name: String) -> Bool {
  stage0_partition_crate_specs()
    |> any(spec => spec.package_name == package_name)
}

// Every re-export names a crate that exists, and every emit-shell surface entry is a module the
// derivation placed. A refused derivation has placed nothing, so it answers false.
fn stage0_partition_row_lookups_resolved() -> Bool {
  let layered_ok = stage0_module_bearing_crate_specs()
    |> all(spec => spec.reexport_packages |> all(pkg => stage0_package_resolved_in_partition_specs(package_name: pkg)))
  match stage0_partition_derivation {
    Stage0PartitionDerivationRefused { cause: _ } => false
    Stage0PartitionDerived { module_dag: _, placements: placements } =>
      layered_ok
        && (stage0_r3_emit_reexport_surface_modules()
          |> all(module_basename => placements |> any(placement => placement.basename == module_basename)))
  }
}

// resolve_partition_outcome admits an assignment only through the R4 verdict, so an Ok resolve IS
// the valid verdict; asking validate_partition_r4 again here would pay the same verdict twice.
fn stage0_partition_r4_valid() -> Bool {
  match stage0_resolve_partition_outcome {
    Stage0PartitionResolved { module_dag: _, assignment: _, placements: _ } => true
    Stage0PartitionResolveRefused { cause: _ } => false
    Stage0PartitionSourceRefused { cause: _ } => false
  }
}

fn stage0_partition_fold_ok() -> Bool {
  match stage0_partition_receipt_outcome {
    Stage0PartitionReceiptOk { units: units } =>
      (units |> count) == stage0_module_bearing_unit_count()
    Stage0PartitionReceiptResolveRefused { cause: _ } => false
    Stage0PartitionReceiptSourceRefused { cause: _ } => false
    Stage0PartitionReceiptFoldRefused { cause: _ } => false
  }
}

fn stage0_package_sets_agree(left: List<String>, right: List<String>) -> Bool {
  (left |> fold(init: true, f: fn(ok, pkg) { ok && (right |> any(p => p == pkg)) }))
    && (right |> fold(init: true, f: fn(ok, pkg) { ok && (left |> any(p => p == pkg)) }))
}

// DRIVABLE FROM SUPPLIED INPUTS, so the detector can be exercised over a fixture carrying a
// PLANTED disagreement, and the reason that control is needed is worth stating exactly rather than
// generally, because the equality contract changed it.
//
// WHILE THE LEDGER IS NON-EMPTY the contract already catches a broken detector: a detector that
// finds nothing yields a derived set that is missing the ledger's entries, and the
// no_stale_ledger_entry arm reds. Measured, not assumed -- forcing the comparison to agree reds
// BOTH the contract and this fixture guard today.
//
// THE HOLE IS THE FUTURE STATE, and it is why the guard is not redundant. Once the divergence is
// repaired the ledger empties, and then a detector that finds nothing yields [] against a ledger of
// [] -- equality holds, the contract goes green, and nothing else would be looking. That is the
// inert lens gunbc.design_argument::fail_closed warns about, arriving exactly when the debt this file tracks is
// finally paid. The guard is built now because that is when it stops being buildable from a live
// example.
type ReexportDisagreementScan
  = ReexportDisagreementScanOk { packages: List<String> }
  | ReexportDisagreementScanUnitHasNoRow { unit_id: CompilationUnitId }

fn reexport_derivation_disagreements_over(
  edges: List<UnitDepEdge>,
  rows: List<Stage0PartitionCrateRow>
) -> ReexportDisagreementScan {
  rows |> fold(init: ReexportDisagreementScanOk { packages: [] }, f: fn(acc, row) {
    match acc {
      ReexportDisagreementScanUnitHasNoRow { unit_id: unit_id } =>
        ReexportDisagreementScanUnitHasNoRow { unit_id: unit_id }
      ReexportDisagreementScanOk { packages: found } =>
        match derived_dep_packages(edges: edges, rows: rows, row: row) {
          DerivedDepPackagesUnitHasNoRow { unit_id: unit_id } =>
            ReexportDisagreementScanUnitHasNoRow { unit_id: unit_id }
          DerivedDepPackagesOk { packages: derived } =>
            if stage0_package_sets_agree(left: row.reexport_packages, right: derived) {
              ReexportDisagreementScanOk { packages: found }
            } else {
              ReexportDisagreementScanOk { packages: found |> list_push(row.package_name) }
            }
        }
    }
  })
}

// THE DEBT POPULATION IS A NAMED ROW, AND THE CONTRACT IS EQUALITY AGAINST IT, NOT A SUBSET OF IT.
// A one-way subset notices a NEW divergence and nothing else: when v1-stage0-v1-artifact is finally
// repaired the derived set empties, the subset still holds, and the row keeps naming a unit that no
// longer diverges. A stale entry then quietly re-admits that unit to diverge again with the claim
// still green, which is the silent regression gunbc.design_argument::guarantee_ladder (no silent regression) forbids -- and it would falsify this
// row's own promise that removing a package is an edit someone must make and justify.
//
// Equality in BOTH directions is what makes that edit forced, and the objection to equality does
// not apply here: it is equality against this LEDGER, not against the derived set, so it does not
// stop any lane over debt the ledger already declares. It reds in exactly one situation -- the
// ledger disagreeing with reality -- which is the situation nobody would otherwise notice.
//
// A REMOVAL CARRIES A TYPED DISPOSITION (gunbc.design_argument::fail_closed), so a repaired divergence does not just
// vanish from the ledger: it moves to the repaired roster below, which records what repaired it and
// is itself asserted against -- a package recorded as repaired that starts diverging again reds.
type Stage0ReexportDivergenceRepaired {
  package_name: String
  repaired_by: String
}

data stage0_reexport_derivation_known_divergent_packages: List<String> = []

// The claim asserts no entry here has returned to the derived set, so each row is a regression
// control. The first was put here by the edge derivation, as this roster said it would be: over the
// hand edge list v1-stage0-v1-artifact derived only the runtime as a dependency, against its four
// authored re-exports, because its modules' edges into std-core, std-surface and extdeps-languages
// were never listed. Over the derived edges it agrees.
data stage0_reexport_derivation_repaired_divergences: List<Stage0ReexportDivergenceRepaired> = [
  Stage0ReexportDivergenceRepaired {
    package_name: "v1-stage0-v1-artifact",
    repaired_by: "the stage0 source edges derived from the partitioned modules' dependency facts (v2.lens.module_graph dependency_resolution_facts_live, read today by stage0_partition_derivation) in place of the hand edge list"
  }
]

// THE REFUSAL ARM MAY NOT ANSWER []. An empty list reads as "no unit disagrees", the strongest
// possible answer, and a partition that refused to resolve has established nothing about any unit.
// Collapsing a refusal into the clean answer is the absorbing fallback gunbc.design_argument::fail_closed forbids,
// and it is the same class this lane deleted from compilation_unit, so reintroducing it here by a
// new road would be the symptom arriving in its own repair.
type Stage0ReexportDisagreementsUnavailableCause
  = Stage0ReexportPartitionResolveRefused { cause: ResolvePartitionRefusalCause }
  | Stage0ReexportSourceEdgesRefused { cause: Stage0PartitionDerivationRefusal }
  | Stage0ReexportDepUnitHasNoPackageRow { unit_id: CompilationUnitId }

type Stage0ReexportDerivationDisagreements
  = Stage0ReexportDisagreementsDerived { packages: List<String> }
  | Stage0ReexportDisagreementsUnavailable { cause: Stage0ReexportDisagreementsUnavailableCause }

fn stage0_reexport_derivation_disagreements() -> Stage0ReexportDerivationDisagreements {
  match stage0_resolve_partition_outcome {
    Stage0PartitionResolveRefused { cause: cause } =>
      Stage0ReexportDisagreementsUnavailable {
        cause: Stage0ReexportPartitionResolveRefused { cause: cause }
      }
    Stage0PartitionSourceRefused { cause: cause } =>
      Stage0ReexportDisagreementsUnavailable {
        cause: Stage0ReexportSourceEdgesRefused { cause: cause }
      }
    Stage0PartitionResolved { module_dag: module_dag, assignment: assignment, placements: placements } =>
      match reexport_derivation_disagreements_over(
        edges: assignment_unit_dep_edges(module_dag: module_dag, assignment: assignment),
        rows: stage0_module_bearing_crate_rows_over(placements: placements)
      ) {
        ReexportDisagreementScanUnitHasNoRow { unit_id: unit_id } =>
          Stage0ReexportDisagreementsUnavailable {
            cause: Stage0ReexportDepUnitHasNoPackageRow { unit_id: unit_id }
          }
        ReexportDisagreementScanOk { packages: packages } =>
          Stage0ReexportDisagreementsDerived { packages: packages }
      }
  }
}

data rust_crate_partition_dissolve_on: DissolutionCondition = unbound_dissolution(description: "dissolve-on: rust_crate_partition_interim_explicit — the stage0 partition is DERIVED (stage0_partition_derivation_over): its roster is the dependency closure of stage0_partition_source_roots plus the emitter's runtime, each module's unit is the latest of its stage0_unit_floors floor and its dependencies' units, and its edges are the dependency facts (v2.lens.module_graph dependency_resolution_facts_live). It still reaches the resolver on the explicit arm because the assignment it hands over is that rule's, not the balanced policy's. What stays authored is the rule's policy (the roots, stage0_unit_order and stage0_unit_floors), the crate specs (stage0_module_bearing_crate_specs) and the emit-core re-export surface (stage0_r3_emit_reexport_surface_modules). THE TRIGGER is the seed's crates being rendered from a partition of the emitted closure (v2.workflow.emitted_closure_crate_partition) rather than from a stage0 rule of their own; until then a new seed module needs no edit here unless it is a new root or needs a new floor. The re-export contract stays the claim's to state (test.claim.rust_crate_partition_witness stage0_reexport_derivation_disagreements_are_bounded_to_the_known_unit) and is not restated here.")

data stage0_compilation_units_list_wrapper_dissolve_on: DissolutionCondition = unbound_dissolution(description: "dissolve-on: stage0_compilation_units — removed; receipt paths must call stage0_partition_receipt_outcome (gunbc.design_argument::fail_closed List wrapper collapses resolve/fold refusal to [], indistinguishable from empty partition). Witnesses read units from Stage0PartitionReceiptOk only.")

data stage0_module_dag_interface_grounding_debt_dissolve_on: DissolutionCondition = unbound_dissolution(description: "dissolve-on: stage0_module_dag_interface_grounding — THE TRIGGER IS A CAPABILITY, NOT AN ARTIFACT. Its declarations -- the contents supply and the population -- are the typed fields of InterfaceGroundingCapability on the debt carrier, which is what a program reads; this text states what those declarations must be SUFFICIENT FOR, which a declaration ref cannot. THE CAPABILITY: the module acquirer's supply (v2.compiler.module_acquisition acquire_closure_of, the only producer of a compile's modules) must carry PER-MODULE DECLARATION CONTENTS projected from the tree its front end already normalizes to read each module's requests, never from a second parse. SUFFICIENT FOR, which is the half a decl name cannot state: partition_fold_outcome deriving a COMPLETE CompilationUnit interface — exports as module-scope declaration Nodes, and by-value ModuleTypeDefinitionRow rows — for EVERY module of the emitted compiler closure, within the required gate budget rather than at oracle scale. Both halves must hold: a supply that still carries only source text retires nothing, and contents re-derived by a second in-graph parse at a scale the gate cannot pay for retire nothing either. THE POPULATION is the emitted closure v2.workflow.emitted_closure_crate_partition derives, not a fixture; its size and the per-module eval price are owned by that derivation and its instrument, and are deliberately not copied here (gunbc.design_argument::how_to_work: name the instrument, never transcribe its output). THE HOST-EMISSION HALF NO LONGER EXISTS AS A SEPARATE TRIGGER: the hand host handler for the retired whole-tree module-binding supply was deleted with it, and the acquirer reads through the filesystem handler emitted from .dag; the CONTENTS half and the sufficiency clause above are what this row declares. A module whose provenance is ProducedByBehavior has no artifact and no file_path, so it has no contents to project: that arm must REFUSE, and its interface being supplied by its producer is a different fact owing a different declaration — answering Empty there reintroduces the exact symptom this row exists to remove. UNTIL ALL OF THAT HOLDS, R3 render uses Stage0PartitionCrateRow.modules plus the reexport_packages wildcard pub-use chain, never CompilationUnit.interface Nodes.")
