    Stage0PartitionCrateRow {
      unit_id: stage0_unit_extdeps,
      package_name: "v1-stage0-extdeps",
      crate_dir: "src/v1/stage0_extdeps",
      kind: Stage0LayeredCoreCrate,
      modules: stage0_extdeps_modules(),
      reexport_packages: [
        "v1-stage0-runtime",
        "v1-stage0-std-primitives",
        "v1-stage0-std-structure",
        "v1-stage0-std-compute",
