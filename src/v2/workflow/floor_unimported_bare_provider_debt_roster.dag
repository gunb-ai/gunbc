module v2.workflow.floor_unimported_bare_provider_debt_roster

// THE DEBT ROSTER FOR `v2.workflow.floor_unimported_bare_provider_debt`, kept in its own module and
// deliberately free of imports: the floor evaluates this file AS IT STOOD AT THE DIFF BASE, alone
// in a scratch source root, to judge an edit against it. A module that imported anything could not
// resolve there, so everything a row needs is declared here and every consumer imports it from here.
//
// ONE TOTAL DISPOSITION PER IDENTITY. Each (file, name) pair the rule inherited has exactly one row,
// and the row says whether the pair is still owed (`ActiveDebt`) or was discharged and how
// (`Retired { cause }`). There is no second list to disagree with the first, so "active and retired
// at once" is a duplicate identity and refuses as one. SEEDED ONCE, NEVER REGENERATED: a row's
// standing may move ActiveDebt -> Retired { cause } when the cause is true, and nothing else moves.

type UnimportedBareProviderRetirementCause =
    ImportsFixed
  | FileDeleted

type UnimportedBareProviderStanding =
    ActiveDebt
  | Retired { cause: UnimportedBareProviderRetirementCause }

type UnimportedBareProviderDisposition {
  file: String
  name: String
  standing: UnimportedBareProviderStanding
}

// The one spelling of an identity. The floor asks this function rather than composing the string
// itself, so the roster and the check cannot disagree about what a pair is called.
fn unimported_bare_provider_identity(file: String, name: String) -> String {
  file + "#" + name
}

// The one spelling of a standing, compared for EQUALITY by the edit verdict: a retirement's label
// may not change, and an active row's may change only by retiring.
fn unimported_bare_provider_standing_label(standing: UnimportedBareProviderStanding) -> String {
  match standing {
    ActiveDebt => "ActiveDebt"
    Retired { cause: c } => match c {
      ImportsFixed => "Retired ImportsFixed"
      FileDeleted => "Retired FileDeleted"
    }
  }
}

// A row as the host reads it: plain fields, every one derived here, so the host decodes values and
// spells nothing.
type UnimportedBareProviderRowView {
  file: String
  name: String
  identity: String
  label: String
  active: Bool
  imports_fixed: Bool
  file_deleted: Bool
}

fn unimported_bare_provider_row_view(row: UnimportedBareProviderDisposition) -> UnimportedBareProviderRowView {
  UnimportedBareProviderRowView {
    file: row.file,
    name: row.name,
    identity: unimported_bare_provider_identity(file: row.file, name: row.name),
    label: unimported_bare_provider_standing_label(standing: row.standing),
    active: match row.standing {
      ActiveDebt => true
      Retired { cause: _ } => false
    },
    imports_fixed: match row.standing {
      Retired { cause: ImportsFixed } => true
      _ => false
    },
    file_deleted: match row.standing {
      Retired { cause: FileDeleted } => true
      _ => false
    },
  }
}

fn unimported_bare_provider_roster_rows() -> List<UnimportedBareProviderRowView> {
  map(unimported_bare_provider_dispositions, r => unimported_bare_provider_row_view(row: r))
}

