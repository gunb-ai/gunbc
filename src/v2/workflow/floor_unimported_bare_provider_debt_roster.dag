module v2.workflow.floor_unimported_bare_provider_debt_roster

// THE DEBT ROSTER FOR `v2.workflow.floor_unimported_bare_provider_debt`, kept in its own module and
// deliberately free of imports: the floor evaluates this file AS IT STOOD AT THE DIFF BASE, alone
// in a scratch source root, to decide whether an edit grew the roster. A module that imported
// anything could not resolve there, so everything a row needs is declared here and every other
// consumer imports it from here.
//
// SEEDED ONCE, NEVER REGENERATED. A row leaves only by moving to the retirements with a typed
// cause, in the same change that fixes the file's imports or deletes the file.

type UnimportedBareProviderDebt {
  file: String
  name: String
}

type UnimportedBareProviderRetirementCause =
    ImportsFixed
  | FileDeleted

type RetiredUnimportedBareProvider {
  debt: UnimportedBareProviderDebt
  cause: UnimportedBareProviderRetirementCause
}

// The one spelling of an identity. The floor asks this function rather than composing the string
// itself, so the roster and the check cannot disagree about what a pair is called.
fn unimported_bare_provider_identity(file: String, name: String) -> String {
  file + "#" + name
}

fn unimported_bare_provider_debt_identity(debt: UnimportedBareProviderDebt) -> String {
  unimported_bare_provider_identity(file: debt.file, name: debt.name)
}

fn unimported_bare_provider_debt_pairs() -> List<UnimportedBareProviderDebt> {
  unimported_bare_provider_debt
}

fn unimported_bare_provider_debt_identities() -> List<String> {
  map(unimported_bare_provider_debt, d => unimported_bare_provider_debt_identity(debt: d))
}

fn unimported_bare_provider_retired_identities() -> List<String> {
  map(unimported_bare_provider_retirements, r => unimported_bare_provider_debt_identity(debt: r.debt))
}

// The pairs retired under each cause, as pairs, so the floor can hold each cause to its claim:
// an `ImportsFixed` pair's file must exist and no longer carry the pair, a `FileDeleted` pair's
// file must be gone.
fn unimported_bare_provider_retired_as_imports_fixed() -> List<UnimportedBareProviderDebt> {
  map(
    filter(
      unimported_bare_provider_retirements,
      r => match r.cause {
        ImportsFixed => true
        FileDeleted => false
      },
    ),
    r => r.debt,
  )
}

fn unimported_bare_provider_retired_as_file_deleted() -> List<UnimportedBareProviderDebt> {
  map(
    filter(
      unimported_bare_provider_retirements,
      r => match r.cause {
        ImportsFixed => false
        FileDeleted => true
      },
    ),
    r => r.debt,
  )
}

