// list_find_first is a short-circuiting element-returning find — the std/algebra gap beside
// any/filter/contains (which return Bool or the whole filtered list, never the first match with
// early-exit). Homed locally with ONE consumer (cause_ownership_lookup) per the
// facts-before-abstraction discipline: promote to v2.std.algebra when a second consumer inhabits
// it, not before. Short-circuit matters by the standing bare-minimum-cost ruling (2026-07-10): 'n
// is small here' is not time-stable — known_frontier_causes grows as causes are modeled — so the
// find returns on the first hit rather than folding the whole table.

fn list_find_first<T>(xs: FreeMonoid<T>, predicate: fn(T) -> Bool) -> Optional<T> {
  match xs {
    Empty => optional_absent()
    Cons { head: h, tail: t } =>
      if predicate(h) {
        optional_present(value: h)
      } else {
        list_find_first(xs: t, predicate: predicate)
      }
  }
}

fn cause_ownership_lookup(cause: Symbol, grain: DiagnosticGrain) -> Optional<CauseOwnership> {
  list_find_first(
    xs: known_frontier_causes,
    predicate: fn(row) {
      row.cause == cause && discriminant(v: row.grain) == discriminant(v: grain)
    }
  )
}

// This ledger's own contract stays HEAD-grain: its DoorRefused rows carry the rejection's head
// reason, so attribution for the door histogram asks the head-grain question. The fatal-grain
// question is the native route's to ask (gunbc.witness_v2_native_route), through the same lookup.
fn cause_is_attributed(cause: Symbol) -> Bool {
  match cause_ownership_lookup(cause: cause, grain: HeadGrain) {
    Present { value: _ } => true
    Absent => false
  }
}

fn all_refused_causes_attributed(rows: List<DoorLedgerRow>) -> Bool {
  fold_list(
    xs: ledger_cause_histogram(rows: rows),
    empty: true,
    cons: fn(acc, row) { acc && cause_is_attributed(cause: row.reason) }
  )
}
