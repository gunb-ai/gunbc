fn floor_eval_step_cost_drop_all_rows() -> List<EvalStepCostDropMeasurement> {
  concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(floor_eval_step_cost_drop_rows, floor_eval_step_cost_drop_apply_render_rows), floor_eval_step_cost_drop_live_forecast_rows), floor_eval_step_cost_drop_page_style_rows), floor_eval_step_cost_drop_interpreted_crypto_rows), floor_eval_step_cost_drop_app_attest_verifier_rows), floor_eval_step_cost_drop_span_program_rows), floor_eval_step_cost_drop_python_to_typescript_inhabitance_rows), floor_eval_step_cost_drop_boot_matrix_rows), floor_eval_step_cost_drop_dark_install_render_rows), floor_eval_step_cost_drop_build_job_membership_rows), floor_eval_step_cost_drop_dag_emit_round_trip_rows), floor_eval_step_cost_drop_approval_intent_digest_rows), floor_eval_step_cost_drop_dag_text_round_trip_rows), floor_eval_step_cost_drop_coproduct_fragment_normalize_rows), floor_eval_step_cost_drop_foreign_grammar_extended_parse_rows), floor_eval_step_cost_drop_bmc_secure_apply_converge_rows)
}

// THE PROJECTION THE SEED RUNNER READS AND THE MODEL TESTS AGAINST. The runner refuses an empty or
// duplicated decode of this list rather than applying it, so a failed read can never widen into an
// exemption.
fn floor_eval_step_cost_drop_members() -> List<String> {
  list_map(xs: floor_eval_step_cost_drop_all_rows(), f: fn(row) { row.identity })
}

fn floor_eval_step_cost_drop_holds(name: String) -> Bool {
  any(xs: floor_eval_step_cost_drop_all_rows(), predicate: fn(row) { row.identity == name })
}

// AMBIGUITY IS A DEFECT, NOT A HARMLESS REPEAT: a duplicated identity makes the population overstate
// what is dropped, and the second copy survives removal of the first.
fn floor_eval_step_cost_drop_has_duplicate() -> Bool {
  any(xs: floor_eval_step_cost_drop_all_rows(), predicate: fn(row) {
    int_gt(
      a: count_where(xs: floor_eval_step_cost_drop_all_rows(), predicate: fn(other) { other.identity == row.identity }),
      b: 1,
    )
  })
}
