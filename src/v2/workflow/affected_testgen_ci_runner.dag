module v2.test.workflow.affected_testgen_ci_runner

import v2.compiler.eval {
  TestClaimRun,
  run_test_claim,
  test_claim_run_verdict
}
import v2.compiler.infer { InferredTree }
import v2.lens.affected_set { AffectedSetReading }
import v2.lens.edit_locus {
  GitDiffNameOnly,
  RepoPath,
  affected_set_reading_from_git_diff_provenance
}
import v2.std.algebra { fold_list, length }
import v2.std.artifact { Artifact, NodeArtifactProvenance, SourceFile }
import v2.std.collection { List }
import v2.std.diagnostic { Accepted, Outcome, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.runtime { RuntimeValue }
import v2.std.text { String }
import v2.std.verdict { Deferred, Pass, SemanticMismatch, BuildFailed, RunFailed }
import v2.std.verification {
  RoundTripClaim,
  TestClaim,
  test_claim_evaluation_touches_rerun_frontier,
  test_claim_input
}
import v2.std.witness { Holds, StructuralPropertyWitness, Violates, Witness }
import v2.std.find_witness {
  PreservationPredicate,
}
import v2.lens.testgen {
  testgen_emit_witness_validity_claim
}
import v2.test.manual.connective_anchors { stub_empty_conj }
import v2.test.rung_3_4_common { rung34_test_claim_subject }
import v2.test.lens_common.infer_fixture {
  claim_inferred_facts,
  claim_inferred_tree
}

data affected_testgen_path_witness_validity: RepoPath = "src/v2/test/claim/generated/witness_validity.dag"
data affected_testgen_path_source_dependency: RepoPath = "src/v2/test/claim/manual/connective_anchors.dag"
data affected_testgen_path_unrelated: RepoPath = "src/v2/test/claim/generated/refinement_preservation.dag"
data affected_testgen_generated_claim_label: String = "witness-validity: constraint-satisfaction holds (positive)"

data affected_testgen_generated_claim_input: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^affected_testgen_generated_input_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data affected_testgen_source_dependency: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^affected_testgen_source_dependency_symbol } },
  children: [
    Edge {
      label: Named { name: ^affected_testgen_source_dependency_edge_symbol },
      target: affected_testgen_generated_claim_input
    }
  ],
  occurrence_id: SyntheticOccurrence
}

data affected_testgen_graph_root: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^affected_testgen_graph_edge_symbol },
      target: affected_testgen_source_dependency
    }
  ],
  occurrence_id: SyntheticOccurrence
}

data affected_testgen_generated_claim_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^affected_testgen_generated_claim_artifact_id,
  file_path: affected_testgen_path_witness_validity
}

data affected_testgen_source_dependency_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^affected_testgen_source_dependency_artifact_id,
  file_path: affected_testgen_path_source_dependency
}

data affected_testgen_generated_claim_provenance: NodeArtifactProvenance = NodeArtifactProvenance {
  node: affected_testgen_generated_claim_input,
  artifact: affected_testgen_generated_claim_artifact
}

data affected_testgen_source_dependency_provenance: NodeArtifactProvenance = NodeArtifactProvenance {
  node: affected_testgen_source_dependency,
  artifact: affected_testgen_source_dependency_artifact
}

data affected_testgen_git_diff: GitDiffNameOnly = GitDiffNameOnly {
  changed_paths: [affected_testgen_path_witness_validity]
}

data affected_testgen_dependency_git_diff: GitDiffNameOnly = GitDiffNameOnly {
  changed_paths: [affected_testgen_path_source_dependency]
}

data affected_testgen_unrelated_git_diff: GitDiffNameOnly = GitDiffNameOnly {
  changed_paths: [affected_testgen_path_unrelated]
}

fn affected_testgen_claim_tree() -> InferredTree {
  claim_inferred_tree(
    root: affected_testgen_graph_root,
    facts: claim_inferred_facts(
      type_symbol: ^affected_testgen_type_symbol,
      algebra_symbol: ^affected_testgen_algebra_symbol,
      descent_symbol: ^affected_testgen_descent_symbol
    )
  )
}

fn affected_testgen_reading_from_fixture_diff(
  git_diff: GitDiffNameOnly
) -> Witness<AffectedSetReading> {
  affected_set_reading_from_git_diff_provenance(
    graph: affected_testgen_claim_tree(),
    git_diff: git_diff,
    provenance: [
      affected_testgen_generated_claim_provenance,
      affected_testgen_source_dependency_provenance
    ]
  )
}

fn affected_testgen_emit_generated_claim() -> Outcome<TestClaim> {
  testgen_emit_witness_validity_claim(
    label: affected_testgen_generated_claim_label,
    source_facts: stub_empty_conj,
    candidate: affected_testgen_generated_claim_input,
    predicate: PreservationPredicate {
      algebra: stub_empty_conj,
      preservation_rule: ^preservation_rule_constraint_satisfaction,
    },
    witness: StructuralPropertyWitness {
      property: ^preservation_rule_constraint_satisfaction,
      evidence: stub_empty_conj,
    }
  )
}

fn affected_testgen_generated_claims_for_reading(
  reading: AffectedSetReading
) -> List<TestClaim> {
  match affected_testgen_emit_generated_claim() {
    Accepted { value: claim, diagnostics: _ } =>
      if test_claim_evaluation_touches_rerun_frontier(c: claim, frontier: reading.affected) {
        [claim]
      } else {
        []
      }
    Rejected { diagnostics: _ } => []
  }
}

fn affected_testgen_selected_claims() -> List<TestClaim> {
  match affected_testgen_reading_from_fixture_diff(git_diff: affected_testgen_git_diff) {
    Holds { value: reading } =>
      affected_testgen_generated_claims_for_reading(reading: reading)
    Violates { diagnostic: _ } => []
  }
}

fn affected_testgen_dependency_selected_claims() -> List<TestClaim> {
  match affected_testgen_reading_from_fixture_diff(git_diff: affected_testgen_dependency_git_diff) {
    Holds { value: reading } =>
      affected_testgen_generated_claims_for_reading(reading: reading)
    Violates { diagnostic: _ } => []
  }
}

fn affected_testgen_run_claim(claim: TestClaim) -> TestClaimRun<Node, RuntimeValue> {
  run_test_claim(
    subject: rung34_test_claim_subject(
      claim: claim,
      evaluator_input: test_claim_input(c: claim)
    )
  )
}

fn affected_testgen_selected_claim_runs_pass(claim: TestClaim) -> Bool {
  match test_claim_run_verdict(run: affected_testgen_run_claim(claim: claim)) {
    Pass => true
    SemanticMismatch { actual: _, falsification: _ } => false
    BuildFailed { actual: _, diagnostic: _ } => false
    RunFailed { actual: _, diagnostic: _ } => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}

fn affected_testgen_node_in_list(nodes: List<Node>, needle: Node) -> Bool {
  fold_list(
    xs: nodes,
    empty: false,
    cons: fn(found, node) {
      found || (node == needle)
    }
  )
}

fn affected_testgen_generator_emits_expected_claim_holds() -> Bool {
  match affected_testgen_emit_generated_claim() {
    Accepted { value: RoundTripClaim { label: label, anchor: _, input: _, classification: _ }, diagnostics: _ } =>
      label == affected_testgen_generated_claim_label
    _ => false
  }
}

fn affected_testgen_selects_one_generated_claim_holds() -> Bool {
  length(xs: affected_testgen_selected_claims()) == 1
}

fn affected_testgen_dependency_frontier_reaches_generated_input_holds() -> Bool {
  match affected_testgen_reading_from_fixture_diff(git_diff: affected_testgen_dependency_git_diff) {
    Holds { value: reading } =>
      reading.edit_locus == affected_testgen_source_dependency
        && affected_testgen_node_in_list(
          nodes: reading.affected,
          needle: affected_testgen_generated_claim_input
        )
    Violates { diagnostic: _ } => false
  }
}

fn affected_testgen_dependency_diff_selects_generated_claim_holds() -> Bool {
  length(xs: affected_testgen_dependency_selected_claims()) == 1
}

fn affected_testgen_generated_claim_run_passes_holds() -> Bool {
  length(xs: affected_testgen_selected_claims()) == 1
    && fold_list(
      xs: affected_testgen_selected_claims(),
      empty: true,
      cons: fn(acc, claim) {
        acc && affected_testgen_selected_claim_runs_pass(claim: claim)
      }
    )
}

fn affected_testgen_unrelated_diff_selects_no_claims_holds() -> Bool {
  match affected_testgen_reading_from_fixture_diff(git_diff: affected_testgen_unrelated_git_diff) {
    Holds { value: reading } =>
      length(xs: affected_testgen_generated_claims_for_reading(reading: reading)) == 0
    Violates { diagnostic: _ } => true
  }
}

fn affected_testgen_fusion_holds() -> Bool {
  affected_testgen_generator_emits_expected_claim_holds()
    && affected_testgen_selects_one_generated_claim_holds()
    && affected_testgen_dependency_frontier_reaches_generated_input_holds()
    && affected_testgen_dependency_diff_selects_generated_claim_holds()
    && affected_testgen_generated_claim_run_passes_holds()
    && affected_testgen_unrelated_diff_selects_no_claims_holds()
}
