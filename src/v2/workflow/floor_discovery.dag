module v2.workflow.floor_discovery


data floor_discovery_exact_subject_note: String = "The exact subject for the cross-worker discovery result. `tested_commit` and `tested_tree` are two different Git facts: the commit names the revision selected for execution, while the GitObjectId is that commit's tree object. The seed formerly stored `git rev-parse HEAD` in a String field named tested_tree, so a commit id inhabited a tree-named coordinate and a consumer could not distinguish same commit/different tree metadata from an exact source-tree binding. Source roots and execution-authority roots remain ordered semantic lists here; a digest is DERIVED only for the storage/request identity and is never carried beside the lists as a caller-asserted duplicate. Naming-authority and tool identities use the existing Fnv1a64Structural family, matching the floor snapshot's current byte/structural identity realization. This is deliberately floor-discovery grain, not a new generic compute subject beside the execution-spine lane and not the gated WalkPlan executor state machine."

type FloorDiscoveryCommitId sole_constructor {
  object_id: extdeps.git.object_store.GitObjectId
}

type FloorDiscoveryTreeId sole_constructor {
  object_id: extdeps.git.object_store.GitObjectId
}

fn floor_discovery_commit_id(object_id: extdeps.git.object_store.GitObjectId) -> FloorDiscoveryCommitId {
  FloorDiscoveryCommitId { object_id: object_id }
}

fn floor_discovery_tree_id(object_id: extdeps.git.object_store.GitObjectId) -> FloorDiscoveryTreeId {
  FloorDiscoveryTreeId { object_id: object_id }
}

type FloorDiscoverySubject {
  tested_commit: FloorDiscoveryCommitId
  tested_tree: FloorDiscoveryTreeId
  source_roots: List<String>
  execution_authority_source_roots: List<String>
  naming_authority_identity: std.content_hash.Fnv1a64Structural
  tool_identity: std.content_hash.Fnv1a64Structural
}

type FloorDiscoveryRequest {
  subject: FloorDiscoverySubject
  scan_dirs: List<String>
  exclude_substrings: List<String>
  discovery_scope_dirs: List<String>
  execution_mode: std.execution_mode.ExecutionMode
}

type FloorDiscoverySubjectMismatch
  = FloorDiscoveryTestedCommitMismatch { expected: extdeps.git.object_store.GitObjectId, observed: extdeps.git.object_store.GitObjectId }
  | FloorDiscoveryTestedTreeMismatch { expected: extdeps.git.object_store.GitObjectId, observed: extdeps.git.object_store.GitObjectId }
  | FloorDiscoverySourceRootsMismatch { expected: List<String>, observed: List<String> }
  | FloorDiscoveryExecutionAuthorityRootsMismatch { expected: List<String>, observed: List<String> }
  | FloorDiscoveryNamingAuthorityMismatch {
      expected: std.content_hash.Fnv1a64Structural,
      observed: std.content_hash.Fnv1a64Structural
    }
  | FloorDiscoveryToolIdentityMismatch {
      expected: std.content_hash.Fnv1a64Structural,
      observed: std.content_hash.Fnv1a64Structural
    }

type FloorDiscoverySubjectBinding
  = FloorDiscoverySubjectBound { subject: FloorDiscoverySubject }
  | FloorDiscoverySubjectRefused { cause: FloorDiscoverySubjectMismatch }

fn floor_discovery_subject_bind(
  expected: FloorDiscoverySubject,
  observed: FloorDiscoverySubject,
) -> FloorDiscoverySubjectBinding {
  if !extdeps.git.object_store.git_object_id_eq(left: expected.tested_commit.object_id, right: observed.tested_commit.object_id) {
    FloorDiscoverySubjectRefused {
      cause: FloorDiscoveryTestedCommitMismatch {
        expected: expected.tested_commit.object_id,
        observed: observed.tested_commit.object_id,
      }
    }
  } else if !extdeps.git.object_store.git_object_id_eq(left: expected.tested_tree.object_id, right: observed.tested_tree.object_id) {
    FloorDiscoverySubjectRefused {
      cause: FloorDiscoveryTestedTreeMismatch {
        expected: expected.tested_tree.object_id,
        observed: observed.tested_tree.object_id,
      }
    }
  } else if expected.source_roots != observed.source_roots {
    FloorDiscoverySubjectRefused {
      cause: FloorDiscoverySourceRootsMismatch {
        expected: expected.source_roots,
        observed: observed.source_roots,
      }
    }
  } else if expected.execution_authority_source_roots != observed.execution_authority_source_roots {
    FloorDiscoverySubjectRefused {
      cause: FloorDiscoveryExecutionAuthorityRootsMismatch {
        expected: expected.execution_authority_source_roots,
        observed: observed.execution_authority_source_roots,
      }
    }
  } else if expected.naming_authority_identity.digest != observed.naming_authority_identity.digest {
    FloorDiscoverySubjectRefused {
      cause: FloorDiscoveryNamingAuthorityMismatch {
        expected: expected.naming_authority_identity,
        observed: observed.naming_authority_identity,
      }
    }
  } else if expected.tool_identity.digest != observed.tool_identity.digest {
    FloorDiscoverySubjectRefused {
      cause: FloorDiscoveryToolIdentityMismatch {
        expected: expected.tool_identity,
        observed: observed.tool_identity,
      }
    }
  } else {
    FloorDiscoverySubjectBound { subject: expected }
  }
}

type FloorDiscoveryRequestMismatch
  = FloorDiscoveryRequestSubjectMismatch { cause: FloorDiscoverySubjectMismatch }
  | FloorDiscoveryScanDirsMismatch { expected: List<String>, observed: List<String> }
  | FloorDiscoveryExclusionsMismatch { expected: List<String>, observed: List<String> }
  | FloorDiscoveryScopeMismatch { expected: List<String>, observed: List<String> }
  | FloorDiscoveryExecutionModeMismatch { expected: std.execution_mode.ExecutionMode, observed: std.execution_mode.ExecutionMode }

type FloorDiscoveryRequestBinding
  = FloorDiscoveryRequestBound { request: FloorDiscoveryRequest }
  | FloorDiscoveryRequestRefused { cause: FloorDiscoveryRequestMismatch }

fn floor_discovery_request_bind(
  expected: FloorDiscoveryRequest,
  observed: FloorDiscoveryRequest,
) -> FloorDiscoveryRequestBinding {
  match floor_discovery_subject_bind(expected: expected.subject, observed: observed.subject) {
    FloorDiscoverySubjectRefused { cause: c } =>
      FloorDiscoveryRequestRefused { cause: FloorDiscoveryRequestSubjectMismatch { cause: c } }
    FloorDiscoverySubjectBound { subject: _ } => {
      if expected.scan_dirs != observed.scan_dirs {
        FloorDiscoveryRequestRefused {
          cause: FloorDiscoveryScanDirsMismatch {
            expected: expected.scan_dirs,
            observed: observed.scan_dirs,
          }
        }
      } else if expected.exclude_substrings != observed.exclude_substrings {
        FloorDiscoveryRequestRefused {
          cause: FloorDiscoveryExclusionsMismatch {
            expected: expected.exclude_substrings,
            observed: observed.exclude_substrings,
          }
        }
      } else if expected.discovery_scope_dirs != observed.discovery_scope_dirs {
        FloorDiscoveryRequestRefused {
          cause: FloorDiscoveryScopeMismatch {
            expected: expected.discovery_scope_dirs,
            observed: observed.discovery_scope_dirs,
          }
        }
      } else if !std.execution_mode.execution_mode_eq(left: expected.execution_mode, right: observed.execution_mode) {
        FloorDiscoveryRequestRefused {
          cause: FloorDiscoveryExecutionModeMismatch {
            expected: expected.execution_mode,
            observed: observed.execution_mode,
          }
        }
      } else {
        FloorDiscoveryRequestBound { request: expected }
      }
    }
  }
}

fn floor_discovery_execution_mode_identity(mode: std.execution_mode.ExecutionMode) -> String {
  match mode {
    std.execution_mode.Hermetic => "Hermetic"
    Wet => "Wet"
    Record => "Record"
  }
}

fn floor_discovery_tree_identity(tree: FloorDiscoveryTreeId) -> String {
  match tree.object_id {
    GitSha1ObjectId { digest: d } => concat("sha1:", d.hex)
    GitSha256ObjectId { digest: d } => concat("sha256:", d.hex)
  }
}

fn floor_discovery_commit_identity(commit: FloorDiscoveryCommitId) -> String {
  match commit.object_id {
    GitSha1ObjectId { digest: d } => d.hex
    GitSha256ObjectId { digest: d } => d.hex
  }
}

fn floor_discovery_identity_fold_strings(
  seed: std.content_hash.Fnv1a64Structural,
  values: List<String>,
) -> std.content_hash.Fnv1a64Structural {
  fold(
    values,
    init: seed,
    f: fn(acc, value) {
      std.content_hash.content_hash_combine_structural(left: acc, right: std.content_hash.content_hash_atom(value: value))
    }
  )
}

fn floor_discovery_request_identity(request: FloorDiscoveryRequest) -> std.content_hash.Fnv1a64Structural {
  let with_commit = std.content_hash.content_hash_combine_structural(
    left: std.content_hash.content_hash_atom(value: "floor-discovery-request-identity-v2"),
    right: std.content_hash.content_hash_atom(value: floor_discovery_commit_identity(commit: request.subject.tested_commit))
  )
  let with_tree = std.content_hash.content_hash_combine_structural(
    left: with_commit,
    right: std.content_hash.content_hash_atom(value: floor_discovery_tree_identity(tree: request.subject.tested_tree))
  )
  let with_source_roots = floor_discovery_identity_fold_strings(
    seed: with_tree,
    values: request.subject.source_roots,
  )
  let with_scan_dirs = floor_discovery_identity_fold_strings(
    seed: with_source_roots,
    values: request.scan_dirs,
  )
  let with_exclusions = floor_discovery_identity_fold_strings(
    seed: with_scan_dirs,
    values: request.exclude_substrings,
  )
  let with_scope = floor_discovery_identity_fold_strings(
    seed: with_exclusions,
    values: request.discovery_scope_dirs,
  )
  let with_mode = std.content_hash.content_hash_combine_structural(
    left: with_scope,
    right: std.content_hash.content_hash_atom(value: floor_discovery_execution_mode_identity(mode: request.execution_mode))
  )
  let with_execution_authority = floor_discovery_identity_fold_strings(
    seed: with_mode,
    values: request.subject.execution_authority_source_roots,
  )
  let with_naming_authority = std.content_hash.content_hash_combine_structural(
    left: with_execution_authority,
    right: request.subject.naming_authority_identity,
  )
  std.content_hash.content_hash_combine_structural(
    left: with_naming_authority,
    right: request.subject.tool_identity,
  )
}

data floor_discovery_exact_subject_seed_scaffold_note: String = "DECLARED SCAFFOLD for the existing Rust snapshot transport only. `src/v1/stage0/src/cli_run/floor_discovery_snapshot.rs` observes tested_commit and the format-qualified tree object selected by that commit, refuses cross-process sharing when tracked or untracked worktree bytes differ from the selected commit tree, derives this request identity in the field order above, and refuses a coordinated snapshot whose complete request differs. It does not evaluate this model per floor request because doing so would resolve another compiler world inside the path whose duplicate setup this lane removes. The executable model witness pins the authority and Rust unit controls pin the mirror. DISSOLVE-ON: generated host-effect transport can construct FloorDiscoveryRequest and its typed binding directly; then the Rust request/terminal mirror and this scaffold note delete."

type FloorDiscoveryRow {
  label: String
  entry: String
  function: String
  reads_live_tree: v2.std.live_tree.LiveTreeDisposition
}

type FloorDiscoverySidecarKind
  = TestMarkedDecl
  | WireContractDecl

type FloorDiscoverySidecarViolation {
  entry_path: String
  kind: FloorDiscoverySidecarKind
  required_suffix: String
}

fn floor_discovery_test_decl_sidecar_violation(entry_path: String) -> v2.std.optional.Optional<FloorDiscoverySidecarViolation> {
  if floor_test_marked_decl_allowed_in_entry(entry_path: entry_path) {
    optional_absent()
  } else {
    optional_present(
      value: FloorDiscoverySidecarViolation {
        entry_path: entry_path,
        kind: TestMarkedDecl,
        required_suffix: floor_test_sidecar_suffix
      }
    )
  }
}

fn floor_discovery_wire_contract_sidecar_violation(entry_path: String) -> v2.std.optional.Optional<FloorDiscoverySidecarViolation> {
  if floor_wire_contract_decl_allowed_in_entry(entry_path: entry_path) {
    optional_absent()
  } else {
    optional_present(
      value: FloorDiscoverySidecarViolation {
        entry_path: entry_path,
        kind: WireContractDecl,
        required_suffix: floor_wire_contract_sidecar_suffix
      }
    )
  }
}

data floor_discovery_producer_note: String = "Discovery producer authority: row shape + sidecar placement decisions for the floor corpus. Host realize discovers owned-data transport rows and test fn names; this module owns the typed verdicts (live-tree eligibility, sidecar suffix rules) that cli_run.rs must not re-implement."
