module v2.workflow.source_root_ingest_transport

import extdeps.git
import extdeps.gunbc
import gunbc.ci_layer_roots { witness_layer_roots }
import std.logic { Bool }
import tools.host_prelude {
  ClaimRun,
  run_gunbc_claims,
  witness_bin,
  witness_bin_ensure_built_typed,
  witness_bin_release_path
}

data ingest_source_root: String = "src/v2"
data ingest_scan_dir: String = "src/v2/test/fixture/program_assembly"
data ingest_manifest_class_note: String = "This gate used to emit its manifest to a fixed target/v2-source-root-ingest-manifest.dag and then add BARE target/ as a claim source root to read it back. That admitted the ENTIRE build-output tree as source, purely to make one generated file visible — build output as source, an unexcluded default rather than a deliberate design (nothing declares target/ as an ingest root; this was the only bare-target source root in the corpus).

It is the CLASS behind a concrete break: any tool writing a .dag under target/ collides with a committed module of the same name and panics the indexer ('module-path collision ... one module, one authority'). The module-binding supply gate hit exactly that. Fixing only that gate's overlay would have left the class open for the next writer.

So the manifest now lands in a per-run mktemp directory that is scanned and then removed, and no gate scans bare target/ any more. The emitted FILENAME is unchanged deliberately: the host-side stub-supersession table keys on the manifest BASENAME (cli_run.rs MANIFEST_STUB_OVERLAYS), so relocating the file cannot silently break stub supersession. Same shape as compiler_closure_ingest_transport, which already did this correctly."

data ingest_manifest_name: String = "/v2-source-root-ingest-manifest.dag"
data ingest_manifest_template: String = "/target/source-root-ingest-XXXXXX"
data ingest_entry: String = "src/v2/test/claim/program_assembly/real_ingest_test.dag"
data ingest_witness_module_roots_parse: String = "program_assembly_real_ingest_module_roots_parse_holds"
data ingest_witness_host_manifest_receipt: String = "program_assembly_real_ingest_host_manifest_receipt_holds"
data ingest_witness_validate_red: String = "program_assembly_real_ingest_validate_module_roots_red_on_parsed_roots"

fn sri_claim_source_roots() -> List<String> {
  concat(witness_layer_roots, [ingest_manifest_dir])
}

fn emit_manifest_args() -> List<String> {
  [
    "--source-root", ingest_source_root,
    "--scan-dir", ingest_scan_dir,
    "--emit-dag-manifest", ingest_manifest_path
  ]
}

func run_real_ingest_gate() -> Bool {
  let root = git.Core.Toplevel()
  let ingest_bin = witness_bin(var_name: "DISCOVER_SOURCE_ROOT_INGEST", bin_name: "discover_source_root_ingest")
  if witness_bin_ensure_built_typed(root: root.path, bin: ingest_bin) {
    let manifest = gunbc.WitnessBin.Run(
      workdir: root.path,
      bin_path: witness_bin_release_path(root: root.path, bin_name: "discover_source_root_ingest"),
      args: emit_manifest_args()
    )
    if manifest.success {
      run_gunbc_claims(
        source_roots: sri_claim_source_roots(),
        claims: [
          ClaimRun { entry: ingest_entry, function: ingest_witness_module_roots_parse },
          ClaimRun { entry: ingest_entry, function: ingest_witness_host_manifest_receipt },
          ClaimRun { entry: ingest_entry, function: ingest_witness_validate_red }
        ]
      )
    } else {
      false
    }
  } else {
    false
  }
}
