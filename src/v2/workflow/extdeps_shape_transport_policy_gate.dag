fn extdeps_shape_transport_policy_claim_run_rows_tsv() -> String {
  fold_list_right(
    xs: extdeps_shape_transport_policy_claim_run_rows,
    empty: "",
    snoc: fn(acc, row) {
      concat(acc,
        concat(row.label,
          concat("\t",
            concat(row.entry,
              concat("\t",
                concat(row.function, "\n"))))))
    }
  )
}
