module v2.workflow.orchestration_word_emit_test

import v2.workflow.orchestration_emit { emit_shell_word }
import extdeps.languages.bash.program {
  ShellWord,
  Lit,
  VarRef,
  Concat,
  serialize_word
}
import extdeps.communication.medium { Medium }
import v2.std.diagnostic { Accepted, None, Outcome, Rejected }
import v2.compiler.target_carriers { lossless_source }

test fn dbg_lossless_preserves_dquote_holds() -> Bool {
  lossless_source(text: "\"$ROOT\"").carried == "\"$ROOT\""
}

test fn dbg_lossless_preserves_squote_holds() -> Bool {
  lossless_source(text: "'/target'").carried == "'/target'"
}

fn word_emits_oracle(w: ShellWord) -> Bool {
  match emit_shell_word(w: w) {
    Accepted { value: src, diagnostics: dg } =>
      (src.carried == serialize_word(w: w)) && (dg == None)
    Rejected { diagnostics: _ } => false
  }
}

fn word_emits_string(w: ShellWord, expected: String) -> Bool {
  match emit_shell_word(w: w) {
    Accepted { value: src, diagnostics: _ } => src.carried == expected
    Rejected { diagnostics: _ } => false
  }
}

fn lit_git() -> ShellWord {
  Lit { text: "git" }
}

fn varref_root() -> ShellWord {
  VarRef { name: "ROOT" }
}

fn concat_root_slash() -> ShellWord {
  Concat { parts: [VarRef { name: "ROOT" }, Lit { text: "/target" }] }
}

test fn word_lit_byte_identical_to_serialize_word_holds() -> Bool {
  word_emits_oracle(w: lit_git())
}

test fn word_lit_has_teeth_holds() -> Bool {
  emit_word_differs_from_oracle_of(w: lit_git(), other: Lit { text: "diff" })
}

test fn word_varref_byte_identical_to_serialize_word_holds() -> Bool {
  word_emits_oracle(w: varref_root())
}

test fn word_varref_has_teeth_holds() -> Bool {
  emit_word_differs_from_oracle_of(w: varref_root(), other: VarRef { name: "WORKDIR" })
}

test fn word_concat_byte_identical_to_serialize_word_holds() -> Bool {
  word_emits_oracle(w: concat_root_slash())
}

test fn word_concat_has_teeth_holds() -> Bool {
  emit_word_differs_from_oracle_of(
    w: concat_root_slash(),
    other: Concat { parts: [VarRef { name: "ROOT" }, Lit { text: "/release" }] }
  )
}

fn concat_two_lits() -> ShellWord {
  Concat { parts: [Lit { text: "a" }, Lit { text: "b" }] }
}

test fn dbg_oracle_concat_is_expected_holds() -> Bool {
  serialize_word(w: concat_root_slash()) == "\"$ROOT\"'/target'"
}

test fn dbg_concat_two_lits_oracle_holds() -> Bool {
  word_emits_oracle(w: concat_two_lits())
}

test fn dbg_concat_emits_expected_string_holds() -> Bool {
  word_emits_string(w: concat_root_slash(), expected: "\"$ROOT\"'/target'")
}

test fn dbg_concat_two_lits_emits_ab_holds() -> Bool {
  word_emits_string(w: concat_two_lits(), expected: "'a''b'")
}

test fn dbg_varref_standalone_emits_literal_holds() -> Bool {
  word_emits_string(w: VarRef { name: "ROOT" }, expected: "\"$ROOT\"")
}

test fn dbg_varref_standalone_oracle_is_literal_holds() -> Bool {
  serialize_word(w: VarRef { name: "ROOT" }) == "\"$ROOT\""
}

test fn dbg_concat_single_varref_holds() -> Bool {
  word_emits_string(w: Concat { parts: [VarRef { name: "ROOT" }] }, expected: "\"$ROOT\"")
}

test fn dbg_concat_lit_then_varref_holds() -> Bool {
  word_emits_string(w: Concat { parts: [Lit { text: "x" }, VarRef { name: "ROOT" }] }, expected: "'x'\"$ROOT\"")
}

test fn dbg_concat_single_lit_slash_holds() -> Bool {
  word_emits_string(w: Concat { parts: [Lit { text: "/target" }] }, expected: "'/target'")
}

fn emit_word_differs_from_oracle_of(w: ShellWord, other: ShellWord) -> Bool {
  match emit_shell_word(w: w) {
    Accepted { value: src, diagnostics: _ } => src.carried != serialize_word(w: other)
    Rejected { diagnostics: _ } => false
  }
}
