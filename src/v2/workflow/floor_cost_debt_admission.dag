module v2.workflow.floor_cost_debt_admission

import v2.std.collection { List }
import std.types { NonEmptyStr }

// TYPED ROSTER ADMISSION FOR THE ENROLMENT MARGIN: AN IDENTITY AND A REASON, NEVER A READING.
//
// WHAT THIS REPLACED, AND WHY AT THE ROOT (DESIGN §3, replacement migration; gunbc#11622 review
// 68363). A typed admission used to carry an authored `ClaimCostReading` that a constructor
// compared against the per-subject CPU line. Once the enrolment gate decides the Roster ground
// from THIS run's live reading (`v2.workflow.floor_enrolment_margin`
// `enrolment_declared_measured_standing`), a stored reading answers the same question a second
// time -- is this identity expensive enough to admit -- and the two can disagree: a stored 681
// says admit while a live 200 says stale. Nothing would say which wins. The stored figure also
// decided nothing any more while still being a number transcribed into source. So it is gone,
// with the constructor that judged it: the only cost that can justify an admission is the one the
// floor measures on the run it is judging, and an admission whose identity has become cheap goes
// stale and refuses, which forces its deletion.
//
// WHAT A ROW STILL CARRIES. The identity, and a reason that is the whole surviving justification:
// the diagnosis of why the witness is honestly expensive, and who owns it. The measurement that
// established it is cited by naming the run that produced it in the change that authors the row,
// never by copying its figures here.
//
// NAMED CONSUMER: `v2.workflow.floor_enrolment_margin` `enrolment_typed_cost_debt_identities`,
// decoded by the host `required_floor_runner` `floor_enrolment_typed_cost_debt_identities`.

type FloorCostDebtTypedAdmission {
  identity: String
  reason: NonEmptyStr
}

// THE APP ATTEST VERIFIER ROWS, kept under their own name when the interpreted-crypto rows beside
// them were deleted (gunbc#12306; review 71356 caught a first cut that deleted these two with them).
// They belong to gunbc.rung_drop app_attest_verifier_new_witness_eval_step_cost, which is still
// standing -- its identities are still interpreted test fns on the floor -- so they are admitted until
// THAT drop's own trigger retires them, and by nothing else (DESIGN section 4b(3)).
data app_attest_verifier_typed_admissions: List<FloorCostDebtTypedAdmission> = [
  FloorCostDebtTypedAdmission {
    identity: "test.claim.app_attest_verifier_witness_test.the_sample_passes_every_step_before_the_extension_steps",
    reason: "the one end-to-end inhabitance claim of the App Attest attestation path: Apple's real attestation object through decode_attestation (CBOR, two DER certificates, the PEM-pinned root, WebAuthn authenticator data) and the whole structural fold, with the SHA-256s steps 2-4 require, on a seed interpreter that reifies no machine width; its supplied-input siblings are kept off this list by construction, and this row is the real path they lean on (DESIGN section 3 pairing obligation); owner: the App Attest device-attestation lane, discharged by the natively emitted crypto closure that gunbc.auth.approval_device_redemption ecdsa_verification_realization_frontier names, the restoration trigger of gunbc.rung_drop app_attest_verifier_new_witness_eval_step_cost",
  },
  FloorCostDebtTypedAdmission {
    identity: "test.claim.app_attest_verifier_witness_test.the_nonce_step_reds_on_other_client_data",
    reason: "single-step irreducible: nonce_step alone over supplied inputs, whose whole cost is its own two interpreted SHA-256s (the client data, then authData concatenated with that hash); nothing before the step is paid; established by the enrolment-margin lines of the required floor's artifact required-ci-measurement-receipt on gunbc#11989, and re-derivable locally with claim_batch --hermetic --entry dag/test/claim/app_attest_verifier_witness_test.dag --functions <this claim>; owner: the App Attest device-attestation lane, discharged by the natively emitted crypto closure that gunbc.auth.approval_device_redemption ecdsa_verification_realization_frontier names, the restoration trigger of gunbc.rung_drop app_attest_verifier_new_witness_eval_step_cost",
  }
]

// THE MT. COLLINS STANDING-RULING DIGEST ROW (gunbc#12101, 2026-09-23), a separately bounded incident.
// Its one identity is the single inhabitance claim of the standing ruling's real digest route
// (standing_ruling_request -> standing_ruling_digest -> sha256_hex over the production ruling's
// canonical encoding); every other ruling claim supplies its digest (DESIGN section 3), so this one
// cannot. What the CPU pays is one interpreter-realized SHA-256 over that encoding. Its declared drop is
// gunbc.rung_drop.mtcollins1_standing_ruling_digest_new_witness_eval_step_cost, whose trigger names
// its own native route; the App Attest ECDSA route does not retire it. The measurement is the required
// floor run on gunbc#12101 that the drop's row cites, enrolment-margin line.
data mtcollins1_standing_ruling_digest_typed_admissions: List<FloorCostDebtTypedAdmission> = [
  FloorCostDebtTypedAdmission {
    identity: "test.claim.machine_intake.mtcollins1_standing_ruling_witness_test.the_production_ruling_digest_is_the_sha256_of_its_encoding_and_the_request_carries_it",
    reason: "the seed interpreter evaluates one SHA-256 over the production standing ruling's canonical encoding (about twenty-two blocks) as UInt32 word folds; it is the single inhabitance claim of the ruling-digest route, so the digest cannot be supplied; owner: the Mt. Collins boot lane, discharged by the natively emitted crypto closure" as NonEmptyStr,
  },
]

fn floor_cost_debt_typed_admissions() -> List<FloorCostDebtTypedAdmission> {
  concat(app_attest_verifier_typed_admissions, mtcollins1_standing_ruling_digest_typed_admissions)
}

fn floor_cost_debt_typed_admitted_identities() -> List<String> {
  reverse(fold(
    floor_cost_debt_typed_admissions(),
    init: [],
    f: fn(acc, row) { concat([row.identity], acc) },
  ))
}
