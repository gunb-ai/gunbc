      eval_steps: 804992,
    ),
    relaunch_capture_reading(
      name: "w_a_transport_delta_that_flipped_is_as_intended",
      cpu_ms: 1159,
      eval_steps: 807998,
    ),
    relaunch_capture_reading(
      name: "w_a_batching_only_relaunch_whose_transport_held_is_as_intended",
