      cpu_ms: 1308,
      eval_steps: 802862,
    ),
    relaunch_capture_reading(
      name: "w_the_successor_spec_differs_from_the_roce_incarnation_only_on_declared_axes",
      cpu_ms: 640,
      eval_steps: 423872,
    ),
    relaunch_capture_reading(
      name: "w_the_socket_incarnation_is_refused_against_the_successor_spec",
      cpu_ms: 596,
      eval_steps: 405451,
    ),
    relaunch_capture_reading(
      name: "w_the_three_incident_fields_differ_on_the_transport_axis",
      cpu_ms: 606,
      eval_steps: 406072,
    ),
    relaunch_capture_reading(
      name: "w_the_engine_argv_names_both_axes_it_moved_on",
      cpu_ms: 595,
      eval_steps: 405770,
    ),
    relaunch_capture_reading(
