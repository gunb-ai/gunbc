module v2.workflow.orchestration_while_emit


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data orch_while_unfreeze_note: String = "THIS FILE CAME BACK. It lived at exactly this path until gunbc#7098 (commit 5f1872bd159, 2026-07-23) renamed it to src/v2/test/claim/long/ under the title 'orch_while falsifier fast-lane relocation' — a pure rename, three lines added and one changed, the added lines being the note that justified the move. The note it carried claimed 'these three check_fns' own eval exceeds the operator's 5-second fast-lane budget' and cited gunbc_ci_fast_lane_rule_note. THE MEASUREMENT DOES NOT SUPPORT THAT CLAIM TODAY, and this row exists to say so with the numbers rather than to assert a correction. Executed 2026-08-05 via claim_batch over this file's four check_fns, on a host carrying load average 28: orch_while_locate_pipeline_matches_golden_holds 94ms, orch_while_step_matches_golden_holds 54ms, orch_while_raw_while_perturbation_changes_bytes_holds 36ms, orch_while_path_kind_discriminates_regular_directory_missing_holds 8ms — 192ms for all four together, against a FIVE THOUSAND millisecond PER-WITNESS budget. WHY THE CLOCK MISMATCH DOES NOT SPOIL THIS, stated because getting it backwards is easy and was gotten backwards elsewhere in this repo: those four figures are WALL (claim_batch reports them as witness_eval_wall_nanos and they sum to it), while gunbc_ci_fast_lane_witness_eval_budget is enforced on thread CPU, which excludes descheduled time. For a single witness thread cpu <= wall, so a wall figure BOUNDS the cpu figure ABOVE — a small wall proves a small cpu, and the load-28 host can only have inflated it. The margin is 53x on the slowest witness and every source of error runs the safe way. WHAT THAT DOES NOT ESTABLISH: not that the 2026-07-23 claim was false when it was made — no measurement from that day survives to compare against, the relocating commit recorded none, and this row will not invent one. It establishes only that the budget does not justify the exclusion NOW. THE MOVE COST MORE THAN DISCOVERY. src/v2/test is absent from realization_vocab_consumer_scan_roots, while src/v2/workflow/orchestration_ sits in realization_edge_path_prefixes — so this file, which imports the confined v2.extdeps.languages.bash vocabulary, was licensed to do so at its old path, and at the long/ path was simply not scanned. The relocation therefore removed it from per-PR execution AND from the realization-containment scan in one motion, and neither loss was stated. Coming back restores both. THE FREEZE SHRINKS BY ONE ENTRY (14 identities) — gunbc.witness_deferral_freeze's roster may only shrink against its diff baseline, and this is that direction, not an exemption. TEN OF THOSE FOURTEEN IDENTITIES WERE NEVER WITNESSES, and discovering that is what the return actually bought (CI run 31023883137, the first execution of this file in per-PR discovery). The file declared its fixtures — the PathIntent rows, the PathPredicate, the DirnameAscent, the two derived command Strings, the three PipelineStep intents — as `test data`, and `test data` does not mean 'a declaration belonging to a test'; it means A WITNESS WHOSE VALUE IS THE VERDICT, so discovery evaluated all ten and refused each one for returning PathIntent or PipelineStep or String rather than Bool. Every other `test data` row across every discovered src/v2/workflow/*_test.dag is Bool; these ten were the only exceptions in the corpus. They are plain `data` now, and the four real `test fn` witnesses — which PASSED in that same run — are the whole witness population. THE POINT IS NOT THE TYPO. Under path policy this file was never evaluated, so nothing could distinguish a fixture from a witness inside it, and the freeze row duly recorded fourteen 'identities' when four are witnesses and ten are values they consume. That is the frozen population's own accounting inflating the thing it counts, and it is the same defect at the roster grain that gunbc.witness_deferral_freeze's purpose-frontier note already admits at the row grain: these identities were admitted with no purpose, no cost and no consumer recorded, so nothing checked whether they were even the kind of thing a witness roster holds. A frozen row cannot be trusted as a count of deferred COVERAGE; it is a count of deferred NAMES. Any future migration out of that roster should expect the same discrepancy and re-derive the witness set by execution rather than by reading the row."

data orch_while_golden_note: String = "Goldens are hand-authored model-authority bytes independent of grammar row spellings; byte tests compare emit against these literals so carrier/lowering regressions cannot go green by perturbing both sides at once. THE SENTENCE THAT USED TO END THIS NOTE — 'the live ci_floor_peak workflow stays raw until the follow-up consumer PR' — IS RETIRED BECAUSE THAT PR LANDED (shell -> intent, this change). v2.workflow.ci_floor_peak_emit now carries ci_floor_peak_nearest_ancestor_spec and derives ci_floor_peak_while_cond_command / ci_floor_peak_while_body_command through bash_nearest_ancestor_locate_cond_command / bash_nearest_ancestor_locate_body_command — the same bash_path_predicate_target_model / bash_dirname_ascent_target_model lowering this file exercises, reached via the bundled NearestAncestorContaining spec rather than separate PathPredicate / DirnameAscent leaves. These goldens and the production emission are two readings of one authority. The goldens keep their independence anyway, and that is the point of leaving them hand-authored: if production and witness both derived their expected bytes from the lowering, a lowering regression would move both sides together and this file would stay green while emitting wrong shell (DESIGN section 5, the oracle rule). What production does NOT share with this file is the golden itself — nothing in ci_floor_peak_emit spells the loop's bytes any more."

data orch_while_locate_golden: String = "d=\"/sys/fs/cgroup$(awk -F: '$1==\"0\"\{print $3\}' /proc/self/cgroup)\"\nwhile [ -n \"$d\" ] && [ \"$d\" != \"/sys/fs/cgroup\" ] && ! [ -f \"$d/memory.peak\" ]; do d=$(dirname \"$d\"); done"

data orch_while_assign_cgroup_dir_command: String = "d=\"/sys/fs/cgroup$(awk -F: '$1==\"0\"\{print $3\}' /proc/self/cgroup)\""

data orch_while_path_ref: std.path_intent.PathIntent = PathRef { name: "d" as std.types.NonEmptyStr }

data orch_while_root_path: std.path_intent.PathIntent = std.path_intent.PathLiteral {
  parts: std.types.FilePathParts { segments: ["sys", "fs", "cgroup"] }
}

data orch_while_memory_peak_path: std.path_intent.PathIntent = std.path_intent.PathJoin {
  base: orch_while_path_ref,
  suffix: std.types.FilePathParts { segments: ["memory.peak"] }
}

data orch_while_predicate: std.path_intent.PathPredicate = std.path_intent.And {
  lhs: std.path_intent.PathNonempty { path: orch_while_path_ref },
  rhs: std.path_intent.And {
    lhs: std.path_intent.PathNotEq {
      lhs: orch_while_path_ref,
      rhs: orch_while_root_path
    },
    rhs: std.path_intent.Not {
      inner: std.path_intent.PathEntryKind {
        path: orch_while_memory_peak_path,
        kind: std.filesystem.types.RegularFile
      }
    }
  }
}

data orch_while_ascent: std.path_intent.DirnameAscent = std.path_intent.DirnameAscent {
  path: orch_while_path_ref,
  target: "d" as std.types.NonEmptyStr
}

fn orch_while_cond_model_text() -> String {
  match bash_path_predicate_target_model(predicate: orch_while_predicate) {
    Accepted { value: source, diagnostics: dg } =>
      match dg {
        None => source.authority_source_text
        Some { diagnostics: _ } => ""
      }
    Rejected { diagnostics: _ } => ""
  }
}

fn orch_while_body_model_text() -> String {
  match bash_dirname_ascent_target_model(ascent: orch_while_ascent) {
    Accepted { value: source, diagnostics: dg } =>
      match dg {
        None => source.authority_source_text
        Some { diagnostics: _ } => ""
      }
    Rejected { diagnostics: _ } => ""
  }
}

data orch_while_cond_command: String = orch_while_cond_model_text()

data orch_while_body_command: String = orch_while_body_model_text()

data orch_while_locate_intent: v2.std.orchestration.PipelineStep = While {
  cond: v2.std.orchestration.ExitZero {
    run: v2.std.orchestration.Run {
      command: orch_while_cond_command,
      env: [],
      redirect: Absent,
      capture: Absent
    }
  },
  body: v2.std.orchestration.Pipeline {
    steps: [
      Do {
        run: v2.std.orchestration.Run {
          command: orch_while_body_command,
          env: [],
          redirect: Absent,
          capture: Absent
        }
      }
    ],
    on_failure: FailFast
  }
}

data orch_while_locate_perturbed_intent: v2.std.orchestration.PipelineStep = While {
  cond: v2.std.orchestration.ExitZero {
    run: v2.std.orchestration.Run {
      command: concat(orch_while_cond_command, " # perturbed"),
      env: [],
      redirect: Absent,
      capture: Absent
    }
  },
  body: v2.std.orchestration.Pipeline {
    steps: [
      Do {
        run: v2.std.orchestration.Run {
          command: orch_while_body_command,
          env: [],
          redirect: Absent,
          capture: Absent
        }
      }
    ],
    on_failure: FailFast
  }
}

data orch_while_locate_body_perturbed_intent: v2.std.orchestration.PipelineStep = While {
  cond: v2.std.orchestration.ExitZero {
    run: v2.std.orchestration.Run {
      command: orch_while_cond_command,
      env: [],
      redirect: Absent,
      capture: Absent
    }
  },
  body: v2.std.orchestration.Pipeline {
    steps: [
      Do {
        run: v2.std.orchestration.Run {
          command: concat(orch_while_body_command, " # perturbed"),
          env: [],
          redirect: Absent,
          capture: Absent
        }
      }
    ],
    on_failure: FailFast
  }
}

test fn orch_while_locate_pipeline_matches_golden_holds() -> Bool {
  match orch_emit_pipeline(
    p: v2.std.orchestration.Pipeline {
      steps: [
        Do {
          run: v2.std.orchestration.Run {
            command: orch_while_assign_cgroup_dir_command,
            env: [],
            redirect: Absent,
            capture: Absent
          }
        },
        orch_while_locate_intent
      ],
      on_failure: FailFast
    },
    medium: bash_orchestration_emit_medium()
  ) {
    Accepted { value: source, diagnostics: dg } =>
      (source.carried == orch_while_locate_golden) && (dg == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_while_step_matches_golden_holds() -> Bool {
  match orch_emit_pipeline(
    p: v2.std.orchestration.Pipeline {
      steps: [
        Do {
          run: v2.std.orchestration.Run {
            command: orch_while_assign_cgroup_dir_command,
            env: [],
            redirect: Absent,
            capture: Absent
          }
        },
        orch_while_locate_intent
      ],
      on_failure: FailFast
    },
    medium: bash_orchestration_emit_medium()
  ) {
    Accepted { value: source, diagnostics: dg } =>
      (source.carried == orch_while_locate_golden) && (dg == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

data orch_while_raw_while_deferred_note: String = "Raw While construction refusal is deferred here: the current seam only proves emitted-bytes perturbation, because orch_emit_step routes While through the byte-emitting target model and does not expose a dedicated construction/lens refusal carrier yet. This witness only checks that changing the raw cond text changes the emitted bytes."

test fn orch_while_raw_while_perturbation_changes_bytes_holds() -> Bool {
  match orch_emit_step(
    s: While {
      cond: v2.std.orchestration.ExitZero {
        run: v2.std.orchestration.Run {
          command: concat(orch_while_cond_command, " # raw-while"),
          env: [],
          redirect: Absent,
          capture: Absent
        }
      },
      body: v2.std.orchestration.Pipeline {
        steps: [
          Do {
            run: v2.std.orchestration.Run {
              command: orch_while_body_command,
              env: [],
              redirect: Absent,
              capture: Absent
            }
          }
        ],
        on_failure: FailFast
      }
    },
    medium: bash_orchestration_emit_medium()
  ) {
    Accepted { value: source, diagnostics: _ } =>
      source.carried != orch_while_locate_golden
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_while_path_kind_discriminates_regular_directory_missing_holds() -> Bool {
  let regular = match bash_path_predicate_target_model(
    predicate: std.path_intent.PathEntryKind {
      path: orch_while_memory_peak_path,
      kind: RegularFile
    }
  ) {
    Accepted { value: source, diagnostics: _ } => source.authority_source_text
    Rejected { diagnostics: _ } => ""
  }
  let directory = match bash_path_predicate_target_model(
    predicate: std.path_intent.PathEntryKind {
      path: orch_while_memory_peak_path,
      kind: Directory
    }
  ) {
    Accepted { value: source, diagnostics: _ } => source.authority_source_text
    Rejected { diagnostics: _ } => ""
  }
  let missing = match bash_path_predicate_target_model(
    predicate: std.path_intent.PathEntryKind {
      path: orch_while_memory_peak_path,
      kind: Missing
    }
  ) {
    Accepted { value: source, diagnostics: _ } => source.authority_source_text
    Rejected { diagnostics: _ } => ""
  }
  (regular == "[ -f \"$d/memory.peak\" ]")
    && (directory == "[ -d \"$d/memory.peak\" ]")
    && (missing == "[ ! -e \"$d/memory.peak\" ]")
    && (regular != directory)
    && (regular != missing)
    && (directory != missing)
}
