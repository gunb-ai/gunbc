module v2.workflow.product_receipt

import std.content_hash {
  Fnv1a64Structural,
  content_hash_atom,
  content_hash_eq_structural
}
import std.types { NonEmptyStr }
import v2.std.algebra { fold_list, length }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }

// WHY THIS EXISTS.
//
// Every claim this repository makes about the v2 self-host wall is a claim
// about a COMPONENT measured on its own invocation: a manifest gate green
// here, an emission board coded there, a cargo error count somewhere else.
// The composition of those components has never been executed as one
// transaction, so nothing in the corpus can distinguish "each part works"
// from "the product builds". The incident that made this P0 is the same
// shape one layer up: a producer PR green on its own head, a consumer PR
// green on its own head, and the union red -- no per-part gate can catch
// that by construction.
//
// So this module models ONE receipt over the seven boundaries a product
// build crosses, and it carries the thing a per-part board cannot: the
// IDENTITY of the artifact each boundary handed the next. A receipt whose
// boundaries are individually Completed but whose artifacts do not chain is
// exactly the independent-green-components problem wearing a receipt's
// clothes, and it is REFUSED here rather than reported as green.

type ProductBoundary
  = HostDerivesManifest
  | ManifestPopulationAdmitted
  | RefsHashVerified
  | ClosureCandidateEmitted
  | SeedLinkedAssembly
  | AuthorityCargoManifest
  | CargoBuild

// The refusal vocabulary is CLOSED and it is not a Symbol, deliberately. A
// Symbol reason renders only through a host builtin, and a receipt whose
// causes cannot be projected without leaving the graph is a receipt nobody
// can read; a closed coproduct is total, renderable by match, and makes an
// unmodeled cause unwritable rather than spellable as free text.
type BoundaryRefusalCause
  = ManifestNotProduced
  | ManifestOverlayNotResolved
  | ManifestPopulationEmpty
  | ManifestCoverageIncomplete
  | ManifestPopulationPartial
  | PopulationDigestMismatch
  | ManifestSourceReadFailed
  | IngestRowShortfall
  | EmitterRejected { diagnostic_count: Int }
  | EmittedHardRefusalsPresent { count: Int }
  | AssemblyRefused
  | CargoManifestWriteFailed
  | CargoBuildFailed

type BoundaryStanding
  = BoundaryNotExercised
  | BoundaryRefused { cause: BoundaryRefusalCause }
  | BoundaryCompleted

type ArtifactIdentityAbsentCause
  = BoundaryNotReached
  | ProducerReportedNoArtifact

type ArtifactIdentity
  = ArtifactIdentityKnown { digest: Fnv1a64Structural }
  | ArtifactIdentityAbsent { cause: ArtifactIdentityAbsentCause }

type BoundaryObservation {
  boundary: ProductBoundary
  standing: BoundaryStanding
  consumed: ArtifactIdentity
  produced: ArtifactIdentity
}

// The subject travels WITH the receipt. A boundary standing means nothing
// without the entry it was measured on, and a reader who has to infer the
// subject from an absence will infer the wrong one.
type ProductReceipt {
  subject: String
  observations: List<BoundaryObservation>
}

fn product_boundary_ordinal(boundary: ProductBoundary) -> Int {
  match boundary {
    HostDerivesManifest => 1
    ManifestPopulationAdmitted => 2
    RefsHashVerified => 3
    ClosureCandidateEmitted => 4
    SeedLinkedAssembly => 5
    AuthorityCargoManifest => 6
    CargoBuild => 7
  }
}

fn product_boundary_label(boundary: ProductBoundary) -> String {
  match boundary {
    HostDerivesManifest => "B1 host derives manifest"
    ManifestPopulationAdmitted => "B2 manifest population admitted"
    RefsHashVerified => "B3 refs read and hash-verified"
    ClosureCandidateEmitted => "B4 closure candidate emitted"
    SeedLinkedAssembly => "B5 seed-linked assembly (no hand shim)"
    AuthorityCargoManifest => "B6 Cargo.toml from repository authority"
    CargoBuild => "B7 cargo"
  }
}

fn boundary_refusal_cause_label(cause: BoundaryRefusalCause) -> String {
  match cause {
    ManifestNotProduced => "manifest not produced"
    ManifestOverlayNotResolved => "the run resolved the committed stub, not the manifest this transaction produced"
    ManifestPopulationEmpty => "manifest population empty"
    ManifestCoverageIncomplete => "manifest coverage incomplete"
    ManifestPopulationPartial => "manifest population partial"
    PopulationDigestMismatch => "population digest mismatch"
    ManifestSourceReadFailed => "source read failed"
    IngestRowShortfall => "ingest row shortfall"
    EmitterRejected { diagnostic_count: count } =>
      concat("emitter rejected the admitted population, diagnostics: ", to_string(count))
    EmittedHardRefusalsPresent { count: count } =>
      concat("emitted hard refusals present: ", to_string(count))
    AssemblyRefused => "seed-linked assembly refused"
    CargoManifestWriteFailed => "authority Cargo manifest write failed"
    CargoBuildFailed => "cargo did not complete with zero errors"
  }
}

fn boundary_standing_label(standing: BoundaryStanding) -> String {
  match standing {
    BoundaryNotExercised => "NotExercised"
    BoundaryRefused { cause: cause } =>
      concat("Refused -- ", boundary_refusal_cause_label(cause: cause))
    BoundaryCompleted => "Completed"
  }
}

fn artifact_identity_label(identity: ArtifactIdentity) -> String {
  match identity {
    ArtifactIdentityKnown { digest: digest } =>
      concat("fnv1a64:", digest.digest)
    ArtifactIdentityAbsent { cause: cause } =>
      match cause {
        BoundaryNotReached => "<boundary not reached>"
        ProducerReportedNoArtifact => "<producer reported no artifact>"
      }
  }
}

fn product_artifact_identity(value: String) -> ArtifactIdentity {
  if value == "" {
    ArtifactIdentityAbsent { cause: ProducerReportedNoArtifact }
  } else {
    ArtifactIdentityKnown { digest: content_hash_atom(value: value as NonEmptyStr) }
  }
}

fn boundary_is_completed(observation: BoundaryObservation) -> Bool {
  match observation.standing {
    BoundaryCompleted => true
    BoundaryRefused { cause: _ } => false
    BoundaryNotExercised => false
  }
}

fn artifact_identity_carried(produced: ArtifactIdentity, consumed: ArtifactIdentity) -> Bool {
  match produced {
    ArtifactIdentityAbsent { cause: _ } => false
    ArtifactIdentityKnown { digest: left } =>
      match consumed {
        ArtifactIdentityAbsent { cause: _ } => false
        ArtifactIdentityKnown { digest: right } =>
          content_hash_eq_structural(left: left, right: right)
      }
  }
}

// The chain is folded, not asserted pairwise at call sites, so a receipt
// cannot be assembled that reports carriage it never checked. ChainBroken is
// absorbing on purpose: once one hand-off is unwitnessed the remainder of
// the chain proves nothing about the artifact the run started from.
type IdentityChainAcc
  = ChainStart
  | ChainHolding { prior_produced: ArtifactIdentity }
  | ChainBroken

fn identity_chain_step(
  acc: IdentityChainAcc,
  observation: BoundaryObservation
) -> IdentityChainAcc {
  match acc {
    ChainBroken => ChainBroken
    ChainStart => ChainHolding { prior_produced: observation.produced }
    ChainHolding { prior_produced: prior } =>
      if artifact_identity_carried(produced: prior, consumed: observation.consumed) {
        ChainHolding { prior_produced: observation.produced }
      } else {
        ChainBroken
      }
  }
}

fn product_receipt_identity_chain(receipt: ProductReceipt) -> IdentityChainAcc {
  fold_list(
    xs: receipt.observations,
    empty: ChainStart,
    cons: fn(acc, observation) {
      identity_chain_step(acc: acc, observation: observation)
    }
  )
}

fn product_receipt_identity_chain_intact(receipt: ProductReceipt) -> Bool {
  match product_receipt_identity_chain(receipt: receipt) {
    ChainBroken => false
    ChainStart => false
    ChainHolding { prior_produced: _ } => true
  }
}

// Coverage is checked by ORDINAL POSITION, not by count. Seven observations
// of one boundary satisfy a count and prove nothing; this refuses unless the
// receipt walks the seven boundaries once each, in order.
type BoundaryCoverageAcc
  = CoverageHolding { next_ordinal: Int }
  | CoverageBroken

fn boundary_coverage_step(
  acc: BoundaryCoverageAcc,
  observation: BoundaryObservation
) -> BoundaryCoverageAcc {
  match acc {
    CoverageBroken => CoverageBroken
    CoverageHolding { next_ordinal: expected } =>
      if product_boundary_ordinal(boundary: observation.boundary) == expected {
        CoverageHolding { next_ordinal: expected + 1 }
      } else {
        CoverageBroken
      }
  }
}

fn product_receipt_covers_every_boundary_once(receipt: ProductReceipt) -> Bool {
  match fold_list(
    xs: receipt.observations,
    empty: CoverageHolding { next_ordinal: 1 },
    cons: fn(acc, observation) {
      boundary_coverage_step(acc: acc, observation: observation)
    }
  ) {
    CoverageBroken => false
    CoverageHolding { next_ordinal: next } => next == 8
  }
}

fn product_receipt_every_boundary_completed(receipt: ProductReceipt) -> Bool {
  fold_list(
    xs: receipt.observations,
    empty: true,
    cons: fn(ok, observation) { ok && boundary_is_completed(observation: observation) }
  )
}

// THE GREEN PREDICATE. Three conjuncts, and the third is the one a
// per-component board cannot state: every boundary consumed the exact
// artifact its predecessor produced, inside one transaction.
fn product_receipt_green(receipt: ProductReceipt) -> Bool {
  product_receipt_covers_every_boundary_once(receipt: receipt)
    && product_receipt_every_boundary_completed(receipt: receipt)
    && product_receipt_identity_chain_intact(receipt: receipt)
}

fn boundary_observation_line(observation: BoundaryObservation) -> String {
  concat(
    product_boundary_label(boundary: observation.boundary),
    concat(
      "\n  standing: ",
      concat(
        boundary_standing_label(standing: observation.standing),
        concat(
          "\n  consumed: ",
          concat(
            artifact_identity_label(identity: observation.consumed),
            concat(
              "\n  produced: ",
              concat(artifact_identity_label(identity: observation.produced), "\n")
            )
          )
        )
      )
    )
  )
}

fn product_receipt_render(receipt: ProductReceipt) -> String {
  concat(
    concat(
      "v2 compiler product receipt (seven boundaries, one transaction)\nsubject: ",
      concat(receipt.subject, "\n\n")
    ),
    concat(
      fold_list(
        xs: receipt.observations,
        empty: "",
        cons: fn(text, observation) {
          concat(text, boundary_observation_line(observation: observation))
        }
      ),
      concat(
        "\ncovers every boundary once: ",
        concat(
          bool_to_string(b: product_receipt_covers_every_boundary_once(receipt: receipt)),
          concat(
            "\nevery boundary completed:  ",
            concat(
              bool_to_string(b: product_receipt_every_boundary_completed(receipt: receipt)),
              concat(
                "\nidentity chain intact:     ",
                concat(
                  bool_to_string(b: product_receipt_identity_chain_intact(receipt: receipt)),
                  concat(
                    "\nRECEIPT: ",
                    concat(
                      if product_receipt_green(receipt: receipt) { "GREEN" } else { "RED" },
                      "\n"
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
}

fn bool_to_string(b: Bool) -> String {
  if b { "true" } else { "false" }
}
