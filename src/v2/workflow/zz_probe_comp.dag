module v2.workflow.zz_probe_comp

import std.process { ProcessExit, exit_failure }
import std.algebra { Cons, Empty, length, fold_list }
import std.types { String, List }
import v2.compiler.program_assembly { dag_prepared_grammar, dag_prepared_lex }
import v2.std.diagnostic { Accepted, Rejected }
import v2.workflow.roster_import_sweep { roster_head_rows, roster_rename_companions, RosterHeadRow, CompanionDerived, CompanionUnderivable, CompanionNone }

fn zz_probe_comp() -> ProcessExit {
  match dag_prepared_grammar() {
    Rejected { diagnostics: _ } => exit_failure(reason: "grammar")
    Accepted { value: prepared, diagnostics: _ } =>
      match roster_rename_companions(rows: roster_head_rows(), prepared: prepared, lex: dag_prepared_lex()) {
        Empty => exit_failure(reason: "NONE")
        Cons { head: h, tail: _ } =>
          match h {
            CompanionDerived { call: _, to: _, module: m, tags: _, closure: _ } => exit_failure(reason: "DERIVED " + m)
            CompanionUnderivable { call: _, to: _, detail: d } => exit_failure(reason: "UNDERIVABLE " + d)
            CompanionNone => exit_failure(reason: "NONE-COMP")
          }
      }
  }
}
