module v2.workflow.ci_release_build_emit



// Release-build shell emission (retry + verify) lives here, separate from ci_workflow_run_emit, so gunbc.ci_materialization can import ci_release_build_script without a module cycle (ci_materialization ↔ ci_workflow_run_emit via ci_sccache_provider_shell_injection).
data ci_release_build_shell_emit_scaffold: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "v2.workflow.ci_release_build_emit",
    decl_name: "ci_release_build_script",
    field: std.decl_ref.WholeDeclaration
  }
}

data ci_release_build_shell_emit_dissolution_trigger: std.dissolution.DissolutionCondition = std.dissolution.unbound_dissolution(description: "🟡 dissolve-on: ci_release_build_script — concat-built foreign-executor (GitHub Actions run:) release-build runner (ROOT stamp + verify-artifacts + sccache stats wrapping the orch-emitted EAGAIN retry core); membership of --bin / verify paths is derived from gunbc.ci_release_bins, but the runner transport itself remains hand-shell; DISSOLVES WHEN bash-emit (#5828 / ROADMAP 6-shell-slice0 / shell→intent Phase 2) realizes the release-build runner through orchestration emit or typed host_effect_apply without a medium-as-string concat scaffold")

fn ci_release_build_script() -> String {
  concat(
    concat("# ", concat(std.dissolution.dissolution_description(condition: ci_release_build_shell_emit_dissolution_trigger), "\n")),
    concat(
      concat("ROOT=", gunbc.merge_admission_produce.ci_repo_root_shell(), "\n"),
      concat(
        ci_cargo_eagain_retry_script(command: gunbc.ci_spec.ci_release_build_line()),
        concat(
          gunbc.ci_spec.ci_floor_build_verify_script(),
          "sccache --show-stats 2>/dev/null || true"
        )
      )
    )
  )
}

fn gunbc_ci_run_script(spec: gunbc.ci_spec.CiSpec) -> String {
  concat(concat(ci_release_build_script(), "\n"), gunbc.ci_spec.gunbc_ci_floor_only_script(spec: spec))
}
