module v2.workflow.legacy_binding_delta

import std.types { String, Bool, Int, List }
import std.content_hash { Fnv1a64Structural }
import std.occurrence_identity { OccurrenceId }
import v2.workflow.legacy_binding_observation {
  LegacyBindingObservation,
  LegacyBindingObservationSubject,
  SubjectOccurrenceRef,
  observed_occurrence_ids,
  legacy_subject_identity
}

// THE CORRESPONDENCE IS THE PROJECTOR'S OUTPUT, NOT A JOIN KEY. THIS MODULE CONSUMES IT AND
// REFUSES TO RECONSTRUCT IT.
//
// The delta between what the legacy resolver X selected over base B and what the strict resolver Y
// selects over the projection P(B) is a comparison BETWEEN TWO COMPILES, and there is no admissible
// key for one. std.occurrence_identity's scope law forbids filename, SourceSpan, authored name,
// structural Node equality, content hash and module-local allocator reset as identity inputs, and
// OccurrenceId is not a stable cross-compile name either -- alloc_occurrence_id is a monotone
// counter consumed in DFS order, so an id ENCODES POSITION IN THE WALK. P(B) differs from B by
// INSERTED QUALIFIER TOKENS, which is precisely the edit that shifts every id allocated after it.
//
// SO THE DICHOTOMY IS CLOSED, NOT MERELY UNSOLVED. Every property computable from a finished tree
// in isolation is positional or content-derived; the law names both classes; and a cross-compile
// key must by definition be computed from each tree separately and then joined. What escapes is
// not a better key -- it is a relation the TRANSFORMATION EMITS, because a function knows which
// output came from which input. That is a fact the projector had in hand, not an inference about
// the trees.
//
// THE TRAP THIS MODULE EXISTS TO NOT FALL INTO, recorded because it is the natural first idea:
// threading one allocator across both parses. It is roughly one line and it is what the scope law
// says a production source graph does. IT ESTABLISHES NOTHING. B's occurrence and its P(B)
// counterpart still get different ordinals; what the shared allocator buys is that they are
// GUARANTEED-DISTINCT rather than ACCIDENTALLY-EQUAL, so a correspondence keyed on it goes from
// noisily wrong to silently and totally wrong. Worse, it makes the ordinal look MORE trustworthy:
// globally unique, totally ordered, reproducible run to run -- everything a reader checks comes
// back clean, and the one property it lacks is the only one anyone wanted.
//
// THE GENERAL TELL, which is the absorbing fallback one level up: IF YOUR JOIN ALWAYS CLOSES, IT
// IS NOT A JOIN. A correspondence that cannot fail has its deficit frequency zeroed by
// construction, so it never ranks for repair, and it gets cited as coverage.

// AND NOTHING HERE MAY READ AN ORDINAL AS AN ORDER, WHICH IS A SEPARATE PROHIBITION FROM THE ONE
// ABOVE AND ARRIVES FROM THE OTHER END OF THE SAME FACT.
//
// The prohibition above is about comparing ordinals ACROSS compiles. This one is about reading them
// as a SEQUENCE WITHIN one. Once identity is minted at parser construction rather than by a later
// traversal, children are often constructed before their parents, so a parent's ordinal may be
// numerically GREATER than its child's -- and adding an unrelated earlier construction renumbers
// later ids without changing a single binding, closure, diagnostic or emitted byte.
//
// So no law in this module sorts, ranges over, or compares the magnitude of an occurrence ordinal.
// Every one of them is set membership or multiplicity, both of which are order-free by
// construction, and containment is the explicit ancestor relation rather than an inequality between
// ids. Stated here rather than left implicit because the tempting use is exactly the plausible one:
// a projector comparing two projections would naturally want a stable traversal order, and the
// ordinals look like one.

// A PROJECTION PAIR RELATES ONE TARGET OCCURRENCE TO ITS SOURCE, AND THE ABSENT SOURCE IS A
// FIRST-CLASS ARM RATHER THAN AN EXCEPTION.
//
// A projection that inserts qualifier tokens produces target occurrences with no source. That is
// the projector DOING ITS JOB, not a gap in its provenance, and a schema requiring every target to
// carry a source would refuse P(B) for succeeding -- the not-applicable-rendered-as-malformed
// shape. So insertion is its own constructor, and a reader can tell "this target came from
// nowhere, by design" from "this target's source is missing", which have opposite owners.
// AN INSERTED SEGMENT CARRIES ITS CAUSE RATHER THAN BEING SOURCELESS, and the difference is not
// cosmetic. "No source" and "caused by the reference being qualified" have the same first-class
// status but not the same information: the first leaves a reader concluding that inserted syntax is
// unattributable, and the second names the occurrence on whose behalf the segment exists. A
// projection that inserts a qualifier is acting FOR some reference, and it knows which.
type ProjectionProvenanceEntry
  = ProjectedFromSource { source: SubjectOccurrenceRef, target: SubjectOccurrenceRef }
  | ProjectedAsInsertion { target: SubjectOccurrenceRef, caused_by: SubjectOccurrenceRef }

type ProjectionProvenance {
  entries: List<ProjectionProvenanceEntry>
}

fn provenance_source_refs(provenance: ProjectionProvenance) -> List<SubjectOccurrenceRef> {
  provenance.entries |> flat_map(entry => match entry {
    ProjectedFromSource { source: s, target: _ } => [s]
    ProjectedAsInsertion { target: _, caused_by: c } => [c]
  })
}

fn provenance_target_refs(provenance: ProjectionProvenance) -> List<SubjectOccurrenceRef> {
  provenance.entries |> map(entry => match entry {
    ProjectedFromSource { source: _, target: t } => t
    ProjectedAsInsertion { target: t, caused_by: _ } => t
  })
}

// AN INSERTION'S CAUSE IS A BASE-SIDE REFERENCE AND IS THEREFORE A SOURCE FOR SCOPE PURPOSES, which
// is why provenance_source_refs collects it -- but it is NOT a carried-forward source, so counting
// it toward the one-source-per-base-occurrence law would make qualifying a reference look like a
// fork. The two questions are separated: scope membership reads every base-side ref, multiplicity
// reads only the carried-forward ones.
fn provenance_carried_source_ids(provenance: ProjectionProvenance) -> List<Int> {
  provenance.entries |> flat_map(entry => match entry {
    ProjectedFromSource { source: s, target: _ } => [s.occurrence.value]
    ProjectedAsInsertion { target: _, caused_by: _ } => []
  })
}

fn refs_in_scope(refs: List<SubjectOccurrenceRef>, identity: Fnv1a64Structural) -> List<Int> {
  refs |> filter(r => r.subject_identity.digest == identity.digest) |> map(r => r.occurrence.value)
}

fn refs_out_of_scope(refs: List<SubjectOccurrenceRef>, identity: Fnv1a64Structural) -> List<Int> {
  refs |> filter(r => r.subject_identity.digest != identity.digest) |> map(r => r.occurrence.value)
}

// PROVENANCE TOTALITY IS SIX LAWS, AND EACH ONE FAILS A DIFFERENT LIE.
//
// EVERY LAW NAMES ITS DENOMINATOR BESIDE IT, AND THAT DISCIPLINE IS THE RESIDUE OF THREE REVIEW
// FINDINGS RATHER THAN A PREFERENCE. Three defects in two modules had one shape: the prose stated
// the law correctly and the filter ran it over the wrong set. Membership checked without
// cardinality (a repeated observed occurrence read as complete); presence checked over a population
// wider than its subject (an insertion's caused_by discharging a dropped occurrence's obligation);
// and totality checked without target cardinality. Each passed every arm that existed. So the laws
// below state WHICH SET and WHICH MULTIPLICITY explicitly:
//
//   scope          -- every ref, both sides, against its own subject's address
//   source missing -- base denominator against CARRIED sources only
//   source repeat  -- base denominator against CARRIED sources, multiplicity
//   target missing -- projected denominator against ALL targets
//   target repeat  -- projected denominator against ALL targets, multiplicity
//   foreign        -- in-scope refs, both sides, against their denominators
//
// THE CARRIED-VERSUS-ALL SPLIT IS THE ONE THAT BIT. A caused_by is evidence that an insertion acts
// ON BEHALF OF a reference; it is NOT evidence that the reference survived the projection. Reading
// it as coverage lets a dropped base occurrence read as a complete correspondence, which is the
// exact lie the source-missing law exists to catch. It still counts for SCOPE, because a cause is a
// base-side ref and must have been minted in the base's allocator domain.
//
// A source left out means the projection dropped an occurrence the base carried -- a site the
// migration silently declined to consider. A carried source appearing twice means one base
// occurrence was projected to two targets, which is a fork the delta cannot interpret. A target
// left out means the projection produced something it will not account for. A ref scoped to
// NEITHER subject means the provenance is about some other pair of compiles entirely, and that is
// the failure that reads as success -- exactly the count-equality trap, since such a provenance can
// have the right size.
//
// THE SCOPE LAW IS WHAT MAKES AN INDEXABLE RELATION SOUND. An ordinal names an occurrence only
// inside the allocator that minted it, so a ref carries the subject whose allocator that was, and
// a ref bearing the wrong subject address is refused rather than silently looked up in the wrong
// domain. Without it the accidental equality of two independently-allocated ordinals would be
// indistinguishable from a real correspondence -- the shared-allocator trap arriving through the
// index instead of through the key.
//
// NOTE WHAT IS NOT A LAW: a target that is an insertion is admitted, because insertion is the
// point. The asymmetry between the source and target laws is deliberate and is the one place a
// reader should expect the two directions NOT to mirror each other.
type ProvenanceTotality
  = ProvenanceTotal
  | ProvenanceSourceMissing { occurrences: List<Int> }
  | ProvenanceSourceRepeated { occurrences: List<Int> }
  | ProvenanceTargetMissing { occurrences: List<Int> }
  | ProvenanceForeignOccurrence { occurrences: List<Int> }
  | ProvenanceTargetRepeated { occurrences: List<Int> }
  | ProvenanceRefOutOfSubjectScope { occurrences: List<Int> }

fn occurrence_multiplicity(ids: List<Int>, id: Int) -> Int {
  ids |> filter(other => other == id) |> count
}

// THE DENOMINATORS ARE THE OBSERVATIONS' OWN ROW KEYS, AND THAT IS A DEPENDENCY ON COMPLETENESS
// RATHER THAN AN ASSUMPTION ABOUT IT. legacy_observation_completeness is what ties a set of row
// keys to the expected reference-occurrence population of its subject; this function then relates
// two such populations. Taking the transports again here would re-derive a fact the observation
// already carries and let the two derivations disagree -- so the ordering obligation is stated
// instead: a delta over observations whose completeness has not been established is a comparison
// between two unvalidated populations, and it is the caller's to sequence.
fn provenance_totality<O, P>(
  base_observation: LegacyBindingObservation<O>,
  projected_observation: LegacyBindingObservation<P>,
  provenance: ProjectionProvenance
) -> ProvenanceTotality {
  let base_identity = legacy_subject_identity(subject: base_observation.subject)
  let projected_identity = legacy_subject_identity(subject: projected_observation.subject)
  let base_ids = observed_occurrence_ids(observation: base_observation)
  let projected_ids = observed_occurrence_ids(observation: projected_observation)
  let source_refs = provenance_source_refs(provenance: provenance)
  let target_refs = provenance_target_refs(provenance: provenance)
  let out_of_scope = concat(
    refs_out_of_scope(refs: source_refs, identity: base_identity),
    refs_out_of_scope(refs: target_refs, identity: projected_identity)
  )
  let sources = refs_in_scope(refs: source_refs, identity: base_identity)
  let targets = refs_in_scope(refs: target_refs, identity: projected_identity)
  let carried = provenance_carried_source_ids(provenance: provenance)
  let source_missing = base_ids |> filter(id => !(carried |> any(s => s == id)))
  let source_repeated = base_ids |> filter(id => occurrence_multiplicity(ids: carried, id: id) > 1)
  let target_missing = projected_ids |> filter(id => !(targets |> any(t => t == id)))
  let target_repeated = projected_ids |> filter(id => occurrence_multiplicity(ids: targets, id: id) > 1)
  let foreign_sources = sources |> filter(id => !(base_ids |> any(b => b == id)))
  let foreign_targets = targets |> filter(id => !(projected_ids |> any(p => p == id)))
  let foreign = concat(foreign_sources, foreign_targets)
  if (out_of_scope |> count) > 0 { ProvenanceRefOutOfSubjectScope { occurrences: out_of_scope } }
  else if (source_missing |> count) > 0 { ProvenanceSourceMissing { occurrences: source_missing } }
  else if (source_repeated |> count) > 0 { ProvenanceSourceRepeated { occurrences: source_repeated } }
  else if (target_missing |> count) > 0 { ProvenanceTargetMissing { occurrences: target_missing } }
  else if (target_repeated |> count) > 0 { ProvenanceTargetRepeated { occurrences: target_repeated } }
  else if (foreign |> count) > 0 { ProvenanceForeignOccurrence { occurrences: foreign } }
  else { ProvenanceTotal }
}

// THE DELTA TAKES THREE INPUTS AND NO KEY, AND REFUSES BEFORE IT COMPARES.
//
// Its verdict vocabulary keeps two failures apart that a single arm would conflate: a provenance
// that does not account for both denominators, and a genuine disagreement between what X selected
// and what Y selects. The first says the comparison could not be made; the second says it was made
// and diverged. Rendering them alike would let an unmade comparison read as agreement, which is
// the execution-provenance failure at this artifact's own surface.
// THE ADMITTING ARM IS NAMED FOR WHAT IT HOLDS, NOT FOR WHAT A READER WILL WANT IT TO HOLD. It was
// DeltaComputed, and it returns its input verbatim -- nothing here compares X's outcomes against
// Y's, and nothing in this slice can. The name promised a comparison the module deliberately does
// not make, which is a name covering a superset of its own population. CorrespondenceAdmitted says
// the correspondence is total and admissible, which is exactly the fact established.
type LegacyBindingDelta
  = DeltaProvenanceRefused { totality: ProvenanceTotality }
  | CorrespondenceAdmitted { pairs: List<ProjectionProvenanceEntry> }

fn legacy_binding_delta<O, P>(
  base_observation: LegacyBindingObservation<O>,
  projected_observation: LegacyBindingObservation<P>,
  provenance: ProjectionProvenance
) -> LegacyBindingDelta {
  match provenance_totality(
    base_observation: base_observation,
    projected_observation: projected_observation,
    provenance: provenance
  ) {
    ProvenanceTotal => CorrespondenceAdmitted { pairs: provenance.entries }
    ProvenanceSourceMissing { occurrences: o } => DeltaProvenanceRefused { totality: ProvenanceSourceMissing { occurrences: o } }
    ProvenanceSourceRepeated { occurrences: o } => DeltaProvenanceRefused { totality: ProvenanceSourceRepeated { occurrences: o } }
    ProvenanceTargetMissing { occurrences: o } => DeltaProvenanceRefused { totality: ProvenanceTargetMissing { occurrences: o } }
    ProvenanceForeignOccurrence { occurrences: o } => DeltaProvenanceRefused { totality: ProvenanceForeignOccurrence { occurrences: o } }
    ProvenanceTargetRepeated { occurrences: o } => DeltaProvenanceRefused { totality: ProvenanceTargetRepeated { occurrences: o } }
    ProvenanceRefOutOfSubjectScope { occurrences: o } => DeltaProvenanceRefused { totality: ProvenanceRefOutOfSubjectScope { occurrences: o } }
  }
}
