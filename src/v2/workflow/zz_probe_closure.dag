module v2.workflow.zz_probe_closure

import std.process { ProcessExit, exit_failure }
import std.algebra { Cons, Empty, length }
import std.integer { int_to_decimal_string }
import v2.workflow.roster_import_sweep { roster_homes_closures_read, roster_repository_bindings, RosterClosureRead, RosterClosureUnread }

fn zz_probe_closure() -> ProcessExit {
  match roster_homes_closures_read(homes: ["std.integer"], bindings: roster_repository_bindings(root: "")) {
    Empty => exit_failure(reason: "NONE")
    Cons { head: h, tail: _ } =>
      match h {
        RosterClosureRead { home: _, modules: ms } => exit_failure(reason: "MODULES=" + int_to_decimal_string(value: length(xs: ms)))
        RosterClosureUnread { home: _ } => exit_failure(reason: "UNREAD")
      }
  }
}
