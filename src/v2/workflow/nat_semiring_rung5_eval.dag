module v2.test.workflow.nat_semiring_rung5_eval


fn run_nat_semiring_rung5_eval() -> CorpusEvalReport {
  CorpusEvalReport {
    entries: corpus_entries_from_node_runtime_value_runs(
      runs: phase1_nat_semiring_rung5_full_law_roster_runtime_value_rows
    )
  }
}

fn nat_semiring_rung5_report_has_evidence(report: CorpusEvalReport) -> Bool {
  match is_empty(xs: report.entries) {
    true => false
    false => true
  }
}

fn nat_semiring_rung5_gate(report: CorpusEvalReport) -> Bool {
  if nat_semiring_rung5_report_has_evidence(report: report) {
    let tally = corpus_report_tally(r: report)
    tally.fail == Zero && tally.deferred == Zero
  } else {
    false
  }
}
