module v2.test.workflow.lens_unused_parameters_family_eval


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn lens_unused_parameters_family_gate() -> Bool {
  unused_parameters_binds_to_edge_claim_passes
    && unused_parameters_non_use_edges_claim_passes
    && unused_parameters_rollup_claim_passes
}

test data witness_lens_unused_parameters_family_gate_closed: Bool = lens_unused_parameters_family_gate()
