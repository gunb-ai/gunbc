fn floor_route_gap_chunks() -> List<List<String>> {
  Cons { head: floor_route_gap_chunk_00(), tail: Cons { head: floor_route_gap_chunk_01(), tail: Cons { head: floor_route_gap_chunk_02(), tail: Cons { head: floor_route_gap_chunk_03(), tail: Cons { head: floor_route_gap_chunk_04(), tail: Cons { head: floor_route_gap_chunk_05(), tail: Cons { head: floor_route_gap_chunk_06(), tail: Cons { head: floor_route_gap_chunk_07(), tail: Empty {} } } } } } } } }
}

fn floor_route_gap_roster() -> List<String> {
  list_flat_map(xs: floor_route_gap_chunks(), f: fn(chunk) { chunk })
}
