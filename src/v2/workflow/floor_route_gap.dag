      head: "test.claim.repository_convergence_wet_witness_test.already_at_candidate_repairs_a_stale_index",
      tail: Cons {
      head: "test.claim.repository_convergence_wet_witness_test.cas_race_is_observed_after_fetch",
      tail: Cons {
      head: "test.claim.repository_convergence_wet_witness_test.detached_primary_transition_executes_and_preserves_packed_loose_refs_and_linked_worktree",
      tail: Cons {
      head: "test.claim.repository_convergence_wet_witness_test.reset_refusal_after_successful_cas_is_nonzero",
      tail: Cons {
      head: "test.claim.repository_convergence_wet_witness_test.undecodable_worktree_roster_refuses_before_mutation",
      tail: Cons {
      head: "test.claim.repository_convergence_wet_witness_test.unreadable_head_refuses_before_fetch_or_mutation",
      tail: Cons {
      head: "test.claim.repository_convergence_wet_witness_test.wrong_primary_standing_refuses_from_gits_roster",
      tail: Empty {} } } } } } } }
}

fn floor_route_gap_chunks() -> List<List<String>> {
  Cons { head: floor_route_gap_chunk_00(), tail: Cons { head: floor_route_gap_chunk_01(), tail: Cons { head: floor_route_gap_chunk_02(), tail: Cons { head: floor_route_gap_chunk_03(), tail: Cons { head: floor_route_gap_chunk_04(), tail: Cons { head: floor_route_gap_chunk_05(), tail: Empty {} } } } } } }
}

fn floor_route_gap_roster() -> List<String> {
  let legacy = list_flat_map(xs: floor_route_gap_chunks(), f: fn(chunk) { chunk })
  let located = floor_route_gap_expectations() |> map(row => row.identity)
  list_flat_map(xs: [legacy, located], f: fn(chunk) { chunk })
}
