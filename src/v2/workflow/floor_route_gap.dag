    head: FloorRouteGapExpectation { identity: "test.claim.contract_identity.required_ci_epoch_real_execution_witness.a_run_of_the_contract_at_another_epoch_refuses_naming_both_epochs_by_real_execution", operation: "Dir", ground: NoMockResponse {} },
    tail: Cons {
