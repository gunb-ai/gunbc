module v2.workflow.realization_sweep

import v2.std.node { symbol_intern_lexeme, symbol_lexeme }
import v2.workflow.realization_attempt {
  EntryRealizationAttempt,
  RealizationAttemptStanding,
  V2TranslateSerialized,
  V2RealizationRefused,
  attempt_closure_rows,
  attempt_phase_label,
  entry_witness_source
}
import v2.compiler.name_resolve { Admission }
import gunbc.explicit_witness_admission { explicit_witness_admissions }
import gunbc.ci.ci_layer_roots { falsifier_substrate_long_lane_rows }
import v2.compiler.source_authority { SourceRootIngest }
import std.integer { int_to_decimal_string }
import std.optional { Optional, Present, Absent }
import v2.std.algebra { fold_list, length }
import v2.std.collection { list_at_optional }
import std.types { Int, List, String }

// CI2-0 Commit B sweep (operator mandate 2026-08-08, convergence mandate 2026-08-09): the
// machine-derived census replacing the circular one — for each roster entry, the entry's
// import closure (supplied by the caller as a SourceRootIngest -- the one acquirer,
// v2.compiler.module_acquisition, is the closure authority, never a .dag-side re-discovery forking it)
// is driven through attempt_closure_rows: ONE canonical
// assembly per entry, one attempt per required test-fn identity, a typed standing per identity,
// exactly once. The receipt is a phase-and-cause histogram whose laws are structural (row count
// equals identity count; every row typed), never tree-copied literals. Identity source: the entry's
// test declarations, which are the declarations carrying the authored `test` marker — a SUPPLIED
// fact (the entry's marked names), never a scan of its source text — interned to the resolved
// declaration name the exactly-one join consumes.

type RealizationSweepRow {
  entry: String
  function: String
  phase_label: String
  cause: String
  located: String
}

fn no_name_strings() -> List<String> {
  []
}

// Roster authority correction (operator verdict, msg_6305b900): identities come from the CANONICAL
// enrolled population -- the entry's marked test declarations, the same fact the floor's discovery
// enrols from -- never a source-text line scan, which would be a second census beside the execution
// roster (the class the circular census died of). The marker fact is a supplied value: this module
// neither parses nor walks the entry's directory, so a sibling file can neither contribute an
// identity nor refuse the sweep.

fn identity_snoc_unique(acc: List<String>, f: String) -> List<String> {
  if fold_list(xs: acc, empty: false, cons: fn(found, x) { found || (x == f) }) {
    acc
  } else {
    concat(acc, [f])
  }
}

// The canonical enrolled population per entry is the UNION of the cadences that execute it: the
// entry's marked test declarations (the source of the per-PR discovery roster, whose corpus-mode row
// admission deliberately excludes exactly-admitted rows from ITS cadence), plus the exact-admission
// roster (gunbc.explicit_witness_admission), plus the substrate long-lane rows (ci_layer_roots) --
// each an enrolled executing consumer. Discovery exclusion is a CADENCE fact, not an enrollment
// fact; deriving the population from discovery's admitted rows alone would silently drop every
// long-lane witness.

fn entry_canonical_identities(entry: String, marked: List<String>) -> List<String> {
  let discovered = fold_list(xs: marked, empty: no_name_strings(), cons: fn(acc, name) {
    identity_snoc_unique(acc: acc, f: name)
  })
  let with_admitted = fold_list(xs: explicit_witness_admissions, empty: discovered, cons: fn(acc, a) {
    if a.witness.entry == entry {
      identity_snoc_unique(acc: acc, f: a.witness.function)
    } else {
      acc
    }
  })
  fold_list(xs: falsifier_substrate_long_lane_rows, empty: with_admitted, cons: fn(acc, row) {
    if row.entry == entry {
      identity_snoc_unique(acc: acc, f: row.function)
    } else {
      acc
    }
  })
}

fn no_fn_symbols() -> List<Symbol> {
  []
}

fn sweep_row_located(a: EntryRealizationAttempt) -> String {
  match a.standing {
    V2TranslateSerialized { emitted_nonempty: _ } => ""
    V2RealizationRefused { phase: _, exact_cause: _, located: l } => l
  }
}

fn sweep_row_cause(a: EntryRealizationAttempt) -> String {
  match a.standing {
    V2TranslateSerialized { emitted_nonempty: _ } => ""
    V2RealizationRefused { phase: _, exact_cause: c, located: _ } => symbol_lexeme(sym: c)
  }
}

fn sweep_rows(ingest: SourceRootIngest, admission: Admission, entry: String, marked: List<String>) -> List<RealizationSweepRow> {
  sweep_rows_with_identities(
    ingest: ingest,
    admission: admission,
    entry: entry,
    identities: entry_canonical_identities(entry: entry, marked: marked)
  )
}

fn sweep_rows_with_identities(ingest: SourceRootIngest, admission: Admission, entry: String, identities: List<String>) -> List<RealizationSweepRow> {
  match entry_witness_source(ingest: ingest, entry: entry) {
    Absent =>
      [RealizationSweepRow {
        entry: entry,
        function: "",
        phase_label: "read",
        cause: "realization_sweep_entry_witness_absent",
        located: entry
      }]
    Present { value: _entry_source } => {
      let names = identities
      if length(xs: names) == 0 {
        fold_list(
          xs: attempt_closure_rows(
            ingest: ingest,
            admission: admission,
            fn_names: [^zz_member_scan],
            entry: entry
          ),
          empty: no_sweep_rows(),
          cons: fn(acc, a) {
            concat(acc, [RealizationSweepRow {
              entry: entry,
              function: "(member-scan)",
              phase_label: attempt_phase_label(a: a),
              cause: sweep_row_cause(a: a),
              located: sweep_row_located(a: a)
            }])
          }
        )
      } else {
      let attempts = attempt_closure_rows(
        ingest: ingest,
        admission: admission,
        fn_names: fold_list(xs: names, empty: no_fn_symbols(), cons: fn(acc, n) {
          concat(acc, [symbol_intern_lexeme(lexeme: n)])
        }),
        entry: entry
      )
      fold_list(xs: names, empty: SweepPairState { index: 0, out: [] }, cons: fn(st, name) {
        let row = match list_at_optional(xs: attempts, index: st.index) {
          Absent =>
            RealizationSweepRow {
              entry: entry,
              function: name,
              phase_label: "read",
              cause: "realization_sweep_attempt_row_missing",
              located: entry
            }
          Present { value: a } =>
            RealizationSweepRow {
              entry: entry,
              function: name,
              phase_label: attempt_phase_label(a: a),
              cause: sweep_row_cause(a: a),
              located: sweep_row_located(a: a)
            }
        }
        SweepPairState { index: st.index + 1, out: concat(st.out, [row]) }
      }).out
      }
    }
  }
}

type SweepPairState {
  index: Int
  out: List<RealizationSweepRow>
}

fn sweep_row_count_for(rows: List<RealizationSweepRow>, entry: String, function: String) -> Int {
  fold_list(xs: rows, empty: 0, cons: fn(acc, r) {
    if (r.entry == entry) && (r.function == function) { acc + 1 } else { acc }
  })
}

fn sweep_rows_join_canonical(rows: List<RealizationSweepRow>, entry: String, identities: List<String>) -> Bool {
  let forward = fold_list(xs: identities, empty: true, cons: fn(acc, f) {
    acc && (sweep_row_count_for(rows: rows, entry: entry, function: f) == 1)
  })
  let backward = fold_list(xs: rows, empty: true, cons: fn(acc, r) {
    acc && fold_list(xs: identities, empty: false, cons: fn(found, f) { found || (f == r.function) })
  })
  forward && backward && (length(xs: rows) == length(xs: identities))
}

fn no_sweep_rows() -> List<RealizationSweepRow> {
  []
}

fn sweep_receipt_tsv(rows: List<RealizationSweepRow>) -> String {
  fold_list(xs: rows, empty: "", cons: fn(acc, r) {
    let line = concat(r.entry, "\t", r.function, "\t", r.phase_label, "\t", r.cause, "\t", r.located)
    if acc == "" { line } else { concat(acc, "\n", line) }
  })
}

type SweepHistogramState {
  prev: String
  count: Int
  out: String
}

fn sweep_histogram_tsv(rows: List<RealizationSweepRow>) -> String {
  let keys = map(rows, r => concat(r.phase_label, "\t", r.cause)) |> sort_by(k => k)
  let folded = fold_list(xs: keys, empty: SweepHistogramState { prev: "", count: 0, out: "" }, cons: fn(st, k) {
    if st.count == 0 {
      SweepHistogramState { prev: k, count: 1, out: st.out }
    } else if k == st.prev {
      SweepHistogramState { prev: st.prev, count: st.count + 1, out: st.out }
    } else {
      SweepHistogramState {
        prev: k,
        count: 1,
        out: if st.out == "" { concat(st.prev, "\t", int_to_decimal_string(value: st.count)) } else { concat(st.out, "\n", st.prev, "\t", int_to_decimal_string(value: st.count)) }
      }
    }
  })
  if folded.count == 0 {
    folded.out
  } else if folded.out == "" {
    concat(folded.prev, "\t", int_to_decimal_string(value: folded.count))
  } else {
    concat(folded.out, "\n", folded.prev, "\t", int_to_decimal_string(value: folded.count))
  }
}
