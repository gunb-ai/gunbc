// src/v2/workflow/floor_plan.dag — the CI FLOOR as a dependency-ordered plan.
//
// Scope: dogfood the v2.workflow scheduler on our own CI floor. The flat YAML
// step list in `.github/workflows/ci.yml` (claim_batch corpus + the effectful
// `gunbc run ci_floor_gates` step) becomes plan NODES with real dependency edges,
// driven by ONE `claim_executor --plan-entry` invocation: dependency-ordered,
// parallel-where-independent, fail-closed (DESIGN §4/§5). The executor
// (`parallel_executor_plan_from_dependencies`) is the batching AUTHORITY — adding
// a node or an edge here re-batches the floor with zero host change.
//
// 🟡 SCAFFOLD — feature:floor-discovery-batch-node — owner:merry-owl —
// dissolve-on: the "actually correct" floor model (per-job typed verdicts reified
// into .dag / affected-set→scheduler-frontier fusion) lands. The `DiscoveryBatch`
// runnable is the pragmatic interim that folds the ~199-row `--roster-from-discovery`
// corpus into one node WITHOUT re-coining the discovery roster as explicit plan
// nodes (DESIGN §3) — the host (claim_executor) reuses claim_batch's shared roster.
//
// Dependency model (the true edges): `compile_clean` (the cheap pinned dsl
// compile-clean contract) is the fail-fast root — every other gate consumes a
// healthy dsl tree, so they sit in a later readiness layer behind it. Within that
// layer the gates are mutually independent and parallelize. Reordering (running a
// dependent before compile_clean) would change the result — that is what the
// `floor_*` witnesses in floor_plan_test.dag pin.

module v2.workflow.floor_plan

import v2.std.algebra { length, list_snoc_item }
import v2.std.collection { List }
import v2.std.dependency { DataDependsOn, DependencyView }
import v2.std.node { Atom, Node, TypeNode }
import v2.std.text { String }
import v2.workflow.executor {
  ExecutorBatch,
  ExecutorRunBlocked,
  ExecutorRunComplete,
  ExecutorRunRunnable,
  parallel_executor_plan_from_dependencies
}

// Host-readable runnable: what claim_executor parses out of each plan element.
// `RunnableSingleClaim` = one (entry, function) Bool witness/gate; the host
// resolves the entry and runs the function. `RunnableDiscoveryBatch` = the whole
// `--roster-from-discovery` corpus as one node — the host reuses claim_batch's
// shared roster over `source_roots` (scan_dirs drive the `unified_claim_*` scan;
// the `test fn`/`test data` walk runs over the source roots regardless).
type Runnable
  = RunnableSingleClaim { entry: String, function: String }
  | RunnableDiscoveryBatch { source_roots: List<String>, scan_dirs: List<String> }

// ── floor gate nodes (one Atom-identity Node per gate) ──────────────────────
data floor_compile_clean_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^floor_compile_clean } },
  children: []
}
data floor_corpus_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^floor_corpus } },
  children: []
}
data floor_rust_gate_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^floor_rust_gate } },
  children: []
}
data floor_emit_host_gate_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^floor_emit_host_gate } },
  children: []
}
data floor_layering_gate_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^floor_layering_gate } },
  children: []
}
data floor_compile_clean_gate_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^floor_compile_clean_gate } },
  children: []
}
data floor_rust_stage0_witness_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^floor_rust_stage0_witness } },
  children: []
}
data floor_emit_host_witness_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^floor_emit_host_witness } },
  children: []
}
data floor_layering_coverage_witness_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^floor_layering_coverage_witness } },
  children: []
}
data floor_filesystem_witness_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^floor_filesystem_witness } },
  children: []
}
data floor_power_watt_witness_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^floor_power_watt_witness } },
  children: []
}

data floor_nodes: List<Node> = [
  floor_compile_clean_node,
  floor_corpus_node,
  floor_rust_gate_node,
  floor_emit_host_gate_node,
  floor_layering_gate_node,
  floor_compile_clean_gate_node,
  floor_rust_stage0_witness_node,
  floor_emit_host_witness_node,
  floor_layering_coverage_witness_node,
  floor_filesystem_witness_node,
  floor_power_watt_witness_node
]

// ── dependency edges: every gate depends on compile_clean (fail-fast root) ──
fn floor_depends_on_compile_clean(dependent: Node) -> DependencyView {
  DependencyView {
    source: floor_compile_clean_node,
    dependent: dependent,
    kind: DataDependsOn,
    usage_site: dependent
  }
}

data floor_dependencies: List<DependencyView> = [
  floor_depends_on_compile_clean(dependent: floor_corpus_node),
  floor_depends_on_compile_clean(dependent: floor_rust_gate_node),
  floor_depends_on_compile_clean(dependent: floor_emit_host_gate_node),
  floor_depends_on_compile_clean(dependent: floor_layering_gate_node),
  floor_depends_on_compile_clean(dependent: floor_compile_clean_gate_node),
  floor_depends_on_compile_clean(dependent: floor_rust_stage0_witness_node),
  floor_depends_on_compile_clean(dependent: floor_emit_host_witness_node),
  floor_depends_on_compile_clean(dependent: floor_layering_coverage_witness_node),
  floor_depends_on_compile_clean(dependent: floor_filesystem_witness_node),
  floor_depends_on_compile_clean(dependent: floor_power_watt_witness_node)
]

// ── node -> host-readable Runnable (the single binding site) ─────────────────
// Any unmapped node projects the unrunnable sentinel (empty entry) so the host
// fails closed — never a silent vacuous pass (DESIGN §5).
fn floor_unrunnable_sentinel() -> Runnable {
  RunnableSingleClaim { entry: "", function: "__floor_plan_unmapped__" }
}

data floor_corpus_source_roots: List<String> = ["src/v2", "dsl"]

fn floor_runnable_for_node(node: Node) -> Runnable {
  if node == floor_compile_clean_node {
    RunnableSingleClaim {
      entry: "dsl/test/claim/dsl_compile_clean_witness.dag",
      function: "dsl_compile_clean_witnesses"
    }
  } else { if node == floor_corpus_node {
    RunnableDiscoveryBatch { source_roots: floor_corpus_source_roots, scan_dirs: [] }
  } else { if node == floor_rust_gate_node {
    RunnableSingleClaim {
      entry: "dsl/tools/floor_effect_gate_witness.dag",
      function: "rust_monolith_gate_passes"
    }
  } else { if node == floor_emit_host_gate_node {
    RunnableSingleClaim {
      entry: "dsl/tools/floor_effect_gate_witness.dag",
      function: "emit_host_gate_passes"
    }
  } else { if node == floor_layering_gate_node {
    RunnableSingleClaim {
      entry: "dsl/tools/floor_effect_gate_witness.dag",
      function: "layering_imports_gate_passes"
    }
  } else { if node == floor_compile_clean_gate_node {
    RunnableSingleClaim {
      entry: "dsl/tools/floor_effect_gate_witness.dag",
      function: "dsl_compile_clean_gate_passes"
    }
  } else { if node == floor_rust_stage0_witness_node {
    RunnableSingleClaim {
      entry: "dsl/test/claim/rust_stage0_gates_witness.dag",
      function: "rust_stage0_gates_witnesses"
    }
  } else { if node == floor_emit_host_witness_node {
    RunnableSingleClaim {
      entry: "dsl/test/claim/emit_host_gate_witness.dag",
      function: "emit_host_gate_witnesses"
    }
  } else { if node == floor_layering_coverage_witness_node {
    RunnableSingleClaim {
      entry: "src/v2/test/claim/layering_imports/coverage_domain_equivalence.dag",
      function: "coverage_domain_equivalence_argument_holds"
    }
  } else { if node == floor_filesystem_witness_node {
    RunnableSingleClaim {
      entry: "dsl/test/claim/filesystem_entry_kind_witness.dag",
      function: "filesystem_entry_kind_witnesses"
    }
  } else { if node == floor_power_watt_witness_node {
    RunnableSingleClaim {
      entry: "dsl/test/claim/power_watt_witness.dag",
      function: "power_watt_witnesses"
    }
  } else {
    floor_unrunnable_sentinel()
  }}}}}}}}}}}
}

fn floor_runnables_for_batch(batch: ExecutorBatch) -> List<Runnable> {
  fold(batch.jobs, init: [], f: fn(acc, job) {
    list_snoc_item(xs: acc, item: floor_runnable_for_node(node: job.node))
  })
}

// Top-level host entry: the executor-decided batches projected to runnables.
// Outer list = batches in execution order; inner list = runnables parallel within
// a batch. A non-complete plan projects a single unrunnable-sentinel batch so the
// host fails closed (never exit-0 on zero nodes) — the floor is statically
// satisfiable, so those arms are unreachable today but must never mean success.
fn floor_claim_batches() -> List<List<Runnable>> {
  match parallel_executor_plan_from_dependencies(
    nodes: floor_nodes,
    dependencies: floor_dependencies,
    scheduled: []
  ) {
    ExecutorRunComplete { batches: batches, scheduled: _ } =>
      fold(batches, init: [], f: fn(acc, batch) {
        list_snoc_item(xs: acc, item: floor_runnables_for_batch(batch: batch))
      })
    ExecutorRunRunnable { batch: _, scheduled: _, remaining: _ } => [[floor_unrunnable_sentinel()]]
    ExecutorRunBlocked { evidence: _, batches: _, scheduled: _, remaining: _ } => [[floor_unrunnable_sentinel()]]
  }
}

// ── plan-shape helpers reused by the floor_plan_test witnesses ──────────────
fn floor_batch_count() -> Int {
  length(xs: floor_claim_batches())
}
