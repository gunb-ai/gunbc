module v2.workflow.class_b_import_closure_transport

import extdeps.git
import extdeps.git.inspect
import extdeps.shell
import gunbc.ci_layer_roots { witness_layer_roots }
import gunbc.class_b_import_closure_overlay {
  class_b_entry_rel,
  class_b_materialize_stripped_entry_overlay,
  class_b_declared_import_pool_roots,
  OverlayMaterialized,
  OverlayMaterializationRefused
}
import gunbc.declared_import_closure_binding {
  DeclaredImportClosureBindingObservation,
  DeclaredImportClosureBindingObservationOutcome,
  BindingNotRunnable,
  ObservationProduced,
  ObservationProductionRefused,
  binding_source_is_listed_import,
  row3_stripped_refuses_binding,
  row4_stripped_pool_coincidence_or_refuse
}
import std.logic { Bool }
import std.types { String, List, NonEmptyStr }

data class_b_transport_note: String = "Class B import-closure transport (#6985). All four rows are ordinary funcs on this module. REQUIRED-FLOOR CONSUMERS (merge-blocking today): test.claim.rust_test_fixtures_import_closure_witness.declared_import_closure_lists_rust_import and .ambient_pool_provider_preserves_listed_import — they execute on the required floor because required_floor.dag excludes the long home by authored module name and this module carries no long prefix, so the FalsifierSubstrateLongLane exclusion row was inert and is deleted (2026-08-18). WET INTEGRATION CONSUMER (not on required floor yet): run_class_b_import_closure_gate on source_root_ingest_gate_passes — rows 1-4 together when that gate is re-enrolled on claim_executor --required-floor. Rows 1-2 use class_b_declared_import_pool_roots (minimal declared-import footprint). Rows 3-4 use witness_layer_roots for stripped-entry pool-coincidence pressure. Rows 3-4 accept ONLY ObservationProduced carrying a successfully ingested BindingObserved outcome; every ObservationProductionRefused (overlay read/strip/mkdir/mktemp/write/cleanup/compile) reds the gate — compile graph:None is P1(b), not a seam refusal. Predicate unit controls stay in class_b_import_closure_binding_refusal_witness_test.dag and class_b_strip_receipt_witness_test.dag. Affected-set skip: class_b_import_closure_gate_not_affected_skip (cli_run::class_b_import_closure_gate_skip_label_for_ci) skips the ~2.3min gate on pull_request when the merge-base diff is provably disjoint from the gate input closure; empty diff / departed non-docs / observation or closure failure runs the full gate (fail-closed); push-to-main always runs the full gate as cold control."

data class_b_consumer_module: String = "v2.extdeps.languages.rust_test"
data class_b_symbol: String = "rust_selection_policy_node"
data class_b_perturbation_overlay_rel: String = "fixtures/class_b_import_closure/perturbation_overlay"
data class_b_overlay_template: String = "/target/class_b_stripped_XXXXXX"

fn class_b_observe_with_overlay(
  pool_roots: List<String>
) -> DeclaredImportClosureBindingObservation {
  observe_declared_import_closure_symbol_binding(
    pool_roots: pool_roots,
    entry_path: class_b_entry_rel,
    consumer_module: class_b_consumer_module,
    symbol: class_b_symbol
  )
}

fn class_b_outcome_from_observation(
  obs: DeclaredImportClosureBindingObservation
) -> DeclaredImportClosureBindingObservationOutcome {
  match obs {
    BindingNotRunnable { cause } => ObservationProductionRefused {
      phase: "compile" as NonEmptyStr,
      cause: cause
    }
    observation => ObservationProduced { observation: observation }
  }
}

func class_b_declared_import_closure_lists_rust_import() -> Bool {
  binding_source_is_listed_import(
    obs: class_b_observe_with_overlay(pool_roots: class_b_declared_import_pool_roots)
  )
}

func class_b_ambient_pool_provider_preserves_listed_import() -> Bool {
  let baseline = class_b_observe_with_overlay(pool_roots: class_b_declared_import_pool_roots)
  let perturbed = class_b_observe_with_overlay(
    pool_roots: concat([class_b_perturbation_overlay_rel], class_b_declared_import_pool_roots)
  )
  binding_source_is_listed_import(obs: baseline)
    && binding_source_is_listed_import(obs: perturbed)
}

func class_b_observe_with_derived_stripped_overlay(
  include_perturbation: Bool
) -> DeclaredImportClosureBindingObservationOutcome {
  let root = git.Inspect.Toplevel()
  let target = shell.Mkdir.Parents(path: concat(root.path, "/target"))
  if target.success {
    let overlay = shell.Mktemp.DirWithTemplate(
      template: concat(root.path, class_b_overlay_template)
    )
    if overlay.success {
      match class_b_materialize_stripped_entry_overlay(root: root.path, overlay_dir: overlay.path) {
        OverlayMaterialized { overlay_entry_path: _ } => {
          let pool_roots = if include_perturbation {
            concat([overlay.path, class_b_perturbation_overlay_rel], witness_layer_roots)
          } else {
            concat([overlay.path], witness_layer_roots)
          }
          let observed = class_b_outcome_from_observation(
            obs: class_b_observe_with_overlay(pool_roots: pool_roots)
          )
          let cleaned = shell.Remove.RecursiveForce(path: overlay.path)
          if cleaned.success {
            observed
          } else {
            ObservationProductionRefused {
              phase: "cleanup" as NonEmptyStr,
              cause: "class_b overlay cleanup refused" as NonEmptyStr
            }
          }
        }
        OverlayMaterializationRefused { phase, cause } => ObservationProductionRefused {
          phase: phase,
          cause: cause
        }
      }
    } else {
      ObservationProductionRefused {
        phase: "mktemp" as NonEmptyStr,
        cause: "class_b overlay mktemp refused" as NonEmptyStr
      }
    }
  } else {
    ObservationProductionRefused {
      phase: "mkdir" as NonEmptyStr,
      cause: "class_b overlay target mkdir refused" as NonEmptyStr
    }
  }
}

func class_b_stripped_import_closure_refuses_binding() -> Bool {
  row3_stripped_refuses_binding(
    outcome: class_b_observe_with_derived_stripped_overlay(include_perturbation: false)
  )
}

func class_b_stripped_with_ambient_pool_coincidence_or_refuse() -> Bool {
  row4_stripped_pool_coincidence_or_refuse(
    outcome: class_b_observe_with_derived_stripped_overlay(include_perturbation: true)
  )
}

func run_class_b_import_closure_gate() -> Bool {
  if class_b_import_closure_gate_not_affected_skip() {
    true
  } else {
    class_b_declared_import_closure_lists_rust_import()
      && class_b_ambient_pool_provider_preserves_listed_import()
      && class_b_stripped_import_closure_refuses_binding()
      && class_b_stripped_with_ambient_pool_coincidence_or_refuse()
  }
}
