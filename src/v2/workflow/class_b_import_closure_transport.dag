module v2.workflow.class_b_import_closure_transport

import extdeps.git
import extdeps.git.inspect
import extdeps.shell
import gunbc.ci_layer_roots { witness_layer_roots }
import gunbc.class_b_import_closure_overlay {
  class_b_entry_rel,
  class_b_materialize_stripped_entry_overlay,
  class_b_declared_import_pool_roots
}
import gunbc.declared_import_closure_binding {
  DeclaredImportClosureBindingObservation,
  binding_source_is_listed_import,
  binding_refuses,
  row4_pool_coincidence_or_refuse
}
import std.logic { Bool }
import std.types { String, List, NonEmptyStr }

data class_b_transport_note: String = "Executing consumer for the Class B import-closure witness (#6985). All four rows are ordinary funcs on this module; run_class_b_import_closure_gate is the per-PR merge-blocking consumer on source_root_ingest_gate. Rows 1-2 use class_b_declared_import_pool_roots (minimal declared-import footprint). Rows 3-4 use witness_layer_roots for stripped-entry pool-coincidence pressure. Discovery long-lane enrollment (FalsifierSubstrateLongLane) replays rows 1-2 on the falsifier cold-control cadence — same cold-control pattern as compile-clean/regen, not duplicate authority. Affected-set skip: class_b_import_closure_gate_not_affected_skip (cli_run::class_b_import_closure_gate_skip_label_for_ci) skips the ~2.3min gate on pull_request when the merge-base diff is provably disjoint from the gate input closure; empty diff / departed non-docs / observation or closure failure runs the full gate (fail-closed); push-to-main always runs the full gate as cold control."

data class_b_consumer_module: String = "v2.extdeps.languages.rust_test"
data class_b_symbol: String = "rust_selection_policy_node"
data class_b_perturbation_overlay_rel: String = "fixtures/class_b_import_closure/perturbation_overlay"
data class_b_overlay_template: String = "/target/class_b_stripped_XXXXXX"

fn class_b_observe_with_overlay(
  pool_roots: List<String>
) -> DeclaredImportClosureBindingObservation {
  observe_declared_import_closure_symbol_binding(
    pool_roots: pool_roots,
    entry_path: class_b_entry_rel,
    consumer_module: class_b_consumer_module,
    symbol: class_b_symbol
  )
}

func class_b_declared_import_closure_lists_rust_import() -> Bool {
  binding_source_is_listed_import(
    obs: class_b_observe_with_overlay(pool_roots: class_b_declared_import_pool_roots)
  )
}

func class_b_ambient_pool_provider_preserves_listed_import() -> Bool {
  let baseline = class_b_observe_with_overlay(pool_roots: class_b_declared_import_pool_roots)
  let perturbed = class_b_observe_with_overlay(
    pool_roots: concat([class_b_perturbation_overlay_rel], class_b_declared_import_pool_roots)
  )
  binding_source_is_listed_import(obs: baseline)
    && binding_source_is_listed_import(obs: perturbed)
}

func class_b_observe_with_derived_stripped_overlay(
  include_perturbation: Bool
) -> DeclaredImportClosureBindingObservation {
  let root = git.Inspect.Toplevel()
  let target = shell.Mkdir.Parents(path: concat(root.path, "/target"))
  if target.success {
    let overlay = shell.Mktemp.DirWithTemplate(
      template: concat(root.path, class_b_overlay_template)
    )
    if overlay.success {
      let materialized = class_b_materialize_stripped_entry_overlay(
        root: root.path,
        overlay_dir: overlay.path
      )
      let pool_roots = if include_perturbation {
        concat([overlay.path, class_b_perturbation_overlay_rel], witness_layer_roots)
      } else {
        concat([overlay.path], witness_layer_roots)
      }
      let observed = if materialized {
        class_b_observe_with_overlay(pool_roots: pool_roots)
      } else {
        BindingNotRunnable { cause: "class_b_materialize_stripped_entry_overlay refused" as NonEmptyStr }
      }
      let cleaned = shell.Remove.RecursiveForce(path: overlay.path)
      if cleaned.success {
        observed
      } else {
        BindingNotRunnable { cause: "class_b overlay cleanup refused" as NonEmptyStr }
      }
    } else {
      BindingNotRunnable { cause: "class_b overlay mktemp refused" as NonEmptyStr }
    }
  } else {
    BindingNotRunnable { cause: "class_b overlay target mkdir refused" as NonEmptyStr }
  }
}

func class_b_stripped_import_closure_refuses_binding() -> Bool {
  binding_refuses(
    obs: class_b_observe_with_derived_stripped_overlay(include_perturbation: false)
  )
}

func class_b_stripped_with_ambient_pool_coincidence_or_refuse() -> Bool {
  row4_pool_coincidence_or_refuse(
    obs: class_b_observe_with_derived_stripped_overlay(include_perturbation: true)
  )
}

func run_class_b_import_closure_gate() -> Bool {
  if class_b_import_closure_gate_not_affected_skip() {
    true
  } else {
    class_b_declared_import_closure_lists_rust_import()
      && class_b_ambient_pool_provider_preserves_listed_import()
      && class_b_stripped_import_closure_refuses_binding()
      && class_b_stripped_with_ambient_pool_coincidence_or_refuse()
  }
}
