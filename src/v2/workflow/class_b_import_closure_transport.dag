module v2.workflow.class_b_import_closure_transport

import extdeps.git
import extdeps.shell
import gunbc.ci_layer_roots { witness_layer_roots }
import std.logic { Bool }
import tools.host_prelude {
  ClaimRun,
  run_gunbc_claims
}
import v2.std.text { String }

data class_b_transport_note: String = "Executing consumer for the Class B import-closure witness. Committed fixture overlays live under fixtures/class_b_import_closure/ (outside the dag witness_layer_roots scan) and are prepended to witness_layer_roots so stripped entries and ambient pool perturbations supersede the live tree without module-path collisions during shared-index resolve."

data class_b_witness_entry: String = "dag/test/claim/rust_test_fixtures_import_closure_witness_test.dag"
data class_b_stripped_overlay_rel: String = "fixtures/class_b_import_closure/stripped_overlay"
data class_b_perturbation_overlay_rel: String = "fixtures/class_b_import_closure/perturbation_overlay"

fn class_b_claim_source_roots() -> List<String> {
  concat(
    [class_b_stripped_overlay_rel, class_b_perturbation_overlay_rel],
    witness_layer_roots
  )
}

func run_class_b_import_closure_gate() -> Bool {
  let root = git.Inspect.Toplevel()
  run_gunbc_claims(
    source_roots: class_b_claim_source_roots(),
    claims: [
      ClaimRun { entry: class_b_witness_entry, function: "declared_import_closure_lists_rust_import" },
      ClaimRun { entry: class_b_witness_entry, function: "ambient_pool_provider_preserves_listed_import" },
      ClaimRun { entry: class_b_witness_entry, function: "stripped_import_closure_refuses_binding" },
      ClaimRun { entry: class_b_witness_entry, function: "stripped_with_ambient_pool_coincidence_or_refuse" }
    ]
  )
}
