module v2.workflow.orchestration_emit_test

import v2.workflow.orchestration_emit { orch_emit_pipeline, orch_emit_run, orch_run_env_reduction_dissolution_trigger }
import extdeps.communication.medium { Medium }
import v2.std.orchestration {
  Run,
  Step,
  Do,
  Pipeline,
  FailFast,
  EnvSet
}
import v2.std.collection { Absent }
import v2.std.diagnostic { Accepted, None, Outcome, Rejected }

fn orch_pipeline_step1() -> Step {
  Do {
    run: Run {
      command: "cargo build -p v1-compiler --release --bins",
      env: [],
      redirect: Absent,
      capture: Absent
    }
  }
}

fn orch_pipeline_step2() -> Step {
  Do {
    run: Run {
      command: "cargo test --workspace",
      env: [EnvSet { name: "CARGO_BUILD_JOBS", value: "1" }],
      redirect: Absent,
      capture: Absent
    }
  }
}

fn orch_pipeline_two_steps() -> Pipeline {
  Pipeline {
    steps: [orch_pipeline_step1(), orch_pipeline_step2()],
    on_failure: FailFast
  }
}

fn orch_pipeline_one_step() -> Pipeline {
  Pipeline {
    steps: [orch_pipeline_step1()],
    on_failure: FailFast
  }
}

test fn orch_pipeline_single_step_is_run_holds() -> Bool {
  match orch_emit_pipeline(p: orch_pipeline_one_step()) {
    Accepted { value: src, diagnostics: dg } =>
      (src.carried == "cargo build -p v1-compiler --release --bins") && (dg == None)
    Rejected { diagnostics: _ } => false
  }
}

fn orch_pipeline_two_steps_expected() -> String {
  "cargo build -p v1-compiler --release --bins\nCARGO_BUILD_JOBS=1 cargo test --workspace"
}

fn orch_pipeline_two_steps_space_joined_wrong() -> String {
  "cargo build -p v1-compiler --release --bins CARGO_BUILD_JOBS=1 cargo test --workspace"
}

test fn orch_pipeline_two_steps_newline_joined_holds() -> Bool {
  match orch_emit_pipeline(p: orch_pipeline_two_steps()) {
    Accepted { value: src, diagnostics: dg } =>
      (src.carried == orch_pipeline_two_steps_expected()) && (dg == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_pipeline_join_has_teeth_holds() -> Bool {
  match orch_emit_pipeline(p: orch_pipeline_two_steps()) {
    Accepted { value: src, diagnostics: _ } =>
      src.carried != orch_pipeline_two_steps_space_joined_wrong()
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_run_empty_env_delegates_to_shell_emit_holds() -> Bool {
  match orch_emit_run(r: Run { command: "cargo build", env: [], redirect: Absent, capture: Absent }) {
    Accepted { value: src, diagnostics: dg } =>
      (src.carried == "cargo build") && (dg == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_run_env_reduction_trigger_recorded_holds() -> Bool {
  string_contains(s: orch_run_env_reduction_dissolution_trigger, pattern: "EnvPrefixed")
    && string_contains(s: orch_run_env_reduction_dissolution_trigger, pattern: "EnvUnset")
    && string_contains(s: orch_run_env_reduction_dissolution_trigger, pattern: "lower_env_bindings")
    && string_contains(s: orch_run_env_reduction_dissolution_trigger, pattern: "DISSOLVES WHEN")
}
