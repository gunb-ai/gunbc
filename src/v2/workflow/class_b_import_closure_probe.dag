module v2.workflow.class_b_import_closure_probe

import gunbc.class_b_import_closure_overlay {
  class_b_entry_rel,
  class_b_declared_import_pool_roots
}
import gunbc.declared_import_closure_binding {
  DeclaredImportClosureBindingObservation,
  binding_source_is_listed_import
}
import std.logic { Bool }
import std.types { String, List }

data class_b_probe_note: String = "Rows 1-2 of the Class B rust_test_fixtures control (#6985) -- the SHAPE and single call rows 1-2 need, split out of v2.workflow.class_b_import_closure_transport per the same relocation-not-refork discipline as v2.compiler.inferred_tree (DESIGN.md §3). class_b_import_closure_transport also imports extdeps.git, extdeps.git.inspect and gunbc.ci_layer_roots at module level, but ONLY its rows 3-4 (class_b_observe_with_derived_stripped_overlay and callers) ever touch them -- rows 1-2 use only class_b_declared_import_pool_roots (class_b_import_closure_transport_note already says so). Because a witness entry's resolve context is driven by its ENTRY MODULE's whole transitive import closure, not by which functions its test bodies actually call, rust_test_fixtures_import_closure_witness_test.dag inherited git/git.inspect/ci_layer_roots's closures for free every time it imported the transport module to reach these two functions -- the same signature as extdeps_scope_placement_gate_loudness_witness's 718-to-62-module repair. class_b_import_closure_transport imports this module back for rows 1-2's own use (the relocated authority, not a second declaration of it); rows 3-4 and the gate stay on the heavy module, which is where their own git/shell/ci_layer_roots need actually lives. MEASURED 2026-08-19: this narrowing does NOT reduce witness wall-clock cost for rows 1-2 (a same-dispatch, same-host paired comparison found this narrow entry statistically indistinguishable from the heavy transport entry, ~70s both standalone; the floor's own [floor-witness-slow] line agrees at 24674ms/31603ms, ~2-3x lower than the standalone figure because the floor amortizes its corpus-wide load term once per MultiEntryIndex rather than once per claim, but still shows no narrow-vs-heavy divergence) -- neither figure is attributable to entry-closure resolution at all, so this split is retained purely as a DESIGN.md §3 dependency-correctness improvement, not as a witness-cost repair; see class_b_import_closure_transport's class_b_transport_note and the witness's class_b_witness_note for the full measurement."

data class_b_consumer_module: String = "v2.extdeps.languages.rust_test"
data class_b_symbol: String = "rust_selection_policy_node"
data class_b_perturbation_overlay_rel: String = "fixtures/class_b_import_closure/perturbation_overlay"

fn class_b_observe_with_overlay(
  pool_roots: List<String>
) -> DeclaredImportClosureBindingObservation {
  observe_declared_import_closure_symbol_binding(
    pool_roots: pool_roots,
    entry_path: class_b_entry_rel,
    consumer_module: class_b_consumer_module,
    symbol: class_b_symbol
  )
}

func class_b_declared_import_closure_lists_rust_import() -> Bool {
  binding_source_is_listed_import(
    obs: class_b_observe_with_overlay(pool_roots: class_b_declared_import_pool_roots)
  )
}

func class_b_ambient_pool_provider_preserves_listed_import() -> Bool {
  let baseline = class_b_observe_with_overlay(pool_roots: class_b_declared_import_pool_roots)
  let perturbed = class_b_observe_with_overlay(
    pool_roots: concat([class_b_perturbation_overlay_rel], class_b_declared_import_pool_roots)
  )
  binding_source_is_listed_import(obs: baseline)
    && binding_source_is_listed_import(obs: perturbed)
}
