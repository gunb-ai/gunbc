module v2.workflow.regen_bootstrap_population

// REVIEW-ONLY CONSUMER (correction per review91903 / DESIGN 3c): the declarations below are
// connected to real capability: classify_bootstrap_path_transition produces a total
// classification with refusal, and admit_bootstrap_population produces admission or refusal and
// is the ONLY producer of BootstrapPopulation (its named sole_constructor). No host cutover is
// implied: this module performs no filesystem, git, cargo, or process effect, and nothing here
// executes a restore. The named consumers are the review and
// src/v2/test/claim/self_host/regen_bootstrap_population.dag, which inhabits every retained
// declaration and refuses on every refusal arm.
//
// The law (single precedence, authoritative here; the claim tests each branch):
// A path transition pairs the HEAD snapshot (before) and BASE snapshot (during) for one path.
// 1. A path present in HEAD but absent from BASE refuses HeadOnlyPath: no new transient
//    deletion algorithm is admitted.
// 2. A path absent from HEAD and present in BASE is an install candidate only when its BASE
//    entry is a 100644 regular blob (InstallCandidate); an executable, symlink, subtree, or
//    gitlink there refuses UnsupportedTrackedEntry.
// 3. A path present in both snapshots: a symlink, subtree, or gitlink on EITHER side refuses
//    UnsupportedTrackedEntry (checked before any mode comparison); otherwise a mode mismatch
//    between 100644 and 100755 refuses ModeTransitionUnsupported; two 100755 executables are
//    themselves unsupported tracked entries and refuse UnsupportedTrackedEntry (they are not a
//    mode transition); two 100644 regular files with equal object ids decide Noop (a decision
//    only — it asserts nothing about filesystem behavior such as mtime), and with differing
//    object ids are RestoreCandidates carrying both observed ids.
// 4. A transition whose two sides name different paths, or whose both sides are absent, has no
//    established projection and refuses ProjectionAuthorityUnestablished.
//
// DEFERRED HOST FRONTIER (not modeled here, no declaration claims it): the journal, the
// sole-writer rollback, the restoration receipt, base-seed provenance, untracked-collision
// observation, head-observation revalidation, and transaction authority remain obligations of
// the v1 host (src/v1/stage0/src/required_regen_host.rs). They were previously declared here as
// types with no producer or consumer; those declarations are REMOVED, not faked. A future
// correction must connect them to a real producer/consumer at landing.
//
// This module is review-only: it does not authorize a runtime cutover.

import std.types { FilePath, List }
import std.algebra { Cons, Empty }
import std.optional { Optional }
import extdeps.git.object_store {
  GitObjectId,
  TreeEntry,
  RegularBlobEntry,
  ExecutableBlobEntry,
  SymlinkEntry,
  SubtreeEntry,
  GitlinkEntry,
  git_object_id_eq,
}

type BootstrapCommitSubject {
  commit: GitObjectId
  tree: GitObjectId
}

type BootstrapPathVersion {
  path: FilePath
  entry: Optional<TreeEntry>
}

type BootstrapPathTransition {
  before: BootstrapPathVersion
  during: BootstrapPathVersion
}

// The refusal causes this module's capability actually produces. Host-frontier causes
// (collision, revalidation, transaction authority, commit reads) are NOT declared here because
// nothing in this module produces or consumes them (see DEFERRED HOST FRONTIER above).
type BootstrapPopulationRefusal
  = UnsupportedTrackedEntry { path: FilePath }
  | ModeTransitionUnsupported { path: FilePath }
  | HeadOnlyPath { path: FilePath }
  | ProjectionAuthorityUnestablished { path: FilePath }

// Total classification of one transition under the law above.
type BootstrapPathTransitionClass
  = TransitionNoop { path: FilePath }
  | RestoreCandidate { path: FilePath, before_oid: GitObjectId, during_oid: GitObjectId }
  | InstallCandidate { path: FilePath, during_oid: GitObjectId }
  | TransitionRefused { path: FilePath, cause: BootstrapPopulationRefusal }

// Sealed: constructed ONLY by admit_bootstrap_population below (named sole_constructor).
type BootstrapPopulation = sole_constructor BootstrapPopulation {
  selected: BootstrapCommitSubject
  head: BootstrapCommitSubject
  projection: BootstrapPathVersion
  package_roots: List<FilePath>
  authority_inputs: List<BootstrapPathVersion>
  workspace_inputs: List<BootstrapPathVersion>
  transitions: List<BootstrapPathTransition>
}

type BootstrapPopulationAdmission
  = Admitted { population: BootstrapPopulation }
  | Refused { cause: BootstrapPopulationRefusal }

fn bootstrap_unsupported_tracked_arm(entry: TreeEntry) -> Bool {
  match entry {
    SymlinkEntry { name: _, oid: _ } => true
    SubtreeEntry { name: _, oid: _ } => true
    GitlinkEntry { name: _, oid: _ } => true
    _ => false
  }
}

fn bootstrap_classify_both_present(
  path: FilePath,
  before: TreeEntry,
  during: TreeEntry,
) -> BootstrapPathTransitionClass {
  if bootstrap_unsupported_tracked_arm(entry: before)
    || bootstrap_unsupported_tracked_arm(entry: during) {
    TransitionRefused {
      path: path,
      cause: UnsupportedTrackedEntry { path: path },
    }
  } else {
    match before {
      RegularBlobEntry { name: _, oid: before_oid } =>
        match during {
          RegularBlobEntry { name: _, oid: during_oid } =>
            if git_object_id_eq(left: before_oid, right: during_oid) {
              TransitionNoop { path: path }
            } else {
              RestoreCandidate {
                path: path,
                before_oid: before_oid,
                during_oid: during_oid,
              }
            }
          ExecutableBlobEntry { name: _, oid: _ } =>
            TransitionRefused {
              path: path,
              cause: ModeTransitionUnsupported { path: path },
            }
          _ =>
            TransitionRefused {
              path: path,
              cause: UnsupportedTrackedEntry { path: path },
            }
        }
      ExecutableBlobEntry { name: _, oid: _ } =>
        // Law branch 3: two executables are unsupported tracked entries, NOT a mode
        // transition; a regular-to-executable pairing is the mode transition.
        match during {
          RegularBlobEntry { name: _, oid: _ } =>
            TransitionRefused {
              path: path,
              cause: ModeTransitionUnsupported { path: path },
            }
          _ =>
            TransitionRefused {
              path: path,
              cause: UnsupportedTrackedEntry { path: path },
            }
        }
      _ =>
        TransitionRefused {
          path: path,
          cause: UnsupportedTrackedEntry { path: path },
        }
    }
  }
}

fn bootstrap_classify_base_only(
  path: FilePath,
  during: TreeEntry,
) -> BootstrapPathTransitionClass {
  match during {
    RegularBlobEntry { name: _, oid: during_oid } =>
      InstallCandidate { path: path, during_oid: during_oid }
    _ =>
      TransitionRefused {
        path: path,
        cause: UnsupportedTrackedEntry { path: path },
      }
  }
}

fn classify_bootstrap_path_transition(
  transition: BootstrapPathTransition,
) -> BootstrapPathTransitionClass {
  let before = transition.before
  let during = transition.during
  if before.path != during.path {
        TransitionRefused {
          path: before.path,
          cause: ProjectionAuthorityUnestablished { path: before.path },
        }
      } else {
        match before.entry {
          Present { value: before_entry } =>
            match during.entry {
              Present { value: during_entry } =>
                bootstrap_classify_both_present(
                  path: before.path,
                  before: before_entry,
                  during: during_entry,
                )
              Absent =>
                TransitionRefused {
                  path: before.path,
                  cause: HeadOnlyPath { path: before.path },
                }
            }
          Absent =>
            match during.entry {
              Present { value: during_entry } =>
                bootstrap_classify_base_only(path: during.path, during: during_entry)
              Absent =>
                TransitionRefused {
                  path: during.path,
                  cause: ProjectionAuthorityUnestablished { path: during.path },
                }
            }
        }
      }
}

// Walks the transitions left to right; the FIRST refusing transition refuses the whole
// admission (deterministic leftmost cause). With no refusing transition, constructs the
// population through the named sole_constructor.
fn bootstrap_admit_walk(
  remaining: List<BootstrapPathTransition>,
  population: BootstrapPopulation,
) -> BootstrapPopulationAdmission {
  match remaining {
    Empty => Admitted { population: population }
    Cons { head: first, tail: rest } =>
      match classify_bootstrap_path_transition(transition: first) {
        TransitionRefused { path: _, cause: cause } => Refused { cause: cause }
        _ => bootstrap_admit_walk(remaining: rest, population: population)
      }
  }
}

fn admit_bootstrap_population(
  selected: BootstrapCommitSubject,
  head: BootstrapCommitSubject,
  projection: BootstrapPathVersion,
  package_roots: List<FilePath>,
  authority_inputs: List<BootstrapPathVersion>,
  workspace_inputs: List<BootstrapPathVersion>,
  transitions: List<BootstrapPathTransition>,
) -> BootstrapPopulationAdmission {
  match projection.entry {
    Absent =>
      Refused {
        cause: ProjectionAuthorityUnestablished { path: projection.path },
      }
    Present { value: _ } =>
      bootstrap_admit_walk(
        remaining: transitions,
        population: BootstrapPopulation {
          selected: selected,
          head: head,
          projection: projection,
          package_roots: package_roots,
          authority_inputs: authority_inputs,
          workspace_inputs: workspace_inputs,
          transitions: transitions,
        },
      )
  }
}

// Accessors: the only way a consumer reads a sealed BootstrapPopulation's bindings.
fn bootstrap_population_selected(population: BootstrapPopulation) -> BootstrapCommitSubject {
  population.selected
}

fn bootstrap_population_head(population: BootstrapPopulation) -> BootstrapCommitSubject {
  population.head
}

fn bootstrap_population_projection(population: BootstrapPopulation) -> BootstrapPathVersion {
  population.projection
}

fn bootstrap_population_transitions(
  population: BootstrapPopulation,
) -> List<BootstrapPathTransition> {
  population.transitions
}
