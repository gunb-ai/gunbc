module v2.workflow.regen_bootstrap_population

// SCOPE: pure classification and admission decisions for the bootstrap population law
// (HEAD-snapshot vs BASE-snapshot path transitions). No filesystem, git, cargo, or process
// effect; nothing here reads, writes, restores, or rolls back. The executable classification
// lives in classify_bootstrap_path_transition and admit_bootstrap_population below; this
// comment does not restate the law (the code is the authority).
//
// WHAT ADMISSION CERTIFIES (and nothing more): BootstrapAdmitted means exactly (a) the
// projection version carries a present entry, and (b) every transition in the list
// classified without refusal under the fold. BootstrapRefused carries the leftmost refusing
// cause. The population's
// selected/head/projection bindings are CARRIED IDENTITIES (inputs passed through), not
// certified facts; the transition_classes binding is the certified classification.
//
// NOT JUDGED HERE (policy: deferred, not checked, not implied): duplicate transition paths,
// projection.path correspondence with transition paths, and TreeEntry.name consistency with
// the path basename. A consumer that needs these judgements must establish them itself.
//
// SEALING (rung honesty, DESIGN 4b(1)): BootstrapPopulation uses the established
// sole_constructor spelling. The seal is MODULE-scoped (v1.compiler
// sole_constructor_construction_diags / v2.compiler.infer_sole_constructor_diags): outside
// this module the type cannot be constructed or matched; inside this module
// admit_bootstrap_population is the only constructor by author restraint, not by a
// function-scoped enforcement rule.
//
// PRODUCTION CONSUMER AND THE MISSING ROUTE (rung honesty): the production consumer is
// required_regen_host::bootstrap_round_one_from_base_mirror in src/v1/stage0/src/
// required_regen_host.rs — it EXISTS, is implemented, and is called on the production
// round-1 path (defined L4822; production call site L8702, plus host tests). It does NOT
// read this module's classification today. The missing capability — and the trigger that
// would connect this model to the host — is an explicit route by which that host restore
// consumes this v2 classification (an emitted call into classify_bootstrap_path_transition /
// admit_bootstrap_population, or the host's restore classifying through this fold). No such
// route exists, none is claimed here, and review, registration, or landing are NOT consumers
// and grant no capability. The journal, sole-writer rollback, restoration receipt, base-seed
// provenance, collision observation, head revalidation, and transaction authority remain v1
// host obligations with no declaration here claiming them.
//
// This module authorizes no runtime cutover.

import std.types { FilePath, List }
import std.algebra { Cons, Empty }
import std.optional { Optional, Present, Absent, optional_absent, optional_present }
import extdeps.git.object_store {
  GitObjectId,
  TreeEntry,
  RegularBlobEntry,
  ExecutableBlobEntry,
  SymlinkEntry,
  SubtreeEntry,
  GitlinkEntry,
  git_object_id_eq,
}

type BootstrapCommitSubject {
  commit: GitObjectId
  tree: GitObjectId
}

type BootstrapPathVersion {
  path: FilePath
  entry: Optional<TreeEntry>
}

type BootstrapPathTransition {
  before: BootstrapPathVersion
  during: BootstrapPathVersion
}

// Refusal causes this module's capability actually produces. Host-frontier causes (commit
// reads, tree mismatch, assembly disagreement, workspace-input comparison, collision,
// revalidation, transaction authority) are NOT declared here: nothing in this module
// produces or consumes them (see DEFERRED PRODUCTION CONSUMER above).
type BootstrapPopulationRefusal
  = UnsupportedTrackedEntry { path: FilePath }
  | ModeTransitionUnsupported { path: FilePath }
  | HeadOnlyPath { path: FilePath }
  | ProjectionAuthorityUnestablished { path: FilePath }

// Total classification of one transition (the executable law).
type BootstrapPathTransitionClass
  = TransitionNoop { path: FilePath }
  | RestoreCandidate { path: FilePath, before_oid: GitObjectId, during_oid: GitObjectId }
  | InstallCandidate { path: FilePath, during_oid: GitObjectId }
  | TransitionRefused { path: FilePath, cause: BootstrapPopulationRefusal }

// Module-sealed record (see SEALING above): constructed only by admit_bootstrap_population.
type BootstrapPopulation sole_constructor {
  selected: BootstrapCommitSubject
  head: BootstrapCommitSubject
  projection: BootstrapPathVersion
  transition_classes: List<BootstrapPathTransitionClass>
}

// Arm names carry the Bootstrap prefix so co-import with other admission-style modules
// cannot collide.
type BootstrapPopulationAdmission
  = BootstrapAdmitted { population: BootstrapPopulation }
  | BootstrapRefused { cause: BootstrapPopulationRefusal }

fn bootstrap_classify_both_present(
  path: FilePath,
  before: TreeEntry,
  during: TreeEntry,
) -> BootstrapPathTransitionClass {
  match before {
    RegularBlobEntry { name: _, oid: before_oid } =>
      match during {
        RegularBlobEntry { name: _, oid: during_oid } =>
          if git_object_id_eq(left: before_oid, right: during_oid) {
            TransitionNoop { path: path }
          } else {
            RestoreCandidate {
              path: path,
              before_oid: before_oid,
              during_oid: during_oid,
            }
          }
        ExecutableBlobEntry { name: _, oid: _ } =>
          TransitionRefused {
            path: path,
            cause: ModeTransitionUnsupported { path: path },
          }
        SymlinkEntry { name: _, oid: _ } =>
          TransitionRefused {
            path: path,
            cause: UnsupportedTrackedEntry { path: path },
          }
        SubtreeEntry { name: _, oid: _ } =>
          TransitionRefused {
            path: path,
            cause: UnsupportedTrackedEntry { path: path },
          }
        GitlinkEntry { name: _, oid: _ } =>
          TransitionRefused {
            path: path,
            cause: UnsupportedTrackedEntry { path: path },
          }
      }
    ExecutableBlobEntry { name: _, oid: _ } =>
      match during {
        RegularBlobEntry { name: _, oid: _ } =>
          TransitionRefused {
            path: path,
            cause: ModeTransitionUnsupported { path: path },
          }
        ExecutableBlobEntry { name: _, oid: _ } =>
          TransitionRefused {
            path: path,
            cause: UnsupportedTrackedEntry { path: path },
          }
        SymlinkEntry { name: _, oid: _ } =>
          TransitionRefused {
            path: path,
            cause: UnsupportedTrackedEntry { path: path },
          }
        SubtreeEntry { name: _, oid: _ } =>
          TransitionRefused {
            path: path,
            cause: UnsupportedTrackedEntry { path: path },
          }
        GitlinkEntry { name: _, oid: _ } =>
          TransitionRefused {
            path: path,
            cause: UnsupportedTrackedEntry { path: path },
          }
      }
    SymlinkEntry { name: _, oid: _ } =>
      TransitionRefused {
        path: path,
        cause: UnsupportedTrackedEntry { path: path },
      }
    SubtreeEntry { name: _, oid: _ } =>
      TransitionRefused {
        path: path,
        cause: UnsupportedTrackedEntry { path: path },
      }
    GitlinkEntry { name: _, oid: _ } =>
      TransitionRefused {
        path: path,
        cause: UnsupportedTrackedEntry { path: path },
      }
  }
}

fn bootstrap_classify_base_only(
  path: FilePath,
  during: TreeEntry,
) -> BootstrapPathTransitionClass {
  match during {
    RegularBlobEntry { name: _, oid: during_oid } =>
      InstallCandidate { path: path, during_oid: during_oid }
    ExecutableBlobEntry { name: _, oid: _ } =>
      TransitionRefused {
        path: path,
        cause: UnsupportedTrackedEntry { path: path },
      }
    SymlinkEntry { name: _, oid: _ } =>
      TransitionRefused {
        path: path,
        cause: UnsupportedTrackedEntry { path: path },
      }
    SubtreeEntry { name: _, oid: _ } =>
      TransitionRefused {
        path: path,
        cause: UnsupportedTrackedEntry { path: path },
      }
    GitlinkEntry { name: _, oid: _ } =>
      TransitionRefused {
        path: path,
        cause: UnsupportedTrackedEntry { path: path },
      }
  }
}

fn classify_bootstrap_path_transition(
  transition: BootstrapPathTransition,
) -> BootstrapPathTransitionClass {
  let before = transition.before
  let during = transition.during
  if before.path != during.path {
    TransitionRefused {
      path: before.path,
      cause: ProjectionAuthorityUnestablished { path: before.path },
    }
  } else {
    match before.entry {
      Present { value: before_entry } =>
        match during.entry {
          Present { value: during_entry } =>
            bootstrap_classify_both_present(
              path: before.path,
              before: before_entry,
              during: during_entry,
            )
          Absent =>
            TransitionRefused {
              path: before.path,
              cause: HeadOnlyPath { path: before.path },
            }
        }
      Absent =>
        match during.entry {
          Present { value: during_entry } =>
            bootstrap_classify_base_only(path: during.path, during: during_entry)
          Absent =>
            TransitionRefused {
              path: during.path,
              cause: ProjectionAuthorityUnestablished { path: during.path },
            }
        }
    }
  }
}

// Leftmost refusing cause over the classified list; linear, short-circuiting.
fn bootstrap_first_refusal(
  classes: List<BootstrapPathTransitionClass>,
) -> Optional<BootstrapPopulationRefusal> {
  match classes {
    Empty => optional_absent<BootstrapPopulationRefusal>()
    Cons { head: first, tail: rest } =>
      match first {
        TransitionRefused { path: _, cause: cause } => optional_present(value: cause)
        _ => bootstrap_first_refusal(classes: rest)
      }
  }
}

// The module's only constructor of BootstrapPopulation (module seal; author restraint).
// Carries the classified list so a consumer never re-classifies.
fn admit_bootstrap_population(
  selected: BootstrapCommitSubject,
  head: BootstrapCommitSubject,
  projection: BootstrapPathVersion,
  transitions: List<BootstrapPathTransition>,
) -> BootstrapPopulationAdmission {
  let classes = transitions |> map(
    transition => classify_bootstrap_path_transition(transition: transition),
  )
  match projection.entry {
    Absent =>
      BootstrapRefused {
        cause: ProjectionAuthorityUnestablished { path: projection.path },
      }
    Present { value: _ } =>
      match bootstrap_first_refusal(classes: classes) {
        Present { value: cause } => BootstrapRefused { cause: cause }
        Absent =>
          BootstrapAdmitted {
            population: BootstrapPopulation {
              selected: selected,
              head: head,
              projection: projection,
              transition_classes: classes,
            },
          }
      }
  }
}

// Accessors: the way a consumer reads a module-sealed BootstrapPopulation's bindings.
fn bootstrap_population_selected(population: BootstrapPopulation) -> BootstrapCommitSubject {
  population.selected
}

fn bootstrap_population_head(population: BootstrapPopulation) -> BootstrapCommitSubject {
  population.head
}

fn bootstrap_population_projection(population: BootstrapPopulation) -> BootstrapPathVersion {
  population.projection
}

fn bootstrap_population_transition_classes(
  population: BootstrapPopulation,
) -> List<BootstrapPathTransitionClass> {
  population.transition_classes
}
