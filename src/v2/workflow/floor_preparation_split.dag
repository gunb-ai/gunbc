// Substring and prefix authority for the whole fold (runner imports these; a second
// implementation in the runner would be a fork).
fn floor_preparation_contains(haystack: String, needle: String) -> Bool {
  split(s: haystack, delimiter: needle).length() > 1
}

fn floor_preparation_text_starts_with(text: String, prefix: String) -> Bool {
  let pieces = split(s: text, delimiter: prefix)
  pieces.length() > 1 && pieces.first() == Present { value: "" }
}

fn floor_preparation_population_text() -> String {
  filesystem_read(path: "dag/test/claim/floor/floor_preparation_split_population.txt").content
}

// The model rows are the authority; this reads them. The second argument to the old filter -- a
// runtime re-check that kind was one of two strings -- is gone because the type makes any other
// value unwritable (fail_closed: "making it unwritable" beats "catching a wrong state").
fn floor_preparation_population_rows() -> List<FloorPreparationPopulationRow> {
  floor_preparation_population_model_rows
}

fn floor_preparation_population_is_wellformed() -> Bool {
  length(xs: floor_preparation_population_rows()) > 0
    && fold(floor_preparation_population_rows(), init: true, f: (acc, row) =>
      acc && length(xs: row.entry) > 0 && length(xs: row.claim) > 0)
}

fn floor_preparation_population_kind_text(kind: FloorPreparationPopulationKind) -> String {
  match kind {
    Candidate => "candidate"
    Extra => "extra"
  }
}

fn floor_preparation_population_line(row: FloorPreparationPopulationRow) -> String {
  concat(concat(concat(floor_preparation_population_kind_text(row.kind), "|"), row.entry), concat("|", row.claim))
}

fn floor_preparation_population_lines() -> List<String> {
  fold(floor_preparation_population_rows(), init: [], f: (acc, row) =>
    list_push(xs: acc, item: floor_preparation_population_line(row)))
}

fn floor_preparation_population_rendering() -> String {
  concat(concat("POPULATION-BEGIN\n", join(floor_preparation_population_lines(), "\n")), "\nPOPULATION-END")
}

// The committed file agrees with the model iff its non-comment bytes ARE the rendering body.
fn floor_preparation_population_file_agrees() -> Bool {
  let body = join(floor_preparation_population_lines(), "\n")
  let kept = fold(split(s: floor_preparation_population_text(), delimiter: "\n"), init: [], f: (acc, line) =>
    if floor_preparation_text_starts_with(text: line, prefix: "#") { acc }
    else if line == "" { acc }
    else { list_push(xs: acc, item: line) })
  length(xs: kept) > 0 && join(kept, "\n") == body
}

fn floor_preparation_yes_no(value: Bool) -> String {
  if value { "yes" } else { "no" }
}

// ----------------------------------------------------------------------------------------------
// THE POPULATION CENSUS -- what the capture dropped, and whether the drop is auditable.
// ----------------------------------------------------------------------------------------------
//
// A trimmed capture measures a smaller floor than the one this node exists to make affordable, so
// the graded capture is never presented alone. The untrimmed leg ran the SAME entries with the
// refused claims still in them; its rows are committed; and every claim left out of the graded
// capture has a row in `floor_preparation_requested_rows` carrying a cause. The cause is not taken
// on faith: these helpers re-derive it from the untrimmed capture's OWN `FAIL ` and `UNOBSERVED `
// rows, so an exclusion is auditable to a printed refusal and not to a name pattern that merely
// correlates with one. (Ordered by royal-newt-240, msg_8712db4a, after a first draft trimmed the
// population by a name pattern and called the result the measurement.)

data floor_preparation_graded_disposition: String = "graded"
data floor_preparation_excluded_disposition: String = "excluded"
data floor_preparation_cause_refused: String = "refused"
data floor_preparation_cause_unobserved: String = "unobserved"
data floor_preparation_cause_no_verdict: String = "no_verdict_line"
data floor_preparation_unobserved_prefix: String = "UNOBSERVED "
data floor_preparation_witness_prefix: String = "[witness] "

fn floor_preparation_row_field(row: String, offset: Int) -> String {
  let pieces = split(s: row, delimiter: "|")
  match floor_preparation_nth(pieces, offset) {
    Present { value: found } => found
    Absent => ""
  }
}

fn floor_preparation_nth(pieces: List<String>, offset: Int) -> Optional<String> {
  if offset <= 0 {
    pieces.first()
  } else {
    floor_preparation_nth(pieces.skip(n: 1), offset - 1)
  }
}

fn floor_preparation_row_module(row: String) -> String {
  floor_preparation_row_field(row, 0)
}

fn floor_preparation_row_claim(row: String) -> String {
  floor_preparation_row_field(row, 1)
}

fn floor_preparation_row_disposition(row: String) -> String {
  floor_preparation_row_field(row, 2)
}

fn floor_preparation_row_cause(row: String) -> String {
  floor_preparation_row_field(row, 3)
}

fn floor_preparation_has_exact_row(rows: List<String>, wanted: String) -> Bool {
  fold(rows, init:  false, f: (acc, row) => acc || row == wanted)
}

fn floor_preparation_any_row_starts_with(rows: List<String>, prefix: String) -> Bool {
  fold(rows, init:  false, f: (acc, row) => acc || floor_preparation_starts_with(row, prefix))
}

fn floor_preparation_capture_names_a_pass(capture: List<String>, claim: String) -> Bool {
  floor_preparation_has_exact_row(capture, concat(floor_preparation_pass_prefix, claim))
}

fn floor_preparation_capture_names_a_refusal(capture: List<String>, claim: String) -> Bool {
  floor_preparation_has_exact_row(capture, concat(floor_preparation_fail_prefix, claim))
    || floor_preparation_any_row_starts_with(capture, concat(floor_preparation_unobserved_prefix, claim))
}

fn floor_preparation_requested_row_count() -> Int {
  fold(floor_preparation_requested_rows(), init:  0, f: (acc, row) => acc + 1)
}

fn floor_preparation_graded_row_count() -> Int {
  fold(floor_preparation_requested_rows(), init:  0, f: (acc, row) =>
    if floor_preparation_row_disposition(row) == floor_preparation_graded_disposition { acc + 1 } else { acc })
}

fn floor_preparation_excluded_row_count() -> Int {
  fold(floor_preparation_requested_rows(), init:  0, f: (acc, row) =>
    if floor_preparation_row_disposition(row) == floor_preparation_excluded_disposition { acc + 1 } else { acc })
}

fn floor_preparation_excluded_with_cause(cause: String) -> Int {
  fold(floor_preparation_requested_rows(), init:  0, f: (acc, row) =>
    if floor_preparation_row_disposition(row) == floor_preparation_excluded_disposition {
      if floor_preparation_row_cause(row) == cause { acc + 1 } else { acc }
    } else {
      acc
    })
}

fn floor_preparation_requested_modules() -> List<String> {
  fold(floor_preparation_requested_rows(), init:  [], f: (acc, row) =>
    if floor_preparation_any_row_starts_with(acc, floor_preparation_row_module(row)) {
      acc
    } else {
      concat(acc, [floor_preparation_row_module(row)])
    })
}

// THE CENSUS IS HONEST when every graded row really did come back PASS in BOTH captures, every row
// marked `refused` really has a FAIL row in the untrimmed capture, every row marked `unobserved`
// really has an UNOBSERVED row there, and every `no_verdict_line` row has NEITHER. A capture that
// quietly deleted a refused claim fails the `refused`/`unobserved` arms; a capture that quietly
// promoted a red claim into the graded set fails the first arm. This is the witness that turns
// "the committed capture is green" from an assertion into a check.
fn floor_preparation_census_is_honest() -> Bool {
  fold(floor_preparation_requested_rows(), init:  true, f: (acc, row) =>
    if acc == false {
      false
    } else {
      let claim = floor_preparation_row_claim(row)
      let disposition = floor_preparation_row_disposition(row)
      let cause = floor_preparation_row_cause(row)
      if disposition == floor_preparation_graded_disposition {
        floor_preparation_capture_names_a_pass(floor_preparation_capture(), claim)
          && floor_preparation_capture_names_a_pass(floor_preparation_untrimmed_capture(), claim)
      } else if cause == floor_preparation_cause_refused {
        floor_preparation_has_exact_row(floor_preparation_untrimmed_capture(), concat(floor_preparation_fail_prefix, claim))
      } else if cause == floor_preparation_cause_unobserved {
        floor_preparation_any_row_starts_with(floor_preparation_untrimmed_capture(), concat(floor_preparation_unobserved_prefix, claim))
      } else if cause == floor_preparation_cause_no_verdict {
        floor_preparation_has_exact_row(floor_preparation_untrimmed_capture(), concat(floor_preparation_fail_prefix, claim)) == false
          && floor_preparation_any_row_starts_with(floor_preparation_untrimmed_capture(), concat(floor_preparation_unobserved_prefix, claim)) == false
      } else {
        false
      }
    })
}

// THE UNTRIMMED LEG IS NOT A SECOND MEASUREMENT OF A DIFFERENT FLOOR: it must have executed every
// graded claim, or "what the floor actually pays" would be a figure about something else entirely.
fn floor_preparation_untrimmed_covers_the_graded_population() -> Bool {
  fold(floor_preparation_requested_rows(), init:  true, f: (acc, row) =>
    if acc == false {
      false
    } else if floor_preparation_row_disposition(row) != floor_preparation_graded_disposition {
      acc
    } else {
      floor_preparation_has_exact_row(
        floor_preparation_untrimmed_capture(),
        concat(floor_preparation_witness_prefix, concat(floor_preparation_row_claim(row), ":"))
      )
    })
}

fn floor_preparation_untrimmed_field_of(capture: List<String>, which: String) -> Int {
  match floor_preparation_split(capture) {
    Split { preparation_ms: p, claim_ms: c, preparation_lines: pl, claim_lines: cl, uncosted_lines: ul, untagged_lines: tl, verdict_pass: vp, verdict_fail: vf, total_ms: t } =>
      if which == "total" {
        floor_preparation_ms_count(t)
      } else if which == "preparation" {
        floor_preparation_ms_count(p)
      } else if which == "claim" {
        floor_preparation_ms_count(c)
      } else if which == "fail" {
        vf
      } else if which == "pass" {
        vp
      } else if which == "untagged" {
        tl
      } else {
        0 - 1
      }
    Refused { text: row, cause: why } => 0 - 1
  }
}

fn floor_preparation_untrimmed_total_ms() -> Int {
  floor_preparation_untrimmed_field_of(floor_preparation_untrimmed_capture(), "total")
}

fn floor_preparation_untrimmed_preparation_ms() -> Int {
  floor_preparation_untrimmed_field_of(floor_preparation_untrimmed_capture(), "preparation")
}

fn floor_preparation_untrimmed_claim_ms() -> Int {
  floor_preparation_untrimmed_field_of(floor_preparation_untrimmed_capture(), "claim")
}

fn floor_preparation_untrimmed_verdict_fail() -> Int {
  floor_preparation_untrimmed_field_of(floor_preparation_untrimmed_capture(), "fail")
}

fn floor_preparation_untrimmed_verdict_pass() -> Int {
  floor_preparation_untrimmed_field_of(floor_preparation_untrimmed_capture(), "pass")
}

fn floor_preparation_untrimmed_untagged_lines() -> Int {
  floor_preparation_untrimmed_field_of(floor_preparation_untrimmed_capture(), "untagged")
}

