  FloorPreparationPopulationRow { kind: Candidate, entry: "dag/test/claim/floor/floor_batch_clamp_authority_witness.dag", claim: "positional_clamp_row_zero_cites_the_ci_floor_batch_list_it_lives_in" },
  FloorPreparationPopulationRow { kind: Candidate, entry: "dag/test/claim/floor/floor_batch_clamp_authority_witness.dag", claim: "a_nonzero_rate_clamp_does_move_with_the_unit_count" },
