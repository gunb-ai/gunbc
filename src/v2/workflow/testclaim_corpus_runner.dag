module v2.test.workflow.testclaim_corpus_runner


type BoolWitnessRun
  = BoolWitnessRuntimeVerdict { witness: BoolWitness, result: Bool }
  | BoolWitnessQueuedForHostTransport { witness: BoolWitness }

type UnifiedClaimRun
  = NodeCorpusRun { run: TestClaimRun<Node, RuntimeValue> }
  | NodeCorpusUnresolvedRun { claim: TestClaim }
  | NodeCorpusEmitVsEvalDeferredRun { claim: TestClaim, target: TargetModel }
  | BoolWitnessRunReceipt { run: BoolWitnessRun }

type CorpusEvalEntry {
  run: UnifiedClaimRun
}

type CorpusEvalReport {
  entries: List<CorpusEvalEntry>
}

type TestClaimSubjectRosterUnsupportedRow {
  subject_family: Symbol
  reason: Symbol
}

type TestClaimSubjectRosterFamilyReceipt {
  subject_family: Symbol
  run_family: Symbol
  subjects: List<TestClaimEvalSubject<Node>>
  runs: List<TestClaimRun<Node, RuntimeValue>>
  unsupported_rows: List<TestClaimSubjectRosterUnsupportedRow>
  report: CorpusEvalReport
}
data testclaim_subject_roster_unsupported_rows: List<TestClaimSubjectRosterUnsupportedRow> = [
  TestClaimSubjectRosterUnsupportedRow {
    subject_family: ^testclaim_subject_roster_family_ci_pipeline,
    reason: ^testclaim_subject_roster_unsupported_until_runner_projection_lands
  },
  TestClaimSubjectRosterUnsupportedRow {
    subject_family: ^testclaim_subject_roster_family_non_runtime_value,
    reason: ^testclaim_subject_roster_unsupported_until_runner_projection_lands
  }
]

fn corpus_entry_label(e: CorpusEvalEntry) -> String {
  match e.run {
    NodeCorpusRun { run: node_run } =>
      test_claim_label(c: test_claim_run_claim(run: node_run))
    NodeCorpusUnresolvedRun { claim: claim } =>
      test_claim_label(c: claim)
    NodeCorpusEmitVsEvalDeferredRun { claim: claim, target: _ } =>
      test_claim_label(c: claim)
    BoolWitnessRunReceipt { run: bool_run } =>
      bool_witness_run_witness(run: bool_run).entry
  }
}

fn verdict_tally_add_deferred_row(t: VerdictTally) -> VerdictTally {
  VerdictTally { pass: t.pass, fail: t.fail, deferred: Succ { prev: t.deferred } }
}

fn bool_witness_run_witness(run: BoolWitnessRun) -> BoolWitness {
  match run {
    BoolWitnessRuntimeVerdict { witness: witness, result: _ } =>
      witness
    BoolWitnessQueuedForHostTransport { witness: witness } =>
      witness
  }
}

fn unified_bool_witness_run_tally(t: VerdictTally, run: BoolWitnessRun) -> VerdictTally {
  match run {
    BoolWitnessQueuedForHostTransport { witness: _ } =>
      verdict_tally_add_deferred_row(t: t)
    BoolWitnessRuntimeVerdict { witness: _, result: true } =>
      verdict_tally_add(t: t, v: Pass)
    BoolWitnessRuntimeVerdict { witness: _, result: false } =>
      VerdictTally { pass: t.pass, fail: Succ { prev: t.fail }, deferred: t.deferred }
  }
}

fn queued_bool_witness_run(witness: BoolWitness) -> BoolWitnessRun {
  BoolWitnessQueuedForHostTransport { witness: witness }
}

fn corpus_report_tally_add_unified_run(t: VerdictTally, run: UnifiedClaimRun) -> VerdictTally {
  match run {
    NodeCorpusRun { run: node_run } =>
      verdict_tally_add(t: t, v: test_claim_run_verdict(run: node_run))
    NodeCorpusUnresolvedRun { claim: _ } =>
      verdict_tally_add_deferred_row(t: t)
    NodeCorpusEmitVsEvalDeferredRun { claim: _, target: _ } =>
      verdict_tally_add_deferred_row(t: t)
    BoolWitnessRunReceipt { run: bool_run } =>
      unified_bool_witness_run_tally(t: t, run: bool_run)
  }
}

fn corpus_report_tally(r: CorpusEvalReport) -> VerdictTally {
  fold(r.entries, init: verdict_tally_empty, f: fn(acc, e) {
    corpus_report_tally_add_unified_run(t: acc, run: e.run)
  })
}

fn corpus_report_pass_count(r: CorpusEvalReport) -> v2.std.nat.Nat {
  corpus_report_tally(r: r).pass
}

fn corpus_report_fail_count(r: CorpusEvalReport) -> v2.std.nat.Nat {
  corpus_report_tally(r: r).fail
}

fn corpus_report_deferred_count(r: CorpusEvalReport) -> v2.std.nat.Nat {
  corpus_report_tally(r: r).deferred
}

fn corpus_report_total(r: CorpusEvalReport) -> v2.std.nat.Nat {
  verdict_tally_total(t: corpus_report_tally(r: r))
}

fn list_length_nat<T>(xs: List<T>) -> v2.std.nat.Nat {
  fold(xs, init: Zero, f: fn(acc, _) { Succ { prev: acc } })
}

fn nat_eq(a: v2.std.nat.Nat, b: v2.std.nat.Nat) -> Bool {
  match nat_compare(a: a, b: b) {
    Equal => true
    Less => false
    Greater => false
  }
}

fn corpus_entry_from_node_runtime_value_run(
  run: TestClaimRun<Node, RuntimeValue>
) -> CorpusEvalEntry {
  CorpusEvalEntry { run: NodeCorpusRun { run: run } }
}

fn corpus_entries_from_node_runtime_value_runs(
  runs: List<TestClaimRun<Node, RuntimeValue>>
) -> List<CorpusEvalEntry> {
  map(runs, fn(run) { corpus_entry_from_node_runtime_value_run(run: run) })
}

fn run_node_runtime_value_subjects(
  subjects: List<TestClaimEvalSubject<Node>>
) -> List<TestClaimRun<Node, RuntimeValue>> {
  map(subjects, fn(subject) { run_test_claim(subject: subject) })
}

fn node_corpus_claim_from_subject(subject: TestClaimEvalSubject<Node>) -> UnifiedTestClaim {
  NodeCorpus {
    claim: subject.claim,
    transport: EvalOnly
  }
}

fn manual_node_corpus_unified_claims() -> List<UnifiedTestClaim> {
  map(manual_corpus_node_subject_rows, fn(subject) { node_corpus_claim_from_subject(subject: subject) })
}

fn unified_corpus_eval_pilot_claims() -> List<UnifiedTestClaim> {
  manual_node_corpus_unified_claims()
}

fn corpus_entry_from_queued_bool_witness(witness: BoolWitness) -> CorpusEvalEntry {
  CorpusEvalEntry {
    run: BoolWitnessRunReceipt { run: queued_bool_witness_run(witness: witness) }
  }
}

fn manual_node_corpus_unified_claim_projection_holds() -> Bool {
  fold(
    manual_node_corpus_unified_claims(),
    init: true,
    f: fn(acc, c) { acc && (unified_test_claim_modality(c: c) == UnifiedNodeCorpusModality) }
  )
}

fn corpus_entry_from_unresolved_node_corpus_claim(claim: TestClaim) -> CorpusEvalEntry {
  CorpusEvalEntry { run: NodeCorpusUnresolvedRun { claim: claim } }
}

fn corpus_entry_from_emit_vs_eval_deferred_node_corpus_claim(
  claim: TestClaim,
  target: TargetModel
) -> CorpusEvalEntry {
  CorpusEvalEntry {
    run: NodeCorpusEmitVsEvalDeferredRun { claim: claim, target: target }
  }
}

fn run_node_corpus_eval_only_entry(c: UnifiedTestClaim) -> CorpusEvalEntry {
  match c {
    NodeCorpus { claim: claim, transport: EvalOnly } => {
      let unresolved = corpus_entry_from_unresolved_node_corpus_claim(claim: claim)
      fold(
        manual_corpus_node_subject_rows,
        init: unresolved,
        f: fn(acc, subject) {
          match acc.run {
            NodeCorpusUnresolvedRun { claim: _ } =>
              if node_corpus_claim_from_subject(subject: subject) == c {
                corpus_entry_from_node_runtime_value_run(run: run_test_claim(subject: subject))
              } else {
                acc
              }
            _ => acc
          }
        }
      )
    }
    NodeCorpus { claim: claim, transport: EmitVsEval { target: target } } =>
      corpus_entry_from_emit_vs_eval_deferred_node_corpus_claim(claim: claim, target: target)
    BoolWitnessClaim { witness: w } =>
      corpus_entry_from_queued_bool_witness(witness: w)
  }
}

fn manual_node_corpus_claims_all_resolve() -> Bool {
  fold(
    manual_node_corpus_unified_claims(),
    init: true,
    f: fn(acc, c) {
      match c {
        NodeCorpus { claim: _, transport: EvalOnly } =>
          acc && fold(
            manual_corpus_node_subject_rows,
            init: false,
            f: fn(found, subject) {
              found || (node_corpus_claim_from_subject(subject: subject) == c)
            }
          )
        _ => false
      }
    }
  )
}

fn run_unified_corpus_eval_entry(c: UnifiedTestClaim) -> CorpusEvalEntry {
  match c {
    BoolWitnessClaim { witness: w } =>
      corpus_entry_from_queued_bool_witness(witness: w)
    NodeCorpus { claim: claim, transport: transport } =>
      match transport {
        EvalOnly =>
          run_node_corpus_eval_only_entry(c: c)
        EmitVsEval { target: target } =>
          corpus_entry_from_emit_vs_eval_deferred_node_corpus_claim(claim: claim, target: target)
      }
  }
}

fn run_unified_corpus_eval(claims: List<UnifiedTestClaim>) -> CorpusEvalReport {
  CorpusEvalReport {
    entries: map(claims, fn(c) { run_unified_corpus_eval_entry(c: c) })
  }
}

fn run_unified_corpus_eval_pilot() -> CorpusEvalReport {
  run_unified_corpus_eval(claims: unified_corpus_eval_pilot_claims())
}

fn unified_corpus_eval_manual_node_slice_holds() -> Bool {
  fold(
    manual_corpus_node_subject_rows,
    init: true,
    f: fn(acc, subject) {
      let c = node_corpus_claim_from_subject(subject: subject)
      let manual_run = run_test_claim(subject: subject)
      match run_unified_corpus_eval_entry(c: c).run {
        NodeCorpusRun { run: unified_run } =>
          acc
            && test_claim_run_claim(run: unified_run) == test_claim_run_claim(run: manual_run)
            && test_claim_run_verdict(run: unified_run) == test_claim_run_verdict(run: manual_run)
        _ => false
      }
    }
  )
}

fn unified_corpus_eval_pilot_equivalence_holds() -> Bool {
  let pilot = run_unified_corpus_eval_pilot()
  manual_node_corpus_claims_all_resolve()
    && unified_corpus_eval_manual_node_slice_holds()
    && (length(xs: pilot.entries) == length(xs: unified_corpus_eval_pilot_claims()))
}

fn run_manual_testclaim_corpus_eval() -> CorpusEvalReport {
  CorpusEvalReport {
    entries: corpus_entries_from_node_runtime_value_runs(
      runs: run_node_runtime_value_subjects(subjects: manual_corpus_node_subject_rows)
    )
  }
}

fn manual_testclaim_subject_roster_family_receipt() -> TestClaimSubjectRosterFamilyReceipt {
  let runs = run_node_runtime_value_subjects(subjects: manual_corpus_node_subject_rows)
  TestClaimSubjectRosterFamilyReceipt {
    subject_family: ^testclaim_subject_roster_family_node_runtime_value,
    run_family: ^run_test_claim,
    subjects: manual_corpus_node_subject_rows,
    runs: runs,
    unsupported_rows: testclaim_subject_roster_unsupported_rows,
    report: CorpusEvalReport {
      entries: corpus_entries_from_node_runtime_value_runs(runs: runs)
    }
  }
}

fn manual_testclaim_subject_roster_family_receipt_holds() -> Bool {
  let receipt = manual_testclaim_subject_roster_family_receipt()
  receipt.report.entries == corpus_entries_from_node_runtime_value_runs(runs: receipt.runs)
}

data witness_manual_testclaim_subject_roster_family_receipt: Bool = manual_testclaim_subject_roster_family_receipt_holds()
data witness_manual_node_corpus_unified_claim_projection: Bool = manual_node_corpus_unified_claim_projection_holds()
data witness_unified_corpus_eval_pilot_equivalence: Bool = unified_corpus_eval_pilot_equivalence_holds()
