module v2.test.workflow.loop_linear_bound_rung34_eval

import v2.compiler.eval { TestClaimRun }
import v2.std.algebra { is_empty }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.nat { Zero }
import v2.std.node { Node }
import v2.std.runtime { RuntimeValue }
import v2.test.loop_linear_bound.rung_3_4 {
  run_phase4_loop_linear_bound_rung3_module_roundtrip,
  run_phase4_loop_linear_bound_rung4_rust_emit_equals_eval
}
import v2.test.workflow.testclaim_corpus_runner {
  CorpusEvalReport,
  corpus_entries_from_node_runtime_value_runs,
  corpus_report_tally
}

data loop_linear_bound_rung34_runtime_value_rows: List<TestClaimRun<Node, RuntimeValue>> = [
  run_phase4_loop_linear_bound_rung3_module_roundtrip,
  run_phase4_loop_linear_bound_rung4_rust_emit_equals_eval
]

fn run_loop_linear_bound_rung34_eval() -> CorpusEvalReport {
  CorpusEvalReport {
    entries: corpus_entries_from_node_runtime_value_runs(
      runs: loop_linear_bound_rung34_runtime_value_rows
    )
  }
}

fn loop_linear_bound_rung34_report_has_evidence(report: CorpusEvalReport) -> Bool {
  match is_empty(xs: report.entries) {
    true => false
    false => true
  }
}

fn loop_linear_bound_rung3_gate(report: CorpusEvalReport) -> Bool {
  if loop_linear_bound_rung34_report_has_evidence(report: report) {
    let tally = corpus_report_tally(r: report)
    tally.fail == Zero && tally.deferred == Zero
  } else {
    false
  }
}

fn loop_linear_bound_rung4_gate(report: CorpusEvalReport) -> Bool {
  if loop_linear_bound_rung34_report_has_evidence(report: report) {
    let tally = corpus_report_tally(r: report)
    tally.fail == Zero && tally.deferred == Zero
  } else {
    false
  }
}

fn loop_linear_bound_rungs_34_closed(report: CorpusEvalReport) -> Bool {
  loop_linear_bound_rung3_gate(report: report) && loop_linear_bound_rung4_gate(report: report)
}
