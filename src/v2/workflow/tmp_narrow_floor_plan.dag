module v2.workflow.tmp_narrow_floor_plan

import std.execution_mode { Hermetic }
import v2.std.collection { List }
import v2.std.text { String }
import std.realization_schedule {
  SelectionApplied,
  Runnable,
  RunnableDiscoveryBatch,
  runnable_resource_profile,
  runnable_memory_substantial
}
import v2.workflow.ci_floor_plan { corpus_source_roots }
import gunbc.ci_layer_roots { witness_exclusion_substrings }

fn tmp_narrow_floor_batches() -> List<List<Runnable>> {
  [[RunnableDiscoveryBatch {
    source_roots: corpus_source_roots(),
    scan_dirs: ["src/v2/test/claim/emit"],
    explicit_entries: [],
    node_frontier_selection: SelectionApplied,
    exclude_substrings: witness_exclusion_substrings,
    discovery_scope_dirs: [],
    profile: runnable_resource_profile(
      heavy_whole_tree_resolve: true,
      spawns_host_compiler: false,
      memory: runnable_memory_substantial(),
      execution_mode: Hermetic
    )
  }]]
}
