module v2.workflow.namespace_xl2_rehearsal_native

import std.types { Bool, List, String }
import std.compiler_entry { CompilerEntryDriver, NativeClaimDriver, NativeClaimHeld, NativeClaimNotHeld, NativeClaimReport }
import v2.workflow.namespace_xl2_rehearsal_census { Xl2RehearsalObserved, Xl2RehearsalRun, xl2_strip_members }
import v2.workflow.namespace_xl2_rehearsal_controls { xl2_clean_fixture, xl2_control_rehearse, xl2_provider_fixture, xl2_residual_fixture }

data compiler_pipeline_entry: CompilerEntryDriver = NativeClaimDriver

fn xl2_native_cut_run() -> Xl2RehearsalRun {
  xl2_control_rehearse(strip: xl2_strip_members(sources: [xl2_provider_fixture(), xl2_residual_fixture(), xl2_clean_fixture()]))
}

fn native_claim_report() -> NativeClaimReport {
  match xl2_native_cut_run() {
    Xl2RehearsalObserved { residual: residual } =>
      if count(residual) == 1 && all(residual, r => r.module == "v2.xl2_control_residual") {
        NativeClaimReport { stdout: "xl2_native_cut_residual_is_one_chain held\n", terminal: NativeClaimHeld }
      } else {
        NativeClaimReport { stdout: "xl2_native_cut_residual_is_one_chain not held\n", terminal: NativeClaimNotHeld { reason: "residual is not the one expected chain" } }
      }
    _ => NativeClaimReport { stdout: "xl2_native_cut_residual_is_one_chain not observed\n", terminal: NativeClaimNotHeld { reason: "the cut did not reach an observed run" } }
  }
}
