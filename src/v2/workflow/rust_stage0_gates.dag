// Scope: the coarse "Rust stage0 monolith" CI dependency — the entire Rust seed
//   (every `*.rs` and Cargo/toolchain manifest) treated as ONE dependency with three
//   gate-dependents (clippy, fmt, the in-process witness gate). A diff touching the
//   monolith selects all three to satisfy; a non-Rust diff selects none.
// Authority: the affected-set "satisfy the dependents on change" model
//   (cf. v2.workflow.affected_set_selection), applied at file-path granularity.
//
// SCAFFOLD — dissolution trigger: delete when the Rust seed reaches zero. The proper
// model is per-file Rust dependence (which .rs affects which gate), DELIBERATELY skipped:
// the Rust bootstrap is the seed that shrinks toward zero (DESIGN §7), so fine-graining a
// dependency graph over code that is being deleted is redundant work (§2). One blob, three
// dependents is the correct because-it-is-temporary call.


module v2.workflow.rust_stage0_gates


import v2.std.text { String }
import v2.std.logic { Bool }
import v2.std.collection { List }
import v2.std.algebra { FreeMonoid, Empty, Cons, is_prefix_of, fold_list, any }


// The three dependents on the Rust monolith. No payload — identity is the whole content.
type RustGate
  = ClippyGate
  | FmtGate
  | InProcessWitnessGate


// Reverse a char list. `String = FreeMonoid<Char>`, so a left fold that prepends each
// char produces the reversal — the only primitive needed to turn prefix-matching into
// suffix-matching.
fn reverse_string(s: String) -> String {
  fold_list(xs: s, empty: Empty, cons: fn(acc, c) { Cons { head: c, tail: acc } })
}


// `s` ends with `suffix` iff reverse(suffix) is a prefix of reverse(s). Reuses the
// canonical `is_prefix_of` primitive rather than minting a second matcher.
fn ends_with(s: String, suffix: String) -> Bool {
  is_prefix_of(
    prefix: reverse_string(s: suffix),
    xs: reverse_string(s: s),
    eq: fn(a, b) { a == b }
  )
}


// The suffixes that identify a Rust-monolith path. Manifests are matched by suffix (not
// exact equality) so nested ones — e.g. `src/v1/stage0/Cargo.toml` — are caught too.
fn rust_monolith_suffixes() -> List<String> {
  [".rs", "Cargo.toml", "Cargo.lock", "rust-toolchain.toml"]
}


// A changed repo path belongs to the Rust monolith iff it carries any monolith suffix.
fn path_is_rust_monolith(path: String) -> Bool {
  any(
    xs: rust_monolith_suffixes(),
    predicate: fn(suffix) { ends_with(s: path, suffix: suffix) }
  )
}


// THE SELECTOR. If a diff touches the Rust monolith, all three dependents must be
// satisfied; otherwise none are affected (a .dag-only change is handled by the existing
// witness affected-set, not here). "The affected set = satisfy the three dependents."
fn rust_stage0_affected_gates(changed_paths: List<String>) -> List<RustGate> {
  match any(xs: changed_paths, predicate: fn(p) { path_is_rust_monolith(path: p) }) {
    true => [ClippyGate, FmtGate, InProcessWitnessGate]
    false => []
  }
}
