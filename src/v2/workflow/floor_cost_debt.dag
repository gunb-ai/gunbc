fn floor_cost_debt_proven_roster() -> List<String> {
  list_flat_map(xs: floor_cost_debt_proven_chunks(), f: fn(c) { c })
}

fn floor_cost_debt_censored_roster() -> List<String> {
  list_flat_map(xs: floor_cost_debt_censored_chunks(), f: fn(c) { c })
}

fn floor_cost_debt_straddling_chunks() -> List<List<String>> {
  Cons { head: floor_cost_debt_straddling_chunk_00(), tail: Empty {} }
}

fn floor_cost_debt_straddling_roster() -> List<String> {
  list_flat_map(xs: floor_cost_debt_straddling_chunks(), f: fn(c) { c })
}

fn floor_cost_debt_roster() -> List<String> {
  list_flat_map(
    xs: Cons { head: floor_cost_debt_proven_roster(), tail: Cons { head: floor_cost_debt_censored_roster(), tail: Cons { head: floor_cost_debt_straddling_roster(), tail: Empty {} } } },
    f: fn(c) { c }
  )
}

fn floor_cost_debt_holds(name: String) -> Bool {
  any(xs: floor_cost_debt_roster(), predicate: fn(row) { row == name })
}

// THE POPULATION, ASKED RATHER THAN BELIEVED.
//
// This exists because the count in this file's prose rotted twice. The header once read
// "CARRYING NO IDENTITIES" against a populated roster; it later read 274, and the population
// block 225 + 51 = 276, against a roster that actually held 290 -- three figures, no two
// agreeing, none of them the roster's length. Nothing was ever wrong with the roster. Every
// wrong figure was prose copied beside it and never re-read, and correcting the number a third
// time would only reset the same decay.
//
// So the number is not stated in this file any more. DESIGN section 6 rules that a measurement is
// cited by NAMING THE PRODUCER THAT RE-DERIVES IT, and that if a measurement is worth re-deriving
// it is worth an entry point. These three functions are that entry point: they fold the same
// chunks `floor_cost_debt_roster` folds, so they cannot disagree with the roster the floor
// actually consults -- there is no second representation to drift.
//
// NO WITNESS PINS THESE AGAINST A LITERAL, and that is deliberate rather than an omission. A
// merge-blocking assertion that the population equals some number copied from this same tree is
// the change detector DESIGN section 5 forbids: automating the literal's update collapses it to
// `measure() == measure()`. What guards this roster is the monotone debt contract stated above --
// identity-grain membership, shrink-only, a stale row refusing -- and a size assertion would add
// nothing to it while breaking on every legitimate release.
//
// HOW TO ASK IT, so the entry point is reachable and not just declared:
//
//   gunbc run --source-root dag --source-root src/v2 \
//     --entry src/v2/workflow/floor_cost_debt.dag \
//     --function floor_cost_debt_population_report
//
// The run REFUSES, because the host maps a verdict to an exit code and only `ProcessExit` carries
// one -- and it prints the returned String in the refusal, which is the reading. That refusal is
// the correct behaviour rather than a workaround: a report is not a verdict, and this file
// deliberately does not mint one (see the paragraph above on why no witness pins the size).
fn floor_cost_debt_proven_population() -> Int {
  list_length(items: floor_cost_debt_proven_roster())
}

fn floor_cost_debt_censored_population() -> Int {
  list_length(items: floor_cost_debt_censored_roster())
}

fn floor_cost_debt_straddling_population() -> Int {
  list_length(items: floor_cost_debt_straddling_roster())
}

fn floor_cost_debt_population_report() -> String {
  join(
    [
      "floor_cost_debt population: proven=",
      to_string(floor_cost_debt_proven_population()),
      " censored=",
      to_string(floor_cost_debt_censored_population()),
      " straddling=",
      to_string(floor_cost_debt_straddling_population()),
      " total=",
      to_string(list_length(items: floor_cost_debt_roster())),
    ],
    ""
  )
}
