  Cons { head: "test.claim.alias_identity_across_unwrap_witness.a_direct_reference_to_the_alias_target_stays_structural", tail: Cons { head: "test.claim.alias_identity_across_unwrap_witness.a_qualified_alias_keeps_its_own_declaration_identity", tail: Cons { head: "test.claim.alias_identity_across_unwrap_witness.a_second_alias_still_emits_its_own_name_and_not_the_first", tail: Cons { head: "test.claim.alias_identity_across_unwrap_witness.the_bare_spelling_of_the_same_alias_is_unchanged", tail: Cons { head: "test.claim.alias_rhs_scalar_leaf_realization_witness.direct_scalar_element_realizes_natively", tail: Cons { head: "test.claim.alias_rhs_scalar_leaf_realization_witness.refinement_alias_element_realizes_natively", tail: Cons { head: "test.claim.alias_rhs_scalar_leaf_realization_witness.refinement_alias_whole_rhs_realizes_natively", tail: Cons { head: "test.claim.altra_contact_map_witness.w_differential_pairs_are_complete_in_the_ingested_map", tail: Cons { head: "test.claim.altra_contact_map_witness.w_ingested_contact_map_admits_at_declared_population", tail: Cons { head: "test.claim.arity_zero_import_refusal_witness.the_same_import_carrying_one_member_is_accepted", tail: Cons { head: "test.claim.belt_tick_receipt_home_witness.the_belt_member_bootstraps_its_own_receipts_directory", tail: Cons { head: "test.claim.belt_tick_receipt_home_witness.the_bootstrapped_directory_is_where_the_receipt_goes", tail: Cons { head: "test.claim.callable_candidate_ambiguity_witness.a_bare_call_whose_authority_the_author_named_still_resolves", tail: Cons { head: "test.claim.callable_candidate_ambiguity_witness.a_bare_call_whose_only_declarer_is_reached_transitively_refuses", tail: Cons { head: "test.claim.callable_candidate_ambiguity_witness.a_listed_import_does_not_exclude_a_transitively_reached_homonym", tail: Cons { head: "test.claim.callable_candidate_ambiguity_witness.a_module_calling_its_own_declaration_of_a_builtin_name_still_resolves", tail: Cons { head: "test.claim.callable_ca