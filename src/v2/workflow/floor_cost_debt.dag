  Cons { head: "test.claim.live_deploy.emit.twin_apply_serves_its_own_endpoint_and_not_productions", tail: Cons { head: "test.claim.live_deploy.emit.twin_belt_unit_carries_the_twins_spawn_root_and_not_productions", tail: Cons { head: "test.claim.live_deploy.emit.twin_retract_offs_its_own_endpoint_and_not_productions", tail: Cons { head: "test.claim.live_deploy.emit.witness_apply_emits_no_embedded_preflight_and_only_sudoers", tail: Cons { head: "test.claim.live_deploy.emit.witness_apply_provisions_attempt_state_root_owned", tail: Cons { head: "test.claim.live_deploy.emit.witness_apply_script_access_ready_not_deploy_access_poison", tail: Cons { head: "test.claim.live_deploy.emit.witness_apply_script_contains_systemd_and_tailscale", tail: Cons { head: "test.claim.live_deploy.emit.witness_apply_script_excludes_readback_curls", tail: Cons { head: "test.claim.live_deploy.emit.witness_apply_script_has_no_frozen_page", tail: Cons { head: "test.claim.live_deploy.emit.witness_apply_script_has_no_node_server", tail: Cons { head: "test.claim.live_deploy.emit.witness_apply_script_wires_memory_cap_deploy_consumer", tail: Cons { head: "test.claim.live_deploy.emit.witness_retract_attempt_state_root_refuses_when_nonempty", tail: Cons { head: "test.claim.live_deploy.emit.witness_retract_owned_process_removes_serve_service", tail: Cons { head: "test.claim.live_deploy.emit.witness_retract_preamble_acknowledges_shared_sudoers_install", tail: Cons { head: "test.claim.live_deploy.emit.witness_retract_script_owned_only", tail: Cons { head: "test.claim.live_deploy.emit.witness_tree_sync_restart_diagnoses_on_failure", tail: Cons { head: "test.claim.live_deploy.readiness.witness_accept_no_response_probe_fails_fast_not_hangs", tail: Cons { head: "test.claim.live_deploy.readiness.witness_bounded_poll_early_exit_on_grounded_read", tail: Cons { head: "test.claim.live_deploy.readiness.witness_bounded_poll_one_iteration_composes_probe_and_modeled_sleep", tail: Cons { head: "test.claim.live_deploy.r