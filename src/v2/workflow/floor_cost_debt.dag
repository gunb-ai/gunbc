fn floor_cost_debt_chunk_03() -> List<String> {
  Cons { head: "test.claim.live_deploy.readiness.witness_transport_get_probe_over_ssh_does_not_ground_mock_stdout", tail: Cons { head: "test.claim.live_deploy.running_release_identity_witness_test.witness_absent_identity_is_typed_absent_not_unparseable", tail: Cons { head: "test.claim.live_deploy.running_release_identity_witness_test.witness_body_without_release_identity_refuses", tail: Cons { head: "test.claim.live_deploy.running_release_identity_witness_test.witness_correct_artifacts_with_wrong_bundle_identity_refuses", tail: Cons { head: "test.claim.live_deploy.running_release_identity_witness_test.witness_correct_identity_with_one_stale_artifact_refuses", tail: Cons { head: "test.claim.live_deploy.running_release_identity_witness_test.witness_identity_round_trips_from_served_body", tail: Cons { head: "test.claim.live_deploy.running_release_identity_witness_test.witness_matching_release_and_surface_grounds", tail: Cons { head: "test.claim.live_deploy.running_release_identity_witness_test.witness_readiness_refuses_when_reported_revision_is_not_the_admitted_one", tail: Cons { head: "test.claim.live_deploy.running_release_identity_witness_test.witness_surface_projection_ignores_identity_members", tail: Cons { head: "test.claim.live_deploy.running_release_identity_witness_test.witness_third_candidate_still_sees_launched_revision", tail: Cons { head: "test.claim.operation_argv_corpus_witness.operation_argv_corpus_is_non_vacuous", tail: Cons { head: "test.claim.roadmap_authority.witness_altered_copy_of_declared_node_is_counted", tail: Cons { head: "test.claim.roadmap_authority.witness_ghost_node_outside_authority_is_counted", tail: Cons { head: "test.claim.roadmap_authority.witness_projection_is_active_only", tail: Cons { head: "test.claim.roadmap_authority.witness_rendered_nodes_are_declared_or_derived", tail: Cons { head: "test.claim.roadmap_belt_actuate_witness.dashboard_instance_dispatch_contract_keystone_holds", tail: Cons { head: "test.claim.roadmap_forecast_witness.witness_live_graph_gap_count_matches_refusal_rows", tail: Cons { head: "test.claim.roadmap_forecast_witness.witness_live_graph_refuses_with_located_counted_calibration_gaps", tail: Cons { head: "test.claim.roadmap_frontier_witness.witness_authority_daily_workspace_serializes", tail: Cons { head: "test.claim.roadmap_frontier_witness.witness_page_places_ready_node_in_ready_bucket", tail: Empty {} } } } } } } } } } } } } } } } } } } } }
