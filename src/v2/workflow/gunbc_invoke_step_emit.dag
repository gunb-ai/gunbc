module v2.workflow.gunbc_invoke_step_emit

import std.algebra { Empty, FreeMonoid }
import v2.compiler.emit_orchestration { orch_emit_pipeline, orch_shell_unquoted_path_ok }
import v2.extdeps.languages.bash_orchestration_emit { bash_orchestration_emit_medium }
import gunbc.merge_admission_produce { ci_repo_root_shell }
import gunbc.cli_invoke {
  InvocationWord,
  LiteralWord,
  RootRelativeWord,
  invocation_word_bare,
  gunbc_run_invocation_words,
  gunbc_bin_name,
  release_bin_rel_path
}
import v2.std.orchestration {
  Do,
  EnvBinding,
  FailFast,
  Pipeline,
  PipelineStep,
  Run
}
import v2.std.collection { Absent, Present }
import v2.std.decl_index { DeclFact, decl_facts }
import v2.std.diagnostic { Accepted, Rejected, None, Some }

// THE SINGLE ROOT for emitting a `gunbc run` workflow step. Before this module every
// such step was a per-site concat of a shell string (gunbc.cli_invoke gunbc_run_shell),
// forked from the typed argv the same invocation takes on the gunbc.WitnessBin.Run
// route -- two spellings of one fact, so a change to the invocation shape had to be
// made twice and could silently disagree. The invocation SHAPE is now one authority
// (gunbc.cli_invoke gunbc_run_invocation_words); this module is one of its two
// realizations (foreign-executor bash, via orchestration emit), the argv projection is
// the other. Realization sits peripheral to the interface (DESIGN section 3), so nothing
// here is a fact about what a gunbc run invocation IS.

// WHAT THIS ROOT DISSOLVED AND WHAT IT DID NOT, counted rather than implied, because a
// root that retires most of a marked population reads as having retired all of it.
// MEASURED on the emitted tree (grep dissolve-on over .github/workflows/*.yml), not on
// a brief count, AT THE TIME THIS PARAGRAPH WAS WRITTEN: NINE marked foreign-executor
// blocks were live, all in fleet-converge.yml -- the other emitted workflows,
// fleet-desired.yml and witnesses.yml, carried none. THE COUNTS BELOW ARE THAT SNAPSHOT,
// NOT RE-MEASURED: gunbc.ci_spec gunbc_ci_spark_grant_install_credential_prelude (PR
// #8777) and gunbc_ci_fleet_key_agent_prelude (below) both moved onto this root's
// gunbc_invoke_step_emit_pipeline since this paragraph was authored, so NINE/FOUR/FIVE no
// longer hold; re-grep dissolve-on over the emitted tree before citing a population here
// rather than trusting this sentence's arithmetic.
//   (1) ci_release_build_script, ci_release_bins_pack_script and
//       ci_release_bins_unpack_verify_script -- cargo and tar transports. Their leaves
//       are not bin invocations at all, so binding them needs typed cargo/archive
//       operations on host_effect_apply, which is their own stated trigger.
//   (2) gunbc_ci_fleet_key_agent_script -- DISSOLVED (2026-08-21): its Scaffold and
//       DissolutionCondition rows named host_effect_apply, which cannot express a
//       runner-local ephemeral target and so could never fire (see gunbc.ci_spec, at the
//       former site of gunbc_ci_fleet_key_agent_shell_emit_dissolution_trigger, for the
//       full record). It is now typed-orchestration-emitted through THIS module's
//       gunbc_invoke_step_emit_pipeline directly -- not through the gunbc-run-argv path
//       above, since it invokes no `gunbc run` -- via gunbc_ci_fleet_key_agent_prelude.
//       The refusal reasoning below (a secret must not cross onto a command line) still
//       holds and is unaffected: the secret still reaches the agent over a pipe inside a
//       Run leaf's command string, never as a rendered argv word.
//   (3) ci_native_cache_root_script -- ALREADY orchestration-emitted
//       (v2.workflow.ci_workflow_run_emit); its trigger is a typed toolchain probe on
//       host_effect_apply, so the marker survives the binding it already has.
// Beyond the emitted nine, this root also carries the eleven gunbc run call sites in
// gunbc.ci_spec whose emitted consumers were deleted by the CI cut, so a re-added
// workflow inherits the binding rather than re-minting the shell spelling.

data gunbc_invoke_step_root_var: String = "$ROOT"

// THE REFUSAL MUST NOT ITSELF BE AN INJECTION VECTOR, and this row exists because the
// first version of it was. That version spliced the offending word verbatim into the
// marker line -- "Refused word: dag/gunbc/evil.dag; rm -rf /". The marker is emitted into
// a GitHub Actions run: block, so bash would fail the unknown first token and then
// execute the attacker-chosen remainder as a SECOND COMMAND: a refusal that re-opens
// exactly the hole it refused, and strictly worse than admitting the word, because it
// wears the name of the wall. Caught by the discriminating RED
// (gunbc_invoke_word_wall_refuses_metacharacter_entry_holds), which is why that witness
// asserts the ABSENCE OF THE PAYLOAD and not merely the presence of the marker -- a
// marker-only assertion would have passed over this defect.
// THE FIX, and why it is construction rather than another check: the offending word never
// reaches shell context at all. It is projected through the SAME alphabet that judged it
// (orch_shell_unquoted_path_ok, per character), every refused character replaced by a
// fixed safe token, so the emitted bytes are inside the alphabet by construction and no
// input can widen them. The refusal stays located -- the sanitized shape identifies which
// word failed and where its bad characters were -- and stays countable, without any byte
// of untrusted input reaching a runner.
data gunbc_invoke_refused_char_token: String = "_"

fn gunbc_invoke_sanitize_at(word: String, i: Int, n: Int, acc: String) -> String {
  if i >= n {
    acc
  } else {
    let ch = char_at(s: word, pos: i)
    let safe = if orch_shell_unquoted_path_ok(path: ch) { ch } else { gunbc_invoke_refused_char_token }
    gunbc_invoke_sanitize_at(word: word, i: i + 1, n: n, acc: concat(acc, safe))
  }
}

fn gunbc_invoke_sanitize_word(word: String) -> String {
  gunbc_invoke_sanitize_at(word: word, i: 0, n: string_length(s: word), acc: "")
}

data gunbc_invoke_step_emit_refused_poison_prefix: String = "__GUNBC_INVOKE_EMIT_REFUSED__ v2.workflow.gunbc_invoke_step_emit refused to render a gunbc run step: an invocation word carried characters outside the emitter unquoted-word alphabet. This marker is not valid workflow shell, so the committed workflow drift gate goes red rather than a hand-spelled fallback masking the refusal (DESIGN section 5: refuse, never widen). The refused word is shown SANITIZED through that same alphabet, every refused character replaced by an underscore, so no byte of the refused input reaches a runner. Sanitized refused word: "

data gunbc_invoke_step_orch_refused_poison: String = "__GUNBC_INVOKE_EMIT_REFUSED__ v2.compiler.emit_orchestration rejected the gunbc run step pipeline; this marker is not valid workflow shell, so the committed workflow drift gate goes red rather than a hand-spelled fallback masking the refusal (DESIGN section 5: refuse, never widen)\n"

fn gunbc_invoke_word_unsafe_poison(word: String) -> String {
  concat(
    gunbc_invoke_step_emit_refused_poison_prefix,
    concat(gunbc_invoke_sanitize_word(word: word), "\n")
  )
}

// Fail-closed word wall. Every rendered word -- literal flag, entry path, function name,
// source root -- must lie inside the orchestration emitter's own unquoted-word alphabet
// (v2.compiler.emit_orchestration orch_shell_unquoted_path_ok, the SAME authority
// ToFile/ExitStatus already refuse against; not a second alphabet minted here). A word
// outside it could carry a shell metacharacter and open a second command, so it is
// refused at emit rather than quoted-and-hoped. Returns the first offending word, or ""
// when every word is safe.
fn gunbc_invoke_first_unsafe_word(words: List<InvocationWord>) -> String {
  fold(
    words,
    init: "",
    f: (acc, w) =>
      if acc != "" {
        acc
      } else {
        let spelling = invocation_word_bare(w: w)
        if orch_shell_unquoted_path_ok(path: spelling) { "" } else { spelling }
      }
  )
}

fn gunbc_invoke_root_relative_shell(rel: String) -> String {
  concat("\"", concat(gunbc_invoke_step_root_var, concat("/", concat(rel, "\""))))
}

fn gunbc_invoke_word_shell(w: InvocationWord) -> String {
  match w {
    LiteralWord { spelling: s } => s
    RootRelativeWord { rel: r } => gunbc_invoke_root_relative_shell(rel: r)
  }
}

fn gunbc_invoke_words_command(words: List<InvocationWord>) -> String {
  fold(
    words,
    init: gunbc_invoke_root_relative_shell(rel: release_bin_rel_path(bin_name: gunbc_bin_name)),
    f: (acc, w) => concat(acc, concat(" ", gunbc_invoke_word_shell(w: w)))
  )
}

fn gunbc_invoke_run(command: String) -> Run {
  Run {
    command: command,
    env: Empty,
    redirect: Absent,
    capture: Absent
  }
}

fn gunbc_invoke_do(command: String) -> PipelineStep {
  Do { run: gunbc_invoke_run(command: command) }
}

fn gunbc_invoke_root_stamp_step() -> PipelineStep {
  gunbc_invoke_do(command: concat("ROOT=", ci_repo_root_shell()))
}

fn gunbc_invoke_receipt_steps(receipt_rel: String?) -> List<PipelineStep> {
  match receipt_rel {
    Present { value: rel } =>
      [gunbc_invoke_do(command: concat("cat ", gunbc_invoke_root_relative_shell(rel: rel)))]
    Absent => []
  }
}

fn gunbc_invoke_run_with_env(command: String, env: FreeMonoid<EnvBinding>) -> Run {
  Run {
    command: command,
    env: env,
    redirect: Absent,
    capture: Absent
  }
}

// The rendered single command, fail-closed. Every caller that needs only the invocation
// line -- not the whole step -- reads this, so the word wall is crossed exactly once.
fn gunbc_run_command(
  source_roots: List<String>,
  entry: String,
  function: String,
  claim_run: Bool
) -> String {
  let words = gunbc_run_invocation_words(
    source_roots: source_roots,
    entry: entry,
    function: function,
    claim_run: claim_run
  )
  let unsafe_word = gunbc_invoke_first_unsafe_word(words: words)
  if unsafe_word != "" {
    gunbc_invoke_word_unsafe_poison(word: unsafe_word)
  } else if gunbc_run_step_target_resolves(source_roots: source_roots, entry: entry, function: function) == false {
    gunbc_invoke_unresolved_target_poison(entry: entry, function: function)
  } else {
    gunbc_invoke_words_command(words: words)
  }
}

// The composable root: the ordinary step as a Pipeline, so a caller with its own typed
// preamble (the converge-apply plan-hash check) prepends steps and emits ONCE through
// gunbc_invoke_step_emit_pipeline rather than concatenating two rendered strings.
fn gunbc_run_step_intent(
  prelude: List<PipelineStep>,
  source_roots: List<String>,
  entry: String,
  function: String,
  claim_run: Bool,
  receipt_rel: String?
) -> Pipeline {
  Pipeline {
    steps: concat(
      concat(
        prelude,
        [
          gunbc_invoke_root_stamp_step(),
          gunbc_invoke_do(
            command: gunbc_run_command(
              source_roots: source_roots,
              entry: entry,
              function: function,
              claim_run: claim_run
            )
          )
        ]
      ),
      gunbc_invoke_receipt_steps(receipt_rel: receipt_rel)
    ),
    on_failure: FailFast
  }
}

fn gunbc_invoke_step_emit_pipeline(p: Pipeline) -> String {
  match orch_emit_pipeline(p: p, medium: bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: d } =>
      match d {
        None => source.carried
        Some { diagnostics: _ } => gunbc_invoke_step_orch_refused_poison
      }
    Rejected { diagnostics: _ } => gunbc_invoke_step_orch_refused_poison
  }
}

// The whole-step root every ordinary call site uses: ROOT stamp, one gunbc run
// invocation, optional receipt cat.
// ═══════════════════════════════════════════════════════════════════════════════════════
// THE TARGET RESOLUTION WALL. A `gunbc run` step names an entry FILE and a FUNCTION in it,
// and nothing established that either existed. gunbc#8377 landed two steps whose entry
// files had been renamed out from under them -- `spark/grant_install.dag` and
// `spark/serving_durability.dag`, both from one hand-resolved merge conflict -- and they
// emitted cleanly into the committed `fleet-converge.yml`, where they sat naming modules
// that cannot answer. The emitter was happy to emit them. That is why the wall belongs
// HERE and not in a test beside it: a test catches the bad step after it exists, this
// makes it unproducible.
//
// It sits at `gunbc_run_command`, beside the unsafe-word wall, and that placement is the
// finding rather than a detail. The first version of this wall guarded the two entry points
// I happened to be editing -- `gunbc_run_step_script` and `..._with_prelude` -- and MISSED
// `gunbc_run_invocation_script_with_env`, the third sibling, which reaches
// `gunbc_run_command` directly rather than through `gunbc_run_step_intent` and carries the
// heal-dispatch call site. Review 54495 caught it. A wall covering two of three emitters is
// not a wall: a rename under `ci_heal_dispatch` would have emitted cleanly with the exact
// failure mode gunbc#8377 exhibited, while the carrier claimed such a target was
// unproducible. The repair is not to add a third guard -- that is one refusal contract
// spelled three times, and the next sibling emitter added would miss it again. It is to put
// the refusal where the entry/function pair becomes an argv AT ALL, which is the single
// crossing this function's own header already names for the word wall.
//
// It rides the poison-marker mechanism this module already established for the unsafe-word
// wall rather than minting a second refusal shape. The marker is not valid workflow shell,
// so a refused target cannot become a runnable step and the generated-artifact drift check
// goes red rather than a hand-spelled fallback masking it.
//
// RUNG, stated honestly because the enrolment is NOT what it looks like: this is
// *mechanically preventable*, not structurally guaranteed. It refuses at ARTIFACT
// GENERATION, which is the only sanctioned route to a matching committed workflow -- hand
// edits to the emitted YAML are reverted -- so in practice it fires on the machine of
// whoever introduces the bad entry, at the moment they introduce it, which is strictly
// earlier than any test could. It is NOT currently gated in CI: the generated-artifact
// drift gate is unenrolled since the floor cut, which DESIGN records. NEXT-RUNG TRIGGER is
// that gate's re-add, already a queued item there. An earlier draft of this wall claimed it
// "runs in --required-regen"; that was FALSE -- --required-regen adjudicates the stage0
// Rust mirror and emits no workflow YAML -- and it is recorded here because a wall
// advertising an enrolment it does not have is the inert-mechanism lie, worse than the
// honest gap it conceals.
//
// The roots are the CALLER'S `source_roots`, not a set minted here. The emitter has no
// business knowing which directories a particular spec's entries live in, and reading the
// same roots the invocation itself will run under means the wall resolves against exactly
// the population the step resolves against -- not an approximation of it.
data gunbc_invoke_unresolved_target_poison_prefix: String = "__GUNBC_INVOKE_EMIT_REFUSED__ v2.workflow.gunbc_invoke_step_emit refused to render a gunbc run step: its target does not resolve. The named entry file declares no such function, or the entry file itself is absent from the declared source roots. This marker is not valid workflow shell, so the committed workflow drift check goes red rather than a step shipping that names a module which cannot answer (DESIGN section 5: refuse, never widen). Unresolved target: "

fn gunbc_run_step_target_resolves(
  source_roots: List<String>,
  entry: String,
  function: String
) -> Bool {
  fold(
    decl_facts(pool_roots: source_roots),
    init: false,
    f: (found, fact) => found || (fact.rel_path == entry && fact.name == function)
  )
}

// BOTH FAILURE SHAPES REFUSE THROUGH ONE ARM, and that is deliberate rather than lazy. A
// missing FILE and a present file MISSING THE SYMBOL are the same fact to a consumer --
// this pair names nothing runnable -- and they have the same remedy, which is to name a
// pair that exists. What the two shapes DO get separately is discriminating evidence: the
// witness plants one of each, because a wall that only caught the absent file would have
// passed gunbc#8377's durability defect, where the file existed and the function did not.
// The refused pair is rendered through the same sanitizer the unsafe-word wall uses, so no
// byte of an unresolvable target reaches a runner even in the refusal.
fn gunbc_invoke_unresolved_target_poison(entry: String, function: String) -> String {
  concat(
    gunbc_invoke_unresolved_target_poison_prefix,
    concat(
      gunbc_invoke_sanitize_word(word: entry),
      concat(" :: ", concat(gunbc_invoke_sanitize_word(word: function), "\n"))
    )
  )
}

fn gunbc_run_step_script(
  source_roots: List<String>,
  entry: String,
  function: String,
  claim_run: Bool,
  receipt_rel: String?
) -> String {
  gunbc_invoke_step_emit_pipeline(
    p: gunbc_run_step_intent(
      prelude: [],
      source_roots: source_roots,
      entry: entry,
      function: function,
      claim_run: claim_run,
      receipt_rel: receipt_rel
    )
  )
}

// Same root with a typed preamble in front of the ROOT stamp.
fn gunbc_run_step_script_with_prelude(
  prelude: List<PipelineStep>,
  source_roots: List<String>,
  entry: String,
  function: String,
  claim_run: Bool,
  receipt_rel: String?
) -> String {
  gunbc_invoke_step_emit_pipeline(
    p: gunbc_run_step_intent(
      prelude: prelude,
      source_roots: source_roots,
      entry: entry,
      function: function,
      claim_run: claim_run,
      receipt_rel: receipt_rel
    )
  )
}

// Same root for a call site that carries env bindings on the invocation itself and
// inherits ROOT from the step it is composed into (the heal dispatch wire). The bindings
// are the orchestration EnvBinding carrier, not a hand-spelled "NAME=value " prefix.
fn gunbc_run_invocation_script_with_env(
  env: FreeMonoid<EnvBinding>,
  source_roots: List<String>,
  entry: String,
  function: String,
  claim_run: Bool
) -> String {
  gunbc_invoke_step_emit_pipeline(
    p: Pipeline {
      steps: [
        Do {
          run: gunbc_invoke_run_with_env(
            command: gunbc_run_command(
              source_roots: source_roots,
              entry: entry,
              function: function,
              claim_run: claim_run
            ),
            env: env
          )
        }
      ],
      on_failure: FailFast
    }
  )
}
