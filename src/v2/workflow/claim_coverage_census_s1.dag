module v2.workflow.claim_coverage_census_s1

import std.types { String, Bool, List, Int, Set }
import std.optional { Optional, Absent, Present }
import std.algebra { is_empty }
import v2.workflow.witness_admission { path_contains_substring }

// THE DISCOVERED UNIVERSE, CLASSIFIED (manager ruling 2026-10-19, Charter 4, plus the two scope
// additions: the ungroundable drop members, and jolly-boar-495's StaleEnrolled standing).
//
// ONE universe is enrolled: S1, every discovered test fn, at IDENTITY grain. Every other carrier
// (the floor_single_claim_fill_debt list, witness_exclusion_frontier, the rung_drop populations,
// explicit_witness_admission, frozen_path_deferrals, floor_expected_red) is a CLASSIFIER over
// subsets of S1 — never a peer source. A classifier row whose identity is not in S1 gets the typed
// standing `StaleEnrolled`: naming a claim discovery does not find is a standing the census carries
// and prints, never a silent miss and never a widening of S1 to accept the name.
//
// GRAIN IS EXPLICIT AND NEVER COMPARED ACROSS. A File-grain classifier row reaches identities only
// through `expand_file` — the discovered rows of that file, the same discovery that produced S1 —
// so file-to-identity is exact and total, never a string match. A value that parses as neither a
// path nor an identity is a typed `UngroundedDropMember` row and a finding, never a coercion into
// whichever grain would pass. Whatever such values exist on main are findings the exit-1 arm prints --
// repairing one drop's population to a grounded grain is a separate per-drop fix, made only where
// its meaning is unambiguous, and NEVER by restating the string here.
//
// EXECUTED-BY IS DERIVED, NEVER HAND-AUTHORED (correction approved 2026-10-19). An identity is
// executed only by a bound target producer that NAMES it — emitted workflow job, to its bound
// target, to the producer's own entry/function fields (the same fields `gunbc test` dispatches on).
// The fleet's identity-grain `gunbc run --entry E --function F` steps name what they execute, but
// `F` is not required to carry the `test` marker: a step whose function discovery does not enrol
// executes NOTHING THIS CENSUS ENROLS, and calling it covered would be the census inventing an
// enrollment to close its own gap. So what the live entry prints at this head is the floor's own
// finding: the run steps execute ordinary fns, the self-host / v2-native-cli bound producers are
// whole-program builds that name no claim identity, and the universe is Uncovered except where a
// grounded cover row reaches it.

// One discovered claim, spelled every way it is needed: `identity` is the carrier spelling
// (`witness_identity_qualified_name` — the declaring module header plus "." plus the function, which
// is how every classifier on the cover side spells a claim), `entry` is the repo path discovery
// walked it from, which is what a File-grain classifier row names, and `function` is the bare
// declaration name, which is what a file+function carrier (a ScheduleWitnessEntry) names beside its
// file. Keeping all three on the row is what lets the join be identity-to-identity, the expansion be
// path-to-identity, and a file+function carrier select exactly one identity — the fold never
// converts a path into a module name by string surgery, and never covers a whole file where the
// carrier admitted one function.
type ClaimRow {
  identity: String
  entry: String
  function: String
}

// HOW a file member selects files. The carriers disagree and BOTH relations are declared authorities:
// a rung_drop population names whole paths (equality), while a witness_exclusion_frontier pattern is
// matched by CONTAINMENT. The containment itself is NOT reimplemented here: `matches_member` calls
// `path_contains_substring` in `v2.workflow.witness_admission`, which is the primitive
// `witness_row_excluded_from_discovery` (same module) applies when it asks whether a row's entry contains
// an exclusion pattern. One rule, one body — if the frontier ever changes its matching (anchoring, a path
// prefix, normalization), the census classifies frontier rows the same way discovery excludes them,
// because it is the same call (DESIGN §3, §6b). Carrying the RELATION on the arm is still necessary: it
// keeps the census from silently unifying two relations into one equality, which would make every frontier
// pattern read as ungrounded (no entry equals a bare stem) or every drop path read as grounded by accident.
type ClaimMemberMatch
  = ExactMemberMatch
  | SubstringMemberMatch

// THE GRAIN IS THE ARM, NOT A FIELD. (review 82804: a tag plus fields only that tag reads is a sum type
// written as a record — `match_` and `function` were unread on the identity side, so every builder had to
// fill a dummy and an identity row could be written demanding substring matching.) An identity member
// carries the carrier spelling `module_path + "." + function` and nothing else, because an identity joins
// by exact spelling and no relation or narrowing can be declared for it. A file member carries the path
// (or the pattern the carrier declares), the relation that selects files, and — only where the carrier
// itself named a function beside its file — the function it named: a ScheduleWitnessEntry schedules one
// entry AND one function, and a census that dropped the function and covered the whole file would credit
// the lane with claims it never scheduled. `Absent` means the carrier's authority stops at the member it
// declared, and it is never filled in by inference.
type ClassifierMember
  = IdentityMember { identity: String }
  // A member the carrier declared at NO grain -- a rung_drop population is `List<String>`, so the
  // declaration carries a text and no grain to go with it (review 82804, same defect one level down: forcing
  // such a member into the file arm would refuse the values that legitimately name a claim, exactly as the
  // deleted spelling heuristic refused the ones that legitimately named a file). It is joined against BOTH
  // populations the census already holds -- the discovered identities and the discovered file paths, by
  // equality in each case -- and refused only when it grounds in neither. That is two joins, not a string
  // test: nothing asks the text what it looks like, and the answer comes from the population either way.
  | DeclaredMember { text: String }
  | FileMember { path: String, match_: ClaimMemberMatch, function: Optional<String> }

// WHAT A ROW IS FOR, as a closed coproduct (review 82845, DESIGN §5: "stronger than catching a wrong
// state is making it unwritable -- correctness by construction, not validation"). `cover: Bool` was the
// defect this PR had already fixed once for the grain: the flag decided which standing arm a row reached
// (`GroundedCover` vs `GroundedEnrollment`) and which rows count toward the uncovered population, yet every
// builder set it by hand -- and a wrong `true` silently credits claims with coverage and fires no refusal.
// A row's role is now declared, and each carrier's builder fixes it, so the value is not threaded through
// call sites at all.
type ClassifierRole
  = CoverRole
  | EnrollmentRole

// One classifier row: which carrier claims this member, at the grain its arm declares, in the role its
// constructor fixed. `carrier` names the declaration the row was read from, so every printed finding is
// located and the RED arm — delete a covered claim from its drop, the census must name it — lands on a file
// the reader can open.
type ClassifierRow {
  carrier: String
  member: ClassifierMember
  role: ClassifierRole
}

// The verdict for one classifier row after joining it against S1.
type ClassifierStanding
  = StaleEnrolled { row: ClassifierRow }
  // A FileMember whose expansion finds no discovered identity: the row LOOKS populated while covering
  // nothing. Typed refusal, and a finding: every ungroundable drop-population value lives here, refused
  // through the join (no discovered file and no discovered identity bears it) rather than through any test
  // of how the string looks. Their number is this instrument's output --
  // `gunbc test //gunbc/instruments:claim-coverage-census` -- and is never restated here (DESIGN §6: name
  // the instrument, never transcribe its output, because a transcribed number rots unreachably).
  | UngroundedDropMember { row: ClassifierRow }
  // Joined to at least one S1 identity; `covers` is that expansion.
  | GroundedCover { row: ClassifierRow, covers: List<String> }
  | GroundedEnrollment { row: ClassifierRow, covers: List<String> }

// The census as data: the universe, the derived executed set, and every row's verdict. The live
// entry builds it from the live discovery walk; everything above it is pure, so the classification
// is checkable against a fixture (the controlled positive control with a known covered set).
type S1Census {
  universe: List<String>
  rows: List<ClaimRow>
  executed: List<String>
  stands: List<ClassifierStanding>
}

// The member's declared text, for locating a finding on the receipt: the identity as spelled, or the
// file path/pattern as spelled. A file row that also named a function says so, because that row covers a
// different claim set than the same path alone and the reader must be able to tell them apart.
fn classifier_member_text(row: ClassifierRow) -> String {
  match row.member {
    IdentityMember { identity: identity } => identity
    DeclaredMember { text: text } => text
    FileMember { path: path, match_: _, function: named } =>
      match named {
        Present { value: function } => concat(concat(path, "#"), function)
        Absent => path
      }
  }
}

// Universe membership is the join everywhere; one map build so no call site scans.
fn universe_set(universe: List<String>) -> Set<String> {
  fold(universe, init: empty_set(), f: fn(acc, id) { set_insert(set: acc, item: id) })
}

// THE ONE EXPANSION. A FileMember reaches identities only here: the discovered rows its declared relation
// selects, narrowed where the carrier named a function, at the identity spelling carriers use. An empty
// answer is returned as empty — the caller must type it `UngroundedDropMember`, never read it as
// covered-nothing.
//
// NO SECOND FILTER against the universe, and no index rebuilt per row (review 82804, DESIGN §2/§6): every
// identity here comes out of `rows`, which is the population the universe index is built from, so a filter
// on it could only ever be true — redundant work presented as a check. And an identity-grain row can reach
// this function at all only through the arm that carries a path, so the grain cannot be confused here.
fn expand_file(rows: List<ClaimRow>, member_path: String, relation: ClaimMemberMatch, named: Optional<String>) -> List<String> {
  rows
    |> filter(r => matches_member(relation: relation, member: member_path, path: r.entry)
      && narrows_to(named: named, claim: r))
    |> map(r => r.identity)
}

// Where the carrier named a function beside its file, the expansion narrows to that one claim; where it
// did not, the row's authority is the member it declared and every discovered identity of what the relation
// selects is reached. Narrowing is by the discovery's own function name, so no string splitting of an
// identity is involved.
fn narrows_to(named: Optional<String>, claim: ClaimRow) -> Bool {
  match named {
    Present { value: name } => claim.function == name
    Absent => true
  }
}

// The declared relation, applied to one file path. NEVER widened: an exact member never matches by
// containment, a substring member never matches by anything but containment.
fn matches_member(relation: ClaimMemberMatch, member: String, path: String) -> Bool {
  match relation {
    ExactMemberMatch => member == path
    SubstringMemberMatch => path_contains_substring(path: path, sub: member)
  }
}

// Classify one row against S1, GROUNDED BY THE JOIN AND BY NOTHING ELSE. A File-grain row is grounded
// by its expansion through the SAME discovery that built S1, applied with its declared match relation:
// a member selecting no discovered file is `UngroundedDropMember`. An Identity-grain row is grounded by
// the universe lookup: an identity discovery does not hold is `StaleEnrolled`. Nothing in either branch
// inspects the member's SPELLING, which is what makes the two grains honest -- the grain is the declared
// field and the answer comes from the population, so a member text that is legal in both spellings
// cannot be misjudged. (The repo does contain modules whose names contain `.dag` -- `extdeps.languages.dag.emit`,
// `gunbc.dag_grammar_fork_census` -- so a spelling test would refuse correctly grounded rows and invent
// findings; DESIGN §4: in a closed system a heuristic is never necessary, and the richer source -- the
// discovered rows and the universe -- is right here.)
//
// UNSPELLABLE DROP MEMBERS STILL REFUSE, through the join: a drop-population value that is neither a file
// discovery holds nor anything else reaches an empty expansion and is typed `UngroundedDropMember`, printed
// with its drop and its declared text. A SUBSTRING member (the frontier's own form) is refused the same way when it
// selects no discovered file: a pattern that matches nothing covers nothing, and printing that as grounded
// would be the stale-present-tense lie DESIGN 3 names, in census form.
fn classify_row(universe: Set<String>, rows: List<ClaimRow>, row: ClassifierRow) -> ClassifierStanding {
  match row.member {
    IdentityMember { identity: identity } =>
      if set_contains(set: universe, item: identity) {
        grounded(row: row, covers: [identity])
      } else {
        StaleEnrolled { row: row }
      }
    DeclaredMember { text: text } =>
      if set_contains(set: universe, item: text) {
        grounded(row: row, covers: [text])
      } else {
        let covers = expand_file(
          rows: rows,
          member_path: text,
          relation: ExactMemberMatch,
          named: Absent
        )
        if is_empty(xs: covers) {
          UngroundedDropMember { row: row }
        } else {
          grounded(row: row, covers: covers)
        }
      }
    FileMember { path: member_path, match_: relation, function: named } => {
      let covers = expand_file(
        rows: rows,
        member_path: member_path,
        relation: relation,
        named: named
      )
      if is_empty(xs: covers) {
        UngroundedDropMember { row: row }
      } else {
        grounded(row: row, covers: covers)
      }
    }
  }
}

// The role decides the standing, by `match` -- no branch on a flag, and no standing reachable by a value
// that was passed by hand.
fn grounded(row: ClassifierRow, covers: List<String>) -> ClassifierStanding {
  match row.role {
    CoverRole => GroundedCover { row: row, covers: covers }
    EnrollmentRole => GroundedEnrollment { row: row, covers: covers }
  }
}

// THE JOIN, AT LINEAR COST PER ROW (review 82804, DESIGN §6: a proven cost-shape defect is always fixed).
// The universe SET is built ONCE here and handed to every row; before, each row rebuilt it, so classifying
// the carriers cost O(rows x |S1|) and the "one map build so no call site scans" comment was false. A SET,
// not a `Map<String, Bool>` whose value was always `true` (review 82943): the dummy value made
// `map_insert(key, false)` a writable state that reads as absent -- a member that is not a member -- and
// `std.types::Set` with the `empty_set` / `set_insert` / `set_contains` PRIMITIVES is the corpus's own
// membership authority (`std.graph`'s visited set, which calls them with no import -- they are declared in
// the primitive table, not exported by a module), so the hand-rolled `Present => true / Absent => false`
// predicate dissolves instead of being centralised.
fn classify_rows(universe: List<String>, rows: List<ClaimRow>, classifier_rows: List<ClassifierRow>) -> List<ClassifierStanding> {
  let universe_members = universe_set(universe: universe)
  map(
    classifier_rows,
    row => classify_row(universe: universe_members, rows: rows, row: row)
  )
}

// The derived executed set: a bound producer executes exactly the identities it NAMES, so the
// executed set is the names the required jobs' producers carry, kept only where discovery enrolled
// them. Nothing here is typed by hand: an entry/function pair a producer does not carry contributes
// nothing, and a name discovery does not enrol executes no ENROLLED claim (that is what makes a run
// step over an ordinary fn report honestly instead of closing the census's gap).
fn derive_executed(rows: List<ClaimRow>, produced: List<String>) -> List<String> {
  let enrolled = universe_set(universe: map(rows, r => r.identity))
  filter(produced, name => set_contains(set: enrolled, item: name))
}

// Every S1 identity neither executed by a bound producer nor reached by any grounded COVER row:
// the exit-1 arm's report of the floor.
fn s1_uncovered(census: S1Census) -> List<String> {
  let executed = universe_set(universe: census.executed)
  let covered = fold(
    census.stands,
    init: empty_set(),
    f: fn(acc, standing) {
      match standing {
        GroundedCover { row: _, covers: covers } =>
          fold(covers, init: acc, f: fn(inner, id) { set_insert(set: inner, item: id) })
        _ => acc
      }
    }
  )
  filter(
    census.universe,
    id => !set_contains(set: executed, item: id) && !set_contains(set: covered, item: id)
  )
}

// Rows standing StaleEnrolled, located at their carrier (jolly-boar-495's first consumer is the
// fill-debt list; the same arm catches floor_expected_red and the frozen deferrals).
fn s1_stale_rows(census: S1Census) -> List<ClassifierRow> {
  census.stands |> flat_map(standing => match standing {
    StaleEnrolled { row: row } => [row]
    _ => []
  })
}

fn s1_ungrounded_rows(census: S1Census) -> List<ClassifierRow> {
  census.stands |> flat_map(standing => match standing {
    UngroundedDropMember { row: row } => [row]
    _ => []
  })
}

// THE RECEIPT: the verdict lines, each located. Lengths are never emitted — the lines themselves are the
// population. NO HEAD HERE: the census is a pure function of the tree (warm-wolf-570), because which
// revision the facts were read at is a LOCATOR on the evidence, not an input to the verdict -- and a
// census that took it could not run where a revision cannot be asked (the host-native route has no git).
// Whoever runs the census stamps the locator beside its output, with `s1_stamp_head` below.
fn s1_census_lines(census: S1Census) -> List<String> {
  let stale_lines = map(
    s1_stale_rows(census: census),
    row => concat(concat(concat("STALE-ENROLLED ", row.carrier), " "), classifier_member_text(row: row))
  )
  let ungrounded_lines = map(
    s1_ungrounded_rows(census: census),
    row => concat(concat(concat("UNGROUNDED-DROP-MEMBER ", row.carrier), " "), classifier_member_text(row: row))
  )
  let uncovered_lines = map(
    s1_uncovered(census: census),
    id => concat("UNCOVERED ", id)
  )
  concat(concat(stale_lines, ungrounded_lines), uncovered_lines)
}

// THE LOCATOR, APPLIED BESIDE THE OUTPUT BY WHOEVER RUNS THE CENSUS. Separate from the census on purpose:
// the census's verdicts must not depend on a revision read, and the native runner that cannot ask one must
// still be able to run the census. Not optional and not a placeholder -- the live entry calls this and the
// witness asserts both halves: the census's own lines carry no locator, and stamping prepends exactly one.
fn s1_stamp_head(lines: List<String>, head: String) -> List<String> {
  concat(["S1-CENSUS head:" + head], lines)
}

// A REQUIRED-JOB LABEL WHOSE BINDING CANNOT CARRY THE WORD "EXECUTED", as a located defect rather than a
// note. An unbound label means the required job runs something no producer binds; a doubled binding means
// two producers claim one label. Neither is a claim finding — no claim is being named — but both make the
// executed-by set a lie if it is still credited, and the earlier shape let exactly that happen: the defect
// travelled in `notes: List<String>`, which the policy never counted, so `s1_block` returned `S1Held` and
// `executed_of` summed the identities of EVERY binding that matched the label. A label with two producers
// therefore reported the union of two unrelated producers' claims as executed by the job. This is a standing
// defect now, and `executed_of` credits identities only through a label with exactly one binding.
type RequiredJobLabelDefect
  = LabelUnbound { label: String }
  | LabelAmbiguous { label: String }

// THE COMPOSITION'S ANSWER IN TWO CHANNELS: the census (with the located findings that are not
// standings), or the causes of an input nobody could read. The channels are disjoint by construction --
// nothing downstream of a missing input is ever reported as a clean census, which is what keeps the
// exit-2 arm from reading as a green run. The type lives with the pure policy so a witness can construct
// both arms without touching the fold's filesystem, acquisition or roster dependencies.
//
// The label defects are a TYPED LIST, not prose: `notes: List<String>` let a caller pass a string that
// named no defect at all, and the policy had nothing to match on. Each defect is one of two named causes
// carrying the located label, so the receipt text is DERIVED from the case (`required_job_label_line`) and a
// consumer that cares which of the two it is can match instead of grepping its own output.
type S1Composition
  = S1Composed { census: S1Census, label_defects: List<RequiredJobLabelDefect> }
  | S1InputsUnread { causes: List<String> }

// THE RECEIPT LINE A LABEL DEFECT PRINTS, derived from the case rather than passed in beside it. The
// wording is the one the witnesses and the instrument already print, so no evidence trail is broken by the
// typing; what changed is that the wording can no longer be supplied independently of the defect.
fn required_job_label_line(defect: RequiredJobLabelDefect) -> String {
  match defect {
    LabelUnbound { label: label } =>
      concat("REQUIRED-JOB LABEL UNBOUND ", concat(label, " (no producer binds it: nothing it runs is attributable)"))
    LabelAmbiguous { label: label } =>
      concat("REQUIRED-JOB LABEL AMBIGUOUS ", concat(label, " (more than one producer binds it: the executed-by set would be their union)"))
  }
}

// THE BLOCK THE LIVE ENTRY PRINTS AND THE EXIT IT ANSWERS, computed as PURE DATA over an injected
// composition (warm-wolf-570: exit 1 lists one typed, located row per claim that is neither run nor
// covered by a drop; exit 2 means an input could not be read). The head is a PARAMETER, not a read, so
// the three arms are reachable from a witness with a fixture locator: a test can assert the exit of a
// composition it constructed instead of only of whatever the checkout happens to look like.
//
// The two channels never mix: a composition that could not read prints only its causes and answers 2 --
// it is not a census that failed, it is a census that cannot answer, and reporting a claim failure would
// read as if the population had been decided. A composed census answers 1 exactly when a finding is
// printed: a stale enrollment, an ungroundable drop member, or an uncovered discovered claim. Zero is
// answered only when the fold found nothing to complain about, which -- on the live tree, as the
// population -- it will not: the findings ARE the result.
// THE OUTCOME, AS A DECLARED THREE-ARM SUM (review 82914, DESIGN §5 and §6b; ctrl's hand-rolled-sum
// rule). It was `exit_code: Int` chosen from three `data ... : Int` constants with a `reason` beside them,
// which made the illegal states writable -- `exit_code: 7`, or a HELD block carrying a reason -- and left
// every consumer comparing integers instead of matching. The third defect of this shape in this PR, after
// the grain (review 82804) and the cover/enrollment flag (review 82845). `S1Held` has no reason field
// because a held census has nothing to explain, and an unread outcome has no claim population to print.
type S1Standing
  = S1Held
  | S1DidNotHold { reason: String }
  | S1Unread { reason: String }

type S1Block {
  lines: List<String>
  standing: S1Standing
}

// THE PROCESS PROTOCOL, NOT THE CENSUS'S STATE. These are the numbers a process exits with, and this module
// holds the CONSTANTS ONLY. An earlier revision also held `s1_process_exit_code`, which turned an S1Standing
// into a number here; once the composed exit derived its number from the DECISION over BOTH standings
// (`gunbc.claim_coverage_census_live` claim_coverage_composed_exit_code), that function was a second,
// competing site for the same protocol mapping with no caller -- so it is deleted, not kept as a convenience.
// The reader of this file should not be able to produce an exit code from one census alone.
data s1_exit_code_did_not_hold: Int = 1
data s1_exit_code_unread: Int = 2

fn s1_block(s1: S1Composition) -> S1Block {
  match s1 {
    S1InputsUnread { causes: causes } => S1Block {
      lines: map(causes, cause => concat("S1-CENSUS INPUT UNREAD ", cause)),
      standing: S1Unread {
        reason: "claim-coverage-census: the discovered universe could not be read (causes listed above); no claim population was decided"
      }
    }
    S1Composed { census: census, label_defects: label_defects } => {
      let lines = concat(
        map(label_defects, defect => required_job_label_line(defect: defect)),
        s1_census_lines(census: census)
      )
      let findings = count(s1_stale_rows(census: census))
        + count(s1_ungrounded_rows(census: census))
        + count(s1_uncovered(census: census))
        + count(label_defects)
      if findings == 0 {
        S1Block { lines: lines, standing: S1Held }
      } else {
        S1Block {
          lines: lines,
          standing: S1DidNotHold {
            reason: "claim-coverage-census: the discovered universe did not hold -- a discovered test claim is executed by no required job and covered by no drop, or a carrier enrolled an identity discovery does not hold, or a drop population member grounds in no path and no identity, or a required-job label reaches the census with no single binding behind it (each is listed above, located)"
          }
        }
      }
    }
  }
}
