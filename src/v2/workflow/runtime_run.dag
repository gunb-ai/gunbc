module v2.workflow.runtime_run


type RuntimeRunReceipt {
  node: v2.std.node.Node
  result: v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue>
}

type RuntimeRunLog {
  entries: List<RuntimeRunReceipt>
}

type RuntimeRunState {
  log: RuntimeRunLog
  scheduled: List<v2.std.node.Node>
}

type RuntimeRunResult
  = RuntimeRunComplete {
      log: RuntimeRunLog
      scheduled: List<v2.std.node.Node>
    }
  | RuntimeRunBlocked {
      evidence: v2.workflow.scheduler.SchedulerBlockedEvidence
      log: RuntimeRunLog
      scheduled: List<v2.std.node.Node>
      remaining: List<v2.std.node.Node>
    }

fn runtime_run_log_empty() -> RuntimeRunLog {
  RuntimeRunLog { entries: [] }
}

fn runtime_run_append_receipt(
  log: RuntimeRunLog,
  node: v2.std.node.Node,
  result: v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue>
) -> RuntimeRunLog {
  RuntimeRunLog {
    entries: v2.std.algebra.list_snoc_item(
      xs: log.entries,
      item: RuntimeRunReceipt { node: node, result: result }
    )
  }
}

fn runtime_run_eval_node(
  state: RuntimeRunState,
  node: v2.std.node.Node,
  tree: v2.compiler.inferred_tree.InferredTree,
  context: v2.compiler.eval.EvalContext
) -> RuntimeRunState {
  let result = v2.compiler.eval.eval_with_context(
    tree: tree,
    context: context,
    inputs: v2.compiler.eval.inputs_root_only(root: node)
  )
  RuntimeRunState {
    log: runtime_run_append_receipt(log: state.log, node: node, result: result),
    scheduled: v2.workflow.scheduler.scheduler_append_node_once(nodes: state.scheduled, node: node)
  }
}

fn runtime_run_step_from_frontier(
  frontier: v2.workflow.scheduler.RunnableFrontier<v2.std.node.Node>,
  state: RuntimeRunState,
  tree: v2.compiler.inferred_tree.InferredTree,
  context: v2.compiler.eval.EvalContext
) -> RuntimeRunState {
  fold(frontier.ready, init: state, f: fn(acc, node) {
    runtime_run_eval_node(state: acc, node: node, tree: tree, context: context)
  })
}

fn runtime_run_step_state(
  nodes: List<v2.std.node.Node>,
  dependencies: List<v2.std.dependency.DependencyView>,
  tree: v2.compiler.inferred_tree.InferredTree,
  context: v2.compiler.eval.EvalContext,
  state: RuntimeRunState
) -> RuntimeRunState {
  let frontier = v2.workflow.scheduler.runnable_frontier_from_dependencies(
    nodes: nodes,
    dependencies: dependencies,
    scheduled: state.scheduled
  )
  if v2.std.algebra.non_empty(xs: frontier.ready) {
    runtime_run_step_from_frontier(
      frontier: frontier,
      state: state,
      tree: tree,
      context: context
    )
  } else {
    state
  }
}

fn runtime_run_result_from_state(
  nodes: List<v2.std.node.Node>,
  dependencies: List<v2.std.dependency.DependencyView>,
  state: RuntimeRunState
) -> RuntimeRunResult {
  let remaining = v2.workflow.scheduler.scheduler_remaining_nodes(nodes: nodes, scheduled: state.scheduled)
  if v2.std.algebra.is_empty(xs: remaining) {
    RuntimeRunComplete {
      log: state.log,
      scheduled: state.scheduled
    }
  } else {
    RuntimeRunBlocked {
      evidence: v2.workflow.scheduler.scheduler_blocked_evidence(),
      log: state.log,
      scheduled: state.scheduled,
      remaining: remaining
    }
  }
}

fn runtime_run(
  nodes: List<v2.std.node.Node>,
  dependencies: List<v2.std.dependency.DependencyView>,
  tree: v2.compiler.inferred_tree.InferredTree,
  context: v2.compiler.eval.EvalContext
) -> RuntimeRunResult {
  let state = fold(
    nodes,
    init: RuntimeRunState {
      log: runtime_run_log_empty(),
      scheduled: []
    },
    f: fn(acc, _) {
      runtime_run_step_state(
        nodes: nodes,
        dependencies: dependencies,
        tree: tree,
        context: context,
        state: acc
      )
    }
  )
  runtime_run_result_from_state(nodes: nodes, dependencies: dependencies, state: state)
}
