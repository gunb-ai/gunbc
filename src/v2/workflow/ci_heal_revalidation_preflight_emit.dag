module v2.workflow.ci_heal_revalidation_preflight_emit

import v2.workflow.orchestration_bash_emit_support { orch_bash_emit_pipeline }
import v2.std.orchestration {
  Do,
  Exit,
  ExprCmdSubst,
  ExprLit,
  FailFast,
  If,
  Let,
  Not,
  Pipeline,
  PipelineStep,
  Run,
  StrEq,
  StrNonempty
}
import extdeps.git { shape_git_rev_parse_head_args }

data ci_heal_expected_head_input_expr: String = "\"${{ inputs.expected_healed_sha }}\""

data ci_heal_revalidation_preflight_refused_poison: String = "__GUNBC_ORCH_EMIT_REFUSED__ heal revalidation exact-head preflight emission was rejected; this marker is not valid workflow shell, so generated CI drift refuses rather than widening\n"

data ci_heal_revalidation_preflight_note: String = "Heal revalidation dispatches on the healed commit SHA (ref and expected_healed_sha), so github.sha and checkout should already name the immutable subject. This preflight still observes git.Core.HeadCommit through extdeps.git's argv shape and compares byte-for-byte before any witness can count — a second binding that refuses if checkout ever diverges from expected_healed_sha. An absent input is an ordinary manual dispatch and does not claim heal revalidation. Control flow is v2.std.orchestration intent and bash is only the GitHub Actions foreign-executor realization."

fn ci_heal_revalidation_diag(text: String) -> PipelineStep {
  Do {
    run: Run {
      command: concat("echo \"", concat(text, "\"")),
      env: [],
      redirect: Absent,
      capture: Absent
    }
  }
}

fn ci_heal_revalidation_mismatch_arm() -> Pipeline {
  Pipeline {
    steps: [
      ci_heal_revalidation_diag(text: "::error::heal revalidation refused: checkout head $ACTUAL_HEAD does not equal expected healed head $EXPECTED_HEALED_SHA"),
      Exit { status: "1" }
    ],
    on_failure: FailFast
  }
}

fn ci_heal_revalidation_expected_arm() -> Pipeline {
  Pipeline {
    steps: [
      Let {
        name: "ACTUAL_HEAD",
        value: ExprCmdSubst {
          callee: "git",
          args: shape_git_rev_parse_head_args()
        }
      },
      If {
        cond: Not {
          inner: StrEq {
            lhs: "\"$ACTUAL_HEAD\"",
            rhs: "\"$EXPECTED_HEALED_SHA\""
          }
        },
        then_: ci_heal_revalidation_mismatch_arm(),
        else_: Absent
      },
      ci_heal_revalidation_diag(text: "heal revalidation preflight: checkout names expected healed head $EXPECTED_HEALED_SHA")
    ],
    on_failure: FailFast
  }
}

fn ci_heal_revalidation_preflight_intent() -> Pipeline {
  Pipeline {
    steps: [
      Let {
        name: "EXPECTED_HEALED_SHA",
        value: ExprLit { spelling: ci_heal_expected_head_input_expr }
      },
      If {
        cond: StrNonempty { operand: "\"$EXPECTED_HEALED_SHA\"" },
        then_: ci_heal_revalidation_expected_arm(),
        else_: Absent
      }
    ],
    on_failure: FailFast
  }
}

fn ci_heal_revalidation_preflight_script() -> String {
  orch_bash_emit_pipeline(
    p: ci_heal_revalidation_preflight_intent(),
    refused_poison: ci_heal_revalidation_preflight_refused_poison
  )
}
