module v2.workflow.ci_heal_revalidation_preflight_emit


data ci_heal_expected_head_input_expr: String = "\"${{ inputs.expected_healed_sha }}\""
data ci_heal_run_subject_head_expr: String = "\"${{ github.sha }}\""

data ci_heal_revalidation_preflight_refused_poison: String = "__GUNBC_ORCH_EMIT_REFUSED__ heal revalidation exact-head preflight emission was rejected; this marker is not valid workflow shell, so generated CI drift refuses rather than widening\n"

data ci_heal_revalidation_preflight_note: String = "The workflow_dispatch ref is necessarily a moving branch/tag pointer, while expected_healed_sha is the immutable subject. GitHub resolves that ref into github.sha, the workflow run/check subject. Every ordinary checkout selects expected_healed_sha when present, then this preflight requires BOTH github.sha and the observed git.Core.HeadCommit to equal expected_healed_sha byte-for-byte before any witness can count. An absent input is an ordinary manual dispatch and does not claim heal revalidation. If the branch advances before GitHub resolves the dispatch, the run-subject comparison refuses; if checkout diverges afterward, the checkout comparison refuses. Neither race can let witnesses executed on one tree authorize the check subject of another. Control flow is v2.std.orchestration intent and bash is only the GitHub Actions foreign-executor realization."

fn ci_heal_revalidation_diag(text: String) -> v2.std.orchestration.PipelineStep {
  v2.std.orchestration.Do {
    run: v2.std.orchestration.Run {
      command: concat("echo \"", concat(text, "\"")),
      env: Empty,
      redirect: Absent,
      capture: Absent
    }
  }
}

fn ci_heal_revalidation_checkout_mismatch_arm() -> v2.std.orchestration.Pipeline {
  v2.std.orchestration.Pipeline {
    steps: [
      ci_heal_revalidation_diag(text: "::error::heal revalidation refused: checkout head $ACTUAL_HEAD does not equal expected healed head $EXPECTED_HEALED_SHA"),
      v2.std.orchestration.Exit { status: "1" }
    ],
    on_failure: v2.std.orchestration.FailFast
  }
}

fn ci_heal_revalidation_run_subject_mismatch_arm() -> v2.std.orchestration.Pipeline {
  v2.std.orchestration.Pipeline {
    steps: [
      ci_heal_revalidation_diag(text: "::error::heal revalidation refused: workflow run subject $RUN_SUBJECT_HEAD does not equal expected healed head $EXPECTED_HEALED_SHA"),
      v2.std.orchestration.Exit { status: "1" }
    ],
    on_failure: v2.std.orchestration.FailFast
  }
}

fn ci_heal_revalidation_expected_arm() -> v2.std.orchestration.Pipeline {
  v2.std.orchestration.Pipeline {
    steps: [
      v2.std.orchestration.Let {
        name: "ACTUAL_HEAD",
        value: v2.std.orchestration.ExprCmdSubst {
          callee: "git",
          args: extdeps.git.shape_git_rev_parse_head_args()
        }
      },
      v2.std.orchestration.If {
        cond: v2.std.orchestration.Not {
          inner: v2.std.orchestration.StrEq {
            lhs: "\"$RUN_SUBJECT_HEAD\"",
            rhs: "\"$EXPECTED_HEALED_SHA\""
          }
        },
        then_: ci_heal_revalidation_run_subject_mismatch_arm(),
        else_: Absent
      },
      v2.std.orchestration.If {
        cond: v2.std.orchestration.Not {
          inner: v2.std.orchestration.StrEq {
            lhs: "\"$ACTUAL_HEAD\"",
            rhs: "\"$EXPECTED_HEALED_SHA\""
          }
        },
        then_: ci_heal_revalidation_checkout_mismatch_arm(),
        else_: Absent
      },
      ci_heal_revalidation_diag(text: "heal revalidation preflight: checkout names expected healed head $EXPECTED_HEALED_SHA")
    ],
    on_failure: v2.std.orchestration.FailFast
  }
}

fn ci_heal_revalidation_preflight_intent() -> v2.std.orchestration.Pipeline {
  v2.std.orchestration.Pipeline {
    steps: [
      v2.std.orchestration.Let {
        name: "EXPECTED_HEALED_SHA",
        value: v2.std.orchestration.ExprLit { spelling: ci_heal_expected_head_input_expr }
      },
      v2.std.orchestration.Let {
        name: "RUN_SUBJECT_HEAD",
        value: v2.std.orchestration.ExprLit { spelling: ci_heal_run_subject_head_expr }
      },
      v2.std.orchestration.If {
        cond: v2.std.orchestration.StrNonempty { operand: "\"$EXPECTED_HEALED_SHA\"" },
        then_: ci_heal_revalidation_expected_arm(),
        else_: Absent
      }
    ],
    on_failure: v2.std.orchestration.FailFast
  }
}

fn ci_heal_revalidation_preflight_script() -> String {
  v2.workflow.orchestration_bash_emit_support.orch_bash_emit_pipeline(
    p: ci_heal_revalidation_preflight_intent(),
    refused_poison: ci_heal_revalidation_preflight_refused_poison
  )
}
