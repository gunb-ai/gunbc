module v2.workflow.body_lowering_retention_census


// WHY THIS IS NOT "COUNT THE WRAPPER-RETAINED DIAGNOSTICS".
//
// body_lowering_reason_wrapper_retained_emitted is ONE reason standing over
// SEVERAL distinct absent producers: the fold's own note says an out-of-scope
// emitted identity with no registered producer lands wrapper-retained, and
// "an emitted identity" is a family, not an instance. A lane pointed at the
// reason string would repair whichever family it met first and report the
// count moving, which reads as progress on the population and is progress on
// one member of it.
//
// So the partition key here is the EMITTED PRODUCTION IDENTITY the fold
// refused to lower, joined with the node's own shape. That is the grain at
// which a missing producer is a thing someone can go and write.

type RetainedProduction {
  emitted_production: String
  node_shape: String
  child_count: Int
  occurrence: String
}

// THREE STATES, NOT A BOOL. "The census was written", "no census was
// applicable because this run produced no retained population", and "the
// census could not be written" are different facts with different remedies,
// and a v2.std.logic.Bool spelled them as two. The middle one is the common case on every
// non-refused path, so a true there was reporting a write that never
// happened -- harmless as a gate today and a lie the moment anything reads
// the field for what it says. Splitting it is the repository's own
// state-space-conflation rule applied to a field this lane authored.
type CensusOutcome
  = CensusWritten
  | CensusNotApplicable
  | CensusWriteFailed

fn census_outcome_admits(outcome: CensusOutcome) -> v2.std.logic.Bool {
  match outcome {
    CensusWritten => true
    CensusNotApplicable => true
    CensusWriteFailed => false
  }
}

type RetentionFamily {
  key: String
  count: Int
  example_child_count: Int
}

fn connective_label(c: v2.std.node.Connective) -> String {
  match c {
    Atom { identity: identity } => concat("Atom:", symbol_lexeme(sym: identity))
    Conj => "Conj"
    Disj => "Disj"
    Arrow => "Arrow"
    Cardinality => "Cardinality"
    Instantiation => "Instantiation"
  }
}

fn behavior_label(b: v2.std.node.Behavior) -> String {
  match b {
    Value => "Value"
    Transform => "Transform"
    Branch => "Branch"
    Loop => "Loop"
    Bind => "Bind"
    Match => "Match"
  }
}

fn node_shape_label(kind: v2.std.node.NodeKind) -> String {
  match kind {
    TypeNode { connective: c } => concat("Type/", connective_label(c: c))
    ComputationNode { behavior: b } => concat("Computation/", behavior_label(b: b))
  }
}

// An absent production identity is REPORTED, never dropped and never folded
// into a neighbouring family. A retained node the reader cannot name is a
// different deficit from a retained node whose producer is simply unwritten,
// and collapsing them would hide the first inside the second.
fn emitted_production_label(node: v2.std.node.Node) -> String {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: sym } => symbol_lexeme(sym: sym)
    Absent => "<no production identity on the retained node>"
  }
}

fn occurrence_label(occurrence: v2.std.node.NodeOccurrenceId) -> String {
  match occurrence {
    SyntheticOccurrence => "synthetic"
    MintedOccurrence { id: _ } => "minted"
  }
}

fn retained_production_of(node: v2.std.node.Node) -> RetainedProduction {
  RetainedProduction {
    emitted_production: emitted_production_label(node: node),
    node_shape: node_shape_label(kind: node.kind),
    child_count: length(xs: node.children),
    occurrence: occurrence_label(occurrence: node.occurrence_id)
  }
}

fn retained_production_key(observation: RetainedProduction) -> String {
  concat(
    observation.emitted_production,
    concat("  [", concat(observation.node_shape, "]"))
  )
}

// The diagnostic's locus is the ONLY channel by which the retained node
// reaches a consumer, and only one of its three arms carries a node at all.
// The other two are reported as unattributable rather than skipped: a census
// that silently drops the loci it cannot read would understate the population
// it exists to size.
fn retained_node_optional(d: v2.std.diagnostic.Diagnostic) -> v2.std.optional.Optional<v2.std.node.Node> {
  match d.at {
    NodeLocus { anchor: anchor } => v2.std.optional.Present { value: anchor.at }
    Textual { file: _, extent: _ } => v2.std.optional.Absent
    PortLocus { anchor: _ } => v2.std.optional.Absent
  }
}

fn retention_family_holds(families: std.types.List<RetentionFamily>, key: String) -> v2.std.logic.Bool {
  fold_list(
    xs: families,
    empty: false,
    cons: fn(found, row) { found || (row.key == key) }
  )
}

fn retention_family_bump(
  families: std.types.List<RetentionFamily>,
  observation: RetainedProduction
) -> std.types.List<RetentionFamily> {
  let key = retained_production_key(observation: observation)
  if retention_family_holds(families: families, key: key) {
    fold_list(
      xs: families,
      empty: Empty,
      cons: fn(acc, row) {
        list_snoc_item(
          xs: acc,
          item: if row.key == key {
            RetentionFamily {
              key: row.key,
              count: row.count + 1,
              example_child_count: row.example_child_count
            }
          } else {
            row
          }
        )
      }
    )
  } else {
    list_snoc_item(
      xs: families,
      item: RetentionFamily {
        key: key,
        count: 1,
        example_child_count: observation.child_count
      }
    )
  }
}

fn retention_families_total(families: std.types.List<RetentionFamily>) -> Int {
  fold_list(xs: families, empty: 0, cons: fn(total, row) { total + row.count })
}

fn diagnostic_is_wrapper_retained(d: v2.std.diagnostic.Diagnostic) -> v2.std.logic.Bool {
  d.reason == ^body_lowering_reason_wrapper_retained_emitted
}

fn retention_census_step(
  families: std.types.List<RetentionFamily>,
  d: v2.std.diagnostic.Diagnostic
) -> std.types.List<RetentionFamily> {
  if diagnostic_is_wrapper_retained(d: d) {
    match retained_node_optional(d: d) {
      Present { value: node } =>
        retention_family_bump(
          families: families,
          observation: retained_production_of(node: node)
        )
      Absent =>
        retention_family_bump(
          families: families,
          observation: RetainedProduction {
            emitted_production: "<retention reported at a locus carrying no node>",
            node_shape: "<unattributable>",
            child_count: 0,
            occurrence: "<none>"
          }
        )
    }
  } else {
    families
  }
}

fn retention_census(ds: v2.std.diagnostic.NonEmptyDiagnostics) -> std.types.List<RetentionFamily> {
  fold_list(
    xs: ds.tail,
    empty: retention_census_step(families: Empty, d: ds.head),
    cons: fn(acc, d) { retention_census_step(families: acc, d: d) }
  )
}

fn retention_family_line(row: RetentionFamily) -> String {
  concat(
    "\n  ",
    concat(
      to_string(row.count),
      concat(
        "  ",
        concat(
          row.key,
          concat("  (example arity ", concat(to_string(row.example_child_count), ")"))
        )
      )
    )
  )
}

fn retention_census_render(families: std.types.List<RetentionFamily>) -> String {
  concat(
    "body-lowering wrapper-retained census\n\nfamilies: ",
    concat(
      to_string(length(xs: families)),
      concat(
        "\nobservations: ",
        concat(
          to_string(retention_families_total(families: families)),
          concat(
            "\n",
            concat(
              fold_list(
                xs: families,
                empty: "",
                cons: fn(text, row) {
                  concat(text, retention_family_line(row: row))
                }
              ),
              "\n"
            )
          )
        )
      )
    )
  )
}
