module v2.workflow.body_lowering_retention_census


// WHY THIS IS NOT "COUNT THE WRAPPER-RETAINED DIAGNOSTICS".
//
// body_lowering_reason_wrapper_retained_emitted is ONE reason standing over
// SEVERAL distinct absent producers: the fold's own note says an out-of-scope
// emitted identity with no registered producer lands wrapper-retained, and
// "an emitted identity" is a family, not an instance. A lane pointed at the
// reason string would repair whichever family it met first and report the
// count moving, which reads as progress on the population and is progress on
// one member of it.
//
// So the partition key here is the EMITTED PRODUCTION IDENTITY the fold
// refused to lower, joined with the node's own shape. That is the grain at
// which a missing producer is a thing someone can go and write.

type RetainedProduction {
  emitted_production: String
  node_shape: String
  child_count: Int
  occurrence: String
}

// THREE STATES, NOT A BOOL. "The evidence artifact was written", "no such
// artifact was applicable because this run produced no diagnostics to write
// one from", and "it could not be written" are different facts with different
// remedies,
// and a Bool spelled them as two. The middle one is the common case on every
// non-refused path, so a true there was reporting a write that never
// happened -- harmless as a gate today and a lie the moment anything reads
// the field for what it says. Splitting it is the repository's own
// state-space-conflation rule applied to a field this lane authored. The
// vocabulary is named for the boundary rather than for the retention census
// because boundary 4 now writes two evidence artifacts -- the census and the
// diagnostic ledger below -- and one outcome type per artifact would be two
// names for one concept.
type B4EvidenceOutcome
  = EvidenceWritten
  | EvidenceNotApplicable
  | EvidenceWriteFailed

fn b4_evidence_outcome_admits(outcome: B4EvidenceOutcome) -> Bool {
  match outcome {
    EvidenceWritten => true
    EvidenceNotApplicable => true
    EvidenceWriteFailed => false
  }
}

type RetentionFamily {
  key: String
  count: Int
  example_child_count: Int
}

fn connective_label(c: v2.std.node.Connective) -> String {
  match c {
    v2.std.node.Atom { identity: identity } => concat("Atom:", v2.std.compilers.lexing.symbol_lexeme(sym: identity))
    v2.std.node.Conj => "Conj"
    v2.std.node.Disj => "Disj"
    v2.std.node.Arrow => "Arrow"
    v2.std.node.Cardinality => "Cardinality"
    v2.std.node.Instantiation => "Instantiation"
  }
}

fn behavior_label(b: v2.std.node.Behavior) -> String {
  match b {
    v2.std.node.Value => "Value"
    v2.std.node.Transform => "Transform"
    v2.std.node.Branch => "Branch"
    v2.std.node.Loop => "Loop"
    v2.std.node.Bind => "Bind"
    v2.std.node.Match => "Match"
  }
}

fn node_shape_label(kind: v2.std.node.NodeKind) -> String {
  match kind {
    v2.std.node.TypeNode { connective: c } => concat("Type/", connective_label(c: c))
    v2.std.node.ComputationNode { behavior: b } => concat("Computation/", behavior_label(b: b))
  }
}

// An absent production identity is REPORTED, never dropped and never folded
// into a neighbouring family. A retained node the reader cannot name is a
// different deficit from a retained node whose producer is simply unwritten,
// and collapsing them would hide the first inside the second.
fn emitted_production_label(node: v2.std.node.Node) -> String {
  match v2.extdeps.languages.dag.parse_production_emitted_identity_optional(node: node) {
    v2.std.optional.Present { value: sym } => v2.std.compilers.lexing.symbol_lexeme(sym: sym)
    v2.std.optional.Absent => "<no production identity on the retained node>"
  }
}

fn occurrence_label(occurrence: v2.std.node.NodeOccurrenceId) -> String {
  match occurrence {
    v2.std.node.SyntheticOccurrence => "synthetic"
    v2.std.node.MintedOccurrence { id: _ } => "minted"
  }
}

fn retained_production_of(node: v2.std.node.Node) -> RetainedProduction {
  RetainedProduction {
    emitted_production: emitted_production_label(node: node),
    node_shape: node_shape_label(kind: node.kind),
    child_count: v2.std.algebra.length(xs: node.children),
    occurrence: occurrence_label(occurrence: node.occurrence_id)
  }
}

fn retained_production_key(observation: RetainedProduction) -> String {
  concat(
    observation.emitted_production,
    concat("  [", concat(observation.node_shape, "]"))
  )
}

// The diagnostic's locus is the ONLY channel by which the retained node
// reaches a consumer, and only one of its three arms carries a node at all.
// The other two are reported as unattributable rather than skipped: a census
// that silently drops the loci it cannot read would understate the population
// it exists to size.
fn retained_node_optional(d: v2.std.diagnostic.Diagnostic) -> v2.std.optional.Optional<v2.std.node.Node> {
  match d.at {
    v2.std.diagnostic.NodeLocus { anchor: anchor } => v2.std.optional.Present { value: anchor.at }
    v2.std.diagnostic.Textual { file: _, extent: _ } => v2.std.optional.Absent
    v2.std.diagnostic.PortLocus { anchor: _ } => v2.std.optional.Absent
  }
}

fn retention_family_holds(families: List<RetentionFamily>, key: String) -> Bool {
  v2.std.algebra.fold_list(
    xs: families,
    empty: false,
    cons: fn(found, row) { found || (row.key == key) }
  )
}

fn retention_family_bump(
  families: List<RetentionFamily>,
  observation: RetainedProduction
) -> List<RetentionFamily> {
  let key = retained_production_key(observation: observation)
  if retention_family_holds(families: families, key: key) {
    v2.std.algebra.fold_list(
      xs: families,
      empty: v2.std.algebra.Empty,
      cons: fn(acc, row) {
        v2.std.algebra.list_snoc_item(
          xs: acc,
          item: if row.key == key {
            RetentionFamily {
              key: row.key,
              count: row.count + 1,
              example_child_count: row.example_child_count
            }
          } else {
            row
          }
        )
      }
    )
  } else {
    v2.std.algebra.list_snoc_item(
      xs: families,
      item: RetentionFamily {
        key: key,
        count: 1,
        example_child_count: observation.child_count
      }
    )
  }
}

fn retention_families_total(families: List<RetentionFamily>) -> Int {
  v2.std.algebra.fold_list(xs: families, empty: 0, cons: fn(total, row) { total + row.count })
}

fn diagnostic_is_wrapper_retained(d: v2.std.diagnostic.Diagnostic) -> Bool {
  d.reason == ^body_lowering_reason_wrapper_retained_emitted
}

fn retention_census_step(
  families: List<RetentionFamily>,
  d: v2.std.diagnostic.Diagnostic
) -> List<RetentionFamily> {
  if diagnostic_is_wrapper_retained(d: d) {
    match retained_node_optional(d: d) {
      v2.std.optional.Present { value: node } =>
        retention_family_bump(
          families: families,
          observation: retained_production_of(node: node)
        )
      v2.std.optional.Absent =>
        retention_family_bump(
          families: families,
          observation: RetainedProduction {
            emitted_production: "<retention reported at a locus carrying no node>",
            node_shape: "<unattributable>",
            child_count: 0,
            occurrence: "<none>"
          }
        )
    }
  } else {
    families
  }
}

fn retention_census(ds: v2.std.diagnostic.NonEmptyDiagnostics) -> List<RetentionFamily> {
  v2.std.algebra.fold_list(
    xs: ds.tail,
    empty: retention_census_step(families: v2.std.algebra.Empty, d: ds.head),
    cons: fn(acc, d) { retention_census_step(families: acc, d: d) }
  )
}

fn retention_family_line(row: RetentionFamily) -> String {
  concat(
    "\n  ",
    concat(
      to_string(row.count),
      concat(
        "  ",
        concat(
          row.key,
          concat("  (example arity ", concat(to_string(row.example_child_count), ")"))
        )
      )
    )
  )
}

fn retention_census_render(families: List<RetentionFamily>) -> String {
  concat(
    "body-lowering wrapper-retained census\n\nfamilies: ",
    concat(
      to_string(v2.std.algebra.length(xs: families)),
      concat(
        "\nobservations: ",
        concat(
          to_string(retention_families_total(families: families)),
          concat(
            "\n",
            concat(
              v2.std.algebra.fold_list(
                xs: families,
                empty: "",
                cons: fn(text, row) {
                  concat(text, retention_family_line(row: row))
                }
              ),
              "\n"
            )
          )
        )
      )
    )
  )
}

// THE LEDGER IS NOT A SECOND CENSUS, and the difference is which question it
// answers. The census above partitions ONE reason -- wrapper-retained -- at
// the grain of the missing producer, because that is the grain at which
// somebody can go and write one. The ledger answers a question the receipt
// asks and cannot answer at all: WHICH diagnostic is the one that rejected.
//
// docs/probes/b4_causal_versus_carried_2026-08-21.md established by reading
// the producers' return constructors that 39 of boundary 4's 40 diagnostics
// are produced on Accepted paths and merely carried into the Rejected list by
// rejected_with_pending, so the door is held by exactly one. That reading
// names the REASON of the door-holder. It cannot name the SUBJECT, because
// the reason symbol is shared by sixteen producer sites and the receipt
// renders only a tally of reasons.
//
// So this renders every diagnostic the refusal carries, in the order it
// carries them, each attributed through the same locus channel and the same
// production-identity vocabulary the census already uses. It is the minimum
// that makes a door-holder addressable, and it reuses the attribution rather
// than re-deriving it, so there is one place that decides how a Node is
// named in this transaction's artifacts.
//
// WHAT IT DOES NOT DO: it does not decide which line is causal. That
// distinction is destroyed at rejected_with_pending, which the probe document
// records as needing a change to the shared carriers rather than a
// hand-maintained list of "carried" reasons here -- validation standing where
// construction was available. The ledger makes the population readable; a
// reader still joins it against the producers to say which line closed the
// door.
// WHY THE LEXEMES AND NOT JUST THE PRODUCTION IDENTITY. The production
// identity names the SHAPE the emitter refused (dag_surface_let_expr); it
// does not name WHICH one, and a Node carries no module and no file. On the
// compiler's own closure that left the door-holder identified as "a let
// somewhere in 107 modules", which is not an addressable subject. The atoms
// in the refused subtree are the only channel the node itself carries that
// distinguishes one specimen from another, and they spell the source form
// closely enough to find it by grep.
//
// BOUNDED, and the bound is reported rather than silently applied. A refused
// subtree can be arbitrarily large; a ledger that truncated without saying so
// would let a reader believe they had seen the whole form.
type AtomLexemeAccumulator {
  taken: Int
  total: Int
  text: String
}

data diagnostic_ledger_atom_cap: Int = 48

fn atom_lexeme_optional(node: v2.std.node.Node) -> v2.std.optional.Optional<String> {
  match node.kind {
    v2.std.node.TypeNode { connective: c } =>
      match c {
        v2.std.node.Atom { identity: identity } => v2.std.optional.Present { value: v2.std.compilers.lexing.symbol_lexeme(sym: identity) }
        v2.std.node.Conj => v2.std.optional.Absent
        v2.std.node.Disj => v2.std.optional.Absent
        v2.std.node.Arrow => v2.std.optional.Absent
        v2.std.node.Cardinality => v2.std.optional.Absent
        v2.std.node.Instantiation => v2.std.optional.Absent
      }
    v2.std.node.ComputationNode { behavior: _ } => v2.std.optional.Absent
  }
}

fn atom_lexeme_step(
  acc: AtomLexemeAccumulator,
  node: v2.std.node.Node
) -> AtomLexemeAccumulator {
  match atom_lexeme_optional(node: node) {
    v2.std.optional.Absent => acc
    v2.std.optional.Present { value: lexeme } =>
      if acc.taken < diagnostic_ledger_atom_cap {
        AtomLexemeAccumulator {
          taken: acc.taken + 1,
          total: acc.total + 1,
          text: concat(acc.text, concat(" ", lexeme))
        }
      } else {
        AtomLexemeAccumulator {
          taken: acc.taken,
          total: acc.total + 1,
          text: acc.text
        }
      }
  }
}

fn diagnostic_subtree_atoms(node: v2.std.node.Node) -> String {
  let acc = v2.std.algebra.fold_list(
    xs: v2.std.node.node_subtree_nodes(root: node),
    empty: AtomLexemeAccumulator { taken: 0, total: 0, text: "" },
    cons: fn(a, n) { atom_lexeme_step(acc: a, node: n) }
  )
  if acc.total > acc.taken {
    concat(
      acc.text,
      concat(
        "  ... (",
        concat(
          to_string(acc.total - acc.taken),
          " further atom(s) not shown)"
        )
      )
    )
  } else {
    acc.text
  }
}

fn diagnostic_extent_label(extent: v2.std.diagnostic.Extent) -> String {
  match extent {
    v2.std.diagnostic.WholeFile => "whole-file"
    v2.std.diagnostic.ByteRange { start: start, end: end } =>
      concat("bytes ", concat(to_string(start), concat("..", to_string(end))))
  }
}

fn diagnostic_attribution(d: v2.std.diagnostic.Diagnostic) -> String {
  match d.at {
    v2.std.diagnostic.NodeLocus { anchor: anchor } =>
      concat(
        retained_production_key(observation: retained_production_of(node: anchor.at)),
        concat(
          "  arity ",
          concat(
            to_string(v2.std.algebra.length(xs: anchor.at.children)),
            concat(
              "  occurrence ",
              concat(
                occurrence_label(occurrence: anchor.at.occurrence_id),
                concat(
                  "\n      atoms:",
                  diagnostic_subtree_atoms(node: anchor.at)
                )
              )
            )
          )
        )
      )
    v2.std.diagnostic.Textual { file: file, extent: extent } =>
      concat(
        "textual ",
        concat(v2.std.compilers.lexing.symbol_lexeme(sym: file), concat("  ", diagnostic_extent_label(extent: extent)))
      )
    v2.std.diagnostic.PortLocus { anchor: anchor } => concat("port ", v2.std.compilers.lexing.symbol_lexeme(sym: anchor.at))
  }
}

fn diagnostic_ledger_line(index: Int, d: v2.std.diagnostic.Diagnostic) -> String {
  concat(
    "\n  ",
    concat(
      to_string(index),
      concat(
        "  ",
        concat(
          v2.std.compilers.lexing.symbol_lexeme(sym: d.reason),
          concat("\n      ", diagnostic_attribution(d: d))
        )
      )
    )
  )
}

type DiagnosticLedgerAccumulator {
  next_index: Int
  text: String
}

fn diagnostic_ledger_step(
  acc: DiagnosticLedgerAccumulator,
  d: v2.std.diagnostic.Diagnostic
) -> DiagnosticLedgerAccumulator {
  DiagnosticLedgerAccumulator {
    next_index: acc.next_index + 1,
    text: concat(acc.text, diagnostic_ledger_line(index: acc.next_index, d: d))
  }
}

fn diagnostic_ledger_render(ds: v2.std.diagnostic.NonEmptyDiagnostics) -> String {
  let folded = v2.std.algebra.fold_list(
    xs: ds.tail,
    empty: diagnostic_ledger_step(
      acc: DiagnosticLedgerAccumulator { next_index: 1, text: "" },
      d: ds.head
    ),
    cons: fn(acc, d) { diagnostic_ledger_step(acc: acc, d: d) }
  )
  concat(
    "boundary 4 diagnostic ledger (carriage order, one line per diagnostic)\n\ndiagnostics: ",
    concat(to_string(folded.next_index - 1), concat("\n", concat(folded.text, "\n")))
  )
}
