fn floor_wet_route_identities() -> List<String> {
  floor_wet_route_roster() |> map(row => row.identity)
}

// Membership at identity grain, the shape `floor_cost_debt_holds` established: the site
// disposition asks this once per offered identity.
fn floor_wet_route_holds(name: String) -> Bool {
  wet_route_list_contains(xs: floor_wet_route_identities(), needle: name)
}
