module v2.workflow.self_host_realized_comparison_gate


data srfc_gate_test_entry: String = "src/v2/workflow/self_host_realized_comparison_claims.dag"
data srfc_staleness_gate_witness: String = "self_host_realized_comparison_staleness_gate_holds"
data srfc_provenance_witness: String = "self_host_realized_comparison_reads_real_bytes_both_sides_holds"

fn srfc_emit_realized() -> Bool {
  run_witness_bin_program(
    invoke: realized_comparison_invoke(),
    prereqs: [],
    args: realized_comparison_args()
  )
}

func self_host_realized_comparison_reads_real_bytes_gate_holds() -> Bool {
  srfc_emit_realized()
    && run_gunbc_claims(
      source_roots: witness_layer_roots,
      claims: [ClaimRun { entry: srfc_gate_test_entry, function: srfc_provenance_witness }]
    )
}

func self_host_realized_comparison_staleness_gate_holds() -> Bool {
  run_witness_bin_program(
    invoke: realized_comparison_invoke(),
    prereqs: [],
    args: realized_comparison_verify_args()
  )
}

func run_self_host_realized_comparison_gate() -> Bool {
  self_host_realized_comparison_reads_real_bytes_gate_holds()
    && self_host_realized_comparison_staleness_gate_holds()
}

func self_host_realized_comparison_gate_passes() -> Bool {
  run_self_host_realized_comparison_gate()
}
