module v2.workflow.floor_exhaustiveness_allowlist

import std.types { List }
import v2.std.text { String }

// THE BOUNDED, FROZEN, SHRINK-ONLY ALLOW-LIST FOR THE FLOOR-EXHAUSTIVENESS-REFUSAL WALL.
//
// The exhaustiveness wall (ExhaustivenessUnknown refuses a match whose constructor-roster lookup
// is blocked) fires on the whole corpus. SIX frozen src/v2 match sites cannot have their scrutinee
// type named at the constructor-roster lookup, so the wall would refuse the v2 self-host bootstrap
// for a reason no one can fix at the site. The operator authorized a bounded exception:
//
//   gunbc.design_ruling::floor_exhaustiveness_refusal_a_plus_c_exceptions_frozen_2026_11_23
//   ("regarding 16895 - yeah A+C is fine as long as no more exceptions are introduced in the future")
//
// THIS MODULE IS THE SOLE AUTHORITY OVER MEMBERSHIP. It mirrors the bounded-roster idiom of
// v2.workflow.floor_expected_red / floor_grandfathered_roster / floor_cost_debt: a closed,
// identity-grain roster whose verdict refuses in BOTH directions so it is monotone and cannot rot.
//
// STRUCTURAL KEY, NOT A LINE. A row is (module_path, declaration, scrutinee) -- the enclosing
// function/declaration name plus the matched scrutinee name -- resolved at check time by locating
// the match on the named scrutinee within the named declaration. A line number is deliberately NOT
// part of the key: an unrelated refactor above one of these frozen sites would shift a line, and a
// line-keyed roster would fail its stale-row claim on an innocuous edit and read a still-the-same
// exception as an add+remove -- directly fighting the operator's shrink-only intent. The two
// target_model rows share one declaration and one scrutinee (two distinct matches on
// state.pending_arguments inside target_primitive_arguments_to_tokens), so membership is a MULTISET:
// the equality-budget claim compares the roster and the observed blocking sites by per-key count,
// not by set membership, and that count is still wholly structural.
//
// NO NEW EXCEPTION MAY EVER BE ADDED. The equality-budget claim in
// test.claim.floor_exhaustiveness_allowlist_equality_witness refuses in both directions:
// (1) a seventh blocking site not present here (or a seventh row added here with no real blocking
//     site behind it) makes the claim FAIL; and (2) a row here whose site no longer actually blocks
//     (stale -- the type got resolved, per the (C) roadmap row) makes the claim FAIL. Each direction
//     is witnessed by its own red control. Once the (C) row lands and resolves all six types, this
//     roster empties and the wall covers every site.

type FloorExhaustivenessSite {
  module_path: String
  declaration: String
  scrutinee: String
  ruling: String
}

// The single authority. A transcribed total is a SECOND representation of what this fold computes
// (gunbc.design_argument::single_authority, minimize_redundancy): the length is a producer, not a
// literal, so no count can stand in for the join and nothing goes stale unobserved.
fn floor_exhaustiveness_allowlist() -> List<FloorExhaustivenessSite> {
  [
    FloorExhaustivenessSite {
      module_path: "v2.compiler.fold_lowering",
      declaration: "collection_roster_primitive_call_signature_in",
      scrutinee: "form",
      ruling: "floor_exhaustiveness_refusal_a_plus_c_exceptions_frozen_2026_11_23",
    },
    FloorExhaustivenessSite {
      module_path: "v2.compiler.type_declaration_use_census",
      declaration: "type_declaration_rows",
      scrutinee: "label",
      ruling: "floor_exhaustiveness_refusal_a_plus_c_exceptions_frozen_2026_11_23",
    },
    FloorExhaustivenessSite {
      module_path: "v2.compiler.type_declaration_use_census",
      declaration: "as_site_rows",
      scrutinee: "label",
      ruling: "floor_exhaustiveness_refusal_a_plus_c_exceptions_frozen_2026_11_23",
    },
    FloorExhaustivenessSite {
      module_path: "v2.std.compilers.target_model",
      declaration: "target_primitive_arguments_to_tokens",
      scrutinee: "pending_arguments",
      ruling: "floor_exhaustiveness_refusal_a_plus_c_exceptions_frozen_2026_11_23",
    },
    FloorExhaustivenessSite {
      module_path: "v2.std.compilers.target_model",
      declaration: "target_primitive_arguments_to_tokens",
      scrutinee: "pending_arguments",
      ruling: "floor_exhaustiveness_refusal_a_plus_c_exceptions_frozen_2026_11_23",
    },
    FloorExhaustivenessSite {
      module_path: "v2.compiler.source_root_eval",
      declaration: "native_demand_prepared",
      scrutinee: "p",
      ruling: "floor_exhaustiveness_refusal_a_plus_c_exceptions_frozen_2026_11_23",
    },
  ]
}

// The structural identity of a row -- the key the equality-budget claim compares as a multiset. The
// ruling is deliberately NOT part of the key: it is provenance, and two rows that differ only in the
// ruling they cite are the same exception (which is a bug, not a second member).
fn floor_exhaustiveness_site_key(row: FloorExhaustivenessSite) -> String {
  join([row.module_path, row.declaration, row.scrutinee], "::")
}
