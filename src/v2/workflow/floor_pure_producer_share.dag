data floor_cross_claim_carried_input_warm_rows: List<CarriedInputWarmRow> = [
  CarriedInputWarmRow {
    producer: "v2.test.claim.declaring_identity_spelling.production_ingest.xl3_fixture_censuses",
    carried_input: "v2.test.claim.declaring_identity_spelling.production_ingest.xl3_fixture_reads",
    dependence: ImplicitAcquisition,
    measurement: "The per-fixture parse-normalize-census of the carried reads, computed once and served to every claim of the file as a field read. Present-vs-absent as its input row (gunbc#11461 run 35074340220 absent; the enrolled run present), normalised on claims in no consumer module of any enrolled key. ImplicitAcquisition: xl3_fixture_censuses is nullary and calls xl3_fixture_reads inside itself."
  },
  CarriedInputWarmRow {
    producer: "v2.test.claim.reference_derived_graph_fixture.xl4_fixture_trees",
    carried_input: "v2.test.claim.reference_derived_graph_fixture.fixture_ingest",
    dependence: ImplicitAcquisition,
    measurement: "The parse-and-normalize of the carried ingest, shared by the two XL-4 claim files whose claims name the collector and the edge fold (the seam is the ingest, not the collection). Present-vs-absent as its input row: gunbc#11202 run 34730467598 refused both files ENROLMENT-MARGIN-REFUSED at the 500ms ceiling without the share; run 34762428707 passed with it as a plain warm row; the carried-input shape replaces that row because the warm reached the world (run 35059914771). ImplicitAcquisition: xl4_fixture_trees is nullary and calls fixture_ingest inside itself."
  },
  CarriedInputWarmRow {
    producer: "gunbc.roadmap_authority.roadmap_authority_projection",
    carried_input: "gunbc.roadmap_authority.roadmap_acceptance_event_history_load",
    dependence: BoundParameter { parameter: "history" },
    measurement: "The same sha-pinned present-vs-absent pair as its input row, normalised on claims in no consumer module of any enrolled key. Admitted only on serve-below-recompute at identity grain; a row that does not clear it is withdrawn into floor_cross_claim_refused_candidates rather than defended by a family aggregate. BoundParameter since gunbc#11303 landed the explicit-history spelling: the producer's nullary wrapper no longer exists, so the warm supplies `history` by name and the claim's own call already carries the content in its argument row. This row was authored ImplicitAcquisition with that transition written into it as the anticipated row edit, and the floor is what forced the edit rather than a reader noticing — the warm refused PureProducerShareWarmFailed with a call-contract mismatch naming the missing argument, which is the mechanism working."
  }
]

// The carried-input producers as names, folded exactly like `refused_share_producers`: the wall
// below and the derivation's `CarriedInputProducer` decline need identities. That decline is also
// why no collision wall between carried rows and admitted rows stands here any more: a carried
// producer stores under its carried content, and the derivation declines every closed demand for
// one, so a producer admitted both ways is unconstructible rather than checked.
fn carried_input_warm_producers(rows: List<CarriedInputWarmRow>) -> List<String> {
  reverse(fold(rows, init: [], f: fn(acc, row) { concat([row.producer], acc) }))
}

fn prepared_effect_input_acquisitions(inputs: List<PreparedEffectInput>) -> List<String> {
  reverse(fold(inputs, init: [], f: fn(acc, row) { concat([row.acquisition], acc) }))
}

// THE WALL: A CARRIED-INPUT ROW MAY NOT NAME AN INPUT NOBODY PREPARES.
//
// A row whose `input` matches no `PreparedEffectInput.acquisition` declares a dependence on a
// value that will never be bound. The floor refuses it at install, so this fold is the same fact
// stated where a fixture can redden it: over the live rosters it is green and could be reddened
// only by editing the corpus it guards, which DESIGN section 4b calls a decoration — as a
// function of both populations the forbidden state is writable in a fixture and the live tree is
// the positive control.
fn carried_input_rows_without_a_prepared_input(
  rows: List<CarriedInputWarmRow>,
  inputs: List<PreparedEffectInput>
) -> List<String> {
  let prepared = prepared_effect_input_acquisitions(inputs: inputs)
  reverse(fold(rows, init: [], f: fn(acc, row) {
    if any(xs: prepared, predicate: fn(p) { p == row.carried_input }) {
      acc
    } else {
      concat([row.producer], acc)
    }
  }))
}
