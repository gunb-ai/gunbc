    next_trigger: "a measured recompute this row actually removes -- a producer that neither costs nor saves is cache population, which this roster refuses on its own terms"
  },
  RefusedShareCandidate {
    producer: "v2.extdeps.languages.rust.rust_target_model_staging",
    verdict: MeasuredServeAboveRecompute,
    carrier_modules: [
      "v2.test.emit.produced_decl_support_preserved",
      "v2.test.emit.produced_decl_two_target",
      "v2.test.emit.rust_produced_decl_emit"
    ],
    measurement: "gunbc#10094 required_floor_claim_cost.tsv, run 33667640710 (this row alone enrolled) against 33671317370 (none of the three); its consumer set is the one it INHERITED after rust_target_model was withdrawn, 133 claims across 44 modules, read from that run's own shared-fill ledger",
    next_trigger: "the same trigger as rust_target_model, because it is the same measured effect reached through a second identity -- these two do not retire independently"
  },
  RefusedShareCandidate {
    producer: "gunbc.self_host_compile_phase_frontier.compile_phase_frontier_standing",
    verdict: SupersededBySingleAuthorityRepair {
      repaired_by: "gunbc.self_host_compile_phase_frontier.current_compile_phase_frontier_standing"
    },
