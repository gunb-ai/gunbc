module v2.workflow.compiler_closure_ingest_transport

import extdeps.shell
import extdeps.git
import extdeps.gunbc
import gunbc.ci_layer_roots { witness_layer_roots }
import std.logic { Bool }
import tools.host_prelude {
  ClaimRun,
  WitnessBinReady,
  WitnessBinRefused,
  run_gunbc_claims,
  witness_bin,
  witness_bin_ensure_built_typed,
  witness_bin_release_path
}

data closure_source_root: String = "src/v2"
data closure_entry: String = "src/v2/compiler/00_compile.dag"
data closure_test_entry: String = "src/v2/test/claim/self_host/compiler_closure_emit_from_ingest_test.dag"
data closure_witness_module_count: String = "compiler_closure_ingest_receipt_describes_carrier_holds"

data closure_witness_quarantine_note: String = "The gate asserted compiler_closure_scoped_ingest_module_count_ok_holds, which demands COMPLETE coverage. That witness was passing over an Empty carrier because the receipt hardcoded produced_row_count = read_count and coverage_complete = true; with the receipt made honest it correctly goes red, because the compiler closure is 91 reads against a 64-row inline cap and its manifest genuinely carries no rows.

The completeness claim is therefore QUARANTINED as a known-red probe row (gunbc.ci_layer_roots known_red_probe_entries / known_red_frontier_note) — it expects red on the probe cadence, and greening is a counted un-quarantine event, not a silent pass. The gate now asserts compiler_closure_ingest_receipt_describes_carrier_holds instead: the receipt must describe the carrier that landed. That is deliberately NOT a weaker restatement of the same claim — it is the falsifiable property the repair established, it holds today, and it reds if the receipt ever drifts from the carrier again. Swapping in a claim that merely restates what is already true would have been vacuity with extra steps; this one can fail.

Dissolve-on: the carrier redesign (manifest rows referencing source by ref/hash instead of inlining full text) lifts the cap constraint, the closure manifest carries its 91 rows, the quarantined row greens and un-quarantines, and this note deletes."
data closure_witness_layer_roots: String = "self_host_closure_witness_layer_roots_reexports_authority_holds"
data closure_gap4_entry: String = "src/v2/test/claim/long/gap4_parse_tokens_remain_test.dag"
data closure_gap4_witness: String = "gap4_match_arm_let_stmt_parses_holds"

fn closure_manifest_emit_args(manifest_dir: String) -> List<String> {
  [
    "--source-root", closure_source_root,
    "--entry", closure_entry,
    "--emit-dag-manifest", concat(manifest_dir, "/host_source_root_ingest_manifest.dag")
  ]
}

func run_compiler_closure_ingest_gate_ready(root: String) -> Bool {
    let pre_overlay = run_gunbc_claims(
      source_roots: witness_layer_roots,
      claims: [
        ClaimRun { entry: closure_test_entry, function: closure_witness_layer_roots },
        ClaimRun { entry: closure_gap4_entry, function: closure_gap4_witness }
      ]
    )
    if pre_overlay {
      let target_ready = shell.Mkdir.Parents(path: concat(root, "/target"))
      if target_ready.success {
        let manifest_dir = shell.Mktemp.DirWithTemplate(
          template: concat(root, "/target/closure-ingest-XXXXXX")
        )
        if manifest_dir.success {
          let emitted = gunbc.WitnessBin.Run(
            workdir: root,
            bin_path: witness_bin_release_path(root: root, bin_name: "discover_source_root_ingest"),
            args: closure_manifest_emit_args(manifest_dir: manifest_dir.path)
          )
          let overlay = if emitted.success {
            run_gunbc_claims(
              source_roots: concat(witness_layer_roots, [manifest_dir.path]),
              claims: [ClaimRun { entry: closure_test_entry, function: closure_witness_module_count }]
            )
          } else {
            false
          }
          let cleaned = shell.Remove.RecursiveForce(path: manifest_dir.path)
          overlay && cleaned.success
        } else {
          false
        }
      } else {
        false
      }
    } else {
      false
    }
}

func run_compiler_closure_ingest_gate() -> Bool {
  let root = git.Core.Toplevel()
  let ingest_bin = witness_bin(var_name: "DISCOVER_SOURCE_ROOT_INGEST", bin_name: "discover_source_root_ingest")
  match witness_bin_ensure_built_typed(root: root.path, bin: ingest_bin) {
    WitnessBinRefused { bin_name: _, path: _, reason: _ } => false
    WitnessBinReady { path: _ } => run_compiler_closure_ingest_gate_ready(root: root.path)
  }
}
