module v2.workflow.compiler_closure_ingest_transport


data closure_source_root: String = "src/v2"
data closure_entry: String = "src/v2/compiler/00_compile.dag"
data closure_boundary_entry: String = "src/v2/compiler/07_target_carriers.dag"
data closure_test_entry: String = "src/v2/test/claim/self_host/compiler_closure_emit_from_ingest_test.dag"
data closure_boundary_test_entry: String = "src/v2/test/claim/self_host/compiler_closure_ingest_boundary_witness_test.dag"
data closure_witness_module_count: String = "compiler_closure_scoped_ingest_module_count_ok_holds"
data closure_witness_receipt: String = "compiler_closure_ingest_receipt_describes_carrier_holds"
data closure_boundary_witness: String = "compiler_closure_ingest_boundary_exact_cap_transport_holds"
data closure_overflow_witness: String = "compiler_closure_ingest_overflow_refuses_never_empty_holds"

data closure_witness_quarantine_note: String = "Capless closure-ref transport landed: manifest rows are SourceRef + content hash (no inlined Lossless text), consumers read through refs with hash verification, and produced_row_count tracks the full closure-ref list. Overflow past manifest_inline_list_max reports SourceRootManifestElided with typed read_count/cap while the ref population stays complete — never zero rows with a positive read count. compiler_closure_scoped_ingest_module_count_ok_holds un-quarantined from explicit_witness_admission when the completeness witness greened."
data closure_witness_layer_roots: String = "self_host_closure_witness_layer_roots_reexports_authority_holds"
data closure_gap4_entry: String = "src/v2/test/claim/long/gap4_parse_tokens_remain_test.dag"
data closure_gap4_witness: String = "gap4_match_arm_let_stmt_parses_holds"

fn closure_manifest_emit_args(entry: String, manifest_dir: String) -> List<String> {
  [
    "--source-root", closure_source_root,
    "--entry", entry,
    "--emit-dag-manifest", concat(manifest_dir, "/host_source_root_ingest_manifest.dag")
  ]
}

fn run_closure_ingest_overlay_claims(
  root: String,
  manifest_dir: String,
  claims: List<tools.host_prelude.ClaimRun>
) -> Bool {
  let emitted = WitnessBin.Run(
    workdir: root,
    bin_path: tools.host_prelude.witness_bin_release_path(root: root, bin_name: "discover_source_root_ingest"),
    args: closure_manifest_emit_args(
      entry: closure_entry,
      manifest_dir: manifest_dir
    )
  )
  if emitted.success {
    tools.host_prelude.run_gunbc_claims(
      source_roots: concat(gunbc.ci_layer_roots.witness_layer_roots, [manifest_dir]),
      claims: claims
    )
  } else {
    false
  }
}

fn run_closure_boundary_overlay_claims(
  root: String,
  manifest_dir: String
) -> Bool {
  let emitted = WitnessBin.Run(
    workdir: root,
    bin_path: tools.host_prelude.witness_bin_release_path(root: root, bin_name: "discover_source_root_ingest"),
    args: closure_manifest_emit_args(
      entry: closure_boundary_entry,
      manifest_dir: manifest_dir
    )
  )
  if emitted.success {
    tools.host_prelude.run_gunbc_claims(
      source_roots: concat(gunbc.ci_layer_roots.witness_layer_roots, [manifest_dir]),
      claims: [
        tools.host_prelude.ClaimRun {
          entry: closure_boundary_test_entry,
          function: closure_boundary_witness
        }
      ]
    )
  } else {
    false
  }
}

func run_compiler_closure_ingest_gate_ready(root: String) -> Bool {
    let pre_overlay = tools.host_prelude.run_gunbc_claims(
      source_roots: gunbc.ci_layer_roots.witness_layer_roots,
      claims: [
        tools.host_prelude.ClaimRun { entry: closure_test_entry, function: closure_witness_layer_roots },
        tools.host_prelude.ClaimRun { entry: closure_gap4_entry, function: closure_gap4_witness }
      ]
    )
    if pre_overlay {
      let target_ready = shell.Mkdir.Parents(path: concat(root, "/target"))
      if target_ready.success {
        let manifest_dir = shell.Mktemp.DirWithTemplate(
          template: concat(root, "/target/closure-ingest-XXXXXX")
        )
        if manifest_dir.success {
          let overlay = run_closure_ingest_overlay_claims(
            root: root,
            manifest_dir: manifest_dir.path,
            claims: [
              tools.host_prelude.ClaimRun { entry: closure_test_entry, function: closure_witness_module_count },
              tools.host_prelude.ClaimRun { entry: closure_test_entry, function: closure_witness_receipt },
              tools.host_prelude.ClaimRun { entry: closure_test_entry, function: closure_overflow_witness }
            ]
          )
          let boundary_dir = shell.Mktemp.DirWithTemplate(
            template: concat(root, "/target/closure-ingest-boundary-XXXXXX")
          )
          let boundary = if boundary_dir.success {
            let ran = run_closure_boundary_overlay_claims(
              root: root,
              manifest_dir: boundary_dir.path
            )
            let cleaned = shell.Remove.RecursiveForce(path: boundary_dir.path)
            ran && cleaned.success
          } else {
            false
          }
          let cleaned = shell.Remove.RecursiveForce(path: manifest_dir.path)
          overlay && boundary && cleaned.success
        } else {
          false
        }
      } else {
        false
      }
    } else {
      false
    }
}

func run_compiler_closure_ingest_gate() -> Bool {
  let root = git.Inspect.Toplevel()
  let ingest_bin = tools.host_prelude.witness_bin(var_name: "DISCOVER_SOURCE_ROOT_INGEST", bin_name: "discover_source_root_ingest")
  match tools.host_prelude.witness_bin_ensure_built_typed(root: root.path, bin: ingest_bin) {
    tools.host_prelude.WitnessBinRefused { bin_name: _, path: _, reason: _ } => false
    tools.host_prelude.WitnessBinReady { path: _ } => run_compiler_closure_ingest_gate_ready(root: root.path)
  }
}
