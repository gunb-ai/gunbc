fn run_nat_semiring_rung56_eval() -> CorpusEvalReport {
  CorpusEvalReport {
    entries: corpus_entries_from_node_runtime_value_runs(
      runs: nat_semiring_rung6_post_emit_law_preservation_runtime_value_rows
    )
  }
}

fn nat_semiring_rung56_report_has_evidence(report: CorpusEvalReport) -> Bool {
  match is_empty(xs: report.entries) {
    true => false
    false => true
  }
}

fn nat_semiring_rung6_gate(report: CorpusEvalReport) -> Bool {
  if nat_semiring_rung56_report_has_evidence(report: report) {
    let tally = corpus_report_tally(r: report)
    tally.fail == Zero && tally.deferred == Zero && tally.pass != Zero
  } else {
    false
  }
}
