// Mock-totality's 21 expected-red rows were stale-quarantined by the explicit-import
// closure in v2.test.lens_mock_totality. Keep the historical chunk rows for provenance,
// but exclude the now-green family from the live expected-red roster.
//
// The three compile_accepted_unevaluable_program_control rows in chunk 21 are live again: run
// 32721781133 executed all three and observed the enrolled compile-acceptance holes. The former
// exclusions dissolved with DeclinedLiveTree in the same change, as their coupling required.
fn floor_expected_red_is_live(name: String) -> Bool {
  !(name == "v2.test.lens_mock_totality.cron_mock_totality.cron_mock_consumer_is_total_holds"
    || name == "v2.test.lens_mock_totality.cron_mock_totality.cron_mock_omitted_member_is_red_holds"
    || name == "v2.test.lens_mock_totality.diagnostic_mock_totality.diagnostic_mock_consumer_is_total_holds"
    || name == "v2.test.lens_mock_totality.diagnostic_mock_totality.diagnostic_mock_omitted_member_is_red_holds"
    || name == "v2.test.lens_mock_totality.filesystem_mock_totality.filesystem_mock_consumer_is_total_holds"
    || name == "v2.test.lens_mock_totality.filesystem_mock_totality.filesystem_mock_omitted_member_is_red_holds"
    || name == "v2.test.lens_mock_totality.gcp_mock_totality.gcp_mock_consumer_is_total_holds"
    || name == "v2.test.lens_mock_totality.gcp_mock_totality.gcp_mock_omitted_member_is_red_holds"
    || name == "v2.test.lens_mock_totality.github_mock_totality.github_mock_consumer_is_total_holds"
    || name == "v2.test.lens_mock_totality.github_mock_totality.github_mock_omitted_member_is_red_holds"
    || name == "v2.test.lens_mock_totality.git_mock_totality.git_mock_consumer_is_total_holds"
    || name == "v2.test.lens_mock_totality.git_mock_totality.git_mock_omitted_member_is_red_holds"
    || name == "v2.test.lens_mock_totality.git_mock_totality.git_mock_omitted_show_tree_is_red_holds"
    || name == "v2.test.lens_mock_totality.http_pilot_mock_totality.http_pilot_mock_consumer_is_total_holds"
    || name == "v2.test.lens_mock_totality.http_pilot_mock_totality.http_pilot_mock_omitted_member_is_red_holds"
    || name == "v2.test.lens_mock_totality.llm_mock_totality.llm_mock_consumer_is_total_holds"
    || name == "v2.test.lens_mock_totality.llm_mock_totality.llm_mock_omitted_member_is_red_holds"
    || name == "v2.test.lens_mock_totality.sec_edgar_mock_totality.sec_edgar_mock_consumer_is_total_holds"
    || name == "v2.test.lens_mock_totality.sec_edgar_mock_totality.sec_edgar_mock_omitted_member_is_red_holds"
    || name == "v2.test.lens_mock_totality.shell_mock_totality.shell_mock_consumer_is_total_holds"
    || name == "v2.test.lens_mock_totality.shell_mock_totality.shell_mock_omitted_member_is_red_holds")
}

fn floor_expected_red_roster() -> List<String> {
  filter(
    xs: list_flat_map(xs: floor_expected_red_chunks(), f: fn(chunk) { chunk }),
    predicate: floor_expected_red_is_live
  )
}
