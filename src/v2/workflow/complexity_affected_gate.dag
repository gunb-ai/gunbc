module v2.workflow.complexity_affected_gate

import v2.lens.complexity_accumulator_copy.roster_gate {
  FileSuspectVerdict,
  FileSuspectClean,
  FileSuspectFound,
  FileSuspectUnanalyzable,
  file_suspect_verdict
}
import v2.workflow.floor_diff_observe {
  FloorNameStatusDiffResult,
  NameStatusDiffOk,
  NameStatusDiffFail,
  floor_observe_git_diff_name_status_for_ci
}
import v2.std.algebra { filter, list_map, length }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }

data complexity_affected_gate_law: String = "Complexity enforcement scoped to the affected set (DESIGN 2 minimize-redundancy + 5 fail-closed + 6 lenses-are-residue). The accumulator-copy lens runs over EXACTLY the changed .dag paths the affected-set floor already observed (floor_diff_observe -> changed_paths), never the corpus: the gate's input IS the diff, so cost is denominated in the change (never the repo) and there is nothing for selection to mis-attribute — dissolving the filesystem_read attribution objection that offlined the whole-roster gate (accumulator_copy_roster_gate_exclusion_note). Gating is SUSPECTS-ONLY: a changed file with a confirmed Poly2 copied accumulator refuses the gate; refusal-residue (may-alias, ratchet) is the undecidable §6 residue and is NOT gated here. An ingest that regresses on a changed file is Unanalyzable — a typed, located refusal, never a silent widen (§5): we could not prove the changed file free of a suspect, so we refuse rather than pass."

type ChangedFileComplexity
  = ChangedFileClean { path: String }
  | ChangedFileSuspect { path: String }
  | ChangedFileUnanalyzable { path: String }

type AffectedComplexityVerdict
  = AffectedComplexityClean
  | AffectedComplexityRefused { flagged: List<ChangedFileComplexity> }

fn changed_file_is_dag(path: String) -> Bool {
  ends_with(s: path, suffix: ".dag")
}

fn classify_changed_dag(path: String) -> ChangedFileComplexity {
  match file_suspect_verdict(path: path) {
    FileSuspectClean => ChangedFileClean { path: path }
    FileSuspectFound => ChangedFileSuspect { path: path }
    FileSuspectUnanalyzable => ChangedFileUnanalyzable { path: path }
  }
}

fn changed_file_flagged(c: ChangedFileComplexity) -> Bool {
  match c {
    ChangedFileClean { path: _ } => false
    ChangedFileSuspect { path: _ } => true
    ChangedFileUnanalyzable { path: _ } => true
  }
}

fn affected_complexity_verdict(changed_paths: List<String>) -> AffectedComplexityVerdict {
  let dag_paths = filter(xs: changed_paths, predicate: changed_file_is_dag)
  let classifications = list_map(xs: dag_paths, f: classify_changed_dag)
  let flagged = filter(xs: classifications, predicate: changed_file_flagged)
  if length(xs: flagged) == 0 {
    AffectedComplexityClean
  } else {
    AffectedComplexityRefused { flagged: flagged }
  }
}

fn affected_complexity_gate_passes(changed_paths: List<String>) -> Bool {
  match affected_complexity_verdict(changed_paths: changed_paths) {
    AffectedComplexityClean => true
    AffectedComplexityRefused { flagged: _ } => false
  }
}

data affected_complexity_floor_gate_note: String = "The nullary floor-gate entry: it observes the diff itself via the same host effect the affected-set floor already uses (floor_observe_git_diff_name_status_for_ci — a git diff --name-status ShellProgram intent, ReadsLiveTree), then runs the suspects-only verdict over the changed .dag paths. So it is a self-scoping gate: no Rust executor change and no injected argument — enrollable as one RunnableSingleClaim gate row. A diff-observation FAILURE refuses the gate (fail-closed, DESIGN §5: an unobservable diff is not a green, it is a refusal), matching the floor's own DiffObservationRefusal disposition."

fn affected_complexity_floor_gate() -> Bool {
  match floor_observe_git_diff_name_status_for_ci() {
    NameStatusDiffFail { reason: _ } => false
    NameStatusDiffOk { changed_paths: paths, departed_paths: _ } =>
      affected_complexity_gate_passes(changed_paths: paths)
  }
}
