module v2.workflow.carrier_realization_census

import v1.compiler.compile { SourceFile, FrontendResult, front_end_sources }
import v1.compiler.emit_rust { is_host_text_carrier_type }
import v1.compiler.trait_derive_emit { v1_item_field_type_exprs }
import v1.compiler.coercion { type_realization_decision, type_reference_decl_file }
import v1.compiler.artifact { Rust }
import v1.compiler.resolve { ModuleGraph, ResolvedModule }
import v1.std.core { Node, NewlineIndex, authored_name_at, module_items, param_node_type_expr }
import std.coercion { TypeRealizationDecision, Realized, Unrealized, Refused }
import std.types { List, String, Map }
import extdeps.filesystem.filesystem_io { Filesystem }

// The step-1 shadow census: for every type-reference occurrence the v1 emitter would
// render, compute BOTH the legacy short-circuit answer and the strict identity
// authority's answer, and report where they disagree. Emits nothing, renders nothing,
// changes no byte -- the divergence is a fact about two pure functions over one tree.
//
// The predicate is IMPORTED, never re-derived: a second copy of is_host_text_carrier_type
// would be the same forked authority this census exists to measure.
//
// The authority queried is the STRICT type_realization_decision, never lookup_checkpoint,
// whose decl_file == "" arm preserves the bare-name fallback and would measure the bypass
// against itself.

type CensusOutcome
  = Agrees
  | DivergesWithExactIdentity
  | IdentityUnavailable

// IdentityUnavailable is NOT folded into structural rendering. Unrealized (a known
// structural declaration) and Refused (identity not supplied) are different answers, and
// merging them reproduces the bypass under a newer name.
type CarrierDecisionRow {
  module_file: String
  enclosing_decl: String
  position_kind: String
  authored_name: String
  decl_file: String
  legacy_base: String
  authority_base: String
  outcome: CensusOutcome
}

fn no_rows() -> List<CarrierDecisionRow> {
  []
}

fn source_indices_of(fr: FrontendResult) -> Map<String, NewlineIndex> {
  fr.newline_indices |> fold(init: empty_map(), f: (acc, si) => map_insert(acc, si.file, si))
}

// The legacy answer, taken from the imported predicate rather than restated: when the
// short-circuit fires the renderer returns the literal "String" before any checkpoint or
// roster consultation, so that is the legacy base at this occurrence.
fn legacy_base_of(n: Node, si: Map<String, NewlineIndex>) -> String {
  if is_host_text_carrier_type(n: n, source_indices: si) {
    "String"
  } else {
    ""
  }
}

fn authority_base_of(name: String, decl_file: String) -> String {
  match type_realization_decision(target: Rust, dag_name: name, decl_file: decl_file) {
    Realized { checkpoint: cp } => cp.target_type
    Unrealized => "<structural>"
    Refused { cause: _ } => "<refused>"
  }
}

fn outcome_of(legacy: String, authority: String, decl_file: String) -> CensusOutcome {
  if decl_file == "" {
    IdentityUnavailable
  } else if legacy == authority {
    Agrees
  } else {
    DivergesWithExactIdentity
  }
}

fn decision_row(
  module_file: String,
  enclosing: String,
  position_kind: String,
  n: Node,
  si: Map<String, NewlineIndex>
) -> CarrierDecisionRow {
  let name = authored_name_at(source_indices: si, node: n)
  let decl_file = type_reference_decl_file(n: n)
  let legacy = legacy_base_of(n: n, si: si)
  let authority = authority_base_of(name: name, decl_file: decl_file)
  CarrierDecisionRow {
    module_file: module_file,
    enclosing_decl: enclosing,
    position_kind: position_kind,
    authored_name: name,
    decl_file: decl_file,
    legacy_base: legacy,
    authority_base: authority,
    outcome: outcome_of(legacy: legacy, authority: authority, decl_file: decl_file)
  }
}

// Field/variant-field type positions of one declaration, enumerated through the
// emitter's OWN enumeration (v1_item_field_type_exprs) rather than a parallel walk --
// a second traversal is the drift risk the calibration control exists to catch.
fn item_decl_rows(
  module_file: String,
  item: Node,
  si: Map<String, NewlineIndex>
) -> List<CarrierDecisionRow> {
  let enclosing = authored_name_at(source_indices: si, node: item)
  v1_item_field_type_exprs(item: item, source_indices: si)
    |> fold(init: no_rows(), f: (acc, te) => concat(acc, [decision_row(
         module_file: module_file,
         enclosing: enclosing,
         position_kind: "declaration_field",
         n: te,
         si: si
       )]))
}

fn param_rows(
  module_file: String,
  item: Node,
  si: Map<String, NewlineIndex>
) -> List<CarrierDecisionRow> {
  let enclosing = authored_name_at(source_indices: si, node: item)
  item.params |> fold(init: no_rows(), f: (acc, p) => concat(acc, [decision_row(
    module_file: module_file,
    enclosing: enclosing,
    position_kind: "fn_signature_param",
    n: param_node_type_expr(n: p),
    si: si
  )]))
}

fn module_rows(m: ResolvedModule, si: Map<String, NewlineIndex>) -> List<CarrierDecisionRow> {
  let module_file = authored_name_at(source_indices: si, node: m.module)
  module_items(n: m.module) |> fold(init: no_rows(), f: (acc, item) =>
    concat(concat(acc, item_decl_rows(module_file: module_file, item: item, si: si)),
           param_rows(module_file: module_file, item: item, si: si)))
}

fn census_rows(sources: List<SourceFile>) -> List<CarrierDecisionRow> {
  let fr = front_end_sources(sources: sources)
  let si = source_indices_of(fr: fr)
  match fr.graph {
    Absent => no_rows()
    Present { value: g } =>
      g.modules |> fold(init: no_rows(), f: (acc, m) => concat(acc, module_rows(m: m, si: si)))
  }
}

// ---------------------------------------------------------------------------
// Subject sources. FAIL-CLOSED: one unreadable path refuses the whole census.
//
// A census over a PARTIAL closure silently under-counts, and an under-count here is
// indistinguishable from a clean result -- the empty-observation narrow DESIGN section 5
// names, where an observation that could not see what changed is rendered as "nothing is
// affected". Skipping the file would zero this deficit's frequency by construction. So the
// arm refuses and names the path rather than widening or narrowing.
// ---------------------------------------------------------------------------

type CensusSources
  = SourcesRead { sources: List<SourceFile> }
  | SourceReadRefused { path: String }

fn census_sources_step(acc: CensusSources, path: String) -> CensusSources {
  match acc {
    SourceReadRefused { path: p } => SourceReadRefused { path: p }
    SourcesRead { sources: so_far } => {
      let read_out = Filesystem.Read(path: path)
      if !read_out.success {
        SourceReadRefused { path: path }
      } else {
        SourcesRead { sources: concat(so_far, [SourceFile { path: path, content: read_out.content }]) }
      }
    }
  }
}

fn census_sources_from_paths(paths: List<String>) -> CensusSources {
  paths |> fold(init: SourcesRead { sources: [] }, f: (acc, p) => census_sources_step(acc: acc, path: p))
}

// ---------------------------------------------------------------------------
// Receipt. The cross-tab is the artifact, so the row carries the raw fields the
// verdict was computed from -- a classifier that folds its discriminating input into
// its label destroys later re-adjudication, which is the instrument lesson this lane
// paid for once already.
// ---------------------------------------------------------------------------

fn outcome_label(o: CensusOutcome) -> String {
  match o {
    Agrees => "Agrees"
    DivergesWithExactIdentity => "DivergesWithExactIdentity"
    IdentityUnavailable => "IdentityUnavailable"
  }
}

fn census_tsv_header() -> String {
  "module_file\tenclosing_decl\tposition_kind\tauthored_name\tdecl_file\tlegacy_base\tauthority_base\toutcome"
}

fn census_row_tsv(r: CarrierDecisionRow) -> String {
  concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(
    r.module_file, "\t"), r.enclosing_decl), "\t"), r.position_kind), "\t"), r.authored_name), "\t"),
    r.decl_file), "\t"), r.legacy_base), "\t"), r.authority_base), "\t"), outcome_label(o: r.outcome))
}

fn census_tsv(rows: List<CarrierDecisionRow>) -> String {
  rows |> fold(init: census_tsv_header(), f: (acc, r) => concat(concat(acc, "\n"), census_row_tsv(r: r)))
}

fn census_receipt_for_paths(paths: List<String>) -> String {
  match census_sources_from_paths(paths: paths) {
    SourceReadRefused { path: p } => concat("REFUSED\tsource_read_failed\t", p)
    SourcesRead { sources: srcs } => census_tsv(rows: census_rows(sources: srcs))
  }
}

// First end-to-end subject: a small, self-contained closure that genuinely exercises the
// carrier -- dag/std/string_type.dag declares `type String = FreeMonoid<Char>`, which is the
// exact declaration the structural roster enrolls and the exact one the short-circuit
// short-circuits past. This is a MECHANISM proof, not the calibration subject: the
// calibration control runs against the 03_ingest closure and its 25 arm-A sites, and no
// divergence count from this entry may be published as the census result.
data census_smoke_subject_paths: List<String> = [
  "dag/std/algebra.dag",
  "dag/std/types.dag",
  "dag/std/string_type.dag"
]

fn census_smoke_receipt() -> String {
  census_receipt_for_paths(paths: census_smoke_subject_paths)
}
