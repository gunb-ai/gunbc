module v2.test.workflow.nat_semiring_rung34_eval


data nat_semiring_rung34_runtime_value_rows: List<TestClaimRun<Node, RuntimeValue>> = [
  run_phase1_nat_semiring_rung3_module_roundtrip,
  run_phase1_nat_semiring_rung4_rust_emit_equals_eval
]

fn run_nat_semiring_rung34_eval() -> v2.test.workflow.testclaim_corpus_runner.CorpusEvalReport {
  v2.test.workflow.testclaim_corpus_runner.CorpusEvalReport {
    entries: corpus_entries_from_node_runtime_value_runs(
      runs: nat_semiring_rung34_runtime_value_rows
    )
  }
}

fn nat_semiring_rung34_report_has_evidence(report: v2.test.workflow.testclaim_corpus_runner.CorpusEvalReport) -> Bool {
  match is_empty(xs: report.entries) {
    true => false
    false => true
  }
}

fn nat_semiring_rung3_gate(report: v2.test.workflow.testclaim_corpus_runner.CorpusEvalReport) -> Bool {
  if nat_semiring_rung34_report_has_evidence(report: report) {
    let tally = corpus_report_tally(r: report)
    tally.fail == Zero && tally.deferred == Zero
  } else {
    false
  }
}

fn nat_semiring_rung4_gate(report: v2.test.workflow.testclaim_corpus_runner.CorpusEvalReport) -> Bool {
  if nat_semiring_rung34_report_has_evidence(report: report) {
    let tally = corpus_report_tally(r: report)
    tally.fail == Zero && tally.deferred == Zero
  } else {
    false
  }
}

fn nat_semiring_rungs_34_closed(report: v2.test.workflow.testclaim_corpus_runner.CorpusEvalReport) -> Bool {
  nat_semiring_rung3_gate(report: report) && nat_semiring_rung4_gate(report: report)
}
