module v2.test.workflow.lens_parallelism_family_eval


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data parallelism_control_effect_dep: v2.std.dependency.DependencyView = v2.std.dependency.DependencyView {
  source: v2.test.lens_parallelism.data_dependency.parallelism_root,
  dependent: v2.test.lens_parallelism.data_dependency.parallelism_child,
  kind: v2.std.dependency.EffectDependsOn,
  usage_site: v2.test.lens_parallelism.data_dependency.parallelism_child
}

data parallelism_control_type_dep: v2.std.dependency.DependencyView = v2.std.dependency.DependencyView {
  source: v2.test.lens_parallelism.data_dependency.parallelism_root,
  dependent: v2.test.lens_parallelism.data_dependency.parallelism_child,
  kind: v2.std.dependency.TypeDependsOn,
  usage_site: v2.test.lens_parallelism.data_dependency.parallelism_child
}

fn parallelism_control_effect_is_effect_coupled() -> Bool {
  match v2.lens.parallelism.parallelism_witness(tree: v2.test.lens_parallelism.data_dependency.parallelism_claim_tree(), dependencies: [parallelism_control_effect_dep]) {
    v2.std.witness.Holds { value: f } =>
      v2.lens.parallelism.parallelism_fact_eq(
        a: f,
        b: v2.lens.parallelism.ParallelismFact {
          dependencies: [
            v2.std.dependency.ClassifiedDependencyView {
              dependency: parallelism_control_effect_dep,
              classification: v2.lens.common.algebraic_composition.EffectCoupled
            }
          ]
        }
      )
    v2.std.witness.Violates { diagnostic: _ } => false
  }
}

fn parallelism_control_effect_not_data_dependent() -> Bool {
  match v2.lens.parallelism.parallelism_witness(tree: v2.test.lens_parallelism.data_dependency.parallelism_claim_tree(), dependencies: [parallelism_control_effect_dep]) {
    v2.std.witness.Holds { value: f } =>
      !v2.lens.parallelism.parallelism_fact_eq(
        a: f,
        b: v2.lens.parallelism.ParallelismFact {
          dependencies: [
            v2.std.dependency.ClassifiedDependencyView {
              dependency: parallelism_control_effect_dep,
              classification: v2.lens.common.algebraic_composition.DataDependent
            }
          ]
        }
      )
    v2.std.witness.Violates { diagnostic: _ } => false
  }
}

fn parallelism_control_unresolved_violates() -> Bool {
  match v2.lens.parallelism.parallelism_witness(tree: v2.test.lens_parallelism.data_dependency.parallelism_claim_tree(), dependencies: [parallelism_control_type_dep]) {
    v2.std.witness.Violates { diagnostic: _ } => true
    v2.std.witness.Holds { value: _ } => false
  }
}

fn parallelism_discriminating_controls_pass() -> Bool {
  parallelism_control_effect_is_effect_coupled()
    && parallelism_control_effect_not_data_dependent()
    && parallelism_control_unresolved_violates()
}

test data witness_lens_parallelism_family_gate_closed: Bool = parallelism_discriminating_controls_pass()
