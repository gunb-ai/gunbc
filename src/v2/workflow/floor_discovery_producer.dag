module v2.workflow.floor_discovery_producer

import gunbc.ci_layer_roots { witness_layer_roots, witness_exclusion_substrings }
import v2.compiler.discovery_enumeration {
  OwnedBoolWitnessClaimInit,
  OwnedDataDeclInitializer,
  OwnedDataDeclRecord,
  OwnedNodeCorpusInit,
  OwnedOtherInit
}
import v2.workflow.floor_discovery {
  FloorDiscoveryRow,
  FloorDiscoverySidecarKind,
  FloorDiscoverySidecarViolation
}
import v2.workflow.floor_naming_hygiene {
  floor_filename_contains_double_underscore,
  floor_test_marked_decl_allowed_in_entry,
  floor_wire_contract_decl_allowed_in_entry,
  floor_test_sidecar_suffix,
  floor_wire_contract_sidecar_suffix
}
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree, SubstrateInputsOnly }
import v2.std.collection { Absent, List, Optional, Present }
import v2.std.algebra { any, length, fold_list, Empty, Cons }
import v2.std.logic { Bool }
import std.types { String, Int }
import extdeps.filesystem.filesystem_io { Filesystem }

type FloorDiscoveryProducerResult
  = FloorDiscoveryAccepted { rows: List<FloorDiscoveryRow> }
  | FloorDiscoveryRefused { reason: String }

type FloorDiscoveryWalkState {
  rows: List<FloorDiscoveryRow>
  walk_failures: Int
  sidecar_violations: List<FloorDiscoverySidecarViolation>
}

fn floor_discovery_walk_state_zero() -> FloorDiscoveryWalkState {
  FloorDiscoveryWalkState {
    rows: [],
    walk_failures: 0,
    sidecar_violations: []
  }
}

fn floor_discovery_path_excluded(path: String, exclude_substrings: List<String>) -> Bool {
  any(
    xs: exclude_substrings,
    predicate: fn(sub) {
      (sub != "") && string_contains(s: path, pattern: sub)
    }
  )
}

fn floor_discovery_line_starts_test_decl(line: String) -> Bool {
  let trimmed = line
  (starts_with(s: trimmed, prefix: "test fn ")
    || starts_with(s: trimmed, prefix: "test data "))
}

fn floor_discovery_test_decl_name_from_line(line: String) -> String {
  let rest =
    if starts_with(s: line, prefix: "test fn ") {
      substring(s: line, start: 8, end: string_length(s: line))
    } else if starts_with(s: line, prefix: "test data ") {
      substring(s: line, start: 11, end: string_length(s: line))
    } else {
      ""
    }
  fold(
    split(s: rest, delimiter: "("),
    init: "",
    f: fn(acc, seg) {
      if acc != "" {
        acc
      } else {
        fold(
          split(s: seg, delimiter: " "),
          init: "",
          f: fn(name, token) {
            if name != "" {
              name
            } else if token == "" {
              ""
            } else {
              token
            }
          }
        )
      }
    }
  )
}

fn floor_discovery_scan_test_decl_names(content: String) -> List<String> {
  fold(
    split(s: content, delimiter: "\n"),
    init: [],
    f: fn(acc, line) {
      if floor_discovery_line_starts_test_decl(line: line) {
        let name = floor_discovery_test_decl_name_from_line(line: line)
        if name == "" {
          acc
        } else {
          concat(acc, [name])
        }
      } else {
        acc
      }
    }
  )
}

fn floor_discovery_line_starts_wire_contract_decl(line: String) -> Bool {
  let trimmed = line
  starts_with(s: trimmed, prefix: "data ")
}

fn floor_discovery_wire_contract_decl_name_from_line(line: String) -> String {
  let rest =
    if starts_with(s: line, prefix: "data ") {
      substring(s: line, start: 5, end: string_length(s: line))
    } else {
      ""
    }
  let name =
    fold(
      split(s: rest, delimiter: " "),
      init: "",
      f: fn(acc, token) {
        if acc != "" {
          acc
        } else if token == "" {
          ""
        } else {
          token
        }
      }
    )
  if name == "" {
    ""
  } else {
    let after_name =
      substring(
        s: rest,
        start: string_length(s: name),
        end: string_length(s: rest)
      )
    if string_contains(s: after_name, pattern: ": CoproductWireContract")
      || string_contains(s: after_name, pattern: ": VariantEncoding")
    {
      name
    } else {
      ""
    }
  }
}

fn floor_discovery_scan_wire_contract_decl_names(content: String) -> List<String> {
  fold(
    split(s: content, delimiter: "\n"),
    init: [],
    f: fn(acc, line) {
      if floor_discovery_line_starts_wire_contract_decl(line: line) {
        let name = floor_discovery_wire_contract_decl_name_from_line(line: line)
        if name == "" {
          acc
        } else {
          concat(acc, [name])
        }
      } else {
        acc
      }
    }
  )
}

fn floor_discovery_entry_reads_live_tree_default(content: String) -> LiveTreeDisposition {
  if string_contains(s: content, pattern: "SubstrateInputsOnly") {
    SubstrateInputsOnly
  } else {
    ReadsLiveTree
  }
}

fn floor_discovery_row_key(entry: String, function: String) -> String {
  concat(entry, "::", function)
}

fn floor_discovery_rows_contain_key(
  rows: List<FloorDiscoveryRow>,
  entry: String,
  function: String
) -> Bool {
  fold_list(
    xs: rows,
    empty: false,
    cons: fn(found, row) {
      if found {
        true
      } else {
        (row.entry == entry) && (row.function == function)
      }
    }
  )
}

fn floor_discovery_append_row(
  state: FloorDiscoveryWalkState,
  row: FloorDiscoveryRow
) -> FloorDiscoveryWalkState {
  if floor_discovery_rows_contain_key(
    rows: state.rows,
    entry: row.entry,
    function: row.function
  ) {
    state
  } else {
    FloorDiscoveryWalkState {
      rows: concat(state.rows, [row]),
      walk_failures: state.walk_failures,
      sidecar_violations: state.sidecar_violations
    }
  }
}

fn floor_discovery_collect_sidecar_violation(
  state: FloorDiscoveryWalkState,
  entry_path: String,
  kind: FloorDiscoverySidecarKind,
  required_suffix: String
) -> FloorDiscoveryWalkState {
  FloorDiscoveryWalkState {
    rows: state.rows,
    walk_failures: state.walk_failures,
    sidecar_violations: concat(state.sidecar_violations, [
      FloorDiscoverySidecarViolation {
        entry_path: entry_path,
        kind: kind,
        required_suffix: required_suffix
      }
    ])
  }
}

fn floor_discovery_process_dag_file(
  state: FloorDiscoveryWalkState,
  repo_path: String,
  exclude_substrings: List<String>
) -> FloorDiscoveryWalkState {
  if floor_discovery_path_excluded(path: repo_path, exclude_substrings: exclude_substrings) {
    state
  } else if floor_filename_contains_double_underscore(path: repo_path) {
    state
  } else {
    let content = filesystem_read(path: repo_path).content
    let test_names = floor_discovery_scan_test_decl_names(content: content)
    let reads_live = floor_discovery_entry_reads_live_tree_default(content: content)
    let with_test_rows =
      if floor_test_marked_decl_allowed_in_entry(entry_path: repo_path) {
        fold(
          test_names,
          init: state,
          f: fn(acc, name) {
            floor_discovery_append_row(
              state: acc,
              row: FloorDiscoveryRow {
                label: name,
                entry: repo_path,
                function: name,
                reads_live_tree: reads_live
              }
            )
          }
        )
      } else if length(xs: test_names) > 0 {
        floor_discovery_collect_sidecar_violation(
          state: state,
          entry_path: repo_path,
          kind: TestMarkedDecl,
          required_suffix: floor_test_sidecar_suffix
        )
      } else {
        state
      }
    let wire_names = floor_discovery_scan_wire_contract_decl_names(content: content)
    if floor_wire_contract_decl_allowed_in_entry(entry_path: repo_path) {
      with_test_rows
    } else if length(xs: wire_names) > 0 {
      floor_discovery_collect_sidecar_violation(
        state: with_test_rows,
        entry_path: repo_path,
        kind: WireContractDecl,
        required_suffix: floor_wire_contract_sidecar_suffix
      )
    } else {
      with_test_rows
    }
  }
}

fn floor_discovery_walk_dir(
  state: FloorDiscoveryWalkState,
  dir_path: String,
  exclude_substrings: List<String>
) -> FloorDiscoveryWalkState {
  let listed = Filesystem.List(path: dir_path)
  if !listed.success {
    FloorDiscoveryWalkState {
      rows: state.rows,
      walk_failures: state.walk_failures + 1,
      sidecar_violations: state.sidecar_violations
    }
  } else if listed.entries == "" {
    state
  } else {
    fold(
      split(s: listed.entries, delimiter: "\n"),
      init: state,
      f: fn(acc, name) {
        if name == "" {
          acc
        } else {
          let child = concat(dir_path, "/", name)
          if ends_with(s: name, suffix: ".dag") {
            floor_discovery_process_dag_file(
              state: acc,
              repo_path: child,
              exclude_substrings: exclude_substrings
            )
          } else {
            floor_discovery_walk_dir(
              state: acc,
              dir_path: child,
              exclude_substrings: exclude_substrings
            )
          }
        }
      }
    )
  }
}

fn floor_discovery_owned_data_rows(
  records: List<OwnedDataDeclRecord>
) -> List<FloorDiscoveryRow> {
  fold(
    records,
    init: [],
    f: fn(acc, rec) {
      match rec.initializer {
        OwnedBoolWitnessClaimInit { witness_entry: entry, witness_function: function } =>
          if (entry == "") || (function == "") {
            acc
          } else {
            let label =
              if starts_with(s: rec.decl_name, prefix: "unified_claim_") {
                substring(
                  s: rec.decl_name,
                  start: 14,
                  end: string_length(s: rec.decl_name)
                )
              } else {
                rec.decl_name
              }
            concat(acc, [
              FloorDiscoveryRow {
                label: label,
                entry: entry,
                function: function,
                reads_live_tree: ReadsLiveTree
              }
            ])
          }
        OwnedNodeCorpusInit => acc
        OwnedOtherInit { resolved: _ } => acc
      }
    }
  )
}

fn floor_discovery_merge_owned_rows(
  state: FloorDiscoveryWalkState,
  owned_rows: List<FloorDiscoveryRow>
) -> FloorDiscoveryWalkState {
  fold(
    owned_rows,
    init: state,
    f: fn(acc, row) { floor_discovery_append_row(state: acc, row: row) }
  )
}

fn floor_discovery_finalize(state: FloorDiscoveryWalkState) -> FloorDiscoveryProducerResult {
  if state.walk_failures > 0 {
    FloorDiscoveryRefused {
      reason: "directory listing failed during floor discovery walk (typed refusal, never empty roster)"
    }
  } else if length(xs: state.sidecar_violations) > 0 {
    FloorDiscoveryRefused {
      reason: "sidecar placement violation during floor discovery"
    }
  } else {
    FloorDiscoveryAccepted { rows: state.rows }
  }
}

fn discover_floor_corpus_rows_from_host_facts(
  source_roots: List<String>,
  scan_dirs: List<String>,
  exclude_substrings: List<String>,
  owned_data_records: List<OwnedDataDeclRecord>
) -> FloorDiscoveryProducerResult {
  let owned_rows = floor_discovery_owned_data_rows(records: owned_data_records)
  let walked =
    fold(
      source_roots,
      init: floor_discovery_walk_state_zero(),
      f: fn(acc, root) {
        floor_discovery_walk_dir(
          state: acc,
          dir_path: root,
          exclude_substrings: exclude_substrings
        )
      }
    )
  let merged = floor_discovery_merge_owned_rows(state: walked, owned_rows: owned_rows)
  floor_discovery_finalize(state: merged)
}

fn floor_filename_hygiene_refusal_for_paths(
  dag_paths: List<String>
) -> Optional<String> {
  fold_list(
    xs: dag_paths,
    empty: Absent,
    cons: fn(found, path) {
      match found {
        Present { value: _ } => found
        Absent =>
          if floor_filename_contains_double_underscore(path: path) {
            Present {
              value: concat(
                "filename hygiene: `.dag` basenames must not contain `__`; offending: ",
                path
              )
            }
          } else {
            Absent
          }
      }
    }
  )
}

data floor_discovery_producer_note: String = "Floor discovery producer: enrolled witness roster = pure fold over Filesystem.List host facts, owned-data transport records, witness_exclusion_substrings, and *_test.dag naming rules. Listing failure is FloorDiscoveryRefused, never an empty roster."
