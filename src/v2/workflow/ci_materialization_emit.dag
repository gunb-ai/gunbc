module v2.workflow.ci_materialization_emit

import v2.compiler.emit_orchestration { orch_emit_pipeline }
import v2.extdeps.languages.bash_orchestration_emit { bash_orchestration_emit_medium }
import gunbc.ci_materialization {
  ci_sccache_provider_skip_is_counted_note,
}
import v2.std.orchestration {
  Do,
  FailFast,
  If,
  Pipeline,
  PipelineStep,
  Run,
  ExitZero,
  RedirectSpec,
  DiscardAll
}
import v2.std.collection { Absent }
import v2.std.diagnostic { Accepted, Rejected, None, Some }

data ci_materialization_emit_authority_note: String = "Foreign-executor shell emission for gunbc.ci_materialization script surfaces (bucket D). Intent stays out of dag/gunbc/ci_materialization; bash medium binding lives here per shell→intent routing."

data ci_sccache_provider_emit_refused_poison: String = "__GUNBC_ORCH_EMIT_REFUSED__ sccache provider shell injection was rejected by v2.compiler.emit_orchestration; this marker is not valid workflow shell, so the committed ci.yml drift gate goes red rather than a hand-spelled fallback masking the refusal (DESIGN 5: refuse, never widen)\n"

data ci_sccache_show_stats_command: String = "sccache --show-stats"

data ci_sccache_bind_rustc_wrapper_command: String = "echo \"RUSTC_WRAPPER=sccache\" >> \"$GITHUB_ENV\""

data ci_sccache_bind_cargo_incremental_command: String = "echo \"CARGO_INCREMENTAL=0\" >> \"$GITHUB_ENV\""

data ci_sccache_bound_receipt_command: String = "printf '%s\\n' \"CiSccacheProviderReceipt: provider=bound catalog=sccache_local\""

data ci_sccache_skipped_receipt_command: String = "printf '%s\\n' \"CiSccacheProviderReceipt: provider=SKIPPED catalog=sccache_local host=$(hostname) cause=daemon-unavailable; the release build runs UNCACHED — a counted degradation, not a supported mode (host_build_cache_provision P1b should have converged this host)\""

data ci_sccache_bound_branch_command: String = concat(
  concat(ci_sccache_bind_rustc_wrapper_command, "; "),
  concat(
    concat(ci_sccache_bind_cargo_incremental_command, "; "),
    ci_sccache_bound_receipt_command
  )
)

fn ci_materialization_run(command: String) -> Run {
  Run {
    command: command,
    env: [],
    redirect: Absent,
    capture: Absent
  }
}

fn ci_materialization_do(command: String) -> PipelineStep {
  Do { run: ci_materialization_run(command: command) }
}

fn ci_materialization_emit_pipeline(p: Pipeline) -> String {
  match orch_emit_pipeline(p: p, medium: bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: d } =>
      match d {
        None => source.carried
        Some { diagnostics: _ } => ci_sccache_provider_emit_refused_poison
      }
    Rejected { diagnostics: _ } => ci_sccache_provider_emit_refused_poison
  }
}

fn ci_sccache_provider_shell_injection_intent() -> Pipeline {
  let _note = ci_sccache_provider_skip_is_counted_note
  Pipeline {
    steps: [
      If {
        cond: ExitZero {
          run: Run {
            command: ci_sccache_show_stats_command,
            env: [],
            redirect: Present { value: DiscardAll },
            capture: Absent
          }
        },
        then_: Pipeline {
          steps: [ci_materialization_do(command: ci_sccache_bound_branch_command)],
          on_failure: FailFast
        },
        else_: Present {
          value: Pipeline {
            steps: [ci_materialization_do(command: ci_sccache_skipped_receipt_command)],
            on_failure: FailFast
          }
        }
      }
    ],
    on_failure: FailFast
  }
}

fn ci_sccache_provider_shell_injection() -> String {
  ci_materialization_emit_pipeline(p: ci_sccache_provider_shell_injection_intent())
}
