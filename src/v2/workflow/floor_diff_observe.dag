module v2.workflow.floor_diff_observe

import gunbc.ci_spec {
  DiffPolicy,
  DiffMergeBase,
  DiffTwoDot,
  gunbc_ci_spec
}
import gunbc.ci_fleet { gunbc_ci_host }
import gunbc.host_effect {
  ShellCommand,
  NodeControlPlane,
  HostOs,
  host_effect_read_evidence,
  LocalShell,
  HostEffectIntent,
  HostEffectEvidence,
  ShellEffectApplied,
  ConvergePlanApplied
}
import gunbc.host_effect_realize { host_effect_apply }
import std.realization_reconcile {
  Reconciliation,
  Converged,
  NotConverged
}
import std.types { String }
import std.logic { Bool }
import v2.extdeps.languages.bash_build {
  bash_build_assign_lit,
  bash_build_assign_var,
  bash_build_command_from_word_nodes,
  bash_build_exit,
  bash_build_if_from_stmts,
  bash_build_or_else,
  bash_build_word_concat_from_nodes,
  bash_build_word_lit,
  bash_build_word_var
}
import v2.extdeps.languages.bash_emit {
  BashEmitIfNegatedSubshell,
  BashEmitSpecial,
  BashEmitStmt,
  BashEmitTagged,
  bash_emit_program
}
import v2.std.algebra { list_append, fold_list, list_snoc_item }
import v2.std.collection { List }
import v2.std.diagnostic { Accepted, Outcome, Rejected, NonEmptyDiagnostics }
import v2.std.node { Node }
import v2.std.compilers.lexing { symbol_lexeme }
import extdeps.git {
  GitDiffNameStatusComplete,
  GitDiffNameStatusTruncated,
  git_diff_name_status_parse,
  git_diff_status_entries_touched_paths,
  git_diff_status_entries_departed_paths,
  git_diff_status_entries_any_unknown
}

type FloorUnifiedDiffResult
  = UnifiedDiffOk { text: String }
  | UnifiedDiffFail { reason: String }

type FloorNameStatusDiffResult
  = NameStatusDiffOk { changed_paths: List<String>, departed_paths: List<String> }
  | NameStatusDiffFail { reason: String }

fn floor_ci_host_os() -> NodeControlPlane {
  HostOs { node: gunbc_ci_host }
}

fn floor_test_z_node(name: String) -> Node {
  bash_build_command_from_word_nodes(words: [
    bash_build_word_lit(text: "["),
    bash_build_word_lit(text: "-z"),
    bash_build_word_var(name: name),
    bash_build_word_lit(text: "]")
  ])
}

fn floor_test_n_node(name: String) -> Node {
  bash_build_command_from_word_nodes(words: [
    bash_build_word_lit(text: "["),
    bash_build_word_lit(text: "-n"),
    bash_build_word_var(name: name),
    bash_build_word_lit(text: "]")
  ])
}

fn floor_test_string_eq_node(name: String, value: String) -> Node {
  bash_build_command_from_word_nodes(words: [
    bash_build_word_lit(text: "["),
    bash_build_word_concat_from_nodes(parts: [
      bash_build_word_lit(text: "\""),
      bash_build_word_var(name: name),
      bash_build_word_lit(text: "\"")
    ]),
    bash_build_word_lit(text: "="),
    bash_build_word_lit(text: concat("\"", concat(value, "\""))),
    bash_build_word_lit(text: "]")
  ])
}

fn floor_assign_from_env_or_default_emit(
  env: String,
  default: String,
  target: String
) -> List<BashEmitSpecial> {
  [
    BashEmitTagged {
      stmt: BashEmitStmt {
        node: bash_build_if_from_stmts(
          cond: floor_test_z_node(name: env),
          then_stmts: [bash_build_assign_lit(name: target, text: default)]
        ),
        production_binding: ^bash_production_fold_if,
        rule_name: ^bash_relation_rule_fold_if
      }
    },
    BashEmitTagged {
      stmt: BashEmitStmt {
        node: bash_build_if_from_stmts(
          cond: floor_test_n_node(name: env),
          then_stmts: [bash_build_assign_var(name: target, var_name: env)]
        ),
        production_binding: ^bash_production_fold_if,
        rule_name: ^bash_relation_rule_fold_if
      }
    }
  ]
}

fn floor_unified_diff_injection_emit() -> List<BashEmitSpecial> {
  [
    BashEmitTagged {
      stmt: BashEmitStmt {
        node: bash_build_if_from_stmts(
          cond: floor_test_n_node(name: "GUNBC_CI_DIFF_UNIFIED"),
          then_stmts: [
            bash_build_command_from_word_nodes(words: [
              bash_build_word_lit(text: "printf"),
              bash_build_word_lit(text: "%s"),
              bash_build_word_var(name: "GUNBC_CI_DIFF_UNIFIED")
            ]),
            bash_build_exit(code: "0")
          ]
        ),
        production_binding: ^bash_production_fold_if,
        rule_name: ^bash_relation_rule_fold_if
      }
    }
  ]
}

fn floor_git_diff_two_dot_node() -> Node {
  bash_build_command_from_word_nodes(words: [
    bash_build_word_lit(text: "git"),
    bash_build_word_lit(text: "diff"),
    bash_build_word_lit(text: "-U0"),
    bash_build_word_var(name: "BASE"),
    bash_build_word_var(name: "HEAD")
  ])
}

fn floor_git_diff_merge_base_node() -> Node {
  bash_build_command_from_word_nodes(words: [
    bash_build_word_lit(text: "git"),
    bash_build_word_lit(text: "diff"),
    bash_build_word_lit(text: "-U0"),
    bash_build_word_concat_from_nodes(parts: [
      bash_build_word_var(name: "BASE"),
      bash_build_word_lit(text: "..."),
      bash_build_word_var(name: "HEAD")
    ])
  ])
}

fn floor_merge_base_uses_two_dot_range_node() -> Node {
  bash_build_or_else(
    left: floor_test_string_eq_node(name: "GUNBC_CI_DIFF_MERGE_BASE", value: "0"),
    right: floor_test_string_eq_node(name: "GUNBC_CI_DIFF_MERGE_BASE", value: "false")
  )
}

fn floor_git_diff_merge_base_mode_emit() -> List<BashEmitSpecial> {
  [
    BashEmitTagged {
      stmt: BashEmitStmt {
        node: bash_build_if_from_stmts(
          cond: floor_merge_base_uses_two_dot_range_node(),
          then_stmts: [floor_git_diff_two_dot_node()]
        ),
        production_binding: ^bash_production_fold_if,
        rule_name: ^bash_relation_rule_fold_if
      }
    },
    BashEmitIfNegatedSubshell {
      inner_stmts: [
        BashEmitStmt {
          node: floor_merge_base_uses_two_dot_range_node(),
          production_binding: ^bash_production_fold_or_else,
          rule_name: ^bash_relation_rule_fold_or_else
        }
      ],
      then_stmts: [
        BashEmitStmt {
          node: floor_git_diff_merge_base_node(),
          production_binding: ^bash_production_fold_command,
          rule_name: ^bash_relation_rule_fold_command
        }
      ]
    }
  ]
}

fn floor_git_diff_tail_emit(policy: DiffPolicy) -> List<BashEmitSpecial> {
  match policy.mode {
    DiffMergeBase => floor_git_diff_merge_base_mode_emit()
    DiffTwoDot =>
      [
        BashEmitTagged {
          stmt: BashEmitStmt {
            node: floor_git_diff_two_dot_node(),
            production_binding: ^bash_production_fold_command,
            rule_name: ^bash_relation_rule_fold_command
          }
        }
      ]
  }
}

data empty_floor_emit: List<BashEmitSpecial> = []

fn floor_concat_emit(a: List<BashEmitSpecial>, b: List<BashEmitSpecial>) -> List<BashEmitSpecial> {
  fold_list(
    xs: b,
    empty: a,
    cons: fn(acc, item) { list_snoc_item(xs: acc, item: item) }
  )
}

fn floor_git_diff_unified_emit(policy: DiffPolicy) -> List<BashEmitSpecial> {
  floor_concat_emit(
    a: floor_concat_emit(
      a: floor_concat_emit(
        a: floor_unified_diff_injection_emit(),
        b: floor_assign_from_env_or_default_emit(
          env: "GUNBC_CI_DIFF_BASE",
          default: policy.base,
          target: "BASE"
        )
      ),
      b: floor_assign_from_env_or_default_emit(
        env: "GUNBC_CI_DIFF_HEAD",
        default: policy.head,
        target: "HEAD"
      )
    ),
    b: floor_git_diff_tail_emit(policy: policy)
  )
}

fn floor_diff_script_emit_failure_reason(diagnostics: NonEmptyDiagnostics) -> String {
  concat(
    "floor_diff_observe: bash_emit_program rejected diff script emission: ",
    symbol_lexeme(sym: diagnostics.head.reason)
  )
}

fn floor_git_diff_unified_script(policy: DiffPolicy) -> Outcome<String> {
  bash_emit_program(
    statements: floor_git_diff_unified_emit(policy: policy),
    set_e: true
  )
}

fn floor_unified_diff_from_reconciliation(
  r: Reconciliation<HostEffectIntent, HostEffectEvidence>
) -> FloorUnifiedDiffResult {
  match r {
    Converged { evidence: e, applied: _ } =>
      match e {
        ShellEffectApplied { stdout: text, exit_code: code } =>
          if code == 0 {
            UnifiedDiffOk { text: text }
          } else {
            UnifiedDiffFail { reason: "git diff -U0 exited nonzero: invalid ref or not a git repository" }
          }
        ConvergePlanApplied { stdout: _, exit_code: _ } =>
          UnifiedDiffFail { reason: "floor_diff_observe: ConvergePlanApplied evidence is not a shell git-diff observation; typed mismatch" }
      }
    NotConverged { reason: why, applied: _ } =>
      UnifiedDiffFail { reason: why }
  }
}

fn floor_observe_git_diff_unified(policy: DiffPolicy) -> FloorUnifiedDiffResult {
  match floor_git_diff_unified_script(policy: policy) {
    Accepted { value: script, diagnostics: _ } =>
      floor_unified_diff_from_reconciliation(
        r: host_effect_apply(
          target: floor_ci_host_os(),
          effect: ShellCommand { script: script },
          evidence: host_effect_read_evidence,
          transport: LocalShell
        )
      )
    Rejected { diagnostics: d } =>
      UnifiedDiffFail { reason: floor_diff_script_emit_failure_reason(diagnostics: d) }
  }
}

fn floor_observe_git_diff_unified_for_ci() -> FloorUnifiedDiffResult {
  floor_observe_git_diff_unified(policy: gunbc_ci_spec.diff_policy)
}

data floor_name_status_injection_encoding_note: String = "INJECTION TRANSPORT ENCODING (proven by execution, 2026-07-10): the name-status wire format is NUL-separated (git diff --name-status -z; git.dag splits on from_code_point(0)), but the injection transport — a POSIX environment variable — is a C string and can NEVER carry a NUL byte (Rust set_var refuses it; a shell variable would truncate it). So the injected value at rest is the SAME record structure with each NUL written as the octal escape \\000, and this arm decodes it at the boundary with printf %b (POSIX: \\0ddd emits the byte), yielding the identical byte stream the real-git arm produces. One wire format, one parser; only the at-rest encoding differs, and it is decoded before any consumer sees it. Constraint on injectors (this channel is probe-only): paths containing backslashes would need their backslashes doubled for %b — fixture repo paths contain none. The unified-diff arm stays %s: unified text is NUL-free."

fn floor_name_status_diff_injection_emit() -> List<BashEmitSpecial> {
  [
    BashEmitTagged {
      stmt: BashEmitStmt {
        node: bash_build_if_from_stmts(
          cond: floor_test_n_node(name: "GUNBC_CI_DIFF_NAME_STATUS"),
          then_stmts: [
            bash_build_command_from_word_nodes(words: [
              bash_build_word_lit(text: "printf"),
              bash_build_word_lit(text: "%b"),
              bash_build_word_var(name: "GUNBC_CI_DIFF_NAME_STATUS")
            ]),
            bash_build_exit(code: "0")
          ]
        ),
        production_binding: ^bash_production_fold_if,
        rule_name: ^bash_relation_rule_fold_if
      }
    }
  ]
}

fn floor_git_diff_name_status_two_dot_node() -> Node {
  bash_build_command_from_word_nodes(words: [
    bash_build_word_lit(text: "git"),
    bash_build_word_lit(text: "diff"),
    bash_build_word_lit(text: "--name-status"),
    bash_build_word_lit(text: "-z"),
    bash_build_word_var(name: "BASE"),
    bash_build_word_var(name: "HEAD")
  ])
}

fn floor_git_diff_name_status_merge_base_node() -> Node {
  bash_build_command_from_word_nodes(words: [
    bash_build_word_lit(text: "git"),
    bash_build_word_lit(text: "diff"),
    bash_build_word_lit(text: "--name-status"),
    bash_build_word_lit(text: "-z"),
    bash_build_word_concat_from_nodes(parts: [
      bash_build_word_var(name: "BASE"),
      bash_build_word_lit(text: "..."),
      bash_build_word_var(name: "HEAD")
    ])
  ])
}

fn floor_git_diff_name_status_merge_base_mode_emit() -> List<BashEmitSpecial> {
  [
    BashEmitTagged {
      stmt: BashEmitStmt {
        node: bash_build_if_from_stmts(
          cond: floor_merge_base_uses_two_dot_range_node(),
          then_stmts: [floor_git_diff_name_status_two_dot_node()]
        ),
        production_binding: ^bash_production_fold_if,
        rule_name: ^bash_relation_rule_fold_if
      }
    },
    BashEmitIfNegatedSubshell {
      inner_stmts: [
        BashEmitStmt {
          node: floor_merge_base_uses_two_dot_range_node(),
          production_binding: ^bash_production_fold_or_else,
          rule_name: ^bash_relation_rule_fold_or_else
        }
      ],
      then_stmts: [
        BashEmitStmt {
          node: floor_git_diff_name_status_merge_base_node(),
          production_binding: ^bash_production_fold_command,
          rule_name: ^bash_relation_rule_fold_command
        }
      ]
    }
  ]
}

fn floor_git_diff_name_status_tail_emit(policy: DiffPolicy) -> List<BashEmitSpecial> {
  match policy.mode {
    DiffMergeBase => floor_git_diff_name_status_merge_base_mode_emit()
    DiffTwoDot =>
      [
        BashEmitTagged {
          stmt: BashEmitStmt {
            node: floor_git_diff_name_status_two_dot_node(),
            production_binding: ^bash_production_fold_command,
            rule_name: ^bash_relation_rule_fold_command
          }
        }
      ]
  }
}

fn floor_git_diff_name_status_emit(policy: DiffPolicy) -> List<BashEmitSpecial> {
  floor_concat_emit(
    a: floor_concat_emit(
      a: floor_concat_emit(
        a: floor_name_status_diff_injection_emit(),
        b: floor_assign_from_env_or_default_emit(
          env: "GUNBC_CI_DIFF_BASE",
          default: policy.base,
          target: "BASE"
        )
      ),
      b: floor_assign_from_env_or_default_emit(
        env: "GUNBC_CI_DIFF_HEAD",
        default: policy.head,
        target: "HEAD"
      )
    ),
    b: floor_git_diff_name_status_tail_emit(policy: policy)
  )
}

fn floor_git_diff_name_status_script(policy: DiffPolicy) -> Outcome<String> {
  bash_emit_program(
    statements: floor_git_diff_name_status_emit(policy: policy),
    set_e: true
  )
}

fn floor_name_status_diff_from_reconciliation(
  r: Reconciliation<HostEffectIntent, HostEffectEvidence>
) -> FloorNameStatusDiffResult {
  match r {
    Converged { evidence: e, applied: _ } =>
      match e {
        ShellEffectApplied { stdout: text, exit_code: code } =>
          if code != 0 {
            NameStatusDiffFail { reason: "git diff --name-status -z exited nonzero: invalid ref or not a git repository" }
          } else {
            match git_diff_name_status_parse(raw: text) {
              GitDiffNameStatusTruncated { pending: _, entries: _ } =>
                NameStatusDiffFail { reason: "git diff --name-status -z observation ended mid-record (truncated stream)" }
              GitDiffNameStatusComplete { entries: entries } =>
                if git_diff_status_entries_any_unknown(entries: entries) {
                  NameStatusDiffFail { reason: "unrecognized git diff --name-status status letter in observation" }
                } else {
                  NameStatusDiffOk {
                    changed_paths: git_diff_status_entries_touched_paths(entries: entries),
                    departed_paths: git_diff_status_entries_departed_paths(entries: entries)
                  }
                }
            }
          }
        ConvergePlanApplied { stdout: _, exit_code: _ } =>
          NameStatusDiffFail { reason: "floor_diff_observe: ConvergePlanApplied evidence is not a shell git-diff observation; typed mismatch" }
      }
    NotConverged { reason: why, applied: _ } =>
      NameStatusDiffFail { reason: why }
  }
}

fn floor_observe_git_diff_name_status(policy: DiffPolicy) -> FloorNameStatusDiffResult {
  match floor_git_diff_name_status_script(policy: policy) {
    Accepted { value: script, diagnostics: _ } =>
      floor_name_status_diff_from_reconciliation(
        r: host_effect_apply(
          target: floor_ci_host_os(),
          effect: ShellCommand { script: script },
          evidence: host_effect_read_evidence,
          transport: LocalShell
        )
      )
    Rejected { diagnostics: d } =>
      NameStatusDiffFail { reason: floor_diff_script_emit_failure_reason(diagnostics: d) }
  }
}

fn floor_observe_git_diff_name_status_for_ci() -> FloorNameStatusDiffResult {
  floor_observe_git_diff_name_status(policy: gunbc_ci_spec.diff_policy)
}

fn floor_diff_script_serializes_git_diff_unified() -> Bool {
  match floor_git_diff_unified_script(policy: gunbc_ci_spec.diff_policy) {
    Accepted { value: script, diagnostics: _ } =>
      string_contains(s: script, pattern: "'git'")
        && string_contains(s: script, pattern: "'diff'")
        && string_contains(s: script, pattern: "GUNBC_CI_DIFF_UNIFIED")
    Rejected { diagnostics: _ } => false
  }
}

fn floor_diff_script_serializes_git_diff_name_status() -> Bool {
  match floor_git_diff_name_status_script(policy: gunbc_ci_spec.diff_policy) {
    Accepted { value: script, diagnostics: _ } =>
      string_contains(s: script, pattern: "'git'")
        && string_contains(s: script, pattern: "'diff'")
        && string_contains(s: script, pattern: "'--name-status'")
        && string_contains(s: script, pattern: "'-z'")
        && string_contains(s: script, pattern: "GUNBC_CI_DIFF_NAME_STATUS")
    Rejected { diagnostics: _ } => false
  }
}
