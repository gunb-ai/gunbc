  GitDiffWindowObservation
}
import extdeps.shell

type FloorUnifiedDiffResult
  = UnifiedDiffOk { text: String }
  | UnifiedDiffFail { reason: String }

type FloorNameStatusDiffResult
  = NameStatusDiffOk { changed_paths: List<String>, departed_paths: List<String> }
  | NameStatusDiffFail { reason: String }

fn floor_env_override_or(env_name: NonEmptyStr, default: String) -> String {
  let env = shell.Env.Get(name: env_name)
  match env.value {
    Present { value: raw } => raw
    Absent => default
  }
}

fn floor_env_optional(env_name: NonEmptyStr) -> String? {
  shell.Env.Get(name: env_name).value
}

// The affected-set base is RESOLVED from the CI event and optional exact diff-window wire, not a
// constant (gunbc.diff_baseline; the de-fork of the origin/main policy-as-literal, DESIGN section
// 3(c)). floor_observe_ci_diff_event reads GUNBC_CI_DIFF_BASE (operator override),
// GITHUB_EVENT_NAME, GITHUB_BASE_REF (GitHub pull-request TARGET BRANCH name only), GITHUB_SHA
// (push self-compare refusal), push before from GITHUB_EVENT_PATH (extdeps.github.push_event), and
// exact replay from GUNBC_DIFF_WINDOW_PATH (gunbc.git_diff_change_window). pull_request with branch
// base → MergeTarget (triple-dot); diff window → ExactReplayBoundary (two-dot, typed GitObjectIds);
// push → PushBefore; other CI events → PushParent. Unrecognized events and malformed diff-window
// wire REFUSE — never widen. When both GUNBC_DIFF_WINDOW_PATH and GUNBC_CI_DIFF_BASE are set,
// resolve_diff_baseline refuses with BaselineSourceConflict.

fn floor_push_before_refusal(prefix: String, detail: String) -> PushBeforeInput {
  PushBeforeInputRefused { reason: concat(concat(prefix, detail), "; halting the floor (AFFECTED-SET REFUSAL)") }
}

fn floor_observe_push_before_input(event_name: String) -> PushBeforeInput? {
  if event_name != github_event_name_push {
    none
  } else {
    match floor_env_optional(env_name: github_event_path_env) {
      Absent =>
        Present {
          value: floor_push_before_refusal(
            prefix: "push event but GITHUB_EVENT_PATH is unset — ",
            detail: "cannot read before SHA from event payload"
          )
        }
      Present { value: path } =>
        if path == "" {
          Present {
            value: floor_push_before_refusal(
              prefix: "push event but GITHUB_EVENT_PATH is empty — ",
              detail: "cannot read before SHA from event payload"
            )
          }
        } else {
          match push_before_from_event_path(path: path) {
            PushBeforeObserved { sha: sha } =>
              Present { value: PushBeforeSha { sha: sha as String } }
            PushBeforeAbsent { detail: detail } =>
              Present {
                value: floor_push_before_refusal(
                  prefix: "push event before SHA absent — ",
                  detail: detail
                )
              }
            PushBeforeZeroSha =>
              Present { value: PushBeforeZeroShaInput }
            PushBeforeMalformed { detail: detail } =>
              Present {
                value: floor_push_before_refusal(
                  prefix: "push event before SHA malformed — ",
                  detail: detail
                )
              }
            PushEventPayloadReadRefused { path: event_path, cause: cause } =>
              Present {
                value: floor_push_before_refusal(
                  prefix: concat(
                    "push event payload unreadable at ",
                    concat(event_path, " — ")
                  ),
                  detail: cause
                )
              }
          }
        }
    }
  }
}

fn floor_observe_diff_window() -> GitDiffWindowObservation? {
  match floor_env_optional(env_name: gunbc_diff_window_path_env) {
    Absent => none
    Present { value: path } =>
      if path == "" {
        none
      } else {
        Present { value: git_diff_window_from_path(path: path) }
      }
  }
}

fn floor_observe_ci_diff_event() -> CiDiffEvent {
  let event_name = floor_env_override_or(env_name: github_event_name_env, default: "")
  CiDiffEvent {
    override_ref: floor_env_optional(env_name: "GUNBC_CI_DIFF_BASE" as NonEmptyStr),
    event_name: event_name,
    base_ref: floor_env_optional(env_name: github_base_ref_env),
    push_before: floor_observe_push_before_input(event_name: event_name),
    head_sha: floor_env_optional(env_name: github_sha_variable_name as NonEmptyStr),
    diff_window: floor_observe_diff_window()
  }
}

fn floor_resolve_baseline(policy: DiffPolicy) -> DiffBaselineResolution {
  let push_parent = policy.base as GitRef
  resolve_diff_baseline(
    event: floor_observe_ci_diff_event(),
    push_parent_ref: push_parent,
    default_remote_name: git_remote_ref_parts(ref: push_parent).remote
  )
}

fn floor_resolved_head(policy: DiffPolicy) -> String {
  floor_env_override_or(env_name: "GUNBC_CI_DIFF_HEAD" as NonEmptyStr, default: policy.head)
}

fn floor_diff_mode_for_baseline(baseline: DiffBaseline, policy: DiffPolicy) -> DiffMode {
  match baseline {
    PushBefore { ref: _ } => DiffTwoDot
    ExactReplayBoundary { base: _, head: _, observed_relation: _ } => DiffTwoDot
    MergeTarget { ref: _ } => policy.mode
    PushParent { ref: _ } => policy.mode
    OperatorOverride { ref: _ } => policy.mode
  }
}

fn floor_git_diff_range_of_mode(mode: DiffMode) -> GitDiffRange {
  match mode {
    DiffMergeBase => ThreeDot
    DiffTwoDot => TwoDot
  }
}

fn floor_run_git_diff_unified(base: String, head: String, mode: DiffMode) -> FloorUnifiedDiffResult {
  let result = git.Core.DiffUnified0(base: base, head: head, range: floor_git_diff_range_of_mode(mode: mode))
  if result.success {
    UnifiedDiffOk { text: result.diff }
  } else {
    UnifiedDiffFail { reason: "git diff -U0 exited nonzero: invalid ref or not a git repository" }
  }
}

fn floor_observe_git_diff_unified(policy: DiffPolicy) -> FloorUnifiedDiffResult {
  let unified_injection = shell.Env.Get(name: "GUNBC_CI_DIFF_UNIFIED" as NonEmptyStr)
  match unified_injection.value {
    Present { value: injected } => UnifiedDiffOk { text: injected }
    Absent =>
      match floor_resolve_baseline(policy: policy) {
        BaselineRefused { reason: reason } => UnifiedDiffFail { reason: reason }
        BaselineSourceConflict { window_detail: detail, override_ref: override_ref } =>
          UnifiedDiffFail {
            reason: join([
              "baseline source conflict — ",
              detail,
              " while GUNBC_CI_DIFF_BASE is set to ",
              override_ref,
              "; halting the floor (AFFECTED-SET REFUSAL)",
            ], ""),
          }
        BaselineSelected { baseline: baseline } =>
          floor_run_git_diff_unified(
            base: diff_baseline_diff_base(b: baseline),
            head: diff_baseline_diff_head(
              b: baseline,
              default_head: floor_resolved_head(policy: policy)
            ),
            mode: floor_diff_mode_for_baseline(baseline: baseline, policy: policy)
          )
      }
  }
}

fn floor_observe_git_diff_unified_for_ci() -> FloorUnifiedDiffResult {
  floor_observe_git_diff_unified(policy: gunbc_ci_spec.diff_policy)
}

data floor_diff_baseline_readout_note: String = "A PROJECTION of the already-resolved baseline FOR DIAGNOSTICS ONLY — it observes no git, decides nothing, and adds no second baseline authority (resolve_diff_baseline stays the single one, DESIGN section 3). Its consumer is the affected-set no-observed-change diagnostic in the seed executor: when the observation returns zero changed paths, the receipt must be able to NAME the baseline the comparison was made against, because 'nothing changed' and 'the baseline could not express what changed' are different states with different remedies and the second is what a self-referential baseline produces (a push whose base ref is the pushed ref itself). Locating the state requires naming its base and event, so the diagnostic reads them from here rather than re-deriving them.

THE FULL HISTORY OF THAT CLAIM, recorded because this row briefly said the opposite and a corrected sentence that hides its own correction teaches nothing. gunbc#7953's FIRST repair made this lossy \{ref, event_name\} readout a DECIDING consumer: the frozen-roster monotonicity gate took it and then reconstructed the head and relation it does not carry, which is how merge-base came to be imposed on every baseline arm and how a rewritten push could reintroduce a frozen row unnoticed. The RECUT in that same PR restored this row to diagnostics-only and introduced FloorDiffComparisonReadout beside it for consumers that decide. So the rule is not that a projection may never gain a deciding consumer — it is that a LOSSY projection may not, because the missing members do not stay missing, they get invented. This note carried the interim claim for exactly one commit; it is corrected here rather than reverted silently.
"

type FloorDiffBaselineReadout
  = BaselineReadout { ref: String, event_name: String }
  | BaselineReadoutRefused { reason: String }

fn floor_observe_diff_baseline_readout(policy: DiffPolicy) -> FloorDiffBaselineReadout {
  match floor_resolve_baseline(policy: policy) {
    BaselineRefused { reason: reason } => BaselineReadoutRefused { reason: reason }
    BaselineSourceConflict { window_detail: detail, override_ref: override_ref } =>
      BaselineReadoutRefused {
        reason: join([
          "baseline source conflict — ",
          detail,
          " while GUNBC_CI_DIFF_BASE is set to ",
          override_ref,
          "; halting the floor (AFFECTED-SET REFUSAL)",
        ], ""),
      }
    BaselineSelected { baseline: baseline } =>
      BaselineReadout {
        ref: diff_baseline_ref(b: baseline) as String,
        event_name: floor_observe_ci_diff_event().event_name
      }
  }
}

fn floor_observe_diff_baseline_readout_for_ci() -> FloorDiffBaselineReadout {
  floor_observe_diff_baseline_readout(policy: gunbc_ci_spec.diff_policy)
}

data floor_diff_comparison_readout_law: String = "THE PROJECTION A DECIDING CONSUMER MUST TAKE, and the defect that produced it. The baseline readout above answers 'which ref' and nothing else, which is exactly enough to LOCATE a diagnostic and not nearly enough to COMPARE two trees. gunbc#7953 took that lossy projection into the frozen-roster monotonicity gate and then reconstructed the missing half in Rust by imposing merge-base on every arm — deleting the origin/main source fork and immediately re-forking the RELATION instead. That is a fail-open, not a cosmetic slip: PushBefore and ExactReplayBoundary are exact two-dot comparisons, so a non-fast-forward push whose before SHA is not an ancestor gets compared against the common ancestor instead, and a frozen row REINTRODUCED by that push reads as no addition at all. Executed counterexample: roster A=\{X\}, push before B=\{\} (X removed), pushed head H=\{X\} off A; the true two-dot answer H minus B is \{X\} and must refuse, while merge-base(B,H)=A gives H minus A=\{\} and passes real growth.

WHAT THIS CARRIER FIXES, stated as the law rather than as the patch: a comparison is a TRIPLE — resolved base, resolved head, and the relation between them — and it must cross the seam as one value. The mode arm is the discriminator, so a consumer cannot silently pick a relation, and the head is the SELECTED head rather than an ambient one, because ExactReplayBoundary carries its own exact head and substituting the checkout's HEAD is the same class of substitution one endpoint over. Kind rides along to locate refusals and decides nothing. Deriving all three here rather than in each consumer keeps resolve_diff_baseline the single authority (DESIGN section 3); a second consumer that re-derived any member would be the fork this row exists to close."

type FloorDiffComparisonReadout
  = DirectComparison {
      base: String,
      head: String,
      kind: DiffBaselineKind
    }
  | MergeBaseComparison {
      base: String,
      head: String,
      kind: DiffBaselineKind
    }
  | ComparisonReadoutRefused { reason: String }

fn floor_comparison_of_mode(
  mode: DiffMode,
  base: String,
  head: String,
  kind: DiffBaselineKind
) -> FloorDiffComparisonReadout {
  match mode {
    DiffTwoDot =>
      DirectComparison { base: base, head: head, kind: kind }
    DiffMergeBase =>
      MergeBaseComparison { base: base, head: head, kind: kind }
  }
}

fn floor_observe_diff_comparison_readout(policy: DiffPolicy) -> FloorDiffComparisonReadout {
  match floor_resolve_baseline(policy: policy) {
    BaselineRefused { reason: reason } => ComparisonReadoutRefused { reason: reason }
    BaselineSourceConflict { window_detail: detail, override_ref: override_ref } =>
      ComparisonReadoutRefused {
        reason: join([
          "baseline source conflict — ",
          detail,
          " while GUNBC_CI_DIFF_BASE is set to ",
          override_ref,
          "; halting the floor (AFFECTED-SET REFUSAL)",
        ], ""),
      }
    BaselineSelected { baseline: baseline } =>
      floor_comparison_of_mode(
        mode: floor_diff_mode_for_baseline(baseline: baseline, policy: policy),
        base: diff_baseline_diff_base(b: baseline),
        head: diff_baseline_diff_head(
          b: baseline,
          default_head: floor_resolved_head(policy: policy)
        ),
        kind: diff_baseline_kind(b: baseline)
      )
  }
}

fn floor_observe_diff_comparison_readout_for_ci() -> FloorDiffComparisonReadout {
  floor_observe_diff_comparison_readout(policy: gunbc_ci_spec.diff_policy)
}

fn floor_name_status_from_raw(raw: String) -> FloorNameStatusDiffResult {
  match git_diff_name_status_parse(raw: raw) {
    GitDiffNameStatusTruncated { pending: _, entries: _ } =>
      NameStatusDiffFail { reason: "git diff --name-status -z observation ended mid-record (truncated stream)" }
    GitDiffNameStatusComplete { entries: entries } =>
      if git_diff_status_entries_any_unknown(entries: entries) {
        NameStatusDiffFail { reason: "unrecognized git diff --name-status status letter in observation" }
      } else {
        NameStatusDiffOk {
          changed_paths: git_diff_status_entries_touched_paths(entries: entries),
          departed_paths: git_diff_status_entries_departed_paths(entries: entries)
        }
      }
  }
}

fn floor_decode_injected_name_status(injected: String) -> String {
  join(split(s: injected, delimiter: "\\000"), git_diff_name_status_field_separator)
}

fn floor_run_git_diff_name_status(base: String, head: String, mode: DiffMode) -> FloorNameStatusDiffResult {
  let result = git.Core.DiffNameStatus(
    base: base,
    head: head,
    range: floor_git_diff_range_of_mode(mode: mode)
  )
  if !result.success {
    NameStatusDiffFail { reason: "git diff --name-status -z exited nonzero: invalid ref or not a git repository" }
  } else {
    floor_name_status_from_raw(raw: result.raw)
  }
}

fn floor_observe_git_diff_name_status(policy: DiffPolicy) -> FloorNameStatusDiffResult {
  let name_status_injection = shell.Env.Get(name: "GUNBC_CI_DIFF_NAME_STATUS" as NonEmptyStr)
  match name_status_injection.value {
    Present { value: injected } =>
      floor_name_status_from_raw(raw: floor_decode_injected_name_status(injected: injected))
    Absent =>
      match floor_resolve_baseline(policy: policy) {
        BaselineRefused { reason: reason } => NameStatusDiffFail { reason: reason }
        BaselineSourceConflict { window_detail: detail, override_ref: override_ref } =>
          NameStatusDiffFail {
            reason: join([
              "baseline source conflict — ",
              detail,
              " while GUNBC_CI_DIFF_BASE is set to ",
              override_ref,
              "; halting the floor (AFFECTED-SET REFUSAL)",
            ], ""),
          }
        BaselineSelected { baseline: baseline } =>
          floor_run_git_diff_name_status(
            base: diff_baseline_diff_base(b: baseline),
            head: diff_baseline_diff_head(
              b: baseline,
              default_head: floor_resolved_head(policy: policy)
            ),
            mode: floor_diff_mode_for_baseline(baseline: baseline, policy: policy)
          )
      }
  }
}

fn floor_observe_git_diff_name_status_for_ci() -> FloorNameStatusDiffResult {
  floor_observe_git_diff_name_status(policy: gunbc_ci_spec.diff_policy)
}

// BASE-REVISION TEST-DECLARATION CENSUS.
//
// THE CAPABILITY `v2.workflow.floor_enrolment_margin` NAMED as its next-rung trigger: names
// declared at the resolved diff base, per path, sufficient for "was this identity declared at
// the merge base". Absence of a path and failure to observe the base are different states.
// `git show <base>:<path>` exits 128 for both, so absence is decided against the base tree
// listing (`git.Inspect.ListTreePathsAtRevision`) BEFORE any show: a path the listing does not
// carry is empty names by construction and is never shown; a show that then fails is
// unreadable, with no empty-names arm left to absorb it. The same construction lives in
// `tools.pr_containment_instrument` `base_file_reading`; this row asks a different question
// (declaration names, not line text) of the same two git facts.
//
// THIS CENSUS IS PATH-KEYED AND RENAME-BLIND. Git lists and shows one path at one revision.
// A rename destination is absent from the base tree under its NEW spelling, which is a true
// empty-names answer for that path and must not be fused with unreadability. Following the
// move — subtracting names that lived at `rename from` — is the enrolment consumer's join,
// not a second observation. 302ms is not a fact this observation carries. The percentile
// that consumes this census sits in `floor_enrolment_margin` and is p90 over TWELVE green
// main runs.

type FloorBasePathTestDecls {
  path: String
  names: List<String>
}

type FloorBaseTestDeclCensus
  = BaseTestDeclCensus { rows: List<FloorBasePathTestDecls> }
  | BaseTestDeclCensusRefused { reason: String }

type FloorShowObservation {
  success: Bool
  content: String
  stderr: String
}

fn floor_base_paths_present(paths_nul: String) -> Map<String, Bool> {
  fold(
    split(s: paths_nul, delimiter: git_diff_name_status_field_separator),
    init: empty_map(),
    f: fn(acc, p) {
      if p == "" {
        acc
      } else {
        map_insert(m: acc, key: p, value: true)
      }
    }
  )
}

fn floor_base_census_acc_append(
  acc: FloorBaseTestDeclCensus,
  path: String,
  names: List<String>
) -> FloorBaseTestDeclCensus {
  match acc {
    BaseTestDeclCensusRefused { reason: reason } =>
      BaseTestDeclCensusRefused { reason: reason }
    BaseTestDeclCensus { rows: rows } =>
      BaseTestDeclCensus {
        rows: concat(rows, [FloorBasePathTestDecls { path: path, names: names }])
      }
  }
}

fn floor_base_census_step(
  acc: FloorBaseTestDeclCensus,
  base: String,
  paths_present: Map<String, Bool>,
  path: String,
  shows: Map<String, FloorShowObservation>
) -> FloorBaseTestDeclCensus {
  match acc {
    BaseTestDeclCensusRefused { reason: reason } =>
      BaseTestDeclCensusRefused { reason: reason }
    BaseTestDeclCensus { rows: _ } =>
      match map_lookup(m: paths_present, key: path) {
        Absent => floor_base_census_acc_append(acc: acc, path: path, names: [])
        Present { value: _ } =>
          match map_lookup(m: shows, key: path) {
            Absent =>
              BaseTestDeclCensusRefused {
                reason: join([
                  "git.Core.Show observation missing for a path the base tree lists: ",
                  base,
                  ":",
                  path,
                  "; halting the floor (BASE-DECLARATION-CENSUS REFUSAL)",
                ], "")
              }
            Present { value: shown } =>
              if !shown.success {
                BaseTestDeclCensusRefused {
                  reason: join([
                    "git.Core.Show failed for a path the base tree lists: ",
                    base,
                    ":",
                    path,
                    " — ",
                    shown.stderr,
                    "; halting the floor (BASE-DECLARATION-CENSUS REFUSAL)",
                  ], "")
                }
              } else {
                floor_base_census_acc_append(
                  acc: acc,
                  path: path,
                  names: floor_discovery_scan_test_decl_names(content: shown.content)
                )
              }
          }
      }
  }
}

fn floor_base_test_decl_census_from_listing(
  base: String,
  paths: List<String>,
  listing_success: Bool,
  listing_stderr: String,
  paths_nul: String,
  shows: Map<String, FloorShowObservation>
) -> FloorBaseTestDeclCensus {
  let empty = fold(paths, init: true, f: fn(_acc, _path) { false })
  if empty {
    BaseTestDeclCensus { rows: [] }
  } else if !listing_success {
    BaseTestDeclCensusRefused {
      reason: join([
        "git.Inspect.ListTreePathsAtRevision failed for ",
        base,
        " — ",
        listing_stderr,
        "; halting the floor (BASE-DECLARATION-CENSUS REFUSAL)",
      ], "")
    }
  } else {
    let paths_present = floor_base_paths_present(paths_nul: paths_nul)
    fold(paths, init: BaseTestDeclCensus { rows: [] }, f: fn(acc, path) {
      floor_base_census_step(
        acc: acc,
        base: base,
        paths_present: paths_present,
        path: path,
        shows: shows
      )
    })
  }
}

fn floor_run_base_test_decl_census(base: String, paths: List<String>) -> FloorBaseTestDeclCensus {
  let empty = fold(paths, init: true, f: fn(_acc, _path) { false })
  if empty {
    BaseTestDeclCensus { rows: [] }
  } else {
    let listed = git.Inspect.ListTreePathsAtRevision(ref: base as GitRef)
    if !listed.success {
      floor_base_test_decl_census_from_listing(
        base: base,
        paths: paths,
        listing_success: false,
        listing_stderr: listed.stderr,
        paths_nul: "",
        shows: empty_map()
      )
    } else {
      let paths_present = floor_base_paths_present(paths_nul: listed.paths_nul)
      let shows = fold(paths, init: empty_map(), f: fn(acc, path) {
        match map_lookup(m: paths_present, key: path) {
          Absent => acc
          Present { value: _ } => {
            let shown = git.Core.Show(ref: base as GitRef, path: path as FilePath)
            map_insert(
              m: acc,
              key: path,
              value: FloorShowObservation {
                success: shown.success,
                content: shown.content,
                stderr: shown.stderr
              }
            )
          }
        }
      })
      floor_base_test_decl_census_from_listing(
        base: base,
        paths: paths,
        listing_success: true,
        listing_stderr: listed.stderr,
        paths_nul: listed.paths_nul,
        shows: shows
      )
    }
  }
}

fn floor_base_test_decl_names_for_path(
  census: FloorBaseTestDeclCensus,
  path: String
) -> List<String> {
  match census {
    BaseTestDeclCensusRefused { reason: _ } => []
    BaseTestDeclCensus { rows: rows } =>
      fold(rows, init: [], f: fn(acc, row) {
        if count(acc) != 0 {
          acc
        } else if row.path == path {
          row.names
        } else {
          acc
        }
      })
  }
}

