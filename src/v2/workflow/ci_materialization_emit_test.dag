module v2.workflow.ci_materialization_emit_test

import v2.workflow.ci_materialization_emit { ci_sccache_provider_shell_injection }

data ci_sccache_provider_emit_golden_note: String = "Hand-authored golden independent of grammar row spellings; byte test compares emit output against this literal (#6467 pattern). Block-bodied if_else (#7277) emits multi-line then/else arms for the three-step bound branch."

data ci_sccache_provider_shell_injection_golden: String = concat(
  concat(
    concat(
      "if sccache --show-stats >/dev/null 2>&1; then\n",
      "echo \"RUSTC_WRAPPER=sccache\" >> \"$GITHUB_ENV\"\n"
    ),
    concat(
      concat(
        "echo \"CARGO_INCREMENTAL=0\" >> \"$GITHUB_ENV\"\n",
        "printf '%s\\n' \"CiSccacheProviderReceipt: provider=bound catalog=sccache_local\"\n"
      ),
      "else\n"
    )
  ),
  concat(
    "printf '%s\\n' \"CiSccacheProviderReceipt: provider=SKIPPED catalog=sccache_local host=$(hostname) cause=daemon-unavailable; the release build runs UNCACHED — a counted degradation, not a supported mode (host_build_cache_provision P1b should have converged this host)\"\n",
    "fi"
  )
)

test fn ci_sccache_provider_shell_injection_emit_matches_golden_holds() -> Bool {
  ci_sccache_provider_shell_injection() == ci_sccache_provider_shell_injection_golden
}
