module v2.workflow.ci_materialization_emit_test

import v2.workflow.ci_materialization_emit { ci_sccache_provider_shell_injection }

data ci_sccache_provider_emit_golden_note: String = "Hand-authored golden independent of grammar row spellings; byte test compares emit output against this literal (#6467 pattern)."

data ci_sccache_provider_shell_injection_golden: String = "if sccache --show-stats >/dev/null 2>&1; then\necho \"RUSTC_WRAPPER=sccache\" >> \"$GITHUB_ENV\"\necho \"CARGO_INCREMENTAL=0\" >> \"$GITHUB_ENV\"\nprintf '%s\\n' \"CiSccacheProviderReceipt: provider=bound catalog=sccache_local\"\nelse\nprintf '%s\\n' \"CiSccacheProviderReceipt: provider=SKIPPED catalog=sccache_local host=$(hostname) cause=daemon-unavailable; the release build runs UNCACHED — a counted degradation, not a supported mode (host_build_cache_provision P1b should have converged this host)\"\nfi"

test fn ci_sccache_provider_shell_injection_emit_matches_golden_holds() -> Bool {
  ci_sccache_provider_shell_injection() == ci_sccache_provider_shell_injection_golden
}
