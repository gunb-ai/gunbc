import v2.test.lens_ownership.resource_dependency {
  ownership_resource_dependency_claim_passes
}

fn lens_ownership_family_gate() -> Bool {
  ownership_resource_dependency_claim_passes
}

test data witness_lens_ownership_family_gate_closed: Bool = lens_ownership_family_gate()
