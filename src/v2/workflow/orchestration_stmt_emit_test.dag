module v2.workflow.orchestration_stmt_emit_test

import v2.workflow.shell_emit { emit_shell_stmt, emit_shell_program }
import extdeps.languages.bash.program {
  ShellStmt,
  Command,
  Subshell,
  Exit,
  RawLine,
  Assign,
  If,
  AndOr,
  Pipe,
  EnvPrefixed,
  WithRedir,
  Heredoc,
  AndThen,
  OrElse,
  StderrToNull,
  ShellProgram,
  ShellWord,
  Lit,
  VarRef,
  serialize_stmt,
  serialize_bash
}
import v2.std.diagnostic { Accepted, None, Rejected }

fn stmt_emits_oracle(s: ShellStmt) -> Bool {
  match emit_shell_stmt(s: s) {
    Accepted { value: src, diagnostics: dg } =>
      (src.carried == serialize_stmt(s: s)) && (dg == None)
    Rejected { diagnostics: _ } => false
  }
}

fn stmt_differs_from_oracle_of(s: ShellStmt, other: ShellStmt) -> Bool {
  match emit_shell_stmt(s: s) {
    Accepted { value: src, diagnostics: _ } => src.carried != serialize_stmt(s: other)
    Rejected { diagnostics: _ } => false
  }
}

fn cmd_echo_hi() -> ShellStmt {
  Command { words: [Lit { text: "echo" }, Lit { text: "hi" }] }
}

fn cmd_true() -> ShellStmt {
  Command { words: [Lit { text: "true" }] }
}

test fn stmt_command_byte_identical_holds() -> Bool {
  stmt_emits_oracle(s: cmd_echo_hi())
}

test fn stmt_command_has_teeth_holds() -> Bool {
  stmt_differs_from_oracle_of(s: cmd_echo_hi(), other: Command { words: [Lit { text: "echo" }, Lit { text: "bye" }] })
}

test fn stmt_exit_byte_identical_holds() -> Bool {
  stmt_emits_oracle(s: Exit { code: 0 })
}

test fn stmt_exit_has_teeth_holds() -> Bool {
  stmt_differs_from_oracle_of(s: Exit { code: 0 }, other: Exit { code: 1 })
}

test fn stmt_rawline_byte_identical_holds() -> Bool {
  stmt_emits_oracle(s: RawLine { text: "! ( foo )" })
}

test fn stmt_subshell_of_command_byte_identical_holds() -> Bool {
  stmt_emits_oracle(s: Subshell { body: [cmd_true()] })
}

test fn stmt_subshell_of_command_has_teeth_holds() -> Bool {
  stmt_differs_from_oracle_of(s: Subshell { body: [cmd_true()] }, other: Subshell { body: [cmd_echo_hi()] })
}

test fn stmt_subshell_of_subshell_byte_identical_holds() -> Bool {
  stmt_emits_oracle(s: Subshell { body: [Subshell { body: [cmd_true()] }] })
}

fn assign_root() -> ShellStmt {
  Assign { name: "ROOT", value: VarRef { name: "PWD" } }
}

test fn stmt_assign_byte_identical_holds() -> Bool {
  stmt_emits_oracle(s: assign_root())
}

test fn stmt_assign_has_teeth_holds() -> Bool {
  stmt_differs_from_oracle_of(s: assign_root(), other: Assign { name: "ROOT", value: Lit { text: "x" } })
}

fn if_true_echo() -> ShellStmt {
  If { cond: cmd_true(), then: [cmd_echo_hi()] }
}

test fn stmt_if_byte_identical_holds() -> Bool {
  stmt_emits_oracle(s: if_true_echo())
}

test fn stmt_if_has_teeth_holds() -> Bool {
  stmt_differs_from_oracle_of(s: if_true_echo(), other: If { cond: cmd_true(), then: [cmd_true()] })
}

fn andor_t_e() -> ShellStmt {
  AndOr { left: cmd_true(), op: AndThen, right: cmd_echo_hi() }
}

test fn stmt_andor_byte_identical_holds() -> Bool {
  stmt_emits_oracle(s: andor_t_e())
}

test fn stmt_andor_op_has_teeth_holds() -> Bool {
  stmt_differs_from_oracle_of(s: andor_t_e(), other: AndOr { left: cmd_true(), op: OrElse, right: cmd_echo_hi() })
}

fn pipe_t_e() -> ShellStmt {
  Pipe { left: cmd_true(), right: cmd_echo_hi() }
}

test fn stmt_pipe_byte_identical_holds() -> Bool {
  stmt_emits_oracle(s: pipe_t_e())
}

test fn stmt_pipe_has_teeth_holds() -> Bool {
  stmt_differs_from_oracle_of(s: pipe_t_e(), other: Pipe { left: cmd_echo_hi(), right: cmd_true() })
}

fn withredir_t() -> ShellStmt {
  WithRedir { stmt: cmd_true(), redir: StderrToNull }
}

test fn stmt_with_redir_byte_identical_holds() -> Bool {
  stmt_emits_oracle(s: withredir_t())
}

test fn stmt_with_redir_has_teeth_holds() -> Bool {
  stmt_differs_from_oracle_of(s: withredir_t(), other: cmd_true())
}

fn envp_t() -> ShellStmt {
  EnvPrefixed { name: "TMPDIR", value: Lit { text: "/t" }, command: cmd_true() }
}

test fn stmt_env_prefixed_byte_identical_holds() -> Bool {
  stmt_emits_oracle(s: envp_t())
}

test fn stmt_env_prefixed_has_teeth_holds() -> Bool {
  stmt_differs_from_oracle_of(s: envp_t(), other: EnvPrefixed { name: "TMPDIR", value: Lit { text: "/x" }, command: cmd_true() })
}

fn heredoc_t() -> ShellStmt {
  Heredoc { path: Lit { text: "out" }, delimiter: "EOF", body: "hello" }
}

test fn stmt_heredoc_byte_identical_holds() -> Bool {
  stmt_emits_oracle(s: heredoc_t())
}

test fn stmt_heredoc_has_teeth_holds() -> Bool {
  stmt_differs_from_oracle_of(s: heredoc_t(), other: Heredoc { path: Lit { text: "out" }, delimiter: "EOF", body: "world" })
}

fn program_emits_oracle(p: ShellProgram) -> Bool {
  match emit_shell_program(p: p) {
    Accepted { value: src, diagnostics: dg } =>
      (src.carried == serialize_bash(p: p)) && (dg == None)
    Rejected { diagnostics: _ } => false
  }
}

fn program_differs_from_oracle_of(p: ShellProgram, other: ShellProgram) -> Bool {
  match emit_shell_program(p: p) {
    Accepted { value: src, diagnostics: _ } => src.carried != serialize_bash(p: other)
    Rejected { diagnostics: _ } => false
  }
}

fn prog_plain() -> ShellProgram {
  ShellProgram { set_e: false, statements: [cmd_true(), cmd_echo_hi()] }
}

fn prog_set_e() -> ShellProgram {
  ShellProgram { set_e: true, statements: [cmd_true(), cmd_echo_hi()] }
}

test fn program_plain_byte_identical_holds() -> Bool {
  program_emits_oracle(p: prog_plain())
}

test fn program_set_e_byte_identical_holds() -> Bool {
  program_emits_oracle(p: prog_set_e())
}

test fn program_set_e_has_teeth_holds() -> Bool {
  program_differs_from_oracle_of(p: prog_set_e(), other: prog_plain())
}
