module v2.workflow.ci_regen_rustfmt_path_emit



data ci_regen_rustfmt_path_emit_authority_note: String = "Foreign-executor shell emission for the regen-job rustfmt PATH ensure (bucket D). Intent is a Pipeline of If/Predicate/Exit/Let nodes — control flow is orchestration, not bash-in-String (review 43658). Leaf Run.command / export spellings are the irreducible kernel (test -x / command -v / export PATH / dirname) until FileExists + session-EnvExport carriers land (PR2b residue named beside ci_floor_stamp). Kept out of ci_workflow_run_emit so gunbc.ci_spec can import this surface without the ci_materialization ↔ ci_spec cycle."

data ci_regen_rustfmt_path_emit_refused_poison: String = "__GUNBC_ORCH_EMIT_REFUSED__ regen rustfmt-PATH run-step emission was rejected by v2.compiler.emit_orchestration; this marker is not valid workflow shell, so the committed ci.yml drift gate goes red rather than a hand-spelled fallback masking the refusal (DESIGN 5: refuse, never widen)\n"

data ci_regen_ensure_rustfmt_path_shell_emit_dissolution_trigger: std.dissolution.DissolutionCondition = unbound_dissolution(description: "🟡 dissolve-on: ci_regen_ensure_rustfmt_path_script — foreign-executor PATH ensure for regen_stage0 on hosts with a cargo shim and no CARGO_HOME/bin (receipt CI #7290 srv3-03); control flow is If/Predicate/Exit/Let via orch bash-emit; leaf test -x / command -v / export PATH / dirname strings remain until FileExists + session-EnvExport (PR2b) or the regen job shares isolate+pin by construction; DISSOLVES WHEN rustfmt resolution is a typed toolchain probe on host_effect_apply rather than emitted bash (#5828 / ROADMAP 6-shell-slice0)")

data ci_regen_ensure_rustfmt_path_note: String = "Prepend a locatable rustfmt dir onto PATH before regen_stage0's standalone rustfmt spawn (hosts that expose a cargo shim without CARGO_HOME/bin — receipt CI #7290 srv3-03). Probe order: CARGO_HOME/bin, /opt/cargo/bin, HOME/.cargo/bin, rustup which; refuse if still absent."

data ci_regen_rustfmt_unpinned_frontier: gunbc.tool_readiness.UnpinnedToolFrontierRow = gunbc.tool_readiness.UnpinnedToolFrontierRow {
  tool: rustfmt_cli_tool,
  reason: "The current foreign-executor handler can establish presence but cannot author a stable expected executable identity until toolchain-rust-hermetic provisions rustfmt into the declared repo-local root.",
  trigger: std.decl_ref.DeclarationRef {
    module_path: "v2.workflow.ci_regen_rustfmt_path_emit",
    decl_name: "ci_regen_ensure_rustfmt_path_script",
    field: WholeDeclaration
  }
}

data ci_regen_rustfmt_frontier_realization_note: String = "This existing shell handler consumes the declared frontier row only for its tool identity; it is NOT yet a live consumer of gunbc.tool_readiness because it cannot produce the ResolvedBuildContext that decision requires. Every occurrence of the tool name in the emitted PATH probe derives from ci_regen_rustfmt_unpinned_frontier.tool, so the retained handler cannot silently resolve a tool outside the closed frontier roster. The typed readiness decision is witness-consumed in this slice, plainly not production-gating. Once toolchain-rust-hermetic supplies a stable expected identity and a host observation transport feeds that context, this frontier row and handler dissolve and the live consumer calls tool_readiness rather than gaining an escape hatch."

fn ci_regen_rustfmt_frontier_tool_name() -> String {
  ci_regen_rustfmt_unpinned_frontier.tool.name as String
}

fn ci_regen_rustfmt_test_x_cargo_home() -> String {
  concat(
    "[ -x \"$CARGO_HOME/bin/",
    concat(ci_regen_rustfmt_frontier_tool_name(), "\" ]"),
  )
}

fn ci_regen_rustfmt_test_x_opt_cargo() -> String {
  concat(
    "[ -x /opt/cargo/bin/",
    concat(ci_regen_rustfmt_frontier_tool_name(), " ]"),
  )
}

fn ci_regen_rustfmt_test_x_home_cargo() -> String {
  concat(
    "[ -x \"$HOME/.cargo/bin/",
    concat(ci_regen_rustfmt_frontier_tool_name(), "\" ]"),
  )
}

data ci_regen_rustfmt_test_x_rf: String = "[ -x \"$RF\" ]"

fn ci_regen_rustfmt_command_v() -> String {
  concat("command -v ", ci_regen_rustfmt_frontier_tool_name())
}

data ci_regen_rustfmt_export_cargo_home_path: String = "export PATH=\"$CARGO_HOME/bin:$PATH\""

data ci_regen_rustfmt_export_opt_cargo_path: String = "export PATH=\"/opt/cargo/bin:$PATH\""

data ci_regen_rustfmt_export_home_cargo_path: String = "export PATH=\"$HOME/.cargo/bin:$PATH\""

data ci_regen_rustfmt_export_rf_dir_path: String = "export PATH=\"$RF_DIR:$PATH\""

fn ci_regen_rustfmt_error_echo() -> String {
  concat(
    "echo \"::error::",
    concat(
      ci_regen_rustfmt_frontier_tool_name(),
      " not on PATH for regen_stage0 standalone spawn (hosts with a cargo shim and no CARGO_HOME/bin — receipt CI #7290 srv3-03)\"",
    ),
  )
}

fn ci_regen_rustfmt_rustup_which_assign() -> String {
  concat(
    "RF=$(/opt/cargo/bin/rustup which ",
    concat(ci_regen_rustfmt_frontier_tool_name(), ")"),
  )
}

data ci_regen_ensure_rustfmt_path_shell_emit_scaffold: std.disposition.Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "v2.workflow.ci_regen_rustfmt_path_emit",
    decl_name: "ci_regen_ensure_rustfmt_path_script",
    field: WholeDeclaration
  }
}

fn ci_regen_rustfmt_exit_zero(command: String) -> v2.std.orchestration.Predicate {
  v2.std.orchestration.ExitZero { run: orch_bash_run(command: command) }
}

fn ci_regen_rustfmt_command_v_ok() -> v2.std.orchestration.Predicate {
  v2.std.orchestration.ExitZero {
    run: v2.std.orchestration.Run {
      command: ci_regen_rustfmt_command_v(),
      env: [],
      redirect: Present { value: DiscardAll },
      capture: Absent
    }
  }
}

fn ci_regen_rustfmt_command_v_missing() -> v2.std.orchestration.Predicate {
  Not { inner: ci_regen_rustfmt_command_v_ok() }
}

fn ci_regen_rustfmt_export_step(command: String) -> v2.std.orchestration.PipelineStep {
  orch_bash_do(command: command)
}

fn ci_regen_rustfmt_one_step(command: String) -> v2.std.orchestration.Pipeline {
  v2.std.orchestration.Pipeline {
    steps: [ci_regen_rustfmt_export_step(command: command)],
    on_failure: FailFast
  }
}

fn ci_regen_rustfmt_probe_cargo_home_step() -> v2.std.orchestration.PipelineStep {
  If {
    cond: And {
      lhs: v2.std.orchestration.StrNonempty { operand: "\"$CARGO_HOME\"" },
      rhs: ci_regen_rustfmt_exit_zero(command: ci_regen_rustfmt_test_x_cargo_home())
    },
    then_: ci_regen_rustfmt_one_step(command: ci_regen_rustfmt_export_cargo_home_path),
    else_: Absent
  }
}

fn ci_regen_rustfmt_probe_opt_cargo_step() -> v2.std.orchestration.PipelineStep {
  If {
    cond: And {
      lhs: ci_regen_rustfmt_command_v_missing(),
      rhs: ci_regen_rustfmt_exit_zero(command: ci_regen_rustfmt_test_x_opt_cargo())
    },
    then_: ci_regen_rustfmt_one_step(command: ci_regen_rustfmt_export_opt_cargo_path),
    else_: Absent
  }
}

fn ci_regen_rustfmt_probe_home_cargo_step() -> v2.std.orchestration.PipelineStep {
  If {
    cond: And {
      lhs: ci_regen_rustfmt_command_v_missing(),
      rhs: ci_regen_rustfmt_exit_zero(command: ci_regen_rustfmt_test_x_home_cargo())
    },
    then_: ci_regen_rustfmt_one_step(command: ci_regen_rustfmt_export_home_cargo_path),
    else_: Absent
  }
}

fn ci_regen_rustfmt_rustup_which_bind_step() -> v2.std.orchestration.PipelineStep {
  Do {
    run: v2.std.orchestration.Run {
      command: ci_regen_rustfmt_rustup_which_assign(),
      env: [],
      redirect: Present { value: DiscardErr },
      capture: Present { value: IgnoreFail }
    }
  }
}

fn ci_regen_rustfmt_dirname_rf_step() -> v2.std.orchestration.PipelineStep {
  Let {
    name: "RF_DIR",
    value: v2.std.orchestration.ExprCmdSubst {
      callee: "dirname",
      args: ["\"$RF\""]
    }
  }
}

fn ci_regen_rustfmt_probe_rustup_then() -> v2.std.orchestration.Pipeline {
  v2.std.orchestration.Pipeline {
    steps: [
      ci_regen_rustfmt_rustup_which_bind_step(),
      If {
        cond: And {
          lhs: v2.std.orchestration.StrNonempty { operand: "\"$RF\"" },
          rhs: ci_regen_rustfmt_exit_zero(command: ci_regen_rustfmt_test_x_rf)
        },
        then_: v2.std.orchestration.Pipeline {
          steps: [
            ci_regen_rustfmt_dirname_rf_step(),
            ci_regen_rustfmt_export_step(command: ci_regen_rustfmt_export_rf_dir_path)
          ],
          on_failure: FailFast
        },
        else_: Absent
      }
    ],
    on_failure: FailFast
  }
}

fn ci_regen_rustfmt_probe_rustup_step() -> v2.std.orchestration.PipelineStep {
  If {
    cond: ci_regen_rustfmt_command_v_missing(),
    then_: ci_regen_rustfmt_probe_rustup_then(),
    else_: Absent
  }
}

fn ci_regen_rustfmt_require_step() -> v2.std.orchestration.PipelineStep {
  If {
    cond: ci_regen_rustfmt_command_v_missing(),
    then_: v2.std.orchestration.Pipeline {
      steps: [
        orch_bash_do(command: ci_regen_rustfmt_error_echo()),
        v2.std.orchestration.Exit { status: "1" }
      ],
      on_failure: FailFast
    },
    else_: Absent
  }
}

fn ci_regen_ensure_rustfmt_path_intent() -> v2.std.orchestration.Pipeline {
  v2.std.orchestration.Pipeline {
    steps: [
      orch_bash_comment_line(text: dissolution_description(condition: ci_regen_ensure_rustfmt_path_shell_emit_dissolution_trigger)),
      orch_bash_comment_line(text: ci_regen_ensure_rustfmt_path_note),
      ci_regen_rustfmt_probe_cargo_home_step(),
      ci_regen_rustfmt_probe_opt_cargo_step(),
      ci_regen_rustfmt_probe_home_cargo_step(),
      ci_regen_rustfmt_probe_rustup_step(),
      ci_regen_rustfmt_require_step()
    ],
    on_failure: FailFast
  }
}

fn ci_regen_ensure_rustfmt_path_script() -> String {
  orch_bash_emit_pipeline(
    p: ci_regen_ensure_rustfmt_path_intent(),
    refused_poison: ci_regen_rustfmt_path_emit_refused_poison
  )
}
