// DECLARED-TO-DECLARED REHOMING (NAMESPACE-XL, tidy-ant-251's approved design, 2026-10-20). A wave of
// v2.workflow.roster_import_sweep turns an AMBIENT name into a declared import. This module moves a name that is
// already declared-and-imported from one home to another: every import of the old declaration becomes an import of the
// new one, and every qualified use spelled through the old home is respelled through the new one.
//
// IDENTITY, NEVER SPELLING. A site is in scope only when what it names IS the old declaration: an import binding whose
// target is <from_home>.<name>, or a qualified use whose spelling is that fully qualified name. A homonym imported from a
// third module, or a local declaration of the same spelling, is not touched.
//
// A RENAME, NOT A RETYPE. The pair is admitted only when the two declarations are the same kind and the same shape
// (rehome_pair_verdict, read from v2.std.decl_index). Same shape here is the declaration nodes' structural digest
// (v2.std.node content_hash, which ignores occurrences), so labels, fields, variants and parameter types all agree and
// no label rename is needed. A pair that differs in shape is a representation change (tidy-ant-251's ruling A on the
// N7 Int pair) and refuses rehome-signature-differs: the generator never retypes values.
//
// ONE ROW PER RUN, by construction: every entry takes exactly one (name, from_home, to_home), so two rows cannot be
// admitted against one closure snapshot (the reasoning of #14513's apply-needs-one-home).
//
// THE PLANNER RECORD. Every write is a list of RehomeSplice, each carrying the exact bytes it expects to replace, and
// rehome_applied derives from the SAME list both the new text and one RehomeRewrite per splice: its base extent, its head
// extent in the FINAL head text, and, where the extent covers an occurrence's own bytes, where the spelling sits inside
// it on both sides. That record is what sunny-bee-153's binding-diff join admits instead of refusing
// EditCoversOccurrence; the join never re-derives a mapping.

type RehomeRow {
  name: String
  from_home: String
  to_home: String
  representation: Optional<RehomeRepresentation>
}

// A DECLARED REPRESENTATION CHANGE (tidy-ant-251's ruling A on the N7 Int pair). A pair whose shapes differ is not a
// rename, so without this the row refuses outright. With it, the row moves a module's import only once that module has
// NO site that depends on the old representation, and otherwise refuses rehome-representation-sites-remain naming every
// such site. That refusal list is the representation migration's work list; the migration itself is not this module's.
// The sites are references to `constructor` (by the file's own import binding, or spelled fully), and reads of any of
// `fields` after a `.`. A field read's receiver type is not known before inference, so every such read counts
// (fail-closed); classifying receivers by type is the next rung.
type RehomeRepresentation {
  constructor: String
  fields: List<String>
}

type RehomeRewriteKind
  = ImportBlockRewrite
  | QualifiedUseRewrite

type RehomeSplice {
  start: Int
  end: Int
  expect: String
  replacement: String
  kind: RehomeRewriteKind
  spelling_base_offset: Int?
  spelling_head_offset: Int?
}

type RehomeRewrite {
  base_start: Int
  base_end: Int
  head_start: Int
  head_end: Int
  kind: RehomeRewriteKind
  spelling_base_offset: Int?
  spelling_head_offset: Int?
}

type RehomeRefusal
  = RehomeKindDiffers
  | RehomeSignatureDiffers
  | RehomeTargetUnresolved { qualified_name: String }
  | RehomeTargetAmbiguous { qualified_name: String }
  | RehomeAliasUnsupported
  | RehomeExtentMismatch
  | RehomeNoImportAnchor
  | RehomeTokenizeRefused
  | RehomeParseRefused
  | RehomeNormalizeRefused
  | RehomeUnreadable
  | RehomeGrammarUnprepared
  | RehomeWriteFailed
  | RehomeStaleRead
  | RehomeLockNotHeld
  | RehomeSweep { reason: String }
  | RehomeRepresentationSitesRemain { sites: String }
  | RehomeContractUnestablishedRefusal { cause: String }

fn rehome_refusal_text(r: RehomeRefusal) -> String {
  match r {
    RehomeKindDiffers => "rehome-kind-differs"
    RehomeSignatureDiffers => "rehome-signature-differs"
    RehomeTargetUnresolved { qualified_name: q } => "rehome-target-unresolved " + q
    RehomeTargetAmbiguous { qualified_name: q } => "rehome-target-ambiguous " + q
    RehomeAliasUnsupported => "rehome-alias-unsupported"
    RehomeExtentMismatch => "rehome-extent-mismatch"
    RehomeNoImportAnchor => "rehome-no-import-anchor"
    RehomeTokenizeRefused => "tokenize-refused"
    RehomeParseRefused => "parse-refused"
    RehomeNormalizeRefused => "normalize-refused"
    RehomeUnreadable => "unreadable"
    RehomeGrammarUnprepared => "grammar-unprepared"
    RehomeWriteFailed => "write-failed"
    RehomeStaleRead => "stale-read"
    RehomeLockNotHeld => "lock-not-held"
    RehomeSweep { reason: t } => t
    RehomeRepresentationSitesRemain { sites: ss } => "rehome-representation-sites-remain " + ss
    RehomeContractUnestablishedRefusal { cause: c } => "rehome-contract-unestablished " + c
  }
}

type RehomeOutcome
  = RehomeClean
  | RehomeRefused { reason: RehomeRefusal }
  | RehomeSplices { splices: List<RehomeSplice> }

// ---- the pair verdict: same kind and same shape, from v2.std.decl_index -----------------------------------------------

type RehomePairVerdict
  = RehomePairSame
  | RehomePairRefused { reason: RehomeRefusal }

// THE POOL A PAIR IS READ OVER: the directories that hold the two homes, derived forward by the one name-to-path rule
// (v2.compiler.source_authority module_file over v2.cli.repository_layout). decl_facts_at parses every file under its
// roots and keeps every declaration before it filters, so reading both governed trees to answer two keys built the whole
// pool's nodes (the controls leg reached its 16G cap). A file under a home's directory that declares another module is
// outside the layout, so narrowing to the directories loses no admissible row. A home with no derivable file refuses.
type RehomePairPool
  = RehomePoolRoots { roots: List<String> }
  | RehomePoolRefused { reason: RehomeRefusal }

fn rehome_home_directory(home: String) -> Optional<String> {
  match module_file(layout: repository_storage_layout(), name: home) {
    ModuleNameUnderivable { name: _, cause: _ } => Absent
    ModuleFileDerived { file: file } => Present { value: path_parent_directory(path: repository_path_of_module_file(file: file)) }
  }
}

fn rehome_pair_pool(row: RehomeRow) -> RehomePairPool {
  match rehome_home_directory(home: row.from_home) {
    Absent => RehomePoolRefused { reason: RehomeTargetUnresolved { qualified_name: row.from_home + "." + row.name } }
    Present { value: from_dir } =>
      match rehome_home_directory(home: row.to_home) {
        Absent => RehomePoolRefused { reason: RehomeTargetUnresolved { qualified_name: row.to_home + "." + row.name } }
        Present { value: to_dir } => RehomePoolRoots { roots: if from_dir == to_dir { [from_dir] } else { [from_dir, to_dir] } }
      }
  }
}

fn rehome_pair_verdict(row: RehomeRow, prepared: PreparedGrammar, lex: PreparedLexRules) -> RehomePairVerdict {
  let from_name = row.from_home + "." + row.name
  let to_name = row.to_home + "." + row.name
  match rehome_pair_pool(row: row) {
    RehomePoolRefused { reason: r } => RehomePairRefused { reason: r }
    RehomePoolRoots { roots: roots } => rehome_pair_verdict_over(row: row, from_name: from_name, to_name: to_name, facts: decl_facts_at(pool_roots: roots, qualified_names: [from_name, to_name], type_names: []), prepared: prepared, lex: lex)
  }
}

fn rehome_pair_verdict_over(row: RehomeRow, from_name: String, to_name: String, facts: List<DeclFact>, prepared: PreparedGrammar, lex: PreparedLexRules) -> RehomePairVerdict {
  match rehome_sole_fact(qualified_name: from_name, facts: facts) {
    RehomeFactRefused { reason: r } => RehomePairRefused { reason: r }
    RehomeFactFound { fact: from } =>
      match rehome_sole_fact(qualified_name: to_name, facts: facts) {
        RehomeFactRefused { reason: r } => RehomePairRefused { reason: r }
        RehomeFactFound { fact: to } =>
          match row.representation {
            Present { value: _ } => rehome_kind_verdict(from: from, to: to)
            Absent => rehome_facts_verdict(from: from, to: to, row: row, prepared: prepared, lex: lex)
          }
      }
  }
}

type RehomeFactLookup
  = RehomeFactFound { fact: DeclFact }
  | RehomeFactRefused { reason: RehomeRefusal }

// THE DECLARATION AT <home>.<name>, from ONE keyed read of both homes. v2.std.decl_index keys a declaration by its
// module's own qualified name, v2. included (#14584), and its keys are a set (#15158), so a pair costs one pass over the
// pool, not one per home. Exactly one row answers a declared home; none is unresolved and several is ambiguous, each
// refused typed.
fn rehome_sole_fact(qualified_name: String, facts: List<DeclFact>) -> RehomeFactLookup {
  match fold_list(xs: facts, empty: [], cons: fn(acc, f) { if f.qualified_name == qualified_name { list_snoc_item(xs: acc, item: f) } else { acc } }) {
    Empty => RehomeFactRefused { reason: RehomeTargetUnresolved { qualified_name: qualified_name } }
    Cons { head: f, tail: Empty } => RehomeFactFound { fact: f }
    _ => RehomeFactRefused { reason: RehomeTargetAmbiguous { qualified_name: qualified_name } }
  }
}

// SAME KIND FROM decl_index, SAME CONTRACT FROM THE DECLARATIONS THEMSELVES (side chat on #14553). decl_index's node is a
// lossy projection (type fields are authored-name atoms with no resolved identity, a fn is a body data-flow skeleton,
// data drops its annotation), so equal digests of it are not equal declarations. The shape is read from each home's own
// normalized declaration (rehome_contract_of) and compared with every referenced name resolved to its identity. A
// contract that cannot be established refuses typed; an incomplete projection is never read as equality.
fn rehome_facts_verdict(from: DeclFact, to: DeclFact, row: RehomeRow, prepared: PreparedGrammar, lex: PreparedLexRules) -> RehomePairVerdict {
  if from.kind != to.kind {
    RehomePairRefused { reason: RehomeKindDiffers }
  } else {
    rehome_contracts_verdict(
      a: rehome_contract_of(home: row.from_home, name: row.name, path: from.rel_path, prepared: prepared, lex: lex),
      b: rehome_contract_of(home: row.to_home, name: row.name, path: to.rel_path, prepared: prepared, lex: lex)
    )
  }
}

// ---- the declaration contract ------------------------------------------------------------------------------------------------

// A declaration's contract: its whole normalized node (parameters, return, fields, variants, applied arguments, body; the
// digest ignores occurrences) and, in the collector's site order, the identity every referenced name resolves to in its
// own module -- an import's target, the home's own root declaration, or the collector's head class for a frame binder.
type RehomeContract
  = RehomeContractRead { node: Node, identities: List<String> }
  | RehomeContractUnestablished { cause: String }

fn rehome_contracts_verdict(a: RehomeContract, b: RehomeContract) -> RehomePairVerdict {
  match a {
    RehomeContractUnestablished { cause: c } => RehomePairRefused { reason: RehomeContractUnestablishedRefusal { cause: c } }
    RehomeContractRead { node: an, identities: ai } =>
      match b {
        RehomeContractUnestablished { cause: c } => RehomePairRefused { reason: RehomeContractUnestablishedRefusal { cause: c } }
        RehomeContractRead { node: bn, identities: bi } =>
          if content_hash(n: an) == content_hash(n: bn) && roster_join(xs: ai, sep: ",") == roster_join(xs: bi, sep: ",") { RehomePairSame } else { RehomePairRefused { reason: RehomeSignatureDiffers } }
      }
  }
}

fn rehome_contract_of(home: String, name: String, path: String, prepared: PreparedGrammar, lex: PreparedLexRules) -> RehomeContract {
  let read = Filesystem.Read(path: path)
  if !read.success { RehomeContractUnestablished { cause: "unreadable " + path } } else { rehome_contract_from_text(home: home, name: name, path: path, text: read.content, prepared: prepared, lex: lex) }
}

fn rehome_contract_from_text(home: String, name: String, path: String, text: String, prepared: PreparedGrammar, lex: PreparedLexRules) -> RehomeContract {
  match tokenize_prepared(text: text, file: symbol_intern_lexeme(lexeme: path), prepared: lex) {
    Rejected { diagnostics: _ } => RehomeContractUnestablished { cause: "tokenize " + path }
    Accepted { value: stream, diagnostics: _ } =>
      match parse_module_prepared(tokens: stream, prepared: prepared) {
        Rejected { diagnostics: _ } => RehomeContractUnestablished { cause: "parse " + path }
        Accepted { value: artifact, diagnostics: _ } =>
          match normalize_with(parse_tree: artifact.tree, source: NormalizeWithIsolatedAllocator, spans: artifact.span_index) {
            Rejected { diagnostics: _ } => RehomeContractUnestablished { cause: "normalize " + path }
            Accepted { value: scoped, diagnostics: _ } => rehome_contract_in(home: home, name: name, root: scoped.tree.root, imported: scoped.tree.import_bindings)
          }
      }
  }
}

fn rehome_contract_in(home: String, name: String, root: Node, imported: List<AliasBindingRow>) -> RehomeContract {
  let bindings = module_root_bindings(root: root)
  let matches = rehome_root_bindings_named(bindings: bindings, name: name)
  match matches {
    Cons { head: decl, tail: Empty } => {
      let collected = collect_scoped_module_reference_sites(root: root, imported: list_map(xs: imported, f: fn(b) { b.binding }))
      if !is_empty(xs: collected.unreadable_roots) {
        RehomeContractUnestablished { cause: "unreadable-reference-root " + home }
      } else {
        match rehome_identities(sites: rehome_sites_under(sites: collected.sites, name: name), home: home, imported: imported, bindings: bindings) {
          RehomeIdentitiesRead { identities: ids } => RehomeContractRead { node: decl.declaration, identities: ids }
          RehomeIdentityUndecided { spelled: sp, head: h } => RehomeContractUnestablished { cause: "undecided-reference " + rehome_head_text(head: h) + " " + sp + " in " + home + "." + name }
        }
      }
    }
    Empty => RehomeContractUnestablished { cause: "no-root-declaration " + home + "." + name }
    _ => RehomeContractUnestablished { cause: "several-root-declarations " + home + "." + name }
  }
}

// The sites recorded under the declaration: a site whose scope path passes through the declaration's own name. A site in
// another declaration that merely mentions the name in its path joins the list on BOTH sides alike only when the two
// modules agree, so an over-inclusion can make a pair differ (refuse), never make different declarations equal.
fn rehome_sites_under(sites: List<ScopedReferenceSite>, name: String) -> List<ScopedReferenceSite> {
  fold_list(xs: sites, empty: [], cons: fn(acc, st) {
    if fold_list(xs: reference_site_scope_path(site: st.site), empty: false, cons: fn(f, seg) { f || symbol_lexeme(sym: seg) == name }) { list_snoc_item(xs: acc, item: st) } else { acc }
  })
}

fn rehome_root_bindings_named(bindings: List<ModuleRootBinding>, name: String) -> List<ModuleRootBinding> {
  fold_list(xs: bindings, empty: [], cons: fn(acc, b) { if symbol_lexeme(sym: b.name) == name { list_snoc_item(xs: acc, item: b) } else { acc } })
}

// A REFERENCE'S IDENTITY IN A CONTRACT IS A DECLARATION, OR THE CONTRACT IS NOT ESTABLISHED (tidy-ant-251 side chat,
// REQUEST_CHANGES at 2f7e616736ac). Equal uncertainty is not identity: two declarations with identical syntax and the
// same unresolved name are not shown to be the same declaration, so an undecided, lexically unbound (ambient) or
// root-value head with no declaration refuses here, typed, and is never compared as text. An ambient operation is
// identified only through its authoritative declaration, i.e. an import. A frame-bound head is a reference to a binder
// inside the declaration itself (a parameter, a let), whose position the normalized node digest already compares.
type RehomeSiteIdentity
  = RehomeSiteDeclared { identity: String }
  | RehomeSiteFrameBinder { name: String }
  | RehomeSiteUndecided { spelled: String, head: SiteHeadBinding }

fn rehome_site_identity(site: ScopedReferenceSite, home: String, imported: List<AliasBindingRow>, bindings: List<ModuleRootBinding>) -> RehomeSiteIdentity {
  let spelled = roster_qn_text(qn: site.site.spelling)
  let via_import = fold_list(xs: imported, empty: "", cons: fn(acc, b) { if acc == "" && symbol_lexeme(sym: b.binding) == spelled { roster_qn_text(qn: b.target) } else { acc } })
  if via_import != "" {
    RehomeSiteDeclared { identity: via_import }
  } else if !is_empty(xs: rehome_root_bindings_named(bindings: bindings, name: spelled)) {
    RehomeSiteDeclared { identity: home + "." + spelled }
  } else {
    match site.head {
      HeadBoundInFrame => RehomeSiteFrameBinder { name: spelled }
      HeadLexicallyUnbound => RehomeSiteUndecided { spelled: spelled, head: HeadLexicallyUnbound }
      HeadBindingUndecided => RehomeSiteUndecided { spelled: spelled, head: HeadBindingUndecided }
      HeadBoundAtRootValue => RehomeSiteUndecided { spelled: spelled, head: HeadBoundAtRootValue }
    }
  }
}

fn rehome_head_text(head: SiteHeadBinding) -> String {
  match head {
    HeadLexicallyUnbound => "ambient"
    HeadBindingUndecided => "undecided"
    HeadBoundAtRootValue => "root"
    HeadBoundInFrame => "frame"
  }
}

// The contract's identity list, or the first reference whose declaration is not established.
type RehomeIdentities
  = RehomeIdentitiesRead { identities: List<String> }
  | RehomeIdentityUndecided { spelled: String, head: SiteHeadBinding }

fn rehome_identities(sites: List<ScopedReferenceSite>, home: String, imported: List<AliasBindingRow>, bindings: List<ModuleRootBinding>) -> RehomeIdentities {
  fold_list(xs: sites, empty: RehomeIdentitiesRead { identities: [] }, cons: fn(acc, st) {
    match acc {
      RehomeIdentityUndecided { spelled: _, head: _ } => acc
      RehomeIdentitiesRead { identities: ids } =>
        match rehome_site_identity(site: st, home: home, imported: imported, bindings: bindings) {
          RehomeSiteDeclared { identity: i } => RehomeIdentitiesRead { identities: list_snoc_item(xs: ids, item: i) }
          RehomeSiteFrameBinder { name: n } => RehomeIdentitiesRead { identities: list_snoc_item(xs: ids, item: "frame-binder:" + n) }
          RehomeSiteUndecided { spelled: sp, head: h } => RehomeIdentityUndecided { spelled: sp, head: h }
        }
    }
  })
}

// A DECLARED REPRESENTATION ADMITS A SHAPE DIFFERENCE, NEVER A KIND DIFFERENCE (review 83176): the content_hash comparison
// is skipped, the kind comparison is not, so any kind mismatch refuses.
fn rehome_kind_verdict(from: DeclFact, to: DeclFact) -> RehomePairVerdict {
  if from.kind == to.kind {
    RehomePairSame
  } else {
    RehomePairRefused { reason: RehomeKindDiffers }
  }
}

// ---- one file: the splices ----------------------------------------------------------------------------------------------

// The file's splices for one row, given the pair verdict and the new home's closure (both read once per run).
fn rehome_text(path: String, text: String, prepared: PreparedGrammar, lex: PreparedLexRules, row: RehomeRow, pair: RehomePairVerdict, closures: List<RosterHomeClosure>) -> RehomeOutcome {
  match tokenize_prepared(text: text, file: symbol_intern_lexeme(lexeme: path), prepared: lex) {
    Rejected { diagnostics: _ } => RehomeRefused { reason: RehomeTokenizeRefused }
    Accepted { value: stream, diagnostics: _ } =>
      match parse_module_prepared(tokens: stream, prepared: prepared) {
        Rejected { diagnostics: _ } => RehomeRefused { reason: RehomeParseRefused }
        Accepted { value: artifact, diagnostics: _ } =>
          match normalize_with(parse_tree: artifact.tree, source: NormalizeWithIsolatedAllocator, spans: artifact.span_index) {
            Rejected { diagnostics: _ } => RehomeRefused { reason: RehomeNormalizeRefused }
            Accepted { value: scoped, diagnostics: _ } =>
              rehome_parsed(text: text, tokens: stream.all, parse_root: artifact.tree, spans: artifact.span_index, imported: scoped.tree.import_bindings, row: row, pair: pair, closures: closures)
          }
      }
  }
}

fn rehome_parsed(text: String, tokens: List<Token>, parse_root: Node, spans: SpanIndex, imported: List<AliasBindingRow>, row: RehomeRow, pair: RehomePairVerdict, closures: List<RosterHomeClosure>) -> RehomeOutcome {
  let old_qn = row.from_home + "." + row.name
  let bound_old = fold_list(xs: imported, empty: [], cons: fn(acc, b) { if roster_qn_text(qn: b.target) == old_qn { list_snoc_item(xs: acc, item: b) } else { acc } })
  let uses = rehome_qualified_uses(parse_root: parse_root, spans: spans, qualified_name: old_qn)
  if is_empty(xs: bound_old) && is_empty(xs: uses) {
    RehomeClean
  } else {
    match pair {
      RehomePairRefused { reason: r } => RehomeRefused { reason: r }
      RehomePairSame =>
        if fold_list(xs: bound_old, empty: false, cons: fn(f, b) { f || symbol_lexeme(sym: b.binding) != row.name }) {
          RehomeRefused { reason: RehomeAliasUnsupported }
        } else {
          let rep_sites = rehome_representation_sites(tokens: tokens, parse_root: parse_root, spans: spans, imported: imported, row: row)
          if !is_empty(xs: rep_sites) {
            RehomeRefused { reason: RehomeRepresentationSitesRemain { sites: rehome_sites_text(sites: rep_sites) } }
          } else {
          match rehome_cycle(parse_root: parse_root, closures: closures, row: row, needs_import: !is_empty(xs: bound_old)) {
            Present { value: reason } => RehomeRefused { reason: reason }
            Absent =>
              match rehome_import_splices(text: text, parse_root: parse_root, spans: spans, imported: imported, row: row, moves_import: !is_empty(xs: bound_old)) {
                RehomeRefused { reason: r } => RehomeRefused { reason: r }
                RehomeClean => rehome_with_uses(splices: [], uses: uses, row: row)
                RehomeSplices { splices: ss } => rehome_with_uses(splices: ss, uses: uses, row: row)
              }
          }
          }
        }
    }
  }
}

fn rehome_with_uses(splices: List<RehomeSplice>, uses: List<RehomeUse>, row: RehomeRow) -> RehomeOutcome {
  let all = fold_list(xs: uses, empty: splices, cons: fn(acc, u) {
    list_snoc_item(xs: acc, item: RehomeSplice {
      start: u.start,
      end: u.end,
      expect: row.from_home + "." + row.name,
      replacement: row.to_home + "." + row.name,
      kind: QualifiedUseRewrite,
      spelling_base_offset: Present { value: 0 },
      spelling_head_offset: Present { value: 0 }
    })
  })
  if is_empty(xs: all) { RehomeClean } else { RehomeSplices { splices: all } }
}

fn rehome_cycle(parse_root: Node, closures: List<RosterHomeClosure>, row: RehomeRow, needs_import: Bool) -> Optional<RehomeRefusal> {
  if !needs_import {
    Absent
  } else {
    match qualified_name_from_module_node(root: parse_root) {
      Rejected { diagnostics: _ } => Present { value: RehomeSweep { reason: roster_refusal_text(reason: RefusalModuleNameUnread) } }
      Accepted { value: qn, diagnostics: _ } =>
        match roster_cycle_refusal(closures: closures, home: row.to_home, module: roster_qn_text(qn: qn)) {
          Present { value: r } => Present { value: RehomeSweep { reason: roster_refusal_text(reason: r) } }
          Absent => Absent
        }
    }
  }
}

// THE IMPORT MOVE. The name leaves every import declaration of from_home that lists it (a declaration it empties is
// deleted with its line) and joins to_home's: an existing to_home declaration is extended, otherwise a new one takes
// the slot of an emptied from_home declaration, or the #14486 anchor (after the last import, else after the header).
// A file that already imports the name from to_home only loses the old binding.
fn rehome_import_splices(text: String, parse_root: Node, spans: SpanIndex, imported: List<AliasBindingRow>, row: RehomeRow, moves_import: Bool) -> RehomeOutcome {
  if !moves_import {
    RehomeClean
  } else {
    let decls = roster_import_decl_facts(parse_root: parse_root, spans: spans)
    let olds = rehome_decls_listing(decls: decls, module_name: row.from_home, name: row.name)
    let news = rehome_decls_of(decls: decls, module_name: row.to_home)
    let already = fold_list(xs: news, empty: false, cons: fn(f, d) { f || rehome_lists(names: d.names, name: row.name) })
    let removals = list_map(xs: olds, f: fn(d) { rehome_removal(text: text, d: d, row: row) })
    if already {
      RehomeSplices { splices: removals }
    } else {
      match news {
        Cons { head: n, tail: _ } =>
          RehomeSplices { splices: rehome_sorted_insert(xs: removals, item: RehomeSplice {
            start: n.start,
            end: n.end,
            expect: roster_render_import(home: qualified_name_from_dotted_string(dotted: row.to_home), names: n.names),
            replacement: roster_render_import(home: qualified_name_from_dotted_string(dotted: row.to_home), names: list_snoc_item(xs: n.names, item: row.name)),
            kind: ImportBlockRewrite,
            spelling_base_offset: Absent,
            spelling_head_offset: Absent
          }) }
        Empty => rehome_with_new_import(text: text, parse_root: parse_root, spans: spans, decls: decls, removals: removals, row: row)
      }
    }
  }
}

fn rehome_decls_of(decls: List<ImportDeclFact>, module_name: String) -> List<ImportDeclFact> {
  fold_list(xs: decls, empty: [], cons: fn(acc, d) { if d.module_name == module_name { list_snoc_item(xs: acc, item: d) } else { acc } })
}

fn rehome_decls_listing(decls: List<ImportDeclFact>, module_name: String, name: String) -> List<ImportDeclFact> {
  fold_list(xs: rehome_decls_of(decls: decls, module_name: module_name), empty: [], cons: fn(acc, d) { if rehome_lists(names: d.names, name: name) { list_snoc_item(xs: acc, item: d) } else { acc } })
}

fn rehome_lists(names: List<String>, name: String) -> Bool {
  fold_list(xs: names, empty: false, cons: fn(f, n) { f || n == name })
}

// Removing the name from one from_home declaration: the declaration re-rendered without it, or, when it was the only
// name, the declaration and its line deleted.
fn rehome_removal(text: String, d: ImportDeclFact, row: RehomeRow) -> RehomeSplice {
  let rest = fold_list(xs: d.names, empty: [], cons: fn(acc, n) { if n == row.name { acc } else { list_snoc_item(xs: acc, item: n) } })
  let rendered = roster_render_import(home: qualified_name_from_dotted_string(dotted: row.from_home), names: d.names)
  if is_empty(xs: rest) {
    RehomeSplice { start: d.start, end: d.end + 1, expect: rendered + "\n", replacement: "", kind: ImportBlockRewrite, spelling_base_offset: Absent, spelling_head_offset: Absent }
  } else {
    RehomeSplice { start: d.start, end: d.end, expect: rendered, replacement: roster_render_import(home: qualified_name_from_dotted_string(dotted: row.from_home), names: rest), kind: ImportBlockRewrite, spelling_base_offset: Absent, spelling_head_offset: Absent }
  }
}

// No to_home declaration yet: the new import replaces an emptied from_home declaration in place when there is one (so
// the two splices never meet), otherwise it is inserted at the anchor.
fn rehome_with_new_import(text: String, parse_root: Node, spans: SpanIndex, decls: List<ImportDeclFact>, removals: List<RehomeSplice>, row: RehomeRow) -> RehomeOutcome {
  let line = roster_render_import(home: qualified_name_from_dotted_string(dotted: row.to_home), names: [row.name])
  match rehome_first_deletion(splices: removals) {
    Present { value: del } =>
      RehomeSplices { splices: list_map(xs: removals, f: fn(s) { if s.start == del.start { RehomeSplice { start: s.start, end: s.end, expect: s.expect, replacement: line + "\n", kind: ImportBlockRewrite, spelling_base_offset: Absent, spelling_head_offset: Absent } } else { s } }) }
    Absent =>
      match roster_last_decl_end(decls: decls) {
        Present { value: at } => RehomeSplices { splices: rehome_sorted_insert(xs: removals, item: RehomeSplice { start: at, end: at, expect: "", replacement: "\n" + line, kind: ImportBlockRewrite, spelling_base_offset: Absent, spelling_head_offset: Absent }) }
        Absent =>
          match roster_module_header_end(parse_root: parse_root, spans: spans) {
            Present { value: at } => RehomeSplices { splices: rehome_sorted_insert(xs: removals, item: RehomeSplice { start: at, end: at, expect: "", replacement: "\n\n" + line, kind: ImportBlockRewrite, spelling_base_offset: Absent, spelling_head_offset: Absent }) }
            Absent => RehomeRefused { reason: RehomeNoImportAnchor }
          }
      }
  }
}

fn rehome_first_deletion(splices: List<RehomeSplice>) -> Optional<RehomeSplice> {
  fold_list(xs: splices, empty: Absent, cons: fn(acc, s) {
    match acc {
      Present { value: _ } => acc
      Absent => if s.replacement == "" { Present { value: s } } else { Absent }
    }
  })
}

// Splices are kept in ascending start order, which rehome_applied requires.
fn rehome_sorted_insert(xs: List<RehomeSplice>, item: RehomeSplice) -> List<RehomeSplice> {
  let placed = fold_list(xs: xs, empty: RehomeInsertion { out: [], done: false }, cons: fn(acc, s) {
    if !acc.done && item.start <= s.start {
      RehomeInsertion { out: list_snoc_item(xs: list_snoc_item(xs: acc.out, item: item), item: s), done: true }
    } else {
      RehomeInsertion { out: list_snoc_item(xs: acc.out, item: s), done: acc.done }
    }
  })
  if placed.done { placed.out } else { list_snoc_item(xs: placed.out, item: item) }
}

type RehomeInsertion {
  out: List<RehomeSplice>
  done: Bool
}

// ---- the representation census --------------------------------------------------------------------------------------------

type RehomeSite {
  start: Int
  end: Int
  what: String
}

fn rehome_representation_sites(tokens: List<Token>, parse_root: Node, spans: SpanIndex, imported: List<AliasBindingRow>, row: RehomeRow) -> List<RehomeSite> {
  match row.representation {
    Absent => []
    Present { value: rep } => {
      let bare = rehome_last_segment(qualified_name: rep.constructor)
      let bound = fold_list(xs: imported, empty: false, cons: fn(f, b) { f || (symbol_lexeme(sym: b.binding) == bare && roster_qn_text(qn: b.target) == rep.constructor) })
      let imports = roster_import_decl_facts(parse_root: parse_root, spans: spans)
      let bare_sites = if bound { rehome_outside_imports(sites: rehome_token_sites(tokens: tokens, lexeme: bare, what: "constructor"), imports: imports) } else { [] }
      let spelled = list_map(xs: rehome_qualified_uses(parse_root: parse_root, spans: spans, qualified_name: rep.constructor), f: fn(u) { RehomeSite { start: u.start, end: u.end, what: "constructor" } })
      let through_alias = rehome_headed_sites(parse_root: parse_root, spans: spans, name: row.name)
      fold_list(xs: rep.fields, empty: list_append_sites(a: list_append_sites(a: bare_sites, b: spelled), b: through_alias), cons: fn(acc, field) { list_append_sites(a: acc, b: rehome_field_read_sites(tokens: tokens, field: field)) })
    }
  }
}

// An import declaration's own block names the constructor without using it; those tokens are not representation sites.
fn rehome_outside_imports(sites: List<RehomeSite>, imports: List<ImportDeclFact>) -> List<RehomeSite> {
  fold_list(xs: sites, empty: [], cons: fn(acc, site) {
    if fold_list(xs: imports, empty: false, cons: fn(inside, d) { inside || (site.start >= d.start && site.end <= d.end) }) { acc } else { list_snoc_item(xs: acc, item: site) }
  })
}

fn list_append_sites(a: List<RehomeSite>, b: List<RehomeSite>) -> List<RehomeSite> {
  fold_list(xs: b, empty: a, cons: fn(acc, x) { list_snoc_item(xs: acc, item: x) })
}

fn rehome_last_segment(qualified_name: String) -> String {
  fold_list(xs: split(s: qualified_name, delimiter: "."), empty: "", cons: fn(_last, seg) { seg })
}

// Identifier tokens spelled `lexeme` that are not the tail of a qualified spelling (no `.` before them).
fn rehome_token_sites(tokens: List<Token>, lexeme: String, what: String) -> List<RehomeSite> {
  fold_list(xs: tokens, empty: RehomeTokenScan { prev: "", sites: [] }, cons: fn(acc, t) {
    RehomeTokenScan {
      prev: rehome_lexeme_text(t: t),
      sites: if rehome_lexeme_text(t: t) == lexeme && acc.prev != "." { list_snoc_item(xs: acc.sites, item: RehomeSite { start: t.start, end: t.end, what: what }) } else { acc.sites }
    }
  }).sites
}

// RECORD CONSTRUCTION OR DESTRUCTURING THROUGH THE REHOMED NAME ITSELF (side chat on #14553): `Int { pos: p, neg: n }` with
// Int = GroupCompletion<Nat> is an admitted form that builds the old representation without naming its constructor. Read off
// the parse, not the tokens (a return type followed by a body brace is not a construction): every primary-expression or
// pattern production whose head atom is the rehomed name. A type name in value or pattern position is only ever its
// record constructor, so each such head is a representation site.
fn rehome_headed_sites(parse_root: Node, spans: SpanIndex, name: String) -> List<RehomeSite> {
  fold_list(xs: node_subtree_nodes(root: parse_root), empty: [], cons: fn(acc, n) {
    match parse_production_emitted_identity_optional(node: n) {
      Present { value: id } =>
        if (id == ^dag_surface_primary_expr || id == ^dag_surface_pattern) && rehome_head_is(node: n, name: name) {
          match roster_node_byte_range(node: n, spans: spans) {
            Present { value: r } => list_snoc_item(xs: acc, item: RehomeSite { start: r.start, end: r.end, what: "record-through-alias" })
            Absent => acc
          }
        } else {
          acc
        }
      Absent => acc
    }
  })
}

fn rehome_head_is(node: Node, name: String) -> Bool {
  match parse_production_captured_child_optional(node: node) {
    Present { value: cap } =>
      match find_named_child(root: cap, name: ^grammar_sequence_left_node_projection) {
        Accepted { value: left, diagnostics: _ } =>
          match node_atom_identity_optional(node: left) {
            Present { value: sym } => symbol_lexeme(sym: sym) == name
            Absent => false
          }
        Rejected { diagnostics: _ } => false
      }
    Absent => false
  }
}

// `.field` reads: an identifier spelled `field` directly after a `.` token.
fn rehome_field_read_sites(tokens: List<Token>, field: String) -> List<RehomeSite> {
  fold_list(xs: tokens, empty: RehomeTokenScan { prev: "", sites: [] }, cons: fn(acc, t) {
    RehomeTokenScan {
      prev: rehome_lexeme_text(t: t),
      sites: if rehome_lexeme_text(t: t) == field && acc.prev == "." { list_snoc_item(xs: acc.sites, item: RehomeSite { start: t.start, end: t.end, what: "field-read-untyped:" + field }) } else { acc.sites }
    }
  }).sites
}

type RehomeTokenScan {
  prev: String
  sites: List<RehomeSite>
}

fn rehome_lexeme_text(t: Token) -> String {
  t.lexeme as String
}

fn rehome_sites_text(sites: List<RehomeSite>) -> String {
  roster_join(xs: list_map(xs: sites, f: fn(x) { rehome_site_text(site: x) }), sep: ",")
}

fn rehome_site_text(site: RehomeSite) -> String {
  site.what + "@" + int_to_decimal_string(value: site.start) + "-" + int_to_decimal_string(value: site.end)
}

// ---- qualified uses: every qualified-name production spelled exactly <from_home>.<name> ----------------------------------

type RehomeUse {
  start: Int
  end: Int
}

fn rehome_qualified_uses(parse_root: Node, spans: SpanIndex, qualified_name: String) -> List<RehomeUse> {
  fold_list(xs: node_subtree_nodes(root: parse_root), empty: [], cons: fn(acc, n) {
    match parse_production_emitted_identity_optional(node: n) {
      Present { value: id } =>
        if id == ^dag_surface_qualified_name && rehome_node_spells(node: n, root: parse_root, qualified_name: qualified_name) {
          match roster_node_byte_range(node: n, spans: spans) {
            Present { value: r } => list_snoc_item(xs: acc, item: RehomeUse { start: r.start, end: r.end })
            Absent => acc
          }
        } else {
          acc
        }
      Absent => acc
    }
  })
}

// The spelling of a qualified-name production, read by the parser's own segment reader over the production's capture.
fn rehome_node_spells(node: Node, root: Node, qualified_name: String) -> Bool {
  match parse_production_captured_child_optional(node: node) {
    Present { value: cap } =>
      match parse_qualified_name_segments_from_capture(qn_capture: cap, root: root) {
        Accepted { value: segs, diagnostics: _ } => roster_join(xs: list_map(xs: segs, f: fn(x) { symbol_lexeme(sym: x) }), sep: ".") == qualified_name
        Rejected { diagnostics: _ } => false
      }
    Absent => false
  }
}

// ---- the pure apply and the planner record --------------------------------------------------------------------------------

type RehomeApplied
  = RehomeWritten { content: String, rewrites: List<RehomeRewrite> }
  | RehomeApplyRefused { reason: RehomeRefusal }

// ONE PASS, ASCENDING: each splice's base bytes must equal its `expect` (the stale-read check per splice, in place of a
// byte-shape guess), splices may not overlap, and the head extent of each is its base start moved by every earlier
// splice's octet delta. The content and the record come from the same fold, so they cannot disagree.
fn rehome_applied(before: String, splices: List<RehomeSplice>) -> RehomeApplied {
  let octets = bytes_octets(b: utf8_encode_bytes(s: before))
  let state = fold_list(xs: splices, empty: RehomeFold { out: "", base_scalar: 0, base_byte: 0, delta: 0, rewrites: [], refused: false }, cons: fn(acc, s) {
    if acc.refused { acc } else {
      let from = roster_scalar_boundary(octets: octets, byte: s.start)
      let to = roster_scalar_boundary(octets: octets, byte: s.end)
      if from < 0 || to < from || s.start < acc.base_byte || substring(s: before, start: from, end: to) != s.expect {
        RehomeFold { out: acc.out, base_scalar: acc.base_scalar, base_byte: acc.base_byte, delta: acc.delta, rewrites: acc.rewrites, refused: true }
      } else {
        let head_start = s.start + acc.delta
        let added = rehome_octet_length(text: s.replacement)
        RehomeFold {
          out: acc.out + substring(s: before, start: acc.base_scalar, end: from) + s.replacement,
          base_scalar: to,
          base_byte: s.end,
          delta: acc.delta + added - (s.end - s.start),
          rewrites: list_snoc_item(xs: acc.rewrites, item: RehomeRewrite {
            base_start: s.start,
            base_end: s.end,
            head_start: head_start,
            head_end: head_start + added,
            kind: s.kind,
            spelling_base_offset: s.spelling_base_offset,
            spelling_head_offset: s.spelling_head_offset
          }),
          refused: false
        }
      }
    }
  })
  if state.refused {
    RehomeApplyRefused { reason: RehomeExtentMismatch }
  } else {
    RehomeWritten { content: state.out + substring(s: before, start: state.base_scalar, end: string_length(s: before)), rewrites: state.rewrites }
  }
}

type RehomeFold {
  out: String
  base_scalar: Int
  base_byte: Int
  delta: Int
  rewrites: List<RehomeRewrite>
  refused: Bool
}

fn rehome_octet_length(text: String) -> Int {
  length(xs: bytes_octets(b: utf8_encode_bytes(s: text)))
}

// ---- rows: report and apply, one row per run ------------------------------------------------------------------------------

//   REHOME <path> <start> <end> <replacement>      replacement escaped as roster_escape_replacement escapes it
//   REWRITE <path> <kind> <base_start> <base_end> <head_start> <head_end> <spelling_base|-> <spelling_head|->
//   REFUSE <path> <cause>
fn rehome_render(path: String, before: String, outcome: RehomeOutcome) -> String {
  match outcome {
    RehomeClean => ""
    RehomeRefused { reason: r } => "REFUSE " + path + " " + rehome_refusal_text(r: r) + "\n"
    RehomeSplices { splices: ss } =>
      match rehome_applied(before: before, splices: ss) {
        RehomeApplyRefused { reason: r } => "REFUSE " + path + " " + rehome_refusal_text(r: r) + "\n"
        RehomeWritten { content: _, rewrites: rws } =>
          fold_list(xs: ss, empty: "", cons: fn(acc, s) { acc + "REHOME " + path + " " + int_to_decimal_string(value: s.start) + " " + int_to_decimal_string(value: s.end) + " " + roster_escape_replacement(text: s.replacement) + "\n" })
            + fold_list(xs: rws, empty: "", cons: fn(acc, w) { acc + rehome_rewrite_row(path: path, w: w) })
      }
  }
}

fn rehome_rewrite_row(path: String, w: RehomeRewrite) -> String {
  "REWRITE " + path + " " + rehome_kind_name(k: w.kind) + " " + int_to_decimal_string(value: w.base_start) + " " + int_to_decimal_string(value: w.base_end)
    + " " + int_to_decimal_string(value: w.head_start) + " " + int_to_decimal_string(value: w.head_end)
    + " " + rehome_offset_text(o: w.spelling_base_offset) + " " + rehome_offset_text(o: w.spelling_head_offset) + "\n"
}

fn rehome_kind_name(k: RehomeRewriteKind) -> String {
  match k {
    ImportBlockRewrite => "import-block"
    QualifiedUseRewrite => "qualified-use"
  }
}

fn rehome_offset_text(o: Int?) -> String {
  match o {
    Present { value: v } => int_to_decimal_string(value: v)
    Absent => "-"
  }
}

// THE ROW TABLE: rehomes whose shape or representation needs declaring live here as data, and run by name
// (rehome_table_sweep_exit / rehome_table_apply_exit). N7 Int delivery 2 (tidy-ant-251's ruling A): v2.std.integer.Int is
// GroupCompletion<Nat>, std.integer.Int is NonNegative | Negative, so a module moves only once it has no GroupCompletion
// site and no .pos / .neg read.
fn rehome_rows() -> List<RehomeRow> {
  [
    RehomeRow {
      name: "Int",
      from_home: "v2.std.integer",
      to_home: "std.integer",
      representation: Present { value: RehomeRepresentation { constructor: "std.algebra.GroupCompletion", fields: ["pos", "neg"] } }
    }
  ]
}

fn rehome_table_row(name: String) -> Optional<RehomeRow> {
  fold_list(xs: rehome_rows(), empty: Absent, cons: fn(acc, r) { if r.name == name { Present { value: r } } else { acc } })
}

fn rehome_table_sweep_exit(paths_csv: String, name: String) -> ProcessExit {
  match rehome_table_row(name: name) {
    Absent => exit_failure(reason: "REFUSE * rehome-row-unknown " + name + "\n")
    Present { value: row } => {
      let rows = rehome_sweep(root: "", paths_csv: paths_csv, row: row)
      if rows == "" { ExitSuccess } else { exit_failure(reason: rows) }
    }
  }
}

fn rehome_row_of(name: String, from_home: String, to_home: String) -> RehomeRow {
  RehomeRow { name: name, from_home: from_home, to_home: to_home, representation: Absent }
}

// THE REPORT: rows for every path, writing nothing. Exit 0 means no file has anything to move.
fn rehome_sweep_exit(paths_csv: String, name: String, from_home: String, to_home: String) -> ProcessExit {
  let rows = rehome_sweep(root: "", paths_csv: paths_csv, row: rehome_row_of(name: name, from_home: from_home, to_home: to_home))
  if rows == "" { ExitSuccess } else { exit_failure(reason: rows) }
}

fn rehome_sweep(root: String, paths_csv: String, row: RehomeRow) -> String {
  match dag_prepared_grammar() {
    Rejected { diagnostics: _ } => "REFUSE * " + rehome_refusal_text(r: RehomeGrammarUnprepared) + "\n"
    Accepted { value: prepared, diagnostics: _ } => {
      let pair = rehome_pair_verdict(row: row, prepared: prepared, lex: dag_prepared_lex())
      let closures = [roster_home_closure_read(home: row.to_home, bindings: roster_repository_bindings(root: root))]
      fold_list(xs: split(s: paths_csv, delimiter: ","), empty: "", cons: fn(acc, path) {
        acc + rehome_sweep_path(path: path, prepared: prepared, lex: dag_prepared_lex(), row: row, pair: pair, closures: closures)
      })
    }
  }
}

fn rehome_sweep_path(path: String, prepared: PreparedGrammar, lex: PreparedLexRules, row: RehomeRow, pair: RehomePairVerdict, closures: List<RosterHomeClosure>) -> String {
  let read = Filesystem.Read(path: path)
  if read.success {
    rehome_render(path: path, before: read.content, outcome: rehome_text(path: path, text: read.content, prepared: prepared, lex: lex, row: row, pair: pair, closures: closures))
  } else {
    "REFUSE " + path + " " + rehome_refusal_text(r: RehomeUnreadable) + "\n"
  }
}

// THE APPLY: one row, under the roster's apply lock, with the roster's target and stale-read checks, then the same pure
// rehome_applied the report renders. Success is silent.
fn rehome_apply_exit(root_dir: String, paths_csv: String, name: String, from_home: String, to_home: String) -> ProcessExit {
  let row = rehome_row_of(name: name, from_home: from_home, to_home: to_home)
  let report = match roster_lock_acquire(root_dir: root_dir) {
    RosterLockRefused { reason: r } => "REFUSE * " + roster_refusal_text(reason: r) + "\n"
    RosterLockAcquired { held: held } => {
      let out = rehome_apply_locked(held: held, paths_csv: paths_csv, row: row)
      if roster_lock_release(held: held) { out } else { out + "REFUSE * apply-lock-not-released\n" }
    }
  }
  if report == "" { ExitSuccess } else { exit_failure(reason: report) }
}

fn rehome_apply_locked(held: RosterHeldLock, paths_csv: String, row: RehomeRow) -> String {
  match dag_prepared_grammar() {
    Rejected { diagnostics: _ } => "REFUSE * " + rehome_refusal_text(r: RehomeGrammarUnprepared) + "\n"
    Accepted { value: prepared, diagnostics: _ } => {
      let pair = rehome_pair_verdict(row: row, prepared: prepared, lex: dag_prepared_lex())
      let closures = [roster_home_closure_read(home: row.to_home, bindings: roster_repository_bindings(root: held.root))]
      fold_list(xs: split(s: paths_csv, delimiter: ","), empty: "", cons: fn(acc, path) {
        acc + rehome_apply_path(held: held, path: path, prepared: prepared, lex: dag_prepared_lex(), row: row, pair: pair, closures: closures)
      })
    }
  }
}

fn rehome_apply_path(held: RosterHeldLock, path: String, prepared: PreparedGrammar, lex: PreparedLexRules, row: RehomeRow, pair: RehomePairVerdict, closures: List<RosterHomeClosure>) -> String {
  if !roster_path_admitted(path: path) {
    "REFUSE " + path + " path-outside-root\n"
  } else {
    let read = Filesystem.Read(path: held.root + "/" + path)
    if !read.success {
      "REFUSE " + path + " " + rehome_refusal_text(r: RehomeUnreadable) + "\n"
    } else {
      match rehome_text(path: path, text: read.content, prepared: prepared, lex: lex, row: row, pair: pair, closures: closures) {
        RehomeClean => ""
        RehomeRefused { reason: r } => "REFUSE " + path + " " + rehome_refusal_text(r: r) + "\n"
        RehomeSplices { splices: ss } => rehome_write(held: held, path: path, before: read.content, splices: ss)
      }
    }
  }
}

fn rehome_write(held: RosterHeldLock, path: String, before: String, splices: List<RehomeSplice>) -> String {
  if !roster_lock_still_held(held: held) {
    "REFUSE " + path + " " + rehome_refusal_text(r: RehomeLockNotHeld) + "\n"
  } else {
    match roster_target_refusal(root: held.root, path: path) {
      Present { value: r } => "REFUSE " + path + " " + roster_refusal_text(reason: r) + "\n"
      Absent =>
        if !roster_target_unchanged(root: held.root, path: path, before: before) {
          "REFUSE " + path + " " + rehome_refusal_text(r: RehomeStaleRead) + "\n"
        } else {
          match rehome_applied(before: before, splices: splices) {
            RehomeApplyRefused { reason: r } => "REFUSE " + path + " " + rehome_refusal_text(r: r) + "\n"
            RehomeWritten { content: c, rewrites: _ } =>
              if c == before { "" } else if Filesystem.Write(path: held.root + "/" + path, content: c).success { "" } else { "REFUSE " + path + " " + rehome_refusal_text(r: RehomeWriteFailed) + "\n" }
          }
        }
    }
  }
}

// ---- controls ----------------------------------------------------------------------------------------------------------------

// gunbc run --source-root dag --source-root src/v2 --entry src/v2/workflow/roster_rehome.dag --function rehome_controls_exit
fn rehome_controls_exit() -> ProcessExit {
  let report = rehome_controls_report()
  if report == "" { ExitSuccess } else { exit_failure(reason: report) }
}

// THE GATED ENTRY: `gunbc test //gunbc/instruments:roster-rehome-controls` (gunbc.instrument_targets
// roster_rehome_controls_binding).
fn rehome_controls_wire() -> CliWireResponse {
  let report = rehome_controls_report()
  if report == "" {
    CliWirePrintable { bytes: "roster-rehome controls held\n", exit: ExitSuccess }
  } else {
    CliWirePrintable { bytes: report, exit: exit_failure(reason: report) }
  }
}

fn rehome_control_row() -> RehomeRow {
  RehomeRow { name: "Token", from_home: "c.old", to_home: "c.new", representation: Absent }
}

// The controls' closure for the new home is a supplied value holding no c.* fixture module.
fn rehome_control_closures() -> List<RosterHomeClosure> {
  [RosterClosureRead { home: "c.new", modules: ["c.new"] }]
}

fn rehome_controls_report() -> String {
  match dag_prepared_grammar() {
    Rejected { diagnostics: _ } => "CONTROL-FAIL grammar-unprepared\n"
    Accepted { value: prepared, diagnostics: _ } => {
      let lex = dag_prepared_lex()
      rehome_control_moves(name: "sole-import", prepared: prepared, lex: lex,
        before: "module c.user\n\nimport c.old { Token }\n\nfn f(t: Token) -> Token {\n  t\n}\n",
        after: "module c.user\n\nimport c.new { Token }\n\nfn f(t: Token) -> Token {\n  t\n}\n")
        + rehome_control_moves(name: "shared-block", prepared: prepared, lex: lex,
          before: "module c.user\n\nimport c.old { Other, Token }\nimport c.new { Kept }\n\nfn f(t: Token, o: Other, k: Kept) -> Token {\n  t\n}\n",
          after: "module c.user\n\nimport c.old { Other }\nimport c.new { Kept, Token }\n\nfn f(t: Token, o: Other, k: Kept) -> Token {\n  t\n}\n")
        + rehome_control_moves(name: "qualified-use", prepared: prepared, lex: lex,
          before: "module c.user\n\nimport c.base { Unit }\n\nfn f(t: c.old.Token, u: Unit) -> c.old.Token {\n  t\n}\n",
          after: "module c.user\n\nimport c.base { Unit }\n\nfn f(t: c.new.Token, u: Unit) -> c.new.Token {\n  t\n}\n")
        + rehome_control_untouched(name: "homonym", prepared: prepared, lex: lex,
          text: "module c.user\n\nimport c.other { Token }\n\nfn f(t: Token) -> Token {\n  t\n}\n")
        + rehome_control_refuses(name: "kind-differs", prepared: prepared, lex: lex, pair: RehomePairRefused { reason: RehomeKindDiffers }, closures: rehome_control_closures(), want: "rehome-kind-differs")
        + rehome_control_refuses(name: "signature-differs", prepared: prepared, lex: lex, pair: RehomePairRefused { reason: RehomeSignatureDiffers }, closures: rehome_control_closures(), want: "rehome-signature-differs")
        + rehome_control_refuses(name: "closes-cycle", prepared: prepared, lex: lex, pair: RehomePairSame, closures: [RosterClosureRead { home: "c.new", modules: ["c.new", "c.user"] }], want: "import-closes-cycle home=c.new module=c.user")
        + rehome_control_representation(prepared: prepared, lex: lex)
        + rehome_control_record()
        + rehome_control_pair_inhabited(prepared: prepared, lex: lex)
        + rehome_control_contracts(prepared: prepared, lex: lex)
    }
  }
}

// A rehome writes exactly `after`, its planner record maps every rewritten extent to bytes of `after` equal to the splice's
// replacement, and the fixed point (the same row over `after`) is Clean.
fn rehome_control_moves(name: String, prepared: PreparedGrammar, lex: PreparedLexRules, before: String, after: String) -> String {
  match rehome_text(path: "control/user.dag", text: before, prepared: prepared, lex: lex, row: rehome_control_row(), pair: RehomePairSame, closures: rehome_control_closures()) {
    RehomeSplices { splices: ss } =>
      match rehome_applied(before: before, splices: ss) {
        RehomeApplyRefused { reason: r } => "CONTROL-FAIL rehome " + name + ": apply refused " + rehome_refusal_text(r: r) + "\n"
        RehomeWritten { content: c, rewrites: rws } =>
          if c != after { "CONTROL-FAIL rehome " + name + ": wrote the wrong text\n" }
          else if !rehome_record_lands(after: after, splices: ss, rewrites: rws) { "CONTROL-FAIL rehome " + name + ": the planner record does not map onto the head text\n" }
          else {
            match rehome_text(path: "control/user.dag", text: after, prepared: prepared, lex: lex, row: rehome_control_row(), pair: RehomePairSame, closures: rehome_control_closures()) {
              RehomeClean => ""
              _ => "CONTROL-FAIL rehome " + name + ": pass 2 is not Clean\n"
            }
          }
      }
    RehomeClean => "CONTROL-FAIL rehome " + name + ": nothing moved\n"
    RehomeRefused { reason: r } => "CONTROL-FAIL rehome " + name + ": refused " + rehome_refusal_text(r: r) + "\n"
  }
}

fn rehome_record_lands(after: String, splices: List<RehomeSplice>, rewrites: List<RehomeRewrite>) -> Bool {
  let octets = bytes_octets(b: utf8_encode_bytes(s: after))
  if length(xs: splices) != length(xs: rewrites) { false } else {
    fold_list(xs: rewrites, empty: RehomeZip { index: 0, ok: true }, cons: fn(acc, w) {
      match list_at_optional(xs: splices, index: acc.index) {
        Present { value: s } =>
          RehomeZip { index: acc.index + 1, ok: acc.ok && substring(s: after, start: roster_scalar_boundary(octets: octets, byte: w.head_start), end: roster_scalar_boundary(octets: octets, byte: w.head_end)) == s.replacement }
        Absent => RehomeZip { index: acc.index + 1, ok: false }
      }
    }).ok
  }
}

type RehomeZip {
  index: Int
  ok: Bool
}

fn rehome_control_untouched(name: String, prepared: PreparedGrammar, lex: PreparedLexRules, text: String) -> String {
  match rehome_text(path: "control/user.dag", text: text, prepared: prepared, lex: lex, row: rehome_control_row(), pair: RehomePairSame, closures: rehome_control_closures()) {
    RehomeClean => ""
    _ => "CONTROL-FAIL rehome " + name + ": a declaration that is not the old one was touched\n"
  }
}

fn rehome_control_refuses(name: String, prepared: PreparedGrammar, lex: PreparedLexRules, pair: RehomePairVerdict, closures: List<RosterHomeClosure>, want: String) -> String {
  match rehome_text(path: "control/user.dag", text: "module c.user\n\nimport c.old { Token }\n\nfn f(t: Token) -> Token {\n  t\n}\n", prepared: prepared, lex: lex, row: rehome_control_row(), pair: pair, closures: closures) {
    RehomeRefused { reason: r } => if rehome_refusal_text(r: r) == want { "" } else { "CONTROL-FAIL rehome " + name + ": refused " + rehome_refusal_text(r: r) + ", wanted " + want + "\n" }
    _ => "CONTROL-FAIL rehome " + name + ": not refused\n"
  }
}

// A DECLARED REPRESENTATION CHANGE moves a module with no representation site, and refuses one that has any, naming each
// constructor reference and field read.
fn rehome_control_representation(prepared: PreparedGrammar, lex: PreparedLexRules) -> String {
  let row = RehomeRow { name: "Token", from_home: "c.old", to_home: "c.new", representation: Present { value: RehomeRepresentation { constructor: "c.rep.Pair", fields: ["left"] } } }
  let dirty = "module c.user\n\nimport c.old { Token }\nimport c.rep { Pair }\n\nfn f(t: Token) -> Int {\n  t.left + count(xs: [Pair { left: 1, right: 2 }])\n}\n"
  let clean = "module c.user\n\nimport c.old { Token }\n\nfn f(t: Token) -> Token {\n  t\n}\n"
  let refused = match rehome_text(path: "control/user.dag", text: dirty, prepared: prepared, lex: lex, row: row, pair: RehomePairSame, closures: rehome_control_closures()) {
    RehomeRefused { reason: r } =>
      if substring(s: rehome_refusal_text(r: r), start: 0, end: 34) == "rehome-representation-sites-remain" && rehome_count_of(text: rehome_refusal_text(r: r), what: "constructor@") == 1 && rehome_count_of(text: rehome_refusal_text(r: r), what: "field-read-untyped:left@") == 1 { "" }
      else { "CONTROL-FAIL rehome representation: refused " + rehome_refusal_text(r: r) + "\n" }
    _ => "CONTROL-FAIL rehome representation: a module with representation sites was not refused\n"
  }
  let kinds = rehome_facts_kind_control()
  let via_alias = "module c.user\n\nimport c.old { Token }\n\nfn f() -> Token {\n  Token { left: 1, right: 2 }\n}\n"
  let alias_refused = match rehome_text(path: "control/user.dag", text: via_alias, prepared: prepared, lex: lex, row: row, pair: RehomePairSame, closures: rehome_control_closures()) {
    RehomeRefused { reason: r } =>
      if rehome_count_of(text: rehome_refusal_text(r: r), what: "record-through-alias@") == 1 { "" } else { "CONTROL-FAIL rehome representation: construction through the alias refused as " + rehome_refusal_text(r: r) + "\n" }
    _ => "CONTROL-FAIL rehome representation: construction through the rehomed alias was not counted\n"
  }
  let moved = match rehome_text(path: "control/user.dag", text: clean, prepared: prepared, lex: lex, row: row, pair: RehomePairSame, closures: rehome_control_closures()) {
    RehomeSplices { splices: _ } => ""
    _ => "CONTROL-FAIL rehome representation: a module with no representation site did not move\n"
  }
  refused + moved + kinds + alias_refused
}

// A declared representation still refuses a real kind difference (reviews 83176, 83179): fn against type and an OtherItem
// against fn both refuse, and so does OtherItem against TypeItem: the alias gap closed with #14584, so no kind change is admitted.
fn rehome_facts_kind_control() -> String {
  rehome_kind_case(name: "fn-to-type", from: FnItem, to: TypeItem, admitted: false)
    + rehome_kind_case(name: "other-to-fn", from: OtherItem, to: FnItem, admitted: false)
    + rehome_kind_case(name: "other-to-type", from: OtherItem, to: TypeItem, admitted: false)
}

fn rehome_kind_case(name: String, from: ItemKind, to: ItemKind, admitted: Bool) -> String {
  let verdict = rehome_kind_verdict(from: DeclFact { qualified_name: "c.old.Token", name: "Token", kind: from, node: rehome_control_node(), rel_path: "c/old.dag" }, to: DeclFact { qualified_name: "c.new.Token", name: "Token", kind: to, node: rehome_control_node(), rel_path: "c/new.dag" })
  match verdict {
    RehomePairSame => if admitted { "" } else { "CONTROL-FAIL rehome kind " + name + ": a declared representation admitted a kind change\n" }
    RehomePairRefused { reason: RehomeKindDiffers } => if admitted { "CONTROL-FAIL rehome kind " + name + ": an admitted pair was refused\n" } else { "" }
    RehomePairRefused { reason: r } => "CONTROL-FAIL rehome kind " + name + ": refused " + rehome_refusal_text(r: r) + "\n"
  }
}

fn rehome_control_node() -> Node {
  Node { kind: TypeNode { connective: Conj }, children: [], occurrence_id: OccurrenceSynthetic }
}

fn rehome_count_of(text: String, what: String) -> Int {
  length(xs: split(s: text, delimiter: what)) - 1
}

// THE CONTRACT COMPARATOR ON REAL PARSES (side chat on #14553): the same pair spelled alike but bound differently refuses,
// a different fn signature refuses, and an identical declaration with identical bindings is the same.
fn rehome_control_contracts(prepared: PreparedGrammar, lex: PreparedLexRules) -> String {
  rehome_contract_case(name: "field-bound-differently", prepared: prepared, lex: lex,
    a: "module c.a\n\nimport c.x { Payload }\n\ntype Token {\n  value: Payload\n}\n",
    b: "module c.b\n\nimport c.y { Payload }\n\ntype Token {\n  value: Payload\n}\n", same: false)
    + rehome_contract_case(name: "fn-signature-differs", prepared: prepared, lex: lex,
      a: "module c.a\n\nimport c.t { Int }\n\nfn Token(x: Int) -> Int {\n  x\n}\n",
      b: "module c.b\n\nimport c.t { Bool }\n\nfn Token(x: Bool) -> Bool {\n  x\n}\n", same: false)
    + rehome_contract_case(name: "same-contract", prepared: prepared, lex: lex,
      a: "module c.a\n\nimport c.x { Payload }\n\ntype Token {\n  value: Payload\n}\n",
      b: "module c.b\n\nimport c.x { Payload }\n\ntype Token {\n  value: Payload\n}\n", same: true)
    // THE RED for the fail-open: the same UNRESOLVED name on both sides is equal uncertainty, not one declaration, so
    // the pair refuses as unestablished; text equality of "undecided:Mystery" once admitted it as RehomePairSame.
    + rehome_contract_refuses_case(name: "shared-unresolved-reference", prepared: prepared, lex: lex,
      a: "module c.a\n\ntype Token {\n  value: Mystery\n}\n",
      b: "module c.b\n\ntype Token {\n  value: Mystery\n}\n")
    // ITS CONTROL: the same pair with the name resolved to one declaration is RehomePairSame.
    + rehome_contract_case(name: "shared-declared-reference", prepared: prepared, lex: lex,
      a: "module c.a\n\nimport c.m { Mystery }\n\ntype Token {\n  value: Mystery\n}\n",
      b: "module c.b\n\nimport c.m { Mystery }\n\ntype Token {\n  value: Mystery\n}\n", same: true)
}

fn rehome_contract_refuses_case(name: String, prepared: PreparedGrammar, lex: PreparedLexRules, a: String, b: String) -> String {
  match rehome_contracts_verdict(a: rehome_contract_from_text(home: "c.a", name: "Token", path: "control/a.dag", text: a, prepared: prepared, lex: lex), b: rehome_contract_from_text(home: "c.b", name: "Token", path: "control/b.dag", text: b, prepared: prepared, lex: lex)) {
    RehomePairSame => "CONTROL-FAIL rehome contract " + name + ": two declarations sharing an unresolved reference compared equal\n"
    RehomePairRefused { reason: RehomeContractUnestablishedRefusal { cause: _ } } => ""
    RehomePairRefused { reason: r } => "CONTROL-FAIL rehome contract " + name + ": refused for the wrong reason: " + rehome_refusal_text(r: r) + "\n"
  }
}

fn rehome_contract_case(name: String, prepared: PreparedGrammar, lex: PreparedLexRules, a: String, b: String, same: Bool) -> String {
  match rehome_contracts_verdict(a: rehome_contract_from_text(home: "c.a", name: "Token", path: "control/a.dag", text: a, prepared: prepared, lex: lex), b: rehome_contract_from_text(home: "c.b", name: "Token", path: "control/b.dag", text: b, prepared: prepared, lex: lex)) {
    RehomePairSame => if same { "" } else { "CONTROL-FAIL rehome contract " + name + ": different declarations compared equal\n" }
    RehomePairRefused { reason: RehomeSignatureDiffers } => if same { "CONTROL-FAIL rehome contract " + name + ": identical declarations compared different\n" } else { "" }
    RehomePairRefused { reason: r } => "CONTROL-FAIL rehome contract " + name + ": " + rehome_refusal_text(r: r) + "\n"
  }
}

// A splice whose base bytes are not what it expects refuses; the record's head extents follow earlier splices' deltas.
fn rehome_control_record() -> String {
  let before = "ab c.old.T cd c.old.T"
  let splices = [
    RehomeSplice { start: 3, end: 10, expect: "c.old.T", replacement: "c.newer.T", kind: QualifiedUseRewrite, spelling_base_offset: Present { value: 0 }, spelling_head_offset: Present { value: 0 } },
    RehomeSplice { start: 14, end: 21, expect: "c.old.T", replacement: "c.newer.T", kind: QualifiedUseRewrite, spelling_base_offset: Present { value: 0 }, spelling_head_offset: Present { value: 0 } }
  ]
  let moved = match rehome_applied(before: before, splices: splices) {
    RehomeWritten { content: c, rewrites: rws } =>
      if c == "ab c.newer.T cd c.newer.T" && rehome_record_lands(after: c, splices: splices, rewrites: rws) { "" } else { "CONTROL-FAIL rehome record: the second extent did not move by the first splice's delta\n" }
    RehomeApplyRefused { reason: _ } => "CONTROL-FAIL rehome record: a valid splice list refused\n"
  }
  let stale = match rehome_applied(before: before, splices: [RehomeSplice { start: 0, end: 2, expect: "zz", replacement: "q", kind: ImportBlockRewrite, spelling_base_offset: Absent, spelling_head_offset: Absent }]) {
    RehomeApplyRefused { reason: _ } => ""
    RehomeWritten { content: _, rewrites: _ } => "CONTROL-FAIL rehome record: a splice over unexpected bytes was written\n"
  }
  moved + stale
}

// THE INHABITANCE CLAIM for the supplied pair verdicts: v2.std.decl_index, on the real corpus, resolves the N7 Int pair to
// two declarations of one kind whose shapes differ (GroupCompletion record vs NonNegative | Negative), so the real path
// refuses it as a signature change -- tidy-ant-251's ruling A.
// The alias gap closed with #14584 (aliased type declarations read TypeItem), so the kind arm is gone and this control
// pins the signature arm alone.
fn rehome_control_pair_inhabited(prepared: PreparedGrammar, lex: PreparedLexRules) -> String {
  match rehome_pair_verdict(row: RehomeRow { name: "Int", from_home: "v2.std.integer", to_home: "std.integer", representation: Absent }, prepared: prepared, lex: lex) {
    RehomePairRefused { reason: RehomeSignatureDiffers } => ""
    RehomePairRefused { reason: r } => "CONTROL-FAIL rehome pair-inhabited: the real Int pair refused " + rehome_refusal_text(r: r) + "\n"
    RehomePairSame => "CONTROL-FAIL rehome pair-inhabited: the real Int pair read as the same shape\n"
  }
}
