// DECLARED-TO-DECLARED REHOMING (NAMESPACE-XL, tidy-ant-251's approved design, 2026-10-20). A wave of
// v2.workflow.roster_import_sweep turns an AMBIENT name into a declared import. This module moves a name that is
// already declared-and-imported from one home to another: every import of the old declaration becomes an import of the
// new one, and every qualified use spelled through the old home is respelled through the new one.
//
// IDENTITY, NEVER SPELLING. A site is in scope only when what it names IS the old declaration: an import binding whose
// target is <from_home>.<name>, or a qualified use whose spelling is that fully qualified name. A homonym imported from a
// third module, or a local declaration of the same spelling, is not touched.
//
// A RENAME, NOT A RETYPE. The pair is admitted only when the two declarations are the same kind and the same shape
// (rehome_pair_verdict, read from v2.std.decl_index). Same shape here is the declaration nodes' structural digest
// (v2.std.node content_hash, which ignores occurrences), so labels, fields, variants and parameter types all agree and
// no label rename is needed. A pair that differs in shape is a representation change (tidy-ant-251's ruling A on the
// N7 Int pair) and refuses rehome-signature-differs: the generator never retypes values.
//
// ONE ROW PER RUN, by construction: every entry takes exactly one (name, from_home, to_home), so two rows cannot be
// admitted against one closure snapshot (the reasoning of #14513's apply-needs-one-home).
//
// THE PLANNER RECORD. Every write is a list of RehomeSplice, each carrying the exact bytes it expects to replace, and
// rehome_applied derives from the SAME list both the new text and one RehomeRewrite per splice: its base extent, its head
// extent in the FINAL head text, and, where the extent covers an occurrence's own bytes, where the spelling sits inside
// it on both sides. That record is what sunny-bee-153's binding-diff join admits instead of refusing
// EditCoversOccurrence; the join never re-derives a mapping.

type RehomeRow {
  name: String
  from_home: String
  to_home: String
  representation: Optional<RehomeRepresentation>
}

// A DECLARED REPRESENTATION CHANGE (tidy-ant-251's ruling A on the N7 Int pair). A pair whose shapes differ is not a
// rename, so without this the row refuses outright. With it, the row moves a module's import only once that module has
// NO site that depends on the old representation, and otherwise refuses rehome-representation-sites-remain naming every
// such site. That refusal list is the representation migration's work list; the migration itself is not this module's.
// The sites are references to `constructor` (by the file's own import binding, or spelled fully), and reads of any of
// `fields` after a `.`. A field read's receiver type is not known before inference, so every such read counts
// (fail-closed); classifying receivers by type is the next rung.
type RehomeRepresentation {
  constructor: String
  fields: List<String>
}

type RehomeRewriteKind
  = ImportBlockRewrite
  | QualifiedUseRewrite

type RehomeSplice {
  start: Int
  end: Int
  expect: String
  replacement: String
  kind: RehomeRewriteKind
  spelling_base_offset: Int?
  spelling_head_offset: Int?
}

type RehomeRewrite {
  base_start: Int
  base_end: Int
  head_start: Int
  head_end: Int
  kind: RehomeRewriteKind
  spelling_base_offset: Int?
  spelling_head_offset: Int?
}

type RehomeRefusal
  = RehomeKindDiffers
  | RehomeSignatureDiffers
  | RehomeTargetUnresolved { qualified_name: String }
  | RehomeTargetAmbiguous { qualified_name: String }
  | RehomeTargetFileMismatch { qualified_name: String, path: String, candidates: String }
  | RehomeAliasUnsupported
  | RehomeExtentMismatch
  | RehomeNoImportAnchor
  | RehomeTokenizeRefused
  | RehomeParseRefused
  | RehomeNormalizeRefused
  | RehomeUnreadable
  | RehomeGrammarUnprepared
  | RehomeWriteFailed
  | RehomeStaleRead
  | RehomeLockNotHeld
  | RehomeSweep { reason: String }
  | RehomeRepresentationSitesRemain { sites: String }
  | RehomeContractUnestablishedRefusal { cause: String }

fn rehome_refusal_text(r: RehomeRefusal) -> String {
  match r {
    RehomeKindDiffers => "rehome-kind-differs"
    RehomeSignatureDiffers => "rehome-signature-differs"
    RehomeTargetUnresolved { qualified_name: q } => "rehome-target-unresolved " + q
    RehomeTargetAmbiguous { qualified_name: q } => "rehome-target-ambiguous " + q
    RehomeTargetFileMismatch { qualified_name: q, path: p, candidates: c } => "rehome-target-file-mismatch " + q + " want=" + p + " candidates=" + c
    RehomeAliasUnsupported => "rehome-alias-unsupported"
    RehomeExtentMismatch => "rehome-extent-mismatch"
    RehomeNoImportAnchor => "rehome-no-import-anchor"
    RehomeTokenizeRefused => "tokenize-refused"
    RehomeParseRefused => "parse-refused"
    RehomeNormalizeRefused => "normalize-refused"
    RehomeUnreadable => "unreadable"
    RehomeGrammarUnprepared => "grammar-unprepared"
    RehomeWriteFailed => "write-failed"
    RehomeStaleRead => "stale-read"
    RehomeLockNotHeld => "lock-not-held"
    RehomeSweep { reason: t } => t
    RehomeRepresentationSitesRemain { sites: ss } => "rehome-representation-sites-remain " + ss
    RehomeContractUnestablishedRefusal { cause: c } => "rehome-contract-unestablished " + c
  }
}

type RehomeOutcome
  = RehomeClean
  | RehomeRefused { reason: RehomeRefusal }
  | RehomeSplices { splices: List<RehomeSplice> }

// ---- the pair verdict: same kind and same shape, from v2.std.decl_index -----------------------------------------------

type RehomePairVerdict
  = RehomePairSame
  | RehomePairRefused { reason: RehomeRefusal }

fn rehome_pool_roots() -> List<String> {
  ["dag", "src/v2"]
}

fn rehome_pair_verdict(row: RehomeRow, prepared: PreparedGrammar, lex: PreparedLexRules, census: List<RehomeCensusRow>) -> RehomePairVerdict {
  match rehome_sole_fact(home: row.from_home, name: row.name) {
    RehomeFactRefused { reason: r } => RehomePairRefused { reason: r }
    RehomeFactFound { fact: from } =>
      match rehome_sole_fact(home: row.to_home, name: row.name) {
        RehomeFactRefused { reason: r } => RehomePairRefused { reason: r }
        RehomeFactFound { fact: to } =>
          match row.representation {
            Present { value: _ } => rehome_kind_verdict(from: from, to: to)
            Absent => rehome_facts_verdict(from: from, to: to, row: row, prepared: prepared, lex: lex, census: census)
          }
      }
  }
}

type RehomeFactLookup
  = RehomeFactFound { fact: DeclFact }
  | RehomeFactRefused { reason: RehomeRefusal }

// THE DECLARATION AT <home>.<name>, BY ITS FILE. v2.std.decl_index keys a declaration by its module path with a leading
// `v2.` removed (the seed's decl_logical_qualified_name), so v2.std.integer.Int and std.integer.Int share the key
// std.integer.Int and a keyed read returns both. The home's file is derived by the one name-to-path rule
// (v2.compiler.source_authority module_file over v2.cli.repository_layout), and exactly one candidate must come from it.
// INTERIM, both halves (review 83179): the `v2.` stripping below repeats the seed's key rule, and the file filter works
// around it. TRIGGER: when decl_index keys by the module's own name (adhoc-0f4309c5-074), delete BOTH, and this becomes a
// plain keyed read of <home>.<name>.
fn rehome_sole_fact(home: String, name: String) -> RehomeFactLookup {
  let qualified_name = home + "." + name
  match module_file(layout: repository_storage_layout(), name: home) {
    ModuleNameUnderivable { name: _, cause: _ } => RehomeFactRefused { reason: RehomeTargetUnresolved { qualified_name: qualified_name } }
    ModuleFileDerived { file: file } => {
      let path = repository_path_of_module_file(file: file)
      let key = if substring(s: home, start: 0, end: 3) == "v2." { substring(s: home, start: 3, end: string_length(s: home)) + "." + name } else { qualified_name }
      let facts = decl_facts_at(pool_roots: rehome_pool_roots(), qualified_name: key)
      match rehome_facts_in(facts: facts, path: path) {
        Empty =>
          if is_empty(xs: facts) { RehomeFactRefused { reason: RehomeTargetUnresolved { qualified_name: qualified_name } } }
          else { RehomeFactRefused { reason: RehomeTargetFileMismatch { qualified_name: qualified_name, path: path, candidates: roster_join(xs: list_map(xs: facts, f: fn(f) { f.rel_path }), sep: ",") } } }
        Cons { head: f, tail: Empty } => RehomeFactFound { fact: f }
        _ => RehomeFactRefused { reason: RehomeTargetAmbiguous { qualified_name: qualified_name } }
      }
    }
  }
}

fn rehome_facts_in(facts: List<DeclFact>, path: String) -> List<DeclFact> {
  fold_list(xs: facts, empty: [], cons: fn(acc, f) { if f.rel_path == path { list_snoc_item(xs: acc, item: f) } else { acc } })
}

// SAME KIND FROM decl_index, SAME CONTRACT FROM THE DECLARATIONS THEMSELVES (side chat on #14553). decl_index's node is a
// lossy projection (type fields are authored-name atoms with no resolved identity, a fn is a body data-flow skeleton,
// data drops its annotation), so equal digests of it are not equal declarations. The shape is read from each home's own
// normalized declaration (rehome_contract_of) and compared with every referenced name resolved to its identity. A
// contract that cannot be established refuses typed; an incomplete projection is never read as equality.
fn rehome_facts_verdict(from: DeclFact, to: DeclFact, row: RehomeRow, prepared: PreparedGrammar, lex: PreparedLexRules, census: List<RehomeCensusRow>) -> RehomePairVerdict {
  if !rehome_kinds_equal(a: from.kind, b: to.kind) {
    RehomePairRefused { reason: RehomeKindDiffers }
  } else {
    rehome_contracts_verdict(
      a: rehome_contract_of(home: row.from_home, name: row.name, path: from.rel_path, prepared: prepared, lex: lex, census: census),
      b: rehome_contract_of(home: row.to_home, name: row.name, path: to.rel_path, prepared: prepared, lex: lex, census: census)
    )
  }
}

// ---- the declaration contract ------------------------------------------------------------------------------------------------

// A declaration's contract: its whole normalized node (parameters, return, fields, variants, applied arguments, body; the
// digest ignores occurrences) and, in the collector's site order, the identity every referenced name resolves to in its
// own module -- an import's target, the home's own root declaration, or the collector's head class for a frame binder.
type RehomeContract
  = RehomeContractRead { node: Node, identities: List<String> }
  | RehomeContractUnestablished { cause: String }

fn rehome_contracts_verdict(a: RehomeContract, b: RehomeContract) -> RehomePairVerdict {
  match a {
    RehomeContractUnestablished { cause: c } => RehomePairRefused { reason: RehomeContractUnestablishedRefusal { cause: c } }
    RehomeContractRead { node: an, identities: ai } =>
      match b {
        RehomeContractUnestablished { cause: c } => RehomePairRefused { reason: RehomeContractUnestablishedRefusal { cause: c } }
        RehomeContractRead { node: bn, identities: bi } =>
          if content_hash(n: an) == content_hash(n: bn) && roster_join(xs: ai, sep: ",") == roster_join(xs: bi, sep: ",") { RehomePairSame } else { RehomePairRefused { reason: RehomeSignatureDiffers } }
      }
  }
}

fn rehome_contract_of(home: String, name: String, path: String, prepared: PreparedGrammar, lex: PreparedLexRules, census: List<RehomeCensusRow>) -> RehomeContract {
  let read = Filesystem.Read(path: path)
  if !read.success { RehomeContractUnestablished { cause: "unreadable " + path } } else { rehome_contract_from_text(home: home, name: name, path: path, text: read.content, prepared: prepared, lex: lex, census: census) }
}

fn rehome_contract_from_text(home: String, name: String, path: String, text: String, prepared: PreparedGrammar, lex: PreparedLexRules, census: List<RehomeCensusRow>) -> RehomeContract {
  match tokenize_prepared(text: text, file: symbol_intern_lexeme(lexeme: path), prepared: lex) {
    Rejected { diagnostics: _ } => RehomeContractUnestablished { cause: "tokenize " + path }
    Accepted { value: stream, diagnostics: _ } =>
      match parse_module_prepared(tokens: stream, prepared: prepared) {
        Rejected { diagnostics: _ } => RehomeContractUnestablished { cause: "parse " + path }
        Accepted { value: artifact, diagnostics: _ } =>
          match normalize_with(parse_tree: artifact.tree, source: NormalizeWithIsolatedAllocator, spans: artifact.span_index) {
            Rejected { diagnostics: _ } => RehomeContractUnestablished { cause: "normalize " + path }
            Accepted { value: scoped, diagnostics: _ } =>
              rehome_contract_in(home: home, name: name, text: text, root: scoped.tree.root, spans: artifact.span_index, census: census)
          }
      }
  }
}

// THE IDENTITY HALF IS THE BINDING AUTHORITY'S, NOT A RESOLVER OF OURS (side chat on #14553). Every reference occurrence
// under the declaration is a row of the v2 occurrence-binding census (v2.compiler.occurrence_binding_census, read off
// v2.compiler.resolve ResolvedTree.occurrence_bindings) carried in the gate's WaveBaseReceipt: its authored spelling, its
// binding source class (an import, a parameter, a lexical binder, a declaration ...) and its resolved target. The
// declaration's rows are its module's rows located inside its parsed extent. A module the receipt does not cover, a row
// it could not locate, or a module row that is not a binding (an unanswered reference) leaves the contract unestablished.
fn rehome_contract_in(home: String, name: String, text: String, root: Node, spans: SpanIndex, census: List<RehomeCensusRow>) -> RehomeContract {
  match rehome_root_bindings_named(bindings: module_root_bindings(root: root), name: name) {
    Cons { head: decl, tail: Empty } =>
      match roster_node_byte_range(node: decl.declaration, spans: spans) {
        Absent => RehomeContractUnestablished { cause: "declaration-unlocated " + home + "." + name }
        Present { value: range } =>
          match rehome_rows_in(census: census, module: home, text: text, start: range.start, end: range.end) {
            RehomeRowsRefused { cause: c } => RehomeContractUnestablished { cause: c }
            RehomeRowsRead { rows: rs } => RehomeContractRead { node: decl.declaration, identities: list_map(xs: rs, f: fn(r) { r.authored + "|" + r.source + "|" + r.target }) }
          }
      }
    Empty => RehomeContractUnestablished { cause: "no-root-declaration " + home + "." + name }
    _ => RehomeContractUnestablished { cause: "several-root-declarations " + home + "." + name }
  }
}

fn rehome_root_bindings_named(bindings: List<ModuleRootBinding>, name: String) -> List<ModuleRootBinding> {
  fold_list(xs: bindings, empty: [], cons: fn(acc, b) { if symbol_lexeme(sym: b.name) == name { list_snoc_item(xs: acc, item: b) } else { acc } })
}

// ---- the binding census, as the gate's base receipt carries it ---------------------------------------------------------------

// One row of the receipt, as its producer prints it (v2.compiler.occurrence_binding_census occurrence_binding_census_line):
//   binding <module> <authored> <ordinal> <source> <target> <line>:<byte column>   (tab-separated; locus `-` when unlocated)
// Any other carried row kind naming a module (an unanswered reference) is kept as `kind` so a declaration it falls in refuses.
type RehomeCensusRow {
  kind: String
  module: String
  authored: String
  source: String
  target: String
  locus: JoinLocus
}

type RehomeRowsRead
  = RehomeRowsRead { rows: List<RehomeCensusRow> }
  | RehomeRowsRefused { cause: String }

// The module's rows inside [start, end) of `text`, in the census's own order. The module must have rows at all (absent is
// unobserved, never read as "no references"); any unlocated row, or any non-binding row, of the module refuses.
fn rehome_rows_in(census: List<RehomeCensusRow>, module: String, text: String, start: Int, end: Int) -> RehomeRowsRead {
  let mine = fold_list(xs: census, empty: [], cons: fn(acc, r) { if r.module == module { list_snoc_item(xs: acc, item: r) } else { acc } })
  if is_empty(xs: mine) {
    RehomeRowsRefused { cause: "representation-unobserved " + module }
  } else if fold_list(xs: mine, empty: false, cons: fn(f, r) { f || !rehome_located(locus: r.locus) }) {
    RehomeRowsRefused { cause: "unlocated-row " + module }
  } else if fold_list(xs: mine, empty: false, cons: fn(f, r) { f || r.kind != "binding" }) {
    RehomeRowsRefused { cause: "unanswered-row " + module }
  } else {
    let starts = line_starts(text: text)
    RehomeRowsRead { rows: fold_list(xs: mine, empty: [], cons: fn(acc, r) { if rehome_offset_within(offset: rehome_row_offset(starts: starts, locus: r.locus), start: start, end: end) { list_snoc_item(xs: acc, item: r) } else { acc } }) }
  }
}

// A row's locus read back to a byte offset by the gate's own conversion (namespace_wave_occurrence_join line_starts /
// offset_at), the inverse of the census producer's locus (v2.std.source_position: 1-based line, 1-based byte column).
fn rehome_row_offset(starts: List<Int>, locus: JoinLocus) -> Int {
  match locus {
    LocusAt { line: l, column: c } => offset_at(starts: starts, line: l, column: c)
    LocusAbsent => 0 - 1
    LocusMalformed { text: _ } => 0 - 1
  }
}

fn rehome_located(locus: JoinLocus) -> Bool {
  match locus {
    LocusAt { line: _, column: _ } => true
    LocusAbsent => false
    LocusMalformed { text: _ } => false
  }
}

fn rehome_offset_within(offset: Int, start: Int, end: Int) -> Bool {
  offset >= start && offset < end
}

// The receipt's rows, after the gate's own check of its key (base revision, instrument revision and census contract):
// gunbc.instruments.namespace_wave_binding_shard base_receipt_refusal judges, base_receipt_rows extracts. A mismatch refuses.
type RehomeCensusRead
  = RehomeCensusRows { rows: List<RehomeCensusRow> }
  | RehomeCensusRefused { cause: String }

fn rehome_census_of_receipt(text: String, base_rev: String, instr_rev: String) -> RehomeCensusRead {
  match base_receipt_refusal(key: BaseKey { base_rev: base_rev, instr_rev: instr_rev }, text: text) {
    Present { value: why } => RehomeCensusRefused { cause: "receipt-refused " + why }
    Absent => RehomeCensusRows { rows: rehome_census_rows(text: base_receipt_rows(text: text)) }
  }
}

fn rehome_census_rows(text: String) -> List<RehomeCensusRow> {
  fold_list(xs: split(s: text, delimiter: "\n"), empty: [], cons: fn(acc, line) { rehome_census_row_snoc(acc: acc, line: line) })
}

fn rehome_census_row_snoc(acc: List<RehomeCensusRow>, line: String) -> List<RehomeCensusRow> {
  let fields = split(s: line, delimiter: "\t")
  if length(xs: fields) < 3 { acc } else {
    let kind = rehome_field(fields: fields, at: 0)
    if kind == "binding" {
      list_snoc_item(xs: acc, item: RehomeCensusRow {
        kind: kind, module: rehome_field(fields: fields, at: 1), authored: rehome_field(fields: fields, at: 2),
        source: rehome_field(fields: fields, at: 4), target: rehome_field(fields: fields, at: 5),
        locus: read_join_locus(text: rehome_field(fields: fields, at: 6))
      })
    } else if kind == "binding_unanswered" && rehome_field(fields: fields, at: length(xs: fields) - 1) == "declared_order" {
      // THE CENSUS'S ONE NAMED SET-ASIDE (v2.compiler.occurrence_binding_census UnrecordedSplit): an Arrow's declared-order
      // head is a compiler-generated reference no one resolves, the same in every declaration. It is not a reference of the
      // declaration's own, so it neither joins a contract nor refuses one.
      acc
    } else {
      list_snoc_item(xs: acc, item: RehomeCensusRow { kind: kind, module: rehome_field(fields: fields, at: 1), authored: "", source: "", target: "", locus: LocusAbsent })
    }
  }
}

fn rehome_field(fields: List<String>, at: Int) -> String {
  match list_at_optional(xs: fields, index: at) {
    Present { value: f } => f
    Absent => ""
  }
}

// A DECLARED REPRESENTATION ADMITS A SHAPE DIFFERENCE, NEVER A KIND DIFFERENCE (review 83176): the content_hash comparison
// is skipped, the kind comparison is not. INTERIM, BOUNDED TO THE ALIAS GAP: v2.std.decl_index reads an aliased type
// declaration (v2.std.integer.Int = GroupCompletion<Nat>) as OtherItem, so a kind pair with OtherItem on either side is
// the gap, not a real kind difference, and is admitted here only under a declared representation. TRIGGER: when
// adhoc-0f4309c5-074 lands (aliased type declarations read TypeItem), delete the OtherItem arm, so any kind mismatch refuses.
fn rehome_kind_verdict(from: DeclFact, to: DeclFact) -> RehomePairVerdict {
  if rehome_kinds_equal(a: from.kind, b: to.kind) {
    RehomePairSame
  } else if rehome_is_alias_gap_pair(a: from.kind, b: to.kind) {
    RehomePairSame
  } else {
    RehomePairRefused { reason: RehomeKindDiffers }
  }
}

// Exactly the gap's pair, in either order: an aliased type read OtherItem against a TypeItem (review 83179). A match on the
// closed ItemKind constructors (review 83228), so the arm's dissolution is deleting this function and its one call.
fn rehome_is_alias_gap_pair(a: ItemKind, b: ItemKind) -> Bool {
  match a {
    OtherItem =>
      match b {
        TypeItem => true
        _ => false
      }
    TypeItem =>
      match b {
        OtherItem => true
        _ => false
      }
    _ => false
  }
}

// ItemKind equality by constructor, exhaustive over the closed sum (review 83228).
fn rehome_kinds_equal(a: ItemKind, b: ItemKind) -> Bool {
  match a {
    FnItem =>
      match b {
        FnItem => true
        _ => false
      }
    TypeItem =>
      match b {
        TypeItem => true
        _ => false
      }
    DataItem =>
      match b {
        DataItem => true
        _ => false
      }
    ServiceItem =>
      match b {
        ServiceItem => true
        _ => false
      }
    OtherItem =>
      match b {
        OtherItem => true
        _ => false
      }
  }
}


// ---- one file: the splices ----------------------------------------------------------------------------------------------

// The file's splices for one row, given the pair verdict and the new home's closure (both read once per run).
fn rehome_text(path: String, text: String, prepared: PreparedGrammar, lex: PreparedLexRules, row: RehomeRow, pair: RehomePairVerdict, closures: List<RosterHomeClosure>, census: List<RehomeCensusRow>, supplied: List<RehomeSuppliedModule>) -> RehomeOutcome {
  match tokenize_prepared(text: text, file: symbol_intern_lexeme(lexeme: path), prepared: lex) {
    Rejected { diagnostics: _ } => RehomeRefused { reason: RehomeTokenizeRefused }
    Accepted { value: stream, diagnostics: _ } =>
      match parse_module_prepared(tokens: stream, prepared: prepared) {
        Rejected { diagnostics: _ } => RehomeRefused { reason: RehomeParseRefused }
        Accepted { value: artifact, diagnostics: _ } =>
          match normalize_with(parse_tree: artifact.tree, source: NormalizeWithIsolatedAllocator, spans: artifact.span_index) {
            Rejected { diagnostics: _ } => RehomeRefused { reason: RehomeNormalizeRefused }
            Accepted { value: scoped, diagnostics: _ } =>
              rehome_parsed(text: text, tokens: stream.all, parse_root: artifact.tree, spans: artifact.span_index, imported: scoped.tree.import_bindings, row: row, pair: pair, closures: closures, census: census, supplied: supplied, prepared: prepared, lex: lex)
          }
      }
  }
}

fn rehome_parsed(text: String, tokens: List<Token>, parse_root: Node, spans: SpanIndex, imported: List<AliasBindingRow>, row: RehomeRow, pair: RehomePairVerdict, closures: List<RosterHomeClosure>, census: List<RehomeCensusRow>, supplied: List<RehomeSuppliedModule>, prepared: PreparedGrammar, lex: PreparedLexRules) -> RehomeOutcome {
  let old_qn = row.from_home + "." + row.name
  let bound_old = fold_list(xs: imported, empty: [], cons: fn(acc, b) { if roster_qn_text(qn: b.target) == old_qn { list_snoc_item(xs: acc, item: b) } else { acc } })
  let uses = rehome_qualified_uses(parse_root: parse_root, spans: spans, qualified_name: old_qn)
  if is_empty(xs: bound_old) && is_empty(xs: uses) {
    RehomeClean
  } else {
    match pair {
      RehomePairRefused { reason: r } => RehomeRefused { reason: r }
      RehomePairSame =>
        if fold_list(xs: bound_old, empty: false, cons: fn(f, b) { f || symbol_lexeme(sym: b.binding) != row.name }) {
          RehomeRefused { reason: RehomeAliasUnsupported }
        } else {
          match rehome_representation_sites(tokens: tokens, text: text, parse_root: parse_root, spans: spans, row: row, census: census, supplied: supplied, prepared: prepared, lex: lex) {
          RehomeSitesRefused { cause: c } => RehomeRefused { reason: RehomeContractUnestablishedRefusal { cause: c } }
          RehomeSitesRead { sites: rep_sites } =>
          if !is_empty(xs: rep_sites) {
            RehomeRefused { reason: RehomeRepresentationSitesRemain { sites: rehome_sites_text(sites: rep_sites) } }
          } else {
          match rehome_cycle(parse_root: parse_root, closures: closures, row: row, needs_import: !is_empty(xs: bound_old)) {
            Present { value: reason } => RehomeRefused { reason: reason }
            Absent =>
              match rehome_import_splices(text: text, parse_root: parse_root, spans: spans, imported: imported, row: row, moves_import: !is_empty(xs: bound_old)) {
                RehomeRefused { reason: r } => RehomeRefused { reason: r }
                RehomeClean => rehome_with_uses(splices: [], uses: uses, row: row)
                RehomeSplices { splices: ss } => rehome_with_uses(splices: ss, uses: uses, row: row)
              }
          }
          }
          }
        }
    }
  }
}

fn rehome_with_uses(splices: List<RehomeSplice>, uses: List<RehomeUse>, row: RehomeRow) -> RehomeOutcome {
  let all = fold_list(xs: uses, empty: splices, cons: fn(acc, u) {
    list_snoc_item(xs: acc, item: RehomeSplice {
      start: u.start,
      end: u.end,
      expect: row.from_home + "." + row.name,
      replacement: row.to_home + "." + row.name,
      kind: QualifiedUseRewrite,
      spelling_base_offset: Present { value: 0 },
      spelling_head_offset: Present { value: 0 }
    })
  })
  if is_empty(xs: all) { RehomeClean } else { RehomeSplices { splices: all } }
}

fn rehome_cycle(parse_root: Node, closures: List<RosterHomeClosure>, row: RehomeRow, needs_import: Bool) -> Optional<RehomeRefusal> {
  if !needs_import {
    Absent
  } else {
    match qualified_name_from_module_node(root: parse_root) {
      Rejected { diagnostics: _ } => Present { value: RehomeSweep { reason: roster_refusal_text(reason: RefusalModuleNameUnread) } }
      Accepted { value: qn, diagnostics: _ } =>
        match roster_cycle_refusal(closures: closures, home: row.to_home, module: roster_qn_text(qn: qn)) {
          Present { value: r } => Present { value: RehomeSweep { reason: roster_refusal_text(reason: r) } }
          Absent => Absent
        }
    }
  }
}

// THE IMPORT MOVE. The name leaves every import declaration of from_home that lists it (a declaration it empties is
// deleted with its line) and joins to_home's: an existing to_home declaration is extended, otherwise a new one takes
// the slot of an emptied from_home declaration, or the #14486 anchor (after the last import, else after the header).
// A file that already imports the name from to_home only loses the old binding.
fn rehome_import_splices(text: String, parse_root: Node, spans: SpanIndex, imported: List<AliasBindingRow>, row: RehomeRow, moves_import: Bool) -> RehomeOutcome {
  if !moves_import {
    RehomeClean
  } else {
    let decls = roster_import_decl_facts(parse_root: parse_root, spans: spans)
    let olds = rehome_decls_listing(decls: decls, module_name: row.from_home, name: row.name)
    let news = rehome_decls_of(decls: decls, module_name: row.to_home)
    let already = fold_list(xs: news, empty: false, cons: fn(f, d) { f || rehome_lists(names: d.names, name: row.name) })
    let removals = list_map(xs: olds, f: fn(d) { rehome_removal(text: text, d: d, row: row) })
    if already {
      RehomeSplices { splices: removals }
    } else {
      match news {
        Cons { head: n, tail: _ } =>
          RehomeSplices { splices: rehome_sorted_insert(xs: removals, item: RehomeSplice {
            start: n.start,
            end: n.end,
            expect: roster_render_import(home: qualified_name_from_dotted_string(dotted: row.to_home), names: n.names),
            replacement: roster_render_import(home: qualified_name_from_dotted_string(dotted: row.to_home), names: list_snoc_item(xs: n.names, item: row.name)),
            kind: ImportBlockRewrite,
            spelling_base_offset: Absent,
            spelling_head_offset: Absent
          }) }
        Empty => rehome_with_new_import(text: text, parse_root: parse_root, spans: spans, decls: decls, removals: removals, row: row)
      }
    }
  }
}

fn rehome_decls_of(decls: List<ImportDeclFact>, module_name: String) -> List<ImportDeclFact> {
  fold_list(xs: decls, empty: [], cons: fn(acc, d) { if d.module_name == module_name { list_snoc_item(xs: acc, item: d) } else { acc } })
}

fn rehome_decls_listing(decls: List<ImportDeclFact>, module_name: String, name: String) -> List<ImportDeclFact> {
  fold_list(xs: rehome_decls_of(decls: decls, module_name: module_name), empty: [], cons: fn(acc, d) { if rehome_lists(names: d.names, name: name) { list_snoc_item(xs: acc, item: d) } else { acc } })
}

fn rehome_lists(names: List<String>, name: String) -> Bool {
  fold_list(xs: names, empty: false, cons: fn(f, n) { f || n == name })
}

// Removing the name from one from_home declaration: the declaration re-rendered without it, or, when it was the only
// name, the declaration and its line deleted.
fn rehome_removal(text: String, d: ImportDeclFact, row: RehomeRow) -> RehomeSplice {
  let rest = fold_list(xs: d.names, empty: [], cons: fn(acc, n) { if n == row.name { acc } else { list_snoc_item(xs: acc, item: n) } })
  let rendered = roster_render_import(home: qualified_name_from_dotted_string(dotted: row.from_home), names: d.names)
  if is_empty(xs: rest) {
    RehomeSplice { start: d.start, end: d.end + 1, expect: rendered + "\n", replacement: "", kind: ImportBlockRewrite, spelling_base_offset: Absent, spelling_head_offset: Absent }
  } else {
    RehomeSplice { start: d.start, end: d.end, expect: rendered, replacement: roster_render_import(home: qualified_name_from_dotted_string(dotted: row.from_home), names: rest), kind: ImportBlockRewrite, spelling_base_offset: Absent, spelling_head_offset: Absent }
  }
}

// No to_home declaration yet: the new import replaces an emptied from_home declaration in place when there is one (so
// the two splices never meet), otherwise it is inserted at the anchor.
fn rehome_with_new_import(text: String, parse_root: Node, spans: SpanIndex, decls: List<ImportDeclFact>, removals: List<RehomeSplice>, row: RehomeRow) -> RehomeOutcome {
  let line = roster_render_import(home: qualified_name_from_dotted_string(dotted: row.to_home), names: [row.name])
  match rehome_first_deletion(splices: removals) {
    Present { value: del } =>
      RehomeSplices { splices: list_map(xs: removals, f: fn(s) { if s.start == del.start { RehomeSplice { start: s.start, end: s.end, expect: s.expect, replacement: line + "\n", kind: ImportBlockRewrite, spelling_base_offset: Absent, spelling_head_offset: Absent } } else { s } }) }
    Absent =>
      match roster_last_decl_end(decls: decls) {
        Present { value: at } => RehomeSplices { splices: rehome_sorted_insert(xs: removals, item: RehomeSplice { start: at, end: at, expect: "", replacement: "\n" + line, kind: ImportBlockRewrite, spelling_base_offset: Absent, spelling_head_offset: Absent }) }
        Absent =>
          match roster_module_header_end(parse_root: parse_root, spans: spans) {
            Present { value: at } => RehomeSplices { splices: rehome_sorted_insert(xs: removals, item: RehomeSplice { start: at, end: at, expect: "", replacement: "\n\n" + line, kind: ImportBlockRewrite, spelling_base_offset: Absent, spelling_head_offset: Absent }) }
            Absent => RehomeRefused { reason: RehomeNoImportAnchor }
          }
      }
  }
}

fn rehome_first_deletion(splices: List<RehomeSplice>) -> Optional<RehomeSplice> {
  fold_list(xs: splices, empty: Absent, cons: fn(acc, s) {
    match acc {
      Present { value: _ } => acc
      Absent => if s.replacement == "" { Present { value: s } } else { Absent }
    }
  })
}

// Splices are kept in ascending start order, which rehome_applied requires.
fn rehome_sorted_insert(xs: List<RehomeSplice>, item: RehomeSplice) -> List<RehomeSplice> {
  let placed = fold_list(xs: xs, empty: RehomeInsertion { out: [], done: false }, cons: fn(acc, s) {
    if !acc.done && item.start <= s.start {
      RehomeInsertion { out: list_snoc_item(xs: list_snoc_item(xs: acc.out, item: item), item: s), done: true }
    } else {
      RehomeInsertion { out: list_snoc_item(xs: acc.out, item: s), done: acc.done }
    }
  })
  if placed.done { placed.out } else { list_snoc_item(xs: placed.out, item: item) }
}

type RehomeInsertion {
  out: List<RehomeSplice>
  done: Bool
}

// ---- the representation census --------------------------------------------------------------------------------------------

type RehomeSite {
  start: Int
  end: Int
  what: String
}

type RehomeSitesScan
  = RehomeSitesRead { sites: List<RehomeSite> }
  | RehomeSitesRefused { cause: String }

// EVERY HEAD IS JUDGED BY WHAT IT RESOLVES TO, NEVER BY ITS SPELLING (side chat on #14553). A primary-expression or
// pattern head is a representation site when its census target reaches the old declaration or the representation's
// constructor, directly or through a chain of type aliases (rehome_target_reaches): `Int { .. }`, `GroupCompletion { .. }`,
// `std.algebra.GroupCompletion { .. }` and `LocalToken { .. }` with `type LocalToken = Int` are one rule. A head the census
// has no row for refuses representation-unobserved, conservatively. Field reads stay the untyped, fail-closed count.
fn rehome_representation_sites(tokens: List<Token>, text: String, parse_root: Node, spans: SpanIndex, row: RehomeRow, census: List<RehomeCensusRow>, supplied: List<RehomeSuppliedModule>, prepared: PreparedGrammar, lex: PreparedLexRules) -> RehomeSitesScan {
  match row.representation {
    Absent => RehomeSitesRead { sites: [] }
    Present { value: rep } =>
      match qualified_name_from_module_node(root: parse_root) {
        Rejected { diagnostics: _ } => RehomeSitesRefused { cause: "module-name-unread" }
        Accepted { value: qn, diagnostics: _ } =>
          match rehome_headed_sites(parse_root: parse_root, spans: spans, text: text, module: roster_qn_text(qn: qn), census: census, supplied: supplied, ends: [row.from_home + "." + row.name, rep.constructor], prepared: prepared, lex: lex) {
            RehomeSitesRefused { cause: c } => RehomeSitesRefused { cause: c }
            RehomeSitesRead { sites: heads } =>
              RehomeSitesRead { sites: fold_list(xs: rep.fields, empty: heads, cons: fn(acc, field) { list_append_sites(a: acc, b: rehome_field_read_sites(tokens: tokens, field: field)) }) }
          }
      }
  }
}

// An import declaration's own block names the constructor without using it; those tokens are not representation sites.
fn rehome_outside_imports(sites: List<RehomeSite>, imports: List<ImportDeclFact>) -> List<RehomeSite> {
  fold_list(xs: sites, empty: [], cons: fn(acc, site) {
    if fold_list(xs: imports, empty: false, cons: fn(inside, d) { inside || (site.start >= d.start && site.end <= d.end) }) { acc } else { list_snoc_item(xs: acc, item: site) }
  })
}

fn list_append_sites(a: List<RehomeSite>, b: List<RehomeSite>) -> List<RehomeSite> {
  fold_list(xs: b, empty: a, cons: fn(acc, x) { list_snoc_item(xs: acc, item: x) })
}

fn rehome_last_segment(qualified_name: String) -> String {
  fold_list(xs: split(s: qualified_name, delimiter: "."), empty: "", cons: fn(_last, seg) { seg })
}

// Identifier tokens spelled `lexeme` that are not the tail of a qualified spelling (no `.` before them).
fn rehome_token_sites(tokens: List<Token>, lexeme: String, what: String) -> List<RehomeSite> {
  fold_list(xs: tokens, empty: RehomeTokenScan { prev: "", sites: [] }, cons: fn(acc, t) {
    RehomeTokenScan {
      prev: rehome_lexeme_text(t: t),
      sites: if rehome_lexeme_text(t: t) == lexeme && acc.prev != "." { list_snoc_item(xs: acc.sites, item: RehomeSite { start: t.start, end: t.end, what: what }) } else { acc.sites }
    }
  }).sites
}

fn rehome_headed_sites(parse_root: Node, spans: SpanIndex, text: String, module: String, census: List<RehomeCensusRow>, supplied: List<RehomeSuppliedModule>, ends: List<String>, prepared: PreparedGrammar, lex: PreparedLexRules) -> RehomeSitesScan {
  let starts = line_starts(text: text)
  let mine = fold_list(xs: census, empty: [], cons: fn(acc, r) { if r.module == module && r.kind == "binding" { list_snoc_item(xs: acc, item: r) } else { acc } })
  fold_list(xs: node_subtree_nodes(root: parse_root), empty: RehomeSitesRead { sites: [] }, cons: fn(acc, n) {
    match acc {
      RehomeSitesRefused { cause: _ } => acc
      RehomeSitesRead { sites: found } =>
        match parse_production_emitted_identity_optional(node: n) {
          Absent => acc
          Present { value: id } =>
            if id == ^dag_surface_primary_expr || id == ^dag_surface_pattern {
              match rehome_head_atom(node: n) {
                Absent => acc
                Present { value: head } => rehome_judge_head(found: found, head: head, spans: spans, starts: starts, module: module, rows: mine, census: census, supplied: supplied, ends: ends, prepared: prepared, lex: lex)
              }
            } else {
              acc
            }
        }
    }
  })
}

fn rehome_judge_head(found: List<RehomeSite>, head: Node, spans: SpanIndex, starts: List<Int>, module: String, rows: List<RehomeCensusRow>, census: List<RehomeCensusRow>, supplied: List<RehomeSuppliedModule>, ends: List<String>, prepared: PreparedGrammar, lex: PreparedLexRules) -> RehomeSitesScan {
  if dag_node_is_int_literal_atom(node: head) || dag_node_is_float_literal_atom(node: head) || dag_node_is_string_literal_atom(node: head) {
    RehomeSitesRead { sites: found }
  } else {
    match roster_node_byte_range(node: head, spans: spans) {
      Absent => RehomeSitesRefused { cause: "representation-unobserved head-unlocated " + module }
      Present { value: r } =>
        match rehome_row_at(rows: rows, starts: starts, offset: r.start) {
          Absent => RehomeSitesRefused { cause: "representation-unobserved " + module + "@" + int_to_decimal_string(value: r.start) }
          Present { value: hit } =>
            match rehome_target_reaches(target: hit.target, ends: ends, census: census, supplied: supplied, prepared: prepared, lex: lex, depth: 0) {
              RehomeReaches => RehomeSitesRead { sites: list_snoc_item(xs: found, item: RehomeSite { start: r.start, end: r.end, what: "representation-head" }) }
              RehomeReachesNot => RehomeSitesRead { sites: found }
              RehomeReachUnobserved { cause: c } => RehomeSitesRefused { cause: c }
            }
        }
    }
  }
}

fn rehome_row_at(rows: List<RehomeCensusRow>, starts: List<Int>, offset: Int) -> Optional<RehomeCensusRow> {
  fold_list(xs: rows, empty: Absent, cons: fn(acc, r) {
    match acc {
      Present { value: _ } => acc
      Absent => if rehome_row_offset(starts: starts, locus: r.locus) == offset { Present { value: r } } else { Absent }
    }
  })
}

fn rehome_head_atom(node: Node) -> Optional<Node> {
  match parse_production_captured_child_optional(node: node) {
    Present { value: cap } =>
      match find_named_child(root: cap, name: ^grammar_sequence_left_node_projection) {
        Accepted { value: left, diagnostics: _ } => Present { value: left }
        Rejected { diagnostics: _ } => Absent
      }
    Absent => Absent
  }
}

// A MODULE TEXT SUPPLIED AT THE BOUNDARY where the alias chain reads a declaration's file: production supplies none (every
// step reads decl_index and the file), the controls supply their fixture modules (DESIGN section 3, a witness supplies
// values at one interface; the inhabitance control runs the real route).
type RehomeSuppliedModule {
  module: String
  path: String
  text: String
}

type RehomeReach
  = RehomeReaches
  | RehomeReachesNot
  | RehomeReachUnobserved { cause: String }

// Does `target` (a resolved declaration's qualified name) reach one of `ends` through type aliases? Only an alias is
// followed: its right-hand side's head row, from the same census. Its kind is read from v2.std.decl_index first, so a fn,
// data or service target ends the chain without a parse. A chain longer than the bound, or a step the census or the
// files cannot establish, is unobserved -- never "does not reach".
fn rehome_target_reaches(target: String, ends: List<String>, census: List<RehomeCensusRow>, supplied: List<RehomeSuppliedModule>, prepared: PreparedGrammar, lex: PreparedLexRules, depth: Int) -> RehomeReach {
  if fold_list(xs: ends, empty: false, cons: fn(f, e) { f || e == target }) {
    RehomeReaches
  } else if depth > 16 {
    RehomeReachUnobserved { cause: "representation-unobserved alias-chain-too-long " + target }
  } else {
    let home = rehome_qualifier(qualified_name: target)
    let name = rehome_last_segment(qualified_name: target)
    match rehome_supplied_text(supplied: supplied, module: home) {
      Present { value: m } => rehome_alias_text_step(text: m.text, path: m.path, home: home, name: name, ends: ends, census: census, supplied: supplied, prepared: prepared, lex: lex, depth: depth)
      Absent =>
    match rehome_sole_fact(home: home, name: name) {
      RehomeFactRefused { reason: _ } => RehomeReachesNot
      RehomeFactFound { fact: f } =>
        match f.kind {
          FnItem => RehomeReachesNot
          DataItem => RehomeReachesNot
          ServiceItem => RehomeReachesNot
          TypeItem => rehome_alias_step(fact: f, home: home, name: name, ends: ends, census: census, supplied: supplied, prepared: prepared, lex: lex, depth: depth)
          OtherItem => rehome_alias_step(fact: f, home: home, name: name, ends: ends, census: census, supplied: supplied, prepared: prepared, lex: lex, depth: depth)
        }
    }
    }
  }
}

fn rehome_supplied_text(supplied: List<RehomeSuppliedModule>, module: String) -> Optional<RehomeSuppliedModule> {
  fold_list(xs: supplied, empty: Absent, cons: fn(acc, m) { if m.module == module { Present { value: m } } else { acc } })
}

fn rehome_alias_step(fact: DeclFact, home: String, name: String, ends: List<String>, census: List<RehomeCensusRow>, supplied: List<RehomeSuppliedModule>, prepared: PreparedGrammar, lex: PreparedLexRules, depth: Int) -> RehomeReach {
  let read = Filesystem.Read(path: fact.rel_path)
  if !read.success { RehomeReachUnobserved { cause: "representation-unobserved unreadable " + fact.rel_path } } else {
    rehome_alias_text_step(text: read.content, path: fact.rel_path, home: home, name: name, ends: ends, census: census, supplied: supplied, prepared: prepared, lex: lex, depth: depth)
  }
}

fn rehome_alias_text_step(text: String, path: String, home: String, name: String, ends: List<String>, census: List<RehomeCensusRow>, supplied: List<RehomeSuppliedModule>, prepared: PreparedGrammar, lex: PreparedLexRules, depth: Int) -> RehomeReach {
  {
    match rehome_alias_rhs_extent(text: text, path: path, name: name, prepared: prepared, lex: lex) {
      RehomeNotAlias => RehomeReachesNot
      RehomeAliasUnread { cause: c } => RehomeReachUnobserved { cause: c }
      RehomeAliasAt { start: s, end: e } =>
        match rehome_rows_in(census: census, module: home, text: text, start: s, end: e) {
          RehomeRowsRefused { cause: c } => RehomeReachUnobserved { cause: c }
          RehomeRowsRead { rows: rs } =>
            match rs {
              Cons { head: first, tail: _ } => rehome_target_reaches(target: first.target, ends: ends, census: census, supplied: supplied, prepared: prepared, lex: lex, depth: depth + 1)
              Empty => RehomeReachUnobserved { cause: "representation-unobserved alias-rhs-without-row " + home + "." + name }
            }
        }
    }
  }
}

type RehomeAliasExtent
  = RehomeAliasAt { start: Int, end: Int }
  | RehomeNotAlias
  | RehomeAliasUnread { cause: String }

// The type declarations named `name`, read off the parse by the reader normalize uses for a type declaration's own name
// (parse_production_captured_child_optional, then dag_surface_kw_then_ident_from_captured). The parse shell carries the
// declaration's source extent; a lowered alias need not.
fn rehome_type_decl_shells(parse_root: Node, name: String) -> List<Node> {
  fold_list(xs: node_subtree_nodes(root: parse_root), empty: [], cons: fn(acc, n) {
    match parse_production_emitted_identity_optional(node: n) {
      Present { value: id } =>
        if id == ^dag_surface_type_decl {
          match parse_production_captured_child_optional(node: n) {
            Present { value: cap } =>
              match dag_surface_kw_then_ident_from_captured(captured: cap) {
                Present { value: sym } => if symbol_lexeme(sym: sym) == name { list_snoc_item(xs: acc, item: n) } else { acc }
                Absent => acc
              }
            Absent => acc
          }
        } else {
          acc
        }
      Absent => acc
    }
  })
}

// The extent of the type-alias right-hand side of the root declaration `name`, read off the parse: the type_alias_rhs
// production inside the declaration's extent. A declaration with none is not an alias.
fn rehome_alias_rhs_extent(text: String, path: String, name: String, prepared: PreparedGrammar, lex: PreparedLexRules) -> RehomeAliasExtent {
  match tokenize_prepared(text: text, file: symbol_intern_lexeme(lexeme: path), prepared: lex) {
    Rejected { diagnostics: _ } => RehomeAliasUnread { cause: "representation-unobserved tokenize " + path }
    Accepted { value: stream, diagnostics: _ } =>
      match parse_module_prepared(tokens: stream, prepared: prepared) {
        Rejected { diagnostics: _ } => RehomeAliasUnread { cause: "representation-unobserved parse " + path }
        Accepted { value: artifact, diagnostics: _ } =>
          match normalize_with(parse_tree: artifact.tree, source: NormalizeWithIsolatedAllocator, spans: artifact.span_index) {
            Rejected { diagnostics: _ } => RehomeAliasUnread { cause: "representation-unobserved normalize " + path }
            Accepted { value: _, diagnostics: _ } =>
              match rehome_type_decl_shells(parse_root: artifact.tree, name: name) {
                Cons { head: shell, tail: Empty } =>
                  match roster_node_byte_range(node: shell, spans: artifact.span_index) {
                    Absent => RehomeAliasUnread { cause: "representation-unobserved declaration-unlocated " + path }
                    Present { value: d } => rehome_rhs_within(parse_root: artifact.tree, spans: artifact.span_index, start: d.start, end: d.end)
                  }
                Empty => RehomeNotAlias
                _ => RehomeAliasUnread { cause: "representation-unobserved declaration-not-unique " + path + " " + name }
              }
          }
      }
  }
}

fn rehome_rhs_within(parse_root: Node, spans: SpanIndex, start: Int, end: Int) -> RehomeAliasExtent {
  fold_list(xs: node_subtree_nodes(root: parse_root), empty: RehomeNotAlias, cons: fn(acc, n) {
    match acc {
      RehomeAliasAt { start: _, end: _ } => acc
      _ =>
        match parse_production_emitted_identity_optional(node: n) {
          Present { value: id } =>
            if id == ^dag_surface_type_alias_rhs {
              match roster_node_byte_range(node: n, spans: spans) {
                Present { value: r } => if r.start >= start && r.end <= end { RehomeAliasAt { start: r.start, end: r.end } } else { acc }
                Absent => acc
              }
            } else {
              acc
            }
          Absent => acc
        }
    }
  })
}

fn rehome_qualifier(qualified_name: String) -> String {
  let segs = split(s: qualified_name, delimiter: ".")
  roster_join(xs: fold_list(xs: segs, empty: RehomeQualifierScan { index: 0, kept: [] }, cons: fn(acc, seg) { RehomeQualifierScan { index: acc.index + 1, kept: if acc.index < length(xs: segs) - 1 { list_snoc_item(xs: acc.kept, item: seg) } else { acc.kept } } }).kept, sep: ".")
}

type RehomeQualifierScan {
  index: Int
  kept: List<String>
}

// `.field` reads: an identifier spelled `field` directly after a `.` token.
fn rehome_field_read_sites(tokens: List<Token>, field: String) -> List<RehomeSite> {
  fold_list(xs: tokens, empty: RehomeTokenScan { prev: "", sites: [] }, cons: fn(acc, t) {
    RehomeTokenScan {
      prev: rehome_lexeme_text(t: t),
      sites: if rehome_lexeme_text(t: t) == field && acc.prev == "." { list_snoc_item(xs: acc.sites, item: RehomeSite { start: t.start, end: t.end, what: "field-read-untyped:" + field }) } else { acc.sites }
    }
  }).sites
}

type RehomeTokenScan {
  prev: String
  sites: List<RehomeSite>
}

fn rehome_lexeme_text(t: Token) -> String {
  t.lexeme as String
}

fn rehome_sites_text(sites: List<RehomeSite>) -> String {
  roster_join(xs: list_map(xs: sites, f: fn(x) { rehome_site_text(site: x) }), sep: ",")
}

fn rehome_site_text(site: RehomeSite) -> String {
  site.what + "@" + int_to_decimal_string(value: site.start) + "-" + int_to_decimal_string(value: site.end)
}

// ---- qualified uses: every qualified-name production spelled exactly <from_home>.<name> ----------------------------------

type RehomeUse {
  start: Int
  end: Int
}

fn rehome_qualified_uses(parse_root: Node, spans: SpanIndex, qualified_name: String) -> List<RehomeUse> {
  fold_list(xs: node_subtree_nodes(root: parse_root), empty: [], cons: fn(acc, n) {
    match parse_production_emitted_identity_optional(node: n) {
      Present { value: id } =>
        if id == ^dag_surface_qualified_name && rehome_node_spells(node: n, root: parse_root, qualified_name: qualified_name) {
          match roster_node_byte_range(node: n, spans: spans) {
            Present { value: r } => list_snoc_item(xs: acc, item: RehomeUse { start: r.start, end: r.end })
            Absent => acc
          }
        } else {
          acc
        }
      Absent => acc
    }
  })
}

// The spelling of a qualified-name production, read by the parser's own segment reader over the production's capture.
fn rehome_node_spells(node: Node, root: Node, qualified_name: String) -> Bool {
  match parse_production_captured_child_optional(node: node) {
    Present { value: cap } =>
      match parse_qualified_name_segments_from_capture(qn_capture: cap, root: root) {
        Accepted { value: segs, diagnostics: _ } => roster_join(xs: list_map(xs: segs, f: fn(x) { symbol_lexeme(sym: x) }), sep: ".") == qualified_name
        Rejected { diagnostics: _ } => false
      }
    Absent => false
  }
}

// ---- the pure apply and the planner record --------------------------------------------------------------------------------

type RehomeApplied
  = RehomeWritten { content: String, rewrites: List<RehomeRewrite> }
  | RehomeApplyRefused { reason: RehomeRefusal }

// ONE PASS, ASCENDING: each splice's base bytes must equal its `expect` (the stale-read check per splice, in place of a
// byte-shape guess), splices may not overlap, and the head extent of each is its base start moved by every earlier
// splice's octet delta. The content and the record come from the same fold, so they cannot disagree.
fn rehome_applied(before: String, splices: List<RehomeSplice>) -> RehomeApplied {
  let octets = bytes_octets(b: utf8_encode_bytes(s: before))
  let state = fold_list(xs: splices, empty: RehomeFold { out: "", base_scalar: 0, base_byte: 0, delta: 0, rewrites: [], refused: false }, cons: fn(acc, s) {
    if acc.refused { acc } else {
      let from = roster_scalar_boundary(octets: octets, byte: s.start)
      let to = roster_scalar_boundary(octets: octets, byte: s.end)
      if from < 0 || to < from || s.start < acc.base_byte || substring(s: before, start: from, end: to) != s.expect {
        RehomeFold { out: acc.out, base_scalar: acc.base_scalar, base_byte: acc.base_byte, delta: acc.delta, rewrites: acc.rewrites, refused: true }
      } else {
        let head_start = s.start + acc.delta
        let added = rehome_octet_length(text: s.replacement)
        RehomeFold {
          out: acc.out + substring(s: before, start: acc.base_scalar, end: from) + s.replacement,
          base_scalar: to,
          base_byte: s.end,
          delta: acc.delta + added - (s.end - s.start),
          rewrites: list_snoc_item(xs: acc.rewrites, item: RehomeRewrite {
            base_start: s.start,
            base_end: s.end,
            head_start: head_start,
            head_end: head_start + added,
            kind: s.kind,
            spelling_base_offset: s.spelling_base_offset,
            spelling_head_offset: s.spelling_head_offset
          }),
          refused: false
        }
      }
    }
  })
  if state.refused {
    RehomeApplyRefused { reason: RehomeExtentMismatch }
  } else {
    RehomeWritten { content: state.out + substring(s: before, start: state.base_scalar, end: string_length(s: before)), rewrites: state.rewrites }
  }
}

type RehomeFold {
  out: String
  base_scalar: Int
  base_byte: Int
  delta: Int
  rewrites: List<RehomeRewrite>
  refused: Bool
}

fn rehome_octet_length(text: String) -> Int {
  length(xs: bytes_octets(b: utf8_encode_bytes(s: text)))
}

// ---- rows: report and apply, one row per run ------------------------------------------------------------------------------

//   REHOME <path> <start> <end> <replacement>      replacement escaped as roster_escape_replacement escapes it
//   REWRITE <path> <kind> <base_start> <base_end> <head_start> <head_end> <spelling_base|-> <spelling_head|->
//   REFUSE <path> <cause>
fn rehome_render(path: String, before: String, outcome: RehomeOutcome) -> String {
  match outcome {
    RehomeClean => ""
    RehomeRefused { reason: r } => "REFUSE " + path + " " + rehome_refusal_text(r: r) + "\n"
    RehomeSplices { splices: ss } =>
      match rehome_applied(before: before, splices: ss) {
        RehomeApplyRefused { reason: r } => "REFUSE " + path + " " + rehome_refusal_text(r: r) + "\n"
        RehomeWritten { content: _, rewrites: rws } =>
          fold_list(xs: ss, empty: "", cons: fn(acc, s) { acc + "REHOME " + path + " " + int_to_decimal_string(value: s.start) + " " + int_to_decimal_string(value: s.end) + " " + roster_escape_replacement(text: s.replacement) + "\n" })
            + fold_list(xs: rws, empty: "", cons: fn(acc, w) { acc + rehome_rewrite_row(path: path, w: w) })
      }
  }
}

fn rehome_rewrite_row(path: String, w: RehomeRewrite) -> String {
  "REWRITE " + path + " " + rehome_kind_name(k: w.kind) + " " + int_to_decimal_string(value: w.base_start) + " " + int_to_decimal_string(value: w.base_end)
    + " " + int_to_decimal_string(value: w.head_start) + " " + int_to_decimal_string(value: w.head_end)
    + " " + rehome_offset_text(o: w.spelling_base_offset) + " " + rehome_offset_text(o: w.spelling_head_offset) + "\n"
}

fn rehome_kind_name(k: RehomeRewriteKind) -> String {
  match k {
    ImportBlockRewrite => "import-block"
    QualifiedUseRewrite => "qualified-use"
  }
}

fn rehome_offset_text(o: Int?) -> String {
  match o {
    Present { value: v } => int_to_decimal_string(value: v)
    Absent => "-"
  }
}

// THE ROW TABLE: rehomes whose shape or representation needs declaring live here as data, and run by name
// (rehome_table_sweep_exit / rehome_table_apply_exit). N7 Int delivery 2 (tidy-ant-251's ruling A): v2.std.integer.Int is
// GroupCompletion<Nat>, std.integer.Int is NonNegative | Negative, so a module moves only once it has no GroupCompletion
// site and no .pos / .neg read.
fn rehome_rows() -> List<RehomeRow> {
  [
    RehomeRow {
      name: "Int",
      from_home: "v2.std.integer",
      to_home: "std.integer",
      representation: Present { value: RehomeRepresentation { constructor: "std.algebra.GroupCompletion", fields: ["pos", "neg"] } }
    }
  ]
}

fn rehome_table_row(name: String) -> Optional<RehomeRow> {
  fold_list(xs: rehome_rows(), empty: Absent, cons: fn(acc, r) { if r.name == name { Present { value: r } } else { acc } })
}

fn rehome_table_sweep_exit(paths_csv: String, name: String, receipt_path: String, base_rev: String, instr_rev: String) -> ProcessExit {
  match rehome_table_row(name: name) {
    Absent => exit_failure(reason: "REFUSE * rehome-row-unknown " + name + "\n")
    Present { value: row } => {
      let rows = rehome_sweep(root: "", paths_csv: paths_csv, row: row, receipt_path: receipt_path, base_rev: base_rev, instr_rev: instr_rev)
      if rows == "" { ExitSuccess } else { exit_failure(reason: rows) }
    }
  }
}

fn rehome_row_of(name: String, from_home: String, to_home: String) -> RehomeRow {
  RehomeRow { name: name, from_home: from_home, to_home: to_home, representation: Absent }
}

// THE REPORT: rows for every path, writing nothing. Exit 0 means no file has anything to move.
fn rehome_sweep_exit(paths_csv: String, name: String, from_home: String, to_home: String, receipt_path: String, base_rev: String, instr_rev: String) -> ProcessExit {
  let rows = rehome_sweep(root: "", paths_csv: paths_csv, row: rehome_row_of(name: name, from_home: from_home, to_home: to_home), receipt_path: receipt_path, base_rev: base_rev, instr_rev: instr_rev)
  if rows == "" { ExitSuccess } else { exit_failure(reason: rows) }
}

// THE CENSUS INPUT IS THE GATE'S BASE RECEIPT (tidy-ant-251's ruling: no second census run), read from `receipt_path` and
// admitted only when its key -- base revision, instrument revision and census contract -- is the expected one.
fn rehome_receipt_census(root: String, receipt_path: String, base_rev: String, instr_rev: String) -> RehomeCensusRead {
  let read = Filesystem.Read(path: receipt_path)
  if !read.success { RehomeCensusRefused { cause: "receipt-unreadable " + receipt_path } } else { rehome_census_of_receipt(text: read.content, base_rev: base_rev, instr_rev: instr_rev) }
}

fn rehome_sweep(root: String, paths_csv: String, row: RehomeRow, receipt_path: String, base_rev: String, instr_rev: String) -> String {
  match rehome_receipt_census(root: root, receipt_path: receipt_path, base_rev: base_rev, instr_rev: instr_rev) {
    RehomeCensusRefused { cause: c } => "REFUSE * rehome-contract-unestablished " + c + "\n"
    RehomeCensusRows { rows: census } => rehome_sweep_with(root: root, paths_csv: paths_csv, row: row, census: census)
  }
}

fn rehome_sweep_with(root: String, paths_csv: String, row: RehomeRow, census: List<RehomeCensusRow>) -> String {
  match dag_prepared_grammar() {
    Rejected { diagnostics: _ } => "REFUSE * " + rehome_refusal_text(r: RehomeGrammarUnprepared) + "\n"
    Accepted { value: prepared, diagnostics: _ } => {
      let pair = rehome_pair_verdict(row: row, prepared: prepared, lex: dag_prepared_lex(), census: census)
      let closures = [roster_home_closure_read(home: row.to_home, bindings: roster_repository_bindings(root: root))]
      fold_list(xs: split(s: paths_csv, delimiter: ","), empty: "", cons: fn(acc, path) {
        acc + rehome_sweep_path(path: path, prepared: prepared, lex: dag_prepared_lex(), row: row, pair: pair, closures: closures, census: census)
      })
    }
  }
}

fn rehome_sweep_path(path: String, prepared: PreparedGrammar, lex: PreparedLexRules, row: RehomeRow, pair: RehomePairVerdict, closures: List<RosterHomeClosure>, census: List<RehomeCensusRow>) -> String {
  let read = Filesystem.Read(path: path)
  if read.success {
    rehome_render(path: path, before: read.content, outcome: rehome_text(path: path, text: read.content, prepared: prepared, lex: lex, row: row, pair: pair, closures: closures, census: census, supplied: []))
  } else {
    "REFUSE " + path + " " + rehome_refusal_text(r: RehomeUnreadable) + "\n"
  }
}

// THE APPLY: one row, under the roster's apply lock, with the roster's target and stale-read checks, then the same pure
// rehome_applied the report renders. Success is silent.
fn rehome_apply_exit(root_dir: String, paths_csv: String, name: String, from_home: String, to_home: String, receipt_path: String, base_rev: String, instr_rev: String) -> ProcessExit {
  let row = rehome_row_of(name: name, from_home: from_home, to_home: to_home)
  let report = match roster_lock_acquire(root_dir: root_dir) {
    RosterLockRefused { reason: r } => "REFUSE * " + roster_refusal_text(reason: r) + "\n"
    RosterLockAcquired { held: held } => {
      let out = match rehome_receipt_census(root: held.root, receipt_path: receipt_path, base_rev: base_rev, instr_rev: instr_rev) {
        RehomeCensusRefused { cause: c } => "REFUSE * rehome-contract-unestablished " + c + "\n"
        RehomeCensusRows { rows: census } => rehome_apply_locked(held: held, paths_csv: paths_csv, row: row, census: census)
      }
      if roster_lock_release(held: held) { out } else { out + "REFUSE * apply-lock-not-released\n" }
    }
  }
  if report == "" { ExitSuccess } else { exit_failure(reason: report) }
}

fn rehome_apply_locked(held: RosterHeldLock, paths_csv: String, row: RehomeRow, census: List<RehomeCensusRow>) -> String {
  match dag_prepared_grammar() {
    Rejected { diagnostics: _ } => "REFUSE * " + rehome_refusal_text(r: RehomeGrammarUnprepared) + "\n"
    Accepted { value: prepared, diagnostics: _ } => {
      let pair = rehome_pair_verdict(row: row, prepared: prepared, lex: dag_prepared_lex(), census: census)
      let closures = [roster_home_closure_read(home: row.to_home, bindings: roster_repository_bindings(root: held.root))]
      fold_list(xs: split(s: paths_csv, delimiter: ","), empty: "", cons: fn(acc, path) {
        acc + rehome_apply_path(held: held, path: path, prepared: prepared, lex: dag_prepared_lex(), row: row, pair: pair, closures: closures, census: census)
      })
    }
  }
}

fn rehome_apply_path(held: RosterHeldLock, path: String, prepared: PreparedGrammar, lex: PreparedLexRules, row: RehomeRow, pair: RehomePairVerdict, closures: List<RosterHomeClosure>, census: List<RehomeCensusRow>) -> String {
  if !roster_path_admitted(path: path) {
    "REFUSE " + path + " path-outside-root\n"
  } else {
    let read = Filesystem.Read(path: held.root + "/" + path)
    if !read.success {
      "REFUSE " + path + " " + rehome_refusal_text(r: RehomeUnreadable) + "\n"
    } else {
      match rehome_text(path: path, text: read.content, prepared: prepared, lex: lex, row: row, pair: pair, closures: closures, census: census, supplied: []) {
        RehomeClean => ""
        RehomeRefused { reason: r } => "REFUSE " + path + " " + rehome_refusal_text(r: r) + "\n"
        RehomeSplices { splices: ss } => rehome_write(held: held, path: path, before: read.content, splices: ss)
      }
    }
  }
}

fn rehome_write(held: RosterHeldLock, path: String, before: String, splices: List<RehomeSplice>) -> String {
  if !roster_lock_still_held(held: held) {
    "REFUSE " + path + " " + rehome_refusal_text(r: RehomeLockNotHeld) + "\n"
  } else {
    match roster_target_refusal(root: held.root, path: path) {
      Present { value: r } => "REFUSE " + path + " " + roster_refusal_text(reason: r) + "\n"
      Absent =>
        if !roster_target_unchanged(root: held.root, path: path, before: before) {
          "REFUSE " + path + " " + rehome_refusal_text(r: RehomeStaleRead) + "\n"
        } else {
          match rehome_applied(before: before, splices: splices) {
            RehomeApplyRefused { reason: r } => "REFUSE " + path + " " + rehome_refusal_text(r: r) + "\n"
            RehomeWritten { content: c, rewrites: _ } =>
              if c == before { "" } else if Filesystem.Write(path: held.root + "/" + path, content: c).success { "" } else { "REFUSE " + path + " " + rehome_refusal_text(r: RehomeWriteFailed) + "\n" }
          }
        }
    }
  }
}

// ---- controls ----------------------------------------------------------------------------------------------------------------

// gunbc run --source-root dag --source-root src/v2 --entry src/v2/workflow/roster_rehome.dag --function rehome_controls_exit
fn rehome_controls_exit() -> ProcessExit {
  let report = rehome_controls_report()
  if report == "" { ExitSuccess } else { exit_failure(reason: report) }
}

// THE INHABITANCE CONTROL FOR THE SUPPLIED CENSUS ROWS (tidy-ant-251's ruling on #14553): a REAL WaveBaseReceipt, produced
// by `gunbc test //gunbc/instruments:namespace-wave-binding-diff` in base mode, is admitted by the gate's own key check, its
// rows are read by the same reader the controls' supplied rows go through, and the declaration contract of `home.name` is
// ESTABLISHED from them on the real file. Exit 0 only when every step holds; the printed reason names the step that did not.
//   gunbc run --source-root dag --source-root src/v2 --entry src/v2/workflow/roster_rehome.dag \
//     --function rehome_receipt_inhabited_wire --arg receipt_path=<base receipt> --arg base_rev=<rev> --arg instr_rev=<rev> \
//     --arg home=<module the receipt covers> --arg name=<declaration in it>
fn rehome_receipt_inhabited_wire(receipt_path: String, base_rev: String, instr_rev: String, home: String, name: String) -> CliWireResponse {
  match rehome_receipt_census(root: "", receipt_path: receipt_path, base_rev: base_rev, instr_rev: instr_rev) {
    RehomeCensusRefused { cause: c } => rehome_inhabit_fail(reason: "receipt not admitted: " + c)
    RehomeCensusRows { rows: census } =>
      if is_empty(xs: census) { rehome_inhabit_fail(reason: "receipt admitted but carried no row") } else {
        match dag_prepared_grammar() {
          Rejected { diagnostics: _ } => rehome_inhabit_fail(reason: "grammar-unprepared")
          Accepted { value: prepared, diagnostics: _ } =>
            match rehome_sole_fact(home: home, name: name) {
              RehomeFactRefused { reason: r } => rehome_inhabit_fail(reason: "declaration " + home + "." + name + ": " + rehome_refusal_text(r: r))
              RehomeFactFound { fact: f } =>
                match rehome_contract_of(home: home, name: name, path: f.rel_path, prepared: prepared, lex: dag_prepared_lex(), census: census) {
                  RehomeContractUnestablished { cause: c } => rehome_inhabit_fail(reason: "contract unestablished on the real receipt: " + c)
                  RehomeContractRead { node: _, identities: ids } =>
                    if is_empty(xs: ids) { rehome_inhabit_fail(reason: "contract established with no reference row: the declaration's extent matched nothing") }
                    else { CliWirePrintable { bytes: "INHABITED " + int_to_decimal_string(value: length(xs: census)) + " rows; " + home + "." + name + " contract: " + roster_join(xs: ids, sep: ", ") + "\n", exit: ExitSuccess } }
                }
            }
        }
      }
  }
}

fn rehome_inhabit_fail(reason: String) -> CliWireResponse {
  CliWirePrintable { bytes: reason + "\n", exit: exit_failure(reason: reason) }
}

// THE GATED ENTRY: `gunbc test //gunbc/instruments:roster-rehome-controls` (gunbc.instrument_targets
// roster_rehome_controls_binding).
fn rehome_controls_wire() -> CliWireResponse {
  let report = rehome_controls_report()
  if report == "" {
    CliWirePrintable { bytes: "roster-rehome controls held\n", exit: ExitSuccess }
  } else {
    CliWirePrintable { bytes: report, exit: exit_failure(reason: report) }
  }
}

fn rehome_control_row() -> RehomeRow {
  RehomeRow { name: "Token", from_home: "c.old", to_home: "c.new", representation: Absent }
}

// The controls' closure for the new home is a supplied value holding no c.* fixture module.
fn rehome_control_closures() -> List<RosterHomeClosure> {
  [RosterClosureRead { home: "c.new", modules: ["c.new"] }]
}

fn rehome_controls_report() -> String {
  match dag_prepared_grammar() {
    Rejected { diagnostics: _ } => "CONTROL-FAIL grammar-unprepared\n"
    Accepted { value: prepared, diagnostics: _ } => {
      let lex = dag_prepared_lex()
      rehome_control_moves(name: "sole-import", prepared: prepared, lex: lex,
        before: "module c.user\n\nimport c.old { Token }\n\nfn f(t: Token) -> Token {\n  t\n}\n",
        after: "module c.user\n\nimport c.new { Token }\n\nfn f(t: Token) -> Token {\n  t\n}\n")
        + rehome_control_moves(name: "shared-block", prepared: prepared, lex: lex,
          before: "module c.user\n\nimport c.old { Other, Token }\nimport c.new { Kept }\n\nfn f(t: Token, o: Other, k: Kept) -> Token {\n  t\n}\n",
          after: "module c.user\n\nimport c.old { Other }\nimport c.new { Kept, Token }\n\nfn f(t: Token, o: Other, k: Kept) -> Token {\n  t\n}\n")
        + rehome_control_moves(name: "qualified-use", prepared: prepared, lex: lex,
          before: "module c.user\n\nimport c.base { Unit }\n\nfn f(t: c.old.Token, u: Unit) -> c.old.Token {\n  t\n}\n",
          after: "module c.user\n\nimport c.base { Unit }\n\nfn f(t: c.new.Token, u: Unit) -> c.new.Token {\n  t\n}\n")
        + rehome_control_untouched(name: "homonym", prepared: prepared, lex: lex,
          text: "module c.user\n\nimport c.other { Token }\n\nfn f(t: Token) -> Token {\n  t\n}\n")
        + rehome_control_refuses(name: "kind-differs", prepared: prepared, lex: lex, pair: RehomePairRefused { reason: RehomeKindDiffers }, closures: rehome_control_closures(), want: "rehome-kind-differs")
        + rehome_control_refuses(name: "signature-differs", prepared: prepared, lex: lex, pair: RehomePairRefused { reason: RehomeSignatureDiffers }, closures: rehome_control_closures(), want: "rehome-signature-differs")
        + rehome_control_refuses(name: "closes-cycle", prepared: prepared, lex: lex, pair: RehomePairSame, closures: [RosterClosureRead { home: "c.new", modules: ["c.new", "c.user"] }], want: "import-closes-cycle home=c.new module=c.user")
        + rehome_control_representation(prepared: prepared, lex: lex)
        + rehome_control_record()
        + rehome_control_pair_inhabited(prepared: prepared, lex: lex)
        + rehome_control_contracts(prepared: prepared, lex: lex)
    }
  }
}

// A rehome writes exactly `after`, its planner record maps every rewritten extent to bytes of `after` equal to the splice's
// replacement, and the fixed point (the same row over `after`) is Clean.
fn rehome_control_moves(name: String, prepared: PreparedGrammar, lex: PreparedLexRules, before: String, after: String) -> String {
  match rehome_text(path: "control/user.dag", text: before, prepared: prepared, lex: lex, row: rehome_control_row(), pair: RehomePairSame, closures: rehome_control_closures(), census: rehome_control_census(), supplied: rehome_control_supplied()) {
    RehomeSplices { splices: ss } =>
      match rehome_applied(before: before, splices: ss) {
        RehomeApplyRefused { reason: r } => "CONTROL-FAIL rehome " + name + ": apply refused " + rehome_refusal_text(r: r) + "\n"
        RehomeWritten { content: c, rewrites: rws } =>
          if c != after { "CONTROL-FAIL rehome " + name + ": wrote the wrong text\n" }
          else if !rehome_record_lands(after: after, splices: ss, rewrites: rws) { "CONTROL-FAIL rehome " + name + ": the planner record does not map onto the head text\n" }
          else {
            match rehome_text(path: "control/user.dag", text: after, prepared: prepared, lex: lex, row: rehome_control_row(), pair: RehomePairSame, closures: rehome_control_closures(), census: rehome_control_census(), supplied: rehome_control_supplied()) {
              RehomeClean => ""
              _ => "CONTROL-FAIL rehome " + name + ": pass 2 is not Clean\n"
            }
          }
      }
    RehomeClean => "CONTROL-FAIL rehome " + name + ": nothing moved\n"
    RehomeRefused { reason: r } => "CONTROL-FAIL rehome " + name + ": refused " + rehome_refusal_text(r: r) + "\n"
  }
}

fn rehome_record_lands(after: String, splices: List<RehomeSplice>, rewrites: List<RehomeRewrite>) -> Bool {
  let octets = bytes_octets(b: utf8_encode_bytes(s: after))
  if length(xs: splices) != length(xs: rewrites) { false } else {
    fold_list(xs: rewrites, empty: RehomeZip { index: 0, ok: true }, cons: fn(acc, w) {
      match list_at_optional(xs: splices, index: acc.index) {
        Present { value: s } =>
          RehomeZip { index: acc.index + 1, ok: acc.ok && substring(s: after, start: roster_scalar_boundary(octets: octets, byte: w.head_start), end: roster_scalar_boundary(octets: octets, byte: w.head_end)) == s.replacement }
        Absent => RehomeZip { index: acc.index + 1, ok: false }
      }
    }).ok
  }
}

type RehomeZip {
  index: Int
  ok: Bool
}

fn rehome_control_untouched(name: String, prepared: PreparedGrammar, lex: PreparedLexRules, text: String) -> String {
  match rehome_text(path: "control/user.dag", text: text, prepared: prepared, lex: lex, row: rehome_control_row(), pair: RehomePairSame, closures: rehome_control_closures(), census: rehome_control_census(), supplied: rehome_control_supplied()) {
    RehomeClean => ""
    _ => "CONTROL-FAIL rehome " + name + ": a declaration that is not the old one was touched\n"
  }
}

fn rehome_control_refuses(name: String, prepared: PreparedGrammar, lex: PreparedLexRules, pair: RehomePairVerdict, closures: List<RosterHomeClosure>, want: String) -> String {
  match rehome_text(path: "control/user.dag", text: "module c.user\n\nimport c.old { Token }\n\nfn f(t: Token) -> Token {\n  t\n}\n", prepared: prepared, lex: lex, row: rehome_control_row(), pair: pair, closures: closures, census: rehome_control_census(), supplied: rehome_control_supplied()) {
    RehomeRefused { reason: r } => if rehome_refusal_text(r: r) == want { "" } else { "CONTROL-FAIL rehome " + name + ": refused " + rehome_refusal_text(r: r) + ", wanted " + want + "\n" }
    _ => "CONTROL-FAIL rehome " + name + ": not refused\n"
  }
}

// A DECLARED REPRESENTATION CHANGE moves a module with no representation site, and refuses one that has any, naming each
// constructor reference and field read.
fn rehome_control_representation(prepared: PreparedGrammar, lex: PreparedLexRules) -> String {
  let row = RehomeRow { name: "Token", from_home: "c.old", to_home: "c.new", representation: Present { value: RehomeRepresentation { constructor: "c.rep.Pair", fields: ["left"] } } }
  rehome_rep_case(name: "dirty", prepared: prepared, lex: lex, row: row, module: "c.dirty", heads: 1, fields: 1)
    + rehome_rep_case(name: "through-the-alias", prepared: prepared, lex: lex, row: row, module: "c.via", heads: 1, fields: 0)
    + rehome_rep_case(name: "through-a-second-alias", prepared: prepared, lex: lex, row: row, module: "c.local", heads: 1, fields: 0)
    + rehome_rep_case(name: "head-unobserved", prepared: prepared, lex: lex, row: row, module: "c.unobserved", heads: 0 - 1, fields: 0)
    + match rehome_text(path: "control/clean.dag", text: rehome_control_text(module: "c.clean"), prepared: prepared, lex: lex, row: row, pair: RehomePairSame, closures: rehome_control_closures(), census: rehome_control_census(), supplied: rehome_control_supplied()) {
      RehomeSplices { splices: _ } => ""
      RehomeRefused { reason: r } => "CONTROL-FAIL rehome representation clean: refused " + rehome_refusal_text(r: r) + "\n"
      RehomeClean => "CONTROL-FAIL rehome representation clean: nothing moved\n"
    }
    + rehome_facts_kind_control()
}

// `heads` representation heads and `fields` field reads must be named; heads == -1 wants representation-unobserved.
fn rehome_rep_case(name: String, prepared: PreparedGrammar, lex: PreparedLexRules, row: RehomeRow, module: String, heads: Int, fields: Int) -> String {
  match rehome_text(path: "control/" + module + ".dag", text: rehome_control_text(module: module), prepared: prepared, lex: lex, row: row, pair: RehomePairSame, closures: rehome_control_closures(), census: rehome_control_census(), supplied: rehome_control_supplied()) {
    RehomeRefused { reason: r } => {
      let t = rehome_refusal_text(r: r)
      if heads < 0 {
        if rehome_count_of(text: t, what: "representation-unobserved") >= 1 { "" } else { "CONTROL-FAIL rehome representation " + name + ": refused " + t + ", wanted representation-unobserved\n" }
      } else if rehome_count_of(text: t, what: "representation-head@") == heads && rehome_count_of(text: t, what: "field-read-untyped:left@") == fields { "" }
      else { "CONTROL-FAIL rehome representation " + name + ": refused " + t + "\n" }
    }
    _ => "CONTROL-FAIL rehome representation " + name + ": not refused\n"
  }
}

fn rehome_control_text(module: String) -> String {
  if module == "c.clean" { "module c.clean\n\nimport c.old { Token }\n\nfn f(t: Token) -> Token {\n  t\n}\n" }
  else if module == "c.dirty" { "module c.dirty\n\nimport c.old { Token }\nimport c.rep { Pair }\n\nfn f(t: Token) -> Int {\n  t.left + p(x: Pair { left: 1, right: 2 })\n}\n" }
  else if module == "c.via" { "module c.via\n\nimport c.old { Token }\n\nfn f() -> Token {\n  Token { left: 1, right: 2 }\n}\n" }
  else if module == "c.local" { "module c.local\n\nimport c.old { Token }\n\ntype LocalToken = Token\n\nfn f() -> LocalToken {\n  LocalToken { left: 1, right: 2 }\n}\n" }
  else { "module c.unobserved\n\nimport c.old { Token }\n\nfn f(t: Token) -> Token {\n  t\n}\n" }
}

// THE SUPPLIED CENSUS ROWS, in the producer's own line format (occurrence_binding_census_line), parsed by the same reader
// production uses (rehome_census_rows). c.unobserved has rows but none at its head, so its head is unobserved.
fn rehome_control_census() -> List<RehomeCensusRow> {
  rehome_census_rows(text: roster_join_lines(lines: [
    "binding\tc.clean\tt\t0\tparameter\tparameter\t6:3",
    "binding\tc.dirty\tt\t0\tparameter\tparameter\t7:3",
    "binding\tc.dirty\tp\t0\tambient\tstd.p\t7:12",
    "binding\tc.dirty\tPair\t0\timport\tc.rep.Pair\t7:17",
    "binding\tc.via\tToken\t0\timport\tc.old.Token\t6:3",
    "binding\tc.local\tToken\t0\timport\tc.old.Token\t5:19",
    "binding\tc.local\tLocalToken\t0\tdeclared\tc.local.LocalToken\t8:3",
    "binding\tc.unobserved\tToken\t0\timport\tc.old.Token\t5:9",
    "binding\tc.a\tPayload\t0\timport\tc.x.Payload\t6:10",
    "binding\tc.b\tPayload\t0\timport\tc.y.Payload\t6:10",
    "binding\tc.same_a\tPayload\t0\timport\tc.x.Payload\t6:10",
    "binding\tc.same_b\tPayload\t0\timport\tc.x.Payload\t6:10",
    "binding\tc.fn_a\tx\t0\tparameter\tparameter\t4:27",
    "binding\tc.fn_b\tx\t0\tparameter\tparameter\t4:29",
    "binding_unanswered\tc.missing_a\tMissing\t0\t6:10",
    "binding_unanswered\tc.missing_b\tMissing\t0\t6:10",
    "binding\tc.frame_a\tPayload\t0\tparameter\tparameter\t6:3",
    "binding\tc.frame_b\tPayload\t0\tparameter\tparameter\t6:3"
  ]))
}

fn roster_join_lines(lines: List<String>) -> String {
  fold_list(xs: lines, empty: "", cons: fn(acc, l) { acc + l + "\n" })
}

fn rehome_control_supplied() -> List<RehomeSuppliedModule> {
  [RehomeSuppliedModule { module: "c.local", path: "control/c.local.dag", text: rehome_control_text(module: "c.local") }]
}

// A declared representation still refuses a real kind difference (reviews 83176, 83179): fn against type and an OtherItem
// against fn both refuse; only the alias gap's own pair (OtherItem against TypeItem) is admitted.
fn rehome_facts_kind_control() -> String {
  rehome_kind_case(name: "fn-to-type", from: FnItem, to: TypeItem, admitted: false)
    + rehome_kind_case(name: "other-to-fn", from: OtherItem, to: FnItem, admitted: false)
    + rehome_kind_case(name: "other-to-type", from: OtherItem, to: TypeItem, admitted: true)
}

fn rehome_kind_case(name: String, from: ItemKind, to: ItemKind, admitted: Bool) -> String {
  let verdict = rehome_kind_verdict(from: DeclFact { qualified_name: "c.old.Token", name: "Token", kind: from, node: rehome_control_node(), rel_path: "c/old.dag" }, to: DeclFact { qualified_name: "c.new.Token", name: "Token", kind: to, node: rehome_control_node(), rel_path: "c/new.dag" })
  match verdict {
    RehomePairSame => if admitted { "" } else { "CONTROL-FAIL rehome kind " + name + ": a declared representation admitted a kind change\n" }
    RehomePairRefused { reason: RehomeKindDiffers } => if admitted { "CONTROL-FAIL rehome kind " + name + ": the alias gap's pair was refused\n" } else { "" }
    RehomePairRefused { reason: r } => "CONTROL-FAIL rehome kind " + name + ": refused " + rehome_refusal_text(r: r) + "\n"
  }
}

fn rehome_control_node() -> Node {
  Node { kind: TypeNode { connective: Conj }, children: [], occurrence_id: OccurrenceSynthetic }
}

fn rehome_count_of(text: String, what: String) -> Int {
  length(xs: split(s: text, delimiter: what)) - 1
}

// THE CONTRACT COMPARATOR ON REAL PARSES (side chat on #14553): the same pair spelled alike but bound differently refuses,
// a different fn signature refuses, and an identical declaration with identical bindings is the same.
fn rehome_control_contracts(prepared: PreparedGrammar, lex: PreparedLexRules) -> String {
  let payload = "import c.x { Payload }\n\ntype Token {\n  value: Payload\n}\n"
  rehome_contract_case(name: "field-bound-differently", prepared: prepared, lex: lex, a_home: "c.a", a: "module c.a\n\nimport c.x { Payload }\n\ntype Token {\n  value: Payload\n}\n", b_home: "c.b", b: "module c.b\n\nimport c.y { Payload }\n\ntype Token {\n  value: Payload\n}\n", want: "differs")
    + rehome_contract_case(name: "same-contract", prepared: prepared, lex: lex, a_home: "c.same_a", a: "module c.same_a\n\n" + payload, b_home: "c.same_b", b: "module c.same_b\n\n" + payload, want: "same")
    + rehome_contract_case(name: "fn-signature-differs", prepared: prepared, lex: lex, a_home: "c.fn_a", a: "module c.fn_a\n\n\nfn Token(x: Int) -> Int { x }\n", b_home: "c.fn_b", b: "module c.fn_b\n\n\nfn Token(x: Bool) -> Bool { x }\n", want: "differs")
    + rehome_contract_case(name: "undeclared-reference", prepared: prepared, lex: lex, a_home: "c.missing_a", a: "module c.missing_a\n\nimport c.x { Other }\n\ntype Token {\n  value: Missing\n}\n", b_home: "c.missing_b", b: "module c.missing_b\n\nimport c.x { Other }\n\ntype Token {\n  value: Missing\n}\n", want: "unestablished")
    + rehome_contract_case(name: "module-unobserved", prepared: prepared, lex: lex, a_home: "c.ambiguous_a", a: "module c.ambiguous_a\n\n" + payload, b_home: "c.same_b", b: "module c.same_b\n\n" + payload, want: "unestablished")
    + rehome_contract_case(name: "frame-bound-homonym", prepared: prepared, lex: lex, a_home: "c.frame_a", a: "module c.frame_a\n\nimport c.x { Payload }\n\nfn Token(Payload: Int) -> Int {\n  Payload\n}\n", b_home: "c.same_b", b: "module c.same_b\n\n" + payload, want: "differs")
}

fn rehome_contract_case(name: String, prepared: PreparedGrammar, lex: PreparedLexRules, a_home: String, a: String, b_home: String, b: String, want: String) -> String {
  let got = match rehome_contracts_verdict(a: rehome_contract_from_text(home: a_home, name: "Token", path: "control/a.dag", text: a, prepared: prepared, lex: lex, census: rehome_control_census()), b: rehome_contract_from_text(home: b_home, name: "Token", path: "control/b.dag", text: b, prepared: prepared, lex: lex, census: rehome_control_census())) {
    RehomePairSame => "same"
    RehomePairRefused { reason: RehomeSignatureDiffers } => "differs"
    RehomePairRefused { reason: RehomeContractUnestablishedRefusal { cause: _ } } => "unestablished"
    RehomePairRefused { reason: r } => rehome_refusal_text(r: r)
  }
  if got == want { "" } else { "CONTROL-FAIL rehome contract " + name + ": got " + got + ", wanted " + want + "\n" }
}

// A splice whose base bytes are not what it expects refuses; the record's head extents follow earlier splices' deltas.
fn rehome_control_record() -> String {
  let before = "ab c.old.T cd c.old.T"
  let splices = [
    RehomeSplice { start: 3, end: 10, expect: "c.old.T", replacement: "c.newer.T", kind: QualifiedUseRewrite, spelling_base_offset: Present { value: 0 }, spelling_head_offset: Present { value: 0 } },
    RehomeSplice { start: 14, end: 21, expect: "c.old.T", replacement: "c.newer.T", kind: QualifiedUseRewrite, spelling_base_offset: Present { value: 0 }, spelling_head_offset: Present { value: 0 } }
  ]
  let moved = match rehome_applied(before: before, splices: splices) {
    RehomeWritten { content: c, rewrites: rws } =>
      if c == "ab c.newer.T cd c.newer.T" && rehome_record_lands(after: c, splices: splices, rewrites: rws) { "" } else { "CONTROL-FAIL rehome record: the second extent did not move by the first splice's delta\n" }
    RehomeApplyRefused { reason: _ } => "CONTROL-FAIL rehome record: a valid splice list refused\n"
  }
  let stale = match rehome_applied(before: before, splices: [RehomeSplice { start: 0, end: 2, expect: "zz", replacement: "q", kind: ImportBlockRewrite, spelling_base_offset: Absent, spelling_head_offset: Absent }]) {
    RehomeApplyRefused { reason: _ } => ""
    RehomeWritten { content: _, rewrites: _ } => "CONTROL-FAIL rehome record: a splice over unexpected bytes was written\n"
  }
  moved + stale
}

// THE INHABITANCE CLAIM for the supplied pair verdicts: v2.std.decl_index, on the real corpus, resolves the N7 Int pair to
// two declarations of one kind whose shapes differ (GroupCompletion record vs NonNegative | Negative), so the real path
// refuses it as a signature change -- tidy-ant-251's ruling A.
// WHILE THE ALIAS GAP IS OPEN the pair refuses on its KIND instead: decl_index reads the alias v2.std.integer.Int
// (= GroupCompletion<Nat>) as OtherItem against std.integer.Int's TypeItem. Both arms are "not a rename". TRIGGER: when
// adhoc-0f4309c5-074 lands (aliased type declarations read TypeItem), delete the RehomeKindDiffers arm below, so the
// control pins the signature arm alone.
fn rehome_control_pair_inhabited(prepared: PreparedGrammar, lex: PreparedLexRules) -> String {
  match rehome_pair_verdict(row: RehomeRow { name: "Int", from_home: "v2.std.integer", to_home: "std.integer", representation: Absent }, prepared: prepared, lex: lex, census: []) {
    RehomePairRefused { reason: RehomeSignatureDiffers } => ""
    RehomePairRefused { reason: RehomeKindDiffers } => ""
    RehomePairRefused { reason: r } => "CONTROL-FAIL rehome pair-inhabited: the real Int pair refused " + rehome_refusal_text(r: r) + "\n"
    RehomePairSame => "CONTROL-FAIL rehome pair-inhabited: the real Int pair read as the same shape\n"
  }
}
