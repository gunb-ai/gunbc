module v2.workflow.claim_coverage_census_s1_live

// THE LIVE COMPOSITION OF THE DISCOVERED UNIVERSE (Charter 4 exit census, sunny-ibex-149).
//
// ONE instrument, ONE label. `//gunbc/instruments:claim-coverage-census` is that instrument
// (warm-wolf-570's one-instrument ruling), so this module adds NO label, NO registry arm and NO second
// entry: the existing live entry `gunbc.claim_coverage_census_live claim_coverage_census_exit` composes
// the fold below and prints its standings beside the wet schedule's receipt.
//
// ONE universe: S1, every discovered test fn, at IDENTITY grain -- produced by THE WALK, THE ONE WALK.
// The population is enumerated by `v2.workflow.floor_discovery_producer floor_discovery_walk_dir`, the
// producer's own walk, and finalized by `floor_discovery_finalize_source_outcomes`: the same code the
// required floor and the emitted native compiler's universe derivation run. An earlier revision of this
// module carried its own copy of the walk rule (list a directory, treat `.dag` as a module file, ask the
// host whether a failed listing was a file); that copy had already drifted from the original it claimed
// to follow -- it bounded the depth, passed the wrong `is_root`, and applied no exclusion policy -- and a
// forked walk is exactly how "the same discovery that produced S1" quietly stops being true (DESIGN §3:
// a second name for one concept; §6b: the trigger is the second local implementation of one rule). It is
// deleted, not corrected. There is one walk, and this module calls it.
//
// WHAT THE WALK IS SUPPLIED, AND WHY THE ONE DIFFERENCE IS NOT A FORK. The walk takes a marker fact per
// file and an exclusion policy; both are separate facts by the producer's own comment ("WHAT IS A TEST IS
// NOT DECIDED HERE ... it never infers a test, a directory or a witness from a name"). This census passes
// NO exclusion policy (`exclude_substrings: []`), deliberately: the quarantine / long-lane / frontier
// patterns are the discovery-corpus mode's row ADMISSION, and in this census admission is a COVER-side
// classifier over the universe. Applying it universe-side would let the very carrier that is supposed to
// EXCUSE a claim hide it from the population first -- a frontier entry would shrink S1 instead of covering
// a member of it. That is a divergence with a stated reason (DESIGN §3b: the only red is divergence with
// no reason), and it is the same choice the required floor makes for the same reason.
//
// TEST IDENTIFICATION IS THE MARKER CHANNEL, not a text scan and not a name convention. Each governed
// file's marked declaration names are read beside lowering by `v2.compiler.module_acquisition
// acquisition_test_markers` (the idiom `gunbc.instruments.layout_witness_join` uses). A file whose markers
// cannot be read is given NO fact, so the walk itself reports the missing fact as a located disposition
// refusal through the authority's own channel -- never an empty marker list, which would enrol the file as
// holding no tests, and never a quietly skipped file, which would shrink the universe.
//
// THE IDENTITY IS READ, NEVER BUILT BY STRING SURGERY. The module name comes from the source ingress
// inventory (`floor_discovery_source_inventory_live`, the same ingress the required floor's discovery
// reads, keyed by its own path spelling), and the identity is that module joined to the discovery's own
// function name -- the spelling every classifier carrier (the wet schedule, floor_expected_red, the
// fill-debt list, the drop populations) uses. Nothing here splits a path into a module. The inventory is
// also a cross-check on the walk rather than a second guess at it: a file the walk enrolled that the
// ingress cannot name is a refused input, so the two authorities must agree for the census to print at all.
//
// THE EXECUTED-BY RELATION IS DERIVED, NEVER AUTHORED. The required job's instrument labels are the
// emitted workflow's own rows (`gunbc.emitted_subject_build_gate`); each label is bound through
// `gunbc.instrument_targets`; and only a binding whose producer NAMES claim identities contributes an
// executed claim -- which, at this head, is the CliWire form alone. Every other producer form, the bin
// programs included, exposes no claim set, so the claims it would have run stay Uncovered and print: a
// missing claim set is reported as the universe being uncovered, exactly as ruled, and never repaired by
// inventing enrollment. A label that binds to nothing, or to more than one producer, is a located finding
// beside the receipt: a missing binding must never read as coverage, and never as a silent zero.

import std.types { String, List, Map, NonEmptyStr }
import std.algebra { Cons, Empty, empty_map, map_insert, map_lookup, is_empty, trim, fold_list }
import std.optional { Optional, Absent, Present, optional_absent, optional_present }
import extdeps.bazel.label { render_label }
import extdeps.exec.command { LocalExec }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.git { git_rev_parse_head_command }
import extdeps.github.actions_environment { github_sha_variable_name }
import extdeps.shell.exec { ProcessOutputPresent, ProcessOutputAbsent, ProcessRefused }
import gunbc.actions_run_binding { actions_variable_trimmed }
import gunbc.ci.ci_layer_roots { witness_layer_roots }
import gunbc.command_runner { run_shell_command_capture }
import gunbc.target_binding { TargetBinding, TargetProducer }
import gunbc.instrument_targets { instrument_bindings }
import gunbc.emitted_subject_build_gate { emitted_subject_build_rows, emitted_subject_build_label_text }
import v2.cli.repository_layout { repository_module_file_of_path, repository_storage_layout, repository_tree_directory }
import v2.compiler.module_acquisition {
  AcquisitionEnv, AcquisitionEnvReady, AcquisitionEnvUnprepared, AcquisitionMarkersRead,
  AcquisitionMarkersRefused, SourceRootBinding, acquisition_env, acquisition_test_markers
}
import v2.std.cross_tree.import_model { DagTree, V2Tree }
import v2.workflow.floor_discovery_row { FloorDiscoveryRow, FloorMarkedSource }
import v2.workflow.floor_discovery_producer {
  FloorDiscoverySource, FloorDiscoverySourcesObserved, FloorDiscoverySourcesRefused,
  floor_discovery_source_inventory_live, floor_discovery_walk_dir
}
import v2.workflow.floor_discovery_source_authority {
  FloorDiscoveryAccepted, FloorDiscoveryRefused, FloorDiscoveryWalkState,
  floor_discovery_finalize_source_outcomes, floor_discovery_walk_state_zero
}
import v2.workflow.claim_coverage_census_s1 {
  ClaimRow, S1Census, S1Block, S1Composition, S1Composed, S1InputsUnread,
  RequiredJobLabelDefect, LabelUnbound, LabelAmbiguous,
  classify_rows, derive_executed, s1_block, s1_stale_rows, s1_ungrounded_rows, s1_uncovered
}
import v2.workflow.claim_coverage_census_s1_carriers { s1_all_classifier_rows }

// The marker channel's accumulator, built by PREPENDING (see `marked_over_files`): `marked` holds the
// facts it could supply and `unread` the files it could not read with their causes. Both are reported in
// the order the ingress listed them, which the readers get by reversing once.
type MarkedFold {
  marked: List<FloorMarkedSource>
  unread: List<String>
}

// What naming the discovered rows produced: the claims it could name, and the rows it could not. A
// discovered file with no declared module cannot be given an identity, and inventing one from the
// directory is exactly the string surgery this census exists to refuse.
type NamedClaim {
  claims: List<ClaimRow>
  unnamed: List<String>
}

// The checkout the census is run against, spelled the way every other relative path in this fold is
// spelled: relative to the process working directory, which is what the walk's own root paths and the
// ingress inventory's own reads assume. The head is resolved from the same directory the census read its
// facts from, so the printed head is the head of the tree the census enumerated -- not a head looked up
// somewhere else and pasted onto the receipt.
data census_checkout_dir: String = "."

// The one binding of the two governed trees: the pair `gunbc.instruments.layout_witness_join` binds, so
// the marker channel reads files where the repository keeps them.
fn governed_bindings() -> List<SourceRootBinding> {
  [
    SourceRootBinding { tree: V2Tree, host_directory: repository_tree_directory(tree: V2Tree) },
    SourceRootBinding { tree: DagTree, host_directory: repository_tree_directory(tree: DagTree) }
  ]
}

// `(repo path -> content)`: the ingress's own read, reused so the marker channel does not re-read what
// the ingress already held. The key is the ingress's path spelling, which is the same key the module
// index below uses, so a fact and a name can never be paired across two spellings.
fn content_index(sources: List<FloorDiscoverySource>) -> Map<String, String> {
  fold(
    sources,
    init: empty_map(),
    f: fn(index, source) { map_insert(m: index, key: source.repo_path, value: source.content) }
  )
}

// `(repo path -> declared module)`, the identity's only module authority. An empty declared module means
// the ingress could not read a module declaration for that file, and the caller refuses such a file
// rather than inventing a module from the path.
fn module_index(sources: List<FloorDiscoverySource>) -> Map<String, String> {
  fold(
    sources,
    init: empty_map(),
    f: fn(index, source) { map_insert(m: index, key: source.repo_path, value: source.module_path) }
  )
}

// The content of one governed file: the ingress's read where it covers the file, the readonly checkout
// otherwise. Absent is an unreadable file, which the caller reports rather than skipping.
fn file_content(contents: Map<String, String>, path: String) -> Optional<String> {
  match map_lookup(m: contents, key: path) {
    Present { value: content } => optional_present(value: content)
    Absent =>
      match Filesystem.Read(path: path) {
        read => if read.success {
          optional_present(value: read.content)
        } else {
          optional_absent()
        }
      }
  }
}

// THE MARKER CHANNEL over the files the ingress enumerated. The marked names come from the acquisition
// channel, which parses beside lowering -- never from a text scan for the word `test`, and never from a
// name convention. A file with no marked declaration is a file holding no tests, said by the parser; a
// file the channel could not read gets NO fact, and the walk reports that as a located refusal naming the
// file, because handing it an empty list would enrol it as test-free.
//
// ACCUMULATED BY PREPENDING, REVERSED ONCE (review 82822, DESIGN §6): `concat(acc, [x])` inside a fold
// copies the whole accumulator at every step, so reading N files cost O(N^2) in list copying for no
// benefit. Prepending a SINGLETON -- `concat([x], acc)` -- charges the appended side only, per
// `std.algebra`'s own note on `list_append`, so it is the constant-time shape; the order the readers
// expect is restored by a single reverse. This is the corpus's own resolving shape at
// `v2.workflow.floor_pure_producer_share` (`reverse(fold(rows, init: [], f: fn(acc, row) { concat([row.producer], acc) }))`).
//
// THE ARMS MUST AGREE ON ONE CARRIER, AND THAT IS NOT A DETAIL (blocker from bold-badger-676, measured on
// BuildBuddy). This fold's accumulator was `init: []` (a List) while its mutating arms returned
// `Cons { head: _, tail: acc }` -- the FreeMonoid constructor -- so the branches resolved to
// `Container(List,Primitive())` vs `Coproduct(FreeMonoid)` and the WHOLE MODULE refused to resolve. No
// witness ever saw it, because no claim imported this module: the parse sweep resolves imports only, not
// bodies. The wrong side was the `Cons` arms -- the accumulator is a List, the fold is the corpus's own
// prepend shape -- so the arms were changed, not the accumulator coerced. The same defect sat in
// `name_rows`; both are fixed, and the claim `a_live_function_resolves_and_names_nothing_for_a_producer_that_names_nothing`
// in the witness now imports THIS module, so the class of defect cannot go invisible again.
fn marked_over_files(
  env: AcquisitionEnv,
  contents: Map<String, String>,
  paths: List<String>
) -> MarkedFold {
  let folded = fold(
    paths,
    init: MarkedFold { marked: [], unread: [] },
    f: fn(acc, path) {
      match repository_module_file_of_path(path: path) {
        Absent => MarkedFold {
          marked: acc.marked,
          unread: concat([concat(path, ": under no bound source tree")], acc.unread)
        }
        Present { value: file } =>
          match file_content(contents: contents, path: path) {
            Absent => MarkedFold {
              marked: acc.marked,
              unread: concat([concat(path, ": unreadable")], acc.unread)
            }
            Present { value: content } =>
              match acquisition_test_markers(env: env, file: file, content: content) {
                AcquisitionMarkersRead { declarations: declarations } => MarkedFold {
                  marked: concat(
                    [FloorMarkedSource {
                       repo_path: path,
                       marked: map(declarations, declaration => declaration.name)
                     }],
                    acc.marked
                  ),
                  unread: acc.unread
                }
                AcquisitionMarkersRefused { cause: cause } => MarkedFold {
                  marked: acc.marked,
                  unread: concat([concat(path, ": ", cause)], acc.unread)
                }
              }
          }
      }
    }
  )
  MarkedFold { marked: folded.marked |> reverse(), unread: folded.unread |> reverse() }
}

// THE WALK AND THE FOLD, in the authority's own hands. Each governed root is walked by
// `floor_discovery_walk_dir` -- the producer's walk, with the producer's rule for what a directory is and
// what a module file is -- under no exclusion policy, for the reason stated at the top of this module. The
// ROOTS ARE SUPPLIED, not hardcoded here: the census passes the governed roots and the witness's pairing
// claim passes a subset of the same roots. A walk that picked its own roots while being handed another
// file set would walk one thing and classify another, which is the drift §3b forbids. The
// facts it is handed decide which declarations are tests; the walk decides nothing about a name. Any
// located walk failure or missing-fact refusal the state carries comes back through
// `floor_discovery_finalize_source_outcomes` as a refusal naming the file, so a failed listing is never
// read as an empty directory and the universe cannot shrink silently.
fn discovery_walk(roots: List<String>, marked: List<FloorMarkedSource>) -> FloorDiscoveryWalkState {
  fold_list(
    xs: roots,
    empty: floor_discovery_walk_state_zero(),
    cons: fn(state, root) {
      floor_discovery_walk_dir(
        state: state,
        dir_path: root,
        marked_sources: marked,
        exclude_substrings: []
      )
    }
  )
}

// The identity is the ingress's declared module joined to the discovered function name -- the same
// spelling the wet schedule uses, so a classifier row and a discovered row meet at one grain. A row whose
// file the index does not locate, or whose declared module is empty, is carried as `unnamed`: refused,
// never renamed. Prepended and reversed once, for the reason in `marked_over_files`.
fn name_rows(rows: List<FloorDiscoveryRow>, index: Map<String, String>) -> NamedClaim {
  let named = fold(
    rows,
    init: NamedClaim { claims: [], unnamed: [] },
    f: fn(acc, row) {
      match map_lookup(m: index, key: row.entry) {
        Present { value: module } =>
          if module == "" {
            NamedClaim {
              claims: acc.claims,
              unnamed: concat([concat("no declared module for discovered file: ", row.entry)], acc.unnamed)
            }
          } else {
            NamedClaim {
              claims: concat(
                [ClaimRow {
                   identity: concat(module, concat(".", row.function)),
                   entry: row.entry,
                   function: row.function
                 }],
                acc.claims
              ),
              unnamed: acc.unnamed
            }
          }
        Absent => NamedClaim {
          claims: acc.claims,
          unnamed: concat([concat("no declared module for discovered file: ", row.entry)], acc.unnamed)
        }
      }
    }
  )
  NamedClaim { claims: named.claims |> reverse(), unnamed: named.unnamed |> reverse() }
}

// What a bound producer NAMES. Only the CliWire form carries a (file, function) pair at all; the bin
// programs, the whole-program builds and every census/plan producer name no claim identity, so they
// execute no claim of S1 and their claims stay Uncovered -- the finding, printed rather than repaired.
// The match is exhaustive by construction: a producer form added upstream fails this module to compile,
// which is what keeps "names nothing" a decision and not a default.
fn producer_named_identities(producer: TargetProducer, index: Map<String, String>) -> List<String> {
  match producer {
    CliWireProgramProducer { entry: entry, function: function } =>
      match map_lookup(m: index, key: entry) {
        Present { value: module } => [concat(module, concat(".", function))]
        Absent => []
      }
    NativeClaimProgramProducer { entry: _, deadline: _ } => []
    NativeServeProgramProducer { entry: _, probe: _ } => []
    V2NativeCensusProducer { reading: _ } => []
    SelfHostProducer {} => []
    RequiredFloorProducer {} => []
    BazelProducer {} => []
    BehavioralReceiptPlanProducer {} => []
    BehavioralReceiptCensusProducer {} => []
    BehavioralReceiptSelftestProducer {} => []
    HeadsReadingDifferentialProducer {} => []
    CompileCleanDiagnosticCensusProducer {} => []
    V2NativeCliProducer {} => []
    V2NativeFrontierProducer {} => []
    EmittedCrateWorkspaceProducer {} => []
    EvaluationStoreAddressExactHeadProducer {} => []
    PrimitiveEgressCensusProducer {} => []
    PrimitiveEgressCensusV2Producer {} => []
    PrimitiveEgressCensusDagProducer {} => []
    PrimitiveEgressCensusSeedProducer {} => []
    TypedGraphExclusiveBytesProducer {} => []
    TypedGraphExclusiveBytesFloorSubjectProducer {} => []
    RequiredLaneResolutionCensusProducer {} => []
    BareReferenceChannelOutcomeProducer {} => []
    SelfHostBehavioralEquivalenceProducer {} => []
    GenericIdentityCensusProducer {} => []
    InterpolationHoleCensusProducer {} => []
    SharedTypeLeafCollisionCensusProducer {} => []
    CardinalityRealizationProducer {} => []
    RegenRoundCostProducer {} => []
  }
}

// The bindings of one instrument label, read from the roster. The label is the emitted row's own rendered
// text, never a string the census wrote.
fn labelled_bindings(label: String) -> List<TargetBinding> {
  filter(instrument_bindings(), b => render_label(l: b.target) == label)
}

// THE LABEL DEFECTS, AS TYPED CASES (see `RequiredJobLabelDefect` in the pure policy). The producer's
// labels are enumerated once here and the binding count decides the case: zero producers is `LabelUnbound`,
// more than one is `LabelAmbiguous`, exactly one contributes no defect. Prepended and reversed once, for
// the reason in `marked_over_files`.
fn required_job_label_defects() -> List<RequiredJobLabelDefect> {
  let findings = fold(
    emitted_subject_build_rows(),
    init: [],
    f: fn(acc, row) {
      let label = emitted_subject_build_label_text(row: row)
      let bound = count(labelled_bindings(label: label))
      if bound == 1 {
        acc
      } else if bound == 0 {
        concat([LabelUnbound { label: label }], acc)
      } else {
        concat([LabelAmbiguous { label: label }], acc)
      }
    }
  )
  findings |> reverse()
}

// THE CREDIT RULE, IN ONE PLACE: what a label's bindings contribute to the executed-by set. Exactly one
// binding credits the identities its producer names; zero or many credit NOTHING. This is the whole of the
// parent's ruling on review of #14469, and it is a function of the binding list alone so it can be shown
// wrong against authored bindings (see `a_label_with_two_bindings_credits_nothing_but_a_unique_one_does`)
// rather than only observed through the fold. `executed_of` and `required_job_label_defects` both read the
// same binding list, which is what makes the printed defect and the withheld credit two views of one fact
// instead of two policies that can drift.
fn credited_producer_names(bindings: List<TargetBinding>, index: Map<String, String>) -> List<String> {
  match bindings {
    Cons { head: binding, tail: Empty {} } =>
      producer_named_identities(producer: binding.producer, index: index)
    Empty {} => []
    Cons { head: _, tail: _ } => []
  }
}

// THE EXECUTED-BY SET: the claim identities the required job's bound producers name, kept only where
// discovery enrolled them -- the authority's `derive_executed` drops anything outside the universe, so a
// binding can never manufacture an executed claim for a file that holds no test.
//
// CREDITED ONLY THROUGH A UNIQUE BINDING, by `credited_producer_names` above. A label that binds to no
// producer, or to two, has no single answer to "what does this job run", and summing the candidates anyway
// reported their UNION as executed -- a doubled binding silently laundered an unrelated producer's claims
// into the executed-by set. The defect is named in standing by `required_job_label_defects`.
fn executed_of(rows: List<ClaimRow>, index: Map<String, String>) -> List<String> {
  derive_executed(
    rows: rows,
    produced: fold(
      emitted_subject_build_rows(),
      init: [],
      f: fn(names, row) {
        let label = emitted_subject_build_label_text(row: row)
        concat(names, credited_producer_names(bindings: labelled_bindings(label: label), index: index))
      }
    )
  )
}

// THE FOLD, IN TWO PARTS, AND WHY THAT IS NOT A FORK (DESIGN §3b: the only red is divergence with no
// reason). `s1_over_sources` is the WHOLE composition -- marker channel, the producer's walk, the
// authority's finalize, naming, classifiers, executed-by -- over sources it is handed. `s1_compose` is the
// census: it supplies the governed roots. `s1_compose_scoped` supplies a SUBSET of those same roots and
// runs the identical body. There is one enumeration, one identity join and one classification; the two
// entries differ only in the roots they ask the ingress to inventory, which is a supplied fact rather than
// a second rule. A scoped entry exists because a witness claim must be able to assert a fact about one
// real file's identity without paying for the whole corpus -- the pairing obligation (DESIGN 3) binds the
// witness to the REAL discovery, and a claim that cannot run cannot discharge it.
fn s1_over_sources(roots: List<String>, sources: List<FloorDiscoverySource>) -> S1Composition {
  match acquisition_env(layout: repository_storage_layout(), bindings: governed_bindings()) {
        AcquisitionEnvUnprepared { diagnostics: _ } =>
          S1InputsUnread { causes: ["the dag grammar did not prepare: the marker channel cannot answer"] }
        AcquisitionEnvReady { env: env } => {
          let index = module_index(sources: sources)
          let marked = marked_over_files(
            env: env,
            contents: content_index(sources: sources),
            paths: map(sources, source => source.repo_path)
          )
          if !is_empty(xs: marked.unread) {
            S1InputsUnread { causes: map(marked.unread, cause => concat("markers unread: ", cause)) }
          } else {
            match floor_discovery_finalize_source_outcomes(
              outcomes: [discovery_walk(roots: roots, marked: marked.marked)]
            ) {
              FloorDiscoveryRefused { reason: reason } =>
                S1InputsUnread { causes: [concat("discovery refused: ", reason)] }
              FloorDiscoveryAccepted { rows: rows } => {
                let named = name_rows(rows: rows, index: index)
                if !is_empty(xs: named.unnamed) {
                  S1InputsUnread { causes: named.unnamed }
                } else {
                  let universe = map(named.claims, claim => claim.identity)
                  S1Composed {
                    census: S1Census {
                      universe: universe,
                      rows: named.claims,
                      executed: executed_of(rows: named.claims, index: index),
                      stands: classify_rows(
                        universe: universe,
                        rows: named.claims,
                        classifier_rows: s1_all_classifier_rows()
                      )
                    },
                    label_defects: required_job_label_defects()
                  }
                }
              }
            }
          }
        }
      }
}

// THE CENSUS: the governed roots, the whole fold.
fn s1_compose() -> S1Composition {
  match floor_discovery_source_inventory_live(pool_roots: witness_layer_roots) {
    FloorDiscoverySourcesRefused { reason: reason } =>
      S1InputsUnread { causes: [concat("source inventory refused: ", reason)] }
    FloorDiscoverySourcesObserved { sources: sources } =>
      s1_over_sources(roots: witness_layer_roots, sources: sources)
  }
}

// THE SCOPED FOLD: the same fold over the named roots of the governed trees. Used by the witness's
// real-producer pairing claims, and by nothing that decides an exit.
fn s1_compose_scoped(roots: List<String>) -> S1Composition {
  match floor_discovery_source_inventory_live(pool_roots: roots) {
    FloorDiscoverySourcesRefused { reason: reason } =>
      S1InputsUnread { causes: [concat("source inventory refused: ", reason)] }
    FloorDiscoverySourcesObserved { sources: sources } =>
      s1_over_sources(roots: roots, sources: sources)
  }
}

// THE HEAD THE EVIDENCE IS AT, read rather than passed in. The primary authority is the checkout's own
// revision, asked of git through the sealed argv builder for that one operation
// (`extdeps.git git_rev_parse_head_command`, the builder the revision-job witness asks); where the run is
// an Actions run, the runner's pinned `GITHUB_SHA` is the fallback, since that revision IS the subject the
// run was dispatched for.
//
// ABSENCE IS TYPED, NOT SPELL-CHECKED (review 82943, DESIGN §5: every degradation typed, located and
// countable; §3b's absence domain is `std.optional::Optional`). The first version collapsed both refusals
// to the empty string and then tested `!= ""`, and when neither authority answered it RETURNED THE STRING
// "UNREADABLE (...)" -- a placeholder printed where a revision belongs, which is the fabricated default §5
// rejects, and which contradicted the comment on the line that prints it. Now: `RevisionRead { revision }`
// carries a revision that was actually read, and `RevisionAbsent { cause }` carries WHY the locator could
// not be read, including the exit code and stderr the process reported. Nothing downstream has to guess
// whether an empty string meant absent, and a reader can tell a refused git from an unset variable.
type HeadReading
  = RevisionRead { revision: String }
  | RevisionAbsent { cause: String }

// A captured answer counts as no answer when it is empty AFTER trimming: that is the shape the transport
// itself reports (an executed-but-silent command), and the corpus's own convention for "the transport gave
// me nothing" is `if text == ""` at its parse sites (`extdeps.github.push_event`, `extdeps.docker.cli`).
// It is a check on the OBSERVATION, made in one place, and it is not how absence is represented -- that is
// the sum above.
fn head_from_git() -> HeadReading {
  match run_shell_command_capture(
    command: git_rev_parse_head_command(repository_dir: census_checkout_dir),
    transport: LocalExec
  ) {
    ProcessOutputPresent { text: text } => {
      let revision = trim(s: text)
      if revision != "" {
        RevisionRead { revision: revision }
      } else {
        RevisionAbsent { cause: "git rev-parse --short HEAD printed nothing" }
      }
    }
    ProcessRefused { exit_code: exit_code, stderr: stderr } => RevisionAbsent {
      cause: concat("git rev-parse --short HEAD refused (exit ", concat(to_string(exit_code), concat("): ", stderr)))
    }
    ProcessOutputAbsent => RevisionAbsent { cause: "git rev-parse --short HEAD could not be spawned" }
  }
}

fn census_head_reading() -> HeadReading {
  match head_from_git() {
    RevisionRead { revision: revision } => RevisionRead { revision: revision }
    RevisionAbsent { cause: git_cause } => {
      let runner_sha = actions_variable_trimmed(name: github_sha_variable_name as NonEmptyStr)
      if runner_sha != "" {
        RevisionRead { revision: runner_sha }
      } else {
        RevisionAbsent { cause: concat(git_cause, "; and GITHUB_SHA is unset") }
      }
    }
  }
}

// THE RUNNER STAMPS THE LOCATOR, OR OMITS IT WITH ITS CAUSE. The census takes no head, so the stamp is the
// runner's business: the live entry calls this, and a runner that cannot ask (the host-native route has no
// git) prints a typed cause in place of the revision rather than a placeholder dressed as one. Either way
// the receipt says what it knows: the verdicts never depended on the locator, and they are printed either
// way.
fn s1_head_receipt_line() -> String {
  match census_head_reading() {
    RevisionRead { revision: revision } => concat("S1-CENSUS head:", revision)
    RevisionAbsent { cause: cause } => concat("S1-CENSUS head UNREADABLE: ", cause)
  }
}

// THE LIVE ENTRY'S BLOCK: the one pure exit policy (`v2.workflow.claim_coverage_census_s1 s1_block`) applied to
// what this checkout actually says. Composed here so the fold's unread channel and the standings both pass
// through the single policy function -- the live entry never decides an exit itself, and a witness never has
// to read this module to assert one. It takes NO head: the census is a pure function of the tree, and the
// revision is stamped beside its output by whoever ran it (see `s1_head_receipt_line`).
