module v2.workflow.ci_goal_receipt

import v2.std.algebra { fold_list, length, list_snoc_item }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.workflow.ci_attempt { CiNodeReceipt, NodeFailed, NodePassed, NodeRefused }
import v2.std.text { String }

// THE ORIGINAL GOALS, AS A CARRIER RATHER THAN A PR DESCRIPTION.
//
// A goal written in a pull-request body is checked by whoever remembers to re-read
// it, which is how a branch arrives at acceptance having quietly dropped one. The
// selection regression is the worked example: the ordinary roster went back to
// SelectionApplied without any commit deciding that, and prose could not have caught
// it because prose is not evaluated.
//
// WHAT THIS MODULE REFUSES TO DO IS THE POINT. There is no arm that lets a goal be
// reported as held because someone believes it. A goal is Held only when it carries
// an evidence reference; a goal nobody has wired evidence for is Unevaluated with a
// named trigger, which is a different state from NotHeld and must not be folded into
// it. Reporting "13 of 16 goals hold" while three were never measured is the rung
// inflation DESIGN §4b names, applied to a status table.

type CiGoal
  = EveryMainCommitGetsAVerdict
  | EveryOrdinaryWitnessRunsUnconditionally
  | NoAutomaticExclusionDerivation
  | PreparationFailuresAreLoud
  | WitnessIdentityIsQualified
  | OneExactPreparedSubject
  | CompileCleanSharesThePreparation
  | ZeroPerEntryGraphResolves
  | ExactSubjectCoversTheEnvelope
  | LedgerExplainsTheAttempt
  | DagOwnsFloorPolicy
  | OldEntryMajorPathHasNoConsumers
  | SelectionMachineryAbsent
  | FalsifierPredictionMachineryAbsent
  | WorkIsGenuinelyConcurrent
  | NoDuplicateRecomputeWithoutShare
  | RegenDriftHealShareOneGeneration

// EVIDENCE IS SEALED, BECAUSE NAMING A SYMBOL IS NOT PRODUCING A PROOF.
//
// The first revision of this module accepted GoalHeld { evidence: ExecutedWitness {
// declaration: sym } } for ANY symbol, and its own test proved the hole by admitting a
// row built from the arbitrary name ^some_witness. Nothing resolved the declaration,
// executed it, scanned the population, or evaluated the plan predicate — the carrier
// read a tag someone had already authored, which is the same shape as the resolve
// count that printed a literal zero. A status table that cannot be contradicted is not
// a receipt.
//
// GoalEvidence is sole_constructor, so the only way to obtain one is through the
// admitting functions below, and each of those requires the artifact that constitutes
// the proof rather than a name for it. This does not yet EXECUTE anything from inside
// .dag — the witness receipt still arrives from the host — but it removes the arm
// where a goal is held because a symbol was typed.
type GoalEvidence sole_constructor {
  form: EvidenceForm
  subject: Symbol
}

type EvidenceForm
  = ExecutedWitnessForm
  | StructuralAbsenceForm
  | DerivedFromPlanForm

// A passing receipt is the artifact; the declaration name travels WITH it rather than
// standing in for it. A failing or refused receipt yields no evidence, so a red witness
// cannot hold its own goal.
fn evidence_from_witness_receipt(receipt: CiNodeReceipt) -> GoalEvidenceAdmission {
  match receipt.outcome {
    NodePassed =>
      EvidenceAdmitted {
        evidence: GoalEvidence {
          form: ExecutedWitnessForm,
          subject: receipt.node_identity
        }
      }
    NodeFailed => EvidenceRefusedWitnessNotGreen { declaration: receipt.node_identity }
    NodeRefused { cause: _ } =>
      EvidenceRefusedWitnessNotGreen { declaration: receipt.node_identity }
  }
}

// Absence is established by a COMPLETE scan reporting zero occurrences, not by a
// grep someone ran once. An incomplete scan refuses: "we looked at part of the corpus
// and found nothing" is not absence, and this is the same distinction the corpus-wide
// censuses lost when they answered from whatever population they happened to hold.
fn evidence_from_absence_scan(
  subject: Symbol,
  scanned: Int,
  population: Int,
  occurrences: Int
) -> GoalEvidenceAdmission {
  if scanned != population {
    EvidenceRefusedScanIncomplete { subject: subject, scanned: scanned, population: population }
  } else {
    if occurrences > 0 {
      EvidenceRefusedSubjectPresent { subject: subject, occurrences: occurrences }
    } else {
      EvidenceAdmitted {
        evidence: GoalEvidence { form: StructuralAbsenceForm, subject: subject }
      }
    }
  }
}

fn evidence_from_plan_predicate(declaration: Symbol, holds: Bool) -> GoalEvidenceAdmission {
  if holds {
    EvidenceAdmitted {
      evidence: GoalEvidence { form: DerivedFromPlanForm, subject: declaration }
    }
  } else {
    EvidenceRefusedPredicateFalse { declaration: declaration }
  }
}

type GoalEvidenceAdmission
  = EvidenceAdmitted { evidence: GoalEvidence }
  | EvidenceRefusedWitnessNotGreen { declaration: Symbol }
  | EvidenceRefusedScanIncomplete { subject: Symbol, scanned: Int, population: Int }
  | EvidenceRefusedSubjectPresent { subject: Symbol, occurrences: Int }
  | EvidenceRefusedPredicateFalse { declaration: Symbol }

// Unevaluated carries its TRIGGER, so "we have not measured this" is separable from
// "we cannot measure this". DESIGN §4b calls the first a tracked stall and the second
// a ceiling, and collapsing them is what lets a permanent gap masquerade as pending
// work.
type GoalStanding
  = GoalHeld { evidence: GoalEvidence }
  | GoalNotHeld { detail: String }
  | GoalUnevaluated { trigger: String }

type GoalRow {
  goal: CiGoal
  standing: GoalStanding
}

fn goal_is_held(row: GoalRow) -> Bool {
  match row.standing {
    GoalHeld { evidence: _ } => true
    GoalNotHeld { detail: _ } => false
    GoalUnevaluated { trigger: _ } => false
  }
}

fn goal_is_unevaluated(row: GoalRow) -> Bool {
  match row.standing {
    GoalUnevaluated { trigger: _ } => true
    GoalHeld { evidence: _ } => false
    GoalNotHeld { detail: _ } => false
  }
}

// THE RECEIPT IS THREE COUNTS, NEVER ONE RATIO. A single "goals met" number has to
// decide where the unevaluated rows go, and both answers are wrong: counting them as
// met is a lie, counting them as unmet makes a measured regression indistinguishable
// from an unwired probe, so the reader loses the ability to act on either.
type GoalReceipt {
  held: Int
  not_held: Int
  unevaluated: Int
}

fn goal_receipt(rows: List<GoalRow>) -> GoalReceipt {
  GoalReceipt {
    held: fold_list(
      xs: rows,
      empty: 0,
      cons: fn(acc, r) { if goal_is_held(row: r) { acc + 1 } else { acc } }
    ),
    not_held: fold_list(
      xs: rows,
      empty: 0,
      cons: fn(acc, r) {
        match r.standing {
          GoalNotHeld { detail: _ } => acc + 1
          GoalHeld { evidence: _ } => acc
          GoalUnevaluated { trigger: _ } => acc
        }
      }
    ),
    unevaluated: fold_list(
      xs: rows,
      empty: 0,
      cons: fn(acc, r) { if goal_is_unevaluated(row: r) { acc + 1 } else { acc } }
    )
  }
}

// ADMISSION REQUIRES EVERY GOAL HELD — unevaluated is not a pass. This is the arm
// that makes the receipt a gate rather than a dashboard: a branch cannot reach
// AcceptanceAdmitted by leaving a goal unwired, which is precisely the move that
// would otherwise be cheapest.
type AcceptanceStanding
  = AcceptanceAdmitted
  | AcceptanceRefusedNotHeld { goal: CiGoal }
  | AcceptanceRefusedUnevaluated { goal: CiGoal }

fn admit_acceptance(acc: AcceptanceStanding, row: GoalRow) -> AcceptanceStanding {
  match acc {
    AcceptanceRefusedNotHeld { goal: g } => AcceptanceRefusedNotHeld { goal: g }
    AcceptanceRefusedUnevaluated { goal: g } => AcceptanceRefusedUnevaluated { goal: g }
    AcceptanceAdmitted =>
      match row.standing {
        GoalHeld { evidence: _ } => AcceptanceAdmitted
        GoalNotHeld { detail: _ } => AcceptanceRefusedNotHeld { goal: row.goal }
        GoalUnevaluated { trigger: _ } => AcceptanceRefusedUnevaluated { goal: row.goal }
      }
  }
}

fn acceptance_standing(rows: List<GoalRow>) -> AcceptanceStanding {
  fold_list(xs: rows, empty: AcceptanceAdmitted, cons: admit_acceptance)
}

// ── The roster, and why it carries NO standings ───────────────────────────────
//
// This is a list of GOALS, not a list of verdicts. The previous revision authored a
// standing per goal, which meant the branch's acceptance state was whatever the branch
// said it was — and the review that caught it was right that no amount of typing makes
// an authored tag into a receipt.
//
// A standing is now DERIVED from evidence that arrives, so the honest state of a
// branch with no evidence wired is every goal Unevaluated and acceptance refused. That
// is the correct answer today and it is not flattering, which is the point: the carrier
// cannot be talked into agreeing.
data ci_goal_subjects: List<CiGoal> = [
  EveryMainCommitGetsAVerdict,
  EveryOrdinaryWitnessRunsUnconditionally,
  NoAutomaticExclusionDerivation,
  PreparationFailuresAreLoud,
  WitnessIdentityIsQualified,
  OneExactPreparedSubject,
  CompileCleanSharesThePreparation,
  ZeroPerEntryGraphResolves,
  ExactSubjectCoversTheEnvelope,
  LedgerExplainsTheAttempt,
  DagOwnsFloorPolicy,
  OldEntryMajorPathHasNoConsumers,
  SelectionMachineryAbsent,
  FalsifierPredictionMachineryAbsent,
  WorkIsGenuinelyConcurrent,
  NoDuplicateRecomputeWithoutShare,
  RegenDriftHealShareOneGeneration
]

type GoalEvidenceBinding {
  goal: CiGoal
  admission: GoalEvidenceAdmission
}

data no_goal_evidence: List<GoalEvidenceBinding> = []

fn goal_eq(a: CiGoal, b: CiGoal) -> Bool {
  goal_symbol(goal: a) == goal_symbol(goal: b)
}

fn goal_symbol(goal: CiGoal) -> Symbol {
  match goal {
    EveryMainCommitGetsAVerdict => ^goal_every_main_commit_gets_a_verdict
    EveryOrdinaryWitnessRunsUnconditionally => ^goal_every_ordinary_witness_runs
    NoAutomaticExclusionDerivation => ^goal_no_automatic_exclusion_derivation
    PreparationFailuresAreLoud => ^goal_preparation_failures_are_loud
    WitnessIdentityIsQualified => ^goal_witness_identity_is_qualified
    OneExactPreparedSubject => ^goal_one_exact_prepared_subject
    CompileCleanSharesThePreparation => ^goal_compile_clean_shares_preparation
    ZeroPerEntryGraphResolves => ^goal_zero_per_entry_graph_resolves
    ExactSubjectCoversTheEnvelope => ^goal_exact_subject_covers_envelope
    LedgerExplainsTheAttempt => ^goal_ledger_explains_the_attempt
    DagOwnsFloorPolicy => ^goal_dag_owns_floor_policy
    OldEntryMajorPathHasNoConsumers => ^goal_old_path_has_no_consumers
    SelectionMachineryAbsent => ^goal_selection_machinery_absent
    FalsifierPredictionMachineryAbsent => ^goal_falsifier_machinery_absent
    WorkIsGenuinelyConcurrent => ^goal_work_is_genuinely_concurrent
    NoDuplicateRecomputeWithoutShare => ^goal_no_duplicate_recompute
    RegenDriftHealShareOneGeneration => ^goal_regen_drift_heal_one_generation
  }
}

// AN ABSENT BINDING IS Unevaluated, NEVER Held. The default has to be the state that
// blocks, because the alternative rewards forgetting to wire evidence.
fn standing_for(goal: CiGoal, bindings: List<GoalEvidenceBinding>) -> GoalStanding {
  fold_list(
    xs: bindings,
    empty: GoalUnevaluated { trigger: "no evidence bound for this goal" },
    cons: fn(acc, b) {
      if goal_eq(a: b.goal, b: goal) {
        match b.admission {
          EvidenceAdmitted { evidence: e } => GoalHeld { evidence: e }
          EvidenceRefusedWitnessNotGreen { declaration: _ } =>
            GoalNotHeld { detail: "witness did not pass" }
          EvidenceRefusedScanIncomplete { subject: _, scanned: _, population: _ } =>
            GoalNotHeld { detail: "absence scan did not cover the population" }
          EvidenceRefusedSubjectPresent { subject: _, occurrences: _ } =>
            GoalNotHeld { detail: "subject is still present" }
          EvidenceRefusedPredicateFalse { declaration: _ } =>
            GoalNotHeld { detail: "plan predicate does not hold" }
        }
      } else {
        acc
      }
    }
  )
}

fn derived_goal_rows(bindings: List<GoalEvidenceBinding>) -> List<GoalRow> {
  fold_list(
    xs: ci_goal_subjects,
    empty: no_goal_rows,
    cons: fn(acc, g) {
      list_snoc_item(
        xs: acc,
        item: GoalRow { goal: g, standing: standing_for(goal: g, bindings: bindings) }
      )
    }
  )
}

data no_goal_rows: List<GoalRow> = []

// THE BRANCH'S STATE, DERIVED. No evidence is bound on this branch, so every goal is
// Unevaluated and acceptance refuses. When the host starts returning receipts, rows
// become Held one binding at a time — and a goal can never be held by editing this
// file.
fn ci_goal_rows() -> List<GoalRow> {
  derived_goal_rows(bindings: no_goal_evidence)
}
