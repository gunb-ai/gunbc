module v2.workflow.executor


type ExecutorJob {
  node: v2.std.node.Node
}

type ExecutorBatch {
  jobs: List<ExecutorJob>
}

type ExecutorBlockedEvidence
  = ExecutorSchedulerBlocked { evidence: v2.workflow.scheduler.SchedulerBlockedEvidence }
  | ExecutorEmptyFrontier {}

type ExecutorRunPlan
  = ExecutorRunComplete {
      batches: List<ExecutorBatch>,
      scheduled: List<v2.std.node.Node>
    }
  | ExecutorRunRunnable {
      batch: ExecutorBatch,
      scheduled: List<v2.std.node.Node>,
      remaining: List<v2.std.node.Node>
    }
  | ExecutorRunBlocked {
      evidence: ExecutorBlockedEvidence,
      batches: List<ExecutorBatch>,
      scheduled: List<v2.std.node.Node>,
      remaining: List<v2.std.node.Node>
    }

fn executor_job_for_node(node: v2.std.node.Node) -> ExecutorJob {
  ExecutorJob { node: node }
}

fn executor_jobs_for_frontier(frontier: v2.workflow.scheduler.RunnableFrontier<v2.std.node.Node>) -> List<ExecutorJob> {
  fold(frontier.ready, init: [], f: fn(jobs, node) {
    v2.std.algebra.list_snoc_item(xs: jobs, item: executor_job_for_node(node: node))
  })
}

fn executor_batch_for_frontier(frontier: v2.workflow.scheduler.RunnableFrontier<v2.std.node.Node>) -> ExecutorBatch {
  ExecutorBatch {
    jobs: executor_jobs_for_frontier(frontier: frontier)
  }
}

fn executor_job_nodes(jobs: List<ExecutorJob>) -> List<v2.std.node.Node> {
  fold(jobs, init: [], f: fn(nodes, job) {
    v2.std.algebra.list_snoc_item(xs: nodes, item: job.node)
  })
}

fn executor_append_batch(batches: List<ExecutorBatch>, batch: ExecutorBatch) -> List<ExecutorBatch> {
  if v2.std.algebra.non_empty(xs: batch.jobs) {
    v2.std.algebra.list_snoc_item(xs: batches, item: batch)
  } else {
    batches
  }
}

fn parallel_executor_plan_from_dependencies(
  nodes: List<v2.std.node.Node>,
  dependencies: List<v2.std.dependency.DependencyView>,
  scheduled: List<v2.std.node.Node>
) -> ExecutorRunPlan {
  executor_plan_from_scheduler_plan(
    scheduler_plan: v2.workflow.scheduler.scheduler_plan_from_dependencies(
      nodes: nodes,
      dependencies: dependencies,
      scheduled: scheduled
    )
  )
}

fn parallel_executor_step_plan_from_dependencies(
  nodes: List<v2.std.node.Node>,
  dependencies: List<v2.std.dependency.DependencyView>,
  scheduled: List<v2.std.node.Node>
) -> ExecutorRunPlan {
  executor_plan_from_scheduler_plan(
    scheduler_plan: v2.workflow.scheduler.scheduler_step_plan_from_dependencies(
      nodes: nodes,
      dependencies: dependencies,
      scheduled: scheduled
    )
  )
}

fn executor_plan_from_scheduler_plan(scheduler_plan: v2.workflow.scheduler.SchedulerPlan<v2.std.node.Node>) -> ExecutorRunPlan {
  match scheduler_plan {
    v2.workflow.scheduler.SchedulerPlanComplete { layers: layers, scheduled: scheduled_nodes } => ExecutorRunComplete {
      batches: executor_batches_for_layers(layers: layers),
      scheduled: scheduled_nodes
    }
    v2.workflow.scheduler.SchedulerPlanRunnable { frontier: frontier, scheduled: scheduled_nodes, remaining: remaining, layers: _ } => ExecutorRunRunnable {
      batch: executor_batch_for_frontier(frontier: frontier),
      scheduled: scheduled_nodes,
      remaining: remaining
    }
    v2.workflow.scheduler.SchedulerPlanBlocked { evidence: evidence, scheduled: scheduled_nodes, remaining: remaining, layers: layers } => ExecutorRunBlocked {
      evidence: ExecutorSchedulerBlocked { evidence: evidence },
      batches: executor_batches_for_layers(layers: layers),
      scheduled: scheduled_nodes,
      remaining: remaining
    }
  }
}
fn parallel_executor_plan_from_layers(layers: List<v2.std.dependency.ReadinessLayer<v2.std.node.Node>>) -> ExecutorRunPlan {
  let batches = executor_batches_for_layers(layers: layers)
  ExecutorRunComplete {
    batches: batches,
    scheduled: executor_nodes_from_batches(batches: batches)
  }
}

fn executor_batch_contains_node(batch: ExecutorBatch, node: v2.std.node.Node) -> Bool {
  v2.std.algebra.contains(xs: executor_job_nodes(jobs: batch.jobs), item: node, eq: fn(left, right) { left == right })
}

fn executor_batches_preserve_frontiers(batches: List<ExecutorBatch>, layers: List<v2.std.dependency.ReadinessLayer<v2.std.node.Node>>) -> Bool {
  fold(layers, init: true, f: fn(ok, layer) {
    ok && v2.std.algebra.contains(
      xs: batches,
      item: executor_batch_for_frontier(frontier: v2.workflow.scheduler.RunnableFrontier { ready: layer.ready }),
      eq: fn(left, right) { left == right }
    )
  })
}

fn executor_batches_for_layers(layers: List<v2.std.dependency.ReadinessLayer<v2.std.node.Node>>) -> List<ExecutorBatch> {
  fold(layers, init: [], f: fn(acc, layer) {
    executor_append_batch(
      batches: acc,
      batch: executor_batch_for_frontier(frontier: v2.workflow.scheduler.RunnableFrontier { ready: layer.ready })
    )
  })
}

fn executor_nodes_from_batches(batches: List<ExecutorBatch>) -> List<v2.std.node.Node> {
  fold(batches, init: [], f: fn(nodes, batch) {
    fold(batch.jobs, init: nodes, f: fn(acc, job) {
      v2.std.algebra.list_snoc_item(xs: acc, item: job.node)
    })
  })
}
