module v2.workflow.authored_occurrence_census

import extdeps.filesystem.filesystem_io
import v2.compiler.compile { NativeCensusModule, native_census_modules, native_test_context_from_ingest, native_test_resolve_module }
import v2.compiler.inferred_tree { AuthoredOccurrenceCollision, authored_occurrence_collisions, authored_occurrence_id }
import v2.workflow.compile_door_ledger { closure_ingest }
import v2.lens.module_graph { import_closure_live }
import v2.std.qualified_name { qualified_name_from_dotted_string }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.optional { Absent, Present }
import v2.std.algebra { fold_list, length }
import std.algebra { Cons, Empty, list_snoc_item }
import v2.std.node { Node }

// THE PREMISE THE FACT-SUBJECT KEY RESTS ON, MEASURED. v2.compiler.inferred_tree keys infer's facts on
// a node's authored occurrence, which is sound only if no tree infer receives holds two different
// nodes under one authored occurrence. This walks the import closure of an entry, resolves every
// module exactly as the native route does (native_test_resolve_module -- the tree infer is handed),
// and reports each module's collisions through the same authored_occurrence_collisions the admission
// will refuse with. Refused resolutions are counted, never read as zero collisions.

type OccurrenceCensusRow
  = OccurrenceCensusResolved { module: String, nodes_colliding: Int, first_site: String }
  | OccurrenceCensusUnresolved { module: String, reason: String }

fn occurrence_census_site(c: AuthoredOccurrenceCollision) -> String {
  match authored_occurrence_id(n: c.first) {
    Present { value: id } => concat("occurrence=", to_string(id.value))
    Absent => "occurrence=synthetic"
  }
}

fn authored_occurrence_census_rows(entry_path: String, pool_roots: List<String>) -> List<OccurrenceCensusRow> {
  let ingest = closure_ingest(closure_paths: import_closure_live(entry_path: entry_path, pool_roots: pool_roots))
  match native_test_context_from_ingest(ingest: ingest) {
    Rejected { diagnostics: d } => [OccurrenceCensusUnresolved { module: entry_path, reason: concat("context: ", to_string(d.head.reason)) }]
    Accepted { value: context, diagnostics: _ } =>
      fold_list(xs: native_census_modules(ingest: ingest), empty: [], cons: fn(acc, m) {
        list_snoc_item(xs: acc, item:
          match native_test_resolve_module(context: context, module: qualified_name_from_dotted_string(dotted: m.module)) {
            Rejected { diagnostics: d } => OccurrenceCensusUnresolved { module: m.module, reason: to_string(d.head.reason) }
            Accepted { value: tree, diagnostics: _ } => {
              let cs = authored_occurrence_collisions(root: tree)
              OccurrenceCensusResolved {
                module: m.module,
                nodes_colliding: length(xs: cs),
                first_site: match cs { Cons { head: c, tail: _ } => occurrence_census_site(c: c) Empty => "" }
              }
            }
          })
      })
  }
}

fn occurrence_census_row_line(r: OccurrenceCensusRow) -> String {
  match r {
    OccurrenceCensusResolved { module: m, nodes_colliding: n, first_site: s } =>
      concat("resolved ", concat(m, concat(" collisions=", concat(to_string(n), concat(" ", s)))))
    OccurrenceCensusUnresolved { module: m, reason: why } => concat("UNRESOLVED ", concat(m, concat(" ", why)))
  }
}

fn authored_occurrence_census_report(entry_path: String) -> String {
  fold_list(
    xs: authored_occurrence_census_rows(entry_path: entry_path, pool_roots: ["dag", "src/v2"]),
    empty: "",
    cons: fn(acc, r) { concat(acc, concat(occurrence_census_row_line(r: r), "\n")) }
  )
}

fn authored_occurrence_census_self_host() -> String {
  authored_occurrence_census_report(entry_path: "src/v2/compiler/00_compile.dag")
}

fn authored_occurrence_census_native_cli() -> String {
  authored_occurrence_census_report(entry_path: "src/v2/cli/compile_cli.dag")
}

fn authored_occurrence_census_dag_instruments() -> String {
  authored_occurrence_census_report(entry_path: "dag/gunbc/instrument_targets.dag")
}
