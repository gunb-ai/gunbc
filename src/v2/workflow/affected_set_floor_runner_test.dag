module v2.test.workflow.affected_set_floor_runner

import v2.std.algebra { count_equal, length }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.node { Atom, Conj, Edge, Node, Positional, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.text { String }
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor,
  test_claim_evaluation_nodes,
  test_claim_evaluation_touches_rerun_frontier
}
import v2.std.integer { Int }
import v2.workflow.affected_set_floor_runner {
  DiffObservationFailClosed,
  DiffPathsProduced,
  FloorDiffLineTouch,
  FloorDiffObservation,
  FloorRerunFrontier,
  FloorWitnessRow,
  FrontierFailClosed,
  FrontierProduced,
  RunWitness,
  SkipAssumedGreen,
  floor_any_claim_touches_rerun_frontier,
  floor_claim_touches_rerun_frontier,
  floor_host_scaffold_would_skip,
  floor_host_scaffold_precompute_would_skip,
  floor_kernel_would_skip,
  floor_kernel_precompute_would_skip,
  floor_precompute_would_skip,
  floor_rust_run_implies_dag_run,
  floor_skip_git_diff_policy,
  floor_test_fn_declaration_edited,
  floor_witness_eval_nodes_from_claims,
  floor_witness_nodes_touch_frontier,
  floor_witness_run_disposition
}
import gunbc.ci_spec { DiffMergeBase }

data floor_test_untouched_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^floor_test_untouched_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data floor_test_touched_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^floor_test_touched_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data floor_test_other_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^floor_test_other_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data floor_test_conj_wrapped_touched_node: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Positional,
      target: floor_test_touched_node
    }
  ],
  occurrence_id: SyntheticOccurrence
}

data floor_test_claim_untouched: TestClaim = EqualsClaim {
  label: "floor_runner: untouched claim",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: floor_test_untouched_node,
  rhs: floor_test_untouched_node,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data floor_test_claim_touched: TestClaim = EqualsClaim {
  label: "floor_runner: touched claim",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: floor_test_touched_node,
  rhs: floor_test_touched_node,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data floor_test_claim_conj_wrapped: TestClaim = EqualsClaim {
  label: "floor_runner: conj-wrapped touched claim",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: floor_test_conj_wrapped_touched_node,
  rhs: floor_test_conj_wrapped_touched_node,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data floor_test_row_untouched: FloorWitnessRow = FloorWitnessRow {
  label: "floor_runner: untouched witness",
  entry: "src/v2/workflow/affected_set_floor_runner_test.dag",
  function: "floor_test_untouched_witness_holds"
}

data floor_test_row_touched: FloorWitnessRow = FloorWitnessRow {
  label: "floor_runner: touched witness",
  entry: "src/v2/workflow/affected_set_floor_runner_test.dag",
  function: "floor_test_touched_witness_holds"
}

data floor_test_diff_nonempty: FloorDiffObservation = DiffPathsProduced {
  changed_paths: ["src/v2/lens/affected_set.dag"]
}

data floor_test_diff_empty: FloorDiffObservation = DiffPathsProduced {
  changed_paths: []
}

data floor_test_diff_fail_closed: FloorDiffObservation = DiffObservationFailClosed {
  reason: "git diff unavailable"
}

data floor_test_frontier_touched: FloorRerunFrontier = FrontierProduced {
  nodes: [floor_test_touched_node]
}

data floor_test_frontier_fail_closed: FloorRerunFrontier = FrontierFailClosed {
  reason: "provenance unavailable"
}

test fn floor_test_untouched_skips_assumed_green_holds() -> Bool {
  match floor_witness_run_disposition(
    diff: floor_test_diff_nonempty,
    frontier: floor_test_frontier_touched,
    touches_frontier: false,
    function_edited: false,
    entry_file_touched: false
  ) {
    SkipAssumedGreen => true
    RunWitness { reason: _ } => false
  }
}

test fn floor_test_touched_runs_holds() -> Bool {
  match floor_witness_run_disposition(
    diff: floor_test_diff_nonempty,
    frontier: floor_test_frontier_touched,
    touches_frontier: true,
    function_edited: false,
    entry_file_touched: false
  ) {
    RunWitness { reason: _ } => true
    SkipAssumedGreen => false
  }
}

test fn floor_test_function_edited_runs_holds() -> Bool {
  match floor_witness_run_disposition(
    diff: floor_test_diff_nonempty,
    frontier: floor_test_frontier_touched,
    touches_frontier: false,
    function_edited: true,
    entry_file_touched: false
  ) {
    RunWitness { reason: reason } =>
      reason == "witness test fn declaration directly edited"
    SkipAssumedGreen => false
  }
}

test fn floor_test_entry_file_touched_runs_holds() -> Bool {
  match floor_witness_run_disposition(
    diff: floor_test_diff_nonempty,
    frontier: floor_test_frontier_touched,
    touches_frontier: false,
    function_edited: false,
    entry_file_touched: true
  ) {
    RunWitness { reason: reason } =>
      reason == "witness entry import-closure has non-data fn edit in diff"
    SkipAssumedGreen => false
  }
}

test fn floor_test_empty_diff_runs_all_holds() -> Bool {
  match floor_witness_run_disposition(
    diff: floor_test_diff_empty,
    frontier: floor_test_frontier_touched,
    touches_frontier: false,
    function_edited: false,
    entry_file_touched: false
  ) {
    RunWitness { reason: reason } => reason == "empty diff — run full corpus (fail-closed)"
    SkipAssumedGreen => false
  }
}

test fn floor_test_diff_fail_closed_runs_holds() -> Bool {
  match floor_witness_run_disposition(
    diff: floor_test_diff_fail_closed,
    frontier: floor_test_frontier_touched,
    touches_frontier: false,
    function_edited: false,
    entry_file_touched: false
  ) {
    RunWitness { reason: reason } => reason == "git diff unavailable"
    SkipAssumedGreen => false
  }
}

test fn floor_test_frontier_fail_closed_runs_holds() -> Bool {
  match floor_witness_run_disposition(
    diff: floor_test_diff_nonempty,
    frontier: floor_test_frontier_fail_closed,
    touches_frontier: false,
    function_edited: false,
    entry_file_touched: false
  ) {
    RunWitness { reason: reason } => reason == "provenance unavailable"
    SkipAssumedGreen => false
  }
}

test fn floor_test_claim_touch_discriminates_holds() -> Bool {
  floor_claim_touches_rerun_frontier(
    claim: floor_test_claim_touched,
    frontier: [floor_test_touched_node]
  )
    && !floor_claim_touches_rerun_frontier(
      claim: floor_test_claim_untouched,
      frontier: [floor_test_touched_node]
    )
}

test fn floor_test_inner_frontier_discriminates_holds() -> Bool {
  floor_claim_touches_rerun_frontier(
    claim: floor_test_claim_conj_wrapped,
    frontier: [floor_test_touched_node]
  )
    && !floor_claim_touches_rerun_frontier(
      claim: floor_test_claim_untouched,
      frontier: [floor_test_touched_node]
    )
}

test fn floor_test_host_kernel_skip_equivalent_holds() -> Bool {
  floor_kernel_would_skip(
    changed_paths: ["src/v2/lens/affected_set.dag"],
    frontier_nodes: [floor_test_touched_node],
    touches_frontier: false,
    function_edited: false,
    entry_file_touched: false
  )
    && floor_host_scaffold_would_skip(
      changed_paths: ["src/v2/lens/affected_set.dag"],
      frontier_nodes: [floor_test_touched_node],
      touches_frontier: false,
      function_edited: false,
      entry_file_touched: false
    )
}

test fn floor_test_host_kernel_run_equivalent_holds() -> Bool {
  !floor_kernel_would_skip(
    changed_paths: ["src/v2/lens/affected_set.dag"],
    frontier_nodes: [floor_test_touched_node],
    touches_frontier: true,
    function_edited: false,
    entry_file_touched: false
  )
    && !floor_host_scaffold_would_skip(
      changed_paths: ["src/v2/lens/affected_set.dag"],
      frontier_nodes: [floor_test_touched_node],
      touches_frontier: true,
      function_edited: false,
      entry_file_touched: false
    )
}

test fn floor_test_precompute_skip_holds() -> Bool {
  floor_precompute_would_skip(
    diff: floor_test_diff_nonempty,
    frontier: FrontierProduced { nodes: [] },
    edited_test_fn_count: 0,
    touched_entry_file_count: 0
  )
    && !floor_precompute_would_skip(
      diff: floor_test_diff_nonempty,
      frontier: floor_test_frontier_touched,
      edited_test_fn_count: 0,
      touched_entry_file_count: 0
    )
    && !floor_precompute_would_skip(
      diff: floor_test_diff_nonempty,
      frontier: FrontierProduced { nodes: [] },
      edited_test_fn_count: 1,
      touched_entry_file_count: 0
    )
    && !floor_precompute_would_skip(
      diff: floor_test_diff_nonempty,
      frontier: FrontierProduced { nodes: [] },
      edited_test_fn_count: 0,
      touched_entry_file_count: 1
    )
}

test fn floor_test_precompute_host_kernel_equivalent_holds() -> Bool {
  floor_kernel_precompute_would_skip(
    changed_paths: ["src/v2/lens/affected_set.dag"],
    frontier_node_count: 0,
    edited_test_fn_count: 0,
    touched_entry_file_count: 0
  )
    && floor_host_scaffold_precompute_would_skip(
      changed_paths: ["src/v2/lens/affected_set.dag"],
      frontier_node_count: 0,
      edited_test_fn_count: 0,
      touched_entry_file_count: 0
    )
    && !floor_kernel_precompute_would_skip(
      changed_paths: ["src/v2/lens/affected_set.dag"],
      frontier_node_count: 0,
      edited_test_fn_count: 0,
      touched_entry_file_count: 1
    )
}

test fn floor_test_eval_nodes_from_claims_holds() -> Bool {
  let nodes = floor_witness_eval_nodes_from_claims(
    claims: [floor_test_claim_conj_wrapped, floor_test_claim_untouched]
  )
  (length(xs: nodes) > 0)
    && floor_witness_nodes_touch_frontier(
      witness_nodes: nodes,
      frontier: [floor_test_touched_node]
    )
}

test fn floor_test_any_claim_touch_holds() -> Bool {
  floor_any_claim_touches_rerun_frontier(
    claims: [floor_test_claim_untouched, floor_test_claim_touched],
    frontier: [floor_test_touched_node]
  )
    && count_equal(
      xs: [floor_test_claim_touched],
      item: floor_test_claim_touched,
      eq: fn(left, right) { left == right }
    ) != 0
}

test fn floor_test_diff_policy_matches_ci_spec_holds() -> Bool {
  floor_skip_git_diff_policy().base == "origin/main"
    && floor_skip_git_diff_policy().head == "HEAD"
    && floor_skip_git_diff_policy().mode == DiffMergeBase
}

data floor_test_fn_edit_touch: FloorDiffLineTouch = FloorDiffLineTouch {
  path: "src/v2/test/fixture/floor_skip/node_precise_discriminator_test.dag",
  start_line: 74,
  end_line: 74
}

data floor_test_fn_body_edit_touch: FloorDiffLineTouch = FloorDiffLineTouch {
  path: "src/v2/test/fixture/floor_skip/node_precise_discriminator_test.dag",
  start_line: 78,
  end_line: 78
}

test fn floor_test_fn_declaration_edited_holds() -> Bool {
  floor_test_fn_declaration_edited(
    touches: [floor_test_fn_edit_touch],
    file_path: "src/v2/test/fixture/floor_skip/node_precise_discriminator_test.dag",
    test_fn_decl_line: 74,
    test_fn_decl_end_line: 84
  )
    && floor_test_fn_declaration_edited(
      touches: [floor_test_fn_body_edit_touch],
      file_path: "src/v2/test/fixture/floor_skip/node_precise_discriminator_test.dag",
      test_fn_decl_line: 74,
      test_fn_decl_end_line: 84
    )
    && !floor_test_fn_declaration_edited(
      touches: [floor_test_fn_edit_touch],
      file_path: "src/v2/test/fixture/floor_skip/node_precise_discriminator_test.dag",
      test_fn_decl_line: 15,
      test_fn_decl_end_line: 19
    )
}

test fn floor_test_rust_run_implies_dag_run_superset_holds() -> Bool {
  floor_rust_run_implies_dag_run(
    rust_touches_frontier: true,
    rust_function_edited: false,
    dag_touches_frontier: true,
    dag_function_edited: false
  )
    && floor_rust_run_implies_dag_run(
      rust_touches_frontier: false,
      rust_function_edited: true,
      dag_touches_frontier: false,
      dag_function_edited: true
    )
    && floor_rust_run_implies_dag_run(
      rust_touches_frontier: false,
      rust_function_edited: false,
      dag_touches_frontier: false,
      dag_function_edited: false
    )
    && !floor_rust_run_implies_dag_run(
      rust_touches_frontier: true,
      rust_function_edited: false,
      dag_touches_frontier: false,
      dag_function_edited: false
    )
}

test fn floor_runner_unaffected_assumed_green_skips_holds() -> Bool {
  floor_test_untouched_skips_assumed_green_holds()
    && floor_test_empty_diff_runs_all_holds()
    && floor_test_diff_fail_closed_runs_holds()
}

test fn floor_runner_node_frontier_policy_holds() -> Bool {
  floor_test_untouched_skips_assumed_green_holds()
    && floor_test_touched_runs_holds()
    && floor_test_function_edited_runs_holds()
    && floor_test_entry_file_touched_runs_holds()
    && floor_test_fn_declaration_edited_holds()
    && floor_test_rust_run_implies_dag_run_superset_holds()
    && floor_test_empty_diff_runs_all_holds()
    && floor_test_diff_fail_closed_runs_holds()
    && floor_test_frontier_fail_closed_runs_holds()
    && floor_test_claim_touch_discriminates_holds()
    && floor_test_inner_frontier_discriminates_holds()
    && floor_test_host_kernel_skip_equivalent_holds()
    && floor_test_host_kernel_run_equivalent_holds()
    && floor_test_precompute_skip_holds()
    && floor_test_precompute_host_kernel_equivalent_holds()
    && floor_test_eval_nodes_from_claims_holds()
    && floor_test_any_claim_touch_holds()
    && floor_test_diff_policy_matches_ci_spec_holds()
}
