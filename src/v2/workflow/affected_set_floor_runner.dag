module v2.workflow.affected_set_floor_runner

import gunbc.ci_spec { gunbc_ci_spec, DiffPolicy }
import v2.compiler.program_assembly { program_assembly_read_to_normalized_root }
import v2.compiler.source_authority {
  DagSourceReadWitness,
  SourceRootIngest
}
import v2.extdeps.languages.dag { dag_language_model_wave1 }
import v2.std.artifact { NodeArtifactProvenance }
import v2.lens.edit_locus {
  GitDiffNameOnly,
  affected_set_reading_from_git_diff_provenance,
  edit_locus_no_match_diagnostic
}
import v2.compiler.infer { InferredTree }
import v2.std.algebra { any, Empty, FreeMonoid, fold_list, length, list_append, list_snoc_item }
import v2.std.collection { List }
import v2.std.diagnostic { Accepted, NonEmptyDiagnostics, Outcome, Rejected, outcome_accepted }
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.text { String }
import v2.std.integer { Int }
import v2.std.witness { Holds, Violates, Witness }
import v2.std.verification {
  TestClaim,
  test_claim_evaluation_node_touches_frontier,
  test_claim_evaluation_nodes,
  test_claim_evaluation_touches_rerun_frontier
}
import v2.test.workflow.host_source_root_ingest_manifest {
  host_source_root_ingest,
  host_source_root_ingest_coverage_receipt
}

type FloorDiffObservation
  = DiffPathsProduced { changed_paths: List<String> }
  | DiffObservationFailClosed { reason: String }

type FloorRerunFrontier
  = FrontierProduced { nodes: List<Node> }
  | FrontierFailClosed { reason: String }

type WitnessRunDisposition
  = RunWitness { reason: String }
  | SkipAssumedGreen

type FloorWitnessRow {
  label: String
  entry: String
  function: String
}

type FloorDiffLineTouch {
  path: String
  start_line: Int
  end_line: Int
}

fn floor_diff_line_touches_decl(
  touch: FloorDiffLineTouch,
  file_path: String,
  decl_line: Int,
  decl_end_line: Int
) -> Bool {
  touch.path == file_path
    && touch.start_line <= decl_end_line
    && touch.end_line >= decl_line
}

fn floor_test_fn_declaration_edited(
  touches: List<FloorDiffLineTouch>,
  file_path: String,
  test_fn_decl_line: Int,
  test_fn_decl_end_line: Int
) -> Bool {
  any(
    xs: touches,
    predicate: fn(t) {
      floor_diff_line_touches_decl(
        touch: t,
        file_path: file_path,
        decl_line: test_fn_decl_line,
        decl_end_line: test_fn_decl_end_line
      )
    }
  )
}

fn floor_rust_run_implies_dag_run(
  rust_touches_frontier: Bool,
  rust_function_edited: Bool,
  dag_touches_frontier: Bool,
  dag_function_edited: Bool
) -> Bool {
  let rust_run = rust_touches_frontier || rust_function_edited
  let dag_run = dag_touches_frontier || dag_function_edited
  !rust_run || dag_run
}

fn floor_skip_git_diff_policy() -> DiffPolicy {
  gunbc_ci_spec.diff_policy
}

fn floor_any_node_touches_frontier(nodes: List<Node>, frontier: List<Node>) -> Bool {
  any(
    xs: nodes,
    predicate: fn(n) {
      test_claim_evaluation_node_touches_frontier(n: n, frontier: frontier)
    }
  )
}

fn floor_claim_touches_rerun_frontier(claim: TestClaim, frontier: List<Node>) -> Bool {
  test_claim_evaluation_touches_rerun_frontier(c: claim, frontier: frontier)
}

fn floor_any_claim_touches_rerun_frontier(claims: List<TestClaim>, frontier: List<Node>) -> Bool {
  any(
    xs: claims,
    predicate: fn(c) { floor_claim_touches_rerun_frontier(claim: c, frontier: frontier) }
  )
}

fn floor_witness_nodes_touch_frontier(witness_nodes: List<Node>, frontier: List<Node>) -> Bool {
  floor_any_node_touches_frontier(nodes: witness_nodes, frontier: frontier)
}

fn floor_witness_run_disposition(
  diff: FloorDiffObservation,
  frontier: FloorRerunFrontier,
  touches_frontier: Bool,
  function_edited: Bool,
  entry_file_touched: Bool
) -> WitnessRunDisposition {
  match diff {
    DiffObservationFailClosed { reason: reason } =>
      RunWitness { reason: reason }
    DiffPathsProduced { changed_paths: paths } =>
      if length(xs: paths) == 0 {
        RunWitness { reason: "empty diff — run full corpus (fail-closed)" }
      } else {
        match frontier {
          FrontierFailClosed { reason: reason } =>
            RunWitness { reason: reason }
          FrontierProduced { nodes: _ } =>
            if touches_frontier {
              RunWitness { reason: "witness node-closure intersects rerun frontier" }
            } else if function_edited {
              RunWitness { reason: "witness test fn declaration directly edited" }
            } else if entry_file_touched {
              RunWitness { reason: "witness entry import-closure has non-data fn edit in diff" }
            } else {
              SkipAssumedGreen
            }
        }
      }
  }
}

fn floor_kernel_would_skip(
  changed_paths: List<String>,
  frontier_nodes: List<Node>,
  touches_frontier: Bool,
  function_edited: Bool,
  entry_file_touched: Bool
) -> Bool {
  match floor_witness_run_disposition(
    diff: DiffPathsProduced { changed_paths: changed_paths },
    frontier: FrontierProduced { nodes: frontier_nodes },
    touches_frontier: touches_frontier,
    function_edited: function_edited,
    entry_file_touched: entry_file_touched
  ) {
    SkipAssumedGreen => true
    RunWitness { reason: _ } => false
  }
}

fn floor_host_scaffold_would_skip(
  changed_paths: List<String>,
  frontier_nodes: List<Node>,
  touches_frontier: Bool,
  function_edited: Bool,
  entry_file_touched: Bool
) -> Bool {
  floor_kernel_would_skip(
    changed_paths: changed_paths,
    frontier_nodes: frontier_nodes,
    touches_frontier: touches_frontier,
    function_edited: function_edited,
    entry_file_touched: entry_file_touched
  )
}

fn floor_precompute_would_skip(
  diff: FloorDiffObservation,
  frontier: FloorRerunFrontier,
  edited_test_fn_count: Int,
  touched_entry_file_count: Int
) -> Bool {
  match diff {
    DiffObservationFailClosed { reason: _ } => false
    DiffPathsProduced { changed_paths: paths } =>
      if length(xs: paths) == 0 {
        false
      } else {
        match frontier {
          FrontierFailClosed { reason: _ } => false
          FrontierProduced { nodes: nodes } =>
            (length(xs: nodes) == 0)
              && (edited_test_fn_count == 0)
              && (touched_entry_file_count == 0)
        }
      }
  }
}

fn floor_kernel_precompute_would_skip(
  changed_paths: List<String>,
  frontier_node_count: Int,
  edited_test_fn_count: Int,
  touched_entry_file_count: Int
) -> Bool {
  if frontier_node_count > 0 {
    false
  } else {
    floor_precompute_would_skip(
      diff: DiffPathsProduced { changed_paths: changed_paths },
      frontier: FrontierProduced { nodes: [] },
      edited_test_fn_count: edited_test_fn_count,
      touched_entry_file_count: touched_entry_file_count
    )
  }
}

fn floor_host_scaffold_precompute_would_skip(
  changed_paths: List<String>,
  frontier_node_count: Int,
  edited_test_fn_count: Int,
  touched_entry_file_count: Int
) -> Bool {
  floor_kernel_precompute_would_skip(
    changed_paths: changed_paths,
    frontier_node_count: frontier_node_count,
    edited_test_fn_count: edited_test_fn_count,
    touched_entry_file_count: touched_entry_file_count
  )
}

fn floor_witness_eval_nodes_from_claims(claims: List<TestClaim>) -> List<Node> {
  fold_list(
    xs: claims,
    empty: Empty,
    cons: fn(acc, claim) {
      list_append(left: acc, right: test_claim_evaluation_nodes(c: claim))
    }
  )
}

fn floor_provenance_ingest_is_live() -> Bool {
  host_source_root_ingest_coverage_receipt.coverage_complete
    && (host_source_root_ingest_coverage_receipt.ingest_read_count > 0)
    && (length(xs: host_source_root_ingest) > 0)
}

type FloorNodeArtifactProvenanceFoldState
  = FloorNodeArtifactProvenanceFoldOk {
      provenance: FreeMonoid<NodeArtifactProvenance>
    }
  | FloorNodeArtifactProvenanceFoldFailed {
      diagnostics: NonEmptyDiagnostics
    }

fn floor_node_artifact_provenance_from_read(
  read: DagSourceReadWitness
) -> Outcome<NodeArtifactProvenance> {
  match program_assembly_read_to_normalized_root(
    read: read,
    lm: dag_language_model_wave1()
  ) {
    Accepted { value: root, diagnostics: _ } =>
      outcome_accepted(
        value: NodeArtifactProvenance {
          node: root,
          artifact: read.artifact
        }
      )
    Rejected { diagnostics: d } =>
      Rejected { diagnostics: d }
  }
}

fn floor_node_artifact_provenance_fold_step(
  state: FloorNodeArtifactProvenanceFoldState,
  read: DagSourceReadWitness
) -> FloorNodeArtifactProvenanceFoldState {
  match state {
    FloorNodeArtifactProvenanceFoldFailed { diagnostics: d } =>
      FloorNodeArtifactProvenanceFoldFailed { diagnostics: d }
    FloorNodeArtifactProvenanceFoldOk { provenance: acc } =>
      match floor_node_artifact_provenance_from_read(read: read) {
        Accepted { value: row, diagnostics: _ } =>
          FloorNodeArtifactProvenanceFoldOk {
            provenance: list_snoc_item(xs: acc, item: row)
          }
        Rejected { diagnostics: d } =>
          FloorNodeArtifactProvenanceFoldFailed { diagnostics: d }
      }
  }
}

fn floor_changed_path_in_list(changed_paths: List<String>, file_path: String) -> Bool {
  fold_list(
    xs: changed_paths,
    empty: false,
    cons: fn(acc, changed) {
      if acc == true {
        true
      } else {
        changed == file_path
      }
    }
  )
}

fn floor_node_artifact_provenance_fold_step_for_changed_paths(
  state: FloorNodeArtifactProvenanceFoldState,
  read: DagSourceReadWitness,
  changed_paths: List<String>
) -> FloorNodeArtifactProvenanceFoldState {
  match state {
    FloorNodeArtifactProvenanceFoldFailed { diagnostics: d } =>
      FloorNodeArtifactProvenanceFoldFailed { diagnostics: d }
    FloorNodeArtifactProvenanceFoldOk { provenance: acc } =>
      if floor_changed_path_in_list(
        changed_paths: changed_paths,
        file_path: read.artifact.file_path
      ) == false {
        FloorNodeArtifactProvenanceFoldOk { provenance: acc }
      } else {
        floor_node_artifact_provenance_fold_step(state: state, read: read)
      }
  }
}

fn floor_node_artifact_provenance_from_ingest_for_changed_paths(
  ingest: SourceRootIngest,
  changed_paths: List<String>
) -> Outcome<FreeMonoid<NodeArtifactProvenance>> {
  match fold_list(
    xs: ingest,
    empty: FloorNodeArtifactProvenanceFoldOk { provenance: Empty },
    cons: fn(state, read) {
      floor_node_artifact_provenance_fold_step_for_changed_paths(
        state: state,
        read: read,
        changed_paths: changed_paths
      )
    }
  ) {
    FloorNodeArtifactProvenanceFoldOk { provenance: p } =>
      outcome_accepted(value: p)
    FloorNodeArtifactProvenanceFoldFailed { diagnostics: d } =>
      Rejected { diagnostics: d }
  }
}

fn floor_node_artifact_provenance_from_ingest(
  ingest: SourceRootIngest
) -> Outcome<FreeMonoid<NodeArtifactProvenance>> {
  match fold_list(
    xs: ingest,
    empty: FloorNodeArtifactProvenanceFoldOk { provenance: Empty },
    cons: fn(state, read) {
      floor_node_artifact_provenance_fold_step(state: state, read: read)
    }
  ) {
    FloorNodeArtifactProvenanceFoldOk { provenance: p } =>
      outcome_accepted(value: p)
    FloorNodeArtifactProvenanceFoldFailed { diagnostics: d } =>
      Rejected { diagnostics: d }
  }
}

fn floor_witness_entry_tree_root_from_read(read: DagSourceReadWitness) -> Witness<Node> {
  match program_assembly_read_to_normalized_root(
    read: read,
    lm: dag_language_model_wave1()
  ) {
    Accepted { value: root, diagnostics: _ } =>
      Holds { value: root }
    Rejected { diagnostics: _ } =>
      Violates { diagnostic: edit_locus_no_match_diagnostic() }
  }
}

fn floor_entry_read_from_ingest_step(
  found: Witness<DagSourceReadWitness>,
  read: DagSourceReadWitness,
  entry_path: String
) -> Witness<DagSourceReadWitness> {
  match found {
    Holds { value: _ } => found
    Violates { diagnostic: _ } =>
      if read.artifact.file_path == entry_path {
        Holds { value: read }
      } else {
        Violates { diagnostic: edit_locus_no_match_diagnostic() }
      }
  }
}

fn floor_entry_read_from_ingest(entry_path: String) -> Witness<DagSourceReadWitness> {
  fold_list(
    xs: host_source_root_ingest,
    empty: Violates { diagnostic: edit_locus_no_match_diagnostic() },
    cons: fn(found, read) {
      floor_entry_read_from_ingest_step(
        found: found,
        read: read,
        entry_path: entry_path
      )
    }
  )
}

fn floor_witness_entry_tree_root_from_ingest_path(entry_path: String) -> Witness<Node> {
  match floor_entry_read_from_ingest(entry_path: entry_path) {
    Holds { value: read } =>
      floor_witness_entry_tree_root_from_read(read: read)
    Violates { diagnostic: d } =>
      Violates { diagnostic: d }
  }
}

fn floor_rerun_frontier_from_provenance(
  entry_root: Node,
  changed_paths: List<String>
) -> Witness<List<Node>> {
  if floor_provenance_ingest_is_live() == false {
    Violates { diagnostic: edit_locus_no_match_diagnostic() }
  } else {
    match floor_node_artifact_provenance_from_ingest_for_changed_paths(
      ingest: host_source_root_ingest,
      changed_paths: changed_paths
    ) {
      Accepted { value: provenance, diagnostics: _ } =>
        match affected_set_reading_from_git_diff_provenance(
          graph: InferredTree { root: entry_root, facts: Empty },
          git_diff: GitDiffNameOnly { changed_paths: changed_paths },
          provenance: provenance
        ) {
          Holds { value: reading } =>
            Holds { value: reading.affected }
          Violates { diagnostic: d } =>
            Violates { diagnostic: d }
        }
      Rejected { diagnostics: _ } =>
        Violates { diagnostic: edit_locus_no_match_diagnostic() }
    }
  }
}
