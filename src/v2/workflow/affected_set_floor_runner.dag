module v2.workflow.affected_set_floor_runner

import gunbc.ci_spec { gunbc_ci_spec, DiffPolicy }
import v2.compiler.source_authority { node_artifact_provenance_from_source_root }
import v2.lens.affected_set { affected_set_reading_for_entry_root }
import v2.lens.edit_locus {
  GitDiffNameOnly,
  affected_set_reading_from_git_diff_provenance,
  edit_locus_no_match_diagnostic
}
import v2.compiler.infer { InferredTree }
import v2.std.algebra { any, Empty, fold_list, length, list_append }
import v2.std.collection { List }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.text { String }
import v2.std.integer { Int }
import v2.std.witness { Holds, Violates, Witness }
import v2.std.verification {
  TestClaim,
  test_claim_evaluation_node_touches_frontier,
  test_claim_evaluation_nodes,
  test_claim_evaluation_touches_rerun_frontier
}
import v2.test.workflow.host_source_root_ingest_manifest {
  host_source_root_ingest,
  host_source_root_ingest_coverage_receipt
}

type FloorDiffObservation
  = DiffPathsProduced { changed_paths: List<String> }
  | DiffObservationFailClosed { reason: String }

type FloorRerunFrontier
  = FrontierProduced { nodes: List<Node> }
  | FrontierFailClosed { reason: String }

type WitnessRunDisposition
  = RunWitness { reason: String }
  | SkipAssumedGreen

type FloorWitnessRow {
  label: String
  entry: String
  function: String
}

type FloorDiffLineTouch {
  path: String
  start_line: Int
  end_line: Int
}

fn floor_diff_line_touches_decl(
  touch: FloorDiffLineTouch,
  file_path: String,
  decl_line: Int,
  decl_end_line: Int
) -> Bool {
  touch.path == file_path
    && touch.start_line <= decl_end_line
    && touch.end_line >= decl_line
}

fn floor_test_fn_declaration_edited(
  touches: List<FloorDiffLineTouch>,
  file_path: String,
  test_fn_decl_line: Int,
  test_fn_decl_end_line: Int
) -> Bool {
  any(
    xs: touches,
    predicate: fn(t) {
      floor_diff_line_touches_decl(
        touch: t,
        file_path: file_path,
        decl_line: test_fn_decl_line,
        decl_end_line: test_fn_decl_end_line
      )
    }
  )
}

fn floor_rust_run_implies_dag_run(
  rust_touches_frontier: Bool,
  rust_function_edited: Bool,
  dag_touches_frontier: Bool,
  dag_function_edited: Bool
) -> Bool {
  let rust_run = rust_touches_frontier || rust_function_edited
  let dag_run = dag_touches_frontier || dag_function_edited
  !rust_run || dag_run
}

fn floor_skip_git_diff_policy() -> DiffPolicy {
  gunbc_ci_spec.diff_policy
}

fn floor_any_node_touches_frontier(nodes: List<Node>, frontier: List<Node>) -> Bool {
  any(
    xs: nodes,
    predicate: fn(n) {
      test_claim_evaluation_node_touches_frontier(n: n, frontier: frontier)
    }
  )
}

fn floor_claim_touches_rerun_frontier(claim: TestClaim, frontier: List<Node>) -> Bool {
  test_claim_evaluation_touches_rerun_frontier(c: claim, frontier: frontier)
}

fn floor_any_claim_touches_rerun_frontier(claims: List<TestClaim>, frontier: List<Node>) -> Bool {
  any(
    xs: claims,
    predicate: fn(c) { floor_claim_touches_rerun_frontier(claim: c, frontier: frontier) }
  )
}

fn floor_witness_nodes_touch_frontier(witness_nodes: List<Node>, frontier: List<Node>) -> Bool {
  floor_any_node_touches_frontier(nodes: witness_nodes, frontier: frontier)
}

fn floor_witness_run_disposition(
  diff: FloorDiffObservation,
  frontier: FloorRerunFrontier,
  touches_frontier: Bool,
  function_edited: Bool
) -> WitnessRunDisposition {
  match diff {
    DiffObservationFailClosed { reason: reason } =>
      RunWitness { reason: reason }
    DiffPathsProduced { changed_paths: paths } =>
      if length(xs: paths) == 0 {
        RunWitness { reason: "empty diff — run full corpus (fail-closed)" }
      } else {
        match frontier {
          FrontierFailClosed { reason: reason } =>
            RunWitness { reason: reason }
          FrontierProduced { nodes: _ } =>
            if touches_frontier || function_edited {
              RunWitness {
                reason: if function_edited {
                  "witness test fn declaration directly edited"
                } else {
                  "witness node-closure intersects rerun frontier"
                }
              }
            } else {
              SkipAssumedGreen
            }
        }
      }
  }
}

fn floor_kernel_would_skip(
  changed_paths: List<String>,
  frontier_nodes: List<Node>,
  touches_frontier: Bool,
  function_edited: Bool
) -> Bool {
  match floor_witness_run_disposition(
    diff: DiffPathsProduced { changed_paths: changed_paths },
    frontier: FrontierProduced { nodes: frontier_nodes },
    touches_frontier: touches_frontier,
    function_edited: function_edited
  ) {
    SkipAssumedGreen => true
    RunWitness { reason: _ } => false
  }
}

fn floor_host_scaffold_would_skip(
  changed_paths: List<String>,
  frontier_nodes: List<Node>,
  touches_frontier: Bool,
  function_edited: Bool
) -> Bool {
  floor_kernel_would_skip(
    changed_paths: changed_paths,
    frontier_nodes: frontier_nodes,
    touches_frontier: touches_frontier,
    function_edited: function_edited
  )
}

fn floor_witness_eval_nodes_from_claims(claims: List<TestClaim>) -> List<Node> {
  fold_list(
    xs: claims,
    empty: Empty,
    cons: fn(acc, claim) {
      list_append(left: acc, right: test_claim_evaluation_nodes(c: claim))
    }
  )
}

fn floor_provenance_ingest_is_live() -> Bool {
  host_source_root_ingest_coverage_receipt.coverage_complete
    && (host_source_root_ingest_coverage_receipt.ingest_read_count > 0)
    && (length(xs: host_source_root_ingest) > 0)
}

fn floor_rerun_frontier_from_edit_loci(entry_root: Node, edit_loci: List<Node>) -> List<Node> {
  fold_list(
    xs: edit_loci,
    empty: Empty,
    cons: fn(acc, locus) {
      let reading = affected_set_reading_for_entry_root(
        entry_root: entry_root,
        edit_locus: locus
      )
      list_append(left: acc, right: reading.affected)
    }
  )
}

fn floor_rerun_frontier_from_provenance(
  entry_root: Node,
  changed_paths: List<String>
) -> Witness<List<Node>> {
  if floor_provenance_ingest_is_live() == false {
    Violates { diagnostic: edit_locus_no_match_diagnostic() }
  } else {
    match node_artifact_provenance_from_source_root(ingest: host_source_root_ingest) {
      Accepted { value: provenance, diagnostics: _ } =>
        match affected_set_reading_from_git_diff_provenance(
          graph: InferredTree { root: entry_root, facts: Empty },
          git_diff: GitDiffNameOnly { changed_paths: changed_paths },
          provenance: provenance
        ) {
          Holds { value: reading } =>
            Holds { value: reading.affected }
          Violates { diagnostic: d } =>
            Violates { diagnostic: d }
        }
      Rejected { diagnostics: _ } =>
        Violates { diagnostic: edit_locus_no_match_diagnostic() }
    }
  }
}
