module v2.workflow.affected_set_floor_runner

import gunbc.ci_spec { gunbc_ci_spec, DiffPolicy }
import v2.std.algebra { any, Empty, fold_list, length, list_append }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.text { String }
import v2.std.integer { Int }
import v2.std.verification {
  TestClaim,
  test_claim_evaluation_node_touches_frontier,
  test_claim_evaluation_nodes,
  test_claim_evaluation_touches_rerun_frontier
}

type FloorDiffObservation
  = DiffPathsProduced { changed_paths: List<String> }
  | DiffObservationFailClosed { reason: String }

type FloorRerunFrontier
  = FrontierProduced { nodes: List<Node> }
  | FrontierFailClosed { reason: String }

type WitnessRefusalCause
  = DiffObservationRefusal { reason: String }
  | FrontierQueryRefusal { reason: String }

type WitnessRunDisposition
  = RunWitness { reason: String }
  | SkipAssumedGreen
  | Refused { cause: WitnessRefusalCause }

data floor_disposition_refusal_note: String = "Operator rulings (2026-07-05): a failure arm must refuse, never widen. Refused replaces the prior DiffObservationFailClosed/FrontierFailClosed -> RunWitness absorbing arms: the witness is NOT run, the refusal is a per-row typed red (siblings continue; the floor exits nonzero while any refusal count is nonzero), and each cause is its own variant so each failure class has an observable frequency. Empty diff is NOT a state: an empty touched-path set flows through the general disposition (nothing affected -> SkipAssumedGreen) - the prior special arm (empty diff -> run full corpus) was the section-5 absorbing fallback, deleted together with the tests that asserted its reason string. Feature-flag-off is a host config state (node_frontier_selection: SelectionOff), never conflated with an empty diff; observation FAILURE (git could not produce a diff) is the only ignorance state and maps to DiffObservationRefusal. Git-interface grain (name-status, rename pairs) is CLOSED: extdeps.git models `git diff --name-status -z` (GitDiffChangeStatus A/M/D/R<score>/C<score>, rename/copy carrying old_path) as the single typed authority, projected through v2.workflow.floor_diff_observe's NameStatusDiffOk into this runner's DiffPathsProduced.changed_paths (both sides of a rename derived from the typed row via git_diff_status_entries_touched_paths, never pre-flattened by a unified-diff header scrape). Base-ref policy stays in DiffPolicy (workflow layer)."

type FloorWitnessRow {
  label: String
  entry: String
  function: String
}

data floor_host_scaffold_witness_marker_note: String = "Declared on a `test fn` line (or its body) when the witness reads the live tree via host intrinsics. The claim_executor host-scaffold classifier honors this marker so detection is not limited to Rust substring heuristics alone. DISSOLVE-ON: ROADMAP `2-host-scaffold-classifier-defork` - substrate-declared `reads_live_tree` disposition on TestClaim rows. (Was a // comment block: the v1 interpreter grammar has no comments, so it broke resolve_floor_runner_context and silently disabled the affected-set skip - every floor run fell back to full corpus. Found during the 2026-07-04 CI witness opt-in inversion.)"

data floor_host_scaffold_witness_marker: String = "floor:host_scaffold"

type FloorDiffLineTouch {
  path: String
  start_line: Int
  end_line: Int
}

fn floor_diff_line_touches_decl(
  touch: FloorDiffLineTouch,
  file_path: String,
  decl_line: Int,
  decl_end_line: Int
) -> Bool {
  touch.path == file_path
    && touch.start_line <= decl_end_line
    && touch.end_line >= decl_line
}

fn floor_test_fn_declaration_edited(
  touches: List<FloorDiffLineTouch>,
  file_path: String,
  test_fn_decl_line: Int,
  test_fn_decl_end_line: Int
) -> Bool {
  any(
    xs: touches,
    predicate: fn(t) {
      floor_diff_line_touches_decl(
        touch: t,
        file_path: file_path,
        decl_line: test_fn_decl_line,
        decl_end_line: test_fn_decl_end_line
      )
    }
  )
}

fn floor_rust_run_implies_dag_run(
  rust_touches_frontier: Bool,
  rust_function_edited: Bool,
  dag_touches_frontier: Bool,
  dag_function_edited: Bool
) -> Bool {
  let rust_run = rust_touches_frontier || rust_function_edited
  let dag_run = dag_touches_frontier || dag_function_edited
  !rust_run || dag_run
}

fn floor_skip_git_diff_policy() -> DiffPolicy {
  gunbc_ci_spec.diff_policy
}

fn floor_any_node_touches_frontier(nodes: List<Node>, frontier: List<Node>) -> Bool {
  any(
    xs: nodes,
    predicate: fn(n) {
      test_claim_evaluation_node_touches_frontier(n: n, frontier: frontier)
    }
  )
}

fn floor_claim_touches_rerun_frontier(claim: TestClaim, frontier: List<Node>) -> Bool {
  test_claim_evaluation_touches_rerun_frontier(c: claim, frontier: frontier)
}

fn floor_any_claim_touches_rerun_frontier(claims: List<TestClaim>, frontier: List<Node>) -> Bool {
  any(
    xs: claims,
    predicate: fn(c) { floor_claim_touches_rerun_frontier(claim: c, frontier: frontier) }
  )
}

fn floor_witness_nodes_touch_frontier(witness_nodes: List<Node>, frontier: List<Node>) -> Bool {
  floor_any_node_touches_frontier(nodes: witness_nodes, frontier: frontier)
}

fn floor_witness_run_disposition(
  diff: FloorDiffObservation,
  frontier: FloorRerunFrontier,
  touches_frontier: Bool,
  function_edited: Bool,
  entry_file_touched: Bool
) -> WitnessRunDisposition {
  match diff {
    DiffObservationFailClosed { reason: reason } =>
      Refused { cause: DiffObservationRefusal { reason: reason } }
    DiffPathsProduced { changed_paths: _ } =>
      match frontier {
        FrontierFailClosed { reason: reason } =>
          Refused { cause: FrontierQueryRefusal { reason: reason } }
        FrontierProduced { nodes: _ } =>
          if touches_frontier {
            RunWitness { reason: "witness node-closure intersects rerun frontier" }
          } else if function_edited {
            RunWitness { reason: "witness test fn declaration directly edited" }
          } else if entry_file_touched {
            RunWitness { reason: "witness entry import-closure has non-data fn edit in diff" }
          } else {
            SkipAssumedGreen
          }
      }
  }
}

fn floor_kernel_would_skip(
  changed_paths: List<String>,
  frontier_nodes: List<Node>,
  touches_frontier: Bool,
  function_edited: Bool,
  entry_file_touched: Bool
) -> Bool {
  match floor_witness_run_disposition(
    diff: DiffPathsProduced { changed_paths: changed_paths },
    frontier: FrontierProduced { nodes: frontier_nodes },
    touches_frontier: touches_frontier,
    function_edited: function_edited,
    entry_file_touched: entry_file_touched
  ) {
    SkipAssumedGreen => true
    RunWitness { reason: _ } => false
    Refused { cause: _ } => false
  }
}

data floor_kernel_would_skip_refused_arm_note: String = "The Refused arm in floor_kernel_would_skip is unreachable by construction: the wrapper builds only DiffPathsProduced/FrontierProduced, and the host errors out on observation/frontier failure before calling it. The arm exists for match totality; refusal semantics live at the disposition authority (floor_witness_run_disposition), which the host consumes directly for failure states. Collapsing refusal into a Bool would be the state-space conflation this PR removes - do not route refusals through this wrapper."

data floor_host_scaffold_would_skip_note: String = "Host-scan walls read the live tree via host intrinsics (`layer_import_facts`, `*_facts_live`, ...). Node-frontier skip is unsound for them: an unrelated diff can leave a corpus-wide violation red while the witness is assumed green."

fn floor_host_scaffold_would_skip(
  changed_paths: List<String>,
  frontier_nodes: List<Node>,
  touches_frontier: Bool,
  function_edited: Bool,
  entry_file_touched: Bool
) -> Bool {
  false
}

fn floor_precompute_would_skip(
  diff: FloorDiffObservation,
  frontier: FloorRerunFrontier,
  edited_test_fn_count: Int,
  touched_entry_file_count: Int
) -> Bool {
  match diff {
    DiffObservationFailClosed { reason: _ } => false
    DiffPathsProduced { changed_paths: _ } =>
      match frontier {
        FrontierFailClosed { reason: _ } => false
        FrontierProduced { nodes: nodes } =>
          (length(xs: nodes) == 0)
            && (edited_test_fn_count == 0)
            && (touched_entry_file_count == 0)
      }
  }
}

fn floor_kernel_precompute_would_skip(
  changed_paths: List<String>,
  frontier_node_count: Int,
  edited_test_fn_count: Int,
  touched_entry_file_count: Int
) -> Bool {
  if frontier_node_count > 0 {
    false
  } else {
    floor_precompute_would_skip(
      diff: DiffPathsProduced { changed_paths: changed_paths },
      frontier: FrontierProduced { nodes: [] },
      edited_test_fn_count: edited_test_fn_count,
      touched_entry_file_count: touched_entry_file_count
    )
  }
}

data floor_host_scaffold_precompute_would_skip_note: String = "Conservative: host-scaffold witnesses in the corpus always run, so the whole-tree published-mock precompute they may depend on must not be skipped."

fn floor_host_scaffold_precompute_would_skip(
  changed_paths: List<String>,
  frontier_node_count: Int,
  edited_test_fn_count: Int,
  touched_entry_file_count: Int
) -> Bool {
  false
}

fn floor_witness_eval_nodes_from_claims(claims: List<TestClaim>) -> List<Node> {
  fold_list(
    xs: claims,
    empty: Empty,
    cons: fn(acc, claim) {
      list_append(left: acc, right: test_claim_evaluation_nodes(c: claim))
    }
  )
}
