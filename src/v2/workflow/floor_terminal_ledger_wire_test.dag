  CompletedPastSafetyLimit,
  CompletedWithinSafetyLimits,
  OpaqueHostCallUnbounded,
  SafetyInterrupted
}

// THE FIXTURE'S SNAPSHOT IS BUILT THROUGH THE PRODUCTION ADMISSION, so a bad hex here degrades to
// `UnpublishedWorkingTree` -- and `an_unpublished_run_is_a_shape_and_an_unrecognized_snapshot_refuses`
// asserts this binding IS candidate-bound, so the degradation fails a test instead of passing
// silently. The alternative spelling, `git_object_id_from_untagged_hex(...) as GitObjectId` on the
// absent arm, type-checks and RENDERS THE OPTIONAL WRAPPER -- the same trap this module refuses in
// its parser, and it would have sat here unreachable until the day it was reached.
fn fixture_snapshot(hex: String) -> RepositorySnapshot {
  match admit_repository_snapshot_wire(wire: hex) {
    SnapshotAdmitted { snapshot: s } => s
    SnapshotWireUnrecognized { offending: _ } => UnpublishedWorkingTree
  }
}

fn ident(f: String) -> WitnessIdentity {
  WitnessIdentity { module_path: "test.claim.example", function: f }
}

fn binding() -> LedgerBinding {
  LedgerBinding {
    repository_snapshot: fixture_snapshot(hex: "1234567890abcdef1234567890abcdef12345678"),
    prepared_subject: structural_content_hash(digest: "0000000000000002")
  }
}

fn passing_row(f: String) -> ClaimTerminalRow {
  ClaimTerminalRow {
    identity: ident(f: f),
    expectation: ExpectedToHold,
    terminal: Returned { observation: ObservedVerdict { holds: true } }
  }
}

fn rendered_text(rows: List<ClaimTerminalRow>) -> String {
  match render_ledger(binding: binding(), rows: rows) {
    LedgerUnrenderable { reason: _, offending: _, diagnosis: _ } => ""
    LedgerRendered { text: t } => t
  }
}

// EVERY TERMINAL SHAPE, NOT A SAMPLE. A tag collision shows up in exactly one arm and nowhere
// else, so a test over three representative shapes would pass while two dispositions were fused.
// THE POPULATION IS TWELVE, NOT NINE, AND THE THREE ADDED SHAPES ARE THE ONES A WILDCARDED
// `safety` COULD NOT DISTINGUISH. Before the split every one of them rendered as `budget-refused`
// and projected to `BudgetRefusedBeforeVerdict`, so a round trip over them agreed with a mapping
// that was wrong on both sides identically -- the failure a same-instrument comparison cannot
// see. Each now carries its own tag and its own disposition, and that is the RED: collapse either
// mapping back to one arm and the agreement assertion below fails.
fn every_shape() -> List<ClaimTerminalRow> {
  [
    ClaimTerminalRow {
      identity: ident(f: "pass"),
      expectation: ExpectedToHold,
      terminal: Returned { observation: ObservedVerdict { holds: true } }
    },
    ClaimTerminalRow {
      identity: ident(f: "fail"),
      expectation: ExpectedToHold,
      terminal: Returned { observation: ObservedVerdict { holds: false } }
    },
    ClaimTerminalRow {
      identity: ident(f: "known_red_held"),
      expectation: ExpectedRed,
      terminal: Returned { observation: ObservedVerdict { holds: false } }
    },
    ClaimTerminalRow {
      identity: ident(f: "known_red_now_passing"),
      expectation: ExpectedRed,
      terminal: Returned { observation: ObservedVerdict { holds: true } }
    },
    ClaimTerminalRow {
      identity: ident(f: "unreadable"),
      expectation: ExpectedToHold,
      terminal: Returned { observation: ObservationUnrepresentable { reason: "not-a-bool" } }
    },
    ClaimTerminalRow {
      identity: ident(f: "runtime_errored"),
      expectation: ExpectedToHold,
      terminal: RuntimeErrored { message: "boom" }
    },
    ClaimTerminalRow {
      identity: ident(f: "budget_refused"),
      expectation: ExpectedToHold,
      terminal: BudgetRefused {
        safety: SafetyInterrupted {
          raised_by: "wall",
          elapsed_cpu_at_least: 0,
          elapsed_wall_at_least: 0
        }
      }
    },
    ClaimTerminalRow {
      identity: ident(f: "passed_over_budget"),
      expectation: ExpectedToHold,
      terminal: BudgetRefused {
        safety: CompletedPastSafetyLimit {
          observed_cpu: 57193,
          observed_wall: 57337,
          preemption: OpaqueHostCallUnbounded { operation: "compile_dag_rust_emit_check" }
        }
      }
    },
    ClaimTerminalRow {
      identity: ident(f: "known_red_passed_over_budget"),
      expectation: ExpectedRed,
      terminal: BudgetRefused {
        safety: CompletedPastSafetyLimit {
          observed_cpu: 57193,
          observed_wall: 57337,
          preemption: OpaqueHostCallUnbounded { operation: "compile_dag_rust_emit_check" }
        }
      }
    },
    ClaimTerminalRow {
      identity: ident(f: "budget_terminal_without_safety_cause"),
      expectation: ExpectedToHold,
      terminal: BudgetRefused { safety: CompletedWithinSafetyLimits }
    },
    ClaimTerminalRow {
      identity: ident(f: "host_tool_unresolved"),
      expectation: ExpectedToHold,
      terminal: HostToolUnresolved { name: "rustfmt", probed: [] }
    },
    ClaimTerminalRow {
      identity: ident(f: "route_gap"),
      expectation: ExpectedToHold,
      terminal: RouteGap { operation: "Write", ground: NoMockResponse {} }
    },
    ClaimTerminalRow {
      identity: ident(f: "route_gap_unpublished_mock_case"),
      expectation: ExpectedToHold,
      terminal: RouteGap { operation: "Dir", ground: UnpublishedMockCase {} }
    },
    ClaimTerminalRow {
      identity: ident(f: "route_gap_filesystem_removal"),
      expectation: ExpectedToHold,
      terminal: RouteGap { operation: "Remove", ground: FilesystemRemoval {} }
    },
    ClaimTerminalRow {
      identity: ident(f: "panicked"),
      expectation: ExpectedToHold,
      terminal: Panicked { payload: "index out of bounds: the len is 0 but the index is 0" }
    },
    ClaimTerminalRow {
      identity: ident(f: "panicked_while_enrolled_expected_red"),
      expectation: ExpectedRed,
      terminal: Panicked { payload: "called `Option::unwrap()` on a `None` value" }
    },
    ClaimTerminalRow {
      identity: ident(f: "not_attempted_after_the_abort"),
      expectation: ExpectedToHold,
      terminal: NotAttempted { halted_by: "example.unwound" }
    }
  ]
}

fn readback_rows_of(text: String) -> List<LedgerReadbackRow> {
  match parse_ledger(text: text) {
    LedgerUnreadable { reason: _, at: _ } => []
    LedgerRead {
      repository_snapshot: _,
      prepared_subject: _,
      roster_identity: _,
      rows: rows,
      footer_row_count_wire: _,
      footer_digest: _
    } => rows
  }
}

// THE LOAD-BEARING TEST FOR THE ARTIFACT: THE DISPOSITION SURVIVES THE FILE.
//
// A ledger that preserved identities but lost what happened to them would satisfy every
// structural check in the wire module and answer none of the obligation's question. So this
// walks EVERY terminal shape through render -> parse -> disposition and requires agreement with
// `claim_disposition` on the typed row it started from.
fn disposition_survives(row: ClaimTerminalRow) -> Bool {
  match parse_readback_row(line: render_row(row: row)) {
    Absent => false
    Present { value: parsed } =>
      match readback_disposition(row: parsed) {
        Absent => false
        Present { value: d } => d == claim_disposition(row: row)
      }
  }
}

test fn the_disposition_survives_the_round_trip_for_every_terminal_shape() -> Bool {
  let rows = every_shape()
  let readback = readback_rows_of(text: rendered_text(rows: rows))
  readback.length() == rows.length()
    && rows.length() == 17
    && filter(rows, r => !disposition_survives(row: r)).length() == 0
}

// AN UNWIND IS NOT A VERDICT, AND NEITHER EXPECTATION MAY LAUNDER IT INTO ONE.
//
// The round trip above establishes that a `Panicked` row survives the file. This asserts what the
// row MEANS on both sides of the expectation axis, which is the pair that a collapsed arm would
// have got wrong in opposite directions: unenrolled, a panic must not read as `Passed`; enrolled
// as expected-red, it must not read as `KnownRedHeld`. `Held` asserts the claim RAN AND FAILED as
// predicted, and a claim whose host unwound produced no verdict to agree with -- the same rule
// this floor already applies to a runtime error, a budget interruption, an unresolved host tool
// and a route gap. The RED is authorable in both directions here: swap either arm of
// `claim_disposition` to `Passed` or `KnownRedHeld` and exactly one conjunct below goes false.
test fn a_panicked_claim_is_neither_a_pass_nor_a_held_red() -> Bool {
  let unenrolled = ClaimTerminalRow {
    identity: ident(f: "unwound"),
    expectation: ExpectedToHold,
    terminal: Panicked { payload: "attempt to subtract with overflow" }
  }
  let enrolled = ClaimTerminalRow {
    identity: ident(f: "unwound_while_enrolled"),
    expectation: ExpectedRed,
    terminal: Panicked { payload: "attempt to subtract with overflow" }
  }
  claim_disposition(row: unenrolled) == PanickedBeforeVerdict
    && claim_disposition(row: enrolled) == PanickedBeforeVerdict
    && claim_disposition(row: unenrolled) != Passed
    && claim_disposition(row: enrolled) != KnownRedHeld
}

// A CLAIM THE FOLD NEVER REACHED IS NOT A CLAIM THAT PASSED, AND NOT ONE THE FLOOR DECLINED.
//
// This is the arm that keeps a stopped fold from publishing as a short ledger. Every planned
// identity behind the unwind gets a row naming the identity that stopped the line, so the reader
// joins on the population it planned rather than on the prefix that ran. The RED: collapse this
// arm into any other disposition and the first conjunct goes false; drop `halted_by` from the
// detail field and the last one does, which is what makes the consequence traceable to its cause
// in the published file rather than only in a log line the artifact does not carry.
test fn a_claim_the_abort_never_reached_names_what_stopped_the_line() -> Bool {
  let row = ClaimTerminalRow {
    identity: ident(f: "behind_the_unwind"),
    expectation: ExpectedToHold,
    terminal: NotAttempted { halted_by: "example.unwound" }
  }
  claim_disposition(row: row) == NotAttemptedAfterAbort
    && claim_disposition(row: row) != Passed
    && render_terminal_tag(terminal: NotAttempted { halted_by: "example.unwound" }) == "not-attempted"
    && render_terminal_detail(terminal: NotAttempted { halted_by: "example.unwound" })
      == "example.unwound"
}

// THE PAYLOAD IS THE DETAIL FIELD, NOT THE TAG. A panic's message is the only thing that names
// WHERE the host came apart, so collapsing it into the tag would make every unwind in the corpus
// render as one indistinguishable row -- the state-space conflation the tag/detail split exists
// to prevent, arriving through the newest arm.
test fn a_panic_renders_as_its_own_tag_carrying_the_payload_as_detail() -> Bool {
  let terminal = Panicked { payload: "index out of bounds: the len is 0 but the index is 0" }
  render_terminal_tag(terminal: terminal) == "panicked"
    && render_terminal_detail(terminal: terminal)
      == "index out of bounds: the len is 0 but the index is 0"
    && render_disposition(disposition: PanickedBeforeVerdict) == "panicked-before-verdict"
}

// A COUNT CANNOT SEE AN EDITED ROW, AND THE DIGEST CAN. Same shape as the ledger's own
// load-bearing case one layer up: the file's row count is untouched, one row's identity is not.
test fn the_digest_catches_an_edited_row_while_the_count_stays_equal() -> Bool {
  let honest = rendered_text(rows: [passing_row(f: "a"), passing_row(f: "b")])
  let tampered = honest.replace(pattern: "example.b", replacement: "example.z")
  honest.split(delimiter: "\n").length() == tampered.split(delimiter: "\n").length()
    && readback_digest_agrees(readback: parse_ledger(text: honest))
    && !readback_digest_agrees(readback: parse_ledger(text: tampered))
}

// THE FOOTER IS COMPARED TO THE PLANNED POPULATION, NEVER TO THE ROWS THE READER PARSED.
// A truncation that also rewrote the footer agrees with itself; it does not agree with the
// roster the caller already holds.
test fn a_truncated_ledger_with_a_consistent_footer_still_fails_the_planned_count() -> Bool {
  let three = [passing_row(f: "a"), passing_row(f: "b"), passing_row(f: "c")]
  let short = rendered_text(rows: [passing_row(f: "a"), passing_row(f: "b")])
  readback_footer_count_agrees(readback: parse_ledger(text: short), planned_rows: 2)
    && !readback_footer_count_agrees(readback: parse_ledger(text: short), planned_rows: three.length())
}

fn route_gap_tag_reads_back(tag: String) -> Bool {
  match readback_disposition(row: LedgerReadbackRow {
    qualified: "test.claim.x.y",
    expectation: ExpectedToHold,
    terminal_tag: tag,
    terminal_detail: "Dir"
  }) {
    Absent => false
    Present { value: d } =>
      match d { RouteGapBeforeVerdict => true  _ => false }
  }
}

// THE WIDENED ROUTE-GAP ARM SURVIVES THE ROUND TRIP IN BOTH DIRECTIONS, AND THE THREE GROUNDS DO
// NOT COLLIDE. Rendering picks a distinct tag per ground and carries the operation as the detail;
// reading back recovers `RouteGapBeforeVerdict` from each. Before the widening these three were one
// tag with one string, so a reader could not tell an unpublished mock case from a filesystem
// removal -- two grounds whose remedies are "record the case" and "give the operation a hermetic
// arm", which send a maintainer to different files.
//
// THE DISCRIMINATING HALF IS THE TAG INEQUALITY. Without it this witness would pass over an
// implementation that rendered all three grounds to one tag and read them all back to the same
// disposition -- which is precisely the collapse being removed, and it would have looked green.
test fn the_three_route_gap_grounds_render_apart_and_read_back_to_one_disposition() -> Bool {
  let unpublished = RouteGap { operation: "Dir", ground: UnpublishedMockCase {} }
  let no_response = RouteGap { operation: "Dir", ground: NoMockResponse {} }
  let removal = RouteGap { operation: "Dir", ground: FilesystemRemoval {} }
  let t_unpublished = render_terminal_tag(terminal: unpublished)
  let t_no_response = render_terminal_tag(terminal: no_response)
  let t_removal = render_terminal_tag(terminal: removal)
  t_unpublished != t_no_response
    && t_no_response != t_removal
    && t_unpublished != t_removal
    && route_gap_tag_reads_back(tag: t_unpublished)
    && route_gap_tag_reads_back(tag: t_no_response)
    && route_gap_tag_reads_back(tag: t_removal)
    && render_terminal_detail(terminal: no_response) == "Dir"
}

// A FIELD CARRYING THE SEPARATOR IS REFUSED, NOT SANITIZED. The neighbouring disposition writer
// replaces tabs with spaces, which publishes a different fact than the one observed.
test fn a_field_carrying_the_separator_makes_the_ledger_unrenderable() -> Bool {
  let poisoned = ClaimTerminalRow {
    identity: ident(f: "a"),
    expectation: ExpectedToHold,
    terminal: RouteGap { operation: "shell\tinjected", ground: NoMockResponse {} }
  }
  match render_ledger(binding: binding(), rows: [poisoned]) {
    LedgerRendered { text: _ } => false
    LedgerUnrenderable { reason: r, offending: _, diagnosis: _ } => r == "field-carries-separator"
  }
}

// ONE UNREADABLE LINE REFUSES THE WHOLE FILE. Returning the lines that did parse would report a
// truncated population as a complete one, and the reconciliation would then blame the run for
// losing claims it actually executed -- the empty-observation narrow, at the reader.
test fn one_unparseable_line_refuses_the_whole_file() -> Bool {
  let honest = rendered_text(rows: [passing_row(f: "a"), passing_row(f: "b")])
  let damaged = honest.replace(pattern: "example.b\texpect-hold", replacement: "example.b")
  readback_rows_of(text: honest).length() == 2
    && match parse_ledger(text: damaged) {
         LedgerRead {
           repository_snapshot: _,
           prepared_subject: _,
           roster_identity: _,
           rows: _,
           footer_row_count_wire: _,
           footer_digest: _
         } => false
         LedgerUnreadable { reason: r, at: _ } => r == "ledger-row-unparseable"
       }
}

// A FOREIGN FORMAT REFUSES RATHER THAN BEING READ AS AN EMPTY LEDGER.
test fn a_ledger_in_an_unrecognized_format_is_unreadable_not_empty() -> Bool {
  match parse_ledger(text: "some-other-thing/9\ta\tb\tc\n#end\t0\t0000000000000000") {
    LedgerRead {
      repository_snapshot: _,
      prepared_subject: _,
      roster_identity: _,
      rows: _,
      footer_row_count_wire: _,
      footer_digest: _
    } => false
    LedgerUnreadable { reason: r, at: _ } => r == "ledger-format-unrecognized"
  }
}

// THE SEED-FACING RENDERER AND THE TYPED ONE MUST PRODUCE THE SAME BYTES, or the module has two
// renderers and the artifact has no single author. Asserted over EVERY terminal shape.
fn seed_row_of(row: ClaimTerminalRow) -> SeedLedgerRow {
  SeedLedgerRow {
    qualified: witness_identity_qualified_name(identity: row.identity),
    expectation_wire: render_expectation(expectation: row.expectation),
    terminal_tag: render_terminal_tag(terminal: row.terminal),
    terminal_detail: render_terminal_detail(terminal: row.terminal),
    seed_disposition_wire: render_disposition(disposition: claim_disposition(row: row))
  }
}

fn seed_rendered_text(rows: List<ClaimTerminalRow>) -> String {
  match render_ledger_from_seed(
    repository_snapshot: "1234567890abcdef1234567890abcdef12345678",
    prepared_subject: "0000000000000002",
    rows: map(rows, r => seed_row_of(row: r))
  ) {
    LedgerUnrenderable { reason: _, offending: _, diagnosis: _ } => ""
    LedgerRendered { text: t } => t
  }
}

test fn the_seed_facing_renderer_produces_the_same_bytes_as_the_typed_one() -> Bool {
  let rows = every_shape()
  let typed = rendered_text(rows: rows)
  typed != "" && seed_rendered_text(rows: rows) == typed
}

// THE MIRROR COMPARATOR'S DISCRIMINATING RED. The seed's disposition and this module's are two
// INDEPENDENT derivations of one fact; a row where they disagree must stop the line rather than
// publish whichever one the writer happened to send.
test fn a_seed_row_whose_disposition_disagrees_with_its_tag_refuses() -> Bool {
  let honest = seed_row_of(row: passing_row(f: "a"))
  let lying = SeedLedgerRow {
    qualified: honest.qualified,
    expectation_wire: honest.expectation_wire,
    terminal_tag: honest.terminal_tag,
    terminal_detail: honest.terminal_detail,
    seed_disposition_wire: "failed"
  }
  match render_ledger_from_seed(
    repository_snapshot: "1234567890abcdef1234567890abcdef12345678",
    prepared_subject: "0000000000000002",
    rows: [honest, lying]
  ) {
    LedgerRendered { text: _ } => false
    LedgerUnrenderable { reason: r, offending: o, diagnosis: _ } =>
      r == "seed-disposition-disagrees" && o == honest.qualified
  }
}

// A SEED BUILT AGAINST A VOCABULARY THIS MODULE DOES NOT KNOW CANNOT PUBLISH. It refuses rather
// than rendering a row whose meaning the reader would derive differently.
test fn a_seed_row_with_an_unknown_terminal_tag_refuses() -> Bool {
  let honest = seed_row_of(row: passing_row(f: "a"))
  let futuristic = SeedLedgerRow {
    qualified: honest.qualified,
    expectation_wire: honest.expectation_wire,
    terminal_tag: "returned-superposed",
    terminal_detail: "",
    seed_disposition_wire: "passed"
  }
  match render_ledger_from_seed(
    repository_snapshot: "1234567890abcdef1234567890abcdef12345678",
    prepared_subject: "0000000000000002",
    rows: [futuristic]
  ) {
    LedgerRendered { text: _ } => false
    LedgerUnrenderable { reason: r, offending: _, diagnosis: _ } => r == "seed-terminal-tag-unrecognized"
  }
}

// THE DIAGNOSIS SURVIVES THE REFUSAL, AND CANNOT BE READ AS A LEDGER.
//
// A refusal that named one identity and destroyed the file would take the other rows with it --
// the only rows that say whether the defect is isolated to one arm or spans a whole terminal
// shape. So the rows survive under a format token `parse_ledger` refuses, which makes "a partial
// file cited as a ledger" unspellable rather than forbidden by a convention.
//
// WHAT THE ASSERTION LINES CHECK, in order: every row survives: header + refusal line + three rows
//   ... and it is not a ledger: reading it back refuses on the format, not on its contents
test fn a_refused_ledger_keeps_every_row_as_a_diagnosis_that_cannot_parse_as_a_ledger() -> Bool {
  let honest = seed_row_of(row: passing_row(f: "a"))
  let other = seed_row_of(row: passing_row(f: "b"))
  let lying = SeedLedgerRow {
    qualified: "test.claim.example.c",
    expectation_wire: honest.expectation_wire,
    terminal_tag: honest.terminal_tag,
    terminal_detail: honest.terminal_detail,
    seed_disposition_wire: "failed"
  }
  match render_ledger_from_seed(
    repository_snapshot: "1234567890abcdef1234567890abcdef12345678",
    prepared_subject: "0000000000000002",
    rows: [honest, other, lying]
  ) {
    LedgerRendered { text: _ } => false
    LedgerUnrenderable { reason: r, offending: o, diagnosis: d } =>
      r == "seed-disposition-disagrees"
        && o == "test.claim.example.c"
        && d.split(delimiter: "\n").length() == 5
        && d.split(delimiter: "\t3").length() == 2
        && d.split(delimiter: "test.claim.example.a").length() == 2
        && d.split(delimiter: "test.claim.example.b").length() == 2
        && d.split(delimiter: "test.claim.example.c").length() == 3
        && match parse_ledger(text: d) {
             LedgerRead {
               repository_snapshot: _,
               prepared_subject: _,
               roster_identity: _,
               rows: _,
               footer_row_count_wire: _,
               footer_digest: _
             } => false
             LedgerUnreadable { reason: pr, at: _ } => pr == "ledger-format-unrecognized"
           }
  }
}

// A ROW CARRYING A NEWLINE CANNOT FORGE THE DIAGNOSIS'S LINE STRUCTURE UNDETECTED.
//
// Nothing parses this file, so the victim would be a person: a row whose detail carries a
// newline appears as two lines, and one crafted to carry `#refused …` after that newline would
// show a diagnostician a refusal reason nobody wrote. The refusal line states how many rows
// follow it, so observed-lines against stated-count is a self-check written by the same fold
// that writes the rows -- the forgery is visible without escaping the bytes a diagnostician
// needs to see raw.
//
// WHAT THE ASSERTION LINES CHECK, in order: the refusal line says 2 rows follow
//   ... but header + refusal + 2 rows would be 4 lines, and the forged newline makes 5
//   ... so a reader comparing stated rows to observed lines sees the discrepancy
test fn a_row_carrying_a_newline_is_detectable_against_the_stated_row_count() -> Bool {
  let honest = seed_row_of(row: passing_row(f: "a"))
  let forger = SeedLedgerRow {
    qualified: "test.claim.example.c",
    expectation_wire: honest.expectation_wire,
    terminal_tag: honest.terminal_tag,
    terminal_detail: "innocent\n#refused\tfabricated-reason\ttest.claim.example.a\t1",
    seed_disposition_wire: "failed"
  }
  match render_ledger_from_seed(
    repository_snapshot: "1234567890abcdef1234567890abcdef12345678",
    prepared_subject: "0000000000000002",
    rows: [honest, forger]
  ) {
    LedgerRendered { text: _ } => false
    LedgerUnrenderable { reason: _, offending: _, diagnosis: d } =>
      d.split(delimiter: "\t2").length() == 2
      && d.split(delimiter: "\n").length() == 5
      && d.split(delimiter: "\n").length() != 4
  }
}

// AN UNPUBLISHED SNAPSHOT IS A SHAPE, NOT A MAGIC STRING, and an unrecognised one REFUSES rather
// than being read as unpublished -- a typo'd commit id must not silently downgrade
// candidate-bound evidence to unbound evidence.
test fn an_unpublished_run_is_a_shape_and_an_unrecognized_snapshot_refuses() -> Bool {
  let rows = [seed_row_of(row: passing_row(f: "a"))]
  let unpublished = match render_ledger_from_seed(
    repository_snapshot: "unpublished",
    prepared_subject: "0000000000000002",
    rows: rows
  ) {
    LedgerUnrenderable { reason: _, offending: _, diagnosis: _ } => false
    LedgerRendered { text: t } => t.split(delimiter: "unpublished").length() == 2
  }
  let garbage = match render_ledger_from_seed(
    repository_snapshot: "not-a-commit",
    prepared_subject: "0000000000000002",
    rows: rows
  ) {
    LedgerRendered { text: _ } => false
    LedgerUnrenderable { reason: r, offending: o, diagnosis: _ } =>
      r == "seed-repository-snapshot-unrecognized" && o == "not-a-commit"
  }
  unpublished && garbage
    && ledger_is_candidate_bound(binding: binding())
    && !ledger_is_candidate_bound(binding: LedgerBinding {
         repository_snapshot: UnpublishedWorkingTree,
         prepared_subject: structural_content_hash(digest: "0000000000000002")
       })
}
