module v2.workflow.floor_eval_step_calibration

import v2.std.logic { Bool }
import v2.std.integer { Int, int_add, int_mul, int_ge, int_eq }
import std.measure {
  Millisecond, millisecond, millisecond_count,
  EvalStepCount, eval_step_count, eval_step_count_value,
  EvalStepsPerMillisecond, eval_steps_per_millisecond, eval_steps_per_millisecond_count,
}
import std.types { NonEmptyStr }

// THE CONTROLLED FIXTURE THAT GROUNDS THE REQUIRED FLOOR'S EVAL-STEP CEILINGS.
//
// WHY THIS MODULE EXISTS AT ALL. `v2.workflow.required_floor` declares, as POLICY, how much work
// one required claim may perform. The policy is stated in milliseconds of ordinary interpreted
// evaluation, because that is the unit every operator ruling over this ceiling has been written in.
// The floor MEASURES eval steps. Something must carry the conversion, and the only honest place to
// take it is a specimen whose work is fixed by source rather than by the corpus.
//
// WHAT IT IS NOT, STATED FIRST BECAUSE IT IS THE FAILURE THIS FILE EXISTS TO AVOID. It is not a
// measurement of the live floor population. DESIGN section 5 rules that a merge-blocking literal
// grounded in a measurement of the same current tree is a change detector rather than an oracle,
// and every prior raise of this family of ceilings failed exactly there. The specimen is a fixture:
// its recursion depth is a literal in
// `test.claim.floor_eval_step_calibration_specimen_test`, so its step count is a property of that
// file, reproducible on any host, in any run, at any corpus size.
//
// THE TWO HALVES ARE OF DIFFERENT KINDS AND ARE CARRIED SEPARATELY.
//
//   `specimen_eval_steps` is DETERMINISTIC, AND THAT IS MEASURED ACROSS ARCHITECTURES RATHER THAN
//   ASSUMED. At its previous depth the specimen returned an identical 110,011 on five executions
//   spanning an aarch64 authoring container and a linux/amd64 CI runner, under every level of load.
//   It is not an environmental reading and is not a bet.
//
//   `rate_sample_cpu_ms` is ENVIRONMENTAL, and the whole reason this change exists is that such
//   readings drift. It is recorded as the SLOWEST reading of the declared sample, never the mean and
//   never the fastest: a slower specimen yields FEWER steps per millisecond, which makes the derived
//   ceilings TIGHTER. The fail-closed direction is deliberate, so drift in the calibration host
//   cannot silently widen what a claim may spend.
//
//   IT BELONGS TO THE RATE SAMPLE AND NOT TO THE CURRENT SPECIMEN, which is why it is a function
//   beside `rate_sample_eval_steps` rather than a field of the row. A `specimen_cpu` field carried
//   the depth-10000 sample's 152ms under a name promising the depth-5000 specimen's -- one field
//   naming two subjects, read by nothing (review 5190625335). Deleting it was the repair; a field
//   that lies and has no consumer is a DESIGN section 3c dangler twice over.
//
//   "SLOWEST" MEANS SLOWEST WITHIN THE DECLARED SAMPLE, NOT SLOWEST EVER OBSERVED, and that
//   distinction is the difference between a pin and a ratchet. A row that re-pins whenever a slower
//   reading arrives is a measurement of the current environment wearing a pin's name; it would
//   drift upward forever on a fleet whose CPU readings drift, and automating its update would
//   collapse it to `measure() == measure()` -- DESIGN section 5's oracle defect, and the exact
//   shape of the two repudiated ceiling raises this file's consumer records.
//
// RE-PINNING IS A DELIBERATE ACT, NOT MAINTENANCE. It happens when a grounding check goes red, or
// when the specimen changes, and it is taken by re-running the named instrument rather than by
// adopting whatever the last floor run reported.
//
// THERE ARE TWO GROUNDING CHECKS AND THEY WATCH DIFFERENT FAILURES, which is worth stating because
// an earlier revision of this header claimed one check covered both and that sentence was false
// (review 5190625335). `eval_step_rate_grounding` proves the pinned rate is the floored ratio of its
// own sample; every figure it compares lives in this file, so it catches an inconsistent edit and
// NOT host drift. `specimen_steps_grounding` joins the declared `specimen_eval_steps` to the step
// count the floor OBSERVED for that identity, so it catches the specimen moving underneath the row --
// the depth change this file warns about two paragraphs down. The second is the one with an
// independent referent, and it is INSTRUMENT-GRADE: its input is a published artifact, so it runs
// when re-pinning rather than blocking a merge. The re-pin protocol below names the invocation, so
// "when it runs" is a step someone performs and not an aspiration.
//
// THAT GAP IS A NEXT-RUNG TRIGGER AND NOT A SECTION 4b(3) DROP, and the distinction is not
// bookkeeping. A drop declares that a guarantee which USED TO HOLD no longer does; this check did
// not exist before, so nothing regressed and there is no previous rung to name. Declaring a drop
// here would enter a loss the corpus never suffered and put a restoration trigger on a capability
// that was never lost -- rung dishonesty in the direction that flatters, since it would make the
// ladder read as though the merge path had once carried this join.
//
// THE TRIGGER, NAMING THE CAPABILITY RATHER THAN AN ARTIFACT: a required claim can consume a
// PUBLISHED PER-CLAIM OBSERVATION BY IDENTITY from a prior run on the acceptance path. That is what
// would let this join run as a witness, and it is strictly more than "a witness that reads a file" --
// the observation has to be addressable by claim identity and available to the claim that needs it,
// which is the same capability several other floor readings want and none of them has. Until it
// exists, the highest honest rung for this join is the instrument, and the ceiling is stated here
// rather than left as an unexplained absence.
//
// WHAT THE CONVERSION DOES AND DOES NOT CLAIM. It claims that one millisecond of PURE INTERPRETED
// EVALUATION on the named host is about this many eval steps. It does NOT claim every step in the
// corpus costs the same: a claim whose time accrues inside an opaque host operation accumulates
// milliseconds without accumulating steps at all, which is the population
// `v2.workflow.required_floor` `opaque_host_call_grandfather_population` already declares a section
// 4b drop over. This module's own measurement history contains a second instance of that gap -- see
// the three-spelling note in `v2.workflow.floor_grandfathered_roster`, where a map-backed
// membership fold cost 400x the CPU at a LOWER step count. The conversion is sound for the quantity
// the ceilings gate -- interpreted work -- and says nothing about host-realized cost, which is the
// CPU clock's subject and is published as an observation rather than gated.

// BOTH QUANTITIES ARE CARRIED, AND NEITHER IS A BARE SCALAR ANY MORE. `specimen_eval_steps` is a
// `std.measure` `EvalStepCount` on the Count axis; `steps_per_ms` is an `EvalStepsPerMillisecond` on
// the Frequency axis. A tracked gap stood here declaring both un-typeable, then narrowed to declare
// the rate alone un-typeable, and BOTH claims were false for the same reason (reviews 65462 and
// 65512): the roster already carried sibling aliases for each shape, added by their own consumers'
// lanes, and this file cited one of those very siblings as proof the thing could not be done.
//
// SO THE ROW IS DELETED RATHER THAN NARROWED A SECOND TIME. A dissolution condition records how
// admitted debt ends; when the debt turns out never to have existed, the honest act is to remove the
// row, not to keep it alive around a smaller false claim. What is worth keeping is the lesson, which
// is why it is written here and not in a ledger: the reflex that produced two wrong gaps was to
// reason about the authority instead of reading it (DESIGN section 4d -- do not over-generalize a
// prohibition; the cost is the thing you never did, and the failure looks like rigor).
type EvalStepCalibration = PinnedSpecimenCalibration {
  specimen: NonEmptyStr
  instrument: NonEmptyStr
  host: NonEmptyStr
  readings: Int
  specimen_eval_steps: EvalStepCount
  steps_per_ms: EvalStepsPerMillisecond
}

// IT IS A PINNED POLICY CONSTANT, AND THAT IS ITS STANDING RATHER THAN A HEDGE (ruling:
// fierce-lark-661, 2026-09-13, on gunbc#11195). `gunbc.rung_drop`
// `floor_cost_claim_qualification_unavailable` forbids translating the CPU line into steps using the
// measured CPU distribution. That prohibition targets the PER-CLAIM distribution -- the run-varying,
// position-sensitive quantity the row exists to declare -- and this row is not it. The discriminator
// is DEPENDENCE, not unit: this figure depends on one controlled fixture measured once, so an error
// in it mis-scales BOTH tiers ONCE AND UNIFORMLY and cannot make one claim's verdict differ between
// two runs of the same tree. That last property is the entire purchase of the denominator change,
// and a budget drawn from the live CPU distribution would give it straight back.
//
// SO A RE-PIN RESCALES EVERY BUDGET UNIFORMLY AND NEVER ONE CLAIM. There is no per-claim, per-runner
// or per-tier adjustment reachable through this row; per-runner normalisation is refused by name in
// the brief this lane was built under, and the shape of this constant is what makes it unreachable
// rather than merely unwritten.
//
// THE RE-PIN PROTOCOL, so the act is repeatable and its inputs are named: run `instrument` on the
// specimen named by `specimen`, on the machine that runs the floor, enough times to see the spread;
// take the SLOWEST reading in that sample (never the mean, never the fastest, and never "slowest
// ever seen" -- see the pin-versus-ratchet note above); recompute the floored ratio; update
// `rate_sample_eval_steps`, `rate_sample_cpu_ms` and `steps_per_ms` TOGETHER, since the grounding
// check below relates exactly those three. THEN RUN THE SPECIMEN JOIN, which is the step that
// catches the specimen having moved rather than the rate having drifted:
//
//   gh run download <run-id> -n required-floor-claim-cost -D <dir>/<run-id>
//   gunbc run --source-root dag --source-root src/v2 \
//     --entry dag/gunbc/instruments/floor_cost_distribution_instrument.dag \
//     --function calibration_specimen_grounding --arg root=<dir> --arg run=<run-id>
//
// A re-pin is not complete until that exits clean: the rate check can agree with itself while the
// specimen underneath it has changed depth, which is the whole reason the second check exists. The sample standing today is recorded in `host` by
// runner class, CPU and steps: its two CI readings were 138ms then 152ms at an identical 110,011
// steps, and THAT ~10% SPREAD IS THE BAND -- the same band that makes a CPU ceiling refuse on runner
// noise, recorded here as the reason the pin takes the slow end.
//
// THE PINNED READING. `instrument` names the producer that re-derives both figures rather than
// transcribing a run id beside them (DESIGN section 6: name the instrument). Re-deriving this row
// is one command over one entry; it does not require a floor run, a CI run, or the corpus.
//
// THE RATE WAS MEASURED AT A LARGER SPECIMEN DEPTH THAN THE ONE STANDING TODAY, and that is
// recorded rather than smoothed over because a reader who checks 55,011 against 152ms will get a
// different number. The specimen was 110,011 steps when the CI readings were taken; it was then
// REDUCED so that it sits under the new-witness ceiling this calibration itself derives -- a
// measuring stick exempt from the tier it defines is the escape hatch DESIGN section 5 forbids, and
// grandfathering would have granted exactly that exemption.
//
// THE RATE SURVIVES THE REDUCTION BECAUSE IT IS A PROPERTY OF THE MACHINE, NOT OF THE DEPTH, and
// that is verified rather than asserted: on the authoring host the same specimen measured 1000
// steps/ms at depth 10000 (110,011 / 110ms) and 965 steps/ms at depth 5000 (55,011 / 57ms), a 3.5%
// spread that is reading noise at this scale. The pinned 723 is the CI figure (110,011 / 152ms),
// chosen over the authoring host's because CI is the machine that runs the floor and is the slower
// of the two -- pinning the faster host would have loosened every derived ceiling by a third.
data floor_eval_step_calibration: EvalStepCalibration = PinnedSpecimenCalibration {
  specimen: "test.claim.floor_eval_step_calibration_specimen_test.calibration_specimen_performs_its_declared_work" as NonEmptyStr,
  instrument: "claim_batch --source-root dag --source-root src/v2 --entry dag/test/claim/floor_eval_step_calibration_specimen_test.dag --function calibration_specimen_performs_its_declared_work, read from its [witness] line (cpu=..ms eval_steps=..)" as NonEmptyStr,
  host: "RATE SAMPLE, taken at specimen depth 10000 (110,011 eval_steps): authoring container, linux aarch64, three executions at cpu=97ms, 110ms, 110ms; self-hosted CI runner, linux amd64, under the required floor's own fold, cpu=138ms then 152ms. All five returned an IDENTICAL eval_steps of 110011. The pinned rate is 110011/152 floored, the slowest reading from the machine that runs the floor. CURRENT SPECIMEN is depth 5000 (55,011 eval_steps, authoring host 56ms/57ms), reduced so it sits under the new-witness ceiling it helps derive" as NonEmptyStr,
  readings: 5,
  specimen_eval_steps: eval_step_count(count: 55011),
  steps_per_ms: eval_steps_per_millisecond(count: 723),
}

// THE CONVERSION, AND THE ONLY ARITHMETIC IN THIS FILE THAT A BUDGET DEPENDS ON.
//
// IT IS A MULTIPLICATION, NEVER A DIVISION, and that is a fail-closed choice rather than a
// convenience. `int_div` is partial -- it returns an `Outcome` and takes a `Locus` -- so deriving a
// budget by dividing would thread a refusal through every policy caller, or invite an `unwrap` that
// fabricates a figure when the calibration is degenerate. Pinning the RATE and multiplying keeps
// the derivation total, and moves the division to one place: the grounding check below, which
// proves the pinned rate really is the floor of the measured ratio, by cross-multiplication.
//
// THE POLICY INPUT IS MILLISECONDS OF WORK and the output is eval steps. Both tiers call this: the
// grandfathered ceiling passes 500, the new-witness ceiling passes 100. Neither budget is a literal
// anywhere, so the two cannot drift apart or be raised independently of the policy they project.
fn eval_step_budget_for(calibration: EvalStepCalibration, envelope: Millisecond) -> EvalStepCount {
  eval_step_count(
    count: int_mul(a: millisecond_count(m: envelope), b: calibration_rate(calibration: calibration)),
  )
}

// THE ONE ACCESSOR, so every consumer reaches the rate through a match on the carrier rather than
// by field access that would bind a second spelling of the same read.
fn calibration_rate(calibration: EvalStepCalibration) -> Int {
  match calibration {
    PinnedSpecimenCalibration {
      specimen: _, instrument: _, host: _, readings: _,
      specimen_eval_steps: _, steps_per_ms: r,
    } => eval_steps_per_millisecond_count(r: r)
  }
}

fn calibration_specimen_eval_steps(calibration: EvalStepCalibration) -> EvalStepCount {
  match calibration {
    PinnedSpecimenCalibration {
      specimen: _, instrument: _, host: _, readings: _,
      specimen_eval_steps: st, steps_per_ms: _,
    } => st
  }
}

fn calibration_specimen_identity(calibration: EvalStepCalibration) -> NonEmptyStr {
  match calibration {
    PinnedSpecimenCalibration {
      specimen: sp, instrument: _, host: _, readings: _,
      specimen_eval_steps: _, steps_per_ms: _,
    } => sp
  }
}

// THE SECOND GROUNDING, AND THE ONE THAT CAN RED FROM SOMETHING OTHER THAN THIS FILE (review
// 5190625335, adopted). `eval_step_rate_grounding` below compares three literals that all live
// here, so it reds only when an author edits one of them inconsistently -- real, but it cannot see
// the failure the module header warns about, which is the SPECIMEN moving underneath the row. Change
// `calibration_specimen_depth` to 9000 and every derived ceiling silently rescales while all three
// literals still agree with each other.
//
// THE REPAIR IS A JOIN, NOT A NARROWER SENTENCE. The floor executes the specimen as a required claim
// and publishes its `eval_steps` by identity, so the declared `specimen_eval_steps` has an
// INDEPENDENT REFERENT -- exactly what DESIGN section 5 demands of a literal that gates. This is the
// consumer of `calibration_specimen_eval_steps` and of `calibration_specimen_identity`.
//
// ITS REFERENT IS AN ARTIFACT, SO ITS EXECUTING HOME IS AN INSTRUMENT AND NOT A WITNESS, and that is
// stated rather than glossed: a required claim cannot read its own step count, and the cost artifact
// exists only after the run that produced it. `tools.floor_cost_distribution_instrument`
// `calibration_specimen_grounding_report` is the executing consumer; the witness below exercises
// both arms of this classifier on fixture readings. The gap between the two is the honest one --
// this join is INSTRUMENT-GRADE, run when re-pinning, not a gate that blocks a merge.
type SpecimenStepsGrounding =
    SpecimenStepsMatchThePin
  | SpecimenStepsDiffer { declared_steps: Int, observed_steps: Int }

fn specimen_steps_grounding(calibration: EvalStepCalibration, observed_eval_steps: Int) -> SpecimenStepsGrounding {
  let declared = eval_step_count_value(s: calibration_specimen_eval_steps(calibration: calibration))
  if int_eq(a: declared, b: observed_eval_steps) {
    SpecimenStepsMatchThePin {}
  } else {
    SpecimenStepsDiffer { declared_steps: declared, observed_steps: observed_eval_steps }
  }
}

// A DIFFERENCE REFUSES IN EITHER DIRECTION. There is no tolerance band and there must not be one:
// the specimen's step count is DETERMINISTIC by construction -- identical across architectures and
// load -- so any difference at all is the specimen having moved, not noise. A band here would be the
// absorbing fallback DESIGN section 5 forbids, sized to hide precisely the drift being watched for.
fn specimen_steps_grounding_holds(grounding: SpecimenStepsGrounding) -> Bool {
  match grounding {
    SpecimenStepsMatchThePin => true
    SpecimenStepsDiffer { declared_steps: _, observed_steps: _ } => false
  }
}

// THE GROUNDING VERDICT, AS A CLOSED COPRODUCT RATHER THAN A BOOL.
//
// The pinned `steps_per_ms` is the one figure in this file that could silently stop describing the
// specimen it claims to come from, so it is the one figure with an executing check. The check is
// that the rate is the FLOOR of the measured ratio: rate*cpu <= steps, and (rate+1)*cpu > steps.
// Cross-multiplication is used instead of division for the same reason the conversion above is a
// multiplication.
//
// BOTH REFUSING ARMS ARE AUTHORABLE, which is what keeps this from being a decoration permanently
// green by construction (DESIGN section 4b: ask whether the RED is authorable before writing the
// check). A rate above the ratio overstates how much work a millisecond buys and loosens every
// ceiling; a rate below it understates and tightens them. Both carry the two products so a reader
// of a refusal sees what was compared.
type EvalStepRateGrounding =
    RateIsTheFlooredRatio
  | RateAboveMeasuredRatio { rate_work: Int, measured_steps: Int }
  | RateBelowMeasuredRatio { rate_work: Int, measured_steps: Int }

fn eval_step_rate_grounding(calibration: EvalStepCalibration) -> EvalStepRateGrounding {
  classify_eval_step_rate(
    rate_work: int_mul(
      a: calibration_rate(calibration: calibration),
      b: millisecond_count(m: rate_sample_cpu_ms()),
    ),
    next_rate_work: int_mul(
      a: int_add(a: calibration_rate(calibration: calibration), b: 1),
      b: millisecond_count(m: rate_sample_cpu_ms()),
    ),
    measured_steps: eval_step_count_value(s: rate_sample_eval_steps()),
  )
}

// THE SAMPLE THE RATE WAS TAKEN FROM, NAMED SEPARATELY FROM THE CURRENT SPECIMEN because they are
// different facts and the row above says so in prose. A later author who shrinks or grows the
// specimen again changes `specimen_eval_steps`; these two move only when the RATE is re-pinned.
fn rate_sample_eval_steps() -> EvalStepCount {
  eval_step_count(count: 110011)
}

fn rate_sample_cpu_ms() -> Millisecond {
  millisecond(count: 152)
}

fn classify_eval_step_rate(rate_work: Int, next_rate_work: Int, measured_steps: Int) -> EvalStepRateGrounding {
  if int_ge(a: rate_work, b: int_add(a: measured_steps, b: 1)) {
    RateAboveMeasuredRatio { rate_work: rate_work, measured_steps: measured_steps }
  } else {
    if int_ge(a: measured_steps, b: next_rate_work) {
      RateBelowMeasuredRatio { rate_work: rate_work, measured_steps: measured_steps }
    } else {
      RateIsTheFlooredRatio {}
    }
  }
}

// A GROUNDING THAT IS NOT THE FLOORED RATIO REFUSES. There is no arm that reports the mismatch and
// proceeds: DESIGN section 5's failure arm must refuse rather than widen, and a ceiling whose
// conversion has drifted is a ceiling nobody can read the units of.
fn eval_step_rate_grounding_holds(grounding: EvalStepRateGrounding) -> Bool {
  match grounding {
    RateIsTheFlooredRatio => true
    RateAboveMeasuredRatio { rate_work: _, measured_steps: _ } => false
    RateBelowMeasuredRatio { rate_work: _, measured_steps: _ } => false
  }
}
