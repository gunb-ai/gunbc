module v2.workflow.phase_profile_proof_plan


data phase_profile_gate_entry: String = "dag/tools/floor_effect_gate_witness.dag"

fn phase_profile_proof_batches() -> List<List<std.realization_schedule.Runnable>> {
  [[
    std.realization_schedule.RunnableSingleClaim {
      entry: phase_profile_gate_entry,
      function: "extdeps_external_authority_gate_passes",
      profile: std.realization_schedule.runnable_resource_profile_negligible()
    }
  ]]
}

