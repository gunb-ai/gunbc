// v2/workflow/ci_floor_plan.dag — the CI floor as a dependency-ordered scheduler plan,
// DERIVED FROM `gunbc_ci_spec` (the single floor authority, DESIGN §3).
//
// This is the default CI runtime: `gunbc ci` (via `gunbc.ci_spec.gunbc_ci_run_script`)
// invokes `claim_executor --plan-entry … --plan-function gunbc_ci_floor_batches`, and
// the v2.workflow scheduler decides the batches. There is NO parallel hardcoded floor
// list — the gates come from `gunbc_ci_spec.gates`, the corpus roots/scan dirs from
// `gunbc.ci_layer_roots` (discovery roster is marker-driven, not hand-listed). The ONLY fact added here is the
// dependency TOPOLOGY: `DslCompileCleanGate` (whole-tree compile) is the fail-fast
// root, and every other gate + the discovery corpus sit in a later readiness layer
// behind it, so they run dependency-ordered and parallelize where independent
// (DESIGN §4/§5). Add a gate to the spec → it re-batches here with zero host change.
//
// HOME + bridge note (DESIGN §3/§6/§7). This file lives in the v2 tree because it
// REUSES the v2.workflow scheduler model (parallel_executor_plan_from_dependencies,
// over v2.std Node/DependencyView) — forking that scheduler into dsl would violate §3.
// The plan must also read the single-authority spec, which lives in dsl
// (`gunbc.ci_spec`); hence the `import gunbc.ci_spec` below is a v2→dsl bridge. It is
// safe today (no gate gunbc-compiles the v2 tree standalone — v2 is mid-§7 bootstrap
// and not yet self-compile-clean; the host always co-resolves `--source-root dsl
// --source-root src/v2` at run time). It canNOT live in dsl: a dsl file importing the
// v2 scheduler drags the not-yet-self-clean v2 tree into the `DslCompileCleanGate`,
// turning that load-bearing gate red. DISSOLUTION TRIGGER (§6): when v2 reaches
// self-compile-clean (§7), this bridge moves to host-mediated — claim_executor evals
// the dsl topology and the v2 scheduler separately, with no cross-tree module import.

module v2.workflow.ci_floor_plan

import gunbc.ci_layer_roots { witness_layer_roots, witness_discovery_scan_dirs }
import gunbc.ci_spec {
  gunbc_ci_spec, CiSpec,
  Gate, RustMonolithGate, EmitHostGate, LayeringImportsGate, ResolvedImportsGate,
  ExtdepsExternalAuthorityGate, DslCompileCleanGate, CiYamlGate,
  SourceRootIngestGate, CachePurityAuditGate
}
import v2.std.algebra { length, list_snoc_item }
import v2.std.collection { List }
import v2.std.dependency { DataDependsOn, ResourceDependsOn, DependencyView }
import v2.std.node { Atom, Node, TypeNode }
import v2.std.text { String }
import std.types { ContentHash, Int }
import std.measure { HardwareThreadCount, hardware_thread_count, byte_size }
import std.realization_width { width_fold_objective_goals, memory_aware_spawn_width }
import gunbc.ci_floor_measurement {
  gunbc_ci_floor_per_shard_peak_rss_bytes,
  gunbc_ci_floor_conservative_fallback_width
}
import extdeps.cpu.ampere { altra_max_m12830_catalog }
import std.realization_schedule {
  RealizationPlan,
  RealizationObjective,
  Runnable,
  RunnableSingleClaim,
  RunnableDiscoveryBatch,
  cost_account_predicted_zero,
  schedule_lens_verdict_for_ci_floor
}
import v2.workflow.executor {
  ExecutorBatch,
  ExecutorJob,
  ExecutorRunBlocked,
  ExecutorRunComplete,
  ExecutorRunRunnable,
  parallel_executor_plan_from_dependencies
}

// CI floor target digest (subgraph grain — dissolution: content_hash(floor_nodes)).
data ci_floor_target_digest: ContentHash = "gunbc-ci-floor-v1"

data ci_floor_compile_gate_fn: String = "dsl_compile_clean_gate_passes"

data floor_gate_witness_entry: String = "dsl/tools/floor_effect_gate_witness.dag"

data floor_source_root_ingest_gate_entry: String = "src/v2/workflow/source_root_ingest_gate.dag"

// The discovery-corpus node (one fixed identity).
data floor_corpus_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^gunbc_floor_corpus } },
  children: []
}

// Closed Gate enum → one fixed-identity Node each (no runtime symbol minting).
fn gate_node(g: Gate) -> Node {
  match g {
    RustMonolithGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_rust } }, children: [] }
    EmitHostGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_emit } }, children: [] }
    LayeringImportsGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_layering } }, children: [] }
    ResolvedImportsGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_resolved_imports } }, children: [] }
    ExtdepsExternalAuthorityGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_extdeps_external_authority } }, children: [] }
    DslCompileCleanGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_compile } }, children: [] }
    CiYamlGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_ciyaml } }, children: [] }
    SourceRootIngestGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_sourceingest } }, children: [] }
    CachePurityAuditGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_cache_purity } }, children: [] }
  }
}

// Gate → nullary Bool adapter (the single Gate→effect authority is
// tools.ci_gates.run_spec_gate, wrapped per gate in floor_effect_gate_witness).
fn gate_runnable(g: Gate) -> Runnable {
  match g {
    RustMonolithGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "rust_monolith_gate_passes" }
    EmitHostGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "emit_host_gate_passes" }
    LayeringImportsGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "layering_imports_gate_passes" }
    ResolvedImportsGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "resolved_imports_gate_passes" }
    ExtdepsExternalAuthorityGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "extdeps_external_authority_gate_passes" }
    DslCompileCleanGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "dsl_compile_clean_gate_passes" }
    CiYamlGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "ci_yaml_gate_passes" }
    SourceRootIngestGate => RunnableSingleClaim {
      entry: floor_source_root_ingest_gate_entry,
      function: "source_root_ingest_gate_passes"
    }
    CachePurityAuditGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "cache_purity_audit_gate_passes" }
  }
}

// The fail-fast root: the whole-tree compile-clean gate.
fn floor_compile_root_node() -> Node {
  gate_node(g: DslCompileCleanGate)
}

// ── corpus runnable fields, derived from ci_layer_roots (§3 single authority) ─
fn corpus_source_roots() -> List<String> {
  witness_layer_roots
}

fn corpus_runnable() -> Runnable {
  RunnableDiscoveryBatch {
    source_roots: corpus_source_roots(),
    scan_dirs: witness_discovery_scan_dirs,
    explicit_entries: [],
    skip_unaffected_node_frontier: true
  }
}

// ── nodes + dependency edges (the only NEW fact: compile-clean gates the rest) ─
fn floor_nodes(spec: CiSpec) -> List<Node> {
  fold(spec.gates, init: [floor_corpus_node], f: fn(acc, g) {
    list_snoc_item(xs: acc, item: gate_node(g: g))
  })
}

fn floor_depends_on_compile(dependent: Node) -> DependencyView {
  DependencyView {
    source: floor_compile_root_node(),
    dependent: dependent,
    kind: DataDependsOn,
    usage_site: dependent
  }
}

// ── heavy whole-tree resolves: at most one per readiness layer ───────────────
// A floor node is a "heavy resolve" when it resolves the whole co-rooted tree and so peaks at
// roughly one full corpus shard's memory. At the pinned floor width the corpus already runs
// `width` such resolves concurrently across its shards (saturating the fleet memory budget on
// the tightest host — the deterministic exit-137 evidence behind #5375). So a SECOND heavy
// resolve must NOT co-run in the corpus's readiness layer: removing run_walk's per-runnable
// width split (the host fix) lets the whole layer run at once, which would otherwise put
// source-root ingest next to the corpus and OOM. The compile-clean ROOT is a heavy resolve
// too but is the corpus's predecessor (runs alone in the first layer), so it never co-runs.
fn gate_is_heavy_resolve(g: Gate) -> Bool {
  match g {
    SourceRootIngestGate => true
    DslCompileCleanGate => true
    // The cache-purity audit resolves the whole discovery corpus TWICE (cold compute + warm
    // decode) per entry — a heavy whole-tree resolve, so it must run in its own readiness layer,
    // never co-running with the corpus or another heavy resolve (the #5375 OOM property).
    CachePurityAuditGate => true
    RustMonolithGate => false
    EmitHostGate => false
    LayeringImportsGate => false
    ResolvedImportsGate => false
    ExtdepsExternalAuthorityGate => false
    CiYamlGate => false
  }
}

fn floor_node_is_heavy_resolve(node: Node, spec: CiSpec) -> Bool {
  if node == floor_corpus_node {
    true
  } else {
    fold(spec.gates, init: false, f: fn(acc, g) {
      if node == gate_node(g: g) { gate_is_heavy_resolve(g: g) } else { acc }
    })
  }
}

// Resource-ordering edge: a heavy-resolve gate runs only after the corpus is scheduled, so the
// scheduler places it in a later readiness layer. ResourceDependsOn (a memory conflict, not a
// data dependency) — the scheduler's execution classifier orders on it (scheduler.dag).
fn floor_corpus_serializes(dependent: Node) -> DependencyView {
  DependencyView {
    source: floor_corpus_node,
    dependent: dependent,
    kind: ResourceDependsOn,
    usage_site: dependent
  }
}

// Every gate except the compile-clean ROOT depends on it (the root gates nothing before
// itself). Consume `Gate` structurally at the dependency site — the root arm adds no
// self-edge, every other gate gets one. A non-root heavy resolve additionally gets a
// ResourceDependsOn edge behind the corpus (when `serialize_heavy`), serializing it into its
// own later layer. `serialize_heavy: false` is the memory-blind control for the discriminating
// oracle below.
// Chain the SECOND post-corpus heavy resolve (the cache-purity audit) behind the FIRST
// (source-root ingest): a ResourceDependsOn edge so the scheduler places it in a still-later
// readiness layer. Without this, both depend only on the corpus and re-join one layer — two heavy
// resolves co-running, the #5375 OOM. This generalizes the §5 "<=1 heavy resolve per layer"
// property from one post-corpus heavy gate to two (a memory conflict, not a data dependency).
fn floor_audit_serializes_behind_ingest() -> DependencyView {
  DependencyView {
    source: gate_node(g: SourceRootIngestGate),
    dependent: gate_node(g: CachePurityAuditGate),
    kind: ResourceDependsOn,
    usage_site: gate_node(g: CachePurityAuditGate)
  }
}

fn floor_dependencies_with(spec: CiSpec, serialize_heavy: Bool) -> List<DependencyView> {
  let base = fold(spec.gates, init: [floor_depends_on_compile(dependent: floor_corpus_node)], f: fn(acc, g) {
    match g {
      DslCompileCleanGate => acc
      _ => {
        let after_compile = list_snoc_item(
          xs: acc,
          item: floor_depends_on_compile(dependent: gate_node(g: g))
        )
        if serialize_heavy && gate_is_heavy_resolve(g: g) {
          list_snoc_item(xs: after_compile, item: floor_corpus_serializes(dependent: gate_node(g: g)))
        } else {
          after_compile
        }
      }
    }
  })
  if serialize_heavy {
    list_snoc_item(xs: base, item: floor_audit_serializes_behind_ingest())
  } else {
    base
  }
}

fn floor_dependencies(spec: CiSpec) -> List<DependencyView> {
  floor_dependencies_with(spec: spec, serialize_heavy: true)
}

// ── node -> Runnable (the single binding site; unmapped -> fail-closed sentinel) ─
fn floor_unrunnable_sentinel() -> Runnable {
  RunnableSingleClaim { entry: "", function: "__gunbc_ci_floor_unmapped__" }
}

fn runnable_for_node(node: Node, spec: CiSpec) -> Runnable {
  if node == floor_corpus_node {
    corpus_runnable()
  } else {
    fold(spec.gates, init: floor_unrunnable_sentinel(), f: fn(acc, g) {
      if node == gate_node(g: g) { gate_runnable(g: g) } else { acc }
    })
  }
}

fn runnables_for_batch(batch: ExecutorBatch, spec: CiSpec) -> List<Runnable> {
  fold(batch.jobs, init: [], f: fn(acc, job) {
    list_snoc_item(xs: acc, item: runnable_for_node(node: job.node, spec: spec))
  })
}

// Scheduler-decided batches projected to runnables (inner — plan.schedule authority).
fn gunbc_ci_floor_schedule_inner() -> List<List<Runnable>> {
  match parallel_executor_plan_from_dependencies(
    nodes: floor_nodes(spec: gunbc_ci_spec),
    dependencies: floor_dependencies(spec: gunbc_ci_spec),
    scheduled: []
  ) {
    ExecutorRunComplete { batches: batches, scheduled: _ } =>
      fold(batches, init: [], f: fn(acc, batch) {
        list_snoc_item(xs: acc, item: runnables_for_batch(batch: batch, spec: gunbc_ci_spec))
      })
    ExecutorRunRunnable { batch: _, scheduled: _, remaining: _ } => [[floor_unrunnable_sentinel()]]
    ExecutorRunBlocked { evidence: _, batches: _, scheduled: _, remaining: _ } => [[floor_unrunnable_sentinel()]]
  }
}

// Generative: RealizationPlan.schedule is the authority; host reads this field.
fn gunbc_ci_floor_realization_plan() -> RealizationPlan {
  RealizationPlan {
    target: ci_floor_target_digest
    objective: RealizationObjective { goals: width_fold_objective_goals() }
    schedule: gunbc_ci_floor_schedule_inner()
    total: cost_account_predicted_zero()
  }
}

// claim_executor entry — schedule projected from the plan (execute = interpret plan).
fn gunbc_ci_floor_batches() -> List<List<Runnable>> {
  gunbc_ci_floor_realization_plan().schedule
}

// Schedule lens receipt (observable independently of host execution).
fn gunbc_ci_floor_schedule_lens_holds() -> Bool {
  match schedule_lens_verdict_for_ci_floor(
    plan: gunbc_ci_floor_realization_plan(),
    compile_gate_fn: ci_floor_compile_gate_fn
  ) {
    Holds => true
    Violation { diagnostic: _ } => false
    NotApplicable { diagnostic: _ } => false
    Unrealized { diagnostic: _ } => false
  }
}

// Floor breadth = the count of independent floor units (one per spec gate; the corpus
// node rides the same later layer), DERIVED from the single-authority spec — never a
// tuned constant. Add a gate to gunbc_ci_spec → breadth re-derives here automatically.
fn gunbc_ci_floor_breadth() -> Int {
  length(xs: gunbc_ci_spec.gates)
}

// The fleet's hardware-thread cap (CPU term). Sourced from the operator-fleet CPU catalog
// (Ampere Altra Max M128-30, 128t), not a literal — the part a host runs is a deployment fact.
// Never binds for the floor today (shard_count = breadth = 7 < 128); kept for fidelity so the
// fold is the full min(shard_count, threads, memory).
fn gunbc_ci_floor_hardware_threads() -> HardwareThreadCount {
  altra_max_m12830_catalog.threads
}

// claim_executor spawn-width companion (host never decides width — it READS the live budget
// and threads it in here; this fold stays the pure authority). §1-C MEMORY-AWARE, DERIVED, not
// the pinned constant #5419 left behind:
//   width = min(shard_count, hardware_threads, ⌊0.8·budget ÷ measured_per_shard_peak⌋)
// - shard_count   = gunbc_ci_floor_breadth() (spec-derived; corpus-explosion is Phase 1)
// - hardware_threads = the fleet CPU cap (non-binding today)
// - memory_budget_bytes = LIVE cgroup budget (raw bytes the host realizer read from the OS),
//   grounded into the std.measure ByteSize carrier at this boundary before the std fold sees it
//   (§3 measured⇒peripheral; an external system authors it → read it live)
// - per_shard_peak = the MEASURED VmHWM÷width fact (gunbc.ci_floor_measurement, a ByteSize), NOT
//   a literal
// The memory term is non-binding today (admits ≫7) — it is the fail-closed FLOOR that only
// REDUCES width below the topology cap once the tree outgrows budget/7 (DESIGN §5). A 0-byte
// budget (host could not read one) yields the conservative committed fallback, never an OOM.
// The `memory_budget_bytes: Int` arg is the raw host value at the host seam (claim_executor reads
// OS bytes, not a ByteSize); it is grounded into ByteSize on the very next line so the std
// authority fold carries the dimension.
// 🟡 SCAFFOLD — feature:host-seam-bytesize — this is the ONE flat-scalar `*_bytes: Int` field in
// §1-C: the claim_executor↔.dag seam where a raw OS byte count crosses (the host has no ByteSize
// value to pass). Tracked, not silent debt. dissolve-on: the host realizer constructs and passes
// a `ByteSize` directly (run_in_context_with_args binding a built Measure value) so this signature
// becomes `memory_budget: ByteSize` and the `byte_size(...)` grounding below moves host-side.
fn gunbc_ci_floor_spawn_width(memory_budget_bytes: Int) -> HardwareThreadCount {
  memory_aware_spawn_width(
    shard_count: gunbc_ci_floor_breadth(),
    hardware_threads: gunbc_ci_floor_hardware_threads(),
    memory_budget: byte_size(memory_budget_bytes),
    per_shard_peak: gunbc_ci_floor_per_shard_peak_rss_bytes(),
    conservative_fallback_width: gunbc_ci_floor_conservative_fallback_width
  )
}

// ── §5 plan oracle: at most one heavy whole-tree resolve per readiness layer ──
// run_walk now launches a whole readiness layer at once (the host fix removed the per-runnable
// width split). The fail-closed safety property is then a flat topology fact — no two heavy
// resolves share a layer — rather than a memory-budget computation (the memory-aware placement
// model was removed as unwired complexity, #5419). The corpus saturates the fleet at its width;
// keeping every other heavy resolve in its own later layer is what prevents the co-run OOM.
fn floor_layer_heavy_resolve_count(batch: ExecutorBatch, spec: CiSpec) -> Int {
  fold(batch.jobs, init: 0, f: fn(acc, job) {
    if floor_node_is_heavy_resolve(node: job.node, spec: spec) { acc + 1 } else { acc }
  })
}

fn floor_plan_serializes_heavy_resolves(dependencies: List<DependencyView>) -> Bool {
  match parallel_executor_plan_from_dependencies(
    nodes: floor_nodes(spec: gunbc_ci_spec),
    dependencies: dependencies,
    scheduled: []
  ) {
    ExecutorRunComplete { batches: batches, scheduled: _ } =>
      fold(batches, init: true, f: fn(ok, batch) {
        ok && (floor_layer_heavy_resolve_count(batch: batch, spec: gunbc_ci_spec) <= 1)
      })
    // Fail-closed: a non-complete plan cannot be certified.
    ExecutorRunRunnable { batch: _, scheduled: _, remaining: _ } => false
    ExecutorRunBlocked { evidence: _, batches: _, scheduled: _, remaining: _ } => false
  }
}

// The §5 plan oracle on the LIVE floor: every scheduler readiness layer carries at most one
// heavy whole-tree resolve. The corpus layer carries the corpus alone (cheap gates do not
// count); source-root ingest is serialized behind it.
fn gunbc_ci_floor_plan_serializes_heavy_resolves() -> Bool {
  floor_plan_serializes_heavy_resolves(dependencies: floor_dependencies(spec: gunbc_ci_spec))
}

// Discriminating control (NEGATE when bundling — a bare RED control breaks marker discovery,
// which runs every `test fn` expecting PASS). Drop the serialization edges: source-root ingest
// re-joins the corpus's layer, giving it two heavy resolves, so the oracle goes RED. Proves the
// resource edge is load-bearing, not decoration.
fn gunbc_ci_floor_plan_co_runs_heavy_without_serialization() -> Bool {
  floor_plan_serializes_heavy_resolves(
    dependencies: floor_dependencies_with(spec: gunbc_ci_spec, serialize_heavy: false)
  ) == false
}
