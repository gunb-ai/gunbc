data ci_floor_target_digest: ContentHash = "gunbc-ci-floor-v1"

data ci_floor_compile_gate_fn: String = "dag_compile_clean_gate_passes"

data floor_gate_witness_entry: String = "dag/tools/floor_effect_gate_witness.dag"

data floor_source_root_ingest_gate_entry: String = "src/v2/workflow/source_root_ingest_gate.dag"

data floor_self_host_realized_comparison_gate_entry: String = "src/v2/workflow/self_host_realized_comparison_gate.dag"

data floor_self_host_realized_comparison_claims_entry: String = "src/v2/workflow/self_host_realized_comparison_claims.dag"

data gunbc_ci_cheap_floor_gate_membership: List<Gate> = [
  CheapClaimPoolGate,
  ExtdepsExternalAuthorityGate,
  GeneratedArtifactDriftGate,
]

data gunbc_ci_cheap_floor_gate_membership_note: String = "Declared cheap-floor gate membership (operator ruling 2026-07-22, fail-fast lane): the negligible-memory wet-declared gates (gate_profile_negligible_wet_declared) that check extdeps authority and generated-artifact drift — seconds each, no whole-tree compile. (The layering-imports direction gate was a member until the direction rule's deletion, operator ruling 2026-07-24.) They run in batch 0 BEFORE DagCompileCleanGate so a drift/authority violation reds in seconds instead of after the ~4min compile-clean anchor. Membership is an explicit list, not inferred from profile fields, so enrollment changes are counted roster edits, never silent drift. Cheap gates are also floor_resource_anchor nodes: excluding them from discovery-flip corpus→gate serialization avoids a scheduler deadlock (cheap→compile data order requires cheap first; corpus→cheap resource order requires corpus first; compile→corpus data order closes the cycle). Dissolve-on: when per-gate cost attribution lands, derive from measurement."

data gunbc_ci_cheap_floor_gate_membership_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "v2.workflow.ci_floor_plan",
    decl_name: "gunbc_ci_cheap_floor_gate_membership",
    field: WholeDeclaration
  }
}

fn gate_in_cheap_floor_membership(g: Gate) -> Bool {
  fold(gunbc_ci_cheap_floor_gate_membership, init: false, f: fn(found, member) {
    match member {
      CheapClaimPoolGate => match g { CheapClaimPoolGate => true  _ => found }
      ExtdepsExternalAuthorityGate => match g { ExtdepsExternalAuthorityGate => true  _ => found }
      GeneratedArtifactDriftGate => match g { GeneratedArtifactDriftGate => true  _ => found }
      _ => found
    }
  })
}

fn spec_enrolls_gate(spec: CiSpec, g: Gate) -> Bool {
  fold(spec.gates, init: false, f: fn(found, sg) {
    match sg {
      CheapClaimPoolGate => match g { CheapClaimPoolGate => true  _ => found }
      ExtdepsExternalAuthorityGate => match g { ExtdepsExternalAuthorityGate => true  _ => found }
      GeneratedArtifactDriftGate => match g { GeneratedArtifactDriftGate => true  _ => found }
      DagCompileCleanGate => match g { DagCompileCleanGate => true  _ => found }
      EmitHostGate => match g { EmitHostGate => true  _ => found }
      SourceRootIngestGate => match g { SourceRootIngestGate => true  _ => found }
      RegenVerifyGate => match g { RegenVerifyGate => true  _ => found }
      SelfHostReadsRealBytesGate => match g { SelfHostReadsRealBytesGate => true  _ => found }
      SelfHostStalenessGate => match g { SelfHostStalenessGate => true  _ => found }
    }
  })
}

fn floor_compile_depends_on_cheap_gate(g: Gate) -> DependencyView {
  DependencyView {
    source: gate_node(g: g),
    dependent: floor_compile_root_node(),
    kind: DataDependsOn,
    usage_site: floor_compile_root_node()
  }
}

fn floor_cheap_gates_precede_compile_edges(spec: CiSpec) -> List<DependencyView> {
  fold(gunbc_ci_cheap_floor_gate_membership, init: [], f: fn(acc, g) {
    if spec_enrolls_gate(spec: spec, g: g) {
      list_snoc_item(xs: acc, item: floor_compile_depends_on_cheap_gate(g: g))
    } else {
      acc
    }
  })
}

data floor_corpus_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^gunbc_floor_corpus } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn entry_kind_is_execution(w: ScheduleWitnessEntry) -> Bool {
  match w.kind {
    ExecutionWitnessKind => true
    CorpusWitnessKind => false
  }
}

fn corpus_witness_entries(spec: CiSpec) -> List<ScheduleWitnessEntry> {
  filter(xs: spec.witness_entries, predicate: fn(w) {
    !entry_kind_is_execution(w: w)
  })
}

fn execution_witness_entries(spec: CiSpec) -> List<ScheduleWitnessEntry> {
  filter(xs: spec.witness_entries, predicate: fn(w) {
    entry_kind_is_execution(w: w)
  })
}

fn bin_witness_corpus_enrolled(spec: CiSpec) -> Bool {
  length(xs: spec.discovery_scan_dirs) > 0 && length(xs: bin_witness_wet_entries) > 0
}

fn corpus_plan_nodes(spec: CiSpec) -> List<Node> {
  concat(
    if length(xs: corpus_witness_entries(spec: spec)) > 0 || length(xs: spec.discovery_scan_dirs) > 0 { [floor_corpus_node] } else { [] },
    concat(
      if length(xs: execution_witness_entries(spec: spec)) > 0 { [execution_corpus_node] } else { [] },
      if bin_witness_corpus_enrolled(spec: spec) { [bin_witness_corpus_node] } else { [] }
    )
  )
}

fn gate_node(g: Gate) -> Node {
  match g {
    EmitHostGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_emit } }, children: [], occurrence_id: SyntheticOccurrence }
    CheapClaimPoolGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_cheap_claim_pool } }, children: [], occurrence_id: SyntheticOccurrence }
    ExtdepsExternalAuthorityGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_extdeps_external_authority } }, children: [], occurrence_id: SyntheticOccurrence }
    DagCompileCleanGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_compile } }, children: [], occurrence_id: SyntheticOccurrence }
    GeneratedArtifactDriftGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_generated_artifact } }, children: [], occurrence_id: SyntheticOccurrence }
    SourceRootIngestGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_sourceingest } }, children: [], occurrence_id: SyntheticOccurrence }
    RegenVerifyGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_regen_verify } }, children: [], occurrence_id: SyntheticOccurrence }
    SelfHostReadsRealBytesGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_self_host_reads_real_bytes } }, children: [], occurrence_id: SyntheticOccurrence }
    SelfHostStalenessGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_self_host_staleness } }, children: [], occurrence_id: SyntheticOccurrence }
  }
}

fn floor_compile_root_node() -> Node {
  gate_node(g: DagCompileCleanGate)
}

fn floor_resource_anchor_node(node: Node) -> Bool {
  (node == floor_compile_root_node())
    || (node == floor_corpus_node)
    || (node == execution_corpus_node)
    || (node == bin_witness_corpus_node)
    || fold(gunbc_ci_cheap_floor_gate_membership, init: false, f: fn(acc, g) {
      acc || (node == gate_node(g: g))
    })
}

data gate_profile_memory_marker_note: String = "Gate memory classes are structural markers (Negligible vs Substantial) since the 2026-07-12 adaptive-width ruling: the fabricated per-gate byte predictions (per-shard peak, host-compiler spawn peak, and their sums) retired with the width folds they fed. Run-time concurrency is governed by the executor's memory governor against the slot's own cgroup budget; the marker still feeds co-residence structure (runnable_excludes_corpus_co_residence)."

fn gate_runnable_profile(g: Gate) -> RunnableResourceProfile {
  let substantial = runnable_memory_substantial()
  match g {
    DagCompileCleanGate =>
      runnable_resource_profile(
        heavy_whole_tree_resolve: true,
        spawns_host_compiler: false,
        memory: substantial,
        execution_mode: Wet
      )
    SourceRootIngestGate =>
      runnable_resource_profile(
        heavy_whole_tree_resolve: true,
        spawns_host_compiler: false,
        memory: substantial,
        execution_mode: Wet
      )
    RegenVerifyGate =>
      runnable_resource_profile(
        heavy_whole_tree_resolve: true,
        spawns_host_compiler: true,
        memory: substantial,
        execution_mode: Wet
      )
    SelfHostReadsRealBytesGate =>
      runnable_resource_profile(
        heavy_whole_tree_resolve: true,
        spawns_host_compiler: true,
        memory: substantial,
        execution_mode: Wet
      )
    SelfHostStalenessGate =>
      runnable_resource_profile(
        heavy_whole_tree_resolve: true,
        spawns_host_compiler: true,
        memory: substantial,
        execution_mode: Wet
      )
    EmitHostGate =>
      runnable_resource_profile(
        heavy_whole_tree_resolve: true,
        spawns_host_compiler: true,
        memory: substantial,
        execution_mode: Wet
      )
    CheapClaimPoolGate => gate_profile_negligible_wet_declared()
    ExtdepsExternalAuthorityGate => gate_profile_negligible_wet_declared()
    GeneratedArtifactDriftGate => gate_profile_negligible_wet_declared()
  }
}

data gate_profile_wet_declaration_note: String = "Every floor GATE declares execution_mode: Wet explicitly — an honest declaration of pre-existing reality (the executor hardwired ExecutionMode::Wet at every witness-execution site until the profile field landed), kept while gates run effectful work (fmt/nextest, emit-host, regen, compile-clean shell receipts). The negligible-memory gates (extdeps external-authority scan, generated-artifact drift) are wet-DECLARED via gate_profile_negligible_wet_declared; per-gate hermetic tightening is a follow-on, each flip proven by a green hermetic run of that gate entry. The DISCOVERY and FALSIFIER corpus batches flipped to Hermetic with the audit receipt (claim_batch default-hermetic census 2026-07-12: 1042 PASS / 105 FAIL before remediation; the mode-typed refusals zeroed by the Filesystem.Read checkout carve-out, the git.Core.Toplevel checkout-root mock case, and the six wet-integration offline rows in gunbc.ci_layer_roots — see wet_integration_offline_note). The fail-closed default (runnable_resource_profile_negligible = Hermetic, absent profile = Hermetic at the executor) applies to every NEW runnable: an undeclared live effect refuses with a typed, located diagnostic instead of dispatching."

fn gate_profile_negligible_wet_declared() -> RunnableResourceProfile {
  runnable_resource_profile(
    heavy_whole_tree_resolve: false,
    spawns_host_compiler: false,
    memory: runnable_memory_negligible(),
    execution_mode: Wet
  )
}

fn gate_runnable(g: Gate) -> Runnable {
  let profile = gate_runnable_profile(g: g)
  match g {
    EmitHostGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "emit_host_gate_passes", profile: profile }
    CheapClaimPoolGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "cheap_claim_pool_gate_passes", profile: profile }
    ExtdepsExternalAuthorityGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "extdeps_external_authority_gate_passes", profile: profile }
    DagCompileCleanGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "dag_compile_clean_gate_passes", profile: profile }
    GeneratedArtifactDriftGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "generated_artifact_drift_gate_passes", profile: profile }
    SourceRootIngestGate => RunnableSingleClaim {
      entry: floor_source_root_ingest_gate_entry,
      function: "source_root_ingest_gate_passes",
      profile: profile
    }
    RegenVerifyGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "regen_verify_gate_passes", profile: profile }
    SelfHostReadsRealBytesGate => RunnableSingleClaim {
      entry: floor_self_host_realized_comparison_gate_entry,
      function: "self_host_realized_comparison_reads_real_bytes_gate_holds",
      profile: profile
    }
    SelfHostStalenessGate => RunnableSingleClaim {
      entry: floor_self_host_realized_comparison_gate_entry,
      function: "self_host_realized_comparison_staleness_gate_holds",
      profile: profile
    }
  }
}

fn cheap_floor_gate_step_labels() -> List<String> {
  list_map(
    xs: gunbc_ci_cheap_floor_gate_membership,
    f: fn(g) { runnable_step_label(r: gate_runnable(g: g)) }
  )
}

fn floor_batch_has_any_cheap_gate(batch: List<Runnable>) -> Bool {
  schedule_lens_batch_has_any_cheap_gate(batch: batch, cheap_gate_labels: cheap_floor_gate_step_labels())
}

fn gunbc_ci_floor_batch_stop_policy_for_github_event(event: String) -> FloorBatchStopPolicy {
  match event {
    "pull_request" => StopBeforeDependents
    _ => FullLedger
  }
}

fn gunbc_ci_floor_plan_uses_batch_stop_policy(plan_function: String) -> Bool {
  (plan_function == floor_plan_function)
    || (plan_function == plan_artifact_plan_function)
    || (plan_function == falsifier_plan_function)
}

fn gunbc_ci_floor_enrolled_runnable_labels_for(spec: CiSpec) -> List<String> {
  let gate_labels = list_map(xs: spec.gates, f: fn(g) {
    runnable_single_claim_function(r: gate_runnable(g: g))
  })
  let corpus_labels = list_map(xs: corpus_plan_nodes(spec: spec), f: fn(node) {
    runnable_single_claim_function(r: runnable_for_node(node: node, spec: spec))
  })
  concat(gate_labels, corpus_labels)
}

fn gunbc_ci_floor_schedule_runnable_labels(batches: List<List<Runnable>>) -> List<String> {
  fold(batches, init: [], f: fn(acc, batch) {
    fold(batch, init: acc, f: fn(inner, r) {
      list_snoc_item(xs: inner, item: runnable_single_claim_function(r: r))
    })
  })
}

fn runnable_is_discovery_batch(r: Runnable) -> Bool {
  match r {
    RunnableDiscoveryBatch { source_roots: _, scan_dirs: _, explicit_entries: _, node_frontier_selection: _, exclude_substrings: _, discovery_scope_dirs: _, profile: _ } => true
    RunnableSingleClaim { entry: _, function: _, profile: _ } => false
    RunnableKernelWorkload { fused_op_count: _ } => false
  }
}

fn batch_has_discovery_corpus(batch: List<Runnable>) -> Bool {
  fold(batch, init: false, f: fn(found, r) { found || runnable_is_discovery_batch(r: r) })
}

fn witness_cheap_gates_only_in_early_batch(batches: List<List<Runnable>>) -> Bool {
  fold(cheap_floor_gate_step_labels(), init: true, f: fn(ok, label) {
    ok && floor_batch_contains_function(batch: batches.first(), target: label)
  })
    && fold(skip(xs: batches, n: 1), init: true, f: fn(ok, batch) {
      ok && !floor_batch_has_any_cheap_gate(batch: batch)
    })
}

fn witness_no_corpus_batch_contains_cheap_gate(batches: List<List<Runnable>>) -> Bool {
  fold(batches, init: true, f: fn(ok, batch) {
    if batch_has_discovery_corpus(batch: batch) {
      ok && !floor_batch_has_any_cheap_gate(batch: batch)
    } else {
      ok
    }
  })
}

fn witness_cheap_gates_precede_all_corpus_batches() -> Bool {
  let batches = gunbc_ci_floor_batches()
  witness_cheap_gates_only_in_early_batch(batches: batches)
    && witness_no_corpus_batch_contains_cheap_gate(batches: batches)
}

fn witness_non_cheap_gate_absent_from_early_batch() -> Bool {
  !floor_batch_contains_function(
    batch: gunbc_ci_floor_batches().first(),
    target: ci_floor_compile_gate_fn
  )
}

fn witness_floor_stop_policy_pr_is_fail_fast() -> Bool {
  match gunbc_ci_floor_batch_stop_policy_for_github_event(event: "pull_request") {
    StopBeforeDependents => true
    FullLedger => false
  }
}

fn witness_floor_stop_policy_push_is_full_ledger() -> Bool {
  match gunbc_ci_floor_batch_stop_policy_for_github_event(event: "push") {
    FullLedger => true
    StopBeforeDependents => false
  }
}

fn witness_floor_stop_policy_unknown_defaults_full_ledger() -> Bool {
  match gunbc_ci_floor_batch_stop_policy_for_github_event(event: "__unknown_event__") {
    FullLedger => true
    StopBeforeDependents => false
  }
}

fn witness_floor_batch_stop_policy_plan_roster_enrolled() -> Bool {
  gunbc_ci_floor_plan_uses_batch_stop_policy(plan_function: floor_plan_function)
    && gunbc_ci_floor_plan_uses_batch_stop_policy(plan_function: plan_artifact_plan_function)
    && gunbc_ci_floor_plan_uses_batch_stop_policy(plan_function: falsifier_plan_function)
    && !gunbc_ci_floor_plan_uses_batch_stop_policy(plan_function: "bre_claim_batches")
}

fn corpus_source_roots() -> List<String> {
  witness_layer_roots
}

data gunbc_ci_adaptive_width_note: String = "Adaptive width (operator ruling 2026-07-12, superseding the pinned-cap regime): the plan no longer authors spawn widths or per-shard byte predictions — the retired machinery was gunbc_ci_corpus_discovery_spawn_width_cap (pinned 1 after the run 28999086030 width=2 OOM), the per-plan *_plan_spawn_width fns the executor evaluated by name, and the gunbc.ci_floor_measurement width folds over hand-edited peak samples (pins freezing derivations: stale samples predated the enrollment flip, and the base-overhead re-measure chased its own tail — the July OOM/wedge regime). The executor now governs concurrency at run time: v1_compiler::memory_governor admits workers AIMD-style against the slot's OWN declared budget (memory.high else memory.max else MemAvailable else MemTotal — MemAvailable precedes MemTotal on uncapped hosts because the kernel's availability estimate excludes the co-tenant baseline that let run 29180195694 reach physical RAM; GUNBC_MEMORY_BUDGET_BYTES to override). Admission is paced (at most one worker whose front-loaded index-build cost has not yet landed), predictive (the run measures its first worker's share over the pool baseline and admits only while current + share fits under high-water), and ceilinged at half the budget — the maturation reserve: the 2026-07-12 run series proved admitted demand matures minutes after admission at ~7x its digest-time footprint, so reactive arms alone always observe it too late and half the pipe stays reserved for in-flight growth. The creep-episode edge (memory.current high-water, PSI some avg10, swap growth) halves the window AND holds admissions — early congestion is TCP's ECN, not a stop-and-hope — while hard events halve it again (memory.events high/oom_kill deltas) and memory.current crossing the declared budget itself collapses the window to one (the reachable loss signal on uncapped hosts, where memory.events never fires); the width-1 progress floor still guarantees forward motion. The window re-grows additively on calm completions. Every hold/back-off is typed, counted, and surfaced in the [governor] receipt line (DESIGN §5: loud bounded degradation, never an absorbing widen). Dissolve-on: graph-derived per-node demand (CostAccount.space measured, the realization-measurement lane) replaces the reactive estimator and the governor demotes to a safety net."

data gunbc_ci_fast_lane_rule_note: String = "Fast-lane 5-second rule (operator ruling 2026-07-12): a witness whose OWN eval takes 5 seconds or longer does not run in per-PR discovery — it lives under a long/ test dir (dag/test/claim/long/, src/v2/test/claim/long/), excluded from discovery at dir grain (gunbc.ci_layer_roots) and triggered independently (local recipe: claim_batch --source-root dag --source-root src/v2 --entry <file> --functions <csv>; scheduled-lane enrollment rides the falsifier follow-on). Enforcement is by execution, not census: the executor arms a cooperative per-witness eval deadline from the budget row below (v1_interpreter EvalBudgetExceeded — a typed FAIL row naming the over-budget witness; the bound unwinds from INSIDE eval because in-process worker threads have no kill authority, the Phase A governor lesson). The deadline arms at eval start, so resolve/index cost is infra and never counted against the witness (the operator's carve-out: 'assuming the infra isn't the problem'). This is also the wedge tourniquet: an unbounded eval that previously burned the 270-minute step cap in billed silence (run 29183446733: 243 of 270 minutes after the last progress line, zero witnesses completed) now fails red in seconds with its name in the log. Dissolve-on: per-witness declared cost envelopes (the witness-cost-locality admission law) replace the blanket lane budget with declared rows."

data gunbc_ci_fast_lane_witness_eval_budget: Second = second(count: 5)

fn gunbc_ci_fast_lane_eval_budget_ms() -> v2.std.nat.Nat {
  second_count(s: gunbc_ci_fast_lane_witness_eval_budget) * 1000
}

fn gunbc_ci_floor_batch_clamp_overhead_seconds() -> List<Int> {
  map(gunbc_ci_floor_batch_clamp_params, c => c.overhead_seconds)
}

fn gunbc_ci_floor_batch_clamp_per_unit_ms() -> List<Int> {
  map(gunbc_ci_floor_batch_clamp_params, c => c.per_unit_ms)
}

fn witness_floor_batch_clamp_params_cover_schedule() -> Bool {
  length(xs: gunbc_ci_floor_batch_clamp_params) == length(xs: gunbc_ci_floor_batches())
}

fn witness_floor_batch_clamp_overhead_all_positive() -> Bool {
  fold(gunbc_ci_floor_batch_clamp_overhead_seconds(), init: true, f: fn(ok, b) { ok && (b > 0) })
}

fn witness_floor_batch_clamp_rate_all_nonneg() -> Bool {
  fold(gunbc_ci_floor_batch_clamp_per_unit_ms(), init: true, f: fn(ok, b) { ok && (b >= 0) })
}

data gunbc_falsifier_self_host_wet_receipt_budget_note: String = "Whole-receipt wall-time budget for the nightly falsifier Wet self-host lane (operator ruling 2026-07-15, Wave 2 CI substrate STEP 3; kill-at-deadline 2026-07-25): bounds emit+cargo total wall time per witness — the wet receipt IS each module's Definition-of-Done, and cargo dominates (std/logic template ~101s wall, 06_translate ~52s measured Refinement-1). claim_executor arms this budget for discovery batches whose explicit entries intersect falsifier_self_host_wet_entries OR falsifier_self_host_wet_known_red_entries — never for silent-pick (owns gunbc_falsifier_silent_pick_gate_receipt_wall_budget) or rehomed bin. Primary refusal is WitnessWallBudgetExceeded: shell waits kill the process group at the ceiling (Finding 1 kill-at-deadline); wall_budget_completion_outcome remains the completion-side backstop. Secondary gunbc_falsifier_self_host_wet_interp_eval_budget arms the cooperative CPU eval deadline for interpreter-wedge detection only (subprocess cargo I/O is wall-counted, not CPU-counted). Receipted ceilings: logic template 101s, 06_translate 52s — 600s per receipt leaves headroom for larger modules while keeping 11-module upper bound (~9.5min measured) far under the 270m falsifier step budget. A raise requires a dated re-basis note (same discipline as floor batch walls) — never to absorb a cache-cold host."

data gunbc_falsifier_self_host_wet_receipt_wall_budget: Second = second(count: 600)

fn gunbc_falsifier_self_host_wet_receipt_wall_budget_ms() -> v2.std.nat.Nat {
  second_count(s: gunbc_falsifier_self_host_wet_receipt_wall_budget) * 1000
}

data gunbc_falsifier_self_host_wet_interp_eval_budget: Second = second(count: 120)

fn gunbc_falsifier_self_host_wet_interp_eval_budget_ms() -> v2.std.nat.Nat {
  second_count(s: gunbc_falsifier_self_host_wet_interp_eval_budget) * 1000
}

data gunbc_falsifier_silent_pick_gate_receipt_budget_note: String = "Whole-receipt wall-time budget for the nightly falsifier silent-pick gate (review #7199 2026-07-25): after the category-error fix removed the mis-scoped self-host 600s ceiling, this row must not go unbudgeted — it is the largest corpus-denominated computational witness on the falsifier and grows with the tree. Basis (two-tier: worst host + spread): run 30164623968 srv3-04 PASS at 717940ms; prior fail-under-mis-scope 30158767015 at 707687ms; main-class cold 30160229060 at 815018ms. Worst observed 815s + ~100s host spread → 900s dated ceiling. Kill-at-deadline applies (same WitnessWallBudgetExceeded arm). Raise requires an appended dated re-basis — never a silent widen."

data gunbc_falsifier_silent_pick_gate_receipt_wall_budget: Second = second(count: 900)

fn gunbc_falsifier_silent_pick_gate_receipt_wall_budget_ms() -> v2.std.nat.Nat {
  second_count(s: gunbc_falsifier_silent_pick_gate_receipt_wall_budget) * 1000
}

fn corpus_runnable_for(spec: CiSpec) -> Runnable {
  RunnableDiscoveryBatch {
    source_roots: corpus_source_roots(),
    scan_dirs: spec.discovery_scan_dirs,
    explicit_entries: corpus_witness_entries(spec: spec),
    node_frontier_selection: SelectionApplied,
    exclude_substrings: witness_exclusion_substrings(),
    discovery_scope_dirs: [],
    profile: runnable_resource_profile(
      heavy_whole_tree_resolve: true,
      spawns_host_compiler: false,
      memory: runnable_memory_substantial(),
      execution_mode: Hermetic
    )
  }
}

data execution_corpus_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^gunbc_floor_execution_corpus } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn execution_corpus_runnable_for(spec: CiSpec) -> Runnable {
  RunnableDiscoveryBatch {
    source_roots: corpus_source_roots(),
    scan_dirs: [],
    explicit_entries: execution_witness_entries(spec: spec),
    node_frontier_selection: SelectionApplied,
    exclude_substrings: [],
    discovery_scope_dirs: [],
    profile: runnable_resource_profile(
      heavy_whole_tree_resolve: true,
      spawns_host_compiler: false,
      memory: runnable_memory_substantial(),
      execution_mode: Wet
    )
  }
}

data bin_witness_corpus_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^gunbc_floor_bin_witness_corpus } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data bin_witness_corpus_note: String = "The bin-execution witness batch: the declared Wet lane for witnesses whose fns execute compiled seed witness binaries (gunbc.ci_layer_roots bin_witness_wet_entries — see bin_witness_wet_note there). They ran silently wet inside the discovery corpus until the hermetic flip; now the discovery batch is Hermetic and these rows keep their per-PR coverage under an explicit Wet profile (spawns_host_compiler: the runner may cargo-build a missing witness bin locally; in CI the build job prebuilds them). Enrolled only when the spec runs live discovery (bin_witness_corpus_enrolled), so regen/emit-determinism/synthetic specs carry no bin batch."

fn bin_witness_corpus_runnable_for() -> Runnable {
  RunnableDiscoveryBatch {
    source_roots: corpus_source_roots(),
    scan_dirs: [],
    explicit_entries: bin_witness_wet_entries,
    node_frontier_selection: SelectionApplied,
    exclude_substrings: [],
    discovery_scope_dirs: [],
    profile: runnable_resource_profile(
      heavy_whole_tree_resolve: false,
      spawns_host_compiler: true,
      memory: runnable_memory_substantial(),
      execution_mode: Wet
    )
  }
}

fn floor_nodes(spec: CiSpec) -> List<Node> {
  fold(spec.gates, init: corpus_plan_nodes(spec: spec), f: fn(acc, g) {
    list_snoc_item(xs: acc, item: gate_node(g: g))
  })
}

fn floor_depends_on_compile(dependent: Node) -> DependencyView {
  DependencyView {
    source: floor_compile_root_node(),
    dependent: dependent,
    kind: DataDependsOn,
    usage_site: dependent
  }
}

fn floor_resource_depends_on(source: Node, dependent: Node) -> DependencyView {
  DependencyView {
    source: source,
    dependent: dependent,
    kind: ResourceDependsOn,
    usage_site: dependent
  }
}

fn floor_corpus_exclusion_resource_edges(spec: CiSpec) -> List<DependencyView> {
  let corpus_nodes = corpus_plan_nodes(spec: spec)
  let floor_present = length(xs: corpus_witness_entries(spec: spec)) > 0 || length(xs: spec.discovery_scan_dirs) > 0
  let after_floor_corpus = concat(
    if floor_present && length(xs: execution_witness_entries(spec: spec)) > 0 {
      [floor_resource_depends_on(source: floor_corpus_node, dependent: execution_corpus_node)]
    } else {
      []
    },
    if floor_present && bin_witness_corpus_enrolled(spec: spec) {
      [floor_resource_depends_on(source: floor_corpus_node, dependent: bin_witness_corpus_node)]
    } else {
      []
    }
  )
  fold(spec.gates, init: after_floor_corpus, f: fn(acc, g) {
    let node = gate_node(g: g)
    if floor_resource_anchor_node(node: node) {
      acc
    } else if runnable_excludes_corpus_co_residence(profile: gate_runnable_profile(g: g)) {
      fold(corpus_nodes, init: acc, f: fn(edges, corpus_node) {
        list_snoc_item(
          xs: edges,
          item: floor_resource_depends_on(source: corpus_node, dependent: node)
        )
      })
    } else {
      acc
    }
  })
}

fn floor_heavy_resolve_chain_resource_edges(spec: CiSpec) -> List<DependencyView> {
  let heavy_nodes = fold(spec.gates, init: [], f: fn(acc, g) {
    let node = gate_node(g: g)
    if floor_resource_anchor_node(node: node) {
      acc
    } else if runnable_heavy_whole_tree_resolve(profile: gate_runnable_profile(g: g)) {
      list_snoc_item(xs: acc, item: node)
    } else {
      acc
    }
  })
  zip_map(
    a: heavy_nodes,
    b: skip(xs: heavy_nodes, n: 1),
    f: fn(prev, next) {
      floor_resource_depends_on(source: prev, dependent: next)
    }
  )
}

fn floor_spec_has_compile_gate(spec: CiSpec) -> Bool {
  fold(spec.gates, init: false, f: fn(acc, g) {
    match g {
      DagCompileCleanGate => true
      _ => acc
    }
  })
}

fn floor_data_dependencies(spec: CiSpec) -> List<DependencyView> {
  if floor_spec_has_compile_gate(spec: spec) {
    concat(
      floor_cheap_gates_precede_compile_edges(spec: spec),
      fold(
        spec.gates,
        init: fold(corpus_plan_nodes(spec: spec), init: [], f: fn(acc, corpus_node) {
          list_snoc_item(xs: acc, item: floor_depends_on_compile(dependent: corpus_node))
        }),
        f: fn(acc, g) {
          match g {
            DagCompileCleanGate => acc
            _ =>
              if gate_in_cheap_floor_membership(g: g) {
                acc
              } else {
                list_snoc_item(
                  xs: acc,
                  item: floor_depends_on_compile(dependent: gate_node(g: g))
                )
              }
          }
        }
      )
    )
  } else {
    []
  }
}

fn floor_regen_emit_artifact_resource_edges(spec: CiSpec) -> List<DependencyView> {
  let has_staleness = fold(spec.gates, init: false, f: fn(acc, g) {
    match g {
      SelfHostStalenessGate => true
      _ => acc
    }
  })
  let has_regen = fold(spec.gates, init: false, f: fn(acc, g) {
    match g {
      RegenVerifyGate => true
      _ => acc
    }
  })
  if has_staleness && has_regen {
    [
      floor_resource_depends_on(
        source: gate_node(g: RegenVerifyGate),
        dependent: gate_node(g: SelfHostStalenessGate)
      )
    ]
  } else {
    []
  }
}

data gunbc_ci_corpus_discovery_batch_isolation_note: String = "Discovery-flip batch isolation under cheap-gate-early ordering (operator ruling 2026-07-22, fail-fast lane; run 29120615071 receipt retained under adaptive width): when discovery_scan_dirs is non-empty, resource edges from every enrolled corpus plan node (floor_corpus_node, execution_corpus_node when ExecutionWitnessKind rows exist, bin_witness_corpus_node when enrolled) to every non-anchor gate still isolate corpus batches from gates so gates start only after discovery completes and walk_memo holds the shared index. Cheap gates are floor_resource_anchor nodes and are EXCLUDED from corpus→gate serialization (the anchor carve-out): cheap→compile data deps require cheap first; corpus→cheap would deadlock with compile→corpus data order; anchors break the cycle by letting cheap gates run without waiting behind corpus while still feeding walk_memo to later gates. Dissolve-on: when per-gate cost attribution lands, derive from measurement."

fn floor_discovery_flip_corpus_serializes_before_gates_edges(spec: CiSpec) -> List<DependencyView> {
  if length(xs: spec.discovery_scan_dirs) > 0 {
    let corpus_nodes = corpus_plan_nodes(spec: spec)
    fold(spec.gates, init: [], f: fn(acc, g) {
      let node = gate_node(g: g)
      if floor_resource_anchor_node(node: node) {
        acc
      } else {
        fold(corpus_nodes, init: acc, f: fn(edges, corpus_node) {
          list_snoc_item(
            xs: edges,
            item: floor_resource_depends_on(source: corpus_node, dependent: node)
          )
        })
      }
    })
  } else {
    []
  }
}

fn floor_discovery_flip_corpus_gate_serialization_edge_count(spec: CiSpec) -> Int {
  floor_non_anchor_gate_count(spec: spec) * length(xs: corpus_plan_nodes(spec: spec))
}

fn floor_non_anchor_gate_count(spec: CiSpec) -> Int {
  fold(spec.gates, init: 0, f: fn(count, g) {
    if floor_resource_anchor_node(node: gate_node(g: g)) { count } else { count + 1 }
  })
}

fn floor_resource_dependencies(spec: CiSpec) -> List<DependencyView> {
  concat(
    floor_discovery_flip_corpus_serializes_before_gates_edges(spec: spec),
    concat(
      floor_corpus_exclusion_resource_edges(spec: spec),
      concat(
        floor_heavy_resolve_chain_resource_edges(spec: spec),
        floor_regen_emit_artifact_resource_edges(spec: spec)
      )
    )
  )
}

fn floor_dependencies_with(spec: CiSpec, serialize_heavy: Bool) -> List<DependencyView> {
  let data_deps = floor_data_dependencies(spec: spec)
  if serialize_heavy {
    concat(data_deps, floor_resource_dependencies(spec: spec))
  } else {
    data_deps
  }
}

fn floor_unrunnable_sentinel() -> Runnable {
  RunnableSingleClaim {
    entry: "",
    function: "__gunbc_ci_floor_unmapped__",
    profile: runnable_resource_profile_negligible()
  }
}

fn runnable_for_node(node: Node, spec: CiSpec) -> Runnable {
  if node == floor_corpus_node {
    corpus_runnable_for(spec: spec)
  } else if node == execution_corpus_node {
    execution_corpus_runnable_for(spec: spec)
  } else if node == bin_witness_corpus_node {
    bin_witness_corpus_runnable_for()
  } else {
    fold(spec.gates, init: floor_unrunnable_sentinel(), f: fn(acc, g) {
      if node == gate_node(g: g) { gate_runnable(g: g) } else { acc }
    })
  }
}

fn runnables_for_batch(batch: ExecutorBatch, spec: CiSpec) -> List<Runnable> {
  fold(batch.jobs, init: [], f: fn(acc, job) {
    list_snoc_item(xs: acc, item: runnable_for_node(node: job.node, spec: spec))
  })
}

fn runnables_for_executor_batches(batches: List<ExecutorBatch>, spec: CiSpec) -> List<List<Runnable>> {
  fold(batches, init: [], f: fn(acc, batch) {
    list_snoc_item(xs: acc, item: runnables_for_batch(batch: batch, spec: spec))
  })
}

fn floor_schedule_via_runner_for(spec: CiSpec, serialize_heavy: Bool) -> List<List<Runnable>> {
  match runner_schedule_plan_from_dependencies(
    nodes: floor_nodes(spec: spec),
    dependencies: floor_dependencies_with(spec: spec, serialize_heavy: serialize_heavy),
    value: runner_ordering_only
  ) {
    RunnerScheduleComplete { batches: batches, store: store } =>
      if runner_schedule_store_covers_nodes(store: store, nodes: floor_nodes(spec: spec)) {
        runnables_for_executor_batches(batches: batches, spec: spec)
      } else {
        [[floor_unrunnable_sentinel()]]
      }
    RunnerScheduleBlocked { evidence: _ } => [[floor_unrunnable_sentinel()]]
  }
}

fn floor_schedule_for(spec: CiSpec, serialize_heavy: Bool) -> List<List<Runnable>> {
  floor_schedule_via_runner_for(spec: spec, serialize_heavy: serialize_heavy)
}

fn gunbc_ci_floor_schedule_inner() -> List<List<Runnable>> {
  floor_schedule_for(spec: gunbc_ci_spec, serialize_heavy: true)
}

fn gunbc_ci_floor_realization_plan_for(spec: CiSpec) -> RealizationPlan {
  RealizationPlan {
    target: ci_floor_target_digest
    objective: RealizationObjective { goals: width_fold_objective_goals() }
    schedule: floor_schedule_for(spec: spec, serialize_heavy: true)
    total: cost_account_predicted_zero()
  }
}

fn gunbc_ci_floor_realization_plan() -> RealizationPlan {
  gunbc_ci_floor_realization_plan_for(spec: gunbc_ci_spec)
}

