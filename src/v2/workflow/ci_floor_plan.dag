      execution_mode: Wet
    )
  }
}

fn falsifier_batches_append_if_enrolled(acc: List<List<Runnable>>, enrolled: Bool, batch: Runnable) -> List<List<Runnable>> {
  if enrolled {
    list_snoc_item(xs: acc, item: [batch])
  } else {
    acc
  }
}

fn gunbc_falsifier_batches() -> List<List<Runnable>> {
  let base = [[gunbc_falsifier_predict_only_batch()]]
  let with_wet = falsifier_batches_append_if_enrolled(
    acc: base,
    enrolled: falsifier_self_host_wet_batch_enrolled(),
    batch: gunbc_falsifier_self_host_wet_batch()
  )
  let with_probe = falsifier_batches_append_if_enrolled(
    acc: with_wet,
    enrolled: falsifier_known_red_probe_batch_enrolled(),
    batch: gunbc_falsifier_known_red_probe_batch()
  )
  falsifier_batches_append_if_enrolled(
    acc: with_probe,
    enrolled: falsifier_silent_pick_gate_batch_enrolled(),
    batch: gunbc_falsifier_silent_pick_gate_batch()
  )
}

fn gunbc_ci_floor_batches() -> List<List<Runnable>> {
  gunbc_ci_floor_realization_plan().schedule
}

data gunbc_ci_witness_corpus_only_batches_note: String = "The pre-push local test gate (consumer: dag/gunbc/githooks_pre_push_emit.dag NEED_WITNESS). It is the SAME affected-set witness corpus CI runs (corpus_runnable_for(gunbc_ci_spec), SelectionApplied scoped to the push diff via the executor's git-diff observation), MINUS two lanes on purpose: (1) the whole-tree --target dag compile-clean gate (batch 1 of gunbc_ci_floor_batches) - infeasible per-push (~72min emit), CI-owned; and (2) the Wet execution + bin-witness lanes (execution_corpus_node / bin_witness_corpus_node) - they need prebuilt release witness bins and spawn a host compiler, so they stay CI-owned. This is a DECLARED scope narrowing, not a silent one (the enforcement-intent rule): the hermetic discovery corpus is the affected-set bulk and catches the resolve / typecheck / witness-logic red class before push; CI remains the whole wall. Selection stays fail-closed exactly as the floor (ci_spec_discovery_flip_note; compile_door_ledger; cli_run AFFECTED-SET REFUSAL): a diff-observation / provenance gap REFUSES with a typed, located diagnostic — it never widens to the whole corpus and never silently skips (DESIGN §5: refuse, never widen)."

fn gunbc_ci_witness_corpus_only_batches() -> List<List<Runnable>> {
  [[corpus_runnable_for(spec: gunbc_ci_spec)]]
}

fn runnable_scan_dir_count(r: Runnable) -> Int {
  match r {
    RunnableDiscoveryBatch { source_roots: _, scan_dirs: dirs, explicit_entries: _, node_frontier_selection: _, exclude_substrings: _, discovery_scope_dirs: _, profile: _ } => length(xs: dirs)
    RunnableSingleClaim { entry: _, function: _, profile: _ } => 0 - 1
    RunnableKernelWorkload { fused_op_count: _ } => 0 - 1
  }
}

fn gunbc_ci_spec_discovery_flip_enrolled() -> CiSpec {
  ci_spec_with_discovery_scan_dirs(spec: gunbc_ci_spec, dirs: witness_discovery_scan_dirs)
}

fn witness_ci_corpus_discovery_flip_parked_on_live_spec() -> Bool {
  (length(xs: gunbc_ci_spec.discovery_scan_dirs) == 0)
    && (length(xs: witness_discovery_scan_dirs) > 0)
}

fn witness_ci_corpus_discovery_flip_authored() -> Bool {
  length(xs: witness_discovery_scan_dirs) > 0
}

fn witness_ci_corpus_discovery_is_live() -> Bool {
  witness_ci_corpus_discovery_flip_authored()
    && (length(xs: gunbc_ci_spec.discovery_scan_dirs) > 0)
    && (runnable_scan_dir_count(r: corpus_runnable_for(spec: gunbc_ci_spec)) > 0)
    && runnable_selection_applied(r: corpus_runnable_for(spec: gunbc_ci_spec))
}

fn witness_floor_discovery_flip_serializes_gates_after_corpus(spec: CiSpec) -> Bool {
  if length(xs: spec.discovery_scan_dirs) == 0 {
    true
  } else {
    length(xs: floor_discovery_flip_corpus_serializes_before_gates_edges(spec: spec)) == floor_discovery_flip_corpus_gate_serialization_edge_count(spec: spec)
  }
}

fn witness_floor_discovery_flip_no_corpus_edge_to_compile_anchor(spec: CiSpec) -> Bool {
  fold(floor_discovery_flip_corpus_serializes_before_gates_edges(spec: spec), init: true, f: fn(ok, edge) {
    ok && (edge.dependent != floor_compile_root_node())
  })
}

fn witness_regen_spec_carries_no_witness_corpus() -> Bool {
  length(xs: corpus_plan_nodes(spec: gunbc_ci_regen_spec)) == 0
}

fn gunbc_ci_regen_floor_batches() -> List<List<Runnable>> {
  gunbc_ci_floor_realization_plan_for(spec: gunbc_ci_regen_spec).schedule
}

data gunbc_ci_plan_artifact_batches_note: String = "The docs-only / plan-artifact-only CI shortcut (ci_spec.ci_plan_artifact_compile_clean_invoke): batch 1 of the floor schedule IS the compile-clean anchor (the plan's one structural fact - compile-clean gates the rest), so the shortcut plan is that single batch through the SAME executor path, never a parallel gate runner. The gate must run inside claim_executor because it consumes the executor's in-run whole-tree --target dag compile receipt (standalone gunbc-run invocation refuses, by execution 2026-07-11); the pre-fix invoke passed gunbc-run-style --entry/--function flags claim_executor does not parse, so the shortcut arm died with exit 2 on the first plan-artifact-only diff to reach it."

fn gunbc_ci_plan_artifact_batches() -> List<List<Runnable>> {
  fold(gunbc_ci_floor_batches(), init: [], f: fn(acc, batch) {
    if length(xs: acc) == 0 { [batch] } else { acc }
  })
}

fn gunbc_ci_floor_schedule_lens_holds() -> Bool {
  match schedule_lens_verdict_for_ci_floor(
    plan: gunbc_ci_floor_realization_plan(),
    compile_gate_fn: ci_floor_compile_gate_fn
  ) {
    Holds => true
    Violation { diagnostic: _ } => false
    NotApplicable { diagnostic: _ } => false
    Unrealized { diagnostic: _ } => false
  }
}

fn gunbc_ci_floor_breadth() -> Int {
  length(xs: gunbc_ci_spec.gates)
}

fn floor_batch_heavy_gate_resolve_count(batch: List<Runnable>) -> Int {
  fold(batch, init: 0, f: fn(acc, r) {
    match r {
      RunnableDiscoveryBatch { source_roots: _, scan_dirs: _, explicit_entries: _, node_frontier_selection: _, exclude_substrings: _, discovery_scope_dirs: _, profile: _ } => acc
      RunnableKernelWorkload { fused_op_count: _ } => acc
      RunnableSingleClaim { entry: _, function: f, profile: p } =>
        if f == ci_floor_compile_gate_fn {
          acc
        } else if runnable_heavy_whole_tree_resolve(profile: p) {
          acc + 1
        } else {
          acc
        }
    }
  })
}

fn floor_plan_at_most_one_heavy_gate_resolve_per_batch(batches: List<List<Runnable>>) -> Bool {
  fold(batches, init: true, f: fn(ok, batch) {
    ok && (floor_batch_heavy_gate_resolve_count(batch: batch) <= 1)
  })
}

fn floor_plan_serializes_heavy_resolves_for(spec: CiSpec) -> Bool {
  floor_plan_at_most_one_heavy_gate_resolve_per_batch(
    batches: floor_schedule_for(spec: spec, serialize_heavy: true)
  )
}

fn floor_plan_co_runs_heavy_without_serialization_for(spec: CiSpec) -> Bool {
  floor_plan_at_most_one_heavy_gate_resolve_per_batch(
    batches: floor_schedule_for(spec: spec, serialize_heavy: false)
  ) == false
}

fn gunbc_ci_floor_plan_serializes_heavy_resolves() -> Bool {
  floor_plan_at_most_one_heavy_gate_resolve_per_batch(batches: gunbc_ci_floor_batches())
}

fn witness_floor_corpus_exclusion_edges_exist(spec: CiSpec) -> Bool {
  length(xs: floor_corpus_exclusion_resource_edges(spec: spec)) > 0
}

fn witness_floor_compile_gate_honest_heavy_profile() -> Bool {
  runnable_heavy_whole_tree_resolve(profile: gate_runnable_profile(g: DagCompileCleanGate))
    && runnable_excludes_corpus_co_residence(profile: gate_runnable_profile(g: DagCompileCleanGate))
}

fn witness_floor_no_corpus_resource_edge_to_compile_anchor(spec: CiSpec) -> Bool {
  fold(floor_corpus_exclusion_resource_edges(spec: spec), init: true, f: fn(ok, edge) {
    ok && (edge.dependent != floor_compile_root_node())
  })
}

