data ci_floor_target_digest: ContentHash = "gunbc-ci-floor-v1"

data ci_floor_compile_gate_fn: String = "dag_compile_clean_gate_passes"

data floor_gate_witness_entry: String = "dag/tools/floor_effect_gate_witness.dag"

data floor_source_root_ingest_gate_entry: String = "src/v2/workflow/source_root_ingest_gate.dag"

data floor_self_host_realized_comparison_gate_entry: String = "src/v2/workflow/self_host_realized_comparison_gate.dag"

data floor_self_host_realized_comparison_claims_entry: String = "src/v2/workflow/self_host_realized_comparison_claims.dag"

data floor_corpus_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^gunbc_floor_corpus } },
  children: []
}

data execution_corpus_scope_prefix: String = "src/v2/test/claim/execution/"

fn entry_kind_is_execution(w: ScheduleWitnessEntry) -> Bool {
  match w.kind {
    ExecutionWitnessKind => true
    CorpusWitnessKind => false
  }
}

fn corpus_witness_entries(spec: CiSpec) -> List<ScheduleWitnessEntry> {
  filter(xs: spec.witness_entries, predicate: fn(w) {
    !entry_kind_is_execution(w: w)
  })
}

fn execution_witness_entries(spec: CiSpec) -> List<ScheduleWitnessEntry> {
  filter(xs: spec.witness_entries, predicate: fn(w) {
    entry_kind_is_execution(w: w)
  })
}

fn witness_entry_kind_path_agree(w: ScheduleWitnessEntry) -> Bool {
  match w.kind {
    ExecutionWitnessKind => starts_with(s: w.entry, prefix: execution_corpus_scope_prefix)
    CorpusWitnessKind => !starts_with(s: w.entry, prefix: execution_corpus_scope_prefix)
  }
}

fn witness_entries_kind_path_all_agree(entries: List<ScheduleWitnessEntry>) -> Bool {
  fold(entries, init: true, f: fn(acc, w) {
    acc && witness_entry_kind_path_agree(w: w)
  })
}

fn corpus_plan_nodes(spec: CiSpec) -> List<Node> {
  concat(
    if length(xs: corpus_witness_entries(spec: spec)) > 0 || length(xs: spec.discovery_scan_dirs) > 0 { [floor_corpus_node] } else { [] },
    if length(xs: execution_witness_entries(spec: spec)) > 0 { [execution_corpus_node] } else { [] }
  )
}

fn gate_node(g: Gate) -> Node {
  match g {
    EmitHostGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_emit } }, children: [] }
    LayeringImportsGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_layering } }, children: [] }
    ExtdepsExternalAuthorityGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_extdeps_external_authority } }, children: [] }
    DagCompileCleanGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_compile } }, children: [] }
    GeneratedArtifactDriftGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_generated_artifact } }, children: [] }
    SourceRootIngestGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_sourceingest } }, children: [] }
    RegenVerifyGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_regen_verify } }, children: [] }
    SelfHostReadsRealBytesGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_self_host_reads_real_bytes } }, children: [] }
    SelfHostStalenessGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_self_host_staleness } }, children: [] }
    EmitDeterminismGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_emit_determinism } }, children: [] }
  }
}

fn floor_compile_root_node() -> Node {
  gate_node(g: DagCompileCleanGate)
}

fn floor_resource_anchor_node(node: Node) -> Bool {
  (node == floor_compile_root_node()) || (node == floor_corpus_node) || (node == execution_corpus_node)
}

fn gate_runnable_profile(g: Gate) -> RunnableResourceProfile {
  let per_shard = runnable_memory_substantial(predicted_peak: gunbc_ci_floor_per_shard_peak_rss_bytes())
  let host_compiler = runnable_memory_substantial(predicted_peak: gunbc_ci_floor_host_compiler_spawn_peak)
  match g {
    DagCompileCleanGate =>
      runnable_resource_profile(
        heavy_whole_tree_resolve: true,
        spawns_host_compiler: false,
        memory: per_shard
      )
    SourceRootIngestGate =>
      runnable_resource_profile(
        heavy_whole_tree_resolve: true,
        spawns_host_compiler: false,
        memory: per_shard
      )
    RegenVerifyGate =>
      runnable_resource_profile(
        heavy_whole_tree_resolve: true,
        spawns_host_compiler: true,
        memory: runnable_memory_substantial_sum(left: per_shard, right: host_compiler)
      )
    SelfHostReadsRealBytesGate =>
      runnable_resource_profile(
        heavy_whole_tree_resolve: false,
        spawns_host_compiler: true,
        memory: runnable_memory_substantial_sum(left: per_shard, right: host_compiler)
      )
    SelfHostStalenessGate =>
      runnable_resource_profile(
        heavy_whole_tree_resolve: false,
        spawns_host_compiler: true,
        memory: runnable_memory_substantial_sum(left: per_shard, right: host_compiler)
      )
    EmitDeterminismGate =>
      runnable_resource_profile(
        heavy_whole_tree_resolve: true,
        spawns_host_compiler: true,
        memory: runnable_memory_substantial_sum(left: per_shard, right: host_compiler)
      )
    EmitHostGate =>
      runnable_resource_profile(
        heavy_whole_tree_resolve: false,
        spawns_host_compiler: true,
        memory: host_compiler
      )
    LayeringImportsGate => runnable_resource_profile_negligible()
    ExtdepsExternalAuthorityGate => runnable_resource_profile_negligible()
    GeneratedArtifactDriftGate => runnable_resource_profile_negligible()
  }
}

fn gate_runnable(g: Gate) -> Runnable {
  let profile = gate_runnable_profile(g: g)
  match g {
    EmitHostGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "emit_host_gate_passes", profile: profile }
    LayeringImportsGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "layering_imports_gate_passes", profile: profile }
    ExtdepsExternalAuthorityGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "extdeps_external_authority_gate_passes", profile: profile }
    DagCompileCleanGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "dag_compile_clean_gate_passes", profile: profile }
    GeneratedArtifactDriftGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "generated_artifact_drift_gate_passes", profile: profile }
    SourceRootIngestGate => RunnableSingleClaim {
      entry: floor_source_root_ingest_gate_entry,
      function: "source_root_ingest_gate_passes",
      profile: profile
    }
    RegenVerifyGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "regen_verify_gate_passes", profile: profile }
    SelfHostReadsRealBytesGate => RunnableSingleClaim {
      entry: floor_self_host_realized_comparison_gate_entry,
      function: "self_host_realized_comparison_reads_real_bytes_gate_holds",
      profile: profile
    }
    SelfHostStalenessGate => RunnableSingleClaim {
      entry: floor_self_host_realized_comparison_gate_entry,
      function: "self_host_realized_comparison_staleness_gate_holds",
      profile: profile
    }
    EmitDeterminismGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "emit_determinism_gate_passes", profile: profile }
  }
}

fn corpus_source_roots() -> List<String> {
  witness_layer_roots
}

data gunbc_ci_corpus_discovery_spawn_width_cap_note: String = "Discovery-flip corpus batch spawn cap (run 28999086030 receipt): the tree-wide discovery corpus with SelectionApplied OOM-killed exit 137 @ spawn_width=2 on the 24GiB live slot (24349MiB VmRSS) while gate workloads fit at width=2 against gunbc_ci_floor_per_shard_peak_max. The discovery batch pins spawn_width_cap to 1 so its heavier per-shard resolve footprint cannot stack; the executor's global spawn_width from gunbc_ci_plan_spawn_width is unchanged for gate batches. Dissolve-on: resolver graph-major shrinks discovery per-shard below the gate envelope and the cap can lift back to the tree-derived width."

fn gunbc_ci_corpus_discovery_spawn_width_cap(spec: CiSpec) -> Nat {
  if length(xs: spec.discovery_scan_dirs) > 0 {
    hardware_thread_count_value(t: hardware_thread_count(count: 1))
  } else {
    hardware_thread_count_value(t: gunbc_ci_floor_spawn_width_from_tree())
  }
}

fn corpus_runnable_for(spec: CiSpec) -> Runnable {
  RunnableDiscoveryBatch {
    source_roots: corpus_source_roots(),
    scan_dirs: spec.discovery_scan_dirs,
    explicit_entries: corpus_witness_entries(spec: spec),
    node_frontier_selection: SelectionApplied,
    exclude_substrings: witness_exclusion_substrings,
    discovery_scope_dirs: [],
    spawn_width_cap: gunbc_ci_corpus_discovery_spawn_width_cap(spec: spec),
    profile: runnable_resource_profile(
      heavy_whole_tree_resolve: true,
      spawns_host_compiler: false,
      memory: runnable_memory_substantial(predicted_peak: gunbc_ci_floor_per_shard_peak_rss_bytes())
    )
  }
}

data execution_corpus_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^gunbc_floor_execution_corpus } },
  children: []
}

fn execution_corpus_spawn_width() -> Int {
  gunbc_ci_execution_corpus_available_width(each: gunbc_ci_floor_execution_corpus_per_witness_rss)
}

fn execution_corpus_runnable_for(spec: CiSpec) -> Runnable {
  RunnableDiscoveryBatch {
    source_roots: corpus_source_roots(),
    scan_dirs: [],
    explicit_entries: execution_witness_entries(spec: spec),
    node_frontier_selection: SelectionApplied,
    exclude_substrings: [],
    discovery_scope_dirs: [],
    spawn_width_cap: execution_corpus_spawn_width(),
    profile: runnable_resource_profile(
      heavy_whole_tree_resolve: true,
      spawns_host_compiler: false,
      memory: runnable_memory_substantial(predicted_peak: gunbc_ci_floor_execution_corpus_per_witness_rss)
    )
  }
}

fn floor_nodes(spec: CiSpec) -> List<Node> {
  fold(spec.gates, init: corpus_plan_nodes(spec: spec), f: fn(acc, g) {
    list_snoc_item(xs: acc, item: gate_node(g: g))
  })
}

fn floor_depends_on_compile(dependent: Node) -> DependencyView {
  DependencyView {
    source: floor_compile_root_node(),
    dependent: dependent,
    kind: DataDependsOn,
    usage_site: dependent
  }
}

fn floor_resource_depends_on(source: Node, dependent: Node) -> DependencyView {
  DependencyView {
    source: source,
    dependent: dependent,
    kind: ResourceDependsOn,
    usage_site: dependent
  }
}

fn floor_corpus_exclusion_resource_edges(spec: CiSpec) -> List<DependencyView> {
  let corpus_nodes = corpus_plan_nodes(spec: spec)
  let after_floor_corpus = if length(xs: corpus_nodes) > 1 {
    [floor_resource_depends_on(source: floor_corpus_node, dependent: execution_corpus_node)]
  } else {
    []
  }
  fold(spec.gates, init: after_floor_corpus, f: fn(acc, g) {
    let node = gate_node(g: g)
    if floor_resource_anchor_node(node: node) {
      acc
    } else if runnable_excludes_corpus_co_residence(profile: gate_runnable_profile(g: g)) {
      fold(corpus_nodes, init: acc, f: fn(edges, corpus_node) {
        list_snoc_item(
          xs: edges,
          item: floor_resource_depends_on(source: corpus_node, dependent: node)
        )
      })
    } else {
      acc
    }
  })
}

fn floor_heavy_resolve_chain_resource_edges(spec: CiSpec) -> List<DependencyView> {
  let heavy_nodes = fold(spec.gates, init: [], f: fn(acc, g) {
    let node = gate_node(g: g)
    if floor_resource_anchor_node(node: node) {
      acc
    } else if runnable_heavy_whole_tree_resolve(profile: gate_runnable_profile(g: g)) {
      list_snoc_item(xs: acc, item: node)
    } else {
      acc
    }
  })
  zip_map(
    a: heavy_nodes,
    b: skip(xs: heavy_nodes, n: 1),
    f: fn(prev, next) {
      floor_resource_depends_on(source: prev, dependent: next)
    }
  )
}

fn floor_spec_has_compile_gate(spec: CiSpec) -> Bool {
  fold(spec.gates, init: false, f: fn(acc, g) {
    match g {
      DagCompileCleanGate => true
      _ => acc
    }
  })
}

fn floor_data_dependencies(spec: CiSpec) -> List<DependencyView> {
  if floor_spec_has_compile_gate(spec: spec) {
    fold(
      spec.gates,
      init: fold(corpus_plan_nodes(spec: spec), init: [], f: fn(acc, corpus_node) {
        list_snoc_item(xs: acc, item: floor_depends_on_compile(dependent: corpus_node))
      }),
      f: fn(acc, g) {
        match g {
          DagCompileCleanGate => acc
          _ => list_snoc_item(
            xs: acc,
            item: floor_depends_on_compile(dependent: gate_node(g: g))
          )
        }
      }
    )
  } else {
    []
  }
}

fn floor_regen_emit_artifact_resource_edges(spec: CiSpec) -> List<DependencyView> {
  let has_staleness = fold(spec.gates, init: false, f: fn(acc, g) {
    match g {
      SelfHostStalenessGate => true
      _ => acc
    }
  })
  let has_regen = fold(spec.gates, init: false, f: fn(acc, g) {
    match g {
      RegenVerifyGate => true
      _ => acc
    }
  })
  if has_staleness && has_regen {
    [
      floor_resource_depends_on(
        source: gate_node(g: RegenVerifyGate),
        dependent: gate_node(g: SelfHostStalenessGate)
      )
    ]
  } else {
    []
  }
}

data gunbc_ci_corpus_discovery_batch_isolation_note: String = "Discovery-flip batch isolation (run 29120615071 receipt): with SelectionApplied the discovery corpus resolves on the main thread (heavy_whole_tree_resolve memo path) while light gate units in the same antichain batch spawn at gunbc_ci_plan_spawn_width — two resolve-groups in one batch, so discovery's whole-tree index and gate shard threads stack even though spawn_width_cap pins the corpus shard count to 1. Resource edges from floor_corpus_node to every gate when discovery_scan_dirs is non-empty isolate the corpus to its own batch so gates start only after discovery completes and walk_memo holds the shared index. Dissolve-on: resolver graph-major shrinks discovery per-shard below the gate envelope so co-residence is safe again."

fn floor_discovery_flip_corpus_serializes_before_gates_edges(spec: CiSpec) -> List<DependencyView> {
  if length(xs: spec.discovery_scan_dirs) > 0 {
    fold(spec.gates, init: [], f: fn(acc, g) {
      let node = gate_node(g: g)
      if floor_resource_anchor_node(node: node) {
        acc
      } else {
        list_snoc_item(
          xs: acc,
          item: floor_resource_depends_on(source: floor_corpus_node, dependent: node)
        )
      }
    })
  } else {
    []
  }
}

fn floor_non_anchor_gate_count(spec: CiSpec) -> Int {
  fold(spec.gates, init: 0, f: fn(count, g) {
    if floor_resource_anchor_node(node: gate_node(g: g)) { count } else { count + 1 }
  })
}

fn floor_resource_dependencies(spec: CiSpec) -> List<DependencyView> {
  concat(
    floor_discovery_flip_corpus_serializes_before_gates_edges(spec: spec),
    concat(
      floor_corpus_exclusion_resource_edges(spec: spec),
      concat(
        floor_heavy_resolve_chain_resource_edges(spec: spec),
        floor_regen_emit_artifact_resource_edges(spec: spec)
      )
    )
  )
}

fn floor_dependencies_with(spec: CiSpec, serialize_heavy: Bool) -> List<DependencyView> {
  let data_deps = floor_data_dependencies(spec: spec)
  if serialize_heavy {
    concat(data_deps, floor_resource_dependencies(spec: spec))
  } else {
    data_deps
  }
}

fn floor_unrunnable_sentinel() -> Runnable {
  RunnableSingleClaim {
    entry: "",
    function: "__gunbc_ci_floor_unmapped__",
    profile: runnable_resource_profile_negligible()
  }
}

fn runnable_for_node(node: Node, spec: CiSpec) -> Runnable {
  if node == floor_corpus_node {
    corpus_runnable_for(spec: spec)
  } else if node == execution_corpus_node {
    execution_corpus_runnable_for(spec: spec)
  } else {
    fold(spec.gates, init: floor_unrunnable_sentinel(), f: fn(acc, g) {
      if node == gate_node(g: g) { gate_runnable(g: g) } else { acc }
    })
  }
}

fn runnables_for_batch(batch: ExecutorBatch, spec: CiSpec) -> List<Runnable> {
  fold(batch.jobs, init: [], f: fn(acc, job) {
    list_snoc_item(xs: acc, item: runnable_for_node(node: job.node, spec: spec))
  })
}

fn runnables_for_executor_batches(batches: List<ExecutorBatch>, spec: CiSpec) -> List<List<Runnable>> {
  fold(batches, init: [], f: fn(acc, batch) {
    list_snoc_item(xs: acc, item: runnables_for_batch(batch: batch, spec: spec))
  })
}

data floor_schedule_direct_for_dissolve_on_note: String = "Parallel representation (§2/§3): floor_schedule_direct_for is the legacy scheduler-only projection retained for the move-1 byte-identical receipt (witness_floor_runner_schedule_byte_identical{,_for}). Production scheduling flows through floor_schedule_via_runner_for. Dissolve-on: S2a move 2 lands (compile_to_resolved / module resolution on the runner store) and the receipt witness is deleted — floor_schedule_direct_for goes with it."

fn floor_schedule_direct_for(spec: CiSpec, serialize_heavy: Bool) -> List<List<Runnable>> {
  match parallel_executor_plan_from_dependencies(
    nodes: floor_nodes(spec: spec),
    dependencies: floor_dependencies_with(spec: spec, serialize_heavy: serialize_heavy),
    scheduled: []
  ) {
    ExecutorRunComplete { batches: batches, scheduled: _ } =>
      runnables_for_executor_batches(batches: batches, spec: spec)
    ExecutorRunRunnable { batch: _, scheduled: _, remaining: _ } => [[floor_unrunnable_sentinel()]]
    ExecutorRunBlocked { evidence: _, batches: _, scheduled: _, remaining: _ } => [[floor_unrunnable_sentinel()]]
  }
}

fn floor_schedule_via_runner_for(spec: CiSpec, serialize_heavy: Bool) -> List<List<Runnable>> {
  match runner_schedule_plan_from_dependencies(
    nodes: floor_nodes(spec: spec),
    dependencies: floor_dependencies_with(spec: spec, serialize_heavy: serialize_heavy),
    value: runner_ordering_only
  ) {
    RunnerScheduleComplete { batches: batches, store: store } =>
      if runner_schedule_store_covers_nodes(store: store, nodes: floor_nodes(spec: spec)) {
        runnables_for_executor_batches(batches: batches, spec: spec)
      } else {
        [[floor_unrunnable_sentinel()]]
      }
    RunnerScheduleBlocked { evidence: _ } => [[floor_unrunnable_sentinel()]]
  }
}

fn floor_schedule_for(spec: CiSpec, serialize_heavy: Bool) -> List<List<Runnable>> {
  floor_schedule_via_runner_for(spec: spec, serialize_heavy: serialize_heavy)
}

fn witness_floor_runner_schedule_byte_identical_for(spec: CiSpec, serialize_heavy: Bool) -> Bool {
  schedule_eq(
    left: floor_schedule_direct_for(spec: spec, serialize_heavy: serialize_heavy),
    right: floor_schedule_via_runner_for(spec: spec, serialize_heavy: serialize_heavy)
  )
}

fn witness_floor_runner_schedule_byte_identical() -> Bool {
  witness_floor_runner_schedule_byte_identical_for(spec: gunbc_ci_spec, serialize_heavy: true)
    && witness_floor_runner_schedule_byte_identical_for(spec: gunbc_ci_spec, serialize_heavy: false)
}

fn gunbc_ci_floor_schedule_inner() -> List<List<Runnable>> {
  floor_schedule_for(spec: gunbc_ci_spec, serialize_heavy: true)
}

fn gunbc_ci_floor_realization_plan_for(spec: CiSpec) -> RealizationPlan {
  RealizationPlan {
    target: ci_floor_target_digest
    objective: RealizationObjective { goals: width_fold_objective_goals() }
    schedule: floor_schedule_for(spec: spec, serialize_heavy: true)
    total: cost_account_predicted_zero()
  }
}

fn gunbc_ci_floor_realization_plan() -> RealizationPlan {
  gunbc_ci_floor_realization_plan_for(spec: gunbc_ci_spec)
}

fn gunbc_falsifier_spawn_width_for_budget(memory_budget: ByteSize) -> HardwareThreadCount {
  let budget_count = byte_size_count(b: memory_budget)
  if budget_count <= 0 {
    hardware_thread_count(count: 1)
  } else {
    let cpu_bound = hardware_thread_count_value(t: bounded_host_spawn_width(
      shard_count: 1,
      hardware_threads: gunbc_ci_floor_hardware_threads()
    ))
    hardware_thread_count(count: gunbc_falsifier_memory_derived_width(cap: memory_budget, cpu_bound: cpu_bound))
  }
}

fn gunbc_falsifier_spawn_width_from_live_cap() -> HardwareThreadCount {
  gunbc_falsifier_spawn_width_for_budget(memory_budget: gunbc_ci_runner_slot_memory_max_live)
}

fn gunbc_falsifier_batches() -> List<List<Runnable>> {
  [[RunnableDiscoveryBatch {
    source_roots: corpus_source_roots(),
    scan_dirs: gunbc_ci_spec.discovery_scan_dirs,
    explicit_entries: [],
    node_frontier_selection: SelectionPredictOnly,
    exclude_substrings: witness_exclusion_substrings,
    discovery_scope_dirs: [],
    spawn_width_cap: hardware_thread_count_value(t: gunbc_falsifier_spawn_width_from_live_cap()),
    profile: runnable_resource_profile(
      heavy_whole_tree_resolve: true,
      spawns_host_compiler: false,
      memory: runnable_memory_substantial(predicted_peak: gunbc_falsifier_per_shard_peak_rss_bytes())
    )
  }]]
}

fn gunbc_ci_floor_batches() -> List<List<Runnable>> {
  gunbc_ci_floor_realization_plan().schedule
}

fn runnable_scan_dir_count(r: Runnable) -> Int {
  match r {
    RunnableDiscoveryBatch { source_roots: _, scan_dirs: dirs, explicit_entries: _, node_frontier_selection: _, exclude_substrings: _, discovery_scope_dirs: _, spawn_width_cap: _, profile: _ } => length(xs: dirs)
    _ => 0 - 1
  }
}

fn gunbc_ci_spec_discovery_flip_enrolled() -> CiSpec {
  ci_spec_with_discovery_scan_dirs(spec: gunbc_ci_spec, dirs: witness_discovery_scan_dirs)
}

fn witness_ci_corpus_discovery_flip_parked_on_live_spec() -> Bool {
  (length(xs: gunbc_ci_spec.discovery_scan_dirs) == 0)
    && (length(xs: witness_discovery_scan_dirs) > 0)
}

fn witness_ci_corpus_discovery_flip_authored() -> Bool {
  length(xs: witness_discovery_scan_dirs) > 0
}

fn witness_ci_corpus_discovery_is_live() -> Bool {
  witness_ci_corpus_discovery_flip_authored()
    && (length(xs: gunbc_ci_spec.discovery_scan_dirs) > 0)
    && (runnable_scan_dir_count(r: corpus_runnable_for(spec: gunbc_ci_spec)) > 0)
    && runnable_selection_applied(r: corpus_runnable_for(spec: gunbc_ci_spec))
}

fn witness_ci_corpus_discovery_serializes_at_width_one() -> Bool {
  match corpus_runnable_for(spec: gunbc_ci_spec_discovery_flip_enrolled()) {
    RunnableDiscoveryBatch { source_roots: _, scan_dirs: dirs, explicit_entries: _, node_frontier_selection: _, exclude_substrings: _, discovery_scope_dirs: _, spawn_width_cap: cap, profile: _ } =>
      (length(xs: dirs) > 0) && (cap == 1)
    _ => false
  }
}

fn witness_floor_discovery_flip_serializes_gates_after_corpus(spec: CiSpec) -> Bool {
  if length(xs: spec.discovery_scan_dirs) == 0 {
    true
  } else {
    length(xs: floor_discovery_flip_corpus_serializes_before_gates_edges(spec: spec)) == floor_non_anchor_gate_count(spec: spec)
  }
}

fn witness_floor_discovery_flip_no_corpus_edge_to_compile_anchor(spec: CiSpec) -> Bool {
  fold(floor_discovery_flip_corpus_serializes_before_gates_edges(spec: spec), init: true, f: fn(ok, edge) {
    ok && (edge.dependent != floor_compile_root_node())
  })
}

fn witness_regen_spec_carries_no_witness_corpus() -> Bool {
  length(xs: corpus_plan_nodes(spec: gunbc_ci_regen_spec)) == 0
}

fn gunbc_ci_regen_floor_batches() -> List<List<Runnable>> {
  gunbc_ci_floor_realization_plan_for(spec: gunbc_ci_regen_spec).schedule
}

fn gunbc_ci_emit_determinism_batches() -> List<List<Runnable>> {
  gunbc_ci_floor_realization_plan_for(spec: gunbc_ci_emit_determinism_spec).schedule
}

fn gunbc_ci_floor_schedule_lens_holds() -> Bool {
  match schedule_lens_verdict_for_ci_floor(
    plan: gunbc_ci_floor_realization_plan(),
    compile_gate_fn: ci_floor_compile_gate_fn
  ) {
    Holds => true
    Violation { diagnostic: _ } => false
    NotApplicable { diagnostic: _ } => false
    Unrealized { diagnostic: _ } => false
  }
}

fn gunbc_ci_floor_breadth() -> Int {
  length(xs: gunbc_ci_spec.gates)
}

fn gunbc_ci_floor_hardware_threads() -> HardwareThreadCount {
  altra_max_m12830_catalog.threads
}

fn gunbc_ci_floor_spawn_width_for_budget(memory_budget: ByteSize) -> HardwareThreadCount {
  let budget_count = byte_size_count(b: memory_budget)
  if budget_count <= 0 {
    hardware_thread_count(count: int_min(a: gunbc_ci_floor_conservative_fallback_width, b: execution_corpus_spawn_width()))
  } else {
    let cpu_bound = hardware_thread_count_value(t: bounded_host_spawn_width(
      shard_count: gunbc_ci_floor_breadth(),
      hardware_threads: gunbc_ci_floor_hardware_threads()
    ))
    hardware_thread_count(count: gunbc_ci_floor_memory_derived_width(cap: memory_budget, cpu_bound: cpu_bound))
  }
}

fn gunbc_ci_floor_spawn_width_from_tree() -> HardwareThreadCount {
  gunbc_ci_floor_spawn_width_for_budget(memory_budget: srv1_floor_memory_budget())
}

fn gunbc_ci_plan_spawn_width(memory_budget_bytes: Int) -> HardwareThreadCount {
  gunbc_ci_floor_spawn_width_for_budget(memory_budget: byte_size(memory_budget_bytes))
}

fn gunbc_ci_regen_floor_plan_spawn_width(memory_budget_bytes: Int) -> HardwareThreadCount {
  gunbc_ci_plan_spawn_width(memory_budget_bytes: memory_budget_bytes)
}

data gunbc_falsifier_plan_spawn_width_note: String = "claim_executor derives gunbc_falsifier_plan_spawn_width from gunbc_falsifier_batches at runtime (same wiring-gap class as ci_regen, #6393). Unlike ci/regen, the falsifier cold full-corpus discovery batch carries a heavier per-shard envelope (gunbc_falsifier_per_shard_peak_rss_bytes) than floor gate witnesses — run 28993330753 exit-137 @ spawn_width=4 under gunbc_ci_runner_slot_memory_max_live proved the floor per_shard underestimate. This function and gunbc_falsifier_spawn_width_from_live_cap share gunbc_falsifier_memory_derived_width so plan-time spawn_width_cap and runtime eval agree; with the flip-re-measured executor base overhead (8910036989) the falsifier memory formula derives 2 at the live 24GiB cap while the shipped falsifier width is 1 (cpu_bound pins shard_count: 1 - the run-all cold corpus serializes so its whole-tree shard footprint cannot stack). The ci discovery corpus batch separately pins spawn_width_cap to 1 (run 28999086030 OOM receipt — gunbc_ci_corpus_discovery_spawn_width_cap_note). witness_falsifier_plan_spawn_width_backs_off_at_live_cap executes the derived name in the corpus. RE-LAND RECEIPT (2026-07-10): the 5 consecutive falsifier exit-137s (07-06..07-10, srv1 AND srv2 slots) are NOT a slot-cap or width fact — run 29086228839 ran at spawn_width=1, read live memory budget 25769803776 (the cap is UNIFORM 24GiB; read back on srv1-02/srv2-03/srv2-07 too, run 29112500694), and was killed at rss 6741MiB, far below its own cap. That is a HOST-level OOM kill: the hosts are memory-oversubscribed (134GiB host_ram vs ~25 slots hand-set to 24GiB each plus session containers), so under fleet pressure the kernel takes the biggest resident process, and the falsifier's ~15min cold union resolve makes it the reliably-biggest target. Same kill vector took #6403's run 29000557166 MID-discovery-corpus at ~8min (its ExitSuccess line belongs to the merge-admission stamp tool stamping CI_FLOOR_EXIT=137, NOT a floor completion) - as of 2026-07-10 NO flipped corpus has completed in CI; the sole completion receipt is local (33.5GiB container). Owners: the runner-slot allocation converge lane (un-oversubscribe: live == declared) for the kill vector; resolver graph-major frontier-window memory for shrinking the target. This plan's width accounting (base row re-measured parent-inclusive, falsifier width 1, ci discovery width 1) is correct against the slot cap and is not the residual risk."
fn gunbc_falsifier_plan_spawn_width(memory_budget_bytes: Int) -> HardwareThreadCount {
  gunbc_falsifier_spawn_width_for_budget(memory_budget: byte_size(memory_budget_bytes))
}

fn witness_falsifier_plan_spawn_width_backs_off_at_live_cap() -> Bool {
  let live = byte_size_count(b: gunbc_ci_runner_slot_memory_max_live)
  let falsifier_width = hardware_thread_count_value(t: gunbc_falsifier_plan_spawn_width(memory_budget_bytes: live))
  let ci_width = hardware_thread_count_value(t: gunbc_ci_plan_spawn_width(memory_budget_bytes: live))
  let fallback_width = hardware_thread_count_value(t: gunbc_falsifier_plan_spawn_width(memory_budget_bytes: 0))
  falsifier_width < ci_width && falsifier_width > 0 && fallback_width == 1
}

fn witness_falsifier_envelope_fits_live_cap() -> Bool {
  let width = hardware_thread_count_value(t: gunbc_falsifier_spawn_width_from_live_cap())
  let committed = byte_size_count(b: gunbc_ci_floor_executor_base_overhead_bytes()) + width * byte_size_count(b: gunbc_falsifier_per_shard_peak_rss_bytes())
  committed <= byte_size_count(b: measure_scale_fraction_floor(
    m: gunbc_ci_runner_slot_memory_max_live,
    num: gunbc_ci_floor_width_usable_fraction_num,
    den: gunbc_ci_floor_width_usable_fraction_den
  ))
}

fn gunbc_ci_floor_run_envelope(memory_budget_bytes: Int) -> ResourceEnvelope {
  parallel_run_demand_envelope(
    width: gunbc_ci_floor_spawn_width_for_budget(memory_budget: byte_size(memory_budget_bytes)),
    per_shard_peak: gunbc_ci_floor_per_shard_peak_rss_bytes()
  )
}

fn witness_floor_tight_budget_backs_off_envelope() -> Bool {
  let tight_budget = 10000000000
  let envelope = gunbc_ci_floor_run_envelope(memory_budget_bytes: tight_budget)

  demand_envelope_thread_count(envelope: envelope) < gunbc_ci_floor_breadth()
    && demand_envelope_fits_budget(envelope: envelope, budget: byte_size(tight_budget))
}

fn witness_floor_fail_open_would_exceed_budget() -> Bool {
  let tight_budget = 10000000000
  let blind_envelope = parallel_run_demand_envelope(
    width: bounded_host_spawn_width(
      shard_count: gunbc_ci_floor_breadth(),
      hardware_threads: gunbc_ci_floor_hardware_threads()
    ),
    per_shard_peak: gunbc_ci_floor_per_shard_peak_rss_bytes()
  )
  demand_envelope_fits_budget(envelope: blind_envelope, budget: byte_size(tight_budget)) == false
}

fn witness_floor_width_governed_by_budget_tree() -> Bool {
  let tree_width = hardware_thread_count_value(t: gunbc_ci_floor_spawn_width_from_tree())
  let cpu_only_width = hardware_thread_count_value(t: bounded_host_spawn_width(shard_count: gunbc_ci_floor_breadth(), hardware_threads: gunbc_ci_floor_hardware_threads()))
  return tree_width < cpu_only_width
}

fn witness_floor_width_derived_from_tree_is_positive() -> Bool {
  byte_size_count(b: srv1_floor_memory_budget()) > 0
    && hardware_thread_count_value(t: gunbc_ci_floor_spawn_width_from_tree()) > 0
}

fn witness_floor_spawn_width_tight_budget_backs_off() -> Bool {
  let tight = 10000000000
  let width = hardware_thread_count_value(t: gunbc_ci_plan_spawn_width(memory_budget_bytes: tight))
  width < gunbc_ci_floor_breadth()
}

fn witness_floor_spawn_width_zero_budget_falls_back() -> Bool {
  let width = hardware_thread_count_value(t: gunbc_ci_plan_spawn_width(memory_budget_bytes: 0))
  width == int_min(
    a: gunbc_ci_floor_conservative_fallback_width,
    b: execution_corpus_spawn_width()
  )
}

fn floor_batch_heavy_gate_resolve_count(batch: List<Runnable>) -> Int {
  fold(batch, init: 0, f: fn(acc, r) {
    match r {
      RunnableDiscoveryBatch { source_roots: _, scan_dirs: _, explicit_entries: _, node_frontier_selection: _, exclude_substrings: _, discovery_scope_dirs: _, spawn_width_cap: _, profile: _ } => acc
      RunnableKernelWorkload { fused_op_count: _ } => acc
      RunnableSingleClaim { entry: _, function: f, profile: p } =>
        if f == ci_floor_compile_gate_fn {
          acc
        } else if runnable_heavy_whole_tree_resolve(profile: p) {
          acc + 1
        } else {
          acc
        }
    }
  })
}

fn floor_plan_at_most_one_heavy_gate_resolve_per_batch(batches: List<List<Runnable>>) -> Bool {
  fold(batches, init: true, f: fn(ok, batch) {
    ok && (floor_batch_heavy_gate_resolve_count(batch: batch) <= 1)
  })
}

fn floor_plan_serializes_heavy_resolves_for(spec: CiSpec) -> Bool {
  floor_plan_at_most_one_heavy_gate_resolve_per_batch(
    batches: floor_schedule_for(spec: spec, serialize_heavy: true)
  )
}

fn floor_plan_co_runs_heavy_without_serialization_for(spec: CiSpec) -> Bool {
  floor_plan_at_most_one_heavy_gate_resolve_per_batch(
    batches: floor_schedule_for(spec: spec, serialize_heavy: false)
  ) == false
}

fn gunbc_ci_floor_plan_serializes_heavy_resolves() -> Bool {
  floor_plan_at_most_one_heavy_gate_resolve_per_batch(batches: gunbc_ci_floor_batches())
}

fn witness_floor_corpus_exclusion_edges_exist(spec: CiSpec) -> Bool {
  length(xs: floor_corpus_exclusion_resource_edges(spec: spec)) > 0
}

fn witness_floor_compile_gate_honest_heavy_profile() -> Bool {
  runnable_heavy_whole_tree_resolve(profile: gate_runnable_profile(g: DagCompileCleanGate))
    && runnable_excludes_corpus_co_residence(profile: gate_runnable_profile(g: DagCompileCleanGate))
}

fn witness_floor_no_corpus_resource_edge_to_compile_anchor(spec: CiSpec) -> Bool {
  fold(floor_corpus_exclusion_resource_edges(spec: spec), init: true, f: fn(ok, edge) {
    ok && (edge.dependent != floor_compile_root_node())
  })
}

fn witness_corpus_effective_widths_fit_runner_cap() -> Bool {
  let cap = byte_size_count(b: gunbc_ci_runner_slot_memory_max_live)
  let base = byte_size_count(b: gunbc_ci_floor_executor_base_overhead_bytes())
  let floor_cap_w = hardware_thread_count_value(t: gunbc_ci_floor_spawn_width_from_tree())
  let floor_committed = base + floor_cap_w * byte_size_count(b: gunbc_ci_floor_per_shard_peak_rss_bytes())
  let exec_cap_w = execution_corpus_spawn_width()
  let exec_committed = base + exec_cap_w * byte_size_count(b: gunbc_ci_floor_execution_corpus_per_witness_rss)
  floor_committed <= cap && exec_committed <= cap
}

fn witness_floor_derived_width_leaves_headroom_at_cap() -> Bool {
  let width = gunbc_ci_floor_memory_derived_width(cap: gunbc_ci_runner_cgroup_memory_cap, cpu_bound: 128)
  let committed = byte_size_count(b: gunbc_ci_floor_per_shard_peak_rss_bytes()) * width
  committed < byte_size_count(b: gunbc_ci_runner_cgroup_memory_cap)
}

