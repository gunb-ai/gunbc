module v2.workflow.ci_floor_plan

import gunbc.ci_layer_roots { witness_layer_roots, witness_discovery_scan_dirs }
import gunbc.ci_spec {
  gunbc_ci_spec, CiSpec,
  Gate, RustMonolithGate, EmitHostGate, LayeringImportsGate,
  ExtdepsExternalAuthorityGate, DslCompileCleanGate, GeneratedArtifactDriftGate,
  SourceRootIngestGate, RegenVerifyGate
}
import v2.std.algebra { length, list_snoc_item, skip, zip_map }
import v2.std.collection { List }
import v2.std.dependency { DataDependsOn, ResourceDependsOn, DependencyView }
import v2.std.node { Atom, Node, TypeNode }
import v2.std.text { String }
import std.types { ContentHash, Int }
import std.measure { HardwareThreadCount, hardware_thread_count, hardware_thread_count_value, byte_size, ByteSize, byte_size_count }
import std.realization_width { width_fold_objective_goals, bounded_host_spawn_width, int_min }
import product.compute_fabric {
  ResourceEnvelope,
  parallel_run_demand_envelope,
  demand_envelope_thread_count,
  demand_envelope_fits_budget
}
import gunbc.ci_floor_measurement {
  gunbc_ci_floor_per_shard_peak_rss_bytes,
  gunbc_ci_floor_host_compiler_spawn_peak,
  gunbc_ci_floor_conservative_fallback_width,
  gunbc_ci_floor_confirmed_safe_width
}
import gunbc.ci_budget_tree { srv1_floor_memory_budget }
import extdeps.cpu.ampere { altra_max_m12830_catalog }
import std.realization_schedule {
  RealizationPlan,
  RealizationObjective,
  Runnable,
  RunnableSingleClaim,
  RunnableDiscoveryBatch,
  RunnableSpaceCost,
  runnable_space_cost,
  runnable_space_cost_zero,
  runnable_space_cost_sum,
  runnable_forbids_corpus_co_residence,
  cost_account_predicted_zero,
  schedule_lens_verdict_for_ci_floor
}
import v2.workflow.executor {
  ExecutorBatch,
  ExecutorJob,
  ExecutorRunBlocked,
  ExecutorRunComplete,
  ExecutorRunRunnable,
  parallel_executor_plan_from_dependencies
}

data ci_floor_target_digest: ContentHash = "gunbc-ci-floor-v1"

data ci_floor_compile_gate_fn: String = "dsl_compile_clean_gate_passes"

data floor_gate_witness_entry: String = "dsl/tools/floor_effect_gate_witness.dag"

data floor_source_root_ingest_gate_entry: String = "src/v2/workflow/source_root_ingest_gate.dag"

data floor_corpus_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^gunbc_floor_corpus } },
  children: []
}

fn gate_node(g: Gate) -> Node {
  match g {
    RustMonolithGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_rust } }, children: [] }
    EmitHostGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_emit } }, children: [] }
    LayeringImportsGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_layering } }, children: [] }
    ExtdepsExternalAuthorityGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_extdeps_external_authority } }, children: [] }
    DslCompileCleanGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_compile } }, children: [] }
    GeneratedArtifactDriftGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_generated_artifact } }, children: [] }
    SourceRootIngestGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_sourceingest } }, children: [] }
    RegenVerifyGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_regen_verify } }, children: [] }
  }
}

fn gate_runnable_space_cost(g: Gate) -> RunnableSpaceCost {
  match g {
    SourceRootIngestGate =>
      runnable_space_cost(predicted_peak: gunbc_ci_floor_per_shard_peak_rss_bytes())
    RegenVerifyGate =>
      runnable_space_cost_sum(
        left: runnable_space_cost(predicted_peak: gunbc_ci_floor_per_shard_peak_rss_bytes()),
        right: runnable_space_cost(predicted_peak: gunbc_ci_floor_host_compiler_spawn_peak)
      )
    EmitHostGate =>
      runnable_space_cost(predicted_peak: gunbc_ci_floor_host_compiler_spawn_peak)
    RustMonolithGate => runnable_space_cost_zero()
    LayeringImportsGate => runnable_space_cost_zero()
    ExtdepsExternalAuthorityGate => runnable_space_cost_zero()
    DslCompileCleanGate => runnable_space_cost_zero()
    GeneratedArtifactDriftGate => runnable_space_cost_zero()
  }
}

fn gate_runnable(g: Gate) -> Runnable {
  let cost = gate_runnable_space_cost(g: g)
  match g {
    RustMonolithGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "rust_monolith_gate_passes", cost: cost }
    EmitHostGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "emit_host_gate_passes", cost: cost }
    LayeringImportsGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "layering_imports_gate_passes", cost: cost }
    ExtdepsExternalAuthorityGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "extdeps_external_authority_gate_passes", cost: cost }
    DslCompileCleanGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "dsl_compile_clean_gate_passes", cost: cost }
    GeneratedArtifactDriftGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "generated_artifact_drift_gate_passes", cost: cost }
    SourceRootIngestGate => RunnableSingleClaim {
      entry: floor_source_root_ingest_gate_entry,
      function: "source_root_ingest_gate_passes",
      cost: cost
    }
    RegenVerifyGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "regen_verify_gate_passes", cost: cost }
  }
}

fn floor_compile_root_node() -> Node {
  gate_node(g: DslCompileCleanGate)
}

fn corpus_source_roots() -> List<String> {
  witness_layer_roots
}

fn corpus_runnable() -> Runnable {
  RunnableDiscoveryBatch {
    source_roots: corpus_source_roots(),
    scan_dirs: witness_discovery_scan_dirs,
    explicit_entries: [],
    skip_unaffected_node_frontier: true,
    cost: runnable_space_cost(predicted_peak: gunbc_ci_floor_per_shard_peak_rss_bytes())
  }
}

fn floor_nodes(spec: CiSpec) -> List<Node> {
  fold(spec.gates, init: [floor_corpus_node], f: fn(acc, g) {
    list_snoc_item(xs: acc, item: gate_node(g: g))
  })
}

fn floor_depends_on_compile(dependent: Node) -> DependencyView {
  DependencyView {
    source: floor_compile_root_node(),
    dependent: dependent,
    kind: DataDependsOn,
    usage_site: dependent
  }
}

fn gate_is_heavy_resolve(g: Gate) -> Bool {
  match g {
    SourceRootIngestGate => true
    DslCompileCleanGate => true
    RegenVerifyGate => true
    RustMonolithGate => false
    EmitHostGate => false
    LayeringImportsGate => false
    ExtdepsExternalAuthorityGate => false
    GeneratedArtifactDriftGate => false
  }
}

fn floor_node_is_heavy_resolve(node: Node, spec: CiSpec) -> Bool {
  if node == floor_corpus_node {
    true
  } else {
    fold(spec.gates, init: false, f: fn(acc, g) {
      if node == gate_node(g: g) { gate_is_heavy_resolve(g: g) } else { acc }
    })
  }
}

fn floor_serialize_after(source: Node, dependent: Node) -> DependencyView {
  DependencyView {
    source: source,
    dependent: dependent,
    kind: ResourceDependsOn,
    usage_site: dependent
  }
}

fn floor_corpus_serializes(dependent: Node) -> DependencyView {
  floor_serialize_after(source: floor_corpus_node, dependent: dependent)
}

fn floor_heavy_resolve_gate_nodes(spec: CiSpec) -> List<Node> {
  fold(spec.gates, init: [], f: fn(acc, g) {
    match g {
      DslCompileCleanGate => acc
      _ => if gate_is_heavy_resolve(g: g) {
        list_snoc_item(xs: acc, item: gate_node(g: g))
      } else {
        acc
      }
    }
  })
}

fn floor_heavy_resolve_chain(spec: CiSpec) -> List<DependencyView> {
  let heavy = floor_heavy_resolve_gate_nodes(spec: spec)
  zip_map(
    a: heavy,
    b: skip(xs: heavy, n: 1),
    f: fn(prev, next) { floor_serialize_after(source: prev, dependent: next) }
  )
}

fn floor_expected_readiness_layers(spec: CiSpec) -> Int {
  2 + length(xs: floor_heavy_resolve_gate_nodes(spec: spec))
}

fn floor_dependencies_with(spec: CiSpec, serialize_heavy: Bool) -> List<DependencyView> {
  let corpus_serialized = fold(spec.gates, init: [floor_depends_on_compile(dependent: floor_corpus_node)], f: fn(acc, g) {
    match g {
      DslCompileCleanGate => acc
      _ => {
        let after_compile = list_snoc_item(
          xs: acc,
          item: floor_depends_on_compile(dependent: gate_node(g: g))
        )
        if serialize_heavy && runnable_forbids_corpus_co_residence(r: runnable_for_node(node: gate_node(g: g), spec: spec)) {
          list_snoc_item(xs: after_compile, item: floor_corpus_serializes(dependent: gate_node(g: g)))
        } else {
          after_compile
        }
      }
    }
  })
  if serialize_heavy {
    concat(corpus_serialized, floor_heavy_resolve_chain(spec: spec))
  } else {
    corpus_serialized
  }
}

fn floor_dependencies(spec: CiSpec) -> List<DependencyView> {
  floor_dependencies_with(spec: spec, serialize_heavy: true)
}

fn floor_unrunnable_sentinel() -> Runnable {
  RunnableSingleClaim { entry: "", function: "__gunbc_ci_floor_unmapped__", cost: runnable_space_cost_zero() }
}

fn runnable_for_node(node: Node, spec: CiSpec) -> Runnable {
  if node == floor_corpus_node {
    corpus_runnable()
  } else {
    fold(spec.gates, init: floor_unrunnable_sentinel(), f: fn(acc, g) {
      if node == gate_node(g: g) { gate_runnable(g: g) } else { acc }
    })
  }
}

fn runnables_for_batch(batch: ExecutorBatch, spec: CiSpec) -> List<Runnable> {
  fold(batch.jobs, init: [], f: fn(acc, job) {
    list_snoc_item(xs: acc, item: runnable_for_node(node: job.node, spec: spec))
  })
}

fn floor_schedule_for_dependencies(dependencies: List<DependencyView>) -> List<List<Runnable>> {
  match parallel_executor_plan_from_dependencies(
    nodes: floor_nodes(spec: gunbc_ci_spec),
    dependencies: dependencies,
    scheduled: []
  ) {
    ExecutorRunComplete { batches: batches, scheduled: _ } =>
      fold(batches, init: [], f: fn(acc, batch) {
        list_snoc_item(xs: acc, item: runnables_for_batch(batch: batch, spec: gunbc_ci_spec))
      })
    ExecutorRunRunnable { batch: _, scheduled: _, remaining: _ } => [[floor_unrunnable_sentinel()]]
    ExecutorRunBlocked { evidence: _, batches: _, scheduled: _, remaining: _ } => [[floor_unrunnable_sentinel()]]
  }
}

fn gunbc_ci_floor_schedule_inner() -> List<List<Runnable>> {
  floor_schedule_for_dependencies(dependencies: floor_dependencies(spec: gunbc_ci_spec))
}

fn gunbc_ci_floor_schedule_without_serialization() -> List<List<Runnable>> {
  floor_schedule_for_dependencies(
    dependencies: floor_dependencies_with(spec: gunbc_ci_spec, serialize_heavy: false)
  )
}

fn gunbc_ci_floor_realization_plan() -> RealizationPlan {
  RealizationPlan {
    target: ci_floor_target_digest
    objective: RealizationObjective { goals: width_fold_objective_goals() }
    schedule: gunbc_ci_floor_schedule_inner()
    total: cost_account_predicted_zero()
  }
}

fn gunbc_ci_floor_batches() -> List<List<Runnable>> {
  gunbc_ci_floor_realization_plan().schedule
}

fn gunbc_ci_floor_schedule_lens_holds() -> Bool {
  match schedule_lens_verdict_for_ci_floor(
    plan: gunbc_ci_floor_realization_plan(),
    compile_gate_fn: ci_floor_compile_gate_fn
  ) {
    Holds => true
    Violation { diagnostic: _ } => false
    NotApplicable { diagnostic: _ } => false
    Unrealized { diagnostic: _ } => false
  }
}

fn gunbc_ci_floor_breadth() -> Int {
  length(xs: gunbc_ci_spec.gates)
}

fn gunbc_ci_floor_hardware_threads() -> HardwareThreadCount {
  altra_max_m12830_catalog.threads
}

fn gunbc_ci_floor_spawn_width_for_budget(memory_budget: ByteSize) -> HardwareThreadCount {
  let budget_count = byte_size_count(b: memory_budget)
  if budget_count <= 0 {
    hardware_thread_count(count: gunbc_ci_floor_conservative_fallback_width)
  } else if budget_count < byte_size_count(b: gunbc_ci_floor_per_shard_peak_rss_bytes()) {
    hardware_thread_count(count: 1)
  } else {
    let cpu_bound = hardware_thread_count_value(t: bounded_host_spawn_width(
      shard_count: gunbc_ci_floor_breadth(),
      hardware_threads: gunbc_ci_floor_hardware_threads()
    ))
    hardware_thread_count(count: int_min(a: cpu_bound, b: gunbc_ci_floor_confirmed_safe_width))
  }
}

fn gunbc_ci_floor_spawn_width_from_tree() -> HardwareThreadCount {
  gunbc_ci_floor_spawn_width_for_budget(memory_budget: srv1_floor_memory_budget())
}

fn gunbc_ci_floor_spawn_width(memory_budget_bytes: Int) -> HardwareThreadCount {
  gunbc_ci_floor_spawn_width_for_budget(memory_budget: byte_size(memory_budget_bytes))
}

fn gunbc_ci_floor_run_envelope(memory_budget_bytes: Int) -> ResourceEnvelope {
  parallel_run_demand_envelope(
    width: gunbc_ci_floor_spawn_width_for_budget(memory_budget: byte_size(memory_budget_bytes)),
    per_shard_peak: gunbc_ci_floor_per_shard_peak_rss_bytes()
  )
}

fn witness_floor_tight_budget_backs_off_envelope() -> Bool {
  let tight_budget = 10000000000
  let envelope = gunbc_ci_floor_run_envelope(memory_budget_bytes: tight_budget)

  demand_envelope_thread_count(envelope: envelope) < gunbc_ci_floor_breadth()
    && demand_envelope_fits_budget(envelope: envelope, budget: byte_size(tight_budget))
}

fn witness_floor_fail_open_would_exceed_budget() -> Bool {
  let tight_budget = 10000000000
  let blind_envelope = parallel_run_demand_envelope(
    width: bounded_host_spawn_width(
      shard_count: gunbc_ci_floor_breadth(),
      hardware_threads: gunbc_ci_floor_hardware_threads()
    ),
    per_shard_peak: gunbc_ci_floor_per_shard_peak_rss_bytes()
  )
  demand_envelope_fits_budget(envelope: blind_envelope, budget: byte_size(tight_budget)) == false
}

fn witness_floor_unreadable_budget_uses_conservative_envelope() -> Bool {
  let envelope = gunbc_ci_floor_run_envelope(memory_budget_bytes: 0)
  demand_envelope_thread_count(envelope: envelope) == gunbc_ci_floor_conservative_fallback_width
}

fn witness_floor_width_governed_by_budget_tree() -> Bool {
  let tree_width = hardware_thread_count_value(t: gunbc_ci_floor_spawn_width_from_tree())
  let cpu_only_width = hardware_thread_count_value(t: bounded_host_spawn_width(shard_count: gunbc_ci_floor_breadth(), hardware_threads: gunbc_ci_floor_hardware_threads()))
  return tree_width < cpu_only_width
}

fn witness_floor_width_derived_from_tree_is_positive() -> Bool {
  byte_size_count(b: srv1_floor_memory_budget()) > 0
    && hardware_thread_count_value(t: gunbc_ci_floor_spawn_width_from_tree()) > 0
}

fn witness_floor_spawn_width_tight_budget_backs_off() -> Bool {
  let tight = 10000000000
  let width = hardware_thread_count_value(t: gunbc_ci_floor_spawn_width(memory_budget_bytes: tight))
  width < gunbc_ci_floor_breadth()
}

fn witness_floor_spawn_width_zero_budget_falls_back() -> Bool {
  let width = hardware_thread_count_value(t: gunbc_ci_floor_spawn_width(memory_budget_bytes: 0))
  width == gunbc_ci_floor_conservative_fallback_width
}

fn floor_layer_heavy_resolve_count(batch: ExecutorBatch, spec: CiSpec) -> Int {
  fold(batch.jobs, init: 0, f: fn(acc, job) {
    if floor_node_is_heavy_resolve(node: job.node, spec: spec) { acc + 1 } else { acc }
  })
}

fn floor_plan_serializes_heavy_resolves(dependencies: List<DependencyView>) -> Bool {
  match parallel_executor_plan_from_dependencies(
    nodes: floor_nodes(spec: gunbc_ci_spec),
    dependencies: dependencies,
    scheduled: []
  ) {
    ExecutorRunComplete { batches: batches, scheduled: _ } =>
      fold(batches, init: true, f: fn(ok, batch) {
        ok && (floor_layer_heavy_resolve_count(batch: batch, spec: gunbc_ci_spec) <= 1)
      })

    ExecutorRunRunnable { batch: _, scheduled: _, remaining: _ } => false
    ExecutorRunBlocked { evidence: _, batches: _, scheduled: _, remaining: _ } => false
  }
}

fn gunbc_ci_floor_plan_serializes_heavy_resolves() -> Bool {
  floor_plan_serializes_heavy_resolves(dependencies: floor_dependencies(spec: gunbc_ci_spec))
}

fn gunbc_ci_floor_plan_co_runs_heavy_without_serialization() -> Bool {
  floor_plan_serializes_heavy_resolves(
    dependencies: floor_dependencies_with(spec: gunbc_ci_spec, serialize_heavy: false)
  ) == false
}

fn witness_floor_confirmed_safe_width_bounds_actual_width() -> Bool {
  let cap_budget = 8589934592
  let actual_width = hardware_thread_count_value(t: gunbc_ci_floor_spawn_width(memory_budget_bytes: cap_budget))
  actual_width <= gunbc_ci_floor_confirmed_safe_width
}

fn witness_floor_ceiling_clamps_stale_per_shard() -> Bool {
  let runner_cap_bytes = 8589934592
  let stale_bytes = 2254857830
  let confirmed_safe = gunbc_ci_floor_confirmed_safe_width
  let raw_width_without_ceiling = runner_cap_bytes / stale_bytes
  let capped_width = if raw_width_without_ceiling <= confirmed_safe { raw_width_without_ceiling } else { confirmed_safe }
  raw_width_without_ceiling > confirmed_safe && capped_width <= confirmed_safe
}
