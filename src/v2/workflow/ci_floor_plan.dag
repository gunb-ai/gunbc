      memory: runnable_memory_substantial(),
      execution_mode: Hermetic
    )
  }
}

fn gunbc_falsifier_batches() -> List<List<Runnable>> {
  let base = [[gunbc_falsifier_predict_only_batch()]]
  let with_wet = falsifier_batches_append_if_enrolled(
    acc: base,
    enrolled: falsifier_self_host_wet_batch_enrolled(),
    batch: gunbc_falsifier_self_host_wet_batch()
  )
  let with_wet_known_red = falsifier_batches_append_if_enrolled(
    acc: with_wet,
    enrolled: falsifier_self_host_wet_known_red_batch_enrolled(),
    batch: gunbc_falsifier_self_host_wet_known_red_batch()
  )
  let with_probe = falsifier_batches_append_if_enrolled(
    acc: with_wet_known_red,
    enrolled: falsifier_known_red_probe_batch_enrolled(),
    batch: gunbc_falsifier_known_red_probe_batch()
  )
  let with_silent_pick = falsifier_batches_append_if_enrolled(
    acc: with_probe,
    enrolled: falsifier_silent_pick_gate_batch_enrolled(),
    batch: gunbc_falsifier_silent_pick_gate_batch()
  )
  let with_rehomed = falsifier_batches_append_if_enrolled(
    acc: with_silent_pick,
    enrolled: falsifier_rehomed_bin_wet_batch_enrolled(),
    batch: gunbc_falsifier_rehomed_bin_wet_batch()
  )
  let with_substrate_long = falsifier_batches_append_if_enrolled(
    acc: with_rehomed,
    enrolled: falsifier_substrate_long_lane_batch_enrolled(),
    batch: gunbc_falsifier_substrate_long_lane_batch()
  )
  falsifier_batches_append_if_enrolled(
    acc: with_substrate_long,
    enrolled: falsifier_cadence_witness_batch_enrolled(),
    batch: gunbc_falsifier_cadence_witness_batch()
  )
}

data falsifier_cadence_witness_batch_note: String = "The live consumer for gunbc.commit_workflow's FalsifierCadenceJob surface — the scheduled home for declared CommitWitnessClaim rows priced out of the per-PR floor (falsifier_cadence_surface_note). WHY THIS BATCH HAS TO EXIST IN THE SAME CHANGE that re-homes the rows: a surface tag with no batch reading it is enrollment-by-illusion, the exact ~54-dark-file state under test/claim/long/ that the re-home is supposed to stop adding to, and it would present as a clean green diff. So the enrollment predicate and this batch land together, and gauntlet_lane_enrollment_witness_test reds per-PR if a row ever sits on the surface without reaching here. Profile mirrors gunbc_falsifier_rehomed_bin_wet_batch (Wet, host compiler, substantial memory): the re-homed rows are execution-kind witnesses whose cost is exactly why they left the floor. SelectionApplied so the cadence run still records predictions — the falsifier's own divergence accounting stays intact for these rows rather than being exempted."

fn falsifier_cadence_witness_entries() -> List<ScheduleWitnessEntry> {
  project_falsifier_witness_entries(roster: commit_gate_roster)
}

fn falsifier_cadence_witness_batch_enrolled() -> Bool {
  length(xs: falsifier_cadence_witness_entries()) > 0
}

fn gunbc_falsifier_cadence_witness_batch() -> Runnable {
  RunnableDiscoveryBatch {
    source_roots: corpus_source_roots(),
    scan_dirs: [],
    explicit_entries: falsifier_cadence_witness_entries(),
    node_frontier_selection: SelectionApplied,
    exclude_substrings: [],
    discovery_scope_dirs: [],
    profile: runnable_resource_profile(
      heavy_whole_tree_resolve: false,
      spawns_host_compiler: true,
      memory: runnable_memory_substantial(),
      execution_mode: Wet
    )
  }
}

data gunbc_pr_native_batch_note: String = "Per-PR native batch (P6 routing consumption, 2026-07-22): explicit entries = the equals_eval agreement legs of families the native-routing frontier marks NativeRouted — nothing else. The frontier is the ONE authority for both sides of the floor (this batch enrolls exactly the routed set; nothing else changes), and flips are parity-window-gated data, so at landing the routed set is empty and this appends no batch: zero behavior change until receipts flip a family. Wet profile: the admitted transport cargo-builds cold or runs warm against GUNBC_NATIVE_CACHE_ROOT."

fn gunbc_pr_native_entries() -> List<ScheduleWitnessEntry> {
  fold(
    native_routed_rows(),
    init: [],
    f: fn(acc, row) {
      concat(acc, [
        ScheduleWitnessEntry {
          entry: row.agreement_entry,
          function: row.agreement_function,
          kind: ExecutionWitnessKind
        }
      ])
    }
  )
}

fn gunbc_pr_native_batch_enrolled() -> Bool {
  length(xs: gunbc_pr_native_entries()) > 0
}

fn gunbc_pr_native_batch() -> Runnable {
  RunnableDiscoveryBatch {
    source_roots: corpus_source_roots(),
    scan_dirs: [],
    explicit_entries: gunbc_pr_native_entries(),
    node_frontier_selection: SelectionApplied,
    exclude_substrings: [],
    discovery_scope_dirs: [],
    profile: runnable_resource_profile(
      heavy_whole_tree_resolve: false,
      spawns_host_compiler: true,
      memory: runnable_memory_substantial(),
      execution_mode: Hermetic
    )
  }
}

fn gunbc_ci_floor_batches() -> List<List<Runnable>> {
  falsifier_batches_append_if_enrolled(
    acc: gunbc_ci_floor_realization_plan().schedule,
    enrolled: gunbc_pr_native_batch_enrolled(),
    batch: gunbc_pr_native_batch()
  )
}

data gunbc_ci_witness_corpus_only_batches_note: String = "The pre-push local test gate (consumer: dag/gunbc/githooks_pre_push_emit.dag NEED_WITNESS). It is the SAME affected-set witness corpus CI runs (corpus_runnable_for(gunbc_ci_spec), SelectionApplied scoped to the push diff via the executor's git-diff observation), MINUS two lanes on purpose: (1) the whole-tree --target dag compile-clean gate (the compile-clean anchor batch of gunbc_ci_floor_batches, after the cheap-gate early batch) - infeasible per-push (~72min emit), CI-owned; and (2) the Wet execution + bin-witness lanes (execution_corpus_node / bin_witness_corpus_node) - they need prebuilt release witness bins and spawn a host compiler, so they stay CI-owned. This is a DECLARED scope narrowing, not a silent one (the enforcement-intent rule): the hermetic discovery corpus is the affected-set bulk and catches the resolve / typecheck / witness-logic red class before push; CI remains the whole wall. Selection stays fail-closed exactly as the floor (ci_spec_discovery_flip_note; compile_door_ledger; cli_run AFFECTED-SET REFUSAL): a diff-observation / provenance gap REFUSES with a typed, located diagnostic — it never widens to the whole corpus and never silently skips (DESIGN §5: refuse, never widen)."

fn gunbc_ci_witness_corpus_only_batches() -> List<List<Runnable>> {
  [[corpus_runnable_for(spec: gunbc_ci_spec)]]
}

fn runnable_scan_dir_count(r: Runnable) -> Int {
  match r {
    RunnableDiscoveryBatch { source_roots: _, scan_dirs: dirs, explicit_entries: _, node_frontier_selection: _, exclude_substrings: _, discovery_scope_dirs: _, profile: _ } => length(xs: dirs)
    RunnableSingleClaim { entry: _, function: _, profile: _ } => 0 - 1
    RunnableKernelWorkload { fused_op_count: _ } => 0 - 1
  }
}

fn gunbc_ci_spec_discovery_flip_enrolled() -> CiSpec {
  ci_spec_with_discovery_scan_dirs(spec: gunbc_ci_spec, dirs: witness_discovery_scan_dirs)
}

fn witness_ci_corpus_discovery_flip_parked_on_live_spec() -> Bool {
  (length(xs: gunbc_ci_spec.discovery_scan_dirs) == 0)
    && (length(xs: witness_discovery_scan_dirs) > 0)
}

fn witness_ci_corpus_discovery_flip_authored() -> Bool {
  length(xs: witness_discovery_scan_dirs) > 0
}

fn witness_ci_corpus_discovery_is_live() -> Bool {
  witness_ci_corpus_discovery_flip_authored()
    && (length(xs: gunbc_ci_spec.discovery_scan_dirs) > 0)
    && (runnable_scan_dir_count(r: corpus_runnable_for(spec: gunbc_ci_spec)) > 0)
    && runnable_selection_applied(r: corpus_runnable_for(spec: gunbc_ci_spec))
}

fn witness_floor_discovery_flip_serializes_gates_after_corpus(spec: CiSpec) -> Bool {
  if length(xs: spec.discovery_scan_dirs) == 0 {
    true
  } else {
    length(xs: floor_discovery_flip_corpus_serializes_before_gates_edges(spec: spec)) == floor_discovery_flip_corpus_gate_serialization_edge_count(spec: spec)
  }
}

fn witness_floor_discovery_flip_no_corpus_edge_to_compile_anchor(spec: CiSpec) -> Bool {
  fold(floor_discovery_flip_corpus_serializes_before_gates_edges(spec: spec), init: true, f: fn(ok, edge) {
    ok && (edge.dependent != floor_compile_root_node())
  })
}

fn witness_regen_spec_carries_no_witness_corpus() -> Bool {
  length(xs: corpus_plan_nodes(spec: gunbc_ci_regen_spec)) == 0
}

fn gunbc_ci_regen_floor_batches() -> List<List<Runnable>> {
  gunbc_ci_floor_realization_plan_for(spec: gunbc_ci_regen_spec).schedule
}

fn runnable_single_claim_function(r: Runnable) -> String {
  match r {
    RunnableSingleClaim { entry: _, function: f, profile: _ } => f
    RunnableDiscoveryBatch { source_roots: _, scan_dirs: _, explicit_entries: _, node_frontier_selection: _, exclude_substrings: _, discovery_scope_dirs: _, profile: _ } => "__discovery_corpus__"
    RunnableKernelWorkload { fused_op_count: _ } => "__kernel_workload__"
  }
}

fn floor_batch_contains_function(batch: List<Runnable>, target: String) -> Bool {
  fold(batch, init: false, f: fn(found, r) {
    found || (runnable_single_claim_function(r: r) == target)
  })
}

fn floor_compile_clean_batch(batches: List<List<Runnable>>) -> List<List<Runnable>> {
  fold(batches, init: [], f: fn(acc, batch) {
    if length(xs: acc) > 0 {
      acc
    } else if floor_batch_contains_function(batch: batch, target: ci_floor_compile_gate_fn) {
      [batch]
    } else {
      acc
    }
  })
}

data gunbc_ci_plan_artifact_batches_note: String = "The docs-only / plan-artifact-only CI shortcut (ci_spec.ci_plan_artifact_compile_clean_invoke): the compile-clean anchor batch of the floor schedule (batch 1 after the cheap-gate early batch — see gunbc_ci_cheap_floor_gate_membership_note) runs alone through the SAME executor path, never a parallel gate runner. The gate must run inside claim_executor because it consumes the executor's in-run whole-tree --target dag compile receipt (standalone gunbc-run invocation refuses, by execution 2026-07-11); the pre-fix invoke passed gunbc-run-style --entry/--function flags claim_executor does not parse, so the shortcut arm died with exit 2 on the first plan-artifact-only diff to reach it."

fn gunbc_ci_plan_artifact_batches() -> List<List<Runnable>> {
  floor_compile_clean_batch(batches: gunbc_ci_floor_batches())
}

fn gunbc_ci_floor_schedule_lens_holds() -> Bool {
  match schedule_lens_verdict_for_ci_floor(
    plan: gunbc_ci_floor_realization_plan(),
    compile_gate_fn: ci_floor_compile_gate_fn,
    cheap_gate_labels: cheap_floor_gate_step_labels()
  ) {
    Holds => true
    Violation { diagnostic: _ } => false
    NotApplicable { diagnostic: _ } => false
    Unrealized { diagnostic: _ } => false
  }
}

fn gunbc_ci_floor_breadth() -> Int {
  length(xs: gunbc_ci_spec.gates)
}

fn floor_batch_heavy_gate_resolve_count(batch: List<Runnable>) -> Int {
  fold(batch, init: 0, f: fn(acc, r) {
    match r {
      RunnableDiscoveryBatch { source_roots: _, scan_dirs: _, explicit_entries: _, node_frontier_selection: _, exclude_substrings: _, discovery_scope_dirs: _, profile: _ } => acc
      RunnableKernelWorkload { fused_op_count: _ } => acc
      RunnableSingleClaim { entry: _, function: f, profile: p } =>
        if f == ci_floor_compile_gate_fn {
          acc
        } else if runnable_heavy_whole_tree_resolve(profile: p) {
          acc + 1
        } else {
          acc
        }
    }
  })
}

fn floor_plan_at_most_one_heavy_gate_resolve_per_batch(batches: List<List<Runnable>>) -> Bool {
  fold(batches, init: true, f: fn(ok, batch) {
    ok && (floor_batch_heavy_gate_resolve_count(batch: batch) <= 1)
  })
}

fn floor_plan_serializes_heavy_resolves_for(spec: CiSpec) -> Bool {
  floor_plan_at_most_one_heavy_gate_resolve_per_batch(
    batches: floor_schedule_for(spec: spec, serialize_heavy: true)
  )
}

fn floor_plan_co_runs_heavy_without_serialization_for(spec: CiSpec) -> Bool {
  floor_plan_at_most_one_heavy_gate_resolve_per_batch(
    batches: floor_schedule_for(spec: spec, serialize_heavy: false)
  ) == false
}

fn gunbc_ci_floor_plan_serializes_heavy_resolves() -> Bool {
  floor_plan_at_most_one_heavy_gate_resolve_per_batch(batches: gunbc_ci_floor_batches())
}

fn witness_floor_corpus_exclusion_edges_exist(spec: CiSpec) -> Bool {
  length(xs: floor_corpus_exclusion_resource_edges(spec: spec)) > 0
}

fn witness_floor_compile_gate_honest_heavy_profile() -> Bool {
  runnable_heavy_whole_tree_resolve(profile: gate_runnable_profile(g: DagCompileCleanGate))
    && runnable_excludes_corpus_co_residence(profile: gate_runnable_profile(g: DagCompileCleanGate))
}

fn witness_floor_no_corpus_resource_edge_to_compile_anchor(spec: CiSpec) -> Bool {
  fold(floor_corpus_exclusion_resource_edges(spec: spec), init: true, f: fn(ok, edge) {
    ok && (edge.dependent != floor_compile_root_node())
  })
}

data gunbc_floor_arm_time_budget_refusal_plan_functions_claim_executor_seed: List<String> = [
  floor_plan_function,
  plan_artifact_plan_function,
  falsifier_plan_function,
]

data gunbc_floor_arm_time_budget_refusal_plan_functions: List<String> = gunbc_floor_arm_time_budget_refusal_plan_functions_claim_executor_seed

fn gunbc_floor_arm_time_budget_refusal_plan_function_roster() -> List<String> {
  gunbc_floor_arm_time_budget_refusal_plan_functions_claim_executor_seed
}

fn gunbc_floor_arm_time_budget_refusal_applies(plan_function: String) -> Bool {
  any(gunbc_floor_arm_time_budget_refusal_plan_functions, f => f == plan_function)
}

fn witness_string_lists_have_same_members(a: List<String>, b: List<String>) -> Bool {
  (length(xs: a) == length(xs: b))
    && all(a, item => any(b, x => x == item))
    && all(b, item => any(a, x => x == item))
}

fn witness_floor_schedule_preserves_enrolled_set() -> Bool {
  witness_string_lists_have_same_members(
    a: gunbc_ci_floor_enrolled_runnable_labels_for(spec: gunbc_ci_spec),
    b: gunbc_ci_floor_schedule_runnable_labels(batches: gunbc_ci_floor_batches())
  )
}

fn witness_floor_arm_time_budget_refusal_plan_roster_authority() -> Bool {
  (length(xs: gunbc_floor_arm_time_budget_refusal_plan_functions) == 3)
    && gunbc_floor_arm_time_budget_refusal_applies(plan_function: floor_plan_function)
    && gunbc_floor_arm_time_budget_refusal_applies(plan_function: plan_artifact_plan_function)
    && gunbc_floor_arm_time_budget_refusal_applies(plan_function: falsifier_plan_function)
}

fn witness_floor_arm_time_budget_refusal_materialized_roster_matches_seed() -> Bool {
  witness_string_lists_have_same_members(
    a: gunbc_floor_arm_time_budget_refusal_plan_functions_claim_executor_seed,
    b: gunbc_floor_arm_time_budget_refusal_plan_function_roster()
  )
}

fn gunbc_pr_native_batches() -> List<List<Runnable>> {
  [[gunbc_pr_native_batch()]]
}
