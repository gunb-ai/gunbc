data ci_floor_target_digest: ContentHash = "gunbc-ci-floor-v1"

data ci_floor_compile_gate_fn: String = "dsl_compile_clean_gate_passes"

data floor_gate_witness_entry: String = "dsl/tools/floor_effect_gate_witness.dag"

data floor_source_root_ingest_gate_entry: String = "src/v2/workflow/source_root_ingest_gate.dag"

data floor_self_host_realized_comparison_gate_entry: String = "src/v2/workflow/self_host_realized_comparison_gate.dag"

data floor_corpus_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^gunbc_floor_corpus } },
  children: []
}

data floor_grounding_whole_tree_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^gunbc_floor_grounding_whole_tree } },
  children: []
}

data floor_grounding_whole_tree_entry: String = "src/v2/test/manual/grounding_lens_whole_tree_test.dag"

data floor_grounding_whole_tree_function: String = "grounding_lens_whole_tree_witnesses"

fn gate_node(g: Gate) -> Node {
  match g {
    RustMonolithGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_rust } }, children: [] }
    EmitHostGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_emit } }, children: [] }
    LayeringImportsGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_layering } }, children: [] }
    ExtdepsExternalAuthorityGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_extdeps_external_authority } }, children: [] }
    DslCompileCleanGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_compile } }, children: [] }
    GeneratedArtifactDriftGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_generated_artifact } }, children: [] }
    SourceRootIngestGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_sourceingest } }, children: [] }
    RegenVerifyGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_regen_verify } }, children: [] }
    SelfHostRealizedComparisonGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_self_host_realized_comparison } }, children: [] }
    EmitDeterminismGate => Node { kind: TypeNode { connective: Atom { identity: ^gunbc_floor_gate_emit_determinism } }, children: [] }
  }
}

data ci_floor_compile_perturb_entry: String = "dsl/tools/dsl_compile_clean_perturb_witness.dag"

data floor_compile_clean_shard_barrier_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^gunbc_floor_compile_clean_shard } },
  children: [],
  occurrence_id: node_occurrence_minted(id: OccurrenceId { value: 0 })
}

fn compile_clean_shard_barrier_node_count() -> Int {
  if compile_clean_sharding_enabled() { 1 } else { 0 }
}

fn floor_compile_root_node() -> Node {
  if compile_clean_sharding_enabled() {
    floor_compile_clean_shard_barrier_node
  } else {
    gate_node(g: DslCompileCleanGate)
  }
}

fn floor_is_compile_clean_shard_node(node: Node) -> Bool {
  compile_clean_sharding_enabled()
    && (node.kind == floor_compile_clean_shard_barrier_node.kind)
}

fn floor_gate_enrolled_in_plan(g: Gate) -> Bool {
  match g {
    DslCompileCleanGate => !compile_clean_sharding_enabled()
    _ => true
  }
}

fn floor_resource_anchor_node(node: Node) -> Bool {
  floor_is_compile_clean_shard_node(node: node) || (node == floor_corpus_node) || (node == execution_corpus_node)
}

fn gate_runnable_profile(g: Gate) -> RunnableResourceProfile {
  let per_shard = runnable_memory_substantial(predicted_peak: gunbc_ci_floor_per_shard_peak_rss_bytes())
  let host_compiler = runnable_memory_substantial(predicted_peak: gunbc_ci_floor_host_compiler_spawn_peak)
  match g {
    DslCompileCleanGate =>
      runnable_resource_profile(
        heavy_whole_tree_resolve: true,
        spawns_host_compiler: false,
        memory: per_shard
      )
    SourceRootIngestGate =>
      runnable_resource_profile(
        heavy_whole_tree_resolve: true,
        spawns_host_compiler: false,
        memory: per_shard
      )
    RegenVerifyGate =>
      runnable_resource_profile(
        heavy_whole_tree_resolve: true,
        spawns_host_compiler: true,
        memory: runnable_memory_substantial_sum(left: per_shard, right: host_compiler)
      )
    SelfHostRealizedComparisonGate =>
      runnable_resource_profile(
        heavy_whole_tree_resolve: false,
        spawns_host_compiler: false,
        memory: per_shard
      )
    EmitDeterminismGate =>
      runnable_resource_profile(
        heavy_whole_tree_resolve: true,
        spawns_host_compiler: true,
        memory: runnable_memory_substantial_sum(left: per_shard, right: host_compiler)
      )
    EmitHostGate =>
      runnable_resource_profile(
        heavy_whole_tree_resolve: false,
        spawns_host_compiler: true,
        memory: host_compiler
      )
    RustMonolithGate => runnable_resource_profile_negligible()
    LayeringImportsGate => runnable_resource_profile_negligible()
    ExtdepsExternalAuthorityGate => runnable_resource_profile_negligible()
    GeneratedArtifactDriftGate => runnable_resource_profile_negligible()
  }
}

fn gate_runnable(g: Gate) -> Runnable {
  let profile = gate_runnable_profile(g: g)
  match g {
    RustMonolithGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "rust_monolith_gate_passes", profile: profile }
    EmitHostGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "emit_host_gate_passes", profile: profile }
    LayeringImportsGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "layering_imports_gate_passes", profile: profile }
    ExtdepsExternalAuthorityGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "extdeps_external_authority_gate_passes", profile: profile }
    DslCompileCleanGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "dsl_compile_clean_gate_passes", profile: profile }
    GeneratedArtifactDriftGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "generated_artifact_drift_gate_passes", profile: profile }
    SourceRootIngestGate => RunnableSingleClaim {
      entry: floor_source_root_ingest_gate_entry,
      function: "source_root_ingest_gate_passes",
      profile: profile
    }
    RegenVerifyGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "regen_verify_gate_passes", profile: profile }
    SelfHostRealizedComparisonGate => RunnableSingleClaim {
      entry: floor_self_host_realized_comparison_gate_entry,
      function: "self_host_realized_comparison_gate_passes",
      profile: profile
    }
    EmitDeterminismGate => RunnableSingleClaim { entry: floor_gate_witness_entry, function: "emit_determinism_gate_passes", profile: profile }
  }
}

fn corpus_source_roots() -> List<String> {
  witness_layer_roots
}

fn grounding_whole_tree_profile() -> RunnableResourceProfile {
  runnable_resource_profile(
    heavy_whole_tree_resolve: true,
    spawns_host_compiler: false,
    memory: runnable_memory_substantial(predicted_peak: gunbc_ci_floor_per_shard_peak_rss_bytes())
  )
}

fn grounding_whole_tree_runnable() -> Runnable {
  RunnableSingleClaim {
    entry: floor_grounding_whole_tree_entry,
    function: floor_grounding_whole_tree_function,
    profile: grounding_whole_tree_profile()
  }
}

fn corpus_runnable() -> Runnable {
  RunnableDiscoveryBatch {
    source_roots: corpus_source_roots(),
    scan_dirs: witness_discovery_scan_dirs,
    explicit_entries: [],
    skip_unaffected_node_frontier: true,
    exclude_substrings: witness_exclusion_substrings,
    discovery_scope_dirs: [],
    spawn_width_cap: hardware_thread_count_value(t: gunbc_ci_floor_spawn_width_from_tree()),
    profile: runnable_resource_profile(
      heavy_whole_tree_resolve: true,
      spawns_host_compiler: false,
      memory: runnable_memory_substantial(predicted_peak: gunbc_ci_floor_per_shard_peak_rss_bytes())
    )
  }
}

data execution_corpus_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^gunbc_floor_execution_corpus } },
  children: []
}

fn execution_corpus_spawn_width() -> Int {
  gunbc_ci_execution_corpus_available_width(each: gunbc_ci_floor_execution_corpus_per_witness_rss)
}

fn execution_corpus_runnable() -> Runnable {
  RunnableDiscoveryBatch {
    source_roots: corpus_source_roots(),
    scan_dirs: [],
    explicit_entries: [],
    skip_unaffected_node_frontier: true,
    exclude_substrings: [],
    discovery_scope_dirs: ["src/v2/test/claim/execution"],
    spawn_width_cap: execution_corpus_spawn_width(),
    profile: runnable_resource_profile(
      heavy_whole_tree_resolve: true,
      spawns_host_compiler: false,
      memory: runnable_memory_substantial(predicted_peak: gunbc_ci_floor_execution_corpus_per_witness_rss)
    )
  }
}

fn floor_nodes(spec: CiSpec) -> List<Node> {
  if compile_clean_sharding_enabled() {
    let gate_nodes = fold(spec.gates, init: [], f: fn(acc, g) {
      match g {
        DslCompileCleanGate => acc
        _ => list_snoc_item(xs: acc, item: gate_node(g: g))
      }
    })
    concat(
      [floor_corpus_node, execution_corpus_node, floor_grounding_whole_tree_node],
      concat([floor_compile_clean_shard_barrier_node], gate_nodes)
    )
  } else {
    fold(spec.gates, init: [floor_corpus_node, execution_corpus_node, floor_grounding_whole_tree_node], f: fn(acc, g) {
      list_snoc_item(xs: acc, item: gate_node(g: g))
    })
  }
}

fn floor_depends_on_compile(dependent: Node) -> DependencyView {
  DependencyView {
    source: floor_compile_root_node(),
    dependent: dependent,
    kind: DataDependsOn,
    usage_site: dependent
  }
}

fn floor_resource_depends_on(source: Node, dependent: Node) -> DependencyView {
  DependencyView {
    source: source,
    dependent: dependent,
    kind: ResourceDependsOn,
    usage_site: dependent
  }
}

fn floor_corpus_exclusion_resource_edges(spec: CiSpec) -> List<DependencyView> {
  let after_floor_corpus = [
    floor_resource_depends_on(source: floor_corpus_node, dependent: execution_corpus_node),
    floor_resource_depends_on(source: floor_corpus_node, dependent: floor_grounding_whole_tree_node),
    floor_resource_depends_on(source: execution_corpus_node, dependent: floor_grounding_whole_tree_node)
  ]
  fold(spec.gates, init: after_floor_corpus, f: fn(acc, g) {
    if !floor_gate_enrolled_in_plan(g: g) {
      acc
    } else {
      let node = gate_node(g: g)
      if floor_resource_anchor_node(node: node) {
        acc
      } else if runnable_excludes_corpus_co_residence(profile: gate_runnable_profile(g: g)) {
        list_snoc_item(
          xs: list_snoc_item(
            xs: acc,
            item: floor_resource_depends_on(source: floor_corpus_node, dependent: node)
          ),
          item: floor_resource_depends_on(source: execution_corpus_node, dependent: node)
        )
      } else {
        acc
      }
    }
  })
}

fn floor_heavy_resolve_chain_resource_edges(spec: CiSpec) -> List<DependencyView> {
  let heavy_nodes = fold(spec.gates, init: [], f: fn(acc, g) {
    if !floor_gate_enrolled_in_plan(g: g) {
      acc
    } else {
      let node = gate_node(g: g)
      if floor_resource_anchor_node(node: node) {
        acc
      } else if runnable_heavy_whole_tree_resolve(profile: gate_runnable_profile(g: g)) {
        list_snoc_item(xs: acc, item: node)
      } else {
        acc
      }
    }
  })
  let heavy_nodes = list_snoc_item(xs: heavy_nodes, item: floor_grounding_whole_tree_node)
  zip_map(
    a: heavy_nodes,
    b: skip(xs: heavy_nodes, n: 1),
    f: fn(prev, next) {
      floor_resource_depends_on(source: prev, dependent: next)
    }
  )
}

fn floor_data_dependencies(spec: CiSpec) -> List<DependencyView> {
  fold(
    spec.gates,
    init: [
      floor_depends_on_compile(dependent: floor_corpus_node),
      floor_depends_on_compile(dependent: execution_corpus_node),
      floor_depends_on_compile(dependent: floor_grounding_whole_tree_node)
    ],
    f: fn(acc, g) {
      match g {
        DslCompileCleanGate => acc
        _ => list_snoc_item(
          xs: acc,
          item: floor_depends_on_compile(dependent: gate_node(g: g))
        )
      }
    }
  )
}

fn floor_regen_emit_artifact_resource_edges(spec: CiSpec) -> List<DependencyView> {
  let has_self_host = fold(spec.gates, init: false, f: fn(acc, g) {
    match g {
      SelfHostRealizedComparisonGate => true
      _ => acc
    }
  })
  if has_self_host {
    [
      floor_resource_depends_on(
        source: gate_node(g: RegenVerifyGate),
        dependent: gate_node(g: SelfHostRealizedComparisonGate)
      )
    ]
  } else {
    []
  }
}

fn floor_resource_dependencies(spec: CiSpec) -> List<DependencyView> {
  concat(
    floor_corpus_exclusion_resource_edges(spec: spec),
    concat(
      floor_heavy_resolve_chain_resource_edges(spec: spec),
      floor_regen_emit_artifact_resource_edges(spec: spec)
    )
  )
}

fn floor_dependencies_with(spec: CiSpec, serialize_heavy: Bool) -> List<DependencyView> {
  let data_deps = floor_data_dependencies(spec: spec)
  if serialize_heavy {
    concat(data_deps, floor_resource_dependencies(spec: spec))
  } else {
    data_deps
  }
}

fn floor_dependencies(spec: CiSpec) -> List<DependencyView> {
  floor_dependencies_with(spec: spec, serialize_heavy: true)
}

fn compile_clean_perturb_runnables() -> List<Runnable> {
  let entry = ci_floor_compile_perturb_entry
  let profile = runnable_resource_profile_negligible()
  [
    RunnableSingleClaim { entry: entry, function: "compile_clean_perturb_optional_skew_passes", profile: profile },
    RunnableSingleClaim { entry: entry, function: "compile_clean_perturb_unresolved_import_passes", profile: profile },
    RunnableSingleClaim { entry: entry, function: "compile_clean_perturb_cross_tree_import_passes", profile: profile },
    RunnableSingleClaim { entry: entry, function: "compile_clean_perturb_dsl_shell_primary_passes", profile: profile }
  ]
}

fn compile_clean_batch_runnables() -> List<Runnable> {
  concat(
    [
      compile_clean_shard_batch_runnable(
        spawn_width_cap: hardware_thread_count_value(t: gunbc_ci_floor_spawn_width_from_tree())
      )
    ],
    compile_clean_perturb_runnables()
  )
}

fn batch_jobs_are_all_compile_shards(jobs: List<ExecutorJob>) -> Bool {
  (length(xs: jobs) == compile_clean_shard_barrier_node_count())
    && fold(jobs, init: true, f: fn(ok, job) {
      ok && floor_is_compile_clean_shard_node(node: job.node)
    })
}

fn floor_unrunnable_sentinel() -> Runnable {
  RunnableSingleClaim {
    entry: "",
    function: "__gunbc_ci_floor_unmapped__",
    profile: runnable_resource_profile_negligible()
  }
}

fn runnable_for_node(node: Node, spec: CiSpec) -> Runnable {
  if node == floor_corpus_node {
    corpus_runnable()
  } else if node == execution_corpus_node {
    execution_corpus_runnable()
  } else if node == floor_grounding_whole_tree_node {
    grounding_whole_tree_runnable()
  } else if floor_is_compile_clean_shard_node(node: node) {
    compile_clean_shard_batch_runnable(
      spawn_width_cap: hardware_thread_count_value(t: gunbc_ci_floor_spawn_width_from_tree())
    )
  } else {
    fold(spec.gates, init: floor_unrunnable_sentinel(), f: fn(acc, g) {
      if node == gate_node(g: g) { gate_runnable(g: g) } else { acc }
    })
  }
}

fn runnables_for_batch(batch: ExecutorBatch, spec: CiSpec) -> List<Runnable> {
  if compile_clean_sharding_enabled()
    && batch_jobs_are_all_compile_shards(jobs: batch.jobs) {
    compile_clean_batch_runnables()
  } else {
    fold(batch.jobs, init: [], f: fn(acc, job) {
      list_snoc_item(xs: acc, item: runnable_for_node(node: job.node, spec: spec))
    })
  }
}

fn floor_schedule_for_dependencies(dependencies: List<DependencyView>) -> List<List<Runnable>> {
  match parallel_executor_plan_from_dependencies(
    nodes: floor_nodes(spec: gunbc_ci_spec),
    dependencies: dependencies,
    scheduled: []
  ) {
    ExecutorRunComplete { batches: batches, scheduled: _ } =>
      fold(batches, init: [], f: fn(acc, batch) {
        list_snoc_item(xs: acc, item: runnables_for_batch(batch: batch, spec: gunbc_ci_spec))
      })
    ExecutorRunRunnable { batch: _, scheduled: _, remaining: _ } => [[floor_unrunnable_sentinel()]]
    ExecutorRunBlocked { evidence: _, batches: _, scheduled: _, remaining: _ } => [[floor_unrunnable_sentinel()]]
  }
}

fn gunbc_ci_floor_schedule_inner() -> List<List<Runnable>> {
  floor_schedule_for_dependencies(dependencies: floor_dependencies(spec: gunbc_ci_spec))
}

fn gunbc_ci_floor_schedule_without_serialization() -> List<List<Runnable>> {
  floor_schedule_for_dependencies(
    dependencies: floor_dependencies_with(spec: gunbc_ci_spec, serialize_heavy: false)
  )
}

fn gunbc_ci_floor_realization_plan() -> RealizationPlan {
  RealizationPlan {
    target: ci_floor_target_digest
    objective: RealizationObjective { goals: width_fold_objective_goals() }
    schedule: gunbc_ci_floor_schedule_inner()
    total: cost_account_predicted_zero()
  }
}

fn gunbc_ci_floor_batches() -> List<List<Runnable>> {
  gunbc_ci_floor_realization_plan().schedule
}

fn gunbc_ci_floor_schedule_lens_holds() -> Bool {
  match schedule_lens_verdict_for_ci_floor(
    plan: gunbc_ci_floor_realization_plan(),
    compile_gate_fn: ci_floor_compile_gate_fn,
    compile_clean_sharded: compile_clean_sharding_enabled()
  ) {
    Holds => true
    Violation { diagnostic: _ } => false
    NotApplicable { diagnostic: _ } => false
    Unrealized { diagnostic: _ } => false
  }
}

fn gunbc_ci_floor_breadth() -> Int {
  length(xs: gunbc_ci_spec.gates)
}

fn gunbc_ci_floor_hardware_threads() -> HardwareThreadCount {
  altra_max_m12830_catalog.threads
}

fn gunbc_ci_floor_spawn_width_for_budget(memory_budget: ByteSize) -> HardwareThreadCount {
  let budget_count = byte_size_count(b: memory_budget)
  if budget_count <= 0 {
    hardware_thread_count(count: int_min(a: gunbc_ci_floor_conservative_fallback_width, b: execution_corpus_spawn_width()))
  } else {
    let cpu_bound = hardware_thread_count_value(t: bounded_host_spawn_width(
      shard_count: gunbc_ci_floor_breadth(),
      hardware_threads: gunbc_ci_floor_hardware_threads()
    ))
    hardware_thread_count(count: gunbc_ci_floor_memory_derived_width(cap: memory_budget, cpu_bound: cpu_bound))
  }
}

fn gunbc_ci_floor_spawn_width_from_tree() -> HardwareThreadCount {
  gunbc_ci_floor_spawn_width_for_budget(memory_budget: srv1_floor_memory_budget())
}

fn gunbc_ci_plan_spawn_width(memory_budget_bytes: Int) -> HardwareThreadCount {
  gunbc_ci_floor_spawn_width_for_budget(memory_budget: byte_size(memory_budget_bytes))
}

fn gunbc_ci_floor_run_envelope(memory_budget_bytes: Int) -> ResourceEnvelope {
  parallel_run_demand_envelope(
    width: gunbc_ci_floor_spawn_width_for_budget(memory_budget: byte_size(memory_budget_bytes)),
    per_shard_peak: gunbc_ci_floor_per_shard_peak_rss_bytes()
  )
}

fn witness_floor_tight_budget_backs_off_envelope() -> Bool {
  let tight_budget = 10000000000
  let envelope = gunbc_ci_floor_run_envelope(memory_budget_bytes: tight_budget)

  demand_envelope_thread_count(envelope: envelope) < gunbc_ci_floor_breadth()
    && demand_envelope_fits_budget(envelope: envelope, budget: byte_size(tight_budget))
}

fn witness_floor_fail_open_would_exceed_budget() -> Bool {
  let tight_budget = 10000000000
  let blind_envelope = parallel_run_demand_envelope(
    width: bounded_host_spawn_width(
      shard_count: gunbc_ci_floor_breadth(),
      hardware_threads: gunbc_ci_floor_hardware_threads()
    ),
    per_shard_peak: gunbc_ci_floor_per_shard_peak_rss_bytes()
  )
  demand_envelope_fits_budget(envelope: blind_envelope, budget: byte_size(tight_budget)) == false
}

fn witness_floor_width_governed_by_budget_tree() -> Bool {
  let tree_width = hardware_thread_count_value(t: gunbc_ci_floor_spawn_width_from_tree())
  let cpu_only_width = hardware_thread_count_value(t: bounded_host_spawn_width(shard_count: gunbc_ci_floor_breadth(), hardware_threads: gunbc_ci_floor_hardware_threads()))
  return tree_width < cpu_only_width
}

fn witness_floor_width_derived_from_tree_is_positive() -> Bool {
  byte_size_count(b: srv1_floor_memory_budget()) > 0
    && hardware_thread_count_value(t: gunbc_ci_floor_spawn_width_from_tree()) > 0
}

fn witness_floor_spawn_width_tight_budget_backs_off() -> Bool {
  let tight = 10000000000
  let width = hardware_thread_count_value(t: gunbc_ci_plan_spawn_width(memory_budget_bytes: tight))
  width < gunbc_ci_floor_breadth()
}

fn witness_floor_spawn_width_zero_budget_falls_back() -> Bool {
  let width = hardware_thread_count_value(t: gunbc_ci_plan_spawn_width(memory_budget_bytes: 0))
  width == int_min(
    a: gunbc_ci_floor_conservative_fallback_width,
    b: execution_corpus_spawn_width()
  )
}

fn floor_batch_heavy_gate_resolve_count(batch: List<Runnable>) -> Int {
  fold(batch, init: 0, f: fn(acc, r) {
    match r {
      RunnableDiscoveryBatch { source_roots: _, scan_dirs: _, explicit_entries: _, skip_unaffected_node_frontier: _, exclude_substrings: _, discovery_scope_dirs: _, spawn_width_cap: _, profile: _ } => acc
      RunnableCompileCleanShardBatch { entry_paths: _, spawn_width_cap: _, profile: _ } => acc
      RunnableKernelWorkload { fused_op_count: _ } => acc
      RunnableSingleClaim { entry: _, function: f, profile: p } =>
        if f == ci_floor_compile_gate_fn {
          acc
        } else if runnable_heavy_whole_tree_resolve(profile: p) {
          acc + 1
        } else {
          acc
        }
    }
  })
}

fn floor_batch_zero_compile_clean_shard_entry_paths() -> List<String> {
  schedule_batch_compile_clean_shard_entry_paths(batch: gunbc_ci_floor_batches().first())
}

fn gunbc_ci_floor_compile_clean_shard_count() -> Int {
  length(xs: floor_batch_zero_compile_clean_shard_entry_paths())
}

fn witness_floor_batch_one_uses_compile_clean_shards() -> Bool {
  let batch0 = gunbc_ci_floor_batches().first()
  schedule_batch_contains_label(batch: batch0, target: compile_clean_shard_batch_label)
}

fn witness_floor_batch_one_has_no_compile_gate_monolith() -> Bool {
  let batch0 = gunbc_ci_floor_batches().first()
  !schedule_batch_contains_label(batch: batch0, target: ci_floor_compile_gate_fn)
}

fn witness_floor_shard_roster_coverage_in_plan() -> Bool {
  witness_shard_roster_coverage(
    full: compile_clean_shard_entry_paths(),
    plan_paths: floor_batch_zero_compile_clean_shard_entry_paths()
  )
}

fn witness_floor_dropped_shard_red_control() -> Bool {
  witness_dropped_shard_breaks_coverage(
    full: compile_clean_shard_entry_paths(),
    plan_paths: floor_batch_zero_compile_clean_shard_entry_paths()
  )
}

fn floor_plan_at_most_one_heavy_gate_resolve_per_batch(batches: List<List<Runnable>>) -> Bool {
  fold(batches, init: true, f: fn(ok, batch) {
    ok && (floor_batch_heavy_gate_resolve_count(batch: batch) <= 1)
  })
}

fn gunbc_ci_floor_plan_serializes_heavy_resolves() -> Bool {
  floor_plan_at_most_one_heavy_gate_resolve_per_batch(batches: gunbc_ci_floor_batches())
}

fn gunbc_ci_floor_plan_co_runs_heavy_without_serialization() -> Bool {
  floor_plan_at_most_one_heavy_gate_resolve_per_batch(
    batches: gunbc_ci_floor_schedule_without_serialization()
  ) == false
}

fn witness_floor_corpus_exclusion_edges_exist() -> Bool {
  length(xs: floor_corpus_exclusion_resource_edges(spec: gunbc_ci_spec)) > 0
}

fn witness_floor_compile_gate_honest_heavy_profile() -> Bool {
  if compile_clean_sharding_enabled() {
    !runnable_heavy_whole_tree_resolve(profile: compile_clean_shard_batch_profile())
      && runnable_excludes_corpus_co_residence(profile: compile_clean_shard_batch_profile())
  } else {
    runnable_heavy_whole_tree_resolve(profile: gate_runnable_profile(g: DslCompileCleanGate))
      && runnable_excludes_corpus_co_residence(profile: gate_runnable_profile(g: DslCompileCleanGate))
  }
}

fn witness_floor_no_corpus_resource_edge_to_compile_anchor() -> Bool {
  fold(floor_corpus_exclusion_resource_edges(spec: gunbc_ci_spec), init: true, f: fn(ok, edge) {
    if compile_clean_sharding_enabled() {
      ok && !floor_is_compile_clean_shard_node(node: edge.dependent)
    } else {
      ok && (edge.dependent != floor_compile_root_node())
    }
  })
}

fn witness_corpus_effective_widths_fit_runner_cap() -> Bool {
  let cap = byte_size_count(b: gunbc_ci_runner_cgroup_memory_cap)
  let base = byte_size_count(b: gunbc_ci_floor_executor_base_overhead_bytes())
  let floor_cap_w = hardware_thread_count_value(t: gunbc_ci_floor_spawn_width_from_tree())
  let floor_committed = base + floor_cap_w * byte_size_count(b: gunbc_ci_floor_per_shard_peak_rss_bytes())
  let exec_cap_w = execution_corpus_spawn_width()
  let exec_committed = base + exec_cap_w * byte_size_count(b: gunbc_ci_floor_execution_corpus_per_witness_rss)
  floor_committed <= cap && exec_committed <= cap
}

fn witness_floor_derived_width_leaves_headroom_at_cap() -> Bool {
  let width = gunbc_ci_floor_memory_derived_width(cap: gunbc_ci_runner_cgroup_memory_cap, cpu_bound: 128)
  let committed = byte_size_count(b: gunbc_ci_floor_per_shard_peak_rss_bytes()) * width
  committed < byte_size_count(b: gunbc_ci_runner_cgroup_memory_cap)
}

