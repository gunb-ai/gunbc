module v2.workflow.scheduler

import v2.std.collection { List, list_at_optional, optional_present_witness }
import v2.std.algebra {
  contains,
  filter,
  for_all,
  is_empty,
  list_append,
  list_snoc_item,
  non_empty
}
import v2.std.dependency {
  DependencyKindClassifier,
  DependencyRelation,
  DependencyView,
  ReadinessLayer,
  classify_dependency_kind,
  dependency_view_relations,
  topological_layers
}
import v2.std.node { Node }
import v2.std.witness { Holds, Violates, Witness }

// THE SCHEDULING CARRIERS ARE PARAMETRIC IN THEIR SUBJECT.
//
// Frontier, layering, completion and blocked-evidence are facts about a prerequisite graph, not
// about program structure, so they are stated once over a subject parameter. The compiler binds the
// subject to Node; host convergence binds it to a planned operation identity. Neither is privileged
// and there is exactly one implementation, so cycle refusal and readiness cannot drift apart between
// them -- which is the whole reason this is a parameterization rather than a second scheduler.
type RunnableFrontier<Subject> {
  ready: List<Subject>
}

type SchedulerBlockedEvidence
  = SchedulerNoRunnableFrontier {}

type SchedulerPlan<Subject>
  = SchedulerPlanComplete {
      layers: List<ReadinessLayer<Subject>>,
      scheduled: List<Subject>
    }
  | SchedulerPlanRunnable {
      frontier: RunnableFrontier<Subject>,
      scheduled: List<Subject>,
      remaining: List<Subject>,
      layers: List<ReadinessLayer<Subject>>
    }
  | SchedulerPlanBlocked {
      evidence: SchedulerBlockedEvidence,
      scheduled: List<Subject>,
      remaining: List<Subject>,
      layers: List<ReadinessLayer<Subject>>
    }

type SchedulerRunState<Subject> {
  scheduled: List<Subject>
  remaining: List<Subject>
  layers: List<ReadinessLayer<Subject>>
  frontier: RunnableFrontier<Subject>
}

fn scheduler_execution_dependency_kind_classifier() -> DependencyKindClassifier<Bool> {
  DependencyKindClassifier {
    contains: false,
    binds_to: false,
    type_depends_on: false,
    data_depends_on: true,
    effect_depends_on: true,
    resource_depends_on: true,
    module_depends_on: false,
    barrier_before: true,
    placement_depends_on: false,
    model_depends_on: false,
    projection_depends_on: false,
    generated_from: false,
    verified_by: false,
    promoted_by: false,
    bootstrap_depends_on: true
  }
}

fn scheduler_relation_orders_execution<S>(relation: DependencyRelation<S>) -> Bool {
  classify_dependency_kind(
    classifier: scheduler_execution_dependency_kind_classifier(),
    kind: relation.kind
  )
}

fn scheduler_execution_relations<S>(
  relations: List<DependencyRelation<S>>
) -> List<DependencyRelation<S>> {
  filter(xs: relations, predicate: scheduler_relation_orders_execution)
}

fn scheduler_append_subject_once<S>(xs: List<S>, item: S, eq: fn(S, S) -> Bool) -> List<S> {
  if contains(xs: xs, item: item, eq: eq) {
    xs
  } else {
    list_snoc_item(xs: xs, item: item)
  }
}

fn scheduler_relation_subjects<S>(
  relations: List<DependencyRelation<S>>,
  eq: fn(S, S) -> Bool
) -> List<S> {
  fold(relations, init: [], f: fn(acc, relation) {
    scheduler_append_subject_once(
      xs: scheduler_append_subject_once(xs: acc, item: relation.prerequisite, eq: eq),
      item: relation.dependent,
      eq: eq
    )
  })
}

fn scheduler_relation_unblocked<S>(
  relation: DependencyRelation<S>,
  scheduled: List<S>,
  candidate: S,
  eq: fn(S, S) -> Bool
) -> Bool {
  if eq(relation.dependent, candidate) {
    contains(xs: scheduled, item: relation.prerequisite, eq: eq)
  } else {
    true
  }
}

fn scheduler_subject_unblocked<S>(
  relations: List<DependencyRelation<S>>,
  scheduled: List<S>,
  candidate: S,
  eq: fn(S, S) -> Bool
) -> Bool {
  for_all(
    xs: relations,
    predicate: fn(relation) {
      scheduler_relation_unblocked(
        relation: relation,
        scheduled: scheduled,
        candidate: candidate,
        eq: eq
      )
    }
  )
}

fn scheduler_subject_unscheduled<S>(scheduled: List<S>, candidate: S, eq: fn(S, S) -> Bool) -> Bool {
  contains(xs: scheduled, item: candidate, eq: eq) == false
}

fn runnable_frontier_from_relations<S>(
  subjects: List<S>,
  relations: List<DependencyRelation<S>>,
  scheduled: List<S>,
  eq: fn(S, S) -> Bool
) -> RunnableFrontier<S> {
  let execution_relations = scheduler_execution_relations(relations: relations)
  RunnableFrontier {
    ready: filter(
      xs: subjects,
      predicate: fn(candidate) {
        scheduler_subject_unscheduled(scheduled: scheduled, candidate: candidate, eq: eq)
          && scheduler_subject_unblocked(
            relations: execution_relations,
            scheduled: scheduled,
            candidate: candidate,
            eq: eq
          )
      }
    )
  }
}

fn scheduler_remaining_subjects<S>(
  subjects: List<S>,
  scheduled: List<S>,
  eq: fn(S, S) -> Bool
) -> List<S> {
  filter(
    xs: subjects,
    predicate: fn(candidate) {
      scheduler_subject_unscheduled(scheduled: scheduled, candidate: candidate, eq: eq)
    }
  )
}

fn scheduler_blocked_evidence() -> SchedulerBlockedEvidence {
  SchedulerNoRunnableFrontier {}
}

fn scheduler_schedule_frontier<S>(
  scheduled: List<S>,
  frontier: RunnableFrontier<S>,
  eq: fn(S, S) -> Bool
) -> List<S> {
  fold(frontier.ready, init: scheduled, f: fn(acc, item) {
    scheduler_append_subject_once(xs: acc, item: item, eq: eq)
  })
}

fn scheduler_append_frontier_layer<S>(
  layers: List<ReadinessLayer<S>>,
  frontier: RunnableFrontier<S>
) -> List<ReadinessLayer<S>> {
  if non_empty(xs: frontier.ready) {
    list_snoc_item(
      xs: layers,
      item: ReadinessLayer { ready: frontier.ready }
    )
  } else {
    layers
  }
}

fn scheduler_run_init<S>(
  subjects: List<S>,
  scheduled: List<S>,
  eq: fn(S, S) -> Bool
) -> SchedulerRunState<S> {
  SchedulerRunState {
    scheduled: scheduled,
    remaining: scheduler_remaining_subjects(subjects: subjects, scheduled: scheduled, eq: eq),
    layers: [],
    frontier: RunnableFrontier { ready: [] }
  }
}

fn scheduler_step_state_from_relations<S>(
  subjects: List<S>,
  relations: List<DependencyRelation<S>>,
  state: SchedulerRunState<S>,
  eq: fn(S, S) -> Bool
) -> SchedulerRunState<S> {
  if is_empty(xs: state.remaining) {
    state
  } else {
    let frontier = runnable_frontier_from_relations(
      subjects: subjects,
      relations: relations,
      scheduled: state.scheduled,
      eq: eq
    )
    if non_empty(xs: frontier.ready) {
      let scheduled = scheduler_schedule_frontier(scheduled: state.scheduled, frontier: frontier, eq: eq)
      SchedulerRunState {
        scheduled: scheduled,
        remaining: scheduler_remaining_subjects(subjects: subjects, scheduled: scheduled, eq: eq),
        layers: scheduler_append_frontier_layer(layers: state.layers, frontier: frontier),
        frontier: frontier
      }
    } else {
      SchedulerRunState {
        scheduled: state.scheduled,
        remaining: state.remaining,
        layers: state.layers,
        frontier: frontier
      }
    }
  }
}

fn scheduler_plan_from_state<S>(state: SchedulerRunState<S>) -> SchedulerPlan<S> {
  if is_empty(xs: state.remaining) {
    SchedulerPlanComplete {
      layers: state.layers,
      scheduled: state.scheduled
    }
  } else {
    if non_empty(xs: state.frontier.ready) {
      SchedulerPlanRunnable {
        frontier: state.frontier,
        scheduled: state.scheduled,
        remaining: state.remaining,
        layers: state.layers
      }
    } else {
      SchedulerPlanBlocked {
        evidence: scheduler_blocked_evidence(),
        scheduled: state.scheduled,
        remaining: state.remaining,
        layers: state.layers
      }
    }
  }
}

fn scheduler_step_plan_from_relations<S>(
  subjects: List<S>,
  relations: List<DependencyRelation<S>>,
  scheduled: List<S>,
  eq: fn(S, S) -> Bool
) -> SchedulerPlan<S> {
  scheduler_plan_from_state(
    state: scheduler_step_state_from_relations(
      subjects: subjects,
      relations: relations,
      state: scheduler_run_init(subjects: subjects, scheduled: scheduled, eq: eq),
      eq: eq
    )
  )
}

// THE FIXED POINT IS BOUNDED BY THE SUBJECT COUNT, which is why this is a fold over the subjects
// rather than a loop with its own termination argument: each step schedules at least one subject or
// the frontier is empty and the state stops changing, so one pass per subject reaches the fixed
// point for any acyclic graph and a cyclic one lands in the blocked arm rather than spinning.
fn scheduler_run_to_fixed_point<S>(
  subjects: List<S>,
  relations: List<DependencyRelation<S>>,
  scheduled: List<S>,
  eq: fn(S, S) -> Bool
) -> SchedulerRunState<S> {
  fold(subjects, init: scheduler_run_init(subjects: subjects, scheduled: scheduled, eq: eq), f: fn(state, _) {
    scheduler_step_state_from_relations(
      subjects: subjects,
      relations: relations,
      state: state,
      eq: eq
    )
  })
}

fn scheduler_plan_from_relations<S>(
  subjects: List<S>,
  relations: List<DependencyRelation<S>>,
  scheduled: List<S>,
  eq: fn(S, S) -> Bool
) -> SchedulerPlan<S> {
  scheduler_plan_from_state(
    state: scheduler_run_to_fixed_point(
      subjects: subjects,
      relations: relations,
      scheduled: scheduled,
      eq: eq
    )
  )
}

fn scheduler_nodes_from_layers<S>(layers: List<ReadinessLayer<S>>) -> List<S> {
  fold(layers, init: [], f: fn(nodes, layer) {
    list_append(left: nodes, right: layer.ready)
  })
}

fn scheduler_plan_for_layers<S>(layers: List<ReadinessLayer<S>>, blocked: List<S>) -> SchedulerPlan<S> {
  let runnable = runnable_frontier_from_layers(layers: layers)
  if non_empty(xs: runnable.ready) {
    SchedulerPlanComplete {
      layers: layers,
      scheduled: scheduler_nodes_from_layers(layers: layers)
    }
  } else {
    SchedulerPlanBlocked {
      evidence: scheduler_blocked_evidence(),
      scheduled: [],
      remaining: blocked,
      layers: layers
    }
  }
}

fn scheduler_first_readiness_layer<S>(layers: List<ReadinessLayer<S>>) -> Witness<ReadinessLayer<S>> {
  optional_present_witness(
    opt: list_at_optional(xs: layers, index: 0)
  )
}

fn runnable_frontier_from_layers<S>(layers: List<ReadinessLayer<S>>) -> RunnableFrontier<S> {
  match scheduler_first_readiness_layer(layers: layers) {
    Holds { value: layer } => RunnableFrontier { ready: layer.ready }
    Violates { diagnostic: _ } => RunnableFrontier { ready: [] }
  }
}

fn runnable_frontier(graph_node: Node) -> RunnableFrontier<Node> {
  runnable_frontier_from_layers(layers: scheduler_layers(graph_node: graph_node))
}

fn scheduler_layers(graph_node: Node) -> List<ReadinessLayer<Node>> {
  topological_layers(graph_node: graph_node)
}

fn scheduler_plan(graph_node: Node) -> SchedulerPlan<Node> {
  scheduler_plan_for_layers(
    layers: scheduler_layers(graph_node: graph_node),
    blocked: [graph_node]
  )
}

// THE NODE-SUBJECT WRAPPERS. The kernel above is subject-generic; the compiler's own consumers
// schedule `Node` and supply structural identity, so the binding of `S = Node` with `node_eq`
// lives here once rather than at each call site.
fn scheduler_node_eq(left: Node, right: Node) -> Bool {
  left == right
}

fn runnable_frontier_from_dependencies(
  nodes: List<Node>,
  dependencies: List<DependencyView>,
  scheduled: List<Node>
) -> RunnableFrontier<Node> {
  runnable_frontier_from_relations(
    subjects: nodes,
    relations: dependency_view_relations(views: dependencies),
    scheduled: scheduled,
    eq: scheduler_node_eq
  )
}

fn scheduler_remaining_nodes(nodes: List<Node>, scheduled: List<Node>) -> List<Node> {
  scheduler_remaining_subjects(subjects: nodes, scheduled: scheduled, eq: scheduler_node_eq)
}

fn scheduler_append_node_once(nodes: List<Node>, candidate: Node) -> List<Node> {
  scheduler_append_subject_once(xs: nodes, item: candidate, eq: scheduler_node_eq)
}

fn scheduler_step_plan_from_dependencies(
  nodes: List<Node>,
  dependencies: List<DependencyView>,
  scheduled: List<Node>
) -> SchedulerPlan<Node> {
  scheduler_step_plan_from_relations(
    subjects: nodes,
    relations: dependency_view_relations(views: dependencies),
    scheduled: scheduled,
    eq: scheduler_node_eq
  )
}

fn scheduler_plan_from_dependencies(
  nodes: List<Node>,
  dependencies: List<DependencyView>,
  scheduled: List<Node>
) -> SchedulerPlan<Node> {
  scheduler_plan_from_relations(
    subjects: nodes,
    relations: dependency_view_relations(views: dependencies),
    scheduled: scheduled,
    eq: scheduler_node_eq
  )
}
