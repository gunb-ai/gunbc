module v2.workflow.source_root_ingest_gate

import v2.workflow.source_root_ingest_transport { run_real_ingest_gate }
import v2.workflow.compiler_closure_ingest_transport { run_compiler_closure_ingest_gate }
import v2.std.logic { Bool }

func source_root_ingest_gate_passes() -> Bool {
  run_real_ingest_gate() && run_compiler_closure_ingest_gate()
}
