module v2.workflow.ci_heal_skew_guard_emit


data ci_heal_skew_guard_emit_authority_note: String = "FOREIGN-EXECUTOR SHELL EMISSION FOR THE HEAL JOB'S BINARY/SOURCE SKEW GUARD AND ITS AUTO-REMEDY. Control flow is a v2.std.orchestration Pipeline of If / Not / Or / StrNonempty / Let / Exit nodes — orchestration, not bash-in-String — and every git leaf derives its argv from an extdeps.git shape declaration rather than a hand-spelled command. This module replaces the 55-line join([...]) that formerly lived at gunbc.ci_spec.gunbc_ci_heal_binary_source_skew_guard_script, whose Scaffold and dissolution-trigger rows are deleted by the same change (the receipt: the scaffold is gone, not reworded). Kept in v2.workflow beside ci_regen_rustfmt_path_emit — the same placement, and for the same reason — so gunbc.ci_spec can import the rendered script without the ci_materialization <-> ci_spec cycle."

data ci_heal_skew_guard_refused_poison: String = "__GUNBC_ORCH_EMIT_REFUSED__ heal binary/source skew guard emission was rejected by v2.compiler.emit_orchestration; this marker is not valid workflow shell, so the committed ci.yml drift gate goes red rather than a hand-spelled fallback masking the refusal (DESIGN §5: refuse, never widen)\n"

data ci_heal_skew_guard_classification_note: String = "THE AUTHORED-CONFLICT CLASSIFICATION IS A DECISION OVER A MODELED LIST, SO IT IS NOT SHELL (DESIGN §2/§3). The prior cut space-joined committed_generated_artifact_paths() into a GENERATED_ARTIFACTS variable, iterated the conflicting paths with an unquoted `for`, and tested membership with a `case` glob against that string — a list serialized into a string and then re-parsed, which is the dual representation §3 forbids, and which review 44580 separately flagged as breaking on paths containing spaces. It is replaced by asking git for the COMPLEMENT directly: a `--diff-filter=U` diff limited to `.` minus one `:(exclude)<path>` pathspec per registered artifact. Non-empty means at least one conflicting path is NOT a registered generated artifact, which is exactly the refusal condition; empty means every conflict is auto-resolvable. VERIFIED BY EXECUTION against a real three-way conflict: both conflicts listed with no exclusions, only the authored path with the generated one excluded, and empty with both excluded. Two consequences beyond deleting the loop: the space-joined string and the unquoted iteration are gone by CONSTRUCTION rather than deferred (the review finding dissolves, §5 construction over validation), and 'mixed conflicts must refuse, never partially resolve' now holds because the classification completes BEFORE anything is resolved — the prior accumulator shape could only claim it by ordering discipline."

data ci_heal_skew_guard_for_step_residue_note: String = "WHY THERE IS NO `For` STEP HERE. v2.std.orchestration declares a For variant, but v2.compiler.emit_orchestration.orch_emit_step REFUSES it (^orch_emit_step_for_unsupported) — For has no emitter today. Rather than add one to a load-bearing pipeline stage to serve this one caller, both loops the prior shell carried were DISSOLVED: the classification loop by the `:(exclude)` pathspec complement above, and the resolution loop by a single NUL-delimited `xargs -0` application (see ci_heal_skew_resolve_note). Neither dissolution is a workaround for the missing emitter — each is the better model independently, because a per-path shell loop was re-deriving a set git can hand over whole. If a genuine ordered-iteration intent appears later, the emitter gap is the thing to fix then."

data ci_heal_skew_resolve_note: String = "RESOLUTION IS ONE NUL-DELIMITED APPLICATION, AND IT REFUSES RATHER THAN TOLERATING A FAILED CHECKOUT. `git diff --name-only --diff-filter=U -z | xargs -0 git checkout --ours --` replaces the per-path loop: NUL delimiting makes it correct for paths containing spaces or newlines, which the prior unquoted `for c in $CONFLICTS` was not. Both sides of the pipe are cited extdeps argv shapes — the producer from extdeps.git, the consumer from extdeps.exec.xargs, which carries xargs's own two authorities and the fidelity fact that `-0` is a GNU extension the POSIX spec does not define. WHICH operation feeds which is deliberately a WORKFLOW fact and not an extdeps row (DESIGN §3 (b)/(c)): 'feed this operation's output into that one' is this job's policy, not a fact about either dependency. The prior cut ran `git checkout --ours -- \"$c\" 2>/dev/null || true` and then staged the path REGARDLESS — a failed resolution would stage an unresolved file, which is the fabricated-plausible-output arm §5 forbids. Here a checkout failure propagates and the step refuses, because at that point every conflict is known to be a registered generated artifact and a checkout that cannot take our side means the resolution did not happen."

data ci_heal_skew_diag_note: String = "DIAGNOSTIC RENDERING HAS ONE AUTHORITY, NOT TWELVE HAND-SPELLED LINES. v2.std.orchestration models a bash Comment (a `#` line) but has no stderr-diagnostic step, and RedirectSpec.StdoutAndStderr is the `>&2` carrier the emitter already spells (extdeps.languages.bash bash_redir_stdout_to_stderr_phrase, literally \">&2\" — the variant name reads backwards but the emitted token is correct). So each operator-facing message is DATA passed to ci_heal_skew_diag, which owns the single `echo` + quoting + redirect spelling. That is the honest scope of the former 'multi-line stderr diagnostics have no modeled shape' gap: it needed one workflow-layer authority, not a new orchestration variant. Message text carries no double quote, so the surrounding quoting is total; the `$BUILT_FROM` expansion inside a message is intended and survives double quoting."

data ci_heal_skew_remedy_target_note: String = "THE REMEDY MERGES BUILT_FROM, NOT origin/BASE_REF, AND THAT IS THE DIFFERENCE BETWEEN CONVERGING AND LIVELOCKING. The guard's question is one-directional: does the revision the binary was built from carry seed (src/v1) source this tree lacks? BUILT_FROM (github.sha — on a pull_request, the synthetic merge ref) is that revision, and it is FIXED for the whole workflow run. The prior cut answered a skew against BUILT_FROM by merging `origin/$BASE_REF` — the LATEST base — which is a different revision of the base than the one the comparison is pinned to. So the remedy OVERSHOT its own target whenever the base advanced between the build and the heal job, and since the release build takes ~15 minutes on a base that merges more often than that, the post-remedy re-check found a difference and refused. Not a transient: it is unwinnable by re-running, because every re-run rebuilds against a newer base and the window reopens.\n\nMerging BUILT_FROM instead makes the re-check pass BY CONSTRUCTION rather than by luck (DESIGN §5 construction over validation): after `git merge \\\"$BUILT_FROM\\\"`, BUILT_FROM is an ancestor of HEAD, so `git rev-list HEAD..\\\"$BUILT_FROM\\\" -- src/v1` is empty for every input. The still-skewed arm is retained as a fail-closed backstop and its message now says the arm should be unreachable and that re-running is the wrong response — the prior text speculated 'the base moved again during this run', an explanation the receipt below falsifies.\n\nRECEIPT (measured on the live failing run 30497545614, PR #7420 @ 1fb763d18ac): the run refused with the two checks 350ms apart, so 'the base moved during this run' was impossible. The merge ref's base parent was b0c8eba0835 while origin/main had already advanced to 37ae94b8211 — exactly one intervening base commit, and it touched src/v1 — so merging the latest base pulled in seed source BUILT_FROM did not have. Merging BUILT_FROM on the same tree makes the seed-ahead set empty. Merging the base is also no longer NEEDED for the fetch: BUILT_FROM is already fetched by the provenance step and its resolvability is REFUSED on upfront, so the base fetch, the BASE_REF binding and the origin/BASE_REF spelling are deleted as dead rather than left as scaffolding."

data ci_heal_skew_indent_residue_note: String = "🟡 dissolve-on: ci_heal_skew_indent_commit_list — the one hand-spelled shell fragment left in this module, `echo \"$X\" | head -20 | sed 's/^/    /'`, which indents and caps a captured commit list for operator display. It is presentation over a captured stdout blob, and the irreducible kernel today for the same reason ci_regen_rustfmt_path_emit's `test -x` leaves are: there is no text-indent or bounded-list carrier to render it from. The `head -20` cap moved from the seed-ahead CAPTURE (where the prior cut had it) onto this DISPLAY leaf, which is behaviour-preserving for the guard's decision — a truncated non-empty list is still non-empty, so the emptiness test that drives every arm is unchanged — and keeps the operator output bounded. DISSOLVES WHEN a modeled diagnostic-list carrier renders an indented bounded list, at which point this leaf and ci_heal_skew_diag collapse into it."

data ci_heal_skew_built_from_binding: String = "\"${{ github.sha }}\""

data ci_heal_skew_workflow_ref_expr: String = "\"${{ github.ref }}\""

data ci_heal_skew_built_from_ref: String = "\"$BUILT_FROM\""

data ci_heal_skew_seed_path: String = "src/v1"

data ci_heal_skew_ahead_var: String = "SEED_AHEAD"

data ci_heal_skew_ahead_after_var: String = "SEED_AHEAD_AFTER"

data ci_heal_skew_conflicts_var: String = "CONFLICTS"

data ci_heal_skew_authored_conflicts_var: String = "AUTHORED_CONFLICTS"

data ci_heal_skew_still_unmerged_var: String = "STILL_UNMERGED"

data ci_heal_skew_commit_author_name: String = "gunbc-ci-auto-heal"

data ci_heal_skew_commit_author_email: String = "gunbc-ci-auto-heal@users.noreply.github.com"

data ci_heal_skew_indent_commit_list: String = "| head -20 | sed 's/^/    /'"

data ci_heal_skew_pipe_operator: String = " | "

data ci_heal_skew_pipe_residue_note: String = "🟡 dissolve-on: ci_heal_skew_pipe_operator — THE PIPE OPERATOR IS THE LAST TARGET-LANGUAGE TOKEN THIS MODULE SPELLS, AND CLOSING IT IS A SUBSTRATE DECISION, NOT A LOCAL ONE. Both operands are now cited argv shapes and both are joined by one local ci_heal_skew_shell_line, so what remains hand-spelled is the two-character bash operator between them. It cannot be sourced from the grammar that already models it: extdeps.languages.bash bash_pipe_phrase spells the ` | ` token, but that vocabulary is confined to the emit layer by v2.lens.realization_vocabulary_containment (LANDED #6854) and importing it HERE — a v2.workflow intent module — is precisely the leak that lens exists to red. So the honest options are exactly two, and both edit files DESIGN.md names load-bearing: a Pipe variant on v2.std.orchestration's PipelineStep, or a producer/consumer composition on Run, either way with an arm in v2.compiler.emit_orchestration. This module's brief explicitly directed 'do NOT build a new carrier', and the project spirit requires escalating before touching a load-bearing stage under a brief that predates the relevant model decision, so the token stays here, named and counted, rather than being smuggled in as a substrate change nobody asked for. DISSOLVES WHEN that carrier lands and this fn renders the composition structurally; the shape is already factored (ci_heal_skew_piped_command takes producer_argv and consumer_argv, so the call sites do not change when the body does)."

fn ci_heal_skew_git_run(argv: List<String>) -> v2.std.orchestration.Run {
  v2.std.orchestration.Run {
    command: ci_heal_skew_shell_line(argv: argv),
    env: [],
    redirect: Absent,
    capture: Absent
  }
}

fn ci_heal_skew_git_run_redirected(argv: List<String>, r: v2.std.orchestration.RedirectSpec) -> v2.std.orchestration.Run {
  v2.std.orchestration.Run {
    command: ci_heal_skew_shell_line(argv: argv),
    env: [],
    redirect: Present { value: r },
    capture: Absent
  }
}

fn ci_heal_skew_git_step(argv: List<String>) -> v2.std.orchestration.PipelineStep {
  Do { run: ci_heal_skew_git_run(argv: argv) }
}

fn ci_heal_skew_diag(text: String) -> v2.std.orchestration.PipelineStep {
  Do {
    run: v2.std.orchestration.Run {
      command: concat("echo \"", concat(text, "\"")),
      env: [],
      redirect: Present { value: StdoutAndStderr },
      capture: Absent
    }
  }
}

fn ci_heal_skew_diag_list(var_name: String) -> v2.std.orchestration.PipelineStep {
  Do {
    run: v2.std.orchestration.Run {
      command: concat(
        concat("echo \"$", concat(var_name, "\" ")),
        ci_heal_skew_indent_commit_list
      ),
      env: [],
      redirect: Present { value: StdoutAndStderr },
      capture: Absent
    }
  }
}

fn ci_heal_skew_stdout(text: String) -> v2.std.orchestration.PipelineStep {
  Do {
    run: v2.std.orchestration.Run {
      command: concat("echo \"", concat(text, "\"")),
      env: [],
      redirect: Absent,
      capture: Absent
    }
  }
}

fn ci_heal_skew_fetch_argv(ref_spelling: String) -> List<String> {
  ["git", "fetch", "--quiet", "origin", ref_spelling]
}

fn ci_heal_skew_fetch_quiet_ok(ref_spelling: String) -> v2.std.orchestration.Predicate {
  v2.std.orchestration.ExitZero {
    run: ci_heal_skew_git_run_redirected(
      argv: ci_heal_skew_fetch_argv(ref_spelling: ref_spelling),
      r: DiscardErr
    )
  }
}

fn ci_heal_skew_empty_pipeline() -> v2.std.orchestration.Pipeline {
  v2.std.orchestration.Pipeline { steps: [], on_failure: FailFast }
}

data ci_heal_skew_tolerated_fetch_note: String = "A TOLERATED FETCH IS A BOTH-ARMS-EMPTY If, NOT `|| true`. The prior cut spelled the provenance fetch as `A 2>/dev/null || B 2>/dev/null || true` — hand-authored shell whose whole purpose is 'attempt, and do not fail the step'. Modeled, that is exactly one If whose condition is the attempt and whose arms are both empty: v2.std.orchestration's pipeline_steps_empty_arm_note blesses this shape by name ('a both-empty If is a real run-the-condition, discard-the-outcome intent, not dead code, and is never refused'), and orch_emit_if_step spells an empty arm as the bash no-op `:`. Behaviour is preserved exactly — the condition runs, its outcome is discarded, the step continues — with the failure tolerance now structural instead of a trailing `|| true` nobody can typecheck. The refusal that MATTERS is not skipped: the following rev-parse --verify decides whether the revision actually resolved, so an unfetchable provenance still fails closed there."

fn ci_heal_skew_tolerated_fetch_step(cond: v2.std.orchestration.Predicate) -> v2.std.orchestration.PipelineStep {
  If {
    cond: cond,
    then_: ci_heal_skew_empty_pipeline(),
    else_: Present { value: ci_heal_skew_empty_pipeline() }
  }
}

fn ci_heal_skew_provenance_fetch_step() -> v2.std.orchestration.PipelineStep {
  ci_heal_skew_tolerated_fetch_step(
    cond: Or {
      lhs: ci_heal_skew_fetch_quiet_ok(ref_spelling: ci_heal_skew_built_from_ref),
      rhs: ci_heal_skew_fetch_quiet_ok(ref_spelling: ci_heal_skew_workflow_ref_expr)
    }
  )
}

fn ci_heal_skew_unresolvable_provenance_step() -> v2.std.orchestration.PipelineStep {
  If {
    cond: Not {
      inner: v2.std.orchestration.ExitZero {
        run: ci_heal_skew_git_run_redirected(
          argv: shape_git_rev_parse_verify_quiet_argv(target: ci_heal_skew_built_from_ref),
          r: DiscardOut
        )
      }
    },
    then_: v2.std.orchestration.Pipeline {
      steps: [
        ci_heal_skew_diag(text: "heal refused: cannot resolve the revision the release binary was built from"),
        ci_heal_skew_diag(text: "  wanted: $BUILT_FROM (github.sha — the ref the build job compiled)"),
        ci_heal_skew_diag(text: "  without it this job cannot establish that its binary and its tree agree."),
        v2.std.orchestration.Exit { status: "1" }
      ],
      on_failure: FailFast
    },
    else_: Absent
  }
}

fn ci_heal_skew_git_cmdsubst_bind(var_name: String, args: List<String>) -> v2.std.orchestration.PipelineStep {
  Let {
    name: var_name,
    value: v2.std.orchestration.ExprCmdSubst { callee: "git", args: args }
  }
}

fn ci_heal_skew_seed_ahead_bind(var_name: String) -> v2.std.orchestration.PipelineStep {
  ci_heal_skew_git_cmdsubst_bind(
    var_name: var_name,
    args: shape_git_rev_list_ahead_path_limited_args(
      target: ci_heal_skew_built_from_ref,
      path: ci_heal_skew_seed_path
    )
  )
}

fn ci_heal_skew_conflicts_bind() -> v2.std.orchestration.PipelineStep {
  ci_heal_skew_git_cmdsubst_bind(
    var_name: ci_heal_skew_conflicts_var,
    args: shape_git_diff_unmerged_args()
  )
}

data ci_heal_skew_shell_quote_note: String = "QUOTING IS THE EMITTER'S JOB, AND THE PATHSPEC IS WHY. A `:(exclude)<path>` word carries `(` and `)`, which bash treats as metacharacters, so joining one into a command line unquoted is a SYNTAX ERROR — caught here by executing `bash -n` over the actually-emitted string rather than by reading it (the first cut emitted an invalid line 20 and `gunbc ci` failed downstream). extdeps.git owns the pathspec VALUE and deliberately does not quote it, because only the emitting layer knows the target shell; this function is that layer for the bash realization. Single quotes are used because bash performs NO expansion inside them, which is correct for a pathspec that must reach git verbatim — a double-quoted `:(exclude)docs/*` would risk glob/expansion semantics the pathspec is supposed to own. Single-quoting is TOTAL only while no registered artifact path contains a single quote, which is asserted by execution in ci_heal_skew_guard_emit_test (registry paths are repo paths; a path with an apostrophe reds that witness rather than silently emitting a broken line). 🟡 dissolve-on: a typed shell-word carrier makes an unquoted metacharacter-bearing word unwritable by construction, at which point this function and the bash.dag orch_shell_*_alphabet emit-time checks collapse into it (the trigger those rows already name)."

fn ci_heal_skew_shell_single_quoted(word: String) -> String {
  concat("'", concat(word, "'"))
}

data ci_heal_skew_excluded_population_note: String = "THE EXCLUSION POPULATION IS THE FULL merge=generated-artifact POLICY SET (review 47515): committed generated artifacts PLUS the plan-derived stage0 Rust surface, matching gitattributes_emit's merge-policy rows — a skew conflict on an emitted stage0 file is a generated-projection conflict (provisional ours, then regenerate), never AUTHORED_CONFLICTS. The stage0 half reads the ENROLLED gunbc.stage0_emit_plan_generated projection rather than the refusing live derivation because this emitter needs a total surface: the drift gate already enforces enrolled == derived, and the duplicate/supply refusals guard at the generation seam, so the enrolled read inherits those guarantees without inventing a second refusal channel through ci.yml emission."

fn ci_heal_skew_excluded_paths() -> List<String> {
  concat(
    committed_generated_artifact_paths(),
    map(generated_stage0_files, b => stage0_canonical_repo_path(basename: b))
  )
}

fn ci_heal_skew_excluded_pathspec_words() -> List<String> {
  map(
    ci_heal_skew_excluded_paths(),
    p => ci_heal_skew_shell_single_quoted(word: git_pathspec_exclude(path: p))
  )
}

fn ci_heal_skew_authored_conflicts_bind() -> v2.std.orchestration.PipelineStep {
  ci_heal_skew_git_cmdsubst_bind(
    var_name: ci_heal_skew_authored_conflicts_var,
    args: shape_git_diff_unmerged_pathspec_args(
      pathspec_words: ci_heal_skew_excluded_pathspec_words()
    )
  )
}

fn ci_heal_skew_shell_line(argv: List<String>) -> String {
  join(argv, " ")
}

fn ci_heal_skew_piped_command(producer_argv: List<String>, consumer_argv: List<String>) -> String {
  join(
    [
      ci_heal_skew_shell_line(argv: producer_argv),
      ci_heal_skew_shell_line(argv: consumer_argv)
    ],
    ci_heal_skew_pipe_operator
  )
}

fn ci_heal_skew_resolve_step(sink_argv: List<String>) -> v2.std.orchestration.PipelineStep {
  Do {
    run: v2.std.orchestration.Run {
      command: ci_heal_skew_piped_command(
        producer_argv: shape_git_diff_unmerged_nul_argv(),
        consumer_argv: shape_xargs_null_delimited_argv(sink_argv: sink_argv)
      ),
      env: [],
      redirect: Absent,
      capture: Absent
    }
  }
}

fn ci_heal_skew_authored_conflict_refusal() -> v2.std.orchestration.Pipeline {
  v2.std.orchestration.Pipeline {
    steps: [
      ci_heal_skew_diag(text: "heal refused: binary/source revision skew, and the remedy CONFLICTS in authored files"),
      ci_heal_skew_diag(text: "  conflicting paths:"),
      ci_heal_skew_diag_list(var_name: ci_heal_skew_conflicts_var),
      ci_heal_skew_diag(text: "  authored (not a registered generated artifact, so not auto-resolvable):"),
      ci_heal_skew_diag_list(var_name: ci_heal_skew_authored_conflicts_var),
      ci_heal_skew_diag(text: "  a semantic conflict is the author's to resolve; this job will not guess."),
      ci_heal_skew_git_step(argv: shape_git_merge_abort_argv()),
      v2.std.orchestration.Exit { status: "1" }
    ],
    on_failure: FailFast
  }
}

data ci_heal_skew_unmerged_index_refusal_note: String = "THE COMMIT STEP IS GATED ON A FRESH POST-RESOLVE UNMERGED READ, NOT ON THE PRE-RESOLVE CONFLICTS BINDING. gunbc#7821 committed a real merge with <<<<<<< markers still in the tree; gunbc#7870 committed provisional ours bytes through an index the merge=generated-artifact driver had deliberately left unmerged. Both are the same class: a writer that reaches `git commit` without independently confirming the index it is about to commit carries zero unmerged stages. `ci_heal_skew_conflicts_bind` and the resolve steps above already narrow to exactly the registered-generated-artifact conflicts and refuse loudly if a checkout/add fails (ci_heal_skew_resolve_note), so this re-check is deliberately redundant with them rather than a replacement — CONFLICTS is a snapshot taken before resolution ran, and the ONLY fact `git commit` may trust is `git diff --diff-filter=U` read again, immediately before the write. Nonempty here means the resolve steps did not actually clear every unmerged stage — for any reason, including one this module does not yet know to name — and the writer refuses rather than committing whatever the index happens to hold, per gunbc.commit_workflow commit_writer_unmerged_index_refusals_at, DESIGN §5."

data ci_heal_skew_admission_check_note: String = "THE COMMIT WRITER ADMISSION AUTHORITY RUNS BEFORE THIS JOB WRITES, NOT AFTER. gunbc.commit_workflow admit_commit_writer is the one refusal authority for every commit writer (commit_writer_admission_note); ci_heal_skew_conflict_arm is the CommitWriterHealSkewConflictArm binding site named in commit_writer_binding_work. This step invokes it through the same explicit actuator DESIGN.md documents (`gunbc run --entry <file> --function <fn>`) rather than a bespoke subcommand — the fold decodes the real staged index, reads each blob, classifies it against module_storage, and calls admit_commit_writer; a nonzero exit here fails the pipeline closed (FailFast) before the commit step below ever runs, so a HealAutocommit write can no longer reach `git commit` past a refusal admit_commit_writer would have raised."

fn ci_heal_skew_admission_check_argv() -> List<String> {
  [
    "\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/target/release/gunbc\"", "run",
    "--source-root", "dag",
    "--source-root", "src/v2",
    "--entry", "dag/gunbc/commit_workflow.dag",
    "--function", "heal_admit"
  ]
}

fn ci_heal_skew_admission_check_step() -> v2.std.orchestration.PipelineStep {
  Do {
    run: v2.std.orchestration.Run {
      command: ci_heal_skew_shell_line(argv: ci_heal_skew_admission_check_argv()),
      env: [],
      redirect: Absent,
      capture: Absent
    }
  }
}

fn ci_heal_skew_still_unmerged_bind() -> v2.std.orchestration.PipelineStep {
  ci_heal_skew_git_cmdsubst_bind(
    var_name: ci_heal_skew_still_unmerged_var,
    args: shape_git_diff_unmerged_args()
  )
}

fn ci_heal_skew_unmerged_index_refusal() -> v2.std.orchestration.Pipeline {
  v2.std.orchestration.Pipeline {
    steps: [
      ci_heal_skew_diag(text: "heal refused: the index still carries unmerged stages after resolution; refusing to commit"),
      ci_heal_skew_diag(text: "  still-unmerged paths:"),
      ci_heal_skew_diag_list(var_name: ci_heal_skew_still_unmerged_var),
      ci_heal_skew_diag(text: "  a commit over an unmerged index is never fabricated; this job will not guess."),
      ci_heal_skew_git_step(argv: shape_git_merge_abort_argv()),
      v2.std.orchestration.Exit { status: "1" }
    ],
    on_failure: FailFast
  }
}

fn ci_heal_skew_conflict_arm() -> v2.std.orchestration.Pipeline {
  v2.std.orchestration.Pipeline {
    steps: [
      ci_heal_skew_conflicts_bind(),
      ci_heal_skew_authored_conflicts_bind(),
      If {
        cond: v2.std.orchestration.StrNonempty { operand: concat("\"$", concat(ci_heal_skew_authored_conflicts_var, "\"")) },
        then_: ci_heal_skew_authored_conflict_refusal(),
        else_: Absent
      },
      ci_heal_skew_diag(text: "heal: conflicts are confined to registered generated artifacts; regeneration is authoritative"),
      ci_heal_skew_diag_list(var_name: ci_heal_skew_conflicts_var),
      ci_heal_skew_resolve_step(sink_argv: shape_git_checkout_ours_argv()),
      ci_heal_skew_resolve_step(sink_argv: shape_git_add_argv()),
      ci_heal_skew_still_unmerged_bind(),
      If {
        cond: v2.std.orchestration.StrNonempty { operand: concat("\"$", concat(ci_heal_skew_still_unmerged_var, "\"")) },
        then_: ci_heal_skew_unmerged_index_refusal(),
        else_: Absent
      },
      ci_heal_skew_diag(text: "heal: admitting the staged commit writer via gunbc.commit_workflow admit_commit_writer before writing"),
      ci_heal_skew_admission_check_step(),
      Do {
        run: ci_heal_skew_git_run_redirected(
          argv: shape_git_commit_no_verify_no_edit_argv(),
          r: DiscardOut
        )
      }
    ],
    on_failure: FailFast
  }
}

fn ci_heal_skew_still_skewed_refusal() -> v2.std.orchestration.Pipeline {
  v2.std.orchestration.Pipeline {
    steps: [
      ci_heal_skew_diag(text: "heal refused: still skewed after merging $BUILT_FROM"),
      ci_heal_skew_diag(text: "  this arm should be unreachable — merging BUILT_FROM makes it an ancestor of HEAD, so the seed-ahead set is empty by construction. Reaching it means that invariant broke; do not re-run, investigate."),
      v2.std.orchestration.Exit { status: "1" }
    ],
    on_failure: FailFast
  }
}

fn ci_heal_skew_remedy_arm() -> v2.std.orchestration.Pipeline {
  v2.std.orchestration.Pipeline {
    steps: [
      ci_heal_skew_diag(text: "heal: binary/source revision skew — the branch head lacks these seed (src/v1) commits:"),
      ci_heal_skew_diag_list(var_name: ci_heal_skew_ahead_var),
      ci_heal_skew_diag(text: "heal: applying the remedy automatically (merging $BUILT_FROM — the revision the binary was built from — into this branch)"),
      ci_heal_skew_git_step(
        argv: shape_git_config_argv(key: "user.name", value: ci_heal_skew_commit_author_name)
      ),
      ci_heal_skew_git_step(
        argv: shape_git_config_argv(key: "user.email", value: ci_heal_skew_commit_author_email)
      ),
      If {
        cond: Not {
          inner: v2.std.orchestration.ExitZero {
            run: ci_heal_skew_git_run(
              argv: shape_git_merge_no_edit_argv(ref: ci_heal_skew_built_from_ref)
            )
          }
        },
        then_: ci_heal_skew_conflict_arm(),
        else_: Absent
      },
      ci_heal_skew_seed_ahead_bind(var_name: ci_heal_skew_ahead_after_var),
      If {
        cond: v2.std.orchestration.StrNonempty { operand: concat("\"$", concat(ci_heal_skew_ahead_after_var, "\"")) },
        then_: ci_heal_skew_still_skewed_refusal(),
        else_: Absent
      },
      ci_heal_skew_diag(text: "heal: remedy applied — tree now carries the binary's seed revision")
    ],
    on_failure: FailFast
  }
}

fn ci_heal_binary_source_skew_guard_intent() -> v2.std.orchestration.Pipeline {
  v2.std.orchestration.Pipeline {
    steps: [
      Let {
        name: "BUILT_FROM",
        value: v2.std.orchestration.ExprLit { spelling: ci_heal_skew_built_from_binding }
      },
      ci_heal_skew_provenance_fetch_step(),
      ci_heal_skew_unresolvable_provenance_step(),
      ci_heal_skew_seed_ahead_bind(var_name: ci_heal_skew_ahead_var),
      If {
        cond: v2.std.orchestration.StrNonempty { operand: concat("\"$", concat(ci_heal_skew_ahead_var, "\"")) },
        then_: ci_heal_skew_remedy_arm(),
        else_: Absent
      },
      ci_heal_skew_stdout(
        text: "heal preflight: binary revision $BUILT_FROM carries no seed commits missing from this tree"
      )
    ],
    on_failure: FailFast
  }
}

fn ci_heal_binary_source_skew_guard_script() -> String {
  orch_bash_emit_pipeline(
    p: ci_heal_binary_source_skew_guard_intent(),
    refused_poison: ci_heal_skew_guard_refused_poison
  )
}
