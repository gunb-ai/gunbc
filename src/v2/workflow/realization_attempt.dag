data realization_attempt_note: String = "CI2-0 Commit B (operator mandate 2026-08-08): the ACTUAL canonical v2 realization attempt per identity — replacing the circular census whose capability verdict was bundle membership. One entry attempt runs the mandated pipeline over the entry's real authored source: Filesystem.Read -> tokenize -> parse_module -> normalize -> resolve (ingested_resolved_module_from_source, the SAME general ingest the wave1 census fixtures ride — not a witness-specific converter) -> Arrow extraction per declaration -> emit_produced_module_rust against rust_target_model_staging (the one general Rust TargetModel). The result is a typed standing per phase: the FIRST refusing phase is recorded with its exact diagnostic, and a green traversal is V2TranslateSerialized (RustCompile/NativeExecute are the transport stages, attempted by the bundle leg, not here). Bundle membership appears nowhere in this computation."


data attempt_probe_supersession_note: String = "OPERATOR VERDICT (msg_9dec74f7, seven blocking findings): this module as landed is a PROBE, not the canonical route, and is being replaced IN-PLACE. The replacement contract: exact required-test identity -> exact module closure (the floor's own resolved graph — never a single-file re-ingest) -> canonical compiler result -> exact resolved declaration (identity join against enrolled test declarations, never synthetic wrappers) -> v2.compiler.compile with TranslateTo (infer INCLUDED — finding 3) -> canonical Rust realization -> bundle member. Findings addressed so far: (7) attempt_is_emitted now requires emitted_nonempty — accepted-but-empty is not emitted. Remaining, tracked here until each lands: (1) drop the ingested_fixture_arrows bridge; (2) closure resolution via the executor's resolved graph; (3) infer stage actually runs via compile(); (4) per-stage phase precision — the measured specimen is a normalize wrapper-retained refusal (body_lowering_reason_wrapper_retained_emitted) currently flattened into PhaseFrontend; (5) show rust_target_model_staging canonical or replace with what is; (6) identity join replaces collect_arrows synthesis. The probe's measured buckets (test-marker gate, match-binder resolve, staging-lex literals, wrapper-retained normalize) remain valid census data — they were produced by real canonical stages even where the harness plumbing was probe-grade."

type RealizationPhase
  = PhaseRead
  | PhaseAssembly
  | PhaseUnclassified
  | PhaseFrontend
  | PhaseNormalize
  | PhaseResolve
  | PhaseInfer
  | PhaseTranslate
  | PhaseSerialize
  | PhaseRustCompile
  | PhaseNativeExecute

type RealizationAttemptStanding
  = V2TranslateSerialized { emitted_nonempty: Bool }
  | V2RealizationRefused { phase: RealizationPhase, exact_cause: Symbol, located: String }

type EntryRealizationAttempt {
  entry: String
  arrow_count: Int
  standing: RealizationAttemptStanding
}


// Head-masking (measured, single-entry census on realization_sweep_test's closure):
// rejected_with_pending PREPENDS pending accepted-carrier diagnostics to a later rejection,
// so a rejection flowing through a stage that accumulated frontier diagnostics (wrapper-retained
// is Accepted-with-diagnostics at the body-lowering fold) carries the frontier diag at HEAD and
// the true rejecting cause behind it — the measured specimen read wrapper_retained_emitted where
// the rejecting cause was normalize_reason_post_normalize_not_well_formed. The cause read must
// skip past accepted-carrier reasons, the same way it already skipped choice-overlap residue.
fn reason_is_masking_carrier(r: Symbol) -> Bool {
  (r == ^body_lowering_reason_wrapper_retained_emitted) || (r == ^parse_grammar_choice_overlap_residue)
}

fn first_located_cause(ds: NonEmptyDiagnostics) -> Symbol {
  if !reason_is_masking_carrier(r: ds.head.reason) {
    ds.head.reason
  } else {
    fold_list(xs: ds.tail, empty: ds.head.reason, cons: fn(acc, d) {
      if reason_is_masking_carrier(r: acc) && !reason_is_masking_carrier(r: d.reason) { d.reason } else { acc }
    })
  }
}

fn attempt_refused(entry: String, phase: RealizationPhase, cause: Symbol) -> EntryRealizationAttempt {
  attempt_refused_at(entry: entry, phase: phase, cause: cause, located: "")
}

fn attempt_refused_at(entry: String, phase: RealizationPhase, cause: Symbol, located: String) -> EntryRealizationAttempt {
  EntryRealizationAttempt {
    entry: entry,
    arrow_count: 0,
    standing: V2RealizationRefused { phase: phase, exact_cause: cause, located: located }
  }
}

fn first_located_file(ds: NonEmptyDiagnostics) -> String {
  let head_file = match ds.head.at {
    Textual { file: f, extent: _ } => symbol_lexeme(sym: f)
    _ => ""
  }
  if head_file != "" {
    head_file
  } else {
    fold_list(xs: ds.tail, empty: "", cons: fn(acc, d) {
      if acc != "" {
        acc
      } else {
        match d.at {
          Textual { file: f, extent: _ } => symbol_lexeme(sym: f)
          _ => ""
        }
      }
    })
  }
}

fn first_arrow_in(root: Node) -> Optional<Node> {
  match root.kind {
    TypeNode { connective: Arrow } => Present { value: root }
    _ =>
      fold(root.children, init: Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => first_arrow_in(root: e.target)
        }
      })
  }
}

fn collect_arrows(root: Node, acc: List<Node>) -> List<Node> {
  fold(root.children, init: acc, f: fn(inner, e) {
    match e.label {
      Named { name: decl_name } =>
        match first_arrow_in(root: e.target) {
          Present { value: arrow } =>
            concat(inner, [node_synthetic(
              kind: TypeNode { connective: Conj },
              children: [Edge { label: Named { name: decl_name }, target: arrow }]
            )])
          Absent => inner
        }
      _ => inner
    }
  })
}


data test_marker_dissolved_note: String = "DISSOLVED SCAFFOLD RECORD (dissolve-on fired; operator ruling msg_2a8e30e8 item 4): the marker-rewrite capture (MarkedSource / capture_test_markers / capture_markers_ingest — line-leading 'test fn '/'test data ' rewritten to the unmarked form before assembly) is DELETED because the dag grammar now parses the authored test marker structurally: v2.std.grammar GrammarExpr TerminalContextual is the contextual-keyword terminal, and v2.extdeps.languages.dag dag_grammar_top_level_item_expr admits an OPTIONAL ^test marker before data_decl/fn_decl only, capturing nothing — a marked declaration's emitted tree is structurally EQUAL to the unmarked form (witnessed: gunbc.test.claim.dag_test_marker_contextual_witness_test witness_marker_captures_nothing_tree_equal, with 'test type'/'test import'/bare-marker REDs and the pre-extension-grammar identity-swapped RED). Test-ness itself stays roster-derived, exactly the invariant the rewrite preserved. Prior art superseded twice over: v1's drop_leading_test_marker discards pre-parse and re-derives by text scan; the rewrite captured and counted; the grammar now ADMITS — the marker is source structure the parser sees, not a pre-parse patch."

fn attempt_entry_source(entry: String, source: String) -> EntryRealizationAttempt {
  match ingested_resolved_module_from_source(source: source, file: ^realization_attempt_entry_file) {
    Rejected { diagnostics: ds } =>
      attempt_refused_at(
        entry: entry,
        phase: PhaseFrontend,
        cause: first_located_cause(ds: ds),
        located: first_located_file(ds: ds)
      )
    Accepted { value: resolved, diagnostics: _ } => {
      let arrows = collect_arrows(root: resolved, acc: [])
      if length(xs: arrows) == 0 {
        attempt_refused(entry: entry, phase: PhaseTranslate, cause: ^realization_attempt_no_arrow_declarations)
      } else {
        match emit_produced_module_rust(decls: arrows, target: rust_target_model_staging()) {
          Accepted { value: medium, diagnostics: _ } =>
            EntryRealizationAttempt {
              entry: entry,
              arrow_count: length(xs: arrows),
              standing: V2TranslateSerialized { emitted_nonempty: !(medium.carried == "") }
            }
          Rejected { diagnostics: ds } =>
            EntryRealizationAttempt {
              entry: entry,
              arrow_count: length(xs: arrows),
              standing: V2RealizationRefused {
                phase: PhaseTranslate,
                exact_cause: first_located_cause(ds: ds),
                located: first_located_file(ds: ds)
              }
            }
        }
      }
    }
  }
}

fn attempt_entry(entry: String) -> EntryRealizationAttempt {
  let read_out = Filesystem.Read(path: entry)
  if !read_out.success {
    attempt_refused(entry: entry, phase: PhaseRead, cause: ^realization_attempt_read_refused)
  } else {
    attempt_entry_source(entry: entry, source: read_out.content)
  }
}

fn attempt_is_emitted(a: EntryRealizationAttempt) -> Bool {
  match a.standing {
    V2TranslateSerialized { emitted_nonempty: ne } => ne
    V2RealizationRefused { phase: _, exact_cause: _, located: _ } => false
  }
}

fn attempt_phase_label(a: EntryRealizationAttempt) -> String {
  match a.standing {
    V2TranslateSerialized { emitted_nonempty: _ } => "emitted"
    V2RealizationRefused { phase: p, exact_cause: _, located: _ } => match p {
      PhaseRead => "read"
      PhaseAssembly => "assembly"
      PhaseUnclassified => "unclassified"
      PhaseFrontend => "frontend"
      PhaseNormalize => "normalize"
      PhaseResolve => "resolve"
      PhaseInfer => "infer"
      PhaseTranslate => "translate"
      PhaseSerialize => "serialize"
      PhaseRustCompile => "rust_compile"
      PhaseNativeExecute => "native_execute"
    }
  }
}

fn attempt_cause(a: EntryRealizationAttempt) -> Optional<Symbol> {
  match a.standing {
    V2TranslateSerialized { emitted_nonempty: _ } => Absent
    V2RealizationRefused { phase: _, exact_cause: c, located: _ } => Present { value: c }
  }
}

data attempt_assembled_note: String = "The CANONICAL closure attempt (operator seven-findings contract, msg_9dec74f7): exact ingest (real file reads as DagSourceReadWitness rows) -> assemble_program_from_ingest (the SAME multi-module assembly the source-root-ingest gate rides — imports resolve against the closure, finding 2; no fixture bridge, finding 1) -> EXACTLY-ONE identity join against the resolved program for the required declaration name (zero and many both refuse with typed causes — finding 6, never a synthetic wrapper) -> infer (finding 3, its own phase) -> compile_inferred TranslateTo (finding 4: assembly, join, infer, translate each report their own phase; the exact cause Symbol locates the true stage inside assembly refusals). rust_target_model_staging remains the target pending the finding-5 canonicality ruling, surfaced in the sweep receipt."

data phase_for_reason_note: String = "Per-stage phase precision (finding 4, tightened per operator repair msg_2a8e30e8 item 3): an assembly rejection carries the TRUE originating stage inside its reason symbol — parse/tokenize reasons are PhaseFrontend, body_lowering reasons are PhaseNormalize, resolve reasons are PhaseResolve — and an UNRECOGNIZED family is PhaseUnclassified, never a guessed stage and never a fallback that silently lands in resolve. Resolve is not the other bucket."

fn phase_for_reason(reason: Symbol, fallback: RealizationPhase) -> RealizationPhase {
  let lexeme = symbol_lexeme(sym: reason)
  if starts_with(s: lexeme, prefix: "parse_") || starts_with(s: lexeme, prefix: "tokenize_") || starts_with(s: lexeme, prefix: "lex_") {
    PhaseFrontend
  } else if starts_with(s: lexeme, prefix: "body_lowering_") || starts_with(s: lexeme, prefix: "normalize_") {
    PhaseNormalize
  } else if starts_with(s: lexeme, prefix: "resolve_") {
    PhaseResolve
  } else if starts_with(s: lexeme, prefix: "infer_") || starts_with(s: lexeme, prefix: "type_") {
    PhaseInfer
  } else {
    PhaseUnclassified
  }
}

data attempt_exact_join_note: String = "Exact-identity join (operator repair msg_2a8e30e8 item 2 — MORE URGENT than the next wall, because a bare-name corpus-wide query can green the WRONG declaration): the required test identity is (entry module identity x declaration identity). The entry module identity comes from the admission subject the entry's own source derived; the join first selects the exactly-one program root whose QualifiedName equals it, then the exactly-one declaration edge named fn_name WITHIN that module subtree, and passes the REAL declaration edge target onward — no bare-name query over the whole assembled program, no synthetic wrapper node."

fn module_roots_matching(program: Node, module_qn: QualifiedName) -> List<Node> {
  fold(program.children, init: [], f: fn(acc, e) {
    match qualified_name_from_module_node(root: e.target) {
      Accepted { value: qn, diagnostics: _ } =>
        if qn == module_qn { concat(acc, [e.target]) } else { acc }
      Rejected { diagnostics: _ } => acc
    }
  })
}

fn decl_targets_named_in(root: Node, fn_name: Symbol) -> List<Node> {
  let here = fold(root.children, init: [], f: fn(acc, e) {
    match e.label {
      Named { name: n } =>
        if n == fn_name {
          match first_arrow_in(root: e.target) {
            Present { value: _ } => concat(acc, [e.target])
            Absent => acc
          }
        } else { acc }
      _ => acc
    }
  })
  fold(root.children, init: here, f: fn(acc, e) {
    concat(acc, decl_targets_named_in(root: e.target, fn_name: fn_name))
  })
}

fn attempt_joined(program: Node, module_qn: QualifiedName, fn_name: Symbol, entry: String) -> EntryRealizationAttempt {
  let roots = module_roots_matching(program: program, module_qn: module_qn)
  if length(xs: roots) == 0 {
    attempt_refused(entry: entry, phase: PhaseAssembly, cause: ^realization_attempt_entry_module_absent)
  } else if length(xs: roots) > 1 {
    attempt_refused(entry: entry, phase: PhaseAssembly, cause: ^realization_attempt_entry_module_ambiguous)
  } else {
    match list_at_optional(xs: roots, index: 0) {
      Absent => attempt_refused(entry: entry, phase: PhaseAssembly, cause: ^realization_attempt_entry_module_absent)
      Present { value: module_root } => attempt_joined_in_module(module_root: module_root, fn_name: fn_name, entry: entry)
    }
  }
}

fn attempt_joined_in_module(module_root: Node, fn_name: Symbol, entry: String) -> EntryRealizationAttempt {
  let joined = decl_targets_named_in(root: module_root, fn_name: fn_name)
  if length(xs: joined) == 0 {
    attempt_refused(entry: entry, phase: PhaseResolve, cause: ^realization_attempt_identity_absent)
  } else if length(xs: joined) > 1 {
    attempt_refused(entry: entry, phase: PhaseResolve, cause: ^realization_attempt_identity_ambiguous)
  } else {
    match list_at_optional(xs: joined, index: 0) {
      Absent => attempt_refused(entry: entry, phase: PhaseResolve, cause: ^realization_attempt_identity_absent)
      Present { value: decl } =>
        match infer(tree: decl) {
          Rejected { diagnostics: ds } =>
            attempt_refused_at(entry: entry, phase: PhaseInfer, cause: first_located_cause(ds: ds), located: first_located_file(ds: ds))
          Accepted { value: inferred, diagnostics: _ } =>
            match compile_inferred(inferred: inferred, mode: TranslateTo { target: rust_target_model_staging() }) {
              Rejected { diagnostics: ds } =>
                attempt_refused_at(entry: entry, phase: PhaseTranslate, cause: first_located_cause(ds: ds), located: first_located_file(ds: ds))
              Accepted { value: out, diagnostics: _ } =>
                match out {
                  TranslateResult { source: emitted } =>
                    EntryRealizationAttempt {
                      entry: entry,
                      arrow_count: 1,
                      standing: V2TranslateSerialized { emitted_nonempty: !(emitted.carried == "") }
                    }
                  EvalResult { value: _ } =>
                    attempt_refused(entry: entry, phase: PhaseTranslate, cause: ^realization_attempt_mode_result_mismatch)
                }
            }
        }
    }
  }
}

fn attempt_assembled(
  ingest: SourceRootIngest,
  admission: Admission,
  fn_name: Symbol,
  entry: String
) -> EntryRealizationAttempt {
  match assemble_program_from_ingest(ingest: ingest, admission: admission, lm: dag_language_model()) {
    Rejected { diagnostics: ds } => {
      let cause = first_located_cause(ds: ds)
      attempt_refused_at(entry: entry, phase: phase_for_reason(reason: cause, fallback: PhaseResolve), cause: cause, located: first_located_file(ds: ds))
    }
    Accepted { value: program, diagnostics: _ } =>
      attempt_joined(program: program, module_qn: admission.subject.name, fn_name: fn_name, entry: entry)
  }
}

data attempt_closure_rows_note: String = "Sweep seam (CI2-0 Commit B): ONE assembly per entry closure, then one attempt_joined per required test-fn identity — the exactly-once accounting grain the mandate names. The ingest is assembled AS AUTHORED — the grammar parses the test marker structurally (test_marker_dissolved_note); an assembly refusal is replicated to EVERY identity in the entry with the reason-classified phase, because each identity is accountable and none of them reached its join."

fn entry_witness_source(ingest: SourceRootIngest, entry: String) -> Optional<String> {
  fold_list(xs: ingest, empty: Absent, cons: fn(acc, r) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        match r.artifact.file_path == entry {
          true => Present { value: r.source.carried }
          false => Absent
        }
    }
  })
}

fn no_attempt_rows() -> List<EntryRealizationAttempt> {
  []
}

// CI2-0 normalize-wall sizing census (parent directive msg_0a017e48): after the partial body
// lowering normalize performs, a retained shell still carries its grammar production identity —
// so the production identities remaining under a joined test-fn declaration ARE the exact
// construct set the general-body-producer fragment must cover for that body. Walking the joined
// decl subtree and counting emitted identities buckets the wrapper-retained population by
// construct, with no second parser and no text scan.
fn census_collect(root: Node, acc: List<String>) -> List<String> {
  let here = match parse_production_emitted_identity_optional(node: root) {
    Present { value: id } => concat(acc, [symbol_lexeme(sym: id)])
    Absent => acc
  }
  fold(root.children, init: here, f: fn(inner, e) { census_collect(root: e.target, acc: inner) })
}

// Each wrapper-retained diagnostic carries the retained shell node via NodeLocus; the shell's
// own emitted production identity IS the construct bucket — available even when assembly
// rejects, which is the entire wrapper-retained population.
fn census_construct_label(n: Node) -> String {
  match parse_production_emitted_identity_optional(node: n) {
    Present { value: id } => symbol_lexeme(sym: id)
    Absent => "(no-production-identity)"
  }
}

fn census_diag_construct_optional(d: Diagnostic) -> Optional<String> {
  if !(d.reason == ^body_lowering_reason_wrapper_retained_emitted) {
    optional_absent()
  } else {
    match d.at {
      NodeLocus { anchor: a } => optional_present(value: census_construct_label(n: a.at))
      _ => optional_absent()
    }
  }
}

fn census_retained_rows(ds: NonEmptyDiagnostics, entry: String) -> List<String> {
  fold_list(xs: concat([ds.head], ds.tail), empty: no_census_lines(), cons: fn(acc, d) {
    match census_diag_construct_optional(d: d) {
      Present { value: prod } =>
        concat(acc, [census_line(entry: entry, fn_col: "(retained)", phase_col: "construct", cause_col: prod, located_col: "")])
      Absent => acc
    }
  })
}

fn census_line(entry: String, fn_col: String, phase_col: String, cause_col: String, located_col: String) -> String {
  concat(entry, concat("	", concat(fn_col, concat("	", concat(phase_col, concat("	", concat(cause_col, concat("	", located_col))))))))
}

fn census_lines_for_decl(decl: Node, entry: String, fn_name: Symbol) -> List<String> {
  fold_list(xs: census_collect(root: decl, acc: []), empty: no_census_lines(), cons: fn(acc, prod) {
    concat(acc, [census_line(entry: entry, fn_col: symbol_lexeme(sym: fn_name), phase_col: "construct", cause_col: prod, located_col: "")])
  })
}

fn no_census_lines() -> List<String> {
  []
}

fn census_rows(
  ingest: SourceRootIngest,
  admission: Admission,
  fn_names: List<Symbol>,
  entry: String
) -> List<String> {
  match assemble_program_from_ingest(ingest: ingest, admission: admission, lm: dag_language_model()) {
    Rejected { diagnostics: ds } =>
      concat(
        [census_line(
          entry: entry,
          fn_col: "(census)",
          phase_col: "assembly_refused",
          cause_col: symbol_lexeme(sym: first_located_cause(ds: ds)),
          located_col: first_located_file(ds: ds)
        )],
        census_retained_rows(ds: ds, entry: entry)
      )
    Accepted { value: program, diagnostics: _ } =>
      match list_at_optional(xs: module_roots_matching(program: program, module_qn: admission.subject.name), index: 0) {
        Absent => [census_line(entry: entry, fn_col: "(census)", phase_col: "assembly", cause_col: "entry_module_absent", located_col: "")]
        Present { value: module_root } =>
          fold_list(xs: fn_names, empty: no_census_lines(), cons: fn(acc, fn_name) {
            let joined = decl_targets_named_in(root: module_root, fn_name: fn_name)
            match list_at_optional(xs: joined, index: 0) {
              Absent => concat(acc, [census_line(entry: entry, fn_col: symbol_lexeme(sym: fn_name), phase_col: "join", cause_col: "identity_absent", located_col: "")])
              Present { value: decl } => concat(acc, census_lines_for_decl(decl: decl, entry: entry, fn_name: fn_name))
            }
          })
      }
  }
}

fn attempt_closure_rows(
  ingest: SourceRootIngest,
  admission: Admission,
  fn_names: List<Symbol>,
  entry: String
) -> List<EntryRealizationAttempt> {
  match assemble_program_from_ingest(ingest: ingest, admission: admission, lm: dag_language_model()) {
    Rejected { diagnostics: ds } => {
      let cause = first_located_cause(ds: ds)
      let phase = phase_for_reason(reason: cause, fallback: PhaseAssembly)
      let located = first_located_file(ds: ds)
      fold_list(xs: fn_names, empty: no_attempt_rows(), cons: fn(acc, _name) {
        concat(acc, [attempt_refused_at(entry: entry, phase: phase, cause: cause, located: located)])
      })
    }
    Accepted { value: program, diagnostics: _ } =>
      fold_list(xs: fn_names, empty: no_attempt_rows(), cons: fn(acc, name) {
        concat(acc, [attempt_joined(program: program, module_qn: admission.subject.name, fn_name: name, entry: entry)])
      })
  }
}
