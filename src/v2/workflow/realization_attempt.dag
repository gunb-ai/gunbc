import v2.compiler.program_assembly { assemble_program_from_ingest }
import v2.compiler.source_authority { DagSourceReadWitness, SourceRootIngest }
import v2.compiler.name_resolve { Admission, ResolutionSubject, Import, ImportVisible }
import v2.compiler.infer { infer, InferredTree }
import v2.compiler.compile { compile_inferred, TranslateTo, TranslateResult, EvalResult, CompileMode }
import v2.compiler.emit_produced { emit_produced_module_rust }
import v2.extdeps.languages.rust { rust_target_model_staging }
