module v2.workflow.realization_attempt


data realization_attempt_note: String = "CI2-0 Commit B (operator mandate 2026-08-08): the ACTUAL canonical v2 realization attempt per identity — replacing the circular census whose capability verdict was bundle membership. One entry attempt runs the mandated pipeline over the entry's real authored source: Filesystem.Read -> tokenize -> parse_module -> normalize -> resolve (ingested_resolved_module_from_source, the SAME general ingest the wave1 census fixtures ride — not a witness-specific converter) -> Arrow extraction per declaration -> emit_produced_module against rust_target_model_staging (the one general Rust TargetModel). The result is a typed standing per phase: the FIRST refusing phase is recorded with its exact diagnostic, and a green traversal is V2TranslateSerialized (RustCompile/NativeExecute are the transport stages, attempted by the bundle leg, not here). Bundle membership appears nowhere in this computation."


data attempt_probe_supersession_note: String = "OPERATOR VERDICT (msg_9dec74f7, seven blocking findings): this module as landed is a PROBE, not the canonical route, and is being replaced IN-PLACE. The replacement contract: exact required-test identity -> exact module closure (the floor's own resolved graph — never a single-file re-ingest) -> canonical compiler result -> exact resolved declaration (identity join against enrolled test declarations, never synthetic wrappers) -> v2.compiler.compile with TranslateTo (infer INCLUDED — finding 3) -> canonical Rust realization -> bundle member. Findings addressed so far: (7) attempt_is_emitted now requires emitted_nonempty — accepted-but-empty is not emitted. Remaining, tracked here until each lands: (1) drop the ingested_fixture_arrows bridge; (2) closure resolution via the executor's resolved graph; (3) infer stage actually runs via compile(); (4) per-stage phase precision — the measured specimen is a normalize wrapper-retained refusal (body_lowering_reason_wrapper_retained_emitted) currently flattened into PhaseFrontend; (5) show rust_target_model_staging canonical or replace with what is; (6) identity join replaces collect_arrows synthesis. The probe's measured buckets (test-marker gate, match-binder resolve, staging-lex literals, wrapper-retained normalize) remain valid census data — they were produced by real canonical stages even where the harness plumbing was probe-grade."

type RealizationPhase
  = PhaseRead
  | PhaseFrontend
  | PhaseNormalize
  | PhaseResolve
  | PhaseInfer
  | PhaseTranslate
  | PhaseSerialize
  | PhaseRustCompile
  | PhaseNativeExecute

type RealizationAttemptStanding
  = V2TranslateSerialized { emitted_nonempty: Bool }
  | V2RealizationRefused { phase: RealizationPhase, exact_cause: v2.std.node.Symbol, located: String }

type EntryRealizationAttempt {
  entry: String
  arrow_count: Int
  standing: RealizationAttemptStanding
}


fn first_located_cause(ds: v2.std.diagnostic.NonEmptyDiagnostics) -> v2.std.node.Symbol {
  let residue = ^parse_grammar_choice_overlap_residue
  if !(ds.head.reason == residue) {
    ds.head.reason
  } else {
    fold_list(xs: ds.tail, empty: ds.head.reason, cons: fn(acc, d) {
      if (acc == residue) && !(d.reason == residue) { d.reason } else { acc }
    })
  }
}

fn attempt_refused(entry: String, phase: RealizationPhase, cause: v2.std.node.Symbol) -> v2.workflow.realization_attempt.EntryRealizationAttempt {
  attempt_refused_at(entry: entry, phase: phase, cause: cause, located: "")
}

fn attempt_refused_at(entry: String, phase: RealizationPhase, cause: v2.std.node.Symbol, located: String) -> v2.workflow.realization_attempt.EntryRealizationAttempt {
  v2.workflow.realization_attempt.EntryRealizationAttempt {
    entry: entry,
    arrow_count: 0,
    standing: V2RealizationRefused { phase: phase, exact_cause: cause, located: located }
  }
}

fn first_located_file(ds: v2.std.diagnostic.NonEmptyDiagnostics) -> String {
  let head_file = match ds.head.at {
    Textual { file: f, extent: _ } => symbol_lexeme(sym: f)
    _ => ""
  }
  if head_file != "" {
    head_file
  } else {
    fold_list(xs: ds.tail, empty: "", cons: fn(acc, d) {
      if acc != "" {
        acc
      } else {
        match d.at {
          Textual { file: f, extent: _ } => symbol_lexeme(sym: f)
          _ => ""
        }
      }
    })
  }
}

fn first_arrow_in(root: v2.std.node.Node) -> Optional<v2.std.node.Node> {
  match root.kind {
    TypeNode { connective: Arrow } => Present { value: root }
    _ =>
      fold(root.children, init: Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => first_arrow_in(root: e.target)
        }
      })
  }
}

fn collect_arrows(root: v2.std.node.Node, acc: List<v2.std.node.Node>) -> List<v2.std.node.Node> {
  fold(root.children, init: acc, f: fn(inner, e) {
    match e.label {
      Named { name: decl_name } =>
        match first_arrow_in(root: e.target) {
          Present { value: arrow } =>
            concat(inner, [node_synthetic(
              kind: v2.std.node.TypeNode { connective: Conj },
              children: [v2.std.node.Edge { label: Named { name: decl_name }, target: arrow }]
            )])
          Absent => inner
        }
      _ => inner
    }
  })
}


data test_marker_capture_note: String = "STAGED SCAFFOLD (escalation msg_628838a5; dissolve-on: GrammarExpr contextual-keyword terminal lands and dag fn_decl/data_decl productions carry the test marker structurally): the v2 dag grammar cannot yet parse the authored test marker ('test' is a module-path segment, so it cannot be a lex keyword; v1's v1_compiler_parse.rs drop_leading_test_marker DISCARDS the marker pre-parse and re-derives test-ness by text scan — cited as the prior art this capture SUPERSEDES, not imitates: this seam captures and counts, that seam discarded, and the distinction is the point (ruling msg_64870b7f)). The realization ATTEMPT captures the marker at its own seam — line-leading 'test fn '/'test data ' rewritten to the unmarked form, capture COUNTED on the attempt row — so the census sweep can measure the rest of the pipeline while the grammar extension is priced as its own top-of-burn-down repair item (it gates 100 percent of test files). Test-ness itself is never derived from this capture: the discovery roster carries it. Scoped deliberately to attempt_entry_source; the canonical production pipeline does NOT route through this fn."

type MarkedSource {
  unmarked: String
  captured_markers: Int
}

fn capture_test_markers(source: String) -> MarkedSource {
  let folded = fold(
    split(s: source, delimiter: "\n"),
    init: MarkedSource { unmarked: "", captured_markers: 0 },
    f: fn(acc, line) {
      let stripped =
        if starts_with(s: line, prefix: "test fn ") || starts_with(s: line, prefix: "test data ") {
          MarkedSource {
            unmarked: substring(s: line, start: 5, end: string_length(s: line)),
            captured_markers: 1
          }
        } else {
          MarkedSource { unmarked: line, captured_markers: 0 }
        }
      MarkedSource {
        unmarked: if acc.unmarked == "" { stripped.unmarked } else { concat(acc.unmarked, "\n", stripped.unmarked) },
        captured_markers: acc.captured_markers + stripped.captured_markers
      }
    }
  )
  folded
}

fn attempt_entry_source(entry: String, source: String) -> v2.workflow.realization_attempt.EntryRealizationAttempt {
  let marked = capture_test_markers(source: source)
  match v2.compiler.ingested_fixture_arrows.ingested_resolved_module_from_source(source: marked.unmarked, file: ^realization_attempt_entry_file) {
    Rejected { diagnostics: ds } =>
      attempt_refused_at(
        entry: entry,
        phase: PhaseFrontend,
        cause: first_located_cause(ds: ds),
        located: first_located_file(ds: ds)
      )
    Accepted { value: resolved, diagnostics: _ } => {
      let arrows = collect_arrows(root: resolved, acc: [])
      if length(xs: arrows) == 0 {
        attempt_refused(entry: entry, phase: PhaseTranslate, cause: ^realization_attempt_no_arrow_declarations)
      } else {
        match emit_produced_module(decls: arrows, target: rust_target_model_staging()) {
          Accepted { value: medium, diagnostics: _ } =>
            v2.workflow.realization_attempt.EntryRealizationAttempt {
              entry: entry,
              arrow_count: length(xs: arrows),
              standing: V2TranslateSerialized { emitted_nonempty: !(medium.carried == "") }
            }
          Rejected { diagnostics: ds } =>
            v2.workflow.realization_attempt.EntryRealizationAttempt {
              entry: entry,
              arrow_count: length(xs: arrows),
              standing: V2RealizationRefused {
                phase: PhaseTranslate,
                exact_cause: first_located_cause(ds: ds),
                located: first_located_file(ds: ds)
              }
            }
        }
      }
    }
  }
}

fn attempt_entry(entry: String) -> v2.workflow.realization_attempt.EntryRealizationAttempt {
  let read_out = Filesystem.Read(path: entry)
  if !read_out.success {
    attempt_refused(entry: entry, phase: PhaseRead, cause: ^realization_attempt_read_refused)
  } else {
    attempt_entry_source(entry: entry, source: read_out.content)
  }
}

fn attempt_is_emitted(a: v2.workflow.realization_attempt.EntryRealizationAttempt) -> Bool {
  match a.standing {
    V2TranslateSerialized { emitted_nonempty: ne } => ne
    V2RealizationRefused { phase: _, exact_cause: _, located: _ } => false
  }
}

fn attempt_phase_label(a: v2.workflow.realization_attempt.EntryRealizationAttempt) -> String {
  match a.standing {
    V2TranslateSerialized { emitted_nonempty: _ } => "emitted"
    V2RealizationRefused { phase: p, exact_cause: _, located: _ } => match p {
      PhaseRead => "read"
      PhaseFrontend => "frontend"
      PhaseNormalize => "normalize"
      PhaseResolve => "resolve"
      PhaseInfer => "infer"
      PhaseTranslate => "translate"
      PhaseSerialize => "serialize"
      PhaseRustCompile => "rust_compile"
      PhaseNativeExecute => "native_execute"
    }
  }
}

fn attempt_cause(a: v2.workflow.realization_attempt.EntryRealizationAttempt) -> Optional<v2.std.node.Symbol> {
  match a.standing {
    V2TranslateSerialized { emitted_nonempty: _ } => Absent
    V2RealizationRefused { phase: _, exact_cause: c, located: _ } => Present { value: c }
  }
}

data attempt_assembled_note: String = "The CANONICAL closure attempt (operator seven-findings contract, msg_9dec74f7): exact ingest (real file reads as DagSourceReadWitness rows) -> assemble_program_from_ingest (the SAME multi-module assembly the source-root-ingest gate rides — imports resolve against the closure, finding 2; no fixture bridge, finding 1) -> EXACTLY-ONE identity join against the resolved program for the required declaration name (zero and many both refuse with typed causes — finding 6, never a synthetic wrapper) -> infer (finding 3, its own phase) -> compile_inferred TranslateTo (finding 4: assembly, join, infer, translate each report their own phase; the exact cause Symbol locates the true stage inside assembly refusals). rust_target_model_staging remains the target pending the finding-5 canonicality ruling, surfaced in the sweep receipt."

fn decl_edges_named(root: v2.std.node.Node, fn_name: v2.std.node.Symbol, acc: List<v2.std.node.Node>) -> List<v2.std.node.Node> {
  let here = fold(root.children, init: acc, f: fn(inner, e) {
    match e.label {
      Named { name: n } =>
        if n == fn_name {
          match first_arrow_in(root: e.target) {
            Present { value: _ } => concat(inner, [node_synthetic(
              kind: v2.std.node.TypeNode { connective: Conj },
              children: [v2.std.node.Edge { label: Named { name: n }, target: e.target }]
            )])
            Absent => inner
          }
        } else { inner }
      _ => inner
    }
  })
  fold(root.children, init: here, f: fn(inner, e) {
    decl_edges_named(root: e.target, fn_name: fn_name, acc: inner)
  })
}

data phase_for_reason_note: String = "Finding 4 (per-stage phase precision): an assembly rejection carries the TRUE originating stage inside its reason symbol — parse/tokenize reasons are PhaseFrontend, body_lowering reasons are PhaseNormalize, resolve reasons are PhaseResolve — so the harness classifies the located reason's family instead of flattening every assembly refusal into one phase. An unrecognized family keeps the harness stage's fallback rather than fabricating a stage (§5: never a guessed label)."

fn phase_for_reason(reason: v2.std.node.Symbol, fallback: RealizationPhase) -> RealizationPhase {
  let lexeme = symbol_lexeme(sym: reason)
  if starts_with(s: lexeme, prefix: "parse_") || starts_with(s: lexeme, prefix: "tokenize_") || starts_with(s: lexeme, prefix: "lex_") {
    PhaseFrontend
  } else if starts_with(s: lexeme, prefix: "body_lowering_") || starts_with(s: lexeme, prefix: "normalize_") {
    PhaseNormalize
  } else if starts_with(s: lexeme, prefix: "resolve_") {
    PhaseResolve
  } else if starts_with(s: lexeme, prefix: "infer_") || starts_with(s: lexeme, prefix: "type_") {
    PhaseInfer
  } else {
    fallback
  }
}

fn attempt_joined(program: v2.std.node.Node, fn_name: v2.std.node.Symbol, entry: String) -> v2.workflow.realization_attempt.EntryRealizationAttempt {
  let joined = decl_edges_named(root: program, fn_name: fn_name, acc: [])
  if length(xs: joined) == 0 {
    attempt_refused(entry: entry, phase: PhaseResolve, cause: ^realization_attempt_identity_absent)
  } else if length(xs: joined) > 1 {
    attempt_refused(entry: entry, phase: PhaseResolve, cause: ^realization_attempt_identity_ambiguous)
  } else {
    match list_at_optional(xs: joined, index: 0) {
      Absent => attempt_refused(entry: entry, phase: PhaseResolve, cause: ^realization_attempt_identity_absent)
      Present { value: decl } =>
        match infer(tree: decl) {
          Rejected { diagnostics: ds } =>
            attempt_refused_at(entry: entry, phase: PhaseInfer, cause: first_located_cause(ds: ds), located: first_located_file(ds: ds))
          Accepted { value: inferred, diagnostics: _ } =>
            match compile_inferred(inferred: inferred, mode: v2.compiler.compile.TranslateTo { target: rust_target_model_staging() }) {
              Rejected { diagnostics: ds } =>
                attempt_refused_at(entry: entry, phase: PhaseTranslate, cause: first_located_cause(ds: ds), located: first_located_file(ds: ds))
              Accepted { value: out, diagnostics: _ } =>
                match out {
                  TranslateResult { source: emitted } =>
                    v2.workflow.realization_attempt.EntryRealizationAttempt {
                      entry: entry,
                      arrow_count: 1,
                      standing: V2TranslateSerialized { emitted_nonempty: !(emitted.carried == "") }
                    }
                  EvalResult { value: _ } =>
                    attempt_refused(entry: entry, phase: PhaseTranslate, cause: ^realization_attempt_mode_result_mismatch)
                }
            }
        }
    }
  }
}

fn attempt_assembled(
  ingest: v2.compiler.source_authority.SourceRootIngest,
  admission: v2.compiler.name_resolve.Admission,
  fn_name: v2.std.node.Symbol,
  entry: String
) -> v2.workflow.realization_attempt.EntryRealizationAttempt {
  match assemble_program_from_ingest(ingest: ingest, admission: admission, lm: dag_language_model()) {
    Rejected { diagnostics: ds } => {
      let cause = first_located_cause(ds: ds)
      attempt_refused_at(entry: entry, phase: phase_for_reason(reason: cause, fallback: PhaseResolve), cause: cause, located: first_located_file(ds: ds))
    }
    Accepted { value: program, diagnostics: _ } =>
      attempt_joined(program: program, fn_name: fn_name, entry: entry)
  }
}

data attempt_closure_rows_note: String = "Sweep seam (CI2-0 Commit B): ONE assembly per entry closure, then one attempt_joined per required test-fn identity — the exactly-once accounting grain the mandate names. The ingest is marker-captured at this seam only (test_marker_capture_note: the grammar cannot yet parse the authored test marker, so the capture scaffold rewrites line-leading markers and the count stays observable); an assembly refusal is replicated to EVERY identity in the entry with the reason-classified phase, because each identity is accountable and none of them reached its join."

fn capture_markers_ingest(ingest: v2.compiler.source_authority.SourceRootIngest) -> v2.compiler.source_authority.SourceRootIngest {
  match ingest {
    Empty => Empty
    Cons { head: r, tail: t } =>
      std.algebra.Cons {
        head: v2.compiler.source_authority.DagSourceReadWitness {
          source: extdeps.communication.medium.Medium {
            carried: capture_test_markers(source: r.source.carried).unmarked,
            fidelity: r.source.fidelity
          },
          artifact: r.artifact,
          compilation_unit: r.compilation_unit,
          source_root: r.source_root
        },
        tail: capture_markers_ingest(ingest: t)
      }
  }
}

fn entry_witness_source(ingest: v2.compiler.source_authority.SourceRootIngest, entry: String) -> Optional<String> {
  fold_list(xs: ingest, empty: Absent, cons: fn(acc, r) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        match r.artifact.file_path == entry {
          true => Present { value: r.source.carried }
          false => Absent
        }
    }
  })
}

fn no_attempt_rows() -> List<v2.workflow.realization_attempt.EntryRealizationAttempt> {
  []
}

fn attempt_closure_rows(
  ingest: v2.compiler.source_authority.SourceRootIngest,
  admission: v2.compiler.name_resolve.Admission,
  fn_names: List<v2.std.node.Symbol>,
  entry: String
) -> List<v2.workflow.realization_attempt.EntryRealizationAttempt> {
  match assemble_program_from_ingest(ingest: capture_markers_ingest(ingest: ingest), admission: admission, lm: dag_language_model()) {
    Rejected { diagnostics: ds } => {
      let cause = first_located_cause(ds: ds)
      let phase = phase_for_reason(reason: cause, fallback: PhaseResolve)
      let located = first_located_file(ds: ds)
      fold_list(xs: fn_names, empty: no_attempt_rows(), cons: fn(acc, _name) {
        concat(acc, [attempt_refused_at(entry: entry, phase: phase, cause: cause, located: located)])
      })
    }
    Accepted { value: program, diagnostics: _ } =>
      fold_list(xs: fn_names, empty: no_attempt_rows(), cons: fn(acc, name) {
        concat(acc, [attempt_joined(program: program, fn_name: name, entry: entry)])
      })
  }
}
