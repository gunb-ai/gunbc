    cause: ^fact_density_hollow_alias_locus,
    grain: HeadGrain,
    lane: ThisLaneCalibration,
    flip_trigger: "fact_density subtree roster corpus-calibrated (smart-eagle burn-down); flips to Blocking when the count zeroes — calibration must never become relaxing the lens"
