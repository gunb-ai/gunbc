// A FRONTIER'S RETIREMENT CONDITION, TYPED. A frontier observed under several causes (one per stage
// that meets it) retires when EVERY one of its causes counts zero at fatal grain over the route's
// population. Each cause must also be owned by a fatal-grain row of known_frontier_causes, because a
// retirement over a cause nobody counts would read as retired at zero forever.
// gunbc.witness_v2_native_route native_route_frontier_retirement_standing joins this condition to
// the route's derived tally, and admission refuses a retirement whose causes are unowned.
type FrontierRetirement {
  frontier: Symbol
  causes: List<Symbol>
}

// The node grounding frontier: v2.compiler.inferred_tree NodeGrounding's GroundingNotDerived arm,
// counted by infer's own advisory and by each stage that refuses an underived node.
data node_grounding_frontier_retirement: FrontierRetirement = FrontierRetirement {
  frontier: ^node_grounding_frontier,
  causes: [
    ^infer_grounding_not_derived,
    ^infer_grounding_demanded_not_derived,
    ^translate_rejected_grounding_not_derived,
    ^eval_rejected_grounding_not_derived
  ]
}

data known_frontier_retirements: List<FrontierRetirement> = [node_grounding_frontier_retirement]

fn cause_ownership_lookup(cause: Symbol, grain: DiagnosticGrain) -> Optional<CauseOwnership> {
  list_find_first(
    xs: known_frontier_causes,
    predicate: fn(row) {
      row.cause == cause && discriminant(v: row.grain) == discriminant(v: grain)
    }
  )
}

// A CAUSE WHOSE GROWTH IS A CORRECTNESS FLIP, DECLARED BY ITS OWNER. Some causes grow the refused
// population because the change that introduced them made a silent wrong acceptance refuse at a
// located site (DESIGN section 5): the identities were never correct, they were only accepted. The
// native frontier ratchet (gunbc.native_frontier_ratchet) reads a new refusal under such a cause as
// owned baseline debt rather than as a frontier loss, and it reads nothing else that way.
//
// WHY A DECLARATION BESIDE THE ROW AND NOT A FIELD ON IT. Ownership (who counts the cause, what
// retires it) and the flip (the pull request that made the cause start firing, and why that is a
// correction) are two facts with different lifetimes: the flip matters only while a roster minted
// before it is being reconciled, and the ownership outlives it. A declaration counts only when its
// cause is OWNED at the same grain (cause_correctness_flip_lookup_over joins the two), so an orphan
// declaration grants nothing and the unowned increase stays a loss.
//
// THE LIFETIME IS A FIELD, NOT A PROMISE (review 71692). `reconciles_tested_tree` names the tested
// tree of the committed roster the flip lands against. A consumer admits growth under the
// declaration only while the roster it judges against carries that same tree; the first re-mint
// changes the tree and the grant lapses, so a later refusal under the same cause is a loss again,
// not a correction relabelled.
type CorrectnessFlipDeclaration {
  cause: Symbol
  grain: DiagnosticGrain
  pull_request: Int
  reconciles_tested_tree: String
  why: String
}

// THE OWNING ROW AND THE DECLARATION, JOINED. This is what a ratchet disposition carries.
type CauseCorrectnessFlip {
  owner: CauseOwnership
  pull_request: Int
  reconciles_tested_tree: String
  why: String
}

// Empty on purpose: a row lands in the same pull request that makes its cause start firing, never
// in a later hand edit, and never as a pattern over causes.
data known_correctness_flips: List<CorrectnessFlipDeclaration> = []

fn cause_correctness_flip_lookup_over(
  cause: Symbol,
  grain: DiagnosticGrain,
  owners: List<CauseOwnership>,
  flips: List<CorrectnessFlipDeclaration>
) -> Optional<CauseCorrectnessFlip> {
  match list_find_first(xs: owners, predicate: fn(row) {
    row.cause == cause && discriminant(v: row.grain) == discriminant(v: grain)
  }) {
    Absent => optional_absent()
    Present { value: owner } =>
      match list_find_first(xs: flips, predicate: fn(d) {
        d.cause == cause && discriminant(v: d.grain) == discriminant(v: grain)
      }) {
        Absent => optional_absent()
        Present { value: d } => optional_present(value: CauseCorrectnessFlip { owner: owner, pull_request: d.pull_request, reconciles_tested_tree: d.reconciles_tested_tree, why: d.why })
      }
  }
}
