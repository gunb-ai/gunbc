module v2.workflow.enforcement_live


// Phase 0A honesty: live_receipt_for_contract passes desired_scope: whole_corpus_scope deliberately, NOT contract.claimed_scope. Passing claimed_scope would self-certify (claimed covers claimed by construction) and, worse, would green Cost's scope leg on decl_facts name discovery alone (~1400 discovered fn names, 0 body-evaluated). The honest model needs three facts — required_scope, claimed_scope, evaluated_scope — with meaningful checks claimed-covers-required and evaluated-covers-claimed; evaluated_scope does not exist until execution receipts land. Do NOT pass claimed_scope here until evaluated_scope exists.
fn enforcement_ci_witness_entries() -> List<std.realization_schedule.ScheduleWitnessEntry> {
  project_ci_floor_witness_entries(roster: commit_gate_roster)
}

fn enforcement_prepush_witness_entries() -> List<std.realization_schedule.ScheduleWitnessEntry> {
  witness_entries_from_enrollments(
    rows: filter(xs: commit_gate_roster, predicate: fn(e) {
      enrollment_has_surface(e: e, surface: GitPrePushHook)
    })
  )
}

fn self_module_prefix_for(module_path: v2.lens.registry.LensModulePathV0) -> String {
  match module_path {
    Bound { path } => logical_qualified_name_from_module(module_name: path, name: "")
    Unbound => "unbound-lens-module-path:"
  }
}

fn enforcement_corpus_facts() -> List<v2.std.decl_index.DeclFact> {
  decl_facts(pool_roots: whole_corpus_scope.roots)
}

fn live_receipt_for_contract(
  c: v2.lens.enforcement.contract.LensContract,
  facts: List<v2.std.decl_index.DeclFact>,
  ci_entries: List<std.realization_schedule.ScheduleWitnessEntry>,
  prepush_entries: List<std.realization_schedule.ScheduleWitnessEntry>
) -> v2.lens.enforcement.contract.EnrollmentDiscoveryReceipt {
  derive_receipt(
    contract: c,
    desired_scope: whole_corpus_scope,
    self_module_prefix: self_module_prefix_for(module_path: c.entry.module_path),
    facts: facts,
    ci_entries: ci_entries,
    prepush_entries: prepush_entries
  )
}

fn coverage_receipts_from(facts: List<v2.std.decl_index.DeclFact>) -> List<v2.lens.enforcement.contract.EnrollmentDiscoveryReceipt> {
  let ci_entries = enforcement_ci_witness_entries()
  let prepush_entries = enforcement_prepush_witness_entries()
  fold(lens_contract_registry, init: [], f: fn(acc, c) {
    if lens_contract_is_unbound(c: c) {
      acc
    } else {
      list_append(
        left: [live_receipt_for_contract(c: c, facts: facts, ci_entries: ci_entries, prepush_entries: prepush_entries)],
        right: acc
      )
    }
  })
}

fn unbound_contract_count() -> Int {
  fold(lens_contract_registry, init: 0, f: fn(acc, c) {
    if lens_contract_is_unbound(c: c) { acc + 1 } else { acc }
  })
}

fn coverage_receipts_live() -> List<v2.lens.enforcement.contract.EnrollmentDiscoveryReceipt> {
  coverage_receipts_from(facts: enforcement_corpus_facts())
}

fn complexity_repo_wide_verdict_live() -> v2.lens.enforcement.gate.IntentVerdict {
  intent_family_verdict(
    intent: standing_intent_complexity_repo_wide,
    contracts: lens_contract_registry,
    receipts: coverage_receipts_live()
  )
}

fn enforcement_consistency_live() -> Bool {
  blocking_consumers_enrolled(contracts: lens_contract_registry, receipts: coverage_receipts_live())
}

fn lens_closure_question_zero_holds_live() -> Bool {
  lens_closure_question_zero_holds()
}

fn fn_item_count_live() -> Int {
  fn_item_count_of(facts: enforcement_corpus_facts())
}

fn body_unavailable_count_live() -> Int {
  body_unavailable_count_of(facts: enforcement_corpus_facts())
}

fn body_judged_count_live() -> Int {
  body_judged_count_of(facts: enforcement_corpus_facts())
}

fn lens_enforcement_inventory_live() -> List<v2.lens.enforcement.inventory.LensEnforcementInventoryRow> {
  let facts = enforcement_corpus_facts()
  let ci_entries = enforcement_ci_witness_entries()
  let prepush_entries = enforcement_prepush_witness_entries()
  derive_lens_enforcement_inventory(
    contracts: lens_contract_registry,
    intents: standing_intent_registry,
    receipts: coverage_receipts_from(facts: facts),
    facts: facts,
    ci_entries: ci_entries,
    prepush_entries: prepush_entries
  )
}

fn witness_admission_inventory_live() -> List<v2.lens.enforcement.inventory.WitnessAdmissionInventoryRow> {
  derive_witness_admission_inventory(
    exclusion_rows: gunbc.ci_layer_roots.witness_exclusion_frontier,
    ci_entries: enforcement_ci_witness_entries(),
    prepush_entries: enforcement_prepush_witness_entries()
  )
}
