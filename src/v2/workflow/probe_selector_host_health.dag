module v2.workflow.probe_selector_host_health


fn wf_host_health_enumerate_available(
  supply: v2.std.probe_selector.HostSupplyProjectionInput
) -> v2.std.probe_selector.DiagnosticCapabilityFacts {
  diagnostic_capability_from_host_supply(input: supply)
}

fn wf_host_health_select_probes(
  prior: SuspectedCausePrior<v2.std.probe_selector.HostHealthHypothesis>,
  budget: v2.std.probe_selector.CostBudget,
  available: v2.std.probe_selector.DiagnosticCapabilityFacts
) -> List<v2.std.probe_selector.ProbeCatalogEntry> {
  probe_select_host_health(prior: prior, budget: budget, available: available)
}

fn wf_host_health_classify_after_temporal(
  agg: v2.std.probe_selector.TemporalAggregator,
  now_ms: Int
) -> v2.std.logic.Bool {
  temporal_aggregator_drainable(agg: agg, now_ms: now_ms)
}

fn wf_host_health_probe_result_passed(result: v2.std.probe_selector.ProbeResult) -> v2.std.logic.Bool {
  result.passed
}
