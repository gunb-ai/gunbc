module v2.workflow.zz_bprog_verify_plan

import gunbc.ci_layer_roots { witness_layer_roots }
import std.realization_schedule {
  Runnable,
  RunnableDiscoveryBatch,
  ScheduleWitnessEntry,
  runnable_resource_profile_negligible
}
import std.measure { HardwareThreadCount, hardware_thread_count }
import std.types { List }

data zz_bprog_entry: String = "src/v2/test/claim/bash_program_fold_test.dag"

fn zz_bprog_verify_batches() -> List<List<Runnable>> {
  [[
    RunnableDiscoveryBatch {
      source_roots: witness_layer_roots,
      scan_dirs: [],
      explicit_entries: [
        ScheduleWitnessEntry { entry: zz_bprog_entry, function: "bash_program_serialize_matches_oracle_holds" },
        ScheduleWitnessEntry { entry: zz_bprog_entry, function: "bash_program_serialize_set_e_has_teeth_holds" }
      ],
      skip_unaffected_node_frontier: false,
      exclude_substrings: [],
      discovery_scope_dirs: [],
      spawn_width_cap: 1,
      profile: runnable_resource_profile_negligible()
    }
  ]]
}

fn zz_bprog_verify_plan_spawn_width() -> HardwareThreadCount {
  hardware_thread_count(count: 1)
}
