module v2.workflow.required_ci_measurement

import std.types { String, List, Bool }

// D0: measurement, publication and adjudication are three different facts. A subject may
// refuse while its measurement completed; that refusal remains publishable evidence. Failure
// to run the instrument is a different arm and cannot collapse into an absent artifact.
type RequiredCiBlocker {
  phase: String
  identity: String
  cause: String
}

type RequiredCiMeasurement
  = MeasurementCompleted { blockers: List<RequiredCiBlocker> }
  | MeasurementUnreached { cause: String }

fn required_ci_measurement_publishable(measurement: RequiredCiMeasurement) -> Bool {
  match measurement {
    MeasurementCompleted { blockers: _ } => true
    MeasurementUnreached { cause: _ } => true
  }
}

fn required_ci_measurement_admitted(measurement: RequiredCiMeasurement) -> Bool {
  match measurement {
    MeasurementCompleted { blockers: Empty {} } => true
    MeasurementCompleted { blockers: Cons { head: _, tail: _ } } => false
    MeasurementUnreached { cause: _ } => false
  }
}

