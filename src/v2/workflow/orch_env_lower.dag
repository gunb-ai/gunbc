module v2.workflow.orch_env_lower

import v2.std.orchestration { EnvBinding, EnvSet, EnvUnset }
import v2.std.algebra { FreeMonoid, list_head, list_tail, HeadFound, HeadAbsent, TailFound, TailAbsent }
import extdeps.languages.bash.program { ShellStmt, EnvPrefixed, EnvUnsetCmd, Raw }

fn lower_env_binding(b: EnvBinding, inner: ShellStmt) -> ShellStmt {
  match b {
    EnvSet { name: n, value: v } => EnvPrefixed { name: n, value: Raw { text: v }, command: inner }
    EnvUnset { name: n } => EnvUnsetCmd { name: n, command: inner }
  }
}

fn lower_env_bindings(env: FreeMonoid<EnvBinding>, command: ShellStmt) -> ShellStmt {
  match list_head(xs: env) {
    HeadAbsent => command
    HeadFound { value: b } =>
      match list_tail(xs: env) {
        TailAbsent => lower_env_binding(b: b, inner: command)
        TailFound { tail: rest } =>
          lower_env_binding(b: b, inner: lower_env_bindings(env: rest, command: command))
      }
  }
}
