data ci_floor_phase_journal_shell_emit_dissolution_trigger: std.dissolution.DissolutionCondition = std.dissolution.unbound_dissolution(description: "🟡 dissolve-on: ci_floor_phase_journal_if — bounded foreign-executor (GitHub Actions run:) shell transport for exactly four journal leaves: FileExists, column-name log, row-count summary log, and absent log. If/else control flow is already v2.std.orchestration intent; only those leaves remain medium-as-string Run.command values. DISSOLVES WHEN bash-emit (#5828 / ROADMAP shell-effectplan-to-bash / shell→intent Phase 2) binds typed filesystem observation plus diagnostic-log operations through host_effect_apply, so ci_floor_phase_journal_if contains no opaque shell command text.")

data ci_floor_phase_journal_roadmap_citation_note: String = "The symbolic ROADMAP row `shell-effectplan-to-bash` above is intentional. Neighboring shell-emission dissolve markers still carry the pre-existing stale pointer `6-shell-slice0`, which names no roadmap_authority row and is tracked for a separate shell-lane correction; do not normalize this live citation back to that spelling."

data ci_floor_phase_journal_runner_scaffold_comment: String = concat("# ", std.dissolution.dissolution_description(condition: ci_floor_phase_journal_shell_emit_dissolution_trigger))

