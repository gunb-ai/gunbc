data ci_floor_peak_cgroup_locate_shell_emit_dissolution_trigger: std.dissolution.DissolutionCondition = std.dissolution.unbound_dissolution(description: "🟡 dissolve-on: ci_cgroup_peak_locate_shell — foreign-executor (GitHub Actions run:) shell transport composing extdeps.linux.proc_self_cgroup unified-hierarchy membership (v2.extdeps.languages.bash_proc_self_cgroup) with std.path_intent NearestAncestorContaining dirname ascent (bash_orch_if). Procfs path is extdeps.linux.procfs ProcSelfCgroup. DISSOLVES WHEN shell→intent Phase 2 realizes cgroup membership plus path ascent on host_effect_apply / orchestration path arms without medium-as-string Run.command concat.")

data ci_floor_peak_cgroup_locate_runner_scaffold_comment: String = concat("# ", std.dissolution.dissolution_description(condition: ci_floor_peak_cgroup_locate_shell_emit_dissolution_trigger))

fn ci_floor_peak_run(command: String) -> v2.std.orchestration.Run {
  v2.std.orchestration.Run {
    command: command,
    env: Empty,
    redirect: v2.std.optional.Absent,
    capture: v2.std.optional.Absent
  }
}

fn ci_floor_peak_do(command: String) -> v2.std.orchestration.PipelineStep {
  Do { run: ci_floor_peak_run(command: command) }
}

fn ci_floor_peak_exit_zero(command: String) -> v2.std.orchestration.Predicate {
  v2.std.orchestration.ExitZero { run: ci_floor_peak_run(command: command) }
}

fn ci_floor_peak_emit_pipeline(p: v2.std.orchestration.Pipeline) -> String {
  match orch_emit_pipeline(p: p, medium: bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: d } =>
      match d {
        None => source.carried
        Some { diagnostics: _ } => ci_floor_peak_emit_refused_poison
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => ci_floor_peak_emit_refused_poison
  }
}

data ci_floor_peak_path_leaf_residue_note: String = "🟡 dissolve-on: v2.std.orchestration gains a path arm — Predicate carries PathPredicate and PipelineStep carries DirnameAscent — so the cgroup ascent while-loop is a typed node in the pipeline instead of derived text at a String seam. TODAY'S EXACT STATE: Predicate is ExitZero | LogMatches | StrEq | StrEmpty | StrNonempty | IntNe | Not | And | Or and PipelineStep is Do | Comment | Exit | If | For | While | Retry | Let | Call — neither coproduct has a path member, which is why ci_floor_peak_while_cond_command and ci_floor_peak_while_body_command lower to text HERE. When those arms exist they delete outright and orch_emit_step lowers the model at emission time; ci_floor_peak_nearest_ancestor_spec survives as the arm payload. LANDED IN THIS VERTICAL (not Phase 2 residue): unified-hierarchy membership decode is extdeps.linux.proc_self_cgroup; ci_floor_peak_assign_cgroup_dir_command composes v2.extdeps.languages.bash_proc_self_cgroup membership lowering with that path policy via bash_orch_if; procfs path is extdeps.linux.procfs ProcSelfCgroup. REMAINING Phase 2: the foreign-executor runtime-scan transport in bash_membership_assign_from_source (host_effect_apply typed observation) and peak reset/cat/echo calibration leaves (raw String — typed filesystem observation)."

fn ci_floor_peak_cgroup_locate_while() -> v2.std.orchestration.PipelineStep {
  v2.std.orchestration.While {
    cond: v2.std.orchestration.ExitZero {
      run: ci_floor_peak_run(command: ci_floor_peak_while_cond_command())
    },
    body: v2.std.orchestration.Pipeline {
      steps: [ci_floor_peak_do(command: ci_floor_peak_while_body_command())],
      on_failure: FailFast
    }
  }
}

fn ci_floor_peak_cgroup_locate_steps() -> List<v2.std.orchestration.PipelineStep> {
  [
    ci_floor_peak_do(command: ci_floor_peak_assign_cgroup_dir_command()),
    ci_floor_peak_cgroup_locate_while()
  ]
}

fn ci_floor_peak_cgroup_locate_with_scaffold_steps() -> List<v2.std.orchestration.PipelineStep> {
  concat(
    [ci_floor_peak_do(command: ci_floor_peak_cgroup_locate_runner_scaffold_comment)],
    ci_floor_peak_cgroup_locate_steps()
  )
}

fn ci_floor_peak_cgroup_locate_pipeline() -> v2.std.orchestration.Pipeline {
  v2.std.orchestration.Pipeline {
    steps: ci_floor_peak_cgroup_locate_with_scaffold_steps(),
    on_failure: FailFast
  }
}

fn ci_floor_peak_pre_reset_inner_if() -> v2.std.orchestration.PipelineStep {
  v2.std.orchestration.If {
    cond: ci_floor_peak_exit_zero(command: ci_floor_peak_echo_reset_redirect_command),
    then_: v2.std.orchestration.Pipeline {
      steps: [ci_floor_peak_do(command: ci_floor_peak_pre_reset_ok_command)],
      on_failure: FailFast
    },
    else_: v2.std.optional.Present {
      value: v2.std.orchestration.Pipeline {
        steps: [ci_floor_peak_do(command: ci_floor_peak_pre_reset_unsupported_command)],
        on_failure: FailFast
      }
    }
  }
}

fn ci_floor_peak_pre_peak_if() -> v2.std.orchestration.PipelineStep {
  v2.std.orchestration.If {
    cond: ci_floor_peak_exit_zero(command: ci_floor_peak_test_f_memory_peak_command),
    then_: v2.std.orchestration.Pipeline {
      steps: [ci_floor_peak_pre_reset_inner_if()],
      on_failure: FailFast
    },
    else_: v2.std.optional.Present {
      value: v2.std.orchestration.Pipeline {
        steps: [ci_floor_peak_do(command: ci_floor_peak_pre_unavailable_command)],
        on_failure: FailFast
      }
    }
  }
}

fn ci_floor_peak_pre_pipeline() -> v2.std.orchestration.Pipeline {
  v2.std.orchestration.Pipeline {
    steps: concat(ci_floor_peak_cgroup_locate_with_scaffold_steps(), [ci_floor_peak_pre_peak_if()]),
    on_failure: FailFast
  }
}

fn ci_floor_peak_post_peak_if() -> v2.std.orchestration.PipelineStep {
  v2.std.orchestration.If {
    cond: ci_floor_peak_exit_zero(command: ci_floor_peak_test_f_memory_peak_command),
    then_: v2.std.orchestration.Pipeline {
      steps: [ci_floor_peak_do(command: ci_floor_peak_post_ok_command)],
      on_failure: FailFast
    },
    else_: v2.std.optional.Present {
      value: v2.std.orchestration.Pipeline {
        steps: [ci_floor_peak_do(command: ci_floor_peak_post_unavailable_command)],
        on_failure: FailFast
      }
    }
  }
}

fn ci_floor_phase_journal_if() -> v2.std.orchestration.PipelineStep {
  v2.std.orchestration.If {
    cond: ci_floor_peak_exit_zero(command: ci_floor_phase_journal_present_command),
    then_: v2.std.orchestration.Pipeline {
      steps: [
        ci_floor_peak_do(command: ci_floor_phase_journal_header_command),
        ci_floor_peak_do(command: ci_floor_phase_journal_read_command)
      ],
      on_failure: FailFast
    },
    else_: v2.std.optional.Present {
      value: v2.std.orchestration.Pipeline {
        steps: [ci_floor_peak_do(command: ci_floor_phase_journal_absent_command)],
        on_failure: FailFast
      }
    }
  }
}

fn ci_floor_wet_witness_row_outcome_receipt_if() -> v2.std.orchestration.PipelineStep {
  v2.std.orchestration.If {
    cond: ci_floor_peak_exit_zero(command: ci_floor_wet_witness_row_outcome_receipt_present_command),
    then_: v2.std.orchestration.Pipeline {
      steps: [
        ci_floor_peak_do(command: ci_floor_wet_witness_row_outcome_receipt_header_command),
        ci_floor_peak_do(command: ci_floor_wet_witness_row_outcome_receipt_read_command)
      ],
      on_failure: FailFast
    },
    else_: v2.std.optional.Present {
      value: v2.std.orchestration.Pipeline {
        steps: [ci_floor_peak_do(command: ci_floor_wet_witness_row_outcome_receipt_absent_command)],
        on_failure: FailFast
      }
    }
  }
}

fn ci_floor_peak_post_pipeline() -> v2.std.orchestration.Pipeline {
  v2.std.orchestration.Pipeline {
    steps: concat(
      [
        ci_floor_peak_do(command: ci_floor_phase_journal_runner_scaffold_comment),
        ci_floor_phase_journal_if(),
        ci_floor_peak_do(command: ci_floor_wet_witness_row_outcome_receipt_runner_scaffold_comment),
        ci_floor_wet_witness_row_outcome_receipt_if()
      ],
      concat(ci_floor_peak_cgroup_locate_with_scaffold_steps(), [ci_floor_peak_post_peak_if()])
    ),
    on_failure: FailFast
  }
}

fn ci_cgroup_peak_locate_shell() -> String {
  ci_floor_peak_emit_pipeline(p: ci_floor_peak_cgroup_locate_pipeline())
}

fn ci_floor_peak_pre_script() -> String {
  ci_floor_peak_emit_pipeline(p: ci_floor_peak_pre_pipeline())
}

fn ci_floor_peak_post_script() -> String {
  ci_floor_peak_emit_pipeline(p: ci_floor_peak_post_pipeline())
}
