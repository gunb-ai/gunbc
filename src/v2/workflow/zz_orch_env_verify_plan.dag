module v2.workflow.zz_orch_env_verify_plan

import gunbc.ci_layer_roots { witness_layer_roots }
import std.realization_schedule {
  Runnable,
  RunnableDiscoveryBatch,
  ScheduleWitnessEntry,
  runnable_resource_profile_negligible
}
import std.measure { HardwareThreadCount, hardware_thread_count }
import std.types { List }

data zz_emit_entry: String = "src/v2/workflow/orchestration_emit_test.dag"
data zz_bash_entry: String = "src/v2/workflow/orchestration_bash_test.dag"
data zz_retry_entry: String = "src/v2/workflow/orchestration_retry_emit_test.dag"

fn zz_emit_roster() -> List<ScheduleWitnessEntry> {
  [
    ScheduleWitnessEntry { entry: zz_emit_entry, function: "orch_pipeline_single_step_is_run_holds" },
    ScheduleWitnessEntry { entry: zz_emit_entry, function: "orch_pipeline_two_steps_newline_joined_holds" },
    ScheduleWitnessEntry { entry: zz_emit_entry, function: "orch_pipeline_join_has_teeth_holds" },
    ScheduleWitnessEntry { entry: zz_emit_entry, function: "orch_run_empty_env_delegates_to_shell_emit_holds" },
    ScheduleWitnessEntry { entry: zz_emit_entry, function: "orch_run_env_prefixed_structured_holds" },
    ScheduleWitnessEntry { entry: zz_emit_entry, function: "orch_run_env_unset_multi_binding_structured_holds" }
  ]
}

fn zz_bash_roster() -> List<ScheduleWitnessEntry> {
  [
    ScheduleWitnessEntry { entry: zz_bash_entry, function: "orch_run_bare_emits_command_holds" },
    ScheduleWitnessEntry { entry: zz_bash_entry, function: "orch_run_env_prefix_derived_from_intent_holds" },
    ScheduleWitnessEntry { entry: zz_bash_entry, function: "orch_run_env_value_has_teeth_holds" },
    ScheduleWitnessEntry { entry: zz_bash_entry, function: "orch_run_env_unset_emits_env_u_holds" }
  ]
}

fn zz_retry_roster() -> List<ScheduleWitnessEntry> {
  [
    ScheduleWitnessEntry { entry: zz_retry_entry, function: "orch_retry_row_direct_emit_accepted_holds" },
    ScheduleWitnessEntry { entry: zz_retry_entry, function: "orch_retry_byte_identical_to_hand_authored_holds" },
    ScheduleWitnessEntry { entry: zz_retry_entry, function: "orch_retry_env_value_has_teeth_holds" }
  ]
}

fn zz_disc(roster: List<ScheduleWitnessEntry>) -> Runnable {
  RunnableDiscoveryBatch {
    source_roots: witness_layer_roots,
    scan_dirs: [],
    explicit_entries: roster,
    skip_unaffected_node_frontier: true,
    exclude_substrings: [],
    discovery_scope_dirs: [],
    spawn_width_cap: 1,
    profile: runnable_resource_profile_negligible()
  }
}

fn zz_orch_env_verify_batches() -> List<List<Runnable>> {
  [
    [zz_disc(roster: zz_emit_roster())],
    [zz_disc(roster: zz_bash_roster())],
    [zz_disc(roster: zz_retry_roster())]
  ]
}

fn zz_orch_env_verify_plan_spawn_width() -> HardwareThreadCount {
  hardware_thread_count(count: 1)
}
