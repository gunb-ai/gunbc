module v2.workflow.floor_changed_witness

import v2.workflow.required_floor {
  RequiredFloorDisposition,
  Planned, PlannedAsChangedWitness, DeclinedLongModule, DeclinedFixtureMember, DeclinedCostDebt,
  DeclinedOutsideRequiredGate, DeclinedOutsideGateClosure, DeclinedDiscoveryExcluded,
  ChangedWitnessCostPolicy, OrdinaryChangedWitnessCostPolicy, ChangedCostDebtVerdictOnly,
}
import v2.workflow.floor_terminal_ledger {
  ClaimDisposition,
  Passed, Failed, KnownRedHeld, KnownRedNowPassing, BudgetRefusedBeforeVerdict,
  PassedOverBudget, BudgetTerminalWithoutSafetyCause, HostToolUnresolvedBeforeVerdict,
  RouteGapBeforeVerdict, RuntimeErroredBeforeVerdict, PanickedBeforeVerdict,
  NotAttemptedAfterAbort, ObservationUnreadableBeforeVerdict,
}
import v2.workflow.local_repo_wet_terminal {
  LocalRepoWetJoin, LocalRepoWetJoinHolds, LocalRepoWetJoinRefused,
}
import v2.std.collection { List }
import v2.std.logic { Bool }
import std.measure { ClockBasis, CpuClock, Millisecond, Nanosecond }
import std.observation { Measured, MeasuredValue, MeasuredUnavailable, TimedMeasurement, observation_duration_of }

// THE CHANGED-WITNESS PROJECTION (operator-relayed ruling, 2026-08-30).
//
// THE INCIDENT THIS EXISTS FOR: two PRs added witness identities (+26 and +44) and the required
// floor reported GREEN while ZERO of the added identities executed — every one was
// `DeclinedOutsideGateClosure`, because the authored module names fall outside
// `v2.workflow.required_floor.required_gate_prefixes`. The per-identity facts were in the run's
// own disposition receipt (`required_floor_disposition.tsv`, one row per DECLARED identity);
// nothing projected them FOR THE CHANGED SET, so the author's question — "did the witnesses I
// just added actually run?" — was answered by a green context that had never looked.
//
// WHAT THIS IS NOT, by the same ruling: not a per-identity report over the ~10,600 declined
// identities (the §4b rung drop "Required gate reduced to the compiler floor" already names that
// population, and re-printing it per run buries the signal this projection exists to carry), and
// not a second declined-population instrument (the disposition receipt remains the single
// authority over admission facts; this module PROJECTS it onto the changed set, joined at the
// same identity grain the receipt is keyed by — the qualified `module.function` spelling).
//
// THE STANDING IS A JOIN OF TWO FACTS THE RUN ALREADY HOLDS — the identity's
// `RequiredFloorDisposition` and, where it executed, its terminal `ClaimDisposition` — restated
// in no new vocabulary: the `Declined` arm CARRIES the disposition rather than renaming it.
// THE THREE FACTS THAT TOGETHER REPLACE A VERDICT, and the reason they are one record rather than
// three loose booleans at the call site: any two of them without the third is a different, and
// wrong, claim. A route-gap agreement alone says only that the hermetic route could not reach the
// identity. A scheduled route alone says a policy claims to run it. A wet terminal alone says
// something passed somewhere. Only the conjunction, at the SAME identity, says the assertion
// actually ran against THIS candidate and held.
//
// THIS IS NOT `RouteGapBeforeVerdict` REINTERPRETED AS A PASS. That outcome stays nonterminal and
// stays blocking on its own; what changes is that a SECOND, independently produced terminal can be
// joined to it. The pattern is the cost-debt one directly above: a nonstandard path becomes
// admissible only when it carries the replacement observation, never because a roster says one
// ought to exist.
// THREE BOOLEANS WERE NOT THIS RECORD, THEY WERE THREE INDEPENDENT ASSERTIONS PACKAGED TOGETHER.
// The shape above read `route_gap_expectation_agreed / scheduled_route_live /
// wet_terminal_passed_on_candidate: Bool`, and nothing in it established that the three facts
// concerned the SAME identity or the same tree -- a caller could author true/true/true while
// supplying no route-gap row, no scheduled row, no terminal, no identity and no candidate. The
// paragraph above says the conjunction only means something "at the SAME identity"; the record did
// not carry an identity, so it could not say that, and the composition it describes was checked
// nowhere. What is carried now is the evidence itself, and the completeness predicate does the
// same-identity, same-candidate join the paragraph always claimed.
type WetTerminalAdmitted {
  identity: String
  candidate: String
}

type HermeticRouteGapWetEvidence
  = HermeticRouteGapWetUnavailable
  | HermeticRouteGapWetAdmitted { admitted: WetTerminalAdmitted, lane: LocalRepoWetJoin }

fn hermetic_route_gap_wet_join_complete(
  evidence: HermeticRouteGapWetEvidence,
  identity: String,
  candidate: String,
) -> Bool {
  match evidence {
    HermeticRouteGapWetUnavailable => false
    HermeticRouteGapWetAdmitted { admitted: a, lane: l } =>
      (a.identity == identity)
        && (a.candidate == candidate)
        && match l {
          LocalRepoWetJoinHolds => true
          LocalRepoWetJoinRefused { causes: _ } => false
        }
  }
}

type ChangedWitnessExecutionStanding =
    PlannedAndPassed
  | PlannedAndKnownRedHeld
  | PlannedAndPassedWithCostDebtObserved { observation: ChangedWitnessCostObservation }
  | CostObservationMissingUnderVerdictOnly
  | PlannedWithoutTerminalVerdict
  | HermeticRouteGapHeldAndWetPassed { evidence: HermeticRouteGapWetEvidence, identity: String, candidate: String }
  | Declined { disposition: RequiredFloorDisposition }
  | MissingDisposition

// WHAT THE RUN MEASURED FOR ONE CHANGED COST-DEBT IDENTITY (FLOOR-CHANGED-COST-0, operator
// ruling 2026-08-30).
//
// NO FIELD HERE CARRIES ITS UNIT OR ITS CLOCK IN ITS NAME. `std.measure`
// `measure_clock_basis_note` rules on exactly this shape -- a duration whose meaning lives only
// in the name of the field holding it, so `wall_nanos` and `cpu_nanos` compare, add and
// threshold as if they were one quantity -- and `std.observation` already carries the resolution:
// `List<TimedMeasurement>`, every clock tagged, read back by basis through
// `observation_duration_of`. That is the same shape `gunbc.witness_row_cost`
// `WitnessCostReceiptRow` uses for its `eval` term, so this is a reuse rather than a fourth
// spelling. `Measured` keeps an unreadable clock a NAMED state with its cause instead of a
// fabricated zero.
//
// THE LINE IS A `Millisecond` AND THE MEASUREMENTS ARE `Nanosecond`, per
// `std.measure` `nanosecond_millisecond_projection_note`: nanosecond is the canonical exact
// elapsed carrier, millisecond is the policy and presentation scale, and this line is policy --
// it is `required_floor_claim_cpu_safety_limit_ms` verbatim. It travels WITH its basis, because
// a budget and the figures compared against it are meaningless on different clocks (the same
// reason `std.observation` `ObservationOutcome.TimedOut` carries one basis over its pair).
//
// THE OBSERVATION IS A RECEIPT, NOT A REPAYMENT. It never edits or deletes the authored roster
// row: a single run landing under the line does not establish that a row whose observations
// ranged through 505ms has become safely ordinary, and the row leaves through the explicit
// debt-removal transaction.
type ChangedWitnessCostObservation {
  measured: List<TimedMeasurement>
  observed_against_basis: ClockBasis
  observed_against: Millisecond
}

// The measurement on the clock whose line was stood down. It is read by BASIS rather than by
// field position, so an observation that carries the other clock only cannot be mistaken for one
// that carries this one.
fn changed_witness_gated_clock_measurement(
  observation: ChangedWitnessCostObservation,
) -> Measured<Nanosecond> {
  observation_duration_of(
    durations: observation.measured,
    basis: observation.observed_against_basis,
  )
}

// WHETHER THE RUN HAS THAT MEASUREMENT AT ALL. Absent is an arm and not a zero: a claim that
// executed under the verdict-only override with NO published cost has had its CPU gate stood
// down and nothing put in its place, which is the absorbing-fallback shape DESIGN section 5
// forbids — the mechanism that stops gating also stops counting. It reds
// (`CostObservationMissingUnderVerdictOnly`), and so does an observation whose GATED CLOCK is
// `MeasuredUnavailable`, which is the same absence one level in.
type ChangedWitnessCostReading =
    CostObserved { observation: ChangedWitnessCostObservation }
  | CostUnobserved

// WHAT THE RUN CAN READ ABOUT ONE CHANGED IDENTITY, shaped exactly as the disposition receipt
// is: one optional disposition row, and — only meaningful on a Planned row — one optional
// terminal outcome. `NotExecuted` is the receipt's own outcome for a row that never ran; it is
// an arm here rather than an absent-by-default so that "the row says it did not execute" and
// "there is no row" stay two different facts with two different standings.
type ChangedWitnessTerminalReading =
    TerminalOutcome { outcome: ClaimDisposition }
  | NotExecuted

type ChangedWitnessDispositionReading =
    DispositionRow {
      disposition: RequiredFloorDisposition,
      terminal: ChangedWitnessTerminalReading,
      cost_policy: ChangedWitnessCostPolicy,
      cost: ChangedWitnessCostReading
    }
  | NoDispositionRow

// THE FOLD. Seven standings from the receipt facts, and every red is one of the four the rulings
// name: declined, missing, nonterminal, or a verdict-only override with no published cost.
//
// `PlannedAndPassed` MEANS an ordinary Pass. `PlannedAndKnownRedHeld` carries the distinct
// terminal fact that an enrolled expected-red failed exactly as enrolled (DESIGN §4b(4) keeps
// discriminating REDs enrolled, so adding or editing one is a sanctioned move this projection
// must not veto). Keeping that fact in the standing prevents a held RED from being described as
// passed even though both arms are green at this projection's grain. An enrolled row that passed
// (`KnownRedNowPassing` — the witness itself is green; the STALE roster row reds the floor at
// its own grain, `stale_quarantine`, with its own remedy, and a second red here would tell the
// author to fix a witness that is not broken).
//
// `PlannedWithoutTerminalVerdict` MEANS "no such verdict stands". That is deliberately wider
// than "the fold never reached it": a planned changed identity whose outcome is Failed,
// RouteGapBeforeVerdict, PanickedBeforeVerdict or any other remaining arm lands here too. Each
// of those already reds the floor through its own mechanism; what this projection adds is the
// CHANGED-SET grain — the line that names the identity the PR touched. The twelve outcome arms
// are spelled rather than wildcarded so a thirteenth `ClaimDisposition` arm must be classified
// here, never absorbed.
//
// `PlannedAndPassedWithCostDebtObserved` and `CostObservationMissingUnderVerdictOnly` are the two
// arms the FLOOR-CHANGED-COST-0 ruling adds, and they exist only under
// `ChangedCostDebtVerdictOnly` -- the join of changed selection with cost-debt enrollment. The
// first is green and CARRIES the measurement; the second is red and is the discriminating refusal
// for a gate stood down with nothing published in its place.

// THE GREEN VERDICT UNDER EACH POLICY. Ordinary selection keeps the standing it always had;
// the verdict-only override keeps the COST FACT in the standing rather than laundering it into
// an ordinary pass, so a reader of the changed-set lines can never mistake a row that ran on a
// stood-down CPU gate for a row that ran under one.
fn changed_witness_verdict_only_standing(
  cost: ChangedWitnessCostReading,
) -> ChangedWitnessExecutionStanding {
  match cost {
    CostUnobserved => CostObservationMissingUnderVerdictOnly {}
    CostObserved { observation: o } =>
      match changed_witness_gated_clock_measurement(observation: o) {
        MeasuredValue { value: _ } => PlannedAndPassedWithCostDebtObserved { observation: o }
        MeasuredUnavailable { cause: _ } => CostObservationMissingUnderVerdictOnly {}
      }
  }
}

fn changed_witness_green_standing(
  cost_policy: ChangedWitnessCostPolicy,
  cost: ChangedWitnessCostReading,
) -> ChangedWitnessExecutionStanding {
  match cost_policy {
    OrdinaryChangedWitnessCostPolicy => PlannedAndPassed {}
    ChangedCostDebtVerdictOnly => changed_witness_verdict_only_standing(cost: cost)
  }
}

// ONE CLASSIFICATION OF THE TERMINAL OUTCOME, SHARED BY BOTH PLANNED DISPOSITIONS. An earlier
// revision spelled this match twice -- once under `Planned` and once under
// `PlannedAsChangedWitness` -- with identical arms, so a thirteenth `ClaimDisposition` arm had to
// be classified in two places that could classify it differently (DESIGN section 2). The two
// dispositions differ in WHY the identity ran, which the disposition itself carries; they have
// never differed in how a verdict is judged.
//
// `PassedOverBudget` IS THE ONE ARM THE POLICY MOVES, and it moves in exactly one direction: it
// stays red under the ordinary policy -- an ordinary changed witness that exceeds the CPU line
// still reds -- and is green under `ChangedCostDebtVerdictOnly`, where the line was observed and
// not gating by ruling. Every other arm answers identically under both policies: a semantic
// `Failed`, a panic, a route gap, a runtime error, an unreadable observation, and a budget
// refusal that preempted the verdict (which is what the still-armed WALL deadline produces) all
// remain red, because none of them reached the verdict the changed set exists to learn.
fn changed_witness_planned_standing(
  terminal: ChangedWitnessTerminalReading,
  cost_policy: ChangedWitnessCostPolicy,
  cost: ChangedWitnessCostReading,
  wet: HermeticRouteGapWetEvidence,
  identity: String,
  candidate: String,
) -> ChangedWitnessExecutionStanding {
  match terminal {
    NotExecuted => PlannedWithoutTerminalVerdict {}
    TerminalOutcome { outcome: o } =>
      match o {
        Passed => changed_witness_green_standing(cost_policy: cost_policy, cost: cost)
        KnownRedNowPassing => changed_witness_green_standing(cost_policy: cost_policy, cost: cost)
        KnownRedHeld => PlannedAndKnownRedHeld {}
        PassedOverBudget =>
          match cost_policy {
            OrdinaryChangedWitnessCostPolicy => PlannedWithoutTerminalVerdict {}
            ChangedCostDebtVerdictOnly => changed_witness_verdict_only_standing(cost: cost)
          }
        Failed => PlannedWithoutTerminalVerdict {}
        BudgetRefusedBeforeVerdict => PlannedWithoutTerminalVerdict {}
        BudgetTerminalWithoutSafetyCause => PlannedWithoutTerminalVerdict {}
        HostToolUnresolvedBeforeVerdict => PlannedWithoutTerminalVerdict {}
        RouteGapBeforeVerdict =>
          if hermetic_route_gap_wet_join_complete(evidence: wet, identity: identity, candidate: candidate) {
            HermeticRouteGapHeldAndWetPassed { evidence: wet, identity: identity, candidate: candidate }
          } else {
            PlannedWithoutTerminalVerdict {}
          }
        RuntimeErroredBeforeVerdict => PlannedWithoutTerminalVerdict {}
        PanickedBeforeVerdict => PlannedWithoutTerminalVerdict {}
        NotAttemptedAfterAbort => PlannedWithoutTerminalVerdict {}
        ObservationUnreadableBeforeVerdict => PlannedWithoutTerminalVerdict {}
      }
  }
}

fn changed_witness_execution_standing(
  reading: ChangedWitnessDispositionReading,
  wet: HermeticRouteGapWetEvidence,
  identity: String,
  candidate: String,
) -> ChangedWitnessExecutionStanding {
  match reading {
    NoDispositionRow => MissingDisposition {}
    DispositionRow { disposition: d, terminal: t, cost_policy: p, cost: c } =>
      match d {
        Planned => changed_witness_planned_standing(terminal: t, cost_policy: p, cost: c, wet: wet, identity: identity, candidate: candidate)
        PlannedAsChangedWitness =>
          changed_witness_planned_standing(terminal: t, cost_policy: p, cost: c, wet: wet, identity: identity, candidate: candidate)
        DeclinedLongModule { matched_prefix: _ } => Declined { disposition: d }
        DeclinedFixtureMember { matched_prefix: _ } => Declined { disposition: d }
        DeclinedOutsideRequiredGate => Declined { disposition: d }
        DeclinedOutsideGateClosure => Declined { disposition: d }
        DeclinedDiscoveryExcluded { matched_substring: _ } => Declined { disposition: d }
        DeclinedCostDebt => Declined { disposition: d }
      }
  }
}

// THE BLOCKING POLARITY, STATED ONCE. Exactly two standings are green, and both required
// execution: a changed witness identity that did not run to a passing or enrolled-held verdict
// — for any reason, including a decline that is perfectly lawful for the STANDING population —
// is a red at the changed-set grain, because the change is precisely the moment its author is
// present to route it, rename it into the gate, or remove it deliberately.
fn changed_witness_standing_blocks(standing: ChangedWitnessExecutionStanding) -> Bool {
  match standing {
    PlannedAndPassed => false
    PlannedAndKnownRedHeld => false
    PlannedAndPassedWithCostDebtObserved { observation: _ } => false
    CostObservationMissingUnderVerdictOnly => true
    PlannedWithoutTerminalVerdict => true
    HermeticRouteGapHeldAndWetPassed { evidence: e, identity: i, candidate: c } =>
      !hermetic_route_gap_wet_join_complete(evidence: e, identity: i, candidate: c)
    Declined { disposition: _ } => true
    MissingDisposition => true
  }
}

type ChangedWitnessRow {
  identity: String
  standing: ChangedWitnessExecutionStanding
}

// THE ONE FOLD OVER THE CHANGED SET: the identities whose standing blocks, in input order.
// Zero changed identities is the positive control — an empty list in, an empty list out, and
// the required context stays green with zero projection lines.
fn changed_witness_blocking_identities(rows: List<ChangedWitnessRow>) -> List<String> {
  reverse(fold(rows, init: [], f: fn(acc, row) {
    if changed_witness_standing_blocks(standing: row.standing) {
      concat([row.identity], acc)
    } else {
      acc
    }
  }))
}
