module v2.test.workflow.rust_test_dag_closure

import v2.std.logic { Bool }
import v2.std.text { String }
import v2.std.algebra { length }
import v2.workflow.rust_test_dag_closure {
  closure_contains_path,
  coproduct_reflection_conformance_closure,
  rust_test_changed_in_closure,
  rust_test_must_run
}

data closure_in_path: String = "src/v2/std/node.dag"
data closure_off_path: String = "src/v2/lens/cost.dag"

test fn closure_is_declared_and_contains_node_dag() -> Bool {
  let declared = length(xs: coproduct_reflection_conformance_closure) > 0
  let has_node = closure_contains_path(
    closure: coproduct_reflection_conformance_closure,
    path: closure_in_path
  )
  declared && has_node
}

test fn declared_affected_test_must_run() -> Bool {
  rust_test_must_run(
    closure: coproduct_reflection_conformance_closure,
    changed: [closure_in_path],
    git_success: true
  )
}

test fn declared_unaffected_test_may_skip() -> Bool {
  rust_test_must_run(
    closure: coproduct_reflection_conformance_closure,
    changed: [closure_off_path],
    git_success: true
  ) == false
}

test fn undeclared_test_must_run() -> Bool {
  rust_test_must_run(closure: [], changed: [closure_off_path], git_success: true)
}

test fn git_failure_must_run() -> Bool {
  rust_test_must_run(
    closure: coproduct_reflection_conformance_closure,
    changed: [closure_off_path],
    git_success: false
  )
}

test fn changed_in_closure_matches_projection() -> Bool {
  let hit = rust_test_changed_in_closure(
    changed: [closure_in_path],
    closure: coproduct_reflection_conformance_closure
  )
  let miss = rust_test_changed_in_closure(
    changed: [closure_off_path],
    closure: coproduct_reflection_conformance_closure
  )
  hit && (miss == false)
}
