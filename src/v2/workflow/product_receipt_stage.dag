module v2.workflow.product_receipt_stage


// THE COMPOSITION, and why it runs HERE rather than in the driver that
// launched it.
//
// Boundary 1 -- the host deriving the manifest -- must happen before this
// process starts, because the manifest is a SOURCE ROOT this process is
// resolved against. That is the whole chicken-and-egg the existing gates
// route around by running each boundary in its own invocation and cleaning
// up in between. Here the manifest artifact is NOT cleaned: the driver hands
// this process the transaction directory and the digest of the exact bytes it
// wrote, and boundary 2 re-hashes the file it was actually resolved against.
// If those disagree, this run consumed a different artifact from the one the
// host produced, and the receipt says so instead of reporting six green
// components.

data product_receipt_stage_double_read_note: String = "DECLARED COST, not an oversight. Boundaries 2 and 3 read the admission through closure_emit_population_admission, and boundary 4 calls drive_compiler_closure_emit, which runs that same admission again -- so every ref is read from disk twice per transaction. The alternative was to call emit_compiler_import_closure_from_ingest directly with the ingest the first admission returned, which halves the reads and is exactly the composition the driver module says its factoring exists to permit. It is not taken here because the boundary-4 standing is supposed to be the DRIVER'S verdict, and reaching past the driver to its emitter would make this receipt report a composition that no production caller performs. The cost is one extra read pass over the closure; the alternative is a receipt about a path nobody runs. Dissolve-on: the driver exposing an arm that takes an already-admitted population and returns the same Outcome, at which point boundaries 2-4 share one read with no layer skipped."

data product_receipt_stage_manifest_rel: String = "/manifest/host_source_root_ingest_manifest.dag"
data product_receipt_stage_candidate_rel: String = "/candidate"
data product_receipt_stage_receipt_rel: String = "/receipt.txt"
data product_receipt_stage_census_rel: String = "/b4-retention-census.txt"

fn stage_identity_from_hex(hex: String, file_count: Int) -> v2.workflow.product_receipt.ArtifactIdentity {
  match std.content_hash.fnv1a64_structural_hex_digest(hex: hex) {
    v2.std.optional.Present { value: digest } =>
      v2.workflow.product_receipt.ArtifactIdentityKnown { digest: digest, file_count: file_count }
    v2.std.optional.Absent => v2.workflow.product_receipt.ArtifactIdentityAbsent { cause: v2.workflow.product_receipt.ProducerReportedNoArtifact }
  }
}

// The driver's refusal reason is a Symbol because a Diagnostic carries one.
// This maps that single authority onto the receipt's closed cause vocabulary
// rather than re-deriving the admission ladder, so there is still exactly one
// place that decides whether a population is admissible.
//
// THE LAST ARM CARRIES THE UNRECOGNISED LEXEME AND DOES NOT GUESS. The ladder
// enumerates the five reasons the driver has today; if a sixth is added, a
// terminal arm naming one of the five would attribute the refusal to a cause
// that did not fire -- a fabricated plausible output at exactly the point a
// reader trusts the receipt to say what stopped it. Carrying the reason
// through instead makes the gap visible in the receipt that hits it, and no
// consumer downstream has to have anticipated it.
fn stage_admission_cause(reason: v2.std.node.Symbol) -> v2.workflow.product_receipt.BoundaryRefusalCause {
  if reason == ^closure_emit_driver_empty_population {
    v2.workflow.product_receipt.ManifestPopulationEmpty
  } else {
    if reason == ^closure_emit_driver_coverage_incomplete {
      v2.workflow.product_receipt.ManifestCoverageIncomplete
    } else {
      if reason == ^closure_emit_driver_partial_population {
        v2.workflow.product_receipt.ManifestPopulationPartial
      } else {
        if reason == ^closure_emit_driver_population_digest_mismatch {
          v2.workflow.product_receipt.PopulationDigestMismatch
        } else {
          if reason == ^closure_emit_driver_source_read_failed {
            v2.workflow.product_receipt.ManifestSourceReadFailed
          } else {
            if reason == ^closure_emit_driver_ingest_row_shortfall {
              v2.workflow.product_receipt.IngestRowShortfall
            } else {
              v2.workflow.product_receipt.AdmissionReasonUnrecognized { reason: v2.std.compilers.lexing.symbol_lexeme(sym: reason) }
            }
          }
        }
      }
    }
  }
}

// Boundary 2 owns the population checks and boundary 3 owns the read. The
// admission ladder short-circuits, so a refusal on a boundary-2 cause leaves
// boundary 3 NotExercised -- which is the honest answer, not a failure.
fn stage_cause_belongs_to_read(cause: v2.workflow.product_receipt.BoundaryRefusalCause) -> v2.std.logic.Bool {
  match cause {
    v2.workflow.product_receipt.ManifestSourceReadFailed => true
    v2.workflow.product_receipt.IngestRowShortfall => true
    v2.workflow.product_receipt.AdmissionReasonUnrecognized { reason: _ } => false
    v2.workflow.product_receipt.ManifestNotProduced => false
    v2.workflow.product_receipt.ManifestOverlayNotResolved => false
    v2.workflow.product_receipt.ManifestPopulationEmpty => false
    v2.workflow.product_receipt.ManifestCoverageIncomplete => false
    v2.workflow.product_receipt.ManifestPopulationPartial => false
    v2.workflow.product_receipt.PopulationDigestMismatch => false
    v2.workflow.product_receipt.EmitterRejected { causes: _ } => false
    v2.workflow.product_receipt.EmittedHardRefusalsPresent { count: _ } => false
    v2.workflow.product_receipt.AssemblyRefused => false
    v2.workflow.product_receipt.CargoManifestWriteFailed => false
    v2.workflow.product_receipt.CargoBuildFailed => false
  }
}

fn stage_population_digest_identity() -> v2.workflow.product_receipt.ArtifactIdentity {
  match v2.compiler.source_authority.discovered_source_refs_digest_for_refs(refs: v2.test.workflow.host_source_root_ingest_manifest.host_source_root_closure_refs) {
    v2.compiler.source_authority.DiscoveredSourceRefsDigestFromList { digest: digest } =>
      v2.workflow.product_receipt.ArtifactIdentityKnown {
        digest: digest,
        file_count: v2.test.workflow.host_source_root_ingest_manifest.host_source_root_ingest_coverage_receipt.ingest_read_count
      }
    v2.compiler.source_authority.DiscoveredSourceRefsDigestUnavailable { cause: _ } =>
      v2.workflow.product_receipt.ArtifactIdentityAbsent { cause: v2.workflow.product_receipt.ProducerReportedNoArtifact }
  }
}

fn stage_not_exercised(boundary: v2.workflow.product_receipt.ProductBoundary) -> v2.workflow.product_receipt.BoundaryObservation {
  v2.workflow.product_receipt.BoundaryObservation {
    boundary: boundary,
    standing: v2.workflow.product_receipt.BoundaryNotExercised,
    consumed: v2.workflow.product_receipt.ArtifactIdentityAbsent { cause: v2.workflow.product_receipt.BoundaryNotReached },
    produced: v2.workflow.product_receipt.ArtifactIdentityAbsent { cause: v2.workflow.product_receipt.BoundaryNotReached }
  }
}

fn stage_refused(
  boundary: v2.workflow.product_receipt.ProductBoundary,
  cause: v2.workflow.product_receipt.BoundaryRefusalCause,
  consumed: v2.workflow.product_receipt.ArtifactIdentity
) -> v2.workflow.product_receipt.BoundaryObservation {
  v2.workflow.product_receipt.BoundaryObservation {
    boundary: boundary,
    standing: v2.workflow.product_receipt.BoundaryRefused { cause: cause },
    consumed: consumed,
    produced: v2.workflow.product_receipt.ArtifactIdentityAbsent { cause: v2.workflow.product_receipt.BoundaryNotReached }
  }
}

fn stage_completed(
  boundary: v2.workflow.product_receipt.ProductBoundary,
  consumed: v2.workflow.product_receipt.ArtifactIdentity,
  produced: v2.workflow.product_receipt.ArtifactIdentity
) -> v2.workflow.product_receipt.BoundaryObservation {
  v2.workflow.product_receipt.BoundaryObservation {
    boundary: boundary,
    standing: v2.workflow.product_receipt.BoundaryCompleted,
    consumed: consumed,
    produced: produced
  }
}

// symbol_lexeme is a host-intercepted bridge, so this partition is
// available to the INTERPRETED transport and would not survive a compiled
// realization of it unchanged. Stated because the receipt would otherwise
// look portable across realizations when one of its fields is not.
fn emitter_diagnostic_causes(ds: v2.std.diagnostic.NonEmptyDiagnostics) -> std.types.List<v2.workflow.product_receipt.DiagnosticCauseTally> {
  v2.std.algebra.fold_list(
    xs: ds.tail,
    empty: v2.workflow.product_receipt.diagnostic_tally_bump(
      tally: std.algebra.Empty,
      reason: v2.std.compilers.lexing.symbol_lexeme(sym: ds.head.reason)
    ),
    cons: fn(acc, d) {
      v2.workflow.product_receipt.diagnostic_tally_bump(tally: acc, reason: v2.std.compilers.lexing.symbol_lexeme(sym: d.reason))
    }
  )
}

type ProductReceiptCandidate {
  observation: v2.workflow.product_receipt.BoundaryObservation
  emitted_source: String
  census: v2.workflow.body_lowering_retention_census.CensusOutcome
}

func product_receipt_candidate(
  txn: String,
  candidate_dir: String,
  population_digest: v2.workflow.product_receipt.ArtifactIdentity
) -> ProductReceiptCandidate {
  match v2.compiler.self_host.compiler_closure_emit_driver.drive_compiler_closure_emit(
    refs: v2.test.workflow.host_source_root_ingest_manifest.host_source_root_closure_refs,
    receipt: v2.test.workflow.host_source_root_ingest_manifest.host_source_root_ingest_coverage_receipt,
    admission: v2.test.workflow.host_source_root_ingest_manifest.host_compiler_closure_admission,
    target: v2.extdeps.languages.rust.rust_target_model()
  ) {
    v2.std.diagnostic.Rejected { diagnostics: ds } =>
      product_receipt_candidate_refused(
        txn: txn,
        ds: ds,
        population_digest: population_digest
      )
    Accepted { value: value, diagnostics: _ } =>
      product_receipt_candidate_materialize(
        candidate_dir: candidate_dir,
        population_digest: population_digest,
        emitted_source: value.source.carried
      )
  }
}

// The census is written from INSIDE the transaction that produced the
// diagnostics, not reconstructed afterwards from a log. A census rebuilt by
// re-running the emitter would be a second observation of a second run, and
// the whole argument of this lane is that a boundary's evidence has to be the
// artifact the boundary actually produced.
func product_receipt_candidate_refused(
  txn: String,
  ds: v2.std.diagnostic.NonEmptyDiagnostics,
  population_digest: v2.workflow.product_receipt.ArtifactIdentity
) -> ProductReceiptCandidate {
  let census_write = Filesystem.Write(
    path: concat(txn, product_receipt_stage_census_rel),
    content: retention_census_render(families: retention_census(ds: ds))
  )
  ProductReceiptCandidate {
    observation: stage_refused(
      boundary: v2.workflow.product_receipt.ClosureCandidateEmitted,
      cause: v2.workflow.product_receipt.EmitterRejected { causes: emitter_diagnostic_causes(ds: ds) },
      consumed: population_digest
    ),
    emitted_source: "",
    census: if census_write.success { v2.workflow.body_lowering_retention_census.CensusWritten } else { v2.workflow.body_lowering_retention_census.CensusWriteFailed }
  }
}

func product_receipt_candidate_materialize(
  candidate_dir: String,
  population_digest: v2.workflow.product_receipt.ArtifactIdentity,
  emitted_source: String
) -> ProductReceiptCandidate {
  let hard_refusals = v2.std.algebra.length(xs: emitted_source.split("compile_error!")) - 1
  if hard_refusals > 0 {
    ProductReceiptCandidate {
      observation: stage_refused(
        boundary: v2.workflow.product_receipt.ClosureCandidateEmitted,
        cause: v2.workflow.product_receipt.EmittedHardRefusalsPresent { count: hard_refusals },
        consumed: population_digest
      ),
      emitted_source: emitted_source,
      census: v2.workflow.body_lowering_retention_census.CensusNotApplicable
    }
  } else {
    let made = shell.Mkdir.Parents(path: concat(candidate_dir, "/src"))
    let written = extdeps.filesystem.filesystem_io.Filesystem.Write(
      path: concat(candidate_dir, "/src/lib.rs"),
      content: emitted_source
    )
    if made.success && written.success {
      ProductReceiptCandidate {
        observation: stage_completed(
          boundary: v2.workflow.product_receipt.ClosureCandidateEmitted,
          consumed: population_digest,
          produced: v2.workflow.product_receipt.product_artifact_identity(value: emitted_source, file_count: 1)
        ),
        emitted_source: emitted_source,
        census: v2.workflow.body_lowering_retention_census.CensusNotApplicable
      }
    } else {
      ProductReceiptCandidate {
        observation: stage_refused(
          boundary: v2.workflow.product_receipt.ClosureCandidateEmitted,
          cause: v2.workflow.product_receipt.EmitterRejected { causes: std.algebra.Empty },
          consumed: population_digest
        ),
        emitted_source: emitted_source,
        census: v2.workflow.body_lowering_retention_census.CensusNotApplicable
      }
    }
  }
}

type ProductReceiptTail {
  b5: v2.workflow.product_receipt.BoundaryObservation
  b6: v2.workflow.product_receipt.BoundaryObservation
  b7: v2.workflow.product_receipt.BoundaryObservation
}

fn product_receipt_tail_not_exercised() -> ProductReceiptTail {
  ProductReceiptTail {
    b5: stage_not_exercised(boundary: v2.workflow.product_receipt.SeedLinkedAssembly),
    b6: stage_not_exercised(boundary: v2.workflow.product_receipt.AuthorityCargoManifest),
    b7: stage_not_exercised(boundary: v2.workflow.product_receipt.CargoBuild)
  }
}

func product_receipt_cargo_tail(
  root: String,
  candidate_dir: String,
  b5: v2.workflow.product_receipt.BoundaryObservation,
  assembled_identity: v2.workflow.product_receipt.ArtifactIdentity
) -> ProductReceiptTail {
  let cargo_manifest_text = tools.self_host_curated_seed_linked_harness.cssl_v1_compiled_probe_lib_cargo_toml(root: root)
  let written = extdeps.filesystem.filesystem_io.Filesystem.Write(
    path: concat(candidate_dir, "/Cargo.toml"),
    content: cargo_manifest_text
  )
  if written.success {
    let manifest_identity = v2.workflow.product_receipt.product_artifact_identity(value: cargo_manifest_text, file_count: 1)
    let build = cargo.Build.BuildManifest(
      workdir: candidate_dir,
      manifest_path: concat(candidate_dir, "/Cargo.toml"),
      target_dir: concat(candidate_dir, "/target"),
      extra_args: ["--release"]
    )
    ProductReceiptTail {
      b5: b5,
      b6: stage_completed(
        boundary: v2.workflow.product_receipt.AuthorityCargoManifest,
        consumed: assembled_identity,
        produced: manifest_identity
      ),
      b7: if build.success {
        stage_completed(
          boundary: v2.workflow.product_receipt.CargoBuild,
          consumed: manifest_identity,
          produced: v2.workflow.product_receipt.product_artifact_identity(value: "cargo-completed-with-zero-errors", file_count: 1)
        )
      } else {
        stage_refused(
          boundary: v2.workflow.product_receipt.CargoBuild,
          cause: v2.workflow.product_receipt.CargoBuildFailed,
          consumed: manifest_identity
        )
      }
    }
  } else {
    ProductReceiptTail {
      b5: b5,
      b6: stage_refused(
        boundary: v2.workflow.product_receipt.AuthorityCargoManifest,
        cause: v2.workflow.product_receipt.CargoManifestWriteFailed,
        consumed: assembled_identity
      ),
      b7: stage_not_exercised(boundary: v2.workflow.product_receipt.CargoBuild)
    }
  }
}

func product_receipt_tail(
  root: String,
  entry: String,
  candidate_dir: String,
  emitted_source: String,
  b4_ok: v2.std.logic.Bool
) -> ProductReceiptTail {
  if !b4_ok {
    product_receipt_tail_not_exercised()
  } else {
    let candidate_identity = v2.workflow.product_receipt.product_artifact_identity(value: emitted_source, file_count: 1)
    let assemble = gunbc.WitnessBin.Run(
      workdir: root,
      bin_path: concat(root, "/target/release/cssl_assemble"),
      args: [
        "--out-dir", candidate_dir,
        "--entry-dag", entry,
        "--root", root,
        "--std-bridge-dir", "dag/tools/self_host_std_bridge_shims"
      ]
    )
    let assembled_read = extdeps.filesystem.filesystem_io.Filesystem.Read(path: concat(candidate_dir, "/src/lib.rs"))
    let assembled_files = shell.Find.FilesByNameSorted(
      root: concat(candidate_dir, "/src"),
      name_glob: "*.rs"
    )
    let assembled_file_count = v2.std.algebra.length(xs: assembled_files.stdout.split("\n")) - 1
    if assemble.success
      && string_contains(s: assemble.stdout, pattern: "CSSL_ASSEMBLE: PASS")
      && assembled_read.success {
      let assembled_identity = v2.workflow.product_receipt.product_artifact_identity(
        value: assembled_read.content,
        file_count: assembled_file_count
      )
      product_receipt_cargo_tail(
        root: root,
        candidate_dir: candidate_dir,
        b5: stage_completed(
          boundary: v2.workflow.product_receipt.SeedLinkedAssembly,
          consumed: candidate_identity,
          produced: assembled_identity
        ),
        assembled_identity: assembled_identity
      )
    } else {
      ProductReceiptTail {
        b5: stage_refused(
          boundary: v2.workflow.product_receipt.SeedLinkedAssembly,
          cause: v2.workflow.product_receipt.AssemblyRefused,
          consumed: candidate_identity
        ),
        b6: stage_not_exercised(boundary: v2.workflow.product_receipt.AuthorityCargoManifest),
        b7: stage_not_exercised(boundary: v2.workflow.product_receipt.CargoBuild)
      }
    }
  }
}

func run_product_receipt_stage(txn: String, manifest_identity: String, entry: String) -> std.process.ProcessExit {
  let manifest_path = concat(txn, product_receipt_stage_manifest_rel)
  let candidate_dir = concat(txn, product_receipt_stage_candidate_rel)
  let root = git.Inspect.Toplevel()

  let b1_produced = stage_identity_from_hex(hex: manifest_identity, file_count: 1)

  let manifest_read = extdeps.filesystem.filesystem_io.Filesystem.Read(path: manifest_path)
  let b2_consumed = if manifest_read.success {
    v2.workflow.product_receipt.product_artifact_identity(value: manifest_read.content, file_count: 1)
  } else {
    v2.workflow.product_receipt.ArtifactIdentityAbsent { cause: v2.workflow.product_receipt.ProducerReportedNoArtifact }
  }

  let overlay_resolved = manifest_read.success
    && v2.test.workflow.host_source_root_ingest_manifest.host_source_root_ingest_content_hash != ""
    && string_contains(s: manifest_read.content, pattern: v2.test.workflow.host_source_root_ingest_manifest.host_source_root_ingest_content_hash)

  let admission = v2.compiler.self_host.compiler_closure_emit_driver.closure_emit_population_admission(
    refs: v2.test.workflow.host_source_root_ingest_manifest.host_source_root_closure_refs,
    receipt: v2.test.workflow.host_source_root_ingest_manifest.host_source_root_ingest_coverage_receipt
  )

  let admission_cause = match admission {
    v2.compiler.self_host.compiler_closure_emit_driver.ClosureEmitPopulationRefused { reason: reason } => stage_admission_cause(reason: reason)
    v2.compiler.self_host.compiler_closure_emit_driver.ClosureEmitPopulationAdmitted { ingest: _ } => v2.workflow.product_receipt.ManifestNotProduced
  }
  let admitted = match admission {
    v2.compiler.self_host.compiler_closure_emit_driver.ClosureEmitPopulationRefused { reason: _ } => false
    v2.compiler.self_host.compiler_closure_emit_driver.ClosureEmitPopulationAdmitted { ingest: _ } => true
  }

  let population_digest = stage_population_digest_identity()

  let b2 = if !manifest_read.success {
    stage_refused(
      boundary: v2.workflow.product_receipt.ManifestPopulationAdmitted,
      cause: v2.workflow.product_receipt.ManifestNotProduced,
      consumed: b2_consumed
    )
  } else {
    if !overlay_resolved {
      stage_refused(
        boundary: v2.workflow.product_receipt.ManifestPopulationAdmitted,
        cause: v2.workflow.product_receipt.ManifestOverlayNotResolved,
        consumed: b2_consumed
      )
    } else {
      if admitted || stage_cause_belongs_to_read(cause: admission_cause) {
        stage_completed(
          boundary: v2.workflow.product_receipt.ManifestPopulationAdmitted,
          consumed: b2_consumed,
          produced: population_digest
        )
      } else {
        stage_refused(
          boundary: v2.workflow.product_receipt.ManifestPopulationAdmitted,
          cause: admission_cause,
          consumed: b2_consumed
        )
      }
    }
  }

  let b2_ok = match b2.standing {
    v2.workflow.product_receipt.BoundaryCompleted => true
    v2.workflow.product_receipt.BoundaryRefused { cause: _ } => false
    v2.workflow.product_receipt.BoundaryNotExercised => false
  }

  let b3 = if !b2_ok {
    stage_not_exercised(boundary: v2.workflow.product_receipt.RefsHashVerified)
  } else {
    if admitted {
      stage_completed(
        boundary: v2.workflow.product_receipt.RefsHashVerified,
        consumed: population_digest,
        produced: population_digest
      )
    } else {
      stage_refused(
        boundary: v2.workflow.product_receipt.RefsHashVerified,
        cause: admission_cause,
        consumed: population_digest
      )
    }
  }

  let b3_ok = match b3.standing {
    v2.workflow.product_receipt.BoundaryCompleted => true
    v2.workflow.product_receipt.BoundaryRefused { cause: _ } => false
    v2.workflow.product_receipt.BoundaryNotExercised => false
  }

  let candidate = if b3_ok {
    product_receipt_candidate(
      txn: txn,
      candidate_dir: candidate_dir,
      population_digest: population_digest
    )
  } else {
    ProductReceiptCandidate {
      observation: stage_not_exercised(boundary: v2.workflow.product_receipt.ClosureCandidateEmitted),
      emitted_source: "",
      census: v2.workflow.body_lowering_retention_census.CensusNotApplicable
    }
  }
  let b4 = candidate.observation
  let emitted_source = candidate.emitted_source
  let census_outcome = candidate.census

  let b4_ok = match b4.standing {
    v2.workflow.product_receipt.BoundaryCompleted => true
    v2.workflow.product_receipt.BoundaryRefused { cause: _ } => false
    v2.workflow.product_receipt.BoundaryNotExercised => false
  }

  let tail = product_receipt_tail(
    root: root.path,
    entry: entry,
    candidate_dir: candidate_dir,
    emitted_source: emitted_source,
    b4_ok: b4_ok
  )
  let b5 = tail.b5
  let b6 = tail.b6
  let b7 = tail.b7

  let receipt = v2.workflow.product_receipt.ProductReceipt {
    subject: entry,
    observations: [
      v2.workflow.product_receipt.BoundaryObservation {
        boundary: v2.workflow.product_receipt.HostDerivesManifest,
        standing: if manifest_read.success { v2.workflow.product_receipt.BoundaryCompleted } else {
          v2.workflow.product_receipt.BoundaryRefused { cause: v2.workflow.product_receipt.ManifestNotProduced }
        },
        consumed: v2.workflow.product_receipt.ArtifactIdentityAbsent { cause: v2.workflow.product_receipt.BoundaryNotReached },
        produced: b1_produced
      },
      b2,
      b3,
      b4,
      b5,
      b6,
      b7
    ]
  }

  let written = extdeps.filesystem.filesystem_io.Filesystem.Write(
    path: concat(txn, product_receipt_stage_receipt_rel),
    content: v2.workflow.product_receipt.product_receipt_render(receipt: receipt)
  )

  if !census_outcome_admits(outcome: census_outcome) {
    exit_failure(
      reason: "boundary-4 retention census could not be written; the receipt would understate a population it observed"
    )
  } else {
    if written.success && product_receipt_green(receipt: receipt) {
      std.process.ExitSuccess
    } else {
      exit_failure(reason: "seven-boundary product receipt is RED")
    }
  }
}
