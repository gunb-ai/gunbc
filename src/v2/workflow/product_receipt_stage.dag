// THE COMPOSITION, and why it runs HERE rather than in the driver that launched it.
//
// Boundary 1 -- the host deriving the manifest -- must happen before this process starts, because
// the manifest is a SOURCE ROOT this process is resolved against: the chicken-and-egg the existing
// gates route around by running each boundary in its own invocation and cleaning up in between.
// Here the manifest artifact is NOT cleaned: the driver hands this process the transaction
// directory and the digest of the exact bytes it wrote, and boundary 2 re-hashes the file it was
// actually resolved against. If those disagree, this run consumed a different artifact from the
// one the host produced, and the receipt says so instead of reporting six green components.

// DECLARED COST, not an oversight. Boundaries 2 and 3 read the admission through
// closure_emit_population_admission, and boundary 4 calls drive_compiler_closure_emit, which runs
// that admission again -- so every ref is read from disk twice per transaction. The alternative,
// calling emit_compiler_import_closure_from_ingest directly with the ingest the first admission
// returned, halves the reads and is exactly the composition the driver module says its factoring
// exists to permit. Not taken because the boundary-4 standing is supposed to be the DRIVER'S
// verdict, and reaching past the driver to its emitter would make this receipt report a
// composition no production caller performs. The cost is one extra read pass over the closure;
// the alternative is a receipt about a path nobody runs. Dissolve-on: the driver exposing an arm
// that takes an already-admitted population and returns the same Outcome, at which point
// boundaries 2-4 share one read with no layer skipped.

data product_receipt_stage_manifest_rel: String = "/manifest/host_source_root_ingest_manifest.dag"
data product_receipt_stage_candidate_rel: String = "/candidate"
data product_receipt_stage_receipt_rel: String = "/receipt.txt"
data product_receipt_stage_census_rel: String = "/b4-retention-census.txt"
data product_receipt_stage_ledger_rel: String = "/b4-diagnostic-ledger.txt"

fn stage_identity_from_hex(hex: String, file_count: Int) -> ArtifactIdentity {
  match fnv1a64_structural_hex_digest(hex: hex) {
    Present { value: digest } =>
      ArtifactIdentityKnown { digest: digest, file_count: file_count }
    Absent => ArtifactIdentityAbsent { cause: ProducerReportedNoArtifact }
  }
}

// The driver's refusal reason is a Symbol because a Diagnostic carries one. This maps that single
// authority onto the receipt's closed cause vocabulary rather than re-deriving the admission
// ladder, so exactly one place still decides whether a population is admissible.
//
// THE LAST ARM CARRIES THE UNRECOGNISED LEXEME AND DOES NOT GUESS. The ladder enumerates the five
// reasons the driver has today; if a sixth is added, a terminal arm naming one of the five would
// attribute the refusal to a cause that did not fire -- a fabricated plausible output at exactly
// the point a reader trusts the receipt. Carrying the reason through makes the gap visible in the
// receipt that hits it, and no downstream consumer has to have anticipated it.
fn stage_admission_cause(reason: Symbol) -> BoundaryRefusalCause {
  if reason == ^closure_emit_driver_empty_population {
    ManifestPopulationEmpty
  } else {
    if reason == ^closure_emit_driver_coverage_incomplete {
      ManifestCoverageIncomplete
    } else {
      if reason == ^closure_emit_driver_partial_population {
        ManifestPopulationPartial
      } else {
        if reason == ^closure_emit_driver_population_digest_mismatch {
          PopulationDigestMismatch
        } else {
          if reason == ^closure_emit_driver_source_read_failed {
            ManifestSourceReadFailed
          } else {
            if reason == ^closure_emit_driver_ingest_row_shortfall {
              IngestRowShortfall
            } else {
              AdmissionReasonUnrecognized { reason: symbol_lexeme(sym: reason) }
            }
          }
        }
      }
    }
  }
}

// THE MANIFEST IS OBSERVED THROUGH THE FILESYSTEM OBSERVATION FOLD, AND ABSENCE IS ESTABLISHED BY
// THE LISTING, NEVER BY THE READ. Boundary 1 (the host derives the manifest) used to be decided by
// `manifest_read.success` alone, and an unreadable manifest answered
// `ArtifactIdentityAbsent { ProducerReportedNoArtifact }` -- attributing to the producer a report
// it never made. A read that refused cannot say whether the manifest was there; only a listing
// that succeeded and did not name it can. The three worlds now travel as three arms: observed
// (bytes in hand), absent (established by the listing), unobservable (a typed refusal carrying the
// cause). `ManifestSourceReadFailed` is deliberately NOT reused here: it is the closure-admission
// ladder's cause for ITS source reads, and one name with two meanings is the fork section 3
// forbids.
type ManifestFileObservation
  = ManifestObserved { content: String }
  | ManifestAbsent(FilesystemEstablishedAbsence)
  | ManifestUnobserved { cause: String }

fn manifest_file_observation_of(o: FilesystemFileObservation) -> ManifestFileObservation {
  match o {
    FilesystemFileRead { path: _, content: c } => ManifestObserved { content: c }
    FilesystemFileAbsent(established) => ManifestAbsent(established)
    FilesystemFileIndeterminate { cause: c } => ManifestUnobserved { cause: c }
    FilesystemFileObservationsDisagree { path: _, cause: c } => ManifestUnobserved { cause: c }
    FilesystemFileSubjectRefused { directory: _, name: _, cause: c } => ManifestUnobserved { cause: c }
  }
}

// THE BOUNDARY DECISIONS ARE TOTAL OVER THE OBSERVATION, which is what makes them claimable: the
// wet stage executes the listing and the read and then consumes these verdicts verbatim, so the
// claim suite can hold the policy (observed completes boundary 1 and feeds boundary 2's ladder; an
// established absence refuses boundary 1 and 2 as not produced; an unobserved manifest refuses
// both with its cause and is never attributed to the producer) without running a transaction.
fn manifest_boundary1_standing(o: ManifestFileObservation) -> BoundaryStanding {
  match o {
    ManifestObserved { content: _ } => BoundaryCompleted
    ManifestAbsent(_) => BoundaryRefused { cause: ManifestNotProduced }
    ManifestUnobserved { cause: c } => BoundaryRefused { cause: ManifestUnobservable { cause: c } }
  }
}

fn manifest_boundary2_consumed(o: ManifestFileObservation) -> ArtifactIdentity {
  match o {
    ManifestObserved { content: c } => product_artifact_identity(value: c, file_count: 1)
    ManifestAbsent(_) => ArtifactIdentityAbsent { cause: ProducerReportedNoArtifact }
    ManifestUnobserved { cause: c } =>
      ArtifactIdentityAbsent { cause: ProducerUnobservable { cause: c } }
  }
}

fn manifest_overlay_resolved(o: ManifestFileObservation) -> Bool {
  match o {
    ManifestObserved { content: c } =>
      host_source_root_ingest_content_hash != ""
        && string_contains(s: c, pattern: host_source_root_ingest_content_hash)
    ManifestAbsent(_) => false
    ManifestUnobserved { cause: _ } => false
  }
}

fn observed_manifest_b2_standing(
  overlay_resolved: Bool,
  admitted: Bool,
  admission_cause: BoundaryRefusalCause,
  consumed: ArtifactIdentity,
  population_digest: ArtifactIdentity
) -> BoundaryObservation {
  if !overlay_resolved {
    stage_refused(
      boundary: ManifestPopulationAdmitted,
      cause: ManifestOverlayNotResolved,
      consumed: consumed
    )
  } else {
    if admitted || stage_cause_belongs_to_read(cause: admission_cause) {
      stage_completed(
        boundary: ManifestPopulationAdmitted,
        consumed: consumed,
        produced: population_digest
      )
    } else {
      stage_refused(
        boundary: ManifestPopulationAdmitted,
        cause: admission_cause,
        consumed: consumed
      )
    }
  }
}

// Boundary 2 owns the population checks and boundary 3 owns the read. The
// admission ladder short-circuits, so a refusal on a boundary-2 cause leaves
// boundary 3 NotExercised -- which is the honest answer, not a failure.
fn stage_cause_belongs_to_read(cause: BoundaryRefusalCause) -> Bool {
  match cause {
    ManifestSourceReadFailed => true
    IngestRowShortfall => true
    ManifestUnobservable { cause: _ } => false
    AdmissionReasonUnrecognized { reason: _ } => false
    ManifestNotProduced => false
    ManifestOverlayNotResolved => false
    ManifestPopulationEmpty => false
    ManifestCoverageIncomplete => false
    ManifestPopulationPartial => false
    PopulationDigestMismatch => false
    EmitterRejected { causes: _, advisories: _ } => false
    EmittedHardRefusalsPresent { count: _ } => false
    AssemblyRefused => false
    EmittedCargoManifestUnreadable => false
    CargoManifestWriteFailed => false
    CargoBuildFailed => false
  }
}

fn stage_population_digest_identity() -> ArtifactIdentity {
  match discovered_source_refs_digest_for_refs(refs: host_source_root_closure_refs) {
    DiscoveredSourceRefsDigestFromList { digest: digest } =>
      ArtifactIdentityKnown {
        digest: digest,
        file_count: host_source_root_ingest_coverage_receipt.ingest_read_count
      }
    DiscoveredSourceRefsDigestUnavailable { cause: _ } =>
      ArtifactIdentityAbsent { cause: ProducerReportedNoArtifact }
  }
}

fn stage_not_exercised(boundary: ProductBoundary) -> BoundaryObservation {
  BoundaryObservation {
    boundary: boundary,
    standing: BoundaryNotExercised,
    consumed: ArtifactIdentityAbsent { cause: BoundaryNotReached },
    produced: ArtifactIdentityAbsent { cause: BoundaryNotReached }
  }
}

fn stage_refused(
  boundary: ProductBoundary,
  cause: BoundaryRefusalCause,
  consumed: ArtifactIdentity
) -> BoundaryObservation {
  BoundaryObservation {
    boundary: boundary,
    standing: BoundaryRefused { cause: cause },
    consumed: consumed,
    produced: ArtifactIdentityAbsent { cause: BoundaryNotReached }
  }
}

fn stage_completed(
  boundary: ProductBoundary,
  consumed: ArtifactIdentity,
  produced: ArtifactIdentity
) -> BoundaryObservation {
  BoundaryObservation {
    boundary: boundary,
    standing: BoundaryCompleted,
    consumed: consumed,
    produced: produced
  }
}

// symbol_lexeme is a host-intercepted bridge, so this partition is
// available to the INTERPRETED transport and would not survive a compiled
// realization of it unchanged. Stated because the receipt would otherwise
// look portable across realizations when one of its fields is not.
fn emitter_diagnostic_causes(ds: NonEmptyDiagnostics) -> List<DiagnosticCauseTally> {
  diagnostic_tally_bump(tally: Empty, reason: symbol_lexeme(sym: diagnostics_fatal_reason(d: ds)))
}

// THE ADVISORIES ARE EVERY ELEMENT BUT THE LAST, counted by reason and kept apart from the cause:
// the chain is its prepended advisories followed by its fatal element, so tallying the whole chain
// as causes counted the grammar overlap residue once per row it carried and as often as the cause.
fn emitter_diagnostic_advisories(ds: NonEmptyDiagnostics) -> List<DiagnosticCauseTally> {
  fold_list(
    xs: ds.tail,
    empty: EmitterAdvisoryWalk { pending: ds.head, tally: Empty },
    cons: fn(acc, d) {
      EmitterAdvisoryWalk {
        pending: d,
        tally: diagnostic_tally_bump(tally: acc.tally, reason: symbol_lexeme(sym: acc.pending.reason))
      }
    }
  ).tally
}

// The walk holds one element back: each step tallies the element before it, so the last element
// (the fatal cause) is never tallied as an advisory.
type EmitterAdvisoryWalk {
  pending: Diagnostic
  tally: List<DiagnosticCauseTally>
}

type ProductReceiptCandidate {
  observation: BoundaryObservation
  emitted_source: String
  census: B4EvidenceOutcome
  ledger: B4EvidenceOutcome
}

fn product_receipt_candidate(
  txn: String,
  candidate_dir: String,
  population_digest: ArtifactIdentity
) -> ProductReceiptCandidate {
  match drive_compiler_closure_emit(
    refs: host_source_root_closure_refs,
    receipt: host_source_root_ingest_coverage_receipt,
    admission: host_compiler_closure_admission,
    target: rust_target_model()
  ) {
    Rejected { diagnostics: ds } =>
      product_receipt_candidate_refused(
        txn: txn,
        ds: ds,
        population_digest: population_digest
      )
    Accepted { value: value, diagnostics: _ } =>
      product_receipt_candidate_materialize(
        candidate_dir: candidate_dir,
        population_digest: population_digest,
        emitted_source: value.source.carried
      )
  }
}

// The census is written from INSIDE the transaction that produced the
// diagnostics, not reconstructed afterwards from a log. A census rebuilt by
// re-running the emitter would be a second observation of a second run, and
// the whole argument of this lane is that a boundary's evidence has to be the
// artifact the boundary actually produced.
fn product_receipt_candidate_refused(
  txn: String,
  ds: NonEmptyDiagnostics,
  population_digest: ArtifactIdentity
) -> ProductReceiptCandidate {
  let census_write = Filesystem.Write(
    path: concat(txn, product_receipt_stage_census_rel),
    content: retention_census_render(families: retention_census(ds: ds))
  )
  let ledger_write = Filesystem.Write(
    path: concat(txn, product_receipt_stage_ledger_rel),
    content: diagnostic_ledger_render(ds: ds)
  )
  ProductReceiptCandidate {
    observation: stage_refused(
      boundary: ClosureCandidateEmitted,
      cause: EmitterRejected { causes: emitter_diagnostic_causes(ds: ds), advisories: emitter_diagnostic_advisories(ds: ds) },
      consumed: population_digest
    ),
    emitted_source: "",
    census: if census_write.success { EvidenceWritten } else { EvidenceWriteFailed },
    ledger: if ledger_write.success { EvidenceWritten } else { EvidenceWriteFailed }
  }
}

fn product_receipt_candidate_materialize(
  candidate_dir: String,
  population_digest: ArtifactIdentity,
  emitted_source: String
) -> ProductReceiptCandidate {
  let hard_refusals = length(xs: emitted_source.split("compile_error!")) - 1
  if hard_refusals > 0 {
    ProductReceiptCandidate {
      observation: stage_refused(
        boundary: ClosureCandidateEmitted,
        cause: EmittedHardRefusalsPresent { count: hard_refusals },
        consumed: population_digest
      ),
      emitted_source: emitted_source,
      census: EvidenceNotApplicable,
      ledger: EvidenceNotApplicable
    }
  } else {
    let made = shell.Mkdir.Parents(path: concat(candidate_dir, "/src"))
    let written = Filesystem.Write(
      path: concat(candidate_dir, "/src/lib.rs"),
      content: emitted_source
    )
    if made.success && written.success {
      ProductReceiptCandidate {
        observation: stage_completed(
          boundary: ClosureCandidateEmitted,
          consumed: population_digest,
          produced: product_artifact_identity(value: emitted_source, file_count: 1)
        ),
        emitted_source: emitted_source,
        census: EvidenceNotApplicable,
        ledger: EvidenceNotApplicable
      }
    } else {
      ProductReceiptCandidate {
        observation: stage_refused(
          boundary: ClosureCandidateEmitted,
          cause: EmitterRejected { causes: Empty, advisories: Empty },
          consumed: population_digest
        ),
        emitted_source: emitted_source,
        census: EvidenceNotApplicable,
        ledger: EvidenceNotApplicable
      }
    }
  }
}

type ProductReceiptTail {
  b5: BoundaryObservation
  b6: BoundaryObservation
  b7: BoundaryObservation
}

fn product_receipt_tail_not_exercised() -> ProductReceiptTail {
  ProductReceiptTail {
    b5: stage_not_exercised(boundary: SeedLinkedAssembly),
    b6: stage_not_exercised(boundary: AuthorityCargoManifest),
    b7: stage_not_exercised(boundary: CargoBuild)
  }
}

fn product_receipt_manifest_refused(
  b5: BoundaryObservation,
  assembled_identity: ArtifactIdentity,
  cause: BoundaryRefusalCause
) -> ProductReceiptTail {
  ProductReceiptTail {
    b5: b5,
    b6: stage_refused(
      boundary: AuthorityCargoManifest,
      cause: cause,
      consumed: assembled_identity
    ),
    b7: stage_not_exercised(boundary: CargoBuild)
  }
}

fn product_receipt_cargo_tail(
  root: String,
  candidate_dir: String,
  b5: BoundaryObservation,
  assembled_identity: ArtifactIdentity
) -> ProductReceiptTail {
  match derive_harness_manifest_in_place(
    crate_dir: candidate_dir,
    target: ProbeLibTarget,
    linkage: SeedLinked { root: root }
  ) {
    EmittedManifestUnreadable { path: _ } =>
      product_receipt_manifest_refused(b5: b5, assembled_identity: assembled_identity, cause: EmittedCargoManifestUnreadable)
    HarnessManifestWriteFailed { path: _ } =>
      product_receipt_manifest_refused(b5: b5, assembled_identity: assembled_identity, cause: CargoManifestWriteFailed)
    HarnessManifestDerived { content: cargo_manifest_text } => {
      let manifest_identity = product_artifact_identity(value: cargo_manifest_text, file_count: 1)
      let build = cargo.Build.BuildManifest(
        workdir: candidate_dir,
        manifest_path: concat(candidate_dir, "/Cargo.toml"),
        target_dir: concat(candidate_dir, "/target"),
        extra_args: ["--release"]
      )
      ProductReceiptTail {
        b5: b5,
        b6: stage_completed(
          boundary: AuthorityCargoManifest,
          consumed: assembled_identity,
          produced: manifest_identity
        ),
        b7: if build.success {
          stage_completed(
            boundary: CargoBuild,
            consumed: manifest_identity,
            produced: product_artifact_identity(value: "cargo-completed-with-zero-errors", file_count: 1)
          )
        } else {
          stage_refused(
            boundary: CargoBuild,
            cause: CargoBuildFailed,
            consumed: manifest_identity
          )
        }
      }
    }
  }
}

fn product_receipt_tail(
  root: String,
  entry: String,
  candidate_dir: String,
  emitted_source: String,
  b4_ok: Bool
) -> ProductReceiptTail {
  if !b4_ok {
    product_receipt_tail_not_exercised()
  } else {
    let candidate_identity = product_artifact_identity(value: emitted_source, file_count: 1)
    let assemble = gunbc.WitnessBin.Run(
      workdir: root,
      bin_path: concat(root, "/target/release/cssl_assemble"),
      args: [
        "--out-dir", candidate_dir,
        "--entry-dag", entry,
        "--root", root
      ]
    )
    let assembled_read = Filesystem.Read(path: concat(candidate_dir, "/src/lib.rs"))
    let assembled_files = shell.Find.FilesByNameSorted(
      root: concat(candidate_dir, "/src"),
      name_glob: "*.rs"
    )
    let assembled_file_count = length(xs: assembled_files.stdout.split("\n")) - 1
    if assemble.success
      && string_contains(s: assemble.stdout, pattern: "CSSL_ASSEMBLE: PASS")
      && assembled_read.success {
      let assembled_identity = product_artifact_identity(
        value: assembled_read.content,
        file_count: assembled_file_count
      )
      product_receipt_cargo_tail(
        root: root,
        candidate_dir: candidate_dir,
        b5: stage_completed(
          boundary: SeedLinkedAssembly,
          consumed: candidate_identity,
          produced: assembled_identity
        ),
        assembled_identity: assembled_identity
      )
    } else {
      ProductReceiptTail {
        b5: stage_refused(
          boundary: SeedLinkedAssembly,
          cause: AssemblyRefused,
          consumed: candidate_identity
        ),
        b6: stage_not_exercised(boundary: AuthorityCargoManifest),
        b7: stage_not_exercised(boundary: CargoBuild)
      }
    }
  }
}

// ONE OBSERVATION, THREE WORLDS. The listing establishes what the read cannot: a manifest that
// was never written is ABSENT (the producer's transaction holds no manifest, which is what
// `ProducerReportedNoArtifact` may finally assert); a manifest that is there and cannot be read
// is UNOBSERVED and refuses with the cause; only bytes in hand are OBSERVED.
fn run_product_receipt_stage(txn: String, manifest_identity: String, entry: String) -> ProcessExit {
  let manifest_path = concat(txn, product_receipt_stage_manifest_rel)
  let candidate_dir = concat(txn, product_receipt_stage_candidate_rel)
  let root = git.Inspect.Toplevel()

  let b1_produced = stage_identity_from_hex(hex: manifest_identity, file_count: 1)

  let manifest_observation = manifest_file_observation_of(o: filesystem_file_observation_of_path(
    path: manifest_path
  ))

  let b2_consumed = manifest_boundary2_consumed(o: manifest_observation)

  let overlay_resolved = manifest_overlay_resolved(o: manifest_observation)

  let admission = closure_emit_population_admission(
    refs: host_source_root_closure_refs,
    receipt: host_source_root_ingest_coverage_receipt
  )

  let admission_cause = match admission {
    ClosureEmitPopulationRefused { reason: reason } => stage_admission_cause(reason: reason)
    ClosureEmitPopulationAdmitted { ingest: _ } => ManifestNotProduced
  }
  let admitted = match admission {
    ClosureEmitPopulationRefused { reason: _ } => false
    ClosureEmitPopulationAdmitted { ingest: _ } => true
  }

  let population_digest = stage_population_digest_identity()

  let b2 = match manifest_observation {
    ManifestAbsent(_) =>
      stage_refused(
        boundary: ManifestPopulationAdmitted,
        cause: ManifestNotProduced,
        consumed: b2_consumed
      )
    ManifestUnobserved { cause: c } =>
      stage_refused(
        boundary: ManifestPopulationAdmitted,
        cause: ManifestUnobservable { cause: c },
        consumed: b2_consumed
      )
    ManifestObserved { content: _ } =>
      observed_manifest_b2_standing(
        overlay_resolved: overlay_resolved,
        admitted: admitted,
        admission_cause: admission_cause,
        consumed: b2_consumed,
        population_digest: population_digest
      )
  }

  let b2_ok = match b2.standing {
    BoundaryCompleted => true
    BoundaryRefused { cause: _ } => false
    BoundaryNotExercised => false
  }

  let b3 = if !b2_ok {
    stage_not_exercised(boundary: RefsHashVerified)
  } else {
    if admitted {
      stage_completed(
        boundary: RefsHashVerified,
        consumed: population_digest,
        produced: population_digest
      )
    } else {
      stage_refused(
        boundary: RefsHashVerified,
        cause: admission_cause,
        consumed: population_digest
      )
    }
  }

  let b3_ok = match b3.standing {
    BoundaryCompleted => true
    BoundaryRefused { cause: _ } => false
    BoundaryNotExercised => false
  }

  let candidate = if b3_ok {
    product_receipt_candidate(
      txn: txn,
      candidate_dir: candidate_dir,
      population_digest: population_digest
    )
  } else {
    ProductReceiptCandidate {
      observation: stage_not_exercised(boundary: ClosureCandidateEmitted),
      emitted_source: "",
      census: EvidenceNotApplicable,
      ledger: EvidenceNotApplicable
    }
  }
  let b4 = candidate.observation
  let emitted_source = candidate.emitted_source
  let census_outcome = candidate.census
  let ledger_outcome = candidate.ledger

  let b4_ok = match b4.standing {
    BoundaryCompleted => true
    BoundaryRefused { cause: _ } => false
    BoundaryNotExercised => false
  }

  let tail = product_receipt_tail(
    root: root.path,
    entry: entry,
    candidate_dir: candidate_dir,
    emitted_source: emitted_source,
    b4_ok: b4_ok
  )
  let b5 = tail.b5
  let b6 = tail.b6
  let b7 = tail.b7

  let receipt = ProductReceipt {
    subject: entry,
    observations: [
      BoundaryObservation {
        boundary: HostDerivesManifest,
        standing: manifest_boundary1_standing(o: manifest_observation),
        consumed: ArtifactIdentityAbsent { cause: BoundaryNotReached },
        produced: b1_produced
      },
      b2,
      b3,
      b4,
      b5,
      b6,
      b7
    ]
  }

  let written = Filesystem.Write(
    path: concat(txn, product_receipt_stage_receipt_rel),
    content: product_receipt_render(receipt: receipt)
  )

  if !b4_evidence_outcome_admits(outcome: census_outcome) {
    exit_failure(
      reason: "boundary-4 retention census could not be written; the receipt would understate a population it observed"
    )
  } else if !b4_evidence_outcome_admits(outcome: ledger_outcome) {
    exit_failure(
      reason: "boundary-4 diagnostic ledger could not be written; the receipt would name a refusal it cannot attribute"
    )
  } else {
    if written.success && product_receipt_green(receipt: receipt) {
      ExitSuccess
    } else {
      exit_failure(reason: "seven-boundary product receipt is RED")
    }
  }
}
