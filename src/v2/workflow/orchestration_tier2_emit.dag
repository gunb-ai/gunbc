module v2.workflow.orchestration_tier2_emit

import v2.compiler.emit_orchestration {
  orch_emit_step
}
import v2.extdeps.languages.bash_orchestration_emit { bash_orchestration_emit_medium }
import v2.std.orchestration {
  PipelineStep,
  Let,
  ExprLit,
  ExprCmdSubst
}
import v2.std.diagnostic { Accepted, None, Outcome, Rejected }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Rows below pin the bash spellings of the two Let arms of the orchestration medium:
// v2.extdeps.languages.bash_orch_tier2 orch_cmdsubst_assign_target_model (ExprCmdSubst,
// reached through v2.compiler.emit_orchestration orch_emit_let_step's one-special-variant
// dispatch) and orch_let_assign_target_model (every other Expr). Each test compares the
// emitted bytes against its own golden, independently of the grammar rows. The goldens are
// the hand-authored bytes the deleted fleet_converge_emit.dag fresh_standup arm used to
// print; the arm is gone (fc47b4f9866, #7121) but the spellings keep their teeth here —
// the census rows are DISCHARGED in docs/plans/shell-to-dag-residual-census-and-arc-completion.md.

fn fresh_standup_cmdsubst_assign_intent() -> PipelineStep {
  Let {
    name: "dag_pin",
    value: ExprCmdSubst {
      callee: "converge_read_gunbc_host_pin",
      args: ["\"$checkout\""]
    }
  }
}

fn fresh_standup_cmdsubst_assign_golden() -> String {
  "dag_pin=\"$(converge_read_gunbc_host_pin \"$checkout\")\""
}

test fn orch_tier2_fresh_standup_cmdsubst_assign_holds() -> Bool {
  match orch_emit_step(
    s: fresh_standup_cmdsubst_assign_intent(),
    medium: bash_orchestration_emit_medium()
  ) {
    Accepted { value: src, diagnostics: dg } =>
      (src.carried == fresh_standup_cmdsubst_assign_golden()) && (dg == None)
    Rejected { diagnostics: _ } => false
  }
}

fn fresh_standup_verdict_absent_let_intent() -> PipelineStep {
  Let { name: "verdict", value: ExprLit { spelling: "absent" } }
}

fn fresh_standup_verdict_absent_let_golden() -> String {
  "verdict=absent"
}

test fn orch_tier2_fresh_standup_verdict_absent_let_holds() -> Bool {
  match orch_emit_step(
    s: fresh_standup_verdict_absent_let_intent(),
    medium: bash_orchestration_emit_medium()
  ) {
    Accepted { value: src, diagnostics: dg } =>
      (src.carried == fresh_standup_verdict_absent_let_golden()) && (dg == None)
    Rejected { diagnostics: _ } => false
  }
}

