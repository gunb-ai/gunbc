test fn orch_tier2_cmdsubst_assign_has_teeth_holds() -> Bool {
  match orch_emit_step(
    s: fresh_standup_cmdsubst_assign_intent(),
    medium: bash_orchestration_emit_medium()
  ) {
    Accepted { value: src, diagnostics: _ } =>
      src.carried != "dag_pin=\"$(converge_read_gunbc_host_pin \"$ctrl_pin\")\""
    Rejected { diagnostics: _ } => false
  }
}
