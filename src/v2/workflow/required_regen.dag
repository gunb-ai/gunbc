module v2.workflow.required_regen

import v2.workflow.regen_convergence_transaction {
  RegenConvergenceTransactionReceipt,
  RegenConvergenceRefusal,
  RegenFixedPointReached,
  RegenFixedPointRefused
}

import v2.std.algebra { Cons, Empty, fold_list, length, list_append }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }

// ONE FOLD OVER EMITTED SURFACES — no roster, no skip arm, no bare Bool at the seam.
// The host derives the compared populations from emit output and a directory read;
// this module owns the verdict, and the ORDER of production against adjudication.
//
// PRODUCTION PRECEDES ADJUDICATION, AND THE CARRIER IS WHAT MAKES THAT TRUE.
// A regen run answers two different questions with one emit: WHAT DOES THE EMITTER
// PRODUCE (the candidate tree) and DOES THE COMMITTED MIRROR AGREE WITH IT (the verdict).
// They were fused into one sequence whose refusal arms returned before the tree was
// written, so the single population asymmetry an author can actually cause — adding a
// module to the v1 seed closure, whose mirror is EmittedNotCommitted by construction on
// its first commit — refused with the remedy artifact destroyed. The refusal named a
// file the author was required to commit and no route in the repository produced it:
// regen_stage0, the binary that used to write the tree unconditionally, was deleted at
// the root by the regen cut and its PRODUCER half was never re-derived, only its
// VERIFIER half. A gate whose only closing move is unavailable does not refuse, it
// strands.
//
// RequiredRegenRunOutcome fixes the order in the type: every arm that reports a verdict
// carries the CandidateTree the verdict was computed against, so "refused, and no tree
// exists" has no spelling once emit succeeded. The one arm without a tree, RegenUnproduced,
// is reachable only where emit itself produced nothing — there is no candidate to name
// because none was produced, which is a different state from a verdict about one.

type RegenSurfaceOutcome
  = SurfaceMatches { relative_path: String }
  | SurfaceDrifted {
      relative_path: String
      committed_digest: String
      candidate_digest: String
    }
  | EmittedNotCommitted { relative_path: String }
  | CommittedNotEmitted { relative_path: String }
  | EmittedNotCommittedShadowsHandMaintained {
      relative_path: String
      hand_maintained_homes: List<String>
    }

type HandMaintainedOutcome
  = HandMatches { filename: String }
  | HandDrifted { filename: String }
  | HandNoCandidate { filename: String }
  | HandUnverifiable { filename: String, reason: String }

// THREE STATES, THREE REFUSALS, THREE REMEDIES — this was ONE refusal over their union.
// `GeneratedDrift` collected SurfaceDrifted, EmittedNotCommitted AND CommittedNotEmitted into a
// single variant carrying a single path list, and `SurfacePopulationMismatch` sat beside it
// UNUSED — the split carrier existed and nothing produced it. So a module being introduced was
// indistinguishable from the emitter having LOST a surface, which are opposite events with
// opposite remedies: install the produced mirror in the first case, delete the stale committed
// mirror (or restore the authority that stopped emitting it) in the second. That is the
// state-space conflation DESIGN names by that name, and it is what made a first landing read as
// a regression. The fused variant is DELETED rather than left beside its replacement, because a
// conflated carrier retained next to the split one is two answers to one question.
//
// SPLITTING THE REFUSAL IS NOT ADMITTING EITHER HALF, AND THE DISTINCTION IS LOAD-BEARING.
// `MirrorMissingForEmittedSurface` still REFUSES. The tempting next step — admit it, since a new
// module obviously has no mirror yet — replaces this conflation with its mirror image, and the
// replacement is worse: "an author introduced a module" and "the emitter invented a surface
// nobody authored" have the SAME population signature, and the second is the state this check
// exists to catch (constraint measured and argued by quick-lynx-620, routed via smart-ram-730,
// 2026-08-20). The populations cannot tell them apart, so no arm computed from the populations
// may try; a discriminator has to come from something AUTHORED, and none is modeled today.
// This variant therefore names the fork and hands it to the author rather than resolving it:
// install the produced mirror if you introduced the module, investigate if you did not. What
// the repair before it buys is that the first branch is now ACTIONABLE — the bytes exist on
// disk instead of only inside the process refusing — and the second branch stays refused, which
// is the arm that matters.
// A FOURTH POPULATION STATE, SPLIT OUT OF THE THIRD FOR THE SAME REASON THE THIRD WAS SPLIT OUT
// OF THE SECOND -- and this one is about the REMEDY, not the diagnosis.
// `MirrorMissingForEmittedSurface` offers exactly two moves: install the produced mirror, or
// investigate an emitter that invented a surface. Both are correct for a genuine orphan and both
// DAMAGE hand-authored source. The compared populations key on BASENAME, and the committed side
// enumerates only the top level of the stage0 crate, so an emitted basename that collides with a
// file living inside a hand-maintained DIRECTORY (`HAND_MAINTAINED_STAGE0_DIRS`) lands in the
// emitted-not-committed set with those two remedies attached: installing overwrites hand-authored
// code with generated bytes, deleting destroys it. The only non-damaging response left to an
// author who reads the refusal and believes it is to ignore the wall -- which is how a correct
// wall decays into advice, fastest for the authors who take it most seriously.
//
// SO THE COLLISION REFUSES UNDER ITS OWN NAME AND ITS OWN REMEDY (de-collide the module name),
// AND IT IS NOT SILENCED. Excluding the colliding path from the compared population instead --
// by teaching the hand-maintained predicate about the directory list -- would drop a genuinely
// generated surface out of the comparison entirely, which is the false green this split exists
// to avoid: a wrong refusal replaced by no refusal.
//
// ZERO EXPOSURE TODAY, AND THE REASON IS WORTH RECORDING because it is what bounds this variant.
// Emitted Rust filenames are FLAT by construction (`v1.compiler.emit_core_support`
// `module_to_filename` is split(".") |> join("_") under `rust_source_root()`), so the emitter can
// never write INTO a hand-maintained directory; the collision is reachable only through a module
// authored with a bare name equal to one of those directories' files. Measured 2026-08-22: zero
// such collisions in the corpus, and required-regen green on main at 90986d19469
// (first_generation_equal=true planned=132 executed=132). The variant is a wall for a state one
// .dag file away, not a repair of an observed failure.
// FORMATTER UNAVAILABILITY IS A REGEN REFUSAL, NOT A HOST ACCIDENT. Every comparison this
// operation makes is between rustfmt fixed points -- the emitted tree is stored as one so that
// `cargo fmt --all --check` and the drift gate cannot demand different passes of one artifact --
// so a run without a usable formatter has nothing to compare and must refuse. It is modeled here
// rather than left to the host because the host is a MIRROR of this carrier (DESIGN.md records
// `run_required_regen`'s hand-written ordering at *mitigatable*, with derivation from this
// carrier as its next-rung trigger); a refusal the host can produce and this type cannot name is
// exactly the divergence that trigger exists to close, and it would grow the seed's semantics
// while the freeze holds it closed to growth.
//
// `reason` carries the located cause -- which program was resolved, what PATH was searched, and
// whether it was absent, non-executable or unrunnable -- because those four have different
// remedies and a bare "no formatter" would conflate them.
type RequiredRegenRefusal
  = GeneratedDrift { paths: List<String> }
  | MirrorMissingForEmittedSurface { paths: List<String> }
  | MirrorMissingShadowsHandMaintainedSource { entries: List<String> }
  | CommittedMirrorNoLongerEmitted { paths: List<String> }
  | CompileRefused { reason: String }
  | HandUnverifiableRefused { entries: List<String> }
  | PlannedExecutedMismatch { planned: Int, executed: Int }
  | EmptyCommittedPopulation
  | EmptyEmitResult
  | CandidateTreeAbsent { reason: String }
  | FormatterUnavailable { reason: String }
  | AffectedSetUnlocatable { paths: List<String>, reason: String }

// The emitter's product, named by where the author finds it. `produced_paths` are the
// generated surfaces actually written under `root`, which is the population a first
// mirror is drawn from — including the surface the committed tree does not yet have.
//
// `produced_paths` IS NOT THE DIRECTORY LISTING, AND CONFLATING THEM MAKES THE RECEIPT
// COMPARE A FILE TO ITSELF. The host populates the candidate directory twice over: it
// writes the emitted surfaces, and it then COPIES the hand-maintained support files in
// beside them, because the tree has to be a usable crate and not just a diff. So the
// directory holds strictly more than was emitted — measured 2026-08-22 on the merge at
// 69f62c897e6: 168 `.rs` files present, `planned=132 executed=132` compared.
//
// The consequence is a reading trap in the receipt, not a defect in it. A reader who
// wants to know whether some particular mirror is a true regen of its authority — the
// exact question after any auto-merge that touched a `.dag` and its mirror together —
// reaches for one of three facts, and ALL THREE ARE VACUOUS FOR A COPIED FILE. `planned`
// equals `executed` answers "did every planned file run", never "was the file I care
// about planned": a count cannot carry an identity join. Presence in the candidate
// directory is satisfied by the copy. And byte-equality against the committed tree is
// satisfied BY THE COPY HAVING COME FROM THERE — the file is compared to itself. The
// `// Generated by v1 compiler` header is one notch weaker still: a claim the file makes
// about itself, an inspection rather than a measurement.
//
// THE DISCRIMINATOR IS A PLANTED PERTURBATION, and it is the only one of these that goes
// red when the property fails: change one byte in the mirror under suspicion and re-run.
// A file inside the compared set is named in `changed_paths` and flips
// `first_generation_equal` to false; a file outside it passes unnoticed, which is the
// whole finding. Receipt for the shape, 2026-08-22: a one-line comment planted in
// `v1_compiler_infer.rs` and `v1_compiler_compile.rs` produced
// `FAIL generated surface drift: v1_compiler_compile.rs, v1_compiler_infer.rs` and
// `changed_paths ['v1_compiler_compile.rs', 'v1_compiler_infer.rs']`, establishing both
// as emitted rather than copied. Revert the perturbation; it is an instrument, not a fixture.
type CandidateTree {
  root: String
  produced_paths: List<String>
}

type CandidateTreeProduction
  = CandidateTreeProduced { tree: CandidateTree }
  | CandidateTreeUnproduced { cause: RequiredRegenRefusal }

type RequiredRegenRunOutcome
  = RegenUnproduced { cause: RequiredRegenRefusal }
  | RegenProducedRefused { tree: CandidateTree, refusals: List<RequiredRegenRefusal> }
  | RegenProducedRunnable { tree: CandidateTree, attempt: RequiredRegenAttempt }

type RequiredRegenAttempt {
  generated_outcomes: List<RegenSurfaceOutcome>
  hand_outcomes: List<HandMaintainedOutcome>
  authority_digest: String
}

type RequiredRegenSyncAdmission
  = RequiredRegenSyncRunnable { attempt: RequiredRegenAttempt }
  | RequiredRegenSyncRefused { refusals: List<RequiredRegenRefusal> }

data no_regen_refusals: List<RequiredRegenRefusal> = []

data no_string_paths: List<String> = []

// One fold per state. Each keeps ONLY its own outcome, so a path can never appear under a
// remedy that does not apply to it.
fn collect_byte_drift_paths(
  acc: List<String>,
  o: RegenSurfaceOutcome
) -> List<String> {
  match o {
    SurfaceDrifted { relative_path: path } => Cons { head: path, tail: acc }
    EmittedNotCommitted { relative_path: _ } => acc
    CommittedNotEmitted { relative_path: _ } => acc
    EmittedNotCommittedShadowsHandMaintained { relative_path: _, hand_maintained_homes: _ } => acc
    SurfaceMatches { relative_path: _ } => acc
  }
}

fn collect_emitted_not_committed_paths(
  acc: List<String>,
  o: RegenSurfaceOutcome
) -> List<String> {
  match o {
    SurfaceDrifted { relative_path: _ } => acc
    EmittedNotCommitted { relative_path: path } => Cons { head: path, tail: acc }
    CommittedNotEmitted { relative_path: _ } => acc
    EmittedNotCommittedShadowsHandMaintained { relative_path: _, hand_maintained_homes: _ } => acc
    SurfaceMatches { relative_path: _ } => acc
  }
}

fn collect_committed_not_emitted_paths(
  acc: List<String>,
  o: RegenSurfaceOutcome
) -> List<String> {
  match o {
    SurfaceDrifted { relative_path: _ } => acc
    EmittedNotCommitted { relative_path: _ } => acc
    CommittedNotEmitted { relative_path: path } => Cons { head: path, tail: acc }
    EmittedNotCommittedShadowsHandMaintained { relative_path: _, hand_maintained_homes: _ } => acc
    SurfaceMatches { relative_path: _ } => acc
  }
}

fn hand_is_unverifiable(o: HandMaintainedOutcome) -> Bool {
  match o {
    HandUnverifiable { filename: _, reason: _ } => true
    HandMatches { filename: _ } => false
    HandDrifted { filename: _ } => false
    HandNoCandidate { filename: _ } => false
  }
}

// EVERY HOME, NOT THE LAST ONE SEEN. The homes are a LIST because one basename can be
// hand-authored under more than one hand-maintained directory — `mod.rs` is the obvious
// candidate, being the name most likely to appear in two module directories at once. A carrier
// holding a single home would make the extra ones unrepresentable, so the host's map would have
// resolved the collision by last-write-wins and the refusal would name ONE directory while
// silently dropping the others. That refusal still fires and still launders nothing, but it
// sends an author to the wrong file — which is the failure this whole variant exists to prevent,
// one notch quieter (finding: smart-ram-730 on #8867).
//
// The entry renders as "path (hand-maintained under A, B)" so the refusal names both halves of
// the collision: an author cannot act on the basename alone, because the whole point is that ONE
// basename addresses several different files.
fn render_homes(acc: String, home: String) -> String {
  if acc == "" {
    home
  } else {
    concat(acc, concat(", ", home))
  }
}

fn collect_shadowing_entries(
  acc: List<String>,
  o: RegenSurfaceOutcome
) -> List<String> {
  match o {
    SurfaceDrifted { relative_path: _ } => acc
    EmittedNotCommitted { relative_path: _ } => acc
    CommittedNotEmitted { relative_path: _ } => acc
    EmittedNotCommittedShadowsHandMaintained {
      relative_path: path,
      hand_maintained_homes: homes
    } => Cons {
      head: concat(
        path,
        concat(
          " (hand-maintained under ",
          concat(
            fold_list(xs: homes, empty: "", cons: fn(a, h) { render_homes(acc: a, home: h) }),
            ")"
          )
        )
      ),
      tail: acc
    }
    SurfaceMatches { relative_path: _ } => acc
  }
}

fn collect_hand_unverifiable(
  acc: List<String>,
  o: HandMaintainedOutcome
) -> List<String> {
  match o {
    HandUnverifiable { filename: name, reason: reason } =>
      Cons { head: concat(name, concat(": ", reason)), tail: acc }
    HandMatches { filename: _ } => acc
    HandDrifted { filename: _ } => acc
    HandNoCandidate { filename: _ } => acc
  }
}

// ALL THREE POPULATION STATES ARE REPORTED, not the first one found. They are independent states
// and an author hitting two at once needs to see both; returning early on the first was a second,
// quieter way of collapsing them.
// Hand-maintained DRIFT is expected on a clean tree (main.rs and known emitter gaps).
// Only UNVERIFIABLE hand rows refuse sync admission.
fn required_regen_sync_admission(
  generated_outcomes: List<RegenSurfaceOutcome>,
  hand_outcomes: List<HandMaintainedOutcome>,
  authority_digest: String,
  planned_surfaces: Int,
  executed_surfaces: Int
) -> RequiredRegenSyncAdmission {
  if planned_surfaces <= 0 {
    return RequiredRegenSyncRefused {
      refusals: Cons { head: EmptyCommittedPopulation, tail: no_regen_refusals }
    }
  }
  if executed_surfaces <= 0 {
    return RequiredRegenSyncRefused {
      refusals: Cons { head: EmptyEmitResult, tail: no_regen_refusals }
    }
  }
  if planned_surfaces != executed_surfaces {
    return RequiredRegenSyncRefused {
      refusals: Cons {
        head: PlannedExecutedMismatch {
          planned: planned_surfaces,
          executed: executed_surfaces
        },
        tail: no_regen_refusals
      }
    }
  }
  let byte_drift_paths = fold_list(
    xs: generated_outcomes,
    empty: no_string_paths,
    cons: fn(acc, o) { collect_byte_drift_paths(acc: acc, o: o) }
  )
  let missing_mirror_paths = fold_list(
    xs: generated_outcomes,
    empty: no_string_paths,
    cons: fn(acc, o) { collect_emitted_not_committed_paths(acc: acc, o: o) }
  )
  let shadowing_entries = fold_list(
    xs: generated_outcomes,
    empty: no_string_paths,
    cons: fn(acc, o) { collect_shadowing_entries(acc: acc, o: o) }
  )
  let unemitted_mirror_paths = fold_list(
    xs: generated_outcomes,
    empty: no_string_paths,
    cons: fn(acc, o) { collect_committed_not_emitted_paths(acc: acc, o: o) }
  )
  let population_refusals = list_append(
    left: list_append(
      left: if length(xs: byte_drift_paths) > 0 {
        [GeneratedDrift { paths: byte_drift_paths }]
      } else {
        no_regen_refusals
      },
      right: if length(xs: missing_mirror_paths) > 0 {
        [MirrorMissingForEmittedSurface { paths: missing_mirror_paths }]
      } else {
        no_regen_refusals
      }
    ),
    right: list_append(
      left: if length(xs: unemitted_mirror_paths) > 0 {
        [CommittedMirrorNoLongerEmitted { paths: unemitted_mirror_paths }]
      } else {
        no_regen_refusals
      },
      right: if length(xs: shadowing_entries) > 0 {
        [MirrorMissingShadowsHandMaintainedSource { entries: shadowing_entries }]
      } else {
        no_regen_refusals
      }
    )
  )
  if length(xs: population_refusals) > 0 {
    return RequiredRegenSyncRefused { refusals: population_refusals }
  }
  let hand_bad = fold_list(
    xs: hand_outcomes,
    empty: no_string_paths,
    cons: fn(acc, o) {
      if hand_is_unverifiable(o: o) {
        collect_hand_unverifiable(acc: acc, o: o)
      } else {
        acc
      }
    }
  )
  if length(xs: hand_bad) > 0 {
    return RequiredRegenSyncRefused {
      refusals: Cons {
        head: HandUnverifiableRefused { entries: hand_bad },
        tail: no_regen_refusals
      }
    }
  }
  RequiredRegenSyncRunnable {
    attempt: RequiredRegenAttempt {
      generated_outcomes: generated_outcomes,
      hand_outcomes: hand_outcomes,
      authority_digest: authority_digest
    }
  }
}


// ---------------------------------------------------------------------------------------------
// THE AFFECTED-SET BOUND, CONSUMED: WHICH MIRRORS' BYTES THIS ROUND ADJUDICATES.
//
// Every lane pays a whole-corpus regen per edit, and gunbc.regen_affected_set already answers
// which committed mirrors ONE edit can change -- as a BOUND, a structural over-approximation
// computed as the answer, never an exact set. This carrier is where that answer becomes a
// selection the run acts on, so the bound stops being a report and starts being consumed.
//
// THE SPLIT THAT MAKES THE SELECTION SAFE, and it is the whole design: a round asks two
// different questions of the compared population, and only ONE of them may be scoped.
//
//   * POPULATION IDENTITY -- which mirrors EXIST on each side. EmittedNotCommitted,
//     CommittedNotEmitted and the hand-maintained shadow are identity joins over rosters; they
//     read no bytes, normalize nothing, and cost nothing worth saving. They stay WHOLE
//     POPULATION under every scope. Scoping them would make a newly emitted surface invisible
//     exactly when the author is introducing it, which is the state MirrorMissingForEmittedSurface
//     exists to name.
//   * BYTE ADJUDICATION -- whether each committed mirror equals what emit produced for it. This
//     is the expensive half (a read, a rustfmt normalization and a comparison per member), and it
//     is what the bound scopes.
//
// So the scope bounds which mirrors' BYTES are compared. It never bounds which mirrors exist.
//
// WHY A SCOPED ROUND STILL CONVERGES, stated because the bound over-approximates and a reader is
// owed the argument rather than the assurance. Convergence means: the compiler rebuilt from the
// installed mirrors regenerates the selected mirrors with an empty diff. That is sufficient for
// the WHOLE tree under two facts and one PRECONDITION, all three of which are separately
// checkable and none of which this carrier assumes silently.
//
//   1. The bound never under-emits. Every module whose emitted bytes can change under this edit
//      is in the reverse closure, plus the declared bootstrap products. Over-emission is free
//      (a member that did not drift simply matches); under-emission is the only unsound
//      direction, and the planted-edit control -- an affected-scoped round's resulting tree
//      compared BYTE FOR BYTE, at identity grain over every committed mirror, against a
//      whole-population round's -- is what puts that claim on the executed path rather than in
//      this comment.
//   2. A mirror outside the selection is therefore emitted with exactly the bytes it already
//      carries, so not rewriting it leaves the tree in the state a whole-population round would
//      have left it in -- and leaves its mtime alone, which is what keeps cargo's fingerprint
//      from recompiling a crate nothing changed.
//   3. THE PRECONDITION: the tree the round starts from was already a fixed point for this seed.
//      A scoped round cannot discover that a mirror OUTSIDE the selection was committed stale --
//      hand-edited, or landed by a merge that took one side -- because it never compares that
//      mirror's bytes. This is not a widening and not a silent one: the unscoped adjudication is
//      what the required CI phase runs, on every push and every pull request, over the whole
//      population, and it is the thing that establishes the precondition for the next author's
//      scoped round. A scope is therefore an author-round selection over a gate-verified tree,
//      and the gate is never itself scoped.
//
// AND THE THIRD ARM REFUSES. When the edited set cannot be located as modules the bound answers
// EditedSetUnlocatable, and the round REFUSES under AffectedSetUnlocatable rather than falling
// back to the whole population. "Regenerate everything" and "the selection could not answer" are
// different states; collapsing them would erase the only signal the locator has a deficit, which
// is the absorbing fallback DESIGN section 5 names by that name -- and it would do it in the one
// place whose failure arm is denominated in the corpus rather than the change.
// ---------------------------------------------------------------------------------------------
type RegenEmissionScope
  = WholePopulationScope
  | AffectedScope { members: List<String> }
  | ScopeUnlocatable { paths: List<String>, reason: String }

// The selection, or the refusal that replaces it. There is no arm carrying both, and no arm
// carrying neither: a caller cannot reach a compared population without the scope having answered.
type RegenScopeSelection
  = ScopeSelected { selected: List<String> }
  | ScopeSelectionRefused { cause: RequiredRegenRefusal }

fn regen_scope_lists(members: List<String>, member: String) -> Bool {
  fold_list(xs: members, empty: false, cons: fn(acc, m) { if acc { true } else { m == member } })
}

// AN AFFECTED SCOPE SELECTS BY INTERSECTION WITH THE COMMITTED POPULATION, not by taking the
// bound's list as the population. The bound names mirrors it derived from the module graph and
// the declared bootstrap edges; the committed population is what is on disk. Taking the bound
// verbatim would let a member the tree does not carry enter the compared set, where it reads as
// a missing file rather than as what it is -- a selection naming something outside the tree.
// A SELECTION IS A FILTER, and saying so is what keeps the answer a List.
//
// The affected arm was twice written as list CONSTRUCTION and twice wrong. `Cons` inside an `if`
// did not resolve at all -- the taken branch is a coproduct and the untaken one is the
// `List<String>` the accumulator carried. `list_append` then resolved, type-checked, and `length`
// read it, and still handed the host a `Cons` chain where a flat list was expected ("Variant
// where a List was expected"). Both were one mistake: building a list where the question is which
// members of an EXISTING list survive a predicate.
fn regen_scope_select(scope: RegenEmissionScope, committed: List<String>) -> RegenScopeSelection {
  match scope {
    WholePopulationScope => ScopeSelected { selected: committed }
    ScopeUnlocatable { paths: paths, reason: reason } =>
      ScopeSelectionRefused {
        cause: AffectedSetUnlocatable { paths: paths, reason: reason }
      }
    AffectedScope { members: members } =>
      ScopeSelected {
        selected: filter(
          xs: committed,
          predicate: fn(name) { regen_scope_lists(members: members, member: name) }
        )
      }
  }
}

// AN EMPTY SELECTION IS NOT A REFUSAL AND NOT A DEFECT. An edit that touches no module in the
// compared population -- a .dag under no mirror, a docs-only round -- selects nothing, and the
// honest round for it adjudicates nothing and installs nothing. The whole-population arm cannot
// reach this state (an empty committed population is EmptyCommittedPopulation, a different
// refusal about a different subject), so the count below is the scope's own answer and is
// reported rather than defended.
fn regen_scope_line(scope: RegenEmissionScope) -> String {
  match scope {
    WholePopulationScope => "regen-scope: WholePopulationScope"
    AffectedScope { members: members } =>
      concat("regen-scope: AffectedScope members=", to_string(length(xs: members)))
    ScopeUnlocatable { paths: paths, reason: reason } =>
      concat(
        concat("regen-scope: ScopeUnlocatable paths=", to_string(length(xs: paths))),
        concat(" reason=", reason)
      )
  }
}

// The selection as the host reads it back, in the same two-call shape
// `gunbc.regen_affected_set` already uses: one line for the arm and its count, one list for the
// members. The host runs BOTH on every scoped round and holds its own selection to this answer,
// so this fold is a live consumer rather than a spelling of one.
fn regen_scope_selection_line(sel: RegenScopeSelection) -> String {
  match sel {
    ScopeSelected { selected: selected } =>
      concat("regen-scope-selection: ScopeSelected selected=", to_string(length(xs: selected)))
    ScopeSelectionRefused { cause: cause } => "regen-scope-selection: ScopeSelectionRefused"
  }
}

fn regen_scope_selection_members(sel: RegenScopeSelection) -> List<String> {
  match sel {
    ScopeSelected { selected: selected } => selected
    ScopeSelectionRefused { cause: cause } => no_string_paths
  }
}

// The whole run, in the order the two questions are actually answerable: the emitter
// produces, then the comparison judges what was produced. A caller cannot reach a
// verdict arm without supplying the tree, so the stranding above is unwritable here
// rather than caught by a check downstream of it (DESIGN §5 construction over
// validation). The host realization in `v1_compiler.required_regen_host`
// `run_required_regen` mirrors this ordering; that mirroring is hand-maintained, so the
// wall stands at *structurally guaranteed* in this carrier and at *mitigatable* in the
// host until the host is derived from it.
fn required_regen_run(
  production: CandidateTreeProduction,
  generated_outcomes: List<RegenSurfaceOutcome>,
  hand_outcomes: List<HandMaintainedOutcome>,
  authority_digest: String,
  planned_surfaces: Int,
  executed_surfaces: Int
) -> RequiredRegenRunOutcome {
  match production {
    CandidateTreeUnproduced { cause: cause } => RegenUnproduced { cause: cause }
    CandidateTreeProduced { tree: tree } =>
      match required_regen_sync_admission(
        generated_outcomes: generated_outcomes,
        hand_outcomes: hand_outcomes,
        authority_digest: authority_digest,
        planned_surfaces: planned_surfaces,
        executed_surfaces: executed_surfaces
      ) {
        RequiredRegenSyncRefused { refusals: refusals } =>
          RegenProducedRefused { tree: tree, refusals: refusals }
        RequiredRegenSyncRunnable { attempt: attempt } =>
          RegenProducedRunnable { tree: tree, attempt: attempt }
      }
  }
}
