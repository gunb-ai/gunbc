module v2.workflow.ci_nested_match_6777_reproducer_emit

import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.types { List }
import v2.std.effect_plan { Do, EffectPlan }
import v2.std.operation_argv {
  OperationRef,
  operation_argv_bind_text_list
}
import v2.std.orchestration { FailFast }
import v2.std.text { String }
import v2.workflow.effect_plan_bash_materialize {
  BashBoundOperationInvocation,
  EffectPlanBashMaterializationRefused,
  EffectPlanBashMaterialized,
  bash_bind_operation_invocation_host_env_executable,
  effect_plan_bash_materialize,
  effect_plan_bash_refusal_label
}

data ci_nested_match_6777_reproducer_extra_args: List<String> = [
  "-p",
  "v1-compiler-tests",
  "--release",
  "nested_match_6777_emitted_matches_interpreted"
]

data ci_nested_match_6777_reproducer_cargo_path: String = "dag/extdeps/rust/cargo_build.dag"
data ci_nested_match_6777_reproducer_cargo_service: String = "cargo.Build"
data ci_nested_match_6777_reproducer_cargo_operation: String = "Test"
data ci_nested_match_6777_reproducer_cargo_bin_env_var: String = "CARGO_BIN"

data ci_nested_match_6777_reproducer_refusal_prefix: String = "__GUNBC_EFFECT_PLAN_BASH_REFUSED__ nested_match_6777 reproducer: "

data ci_nested_match_6777_reproducer_authority_note: String = "Build-job focused execution receipt for #7982 implementing gunbc.roadmap_authority unreachable_patterns_construction_residue_note: ONE named cargo test (nested_match_6777_emitted_matches_interpreted) after the v1-compiler-tests compile-contract gate (--no-run). Exercises the emitted/native classify_length four-case control (0->Zero, 1->One, 2/3->Many). NOT a RustMonolithGate or nextest re-enrollment — gunbc.commit_workflow commit_gate_rust_suite_removed_disposition remains terminal; this is a single named test with an execution receipt, not suite restoration."

data ci_nested_match_6777_reproducer_shell_emit_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "v2.workflow.ci_nested_match_6777_reproducer_emit",
    decl_name: "ci_nested_match_6777_reproducer_script",
    field: WholeDeclaration
  }
}

data ci_nested_match_6777_reproducer_shell_emit_dissolution_trigger: String = "🟡 dissolve-on: ci_nested_match_6777_reproducer_script — foreign-executor shell transport for one cargo.Build.Test filter; DISSOLVES WHEN bash-emit binds the build-job step to orchestration emit over the typed cargo operation (same seam as ci_v1_compiler_tests_compile_gate_emit)"

data ci_nested_match_6777_reproducer_receipt_prefix: String = "[nested-match-6777-reproducer-receipt]"

fn ci_nested_match_6777_reproducer_check_step() -> BashBoundOperationInvocation {
  bash_bind_operation_invocation_host_env_executable(
    at: OperationRef {
      path: ci_nested_match_6777_reproducer_cargo_path,
      service: ci_nested_match_6777_reproducer_cargo_service,
      operation: ci_nested_match_6777_reproducer_cargo_operation
    },
    bindings: [
      operation_argv_bind_text_list(
        name: "extra_args",
        items: ci_nested_match_6777_reproducer_extra_args
      )
    ],
    env_var: ci_nested_match_6777_reproducer_cargo_bin_env_var
  )
}

fn ci_nested_match_6777_reproducer_intent() -> EffectPlan<BashBoundOperationInvocation> {
  EffectPlan {
    steps: [Do { effect: ci_nested_match_6777_reproducer_check_step() }],
    on_failure: FailFast
  }
}

fn ci_nested_match_6777_reproducer_render(
  plan: EffectPlan<BashBoundOperationInvocation>
) -> String {
  match effect_plan_bash_materialize(plan: plan) {
    EffectPlanBashMaterialized { source: source } => source
    EffectPlanBashMaterializationRefused { refusal: refusal } =>
      concat(
        ci_nested_match_6777_reproducer_refusal_prefix,
        effect_plan_bash_refusal_label(refusal: refusal)
      )
  }
}

fn ci_nested_match_6777_reproducer_receipt_line() -> String {
  concat(
    "echo \"",
    concat(
      ci_nested_match_6777_reproducer_receipt_prefix,
      concat(
        " repository=$\{GITHUB_REPOSITORY:-local} head=$\{GITHUB_SHA:-unknown}",
        concat(
          " test=nested_match_6777_emitted_matches_interpreted",
          concat(
            " execution_class=native_release_test",
            concat(
              " members=0:Zero,1:One,2:Many,3:Many",
              " outcome=passed\""
            )
          )
        )
      )
    )
  )
}

fn ci_nested_match_6777_reproducer_script() -> String {
  concat(
    concat("# ", concat(ci_nested_match_6777_reproducer_shell_emit_dissolution_trigger, "\n")),
    concat(
      concat(ci_nested_match_6777_reproducer_render(plan: ci_nested_match_6777_reproducer_intent()), "\n"),
      concat(ci_nested_match_6777_reproducer_receipt_line(), "\n")
    )
  )
}
