module v2.workflow.native_probe_plan

import v2.workflow.ci_floor_plan { gunbc_pr_native_batch }
import v2.std.optional { Absent }
import std.realization_schedule { WalkPlan, NoPreWalkExecution, NoWalkFinalization, NoFinalizationDeclared }


fn native_probe_plan() -> WalkPlan<NoWalkFinalization> {
  WalkPlan {
    pre_walk_execution: NoPreWalkExecution {},
    batches: [[gunbc_pr_native_batch()]],
    finalization: NoFinalizationDeclared {},
    on_success_stages: [],
    ordinary_budget: Absent {},
    on_success_budget: Absent {},
  }
}
