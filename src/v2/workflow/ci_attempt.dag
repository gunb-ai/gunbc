module v2.workflow.ci_attempt

import std.measure { ByteSize, Millisecond, byte_size }
import v2.std.algebra { contains, fold_list, length, list_snoc_item }
import v2.std.collection { List }
import v2.std.dependency { BarrierBefore, DependencyView, ResourceDependsOn }
import v2.std.logic { Bool }
import std.computation_identity { ComputationIdentity, identity_permits_share }
import v2.std.node { combine_hash, Hash, Node, Symbol, symbol_identity_digest }
import v2.std.text { String }
import v2.workflow.executor {
  ExecutorBatch,
  ExecutorRunBlocked,
  ExecutorRunComplete,
  ExecutorRunPlan,
  ExecutorRunRunnable,
  parallel_executor_plan_from_dependencies
}
import v2.workflow.floor2_prepared_subject {
  ExcludedDeliberatelyInvalidFixture,
  ExcludedOutsideDeclaredSourceRoots,
  SubjectExclusionGround
}

// THE CI ATTEMPT AS ONE PLAN.
//
// The floor's policy — which work exists, what depends on what, what may co-reside,
// what each node's terminal standing is, and what the attempt's verdict is — are
// facts of this module. The host realizes an exact request and returns a receipt; it
// decides nothing.
//
// This module deliberately does NOT define a scheduler. The ready frontier and the
// batches come from v2.workflow.executor over v2.std.dependency edges, which is the
// same authority module resolution uses. A second scheduler here would be the §3
// fork: one concept, two implementations, reconciled by hope.

// ── The exact request envelope ────────────────────────────────────────────────
//
// SUBSTRING SURFACES ARE GONE FROM THE SUBJECT. A source root and an exclusion are
// exact identities, because path text is not the property being selected: the
// borrowed roster proved it by removing lens/testgen.dag and workflow/
// testclaim_corpus_runner.dag while leaving the modules that import them, which
// reported present code as absent. An identity cannot straddle a dependency the way
// a substring can.
type SourceRootId
  = SourceRootDag
  | SourceRootV2
  | SourceRootV1

// An exclusion carries its GROUND, so "why is this out of the subject" has one
// answer that travels with the row rather than living in a comment beside it. The
// two grounds are different facts: a deliberately-invalid fixture's refusal IS the
// property its consumer reads, while an out-of-roots module is present in the
// repository and absent from this subject. Collapsing them would let a file that
// merely fails to resolve wear the same badge as one that is supposed to.
type SubjectExclusion {
  subject: Symbol
  ground: SubjectExclusionGround
}

// THE ENVELOPE IS WHAT THE SUBJECT IS, not just its source bytes. The earlier
// preparation primitive built an evaluable context from sources alone, so any claim
// depending on a fixture store or a published mock set could not earn outcome parity
// against the entry-major path that supplies both — the run would differ for a reason
// the digest could not express.
type FixtureStoreIdentity
  = FixtureStoreAbsent
  | FixtureStoreAt { identity: Symbol }

type PublishedMockSetIdentity
  = PublishedMockSetEmpty
  | PublishedMockSetOf { identity: Symbol }

type ToolIdentity {
  compiler: Symbol
}

type ConfigurationIdentity {
  identity: Symbol
}

// THE CONTENT IS PART OF THE SUBJECT, NOT CONTEXT AROUND IT.
//
// Every field below described how to READ the sources and none described WHAT the
// sources were, so one request evaluated against two different commits produced the
// same subject digest. That is not a coarse identity — it is the wrong one: a
// materialization keyed on it would share a result across a code change, and a
// parity comparison between two runs would report agreement it never established.
//
// Two coordinates, because they answer different questions and one does not imply
// the other. tree_identity names the repository state the attempt was requested
// against. source_manifest digests the exact file set actually admitted into the
// subject after exclusions, so a change to what the roots resolve to moves the
// digest even where the tree did not.
type CiAttemptRequest {
  tree_identity: TreeIdentity
  source_manifest: SourceManifestIdentity
  source_roots: List<SourceRootId>
  exclusions: List<SubjectExclusion>
  tool: ToolIdentity
  fixture_store: FixtureStoreIdentity
  published_mocks: PublishedMockSetIdentity
  configuration: ConfigurationIdentity
}

// TreeIdentity is deliberately NOT an optional field with an absent arm. A run that
// cannot name the tree it read has not produced a weaker subject identity, it has
// produced an unusable one, and an absent arm is where that distinction goes to die.
type TreeIdentity {
  commit: Symbol
}

type SourceManifestIdentity {
  digest: Hash
}

// ── The work ──────────────────────────────────────────────────────────────────

type CiNodeKind
  = FormatCheck
  | RetainedSeedTests
  | GeneratedArtifactVerify
  | PrepareExactSubject
  | CompileCleanStanding
  | EvaluateHermeticClaim { declaration: Symbol }
  | EvaluateWetClaim { declaration: Symbol }
  | ReduceRequiredVerdict
  | PublishAttemptReceipt

// A RESOURCE CLAIM IS A FACT ABOUT THE WORK, not a scheduling hint. Two nodes may
// co-reside exactly when no claim they both hold is exclusive; the scheduler then
// derives seriality from the claim rather than from a hand-written ordering, so a
// newly added conflicting node serializes without anyone remembering to order it.
// THE CLAIM NAMES WHAT IS OWNED, NOT MERELY THAT SOMETHING IS. An unparameterized
// CargoTargetWrite makes every build node conflict with every other build node, so a
// model meant to permit safe overlap forbids all of it; and an unparameterized
// LiveHostMutation says two nodes mutating unrelated hosts must serialize. Carrying
// the target means conflict is a question about the SAME resource, which is the only
// version of the question that is true.
//
// ResidentBytes is not exclusive and is not scheduled by conflict at all — it is the
// floor's historical limiting resource, and it binds through capacity rather than
// through an edge. Two nodes may both hold memory; what they may not do is exceed the
// envelope together. Modeling it as an ordinary conflicting claim would serialize
// everything that allocates, and omitting it entirely is how "parallel" comes to mean
// "launch enough legal nodes to recreate the cgroup kill".
type ResourceClaim
  = ReadOnlyRepository
  | CargoTargetWrite { target: Symbol }
  | PreparedContextAccess
  | LiveHostMutation { target: Symbol }
  | NetworkAccess
  | ResidentBytes { amount: ByteSize }

// PreparedContextAccess is EXCLUSIVE today, and the reason is measured rather than
// pending. The evaluator holds Rc/RefCell state and a thread-local active context, so
// witness nodes cannot share it across threads; the Rc-to-Arc alias flip that would
// change this was BUILT, MEASURED AND REJECTED — +5.84% serial wall on every
// interpreted path for zero benefit, because production is latched at width 1 and a
// wider run without a shared index measured 47min-plus unfinished or OOM against
// 11.75min green serial. The authority is docs/plans/arc-store-path-migration-decision.md
// and the named un-latch trigger is a shared index, which is what one exact prepared
// subject is. So the ordering is shared subject, then re-measure the flip against it,
// then width — and modeling this as an exclusive claim rather than a hidden Rust loop
// means every witness keeps its own identity and receipt in the meantime, and the day
// the evaluator becomes shareable this is one row here rather than a new runner.
fn resource_claim_is_exclusive(claim: ResourceClaim) -> Bool {
  match claim {
    ReadOnlyRepository => false
    CargoTargetWrite { target: _ } => true
    PreparedContextAccess => true
    LiveHostMutation { target: _ } => true
    NetworkAccess => false
    ResidentBytes { amount: _ } => false
  }
}

// The memory a node claims, zero for every claim that is not a memory claim. Summed
// across a batch this is what capacity admission compares against the envelope.
fn resource_claim_resident(claim: ResourceClaim) -> ByteSize {
  match claim {
    ReadOnlyRepository => byte_size(count: 0)
    CargoTargetWrite { target: _ } => byte_size(count: 0)
    PreparedContextAccess => byte_size(count: 0)
    LiveHostMutation { target: _ } => byte_size(count: 0)
    NetworkAccess => byte_size(count: 0)
    ResidentBytes { amount: a } => a
  }
}

type CiNode {
  identity: Symbol
  kind: CiNodeKind
  claims: List<ResourceClaim>
}

// ── Identity: the digest covers the whole envelope ────────────────────────────

fn source_root_symbol(root: SourceRootId) -> Symbol {
  match root {
    SourceRootDag => ^ci_source_root_dag
    SourceRootV2 => ^ci_source_root_src_v2
    SourceRootV1 => ^ci_source_root_src_v1
  }
}

// The ground's OWN payload enters the digest too: two rows excluding one module as a
// deliberately-invalid fixture under different property witnesses are different
// subjects, and the same omission that lost the exclusion subject would lose this.
fn subject_exclusion_ground_symbol(ground: SubjectExclusionGround) -> Symbol {
  match ground {
    ExcludedDeliberatelyInvalidFixture { property_witness: w } => w
    ExcludedOutsideDeclaredSourceRoots { containing_root: r } => r
  }
}

fn fixture_store_symbol(store: FixtureStoreIdentity) -> Symbol {
  match store {
    FixtureStoreAbsent => ^ci_fixture_store_absent
    FixtureStoreAt { identity: id } => id
  }
}

fn published_mocks_symbol(mocks: PublishedMockSetIdentity) -> Symbol {
  match mocks {
    PublishedMockSetEmpty => ^ci_published_mock_set_empty
    PublishedMockSetOf { identity: id } => id
  }
}

fn combine_source_root(acc: Hash, root: SourceRootId) -> Hash {
  combine_hash(a: acc, b: symbol_identity_digest(sym: source_root_symbol(root: root)))
}

// BOTH FIELDS ENTER THE DIGEST. An earlier revision folded only the ground, so two
// exclusions differing solely in WHICH module they exclude produced one digest — the
// envelope claim was overstated in exactly the field the envelope exists to cover, and
// the witness missed it by varying every other component and never varying two
// exclusions against each other. The subject is a Symbol rather than a path string for
// the same reason the roots are: an exact identity is hashable and a text surface is
// the thing this module removed from the subject.
fn combine_exclusion(acc: Hash, exclusion: SubjectExclusion) -> Hash {
  let with_subject = combine_hash(
    a: acc,
    b: symbol_identity_digest(sym: exclusion.subject)
  )
  combine_hash(
    a: with_subject,
    b: symbol_identity_digest(
      sym: subject_exclusion_ground_symbol(ground: exclusion.ground)
    )
  )
}

// THE DIGEST COVERS EVERY FIELD, and the witness beside this asserts it field by
// field rather than asserting that the function returns something. A digest over
// source bytes alone is the failure this whole envelope exists to prevent: two runs
// with different fixture stores would carry one identity, so a parity comparison
// between them would compare two different subjects and report agreement.
fn ci_attempt_subject_digest(request: CiAttemptRequest) -> Hash {
  let seeded = combine_hash(
    a: symbol_identity_digest(sym: ^ci_attempt_envelope_seed),
    b: symbol_identity_digest(sym: request.tree_identity.commit)
  )
  let with_manifest = combine_hash(a: seeded, b: request.source_manifest.digest)
  let roots = fold_list(
    xs: request.source_roots,
    empty: with_manifest,
    cons: combine_source_root
  )
  let with_exclusions = fold_list(
    xs: request.exclusions,
    empty: roots,
    cons: combine_exclusion
  )
  let with_tool = combine_hash(
    a: with_exclusions,
    b: symbol_identity_digest(sym: request.tool.compiler)
  )
  let with_fixtures = combine_hash(
    a: with_tool,
    b: symbol_identity_digest(sym: fixture_store_symbol(store: request.fixture_store))
  )
  let with_mocks = combine_hash(
    a: with_fixtures,
    b: symbol_identity_digest(sym: published_mocks_symbol(mocks: request.published_mocks))
  )
  combine_hash(
    a: with_mocks,
    b: symbol_identity_digest(sym: request.configuration.identity)
  )
}

// ── Projection into the substrate scheduler ───────────────────────────────────

fn ci_node_to_node(node: CiNode) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: node.identity } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn ci_nodes_to_nodes(nodes: List<CiNode>) -> List<Node> {
  fold_list(
    xs: nodes,
    empty: ci_no_nodes,
    cons: fn(acc, n) { list_snoc_item(xs: acc, item: ci_node_to_node(node: n)) }
  )
}

data ci_no_nodes: List<Node> = []

data ci_no_dependencies: List<DependencyView> = []

fn ci_dependency(source: CiNode, dependent: CiNode) -> DependencyView {
  let s = ci_node_to_node(node: source)
  DependencyView {
    source: s,
    dependent: ci_node_to_node(node: dependent),
    kind: BarrierBefore,
    usage_site: s
  }
}

// A RESOURCE CONFLICT BECOMES AN EDGE, which is what keeps the exclusivity honest.
// The alternative — letting the batch contain both and trusting the executor to be
// careful — proves nothing at plan time, and the ruling's own test is the right one:
// a conflicting pair must not appear in one batch, not merely be annotated as
// conflicting.
fn resource_claim_symbol(claim: ResourceClaim) -> Symbol {
  match claim {
    ReadOnlyRepository => ^ci_claim_read_only_repository
    CargoTargetWrite { target: _ } => ^ci_claim_cargo_target_write
    PreparedContextAccess => ^ci_claim_prepared_context_access
    LiveHostMutation { target: _ } => ^ci_claim_live_host_mutation
    NetworkAccess => ^ci_claim_network_access
    ResidentBytes { amount: _ } => ^ci_claim_resident_bytes
  }
}

// The target a claim owns, or a marker for the claims that name no target. Two claims
// are the same resource only when kind AND target agree, so writes to different cargo
// targets and mutations of different hosts do not conflict.
fn resource_claim_target(claim: ResourceClaim) -> Symbol {
  match claim {
    ReadOnlyRepository => ^ci_claim_target_none
    CargoTargetWrite { target: t } => t
    PreparedContextAccess => ^ci_claim_target_none
    LiveHostMutation { target: t } => t
    NetworkAccess => ^ci_claim_target_none
    ResidentBytes { amount: _ } => ^ci_claim_target_none
  }
}

fn resource_claim_eq(a: ResourceClaim, b: ResourceClaim) -> Bool {
  (resource_claim_symbol(claim: a) == resource_claim_symbol(claim: b))
    && (resource_claim_target(claim: a) == resource_claim_target(claim: b))
}

fn claims_conflict(left: CiNode, right: CiNode) -> Bool {
  fold_list(
    xs: left.claims,
    empty: false,
    cons: fn(acc, c) {
      acc
        || (resource_claim_is_exclusive(claim: c)
          && contains(xs: right.claims, item: c, eq: resource_claim_eq))
    }
  )
}

fn ci_plan_nodes(plan_nodes: List<CiNode>) -> List<Node> {
  ci_nodes_to_nodes(nodes: plan_nodes)
}

// EDGES ARE DERIVED FROM CLAIMS, NOT WRITTEN BY A CALLER. claims_conflict answered the
// question and then nothing acted on it: ci_batches took whatever dependency list it
// was handed, so serialization held only where someone remembered to author the edge —
// a validation the caller performs rather than a property of the plan. A node added
// tomorrow with an exclusive claim now serializes because the edge is computed here.
//
// Each pair is visited ONCE, in list order. Emitting both directions would make the
// graph cyclic, and the scheduler would then report the plan blocked rather than
// serialized — a different and far more confusing failure than the one being
// prevented.
data ci_no_ci_nodes: List<CiNode> = []

data ci_no_derived_edges: List<DependencyView> = []

type PairScan {
  seen: Bool
  later: List<CiNode>
}

fn nodes_after(nodes: List<CiNode>, after: Symbol) -> List<CiNode> {
  let scan = fold_list(
    xs: nodes,
    empty: PairScan { seen: false, later: ci_no_ci_nodes },
    cons: fn(acc, n) {
      if acc.seen {
        PairScan { seen: true, later: list_snoc_item(xs: acc.later, item: n) }
      } else {
        PairScan { seen: n.identity == after, later: acc.later }
      }
    }
  )
  scan.later
}

fn conflict_edges_for(
  acc: List<DependencyView>,
  left: CiNode,
  rest: List<CiNode>
) -> List<DependencyView> {
  fold_list(
    xs: rest,
    empty: acc,
    cons: fn(edges, right) {
      if claims_conflict(left: left, right: right) {
        list_snoc_item(xs: edges, item: ci_dependency(source: left, dependent: right))
      } else {
        edges
      }
    }
  )
}

fn derived_conflict_edges(plan_nodes: List<CiNode>) -> List<DependencyView> {
  fold_list(
    xs: plan_nodes,
    empty: ci_no_derived_edges,
    cons: fn(acc, left) {
      conflict_edges_for(
        acc: acc,
        left: left,
        rest: nodes_after(nodes: plan_nodes, after: left.identity)
      )
    }
  )
}

// A BLOCKED SCHEDULE IS NOT A SHORTER SCHEDULE.
//
// This function used to answer a blocked plan with the partial batches accumulated
// before the blockage and drop the evidence, so a cyclic or malformed plan became an
// executable schedule that ran a prefix of the work and reported nothing wrong. That
// is the widening failure arm exactly: the caller receives batches, cannot tell they
// are partial, and the nodes that could never be scheduled simply do not appear.
// Every consumer of a schedule needs to be unable to obtain batches from a blocked
// one, which is why the standing is the return type rather than a flag beside it.
type CiScheduleStanding
  = CiScheduleComplete { batches: List<ExecutorBatch> }
  | CiScheduleBlocked { evidence: List<Node>, unschedulable: List<Node> }

fn ci_schedule(
  plan_nodes: List<CiNode>,
  dependencies: List<DependencyView>
) -> CiScheduleStanding {
  match parallel_executor_plan_from_dependencies(
    nodes: ci_plan_nodes(plan_nodes: plan_nodes),
    dependencies: concat(dependencies, derived_conflict_edges(plan_nodes: plan_nodes)),
    scheduled: ci_no_nodes
  ) {
    ExecutorRunComplete { batches: bs, scheduled: _ } => CiScheduleComplete { batches: bs }
    ExecutorRunRunnable { batch: b, scheduled: _, remaining: _ } =>
      CiScheduleComplete { batches: [b] }
    ExecutorRunBlocked { evidence: ev, batches: _, scheduled: _, remaining: rem } =>
      CiScheduleBlocked { evidence: ev, unschedulable: rem }
  }
}

// ── Materialization: one computation per identity ─────────────────────────────
//
// THE GRADE COMES FROM std.computation_identity AND IS NOT RE-MINTED HERE. That
// module already owns what "identical computation" means — StructurallyIdentical,
// NormalizedIdentical, ExtensionallyIdentical, IdentityUnknown — and a second
// vocabulary for the same concept is the fork this repository keeps paying for. What
// is missing there is the STANDING: what happened when a node tried to materialize a
// key that already exists.
type ComputationKey {
  operation: Symbol
  inputs: Hash
  tool: Symbol
  configuration: Symbol
}

fn computation_key_digest(key: ComputationKey) -> Hash {
  let with_inputs = combine_hash(
    a: symbol_identity_digest(sym: key.operation),
    b: key.inputs
  )
  let with_tool = combine_hash(a: with_inputs, b: symbol_identity_digest(sym: key.tool))
  combine_hash(a: with_tool, b: symbol_identity_digest(sym: key.configuration))
}

// THERE IS NO ARM FOR "MATERIALIZED A SECOND TIME". That is the construction move:
// duplicate_recompute_without_share_count == 0 holds because the standing cannot
// express the state, not because a counter is checked afterwards. A second attempt at
// a live key either shares it or refuses, naming both occurrences so the refusal
// locates the authored duplication rather than reporting a total.
type MaterializationStanding
  = MaterializedOnce { key: Hash, producer: Symbol }
  | SharedFrom { key: Hash, producer: Symbol, consumer: Symbol }
  | RefusedDuplicateRecompute {
      key: Hash,
      first_occurrence: Symbol,
      duplicate_occurrence: Symbol,
      grade: ComputationIdentity
    }

type MaterializedKey {
  key: Hash
  producer: Symbol
}

data ci_no_materialized: List<MaterializedKey> = []

// A NAMED LOOKUP RESULT RATHER THAN Optional<Symbol>. The generic carrier forced the
// fold's accumulator type to be inferred at the call site, and this module has a
// specific question -- "does a live key already have a producer" -- whose answer
// deserves to say so.
type ProducerLookup
  = ProducerFound { producer: Symbol }
  | ProducerAbsent

fn producer_step(acc: ProducerLookup, m: MaterializedKey, key: Hash) -> ProducerLookup {
  match acc {
    ProducerFound { producer: p } => ProducerFound { producer: p }
    ProducerAbsent =>
      if m.key == key {
        ProducerFound { producer: m.producer }
      } else {
        ProducerAbsent
      }
  }
}

fn find_producer(live: List<MaterializedKey>, key: Hash) -> ProducerLookup {
  fold_list(
    xs: live,
    empty: ProducerAbsent,
    cons: fn(acc, m) { producer_step(acc: acc, m: m, key: key) }
  )
}

// A REPEAT WHOSE GRADE IS NOT KNOWN REFUSES RATHER THAN SHARING OR RECOMPUTING.
// IdentityUnknown is a typed debt, and std.computation_identity is explicit that it
// is never treated as identical NOR as distinct-by-default — so the arm that would
// quietly recompute it is exactly the absorbing fallback: it cannot be wrong, and it
// cannot be measured either.
fn admit_materialization(
  live: List<MaterializedKey>,
  occurrence: Symbol,
  key: ComputationKey,
  grade: ComputationIdentity
) -> MaterializationStanding {
  let digest = computation_key_digest(key: key)
  match find_producer(live: live, key: digest) {
    ProducerAbsent => MaterializedOnce { key: digest, producer: occurrence }
    ProducerFound { producer: first } =>
      if identity_permits_share(ci: grade) {
        SharedFrom { key: digest, producer: first, consumer: occurrence }
      } else {
        RefusedDuplicateRecompute {
          key: digest,
          first_occurrence: first,
          duplicate_occurrence: occurrence,
          grade: grade
        }
      }
  }
}

fn record_materialization(
  live: List<MaterializedKey>,
  standing: MaterializationStanding
) -> List<MaterializedKey> {
  match standing {
    MaterializedOnce { key: k, producer: p } =>
      list_snoc_item(xs: live, item: MaterializedKey { key: k, producer: p })
    SharedFrom { key: _, producer: _, consumer: _ } => live
    RefusedDuplicateRecompute {
      key: _,
      first_occurrence: _,
      duplicate_occurrence: _,
      grade: _
    } => live
  }
}

// ── Terminal standing: exactly one receipt per node ───────────────────────────

type CiNodeOutcome
  = NodePassed
  | NodeFailed
  | NodeRefused { cause: Symbol }

type CiNodeReceipt {
  node_identity: Symbol
  outcome: CiNodeOutcome
}

// RECONCILIATION IS AN IDENTITY JOIN, never a count comparison. Equal counts with a
// missing node and a surplus node is a real state, and a length check reports it as
// agreement — the same shape as a census that counts the subjects someone remembered
// to author.
type LedgerReconciliation
  = LedgerComplete
  | LedgerMissing { node_identity: Symbol }
  | LedgerSurplus { node_identity: Symbol }
  | LedgerDuplicate { node_identity: Symbol }

fn receipt_identities(receipts: List<CiNodeReceipt>) -> List<Symbol> {
  fold_list(
    xs: receipts,
    empty: ci_no_symbols,
    cons: fn(acc, r) { list_snoc_item(xs: acc, item: r.node_identity) }
  )
}

data ci_no_symbols: List<Symbol> = []

fn count_identity(ids: List<Symbol>, wanted: Symbol) -> Int {
  fold_list(
    xs: ids,
    empty: 0,
    cons: fn(acc, id) { if id == wanted { acc + 1 } else { acc } }
  )
}

fn reconcile_node(
  acc: LedgerReconciliation,
  node: CiNode,
  ids: List<Symbol>
) -> LedgerReconciliation {
  match acc {
    LedgerMissing { node_identity: m } => LedgerMissing { node_identity: m }
    LedgerSurplus { node_identity: s } => LedgerSurplus { node_identity: s }
    LedgerDuplicate { node_identity: d } => LedgerDuplicate { node_identity: d }
    LedgerComplete => {
      let n = count_identity(ids: ids, wanted: node.identity)
      if n == 0 {
        LedgerMissing { node_identity: node.identity }
      } else {
        if n > 1 {
          LedgerDuplicate { node_identity: node.identity }
        } else {
          LedgerComplete
        }
      }
    }
  }
}

fn surplus_receipt(
  acc: LedgerReconciliation,
  plan_nodes: List<CiNode>,
  receipt: CiNodeReceipt
) -> LedgerReconciliation {
  match acc {
    LedgerMissing { node_identity: m } => LedgerMissing { node_identity: m }
    LedgerSurplus { node_identity: s } => LedgerSurplus { node_identity: s }
    LedgerDuplicate { node_identity: d } => LedgerDuplicate { node_identity: d }
    LedgerComplete => {
      let planned = fold_list(
        xs: plan_nodes,
        empty: false,
        cons: fn(seen, n) { seen || (n.identity == receipt.node_identity) }
      )
      if planned {
        LedgerComplete
      } else {
        LedgerSurplus { node_identity: receipt.node_identity }
      }
    }
  }
}

fn reconcile_ledger(
  plan_nodes: List<CiNode>,
  receipts: List<CiNodeReceipt>
) -> LedgerReconciliation {
  let ids = receipt_identities(receipts: receipts)
  let planned_side = fold_list(
    xs: plan_nodes,
    empty: LedgerComplete,
    cons: fn(acc, n) { reconcile_node(acc: acc, node: n, ids: ids) }
  )
  fold_list(
    xs: receipts,
    empty: planned_side,
    cons: fn(acc, r) { surplus_receipt(acc: acc, plan_nodes: plan_nodes, receipt: r) }
  )
}

// ── The verdict ───────────────────────────────────────────────────────────────

// THE VERDICT IS DERIVED FROM THE LEDGER, never from stdout. An unreconciled ledger
// does not produce a verdict at all: it refuses, because "every planned node reported
// exactly once" is a precondition for the fold meaning anything. A run that lost a
// node's receipt and passed everything else is not a pass.
// A REFUSED NODE IS NOT A FAILED NODE. A failure is a checked property that did not
// hold; a refusal is a node that could not be judged at all, and folding the second
// into the first reports an unanswered question as an answer. They also route
// differently: a failure is a defect in the subject, a refusal is a defect in the
// attempt.
type CiAttemptVerdict
  = AttemptPassed
  | AttemptFailed { node_identity: Symbol }
  | AttemptNodeRefused { node_identity: Symbol, cause: Symbol }
  | AttemptRefused { reconciliation: LedgerReconciliation }

fn verdict_from_receipt(acc: CiAttemptVerdict, receipt: CiNodeReceipt) -> CiAttemptVerdict {
  match acc {
    AttemptFailed { node_identity: f } => AttemptFailed { node_identity: f }
    AttemptNodeRefused { node_identity: n, cause: c } =>
      AttemptNodeRefused { node_identity: n, cause: c }
    AttemptRefused { reconciliation: r } => AttemptRefused { reconciliation: r }
    AttemptPassed =>
      match receipt.outcome {
        NodePassed => AttemptPassed
        NodeFailed => AttemptFailed { node_identity: receipt.node_identity }
        NodeRefused { cause: c } =>
          AttemptNodeRefused { node_identity: receipt.node_identity, cause: c }
      }
  }
}

fn ci_attempt_verdict(
  plan_nodes: List<CiNode>,
  receipts: List<CiNodeReceipt>
) -> CiAttemptVerdict {
  match reconcile_ledger(plan_nodes: plan_nodes, receipts: receipts) {
    LedgerComplete =>
      fold_list(xs: receipts, empty: AttemptPassed, cons: verdict_from_receipt)
    LedgerMissing { node_identity: m } =>
      AttemptRefused { reconciliation: LedgerMissing { node_identity: m } }
    LedgerSurplus { node_identity: s } =>
      AttemptRefused { reconciliation: LedgerSurplus { node_identity: s } }
    LedgerDuplicate { node_identity: d } =>
      AttemptRefused { reconciliation: LedgerDuplicate { node_identity: d } }
  }
}

// ── The host primitive seam ───────────────────────────────────────────────────
//
// The plan emits an EXACT request; the host realizes it and returns receipts. The
// four primitives below are the entire seam, and none of them carries a floor mode, a
// witness directory, a special function name, or an exclusion path — those are facts
// of this module and the host must not be able to reach them.
//
// THE CAPABILITY IS A DIGEST, NOT A CONTEXT. EvaluatePreparedClaimRequest names the
// prepared subject by its envelope digest, so a claim request cannot carry a source
// root, an index, a resolver, or an entry path. That is the structural half of
// "zero per-entry graph resolves": the request has no field in which to ask for one.
// The counter, when the interpreter exposes it, is the regression control beneath.

// RESIDENT BYTES IS A CAPACITY COORDINATE, not a derived comfort. The floor's
// historical failure was never process count: it was aggregate residency against a
// cgroup, and a width that is legal by process_slots can be fatal by memory.
// THE MEMORY COORDINATE IS A MEASURE, not a bare count. `cpu_slots` and
// `process_slots` are cardinals -- a count of slots, dimensionless -- while a byte
// figure is a magnitude in a unit, and the two are not the same kind of Int. Grounding
// it on `std.measure` `ByteSize` is what stops a mebibyte figure and a byte figure
// inhabiting one field, which is the arithmetic that reads as a 1,048,576x capacity
// error and typechecks either way (DESIGN section 2 -- reuse the existing magnitude,
// never re-coin it).
type HostCapacity {
  cpu_slots: Int
  process_slots: Int
  resident: ByteSize
}

type HostPrimitiveRequest
  = PrepareExactSubjectRequest { envelope: Hash }
  | EvaluatePreparedClaimRequest { capability: Hash, declaration: Symbol, budget: Millisecond }
  | RealizeCiHostEffectRequest { effect: Symbol }
  | ExecuteExactBatchRequest { jobs: List<Symbol>, capacity: HostCapacity }

// THE HOST MAY NOT ADD WORK, DROP WORK, OR CHOOSE ITS OWN WIDTH, and each of those is
// a separate refusal rather than one "bad batch" arm, because they have different
// causes and different fixes: invented work means the host has a source of jobs the
// plan does not know about, dropped work means a receipt was lost or a job silently
// skipped, and an exceeded width means the host re-decided a scheduling question the
// plan already answered.
//
// Ordering is deliberately NOT a refusal. A batch is a set of jobs admitted to run
// together, so the order receipts come back in carries no information, and treating
// it as identity would make a correct concurrent executor look wrong.
type BatchExecutionAdmission
  = BatchExecuted { receipts: List<CiNodeReceipt> }
  | BatchRefusedInventedWork { node_identity: Symbol }
  | BatchRefusedDroppedWork { node_identity: Symbol }
  | BatchRefusedWidthExceeded { permitted: Int, observed: Int }

fn requested_contains(jobs: List<Symbol>, wanted: Symbol) -> Bool {
  fold_list(xs: jobs, empty: false, cons: fn(acc, j) { acc || (j == wanted) })
}

fn invented_work(jobs: List<Symbol>, receipts: List<CiNodeReceipt>) -> ProducerLookup {
  fold_list(
    xs: receipts,
    empty: ProducerAbsent,
    cons: fn(acc, r) {
      match acc {
        ProducerFound { producer: p } => ProducerFound { producer: p }
        ProducerAbsent =>
          if requested_contains(jobs: jobs, wanted: r.node_identity) {
            ProducerAbsent
          } else {
            ProducerFound { producer: r.node_identity }
          }
      }
    }
  )
}

fn dropped_work(jobs: List<Symbol>, receipts: List<CiNodeReceipt>) -> ProducerLookup {
  let ids = receipt_identities(receipts: receipts)
  fold_list(
    xs: jobs,
    empty: ProducerAbsent,
    cons: fn(acc, j) {
      match acc {
        ProducerFound { producer: p } => ProducerFound { producer: p }
        ProducerAbsent =>
          if requested_contains(jobs: ids, wanted: j) {
            ProducerAbsent
          } else {
            ProducerFound { producer: j }
          }
      }
    }
  )
}

fn admit_batch_execution(
  jobs: List<Symbol>,
  capacity: HostCapacity,
  receipts: List<CiNodeReceipt>,
  observed_width: Int
) -> BatchExecutionAdmission {
  if observed_width > capacity.process_slots {
    BatchRefusedWidthExceeded {
      permitted: capacity.process_slots,
      observed: observed_width
    }
  } else {
    match invented_work(jobs: jobs, receipts: receipts) {
      ProducerFound { producer: extra } => BatchRefusedInventedWork { node_identity: extra }
      ProducerAbsent =>
        match dropped_work(jobs: jobs, receipts: receipts) {
          ProducerFound { producer: missing } =>
            BatchRefusedDroppedWork { node_identity: missing }
          ProducerAbsent => BatchExecuted { receipts: receipts }
        }
    }
  }
}
