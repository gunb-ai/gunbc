module v2.workflow.build_step_transport_emit_test

import v2.workflow.shell_emit { emit_shell_program }
import tools.build_step_transport {
  corruption_probe_zero_byte_program,
  corruption_probe_nonempty_program,
  assign_tmpdir,
  assign_probe_bin,
  touch_and_chmod_probe
}
import extdeps.languages.bash.program { ShellProgram, ShellStmt, serialize_bash }
import v2.std.diagnostic { Accepted, None, Rejected }

fn program_emit_carried(p: ShellProgram) -> String {
  match emit_shell_program(p: p) {
    Accepted { value: src, diagnostics: _ } => src.carried
    Rejected { diagnostics: _ } => ""
  }
}

fn program_emit_equals_oracle(p: ShellProgram) -> Bool {
  match emit_shell_program(p: p) {
    Accepted { value: src, diagnostics: dg } =>
      (src.carried == serialize_bash(p: p)) && (dg == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn zero_byte_harness_emit_equals_oracle_holds() -> Bool {
  program_emit_equals_oracle(p: corruption_probe_zero_byte_program())
}

test fn nonempty_harness_emit_equals_oracle_holds() -> Bool {
  program_emit_equals_oracle(p: corruption_probe_nonempty_program())
}

test fn build_step_harness_emit_has_teeth_holds() -> Bool {
  program_emit_carried(p: corruption_probe_zero_byte_program()) !=
    program_emit_carried(p: corruption_probe_nonempty_program())
}

fn program_carried_equals_oracle(p: ShellProgram) -> Bool {
  program_emit_carried(p: p) == serialize_bash(p: p)
}

test fn loc_zero_byte_carried_equals_oracle_holds() -> Bool {
  program_carried_equals_oracle(p: corruption_probe_zero_byte_program())
}

test fn loc_nonempty_carried_equals_oracle_holds() -> Bool {
  program_carried_equals_oracle(p: corruption_probe_nonempty_program())
}

fn program_emit_dg_is_none(p: ShellProgram) -> Bool {
  match emit_shell_program(p: p) {
    Accepted { value: _, diagnostics: dg } => dg == None
    Rejected { diagnostics: _ } => false
  }
}

test fn loc_zero_byte_dg_none_holds() -> Bool {
  program_emit_dg_is_none(p: corruption_probe_zero_byte_program())
}

fn one_stmt_program(s: ShellStmt) -> ShellProgram {
  ShellProgram { set_e: false, statements: [s] }
}

test fn loc_prog_assign_tmpdir_holds() -> Bool {
  program_carried_equals_oracle(p: one_stmt_program(s: assign_tmpdir()))
}

test fn loc_prog_assign_probe_bin_holds() -> Bool {
  program_carried_equals_oracle(p: one_stmt_program(s: assign_probe_bin()))
}

test fn loc_prog_touch_chmod_holds() -> Bool {
  program_carried_equals_oracle(p: one_stmt_program(s: touch_and_chmod_probe()))
}
