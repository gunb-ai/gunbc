module v2.workflow.floor_skip_proof_plan

import gunbc.ci_layer_roots { witness_layer_roots }
import std.realization_schedule {
  SelectionApplied,
  Runnable,
  RunnableDiscoveryBatch,
  ScheduleWitnessEntry,
  CorpusWitnessKind,
  runnable_resource_profile_negligible
}
import std.measure { HardwareThreadCount, hardware_thread_count }
import std.types { List }

data floor_skip_disc_entry: String = "src/v2/test/fixture/floor_skip/node_precise_discriminator_test.dag"

fn floor_skip_proof_roster() -> List<ScheduleWitnessEntry> {
  [
    ScheduleWitnessEntry {
      entry: floor_skip_disc_entry,
      function: "floor_disc_witness_transitive_holds",
      kind: CorpusWitnessKind
    },
    ScheduleWitnessEntry {
      entry: floor_skip_disc_entry,
      function: "floor_disc_witness_a_only_holds",
      kind: CorpusWitnessKind
    }
  ]
}

fn floor_skip_proof_batches() -> List<List<Runnable>> {
  [[
    RunnableDiscoveryBatch {
      source_roots: witness_layer_roots,
      scan_dirs: [],
      explicit_entries: floor_skip_proof_roster(),
      node_frontier_selection: SelectionApplied,
      exclude_substrings: [],
      discovery_scope_dirs: [],
      spawn_width_cap: 1,
      profile: runnable_resource_profile_negligible()
    }
  ]]
}

fn floor_skip_proof_plan_spawn_width() -> HardwareThreadCount {
  hardware_thread_count(count: 1)
}
