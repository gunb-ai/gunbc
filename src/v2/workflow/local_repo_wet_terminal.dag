      expectation: ExpectedToHold {}
    },
    WetScheduledClaim {
      identity: WitnessIdentity { module_path: "test.claim.host_cli_dependency_wet_witness_test", function: "observe_echo_wet_posix_command_v_check_does_not_crash" },
