      expectation: ExpectedToHold {}
    },
    WetScheduledClaim {
      identity: WitnessIdentity { module_path: "test.claim.contract_identity.required_ci_epoch_real_execution_witness", function: "a_readable_commit_without_the_workflow_is_path_absent_not_commit_unreadable_by_real_execution" },
      entry: "dag/test/claim/contract_identity/required_ci_epoch_real_execution_witness_test.dag",
