module v2.workflow.locality_affinity


fn list_add_distinct_hash(xs: List<std.content_hash.ContentHash>, v: std.content_hash.ContentHash) -> List<std.content_hash.ContentHash> {
  if v2.std.materialize.hashes_contain(hs: xs, h: v) { xs } else { concat(xs, [v]) }
}

// Phase 3 of machine-shape-orthogonal-scheduling.md §5: affinity is derived topology, never a stored preference. derive_affinity groups a shared operand's OperandFlow rows against one ExecutionDomain's memory tower and claims the smallest level (walked outward per MemoryShape's ordering) whose capacity admits the whole footprint -- the operand's residency window. price_operand_traffic then prices a concrete batch assignment against that claim: consumers landing in the same batch cross the level boundary once (the operand stays resident across their execution, one TrafficAccountRow at footprint bytes); consumers split across batches each force a fresh crossing, so the double load is visible in the account's bytes, not merely asserted (§5 acceptance). Every refusal is typed and located (DESIGN §5): an unresolved operand edge, a footprint that fits no level in the tower, or a consumer missing from the batch assignment each refuse rather than default to a guessed placement -- no affinity claim and no priced account survive a refused input.
type AffinityRefusalCause
  = AffinityInsufficientConsumers { operand: std.content_hash.ContentHash }
  | AffinityFlowRefused { edge: v2.std.dependency.DependencyView, cause: v2.workflow.operand_flow.OperandFlowRefusalCause }
  | AffinityNoFittingLevel { operand: std.content_hash.ContentHash, footprint: std.measure.ByteSize }
  | AffinityFootprintUnresolved { operand: std.content_hash.ContentHash }
  | AffinityOperandMismatch { expected: std.content_hash.ContentHash, found: std.content_hash.ContentHash }
  | AffinityFootprintMismatch { operand: std.content_hash.ContentHash, expected: std.measure.ByteSize, found: std.measure.ByteSize }

type AffinityDecision
  = AffinityClaim { operand: std.content_hash.ContentHash, level: std.machine_shape.LevelId, footprint: std.measure.ByteSize, consumers: List<std.content_hash.ContentHash> }
  | AffinityRefused { operand: std.content_hash.ContentHash, cause: AffinityRefusalCause }

type AffinityCollectAcc
  = AffinityCollectOk { footprint: v2.std.optional.Optional<std.measure.ByteSize>, consumers: List<std.content_hash.ContentHash> }
  | AffinityCollectRefused { cause: AffinityRefusalCause }

fn affinity_collect_step(expected: std.content_hash.ContentHash, acc: AffinityCollectAcc, row: v2.workflow.operand_flow.OperandFlowRow) -> AffinityCollectAcc {
  match acc {
    AffinityCollectRefused { cause: c } => AffinityCollectRefused { cause: c }
    AffinityCollectOk { footprint: fp, consumers: cs } =>
      match row {
        v2.workflow.operand_flow.OperandFlow { edge: e, operand: op, footprint: f } =>
          if op == expected {
            match fp {
              v2.std.optional.Present { value: prior } =>
                if std.measure.measure_le(a: prior, b: f) && std.measure.measure_le(a: f, b: prior) {
                  AffinityCollectOk {
                    footprint: fp,
                    consumers: list_add_distinct_hash(xs: cs, v: std.content_hash.Fnv1a64(v2.std.node.content_hash(n: e.dependent)))
                  }
                } else {
                  AffinityCollectRefused {
                    cause: AffinityFootprintMismatch { operand: expected, expected: prior, found: f }
                  }
                }
              v2.std.optional.Absent =>
                AffinityCollectOk {
                  footprint: v2.std.optional.optional_present(value: f),
                  consumers: list_add_distinct_hash(xs: cs, v: std.content_hash.Fnv1a64(v2.std.node.content_hash(n: e.dependent)))
                }
            }
          } else {
            AffinityCollectRefused { cause: AffinityOperandMismatch { expected: expected, found: op } }
          }
        v2.workflow.operand_flow.OperandFlowRefused { edge: e, cause: c } =>
          AffinityCollectRefused { cause: AffinityFlowRefused { edge: e, cause: c } }
      }
  }
}

fn find_fitting_level(levels: List<std.machine_shape.MemoryLevel>, footprint: std.measure.ByteSize) -> v2.std.optional.Optional<std.machine_shape.LevelId> {
  fold(levels, init: v2.std.optional.optional_absent(), f: fn(found, level) {
    match found {
      v2.std.optional.Present { value: _ } => found
      v2.std.optional.Absent => if std.measure.measure_le(a: footprint, b: level.capacity) {
        v2.std.optional.optional_present(value: level.id)
      } else {
        v2.std.optional.optional_absent()
      }
    }
  })
}

fn derive_affinity(operand: std.content_hash.ContentHash, flows: List<v2.workflow.operand_flow.OperandFlowRow>, domain: std.machine_shape.ExecutionDomain) -> AffinityDecision {
  match fold(flows, init: AffinityCollectOk { footprint: v2.std.optional.optional_absent(), consumers: [] }, f: fn(acc, row) {
    affinity_collect_step(expected: operand, acc: acc, row: row)
  }) {
    AffinityCollectRefused { cause: c } => AffinityRefused { operand: operand, cause: c }
    AffinityCollectOk { footprint: fp, consumers: cs } =>
      if v2.std.algebra.length(xs: cs) < 2 {
        AffinityRefused { operand: operand, cause: AffinityInsufficientConsumers { operand: operand } }
      } else {
        match fp {
          v2.std.optional.Present { value: footprint } =>
            match find_fitting_level(levels: domain.memory, footprint: footprint) {
              v2.std.optional.Present { value: level_id } =>
                AffinityClaim { operand: operand, level: level_id, footprint: footprint, consumers: cs }
              v2.std.optional.Absent =>
                AffinityRefused { operand: operand, cause: AffinityNoFittingLevel { operand: operand, footprint: footprint } }
            }
          v2.std.optional.Absent =>
            AffinityRefused { operand: operand, cause: AffinityFootprintUnresolved { operand: operand } }
        }
      }
  }
}

type ConsumerBatch {
  consumer: std.content_hash.ContentHash
  batch: Int
}

type BatchLookup
  = BatchLookupFound { batch: Int }
  | BatchLookupMissing
  | BatchLookupConflict { first: Int, second: Int }

fn batch_for_consumer(assignment: List<ConsumerBatch>, consumer: std.content_hash.ContentHash) -> BatchLookup {
  fold(assignment, init: BatchLookupMissing, f: fn(found, cb) {
    match found {
      BatchLookupConflict { first: _, second: _ } => found
      BatchLookupFound { batch: b } =>
        if cb.consumer == consumer && !(cb.batch == b) {
          BatchLookupConflict { first: b, second: cb.batch }
        } else {
          found
        }
      BatchLookupMissing => if cb.consumer == consumer {
        BatchLookupFound { batch: cb.batch }
      } else {
        BatchLookupMissing
      }
    }
  })
}

type BatchCollectResult
  = BatchCollectOk { batches: List<Int> }
  | BatchCollectMissing { consumer: std.content_hash.ContentHash }
  | BatchCollectConflict { consumer: std.content_hash.ContentHash, first: Int, second: Int }

fn distinct_batches_for_consumers(consumers: List<std.content_hash.ContentHash>, assignment: List<ConsumerBatch>) -> BatchCollectResult {
  fold(consumers, init: BatchCollectOk { batches: [] }, f: fn(acc, consumer) {
    match acc {
      BatchCollectMissing { consumer: c } => BatchCollectMissing { consumer: c }
      BatchCollectConflict { consumer: c, first: f, second: s } => BatchCollectConflict { consumer: c, first: f, second: s }
      BatchCollectOk { batches: bs } =>
        match batch_for_consumer(assignment: assignment, consumer: consumer) {
          BatchLookupFound { batch: b } =>
            BatchCollectOk {
              batches: if v2.std.algebra.any(xs: bs, predicate: fn(x) { x == b }) { bs } else { concat(bs, [b]) }
            }
          BatchLookupMissing => BatchCollectMissing { consumer: consumer }
          BatchLookupConflict { first: f, second: s } => BatchCollectConflict { consumer: consumer, first: f, second: s }
        }
    }
  })
}

type TrafficAccountRow {
  level: std.machine_shape.LevelId
  bytes: std.measure.ByteSize
}

type TrafficPricingRefusalCause
  = TrafficAffinityRefused { operand: std.content_hash.ContentHash, cause: AffinityRefusalCause }
  | TrafficBatchAssignmentMissing { operand: std.content_hash.ContentHash, consumer: std.content_hash.ContentHash }
  | TrafficBatchAssignmentConflict { operand: std.content_hash.ContentHash, consumer: std.content_hash.ContentHash, first: Int, second: Int }

type TrafficPricing
  = TrafficPriced { account: TrafficAccountRow, crossings: Int }
  | TrafficPricingRefused { operand: std.content_hash.ContentHash, cause: TrafficPricingRefusalCause }

fn price_operand_traffic(
  operand: std.content_hash.ContentHash,
  flows: List<v2.workflow.operand_flow.OperandFlowRow>,
  domain: std.machine_shape.ExecutionDomain,
  assignment: List<ConsumerBatch>
) -> TrafficPricing {
  match derive_affinity(operand: operand, flows: flows, domain: domain) {
    AffinityRefused { operand: op, cause: c } =>
      TrafficPricingRefused { operand: op, cause: TrafficAffinityRefused { operand: op, cause: c } }
    AffinityClaim { operand: op, level: lvl, footprint: fp, consumers: cs } =>
      match distinct_batches_for_consumers(consumers: cs, assignment: assignment) {
        BatchCollectMissing { consumer: missing } =>
          TrafficPricingRefused { operand: op, cause: TrafficBatchAssignmentMissing { operand: op, consumer: missing } }
        BatchCollectConflict { consumer: conflicted, first: f, second: s } =>
          TrafficPricingRefused {
            operand: op,
            cause: TrafficBatchAssignmentConflict { operand: op, consumer: conflicted, first: f, second: s }
          }
        BatchCollectOk { batches: bs } =>
          let crossings = v2.std.algebra.length(xs: bs)
          let bytes = fold(bs, init: std.measure.byte_size(count: 0), f: fn(acc, _b) { std.measure.measure_add(a: acc, b: fp) })
          TrafficPriced { account: TrafficAccountRow { level: lvl, bytes: bytes }, crossings: crossings }
      }
  }
}
