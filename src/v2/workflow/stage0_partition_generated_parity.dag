module v2.workflow.stage0_partition_generated_parity

import gunbc.stage0_crate_partition_generated {
  GeneratedPartitionCrateKind,
  GeneratedPartitionCrateRow,
  GeneratedEmitCoreCrate,
  GeneratedFoundationCrate,
  GeneratedLayeredCoreCrate,
  generated_partition_crate_rows
}
import v2.std.algebra { any, fold_list }
import v2.std.collection { List }
import v2.std.optional { Absent, Optional, Present, optional_present }
import v2.std.text { String }
import v2.workflow.rust_crate_partition {
  Stage0EmitCoreCrate,
  Stage0FoundationCrate,
  Stage0LayeredCoreCrate,
  Stage0PartitionCrateKind,
  Stage0PartitionCrateRow,
  Stage0PartitionCrateRowsOk,
  Stage0PartitionCrateRowsRefused,
  stage0_partition_crate_rows_outcome,
  stage0_string_lists_equal_as_sets
}

data stage0_partition_generated_parity_note: String = "C2.5 committed partition artifact parity (NOT C3): the committed gunbc.stage0_crate_partition_generated.generated_partition_crate_rows projection must match the live v2.workflow.rust_crate_partition stage0_partition_crate_rows_outcome authority at every shared field. This module imports both sides and compares them — the authority must never import its own generated projection (one-way: authority produces projection; checker compares). Does not discharge C3 emitted-reference oracle or promote roster registration to ByDerivation."

fn stage0_parity_snoc_unique_string(xs: List<String>, item: String) -> List<String> {
  if any(xs: xs, predicate: fn(s) { s == item }) {
    xs
  } else {
    xs |> concat([item])
  }
}

fn stage0_parity_string_list_to_normalized_set(xs: List<String>) -> List<String> {
  xs
    |> fold(init: [], f: fn(acc, item) {
      stage0_parity_snoc_unique_string(xs: acc, item: item)
    })
}

fn stage0_parity_authority_kind_matches_generated(
  authority: Stage0PartitionCrateKind,
  generated: GeneratedPartitionCrateKind
) -> Bool {
  match authority {
    Stage0FoundationCrate =>
      match generated {
        GeneratedFoundationCrate => true
        GeneratedLayeredCoreCrate => false
        GeneratedEmitCoreCrate => false
      }
    Stage0LayeredCoreCrate =>
      match generated {
        GeneratedFoundationCrate => false
        GeneratedLayeredCoreCrate => true
        GeneratedEmitCoreCrate => false
      }
    Stage0EmitCoreCrate =>
      match generated {
        GeneratedFoundationCrate => false
        GeneratedLayeredCoreCrate => false
        GeneratedEmitCoreCrate => true
      }
  }
}

fn stage0_parity_generated_row_matches_authority_row(
  generated: GeneratedPartitionCrateRow,
  authority: Stage0PartitionCrateRow
) -> Bool {
  (generated.package_name == authority.package_name)
    && (generated.crate_dir == authority.crate_dir)
    && stage0_parity_authority_kind_matches_generated(
      authority: authority.kind,
      generated: generated.kind
    )
    && (generated.carries_non_empty_wrappers == authority.carries_non_empty_wrappers)
    && stage0_string_lists_equal_as_sets(
      left: generated.modules,
      right: authority.modules
    )
    && stage0_string_lists_equal_as_sets(
      left: generated.reexport_packages,
      right: authority.reexport_packages
    )
}

fn stage0_parity_string_list_has_no_duplicates(xs: List<String>) -> Bool {
  let unique = stage0_parity_string_list_to_normalized_set(xs: xs)
  (xs |> count) == (unique |> count)
}

fn stage0_parity_authority_row_for_package_name(
  package_name: String,
  authority_rows: List<Stage0PartitionCrateRow>
) -> Optional<Stage0PartitionCrateRow> {
  authority_rows
    |> fold(init: Absent, f: fn(found, authority_row) {
      match found {
        Present { value: _ } => found
        Absent =>
          if authority_row.package_name == package_name {
            optional_present(value: authority_row)
          } else {
            Absent
          }
      }
    })
}

fn stage0_parity_membership_lists_holds(
  generated_modules: List<String>,
  authority_modules: List<String>
) -> Bool {
  stage0_string_lists_equal_as_sets(
    left: generated_modules,
    right: authority_modules
  )
}

fn stage0_partition_generated_artifact_parity_holds() -> Bool {
  match stage0_partition_crate_rows_outcome() {
    Stage0PartitionCrateRowsRefused { cause: _ } => false
    Stage0PartitionCrateRowsOk { rows: authority_rows } => {
      let generated_rows = generated_partition_crate_rows
      let generated_package_names = generated_rows
        |> fold(init: [], f: fn(acc, generated_row) {
          acc |> concat([generated_row.package_name])
        })
      let authority_package_names = authority_rows
        |> fold(init: [], f: fn(acc, authority_row) {
          acc |> concat([authority_row.package_name])
        })
      stage0_parity_string_list_has_no_duplicates(xs: generated_package_names)
        && stage0_parity_string_list_has_no_duplicates(xs: authority_package_names)
        && (generated_rows |> count) == (authority_rows |> count)
        && generated_rows
          |> fold(init: true, f: fn(ok, generated_row) {
            match stage0_parity_authority_row_for_package_name(
              package_name: generated_row.package_name,
              authority_rows: authority_rows
            ) {
              Absent => false
              Present { value: authority_row } =>
                ok
                  && stage0_parity_generated_row_matches_authority_row(
                    generated: generated_row,
                    authority: authority_row
                  )
            }
          })
    }
  }
}

fn stage0_partition_generated_artifact_parity_refusal_propagates_holds() -> Bool {
  match stage0_partition_crate_rows_outcome() {
    Stage0PartitionCrateRowsRefused { cause: _ } =>
      !stage0_partition_generated_artifact_parity_holds()
    Stage0PartitionCrateRowsOk { rows: _ } => true
  }
}
