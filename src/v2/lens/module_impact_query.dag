module v2.lens.module_impact_query

import v2.std.algebra {
  any,
  contains,
  fold_list,
  list_snoc_item,
}
import v2.std.collection { List, Map, empty_map, map_insert }
import v2.std.optional { Absent, Optional, Present }
import v2.std.text { String }
import v2.lens.common.construction_justification {
  ConstructionJustification,
  WallAfterGrounding,
}
import std.disposition { SingleAuthority }
import v2.lens.module_graph {
  ModuleDeclarationFact,
  ModuleDependencyEdge,
  ImportResolutionFact,
  map_lookup_where_rejected_unreachable,
}

data module_impact_query_subject_note: String = "CONFIDENCE-0 capsule 1. THE reverse-direction reading over the module-graph edge population. This module adds NO edge producer: it consumes v2.lens.module_graph's ModuleDependencyEdge rows and ModuleDeclarationFact rows as data, exactly as dependency_closure does, and honours the 2026-07-10 operator constraint in dependency_edge_source_migration_note (do not add a second edge producer beside dependency_resolution_facts_live). What is new here is DIRECTION: before this module the corpus had only forward closure, and every consumer that wanted dependents simulated it with N forward closures. ImpactDirection makes the reverse reading first-class by inverting the same population once."

data module_impact_query_grain_honesty_note: String = "The reading is ModulePathGrain and says so in its own type. Declaration grain is NOT claimed: gunbc.namespace_reference_derived_closure_admission reports RepeatedMentionsCollapseDependency and UnrelatedLoadedFileExcluded as ReferenceDerivedClosureUnavailable (triggers P2aReferenceDependencyProjection7515 / P2aPoolIndependentDependencyProjection7515), re-observed 4/4 PASS on 6f4bc24444. Presenting a path-grain reading as declaration grain would be the rung inflation DESIGN 4b names. ImpactGrain is carried in the reading so a consumer cannot lose the distinction."

type ImpactDirection
  = DependenciesOf
  | DependentsOf

data module_impact_grain_refinement_note: String = "DeclarationGrain is the DECLARED REFINEMENT and is deliberately never constructed in this capsule: gunbc.namespace_reference_derived_closure_admission reports the two dependency-projection capabilities Unavailable against triggers P2aReferenceDependencyProjection7515 and P2aPoolIndependentDependencyProjection7515, so producing a DeclarationGrain reading today would be rung inflation, not progress. The arm exists so that a consumer must match on the grain rather than assume it, and so the refinement lands as a new producer rather than as a silent reinterpretation of this one. The v1 seed does not check match exhaustiveness, so every consumer here matches both arms explicitly."

type ImpactGrain
  = ModulePathGrain
  | DeclarationGrain

type EdgeProvenance
  = ImportDerivedEdge
  | ReferenceDerivedEdge

type ImpactEdge {
  source_path: String
  target_path: String
  provenance: EdgeProvenance
}

type UnaccountedTarget {
  source_path: String
  target_module: String
}

data module_impact_completeness_note: String = "Completeness is a lower bound plus a typed unaccounted set, never a closed set by default (DESIGN 5 empty-observation narrow). The unaccounted population is NOT invented here: ModuleDependencyEdge.target_declared already carries it. An edge whose target module is not declared in the observed pool means the graph continues outside the universe this reading can see, so every reading that touched such an edge is a lower bound. ImpactClosedProven is reserved for a reading with an empty unaccounted set."

type ImpactCompleteness
  = ImpactClosedProven
  | ImpactLowerBound {
      unaccounted: List<UnaccountedTarget>
    }

data module_impact_cycle_law_note: String = "Operator refinement 2026-08-08. Cycle membership is computed over the UNION edge population, where reference-derived cycles are legitimate and carry no violation. A cycle whose every participating edge is import-derived additionally violates the import-acyclicity law and must surface as its own typed diagnostic, not merely as SCC membership. The two are therefore distinct arms, not one arm with a flag."

type ImpactCycle
  = ImpactCycleReferenceAdmissible {
      members: List<String>
    }
  | ImpactImportAcyclicityViolation {
      members: List<String>
    }

data module_impact_provenance_derivation_note: String = "Edge provenance is DERIVED at query time by membership in the import-only population, not read off the edge. ModuleDependencyEdge carries no provenance field, and dependency_resolution_facts_live erases it by construction: it unions import and reference facts as ImportResolutionFact BEFORE mapping to edges, and union_import_resolution_fact_lists dedups reference-first, so a fact backed by both survives as the reference copy. Deriving the classification from the producer's own already-public component (import_resolution_facts_live) stores no second representation. RESIDUE with trigger: stamping provenance at the single construction site import_fact_to_dependency_edge is the construction-grade climb, and it edits the single edge producer under the 2026-07-10 constraint, so it is escalated rather than taken inside this capsule."

type ImpactReading {
  direction: ImpactDirection
  grain: ImpactGrain
  seeds: List<String>
  reached: List<String>
  explanation: List<ImpactEdge>
  completeness: ImpactCompleteness
  cycles: List<ImpactCycle>
}

data impact_no_paths: List<String> = []

data impact_no_edges: List<ImpactEdge> = []

data impact_no_unaccounted: List<UnaccountedTarget> = []

data impact_no_cycles: List<ImpactCycle> = []

data impact_no_components: List<List<String>> = []

fn impact_string_eq(a: String, b: String) -> Bool {
  a == b
}

fn impact_add_unseen_path(acc: List<String>, item: String) -> List<String> {
  if contains(xs: acc, item: item, eq: impact_string_eq) {
    acc
  } else {
    list_snoc_item(xs: acc, item: item)
  }
}

fn impact_edge_is_import_derived(
  edge: ModuleDependencyEdge,
  import_facts: List<ImportResolutionFact>
) -> Bool {
  any(
    xs: import_facts,
    predicate: fn(fact) {
      fact.path == edge.path && fact.import_module == edge.target_module
    }
  )
}

fn impact_provenance_of_edge(
  edge: ModuleDependencyEdge,
  import_facts: List<ImportResolutionFact>
) -> EdgeProvenance {
  if impact_edge_is_import_derived(edge: edge, import_facts: import_facts) {
    ImportDerivedEdge
  } else {
    ReferenceDerivedEdge
  }
}

fn impact_target_path_of_edge(
  edge: ModuleDependencyEdge,
  nodes: List<ModuleDeclarationFact>
) -> List<String> {
  fold_list(
    xs: nodes,
    empty: impact_no_paths,
    cons: fn(acc, node) {
      if node.module == edge.target_module {
        impact_add_unseen_path(acc: acc, item: node.path)
      } else {
        acc
      }
    }
  )
}

fn impact_edges_resolved(
  edges: List<ModuleDependencyEdge>,
  nodes: List<ModuleDeclarationFact>,
  import_facts: List<ImportResolutionFact>
) -> List<ImpactEdge> {
  fold_list(
    xs: edges,
    empty: impact_no_edges,
    cons: fn(acc, edge) {
      fold_list(
        xs: impact_target_path_of_edge(edge: edge, nodes: nodes),
        empty: acc,
        cons: fn(inner, target_path) {
          list_snoc_item(
            xs: inner,
            item: ImpactEdge {
              source_path: edge.path,
              target_path: target_path,
              provenance: impact_provenance_of_edge(
                edge: edge,
                import_facts: import_facts
              )
            }
          )
        }
      )
    }
  )
}

fn impact_unaccounted_targets(
  edges: List<ModuleDependencyEdge>
) -> List<UnaccountedTarget> {
  fold_list(
    xs: edges,
    empty: impact_no_unaccounted,
    cons: fn(acc, edge) {
      if edge.target_declared {
        acc
      } else {
        list_snoc_item(
          xs: acc,
          item: UnaccountedTarget {
            source_path: edge.path,
            target_module: edge.target_module
          }
        )
      }
    }
  )
}

fn impact_completeness_from_unaccounted(
  unaccounted: List<UnaccountedTarget>
) -> ImpactCompleteness {
  if any(xs: unaccounted, predicate: fn(_) { true }) {
    ImpactLowerBound { unaccounted: unaccounted }
  } else {
    ImpactClosedProven
  }
}

data module_impact_walk_shape_note: String = "The walk is the recursive worklist shape v2.lens.module_graph already proves in import_closure_bfs_walk, over an adjacency built ONCE per reading, not a second traversal shape invented here (DESIGN 3). The first draft of this module re-expanded the whole reached set once per edge, which is the copied-accumulator cost shape DESIGN 6 bare-minimum-cost forbids regardless of realized n; it was replaced before landing rather than excused as small. RESIDUE with trigger, stated at its real magnitude after the SCC partition landed: impact_cyclic_nodes runs one walk per member of the reached set, and impact_place_in_components runs two further walks per (cyclic node, candidate component) pair through impact_mutually_reachable, so cycle classification is quadratic in the reached set and superlinear again in the number of components. The partition made this term LARGER, and it was still the right trade because the union-level classification it replaced was fail-open on the import-acyclicity law (module_impact_cycle_partition_note) - correctness first, then cost. It stays bounded to the QUERIED reached set and is never a whole-corpus SCC census. Climb: a single-pass Tarjan SCC producer computes the same partition in one traversal and subsumes all three walk sites."

type ImpactBfsState {
  reached: List<String>
  queue: List<String>
}

fn impact_adjacency_from(edge: ImpactEdge, direction: ImpactDirection) -> String {
  match direction {
    DependenciesOf => edge.source_path
    DependentsOf => edge.target_path
  }
}

fn impact_adjacency_to(edge: ImpactEdge, direction: ImpactDirection) -> String {
  match direction {
    DependenciesOf => edge.target_path
    DependentsOf => edge.source_path
  }
}

fn impact_neighbors_of(
  adjacency: Map<String, List<String>>,
  path: String
) -> List<String> {
  match map_lookup_where_rejected_unreachable(m: adjacency, key: path) {
    Present { value: paths } => paths
    Absent => impact_no_paths
  }
}

fn impact_adjacency(
  resolved: List<ImpactEdge>,
  direction: ImpactDirection
) -> Map<String, List<String>> {
  fold_list(
    xs: resolved,
    empty: empty_map(),
    cons: fn(acc, edge) {
      let from = impact_adjacency_from(edge: edge, direction: direction)
      map_insert(
        m: acc,
        key: from,
        value: impact_add_unseen_path(
          acc: impact_neighbors_of(adjacency: acc, path: from),
          item: impact_adjacency_to(edge: edge, direction: direction)
        )
      )
    }
  )
}

fn impact_bfs_absorb(state: ImpactBfsState, path: String) -> ImpactBfsState {
  if contains(xs: state.reached, item: path, eq: impact_string_eq) {
    state
  } else {
    ImpactBfsState {
      reached: list_snoc_item(xs: state.reached, item: path),
      queue: list_snoc_item(xs: state.queue, item: path)
    }
  }
}

fn impact_bfs_absorb_all(
  state: ImpactBfsState,
  neighbors: List<String>
) -> ImpactBfsState {
  fold_list(
    xs: neighbors,
    empty: state,
    cons: fn(acc, path) { impact_bfs_absorb(state: acc, path: path) }
  )
}

fn impact_bfs_walk(
  state: ImpactBfsState,
  adjacency: Map<String, List<String>>
) -> List<String> {
  match state.queue |> first {
    Present { value: path } =>
      impact_bfs_walk(
        state: impact_bfs_absorb_all(
          state: ImpactBfsState {
            reached: state.reached,
            queue: state.queue |> skip(1)
          },
          neighbors: impact_neighbors_of(adjacency: adjacency, path: path)
        ),
        adjacency: adjacency
      )
    Absent => state.reached
  }
}

fn impact_closure_from_seeds(
  adjacency: Map<String, List<String>>,
  seeds: List<String>
) -> List<String> {
  impact_bfs_walk(
    state: ImpactBfsState { reached: seeds, queue: seeds },
    adjacency: adjacency
  )
}

fn impact_path_reaches_self(
  adjacency: Map<String, List<String>>,
  path: String
) -> Bool {
  contains(
    xs: impact_closure_from_seeds(
      adjacency: adjacency,
      seeds: impact_neighbors_of(adjacency: adjacency, path: path)
    ),
    item: path,
    eq: impact_string_eq
  )
}

data module_impact_cycle_partition_note: String = "Cycle classification partitions the cyclic nodes into strongly connected components and classifies EACH component independently. An earlier revision of this module folded every cyclic node in the reached set into ONE member list and emitted ONE verdict for the union, which was fail-open on precisely the law module_impact_cycle_law_note states: with two disjoint cycles in one reading, a single ReferenceDerivedEdge in the first made impact_cycle_all_edges_import_derived false for the whole union, so a genuine all-import cycle in the second reported as ImpactCycleReferenceAdmissible and its ImportAcyclicityViolation was suppressed. Import-acyclicity is a per-cycle law, so the partition is part of the law's meaning, not an optimisation. Components are built by mutual reachability (u and v share a component iff each reaches the other), which is the same walk this module already uses rather than a second traversal; a single-pass Tarjan producer remains the declared cost climb, and it does not change these verdicts. Caught by review 50459 on gunbc#8044."

fn impact_cyclic_nodes(
  adjacency: Map<String, List<String>>,
  reached: List<String>
) -> List<String> {
  fold_list(
    xs: reached,
    empty: impact_no_paths,
    cons: fn(acc, path) {
      if impact_path_reaches_self(adjacency: adjacency, path: path) {
        impact_add_unseen_path(acc: acc, item: path)
      } else {
        acc
      }
    }
  )
}

fn impact_mutually_reachable(
  adjacency: Map<String, List<String>>,
  a: String,
  b: String
) -> Bool {
  contains(
    xs: impact_closure_from_seeds(adjacency: adjacency, seeds: [a]),
    item: b,
    eq: impact_string_eq
  )
    && contains(
      xs: impact_closure_from_seeds(adjacency: adjacency, seeds: [b]),
      item: a,
      eq: impact_string_eq
    )
}

fn impact_component_admits(
  adjacency: Map<String, List<String>>,
  component: List<String>,
  path: String
) -> Bool {
  match component |> first {
    Present { value: representative } =>
      impact_mutually_reachable(
        adjacency: adjacency,
        a: representative,
        b: path
      )
    Absent => false
  }
}

type ImpactComponentAcc {
  components: List<List<String>>
  placed: Bool
}

fn impact_place_in_components(
  adjacency: Map<String, List<String>>,
  components: List<List<String>>,
  path: String
) -> List<List<String>> {
  let acc = fold_list(
    xs: components,
    empty: ImpactComponentAcc { components: impact_no_components, placed: false },
    cons: fn(state, component) {
      if state.placed {
        ImpactComponentAcc {
          components: list_snoc_item(xs: state.components, item: component),
          placed: true
        }
      } else {
        if impact_component_admits(
          adjacency: adjacency,
          component: component,
          path: path
        ) {
          ImpactComponentAcc {
            components: list_snoc_item(
              xs: state.components,
              item: impact_add_unseen_path(acc: component, item: path)
            ),
            placed: true
          }
        } else {
          ImpactComponentAcc {
            components: list_snoc_item(xs: state.components, item: component),
            placed: false
          }
        }
      }
    }
  )
  if acc.placed {
    acc.components
  } else {
    list_snoc_item(xs: acc.components, item: [path])
  }
}

fn impact_cycle_components(
  adjacency: Map<String, List<String>>,
  reached: List<String>
) -> List<List<String>> {
  fold_list(
    xs: impact_cyclic_nodes(adjacency: adjacency, reached: reached),
    empty: impact_no_components,
    cons: fn(acc, path) {
      impact_place_in_components(
        adjacency: adjacency,
        components: acc,
        path: path
      )
    }
  )
}

fn impact_edge_joins_members(edge: ImpactEdge, members: List<String>) -> Bool {
  contains(xs: members, item: edge.source_path, eq: impact_string_eq)
    && contains(xs: members, item: edge.target_path, eq: impact_string_eq)
}

fn impact_cycle_all_edges_import_derived(
  resolved: List<ImpactEdge>,
  members: List<String>
) -> Bool {
  fold_list(
    xs: resolved,
    empty: true,
    cons: fn(acc, edge) {
      if impact_edge_joins_members(edge: edge, members: members) {
        match edge.provenance {
          ImportDerivedEdge => acc
          ReferenceDerivedEdge => false
        }
      } else {
        acc
      }
    }
  )
}

fn impact_classify_component(
  resolved: List<ImpactEdge>,
  members: List<String>
) -> ImpactCycle {
  if impact_cycle_all_edges_import_derived(resolved: resolved, members: members) {
    ImpactImportAcyclicityViolation { members: members }
  } else {
    ImpactCycleReferenceAdmissible { members: members }
  }
}

fn impact_classify_cycles(
  resolved: List<ImpactEdge>,
  components: List<List<String>>
) -> List<ImpactCycle> {
  fold_list(
    xs: components,
    empty: impact_no_cycles,
    cons: fn(acc, members) {
      list_snoc_item(
        xs: acc,
        item: impact_classify_component(resolved: resolved, members: members)
      )
    }
  )
}

fn module_impact_reading(
  seeds: List<String>,
  direction: ImpactDirection,
  edges: List<ModuleDependencyEdge>,
  nodes: List<ModuleDeclarationFact>,
  import_facts: List<ImportResolutionFact>
) -> ImpactReading {
  let resolved = impact_edges_resolved(
    edges: edges,
    nodes: nodes,
    import_facts: import_facts
  )
  let adjacency = impact_adjacency(resolved: resolved, direction: direction)
  let reached = impact_closure_from_seeds(adjacency: adjacency, seeds: seeds)
  let components = impact_cycle_components(adjacency: adjacency, reached: reached)
  ImpactReading {
    direction: direction,
    grain: ModulePathGrain,
    seeds: seeds,
    reached: reached,
    explanation: resolved,
    completeness: impact_completeness_from_unaccounted(
      unaccounted: impact_unaccounted_targets(edges: edges)
    ),
    cycles: impact_classify_cycles(resolved: resolved, components: components)
  }
}

data module_impact_construction_justification_note: String = "The bad-state class this module concerns is a consumer reading a LOWER-BOUND, PATH-GRAIN, per-component answer as if it were a closed, node-grain, whole-subgraph one. Three quarters of that class are already unwritable by construction rather than validated after the fact: ImpactGrain is a coproduct the consumer must match, so path grain cannot be silently read as declaration grain; ImpactCompleteness makes ImpactClosedProven reachable only from an empty unaccounted set, so a lower bound cannot present as closed; and cycle classification emits one verdict per strongly connected component, so a per-cycle law cannot be answered at union grain (the defect review 50459 caught). What is NOT yet walled, and is exactly what the grounding supplies: edge provenance is DERIVED at query time from the import-only population rather than carried on the edge, so a change to the edge population could reclassify a cycle without any consumer edit; and the declaration-grain producer does not exist, so DeclarationGrain is a declared arm with no constructor. Both dissolve to one authority - provenance stamped at the single construction site import_fact_to_dependency_edge, and the dependency-projection capabilities landing behind P2aReferenceDependencyProjection7515 / P2aPoolIndependentDependencyProjection7515 - hence WallAfterGrounding rather than WallNow, and not RatchetForever, because neither residue is undecidable."

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SingleAuthority }
}
