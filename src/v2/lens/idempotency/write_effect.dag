module v2.test.lens_idempotency.write_effect

import v2.compiler.infer { InferredFacts, InferredTree }
import v2.compiler.eval {
  TestClaimEvalSubject,
  TestClaimRun,
  eval_test_claim_subject,
  run_test_claim_assert,
  run_test_claim
}
import v2.lens.idempotency {
  IdempotencyFact,
  RequiresAlgebraWitness,
  idempotency_fact,
  idempotency_fact_eq,
  idempotency_witness
}
import v2.std.dependency {
  ClassifiedDependencyView,
  DependencyView,
  EffectDependsOn
}
import v2.std.diagnostic { Accepted, None }
import v2.std.logic { Bool }
import v2.std.node { Atom, Edge, Named, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.runtime { RuntimeValue }
import v2.std.verification {
  ManualAnchorAbsent,
  TestClassification,
  TestClaim,
  Tier1,
  Integration,
  EqualsClaim,
  manual_claim_anchor
}
import v2.std.verdict { Verdict }
import v2.std.witness { Violates, Witness }
import v2.test.lens_common.infer_fixture {
  claim_atom_node,
  claim_inferred_facts,
  claim_inferred_tree
}
import v2.test.manual.eval_runtime {
  eval_add_subgraph,
  eval_context,
  eval_inferred_tree
}

data idempotency_child: Node = claim_atom_node(s: ^idempotency_child_symbol)

data idempotency_root: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^idempotency_root_symbol } },
  children: [
    Edge { label: Named { name: ^idempotency_edge_symbol }, target: idempotency_child }
  ],
  occurrence_id: SyntheticOccurrence
}

data idempotency_dependency: DependencyView = DependencyView {
  source: idempotency_root,
  dependent: idempotency_child,
  kind: EffectDependsOn,
  usage_site: idempotency_child
}

fn idempotency_claim_facts() -> InferredFacts {
  claim_inferred_facts(
    type_symbol: ^idempotency_type_symbol,
    algebra_symbol: ^idempotency_algebra_symbol,
    descent_symbol: ^idempotency_descent_symbol,
  )
}

fn idempotency_claim_tree() -> InferredTree {
  claim_inferred_tree(root: idempotency_root, facts: idempotency_claim_facts())
}

type LensIdempotencyClaim {
  input: InferredTree
  expected: IdempotencyFact
  actual: Witness<IdempotencyFact>
}

data idempotency_write_effect_claim: LensIdempotencyClaim = LensIdempotencyClaim {
  input: idempotency_claim_tree(),
  expected: IdempotencyFact {
    dependencies: [
      ClassifiedDependencyView {
        dependency: idempotency_dependency,
        classification: RequiresAlgebraWitness
      }
    ]
  },
  actual: idempotency_witness(tree: idempotency_claim_tree(), dependencies: [idempotency_dependency])
}

fn idempotency_write_effect_claim_holds() -> Bool {
  match idempotency_write_effect_claim.actual {
    Violates { diagnostic: _ } =>
      idempotency_fact_eq(
        a: idempotency_fact(
          tree: idempotency_write_effect_claim.input,
          dependencies: [idempotency_dependency]
        ),
        b: idempotency_write_effect_claim.expected
      )
    _ => false
  }
}

data idempotency_write_effect_claim_passes: Bool = idempotency_write_effect_claim_holds()

fn idempotency_claim_pass_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^idempotency_claim_pass_symbol } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn idempotency_claim_fail_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^idempotency_claim_fail_symbol } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn idempotency_claim_input(ok: Bool) -> Node {
  if ok {
    idempotency_claim_pass_node()
  } else {
    idempotency_claim_fail_node()
  }
}

data claim_idempotency_write_effect_receipt: TestClaim = EqualsClaim {
  label: "lens_idempotency write effect witness classifies EffectDependsOn as RequiresAlgebraWitness",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: idempotency_claim_input(ok: idempotency_write_effect_claim_passes),
  rhs: idempotency_claim_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Integration }
}

data verdict_idempotency_write_effect_node_assert: Verdict<TestClaimEvalSubject<Node>, Node> = run_test_claim_assert(
  claim: claim_idempotency_write_effect_receipt,
  actual: Accepted {
    value: idempotency_claim_input(ok: idempotency_write_effect_claim_passes),
    diagnostics: None
  },
  at: idempotency_claim_pass_node()
)

fn idempotency_executable_claim_input(ok: Bool) -> Node {
  if ok {
    eval_add_subgraph()
  } else {
    idempotency_claim_fail_node()
  }
}

data claim_idempotency_write_effect_run_test_claim_receipt: TestClaim = EqualsClaim {
  label: "lens_idempotency write effect witness gates run_test_claim executable receipt",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: idempotency_executable_claim_input(ok: idempotency_write_effect_claim_passes),
  rhs: eval_add_subgraph(),
  classification: TestClassification { tier: Tier1, layer: Integration }
}

data subject_idempotency_write_effect_receipt: TestClaimEvalSubject<Node> = eval_test_claim_subject(
  claim: claim_idempotency_write_effect_run_test_claim_receipt,
  context: eval_context(),
  tree: eval_inferred_tree(),
  evaluator_pin: ^eval_evaluator_pin
)

data run_idempotency_write_effect_receipt: TestClaimRun<Node, RuntimeValue> = run_test_claim(
  subject: subject_idempotency_write_effect_receipt
)