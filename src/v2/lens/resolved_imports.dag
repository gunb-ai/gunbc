// src/v2/lens/resolved_imports.dag
// Scope: import-RESOLUTION lens (DESIGN §5 fail-closed). The structural form of the
//        resolver's `UnresolvedImport` rule (AUTHORITATIVE producer: resolve_import emits
//        UnresolvedImport at src/v1/stage0/src/v1_compiler_resolve.rs:271, .dag mirror
//        src/v1/03_resolve.dag:170-173, when `find_module(module_index, import_path) ==
//        Absent`): an `import <module>` whose target module is declared NOWHERE in the
//        scanned pool is a dangling import. This lens PROJECTS that single-authority rule
//        into a cheap CI gate — it is not a fork.
//        This is the import-enforcement the parse-gated whole-tree compile never reaches —
//        `front_end_sources` (src/v1/compile.dag:1171-1184) short-circuits to `graph: none`
//        on ANY parse error, so the live src/v2 parse-fixtures silently drop every
//        resolve diagnostic, UnresolvedImport included. This lens runs over the live tree
//        directly (text/parse level, no compile), so it enforces regardless of that gate.
// Sibling of v2.lens.layering_imports: that lens owns import DIRECTION (which layer may
//        import which); this one owns import RESOLUTION (does the target exist at all) —
//        two distinct violation classes over the same import-fact projection.
// Consumer: tools.resolved_imports_gate → tools.resolved_imports_transport host scan.

module v2.lens.resolved_imports

import v2.std.algebra {
  fold_list,
  is_empty,
  length,
  list_snoc_item
}
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }

// One import fact from host enumeration: the repo-relative `.dag` path, the imported
// module path, and whether that module is DECLARED anywhere in the pool roots (the host
// computes membership against the resolver's own build_module_path_index — single
// authority for "what module names exist").
type ImportResolutionFact {
  path: String
  import_module: String
  target_declared: Bool
}

type UnresolvedImportViolation {
  path: String
  import_module: String
}

// The resolver's UnresolvedImport rule, structurally: target module not in the pool.
fn is_unresolved_import(fact: ImportResolutionFact) -> Bool {
  fact.target_declared == false
}

data empty_unresolved_import_violations: List<UnresolvedImportViolation> = []

fn scan_facts_for_unresolved(facts: List<ImportResolutionFact>) -> List<UnresolvedImportViolation> {
  fold_list(
    xs: facts,
    empty: empty_unresolved_import_violations,
    cons: fn(acc, fact) {
      if is_unresolved_import(fact: fact) {
        list_snoc_item(
          xs: acc,
          item: UnresolvedImportViolation {
            path: fact.path,
            import_module: fact.import_module
          }
        )
      } else {
        acc
      }
    }
  )
}

fn resolved_imports_clean_holds(facts: List<ImportResolutionFact>) -> Bool {
  is_empty(xs: scan_facts_for_unresolved(facts: facts))
}

// Number of import facts the projection actually visited (NOT the violation count).
fn resolved_imports_fact_count(facts: List<ImportResolutionFact>) -> Int {
  length(xs: facts)
}

// §5 SELF-DEFENSE (non-vacuous BY CONSTRUCTION, not reliant on the external perturb
// fixture). `resolved_imports_clean_holds` is `is_empty(violations)`, so a scan that
// visited ZERO imports (wrong CWD, deleted/empty tree, mis-rooted importer set) returns
// `is_empty([]) == true` — a vacuous green. Floor it: a clean verdict counts only if the
// scan actually saw at least one import. So this gate cannot silently relax to a no-op.
fn resolved_imports_clean_nonvacuous_holds(facts: List<ImportResolutionFact>) -> Bool {
  (is_empty(xs: facts) == false) && resolved_imports_clean_holds(facts: facts)
}

fn resolved_imports_violation_count(facts: List<ImportResolutionFact>) -> Int {
  length(xs: scan_facts_for_unresolved(facts: facts))
}

// Parse-bridge: structural projection of import-resolution facts over the live `.dag`
// tree. REUSES the resolver's own build_module_path_index (declared-module pool) +
// extract_import_paths + collect_dag_files_tolerant (single authority; v1 handler:
// src/v1/stage0/src/import_resolution_project.rs) — the same primitives
// v2.lens.layering_imports shares. The pool roots, importer roots, and the importer-set
// exclusion policy (e.g. the `/test/fixture/` text fixtures that intentionally carry
// broken imports) are all passed by the caller (DESIGN §3 (c): scan-scope is workflow
// POLICY, not baked into the projection).
// dissolve-on: emit(intent, Bash) / v2 self-host folds this projection over its own
//   parsed module Node-set, and/or front_end_sources becomes parse-resilient so the
//   whole-tree compile reaches resolve and emits UnresolvedImport natively.
fn import_resolution_facts_live(
  pool_roots: List<String>,
  importer_roots: List<String>,
  exclude_substrings: List<String>
) -> List<ImportResolutionFact> {
  import_resolution_facts(
    pool_roots: pool_roots,
    importer_roots: importer_roots,
    exclude_substrings: exclude_substrings
  )
}
