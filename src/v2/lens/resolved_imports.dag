module v2.lens.resolved_imports
import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }

import v2.std.algebra {
  fold_list,
  is_empty,
  length,
  list_snoc_item
}
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }

type ImportResolutionFact {
  path: String
  import_module: String
  target_declared: Bool
}

type UnresolvedImportViolation {
  path: String
  import_module: String
}

fn is_unresolved_import(fact: ImportResolutionFact) -> Bool {
  fact.target_declared == false
}

data empty_unresolved_import_violations: List<UnresolvedImportViolation> = []

fn scan_facts_for_unresolved(facts: List<ImportResolutionFact>) -> List<UnresolvedImportViolation> {
  fold_list(
    xs: facts,
    empty: empty_unresolved_import_violations,
    cons: fn(acc, fact) {
      if is_unresolved_import(fact: fact) {
        list_snoc_item(
          xs: acc,
          item: UnresolvedImportViolation {
            path: fact.path,
            import_module: fact.import_module
          }
        )
      } else {
        acc
      }
    }
  )
}

fn resolved_imports_clean_holds(facts: List<ImportResolutionFact>) -> Bool {
  is_empty(xs: scan_facts_for_unresolved(facts: facts))
}

fn resolved_imports_fact_count(facts: List<ImportResolutionFact>) -> Int {
  length(xs: facts)
}

fn resolved_imports_clean_nonvacuous_holds(facts: List<ImportResolutionFact>) -> Bool {
  (is_empty(xs: facts) == false) && resolved_imports_clean_holds(facts: facts)
}

fn resolved_imports_violation_count(facts: List<ImportResolutionFact>) -> Int {
  length(xs: scan_facts_for_unresolved(facts: facts))
}

fn import_resolution_facts_live(
  pool_roots: List<String>,
  importer_roots: List<String>,
  exclude_substrings: List<String>
) -> List<ImportResolutionFact> {
  import_resolution_facts(
    pool_roots: pool_roots,
    importer_roots: importer_roots,
    exclude_substrings: exclude_substrings
  )
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding {
    grounding_authority: "front_end_sources parse-resilience so the resolver's own UnresolvedImport rule gates the whole tree",
    dissolve_on: "whole-tree resolve runs (front_end_sources no longer short-circuits to graph:none on a parse error), so UnresolvedImport is the authority"
  },
  rationale: "A dangling import is decidable and is the resolver's authoritative UnresolvedImport rule; this lens is the interim projection of that single authority into a CI gate the parse-gated whole-tree compile never reaches."
}
