module v2.lens.no_dual_representation_test.scan

import v2.std.algebra {
  fold_list,
  is_empty,
  length,
  list_append,
  list_snoc_item
}
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text {
  Char,
  CharAbsent,
  CharFound,
  String,
  string_head
}

type DualRepViolationKind
  = SameSymbolEquality
  | DataLiteralMirror
  | BodyAlphaEquivalent

type DualRepViolation {
  path: String
  fn_name: String
  kind: DualRepViolationKind
}

type DualRepDataInit {
  name: String
  literal_fp: String
}

type DualRepFnRecord {
  name: String
  body: String
  params: List<String>
}

type DualRepModuleScan {
  path: String
  data_inits: List<DualRepDataInit>
  fns: List<DualRepFnRecord>
}

type EqSite {
  lhs: String
  rhs: String
}

type LineSplitState {
  lines: List<String>
  current: String
}

data empty_dual_rep_violations: List<DualRepViolation> = []
data empty_dual_rep_data_inits: List<DualRepDataInit> = []
data empty_dual_rep_fns: List<DualRepFnRecord> = []
data empty_dual_rep_module_scans: List<DualRepModuleScan> = []
data empty_eq_sites: List<EqSite> = []
data empty_string_list: List<String> = []
data empty_dual_rep_fn_record: DualRepFnRecord = DualRepFnRecord {
  name: "",
  body: "",
  params: empty_string_list
}

fn path_is_test_dag(path: String) -> Bool {
  string_contains(s: path, pattern: "_test.dag")
}

fn is_ident_char(c: Char) -> Bool {
  (c >= 48 && c <= 57)
    || (c >= 65 && c <= 90)
    || (c >= 97 && c <= 122)
    || c == 95
}

fn take_ident_prefix(s: String) -> String {
  fold_list(
    xs: s,
    empty: Empty,
    cons: fn(acc, c) {
      if is_empty(xs: acc) && (is_ident_char(c: c) == false) {
        acc
      } else if is_empty(xs: acc) == false && (is_ident_char(c: c) == false) {
        acc
      } else if is_ident_char(c: c) {
        list_snoc_item(xs: acc, item: c)
      } else {
        acc
      }
    }
  )
}

fn trim_left(s: String) -> String {
  fold_list(
    xs: s,
    empty: s,
    cons: fn(acc, c) {
      if acc == s && (c == 32 || c == 9) {
        substring(s: acc, start: 1, end: length(xs: acc))
      } else {
        acc
      }
    }
  )
}

fn literal_fingerprint_text(lit: String) -> String {
  let trimmed = trim_left(s: lit)
  if string_contains(s: trimmed, pattern: "\"") {
    concat("str:", trimmed)
  } else if trimmed == "true" || trimmed == "false" {
    concat("bool:", trimmed)
  } else {
    concat("num:", trimmed)
  }
}

fn fn_name_from_decl_line(line: String) -> String {
  if string_contains(s: line, pattern: "test fn ") {
    take_ident_prefix(s: substring(s: line, start: 8, end: length(xs: line)))
  } else if string_contains(s: line, pattern: "func ") {
    take_ident_prefix(s: substring(s: line, start: 5, end: length(xs: line)))
  } else if string_contains(s: line, pattern: "fn ") {
    take_ident_prefix(s: substring(s: line, start: 3, end: length(xs: line)))
  } else {
    ""
  }
}

fn line_is_data_decl(line: String) -> Bool {
  string_contains(s: line, pattern: "data ")
    && string_contains(s: line, pattern: "=")
    && string_contains(s: line, pattern: ":")
}

fn line_is_fn_decl(line: String) -> Bool {
  string_contains(s: line, pattern: "fn ")
    || string_contains(s: line, pattern: "func ")
}

fn data_init_from_line(line: String) -> DualRepDataInit {
  DualRepDataInit {
    name: take_ident_prefix(s: substring(s: line, start: 5, end: length(xs: line))),
    literal_fp: literal_fingerprint_text(
      lit: trim_left(
        s: substring(
          s: line,
          start: index_of_char(line: line, target: 61) + 1,
          end: length(xs: line)
        )
      )
    )
  }
}

fn index_of_char(line: String, target: Char) -> Int {
  fold_list(
    xs: line,
    empty: 0,
    cons: fn(acc, c) {
      if acc > 0 {
        acc
      } else if c == target {
        1
      } else {
        acc + 1
      }
    }
  )
}

fn operand_bare_ident(operand: String) -> String {
  let trimmed = trim_left(s: operand)
  let ident = take_ident_prefix(s: trimmed)
  if ident == trimmed {
    ident
  } else {
    ""
  }
}

fn operand_is_call(operand: String) -> Bool {
  string_contains(s: trim_left(s: operand), pattern: "(")
}

fn lookup_data_literal(data_inits: List<DualRepDataInit>, name: String) -> String {
  fold_list(
    xs: data_inits,
    empty: "",
    cons: fn(acc, row) {
      if row.name == name {
        row.literal_fp
      } else {
        acc
      }
    }
  )
}

fn lookup_fn_record(fns: List<DualRepFnRecord>, name: String) -> DualRepFnRecord {
  fold(fns, init: empty_dual_rep_fn_record, f: fn(acc, row) {
    if row.name == name {
      row
    } else {
      acc
    }
  })
}

fn first_param_name(params: List<String>) -> String {
  fold_list(
    xs: params,
    empty: "",
    cons: fn(_acc, p) { p }
  )
}

fn callee_from_call(operand: String) -> String {
  take_ident_prefix(s: trim_left(s: operand))
}

fn first_arg_from_call(operand: String) -> String {
  if string_contains(s: operand, pattern: ":") {
    let after_colon = substring(
      s: operand,
      start: index_of_char(line: operand, target: 58) + 1,
      end: length(xs: operand)
    )
    take_ident_prefix(s: trim_left(s: after_colon))
  } else {
    ""
  }
}

fn replace_param_in_body(body: String, param: String, arg: String) -> String {
  if body == param {
    arg
  } else if string_contains(s: body, pattern: concat(": ", param)) {
    concat(
      substring(s: body, start: 0, end: length(xs: body) - length(xs: param)),
      arg
    )
  } else {
    body
  }
}

fn body_alpha_equivalent_to_call(
  lhs: String,
  rhs: String,
  fns: List<DualRepFnRecord>
) -> Bool {
  let callee = callee_from_call(operand: lhs)
  let rec = lookup_fn_record(fns: fns, name: callee)
  if is_empty(xs: rec.name) {
    false
  } else {
    let arg = first_arg_from_call(operand: lhs)
    let param = first_param_name(params: rec.params)
    let inlined = if is_empty(xs: param) {
      rec.body
    } else {
      replace_param_in_body(body: rec.body, param: param, arg: arg)
    }
    trim_left(s: rhs) == trim_left(s: inlined)
  }
}

fn classify_eq_site(
  path: String,
  fn_name: String,
  site: EqSite,
  data_inits: List<DualRepDataInit>,
  fns: List<DualRepFnRecord>
) -> List<DualRepViolation> {
  let lhs = trim_left(s: site.lhs)
  let rhs = trim_left(s: site.rhs)
  let lhs_ident = operand_bare_ident(operand: lhs)
  let rhs_ident = operand_bare_ident(operand: rhs)
  if (is_empty(xs: lhs_ident) == false)
    && (is_empty(xs: rhs_ident) == false)
    && (lhs_ident == rhs_ident)
  {
    [
      DualRepViolation {
        path: path,
        fn_name: fn_name,
        kind: SameSymbolEquality
      }
    ]
  } else if is_empty(xs: lhs_ident) == false {
    let rhs_lit = literal_fingerprint_text(lit: rhs)
    let init_lit = lookup_data_literal(data_inits: data_inits, name: lhs_ident)
    if (is_empty(xs: init_lit) == false) && (init_lit == rhs_lit) {
      [
        DualRepViolation {
          path: path,
          fn_name: fn_name,
          kind: DataLiteralMirror
        }
      ]
    } else {
      empty_dual_rep_violations
    }
  } else if operand_is_call(operand: lhs)
    && body_alpha_equivalent_to_call(lhs: lhs, rhs: rhs, fns: fns)
  {
    [
      DualRepViolation {
        path: path,
        fn_name: fn_name,
        kind: BodyAlphaEquivalent
      }
    ]
  } else {
    empty_dual_rep_violations
  }
}

fn expr_after_return(body: String) -> String {
  let trimmed = trim_left(s: body)
  if string_contains(s: trimmed, pattern: "return ") {
    trim_left(s: substring(s: trimmed, start: 7, end: length(xs: trimmed)))
  } else {
    trimmed
  }
}

type DoubleEqIndexState {
  pos: Int
  prev_was_eq: Bool
  found: Int
}

fn index_of_double_eq(s: String) -> Int {
  fold_list(
    xs: s,
    empty: DoubleEqIndexState { pos: 0, prev_was_eq: false, found: -1 },
    cons: fn(state, c) {
      if state.found >= 0 {
        state
      } else if c == 61 && state.prev_was_eq {
        DoubleEqIndexState {
          pos: state.pos + 1,
          prev_was_eq: true,
          found: state.pos - 1
        }
      } else if c == 61 {
        DoubleEqIndexState { pos: state.pos + 1, prev_was_eq: true, found: -1 }
      } else {
        DoubleEqIndexState { pos: state.pos + 1, prev_was_eq: false, found: -1 }
      }
    }
  ).found
}

fn generic_eq_site(expr: String) -> EqSite {
  let idx = index_of_double_eq(s: expr)
  if idx < 0 {
    EqSite { lhs: "", rhs: "" }
  } else {
    EqSite {
      lhs: trim_left(s: substring(s: expr, start: 0, end: idx)),
      rhs: trim_left(
        s: substring(s: expr, start: idx + 2, end: length(xs: expr))
      )
    }
  }
}

fn eq_sites_from_body(body: String) -> List<EqSite> {
  let expr = trim_left(s: expr_after_return(body: body))
  if string_contains(s: expr, pattern: "==") {
    [generic_eq_site(expr: expr)]
  } else {
    empty_eq_sites
  }
}

fn violations_from_body(
  path: String,
  fn_name: String,
  body: String,
  data_inits: List<DualRepDataInit>,
  fns: List<DualRepFnRecord>
) -> List<DualRepViolation> {
  fold_list(
    xs: eq_sites_from_body(body: body),
    empty: empty_dual_rep_violations,
    cons: fn(acc, site) {
      list_append(
        left: acc,
        right: classify_eq_site(
          path: path,
          fn_name: fn_name,
          site: site,
          data_inits: data_inits,
          fns: fns
        )
      )
    }
  )
}

fn dual_rep_violations_from_module(scan: DualRepModuleScan) -> List<DualRepViolation> {
  fold(scan.fns, init: empty_dual_rep_violations, f: fn(acc, rec) {
    if is_empty(xs: rec.name) {
      acc
    } else {
      list_append(
        left: acc,
        right: violations_from_body(
          path: scan.path,
          fn_name: rec.name,
          body: rec.body,
          data_inits: scan.data_inits,
          fns: scan.fns
        )
      )
    }
  })
}

fn dual_rep_violation_count_from_scans(scans: List<DualRepModuleScan>) -> Int {
  length(
    xs: fold_list(
      xs: scans,
      empty: empty_dual_rep_violations,
      cons: fn(acc, scan) {
        list_append(
          left: acc,
          right: dual_rep_violations_from_module(scan: scan)
        )
      }
    )
  )
}

fn dual_rep_clean_holds_for_scans(scans: List<DualRepModuleScan>) -> Bool {
  dual_rep_violation_count_from_scans(scans: scans) == 0
}

fn dual_rep_test_file_count_from_scans(scans: List<DualRepModuleScan>) -> Int {
  length(xs: scans)
}

fn split_lines_finish(state: LineSplitState) -> List<String> {
  if is_empty(xs: state.current) {
    state.lines
  } else {
    list_snoc_item(xs: state.lines, item: state.current)
  }
}

fn content_lines(content: String) -> List<String> {
  split_lines_finish(
    state: fold_list(
      xs: content,
      empty: LineSplitState { lines: [], current: Empty },
      cons: fn(state, c) {
        if c == 10 {
          LineSplitState {
            lines: list_snoc_item(xs: state.lines, item: state.current),
            current: Empty
          }
        } else {
          LineSplitState {
            lines: state.lines,
            current: list_snoc_item(xs: state.current, item: c)
          }
        }
      }
    )
  )
}

fn fn_body_from_decl_line(line: String) -> String {
  if string_contains(s: line, pattern: "{") {
    substring(
      s: line,
      start: index_of_char(line: line, target: 123) + 1,
      end: length(xs: line) - 1
    )
  } else {
    ""
  }
}

fn fn_params_from_decl_line(line: String) -> List<String> {
  if string_contains(s: line, pattern: "(") && string_contains(s: line, pattern: ":") {
    [
      take_ident_prefix(
        s: substring(
          s: line,
          start: index_of_char(line: line, target: 40) + 1,
          end: index_of_char(line: line, target: 58)
        )
      )
    ]
  } else {
    empty_string_list
  }
}

type FnParseState {
  fns: List<DualRepFnRecord>
  current_name: String
  current_params: List<String>
  current_body: String
  in_body: Bool
}

fn fn_parse_init() -> FnParseState {
  FnParseState {
    fns: empty_dual_rep_fns,
    current_name: "",
    current_params: empty_string_list,
    current_body: "",
    in_body: false
  }
}

fn fn_parse_commit(state: FnParseState) -> FnParseState {
  if is_empty(xs: state.current_name) {
    state
  } else {
    FnParseState {
      fns: list_snoc_item(
        xs: state.fns,
        item: DualRepFnRecord {
          name: state.current_name,
          body: state.current_body,
          params: state.current_params
        }
      ),
      current_name: "",
      current_params: empty_string_list,
      current_body: "",
      in_body: false
    }
  }
}

fn fn_parse_step(state: FnParseState, line: String) -> FnParseState {
  if state.in_body {
    if string_contains(s: line, pattern: "}") {
      let committed = fn_parse_commit(
        state: FnParseState {
          fns: state.fns,
          current_name: state.current_name,
          current_params: state.current_params,
          current_body: concat(state.current_body, line),
          in_body: true
        }
      )
      FnParseState {
        fns: committed.fns,
        current_name: "",
        current_params: empty_string_list,
        current_body: "",
        in_body: false
      }
    } else {
      FnParseState {
        fns: state.fns,
        current_name: state.current_name,
        current_params: state.current_params,
        current_body: concat(concat(state.current_body, line), "\n"),
        in_body: true
      }
    }
  } else if line_is_fn_decl(line: line) && string_contains(s: line, pattern: "->") {
    let name = fn_name_from_decl_line(line: line)
    if is_empty(xs: name) {
      state
    } else if string_contains(s: line, pattern: "{") {
      FnParseState {
        fns: state.fns,
        current_name: name,
        current_params: fn_params_from_decl_line(line: line),
        current_body: fn_body_from_decl_line(line: line),
        in_body: string_contains(s: line, pattern: "}") == false
      }
    } else {
      FnParseState {
        fns: state.fns,
        current_name: name,
        current_params: fn_params_from_decl_line(line: line),
        current_body: "",
        in_body: true
      }
    }
  } else {
    state
  }
}

fn parse_fns_from_lines(lines: List<String>) -> List<DualRepFnRecord> {
  fn_parse_commit(
    state: fold_list(
      xs: lines,
      empty: fn_parse_init(),
      cons: fn(state, line) { fn_parse_step(state: state, line: line) }
    )
  ).fns
}

fn dual_rep_parse_module_content(path: String, content: String) -> DualRepModuleScan {
  let lines = content_lines(content: content)
  let data_inits = fold_list(
    xs: lines,
    empty: empty_dual_rep_data_inits,
    cons: fn(acc, line) {
      if line_is_data_decl(line: line) {
        list_snoc_item(xs: acc, item: data_init_from_line(line: line))
      } else {
        acc
      }
    }
  )
  let fns = parse_fns_from_lines(lines: lines)
  DualRepModuleScan {
    path: path,
    data_inits: data_inits,
    fns: fns
  }
}

fn synthetic_same_symbol_scan() -> DualRepModuleScan {
  DualRepModuleScan {
    path: "synthetic/same_symbol_test.dag",
    data_inits: empty_dual_rep_data_inits,
    fns: [
      DualRepFnRecord {
        name: "witness_taut",
        body: "return m == m",
        params: empty_string_list
      }
    ]
  }
}

fn synthetic_literal_mirror_scan() -> DualRepModuleScan {
  DualRepModuleScan {
    path: "synthetic/literal_mirror_test.dag",
    data_inits: [
      DualRepDataInit { name: "ttl", literal_fp: "num:3600" }
    ],
    fns: [
      DualRepFnRecord {
        name: "witness_ttl",
        body: "return ttl == 3600",
        params: empty_string_list
      }
    ]
  }
}

fn synthetic_independent_oracle_scan() -> DualRepModuleScan {
  DualRepModuleScan {
    path: "synthetic/oracle_test.dag",
    data_inits: empty_dual_rep_data_inits,
    fns: [
      DualRepFnRecord {
        name: "oracle",
        body: "return add(a: 2, b: 2) == 4",
        params: empty_string_list
      }
    ]
  }
}

fn synthetic_body_mirror_scan() -> DualRepModuleScan {
  DualRepModuleScan {
    path: "synthetic/body_mirror_test.dag",
    data_inits: empty_dual_rep_data_inits,
    fns: [
      DualRepFnRecord {
        name: "wrapped",
        body: "inner(y: x)",
        params: ["x"]
      },
      DualRepFnRecord {
        name: "inner",
        body: "y",
        params: ["y"]
      },
      DualRepFnRecord {
        name: "witness_wrap",
        body: "return wrapped(x: 1) == inner(y: 1)",
        params: empty_string_list
      }
    ]
  }
}

fn synthetic_distinct_symbol_scan() -> DualRepModuleScan {
  DualRepModuleScan {
    path: "synthetic/distinct_test.dag",
    data_inits: empty_dual_rep_data_inits,
    fns: [
      DualRepFnRecord {
        name: "ok",
        body: "return a == b",
        params: empty_string_list
      }
    ]
  }
}

data parse_path_helper_tautology_source: String = "module t\nfn helper_taut() -> Bool {\n  return m == m\n}\ntest fn witness_calls_helper() -> Bool {\n  helper_taut()\n}\n"

fn parse_path_helper_tautology_scan() -> DualRepModuleScan {
  dual_rep_parse_module_content(
    path: "synthetic/parse_path_helper_tautology_test.dag",
    content: parse_path_helper_tautology_source
  )
}
