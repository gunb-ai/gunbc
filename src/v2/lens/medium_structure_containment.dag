fn char_eq(a: Char, b: Char) -> Bool {
  a == b
}

fn list_contains_str(xs: List<String>, target: String) -> Bool {
  fold_list(
    xs: xs,
    empty: false,
    cons: fn(acc, s) { acc || (s == target) }
  )
}

fn path_has_any_prefix(prefixes: List<String>, path: String) -> Bool {
  fold_list(
    xs: prefixes,
    empty: false,
    cons: fn(acc, p) { acc || is_prefix_of(prefix: p, xs: path, eq: char_eq) }
  )
}

fn path_is_medium_realization_edge(path: String) -> Bool {
  path_has_any_prefix(prefixes: medium_realization_edge_path_prefixes, path: path)
}

fn marker_set(m: MediumMarkers) -> List<String> {
  m.markers
}

fn flatten_marker_rows(rows: List<MediumMarkers>) -> List<String> {
  fold_list(
    xs: rows,
    empty: empty_medium_marker_list,
    cons: fn(acc, m) { list_append(left: acc, right: marker_set(m: m)) }
  )
}

fn all_medium_markers() -> List<String> {
  flatten_marker_rows(rows: medium_syntax_markers)
}

fn is_medium_structure_leak(fact: MediumStructureLeakFact, roster: List<String>) -> Bool {
  (path_is_medium_realization_edge(path: fact.path) == false)
    && (list_contains_str(xs: roster, target: fact.path) == false)
}

fn scan_facts_for_medium_leaks(
  facts: List<MediumStructureLeakFact>,
  roster: List<String>
) -> List<MediumStructureLeak> {
  fold_list(
    xs: facts,
    empty: empty_medium_structure_leaks,
    cons: fn(acc, fact) {
      if is_medium_structure_leak(fact: fact, roster: roster) {
        list_snoc_item(
          xs: acc,
          item: MediumStructureLeak {
            path: fact.path,
            face: fact.face,
            detail: fact.detail
          }
        )
      } else {
        acc
      }
    }
  )
}

fn medium_structure_leak_count(
  facts: List<MediumStructureLeakFact>,
  roster: List<String>
) -> Int {
  length(xs: scan_facts_for_medium_leaks(facts: facts, roster: roster))
}

fn medium_structure_containment_holds(
  facts: List<MediumStructureLeakFact>,
  roster: List<String>
) -> Bool {
  is_empty(xs: scan_facts_for_medium_leaks(facts: facts, roster: roster))
}

fn medium_structure_leak_count_canonical(facts: List<MediumStructureLeakFact>) -> Int {
  medium_structure_leak_count(facts: facts, roster: medium_structure_exception_roster)
}

fn medium_structure_containment_holds_canonical(facts: List<MediumStructureLeakFact>) -> Bool {
  medium_structure_containment_holds(facts: facts, roster: medium_structure_exception_roster)
}

fn medium_structure_leak_count_live(
  emit_roots: List<String>,
  check_roots: List<String>
) -> Int {
  medium_structure_leak_count_canonical(
    facts: medium_structure_leak_facts(
      emit_roots: emit_roots,
      check_roots: check_roots,
      markers: all_medium_markers(),
      emit_fns: emitted_medium_emit_fns,
      string_ops: emitted_medium_string_ops
    )
  )
}

fn medium_structure_containment_clean_live(
  emit_roots: List<String>,
  check_roots: List<String>
) -> Bool {
  medium_structure_containment_holds_canonical(
    facts: medium_structure_leak_facts(
      emit_roots: emit_roots,
      check_roots: check_roots,
      markers: all_medium_markers(),
      emit_fns: emitted_medium_emit_fns,
      string_ops: emitted_medium_string_ops
    )
  )
}

fn medium_structure_containment_witness_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^medium_structure_containment_leak_detected,
    at: Textual { file: ^medium_structure_containment_lens_file, extent: WholeFile },
    correction: Unavailable { reason: AmbiguousIntent }
  }
}

fn medium_structure_containment_witness(
  emit_roots: List<String>,
  check_roots: List<String>
) -> Witness<Bool> {
  if medium_structure_containment_clean_live(
    emit_roots: emit_roots,
    check_roots: check_roots
  ) {
    Holds { value: true }
  } else {
    Violates { diagnostic: medium_structure_containment_witness_diagnostic() }
  }
}

fn medium_structure_containment_canonical_witness() -> Witness<Bool> {
  medium_structure_containment_witness(
    emit_roots: medium_emit_side_scan_roots,
    check_roots: medium_check_side_scan_roots
  )
}

fn medium_structure_check_roots_with_perturb(perturb_roots: List<String>) -> List<String> {
  list_append(left: medium_check_side_scan_roots, right: perturb_roots)
}

fn medium_structure_containment_canonical_with_check_perturb_witness(
  perturb_roots: List<String>
) -> Witness<Bool> {
  medium_structure_containment_witness(
    emit_roots: medium_emit_side_scan_roots,
    check_roots: medium_structure_check_roots_with_perturb(perturb_roots: perturb_roots)
  )
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: RealizationDispatch }
}
