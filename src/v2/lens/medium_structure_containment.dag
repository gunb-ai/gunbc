module v2.lens.medium_structure_containment
import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }
import std.disposition { RealizationDispatch }

import v2.std.algebra {
  fold_list,
  is_empty,
  is_prefix_of,
  length,
  list_append,
  list_snoc_item
}
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { Char, String }

type MediumLeakFace
  = InlineSyntaxLiteral
  | EmittedMediumStringOp

type MediumStructureLeakFact {
  path: String
  face: MediumLeakFace
  detail: String
}

type MediumStructureLeak {
  path: String
  face: MediumLeakFace
  detail: String
}

data empty_medium_structure_leaks: List<MediumStructureLeak> = []

data empty_medium_marker_list: List<String> = []

type MediumMarkers {
  medium: String
  markers: List<String>
}

data grammar_template_markers: List<String> = ["{ret", "{params", "{0", "{1"]

data medium_syntax_markers: List<MediumMarkers> = [

  MediumMarkers { medium: "GitHubActionsExpression", markers: ["${{"] },

  MediumMarkers { medium: "CiYamlStructure", markers: [] },

  MediumMarkers { medium: "ShellInRun", markers: ["#!/", ">/dev/null"] },

  MediumMarkers { medium: "TargetGrammarTemplate", markers: grammar_template_markers }
]

data emitted_medium_emit_fns: List<String> = [
  "expected_ci_yml",
  "ci_yml_drifted",
  "serialize_yaml",
  "serialize_bash",
  "serialize_expression",
  "interpolate",
  "serialize_template",
  "gunbc_ci_workflow_run",
  "gunbc_ci_run_script",
  "scheduler_invoke",
  "git_fetch_script",
  "ci_release_build_script",
  "witness_layer_source_flags",
  "fleet_converge_sh_for",
  "expected_fleet_converge_sh"
]

data emitted_medium_string_ops: List<String> = [
  "string_contains",
  "starts_with",
  "ends_with",
  "substring",
  "char_at"
]

data medium_realization_edge_path_prefixes: List<String> = [
  "dsl/extdeps/github/",
  "src/v2/extdeps/github/",
  "dsl/extdeps/communication/medium.dag",
