fn char_eq(a: Char, b: Char) -> Bool {
  a == b
}

fn list_contains_str(xs: List<String>, target: String) -> Bool {
  fold_list(
    xs: xs,
    empty: false,
    cons: fn(acc, s) { acc || (s == target) }
  )
}

fn path_has_any_prefix(prefixes: List<String>, path: String) -> Bool {
  fold_list(
    xs: prefixes,
    empty: false,
    cons: fn(acc, p) { acc || is_prefix_of(prefix: p, xs: path, eq: char_eq) }
  )
}

fn path_is_medium_realization_edge(path: String) -> Bool {
  path_has_any_prefix(prefixes: medium_realization_edge_path_prefixes, path: path)
}

fn marker_set(m: MediumMarkers) -> List<String> {
  m.markers
}

fn flatten_marker_rows(rows: List<MediumMarkers>) -> List<String> {
  fold_list(
    xs: rows,
    empty: empty_medium_marker_list,
    cons: fn(acc, m) { list_append(left: acc, right: marker_set(m: m)) }
  )
}

fn all_medium_markers() -> List<String> {
  flatten_marker_rows(rows: medium_syntax_markers)
}

fn is_medium_structure_leak(fact: MediumStructureLeakFact, roster: List<String>) -> Bool {
  (path_is_medium_realization_edge(path: fact.path) == false)
    && (list_contains_str(xs: roster, target: fact.path) == false)
}

fn scan_facts_for_medium_leaks(
  facts: List<MediumStructureLeakFact>,
  roster: List<String>
) -> List<MediumStructureLeak> {
  fold_list(
    xs: facts,
    empty: empty_medium_structure_leaks,
    cons: fn(acc, fact) {
      if is_medium_structure_leak(fact: fact, roster: roster) {
        list_snoc_item(
          xs: acc,
          item: MediumStructureLeak {
            path: fact.path,
            face: fact.face,
            detail: fact.detail
          }
        )
      } else {
        acc
      }
    }
  )
}

fn medium_structure_leak_count(
  facts: List<MediumStructureLeakFact>,
  roster: List<String>
) -> Int {
  length(xs: scan_facts_for_medium_leaks(facts: facts, roster: roster))
}

fn medium_structure_containment_holds(
  facts: List<MediumStructureLeakFact>,
  roster: List<String>
) -> Bool {
  is_empty(xs: scan_facts_for_medium_leaks(facts: facts, roster: roster))
}

fn medium_structure_leak_count_canonical(facts: List<MediumStructureLeakFact>) -> Int {
  medium_structure_leak_count(facts: facts, roster: medium_structure_exception_roster)
}

fn medium_structure_containment_holds_canonical(facts: List<MediumStructureLeakFact>) -> Bool {
  medium_structure_containment_holds(facts: facts, roster: medium_structure_exception_roster)
}

fn medium_structure_leak_count_live(
  emit_roots: List<String>,
  check_roots: List<String>
) -> Int {
  medium_structure_leak_count_canonical(
    facts: medium_structure_leak_facts(
      emit_roots: emit_roots,
      check_roots: check_roots,
      markers: all_medium_markers(),
      emit_fns: emitted_medium_emit_fns,
      string_ops: emitted_medium_string_ops
    )
  )
}

fn medium_structure_containment_clean_live(
  emit_roots: List<String>,
  check_roots: List<String>
) -> Bool {
  medium_structure_containment_holds_canonical(
    facts: medium_structure_leak_facts(
      emit_roots: emit_roots,
      check_roots: check_roots,
      markers: all_medium_markers(),
      emit_fns: emitted_medium_emit_fns,
      string_ops: emitted_medium_string_ops
    )
  )
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: RealizationDispatch },
  rationale: "A medium's structure leaking out of a Node into a raw string — written as a grounded-marker literal (emit-side) or grepped over an emitted-medium value (check-side, by call-target provenance) outside the realization edge — is a decidable property; this class is ② (lens residue) ONLY because the media are not all modeled yet, a shrinking-roster ratchet that becomes a pure ① construction wall as each medium becomes a Medium<R> Node. Grounding authority: each medium modeled as a Medium<R> Node emitted via grammar rows (GHA-expr: witty-wolf-587's extdeps.github.expressions / serialize_expression); the §5 realization-vocab guard is the sibling for the imported-sidecar face. Dissolves on: the exception roster empties as each medium is modeled — a check becomes a model walk or unwritable, and authoring or grepping the medium's syntax as a raw string outside the realization edge is then unwritable. The emit-side InlineSyntaxLiteral face is keyed on BOTH medium-syntax markers (for inline literals in any context) AND call-target provenance (string literal arg to an emitted_medium_emit_fn) — fail-closed: a raw string passed into a shell-emitting realization is caught whether or not it carries a recognizable marker. The check-side EmittedMediumStringOp face is structurally grounded by call-target provenance and is fail-closed within its known emit-fn set. The exception roster is the §5-honest residue: known offenders under active modeling (each entry is a shrinking ratchet, not a permanent carve-out). Html medium specifics: Html is enrolled with empty InlineSyntaxLiteral markers (the CiYamlStructure precedent); the check-side EmittedMediumStringOp face is fail-closed for string-ops over serialize_html_source and serialize_fragment outputs; the emit-side provenance scan covers string literals passed directly into serialize_fragment/serialize_html_source, but raw HTML construction that bypasses the serializer (e.g. concat('<p>', x)) remains a residual gap — the real wall for that gap is construction (requiring a structured MarkupNode so a raw string cannot reach the response). Html medium row retires when the gunbhub emission seam requires a structured HTML Node (the Medium<R> dissolution); until then, Html containment is check-side provenance + emit-side provenance for direct serializer calls."
}
