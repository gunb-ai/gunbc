fn char_eq(a: Char, b: Char) -> Bool {
  a == b
}

fn list_contains_str(xs: List<String>, target: String) -> Bool {
  fold_list(
    xs: xs,
    empty: false,
    cons: fn(acc, s) { acc || (s == target) }
  )
}

fn path_has_any_prefix(prefixes: List<String>, path: String) -> Bool {
  fold_list(
    xs: prefixes,
    empty: false,
    cons: fn(acc, p) { acc || is_prefix_of(prefix: p, xs: path, eq: char_eq) }
  )
}

fn path_is_medium_realization_edge(path: String) -> Bool {
  path_has_any_prefix(prefixes: medium_realization_edge_path_prefixes, path: path)
}

fn marker_set(m: MediumMarkers) -> List<String> {
  m.markers
}

fn flatten_marker_rows(rows: List<MediumMarkers>) -> List<String> {
  fold_list(
    xs: rows,
    empty: empty_medium_marker_list,
    cons: fn(acc, m) { list_append(left: acc, right: marker_set(m: m)) }
  )
}

fn all_medium_markers() -> List<String> {
  flatten_marker_rows(rows: medium_syntax_markers)
}

fn is_medium_structure_leak(fact: MediumStructureLeakFact, roster: List<String>) -> Bool {
  (path_is_medium_realization_edge(path: fact.path) == false)
    && (list_contains_str(xs: roster, target: fact.path) == false)
}

fn scan_facts_for_medium_leaks(
  facts: List<MediumStructureLeakFact>,
  roster: List<String>
) -> List<MediumStructureLeak> {
  fold_list(
    xs: facts,
    empty: empty_medium_structure_leaks,
    cons: fn(acc, fact) {
      if is_medium_structure_leak(fact: fact, roster: roster) {
        list_snoc_item(
          xs: acc,
          item: MediumStructureLeak {
            path: fact.path,
            face: fact.face,
            detail: fact.detail
          }
        )
      } else {
        acc
      }
    }
  )
}

fn medium_structure_leak_count(
  facts: List<MediumStructureLeakFact>,
  roster: List<String>
) -> Int {
  length(xs: scan_facts_for_medium_leaks(facts: facts, roster: roster))
}

fn medium_structure_containment_holds(
  facts: List<MediumStructureLeakFact>,
  roster: List<String>
) -> Bool {
  is_empty(xs: scan_facts_for_medium_leaks(facts: facts, roster: roster))
}

fn medium_structure_leak_count_canonical(facts: List<MediumStructureLeakFact>) -> Int {
  medium_structure_leak_count(facts: facts, roster: medium_structure_exception_roster)
}

fn medium_structure_containment_holds_canonical(facts: List<MediumStructureLeakFact>) -> Bool {
  medium_structure_containment_holds(facts: facts, roster: medium_structure_exception_roster)
}

fn medium_structure_leak_count_live(
  emit_roots: List<String>,
  check_roots: List<String>
) -> Int {
  medium_structure_leak_count_canonical(
    facts: medium_structure_leak_facts(
      emit_roots: emit_roots,
      check_roots: check_roots,
      markers: all_medium_markers(),
      emit_fns: emitted_medium_emit_fns,
      string_ops: emitted_medium_string_ops
    )
  )
}

fn medium_structure_containment_clean_live(
  emit_roots: List<String>,
  check_roots: List<String>
) -> Bool {
  medium_structure_containment_holds_canonical(
    facts: medium_structure_leak_facts(
      emit_roots: emit_roots,
      check_roots: check_roots,
      markers: all_medium_markers(),
      emit_fns: emitted_medium_emit_fns,
      string_ops: emitted_medium_string_ops
    )
  )
}

fn grammar_template_containment_clean_live(
  emit_roots: List<String>,
  roster: List<String>
) -> Bool {
  medium_structure_containment_holds(
    facts: medium_structure_leak_facts(
      emit_roots: emit_roots,
      check_roots: empty_medium_marker_list,
      markers: grammar_template_markers,
      emit_fns: emitted_medium_emit_fns,
      string_ops: emitted_medium_string_ops
    ),
    roster: roster
  )
}

fn grammar_template_leak_count_live(
  emit_roots: List<String>,
  roster: List<String>
) -> Int {
  medium_structure_leak_count(
    facts: medium_structure_leak_facts(
      emit_roots: emit_roots,
      check_roots: empty_medium_marker_list,
      markers: grammar_template_markers,
      emit_fns: emitted_medium_emit_fns,
      string_ops: emitted_medium_string_ops
    ),
    roster: roster
  )
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: RealizationDispatch },
  rationale: "A medium's structure leaking out of a Node into a raw string — written as a grounded-marker literal (emit-side) or grepped over an emitted-medium value (check-side, by call-target provenance) outside the realization edge — is a decidable property; this class is ② (lens residue) ONLY because the media are not all modeled yet, a shrinking-roster ratchet that becomes a pure ① construction wall as each medium becomes a Medium<R> Node. Grounding authority: each medium modeled as a Medium<R> Node emitted via grammar rows (GHA-expr: witty-wolf-587's extdeps.github.expressions / serialize_expression); the §5 realization-vocab guard is the sibling for the imported-sidecar face. Dissolves on: the exception roster empties as each medium is modeled — a check becomes a model walk or unwritable, and authoring or grepping the medium's syntax as a raw string outside the realization edge is then unwritable. HONESTY: the emit-side InlineSyntaxLiteral face is MARKER-sampled (fail-open): a shell literal lacking the grounded markers (#!/ or >/dev/null) passes silently. The check-side EmittedMediumStringOp face is structurally grounded by call-target provenance and is fail-closed within its known emit-fn set. The fail-closed hardening path for the emit-side is to ground it on script-emit PROVENANCE — the same emitted_medium_emit_fns list the check-side uses — rather than on markers; green-here does NOT mean no shell literal, only no SAMPLED shell literal. TargetGrammarTemplate (ROW1 of the foreign-medium audit): dsl/std/languages.dag carries ~244 raw target-language grammar TEMPLATE strings ('fn {name}({params}) -> {ret}', 'Vec<{0}>', 'Option<{0}>', 'HashMap<{0}, {1}>') — a §3 FORK of the grounded grammar homes dsl/extdeps/languages/{rust,go,python}/syntax.dag (which carry ExternalAuthority anchors). Markers are the partial placeholder holes '{ret'/'{params'/'{0'/'{1' (matched in both raw escaped source '\\{ret\\}' and parsed value '{ret}'), discriminating to ONLY languages.dag outside the realization edge. STEP 1 (enroll-WITH-ROSTER): languages.dag is rostered as FROZEN debt so the wall is live immediately — reintroducing a grammar template anywhere OFF the realization edge and OFF the roster goes red. Dissolves on (STEP 2, incremental): migrate std.render consumers to read the extdeps/languages/*/syntax.dag homes, delete each migrated template from languages.dag, and shrink the roster by the same sites; when languages.dag no longer carries grammar templates the roster entry is removed and the medium is a pure construction wall. HONESTY: emit-side InlineSyntaxLiteral remains MARKER-sampled (fail-open); the fail-closed-by-provenance hardening for this medium awaits the post-#5776 provenance-keyed emit-side"
}
