fn roster_growth_ratchet_holds(live_size: Int, baseline: Int) -> Bool {
  live_size <= baseline
}

fn medium_structure_exception_roster_size() -> Int {
  length(xs: medium_structure_exception_roster)
}

fn medium_structure_roster_growth_ratchet_holds() -> Bool {
  roster_growth_ratchet_holds(
    live_size: medium_structure_exception_roster_size(),
    baseline: medium_structure_exception_roster_size_baseline
  )
}

fn list_contains_str(xs: List<String>, target: String) -> Bool {
  fold_list(
    xs: xs,
    empty: false,
    cons: fn(acc, s) { acc || (s == target) }
  )
}

fn fact_in_gated_scope(fact: RawLiteralPartsFact, roster: List<String>) -> Bool {
  list_contains_str(xs: roster, target: fact.path) == false
}

fn raw_fact_is_violation(fact: RawLiteralPartsFact, roster: List<String>) -> Bool {
  fact_in_gated_scope(fact: fact, roster: roster)
    && disposition_is_violation(d: classify_raw_literal_fact(fact: fact))
}

fn raw_fact_is_ambiguous(fact: RawLiteralPartsFact, roster: List<String>) -> Bool {
  fact_in_gated_scope(fact: fact, roster: roster)
    && disposition_is_ambiguous(d: classify_raw_literal_fact(fact: fact))
}

fn count_violations(facts: List<RawLiteralPartsFact>, roster: List<String>) -> Int {
  fold_list(
    xs: facts,
    empty: 0,
    cons: fn(acc, fact) { if raw_fact_is_violation(fact: fact, roster: roster) { acc + 1 } else { acc } }
  )
}

fn count_ambiguous(facts: List<RawLiteralPartsFact>, roster: List<String>) -> Int {
  fold_list(
    xs: facts,
    empty: 0,
    cons: fn(acc, fact) { if raw_fact_is_ambiguous(fact: fact, roster: roster) { acc + 1 } else { acc } }
  )
}

fn medium_structure_violation_count(
  facts: List<RawLiteralPartsFact>,
  roster: List<String>
) -> Int {
  count_violations(facts: facts, roster: roster)
}

fn medium_structure_ambiguous_count(
  facts: List<RawLiteralPartsFact>,
  roster: List<String>
) -> Int {
  count_ambiguous(facts: facts, roster: roster)
}

fn medium_structure_containment_holds(
  facts: List<RawLiteralPartsFact>,
  roster: List<String>
) -> Bool {
  medium_structure_violation_count(facts: facts, roster: roster) == 0
}

fn medium_structure_violation_count_canonical(facts: List<RawLiteralPartsFact>) -> Int {
  medium_structure_violation_count(facts: facts, roster: medium_structure_exception_roster)
}

fn medium_structure_containment_holds_canonical(facts: List<RawLiteralPartsFact>) -> Bool {
  medium_structure_containment_holds(facts: facts, roster: medium_structure_exception_roster)
}

fn raw_literal_parts_facts_live(roots: List<String>) -> List<RawLiteralPartsFact> {
  medium_structure_literal_parts_facts(roots: roots, targets: medium_bash_sink_targets)
}

fn medium_structure_violation_count_live(roots: List<String>) -> Int {
  medium_structure_violation_count_canonical(
    facts: raw_literal_parts_facts_live(roots: roots)
  )
}

fn medium_structure_ambiguous_count_live(roots: List<String>) -> Int {
  medium_structure_ambiguous_count(
    facts: raw_literal_parts_facts_live(roots: roots),
    roster: medium_structure_exception_roster
  )
}

fn medium_structure_containment_clean_live(roots: List<String>) -> Bool {
  medium_structure_containment_holds_canonical(
    facts: raw_literal_parts_facts_live(roots: roots)
  )
}

fn medium_structure_containment_witness_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^medium_structure_containment_leak_detected,
    at: Textual { file: ^medium_structure_containment_lens_file, extent: WholeFile },
    correction: Unavailable { reason: AmbiguousIntent }
  }
}

fn medium_structure_containment_witness(roots: List<String>) -> Witness<Bool> {
  if medium_structure_containment_clean_live(roots: roots) {
    Holds { value: true }
  } else {
    Violates { diagnostic: medium_structure_containment_witness_diagnostic() }
  }
}

fn medium_structure_containment_canonical_witness() -> Witness<Bool> {
  medium_structure_containment_witness(roots: medium_bash_scan_roots)
}

fn medium_structure_scan_roots_with_perturb(perturb_roots: List<String>) -> List<String> {
  list_append(left: medium_bash_scan_roots, right: perturb_roots)
}

fn medium_structure_containment_canonical_with_perturb_witness(
  perturb_roots: List<String>
) -> Witness<Bool> {
  medium_structure_containment_witness(
    roots: medium_structure_scan_roots_with_perturb(perturb_roots: perturb_roots)
  )
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: RealizationDispatch }
}
