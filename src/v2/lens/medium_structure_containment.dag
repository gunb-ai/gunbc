module v2.lens.medium_structure_containment
import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }
import std.disposition { RealizationDispatch }

import v2.std.algebra {
  fold_list,
  is_empty,
  is_prefix_of,
  length,
  list_append,
  list_snoc_item
}
import v2.std.collection { List }
import v2.std.diagnostic {
  AmbiguousIntent,
  Diagnostic,
  Textual,
  Unavailable,
  WholeFile
}
import v2.std.logic { Bool }
import v2.std.text { Char, String }
import v2.std.witness { Holds, Violates, Witness }

type MediumLeakFace
  = InlineSyntaxLiteral
  | EmittedMediumStringOp

type MediumStructureLeakFact {
  path: String
  face: MediumLeakFace
  detail: String
}

type MediumStructureLeak {
  path: String
  face: MediumLeakFace
  detail: String
}

data empty_medium_structure_leaks: List<MediumStructureLeak> = []

data empty_medium_marker_list: List<String> = []

type MediumMarkers {
  medium: String
  markers: List<String>
}

data medium_syntax_markers: List<MediumMarkers> = [

  MediumMarkers { medium: "GitHubActionsExpression", markers: ["${{"] },

  MediumMarkers { medium: "CiYamlStructure", markers: [] },

  MediumMarkers { medium: "ShellInRun", markers: ["#!/", ">/dev/null"] },

  MediumMarkers { medium: "Html", markers: [] }
]

