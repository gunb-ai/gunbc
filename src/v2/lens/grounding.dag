module v2.lens.grounding


import gunbc.ci_layer_roots { witness_layer_roots }
import v2.std.algebra { fold_list, is_empty, is_prefix_of, length, list_snoc_item }
import v2.std.collection { List }
import v2.std.integer { Int }
import v2.std.logic { Bool }
import v2.std.text { Char, String }
import v2.std.concept_index {
  ConceptByName,
  ConceptDecl,
  ConceptStruct,
  FieldRef,
  QualifiedConcept,
  build_concept_name_index,
  concept_decl_facts,
  concept_from_decl
}
import v2.std.node { Node }
import v2.std.node_query {
  coproduct_arm_list_from_node,
  coproduct_arm_payload_pair_from_arm,
  node_is_coproduct
}
import v2.lens.common.construction_justification { ConstructionJustification, RatchetForever }

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: RatchetForever
}



fn lower_code(c: Int) -> Int {
  if (c >= 65) && (c <= 90) { c + 32 } else { c }
}

fn empty_ints() -> List<Int> {
  []
}

fn norm_whole(s: String) -> List<Int> {
  fold_list(xs: s, empty: empty_ints(), cons: fn(acc, c) {
    if c == 95 { acc } else { list_snoc_item(xs: acc, item: lower_code(c: c)) }
  })
}

fn norm_head(s: String) -> List<Int> {
  fold_list(xs: s, empty: empty_ints(), cons: fn(acc, c) {
    if c == 95 { empty_ints() } else { list_snoc_item(xs: acc, item: lower_code(c: c)) }
  })
}

fn char_eq(a: Char, b: Char) -> Bool {
  a == b
}



type GroundingWorklistEntry {
  enclosing: String
  field: String
  declared_type: String
  coincides_with: String
  target_kind: String
  target_structure: String
  qualified_name: String
  sibling_variant_names: String
  has_unrecognized_sibling: Bool
  sibling_decode_optional: Bool
}

fn is_bare_string(type_name: String) -> Bool {
  (type_name == "String") || (type_name == "NonEmptyStr")
}

fn name_coincides(field: String, concept_name: String) -> Bool {
  let cn = norm_whole(s: concept_name)
  (norm_whole(s: field) == cn) || (norm_head(s: field) == cn)
}

fn str_starts_with(s: String, prefix: String) -> Bool {
  is_prefix_of(prefix: prefix, xs: s, eq: char_eq)
}

fn name_has_unrecognized_prefix(name: String) -> Bool {
  str_starts_with(s: name, prefix: "Unrecognized")
    || str_starts_with(s: name, prefix: "NonExternal")
    || str_starts_with(s: name, prefix: "Non")
}

fn sibling_variant_names(node: Node) -> String {
  if !node_is_coproduct(node: node) {
    ""
  } else {
    fold(coproduct_arm_list_from_node(node: node), init: "", f: fn(acc, arm) {
      let pair = coproduct_arm_payload_pair_from_arm(arm: arm)
      let piece = "{pair.label}"
      if acc == "" { piece } else { concat(acc, concat(", ", piece)) }
    })
  }
}

fn sibling_has_unrecognized_variant(node: Node) -> Bool {
  if !node_is_coproduct(node: node) {
    false
  } else {
    fold(coproduct_arm_list_from_node(node: node), init: false, f: fn(acc, arm) {
      let pair = coproduct_arm_payload_pair_from_arm(arm: arm)
      acc || name_has_unrecognized_prefix(name: "{pair.label}")
    })
  }
}

fn sibling_decode_optional_present(node: Node) -> Bool {
  if !node_is_coproduct(node: node) {
    false
  } else {
    fold(coproduct_arm_list_from_node(node: node), init: false, f: fn(acc, arm) {
      let pair = coproduct_arm_payload_pair_from_arm(arm: arm)
      acc || str_starts_with(s: "{pair.payload_type_name}", prefix: "Optional")
    })
  }
}

fn matched_fields(name: String, idx: List<QualifiedConcept>) -> List<FieldRef> {
  fold(idx, init: [], f: fn(acc, qc) {
    if qc.concept.name == name { qc.concept.fields } else { acc }
  })
}

fn render_members(fields: List<FieldRef>) -> String {
  fold(fields, init: "", f: fn(acc, fr) {
    if acc == "" { "{fr.field}: {fr.type_name}" } else { "{acc}, {fr.field}: {fr.type_name}" }
  })
}

fn target_kind_of(fields: List<FieldRef>) -> String {
  if is_empty(xs: fields) {
    "Unstructured (no named members in the index -- a string alias / opaque / external registry; verify openness with the judge)"
  } else {
    "Structured (named members below; check they are the RIGHT concept for this field, not a coincidental name)"
  }
}

fn first_coincident_target(
  field: String,
  enclosing: String,
  index: List<ConceptByName>
) -> QualifiedConcept {
  fold(index, init: QualifiedConcept {
    qualified_name: "",
    concept: ConceptStruct { name: "", fields: [] }
  }, f: fn(acc, bucket) {
    if acc.qualified_name != "" {
      acc
    } else if name_coincides(field: field, concept_name: bucket.name) {
      fold(bucket.concepts, init: acc, f: fn(best, qc) {
        if best.qualified_name != "" {
          best
        } else if qc.concept.name == enclosing {
          best
        } else {
          qc
        }
      })
    } else {
      acc
    }
  })
}

fn entry_from_match(
  enclosing_qc: QualifiedConcept,
  decl_node: Node,
  field: String,
  declared_type: String,
  matched: QualifiedConcept,
  all_concepts: List<QualifiedConcept>
) -> GroundingWorklistEntry {
  let mf = matched_fields(name: matched.concept.name, idx: all_concepts)
  GroundingWorklistEntry {
    enclosing: enclosing_qc.concept.name,
    field: field,
    declared_type: declared_type,
    coincides_with: matched.qualified_name,
    target_kind: target_kind_of(fields: mf),
    target_structure: render_members(fields: mf),
    qualified_name: enclosing_qc.qualified_name,
    sibling_variant_names: sibling_variant_names(node: decl_node),
    has_unrecognized_sibling: sibling_has_unrecognized_variant(node: decl_node),
    sibling_decode_optional: sibling_decode_optional_present(node: decl_node)
  }
}

fn candidates_of_decl(
  decl: ConceptDecl,
  index: List<ConceptByName>,
  all_concepts: List<QualifiedConcept>,
  acc0: List<GroundingWorklistEntry>
) -> List<GroundingWorklistEntry> {
  let enclosing_qc = concept_from_decl(decl: decl)
  fold(enclosing_qc.concept.fields, init: acc0, f: fn(acc, fr) {
    if is_bare_string(type_name: fr.type_name) {
      let matched = first_coincident_target(
        field: fr.field,
        enclosing: enclosing_qc.concept.name,
        index: index
      )
      if matched.qualified_name == "" {
        acc
      } else {
        list_snoc_item(
          xs: acc,
          item: entry_from_match(
            enclosing_qc: enclosing_qc,
            decl_node: decl.node,
            field: fr.field,
            declared_type: fr.type_name,
            matched: matched,
            all_concepts: all_concepts
          )
        )
      }
    } else {
      acc
    }
  })
}

fn candidates_from_decls(
  decls: List<ConceptDecl>,
  all_concepts: List<QualifiedConcept>
) -> List<GroundingWorklistEntry> {
  let index = build_concept_name_index(idx: all_concepts)
  fold(decls, init: [], f: fn(acc, decl) {
    candidates_of_decl(decl: decl, index: index, all_concepts: all_concepts, acc0: acc)
  })
}

fn candidates_over_decls(decls: List<ConceptDecl>) -> List<GroundingWorklistEntry> {
  let all_concepts = enumerate_concepts_from_decls(decls: decls)
  candidates_from_decls(decls: decls, all_concepts: all_concepts)
}

fn enumerate_concepts_from_decls(decls: List<ConceptDecl>) -> List<QualifiedConcept> {
  fold(decls, init: [], f: fn(acc, decl) {
    list_snoc_item(xs: acc, item: concept_from_decl(decl: decl))
  })
}

fn whole_tree_extract_smoke() -> Bool {
  let decls = concept_decl_facts(pool_roots: witness_layer_roots)
  (length(xs: decls) > 1000)
    && (length(xs: candidates_over_decls(decls: decls)) > 0)
}

fn candidates_in(pool_roots: List<String>) -> List<GroundingWorklistEntry> {
  let decls = concept_decl_facts(pool_roots: pool_roots)
  let all_concepts = enumerate_concepts_from_decls(decls: decls)
  candidates_from_decls(decls: decls, all_concepts: all_concepts)
}

fn candidates() -> List<GroundingWorklistEntry> {
  candidates_in(pool_roots: witness_layer_roots)
}

fn worklist() -> List<GroundingWorklistEntry> {
  candidates()
}
