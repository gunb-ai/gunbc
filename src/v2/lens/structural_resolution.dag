// src/v2/lens/structural_resolution.dag
//
// Scope: structural resolution lens — binding status from InferredTree + dependency_lens.
// Anchor: https://en.wikipedia.org/wiki/Name_resolution_(programming_languages)
//
// Status: per-edge classification-family ratchet — projection-only over `List<DependencyView>` via
//   parametric `ClassifiedDependencyView<StructuralResolutionStatus>`; per-node
//   `InferredFacts` read at classify time via `tree.facts.lookup(usage_site)`, not
//   stored on the row (parallel-payload dissolution).


module v2.lens.structural_resolution

import v2.compiler.infer {
  InferredFacts,
  InferredTree,
  infer_facts_lookup_miss
}
import v2.std.algebra { bag_eq, list_snoc_item }
import v2.compiler.resolve {
  resolve_reason_unbound_symbol
}
import v2.std.collection { List }
import v2.std.dependency {
  ClassifiedDependencyView,
  DependencyKindClassifier,
  DependencyView,
  classify_dependency_kind,
  classified_dependency_view_eq,
  dependency_lens
}
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.witness { Holds, Violates, Witness }

// 🟢 projection carrier: binding status is computed from
// `dependency.kind` + `usage_site` `Witness<InferredFacts>`; not
// authored as a parallel substrate tag. Variants are irreducible use-site
// outcomes (`BindingResolved` / `UnboundSymbolAtUse` / lookup-miss /
// fail-closed infer witness / out-of-scope dependency kind for this lens).
type StructuralResolutionStatus
  = BindingResolved
  | UnboundSymbolAtUse
  | FactsLookupMiss
  | UnresolvedInferWitness
  | OutOfScopeDependencyKind

// 🟡 coproduct dissolution — feature:structural-resolution-kind-policy-axis — consumer:structural_resolution_status_for_view — dissolve-on-arrival: substrate variant-tag partition primitive replaces lens-local policy axis.
type StructuralResolutionKindPolicy
  = ReadsBindingFacts
  | OutOfScopeForStructuralResolution

type StructuralResolutionFact {
  dependencies: List<ClassifiedDependencyView<StructuralResolutionStatus>>
}

fn inferred_facts_for_node(tree: InferredTree, node: Node) -> Witness<InferredFacts> {
  tree.facts.lookup(node)
}

// 🟡 staged — dissolve-on: resolve→infer witness bridge lands resolve Violates on fact table.
// BindsTo status reads infer/resolve witnesses at the use site, not declaration facts.
// BindingResolved on `Holds` means use-site infer succeeded structurally only — not that resolve
// stamped the symbol; until inline resolve stamps, treat as staged posture not load-bearing.
fn status_for_binding_facts(usage_site_facts: Witness<InferredFacts>) -> StructuralResolutionStatus {
  match usage_site_facts {
    Violates { diagnostic: d } =>
      if d.reason == resolve_reason_unbound_symbol {
        UnboundSymbolAtUse
      } else if d.reason == infer_facts_lookup_miss {
        FactsLookupMiss
      } else {
        UnresolvedInferWitness
      }
    Holds { value: _ } => BindingResolved
  }
}

fn structural_resolution_dependency_kind_classifier() -> DependencyKindClassifier<StructuralResolutionKindPolicy> {
  DependencyKindClassifier {
    contains: OutOfScopeForStructuralResolution,
    binds_to: ReadsBindingFacts,
    type_depends_on: OutOfScopeForStructuralResolution,
    data_depends_on: OutOfScopeForStructuralResolution,
    effect_depends_on: OutOfScopeForStructuralResolution,
    resource_depends_on: OutOfScopeForStructuralResolution,
    module_depends_on: OutOfScopeForStructuralResolution,
    barrier_before: OutOfScopeForStructuralResolution,
    placement_depends_on: OutOfScopeForStructuralResolution,
    model_depends_on: OutOfScopeForStructuralResolution,
    projection_depends_on: OutOfScopeForStructuralResolution,
    generated_from: OutOfScopeForStructuralResolution,
    verified_by: OutOfScopeForStructuralResolution,
    promoted_by: OutOfScopeForStructuralResolution,
    bootstrap_depends_on: OutOfScopeForStructuralResolution
  }
}

fn structural_resolution_status_for_policy(
  policy: StructuralResolutionKindPolicy,
  usage_site_facts: Witness<InferredFacts>
) -> StructuralResolutionStatus {
  match policy {
    ReadsBindingFacts => status_for_binding_facts(usage_site_facts: usage_site_facts)
    OutOfScopeForStructuralResolution => OutOfScopeDependencyKind
  }
}

fn structural_resolution_status_for_view(
  tree: InferredTree,
  view: DependencyView
) -> StructuralResolutionStatus {
  structural_resolution_status_for_policy(
    policy: classify_dependency_kind(
      classifier: structural_resolution_dependency_kind_classifier(),
      kind: view.kind
    ),
    usage_site_facts: inferred_facts_for_node(tree: tree, node: view.usage_site)
  )
}

fn structural_resolution_classify(
  tree: InferredTree,
  view: DependencyView
) -> ClassifiedDependencyView<StructuralResolutionStatus> {
  ClassifiedDependencyView {
    dependency: view,
    classification: structural_resolution_status_for_view(tree: tree, view: view)
  }
}

fn structural_resolution_fact(
  tree: InferredTree,
  dependencies: List<DependencyView>
) -> StructuralResolutionFact {
  StructuralResolutionFact {
    dependencies: fold(dependencies, init: [], f: fn(acc, view) {
      list_snoc_item(xs: acc, item: structural_resolution_classify(tree: tree, view: view))
    })
  }
}

fn fact(tree: InferredTree, dependencies: List<DependencyView>) -> StructuralResolutionFact {
  structural_resolution_fact(tree: tree, dependencies: dependencies)
}

fn witness(tree: InferredTree, dependencies: List<DependencyView>) -> Witness<StructuralResolutionFact> {
  Holds {
    value: fact(tree: tree, dependencies: dependencies)
  }
}

fn at(tree: InferredTree) -> Witness<StructuralResolutionFact> {
  witness(tree: tree, dependencies: dependency_lens(root: tree.root))
}

fn fact_projects_status(fact: StructuralResolutionFact, expected: StructuralResolutionStatus) -> Bool {
  fold(fact.dependencies, init: false, f: fn(acc, dep) {
    acc || (dep.classification == expected)
  })
}

fn fact_single_dependency_projects_status(
  fact: StructuralResolutionFact,
  expected: StructuralResolutionStatus
) -> Bool {
  if count(fact.dependencies) != 1 {
    false
  } else {
    fold(fact.dependencies, init: false, f: fn(_acc, dep) {
      dep.classification == expected
    })
  }
}

fn structural_resolution_status_eq(
  a: StructuralResolutionStatus,
  b: StructuralResolutionStatus
) -> Bool {
  a == b
}

fn structural_resolution_classified_eq(
  a: ClassifiedDependencyView<StructuralResolutionStatus>,
  b: ClassifiedDependencyView<StructuralResolutionStatus>
) -> Bool {
  classified_dependency_view_eq(
    a: a,
    b: b,
    classification_eq: structural_resolution_status_eq
  )
}

// 🟡 gated — feature:T-13-lens-claim-equality-scaffold
// dissolve-on-arrival: generated TestClaim supplies canonical
// equality or content_hash for lens facts; multiset compare is compile-only until B2.
fn fact_eq(a: StructuralResolutionFact, b: StructuralResolutionFact) -> Bool {
  bag_eq(xs: a.dependencies, ys: b.dependencies, eq: structural_resolution_classified_eq)
}
