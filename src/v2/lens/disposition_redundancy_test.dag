module v2.test.lens_disposition_redundancy.disposition_redundancy_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = ReadsLiveTree

data redundancy_present_successor_locator: std.decl_ref.DeclarationRef = std.decl_ref.DeclarationRef {
  module_path: "std.disposition",
  decl_name: "Disposition",
  field: std.decl_ref.NamedField { field_name: "marker" }
}

data redundancy_red_scaffold: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "std.disposition",
    decl_name: "Disposition",
    field: std.decl_ref.NamedField { field_name: "marker" }
  }
}

data redundancy_red_dispositions: List<std.disposition.Disposition> = [redundancy_red_scaffold]
data redundancy_present_with_successor: List<std.decl_ref.DeclarationRef> = [redundancy_present_successor_locator]
data redundancy_present_empty: List<std.decl_ref.DeclarationRef> = []

data redundancy_region1_real_successor_present: List<std.decl_ref.DeclarationRef> = [
  std.decl_ref.DeclarationRef {
    module_path: "extdeps.llm.anthropic",
    decl_name: "AnthropicTextBlock",
    field: std.decl_ref.NamedField { field_name: "cache_control" }
  }
]

test fn redundancy_red_control_fires_when_successor_present() -> Bool {
  disposition_redundancy_violation_count(
    dispositions: redundancy_red_dispositions,
    present: redundancy_present_with_successor
  ) == 1
}

test fn redundancy_red_control_flips_green_when_successor_absent() -> Bool {
  disposition_redundancy_violation_count(
    dispositions: redundancy_red_dispositions,
    present: redundancy_present_empty
  ) == 0
}

test fn redundancy_region1_anthropic_green_against_nonmatching_present() -> Bool {
  disposition_redundancy_violation_count(
    dispositions: extdeps.llm.anthropic.structural_coverage_gap_anthropic_tool_result_nested_block_wire_payloads,
    present: redundancy_present_with_successor
  ) == 0
}

test fn redundancy_region1_anthropic_marks_nonempty() -> Bool {
  length(xs: extdeps.llm.anthropic.structural_coverage_gap_anthropic_tool_result_nested_block_wire_payloads) > 0
}

test fn redundancy_region1_fires_when_a_real_mark_successor_present() -> Bool {
  disposition_redundancy_violation_count(
    dispositions: extdeps.llm.anthropic.structural_coverage_gap_anthropic_tool_result_nested_block_wire_payloads,
    present: redundancy_region1_real_successor_present
  ) == 1
}

data redundancy_region_bytes_marks: List<std.disposition.Disposition> = [
  std.bytes.bytes_seam_host_realization_marker,
  std.encoding.utf8_decode_bytes_host_realization_marker,
  std.encoding.base64_group_fill_carrier_debt_marker
]

data redundancy_region_bytes_synthetic_present: List<std.decl_ref.DeclarationRef> = [
  std.decl_ref.DeclarationRef {
    module_path: "std.bytes",
    decl_name: "builtin_function_registry",
    field: std.decl_ref.WholeDeclaration
  }
]

test fn redundancy_region_bytes_marks_nonempty() -> Bool {
  length(xs: redundancy_region_bytes_marks) > 0
}

test fn redundancy_region_bytes_green_against_nonmatching() -> Bool {
  disposition_redundancy_violation_count(
    dispositions: redundancy_region_bytes_marks,
    present: redundancy_present_with_successor
  ) == 0
}

test fn redundancy_region_bytes_fires_on_builtin_registry_present() -> Bool {
  disposition_redundancy_violation_count(
    dispositions: redundancy_region_bytes_marks,
    present: redundancy_region_bytes_synthetic_present
  ) == 2
}

data redundancy_region_budget_marks: List<std.disposition.Disposition> = [
  gunbc.ci_floor_measurement.gunbc_ci_managed_host_fixed_overhead_disposition,
  gunbc.ci_floor_measurement.gunbc_ci_legacy_host_fixed_overhead_disposition,
  gunbc.ci_floor_measurement.gunbc_ci_concurrent_runs_conservative_high_disposition
]

data redundancy_region_budget_split_note: String = "The budget region tracked ONE fixed-overhead scaffold bound to gunbc_ci_per_service_overhead until 2026-08-05, when that number split into a measured bound for the managed hosts and an operator allowance for the legacy pair (gunbc.ci_floor_measurement gunbc_ci_host_fixed_overhead_kind_note). Two facts, two closure conditions, two successors — so the region carries both marks and the locator below names the MANAGED successor specifically.\n\nThat specificity is the point of the control rather than an accident of which one was picked: with both marks in the region and only one successor present, a lens that ignored the bind and merely counted scaffolds would report 2 and fail. The expectation stays 1, so the test still discriminates bind-matching from mark-counting — which is the property the original single-mark version could not distinguish."

data redundancy_region_budget_per_service_overhead_locator: std.decl_ref.DeclarationRef = std.decl_ref.DeclarationRef {
  module_path: "gunbc.ci_floor_measurement",
  decl_name: "gunbc_ci_managed_host_quiescent_meminfo_read",
  field: std.decl_ref.WholeDeclaration
}

test fn redundancy_region_budget_marks_nonempty() -> Bool {
  length(xs: redundancy_region_budget_marks) > 0
}

test fn redundancy_region_budget_green_against_nonmatching() -> Bool {
  disposition_redundancy_violation_count(
    dispositions: redundancy_region_budget_marks,
    present: redundancy_present_with_successor
  ) == 0
}

test fn redundancy_region_budget_fires_on_per_service_overhead_present() -> Bool {
  disposition_redundancy_violation_count(
    dispositions: redundancy_region_budget_marks,
    present: [redundancy_region_budget_per_service_overhead_locator]
  ) == 1
}

