module v2.test.lens_complexity_lowering.loop_invariant_hoist


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn leaf(id: v2.std.node.Symbol) -> Node {
  node_synthetic(kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } }, children: [])
}

data quadratic_cost: v2.lens.cost.SymbolicCost = v2.lens.cost.ProductCost {
  lhs: v2.lens.cost.LinearCost { variable: v2.lens.cost.SizeVariable { source: leaf(id: ^outer) } },
  rhs: v2.lens.cost.LinearCost { variable: v2.lens.cost.SizeVariable { source: leaf(id: ^inner) } }
}
data linear_cost: v2.lens.cost.SymbolicCost = v2.lens.cost.LinearCost { variable: v2.lens.cost.SizeVariable { source: leaf(id: ^single) } }
data sum_cost: v2.lens.cost.SymbolicCost = v2.lens.cost.SumCost {
  lhs: v2.lens.cost.LinearCost { variable: v2.lens.cost.SizeVariable { source: leaf(id: ^a) } },
  rhs: v2.lens.cost.LinearCost { variable: v2.lens.cost.SizeVariable { source: leaf(id: ^b) } }
}

test fn quadratic_is_lowerable() -> Bool {
  cost_is_lowerable(c: quadratic_cost)
}
test fn quadratic_minimizes_strictly_below_realized() -> Bool {
  asymptotic_class_dominates(
    a: asymptotic_class_of_cost(cost: quadratic_cost),
    b: minimized_class(c: quadratic_cost)
  )
  && !asymptotic_class_dominates(
    a: minimized_class(c: quadratic_cost),
    b: asymptotic_class_of_cost(cost: quadratic_cost)
  )
}

test fn lowerable_matches_before_class() -> Bool {
  cost_class_is_lowerable(cls: v2.lens.cost.ClassPolynomial { degree: polynomial_degree_two() })
}
test fn linear_class_not_lowerable() -> Bool {
  !cost_class_is_lowerable(cls: ClassLinear)
}

test fn linear_not_lowerable() -> Bool {
  !cost_is_lowerable(c: linear_cost)
}
test fn sum_of_linears_not_lowerable() -> Bool {
  !cost_is_lowerable(c: sum_cost)
}
test fn linear_minimized_unchanged() -> Bool {
  asymptotic_class_dominates(
    a: minimized_class(c: linear_cost),
    b: asymptotic_class_of_cost(cost: linear_cost)
  )
  && asymptotic_class_dominates(
    a: asymptotic_class_of_cost(cost: linear_cost),
    b: minimized_class(c: linear_cost)
  )
}
