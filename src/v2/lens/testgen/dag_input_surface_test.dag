module v2.test.lens_testgen.dag_input_surface

import v2.lens.testgen {
  Generator,
  LanguageBehaviorEquivalence,
  TestgenConcept,
  bootstrap_claim_generator_for_manual_anchor,
  lbe_frozen_snapshot_conj_dag_surface,
  lbe_frozen_snapshot_disj_dag_surface,
  lbe_frozen_snapshot_transform_dag_surface,
  lbe_io_mock_conj_dag_surface,
  lbe_io_mock_disj_dag_surface,
  lbe_io_mock_transform_dag_surface,
  lbe_subject_conj_dag_surface,
  lbe_subject_disj_dag_surface,
  lbe_subject_transform_dag_surface,
  testgen_scheduled_language_behavior_generators
}
import v2.std.algebra { any, for_all, length }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  ManualLbeConjDagSurface,
  TestClaimCompilesClaimVariant,
  TestClassification,
  TestClaim,
  Tier1,
  Unit,
  manual_claim_anchor,
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}
import v2.test.manual.connective_anchors {
  stub_empty_conj,
  stub_empty_disj,
  stub_empty_transform
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn language_behavior_generator_uses_conj_dag_input(g: Generator<TestgenConcept>) -> Bool {
  match g.slot {
    LanguageBehaviorEquivalence { subject, mock } =>
      subject == lbe_subject_conj_dag_surface() &&
        subject.language == ^dag_language_model_surface_id &&
        mock == lbe_io_mock_conj_dag_surface() &&
        mock.snapshot == lbe_frozen_snapshot_conj_dag_surface() &&
        mock.snapshot.language == ^dag_language_model_surface_id &&
        mock.snapshot.input_node == stub_empty_conj &&
        mock.snapshot.expected_value == stub_empty_conj
    _ => false
  }
}

fn language_behavior_generator_uses_disj_dag_input(g: Generator<TestgenConcept>) -> Bool {
  match g.slot {
    LanguageBehaviorEquivalence { subject, mock } =>
      subject == lbe_subject_disj_dag_surface() &&
        subject.language == ^dag_language_model_surface_id &&
        mock == lbe_io_mock_disj_dag_surface() &&
        mock.snapshot == lbe_frozen_snapshot_disj_dag_surface() &&
        mock.snapshot.language == ^dag_language_model_surface_id &&
        mock.snapshot.input_node == stub_empty_disj &&
        mock.snapshot.expected_value == stub_empty_disj
    _ => false
  }
}

fn language_behavior_generator_uses_transform_dag_input(g: Generator<TestgenConcept>) -> Bool {
  match g.slot {
    LanguageBehaviorEquivalence { subject, mock } =>
      subject == lbe_subject_transform_dag_surface() &&
        subject.language == ^dag_language_model_surface_id &&
        mock == lbe_io_mock_transform_dag_surface() &&
        mock.snapshot == lbe_frozen_snapshot_transform_dag_surface() &&
        mock.snapshot.language == ^dag_language_model_surface_id &&
        mock.snapshot.input_node == stub_empty_transform &&
        mock.snapshot.expected_value == stub_empty_transform
    _ => false
  }
}

fn language_behavior_generator_uses_dag_input(g: Generator<TestgenConcept>) -> Bool {
  language_behavior_generator_uses_conj_dag_input(g: g) ||
    language_behavior_generator_uses_disj_dag_input(g: g) ||
    language_behavior_generator_uses_transform_dag_input(g: g)
}

test fn scheduled_language_behavior_generators_cover_dag_inputs() -> Bool {
  let scheduled = testgen_scheduled_language_behavior_generators()
  length(xs: scheduled) == 3 &&
    for_all(
      xs: scheduled,
      predicate: fn(g) { language_behavior_generator_uses_dag_input(g: g) }
    ) &&
    any(
      xs: scheduled,
      predicate: fn(g) { language_behavior_generator_uses_conj_dag_input(g: g) }
    ) &&
    any(
      xs: scheduled,
      predicate: fn(g) { language_behavior_generator_uses_disj_dag_input(g: g) }
    ) &&
    any(
      xs: scheduled,
      predicate: fn(g) { language_behavior_generator_uses_transform_dag_input(g: g) }
    )
}

test fn bootstrap_generator_has_conj_dag_input_surface() -> Bool {
  match bootstrap_claim_generator_for_manual_anchor(key: ManualLbeConjDagSurface) {
    Accepted { value: g, diagnostics: _ } =>
      g.kind == TestClaimCompilesClaimVariant &&
        g.classification == TestClassification { tier: Tier1, layer: Unit } &&
        g.anchor == manual_claim_anchor(anchor: ManualLbeConjDagSurface) &&
        language_behavior_generator_uses_conj_dag_input(g: g)
    Rejected { diagnostics: _ } => false
  }
}


