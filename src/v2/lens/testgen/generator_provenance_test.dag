module v2.test.lens_testgen.generator_provenance

import v2.lens.testgen { scheduled_generators_carry_provenance }
import v2.std.logic { Bool }
import v2.std.node { Atom, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClassification,
  TestClaim,
  Tier1,
  Unit,
  manual_claim_anchor,
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly
fn lens_testgen_generator_provenance_marker_node(marker: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: marker } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}



data witness_lens_testgen_scheduled_generators_carry_provenance_green: Bool = scheduled_generators_carry_provenance()
