// src/v2/lens/idempotency.dag
// Scope: idempotency lens — algebraic-law-derived; redundant ops collapse structurally (idempotency + cancellation + redundancy = algebraic simplification).
// Status: per-edge classification-family ratchet — projection-only over `List<DependencyView>` via parametric `ClassifiedDependencyView<IdempotencyVerdict>`; no copied endpoints, no nested per-row EffectDependencyFact (parallel-payload vs typed-reference). The algebra-law witness is the verdict payload itself; the dependency-edge identity authority is `ClassifiedDependencyView.dependency`.


module v2.lens.idempotency
import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }

import v2.compiler.infer { InferredFacts, InferredTree }
import v2.std.algebra { bag_eq, list_snoc_item }
import v2.std.collection {
  List,
  Optional,
  optional_absent,
  optional_prefer_first_present,
  optional_present,
  optional_present_witness
}
import v2.std.dependency {
  ClassifiedDependencyView,
  DependencyKindClassifier,
  DependencyView,
  classify_dependency_view,
  classified_dependency_view_eq
}
import v2.std.diagnostic {
  AmbiguousIntent,
  Diagnostic,
  Textual,
  Unavailable,
  WholeFile
}
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.witness { Holds, Violates, Witness }
// 🟢 lens classification — dependency-edge alone never proves the positive
// algebraic law, so `RequiresAlgebraWitness` is the fail-closed default;
// `AlgebraicIdempotenceProven` carries the typed law witness on the row.
type IdempotencyVerdict
  = AlgebraicIdempotenceProven { law: Witness<InferredFacts> }
  | RequiresAlgebraWitness

type IdempotencyFact {
  dependencies: List<ClassifiedDependencyView<IdempotencyVerdict>>
}

fn idempotency_dependency_kind_classifier() -> DependencyKindClassifier<IdempotencyVerdict> {
  DependencyKindClassifier {
    contains: RequiresAlgebraWitness,
    binds_to: RequiresAlgebraWitness,
    type_depends_on: RequiresAlgebraWitness,
    data_depends_on: RequiresAlgebraWitness,
    effect_depends_on: RequiresAlgebraWitness,
    resource_depends_on: RequiresAlgebraWitness,
    module_depends_on: RequiresAlgebraWitness,
    barrier_before: RequiresAlgebraWitness,
    placement_depends_on: RequiresAlgebraWitness,
    model_depends_on: RequiresAlgebraWitness,
    projection_depends_on: RequiresAlgebraWitness,
    generated_from: RequiresAlgebraWitness,
    verified_by: RequiresAlgebraWitness,
    promoted_by: RequiresAlgebraWitness,
    bootstrap_depends_on: RequiresAlgebraWitness
  }
}

fn idempotency_classify(view: DependencyView) -> ClassifiedDependencyView<IdempotencyVerdict> {
  classify_dependency_view(classifier: idempotency_dependency_kind_classifier(), view: view)
}

fn idempotency_fact(tree: InferredTree, dependencies: List<DependencyView>) -> IdempotencyFact {
  IdempotencyFact {
    dependencies: fold(dependencies, init: [], f: fn(acc, view) {
      list_snoc_item(xs: acc, item: idempotency_classify(view: view))
    })
  }
}

// 🟡 gated — predicate-dissolution interim — feature:T-13-idempotency-verdict-unresolved — dissolve-on-arrival: substrate projects IdempotencyVerdict resolved/unresolved from coproduct; forbidden: parallel ad-hoc IdempotencyVerdict Bool predicates outside idempotency_witness.
fn idempotency_verdict_unresolved(verdict: IdempotencyVerdict) -> Bool {
  match verdict {
    RequiresAlgebraWitness => true
    AlgebraicIdempotenceProven { law: law } =>
      match law {
        Holds { value: _ } => false
        Violates { diagnostic: _ } => true
      }
  }
}

fn idempotency_first_law_violation_diagnostic(fact: IdempotencyFact) -> Optional<Diagnostic> {
  fold(fact.dependencies, init: optional_absent(), f: fn(acc, dep) {
    optional_prefer_first_present(
      left: acc,
      right: match dep.classification {
        AlgebraicIdempotenceProven { law: Violates { diagnostic: d } } =>
          optional_present(value: d)
        _ => optional_absent()
      }
    )
  })
}

fn idempotency_fact_unresolved(fact: IdempotencyFact) -> Bool {
  fold(fact.dependencies, init: false, f: fn(acc, dep) {
    acc || idempotency_verdict_unresolved(verdict: dep.classification)
  })
}

fn idempotency_witness_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^idempotency_reason_unresolved_projection,
    at: Textual { file: ^idempotency_projection_virtual_file, extent: WholeFile },
    correction: Unavailable { reason: AmbiguousIntent }
  }
}

fn idempotency_witness(tree: InferredTree, dependencies: List<DependencyView>) -> Witness<IdempotencyFact> {
  let fact = idempotency_fact(tree: tree, dependencies: dependencies)
  let law_diagnostic = idempotency_first_law_violation_diagnostic(fact: fact)
  match optional_present_witness(opt: law_diagnostic) {
    Holds { value: d } =>
      Violates { diagnostic: d }
    Violates { diagnostic: _ } =>
      if idempotency_fact_unresolved(fact: fact) {
        Violates { diagnostic: idempotency_witness_diagnostic() }
      } else {
        Holds { value: fact }
      }
  }
}

fn idempotency_verdict_eq(a: IdempotencyVerdict, b: IdempotencyVerdict) -> Bool {
  match a {
    AlgebraicIdempotenceProven { law: a_law } => match b {
      AlgebraicIdempotenceProven { law: b_law } => a_law == b_law
      _ => false
    }
    RequiresAlgebraWitness => match b {
      RequiresAlgebraWitness => true
      _ => false
    }
  }
}

fn idempotency_classified_eq(
  a: ClassifiedDependencyView<IdempotencyVerdict>,
  b: ClassifiedDependencyView<IdempotencyVerdict>
) -> Bool {
  classified_dependency_view_eq(a: a, b: b, classification_eq: idempotency_verdict_eq)
}

fn idempotency_fact_eq(a: IdempotencyFact, b: IdempotencyFact) -> Bool {
  bag_eq(xs: a.dependencies, ys: b.dependencies, eq: idempotency_classified_eq)
}

// Construction-justification (DESIGN sec 5/sec 6, ROADMAP sec 0): why this is a lens
// (validation) and not construction. Layered ON TOP of the #5433 inert-lens backstop.
data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding {
    grounding_authority: "algebraic simplification -- idempotent/cancellation/redundancy collapse derived from the algebra (the per-edge classification becoming substrate)",
    dissolve_on: "redundant ops collapse structurally by the algebra law, not flagged by a lens"
  },
  rationale: "Idempotency/cancellation is algebraic-law-derived and decidable per edge; the lens is a ratchet until the collapse is a structural construction over the closed algebra."
}
