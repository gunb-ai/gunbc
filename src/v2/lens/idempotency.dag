module v2.lens.idempotency


type IdempotencyFact {
  dependencies: List<v2.std.dependency.ClassifiedDependencyView<v2.lens.common.algebraic_composition.IdempotencyVerdict>>
}

fn idempotency_classify(view: v2.std.dependency.DependencyView) -> v2.std.dependency.ClassifiedDependencyView<v2.lens.common.algebraic_composition.IdempotencyVerdict> {
  classify_dependency_view(classifier: idempotency_classifier, view: view)
}

fn idempotency_fact(tree: v2.compiler.inferred_tree.InferredTree, dependencies: List<v2.std.dependency.DependencyView>) -> IdempotencyFact {
  IdempotencyFact {
    dependencies: fold(dependencies, init: [], f: fn(acc, view) {
      list_snoc_item(xs: acc, item: idempotency_classify(view: view))
    })
  }
}

fn idempotency_verdict_unresolved(verdict: v2.lens.common.algebraic_composition.IdempotencyVerdict) -> Bool {
  match verdict {
    RequiresAlgebraWitness => true
    AlgebraicIdempotenceProven { law: law } =>
      match law {
        Holds { value: _ } => false
        Violates { diagnostic: _ } => true
      }
  }
}

fn idempotency_first_law_violation_diagnostic(fact: IdempotencyFact) -> Optional<v2.std.diagnostic.Diagnostic> {
  fold(fact.dependencies, init: optional_absent(), f: fn(acc, dep) {
    optional_prefer_first_present(
      left: acc,
      right: match dep.classification {
        AlgebraicIdempotenceProven { law: Violates { diagnostic: d } } =>
          optional_present(value: d)
        _ => optional_absent()
      }
    )
  })
}

fn idempotency_fact_unresolved(fact: IdempotencyFact) -> Bool {
  fold(fact.dependencies, init: false, f: fn(acc, dep) {
    acc || idempotency_verdict_unresolved(verdict: dep.classification)
  })
}

fn idempotency_witness_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^idempotency_reason_unresolved_projection,
    at: v2.std.diagnostic.Textual { file: ^idempotency_projection_virtual_file, extent: WholeFile },
    correction: v2.std.diagnostic.Unavailable { reason: AmbiguousIntent }
  }
}

fn idempotency_witness(tree: v2.compiler.inferred_tree.InferredTree, dependencies: List<v2.std.dependency.DependencyView>) -> Witness<IdempotencyFact> {
  let fact = idempotency_fact(tree: tree, dependencies: dependencies)
  let law_diagnostic = idempotency_first_law_violation_diagnostic(fact: fact)
  match optional_present_witness(opt: law_diagnostic) {
    Holds { value: d } =>
      v2.std.witness.Violates { diagnostic: d }
    Violates { diagnostic: _ } =>
      if idempotency_fact_unresolved(fact: fact) {
        v2.std.witness.Violates { diagnostic: idempotency_witness_diagnostic() }
      } else {
        v2.std.witness.Holds { value: fact }
      }
  }
}

fn idempotency_verdict_eq(a: v2.lens.common.algebraic_composition.IdempotencyVerdict, b: v2.lens.common.algebraic_composition.IdempotencyVerdict) -> Bool {
  match a {
    AlgebraicIdempotenceProven { law: a_law } => match b {
      AlgebraicIdempotenceProven { law: b_law } => a_law == b_law
      _ => false
    }
    RequiresAlgebraWitness => match b {
      RequiresAlgebraWitness => true
      _ => false
    }
  }
}

fn idempotency_classified_eq(
  a: v2.std.dependency.ClassifiedDependencyView<v2.lens.common.algebraic_composition.IdempotencyVerdict>,
  b: v2.std.dependency.ClassifiedDependencyView<v2.lens.common.algebraic_composition.IdempotencyVerdict>
) -> Bool {
  classified_dependency_view_eq(a: a, b: b, classification_eq: idempotency_verdict_eq)
}

fn idempotency_fact_eq(a: IdempotencyFact, b: IdempotencyFact) -> Bool {
  bag_eq(xs: a.dependencies, ys: b.dependencies, eq: idempotency_classified_eq)
}

data construction_justification: v2.lens.common.construction_justification.ConstructionJustification = v2.lens.common.construction_justification.ConstructionJustification {
  class: v2.lens.common.construction_justification.WallAfterGrounding { dissolves_to: SingleAuthority }
}
