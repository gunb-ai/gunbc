module v2.test.lens_effect.effect_depends_on

import v2.compiler.infer { InferredFacts, InferredTree }
import v2.compiler.eval {
  EvalContext,
  TestClaimEvalSubject,
  TestClaimRun,
  eval_context_with_semantics,
  eval_diagnostic,
  eval_test_claim_subject,
  run_test_claim
}
import v2.lens.effect {
  EffectClassification,
  EffectFact,
  effect_fact,
  effect_fact_eq,
  effect_witness
}
import v2.std.dependency {
  ClassifiedDependencyView,
  DependencyView,
  EffectDependsOn
}
import v2.std.collection { List }
import v2.std.diagnostic { Accepted, Outcome, Rejected, None, diagnostics_singleton }
import v2.std.logic { Bool }
import v2.std.node { Atom, ComputationNode, Edge, Named, Node, Symbol, TypeNode, Value, SyntheticOccurrence }
import v2.std.runtime {
  BindInterpreter,
  BranchInterpreter,
  Continue,
  ControlTransfer,
  EnvironmentBindingKey,
  EvaluationEnvironment,
  InterpretationAlgebra,
  InterpretationStructureWitness,
  LoopInterpreter,
  RuntimeUnit,
  RuntimeUnitValue,
  RuntimeValue,
  TransformInterpreter,
  ValueInterpreter
}
import v2.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v2.std.witness { Violates, Witness }
import v2.test.lens_common.infer_fixture {
  claim_atom_node,
  claim_inferred_facts,
  claim_inferred_tree
}

data effect_child: Node = claim_atom_node(s: ^effect_child_symbol)

data effect_root: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^effect_root_symbol } },
  children: [
    Edge { label: Named { name: ^effect_edge_symbol }, target: effect_child }
  ],
  occurrence_id: SyntheticOccurrence
}

data effect_dependency: DependencyView = DependencyView {
  source: effect_root,
  dependent: effect_child,
  kind: EffectDependsOn,
  usage_site: effect_child
}

fn effect_claim_facts() -> InferredFacts {
  claim_inferred_facts(
    type_symbol: ^effect_type_symbol,
    algebra_symbol: ^effect_algebra_symbol,
    descent_symbol: ^effect_descent_symbol,
  )
}

fn effect_claim_tree() -> InferredTree {
  claim_inferred_tree(root: effect_root, facts: effect_claim_facts())
}

type LensEffectClaim {
  input: InferredTree
  expected: EffectFact
  actual: Witness<EffectFact>
}

data effect_depends_on_claim: LensEffectClaim = LensEffectClaim {
  input: effect_claim_tree(),
  expected: EffectFact {
    dependencies: [
      ClassifiedDependencyView {
        dependency: effect_dependency,
        classification: EffectClassification {}
      }
    ]
  },
  actual: effect_witness(tree: effect_claim_tree(), dependencies: [effect_dependency])
}

fn effect_depends_on_claim_holds() -> Bool {
  match effect_depends_on_claim.actual {
    Violates { diagnostic: _ } =>
      effect_fact_eq(
        a: effect_fact(
          tree: effect_depends_on_claim.input,
          dependencies: [effect_dependency]
        ),
        b: effect_depends_on_claim.expected
      )
    _ => false
  }
}

data effect_depends_on_claim_passes: Bool = effect_depends_on_claim_holds()

fn lens_effect_marker_node(marker: Symbol) -> Node {
  Node {
    kind: ComputationNode { behavior: Value },
    children: [
      Edge {
        label: Named { name: marker },
        target: effect_root
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn effect_depends_on_claim_expected_node() -> Node {
  if effect_depends_on_claim_holds() {
    lens_effect_marker_node(marker: ^effect_claim_pass_symbol)
  } else {
    lens_effect_marker_node(marker: ^effect_claim_fail_symbol)
  }
}

fn effect_runtime_type_node() -> Node {
  claim_atom_node(s: ^effect_type_symbol)
}

fn effect_runtime_unit(node: Node) -> RuntimeValue {
  RuntimeUnit {
    value: RuntimeUnitValue { unit_type: effect_runtime_type_node() }
  }
}

fn effect_allocate_literal(node: Node, _env: EvaluationEnvironment) -> Outcome<RuntimeValue> {
  Accepted { value: effect_runtime_unit(node: node), diagnostics: None }
}

fn effect_reject_runtime(node: Node) -> Outcome<RuntimeValue> {
  Rejected {
    diagnostics: diagnostics_singleton(
      d: eval_diagnostic(reason: ^effect_runtime_rejected, node: node)
    )
  }
}

fn effect_call_primitive(
  node: Node,
  _args: List<RuntimeValue>,
  _env: EvaluationEnvironment
) -> Outcome<RuntimeValue> {
  effect_reject_runtime(node: node)
}

fn effect_choose_branch(
  node: Node,
  _value: RuntimeValue,
  _env: EvaluationEnvironment
) -> Outcome<Node> {
  Rejected {
    diagnostics: diagnostics_singleton(
      d: eval_diagnostic(reason: ^effect_runtime_rejected, node: node)
    )
  }
}

fn effect_step_loop(node: Node, _env: EvaluationEnvironment) -> Outcome<ControlTransfer> {
  Accepted { value: Continue { value: effect_runtime_unit(node: node) }, diagnostics: None }
}

fn effect_bind_value(
  _key: EnvironmentBindingKey,
  _value: RuntimeValue,
  env: EvaluationEnvironment
) -> Outcome<EvaluationEnvironment> {
  Accepted { value: env, diagnostics: None }
}

fn effect_interpretation() -> InterpretationAlgebra {
  InterpretationAlgebra {
    value: ValueInterpreter { allocate_literal: effect_allocate_literal },
    transform: TransformInterpreter { call_primitive: effect_call_primitive },
    branch: BranchInterpreter { choose_branch: effect_choose_branch },
    loop: LoopInterpreter { step_loop: effect_step_loop },
    bind: BindInterpreter { bind_value: effect_bind_value },
    match: MatchInterpreter { choose_arm: runtime_reject_match_arm }
  }
}

fn effect_interpretation_structure_witness() -> InterpretationStructureWitness {
  InterpretationStructureWitness {
    allocate_literal: ^effect_allocate_literal_sym,
    call_primitive: ^effect_call_primitive_sym,
    choose_branch: ^effect_choose_branch_sym,
    step_loop: ^effect_step_loop_sym,
    bind_value: ^effect_bind_value_sym,
    choose_arm: ^runtime_reject_match_arm
  }
}

fn effect_context() -> EvalContext {
  eval_context_with_semantics(
    runtime_identity: ^effect_interpretation_pin,
    interpretation: effect_interpretation(),
    structure_witness: effect_interpretation_structure_witness()
  )
}

data claim_lens_effect_depends_on_runtime_verdict: TestClaim = EqualsClaim {
  label: "lens_effect/effect_depends_on routes through run_test_claim",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: lens_effect_marker_node(marker: ^effect_claim_pass_symbol),
  rhs: effect_depends_on_claim_expected_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data subject_lens_effect_depends_on_runtime_verdict: TestClaimEvalSubject<Node> = eval_test_claim_subject(
  claim: claim_lens_effect_depends_on_runtime_verdict,
  context: effect_context(),
  tree: effect_claim_tree(),
  evaluator_pin: ^effect_evaluator_pin
)

data run_lens_effect_depends_on_runtime_verdict: TestClaimRun<Node, RuntimeValue> = run_test_claim(
  subject: subject_lens_effect_depends_on_runtime_verdict
)