// src/v2/lens/content_unit_affected/witness.dag
// Discriminating witnesses (DESIGN §5 — green by execution, RED on wrong behavior) that a
// rust crate, modeled via the crate-grounded derivation, participates in the canonical
// affected-set lens by the CONTENT of its DERIVED file set:
//   - UNCHANGED crate → prunes (purity oracle: content-identical replay re-executes nothing).
//   - CONTENT change (a file's digest drifts) → not pruned, enters the frontier.
//   - ADD-TARGET (add a Bin target, all digests unchanged) → the derived file set GAINS
//     src/bin/{name}.rs via `cargo_target_source_path`, the fingerprint changes, unit enters
//     the frontier. THE proof that the file set DERIVES from the crate, not a declared list.
//   - MONOLITH new file (a new .rs appears in the host crate_dir glob) → fingerprint changes.
//   - peer isolation: a drifted crate reruns while an unchanged peer prunes — content-keyed,
//     no path list consulted.
//
// host inputs (per-file digests, the monolith dir-glob, the manifest file set) are TEST DATA
// here standing for the gate's disk reads (§3(b) seam).

module v2.test.lens_content_unit_affected.witness

import v2.std.algebra { length }
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v2.std.witness { Holds }
import v2.lens.affected_set { ChangedSubgraphFrontier }
import v2.lens.affected_set_examples {
  affected_set_claim_failure_node,
  affected_set_example_node
}
import v2.lens.content_unit_affected { content_unit_frontier }
import v2.lens.rust_crate_content_unit { rust_crate_content_unit }
import v2.std.content_unit { ContentUnit }
import extdeps.cargo { CargoTarget, Lib, Bin }
import std.types { FilePathParts }

// Host digest functions (test data standing for disk reads). `cu_dig_base` gives every file
// the same baseline digest; `cu_dig_lib_edited` drifts only src/lib.rs (a content edit).
fn cu_dig_base(path: String) -> Symbol { ^cu_dig_base_v1 }
fn cu_dig_lib_edited(path: String) -> Symbol {
  if path == "src/lib.rs" { ^cu_dig_lib_v2 } else { ^cu_dig_base_v1 }
}

data cu_manifest: FilePathParts = FilePathParts { segments: ["Cargo.toml"] }
data cu_monolith_new_file: FilePathParts = FilePathParts { segments: ["src", "v1_new_module.rs"] }

// Baseline crate: package "v1-compiler", one Lib target + the manifest, all baseline digests.
fn cu_crate_baseline() -> ContentUnit {
  rust_crate_content_unit(
    identity: ^cu_crate_main,
    package_name: "v1-compiler",
    targets: [Lib],
    extra_files: [cu_manifest],
    digest_of: cu_dig_base
  )
}

// Same crate, one file's CONTENT edited (src/lib.rs digest drifts).
fn cu_crate_content_edited() -> ContentUnit {
  rust_crate_content_unit(
    identity: ^cu_crate_main,
    package_name: "v1-compiler",
    targets: [Lib],
    extra_files: [cu_manifest],
    digest_of: cu_dig_lib_edited
  )
}

// Same crate with a Bin target ADDED (digests unchanged) — derivation gains src/bin/helper.rs.
fn cu_crate_added_bin() -> ContentUnit {
  rust_crate_content_unit(
    identity: ^cu_crate_main,
    package_name: "v1-compiler",
    targets: [Lib, Bin { name: "helper" }],
    extra_files: [cu_manifest],
    digest_of: cu_dig_base
  )
}

// Same crate with a new .rs appearing in the host crate_dir glob (monolith case).
fn cu_crate_monolith_grown() -> ContentUnit {
  rust_crate_content_unit(
    identity: ^cu_crate_main,
    package_name: "v1-compiler",
    targets: [Lib],
    extra_files: [cu_manifest, cu_monolith_new_file],
    digest_of: cu_dig_base
  )
}

// A second, independent crate (for peer isolation).
fn cu_crate_peer(digest_of: fn(String) -> Symbol) -> ContentUnit {
  rust_crate_content_unit(
    identity: ^cu_crate_peer,
    package_name: "v1-stage0-core",
    targets: [Lib],
    extra_files: [cu_manifest],
    digest_of: digest_of
  )
}

// An unchanged crate prunes: exactly one boundary exclusion.
fn cu_unchanged_crate_prunes() -> Bool {
  match content_unit_frontier(baseline: [cu_crate_baseline()], current: [cu_crate_baseline()]) {
    Holds { value: ChangedSubgraphFrontier { boundary_exclusions: boundary_exclusions, decisions: _ } } =>
      length(xs: boundary_exclusions) == 1
    _ => false
  }
}

// A content edit (file digest drift) is NOT pruned.
fn cu_content_edit_enters_frontier() -> Bool {
  match content_unit_frontier(baseline: [cu_crate_baseline()], current: [cu_crate_content_edited()]) {
    Holds { value: ChangedSubgraphFrontier { boundary_exclusions: boundary_exclusions, decisions: _ } } =>
      length(xs: boundary_exclusions) == 0
    _ => false
  }
}

// Adding a Bin TARGET (digests unchanged) changes the DERIVED file set → not pruned. The proof
// the file set derives from the crate's targets, not a hand-declared list.
fn cu_added_target_enters_frontier() -> Bool {
  match content_unit_frontier(baseline: [cu_crate_baseline()], current: [cu_crate_added_bin()]) {
    Holds { value: ChangedSubgraphFrontier { boundary_exclusions: boundary_exclusions, decisions: _ } } =>
      length(xs: boundary_exclusions) == 0
    _ => false
  }
}

// A new .rs in the monolith crate_dir glob changes the fingerprint → not pruned.
fn cu_monolith_new_file_enters_frontier() -> Bool {
  match content_unit_frontier(baseline: [cu_crate_baseline()], current: [cu_crate_monolith_grown()]) {
    Holds { value: ChangedSubgraphFrontier { boundary_exclusions: boundary_exclusions, decisions: _ } } =>
      length(xs: boundary_exclusions) == 0
    _ => false
  }
}

// Peer isolation: baseline {main, peer}; current {main, peer'} where only the peer's content
// drifted. main prunes (one boundary exclusion), peer reruns — content-keyed, no path list.
fn cu_drifted_peer_reruns_unchanged_main_prunes() -> Bool {
  match content_unit_frontier(
    baseline: [cu_crate_baseline(), cu_crate_peer(digest_of: cu_dig_base)],
    current: [cu_crate_baseline(), cu_crate_peer(digest_of: cu_dig_lib_edited)]
  ) {
    Holds { value: ChangedSubgraphFrontier { boundary_exclusions: boundary_exclusions, decisions: _ } } =>
      length(xs: boundary_exclusions) == 1
    _ => false
  }
}

fn content_unit_affected_witnesses() -> Bool {
  cu_unchanged_crate_prunes()
    && cu_content_edit_enters_frontier()
    && cu_added_target_enters_frontier()
    && cu_monolith_new_file_enters_frontier()
    && cu_drifted_peer_reruns_unchanged_main_prunes()
}

fn cu_unchanged_crate_prunes_rhs() -> Node {
  if cu_unchanged_crate_prunes() { affected_set_example_node } else { affected_set_claim_failure_node }
}

fn cu_content_edit_enters_frontier_rhs() -> Node {
  if cu_content_edit_enters_frontier() { affected_set_example_node } else { affected_set_claim_failure_node }
}

fn cu_added_target_enters_frontier_rhs() -> Node {
  if cu_added_target_enters_frontier() { affected_set_example_node } else { affected_set_claim_failure_node }
}

fn cu_monolith_new_file_enters_frontier_rhs() -> Node {
  if cu_monolith_new_file_enters_frontier() { affected_set_example_node } else { affected_set_claim_failure_node }
}

fn cu_drifted_peer_reruns_unchanged_main_prunes_rhs() -> Node {
  if cu_drifted_peer_reruns_unchanged_main_prunes() { affected_set_example_node } else { affected_set_claim_failure_node }
}

data claim_cu_unchanged_crate_prunes: TestClaim = EqualsClaim {
  label: "lens_content_unit_affected/unchanged_crate_prunes: content-identical crate prunes (purity oracle)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: affected_set_example_node,
  rhs: cu_unchanged_crate_prunes_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_cu_content_edit_enters_frontier: TestClaim = EqualsClaim {
  label: "lens_content_unit_affected/content_edit_enters_frontier: a file content edit (digest drift) is not pruned",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: affected_set_example_node,
  rhs: cu_content_edit_enters_frontier_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_cu_added_target_enters_frontier: TestClaim = EqualsClaim {
  label: "lens_content_unit_affected/added_target_enters_frontier: adding a Bin target changes the DERIVED file set (files derive from the crate)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: affected_set_example_node,
  rhs: cu_added_target_enters_frontier_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_cu_monolith_new_file_enters_frontier: TestClaim = EqualsClaim {
  label: "lens_content_unit_affected/monolith_new_file_enters_frontier: a new .rs in the crate_dir glob changes the fingerprint",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: affected_set_example_node,
  rhs: cu_monolith_new_file_enters_frontier_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_cu_drifted_peer_reruns_unchanged_main_prunes: TestClaim = EqualsClaim {
  label: "lens_content_unit_affected/peer_isolation: drifted peer crate reruns, unchanged peer prunes — content-keyed, no path list",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: affected_set_example_node,
  rhs: cu_drifted_peer_reruns_unchanged_main_prunes_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
