module v2.test.lens_synthesis.constant_not_dominated_by_linear


data synthesis_const_x: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^synthesis_const_x_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn constant_not_dominated_by_linear_claim_holds() -> Bool {
  !symbolic_cost_dominates(
    a: unit_cost(),
    b: LinearCost { variable: SizeVariable { source: synthesis_const_x } }
  )
}

fn constant_not_dominated_by_linear_claim_rhs() -> Node {
  if constant_not_dominated_by_linear_claim_holds() {
    synthesis_const_x
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_constant_not_dominated_by_linear: TestClaim = EqualsClaim {
  label: "lens_synthesis/constant_not_dominated_by_linear: constant not dominated by linear",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: synthesis_const_x,
  rhs: constant_not_dominated_by_linear_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
