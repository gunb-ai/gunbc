module v2.test.lens_synthesis.factorial_dominates_exponential


data synthesis_fact_x: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^synthesis_fact_x_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn factorial_dominates_exponential_claim_holds() -> Bool {
  symbolic_cost_dominates(
    a: v2.lens.cost.FactorialCost { variable: v2.lens.cost.SizeVariable { source: synthesis_fact_x } },
    b: v2.lens.cost.ExponentialCost {
      variable: v2.lens.cost.SizeVariable { source: synthesis_fact_x },
      base: v2.lens.cost.ExponentialBase { predecessor_after_one: v2.std.cardinality.NonZeroNat { prev: Zero } }
    }
  )
}

fn factorial_dominates_exponential_claim_rhs() -> Node {
  if factorial_dominates_exponential_claim_holds() {
    synthesis_fact_x
  } else {
    v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_factorial_dominates_exponential: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "lens_synthesis/factorial_dominates_exponential: factorial dominates exponential",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: synthesis_fact_x,
  rhs: factorial_dominates_exponential_claim_rhs(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
