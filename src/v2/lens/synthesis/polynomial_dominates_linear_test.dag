module v2.test.lens_synthesis.polynomial_dominates_linear

import v2.lens.cost {
  LinearCost,
  PolynomialCost,
  PolynomialDegree,
  SizeVariable,
  symbolic_cost_dominates
}
import v2.std.cardinality { NonZeroNat }
import v2.std.logic { Bool }
import std.nat { Zero }
import v2.std.node { Atom, Conj, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly
data synthesis_poly_x: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^synthesis_poly_x_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data synthesis_poly_y: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^synthesis_poly_y_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

test fn polynomial_dominates_linear_claim_holds() -> Bool {
  symbolic_cost_dominates(
    a: PolynomialCost {
      variable: SizeVariable { source: synthesis_poly_x },
      degree: PolynomialDegree { predecessor_after_linear: NonZeroNat { prev: Zero } }
    },
    b: LinearCost { variable: SizeVariable { source: synthesis_poly_y } }
  )
}


