module v2.test.lens_synthesis.exponential_dominates_polynomial


data synthesis_exp_x: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^synthesis_exp_x_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn exponential_dominates_polynomial_claim_holds() -> Bool {
  symbolic_cost_dominates(
    a: v2.lens.cost.ExponentialCost {
      variable: v2.lens.cost.SizeVariable { source: synthesis_exp_x },
      base: v2.lens.cost.ExponentialBase { predecessor_after_one: v2.std.cardinality.NonZeroNat { prev: Zero } }
    },
    b: v2.lens.cost.PolynomialCost {
      variable: v2.lens.cost.SizeVariable { source: synthesis_exp_x },
      degree: v2.lens.cost.PolynomialDegree { predecessor_after_linear: v2.std.cardinality.NonZeroNat { prev: Zero } }
    }
  )
}

fn exponential_dominates_polynomial_claim_rhs() -> Node {
  if exponential_dominates_polynomial_claim_holds() {
    synthesis_exp_x
  } else {
    v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_exponential_dominates_polynomial: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "lens_synthesis/exponential_dominates_polynomial: exponential dominates polynomial",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: synthesis_exp_x,
  rhs: exponential_dominates_polynomial_claim_rhs(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
