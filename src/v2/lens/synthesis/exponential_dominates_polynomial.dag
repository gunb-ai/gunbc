module v2.test.lens_synthesis.exponential_dominates_polynomial


data synthesis_exp_x: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^synthesis_exp_x_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn exponential_dominates_polynomial_claim_holds() -> Bool {
  symbolic_cost_dominates(
    a: ExponentialCost {
      variable: SizeVariable { source: synthesis_exp_x },
      base: ExponentialBase { predecessor_after_one: NonZeroNat { prev: Zero } }
    },
    b: PolynomialCost {
      variable: SizeVariable { source: synthesis_exp_x },
      degree: PolynomialDegree { predecessor_after_linear: NonZeroNat { prev: Zero } }
    }
  )
}

fn exponential_dominates_polynomial_claim_rhs() -> Node {
  if exponential_dominates_polynomial_claim_holds() {
    synthesis_exp_x
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_exponential_dominates_polynomial: TestClaim = EqualsClaim {
  label: "lens_synthesis/exponential_dominates_polynomial: exponential dominates polynomial",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: synthesis_exp_x,
  rhs: exponential_dominates_polynomial_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
