module v2.test.lens_synthesis.linear_not_dominated_by_polynomial

import v2.lens.cost {
  LinearCost,
  PolynomialCost,
  PolynomialDegree,
  SizeVariable,
  symbolic_cost_dominates
}
import v2.std.cardinality { NonZeroNat }
import v2.std.logic { Bool }
import std.nat { Zero }
import v2.std.node { Atom, Conj, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}

data synthesis_lin_poly_x: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^synthesis_lin_poly_x_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data synthesis_polynomial_degree_two: PolynomialDegree = PolynomialDegree {
  predecessor_after_linear: NonZeroNat { prev: Zero }
}

fn linear_not_dominated_by_polynomial_claim_holds() -> Bool {
  !symbolic_cost_dominates(
    a: LinearCost { variable: SizeVariable { source: synthesis_lin_poly_x } },
    b: PolynomialCost {
      variable: SizeVariable { source: synthesis_lin_poly_x },
      degree: synthesis_polynomial_degree_two
    }
  )
}

fn linear_not_dominated_by_polynomial_claim_rhs() -> Node {
  if linear_not_dominated_by_polynomial_claim_holds() {
    synthesis_lin_poly_x
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_linear_not_dominated_by_polynomial: TestClaim = EqualsClaim {
  label: "lens_synthesis/linear_not_dominated_by_polynomial: ClassLinear does not dominate ClassPolynomial",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: synthesis_lin_poly_x,
  rhs: linear_not_dominated_by_polynomial_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
