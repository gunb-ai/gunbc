module v2.test.lens_synthesis.linear_not_dominated_by_polynomial


data synthesis_lin_poly_x: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^synthesis_lin_poly_x_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data synthesis_polynomial_degree_two: v2.lens.cost.PolynomialDegree = v2.lens.cost.PolynomialDegree {
  predecessor_after_linear: v2.std.cardinality.NonZeroNat { prev: Zero }
}

fn linear_not_dominated_by_polynomial_claim_holds() -> Bool {
  !symbolic_cost_dominates(
    a: v2.lens.cost.LinearCost { variable: v2.lens.cost.SizeVariable { source: synthesis_lin_poly_x } },
    b: v2.lens.cost.PolynomialCost {
      variable: v2.lens.cost.SizeVariable { source: synthesis_lin_poly_x },
      degree: synthesis_polynomial_degree_two
    }
  )
}

fn linear_not_dominated_by_polynomial_claim_rhs() -> Node {
  if linear_not_dominated_by_polynomial_claim_holds() {
    synthesis_lin_poly_x
  } else {
    v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_linear_not_dominated_by_polynomial: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "lens_synthesis/linear_not_dominated_by_polynomial: ClassLinear does not dominate ClassPolynomial",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: synthesis_lin_poly_x,
  rhs: linear_not_dominated_by_polynomial_claim_rhs(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
