module v2.test.lens_synthesis.synthesis_gap_information_theoretic

data synthesis_gap_it_leaf: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^synthesis_gap_it_atom_symbol } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data synthesis_gap_it_body: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: v2.std.node.Transform },
  children: [
    v2.std.node.Edge { label: v2.std.node.Positional, target: synthesis_gap_it_leaf }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data synthesis_gap_it_inner: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Cardinality },
  children: [
    v2.std.node.Edge { label: v2.std.node.Positional, target: synthesis_gap_it_body }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data synthesis_gap_it_input: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Cardinality },
  children: [
    v2.std.node.Edge { label: v2.std.node.Positional, target: synthesis_gap_it_inner }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data synthesis_gap_it_sentinel: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^synthesis_gap_it_sentinel_symbol } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

test fn synthesis_gap_it_lens_non_empty() -> v2.std.logic.Bool {
  v2.std.algebra.non_empty(v2.lens.synthesis.synthesis_lens(n: synthesis_gap_it_input, declared_technique: v2.lens.synthesis.InformationTheoretic))
}

fn synthesis_gap_it_known_reason_node(realization: v2.lens.complexity.ComplexityBound) -> v2.std.node.Node {
  match v2.lens.synthesis.assess_information_theoretic(n: synthesis_gap_it_input, realization: realization) {
    SynthesisGap { realization_cost: _, lower_bound: _, report: r } =>
      match r.reason {
        SynthesisGapDecisionTree => synthesis_gap_it_sentinel
        SynthesisGapInformationTheoretic => synthesis_gap_it_input
      }
    SynthesisOptimal { realization_cost: _, lower_bound: _ } => synthesis_gap_it_sentinel
    SynthesisNoTechnique { diagnostic: _ } => synthesis_gap_it_sentinel
  }
}

fn synthesis_gap_it_first_reason_node() -> v2.std.node.Node {
  let realization = v2.lens.complexity.complexity_lens(n: synthesis_gap_it_input)
  match realization {
    UnknownComplexity { diagnostic: _ } => synthesis_gap_it_sentinel
    ConstantComplexity => synthesis_gap_it_known_reason_node(realization: realization)
    SizedComplexity { class: _, variables: _ } => synthesis_gap_it_known_reason_node(realization: realization)
  }
}

test fn synthesis_gap_it_reason_claim_holds() -> v2.std.logic.Bool {
  synthesis_gap_it_first_reason_node() == synthesis_gap_it_input
}
