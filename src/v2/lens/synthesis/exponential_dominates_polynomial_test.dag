module v2.test.lens_synthesis.exponential_dominates_polynomial


data synthesis_exp_x: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^synthesis_exp_x_symbol } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

test fn exponential_dominates_polynomial_claim_holds() -> v2.std.logic.Bool {
  v2.lens.cost.symbolic_cost_dominates(
    a: v2.lens.cost.ExponentialCost {
      variable: v2.lens.cost.SizeVariable { source: synthesis_exp_x },
      base: v2.lens.cost.ExponentialBase { predecessor_after_one: v2.std.cardinality.NonZeroNat { prev: v2.std.nat.Zero } }
    },
    b: v2.lens.cost.PolynomialCost {
      variable: v2.lens.cost.SizeVariable { source: synthesis_exp_x },
      degree: v2.lens.cost.PolynomialDegree { predecessor_after_linear: v2.std.cardinality.NonZeroNat { prev: v2.std.nat.Zero } }
    }
  )
}
