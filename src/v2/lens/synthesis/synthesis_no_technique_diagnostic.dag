module v2.test.lens_synthesis.synthesis_no_technique_diagnostic

import v2.lens.synthesis { AlgebraicRank, synthesis_lens_diagnostics }
import v2.std.algebra { non_empty }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  Cardinality,
  ComputationNode,
  Edge,
  Node,
  Positional,
  Symbol,
  Transform,
  TypeNode,
  SyntheticOccurrence
}
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
data synthesis_no_tech_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^synthesis_no_tech_atom_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data synthesis_no_tech_body: Node = Node {
  kind: ComputationNode { behavior: Transform },
  children: [
    Edge { label: Positional, target: synthesis_no_tech_leaf }
  ],
  occurrence_id: SyntheticOccurrence
}

data synthesis_no_tech_inner: Node = Node {
  kind: TypeNode { connective: Cardinality },
  children: [
    Edge { label: Positional, target: synthesis_no_tech_body }
  ],
  occurrence_id: SyntheticOccurrence
}

data synthesis_no_tech_input: Node = Node {
  kind: TypeNode { connective: Cardinality },
  children: [
    Edge { label: Positional, target: synthesis_no_tech_inner }
  ],
  occurrence_id: SyntheticOccurrence
}

data synthesis_no_tech_sentinel: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^synthesis_no_tech_sentinel_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn synthesis_no_tech_diagnostics_non_empty() -> Bool {
  non_empty(synthesis_lens_diagnostics(n: synthesis_no_tech_input, declared_technique: AlgebraicRank))
}

fn synthesis_no_tech_rhs() -> Node {
  if synthesis_no_tech_diagnostics_non_empty() {
    synthesis_no_tech_input
  } else {
    synthesis_no_tech_sentinel
  }
}

data claim_synthesis_no_technique_diagnostic: TestClaim = EqualsClaim {
  label: "lens_synthesis/synthesis_no_technique_diagnostic: AlgebraicRank emits SynthesisNoTechnique diagnostic",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: synthesis_no_tech_input,
  rhs: synthesis_no_tech_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
