module v2.test.lens_synthesis.synthesis_no_technique_diagnostic


data synthesis_no_tech_leaf: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^synthesis_no_tech_atom_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data synthesis_no_tech_body: Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: Transform },
  children: [
    v2.std.node.Edge { label: Positional, target: synthesis_no_tech_leaf }
  ],
  occurrence_id: SyntheticOccurrence
}

data synthesis_no_tech_inner: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Cardinality },
  children: [
    v2.std.node.Edge { label: Positional, target: synthesis_no_tech_body }
  ],
  occurrence_id: SyntheticOccurrence
}

data synthesis_no_tech_input: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Cardinality },
  children: [
    v2.std.node.Edge { label: Positional, target: synthesis_no_tech_inner }
  ],
  occurrence_id: SyntheticOccurrence
}

data synthesis_no_tech_sentinel: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^synthesis_no_tech_sentinel_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn synthesis_no_tech_diagnostics_non_empty() -> Bool {
  non_empty(synthesis_lens_diagnostics(n: synthesis_no_tech_input, declared_technique: AlgebraicRank))
}

fn synthesis_no_tech_rhs() -> Node {
  if synthesis_no_tech_diagnostics_non_empty() {
    synthesis_no_tech_input
  } else {
    synthesis_no_tech_sentinel
  }
}

data claim_synthesis_no_technique_diagnostic: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "lens_synthesis/synthesis_no_technique_diagnostic: AlgebraicRank emits SynthesisNoTechnique diagnostic",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: synthesis_no_tech_input,
  rhs: synthesis_no_tech_rhs(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
