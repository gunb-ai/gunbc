module v2.test.lens_synthesis.synthesis_gap_polynomial


data synthesis_gap_poly_leaf: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^synthesis_gap_poly_atom_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data synthesis_gap_poly_body: Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: Transform },
  children: [
    v2.std.node.Edge { label: Positional, target: synthesis_gap_poly_leaf }
  ],
  occurrence_id: SyntheticOccurrence
}

data synthesis_gap_poly_inner: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Cardinality },
  children: [
    v2.std.node.Edge { label: Positional, target: synthesis_gap_poly_body }
  ],
  occurrence_id: SyntheticOccurrence
}

data synthesis_gap_poly_input: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Cardinality },
  children: [
    v2.std.node.Edge { label: Positional, target: synthesis_gap_poly_inner }
  ],
  occurrence_id: SyntheticOccurrence
}

data synthesis_gap_poly_sentinel: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^synthesis_gap_poly_sentinel_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn synthesis_gap_poly_lens_non_empty() -> Bool {
  non_empty(synthesis_lens(n: synthesis_gap_poly_input, declared_technique: DecisionTree))
}

fn synthesis_gap_poly_rhs() -> Node {
  if synthesis_gap_poly_lens_non_empty() {
    synthesis_gap_poly_input
  } else {
    synthesis_gap_poly_sentinel
  }
}

data claim_synthesis_gap_polynomial: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "lens_synthesis/synthesis_gap_polynomial: polynomial cost emits non-empty synthesis advisory",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: synthesis_gap_poly_input,
  rhs: synthesis_gap_poly_rhs(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

fn synthesis_gap_poly_known_reason_node(realization: v2.lens.complexity.ComplexityBound) -> Node {
  match assess_decision_tree(n: synthesis_gap_poly_input, realization: realization) {
    SynthesisGap { realization_cost: _, lower_bound: _, report: r } =>
      match r.reason {
        SynthesisGapDecisionTree => synthesis_gap_poly_input
        SynthesisGapInformationTheoretic => synthesis_gap_poly_sentinel
      }
    SynthesisOptimal { realization_cost: _, lower_bound: _ } => synthesis_gap_poly_sentinel
    SynthesisNoTechnique { diagnostic: _ } => synthesis_gap_poly_sentinel
  }
}

fn synthesis_gap_poly_first_reason_node() -> Node {
  let realization = complexity_lens(n: synthesis_gap_poly_input)
  match realization {
    UnknownComplexity { diagnostic: _ } => synthesis_gap_poly_sentinel
    ConstantComplexity => synthesis_gap_poly_known_reason_node(realization: realization)
    SizedComplexity { class: _, variables: _ } => synthesis_gap_poly_known_reason_node(realization: realization)
  }
}

data claim_synthesis_gap_poly_decision_tree_reason: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "lens_synthesis/synthesis_gap_polynomial: report reason is SynthesisGapDecisionTree",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: synthesis_gap_poly_input,
  rhs: synthesis_gap_poly_first_reason_node(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
