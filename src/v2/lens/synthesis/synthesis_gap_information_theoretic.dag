module v2.test.lens_synthesis.synthesis_gap_information_theoretic

import v2.lens.complexity { ComplexityBound, complexity_lens }
import v2.lens.synthesis {
  InformationTheoretic,
  SynthesisGap,
  SynthesisNoTechnique,
  SynthesisOptimal,
  assess_information_theoretic,
  synthesis_lens
}
import v2.std.algebra { non_empty }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  Cardinality,
  ComputationNode,
  Edge,
  Node,
  Positional,
  Symbol,
  Transform,
  TypeNode,
  SyntheticOccurrence
}
import v2.std.report { SynthesisGapDecisionTree, SynthesisGapInformationTheoretic }
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v2.std.witness { Holds, Violates }

data synthesis_gap_it_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^synthesis_gap_it_atom_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data synthesis_gap_it_body: Node = Node {
  kind: ComputationNode { behavior: Transform },
  children: [
    Edge { label: Positional, target: synthesis_gap_it_leaf }
  ],
  occurrence_id: SyntheticOccurrence
}

data synthesis_gap_it_inner: Node = Node {
  kind: TypeNode { connective: Cardinality },
  children: [
    Edge { label: Positional, target: synthesis_gap_it_body }
  ],
  occurrence_id: SyntheticOccurrence
}

data synthesis_gap_it_input: Node = Node {
  kind: TypeNode { connective: Cardinality },
  children: [
    Edge { label: Positional, target: synthesis_gap_it_inner }
  ],
  occurrence_id: SyntheticOccurrence
}

data synthesis_gap_it_sentinel: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^synthesis_gap_it_sentinel_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn synthesis_gap_it_lens_non_empty() -> Bool {
  non_empty(synthesis_lens(n: synthesis_gap_it_input, declared_technique: InformationTheoretic))
}

fn synthesis_gap_it_rhs() -> Node {
  if synthesis_gap_it_lens_non_empty() {
    synthesis_gap_it_input
  } else {
    synthesis_gap_it_sentinel
  }
}

data claim_synthesis_gap_information_theoretic: TestClaim = EqualsClaim {
  label: "lens_synthesis/synthesis_gap_it: polynomial cost emits non-empty IT synthesis advisory",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: synthesis_gap_it_input,
  rhs: synthesis_gap_it_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

fn synthesis_gap_it_first_reason_node() -> Node {
  match complexity_lens(n: synthesis_gap_it_input) {
    Violates { diagnostic: _ } => synthesis_gap_it_sentinel
    Holds { value: realization } =>
      match assess_information_theoretic(n: synthesis_gap_it_input, realization: realization) {
        SynthesisGap { realization_cost: _, lower_bound: _, report: r } =>
          match r.reason {
            SynthesisGapDecisionTree => synthesis_gap_it_sentinel
            SynthesisGapInformationTheoretic => synthesis_gap_it_input
          }
        SynthesisOptimal { realization_cost: _, lower_bound: _ } => synthesis_gap_it_sentinel
        SynthesisNoTechnique { diagnostic: _ } => synthesis_gap_it_sentinel
      }
  }
}

data claim_synthesis_gap_it_reason: TestClaim = EqualsClaim {
  label: "lens_synthesis/synthesis_gap_it: report reason is SynthesisGapInformationTheoretic",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: synthesis_gap_it_input,
  rhs: synthesis_gap_it_first_reason_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
