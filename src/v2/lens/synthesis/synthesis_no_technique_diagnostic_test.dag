module v2.test.lens_synthesis.synthesis_no_technique_diagnostic

data synthesis_no_tech_leaf: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^synthesis_no_tech_atom_symbol } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data synthesis_no_tech_body: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: v2.std.node.Transform },
  children: [
    v2.std.node.Edge { label: v2.std.node.Positional, target: synthesis_no_tech_leaf }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data synthesis_no_tech_inner: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Cardinality },
  children: [
    v2.std.node.Edge { label: v2.std.node.Positional, target: synthesis_no_tech_body }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data synthesis_no_tech_input: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Cardinality },
  children: [
    v2.std.node.Edge { label: v2.std.node.Positional, target: synthesis_no_tech_inner }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

test fn synthesis_no_tech_diagnostics_non_empty() -> Bool {
  v2.std.algebra.non_empty(v2.lens.synthesis.synthesis_lens_diagnostics(n: synthesis_no_tech_input, declared_technique: v2.lens.synthesis.AlgebraicRank))
}
