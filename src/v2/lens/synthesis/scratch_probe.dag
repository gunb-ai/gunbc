module v2.test.lens_synthesis.scratch_probe

import v2.lens.synthesis {
  DecisionTree,
  InformationTheoretic,
  synthesis_lens,
  synthesis_lens_diagnostics
}
import v2.std.algebra { is_empty, non_empty }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.test.complexity_gate.lens_subject_body_supply {
  lens_subject_arrow_body_for_budget_row
}
import v2.test.complexity_gate.subject_complexity_budget_roster {
  complexity_budget_row_comprep_source_bridged_add
}

// Over the REAL source-bridged `add` body: constant cost.
// DecisionTree lower bound is n log n; constant does NOT dominate → SynthesisOptimal → empty reports.
fn add_decision_tree_reports_empty() -> Bool {
  match lens_subject_arrow_body_for_budget_row(row: complexity_budget_row_comprep_source_bridged_add) {
    Accepted { value: body, diagnostics: _ } =>
      is_empty(xs: synthesis_lens(n: body, declared_technique: DecisionTree))
    Rejected { diagnostics: _ } => false
  }
}

// InformationTheoretic over constant `add`: sub-linear realization → SynthesisNoTechnique → diagnostic.
fn add_information_theoretic_diagnostics_non_empty() -> Bool {
  match lens_subject_arrow_body_for_budget_row(row: complexity_budget_row_comprep_source_bridged_add) {
    Accepted { value: body, diagnostics: _ } =>
      non_empty(synthesis_lens_diagnostics(n: body, declared_technique: InformationTheoretic))
    Rejected { diagnostics: _ } => false
  }
}

fn probe_all() -> Bool {
  add_decision_tree_reports_empty() && add_information_theoretic_diagnostics_non_empty()
}
