  "extdeps.languages.typescript.program"
]

data target_ast_vocab_module_prefixes: List<String> = [
  "v2.extdeps.languages.bash",
  "v2.workflow.bash"
]

data realization_edge_path_prefixes: List<String> = [
  "dag/extdeps/languages/",
  "src/v2/extdeps/languages/",
  "src/v2/extdeps/github/diagnostic_emit",
  "src/v2/compiler/05_emit",
  "src/v2/compiler/06_translate",
  "src/v2/compiler/self_host/candidate_generation",
  "src/v2/workflow/shell_emit",
  "src/v2/workflow/bash_emit",
  "src/v2/workflow/bash_command_fold_serialize",
  "src/v2/workflow/build_step_emit",
  "src/v2/workflow/ci_workflow_run_emit",
  "src/v2/workflow/ci_release_build_emit",
  "src/v2/workflow/ci_retry_emit",
  "src/v2/workflow/ci_floor_peak_emit",
  "src/v2/workflow/ci_materialization_emit",
  "src/v2/workflow/orchestration_",
  "dag/gunbc/live_deploy/emit",
  "dag/gunbc/dispatch_pipe_pane_emit",
  "dag/gunbc/assimilate/bmc_token_federation"
]

type RealizationVocabDebtClass
  = ProductLayerTargetAstDebt
  | MisplacedRealizationEdge

type RealizationVocabImportEdge {
  importer_path: String
  vocab_module: String
}

type RealizationVocabGrandfatheredEdgeRow {
  edge: RealizationVocabImportEdge
  debt_class: RealizationVocabDebtClass
  reason: String
  dissolution: std.dissolution.DissolutionCondition
}

data realization_vocab_grandfathered_edge_roster: List<RealizationVocabGrandfatheredEdgeRow> = [
  RealizationVocabGrandfatheredEdgeRow {
    edge: RealizationVocabImportEdge {
      importer_path: "dag/gunbc/roadmap_component.dag",
      vocab_module: "extdeps.languages.typescript.program"
    },
    debt_class: ProductLayerTargetAstDebt,
    reason: "product-layer roadmap component authors target TypeScript AST outside realization-edge prefixes (TS-0 census 2026-08-06)",
    dissolution: unbound_dissolution(description: "TS-4..TS-6 migration: client behavior authored as language-independent site facts and emitted through the production TS target; hand-authored target AST deletes and this edge row deletes with it")
  },
  RealizationVocabGrandfatheredEdgeRow {
    edge: RealizationVocabImportEdge {
      importer_path: "dag/gunbc/design/theme_transition.dag",
      vocab_module: "extdeps.languages.typescript.program"
    },
    debt_class: ProductLayerTargetAstDebt,
    reason: "site theme-transition module authors target TypeScript AST for media-query/timer/listener behavior outside realization-edge prefixes (TS-0 census 2026-08-06)",
    dissolution: unbound_dissolution(description: "TS-5/TS-6 migration: theme reframe behavior modeled language-independently and emitted through the production TS target; hand-authored target AST deletes and this edge row deletes with it")
  },
  RealizationVocabGrandfatheredEdgeRow {
    edge: RealizationVocabImportEdge {
      importer_path: "dag/gunbc/node_http_server_emit.dag",
      vocab_module: "extdeps.languages.typescript.program"
    },
    debt_class: MisplacedRealizationEdge,
    reason: "srv1 dashboard static-server emitter consumes the typescript AST vocabulary outside the realization-edge prefixes (declared interim per the gunbc-served dashboard design)",
    dissolution: unbound_dissolution(description: "gunbc serve (belt B) replaces the emitted-JS static server and this module deletes with the interim route; edge row deletes with it")
  },
  RealizationVocabGrandfatheredEdgeRow {
    edge: RealizationVocabImportEdge {
      importer_path: "src/v2/workflow/effect_plan_bash_materialize.dag",
      vocab_module: "v2.extdeps.languages.bash_build"
    },
    debt_class: MisplacedRealizationEdge,
    reason: "EffectPlan bash materializer imports v2.extdeps.languages.bash_build outside realization-edge prefixes (shell-to-intent wave-A interim site; TS-0 census 2026-08-06)",
    dissolution: unbound_dissolution(description: "shell-to-intent phase 2/3: argv lowering routes through typed effects / emit rows at the realization boundary and bash_build containment closes here; edge row deletes")
  },
  RealizationVocabGrandfatheredEdgeRow {
    edge: RealizationVocabImportEdge {
      importer_path: "dag/tools/build_step.dag",
      vocab_module: "v2.extdeps.languages.bash_build"
    },
    debt_class: MisplacedRealizationEdge,
    reason: "build-step tooling constructs bash via the bash-AST vocabulary outside the realization-edge prefixes (pre shell-to-intent phase-2 site)",
    dissolution: unbound_dissolution(description: "shell-to-intent phase 2/3: the site routes through typed effects / emit rows and the bash-AST containment wall closes; edge row deletes")
  }
]

data empty_realization_vocab_edges: List<RealizationVocabImportEdge> = []

data empty_realization_vocab_leaks: List<RealizationVocabularyLeak> = []

data empty_realization_vocab_path_list: List<String> = []

fn char_eq(a: std.types.Char, b: std.types.Char) -> Bool {
  a == b
}

fn list_contains_str(xs: List<String>, target: String) -> Bool {
  fold_list(
    xs: xs,
    empty: false,
    cons: fn(acc, s) { acc || (s == target) }
  )
}

fn realization_vocab_import_edge_eq(a: RealizationVocabImportEdge, b: RealizationVocabImportEdge) -> Bool {
  (a.importer_path == b.importer_path) && (a.vocab_module == b.vocab_module)
}

fn realization_vocab_edge_from_fact(fact: v2.std.layer.LayerImportFact) -> RealizationVocabImportEdge {
  RealizationVocabImportEdge {
    importer_path: fact.path,
    vocab_module: fact.import_module
  }
}

fn realization_vocab_edge_grandfathered(edge: RealizationVocabImportEdge) -> Bool {
  fold_list(
    xs: realization_vocab_grandfathered_edge_roster,
    empty: false,
    cons: fn(acc, row) {
      acc || realization_vocab_import_edge_eq(a: row.edge, b: edge)
    }
  )
}

fn realization_vocab_grandfathered_edges() -> List<RealizationVocabImportEdge> {
  fold_list(
    xs: realization_vocab_grandfathered_edge_roster,
    empty: empty_realization_vocab_edges,
    cons: fn(acc, row) { list_snoc_item(xs: acc, item: row.edge) }
  )
}

fn realization_vocab_grandfathered_edge_key(edge: RealizationVocabImportEdge) -> String {
  concat(edge.importer_path, concat(" -> ", edge.vocab_module))
}

fn realization_vocab_grandfathered_edge_keys() -> List<String> {
  fold_list(
    xs: realization_vocab_grandfathered_edge_roster,
    empty: empty_realization_vocab_path_list,
    cons: fn(acc, row) {
      list_snoc_item(xs: acc, item: realization_vocab_grandfathered_edge_key(edge: row.edge))
    }
  )
}

fn realization_vocab_grandfathered_edge_key_count(keys: List<String>, key: String) -> Int {
  fold_list(
    xs: keys,
    empty: 0,
    cons: fn(count, candidate) {
      if candidate == key {
        count + 1
      } else {
        count
      }
    }
  )
}

fn realization_vocab_grandfathered_edge_keys_are_distinct(keys: List<String>) -> Bool {
  fold_list(
    xs: keys,
    empty: true,
    cons: fn(ok, key) {
      ok && (realization_vocab_grandfathered_edge_key_count(keys: keys, key: key) == 1)
    }
  )
}

fn realization_vocab_grandfathered_edge_roster_well_formed() -> Bool {
  let keys = realization_vocab_grandfathered_edge_keys()
  realization_vocab_grandfathered_edge_keys_are_distinct(keys: keys)
    && (length(xs: keys) == length(xs: realization_vocab_grandfathered_edge_roster))
}

data realization_vocab_consumer_scan_roots: List<String> = [
  "dag/std",
  "dag/extdeps",
  "dag/tools",
  "dag/gunbc",
  "src/v2/std",
  "src/v2/extdeps",
  "src/v2/compiler",
  "src/v2/workflow",
  "src/v2/lens"
]

type RealizationVocabularyLeak {
  path: String
  import_module: String
}

fn path_has_any_prefix(prefixes: List<String>, path: String) -> Bool {
  fold_list(
    xs: prefixes,
    empty: false,
    cons: fn(acc, p) { acc || is_prefix_of(prefix: p, xs: path, eq: char_eq) }
  )
}

fn module_is_target_ast_vocab(module: String) -> Bool {
  list_contains_str(xs: target_ast_vocab_modules, target: module)
    || path_has_any_prefix(prefixes: target_ast_vocab_module_prefixes, path: module)
}

fn path_is_realization_edge(path: String) -> Bool {
  path_has_any_prefix(prefixes: realization_edge_path_prefixes, path: path)
}

fn is_realization_vocab_leak_under(
  fact: v2.std.layer.LayerImportFact,
  edge_prefixes: List<String>
) -> Bool {
  module_is_target_ast_vocab(module: fact.import_module)
    && (path_has_any_prefix(prefixes: edge_prefixes, path: fact.path) == false)
    && (realization_vocab_edge_grandfathered(
      edge: realization_vocab_edge_from_fact(fact: fact)
    ) == false)
}

fn is_realization_vocab_leak(fact: v2.std.layer.LayerImportFact) -> Bool {
  is_realization_vocab_leak_under(
    fact: fact,
    edge_prefixes: realization_edge_path_prefixes
  )
}

fn realization_edge_path_prefixes_without(excluded: String) -> List<String> {
  fold_list(
    xs: realization_edge_path_prefixes,
    empty: empty_realization_vocab_path_list,
    cons: fn(acc, prefix) {
      if prefix == excluded {
        acc
      } else {
        list_snoc_item(xs: acc, item: prefix)
      }
    }
  )
}

fn scan_facts_for_leaks_under(
  facts: List<v2.std.layer.LayerImportFact>,
  edge_prefixes: List<String>
) -> List<RealizationVocabularyLeak> {
  fold_list(
    xs: facts,
    empty: empty_realization_vocab_leaks,
    cons: fn(acc, fact) {
      if is_realization_vocab_leak_under(fact: fact, edge_prefixes: edge_prefixes) {
        list_snoc_item(
          xs: acc,
          item: RealizationVocabularyLeak {
            path: fact.path,
            import_module: fact.import_module
          }
        )
      } else {
        acc
      }
    }
  )
}

fn realization_vocab_leak_count(facts: List<v2.std.layer.LayerImportFact>) -> Int {
  length(xs: scan_facts_for_leaks_under(facts: facts, edge_prefixes: realization_edge_path_prefixes))
}

fn realization_vocab_leak_count_with_edge_prefixes(
  facts: List<v2.std.layer.LayerImportFact>,
  edge_prefixes: List<String>
) -> Int {
  length(xs: scan_facts_for_leaks_under(facts: facts, edge_prefixes: edge_prefixes))
}

fn realization_vocab_containment_holds(facts: List<v2.std.layer.LayerImportFact>) -> Bool {
  is_empty(xs: scan_facts_for_leaks_under(facts: facts, edge_prefixes: realization_edge_path_prefixes))
}

fn realization_vocab_leak_count_canonical(facts: List<v2.std.layer.LayerImportFact>) -> Int {
  realization_vocab_leak_count(facts: facts)
}

fn realization_vocab_containment_holds_canonical(facts: List<v2.std.layer.LayerImportFact>) -> Bool {
  realization_vocab_containment_holds(facts: facts)
}

fn realization_vocab_leak_count_live(scan_roots: List<String>) -> Int {
  realization_vocab_leak_count_canonical(
    facts: layer_import_facts_live(std_roots: scan_roots, extdeps_roots: [])
  )
}

fn realization_vocab_containment_clean_live(scan_roots: List<String>) -> Bool {
  realization_vocab_containment_holds_canonical(
    facts: layer_import_facts_live(std_roots: scan_roots, extdeps_roots: [])
  )
}

fn realization_vocab_leak_candidate_paths_from_facts(facts: List<v2.std.layer.LayerImportFact>) -> List<String> {
  fold_list(
    xs: facts,
    empty: empty_realization_vocab_path_list,
    cons: fn(acc, fact) {
      if module_is_target_ast_vocab(module: fact.import_module)
        && (path_is_realization_edge(path: fact.path) == false) {
        list_snoc_item(xs: acc, item: fact.path)
      } else {
        acc
      }
    }
  )
}

fn realization_vocab_live_leak_candidate_paths(scan_roots: List<String>) -> List<String> {
  realization_vocab_leak_candidate_paths_from_facts(
    facts: layer_import_facts_live(std_roots: scan_roots, extdeps_roots: [])
  )
}

fn realization_vocab_live_leak_edges_from_facts(facts: List<v2.std.layer.LayerImportFact>) -> List<RealizationVocabImportEdge> {
  fold_list(
    xs: facts,
    empty: empty_realization_vocab_edges,
    cons: fn(acc, fact) {
      if module_is_target_ast_vocab(module: fact.import_module)
        && (path_is_realization_edge(path: fact.path) == false) {
        list_snoc_item(xs: acc, item: realization_vocab_edge_from_fact(fact: fact))
      } else {
        acc
      }
    }
  )
}

fn realization_vocab_live_leak_edges(scan_roots: List<String>) -> List<RealizationVocabImportEdge> {
  realization_vocab_live_leak_edges_from_facts(
    facts: layer_import_facts_live(std_roots: scan_roots, extdeps_roots: [])
  )
}

fn realization_vocab_live_leak_edge_keys_from_facts(facts: List<v2.std.layer.LayerImportFact>) -> List<String> {
  fold_list(
    xs: realization_vocab_live_leak_edges_from_facts(facts: facts),
    empty: empty_realization_vocab_path_list,
    cons: fn(acc, edge) {
      list_snoc_item(xs: acc, item: realization_vocab_grandfathered_edge_key(edge: edge))
    }
  )
}

fn realization_vocab_stale_grandfathered_edges(
  live_leak_edges: List<RealizationVocabImportEdge>
) -> List<RealizationVocabImportEdge> {
  fold_list(
    xs: realization_vocab_grandfathered_edge_roster,
    empty: empty_realization_vocab_edges,
    cons: fn(acc, row) {
      if fold_list(
        xs: live_leak_edges,
        empty: false,
        cons: fn(found, edge) {
          found || realization_vocab_import_edge_eq(a: row.edge, b: edge)
        }
      ) {
        acc
      } else {
        list_snoc_item(xs: acc, item: row.edge)
      }
    }
  )
}

fn realization_vocab_roster_stale_count(
  live_leak_edges: List<RealizationVocabImportEdge>
) -> Int {
  length(xs: realization_vocab_stale_grandfathered_edges(live_leak_edges: live_leak_edges))
}

fn realization_vocab_roster_sound(live_leak_edges: List<RealizationVocabImportEdge>) -> Bool {
  is_empty(xs: realization_vocab_stale_grandfathered_edges(live_leak_edges: live_leak_edges))
}

fn realization_vocab_roster_stale_count_live(scan_roots: List<String>) -> Int {
  realization_vocab_roster_stale_count(
    live_leak_edges: realization_vocab_live_leak_edges(scan_roots: scan_roots)
  )
}

fn realization_vocab_roster_sound_live(scan_roots: List<String>) -> Bool {
  realization_vocab_roster_sound(
    live_leak_edges: realization_vocab_live_leak_edges(scan_roots: scan_roots)
  )
}

data construction_justification: v2.lens.common.construction_justification.ConstructionJustification = v2.lens.common.construction_justification.ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: RealizationDispatch }
}
