module v2.lens.realization_vocabulary_containment
import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }
import std.disposition { RealizationDispatch }

import v2.lens.layering_imports {
  LayerImportFact,
  layer_import_facts_live
}
import v2.std.algebra {
  fold_list,
  is_empty,
  is_prefix_of,
  length,
  list_snoc_item
}
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { Char, String }

data target_ast_vocab_modules: List<String> = [
  "extdeps.languages.bash.program",
  "extdeps.languages.typescript.program"
]

data realization_edge_path_prefixes: List<String> = [
  "dag/extdeps/languages/",
  "src/v2/extdeps/languages/",
  "src/v2/compiler/05_emit",
  "src/v2/compiler/06_translate",
  "src/v2/compiler/self_host/candidate_generation",
  "src/v2/workflow/shell_emit",
  "src/v2/workflow/orchestration_emit",
  "src/v2/workflow/orchestration_stmt_emit",
  "src/v2/workflow/orchestration_word_emit"
]

data realization_vocab_exception_roster: List<String> = [
  "dag/gunbc/node_http_server_emit.dag",
  "dag/gunbc/ci_yaml_validate.dag",
  "dag/tools/build_step.dag",
  "dag/tools/build_step_transport.dag",
  "dag/tools/dag_compile_clean_transport.dag",
  "dag/tools/emit_determinism_transport.dag",
  "dag/tools/emit_host_transport.dag",
  "dag/tools/extdeps_external_authority_transport.dag",
  "dag/tools/host_prelude.dag",
  "dag/tools/layering_imports_transport.dag",
  "dag/tools/regen_verify_transport.dag",
  "dag/tools/self_host_realized_comparison_transport.dag",
  "dag/tools/v1_dag_parse_transport.dag",
  "src/v2/workflow/compiler_closure_ingest_transport.dag",
  "src/v2/workflow/floor_diff_observe.dag",
  "src/v2/workflow/self_host_realized_comparison_gate.dag",
  "src/v2/workflow/source_root_ingest_transport.dag"
]

data realization_vocab_consumer_scan_roots: List<String> = [
  "dag/std",
  "dag/extdeps",
  "dag/compiler",
  "dag/tools",
  "dag/gunbc",
  "src/v2/std",
  "src/v2/extdeps",
  "src/v2/compiler",
  "src/v2/workflow",
  "src/v2/lens"
]

data bash_program_module: String = "extdeps.languages.bash.program"
data bash_program_importer_count_baseline: Int = 33

data bash_program_importer_scan_roots: List<String> = [
  "src/v2",
  "dag"
]

type RealizationVocabularyLeak {
  path: String
  import_module: String
}

data empty_realization_vocab_leaks: List<RealizationVocabularyLeak> = []

fn char_eq(a: Char, b: Char) -> Bool {
  a == b
}

fn list_contains_str(xs: List<String>, target: String) -> Bool {
  fold_list(
    xs: xs,
    empty: false,
    cons: fn(acc, s) { acc || (s == target) }
  )
}

fn path_has_any_prefix(prefixes: List<String>, path: String) -> Bool {
  fold_list(
    xs: prefixes,
    empty: false,
    cons: fn(acc, p) { acc || is_prefix_of(prefix: p, xs: path, eq: char_eq) }
  )
}

fn module_is_target_ast_vocab(module: String) -> Bool {
  list_contains_str(xs: target_ast_vocab_modules, target: module)
}

fn path_is_realization_edge(path: String) -> Bool {
  path_has_any_prefix(prefixes: realization_edge_path_prefixes, path: path)
}

fn is_realization_vocab_leak(fact: LayerImportFact, roster: List<String>) -> Bool {
  module_is_target_ast_vocab(module: fact.import_module)
    && (path_is_realization_edge(path: fact.path) == false)
    && (list_contains_str(xs: roster, target: fact.path) == false)
}

fn scan_facts_for_leaks(
  facts: List<LayerImportFact>,
  roster: List<String>
) -> List<RealizationVocabularyLeak> {
  fold_list(
    xs: facts,
    empty: empty_realization_vocab_leaks,
    cons: fn(acc, fact) {
      if is_realization_vocab_leak(fact: fact, roster: roster) {
        list_snoc_item(
          xs: acc,
          item: RealizationVocabularyLeak {
            path: fact.path,
            import_module: fact.import_module
          }
        )
      } else {
        acc
      }
    }
  )
}

fn realization_vocab_leak_count(
  facts: List<LayerImportFact>,
  roster: List<String>
) -> Int {
  length(xs: scan_facts_for_leaks(facts: facts, roster: roster))
}

fn realization_vocab_containment_holds(
  facts: List<LayerImportFact>,
  roster: List<String>
) -> Bool {
  is_empty(xs: scan_facts_for_leaks(facts: facts, roster: roster))
}

fn realization_vocab_leak_count_canonical(facts: List<LayerImportFact>) -> Int {
  realization_vocab_leak_count(facts: facts, roster: realization_vocab_exception_roster)
}

fn realization_vocab_containment_holds_canonical(facts: List<LayerImportFact>) -> Bool {
  realization_vocab_containment_holds(facts: facts, roster: realization_vocab_exception_roster)
}

fn realization_vocab_leak_count_live(scan_roots: List<String>) -> Int {
  realization_vocab_leak_count_canonical(
    facts: layer_import_facts_live(std_roots: scan_roots, extdeps_roots: [])
  )
}

fn realization_vocab_containment_clean_live(scan_roots: List<String>) -> Bool {
  realization_vocab_containment_holds_canonical(
    facts: layer_import_facts_live(std_roots: scan_roots, extdeps_roots: [])
  )
}

data empty_realization_vocab_path_list: List<String> = []

fn realization_vocab_live_leak_candidate_paths(scan_roots: List<String>) -> List<String> {
  fold_list(
    xs: layer_import_facts_live(std_roots: scan_roots, extdeps_roots: []),
    empty: empty_realization_vocab_path_list,
    cons: fn(acc, fact) {
      if module_is_target_ast_vocab(module: fact.import_module)
        && (path_is_realization_edge(path: fact.path) == false) {
        list_snoc_item(xs: acc, item: fact.path)
      } else {
        acc
      }
    }
  )
}

fn realization_vocab_stale_roster_entries(
  roster: List<String>,
  live_leak_paths: List<String>
) -> List<String> {
  fold_list(
    xs: roster,
    empty: empty_realization_vocab_path_list,
    cons: fn(acc, entry) {
      if list_contains_str(xs: live_leak_paths, target: entry) {
        acc
      } else {
        list_snoc_item(xs: acc, item: entry)
      }
    }
  )
}

fn realization_vocab_roster_stale_count(
  roster: List<String>,
  live_leak_paths: List<String>
) -> Int {
  length(xs: realization_vocab_stale_roster_entries(roster: roster, live_leak_paths: live_leak_paths))
}

fn realization_vocab_roster_sound(
  roster: List<String>,
  live_leak_paths: List<String>
) -> Bool {
  is_empty(xs: realization_vocab_stale_roster_entries(roster: roster, live_leak_paths: live_leak_paths))
}

fn realization_vocab_roster_stale_count_live(scan_roots: List<String>) -> Int {
  realization_vocab_roster_stale_count(
    roster: realization_vocab_exception_roster,
    live_leak_paths: realization_vocab_live_leak_candidate_paths(scan_roots: scan_roots)
  )
}

fn realization_vocab_roster_sound_live(scan_roots: List<String>) -> Bool {
  realization_vocab_roster_sound(
    roster: realization_vocab_exception_roster,
    live_leak_paths: realization_vocab_live_leak_candidate_paths(scan_roots: scan_roots)
  )
}

fn importer_count_ratchet_holds(live_count: Int, baseline: Int) -> Bool {
  live_count <= baseline
}

fn bash_program_importer_count(facts: List<LayerImportFact>) -> Int {
  fold_list(
    xs: facts,
    empty: 0,
    cons: fn(count, fact) {
      if fact.import_module == bash_program_module {
        count + 1
      } else {
        count
      }
    }
  )
}

fn bash_program_importer_count_live() -> Int {
  bash_program_importer_count(
    facts: layer_import_facts_live(
      std_roots: bash_program_importer_scan_roots,
      extdeps_roots: []
    )
  )
}

fn bash_program_importer_count_ratchet_holds() -> Bool {
  importer_count_ratchet_holds(
    live_count: bash_program_importer_count_live(),
    baseline: bash_program_importer_count_baseline
  )
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: RealizationDispatch }
}
