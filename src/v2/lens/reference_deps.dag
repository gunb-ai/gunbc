module v2.lens.reference_deps

import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }
import v2.lens.coverage { dedupe_snoc }
import v2.lens.enforcement.grammar_coverage { grammar_coverage_distinct_rel_paths }
import v2.lens.module_graph {
  ImportClosureBfsState,
  ImportResolutionFact,
  ModuleDeclarationFact,
  bfs_absorb_neighbors,
  build_module_to_path,
  import_closure_bfs_walk,
  import_resolution_facts_live,
  map_lookup_where_rejected_unreachable,
  module_declaration_facts_live,
  module_graph_exclude_substrings,
  no_paths,
  snoc_unseen_list
}
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.algebra { Cons, Empty, FreeMonoid }
import v2.compiler.normalize { normalize }
import v2.compiler.parse { parse_module }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag {
  dag_language_model,
  parse_production_captured_child_optional,
  parse_production_emitted_identity_optional,
  parse_qualified_name_segments_from_capture,
  qualified_name_from_module_node,
  qualified_name_from_segment_list
}
import v2.std.algebra {
  contains,
  fold_list,
  is_empty,
  is_prefix_of,
  length,
  list_snoc_item
}
import v2.std.collection { Absent, List, Map, Present, empty_map, map_insert }
import v2.std.decl_index { decl_facts }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Rejected,
  Unavailable,
  node_locus,
  outcome_accepted,
  outcome_rejected
}
import v2.std.logic { Bool }
import v2.std.node { Edge, Node, Symbol }
import v2.std.node_query { find_named_child }
import v2.std.qualified_name {
  QualifiedName,
  qualified_name_from_dotted_string,
  qualified_name_from_node
}
import v2.std.text { String }

type ReferenceResolutionFact {
  path: String
  reference_module: String
  target_declared: Bool
}

type ReferenceIngestRefusal {
  path: String
  stage: String
  reason: Symbol
}

type ReferenceResolutionCensus {
  facts: List<ReferenceResolutionFact>
  refusals: List<ReferenceIngestRefusal>
}

data reference_deps_parsed_tree_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "v2.lens.reference_deps",
    decl_name: "reference_resolution_facts_from_parsed_corpus",
    field: WholeDeclaration
  }
}

data reference_deps_dissolution_note: String = "B2 reference edges from parsed-tree qualified-name use sites (imports + body/type refs via ingest → fold). Segment-prefix match against declared module paths (QualifiedName segments, not string scan). reference_closure_live parses on-demand along the closure BFS only; reference_resolution_facts_from_parsed_corpus is the full-corpus scaffold census. Dissolves when symbol_index_fill projects the same edges from the filled containment tree as the single authority."

data reference_deps_file_anchor: Symbol = ^reference_deps_file_anchor

data reference_deps_qualified_name_capture_missing: Symbol = ^reference_deps_qualified_name_capture_missing

data empty_reference_facts: List<ReferenceResolutionFact> = []

data empty_reference_refusals: List<ReferenceIngestRefusal> = []

fn string_eq(a: String, b: String) -> Bool {
  a == b
}

fn symbol_eq(a: Symbol, b: Symbol) -> Bool {
  a == b
}

fn qualified_name_eq(a: QualifiedName, b: QualifiedName) -> Bool {
  is_prefix_of(prefix: a, xs: b, eq: symbol_eq)
    && is_prefix_of(prefix: b, xs: a, eq: symbol_eq)
}

fn reference_fact_eq(a: ReferenceResolutionFact, b: ReferenceResolutionFact) -> Bool {
  string_eq(a: a.path, b: b.path)
    && string_eq(a: a.reference_module, b: b.reference_module)
}

fn reference_snoc_fact_unique(
  acc: List<ReferenceResolutionFact>,
  fact: ReferenceResolutionFact
) -> List<ReferenceResolutionFact> {
  if contains(xs: acc, item: fact, eq: reference_fact_eq) {
    acc
  } else {
    list_snoc_item(xs: acc, item: fact)
  }
}

fn reference_snoc_refusal(
  acc: List<ReferenceIngestRefusal>,
  refusal: ReferenceIngestRefusal
) -> List<ReferenceIngestRefusal> {
  list_snoc_item(xs: acc, item: refusal)
}

fn reference_deps_ingest_source_text(
  source_text: String,
  file: Symbol
) -> Outcome<Node> {
  let lm = dag_language_model()
  match tokenize(text: source_text, file: file, rules: lm.lex) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
        Accepted { value: artifact, diagnostics: _ } =>
          outcome_accepted(value: normalize(parse_tree: artifact.tree))
      }
  }
}

fn reference_qn_from_qualified_name_production_strict(
  production_node: Node,
  module_root: Node
) -> Outcome<QualifiedName> {
  match parse_production_captured_child_optional(node: production_node) {
    Absent =>
      outcome_rejected(d: Diagnostic {
        reason: reference_deps_qualified_name_capture_missing,
        at: node_locus(node: production_node),
        correction: Unavailable { reason: ExternalContractUnknown }
      })
    Present { value: capture } =>
      match parse_qualified_name_segments_from_capture(qn_capture: capture, root: module_root) {
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
        Accepted { value: segments, diagnostics: _ } =>
          qualified_name_from_segment_list(segments: segments, root: module_root)
      }
  }
}

fn reference_qn_from_import_decl_strict(node: Node, module_root: Node) -> Outcome<QualifiedName> {
  match find_named_child(root: node, name: ^dag_surface_import_decl_qualified_name) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: qn_node, diagnostics: _ } =>
      qualified_name_from_node(root: qn_node)
  }
}

fn reference_collect_qn_site_step(
  acc: List<QualifiedName>,
  site_qn: QualifiedName,
  module_qn: QualifiedName
) -> List<QualifiedName> {
  if qualified_name_eq(a: site_qn, b: module_qn) {
    acc
  } else {
    list_snoc_item(xs: acc, item: site_qn)
  }
}

fn reference_sites_collect_edges(
  edges: List<Edge>,
  module_root: Node,
  module_qn: QualifiedName,
  acc: List<QualifiedName>
) -> Outcome<List<QualifiedName>> {
  match edges |> first {
    Absent => outcome_accepted(value: acc)
    Present { value: edge } =>
      match reference_sites_collect_node(
        node: edge.target,
        module_root: module_root,
        module_qn: module_qn,
        acc: acc
      ) {
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
        Accepted { value: next_acc, diagnostics: _ } =>
          reference_sites_collect_edges(
            edges: edges |> skip(1),
            module_root: module_root,
            module_qn: module_qn,
            acc: next_acc
          )
      }
  }
}

fn reference_sites_collect_node(
  node: Node,
  module_root: Node,
  module_qn: QualifiedName,
  acc: List<QualifiedName>
) -> Outcome<List<QualifiedName>> {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } =>
      if id == ^dag_surface_qualified_name {
        match reference_qn_from_qualified_name_production_strict(
          production_node: node,
          module_root: module_root
        ) {
          Rejected { diagnostics: d } => Rejected { diagnostics: d }
          Accepted { value: site_qn, diagnostics: _ } =>
            reference_sites_collect_edges(
              edges: node.children,
              module_root: module_root,
              module_qn: module_qn,
              acc: reference_collect_qn_site_step(
                acc: acc,
                site_qn: site_qn,
                module_qn: module_qn
              )
            )
        }
      } else if id == ^dag_surface_import_decl {
        match reference_qn_from_import_decl_strict(node: node, module_root: module_root) {
          Rejected { diagnostics: d } => Rejected { diagnostics: d }
          Accepted { value: site_qn, diagnostics: _ } =>
            reference_sites_collect_edges(
              edges: node.children,
              module_root: module_root,
              module_qn: module_qn,
              acc: reference_collect_qn_site_step(
                acc: acc,
                site_qn: site_qn,
                module_qn: module_qn
              )
            )
        }
      } else {
        reference_sites_collect_edges(
          edges: node.children,
          module_root: module_root,
          module_qn: module_qn,
          acc: acc
        )
      }
    Absent =>
      reference_sites_collect_edges(
        edges: node.children,
        module_root: module_root,
        module_qn: module_qn,
        acc: acc
      )
  }
}

fn reference_sites_from_parsed_module(module_root: Node) -> Outcome<List<QualifiedName>> {
  match qualified_name_from_module_node(root: module_root) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: module_qn, diagnostics: _ } =>
      reference_sites_collect_node(
        node: module_root,
        module_root: module_root,
        module_qn: module_qn,
        acc: Empty
      )
  }
}

fn reference_declared_module_prefix_facts(
  rel_path: String,
  ref_qn: QualifiedName,
  declared: List<ModuleDeclarationFact>,
  acc: List<ReferenceResolutionFact>
) -> List<ReferenceResolutionFact> {
  fold_list(
    xs: declared,
    empty: acc,
    cons: fn(a, fact) {
      let decl_qn = qualified_name_from_dotted_string(dotted: fact.module)
      if is_prefix_of(prefix: decl_qn, xs: ref_qn, eq: symbol_eq) {
        reference_snoc_fact_unique(
          acc: a,
          fact: ReferenceResolutionFact {
            path: rel_path,
            reference_module: fact.module,
            target_declared: true
          }
        )
      } else {
        a
      }
    }
  )
}

fn reference_facts_for_qn_sites(
  rel_path: String,
  sites: List<QualifiedName>,
  declared: List<ModuleDeclarationFact>,
  acc: List<ReferenceResolutionFact>
) -> List<ReferenceResolutionFact> {
  fold_list(
    xs: sites,
    empty: acc,
    cons: fn(a, site_qn) {
      reference_declared_module_prefix_facts(
        rel_path: rel_path,
        ref_qn: site_qn,
        declared: declared,
        acc: a
      )
    }
  )
}

fn reference_paths_from_import_edges(
  edges: List<ImportResolutionFact>,
  acc: List<String>
) -> List<String> {
  fold_list(
    xs: edges,
    empty: acc,
    cons: fn(a, edge) {
      dedupe_snoc(acc: a, item: edge.path, eq: string_eq)
    }
  )
}

fn reference_paths_from_module_declarations(
  nodes: List<ModuleDeclarationFact>,
  acc: List<String>
) -> List<String> {
  fold_list(
    xs: nodes,
    empty: acc,
    cons: fn(a, node) {
      dedupe_snoc(acc: a, item: node.path, eq: string_eq)
    }
  )
}

fn reference_corpus_paths_live(
  pool_roots: List<String>,
  importer_roots: List<String>,
  exclude_substrings: List<String>
) -> List<String> {
  let from_modules = reference_paths_from_module_declarations(
    nodes: module_declaration_facts_live(pool_roots: pool_roots),
    acc: Empty
  )
  let from_imports = reference_paths_from_import_edges(
    edges: import_resolution_facts_live(
      pool_roots: pool_roots,
      importer_roots: importer_roots,
      exclude_substrings: exclude_substrings
    ),
    acc: from_modules
  )
  fold_list(
    xs: grammar_coverage_distinct_rel_paths(facts: decl_facts(pool_roots: pool_roots)),
    empty: from_imports,
    cons: fn(acc, path) { dedupe_snoc(acc: acc, item: path, eq: string_eq) }
  )
}

fn reference_file_census_parsed(
  rel_path: String,
  module_root: Node,
  declared: List<ModuleDeclarationFact>
) -> ReferenceResolutionCensus {
  match reference_sites_from_parsed_module(module_root: module_root) {
    Rejected { diagnostics: d } =>
      reference_file_census_refused(
        rel_path: rel_path,
        stage: "reference_site",
        reason: d.head.reason
      )
    Accepted { value: sites, diagnostics: _ } =>
      ReferenceResolutionCensus {
        facts: reference_facts_for_qn_sites(
          rel_path: rel_path,
          sites: sites,
          declared: declared,
          acc: empty_reference_facts
        ),
        refusals: empty_reference_refusals
      }
  }
}

fn reference_file_census_refused(
  rel_path: String,
  stage: String,
  reason: Symbol
) -> ReferenceResolutionCensus {
  ReferenceResolutionCensus {
    facts: empty_reference_facts,
    refusals: [
      ReferenceIngestRefusal {
        path: rel_path,
        stage: stage,
        reason: reason
      }
    ]
  }
}

fn reference_file_census(
  rel_path: String,
  declared: List<ModuleDeclarationFact>
) -> ReferenceResolutionCensus {
  let source_text = filesystem_read(path: rel_path).content
  match reference_deps_ingest_source_text(
    source_text: source_text,
    file: reference_deps_file_anchor
  ) {
    Rejected { diagnostics: d } =>
      reference_file_census_refused(
        rel_path: rel_path,
        stage: "ingest",
        reason: d.head.reason
      )
    Accepted { value: module_root, diagnostics: _ } =>
      reference_file_census_parsed(
        rel_path: rel_path,
        module_root: module_root,
        declared: declared
      )
  }
}

fn reference_merge_census(
  acc: ReferenceResolutionCensus,
  row: ReferenceResolutionCensus
) -> ReferenceResolutionCensus {
  ReferenceResolutionCensus {
    facts: fold_list(
      xs: row.facts,
      empty: acc.facts,
      cons: fn(a, fact) { reference_snoc_fact_unique(acc: a, fact: fact) }
    ),
    refusals: fold_list(
      xs: row.refusals,
      empty: acc.refusals,
      cons: fn(a, refusal) { reference_snoc_refusal(acc: a, refusal: refusal) }
    )
  }
}

fn reference_empty_census() -> ReferenceResolutionCensus {
  ReferenceResolutionCensus {
    facts: empty_reference_facts,
    refusals: empty_reference_refusals
  }
}

fn reference_resolution_facts_from_parsed_corpus(
  pool_roots: List<String>,
  importer_roots: List<String>,
  exclude_substrings: List<String>
) -> ReferenceResolutionCensus {
  let declared = module_declaration_facts_live(pool_roots: pool_roots)
  let paths = reference_corpus_paths_live(
    pool_roots: pool_roots,
    importer_roots: importer_roots,
    exclude_substrings: exclude_substrings
  )
  fold_list(
    xs: paths,
    empty: reference_empty_census(),
    cons: fn(acc, rel_path) {
      reference_merge_census(
        acc: acc,
        row: reference_file_census(rel_path: rel_path, declared: declared)
      )
    }
  )
}

fn reference_resolution_census_live(
  pool_roots: List<String>,
  importer_roots: List<String>,
  exclude_substrings: List<String>
) -> ReferenceResolutionCensus {
  reference_resolution_facts_from_parsed_corpus(
    pool_roots: pool_roots,
    importer_roots: importer_roots,
    exclude_substrings: exclude_substrings
  )
}

fn reference_resolution_facts_live(
  pool_roots: List<String>,
  importer_roots: List<String>,
  exclude_substrings: List<String>
) -> List<ReferenceResolutionFact> {
  let census = reference_resolution_census_live(
    pool_roots: pool_roots,
    importer_roots: importer_roots,
    exclude_substrings: exclude_substrings
  )
  if is_empty(xs: census.refusals) {
    census.facts
  } else {
    empty_reference_facts
  }
}

fn reference_resolution_refusal_count_live(
  pool_roots: List<String>,
  importer_roots: List<String>,
  exclude_substrings: List<String>
) -> Int {
  length(
    xs: reference_resolution_census_live(
      pool_roots: pool_roots,
      importer_roots: importer_roots,
      exclude_substrings: exclude_substrings
    ).refusals
  )
}

fn extend_adjacency_for_reference_edge(
  acc: Map<String, List<String>>,
  edge: ReferenceResolutionFact,
  module_to_path: Map<String, String>
) -> Map<String, List<String>> {
  match map_lookup_where_rejected_unreachable(m: module_to_path, key: edge.reference_module) {
    Present { value: referenced_path } =>
      match map_lookup_where_rejected_unreachable(m: acc, key: edge.path) {
        Present { value: existing } =>
          map_insert(
            m: acc,
            key: edge.path,
            value: snoc_unseen_list(acc: existing, item: referenced_path)
          )
        Absent =>
          map_insert(
            m: acc,
            key: edge.path,
            value: list_snoc_item(xs: no_paths, item: referenced_path)
          )
      }
    Absent => acc
  }
}

fn build_reference_adjacency(
  edges: List<ReferenceResolutionFact>,
  nodes: List<ModuleDeclarationFact>
) -> Map<String, List<String>> {
  let module_to_path = build_module_to_path(nodes: nodes)
  fold_list(
    xs: edges,
    empty: empty_map(),
    cons: fn(acc, edge) {
      extend_adjacency_for_reference_edge(
        acc: acc,
        edge: edge,
        module_to_path: module_to_path
      )
    }
  )
}

fn reference_closure(
  entry_path: String,
  edges: List<ReferenceResolutionFact>,
  nodes: List<ModuleDeclarationFact>
) -> FreeMonoid<String> {
  let adjacency = build_reference_adjacency(edges: edges, nodes: nodes)
  import_closure_bfs_walk(
    state: ImportClosureBfsState {
      reached: list_snoc_item(xs: no_paths, item: entry_path),
      queue: list_snoc_item(xs: no_paths, item: entry_path)
    },
    adjacency: adjacency
  )
}

fn reference_neighbor_paths_from_facts(
  facts: List<ReferenceResolutionFact>,
  module_to_path: Map<String, String>,
  acc: List<String>
) -> List<String> {
  fold_list(
    xs: facts,
    empty: acc,
    cons: fn(a, fact) {
      match map_lookup_where_rejected_unreachable(m: module_to_path, key: fact.reference_module) {
        Present { value: referenced_path } =>
          dedupe_snoc(acc: a, item: referenced_path, eq: string_eq)
        Absent => a
      }
    }
  )
}

fn reference_closure_bfs_parsed_walk(
  state: ImportClosureBfsState,
  declared: List<ModuleDeclarationFact>,
  module_to_path: Map<String, String>
) -> FreeMonoid<String> {
  match state.queue |> first {
    Absent => state.reached
    Present { value: path } =>
      let rest = state.queue |> skip(1)
      if contains(xs: state.reached, item: path, eq: string_eq) {
        reference_closure_bfs_parsed_walk(
          state: ImportClosureBfsState { reached: state.reached, queue: rest },
          declared: declared,
          module_to_path: module_to_path
        )
      } else {
        let census = reference_file_census(rel_path: path, declared: declared)
        if is_empty(xs: census.refusals) {
          let neighbors = reference_neighbor_paths_from_facts(
            facts: census.facts,
            module_to_path: module_to_path,
            acc: Empty
          )
          let next = bfs_absorb_neighbors(
            state: ImportClosureBfsState {
              reached: list_snoc_item(xs: state.reached, item: path),
              queue: rest
            },
            neighbors: neighbors
          )
          reference_closure_bfs_parsed_walk(
            state: next,
            declared: declared,
            module_to_path: module_to_path
          )
        } else {
          no_paths
        }
      }
  }
}

fn reference_closure_live_excluding(
  entry_path: String,
  pool_roots: List<String>,
  exclude_substrings: List<String>
) -> FreeMonoid<String> {
  let declared = module_declaration_facts_live(pool_roots: pool_roots)
  reference_closure_bfs_parsed_walk(
    state: ImportClosureBfsState {
      reached: no_paths,
      queue: list_snoc_item(xs: no_paths, item: entry_path)
    },
    declared: declared,
    module_to_path: build_module_to_path(nodes: declared)
  )
}

fn reference_closure_live(entry_path: String, pool_roots: List<String>) -> FreeMonoid<String> {
  reference_closure_live_excluding(
    entry_path: entry_path,
    pool_roots: pool_roots,
    exclude_substrings: module_graph_exclude_substrings
  )
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SingleAuthority }
}
