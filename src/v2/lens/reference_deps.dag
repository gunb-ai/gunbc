module v2.lens.reference_deps

import v2.std.node_query { find_labeled_child }
import v2.extdeps.languages.dag { dag_language_model, parse_production_emitted_identity_optional, qualified_name_from_module_node, dag_surface_edge_label }
import v2.std.algebra { fold_list, list_reverse }
import std.algebra { Cons, Empty, FreeMonoid }
import v2.compiler.name_resolve { Admission, Import, ImportVisible, ResolutionSubject, resolve_diagnostics }
import v2.std.diagnostic { Accepted, None, Outcome, Rejected, diagnostics_fatal_reason }
import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }
import std.disposition { SingleAuthority }

// THE PARSE-TREE REFERENCE WALKER IS RETIRED (replacement migration, DESIGN section 3).
// reference_sites_from_parsed_module keyed on ^dag_surface_qualified_name and the import
// productions and carried no postfix handling, so it silently missed a dotted callee and a
// qualified call argument -- measured by v2.test.claim.namespace_xl0.qualified_site_enumerator_differential,
// where the collector saw both and this walker saw neither (gunbc.recurring_failure_mode
// reference_reader_without_postfix_handling_drops_call_sites). Its census and its closure walk were a
// second edge producer beside v2.lens.module_graph dependency_resolution_facts_live, whose
// reference half is the collector (reference_derived_resolution_facts over collect_module_reference_sites)
// and whose import half is import_resolution_facts_live. Its closure functions went with
// test.claim.long.reference_closure_equivalence, their only consumer (gunbc#12910); what remains here
// is the module-ingest helper and the import-row reader admission_from_module_root consumes.

fn reference_deps_ingest_source_text(source_text: String, file: Symbol) -> Outcome<Node> {
  let lm = dag_language_model()
  bind_outcome(
    o: v2.compiler.tokenize.tokenize(text: source_text, file: file, rules: lm.lex),
    f: fn(token_stream) {
      bind_outcome(
        o: v2.compiler.parse.parse_module(tokens: token_stream, grammar: lm.grammar),
        f: fn(artifact) {
          outcome_accepted(value: artifact.tree)
        }
      )
    }
  )
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SingleAuthority }
}

// The import-row reader admission_from_module_root consumes. It reads IMPORT declarations, not
// reference sites, so it is not part of the retired walker.
fn reference_qn_from_import_decl_strict(node: Node, module_root: Node) -> Outcome<QualifiedName> {
  match parse_subtree_find_production_captured(
    root: node,
    emitted: ^dag_surface_qualified_name
  ) {
    ParseSubtreeAbsent =>
      match find_labeled_child(root: node, label: dag_surface_edge_label(edge: ^dag_surface_import_decl_qualified_name)) {
        Rejected { diagnostics: d } => v2.std.diagnostic.Rejected { diagnostics: d }
        Accepted { value: qn_node, diagnostics: _ } =>
          qualified_name_from_node(root: qn_node)
      }
    ParseSubtreeFound { captured: qn_capture } =>
      match parse_qualified_name_segments_from_capture(qn_capture: qn_capture, root: module_root) {
        Rejected { diagnostics: d } => v2.std.diagnostic.Rejected { diagnostics: d }
        Accepted { value: segments, diagnostics: _ } =>
          v2.extdeps.languages.dag.qualified_name_from_symbol_segments(segments: segments, root: module_root)
      }
  }
}

fn collect_import_decl_nodes(n: Node, acc: FreeMonoid<Node>) -> FreeMonoid<Node> {
  let here = match parse_production_emitted_identity_optional(node: n) {
    Present { value: id } =>
      if id == ^dag_surface_import_decl {
        Cons { head: n, tail: acc }
      } else {
        acc
      }
    Absent => acc
  }
  fold(n.children, init: here, f: fn(a, e) {
    collect_import_decl_nodes(n: e.target, acc: a)
  })
}

type ImportRowsState
  = ImportRowsFailed { reason: Symbol }
  | ImportRowsOk { rows: List<Import> }

fn import_rows_from_parsed_module(root: Node) -> ImportRowsState {
  let gathered = fold_list(
    xs: list_reverse(xs: collect_import_decl_nodes(n: root, acc: Empty)),
    empty: ImportRowsOk { rows: Empty },
    cons: fn(state, import_node) {
      match state {
        ImportRowsFailed { reason: r } => ImportRowsFailed { reason: r }
        ImportRowsOk { rows: prior } =>
          match reference_qn_from_import_decl_strict(node: import_node, module_root: root) {
            Rejected { diagnostics: d } => ImportRowsFailed { reason: diagnostics_fatal_reason(d: d) }
            Accepted { value: target_qn, diagnostics: _ } =>
              ImportRowsOk {
                rows: Cons {
                  head: Import { target: target_qn, visibility: ImportVisible },
                  tail: prior
                }
              }
          }
      }
    }
  )
  match gathered {
    ImportRowsFailed { reason: r } => ImportRowsFailed { reason: r }
    ImportRowsOk { rows: rev } => ImportRowsOk { rows: list_reverse(xs: rev) }
  }
}

fn admission_from_module_root(root: Node) -> Outcome<Admission> {
  match qualified_name_from_module_node(root: root) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: subject_qn, diagnostics: _ } =>
      match import_rows_from_parsed_module(root: root) {
        ImportRowsFailed { reason: r } =>
          Rejected { diagnostics: resolve_diagnostics(reason: r) }
        ImportRowsOk { rows: rows } =>
          Accepted {
            value: Admission {
              subject: ResolutionSubject { name: subject_qn },
              imports: rows
            },
            diagnostics: None
          }
      }
  }
}
