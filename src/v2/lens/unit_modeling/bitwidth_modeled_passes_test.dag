module v2.test.lens_unit_modeling.bitwidth_modeled_passes

import v2.lens.unit_modeling { unit_modeling_gate }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Symbol,
  TypeNode,
  SyntheticOccurrence
}
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data bitwidth_carrier_target: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^BitWidth } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data bitwidth_modeled_input: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^pointer_width },
      target: bitwidth_carrier_target
    }
  ],
  occurrence_id: SyntheticOccurrence
}

test fn bitwidth_modeled_passes_holds() -> Bool {
  match unit_modeling_gate(node: bitwidth_modeled_input) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn bitwidth_modeled_passes_rhs() -> Node {
  if bitwidth_modeled_passes_holds() {
    bitwidth_modeled_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
    }
  }
}

data claim_bitwidth_modeled_passes: TestClaim = EqualsClaim {
  label: "lens_unit_modeling/bitwidth_pass: pointer_width attached to BitWidth carrier is accepted",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: bitwidth_modeled_input,
  rhs: bitwidth_modeled_passes_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}