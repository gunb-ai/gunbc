module v2.test.lens_unit_modeling.bitwidth_modeled_passes


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data bitwidth_carrier_target: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^BitWidth } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data bitwidth_modeled_input: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
  children: [
    v2.std.node.Edge {
      label: v2.std.node.Named { name: ^pointer_width },
      target: bitwidth_carrier_target
    }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

test fn bitwidth_modeled_passes_holds() -> Bool {
  match v2.lens.unit_modeling.unit_modeling_gate(node: bitwidth_modeled_input) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}


