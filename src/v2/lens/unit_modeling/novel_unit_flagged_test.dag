module v2.test.lens_unit_modeling.novel_unit_flagged

import v2.lens.unit_modeling { unit_modeling_gate }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Symbol,
  TypeNode,
  SyntheticOccurrence
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data int_leaf_target_novel: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^dag_binding_type_int } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data novel_unit_input: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^throughput },
      target: int_leaf_target_novel
    }
  ],
  occurrence_id: SyntheticOccurrence
}

test fn novel_unit_flagged_holds() -> Bool {
  match unit_modeling_gate(node: novel_unit_input) {
    Rejected { diagnostics: r } => r.head.reason == ^unit_modeling_flat_scalar_blocked_pending_carrier
    Accepted { value: _, diagnostics: _ } => false
  }
}


