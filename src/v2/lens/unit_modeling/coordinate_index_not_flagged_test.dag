module v2.test.lens_unit_modeling.coordinate_index_not_flagged


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data int_leaf_target_coord: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^dag_binding_type_int } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data coordinate_field_input: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^index },
      target: int_leaf_target_coord
    }
  ],
  occurrence_id: SyntheticOccurrence
}

test fn coordinate_index_not_flagged_holds() -> Bool {
  match unit_modeling_gate(node: coordinate_field_input) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn coordinate_index_not_flagged_rhs() -> Node {
  if coordinate_index_not_flagged_holds() {
    coordinate_field_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
    }
  }
}

data claim_coordinate_index_not_flagged: TestClaim = EqualsClaim {
  label: "lens_unit_modeling/coordinate: index:Int (coordinate) is not flagged",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: coordinate_field_input,
  rhs: coordinate_index_not_flagged_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
