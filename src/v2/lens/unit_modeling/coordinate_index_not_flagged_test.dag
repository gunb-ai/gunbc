module v2.test.lens_unit_modeling.coordinate_index_not_flagged


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data int_leaf_target_coord: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^dag_binding_type_int } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data coordinate_field_input: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [
    v2.std.node.Edge {
      label: v2.std.node.Named { name: ^index },
      target: int_leaf_target_coord
    }
  ],
  occurrence_id: SyntheticOccurrence
}

test fn coordinate_index_not_flagged_holds() -> v2.std.logic.Bool {
  match unit_modeling_gate(node: coordinate_field_input) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}


