module v2.test.lens_unit_modeling.coordinate_index_not_flagged


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data int_leaf_target_coord: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^dag_binding_type_int } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data coordinate_field_input: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
  children: [
    v2.std.node.Edge {
      label: v2.std.node.Named { name: ^index },
      target: int_leaf_target_coord
    }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

test fn coordinate_index_not_flagged_holds() -> Bool {
  match v2.lens.unit_modeling.unit_modeling_gate(node: coordinate_field_input) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}


