module v2.test.lens_unit_modeling.flat_scalar_unit_leaf_flagged

import v2.lens.unit_modeling { unit_modeling_gate }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Symbol,
  TypeNode,
  SyntheticOccurrence
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data int_leaf_target: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^dag_binding_type_int } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data flat_scalar_unit_leaf_input: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^ram_bytes },
      target: int_leaf_target
    }
  ],
  occurrence_id: SyntheticOccurrence
}

test fn flat_scalar_unit_leaf_flagged_holds() -> Bool {
  match unit_modeling_gate(node: flat_scalar_unit_leaf_input) {
    Rejected { diagnostics: r } => r.head.reason == ^unit_modeling_flat_scalar_unit_leaf_fixable
    Accepted { value: _, diagnostics: _ } => false
  }
}


