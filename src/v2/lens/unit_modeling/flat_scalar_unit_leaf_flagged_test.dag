module v2.test.lens_unit_modeling.flat_scalar_unit_leaf_flagged


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data int_leaf_target: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^dag_binding_type_int } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data flat_scalar_unit_leaf_input: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
  children: [
    v2.std.node.Edge {
      label: v2.std.node.Named { name: ^ram_bytes },
      target: int_leaf_target
    }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

test fn flat_scalar_unit_leaf_flagged_holds() -> Bool {
  match v2.lens.unit_modeling.unit_modeling_gate(node: flat_scalar_unit_leaf_input) {
    v2.std.diagnostic.Rejected { diagnostics: r } => r.head.reason == ^unit_modeling_flat_scalar_unit_leaf_fixable
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
  }
}


