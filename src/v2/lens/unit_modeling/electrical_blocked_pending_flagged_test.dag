// Scope: B1 unit-modeling lens — electrical / two-class witness. Under the
//        inverted predicate a GATE-N-pending electrical field (`tdp_watts`) typed
//        as a bare kernel `Int` IS FLAGGED (a quantity is a quantity regardless of
//        whether its carrier exists yet — exempting it would reintroduce the
//        false-negative the inversion kills). Because Power has no carrier in the
//        hint map, the flag is the BLOCKED-PENDING-CARRIER class — the honest
//        reconciliation is to escalate the upstream carrier gate (M12 / Practice
//        13), not to suppress the flag. Proves the blocked-pending diagnostic
//        class the §4 census drains-pending-substrate from.

module v2.test.lens_unit_modeling.electrical_blocked_pending_flagged

import v2.lens.unit_modeling { unit_modeling_gate }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Symbol,
  TypeNode,
  SyntheticOccurrence
}
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}

data int_leaf_target_elec: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^dag_binding_type_int } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data electrical_field_input: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^tdp_watts },
      target: int_leaf_target_elec
    }
  ],
  occurrence_id: SyntheticOccurrence
}

test fn electrical_blocked_pending_flagged_holds() -> Bool {
  match unit_modeling_gate(node: electrical_field_input) {
    Rejected { diagnostics: r } => r.head.reason == ^unit_modeling_flat_scalar_blocked_pending_carrier
    Accepted { value: _, diagnostics: _ } => false
  }
}

fn electrical_blocked_pending_flagged_rhs() -> Node {
  if electrical_blocked_pending_flagged_holds() {
    electrical_field_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
    }
  }
}

data claim_electrical_blocked_pending_flagged: TestClaim = EqualsClaim {
  label: "lens_unit_modeling/electrical: tdp_watts:Int is flagged (blocked-pending-carrier class)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: electrical_field_input,
  rhs: electrical_blocked_pending_flagged_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
