module v2.test.lens_unit_modeling.unit_modeling_blocked_via_always_required_lenses

import v2.compiler.compile {
  always_required_lenses,
  run_required_lens_gates
}
import v2.compiler.infer { InferredTree }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Symbol,
  TypeNode,
  SyntheticOccurrence
}
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v2.test.lens_common.infer_fixture {
  claim_atom_node,
  claim_inferred_facts,
  claim_inferred_tree
}

data unit_ar_int_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^dag_binding_type_int } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data unit_ar_root: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^ram_bytes },
      target: unit_ar_int_leaf
    }
  ],
  occurrence_id: SyntheticOccurrence
}

data unit_ar_authority: Node = claim_atom_node(s: ^unit_ar_symbol)

fn unit_ar_tree() -> InferredTree {
  claim_inferred_tree(
    root: unit_ar_root,
    facts: claim_inferred_facts(
      type_symbol: ^unit_ar_type_sym,
      algebra_symbol: ^unit_ar_algebra_sym,
      descent_symbol: ^unit_ar_descent_sym
    )
  )
}

test fn unit_modeling_blocked_via_always_required_lenses_holds() -> Bool {
  match run_required_lens_gates(
    inferred: unit_ar_tree(),
    lenses: always_required_lenses()
  ) {
    Rejected { diagnostics: r } => r.head.reason == ^unit_modeling_flat_scalar_unit_leaf_fixable
    Accepted { value: _, diagnostics: _ } => false
  }
}

fn unit_modeling_blocked_via_always_required_lenses_rhs() -> Node {
  if unit_modeling_blocked_via_always_required_lenses_holds() {
    unit_ar_authority
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
    }
  }
}

data claim_unit_modeling_blocked_via_always_required_lenses: TestClaim = EqualsClaim {
  label: "lens_unit_modeling/unit_modeling_blocked_via_always_required_lenses: always_required_lenses() (wired into validate_then_compile) rejects a fact-bearing flat-scalar unit leaf with the unit-modeling reason",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: unit_ar_authority,
  rhs: unit_modeling_blocked_via_always_required_lenses_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
