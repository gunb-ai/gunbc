module v2.test.lens_unit_modeling.unit_modeling_blocked_via_always_required_lenses

import v2.compiler.compile {
  always_required_lenses,
  run_required_lens_gates
}
import v2.compiler.infer { InferredTree }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Symbol,
  TypeNode,
  SyntheticOccurrence
}
import v2.test.lens_common.infer_fixture {
  claim_atom_node,
  claim_inferred_facts,
  claim_inferred_tree
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data unit_ar_int_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^dag_binding_type_int } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data unit_ar_root: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^ram_bytes },
      target: unit_ar_int_leaf
    }
  ],
  occurrence_id: SyntheticOccurrence
}

data unit_ar_authority: Node = claim_atom_node(s: ^unit_ar_symbol)

fn unit_ar_tree() -> InferredTree {
  claim_inferred_tree(
    root: unit_ar_root,
    facts: claim_inferred_facts(
      type_symbol: ^unit_ar_type_sym,
      algebra_symbol: ^unit_ar_algebra_sym,
      descent_symbol: ^unit_ar_descent_sym
    )
  )
}

test fn unit_modeling_blocked_via_always_required_lenses_holds() -> Bool {
  match run_required_lens_gates(
    inferred: unit_ar_tree(),
    lenses: always_required_lenses()
  ) {
    Rejected { diagnostics: r } => r.head.reason == ^unit_modeling_flat_scalar_unit_leaf_fixable
    Accepted { value: _, diagnostics: _ } => false
  }
}


