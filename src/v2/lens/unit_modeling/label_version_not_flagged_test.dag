module v2.test.lens_unit_modeling.label_version_not_flagged


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data int_leaf_target_label: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^dag_binding_type_int } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data label_field_input: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
  children: [
    v2.std.node.Edge {
      label: v2.std.node.Named { name: ^version },
      target: int_leaf_target_label
    }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

test fn label_version_not_flagged_holds() -> Bool {
  match v2.lens.unit_modeling.unit_modeling_gate(node: label_field_input) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}


