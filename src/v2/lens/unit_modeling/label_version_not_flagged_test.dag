module v2.test.lens_unit_modeling.label_version_not_flagged


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data int_leaf_target_label: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^dag_binding_type_int } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data label_field_input: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [
    v2.std.node.Edge {
      label: Named { name: ^version },
      target: int_leaf_target_label
    }
  ],
  occurrence_id: SyntheticOccurrence
}

test fn label_version_not_flagged_holds() -> Bool {
  match unit_modeling_gate(node: label_field_input) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}


