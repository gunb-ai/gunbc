module v2.test.lens_unit_modeling.label_version_not_flagged

import v2.lens.unit_modeling { unit_modeling_gate }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Symbol,
  TypeNode,
  SyntheticOccurrence
}
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data int_leaf_target_label: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^dag_binding_type_int } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data label_field_input: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^version },
      target: int_leaf_target_label
    }
  ],
  occurrence_id: SyntheticOccurrence
}

test fn label_version_not_flagged_holds() -> Bool {
  match unit_modeling_gate(node: label_field_input) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn label_version_not_flagged_rhs() -> Node {
  if label_version_not_flagged_holds() {
    label_field_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
    }
  }
}

data claim_label_version_not_flagged: TestClaim = EqualsClaim {
  label: "lens_unit_modeling/label: version:Int (label) is not flagged",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: label_field_input,
  rhs: label_version_not_flagged_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
