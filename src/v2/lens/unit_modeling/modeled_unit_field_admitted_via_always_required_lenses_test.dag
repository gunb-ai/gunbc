module v2.test.lens_unit_modeling.modeled_unit_field_admitted_via_always_required_lenses


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data unit_ar_pass_carrier_target: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^ByteSize } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data unit_ar_pass_root: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [
    v2.std.node.Edge {
      label: v2.std.node.Named { name: ^ram_bytes },
      target: unit_ar_pass_carrier_target
    }
  ],
  occurrence_id: SyntheticOccurrence
}

data unit_ar_pass_authority: v2.std.node.Node = claim_atom_node(s: ^unit_ar_pass_symbol)

fn unit_ar_pass_tree() -> v2.compiler.inferred_tree.InferredTree {
  claim_inferred_tree(
    root: unit_ar_pass_root,
    facts: claim_inferred_facts(
      type_symbol: ^unit_ar_pass_type_sym,
      algebra_symbol: ^unit_ar_pass_algebra_sym,
      descent_symbol: ^unit_ar_pass_descent_sym
    )
  )
}

test fn modeled_unit_field_admitted_via_always_required_lenses_holds() -> v2.std.logic.Bool {
  match run_required_lens_gates(
    inferred: unit_ar_pass_tree(),
    lenses: always_required_lenses()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}


