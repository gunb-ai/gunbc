module v2.test.lens_unit_modeling.modeled_unit_field_passes

import v2.lens.unit_modeling { unit_modeling_gate }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Symbol,
  TypeNode,
  SyntheticOccurrence
}
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data bytesize_carrier_target: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^ByteSize } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data modeled_unit_field_input: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^ram_bytes },
      target: bytesize_carrier_target
    }
  ],
  occurrence_id: SyntheticOccurrence
}

test fn modeled_unit_field_passes_holds() -> Bool {
  match unit_modeling_gate(node: modeled_unit_field_input) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn modeled_unit_field_passes_rhs() -> Node {
  if modeled_unit_field_passes_holds() {
    modeled_unit_field_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
    }
  }
}

data claim_modeled_unit_field_passes: TestClaim = EqualsClaim {
  label: "lens_unit_modeling/pass: ram_bytes attached to ByteSize carrier is accepted",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: modeled_unit_field_input,
  rhs: modeled_unit_field_passes_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
