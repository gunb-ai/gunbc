module v2.test.lens_unit_modeling.modeled_unit_field_passes


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data bytesize_carrier_target: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^ByteSize } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data modeled_unit_field_input: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^ram_bytes },
      target: bytesize_carrier_target
    }
  ],
  occurrence_id: SyntheticOccurrence
}

test fn modeled_unit_field_passes_holds() -> Bool {
  match unit_modeling_gate(node: modeled_unit_field_input) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}


