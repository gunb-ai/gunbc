module v2.test.lens_unit_modeling.modeled_unit_field_passes


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data bytesize_carrier_target: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^ByteSize } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data modeled_unit_field_input: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
  children: [
    v2.std.node.Edge {
      label: v2.std.node.Named { name: ^ram_bytes },
      target: bytesize_carrier_target
    }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

test fn modeled_unit_field_passes_holds() -> Bool {
  match v2.lens.unit_modeling.unit_modeling_gate(node: modeled_unit_field_input) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}


