module v2.lens.determinism

import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }
import std.disposition { SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.determinism { Determinism, Deterministic, NonDeterministic, determinism_compose }
import std.algebra { Cons, Empty }
import v2.std.determinism { DeterminismFact }
import v2.std.collection {
  List,
  list_at_optional
}
import v2.std.optional {
  Absent,
  Optional,
  Present,
  optional_absent,
  optional_present
}
import v2.std.diagnostic { Diagnostic, ExternalContractUnknown, NonEmptyDiagnostics, Outcome, Rejected, Unavailable, node_locus, outcome_accepted }
import v2.std.logic { Bool }
import v2.std.node { Atom, Edge, Node, NodeFold, Symbol, TypeNode, fold_node }
import v2.std.node_query { node_is_call, node_positional_child_targets }
import v2.std.witness { Holds, Violates, Witness }

type DeterminismRoot {
  signature: Symbol,
  source: DeclarationRef,
  citation: String
}

fn map_keys_leak_source() -> DeclarationRef {
  DeclarationRef {
    module_path: "v1.runtime_rust",
    decl_name: "map_keys",
    field: WholeDeclaration
  }
}

fn map_values_leak_source() -> DeclarationRef {
  DeclarationRef {
    module_path: "v1.runtime_rust",
    decl_name: "map_values",
    field: WholeDeclaration
  }
}

data determinism_root_keys: DeterminismRoot = DeterminismRoot {
  signature: ^keys,
  source: map_keys_leak_source(),
  citation: "keys exposes the same host-unspecified Map key iteration as v1.runtime_rust map_keys."
}

data determinism_root_map_keys: DeterminismRoot = DeterminismRoot {
  signature: ^map_keys,
  source: map_keys_leak_source(),
  citation: "map_keys exposes host-unspecified Map key iteration."
}

data determinism_root_values: DeterminismRoot = DeterminismRoot {
  signature: ^values,
  source: map_values_leak_source(),
  citation: "values exposes the same host-unspecified Map value iteration as v1.runtime_rust map_values."
}

data determinism_root_map_values: DeterminismRoot = DeterminismRoot {
  signature: ^map_values,
  source: map_values_leak_source(),
  citation: "map_values exposes host-unspecified Map value iteration."
}

data determinism_root_registry: List<DeterminismRoot> = [
  determinism_root_keys,
  determinism_root_map_keys,
  determinism_root_values,
  determinism_root_map_values
]

fn determinism_root_for_symbol(registry: List<DeterminismRoot>, s: Symbol) -> Optional<DeterminismRoot> {
  fold(registry, init: optional_absent(), f: fn(acc, row) {
    match acc {
      Present { value: _ } => acc
      Absent => if row.signature == s { optional_present(value: row) } else { optional_absent() }
    }
  })
}

fn node_callee_symbol(n: Node) -> Optional<Symbol> {
  if node_is_call(node: n) {
    match list_at_optional(xs: node_positional_child_targets(node: n), index: 0) {
      Present { value: callee } => match callee.kind {
        TypeNode { connective: Atom { identity: sym } } => optional_present(value: sym)
        _ => optional_absent()
      }
      Absent => optional_absent()
    }
  } else {
    optional_absent()
  }
}

fn local_determinism_axis(n: Node) -> std.determinism.Determinism {
  match node_callee_symbol(n: n) {
    Present { value: sym } => match determinism_root_for_symbol(registry: determinism_root_registry, s: sym) {
      Present { value: root } => std.determinism.NonDeterministic { source: root.source }
      Absent => std.determinism.Deterministic
    }
    Absent => std.determinism.Deterministic
  }
}

fn determinism_axis_fold_step(acc: std.determinism.Determinism, _: Edge, child: std.determinism.Determinism) -> std.determinism.Determinism {
  std.determinism.determinism_compose(outer: acc, inner: child)
}

fn determinism_axis_for_node(n: Node) -> std.determinism.Determinism {
  fold_node(
    n: n,
    algebra: NodeFold {
      init: fn(n0) { local_determinism_axis(n: n0) },
      step: fn(acc, e, child) { determinism_axis_fold_step(acc: acc, e: e, child: child) }
    }
  )
}

fn determinism_fact_for_node(signature: Symbol, n: Node) -> v2.std.determinism.DeterminismFact {
  v2.std.determinism.DeterminismFact {
    signature: signature,
    classification: determinism_axis_for_node(n: n)
  }
}

fn determinism_leak_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^determinism_nondeterministic_root_reach,
    at: node_locus(node: n),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn determinism_contract_witness(signature: Symbol, n: Node) -> Witness<v2.std.determinism.DeterminismFact> {
  let fact = determinism_fact_for_node(signature: signature, n: n)
  match fact.classification {
    std.determinism.NonDeterministic { source: _ } => Violates { diagnostic: determinism_leak_diagnostic(n: n) }
    std.determinism.Deterministic => Holds { value: fact }
  }
}

data compile_gate_law: String = "INTERIM CONTAINMENT, mechanically preventive for the registered roots — not repository-complete structural determinism. The former one-row registry asserted map_keys was the one readable nondeterministic atom and therefore could not miss a root. That premise was false: the existing std.algebra PartialFunction surface also exposes keys, values, and map_values, and the v1 runtime realizes all four through host map iteration. These four known hazards are directly registered, so a reach from any of them fails compilation over the floor compile scope. The broader denominator is still open: operations reach compiled trees through at least algebra templates, v1.compiler.infer_method builtin_function_registry, native v1_interpreter dispatch arms, PrimitiveContract rows, and target emit handlers. A complete wall requires one PrimitiveDefinition identity joining those surfaces; until that lands, an unregistered future helper is not claimed safe and absence from this registry is not evidence of determinism. This honest rung replaces the old repository-complete construction claim while closing every presently identified host-unspecified Map projection. Prefer retaining meaningful first-seen order beside a membership map, as PR 7515 does, over reconstructing a value order from the map; there is no universal sorted_map_values operation. Grain: root — one rooted whole-tree findings walk collects one located diagnostic per registered host-unspecified-order call node. Every registered leak is typed, located, batched, and never absorbed."

fn local_determinism_findings(n: Node) -> List<Diagnostic> {
  match local_determinism_axis(n: n) {
    std.determinism.NonDeterministic { source: _ } => [determinism_leak_diagnostic(n: n)]
    std.determinism.Deterministic => []
  }
}

fn determinism_findings(root: Node) -> List<Diagnostic> {
  fold_node(
    n: root,
    algebra: NodeFold {
      init: fn(n0) { local_determinism_findings(n: n0) },
      step: fn(acc, _edge, child) { concat(acc, child) }
    }
  )
}

fn determinism_compile_gate(node: Node) -> Outcome<Witness<Node>> {
  match determinism_findings(root: node) {
    Cons { head: first, tail: rest } =>
      Rejected {
        diagnostics: NonEmptyDiagnostics { head: first, tail: rest }
      }
    Empty => outcome_accepted(value: Holds { value: node })
  }
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SingleAuthority }
}
