// src/v2/lens/synthesis.dag
//
// Scope: cross-algorithm complexity lens — surface that the user's
//        realization's lens-DERIVED cost EXCEEDS the declared I/O
//        relation's structurally-derived complexity LOWER BOUND (a
//        provable GAP to the optimum). It does NOT construct, name, or
//        prove the existence of a specific faster program — the optimal
//        realization can be unknown (e.g. matmul ω) and fabricating one
//        would violate feedback_no_engine. Distinct from
//        lens/complexity.dag (same-algorithm tightness); synthesis
//        compares derived cost against the relation's lower bound via the
//        closed LowerBoundTechnique set (see Owns; C2 reframe 2026-05-15).
// Anchor: https://en.wikipedia.org/wiki/Program_synthesis +
//         docs/r4-carve-out-routing.md C7 (advisory carrier, NOT fail-closed
//         Diagnostic; algorithm choice is design-tier — programmer decides)
//
// Status: filled.

module v2.lens.synthesis
import v2.lens.common.construction_justification { ConstructionJustification, RatchetForever }


import v2.lens.application { AdvisoryLens }
import v2.lens.complexity {
  ComplexityBound,
  SizedLinearClass,
  SizedLinearithmicClass,
  complexity_lens,
  complexity_bound_class,
  single_complexity_variable,
  sized_complexity
}
import v2.lens.cost {
  ClassLinear,
  ClassLinearithmic,
  SizeVariable,
  asymptotic_class_dominates
}
import v2.std.algebra { Cons, Empty }
import v2.std.collection { List }
import v2.std.diagnostic {
  AmbiguousIntent,
  Diagnostic,
  Locus,
  Unavailable,
  node_locus
}
import v2.std.node { Node, Symbol }
import v2.std.report { Report, SynthesisGapDecisionTree, SynthesisGapInformationTheoretic }
import v2.std.witness { Holds, Violates }
// 🟢 coproduct — closed set. STOP-and-escalate if a 6th variant is needed.
type LowerBoundTechnique
  = DecisionTree
  | AlgebraicRank
  | AdversaryCommunication
  | InformationTheoretic
  | ReductionConditional

// 🟢 product — declared relation class + applicable technique.
type DeclaredRelationBound {
  technique: LowerBoundTechnique
  lower_bound: ComplexityBound
  relation_locus: Locus
}

// 🟢 coproduct — outcome of one synthesis probe.
type SynthesisOutcome
  = SynthesisGap {
      realization_cost: ComplexityBound
      lower_bound: DeclaredRelationBound
      report: Report
    }
  | SynthesisOptimal {
      realization_cost: ComplexityBound
      lower_bound: DeclaredRelationBound
    }
  | SynthesisNoTechnique {
      diagnostic: Diagnostic
    }


fn synthesis_no_technique_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^synthesis_no_technique_reason_symbol,
    at: node_locus(node: n),
    correction: Unavailable { reason: AmbiguousIntent }
  }
}

fn decision_tree_declared_bound(n: Node) -> DeclaredRelationBound {
  DeclaredRelationBound {
    technique: DecisionTree,
    lower_bound: sized_complexity(
      class: SizedLinearithmicClass,
      variables: single_complexity_variable(size_var: SizeVariable { source: n })
    ),
    relation_locus: node_locus(node: n)
  }
}

fn information_theoretic_declared_bound(n: Node) -> DeclaredRelationBound {
  DeclaredRelationBound {
    technique: InformationTheoretic,
    lower_bound: sized_complexity(
      class: SizedLinearClass,
      variables: single_complexity_variable(size_var: SizeVariable { source: n })
    ),
    relation_locus: node_locus(node: n)
  }
}

// DecisionTree: realization > Θ(n log n) → gap (asymptotic_class_dominates is strict for ClassLinearithmic).
fn assess_decision_tree(n: Node, realization: ComplexityBound) -> SynthesisOutcome {
  if asymptotic_class_dominates(
    a: complexity_bound_class(b: realization),
    b: ClassLinearithmic
  ) {
    SynthesisGap {
      realization_cost: realization,
      lower_bound: decision_tree_declared_bound(n: n),
      report: Report {
        reason: SynthesisGapDecisionTree,
        at: node_locus(node: n)
      }
    }
  } else {
    SynthesisOptimal {
      realization_cost: realization,
      lower_bound: decision_tree_declared_bound(n: n)
    }
  }
}

// 🟡 parser-posture gated — strict-greater check uses double dominance until equality in if-conditions parses cleanly.
fn assess_information_theoretic(n: Node, realization: ComplexityBound) -> SynthesisOutcome {
  if asymptotic_class_dominates(
    a: complexity_bound_class(b: realization),
    b: ClassLinear
  ) {
    if asymptotic_class_dominates(
      a: ClassLinear,
      b: complexity_bound_class(b: realization)
    ) {
      SynthesisOptimal {
        realization_cost: realization,
        lower_bound: information_theoretic_declared_bound(n: n)
      }
    } else {
      SynthesisGap {
        realization_cost: realization,
        lower_bound: information_theoretic_declared_bound(n: n),
        report: Report {
          reason: SynthesisGapInformationTheoretic,
          at: node_locus(node: n)
        }
      }
    }
  } else {
    // Realization is sub-linear: InformationTheoretic has no lower-bound comparison for this class.
    SynthesisNoTechnique {
      diagnostic: synthesis_no_technique_diagnostic(n: n)
    }
  }
}

fn outcome_to_reports(outcome: SynthesisOutcome) -> List<Report> {
  match outcome {
    SynthesisGap { realization_cost: _, lower_bound: _, report: r } =>
      Cons { head: r, tail: Empty }
    SynthesisOptimal { realization_cost: _, lower_bound: _ } => Empty
    SynthesisNoTechnique { diagnostic: _ } => Empty
  }
}

fn outcome_to_diagnostics(outcome: SynthesisOutcome) -> List<Diagnostic> {
  match outcome {
    SynthesisGap { realization_cost: _, lower_bound: _, report: _ } => Empty
    SynthesisOptimal { realization_cost: _, lower_bound: _ } => Empty
    SynthesisNoTechnique { diagnostic: d } => Cons { head: d, tail: Empty }
  }
}

// Caller DECLARES declared_technique — the technique the caller's I/O relation class
// is subject to. Probes only run for the declared technique; no unconditional sweep.
// AlgebraicRank / AdversaryCommunication / ReductionConditional → SynthesisNoTechnique with
// honest diagnostic. Terminal: no worked example is planned here; these techniques route through
// the diagnostic channel by design. Adding a 4th worked-example technique requires a new
// LowerBoundTechnique variant, which is STOP-and-escalate-gated (see 🟢 mark above).
fn synthesis_lens(n: Node, declared_technique: LowerBoundTechnique) -> List<Report> {
  match complexity_lens(n: n) {
    Violates { diagnostic: _ } => Empty
    Holds { value: realization } =>
      match declared_technique {
        DecisionTree =>
          outcome_to_reports(outcome: assess_decision_tree(n: n, realization: realization))
        AlgebraicRank =>
          outcome_to_reports(outcome: SynthesisNoTechnique { diagnostic: synthesis_no_technique_diagnostic(n: n) })
        AdversaryCommunication =>
          outcome_to_reports(outcome: SynthesisNoTechnique { diagnostic: synthesis_no_technique_diagnostic(n: n) })
        InformationTheoretic =>
          outcome_to_reports(outcome: assess_information_theoretic(n: n, realization: realization))
        ReductionConditional =>
          outcome_to_reports(outcome: SynthesisNoTechnique { diagnostic: synthesis_no_technique_diagnostic(n: n) })
      }
  }
}

fn decision_tree_synthesis_lens_read(n: Node) -> List<Report> {
  synthesis_lens(n: n, declared_technique: DecisionTree)
}

data decision_tree_synthesis_advisory_lens: AdvisoryLens = AdvisoryLens {
  read: decision_tree_synthesis_lens_read
}

fn information_theoretic_synthesis_lens_read(n: Node) -> List<Report> {
  synthesis_lens(n: n, declared_technique: InformationTheoretic)
}

data information_theoretic_synthesis_advisory_lens: AdvisoryLens = AdvisoryLens {
  read: information_theoretic_synthesis_lens_read
}

// Companion: surfaces diagnostics for the declared technique — both upstream complexity
// failures and SynthesisNoTechnique cases. Complexity Violates propagates here so callers
// do not need to call complexity_lens separately to detect upstream failure.
fn synthesis_lens_diagnostics(n: Node, declared_technique: LowerBoundTechnique) -> List<Diagnostic> {
  match complexity_lens(n: n) {
    Violates { diagnostic: d } => Cons { head: d, tail: Empty }
    Holds { value: realization } =>
      match declared_technique {
        DecisionTree =>
          outcome_to_diagnostics(outcome: assess_decision_tree(n: n, realization: realization))
        AlgebraicRank =>
          outcome_to_diagnostics(outcome: SynthesisNoTechnique { diagnostic: synthesis_no_technique_diagnostic(n: n) })
        AdversaryCommunication =>
          outcome_to_diagnostics(outcome: SynthesisNoTechnique { diagnostic: synthesis_no_technique_diagnostic(n: n) })
        InformationTheoretic =>
          outcome_to_diagnostics(outcome: assess_information_theoretic(n: n, realization: realization))
        ReductionConditional =>
          outcome_to_diagnostics(outcome: SynthesisNoTechnique { diagnostic: synthesis_no_technique_diagnostic(n: n) })
      }
  }
}

// Construction-justification (DESIGN sec 5/sec 6, ROADMAP sec 0): why this is a lens
// (validation) and not construction. Layered ON TOP of the #5433 inert-lens backstop.
data construction_justification: ConstructionJustification = ConstructionJustification {
  class: RatchetForever {
    undecidable_because: "producing a specific faster realization has no constructive patch (feedback_no_engine) -- the optimum can be unknown (e.g. matmul omega), so a lower-bound GAP is provable but the closing program is not"
  },
  rationale: "Surfacing that a realization's cost exceeds the I/O relation's complexity lower bound is decidable, but the faster program that would close the gap cannot be constructed -- a permanent residue, distinct from same-algorithm complexity tightness."
}
