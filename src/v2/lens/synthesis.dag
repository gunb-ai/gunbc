module v2.lens.synthesis


type LowerBoundTechnique
  = DecisionTree
  | AlgebraicRank
  | AdversaryCommunication
  | InformationTheoretic
  | ReductionConditional

type DeclaredRelationBound {
  technique: LowerBoundTechnique
  lower_bound: v2.lens.complexity.ComplexityBound
  relation_locus: v2.std.diagnostic.Locus
}

type SynthesisOutcome
  = SynthesisGap {
      realization_cost: v2.lens.complexity.ComplexityBound
      lower_bound: DeclaredRelationBound
      report: v2.std.report.Report
    }
  | SynthesisOptimal {
      realization_cost: v2.lens.complexity.ComplexityBound
      lower_bound: DeclaredRelationBound
    }
  | SynthesisNoTechnique {
      diagnostic: v2.std.diagnostic.Diagnostic
    }

fn synthesis_no_technique_diagnostic(n: Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^synthesis_no_technique_reason_symbol,
    at: node_locus(node: n),
    correction: v2.std.diagnostic.Unavailable { reason: AmbiguousIntent }
  }
}

fn decision_tree_declared_bound(n: Node) -> DeclaredRelationBound {
  DeclaredRelationBound {
    technique: DecisionTree,
    lower_bound: sized_complexity(
      class: SizedLinearithmicClass,
      variables: single_complexity_variable(size_var: v2.lens.cost.SizeVariable { source: n })
    ),
    relation_locus: node_locus(node: n)
  }
}

fn information_theoretic_declared_bound(n: Node) -> DeclaredRelationBound {
  DeclaredRelationBound {
    technique: InformationTheoretic,
    lower_bound: sized_complexity(
      class: SizedLinearClass,
      variables: single_complexity_variable(size_var: v2.lens.cost.SizeVariable { source: n })
    ),
    relation_locus: node_locus(node: n)
  }
}

fn assess_decision_tree(n: Node, realization: v2.lens.complexity.ComplexityBound) -> SynthesisOutcome {
  if asymptotic_class_dominates(
    a: complexity_bound_class(b: realization),
    b: ClassLinearithmic
  ) {
    SynthesisGap {
      realization_cost: realization,
      lower_bound: decision_tree_declared_bound(n: n),
      report: v2.std.report.Report {
        reason: SynthesisGapDecisionTree,
        at: node_locus(node: n)
      }
    }
  } else {
    SynthesisOptimal {
      realization_cost: realization,
      lower_bound: decision_tree_declared_bound(n: n)
    }
  }
}

fn assess_information_theoretic(n: Node, realization: v2.lens.complexity.ComplexityBound) -> SynthesisOutcome {
  if asymptotic_class_dominates(
    a: complexity_bound_class(b: realization),
    b: ClassLinear
  ) {
    if asymptotic_class_dominates(
      a: ClassLinear,
      b: complexity_bound_class(b: realization)
    ) {
      SynthesisOptimal {
        realization_cost: realization,
        lower_bound: information_theoretic_declared_bound(n: n)
      }
    } else {
      SynthesisGap {
        realization_cost: realization,
        lower_bound: information_theoretic_declared_bound(n: n),
        report: v2.std.report.Report {
          reason: SynthesisGapInformationTheoretic,
          at: node_locus(node: n)
        }
      }
    }
  } else {

    SynthesisNoTechnique {
      diagnostic: synthesis_no_technique_diagnostic(n: n)
    }
  }
}

fn outcome_to_reports(outcome: SynthesisOutcome) -> List<v2.std.report.Report> {
  match outcome {
    SynthesisGap { realization_cost: _, lower_bound: _, report: r } =>
      std.algebra.Cons { head: r, tail: std.algebra.Empty }
    SynthesisOptimal { realization_cost: _, lower_bound: _ } => std.algebra.Empty
    SynthesisNoTechnique { diagnostic: _ } => std.algebra.Empty
  }
}

fn outcome_to_diagnostics(outcome: SynthesisOutcome) -> List<v2.std.diagnostic.Diagnostic> {
  match outcome {
    SynthesisGap { realization_cost: _, lower_bound: _, report: _ } => std.algebra.Empty
    SynthesisOptimal { realization_cost: _, lower_bound: _ } => std.algebra.Empty
    SynthesisNoTechnique { diagnostic: d } => std.algebra.Cons { head: d, tail: std.algebra.Empty }
  }
}

fn synthesis_lens_known_reports(n: Node, declared_technique: LowerBoundTechnique, realization: v2.lens.complexity.ComplexityBound) -> List<v2.std.report.Report> {
  match declared_technique {
    DecisionTree =>
      outcome_to_reports(outcome: assess_decision_tree(n: n, realization: realization))
    AlgebraicRank =>
      outcome_to_reports(outcome: SynthesisNoTechnique { diagnostic: synthesis_no_technique_diagnostic(n: n) })
    AdversaryCommunication =>
      outcome_to_reports(outcome: SynthesisNoTechnique { diagnostic: synthesis_no_technique_diagnostic(n: n) })
    InformationTheoretic =>
      outcome_to_reports(outcome: assess_information_theoretic(n: n, realization: realization))
    ReductionConditional =>
      outcome_to_reports(outcome: SynthesisNoTechnique { diagnostic: synthesis_no_technique_diagnostic(n: n) })
  }
}

fn synthesis_lens(n: Node, declared_technique: LowerBoundTechnique) -> List<v2.std.report.Report> {
  let realization = complexity_lens(n: n)
  match realization {
    UnknownComplexity { diagnostic: _ } => std.algebra.Empty
    ConstantComplexity =>
      synthesis_lens_known_reports(n: n, declared_technique: declared_technique, realization: realization)
    SizedComplexity { class: _, variables: _ } =>
      synthesis_lens_known_reports(n: n, declared_technique: declared_technique, realization: realization)
  }
}

fn decision_tree_synthesis_lens_read(n: Node) -> List<v2.std.report.Report> {
  synthesis_lens(n: n, declared_technique: DecisionTree)
}

data decision_tree_synthesis_advisory_lens: v2.lens.application.AdvisoryLens = v2.lens.application.AdvisoryLens {
  read: decision_tree_synthesis_lens_read
}

fn information_theoretic_synthesis_lens_read(n: Node) -> List<v2.std.report.Report> {
  synthesis_lens(n: n, declared_technique: InformationTheoretic)
}

data information_theoretic_synthesis_advisory_lens: v2.lens.application.AdvisoryLens = v2.lens.application.AdvisoryLens {
  read: information_theoretic_synthesis_lens_read
}

fn synthesis_lens_known_diagnostics(n: Node, declared_technique: LowerBoundTechnique, realization: v2.lens.complexity.ComplexityBound) -> List<v2.std.diagnostic.Diagnostic> {
  match declared_technique {
    DecisionTree =>
      outcome_to_diagnostics(outcome: assess_decision_tree(n: n, realization: realization))
    AlgebraicRank =>
      outcome_to_diagnostics(outcome: SynthesisNoTechnique { diagnostic: synthesis_no_technique_diagnostic(n: n) })
    AdversaryCommunication =>
      outcome_to_diagnostics(outcome: SynthesisNoTechnique { diagnostic: synthesis_no_technique_diagnostic(n: n) })
    InformationTheoretic =>
      outcome_to_diagnostics(outcome: assess_information_theoretic(n: n, realization: realization))
    ReductionConditional =>
      outcome_to_diagnostics(outcome: SynthesisNoTechnique { diagnostic: synthesis_no_technique_diagnostic(n: n) })
  }
}

fn synthesis_lens_diagnostics(n: Node, declared_technique: LowerBoundTechnique) -> List<v2.std.diagnostic.Diagnostic> {
  let realization = complexity_lens(n: n)
  match realization {
    UnknownComplexity { diagnostic: d } => std.algebra.Cons { head: d, tail: std.algebra.Empty }
    ConstantComplexity =>
      synthesis_lens_known_diagnostics(n: n, declared_technique: declared_technique, realization: realization)
    SizedComplexity { class: _, variables: _ } =>
      synthesis_lens_known_diagnostics(n: n, declared_technique: declared_technique, realization: realization)
  }
}

data construction_justification: v2.lens.common.construction_justification.ConstructionJustification = v2.lens.common.construction_justification.ConstructionJustification {
  class: RatchetForever
}
