module v2.test.lens_no_dual_representation_test.no_dual_representation_test_test

import v2.lens.no_dual_representation_test {
  no_dual_representation_test_clean_holds,
  no_dual_representation_test_live_file_count,
}
import v2.std.logic { Bool }

test fn no_dual_representation_test_has_no_unrostered_violations() -> Bool {
  return no_dual_representation_test_clean_holds()
}

test fn no_dual_representation_test_corpus_is_nonempty() -> Bool {
  return no_dual_representation_test_live_file_count() > 0
}
