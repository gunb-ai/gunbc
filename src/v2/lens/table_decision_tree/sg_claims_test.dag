module v2.test.lens_table_decision_tree.sg_claims

import v2.std.lens_verdict {
  Holds,
  LensVerdict,
  Unrealized,
  lens_verdict_diagnostic_locus_module,
  lens_verdict_module_unrealized,
}
import v2.lens.table_decision_tree {
  table_decision_tree_fact_for_fn
}
import v2.std.logic { Bool }
import v2.std.node { Node, Symbol }
import v2.std.verification { BoolWitness, BoolWitnessClaim, UnifiedTestClaim }
import v2.test.lens_common.infer_fixture { claim_atom_node }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data tdt_witness_fn_node: Node = claim_atom_node(s: ^tdt_witness_fn_node_symbol)
data tdt_witness_module: String = "v2.lens.table_decision_tree"

fn tdt_verdict_is_unrealized(verdict: LensVerdict) -> Bool {
  match verdict {
    Unrealized { diagnostic: _ } => true
    _ => false
  }
}

fn witness_tdt_unrealized_green_on_fact() -> Bool {
  tdt_verdict_is_unrealized(
    verdict: table_decision_tree_fact_for_fn(fn_node: tdt_witness_fn_node).verdict
  )
}

fn tdt_sample_holds() -> LensVerdict {
  Holds
}

fn witness_tdt_unrealized_red_on_holds() -> Bool {
  match tdt_sample_holds() {
    Unrealized { diagnostic: _ } => false
    _ => true
  }
}

fn witness_tdt_locus_green_on_fact() -> Bool {
  match table_decision_tree_fact_for_fn(fn_node: tdt_witness_fn_node).verdict {
    Unrealized { diagnostic: d } =>
      lens_verdict_diagnostic_locus_module(d: d) == tdt_witness_module
    _ => false
  }
}

fn witness_tdt_locus_red_on_perturbed_module() -> Bool {
  let perturbed = lens_verdict_module_unrealized(
    reason: ^table_decision_tree_perturbed,
    module_name: "v2.lens.table_decision_tree_wrong_module"
  )
  match perturbed {
    Unrealized { diagnostic: d } =>
      lens_verdict_diagnostic_locus_module(d: d) != tdt_witness_module
    _ => false
  }
}

test fn lens_table_decision_tree_unrealized_scaffold_holds() -> Bool {
  witness_tdt_unrealized_green_on_fact()
    && witness_tdt_unrealized_red_on_holds()
    && witness_tdt_locus_green_on_fact()
    && witness_tdt_locus_red_on_perturbed_module()
}
