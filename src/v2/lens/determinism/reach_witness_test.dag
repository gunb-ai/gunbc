module v2.test.lens_determinism.reach_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn det_atom(id: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn det_positional(target: v2.std.node.Node) -> v2.std.node.Edge {
  v2.std.node.Edge { label: Positional, target: target }
}

fn det_call(callee: v2.std.node.Symbol, arg: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: v2.std.node.Transform },
    children: [det_positional(target: det_atom(id: callee)), det_positional(target: arg)],
    occurrence_id: SyntheticOccurrence
  }
}

fn map_keys_call_fixture() -> v2.std.node.Node {
  det_call(callee: ^map_keys, arg: det_atom(id: ^emit_export_map))
}

fn unrelated_same_named_call_fixture(callee: v2.std.node.Symbol) -> v2.std.node.Node {
  det_call(callee: callee, arg: det_atom(id: ^unrelated_non_map_domain))
}

fn map_values_call_fixture() -> v2.std.node.Node {
  det_call(callee: ^map_values, arg: det_atom(id: ^emit_export_map))
}

fn sorted_map_keys_call_fixture() -> v2.std.node.Node {
  det_call(callee: ^sorted_map_keys, arg: det_atom(id: ^emit_export_map))
}

fn clean_call_fixture() -> v2.std.node.Node {
  det_call(callee: ^emit_concat, arg: det_atom(id: ^emit_export_map))
}

fn nested_map_keys_fixture() -> v2.std.node.Node {
  det_call(callee: ^emit_concat, arg: map_keys_call_fixture())
}

fn witness_violates(w: Witness<v2.std.determinism.DeterminismFact>) -> v2.std.logic.Bool {
  match w {
    Violates { diagnostic: _ } => true
    Holds { value: _ } => false
  }
}

fn witness_holds(w: Witness<v2.std.determinism.DeterminismFact>) -> v2.std.logic.Bool {
  match w {
    Holds { value: _ } => true
    Violates { diagnostic: _ } => false
  }
}

fn axis_is_nondeterministic(a: std.determinism.Determinism) -> v2.std.logic.Bool {
  match a {
    NonDeterministic { source: _ } => true
    Deterministic => false
  }
}

test fn determinism_flags_map_keys_reach() -> v2.std.logic.Bool {
  witness_violates(w: determinism_contract_witness(signature: ^emit_fixture, n: map_keys_call_fixture()))
}

test fn determinism_flags_map_values_reach() -> v2.std.logic.Bool {
  witness_violates(w: determinism_contract_witness(signature: ^emit_fixture, n: map_values_call_fixture()))
}

test fn determinism_holds_sorted_map_keys_sibling() -> v2.std.logic.Bool {
  witness_holds(w: determinism_contract_witness(signature: ^emit_fixture, n: sorted_map_keys_call_fixture()))
}

test fn determinism_holds_clean_call() -> v2.std.logic.Bool {
  witness_holds(w: determinism_contract_witness(signature: ^emit_fixture, n: clean_call_fixture()))
}

test fn determinism_flags_nested_map_keys_in_subtree() -> v2.std.logic.Bool {
  witness_violates(w: determinism_contract_witness(signature: ^emit_fixture, n: nested_map_keys_fixture()))
}

test fn determinism_axis_map_keys_is_nondeterministic() -> v2.std.logic.Bool {
  axis_is_nondeterministic(a: determinism_axis_for_node(n: map_keys_call_fixture()))
}

fn gate_rejects(o: v2.std.diagnostic.Outcome<Witness<v2.std.node.Node>>) -> v2.std.logic.Bool {
  match o {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}

fn gate_accepts(o: v2.std.diagnostic.Outcome<Witness<v2.std.node.Node>>) -> v2.std.logic.Bool {
  match o {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn determinism_gate_rejects_map_keys_reach() -> v2.std.logic.Bool {
  gate_rejects(o: determinism_compile_gate(node: map_keys_call_fixture()))
}

test fn determinism_gate_rejects_map_values_reach() -> v2.std.logic.Bool {
  gate_rejects(o: determinism_compile_gate(node: map_values_call_fixture()))
}

test fn determinism_gate_accepts_clean_tree() -> v2.std.logic.Bool {
  v2.test.lens_determinism.reach_witness.gate_accepts(o: determinism_compile_gate(node: clean_call_fixture()))
}

test fn determinism_gate_accepts_unrelated_keys_call() -> v2.std.logic.Bool {
  v2.test.lens_determinism.reach_witness.gate_accepts(o: determinism_compile_gate(node: unrelated_same_named_call_fixture(callee: ^keys)))
}

test fn determinism_gate_accepts_unrelated_values_call() -> v2.std.logic.Bool {
  v2.test.lens_determinism.reach_witness.gate_accepts(o: determinism_compile_gate(node: unrelated_same_named_call_fixture(callee: ^values)))
}

test fn determinism_gate_accepts_sorted_map_keys_sibling() -> v2.std.logic.Bool {
  v2.test.lens_determinism.reach_witness.gate_accepts(o: determinism_compile_gate(node: sorted_map_keys_call_fixture()))
}

test fn determinism_gate_rejects_nested_map_keys_in_subtree() -> v2.std.logic.Bool {
  gate_rejects(o: determinism_compile_gate(node: nested_map_keys_fixture()))
}

// ---------------------------------------------------------------------------
// Identity-keyed classification controls.
//
// The seven controls above discriminate the SYMBOL half and still pass
// unchanged, which is the point: keys and values stay accepted, and they now
// stay accepted for a structural reason rather than because nobody registered
// them. The controls below discriminate the ORDER half, which the deleted
// two-row registry had no way to express -- it could only answer registered or
// not, so every one of these five fixtures would have been accepted by it,
// including the two that must refuse.

fn index_by_call_fixture() -> Node {
  det_call(callee: ^index_by, arg: det_atom(id: ^emit_export_list))
}

fn length_call_fixture() -> Node {
  det_call(callee: ^length, arg: det_atom(id: ^emit_export_list))
}

fn decl_facts_call_fixture() -> Node {
  det_call(callee: ^decl_facts, arg: det_atom(id: ^emit_pool_roots))
}

fn concept_decl_facts_live_call_fixture() -> Node {
  det_call(callee: ^concept_decl_facts_live, arg: det_atom(id: ^emit_pool_roots))
}

fn fold_list_call_fixture() -> Node {
  det_call(callee: ^fold_list, arg: det_atom(id: ^emit_export_list))
}

test fn determinism_gate_rejects_unclassified_traversal_order() -> Bool {
  gate_rejects(o: determinism_compile_gate(node: index_by_call_fixture()))
}

test fn determinism_gate_accepts_order_free_result() -> Bool {
  gate_accepts(o: determinism_compile_gate(node: length_call_fixture()))
}

test fn determinism_gate_accepts_canonical_order() -> Bool {
  gate_accepts(o: determinism_compile_gate(node: decl_facts_call_fixture()))
}

test fn determinism_gate_accepts_source_preserving_order() -> Bool {
  gate_accepts(o: determinism_compile_gate(node: concept_decl_facts_live_call_fixture()))
}

test fn determinism_gate_accepts_fold_list_source_order() -> Bool {
  gate_accepts(o: determinism_compile_gate(node: fold_list_call_fixture()))
}

// ---------------------------------------------------------------------------
// Denominator-closure controls (the enrollment half of the wall).
//
// The GREEN side is the live denominator: every declared primitive carries a
// traversal fact today, which is what lets every gate control above be about
// the tree rather than about the roster. The RED side has to be authored,
// because a fixture cannot add a declaration to std.primitive_identity -- so it
// plants a definition with no fact and asserts the closure predicate finds it.
// Without that arm the green one is a permanently-true reading of a list that
// happens to be complete, and could not distinguish a working predicate from
// one that returns Empty unconditionally.

fn unclassified_planted_definition() -> PrimitiveDefinition {
  PrimitiveDefinition {
    identity: primitive_identity_slug(name: "planted_primitive_with_no_traversal_fact"),
    semantic_contract: PrimitiveSemanticContract {
      canonical_name: "planted_primitive_with_no_traversal_fact" as NonEmptyStr
    }
  }
}

test fn determinism_denominator_is_closed_on_declared_primitives() -> Bool {
  primitive_traversal_denominator_is_closed()
}

test fn determinism_denominator_predicate_finds_a_planted_hole() -> Bool {
  count(primitive_definitions_missing_traversal_fact_in(defs: [unclassified_planted_definition()])) == 1
}

test fn determinism_denominator_predicate_passes_a_classified_definition() -> Bool {
  count(primitive_definitions_missing_traversal_fact_in(defs: [primitive_map_keys_definition])) == 0
}
