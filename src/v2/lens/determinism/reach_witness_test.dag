module v2.test.lens_determinism.reach_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn det_atom(id: v2.std.node.Symbol) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn det_positional(target: Node) -> v2.std.node.Edge {
  v2.std.node.Edge { label: Positional, target: target }
}

fn det_call(callee: v2.std.node.Symbol, arg: Node) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: Transform },
    children: [det_positional(target: det_atom(id: callee)), det_positional(target: arg)],
    occurrence_id: SyntheticOccurrence
  }
}

fn map_keys_call_fixture() -> Node {
  det_call(callee: ^map_keys, arg: det_atom(id: ^emit_export_map))
}

fn unrelated_same_named_call_fixture(callee: v2.std.node.Symbol) -> Node {
  det_call(callee: callee, arg: det_atom(id: ^unrelated_non_map_domain))
}

fn map_values_call_fixture() -> Node {
  det_call(callee: ^map_values, arg: det_atom(id: ^emit_export_map))
}

fn sorted_map_keys_call_fixture() -> Node {
  det_call(callee: ^sorted_map_keys, arg: det_atom(id: ^emit_export_map))
}

fn clean_call_fixture() -> Node {
  det_call(callee: ^emit_concat, arg: det_atom(id: ^emit_export_map))
}

fn nested_map_keys_fixture() -> Node {
  det_call(callee: ^emit_concat, arg: map_keys_call_fixture())
}

fn witness_violates(w: Witness<v2.std.determinism.DeterminismFact>) -> Bool {
  match w {
    Violates { diagnostic: _ } => true
    Holds { value: _ } => false
  }
}

fn witness_holds(w: Witness<v2.std.determinism.DeterminismFact>) -> Bool {
  match w {
    Holds { value: _ } => true
    Violates { diagnostic: _ } => false
  }
}

fn axis_is_nondeterministic(a: std.determinism.Determinism) -> Bool {
  match a {
    NonDeterministic { source: _ } => true
    Deterministic => false
  }
}

test fn determinism_flags_map_keys_reach() -> Bool {
  witness_violates(w: determinism_contract_witness(signature: ^emit_fixture, n: map_keys_call_fixture()))
}

test fn determinism_flags_map_values_reach() -> Bool {
  witness_violates(w: determinism_contract_witness(signature: ^emit_fixture, n: map_values_call_fixture()))
}

test fn determinism_holds_sorted_map_keys_sibling() -> Bool {
  witness_holds(w: determinism_contract_witness(signature: ^emit_fixture, n: sorted_map_keys_call_fixture()))
}

test fn determinism_holds_clean_call() -> Bool {
  witness_holds(w: determinism_contract_witness(signature: ^emit_fixture, n: clean_call_fixture()))
}

test fn determinism_flags_nested_map_keys_in_subtree() -> Bool {
  witness_violates(w: determinism_contract_witness(signature: ^emit_fixture, n: nested_map_keys_fixture()))
}

test fn determinism_axis_map_keys_is_nondeterministic() -> Bool {
  axis_is_nondeterministic(a: determinism_axis_for_node(n: map_keys_call_fixture()))
}

fn gate_rejects(o: v2.std.diagnostic.Outcome<Witness<Node>>) -> Bool {
  match o {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}

fn gate_accepts(o: v2.std.diagnostic.Outcome<Witness<Node>>) -> Bool {
  match o {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn determinism_gate_rejects_map_keys_reach() -> Bool {
  gate_rejects(o: determinism_compile_gate(node: map_keys_call_fixture()))
}

test fn determinism_gate_rejects_map_values_reach() -> Bool {
  gate_rejects(o: determinism_compile_gate(node: map_values_call_fixture()))
}

test fn determinism_gate_accepts_clean_tree() -> Bool {
  v2.test.lens_determinism.reach_witness.gate_accepts(o: determinism_compile_gate(node: clean_call_fixture()))
}

test fn determinism_gate_accepts_unrelated_keys_call() -> Bool {
  v2.test.lens_determinism.reach_witness.gate_accepts(o: determinism_compile_gate(node: unrelated_same_named_call_fixture(callee: ^keys)))
}

test fn determinism_gate_accepts_unrelated_values_call() -> Bool {
  v2.test.lens_determinism.reach_witness.gate_accepts(o: determinism_compile_gate(node: unrelated_same_named_call_fixture(callee: ^values)))
}

test fn determinism_gate_accepts_sorted_map_keys_sibling() -> Bool {
  v2.test.lens_determinism.reach_witness.gate_accepts(o: determinism_compile_gate(node: sorted_map_keys_call_fixture()))
}

test fn determinism_gate_rejects_nested_map_keys_in_subtree() -> Bool {
  gate_rejects(o: determinism_compile_gate(node: nested_map_keys_fixture()))
}
