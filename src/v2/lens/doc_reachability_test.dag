module v2.test.lens_doc_reachability.doc_reachability_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.ReadsLiveTree

test fn doc_graph_has_no_orphan_docs() -> Bool {
  return gunbc.doc_graph_roots.doc_graph_floor_orphan_clean_holds()
}

test fn doc_graph_has_no_dangling_links() -> Bool {
  return v2.lens.doc_reachability.doc_graph_dangling_clean_holds()
}

test fn doc_graph_universe_is_nonempty() -> Bool {
  return v2.lens.doc_reachability.doc_graph_universe_nonempty_holds()
}

test fn doc_graph_is_clean() -> Bool {
  return gunbc.doc_graph_roots.doc_graph_floor_clean_holds()
}
