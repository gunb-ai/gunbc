module v2.lens.structural_similarity
import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }

import v2.lens.simulated_relationship { congruent }
import v2.std.node { Node }
import v2.std.algebra { FreeMonoid, length, skip, is_prefix_of }
import v2.std.logic { Bool }

fn type_decls_anti_unify(decls: FreeMonoid<Node>) -> Bool {
  if length(xs: decls) < 2 {
    false
  } else {
    is_prefix_of(
      prefix: skip(xs: decls, n: 1),
      xs: decls,
      eq: fn(later, earlier) { congruent(a: earlier, b: later) }
    )
  }
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding {
    grounding_authority: "the parse/resolve walk that projects a module's type declarations into a FreeMonoid<Node> forest (shared with v2.lens.simulated_relationship's statement-chain projector)",
    dissolve_on: "type_decls_anti_unify runs over live dsl type-declaration forests once the parse/resolve walk produces per-module type-decl facts; until then this is a lens_unit predicate over synthetic type-decl forests, consumed as a row of the v2.lens.intent_linearity registry. This is the type-decl twin of v2.lens.simulated_relationship: the same congruent kernel, a different binder (the leaves that vary across a congruent family of type decls are a type-parameter hole, not a fold's list-element hole), so N near-identical type decls collapse to one generic (Int8..Int128 = one Compose axis). Unlike the term binder a pair suffices (threshold 2, not the fold's 3) and it fires on congruent directly so byte-identical decls (the strongest section-3 nickname) are caught; adjacency reuses skip/is_prefix_of since congruence is one shared skeleton transitive across the family."
  },
  rationale: "Structural congruence of type declarations is decidable (a wall): type decls that share one skeleton differing only at leaf positions collapse to one generic (the leaves becoming type parameters), and byte-identical decls are the strongest section-3 nickname. The undecidable residue (whether the leaf variance is semantically one type parameter or coincidental) stays a ratchet. One engine (congruent), two binders (term chain / type forest)."
}
