module v2.lens.structural_similarity
import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }
import std.disposition { SingleAuthority }

import v2.std.node { Node }
import v2.std.algebra { FreeMonoid, length }
import v2.std.anti_unification { ChainGeneralization, anti_unify_chain, fillings_all_leaves }
import v2.std.logic { Bool }

fn forest_collapses_to_generic(g: ChainGeneralization) -> Bool {
  fillings_all_leaves(per_element: g.per_element)
}

fn type_decls_anti_unify(decls: FreeMonoid<Node>) -> Bool {
  if length(xs: decls) < 2 {
    false
  } else {
    forest_collapses_to_generic(g: anti_unify_chain(steps: decls))
  }
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SingleAuthority },
  rationale: "Structural anti-unification of type declarations is decidable (a wall): type decls whose only variance is at leaf positions collapse to one generic (the leaves becoming type parameters), and byte-identical decls are the strongest section-3 nickname. The undecidable residue (whether the leaf variance is semantically one type parameter or coincidental) stays a ratchet. One engine (v2.std.anti_unification), two binders (term chain / type forest). Grounding authority: the parse/resolve walk that projects a module's type declarations into a FreeMonoid<Node> forest (anti-unified by the shared v2.std.anti_unification kernel, also used by v2.lens.simulated_relationship's statement-chain binder) Dissolves on: type_decls_anti_unify runs over live dsl type-declaration forests once the parse/resolve walk produces per-module type-decl facts; until then this is a lens_unit predicate over synthetic type-decl forests, consumed as a row of the v2.lens.intent_linearity registry. This is the type-decl twin of v2.lens.simulated_relationship: the same anti_unify_chain engine, a different binder (the leaves that vary across a congruent family of type decls are a type-parameter hole, not a fold's list-element hole), so N near-identical type decls collapse to one generic (Int8..Int128 = one Compose axis). Unlike the term binder a pair suffices (threshold 2, not the fold's 3) and template_has_hole is NOT required, so byte-identical decls (the strongest section-3 nickname, a hole-free template) are also caught: the wall is fillings_all_leaves, i.e. all variance sits at leaf positions that become type parameters."
}
