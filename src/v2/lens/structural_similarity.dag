module v2.lens.structural_similarity


fn type_decls_anti_unify(decls: std.algebra.FreeMonoid<v2.std.node.Node>) -> Bool {
  v2.lens.common.chain_generalization.chain_collapses(steps: decls, min_len: 2, require_hole: false)
}

data construction_justification: v2.lens.common.construction_justification.ConstructionJustification = v2.lens.common.construction_justification.ConstructionJustification {
  class: v2.lens.common.construction_justification.WallAfterGrounding { dissolves_to: std.disposition.SingleAuthority }
}
