module v2.lens.structural_similarity
import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }

import v2.std.collection { List, Map }
import v2.std.nat { Nat, Zero }
import v2.std.node { Symbol }

type DeclId = Symbol

type TypeIdent = Symbol

type VariantShape {
  field_arity: Nat
  field_type_idents: List<TypeIdent>
}

type TypeShape {
  variant_set: List<VariantShape>
  total_variants: Nat
}

type FnShapeUnrealized {}

type StructuralShape
  = TypeDecl { shape: TypeShape }
  | FnDecl { shape: FnShapeUnrealized }

type StructuralSimilarityVerdict
  = Unrealized
  | Produced { index: Map<DeclId, StructuralShape> }

type StructuralSimilarityFact {
  verdict: StructuralSimilarityVerdict
}

data structural_similarity_empty_type_shape: TypeShape = {
  variant_set: [],
  total_variants: Zero
}

fn structural_similarity_fact() -> StructuralSimilarityFact {
  StructuralSimilarityFact {
    verdict: Unrealized
  }
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding {
    grounding_authority: "the parse/resolve walk producing per-decl TypeShape/VariantShape facts by construction",
    dissolve_on: "per-decl structural-shape facts are produced by the substrate walk, not by a staged lens producer"
  },
  rationale: "Per-decl structural shape is a decidable index; a scaffold producer-stage substrate (unblocking variant-parameter-clone and structural-similarity) until the parse/resolve walk lands."
}
