module v2.test.lens_cost.p9_llvm_instruction_cost_registry_owner

import v2.lens.registry {
  LensOwnedFnV0,
  lens_owned_fn_llvm_instruction_cost,
  lens_owned_fn_registry_v0
}
import v2.std.algebra { count_equal, unique }
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v2.std.node { Atom, Conj, Node, TypeNode, SyntheticOccurrence }

data p9_registry_owner_authority_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^symbol_llvm_instruction_cost } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn p9_owned_fn_name_eq(left: LensOwnedFnV0, right: LensOwnedFnV0) -> Bool {
  left.fn_name == right.fn_name
}

fn p9_owned_fn_row_eq(left: LensOwnedFnV0, right: LensOwnedFnV0) -> Bool {
  left.fn_name == right.fn_name && left.owner_module_path == right.owner_module_path
}

fn p9_registry_fn_names_unique() -> Bool {
  unique(xs: lens_owned_fn_registry_v0, eq: p9_owned_fn_name_eq)
}

fn p9_registry_canonical_row_count() -> Int {
  count_equal(
    xs: lens_owned_fn_registry_v0,
    item: lens_owned_fn_llvm_instruction_cost,
    eq: p9_owned_fn_row_eq
  )
}

fn p9_registry_owner_receipt_holds() -> Bool {
  p9_registry_fn_names_unique() && p9_registry_canonical_row_count() == 1
}

fn p9_registry_owner_receipt_rhs() -> Node {
  if p9_registry_owner_receipt_holds() {
    p9_registry_owner_authority_node
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_p9_llvm_instruction_cost_registry_owner: TestClaim = EqualsClaim {
  label: "P9: llvm_instruction_cost registry has exactly one canonical LensOwnedFnV0 row (fn + owner)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: p9_registry_owner_authority_node,
  rhs: p9_registry_owner_receipt_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}