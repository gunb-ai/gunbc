
module v2.test.lens_cost.product_zero_identity

import v2.lens.cost { LinearCost, cost_lens }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  ComputationNode,
  Conj,
  Edge,
  Loop,
  Named,
  Node,
  Positional,
  Symbol,
  TypeNode,
  SyntheticOccurrence
}
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v2.std.witness { Holds }

data product_zero_identity_body: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^product_zero_identity_body_atom } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data product_zero_identity_measure: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^product_zero_identity_measure_atom } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data product_zero_identity_input: Node = Node {
  kind: ComputationNode { behavior: Loop },
  children: [
    Edge { label: Positional, target: product_zero_identity_body },
    Edge { label: Named { name: ^loop_bound_edge }, target: product_zero_identity_measure }
  ],
  occurrence_id: SyntheticOccurrence
}

fn product_zero_identity_claim_holds() -> Bool {
  match cost_lens(n: product_zero_identity_input) {
    Holds { value: actual } =>
      match actual {
        LinearCost { variable: sv } => sv.source == product_zero_identity_measure
        _ => false
      }
    _ => false
  }
}

fn product_zero_identity_claim_rhs() -> Node {
  if product_zero_identity_claim_holds() {
    product_zero_identity_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_product_zero_identity: TestClaim = EqualsClaim {
  label: "lens_cost/product_zero_identity: iterative fold preserves linear bound over zero-cost body",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: product_zero_identity_input,
  rhs: product_zero_identity_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
