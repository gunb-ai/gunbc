module v2.test.lens_cost.valuation

import std.algebra { Empty }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import v2.lens.cost { SizeVariable }
import v2.lens.cost.expr {
  CostAdd,
  CostConst,
  CostEffect,
  CostExpr,
  CostSum,
  SizeConst,
  SizeExpr,
  size_of
}
import v2.lens.cost.valuation {
  BoundedCost,
  InvertedCostInterval,
  evaluation_interval,
  CostEvaluation,
  CostEvaluationRefused,
  CostValuationBinding,
  DuplicateSizeBinding,
  ExactCost,
  MissingSizeBinding,
  UnmodeledEffectCost,
  UnresolvedCost,
  evaluate_cost_expr,
  evaluate_cost_expr_partially
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.nat { Nat, Succ, Zero }
import v2.std.node {
  Atom,
  Node,
  Symbol,
  SyntheticOccurrence,
  TypeNode
}
import v2.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data nat_1: Nat = Succ { prev: Zero }
data nat_2: Nat = Succ { prev: nat_1 }
data nat_3: Nat = Succ { prev: nat_2 }
data nat_4: Nat = Succ { prev: nat_3 }
data nat_5: Nat = Succ { prev: nat_4 }
data nat_6: Nat = Succ { prev: nat_5 }
data nat_7: Nat = Succ { prev: nat_6 }
data nat_8: Nat = Succ { prev: nat_7 }
data nat_9: Nat = Succ { prev: nat_8 }
data nat_10: Nat = Succ { prev: nat_9 }

fn synthetic_leaf(identity: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: identity } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

data outer_leaf: Node = synthetic_leaf(identity: ^valuation_outer_size_atom)
data inner_leaf: Node = synthetic_leaf(identity: ^valuation_inner_size_atom)

data outer_variable: SizeVariable = SizeVariable { source: outer_leaf }
data inner_variable: SizeVariable = SizeVariable { source: inner_leaf }

fn bind(variable: SizeVariable, value: Nat) -> CostValuationBinding {
  CostValuationBinding { variable: variable, value: value }
}

fn unit_loop_over(variable: SizeVariable) -> CostExpr {
  CostSum {
    binder: inner_variable,
    upper: size_of(variable: variable),
    body: CostConst { value: nat_1 }
  }
}

fn is_exact(evaluation: CostEvaluation, expected: Nat) -> Bool {
  match evaluation {
    ExactCost { value: v } => v == expected
    _ => false
  }
}

test fn unit_body_over_size_five_evaluates_to_five() -> Bool {
  is_exact(
    evaluation: evaluate_cost_expr(
      expr: unit_loop_over(variable: outer_variable),
      bindings: [bind(variable: outer_variable, value: nat_5)]
    ),
    expected: nat_5
  )
}

test fn changing_the_bound_size_changes_the_derived_work() -> Bool {
  is_exact(
    evaluation: evaluate_cost_expr(
      expr: unit_loop_over(variable: outer_variable),
      bindings: [bind(variable: outer_variable, value: nat_10)]
    ),
    expected: nat_10
  ) && !is_exact(
    evaluation: evaluate_cost_expr(
      expr: unit_loop_over(variable: outer_variable),
      bindings: [bind(variable: outer_variable, value: nat_10)]
    ),
    expected: nat_5
  )
}

fn binder_dependent_loop() -> CostExpr {
  CostSum {
    binder: outer_variable,
    upper: size_of(variable: outer_variable),
    body: CostSum {
      binder: inner_variable,
      upper: size_of(variable: outer_variable),
      body: CostConst { value: nat_1 }
    }
  }
}

test fn binder_dependent_body_is_summed_not_treated_as_invariant() -> Bool {
  is_exact(
    evaluation: evaluate_cost_expr(
      expr: binder_dependent_loop(),
      bindings: [bind(variable: outer_variable, value: nat_5)]
    ),
    expected: nat_10
  )
}

test fn invariant_body_control_does_not_produce_the_summed_answer() -> Bool {
  is_exact(
    evaluation: evaluate_cost_expr(
      expr: CostSum {
        binder: outer_variable,
        upper: size_of(variable: outer_variable),
        body: CostConst { value: nat_1 }
      },
      bindings: [bind(variable: outer_variable, value: nat_5)]
    ),
    expected: nat_5
  )
}

test fn missing_binding_refuses_and_never_becomes_zero() -> Bool {
  match evaluate_cost_expr(
    expr: unit_loop_over(variable: outer_variable),
    bindings: []
  ) {
    CostEvaluationRefused { causes: c } =>
      match c.head {
        MissingSizeBinding { variable: v, at: _ } => v.source == outer_leaf
        _ => false
      }
    ExactCost { value: _ } => false
    _ => false
  }
}

test fn missing_binding_under_partial_valuation_reports_the_free_variable() -> Bool {
  match evaluate_cost_expr_partially(
    expr: unit_loop_over(variable: outer_variable),
    bindings: []
  ) {
    UnresolvedCost { free_variables: f } => f.head.source == outer_leaf
    _ => false
  }
}

test fn duplicate_bindings_refuse() -> Bool {
  match evaluate_cost_expr(
    expr: unit_loop_over(variable: outer_variable),
    bindings: [
      bind(variable: outer_variable, value: nat_5),
      bind(variable: outer_variable, value: nat_10)
    ]
  ) {
    CostEvaluationRefused { causes: c } =>
      match c.head {
        DuplicateSizeBinding { variable: v, at: _ } => v.source == outer_leaf
        _ => false
      }
    _ => false
  }
}

test fn distinct_bindings_control_does_not_refuse() -> Bool {
  is_exact(
    evaluation: evaluate_cost_expr(
      expr: unit_loop_over(variable: outer_variable),
      bindings: [
        bind(variable: outer_variable, value: nat_5),
        bind(variable: inner_variable, value: nat_10)
      ]
    ),
    expected: nat_5
  )
}

fn shadowing_expr() -> CostExpr {
  CostAdd {
    left: CostSum {
      binder: outer_variable,
      upper: SizeConst { value: nat_2 },
      body: unit_loop_over(variable: outer_variable)
    },
    right: unit_loop_over(variable: outer_variable)
  }
}

test fn binder_shadowing_is_scoped_and_removed_on_exit() -> Bool {
  is_exact(
    evaluation: evaluate_cost_expr(
      expr: shadowing_expr(),
      bindings: [bind(variable: outer_variable, value: nat_3)]
    ),
    expected: nat_4
  )
}

test fn shadowing_control_rejects_the_unshadowed_reading() -> Bool {
  !is_exact(
    evaluation: evaluate_cost_expr(
      expr: shadowing_expr(),
      bindings: [bind(variable: outer_variable, value: nat_3)]
    ),
    expected: nat_9
  )
}

test fn zero_iterations_produce_exact_zero() -> Bool {
  is_exact(
    evaluation: evaluate_cost_expr(
      expr: CostSum {
        binder: inner_variable,
        upper: SizeConst { value: Zero },
        body: CostConst { value: nat_1 }
      },
      bindings: []
    ),
    expected: Zero
  )
}

data effect_operation: DeclarationRef = DeclarationRef {
  module_path: "v2.test.lens_cost.valuation",
  decl_name: "unmodelled_effect_specimen",
  field: WholeDeclaration
}

test fn cost_effect_refuses_until_an_effect_model_exists() -> Bool {
  match evaluate_cost_expr(
    expr: CostEffect { operation: effect_operation },
    bindings: []
  ) {
    CostEvaluationRefused { causes: c } =>
      match c.head {
        UnmodeledEffectCost { operation: _, at: _ } => true
        _ => false
      }
    ExactCost { value: _ } => false
    _ => false
  }
}

test fn cost_effect_under_partial_valuation_still_refuses() -> Bool {
  match evaluate_cost_expr_partially(
    expr: CostEffect { operation: effect_operation },
    bindings: []
  ) {
    CostEvaluationRefused { causes: _ } => true
    _ => false
  }
}

data interval_claim_scope_note: String = "evaluation_interval is witnessed at its OWN seam rather than through the CostSum bounded-upper arm, because that arm has no producer until the ceiling-valued binding lands (see cost_evaluation_arm_producer_note). Testing it through an absent producer would be untestable; testing the function directly is executing evidence for exactly the arithmetic the arm will use, and the first revision of this file shipped that arithmetic as combine_evaluation with max - which collapses a two-endpoint envelope to its own ceiling - so this is a regression control on a defect that actually occurred, not a hypothetical."

test fn interval_of_two_distinct_points_retains_both_endpoints() -> Bool {
  match evaluation_interval(
    low: ExactCost { value: nat_3 },
    high: ExactCost { value: nat_7 }
  ) {
    BoundedCost { lower: l, upper: u } => l == nat_3 && u == nat_7
    _ => false
  }
}

test fn interval_does_not_collapse_to_its_ceiling_red_control() -> Bool {
  match evaluation_interval(
    low: ExactCost { value: nat_3 },
    high: ExactCost { value: nat_7 }
  ) {
    ExactCost { value: _ } => false
    BoundedCost { lower: _, upper: _ } => true
    _ => false
  }
}

test fn interval_of_one_repeated_point_is_exact() -> Bool {
  is_exact(
    evaluation: evaluation_interval(
      low: ExactCost { value: nat_7 },
      high: ExactCost { value: nat_7 }
    ),
    expected: nat_7
  )
}

test fn inverted_interval_refuses_rather_than_swapping_endpoints() -> Bool {
  match evaluation_interval(
    low: ExactCost { value: nat_7 },
    high: ExactCost { value: nat_3 }
  ) {
    CostEvaluationRefused { causes: c } =>
      match c.head {
        InvertedCostInterval { lower: l, upper: u, at: _ } => l == nat_7 && u == nat_3
        _ => false
      }
    _ => false
  }
}

test fn interval_propagates_a_refusal_from_either_endpoint() -> Bool {
  match evaluation_interval(
    low: evaluate_cost_expr(expr: CostEffect { operation: effect_operation }, bindings: []),
    high: ExactCost { value: nat_7 }
  ) {
    CostEvaluationRefused { causes: _ } => true
    _ => false
  }
}

test fn refusing_body_under_a_bound_yields_exactly_one_cause() -> Bool {
  match evaluate_cost_expr(
    expr: CostSum {
      binder: inner_variable,
      upper: size_of(variable: outer_variable),
      body: CostEffect { operation: effect_operation }
    },
    bindings: [bind(variable: outer_variable, value: nat_10)]
  ) {
    CostEvaluationRefused { causes: c } =>
      match c.tail {
        Empty => true
        _ => false
      }
    _ => false
  }
}

data refusing_body_cause_count_note: String = "Ten iterations of a body that refuses unconditionally yield ONE cause, not ten. Both halves of that are the subject: ten identical causes would amplify a single deficit tenfold, degrading the countability the accumulate rule exists to protect, and building them costs quadratic time because non_empty_append is linear in its left argument. This witness reds if the settled-disposition skip in evaluate_summation is removed, which is what makes it a regression control rather than a description."

data claim_conjunction_totality_note: String = "The conjunction enumerates EVERY test fn in this file, and that totality is the point rather than a convenience. An earlier revision listed three of them while the claim label asserted refusal and scoping behaviour the other ten established, so the claim could have gone green with its own label false - specification-without-execution at the claim seam, caught by review 49620. The rule this file now follows: a claim label may assert only what its conjunction executes, so adding a test fn without adding it here is the defect to watch for."

fn every_valuation_witness_holds() -> Bool {
  unit_body_over_size_five_evaluates_to_five()
    && changing_the_bound_size_changes_the_derived_work()
    && binder_dependent_body_is_summed_not_treated_as_invariant()
    && invariant_body_control_does_not_produce_the_summed_answer()
    && missing_binding_refuses_and_never_becomes_zero()
    && missing_binding_under_partial_valuation_reports_the_free_variable()
    && duplicate_bindings_refuse()
    && distinct_bindings_control_does_not_refuse()
    && binder_shadowing_is_scoped_and_removed_on_exit()
    && shadowing_control_rejects_the_unshadowed_reading()
    && zero_iterations_produce_exact_zero()
    && cost_effect_refuses_until_an_effect_model_exists()
    && cost_effect_under_partial_valuation_still_refuses()
    && interval_of_two_distinct_points_retains_both_endpoints()
    && interval_does_not_collapse_to_its_ceiling_red_control()
    && interval_of_one_repeated_point_is_exact()
    && inverted_interval_refuses_rather_than_swapping_endpoints()
    && interval_propagates_a_refusal_from_either_endpoint()
    && refusing_body_under_a_bound_yields_exactly_one_cause()
}

data claim_cost_valuation: TestClaim = EqualsClaim {
  label: "lens_cost/valuation: CostExpr evaluated at concrete SizeVariable bindings yields exact semantic work, refuses a missing or duplicated binding rather than answering zero, scopes a CostSum binder to its body, and retains both endpoints of a bounded interval - every test fn in this file enrolled in the conjunction",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: outer_leaf,
  rhs: if every_valuation_witness_holds() {
    outer_leaf
  } else {
    synthetic_leaf(identity: ^valuation_claim_failed)
  },
  classification: TestClassification { tier: Tier1, layer: Unit }
}
