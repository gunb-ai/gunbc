module v2.lens.cost.copied_port_derivation


data copied_port_derivation_note: String = "Wave 1 Gate 1 C1: per-op copied-port facts are DERIVED by running the cost lens over each combiner's cited Arrow body (^arrow_body_edge only — edge_contributes_to_cost_fold), never hand-stamped indices. derive_copied_port_index_from_arrow finds the unique parameter port whose size the body cost is linear in; multi-linear ambiguity (two or more linear ports) returns Absent — no tiebreak heuristic. Current stdlib citations (list_append, list_snoc_item, map_merge) are each uniquely-linear (map_merge index 1 because overlay alone is linear, not because a tiebreak fires). Unpriceable shapes return Absent — classify_call keeps ^combiner_unregistered_carrier_reaches fail-closed."

type CombinerArrowCitation {
  combiner: v2.std.node.Symbol
  arrow: v2.std.node.Node
}

fn cost_linear_in_node(cost: v2.lens.cost.SymbolicCost, n: v2.std.node.Node) -> Bool {
  match cost {
    ConstantCost { value: _ } => false
    v2.lens.cost.LinearCost { variable: sv } => sv.source == n
    LogCost { variable: _ } => false
    PolynomialCost { variable: _, degree: _ } => false
    PolyLogCost { variable: _, exponent: _ } => false
    ExponentialCost { variable: _, base: _ } => false
    FactorialCost { variable: _ } => false
    v2.lens.cost.SumCost { lhs: lhs, rhs: rhs } =>
      cost_linear_in_node(cost: lhs, n: n) || cost_linear_in_node(cost: rhs, n: n)
    v2.lens.cost.ProductCost { lhs: lhs, rhs: rhs } =>
      cost_linear_in_node(cost: lhs, n: n) || cost_linear_in_node(cost: rhs, n: n)
    v2.lens.cost.UnknownCost { diagnostic: _ } => false
  }
}

fn arrow_domain_param_nodes(arrow: v2.std.node.Node) -> List<v2.std.node.Node> {
  match arrow.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Arrow } =>
      fold(arrow.children, init: std.algebra.Empty, f: fn(acc, e) {
        match e.label {
          v2.std.node.Positional =>
            match e.target.kind {
              v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
                fold(e.target.children, init: acc, f: fn(a, de) {
                  match de.label {
                    v2.std.node.Named { name: _ } => std.algebra.Cons { head: de.target, tail: a }
                    v2.std.node.Positional => a
                  }
                })
              _ => acc
            }
          v2.std.node.Named { name: _ } => acc
        }
      })
    _ => std.algebra.Empty
  }
}

fn param_list_reverse_to_forward(xs: List<v2.std.node.Node>) -> List<v2.std.node.Node> {
  fold(xs, init: std.algebra.Empty, f: fn(acc, n) { std.algebra.Cons { head: n, tail: acc } })
}

fn int_list_prepend(item: Int, xs: List<Int>) -> List<Int> {
  std.algebra.Cons { head: item, tail: xs }
}

fn linear_param_indices(cost: v2.lens.cost.SymbolicCost, params: List<v2.std.node.Node>, idx: Int, acc: List<Int>) -> List<Int> {
  match params {
    std.algebra.Empty => acc
    std.algebra.Cons { head: param, tail: rest } =>
      linear_param_indices(
        cost: cost,
        params: rest,
        idx: idx + 1,
        acc: if cost_linear_in_node(cost: cost, n: param) {
          int_list_prepend(item: idx, xs: acc)
        } else {
          acc
        }
      )
  }
}

fn derive_copied_port_index_from_arrow(arrow: v2.std.node.Node) -> v2.std.optional.Optional<Int> {
  match v2.std.node.arrow_body_target_lookup(children: arrow.children) {
    Found { target: body } =>
      let params = param_list_reverse_to_forward(xs: arrow_domain_param_nodes(arrow: arrow))
      let body_cost = v2.lens.cost.symbolic_cost_of_node(n: body)
      let linear_indices = linear_param_indices(cost: body_cost, params: params, idx: 0, acc: std.algebra.Empty)
      match linear_indices {
        std.algebra.Empty => v2.std.optional.Absent
        std.algebra.Cons { head: only, tail: std.algebra.Empty } => v2.std.optional.Present { value: only }
        _ => v2.std.optional.Absent
      }
    Ambiguous => v2.std.optional.Absent
    v2.std.optional.Absent => v2.std.optional.Absent
  }
}

fn derive_copied_port_fact(combiner: v2.std.node.Symbol, arrow: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.algebra.CopiedPortFact> {
  match derive_copied_port_index_from_arrow(arrow: arrow) {
    v2.std.optional.Absent => v2.std.optional.Absent
    v2.std.optional.Present { value: idx } =>
      v2.std.optional.Present {
        value: v2.std.algebra.CopiedPortFact {
          combiner: combiner,
          copied_port_index: idx
        }
      }
  }
}

fn row_matches_combiner(row: v2.std.algebra.CopiedPortFact, combiner: v2.std.node.Symbol) -> Bool {
  row.combiner == combiner
}

fn some_copied_port_index(idx: Int) -> v2.std.optional.Optional<Int> {
  v2.std.optional.Present { value: idx }
}

fn copied_port_index_from_registry(rows: List<v2.std.algebra.CopiedPortFact>, combiner: v2.std.node.Symbol) -> v2.std.optional.Optional<Int> {
  v2.std.algebra.fold_list(
    xs: rows,
    empty: v2.std.optional.Absent,
    cons: fn(acc, row) {
      match acc {
        v2.std.optional.Present { value: _ } => acc
        v2.std.optional.Absent =>
          if row_matches_combiner(row: row, combiner: combiner) {
            some_copied_port_index(idx: row.copied_port_index)
          } else {
            v2.std.optional.Absent
          }
      }
    }
  )
}
