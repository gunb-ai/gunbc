module v2.test.lens_cost.disj_max

import v2.lens.cost { LinearCost, SizeVariable, cost_lens }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  Cardinality,
  ComputationNode,
  Disj,
  Edge,
  Node,
  Positional,
  Transform,
  TypeNode,
  SyntheticOccurrence
}
import v2.std.witness { Holds }

// THE CHEAP ALTERNATIVE MUST COST SOMETHING. A bare Atom costs zero
// (base_cost_for_connective), and every alternative-composition rule that could be wrong here
// agrees on a zero first operand: taking the max and keeping the first child both yield the
// second child, so a Disj whose cheap arm is a bare Atom cannot distinguish max from
// first-child-wins. Wrapping it in a Transform makes the cheap arm cost unit — still strictly
// dominated by the Cardinality arm, so this witness's claim is unchanged — while a rule that
// keeps the first alternative now answers unit instead of linear (verified by mutation,
// gunbc#8505).
data disj_max_cheap_body: Node = Node {
  kind: ComputationNode { behavior: Transform },
  children: [
    Edge {
      label: Positional,
      target: Node {
        kind: TypeNode { connective: Atom { identity: ^disj_max_cheap_body_atom } },
        children: [],
        occurrence_id: SyntheticOccurrence
      }
    }
  ],
  occurrence_id: SyntheticOccurrence
}

data disj_max_expensive_body: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Cardinality },
  children: [
    v2.std.node.Edge {
      label: Positional,
      target: v2.std.node.Node {
        kind: v2.std.node.ComputationNode { behavior: Transform },
        children: [
          v2.std.node.Edge {
            label: Positional,
            target: v2.std.node.Node {
              kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^disj_max_expensive_body_atom } },
              children: [],
              occurrence_id: SyntheticOccurrence
            }
          }
        ],
        occurrence_id: SyntheticOccurrence
      }
    }
  ],
  occurrence_id: SyntheticOccurrence
}

data disj_max_input: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Disj },
  children: [
    v2.std.node.Edge { label: Positional, target: disj_max_cheap_body },
    v2.std.node.Edge { label: Positional, target: disj_max_expensive_body }
  ],
  occurrence_id: SyntheticOccurrence
}

test fn disj_max_claim_holds() -> Bool {
  match cost_lens(n: disj_max_input) {
    Holds { value: actual } =>
      actual == v2.lens.cost.LinearCost { variable: v2.lens.cost.SizeVariable { source: disj_max_expensive_body } }
    _ => false
  }
}
