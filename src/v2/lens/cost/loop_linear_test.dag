module v2.test.lens_cost.loop_linear


data loop_linear_body_leaf: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^loop_linear_body_atom } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data loop_linear_measure_leaf: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^loop_linear_measure_atom } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data loop_linear_body: Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: Transform },
  children: [
    v2.std.node.Edge { label: Positional, target: loop_linear_body_leaf }
  ],
  occurrence_id: SyntheticOccurrence
}

data loop_linear_input: Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: Loop },
  children: [
    v2.std.node.Edge { label: Positional, target: loop_linear_body },
    v2.std.node.Edge { label: Named { name: ^loop_bound_edge }, target: loop_linear_measure_leaf }
  ],
  occurrence_id: SyntheticOccurrence
}

test fn loop_linear_claim_holds() -> Bool {
  match cost_lens(n: loop_linear_input) {
    Holds { value: actual } =>
      match actual {
        LinearCost { variable: sv } => sv.source == loop_linear_measure_leaf
        _ => false
      }
    _ => false
  }
}
