module v2.test.lens_cost.loop_linear


data loop_linear_body_leaf: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^loop_linear_body_atom } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data loop_linear_measure_leaf: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^loop_linear_measure_atom } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data loop_linear_body: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: v2.std.node.Transform },
  children: [
    v2.std.node.Edge { label: v2.std.node.Positional, target: loop_linear_body_leaf }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data loop_linear_input: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: v2.std.node.Loop },
  children: [
    v2.std.node.Edge { label: v2.std.node.Positional, target: loop_linear_body },
    v2.std.node.Edge { label: v2.std.node.Named { name: ^loop_bound_edge }, target: loop_linear_measure_leaf }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

test fn loop_linear_claim_holds() -> Bool {
  match v2.lens.cost.cost_lens(n: loop_linear_input) {
    v2.std.witness.Holds { value: actual } =>
      match actual {
        v2.lens.cost.LinearCost { variable: sv } => sv.source == loop_linear_measure_leaf
        _ => false
      }
    _ => false
  }
}
