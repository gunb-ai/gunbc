module v2.test.lens_cost.disj_max


data disj_max_cheap_body: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^disj_max_cheap_body_atom } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data disj_max_expensive_body: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Cardinality },
  children: [
    v2.std.node.Edge {
      label: Positional,
      target: v2.std.node.Node {
        kind: v2.std.node.ComputationNode { behavior: Transform },
        children: [
          v2.std.node.Edge {
            label: Positional,
            target: v2.std.node.Node {
              kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^disj_max_expensive_body_atom } },
              children: [],
              occurrence_id: SyntheticOccurrence
            }
          }
        ],
        occurrence_id: SyntheticOccurrence
      }
    }
  ],
  occurrence_id: SyntheticOccurrence
}

data disj_max_input: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Disj },
  children: [
    v2.std.node.Edge { label: Positional, target: disj_max_cheap_body },
    v2.std.node.Edge { label: Positional, target: disj_max_expensive_body }
  ],
  occurrence_id: SyntheticOccurrence
}

fn disj_max_claim_holds() -> Bool {
  match cost_lens(n: disj_max_input) {
    Holds { value: actual } =>
      actual == v2.lens.cost.LinearCost { variable: v2.lens.cost.SizeVariable { source: disj_max_expensive_body } }
    _ => false
  }
}

fn disj_max_claim_rhs() -> Node {
  if disj_max_claim_holds() {
    disj_max_input
  } else {
    v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_disj_max: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "lens_cost/disj_max: disjunct takes max branch cost",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: disj_max_input,
  rhs: disj_max_claim_rhs(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
