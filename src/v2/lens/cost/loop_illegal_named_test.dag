module v2.test.lens_cost.loop_illegal_named

data loop_illegal_named_body_leaf: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^loop_illegal_named_body_atom } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data loop_illegal_named_measure_leaf: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^loop_illegal_named_measure_atom } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data loop_illegal_named_extra_leaf: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^loop_illegal_named_extra_atom } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data loop_illegal_named_input: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: v2.std.node.Loop },
  children: [
    v2.std.node.Edge { label: v2.std.node.Positional, target: loop_illegal_named_body_leaf },
    v2.std.node.Edge { label: v2.std.node.Named { name: ^loop_bound_edge }, target: loop_illegal_named_measure_leaf },
    v2.std.node.Edge { label: v2.std.node.Named { name: ^loop_illegal_named_extra_atom }, target: loop_illegal_named_extra_leaf }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

test fn loop_illegal_named_claim_holds() -> Bool {
  match v2.lens.cost.cost_lens(n: loop_illegal_named_input) {
    Violates { diagnostic: d } => d.reason == ^cardinality_loop_bound_malformed
    _ => false
  }
}
