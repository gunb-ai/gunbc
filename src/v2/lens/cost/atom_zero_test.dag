module v2.test.lens_cost.atom_zero


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly
data atom_zero_input: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^atom_zero_symbol } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

test fn atom_zero_claim_holds() -> Bool {
  match v2.lens.cost.cost_lens(n: atom_zero_input) {
    v2.std.witness.Holds { value: actual } => actual == v2.lens.cost.zero_cost()
    _ => false
  }
}
