module v2.lens.cost.copied_port_citations



data copied_port_citations_note: String = "Cited combiner Arrow bodies for per-op derivation (Wave 1 Gate 1 C1). Each row pairs a combiner symbol with a FAITHFUL lowered Arrow shape on ^arrow_body_edge (Loop bound = the combiner's carrier-size axis — left spine for list_append/list_snoc_item, overlay for map_merge — NOT rigged to the target index). derive_copied_port_index_from_arrow recovers the copied-port index from body cost. 🟡 dissolve-on: copied_port_citation_frontier_dissolution_note — citation-retained rows retire when Stage D general body producer emits ingested Arrow bodies for these combiners."

data copied_port_citation_frontier_dissolution_note: String = "See copied_port_citation_frontier_dissolution_note_dissolve_on for the lifecycle condition this row's rationale accompanies."

data copied_port_citation_frontier_dissolve_on: std.dissolution.DissolutionCondition = unbound_dissolution(description: "🟡 dissolve-on: CopiedPortCitationRetained rows in copied_port_citation_frontier_rows() stand in for producer-ingested combiner Arrow bodies (Wave 1 Gate 1 C1 interim). DISSOLVES WHEN the general body producer emits ingested Arrow bodies for list_append, list_snoc_item, and map_merge (Stage D) — citations delete, derivation runs on real producer output, copied_port_citation_retained_count() reaches 0.")

type CopiedPortCitationFrontierDisposition
  = CopiedPortCitationRetained { combiner: v2.std.node.Symbol, migration_trigger: v2.std.node.Symbol }
  | CopiedPortProducerIngested

type CopiedPortCitationFrontierRow {
  combiner: v2.std.node.Symbol
  disposition: CopiedPortCitationFrontierDisposition
  semantics_note: String
}

data copied_port_citation_frontier_row_list_append: CopiedPortCitationFrontierRow = CopiedPortCitationFrontierRow {
  combiner: ^list_append,
  disposition: CopiedPortCitationRetained {
    combiner: ^list_append,
    migration_trigger: ^migrate_when_general_body_producer_lands
  },
  semantics_note: "Faithful citation: two-param Arrow, Loop body linear in left spine (list length carrier) — matches list_append accumulator-copy axis."
}

data copied_port_citation_frontier_row_list_snoc_item: CopiedPortCitationFrontierRow = CopiedPortCitationFrontierRow {
  combiner: ^list_snoc_item,
  disposition: CopiedPortCitationRetained {
    combiner: ^list_snoc_item,
    migration_trigger: ^migrate_when_general_body_producer_lands
  },
  semantics_note: "Faithful citation: two-param Arrow, Loop body linear in left spine — matches list_snoc_item accumulator-copy axis."
}

data copied_port_citation_frontier_row_map_merge: CopiedPortCitationFrontierRow = CopiedPortCitationFrontierRow {
  combiner: ^map_merge,
  disposition: CopiedPortCitationRetained {
    combiner: ^map_merge,
    migration_trigger: ^migrate_when_general_body_producer_lands
  },
  semantics_note: "Faithful citation: two-param Arrow, Loop body linear in overlay only (base is not the size carrier) — map_merge copied port is overlay by semantics, not tiebreak."
}

fn copied_port_citation_frontier_rows() -> List<CopiedPortCitationFrontierRow> {
  Cons {
    head: copied_port_citation_frontier_row_list_append,
    tail: Cons {
      head: copied_port_citation_frontier_row_list_snoc_item,
      tail: Cons {
        head: copied_port_citation_frontier_row_map_merge,
        tail: Empty
      }
    }
  }
}

fn copied_port_citation_retained_count() -> Int {
  fold(copied_port_citation_frontier_rows(), init: 0, f: fn(count, row) {
    match row.disposition {
      CopiedPortCitationRetained { combiner: _, migration_trigger: _ } => count + 1
      CopiedPortProducerIngested => count
    }
  })
}

fn citation_conj_measure(left: Node, right: Node) -> Node {
  v2.std.node.Node {
    kind: TypeNode { connective: Conj },
    children: [
      v2.std.node.Edge { label: Positional, target: left },
      v2.std.node.Edge { label: Positional, target: right }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn citation_arrow_multi_linear_ambiguous(left_sym: v2.std.node.Symbol, right_sym: v2.std.node.Symbol) -> Node {
  citation_arrow_two_param_loop(
    left_sym: left_sym,
    right_sym: right_sym,
    measure: citation_conj_measure(
      left: citation_param_ref(sym: left_sym),
      right: citation_param_ref(sym: right_sym)
    )
  )
}

fn citation_param_ref(sym: v2.std.node.Symbol) -> Node {
  v2.std.node.Node {
    kind: TypeNode { connective: Atom { identity: sym } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn citation_loop_body_linear_in(measure: Node) -> Node {
  v2.std.node.Node {
    kind: ComputationNode { behavior: Loop },
    children: [
      v2.std.node.Edge {
        label: Positional,
        target: v2.std.node.Node {
          kind: ComputationNode { behavior: Transform },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      },
      v2.std.node.Edge { label: Named { name: ^loop_bound_edge }, target: measure }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn citation_arrow_two_param_loop(
  left_sym: v2.std.node.Symbol,
  right_sym: v2.std.node.Symbol,
  measure: Node
) -> Node {
  let left = citation_param_ref(sym: left_sym)
  let right = citation_param_ref(sym: right_sym)
  v2.std.node.Node {
    kind: TypeNode { connective: Arrow },
    children: [
      v2.std.node.Edge {
        label: Positional,
        target: v2.std.node.Node {
          kind: TypeNode { connective: Conj },
          children: [
            v2.std.node.Edge { label: Named { name: left_sym }, target: left },
            v2.std.node.Edge { label: Named { name: right_sym }, target: right }
          ],
          occurrence_id: SyntheticOccurrence
        }
      },
      v2.std.node.Edge {
        label: Positional,
        target: v2.std.node.Node {
          kind: TypeNode { connective: Atom { identity: ^copied_port_citation_return_type } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      },
      v2.std.node.Edge {
        label: Named { name: ^arrow_body_edge },
        target: citation_loop_body_linear_in(measure: measure)
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

data copied_port_citation_list_append: v2.lens.cost.copied_port_derivation.CombinerArrowCitation = v2.lens.cost.copied_port_derivation.CombinerArrowCitation {
  combiner: ^list_append,
  arrow: citation_arrow_two_param_loop(
    left_sym: ^copied_port_citation_list_append_left,
    right_sym: ^copied_port_citation_list_append_right,
    measure: citation_param_ref(sym: ^copied_port_citation_list_append_left)
  )
}

data copied_port_citation_list_snoc_item: v2.lens.cost.copied_port_derivation.CombinerArrowCitation = v2.lens.cost.copied_port_derivation.CombinerArrowCitation {
  combiner: ^list_snoc_item,
  arrow: citation_arrow_two_param_loop(
    left_sym: ^copied_port_citation_list_snoc_left,
    right_sym: ^copied_port_citation_list_snoc_right,
    measure: citation_param_ref(sym: ^copied_port_citation_list_snoc_left)
  )
}

data copied_port_citation_map_merge: v2.lens.cost.copied_port_derivation.CombinerArrowCitation = v2.lens.cost.copied_port_derivation.CombinerArrowCitation {
  combiner: ^map_merge,
  arrow: citation_arrow_two_param_loop(
    left_sym: ^copied_port_citation_map_merge_base,
    right_sym: ^copied_port_citation_map_merge_overlay,
    measure: citation_param_ref(sym: ^copied_port_citation_map_merge_overlay)
  )
}

data copied_port_combiner_arrow_citations: List<v2.lens.cost.copied_port_derivation.CombinerArrowCitation> = [
  copied_port_citation_list_append,
  copied_port_citation_list_snoc_item,
  copied_port_citation_map_merge
]

fn copied_port_fact_list_prepend(row: v2.std.algebra.CopiedPortFact, xs: List<v2.std.algebra.CopiedPortFact>) -> List<v2.std.algebra.CopiedPortFact> {
  Cons { head: row, tail: xs }
}

fn copied_port_derived_registry_rows() -> List<v2.std.algebra.CopiedPortFact> {
  fold_list(
    xs: copied_port_combiner_arrow_citations,
    empty: Empty,
    cons: fn(acc, cite) {
      match derive_copied_port_fact(combiner: cite.combiner, arrow: cite.arrow) {
        Absent => acc
        Present { value: row } => copied_port_fact_list_prepend(row: row, xs: acc)
      }
    }
  )
}

fn copied_port_index_of(combiner: v2.std.node.Symbol) -> Optional<Int> {
  copied_port_index_from_registry(
    rows: copied_port_derived_registry_rows(),
    combiner: combiner
  )
}
