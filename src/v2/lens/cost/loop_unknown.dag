module v2.test.lens_cost.loop_unknown

import v2.lens.cost { cost_lens }
import v2.std.logic { Bool }
import v2.std.node { ComputationNode, Conj, Loop, Node, TypeNode, SyntheticOccurrence }
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v2.std.witness { Violates }

data loop_unknown_input: Node = Node {
  kind: ComputationNode { behavior: Loop },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn loop_unknown_claim_holds() -> Bool {
  match cost_lens(n: loop_unknown_input) {
    Violates { diagnostic: _ } => true
    _ => false
  }
}

fn loop_unknown_claim_rhs() -> Node {
  if loop_unknown_claim_holds() {
    loop_unknown_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_loop_unknown: TestClaim = EqualsClaim {
  label: "lens_cost/loop_unknown: loop without bound fails closed",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: loop_unknown_input,
  rhs: loop_unknown_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}