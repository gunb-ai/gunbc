module v2.test.lens_cost.loop_unknown


data loop_unknown_input: Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: Loop },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn loop_unknown_claim_holds() -> Bool {
  match cost_lens(n: loop_unknown_input) {
    Violates { diagnostic: _ } => true
    _ => false
  }
}

fn loop_unknown_claim_rhs() -> Node {
  if loop_unknown_claim_holds() {
    loop_unknown_input
  } else {
    v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_loop_unknown: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "lens_cost/loop_unknown: loop without bound fails closed",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: loop_unknown_input,
  rhs: loop_unknown_claim_rhs(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
