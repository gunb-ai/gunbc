module v2.test.lens_cost.copied_port_derivation


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data copied_port_derivation_test_note: String = "Wave 1 Gate 1 C1 green-by-execution: per-op copied-port indices derive from cost lens over cited combiner Arrow ^arrow_body_edge bodies — matching the retired hand registry (list_append/left=0, list_snoc_item/left=0, map_merge/overlay=1). Discriminating RED: unpriceable combiner lookup yields Absent; multi-linear ambiguous body yields Absent (no tiebreak); citation-retained frontier count is 3."

test fn derived_list_append_copied_port_index_is_zero() -> Bool {
  match derive_copied_port_index_from_arrow(
    arrow: copied_port_citation_list_append.arrow
  ) {
    Present { value: idx } => idx == 0
    Absent => false
  }
}

test fn derived_list_snoc_copied_port_index_is_zero() -> Bool {
  match derive_copied_port_index_from_arrow(
    arrow: copied_port_citation_list_snoc_item.arrow
  ) {
    Present { value: idx } => idx == 0
    Absent => false
  }
}

test fn derived_map_merge_copied_port_index_is_one() -> Bool {
  match derive_copied_port_index_from_arrow(
    arrow: copied_port_citation_map_merge.arrow
  ) {
    Present { value: idx } => idx == 1
    Absent => false
  }
}

test fn derived_registry_lookup_matches_hand_retired_indices() -> Bool {
  match copied_port_index_of(combiner: ^list_append) {
    Present { value: a } =>
      match copied_port_index_of(combiner: ^list_snoc_item) {
        Present { value: b } =>
          match copied_port_index_of(combiner: ^map_merge) {
            Present { value: c } => (a == 0) && (b == 0) && (c == 1)
            Absent => false
          }
        Absent => false
      }
    Absent => false
  }
}

test fn unpriceable_combiner_lookup_refuses_red_control() -> Bool {
  wave1_gate1_c1_unregistered_combiner_lookup_refuses_holds()
}

test fn multi_linear_ambiguous_derivation_refuses_red_control() -> Bool {
  match derive_copied_port_index_from_arrow(
    arrow: citation_arrow_multi_linear_ambiguous(
      left_sym: ^copied_port_derivation_test_multi_linear_left,
      right_sym: ^copied_port_derivation_test_multi_linear_right
    )
  ) {
    Absent => true
    Present { value: _ } => false
  }
}

test fn citation_retained_frontier_count_is_three() -> Bool {
  copied_port_citation_retained_count() == 3
}
