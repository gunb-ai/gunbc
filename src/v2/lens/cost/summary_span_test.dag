module v2.test.lens_cost.summary_span


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn unit_cost_expr() -> v2.lens.cost.expr.CostExpr {
  v2.lens.cost.expr.cost_const(value: v2.std.nat.Succ { prev: v2.std.nat.Zero })
}

fn unit_complexity_summary() -> v2.lens.cost.summary.ComplexitySummary {
  v2.lens.cost.summary.ComplexitySummary {
    work: unit_cost_expr(),
    span: unit_cost_expr()
  }
}

fn triple_sequential_shape() -> v2.lens.cost.summary.ComplexitySummary {
  v2.lens.cost.summary.summary_sequential(
    left: unit_complexity_summary(),
    right: v2.lens.cost.summary.summary_sequential(
      left: unit_complexity_summary(),
      right: unit_complexity_summary()
    )
  )
}

fn triple_parallel_shape() -> v2.lens.cost.summary.ComplexitySummary {
  v2.lens.cost.summary.summary_parallel(
    left: unit_complexity_summary(),
    right: v2.lens.cost.summary.summary_parallel(
      left: unit_complexity_summary(),
      right: unit_complexity_summary()
    )
  )
}

fn is_pair_of_unit_costs(expr: v2.lens.cost.expr.CostExpr) -> Bool {
  match expr {
    v2.lens.cost.expr.CostAdd {
      left: v2.lens.cost.expr.CostConst { value: v2.std.nat.Succ { prev: v2.std.nat.Zero } },
      right: v2.lens.cost.expr.CostConst { value: v2.std.nat.Succ { prev: v2.std.nat.Zero } }
    } => true
    _ => false
  }
}

fn is_triple_of_unit_costs(expr: v2.lens.cost.expr.CostExpr) -> Bool {
  match expr {
    v2.lens.cost.expr.CostAdd {
      left: v2.lens.cost.expr.CostConst { value: v2.std.nat.Succ { prev: v2.std.nat.Zero } },
      right: v2.lens.cost.expr.CostAdd {
        left: v2.lens.cost.expr.CostConst { value: v2.std.nat.Succ { prev: v2.std.nat.Zero } },
        right: v2.lens.cost.expr.CostConst { value: v2.std.nat.Succ { prev: v2.std.nat.Zero } }
      }
    } => true
    _ => false
  }
}

test fn sequential_summary_adds_work_and_span() -> Bool {
  let left = unit_complexity_summary()
  let right = unit_complexity_summary()
  let combined = v2.lens.cost.summary.summary_sequential(left: left, right: right)
  is_pair_of_unit_costs(expr: combined.work)
    && is_pair_of_unit_costs(expr: combined.span)
}

test fn parallel_summary_adds_work_but_maxes_span() -> Bool {
  let left = unit_complexity_summary()
  let right = unit_complexity_summary()
  let combined = v2.lens.cost.summary.summary_parallel(left: left, right: right)
  match combined.span {
    v2.lens.cost.expr.CostMax { left: _, right: _ } =>
      is_pair_of_unit_costs(expr: combined.work)
    _ => false
  }
}

test fn equal_work_different_shape_derives_equal_work_different_span() -> Bool {
  let sequential = triple_sequential_shape()
  let parallel = triple_parallel_shape()
  is_triple_of_unit_costs(expr: sequential.work)
    && is_triple_of_unit_costs(expr: parallel.work)
    && sequential.work == parallel.work
    && sequential.span != parallel.span
}

test fn equal_work_span_operands_match_exactly() -> Bool {
  let left = unit_complexity_summary()
  let right = unit_complexity_summary()
  let sequential = v2.lens.cost.summary.summary_sequential(left: left, right: right)
  let parallel = v2.lens.cost.summary.summary_parallel(left: left, right: right)
  match sequential.span {
    v2.lens.cost.expr.CostAdd { left: seq_l, right: seq_r } =>
      match parallel.span {
        v2.lens.cost.expr.CostMax { left: par_l, right: par_r } =>
          seq_l == par_l
            && seq_r == par_r
            && sequential.work == parallel.work
            && sequential.span != parallel.span
        _ => false
      }
    _ => false
  }
}
