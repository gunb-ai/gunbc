module v2.test.lens_cost.map_linear

data map_linear_body_leaf: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^map_linear_body_atom } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data map_linear_body: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: v2.std.node.Transform },
  children: [
    v2.std.node.Edge { label: v2.std.node.Positional, target: map_linear_body_leaf }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data map_linear_input: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Cardinality },
  children: [
    v2.std.node.Edge { label: v2.std.node.Positional, target: map_linear_body }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

test fn map_linear_claim_holds() -> Bool {
  match v2.lens.cost.cost_lens(n: map_linear_input) {
    Holds { value: actual } =>
      actual == v2.lens.cost.LinearCost { variable: v2.lens.cost.SizeVariable { source: map_linear_input } }
    _ => false
  }
}
