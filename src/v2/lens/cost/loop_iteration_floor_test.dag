module v2.test.lens_cost.loop_iteration_floor

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data loop_iteration_floor_body: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^loop_iteration_floor_body_atom } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data loop_iteration_floor_measure: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^loop_iteration_floor_measure_atom } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data loop_iteration_floor_input: Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: Loop },
  children: [
    v2.std.node.Edge { label: Positional, target: loop_iteration_floor_body },
    v2.std.node.Edge { label: Named { name: ^loop_bound_edge }, target: loop_iteration_floor_measure }
  ],
  occurrence_id: SyntheticOccurrence
}

test fn loop_iteration_floor_projects_linear() -> Bool {
  match cost_lens(n: loop_iteration_floor_input) {
    Holds { value: actual } =>
      match actual {
        LinearCost { variable: sv } => sv.source == loop_iteration_floor_measure
        _ => false
      }
    _ => false
  }
}

test fn symbolic_product_absorbs_zero() -> Bool {
  symbolic_product(
    a: linear_in_node(n: loop_iteration_floor_measure),
    b: zero_cost()
  ) == zero_cost()
}

