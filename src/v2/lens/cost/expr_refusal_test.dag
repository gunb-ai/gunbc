module v2.test.lens_cost.expr_refusal

import std.decl_ref { DeclarationRef, WholeDeclaration }
import v2.lens.cost { LinearCost, LogCost, SizeVariable, UnknownCost }
import v2.lens.cost.expr {
  CostEffect,
  cost_log,
  normalize_cost_expr_to_symbolic,
  size_of
}
import v2.std.logic { Bool }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.nat { Nat, Succ, Zero }
import v2.std.node {
  Atom,
  Node,
  TypeNode,
  SyntheticOccurrence
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data expr_refusal_log_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^expr_refusal_log_atom } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data expr_refusal_log_variable: SizeVariable = SizeVariable {
  source: expr_refusal_log_leaf
}

data expr_refusal_effect_operation: DeclarationRef = DeclarationRef {
  module_path: "v2.lens.cost",
  decl_name: "cost_lens",
  field: WholeDeclaration
}

fn log_base_two() -> Nat {
  Succ { prev: Succ { prev: Zero } }
}

test fn invalid_log_base_zero_refuses() -> Bool {
  match normalize_cost_expr_to_symbolic(
    expr: cost_log(
      base: Zero,
      argument: size_of(variable: expr_refusal_log_variable)
    )
  ) {
    UnknownCost { diagnostic: d } => d.reason == ^cost_expr_refusal_invalid_log_base
    _ => false
  }
}

test fn invalid_log_base_one_refuses() -> Bool {
  match normalize_cost_expr_to_symbolic(
    expr: cost_log(
      base: Succ { prev: Zero },
      argument: size_of(variable: expr_refusal_log_variable)
    )
  ) {
    UnknownCost { diagnostic: d } => d.reason == ^cost_expr_refusal_invalid_log_base
    _ => false
  }
}

test fn valid_log_base_two_projects_log_cost() -> Bool {
  match normalize_cost_expr_to_symbolic(
    expr: cost_log(
      base: log_base_two(),
      argument: size_of(variable: expr_refusal_log_variable)
    )
  ) {
    LogCost { variable: v } => v.source == expr_refusal_log_leaf
    _ => false
  }
}

test fn cost_effect_projects_unmodeled_effect_refusal() -> Bool {
  match normalize_cost_expr_to_symbolic(
    expr: CostEffect { operation: expr_refusal_effect_operation }
  ) {
    UnknownCost { diagnostic: d } => d.reason == ^cost_expr_refusal_unmodeled_effect
    LinearCost { variable: _ } => false
    LogCost { variable: _ } => false
    _ => false
  }
}
