module v2.test.lens_cost.expr_refusal


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data expr_refusal_log_leaf: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^expr_refusal_log_atom } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data expr_refusal_log_variable: v2.lens.cost.SizeVariable = v2.lens.cost.SizeVariable {
  source: expr_refusal_log_leaf
}

data expr_refusal_effect_operation: std.decl_ref.DeclarationRef = std.decl_ref.DeclarationRef {
  module_path: "v2.lens.cost",
  decl_name: "cost_lens",
  field: std.decl_ref.WholeDeclaration
}

fn log_base_two() -> v2.std.nat.Nat {
  v2.std.nat.Succ { prev: v2.std.nat.Succ { prev: v2.std.nat.Zero } }
}

test fn invalid_log_base_zero_refuses() -> Bool {
  match v2.lens.cost.expr.normalize_cost_expr_to_symbolic(
    expr: v2.lens.cost.expr.cost_log_expr(
      base: v2.std.nat.Zero,
      argument: v2.lens.cost.expr.size_of(variable: expr_refusal_log_variable)
    )
  ) {
    v2.lens.cost.UnknownCost { diagnostic: d } => d.reason == ^cost_expr_refusal_invalid_log_base
    _ => false
  }
}

test fn invalid_log_base_one_refuses() -> Bool {
  match v2.lens.cost.expr.normalize_cost_expr_to_symbolic(
    expr: v2.lens.cost.expr.cost_log_expr(
      base: v2.std.nat.Succ { prev: v2.std.nat.Zero },
      argument: v2.lens.cost.expr.size_of(variable: expr_refusal_log_variable)
    )
  ) {
    v2.lens.cost.UnknownCost { diagnostic: d } => d.reason == ^cost_expr_refusal_invalid_log_base
    _ => false
  }
}

test fn valid_log_base_two_projects_log_cost() -> Bool {
  match v2.lens.cost.expr.normalize_cost_expr_to_symbolic(
    expr: v2.lens.cost.expr.cost_log_expr(
      base: log_base_two(),
      argument: v2.lens.cost.expr.size_of(variable: expr_refusal_log_variable)
    )
  ) {
    v2.lens.cost.LogCost { variable: v } => v.source == expr_refusal_log_leaf
    _ => false
  }
}

test fn cost_effect_projects_unmodeled_effect_refusal() -> Bool {
  match v2.lens.cost.expr.normalize_cost_expr_to_symbolic(
    expr: v2.lens.cost.expr.CostEffect { operation: expr_refusal_effect_operation }
  ) {
    v2.lens.cost.UnknownCost { diagnostic: d } => d.reason == ^cost_expr_refusal_unmodeled_effect
    v2.lens.cost.LinearCost { variable: _ } => false
    v2.lens.cost.LogCost { variable: _ } => false
    _ => false
  }
}
