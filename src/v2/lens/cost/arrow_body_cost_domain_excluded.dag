module v2.test.lens_cost.arrow_body_cost_domain_excluded

import v2.lens.cost { SumCost, cost_lens, unit_cost }
import v2.std.logic { Bool }
import v2.std.node {
  Arrow,
  Atom,
  Cardinality,
  ComputationNode,
  Conj,
  Edge,
  Named,
  Node,
  Positional,
  Symbol,
  Transform,
  TypeNode,
  SyntheticOccurrence
}
import v2.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v2.std.witness { Holds }

data arrow_body_cost_domain_excluded_note: String = "Discriminating RED for Wave 1 Gate 1 C1: Arrow domain Cardinality children must NOT inflate the cost fold — only ^arrow_body_edge is priced. If edge_contributes_to_cost_fold regresses to include Arrow positional children, this witness goes red (domain linear cost would dominate)."

data arrow_body_cost_domain_param: Node = Node {
  kind: TypeNode { connective: Cardinality },
  children: [
    Edge {
      label: Positional,
      target: Node {
        kind: TypeNode { connective: Atom { identity: ^arrow_body_cost_domain_param_atom } },
        children: [],
        occurrence_id: SyntheticOccurrence
      }
    }
  ],
  occurrence_id: SyntheticOccurrence
}

data arrow_body_cost_body: Node = Node {
  kind: ComputationNode { behavior: Transform },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data arrow_body_cost_arrow: Node = Node {
  kind: TypeNode { connective: Arrow },
  children: [
    Edge { label: Positional, target: arrow_body_cost_domain_param },
    Edge {
      label: Positional,
      target: Node {
        kind: TypeNode { connective: Atom { identity: ^arrow_body_cost_return_type } },
        children: [],
        occurrence_id: SyntheticOccurrence
      }
    },
    Edge {
      label: Positional,
      target: Node {
        kind: TypeNode { connective: Atom { identity: ^arrow_body_cost_return_type } },
        children: [],
        occurrence_id: SyntheticOccurrence
      }
    },
    Edge { label: Named { name: ^arrow_body_edge }, target: arrow_body_cost_body }
  ],
  occurrence_id: SyntheticOccurrence
}

fn arrow_body_cost_domain_excluded_holds() -> Bool {
  match cost_lens(n: arrow_body_cost_arrow) {
    Holds { value: actual } =>
      actual == SumCost {
        lhs: unit_cost(),
        rhs: unit_cost()
      }
    _ => false
  }
}

fn arrow_body_cost_domain_excluded_rhs() -> Node {
  if arrow_body_cost_domain_excluded_holds() {
    arrow_body_cost_arrow
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
    }
  }
}

data claim_arrow_body_cost_domain_excluded: TestClaim = EqualsClaim {
  label: "lens_cost/arrow_body_cost_domain_excluded: Arrow cost fold prices ^arrow_body_edge only, not domain Cardinality",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: arrow_body_cost_arrow,
  rhs: arrow_body_cost_domain_excluded_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

test fn arrow_body_cost_domain_excluded_claim_holds() -> Bool {
  arrow_body_cost_domain_excluded_holds()
}
