module v2.lens.single_constructor

import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }
import std.disposition { SingleAuthority }
import v2.extdeps.languages.dag {
  parse_production_emitted_identity_optional,
  qualified_name_from_module_node
}
import v2.std.algebra { any, fold_list }
import v2.std.collection { List }
import v2.std.optional {
  Absent,
  Optional,
  Present,
  optional_absent,
  optional_present
}
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  NonEmptyDiagnostics,
  Outcome,
  Rejected,
  Unavailable,
  node_locus,
  outcome_accepted
}
import v2.std.logic { Bool }
import v2.std.node {
  Edge,
  Named,
  Node,
  NodeFoldTopDown,
  Positional,
  Symbol,
  fold_node_topdown,
  match_arm_pattern
}
import v2.std.node_query { construct_tag_optional }
import v2.std.compilers.body_lowering {
  ApplicationSlotsFound,
  ApplicationSlotsRefused,
  ArrowHead,
  AtomHead,
  NotApplicationSlots,
  application_slots
}
import std.algebra { Cons, Empty }
import v2.std.qualified_name { QualifiedName, qualified_name_to_dotted_string }
import v2.std.witness { Holds, Witness }

// SINGLE-CONSTRUCTOR DISCIPLINE, ONE WALK, ONE ROW PER GOVERNED TYPE. A governed type may be
// MATERIALIZED only in its sanctioned home modules or in a witness; anywhere else a direct
// construction fails compilation, located at the construction. Each governed type is a
// SingleConstructorRule row, so adding one is a row rather than a second whole-tree walk.
//
// RECOGNITION READS BOTH SPELLINGS OF A CONSTRUCTION. A record literal `T { .. }` lowers to a
// construct -- a Conj whose first edge names the tag (v2.std.node_query construct_tag_optional);
// a call-spelled `T(..)` lowers to an application whose head is the atom T. The walk this replaced
// read only the second, so a record literal of a governed type passed unseen. The application is
// read through the base read v2.std.compilers.body_lowering application_slots: the question is
// the head, never an operand, and a refused application is itself a finding, never "not a call".
//
// SCOPE: witness modules (test.claim.*, v2.test.*) are sanctioned for every row -- a witness that
// constructs a governed value to exercise its refusal arms is building the escape hatch to TEST
// it, not smuggling one.
//
// THE ROWS.
// MachineShape (machine-shape-orthogonal-scheduling.md §2 ruling 9 / operator redirect 2026-07-16):
// home std.machine_shape; catalog fills beside cited rows in extdeps.*.machine_shape. Production
// substrate elsewhere calls shape_from_catalog and matches MachineShapeConstruction.
// FnArrowDecl (MQ-2, gunbc#12202): home v2.std.fn_index; otherwise produced only by the host
// fn-arrow marshal (v1_compiler.coproduct_reflection), which is not .dag source and never reaches
// this walk. The rule is what makes the FnArrowDecl input type a PROVENANCE: v2.std.fn_index
// skeleton_application_read reads an empty Conj as SkeletonUnprojected only because nothing but
// the marshal, that module and a witness can construct the declaration it is given.

type SingleConstructorRule {
  constructor: Symbol
  reason: Symbol
  sanctioned_home: fn(QualifiedName) -> Bool
}

fn machine_shape_home(qn: QualifiedName) -> Bool {
  let dotted = qualified_name_to_dotted_string(qn: qn)
  dotted == "std.machine_shape"
    || (dotted.starts_with(prefix: "extdeps.") && dotted.ends_with(suffix: ".machine_shape"))
}

fn fn_arrow_decl_home(qn: QualifiedName) -> Bool {
  qualified_name_to_dotted_string(qn: qn) == "v2.std.fn_index"
}

data machine_shape_single_constructor_rule: SingleConstructorRule = SingleConstructorRule {
  constructor: ^MachineShape,
  reason: ^machine_shape_unsanctioned_construction,
  sanctioned_home: machine_shape_home
}

data fn_arrow_decl_single_constructor_rule: SingleConstructorRule = SingleConstructorRule {
  constructor: ^FnArrowDecl,
  reason: ^fn_arrow_decl_unsanctioned_construction,
  sanctioned_home: fn_arrow_decl_home
}

fn single_constructor_rules() -> List<SingleConstructorRule> {
  [machine_shape_single_constructor_rule, fn_arrow_decl_single_constructor_rule]
}

fn qualified_name_is_witness_module(qn: QualifiedName) -> Bool {
  let dotted = qualified_name_to_dotted_string(qn: qn)
  dotted.starts_with(prefix: "test.claim.")
    || dotted.starts_with(prefix: "v2.test.")
}

fn module_sanctions(rule: SingleConstructorRule, qn: Optional<QualifiedName>) -> Bool {
  match qn {
    Absent => false
    Present { value: qn0 } => qualified_name_is_witness_module(qn: qn0) || rule.sanctioned_home(qn0)
  }
}

fn module_qn_from_node(n: Node, inherited: Optional<QualifiedName>) -> Optional<QualifiedName> {
  match parse_production_emitted_identity_optional(node: n) {
    Present { value: id } =>
      if id == ^dag_surface_module {
        match qualified_name_from_module_node(root: n) {
          Accepted { value: qn, diagnostics: _ } => optional_present(value: qn)
          Rejected { diagnostics: _ } => inherited
        }
      } else {
        inherited
      }
    Absent => inherited
  }
}

fn unsanctioned_construction_diagnostic(reason: Symbol, n: Node) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: n),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

// WHAT THIS NODE CONSTRUCTS, IF ANYTHING, as the tag it names. An Arrow head is a resolved
// function reference, never a record constructor, so it constructs nothing. Refused is a finding in its own
// right: a partial application may be exactly the construction a rule exists to catch.
type ConstructedTag
  = NoConstruction
  | Constructs { tag: Symbol }
  | ConstructionUnreadable { diagnostics: NonEmptyDiagnostics }

fn constructed_tag(n: Node) -> ConstructedTag {
  match construct_tag_optional(n: n) {
    Present { value: tag } => Constructs { tag: tag }
    Absent =>
      match application_slots(site: n) {
        NotApplicationSlots => NoConstruction
        ApplicationSlotsRefused { diagnostics: d } => ConstructionUnreadable { diagnostics: d }
        ApplicationSlotsFound { slots: v } =>
          match v.head_identity {
            AtomHead { identity: sym } => Constructs { tag: sym }
            ArrowHead => NoConstruction
          }
      }
  }
}

fn diagnostics_as_list(d: NonEmptyDiagnostics) -> List<Diagnostic> {
  Cons { head: d.head, tail: d.tail }
}

// Refusals are reported only where some rule would govern the module; a module every rule
// sanctions has nothing this gate could forbid.
fn local_single_constructor_findings(n: Node, module_qn: Optional<QualifiedName>) -> List<Diagnostic> {
  match constructed_tag(n: n) {
    NoConstruction => single_constructor_no_findings
    ConstructionUnreadable { diagnostics: d } =>
      if any(xs: single_constructor_rules(), predicate: fn(rule) { !module_sanctions(rule: rule, qn: module_qn) }) {
        diagnostics_as_list(d: d)
      } else {
        single_constructor_no_findings
      }
    Constructs { tag: tag } =>
      fold_list(xs: single_constructor_rules(), empty: single_constructor_no_findings, cons: fn(acc, rule) {
        if (tag == rule.constructor) && !module_sanctions(rule: rule, qn: module_qn) {
          concat(acc, [unsanctioned_construction_diagnostic(reason: rule.reason, n: n)])
        } else {
          acc
        }
      })
  }
}

// `in_pattern`: below a match arm's pattern edge a construct is a DESTRUCTURING, not a
// construction, so no rule applies there.
type SingleConstructorWalkCtx {
  module_qn: Optional<QualifiedName>
  in_pattern: Bool
}

data single_constructor_no_findings: List<Diagnostic> = []

type SingleConstructorWalkResult {
  module_qn: Optional<QualifiedName>
  findings: List<Diagnostic>
}

fn single_constructor_walk_init(n: Node, ctx: SingleConstructorWalkCtx) -> SingleConstructorWalkResult {
  let module_qn = module_qn_from_node(n: n, inherited: ctx.module_qn)
  SingleConstructorWalkResult {
    module_qn: module_qn,
    findings: if ctx.in_pattern { single_constructor_no_findings } else { local_single_constructor_findings(n: n, module_qn: module_qn) }
  }
}

fn single_constructor_walk_child_context(
  n: Node,
  ctx: SingleConstructorWalkCtx,
  e: Edge
) -> SingleConstructorWalkCtx {
  SingleConstructorWalkCtx {
    module_qn: module_qn_from_node(n: n, inherited: ctx.module_qn),
    in_pattern: ctx.in_pattern || (match e.label {
      Named { name: nm } => nm == match_arm_pattern
      Positional => false
    })
  }
}

fn single_constructor_walk_step(
  acc: SingleConstructorWalkResult,
  _: Edge,
  child_r: SingleConstructorWalkResult
) -> SingleConstructorWalkResult {
  SingleConstructorWalkResult {
    module_qn: child_r.module_qn,
    findings: concat(acc.findings, child_r.findings)
  }
}

fn single_constructor_topdown_algebra() -> NodeFoldTopDown<SingleConstructorWalkCtx, SingleConstructorWalkResult> {
  NodeFoldTopDown {
    init: single_constructor_walk_init,
    child_context: single_constructor_walk_child_context,
    step: single_constructor_walk_step
  }
}

fn single_constructor_findings(root: Node) -> List<Diagnostic> {
  match fold_node_topdown(
    n: root,
    ctx: SingleConstructorWalkCtx { module_qn: optional_absent(), in_pattern: false },
    algebra: single_constructor_topdown_algebra()
  ) {
    SingleConstructorWalkResult { module_qn: _, findings: findings } => findings
  }
}

data compile_gate_law: String = "Single-constructor compile gate: a governed type (one SingleConstructorRule row each -- MachineShape, FnArrowDecl) constructed outside its sanctioned home modules and outside test/claim witnesses FAILS COMPILATION, inheriting compile's affected-set scoping. Recognition reads both lowered spellings of a construction: the record-literal construct tag and the call-spelled application head. Grain: rooted whole-tree walk (module-context fold_node_topdown) -- registers at CompileLensRoot grain in required_compile_lens_roster, not at CompileLensSubtree. Witness lane = RED and GREEN controls in v2.test.claim.single_constructor_wall; enforcement never the witness."

fn single_constructor_compile_gate(node: Node) -> Outcome<Witness<Node>> {
  match single_constructor_findings(root: node) {
    Cons { head: first, tail: rest } =>
      Rejected {
        diagnostics: NonEmptyDiagnostics { head: first, tail: rest }
      }
    Empty => outcome_accepted(value: Holds { value: node })
  }
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SingleAuthority }
}
