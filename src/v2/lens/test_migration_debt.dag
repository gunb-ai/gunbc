module v2.lens.test_migration_debt
import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }
import std.disposition { SingleAuthority }

import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }
import test.retirement.model {
  RetainedLegacyRustTestModule,
  retained_legacy_rust_test_modules,
  retained_module_source_file,
}

// THE RETENTION WALL, replacing the migration-debt ratchets and the delete guard.
//
// What was here before measured a SHRINKING DEBT: three point-in-time ceilings
// (module count, LOC, test count) plus a guard refusing any deletion whose stem
// was not covered by a witness. That shape assumed the population would be
// drained one family at a time, and it priced every departure. It is retired
// with the population it was measuring.
//
// The wall is now exact equality in BOTH directions between the discovered Rust
// test modules and the declared retained rows. There is no ceiling to ratchet
// and no per-deletion authorization, because deletion is represented by the file
// being absent. Adding an undeclared Rust test module reds; deleting a declared
// one reds as a stale row.
//
// Both populations are LIVE host observations, so neither side is a count copied
// from the tree — the equality is an identity join, not a numeric comparison.
fn retained_declared_source_files() -> List<String> {
  retained_legacy_rust_test_modules() |> map(m => retained_module_source_file(m: m))
}

fn discovered_rust_test_modules() -> List<String> {
  test_migration_debt_module_names()
}

fn discovered_legacy_behavior_ids() -> List<String> {
  test_migration_legacy_behavior_ids()
}

fn list_contains_name(xs: List<String>, needle: String) -> Bool {
  xs |> any(x => x == needle)
}

fn count_occurrences(xs: List<String>, needle: String) -> Int {
  xs |> filter(x => x == needle) |> count
}

fn names_are_duplicate_free(xs: List<String>) -> Bool {
  xs |> all(x => count_occurrences(xs: xs, needle: x) == 1)
}

// Every declared retained row names a module that is actually present.
fn every_retained_row_resolves() -> Bool {
  retained_declared_source_files()
    |> all(f => list_contains_name(xs: discovered_rust_test_modules(), needle: f))
}

// Every discovered module is declared. This is the half that makes a NEW
// undeclared Rust test file red by construction.
fn every_discovered_module_is_retained() -> Bool {
  discovered_rust_test_modules()
    |> all(f => list_contains_name(xs: retained_declared_source_files(), needle: f))
}

// Every retained module contributes at least one discovered #[test] identity,
// so a retained row cannot point at a module that has no executable content.
// Identities are `source_file::test_fn`.
fn retained_module_has_a_discovered_test(source_file: String) -> Bool {
  discovered_legacy_behavior_ids()
    |> any(id => string_starts_with(s: id, prefix: concat(source_file, "::")))
}

fn every_retained_module_has_a_test() -> Bool {
  retained_declared_source_files()
    |> all(f => retained_module_has_a_discovered_test(source_file: f))
}

// An empty discovered population must not pass accidentally while rows remain,
// and an empty roster must not pass while modules remain. Both sides nonzero is
// the fail-closed floor under the equality above.
fn retention_populations_are_nonempty() -> Bool {
  count(retained_declared_source_files()) > 0
    && count(discovered_rust_test_modules()) > 0
    && count(discovered_legacy_behavior_ids()) > 0
}

fn retained_rust_kernel_wall_holds() -> Bool {
  retention_populations_are_nonempty()
    && names_are_duplicate_free(xs: retained_declared_source_files())
    && names_are_duplicate_free(xs: discovered_rust_test_modules())
    && every_retained_row_resolves()
    && every_discovered_module_is_retained()
    && every_retained_module_has_a_test()
}

fn retained_rust_kernel_wall_holds_live() -> Bool {
  retained_rust_kernel_wall_holds()
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SingleAuthority }
}
