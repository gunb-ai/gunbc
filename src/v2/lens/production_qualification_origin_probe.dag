  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: v2.std.compilers.lexing.symbol_intern_lexeme(lexeme: mint_provenanced_callee) } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn parameter_borne_fixture_mint_planted_decl() -> v2.std.fn_index.FnArrowDecl {
  v2.std.fn_index.FnArrowDecl {
    qualified_name: "synthetic.production_qualification_origin_probe.parameter_borne_fixture_mint_red_control",
    name: "parameter_borne_fixture_mint_red_control_planted_decl",
    output: v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: Conj },
      children: [
        v2.std.node.Edge { label: v2.std.node.Positional, target: probe_mint_provenanced_callee_atom_node() }
      ],
