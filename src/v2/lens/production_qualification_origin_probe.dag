module v2.lens.production_qualification_origin_probe


data production_qualification_origin_probe_law: String = "Production-qualification origin PROBE (session keen-lark-681, wise-ram-22 recut): NOT a repository-wide census. v2.std.fn_index.fn_arrow_decl_facts_live() scope is entry-closure today; repository-wide frequency is unknown. This carrier reports fixture-origin mint surfaces discovered by STRUCTURAL skeleton rules (mint/advance callee atoms + direct_rust_door_inferred_tree fixture-tree marker only — never target-model proxy, never declaration-name recognition). Origin vocabulary: ProductionQualificationOrigin = CompilerDerived | FixtureDerived | UnknownOrigin only — ExecutionMeasured is ProductionEvidenceGrounding, not an origin (a fixture-derived artifact may also be execution-measured). Known direct-door fixture-origin mint surfaces detected in live scope: see known_fixture_origin_mint_surface_count_in_scope() (honest live-read; zero today per production_qualification_live_scope_fixture_origin_policy_note while G2 marshal prunes callee atoms). Classifier proof uses planted_fixture_origin_mint_site_count() against production_qualification_planted_fixture_origin_oracle_count. Repository-wide frequency: unknown. Dissolve-on: derive every resolved call occurrence capable of constructing or advancing a production qualification (effect_reach / call-occurrence substrate), classify origins with call/dataflow evidence, attach ProductionEvidenceGrounding orthogonally, and retire name/closure pins."

data production_qualification_origin_call_occurrence_frontier_note: String = "SCAFFOLD frontier (wise-ram-22 required recut): population is NOT derived from resolved call occurrences yet — only fn-arrow skeleton callee/marker projection inside the witness entry's import closure. Ingest-inline surfaces whose mint callee is pruned by G2 marshal, indirect consumer reachability, and repository-wide mint sites outside the closure are invisible. No admitted RED witness keys on a manually flippable boolean — repository-wide closure waits for a queryable call-occurrence population authority. Dissolve-on when call-reachable production-qualification classification shares the effect_reach skeleton authority."

data production_qualification_construction_wall_path_frontier_note: String = "Construction-wall path split (wise-ram-22 addendum, royal-crab-235 lane): sole_constructor record-literal refusal executes on the v1 seed infer path only — v2.compiler.04_infer carries zero sole_constructor handling today. A construction site this probe discovers is NOT automatically in a guarded population; guard presence is a property of the compiler PATH, not the site. This probe classifies structural skeleton origin only — it never infers 'sole_constructor exists therefore this form is walled'."

data construction_justification: v2.lens.common.construction_justification.ConstructionJustification = v2.lens.common.construction_justification.ConstructionJustification {
  class: v2.lens.common.construction_justification.WallAfterGrounding { dissolves_to: std.disposition.SingleAuthority }
}

data production_qualification_counted_qualifications_note: String = "Axes derived_sites_for_decl can construct today at fn-arrow skeleton grain — v2.compiler.self_host.emitter_producer_provenance.SourceProduced and v2.compiler.self_host.emitter_producer_provenance.CargoGreen only. ProductionRouted and BehavioralEquivalent remain reserved for call-occurrence / dataflow grounding. Execution evidence is ProductionEvidenceGrounding, not an v2.compiler.self_host.emitter_producer_provenance.EmissionQualification axis."

data production_evidence_grounding_vocabulary_note: String = "B0-aligned vocabulary (wise-ram-22): ProductionQualificationOrigin = CompilerDerived | FixtureDerived | UnknownOrigin. ProductionEvidenceGrounding = StructurallyGrounded | ExecutionMeasured | Unmeasured — measurement carries an origin, never replaces one. Rows do not populate grounding at skeleton grain yet; the carrier declares the split so probe and B0 share one epistemology."

data production_qualification_counted_qualifications: List<v2.compiler.self_host.emitter_producer_provenance.EmissionQualification> = [
  v2.compiler.self_host.emitter_producer_provenance.SourceProduced,
  v2.compiler.self_host.emitter_producer_provenance.CargoGreen
]

type ProductionQualificationOrigin
  = CompilerDerived
  | FixtureDerived
  | UnknownOrigin

type ProductionEvidenceGrounding
  = StructurallyGrounded
  | ExecutionMeasured
  | Unmeasured

type DerivedProductionQualificationMintSiteRow {
  qualified_name: String
  qualification_axis: v2.compiler.self_host.emitter_producer_provenance.EmissionQualification
  evidence_origin: ProductionQualificationOrigin
}

data empty_string_list: List<String> = []
data empty_symbol_list: List<v2.std.node.Symbol> = []
data empty_site_list: List<DerivedProductionQualificationMintSiteRow> = []

data mint_written_callee: String = "mint_written_provenanced_rust_artifact"
data mint_provenanced_callee: String = "mint_provenanced_rust_artifact"
data advance_cargo_green_callee: String = "advance_written_provenanced_rust_artifact_cargo_green"
data direct_rust_door_inferred_tree_atom: String = "direct_rust_door_inferred_tree"

data ingest_mint_skeleton_classifier_note: String = "Ingest entry skeleton grain (review 47980): generate_provenanced_rust_candidate_from_ingest calls mint_provenanced_rust_artifact directly. Callee identity alone does not prove compiler origin — mint_provenanced accepts raw InferredTree — so skeleton discovery without fixture marker or call/dataflow evidence stays UnknownOrigin until call-occurrence derivation lands."

// CompilerDerived is declared but UNWRITABLE at skeleton grain: callee identity proves a qualification boundary was called, not that the InferredTree argument came from production infer(assemble(...)). Until call/dataflow evidence connects arguments, non-fixture mint surfaces classify UnknownOrigin and fail admission.
data ingest_mint_entry_name_suffix: String = "generate_provenanced_rust_candidate_from_ingest"

fn string_eq(a: String, b: String) -> v2.std.logic.Bool {
  a == b
}

fn symbol_eq(a: v2.std.node.Symbol, b: v2.std.node.Symbol) -> v2.std.logic.Bool {
  a == b
}

fn production_qualification_origin_eq(
  left: ProductionQualificationOrigin,
  right: ProductionQualificationOrigin
) -> v2.std.logic.Bool {
  match left {
    CompilerDerived =>
      match right {
        CompilerDerived => true
        FixtureDerived => false
        UnknownOrigin => false
      }
    FixtureDerived =>
      match right {
        CompilerDerived => false
        FixtureDerived => true
        UnknownOrigin => false
      }
    UnknownOrigin =>
      match right {
        CompilerDerived => false
        FixtureDerived => false
        UnknownOrigin => true
      }
  }
}

fn site_row_already_present(
  sites: List<DerivedProductionQualificationMintSiteRow>,
  qualified_name: String,
  axis: v2.compiler.self_host.emitter_producer_provenance.EmissionQualification
) -> v2.std.logic.Bool {
  v2.std.algebra.any(
    xs: sites,
    predicate: fn(row) {
      v2.lens.production_qualification_origin_probe.string_eq(a: row.qualified_name, b: qualified_name)
        && v2.compiler.self_host.emitter_producer_provenance.emission_qualification_eq(
          left: row.qualification_axis,
          right: axis
        )
    }
  )
}

fn maybe_snoc_site_row(
  sites: List<DerivedProductionQualificationMintSiteRow>,
  qualified_name: String,
  axis: v2.compiler.self_host.emitter_producer_provenance.EmissionQualification,
  origin: ProductionQualificationOrigin
) -> List<DerivedProductionQualificationMintSiteRow> {
  if site_row_already_present(sites: sites, qualified_name: qualified_name, axis: axis) {
    sites
  } else {
    v2.std.algebra.list_snoc_item(
      xs: sites,
      item: DerivedProductionQualificationMintSiteRow {
        qualified_name: qualified_name,
        qualification_axis: axis,
        evidence_origin: origin
      }
    )
  }
}

type AtomCollectState {
  node: v2.std.node.Node
  atoms: List<v2.std.node.Symbol>
}

fn atom_collect_init(n: v2.std.node.Node) -> AtomCollectState {
  AtomCollectState { node: n, atoms: empty_symbol_list }
}

fn atom_collect_step(acc: AtomCollectState, _edge: v2.std.node.Edge, child: AtomCollectState) -> AtomCollectState {
  let atoms = match v2.std.grammar.node_atom_identity_optional(node: child.node) {
    v2.std.optional.Present { value: sym } =>
      if v2.std.algebra.contains(xs: acc.atoms, item: sym, eq: v2.lens.production_qualification_origin_probe.symbol_eq) {
        acc.atoms
      } else {
        v2.std.algebra.list_snoc_item(xs: acc.atoms, item: sym)
      }
    v2.std.optional.Absent => acc.atoms
  }
  AtomCollectState { node: acc.node, atoms: atoms }
}

fn atom_collect_algebra() -> v2.std.node.NodeFold<AtomCollectState> {
  v2.std.node.NodeFold { init: v2.lens.production_qualification_origin_probe.atom_collect_init, step: atom_collect_step }
}

fn atom_identities_in_node(node: v2.std.node.Node) -> List<v2.std.node.Symbol> {
  let from_descendants = v2.std.node.fold_node(n: node, algebra: v2.lens.production_qualification_origin_probe.atom_collect_algebra()).atoms
  match v2.std.grammar.node_atom_identity_optional(node: node) {
    v2.std.optional.Present { value: sym } =>
      if v2.std.algebra.contains(xs: from_descendants, item: sym, eq: v2.lens.production_qualification_origin_probe.symbol_eq) {
        from_descendants
      } else {
        v2.std.algebra.list_snoc_item(xs: from_descendants, item: sym)
      }
    v2.std.optional.Absent => from_descendants
  }
}

fn node_contains_atom_text(node: v2.std.node.Node, wanted: String) -> v2.std.logic.Bool {
  v2.std.algebra.any(
    xs: v2.lens.production_qualification_origin_probe.atom_identities_in_node(node: node),
    predicate: fn(sym) { v2.lens.production_qualification_origin_probe.string_eq(a: v2.std.compilers.lexing.symbol_lexeme(sym: sym), b: wanted) }
  )
}

type CalleeCollectState {
  node: v2.std.node.Node
  callees: List<String>
}

fn callee_collect_init(n: v2.std.node.Node) -> CalleeCollectState {
  CalleeCollectState { node: n, callees: empty_string_list }
}

fn maybe_snoc_callee_text(callees: List<String>, text: String) -> List<String> {
  if v2.std.algebra.contains(xs: callees, item: text, eq: v2.lens.production_qualification_origin_probe.string_eq) {
    callees
  } else {
    v2.std.algebra.list_snoc_item(xs: callees, item: text)
  }
}

fn callee_text_from_call_node(node: v2.std.node.Node) -> List<String> {
  if v2.std.node_query.node_is_call(node: node) {
    match v2.std.node_query.call_callee_target(node: node) {
      Accepted { value: callee_node, diagnostics: _ } =>
        match v2.std.grammar.node_atom_identity_optional(node: callee_node) {
          v2.std.optional.Present { value: sym } =>
            [v2.std.compilers.lexing.symbol_lexeme(sym: sym)]
          v2.std.optional.Absent => empty_string_list
        }
      v2.std.diagnostic.Rejected { diagnostics: _ } => empty_string_list
    }
  } else {
    empty_string_list
  }
}

fn callee_collect_merge(
  left: List<String>,
  right: List<String>
) -> List<String> {
  v2.std.algebra.fold_list(
    xs: right,
    empty: left,
    cons: fn(acc, text) { maybe_snoc_callee_text(callees: acc, text: text) }
  )
}

fn callee_collect_step(
  acc: CalleeCollectState,
  _edge: v2.std.node.Edge,
  child: CalleeCollectState
) -> CalleeCollectState {
  let merged = callee_collect_merge(left: acc.callees, right: child.callees)
  let with_call = callee_collect_merge(
    left: merged,
    right: callee_text_from_call_node(node: child.node)
  )
  CalleeCollectState { node: acc.node, callees: with_call }
}

fn callee_collect_algebra() -> v2.std.node.NodeFold<CalleeCollectState> {
  v2.std.node.NodeFold { init: callee_collect_init, step: callee_collect_step }
}

fn callees_from_atom_scan(node: v2.std.node.Node) -> List<String> {
  v2.std.algebra.fold_list(
    xs: v2.lens.production_qualification_origin_probe.atom_identities_in_node(node: node),
    empty: empty_string_list,
    cons: fn(acc, sym) {
      maybe_snoc_callee_text(callees: acc, text: v2.std.compilers.lexing.symbol_lexeme(sym: sym))
    }
  )
}

fn callees_from_node(node: v2.std.node.Node) -> List<String> {
  let from_call_walk = callee_collect_merge(
    left: v2.std.node.fold_node(n: node, algebra: callee_collect_algebra()).callees,
    right: callee_text_from_call_node(node: node)
  )
  callee_collect_merge(left: from_call_walk, right: callees_from_atom_scan(node: node))
}

fn decl_contains_callee(decl: v2.std.fn_index.FnArrowDecl, callee: String) -> v2.std.logic.Bool {
  v2.std.algebra.contains(xs: v2.lens.production_qualification_origin_probe.callees_from_node(node: decl.output), item: callee, eq: v2.lens.production_qualification_origin_probe.string_eq)
}

fn decl_contains_atom(decl: v2.std.fn_index.FnArrowDecl, atom: String) -> v2.std.logic.Bool {
  node_contains_atom_text(node: decl.output, wanted: atom)
}

fn decl_has_qualifying_mint_callee(decl: v2.std.fn_index.FnArrowDecl) -> v2.std.logic.Bool {
  decl_contains_callee(decl: decl, callee: mint_written_callee)
    || decl_contains_callee(decl: decl, callee: mint_provenanced_callee)
    || decl_contains_callee(decl: decl, callee: advance_cargo_green_callee)
}

fn decl_has_source_produced_mint_callee(decl: v2.std.fn_index.FnArrowDecl) -> v2.std.logic.Bool {
  decl_contains_callee(decl: decl, callee: mint_written_callee)
    || decl_contains_callee(decl: decl, callee: mint_provenanced_callee)
}

data direct_rust_door_target_model_callee: String = "direct_rust_door_target_model"

// FixtureDerived requires the direct_rust_door_inferred_tree fixture-tree marker atom in the fn-arrow skeleton. Target-model choice (direct_rust_door_target_model) is NOT an origin proxy — mint_written + target without the fixture-tree marker classifies UnknownOrigin.
fn decl_has_fixture_marker(decl: v2.std.fn_index.FnArrowDecl) -> v2.std.logic.Bool {
  decl_contains_atom(decl: decl, atom: direct_rust_door_inferred_tree_atom)
}

fn decl_origin_from_structure(decl: v2.std.fn_index.FnArrowDecl) -> ProductionQualificationOrigin {
  if decl_has_fixture_marker(decl: decl) {
    FixtureDerived
  } else {
    UnknownOrigin
  }
}

fn derived_sites_for_decl(
  sites: List<DerivedProductionQualificationMintSiteRow>,
  decl: v2.std.fn_index.FnArrowDecl
) -> List<DerivedProductionQualificationMintSiteRow> {
  if decl_has_qualifying_mint_callee(decl: decl) {
    let origin = decl_origin_from_structure(decl: decl)
    let with_source_produced =
      if decl_has_source_produced_mint_callee(decl: decl) {
        maybe_snoc_site_row(
          sites: sites,
          qualified_name: decl.qualified_name,
          axis: v2.compiler.self_host.emitter_producer_provenance.SourceProduced,
          origin: origin
        )
      } else {
        sites
      }
    if decl_contains_callee(decl: decl, callee: advance_cargo_green_callee) {
      maybe_snoc_site_row(
        sites: with_source_produced,
        qualified_name: decl.qualified_name,
        axis: v2.compiler.self_host.emitter_producer_provenance.CargoGreen,
        origin: origin
      )
    } else {
      with_source_produced
    }
  } else {
    sites
  }
}

fn derived_production_qualification_mint_sites_from_facts(
  decls: List<v2.std.fn_index.FnArrowDecl>
) -> List<DerivedProductionQualificationMintSiteRow> {
  v2.std.algebra.fold_list(
    xs: decls,
    empty: empty_site_list,
    cons: fn(acc, decl) { derived_sites_for_decl(sites: acc, decl: decl) }
  )
}

fn derived_production_qualification_mint_sites_live() -> List<DerivedProductionQualificationMintSiteRow> {
  derived_production_qualification_mint_sites_from_facts(
    decls: v2.std.fn_index.fn_arrow_decl_facts_live()
  )
}

fn count_derived_mint_sites_with_origin(
  sites: List<DerivedProductionQualificationMintSiteRow>,
  origin: ProductionQualificationOrigin
) -> v2.std.integer.Int {
  v2.std.algebra.fold_list(
    xs: sites,
    empty: 0,
    cons: fn(count, row) {
      if production_qualification_origin_eq(left: row.evidence_origin, right: origin) {
        count + 1
      } else {
        count
      }
    }
  )
}

fn count_derived_fixture_origin_mint_sites(
  sites: List<DerivedProductionQualificationMintSiteRow>
) -> v2.std.integer.Int {
  count_derived_mint_sites_with_origin(sites: sites, origin: FixtureDerived)
}

// Closed-subject oracle (DESIGN §5): structural_red_control_planted_decl carries exactly one FixtureDerived SourceProduced row by construction — independent of fn_arrow_decl_facts_live() population.
data production_qualification_planted_fixture_origin_oracle_count: v2.std.integer.Int = 1

data production_qualification_live_scope_fixture_origin_policy_note: String = "Live-scope policy (DESIGN §5, review 48255): G2 fn-arrow marshal does not yet surface mint callees on live fixture fns in the witness entry closure, so known_fixture_origin_mint_surface_count_in_scope() reads zero today — documented expectation, NOT an executing tree-copied equality oracle. Discriminating signal is the planted closed-subject oracle (production_qualification_planted_fixture_origin_oracle_count). Frontier: witness_live_scope_fixture_origin_discoverable_in_entry_closure_reds (explicit_witness_admission) expects live FixtureDerived discovery once marshal exposes callee atoms — greens when count > 0, then row deletes and a closed-subject expected population or monotone debt contract may enroll."

fn planted_fixture_origin_mint_site_count() -> v2.std.integer.Int {
  count_derived_fixture_origin_mint_sites(
    sites: derived_sites_for_decl(
      sites: empty_site_list,
      decl: structural_red_control_planted_decl()
    )
  )
}

fn known_fixture_origin_mint_surface_count_in_scope() -> v2.std.integer.Int {
  count_derived_fixture_origin_mint_sites(
    sites: derived_production_qualification_mint_sites_live()
  )
}

fn ingest_mint_surface_discovered_in_live_scope() -> v2.std.logic.Bool {
  v2.std.algebra.any(
    xs: derived_production_qualification_mint_sites_live(),
    predicate: fn(row) {
      string_contains(s: row.qualified_name, pattern: ingest_mint_entry_name_suffix)
        && v2.compiler.self_host.emitter_producer_provenance.emission_qualification_eq(
          left: row.qualification_axis,
          right: v2.compiler.self_host.emitter_producer_provenance.SourceProduced
        )
    }
  )
}

// Production admission (not mere classification totality): refuses both UnknownOrigin and FixtureDerived discovered rows — fixture-derived production qualification is the forbidden class. discovered_origin_classification_is_total_for_decls is the weaker predicate (UnknownOrigin count zero only) for witnesses that need classification totality without production admission.
fn discovered_origin_classification_is_total_for_decls(
  decls: List<v2.std.fn_index.FnArrowDecl>
) -> v2.std.logic.Bool {
  count_derived_mint_sites_with_origin(
    sites: derived_production_qualification_mint_sites_from_facts(decls: decls),
    origin: UnknownOrigin
  ) == 0
}

fn production_qualification_origin_probe_admission_holds_for_decls(
  decls: List<v2.std.fn_index.FnArrowDecl>
) -> v2.std.logic.Bool {
  let sites = derived_production_qualification_mint_sites_from_facts(decls: decls)
  (count_derived_mint_sites_with_origin(sites: sites, origin: UnknownOrigin) == 0)
    && (count_derived_mint_sites_with_origin(sites: sites, origin: FixtureDerived) == 0)
}

fn probe_mint_callee_atom_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: v2.std.compilers.lexing.symbol_intern_lexeme(lexeme: mint_written_callee) } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn unknown_origin_red_control_planted_decl() -> v2.std.fn_index.FnArrowDecl {
  v2.std.fn_index.FnArrowDecl {
    qualified_name: "synthetic.production_qualification_origin_probe.unknown_origin_red_control",
    name: "unknown_origin_red_control_planted_decl",
    output: v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: Conj },
      children: [
        v2.std.node.Edge { label: v2.std.node.Positional, target: probe_mint_callee_atom_node() }
      ],
      occurrence_id: v2.std.node.SyntheticOccurrence
    },
    params: []
  }
}

data structural_red_control_planted_qualified_name: String = "synthetic.production_qualification_origin_probe.structural_red_control_planted"

