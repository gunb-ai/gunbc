fn structural_red_control_live_fixture_mint_site_discovered(
  live_qualified_name: String
) -> v2.std.logic.Bool {
  v2.std.algebra.any(
    xs: derived_production_qualification_mint_sites_live(),
    predicate: fn(row) {
      v2.lens.production_qualification_origin_probe.string_eq(a: row.qualified_name, b: live_qualified_name)
        && production_qualification_origin_eq(
          left: row.evidence_origin,
          right: FixtureDerived
        )
        && v2.compiler.self_host.emitter_producer_provenance.emission_qualification_eq(
          left: row.qualification_axis,
          right: v2.compiler.self_host.emitter_producer_provenance.SourceProduced
        )
    }
  )
}

fn production_qualification_origin_probe_admission_holds() -> v2.std.logic.Bool {
  production_qualification_origin_probe_admission_holds_for_decls(
    decls: v2.std.fn_index.fn_arrow_decl_facts_live()
  )
}
