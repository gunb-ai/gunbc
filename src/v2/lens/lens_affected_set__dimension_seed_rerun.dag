// Observation: ReExecFrontier.decisions is a std Map = PartialFunction with no decidable
// structural `==`; the receipt observes the frontier by application (frontier_decision_matches)
// and compares the resolved FrontierDecision, never whole-frontier `==`.

module v2.test.lens_affected_set.dimension_seed_rerun

import v2.lens.affected_set {
  DimensionNotRead,
  Excluded,
  ExclusionKey,
  FrontierDecision,
  Rerun,
  empty_frontier,
  mark_rerun
}
import v2.lens.affected_set_examples {
  affected_set_example_node
}
import v2.test.lens_affected_set.frontier_observation { frontier_decision_matches }
import v2.std.logic { Bool }
import v2.std.node { Conj, Node, TypeNode, SyntheticOccurrence }
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}

data dimension_seed_rerun_key: ExclusionKey = ExclusionKey {
  at: affected_set_example_node,
  dimension: ^affected_set_example_dimension
}

data expected_dimension_seed_decision: FrontierDecision = Rerun

fn dimension_seed_rerun_claim_holds() -> Bool {
  frontier_decision_matches(
    frontier: mark_rerun(frontier: empty_frontier(), key: dimension_seed_rerun_key),
    key: dimension_seed_rerun_key,
    expected: expected_dimension_seed_decision
  )
}

// Discrimination receipt (perturb-red, committed): the seeded decision is Rerun, which
// must NOT match a wrong Excluded decision. Holds == true proves the comparison
// discriminates on the FrontierDecision arm, not a tautology that ignores it.
data dimension_seed_wrong_decision: FrontierDecision = Excluded {
  first: DimensionNotRead {
    usage_site: affected_set_example_node,
    changed_dimension: ^affected_set_example_dimension
  },
  rest: []
}

fn dimension_seed_rerun_discriminates() -> Bool {
  frontier_decision_matches(
    frontier: mark_rerun(frontier: empty_frontier(), key: dimension_seed_rerun_key),
    key: dimension_seed_rerun_key,
    expected: dimension_seed_wrong_decision
  ) == false
}

fn dimension_seed_rerun_claim_rhs() -> Node {
  if dimension_seed_rerun_claim_holds() {
    affected_set_example_node
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_dimension_seed_rerun: TestClaim = EqualsClaim {
  label: "lens_affected_set/dimension_seed_rerun: dimension change seeds Rerun",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: affected_set_example_node,
  rhs: dimension_seed_rerun_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
