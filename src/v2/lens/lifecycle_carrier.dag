module v2.lens.lifecycle_carrier


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

// Membership is DECIDABLE -- a field's name and declared type are both readable
// off the v2.std.node.Node tree -- so this is not RatchetForever. It is not a wall today
// because the substrate has no way to mandate that a field with a given name
// carry a given carrier type; the field stays writable and this gate is what
// refuses it. It dissolves into SubstrateMandatoryTag when that capability
// exists, at which point the raw form has no constructor and the gate deletes.
data construction_justification: v2.lens.common.construction_justification.ConstructionJustification = v2.lens.common.construction_justification.ConstructionJustification {
  class: v2.lens.common.construction_justification.WallAfterGrounding { dissolves_to: SubstrateMandatoryTag }
}

// The field-name class this wall holds at zero. These are the spellings the
// authored corpus actually used for "the code change that retires this carve-out"
// before std.dissolution existed; a new spelling is a new row here, not a silent
// escape. Scope is deliberately the FIELD/PARAM class only -- a top-level
// `data x_dissolution_trigger: String = "..."` prose declaration is a different
// population (DESIGN 4c modeling debt) and is not a record field, so it is
// structurally outside this predicate rather than exempted by it.
data lifecycle_field_name_rows: List<v2.std.node.Symbol> = [
  ^dissolve_on,
  ^dissolves_on,
  ^dissolves_when,
  ^dissolve_trigger,
  ^dissolution_trigger,
  ^retirement_trigger,
  ^retire_on,
  ^retires_when
]

// Membership over eight rows, as a fold rather than a Map. A Map would have to
// be BUILT on every call -- this predicate sits under the compile door and is
// reached per field edge corpus-wide -- so the map's O(1) lookup is bought with
// eight inserts per query and is a pure loss at this size (DESIGN 6, bare
// minimum cost: a proven cost-shape defect is fixed regardless of realized n).
fn name_is_lifecycle_field(name: v2.std.node.Symbol) -> v2.std.logic.Bool {
  fold(lifecycle_field_name_rows, init: false, f: fn(acc, nm) {
    acc || (nm == name)
  })
}

// The same eight spellings decide the top-level DECLARATION class, so this roster stays the
// single naming authority across both grains (DESIGN section 3). The grains differ only in
// match SHAPE, not in vocabulary: a record field is named exactly `dissolve_on`, while a
// top-level declaration qualifies its subject and carries the spelling as a suffix
// (`pin_refresh_window_positivity_note_dissolve_on`). A second roster spelled for
// declarations would be precisely the nickname the field predicate above exists to prevent,
// and it would drift silently -- a new spelling would have to be remembered twice.
fn decl_name_is_lifecycle_carrier(name: String) -> v2.std.logic.Bool {
  fold(lifecycle_field_name_rows, init: false, f: fn(acc, nm) {
    let spelling = symbol_lexeme(sym: nm)
    acc || (name == spelling) || ends_with(s: name, suffix: concat("_", spelling))
  })
}

fn type_is_bare_string(target: v2.std.node.Node) -> v2.std.logic.Bool {
  let nm = edge_field_type_name(target: target)
  (nm == ^String) || (nm == ^NonEmptyStr)
}

fn lifecycle_carrier_diagnostic(carrier: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^lifecycle_carrier_raw_prose_field,
    at: node_locus(node: carrier),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

// Type first, name second -- the same ordering unit_modeling_gate uses, and for
// the same reason: the type test is a single symbol comparison on a node already
// in hand, while the name test walks the row list. Only String and NonEmptyStr
// fields ever reach the walk.
fn field_lifecycle_violation(carrier: v2.std.node.Node, edge: v2.std.node.Edge) -> v2.std.optional.Optional<v2.std.diagnostic.Diagnostic> {
  match edge.label {
    v2.std.node.Named { name: nm } =>
      if type_is_bare_string(target: edge.target) && name_is_lifecycle_field(name: nm) {
        optional_present(value: lifecycle_carrier_diagnostic(carrier: carrier))
      } else {
        optional_absent()
      }
    Positional => optional_absent()
  }
}

fn carrier_first_lifecycle_violation(carrier: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.diagnostic.Diagnostic> {
  match carrier.kind {
    TypeNode { connective: _ } =>
      fold(carrier.children, init: optional_absent(), f: fn(acc, edge) {
        optional_prefer_first_present(left: acc, right: field_lifecycle_violation(carrier: carrier, edge: edge))
      })
    ComputationNode { behavior: _ } => v2.std.optional.Absent
  }
}

// v2.std.node.Node-local, same grain as unit_modeling_gate: reads only the node's direct
// children so it does not stack with run_required_lens_gates_on_subtree's
// fold_node into O(n^2).
fn lifecycle_carrier_gate(node: v2.std.node.Node) -> Outcome<Witness<v2.std.node.Node>> {
  match carrier_first_lifecycle_violation(carrier: node) {
    v2.std.optional.Present { value: d } => outcome_rejected(d)
    v2.std.optional.Absent => outcome_accepted(value: v2.std.witness.Holds { value: node })
  }
}
