module v2.lens.wiring_liveness


type WiringRelation {
  output: v2.std.node.Node
  declared_input: v2.std.node.Node
  dependence: List<v2.std.dependency.DependencyView>
}

fn wiring_reaches(dependence: List<v2.std.dependency.DependencyView>, from: v2.std.node.Node, to: v2.std.node.Node) -> v2.std.logic.Bool {
  graph_reaches(dependence: dependence, from: from, to: to)
}

fn wiring_relation_projection(relation: WiringRelation) -> v2.lens.common.graph_invariant.GraphReachProjection {
  v2.lens.common.graph_invariant.GraphReachProjection {
    edges: relation.dependence,
    roots: [relation.output]
  }
}

fn wiring_relation_verdict(relation: WiringRelation) -> v2.std.lens_verdict.LensVerdict {
  graph_invariant_reach_verdict(
    reason: ^wiring_liveness_dead_wire,
    root: relation.output,
    unreachable: relation.declared_input,
    projection: wiring_relation_projection(relation: relation)
  )
}

fn wiring_relation_is_wired(relation: WiringRelation) -> v2.std.logic.Bool {
  match wiring_relation_verdict(relation: relation) {
    Holds => true
    _ => false
  }
}

fn wiring_relation_from_tree(output: v2.std.node.Node, declared_input: v2.std.node.Node) -> WiringRelation {
  WiringRelation {
    output: output,
    declared_input: declared_input,
    dependence: dependency_lens(root: output)
  }
}

fn wiring_input_is_wired(output: v2.std.node.Node, declared_input: v2.std.node.Node) -> v2.std.logic.Bool {
  wiring_relation_is_wired(
    relation: wiring_relation_from_tree(output: output, declared_input: declared_input)
  )
}


type WiringDeadWire {
  fn_qualified_name: String
  param: v2.std.node.Symbol
}

fn wiring_output_reachable_nodes(output: v2.std.node.Node) -> List<v2.std.node.Node> {
  ready_set(graph_node: output)
}

fn wiring_param_reaches_output(reachable: List<v2.std.node.Node>, declared_input: v2.std.node.Node) -> v2.std.logic.Bool {
  graph_reach_contains(reached: reachable, n: declared_input)
}

fn wiring_param_is_dead_wire(reachable: List<v2.std.node.Node>, declared_input: v2.std.node.Node) -> v2.std.logic.Bool {
  std.perturbation.perturbation_is_violation(
    reading: std.perturbation.BackwardDiffInDiffOut,
    output_responded: wiring_param_reaches_output(reachable: reachable, declared_input: declared_input)
  )
}

fn wiring_param_violation_verdict(relation: WiringRelation, reachable: List<v2.std.node.Node>) -> v2.std.lens_verdict.LensVerdict {
  if wiring_param_is_dead_wire(
    reachable: reachable,
    declared_input: relation.declared_input
  ) {
    wiring_relation_verdict(relation: relation)
  } else {
    Holds
  }
}

fn wiring_fn_dead_wires(decl: v2.std.fn_index.FnArrowDecl) -> List<WiringDeadWire> {
  let reachable = wiring_output_reachable_nodes(output: decl.output)
  let dependence = dependency_lens(root: decl.output)
  fold(decl.params, init: [], f: fn(acc, p) {
    match wiring_param_violation_verdict(
      relation: WiringRelation {
        output: decl.output,
        declared_input: p.node,
        dependence: dependence
      },
      reachable: reachable
    ) {
      Violation { diagnostic: _ } =>
        list_snoc_item(
          xs: acc,
          item: WiringDeadWire { fn_qualified_name: decl.qualified_name, param: p.name }
        )
      _ => acc
    }
  })
}

fn wiring_dead_wires_over(decls: List<v2.std.fn_index.FnArrowDecl>) -> List<WiringDeadWire> {
  fold(decls, init: [], f: fn(acc, decl) {
    list_append(left: acc, right: wiring_fn_dead_wires(decl: decl))
  })
}

fn wiring_decl_verdict(decl: v2.std.fn_index.FnArrowDecl) -> v2.std.lens_verdict.LensVerdict {
  let reachable = wiring_output_reachable_nodes(output: decl.output)
  let dependence = dependency_lens(root: decl.output)
  fold(decl.params, init: Holds, f: fn(acc, p) {
    match acc {
      Violation { diagnostic: _ } => acc
      _ =>
        wiring_param_violation_verdict(
          relation: WiringRelation {
            output: decl.output,
            declared_input: p.node,
            dependence: dependence
          },
          reachable: reachable
        )
    }
  })
}

fn wiring_liveness_corpus_verdict() -> v2.std.lens_verdict.LensVerdict {
  fold(fn_arrow_decl_facts_live(), init: Holds, f: fn(acc, decl) {
    match acc {
      Violation { diagnostic: _ } => acc
      _ => wiring_decl_verdict(decl: decl)
    }
  })
}

fn wiring_liveness_corpus_dead_wires() -> List<WiringDeadWire> {
  wiring_dead_wires_over(decls: fn_arrow_decl_facts_live())
}

fn wiring_liveness_corpus_dead_wire_count() -> Int {
  length(xs: wiring_liveness_corpus_dead_wires())
}

fn wiring_liveness_corpus_is_clean() -> v2.std.logic.Bool {
  match wiring_liveness_corpus_verdict() {
    Holds => true
    _ => false
  }
}

data construction_justification: v2.lens.common.construction_justification.ConstructionJustification = v2.lens.common.construction_justification.ConstructionJustification {
  class: v2.lens.common.construction_justification.WallAfterGrounding { dissolves_to: RealizationDispatch }
}
