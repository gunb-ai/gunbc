module v2.lens.wiring_liveness

import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }
import std.disposition { RealizationDispatch }
import std.perturbation { BackwardDiffInDiffOut, perturbation_consistent, perturbation_is_violation }
import v2.std.algebra { contains, length, list_append, list_snoc_item }
import v2.std.collection { List }
import v2.std.dependency { DependencyView, dependency_lens, ready_set }
import v2.std.fn_index { FnArrowDecl, FnArrowParam, fn_arrow_decl_facts_live }
import v2.std.logic { Bool }
import v2.std.node { Node, Symbol }
import v2.std.text { String }

type WiringRelation {
  output: Node
  declared_input: Node
  dependence: List<DependencyView>
}

type WiringReachState {
  reached: List<Node>
  stable: Bool
}

fn wiring_node_eq(a: Node, b: Node) -> Bool {
  a == b
}

fn wiring_reach_contains(reached: List<Node>, n: Node) -> Bool {
  contains(xs: reached, item: n, eq: fn(a, b) { wiring_node_eq(a: a, b: b) })
}

fn wiring_reach_step(reached: List<Node>, dep: DependencyView) -> List<Node> {
  if wiring_reach_contains(reached: reached, n: dep.source) && (wiring_reach_contains(reached: reached, n: dep.dependent) == false) {
    list_snoc_item(xs: reached, item: dep.dependent)
  } else {
    reached
  }
}

fn wiring_reach_pass(dependence: List<DependencyView>, reached: List<Node>) -> List<Node> {
  fold(dependence, init: reached, f: fn(acc, dep) {
    wiring_reach_step(reached: acc, dep: dep)
  })
}

fn wiring_reach_fixpoint_step(dependence: List<DependencyView>, state: WiringReachState) -> WiringReachState {
  if state.stable {
    state
  } else {
    let next = wiring_reach_pass(dependence: dependence, reached: state.reached)
    WiringReachState {
      reached: next,
      stable: length(xs: next) == length(xs: state.reached)
    }
  }
}

fn wiring_reach_saturate(dependence: List<DependencyView>, reached: List<Node>) -> List<Node> {
  fold(
    dependence,
    init: WiringReachState { reached: reached, stable: false },
    f: fn(acc, ignored) {
      wiring_reach_fixpoint_step(dependence: dependence, state: acc)
    }
  ).reached
}

fn wiring_reaches(dependence: List<DependencyView>, from: Node, to: Node) -> Bool {
  wiring_reach_contains(
    reached: wiring_reach_saturate(dependence: dependence, reached: [from]),
    n: to
  )
}

fn wiring_relation_is_wired(relation: WiringRelation) -> Bool {
  perturbation_consistent(
    reading: BackwardDiffInDiffOut,
    output_responded: wiring_reaches(
      dependence: relation.dependence,
      from: relation.output,
      to: relation.declared_input
    )
  )
}

fn wiring_relation_from_tree(output: Node, declared_input: Node) -> WiringRelation {
  WiringRelation {
    output: output,
    declared_input: declared_input,
    dependence: dependency_lens(root: output)
  }
}

fn wiring_input_is_wired(output: Node, declared_input: Node) -> Bool {
  wiring_relation_is_wired(
    relation: wiring_relation_from_tree(output: output, declared_input: declared_input)
  )
}


type WiringDeadWire {
  fn_qualified_name: String
  param: Symbol
}

fn wiring_output_reachable_nodes(output: Node) -> List<Node> {
  ready_set(graph_node: output)
}

fn wiring_param_reaches_output(reachable: List<Node>, declared_input: Node) -> Bool {
  wiring_reach_contains(reached: reachable, n: declared_input)
}

fn wiring_param_is_dead_wire(reachable: List<Node>, declared_input: Node) -> Bool {
  perturbation_is_violation(
    reading: BackwardDiffInDiffOut,
    output_responded: wiring_param_reaches_output(reachable: reachable, declared_input: declared_input)
  )
}

fn wiring_fn_dead_wires(decl: FnArrowDecl) -> List<WiringDeadWire> {
  let reachable = wiring_output_reachable_nodes(output: decl.output)
  fold(decl.params, init: [], f: fn(acc, p) {
    if wiring_param_is_dead_wire(reachable: reachable, declared_input: p.node) {
      list_snoc_item(
        xs: acc,
        item: WiringDeadWire { fn_qualified_name: decl.qualified_name, param: p.name }
      )
    } else {
      acc
    }
  })
}

fn wiring_dead_wires_over(decls: List<FnArrowDecl>) -> List<WiringDeadWire> {
  fold(decls, init: [], f: fn(acc, decl) {
    list_append(left: acc, right: wiring_fn_dead_wires(decl: decl))
  })
}

fn wiring_liveness_corpus_dead_wires() -> List<WiringDeadWire> {
  wiring_dead_wires_over(decls: fn_arrow_decl_facts_live())
}

fn wiring_liveness_corpus_dead_wire_count() -> Int {
  length(xs: wiring_liveness_corpus_dead_wires())
}

fn wiring_liveness_corpus_is_clean() -> Bool {
  wiring_liveness_corpus_dead_wire_count() == 0
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: RealizationDispatch }
}
