module v2.test.lens_complexity_r1_accumulator_copy.green_cons_prepend

import v2.lens.complexity_r1_accumulator_copy {
  complexity_r1_is_clean,
  r1_fold_step_subject
}
import v2.std.algebra { combiner_cons_prepend }
import v2.std.logic { Bool }
import v2.std.node { Conj, Node, SyntheticOccurrence, Symbol, TypeNode }
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}

data r1_prepend_acc: Symbol = ^r1_prepend_acc
data r1_prepend_head: Symbol = ^r1_prepend_head
data r1_prepend_unused: Symbol = ^r1_prepend_unused

data green_cons_prepend_input: Node = r1_fold_step_subject(
  acc_binder: r1_prepend_acc,
  combiner: combiner_cons_prepend,
  port0_arg: r1_prepend_head,
  port1_arg: r1_prepend_acc
)

fn green_cons_prepend_claim_holds() -> Bool {
  complexity_r1_is_clean(n: green_cons_prepend_input)
}

fn green_cons_prepend_claim_rhs() -> Node {
  if green_cons_prepend_claim_holds() {
    green_cons_prepend_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
    }
  }
}

data claim_green_cons_prepend: TestClaim = EqualsClaim {
  label: "lens_complexity_r1/green_cons_prepend: Cons { head, tail: acc } fold step is not R1",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: green_cons_prepend_input,
  rhs: green_cons_prepend_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
