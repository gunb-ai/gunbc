module v2.test.lens_complexity_r1_accumulator_copy.green_merge_envs_base_acc

import v2.lens.complexity_r1_accumulator_copy {
  R1Clean,
  r1_fold_step_subject,
  r1_judge_fold_step
}
import v2.std.logic { Bool }
import v2.std.node { Conj, Node, SyntheticOccurrence, Symbol, TypeNode }
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}

data r1_merge_acc: Symbol = ^r1_merge_acc
data r1_merge_chunk: Symbol = ^r1_merge_chunk

data green_merge_envs_base_acc_input: Node = r1_fold_step_subject(
  acc_binder: r1_merge_acc,
  combiner: ^map_merge,
  port0_arg: r1_merge_acc,
  port1_arg: r1_merge_chunk
)

fn green_merge_envs_base_acc_claim_holds() -> Bool {
  match r1_judge_fold_step(n: green_merge_envs_base_acc_input) {
    R1Clean { flow_opaque_count: 0 } => true
    _ => false
  }
}

fn green_merge_envs_base_acc_claim_rhs() -> Node {
  if green_merge_envs_base_acc_claim_holds() {
    green_merge_envs_base_acc_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
    }
  }
}

data claim_green_merge_envs_base_acc: TestClaim = EqualsClaim {
  label: "lens_complexity_r1/green_merge_envs_base_acc: merge_envs live shape (acc in map_merge base port, src/v1/04_env.dag:226-228) is not R1",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: green_merge_envs_base_acc_input,
  rhs: green_merge_envs_base_acc_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
