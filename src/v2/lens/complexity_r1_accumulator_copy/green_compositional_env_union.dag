module v2.test.lens_complexity_r1_accumulator_copy.green_compositional_env_union

import v2.lens.complexity_r1_accumulator_copy {
  complexity_r1_is_clean,
  r1_fold_step_subject
}
import v2.std.algebra { combiner_map_merge }
import v2.std.logic { Bool }
import v2.std.node { Conj, Node, SyntheticOccurrence, Symbol, TypeNode }
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}

data r1_union_acc: Symbol = ^r1_union_acc
data r1_union_delta: Symbol = ^r1_union_delta

data green_compositional_env_union_input: Node = r1_fold_step_subject(
  acc_binder: r1_union_acc,
  combiner: combiner_map_merge,
  port0_arg: r1_union_delta,
  port1_arg: r1_union_acc
)

fn green_compositional_env_union_claim_holds() -> Bool {
  complexity_r1_is_clean(n: green_compositional_env_union_input)
}

fn green_compositional_env_union_claim_rhs() -> Node {
  if green_compositional_env_union_claim_holds() {
    green_compositional_env_union_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
    }
  }
}

data claim_green_compositional_env_union: TestClaim = EqualsClaim {
  label: "lens_complexity_r1/green_compositional_env_union: #6155 compositional union (small delta base, acc overlay) is not R1",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: green_compositional_env_union_input,
  rhs: green_compositional_env_union_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
