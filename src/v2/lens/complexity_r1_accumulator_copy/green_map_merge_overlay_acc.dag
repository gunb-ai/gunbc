module v2.test.lens_complexity_r1_accumulator_copy.green_map_merge_overlay_acc

import v2.lens.complexity_r1_accumulator_copy {
  complexity_r1_is_clean,
  r1_fold_step_subject
}
import v2.std.algebra { combiner_map_merge }
import v2.std.logic { Bool }
import v2.std.node { Conj, Node, SyntheticOccurrence, Symbol, TypeNode }
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}

data r1_green_acc: Symbol = ^r1_green_acc
data r1_green_chunk: Symbol = ^r1_green_chunk

data green_map_merge_overlay_acc_input: Node = r1_fold_step_subject(
  acc_binder: r1_green_acc,
  combiner: combiner_map_merge,
  port0_arg: r1_green_chunk,
  port1_arg: r1_green_acc
)

fn green_map_merge_overlay_acc_claim_holds() -> Bool {
  complexity_r1_is_clean(n: green_map_merge_overlay_acc_input)
}

fn green_map_merge_overlay_acc_claim_rhs() -> Node {
  if green_map_merge_overlay_acc_claim_holds() {
    green_map_merge_overlay_acc_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
    }
  }
}

data claim_green_map_merge_overlay_acc: TestClaim = EqualsClaim {
  label: "lens_complexity_r1/green_map_merge_overlay_acc: flatten_visible_bindings parent-fold shape (acc in map_merge overlay port)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: green_map_merge_overlay_acc_input,
  rhs: green_map_merge_overlay_acc_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
