module v2.test.lens_complexity_r1_accumulator_copy.red_map_merge_overlay_acc

import v2.lens.complexity_r1_accumulator_copy {
  R1PolyTwoSuspect,
  r1_fold_step_subject,
  r1_judge_fold_step
}
import v2.std.logic { Bool }
import v2.std.node { Conj, Node, SyntheticOccurrence, Symbol, TypeNode }
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}

data r1_red_acc: Symbol = ^r1_red_acc
data r1_red_chunk: Symbol = ^r1_red_chunk

data red_map_merge_overlay_acc_input: Node = r1_fold_step_subject(
  acc_binder: r1_red_acc,
  combiner: ^map_merge,
  port0_arg: r1_red_chunk,
  port1_arg: r1_red_acc
)

fn red_map_merge_overlay_acc_claim_holds() -> Bool {
  match r1_judge_fold_step(n: red_map_merge_overlay_acc_input) {
    R1PolyTwoSuspect { implied_cost: _, flow_opaque_count: _ } => true
    _ => false
  }
}

fn red_map_merge_overlay_acc_claim_rhs() -> Node {
  if red_map_merge_overlay_acc_claim_holds() {
    red_map_merge_overlay_acc_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
    }
  }
}

data claim_red_map_merge_overlay_acc: TestClaim = EqualsClaim {
  label: "lens_complexity_r1/red_map_merge_overlay_acc: acc in map_merge overlay port (v1_rt.rs:360 copied-port) fires Poly(2)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: red_map_merge_overlay_acc_input,
  rhs: red_map_merge_overlay_acc_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
