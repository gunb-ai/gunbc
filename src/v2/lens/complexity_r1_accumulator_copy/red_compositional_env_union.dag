module v2.test.lens_complexity_r1_accumulator_copy.red_compositional_env_union

import v2.lens.complexity_r1_accumulator_copy {
  R1PolyTwoSuspect,
  r1_fold_step_subject,
  r1_judge_fold_step
}
import v2.std.logic { Bool }
import v2.std.node { Conj, Node, SyntheticOccurrence, Symbol, TypeNode }
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}

data r1_union_acc: Symbol = ^r1_union_acc
data r1_union_delta: Symbol = ^r1_union_delta

data red_compositional_env_union_input: Node = r1_fold_step_subject(
  acc_binder: r1_union_acc,
  combiner: ^map_merge,
  port0_arg: r1_union_delta,
  port1_arg: r1_union_acc
)

fn red_compositional_env_union_claim_holds() -> Bool {
  match r1_judge_fold_step(n: red_compositional_env_union_input) {
    R1PolyTwoSuspect { implied_cost: _, flow_opaque_count: _ } => true
    _ => false
  }
}

fn red_compositional_env_union_claim_rhs() -> Node {
  if red_compositional_env_union_claim_holds() {
    red_compositional_env_union_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
    }
  }
}

data claim_red_compositional_env_union: TestClaim = EqualsClaim {
  label: "lens_complexity_r1/red_compositional_env_union: small-delta base + acc overlay still hits map_merge overlay copied-port",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: red_compositional_env_union_input,
  rhs: red_compositional_env_union_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
