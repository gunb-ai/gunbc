module v2.test.lens_complexity_r1_accumulator_copy.red_merge_envs_base_acc

import v2.lens.complexity_r1_accumulator_copy {
  complexity_r1_is_poly_two_suspect,
  r1_fold_step_subject
}
import v2.std.algebra { combiner_map_merge }
import v2.std.logic { Bool }
import v2.std.node { Conj, Node, SyntheticOccurrence, Symbol, TypeNode }
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}

data r1_merge_acc: Symbol = ^r1_merge_acc
data r1_merge_chunk: Symbol = ^r1_merge_chunk

data red_merge_envs_base_acc_input: Node = r1_fold_step_subject(
  acc_binder: r1_merge_acc,
  combiner: combiner_map_merge,
  port0_arg: r1_merge_acc,
  port1_arg: r1_merge_chunk
)

fn red_merge_envs_base_acc_claim_holds() -> Bool {
  complexity_r1_is_poly_two_suspect(n: red_merge_envs_base_acc_input)
}

fn red_merge_envs_base_acc_claim_rhs() -> Node {
  if red_merge_envs_base_acc_claim_holds() {
    red_merge_envs_base_acc_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
    }
  }
}

data claim_red_merge_envs_base_acc: TestClaim = EqualsClaim {
  label: "lens_complexity_r1/red_merge_envs_base_acc: merge_envs pre-fix shape (acc in map_merge base port) fires Poly(2)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: red_merge_envs_base_acc_input,
  rhs: red_merge_envs_base_acc_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
