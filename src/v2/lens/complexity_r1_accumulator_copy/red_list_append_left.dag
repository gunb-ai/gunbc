module v2.test.lens_complexity_r1_accumulator_copy.red_list_append_left

import v2.lens.complexity_r1_accumulator_copy {
  complexity_r1_is_poly_two_suspect,
  r1_fold_step_subject
}
import v2.std.algebra { combiner_list_append }
import v2.std.logic { Bool }
import v2.std.node { Conj, Node, SyntheticOccurrence, Symbol, TypeNode }
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}

data r1_red_acc: Symbol = ^r1_red_acc
data r1_red_item: Symbol = ^r1_red_item

data red_list_append_left_input: Node = r1_fold_step_subject(
  acc_binder: r1_red_acc,
  combiner: combiner_list_append,
  port0_arg: r1_red_acc,
  port1_arg: r1_red_item
)

fn red_list_append_left_claim_holds() -> Bool {
  complexity_r1_is_poly_two_suspect(n: red_list_append_left_input)
}

fn red_list_append_left_claim_rhs() -> Node {
  if red_list_append_left_claim_holds() {
    red_list_append_left_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
    }
  }
}

data claim_red_list_append_left: TestClaim = EqualsClaim {
  label: "lens_complexity_r1/red_list_append_left: glob_discovery_law.dag:63 shape (list_append left:acc) projects Poly(2)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: red_list_append_left_input,
  rhs: red_list_append_left_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
