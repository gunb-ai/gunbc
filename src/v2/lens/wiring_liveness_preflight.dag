module v2.lens.wiring_liveness_preflight


type FrontierWiringObligation {
  output: v2.std.node.Node
  declared_input: v2.std.node.Node
}

fn frontier_slice_dependence(dependencies: List<v2.lens.affected_set.FrontierDependency>) -> List<v2.std.dependency.DependencyView> {
  fold(dependencies, init: [], f: fn(acc, fd) {
    list_snoc_item(xs: acc, item: fd.dependency)
  })
}

fn obligation_projection(
  dependence: List<v2.std.dependency.DependencyView>,
  obligation: FrontierWiringObligation
) -> v2.lens.common.graph_invariant.GraphReachProjection {
  v2.lens.common.graph_invariant.GraphReachProjection {
    edges: dependence,
    roots: [obligation.output]
  }
}

fn obligation_is_wired(dependence: List<v2.std.dependency.DependencyView>, obligation: FrontierWiringObligation) -> v2.std.logic.Bool {
  std.perturbation.perturbation_consistent(
    reading: std.perturbation.BackwardDiffInDiffOut,
    output_responded: graph_invariant_reaches(
      projection: obligation_projection(dependence: dependence, obligation: obligation),
      target: obligation.declared_input
    )
  )
}

fn first_dead_wire(
  dependence: List<v2.std.dependency.DependencyView>,
  obligations: List<FrontierWiringObligation>
) -> v2.std.optional.Optional<FrontierWiringObligation> {
  fold(obligations, init: optional_absent(), f: fn(acc, obligation) {
    match acc {
      v2.std.optional.Present { value: v } => optional_present(value: v)
      v2.std.optional.Absent =>
        if obligation_is_wired(dependence: dependence, obligation: obligation) {
          optional_absent()
        } else {
          optional_present(value: obligation)
        }
    }
  })
}

fn dead_wire_reason(obligation: FrontierWiringObligation, dependence: List<v2.std.dependency.DependencyView>) -> v2.lens.affected_set.FailClosedReason {
  v2.lens.affected_set.ReasonDiagnostics {
    diagnostics: diagnostics_singleton(
      d: graph_reach_unreachable_diagnostic(
        reason: ^wiring_liveness_dead_wire,
        root: obligation.output,
        unreachable: obligation.declared_input,
        projection: obligation_projection(dependence: dependence, obligation: obligation)
      )
    )
  }
}

fn preflight_reexec_frontier(
  frontier: v2.lens.affected_set.ReExecFrontier,
  dependencies: List<v2.lens.affected_set.FrontierDependency>,
  obligations: List<FrontierWiringObligation>
) -> v2.lens.affected_set.ReExecFrontier {
  let dependence = frontier_slice_dependence(dependencies: dependencies)
  match frontier {
    v2.lens.affected_set.FailClosed { reason: reason } => v2.lens.affected_set.FailClosed { reason: reason }
    ChangedSubgraphFrontier { boundary_exclusions: _, decisions: _ } =>
      match first_dead_wire(dependence: dependence, obligations: obligations) {
        v2.std.optional.Absent => frontier
        v2.std.optional.Present { value: dead } =>
          v2.lens.affected_set.FailClosed { reason: dead_wire_reason(obligation: dead, dependence: dependence) }
      }
  }
}

data construction_justification: v2.lens.common.construction_justification.ConstructionJustification = v2.lens.common.construction_justification.ConstructionJustification {
  class: v2.lens.common.construction_justification.WallAfterGrounding { dissolves_to: RealizationDispatch }
}
