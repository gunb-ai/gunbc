module v2.lens.wiring_liveness_preflight

import v2.lens.affected_set {
  ChangedSubgraphFrontier,
  FailClosed,
  FailClosedReason,
  FrontierDependency,
  ReExecFrontier,
  ReasonDiagnostics
}
import v2.lens.wiring_liveness { wiring_reaches }
import v2.std.collection { Absent, List, Optional, Present }
import v2.std.algebra { list_snoc_item }
import v2.std.dependency { DependencyView }
import v2.std.diagnostic {
  Correction,
  Diagnostic,
  ExternalContractUnknown,
  NonEmptyDiagnostics,
  Unavailable,
  diagnostics_singleton,
  node_locus
}
import v2.std.logic { Bool }
import v2.std.node { Node, Symbol }

// A wiring obligation the about-to-run slice must satisfy: a declared input must
// reach the output it is declared to feed. This is the (output, declared_input)
// pair WITHOUT its own dependence graph -- the preflight checks it against the
// slice's *realized* wiring (the frontier), not against a re-derived static tree.
// (WiringRelation in v2.lens.wiring_liveness bundles its own dependence and is the
// compile-time-lens carrier; the obligation deliberately omits it so the frontier
// is the single source of the dependence graph here -- §3, one authority for the
// runtime wiring.)
type FrontierWiringObligation {
  output: Node
  declared_input: Node
}

// The realized wiring graph of the about-to-run slice: project each
// FrontierDependency to its DependencyView. The frontier IS the dependence carrier
// -- this is the affected-set frontier's first paying consumer (§3, no new dep type).
fn frontier_slice_dependence(dependencies: List<FrontierDependency>) -> List<DependencyView> {
  fold(dependencies, init: [], f: fn(acc, fd) {
    list_snoc_item(xs: acc, item: fd.dependency)
  })
}

// One obligation is live iff its declared input reaches the output over the slice's
// realized wiring. Reuses wiring_reaches (the cache-purity reachability kernel read
// backwards) -- NOT wiring_input_is_wired, which would re-derive the graph from the
// static output tree instead of the about-to-run slice.
fn obligation_is_wired(dependence: List<DependencyView>, obligation: FrontierWiringObligation) -> Bool {
  wiring_reaches(
    dependence: dependence,
    from: obligation.output,
    to: obligation.declared_input
  )
}

// The first dead wire in the slice, if any -- the obligation whose declared input has
// no path to its output over the slice's realized wiring. Fail-closed locates the
// FIRST one (deterministic), rather than collapsing to a bare boolean.
fn first_dead_wire(
  dependence: List<DependencyView>,
  obligations: List<FrontierWiringObligation>
) -> Optional<FrontierWiringObligation> {
  fold(obligations, init: Absent, f: fn(acc, obligation) {
    match acc {
      Present { value: v } => Present { value: v }
      Absent =>
        if obligation_is_wired(dependence: dependence, obligation: obligation) {
          Absent
        } else {
          Present { value: obligation }
        }
    }
  })
}

// A dead wire becomes a typed, located, pre-execution diagnostic anchored at the
// declared input that reaches nothing (§5: loud error, never a silent skip, never a
// fabricated plausible output). The correction is Unavailable/ExternalContractUnknown
// because the missing wire lives in an opaque (Rust-seed) realization the compile-time
// lens cannot see into -- exactly the residue this preflight exists to catch.
fn dead_wire_reason(obligation: FrontierWiringObligation) -> FailClosedReason {
  ReasonDiagnostics {
    diagnostics: diagnostics_singleton(d: Diagnostic {
      reason: ^wiring_liveness_dead_wire,
      at: node_locus(node: obligation.declared_input),
      correction: Unavailable { reason: ExternalContractUnknown }
    })
  }
}

// THE PREFLIGHT. Run the wiring-liveness check over the affected-set ReExecFrontier
// (the about-to-run slice) BEFORE the interpreter executes a section:
//   - an already-FailClosed frontier passes through unchanged (do not mask a prior
//     failure with a wiring verdict);
//   - a ChangedSubgraphFrontier with a dead wire in its slice FailCloses with a typed,
//     located reason -- BEFORE any execution;
//   - a fully-wired slice runs (frontier returned unchanged).
// Negligible compute: static reachability over the affected slice's own dependence
// list, no fixture round-trip per effect (§6 altitude -- this is the residue path that
// dissolves into the compile-time lens as realizations self-host, §5/§7).
fn preflight_reexec_frontier(
  frontier: ReExecFrontier,
  dependencies: List<FrontierDependency>,
  obligations: List<FrontierWiringObligation>
) -> ReExecFrontier {
  match frontier {
    FailClosed { reason: reason } => FailClosed { reason: reason }
    ChangedSubgraphFrontier { boundary_exclusions: _, decisions: _ } =>
      match first_dead_wire(
        dependence: frontier_slice_dependence(dependencies: dependencies),
        obligations: obligations
      ) {
        Absent => frontier
        Present { value: dead } => FailClosed { reason: dead_wire_reason(obligation: dead) }
      }
  }
}
