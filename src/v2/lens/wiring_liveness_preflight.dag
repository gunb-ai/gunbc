module v2.lens.wiring_liveness_preflight

import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }
import std.disposition { RealizationDispatch }
import v2.lens.affected_set {
  ChangedSubgraphFrontier,
  FailClosed,
  FailClosedReason,
  FrontierDependency,
  ReExecFrontier,
  ReasonDiagnostics
}
import v2.lens.wiring_liveness { wiring_reaches }
import std.perturbation { BackwardDiffInDiffOut, perturbation_consistent }
import v2.std.collection { Absent, List, Optional, Present, optional_absent, optional_present }
import v2.std.algebra { list_snoc_item }
import v2.std.dependency { DependencyView }
import v2.std.diagnostic {
  Correction,
  Diagnostic,
  ExternalContractUnknown,
  NonEmptyDiagnostics,
  Unavailable,
  diagnostics_singleton,
  node_locus
}
import v2.std.logic { Bool }
import v2.std.node { Node, Symbol }

type FrontierWiringObligation {
  output: Node
  declared_input: Node
}

fn frontier_slice_dependence(dependencies: List<FrontierDependency>) -> List<DependencyView> {
  fold(dependencies, init: [], f: fn(acc, fd) {
    list_snoc_item(xs: acc, item: fd.dependency)
  })
}

fn obligation_is_wired(dependence: List<DependencyView>, obligation: FrontierWiringObligation) -> Bool {
  perturbation_consistent(
    reading: BackwardDiffInDiffOut,
    output_responded: wiring_reaches(
      dependence: dependence,
      from: obligation.output,
      to: obligation.declared_input
    )
  )
}

fn first_dead_wire(
  dependence: List<DependencyView>,
  obligations: List<FrontierWiringObligation>
) -> Optional<FrontierWiringObligation> {
  fold(obligations, init: optional_absent(), f: fn(acc, obligation) {
    match acc {
      Present { value: v } => optional_present(value: v)
      Absent =>
        if obligation_is_wired(dependence: dependence, obligation: obligation) {
          optional_absent()
        } else {
          optional_present(value: obligation)
        }
    }
  })
}

fn dead_wire_reason(obligation: FrontierWiringObligation) -> FailClosedReason {
  ReasonDiagnostics {
    diagnostics: diagnostics_singleton(d: Diagnostic {
      reason: ^wiring_liveness_dead_wire,
      at: node_locus(node: obligation.declared_input),
      correction: Unavailable { reason: ExternalContractUnknown }
    })
  }
}

fn preflight_reexec_frontier(
  frontier: ReExecFrontier,
  dependencies: List<FrontierDependency>,
  obligations: List<FrontierWiringObligation>
) -> ReExecFrontier {
  match frontier {
    FailClosed { reason: reason } => FailClosed { reason: reason }
    ChangedSubgraphFrontier { boundary_exclusions: _, decisions: _ } =>
      match first_dead_wire(
        dependence: frontier_slice_dependence(dependencies: dependencies),
        obligations: obligations
      ) {
        Absent => frontier
        Present { value: dead } => FailClosed { reason: dead_wire_reason(obligation: dead) }
      }
  }
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: RealizationDispatch }
}
