module v2.lens.extdeps_shape_transport_policy


type ExtdepsTransportKind
  = Shell
  | Rest

type ExtdepsShapeTransportPolicyViolation
  = PolicyLiteralInArgv {
      module: QualifiedName
      service: String
      operation: String
      argv_token: String
    }
  | TransportFusionFork {
      module: QualifiedName
      service_a: String
      service_b: String
      endpoint_key: String
    }
  | DeadParamInArgv {
      module: QualifiedName
      service: String
      operation: String
      param_name: String
    }
  | EmbeddedPolicyLiteralInData {
      module: QualifiedName
      data_name: String
      field_name: String
      literal_value: String
    }

data empty_extdeps_shape_transport_policy_violations: List<ExtdepsShapeTransportPolicyViolation> = []

type ExtdepsTransportArgvFact {
  module: QualifiedName
  service: String
  operation: String
  transport_kind: ExtdepsTransportKind
  argv_index: Int
  argv_token: String
}

type ExtdepsTransportFusionFact {
  module: QualifiedName
  endpoint_key: String
  service_a: String
  service_b: String
}

type ExtdepsOperationInputFact {
  module: QualifiedName
  service: String
  operation: String
  param_name: String
}

type ExtdepsOperationArgvProjection {
  module: QualifiedName
  service: String
  operation: String
  input_facts: List<ExtdepsOperationInputFact>
  argv_facts: List<ExtdepsTransportArgvFact>
}

type ExtdepsEmbeddedPolicyLiteralFact {
  module: QualifiedName
  data_name: String
  field_name: String
  literal_value: String
}

data empty_extdeps_transport_argv_facts: List<ExtdepsTransportArgvFact> = []
data empty_extdeps_transport_fusion_facts: List<ExtdepsTransportFusionFact> = []
data empty_extdeps_operation_input_facts: List<ExtdepsOperationInputFact> = []
data empty_extdeps_embedded_policy_literal_facts: List<ExtdepsEmbeddedPolicyLiteralFact> = []

type ExtdepsModuleFacts {
  argv_facts: List<ExtdepsTransportArgvFact>
  embedded_facts: List<ExtdepsEmbeddedPolicyLiteralFact>
  fusion_facts: List<ExtdepsTransportFusionFact>
  gist_create_declares_filename_input: Bool
  gist_create_files_keyed_by_filename: Bool
  input_facts: List<ExtdepsOperationInputFact>
  source_nickname_literal_count: Int
}

fn extdeps_argv_token_is_parameterized_placeholder(token: String) -> Bool {
  string_contains(token, "{") && string_contains(token, "}")
}

fn extdeps_argv_token_is_consumer_policy_literal(token: String) -> Bool {
  if extdeps_argv_token_is_parameterized_placeholder(token: token) {
    false
  } else if token == "diff" || token == "--name-only" || token == "git" || token == "..." {
    false
  } else {
    token == "--all-targets"
      || token == "--all"
      || token == "--check"
      || token == "--workspace"
      || token == "--no-deps"
      || token == "-D"
      || token == "warnings"
      || string_contains(token, "origin/")
      || string_contains(token, "...")
  }
}

fn extdeps_data_literal_is_embedded_policy_literal(value: String) -> Bool {
  if string_contains(value, " ") {
    true
  } else {
    extdeps_argv_token_is_consumer_policy_literal(token: value)
  }
}

fn extdeps_live_module_embedded_policy_literal_count(module: QualifiedName) -> Int {
  extdeps_shape_transport_policy_embedded_policy_literal_count(
    facts: extdeps_shape_transport_policy_facts_for_qualified_name(module: module).embedded_facts
  )
}

fn extdeps_live_module_source_nickname_literal_count(module: QualifiedName) -> Int {
  extdeps_shape_transport_policy_facts_for_qualified_name(module: module).source_nickname_literal_count
}

fn extdeps_live_module_transport_fusion_fork_count(module: QualifiedName) -> Int {
  extdeps_shape_transport_policy_fusion_count_for_module(
    fusion_facts: extdeps_shape_transport_policy_facts_for_qualified_name(module: module).fusion_facts,
    module: module
  )
}

fn extdeps_live_module_policy_leak_count(module: QualifiedName) -> Int {
  extdeps_shape_transport_policy_policy_leak_count_for_module(
    argv_facts: extdeps_shape_transport_policy_facts_for_qualified_name(module: module).argv_facts,
    module: module
  )
}

fn extdeps_live_module_gist_create_declares_filename_input(module: QualifiedName) -> Bool {
  extdeps_shape_transport_policy_facts_for_qualified_name(module: module).gist_create_declares_filename_input
}

fn extdeps_live_module_gist_create_files_keyed_by_filename(module: QualifiedName) -> Bool {
  extdeps_shape_transport_policy_facts_for_qualified_name(module: module).gist_create_files_keyed_by_filename
}

fn extdeps_module_identity_resolves(module: QualifiedName) -> Bool {
  extdeps_qualified_name_resolves_in_derived_module_set(module: module)
}

fn extdeps_live_module_dead_param_count_for_operation(
  module: QualifiedName,
  service: String,
  operation: String
) -> Int {
  let facts = extdeps_shape_transport_policy_facts_for_qualified_name(module: module)
  extdeps_shape_transport_policy_dead_param_count_for_operation(
    argv_facts: facts.argv_facts,
    input_facts: facts.input_facts,
    module: module,
    service: service,
    operation: operation
  )
}

fn argv_fact_matches_module(fact: ExtdepsTransportArgvFact, module: QualifiedName) -> Bool {
  fact.module == module
}

fn argv_fact_matches_operation(
  fact: ExtdepsTransportArgvFact,
  module: QualifiedName,
  service: String,
  operation: String
) -> Bool {
  argv_fact_matches_module(fact: fact, module: module)
    && fact.service == service
    && fact.operation == operation
}

fn fusion_fact_matches_module(fact: ExtdepsTransportFusionFact, module: QualifiedName) -> Bool {
  fact.module == module
}

fn input_fact_matches_operation(
  fact: ExtdepsOperationInputFact,
  module: QualifiedName,
  service: String,
  operation: String
) -> Bool {
  fact.module == module
    && fact.service == service
    && fact.operation == operation
}

fn extdeps_input_param_is_transport_bound(param_name: String) -> Bool {
  param_name == "env"
}

fn extdeps_argv_token_references_param(token: String, param_name: String) -> Bool {
  token == param_name
    || string_contains(token, concat("{", concat(param_name, "}")))
}

fn extdeps_argv_facts_reference_param(
  argv_facts: List<ExtdepsTransportArgvFact>,
  module: QualifiedName,
  service: String,
  operation: String,
  param_name: String
) -> Bool {
  any(
    xs: filter_argv_facts_for_operation(
      facts: argv_facts,
      module: module,
      service: service,
      operation: operation
    ),
    predicate: fn(fact) {
      extdeps_argv_token_references_param(
        token: fact.argv_token,
        param_name: param_name
      )
    }
  )
}

fn filter_input_facts_for_operation(
  facts: List<ExtdepsOperationInputFact>,
  module: QualifiedName,
  service: String,
  operation: String
) -> List<ExtdepsOperationInputFact> {
  fold_list(
    xs: facts,
    empty: empty_extdeps_operation_input_facts,
    cons: fn(acc, fact) {
      if input_fact_matches_operation(
        fact: fact,
        module: module,
        service: service,
        operation: operation
      ) {
        list_snoc_item(xs: acc, item: fact)
      } else {
        acc
      }
    }
  )
}

fn extdeps_project_operation_argv(
  module: QualifiedName,
  service: String,
  operation: String,
  input_facts: List<ExtdepsOperationInputFact>,
  argv_facts: List<ExtdepsTransportArgvFact>
) -> ExtdepsOperationArgvProjection {
  ExtdepsOperationArgvProjection {
    module: module,
    service: service,
    operation: operation,
    input_facts: filter_input_facts_for_operation(
      facts: input_facts,
      module: module,
      service: service,
      operation: operation
    ),
    argv_facts: filter_argv_facts_for_operation(
      facts: argv_facts,
      module: module,
      service: service,
      operation: operation
    )
  }
}

fn scan_input_facts_for_dead_param_violations(
  input_facts: List<ExtdepsOperationInputFact>,
  argv_facts: List<ExtdepsTransportArgvFact>
) -> List<ExtdepsShapeTransportPolicyViolation> {
  fold_list(
    xs: input_facts,
    empty: empty_extdeps_shape_transport_policy_violations,
    cons: fn(acc, fact) {
      if extdeps_input_param_is_transport_bound(param_name: fact.param_name) {
        acc
      } else if extdeps_argv_facts_reference_param(
        argv_facts: argv_facts,
        module: fact.module,
        service: fact.service,
        operation: fact.operation,
        param_name: fact.param_name
      ) {
        acc
      } else {
        list_snoc_item(
          xs: acc,
          item: DeadParamInArgv {
            module: fact.module,
            service: fact.service,
            operation: fact.operation,
            param_name: fact.param_name
          }
        )
      }
    }
  )
}

fn scan_projection_for_dead_param_violations(
  projection: ExtdepsOperationArgvProjection
) -> List<ExtdepsShapeTransportPolicyViolation> {
  scan_input_facts_for_dead_param_violations(
    input_facts: projection.input_facts,
    argv_facts: projection.argv_facts
  )
}

fn scan_argv_facts_for_violations(
  facts: List<ExtdepsTransportArgvFact>
) -> List<ExtdepsShapeTransportPolicyViolation> {
  fold_list(
    xs: facts,
    empty: empty_extdeps_shape_transport_policy_violations,
    cons: fn(acc, fact) {
      if extdeps_argv_token_is_consumer_policy_literal(token: fact.argv_token) {
        list_snoc_item(
          xs: acc,
          item: PolicyLiteralInArgv {
            module: fact.module,
            service: fact.service,
            operation: fact.operation,
            argv_token: fact.argv_token
          }
        )
      } else {
        acc
      }
    }
  )
}

fn scan_fusion_facts_for_violations(
  facts: List<ExtdepsTransportFusionFact>
) -> List<ExtdepsShapeTransportPolicyViolation> {
  fold_list(
    xs: facts,
    empty: empty_extdeps_shape_transport_policy_violations,
    cons: fn(acc, fact) {
      list_snoc_item(
        xs: acc,
        item: TransportFusionFork {
          module: fact.module,
          service_a: fact.service_a,
          service_b: fact.service_b,
          endpoint_key: fact.endpoint_key
        }
      )
    }
  )
}

fn scan_embedded_policy_facts_for_violations(
  facts: List<ExtdepsEmbeddedPolicyLiteralFact>
) -> List<ExtdepsShapeTransportPolicyViolation> {
  fold_list(
    xs: facts,
    empty: empty_extdeps_shape_transport_policy_violations,
    cons: fn(acc, fact) {
      if extdeps_data_literal_is_embedded_policy_literal(value: fact.literal_value) {
        list_snoc_item(
          xs: acc,
          item: EmbeddedPolicyLiteralInData {
            module: fact.module,
            data_name: fact.data_name,
            field_name: fact.field_name,
            literal_value: fact.literal_value
          }
        )
      } else {
        acc
      }
    }
  )
}

fn merge_violation_lists(
  a: List<ExtdepsShapeTransportPolicyViolation>,
  b: List<ExtdepsShapeTransportPolicyViolation>
) -> List<ExtdepsShapeTransportPolicyViolation> {
  fold_list(
    xs: b,
    empty: a,
    cons: fn(acc, item) { list_snoc_item(xs: acc, item: item) }
  )
}

fn scan_facts_for_violations(
  argv_facts: List<ExtdepsTransportArgvFact>,
  fusion_facts: List<ExtdepsTransportFusionFact>,
  input_facts: List<ExtdepsOperationInputFact>
) -> List<ExtdepsShapeTransportPolicyViolation> {
  merge_violation_lists(
    a: merge_violation_lists(
      a: scan_argv_facts_for_violations(facts: argv_facts),
      b: scan_fusion_facts_for_violations(facts: fusion_facts)
    ),
    b: scan_input_facts_for_dead_param_violations(
      input_facts: input_facts,
      argv_facts: argv_facts
    )
  )
}

fn extdeps_shape_transport_policy_violation_count_with_inputs(
  argv_facts: List<ExtdepsTransportArgvFact>,
  fusion_facts: List<ExtdepsTransportFusionFact>,
  input_facts: List<ExtdepsOperationInputFact>
) -> Int {
  length(
    xs: scan_facts_for_violations(
      argv_facts: argv_facts,
      fusion_facts: fusion_facts,
      input_facts: input_facts
    )
  )
}

fn extdeps_shape_transport_policy_violation_count(
  argv_facts: List<ExtdepsTransportArgvFact>,
  fusion_facts: List<ExtdepsTransportFusionFact>
) -> Int {
  extdeps_shape_transport_policy_violation_count_with_inputs(
    argv_facts: argv_facts,
    fusion_facts: fusion_facts,
    input_facts: empty_extdeps_operation_input_facts
  )
}

fn extdeps_shape_transport_policy_clean_holds(
  argv_facts: List<ExtdepsTransportArgvFact>,
  fusion_facts: List<ExtdepsTransportFusionFact>
) -> Bool {
  extdeps_shape_transport_policy_violation_count(
    argv_facts: argv_facts,
    fusion_facts: fusion_facts
  ) == 0
}

fn filter_argv_facts_for_operation(
  facts: List<ExtdepsTransportArgvFact>,
  module: QualifiedName,
  service: String,
  operation: String
) -> List<ExtdepsTransportArgvFact> {
  fold_list(
    xs: facts,
    empty: empty_extdeps_transport_argv_facts,
    cons: fn(acc, fact) {
      if argv_fact_matches_operation(
        fact: fact,
        module: module,
        service: service,
        operation: operation
      ) {
        list_snoc_item(xs: acc, item: fact)
      } else {
        acc
      }
    }
  )
}

fn filter_argv_facts_for_module(
  facts: List<ExtdepsTransportArgvFact>,
  module: QualifiedName
) -> List<ExtdepsTransportArgvFact> {
  fold_list(
    xs: facts,
    empty: empty_extdeps_transport_argv_facts,
    cons: fn(acc, fact) {
      if argv_fact_matches_module(fact: fact, module: module) {
        list_snoc_item(xs: acc, item: fact)
      } else {
        acc
      }
    }
  )
}

fn filter_fusion_facts_for_module(
  facts: List<ExtdepsTransportFusionFact>,
  module: QualifiedName
) -> List<ExtdepsTransportFusionFact> {
  fold_list(
    xs: facts,
    empty: empty_extdeps_transport_fusion_facts,
    cons: fn(acc, fact) {
      if fusion_fact_matches_module(fact: fact, module: module) {
        list_snoc_item(xs: acc, item: fact)
      } else {
        acc
      }
    }
  )
}

fn extdeps_shape_transport_policy_violation_count_for_operation(
  argv_facts: List<ExtdepsTransportArgvFact>,
  fusion_facts: List<ExtdepsTransportFusionFact>,
  module: QualifiedName,
  service: String,
  operation: String
) -> Int {
  extdeps_shape_transport_policy_violation_count(
    argv_facts: filter_argv_facts_for_operation(
      facts: argv_facts,
      module: module,
      service: service,
      operation: operation
    ),
    fusion_facts: []
  )
}

fn extdeps_shape_transport_policy_violation_count_for_module(
  argv_facts: List<ExtdepsTransportArgvFact>,
  fusion_facts: List<ExtdepsTransportFusionFact>,
  module: QualifiedName
) -> Int {
  extdeps_shape_transport_policy_violation_count(
    argv_facts: argv_facts,
    fusion_facts: filter_fusion_facts_for_module(facts: fusion_facts, module: module)
  )
}

fn extdeps_shape_transport_policy_policy_leak_count_for_module(
  argv_facts: List<ExtdepsTransportArgvFact>,
  module: QualifiedName
) -> Int {
  length(
    xs: scan_argv_facts_for_violations(
      facts: filter_argv_facts_for_module(facts: argv_facts, module: module)
    )
  )
}

fn extdeps_shape_transport_policy_fusion_count_for_module(
  fusion_facts: List<ExtdepsTransportFusionFact>,
  module: QualifiedName
) -> Int {
  length(
    xs: scan_fusion_facts_for_violations(
      facts: filter_fusion_facts_for_module(facts: fusion_facts, module: module)
    )
  )
}

fn extdeps_shape_transport_policy_dead_param_count_for_operation(
  argv_facts: List<ExtdepsTransportArgvFact>,
  input_facts: List<ExtdepsOperationInputFact>,
  module: QualifiedName,
  service: String,
  operation: String
) -> Int {
  length(
    xs: scan_projection_for_dead_param_violations(
      projection: extdeps_project_operation_argv(
        module: module,
        service: service,
        operation: operation,
        input_facts: input_facts,
        argv_facts: argv_facts
      )
    )
  )
}

fn extdeps_shape_transport_policy_embedded_policy_literal_count(
  facts: List<ExtdepsEmbeddedPolicyLiteralFact>
) -> Int {
  length(xs: scan_embedded_policy_facts_for_violations(facts: facts))
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: RealizationDispatch }
}
