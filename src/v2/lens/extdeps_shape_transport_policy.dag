// src/v2/lens/extdeps_shape_transport_policy.dag
// Scope: extdeps shape/transport/policy guard — DESIGN.md §3 extdeps corollary (#5059).
// Flags three tells:
//   (1) POLICY LEAK — argv literal that should be a parameter (consumer intent, not
//       faithful upstream/git surface primitives like git's `diff` / `--name-only`).
//   (2) TRANSPORT-FUSION FORK — same logical endpoint modeled once per transport.
//   (3) DEAD PARAM — operation input declared but absent from argv placeholder projection.
// Status: 🟡 M2 — structural Node-tree argv projection via parse bridge; dead-param
//   detection on input+argv facts. Corpus witnesses read live `dsl/extdeps/**` through
//   `extdeps_dead_param_count_for_*` (Node-tree projection, not text scan).
// Consumer: claim_batch discovery over src/v2/compiler/extdeps_shape_transport_policy.

module v2.lens.extdeps_shape_transport_policy

import v2.std.algebra {
  any,
  fold_list,
  length,
  list_snoc_item
}
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }

// Closed transport vocabulary (extdeps/transports/{shell,rest}.dag — no stringly fork).
type ExtdepsTransportKind
  = Shell
  | Rest

type ExtdepsShapeTransportPolicyViolation
  = PolicyLiteralInArgv {
      path: String
      service: String
      operation: String
      argv_token: String
    }
  | TransportFusionFork {
      path: String
      service_a: String
      service_b: String
      endpoint_key: String
    }
  | DeadParamInArgv {
      path: String
      service: String
      operation: String
      param_name: String
    }

data empty_extdeps_shape_transport_policy_violations: List<ExtdepsShapeTransportPolicyViolation> = []

// Fact row: synthetic (lens-unit) or derived from a live read (corpus).
type ExtdepsTransportArgvFact {
  path: String
  service: String
  operation: String
  transport_kind: ExtdepsTransportKind
  argv_index: Int
  argv_token: String
}

type ExtdepsTransportFusionFact {
  path: String
  endpoint_key: String
  service_a: String
  service_b: String
}

// Operation input row — synthetic (lens-unit) or derived from a parsed service decl (corpus).
type ExtdepsOperationInputFact {
  path: String
  service: String
  operation: String
  param_name: String
}

// Per-operation structural argv projection: declared inputs joined to argv tokens.
type ExtdepsOperationArgvProjection {
  path: String
  service: String
  operation: String
  input_facts: List<ExtdepsOperationInputFact>
  argv_facts: List<ExtdepsTransportArgvFact>
}

data empty_extdeps_transport_argv_facts: List<ExtdepsTransportArgvFact> = []
data empty_extdeps_transport_fusion_facts: List<ExtdepsTransportFusionFact> = []
data empty_extdeps_operation_input_facts: List<ExtdepsOperationInputFact> = []

// filesystem_read bridge result (dissolve-on: std.filesystem read-result type).
type FilesystemReadResult { content: String }

fn extdeps_argv_token_is_parameterized_placeholder(token: String) -> Bool {
  string_contains(token, "{") && string_contains(token, "}")
}

// Consumer-policy literals in argv — not faithful upstream/git surface primitives.
fn extdeps_argv_token_is_consumer_policy_literal(token: String) -> Bool {
  if extdeps_argv_token_is_parameterized_placeholder(token: token) {
    false
  } else if token == "diff" || token == "--name-only" || token == "git" {
    false
  } else {
    token == "--all-targets"
      || token == "--workspace"
      || token == "--no-deps"
      || token == "-D"
      || token == "warnings"
      || string_contains(token, "origin/")
      || string_contains(token, "...")
  }
}

fn extdeps_live_file_shows_transport_fusion_fork(path: String) -> Bool {
  let source = filesystem_read(path: path)
  string_contains(source.content, "service oauth2.Google")
    && string_contains(source.content, "service shell.OAuth2")
    && string_contains(source.content, "refresh_token")
}

// Node-tree projection bridge (v1 interpreter builtin over parsed service decls).
fn extdeps_live_file_dead_param_count_for_operation(
  path: String,
  service: String,
  operation: String
) -> Int {
  extdeps_dead_param_count_for_operation(
    path: path,
    service: service,
    operation: operation
  )
}

fn extdeps_live_file_dead_param_count_for_path(path: String) -> Int {
  extdeps_dead_param_count_for_path(path: path)
}

fn argv_fact_matches_path(fact: ExtdepsTransportArgvFact, path: String) -> Bool {
  fact.path == path
}

fn argv_fact_matches_operation(
  fact: ExtdepsTransportArgvFact,
  path: String,
  service: String,
  operation: String
) -> Bool {
  fact.path == path && fact.service == service && fact.operation == operation
}

fn fusion_fact_matches_path(fact: ExtdepsTransportFusionFact, path: String) -> Bool {
  fact.path == path
}

fn input_fact_matches_operation(
  fact: ExtdepsOperationInputFact,
  path: String,
  service: String,
  operation: String
) -> Bool {
  fact.path == path && fact.service == service && fact.operation == operation
}

// Transport-layer bindings — not argv-placeholder wired (shell env map, etc.).
fn extdeps_input_param_is_transport_bound(param_name: String) -> Bool {
  param_name == "env"
}

fn extdeps_argv_token_references_param(token: String, param_name: String) -> Bool {
  string_contains(token, concat("{", concat(param_name, "}")))
}

fn extdeps_argv_facts_reference_param(
  argv_facts: List<ExtdepsTransportArgvFact>,
  path: String,
  service: String,
  operation: String,
  param_name: String
) -> Bool {
  any(
    xs: filter_argv_facts_for_operation(
      facts: argv_facts,
      path: path,
      service: service,
      operation: operation
    ),
    predicate: fn(fact) {
      extdeps_argv_token_references_param(
        token: fact.argv_token,
        param_name: param_name
      )
    }
  )
}

fn filter_input_facts_for_operation(
  facts: List<ExtdepsOperationInputFact>,
  path: String,
  service: String,
  operation: String
) -> List<ExtdepsOperationInputFact> {
  fold_list(
    xs: facts,
    empty: empty_extdeps_operation_input_facts,
    cons: fn(acc, fact) {
      if input_fact_matches_operation(
        fact: fact,
        path: path,
        service: service,
        operation: operation
      ) {
        list_snoc_item(xs: acc, item: fact)
      } else {
        acc
      }
    }
  )
}

fn extdeps_project_operation_argv(
  path: String,
  service: String,
  operation: String,
  input_facts: List<ExtdepsOperationInputFact>,
  argv_facts: List<ExtdepsTransportArgvFact>
) -> ExtdepsOperationArgvProjection {
  ExtdepsOperationArgvProjection {
    path: path,
    service: service,
    operation: operation,
    input_facts: filter_input_facts_for_operation(
      facts: input_facts,
      path: path,
      service: service,
      operation: operation
    ),
    argv_facts: filter_argv_facts_for_operation(
      facts: argv_facts,
      path: path,
      service: service,
      operation: operation
    )
  }
}

fn scan_input_facts_for_dead_param_violations(
  input_facts: List<ExtdepsOperationInputFact>,
  argv_facts: List<ExtdepsTransportArgvFact>
) -> List<ExtdepsShapeTransportPolicyViolation> {
  fold_list(
    xs: input_facts,
    empty: empty_extdeps_shape_transport_policy_violations,
    cons: fn(acc, fact) {
      if extdeps_input_param_is_transport_bound(param_name: fact.param_name) {
        acc
      } else if extdeps_argv_facts_reference_param(
        argv_facts: argv_facts,
        path: fact.path,
        service: fact.service,
        operation: fact.operation,
        param_name: fact.param_name
      ) {
        acc
      } else {
        list_snoc_item(
          xs: acc,
          item: DeadParamInArgv {
            path: fact.path,
            service: fact.service,
            operation: fact.operation,
            param_name: fact.param_name
          }
        )
      }
    }
  )
}

fn scan_projection_for_dead_param_violations(
  projection: ExtdepsOperationArgvProjection
) -> List<ExtdepsShapeTransportPolicyViolation> {
  scan_input_facts_for_dead_param_violations(
    input_facts: projection.input_facts,
    argv_facts: projection.argv_facts
  )
}

fn scan_argv_facts_for_violations(
  facts: List<ExtdepsTransportArgvFact>
) -> List<ExtdepsShapeTransportPolicyViolation> {
  fold_list(
    xs: facts,
    empty: empty_extdeps_shape_transport_policy_violations,
    cons: fn(acc, fact) {
      if extdeps_argv_token_is_consumer_policy_literal(token: fact.argv_token) {
        list_snoc_item(
          xs: acc,
          item: PolicyLiteralInArgv {
            path: fact.path,
            service: fact.service,
            operation: fact.operation,
            argv_token: fact.argv_token
          }
        )
      } else {
        acc
      }
    }
  )
}

fn scan_fusion_facts_for_violations(
  facts: List<ExtdepsTransportFusionFact>
) -> List<ExtdepsShapeTransportPolicyViolation> {
  fold_list(
    xs: facts,
    empty: empty_extdeps_shape_transport_policy_violations,
    cons: fn(acc, fact) {
      list_snoc_item(
        xs: acc,
        item: TransportFusionFork {
          path: fact.path,
          service_a: fact.service_a,
          service_b: fact.service_b,
          endpoint_key: fact.endpoint_key
        }
      )
    }
  )
}

fn merge_violation_lists(
  a: List<ExtdepsShapeTransportPolicyViolation>,
  b: List<ExtdepsShapeTransportPolicyViolation>
) -> List<ExtdepsShapeTransportPolicyViolation> {
  fold_list(
    xs: b,
    empty: a,
    cons: fn(acc, item) { list_snoc_item(xs: acc, item: item) }
  )
}

fn scan_facts_for_violations(
  argv_facts: List<ExtdepsTransportArgvFact>,
  fusion_facts: List<ExtdepsTransportFusionFact>,
  input_facts: List<ExtdepsOperationInputFact>
) -> List<ExtdepsShapeTransportPolicyViolation> {
  merge_violation_lists(
    a: merge_violation_lists(
      a: scan_argv_facts_for_violations(facts: argv_facts),
      b: scan_fusion_facts_for_violations(facts: fusion_facts)
    ),
    b: scan_input_facts_for_dead_param_violations(
      input_facts: input_facts,
      argv_facts: argv_facts
    )
  )
}

fn extdeps_shape_transport_policy_violation_count_with_inputs(
  argv_facts: List<ExtdepsTransportArgvFact>,
  fusion_facts: List<ExtdepsTransportFusionFact>,
  input_facts: List<ExtdepsOperationInputFact>
) -> Int {
  length(
    xs: scan_facts_for_violations(
      argv_facts: argv_facts,
      fusion_facts: fusion_facts,
      input_facts: input_facts
    )
  )
}

fn extdeps_shape_transport_policy_violation_count(
  argv_facts: List<ExtdepsTransportArgvFact>,
  fusion_facts: List<ExtdepsTransportFusionFact>
) -> Int {
  extdeps_shape_transport_policy_violation_count_with_inputs(
    argv_facts: argv_facts,
    fusion_facts: fusion_facts,
    input_facts: empty_extdeps_operation_input_facts
  )
}

fn extdeps_shape_transport_policy_clean_holds(
  argv_facts: List<ExtdepsTransportArgvFact>,
  fusion_facts: List<ExtdepsTransportFusionFact>
) -> Bool {
  extdeps_shape_transport_policy_violation_count(
    argv_facts: argv_facts,
    fusion_facts: fusion_facts
  ) == 0
}

fn filter_argv_facts_for_operation(
  facts: List<ExtdepsTransportArgvFact>,
  path: String,
  service: String,
  operation: String
) -> List<ExtdepsTransportArgvFact> {
  fold_list(
    xs: facts,
    empty: empty_extdeps_transport_argv_facts,
    cons: fn(acc, fact) {
      if argv_fact_matches_operation(
        fact: fact,
        path: path,
        service: service,
        operation: operation
      ) {
        list_snoc_item(xs: acc, item: fact)
      } else {
        acc
      }
    }
  )
}

fn filter_argv_facts_for_path(
  facts: List<ExtdepsTransportArgvFact>,
  path: String
) -> List<ExtdepsTransportArgvFact> {
  fold_list(
    xs: facts,
    empty: empty_extdeps_transport_argv_facts,
    cons: fn(acc, fact) {
      if argv_fact_matches_path(fact: fact, path: path) {
        list_snoc_item(xs: acc, item: fact)
      } else {
        acc
      }
    }
  )
}

fn filter_fusion_facts_for_path(
  facts: List<ExtdepsTransportFusionFact>,
  path: String
) -> List<ExtdepsTransportFusionFact> {
  fold_list(
    xs: facts,
    empty: empty_extdeps_transport_fusion_facts,
    cons: fn(acc, fact) {
      if fusion_fact_matches_path(fact: fact, path: path) {
        list_snoc_item(xs: acc, item: fact)
      } else {
        acc
      }
    }
  )
}

fn extdeps_shape_transport_policy_violation_count_for_operation(
  argv_facts: List<ExtdepsTransportArgvFact>,
  fusion_facts: List<ExtdepsTransportFusionFact>,
  path: String,
  service: String,
  operation: String
) -> Int {
  extdeps_shape_transport_policy_violation_count(
    argv_facts: filter_argv_facts_for_operation(
      facts: argv_facts,
      path: path,
      service: service,
      operation: operation
    ),
    fusion_facts: []
  )
}

fn extdeps_shape_transport_policy_violation_count_for_path(
  argv_facts: List<ExtdepsTransportArgvFact>,
  fusion_facts: List<ExtdepsTransportFusionFact>,
  path: String
) -> Int {
  extdeps_shape_transport_policy_violation_count(
    argv_facts: argv_facts,
    fusion_facts: filter_fusion_facts_for_path(facts: fusion_facts, path: path)
  )
}

fn extdeps_shape_transport_policy_policy_leak_count_for_path(
  argv_facts: List<ExtdepsTransportArgvFact>,
  path: String
) -> Int {
  length(
    xs: scan_argv_facts_for_violations(
      facts: filter_argv_facts_for_path(facts: argv_facts, path: path)
    )
  )
}

fn extdeps_shape_transport_policy_fusion_count_for_path(
  fusion_facts: List<ExtdepsTransportFusionFact>,
  path: String
) -> Int {
  length(
    xs: scan_fusion_facts_for_violations(
      facts: filter_fusion_facts_for_path(facts: fusion_facts, path: path)
    )
  )
}

fn extdeps_shape_transport_policy_dead_param_count_for_operation(
  argv_facts: List<ExtdepsTransportArgvFact>,
  input_facts: List<ExtdepsOperationInputFact>,
  path: String,
  service: String,
  operation: String
) -> Int {
  length(
    xs: scan_projection_for_dead_param_violations(
      projection: extdeps_project_operation_argv(
        path: path,
        service: service,
        operation: operation,
        input_facts: input_facts,
        argv_facts: argv_facts
      )
    )
  )
}
