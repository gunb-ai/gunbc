module v2.lens.affected_set_examples



data affected_set_example_hash: v2.std.node.Hash = affected_set_example_hash

data affected_set_example_node: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [],
  occurrence_id: SyntheticOccurrence
}
data affected_set_claim_failure_node: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^affected_set_claim_failure_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data affected_set_example_path: v2.std.node.Path = v2.std.node.Path { steps: [^affected_set_example_path_symbol] }

data affected_set_example_edit: v2.std.node.Edit = v2.std.node.Edit {
  at: affected_set_example_path,
  replacement: affected_set_example_node
}

data affected_set_example_invalid_edit_diagnostic: v2.std.diagnostic.Diagnostic = v2.std.diagnostic.Diagnostic {
  reason: ^affected_set_example_reason,
  at: node_locus(node: affected_set_example_node),
  correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
}

data expected_affected_set_boundary_prune: v2.lens.affected_set.ReExecFrontier = v2.lens.affected_set.ChangedSubgraphFrontier {
  boundary_exclusions: [
    v2.lens.affected_set.BoundaryExclusion {
      edit: affected_set_example_edit,
      proof: v2.lens.affected_set.UnchangedPureBoundary {
        content_hash: affected_set_example_hash
      }
    }
  ],
  decisions: empty_map()
}

data expected_affected_set_dimension_seed: v2.lens.affected_set.ReExecFrontier = v2.lens.affected_set.ChangedSubgraphFrontier {
  boundary_exclusions: [],
  decisions: map_insert(
    empty_map(),
    v2.lens.affected_set.ExclusionKey { at: affected_set_example_node, dimension: ^affected_set_example_dimension },
    Rerun
  )
}

data expected_affected_set_excluded_proofs: v2.lens.affected_set.ReExecFrontier = v2.lens.affected_set.ChangedSubgraphFrontier {
  boundary_exclusions: [],
  decisions: map_insert(
    empty_map(),
    v2.lens.affected_set.ExclusionKey { at: affected_set_example_node, dimension: ^affected_set_example_dimension },
    v2.lens.affected_set.Excluded {
      first: v2.lens.affected_set.DimensionNotRead {
        usage_site: affected_set_example_node,
        changed_dimension: ^affected_set_example_dimension
      },
      rest: [
        v2.lens.affected_set.DimensionNotRead {
          usage_site: affected_set_example_node,
          changed_dimension: ^affected_set_example_dimension
        }
      ]
    }
  )
}

data expected_affected_set_unknown_fail_closed: v2.lens.affected_set.ReExecFrontier = FailClosed {
  reason: v2.lens.affected_set.ReasonSymbol { reason: ^affected_set_example_reason }
}

data expected_affected_set_rejected_edit_fail_closed: v2.lens.affected_set.ReExecFrontier = FailClosed {
  reason: v2.lens.affected_set.ReasonDiagnostics {
    diagnostics: diagnostics_singleton(d: affected_set_example_invalid_edit_diagnostic)
  }
}

data expected_affected_set_whole_dag_absorbs_later_unknown: v2.lens.affected_set.ReExecFrontier = FailClosed {
  reason: v2.lens.affected_set.ReasonDiagnostics {
    diagnostics: diagnostics_singleton(d: affected_set_example_invalid_edit_diagnostic)
  }
}

fn affected_set_example_boundary_hash_receipt(dag: v2.lens.affected_set.Dag, path: v2.std.node.Path, replacement: Node) -> v2.lens.affected_set.HashReceipt {
  HashChanged
}

fn affected_set_example_changed_dimension_receipt(dag: v2.lens.affected_set.Dag, edit: v2.std.node.Edit) -> v2.lens.affected_set.ChangedDimensionReceipt {
  v2.lens.affected_set.ChangedDimensions {
    first: ^affected_set_example_dimension,
    rest: []
  }
}

fn affected_set_example_transitive_frontier(dag: v2.lens.affected_set.Dag, edit_dimension: v2.lens.affected_set.EditDimension) -> v2.lens.affected_set.FrontierReceipt {
  v2.lens.affected_set.FrontierProduced { dependencies: [] }
}

fn affected_set_example_propagation_receipt(
  dag: v2.lens.affected_set.Dag,
  edit_dimension: v2.lens.affected_set.EditDimension,
  dependency: v2.std.dependency.DependencyView
) -> v2.lens.affected_set.PropagationReceipt {
  Propagates
}

data affected_set_example_read: v2.lens.affected_set.AffectedSetRead = v2.lens.affected_set.AffectedSetRead {
  boundary: v2.lens.affected_set.AffectedBoundaryRead {
    boundary_hash_receipt: affected_set_example_boundary_hash_receipt,
    changed_dimension_receipt: affected_set_example_changed_dimension_receipt
  },
  frontier: v2.lens.affected_set.AffectedFrontierRead {
    proven_transitive_dependency_frontier: affected_set_example_transitive_frontier
  },
  propagation_receipt: affected_set_example_propagation_receipt
}

fn affected_set_example_post_edit_accepts(dag: v2.lens.affected_set.Dag, edit: v2.std.node.Edit) -> v2.lens.affected_set.AffectedPostEditDagRead {
  v2.lens.affected_set.AffectedPostEditDagRead {
    outcome: v2.std.diagnostic.Accepted { value: dag, diagnostics: v2.std.diagnostic.None }
  }
}

fn affected_set_example_post_edit_rejects(dag: v2.lens.affected_set.Dag, edit: v2.std.node.Edit) -> v2.lens.affected_set.AffectedPostEditDagRead {
  v2.lens.affected_set.AffectedPostEditDagRead {
    outcome: v2.std.diagnostic.Rejected {
      diagnostics: diagnostics_singleton(d: affected_set_example_invalid_edit_diagnostic)
    }
  }
}

data affected_set_example_two_edit_diff: v2.std.node.Diff = v2.std.node.Diff {
  edits: [affected_set_example_edit, affected_set_example_edit]
}

data construction_justification: v2.lens.common.construction_justification.ConstructionJustification = v2.lens.common.construction_justification.ConstructionJustification {
  class: v2.lens.common.construction_justification.WallAfterGrounding { dissolves_to: SingleAuthority }
}
