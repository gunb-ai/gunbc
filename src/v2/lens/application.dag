module v2.lens.application


type DeclarationId {
  path: v2.std.node.Path
}
type NodeId {
  path: v2.std.node.Path
}
type SourceSpan

type SectionRef
  = DeclarationScope { declaration: DeclarationId }
  | NodeScope { declaration: DeclarationId, node: NodeId }

type LensEnforcement<Output, Budget, Projected> {
  project: fn(Output) -> Projected
  violates: fn(Output, Budget) -> v2.std.logic.Bool
}

type EnforceableLens<Output, Budget, Projected> {
  lens: Lens<Output>
  enforcement: LensEnforcement<Output, Budget, Projected>
}

type Lens<Output> {
  read: fn(v2.std.node.Node) -> Outcome<Output>
}

type AdvisoryLens {
  read: fn(v2.std.node.Node) -> List<Report>
}

type LensApplicationConfig<Output, Budget, Projected>
  = LensIntrospect
  | LensEnforce {
      budget: Budget
    }

type EnforcedApplication<Output, Budget, Projected> {
  enforceable_lens: EnforceableLens<Output, Budget, Projected>
  section: SectionRef
  budget: Budget
  span: SourceSpan
}

type EnforcedLensResult<Output, Projected> {
  output: Output
  projected: Projected
}

type LensEnforcementViolationInput<Projected, Budget> {
  at: v2.std.node.Node
  projected: Projected
  declared: Budget
}

type IntrospectApplication<Output> {
  lens: Lens<Output>
  section: SectionRef
  span: SourceSpan
}
fn path_unresolvable_diagnostic(at: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^path_unresolvable_reason,
    at: node_locus(node: at),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn path_ambiguous_diagnostic(at: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^path_ambiguous_reason,
    at: node_locus(node: at),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn lens_enforcement_violation_diagnostic<Projected, Budget>(
  input: LensEnforcementViolationInput<Projected, Budget>
) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^lens_enforcement_violation_reason,
    at: node_locus(node: input.at),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn lens_enforcement_violation_input<Projected, Budget>(
  at: v2.std.node.Node,
  projected: Projected,
  declared: Budget
) -> LensEnforcementViolationInput<Projected, Budget> {
  LensEnforcementViolationInput {
    at: at,
    projected: projected,
    declared: declared
  }
}

fn advisory_report_diagnostic(report: v2.std.report.Report) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: report_reason_to_diagnostic_reason(reason: report.reason),
    at: report.at,
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn find_child_by_name(root: v2.std.node.Node, name: v2.std.node.Symbol) -> Outcome<v2.std.node.Node> {
  match find_named_child(root: root, name: name) {
    Accepted { value: child, diagnostics: d } => v2.std.diagnostic.Accepted { value: child, diagnostics: d }
    v2.std.diagnostic.Rejected { diagnostics: diags } =>
      if diags.head.reason == ^named_child_ambiguous {
        outcome_rejected(d: path_ambiguous_diagnostic(at: root))
      } else {
        outcome_rejected(d: path_unresolvable_diagnostic(at: root))
      }
  }
}

fn subterm_at_steps(root: v2.std.node.Node, steps: List<v2.std.node.Symbol>) -> Outcome<v2.std.node.Node> {
  fold_list(
    xs: steps,
    empty: outcome_accepted(value: root),
    cons: fn(acc, step) {
      bind_outcome(
        o: acc,
        f: fn(current) {
          find_child_by_name(root: current, name: step)
        }
      )
    }
  )
}

fn subterm_at(root: v2.std.node.Node, path: v2.std.node.Path) -> Outcome<v2.std.node.Node> {
  subterm_at_steps(root: root, steps: path.steps)
}

fn replace_edge_target(e: v2.std.node.Edge, replacement: v2.std.node.Node) -> v2.std.node.Edge {
  v2.std.node.Edge { label: e.label, target: replacement }
}

type PathSplit {
  init: List<v2.std.node.Symbol>
  last: v2.std.node.Symbol
  first: v2.std.logic.Bool
}

fn split_path_steps(root: v2.std.node.Node, steps: List<v2.std.node.Symbol>) -> Outcome<PathSplit> {
  if is_empty(xs: steps) {
    outcome_rejected(d: path_unresolvable_diagnostic(at: root))
  } else {
    outcome_accepted(value: fold_list(
      xs: steps,
      empty: PathSplit { init: [], last: ^path_unresolvable_reason, first: true },
      cons: fn(split, step) {
        match split.first {
          true => PathSplit { init: [], last: step, first: false }
          false => PathSplit {
            init: list_snoc_item(xs: split.init, item: split.last),
            last: step,
            first: false
          }
        }
      }
    ))
  }
}

fn rebuild_node_with_child(root: v2.std.node.Node, name: v2.std.node.Symbol, child: v2.std.node.Node) -> Outcome<v2.std.node.Node> {
  if name_occurrences(name: name, children: root.children) == 0 {
    outcome_rejected(d: path_unresolvable_diagnostic(at: root))
  } else if name_occurrences(name: name, children: root.children) == 1 {
    outcome_accepted(value: node_rebuild(
      n: root,
      children: fold(
        root.children,
        init: std.algebra.Empty,
        f: fn(current_acc, edge) {
          match edge.label {
            v2.std.node.Named { name: edge_name } =>
              let next_edge = match edge_name == name {
                true => replace_edge_target(e: edge, replacement: child)
                false => edge
              }
              list_snoc_item(xs: current_acc, item: next_edge)
            Positional => list_snoc_item(xs: current_acc, item: edge)
          }
        }
      )
    ))
  } else {
    outcome_rejected(d: path_ambiguous_diagnostic(at: root))
  }
}

type AncestorFrame {
  ancestor: v2.std.node.Node
  step: v2.std.node.Symbol
}

type AncestorWalk {
  current: v2.std.node.Node
  frames: List<AncestorFrame>
}

fn collect_ancestor_frames(root: v2.std.node.Node, steps: List<v2.std.node.Symbol>) -> Outcome<AncestorWalk> {
  fold_list(
    xs: steps,
    empty: outcome_accepted(value: AncestorWalk { current: root, frames: [] }),
    cons: fn(walk_outcome, step) {
      bind_outcome(
        o: walk_outcome,
        f: fn(walk) {
          bind_outcome(
            o: find_child_by_name(root: walk.current, name: step),
            f: fn(child) {
              outcome_accepted(value: AncestorWalk {
                current: child,
                frames: std.algebra.Cons {
                  head: AncestorFrame { ancestor: walk.current, step: step },
                  tail: walk.frames
                }
              })
            }
          )
        }
      )
    }
  )
}

fn thread_up_with_ancestor_frame(acc_outcome: Outcome<v2.std.node.Node>, frame: AncestorFrame) -> Outcome<v2.std.node.Node> {
  bind_outcome(
    o: acc_outcome,
    f: fn(child) {
      rebuild_node_with_child(
        root: frame.ancestor,
        name: frame.step,
        child: child
      )
    }
  )
}

fn thread_substitution_up(frames: List<AncestorFrame>, rebuilt_child: v2.std.node.Node) -> Outcome<v2.std.node.Node> {
  fold_list(
    xs: frames,
    empty: outcome_accepted(value: rebuilt_child),
    cons: thread_up_with_ancestor_frame
  )
}

fn substitute_at(root: v2.std.node.Node, path: v2.std.node.Path, replacement: v2.std.node.Node) -> Outcome<v2.std.node.Node> {
  if is_empty(xs: path.steps) {
    outcome_accepted(value: replacement)
  } else {
    bind_outcome(
      o: split_path_steps(root: root, steps: path.steps),
      f: fn(split) {
        bind_outcome(
          o: collect_ancestor_frames(root: root, steps: split.init),
          f: fn(walk) {
            bind_outcome(
              o: rebuild_node_with_child(
                root: walk.current,
                name: split.last,
                child: replacement
              ),
              f: fn(rebuilt_leaf) {
                thread_substitution_up(frames: walk.frames, rebuilt_child: rebuilt_leaf)
              }
            )
          }
        )
      }
    )
  }
}

fn apply_edit(root: v2.std.node.Node, edit: v2.std.node.Edit) -> Outcome<v2.std.node.Node> {
  substitute_at(root: root, path: edit.at, replacement: edit.replacement)
}

fn apply_diff_edits(root: v2.std.node.Node, edits: List<v2.std.node.Edit>) -> Outcome<v2.std.node.Node> {
  fold_list(
    xs: edits,
    empty: outcome_accepted(value: root),
    cons: fn(acc, edit) {
      bind_outcome(
        o: acc,
        f: fn(candidate) {
          apply_edit(root: candidate, edit: edit)
        }
      )
    }
  )
}

fn apply_diff(root: v2.std.node.Node, d: v2.std.node.Diff) -> Outcome<v2.std.node.Node> {
  apply_diff_edits(root: root, edits: d.edits)
}

fn section_subject(root: v2.std.node.Node, section: SectionRef) -> Outcome<v2.std.node.Node> {
  match section {
    DeclarationScope { declaration: declaration } =>
      subterm_at(root: root, path: declaration.path)
    NodeScope { declaration: declaration, node: node } =>
      bind_outcome(
        o: subterm_at(root: root, path: declaration.path),
        f: fn(declaration_subject) {
          subterm_at(root: declaration_subject, path: node.path)
        }
      )
  }
}

fn lens_enforcement_violated<Output, Budget, Projected>(
  enforcement: LensEnforcement<Output, Budget, Projected>,
  output: Output,
  budget: Budget
) -> v2.std.logic.Bool {
  enforcement.violates(output: output, declared: budget)
}

fn lens_enforcement_result<Output, Budget, Projected>(
  enforcement: LensEnforcement<Output, Budget, Projected>,
  output: Output
) -> EnforcedLensResult<Output, Projected> {
  EnforcedLensResult {
    output: output,
    projected: enforcement.project(output: output)
  }
}

fn apply_lens<Output>(
  lens: Lens<Output>,
  section: SectionRef,
  root: v2.std.node.Node
) -> Outcome<Output> {
  bind_outcome(
    o: section_subject(root: root, section: section),
    f: fn(subject) {
      lens.read(root: subject)
    }
  )
}

fn apply_lens_enforce<Output, Budget, Projected>(
  enforceable: EnforceableLens<Output, Budget, Projected>,
  section: SectionRef,
  root: v2.std.node.Node,
  budget: Budget
) -> Outcome<EnforcedLensResult<Output, Projected>> {
  bind_outcome(
    o: section_subject(root: root, section: section),
    f: fn(subject) {
      bind_outcome(
        o: enforceable.lens.read(root: subject),
        f: fn(lens_output) {
          let enforcement_result = lens_enforcement_result(
            enforcement: enforceable.enforcement,
            output: lens_output
          )
          if lens_enforcement_violated(
            enforcement: enforceable.enforcement,
            output: lens_output,
            budget: budget
          ) {
            outcome_rejected(
              d: lens_enforcement_violation_diagnostic(
                input: lens_enforcement_violation_input(
                  at: subject,
                  projected: enforcement_result.projected,
                  declared: budget
                )
              )
            )
          } else {
            outcome_accepted(value: enforcement_result)
          }
        }
      )
    }
  )
}

type ReportDiagnosticsFold {
  started: v2.std.logic.Bool
  acc: v2.std.diagnostic.NonEmptyDiagnostics
}

fn advisory_reports_empty_diagnostic(at: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^advisory_reports_empty_reason,
    at: node_locus(node: at),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn reports_to_non_empty_diagnostics(
  reports: List<v2.std.report.Report>,
  at: v2.std.node.Node
) -> Outcome<v2.std.diagnostic.NonEmptyDiagnostics> {
  if is_empty(xs: reports) {
    outcome_rejected(d: advisory_reports_empty_diagnostic(at: at))
  } else {
    outcome_accepted(value: fold_list(
      xs: reports,
      empty: ReportDiagnosticsFold {
        started: false,
        acc: diagnostics_singleton(d: advisory_reports_empty_diagnostic(at: at))
      },
      cons: fn(state, report) {
        match state.started {
          false => ReportDiagnosticsFold {
            started: true,
            acc: diagnostics_singleton(d: advisory_report_diagnostic(report: report))
          }
          true => ReportDiagnosticsFold {
            started: true,
            acc: non_empty_diagnostics_append(
              a: state.acc,
              b: diagnostics_singleton(d: advisory_report_diagnostic(report: report))
            )
          }
        }
      }
    ).acc)
  }
}

fn apply_advisory_lens(
  lens: AdvisoryLens,
  section: SectionRef,
  root: v2.std.node.Node,
  config: LensApplicationConfig<v2.std.report.Report, v2.std.report.Report, v2.std.report.Report>
) -> Outcome<List<v2.std.report.Report>> {
  bind_outcome(
    o: section_subject(root: root, section: section),
    f: fn(subject) {
      let reports = lens.read(root: subject)
      match config {
        LensIntrospect => outcome_accepted(value: reports)
        LensEnforce { budget: _ } =>
          if is_empty(xs: reports) {
            outcome_accepted(value: reports)
          } else {
            bind_outcome(
              o: reports_to_non_empty_diagnostics(reports: reports, at: subject),
              f: fn(diagnostics) {
                v2.std.diagnostic.Rejected { diagnostics: diagnostics }
              }
            )
          }
      }
    }
  )
}

data construction_justification: v2.lens.common.construction_justification.ConstructionJustification = v2.lens.common.construction_justification.ConstructionJustification {
  class: v2.lens.common.construction_justification.WallAfterGrounding { dissolves_to: RealizationDispatch }
}
