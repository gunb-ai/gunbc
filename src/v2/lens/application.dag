// src/v2/lens/application.dag
//
// Scope: lens-application surface — how a user attaches a lens to a program section (declaration / module / expression scope) with configurable enforcement. THE opt-in-depth mechanism + user-defined-dimensions surface + the ONLY advisory→fail-closed bridge. Referenced by report.dag/synthesis.dag's apply_lens(Enforce) — this file is its substrate home.
// Anchor: user-defined dimensions + audience duality / opt-in depth + v3 T-Lens-Application-Surface precedent.
//
// Status: carriers + apply_lens + D1 ops; section_subject projects via Path-backed handles pending section-ref-identity-evidence (gate below).
// Boundary discipline (DESIGN.md §3): THIS module is the single authority for section-scoped `Lens<Output>.read`,
// `LensApplicationConfig`, and `apply_lens` / `apply_lens_enforce` / `apply_advisory_lens`.
// `v2.compiler.compile` owns the orthogonal compile-pipeline gate (`CompileLens`,
// `CompileLensMode`, `apply_compile_lens` over `InferredTree`); adapter wiring is follow-on.
// See (T-23-PIN).

module v2.lens.application

import v2.std.algebra { Cons, Empty, is_empty, fold_list, list_snoc_item }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  NonEmptyDiagnostics,
  Outcome,
  Rejected,
  Unavailable,
  bind_outcome,
  diagnostics_singleton,
  node_locus,
  non_empty_diagnostics_append,
  outcome_accepted,
  outcome_rejected
}
import v2.std.node {
  Conj,
  Diff,
  Edge,
  Edit,
  Named,
  Node,
  NodeKind,
  Path,
  Positional,
  Symbol,
  TypeNode,
  name_occurrences,
  node_rebuild,
  SyntheticOccurrence
}
import v2.std.node_query {
  find_named_child
}
import v2.std.report { Report, report_reason_to_diagnostic_reason }

// 🟡 gated — feature:section-ref-identity-evidence —
// dissolve-on-arrival: replace Path-backed handles with typed declaration identity and
// node-containment evidence from the shared declaration/node identity substrate; forbidden:
// marking SectionRef construction fully grounded while arbitrary paths can inhabit these handles.
type DeclarationId {
  path: Path
}
type NodeId {
  path: Path
}
type SourceSpan

// 🟢 TERMINAL — disjoint sum over section shapes.
type SectionRef
  = DeclarationScope { declaration: DeclarationId }
  | NodeScope { declaration: DeclarationId, node: NodeId }

// 🟢 TERMINAL — C-8 fail-closed: only Error is admitted steady state.
// v2 substrate: unit variant (v3 `Error` tag is not a v2 type name).
type DiagnosticSeverity
  = SeverityError {}

// 🟢 TERMINAL — per-lens enforcement projection + violation relation.
// violates first argument is full Output (v3 lens_application.dag) so
// per-lens relations can discriminate sum variants before budget comparison.
type LensEnforcement<Output, Budget, Projected> {
  project: fn(Output) -> Projected
  violates: fn(Output, Budget) -> Bool
}

// 🟢 TERMINAL — bundled lens + canonical enforcement (single authority).
type EnforceableLens<Output, Budget, Projected> {
  lens: Lens<Output>
  enforcement: LensEnforcement<Output, Budget, Projected>
}

// 🟢 grounded — application-surface lens read (fail-closed at read boundary).
type Lens<Output> {
  read: fn(Node) -> Outcome<Output>
}

// 🟢 grounded — advisory lens read (Report carrier; never Witness).
// Materialized as List<Report> (v2 Set<T> = PointwisePower membership predicate).
type AdvisoryLens {
  read: fn(Node) -> List<Report>
}

// 🟢 coproduct dissolution — enforce vs introspect application mode (single authority).
type LensApplicationConfig<Output, Budget, Projected>
  = LensIntrospect
  | LensEnforce {
      budget: Budget
      diagnostic_severity: DiagnosticSeverity
    }

// 🟢 TERMINAL — enforce-mode application carrier.
type EnforcedApplication<Output, Budget, Projected> {
  enforceable_lens: EnforceableLens<Output, Budget, Projected>
  section: SectionRef
  budget: Budget
  diagnostic_severity: DiagnosticSeverity
  span: SourceSpan
}

// 🟢 grounded — enforce-mode output carrier. `Projected` flows forward for
// downstream composition / diagnostics instead of remaining a phantom witness.
type EnforcedLensResult<Output, Projected> {
  output: Output
  projected: Projected
}

// 🟡 gated — feature:lens-enforcement-diagnostic-detail — generic observed/declared facts
// flow to the diagnostic boundary, but v2.std.diagnostic is reason/locus shaped today.
// dissolve-on-arrival: Diagnostic detail payloads can carry Projected/Budget evidence;
// forbidden: claiming projected/declared facts are consumed by plain Diagnostic.
type LensEnforcementViolationInput<Projected, Budget> {
  at: Node
  projected: Projected
  declared: Budget
}

// 🟢 TERMINAL — introspect-mode application carrier.
type IntrospectApplication<Output> {
  lens: Lens<Output>
  section: SectionRef
  span: SourceSpan
}
fn path_unresolvable_diagnostic(at: Node) -> Diagnostic {
  Diagnostic {
    reason: ^path_unresolvable_reason,
    at: node_locus(node: at),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn path_ambiguous_diagnostic(at: Node) -> Diagnostic {
  Diagnostic {
    reason: ^path_ambiguous_reason,
    at: node_locus(node: at),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn lens_enforcement_violation_diagnostic<Projected, Budget>(
  input: LensEnforcementViolationInput<Projected, Budget>
) -> Diagnostic {
  Diagnostic {
    reason: ^lens_enforcement_violation_reason,
    at: node_locus(node: input.at),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn lens_enforcement_violation_input<Projected, Budget>(
  at: Node,
  projected: Projected,
  declared: Budget
) -> LensEnforcementViolationInput<Projected, Budget> {
  LensEnforcementViolationInput {
    at: at,
    projected: projected,
    declared: declared
  }
}

fn advisory_report_diagnostic(report: Report) -> Diagnostic {
  Diagnostic {
    reason: report_reason_to_diagnostic_reason(reason: report.reason),
    at: report.at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

// Delegates to the 🟢-canonical find_named_child in std/node_query.dag; translates
// node_query diagnostic vocabulary to the lens D1 path contract's own reasons
// (^path_unresolvable_reason / ^path_ambiguous_reason) so callers see only lens-boundary diagnostics.
fn find_child_by_name(root: Node, name: Symbol) -> Outcome<Node> {
  match find_named_child(root: root, name: name) {
    Accepted { value: child, diagnostics: d } => Accepted { value: child, diagnostics: d }
    Rejected { diagnostics: diags } =>
      if diags.head.reason == ^named_child_ambiguous {
        outcome_rejected(d: path_ambiguous_diagnostic(at: root))
      } else {
        outcome_rejected(d: path_unresolvable_diagnostic(at: root))
      }
  }
}

fn subterm_at_steps(root: Node, steps: List<Symbol>) -> Outcome<Node> {
  fold_list(
    xs: steps,
    empty: outcome_accepted(value: root),
    cons: fn(acc, step) {
      bind_outcome(
        o: acc,
        f: fn(current) {
          find_child_by_name(root: current, name: step)
        }
      )
    }
  )
}

// Result<Node, Diagnostic> ≡ Outcome<Node> per DECISIONS item I / std/diagnostic.dag.
fn subterm_at(root: Node, path: Path) -> Outcome<Node> {
  subterm_at_steps(root: root, steps: path.steps)
}

fn replace_edge_target(e: Edge, replacement: Node) -> Edge {
  Edge { label: e.label, role: e.role, target: replacement }
}

type PathSplit {
  init: List<Symbol>
  last: Symbol
  first: Bool
}

fn split_path_steps(root: Node, steps: List<Symbol>) -> Outcome<PathSplit> {
  if is_empty(xs: steps) {
    outcome_rejected(d: path_unresolvable_diagnostic(at: root))
  } else {
    outcome_accepted(value: fold_list(
      xs: steps,
      empty: PathSplit { init: [], last: ^path_unresolvable_reason, first: true },
      cons: fn(split, step) {
        match split.first {
          true => PathSplit { init: [], last: step, first: false }
          false => PathSplit {
            init: list_snoc_item(xs: split.init, item: split.last),
            last: step,
            first: false
          }
        }
      }
    ))
  }
}

// 🟢 grounded — D1 child replacement when `name_occurrences` proves exactly one named edge.
fn rebuild_node_with_child(root: Node, name: Symbol, child: Node) -> Outcome<Node> {
  if name_occurrences(name: name, children: root.children) == 0 {
    outcome_rejected(d: path_unresolvable_diagnostic(at: root))
  } else if name_occurrences(name: name, children: root.children) == 1 {
    outcome_accepted(value: node_rebuild(
      n: root,
      children: fold(
        root.children,
        init: Empty,
        f: fn(current_acc, edge) {
          match edge.label {
            Named { name: edge_name } =>
              let next_edge = match edge_name == name {
                true => replace_edge_target(e: edge, replacement: child)
                false => edge
              }
              list_snoc_item(xs: current_acc, item: next_edge)
            Positional => list_snoc_item(xs: current_acc, item: edge)
          }
        }
      )
    ))
  } else {
    outcome_rejected(d: path_ambiguous_diagnostic(at: root))
  }
}

type AncestorFrame {
  ancestor: Node
  step: Symbol
}

type AncestorWalk {
  current: Node
  frames: List<AncestorFrame>
}

fn collect_ancestor_frames(root: Node, steps: List<Symbol>) -> Outcome<AncestorWalk> {
  fold_list(
    xs: steps,
    empty: outcome_accepted(value: AncestorWalk { current: root, frames: [] }),
    cons: fn(walk_outcome, step) {
      bind_outcome(
        o: walk_outcome,
        f: fn(walk) {
          bind_outcome(
            o: find_child_by_name(root: walk.current, name: step),
            f: fn(child) {
              outcome_accepted(value: AncestorWalk {
                current: child,
                frames: Cons {
                  head: AncestorFrame { ancestor: walk.current, step: step },
                  tail: walk.frames
                }
              })
            }
          )
        }
      )
    }
  )
}

fn thread_up_with_ancestor_frame(acc_outcome: Outcome<Node>, frame: AncestorFrame) -> Outcome<Node> {
  bind_outcome(
    o: acc_outcome,
    f: fn(child) {
      rebuild_node_with_child(
        root: frame.ancestor,
        name: frame.step,
        child: child
      )
    }
  )
}

fn thread_substitution_up(frames: List<AncestorFrame>, rebuilt_child: Node) -> Outcome<Node> {
  fold_list(
    xs: frames,
    empty: outcome_accepted(value: rebuilt_child),
    cons: thread_up_with_ancestor_frame
  )
}

fn substitute_at(root: Node, path: Path, replacement: Node) -> Outcome<Node> {
  if is_empty(xs: path.steps) {
    outcome_accepted(value: replacement)
  } else {
    bind_outcome(
      o: split_path_steps(root: root, steps: path.steps),
      f: fn(split) {
        bind_outcome(
          o: collect_ancestor_frames(root: root, steps: split.init),
          f: fn(walk) {
            bind_outcome(
              o: rebuild_node_with_child(
                root: walk.current,
                name: split.last,
                child: replacement
              ),
              f: fn(rebuilt_leaf) {
                thread_substitution_up(frames: walk.frames, rebuilt_child: rebuilt_leaf)
              }
            )
          }
        )
      }
    )
  }
}

fn apply_edit(root: Node, edit: Edit) -> Outcome<Node> {
  substitute_at(root: root, path: edit.at, replacement: edit.replacement)
}

fn apply_diff_edits(root: Node, edits: List<Edit>) -> Outcome<Node> {
  fold_list(
    xs: edits,
    empty: outcome_accepted(value: root),
    cons: fn(acc, edit) {
      bind_outcome(
        o: acc,
        f: fn(candidate) {
          apply_edit(root: candidate, edit: edit)
        }
      )
    }
  )
}

// All-or-nothing sequential rewrite program (PR #3162).
fn apply_diff(root: Node, d: Diff) -> Outcome<Node> {
  apply_diff_edits(root: root, edits: d.edits)
}

// 🟡 gated — feature:section-ref-identity-evidence — projection is real, but handle construction is
// still a bounded bridge until DeclarationId proves declaration-ness and NodeId proves containment.
fn section_subject(root: Node, section: SectionRef) -> Outcome<Node> {
  match section {
    DeclarationScope { declaration: declaration } =>
      subterm_at(root: root, path: declaration.path)
    NodeScope { declaration: declaration, node: node } =>
      bind_outcome(
        o: subterm_at(root: root, path: declaration.path),
        f: fn(declaration_subject) {
          subterm_at(root: declaration_subject, path: node.path)
        }
      )
  }
}

fn lens_enforcement_violated<Output, Budget, Projected>(
  enforcement: LensEnforcement<Output, Budget, Projected>,
  output: Output,
  budget: Budget
) -> Bool {
  enforcement.violates(output: output, declared: budget)
}

fn lens_enforcement_result<Output, Budget, Projected>(
  enforcement: LensEnforcement<Output, Budget, Projected>,
  output: Output
) -> EnforcedLensResult<Output, Projected> {
  EnforcedLensResult {
    output: output,
    projected: enforcement.project(output: output)
  }
}

// Introspect substrate entry — Lens<Output> only.
// 🟡 gated — feature:section-ref-identity-evidence — `section` selects the lens read subject via `section_subject`; Path-backed DeclarationId/NodeId handles are the bounded bridge (see gate on `section_subject` above).
fn apply_lens<Output>(
  lens: Lens<Output>,
  section: SectionRef,
  root: Node
) -> Outcome<Output> {
  bind_outcome(
    o: section_subject(root: root, section: section),
    f: fn(subject) {
      lens.read(root: subject)
    }
  )
}

// Enforce substrate entry — EnforceableLens + declared budget (EnforcedApplication).
// 🟡 gated — feature:section-ref-identity-evidence — section-scoped read uses `section_subject` projection; handle evidence is the open gate (see `section_subject`).
fn apply_lens_enforce<Output, Budget, Projected>(
  enforceable: EnforceableLens<Output, Budget, Projected>,
  section: SectionRef,
  root: Node,
  budget: Budget,
  diagnostic_severity: DiagnosticSeverity
) -> Outcome<EnforcedLensResult<Output, Projected>> {
  bind_outcome(
    o: section_subject(root: root, section: section),
    f: fn(subject) {
      bind_outcome(
        o: enforceable.lens.read(root: subject),
        f: fn(lens_output) {
          let enforcement_result = lens_enforcement_result(
            enforcement: enforceable.enforcement,
            output: lens_output
          )
          if lens_enforcement_violated(
            enforcement: enforceable.enforcement,
            output: lens_output,
            budget: budget
          ) {
            outcome_rejected(
              d: lens_enforcement_violation_diagnostic(
                input: lens_enforcement_violation_input(
                  at: subject,
                  projected: enforcement_result.projected,
                  declared: budget
                )
              )
            )
          } else {
            outcome_accepted(value: enforcement_result)
          }
        }
      )
    }
  )
}

type ReportDiagnosticsFold {
  started: Bool
  acc: NonEmptyDiagnostics
}

fn advisory_reports_empty_diagnostic(at: Node) -> Diagnostic {
  Diagnostic {
    reason: ^advisory_reports_empty_reason,
    at: node_locus(node: at),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn reports_to_non_empty_diagnostics(
  reports: List<Report>,
  at: Node
) -> Outcome<NonEmptyDiagnostics> {
  if is_empty(xs: reports) {
    outcome_rejected(d: advisory_reports_empty_diagnostic(at: at))
  } else {
    outcome_accepted(value: fold_list(
      xs: reports,
      empty: ReportDiagnosticsFold {
        started: false,
        acc: diagnostics_singleton(d: advisory_reports_empty_diagnostic(at: at))
      },
      cons: fn(state, report) {
        match state.started {
          false => ReportDiagnosticsFold {
            started: true,
            acc: diagnostics_singleton(d: advisory_report_diagnostic(report: report))
          }
          true => ReportDiagnosticsFold {
            started: true,
            acc: non_empty_diagnostics_append(
              a: state.acc,
              b: diagnostics_singleton(d: advisory_report_diagnostic(report: report))
            )
          }
        }
      }
    ).acc)
  }
}

// THE single advisory→fail-closed bridge: non-empty advisory reports ⇒ Rejected diagnostics.
// 🟡 gated — feature:section-ref-identity-evidence — section-scoped read uses `section_subject` projection; handle evidence is the open gate (see `section_subject`).
fn apply_advisory_lens(
  lens: AdvisoryLens,
  section: SectionRef,
  root: Node,
  config: LensApplicationConfig<Report, Report, Report>
) -> Outcome<List<Report>> {
  bind_outcome(
    o: section_subject(root: root, section: section),
    f: fn(subject) {
      let reports = lens.read(root: subject)
      match config {
        LensIntrospect => outcome_accepted(value: reports)
        LensEnforce { budget: _, diagnostic_severity: _ } =>
          if is_empty(xs: reports) {
            outcome_accepted(value: reports)
          } else {
            bind_outcome(
              o: reports_to_non_empty_diagnostics(reports: reports, at: subject),
              f: fn(diagnostics) {
                Rejected { diagnostics: diagnostics }
              }
            )
          }
      }
    }
  )
}
