module v2.test.lens_affected_set.verified_by_in_frontier

import v2.lens.affected_set { dependency_in_lens_frontier }
import v2.std.dependency { DependencyView, VerifiedBy }
import v2.std.logic { Bool }
import v2.std.node { Atom, Conj, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}

fn verified_by_node(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

data verified_by_root: Node = verified_by_node(s: ^verified_by_root_symbol)

data verified_by_dependency: DependencyView = DependencyView {
  source: verified_by_root,
  dependent: verified_by_node(s: ^verified_by_child_symbol),
  kind: VerifiedBy,
  usage_site: verified_by_node(s: ^verified_by_child_symbol)
}

fn verified_by_in_frontier_claim_holds() -> Bool {
  dependency_in_lens_frontier(dependency: verified_by_dependency)
}

fn verified_by_in_frontier_claim_rhs() -> Node {
  if verified_by_in_frontier_claim_holds() {
    verified_by_root
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_verified_by_in_frontier: TestClaim = EqualsClaim {
  label: "lens_affected_set/verified_by_in_frontier: VerifiedBy in frontier",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: verified_by_root,
  rhs: verified_by_in_frontier_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}