module v2.test.lens_affected_set.closure_deep_chain


data closure_deep_chain_leaf: Node = claim_atom_node(s: ^closure_deep_chain_leaf_symbol)

data closure_deep_chain_n06: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^closure_deep_chain_n06_symbol } },
  children: [
    Edge { label: Named { name: ^closure_deep_chain_n06_edge_symbol }, target: closure_deep_chain_leaf }
  ],
  occurrence_id: SyntheticOccurrence
}

data closure_deep_chain_n05: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^closure_deep_chain_n05_symbol } },
  children: [
    Edge { label: Named { name: ^closure_deep_chain_n05_edge_symbol }, target: closure_deep_chain_n06 }
  ],
  occurrence_id: SyntheticOccurrence
}

data closure_deep_chain_n04: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^closure_deep_chain_n04_symbol } },
  children: [
    Edge { label: Named { name: ^closure_deep_chain_n04_edge_symbol }, target: closure_deep_chain_n05 }
  ],
  occurrence_id: SyntheticOccurrence
}

data closure_deep_chain_n03: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^closure_deep_chain_n03_symbol } },
  children: [
    Edge { label: Named { name: ^closure_deep_chain_n03_edge_symbol }, target: closure_deep_chain_n04 }
  ],
  occurrence_id: SyntheticOccurrence
}

data closure_deep_chain_n02: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^closure_deep_chain_n02_symbol } },
  children: [
    Edge { label: Named { name: ^closure_deep_chain_n02_edge_symbol }, target: closure_deep_chain_n03 }
  ],
  occurrence_id: SyntheticOccurrence
}

data closure_deep_chain_n01: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^closure_deep_chain_n01_symbol } },
  children: [
    Edge { label: Named { name: ^closure_deep_chain_n01_edge_symbol }, target: closure_deep_chain_n02 }
  ],
  occurrence_id: SyntheticOccurrence
}

data closure_deep_chain_root: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^closure_deep_chain_root_symbol } },
  children: [
    Edge { label: Named { name: ^closure_deep_chain_root_edge_symbol }, target: closure_deep_chain_n01 }
  ],
  occurrence_id: SyntheticOccurrence
}

data closure_deep_chain_vertex_count: Int = 8

data closure_deep_chain_dependency_reading: List<DependencyView> = dependency_lens(root: closure_deep_chain_root)

data closure_deep_chain_reverse_dependency_reading: List<DependencyView> = [
  DependencyView {
    source: closure_deep_chain_n06,
    dependent: closure_deep_chain_leaf,
    kind: Contains,
    usage_site: closure_deep_chain_leaf
  },
  DependencyView {
    source: closure_deep_chain_n05,
    dependent: closure_deep_chain_n06,
    kind: Contains,
    usage_site: closure_deep_chain_n06
  },
  DependencyView {
    source: closure_deep_chain_n04,
    dependent: closure_deep_chain_n05,
    kind: Contains,
    usage_site: closure_deep_chain_n05
  },
  DependencyView {
    source: closure_deep_chain_n03,
    dependent: closure_deep_chain_n04,
    kind: Contains,
    usage_site: closure_deep_chain_n04
  },
  DependencyView {
    source: closure_deep_chain_n02,
    dependent: closure_deep_chain_n03,
    kind: Contains,
    usage_site: closure_deep_chain_n03
  },
  DependencyView {
    source: closure_deep_chain_n01,
    dependent: closure_deep_chain_n02,
    kind: Contains,
    usage_site: closure_deep_chain_n02
  },
  DependencyView {
    source: closure_deep_chain_root,
    dependent: closure_deep_chain_n01,
    kind: Contains,
    usage_site: closure_deep_chain_n01
  }
]

fn closure_deep_chain_root_marks_leaf_holds() -> Bool {
  let closure = affected_set_closure(
    dependencies: closure_deep_chain_dependency_reading,
    edit_locus: closure_deep_chain_root
  )
  contains(
    xs: closure.frontier,
    item: closure_deep_chain_leaf,
    eq: fn(left, right) { left == right }
  )
    && (length(xs: closure.frontier) == closure_deep_chain_vertex_count)
}

fn closure_deep_chain_reverse_pass_order_marks_leaf_holds() -> Bool {
  let closure = affected_set_closure(
    dependencies: closure_deep_chain_reverse_dependency_reading,
    edit_locus: closure_deep_chain_root
  )
  contains(
    xs: closure.frontier,
    item: closure_deep_chain_leaf,
    eq: fn(left, right) { left == right }
  )
    && (length(xs: closure.frontier) == closure_deep_chain_vertex_count)
}

fn closure_deep_chain_claim_holds() -> Bool {
  closure_deep_chain_root_marks_leaf_holds()
    && closure_deep_chain_reverse_pass_order_marks_leaf_holds()
}

fn closure_deep_chain_claim_rhs() -> Node {
  if closure_deep_chain_claim_holds() {
    closure_deep_chain_root
  } else {
    affected_set_claim_failure_node
  }
}
