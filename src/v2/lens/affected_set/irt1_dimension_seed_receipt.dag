module v2.test.lens_affected_set.irt1_dimension_seed_receipt

import v2.lens.affected_set { DimensionNotRead, Excluded, ExclusionKey, FrontierDecision, Rerun, empty_frontier, mark_rerun }
import v2.lens.affected_set_examples {
  affected_set_claim_failure_node,
  affected_set_example_node
}
import v2.test.lens_affected_set.frontier_observation { frontier_decision_matches }
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}

data irt1_dimension_seed_key: ExclusionKey = ExclusionKey {
  at: affected_set_example_node,
  dimension: ^affected_set_example_dimension
}

data expected_irt1_dimension_seed_decision: FrontierDecision = Rerun

fn irt1_dimension_seed_receipt_claim_holds() -> Bool {
  frontier_decision_matches(
    frontier: mark_rerun(frontier: empty_frontier(), key: irt1_dimension_seed_key),
    key: irt1_dimension_seed_key,
    expected: expected_irt1_dimension_seed_decision
  )
}

data irt1_dimension_seed_wrong_decision: FrontierDecision = Excluded {
  first: DimensionNotRead {
    usage_site: affected_set_example_node,
    changed_dimension: ^affected_set_example_dimension
  },
  rest: []
}

fn irt1_dimension_seed_receipt_discriminates() -> Bool {
  frontier_decision_matches(
    frontier: mark_rerun(frontier: empty_frontier(), key: irt1_dimension_seed_key),
    key: irt1_dimension_seed_key,
    expected: irt1_dimension_seed_wrong_decision
  ) == false
}

fn irt1_dimension_seed_receipt_claim_rhs() -> Node {
  if irt1_dimension_seed_receipt_claim_holds() {
    affected_set_example_node
  } else {
    affected_set_claim_failure_node
  }
}

data claim_irt1_dimension_seed_receipt: TestClaim = EqualsClaim {
  label: "lens_affected_set/irt1_dimension_seed_receipt: changed dimension seeds rerun decision",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: affected_set_example_node,
  rhs: irt1_dimension_seed_receipt_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}