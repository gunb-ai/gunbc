module v2.test.lens_affected_set.frontier_observation


fn frontier_decision_matches(frontier: ReExecFrontier, key: ExclusionKey, expected: FrontierDecision) -> Bool {
  match frontier {
    ChangedSubgraphFrontier { boundary_exclusions: _, decisions: decisions } =>
      match map_get(decisions, key) {
        Accepted { value: opt, diagnostics: _ } =>
          match opt {
            Present { value: decision } => decision == expected
            Absent => false
          }
        Rejected { diagnostics: _ } => false
      }
    FailClosed { reason: _ } => false
  }
}
