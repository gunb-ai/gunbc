module v2.lens.affected_set.corpus_dependency_view

import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import v2.std.algebra { length }
import v2.std.collection { List }
import v2.std.dependency { DependencyView, append_dependency_views, dependency_lens }
import v2.std.fn_index { fn_arrow_decl_facts_live }
import v2.std.integer { Int }
import v2.std.text { String }

data corpus_dependency_view_measurement_note: String = "Phase-0 DependencyView build probe (lever-a slice 2). Folds dependency_lens over every FnArrowDecl in the resolved whole-tree context (fn_arrow_decl_facts_live) — the same whole-corpus substrate wiring_liveness uses. Production affected_set uses dependency_lens(root: InferredTree.root) once; whole-tree InferredTree root is gated on resolve grounding (#6239). This probe upper-bounds single-root fold cost by summing per-decl folds; dissolve-on: InferredTree.root lands, repoint probe at dependency_lens(root: tree.root) and delete the per-decl aggregation."

data corpus_dependency_view_resolve_budget_minutes: Int = 90

type CorpusDependencyViewResolvePhaseMark {
  frontend_done_ms: Int
  normalize_done_ms: Int
  reconcile_done_ms: Int
  view_build_done_ms: Int
}

type CorpusDependencyViewMeasurementVerdict
  = Completed { resolve_wall_ms: Int, view_build_wall_ms: Int, edge_count: Int, decl_count: Int }
  | WallPricedAbort {
      aborted_wall_ms: Int
      budget_minutes: Int
      phase_marks: CorpusDependencyViewResolvePhaseMark
      last_phase: String
    }

data corpus_dependency_view_measurement_receipt: CorpusDependencyViewMeasurementVerdict = WallPricedAbort {
  aborted_wall_ms: 3220703,
  budget_minutes: corpus_dependency_view_resolve_budget_minutes,
  phase_marks: CorpusDependencyViewResolvePhaseMark {
    frontend_done_ms: 4104,
    normalize_done_ms: 4677,
    reconcile_done_ms: 0,
    view_build_done_ms: 0
  },
  last_phase: "post_normalize_stuck_in_reconcile"
}

data corpus_dependency_view_per_pr_execution_gate: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "v2.lens.affected_set.corpus_dependency_view",
    decl_name: "corpus_dependency_views_live",
    field: WholeDeclaration
  }
}

data corpus_dependency_view_per_pr_execution_gate_note: String = "Per-PR DependencyView execution (compile-clean scoping + floor witness entry_file_touched axis over live corpus) is blocked-on-#6239 on-carrier: fn_arrow_decl_facts_live / whole-tree InferredTree.root require strict whole-tree resolve (~77m compile wall, operator lane). The query swap (entry_selection) is NOT wall-gated — only its per-PR execution. Receipt: corpus_dependency_view_measurement_receipt = WallPricedAbort @3220703ms with phase marks through normalize; reconcile never completed. Dissolve-on: #6239 lands, delete this gate row and re-run measure_dependency_view_build under the 90m cap."

fn corpus_dependency_views_live() -> List<DependencyView> {
  fold(fn_arrow_decl_facts_live(), init: [], f: fn(acc, decl) {
    append_dependency_views(
      left: acc,
      right: dependency_lens(root: decl.output)
    )
  })
}

fn corpus_dependency_view_edge_count() -> Int {
  length(xs: corpus_dependency_views_live())
}

fn corpus_dependency_view_decl_count() -> Int {
  length(xs: fn_arrow_decl_facts_live())
}
