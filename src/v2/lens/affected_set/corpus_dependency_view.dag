module v2.lens.affected_set.corpus_dependency_view


data corpus_dependency_view_resolve_budget: std.measure.Minute = std.measure.minute(count: 90)

type CorpusDependencyViewResolvePhaseMark {
  frontend_done: std.measure.Millisecond
  normalize_done: std.measure.Millisecond
  reconcile_done: std.measure.Millisecond
  view_build_done: std.measure.Millisecond
}

type CorpusDependencyViewMeasurementVerdict
  = Completed {
      resolve_wall: std.measure.Millisecond,
      view_build_wall: std.measure.Millisecond,
      edge_count: Int,
      decl_count: Int
    }
  | WallPricedAbort {
      aborted_wall: std.measure.Millisecond
      budget: std.measure.Minute
      phase_marks: CorpusDependencyViewResolvePhaseMark
      last_phase: String
    }

data corpus_dependency_view_measurement_receipt: CorpusDependencyViewMeasurementVerdict = WallPricedAbort {
  aborted_wall: std.measure.millisecond(count: 3220703),
  budget: corpus_dependency_view_resolve_budget,
  phase_marks: CorpusDependencyViewResolvePhaseMark {
    frontend_done: std.measure.millisecond(count: 4104),
    normalize_done: std.measure.millisecond(count: 4677),
    reconcile_done: std.measure.millisecond(count: 0),
    view_build_done: std.measure.millisecond(count: 0)
  },
  last_phase: "post_normalize_stuck_in_reconcile"
}

data corpus_dependency_view_per_pr_execution_gate: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "v2.lens.affected_set.corpus_dependency_view",
    decl_name: "corpus_dependency_views_live",
    field: std.decl_ref.WholeDeclaration
  }
}

fn corpus_dependency_view_per_pr_substrate_ready() -> Bool {
  v2.std.fn_index.fn_arrow_decl_substrate_is_whole_tree()
}

fn corpus_dependency_view_per_pr_substrate_refuse() -> Bool {
  corpus_dependency_view_per_pr_substrate_refuse()
}

fn ensure_corpus_dependency_view_per_pr_substrate() -> Bool {
  if corpus_dependency_view_per_pr_substrate_ready() {
    true
  } else {
    corpus_dependency_view_per_pr_substrate_refuse()
  }
}

fn corpus_dependency_views_live() -> List<v2.std.dependency.DependencyView> {
  let _ready = ensure_corpus_dependency_view_per_pr_substrate()
  fold(v2.std.fn_index.fn_arrow_decl_facts_live(), init: [], f: fn(acc, decl) {
    v2.std.dependency.append_dependency_views(
      left: acc,
      right: v2.std.dependency.dependency_lens(root: decl.output)
    )
  })
}

fn corpus_dependency_view_edge_count() -> Int {
  v2.std.algebra.length(xs: corpus_dependency_views_live())
}

fn corpus_dependency_view_decl_count() -> Int {
  v2.std.algebra.length(xs: v2.std.fn_index.fn_arrow_decl_facts_live())
}
