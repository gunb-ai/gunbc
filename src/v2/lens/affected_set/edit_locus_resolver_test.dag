module v2.test.lens_affected_set.edit_locus_resolver



data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly
data edit_locus_path_src_v4_affected_set: RepoPath = "src/v2/lens/affected_set.dag"
data edit_locus_path_source_producer_fixture: RepoPath = "src/v2/lens/affected_set/source_producer_fixture.dag"
data edit_locus_path_unknown: RepoPath = "src/v2/lens/unknown_path.dag"
data edit_locus_pattern_v4_lens: PathRegex = edit_locus_pattern_v4_lens
data edit_locus_source_producer_fixture_source: Medium<String> = Medium { carried: "module edit.locus\nfn add(x:Int, y:Int) -> Int { x + y }", fidelity: Lossless }
data edit_locus_source_producer_add_fixture_source: Medium<String> = Medium { carried: "module edit.locus\nfn add(x:Int, y:Int) -> Int { x + y }", fidelity: Lossless }
data edit_locus_source_producer_malformed_source: Medium<String> = Medium { carried: "module edit.locus\nfn add(x:Int, y:Int) -> Int { x + ", fidelity: Lossless }
data edit_locus_source_producer_fixture_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^edit_locus_source_producer_fixture_artifact,
  file_path: edit_locus_path_source_producer_fixture
}

data edit_locus_source_producer_fixture_source_read: DagSourceReadWitness = DagSourceReadWitness {
  source: edit_locus_source_producer_fixture_source,
  artifact: edit_locus_source_producer_fixture_artifact,
  compilation_unit: ^edit_locus_source_producer_fixture_compilation_unit,
  source_root: V2Tree
}

data edit_locus_source_producer_add_fixture_source_read: DagSourceReadWitness = DagSourceReadWitness {
  source: edit_locus_source_producer_add_fixture_source,
  artifact: edit_locus_source_producer_fixture_artifact,
  compilation_unit: ^edit_locus_source_producer_fixture_compilation_unit,
  source_root: V2Tree
}

data edit_locus_source_producer_malformed_source_read: DagSourceReadWitness = DagSourceReadWitness {
  source: edit_locus_source_producer_malformed_source,
  artifact: edit_locus_source_producer_fixture_artifact,
  compilation_unit: ^edit_locus_source_producer_fixture_compilation_unit,
  source_root: V2Tree
}

data edit_locus_source_producer_git_diff: GitDiffNameOnly = GitDiffNameOnly {
  changed_paths: [edit_locus_path_source_producer_fixture]
}

fn edit_locus_fixture_path_regex_matches(changed: RepoPath, pattern: PathRegex) -> Bool {
  match pattern {
    edit_locus_pattern_v4_lens => changed == edit_locus_path_src_v4_affected_set
    _ => false
  }
}

data edit_locus_fixture_read: EditLocusRead = EditLocusRead {
  path_regex_matches: edit_locus_fixture_path_regex_matches
}

data edit_locus_v4_binding: EditLocusBinding = EditLocusBinding {
  pattern: edit_locus_pattern_v4_lens,
  locus: affected_set_mid
}

data edit_locus_narrow_git_diff: GitDiffNameOnly = GitDiffNameOnly {
  changed_paths: [edit_locus_path_src_v4_affected_set]
}

data edit_locus_unknown_git_diff: GitDiffNameOnly = GitDiffNameOnly {
  changed_paths: [edit_locus_path_unknown]
}

test fn edit_locus_narrow_resolution_holds() -> Bool {
  match resolve_edit_locus(
    read: edit_locus_fixture_read,
    git_diff: edit_locus_narrow_git_diff,
    bindings: [edit_locus_v4_binding]
  ) {
    Holds { value: locus } => locus == affected_set_mid
    Violates { diagnostic: _ } => false
  }
}

test fn edit_locus_fail_closed_holds() -> Bool {
  match resolve_edit_locus(
    read: edit_locus_fixture_read,
    git_diff: edit_locus_unknown_git_diff,
    bindings: [edit_locus_v4_binding]
  ) {
    Holds { value: _ } => false
    Violates { diagnostic: _ } => true
  }
}

fn edit_locus_affected_set_wire_holds() -> Bool {
  match affected_set_reading_from_git_diff(
    edit_read: edit_locus_fixture_read,
    graph: affected_set_claim_tree(),
    git_diff: edit_locus_narrow_git_diff,
    bindings: [edit_locus_v4_binding]
  ) {
    Holds { value: reading } =>
      (reading.edit_locus == affected_set_mid)
        && (length(xs: reading.affected) == 3)
        && (reading.dependencies == [affected_set_root_to_mid_frontier_dependency, affected_set_mid_to_leaf_frontier_dependency])
    Violates { diagnostic: _ } => false
  }
}

fn edit_locus_affected_set_wire_fail_closed_holds() -> Bool {
  match affected_set_reading_from_git_diff(
    edit_read: edit_locus_fixture_read,
    graph: affected_set_claim_tree(),
    git_diff: edit_locus_unknown_git_diff,
    bindings: [edit_locus_v4_binding]
  ) {
    Holds { value: _ } => false
    Violates { diagnostic: _ } => true
  }
}

fn edit_locus_occurrence_textual_file_eq(
  span_index: SpanIndex,
  id: OccurrenceId,
  file: Symbol
) -> Bool {
  match span_index_resolve_textual_locus(index: span_index, id: id) {
    Holds { value: locus } =>
      match locus {
        Textual { file: f, extent: _ } => f == file
        _ => false
      }
    Violates { diagnostic: _ } => false
  }
}

fn edit_locus_source_provenance_producer_holds() -> Bool {
  match source_ir_artifact_provenance(
    source_read: edit_locus_source_producer_fixture_source_read
  ) {
    Accepted { value: provenance, diagnostics: _ } =>
      match provenance.node.occurrence_id {
        MintedOccurrence { id: id } =>
          (provenance.artifact.file_path == edit_locus_path_source_producer_fixture)
            && well_formed(n: provenance.node)
            && edit_locus_occurrence_textual_file_eq(
              span_index: provenance.span_index,
              id: id,
              file: ^edit_locus_source_producer_fixture_compilation_unit
            )
        SyntheticOccurrence => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn edit_locus_source_provenance_node_eq(left: Node, right: Node) -> Bool {
  exact_structural_equality_zip_fold(source_facts: left, candidate: right)
}

fn edit_locus_source_provenance_affected_set_wire_holds() -> Bool {
  match source_ir_node_artifact_provenance(
    source_read: edit_locus_source_producer_add_fixture_source_read
  ) {
    Accepted { value: provenance, diagnostics: _ } =>
      let producer_graph = claim_inferred_tree(
        root: provenance.node,
        facts: claim_inferred_facts(
          type_symbol: ^edit_locus_source_producer_type_symbol,
          algebra_symbol: ^edit_locus_source_producer_algebra_symbol,
          descent_symbol: ^edit_locus_source_producer_descent_symbol,
        )
      )
      match affected_set_reading_from_git_diff_provenance(
        graph: producer_graph,
        git_diff: edit_locus_source_producer_git_diff,
        provenance: [provenance]
      ) {
        Holds { value: reading } =>
          (producer_graph.root == provenance.node)
            && (reading.edit_locus == producer_graph.root)
            && (count_equal(
              xs: reading.affected,
              item: producer_graph.root,
              eq: edit_locus_source_provenance_node_eq
            ) == 1)
        Violates { diagnostic: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn edit_locus_root_from_source_locus_holds(
  compilation_unit: Symbol,
  span_index: SpanIndex,
  root: Node
) -> Bool {
  match root.occurrence_id {
    MintedOccurrence { id: id } =>
      match span_index_resolve_textual_locus(index: span_index, id: id) {
        Holds { value: locus } =>
          match locus {
            Textual { file: f, extent: ByteRange { start: s, end: e } } =>
              (f == compilation_unit) && (s == 0) && (e > s)
            _ => false
          }
        Violates { diagnostic: _ } => false
      }
    SyntheticOccurrence => false
  }
}

fn edit_locus_source_provenance_parse_root_span_holds() -> Bool {
  match source_ir_artifact_provenance(
    source_read: edit_locus_source_producer_fixture_source_read
  ) {
    Accepted { value: provenance, diagnostics: _ } =>
      well_formed(n: provenance.node)
        && edit_locus_root_from_source_locus_holds(
          compilation_unit: ^edit_locus_source_producer_fixture_compilation_unit,
          span_index: provenance.span_index,
          root: provenance.node
        )
    Rejected { diagnostics: _ } => false
  }
}

fn edit_locus_source_provenance_producer_rejects_malformed_source_holds() -> Bool {
  match source_ir_node_artifact_provenance(
    source_read: edit_locus_source_producer_malformed_source_read
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

data edit_locus_narrow_resolution_claim_passes: Bool = edit_locus_narrow_resolution_holds()
data edit_locus_fail_closed_claim_passes: Bool = edit_locus_fail_closed_holds()
data edit_locus_affected_set_wire_claim_passes: Bool = edit_locus_affected_set_wire_holds()
data edit_locus_affected_set_wire_fail_closed_claim_passes: Bool = edit_locus_affected_set_wire_fail_closed_holds()
data edit_locus_source_provenance_affected_set_wire_claim_passes: Bool = edit_locus_source_provenance_affected_set_wire_holds()
data edit_locus_source_provenance_producer_rejects_malformed_source_claim_passes: Bool = edit_locus_source_provenance_producer_rejects_malformed_source_holds()

data edit_locus_narrow_resolution_holds_symbol: Symbol = edit_locus_narrow_resolution_holds

data unified_claim_edit_locus_narrow: UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v2/lens/affected_set/edit_locus_resolver_test.dag",
    function: edit_locus_narrow_resolution_holds
  }
}
