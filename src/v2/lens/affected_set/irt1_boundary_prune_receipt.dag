module v2.test.lens_affected_set.irt1_boundary_prune_receipt


fn irt1_boundary_prune_receipt_claim_holds() -> Bool {
  mark_boundary_excluded(
    frontier: empty_frontier(),
    edit: affected_set_example_edit,
    proof: UnchangedPureBoundary { content_hash: affected_set_example_hash }
  ) == expected_affected_set_boundary_prune
}

fn irt1_boundary_prune_receipt_claim_rhs() -> Node {
  if irt1_boundary_prune_receipt_claim_holds() {
    affected_set_example_node
  } else {
    affected_set_claim_failure_node
  }
}

data claim_irt1_boundary_prune_receipt: TestClaim = EqualsClaim {
  label: "lens_affected_set/irt1_boundary_prune_receipt: unchanged pure boundary excludes edit dimension",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: affected_set_example_node,
  rhs: irt1_boundary_prune_receipt_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
