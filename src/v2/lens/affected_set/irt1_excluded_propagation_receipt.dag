module v2.test.lens_affected_set.irt1_excluded_propagation_receipt

import v2.lens.affected_set { DimensionNotRead, Excluded, ExclusionKey, FrontierDecision, PropagationExclusionProof, empty_frontier, mark_excluded }
import v2.lens.affected_set_examples {
  affected_set_claim_failure_node,
  affected_set_example_node
}
import v2.test.lens_affected_set.frontier_observation { frontier_decision_matches }
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}

data irt1_excluded_propagation_key: ExclusionKey = ExclusionKey {
  at: affected_set_example_node,
  dimension: ^affected_set_example_dimension
}

data irt1_excluded_propagation_proof: PropagationExclusionProof = DimensionNotRead {
  usage_site: affected_set_example_node,
  changed_dimension: ^affected_set_example_dimension
}

data expected_irt1_excluded_propagation_decision: FrontierDecision = Excluded {
  first: irt1_excluded_propagation_proof,
  rest: [irt1_excluded_propagation_proof]
}

fn irt1_excluded_propagation_receipt_claim_holds() -> Bool {
  frontier_decision_matches(
    frontier: mark_excluded(
      frontier: mark_excluded(
        frontier: empty_frontier(),
        key: irt1_excluded_propagation_key,
        proof: irt1_excluded_propagation_proof
      ),
      key: irt1_excluded_propagation_key,
      proof: irt1_excluded_propagation_proof
    ),
    key: irt1_excluded_propagation_key,
    expected: expected_irt1_excluded_propagation_decision
  )
}

fn irt1_excluded_propagation_receipt_discriminates() -> Bool {
  frontier_decision_matches(
    frontier: mark_excluded(
      frontier: empty_frontier(),
      key: irt1_excluded_propagation_key,
      proof: irt1_excluded_propagation_proof
    ),
    key: irt1_excluded_propagation_key,
    expected: expected_irt1_excluded_propagation_decision
  ) == false
}

fn irt1_excluded_propagation_receipt_claim_rhs() -> Node {
  if irt1_excluded_propagation_receipt_claim_holds() {
    affected_set_example_node
  } else {
    affected_set_claim_failure_node
  }
}

data claim_irt1_excluded_propagation_receipt: TestClaim = EqualsClaim {
  label: "lens_affected_set/irt1_excluded_propagation_receipt: excluded dimensions propagate proof",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: affected_set_example_node,
  rhs: irt1_excluded_propagation_receipt_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
