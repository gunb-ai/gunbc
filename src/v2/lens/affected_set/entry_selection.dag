module v2.lens.affected_set.entry_selection

import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import v2.lens.affected_set.corpus_dependency_view {
  corpus_dependency_view_per_pr_substrate_ready,
  corpus_dependency_view_per_pr_substrate_refuse,
  corpus_dependency_views_live
}
import v2.lens.module_graph {
  module_declaration_facts_live,
  ModuleDeclarationFact,
  module_graph_exclude_substrings,
  path_matches_touched
}
import v2.std.algebra { any, contains, length, list_snoc_item }
import v2.std.collection { Absent, List, Optional, Present, optional_absent, optional_present }
import v2.std.dependency { DependencyView }
import v2.std.fn_index { FnArrowDecl, fn_arrow_decl_facts_live }
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.text { String, string_is_empty }
import v2.lens.affected_set { AffectedSetClosureAcc, affected_set_closure }

data entry_file_touched_grain_interim: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "v2.lens.affected_set.entry_selection",
    decl_name: "entry_affected_by_dependency_view",
    field: WholeDeclaration
  }
}

data entry_file_touched_grain_interim_note: String = "DECLARED #6335 PARTIAL UNWIND (operator fork (c), 2026-07-10): the CI floor's entry_file_touched channel no longer consumes entry_affected_by_dependency_view — it is regrounded on the module-graph import-closure relation (v2.lens.module_graph.entry_affected_by_touched_paths; host realization entry_file_touched_via_import_closure in cli_run.rs, certified against this lens by the module-grain receipt harness on real merged diffs). Receipts for the unwind: (1) the Rust wrapper's substrate-not-whole-tree arm silently returned touched=true for EVERY row whenever any entry file was touched — an absorbing fallback that labeled itself fail-closed (probe 2026-07-10: substrate_is_whole_tree=FALSE -> touched=true, would_skip=false with empty frontier and no fn edits, on a pristine main clone with an empty real diff); (2) this module's edit loci are decl.OUTPUT nodes, so a touched file's test fns put the shared Bool node in the locus set and file_paths_for_frontier_nodes (decl.output == node) marks every Bool-returning module affected — decl identity conflated with output type. The fn-arrow DependencyView machinery here STAYS as the decl-level candidate for this channel's grain only: compile-clean scoping regrounded onto the same module-graph import-closure authority 2026-07-16 (channel 2 of this fork — see tools.dag_compile_clean_scope compile_clean_scope_import_closure_reground_note), so no live channel consumes entry_affected_by_dependency_view today. Dissolve-on: the namespace-only resolution terminal step (import grammar deleted; deps derived from container.member references) — the closure query is edge-source-agnostic and survives, and the file-grain-vs-decl-grain choice for entry_file_touched RE-DECIDES then, with the decl-level path viable only once edit loci are decl-identity nodes, never output types."

fn string_eq(a: String, b: String) -> Bool {
  a == b
}

fn decl_belongs_to_module(decl: FnArrowDecl, module: String) -> Bool {
  starts_with(s: decl.qualified_name, prefix: concat(module, "."))
    || (decl.qualified_name == module)
}

fn module_path_for_decl(decl: FnArrowDecl, modules: List<ModuleDeclarationFact>) -> Optional<String> {
  let best_module = fold(modules, init: "", f: fn(best, fact) {
    if decl_belongs_to_module(decl: decl, module: fact.module) {
      if best == "" {
        fact.module
      } else if string_length(s: fact.module) > string_length(s: best) {
        fact.module
      } else {
        best
      }
    } else {
      best
    }
  })
  let best_path = fold(modules, init: "", f: fn(acc, fact) {
    if fact.module == best_module {
      fact.path
    } else {
      acc
    }
  })
  if string_is_empty(s: best_module) {
    optional_absent()
  } else {
    optional_present(value: best_path)
  }
}

fn path_excluded_by_substrings(path: String, exclude_substrings: List<String>) -> Bool {
  any(xs: exclude_substrings, predicate: fn(sub) { string_contains(s: path, pattern: sub) })
}

fn modules_matching_touched_path(
  pool_roots: List<String>,
  touched_path: String,
  exclude_substrings: List<String>
) -> List<ModuleDeclarationFact> {
  fold(
    module_declaration_facts_live(pool_roots: pool_roots),
    init: [],
    f: fn(acc, fact) {
      if path_excluded_by_substrings(path: fact.path, exclude_substrings: exclude_substrings) {
        acc
      } else if path_matches_touched(closure_path: fact.path, touched_path: touched_path) {
        concat(acc, [fact])
      } else {
        acc
      }
    }
  )
}

fn edit_locus_nodes_for_module(
  module: String,
  decls: List<FnArrowDecl>
) -> List<Node> {
  fold(decls, init: [], f: fn(acc, decl) {
    if decl_belongs_to_module(decl: decl, module: module) {
      list_snoc_item(xs: acc, item: decl.output)
    } else {
      acc
    }
  })
}

fn edit_locus_nodes_for_touched_path(
  pool_roots: List<String>,
  touched_path: String,
  exclude_substrings: List<String>
) -> List<Node> {
  let decls = fn_arrow_decl_facts_live()
  fold(
    modules_matching_touched_path(
      pool_roots: pool_roots,
      touched_path: touched_path,
      exclude_substrings: exclude_substrings
    ),
    init: [],
    f: fn(acc, fact) {
      fold(
        edit_locus_nodes_for_module(module: fact.module, decls: decls),
        init: acc,
        f: fn(nodes, node) {
          if contains(xs: nodes, item: node, eq: fn(left, right) { left == right }) {
            nodes
          } else {
            list_snoc_item(xs: nodes, item: node)
          }
        }
      )
    }
  )
}

fn merge_frontier_nodes(acc: List<Node>, more: List<Node>) -> List<Node> {
  fold(more, init: acc, f: fn(nodes, node) {
    if contains(xs: nodes, item: node, eq: fn(left, right) { left == right }) {
      nodes
    } else {
      list_snoc_item(xs: nodes, item: node)
    }
  })
}

fn affected_frontier_for_edit_loci(
  dependencies: List<DependencyView>,
  edit_loci: List<Node>
) -> List<Node> {
  fold(edit_loci, init: [], f: fn(frontier, locus) {
    merge_frontier_nodes(
      acc: frontier,
      more: affected_set_closure(dependencies: dependencies, edit_locus: locus).frontier
    )
  })
}

fn file_paths_for_frontier_nodes(
  frontier: List<Node>,
  pool_roots: List<String>,
  exclude_substrings: List<String>
) -> List<String> {
  let decls = fn_arrow_decl_facts_live()
  let modules = module_declaration_facts_live(pool_roots: pool_roots)
  fold(frontier, init: [], f: fn(paths, node) {
    fold(decls, init: paths, f: fn(acc, decl) {
      if decl.output == node {
        match module_path_for_decl(decl: decl, modules: modules) {
          Present { value: path } =>
            if path_excluded_by_substrings(path: path, exclude_substrings: exclude_substrings) {
              acc
            } else if contains(xs: acc, item: path, eq: string_eq) {
              acc
            } else {
              list_snoc_item(xs: acc, item: path)
            }
          Absent => acc
        }
      } else {
        acc
      }
    })
  })
}

fn affected_file_paths_for_touched_paths(
  pool_roots: List<String>,
  touched_paths: List<String>,
  exclude_substrings: List<String>
) -> List<String> {
  let dependencies = corpus_dependency_views_live()
  let frontier = fold(touched_paths, init: [], f: fn(acc, touched_path) {
    merge_frontier_nodes(
      acc: acc,
      more: edit_locus_nodes_for_touched_path(
        pool_roots: pool_roots,
        touched_path: touched_path,
        exclude_substrings: exclude_substrings
      )
    )
  })
  let rerun_frontier = affected_frontier_for_edit_loci(
    dependencies: dependencies,
    edit_loci: frontier
  )
  file_paths_for_frontier_nodes(
    frontier: rerun_frontier,
    pool_roots: pool_roots,
    exclude_substrings: exclude_substrings
  )
}

fn entry_path_in_affected_file_paths(
  entry_path: String,
  affected_paths: List<String>
) -> Bool {
  any(xs: affected_paths, predicate: fn(path) {
    path_matches_touched(closure_path: path, touched_path: entry_path)
  })
}

fn entry_affected_by_dependency_view_excluding(
  entry_path: String,
  pool_roots: List<String>,
  touched_paths: List<String>,
  exclude_substrings: List<String>
) -> Bool {
  if path_excluded_by_substrings(path: entry_path, exclude_substrings: exclude_substrings) {
    false
  } else if corpus_dependency_view_per_pr_substrate_ready() {
    entry_path_in_affected_file_paths(
      entry_path: entry_path,
      affected_paths: affected_file_paths_for_touched_paths(
        pool_roots: pool_roots,
        touched_paths: touched_paths,
        exclude_substrings: exclude_substrings
      )
    )
  } else {
    corpus_dependency_view_per_pr_substrate_refuse()
  }
}

fn entry_affected_by_dependency_view(
  entry_path: String,
  pool_roots: List<String>,
  touched_paths: List<String>
) -> Bool {
  entry_affected_by_dependency_view_excluding(
    entry_path: entry_path,
    pool_roots: pool_roots,
    touched_paths: touched_paths,
    exclude_substrings: module_graph_exclude_substrings
  )
}
