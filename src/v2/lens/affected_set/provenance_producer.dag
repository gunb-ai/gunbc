module v2.test.lens_affected_set.provenance_producer

import extdeps.communication.medium { Lossless, Medium }
import v2.compiler.source_authority {
    DagSourceReadWitness,
  SourceRootIngest,
  node_artifact_provenance_from_source_root,
  source_root_provenance_coverage_receipt
}
import v2.extdeps.languages.dag { dag_mvp1_source_text }
import v2.lens.edit_locus {
  GitDiffNameOnly,
  RepoPath,
  affected_set_reading_from_git_diff_provenance
}
import v2.std.collection { List }
import v2.std.cross_tree.import_model { V2Tree }
import v2.std.artifact { Artifact, NodeArtifactProvenance, SourceFile }
import std.algebra { Cons, Empty }
import v2.std.algebra { contains, count_equal, for_all, length }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.exact_structural_equality_zip_fold_predicate {
  exact_structural_equality_zip_fold
}
import v2.std.logic { Bool }
import v2.std.node { Node, Symbol }
import v2.std.witness { Holds, Violates, Witness }
import v2.test.lens_affected_set.node_precision {
  affected_set_claim_tree,
  affected_set_leaf,
  affected_set_mid,
  affected_set_root
}
import v2.test.lens_common.infer_fixture {
  claim_inferred_facts,
  claim_inferred_tree
}

data provenance_producer_path_fixture: RepoPath = "src/v2/lens/affected_set/source_producer_fixture.dag"
data provenance_producer_path_mid: RepoPath = "src/v2/lens/affected_set.dag"
data provenance_producer_path_root: RepoPath = "src/v2/lens/affected_set_examples.dag"
data provenance_producer_path_unknown: RepoPath = "src/v2/lens/unknown_path.dag"

data provenance_producer_fixture_source: Medium<String> = Medium { carried: dag_mvp1_source_text, fidelity: Lossless }
data provenance_producer_malformed_source: Medium<String> = Medium { carried: "fn add(x:Int, y:Int) -> Int { x + ", fidelity: Lossless }

data provenance_producer_module_surface_source: Medium<String> = Medium { carried: "module edit.locus\nfn add(x:Int, y:Int) -> Int { x + y }", fidelity: Lossless }
data provenance_producer_fixture_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^provenance_producer_fixture_artifact,
  file_path: provenance_producer_path_fixture
}

data provenance_producer_fixture_source_read: DagSourceReadWitness = DagSourceReadWitness {
  source: provenance_producer_fixture_source,
  artifact: provenance_producer_fixture_artifact,
  compilation_unit: ^provenance_producer_compilation_unit,
  source_root: V2Tree
}

data provenance_producer_malformed_source_read: DagSourceReadWitness = DagSourceReadWitness {
  source: provenance_producer_malformed_source,
  artifact: provenance_producer_fixture_artifact,
  compilation_unit: ^provenance_producer_compilation_unit,
  source_root: V2Tree
}

data provenance_producer_module_surface_source_read: DagSourceReadWitness = DagSourceReadWitness {
  source: provenance_producer_module_surface_source,
  artifact: provenance_producer_fixture_artifact,
  compilation_unit: ^provenance_producer_compilation_unit,
  source_root: V2Tree
}

data provenance_producer_single_read_ingest: SourceRootIngest = [provenance_producer_fixture_source_read]

data provenance_producer_malformed_ingest: SourceRootIngest = [provenance_producer_malformed_source_read]

data provenance_producer_module_surface_ingest: SourceRootIngest = [provenance_producer_module_surface_source_read]

data provenance_producer_fixture_git_diff: GitDiffNameOnly = GitDiffNameOnly {
  changed_paths: [provenance_producer_path_fixture]
}

data provenance_producer_unknown_git_diff: GitDiffNameOnly = GitDiffNameOnly {
  changed_paths: [provenance_producer_path_unknown]
}

data provenance_producer_mid_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^provenance_producer_mid_artifact,
  file_path: provenance_producer_path_mid
}

data provenance_producer_root_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^provenance_producer_root_artifact,
  file_path: provenance_producer_path_root
}

data provenance_producer_mid_provenance: NodeArtifactProvenance = NodeArtifactProvenance {
  node: affected_set_mid,
  artifact: provenance_producer_mid_artifact
}

data provenance_producer_root_provenance: NodeArtifactProvenance = NodeArtifactProvenance {
  node: affected_set_root,
  artifact: provenance_producer_root_artifact
}

data provenance_producer_node_precision_provenance: List<NodeArtifactProvenance> = [
  provenance_producer_mid_provenance,
  provenance_producer_root_provenance
]

data provenance_producer_narrow_git_diff: GitDiffNameOnly = GitDiffNameOnly {
  changed_paths: [provenance_producer_path_mid]
}

data provenance_producer_wide_git_diff: GitDiffNameOnly = GitDiffNameOnly {
  changed_paths: [provenance_producer_path_root]
}

fn provenance_producer_node_eq(left: Node, right: Node) -> Bool {
  exact_structural_equality_zip_fold(source_facts: left, candidate: right)
}

fn provenance_producer_node_in_reading_affected(nodes: List<Node>, needle: Node) -> Bool {
  contains(
    xs: nodes,
    item: needle,
    eq: provenance_producer_node_eq
  )
}

fn provenance_producer_single_read_emits_row_holds() -> Bool {
  match node_artifact_provenance_from_source_root(ingest: provenance_producer_single_read_ingest) {
    Accepted { value: provenance, diagnostics: _ } =>
      length(xs: provenance) == 1
    Rejected { diagnostics: _ } => false
  }
}

fn provenance_producer_rejects_malformed_ingest_holds() -> Bool {
  match node_artifact_provenance_from_source_root(ingest: provenance_producer_malformed_ingest) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

fn provenance_producer_rejects_beyond_mvp1_surface_ingest_holds() -> Bool {
  match node_artifact_provenance_from_source_root(ingest: provenance_producer_module_surface_ingest) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

fn provenance_producer_parse_coverage_known_diff_fail_closed_holds() -> Bool {
  match node_artifact_provenance_from_source_root(ingest: provenance_producer_module_surface_ingest) {
    Accepted { value: provenance, diagnostics: _ } =>
      match affected_set_reading_from_git_diff_provenance(
        graph: affected_set_claim_tree(),
        git_diff: provenance_producer_fixture_git_diff,
        provenance: provenance
      ) {
        Holds { value: _ } => false
        Violates { diagnostic: _ } => true
      }
    Rejected { diagnostics: _ } => true
  }
}

fn provenance_producer_coverage_receipt_holds() -> Bool {
  match node_artifact_provenance_from_source_root(ingest: provenance_producer_single_read_ingest) {
    Accepted { value: provenance, diagnostics: _ } =>
      let receipt = source_root_provenance_coverage_receipt(
        ingest: provenance_producer_single_read_ingest,
        produced: provenance
      )
      receipt.coverage_complete
        && (receipt.ingest_read_count == 1)
        && (receipt.produced_row_count == 1)
    Rejected { diagnostics: _ } => false
  }
}

fn provenance_producer_git_diff_wire_holds() -> Bool {
  match node_artifact_provenance_from_source_root(ingest: provenance_producer_single_read_ingest) {
    Accepted { value: provenance, diagnostics: _ } =>
      match provenance {
        Cons { head: row, tail: _ } =>
          let producer_graph = claim_inferred_tree(
            root: row.node,
            facts: claim_inferred_facts(
              type_symbol: ^provenance_producer_type_symbol,
              algebra_symbol: ^provenance_producer_algebra_symbol,
              descent_symbol: ^provenance_producer_descent_symbol
            )
          )
          match affected_set_reading_from_git_diff_provenance(
            graph: producer_graph,
            git_diff: provenance_producer_fixture_git_diff,
            provenance: provenance
          ) {
            Holds { value: reading } =>
              (producer_graph.root == row.node)
                && (reading.edit_locus == producer_graph.root)
                && (count_equal(
                  xs: reading.affected,
                  item: producer_graph.root,
                  eq: provenance_producer_node_eq
                ) == 1)
            Violates { diagnostic: _ } => false
          }
        Empty => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn provenance_producer_unknown_diff_fail_closed_holds() -> Bool {
  match node_artifact_provenance_from_source_root(ingest: provenance_producer_single_read_ingest) {
    Accepted { value: provenance, diagnostics: _ } =>
      match affected_set_reading_from_git_diff_provenance(
        graph: affected_set_claim_tree(),
        git_diff: provenance_producer_unknown_git_diff,
        provenance: provenance
      ) {
        Holds { value: _ } => false
        Violates { diagnostic: _ } => true
      }
    Rejected { diagnostics: _ } => true
  }
}

fn provenance_producer_reading_from_provenance(
  git_diff: GitDiffNameOnly,
  provenance: List<NodeArtifactProvenance>
) -> Witness<List<Node>> {
  match affected_set_reading_from_git_diff_provenance(
    graph: affected_set_claim_tree(),
    git_diff: git_diff,
    provenance: provenance
  ) {
    Holds { value: reading } => Holds { value: reading.affected }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn provenance_producer_selectivity_superset_holds() -> Bool {
  match provenance_producer_reading_from_provenance(
    git_diff: provenance_producer_narrow_git_diff,
    provenance: provenance_producer_node_precision_provenance
  ) {
    Holds { value: narrow } =>
      match provenance_producer_reading_from_provenance(
        git_diff: provenance_producer_wide_git_diff,
        provenance: provenance_producer_node_precision_provenance
      ) {
        Holds { value: wide } =>
          for_all(xs: narrow, predicate: fn(node) {
            provenance_producer_node_in_reading_affected(nodes: wide, needle: node)
          })
        Violates { diagnostic: _ } => false
      }
    Violates { diagnostic: _ } => false
  }
}

fn provenance_producer_selectivity_superset_discriminates_holds() -> Bool {
  match affected_set_reading_from_git_diff_provenance(
    graph: affected_set_claim_tree(),
    git_diff: provenance_producer_narrow_git_diff,
    provenance: provenance_producer_node_precision_provenance
  ) {
    Holds { value: narrow } =>
      match affected_set_reading_from_git_diff_provenance(
        graph: affected_set_claim_tree(),
        git_diff: provenance_producer_wide_git_diff,
        provenance: provenance_producer_node_precision_provenance
      ) {
        Holds { value: wide } =>
          (narrow.edit_locus == affected_set_mid)
            && (wide.edit_locus == affected_set_root)
            && (length(xs: narrow.affected) == 3)
            && (length(xs: wide.affected) == 3)
        Violates { diagnostic: _ } => false
      }
    Violates { diagnostic: _ } => false
  }
}
