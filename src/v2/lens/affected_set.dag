module v2.lens.affected_set


type Dag = Node

type AffectedDimension = v2.std.node.Symbol

type ExclusionKey {
  at: v2.std.node.Node
  dimension: AffectedDimension
}

type EditDimension {
  edit: v2.std.node.Edit
  dimension: AffectedDimension
}

type ExclusionProof
  = EmptyDimensionDelta { subject: v2.std.node.Path }

type PropagationExclusionProof
  = DimensionNotRead { usage_site: v2.std.node.Node, changed_dimension: AffectedDimension }

type BoundaryExclusionProof
  = UnchangedPureBoundary { content_hash: v2.std.node.Hash }

type BoundaryExclusion {
  edit: v2.std.node.Edit
  proof: BoundaryExclusionProof
}

type FailClosedReason
  = ReasonSymbol { reason: v2.std.node.Symbol }
  | ReasonDiagnostics { diagnostics: v2.std.diagnostic.NonEmptyDiagnostics }

type FrontierDecision
  = Rerun
  | Excluded { first: PropagationExclusionProof, rest: List<PropagationExclusionProof> }

type ReExecFrontier
  = ChangedSubgraphFrontier {
      boundary_exclusions: List<BoundaryExclusion>,
      decisions: Map<ExclusionKey, FrontierDecision>
    }
  | FailClosed { reason: FailClosedReason }

type HashReceipt
  = HashUnchangedPure { content_hash: v2.std.node.Hash }
  | HashChanged
  | HashUnknown { reason: v2.std.node.Symbol }

type BoundaryReceipt
  = BoundaryPruned { proof: BoundaryExclusionProof }
  | BoundaryExpands
  | BoundaryUnknown { reason: v2.std.node.Symbol }

type ChangedDimensionReceipt
  = ChangedDimensions { first: AffectedDimension, rest: List<AffectedDimension> }
  | ChangedDimensionsUnknown { reason: v2.std.node.Symbol }

type PropagationReceipt
  = Propagates
  | DoesNotPropagate { proof: PropagationExclusionProof }
  | PropagationUnknown { reason: v2.std.node.Symbol }

type FrontierDependency {
  dependency: v2.std.dependency.DependencyView
  target: v2.std.change.DependencyEndpoint
}

type FrontierReceipt
  = FrontierProduced { dependencies: List<FrontierDependency> }
  | FrontierUnknown { reason: v2.std.node.Symbol }
  | FrontierRejected { diagnostic: v2.std.diagnostic.Diagnostic }

type AffectedFrontierRead {
  proven_transitive_dependency_frontier: fn(Dag, EditDimension) -> FrontierReceipt
}

type AffectedBoundaryRead {
  boundary_hash_receipt: fn(Dag, Path, v2.std.node.Node) -> HashReceipt,
  changed_dimension_receipt: fn(Dag, Edit) -> ChangedDimensionReceipt
}

type AffectedSetRead {
  boundary: AffectedBoundaryRead
  frontier: AffectedFrontierRead,
  propagation_receipt: fn(Dag, EditDimension, DependencyView) -> PropagationReceipt
}

type AffectedPostEditDagRead {
  outcome: v2.std.diagnostic.Outcome<v2.std.node.Node>
}

type AffectedFoldAcc {
  dag: Dag
  frontier: ReExecFrontier
  pending: v2.std.diagnostic.Diagnostics
}

type AffectedSetFoldAcc
  = AffectedSetActive {
      dag: Dag,
      changes: v2.std.change.ChangeSet,
      affected: List<v2.std.change.AffectedDependency>,
      exclusions: List<v2.std.change.AffectedExclusion>
    }
  | AffectedSetFailed {
      changes: v2.std.change.ChangeSet,
      evidence: v2.std.change.AffectedSetEvidence
    }

type RerunNodeSet
  = RerunNodeSetProduced {
      nodes: List<v2.std.node.Node>
    }
  | RerunNodeSetFailClosed {
      evidence: v2.std.change.AffectedSetEvidence
    }

type AffectedSetReading {
  edit_locus: v2.std.node.Node
  affected: List<v2.std.node.Node>
  dependencies: List<FrontierDependency>
}

type AffectedSetClosureAcc {
  frontier: List<v2.std.node.Node>
  dependencies: List<FrontierDependency>
}

type AffectedSetClosureFixpointState {
  acc: AffectedSetClosureAcc
  stable: Bool
}

fn empty_frontier() -> ReExecFrontier {
  ChangedSubgraphFrontier {
    boundary_exclusions: [],
    decisions: empty_map()
  }
}

fn empty_affected_fold_acc(dag: Dag) -> AffectedFoldAcc {
  AffectedFoldAcc {
    dag: dag,
    frontier: empty_frontier(),
    pending: None
  }
}

fn empty_affected_set_fold_acc(dag: Dag) -> AffectedSetFoldAcc {
  AffectedSetActive {
    dag: dag,
    changes: v2.std.change.ChangeSet { changes: [] },
    affected: [],
    exclusions: []
  }
}

fn fold_pending(acc: AffectedFoldAcc, next: v2.std.diagnostic.Diagnostics) -> v2.std.diagnostic.Diagnostics {
  diagnostics_merge(outer: acc.pending, inner: next)
}

fn frontier_from_fold_acc(acc: AffectedFoldAcc) -> ReExecFrontier {
  match acc.pending {
    Some { diagnostics: nds } => FailClosed {
      reason: ReasonDiagnostics { diagnostics: nds }
    }
    None => acc.frontier
  }
}

fn lens_frontier_dependency_kinds() -> List<v2.std.dependency.DependencyKind> {
  [ProjectionDependsOn, VerifiedBy, Contains]
}

fn affected_set_boundary_pure_receipt_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^affected_set_boundary_pure_receipt_payload } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn affected_set_dimension_not_read_receipt_node(dimension: AffectedDimension) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: dimension } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn dependency_kind_in_lens_frontier_policy(kind: v2.std.dependency.DependencyKind) -> Bool {
  contains(
    xs: lens_frontier_dependency_kinds(),
    item: kind,
    eq: fn(left, right) { left == right }
  )
}

fn change_for_edit(edit: v2.std.node.Edit) -> v2.std.change.Change {
  v2.std.change.Change {
    kind: NodeChanged,
    subject: edit.replacement,
    at: edit.at
  }
}

fn affected_set_from_fold_acc(acc: AffectedSetFoldAcc) -> v2.std.change.AffectedSet {
  match acc {
    AffectedSetActive { dag: _, changes: changes, affected: affected, exclusions: exclusions } =>
      v2.std.change.AffectedSetProduced {
        changes: changes,
        affected: affected,
        exclusions: exclusions,
        restricted_to: lens_frontier_dependency_kinds()
      }
    AffectedSetFailed { changes: changes, evidence: evidence } =>
      v2.std.change.AffectedSetFailClosed {
        changes: changes,
        evidence: evidence
      }
  }
}

fn append_change(changes: v2.std.change.ChangeSet, change: v2.std.change.Change) -> v2.std.change.ChangeSet {
  v2.std.change.ChangeSet {
    changes: list_snoc_item(xs: changes.changes, item: change)
  }
}

fn add_change_to_affected_acc(acc: AffectedSetFoldAcc, change: v2.std.change.Change) -> AffectedSetFoldAcc {
  match acc {
    AffectedSetActive { dag: dag, changes: changes, affected: affected, exclusions: exclusions } =>
      AffectedSetActive {
        dag: dag,
        changes: append_change(changes: changes, change: change),
        affected: affected,
        exclusions: exclusions
      }
    AffectedSetFailed { changes: changes, evidence: evidence } =>
      AffectedSetFailed {
        changes: append_change(changes: changes, change: change),
        evidence: evidence
      }
  }
}

fn record_affected_dependency(
  acc: AffectedSetFoldAcc,
  change: v2.std.change.Change,
  dependency: v2.std.dependency.DependencyView,
  target: v2.std.change.DependencyEndpoint
) -> AffectedSetFoldAcc {
  match acc {
    AffectedSetActive { dag: dag, changes: changes, affected: affected, exclusions: exclusions } =>
      if dependency_in_lens_frontier(dependency: dependency) {
        AffectedSetActive {
          dag: dag,
          changes: changes,
          affected: list_snoc_item(xs: affected, item: v2.std.change.AffectedDependency {
              change: change,
              dependency: dependency,
              target: target
            }),
          exclusions: exclusions
        }
      } else {
        AffectedSetActive {
          dag: dag,
          changes: changes,
          affected: affected,
          exclusions: exclusions
        }
      }
    AffectedSetFailed { changes: changes, evidence: evidence } =>
      AffectedSetFailed {
        changes: changes,
        evidence: evidence
      }
  }
}

fn dependency_in_lens_frontier(dependency: v2.std.dependency.DependencyView) -> Bool {
  dependency_kind_in_lens_frontier_policy(kind: dependency.kind)
}

fn node_in_list(nodes: List<v2.std.node.Node>, needle: v2.std.node.Node) -> Bool {
  fold(nodes, init: false, f: fn(found, node) {
    found || (node == needle)
  })
}

fn affected_set_closure_step(acc: AffectedSetClosureAcc, dependency: v2.std.dependency.DependencyView) -> AffectedSetClosureAcc {
  if node_in_list(nodes: acc.frontier, needle: dependency.source) && (node_in_list(nodes: acc.frontier, needle: dependency.dependent) == false) {
    AffectedSetClosureAcc {
      frontier: list_snoc_item(xs: acc.frontier, item: dependency.dependent),
      dependencies: list_snoc_item(xs: acc.dependencies, item: FrontierDependency {
          dependency: dependency,
          target: DependencyDependent
        })
    }
  } else if dependency_in_lens_frontier(dependency: dependency) && node_in_list(nodes: acc.frontier, needle: dependency.dependent) && (node_in_list(nodes: acc.frontier, needle: dependency.source) == false) {
    AffectedSetClosureAcc {
      frontier: list_snoc_item(xs: acc.frontier, item: dependency.source),
      dependencies: list_snoc_item(xs: acc.dependencies, item: FrontierDependency {
          dependency: dependency,
          target: DependencySource
        })
    }
  } else {
    acc
  }
}

fn affected_set_closure_pass(dependencies: List<v2.std.dependency.DependencyView>, acc: AffectedSetClosureAcc) -> AffectedSetClosureAcc {
  fold(
    dependencies,
    init: acc,
    f: fn(acc, dependency) {
      affected_set_closure_step(acc: acc, dependency: dependency)
    }
  )
}

fn affected_set_closure_frontier_unchanged(
  before: AffectedSetClosureAcc,
  after: AffectedSetClosureAcc
) -> Bool {
  length(xs: before.frontier) == length(xs: after.frontier)
}

fn affected_set_closure_convergence_rounds(dependencies: List<v2.std.dependency.DependencyView>) -> List<v2.std.dependency.DependencyView> {
  list_append(left: dependencies, right: dependencies)
}

fn affected_set_closure_fixpoint_step(
  dependencies: List<v2.std.dependency.DependencyView>,
  state: AffectedSetClosureFixpointState
) -> AffectedSetClosureFixpointState {
  if state.stable {
    state
  } else {
    let next_acc = affected_set_closure_pass(dependencies: dependencies, acc: state.acc)
    AffectedSetClosureFixpointState {
      acc: next_acc,
      stable: affected_set_closure_frontier_unchanged(before: state.acc, after: next_acc)
    }
  }
}

fn affected_set_closure(dependencies: List<v2.std.dependency.DependencyView>, edit_locus: v2.std.node.Node) -> AffectedSetClosureAcc {
  let state = fold(
    affected_set_closure_convergence_rounds(dependencies: dependencies),
    init: AffectedSetClosureFixpointState {
      acc: AffectedSetClosureAcc {
        frontier: [edit_locus],
        dependencies: []
      },
      stable: false
    },
    f: fn(state, _) {
      affected_set_closure_fixpoint_step(dependencies: dependencies, state: state)
    }
  )
  state.acc
}

fn affected_set_reading(graph: v2.compiler.infer.InferredTree, edit_locus: v2.std.node.Node) -> AffectedSetReading {
  let dependency_reading = dependency_lens(root: graph.root)
  let closure = affected_set_closure(dependencies: dependency_reading, edit_locus: edit_locus)
  AffectedSetReading {
    edit_locus: edit_locus,
    affected: closure.frontier,
    dependencies: closure.dependencies
  }
}

fn append_changed_node_subjects(nodes: List<v2.std.node.Node>, changes: v2.std.change.ChangeSet) -> List<v2.std.node.Node> {
  fold(changes.changes, init: nodes, f: fn(acc, change) {
    list_snoc_item(xs: acc, item: change.subject)
  })
}

fn append_affected_dependency_nodes(nodes: List<v2.std.node.Node>, affected: List<v2.std.change.AffectedDependency>) -> List<v2.std.node.Node> {
  fold(affected, init: nodes, f: fn(acc, row) {
    list_snoc_item(
      xs: acc,
      item: dependency_endpoint_node(dependency: row.dependency, target: row.target)
    )
  })
}

fn affected_set_rerun_nodes(affected_set_value: v2.std.change.AffectedSet) -> RerunNodeSet {
  match affected_set_value {
    AffectedSetProduced { changes: changes, affected: affected, exclusions: _, restricted_to: _ } =>
      RerunNodeSetProduced {
        nodes: append_affected_dependency_nodes(
          nodes: append_changed_node_subjects(nodes: [], changes: changes),
          affected: affected
        )
      }
    AffectedSetFailClosed { changes: _, evidence: evidence } =>
      RerunNodeSetFailClosed {
        evidence: evidence
      }
  }
}

fn affected_set_reading_rerun_nodes(reading: AffectedSetReading) -> RerunNodeSet {
  RerunNodeSetProduced {
    nodes: reading.affected
  }
}

fn record_affected_exclusion(
  acc: AffectedSetFoldAcc,
  change: v2.std.change.Change,
  dependency: v2.std.dependency.DependencyView,
  proof: PropagationExclusionProof
) -> AffectedSetFoldAcc {
  match acc {
    AffectedSetActive { dag: dag, changes: changes, affected: affected, exclusions: exclusions } =>
      match proof {
        DimensionNotRead { usage_site: usage_site, changed_dimension: changed_dimension } =>
          AffectedSetActive {
            dag: dag,
            changes: changes,
            affected: affected,
            exclusions: list_snoc_item(xs: exclusions, item: v2.std.change.AffectedExclusion {
                change: change,
                dependency: dependency,
                usage_site: usage_site,
                changed_dimension: changed_dimension
              })
          }
      }
    AffectedSetFailed { changes: changes, evidence: evidence } =>
      AffectedSetFailed {
        changes: changes,
        evidence: evidence
      }
  }
}

fn fail_affected_set_with_reason(acc: AffectedSetFoldAcc, reason: v2.std.node.Symbol) -> AffectedSetFoldAcc {
  match acc {
    AffectedSetActive { dag: _, changes: changes, affected: _, exclusions: _ } =>
      AffectedSetFailed {
        changes: changes,
        evidence: v2.std.change.AffectedSetReason { reason: reason }
      }
    AffectedSetFailed { changes: changes, evidence: evidence } =>
      AffectedSetFailed {
        changes: changes,
        evidence: evidence
      }
  }
}

fn fail_affected_set_with_diagnostics(acc: AffectedSetFoldAcc, diagnostics: v2.std.diagnostic.NonEmptyDiagnostics) -> AffectedSetFoldAcc {
  match acc {
    AffectedSetActive { dag: _, changes: changes, affected: _, exclusions: _ } =>
      AffectedSetFailed {
        changes: changes,
        evidence: v2.std.change.AffectedSetDiagnostics { diagnostics: diagnostics }
      }
    AffectedSetFailed { changes: changes, evidence: evidence } =>
      AffectedSetFailed {
        changes: changes,
        evidence: evidence
      }
  }
}

fn root_key(subject: v2.std.node.Node, dimension: AffectedDimension) -> ExclusionKey {
  ExclusionKey {
    at: subject,
    dimension: dimension
  }
}

fn dependency_endpoint_node(dependency: v2.std.dependency.DependencyView, target: v2.std.change.DependencyEndpoint) -> v2.std.node.Node {
  match target {
    DependencySource => dependency.source
    DependencyDependent => dependency.dependent
  }
}

fn frontier_dependency_key(dependency: FrontierDependency, dimension: AffectedDimension) -> ExclusionKey {
  ExclusionKey {
    at: dependency_endpoint_node(
      dependency: dependency.dependency,
      target: dependency.target
    ),
    dimension: dimension
  }
}

fn mark_rerun(frontier: ReExecFrontier, key: ExclusionKey) -> ReExecFrontier {
  match frontier {
    FailClosed { reason: e } => FailClosed { reason: e }
    ChangedSubgraphFrontier { boundary_exclusions: boundary_exclusions, decisions: decisions } =>
      ChangedSubgraphFrontier {
        boundary_exclusions: boundary_exclusions,
        decisions: map_insert(decisions, key, Rerun)
      }
  }
}

fn mark_boundary_excluded(frontier: ReExecFrontier, edit: v2.std.node.Edit, proof: BoundaryExclusionProof) -> ReExecFrontier {
  match frontier {
    FailClosed { reason: e } => FailClosed { reason: e }
    ChangedSubgraphFrontier { boundary_exclusions: boundary_exclusions, decisions: decisions } =>
      ChangedSubgraphFrontier {
        boundary_exclusions: list_snoc_item(xs: boundary_exclusions, item: BoundaryExclusion { edit: edit, proof: proof }),
        decisions: decisions
      }
  }
}

fn mark_excluded(frontier: ReExecFrontier, key: ExclusionKey, proof: PropagationExclusionProof) -> ReExecFrontier {
  match frontier {
    FailClosed { reason: e } => FailClosed { reason: e }
    ChangedSubgraphFrontier { boundary_exclusions: boundary_exclusions, decisions: decisions } =>

      match map_get(decisions, key) {
        Accepted { value: opt, diagnostics: _ } => match opt {
          Present { value: decision } =>
            match decision {
              Rerun =>
                ChangedSubgraphFrontier {
                  boundary_exclusions: boundary_exclusions,
                  decisions: decisions
                }
              Excluded { first: first, rest: rest } =>
                ChangedSubgraphFrontier {
                  boundary_exclusions: boundary_exclusions,
                  decisions: map_insert(decisions, key, Excluded { first: first, rest: list_snoc_item(xs: rest, item: proof) })
                }
            }
          Absent =>
            ChangedSubgraphFrontier {
              boundary_exclusions: boundary_exclusions,
              decisions: map_insert(decisions, key, Excluded { first: proof, rest: [] })
            }
        }

        Rejected { diagnostics: d } => mark_whole_dag_diagnostics(diagnostics: d)
      }
  }
}

fn mark_whole_dag(reason: v2.std.node.Symbol) -> ReExecFrontier {
  FailClosed { reason: ReasonSymbol { reason: reason } }
}

fn mark_whole_dag_diagnostics(diagnostics: v2.std.diagnostic.NonEmptyDiagnostics) -> ReExecFrontier {
  FailClosed { reason: ReasonDiagnostics { diagnostics: diagnostics } }
}
fn mark_whole_dag_diagnostic(diagnostic: v2.std.diagnostic.Diagnostic) -> ReExecFrontier {
  mark_whole_dag_diagnostics(
    diagnostics: diagnostics_singleton(d: diagnostic)
  )
}

fn boundary_receipt(read_model: AffectedSetRead, dag: Dag, path: v2.std.node.Path, replacement: v2.std.node.Node) -> BoundaryReceipt {
  match read_model.boundary.boundary_hash_receipt(dag, path, replacement) {
    HashUnchangedPure { content_hash: h } =>
      BoundaryPruned {
        proof: UnchangedPureBoundary {
          content_hash: h
        }
      }
    HashChanged => BoundaryExpands
    HashUnknown { reason: r } => BoundaryUnknown { reason: r }
  }
}

fn frontier_receipt(
  read_model: AffectedSetRead,
  dag: Dag,
  edit: v2.std.node.Edit,
  dimension: AffectedDimension
) -> FrontierReceipt {
  read_model.frontier.proven_transitive_dependency_frontier(
    dag,
    EditDimension { edit: edit, dimension: dimension }
  )
}

fn propagation_receipt(
  read_model: AffectedSetRead,
  dag: Dag,
  edit: v2.std.node.Edit,
  dimension: AffectedDimension,
  dependency: v2.std.dependency.DependencyView
) -> PropagationReceipt {
  read_model.propagation_receipt(
    dag,
    EditDimension { edit: edit, dimension: dimension },
    dependency
  )
}

fn expand_dimension(
  read_model: AffectedSetRead,
  dag: Dag,
  frontier: ReExecFrontier,
  edit: v2.std.node.Edit,
  dimension: AffectedDimension
) -> ReExecFrontier {
  match frontier {
    FailClosed { reason: e } => FailClosed { reason: e }
    ChangedSubgraphFrontier { boundary_exclusions: _, decisions: _ } =>
      match frontier_receipt(read_model: read_model, dag: dag, edit: edit, dimension: dimension) {
        FrontierProduced { dependencies: dependencies } =>
          fold(dependencies, init: frontier, f: fn(acc2, frontier_dependency) {
            match acc2 {
              FailClosed { reason: e } => FailClosed { reason: e }
              ChangedSubgraphFrontier { boundary_exclusions: _, decisions: _ } =>
                match propagation_receipt(
                  read_model: read_model,
                  dag: dag,
                  edit: edit,
                  dimension: dimension,
                  dependency: frontier_dependency.dependency
                ) {
                  Propagates =>
                    mark_rerun(frontier: acc2, key: frontier_dependency_key(dependency: frontier_dependency, dimension: dimension))
                  DoesNotPropagate { proof: p } =>
                    mark_excluded(frontier: acc2, key: frontier_dependency_key(dependency: frontier_dependency, dimension: dimension), proof: p)
                  PropagationUnknown { reason: r } =>
                    mark_whole_dag(reason: r)
                }
            }
          })
        FrontierUnknown { reason: r } =>
          mark_whole_dag(reason: r)
        FrontierRejected { diagnostic: d } =>
          mark_whole_dag_diagnostic(diagnostic: d)
      }
  }
}

fn seed_edit_fold_acc_live(
  read_model: AffectedSetRead,
  post_edit_dag: fn(Dag, Edit) -> AffectedPostEditDagRead,
  acc: AffectedFoldAcc,
  edit: v2.std.node.Edit
) -> AffectedFoldAcc {
  match boundary_receipt(
    read_model: read_model,
    dag: acc.dag,
    path: edit.at,
    replacement: edit.replacement
  ) {
    BoundaryPruned { proof: p } =>
      AffectedFoldAcc {
        dag: acc.dag,
        frontier: mark_boundary_excluded(frontier: acc.frontier, edit: edit, proof: p),
        pending: acc.pending
      }
    BoundaryExpands =>
      match post_edit_dag(acc.dag, edit).outcome {
        Accepted { value: next_dag, diagnostics: ad } =>
          AffectedFoldAcc {
            dag: next_dag,
            frontier: expand_changed_dimensions(
              read_model: read_model,
              boundary_dag: acc.dag,
              frontier_dag: next_dag,
              frontier: acc.frontier,
              edit: edit
            ),
            pending: fold_pending(acc: acc, next: ad)
          }
        Rejected { diagnostics: nds } =>
          AffectedFoldAcc {
            dag: acc.dag,
            frontier: mark_whole_dag_diagnostics(diagnostics: nds),
            pending: acc.pending
          }
      }
    BoundaryUnknown { reason: boundary_reason } =>
      match post_edit_dag(acc.dag, edit).outcome {
        Accepted { value: next_dag, diagnostics: ad } =>
          AffectedFoldAcc {
            dag: next_dag,
            frontier: mark_whole_dag(reason: boundary_reason),
            pending: fold_pending(acc: acc, next: ad)
          }
        Rejected { diagnostics: nds } =>
          AffectedFoldAcc {
            dag: acc.dag,
            frontier: mark_whole_dag_diagnostics(diagnostics: nds),
            pending: acc.pending
          }
      }
  }
}

fn expand_changed_dimensions(
  read_model: AffectedSetRead,
  boundary_dag: Dag,
  frontier_dag: Dag,
  frontier: ReExecFrontier,
  edit: v2.std.node.Edit
) -> ReExecFrontier {
  match read_model.boundary.changed_dimension_receipt(boundary_dag, edit) {
    ChangedDimensions { first: first_dimension, rest: rest_dimensions } =>
      fold(rest_dimensions, init: expand_dimension(
        read_model: read_model,
        dag: frontier_dag,
        frontier: mark_rerun(frontier: frontier, key: root_key(subject: edit.replacement, dimension: first_dimension)),
        edit: edit,
        dimension: first_dimension
      ), f: fn(acc2, dimension) {
        expand_dimension(
          read_model: read_model,
          dag: frontier_dag,
          frontier: mark_rerun(frontier: acc2, key: root_key(subject: edit.replacement, dimension: dimension)),
          edit: edit,
          dimension: dimension
        )
      })
    ChangedDimensionsUnknown { reason: r } =>
      mark_whole_dag(reason: r)
  }
}

fn seed_edit_fold_acc(
  read_model: AffectedSetRead,
  post_edit_dag: fn(Dag, Edit) -> AffectedPostEditDagRead,
  acc: AffectedFoldAcc,
  edit: v2.std.node.Edit
) -> AffectedFoldAcc {
  match acc.frontier {
    FailClosed { reason: _ } => acc
    ChangedSubgraphFrontier { boundary_exclusions: _, decisions: _ } =>
      seed_edit_fold_acc_live(
        read_model: read_model,
        post_edit_dag: post_edit_dag,
        acc: acc,
        edit: edit
      )
  }
}

fn expand_affected_dimension(
  read_model: AffectedSetRead,
  dag: Dag,
  acc: AffectedSetFoldAcc,
  edit: v2.std.node.Edit,
  dimension: AffectedDimension
) -> AffectedSetFoldAcc {
  match frontier_receipt(read_model: read_model, dag: dag, edit: edit, dimension: dimension) {
    FrontierProduced { dependencies: dependencies } =>
      fold(dependencies, init: acc, f: fn(acc2, frontier_dependency) {
        match propagation_receipt(
          read_model: read_model,
          dag: dag,
          edit: edit,
          dimension: dimension,
          dependency: frontier_dependency.dependency
        ) {
          Propagates =>
            record_affected_dependency(
              acc: acc2,
              change: change_for_edit(edit: edit),
              dependency: frontier_dependency.dependency,
              target: frontier_dependency.target
            )
          DoesNotPropagate { proof: p } =>
            record_affected_exclusion(
              acc: acc2,
              change: change_for_edit(edit: edit),
              dependency: frontier_dependency.dependency,
              proof: p
            )
          PropagationUnknown { reason: r } =>
            fail_affected_set_with_reason(acc: acc2, reason: r)
        }
      })
    FrontierUnknown { reason: r } =>
      fail_affected_set_with_reason(acc: acc, reason: r)
    FrontierRejected { diagnostic: d } =>
      fail_affected_set_with_diagnostics(
        acc: acc,
        diagnostics: diagnostics_singleton(d: d)
      )
  }
}

fn expand_affected_dimensions(
  read_model: AffectedSetRead,
  boundary_dag: Dag,
  frontier_dag: Dag,
  acc: AffectedSetFoldAcc,
  edit: v2.std.node.Edit
) -> AffectedSetFoldAcc {
  match read_model.boundary.changed_dimension_receipt(boundary_dag, edit) {
    ChangedDimensions { first: first_dimension, rest: rest_dimensions } =>
      fold(rest_dimensions, init: expand_affected_dimension(
        read_model: read_model,
        dag: frontier_dag,
        acc: acc,
        edit: edit,
        dimension: first_dimension
      ), f: fn(acc2, dimension) {
        expand_affected_dimension(
          read_model: read_model,
          dag: frontier_dag,
          acc: acc2,
          edit: edit,
          dimension: dimension
        )
      })
    ChangedDimensionsUnknown { reason: r } =>
      fail_affected_set_with_reason(acc: acc, reason: r)
  }
}

fn seed_affected_set_fold_acc_live(
  read_model: AffectedSetRead,
  post_edit_dag: fn(Dag, Edit) -> AffectedPostEditDagRead,
  acc: AffectedSetFoldAcc,
  edit: v2.std.node.Edit
) -> AffectedSetFoldAcc {
  let change = change_for_edit(edit: edit)
  match add_change_to_affected_acc(acc: acc, change: change) {
    AffectedSetFailed { changes: changes, evidence: evidence } =>
      AffectedSetFailed { changes: changes, evidence: evidence }
    AffectedSetActive {
      dag: active_dag,
      changes: active_changes,
      affected: active_affected,
      exclusions: active_exclusions
    } =>
      match boundary_receipt(
        read_model: read_model,
        dag: active_dag,
        path: edit.at,
        replacement: edit.replacement
      ) {
        BoundaryPruned { proof: _ } =>
          AffectedSetActive {
            dag: active_dag,
            changes: active_changes,
            affected: active_affected,
            exclusions: active_exclusions
        }
        BoundaryExpands =>
          match post_edit_dag(active_dag, edit).outcome {
            Accepted { value: next_dag, diagnostics: ad } =>
              match ad {
                Some { diagnostics: nds } =>
                  fail_affected_set_with_diagnostics(
                    acc: AffectedSetActive {
                      dag: next_dag,
                      changes: active_changes,
                      affected: active_affected,
                      exclusions: active_exclusions
                    },
                    diagnostics: nds
                  )
                None =>
                  expand_affected_dimensions(
                    read_model: read_model,
                    boundary_dag: active_dag,
                    frontier_dag: next_dag,
                    acc: AffectedSetActive {
                      dag: next_dag,
                      changes: active_changes,
                      affected: active_affected,
                      exclusions: active_exclusions
                    },
                    edit: edit
                  )
              }
            Rejected { diagnostics: nds } =>
              fail_affected_set_with_diagnostics(
                acc: AffectedSetActive {
                  dag: active_dag,
                  changes: active_changes,
                  affected: active_affected,
                  exclusions: active_exclusions
                },
                diagnostics: nds
              )
          }
        BoundaryUnknown { reason: r } =>
          fail_affected_set_with_reason(
            acc: AffectedSetActive {
              dag: active_dag,
              changes: active_changes,
              affected: active_affected,
              exclusions: active_exclusions
            },
            reason: r
          )
      }
  }
}

fn affected_set_from_diff(
  read_model: AffectedSetRead,
  post_edit_dag: fn(Dag, Edit) -> AffectedPostEditDagRead,
  dag: Dag,
  diff: v2.std.node.Diff
) -> Witness<v2.std.change.AffectedSet> {
  v2.std.witness.Holds {
    value: affected_set_from_fold_acc(
      acc: fold(diff.edits, init: empty_affected_set_fold_acc(dag: dag), f: fn(acc, edit) {
        seed_affected_set_fold_acc_live(
          read_model: read_model,
          post_edit_dag: post_edit_dag,
          acc: acc,
          edit: edit
        )
      })
    )
  }
}

fn re_exec_frontier_from_diff(
  read_model: AffectedSetRead,
  post_edit_dag: fn(Dag, Edit) -> AffectedPostEditDagRead,
  dag: Dag,
  diff: v2.std.node.Diff
) -> Witness<ReExecFrontier> {
  v2.std.witness.Holds {
    value: frontier_from_fold_acc(
      acc: fold(diff.edits, init: empty_affected_fold_acc(dag: dag), f: fn(acc, edit) {
        seed_edit_fold_acc(
          read_model: read_model,
          post_edit_dag: post_edit_dag,
          acc: acc,
          edit: edit
        )
      })
    )
  }
}

fn canonical_boundary_exclusion_receipt(node: v2.std.node.Node, h: v2.std.node.Hash) -> BoundaryReceipt {
  match find_child_by_name(root: node, name: ^affected_set_boundary_pure_receipt_edge) {
    Accepted { value: receipt, diagnostics: _ } =>
      if receipt == affected_set_boundary_pure_receipt_node() {
        BoundaryPruned {
          proof: UnchangedPureBoundary {
            content_hash: h
          }
        }
      } else {
        BoundaryUnknown { reason: ^affected_set_reason_boundary_purity_unproven }
      }
    Rejected { diagnostics: _ } =>
      BoundaryUnknown { reason: ^affected_set_reason_boundary_purity_unproven }
  }
}

fn canonical_boundary_hash_receipt(dag: Dag, path: v2.std.node.Path, replacement: v2.std.node.Node) -> HashReceipt {
  match subterm_at(root: dag, path: path) {
    Accepted { value: current, diagnostics: _ } =>
      if content_hash(n: current) == content_hash(n: replacement) {
        match canonical_boundary_exclusion_receipt(node: current, h: content_hash(n: current)) {
          BoundaryPruned { proof: UnchangedPureBoundary { content_hash: h } } =>
            HashUnchangedPure { content_hash: h }
          BoundaryUnknown { reason: r } =>
            HashUnknown { reason: r }
          BoundaryExpands =>
            HashChanged
        }
      } else {
        HashChanged
      }
    Rejected { diagnostics: _ } =>
      HashUnknown { reason: ^affected_set_reason_boundary_path_unresolved }
  }
}

fn connective_to_dimension_family(connective: v2.std.node.Connective) -> AffectedDimension {
  match connective {
    Atom { identity: identity } => identity
    Conj => ^canonical_tag_conj
    Disj => ^canonical_tag_disj
    Arrow => ^canonical_tag_arrow
    Cardinality => ^canonical_tag_cardinality
    Instantiation => ^canonical_tag_instantiation
  }
}

fn behavior_to_dimension_family(behavior: v2.std.node.Behavior) -> AffectedDimension {
  match behavior {
    Value => ^canonical_tag_value
    Transform => ^canonical_tag_transform
    Branch => ^canonical_tag_branch
    Loop => ^canonical_tag_loop
    Bind => ^canonical_tag_bind
    Match => ^canonical_tag_match
  }
}

fn node_root_dimension_family(node: v2.std.node.Node) -> List<AffectedDimension> {
  match node.kind {
    TypeNode { connective: connective } =>
      [connective_to_dimension_family(connective: connective)]
    ComputationNode { behavior: behavior } =>
      [behavior_to_dimension_family(behavior: behavior)]
  }
}

fn dimension_in_list(xs: List<AffectedDimension>, item: AffectedDimension) -> Bool {
  contains(xs: xs, item: item, eq: fn(left, right) { left == right })
}

fn union_dimension_into(acc: List<AffectedDimension>, dim: AffectedDimension) -> List<AffectedDimension> {
  if dimension_in_list(xs: acc, item: dim) {
    acc
  } else {
    list_snoc_item(xs: acc, item: dim)
  }
}

fn union_dimension_lists(left: List<AffectedDimension>, right: List<AffectedDimension>) -> List<AffectedDimension> {
  fold(right, init: left, f: fn(acc, dim) {
    union_dimension_into(acc: acc, dim: dim)
  })
}

fn list_to_changed_dimension_receipt(dims: List<AffectedDimension>) -> ChangedDimensionReceipt {
  match list_at_optional(xs: dims, index: 0) {
    Present { value: first } =>
      match list_tail(xs: dims) {
        TailFound { tail: rest } =>
          ChangedDimensions { first: first, rest: rest }
        TailAbsent =>
          ChangedDimensions { first: first, rest: [] }
      }
    Absent =>
      ChangedDimensionsUnknown { reason: ^affected_set_reason_changed_dimension_unresolved }
  }
}

fn changed_dimension_families_union(before: v2.std.node.Node, after: v2.std.node.Node) -> ChangedDimensionReceipt {
  if content_hash(n: before) == content_hash(n: after) {
    ChangedDimensionsUnknown { reason: ^affected_set_reason_changed_dimension_unresolved }
  } else {
    list_to_changed_dimension_receipt(
      dims: union_dimension_lists(
        left: node_root_dimension_family(node: before),
        right: node_root_dimension_family(node: after)
      )
    )
  }
}

fn canonical_changed_dimension_receipt(dag: Dag, edit: v2.std.node.Edit) -> ChangedDimensionReceipt {
  match subterm_at(root: dag, path: edit.at) {
    Accepted { value: current, diagnostics: _ } =>
      changed_dimension_families_union(before: current, after: edit.replacement)
    Rejected { diagnostics: _ } =>
      ChangedDimensionsUnknown { reason: ^affected_set_reason_changed_dimension_unresolved }
  }
}

fn canonical_ancestor_frame_dependencies(frame: v2.lens.application.AncestorFrame) -> FrontierReceipt {
  match find_child_by_name(root: frame.ancestor, name: frame.step) {
    Accepted { value: child, diagnostics: _ } =>
      FrontierProduced {
        dependencies: [
          FrontierDependency {
            dependency: v2.std.dependency.DependencyView {
              source: frame.ancestor,
              dependent: child,
              kind: Contains,
              usage_site: child
            },
            target: DependencySource
          }
        ]
      }
    Rejected { diagnostics: _ } =>
      FrontierUnknown { reason: ^affected_set_reason_frontier_ancestor_unresolved }
  }
}

fn frontier_dependency_from_dependency_view(dependency: v2.std.dependency.DependencyView) -> FrontierDependency {
  FrontierDependency {
    dependency: dependency,
    target: DependencyDependent
  }
}

fn frontier_dependencies_from_dependency_views(dependencies: List<v2.std.dependency.DependencyView>) -> List<FrontierDependency> {
  fold(dependencies, init: [], f: fn(acc, dependency) {
    list_snoc_item(
      xs: acc,
      item: frontier_dependency_from_dependency_view(dependency: dependency)
    )
  })
}

fn append_canonical_ancestor_dependencies(
  acc: FrontierReceipt,
  frame: v2.lens.application.AncestorFrame
) -> FrontierReceipt {
  match acc {
    FrontierProduced { dependencies: dependencies } =>
      match canonical_ancestor_frame_dependencies(frame: frame) {
        FrontierProduced { dependencies: frame_dependencies } =>
          FrontierProduced {
            dependencies: list_append(
              left: dependencies,
              right: frame_dependencies
            )
          }
        FrontierUnknown { reason: r } =>
          FrontierUnknown { reason: r }
        FrontierRejected { diagnostic: d } =>
          FrontierRejected { diagnostic: d }
      }
    FrontierUnknown { reason: r } =>
      FrontierUnknown { reason: r }
    FrontierRejected { diagnostic: d } =>
      FrontierRejected { diagnostic: d }
  }
}

fn canonical_ancestor_dependencies(frames: List<v2.lens.application.AncestorFrame>) -> FrontierReceipt {
  fold(frames, init: FrontierProduced { dependencies: [] }, f: fn(acc, frame) {
    append_canonical_ancestor_dependencies(acc: acc, frame: frame)
  })
}

fn canonical_region_dependencies(dag: Dag, walk: v2.lens.application.AncestorWalk) -> FrontierReceipt {
  match canonical_ancestor_dependencies(frames: walk.frames) {
    FrontierProduced { dependencies: _ } =>
      let closure = affected_set_closure(dependencies: dependency_lens(root: dag), edit_locus: walk.current)
      FrontierProduced {
        dependencies: closure.dependencies
      }
    FrontierUnknown { reason: r } =>
      FrontierUnknown { reason: r }
    FrontierRejected { diagnostic: d } =>
      FrontierRejected { diagnostic: d }
  }
}

fn canonical_transitive_frontier(dag: Dag, edit_dimension: EditDimension) -> FrontierReceipt {
  match collect_ancestor_frames(root: dag, steps: edit_dimension.edit.at.steps) {
    Accepted { value: walk, diagnostics: _ } =>
      canonical_region_dependencies(dag: dag, walk: walk)
    Rejected { diagnostics: _ } =>
      FrontierUnknown { reason: ^affected_set_reason_frontier_path_unresolved }
  }
}

fn canonical_propagation_receipt(
  dag: Dag,
  edit_dimension: EditDimension,
  dependency: v2.std.dependency.DependencyView
) -> PropagationReceipt {
  if dependency_in_lens_frontier(dependency: dependency) {
    Propagates
  } else {
    match find_child_by_name(root: dependency.usage_site, name: ^affected_set_dimension_not_read_receipt_edge) {
      Accepted { value: receipt, diagnostics: _ } =>
        if receipt == affected_set_dimension_not_read_receipt_node(dimension: edit_dimension.dimension) {
          DoesNotPropagate {
            proof: DimensionNotRead {
              usage_site: dependency.usage_site,
              changed_dimension: edit_dimension.dimension
            }
          }
        } else {
          Propagates
        }
      Rejected { diagnostics: _ } =>
      Propagates
    }
  }
}

fn canonical_affected_set_read() -> AffectedSetRead {
  AffectedSetRead {
    boundary: AffectedBoundaryRead {
      boundary_hash_receipt: canonical_boundary_hash_receipt,
      changed_dimension_receipt: canonical_changed_dimension_receipt
    },
    frontier: AffectedFrontierRead {
      proven_transitive_dependency_frontier: canonical_transitive_frontier
    },
    propagation_receipt: canonical_propagation_receipt
  }
}

fn canonical_post_edit_dag(dag: Dag, edit: v2.std.node.Edit) -> AffectedPostEditDagRead {
  AffectedPostEditDagRead {
    outcome: substitute_at(root: dag, path: edit.at, replacement: edit.replacement)
  }
}

fn affected_set(dag: Dag, diff: v2.std.node.Diff) -> Witness<ReExecFrontier> {
  re_exec_frontier_from_diff(
    read_model: canonical_affected_set_read(),
    post_edit_dag: canonical_post_edit_dag,
    dag: dag,
    diff: diff
  )
}

type RepoProcessKind
  = CiGateProcess
  | MetaProcessRole

type MetaProcessKind
  = AffectedSetLens
  | TestgenLens
  | CiScheduler
  | FloorRunner

type RepoProcess {
  kind: RepoProcessKind
  identity: v2.std.node.Symbol
}

type RepoProcessUniverse
  = UniverseComplete { processes: List<RepoProcess> }
  | UniverseIncomplete { uncovered_kind: v2.std.node.Symbol, reason: FailClosedReason }

data affected_set_reflect_gate_type: v2.std.node.Symbol = ^Gate
data affected_set_reflect_meta_process_kind_type: v2.std.node.Symbol = ^MetaProcessKind
data affected_set_reflect_repo_process_kind_type: v2.std.node.Symbol = ^RepoProcessKind

fn ci_gate_processes() -> List<RepoProcess> {
  fold(coproduct_arm_keys(type_name: affected_set_reflect_gate_type), init: [], f: fn(acc, key) {
    list_snoc_item(xs: acc, item: RepoProcess { kind: CiGateProcess, identity: key })
  })
}

fn meta_processes() -> List<RepoProcess> {
  fold(coproduct_arm_keys(type_name: affected_set_reflect_meta_process_kind_type), init: [], f: fn(acc, key) {
    list_snoc_item(xs: acc, item: RepoProcess { kind: MetaProcessRole, identity: key })
  })
}

fn universe_has_process_of_kind(processes: List<RepoProcess>, kind_key: v2.std.node.Symbol) -> Bool {
  fold(processes, init: false, f: fn(acc, p) {
    acc || (discriminant(v: p.kind) == kind_key)
  })
}

fn repo_process_universe_from(processes: List<RepoProcess>) -> RepoProcessUniverse {
  fold(
    coproduct_arm_keys(type_name: affected_set_reflect_repo_process_kind_type),
    init: UniverseComplete { processes: processes },
    f: fn(acc, kind_key) {
      match acc {
        UniverseIncomplete { uncovered_kind: k, reason: r } =>
          UniverseIncomplete { uncovered_kind: k, reason: r }
        UniverseComplete { processes: ps } =>
          if universe_has_process_of_kind(processes: ps, kind_key: kind_key) {
            UniverseComplete { processes: ps }
          } else {
            UniverseIncomplete {
              uncovered_kind: kind_key,
              reason: ReasonSymbol { reason: ^affected_set_reason_repo_process_universe_kind_uncovered }
            }
          }
      }
    }
  )
}

fn repo_process_universe() -> RepoProcessUniverse {
  repo_process_universe_from(
    processes: list_append(left: ci_gate_processes(), right: meta_processes())
  )
}

data construction_justification: v2.lens.common.construction_justification.ConstructionJustification = v2.lens.common.construction_justification.ConstructionJustification {
  class: v2.lens.common.construction_justification.WallAfterGrounding { dissolves_to: SingleAuthority }
}
