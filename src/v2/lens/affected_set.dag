// Scope: canonical affected-set authority for CI/incremental re-execution; fail-closed B-4/B-5 node frontier.
// Status: filled — re_exec_frontier_from_diff changed-subgraph fold; inline FailClosed absorption in seed_edit_fold_acc; CI node-precision closure via affected_set_from_diff.

module v2.lens.affected_set


import v2.std.collection { Absent, List, Map, Present, list_at_optional, map_get, map_insert }
import v2.std.algebra { TailAbsent, TailFound, contains, length, list_append, list_snoc_item, list_tail }
import v2.compiler.infer { InferredTree }
