module v2.lens.complexity_accumulator_copy.compile_gate


data compile_gate_law: String = "The accumulator-copy lens as a compile citizen (operator ruling 2026-07-13: a complexity violation FAILS COMPILATION, inheriting compile's affected-set scoping; the witness lane is the red control, never the enforcement). Gate semantics split the Finding coproduct on the suspect/refusal axis the lens already carries: a Poly2Suspect (proven copied-accumulator, DESIGN 6 bare-minimum-cost) REJECTS — the diagnostic is located at the finding node and the rejection tail carries the full finding ledger; Unclassifiable refusal causes are the undecidable residue and ride the Accepted diagnostics channel — typed per-cause, located, counted (the 5 stopped-line ledger), never gating and never silently dropped. Grain: this gate runs ONCE at the tree root (the lens is a rooted carrier-threading walk; running it per subtree node is O(n^2) — the enforcement of the complexity lens violating the complexity lens), so it enrolls in the root-grain required roster, not the per-node roster."

fn finding_diagnostic(f: v2.lens.complexity_accumulator_copy.Finding) -> v2.std.diagnostic.Diagnostic {
  match f {
    v2.lens.complexity_accumulator_copy.Poly2Suspect { at: n, cost: _ } =>
      v2.std.diagnostic.Diagnostic {
        reason: ^accumulator_copy_poly2_suspect,
        at: v2.std.diagnostic.node_locus(node: n),
        correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
      }
    v2.lens.complexity_accumulator_copy.Unclassifiable { at: n, cause: c } =>
      v2.std.diagnostic.Diagnostic {
        reason: c,
        at: v2.std.diagnostic.node_locus(node: n),
        correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
      }
  }
}

type GateLedger {
  suspects: List<v2.std.diagnostic.Diagnostic>
  refusals: List<v2.std.diagnostic.Diagnostic>
}

fn gate_ledger(findings: List<v2.lens.complexity_accumulator_copy.Finding>) -> GateLedger {
  let split = fold(
    findings,
    init: GateLedger { suspects: std.algebra.Empty, refusals: std.algebra.Empty },
    f: fn(acc, finding) {
      if v2.lens.complexity_accumulator_copy.analyze.finding_is_suspect(f: finding) {
        GateLedger {
          suspects: std.algebra.Cons { head: finding_diagnostic(f: finding), tail: acc.suspects },
          refusals: acc.refusals
        }
      } else {
        GateLedger {
          suspects: acc.suspects,
          refusals: std.algebra.Cons { head: finding_diagnostic(f: finding), tail: acc.refusals }
        }
      }
    }
  )
  GateLedger {
    suspects: v2.std.algebra.list_reverse(xs: split.suspects),
    refusals: v2.std.algebra.list_reverse(xs: split.refusals)
  }
}

fn accumulator_copy_compile_gate(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<Witness<v2.std.node.Node>> {
  let ledger = gate_ledger(findings: v2.lens.complexity_accumulator_copy.analyze.accumulator_copy_findings(root: node))
  match ledger.suspects {
    std.algebra.Cons { head: first, tail: rest } =>
      v2.std.diagnostic.Rejected {
        diagnostics: v2.std.diagnostic.NonEmptyDiagnostics {
          head: first,
          tail: fold(ledger.refusals, init: rest, f: fn(acc, d) {
            std.algebra.Cons { head: d, tail: acc }
          })
        }
      }
    std.algebra.Empty =>
      match ledger.refusals {
        std.algebra.Cons { head: first, tail: rest } =>
          v2.std.diagnostic.outcome_with_diagnostics(
            value: v2.std.witness.Holds { value: node },
            diagnostics: v2.std.diagnostic.Some {
              diagnostics: v2.std.diagnostic.NonEmptyDiagnostics { head: first, tail: rest }
            }
          )
        std.algebra.Empty => v2.std.diagnostic.outcome_accepted(value: v2.std.witness.Holds { value: node })
      }
  }
}

data construction_justification: v2.lens.common.construction_justification.ConstructionJustification = v2.lens.common.construction_justification.ConstructionJustification {
  class: v2.lens.common.construction_justification.WallAfterGrounding { dissolves_to: std.disposition.SubstrateMandatoryTag }
}
