module v2.lens.complexity_accumulator_copy.compile_gate


data compile_gate_law: String = "The accumulator-copy lens as a compile citizen (operator ruling 2026-07-13: a complexity violation FAILS COMPILATION, inheriting compile's affected-set scoping; the witness lane is the red control, never the enforcement). Gate semantics split the Finding coproduct on the suspect/refusal axis the lens already carries: a Poly2Suspect (proven copied-accumulator, DESIGN 6 bare-minimum-cost) REJECTS — the diagnostic is located at the finding node and the rejection tail carries the full finding ledger; Unclassifiable refusal causes are the undecidable residue and ride the Accepted diagnostics channel — typed per-cause, located, counted (the 5 stopped-line ledger), never gating and never silently dropped. Grain: this gate runs ONCE at the tree root (the lens is a rooted carrier-threading walk; running it per subtree node is O(n^2) — the enforcement of the complexity lens violating the complexity lens), so it enrolls in the root-grain required roster, not the per-node roster."

fn finding_diagnostic(f: Finding) -> Diagnostic {
  match f {
    Poly2Suspect { at: n, cost: _ } =>
      Diagnostic {
        reason: ^accumulator_copy_poly2_suspect,
        at: node_locus(node: n),
        correction: Unavailable { reason: ExternalContractUnknown }
      }
    Unclassifiable { at: n, cause: c } =>
      Diagnostic {
        reason: c,
        at: node_locus(node: n),
        correction: Unavailable { reason: ExternalContractUnknown }
      }
  }
}

type GateLedger {
  suspects: List<Diagnostic>
  refusals: List<Diagnostic>
}

fn gate_ledger(findings: List<Finding>) -> GateLedger {
  let split = fold(
    findings,
    init: GateLedger { suspects: Empty, refusals: Empty },
    f: fn(acc, finding) {
      if finding_is_suspect(f: finding) {
        GateLedger {
          suspects: Cons { head: finding_diagnostic(f: finding), tail: acc.suspects },
          refusals: acc.refusals
        }
      } else {
        GateLedger {
          suspects: acc.suspects,
          refusals: Cons { head: finding_diagnostic(f: finding), tail: acc.refusals }
        }
      }
    }
  )
  GateLedger {
    suspects: list_reverse(xs: split.suspects),
    refusals: list_reverse(xs: split.refusals)
  }
}

fn accumulator_copy_compile_gate(node: Node) -> Outcome<Witness<Node>> {
  let ledger = gate_ledger(findings: v2.lens.complexity_accumulator_copy.analyze.accumulator_copy_findings(root: node))
  match ledger.suspects {
    Cons { head: first, tail: rest } =>
      Rejected {
        diagnostics: NonEmptyDiagnostics {
          head: first,
          tail: fold(ledger.refusals, init: rest, f: fn(acc, d) {
            Cons { head: d, tail: acc }
          })
        }
      }
    Empty =>
      match ledger.refusals {
        Cons { head: first, tail: rest } =>
          outcome_with_diagnostics(
            value: Holds { value: node },
            diagnostics: Some {
              diagnostics: NonEmptyDiagnostics { head: first, tail: rest }
            }
          )
        Empty => outcome_accepted(value: Holds { value: node })
      }
  }
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SubstrateMandatoryTag }
}
