module v2.lens.complexity_accumulator_copy.analyze

import v2.lens.complexity_accumulator_copy {
  BindsComputed,
  BindsFresh,
  Finding,
  LetBinding,
  LetBindingFact,
  PortBareName,
  PortComputedExpression,
  PortMissing,
  PortPureLiteral,
  PortReading,
  Poly2Suspect,
  Unclassifiable,
  any_port_carries_carrier,
  classify_call,
  let_binding_fact_for,
  resolve_port_reading,
  symbol_in
}
import v2.extdeps.languages.dag {
  ParseSubtreeAbsent,
  ParseSubtreeFound,
  dag_lex_token_symbol,
  parse_production_captured_child_optional,
  parse_production_emitted_identity_optional,
  parse_subtree_find_production_captured
}
import std.algebra { Cons, Empty }
import v2.compiler.fold_lowering { fold_call_to_loop, fold_family_head }
import v2.std.algebra { list_append, list_map, list_reverse }
import v2.std.collection { Absent, List, Optional, Present }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.grammar { node_atom_identity_optional }
import v2.std.integer { Int }
import v2.std.logic { Bool }
import v2.std.node { Edge, Named, Node, Positional, Symbol, loop_carrier_binder_target }
import v2.std.node_query { find_named_child }

fn named_child_optional(cap: Node, name: Symbol) -> Optional<Node> {
  match find_named_child(root: cap, name: name) {
    Accepted { value: c, diagnostics: _ } => Present { value: c }
    Rejected { diagnostics: _ } => Absent
  }
}

fn sequence_left_node(cap: Node) -> Optional<Node> {
  named_child_optional(cap: cap, name: ^grammar_sequence_left_node_projection)
}

fn sequence_right_node(cap: Node) -> Optional<Node> {
  named_child_optional(cap: cap, name: ^grammar_sequence_right_node_projection)
}

fn sequence_left_symbol(cap: Node) -> Optional<Symbol> {
  match sequence_left_node(cap: cap) {
    Absent => Absent
    Present { value: left } => node_atom_identity_optional(node: left)
  }
}

fn find_capture(root: Node, emitted: Symbol) -> Optional<Node> {
  match parse_subtree_find_production_captured(root: root, emitted: emitted) {
    ParseSubtreeFound { captured: c } => Present { value: c }
    ParseSubtreeAbsent => Absent
  }
}

fn capture_list_prepend(item: Node, xs: List<Node>) -> List<Node> {
  Cons { head: item, tail: xs }
}

fn collect_direct_captures(n: Node, emitted: Symbol, acc: List<Node>) -> List<Node> {
  match parse_production_emitted_identity_optional(node: n) {
    Present { value: id } =>
      if id == emitted {
        match parse_production_captured_child_optional(node: n) {
          Present { value: c } => capture_list_prepend(item: c, xs: acc)
          Absent => acc
        }
      } else {
        fold(n.children, init: acc, f: fn(a, e) {
          collect_direct_captures(n: e.target, emitted: emitted, acc: a)
        })
      }
    Absent =>
      fold(n.children, init: acc, f: fn(a, e) {
        collect_direct_captures(n: e.target, emitted: emitted, acc: a)
      })
  }
}

fn primary_expr_capture(node: Node) -> Optional<Node> {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } =>
      if id == ^dag_surface_primary_expr {
        parse_production_captured_child_optional(node: node)
      } else {
        Absent
      }
    Absent => Absent
  }
}

fn edge_skips_identifier_count(e: Edge) -> Bool {
  match e.label {
    Named { name: nm } => nm == ^grammar_production_identity_node_projection
    Positional => false
  }
}

fn collect_value_identifiers_into(n: Node, acc: List<Symbol>) -> List<Symbol> {
  let here = match node_atom_identity_optional(node: n) {
    Present { value: id } =>
      if dag_lex_token_symbol(sym: id) { acc } else { Cons { head: id, tail: acc } }
    Absent => acc
  }
  fold(n.children, init: here, f: fn(a, e) {
    if edge_skips_identifier_count(e: e) {
      a
    } else {
      collect_value_identifiers_into(n: e.target, acc: a)
    }
  })
}

fn collect_value_identifiers(n: Node) -> List<Symbol> {
  collect_value_identifiers_into(n: n, acc: Empty)
}

fn arg_value_symbol(arg_capture: Node) -> Optional<Symbol> {
  match find_capture(root: arg_capture, emitted: ^dag_surface_primary_expr) {
    Absent => Absent
    Present { value: value_expr } => sequence_left_symbol(cap: value_expr)
  }
}

fn port_reading(arg_capture: Node) -> PortReading {
  let mentions = collect_value_identifiers(n: arg_capture)
  match mentions {
    Empty => PortPureLiteral
    Cons { head: _, tail: rest } =>
      match rest {
        Empty =>
          match arg_value_symbol(arg_capture: arg_capture) {
            Present { value: sym } => PortBareName { name: sym }
            Absent => PortComputedExpression { mentions: mentions }
          }
        Cons { head: _, tail: _ } => PortComputedExpression { mentions: mentions }
      }
  }
}

fn call_port_readings(call_capture: Node) -> List<PortReading> {
  list_map(
    xs: list_reverse(
      xs: collect_direct_captures(n: call_capture, emitted: ^dag_surface_arg, acc: Empty)
    ),
    f: fn(arg) { port_reading(arg_capture: arg) }
  )
}

data fold_family_carrier_note: String = "The carrier read is a named-edge lookup on the LOWERED seam Loop (FLAG F): the located fold call desugars via v2.compiler.fold_lowering.fold_call_to_loop and the accumulator binder is the ^loop_carrier_edge target's atom identity - the lens never re-navigates the surface fn_literal capture (that read has exactly one authority, the lowering). A call the seam refuses (named step fn, no fn literal) yields Absent and the ^fold_accumulator_unread refusal stands: the binder is a callee-resolution fact (Stage B), not a within-body fact, and the lens never fabricates a carrier."

fn fold_family_carrier(call_capture: Node) -> Optional<Symbol> {
  match fold_call_to_loop(fold_call: call_capture) {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: seam_loop, diagnostics: _ } =>
      match loop_carrier_binder_target(children: seam_loop.children) {
        Found { target: binder } => node_atom_identity_optional(node: binder)
        Ambiguous => Absent
        Absent => Absent
      }
  }
}

fn append_findings(fresh: List<Finding>, acc: List<Finding>) -> List<Finding> {
  list_append(left: fresh, right: acc)
}

fn let_expr_capture(node: Node) -> Optional<Node> {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } =>
      if id == ^dag_surface_let_expr {
        parse_production_captured_child_optional(node: node)
      } else {
        match parse_production_captured_child_optional(node: node) {
          Present { value: inner } => let_expr_capture(node: inner)
          Absent => Absent
        }
      }
    Absent => Absent
  }
}

type LetSpine {
  let_wrapper: Node
  let_capture: Node
  rest: Node
}

fn let_spine_of(node: Node) -> Optional<LetSpine> {
  match sequence_left_node(cap: node) {
    Absent => Absent
    Present { value: left } =>
      match let_expr_capture(node: left) {
        Absent => Absent
        Present { value: cap } =>
          match sequence_right_node(cap: node) {
            Absent => Absent
            Present { value: rest } =>
              Present { value: LetSpine { let_wrapper: left, let_capture: cap, rest: rest } }
          }
      }
  }
}

fn let_binder_symbol(let_capture: Node) -> Optional<Symbol> {
  match sequence_right_node(cap: let_capture) {
    Absent => Absent
    Present { value: after_kw } =>
      match sequence_left_node(cap: after_kw) {
        Absent => Absent
        Present { value: binder } => node_atom_identity_optional(node: binder)
      }
  }
}

fn let_rhs_node(let_capture: Node) -> Optional<Node> {
  match sequence_right_node(cap: let_capture) {
    Absent => Absent
    Present { value: after_kw } =>
      match sequence_right_node(cap: after_kw) {
        Absent => Absent
        Present { value: after_binder } => sequence_right_node(cap: after_binder)
      }
  }
}

type LetResolution
  = LetJoinsCarriers { name: Symbol }
  | LetBindsFact { binding: LetBinding }
  | LetUndecided

fn let_resolution(
  let_capture: Node,
  carriers: List<Symbol>,
  bindings: List<LetBinding>
) -> LetResolution {
  match let_binder_symbol(let_capture: let_capture) {
    Absent => LetUndecided
    Present { value: binder } =>
      match let_rhs_node(let_capture: let_capture) {
        Absent => LetUndecided
        Present { value: rhs } =>
          let mentions = collect_value_identifiers(n: rhs)
          match mentions {
            Empty => LetBindsFact { binding: LetBinding { name: binder, fact: BindsFresh } }
            Cons { head: _, tail: rest } =>
              match rest {
                Empty =>
                  match arg_value_symbol(arg_capture: rhs) {
                    Absent =>
                      LetBindsFact {
                        binding: LetBinding {
                          name: binder,
                          fact: BindsComputed {
                            mentions: substituted_mentions(raw: mentions, bindings: bindings)
                          }
                        }
                      }
                    Present { value: s } =>
                      if symbol_in(needle: s, xs: carriers) {
                        LetJoinsCarriers { name: binder }
                      } else {
                        match let_binding_fact_for(name: s, bindings: bindings) {
                          Present { value: fact } =>
                            LetBindsFact { binding: LetBinding { name: binder, fact: fact } }
                          Absent => LetUndecided
                        }
                      }
                  }
                Cons { head: _, tail: _ } =>
                  LetBindsFact {
                    binding: LetBinding {
                      name: binder,
                      fact: BindsComputed {
                        mentions: substituted_mentions(raw: mentions, bindings: bindings)
                      }
                    }
                  }
              }
          }
      }
  }
}

fn substituted_mentions(raw: List<Symbol>, bindings: List<LetBinding>) -> List<Symbol> {
  fold(raw, init: Empty, f: fn(acc, m) {
    match let_binding_fact_for(name: m, bindings: bindings) {
      Absent => Cons { head: m, tail: acc }
      Present { value: fact } =>
        match fact {
          BindsFresh => acc
          BindsComputed { mentions: ms } =>
            fold(ms, init: acc, f: fn(a2, s) { Cons { head: s, tail: a2 } })
        }
    }
  })
}

fn analyze_children(
  n: Node,
  carriers: List<Symbol>,
  bindings: List<LetBinding>,
  iterating: Bool,
  here: List<Finding>
) -> List<Finding> {
  fold(n.children, init: here, f: fn(acc, e) {
    append_findings(
      fresh: analyze(node: e.target, carriers: carriers, bindings: bindings, iterating: iterating),
      acc: acc
    )
  })
}

fn analyze_let_spine(
  spine: LetSpine,
  carriers: List<Symbol>,
  bindings: List<LetBinding>,
  iterating: Bool
) -> List<Finding> {
  let left_findings = analyze(
    node: spine.let_wrapper, carriers: carriers, bindings: bindings, iterating: iterating
  )
  match let_resolution(let_capture: spine.let_capture, carriers: carriers, bindings: bindings) {
    LetJoinsCarriers { name: nm } =>
      append_findings(
        fresh: analyze(
          node: spine.rest,
          carriers: Cons { head: nm, tail: carriers },
          bindings: bindings,
          iterating: iterating
        ),
        acc: left_findings
      )
    LetBindsFact { binding: b } =>
      append_findings(
        fresh: analyze(
          node: spine.rest,
          carriers: carriers,
          bindings: Cons { head: b, tail: bindings },
          iterating: iterating
        ),
        acc: left_findings
      )
    LetUndecided =>
      append_findings(
        fresh: analyze(
          node: spine.rest, carriers: carriers, bindings: bindings, iterating: iterating
        ),
        acc: left_findings
      )
  }
}

fn resolved_port_readings(call_capture: Node, bindings: List<LetBinding>) -> List<PortReading> {
  list_map(
    xs: call_port_readings(call_capture: call_capture),
    f: fn(reading) { resolve_port_reading(reading: reading, bindings: bindings) }
  )
}

fn analyze(node: Node, carriers: List<Symbol>, bindings: List<LetBinding>, iterating: Bool) -> List<Finding> {
  match primary_expr_capture(node: node) {
    Absent =>
      match let_spine_of(node: node) {
        Present { value: spine } =>
          analyze_let_spine(spine: spine, carriers: carriers, bindings: bindings, iterating: iterating)
        Absent =>
          analyze_children(n: node, carriers: carriers, bindings: bindings, iterating: iterating, here: Empty)
      }
    Present { value: cap } =>
      match sequence_left_symbol(cap: cap) {
        Present { value: head } =>
          if fold_family_head(sym: head) {
            match fold_family_carrier(call_capture: cap) {
              Present { value: carrier } =>
                analyze_children(
                  n: node,
                  carriers: Cons { head: carrier, tail: carriers },
                  bindings: bindings,
                  iterating: true,
                  here: Empty
                )
              Absent =>
                analyze_children(
                  n: node,
                  carriers: carriers,
                  bindings: bindings,
                  iterating: true,
                  here: Cons {
                    head: Unclassifiable { at: node, cause: ^fold_accumulator_unread },
                    tail: Empty
                  }
                )
            }
          } else {
            let here = if iterating {
              match classify_call(
                at: node,
                combiner: head,
                ports: resolved_port_readings(call_capture: cap, bindings: bindings),
                carriers: carriers
              ) {
                Present { value: f } => Cons { head: f, tail: Empty }
                Absent => Empty
              }
            } else {
              Empty
            }
            analyze_children(n: node, carriers: carriers, bindings: bindings, iterating: iterating, here: here)
          }
        Absent =>
          let here = if iterating {
            if any_port_carries_carrier(
              ports: resolved_port_readings(call_capture: cap, bindings: bindings),
              carriers: carriers
            ) {
              Cons {
                head: Unclassifiable { at: node, cause: ^call_head_unreadable },
                tail: Empty
              }
            } else {
              Empty
            }
          } else {
            Empty
          }
          analyze_children(n: node, carriers: carriers, bindings: bindings, iterating: iterating, here: here)
      }
  }
}

type AccumulatorCopyReport {
  folds_seen: Int,
  carriers_bound: Int,
  findings: List<Finding>
}

fn count_fold_sites(n: Node, bound_only: Bool) -> Int {
  let here = match primary_expr_capture(node: n) {
    Absent => 0
    Present { value: cap } =>
      match sequence_left_symbol(cap: cap) {
        Absent => 0
        Present { value: head } =>
          if fold_family_head(sym: head) {
            if bound_only {
              match fold_family_carrier(call_capture: cap) {
                Present { value: _ } => 1
                Absent => 0
              }
            } else {
              1
            }
          } else {
            0
          }
      }
  }
  fold(n.children, init: here, f: fn(acc, e) {
    acc + count_fold_sites(n: e.target, bound_only: bound_only)
  })
}

fn accumulator_copy_findings(root: Node) -> List<Finding> {
  analyze(node: root, carriers: Empty, bindings: Empty, iterating: false)
}

fn accumulator_copy_report(root: Node) -> AccumulatorCopyReport {
  AccumulatorCopyReport {
    folds_seen: count_fold_sites(n: root, bound_only: false),
    carriers_bound: count_fold_sites(n: root, bound_only: true),
    findings: accumulator_copy_findings(root: root)
  }
}

fn finding_is_suspect(f: Finding) -> Bool {
  match f {
    Poly2Suspect { at: _, cost: _ } => true
    Unclassifiable { at: _, cause: _ } => false
  }
}

fn finding_is_refusal(f: Finding) -> Bool {
  match f {
    Poly2Suspect { at: _, cost: _ } => false
    Unclassifiable { at: _, cause: _ } => true
  }
}

fn finding_refusal_cause(f: Finding) -> Optional<Symbol> {
  match f {
    Poly2Suspect { at: _, cost: _ } => Absent
    Unclassifiable { at: _, cause: c } => Present { value: c }
  }
}

fn findings_any(fs: List<Finding>, pred: fn(Finding) -> Bool) -> Bool {
  fold(fs, init: false, f: fn(acc, x) { if acc { true } else { pred(x) } })
}

fn findings_have_suspect(fs: List<Finding>) -> Bool {
  findings_any(fs: fs, pred: finding_is_suspect)
}

fn findings_have_refusal(fs: List<Finding>) -> Bool {
  findings_any(fs: fs, pred: finding_is_refusal)
}

fn findings_have_refusal_cause(fs: List<Finding>, cause: Symbol) -> Bool {
  findings_any(fs: fs, pred: fn(f) {
    match finding_refusal_cause(f: f) {
      Present { value: c } => c == cause
      Absent => false
    }
  })
}
