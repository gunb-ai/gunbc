module v2.lens.complexity_accumulator_copy.roster_gate

import extdeps.filesystem.filesystem_io
import v2.compiler.normalize { normalize }
import v2.compiler.parse { grammar_validate_for_parse, parse_production }
import v2.compiler.tokenize { tokenize }
import v2.lens.complexity_accumulator_copy.analyze { accumulator_copy_findings }
import v2.lens.common.source_analysis_standing {
  LanguageGrammarRejected,
  LanguageGrammarUnavailable,
  SourceAnalysisNotEstablishedCause,
  SourceNormalizationRejected,
  SourceParseRejected,
  SourceTokenizationRejected,
  SourceUnreadable
}

// Operator-ruled OFFLINE (NOT CI discovery-enrolled; witness_exclusion_substrings row
// claim/complexity/accumulator_copy_roster_gate in gunbc.ci_layer_roots — owned by #6452, not
// duplicated on #6440). Serial wet claim_batch only — do not codify GUNBC_EVAL_MEMO=0 in CI;
// diagnostic local runs may set it. Std tranche (PR #6440): claim_batch --source-root dag
// --source-root src/v2 --entry
// src/v2/test/claim/complexity/accumulator_copy_roster_gate_std_test.dag --function
// roster_std_change_dag_zero_suspects_within_ratchet --claim-run --wet. Prior roster carriers:
// accumulator_copy_roster_gate_test.dag, accumulator_copy_roster_gate_swift_test.dag,
// accumulator_copy_roster_gate_lean_bash_test.dag (same --claim-run --wet shape, per-test-fn
// entry/function).

type FindingStanding
  = NoSuspect
  | SuspectObserved { suspects: Int }
  | FindingNotEstablished { cause: SourceAnalysisNotEstablishedCause }

type AnalysisStanding
  = Within { refusals: Int, ceiling: Int }
  | RefusalBudgetExceeded { refusals: Int, ceiling: Int }
  | AnalysisNotEstablished { cause: SourceAnalysisNotEstablishedCause }

type RosterStanding {
  finding: FindingStanding
  analysis: AnalysisStanding
}

type SourceFindingsStanding
  = SourceFindingsEstablished { findings: List<Finding> }
  | SourceFindingsNotEstablished { cause: SourceAnalysisNotEstablishedCause }

// THE INGESTED TREE IS ITS OWN ANSWER, NOT A PRIVATE STEP OF THE FINDINGS FOLD. Two consumers want
// this chain -- the copied-accumulator findings below, and any lens that wants a real module's node
// tree instead of a hand-built fixture -- and forking the tokenize/validate/parse/normalize chain
// per consumer is the second representation section 3 forbids. source_findings is now one line over
// this, so the refusal causes cannot drift apart between them.
type SourceTreeStanding
  = SourceTreeEstablished { root: Node }
  | SourceTreeNotEstablished { cause: SourceAnalysisNotEstablishedCause }

fn source_tree(source_text: String) -> SourceTreeStanding {
  let lm = dag_language_model()
  let at = invariant_port_locus(port: ^accumulator_copy_roster_gate_port, invariant: ^accumulator_copy_source_analysis_invariant)
  match lm.grammar {
    VoidGrammar => SourceTreeNotEstablished { cause: LanguageGrammarUnavailable }
    ModeledGrammar { root: root } =>
      match grammar_validate_for_parse(root: root, at: at) {
        Rejected { diagnostics: _ } => SourceTreeNotEstablished { cause: LanguageGrammarRejected }
        Accepted { value: validated, diagnostics: _ } =>
          match tokenize(
            text: source_text,
            file: ^accumulator_copy_roster_subject,
            rules: lm.lex
          ) {
            Rejected { diagnostics: _ } => SourceTreeNotEstablished { cause: SourceTokenizationRejected }
            Accepted { value: stream, diagnostics: _ } =>
              match parse_production(
                tokens: token_stream_remaining(stream: stream),
                validated: validated,
                production_name: validated.root.start
              ) {
                Rejected { diagnostics: _ } => SourceTreeNotEstablished { cause: SourceParseRejected }
                Accepted { value: artifact, diagnostics: _ } =>
                  match normalize(parse_tree: artifact.tree) {
                    Rejected { diagnostics: _ } => SourceTreeNotEstablished { cause: SourceNormalizationRejected }
                    Accepted { value: tree, diagnostics: _ } =>
                      SourceTreeEstablished { root: tree.root }
                  }
              }
          }
      }
  }
}

fn findings_of_tree(standing: SourceTreeStanding) -> SourceFindingsStanding {
  match standing {
    SourceTreeNotEstablished { cause: cause } => SourceFindingsNotEstablished { cause: cause }
    SourceTreeEstablished { root: root } =>
      SourceFindingsEstablished { findings: accumulator_copy_findings(root: root) }
  }
}

fn source_findings(source_text: String) -> SourceFindingsStanding {
  v2.lens.complexity_accumulator_copy.roster_gate.findings_of_tree(
    standing: v2.lens.complexity_accumulator_copy.roster_gate.source_tree(source_text: source_text)
  )
}

// THE TYPED READ IS WRITTEN ONCE, HERE, AND BOTH PATH-TAKING CONSUMERS GO THROUGH IT. Duplicating
// it per consumer would let one of them keep the untyped spelling that made a missing file end the
// process instead of refusing.
fn ingest_tree(path: String) -> SourceTreeStanding {
  let read = Filesystem.Read(path: path)
  match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
    FilesystemReadRefused { error: _ } =>
      SourceTreeNotEstablished { cause: SourceUnreadable }
    FilesystemReadSucceeded { content: text } =>
      v2.lens.complexity_accumulator_copy.roster_gate.source_tree(source_text: text)
  }
}

fn ingest_findings(path: String) -> SourceFindingsStanding {
  v2.lens.complexity_accumulator_copy.roster_gate.findings_of_tree(
    standing: v2.lens.complexity_accumulator_copy.roster_gate.ingest_tree(path: path)
  )
}

fn count_matching(fs: List<Finding>, pred: fn(Finding) -> Bool) -> Int {
  fold_list(xs: fs, empty: 0, cons: fn(acc, f) {
    if pred(f) { acc + 1 } else { acc }
  })
}

fn standing_from_counts(suspects: Int, refusals: Int, refusal_ceiling: Int) -> RosterStanding {
  RosterStanding {
    finding: if suspects > 0 {
        SuspectObserved { suspects: suspects }
      } else {
        NoSuspect
      },
    analysis: if refusals > refusal_ceiling {
        RefusalBudgetExceeded { refusals: refusals, ceiling: refusal_ceiling }
      } else {
        Within { refusals: refusals, ceiling: refusal_ceiling }
      }
  }
}

fn not_established_standing(cause: SourceAnalysisNotEstablishedCause) -> RosterStanding {
  RosterStanding {
    finding: FindingNotEstablished { cause: cause },
    analysis: AnalysisNotEstablished { cause: cause }
  }
}

fn file_standing(path: String, refusal_ceiling: Int) -> RosterStanding {
  match v2.lens.complexity_accumulator_copy.roster_gate.ingest_findings(path: path) {
    SourceFindingsNotEstablished { cause: cause } => not_established_standing(cause: cause)
    SourceFindingsEstablished { findings: fs } => standing_from_counts(
      suspects: v2.lens.complexity_accumulator_copy.roster_gate.count_matching(fs: fs, pred: v2.lens.complexity_accumulator_copy.analyze.finding_is_suspect),
      refusals: v2.lens.complexity_accumulator_copy.roster_gate.count_matching(fs: fs, pred: v2.lens.complexity_accumulator_copy.analyze.finding_is_refusal),
      refusal_ceiling: refusal_ceiling
    )
  }
}

// WHAT THE GATE ANSWERED, NOT MERELY WHETHER IT HELD. The three arms below carry three different
// remedies and the Bool that used to stand here carried none of them: a suspect is a defect IN THE
// SUBJECT and the author edits the subject; an exceeded refusal budget is a coverage debt and the
// author raises the ceiling or grounds the refusals; a not-established standing is a defect in the
// INSTRUMENT'S REACH -- the lens could not read the file at all -- and the author fixes the lens or
// the path, never the subject. Collapsing all three onto `false` was total over the standing and
// blind one level down, with `cause: _` as the tell.
//
// The cause is not reconstructed here. file_standing already computes it and hands it over; what
// changed is that this fold stops discarding it.
type RosterGateDisposition
  = GateClean
  | GateSuspectObserved { suspects: Int }
  | GateRefusalBudgetExceeded { refusals: Int, ceiling: Int }
  | GateNotEstablished { cause: SourceAnalysisNotEstablishedCause }

fn roster_gate_disposition(standing: RosterStanding) -> RosterGateDisposition {
  match standing.finding {
    FindingNotEstablished { cause: cause } => GateNotEstablished { cause: cause }
    SuspectObserved { suspects: suspects } => GateSuspectObserved { suspects: suspects }
    NoSuspect =>
      match standing.analysis {
        AnalysisNotEstablished { cause: cause } => GateNotEstablished { cause: cause }
        RefusalBudgetExceeded { refusals: refusals, ceiling: ceiling } =>
          GateRefusalBudgetExceeded { refusals: refusals, ceiling: ceiling }
        Within { refusals: _, ceiling: _ } => GateClean
      }
  }
}

// RETAINED AS PROJECTIONS, NOT AS THE ONLY SURFACE (operator ruling, 2026-08-25). A Bool projection
// over a typed standing is a convenience and is legitimate exactly while the typed standing stays
// reachable by callers; it is the defect only when it is the sole surface and a caller has no way to
// tell cannot-analyze from analyzed-and-clean. RosterGateDisposition is that reachable surface, so
// these two stay.
fn finding_standing_holds(standing: FindingStanding) -> Bool {
  match standing {
    NoSuspect => true
    SuspectObserved { suspects: _ } => false
    FindingNotEstablished { cause: _ } => false
  }
}

fn analysis_standing_holds(standing: AnalysisStanding) -> Bool {
  match standing {
    Within { refusals: _, ceiling: _ } => true
    RefusalBudgetExceeded { refusals: _, ceiling: _ } => false
    AnalysisNotEstablished { cause: _ } => false
  }
}

fn file_gate_disposition(path: String, refusal_ceiling: Int) -> RosterGateDisposition {
  roster_gate_disposition(standing: file_standing(path: path, refusal_ceiling: refusal_ceiling))
}

// THE ONE PLACE THE COLLAPSE TO Bool IS ALLOWED TO HAPPEN, and it is written out so that a fourth
// disposition fails to compile HERE rather than inheriting whichever arm it lands beside. A caller
// that needs to tell an unreadable subject from a suspect one asks file_gate_disposition; this
// answers only "did the gate come back clean", which is a narrower question than it used to look.
fn file_gate(path: String, refusal_ceiling: Int) -> Bool {
  match file_gate_disposition(path: path, refusal_ceiling: refusal_ceiling) {
    GateClean => true
    GateSuspectObserved { suspects: _ } => false
    GateRefusalBudgetExceeded { refusals: _, ceiling: _ } => false
    GateNotEstablished { cause: _ } => false
  }
}

// REPLACES source_has_suspect, WHICH ANSWERED false FOR A SOURCE IT COULD NOT READ. source_findings
// returns the typed cause; the old predicate matched `SourceFindingsNotEstablished { cause: _ }` and
// threw it away, so an unreadable source was reported as the CLEAN verdict -- not a sentinel that a
// caller might check, but the affirmative answer "no suspect here".
fn source_finding_standing(source_text: String) -> FindingStanding {
  match v2.lens.complexity_accumulator_copy.roster_gate.source_findings(source_text: source_text) {
    SourceFindingsNotEstablished { cause: cause } => FindingNotEstablished { cause: cause }
    SourceFindingsEstablished { findings: fs } => {
      let suspects = v2.lens.complexity_accumulator_copy.roster_gate.count_matching(
        fs: fs,
        pred: v2.lens.complexity_accumulator_copy.analyze.finding_is_suspect
      )
      if suspects > 0 { SuspectObserved { suspects: suspects } } else { NoSuspect }
    }
  }
}
