module v2.test.lens_registry.sg_claims


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly
data lens_registry_v0_required_ids: List<v2.lens.registry.LensIdV0> = [
  ComplexityDerivedKernel,
  ComplexityOptimality,
  Cost,
  Parallelism,
  EffectEnumeration,
  EffectReach,
  Idempotency,
  Provenance,
  ProductionQualificationOriginProbe,
  UnusedParameters,
  StructuralResolution,
  CitedSymbolResolution,
  TableDecisionTree,
  v2.lens.registry.Determinism,
  ComplexityAccumulatorCopy,
  ComplexityLinearityAudit,
  FallbackArmCensus,
  v2.lens.registry.ComplexityLowering,
  v2.lens.registry.Coverage,
  DependencyFidelity,
  Discrimination,
  DispositionRedundancy,
  DocReachability,
  DuplicateComputation,
  MandatoryTag,
  ExtdepsShapeTransportPolicy,
  FactCardinality,
  FactDensity,
  FnFamily,
  v2.lens.registry.Grounding,
  HostLanguageTransportScript,
  IdenticalVariantPayload,
  InertCarrier,
  IntentLinearity,
  v2.lens.registry.InterfaceSummary,
  LanguagesConsumerCensus,
  LeafModelVerification,
  LifecycleCarrier,
  v2.lens.registry.LiveReadClassification,
  v2.lens.registry.MachineShape,
  MetaExecConfinement,
  MockTotality,
  MutationAdequacy,
  NonFoldResidue,
  RealizationVocabularyContainment,
  RosterRegistry,
  ScheduleLens,
  SimulatedRelationship,
  StructuralSimilarity,
  Subsumption,
  Synthesis,
  TestMigrationDebt,
  UnitModeling,
  Vacuity,
  Visibility,
  WiringLiveness,
  v2.lens.registry.WitnessCostLocality
]

test fn lens_registry_required_ids_resolve_holds() -> Bool {
  lens_registry_ids_resolve(lens_ids: lens_registry_v0_required_ids)
}

test fn lens_registry_singleton_row_counts_holds() -> Bool {
  lens_registry_row_count(lens_id: ComplexityDerivedKernel) == 1
    && lens_registry_bound_row_count(lens_id: ComplexityDerivedKernel) == 1
    && lens_registry_row_count(lens_id: ComplexityOptimality) == 1
    && lens_registry_bound_row_count(lens_id: ComplexityOptimality) == 1
    && lens_registry_id_resolves(lens_id: StructuralResolution)
    && lens_registry_id_resolves(lens_id: TableDecisionTree)
}
