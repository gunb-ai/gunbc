  v2.lens.registry.Visibility,
  v2.lens.registry.WiringLiveness,
  v2.lens.registry.WitnessCostLocality
]

test fn lens_registry_required_ids_resolve_holds() -> Bool {
  v2.lens.registry.lens_registry_ids_resolve(lens_ids: lens_registry_v0_required_ids)
}

test fn lens_registry_singleton_row_counts_holds() -> Bool {
  v2.lens.registry.lens_registry_row_count(lens_id: v2.lens.registry.ComplexityDerivedKernel) == 1
    && v2.lens.registry.lens_registry_bound_row_count(lens_id: v2.lens.registry.ComplexityDerivedKernel) == 1
    && v2.lens.registry.lens_registry_row_count(lens_id: v2.lens.registry.ComplexityOptimality) == 1
    && v2.lens.registry.lens_registry_bound_row_count(lens_id: v2.lens.registry.ComplexityOptimality) == 1
    && v2.lens.registry.lens_registry_id_resolves(lens_id: v2.lens.registry.StructuralResolution)
    && v2.lens.registry.lens_registry_id_resolves(lens_id: v2.lens.registry.TableDecisionTree)
}
