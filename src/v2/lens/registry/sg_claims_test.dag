module v2.test.lens_registry.sg_claims


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly
data lens_registry_v0_required_ids: List<v2.lens.registry.LensIdV0> = [
  v2.lens.registry.ComplexityDerivedKernel,
  v2.lens.registry.ComplexityOptimality,
  v2.lens.registry.Cost,
  v2.lens.registry.Parallelism,
  v2.lens.registry.EffectEnumeration,
  v2.lens.registry.EffectReach,
  v2.lens.registry.Idempotency,
  v2.lens.registry.Provenance,
  v2.lens.registry.ProductionQualificationOriginProbe,
  v2.lens.registry.UnusedParameters,
  v2.lens.registry.StructuralResolution,
  v2.lens.registry.CitedSymbolResolution,
  v2.lens.registry.TableDecisionTree,
  v2.lens.registry.Determinism,
  v2.lens.registry.ComplexityAccumulatorCopy,
  v2.lens.registry.ComplexityLinearityAudit,
  v2.lens.registry.FallbackArmCensus,
  v2.lens.registry.ComplexityLowering,
  v2.lens.registry.Coverage,
  v2.lens.registry.DependencyFidelity,
  v2.lens.registry.Discrimination,
  v2.lens.registry.DispositionRedundancy,
  v2.lens.registry.DocReachability,
  v2.lens.registry.DuplicateComputation,
  v2.lens.registry.MandatoryTag,
  v2.lens.registry.ExtdepsShapeTransportPolicy,
  v2.lens.registry.FactCardinality,
  v2.lens.registry.FactDensity,
  v2.lens.registry.FnFamily,
  v2.lens.registry.Grounding,
  v2.lens.registry.HostLanguageTransportScript,
  v2.lens.registry.IdenticalVariantPayload,
  v2.lens.registry.InertCarrier,
  v2.lens.registry.IntentLinearity,
  v2.lens.registry.InterfaceSummary,
  v2.lens.registry.LanguagesConsumerCensus,
  v2.lens.registry.LeafModelVerification,
  v2.lens.registry.LifecycleCarrier,
  v2.lens.registry.LiveReadClassification,
  v2.lens.registry.MachineShape,
  v2.lens.registry.MetaExecConfinement,
  v2.lens.registry.MockTotality,
  v2.lens.registry.MutationAdequacy,
  v2.lens.registry.NonFoldResidue,
  v2.lens.registry.RealizationVocabularyContainment,
  v2.lens.registry.RosterRegistry,
  v2.lens.registry.ScheduleLens,
  v2.lens.registry.SimulatedRelationship,
  v2.lens.registry.StructuralSimilarity,
