// THE TYPED-ARGV CONSTRUCTION CENSUS, AT IDENTITY GRAIN (debt paydown trial, brief of
// lively-ram-153 to witty-tern-54, 2026-10-03; grain widened by the same parent in reply:
// data-decl word lists are the same debt and are their own class in the same roster).
//
// One layer below the shell-to-dag census (gunbc.doc_graph_roots slug
// shell-to-dag-residual-census-and-arc-completion), which sees only shell-TEXT sites. This lens
// sees the layer beneath: command lines hand-assembled from string literals inside pure builders
// and word-list declarations, where `extdeps.exec.command`'s `ArgvCommand` (sole constructor,
// admitted builders only) is the typed form the corpus already owns.
//
// IT READS THE RAW PARSE TREE AS A TREE (DESIGN 6), never a normalized artifact and never a
// flattened atom stream: declaration parts are parent/child edges read by SYMBOL. Productions are
// matched by emitted identity (parse_production_emitted_identity_optional), declaration parts are
// read through the grammar's named edges (find_named_child on ^dag_surface_data_decl_name/_type/
// _expr, exactly the edges v2.extdeps.languages.dag emit_data_decl_emitted_node builds) and
// through the compiler's own spine decode for fn decls (kw-then-ident for the name, the same
// four-rights walk v2.compiler.body_lowering_fold body_lower_fn_decl_return_clause_optional uses
// for the return clause), and a subtree's spellings are collected as atom identities over
// v2.std.node node_subtree_nodes. No host builtin was added, and nothing here can change what the
// corpus compiles to.
//
// POPULATION, at identity grain (module_file, decl, decl_kind), split COUNTED vs CANDIDATE
// (classification by position, per the parent's correction of 2026-10-04):
//   COUNTED fn rows: a fn (or test fn) that accepts a List<String>-typed parameter or declares a
//       List<String> return — a word list crossing the builder boundary where ArgvCommand exists
//       — together with the "-"-prefixed string literals in its own body (flags glued at an argv
//       position);
//   COUNTED data rows: a List<String> data declaration whose "-"-prefixed literal elements reach
//       an argv position INSIDE THE SAME MODULE (its name appears in the body of a fn this lens
//       already counted as argv-typed);
//   CANDIDATE rows (reported, never counted as debt): the same prefix matches without position
//       evidence — a List<String> data declaration with "-"-prefixed elements whose name never
//       reaches an in-module argv-typed fn, or a "-"-prefixed literal in a fn that accepts and
//       returns no word list (bullet text, diff markers, prose).
//
// SITE CLASS: modules under dag/extdeps are extdeps interface builders; modules under dag/gunbc
// are workflow call sites. Both classes carry the same debt; only the paying shapes differ.
//
// THE ROSTER THAT MAY ONLY SHRINK is committed in dag.gunbc.instruments.argv_word_construction_census
// and joined through argv_word_construction_gates below: a COUNTED row whose site no longer
// resolves refuses the census (pay the debt, delete the row, same change); a live COUNTED member
// without a row refuses the census (new string-built argv is refused — adopt the typed form;
// DESIGN 5: the instrument joins at identity grain, a count is not an oracle).

data argv_word_construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SingleAuthority }
}

data argv_word_construction_batch_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: decl_ref(module_path: "v2.lens.argv_word_construction" as NonEmptyStr, decl_name: "argv_word_construction_batch_scaffold" as NonEmptyStr)
}

data argv_word_construction_dissolution: DissolutionCondition = unbound_dissolution(description: "the typed-argv roster over dag/extdeps and dag/gunbc is empty for a full recount AND every extdeps interface builder returns extdeps.exec.command ArgvCommand" as NonEmptyStr)

// ------------------------------------------------------------------ facts

// Which declaration kind a fact was read under.
type ArgvWordsDeclKind
  = FnDecl
  | DataDecl

// Everything the tree read about one declaration, before classification.
type ArgvWordsFact {
  decl: String
  decl_kind: ArgvWordsDeclKind
  counted: Bool
  flag_words: List<String>
  candidates: List<String>
  return_spelling: String
  returns_argv_words: Bool
  list_string_params: Int
  list_string_data: Bool
}

// A census member at identity grain: one row per (module_file, decl, decl_kind).
type ArgvWordsSite {
  module_file: String
  decl: String
  decl_kind: ArgvWordsDeclKind
  site_class: ArgvWordsSiteClass
  counted: Bool
  flag_words: List<String>
  candidates: List<String>
  returns_argv_words: Bool
  list_string_params: Int
  list_string_data: Bool
}

type ArgvWordsSiteClass
  = ExtdepsInterfaceBuilder
  | WorkflowCallSite

type ArgvWordsSites
  = ArgvWordsSitesEstablished { sites: List<ArgvWordsSite> }
  | ArgvWordsSitesRefused { reason: String }

// ------------------------------------------------------------------ the tree readers

// A production match is a SYMBOL match, never a string compare.
fn node_production_is(node: Node, want: Symbol) -> Bool {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } => id == want
    Absent => false
  }
}

// A node's own atom identity (the spelling an identifier or a string literal carries).
fn node_atom_lexeme(node: Node) -> Optional<String> {
  match node_atom_identity_optional(node: node) {
    Present { value: sym } => Present { value: symbol_lexeme(sym: sym) }
    Absent => Absent
  }
}

// Every atom identity in one subtree, in document order.
fn subtree_atom_symbols(n: Node) -> List<Symbol> {
  fold_list(xs: node_subtree_nodes(root: n), empty: Empty, cons: fn(acc, node) {
    match node_atom_identity_optional(node: node) {
      Present { value: sym } => Cons { head: sym, tail: acc }
      Absent => acc
    }
  })
}

fn atoms_contain_symbol(atoms: List<Symbol>, want: Symbol) -> Bool {
  fold_list(xs: atoms, empty: false, cons: fn(acc, s) { acc || (s == want) })
}

// List<String>, read from the type's own atoms: the head and the element type, whatever the
// bracket spellings. A deeper element List<List<String>> still contains both, and is still a
// word list at an argv position.
fn type_atoms_list_string(atoms: List<Symbol>) -> Bool {
  atoms_contain_symbol(atoms: atoms, want: ^List) && atoms_contain_symbol(atoms: atoms, want: ^String)
}

fn distinct_strings(xs: List<String>) -> List<String> {
  fold_list(xs: xs, empty: Empty, cons: fn(acc, s) {
    if contains(xs: acc, item: s, eq: str_eq_fn) { acc } else { Cons { head: s, tail: acc } }
  })
}

fn str_eq_fn(a: String, b: String) -> Bool {
  a == b
}

// The "-"-prefixed string-literal contents in one subtree: flag words and their cousins. The
// arrow token's spelling ("->") is excluded, and so are the grammar's own class-marker atoms
// (dag_token_* / dag_surface_*), which are production identities rather than source strings.
fn flag_contents_of_atoms(atoms: List<Symbol>) -> List<String> {
  distinct_strings(fold_list(xs: list_reverse(xs: atoms), empty: Empty, cons: fn(acc, s) {
    let lex = symbol_lexeme(sym: s)
    if starts_with(s: lex, prefix: "-") && !(lex == "->") && !starts_with(s: lex, prefix: "dag_") {
      Cons { head: lex, tail: acc }
    } else {
      acc
    }
  }))
}

// A type spelling rebuilt from its own atoms, for the receipt column.
fn type_spelling(atoms: List<Symbol>) -> String {
  fold_list(xs: list_reverse(xs: atoms), empty: "", cons: fn(acc, s) { concat(acc, symbol_lexeme(sym: s)) })
}

// A sequence node's right member, through the grammar's own projections, with the optional
// wrappers the parser leaves in place unwrapped (the compiler's body_lower spine decode).
fn deep_unwrap_optional(node: Node) -> Node {
  match find_named_child(root: node, name: ^grammar_optional_element_node_projection) {
    Accepted { value: child, diagnostics: _ } => deep_unwrap_optional(node: child)
    Rejected { diagnostics: _ } => node
  }
}

fn sequence_pair_optional(node: Node) -> Optional<SequencePair> {
  let unwrapped = deep_unwrap_optional(node: node)
  match find_named_child(root: unwrapped, name: ^grammar_sequence_left_node_projection) {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: left, diagnostics: _ } =>
      match find_named_child(root: unwrapped, name: ^grammar_sequence_right_node_projection) {
        Rejected { diagnostics: _ } => Absent
        Accepted { value: right, diagnostics: _ } => Present { value: SequencePair { left: left, right: right } }
      }
  }
}

type SequencePair {
  left: Node
  right: Node
}

fn spine_right(node: Node) -> Optional<Node> {
  match sequence_pair_optional(node: node) {
    Present { value: pair } => Present { value: pair.right }
    Absent => Absent
  }
}

// THE FN DECL NAME: the kw-then-ident decode the compiler itself uses (a test fn carries one more
// keyword, so its name sits one spine step deeper).
fn fn_decl_name(decl: Node, is_test: Bool) -> Optional<Symbol> {
  match parse_production_captured_child_optional(node: decl) {
    Absent => Absent
    Present { value: captured } =>
      match is_test {
        false => dag_surface_kw_then_ident_from_captured(captured: captured)
        true =>
          match dag_surface_kw_then_ident_rest_from_captured(captured: captured) {
            Absent => Absent
            Present { value: after_test_kw } => dag_surface_kw_then_ident_from_captured(captured: after_test_kw)
          }
      }
  }
}

// THE RETURN CLAUSE: the same four-rights walk v2.compiler.body_lowering_fold
// body_lower_fn_decl_return_clause_optional performs — kw_fn, name, generic params, params, then
// the arrow clause whose left member is the declared return type. Absent when the fn declares no
// return.
fn fn_decl_return_type(captured: Node) -> Optional<Node> {
  match spine_right(node: captured) {
    Absent => Absent
    Present { value: after_kw } =>
      match spine_right(node: after_kw) {
        Absent => Absent
        Present { value: after_name } =>
          match spine_right(node: after_name) {
            Absent => Absent
            Present { value: after_generics } =>
              match spine_right(node: after_generics) {
                Absent => Absent
                Present { value: after_params } =>
                  match sequence_pair_optional(node: after_params) {
                    Absent => Absent
                    Present { value: pair } =>
                      match find_named_child(root: pair.left, name: ^grammar_optional_element_node_projection) {
                        Accepted { value: inner, diagnostics: _ } => Present { value: inner }
                        Rejected { diagnostics: _ } => Present { value: pair.left }
                      }
                  }
              }
          }
      }
  }
}

// The params region: the grammar's own param_list production under the fn capture.
fn fn_decl_param_list(decl: Node) -> Optional<Node> {
  match parse_subtree_find_production_captured(root: decl, emitted: ^dag_surface_param_list) {
    ParseSubtreeFound { captured: c } => Present { value: c }
    ParseSubtreeAbsent => Absent
  }
}

// Every typed parameter under the params capture, as (name, type atoms) pairs. A typed parameter
// is Seq(binding, Seq(colon, Seq(type, tail))) — the shape dag_grammar_typed_param_head_expr
// builds — read through the projections, never by token adjacency.
type ParamRead {
  name: String
  type_atoms: List<Symbol>
}

// The comma list is Seq(item, Seq(Repeat(...), ...)); every typed parameter is a sequence whose
// LEFT is a binding-name atom and whose spine carries colon then type. Collect over the whole
// capture subtree: any sequence whose left is an atom and whose right spine carries a colon
// token immediately followed by a type production is one parameter. The production test on the
// type side keeps prose sequences out.
fn typed_params_of_capture(capture: Node, acc: List<ParamRead>) -> List<ParamRead> {
  fold_list(xs: node_subtree_nodes(root: capture), empty: acc, cons: fn(acc2, node) {
    match sequence_pair_optional(node: node) {
      Absent => acc2
      Present { value: pair } =>
        match node_atom_identity_optional(node: pair.left) {
          Absent => acc2
          Present { value: name_sym } =>
            match dag_lex_token_symbol(sym: name_sym) {
              true => acc2
              false =>
                match spine_right(node: pair.right) {
                  Absent => acc2
                  Present { value: after_colon } =>
                    match sequence_pair_optional(node: after_colon) {
                      Absent => acc2
                      Present { value: type_pair } =>
                        match node_production_is(node: type_pair.left, want: ^dag_surface_type_expr) {
                          true => Cons { head: ParamRead { name: symbol_lexeme(sym: name_sym), type_atoms: subtree_atom_symbols(n: type_pair.left) }, tail: acc2 }
                          false => acc2
                        }
                    }
                }
            }
        }
    }
  })
}

fn dag_lex_token_symbol(sym: Symbol) -> Bool {
  let lex = symbol_lexeme(sym: sym)
  starts_with(s: lex, prefix: "dag_token_") || starts_with(s: lex, prefix: "dag_surface_") || starts_with(s: lex, prefix: "dag_production_")
}

// ------------------------------------------------------------------ facts from the tree

type DeclBag {
  data_decls: List<Node>
  fn_decls: List<Node>
}

fn decl_bag_merge(a: DeclBag, b: DeclBag) -> DeclBag {
  DeclBag { data_decls: concat(a.data_decls, b.data_decls), fn_decls: concat(a.fn_decls, b.fn_decls) }
}

fn decl_bag_of_node(n: Node) -> DeclBag {
  let is_data = node_production_is(node: n, want: ^dag_surface_data_decl)
  let is_fn = node_production_is(node: n, want: ^dag_surface_fn_decl)
  let is_test = node_production_is(node: n, want: ^dag_surface_test_fn_decl)
  DeclBag {
    data_decls: if is_data { [n] } else { [] },
    fn_decls: if is_fn || is_test { [n] } else { [] }
  }
}

fn decl_bag_of_tree(root: Node) -> DeclBag {
  fold_list(xs: node_subtree_nodes(root: root), empty: DeclBag { data_decls: [], fn_decls: [] }, cons: fn(acc, node) {
    decl_bag_merge(a: acc, b: decl_bag_of_node(n: node))
  })
}

fn fact_name(node_name: Optional<Symbol>, fallback: String) -> String {
  match node_name {
    Present { value: sym } => symbol_lexeme(sym: sym)
    Absent => fallback
  }
}

fn fn_fact(decl: Node, is_test: Bool) -> Optional<ArgvWordsFact> {
  let name = fact_name(node_name: fn_decl_name(decl: decl, is_test: is_test), fallback: "<unnamed fn>")
  let body_atoms = match parse_subtree_find_production_captured(root: decl, emitted: ^dag_surface_fn_body) {
    ParseSubtreeFound { captured: c } => subtree_atom_symbols(n: c)
    ParseSubtreeAbsent => []
  }
  let return_atoms = match parse_production_captured_child_optional(node: decl) {
    Absent => []
    Present { value: captured } =>
      match fn_decl_return_type(captured: captured) {
        Absent => []
        Present { value: type_node } => subtree_atom_symbols(n: type_node)
      }
  }
  let param_reads = match fn_decl_param_list(decl: decl) {
    Absent => []
    Present { value: capture } => typed_params_of_capture(capture: capture, acc: [])
  }
  let list_string_params = fold_list(xs: param_reads, empty: 0, cons: fn(acc, p) {
    if type_atoms_list_string(atoms: p.type_atoms) { acc + 1 } else { acc }
  })
  let return_is_list_string = type_atoms_list_string(atoms: return_atoms)
  let counted = (list_string_params > 0) || return_is_list_string
  let body_flags = flag_contents_of_atoms(atoms: body_atoms)
  Present {
    value: ArgvWordsFact {
      decl: name,
      decl_kind: FnDecl,
      counted: counted,
      flag_words: if counted { body_flags } else { [] },
      candidates: if counted { [] } else { body_flags },
      return_spelling: type_spelling(atoms: return_atoms),
      returns_argv_words: return_is_list_string,
      list_string_params: list_string_params,
      list_string_data: false
    }
  }
}

// Whether a data declaration's name reaches an argv position in this module: its binding symbol
// appears in the body of a fn this lens counted as argv-typed. In-module evidence only — a
// cross-module use is invisible to one module's tree and stays a candidate.
fn data_decl_reaches_argv(name_sym: Symbol, fn_bodies: List<Symbol>) -> Bool {
  atoms_contain_symbol(atoms: fn_bodies, want: name_sym)
}

fn data_fact(decl: Node, fn_argv_bodies: List<Symbol>) -> Optional<ArgvWordsFact> {
  let name_node = match find_named_child(root: decl, name: ^dag_surface_data_decl_name) {
    Accepted { value: n, diagnostics: _ } => Present { value: n }
    Rejected { diagnostics: _ } => Absent
  }
  let name_sym = match name_node {
    Absent => Absent
    Present { value: n } => node_atom_identity_optional(node: n)
  }
  let name = fact_name(node_name: name_sym, fallback: "<unnamed data>")
  let type_atoms = match find_named_child(root: decl, name: ^dag_surface_data_decl_type) {
    Accepted { value: n, diagnostics: _ } => subtree_atom_symbols(n: n)
    Rejected { diagnostics: _ } => []
  }
  let expr_atoms = match find_named_child(root: decl, name: ^dag_surface_data_decl_expr) {
    Accepted { value: n, diagnostics: _ } => subtree_atom_symbols(n: n)
    Rejected { diagnostics: _ } => []
  }
  let is_list_string = type_atoms_list_string(atoms: type_atoms)
  let contents = flag_contents_of_atoms(atoms: expr_atoms)
  let has_flags = !(length(xs: contents) == 0)
  let reached = match name_sym {
    Absent => false
    Present { value: s } => data_decl_reaches_argv(name_sym: s, fn_bodies: fn_argv_bodies)
  }
  let counted = is_list_string && has_flags && reached
  Present {
    value: ArgvWordsFact {
      decl: name,
      decl_kind: DataDecl,
      counted: counted,
      flag_words: if counted { contents } else { [] },
      candidates: if is_list_string && has_flags && !counted { contents } else { [] },
      return_spelling: "",
      returns_argv_words: false,
      list_string_params: 0,
      list_string_data: is_list_string
    }
  }
}

// All fn bodies in the module, flattened, for the data-decl reach test: only bodies of fns the
// lens counts as argv-typed can grant a data declaration an argv position.
fn argv_typed_fn_bodies(root: Node) -> List<Symbol> {
  fold_list(xs: decl_bag_of_tree(root: root).fn_decls, empty: Empty, cons: fn(acc, decl) {
    let is_test = node_production_is(node: decl, want: ^dag_surface_test_fn_decl)
    let name = fn_decl_name(decl: decl, is_test: is_test)
    let body_atoms = match parse_subtree_find_production_captured(root: decl, emitted: ^dag_surface_fn_body) {
      ParseSubtreeFound { captured: c } => subtree_atom_symbols(n: c)
      ParseSubtreeAbsent => []
    }
    let return_atoms = match parse_production_captured_child_optional(node: decl) {
      Absent => []
      Present { value: captured } =>
        match fn_decl_return_type(captured: captured) {
          Absent => []
          Present { value: type_node } => subtree_atom_symbols(n: type_node)
        }
    }
    let param_reads = match fn_decl_param_list(decl: decl) {
      Absent => []
      Present { value: capture } => typed_params_of_capture(capture: capture, acc: [])
    }
    let argv_typed = (fold_list(xs: param_reads, empty: 0, cons: fn(a, p) { if type_atoms_list_string(atoms: p.type_atoms) { a + 1 } else { a } }) > 0) || type_atoms_list_string(atoms: return_atoms)
    if argv_typed { concat(acc, body_atoms) } else { acc }
  })
}

fn facts_of(root: Node) -> List<ArgvWordsFact> {
  let bag = decl_bag_of_tree(root: root)
  let fn_argv_bodies = argv_typed_fn_bodies(root: root)
  let fn_facts = fold_list(xs: bag.fn_decls, empty: Empty, cons: fn(acc, decl) {
    let is_test = node_production_is(node: decl, want: ^dag_surface_test_fn_decl)
    match fn_fact(decl: decl, is_test: is_test) {
      Absent => acc
      Present { value: f } => Cons { head: f, tail: acc }
    }
  })
  fold_list(xs: bag.data_decls, empty: fn_facts, cons: fn(acc, decl) {
    match data_fact(decl: decl, fn_argv_bodies: fn_argv_bodies) {
      Absent => acc
      Present { value: f } => Cons { head: f, tail: acc }
    }
  })
}

// ------------------------------------------------------------------ sites

// A fact joins the census when it is debt (counted) or a reported candidate. A data declaration
// that is a plain word list with no flag vocabulary and no reach is neither: the List<String>
// population is a ceiling, not the census.
fn is_census_member(f: ArgvWordsFact) -> Bool {
  f.counted || !(length(xs: f.candidates) == 0) || (f.decl_kind == FnDecl && f.returns_argv_words) || (f.decl_kind == FnDecl && f.list_string_params > 0)
}

fn site_class_of(module_file: String) -> Optional<ArgvWordsSiteClass> {
  match starts_with(s: module_file, prefix: "dag/extdeps/") {
    true => Present { value: ExtdepsInterfaceBuilder }
    false => match starts_with(s: module_file, prefix: "dag/gunbc/") {
      true => Present { value: WorkflowCallSite }
      false => Absent
    }
  }
}

fn site_class_name(c: ArgvWordsSiteClass) -> String {
  match c {
    ExtdepsInterfaceBuilder => "extdeps_interface_builder"
    WorkflowCallSite => "workflow_call_site"
  }
}

fn decl_kind_name(k: ArgvWordsDeclKind) -> String {
  match k {
    FnDecl => "fn"
    DataDecl => "data"
  }
}

// One census row per member declaration of one module. A module outside the two modeled roots is a
// REFUSAL, never a silent zero: the census counts dag/extdeps and dag/gunbc and says so.
fn argv_word_construction_sites_of_facts(module_file: String, facts: List<ArgvWordsFact>) -> ArgvWordsSites {
  match site_class_of(module_file: module_file) {
    Absent => ArgvWordsSitesRefused { reason: concat("module outside the modeled roots dag/extdeps and dag/gunbc: ", module_file) }
    Present { value: sc } =>
      ArgvWordsSitesEstablished {
        sites: fold_list(xs: facts, empty: Empty, cons: fn(acc, f) {
          if is_census_member(f: f) {
            Cons {
              head: ArgvWordsSite {
                module_file: module_file,
                decl: f.decl,
                decl_kind: f.decl_kind,
                site_class: sc,
                counted: f.counted,
                flag_words: f.flag_words,
                candidates: f.candidates,
                returns_argv_words: f.returns_argv_words,
                list_string_params: f.list_string_params,
                list_string_data: f.list_string_data
              },
              tail: acc
            }
          } else {
            acc
          }
        })
      }
  }
}

// ------------------------------------------------------------------ receipt rows

fn escape_char(s: String, delimiter: String, glue: String) -> String {
  fold_list(xs: split(s: s, delimiter: delimiter), empty: "", cons: fn(acc, part) { if acc == "" { part } else { concat(concat(acc, glue), part) } })
}

// Percent-escape the row separators a field could carry, in the standard order: percent first, so
// the escapes themselves are never re-escaped.
fn escape_field(s: String) -> String {
  escape_char(s: escape_char(s: escape_char(s: escape_char(s: s, delimiter: "%", glue: "%25"), delimiter: ",", glue: "%2C"), delimiter: ";", glue: "%3B"), delimiter: "\n", glue: "%0A")
}

fn join_words(ws: List<String>) -> String {
  fold_list(xs: ws, empty: "", cons: fn(acc, w) { if acc == "" { escape_field(s: w) } else { concat(concat(acc, ";"), escape_field(s: w)) } })
}

fn bool_word(b: Bool) -> String {
  match b {
    true => "T"
    false => "F"
  }
}

// The site at one identity, if the module's census read produced one.
fn argv_word_construction_site_named(sites: List<ArgvWordsSite>, module_file: String, decl: String) -> Optional<ArgvWordsSite> {
  fold_list(xs: sites, empty: Absent, cons: fn(acc, s) {
    match acc {
      Absent => match (s.module_file == module_file) && (s.decl == decl) {
        true => Present { value: s }
        false => Absent
      }
      Present { value: v } => Present { value: v }
    }
  })
}

fn site_line(s: ArgvWordsSite) -> String {
  let file = concat(escape_field(s: s.module_file), ",")
  let decl = concat(escape_field(s: s.decl), ",")
  let kind = concat(decl_kind_name(k: s.decl_kind), ",")
  let class = concat(site_class_name(c: s.site_class), ",")
  let counted = concat(bool_word(b: s.counted), ",")
  let flags = concat(join_words(ws: s.flag_words), ",")
  let cands = concat(join_words(ws: s.candidates), ",")
  let ret = concat(bool_word(b: s.returns_argv_words), ",")
  let params = concat(integer_int_to_decimal_string(value: s.list_string_params), ",")
  concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(file, decl), kind), class), counted), flags), cands), ret), params), bool_word(b: s.list_string_data)), "\n")
}

fn sites_text(sites: List<ArgvWordsSite>) -> String {
  fold_list(xs: sites, empty: "", cons: fn(acc, s) { concat(acc, site_line(s: s)) })
}

// ------------------------------------------------------------------ the raw parse of one module

type RawTreeStanding
  = RawTreeEstablished { root: Node }
  | RawTreeNotEstablished { cause: SourceAnalysisNotEstablishedCause }

// The raw parse, without normalize: the same tokenize/validate/parse chain as
// v2.lens.text_string_importer_census's raw_tree_of_text.
fn raw_tree_of_text(text: String) -> RawTreeStanding {
  let lm = dag_language_model()
  let at = invariant_port_locus(port: ^argv_word_construction_port, invariant: ^argv_word_construction_source_invariant)
  match lm.grammar {
    VoidGrammar => RawTreeNotEstablished { cause: LanguageGrammarUnavailable }
    ModeledGrammar { root: root } =>
      match grammar_validate_for_parse(root: root, at: at) {
        Rejected { diagnostics: _ } => RawTreeNotEstablished { cause: LanguageGrammarRejected }
        Accepted { value: validated, diagnostics: _ } =>
          match tokenize(text: text, file: ^argv_word_construction_subject, rules: lm.lex) {
            Rejected { diagnostics: _ } => RawTreeNotEstablished { cause: SourceTokenizationRejected }
            Accepted { value: stream, diagnostics: _ } =>
              match parse_production(tokens: token_stream_remaining(stream: stream), validated: validated, production_name: validated.root.start) {
                Rejected { diagnostics: _ } => RawTreeNotEstablished { cause: SourceParseRejected }
                Accepted { value: artifact, diagnostics: _ } => RawTreeEstablished { root: artifact.tree }
              }
          }
      }
  }
}

// ------------------------------------------------------------------ module entry

type ArgvWordsModuleStanding
  = ArgvWordsModuleEstablished { path: String, sites: List<ArgvWordsSite> }
  | ArgvWordsModuleRefused { path: String, reason: String }

// The census read of ONE module file, end to end: read, raw parse, tree query, facts, sites. The
// read folds through filesystem_read_outcome (the module's modeled read fold), so refusal and
// content cannot be conflated at this site.
fn argv_word_construction_module_sites(path: String) -> ArgvWordsModuleStanding {
  let read = Filesystem.Read(path: path)
  match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
    FilesystemReadRefused { error: e } => ArgvWordsModuleRefused { path: path, reason: concat("read refused: ", e) }
    FilesystemReadSucceeded { content: text } =>
      match raw_tree_of_text(text: text) {
        RawTreeNotEstablished { cause: c } => ArgvWordsModuleRefused { path: path, reason: concat("raw parse not established: ", source_cause_name(c: c)) }
        RawTreeEstablished { root: root } =>
          match argv_word_construction_sites_of_facts(module_file: path, facts: facts_of(root: root)) {
            ArgvWordsSitesRefused { reason: r } => ArgvWordsModuleRefused { path: path, reason: r }
            ArgvWordsSitesEstablished { sites: sites } => ArgvWordsModuleEstablished { path: path, sites: sites }
          }
      }
  }
}

fn source_cause_name(c: SourceAnalysisNotEstablishedCause) -> String {
  match c {
    SourceUnreadable => "source unreadable"
    LanguageGrammarUnavailable => "language grammar unavailable"
    LanguageGrammarRejected => "language grammar rejected"
    SourceNormalizationRejected => "source normalization rejected"
    SourceTokenizationRejected => "source tokenization rejected"
    SourceParseRejected => "source parse rejected"
  }
}

// Phase 2, batched: the census rows of the given module files, appended to `out`, one row per
// member declaration. Run from outside the repository over the discovered paths; CI's verifier
// lane owns the corpus-scale recount, the session runner never runs it locally.
fn argv_word_construction_for_paths(paths: List<String>, out: String) -> ProcessExit {
  let folded = fold_list(xs: paths, empty: Empty, cons: fn(acc, p) {
    match argv_word_construction_module_sites(path: p) {
      ArgvWordsModuleRefused { path: rp, reason: r } => Cons { head: concat(concat(concat("REFUSED\t", rp), "\t"), r), tail: acc }
      ArgvWordsModuleEstablished { path: _, sites: sites } => fold_list(xs: sites, empty: acc, cons: fn(acc2, s) { Cons { head: site_line(s: s), tail: acc2 } })
    }
  })
  let written = Filesystem.Write(path: out, content: joined(lines_reversed: folded))
  if written.success { ExitSuccess } else { exit_failure(reason: concat("census write refused: ", written.error)) }
}

fn joined(lines_reversed: FreeMonoid<String>) -> String {
  fold_list(xs: list_reverse(xs: lines_reversed), empty: "", cons: fn(acc, l) { concat(acc, l) })
}

// ------------------------------------------------------------------ the roster gates

// A committed roster row: one census member, at identity grain, with its classification and the
// disposition note that names what pays it. The roster may only shrink: COUNTED rows resolve
// against live COUNTED sites, live COUNTED members must be covered, and the population never
// grows past the committed baseline. Candidate rows are reported, never gated.
type ArgvWordsRosterRow {
  module_file: String
  decl: String
  decl_kind: ArgvWordsDeclKind
  site_class: ArgvWordsSiteClass
  note: String
}

fn row_matches_site(r: ArgvWordsRosterRow, s: ArgvWordsSite) -> Bool {
  s.counted && (r.module_file == s.module_file) && (r.decl == s.decl) && decl_kind_matches(a: r.decl_kind, b: s.decl_kind)
}

fn decl_kind_matches(a: ArgvWordsDeclKind, b: ArgvWordsDeclKind) -> Bool {
  match a {
    FnDecl => match b { FnDecl => true, DataDecl => false }
    DataDecl => match b { FnDecl => false, DataDecl => true }
  }
}

// Every row must resolve to a live census member: a row whose site was paid without deleting the
// row refuses, naming the stale identity (DESIGN 5: join at identity grain, never at count).
fn argv_word_construction_rows_resolve(live: List<ArgvWordsSite>, roster: List<ArgvWordsRosterRow>) -> ProcessExit {
  match fold_list(xs: roster, empty: Empty, cons: fn(acc, r) {
    let resolves = fold_list(xs: live, empty: false, cons: fn(acc2, s) { acc2 || row_matches_site(r: r, s: s) })
    if resolves { acc } else { Cons { head: concat(concat(concat(concat("stale row: ", r.module_file), " "), r.decl), concat(" (", concat(decl_kind_name(k: r.decl_kind), ") was paid without deleting its roster row"))), tail: acc } }
  }) {
    Empty => ExitSuccess
    nonempty => exit_failure(reason: joined(lines_reversed: nonempty))
  }
}

// Every live census member must be a roster row: new string-built argv is refused until it adopts
// the typed form. Enrolling it is not an option while the shrink gate holds.
fn argv_word_construction_census_covers(live: List<ArgvWordsSite>, roster: List<ArgvWordsRosterRow>) -> ProcessExit {
  match fold_list(xs: live, empty: Empty, cons: fn(acc, s) {
    let covered = fold_list(xs: roster, empty: false, cons: fn(acc2, r) { acc2 || row_matches_site(r: r, s: s) })
    if covered || !s.counted { acc } else { Cons { head: concat(concat(concat(concat("uncovered member: ", s.module_file), " "), s.decl), concat(" (", concat(decl_kind_name(k: s.decl_kind), ") builds argv words without a typed form and without a roster row"))), tail: acc } }
  }) {
    Empty => ExitSuccess
    nonempty => exit_failure(reason: joined(lines_reversed: nonempty))
  }
}

// The roster may only shrink: its population never grows past the committed baseline cardinality.
fn argv_word_construction_roster_shrinks(baseline_population: Int, roster: List<ArgvWordsRosterRow>) -> ProcessExit {
  let n = length(xs: roster)
  if n <= baseline_population {
    ExitSuccess
  } else {
    exit_failure(reason: concat(concat("the typed-argv roster grew to ", integer_int_to_decimal_string(value: n)), concat(" rows past the committed baseline of ", concat(integer_int_to_decimal_string(value: baseline_population), "; pay string-built argv, do not enroll it"))))
  }
}

// The whole contract over one recount: rows resolve, members are covered, the roster has not
// grown. ExitSuccess is the verdict "within the contract"; a refusal names the offending rows.
fn argv_word_construction_gates(live: List<ArgvWordsSite>, roster: List<ArgvWordsRosterRow>, baseline_population: Int) -> ProcessExit {
  let resolved = argv_word_construction_rows_resolve(live: live, roster: roster)
  match resolved {
    ExitSuccess => match argv_word_construction_census_covers(live: live, roster: roster) {
      ExitSuccess => argv_word_construction_roster_shrinks(baseline_population: baseline_population, roster: roster)
      refused => refused
    }
    refused => refused
  }
}
