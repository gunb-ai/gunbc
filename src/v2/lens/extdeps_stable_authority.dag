// src/v2/lens/extdeps_stable_authority.dag
// Scope: extdeps module stable-authority anchor guard (DESIGN §3 grounding).
// Every extdeps/ module must declare `data extdeps_stable_authority_anchor:
// StableAuthority { uri: Uri }` — external http(s)/ftp or internal file: (section in
// locator fragment, e.g. "DESIGN.md#3-single-authority").
// Consumer: tools.extdeps_stable_authority_gate (slice 1: advisory) + witnesses.
//
// Projection: structural parse bridge in extdeps_shape_transport_policy_project.rs
// (dissolve-on #5126 — same cohort as extdeps_shape_transport_policy). NO string
// prefix tests; scheme decode is exhaustive constructor-identity equality only.
//
// Slice 1 (backfill held): live clean-tree scans the real derived extdeps roster via
// extdeps_derived_extdeps_modules; MissingFormalAnchor applies only to enrolled modules
// and never to anchor-machinery modules (extdeps.uri, extdeps.stable_authority).

module v2.lens.extdeps_stable_authority

import extdeps.uri {
  Http,
  Https,
  File,
  Ftp,
  UriScheme
}
import v2.lens.extdeps_stable_authority.module_refs {
  extdeps_stable_authority_anchor_enrolled_modules,
  extdeps_stable_authority_anchor_machinery_exempt_modules,
  extdeps_stable_authority_clean_tree_roster_exclusions
}
import v2.std.algebra {
  contains,
  filter,
  fold_list,
  is_empty,
  length,
  list_snoc_item
}
import v2.std.collection { List, Optional, Present, Absent }
import v2.std.logic { Bool }
import v2.std.qualified_name { QualifiedName, qualified_name_eq }
import v2.std.text { String }

type ExtdepsStableAuthorityAnchorStatus
  = AnchorAbsent
  | AnchorPresent { scheme_identity: String, locator: String }

type ExtdepsStableAuthorityViolation
  = MissingFormalAnchor { module: QualifiedName }
  | UnrecognizedAnchorScheme { module: QualifiedName, raw_scheme: String }

data empty_extdeps_stable_authority_violations: List<ExtdepsStableAuthorityViolation> = []

fn anchor_kind_is_absent(kind: String) -> Bool {
  kind == "absent"
}

fn anchor_kind_is_present(kind: String) -> Bool {
  kind == "present"
}

// Exhaustive constructor-identity decode — the ONLY place raw scheme strings are inspected.
fn decode_uri_scheme(raw: String) -> Optional<UriScheme> {
  match raw {
    "Http" => Present { value: Http }
    "Https" => Present { value: Https }
    "File" => Present { value: File }
    "Ftp" => Present { value: Ftp }
    _ => Absent
  }
}

fn extdeps_stable_authority_status_for_module(
  module: QualifiedName
) -> ExtdepsStableAuthorityAnchorStatus {
  let kind = extdeps_stable_authority_anchor_kind_for_qualified_name(module: module)
  if anchor_kind_is_absent(kind: kind) {
    AnchorAbsent
  } else {
    AnchorPresent {
      scheme_identity: extdeps_stable_authority_scheme_identity_for_qualified_name(module: module),
      locator: extdeps_stable_authority_locator_for_qualified_name(module: module)
    }
  }
}

fn extdeps_stable_authority_module_in_roster(
  module: QualifiedName,
  roster: List<QualifiedName>
) -> Bool {
  contains(xs: roster, item: module, eq: qualified_name_eq)
}

fn extdeps_stable_authority_is_anchor_machinery_exempt(module: QualifiedName) -> Bool {
  extdeps_stable_authority_module_in_roster(
    module: module,
    roster: extdeps_stable_authority_anchor_machinery_exempt_modules
  )
}

fn extdeps_stable_authority_is_anchor_enrolled(module: QualifiedName) -> Bool {
  extdeps_stable_authority_module_in_roster(
    module: module,
    roster: extdeps_stable_authority_anchor_enrolled_modules
  )
}

fn extdeps_stable_authority_is_clean_tree_roster_excluded(module: QualifiedName) -> Bool {
  extdeps_stable_authority_module_in_roster(
    module: module,
    roster: extdeps_stable_authority_clean_tree_roster_exclusions
  )
}

// Strict per-module violations (lens-unit witnesses on explicit modules).
fn extdeps_stable_authority_violations_for_module(
  module: QualifiedName
) -> List<ExtdepsStableAuthorityViolation> {
  match extdeps_stable_authority_status_for_module(module: module) {
    AnchorAbsent => [
      MissingFormalAnchor { module: module }
    ]
    AnchorPresent { scheme_identity: raw, locator: _ } =>
      match decode_uri_scheme(raw: raw) {
        Present { value: _ } => empty_extdeps_stable_authority_violations
        Absent => [
          UnrecognizedAnchorScheme { module: module, raw_scheme: raw }
        ]
      }
  }
}

// Live clean-tree policy (slice 1): machinery exempt + enrolled missing-anchor only.
fn extdeps_stable_authority_live_violations_for_module(
  module: QualifiedName
) -> List<ExtdepsStableAuthorityViolation> {
  if extdeps_stable_authority_is_clean_tree_roster_excluded(module: module) {
    empty_extdeps_stable_authority_violations
  } else {
    match extdeps_stable_authority_status_for_module(module: module) {
      AnchorAbsent =>
        if extdeps_stable_authority_is_anchor_machinery_exempt(module: module) {
          empty_extdeps_stable_authority_violations
        } else if extdeps_stable_authority_is_anchor_enrolled(module: module) {
          [
            MissingFormalAnchor { module: module }
          ]
        } else {
          empty_extdeps_stable_authority_violations
        }
      AnchorPresent { scheme_identity: raw, locator: _ } =>
        match decode_uri_scheme(raw: raw) {
          Present { value: _ } => empty_extdeps_stable_authority_violations
          Absent => [
            UnrecognizedAnchorScheme { module: module, raw_scheme: raw }
          ]
        }
    }
  }
}

fn extdeps_stable_authority_violation_count_for_module(module: QualifiedName) -> Int {
  length(xs: extdeps_stable_authority_violations_for_module(module: module))
}

fn extdeps_stable_authority_live_violation_count_for_module(module: QualifiedName) -> Int {
  length(xs: extdeps_stable_authority_live_violations_for_module(module: module))
}

fn extdeps_stable_authority_clean_for_module(module: QualifiedName) -> Bool {
  extdeps_stable_authority_violation_count_for_module(module: module) == 0
}

fn scan_extdeps_stable_authority_modules(
  modules: List<QualifiedName>
) -> List<ExtdepsStableAuthorityViolation> {
  fold_list(
    xs: modules,
    empty: empty_extdeps_stable_authority_violations,
    cons: fn(acc, mod_qn) {
      fold_list(
        xs: extdeps_stable_authority_live_violations_for_module(module: mod_qn),
        empty: acc,
        cons: fn(inner, v) { list_snoc_item(xs: inner, item: v) }
      )
    }
  )
}

fn extdeps_stable_authority_clean_holds(modules: List<QualifiedName>) -> Bool {
  is_empty(xs: scan_extdeps_stable_authority_modules(modules: modules))
}

fn extdeps_stable_authority_violation_count(modules: List<QualifiedName>) -> Int {
  length(xs: scan_extdeps_stable_authority_modules(modules: modules))
}

fn extdeps_stable_authority_has_missing_formal_anchor(
  module: QualifiedName
) -> Bool {
  extdeps_stable_authority_violation_count_for_module(module: module) == 1
    && anchor_kind_is_absent(
      kind: extdeps_stable_authority_anchor_kind_for_qualified_name(module: module)
    )
}

fn extdeps_stable_authority_has_unrecognized_scheme(
  module: QualifiedName
) -> Bool {
  match extdeps_stable_authority_status_for_module(module: module) {
    AnchorPresent { scheme_identity: raw, locator: _ } =>
      match decode_uri_scheme(raw: raw) {
        Absent => true
        Present { value: _ } => false
      }
    _ => false
  }
}

// Live projection roster: all derived extdeps.* modules minus explicit RED perturb exclusions.
fn extdeps_stable_authority_live_roster_modules() -> List<QualifiedName> {
  filter(
    xs: extdeps_derived_extdeps_modules(),
    predicate: fn(mod_qn) {
      !extdeps_stable_authority_is_clean_tree_roster_excluded(module: mod_qn)
    }
  )
}

fn extdeps_stable_authority_live_roster_module_count() -> Int {
  length(xs: extdeps_stable_authority_live_roster_modules())
}

fn extdeps_stable_authority_live_clean_tree_holds() -> Bool {
  extdeps_stable_authority_clean_holds(
    modules: extdeps_stable_authority_live_roster_modules()
  )
}

// Slice-1 enrolled-module clean check (live projection over explicit anchor rows).
fn extdeps_stable_authority_live_anchored_modules_clean_holds() -> Bool {
  extdeps_stable_authority_clean_holds(
    modules: extdeps_stable_authority_anchor_enrolled_modules
  )
}

// Discriminating: enrolled module with anchor row removed must fail live clean-tree policy.
fn extdeps_stable_authority_live_enrolled_anchor_drop_is_red(
  module: QualifiedName
) -> Bool {
  extdeps_stable_authority_live_violation_count_for_module(module: module) > 0
    && anchor_kind_is_absent(
      kind: extdeps_stable_authority_anchor_kind_for_qualified_name(module: module)
    )
}
