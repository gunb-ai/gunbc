module v2.lens.production_qualification_origin_census

import v2.compiler.self_host.emitter_producer_provenance {
  BehavioralEquivalent,
  CargoGreen,
  EmissionQualification,
  ProductionRouted,
  SourceProduced,
  emission_qualifications_list_contains
}
import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }
import std.disposition { SingleAuthority }
import v2.std.algebra {
  any,
  contains,
  fold_list,
  length,
  list_snoc_item
}
import v2.std.collection {
  Absent,
  List,
  Optional,
  Present,
  optional_absent,
  optional_present
}
import v2.std.compilers.lexing { symbol_intern_lexeme, symbol_lexeme }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.fn_index { FnArrowDecl, fn_arrow_decl_facts_live }
import v2.std.grammar { node_atom_identity_optional }
import v2.std.node_query {
  call_callee_target,
  node_is_call
}
import v2.std.integer { Int }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  Edge,
  Node,
  NodeFold,
  Positional,
  Symbol,
  SyntheticOccurrence,
  TypeNode,
  fold_node
}
import v2.std.text { String }

data production_qualification_origin_probe_law: String = "Production-qualification origin PROBE (session keen-lark-681, wise-ram-22 recut): NOT a repository-wide census. fn_arrow_decl_facts_live() scope is entry-closure today; repository-wide frequency is unknown. This carrier reports fixture-origin mint surfaces discovered by STRUCTURAL skeleton rules (mint/advance callee atoms + fixture marker atoms) only — never declaration-name recognition. Known direct-door fixture-origin mint surfaces detected in scope: see known_fixture_origin_mint_surface_count_in_scope(). Repository-wide frequency: unknown. Dissolve-on: derive every resolved call occurrence capable of constructing or advancing a production qualification (effect_reach / call-occurrence substrate), classify CompilerDerived | FixtureDerived | ExecutionMeasured | UnknownOrigin with UnknownOrigin failing admission, include BehavioralEquivalent, and retire name/closure pins."

data production_qualification_origin_call_occurrence_frontier_note: String = "SCAFFOLD frontier (wise-ram-22 required recut): population is NOT derived from resolved call occurrences yet — only fn-arrow skeleton callee/marker projection inside the witness entry's import closure. Ingest-inline surfaces whose mint callee is pruned by G2 marshal, indirect consumer reachability, and repository-wide mint sites outside the closure are invisible. Dissolve-on when call-reachable production-qualification classification shares the effect_reach skeleton authority."

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SingleAuthority }
}

data production_qualification_count_axis_note: String = "All EmissionQualification axes route through production_qualification_count_axis_for_emission_qualification over production_qualification_counted_qualifications — including BehavioralEquivalent (7761 origin-accounting rung)."

data production_qualification_counted_qualifications: List<EmissionQualification> = [
  SourceProduced,
  CargoGreen,
  ProductionRouted,
  BehavioralEquivalent
]

type ProductionQualificationOrigin
  = CompilerDerived
  | FixtureDerived
  | ExecutionMeasured
  | UnknownOrigin

type ProductionQualificationCountAxis
  = QualificationSourceProduced
  | QualificationCargoGreen
  | QualificationProductionRouted
  | QualificationBehavioralEquivalent

type DerivedProductionQualificationMintSiteRow {
  qualified_name: String
  qualification_axis: ProductionQualificationCountAxis
  evidence_origin: ProductionQualificationOrigin
}

data empty_string_list: List<String> = []
data empty_symbol_list: List<Symbol> = []
data empty_site_list: List<DerivedProductionQualificationMintSiteRow> = []

data mint_written_callee: String = "mint_written_provenanced_rust_artifact"
data advance_cargo_green_callee: String = "advance_written_provenanced_rust_artifact_cargo_green"
data direct_rust_door_inferred_tree_atom: String = "direct_rust_door_inferred_tree"

fn string_eq(a: String, b: String) -> Bool {
  a == b
}

fn symbol_eq(a: Symbol, b: Symbol) -> Bool {
  a == b
}

fn production_qualification_origin_eq(
  left: ProductionQualificationOrigin,
  right: ProductionQualificationOrigin
) -> Bool {
  match left {
    CompilerDerived =>
      match right {
        CompilerDerived => true
        FixtureDerived => false
        ExecutionMeasured => false
        UnknownOrigin => false
      }
    FixtureDerived =>
      match right {
        CompilerDerived => false
        FixtureDerived => true
        ExecutionMeasured => false
        UnknownOrigin => false
      }
    ExecutionMeasured =>
      match right {
        CompilerDerived => false
        FixtureDerived => false
        ExecutionMeasured => true
        UnknownOrigin => false
      }
    UnknownOrigin =>
      match right {
        CompilerDerived => false
        FixtureDerived => false
        ExecutionMeasured => false
        UnknownOrigin => true
      }
  }
}

fn production_qualification_count_axis_eq(
  left: ProductionQualificationCountAxis,
  right: ProductionQualificationCountAxis
) -> Bool {
  match left {
    QualificationSourceProduced =>
      match right {
        QualificationSourceProduced => true
        QualificationCargoGreen => false
        QualificationProductionRouted => false
        QualificationBehavioralEquivalent => false
      }
    QualificationCargoGreen =>
      match right {
        QualificationSourceProduced => false
        QualificationCargoGreen => true
        QualificationProductionRouted => false
        QualificationBehavioralEquivalent => false
      }
    QualificationProductionRouted =>
      match right {
        QualificationSourceProduced => false
        QualificationCargoGreen => false
        QualificationProductionRouted => true
        QualificationBehavioralEquivalent => false
      }
    QualificationBehavioralEquivalent =>
      match right {
        QualificationSourceProduced => false
        QualificationCargoGreen => false
        QualificationProductionRouted => false
        QualificationBehavioralEquivalent => true
      }
  }
}

fn production_qualification_count_axis_for_emission_qualification(
  qualification: EmissionQualification
) -> Optional<ProductionQualificationCountAxis> {
  if emission_qualifications_list_contains(
    xs: production_qualification_counted_qualifications,
    wanted: qualification
  ) {
    match qualification {
      SourceProduced => optional_present(value: QualificationSourceProduced)
      CargoGreen => optional_present(value: QualificationCargoGreen)
      ProductionRouted => optional_present(value: QualificationProductionRouted)
      BehavioralEquivalent => optional_present(value: QualificationBehavioralEquivalent)
    }
  } else {
    optional_absent()
  }
}

type AtomCollectState {
  node: Node
  atoms: List<Symbol>
}

fn atom_collect_init(n: Node) -> AtomCollectState {
  AtomCollectState { node: n, atoms: empty_symbol_list }
}

fn atom_collect_step(acc: AtomCollectState, _edge: Edge, child: AtomCollectState) -> AtomCollectState {
  let atoms = match node_atom_identity_optional(node: child.node) {
    Present { value: sym } =>
      if contains(xs: acc.atoms, item: sym, eq: symbol_eq) {
        acc.atoms
      } else {
        list_snoc_item(xs: acc.atoms, item: sym)
      }
    Absent => acc.atoms
  }
  AtomCollectState { node: acc.node, atoms: atoms }
}

fn atom_collect_algebra() -> NodeFold<AtomCollectState> {
  NodeFold { init: atom_collect_init, step: atom_collect_step }
}

fn atom_identities_in_node(node: Node) -> List<Symbol> {
  let from_descendants = fold_node(n: node, algebra: atom_collect_algebra()).atoms
  match node_atom_identity_optional(node: node) {
    Present { value: sym } =>
      if contains(xs: from_descendants, item: sym, eq: symbol_eq) {
        from_descendants
      } else {
        list_snoc_item(xs: from_descendants, item: sym)
      }
    Absent => from_descendants
  }
}

fn node_contains_atom_text(node: Node, wanted: String) -> Bool {
  any(
    xs: atom_identities_in_node(node: node),
    predicate: fn(sym) { string_eq(a: symbol_lexeme(sym: sym), b: wanted) }
  )
}

type CalleeCollectState {
  node: Node
  callees: List<String>
}

fn callee_collect_init(n: Node) -> CalleeCollectState {
  CalleeCollectState { node: n, callees: empty_string_list }
}

fn maybe_snoc_callee_text(callees: List<String>, text: String) -> List<String> {
  if contains(xs: callees, item: text, eq: string_eq) {
    callees
  } else {
    list_snoc_item(xs: callees, item: text)
  }
}

fn callee_text_from_call_node(node: Node) -> List<String> {
  if node_is_call(node: node) {
    match call_callee_target(node: node) {
      Accepted { value: callee_node, diagnostics: _ } =>
        match node_atom_identity_optional(node: callee_node) {
          Present { value: sym } =>
            [symbol_lexeme(sym: sym)]
          Absent => empty_string_list
        }
      Rejected { diagnostics: _ } => empty_string_list
    }
  } else {
    empty_string_list
  }
}

fn callee_collect_merge(
  left: List<String>,
  right: List<String>
) -> List<String> {
  fold_list(
    xs: right,
    empty: left,
    cons: fn(acc, text) { maybe_snoc_callee_text(callees: acc, text: text) }
  )
}

fn callee_collect_step(
  acc: CalleeCollectState,
  _edge: Edge,
  child: CalleeCollectState
) -> CalleeCollectState {
  let merged = callee_collect_merge(left: acc.callees, right: child.callees)
  let with_call = callee_collect_merge(
    left: merged,
    right: callee_text_from_call_node(node: child.node)
  )
  CalleeCollectState { node: acc.node, callees: with_call }
}

fn callee_collect_algebra() -> NodeFold<CalleeCollectState> {
  NodeFold { init: callee_collect_init, step: callee_collect_step }
}

fn callees_from_atom_scan(node: Node) -> List<String> {
  fold_list(
    xs: atom_identities_in_node(node: node),
    empty: empty_string_list,
    cons: fn(acc, sym) {
      maybe_snoc_callee_text(callees: acc, text: symbol_lexeme(sym: sym))
    }
  )
}

fn callees_from_node(node: Node) -> List<String> {
  let from_call_walk = callee_collect_merge(
    left: fold_node(n: node, algebra: callee_collect_algebra()).callees,
    right: callee_text_from_call_node(node: node)
  )
  callee_collect_merge(left: from_call_walk, right: callees_from_atom_scan(node: node))
}

fn decl_contains_callee(decl: FnArrowDecl, callee: String) -> Bool {
  contains(xs: callees_from_node(node: decl.output), item: callee, eq: string_eq)
}

fn decl_contains_atom(decl: FnArrowDecl, atom: String) -> Bool {
  node_contains_atom_text(node: decl.output, wanted: atom)
}

fn decl_has_qualifying_mint_callee(decl: FnArrowDecl) -> Bool {
  decl_contains_callee(decl: decl, callee: mint_written_callee)
    || decl_contains_callee(decl: decl, callee: advance_cargo_green_callee)
}

data direct_rust_door_target_model_callee: String = "direct_rust_door_target_model"

fn decl_has_fixture_marker(decl: FnArrowDecl) -> Bool {
  decl_contains_atom(decl: decl, atom: direct_rust_door_inferred_tree_atom)
    || (
      decl_contains_callee(decl: decl, callee: mint_written_callee)
        && decl_contains_callee(decl: decl, callee: direct_rust_door_target_model_callee)
    )
}

fn decl_origin_from_structure(decl: FnArrowDecl) -> ProductionQualificationOrigin {
  if decl_has_fixture_marker(decl: decl) {
    FixtureDerived
  } else {
    UnknownOrigin
  }
}

fn site_row_already_present(
  sites: List<DerivedProductionQualificationMintSiteRow>,
  qualified_name: String,
  axis: ProductionQualificationCountAxis
) -> Bool {
  any(
    xs: sites,
    predicate: fn(row) {
      string_eq(a: row.qualified_name, b: qualified_name)
        && production_qualification_count_axis_eq(
          left: row.qualification_axis,
          right: axis
        )
    }
  )
}

fn maybe_snoc_site_row(
  sites: List<DerivedProductionQualificationMintSiteRow>,
  qualified_name: String,
  axis: ProductionQualificationCountAxis,
  origin: ProductionQualificationOrigin
) -> List<DerivedProductionQualificationMintSiteRow> {
  if site_row_already_present(sites: sites, qualified_name: qualified_name, axis: axis) {
    sites
  } else {
    list_snoc_item(
      xs: sites,
      item: DerivedProductionQualificationMintSiteRow {
        qualified_name: qualified_name,
        qualification_axis: axis,
        evidence_origin: origin
      }
    )
  }
}

fn derived_sites_for_decl(
  sites: List<DerivedProductionQualificationMintSiteRow>,
  decl: FnArrowDecl
) -> List<DerivedProductionQualificationMintSiteRow> {
  if decl_has_qualifying_mint_callee(decl: decl) {
    let origin = decl_origin_from_structure(decl: decl)
    let with_source_produced =
      if decl_contains_callee(decl: decl, callee: mint_written_callee) {
        maybe_snoc_site_row(
          sites: sites,
          qualified_name: decl.qualified_name,
          axis: QualificationSourceProduced,
          origin: origin
        )
      } else {
        sites
      }
    if decl_contains_callee(decl: decl, callee: advance_cargo_green_callee) {
      maybe_snoc_site_row(
        sites: with_source_produced,
        qualified_name: decl.qualified_name,
        axis: QualificationCargoGreen,
        origin: origin
      )
    } else {
      with_source_produced
    }
  } else {
    sites
  }
}

fn derived_production_qualification_mint_sites_from_facts(
  decls: List<FnArrowDecl>
) -> List<DerivedProductionQualificationMintSiteRow> {
  fold_list(
    xs: decls,
    empty: empty_site_list,
    cons: fn(acc, decl) { derived_sites_for_decl(sites: acc, decl: decl) }
  )
}

fn derived_production_qualification_mint_sites_live() -> List<DerivedProductionQualificationMintSiteRow> {
  derived_production_qualification_mint_sites_from_facts(
    decls: fn_arrow_decl_facts_live()
  )
}

fn count_derived_mint_sites_with_origin(
  sites: List<DerivedProductionQualificationMintSiteRow>,
  origin: ProductionQualificationOrigin
) -> Int {
  fold_list(
    xs: sites,
    empty: 0,
    cons: fn(count, row) {
      if production_qualification_origin_eq(left: row.evidence_origin, right: origin) {
        count + 1
      } else {
        count
      }
    }
  )
}

fn count_derived_fixture_origin_mint_sites(
  sites: List<DerivedProductionQualificationMintSiteRow>
) -> Int {
  count_derived_mint_sites_with_origin(sites: sites, origin: FixtureDerived)
}

fn known_fixture_origin_mint_surface_count_in_scope() -> Int {
  count_derived_fixture_origin_mint_sites(
    sites: derived_production_qualification_mint_sites_live()
  )
}

fn production_qualification_origin_probe_admission_holds_for_decls(
  decls: List<FnArrowDecl>
) -> Bool {
  count_derived_mint_sites_with_origin(
    sites: derived_production_qualification_mint_sites_from_facts(decls: decls),
    origin: UnknownOrigin
  ) == 0
}

fn probe_mint_callee_atom_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: symbol_intern_lexeme(lexeme: mint_written_callee) } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn unknown_origin_red_control_planted_decl() -> FnArrowDecl {
  FnArrowDecl {
    qualified_name: "synthetic.production_qualification_origin_census.unknown_origin_red_control",
    name: "unknown_origin_red_control_planted_decl",
    output: Node {
      kind: TypeNode { connective: Conj },
      children: [
        Edge { label: Positional, target: probe_mint_callee_atom_node() }
      ],
      occurrence_id: SyntheticOccurrence
    },
    params: []
  }
}

fn structural_red_control_decl_present_live() -> Bool {
  any(
    xs: fn_arrow_decl_facts_live(),
    predicate: fn(decl) {
      string_eq(a: decl.name, b: "structural_red_control_mint_site_probe")
    }
  )
}

fn structural_red_control_decl_has_mint_callee_live() -> Bool {
  any(
    xs: fn_arrow_decl_facts_live(),
    predicate: fn(decl) {
      string_eq(a: decl.name, b: "structural_red_control_mint_site_probe")
        && decl_contains_callee(decl: decl, callee: mint_written_callee)
    }
  )
}

fn production_qualification_origin_probe_admission_holds() -> Bool {
  production_qualification_origin_probe_admission_holds_for_decls(
    decls: fn_arrow_decl_facts_live()
  )
}
