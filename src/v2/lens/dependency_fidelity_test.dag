module v2.test.lens_dependency_fidelity.dependency_fidelity_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn a_synthetic_param() -> Node {
  node_synthetic(kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^p } }, children: std.algebra.Empty)
}

test fn clean_input_surface_is_faithful() -> Bool {
  return verdict_is_faithful(v: input_reachability_verdict(fact: v2.lens.unused_parameters.UnusedParametersFact { unused: std.algebra.Empty }))
}

test fn one_unused_param_flips_to_discrepant() -> Bool {
  let fact = v2.lens.unused_parameters.UnusedParametersFact {
    unused: list_snoc_item(xs: Empty, item: v2.lens.unused_parameters.UnusedParameterFact { declaration: a_synthetic_param() })
  }
  return !verdict_is_faithful(v: input_reachability_verdict(fact: fact))
}
