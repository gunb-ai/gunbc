module v2.lens.complexity


data complexity_variables_list_carrier_note: String = "ComplexityVariables is List<SizeVariable> with no Refined/Witness carrier. The admits predicate is vacuous, so refine+Holds rewrap added no admission fact and under discovery (PR 7765) Witness peels left Holds-wrapped lists that concat rejected as Record. complexity_lens returns ComplexityBound directly (UnknownComplexity on cost Violates) so discovery cannot nest an extra Holds around the bound. dissolve-on: root-cause the discovery shared-index path that injected the extra Holds layer."

fn complexity_variables_admits(xs: List<v2.lens.cost.SizeVariable>) -> Bool {
  true
}

data complexity_variables_validation: v2.std.refinement.Validation<List<v2.lens.cost.SizeVariable>> = v2.std.refinement.Validation {
  reason: ^complexity_variables_invalid,
  admits: complexity_variables_admits
}

data complexity_variables_vacuous_validation: v2.std.refinement.VacuousValidation<List<v2.lens.cost.SizeVariable>> = v2.std.refinement.VacuousValidation {
  reason: ^complexity_variables_invalid,
  vacuous: v2.std.refinement.vacuous_admits_marker
}

fn complexity_projection_locus() -> v2.std.diagnostic.Locus {
  v2.std.diagnostic.Textual { file: ^complexity_projection_virtual_file, extent: v2.std.diagnostic.WholeFile }
}

type ComplexityVariables = List<v2.lens.cost.SizeVariable>

type SizeIndexedAsymptoticClass
  = SizedLogClass
  | SizedLinearClass
  | SizedLinearithmicClass
  | SizedPolynomialClass { degree: v2.lens.cost.PolynomialDegree }
  | SizedPolyLogClass { exponent: v2.lens.cost.PolyLogExponent }
  | SizedExponentialClass
  | SizedFactorialClass

type ComplexityBound
  = ConstantComplexity
  | SizedComplexity { class: SizeIndexedAsymptoticClass, variables: ComplexityVariables }
  | UnknownComplexity { diagnostic: v2.std.diagnostic.Diagnostic }

fn unknown_complexity() -> ComplexityBound {
  UnknownComplexity { diagnostic: complexity_projection_diagnostic() }
}

fn single_complexity_variable(size_var: v2.lens.cost.SizeVariable) -> ComplexityVariables {
  [size_var]
}

fn empty_complexity_variables() -> ComplexityVariables {
  std.algebra.Empty
}

fn composite_complexity_variables(
  lhs: ComplexityVariables,
  rhs: ComplexityVariables
) -> ComplexityVariables {
  concat(lhs, rhs)
}

fn sized_complexity(
  class: SizeIndexedAsymptoticClass,
  variables: ComplexityVariables
) -> ComplexityBound {
  SizedComplexity { class: class, variables: variables }
}

fn linear_complexity(size_var: v2.lens.cost.SizeVariable) -> ComplexityBound {
  sized_complexity(
    class: SizedLinearClass,
    variables: single_complexity_variable(size_var: size_var)
  )
}

fn polynomial_complexity(
  size_var: v2.lens.cost.SizeVariable,
  degree: v2.lens.cost.PolynomialDegree
) -> ComplexityBound {
  sized_complexity(
    class: SizedPolynomialClass { degree: degree },
    variables: single_complexity_variable(size_var: size_var)
  )
}

fn multidimensional_polynomial_complexity(
  variables: ComplexityVariables,
  degree: v2.lens.cost.PolynomialDegree
) -> ComplexityBound {
  sized_complexity(class: SizedPolynomialClass { degree: degree }, variables: variables)
}

fn unknown_complexity_with_diagnostic(diagnostic: v2.std.diagnostic.Diagnostic) -> ComplexityBound {
  UnknownComplexity { diagnostic: diagnostic }
}

fn complexity_variables_from_cost(cost: v2.lens.cost.SymbolicCost) -> ComplexityVariables {
  match cost {
    v2.lens.cost.ConstantCost { value: _ } => std.algebra.Empty
    v2.lens.cost.LogCost { variable: v } => [v]
    v2.lens.cost.LinearCost { variable: v } => [v]
    v2.lens.cost.PolynomialCost { variable: v, degree: _ } => [v]
    v2.lens.cost.PolyLogCost { variable: v, exponent: _ } => [v]
    v2.lens.cost.ExponentialCost { variable: v, base: _ } => [v]
    v2.lens.cost.FactorialCost { variable: v } => [v]
    v2.lens.cost.SumCost { lhs: lhs, rhs: rhs } =>
      concat(
        complexity_variables_from_cost(cost: lhs),
        complexity_variables_from_cost(cost: rhs)
      )
    v2.lens.cost.ProductCost { lhs: lhs, rhs: rhs } =>
      concat(
        complexity_variables_from_cost(cost: lhs),
        complexity_variables_from_cost(cost: rhs)
      )
    v2.lens.cost.UnknownCost { diagnostic: _ } => std.algebra.Empty
  }
}

fn complexity_bound_from_sized_class(
  class: v2.lens.cost.AsymptoticClass,
  variables: ComplexityVariables
) -> ComplexityBound {
  match class {
    v2.lens.cost.ClassConstant => ConstantComplexity
    v2.lens.cost.ClassLog => SizedComplexity { class: SizedLogClass, variables: variables }
    v2.lens.cost.ClassLinear => SizedComplexity { class: SizedLinearClass, variables: variables }
    v2.lens.cost.ClassLinearithmic => SizedComplexity { class: SizedLinearithmicClass, variables: variables }
    v2.lens.cost.ClassPolynomial { degree: d } =>
      SizedComplexity { class: SizedPolynomialClass { degree: d }, variables: variables }
    v2.lens.cost.ClassPolyLog { exponent: e } =>
      SizedComplexity { class: SizedPolyLogClass { exponent: e }, variables: variables }
    v2.lens.cost.ClassExponential => SizedComplexity { class: SizedExponentialClass, variables: variables }
    v2.lens.cost.ClassFactorial => SizedComplexity { class: SizedFactorialClass, variables: variables }
    v2.lens.cost.ClassUnknown => unknown_complexity()
  }
}

fn complexity_bound_from_cost(cost: v2.lens.cost.SymbolicCost) -> ComplexityBound {
  match cost {
    v2.lens.cost.UnknownCost { diagnostic: d } =>
      unknown_complexity_with_diagnostic(diagnostic: d)
    _ =>
      complexity_bound_from_sized_class(
        class: v2.lens.cost.asymptotic_class_of_cost(cost: cost),
        variables: complexity_variables_from_cost(cost: cost)
      )
  }
}

fn complexity_projection_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^complexity_reason_unmodeled_cost_projection,
    at: v2.std.diagnostic.Textual { file: ^complexity_projection_virtual_file, extent: v2.std.diagnostic.WholeFile },
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.AmbiguousIntent }
  }
}

fn asymptotic_projection(cost_witness: Witness<v2.lens.cost.SymbolicCost>) -> ComplexityBound {
  match cost_witness {
    v2.std.witness.Holds { value: cost } =>
      complexity_bound_from_cost(cost: cost)
    v2.std.witness.Violates { diagnostic: d } =>
      unknown_complexity_with_diagnostic(diagnostic: d)
  }
}

fn complexity_lens(n: v2.std.node.Node) -> ComplexityBound {
  asymptotic_projection(cost_witness: v2.lens.cost.cost_lens(n: n))
}

fn complexity_bound_class(b: ComplexityBound) -> v2.lens.cost.AsymptoticClass {
  match b {
    ConstantComplexity => v2.lens.cost.ClassConstant
    SizedComplexity { class: c, variables: _ } => asymptotic_class_from_sized_class(class: c)
    UnknownComplexity { diagnostic: _ } => v2.lens.cost.ClassUnknown
  }
}

fn asymptotic_class_from_sized_class(class: SizeIndexedAsymptoticClass) -> v2.lens.cost.AsymptoticClass {
  match class {
    SizedLogClass => v2.lens.cost.ClassLog
    SizedLinearClass => v2.lens.cost.ClassLinear
    SizedLinearithmicClass => v2.lens.cost.ClassLinearithmic
    SizedPolynomialClass { degree: d } => v2.lens.cost.ClassPolynomial { degree: d }
    SizedPolyLogClass { exponent: e } => v2.lens.cost.ClassPolyLog { exponent: e }
    SizedExponentialClass => v2.lens.cost.ClassExponential
    SizedFactorialClass => v2.lens.cost.ClassFactorial
  }
}

fn complexity_bound_dominates(a: ComplexityBound, b: ComplexityBound) -> Bool {
  match a {
    UnknownComplexity { diagnostic: _ } => true
    ConstantComplexity =>
      match b {
        ConstantComplexity => true
        _ => false
      }
    SizedComplexity { class: ac, variables: av } =>
      match b {
        UnknownComplexity { diagnostic: _ } => false
        ConstantComplexity => true
        SizedComplexity { class: bc, variables: bv } =>
          if av == bv {
            v2.lens.cost.asymptotic_class_dominates(
              a: asymptotic_class_from_sized_class(class: ac),
              b: asymptotic_class_from_sized_class(class: bc)
            )
          } else {
            false
          }
      }
  }
}

data construction_justification: v2.lens.common.construction_justification.ConstructionJustification = v2.lens.common.construction_justification.ConstructionJustification {
  class: v2.lens.common.construction_justification.RatchetForever
}
