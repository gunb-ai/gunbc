module v2.lens.complexity


fn complexity_variables_admits(xs: List<SizeVariable>) -> Bool {
  true
}

data complexity_variables_validation: Validation<List<SizeVariable>> = Validation {
  reason: ^complexity_variables_invalid,
  admits: complexity_variables_admits
}

data complexity_variables_vacuous_validation: VacuousValidation<List<SizeVariable>> = VacuousValidation {
  reason: ^complexity_variables_invalid,
  vacuous: vacuous_admits_marker
}

fn complexity_projection_locus() -> Locus {
  Textual { file: ^complexity_projection_virtual_file, extent: WholeFile }
}

fn complexity_variables_from_refine(xs: List<SizeVariable>) -> Witness<ComplexityVariables> {
  match refine(base: xs, by: complexity_variables_validation, at: complexity_projection_locus()) {
    Accepted { value: refined, diagnostics: _ } => Holds { value: refined }
    Rejected { diagnostics } => Violates { diagnostic: diagnostics.head }
  }
}

fn complexity_variables_unwrap_refine(xs: List<SizeVariable>) -> ComplexityVariables {
  match complexity_variables_from_refine(xs: xs) {
    Holds { value: variables } => variables

    Violates { diagnostic: _ } =>
      refined_vacuous_stub_pack(
        base: xs,
        by: complexity_variables_vacuous_validation,
        at: complexity_projection_locus()
      )
  }
}

type ComplexityVariables = Refined<List<SizeVariable>>

type SizeIndexedAsymptoticClass
  = SizedLogClass
  | SizedLinearClass
  | SizedLinearithmicClass
  | SizedPolynomialClass { degree: PolynomialDegree }
  | SizedPolyLogClass { exponent: PolyLogExponent }
  | SizedExponentialClass
  | SizedFactorialClass

type ComplexityBound
  = ConstantComplexity
  | SizedComplexity { class: SizeIndexedAsymptoticClass, variables: ComplexityVariables }
  | UnknownComplexity { diagnostic: Diagnostic }

fn unknown_complexity() -> ComplexityBound {
  UnknownComplexity { diagnostic: complexity_projection_diagnostic() }
}

fn single_complexity_variable(size_var: SizeVariable) -> ComplexityVariables {
  complexity_variables_unwrap_refine(xs: [size_var])
}

fn empty_complexity_variables() -> ComplexityVariables {
  complexity_variables_unwrap_refine(xs: Empty)
}

fn composite_complexity_variables(
  lhs: ComplexityVariables,
  rhs: ComplexityVariables
) -> ComplexityVariables {
  complexity_variables_unwrap_refine(
    xs: concat(refined_base(r: lhs), refined_base(r: rhs))
  )
}

fn sized_complexity(
  class: SizeIndexedAsymptoticClass,
  variables: ComplexityVariables
) -> ComplexityBound {
  SizedComplexity { class: class, variables: variables }
}

fn linear_complexity(size_var: SizeVariable) -> ComplexityBound {
  sized_complexity(
    class: SizedLinearClass,
    variables: single_complexity_variable(size_var: size_var)
  )
}

fn polynomial_complexity(
  size_var: SizeVariable,
  degree: PolynomialDegree
) -> ComplexityBound {
  sized_complexity(
    class: SizedPolynomialClass { degree: degree },
    variables: single_complexity_variable(size_var: size_var)
  )
}

fn multidimensional_polynomial_complexity(
  variables: ComplexityVariables,
  degree: PolynomialDegree
) -> ComplexityBound {
  sized_complexity(class: SizedPolynomialClass { degree: degree }, variables: variables)
}

fn unknown_complexity_with_diagnostic(diagnostic: Diagnostic) -> ComplexityBound {
  UnknownComplexity { diagnostic: diagnostic }
}

fn combine_complexity_variables(
  lhs: Witness<ComplexityVariables>,
  rhs: Witness<ComplexityVariables>
) -> Witness<ComplexityVariables> {
  match lhs {
    Holds { value: lv } =>
      match rhs {
        Holds { value: rv } =>
          Holds { value: composite_complexity_variables(lhs: lv, rhs: rv) }
        Violates { diagnostic: d } => Violates { diagnostic: d }
      }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn complexity_variables_from_cost(cost: SymbolicCost) -> Witness<ComplexityVariables> {
  match cost {
    ConstantCost { value: _ } =>
      Holds { value: empty_complexity_variables() }
    LogCost { variable: v } =>
      Holds { value: single_complexity_variable(size_var: v) }
    LinearCost { variable: v } =>
      Holds { value: single_complexity_variable(size_var: v) }
    PolynomialCost { variable: v, degree: _ } =>
      Holds { value: single_complexity_variable(size_var: v) }
    PolyLogCost { variable: v, exponent: _ } =>
      Holds { value: single_complexity_variable(size_var: v) }
    ExponentialCost { variable: v, base: _ } =>
      Holds { value: single_complexity_variable(size_var: v) }
    FactorialCost { variable: v } =>
      Holds { value: single_complexity_variable(size_var: v) }
    SumCost { lhs: lhs, rhs: rhs } =>
      combine_complexity_variables(
        lhs: complexity_variables_from_cost(cost: lhs),
        rhs: complexity_variables_from_cost(cost: rhs)
      )
    ProductCost { lhs: lhs, rhs: rhs } =>
      combine_complexity_variables(
        lhs: complexity_variables_from_cost(cost: lhs),
        rhs: complexity_variables_from_cost(cost: rhs)
      )
    UnknownCost { diagnostic: d } =>
      Violates { diagnostic: d }
  }
}

fn complexity_bound_from_class(
  class: AsymptoticClass,
  variables: Witness<ComplexityVariables>
) -> ComplexityBound {
  match class {
    ClassConstant => ConstantComplexity
    ClassUnknown =>
      match variables {
        Holds { value: _ } => unknown_complexity()
        Violates { diagnostic: d } => unknown_complexity_with_diagnostic(diagnostic: d)
      }
    _ =>
      match variables {
        Holds { value: v } => complexity_bound_from_sized_class(class: class, variables: v)
        Violates { diagnostic: d } => unknown_complexity_with_diagnostic(diagnostic: d)
      }
  }
}

fn complexity_bound_from_sized_class(
  class: AsymptoticClass,
  variables: ComplexityVariables
) -> ComplexityBound {
  match class {
    ClassConstant => ConstantComplexity
    ClassLog => SizedComplexity { class: SizedLogClass, variables: variables }
    ClassLinear => SizedComplexity { class: SizedLinearClass, variables: variables }
    ClassLinearithmic => SizedComplexity { class: SizedLinearithmicClass, variables: variables }
    ClassPolynomial { degree: d } =>
      SizedComplexity { class: SizedPolynomialClass { degree: d }, variables: variables }
    ClassPolyLog { exponent: e } =>
      SizedComplexity { class: SizedPolyLogClass { exponent: e }, variables: variables }
    ClassExponential => SizedComplexity { class: SizedExponentialClass, variables: variables }
    ClassFactorial => SizedComplexity { class: SizedFactorialClass, variables: variables }
    ClassUnknown => unknown_complexity()
  }
}

fn complexity_bound_from_cost(cost: SymbolicCost) -> ComplexityBound {
  complexity_bound_from_class(
    class: asymptotic_class_of_cost(cost: cost),
    variables: complexity_variables_from_cost(cost: cost)
  )
}

fn complexity_projection_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^complexity_reason_unmodeled_cost_projection,
    at: Textual { file: ^complexity_projection_virtual_file, extent: WholeFile },
    correction: Unavailable { reason: AmbiguousIntent }
  }
}

fn asymptotic_projection(cost_witness: Witness<SymbolicCost>) -> Witness<ComplexityBound> {
  match cost_witness {
    Holds { value: cost } =>
      Holds { value: complexity_bound_from_cost(cost: cost) }
    Violates { diagnostic: d } =>
      Violates { diagnostic: d }
  }
}

fn complexity_lens(n: Node) -> Witness<ComplexityBound> {
  asymptotic_projection(cost_witness: cost_lens(n: n))
}

fn complexity_bound_class(b: ComplexityBound) -> AsymptoticClass {
  match b {
    ConstantComplexity => ClassConstant
    SizedComplexity { class: c, variables: _ } => asymptotic_class_from_sized_class(class: c)
    UnknownComplexity { diagnostic: _ } => ClassUnknown
  }
}

fn asymptotic_class_from_sized_class(class: SizeIndexedAsymptoticClass) -> AsymptoticClass {
  match class {
    SizedLogClass => ClassLog
    SizedLinearClass => ClassLinear
    SizedLinearithmicClass => ClassLinearithmic
    SizedPolynomialClass { degree: d } => ClassPolynomial { degree: d }
    SizedPolyLogClass { exponent: e } => ClassPolyLog { exponent: e }
    SizedExponentialClass => ClassExponential
    SizedFactorialClass => ClassFactorial
  }
}

fn complexity_bound_dominates(a: ComplexityBound, b: ComplexityBound) -> Bool {
  match a {
    UnknownComplexity { diagnostic: _ } => true
    ConstantComplexity =>
      match b {
        ConstantComplexity => true
        _ => false
      }
    SizedComplexity { class: ac, variables: av } =>
      match b {
        UnknownComplexity { diagnostic: _ } => false
        ConstantComplexity => true
        SizedComplexity { class: bc, variables: bv } =>
          if refined_base(r: av) == refined_base(r: bv) {
            asymptotic_class_dominates(
              a: asymptotic_class_from_sized_class(class: ac),
              b: asymptotic_class_from_sized_class(class: bc)
            )
          } else {
            false
          }
      }
  }
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: RatchetForever
}
