module v2.test.lens_complexity_rewrite.loop_invariant_hoist

import v2.lens.complexity_rewrite { cost_is_nested_product, cost_is_rewritable, minimized_class }
import v2.lens.cost {
  LinearCost,
  ProductCost,
  SizeVariable,
  SumCost,
  SymbolicCost,
  asymptotic_class_dominates,
  asymptotic_class_of_cost
}
import v2.std.node { Atom, Node, Symbol, TypeNode, node_synthetic }
import v2.std.logic { Bool }

fn leaf(id: Symbol) -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: id } }, children: [])
}

data quadratic_cost: SymbolicCost = ProductCost {
  lhs: LinearCost { variable: SizeVariable { source: leaf(id: ^outer) } },
  rhs: LinearCost { variable: SizeVariable { source: leaf(id: ^inner) } }
}
data linear_cost: SymbolicCost = LinearCost { variable: SizeVariable { source: leaf(id: ^single) } }
data sum_cost: SymbolicCost = SumCost {
  lhs: LinearCost { variable: SizeVariable { source: leaf(id: ^a) } },
  rhs: LinearCost { variable: SizeVariable { source: leaf(id: ^b) } }
}

test fn quadratic_is_nested_product() -> Bool {
  cost_is_nested_product(c: quadratic_cost)
}
test fn quadratic_is_rewritable() -> Bool {
  cost_is_rewritable(c: quadratic_cost)
}
test fn quadratic_minimizes_strictly_below_realized() -> Bool {
  asymptotic_class_dominates(
    a: asymptotic_class_of_cost(cost: quadratic_cost),
    b: minimized_class(c: quadratic_cost)
  )
  && !asymptotic_class_dominates(
    a: minimized_class(c: quadratic_cost),
    b: asymptotic_class_of_cost(cost: quadratic_cost)
  )
}

test fn linear_not_rewritable() -> Bool {
  !cost_is_rewritable(c: linear_cost)
}
test fn sum_of_linears_not_rewritable() -> Bool {
  !cost_is_rewritable(c: sum_cost)
}
test fn linear_minimized_unchanged() -> Bool {
  asymptotic_class_dominates(
    a: minimized_class(c: linear_cost),
    b: asymptotic_class_of_cost(cost: linear_cost)
  )
  && asymptotic_class_dominates(
    a: asymptotic_class_of_cost(cost: linear_cost),
    b: minimized_class(c: linear_cost)
  )
}
