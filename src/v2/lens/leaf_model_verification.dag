// --- PY-L2-CROSS-RUNTIME-DRIFT — positive cross-runtime divergence receipt ---
// The same modeled program — exact integer add at the fixed-width boundary, `MAX + 1` — realized
// in each target's native integer. Python's Int is arbitrary precision, so it prints the exact sum
// (9223372036854775808). Rust `i64` and Go `int64` are fixed-width two's-complement, so the same add
// wraps to i64::MIN (-9223372036854775808). The runner asserts the drift POSITIVELY: python_value !=
// rust_value (and != go_value when Go is present), while rust_value == go_value (cross-runtime
// fixed-width agreement). Rust uses `wrapping_add` so the boundary is defined behavior (no debug
// overflow panic); Go signed overflow is defined to wrap by the language spec. Complement of the L2
// parity lane (PR #4154), which asserts EQUALITY on the common domain.
data python_cross_runtime_drift_python_source: String = "def add_exact(a: int, b: int) -> int:\n    return a + b\n\nif __name__ == \"__main__\":\n    print(add_exact((2 ** 63) - 1, 1))\n"

data python_cross_runtime_drift_rust_source: String = "fn add_exact(a: i64, b: i64) -> i64 { a.wrapping_add(b) }\nfn main() {\n    println!(\"{}\", add_exact(i64::MAX, 1));\n}\n"

data python_cross_runtime_drift_go_source: String = "package main\n\nimport (\n\t\"fmt\"\n\t\"math\"\n)\n\nfunc addExact(a int64, b int64) int64 { return a + b }\n\nfunc main() {\n\tfmt.Println(addExact(math.MaxInt64, 1))\n}\n"

// Arbitrary-precision (Python) value vs fixed-width wrapped (Rust/Go) value — the modeled divergence.
data python_cross_runtime_drift_arbitrary_precision_value: String = "9223372036854775808"

data python_cross_runtime_drift_fixed_width_value: String = "-9223372036854775808"

fn python_cross_runtime_drift_probe() -> LeafModelCrossRuntimeDriftProbe {
  LeafModelCrossRuntimeDriftProbe {
    claim_id: leaf_model_claim_python_cross_runtime_drift_arbitrary_precision,
    arbitrary_precision_fact: ^python_repr_int_arbitrary_precision,
    fixed_width_rust_fact: ^rust_repr_integer_twos_complement,
    fixed_width_go_fact: ^go_repr_twos_complement_integer,
    arbitrary_precision_source: python_cross_runtime_drift_python_source,
    fixed_width_rust_source: python_cross_runtime_drift_rust_source,
    fixed_width_go_source: python_cross_runtime_drift_go_source,
    expected_divergence: ValueDiff {
      expected: python_cross_runtime_drift_arbitrary_precision_value,
      actual: python_cross_runtime_drift_fixed_width_value
    }
  }
}

// --- PY-L2-CROSS-TARGET-PARITY probes (Worksheet C) — positive complement of the drift probe ---
// Common-domain R2a: small-value integer add. The value (5) sits inside the subdomain where
// arbitrary-precision (Python) and two's-complement (Rust/Go) realizations coincide, so all three
// print the identical decimal payload. Same three target sources family as the drift probe, but the
// operand stays away from the fixed-width boundary, so the outcome is PARITY not divergence.
data python_l2_parity_r2a_python_source: String = "def add_small(a: int, b: int) -> int:\n    return a + b\n\nif __name__ == \"__main__\":\n    print(add_small(2, 3))\n"
data python_l2_parity_r2a_rust_source: String = "fn add_small(a: i64, b: i64) -> i64 { a + b }\nfn main() {\n    println!(\"{}\", add_small(2, 3));\n}\n"
data python_l2_parity_r2a_go_source: String = "package main\n\nimport \"fmt\"\n\nfunc addSmall(a int64, b int64) int64 { return a + b }\n\nfunc main() {\n\tfmt.Println(addSmall(2, 3))\n}\n"
data python_l2_parity_r2a_value: String = "5"

// Common-domain R3-external: Symbol nominal/value projection. All three construct a one-field
// Symbol carrying the nominal payload "x" and print its projection, yielding the identical display.
data python_l2_parity_r3_python_source: String = "class Symbol:\n    def __init__(self, value: str):\n        self.value = value\n\ndef project() -> str:\n    return Symbol(\"x\").value\n\nif __name__ == \"__main__\":\n    print(project())\n"
data python_l2_parity_r3_rust_source: String = "struct Symbol { value: String }\nfn project() -> String { Symbol { value: \"x\".to_string() }.value }\nfn main() {\n    println!(\"{}\", project());\n}\n"
data python_l2_parity_r3_go_source: String = "package main\n\nimport \"fmt\"\n\ntype Symbol struct { value string }\n\nfunc project() string { return Symbol{ value: \"x\" }.value }\n\nfunc main() {\n\tfmt.Println(project())\n}\n"
data python_l2_parity_r3_value: String = "x"

fn python_l2_parity_r2a_probe() -> LeafModelCrossTargetParityProbe {
  LeafModelCrossTargetParityProbe {
    claim_id: leaf_model_claim_python_l2_cross_target_parity_r2a_add,
    python_fact: ^python_repr_int_arbitrary_precision,
    rust_fact: ^rust_repr_integer_twos_complement,
    go_fact: ^go_repr_twos_complement_integer,
    python_source: python_l2_parity_r2a_python_source,
    rust_source: python_l2_parity_r2a_rust_source,
    go_source: python_l2_parity_r2a_go_source,
    expected_parity: ValueDiff {
      expected: python_l2_parity_r2a_value,
      actual: python_l2_parity_r2a_value
    }
  }
}

fn python_l2_parity_r3_probe() -> LeafModelCrossTargetParityProbe {
  LeafModelCrossTargetParityProbe {
    claim_id: leaf_model_claim_python_l2_cross_target_parity_r3_symbol_projection,
    python_fact: ^python_atom_realization_symbol,
    rust_fact: ^rust_atom_realization_symbol,
    go_fact: ^go_atom_realization_symbol,
    python_source: python_l2_parity_r3_python_source,
    rust_source: python_l2_parity_r3_rust_source,
    go_source: python_l2_parity_r3_go_source,
    expected_parity: ValueDiff {
      expected: python_l2_parity_r3_value,
      actual: python_l2_parity_r3_value
    }
  }
}

fn python_l2_parity_probe_roster() -> List<LeafModelCrossTargetParityProbe> {
  [
    python_l2_parity_r2a_probe(),
    python_l2_parity_r3_probe()
  ]
}

