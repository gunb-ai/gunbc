data go_r2b_falsification_fixture_source: String = "package main\n\nimport \"math\"\n\nfunc main() {\n    var x int64 = math.MaxInt64\n    got := x + 1\n    want := int64(0)\n    if got != want {\n        panic(\"deliberately wrong expected wrap value\")\n    }\n}\n"

