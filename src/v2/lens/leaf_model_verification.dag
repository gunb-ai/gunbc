// Construction-justification (DESIGN sec 5/sec 6, ROADMAP sec 0): why this is a lens
// (validation) and not construction. Layered ON TOP of the #5433 inert-lens backstop.
data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding {
    grounding_authority: "T-22 run_target_verification -- behavioral host-exec verdicts",
    dissolve_on: "emitted-code behavior is verified by host execution (R1-R3 fixtures run), replacing the structural pair-readiness witness"
  },
  rationale: "For the specific R1-R3 fixtures, emitted-code behavior is decidable by execution; the structural pair-readiness witness is the interim floor guarantee until behavioral host-exec (T-22) lands."
}
