type WitnessCostLocality
  = Local
  | CouplesToAmbient {
      data_breadth_carriers: List<String>,
      layer_depth_stages: List<String>
    }

fn module_list_intersect(xs: List<String>, ys: List<String>) -> List<String> {
  filter(xs: xs, predicate: fn(x) { contains(xs: ys, item: x, eq: fn(a, b) { a == b }) })
}

fn data_breadth_evidence(closure_modules: List<String>, carriers: List<String>) -> List<String> {
  module_list_intersect(xs: closure_modules, ys: carriers)
}

fn layer_depth_evidence(closure_modules: List<String>, stages: List<String>) -> List<String> {
  let hits = module_list_intersect(xs: closure_modules, ys: stages)
  if length(xs: hits) >= 2 { hits } else { [] }
}

fn witness_cost_locality(
  closure_modules: List<String>,
  ambient_read_carriers: List<String>,
  pipeline_stages: List<String>
) -> WitnessCostLocality {
  let db = data_breadth_evidence(closure_modules: closure_modules, carriers: ambient_read_carriers)
  let ld = layer_depth_evidence(closure_modules: closure_modules, stages: pipeline_stages)
  if length(xs: db) == 0 && length(xs: ld) == 0 {
    Local
  } else {
    CouplesToAmbient { data_breadth_carriers: db, layer_depth_stages: ld }
  }
}

fn locality_is_local(verdict: WitnessCostLocality) -> Bool {
  match verdict {
    Local => true
    CouplesToAmbient { data_breadth_carriers: _, layer_depth_stages: _ } => false
  }
}

fn couples_on_data_breadth(verdict: WitnessCostLocality) -> Bool {
  match verdict {
    Local => false
    CouplesToAmbient { data_breadth_carriers: db, layer_depth_stages: _ } => length(xs: db) > 0
  }
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SingleAuthority }
}

fn couples_on_layer_depth(verdict: WitnessCostLocality) -> Bool {
  match verdict {
    Local => false
    CouplesToAmbient { data_breadth_carriers: _, layer_depth_stages: ld } => length(xs: ld) > 0
  }
}

data import_closure_law: String = "Module-grain closure of the declared import facts, the |E|-sweeps fixpoint shape sanctioned by v2.lens.affected_set (pass + frontier-stability + doubled-facts fuel, early-stable): bounded and forward per DESIGN 4, terminates on cyclic FACT rows (the substrate refuses cyclic imports, but the fold must not trust its input). This is the fact half the v0 verdict fns were missing: witness_cost_locality_from_facts closes over the declared facts so the transitive carrier case (the enforcement_live falsification - the corpus read two hops away through v2.workflow.enforcement_live) is provable in fixtures, not just prose."

data per_pr_admission_law: String = "Admission matrix (verdict x declared envelope), fail-closed with declaration-wins-when-stricter: DeclaredCorpusInput routes to the scheduled lane regardless of the reachability verdict (an honest self-declaration is stricter than a Local read and never argued with); DeclaredBoundedFixture admits continuously even when reachability couples (the hermetic override - reachability over-approximates; the declaration is the authority and the scheduled falsifier lane is its audit); EnvelopeUndeclared admits only a Local verdict - undeclared plus evidence of ambient coupling never rides the continuous floor (the refused_undeclared_when_envelope_unknown shape from InputEnvelope P0). RouteScheduledLane is a typed routing verdict, never a silent drop: the scheduled (nightly) lane runs what the per-PR floor does not."

type ModuleImportFact {
  module: String
  imports: List<String>
}

type ImportClosureFixpointState {
  members: List<String>
  stable: Bool
}

fn string_member(xs: List<String>, x: String) -> Bool {
  contains(xs: xs, item: x, eq: fn(a, b) { a == b })
}

fn import_closure_add_absent(members: List<String>, candidate: String) -> List<String> {
  if string_member(xs: members, x: candidate) {
    members
  } else {
    list_snoc_item(xs: members, item: candidate)
  }
}

fn import_closure_pass(facts: List<ModuleImportFact>, members: List<String>) -> List<String> {
  fold_list(xs: facts, empty: members, cons: fn(acc, fact) {
    if string_member(xs: acc, x: fact.module) {
      fold_list(xs: fact.imports, empty: acc, cons: fn(inner, im) {
        import_closure_add_absent(members: inner, candidate: im)
      })
    } else {
      acc
    }
  })
}

fn import_closure_frontier_unchanged(before: List<String>, after: List<String>) -> Bool {
  length(xs: before) == length(xs: after)
}

fn import_closure_fixpoint_step(
  facts: List<ModuleImportFact>,
  state: ImportClosureFixpointState
) -> ImportClosureFixpointState {
  if state.stable {
    state
  } else {
    let next = import_closure_pass(facts: facts, members: state.members)
    ImportClosureFixpointState {
      members: next,
      stable: import_closure_frontier_unchanged(before: state.members, after: next)
    }
  }
}

fn witness_import_closure(root: String, facts: List<ModuleImportFact>) -> List<String> {
  let rounds = list_append(left: facts, right: facts)
  let state = fold_list(xs: rounds, empty: ImportClosureFixpointState { members: [root], stable: false }, cons: fn(acc, ignored) {
    import_closure_fixpoint_step(facts: facts, state: acc)
  })
  state.members
}

fn witness_cost_locality_from_facts(
  entry_module: String,
  facts: List<ModuleImportFact>,
  ambient_read_carriers: List<String>,
  pipeline_stages: List<String>
) -> WitnessCostLocality {
  witness_cost_locality(
    closure_modules: witness_import_closure(root: entry_module, facts: facts),
    ambient_read_carriers: ambient_read_carriers,
    pipeline_stages: pipeline_stages
  )
}

type WitnessInputEnvelope
  = DeclaredBoundedFixture
  | DeclaredCorpusInput
  | EnvelopeUndeclared

type PerPrAdmission
  = AdmitContinuous
  | RouteScheduledLane {
      verdict: WitnessCostLocality,
      envelope: WitnessInputEnvelope
    }

fn per_pr_admission(verdict: WitnessCostLocality, envelope: WitnessInputEnvelope) -> PerPrAdmission {
  match envelope {
    DeclaredCorpusInput => RouteScheduledLane { verdict: verdict, envelope: envelope }
    DeclaredBoundedFixture => AdmitContinuous
    EnvelopeUndeclared =>
      match verdict {
        Local => AdmitContinuous
        CouplesToAmbient { data_breadth_carriers: _, layer_depth_stages: _ } =>
          RouteScheduledLane { verdict: verdict, envelope: envelope }
      }
  }
}

fn admission_is_continuous(admission: PerPrAdmission) -> Bool {
  match admission {
    AdmitContinuous => true
    RouteScheduledLane { verdict: _, envelope: _ } => false
  }
}
