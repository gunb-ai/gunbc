module v2.lens.fn_index_depth_agreement

import v2.lens.common.construction_justification { ConstructionJustification, RatchetForever }
import std.process { ExitSuccess, ProcessExit, exit_failure }
import v2.std.algebra { any, contains, fold_list, length, list_snoc_item }
import v2.std.collection { Absent, List, Present }
import v2.std.grammar { node_atom_identity_optional }
import v2.std.logic { Bool }
import v2.std.node { Edge, Node, NodeFold, Symbol, fold_node, node_subtree_count }
import v2.std.node_query { call_callee_target, node_is_call }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.text { String }
import v2.std.fn_index {
  FnArrowDecl,
  atom_identities_in_node,
  atom_identities_in_subtree,
  callees_from_node,
  fn_arrow_decl_facts_live,
  param_names_of
}

// THE INSTRUMENT BEHIND TWO CLAIMS IN v2.std.fn_index, so that neither is a transcribed number.
//
// CLAIM ONE — the depth-one `atom_identities_in_node` is extensionally the fold_node reader that
// #10156 replaced. `legacy_atoms` below is that reader reconstructed exactly, discarded child atoms
// and all; `disagreeing_with_legacy` is the count of live declarations on which the two differ, and
// it is what the exit verdict reads. This is the claim's discriminating control: change either
// reader's grain and the run refuses.
//
// CLAIM TWO — depth one is the wrong grain at a declaration ROOT. `root_callees_lost_to_depth_one`
// counts live declarations whose callees are invisible to a depth-one read of `decl.output` but
// visible to a transitive one. It is the population `call_reachable_decls` could not leave before
// `callees_from_node` was moved onto `atom_identities_in_subtree`.
//
// CLAIM THREE -- the size of the over-approximation the deeper read inherits.
// `param_collisions` counts live declarations that reference one of their OWN parameters by a
// lexeme that also names a declaration, which is the one sender in the shared atom channel that
// `callees_from_node` can now exclude from declared structure. It is the population that would
// become false call edges without that exclusion; the residue (record constructors, variant
// values, non-path literals) is not measurable here for the same reason it is not excludable --
// the skeleton gives it no distinguishing shape.
//
// NOT A FLOOR WITNESS AND DELIBERATELY NOT ONE. It reads `fn_arrow_decl_facts_live` over the two
// source roots the required lanes pass, and that whole-tree cost is the standing blocker recorded in
// v2.test.claim.enforcement.determinism_transitive_witness; enrolling a whole-corpus subject on the
// per-subject line would repeat exactly the finding that file documents. The grain claims are held
// at the floor by fixture rows there; this is the re-derivation entry point for the corpus numbers.
data construction_justification: ConstructionJustification = ConstructionJustification {
  class: RatchetForever
}

data empty_symbol_list: List<Symbol> = []
data empty_string_list: List<String> = []
data no_terminal_callees: List<String> = []

// THE SUBJECT IS CALLER-NAMED SINCE gunbc#10245, so this instrument states the pools it measures
// rather than inheriting whatever the acquisition used to walk. These are the two source roots the
// required lanes pass, which is the population every claim in this repository is judged over.
data agreement_pool_roots: List<String> = ["dag", "src/v2"]
data agreement_pool_files: List<String> = []

fn agreement_symbol_eq(a: Symbol, b: Symbol) -> Bool {
  a == b
}

fn snoc_unique(xs: List<Symbol>, sym: Symbol) -> List<Symbol> {
  if contains(xs: xs, item: sym, eq: agreement_symbol_eq) {
    xs
  } else {
    list_snoc_item(xs: xs, item: sym)
  }
}

type LegacyAtomState {
  node: Node
  atoms: List<Symbol>
}

fn legacy_init(n: Node) -> LegacyAtomState {
  LegacyAtomState { node: n, atoms: empty_symbol_list }
}

fn legacy_step(acc: LegacyAtomState, _edge: Edge, child: LegacyAtomState) -> LegacyAtomState {
  let atoms = match node_atom_identity_optional(node: child.node) {
    Present { value: sym } => snoc_unique(xs: acc.atoms, sym: sym)
    Absent => acc.atoms
  }
  LegacyAtomState { node: acc.node, atoms: atoms }
}

fn legacy_atoms(node: Node) -> List<Symbol> {
  let from_descendants = fold_node(
    n: node,
    algebra: NodeFold { init: legacy_init, step: legacy_step }
  ).atoms
  match node_atom_identity_optional(node: node) {
    Present { value: sym } => snoc_unique(xs: from_descendants, sym: sym)
    Absent => from_descendants
  }
}

fn agreement_string_eq(a: String, b: String) -> Bool {
  a == b
}

fn decl_named(decls: List<FnArrowDecl>, name: String) -> Bool {
  any(xs: decls, predicate: fn(d) { agreement_string_eq(a: d.name, b: name) })
}

fn param_collides_with_a_declaration(
  decl: FnArrowDecl,
  decls: List<FnArrowDecl>
) -> Bool {
  any(
    xs: param_names_of(decl: decl),
    predicate: fn(pname) { decl_named(decls: decls, name: pname) }
  )
}

// THE CALL-CHANNEL READER THE #10282 CARRIER MADE POSSIBLE, measured beside the atom scan rather
// than swapped in on the strength of the trigger having fired. The counts below are the sharpest
// form of the question review 60065 asks: how many nodes of a LIVE fn-arrow skeleton does
// `node_is_call` accept at all, and of those, how many yield a callee lexeme through
// `call_callee_target`. A zero in the first column is not a small over-approximation traded for a
// small under-approximation -- it is a reader that cannot see any edge on this substrate.
//
// COUNTED AS Int, NOT COLLECTED AS A LIST, deliberately. The first form of this measurement
// deduplicated lexemes with a linear `contains` inside a per-node fold, which is quadratic in the
// accumulated list over a 60k-node corpus and did not terminate in twenty minutes. A cost shape
// that bad is fixed rather than tolerated even in an instrument (DESIGN section 6, bare minimum
// cost), and the distinct-callee refinement buys nothing a raw count does not already decide.
type ChannelState {
  node: Node
  call_nodes: Int
  resolved_callees: Int
}

fn channel_init(n: Node) -> ChannelState {
  ChannelState { node: n, call_nodes: 0, resolved_callees: 0 }
}

fn node_is_call_shaped(node: Node) -> Int {
  match node_is_call(node: node) {
    true => 1
    false => 0
  }
}

// THE RESOLVED-CALLEE HALF IS GATED ON THE CALL-SHAPED HALF, and not merely as an optimization.
// `call_callee_target` builds a diagnostic-carrying `Accepted`/`Rejected` per node; calling it on
// all 60k nodes of the live skeleton ran 35 minutes at 9.8GB without finishing, which on a shared
// 64GiB slice is a hazard to other sessions, not just a slow instrument. It is also unnecessary:
// `node_is_call` is the precondition for a callee existing at all, so when the call-shaped count is
// zero the resolved count is zero WITHOUT evaluating the accessor, and when it is nonzero the
// accessor runs only on that population. The zero arm is the one that decides review 60065.
fn resolved_callee_count(node: Node) -> Int {
  if node_is_call(node: node) {
    match call_callee_target(node: node) {
      Accepted { value: callee, diagnostics: _ } =>
        match node_atom_identity_optional(node: callee) {
          Present { value: _sym } => 1
          Absent => 0
        }
      Rejected { diagnostics: _ } => 0
    }
  } else {
    0
  }
}

fn channel_step(acc: ChannelState, _edge: Edge, child: ChannelState) -> ChannelState {
  let child_shaped = node_is_call_shaped(node: child.node)
  let below_resolved = acc.resolved_callees + child.resolved_callees
  let child_resolved = if child_shaped > 0 { resolved_callee_count(node: child.node) } else { 0 }
  ChannelState {
    node: acc.node,
    call_nodes: acc.call_nodes + child.call_nodes + child_shaped,
    resolved_callees: below_resolved + child_resolved
  }
}

fn channel_subtree(node: Node) -> ChannelState {
  let below = fold_node(
    n: node,
    algebra: NodeFold { init: channel_init, step: channel_step }
  )
  let root_shaped = node_is_call_shaped(node: node)
  let root_resolved = if root_shaped > 0 { resolved_callee_count(node: node) } else { 0 }
  ChannelState {
    node: node,
    call_nodes: below.call_nodes + root_shaped,
    resolved_callees: below.resolved_callees + root_resolved
  }
}

// THE ONE-DECLARATION PROBE, because the question review 60065 raises is STRUCTURAL, not
// statistical. If `node_is_call` accepts no node of a live fn-arrow skeleton, it accepts none in
// any of them for the same reason, and one declaration exhibits that at a thousandth of the cost.
// `subtree_nodes` is carried beside `call_shaped` so the zero is readable: a zero over zero nodes
// would be an empty probe, and a zero over a populated subtree is the finding.
type FirstDeclChannel {
  decl_name: String
  subtree_nodes: Int
  call_shaped: Int
  atom_callees: Int
}

data empty_first_decl_channel: FirstDeclChannel = FirstDeclChannel {
  decl_name: "",
  subtree_nodes: 0,
  call_shaped: 0,
  atom_callees: 0
}

// FIRST BY FOLD, NOT BY LIST PATTERN, because a `[first, ...rest]` match arm is not admitted here
// -- the parser refuses it with `expected FatArrow, found LBracket`.
//
// THE GUARD IS `atom_callees`, NOT `subtree_nodes`, AND THE DIFFERENCE IS THE WHOLE PROBE. The
// corpus's first declaration is `add`, whose subtree is five nodes and which calls nothing; its
// call-shaped count and its atom-callee count are both zero, which discriminates nothing. The
// declaration this question needs is the first one the ATOM reader finds callees in, because only
// there does a zero from the CALL-CHANNEL reader mean the channel lost an edge the atom scan saw.
fn pick_first_decl(acc: FirstDeclChannel, decl: FnArrowDecl) -> FirstDeclChannel {
  if acc.atom_callees > 0 {
    acc
  } else {
    FirstDeclChannel {
      decl_name: decl.name,
      subtree_nodes: node_subtree_count(n: decl.output),
      call_shaped: channel_subtree(node: decl.output).call_nodes,
      atom_callees: length(
        xs: callees_from_node(
          node: decl.output,
          terminal_callee_symbols: no_terminal_callees,
          param_names: param_names_of(decl: decl)
        )
      )
    }
  }
}

fn first_decl_channel() -> FirstDeclChannel {
  let decls = fn_arrow_decl_facts_live(
    pool_roots: agreement_pool_roots,
    pool_files: agreement_pool_files
  )
  fold_list(xs: decls, empty: empty_first_decl_channel, cons: pick_first_decl)
}

type DepthAgreementTally {
  decls: Int
  disagreeing_with_legacy: Int
  depth_one_atom_total: Int
  subtree_atom_total: Int
  root_callees_lost_to_depth_one: Int
  param_collisions: Int
  channel_call_shaped_total: Int
  channel_callee_total: Int
  atom_callee_total: Int
  decls_channel_finds_fewer: Int
  decls_channel_finds_none_atom_some: Int
  subtree_node_total: Int
}

data empty_tally: DepthAgreementTally = DepthAgreementTally {
  decls: 0,
  disagreeing_with_legacy: 0,
  depth_one_atom_total: 0,
  subtree_atom_total: 0,
  root_callees_lost_to_depth_one: 0,
  param_collisions: 0,
  channel_call_shaped_total: 0,
  channel_callee_total: 0,
  atom_callee_total: 0,
  decls_channel_finds_fewer: 0,
  decls_channel_finds_none_atom_some: 0,
  subtree_node_total: 0
}

fn bump_when(count: Int, flag: Bool) -> Int {
  match flag {
    true => count + 1
    false => count
  }
}

fn tally_decl(
  acc: DepthAgreementTally,
  decl: FnArrowDecl,
  decls: List<FnArrowDecl>
) -> DepthAgreementTally {
  let depth_one = length(xs: atom_identities_in_node(node: decl.output))
  let legacy = length(xs: legacy_atoms(node: decl.output))
  let subtree = length(xs: atom_identities_in_subtree(node: decl.output))
  let channel = channel_subtree(node: decl.output)
  let channel_count = channel.resolved_callees
  let deep_callees = length(
    xs: callees_from_node(
      node: decl.output,
      terminal_callee_symbols: no_terminal_callees,
      param_names: param_names_of(decl: decl)
    )
  )
  DepthAgreementTally {
    decls: acc.decls + 1,
    disagreeing_with_legacy: bump_when(
      count: acc.disagreeing_with_legacy,
      flag: !(depth_one == legacy)
    ),
    depth_one_atom_total: acc.depth_one_atom_total + depth_one,
    subtree_atom_total: acc.subtree_atom_total + subtree,
    root_callees_lost_to_depth_one: bump_when(
      count: acc.root_callees_lost_to_depth_one,
      flag: depth_one == 0 && deep_callees > 0
    ),
    param_collisions: bump_when(
      count: acc.param_collisions,
      flag: param_collides_with_a_declaration(decl: decl, decls: decls)
    ),
    channel_call_shaped_total: acc.channel_call_shaped_total + channel.call_nodes,
    channel_callee_total: acc.channel_callee_total + channel_count,
    atom_callee_total: acc.atom_callee_total + deep_callees,
    decls_channel_finds_fewer: bump_when(
      count: acc.decls_channel_finds_fewer,
      flag: channel_count < deep_callees
    ),
    decls_channel_finds_none_atom_some: bump_when(
      count: acc.decls_channel_finds_none_atom_some,
      flag: channel_count == 0 && deep_callees > 0
    ),
    subtree_node_total: acc.subtree_node_total + node_subtree_count(n: decl.output)
  }
}

fn fn_index_depth_agreement_tally() -> DepthAgreementTally {
  let decls = fn_arrow_decl_facts_live(
    pool_roots: agreement_pool_roots,
    pool_files: agreement_pool_files
  )
  fold_list(
    xs: decls,
    empty: empty_tally,
    cons: fn(acc, decl) { tally_decl(acc: acc, decl: decl, decls: decls) }
  )
}

fn fn_index_depth_agreement() -> ProcessExit {
  let tally = fn_index_depth_agreement_tally()
  if tally.decls == 0 {
    exit_failure(
      reason: "fn_arrow_decl_facts_live returned no declarations; the agreement verdict would be vacuous"
    )
  } else if tally.disagreeing_with_legacy > 0 {
    exit_failure(
      reason: "atom_identities_in_node no longer agrees with the fold_node reader #10156 replaced"
    )
  } else {
    ExitSuccess
  }
}
