module v2.lens.vacuity_self_application_fixture

data vacuity_self_application_fixture_note: String = "Vacuity-owned self-application fixture (mandate item 7 + the consumer-witness roster, item 5). vacuity_test.dag's own test fn declarations cannot serve this role directly: v2.extdeps.languages.dag's dag_language_model() grammar has no lexer keyword or grammar production for `test` at all (confirmed by direct execution, see vacuity_bool_witness_real_corpus_note in v2.lens.vacuity), so every real `test fn` in the corpus rejects at the file-parse stage before a body is ever reached. This file uses an ordinary `fn` — the one declaration shape the modeled grammar accepts today. SECOND, INDEPENDENTLY CONFIRMED CEILING (see vacuity_bool_witness_body_lowering_ceiling_note in v2.lens.vacuity): a body that reduces to a bare top-level `==` statement (e.g. `1 == 1`, with or without `return`) does not survive normalize() under the current body-lowering implementation, on this branch AND on a pristine origin/main checkout, for both synthetic probes and byte-for-byte copies of real production code (src/v2/std/logic.dag, optional_absent's body) — confirmed by direct execution, not inferred. So a fn whose SOLE body is the literal-equality shape this classifier is designed to detect cannot itself be the parseable fixture target; the whole containing file would reject at normalize() before any function's body is ever inspected, exactly the ceiling item 2's own vacuity_bool_witness_real_corpus_note already documents for the `test`-keyword gap, now confirmed for this second body shape too. This fixture's fn body therefore uses a match-over-a-local-type shape instead (confirmed by direct execution to survive tokenize/parse_module/normalize cleanly, matching the shape v2.std.nat's nat_cata already uses in the real corpus) — a real fn reached by filesystem_read + tokenize/parse_module/normalize against the file on disk, not a synthetic in-memory Node, exercising the derived-site enumeration and the join reconciliation for real. Because no bare-equality body can reach this fixture, classify_unified_test_claim_vacuity honestly classifies this fn Unknown (never a fabricated ProvenDuplicate) — the join's admitted-exceptions roster is correspondingly empty (v2.test.claim.vacuity_consumer_witness_admitted_exceptions), and the classifier's ProvenDuplicate-detection logic itself is proven correct separately, by the direct-call RED control (vacuity_consumer_witness_pr7614_shape_red_control_classifies_proven_duplicate), which calls classify_vacuity_same_eval_record directly rather than through the parse pipeline — mechanism proven correct, real-corpus reachability separately ceilinged, per DESIGN.md §4b rung-honesty discipline."

type VacuitySelfApplicationProbeTag = VacuitySelfApplicationProbeYes | VacuitySelfApplicationProbeNo

fn vacuity_self_application_probe(tag: VacuitySelfApplicationProbeTag) -> Bool {
  match tag {
    VacuitySelfApplicationProbeYes => true
    VacuitySelfApplicationProbeNo => false
  }
}
