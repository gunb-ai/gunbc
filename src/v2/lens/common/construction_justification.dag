module v2.lens.common.construction_justification

import std.disposition { ConstructionMechanism }

import std.decl_ref { DeclarationRef }

// DESIGN section 4b column beside the ladder, not a fifth rung: external reality, undeclared
// intent, or a required subject/bound/equivalence the model does not represent. Observed, refused,
// or mitigated at a declared boundary — never a claim that the class can never climb.
type OutsideModeledGuaranteeReason
  = OpenWorldEvidence
  | UndeclaredIntent
  | CandidateUniverseUnbounded
  | SemanticEquivalenceNotRepresented
  | HumanPolicyJudgment

type ConstructionClass

  = WallNow { mechanism: ConstructionMechanism, authority: DeclarationRef }

  | WallAfterGrounding { dissolves_to: ConstructionMechanism }

  | OutsideModeledGuarantee { subject: DeclarationRef, reason: OutsideModeledGuaranteeReason }

type ConstructionJustification {
  class: ConstructionClass
}

// A total downstream read of a WallNow upstream value cannot sit outside the modeled guarantee:
// the output is no less decidable than its input. This is the check that catches the complexity
// lens defect (asymptotic_projection(cost_lens(n)) stamped as outside while cost is WallNow).
fn wall_now_total_projection_forbids_outside_modeled_guarantee(
  upstream: ConstructionClass,
  downstream: ConstructionClass
) -> Bool {
  match upstream {
    WallNow { mechanism: _, authority: _ } =>
      match downstream {
        OutsideModeledGuarantee { subject: _, reason: _ } => false
        _ => true
      }
    _ => true
  }
}

fn construction_class_is_outside_modeled_guarantee(class: ConstructionClass) -> Bool {
  match class {
    OutsideModeledGuarantee { subject: _, reason: _ } => true
    _ => false
  }
}
