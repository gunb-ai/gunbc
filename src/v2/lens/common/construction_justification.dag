module v2.lens.common.construction_justification

import std.disposition { ConstructionMechanism }

import std.decl_ref {
  DeclarationRef,
  WholeDeclaration,
  declaration_ref_eq,
  declaration_ref_in_list
}

import v2.std.collection { List }

// DESIGN section 4b column beside the ladder. The field that matters is a REQUIRED CAPABILITY
// joined against the inventory named by capability_inventory_authority: subject needs X; that
// inventory I does not provide X; therefore the subject is outside the guarantee I represents.
// If X later appears in THAT I, the classification becomes false and the corpus reds.
// Joining a grounding stamp against the cost inventory cannot red: X was never a candidate there.
// boundary_kind is explanatory; each arm still carries the authority, capability, or domain
// whose standing is checked.
type GuaranteeBoundaryKind
  = CapabilityNotRepresented { required: DeclarationRef }
  | CandidateDomainNotClosed { domain: DeclarationRef }
  | EquivalenceRelationNotRepresented { relation: DeclarationRef }
  | ExternalEvidenceRequired { evidence: DeclarationRef }
  | PolicyJudgmentRequired { judgment: DeclarationRef }

type GuaranteeBoundary {
  subject: DeclarationRef
  required_capability: DeclarationRef
  capability_inventory_authority: DeclarationRef
  boundary_kind: GuaranteeBoundaryKind
}

type ConstructionClass

  = WallNow { mechanism: ConstructionMechanism, authority: DeclarationRef }

  | WallAfterGrounding { dissolves_to: ConstructionMechanism }

  | OutsideModeledGuarantee { boundary: GuaranteeBoundary }

type ConstructionJustification {
  class: ConstructionClass
}

data modeled_guarantee_capability_inventory: List<DeclarationRef> = [
  DeclarationRef {
    module_path: "v2.lens.cost",
    decl_name: "cost_lens",
    field: WholeDeclaration
  },
  DeclarationRef {
    module_path: "v2.lens.complexity",
    decl_name: "asymptotic_projection",
    field: WholeDeclaration
  }
]

data modeled_guarantee_capability_inventory_ref: DeclarationRef = DeclarationRef {
  module_path: "v2.lens.common.construction_justification",
  decl_name: "modeled_guarantee_capability_inventory",
  field: WholeDeclaration
}

data grounding_modeled_capability_inventory: List<DeclarationRef> = []

data grounding_modeled_capability_inventory_ref: DeclarationRef = DeclarationRef {
  module_path: "v2.lens.common.construction_justification",
  decl_name: "grounding_modeled_capability_inventory",
  field: WholeDeclaration
}

data unit_modeling_modeled_capability_inventory: List<DeclarationRef> = []

data unit_modeling_modeled_capability_inventory_ref: DeclarationRef = DeclarationRef {
  module_path: "v2.lens.common.construction_justification",
  decl_name: "unit_modeling_modeled_capability_inventory",
  field: WholeDeclaration
}

data testgen_modeled_capability_inventory: List<DeclarationRef> = []

data testgen_modeled_capability_inventory_ref: DeclarationRef = DeclarationRef {
  module_path: "v2.lens.common.construction_justification",
  decl_name: "testgen_modeled_capability_inventory",
  field: WholeDeclaration
}

fn modeled_outside_boundary(
  subject: DeclarationRef,
  required_capability: DeclarationRef,
  capability_inventory_authority: DeclarationRef,
  boundary_kind: GuaranteeBoundaryKind
) -> GuaranteeBoundary {
  GuaranteeBoundary {
    subject: subject,
    required_capability: required_capability,
    capability_inventory_authority: capability_inventory_authority,
    boundary_kind: boundary_kind
  }
}

fn guarantee_boundary_inventory_authority_is_closed(authority: DeclarationRef) -> Bool {
  declaration_ref_eq(a: authority, b: modeled_guarantee_capability_inventory_ref)
    || declaration_ref_eq(a: authority, b: grounding_modeled_capability_inventory_ref)
    || declaration_ref_eq(a: authority, b: unit_modeling_modeled_capability_inventory_ref)
    || declaration_ref_eq(a: authority, b: testgen_modeled_capability_inventory_ref)
}

fn guarantee_boundary_inventory_rows(authority: DeclarationRef) -> List<DeclarationRef> {
  if declaration_ref_eq(a: authority, b: modeled_guarantee_capability_inventory_ref) {
    modeled_guarantee_capability_inventory
  } else if declaration_ref_eq(a: authority, b: grounding_modeled_capability_inventory_ref) {
    grounding_modeled_capability_inventory
  } else if declaration_ref_eq(a: authority, b: unit_modeling_modeled_capability_inventory_ref) {
    unit_modeling_modeled_capability_inventory
  } else if declaration_ref_eq(a: authority, b: testgen_modeled_capability_inventory_ref) {
    testgen_modeled_capability_inventory
  } else {
    []
  }
}

fn guarantee_boundary_capability_absent_from(
  capability: DeclarationRef,
  rows: List<DeclarationRef>
) -> Bool {
  !declaration_ref_in_list(target: capability, refs: rows)
}

fn guarantee_boundary_still_outside(boundary: GuaranteeBoundary) -> Bool {
  guarantee_boundary_inventory_authority_is_closed(authority: boundary.capability_inventory_authority)
    && guarantee_boundary_capability_absent_from(
      capability: boundary.required_capability,
      rows: guarantee_boundary_inventory_rows(authority: boundary.capability_inventory_authority)
    )
}

fn guarantee_boundary_required_is_not_subject(boundary: GuaranteeBoundary) -> Bool {
  !declaration_ref_eq(a: boundary.subject, b: boundary.required_capability)
}

fn wall_now_total_projection_forbids_outside_modeled_guarantee(
  upstream: ConstructionClass,
  downstream: ConstructionClass
) -> Bool {
  match upstream {
    WallNow { mechanism: _, authority: _ } =>
      match downstream {
        OutsideModeledGuarantee { boundary: _ } => false
        _ => true
      }
    _ => true
  }
}

fn construction_class_outside_boundary_still_outside(class: ConstructionClass) -> Bool {
  match class {
    OutsideModeledGuarantee { boundary: b } => guarantee_boundary_still_outside(boundary: b)
    _ => true
  }
}

fn construction_class_outside_required_is_not_subject(class: ConstructionClass) -> Bool {
  match class {
    OutsideModeledGuarantee { boundary: b } => guarantee_boundary_required_is_not_subject(boundary: b)
    _ => true
  }
}
