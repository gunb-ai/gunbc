module v2.lens.common.construction_justification

import std.disposition { ConstructionMechanism }

import std.decl_ref {
  DeclarationRef,
  WholeDeclaration,
  declaration_ref_eq
}

// DESIGN section 4b column beside the ladder. OutsideModeledGuarantee is an identity join
// against the declaration population via v2.std.decl_ref_resolution.resolve_declaration_ref
// (the runtime resolution authority). The join lives in
// v2.lens.common.outside_modeled_guarantee_join so this module stays a type carrier and does
// not import module_graph. capability_inventory_authority names that producer
// (`v2.std.decl_index.decl_facts`); boundary_kind is explanatory.
type GuaranteeBoundaryKind
  = CapabilityNotRepresented { required: DeclarationRef }
  | CandidateDomainNotClosed { domain: DeclarationRef }
  | EquivalenceRelationNotRepresented { relation: DeclarationRef }
  | ExternalEvidenceRequired { evidence: DeclarationRef }
  | PolicyJudgmentRequired { judgment: DeclarationRef }

// required_capability is typed as DeclarationRef, so an unlanded capability has to be
// written as an identity the declaration index can walk. That is a job the type cannot
// type: the join (v2.lens.common.outside_modeled_guarantee_join guarantee_boundary_still_outside)
// is true only on DeclarationRefDeclarationAbsent, which means the cited symbol must NOT
// exist. A name may be a string; an identity may not (DESIGN §3 peeler). Specimens, all
// required-absent, enrolled on PLANTED_CONTROL_CITATIONS with inverse trigger
// PLANTED-CONTROL-RESOLVES (not a mute): complexity_optimality_boundary cites
// unrestricted_semantic_complexity_equivalence_procedure; grounding_name_only_residual_boundary
// cites confirm_judge_should_ground; synthesis_rice_residual_boundary cites
// unrestricted_cheaper_equivalent; nonexistent_capability_ref cites capability_absent_from_decl_facts.
// Repointing or restoring any of them makes the join lie. The carrier change is a modelling
// decision, not a silence of those four.
type GuaranteeBoundary {
  subject: DeclarationRef
  required_capability: DeclarationRef
  capability_inventory_authority: DeclarationRef
  boundary_kind: GuaranteeBoundaryKind
}

type ConstructionClass

  = WallNow { mechanism: ConstructionMechanism, authority: DeclarationRef }

  | WallAfterGrounding { dissolves_to: ConstructionMechanism }

  | OutsideModeledGuarantee { boundary: GuaranteeBoundary }

type ConstructionJustification {
  class: ConstructionClass
}

data decl_facts_inventory_authority: DeclarationRef = DeclarationRef {
  module_path: "v2.std.decl_index",
  decl_name: "decl_facts",
  field: WholeDeclaration
}

fn modeled_outside_boundary(
  subject: DeclarationRef,
  required_capability: DeclarationRef,
  capability_inventory_authority: DeclarationRef,
  boundary_kind: GuaranteeBoundaryKind
) -> GuaranteeBoundary {
  GuaranteeBoundary {
    subject: subject,
    required_capability: required_capability,
    capability_inventory_authority: capability_inventory_authority,
    boundary_kind: boundary_kind
  }
}

fn guarantee_boundary_required_is_not_subject(boundary: GuaranteeBoundary) -> Bool {
  !declaration_ref_eq(a: boundary.subject, b: boundary.required_capability)
}

fn wall_now_total_projection_forbids_outside_modeled_guarantee(
  upstream: ConstructionClass,
  downstream: ConstructionClass
) -> Bool {
  match upstream {
    WallNow { mechanism: _, authority: _ } =>
      match downstream {
        OutsideModeledGuarantee { boundary: _ } => false
        _ => true
      }
    _ => true
  }
}
