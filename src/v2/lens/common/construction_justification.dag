module v2.lens.common.construction_justification

import v2.std.text { String }

type ConstructionClass

  = WallNow { construction: String }

  | WallAfterGrounding { grounding_authority: String, dissolve_on: String }

  | RatchetForever { undecidable_because: String }

type ConstructionJustification {
  class: ConstructionClass
  rationale: String
}
