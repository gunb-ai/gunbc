module v2.lens.common.construction_justification

import std.disposition { ConstructionMechanism }

import std.decl_ref { DeclarationRef }

// THE PERMANENCE ARGUMENT, modeled as a closed coproduct over the bounded forward substrate
// (DESIGN section 4). Each variant names the membership question claimed permanently
// undecidable here — not prose about why, and not a Turing-complete-language hand-wave.
// Rice-global-optimality is the only variant that cites Rice; the others are substrate-bounded
// residues (domain denotation, grounding verdict, synthesis gap, complete test oracle).
type RatchetPermanenceBasis
  = RiceGlobalOptimality
  | ConstructiveSynthesisGap
  | CompleteTestOracle
  | DomainQuantityDenotation
  | ReferenceGroundingVerdict

type ConstructionClass

  = WallNow { mechanism: ConstructionMechanism, authority: DeclarationRef }

  | WallAfterGrounding { dissolves_to: ConstructionMechanism }

  | RatchetForever { basis: RatchetPermanenceBasis }

type ConstructionJustification {
  class: ConstructionClass
}

// A total downstream read of a WallNow upstream value cannot claim RatchetForever: the output's
// decidability is no stronger than the WallNow input's. This is the check that catches the
// complexity-lens defect (asymptotic_projection(cost_lens(n)) with class RatchetForever).
fn wall_now_total_projection_forbids_ratchet_forever(
  upstream: ConstructionClass,
  downstream: ConstructionClass
) -> Bool {
  match upstream {
    WallNow { mechanism: _, authority: _ } =>
      match downstream {
        RatchetForever { basis: _ } => false
        _ => true
      }
    _ => true
  }
}

fn construction_class_is_ratchet_forever(class: ConstructionClass) -> Bool {
  match class {
    RatchetForever { basis: _ } => true
    _ => false
  }
}
