module v2.lens.common.outside_modeled_guarantee_join

import v2.lens.common.construction_justification {
  GuaranteeBoundary,
  decl_facts_inventory_authority
}
import std.decl_ref { declaration_ref_eq }
import gunbc.ci_layer_roots { witness_layer_roots }
import v2.std.decl_index { DeclFact, decl_facts }
import v2.lens.module_graph { ModuleDeclarationFact, module_declaration_facts_live }
import v2.std.decl_ref_resolution {
  resolve_declaration_ref,
  DeclarationRefResolved,
  DeclarationRefModuleAbsent,
  DeclarationRefDeclarationAbsent,
  DeclarationRefFieldAbsent,
  DeclarationRefAmbiguous
}
import v2.std.collection { List }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE CORPUS INDEX THE JOIN READS, AS ONE ZERO-ARG PRODUCER. #10706's still_outside called
// decl_facts and module_declaration_facts_live over witness_layer_roots on every invocation
// (control: #10699 run 34080451370 — identical three outside_modeled_guarantee_witness_test
// identities, no PLANTED_CONTROL rows). Re-derive the cost from the floor's per-claim cost
// receipt and the cross-claim demand census; do not transcribe those numbers here. Section 2:
// several demands with a shared-state least common ancestor are authored duplication;
// carry/rewire/share the first value, do not memoize the later request. The eval-frame memo
// already collapses within-claim repetition, so this hoist buys no measured time today — it
// removes source-level duplication only. Cross-claim sharing via
// v2.workflow.floor_pure_producer_share is closed for this producer: run 34088508298 refused
// PureProducerShareWarmNotStored / ByteBudgetExceeded (control arm 34088506991). The residual
// cost is a corpus-wide question asked once per boundary, charged mainly inside opaque host
// calls rather than evaluator steps — a substrate problem, not a repetition the hoist can move.
// The join mints via this producer only; a caller cannot pass a narrower list.
type WitnessLayerDeclIndex {
  facts: List<DeclFact>
  modules: List<ModuleDeclarationFact>
}

fn witness_layer_decl_index() -> WitnessLayerDeclIndex {
  WitnessLayerDeclIndex {
    facts: decl_facts(pool_roots: witness_layer_roots),
    modules: module_declaration_facts_live(pool_roots: witness_layer_roots)
  }
}

// THE JOIN TAKES ITS POPULATION FROM THE NAMED PRODUCER. Authority is
// witness_layer_decl_index — decl_facts and module_declaration_facts_live over
// gunbc.ci_layer_roots.witness_layer_roots, the same roots required lanes pass. A caller
// cannot pass a narrower list beside a corpus authority; the zero-arg producer is the only mint.
fn guarantee_boundary_still_outside(boundary: GuaranteeBoundary) -> Bool {
  if !declaration_ref_eq(a: boundary.capability_inventory_authority, b: decl_facts_inventory_authority) {
    false
  } else {
    let index = witness_layer_decl_index()
    match resolve_declaration_ref(
      ref: boundary.required_capability,
      facts: index.facts,
      modules: index.modules
    ) {
      DeclarationRefDeclarationAbsent { reference: _ } => true
      DeclarationRefResolved { declaration_identity: _ } => false
      DeclarationRefModuleAbsent { reference: _ } => false
      DeclarationRefFieldAbsent { reference: _ } => false
      DeclarationRefAmbiguous { reference: _, candidates: _ } => false
    }
  }
}
