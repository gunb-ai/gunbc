module v2.lens.common.chain_generalization


fn chain_collapses(steps: std.algebra.FreeMonoid<v2.std.node.Node>, min_len: Int, require_hole: Bool) -> Bool {
  if v2.std.algebra.length(xs: steps) < min_len {
    false
  } else {
    let g = v2.std.anti_unification.anti_unify_chain(steps: steps)
    let hole_ok = if require_hole {
      v2.std.anti_unification.template_has_hole(template: g.template)
    } else {
      true
    }
    hole_ok && v2.std.anti_unification.fillings_all_leaves(per_element: g.per_element)
  }
}
