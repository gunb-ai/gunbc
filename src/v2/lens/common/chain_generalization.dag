module v2.lens.common.chain_generalization


fn chain_collapses(steps: FreeMonoid<v2.std.node.Node>, min_len: v2.std.integer.Int, require_hole: v2.std.logic.Bool) -> v2.std.logic.Bool {
  if length(xs: steps) < min_len {
    false
  } else {
    let g = anti_unify_chain(steps: steps)
    let hole_ok = if require_hole {
      template_has_hole(template: g.template)
    } else {
      true
    }
    hole_ok && fillings_all_leaves(per_element: g.per_element)
  }
}
