module v2.test.lens_common.infer_fixture


fn claim_atom_node(s: v2.std.node.Symbol) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn claim_canonical_grounding(
  type_symbol: v2.std.node.Symbol,
  algebra_symbol: v2.std.node.Symbol,
) -> v2.std.constraints.CanonicalGrounding {
  let resolved = claim_atom_node(s: type_symbol)
  let algebra = claim_atom_node(s: algebra_symbol)
  v2.std.constraints.CanonicalGrounding {
    node: resolved,
    witness: v2.std.constraints.CanonicalGroundingWitness {
      structural: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: resolved
      }
    }
  }
}

fn claim_inferred_facts_witness(
  grounding: v2.std.constraints.CanonicalGrounding,
  descent: Witness<v2.std.cardinality.TerminationProof>
) -> v2.compiler.inferred_tree.InferredFacts {
  v2.compiler.inferred_tree.InferredFacts {
    grounding: v2.compiler.infer.DerivedGrounding { grounding: grounding },
    descent: descent
  }
}

fn claim_inferred_facts_from_nodes(
  resolved: Node,
  algebra: Node,
  descent: Witness<v2.std.cardinality.TerminationProof>
) -> v2.compiler.inferred_tree.InferredFacts {
  claim_inferred_facts_witness(
    grounding: v2.std.constraints.CanonicalGrounding {
      node: resolved,
      witness: v2.std.constraints.CanonicalGroundingWitness {
        structural: v2.std.witness.StructuralPropertyWitness {
          property: ^constraint_property_being_canonical,
          evidence: algebra
        },
        closedness: v2.std.witness.StructuralPropertyWitness {
          property: ^constraint_property_candidate_set_closedness,
          evidence: resolved
        }
      }
    },
    descent: descent
  )
}

fn claim_inferred_facts(
  type_symbol: v2.std.node.Symbol,
  algebra_symbol: v2.std.node.Symbol,
  descent_symbol: v2.std.node.Symbol,
) -> v2.compiler.inferred_tree.InferredFacts {
  claim_inferred_facts_witness(
    grounding: claim_canonical_grounding(
      type_symbol: type_symbol,
      algebra_symbol: algebra_symbol,
    ),
    descent: v2.std.witness.Holds {
      value: v2.std.cardinality.TerminationProof {
        non_increasing: [],
        strict: v2.std.cardinality.RankingDimension { measured: descent_symbol }
      }
    }
  )
}

fn claim_inferred_facts_map(facts: v2.compiler.inferred_tree.InferredFacts) -> Map<Node, v2.compiler.inferred_tree.InferredFacts> {
  std.types.Map {
    lookup: fn(_) {
      Present { value: facts }
    }
  }
}

fn claim_inferred_tree(root: Node, facts: v2.compiler.inferred_tree.InferredFacts) -> v2.compiler.inferred_tree.InferredTree {
  v2.compiler.inferred_tree.InferredTree {
    root: root,
    facts: claim_inferred_facts_map(facts: facts)
  }
}

fn claim_inferred_facts_for_tree(tree: v2.compiler.inferred_tree.InferredTree, node: Node) -> Witness<v2.compiler.inferred_tree.InferredFacts> {
  witness_from_optional(opt: tree.facts.lookup(node), absent: infer_facts_lookup_miss_diagnostic(key: node))
}
