module v2.lens.mandatory_tag


data mandatory_tag_law: String = "The SubstrateMandatoryTag mechanism (std.disposition.ConstructionMechanism), reached region-by-region per dag/gunbc/plans/disposition_carrier.dag: a MandatoryTagRegion row declares that every module whose qualified name falls inside a namespace region MUST carry a top-level data declaration with a required name, a required declared type, and a value whose discriminating vocabulary atoms are drawn from an accepted subset. Enrolled in always_required_root_lenses, so a violating module FAILS COMPILATION with a typed, located diagnostic - the missing/misnamed/misvalued tag is unwritable at definition admission, not flagged post-hoc by a corpus scan (DESIGN 5: construction over validation). First region: extdeps external-authority anchors - this row is the dissolution of v2.lens.extdeps_external_authority and its cli_run.rs host text-scan scaffold (that lens's WallAfterGrounding { dissolves_to: SubstrateMandatoryTag } boundary, discharged). The shadow-mask sub-check dissolved with it onto its own SingleAuthority ground: module-path collisions refuse loudly at module-index build, so a tag masked by a same-path shadow module is unwritable upstream of this gate. Grain: root - one rooted whole-tree walk locating dag_surface_module wrappers; per-module work is a bounded read of one small declaration subtree, never a per-node subtree re-walk (the required_lens_grain_note O(n^2) bar). Corpus grain: the same fold is consumed at parse grain by the live witness in src/v2/test/claim/long/mandatory_tag_extdeps_corpus_test.dag over dag/extdeps/** via filesystem_list_dag_files + filesystem_read + the v2 grammar - the Node-tree projection that supersedes the host module parse (the dissolution trigger named by the deleted cli_run.rs scaffold block)."

data mandatory_tag_shape_law: String = "Two carrier shapes, one reader family, mirroring qualified_name_from_module_node's dual path: an emit-shaped declaration carries Named edges (dag_surface_data_decl_name / _type / _expr - emit_data_decl_emitted_node's projection), a parse-shaped declaration carries the grammar sequence projection (grammar_production_captured_node_projection with sequence left/right spine: kw_data, name, colon, type_expr, eq, value). The declaration NAME on the parse shape is the lexeme-stamped atom identity (dag_grammar_data_decl_expr name terminal is terminal_lexeme, stamped in this change - the same move already landed for fn_decl, alias_decl, and the let binder). A name atom still reading as the bare dag_token_ident marker is a pre-stamp tree: that module's tag presence is undecidable at this grain and refuses mandatory_tag_name_projection_gated - a typed sequencing refusal, never a silent skip and never a fabricated verdict."

data mandatory_tag_value_vocabulary_law: String = "The value check is vocabulary-keyed, not field-path-keyed: the region names the closed set of discriminating variant atoms (for the extdeps region, the extdeps.uri scheme constructors) and the accepted subset (Http, Https - the intersubjectively reachable schemes; File and Ftp are non-external, the old NonExternalAnchorScheme refusal). The tagged declaration's value subtree is scanned for vocabulary atoms: any non-accepted atom refuses; none found refuses IF the value region structurally carries its expression content (dag_surface_expr productions present - parse-shaped and emit-shaped trees), and is out of representation IF the region carries no expression productions (03_normalize currently collapses data-decl value internals to bare token markers - the general-body-producer frontier, docs/plans/general-body-producer-design.md). The out-of-representation arm contributes no finding at THIS grain because the fact is absent from the carrier, not because the check widened - the corpus witness enforces the same rule at parse grain, where the value content is always present, so scheme enforcement stays whole-corpus while the normalize-grain representation matures."

type MandatoryTagRegion {
  region_dotted_prefix: String
  required_decl_name: Symbol
  required_type_name: Symbol
  value_vocabulary: List<Symbol>
  value_accepted: List<Symbol>
  exempt_modules: List<String>
  exempt_module_prefixes: List<String>
  exempt_module_suffixes: List<String>
}

data extdeps_external_authority_region_note: String = "Region membership mirrors the dissolved host roster exactly: extdeps.uri and extdeps.external_authority are the anchor machinery itself (a module cannot cite the citation vocabulary it defines - the old machinery_exempt roster); extdeps.fixture.* are deliberate red-control plants; *.mock_corpus modules are synthetic corpora. The drained backfill queue (dag/extdeps/external_authority_backfill_pending.txt, deleted with this row) is not carried forward: coverage was whole-tree at dissolution time, so no backfill concept survives."

data extdeps_external_authority_region: MandatoryTagRegion = MandatoryTagRegion {
  region_dotted_prefix: "extdeps.",
  required_decl_name: ^extdeps_external_authority_anchor,
  required_type_name: ^ExternalAuthority,
  value_vocabulary: [^Http, ^Https, ^File, ^Ftp],
  value_accepted: [^Http, ^Https],
  exempt_modules: ["extdeps.uri", "extdeps.external_authority"],
  exempt_module_prefixes: ["extdeps.fixture."],
  exempt_module_suffixes: [".mock_corpus"]
}

fn mandatory_tag_regions() -> List<MandatoryTagRegion> {
  [extdeps_external_authority_region]
}

fn mandatory_tag_symbols_contain(xs: List<Symbol>, s: Symbol) -> Bool {
  fold(xs, init: false, f: fn(acc, x) { acc || x == s })
}

fn mandatory_tag_strings_contain(xs: List<String>, s: String) -> Bool {
  fold(xs, init: false, f: fn(acc, x) { acc || x == s })
}

fn mandatory_tag_any_prefix(xs: List<String>, dotted: String) -> Bool {
  fold(xs, init: false, f: fn(acc, p) { acc || dotted.starts_with(prefix: p) })
}

fn mandatory_tag_any_suffix(xs: List<String>, dotted: String) -> Bool {
  fold(xs, init: false, f: fn(acc, s) { acc || dotted.ends_with(suffix: s) })
}

fn mandatory_tag_region_applies(region: MandatoryTagRegion, dotted: String) -> Bool {
  dotted.starts_with(prefix: region.region_dotted_prefix)
    && !mandatory_tag_strings_contain(xs: region.exempt_modules, s: dotted)
    && !mandatory_tag_any_prefix(xs: region.exempt_module_prefixes, dotted: dotted)
    && !mandatory_tag_any_suffix(xs: region.exempt_module_suffixes, dotted: dotted)
}

fn mandatory_tag_subtree_atoms(n: Node) -> List<Symbol> {
  fold_node(
    n: n,
    algebra: NodeFold {
      init: fn(n0) {
        match n0.kind {
          TypeNode { connective: Atom { identity: s } } => [s]
          _ => []
        }
      },
      step: fn(acc, _edge, child) { concat(acc, child) }
    }
  )
}

fn mandatory_tag_subtree_has_production(n: Node, want: Symbol) -> Bool {
  fold_node(
    n: n,
    algebra: NodeFold {
      init: fn(n0) {
        match parse_production_emitted_identity_optional(node: n0) {
          Present { value: id } => id == want
          Absent => false
        }
      },
      step: fn(acc, _edge, child) { acc || child }
    }
  )
}

fn mandatory_tag_node_production_is(n: Node, want: Symbol) -> Bool {
  match parse_production_emitted_identity_optional(node: n) {
    Present { value: id } => id == want
    Absent => false
  }
}

type MandatoryTagDeclName
  = DeclNameRead { name: Symbol }
  | DeclNameProjectionGated
  | DeclNameUnreadable

fn mandatory_tag_seq_right(n: Node) -> Optional<Node> {
  match find_named_child(root: n, name: ^grammar_sequence_right_node_projection) {
    Rejected { diagnostics: _ } => optional_absent()
    Accepted { value: r, diagnostics: _ } => optional_present(value: r)
  }
}

fn mandatory_tag_seq_left(n: Node) -> Optional<Node> {
  match find_named_child(root: n, name: ^grammar_sequence_left_node_projection) {
    Rejected { diagnostics: _ } => optional_absent()
    Accepted { value: l, diagnostics: _ } => optional_present(value: l)
  }
}

fn mandatory_tag_parse_captured(d: Node) -> Optional<Node> {
  match find_named_child(root: d, name: ^grammar_production_captured_node_projection) {
    Rejected { diagnostics: _ } => optional_absent()
    Accepted { value: c, diagnostics: _ } => optional_present(value: c)
  }
}

fn mandatory_tag_parse_name_node(d: Node) -> Optional<Node> {
  match mandatory_tag_parse_captured(d: d) {
    Absent => optional_absent()
    Present { value: captured } =>
      match mandatory_tag_seq_right(n: captured) {
        Absent => optional_absent()
        Present { value: r1 } => mandatory_tag_seq_left(n: r1)
      }
  }
}

fn mandatory_tag_parse_type_node(d: Node) -> Optional<Node> {
  match mandatory_tag_parse_captured(d: d) {
    Absent => optional_absent()
    Present { value: captured } =>
      match mandatory_tag_seq_right(n: captured) {
        Absent => optional_absent()
        Present { value: r1 } =>
          match mandatory_tag_seq_right(n: r1) {
            Absent => optional_absent()
            Present { value: r2 } =>
              match mandatory_tag_seq_right(n: r2) {
                Absent => optional_absent()
                Present { value: r3 } => mandatory_tag_seq_left(n: r3)
              }
          }
      }
  }
}

fn mandatory_tag_parse_value_node(d: Node) -> Optional<Node> {
  match mandatory_tag_parse_captured(d: d) {
    Absent => optional_absent()
    Present { value: captured } =>
      match mandatory_tag_seq_right(n: captured) {
        Absent => optional_absent()
        Present { value: r1 } =>
          match mandatory_tag_seq_right(n: r1) {
            Absent => optional_absent()
            Present { value: r2 } =>
              match mandatory_tag_seq_right(n: r2) {
                Absent => optional_absent()
                Present { value: r3 } =>
                  match mandatory_tag_seq_right(n: r3) {
                    Absent => optional_absent()
                    Present { value: r4 } => mandatory_tag_seq_right(n: r4)
                  }
              }
          }
      }
  }
}

fn mandatory_tag_decl_name(d: Node) -> MandatoryTagDeclName {
  match find_named_child(root: d, name: ^dag_surface_data_decl_name) {
    Accepted { value: nm, diagnostics: _ } =>
      match node_atom_identity_optional(node: nm) {
        Present { value: s } => DeclNameRead { name: s }
        Absent =>
          match mandatory_tag_subtree_atoms(n: nm) {
            Cons { head: first, tail: _ } => DeclNameRead { name: first }
            Empty => DeclNameUnreadable
          }
      }
    Rejected { diagnostics: _ } =>
      match mandatory_tag_parse_name_node(d: d) {
        Absent => DeclNameUnreadable
        Present { value: nm } =>
          match node_atom_identity_optional(node: nm) {
            Present { value: s } =>
              if s == ^dag_token_ident {
                DeclNameProjectionGated
              } else {
                DeclNameRead { name: s }
              }
            Absent => DeclNameUnreadable
          }
      }
  }
}

fn mandatory_tag_decl_type_node(d: Node) -> Optional<Node> {
  match find_named_child(root: d, name: ^dag_surface_data_decl_type) {
    Accepted { value: ty, diagnostics: _ } => optional_present(value: ty)
    Rejected { diagnostics: _ } => mandatory_tag_parse_type_node(d: d)
  }
}

fn mandatory_tag_decl_value_node(d: Node) -> Optional<Node> {
  match find_named_child(root: d, name: ^dag_surface_data_decl_expr) {
    Accepted { value: v, diagnostics: _ } => optional_present(value: v)
    Rejected { diagnostics: _ } => mandatory_tag_parse_value_node(d: d)
  }
}

type MandatoryTagDeclScan {
  found: Optional<Node>
  projection_gated_count: Int
}

fn mandatory_tag_scan_decls(subtree: Node, required_name: Symbol) -> MandatoryTagDeclScan {
  if mandatory_tag_node_production_is(n: subtree, want: ^dag_surface_data_decl) {
    match mandatory_tag_decl_name(d: subtree) {
      DeclNameRead { name: nm } =>
        if nm == required_name {
          MandatoryTagDeclScan { found: optional_present(value: subtree), projection_gated_count: 0 }
        } else {
          MandatoryTagDeclScan { found: optional_absent(), projection_gated_count: 0 }
        }
      DeclNameProjectionGated =>
        MandatoryTagDeclScan { found: optional_absent(), projection_gated_count: 1 }
      DeclNameUnreadable =>
        MandatoryTagDeclScan { found: optional_absent(), projection_gated_count: 1 }
    }
  } else {
    fold(subtree.children, init: MandatoryTagDeclScan { found: optional_absent(), projection_gated_count: 0 }, f: fn(acc, e) {
      match acc.found {
        Present { value: _ } => acc
        Absent =>
          let child_scan = mandatory_tag_scan_decls(subtree: e.target, required_name: required_name)
          MandatoryTagDeclScan {
            found: child_scan.found,
            projection_gated_count: acc.projection_gated_count + child_scan.projection_gated_count
          }
      }
    })
  }
}

fn mandatory_tag_missing_decl_diagnostic(module_node: Node) -> Diagnostic {
  Diagnostic {
    reason: ^mandatory_tag_missing_required_decl,
    at: node_locus(node: module_node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn mandatory_tag_projection_gated_diagnostic(module_node: Node) -> Diagnostic {
  Diagnostic {
    reason: ^mandatory_tag_name_projection_gated,
    at: node_locus(node: module_node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn mandatory_tag_type_mismatch_diagnostic(d: Node) -> Diagnostic {
  Diagnostic {
    reason: ^mandatory_tag_required_decl_type_mismatch,
    at: node_locus(node: d),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn mandatory_tag_value_unreadable_diagnostic(d: Node) -> Diagnostic {
  Diagnostic {
    reason: ^mandatory_tag_value_vocabulary_unreadable,
    at: node_locus(node: d),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn mandatory_tag_value_not_accepted_diagnostic(d: Node) -> Diagnostic {
  Diagnostic {
    reason: ^mandatory_tag_value_not_accepted,
    at: node_locus(node: d),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn mandatory_tag_type_findings(d: Node, region: MandatoryTagRegion) -> List<Diagnostic> {
  match mandatory_tag_decl_type_node(d: d) {
    Absent => [mandatory_tag_type_mismatch_diagnostic(d: d)]
    Present { value: ty } =>
      if mandatory_tag_symbols_contain(
        xs: mandatory_tag_subtree_atoms(n: ty),
        s: region.required_type_name
      ) {
        []
      } else {
        [mandatory_tag_type_mismatch_diagnostic(d: d)]
      }
  }
}

fn mandatory_tag_vocabulary_hits(atoms: List<Symbol>, vocabulary: List<Symbol>) -> List<Symbol> {
  fold(atoms, init: [], f: fn(acc, a) {
    if mandatory_tag_symbols_contain(xs: vocabulary, s: a) {
      concat(acc, [a])
    } else {
      acc
    }
  })
}

fn mandatory_tag_value_findings(d: Node, region: MandatoryTagRegion) -> List<Diagnostic> {
  match mandatory_tag_decl_value_node(d: d) {
    Absent => []
    Present { value: v } =>
      match mandatory_tag_vocabulary_hits(
        atoms: mandatory_tag_subtree_atoms(n: v),
        vocabulary: region.value_vocabulary
      ) {
        Empty =>
          if mandatory_tag_subtree_has_production(n: v, want: ^dag_surface_expr) {
            [mandatory_tag_value_unreadable_diagnostic(d: d)]
          } else {
            []
          }
        Cons { head: first_hit, tail: rest_hits } =>
          if fold(
            Cons { head: first_hit, tail: rest_hits },
            init: true,
            f: fn(acc, a) { acc && mandatory_tag_symbols_contain(xs: region.value_accepted, s: a) }
          ) {
            []
          } else {
            [mandatory_tag_value_not_accepted_diagnostic(d: d)]
          }
      }
  }
}

fn mandatory_tag_region_module_findings(
  region: MandatoryTagRegion,
  module_node: Node,
  dotted: String
) -> List<Diagnostic> {
  if mandatory_tag_region_applies(region: region, dotted: dotted) {
    let scan = mandatory_tag_scan_decls(
      subtree: module_node,
      required_name: region.required_decl_name
    )
    match scan.found {
      Present { value: d } =>
        concat(
          mandatory_tag_type_findings(d: d, region: region),
          mandatory_tag_value_findings(d: d, region: region)
        )
      Absent =>
        if scan.projection_gated_count == 0 {
          [mandatory_tag_missing_decl_diagnostic(module_node: module_node)]
        } else {
          [mandatory_tag_projection_gated_diagnostic(module_node: module_node)]
        }
    }
  } else {
    []
  }
}

fn mandatory_tag_module_findings(n: Node) -> List<Diagnostic> {
  if mandatory_tag_node_production_is(n: n, want: ^dag_surface_module) {
    match qualified_name_from_module_node(root: n) {
      Rejected { diagnostics: _ } => []
      Accepted { value: qn, diagnostics: _ } =>
        let dotted = qualified_name_to_dotted_string(qn: qn)
        fold(mandatory_tag_regions(), init: [], f: fn(acc, region) {
          concat(
            acc,
            mandatory_tag_region_module_findings(
              region: region,
              module_node: n,
              dotted: dotted
            )
          )
        })
    }
  } else {
    []
  }
}

data mandatory_tag_nameless_module_note: String = "A dag_surface_module wrapper whose qualified name cannot be read contributes no region findings here - machine_shape parity, not an absorbing arm: name resolution over the same tree refuses malformed module headers upstream of every root lens, so the nameless-wrapper arm is unreachable on a tree that reached the lens roster; keying region membership on a fabricated name would be the fabricated-plausible-output trap the arm avoids."

fn mandatory_tag_findings(root: Node) -> List<Diagnostic> {
  fold_node(
    n: root,
    algebra: NodeFold {
      init: fn(n0) { mandatory_tag_module_findings(n: n0) },
      step: fn(acc, _edge, child) { concat(acc, child) }
    }
  )
}

fn mandatory_tag_findings_count(root: Node) -> Int {
  length(xs: mandatory_tag_findings(root: root))
}

fn mandatory_tag_compile_gate(node: Node) -> Outcome<Witness<Node>> {
  match mandatory_tag_findings(root: node) {
    Cons { head: first, tail: rest } =>
      Rejected {
        diagnostics: NonEmptyDiagnostics { head: first, tail: rest }
      }
    Empty => outcome_accepted(value: Holds { value: node })
  }
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallNow
}
