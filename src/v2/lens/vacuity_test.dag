module v2.test.lens_vacuity.vacuity_test

import v2.lens.vacuity {
  HelperAlias,
  IndependentTranscription,
  LiteralOracle,
  OperandProvenanceUnknown,
  ProvenDuplicate,
  ProvenIndependent,
  ReadBack,
  RenderingTransform,
  TemporalExternalAuthority,
  Unknown,
  VacuityCensusRow,
  classify_test_claim_vacuity,
  classify_unified_test_claim_vacuity,
  vacuity_advisory_census_from_rows,
  vacuity_advisory_census_matches_row_count,
  vacuity_carries_parallel_authority_debt,
  vacuity_census_row,
  vacuity_evidence_eq
}
import v2.std.algebra { length }
import v2.std.collection { List }
import v2.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  NonEmptyDiagnostics,
  Unavailable,
  node_locus
}
import v2.std.logic { Bool }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node {
  Atom,
  Node,
  Symbol,
  SyntheticOccurrence,
  TypeNode
}
import v2.std.verification {
  CompilesClaim,
  DiagnosticClaim,
  EmitVsEval,
  EvalOnly,
  EqualsClaim,
  ManualAnchorAbsent,
  NodeCorpus,
  RoundTripClaim,
  StructuralEqualsClaim,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v2.test.nat_semiring.rung_5 {
  claim_phase1_nat_semiring_rung5_rust_add_left_identity_emit_equals_eval
}
import v2.test.rung_3_4_common { rung34_emit_host_rust_target_model }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn vacuity_test_atom(identity: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: identity } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

data vacuity_test_literal_x: Node = vacuity_test_atom(identity: ^vacuity_test_literal_x)
data vacuity_test_literal_y: Node = vacuity_test_atom(identity: ^vacuity_test_literal_y)
data vacuity_test_readback_lhs: Node = vacuity_test_atom(identity: ^vacuity_test_readback_field)
data vacuity_test_literal_rhs: Node = vacuity_test_atom(identity: ^vacuity_test_literal_oracle)

data vacuity_test_emit_vs_eval_claim: TestClaim = claim_phase1_nat_semiring_rung5_rust_add_left_identity_emit_equals_eval

data vacuity_test_single_eval_readback_claim: TestClaim = EqualsClaim {
  label: "vacuity_test: single-eval read-back duplicate",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: vacuity_test_readback_lhs,
  rhs: vacuity_test_literal_rhs,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data vacuity_test_constant_inequality_claim: TestClaim = EqualsClaim {
  label: "vacuity_test: constant inequality taxonomy witness",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: vacuity_test_literal_x,
  rhs: vacuity_test_literal_y,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data vacuity_test_unknown_provenance_claim: TestClaim = EqualsClaim {
  label: "vacuity_test: unknown provenance residue",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: vacuity_test_literal_x,
  rhs: vacuity_test_literal_x,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data vacuity_test_rendering_transform_claim: TestClaim = EqualsClaim {
  label: "vacuity_test: rendering transform independent oracle",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: vacuity_test_readback_lhs,
  rhs: vacuity_test_literal_rhs,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

fn vacuity_test_diagnostic_rejection() -> NonEmptyDiagnostics {
  NonEmptyDiagnostics {
    head: Diagnostic {
      reason: ^vacuity_test_diagnostic_reason,
      at: node_locus(node: vacuity_test_literal_x),
      correction: Unavailable { reason: ExternalContractUnknown }
    },
    tail: []
  }
}

data vacuity_test_diagnostic_claim: TestClaim = DiagnosticClaim {
  label: "vacuity_test: diagnostic behavioral claim",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: vacuity_test_literal_x,
  expected_rejection: vacuity_test_diagnostic_rejection(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data vacuity_test_round_trip_claim: TestClaim = RoundTripClaim {
  label: "vacuity_test: round-trip behavioral claim",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: vacuity_test_literal_x,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data vacuity_test_compiles_claim: TestClaim = CompilesClaim {
  label: "vacuity_test: compiles claim with unknown provenance",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: vacuity_test_literal_x,
  expected_value: vacuity_test_literal_y,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data vacuity_test_structural_equals_claim: TestClaim = StructuralEqualsClaim {
  label: "vacuity_test: structural equals single-eval duplicate",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: vacuity_test_literal_x,
  rhs: vacuity_test_literal_x,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data vacuity_test_datasheet_transcription_claim: TestClaim = EqualsClaim {
  label: "vacuity_test: independent datasheet transcriptions",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: vacuity_test_readback_lhs,
  rhs: vacuity_test_literal_rhs,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data vacuity_falsification_suite_rows: List<VacuityCensusRow> = [
  vacuity_census_row(
    label: "rung_5_emit_vs_eval",
    evidence: classify_test_claim_vacuity(
      claim: vacuity_test_emit_vs_eval_claim,
      transport: EmitVsEval { target: rung34_emit_host_rust_target_model },
      lhs_provenance: OperandProvenanceUnknown,
      rhs_provenance: OperandProvenanceUnknown,
      operand_provenance: OperandProvenanceUnknown
    ),
    carries_parallel_authority_debt: false
  ),
  vacuity_census_row(
    label: "single_eval_readback",
    evidence: classify_test_claim_vacuity(
      claim: vacuity_test_single_eval_readback_claim,
      transport: EvalOnly,
      lhs_provenance: ReadBack,
      rhs_provenance: LiteralOracle,
      operand_provenance: OperandProvenanceUnknown
    ),
    carries_parallel_authority_debt: false
  ),
  vacuity_census_row(
    label: "unknown_provenance",
    evidence: classify_test_claim_vacuity(
      claim: vacuity_test_unknown_provenance_claim,
      transport: EvalOnly,
      lhs_provenance: OperandProvenanceUnknown,
      rhs_provenance: OperandProvenanceUnknown,
      operand_provenance: OperandProvenanceUnknown
    ),
    carries_parallel_authority_debt: false
  ),
  vacuity_census_row(
    label: "constant_inequality_taxonomy",
    evidence: classify_test_claim_vacuity(
      claim: vacuity_test_constant_inequality_claim,
      transport: EvalOnly,
      lhs_provenance: LiteralOracle,
      rhs_provenance: LiteralOracle,
      operand_provenance: OperandProvenanceUnknown
    ),
    carries_parallel_authority_debt: false
  ),
  vacuity_census_row(
    label: "datasheet_independent_transcriptions",
    evidence: classify_test_claim_vacuity(
      claim: vacuity_test_datasheet_transcription_claim,
      transport: EvalOnly,
      lhs_provenance: IndependentTranscription,
      rhs_provenance: IndependentTranscription,
      operand_provenance: OperandProvenanceUnknown
    ),
    carries_parallel_authority_debt: vacuity_carries_parallel_authority_debt(
      lhs_provenance: IndependentTranscription,
      rhs_provenance: IndependentTranscription
    )
  ),
  vacuity_census_row(
    label: "rendering_transform_oracle",
    evidence: classify_test_claim_vacuity(
      claim: vacuity_test_rendering_transform_claim,
      transport: EvalOnly,
      lhs_provenance: RenderingTransform,
      rhs_provenance: LiteralOracle,
      operand_provenance: OperandProvenanceUnknown
    ),
    carries_parallel_authority_debt: false
  ),
  vacuity_census_row(
    label: "temporal_external_authority",
    evidence: classify_test_claim_vacuity(
      claim: vacuity_test_single_eval_readback_claim,
      transport: EvalOnly,
      lhs_provenance: TemporalExternalAuthority,
      rhs_provenance: LiteralOracle,
      operand_provenance: OperandProvenanceUnknown
    ),
    carries_parallel_authority_debt: false
  ),
  vacuity_census_row(
    label: "helper_alias_duplicate",
    evidence: classify_test_claim_vacuity(
      claim: vacuity_test_single_eval_readback_claim,
      transport: EvalOnly,
      lhs_provenance: HelperAlias,
      rhs_provenance: LiteralOracle,
      operand_provenance: OperandProvenanceUnknown
    ),
    carries_parallel_authority_debt: false
  ),
  vacuity_census_row(
    label: "diagnostic_behavioral",
    evidence: classify_test_claim_vacuity(
      claim: vacuity_test_diagnostic_claim,
      transport: EvalOnly,
      lhs_provenance: OperandProvenanceUnknown,
      rhs_provenance: OperandProvenanceUnknown,
      operand_provenance: OperandProvenanceUnknown
    ),
    carries_parallel_authority_debt: false
  ),
  vacuity_census_row(
    label: "round_trip_behavioral",
    evidence: classify_test_claim_vacuity(
      claim: vacuity_test_round_trip_claim,
      transport: EvalOnly,
      lhs_provenance: OperandProvenanceUnknown,
      rhs_provenance: OperandProvenanceUnknown,
      operand_provenance: OperandProvenanceUnknown
    ),
    carries_parallel_authority_debt: false
  ),
  vacuity_census_row(
    label: "compiles_unknown_provenance",
    evidence: classify_test_claim_vacuity(
      claim: vacuity_test_compiles_claim,
      transport: EvalOnly,
      lhs_provenance: OperandProvenanceUnknown,
      rhs_provenance: OperandProvenanceUnknown,
      operand_provenance: OperandProvenanceUnknown
    ),
    carries_parallel_authority_debt: false
  ),
  vacuity_census_row(
    label: "structural_equals_single_eval",
    evidence: classify_test_claim_vacuity(
      claim: vacuity_test_structural_equals_claim,
      transport: EvalOnly,
      lhs_provenance: LiteralOracle,
      rhs_provenance: LiteralOracle,
      operand_provenance: OperandProvenanceUnknown
    ),
    carries_parallel_authority_debt: false
  )
]

test fn vacuity_rung5_emit_vs_eval_classifies_proven_independent() -> Bool {
  return vacuity_evidence_eq(
    a: classify_test_claim_vacuity(
      claim: vacuity_test_emit_vs_eval_claim,
      transport: EmitVsEval { target: rung34_emit_host_rust_target_model },
      lhs_provenance: OperandProvenanceUnknown,
      rhs_provenance: OperandProvenanceUnknown,
      operand_provenance: OperandProvenanceUnknown
    ),
    b: ProvenIndependent
  )
}

test fn vacuity_single_eval_readback_classifies_proven_duplicate() -> Bool {
  return vacuity_evidence_eq(
    a: classify_test_claim_vacuity(
      claim: vacuity_test_single_eval_readback_claim,
      transport: EvalOnly,
      lhs_provenance: ReadBack,
      rhs_provenance: LiteralOracle,
      operand_provenance: OperandProvenanceUnknown
    ),
    b: ProvenDuplicate
  )
}

test fn vacuity_unknown_provenance_classifies_unknown() -> Bool {
  return vacuity_evidence_eq(
    a: classify_test_claim_vacuity(
      claim: vacuity_test_unknown_provenance_claim,
      transport: EvalOnly,
      lhs_provenance: OperandProvenanceUnknown,
      rhs_provenance: OperandProvenanceUnknown,
      operand_provenance: OperandProvenanceUnknown
    ),
    b: Unknown
  )
}

test fn vacuity_constant_inequality_taxonomy_classifies_proven_duplicate() -> Bool {
  return vacuity_evidence_eq(
    a: classify_test_claim_vacuity(
      claim: vacuity_test_constant_inequality_claim,
      transport: EvalOnly,
      lhs_provenance: LiteralOracle,
      rhs_provenance: LiteralOracle,
      operand_provenance: OperandProvenanceUnknown
    ),
    b: ProvenDuplicate
  )
}

test fn vacuity_rendering_transform_classifies_proven_independent() -> Bool {
  return vacuity_evidence_eq(
    a: classify_test_claim_vacuity(
      claim: vacuity_test_rendering_transform_claim,
      transport: EvalOnly,
      lhs_provenance: RenderingTransform,
      rhs_provenance: LiteralOracle,
      operand_provenance: OperandProvenanceUnknown
    ),
    b: ProvenIndependent
  )
}

test fn vacuity_unified_node_corpus_matches_transport_classifier() -> Bool {
  return vacuity_evidence_eq(
    a: classify_unified_test_claim_vacuity(
      claim: NodeCorpus {
        claim: vacuity_test_emit_vs_eval_claim,
        transport: EmitVsEval { target: rung34_emit_host_rust_target_model }
      },
      lhs_provenance: OperandProvenanceUnknown,
      rhs_provenance: OperandProvenanceUnknown,
      operand_provenance: OperandProvenanceUnknown
    ),
    b: ProvenIndependent
  )
}

test fn vacuity_datasheet_transcriptions_classify_proven_independent_with_parallel_debt() -> Bool {
  return vacuity_evidence_eq(
    a: classify_test_claim_vacuity(
      claim: vacuity_test_datasheet_transcription_claim,
      transport: EvalOnly,
      lhs_provenance: IndependentTranscription,
      rhs_provenance: IndependentTranscription,
      operand_provenance: OperandProvenanceUnknown
    ),
    b: ProvenIndependent
  )
    && vacuity_carries_parallel_authority_debt(
      lhs_provenance: IndependentTranscription,
      rhs_provenance: IndependentTranscription
    )
}

test fn vacuity_advisory_census_partitions_falsification_suite() -> Bool {
  let census = vacuity_advisory_census_from_rows(rows: vacuity_falsification_suite_rows)
  return vacuity_advisory_census_matches_row_count(
      rows: vacuity_falsification_suite_rows,
      census: census
    )
    && census.proven_duplicate_count == 4
    && census.proven_independent_count == 6
    && census.unknown_count == 2
}

test fn vacuity_falsification_suite_nonempty() -> Bool {
  return length(xs: vacuity_falsification_suite_rows) > 0
}