test fn vacuity_unified_node_corpus_matches_transport_classifier() -> Bool {
  return vacuity_evidence_eq(
    a: classify_unified_test_claim_vacuity(
      claim: v2.std.verification.NodeCorpus {
        claim: vacuity_test_emit_vs_eval_claim,
        transport: v2.std.verification.EmitVsEval { target: rung34_emit_host_rust_target_model }
      },
      lhs_provenance: OperandProvenanceUnknown,
      rhs_provenance: OperandProvenanceUnknown,
      operand_provenance: OperandProvenanceUnknown
    ),
    b: ProvenIndependent
  )
}

test fn vacuity_datasheet_transcriptions_classify_proven_independent_with_parallel_debt() -> Bool {
  return vacuity_evidence_eq(
    a: classify_test_claim_vacuity(
      claim: vacuity_test_datasheet_transcription_claim,
      transport: EvalOnly,
      lhs_provenance: IndependentTranscription,
      rhs_provenance: IndependentTranscription,
      operand_provenance: OperandProvenanceUnknown
    ),
    b: ProvenIndependent
  )
    && vacuity_carries_parallel_authority_debt(
      lhs_provenance: IndependentTranscription,
      rhs_provenance: IndependentTranscription
    )
}

test fn vacuity_falsification_cases_each_match_expected_evidence() -> Bool {
  return count_where(
      xs: vacuity_falsification_suite_cases,
      predicate: fn(c) { vacuity_falsification_case_matches_expected(case: c) }
    ) == length(xs: vacuity_falsification_suite_cases)
}

test fn vacuity_advisory_census_partitions_falsification_suite() -> Bool {
  let census = vacuity_advisory_census_from_rows(rows: vacuity_falsification_suite_rows)
  return vacuity_advisory_census_matches_row_count(
      rows: vacuity_falsification_suite_rows,
      census: census
    )
    && census.proven_duplicate_count == vacuity_falsification_expected_count(
      cases: vacuity_falsification_suite_cases,
      target: ProvenDuplicate
    )
    && census.proven_independent_count == vacuity_falsification_expected_count(
      cases: vacuity_falsification_suite_cases,
      target: ProvenIndependent
    )
    && census.unknown_count == vacuity_falsification_expected_count(
      cases: vacuity_falsification_suite_cases,
      target: Unknown
    )
}

test fn vacuity_falsification_suite_nonempty() -> Bool {
  return length(xs: vacuity_falsification_suite_rows) > 0
}

