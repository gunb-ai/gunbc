module v2.test.lens_vacuity.vacuity_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn vacuity_test_atom(identity: v2.std.node.Symbol) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: identity } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

data vacuity_test_literal_x: Node = vacuity_test_atom(identity: ^vacuity_test_literal_x)
data vacuity_test_literal_y: Node = vacuity_test_atom(identity: ^vacuity_test_literal_y)
data vacuity_test_readback_lhs: Node = vacuity_test_atom(identity: ^vacuity_test_readback_field)
data vacuity_test_literal_rhs: Node = vacuity_test_atom(identity: ^vacuity_test_literal_oracle)

data vacuity_test_emit_vs_eval_claim: v2.std.verification.TestClaim = claim_phase1_nat_semiring_rung5_rust_add_left_identity_emit_equals_eval

data vacuity_test_single_eval_readback_claim: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "vacuity_test: single-eval read-back duplicate",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: vacuity_test_readback_lhs,
  rhs: vacuity_test_literal_rhs,
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: v2.std.verification.Unit }
}

data vacuity_test_constant_inequality_claim: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "vacuity_test: constant inequality taxonomy witness",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: vacuity_test_literal_x,
  rhs: vacuity_test_literal_y,
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: v2.std.verification.Unit }
}

data vacuity_test_unknown_provenance_claim: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "vacuity_test: unknown provenance residue",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: vacuity_test_literal_x,
  rhs: vacuity_test_literal_x,
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: v2.std.verification.Unit }
}

data vacuity_test_rendering_transform_claim: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "vacuity_test: rendering transform independent oracle",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: vacuity_test_readback_lhs,
  rhs: vacuity_test_literal_rhs,
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: v2.std.verification.Unit }
}

fn vacuity_test_diagnostic_rejection() -> v2.std.diagnostic.NonEmptyDiagnostics {
  v2.std.diagnostic.NonEmptyDiagnostics {
    head: v2.std.diagnostic.Diagnostic {
      reason: ^vacuity_test_diagnostic_reason,
      at: node_locus(node: vacuity_test_literal_x),
      correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
    },
    tail: []
  }
}

data vacuity_test_diagnostic_claim: v2.std.verification.TestClaim = v2.std.verification.DiagnosticClaim {
  label: "vacuity_test: diagnostic behavioral claim",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: vacuity_test_literal_x,
  expected_rejection: vacuity_test_diagnostic_rejection(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: v2.std.verification.Unit }
}

