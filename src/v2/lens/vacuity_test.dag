// Item 6 (mandate): replaces the former exact-distribution-pin test (hardcoded proven_duplicate_count == 4, proven_independent_count == 6, unknown_count == 2) with a typed VacuityFalsificationCaseId/VacuityFalsificationCase roster whose per-case `expected` field is DERIVED by hand-tracing classify_test_claim_vacuity/classify_vacuity_same_eval_record's actual decision tree for each row's actual provenance/claim inputs, not guessed and not reverse-engineered from the old hardcoded totals. Verified by direct execution before this roster was written (three isolated debug assertions against the real computed VacuityAdvisoryCensus, since removed): proven_duplicate_count == 4, proven_independent_count == 4, unknown_count == 4 — the OLD hardcoded distribution (4/6/2) was stale/wrong; in particular diagnostic_behavioral, round_trip_behavioral, and compiles_unknown_provenance each pass operand_provenance: OperandProvenanceUnknown (despite the '_behavioral' naming, which names the TestClaim variant under test — DiagnosticClaim/RoundTripClaim — not an asserted BehavioralComputation provenance), so classify_test_claim_vacuity's DiagnosticClaim/RoundTripClaim arms and the CompilesClaim same-eval unknown-provenance path all correctly return Unknown, not the ProvenIndependent the stale pin implicitly assumed. The aggregate counts below are DERIVED from this roster's own `expected` column (vacuity_falsification_expected_count), never independently hardcoded a second time, so the test can never silently drift out of sync with the roster when cases are added, removed, or re-labeled — exactly the vacuity-class failure (two representations of one fact, reconciled by hand) this whole lane exists to remove, this time in its own suite.
type VacuityFalsificationCaseId =
  RungFiveEmitVsEval
  | SingleEvalReadback
  | UnknownProvenance
  | ConstantInequalityTaxonomy
  | DatasheetIndependentTranscriptions
  | RenderingTransformOracle
  | TemporalExternalAuthorityCase
  | HelperAliasDuplicate
  | DiagnosticBehavioral
  | RoundTripBehavioral
  | CompilesUnknownProvenance
  | StructuralEqualsSingleEval

type VacuityFalsificationCase {
  id: VacuityFalsificationCaseId,
  row: v2.lens.vacuity.VacuityCensusRow,
  expected: v2.lens.vacuity.VacuityEvidence
}

fn vacuity_falsification_case(
  id: VacuityFalsificationCaseId,
  row: v2.lens.vacuity.VacuityCensusRow,
  expected: v2.lens.vacuity.VacuityEvidence
) -> VacuityFalsificationCase {
  VacuityFalsificationCase { id: id, row: row, expected: expected }
}

data vacuity_falsification_suite_cases: List<VacuityFalsificationCase> = [
  vacuity_falsification_case(id: RungFiveEmitVsEval, row: vacuity_case_row_rung_5_emit_vs_eval, expected: ProvenIndependent),
  vacuity_falsification_case(id: SingleEvalReadback, row: vacuity_case_row_single_eval_readback, expected: ProvenDuplicate),
  vacuity_falsification_case(id: UnknownProvenance, row: vacuity_case_row_unknown_provenance, expected: Unknown),
  vacuity_falsification_case(id: ConstantInequalityTaxonomy, row: vacuity_case_row_constant_inequality_taxonomy, expected: ProvenDuplicate),
  vacuity_falsification_case(id: DatasheetIndependentTranscriptions, row: vacuity_case_row_datasheet_independent_transcriptions, expected: ProvenIndependent),
  vacuity_falsification_case(id: RenderingTransformOracle, row: vacuity_case_row_rendering_transform_oracle, expected: ProvenIndependent),
  vacuity_falsification_case(id: TemporalExternalAuthorityCase, row: vacuity_case_row_temporal_external_authority, expected: ProvenIndependent),
  vacuity_falsification_case(id: HelperAliasDuplicate, row: vacuity_case_row_helper_alias_duplicate, expected: ProvenDuplicate),
  vacuity_falsification_case(id: DiagnosticBehavioral, row: vacuity_case_row_diagnostic_behavioral, expected: Unknown),
  vacuity_falsification_case(id: RoundTripBehavioral, row: vacuity_case_row_round_trip_behavioral, expected: Unknown),
  vacuity_falsification_case(id: CompilesUnknownProvenance, row: vacuity_case_row_compiles_unknown_provenance, expected: Unknown),
  vacuity_falsification_case(id: StructuralEqualsSingleEval, row: vacuity_case_row_structural_equals_single_eval, expected: ProvenDuplicate)
]

data vacuity_falsification_suite_rows_derivation_note: String = "review 47215 (PR #7620): vacuity_falsification_suite_rows was a manually maintained roster listing the same 12 VacuityCensusRow values already carried by vacuity_falsification_suite_cases's own `row` field — a second membership representation of the identical fact, exactly the DESIGN.md §2/§3 single-authority violation this lens exists to flag elsewhere. Fixed by deriving vacuity_falsification_suite_rows from vacuity_falsification_suite_cases via list_map(f: fn(c) { c.row }), so vacuity_advisory_census_partitions_falsification_suite's census-over-rows and the cases roster's expected-evidence dispositions can no longer independently drift; adding, removing, or reordering a case now changes both consumers from one edit."

data vacuity_falsification_suite_rows: List<v2.lens.vacuity.VacuityCensusRow> = list_map(
  xs: vacuity_falsification_suite_cases,
  f: fn(c) { c.row }
)

fn vacuity_falsification_case_matches_expected(case: VacuityFalsificationCase) -> Bool {
  vacuity_evidence_eq(a: case.row.evidence, b: case.expected)
}

fn vacuity_falsification_expected_count(cases: List<VacuityFalsificationCase>, target: v2.lens.vacuity.VacuityEvidence) -> Int {
  count_where(xs: cases, predicate: fn(c) { vacuity_evidence_eq(a: c.expected, b: target) })
}

test fn vacuity_rung5_emit_vs_eval_classifies_proven_independent() -> Bool {
  return vacuity_evidence_eq(
    a: classify_test_claim_vacuity(
      claim: vacuity_test_emit_vs_eval_claim,
      transport: v2.std.verification.EmitVsEval { target: rung34_emit_host_rust_target_model },
      lhs_provenance: OperandProvenanceUnknown,
      rhs_provenance: OperandProvenanceUnknown,
      operand_provenance: OperandProvenanceUnknown
    ),
    b: ProvenIndependent
  )
}

test fn vacuity_single_eval_readback_classifies_proven_duplicate() -> Bool {
  return vacuity_evidence_eq(
    a: classify_test_claim_vacuity(
      claim: vacuity_test_single_eval_readback_claim,
      transport: EvalOnly,
      lhs_provenance: ReadBack,
      rhs_provenance: LiteralOracle,
      operand_provenance: OperandProvenanceUnknown
    ),
    b: ProvenDuplicate
