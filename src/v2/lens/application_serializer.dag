module v2.lens.application_serializer


type DagSourcePatch {
  before: Medium<String>
  after: Medium<String>
}

fn serialize_diff_as_source_patch(
  root: Node,
  diff: v2.std.node.Diff,
  canonical_source_target: v2.std.compilers.target_model.TargetModel
) -> Outcome<DagSourcePatch> {
  bind_outcome(
    o: target_serialize_source_from_model(target: canonical_source_target, emitted: root),
    f: fn(before) {
      bind_outcome(
        o: apply_diff(root: root, d: diff),
        f: fn(patched) {
          bind_outcome(
            o: target_serialize_source_from_model(
              target: canonical_source_target,
              emitted: patched
            ),
            f: fn(after) {
              outcome_accepted(value: DagSourcePatch { before: before, after: after })
            }
          )
        }
      )
    }
  )
}

data construction_justification: v2.lens.common.construction_justification.ConstructionJustification = v2.lens.common.construction_justification.ConstructionJustification {
  class: v2.lens.common.construction_justification.WallNow {
    mechanism: RealizationDispatch,
    authority: std.decl_ref.DeclarationRef { module_path: "v2.compiler.translate", decl_name: "target_serialize_source_from_model", field: std.decl_ref.WholeDeclaration }
  }
}
