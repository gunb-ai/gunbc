// src/v2/lens/application_serializer.dag
// Scope: Re-emit half of the read/edit pipeline — structural Diff/Node → canonical .dag source.
// Status: serialize_dag_source + serialize_applied_diff + DagSourcePatch for patch-in-error path.
// Anchor: design-read-edit-pipeline.md §4 step 7 (Re-emit); apply_diff lives in application.dag.

module v2.lens.application_serializer

import v2.compiler.source_authority { DagSource }
import v2.compiler.translate { target_serialize_source_from_model }
import v2.lens.application { apply_diff }
import v2.std.compilers.target_model { TargetModel }
import v2.std.diagnostic {
  Outcome,
  bind_outcome,
  outcome_accepted
}
import v2.std.node { Diff, Node }

// Before/after canonical source pair for a structural rewrite program.
type DagSourcePatch {
  before: DagSource
  after: DagSource
}

// Grammar-inverse serialize for one emitted Node (delegates to target_serialize_source_from_model).
fn serialize_dag_source(emitted: Node, target: TargetModel) -> Outcome<DagSource> {
  bind_outcome(
    o: target_serialize_source_from_model(target: target, emitted: emitted),
    f: fn(source) {
      outcome_accepted(value: source)
    }
  )
}

// Apply a Diff then serialize the patched root — fail-closed at either seam.
fn serialize_applied_diff(root: Node, diff: Diff, target: TargetModel) -> Outcome<DagSource> {
  bind_outcome(
    o: apply_diff(root: root, d: diff),
    f: fn(patched) {
      serialize_dag_source(emitted: patched, target: target)
    }
  )
}

// Patch-in-error carrier: canonical source before and after one Diff application.
fn serialize_diff_as_source_patch(
  root: Node,
  diff: Diff,
  target: TargetModel
) -> Outcome<DagSourcePatch> {
  bind_outcome(
    o: serialize_dag_source(emitted: root, target: target),
    f: fn(before) {
      bind_outcome(
        o: serialize_applied_diff(root: root, diff: diff, target: target),
        f: fn(after) {
          outcome_accepted(value: DagSourcePatch { before: before, after: after })
        }
      )
    }
  )
}
