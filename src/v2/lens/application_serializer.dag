module v2.lens.application_serializer
import v2.lens.common.construction_justification { ConstructionJustification, WallNow }

import extdeps.communication.medium { Medium }
import v2.compiler.translate { target_serialize_source_from_model }
import v2.lens.application { apply_diff }
import v2.std.compilers.target_model { TargetModel }
import v2.std.diagnostic {
  Outcome,
  bind_outcome,
  outcome_accepted
}
import v2.std.node { Diff, Node }

type DagSourcePatch {
  before: Medium<String>
  after: Medium<String>
}

fn serialize_diff_as_source_patch(
  root: Node,
  diff: Diff,
  canonical_source_target: TargetModel
) -> Outcome<DagSourcePatch> {
  bind_outcome(
    o: target_serialize_source_from_model(target: canonical_source_target, emitted: root),
    f: fn(before) {
      bind_outcome(
        o: apply_diff(root: root, d: diff),
        f: fn(patched) {
          bind_outcome(
            o: target_serialize_source_from_model(
              target: canonical_source_target,
              emitted: patched
            ),
            f: fn(after) {
              outcome_accepted(value: DagSourcePatch { before: before, after: after })
            }
          )
        }
      )
    }
  )
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallNow {
    construction: "the row-driven grammar inverse (DESIGN sec 4: emit = apply_diff . serialize, one grammar read backward) realized in v2.compiler translate"
  }
}
