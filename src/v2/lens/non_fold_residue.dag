module v2.lens.non_fold_residue


fn non_fold_residue_clean_holds() -> Bool {
  non_fold_residue_unrostered_count() == 0 && non_fold_residue_stale_roster_count() == 0
}

fn non_fold_residue_live_count() -> Int {
  non_fold_residue_count()
}

fn non_fold_residue_live_unrostered_count() -> Int {
  non_fold_residue_unrostered_count()
}

fn non_fold_residue_live_stale_roster_count() -> Int {
  non_fold_residue_stale_roster_count()
}

fn non_fold_residue_live_coproduct_universe_count() -> Int {
  non_fold_residue_coproduct_universe_count()
}

fn non_fold_residue_discovery_roots_follow_authority() -> Bool {
  census_corpus_roots_follow_layer_authority()
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SubstrateMandatoryTag }
}
