module v2.lens.complexity_linearity_audit


data complexity_linearity_debt_row_reason: String = "closed-coproduct wildcard arm classified migration-debt (not kernel-permanent): the match is over a closed coproduct and the wildcard hides arms a total match would surface"

data complexity_linearity_debt_row_dissolve: String = "the site's wildcard arm migrates to a total match; row deletes (roster-wide, the construction justification dissolves to SubstrateMandatoryTag)"

fn debt_row(unit: String) -> FrontierRow {
  frontier_row(
    unit: unit,
    reason: complexity_linearity_debt_row_reason,
    dissolve_on: complexity_linearity_debt_row_dissolve
  )
}

data complexity_linearity_migration_debt_roster: List<FrontierRow> = [
  debt_row(unit: "src/v2/compiler/05_eval.dag::eval_branch_node_eval"),
  debt_row(unit: "src/v2/compiler/05_eval.dag::eval_loop_node"),
  debt_row(unit: "src/v2/compiler/05_eval.dag::eval_match_node_eval"),
  debt_row(unit: "src/v2/compiler/05_eval.dag::eval_transform_node"),
  debt_row(unit: "src/v2/compiler/05_eval.dag::eval_value_node"),
  debt_row(unit: "src/v2/compiler/05_eval.dag::run_test_claim_assert_decided"),
  debt_row(unit: "src/v2/compiler/05_eval.dag::run_test_claim_runtime_assert"),
  debt_row(unit: "src/v2/compiler/01_tokenize.dag::lex_try_rules_prefer_longer"),
  debt_row(unit: "src/v2/compiler/06_translate.dag::translate_algebra_finalize"),
  debt_row(unit: "src/v2/compiler/emit_host.dag::run_test_claim_emit_vs_eval_verdict"),
  debt_row(unit: "dag/extdeps/languages/markdown.dag::md_nested"),
  debt_row(unit: "src/v2/extdeps/formats/spice_passive_projection.dag::passive_spec_from_component"),
  debt_row(unit: "src/v2/extdeps/formats/spice_passive_projection.dag::passive_topology_from_component"),
  debt_row(unit: "src/v2/extdeps/runtimes/v2_effect_io_pure.dag::effect_io_pure_backends_match"),
  debt_row(unit: "src/v2/std/compilers/target_model.dag::target_type_expr_emitted_validate_wire_shape"),
  debt_row(unit: "src/v2/std/compilers/target_model.dag::target_use_site_ownership_catalog_lookup_step"),
  debt_row(unit: "src/v2/test/claim/manual/eval_runtime.dag::eval_arg_is_two_literal"),
  debt_row(unit: "src/v2/lens/testgen.dag::algebra_law_subject_for_manual_anchor"),
  debt_row(unit: "src/v2/lens/testgen.dag::nat_manual_anchor_key_eq"),
  debt_row(unit: "src/v2/lens/testgen.dag::testgen_emit_language_behavior_equivalence_claim"),
  debt_row(unit: "src/v2/lens/testgen.dag::testgen_emit_refinement_preservation_claim"),
  debt_row(unit: "src/v2/test/claim/generated/coproduct_exhaustiveness.dag::anchor_is"),
  debt_row(unit: "src/v2/test/claim/generated/cross_representation_equality.dag::anchor_is_straddle")
]

type ComplexityLinearityWildcardFact {
  site: String
  fn_name: String
  closed_coproduct_wildcard: Bool
  rostered: Bool
}

fn string_eq(a: String, b: String) -> Bool {
  a == b
}

fn complexity_linearity_wildcard_facts_live() -> List<ComplexityLinearityWildcardFact> {
  complexity_linearity_wildcard_facts()
}

fn complexity_linearity_migration_debt_roster_live() -> List<String> {
  frontier_units(rows: complexity_linearity_migration_debt_roster)
}

fn migration_roster_contains(site: String) -> Bool {
  contains(
    xs: complexity_linearity_migration_debt_roster_live(),
    item: site,
    eq: string_eq
  )
}

fn is_kernel_permanent_fn(fn_name: String) -> Bool {
  ends_with(s: fn_name, suffix: "_eq")
    || string_contains(s: fn_name, pattern: "dominates")
    || string_contains(s: fn_name, pattern: "lattice_join")
    || string_contains(s: fn_name, pattern: "lattice_meet")
    || fn_name == "exit_ok"
    || string_contains(s: fn_name, pattern: "_relation_eq")
    || string_contains(s: fn_name, pattern: "_mode_eq")
    || ends_with(s: fn_name, suffix: "_combine")
    || fn_name == "constant_bound_value"
    || fn_name == "is_constant_bound"
    || fn_name == "create_double_init_collapsible"
    || fn_name == "create_effect_is_dedupable"
    || starts_with(s: fn_name, prefix: "compose_sub_value")
    || fn_name == "promote_to_strict"
    || starts_with(s: fn_name, prefix: "program_runtime_bool")
    || fn_name == "is_text_encoding"
    || fn_name == "is_strict_style_structural"
}

fn triage_wildcard(fact: ComplexityLinearityWildcardFact) -> String {
  if !fact.closed_coproduct_wildcard {
    "open-domain"
  } else if migration_roster_contains(site: fact.site) {
    "migration-debt"
  } else if fact.rostered {
    "kernel-permanent"
  } else if string_contains(s: fact.fn_name, pattern: "infer_match")
    && string_contains(s: fact.site, pattern: "04_infer.dag") {
    "migration-debt"
  } else if is_kernel_permanent_fn(fn_name: fact.fn_name) {
    "kernel-permanent"
  } else {
    "closed-coproduct-debt"
  }
}

fn count_triage_bucket(bucket: String) -> Int {
  fold_list(
    xs: complexity_linearity_wildcard_facts_live(),
    empty: 0,
    cons: fn(acc, fact) {
      if triage_wildcard(fact: fact) == bucket {
        acc + 1
      } else {
        acc
      }
    }
  )
}

fn count_rostered() -> Int {
  fold_list(
    xs: complexity_linearity_wildcard_facts_live(),
    empty: 0,
    cons: fn(acc, fact) {
      if fact.rostered {
        acc + 1
      } else {
        acc
      }
    }
  )
}

fn complexity_linearity_syntactic_wildcard_finding_count_live() -> Int {
  length(xs: complexity_linearity_wildcard_facts_live())
}

fn complexity_linearity_wildcard_total_live() -> Int {
  length(xs: complexity_linearity_wildcard_facts_live())
}

fn complexity_linearity_wildcard_on_roster_live() -> Int {
  count_rostered()
}

fn complexity_linearity_wildcard_off_roster_live() -> Int {
  complexity_linearity_wildcard_total_live() - count_rostered()
}

fn complexity_linearity_wildcard_open_domain_live() -> Int {
  count_triage_bucket(bucket: "open-domain")
}

fn complexity_linearity_wildcard_migration_debt_live() -> Int {
  count_triage_bucket(bucket: "migration-debt")
}

fn complexity_linearity_wildcard_kernel_permanent_live() -> Int {
  count_triage_bucket(bucket: "kernel-permanent")
}

fn complexity_linearity_wildcard_closed_coproduct_debt_live() -> Int {
  count_triage_bucket(bucket: "closed-coproduct-debt")
}

fn complexity_linearity_wildcard_triage_for_site(site: String) -> String {
  fold_list(
    xs: complexity_linearity_wildcard_facts_live(),
    empty: "none",
    cons: fn(acc, fact) {
      if acc == "none" && fact.site == site {
        triage_wildcard(fact: fact)
      } else {
        acc
      }
    }
  )
}

fn complexity_linearity_syntactic_finding_count_live() -> Int {
  complexity_linearity_syntactic_finding_count()
}

fn complexity_linearity_syntactic_site_fired_live(site: String) -> Bool {
  complexity_linearity_syntactic_site_fired(site: site)
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SubstrateMandatoryTag }
}
