module v2.lens.extdeps_shape_transport_policy.module_refs

import v2.std.qualified_name { QnCons, QnEmpty, QualifiedName }

data extdeps_cargo_build_module: QualifiedName = QnCons {
  head: ^extdeps,
  tail: QnCons { head: ^cargo_build, tail: QnEmpty }
}

data extdeps_git_module: QualifiedName = QnCons {
  head: ^extdeps,
  tail: QnCons { head: ^git, tail: QnEmpty }
}

data extdeps_gcp_module: QualifiedName = QnCons {
  head: ^extdeps,
  tail: QnCons {
    head: ^cloud,
    tail: QnCons { head: ^gcp, tail: QnCons { head: ^gcp, tail: QnEmpty } }
  }
}

data extdeps_github_gists_module: QualifiedName = QnCons {
  head: ^extdeps,
  tail: QnCons { head: ^github, tail: QnCons { head: ^gists, tail: QnEmpty } }
}

data extdeps_runtime_local_module: QualifiedName = QnCons {
  head: ^extdeps,
  tail: QnCons { head: ^runtime, tail: QnCons { head: ^local, tail: QnEmpty } }
}

data bogus_extdeps_module: QualifiedName = QnCons {
  head: ^extdeps,
  tail: QnCons { head: ^bogus_unknown_module_xyz, tail: QnEmpty }
}

data coverage_domain_equivalence_module: QualifiedName = QnCons {
  head: ^v2,
  tail: QnCons {
    head: ^test,
    tail: QnCons {
      head: ^extdeps_shape_transport_policy,
      tail: QnCons { head: ^coverage_domain_equivalence, tail: QnEmpty }
    }
  }
}

data module_source_nickname_literal_green_module: QualifiedName = QnCons {
  head: ^v2,
  tail: QnCons {
    head: ^test,
    tail: QnCons {
      head: ^extdeps_shape_transport_policy,
      tail: QnCons {
        head: ^lens_unit,
        tail: QnCons { head: ^module_source_nickname_literal_green, tail: QnEmpty }
      }
    }
  }
}

data module_source_nickname_literal_local_red_module: QualifiedName = QnCons {
  head: ^v2,
  tail: QnCons {
    head: ^test,
    tail: QnCons {
      head: ^extdeps_shape_transport_policy,
      tail: QnCons {
        head: ^lens_unit,
        tail: QnCons { head: ^module_source_nickname_literal_local_red, tail: QnEmpty }
      }
    }
  }
}
