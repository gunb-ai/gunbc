module v2.lens.machine_shape


data machine_shape_construction_wall_note: String = "Single-constructor discipline (machine-shape-orthogonal-scheduling.md §2 ruling 9 / operator redirect 2026-07-16): MachineShape may be MATERIALIZED only inside std.machine_shape, extdeps.*.machine_shape (shape_from_catalog fills beside cited catalog rows), or in test/claim RED controls. Every other direct MachineShape { .. } record literal is an unsanctioned hand-authored shape — judgment-guarded until this compile gate lands. Precedent: symbol_index_fill's fill-only discipline (SymbolIndex materializes only through symbol_index_fill_* / empty_symbol_index, never a parallel index walk). Recognition: module-context fold_node_topdown + callee Atom identity (^MachineShape on a Transform call), mirroring determinism_compile_gate's map_keys reach detection."

data machine_shape_witness_scope_note: String = "SCOPE: dag/test/claim and src/v2/test/claim are deliberately OUT OF SCOPE — a witness that CONSTRUCTS MachineShape to exercise machine_shape_validate RED arms is building the escape hatch to TEST it, not smuggling a shape. std.machine_shape is the type authority; extdeps cpu/gpu machine_shape modules are the sanctioned catalog fills. Production substrate elsewhere must call shape_from_catalog and match on MachineShapeConstruction."

data machine_shape_authority_module: String = "std.machine_shape"

fn node_callee_symbol(n: Node) -> Optional<Symbol> {
  if node_is_call(node: n) {
    match list_at_optional(xs: node_positional_child_targets(node: n), index: 0) {
      Present { value: callee } => match callee.kind {
        TypeNode { connective: Atom { identity: sym } } => optional_present(value: sym)
        _ => optional_absent()
      }
      Absent => optional_absent()
    }
  } else {
    optional_absent()
  }
}

fn qualified_name_is_authority_home(qn: QualifiedName) -> Bool {
  qualified_name_to_dotted_string(qn: qn) == machine_shape_authority_module
}

fn qualified_name_is_catalog_fill_home(qn: QualifiedName) -> Bool {
  let dotted = qualified_name_to_dotted_string(qn: qn)
  dotted.starts_with(prefix: "extdeps.") && dotted.ends_with(suffix: ".machine_shape")
}

fn qualified_name_is_witness_module(qn: QualifiedName) -> Bool {
  let dotted = qualified_name_to_dotted_string(qn: qn)
  dotted.starts_with(prefix: "test.claim.")
    || dotted.starts_with(prefix: "v2.test.")
}

fn module_allows_machine_shape_literal(qn: Optional<QualifiedName>) -> Bool {
  match qn {
    Absent => false
    Present { value: qn0 } =>
      qualified_name_is_authority_home(qn: qn0)
        || qualified_name_is_catalog_fill_home(qn: qn0)
        || qualified_name_is_witness_module(qn: qn0)
  }
}

fn module_qn_from_node(n: Node, inherited: Optional<QualifiedName>) -> Optional<QualifiedName> {
  match parse_production_emitted_identity_optional(node: n) {
    Present { value: id } =>
      if id == ^dag_surface_module {
        match qualified_name_from_module_node(root: n) {
          Accepted { value: qn, diagnostics: _ } => optional_present(value: qn)
          Rejected { diagnostics: _ } => inherited
        }
      } else {
        inherited
      }
    Absent => inherited
  }
}

fn machine_shape_unsanctioned_construction_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^machine_shape_unsanctioned_construction,
    at: node_locus(node: n),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn local_machine_shape_findings(n: Node, module_qn: Optional<QualifiedName>) -> List<Diagnostic> {
  if module_allows_machine_shape_literal(qn: module_qn) {
    []
  } else {
    match node_callee_symbol(n: n) {
      Present { value: sym } =>
        if sym == ^MachineShape {
          [machine_shape_unsanctioned_construction_diagnostic(n: n)]
        } else {
          []
        }
      Absent => []
    }
  }
}

type MachineShapeWalkCtx {
  module_qn: Optional<QualifiedName>
}

type MachineShapeWalkResult {
  module_qn: Optional<QualifiedName>
  findings: List<Diagnostic>
}

fn machine_shape_walk_init(n: Node, ctx: MachineShapeWalkCtx) -> MachineShapeWalkResult {
  let module_qn = module_qn_from_node(n: n, inherited: ctx.module_qn)
  MachineShapeWalkResult {
    module_qn: module_qn,
    findings: local_machine_shape_findings(n: n, module_qn: module_qn)
  }
}

fn machine_shape_walk_child_context(
  n: Node,
  ctx: MachineShapeWalkCtx,
  _: Edge
) -> MachineShapeWalkCtx {
  MachineShapeWalkCtx {
    module_qn: module_qn_from_node(n: n, inherited: ctx.module_qn)
  }
}

fn machine_shape_walk_step(
  acc: MachineShapeWalkResult,
  _: Edge,
  child_r: MachineShapeWalkResult
) -> MachineShapeWalkResult {
  MachineShapeWalkResult {
    module_qn: child_r.module_qn,
    findings: concat(acc.findings, child_r.findings)
  }
}

fn machine_shape_topdown_algebra() -> NodeFoldTopDown<MachineShapeWalkCtx, MachineShapeWalkResult> {
  NodeFoldTopDown {
    init: machine_shape_walk_init,
    child_context: machine_shape_walk_child_context,
    step: machine_shape_walk_step
  }
}

fn machine_shape_construction_findings(root: Node) -> List<Diagnostic> {
  match fold_node_topdown(
    n: root,
    ctx: MachineShapeWalkCtx { module_qn: optional_absent() },
    algebra: machine_shape_topdown_algebra()
  ) {
    MachineShapeWalkResult { module_qn: _, findings: findings } => findings
  }
}

data compile_gate_law: String = "MachineShape single-constructor compile gate (operator redirect 2026-07-16): a direct MachineShape record literal outside std.machine_shape, extdeps.*.machine_shape, and outside test/claim witnesses FAILS COMPILATION, inheriting compile's affected-set scoping. shape_from_catalog is the sanctioned producer; consumers match MachineShapeConstruction and never hand-author shapes. Grain: rooted whole-tree walk (module-context fold_node_topdown) — enrolls in always_required_root_lenses, not the per-node roster. Witness lane = RED controls in machine_shape_construction_wall_test; enforcement never the witness."

fn machine_shape_compile_gate(node: Node) -> Outcome<Witness<Node>> {
  match machine_shape_construction_findings(root: node) {
    Cons { head: first, tail: rest } =>
      Rejected {
        diagnostics: NonEmptyDiagnostics { head: first, tail: rest }
      }
    Empty => outcome_accepted(value: Holds { value: node })
  }
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SingleAuthority }
}
