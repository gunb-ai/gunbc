module v2.lens.machine_shape

import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }
import std.disposition { SingleAuthority }
import v2.extdeps.languages.dag {
  parse_production_emitted_identity_optional,
  qualified_name_from_module_node
}
import v2.std.collection { List }
import v2.std.optional {
  Absent,
  Optional,
  Present,
  optional_absent,
  optional_present
}
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  NonEmptyDiagnostics,
  Outcome,
  Rejected,
  Unavailable,
  node_locus,
  outcome_accepted
}
import v2.std.logic { Bool }
import v2.std.node {
  Edge,
  Node,
  NodeFoldTopDown,
  Symbol,
  fold_node_topdown
}
import v2.std.node_query { construct_tag_optional }
import v2.std.compilers.body_lowering {
  ApplicationSlotsFound,
  ApplicationSlotsRefused,
  ArrowHead,
  AtomHead,
  NotApplicationSlots,
  application_slots
}
import std.algebra { Cons, Empty }
import v2.std.qualified_name { QualifiedName, qualified_name_to_dotted_string }
import v2.std.witness { Holds, Witness }

// Single-constructor discipline (machine-shape-orthogonal-scheduling.md §2 ruling 9 / operator
// redirect 2026-07-16): MachineShape may be MATERIALIZED only inside std.machine_shape,
// extdeps.*.machine_shape (shape_from_catalog fills beside cited catalog rows), or in test/claim
// RED controls. Every other direct MachineShape { .. } record literal is an unsanctioned
// hand-authored shape — judgment-guarded until this compile gate lands. Precedent:
// symbol_index_fill's fill-only discipline (SymbolIndex materializes only through
// symbol_index_fill_* / empty_symbol_index, never a parallel index walk). Recognition:
// module-context fold_node_topdown over BOTH lowered spellings of a construction: a record literal
// `MachineShape { .. }` lowers to a construct (a Conj whose first edge names the tag,
// v2.std.node_query construct_tag_optional), and a call-spelled `MachineShape(..)` to an
// application whose head is the atom. Until MQ-2 (gunbc#12202) only the call spelling was read, so
// a real record literal passed unseen.

// SCOPE: dag/test/claim and src/v2/test/claim are deliberately OUT OF SCOPE — a witness that
// CONSTRUCTS MachineShape to exercise machine_shape_validate RED arms is building the escape hatch
// to TEST it, not smuggling a shape. std.machine_shape is the type authority; extdeps cpu/gpu
// machine_shape modules are the sanctioned catalog fills. Production substrate elsewhere must call
// shape_from_catalog and match on MachineShapeConstruction.

data machine_shape_authority_module: String = "std.machine_shape"

fn qualified_name_is_authority_home(qn: QualifiedName) -> Bool {
  qualified_name_to_dotted_string(qn: qn) == machine_shape_authority_module
}

fn qualified_name_is_catalog_fill_home(qn: QualifiedName) -> Bool {
  let dotted = qualified_name_to_dotted_string(qn: qn)
  dotted.starts_with(prefix: "extdeps.") && dotted.ends_with(suffix: ".machine_shape")
}

fn qualified_name_is_witness_module(qn: QualifiedName) -> Bool {
  let dotted = qualified_name_to_dotted_string(qn: qn)
  dotted.starts_with(prefix: "test.claim.")
    || dotted.starts_with(prefix: "v2.test.")
}

fn module_allows_machine_shape_literal(qn: Optional<QualifiedName>) -> Bool {
  match qn {
    Absent => false
    Present { value: qn0 } =>
      qualified_name_is_authority_home(qn: qn0)
        || qualified_name_is_catalog_fill_home(qn: qn0)
        || qualified_name_is_witness_module(qn: qn0)
  }
}

fn module_qn_from_node(n: Node, inherited: Optional<QualifiedName>) -> Optional<QualifiedName> {
  match parse_production_emitted_identity_optional(node: n) {
    Present { value: id } =>
      if id == ^dag_surface_module {
        match qualified_name_from_module_node(root: n) {
          Accepted { value: qn, diagnostics: _ } => optional_present(value: qn)
          Rejected { diagnostics: _ } => inherited
        }
      } else {
        inherited
      }
    Absent => inherited
  }
}

fn machine_shape_unsanctioned_construction_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^machine_shape_unsanctioned_construction,
    at: node_locus(node: n),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

// WHAT THIS NODE CONSTRUCTS, IF ANYTHING. The application is read through the base read
// application_slots: the question is the head, never an operand, and a refused application is a
// finding in its own right. An Arrow head is a resolved function reference, never a constructor.
type ConstructedTag
  = NoConstruction
  | Constructs { tag: Symbol }
  | ConstructionUnreadable { diagnostics: NonEmptyDiagnostics }

fn constructed_tag(n: Node) -> ConstructedTag {
  match construct_tag_optional(n: n) {
    Present { value: tag } => Constructs { tag: tag }
    Absent =>
      match application_slots(site: n) {
        NotApplicationSlots => NoConstruction
        ApplicationSlotsRefused { diagnostics: d } => ConstructionUnreadable { diagnostics: d }
        ApplicationSlotsFound { slots: v } =>
          match v.head_identity {
            AtomHead { identity: sym } => Constructs { tag: sym }
            ArrowHead => NoConstruction
          }
      }
  }
}

data machine_shape_no_findings: List<Diagnostic> = []

fn diagnostics_as_list(d: NonEmptyDiagnostics) -> List<Diagnostic> {
  Cons { head: d.head, tail: d.tail }
}

fn local_machine_shape_findings(n: Node, module_qn: Optional<QualifiedName>) -> List<Diagnostic> {
  if module_allows_machine_shape_literal(qn: module_qn) {
    machine_shape_no_findings
  } else {
    match constructed_tag(n: n) {
      NoConstruction => machine_shape_no_findings
      ConstructionUnreadable { diagnostics: d } => diagnostics_as_list(d: d)
      Constructs { tag: tag } =>
        if tag == ^MachineShape {
          [machine_shape_unsanctioned_construction_diagnostic(n: n)]
        } else {
          machine_shape_no_findings
        }
    }
  }
}

type MachineShapeWalkCtx {
  module_qn: Optional<QualifiedName>
}

type MachineShapeWalkResult {
  module_qn: Optional<QualifiedName>
  findings: List<Diagnostic>
}

fn machine_shape_walk_init(n: Node, ctx: MachineShapeWalkCtx) -> MachineShapeWalkResult {
  let module_qn = module_qn_from_node(n: n, inherited: ctx.module_qn)
  MachineShapeWalkResult {
    module_qn: module_qn,
    findings: local_machine_shape_findings(n: n, module_qn: module_qn)
  }
}

fn machine_shape_walk_child_context(
  n: Node,
  ctx: MachineShapeWalkCtx,
  _: Edge
) -> MachineShapeWalkCtx {
  MachineShapeWalkCtx {
    module_qn: module_qn_from_node(n: n, inherited: ctx.module_qn)
  }
}

fn machine_shape_walk_step(
  acc: MachineShapeWalkResult,
  _: Edge,
  child_r: MachineShapeWalkResult
) -> MachineShapeWalkResult {
  MachineShapeWalkResult {
    module_qn: child_r.module_qn,
    findings: concat(acc.findings, child_r.findings)
  }
}

fn machine_shape_topdown_algebra() -> NodeFoldTopDown<MachineShapeWalkCtx, MachineShapeWalkResult> {
  NodeFoldTopDown {
    init: machine_shape_walk_init,
    child_context: machine_shape_walk_child_context,
    step: machine_shape_walk_step
  }
}

fn machine_shape_construction_findings(root: Node) -> List<Diagnostic> {
  match fold_node_topdown(
    n: root,
    ctx: MachineShapeWalkCtx { module_qn: optional_absent() },
    algebra: machine_shape_topdown_algebra()
  ) {
    MachineShapeWalkResult { module_qn: _, findings: findings } => findings
  }
}

data compile_gate_law: String = "MachineShape single-constructor compile gate (operator redirect 2026-07-16): a direct MachineShape construction (record literal or call spelling) outside std.machine_shape, extdeps.*.machine_shape, and outside test/claim witnesses FAILS COMPILATION, inheriting compile's affected-set scoping. shape_from_catalog is the sanctioned producer; consumers match MachineShapeConstruction and never hand-author shapes. Grain: rooted whole-tree walk (module-context fold_node_topdown) — registers at CompileLensRoot grain in required_compile_lens_roster, not at CompileLensSubtree. Witness lane = RED controls in machine_shape_construction_wall_test; enforcement never the witness."

fn machine_shape_compile_gate(node: Node) -> Outcome<Witness<Node>> {
  match machine_shape_construction_findings(root: node) {
    Cons { head: first, tail: rest } =>
      Rejected {
        diagnostics: NonEmptyDiagnostics { head: first, tail: rest }
      }
    Empty => outcome_accepted(value: Holds { value: node })
  }
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SingleAuthority }
}
