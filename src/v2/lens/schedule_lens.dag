module v2.lens.schedule_lens


type ScheduleLensViolation
  = EmptySchedule
  | CheapGatesMissingFromFirstBatch
  | CompileGateInFirstBatch { expected: String }
  | CompileGateNotSecond { expected: String }
  | CorpusBeforeCompile
  | SingleBatchOnly

data schedule_lens_module: String = "v2.lens.schedule_lens"

fn schedule_lens_compile_gate_in_first_batch_reason(expected: String) -> Symbol {
  symbol_intern_lexeme(lexeme: "schedule_lens_compile_gate_in_first_batch:" + expected)
}

fn schedule_lens_compile_gate_not_second_reason(expected: String) -> Symbol {
  symbol_intern_lexeme(lexeme: "schedule_lens_compile_gate_not_second:" + expected)
}

fn schedule_lens_batch_has_any_cheap_gate(batch: List<Runnable>, cheap_gate_labels: List<String>) -> Bool {
  fold(cheap_gate_labels, init: false, f: fn(found, label) {
    found || schedule_batch_contains_label(batch: batch, target: label)
  })
}

fn schedule_lens_violation_diagnostic(kind: ScheduleLensViolation) -> Diagnostic {
  let module_file = lens_verdict_module_file(module_name: schedule_lens_module)
  match kind {
    EmptySchedule =>
      textual_whole_file_diagnostic(
        reason: ^schedule_lens_empty_schedule,
        module_file: module_file,
        correction: Unavailable { reason: CorrectionNotModeled }
      )
    CheapGatesMissingFromFirstBatch =>
      textual_whole_file_diagnostic(
        reason: ^schedule_lens_cheap_gates_missing_from_first_batch,
        module_file: module_file,
        correction: Unavailable { reason: CorrectionNotModeled }
      )
    CompileGateInFirstBatch { expected: expected } =>
      textual_whole_file_diagnostic(
        reason: schedule_lens_compile_gate_in_first_batch_reason(expected: expected),
        module_file: module_file,
        correction: Unavailable { reason: CorrectionNotModeled }
      )
    CompileGateNotSecond { expected: expected } =>
      textual_whole_file_diagnostic(
        reason: schedule_lens_compile_gate_not_second_reason(expected: expected),
        module_file: module_file,
        correction: Unavailable { reason: CorrectionNotModeled }
      )
    CorpusBeforeCompile =>
      textual_whole_file_diagnostic(
        reason: ^schedule_lens_corpus_before_compile,
        module_file: module_file,
        correction: Unavailable { reason: CorrectionNotModeled }
      )
    SingleBatchOnly =>
      textual_whole_file_diagnostic(
        reason: ^schedule_lens_single_batch_only,
        module_file: module_file,
        correction: Unavailable { reason: CorrectionNotModeled }
      )
  }
}

fn schedule_lens_verdict_for_ci_floor(
  plan: RealizationPlan<Runnable>,
  compile_gate_fn: String,
  cheap_gate_labels: List<String>
) -> LensVerdict {
  if plan.schedule.count() == 0 {
    Violation {
      diagnostic: schedule_lens_violation_diagnostic(kind: EmptySchedule)
    }
  } else if plan.schedule.count() < 3 {
    Violation {
      diagnostic: schedule_lens_violation_diagnostic(kind: SingleBatchOnly)
    }
  } else {
    let batch0 = plan.schedule.first()
    if schedule_batch_contains_label(batch: batch0, target: compile_gate_fn) {
      Violation {
        diagnostic: schedule_lens_violation_diagnostic(
          kind: CompileGateInFirstBatch { expected: compile_gate_fn }
        )
      }
    } else if schedule_batch_contains_label(batch: batch0, target: "__discovery_corpus__") {
      Violation {
        diagnostic: schedule_lens_violation_diagnostic(kind: CorpusBeforeCompile)
      }
    } else if !schedule_lens_batch_has_any_cheap_gate(batch: batch0, cheap_gate_labels: cheap_gate_labels) {
      Violation {
        diagnostic: schedule_lens_violation_diagnostic(kind: CheapGatesMissingFromFirstBatch)
      }
    } else {
      let batch1 = plan.schedule.skip(n: 1).first()
      if (batch1.count() != 1) || !schedule_batch_contains_label(batch: batch1, target: compile_gate_fn) {
        Violation {
          diagnostic: schedule_lens_violation_diagnostic(
            kind: CompileGateNotSecond { expected: compile_gate_fn }
          )
        }
      } else if schedule_batch_contains_label(batch: batch1, target: "__discovery_corpus__") {
        Violation {
          diagnostic: schedule_lens_violation_diagnostic(kind: CorpusBeforeCompile)
        }
      } else {
        let has_parallel_rest = fold(plan.schedule.skip(n: 2), init: false, f: fn(found, batch) {
          found || (batch.count() >= 2)
        })
        if !has_parallel_rest {
          Violation {
            diagnostic: schedule_lens_violation_diagnostic(kind: SingleBatchOnly)
          }
        } else {
          Holds
        }
      }
    }
  }
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: RealizationDispatch }
}
