module v2.lens.schedule_lens


type ScheduleLensViolation
  = EmptySchedule
  | CheapGatesMissingFromFirstBatch
  | CompileGateInFirstBatch { expected: String }
  | CompileGateNotSecond { expected: String }
  | CorpusBeforeCompile
  | SingleBatchOnly
  | OrdinaryProjectionMismatch
  | OnSuccessRunnableRefused
  | OnSuccessStageMismatch
  | OnSuccessDuplicateRunnable

data schedule_lens_module: String = "v2.lens.schedule_lens"

fn schedule_lens_compile_gate_in_first_batch_reason(expected: String) -> v2.std.node.Symbol {
  symbol_intern_lexeme(lexeme: "schedule_lens_compile_gate_in_first_batch:" + expected)
}

fn schedule_lens_compile_gate_not_second_reason(expected: String) -> v2.std.node.Symbol {
  symbol_intern_lexeme(lexeme: "schedule_lens_compile_gate_not_second:" + expected)
}

fn schedule_lens_batch_has_any_cheap_gate(batch: List<std.realization_schedule.Runnable>, cheap_gate_labels: List<String>) -> Bool {
  fold(cheap_gate_labels, init: false, f: fn(found, label) {
    found || schedule_batch_contains_label(batch: batch, target: label)
  })
}

fn schedule_lens_violation_diagnostic(kind: ScheduleLensViolation) -> v2.std.diagnostic.Diagnostic {
  let module_file = lens_verdict_module_file(module_name: schedule_lens_module)
  match kind {
    EmptySchedule =>
      textual_whole_file_diagnostic(
        reason: ^schedule_lens_empty_schedule,
        module_file: module_file,
        correction: v2.std.diagnostic.Unavailable { reason: CorrectionNotModeled }
      )
    CheapGatesMissingFromFirstBatch =>
      textual_whole_file_diagnostic(
        reason: ^schedule_lens_cheap_gates_missing_from_first_batch,
        module_file: module_file,
        correction: v2.std.diagnostic.Unavailable { reason: CorrectionNotModeled }
      )
    CompileGateInFirstBatch { expected: expected } =>
      textual_whole_file_diagnostic(
        reason: schedule_lens_compile_gate_in_first_batch_reason(expected: expected),
        module_file: module_file,
        correction: v2.std.diagnostic.Unavailable { reason: CorrectionNotModeled }
      )
    CompileGateNotSecond { expected: expected } =>
      textual_whole_file_diagnostic(
        reason: schedule_lens_compile_gate_not_second_reason(expected: expected),
        module_file: module_file,
        correction: v2.std.diagnostic.Unavailable { reason: CorrectionNotModeled }
      )
    CorpusBeforeCompile =>
      textual_whole_file_diagnostic(
        reason: ^schedule_lens_corpus_before_compile,
        module_file: module_file,
        correction: v2.std.diagnostic.Unavailable { reason: CorrectionNotModeled }
      )
    SingleBatchOnly =>
      textual_whole_file_diagnostic(
        reason: ^schedule_lens_single_batch_only,
        module_file: module_file,
        correction: v2.std.diagnostic.Unavailable { reason: CorrectionNotModeled }
      )
    OrdinaryProjectionMismatch =>
      textual_whole_file_diagnostic(
        reason: ^schedule_lens_ordinary_projection_mismatch,
        module_file: module_file,
        correction: v2.std.diagnostic.Unavailable { reason: CorrectionNotModeled }
      )
    OnSuccessRunnableRefused =>
      textual_whole_file_diagnostic(
        reason: ^schedule_lens_on_success_runnable_refused,
        module_file: module_file,
        correction: v2.std.diagnostic.Unavailable { reason: CorrectionNotModeled }
      )
    OnSuccessStageMismatch =>
      textual_whole_file_diagnostic(
        reason: ^schedule_lens_on_success_stage_mismatch,
        module_file: module_file,
        correction: v2.std.diagnostic.Unavailable { reason: CorrectionNotModeled }
      )
    OnSuccessDuplicateRunnable =>
      textual_whole_file_diagnostic(
        reason: ^schedule_lens_on_success_duplicate_runnable,
        module_file: module_file,
        correction: v2.std.diagnostic.Unavailable { reason: CorrectionNotModeled }
      )
  }
}

fn schedule_lens_verdict_for_ci_floor_ordinary(
  plan: std.realization_schedule.RealizationPlan<std.realization_schedule.Runnable>,
  compile_gate_fn: String,
  cheap_gate_labels: List<String>
) -> v2.std.lens_verdict.LensVerdict {
  if plan.schedule.count() == 0 {
    v2.std.lens_verdict.Violation {
      diagnostic: schedule_lens_violation_diagnostic(kind: EmptySchedule)
    }
  } else if plan.schedule.count() < 3 {
    v2.std.lens_verdict.Violation {
      diagnostic: schedule_lens_violation_diagnostic(kind: SingleBatchOnly)
    }
  } else {
    let batch0 = plan.schedule.first()
    if schedule_batch_contains_label(batch: batch0, target: compile_gate_fn) {
      v2.std.lens_verdict.Violation {
        diagnostic: schedule_lens_violation_diagnostic(
          kind: CompileGateInFirstBatch { expected: compile_gate_fn }
        )
      }
    } else if schedule_batch_contains_label(batch: batch0, target: "__discovery_corpus__") {
      v2.std.lens_verdict.Violation {
        diagnostic: schedule_lens_violation_diagnostic(kind: CorpusBeforeCompile)
      }
    } else if !schedule_lens_batch_has_any_cheap_gate(batch: batch0, cheap_gate_labels: cheap_gate_labels) {
      v2.std.lens_verdict.Violation {
        diagnostic: schedule_lens_violation_diagnostic(kind: CheapGatesMissingFromFirstBatch)
      }
    } else {
      let batch1 = plan.schedule.skip(n: 1).first()
      if (batch1.count() != 1) || !schedule_batch_contains_label(batch: batch1, target: compile_gate_fn) {
        v2.std.lens_verdict.Violation {
          diagnostic: schedule_lens_violation_diagnostic(
            kind: CompileGateNotSecond { expected: compile_gate_fn }
          )
        }
      } else if schedule_batch_contains_label(batch: batch1, target: "__discovery_corpus__") {
        v2.std.lens_verdict.Violation {
          diagnostic: schedule_lens_violation_diagnostic(kind: CorpusBeforeCompile)
        }
      } else {
        let has_parallel_rest = fold(plan.schedule.skip(n: 2), init: false, f: fn(found, batch) {
          found || (batch.count() >= 2)
        })
        if !has_parallel_rest {
          v2.std.lens_verdict.Violation {
            diagnostic: schedule_lens_violation_diagnostic(kind: SingleBatchOnly)
          }
        } else {
          Holds
        }
      }
    }
  }
}

fn on_success_runnable_is_admitted(runnable: std.realization_schedule.Runnable) -> Bool {
  match on_success_runnable_disposition(runnable: runnable) {
    OnSuccessRunnableAdmitted => true
    _ => false
  }
}

fn on_success_stage_is_admitted(stage: List<std.realization_schedule.Runnable>) -> Bool {
  fold(stage, init: true, f: fn(admitted, runnable) {
    admitted && on_success_runnable_is_admitted(runnable: runnable)
  })
}

fn on_success_stages_are_admitted(stages: List<List<std.realization_schedule.Runnable>>) -> Bool {
  fold(stages, init: true, f: fn(admitted, stage) {
    admitted && on_success_stage_is_admitted(stage: stage)
  })
}

fn runnable_occurs_in(runnable: std.realization_schedule.Runnable, runnables: List<std.realization_schedule.Runnable>) -> Bool {
  fold(runnables, init: false, f: fn(found, candidate) {
    found || runnable_eq(left: runnable, right: candidate)
  })
}

fn runnable_occurs_in_stages(runnable: std.realization_schedule.Runnable, stages: List<List<std.realization_schedule.Runnable>>) -> Bool {
  fold(stages, init: false, f: fn(found, stage) {
    found || runnable_occurs_in(runnable: runnable, runnables: stage)
  })
}

fn on_success_stage_has_duplicate(
  stage: List<std.realization_schedule.Runnable>,
  later_stages: List<List<std.realization_schedule.Runnable>>
) -> Bool {
  if stage.count() == 0 {
    false
  } else if runnable_occurs_in(runnable: stage.first(), runnables: stage.skip(n: 1))
    || runnable_occurs_in_stages(runnable: stage.first(), stages: later_stages) {
    true
  } else {
    on_success_stage_has_duplicate(
      stage: stage.skip(n: 1),
      later_stages: later_stages
    )
  }
}

fn on_success_stages_have_duplicate(stages: List<List<std.realization_schedule.Runnable>>) -> Bool {
  if stages.count() == 0 {
    false
  } else if on_success_stage_has_duplicate(
    stage: stages.first(),
    later_stages: stages.skip(n: 1)
  ) {
    true
  } else {
    on_success_stages_have_duplicate(stages: stages.skip(n: 1))
  }
}

fn on_success_stages_eq(
  actual: List<List<std.realization_schedule.Runnable>>,
  expected: List<List<std.realization_schedule.Runnable>>
) -> Bool {
  if actual.count() != expected.count() {
    false
  } else if actual.count() == 0 {
    true
  } else if !bag_eq(xs: actual.first(), ys: expected.first(), eq: runnable_eq) {
    false
  } else {
    on_success_stages_eq(
      actual: actual.skip(n: 1),
      expected: expected.skip(n: 1)
    )
  }
}

data walk_plan_schedule_lens_note: String = "The WalkPlan schedule lens owns the join the executor consumes: batches must be the ordinary RealizationPlan projection; on-success stage barriers remain ordered; siblings inside one stage compare as an unordered multiset because WalkPlan promises no sibling order; and every stage member must have the modeled std.realization_schedule on_success_runnable_disposition OnSuccessRunnableAdmitted. Duplicate runnable identity (entry + function + full profile) refuses until duplication has an explicit model. Finalization is deliberately outside this lens: gunbc.ci_materialization finalization witnesses and the strict runtime parser own it. Complete WalkPlan coverage composes this ordinary schedule check, success-stage structure and admissibility, the finalization witness, and executor-semantics controls."

fn walk_plan_schedule_lens_verdict_for_ci_floor<F>(
  plan: std.realization_schedule.WalkPlan<F>,
  ordinary_plan: std.realization_schedule.RealizationPlan<std.realization_schedule.Runnable>,
  expected_on_success_stages: List<List<std.realization_schedule.Runnable>>,
  compile_gate_fn: String,
  cheap_gate_labels: List<String>
) -> v2.std.lens_verdict.LensVerdict {
  if !schedule_eq(left: plan.batches, right: ordinary_plan.schedule) {
    v2.std.lens_verdict.Violation {
      diagnostic: schedule_lens_violation_diagnostic(kind: OrdinaryProjectionMismatch)
    }
  } else {
    match schedule_lens_verdict_for_ci_floor_ordinary(
      plan: ordinary_plan,
      compile_gate_fn: compile_gate_fn,
      cheap_gate_labels: cheap_gate_labels
    ) {
      Violation { diagnostic: diagnostic } => v2.std.lens_verdict.Violation { diagnostic: diagnostic }
      NotApplicable { diagnostic: diagnostic } => v2.std.lens_verdict.NotApplicable { diagnostic: diagnostic }
      Unrealized { diagnostic: diagnostic } => v2.std.lens_verdict.Unrealized { diagnostic: diagnostic }
      Holds =>
        if !on_success_stages_are_admitted(stages: plan.on_success_stages) {
          v2.std.lens_verdict.Violation {
            diagnostic: schedule_lens_violation_diagnostic(kind: OnSuccessRunnableRefused)
          }
        } else if on_success_stages_have_duplicate(stages: plan.on_success_stages)
          || on_success_stages_have_duplicate(stages: expected_on_success_stages) {
          v2.std.lens_verdict.Violation {
            diagnostic: schedule_lens_violation_diagnostic(kind: OnSuccessDuplicateRunnable)
          }
        } else if !on_success_stages_eq(
          actual: plan.on_success_stages,
          expected: expected_on_success_stages
        ) {
          v2.std.lens_verdict.Violation {
            diagnostic: schedule_lens_violation_diagnostic(kind: OnSuccessStageMismatch)
          }
        } else {
          Holds
        }
    }
  }
}

data construction_justification: v2.lens.common.construction_justification.ConstructionJustification = v2.lens.common.construction_justification.ConstructionJustification {
  class: v2.lens.common.construction_justification.WallAfterGrounding { dissolves_to: RealizationDispatch }
}
