module v2.lens.schedule_lens

import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }
import std.disposition { RealizationDispatch }
import std.realization_schedule {
  RealizationPlan,
  schedule_batch_contains_label,
}
import v2.std.compilers.lexing { symbol_intern_lexeme }
import v2.std.diagnostic {
  CorrectionNotModeled,
  Diagnostic,
  Unavailable,
  textual_whole_file_diagnostic,
}
import v2.std.lens_verdict {
  Holds,
  LensVerdict,
  Violation,
  lens_verdict_module_file,
}
import v2.std.node { Symbol }
import v2.std.text { String }

type ScheduleLensViolation
  = EmptySchedule
  | CompileGateNotFirst { expected: String }
  | CorpusBeforeCompile
  | SingleBatchOnly

data schedule_lens_module: String = "v2.lens.schedule_lens"

fn schedule_lens_compile_gate_not_first_reason(expected: String) -> Symbol {
  symbol_intern_lexeme(lexeme: "schedule_lens_compile_gate_not_first:" + expected)
}

fn schedule_lens_violation_diagnostic(kind: ScheduleLensViolation) -> Diagnostic {
  let module_file = lens_verdict_module_file(module_name: schedule_lens_module)
  match kind {
    EmptySchedule =>
      textual_whole_file_diagnostic(
        reason: ^schedule_lens_empty_schedule,
        module_file: module_file,
        correction: Unavailable { reason: CorrectionNotModeled }
      )
    CompileGateNotFirst { expected: expected } =>
      textual_whole_file_diagnostic(
        reason: schedule_lens_compile_gate_not_first_reason(expected: expected),
        module_file: module_file,
        correction: Unavailable { reason: CorrectionNotModeled }
      )
    CorpusBeforeCompile =>
      textual_whole_file_diagnostic(
        reason: ^schedule_lens_corpus_before_compile,
        module_file: module_file,
        correction: Unavailable { reason: CorrectionNotModeled }
      )
    SingleBatchOnly =>
      textual_whole_file_diagnostic(
        reason: ^schedule_lens_single_batch_only,
        module_file: module_file,
        correction: Unavailable { reason: CorrectionNotModeled }
      )
  }
}

fn schedule_lens_verdict_for_ci_floor<S>(plan: RealizationPlan<S>, compile_gate_fn: String) -> LensVerdict {
  if plan.schedule.count() == 0 {
    Violation {
      diagnostic: schedule_lens_violation_diagnostic(kind: EmptySchedule)
    }
  } else if plan.schedule.count() < 2 {
    Violation {
      diagnostic: schedule_lens_violation_diagnostic(kind: SingleBatchOnly)
    }
  } else {
    let batch0 = plan.schedule.first()
    if batch0.count() != 1 {
      Violation {
        diagnostic: schedule_lens_violation_diagnostic(
          kind: CompileGateNotFirst { expected: compile_gate_fn }
        )
      }
    } else if !schedule_batch_contains_label(batch: batch0, target: compile_gate_fn) {
      Violation {
        diagnostic: schedule_lens_violation_diagnostic(
          kind: CompileGateNotFirst { expected: compile_gate_fn }
        )
      }
    } else if schedule_batch_contains_label(batch: batch0, target: "__discovery_corpus__") {
      Violation {
        diagnostic: schedule_lens_violation_diagnostic(kind: CorpusBeforeCompile)
      }
    } else {
      let batch1 = plan.schedule.skip(n: 1).first()
      if batch1.count() < 2 {
        Violation {
          diagnostic: schedule_lens_violation_diagnostic(kind: SingleBatchOnly)
        }
      } else {
        Holds
      }
    }
  }
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: RealizationDispatch }
}
