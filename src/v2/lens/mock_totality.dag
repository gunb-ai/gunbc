// src/v2/lens/mock_totality.dag
// Scope: TOTALITY lens — a published mock corpus vs. a consumer that must handle EVERY member.
// Anchor: DESIGN.md §4 (pure reader, stores nothing) / §5 (fail-closed) / §6 (gate, not illusion).
//
// The operator's layering contract has three parts: a layer PUBLISHES a mock corpus as a
// closed structural fact (`v2.extdeps.filesystem.mock_corpus`), an adjacent layer's CONSUMER
// materializes ANY published case impl-blind, and THIS lens enforces the consumer is TOTAL —
// it fail-closes (§5) the moment a published member is left unhandled.
//
// Why a lens and not the compiler: a `match` over a closed coproduct is already totality-checked
// by the substrate, but the published corpus is DECLARED DATA (a `data List`), not a type — the
// compiler cannot see that a corpus row has no handler. A consumer matches on an open key (the
// operation `Symbol`) with a fail-closed `_` arm; this lens is what makes "you added a published
// case but not its handler" a LOUD error instead of a silent fall-through.
//
// §3 reuse, not fork: the missing-member set is computed by `missing_coverage` / `Coverage<C>`
// from `v2.lens.coverage` — the SAME expected-vs-actual machinery that already underlies the
// (zero-consumer) `coverage_lens`. This lens is its first CI-GATING consumer (see the
// discriminating RED-on-omission witness under src/v2/test/lens_mock_totality/), dissolving the
// §6 "machinery exists but nothing gates on it" illusion for that machinery rather than minting
// a third missing-set implementation beside it.

module v2.lens.mock_totality

import v2.lens.coverage { Coverage, missing_coverage }
import v2.std.collection { List }
import v2.std.algebra { is_empty }
import v2.std.diagnostic {
  Correction,
  Diagnostic,
  Locus,
  Outcome,
  Rejected,
  Textual,
  Unavailable,
  UserInputBoundary,
  WholeFile,
  diagnostics_singleton,
  outcome_accepted
}
import v2.std.node { Symbol }

// A consumer materializes a published case impl-blind: it `Accepted` the cases it handles and
// fail-closes (`Rejected`) on a case it has no handler for. `mock_unhandled_rejection` is the
// canonical fail-closed arm a consumer returns for such a case (§5). The consumer is run by the
// gate WITNESS (where the per-case verdict collapses to a `Bool` predicate) — the lens itself
// stays a pure list reader, because v2 does not yet admit a higher-order `fn(C) -> Outcome<M>`
// parameter (see the `Outcome<R>` algebra-fn deferral noted in v2.std.node).
fn mock_unhandled_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^mock_totality_unhandled_member,
    at: Textual { file: ^mock_totality_virtual_file, extent: WholeFile },
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn mock_unhandled_rejection<M>() -> Outcome<M> {
  Rejected { diagnostics: diagnostics_singleton(d: mock_unhandled_diagnostic()) }
}

// The lens reading: every published member the consumer FAILED to materialize (expected − handled),
// computed by the SAME missing-set machinery (`missing_coverage` / `Coverage<C>`) that underlies
// `coverage_lens` — reused, not forked (§3). `handled` is the subset of `published` the consumer
// accepted; the witness produces it by running the consumer over the corpus.
fn mock_totality_missing<C>(
  published: List<C>,
  handled: List<C>,
  eq: fn(C, C) -> Bool
) -> List<Coverage<C>> {
  missing_coverage(expected: published, actual: handled, eq: eq)
}

// The TOTALITY lens. Accepts (returns the published corpus) iff the consumer handled every
// published member; fail-closes (§5) with a located diagnostic the moment one is left unhandled.
// Pure reader over the substrate facts — stores nothing (§4).
fn mock_totality_lens<C>(
  published: List<C>,
  handled: List<C>,
  eq: fn(C, C) -> Bool
) -> Outcome<List<C>> {
  if is_empty(xs: mock_totality_missing(published: published, handled: handled, eq: eq)) {
    outcome_accepted(value: published)
  } else {
    Rejected { diagnostics: diagnostics_singleton(d: mock_unhandled_diagnostic()) }
  }
}
