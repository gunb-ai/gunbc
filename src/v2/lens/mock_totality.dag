module v2.lens.mock_totality
import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }
import std.disposition { SubstrateMandatoryTag }

import v2.lens.coverage { Coverage, missing_coverage }
import v2.std.collection { List }
import v2.std.algebra { is_empty }
import v2.std.diagnostic {
  Correction,
  Diagnostic,
  Locus,
  Outcome,
  Rejected,
  Textual,
  Unavailable,
  UserInputBoundary,
  WholeFile,
  diagnostics_singleton,
  outcome_accepted
}
import v2.std.node { Symbol }

fn mock_unhandled_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^mock_totality_unhandled_member,
    at: Textual { file: ^mock_totality_virtual_file, extent: WholeFile },
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn mock_unhandled_rejection<M>() -> Outcome<M> {
  Rejected { diagnostics: diagnostics_singleton(d: mock_unhandled_diagnostic()) }
}

fn mock_totality_missing<C>(
  published: List<C>,
  handled: List<C>,
  eq: fn(C, C) -> Bool
) -> List<Coverage<C>> {
  missing_coverage(expected: published, actual: handled, eq: eq)
}

fn mock_totality_lens<C>(
  published: List<C>,
  handled: List<C>,
  eq: fn(C, C) -> Bool
) -> Outcome<List<C>> {
  if is_empty(xs: mock_totality_missing(published: published, handled: handled, eq: eq)) {
    outcome_accepted(value: published)
  } else {
    Rejected { diagnostics: diagnostics_singleton(d: mock_unhandled_diagnostic()) }
  }
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SubstrateMandatoryTag },
  rationale: "A match over a closed coproduct is already totality-checked by the substrate, but a published corpus is declared data the compiler cannot see is unhandled; the lens covers exactly that gap until corpus-as-type. Grounding authority: corpus-as-type: the substrate totality-checking a consumer against a published corpus expressed as a closed type Dissolves on: an unhandled published corpus member becomes a compile error by construction (today the corpus is declared data, not a type)"
}
