module v2.lens.mock_totality


fn mock_unhandled_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^mock_totality_unhandled_member,
    at: v2.std.diagnostic.Textual { file: ^mock_totality_virtual_file, extent: WholeFile },
    correction: v2.std.diagnostic.Unavailable { reason: UserInputBoundary }
  }
}

fn mock_unhandled_rejection<M>() -> Outcome<M> {
  v2.std.diagnostic.Rejected { diagnostics: diagnostics_singleton(d: mock_unhandled_diagnostic()) }
}

fn mock_totality_missing<C>(
  published: List<C>,
  handled: List<C>,
  eq: fn(C, C) -> Bool
) -> List<Coverage<C>> {
  missing_coverage(expected: published, actual: handled, eq: eq)
}

fn mock_totality_lens<C>(
  published: List<C>,
  handled: List<C>,
  eq: fn(C, C) -> Bool
) -> Outcome<List<C>> {
  if is_empty(xs: mock_totality_missing(published: published, handled: handled, eq: eq)) {
    outcome_accepted(value: published)
  } else {
    v2.std.diagnostic.Rejected { diagnostics: diagnostics_singleton(d: mock_unhandled_diagnostic()) }
  }
}

data construction_justification: v2.lens.common.construction_justification.ConstructionJustification = v2.lens.common.construction_justification.ConstructionJustification {
  class: v2.lens.common.construction_justification.WallAfterGrounding { dissolves_to: SubstrateMandatoryTag }
}
