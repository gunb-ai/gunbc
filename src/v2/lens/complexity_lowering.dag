module v2.lens.complexity_lowering


type ComplexityLowering {
  name: v2.std.node.Symbol
  before: v2.lens.cost.AsymptoticClass
  after: v2.lens.cost.AsymptoticClass
}

fn asymptotic_class_equal(a: v2.lens.cost.AsymptoticClass, b: v2.lens.cost.AsymptoticClass) -> Bool {
  asymptotic_class_dominates(a: a, b: b) && asymptotic_class_dominates(a: b, b: a)
}

fn strictly_lowers(r: ComplexityLowering) -> Bool {
  asymptotic_class_dominates(a: r.before, b: r.after)
    && !asymptotic_class_dominates(a: r.after, b: r.before)
}

fn loop_invariant_hoist() -> ComplexityLowering {
  ComplexityLowering {
    name: ^loop_invariant_hoist,
    before: v2.lens.cost.ClassPolynomial { degree: polynomial_degree_two() },
    after: ClassLinear
  }
}

fn lowering_catalog() -> FreeMonoid<ComplexityLowering> {
  [ loop_invariant_hoist() ]
}

fn catalog_is_sound() -> Bool {
  for_all(xs: lowering_catalog(), predicate: strictly_lowers)
}

fn lowering_matches_class(r: ComplexityLowering, cls: v2.lens.cost.AsymptoticClass) -> Bool {
  asymptotic_class_equal(a: r.before, b: cls)
}

fn cost_class_is_lowerable(cls: v2.lens.cost.AsymptoticClass) -> Bool {
  any(xs: lowering_catalog(), predicate: fn(r) { lowering_matches_class(r: r, cls: cls) })
}

fn cost_is_lowerable(c: v2.lens.cost.SymbolicCost) -> Bool {
  cost_class_is_lowerable(cls: asymptotic_class_of_cost(cost: c))
}

fn minimized_class(c: v2.lens.cost.SymbolicCost) -> v2.lens.cost.AsymptoticClass {
  fold_list(
    xs: lowering_catalog(),
    empty: asymptotic_class_of_cost(cost: c),
    cons: fn(acc, r) {
      if lowering_matches_class(r: r, cls: asymptotic_class_of_cost(cost: c)) {
        r.after
      } else {
        acc
      }
    }
  )
}

data construction_justification: v2.lens.common.construction_justification.ConstructionJustification = v2.lens.common.construction_justification.ConstructionJustification {
  class: v2.lens.common.construction_justification.WallAfterGrounding { dissolves_to: SingleAuthority }
}
