module v2.lens.effect_reach


data effect_reach_law: String = "Effect-reach census (module-identity-storage-binding Phase 0): proven host-effect closure = call-reachable fn bodies from the witness entry over fn-arrow DependencyView facts, marking every string literal or data-init path literal that flows into a declared host-effect sink callee. Unknown path resolution fail-closed → HostEffectReach with UnknownPath empty string (still derived host-reading). Known-miss frontier: constructed paths (concat of literals that fail pure-path shape) and paths outside src/|dag/+.dag/no-spaces evade path census entirely → row keeps declared/default ReadsLiveTree disposition (miss ≤ baseline); falsely-declared rows and constructed deps close with Phase 1 typed SourceRef. Dissolves when typed SourceRef at host boundaries is ENFORCED and the bare-string file-dependency class is MIGRATED — not when the type is merely declared (task 5 flagship is per-row opt-in; 115 rows remain)."

data construction_justification: v2.lens.common.construction_justification.ConstructionJustification = v2.lens.common.construction_justification.ConstructionJustification {
  class: v2.lens.common.construction_justification.WallAfterGrounding { dissolves_to: std.disposition.SingleAuthority }
}

data empty_flow_list: List<v2.std.effect_reach.EffectReachFlow> = []
data empty_decl_list: List<v2.std.fn_index.FnArrowDecl> = []
data empty_string_list: List<String> = []
data empty_symbol_list: List<v2.std.node.Symbol> = []
data empty_node_list: List<v2.std.node.Node> = []

fn string_eq(a: String, b: String) -> v2.std.logic.Bool {
  a == b
}

fn symbol_eq(a: v2.std.node.Symbol, b: v2.std.node.Symbol) -> v2.std.logic.Bool {
  a == b
}

fn is_path_like_lexeme(text: String) -> v2.std.logic.Bool {
  string_contains(s: text, pattern: ".dag")
    || starts_with(s: text, prefix: "src/")
    || starts_with(s: text, prefix: "dag/")
}

fn callee_text_is_host_sink(text: String) -> v2.std.logic.Bool {
  v2.std.algebra.contains(xs: v2.std.effect_reach.effect_reach_host_sink_callee_symbols_v0, item: text, eq: v2.lens.effect_reach.string_eq)
}

fn decl_module_prefix(mod_path: String) -> String {
  concat(mod_path, ".")
}

fn decl_belongs_to_module(decl: v2.std.fn_index.FnArrowDecl, mod_path: String) -> v2.std.logic.Bool {
  starts_with(s: decl.qualified_name, prefix: v2.lens.effect_reach.decl_module_prefix(mod_path: mod_path))
    || v2.lens.effect_reach.string_eq(a: decl.qualified_name, b: mod_path)
}

fn decls_in_module(decls: List<v2.std.fn_index.FnArrowDecl>, mod_path: String) -> List<v2.std.fn_index.FnArrowDecl> {
  v2.std.algebra.filter(
    xs: decls,
    predicate: fn(decl) { v2.lens.effect_reach.decl_belongs_to_module(decl: decl, mod_path: mod_path) }
  )
}

fn decls_in_modules(decls: List<v2.std.fn_index.FnArrowDecl>, modules: List<String>) -> List<v2.std.fn_index.FnArrowDecl> {
  v2.std.algebra.fold_list(xs: modules, empty: v2.lens.effect_reach.empty_decl_list, cons: fn(acc, mod_path) {
    v2.std.algebra.list_append(left: acc, right: v2.lens.effect_reach.decls_in_module(decls: decls, mod_path: mod_path))
  })
}

fn data_init_belongs_to_modules(decl: v2.std.data_index.DataInitDecl, modules: List<String>) -> v2.std.logic.Bool {
  v2.std.algebra.any(xs: modules, predicate: fn(m) { v2.lens.effect_reach.string_eq(a: decl.module, b: m) })
}

fn data_inits_in_modules(
  inits: List<v2.std.data_index.DataInitDecl>,
  modules: List<String>
) -> List<v2.std.data_index.DataInitDecl> {
  v2.std.algebra.filter(
    xs: inits,
    predicate: fn(decl) { data_init_belongs_to_modules(decl: decl, modules: modules) }
  )
}

fn data_init_is_path_literal(decl: v2.std.data_index.DataInitDecl) -> v2.std.logic.Bool {
  starts_with(s: decl.literal_fp, prefix: "str:")
    && !string_contains(s: decl.literal_fp, pattern: " ")
    && string_contains(s: decl.literal_fp, pattern: ".dag")
    && (string_contains(s: decl.literal_fp, pattern: "src/")
      || string_contains(s: decl.literal_fp, pattern: "dag/"))
}

fn data_init_fp_matches_path(decl: v2.std.data_index.DataInitDecl, path: String) -> v2.std.logic.Bool {
  string_contains(s: decl.literal_fp, pattern: path)
}

fn sink_kind_for_callee(callee_text: String) -> v2.std.effect_reach.HostEffectSinkKind {
  if v2.lens.effect_reach.string_eq(a: callee_text, b: "Read")
    || v2.lens.effect_reach.string_eq(a: callee_text, b: "Filesystem.Read") {
    v2.std.effect_reach.FilesystemReadSink
  } else if v2.lens.effect_reach.string_eq(a: callee_text, b: "WitnessBin.Run")
    || v2.lens.effect_reach.string_eq(a: callee_text, b: "gunbc.WitnessBin.Run") {
    v2.std.effect_reach.WitnessBinRunSink
  } else if v2.lens.effect_reach.string_eq(a: callee_text, b: "Run")
    || v2.lens.effect_reach.string_eq(a: callee_text, b: "shell.Exec.Run")
    || v2.lens.effect_reach.string_eq(a: callee_text, b: "Exec.Run") {
    v2.std.effect_reach.ShellExecRunSink
  } else {
    v2.std.effect_reach.UnknownHostEffectSink
  }
}

fn flow_eq(a: v2.std.effect_reach.EffectReachFlow, b: v2.std.effect_reach.EffectReachFlow) -> v2.std.logic.Bool {
  match a {
    EffectReachFlow { sink: sa, path_literal: pa, init_literal_fp: fpa } =>
      match b {
        EffectReachFlow { sink: sb, path_literal: pb, init_literal_fp: fpb } =>
          v2.lens.effect_reach.string_eq(a: pa, b: pb)
            && v2.lens.effect_reach.string_eq(a: fpa, b: fpb)
            && sink_kind_eq(a: sa, b: sb)
      }
  }
}

fn sink_kind_eq(a: v2.std.effect_reach.HostEffectSinkKind, b: v2.std.effect_reach.HostEffectSinkKind) -> v2.std.logic.Bool {
  match a {
    FilesystemReadSink =>
      match b { v2.std.effect_reach.FilesystemReadSink => true _ => false }
    WitnessBinRunSink =>
      match b { v2.std.effect_reach.WitnessBinRunSink => true _ => false }
    ShellExecRunSink =>
      match b { v2.std.effect_reach.ShellExecRunSink => true _ => false }
    GunbcCompileEntrySink =>
      match b { v2.std.effect_reach.GunbcCompileEntrySink => true _ => false }
    UnknownHostEffectSink =>
      match b { v2.std.effect_reach.UnknownHostEffectSink => true _ => false }
  }
}

fn flow_already_present(flows: List<v2.std.effect_reach.EffectReachFlow>, candidate: v2.std.effect_reach.EffectReachFlow) -> v2.std.logic.Bool {
  v2.std.algebra.any(xs: flows, predicate: fn(f) { flow_eq(a: f, b: candidate) })
}

fn merge_flows(left: List<v2.std.effect_reach.EffectReachFlow>, right: List<v2.std.effect_reach.EffectReachFlow>) -> List<v2.std.effect_reach.EffectReachFlow> {
  v2.std.algebra.fold_list(xs: right, empty: left, cons: fn(acc, f) {
    if flow_already_present(flows: acc, candidate: f) {
      acc
    } else {
      v2.std.algebra.list_snoc_item(xs: acc, item: f)
    }
  })
}

fn path_literal_from_lexeme(
  text: String,
  param_names: List<String>,
  data_inits: List<v2.std.data_index.DataInitDecl>
) -> String {
  if v2.lens.effect_reach.is_path_like_lexeme(text: text) {
    text
  } else if v2.std.algebra.contains(xs: param_names, item: text, eq: v2.lens.effect_reach.string_eq) {
    ""
  } else {
    v2.std.algebra.fold_list(xs: data_inits, empty: "", cons: fn(acc, decl) {
      if acc != "" {
        acc
      } else if v2.std.data_index.lexeme_matches_literal_fp(lexeme: text, literal_fp: decl.literal_fp) {
        if data_init_is_path_literal(decl: decl) {
          text
        } else {
          ""
        }
      } else if v2.lens.effect_reach.string_eq(a: decl.name, b: text) && data_init_is_path_literal(decl: decl) {
        decl.name
      } else {
        acc
      }
    })
  }
}

fn positional_child_targets(node: v2.std.node.Node) -> List<v2.std.node.Node> {
  fold(node.children, init: v2.lens.effect_reach.empty_node_list, f: fn(acc, e) {
    match e.label {
      Positional => v2.std.algebra.list_snoc_item(xs: acc, item: e.target)
      Named { name: _ } => acc
    }
  })
}

fn arg_symbols_from_nodes(nodes: List<v2.std.node.Node>) -> List<v2.std.node.Symbol> {
  v2.std.algebra.fold_list(xs: nodes, empty: empty_symbol_list, cons: fn(acc, n) {
    match v2.std.grammar.node_atom_identity_optional(node: n) {
      Present { value: sym } => v2.std.algebra.list_snoc_item(xs: acc, item: sym)
      Absent => acc
    }
  })
}

fn tail_nodes(xs: List<v2.std.node.Node>) -> List<v2.std.node.Node> {
  match v2.std.algebra.list_tail(xs: xs) {
    TailFound { tail: t } => t
    TailAbsent => v2.lens.effect_reach.empty_node_list
  }
}

fn flows_from_sink_call(
  callee_text: String,
  args: List<v2.std.node.Symbol>,
  param_names: List<String>,
  data_inits: List<v2.std.data_index.DataInitDecl>
) -> List<v2.std.effect_reach.EffectReachFlow> {
  let sink = sink_kind_for_callee(callee_text: callee_text)
  match sink {
    UnknownHostEffectSink => empty_flow_list
    _ =>
      match v2.std.algebra.list_head(xs: args) {
        HeadFound { value: arg } =>
          let text = v2.std.compilers.lexing.symbol_lexeme(sym: arg)
          let path = path_literal_from_lexeme(
            text: text,
            param_names: param_names,
            data_inits: data_inits
          )
          [
            v2.std.effect_reach.EffectReachFlow {
              sink: sink,
              path_literal: path,
              init_literal_fp: ""
            }
          ]
        HeadAbsent =>
          [v2.std.effect_reach.EffectReachFlow { sink: sink, path_literal: "", init_literal_fp: "" }]
      }
  }
}

fn flows_from_call_node(
  node: v2.std.node.Node,
  param_names: List<String>,
  data_inits: List<v2.std.data_index.DataInitDecl>
) -> List<v2.std.effect_reach.EffectReachFlow> {
  let targets = v2.lens.effect_reach.positional_child_targets(node: node)
  match v2.std.algebra.list_head(xs: targets) {
    HeadFound { value: callee_node } =>
      match v2.std.grammar.node_atom_identity_optional(node: callee_node) {
        Present { value: callee } =>
          let callee_text = v2.std.compilers.lexing.symbol_lexeme(sym: callee)
          if callee_text_is_host_sink(text: callee_text) {
            flows_from_sink_call(
              callee_text: callee_text,
              args: v2.lens.effect_reach.arg_symbols_from_nodes(nodes: v2.lens.effect_reach.tail_nodes(xs: targets)),
              param_names: param_names,
              data_inits: data_inits
            )
          } else {
            empty_flow_list
          }
        Absent => empty_flow_list
      }
    HeadAbsent => empty_flow_list
  }
}

type AtomCollectState {
  node: v2.std.node.Node
  atoms: List<v2.std.node.Symbol>
}

fn atom_collect_init(n: v2.std.node.Node) -> AtomCollectState {
  AtomCollectState { node: n, atoms: empty_symbol_list }
}

fn atom_collect_step(acc: AtomCollectState, _edge: v2.std.node.Edge, child: AtomCollectState) -> AtomCollectState {
  let atoms = match v2.std.grammar.node_atom_identity_optional(node: child.node) {
    Present { value: sym } =>
      if v2.std.algebra.contains(xs: acc.atoms, item: sym, eq: v2.lens.effect_reach.symbol_eq) {
        acc.atoms
      } else {
        v2.std.algebra.list_snoc_item(xs: acc.atoms, item: sym)
      }
    Absent => acc.atoms
  }
  AtomCollectState { node: acc.node, atoms: atoms }
}

fn atom_collect_algebra() -> v2.std.node.NodeFold<AtomCollectState> {
  v2.std.node.NodeFold { init: v2.lens.effect_reach.atom_collect_init, step: atom_collect_step }
}

fn atom_identities_in_node(node: v2.std.node.Node) -> List<v2.std.node.Symbol> {
  let from_descendants = v2.std.node.fold_node(n: node, algebra: v2.lens.effect_reach.atom_collect_algebra()).atoms
  match v2.std.grammar.node_atom_identity_optional(node: node) {
    Present { value: sym } =>
      if v2.std.algebra.contains(xs: from_descendants, item: sym, eq: v2.lens.effect_reach.symbol_eq) {
        from_descendants
      } else {
        v2.std.algebra.list_snoc_item(xs: from_descendants, item: sym)
      }
    Absent => from_descendants
  }
}

fn literal_path_flows_from_atoms(
  atoms: List<v2.std.node.Symbol>,
  data_inits: List<v2.std.data_index.DataInitDecl>
) -> List<v2.std.effect_reach.EffectReachFlow> {
  v2.std.algebra.fold_list(xs: atoms, empty: empty_flow_list, cons: fn(acc, sym) {
    let text = v2.std.compilers.lexing.symbol_lexeme(sym: sym)
    let path = path_literal_from_lexeme(
      text: text,
      param_names: v2.lens.effect_reach.empty_string_list,
      data_inits: data_inits
    )
    if path != "" {
      let flow = v2.std.effect_reach.EffectReachFlow {
        sink: v2.std.effect_reach.FilesystemReadSink,
        path_literal: path,
        init_literal_fp: ""
      }
      if flow_already_present(flows: acc, candidate: flow) {
        acc
      } else {
        v2.std.algebra.list_snoc_item(xs: acc, item: flow)
      }
    } else {
      acc
    }
  })
}

type FlowScanState {
  node: v2.std.node.Node
  flows: List<v2.std.effect_reach.EffectReachFlow>
  param_names: List<String>
  data_inits: List<v2.std.data_index.DataInitDecl>
}

fn flow_scan_init(
  n: v2.std.node.Node,
  param_names: List<String>,
  data_inits: List<v2.std.data_index.DataInitDecl>
) -> FlowScanState {
  FlowScanState {
    node: n,
    flows: empty_flow_list,
    param_names: param_names,
    data_inits: data_inits
  }
}

fn flow_scan_step(acc: FlowScanState, _edge: v2.std.node.Edge, child: FlowScanState) -> FlowScanState {
  let from_call = flows_from_call_node(
    node: child.node,
    param_names: acc.param_names,
    data_inits: acc.data_inits
  )
  let from_literals = literal_path_flows_from_atoms(
    atoms: v2.lens.effect_reach.atom_identities_in_node(node: child.node),
    data_inits: acc.data_inits
  )
  FlowScanState {
    node: acc.node,
    flows: merge_flows(
      left: merge_flows(left: acc.flows, right: from_call),
      right: from_literals
    ),
    param_names: acc.param_names,
    data_inits: acc.data_inits
  }
}

fn flow_scan_algebra(
  param_names: List<String>,
  data_inits: List<v2.std.data_index.DataInitDecl>
) -> v2.std.node.NodeFold<FlowScanState> {
  v2.std.node.NodeFold {
    init: fn(n) { flow_scan_init(n: n, param_names: param_names, data_inits: data_inits) },
    step: flow_scan_step
  }
}

fn param_names_of(decl: v2.std.fn_index.FnArrowDecl) -> List<String> {
  v2.std.algebra.fold_list(xs: decl.params, empty: v2.lens.effect_reach.empty_string_list, cons: fn(acc, p) {
    v2.std.algebra.list_snoc_item(xs: acc, item: v2.std.compilers.lexing.symbol_lexeme(sym: p.name))
  })
}

fn flows_in_node(
  node: v2.std.node.Node,
  param_names: List<String>,
  data_inits: List<v2.std.data_index.DataInitDecl>
) -> List<v2.std.effect_reach.EffectReachFlow> {
  let from_descendants = v2.std.node.fold_node(
    n: node,
    algebra: flow_scan_algebra(param_names: param_names, data_inits: data_inits)
  ).flows
  merge_flows(
    left: from_descendants,
    right: merge_flows(
      left: flows_from_call_node(
        node: node,
        param_names: param_names,
        data_inits: data_inits
      ),
      right: literal_path_flows_from_atoms(
        atoms: v2.lens.effect_reach.atom_identities_in_node(node: node),
        data_inits: data_inits
      )
    )
  )
}

fn callees_from_node(node: v2.std.node.Node) -> List<String> {
  v2.std.algebra.fold_list(
    xs: v2.lens.effect_reach.atom_identities_in_node(node: node),
    empty: v2.lens.effect_reach.empty_string_list,
    cons: fn(acc, sym) {
      let text = v2.std.compilers.lexing.symbol_lexeme(sym: sym)
      if callee_text_is_host_sink(text: text) || v2.lens.effect_reach.is_path_like_lexeme(text: text) {
        acc
      } else if v2.std.algebra.contains(xs: acc, item: text, eq: v2.lens.effect_reach.string_eq) {
        acc
      } else {
        v2.std.algebra.list_snoc_item(xs: acc, item: text)
      }
    }
  )
}

fn fn_arrow_decl_eq(a: v2.std.fn_index.FnArrowDecl, b: v2.std.fn_index.FnArrowDecl) -> v2.std.logic.Bool {
  v2.lens.effect_reach.string_eq(a: a.qualified_name, b: b.qualified_name)
}

fn decl_in_list(decl: v2.std.fn_index.FnArrowDecl, xs: List<v2.std.fn_index.FnArrowDecl>) -> v2.std.logic.Bool {
  v2.std.algebra.any(xs: xs, predicate: fn(d) { v2.lens.effect_reach.fn_arrow_decl_eq(a: d, b: decl) })
}

fn decls_matching_callee(
  decls: List<v2.std.fn_index.FnArrowDecl>,
  modules: List<String>,
  callee: String
) -> List<v2.std.fn_index.FnArrowDecl> {
  v2.std.algebra.filter(
    xs: v2.lens.effect_reach.decls_in_modules(decls: decls, modules: modules),
    predicate: fn(decl) { v2.lens.effect_reach.string_eq(a: decl.name, b: callee) }
  )
}

fn tail_decls(xs: List<v2.std.fn_index.FnArrowDecl>) -> List<v2.std.fn_index.FnArrowDecl> {
  match v2.std.algebra.list_tail(xs: xs) {
    TailFound { tail: t } => t
    TailAbsent => v2.lens.effect_reach.empty_decl_list
  }
}

fn call_reachable_decls_go(
  seeds: List<v2.std.fn_index.FnArrowDecl>,
  closure_modules: List<String>,
  decls: List<v2.std.fn_index.FnArrowDecl>,
  reached: List<v2.std.fn_index.FnArrowDecl>
) -> List<v2.std.fn_index.FnArrowDecl> {
  match v2.std.algebra.list_head(xs: seeds) {
    HeadAbsent => reached
    HeadFound { value: seed } =>
      let rest = v2.lens.effect_reach.tail_decls(xs: seeds)
      if v2.lens.effect_reach.decl_in_list(decl: seed, xs: reached) {
        v2.lens.effect_reach.call_reachable_decls_go(
          seeds: rest,
          closure_modules: closure_modules,
          decls: decls,
          reached: reached
        )
      } else {
        let next_reached = v2.std.algebra.list_snoc_item(xs: reached, item: seed)
        let callees = v2.lens.effect_reach.callees_from_node(node: seed.output)
        let callee_decls = v2.std.algebra.fold_list(xs: callees, empty: v2.lens.effect_reach.empty_decl_list, cons: fn(acc, callee) {
          v2.std.algebra.list_append(
            left: acc,
            right: v2.lens.effect_reach.decls_matching_callee(
              decls: decls,
              modules: closure_modules,
              callee: callee
            )
          )
        })
        v2.lens.effect_reach.call_reachable_decls_go(
          seeds: v2.std.algebra.list_append(left: rest, right: callee_decls),
          closure_modules: closure_modules,
          decls: decls,
          reached: next_reached
        )
      }
  }
}

fn call_reachable_decls(
  entry_module: String,
  closure_modules: List<String>,
  decls: List<v2.std.fn_index.FnArrowDecl>
) -> List<v2.std.fn_index.FnArrowDecl> {
  v2.lens.effect_reach.call_reachable_decls_go(
    seeds: v2.lens.effect_reach.decls_in_module(decls: decls, mod_path: entry_module),
    closure_modules: closure_modules,
    decls: decls,
    reached: v2.lens.effect_reach.empty_decl_list
  )
}

fn flows_from_reachable_decls(
  reachable: List<v2.std.fn_index.FnArrowDecl>,
  data_inits: List<v2.std.data_index.DataInitDecl>
) -> List<v2.std.effect_reach.EffectReachFlow> {
  v2.std.algebra.fold_list(xs: reachable, empty: empty_flow_list, cons: fn(acc, decl) {
    merge_flows(
      left: acc,
      right: flows_in_node(
        node: decl.output,
        param_names: v2.lens.effect_reach.param_names_of(decl: decl),
        data_inits: data_inits
      )
    )
  })
}

fn closure_data_init_path_flows(
  closure_modules: List<String>,
  data_inits: List<v2.std.data_index.DataInitDecl>
) -> List<v2.std.effect_reach.EffectReachFlow> {
  let scoped = data_inits_in_modules(inits: data_inits, modules: closure_modules)
  v2.std.algebra.fold_list(xs: scoped, empty: empty_flow_list, cons: fn(acc, decl) {
    if data_init_is_path_literal(decl: decl) {
      let flow = v2.std.effect_reach.EffectReachFlow {
        sink: v2.std.effect_reach.GunbcCompileEntrySink,
        path_literal: "",
        init_literal_fp: decl.literal_fp
      }
      if flow_already_present(flows: acc, candidate: flow) {
        acc
      } else {
        v2.std.algebra.list_snoc_item(xs: acc, item: flow)
      }
    } else {
      acc
    }
  })
}

fn effect_reach_classification_from_facts(
  entry_module: String,
  facts: List<v2.lens.witness_cost_locality.ModuleImportFact>,
  decls: List<v2.std.fn_index.FnArrowDecl>,
  data_inits: List<v2.std.data_index.DataInitDecl>
) -> v2.std.effect_reach.EffectReachClassification {
  let closure_modules = v2.lens.witness_cost_locality.witness_import_closure(root: entry_module, facts: facts)
  let reachable = v2.lens.effect_reach.call_reachable_decls(
    entry_module: entry_module,
    closure_modules: closure_modules,
    decls: decls
  )
  let from_calls = flows_from_reachable_decls(
    reachable: reachable,
    data_inits: data_inits
  )
  let from_data = closure_data_init_path_flows(
    closure_modules: closure_modules,
    data_inits: data_inits
  )
  let flows = merge_flows(left: from_calls, right: from_data)
  if v2.std.algebra.length(xs: flows) == 0 {
    v2.std.effect_reach.LocalEffect
  } else {
    v2.std.effect_reach.HostEffectReach { flows: flows }
  }
}

fn effect_reach_classification_from_facts_v0(
  entry_module: String,
  facts: List<v2.lens.witness_cost_locality.ModuleImportFact>
) -> v2.std.effect_reach.EffectReachClassification {
  effect_reach_classification_from_facts(
    entry_module: entry_module,
    facts: facts,
    decls: v2.std.fn_index.fn_arrow_decl_facts_live(),
    data_inits: v2.std.data_index.data_init_decl_facts_live()
  )
}

fn classification_is_local(classification: v2.std.effect_reach.EffectReachClassification) -> v2.std.logic.Bool {
  match classification {
    LocalEffect => true
    HostEffectReach { flows: _ } => false
  }
}

fn derived_host_reading(classification: v2.std.effect_reach.EffectReachClassification) -> v2.std.logic.Bool {
  !v2.lens.effect_reach.classification_is_local(classification: classification)
}

fn flow_touched_by_path(flow: v2.std.effect_reach.EffectReachFlow, path: String) -> v2.std.logic.Bool {
  match flow {
    EffectReachFlow { sink: _, path_literal: p, init_literal_fp: fp } =>
      if p != "" {
        v2.lens.module_graph.path_matches_touched(closure_path: p, touched_path: path)
      } else if fp != "" {
        string_contains(s: fp, pattern: path)
      } else {
        true
      }
  }
}

fn classification_has_path_literal(
  classification: v2.std.effect_reach.EffectReachClassification,
  path: String
) -> v2.std.logic.Bool {
  match classification {
    LocalEffect => false
    HostEffectReach { flows: flows } =>
      v2.std.algebra.any(xs: flows, predicate: fn(flow) { flow_touched_by_path(flow: flow, path: path) })
  }
}

fn effect_reach_touched_by_paths(
  classification: v2.std.effect_reach.EffectReachClassification,
  touched_paths: List<String>
) -> v2.std.logic.Bool {
  v2.std.algebra.any(
    xs: touched_paths,
    predicate: fn(p) { classification_has_path_literal(classification: classification, path: p) }
  )
}

fn effect_reach_flow_count(classification: v2.std.effect_reach.EffectReachClassification) -> Int {
  match classification {
    LocalEffect => 0
    HostEffectReach { flows: flows } => v2.std.algebra.length(xs: flows)
  }
}
