module v2.test.lens_complexity.nested


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly
type LensComplexityClaim {
  input: v2.std.node.Node
  expected_cost: v2.lens.cost.SymbolicCost
  expected_complexity: v2.lens.complexity.ComplexityBound
  falsification: v2.std.diagnostic.Diagnostic
}
data nested_body_leaf: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^nested_body_atom } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data nested_body: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: v2.std.node.Transform },
  children: [
    v2.std.node.Edge { label: v2.std.node.Positional, target: nested_body_leaf }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data nested_inner: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Cardinality },
  children: [
    v2.std.node.Edge { label: v2.std.node.Positional, target: nested_body }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data nested_input: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Cardinality },
  children: [
    v2.std.node.Edge { label: v2.std.node.Positional, target: nested_inner }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data nested_claim: LensComplexityClaim = LensComplexityClaim {
  input: nested_input,
  expected_cost: v2.lens.cost.ProductCost {
    lhs: v2.lens.cost.LinearCost { variable: v2.lens.cost.SizeVariable { source: nested_input } },
    rhs: v2.lens.cost.LinearCost { variable: v2.lens.cost.SizeVariable { source: nested_inner } }
  },
  expected_complexity: v2.lens.complexity.multidimensional_polynomial_complexity(
    variables: v2.lens.complexity.composite_complexity_variables(
      lhs: v2.lens.complexity.single_complexity_variable(size_var: v2.lens.cost.SizeVariable { source: nested_input }),
      rhs: v2.lens.complexity.single_complexity_variable(size_var: v2.lens.cost.SizeVariable { source: nested_inner })
    ),
    degree: v2.lens.cost.PolynomialDegree { predecessor_after_linear: v2.std.cardinality.NonZeroNat { prev: v2.std.nat.Zero } }
  ),
  falsification: v2.std.diagnostic.Diagnostic {
    reason: ^nested_claim_reason,
    at: v2.std.diagnostic.Textual { file: ^nested_claim_file, extent: v2.std.diagnostic.WholeFile },
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.AmbiguousIntent }
  }
}

fn nested_actual_cost() -> Witness<v2.lens.cost.SymbolicCost> {
  v2.lens.cost.cost_lens(n: nested_input)
}

fn nested_actual_complexity() -> v2.lens.complexity.ComplexityBound {
  v2.lens.complexity.complexity_lens(n: nested_input)
}

test fn nested_cost_projection_holds() -> Bool {
  match nested_actual_cost() {
    v2.std.witness.Holds { value: actual } => actual == nested_claim.expected_cost
    v2.std.witness.Violates { diagnostic: _ } => false
  }
}

test fn nested_complexity_projection_holds() -> Bool {
  nested_actual_complexity() == nested_claim.expected_complexity
}
