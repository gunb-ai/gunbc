module v2.test.lens_complexity.nested

import v2.lens.complexity {
  ComplexityBound,
  composite_complexity_variables,
  complexity_lens,
  multidimensional_polynomial_complexity,
  single_complexity_variable
}
import v2.lens.cost {
  LinearCost,
  PolynomialDegree,
  ProductCost,
  SizeVariable,
  SymbolicCost,
  cost_lens
}
import v2.std.cardinality { NonZeroNat }
import v2.std.diagnostic {
  AmbiguousIntent,
  Diagnostic,
  Textual,
  Unavailable,
  WholeFile
}
import v2.std.node {
  Atom,
  Cardinality,
  ComputationNode,
  Edge,
  Node,
  Positional,
  Symbol,
  Transform,
  TypeNode,
  SyntheticOccurrence
}
import v2.std.nat { Zero }
import v2.std.logic { Bool }
import v2.std.witness { Holds, Violates, Witness }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly
type LensComplexityClaim {
  input: Node
  expected_cost: SymbolicCost
  expected_complexity: ComplexityBound
  falsification: Diagnostic
}
data nested_body_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^nested_body_atom } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data nested_body: Node = Node {
  kind: ComputationNode { behavior: Transform },
  children: [
    Edge { label: Positional, target: nested_body_leaf }
  ],
  occurrence_id: SyntheticOccurrence
}

data nested_inner: Node = Node {
  kind: TypeNode { connective: Cardinality },
  children: [
    Edge { label: Positional, target: nested_body }
  ],
  occurrence_id: SyntheticOccurrence
}

data nested_input: Node = Node {
  kind: TypeNode { connective: Cardinality },
  children: [
    Edge { label: Positional, target: nested_inner }
  ],
  occurrence_id: SyntheticOccurrence
}

data nested_claim: LensComplexityClaim = LensComplexityClaim {
  input: nested_input,
  expected_cost: ProductCost {
    lhs: LinearCost { variable: SizeVariable { source: nested_input } },
    rhs: LinearCost { variable: SizeVariable { source: nested_inner } }
  },
  expected_complexity: multidimensional_polynomial_complexity(
    variables: composite_complexity_variables(
      lhs: single_complexity_variable(size_var: SizeVariable { source: nested_input }),
      rhs: single_complexity_variable(size_var: SizeVariable { source: nested_inner })
    ),
    degree: PolynomialDegree { predecessor_after_linear: NonZeroNat { prev: v2.std.nat.Zero } }
  ),
  falsification: Diagnostic {
    reason: ^nested_claim_reason,
    at: Textual { file: ^nested_claim_file, extent: WholeFile },
    correction: Unavailable { reason: AmbiguousIntent }
  }
}

fn nested_actual_cost() -> Witness<SymbolicCost> {
  cost_lens(n: nested_input)
}

fn nested_actual_complexity() -> Witness<ComplexityBound> {
  complexity_lens(n: nested_input)
}

test fn nested_cost_projection_holds() -> Bool {
  match nested_actual_cost() {
    Holds { value: actual } => actual == nested_claim.expected_cost
    Violates { diagnostic: _ } => false
  }
}

test fn nested_complexity_projection_holds() -> Bool {
  match nested_actual_complexity() {
    Holds { value: actual } => actual == nested_claim.expected_complexity
    Violates { diagnostic: _ } => false
  }
}
