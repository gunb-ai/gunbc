module v2.test.lens_complexity.nested


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly
type LensComplexityClaim {
  input: Node
  expected_cost: v2.lens.cost.SymbolicCost
  expected_complexity: v2.lens.complexity.ComplexityBound
  falsification: v2.std.diagnostic.Diagnostic
}
data nested_body_leaf: Node = v2.std.node.Node {
  kind: TypeNode { connective: Atom { identity: ^nested_body_atom } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data nested_body: Node = v2.std.node.Node {
  kind: ComputationNode { behavior: Transform },
  children: [
    v2.std.node.Edge { label: Positional, target: nested_body_leaf }
  ],
  occurrence_id: SyntheticOccurrence
}

data nested_inner: Node = v2.std.node.Node {
  kind: TypeNode { connective: Cardinality },
  children: [
    v2.std.node.Edge { label: Positional, target: nested_body }
  ],
  occurrence_id: SyntheticOccurrence
}

data nested_input: Node = v2.std.node.Node {
  kind: TypeNode { connective: Cardinality },
  children: [
    v2.std.node.Edge { label: Positional, target: nested_inner }
  ],
  occurrence_id: SyntheticOccurrence
}

data nested_claim: LensComplexityClaim = LensComplexityClaim {
  input: nested_input,
  expected_cost: ProductCost {
    lhs: LinearCost { variable: v2.lens.cost.SizeVariable { source: nested_input } },
    rhs: LinearCost { variable: v2.lens.cost.SizeVariable { source: nested_inner } }
  },
  expected_complexity: multidimensional_polynomial_complexity(
    variables: composite_complexity_variables(
      lhs: single_complexity_variable(size_var: v2.lens.cost.SizeVariable { source: nested_input }),
      rhs: single_complexity_variable(size_var: v2.lens.cost.SizeVariable { source: nested_inner })
    ),
    degree: v2.lens.cost.PolynomialDegree { predecessor_after_linear: v2.std.cardinality.NonZeroNat { prev: Zero } }
  ),
  falsification: v2.std.diagnostic.Diagnostic {
    reason: ^nested_claim_reason,
    at: Textual { file: ^nested_claim_file, extent: WholeFile },
    correction: Unavailable { reason: AmbiguousIntent }
  }
}

fn nested_actual_cost() -> Witness<v2.lens.cost.SymbolicCost> {
  cost_lens(n: nested_input)
}

fn nested_actual_complexity() -> v2.lens.complexity.ComplexityBound {
  complexity_lens(n: nested_input)
}

test fn nested_cost_projection_holds() -> Bool {
  match nested_actual_cost() {
    Holds { value: actual } => actual == nested_claim.expected_cost
    Violates { diagnostic: _ } => false
  }
}

test fn nested_complexity_projection_holds() -> Bool {
  nested_actual_complexity() == nested_claim.expected_complexity
}
