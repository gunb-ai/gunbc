module v2.test.lens_complexity.typescript_type_alias_task


type LensComplexityClaim {
  input: Node
  expected_cost: v2.lens.cost.SymbolicCost
  expected_complexity: v2.lens.complexity.ComplexityBound
  falsification: v2.std.diagnostic.Diagnostic
}

data ts_task_complexity_input: Node = v2.std.node.Node {
  kind: TypeNode { connective: Cardinality },
  children: [
    v2.std.node.Edge { label: Positional, target: ts_task_type_alias_emitted() }
  ],
  occurrence_id: SyntheticOccurrence
}

data ts_task_complexity_claim: LensComplexityClaim = LensComplexityClaim {
  input: ts_task_complexity_input,
  expected_cost: LinearCost { variable: v2.lens.cost.SizeVariable { source: ts_task_complexity_input } },
  expected_complexity: linear_complexity(
    size_var: v2.lens.cost.SizeVariable { source: ts_task_complexity_input }
  ),
  falsification: v2.std.diagnostic.Diagnostic {
    reason: ^ts_task_complexity_reason,
    at: Textual { file: ^ts_task_complexity_file, extent: WholeFile },
    correction: Unavailable { reason: AmbiguousIntent }
  }
}

fn ts_task_actual_cost() -> Witness<v2.lens.cost.SymbolicCost> {
  cost_lens(n: ts_task_complexity_input)
}

fn ts_task_actual_complexity() -> v2.lens.complexity.ComplexityBound {
  complexity_lens(n: ts_task_complexity_input)
}
