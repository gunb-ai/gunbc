module v2.test.lens_complexity.algebra_receipts

import v2.lens.complexity {
  ComplexityBound,
  complexity_bound_dominates,
  complexity_bound_from_cost,
  linear_complexity,
  multidimensional_polynomial_complexity,
  single_complexity_variable,
  composite_complexity_variables
}
import v2.lens.cost {
  PolynomialCost,
  PolynomialDegree,
  ProductCost,
  SizeVariable,
  SymbolicCost
}
import v2.std.cardinality { NonZeroNat }
import v2.std.diagnostic {
  AmbiguousIntent,
  Diagnostic,
  Textual,
  Unavailable,
  WholeFile
}
import v2.std.nat { Succ, Zero }
import v2.std.node {
  Atom,
  Node,
  Symbol,
  TypeNode,
  SyntheticOccurrence
}
type ComplexityProjectionClaim {
  input_cost: SymbolicCost
  expected_complexity: ComplexityBound
  falsification: Diagnostic
}

type ComplexityDominanceClaim {
  lhs: ComplexityBound
  rhs: ComplexityBound
  expected_dominates: Bool
  falsification: Diagnostic
}

data algebra_receipts_x: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^algebra_receipts_x_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data algebra_receipts_y: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^algebra_receipts_y_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data polynomial_degree_two_receipt: PolynomialDegree = PolynomialDegree {
  predecessor_after_linear: NonZeroNat { prev: Zero }
}

data polynomial_degree_four_receipt: PolynomialDegree = PolynomialDegree {
  predecessor_after_linear: NonZeroNat { prev: Succ { prev: Succ { prev: Zero } } }
}

data algebra_receipts_diagnostic: Diagnostic = Diagnostic {
  reason: ^algebra_receipts_reason,
  at: Textual { file: ^algebra_receipts_file, extent: WholeFile },
  correction: Unavailable { reason: AmbiguousIntent }
}

data polynomial_product_degree_claim: ComplexityProjectionClaim = ComplexityProjectionClaim {
  input_cost: ProductCost {
    lhs: PolynomialCost {
      variable: SizeVariable { source: algebra_receipts_x },
      degree: polynomial_degree_two_receipt
    },
    rhs: PolynomialCost {
      variable: SizeVariable { source: algebra_receipts_y },
      degree: polynomial_degree_two_receipt
    }
  },
  expected_complexity: multidimensional_polynomial_complexity(
    variables: composite_complexity_variables(
      lhs: single_complexity_variable(size_var: SizeVariable { source: algebra_receipts_x }),
      rhs: single_complexity_variable(size_var: SizeVariable { source: algebra_receipts_y })
    ),
    degree: polynomial_degree_four_receipt
  ),
  falsification: algebra_receipts_diagnostic
}

data variable_sensitive_dominance_claim: ComplexityDominanceClaim = ComplexityDominanceClaim {
  lhs: linear_complexity(size_var: SizeVariable { source: algebra_receipts_x }),
  rhs: linear_complexity(size_var: SizeVariable { source: algebra_receipts_y }),
  expected_dominates: false,
  falsification: algebra_receipts_diagnostic
}

fn polynomial_product_projected_complexity() -> ComplexityBound {
  complexity_bound_from_cost(cost: polynomial_product_degree_claim.input_cost)
}

fn variable_sensitive_dominance_actual() -> Bool {
  complexity_bound_dominates(
    a: variable_sensitive_dominance_claim.lhs,
    b: variable_sensitive_dominance_claim.rhs
  ) == variable_sensitive_dominance_claim.expected_dominates
}

test fn algebra_receipts_polynomial_product_projection_holds() -> Bool {
  polynomial_product_projected_complexity() == polynomial_product_degree_claim.expected_complexity
}

test fn algebra_receipts_variable_sensitive_dominance_holds() -> Bool {
  variable_sensitive_dominance_actual()
}
