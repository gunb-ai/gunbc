module v2.test.lens_complexity.map_id


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly
type LensComplexityClaim {
  input: Node
  expected_cost: SymbolicCost
  expected_complexity: ComplexityBound
  falsification: Diagnostic
}
data map_id_body_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^map_id_body_atom } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data map_id_body: Node = Node {
  kind: ComputationNode { behavior: Transform },
  children: [
    Edge { label: Positional, target: map_id_body_leaf }
  ],
  occurrence_id: SyntheticOccurrence
}

data map_id_input: Node = Node {
  kind: TypeNode { connective: Cardinality },
  children: [
    Edge { label: Positional, target: map_id_body }
  ],
  occurrence_id: SyntheticOccurrence
}

data map_id_claim: LensComplexityClaim = LensComplexityClaim {
  input: map_id_input,
  expected_cost: LinearCost { variable: SizeVariable { source: map_id_input } },
  expected_complexity: linear_complexity(size_var: SizeVariable { source: map_id_input }),
  falsification: Diagnostic {
    reason: ^map_id_claim_reason,
    at: Textual { file: ^map_id_claim_file, extent: WholeFile },
    correction: Unavailable { reason: AmbiguousIntent }
  }
}

fn map_id_actual_cost() -> Witness<SymbolicCost> {
  cost_lens(n: map_id_input)
}

fn map_id_actual_complexity() -> Witness<ComplexityBound> {
  complexity_lens(n: map_id_input)
}

test fn map_id_cost_projection_holds() -> Bool {
  match map_id_actual_cost() {
    Holds { value: actual } => actual == map_id_claim.expected_cost
    Violates { diagnostic: _ } => false
  }
}

test fn map_id_complexity_projection_holds() -> Bool {
  match map_id_actual_complexity() {
    Holds { value: actual } => actual == map_id_claim.expected_complexity
    Violates { diagnostic: _ } => false
  }
}
