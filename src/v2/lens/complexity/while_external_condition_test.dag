module v2.test.lens_complexity.while_external_condition


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

type LensComplexityClaim {
  input: Node
  expected_cost: v2.lens.cost.SymbolicCost
  expected_complexity: v2.lens.complexity.ComplexityBound
  falsification: v2.std.diagnostic.Diagnostic
}
data while_loop_body_leaf: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^while_loop_body_atom } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data while_external_condition_input: Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: Loop },
  children: [
    v2.std.node.Edge { label: Positional, target: while_loop_body_leaf }
  ],
  occurrence_id: SyntheticOccurrence
}

data while_external_condition_loop_bound_diagnostic: v2.std.diagnostic.Diagnostic = v2.std.diagnostic.Diagnostic {
  reason: ^cardinality_loop_bound_undeclared,
  at: node_locus(node: while_external_condition_input),
  correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
}

data while_external_condition_claim: LensComplexityClaim = LensComplexityClaim {
  input: while_external_condition_input,
  expected_cost: v2.lens.cost.UnknownCost {
    diagnostic: while_external_condition_loop_bound_diagnostic
  },
  expected_complexity: unknown_complexity_with_diagnostic(
    diagnostic: while_external_condition_loop_bound_diagnostic
  ),
  falsification: while_external_condition_loop_bound_diagnostic
}

fn while_external_condition_actual_cost() -> Witness<v2.lens.cost.SymbolicCost> {
  cost_lens(n: while_external_condition_input)
}

fn while_external_condition_actual_complexity() -> v2.lens.complexity.ComplexityBound {
  complexity_lens(n: while_external_condition_input)
}

test fn while_external_condition_cost_fails_closed_holds() -> Bool {
  match while_external_condition_actual_cost() {
    Holds { value: _ } => false
    Violates { diagnostic: _ } => true
  }
}

test fn while_external_condition_complexity_fails_closed_holds() -> Bool {
  match while_external_condition_actual_complexity() {
    UnknownComplexity { diagnostic: _ } => true
    ConstantComplexity => false
    SizedComplexity { class: _, variables: _ } => false
  }
}
