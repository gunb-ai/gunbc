module v2.test.lens_complexity.while_external_condition


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

type LensComplexityClaim {
  input: Node
  expected_cost: SymbolicCost
  expected_complexity: ComplexityBound
  falsification: Diagnostic
}
data while_loop_body_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^while_loop_body_atom } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data while_external_condition_input: Node = Node {
  kind: ComputationNode { behavior: Loop },
  children: [
    Edge { label: Positional, target: while_loop_body_leaf }
  ],
  occurrence_id: SyntheticOccurrence
}

data while_external_condition_loop_bound_diagnostic: Diagnostic = Diagnostic {
  reason: ^cardinality_loop_bound_undeclared,
  at: node_locus(node: while_external_condition_input),
  correction: Unavailable { reason: ExternalContractUnknown }
}

data while_external_condition_claim: LensComplexityClaim = LensComplexityClaim {
  input: while_external_condition_input,
  expected_cost: UnknownCost {
    diagnostic: while_external_condition_loop_bound_diagnostic
  },
  expected_complexity: unknown_complexity_with_diagnostic(
    diagnostic: while_external_condition_loop_bound_diagnostic
  ),
  falsification: while_external_condition_loop_bound_diagnostic
}

fn while_external_condition_actual_cost() -> Witness<SymbolicCost> {
  cost_lens(n: while_external_condition_input)
}

fn while_external_condition_actual_complexity() -> Witness<ComplexityBound> {
  complexity_lens(n: while_external_condition_input)
}

test fn while_external_condition_cost_fails_closed_holds() -> Bool {
  match while_external_condition_actual_cost() {
    Holds { value: _ } => false
    Violates { diagnostic: _ } => true
  }
}

test fn while_external_condition_complexity_fails_closed_holds() -> Bool {
  match while_external_condition_actual_complexity() {
    Holds { value: _ } => false
    Violates { diagnostic: _ } => true
  }
}
