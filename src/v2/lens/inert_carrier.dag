module v2.lens.inert_carrier

import std.roster_frontier { FrontierRow, frontier_row_path, frontier_path_subjects, TriggerProse }

data inert_carrier_local_alias_roster_note: String = "Floor hygiene: roster LocalAlias for inert G1 fixture type in qualified_module_projection_stripped_fixture.dag (latent main gap; exposed by W1.2 broad affected set; not W3.1 reachability migration)."

data inert_carrier_row_dissolve: String = "a live consumer reads the carrier; the stale-roster check then forces this row's deletion"

fn inert_row(path: String, reason: String) -> FrontierRow {
  frontier_row_path(
    path: path,
    reason: reason,
    trigger: TriggerProse { text: inert_carrier_row_dissolve },
  )
}

data inert_carrier_roster: List<FrontierRow> = [
  inert_row(path: "AccessPolicy", reason: "modeled access-policy carrier with no live consumer yet (facts-before-abstraction: the data row lands ahead of its reader)"),
  inert_row(path: "CargoDependency", reason: "modeled cargo-manifest carrier awaiting the emitted-crate-partition consumer"),
  inert_row(path: "CargoPackage", reason: "modeled cargo-manifest carrier awaiting the emitted-crate-partition consumer"),
  inert_row(path: "FilePermissions", reason: "modeled filesystem-semantics carrier with no live consumer yet"),
  inert_row(path: "FloorWitnessRow", reason: "modeled floor-receipt carrier with no live consumer yet"),
  inert_row(path: "FreeOutput", reason: "modeled output carrier with no live consumer yet"),
  inert_row(path: "GcpProject", reason: "modeled gcp extdeps carrier with no live consumer yet"),
  inert_row(path: "GitCliReportedVersion", reason: "modeled git-cli extdeps carrier with no live consumer yet"),
  inert_row(path: "LocalAlias", reason: "inert G1 fixture type in qualified_module_projection_stripped_fixture.dag (see inert_carrier_local_alias_roster_note)"),
  inert_row(path: "ProcMeminfo", reason: "modeled machine-facts carrier with no live consumer yet"),
  inert_row(path: "ReactHookSite", reason: "modeled typescript extdeps carrier with no live consumer yet"),
  inert_row(path: "SystemdUnitStatus", reason: "modeled systemd extdeps carrier with no live consumer yet"),
  inert_row(path: "FrontierSubject", reason: "roster_frontier subject coproduct declared ahead of its non-test consumer"),
  inert_row(path: "DissolveTrigger", reason: "roster_frontier trigger coproduct declared ahead of its non-test consumer"),
  inert_row(path: "FrontierExpiryReport", reason: "roster_frontier expiry fold report declared ahead of its non-test consumer"),
]

fn inert_carrier_rostered_names() -> List<String> {
  frontier_path_subjects(rows: inert_carrier_roster)
}

data empty_inert_carrier_names: List<String> = []

fn list_contains_str(xs: List<String>, target: String) -> Bool {
  fold_list(
    xs: xs,
    empty: false,
    cons: fn(acc, s) { acc || (s == target) }
  )
}

fn count_not_in_roster(names: List<String>, roster: List<String>) -> Int {
  fold_list(
    xs: names,
    empty: 0,
    cons: fn(count, name) {
      if list_contains_str(xs: roster, target: name) { count } else { count + 1 }
    }
  )
}

fn count_stale_roster(roster: List<String>, inert_names: List<String>) -> Int {
  fold_list(
    xs: roster,
    empty: 0,
    cons: fn(count, entry) {
      if list_contains_str(xs: inert_names, target: entry) { count } else { count + 1 }
    }
  )
}

fn inert_carrier_clean_holds() -> Bool {
  let names = inert_carrier_names_live()
  count_not_in_roster(names: names, roster: inert_carrier_rostered_names()) == 0
    && count_stale_roster(roster: inert_carrier_rostered_names(), inert_names: names) == 0
}

fn inert_carrier_live_count() -> Int {
  length(xs: inert_carrier_names_live())
}

fn inert_carrier_live_unrostered_count() -> Int {
  count_not_in_roster(names: inert_carrier_names_live(), roster: inert_carrier_rostered_names())
}

fn inert_carrier_live_stale_roster_count() -> Int {
  count_stale_roster(roster: inert_carrier_rostered_names(), inert_names: inert_carrier_names_live())
}

fn inert_carrier_live_declared_count() -> Int {
  inert_carrier_declared_count()
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: RealizationDispatch }
}
