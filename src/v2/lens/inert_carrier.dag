module v2.lens.inert_carrier

import std.roster_frontier { FrontierRow, frontier_row_path, frontier_units }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import std.disposition { RealizationDispatch }
import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }
import v2.std.collection { fold_list }

data inert_carrier_local_alias_roster_note: String = "Floor hygiene: roster LocalAlias for inert G1 fixture type in qualified_module_projection_stripped_fixture.dag (latent main gap; exposed by W1.2 broad affected set; not W3.1 reachability migration)."

data inert_carrier_row_dissolve: DissolutionCondition = unbound_dissolution(description: "a live consumer reads the carrier; the stale-roster check then forces this row's deletion")

fn inert_row(unit: String, reason: String) -> FrontierRow {
  frontier_row_path(path: unit, reason: reason, dissolution: inert_carrier_row_dissolve)
}

// SCOPE, stated on the carrier rather than only in the plan that specified it: this
// roster holds carriers that are DECLARED + REFERENCED BY A TEST + read by no
// production code. A carrier referenced by nothing at all -- no consumer and no test
// -- is invisible here BY CONSTRUCTION (the self_tested gate in the host producer,
// cli_run.rs compute_inert_carrier_data), and that is intended, not a hole in the
// lens. The reason is the remedy, not the size of the set: an inert row says "modeled
// ahead of its consumer, tested, awaiting one" and dissolves when a consumer lands;
// the unreferenced class dissolves the other way -- delete the carrier, or write the
// missing test and let it land here -- so folding it in would file hundreds of rows
// each asserting a test that does not exist. It is owned by the still-unbuilt
// run-root reachability cut named in gunbc.plans.inert_layer_lens (v2.lens.inert_layer),
// whose retirement condition already carries it; this lens is not its next rung and
// must not be read as covering it.
//
// Measured over the witness layer roots (dag, src/v2) at 32597358f16 on 2026-08-24:
// 8821 declared carriers, 14 flagged here (this roster's exact 14), 270 skipped by
// that gate -- the same order the plan predicted for a raw sweep. A dated observation, not a
// bound -- nothing gates on either number, and the exclusion itself is pinned by an
// executing control in the host producer's unit tests
// (green_control_untested_unused_carrier_is_not_flagged, which plants exactly such a
// carrier and asserts it stays off this roster; executed both ways 2026-08-24 --
// gate present, 12 passed; gate deleted, that control alone fails), not by the count.
data inert_carrier_roster: List<FrontierRow> = [
  inert_row(unit: "DownstreamSupportRoster", reason: "modeled downstream coverage-roster carrier from the extdeps modeling preflight (#7571): it is the declared home for support/coverage rows that an upstream module may not carry, and the plan text names it, but no module constructs or reads one yet"),
  inert_row(unit: "Attempt", reason: "modeled compute-fabric execution carrier from the terminal-contract slice (#8413): one execution attempt with its lineage, declared ahead of the executor that issues attempts against a grant, and referenced only by fabric_terminal_contract_witness_test so far"),
  inert_row(unit: "CargoDependency", reason: "modeled cargo-manifest carrier awaiting the emitted-crate-partition consumer"),
  inert_row(unit: "CargoPackage", reason: "modeled cargo-manifest carrier awaiting the emitted-crate-partition consumer"),
  inert_row(unit: "FreeOutput", reason: "modeled output carrier with no live consumer yet"),
  inert_row(unit: "GcpProject", reason: "modeled gcp extdeps carrier with no live consumer yet"),
  inert_row(unit: "GitCliReportedVersion", reason: "modeled git-cli extdeps carrier with no live consumer yet"),
  inert_row(unit: "GitPushRequest", reason: "modeled git publication-transport carrier (extdeps.git.publication_transport slice 1): witness-tested in publication_publisher_witness_test with no non-test consumer yet; live transport binding awaits tools.publication_publisher slice"),
  inert_row(unit: "LocalAlias", reason: "inert G1 fixture type in qualified_module_projection_stripped_fixture.dag (see inert_carrier_local_alias_roster_note)"),
  inert_row(unit: "OwnedDataDiscoveryReceipt", reason: "modeled discovery-receipt carrier in v2.compiler.discovery_enumeration whose only non-test consumer was a COMMITTED COPY of an ephemeral artifact: v1_compiler.cli_run discover_owned_data_decls generates a manifest module constructing this receipt and stamps it DO NOT COMMIT, and a stale committed instance of it under a second module path (v2.test.workflow.host_discovered_owned_data_manifest, all-zero counts) was the only thing reading the carrier in the corpus. That copy was deleted by the unconsumed-module residue disposition, so the carrier is now inert BY CONSTRUCTION in the committed tree -- its real consumer is generated at runtime and deliberately never committed, which no corpus scan can see"),
  inert_row(unit: "ReactHookSite", reason: "modeled typescript extdeps carrier with no live consumer yet"),
  inert_row(unit: "SharedBuildProvenance", reason: "modeled floor-preparation provenance carrier in v2.workflow.required_floor (#9046): it records whether a shared build was BUILT BY preparation or found already warm and, in that arm, WHICH site got there first -- the triggered_by/owned_by distinction the attribution repair exists to keep structural. It is declared ahead of its reader: the host mirror (v1_compiler.cli_run SharedBuildProvenance) is what the running floor renders today, so the corpus carries the model with only floor_preparation_shared_build_witness_test referencing it. Its reader is the .dag-side preparation report that supersedes that hand-written host mirror, which floor_preparation_host_mirror_dissolve_on in that same module already tracks"),
  inert_row(unit: "SystemdUnitStatus", reason: "modeled systemd extdeps carrier with no live consumer yet"),
  inert_row(unit: "TerminatingOneShotFrontier", reason: "modeled std.witness_purpose frontier coproduct from #7965 (Slice C-a): its variants name the two substrate absences that block a terminating one-shot classification, and only its own test file references it, so it is inert by the seed rule until the classifier consumes it"),
  inert_row(unit: "WitnessPurpose", reason: "modeled std.witness_purpose taxonomy from #7965 (Slice C-a): the stable purpose coproduct a witness declares, landed ahead of the consumer that derives witness size from it, with no non-test reference yet")
]

fn inert_carrier_rostered_names() -> List<String> {
  frontier_units(rows: inert_carrier_roster)
}

data empty_inert_carrier_names: List<String> = []

fn list_contains_str(xs: List<String>, target: String) -> Bool {
  fold_list(
    xs: xs,
    empty: false,
    cons: fn(acc, s) { acc || (s == target) }
  )
}

fn count_not_in_roster(names: List<String>, roster: List<String>) -> Int {
  fold_list(
    xs: names,
    empty: 0,
    cons: fn(count, name) {
      if list_contains_str(xs: roster, target: name) { count } else { count + 1 }
    }
  )
}

fn count_stale_roster(roster: List<String>, inert_names: List<String>) -> Int {
  fold_list(
    xs: roster,
    empty: 0,
    cons: fn(count, entry) {
      if list_contains_str(xs: inert_names, target: entry) { count } else { count + 1 }
    }
  )
}

fn inert_carrier_clean_holds() -> Bool {
  let names = inert_carrier_names_live()
  count_not_in_roster(names: names, roster: inert_carrier_rostered_names()) == 0
    && count_stale_roster(roster: inert_carrier_rostered_names(), inert_names: names) == 0
}

fn inert_carrier_live_count() -> Int {
  length(xs: inert_carrier_names_live())
}

fn inert_carrier_live_unrostered_count() -> Int {
  count_not_in_roster(names: inert_carrier_names_live(), roster: inert_carrier_rostered_names())
}

fn inert_carrier_live_stale_roster_count() -> Int {
  count_stale_roster(roster: inert_carrier_rostered_names(), inert_names: inert_carrier_names_live())
}

fn inert_carrier_live_declared_count() -> Int {
  inert_carrier_declared_count()
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: RealizationDispatch }
}
