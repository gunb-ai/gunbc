module v2.lens.grounding_ledger

import v2.lens.common.construction_justification {
  ConstructionJustification,
  OutsideModeledGuarantee,
  PolicyJudgmentRequired,
  modeled_outside_boundary,
  grounding_modeled_capability_inventory_ref
}
import std.decl_ref { DeclarationRef, WholeDeclaration }

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: OutsideModeledGuarantee {
    boundary: modeled_outside_boundary(
      subject: DeclarationRef {
        module_path: "v2.lens.grounding_ledger",
        decl_name: "LedgerEntry",
        field: WholeDeclaration
      },
      required_capability: DeclarationRef {
        module_path: "v2.lens.grounding_ledger",
        decl_name: "GroundingVerdict",
        field: WholeDeclaration
      },
      capability_inventory_authority: grounding_modeled_capability_inventory_ref,
      boundary_kind: PolicyJudgmentRequired {
        judgment: DeclarationRef {
          module_path: "v2.lens.grounding_ledger",
          decl_name: "GroundingVerdict",
          field: WholeDeclaration
        }
      }
    )
  }
}

type ResidueReason
  = DecodeReturnedNone
  | UnrecognizedSiblingArm

type GroundingVerdict
  = Reference { authority: DeclarationRef }
  | ReferenceUri
  | ReferencePath
  | Role
  | StayString { reason: ResidueReason }
  | GenuineProse
  | PendingJudge

type DecidedBy
  = StructuralRule
  | Judge { rationale: String }
  | OperatorReview { note: String }

type LedgerEntry {
  site_qn: String
  field: String
  coincides_with: String
  verdict: GroundingVerdict
  decided_by: DecidedBy
}

fn residue_forced_verdict(sibling_decode_optional: Bool, has_unrecognized_sibling: Bool) -> GroundingVerdict {
  if sibling_decode_optional {
    StayString { reason: DecodeReturnedNone }
  } else if has_unrecognized_sibling {
    StayString { reason: UnrecognizedSiblingArm }
  } else {
    PendingJudge
  }
}

fn structural_ledger_entry(
  site_qn: String,
  field: String,
  coincides_with: String,
  sibling_decode_optional: Bool,
  has_unrecognized_sibling: Bool
) -> LedgerEntry {
  LedgerEntry {
    site_qn: site_qn,
    field: field,
    coincides_with: coincides_with,
    verdict: residue_forced_verdict(
      sibling_decode_optional: sibling_decode_optional,
      has_unrecognized_sibling: has_unrecognized_sibling
    ),
    decided_by: StructuralRule
  }
}
