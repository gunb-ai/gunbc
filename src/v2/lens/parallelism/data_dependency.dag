module v2.test.lens_parallelism.data_dependency

import v2.compiler.infer { InferredFacts, InferredTree }
import v2.compiler.eval {
  TestClaimEvalSubject,
  TestClaimRun,
  eval_test_claim_subject,
  run_test_claim_assert,
  run_test_claim
}
import v2.lens.parallelism {
  DataDependent,
  ParallelismFact,
  parallelism_fact_eq,
  parallelism_witness
}
import v2.std.diagnostic { Accepted, None }
import v2.std.dependency {
  ClassifiedDependencyView,
  DataDependsOn,
  DependencyView
}
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.node { Atom, Edge, Named, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.runtime { RuntimeValue }
import v2.std.verification {
  ManualAnchorAbsent,
  TestClassification,
  TestClaim,
  Tier1,
  Integration,
  EqualsClaim,
  manual_claim_anchor
}
import v2.std.verdict { Verdict }
import v2.std.witness { Holds, Witness }
import v2.test.lens_common.infer_fixture {
  claim_atom_node,
  claim_inferred_facts,
  claim_inferred_tree
}
import v2.test.manual.eval_runtime {
  eval_add_subgraph,
  eval_context,
  eval_inferred_tree
}

data parallelism_child: Node = claim_atom_node(s: ^parallelism_child_symbol)

data parallelism_root: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^parallelism_root_symbol } },
  children: [
    Edge { label: Named { name: ^parallelism_edge_symbol }, target: parallelism_child }
  ],
  occurrence_id: SyntheticOccurrence
}

data parallelism_dependency: DependencyView = DependencyView {
  source: parallelism_root,
  dependent: parallelism_child,
  kind: DataDependsOn,
  usage_site: parallelism_child
}

fn parallelism_claim_facts() -> InferredFacts {
  claim_inferred_facts(
    type_symbol: ^parallelism_type_symbol,
    algebra_symbol: ^parallelism_algebra_symbol,
    descent_symbol: ^parallelism_descent_symbol,
  )
}

fn parallelism_claim_tree() -> InferredTree {
  claim_inferred_tree(root: parallelism_root, facts: parallelism_claim_facts())
}

type LensParallelismClaim {
  input: InferredTree
  expected: ParallelismFact
  actual: Witness<ParallelismFact>
}

type LensParallelismSubjectRosterContract {
  run: TestClaimRun<Node, RuntimeValue>
  unsupported_rows: List<Symbol>
}

data parallelism_data_dependency_claim: LensParallelismClaim = LensParallelismClaim {
  input: parallelism_claim_tree(),
  expected: ParallelismFact {
    dependencies: [
      ClassifiedDependencyView {
        dependency: parallelism_dependency,
        classification: DataDependent
      }
    ]
  },
  actual: parallelism_witness(tree: parallelism_claim_tree(), dependencies: [parallelism_dependency])
}

fn parallelism_data_dependency_claim_holds() -> Bool {
  match parallelism_data_dependency_claim.actual {
    Holds { value: actual } =>
      parallelism_fact_eq(a: actual, b: parallelism_data_dependency_claim.expected)
    _ => false
  }
}

data parallelism_data_dependency_claim_passes: Bool = parallelism_data_dependency_claim_holds()

fn parallelism_claim_pass_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^parallelism_claim_pass_symbol } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn parallelism_claim_fail_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^parallelism_claim_fail_symbol } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn parallelism_claim_input(ok: Bool) -> Node {
  if ok {
    parallelism_claim_pass_node()
  } else {
    parallelism_claim_fail_node()
  }
}

data claim_parallelism_data_dependency_receipt: TestClaim = EqualsClaim {
  label: "lens_parallelism data dependency witness classifies DataDependsOn as DataDependent",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: parallelism_claim_input(ok: parallelism_data_dependency_claim_passes),
  rhs: parallelism_claim_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Integration }
}

data verdict_parallelism_data_dependency_node_assert: Verdict<TestClaimEvalSubject<Node>, Node> = run_test_claim_assert(
  claim: claim_parallelism_data_dependency_receipt,
  actual: Accepted {
    value: parallelism_claim_input(ok: parallelism_data_dependency_claim_passes),
    diagnostics: None
  },
  at: parallelism_claim_pass_node()
)

fn parallelism_executable_claim_input(ok: Bool) -> Node {
  if ok {
    eval_add_subgraph()
  } else {
    parallelism_claim_fail_node()
  }
}

data claim_parallelism_data_dependency_run_test_claim_receipt: TestClaim = EqualsClaim {
  label: "lens_parallelism data dependency witness gates run_test_claim executable receipt",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: parallelism_executable_claim_input(ok: parallelism_data_dependency_claim_passes),
  rhs: eval_add_subgraph(),
  classification: TestClassification { tier: Tier1, layer: Integration }
}

data subject_parallelism_data_dependency_receipt: TestClaimEvalSubject<Node> = eval_test_claim_subject(
  claim: claim_parallelism_data_dependency_run_test_claim_receipt,
  context: eval_context(),
  tree: eval_inferred_tree(),
  evaluator_pin: ^eval_evaluator_pin
)

data run_parallelism_data_dependency_receipt: TestClaimRun<Node, RuntimeValue> = run_test_claim(
  subject: subject_parallelism_data_dependency_receipt
)

data lens_parallelism_unsupported_subject_rows: List<Symbol> = []

data lens_parallelism_data_dependency_subject_roster_contract: LensParallelismSubjectRosterContract = LensParallelismSubjectRosterContract {
  run: run_parallelism_data_dependency_receipt,
  unsupported_rows: lens_parallelism_unsupported_subject_rows
}
