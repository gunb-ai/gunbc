module v2.lens.languages_consumer_census
import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }
import std.disposition { SingleAuthority }

import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }

data languages_consumer_census_data_decl_baseline: Int = 71
data languages_consumer_census_per_language_row_baseline: Int = 64
data languages_consumer_census_format_row_baseline: Int = 7

fn languages_consumer_census_ratchet_holds(live_count: Int, baseline: Int) -> Bool {
  live_count <= baseline
}

fn languages_consumer_census_live_data_decl_count() -> Int {
  languages_consumer_census_data_decl_count()
}

fn languages_consumer_census_live_per_language_row_count() -> Int {
  languages_consumer_census_per_language_row_count()
}

fn languages_consumer_census_live_format_row_count() -> Int {
  languages_consumer_census_format_row_count()
}

fn languages_consumer_census_live_external_consumer_count(decl_name: String) -> Int {
  languages_consumer_census_external_consumer_count(decl_name: decl_name)
}

fn languages_consumer_census_live_is_composition_only(decl_name: String) -> Bool {
  languages_consumer_census_is_composition_only(decl_name: decl_name)
}

fn languages_consumer_census_live_has_external_consumer(decl_name: String) -> Bool {
  languages_consumer_census_has_external_consumer(decl_name: decl_name)
}

fn languages_consumer_census_live_data_decl_ratchet_holds() -> Bool {
  languages_consumer_census_ratchet_holds(
    live_count: languages_consumer_census_live_data_decl_count(),
    baseline: languages_consumer_census_data_decl_baseline
  )
}

fn languages_consumer_census_live_per_language_row_ratchet_holds() -> Bool {
  languages_consumer_census_ratchet_holds(
    live_count: languages_consumer_census_live_per_language_row_count(),
    baseline: languages_consumer_census_per_language_row_baseline
  )
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SingleAuthority },
  rationale: "A per-decl consumer census (composition-only vs external-consumer) is a decidable reference scan; a migration gate that dissolves when languages.dag's duplicate rows are deleted. Grounding authority: LanguageSpec repointing to extdeps/languages/* (the per-language duplicate rows delete) plus Node-tree decl-reference projection Dissolves on: the ~64 duplicate per-language rows are deleted once their consumers repoint, dissolving the census"
}
