// src/v2/lens/languages_consumer_census.dag
// Scope: per-decl consumer census for dsl/std/languages.dag -- gate before
//   deleting the ~64 per-language duplicate rows (71 data decls - 7 format rows).
// DESIGN.md section 3 single-authority enforcement:
//   - COMPOSITION_ONLY: decl referenced only inside languages.dag (spec field
//     wiring) -- dissolution-safe once LanguageSpec repoints to extdeps/languages/*.
//   - EXTERNAL_CONSUMER: any other .dag/.rs file references the decl name --
//     must be repointed before the row is deleted.
// Status: M1 -- host census bridge + corpus witnesses.
// Hand-Rust scaffold receipt (DESIGN.md section 7): languages_consumer_census.rs is
//   bootstrap text-scan census only.
// Dissolve-on (owner: v2.lens.languages_consumer_census): delete languages_consumer_census.rs
//   when Node-tree decl projection + import-graph resolution replace the text scan here.
//   Concrete gate: languages.dag ~64-row delete PR after rust_spec/go_spec/python_spec repoints.
// Consumer: claim_batch discovery over src/v2/compiler/languages_consumer_census.

module v2.lens.languages_consumer_census
import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }

import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }

data languages_consumer_census_data_decl_baseline: Int = 71
data languages_consumer_census_per_language_row_baseline: Int = 64
data languages_consumer_census_format_row_baseline: Int = 7

fn languages_consumer_census_ratchet_holds(live_count: Int, baseline: Int) -> Bool {
  live_count <= baseline
}

fn languages_consumer_census_live_data_decl_count() -> Int {
  languages_consumer_census_data_decl_count()
}

fn languages_consumer_census_live_per_language_row_count() -> Int {
  languages_consumer_census_per_language_row_count()
}

fn languages_consumer_census_live_format_row_count() -> Int {
  languages_consumer_census_format_row_count()
}

fn languages_consumer_census_live_external_consumer_count(decl_name: String) -> Int {
  languages_consumer_census_external_consumer_count(decl_name: decl_name)
}

fn languages_consumer_census_live_is_composition_only(decl_name: String) -> Bool {
  languages_consumer_census_is_composition_only(decl_name: decl_name)
}

fn languages_consumer_census_live_has_external_consumer(decl_name: String) -> Bool {
  languages_consumer_census_has_external_consumer(decl_name: decl_name)
}

fn languages_consumer_census_live_data_decl_ratchet_holds() -> Bool {
  languages_consumer_census_ratchet_holds(
    live_count: languages_consumer_census_live_data_decl_count(),
    baseline: languages_consumer_census_data_decl_baseline
  )
}

fn languages_consumer_census_live_per_language_row_ratchet_holds() -> Bool {
  languages_consumer_census_ratchet_holds(
    live_count: languages_consumer_census_live_per_language_row_count(),
    baseline: languages_consumer_census_per_language_row_baseline
  )
}

// Construction-justification (DESIGN sec 5/sec 6, ROADMAP sec 0): why this is a lens
// (validation) and not construction. Layered ON TOP of the #5433 inert-lens backstop.
data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding {
    grounding_authority: "LanguageSpec repointing to extdeps/languages/* (the per-language duplicate rows delete) plus Node-tree decl-reference projection",
    dissolve_on: "the ~64 duplicate per-language rows are deleted once their consumers repoint, dissolving the census"
  },
  rationale: "A per-decl consumer census (composition-only vs external-consumer) is a decidable reference scan; a migration gate that dissolves when languages.dag's duplicate rows are deleted."
}
