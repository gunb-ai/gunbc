module v2.test.lens_structural_resolution.facts_lookup_miss
import v2.std.collection { Map, optional_absent, optional_present }
import v2.std.optional { Optional, Absent, Present }


data sr_lookup_claim_hash: Hash = sr_lookup_claim_hash

fn sr_lookup_claim_atom(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

data sr_lookup_use: Node = sr_lookup_claim_atom(s: ^sr_lookup_use_symbol)

data sr_lookup_decl: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge { label: Named { name: ^dependency_binds_to_edge }, target: sr_lookup_use }
  ],
  occurrence_id: SyntheticOccurrence
}

data sr_lookup_dependency: DependencyView = DependencyView {
  source: sr_lookup_decl,
  dependent: sr_lookup_use,
  kind: BindsTo,
  usage_site: sr_lookup_use
}

fn sr_lookup_resolved_facts() -> InferredFacts {
  claim_inferred_facts(
    type_symbol: ^sr_lookup_type_symbol,
    algebra_symbol: ^sr_lookup_algebra_symbol,
    descent_symbol: ^sr_lookup_descent_symbol,
  )
}

fn sr_lookup_usage_site_witness() -> Optional<InferredFacts> {
  optional_absent()
}

fn sr_lookup_claim_fact_map() -> Map<Node, InferredFacts> {
  let resolved = sr_lookup_resolved_facts()
  Map {
    lookup: fn(key) {
      if key == sr_lookup_use {
        optional_absent()
      } else {
        optional_present(value: resolved)
      }
    }
  }
}

fn sr_lookup_claim_tree() -> InferredTree {
  InferredTree {
    root: sr_lookup_decl,
    facts: sr_lookup_claim_fact_map()
  }
}

data facts_lookup_miss_claim: LensStructuralResolutionClaim = LensStructuralResolutionClaim {
  input: sr_lookup_claim_tree(),
  expected: StructuralResolutionFact {
    dependencies: [
      ClassifiedDependencyView {
        dependency: sr_lookup_dependency,
        classification: FactsLookupMiss
      }
    ]
  }
}

fn facts_lookup_miss_claim_holds() -> Bool {
  match lens_structural_resolution_actual(claim: facts_lookup_miss_claim) {
    Holds { value: actual } =>
      fact_eq(a: actual, b: facts_lookup_miss_claim.expected)
        && fact_single_dependency_projects_status(fact: actual, expected: FactsLookupMiss)
    _ => false
  }
}

data facts_lookup_miss_claim_passes: Bool = facts_lookup_miss_claim_holds()
