module v2.test.lens_structural_resolution.unresolved_infer_witness
import v2.std.optional { Optional, Absent, Present }


data sr_infer_claim_hash: Hash = sr_infer_claim_hash

fn sr_infer_claim_atom(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

data sr_infer_use: Node = sr_infer_claim_atom(s: ^sr_infer_use_symbol)

data sr_infer_decl: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge { label: Named { name: ^dependency_binds_to_edge }, target: sr_infer_use }
  ],
  occurrence_id: SyntheticOccurrence
}

data sr_infer_dependency: DependencyView = DependencyView {
  source: sr_infer_decl,
  dependent: sr_infer_use,
  kind: BindsTo,
  usage_site: sr_infer_use
}

fn sr_infer_resolved_facts() -> InferredFacts {
  claim_inferred_facts(
    type_symbol: ^sr_infer_type_symbol,
    algebra_symbol: ^sr_infer_algebra_symbol,
    descent_symbol: ^sr_infer_descent_symbol,
  )
}

fn sr_infer_usage_site_witness() -> Optional<InferredFacts> {
  optional_absent()
}

fn sr_infer_claim_fact_map() -> Map<Node, InferredFacts> {
  let resolved = sr_infer_resolved_facts()
  Map {
    lookup: fn(key) {
      if key == sr_infer_use {
        Absent
      } else {
        Present { value: resolved }
      }
    }
  }
}

fn sr_infer_claim_tree() -> InferredTree {
  InferredTree {
    root: sr_infer_decl,
    facts: sr_infer_claim_fact_map()
  }
}

data unresolved_infer_witness_claim: LensStructuralResolutionClaim = LensStructuralResolutionClaim {
  input: sr_infer_claim_tree(),
  expected: StructuralResolutionFact {
    dependencies: [
      ClassifiedDependencyView {
        dependency: sr_infer_dependency,
        classification: UnresolvedInferWitness
      }
    ]
  }
}

fn unresolved_infer_witness_claim_holds() -> Bool {
  match lens_structural_resolution_actual(claim: unresolved_infer_witness_claim) {
    Holds { value: actual } =>
      fact_eq(a: actual, b: unresolved_infer_witness_claim.expected)
        && fact_single_dependency_projects_status(fact: actual, expected: UnresolvedInferWitness)
    _ => false
  }
}

data unresolved_infer_witness_claim_passes: Bool = unresolved_infer_witness_claim_holds()
