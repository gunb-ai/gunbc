module v2.test.lens_structural_resolution.unresolved_infer_witness


data sr_infer_claim_hash: v2.std.node.Hash = sr_infer_claim_hash

fn sr_infer_claim_atom(s: v2.std.node.Symbol) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

data sr_infer_use: Node = sr_infer_claim_atom(s: ^sr_infer_use_symbol)

data sr_infer_decl: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [
    v2.std.node.Edge { label: Named { name: ^dependency_binds_to_edge }, target: sr_infer_use }
  ],
  occurrence_id: SyntheticOccurrence
}

data sr_infer_dependency: v2.std.dependency.DependencyView = v2.std.dependency.DependencyView {
  source: sr_infer_decl,
  dependent: sr_infer_use,
  kind: BindsTo,
  usage_site: sr_infer_use
}

fn sr_infer_resolved_facts() -> v2.compiler.inferred_tree.InferredFacts {
  claim_inferred_facts(
    type_symbol: ^sr_infer_type_symbol,
    algebra_symbol: ^sr_infer_algebra_symbol,
    descent_symbol: ^sr_infer_descent_symbol,
  )
}

fn sr_infer_usage_site_witness() -> Optional<v2.compiler.inferred_tree.InferredFacts> {
  optional_absent()
}

fn sr_infer_claim_fact_map() -> Map<Node, v2.compiler.inferred_tree.InferredFacts> {
  let resolved = sr_infer_resolved_facts()
  std.types.Map {
    lookup: fn(key) {
      if key == sr_infer_use {
        optional_absent()
      } else {
        optional_present(value: resolved)
      }
    }
  }
}

fn sr_infer_claim_tree() -> v2.compiler.inferred_tree.InferredTree {
  v2.compiler.inferred_tree.InferredTree {
    root: sr_infer_decl,
    facts: sr_infer_claim_fact_map()
  }
}

data unresolved_infer_witness_claim: v2.test.lens_structural_resolution.claim_carrier.LensStructuralResolutionClaim = v2.test.lens_structural_resolution.claim_carrier.LensStructuralResolutionClaim {
  input: sr_infer_claim_tree(),
  expected: v2.lens.structural_resolution.StructuralResolutionFact {
    dependencies: [
      v2.std.dependency.ClassifiedDependencyView {
        dependency: sr_infer_dependency,
        classification: FactsLookupMiss
      }
    ]
  }
}

fn unresolved_infer_witness_claim_holds() -> Bool {
  match lens_structural_resolution_actual(claim: unresolved_infer_witness_claim) {
    Holds { value: actual } =>
      fact_eq(a: actual, b: unresolved_infer_witness_claim.expected)
        && fact_single_dependency_projects_status(fact: actual, expected: FactsLookupMiss)
    _ => false
  }
}

data unresolved_infer_witness_claim_passes: Bool = unresolved_infer_witness_claim_holds()
