module v2.test.lens_structural_resolution.unbound_symbol_at_use
import v2.std.optional { Optional, Absent, Present }

data sr_unbound_claim_hash: Hash = sr_unbound_claim_hash

fn sr_unbound_claim_atom(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

data sr_unbound_use: Node = sr_unbound_claim_atom(s: ^sr_unbound_use_symbol)

data sr_unbound_decl: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge { label: Named { name: ^dependency_binds_to_edge }, target: sr_unbound_use }
  ],
  occurrence_id: SyntheticOccurrence
}

data sr_unbound_dependency: DependencyView = DependencyView {
  source: sr_unbound_decl,
  dependent: sr_unbound_use,
  kind: BindsTo,
  usage_site: sr_unbound_use
}

fn sr_unbound_canonical_witness(resolved: Node) -> CanonicalGroundingWitness {
  CanonicalGroundingWitness {
    structural: StructuralPropertyWitness {
      property: ^constraint_property_being_canonical,
      evidence: resolved
    },
    closedness: StructuralPropertyWitness {
      property: ^constraint_property_candidate_set_closedness,
      evidence: resolved
    }
  }
}

fn sr_unbound_resolved_facts() -> InferredFacts {
  claim_inferred_facts(
    type_symbol: ^sr_unbound_type_symbol,
    algebra_symbol: ^sr_unbound_algebra_symbol,
    descent_symbol: ^sr_unbound_descent_symbol,
  )
}

fn sr_unbound_usage_site_witness() -> Optional<InferredFacts> {
  optional_absent()
}

fn sr_unbound_claim_fact_map() -> Map<Node, InferredFacts> {
  let resolved = sr_unbound_resolved_facts()
  Map {
    lookup: fn(key) {
      if key == sr_unbound_use {
        Absent
      } else {
        Present { value: resolved }
      }
    }
  }
}

fn sr_unbound_claim_tree() -> InferredTree {
  InferredTree {
    root: sr_unbound_decl,
    facts: sr_unbound_claim_fact_map()
  }
}

data unbound_symbol_at_use_claim: LensStructuralResolutionClaim = LensStructuralResolutionClaim {
  input: sr_unbound_claim_tree(),
  expected: StructuralResolutionFact {
    dependencies: [
      ClassifiedDependencyView {
        dependency: sr_unbound_dependency,
        classification: UnboundSymbolAtUse
      }
    ]
  }
}

fn unbound_symbol_at_use_claim_holds() -> Bool {
  match lens_structural_resolution_actual(claim: unbound_symbol_at_use_claim) {
    Holds { value: actual } =>
      fact_eq(a: actual, b: unbound_symbol_at_use_claim.expected)
        && fact_single_dependency_projects_status(fact: actual, expected: UnboundSymbolAtUse)
    _ => false
  }
}

data unbound_symbol_at_use_claim_passes: Bool = unbound_symbol_at_use_claim_holds()
