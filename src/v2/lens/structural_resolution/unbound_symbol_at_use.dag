module v2.test.lens_structural_resolution.unbound_symbol_at_use

data sr_unbound_claim_hash: v2.std.node.Hash = sr_unbound_claim_hash

fn sr_unbound_claim_atom(s: v2.std.node.Symbol) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

data sr_unbound_use: Node = sr_unbound_claim_atom(s: ^sr_unbound_use_symbol)

data sr_unbound_decl: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [
    v2.std.node.Edge { label: Named { name: ^dependency_binds_to_edge }, target: sr_unbound_use }
  ],
  occurrence_id: SyntheticOccurrence
}

data sr_unbound_dependency: v2.std.dependency.DependencyView = v2.std.dependency.DependencyView {
  source: sr_unbound_decl,
  dependent: sr_unbound_use,
  kind: BindsTo,
  usage_site: sr_unbound_use
}

fn sr_unbound_canonical_witness(resolved: Node) -> v2.std.constraints.CanonicalGroundingWitness {
  v2.std.constraints.CanonicalGroundingWitness {
    structural: v2.std.witness.StructuralPropertyWitness {
      property: ^constraint_property_being_canonical,
      evidence: resolved
    },
    closedness: v2.std.witness.StructuralPropertyWitness {
      property: ^constraint_property_candidate_set_closedness,
      evidence: resolved
    }
  }
}

fn sr_unbound_resolved_facts() -> v2.compiler.inferred_tree.InferredFacts {
  claim_inferred_facts(
    type_symbol: ^sr_unbound_type_symbol,
    algebra_symbol: ^sr_unbound_algebra_symbol,
    descent_symbol: ^sr_unbound_descent_symbol,
  )
}

fn sr_unbound_usage_site_witness() -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  optional_absent()
}

fn sr_unbound_claim_fact_map() -> Map<Node, v2.compiler.inferred_tree.InferredFacts> {
  let resolved = sr_unbound_resolved_facts()
  std.types.Map {
    lookup: fn(key) {
      if key == sr_unbound_use {
        optional_absent()
      } else {
        optional_present(value: resolved)
      }
    }
  }
}

fn sr_unbound_claim_tree() -> v2.compiler.inferred_tree.InferredTree {
  v2.compiler.inferred_tree.InferredTree {
    root: sr_unbound_decl,
    facts: sr_unbound_claim_fact_map()
  }
}

data unbound_symbol_at_use_claim: v2.test.lens_structural_resolution.claim_carrier.LensStructuralResolutionClaim = v2.test.lens_structural_resolution.claim_carrier.LensStructuralResolutionClaim {
  input: sr_unbound_claim_tree(),
  expected: v2.lens.structural_resolution.StructuralResolutionFact {
    dependencies: [
      v2.std.dependency.ClassifiedDependencyView {
        dependency: sr_unbound_dependency,
        classification: FactsLookupMiss
      }
    ]
  }
}

fn unbound_symbol_at_use_claim_holds() -> Bool {
  match lens_structural_resolution_actual(claim: unbound_symbol_at_use_claim) {
    Holds { value: actual } =>
      fact_eq(a: actual, b: unbound_symbol_at_use_claim.expected)
        && fact_single_dependency_projects_status(fact: actual, expected: FactsLookupMiss)
    _ => false
  }
}

data unbound_symbol_at_use_claim_passes: Bool = unbound_symbol_at_use_claim_holds()
