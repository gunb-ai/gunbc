module v2.test.lens_structural_resolution.binds_to_resolved



data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly
data sr_claim_hash: v2.std.node.Hash = sr_claim_hash

fn sr_claim_atom(s: v2.std.node.Symbol) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

data sr_use: Node = sr_claim_atom(s: ^sr_use_symbol)

data sr_decl: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [
    v2.std.node.Edge { label: Named { name: ^dependency_binds_to_edge }, target: sr_use }
  ],
  occurrence_id: SyntheticOccurrence
}

data sr_dependency: v2.std.dependency.DependencyView = v2.std.dependency.DependencyView {
  source: sr_decl,
  dependent: sr_use,
  kind: BindsTo,
  usage_site: sr_use
}

fn sr_claim_facts() -> v2.compiler.infer.InferredFacts {
  claim_inferred_facts(
    type_symbol: ^sr_type_symbol,
    algebra_symbol: ^sr_algebra_symbol,
    descent_symbol: ^sr_descent_symbol,
  )
}

fn sr_claim_fact_map(facts: v2.compiler.infer.InferredFacts) -> Map<Node, v2.compiler.infer.InferredFacts> {
  Map {
    lookup: fn(_) {
      Present { value: facts }
    }
  }
}

fn sr_claim_tree() -> v2.compiler.infer.InferredTree {
  let facts = sr_claim_facts()
  v2.compiler.infer.InferredTree {
    root: sr_decl,
    facts: sr_claim_fact_map(facts: facts)
  }
}

data binds_to_resolved_claim: v2.test.lens_structural_resolution.claim_carrier.LensStructuralResolutionClaim = v2.test.lens_structural_resolution.claim_carrier.LensStructuralResolutionClaim {
  input: sr_claim_tree(),
  expected: v2.lens.structural_resolution.StructuralResolutionFact {
    dependencies: [
      v2.std.dependency.ClassifiedDependencyView {
        dependency: sr_dependency,
        classification: BindingResolved
      }
    ]
  }
}

test fn binds_to_resolved_claim_holds() -> Bool {
  match lens_structural_resolution_actual(claim: binds_to_resolved_claim) {
    Holds { value: actual } =>
      fact_eq(a: actual, b: binds_to_resolved_claim.expected)
        && fact_single_dependency_projects_status(fact: actual, expected: BindingResolved)
    _ => false
  }
}

data binds_to_resolved_claim_passes: Bool = binds_to_resolved_claim_holds()
