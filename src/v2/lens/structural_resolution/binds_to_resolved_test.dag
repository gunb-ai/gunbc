module v2.test.lens_structural_resolution.binds_to_resolved



data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly
data sr_claim_hash: Hash = sr_claim_hash

fn sr_claim_atom(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

data sr_use: Node = sr_claim_atom(s: ^sr_use_symbol)

data sr_decl: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge { label: Named { name: ^dependency_binds_to_edge }, target: sr_use }
  ],
  occurrence_id: SyntheticOccurrence
}

data sr_dependency: DependencyView = DependencyView {
  source: sr_decl,
  dependent: sr_use,
  kind: BindsTo,
  usage_site: sr_use
}

fn sr_claim_facts() -> InferredFacts {
  claim_inferred_facts(
    type_symbol: ^sr_type_symbol,
    algebra_symbol: ^sr_algebra_symbol,
    descent_symbol: ^sr_descent_symbol,
  )
}

fn sr_claim_fact_map(facts: InferredFacts) -> Map<Node, InferredFacts> {
  Map {
    lookup: fn(_) {
      Present { value: facts }
    }
  }
}

fn sr_claim_tree() -> InferredTree {
  let facts = sr_claim_facts()
  InferredTree {
    root: sr_decl,
    facts: sr_claim_fact_map(facts: facts)
  }
}

data binds_to_resolved_claim: LensStructuralResolutionClaim = LensStructuralResolutionClaim {
  input: sr_claim_tree(),
  expected: StructuralResolutionFact {
    dependencies: [
      ClassifiedDependencyView {
        dependency: sr_dependency,
        classification: BindingResolved
      }
    ]
  }
}

test fn binds_to_resolved_claim_holds() -> Bool {
  match lens_structural_resolution_actual(claim: binds_to_resolved_claim) {
    Holds { value: actual } =>
      fact_eq(a: actual, b: binds_to_resolved_claim.expected)
        && fact_single_dependency_projects_status(fact: actual, expected: BindingResolved)
    _ => false
  }
}

data binds_to_resolved_claim_passes: Bool = binds_to_resolved_claim_holds()
