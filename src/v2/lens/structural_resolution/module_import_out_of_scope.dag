module v2.test.lens_structural_resolution.module_import_out_of_scope

data sr_mod_claim_hash: v2.std.node.Hash = sr_mod_claim_hash

fn sr_mod_claim_atom(s: v2.std.node.Symbol) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

data sr_mod_imported: Node = sr_mod_claim_atom(s: ^sr_mod_child_symbol)

data sr_mod_root: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [
    v2.std.node.Edge { label: Named { name: ^dependency_module_import_edge }, target: sr_mod_imported }
  ],
  occurrence_id: SyntheticOccurrence
}

data sr_mod_dependency: v2.std.dependency.DependencyView = v2.std.dependency.DependencyView {
  source: sr_mod_root,
  dependent: sr_mod_imported,
  kind: ModuleDependsOn,
  usage_site: sr_mod_imported
}

fn sr_mod_canonical_witness(resolved: Node) -> v2.std.constraints.CanonicalGroundingWitness {
  v2.std.constraints.CanonicalGroundingWitness {
    structural: v2.std.witness.StructuralPropertyWitness {
      property: ^constraint_property_being_canonical,
      evidence: resolved
    },
    closedness: v2.std.witness.StructuralPropertyWitness {
      property: ^constraint_property_candidate_set_closedness,
      evidence: resolved
    }
  }
}

fn sr_mod_claim_facts() -> v2.compiler.inferred_tree.InferredFacts {
  claim_inferred_facts(
    type_symbol: ^sr_mod_type_symbol,
    algebra_symbol: ^sr_mod_algebra_symbol,
    descent_symbol: ^sr_mod_descent_symbol,
  )
}

fn sr_mod_claim_fact_map(facts: v2.compiler.inferred_tree.InferredFacts) -> std.algebra.PartialFunction<v2.std.node.Node, v2.compiler.inferred_tree.InferredFacts> {
  std.algebra.PartialFunction {
    lookup: fn(_) {
      Present { value: facts }
    }
  }
}

fn sr_mod_claim_tree() -> v2.compiler.inferred_tree.InferredTree {
  let facts = sr_mod_claim_facts()
  v2.compiler.inferred_tree.InferredTree {
    root: sr_mod_root,
    facts: sr_mod_claim_fact_map(facts: facts)
  }
}

data module_import_out_of_scope_claim: v2.test.lens_structural_resolution.claim_carrier.LensStructuralResolutionClaim = v2.test.lens_structural_resolution.claim_carrier.LensStructuralResolutionClaim {
  input: sr_mod_claim_tree(),
  expected: v2.lens.structural_resolution.StructuralResolutionFact {
    dependencies: [
      v2.std.dependency.ClassifiedDependencyView {
        dependency: sr_mod_dependency,
        classification: OutOfScopeDependencyKind
      }
    ]
  }
}

fn module_import_out_of_scope_claim_holds() -> Bool {
  match lens_structural_resolution_actual(claim: module_import_out_of_scope_claim) {
    Holds { value: actual } =>
      fact_eq(a: actual, b: module_import_out_of_scope_claim.expected)
        && fact_single_dependency_projects_status(
          fact: actual,
          expected: OutOfScopeDependencyKind
        )
    _ => false
  }
}

data module_import_out_of_scope_claim_passes: Bool = module_import_out_of_scope_claim_holds()
