module v2.test.lens_structural_resolution.module_import_out_of_scope

data sr_mod_claim_hash: Hash = sr_mod_claim_hash

fn sr_mod_claim_atom(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

data sr_mod_imported: Node = sr_mod_claim_atom(s: ^sr_mod_child_symbol)

data sr_mod_root: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge { label: Named { name: ^dependency_module_import_edge }, target: sr_mod_imported }
  ],
  occurrence_id: SyntheticOccurrence
}

data sr_mod_dependency: DependencyView = DependencyView {
  source: sr_mod_root,
  dependent: sr_mod_imported,
  kind: ModuleDependsOn,
  usage_site: sr_mod_imported
}

fn sr_mod_canonical_witness(resolved: Node) -> CanonicalGroundingWitness {
  CanonicalGroundingWitness {
    structural: StructuralPropertyWitness {
      property: ^constraint_property_being_canonical,
      evidence: resolved
    },
    closedness: StructuralPropertyWitness {
      property: ^constraint_property_candidate_set_closedness,
      evidence: resolved
    }
  }
}

fn sr_mod_claim_facts() -> InferredFacts {
  claim_inferred_facts(
    type_symbol: ^sr_mod_type_symbol,
    algebra_symbol: ^sr_mod_algebra_symbol,
    descent_symbol: ^sr_mod_descent_symbol,
  )
}

fn sr_mod_claim_fact_map(facts: InferredFacts) -> Map<Node, InferredFacts> {
  Map {
    lookup: fn(_) {
      Holds { value: facts }
    }
  }
}

fn sr_mod_claim_tree() -> InferredTree {
  let facts = sr_mod_claim_facts()
  InferredTree {
    root: sr_mod_root,
    facts: sr_mod_claim_fact_map(facts: facts)
  }
}

data module_import_out_of_scope_claim: LensStructuralResolutionClaim = LensStructuralResolutionClaim {
  input: sr_mod_claim_tree(),
  expected: StructuralResolutionFact {
    dependencies: [
      ClassifiedDependencyView {
        dependency: sr_mod_dependency,
        classification: OutOfScopeDependencyKind
      }
    ]
  }
}

fn module_import_out_of_scope_claim_holds() -> Bool {
  match lens_structural_resolution_actual(claim: module_import_out_of_scope_claim) {
    Holds { value: actual } =>
      fact_eq(a: actual, b: module_import_out_of_scope_claim.expected)
        && fact_single_dependency_projects_status(
          fact: actual,
          expected: OutOfScopeDependencyKind
        )
    _ => false
  }
}

data module_import_out_of_scope_claim_passes: Bool = module_import_out_of_scope_claim_holds()
