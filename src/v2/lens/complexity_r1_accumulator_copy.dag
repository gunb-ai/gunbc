module v2.lens.complexity_r1_accumulator_copy

import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }
import std.disposition { SubstrateMandatoryTag }
import v2.lens.cost {
  PolynomialCost,
  SizeVariable,
  SymbolicCost,
  polynomial_degree_two
}
import v2.std.algebra { CopiedPortFact, copied_port_fact_registry, fold_list }
import v2.std.collection { Absent, List, Optional, Present, list_at_optional }
import v2.std.integer { Int }
import v2.std.logic { Bool }
import v2.std.node { Node, Symbol }
import v2.std.text { String }

data complexity_r1_corpus_census_recall_note: String = "RECALL: future whole-corpus census must rediscover survey suspects — src/v2/workflow/glob_discovery_law.dag:63,94,115 (list_append left:acc); ~10 src/v2/compiler/06_translate.dag list_append(partial,…) sites; v2.std.decl_index.decl_facts_fn_items (fractal: the decl_facts walk itself burned 3m41s in step-0). This is the COST MODEL half of the lens — navigation-free: it owns the copied-port registry lookup (r1_copied_port_index) and the per-call classification (classify_call). The traversal half is the linear fold in v2.lens.complexity_r1_accumulator_copy.analyze, which visits every Node, threads the carrier environment, and calls classify_call at each combiner site — so a copy inside an if/match/let is found by construction (the fold visits it), never by targeted lookup. Whole-corpus enrollment (run the fold over every file, not fixtures) still waits on affected-set/resolution affordability + the enforcement-intent gate; a resolved-body read (binding + dataflow edges) supersedes the surface reads the fold does today."

data copied_port_fact_list_append_left_citation: String = "v2.std.algebra.list_append — left port is fold-over-left copy port (fold_list_right snoc over left)"

data copied_port_fact_list_snoc_left_citation: String = "v2.std.algebra.list_snoc_item — xs port copies via list_append(left: xs, …)"

data copied_port_fact_map_merge_overlay_citation: String = "v1_rt.rs:360 rc_map_merge iterates overlay into Rc::make_mut(base); acc in base port is blessed — acc in overlay is R1 copied-port (historical blessed instance: merge_envs, deleted from src/v1/04_env.dag 2026-07-06; a live overlay-port suspect for future census: collect_unit_variant_phantom_matches fold, src/v1/04_resolve.dag)"

data complexity_r1_opaque_residue_note: String = "AnalysisOpaque: the combiner is a known copied-port row but the copied port's argument is not a bare carrier name (opaque through lets/nested calls/computed expressions). Emitted as a located, counted Finding — never silently dropped, so 'I could not tell' stays distinct from 'clean' (DESIGN §5: ⊤-as-ignorance is not ⊤-as-answer)."

type Finding
  = Poly2Suspect { at: Node, cost: SymbolicCost }
  | AnalysisOpaque { at: Node, reason: Symbol }

fn r1_symbols_equal(a: Symbol, b: Symbol) -> Bool {
  a == b
}

fn symbol_in(needle: Symbol, xs: List<Symbol>) -> Bool {
  fold(xs, init: false, f: fn(acc, s) {
    if acc { true } else { r1_symbols_equal(a: s, b: needle) }
  })
}

fn r1_row_matches_combiner(row: CopiedPortFact, combiner: Symbol) -> Bool {
  r1_symbols_equal(a: row.combiner, b: combiner)
}

fn r1_some_copied_port_index(idx: Int) -> Optional<Int> {
  Present { value: idx }
}

fn r1_copied_port_index(combiner: Symbol) -> Optional<Int> {
  fold_list(
    xs: copied_port_fact_registry,
    empty: Absent,
    cons: fn(acc, row) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          if r1_row_matches_combiner(row: row, combiner: combiner) {
            r1_some_copied_port_index(idx: row.copied_port_index)
          } else {
            Absent
          }
      }
    }
  )
}

fn r1_poly_two_cost(n: Node) -> SymbolicCost {
  PolynomialCost {
    variable: SizeVariable { source: n },
    degree: polynomial_degree_two()
  }
}

fn r1_some_finding(f: Finding) -> Optional<Finding> {
  Present { value: f }
}

fn classify_call(
  at: Node,
  combiner: Symbol,
  port_syms: List<Optional<Symbol>>,
  carriers: List<Symbol>
) -> Optional<Finding> {
  match r1_copied_port_index(combiner: combiner) {
    Absent => Absent
    Present { value: idx } =>
      match list_at_optional(xs: port_syms, index: idx) {
        Absent => Absent
        Present { value: copied } =>
          match copied {
            Present { value: p } =>
              if symbol_in(needle: p, xs: carriers) {
                r1_some_finding(f: Poly2Suspect { at: at, cost: r1_poly_two_cost(n: at) })
              } else {
                Absent
              }
            Absent =>
              r1_some_finding(f: AnalysisOpaque { at: at, reason: ^r1_copied_port_opaque })
          }
      }
  }
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SubstrateMandatoryTag }
}
