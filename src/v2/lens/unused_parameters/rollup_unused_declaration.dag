module v2.test.lens_unused_parameters.rollup_unused_declaration

data rollup_parameter: Node = claim_atom_node(s: ^rollup_parameter_symbol)

data rollup_function: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^rollup_function_symbol } },
  children: [
    Edge { label: Named { name: ^rollup_edge_symbol }, target: rollup_parameter }
  ],
  occurrence_id: SyntheticOccurrence
}

data rollup_contains_dependency: DependencyView = DependencyView {
  source: rollup_function,
  dependent: rollup_parameter,
  kind: Contains,
  usage_site: rollup_parameter
}

fn rollup_facts() -> InferredFacts {
  claim_inferred_facts(
    type_symbol: ^rollup_type_symbol,
    algebra_symbol: ^rollup_algebra_symbol,
    descent_symbol: ^rollup_descent_symbol,
  )
}

fn rollup_tree() -> InferredTree {
  claim_inferred_tree(root: rollup_function, facts: rollup_facts())
}

type LensRollupUnusedClaim {
  input: InferredTree
  expected: UnusedParametersFact
  actual: Witness<UnusedParametersFact>
}

data unused_parameters_rollup_claim: LensRollupUnusedClaim = LensRollupUnusedClaim {
  input: rollup_tree(),
  expected: UnusedParametersFact {
    unused: [
      UnusedParameterFact {
        declaration: rollup_parameter
      }
    ]
  },
  actual: unused_parameters_witness(tree: rollup_tree(), dependencies: [rollup_contains_dependency])
}

fn unused_parameters_rollup_claim_holds() -> Bool {
  match unused_parameters_rollup_claim.actual {
    Holds { value: actual } =>
      unused_parameters_fact_eq(a: actual, b: unused_parameters_rollup_claim.expected)
    _ => false
  }
}

data unused_parameters_rollup_claim_passes: Bool = unused_parameters_rollup_claim_holds()
