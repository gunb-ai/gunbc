module v2.test.lens_unused_parameters.binds_to_edge

data unused_parameters_child: Node = claim_atom_node(s: ^unused_parameters_child_symbol)

data unused_parameters_root: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^unused_parameters_root_symbol } },
  children: [
    Edge { label: Named { name: ^unused_parameters_edge_symbol }, target: unused_parameters_child }
  ],
  occurrence_id: SyntheticOccurrence
}

data unused_parameters_dependency: DependencyView = DependencyView {
  source: unused_parameters_root,
  dependent: unused_parameters_child,
  kind: BindsTo,
  usage_site: unused_parameters_child
}

fn unused_parameters_claim_facts() -> InferredFacts {
  claim_inferred_facts(
    type_symbol: ^unused_parameters_type_symbol,
    algebra_symbol: ^unused_parameters_algebra_symbol,
    descent_symbol: ^unused_parameters_descent_symbol,
  )
}

fn unused_parameters_claim_tree() -> InferredTree {
  claim_inferred_tree(root: unused_parameters_root, facts: unused_parameters_claim_facts())
}

type LensUseClassificationClaim {
  input: InferredTree
  expected: UseClassificationFact
  actual: Witness<UseClassificationFact>
}

data unused_parameters_binds_to_edge_claim: LensUseClassificationClaim = LensUseClassificationClaim {
  input: unused_parameters_claim_tree(),
  expected: UseClassificationFact {
    uses: [
      ClassifiedDependencyView {
        dependency: unused_parameters_dependency,
        classification: IsUseOfDeclaration
      }
    ]
  },
  actual: use_classification_witness(tree: unused_parameters_claim_tree(), dependencies: [unused_parameters_dependency])
}

fn unused_parameters_binds_to_edge_claim_holds() -> Bool {
  match unused_parameters_binds_to_edge_claim.actual {
    Holds { value: actual } =>
      use_classification_fact_eq(a: actual, b: unused_parameters_binds_to_edge_claim.expected)
    _ => false
  }
}

data unused_parameters_binds_to_edge_claim_passes: Bool = unused_parameters_binds_to_edge_claim_holds()
