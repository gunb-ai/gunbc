module v2.test.lens_unused_parameters.non_use_edges

import v2.compiler.infer { InferredFacts, InferredTree }
import v2.lens.unused_parameters {
  IsNonUseDependency,
  IsStructuralComposition,
  RequiresResolutionWitness,
  UseClassificationFact,
  use_classification_fact_eq,
  use_classification_witness
}
import v2.std.dependency {
  ClassifiedDependencyView,
  Contains,
  DataDependsOn,
  DependencyView,
  GeneratedFrom
}
import v2.std.logic { Bool }
import v2.std.node { Atom, Edge, Named, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.witness { Holds, Witness }
import v2.test.lens_common.infer_fixture {
  claim_atom_node,
  claim_inferred_facts,
  claim_inferred_tree
}
data unused_parameters_non_use_child: Node = claim_atom_node(s: ^unused_parameters_non_use_child_symbol)

data unused_parameters_non_use_root: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^unused_parameters_non_use_root_symbol } },
  children: [
    Edge { label: Named { name: ^unused_parameters_non_use_edge_symbol }, target: unused_parameters_non_use_child }
  ],
  occurrence_id: SyntheticOccurrence
}

data unused_parameters_contains_dependency: DependencyView = DependencyView {
  source: unused_parameters_non_use_root,
  dependent: unused_parameters_non_use_child,
  kind: Contains,
  usage_site: unused_parameters_non_use_child
}

data unused_parameters_data_dependency: DependencyView = DependencyView {
  source: unused_parameters_non_use_root,
  dependent: unused_parameters_non_use_child,
  kind: DataDependsOn,
  usage_site: unused_parameters_non_use_child
}

data unused_parameters_generated_from_dependency: DependencyView = DependencyView {
  source: unused_parameters_non_use_root,
  dependent: unused_parameters_non_use_child,
  kind: GeneratedFrom,
  usage_site: unused_parameters_non_use_child
}

fn unused_parameters_non_use_facts() -> InferredFacts {
  claim_inferred_facts(
    type_symbol: ^unused_parameters_non_use_type_symbol,
    algebra_symbol: ^unused_parameters_non_use_algebra_symbol,
    descent_symbol: ^unused_parameters_non_use_descent_symbol,
  )
}

fn unused_parameters_non_use_tree() -> InferredTree {
  claim_inferred_tree(root: unused_parameters_non_use_root, facts: unused_parameters_non_use_facts())
}

type LensUseClassificationPartitionClaim {
  input: InferredTree
  expected: UseClassificationFact
  actual: Witness<UseClassificationFact>
}

data unused_parameters_non_use_edges_claim: LensUseClassificationPartitionClaim = LensUseClassificationPartitionClaim {
  input: unused_parameters_non_use_tree(),
  expected: UseClassificationFact {
    uses: [
      ClassifiedDependencyView {
        dependency: unused_parameters_contains_dependency,
        classification: IsStructuralComposition
      },
      ClassifiedDependencyView {
        dependency: unused_parameters_data_dependency,
        classification: IsNonUseDependency
      },
      ClassifiedDependencyView {
        dependency: unused_parameters_generated_from_dependency,
        classification: RequiresResolutionWitness
      }
    ]
  },
  actual: use_classification_witness(
    tree: unused_parameters_non_use_tree(),
    dependencies: [
      unused_parameters_contains_dependency,
      unused_parameters_data_dependency,
      unused_parameters_generated_from_dependency
    ]
  )
}

fn unused_parameters_non_use_edges_claim_holds() -> Bool {
  match unused_parameters_non_use_edges_claim.actual {
    Holds { value: actual } =>
      use_classification_fact_eq(a: actual, b: unused_parameters_non_use_edges_claim.expected)
    _ => false
  }
}

data unused_parameters_non_use_edges_claim_passes: Bool = unused_parameters_non_use_edges_claim_holds()
