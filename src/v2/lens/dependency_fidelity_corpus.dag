module v2.lens.dependency_fidelity_corpus

import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }
import std.disposition { SingleAuthority }
import std.algebra { Empty }
import v2.std.algebra { filter, length, list_snoc_item }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.integer { Int }
import v2.std.text { String }
import v2.std.dependency { dependency_lens }
import v2.std.fn_index { FnArrowDecl }
import v2.lens.unused_parameters { UseClassificationFact, rollup_unused, use_classify }
import v2.lens.dependency_fidelity { FidelityVerdict, input_reachability_verdict, verdict_is_faithful }

data enrollment_note: String = "dependency-fidelity §7 enrollment: runs the input-reachability fidelity surface over a REAL compiled function (FnArrowDecl.output, the same fn_arrow_decl / dependency_lens substrate the affected-set machinery uses) rather than a synthetic fact — the 'whatever is compiled is lens-tested' path. Per-decl BY CONSTRUCTION (dependency_lens over ONE fn): the caller scopes to the AFFECTED fn set (v2.lens.affected_set), never the whole corpus. This is a substrate constraint, not an optimization — the whole-corpus dependency_view sweep is WallPricedAbort (v2.lens.affected_set.corpus_dependency_view: reconcile wedge ~53min), so affected-set scoping is the only sound way to run this live. Consumes v2.lens.unused_parameters (use_classify + rollup_unused, bypassing its unused InferredTree param) and reports through the v2.lens.dependency_fidelity verdict authority (§3, no re-mint)."

type DeclFidelity {
  qualified_name: String
  verdict: FidelityVerdict
}

fn decl_input_reachability_verdict(decl: FnArrowDecl) -> FidelityVerdict {
  let views = dependency_lens(root: decl.output)
  let use_fact = UseClassificationFact {
    uses: fold(views, init: Empty, f: fn(acc, v) {
      list_snoc_item(xs: acc, item: use_classify(view: v))
    })
  }
  input_reachability_verdict(fact: rollup_unused(use_fact: use_fact))
}

fn decl_fidelity(decl: FnArrowDecl) -> DeclFidelity {
  DeclFidelity {
    qualified_name: decl.qualified_name,
    verdict: decl_input_reachability_verdict(decl: decl)
  }
}

fn fidelity_verdicts_for_decls(decls: List<FnArrowDecl>) -> List<DeclFidelity> {
  fold(decls, init: Empty, f: fn(acc, d) {
    list_snoc_item(xs: acc, item: decl_fidelity(decl: d))
  })
}

fn decl_fidelity_is_discrepant(df: DeclFidelity) -> Bool {
  !verdict_is_faithful(v: df.verdict)
}

fn discrepant_decls(decls: List<FnArrowDecl>) -> List<DeclFidelity> {
  filter(xs: fidelity_verdicts_for_decls(decls: decls), predicate: decl_fidelity_is_discrepant)
}

fn discrepant_decl_count(decls: List<FnArrowDecl>) -> Int {
  length(xs: discrepant_decls(decls: decls))
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SingleAuthority }
}
