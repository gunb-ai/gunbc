module v2.lens.discrimination

type WitnessPolarity
  = AssertsGreen
  | AssertsRed

type DiscriminatingWitness {
  unit: List<v2.std.verification.TestClaim>
}

fn test_claim_polarity(c: v2.std.verification.TestClaim) -> WitnessPolarity {
  match c {
    CompilesClaim { label: _, anchor: _, input: _, expected_value: _, classification: _ } =>
      AssertsGreen
    EqualsClaim { label: _, anchor: _, lhs: _, rhs: _, classification: _ } =>
      AssertsGreen
    StructuralEqualsClaim { label: _, anchor: _, lhs: _, rhs: _, classification: _ } =>
      AssertsGreen
    RoundTripClaim { label: _, anchor: _, input: _, classification: _ } =>
      AssertsGreen
    DiagnosticClaim { label: _, anchor: _, input: _, expected_rejection: _, classification: _ } =>
      AssertsRed
  }
}

fn claim_asserts_green(c: v2.std.verification.TestClaim) -> Bool {
  match test_claim_polarity(c: c) {
    AssertsGreen => true
    AssertsRed => false
  }
}

fn claim_asserts_red(c: v2.std.verification.TestClaim) -> Bool {
  match test_claim_polarity(c: c) {
    AssertsRed => true
    AssertsGreen => false
  }
}

fn unit_greens(unit: List<v2.std.verification.TestClaim>) -> List<v2.std.verification.TestClaim> {
  filter(xs: unit, predicate: claim_asserts_green)
}

fn unit_reds(unit: List<v2.std.verification.TestClaim>) -> List<v2.std.verification.TestClaim> {
  filter(xs: unit, predicate: claim_asserts_red)
}

fn red_coincides_with_a_green(unit: List<v2.std.verification.TestClaim>) -> Bool {
  any(
    xs: unit_reds(unit: unit),
    predicate: fn(r) {
      any(
        xs: unit_greens(unit: unit),
        predicate: fn(g) {
          test_claim_input(c: r) == test_claim_input(c: g)
        }
      )
    }
  )
}

fn unit_has_perturbation(unit: List<v2.std.verification.TestClaim>) -> Bool {
  !red_coincides_with_a_green(unit: unit)
}

fn discrimination_diagnostic(reason: v2.std.node.Symbol) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: reason,
    at: v2.std.diagnostic.Textual { file: ^discrimination_virtual_file, extent: WholeFile },
    correction: v2.std.diagnostic.Unavailable { reason: UserInputBoundary }
  }
}

fn discrimination_lens(unit: List<v2.std.verification.TestClaim>) -> Witness<DiscriminatingWitness> {
  if is_empty(xs: unit_greens(unit: unit)) {
    v2.std.witness.Violates {
      diagnostic: discrimination_diagnostic(reason: ^discrimination_reason_no_positive)
    }
  } else if is_empty(xs: unit_reds(unit: unit)) {
    v2.std.witness.Violates {
      diagnostic: discrimination_diagnostic(reason: ^discrimination_reason_no_discriminating_negative)
    }
  } else if !unit_has_perturbation(unit: unit) {
    v2.std.witness.Violates {
      diagnostic: discrimination_diagnostic(reason: ^discrimination_reason_negative_not_perturbed)
    }
  } else {
    v2.std.witness.Holds { value: DiscriminatingWitness { unit: unit } }
  }
}

fn unit_is_discriminating(unit: List<v2.std.verification.TestClaim>) -> Bool {
  match discrimination_lens(unit: unit) {
    Holds { value: _ } => true
    Violates { diagnostic: _ } => false
  }
}

data construction_justification: v2.lens.common.construction_justification.ConstructionJustification = v2.lens.common.construction_justification.ConstructionJustification {
  class: v2.lens.common.construction_justification.WallAfterGrounding { dissolves_to: SubstrateMandatoryTag }
}
