module v2.test.lens_visibility.visibility_test

import v2.std.logic { Bool }
import v2.std.qualified_name { QualifiedName, QnCons, QnEmpty }
import v2.lens.visibility {
  ModuleVisibilityFact, VisibilityLeak,
  scan_visibility_leaks, visibility_leak_count, visibility_clean
}

data mod_public_api: QualifiedName = QnCons { head: ^public_api, tail: QnEmpty }
data mod_private_impl: QualifiedName = QnCons { head: ^private_impl, tail: QnEmpty }
data mod_public_util: QualifiedName = QnCons { head: ^public_util, tail: QnEmpty }
data mod_unknown_dep: QualifiedName = QnCons { head: ^unknown_dep, tail: QnEmpty }

data no_imports: List<QualifiedName> = []

data red_facts: List<ModuleVisibilityFact> = [
  ModuleVisibilityFact { module: mod_public_api,   public: true,  imports: [mod_private_impl] },
  ModuleVisibilityFact { module: mod_private_impl, public: false, imports: no_imports }
]

data green_facts: List<ModuleVisibilityFact> = [
  ModuleVisibilityFact { module: mod_public_api,  public: true, imports: [mod_public_util] },
  ModuleVisibilityFact { module: mod_public_util, public: true, imports: no_imports }
]

data failclosed_facts: List<ModuleVisibilityFact> = [
  ModuleVisibilityFact { module: mod_public_api, public: true, imports: [mod_unknown_dep] }
]

data private_importer_facts: List<ModuleVisibilityFact> = [
  ModuleVisibilityFact { module: mod_private_impl, public: false, imports: [mod_unknown_dep] }
]

test fn leak_caught_public_imports_private() -> Bool {
  visibility_leak_count(facts: red_facts) == 1
}

test fn clean_public_imports_public() -> Bool {
  visibility_clean(facts: green_facts)
}

test fn failclosed_unknown_import_is_leak() -> Bool {
  visibility_leak_count(facts: failclosed_facts) == 1
}

test fn private_importer_may_depend_on_anything() -> Bool {
  visibility_clean(facts: private_importer_facts)
}
