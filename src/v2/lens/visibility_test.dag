module v2.test.lens_visibility.visibility_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data mod_public_api: v2.std.qualified_name.QualifiedName = std.algebra.Cons { head: ^public_api, tail: std.algebra.Empty }
data mod_private_impl: v2.std.qualified_name.QualifiedName = std.algebra.Cons { head: ^private_impl, tail: std.algebra.Empty }
data mod_public_util: v2.std.qualified_name.QualifiedName = std.algebra.Cons { head: ^public_util, tail: std.algebra.Empty }
data mod_unknown_dep: v2.std.qualified_name.QualifiedName = std.algebra.Cons { head: ^unknown_dep, tail: std.algebra.Empty }

data no_imports: List<v2.std.qualified_name.QualifiedName> = []

data red_facts: List<v2.lens.visibility.ModuleVisibilityFact> = [
  v2.lens.visibility.ModuleVisibilityFact { module: mod_public_api,   public: true,  imports: [mod_private_impl] },
  v2.lens.visibility.ModuleVisibilityFact { module: mod_private_impl, public: false, imports: no_imports }
]

data green_facts: List<v2.lens.visibility.ModuleVisibilityFact> = [
  v2.lens.visibility.ModuleVisibilityFact { module: mod_public_api,  public: true, imports: [mod_public_util] },
  v2.lens.visibility.ModuleVisibilityFact { module: mod_public_util, public: true, imports: no_imports }
]

data failclosed_facts: List<v2.lens.visibility.ModuleVisibilityFact> = [
  v2.lens.visibility.ModuleVisibilityFact { module: mod_public_api, public: true, imports: [mod_unknown_dep] }
]

data private_importer_facts: List<v2.lens.visibility.ModuleVisibilityFact> = [
  v2.lens.visibility.ModuleVisibilityFact { module: mod_private_impl, public: false, imports: [mod_unknown_dep] }
]

test fn leak_caught_public_imports_private() -> Bool {
  visibility_leak_count(facts: red_facts) == 1
}

test fn clean_public_imports_public() -> Bool {
  visibility_clean(facts: green_facts)
}

test fn failclosed_unknown_import_is_leak() -> Bool {
  visibility_leak_count(facts: failclosed_facts) == 1
}

test fn private_importer_may_depend_on_anything() -> Bool {
  visibility_clean(facts: private_importer_facts)
}
