module v2.lens.unit_modeling
import v2.lens.common.construction_justification { ConstructionJustification, RatchetForever }

import v2.std.algebra { fold_list }
import v2.std.node {
  Node,
  Edge,
  Named,
  Positional,
  TypeNode,
  ComputationNode,
  Symbol,
  node_subtree_nodes
}
import v2.std.node_query { edge_field_type_name }
import v2.std.collection {
  List,
  Map,
  Optional,
  Present,
  Absent,
  optional_present,
  optional_absent,
  optional_prefer_first_present,
  empty_map,
  map_insert,
  map_get
}
import v2.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Accepted,
  Unavailable,
  outcome_accepted,
  outcome_rejected,
  node_locus
}
import v2.std.witness { Holds, Witness }

type UnitFieldRow {
  field: Symbol
  carrier: Symbol
}

data unit_field_rows: List<UnitFieldRow> = [

  UnitFieldRow { field: ^clock_hz, carrier: ^Hertz },
  UnitFieldRow { field: ^cpu_reserved_hz, carrier: ^Hertz },
  UnitFieldRow { field: ^cpu_capacity_hz, carrier: ^Hertz },

  UnitFieldRow { field: ^ram_bytes, carrier: ^ByteSize },
  UnitFieldRow { field: ^ram_reserved_bytes, carrier: ^ByteSize },
  UnitFieldRow { field: ^ram_cap_bytes, carrier: ^ByteSize },
  UnitFieldRow { field: ^memory_bytes, carrier: ^ByteSize },
  UnitFieldRow { field: ^disk_bytes, carrier: ^ByteSize },

  UnitFieldRow { field: ^hourly, carrier: ^MoneyAmountMicro },
  UnitFieldRow { field: ^monthly_cap, carrier: ^MoneyAmountMicro },
  UnitFieldRow { field: ^vcpus, carrier: ^HardwareThreadCount },

  UnitFieldRow { field: ^timeout_seconds, carrier: ^Duration },
  UnitFieldRow { field: ^lifetime_seconds, carrier: ^Duration },

  UnitFieldRow { field: ^bandwidth_bps, carrier: ^Bandwidth },

  UnitFieldRow { field: ^bit_width, carrier: ^BitWidth },
  UnitFieldRow { field: ^pointer_width, carrier: ^BitWidth },
  UnitFieldRow { field: ^word_width, carrier: ^BitWidth },

  UnitFieldRow { field: ^hardware_threads, carrier: ^HardwareThreadCount },
  UnitFieldRow { field: ^thread_count, carrier: ^HardwareThreadCount },

  UnitFieldRow { field: ^microvolts, carrier: ^Voltage },
  UnitFieldRow { field: ^microamperes, carrier: ^Current },
  UnitFieldRow { field: ^microohms, carrier: ^ResistanceMicro },
  UnitFieldRow { field: ^microfarads, carrier: ^CapacitanceMicro },
  UnitFieldRow { field: ^microhenries, carrier: ^InductanceMicro },
  UnitFieldRow { field: ^charge_microcoulombs, carrier: ^ChargeMicro },
  UnitFieldRow { field: ^flux_microwebers, carrier: ^FluxMicro },
  UnitFieldRow { field: ^dt_microseconds, carrier: ^DurationMicro }
]

fn unit_field_token_map() -> Map<Symbol, Symbol> {
  fold(unit_field_rows, init: empty_map(), f: fn(acc, row) {
    map_insert(m: acc, key: row.field, value: row.carrier)
  })
}

fn field_name_has_known_carrier(name: Symbol) -> Bool {
  match map_get(m: unit_field_token_map(), key: name) {
    Accepted { value: Present { value: _ } } => true
    _ => false
  }
}

data exemption_marker_rows: List<Symbol> = [

  ^version, ^opcode, ^id, ^kind, ^tag, ^discriminant, ^status, ^code, ^enum,

  ^index, ^idx, ^ordinal, ^position, ^pos, ^offset, ^line, ^column, ^col
]

fn exemption_marker_set() -> Map<Symbol, Symbol> {
  fold(exemption_marker_rows, init: empty_map(), f: fn(acc, mk) {
    map_insert(m: acc, key: mk, value: mk)
  })
}

fn name_is_exempt(name: Symbol) -> Bool {
  match map_get(m: exemption_marker_set(), key: name) {
    Accepted { value: Present { value: _ } } => true
    _ => false
  }
}

fn type_is_flat_scalar(target: Node) -> Bool {
  edge_field_type_name(target: target) == ^dag_binding_type_int
}

fn field_unit_violation(carrier: Node, edge: Edge) -> Optional<Diagnostic> {
  match edge.label {
    Named { name: nm } =>
      if type_is_flat_scalar(target: edge.target) {
        if name_is_exempt(name: nm) {
          optional_absent()
        } else {
          optional_present(value: unit_modeling_diagnostic(carrier: carrier, name: nm))
        }
      } else {
        optional_absent()
      }
    Positional => optional_absent()
  }
}

fn carrier_first_unit_violation(carrier: Node) -> Optional<Diagnostic> {
  match carrier.kind {
    TypeNode { connective: _ } =>
      fold_list(
        xs: carrier.children,
        empty: optional_absent(),
        cons: fn(acc, edge) {
          optional_prefer_first_present(left: acc, right: field_unit_violation(carrier: carrier, edge: edge))
        }
      )
    ComputationNode { behavior: _ } => Absent
  }
}

fn subtree_first_unit_violation(node: Node) -> Optional<Diagnostic> {
  fold_list(
    xs: node_subtree_nodes(root: node),
    empty: optional_absent(),
    cons: fn(acc, n) {
      optional_prefer_first_present(left: acc, right: carrier_first_unit_violation(carrier: n))
    }
  )
}

fn unit_modeling_diagnostic(carrier: Node, name: Symbol) -> Diagnostic {
  if field_name_has_known_carrier(name: name) {
    Diagnostic {
      reason: ^unit_modeling_flat_scalar_unit_leaf_fixable,
      at: node_locus(node: carrier),
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  } else {
    Diagnostic {
      reason: ^unit_modeling_flat_scalar_blocked_pending_carrier,
      at: node_locus(node: carrier),
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  }
}

fn unit_modeling_gate(node: Node) -> Outcome<Witness<Node>> {
  match subtree_first_unit_violation(node: node) {
    Present { value: d } => outcome_rejected(d)
    Absent => outcome_accepted(value: Holds { value: node })
  }
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: RatchetForever
}
