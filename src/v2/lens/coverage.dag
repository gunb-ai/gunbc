// 🟢 coproduct dissolution — local fold state for per-missing coverage diagnostic accumulation.
type CoverageMissingDiagnosticsFold
  = NoCoverageMissingDiagnostics
  | SomeCoverageMissingDiagnostics { acc: NonEmptyDiagnostics }

// 🟢 coproduct dissolution — local slice projection carrier for fail-closed actual-key collection.
type CoverageSliceProjection<C>
  = CoverageSliceNotApplicable
  | CoverageSlicePresent { key: C }
  | CoverageSliceInvalid { diagnostics: NonEmptyDiagnostics }

type Coverage<C> {
  concern: C
}

type L6CoverageKey {
  subject: TypeConstructionSubject
  language: Symbol
}

type L7CoverageKey = AlgebraLawSubject

type ImpossibleBugCoverageKey {
  bug_class: ImpossibleBugClass
}

type TestgenCoverageKey = TestgenConcept

type CoverageReading {
  l6_missing: List<Coverage<L6CoverageKey>>
  l7_missing: List<Coverage<L7CoverageKey>>
  impossible_bug_missing: List<Coverage<ImpossibleBugCoverageKey>>
  testgen_missing: List<Coverage<TestgenCoverageKey>>
}

// 🟡 coproduct dissolution — SL-COVERAGE-DEFECT-KEY.
type CoverageDefectKey
  = DiscriminantPredicate
  | DegenerateType
  | HollowType
  | CarrierClone
  | Catamorphism
  | TemplateHole
  | OffSubstrateFact
  | WrongHome
  | VacuousArm
  | CanonicalCarrier
  | PlausibleFallback
  | ParallelAuthority
  | SkeletonCollapse

type CoverageDefectAcceptanceKey {
  lens: CoverageDefectKey
}

type CoverageDefectAcceptance = Coverage<CoverageDefectAcceptanceKey>
data coverage_defect_discriminant_predicate: CoverageDefectAcceptance = {
  concern: CoverageDefectAcceptanceKey { lens: DiscriminantPredicate }
}
data coverage_defect_degenerate_type: CoverageDefectAcceptance = {
  concern: CoverageDefectAcceptanceKey { lens: DegenerateType }
}
data coverage_defect_hollow_type: CoverageDefectAcceptance = {
  concern: CoverageDefectAcceptanceKey { lens: HollowType }
}
data coverage_defect_carrier_clone: CoverageDefectAcceptance = {
  concern: CoverageDefectAcceptanceKey { lens: CarrierClone }
}
data coverage_defect_catamorphism: CoverageDefectAcceptance = {
  concern: CoverageDefectAcceptanceKey { lens: Catamorphism }
}
data coverage_defect_template_hole: CoverageDefectAcceptance = {
  concern: CoverageDefectAcceptanceKey { lens: TemplateHole }
}
data coverage_defect_off_substrate_fact: CoverageDefectAcceptance = {
  concern: CoverageDefectAcceptanceKey { lens: OffSubstrateFact }
}
data coverage_defect_wrong_home: CoverageDefectAcceptance = {
  concern: CoverageDefectAcceptanceKey { lens: WrongHome }
}
data coverage_defect_vacuous_arm: CoverageDefectAcceptance = {
  concern: CoverageDefectAcceptanceKey { lens: VacuousArm }
}
data coverage_defect_canonical_carrier: CoverageDefectAcceptance = {
  concern: CoverageDefectAcceptanceKey { lens: CanonicalCarrier }
}
data coverage_defect_plausible_fallback: CoverageDefectAcceptance = {
  concern: CoverageDefectAcceptanceKey { lens: PlausibleFallback }
}
data coverage_defect_parallel_authority: CoverageDefectAcceptance = {
  concern: CoverageDefectAcceptanceKey { lens: ParallelAuthority }
}
data coverage_defect_skeleton_collapse: CoverageDefectAcceptance = {
  concern: CoverageDefectAcceptanceKey { lens: SkeletonCollapse }
}

// 🟡 gated — derived-equality interim — bound target: exact structural equality / compiler-provided closed-sum equality — bind node://adhoc-35324347-e8a — dissolve-on-arrival: replace connective_eq / behavior_eq / type_construction_subject_eq call sites with the substrate equality primitive and delete these helpers in that same PR; forbidden: permanent per-variant Connective/Behavior equality table drift from std/node.dag.
fn connective_eq(a: Connective, b: Connective) -> Bool {
  match a {
    Atom { identity: ai } =>
      match b {
        Atom { identity: bi } => ai == bi
        _ => false
      }
    Conj =>
      match b {
        Conj => true
        _ => false
      }
    Disj =>
      match b {
        Disj => true
        _ => false
      }
    Arrow =>
      match b {
        Arrow => true
        _ => false
      }
    Cardinality =>
      match b {
        Cardinality => true
        _ => false
      }
    Instantiation =>
      match b {
        Instantiation => true
        _ => false
      }
  }
}

fn behavior_eq(a: Behavior, b: Behavior) -> Bool {
  match a {
    Value =>
      match b {
        Value => true
        _ => false
      }
    Transform =>
      match b {
        Transform => true
        _ => false
      }
    Branch =>
      match b {
        Branch => true
        _ => false
      }
    Loop =>
      match b {
        Loop => true
        _ => false
      }
    Bind =>
      match b {
        Bind => true
        _ => false
      }
  }
}

fn type_construction_subject_eq(a: TypeConstructionSubject, b: TypeConstructionSubject) -> Bool {
  match a {
    ConnectiveKernel { connective: ac } =>
      match b {
        ConnectiveKernel { connective: bc } => connective_eq(a: ac, b: bc)
        _ => false
      }
    BehaviorValueSubject { behavior: ab } =>
      match b {
        BehaviorValueSubject { behavior: bb } => behavior_eq(a: ab, b: bb)
        _ => false
      }
  }
}

// 🟡 gated — derived-equality interim — bound target: exact structural equality / compiler-provided closed-sum equality — bind node://adhoc-35324347-e8a — dissolve-on-arrival: replace algebra_law_subject_eq / l6_coverage_key_eq / l7_coverage_key_eq call sites with the substrate equality primitive and delete these helpers in that same PR; forbidden: permanent per-field AlgebraLawSubject / L6CoverageKey equality table drift from std/nat.dag and lens/testgen.dag.
fn algebra_law_subject_eq(a: AlgebraLawSubject, b: AlgebraLawSubject) -> Bool {
  a.algebra == b.algebra && a.inhabitant == b.inhabitant && a.law == b.law
}

fn l6_coverage_key_eq(a: L6CoverageKey, b: L6CoverageKey) -> Bool {
  a.language == b.language &&
    type_construction_subject_eq(a: a.subject, b: b.subject)
}

fn l7_coverage_key_eq(a: L7CoverageKey, b: L7CoverageKey) -> Bool {
  algebra_law_subject_eq(a: a, b: b)
}

// 🟡 gated — derived-equality interim — bound target: exact structural equality / compiler-provided closed-sum equality — bind node://adhoc-35324347-e8a — dissolve-on-arrival: replace impossible_bug_coverage_key_eq call sites with the substrate ImpossibleBugClass equality primitive and delete this helper in that same PR; forbidden: permanent per-variant ImpossibleBugClass equality table drift from std/verification.dag.
fn impossible_bug_coverage_key_eq(a: ImpossibleBugCoverageKey, b: ImpossibleBugCoverageKey) -> Bool {
  match a.bug_class {
    SuboptimalComplexity =>
      match b.bug_class {
        SuboptimalComplexity => true
        _ => false
      }
    IdempotencyContract =>
      match b.bug_class {
        IdempotencyContract => true
        _ => false
      }
    TransportTypeDrift =>
      match b.bug_class {
        TransportTypeDrift => true
        _ => false
      }
    NestedOptionalFlatten =>
      match b.bug_class {
        NestedOptionalFlatten => true
        _ => false
      }
    UnenumeratedEffects =>
      match b.bug_class {
        UnenumeratedEffects => true
        _ => false
      }
    UnhandledDiagnosticPaths =>
      match b.bug_class {
        UnhandledDiagnosticPaths => true
        _ => false
      }
  }
}

// 🟡 gated — derived-equality interim — bound target: exact structural equality / compiler-provided closed-sum equality — bind node://adhoc-35324347-e8a — dissolve-on-arrival: replace frozen_language_behavior_snapshot_eq / language_behavior_io_mock_eq call sites with the substrate equality primitive and delete these helpers in that same PR; forbidden: permanent per-field LBE mock equality table drift from lens/testgen.dag.
fn frozen_language_behavior_snapshot_eq(
  a: FrozenLanguageBehaviorSnapshot,
  b: FrozenLanguageBehaviorSnapshot
) -> Bool {
  a.language == b.language &&
    a.input_node == b.input_node &&
    a.expected_value == b.expected_value
}

fn language_behavior_io_mock_eq(a: LanguageBehaviorIoMock, b: LanguageBehaviorIoMock) -> Bool {
  frozen_language_behavior_snapshot_eq(a: a.snapshot, b: b.snapshot)
}

// 🟡 gated — derived-equality interim — bound target: exact structural equality / compiler-provided closed-sum equality — bind node://adhoc-35324347-e8a — dissolve-on-arrival: replace lens_applicability_subject_eq / bidirectional_roundtrip_subject_eq / node_list_eq / refinement_preservation_subject_eq call sites with the substrate equality primitive and delete these helpers in that same PR; forbidden: permanent per-field TestgenConcept subject equality table drift from lens/testgen.dag.
fn lens_applicability_subject_eq(a: LensApplicabilitySubject, b: LensApplicabilitySubject) -> Bool {
  a.lens == b.lens && a.program == b.program
}

fn bidirectional_roundtrip_subject_eq(
  a: BidirectionalRoundtripSubject,
  b: BidirectionalRoundtripSubject
) -> Bool {
  a.language == b.language && a.production == b.production
}

fn node_list_eq(a: List<Node>, b: List<Node>) -> Bool {
  a == b
}

fn refinement_preservation_subject_eq(
  a: RefinementPreservationSubject,
  b: RefinementPreservationSubject
) -> Bool {
  refined_base(r: a.refined) == refined_base(r: b.refined) && node_list_eq(a: a.original, b: b.original)
}

