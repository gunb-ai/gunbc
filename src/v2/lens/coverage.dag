fn testgen_coverage_key_from_generator(generator: Generator<TestgenConcept>) -> TestgenCoverageKey {
  generator.slot
}

fn testgen_coverage_keys_from_scheduled_generators(
  generators: List<Generator<TestgenConcept>>
) -> List<TestgenCoverageKey> {
  fold_list_right(
    xs: generators,
    empty: Empty,
    snoc: fn(acc, generator) {
      dedupe_snoc(
        acc: acc,
        item: testgen_coverage_key_from_generator(generator: generator),
        eq: testgen_coverage_key_eq
      )
    }
  )
}

fn expected_language_behavior_equivalence_testgen_keys() -> List<TestgenCoverageKey> {
  testgen_coverage_keys_from_scheduled_generators(
