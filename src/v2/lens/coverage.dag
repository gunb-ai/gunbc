// 🟡 gated — derived-equality interim — bound target: exact structural equality / compiler-provided closed-sum equality — bind node://adhoc-35324347-e8a — dissolve-on-arrival: replace testgen_coverage_key_eq call sites with the substrate TestgenConcept equality primitive and delete this helper in that same PR; forbidden: permanent per-variant TestgenConcept equality table drift from lens/testgen.dag.
fn testgen_coverage_key_eq(a: TestgenCoverageKey, b: TestgenCoverageKey) -> Bool {
  match a {
    TypeConstruction { subject: as } =>
      match b {
        TypeConstruction { subject: bs } =>
          type_construction_subject_eq(a: as, b: bs)
        _ => false
      }
    AlgebraLaw { subject: as } =>
      match b {
        AlgebraLaw { subject: bs } => algebra_law_subject_eq(a: as, b: bs)
        _ => false
      }
    DiagnosticExhaustiveness { omitted_variant: av } =>
      match b {
        DiagnosticExhaustiveness { omitted_variant: bv } =>
          test_claim_coproduct_variant_eq(a: av, b: bv)
        _ => false
      }
    LensApplicability { subject: as } =>
      match b {
        LensApplicability { subject: bs } => lens_applicability_subject_eq(a: as, b: bs)
        _ => false
      }
    BidirectionalRoundtrip { subject: as } =>
      match b {
        BidirectionalRoundtrip { subject: bs } => bidirectional_roundtrip_subject_eq(a: as, b: bs)
        _ => false
      }
    LanguageBehaviorEquivalence { subject: as, mock: am } =>
      match b {
        LanguageBehaviorEquivalence { subject: bs, mock: bm } =>
          type_construction_subject_eq(a: as.subject, b: bs.subject) &&
            as.language == bs.language &&
            language_behavior_io_mock_eq(a: am, b: bm)
        _ => false
      }
    RefinementPreservation { subject: as } =>
      match b {
        RefinementPreservation { subject: bs } => refinement_preservation_subject_eq(a: as, b: bs)
        _ => false
      }
  }
}

fn l6_coverage_key(subject: TypeConstructionSubject, language: Symbol) -> L6CoverageKey {
  L6CoverageKey { subject: subject, language: language }
}

fn coverage_of<C>(key: C) -> Coverage<C> {
  Coverage { concern: key }
}

fn dedupe_snoc<C>(acc: List<C>, item: C, eq: fn(C, C) -> Bool) -> List<C> {
  match contains(xs: acc, item: item, eq: eq) {
    true => acc
    false => list_snoc_item(xs: acc, item: item)
  }
}

fn missing_keys<C>(
  expected: List<C>,
  actual: List<C>,
  eq: fn(C, C) -> Bool
) -> List<C> {
  filter(xs: expected, predicate: fn(key) {
    match contains(xs: actual, item: key, eq: eq) {
      true => false
      false => true
    }
  })
}

fn missing_coverage<C>(
  expected: List<C>,
  actual: List<C>,
  eq: fn(C, C) -> Bool
) -> List<Coverage<C>> {
  fold_list_right(
    xs: missing_keys(expected: expected, actual: actual, eq: eq),
    empty: Empty,
    snoc: fn(acc, key) {
      Cons { head: coverage_of(key: key), tail: acc }
    }
  )
}

// 🟡 gated — feature:l6-k1-dag-language-surface-only — bind gunbc#4762
// dissolve-on-arrival: bootstrap_l6_language_surfaces projects extdeps/languages scheduled L6 surface Symbol anchors; forbidden: reporting K-1 single-language bootstrap as full L6 completeness.
fn bootstrap_l6_language_surfaces() -> List<Symbol> {
  [^dag_language_model_surface_id]
}

fn substrate_connective_kernels() -> List<Connective> {
  fold_list_right(
    xs: connective_coproduct_variant_keys(),
    empty: Empty,
    snoc: fn(acc, variant) {
      list_snoc_item(
        xs: acc,
        item: connective_from_coproduct_variant(
          variant: variant,
          atom_identity: ^dag_c3_surface_sugar_type
        )
      )
    }
  )
}

fn substrate_behavior_subjects() -> List<Behavior> {
  behavior_coproduct_variants()
}

fn type_construction_subject_from_connective(c: Connective) -> TypeConstructionSubject {
  ConnectiveKernel { connective: c }
}

fn type_construction_subject_from_behavior(b: Behavior) -> TypeConstructionSubject {
  BehaviorValueSubject { behavior: b }
}

fn bootstrap_type_construction_subjects() -> List<TypeConstructionSubject> {
  fold_list_right(
    xs: substrate_connective_kernels(),
    empty: fold_list_right(
      xs: substrate_behavior_subjects(),
      empty: Empty,
      snoc: fn(acc, behavior) {
        list_snoc_item(
          xs: acc,
          item: type_construction_subject_from_behavior(b: behavior)
        )
      }
    ),
    snoc: fn(acc, connective) {
      list_snoc_item(
        xs: acc,
        item: type_construction_subject_from_connective(c: connective)
      )
    }
  )
}

fn append_l6_keys_for_language(
  subjects: List<TypeConstructionSubject>,
  language: Symbol,
  acc: List<L6CoverageKey>
) -> List<L6CoverageKey> {
  fold_list_right(
    xs: subjects,
    empty: acc,
    snoc: fn(tail, subject) {
      Cons {
        head: l6_coverage_key(subject: subject, language: language),
        tail: tail
      }
    }
  )
}

fn expected_l6_coverage_keys() -> List<L6CoverageKey> {
  fold_list_right(
    xs: bootstrap_l6_language_surfaces(),
    empty: Empty,
    snoc: fn(acc, language) {
      append_l6_keys_for_language(
        subjects: bootstrap_type_construction_subjects(),
        language: language,
        acc: acc
      )
    }
  )
}

// 🟡 gated — record-shape bridge interim — feature:nat-law-obligation-lens-migration — dissolve-on-arrival: NatAlgebraLawObligation (std/nat) is the authoritative L7 law-subject carrier; AlgebraLawSubject is the downstream lens-local shape consumed as L7CoverageKey; migrate testgen + coverage to consume NatAlgebraLawObligation directly and delete l7_coverage_key_from_nat_obligation in that same PR; forbidden: permanent parallel NatAlgebraLawObligation⇄AlgebraLawSubject record-shape drift across std/nat and lens/coverage.
fn l7_coverage_key_from_nat_obligation(o: NatAlgebraLawObligation) -> L7CoverageKey {
  AlgebraLawSubject {
    algebra: o.algebra,
    inhabitant: o.inhabitant,
    law: o.law,
  }
}

fn expected_l7_coverage_keys() -> List<L7CoverageKey> {
  fold_list_right(
    xs: nat_declared_algebra_law_obligations(),
    empty: Empty,
    snoc: fn(acc, obligation) {
      dedupe_snoc(
        acc: acc,
        item: l7_coverage_key_from_nat_obligation(o: obligation),
        eq: l7_coverage_key_eq
      )
    }
  )
}

fn algebra_law_testgen_key_from_nat_obligation(o: NatAlgebraLawObligation) -> TestgenCoverageKey {
  AlgebraLaw { subject: l7_coverage_key_from_nat_obligation(o: o) }
}

fn expected_algebra_law_testgen_keys() -> List<TestgenCoverageKey> {
  fold_list_right(
    xs: nat_declared_algebra_law_obligations(),
    empty: Empty,
    snoc: fn(acc, obligation) {
      dedupe_snoc(
        acc: acc,
        item: algebra_law_testgen_key_from_nat_obligation(o: obligation),
        eq: testgen_coverage_key_eq
      )
    }
  )
}

fn impossible_bug_coverage_key_from_bug_class(bug_class: ImpossibleBugClass) -> ImpossibleBugCoverageKey {
  ImpossibleBugCoverageKey { bug_class: bug_class }
}

fn impossible_bug_coverage_keys_from_bug_classes(classes: List<ImpossibleBugClass>) -> List<ImpossibleBugCoverageKey> {
  fold_list_right(
    xs: classes,
    empty: Empty,
    snoc: fn(acc, bug_class) {
      dedupe_snoc(
        acc: acc,
        item: impossible_bug_coverage_key_from_bug_class(bug_class: bug_class),
        eq: impossible_bug_coverage_key_eq
      )
    }
  )
}

fn expected_impossible_bug_coverage_keys() -> List<ImpossibleBugCoverageKey> {
  impossible_bug_coverage_keys_from_bug_classes(
    classes: impossible_bug_class_coproduct_variants()
