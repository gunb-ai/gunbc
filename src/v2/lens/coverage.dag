        )
      )
    }
  )
}

fn testgen_coverage_key_from_claim(c: TestClaim) -> Outcome<TestgenCoverageKey> {
  match testgen_concept_for_manual_claim(claim: c) {
    Accepted { value: concept, diagnostics: None } =>
      Accepted { value: concept, diagnostics: None }
    Rejected { diagnostics: d } =>
      Rejected { diagnostics: d }
  }
}

// 🟡 gated — predicate-dissolution interim — feature:testgen-scheduled-anchor-absent — bind gunbc#4762 — dissolve-on-arrival: L6/L7/testgen slice NotApplicable for ManualAnchorAbsent rows reads testgen_concept_for_manual_claim rejection taxonomy from lens/testgen + std/verification; delete claim_is_outside_testgen_scheduled_anchor in that same PR; forbidden: permanent lens-owned ClaimAnchorKey ManualAnchorAbsent predicate drift from std/verification.
fn claim_is_outside_testgen_scheduled_anchor(c: TestClaim) -> Bool {
  match test_claim_anchor(c: c) {
    ManualClaimAnchor { manual_anchor: ManualAnchorAbsent } => true
    ManualClaimAnchor { manual_anchor: _ } => false
    GeneratedClaimAnchor { generated_anchor: _ } => false
  }
}

fn impossible_bug_coverage_key_from_diagnostic_reason(reason: Symbol) -> Outcome<ImpossibleBugCoverageKey> {
  bind_outcome(
    o: impossible_bug_class_from_diagnostic_reason(reason: reason),
    f: fn(bug_class) {
      Accepted {
        value: ImpossibleBugCoverageKey { bug_class: bug_class },
        diagnostics: None,
      }
    }
  )
}

fn append_impossible_bug_key_from_diagnostic(
  acc: List<ImpossibleBugCoverageKey>,
  diagnostic: Diagnostic
) -> Outcome<List<ImpossibleBugCoverageKey>> {
  match impossible_bug_coverage_key_from_diagnostic_reason(reason: diagnostic.reason) {
    Accepted { value: key, diagnostics: None } =>
      Accepted {
        value: dedupe_snoc(acc: acc, item: key, eq: impossible_bug_coverage_key_eq),
        diagnostics: None,
      }
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}

fn fold_diagnostic_tail_into_impossible_bug_keys(
  acc: List<ImpossibleBugCoverageKey>,
  tail: List<Diagnostic>
) -> Outcome<List<ImpossibleBugCoverageKey>> {
  fold_list(
    xs: tail,
    empty: outcome_accepted(value: acc),
    cons: fn(o, diagnostic) {
      bind_outcome(
        o: o,
        f: fn(keys) {
          append_impossible_bug_key_from_diagnostic(acc: keys, diagnostic: diagnostic)
        }
      )
    }
  )
}

// 🟢 coproduct dissolution — local fold state for fail-closed sole impossible-bug key selection.
type SoleImpossibleBugKeyFold
  = NoImpossibleBugKey
  | OneImpossibleBugKey { key: ImpossibleBugCoverageKey }
  | MultipleImpossibleBugKeys

fn sole_impossible_bug_coverage_key_fold(
  state: SoleImpossibleBugKeyFold,
  key: ImpossibleBugCoverageKey
) -> SoleImpossibleBugKeyFold {
  match state {
    NoImpossibleBugKey =>
      OneImpossibleBugKey { key: key }
    OneImpossibleBugKey { key: _ } =>
      MultipleImpossibleBugKeys
    MultipleImpossibleBugKeys =>
      MultipleImpossibleBugKeys
  }
}

fn sole_impossible_bug_coverage_key(
  keys: List<ImpossibleBugCoverageKey>
) -> Outcome<ImpossibleBugCoverageKey> {
  let state = fold_list_right(
    xs: keys,
    empty: NoImpossibleBugKey,
    snoc: fn(s, key) {
      sole_impossible_bug_coverage_key_fold(state: s, key: key)
    }
  )
  match state {
    NoImpossibleBugKey =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: Diagnostic {
            reason: ^coverage_reason_impossible_bug_diagnostic_unmapped,
            at: Textual { file: ^coverage_virtual_file, extent: WholeFile },
            correction: Unavailable { reason: UserInputBoundary }
          }
        )
      }
    OneImpossibleBugKey { key: key } =>
      Accepted { value: key, diagnostics: None }
    MultipleImpossibleBugKeys =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: Diagnostic {
            reason: ^coverage_reason_impossible_bug_diagnostic_unmapped,
            at: Textual { file: ^coverage_virtual_file, extent: WholeFile },
            correction: Unavailable { reason: UserInputBoundary }
          }
        )
      }
  }
}

fn impossible_bug_coverage_keys_from_diagnostics(d: NonEmptyDiagnostics) -> Outcome<List<ImpossibleBugCoverageKey>> {
  match append_impossible_bug_key_from_diagnostic(acc: Empty, diagnostic: d.head) {
    Accepted { value: acc, diagnostics: None } =>
      fold_diagnostic_tail_into_impossible_bug_keys(acc: acc, tail: d.tail)
    Rejected { diagnostics: rd } => Rejected { diagnostics: rd }
  }
}

fn append_coverage_slice_projection<C>(
  acc: Outcome<List<C>>,
  projection: CoverageSliceProjection<C>,
  eq: fn(C, C) -> Bool
) -> Outcome<List<C>> {
  bind_outcome(
    o: acc,
    f: fn(keys) {
      match projection {
        CoverageSliceNotApplicable =>
          outcome_accepted(value: keys)
        CoverageSlicePresent { key: key } =>
          outcome_accepted(value: dedupe_snoc(acc: keys, item: key, eq: eq))
        CoverageSliceInvalid { diagnostics: d } =>
          Rejected { diagnostics: d }
      }
    }
  )
}

fn l7_coverage_projection_from_claim(c: TestClaim) -> CoverageSliceProjection<L7CoverageKey> {
  match testgen_coverage_key_from_claim(c: c) {
    Rejected { diagnostics: d } =>
      if claim_is_outside_testgen_scheduled_anchor(c: c) {
        CoverageSliceNotApplicable
      } else {
        CoverageSliceInvalid { diagnostics: d }
      }
    Accepted { value: concept, diagnostics: None } =>
      match concept {
        AlgebraLaw { subject: subject } =>
          CoverageSlicePresent { key: subject }
        _ => CoverageSliceNotApplicable
      }
  }
}

fn l6_coverage_projection_from_claim(c: TestClaim) -> CoverageSliceProjection<L6CoverageKey> {
  match testgen_coverage_key_from_claim(c: c) {
    Rejected { diagnostics: d } =>
      if claim_is_outside_testgen_scheduled_anchor(c: c) {
        CoverageSliceNotApplicable
      } else {
        CoverageSliceInvalid { diagnostics: d }
      }
    Accepted { value: concept, diagnostics: None } =>
      match concept {
        TypeConstruction { subject: subject } =>
          CoverageSlicePresent {
            key: l6_coverage_key(
              subject: subject,
              language: ^dag_language_model_surface_id
            )
          }
        LanguageBehaviorEquivalence { subject: subject, mock: _ } =>
          CoverageSlicePresent {
            key: l6_coverage_key(subject: subject.subject, language: subject.language)
          }
        _ => CoverageSliceNotApplicable
      }
  }
}

fn testgen_coverage_projection_from_claim(
  c: TestClaim
) -> CoverageSliceProjection<TestgenCoverageKey> {
  match testgen_coverage_key_from_claim(c: c) {
    Accepted { value: key, diagnostics: None } =>
      CoverageSlicePresent { key: key }
    Rejected { diagnostics: d } =>
      if claim_is_outside_testgen_scheduled_anchor(c: c) {
        CoverageSliceNotApplicable
      } else {
        CoverageSliceInvalid { diagnostics: d }
      }
  }
}

// 🟡 gated — predicate-dissolution interim — feature:impossible-bug-reason-projection — bind gunbc#4759 — dissolve-on-arrival: impossible-bug slice gate reads canonical DiagnosticClaim reason membership from std/verification impossible_bug_class_from_diagnostic_reason when TestClaim carries ImpossibleBugClass directly; delete diagnostic_reason_is_canonical_impossible_bug and append_if_canonical_impossible_bug_diagnostic / non_empty_diagnostics_targets_impossible_bug_slice Bool wrappers in that same PR; forbidden: permanent lens-owned Outcome→Bool reason classifier outside impossible_bug_coverage_projection_from_claim.
fn diagnostic_reason_is_canonical_impossible_bug(reason: Symbol) -> Bool {
  match impossible_bug_class_from_diagnostic_reason(reason: reason) {
    Accepted { value: _, diagnostics: None } => true
    Rejected { diagnostics: _ } => false
  }
}

fn append_if_canonical_impossible_bug_diagnostic(
  found: Bool,
  diagnostic: Diagnostic
) -> Bool {
  if found {
    true
  } else {
    diagnostic_reason_is_canonical_impossible_bug(reason: diagnostic.reason)
  }
}

fn non_empty_diagnostics_targets_impossible_bug_slice(d: NonEmptyDiagnostics) -> Bool {
  fold_list(
    xs: d.tail,
    empty: diagnostic_reason_is_canonical_impossible_bug(reason: d.head.reason),
    cons: fn(found, diagnostic) {
      append_if_canonical_impossible_bug_diagnostic(
        found: found,
        diagnostic: diagnostic
      )
    }
  )
}

fn impossible_bug_coverage_projection_from_claim(
  c: TestClaim
) -> CoverageSliceProjection<ImpossibleBugCoverageKey> {
  match c {
    DiagnosticClaim { expected_rejection: d, label: _, anchor: _, input: _, classification: _ } =>
      if non_empty_diagnostics_targets_impossible_bug_slice(d: d) {
        match impossible_bug_coverage_keys_from_diagnostics(d: d) {
          Accepted { value: keys, diagnostics: None } =>
            match sole_impossible_bug_coverage_key(keys: keys) {
              Accepted { value: key, diagnostics: None } =>
                CoverageSlicePresent { key: key }
              Rejected { diagnostics: rd } =>
                CoverageSliceInvalid { diagnostics: rd }
            }
          Rejected { diagnostics: rd } =>
            CoverageSliceInvalid { diagnostics: rd }
        }
      } else {
        CoverageSliceNotApplicable
      }
    CompilesClaim { label: _, anchor: _, input: _, expected_value: _, classification: _ } =>
      CoverageSliceNotApplicable
    EqualsClaim { label: _, anchor: _, lhs: _, rhs: _, classification: _ } =>
      CoverageSliceNotApplicable
    StructuralEqualsClaim { label: _, anchor: _, lhs: _, rhs: _, classification: _ } =>
      CoverageSliceNotApplicable
    RoundTripClaim { label: _, anchor: _, input: _, classification: _ } =>
      CoverageSliceNotApplicable
  }
}

fn collect_l6_coverage_keys(corpus: List<TestClaim>) -> Outcome<List<L6CoverageKey>> {
  fold_list(
    xs: corpus,
    empty: outcome_accepted(value: Empty),
    cons: fn(o, claim) {
      append_coverage_slice_projection(
        acc: o,
        projection: l6_coverage_projection_from_claim(c: claim),
        eq: l6_coverage_key_eq
      )
    }
  )
}

fn collect_l7_coverage_keys(corpus: List<TestClaim>) -> Outcome<List<L7CoverageKey>> {
  fold_list(
    xs: corpus,
    empty: outcome_accepted(value: Empty),
    cons: fn(o, claim) {
      append_coverage_slice_projection(
        acc: o,
        projection: l7_coverage_projection_from_claim(c: claim),
        eq: l7_coverage_key_eq
      )
    }
  )
}

fn collect_impossible_bug_coverage_keys(
  corpus: List<TestClaim>
) -> Outcome<List<ImpossibleBugCoverageKey>> {
  fold_list(
    xs: corpus,
    empty: outcome_accepted(value: Empty),
    cons: fn(o, claim) {
      append_coverage_slice_projection(
        acc: o,
        projection: impossible_bug_coverage_projection_from_claim(c: claim),
        eq: impossible_bug_coverage_key_eq
      )
    }
  )
}

fn collect_testgen_coverage_keys(corpus: List<TestClaim>) -> Outcome<List<TestgenCoverageKey>> {
  fold_list(
    xs: corpus,
    empty: outcome_accepted(value: Empty),
    cons: fn(o, claim) {
      append_coverage_slice_projection(
        acc: o,
        projection: testgen_coverage_projection_from_claim(c: claim),
        eq: testgen_coverage_key_eq
      )
    }
  )
}

fn coverage_reading(corpus: List<TestClaim>) -> Outcome<CoverageReading> {
  bind_outcome(
    o: collect_l6_coverage_keys(corpus: corpus),
    f: fn(l6_actual) {
      bind_outcome(
        o: collect_l7_coverage_keys(corpus: corpus),
        f: fn(l7_actual) {
          bind_outcome(
            o: collect_impossible_bug_coverage_keys(corpus: corpus),
            f: fn(impossible_bug_actual) {
              bind_outcome(
                o: collect_testgen_coverage_keys(corpus: corpus),
                f: fn(testgen_actual) {
                  bind_outcome(
                    o: expected_testgen_coverage_keys(),
                    f: fn(testgen_expected) {
                      outcome_accepted(
                        value: CoverageReading {
                          l6_missing: missing_coverage(
                            expected: expected_l6_coverage_keys(),
                            actual: l6_actual,
                            eq: l6_coverage_key_eq
                          ),
                          l7_missing: missing_coverage(
                            expected: expected_l7_coverage_keys(),
                            actual: l7_actual,
                            eq: l7_coverage_key_eq
                          ),
                          impossible_bug_missing: missing_coverage(
                            expected: expected_impossible_bug_coverage_keys(),
                            actual: impossible_bug_actual,
                            eq: impossible_bug_coverage_key_eq
                          ),
                          testgen_missing: missing_coverage(
                            expected: testgen_expected,
                            actual: testgen_actual,
                            eq: testgen_coverage_key_eq
                          ),
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn coverage_reading_complete(r: CoverageReading) -> Bool {
  is_empty(xs: r.l6_missing) &&
    is_empty(xs: r.l7_missing) &&
    is_empty(xs: r.impossible_bug_missing) &&
    is_empty(xs: r.testgen_missing)
}

fn coverage_missing_diagnostic(reason: Symbol) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: Textual { file: ^coverage_virtual_file, extent: WholeFile },
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn append_coverage_missing_diagnostic(
  state: CoverageMissingDiagnosticsFold,
  reason: Symbol
) -> CoverageMissingDiagnosticsFold {
  match state {
    NoCoverageMissingDiagnostics =>
      SomeCoverageMissingDiagnostics {
        acc: diagnostics_singleton(d: coverage_missing_diagnostic(reason: reason))
      }
    SomeCoverageMissingDiagnostics { acc: acc } =>
      SomeCoverageMissingDiagnostics {
        acc: non_empty_diagnostics_append(
          a: acc,
          b: diagnostics_singleton(d: coverage_missing_diagnostic(reason: reason))
        )
      }
  }
}

fn coverage_missing_diagnostics_from_l6_missing(
  state: CoverageMissingDiagnosticsFold,
  missing: List<Coverage<L6CoverageKey>>
) -> CoverageMissingDiagnosticsFold {
  fold_list(
    xs: missing,
    empty: state,
    cons: fn(s, _entry) {
      append_coverage_missing_diagnostic(
        state: s,
        reason: ^coverage_reason_l6_missing
      )
    }
  )
}

fn coverage_missing_diagnostics_from_l7_missing(
  state: CoverageMissingDiagnosticsFold,
  missing: List<Coverage<L7CoverageKey>>
) -> CoverageMissingDiagnosticsFold {
  fold_list(
    xs: missing,
    empty: state,
    cons: fn(s, _entry) {
      append_coverage_missing_diagnostic(
        state: s,
        reason: ^coverage_reason_l7_missing
      )
    }
  )
}

fn coverage_missing_diagnostics_from_impossible_bug_missing(
  state: CoverageMissingDiagnosticsFold,
  missing: List<Coverage<ImpossibleBugCoverageKey>>
) -> CoverageMissingDiagnosticsFold {
  fold_list(
    xs: missing,
    empty: state,
    cons: fn(s, _entry) {
      append_coverage_missing_diagnostic(
        state: s,
        reason: ^coverage_reason_impossible_bug_missing
      )
    }
  )
}

fn coverage_missing_diagnostics_from_testgen_missing(
  state: CoverageMissingDiagnosticsFold,
  missing: List<Coverage<TestgenCoverageKey>>
) -> CoverageMissingDiagnosticsFold {
  fold_list(
    xs: missing,
    empty: state,
    cons: fn(s, _entry) {
      append_coverage_missing_diagnostic(
        state: s,
        reason: ^coverage_reason_testgen_missing
      )
    }
  )
}

fn coverage_missing_diagnostics(r: CoverageReading) -> NonEmptyDiagnostics {
  let folded = coverage_missing_diagnostics_from_testgen_missing(
    state: coverage_missing_diagnostics_from_impossible_bug_missing(
      state: coverage_missing_diagnostics_from_l7_missing(
        state: coverage_missing_diagnostics_from_l6_missing(
          state: NoCoverageMissingDiagnostics,
          missing: r.l6_missing
        ),
        missing: r.l7_missing
      ),
      missing: r.impossible_bug_missing
    ),
    missing: r.testgen_missing
  )
  match folded {
    NoCoverageMissingDiagnostics =>
      diagnostics_singleton(d: coverage_missing_diagnostic(reason: ^coverage_reason_incomplete))
    SomeCoverageMissingDiagnostics { acc: acc } => acc
  }
}

fn coverage_lens(corpus: List<TestClaim>) -> Outcome<CoverageReading> {
  bind_outcome(
    o: coverage_reading(corpus: corpus),
    f: fn(reading) {
      if coverage_reading_complete(r: reading) {
        outcome_accepted(value: reading)
      } else {
        Rejected { diagnostics: coverage_missing_diagnostics(r: reading) }
      }
    }
  )
}
