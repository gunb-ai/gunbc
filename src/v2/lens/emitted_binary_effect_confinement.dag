module v2.lens.emitted_binary_effect_confinement

import v2.lens.common.construction_justification { ConstructionJustification, WallNow }
import std.disposition { SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import v2.std.text { String }

data emitted_binary_effect_confinement_law: String = "Construction-time refusal gating which NEW witness families (neat-carp-312, Task 4) may build a real host-effecting HostTransportDescriptor for the emitted-native execution path. meta_exec_confinement.dag scans the .dag IMPORT GRAPH and has zero visibility into text baked into a generated Rust src/main.rs; this lens instead gates the .dag-level CONSTRUCTION SITE that builds that text, before any Rust is emitted. Refusal reuses the existing v2.std.host_transport.TargetEmitHostRuntimeRow sum type (HostRuntimeRowPresent | HostRuntimeRowAbsent) rather than inventing a second refusal carrier: a non-rostered family gets HostRuntimeRowAbsent, and configured_emit_host_runtime_row_from_target_row already fails closed on Absent with a typed, located diagnostic (emit_host_runtime_row_unconfigured_diagnostic) — no panic, no string-matching. Scope is deliberately narrow: only families landed under this lane are enrolled; the 9 pre-existing families (add, field_access, complement, match, loop, fold_closure, meet_join, variant_construct, classical_not_ingested) predate this wall and are out of this lane's remit — widening the roster to retrofit them is a separate, deliberate decision, not a side effect of this wall existing. No escape hatch: emitted_family_effect_admitted is a pure roster membership check with no override/bypass parameter."

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallNow {
    mechanism: SingleAuthority,
    authority: DeclarationRef { module_path: "v2.std.host_transport", decl_name: "emitted_effect_family_roster", field: WholeDeclaration }
  }
}
