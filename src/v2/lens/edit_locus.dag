// src/v2/lens/edit_locus.dag
// Scope: git diff name-only paths → substrate Node edit_locus for affected_set.
// Status: Wave-1 — file-level NodeArtifactProvenance is the modeled path→Node authority;
//   EditLocusRead/PathRegex remains as a compatibility shim until Q-Regex-Primitive.

module v2.lens.edit_locus

import v2.compiler.infer { InferredTree }
import v2.lens.affected_set { AffectedSetReading, affected_set_reading }
import v2.std.algebra { Cons, Empty, FreeMonoid, count_equal, fold_list, length, list_append }
import v2.std.artifact { NodeArtifactProvenance }
import v2.std.collection { List }
import v2.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  Unavailable,
  node_locus
}
import v2.std.exact_structural_equality_zip_fold_predicate {
  exact_structural_equality_zip_fold
}
import v2.std.node { Conj, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.text { String }
import v2.std.witness { Holds, Violates, Witness }


// RULING-1: 🟢 pretty-much-done — single repo-path carrier (String = Artifact.file_path authority).
// Git `name-only` paths and artifact provenance paths share `RepoPath`; no Symbol/String bridge.
type RepoPath = String

// RULING-1: 🟢 pretty-much-done — structural mirror of `git diff --name-only`.
type GitDiffNameOnly {
  changed_paths: List<RepoPath>
}

// RULING-1: 🟡 needs-more-work — path-regex pattern id until Q-Regex-Primitive.
// Match semantics live in EditLocusRead until regex substrate lands.
type PathRegex = Symbol

// RULING-1: 🟢 pretty-much-done — canonical Wave-0 authority: path-regex pattern → edit_locus Node.
type EditLocusBinding {
  pattern: PathRegex
  locus: Node
}

// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) —
// feature: Q-Regex-Primitive — bind: gunbc#3560 — dissolve-on-arrival: replace
// injected `path_regex_matches` with substrate regex primitive; forbidden: hand-maintained
// path-regex in workflow YAML (Gate #103).
type EditLocusRead {
  path_regex_matches: fn(RepoPath, PathRegex) -> Bool
}
fn edit_locus_no_match_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^edit_locus_reason_no_match,
    at: node_locus(node: Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn edit_locus_ambiguous_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^edit_locus_reason_ambiguous,
    at: node_locus(node: Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


// occurrence_id is excluded from structural equality (design-node-identity-channels.md).
// Deep canonical compare — parity with source_authority.dag source_authority_node_equal —
// so loci dedup is not split by minted ids at any depth.
fn node_eq(left: Node, right: Node) -> Bool {
  exact_structural_equality_zip_fold(source_facts: left, candidate: right)
}


fn push_locus_if_absent(acc: FreeMonoid<Node>, locus: Node) -> FreeMonoid<Node> {
  if count_equal(xs: acc, item: locus, eq: node_eq) == 0 {
    list_append(left: acc, right: Cons { head: locus, tail: Empty })
  } else {
    acc
  }
}


fn loci_from_bindings_for_path(
  read: EditLocusRead,
  changed: RepoPath,
  bindings: FreeMonoid<EditLocusBinding>,
  acc: FreeMonoid<Node>
) -> FreeMonoid<Node> {
  match bindings {
    Empty => acc
    Cons { head: binding, tail: rest } =>
      let acc2 = if read.path_regex_matches(changed: changed, pattern: binding.pattern) {
        push_locus_if_absent(acc: acc, locus: binding.locus)
      } else {
        acc
      }
      loci_from_bindings_for_path(
        read: read,
        changed: changed,
        bindings: rest,
        acc: acc2
      )
  }
}


fn loci_from_provenance_for_path(
  changed: RepoPath,
  provenance: FreeMonoid<NodeArtifactProvenance>,
  acc: FreeMonoid<Node>
) -> FreeMonoid<Node> {
  fold_list(
    xs: provenance,
    empty: acc,
    cons: fn(loci, p) {
      if p.artifact.file_path == changed {
        push_locus_if_absent(acc: loci, locus: p.node)
      } else {
        loci
      }
    }
  )
}


fn collect_edit_loci(
  read: EditLocusRead,
  git_diff: GitDiffNameOnly,
  bindings: FreeMonoid<EditLocusBinding>
) -> FreeMonoid<Node> {
  collect_edit_loci_on_paths(
    read: read,
    changed_paths: git_diff.changed_paths,
    bindings: bindings,
    acc: Empty
  )
}


fn collect_edit_loci_from_provenance(
  git_diff: GitDiffNameOnly,
  provenance: FreeMonoid<NodeArtifactProvenance>
) -> FreeMonoid<Node> {
  collect_edit_loci_from_provenance_on_paths(
    changed_paths: git_diff.changed_paths,
    provenance: provenance,
    acc: Empty
  )
}


fn collect_edit_loci_on_paths(
  read: EditLocusRead,
  changed_paths: FreeMonoid<RepoPath>,
  bindings: FreeMonoid<EditLocusBinding>,
  acc: FreeMonoid<Node>
) -> FreeMonoid<Node> {
  match changed_paths {
    Empty => acc
    Cons { head: changed, tail: rest } =>
      let with_bindings = loci_from_bindings_for_path(
        read: read,
        changed: changed,
        bindings: bindings,
        acc: acc
      )
      collect_edit_loci_on_paths(
        read: read,
        changed_paths: rest,
        bindings: bindings,
        acc: with_bindings
      )
  }
}


fn collect_edit_loci_from_provenance_on_paths(
  changed_paths: FreeMonoid<RepoPath>,
  provenance: FreeMonoid<NodeArtifactProvenance>,
  acc: FreeMonoid<Node>
) -> FreeMonoid<Node> {
  fold_list(
    xs: changed_paths,
    empty: acc,
    cons: fn(loci, changed) {
      loci_from_provenance_for_path(
        changed: changed,
        provenance: provenance,
        acc: loci
      )
    }
  )
}


fn resolve_edit_locus_from_loci(loci: FreeMonoid<Node>) -> Witness<Node> {
  match length(xs: loci) {
    0 =>
      Violates { diagnostic: edit_locus_no_match_diagnostic() }
    1 =>
      match loci {
        Cons { head: head, tail: _ } =>
          Holds { value: head }
        Empty =>
          Violates { diagnostic: edit_locus_no_match_diagnostic() }
      }
    _ =>
      Violates { diagnostic: edit_locus_ambiguous_diagnostic() }
  }
}


fn resolve_edit_locus(
  read: EditLocusRead,
  git_diff: GitDiffNameOnly,
  bindings: FreeMonoid<EditLocusBinding>
) -> Witness<Node> {
  resolve_edit_locus_from_loci(
    loci: collect_edit_loci(
      read: read,
      git_diff: git_diff,
      bindings: bindings
    )
  )
}


fn resolve_edit_locus_from_provenance(
  git_diff: GitDiffNameOnly,
  provenance: FreeMonoid<NodeArtifactProvenance>
) -> Witness<Node> {
  resolve_edit_locus_from_loci(
    loci: collect_edit_loci_from_provenance(
      git_diff: git_diff,
      provenance: provenance
    )
  )
}


fn affected_set_reading_from_git_diff(
  edit_read: EditLocusRead,
  graph: InferredTree,
  git_diff: GitDiffNameOnly,
  bindings: FreeMonoid<EditLocusBinding>
) -> Witness<AffectedSetReading> {
  match resolve_edit_locus(
    read: edit_read,
    git_diff: git_diff,
    bindings: bindings
  ) {
    Holds { value: locus } =>
      Holds { value: affected_set_reading(graph: graph, edit_locus: locus) }
    Violates { diagnostic: d } =>
      Violates { diagnostic: d }
  }
}


fn affected_set_reading_from_git_diff_provenance(
  graph: InferredTree,
  git_diff: GitDiffNameOnly,
  provenance: FreeMonoid<NodeArtifactProvenance>
) -> Witness<AffectedSetReading> {
  match resolve_edit_locus_from_provenance(
    git_diff: git_diff,
    provenance: provenance
  ) {
    Holds { value: locus } =>
      Holds { value: affected_set_reading(graph: graph, edit_locus: locus) }
    Violates { diagnostic: d } =>
      Violates { diagnostic: d }
  }
}
