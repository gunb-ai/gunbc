module v2.lens.intent_linearity
import v2.lens.common.construction_justification { ConstructionJustification, ConstructionClass, WallNow, WallAfterGrounding, RatchetForever }
import std.disposition { SingleAuthority }
import v2.lens.simulated_relationship { chain_is_simulated }
import v2.lens.structural_similarity { type_decls_anti_unify }
import v2.lens.complexity_lowering { cost_is_lowerable }
import v2.lens.cost { symbolic_cost_of_node }
import v2.lens.module_graph { import_closure_live }
import v2.std.node { Node, Symbol }
import v2.std.algebra { FreeMonoid, length, any, for_all, contains }
import v2.std.collection { List }
import v2.std.text { String }
import v2.std.logic { Bool }

type CostAxis = ChangeTime | RunTime

type Representation = TermChain | TypeForest | ImportGraph

type LinearityRule {
  name: Symbol
  axis: CostAxis
  representation: Representation
  detect: fn(FreeMonoid<Node>) -> Bool
}

fn unroll_to_fold_rule() -> LinearityRule {
  LinearityRule {
    name: ^unroll_to_fold,
    axis: ChangeTime,
    representation: TermChain,
    detect: fn(s) { chain_is_simulated(steps: s) }
  }
}

fn chain_has_lowerable_cost(steps: FreeMonoid<Node>) -> Bool {
  any(xs: steps, predicate: fn(n) { cost_is_lowerable(c: symbolic_cost_of_node(n: n)) })
}

fn complexity_reducible_rule() -> LinearityRule {
  LinearityRule {
    name: ^complexity_reducible,
    axis: RunTime,
    representation: TermChain,
    detect: fn(s) { chain_has_lowerable_cost(steps: s) }
  }
}

fn dup_type_to_generic_rule() -> LinearityRule {
  LinearityRule {
    name: ^dup_type_to_generic,
    axis: ChangeTime,
    representation: TypeForest,
    detect: fn(s) { type_decls_anti_unify(decls: s) }
  }
}

fn linearity_registry() -> FreeMonoid<LinearityRule> {
  [ unroll_to_fold_rule(), complexity_reducible_rule(), dup_type_to_generic_rule() ]
}

type ParallelRepresentationRule {
  name: Symbol
  axis: CostAxis
  representation: Representation
  class: ConstructionClass
  derive: fn(String, List<String>) -> FreeMonoid<String>
}

fn import_graph_rule() -> ParallelRepresentationRule {
  ParallelRepresentationRule {
    name: ^consumed_input_closure,
    axis: ChangeTime,
    representation: ImportGraph,
    class: WallNow { construction: "v2.lens.module_graph.import_closure_live" },
    derive: fn(entry, roots) { import_closure_live(entry_path: entry, pool_roots: roots) }
  }
}

fn parallel_representation_registry() -> FreeMonoid<ParallelRepresentationRule> {
  [ import_graph_rule() ]
}

fn string_eq(a: String, b: String) -> Bool {
  a == b
}

fn list_is_subset(xs: FreeMonoid<String>, ys: FreeMonoid<String>) -> Bool {
  for_all(xs: xs, predicate: fn(x) { contains(xs: ys, item: x, eq: string_eq) })
}

fn closures_match(declared: FreeMonoid<String>, derived: FreeMonoid<String>) -> Bool {
  list_is_subset(xs: declared, ys: derived) && list_is_subset(xs: derived, ys: declared)
}

fn closure_drift(declared: FreeMonoid<String>, derived: FreeMonoid<String>) -> Bool {
  !closures_match(declared: declared, derived: derived)
}

fn closure_is_clean(
  rule: ParallelRepresentationRule,
  declared: FreeMonoid<String>,
  derived: FreeMonoid<String>
) -> Bool {
  match rule.class {
    WallNow { construction: _ } => !closure_drift(declared: declared, derived: derived)
    WallAfterGrounding { dissolves_to: _ } => true
    RatchetForever { undecidable_because: _ } => true
  }
}

fn closure_is_clean_for_representation(
  rep: Representation,
  declared: FreeMonoid<String>,
  derived: FreeMonoid<String>
) -> Bool {
  for_all(
    xs: parallel_representation_registry(),
    predicate: fn(rule) {
      if representation_eq(a: rule.representation, b: rep) {
        closure_is_clean(rule: rule, declared: declared, derived: derived)
      } else {
        true
      }
    }
  )
}

fn import_closure_is_clean_live(
  declared: FreeMonoid<String>,
  entry_path: String,
  pool_roots: List<String>
) -> Bool {
  for_all(
    xs: parallel_representation_registry(),
    predicate: fn(rule) {
      if representation_eq(a: rule.representation, b: ImportGraph) {
        closure_is_clean(
          rule: rule,
          declared: declared,
          derived: rule.derive(entry_path, pool_roots)
        )
      } else {
        true
      }
    }
  )
}

fn rule_fires(rule: LinearityRule, steps: FreeMonoid<Node>) -> Bool {
  rule.detect(steps)
}

fn cost_axis_equal(a: CostAxis, b: CostAxis) -> Bool {
  match a {
    ChangeTime => match b { ChangeTime => true RunTime => false }
    RunTime => match b { ChangeTime => false RunTime => true }
  }
}

fn representation_eq(a: Representation, b: Representation) -> Bool {
  match a {
    TermChain => match b { TermChain => true  TypeForest => false ImportGraph => false }
    TypeForest => match b { TermChain => false TypeForest => true  ImportGraph => false }
    ImportGraph => match b { TermChain => false TypeForest => false ImportGraph => true }
  }
}

fn input_fires(axis: CostAxis, rep: Representation, input: FreeMonoid<Node>) -> Bool {
  any(
    xs: linearity_registry(),
    predicate: fn(rule) {
      cost_axis_equal(a: rule.axis, b: axis)
        && representation_eq(a: rule.representation, b: rep)
        && rule_fires(rule: rule, steps: input)
    }
  )
}

fn chain_is_redundant(steps: FreeMonoid<Node>) -> Bool {
  input_fires(axis: ChangeTime, rep: TermChain, input: steps)
}

fn forest_is_redundant(decls: FreeMonoid<Node>) -> Bool {
  input_fires(axis: ChangeTime, rep: TypeForest, input: decls)
}

fn chain_has_runtime_lowering_candidate(steps: FreeMonoid<Node>) -> Bool {
  input_fires(axis: RunTime, rep: TermChain, input: steps)
}

fn chain_residual(steps: FreeMonoid<Node>) -> Int {
  if chain_is_redundant(steps: steps) {
    length(xs: steps) - 1
  } else {
    0
  }
}

fn level_is_linear(level: FreeMonoid<Node>) -> Bool {
  !chain_is_redundant(steps: level)
}

fn body_is_linear(levels: FreeMonoid<FreeMonoid<Node>>) -> Bool {
  for_all(xs: levels, predicate: fn(level) { level_is_linear(level: level) })
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SingleAuthority },
  rationale: "Intent-linearity is a wall up to the substrate's expressible abstraction (anti-unification computes the structural minimum) and a ratchet beyond it (global minimal description is Kolmogorov-uncomputable). One engine, N rows, two tag-axes (§2-horizontal): Representation tags each row's binder (term-chain vs type-forest) so the rows stay off each other's projection; CostAxis tags each row's §5 status. The two compose DIFFERENTLY by §5: chain_is_redundant / forest_is_redundant fold only the ChangeTime rows -- a SOUND wall (anti-unification proves redundancy, no false positive), so level_is_linear / body_is_linear never call a genuine program redundant. The RunTime axis is a CANDIDATE detector (chain_has_runtime_lowering_candidate): O(n^2) class is the decidable NECESSARY condition, but sufficiency (genuine reducibility, not a real all-pairs O(n^2)) waits on the independence carrier, so it must not feed the wall. complexity.dag keeps the RatchetForever optimality residue. Grounding authority: the parse/resolve walk + chain projector decomposing a body into its per-level statement-chains (shared with v2.lens.simulated_relationship / v2.lens.structural_similarity, all over the v2.std.anti_unification kernel). Dissolves on: body_is_linear runs over live dsl bodies once the walk projects per-level chains; the registry grows by rows -- Row 1 the term-chain hand-unrolled fold (ChangeTime/TermChain), Row 2 the type-decl duplicate-to-generic (ChangeTime/TypeForest), Row 3 the complexity cost-recurrence (RunTime/TermChain, see v2.lens.complexity_lowering); until then this is a lens_unit over projected synthetic chains. The RunTime axis is read via chain_has_runtime_lowering_candidate -- NOT chain_is_redundant -- and graduates from candidate to a redundancy claim only when the independence carrier grounds sufficiency. THIRD REPRESENTATION (ImportGraph, the parallel-representation family): the same intent-linearity measure (redundancy = declared-description - minimal-description) applied where the minimal form is NOT an anti-unification search but a function the tree ALREADY calls -- the transitive import-graph closure. A ConsumedInputClosure (dsl/tools/rust_stage0_gates.dag) hand-declares a List<Path> the compiler also derives by walking imports; redundancy > 0 exactly when declared != derived, and the wall is declared == derived. Unlike the term/type-chain rows this engine is a PAIR per representation -- a derived-side walk (named in the WallNow payload) + a verdict payload (a ConstructionClass, NOT a bare Bool, so an honestly-marked shrinking scaffold is classified, never falsely failed): closure_is_clean dispatches on the rule's class -- WallNow drift is a hard violation, WallAfterGrounding/RatchetForever drift is tracked, not failed. import_graph_rule carries class WallNow with construction = the String resolve_imports_transitively (decidable, on-hand, no expressibility frontier). BOUNDED SMELL (acknowledged, not widened this lane): WallNow.construction naming a fn as a String is a provenance POINTER, not a second authority -- the REAL derivation runs in the Rust oracle; do not let the String read as the source of truth (carrier-widening to a typed decl-ref is downstream, per the scope fence). The seam extends to the siblings by swapping the walk-plus-payload pair: Axis-2 LayerDAG (the v2 layer-roots roster) is another WallNow row AND is upstream of Axis-1 -- ImportGraph's derived side walks FROM those roots, so the axes form a small stack, not 3 peers; Axis-3 ViolationSet (exception rosters) supplies the WallAfterGrounding rows naming their shrink arcs. DISCRIMINATING WITNESS for the live wall: the Rust drift oracle consumed_input_closure_drift_test.rs asserts derived == declared over the live corpus and goes RED when a declared path is dropped/added (proven by execution, #5669); it is self-protecting -- the entry is in its own declared closure, so adding a .dag import trips should_run_gates edge-(b) closure-hit, fires the rust gate, and the new import surfaces as under-declared drift. DISSOLUTION TRIGGER (Tier-2) -- LANDED: the import-graph transitive walk is now grounded .dag-callable through the host-read seam -- module_declaration_facts (the builtin) + import_resolution_facts feed the fixpoint fold v2.lens.module_graph.import_closure_live (steps 1+2, #5675). So the row is LIVE: WallNow.construction has promoted from the named String resolve_imports_transitively to a live walk fn FIELD (import_graph_rule.derive = v2.lens.module_graph.import_closure_live, with the construction String now naming that live fn as a provenance pointer), and import_closure_is_clean_live reads derived from that live in-.dag walk -- it is the SOLE tree-level authority. The host-projected ClosureFact.derived carrier and the old import_closure_is_clean(fact) predicate are DISSOLVED (the stored derived field was the redundant second authority the promotion removes, and a writable host-fact carrier is the fail-open #5: gone). What remains is one pure dispatch kernel closure_is_clean(rule, declared, derived) -- a single engine over two path-lists, derived flowing in ONLY from import_closure_is_clean_live's live walk (real trees) or from test literals (the lens_unit class-dispatch seam, exercising WallNow-vs-WallAfterGrounding without a live tree). A future live caller cannot reintroduce the fail-open: there is no derived carrier and no fact-taking is-clean entry, so checking a real tree means calling _live, which derives. The in-.dag discriminating witness is import_graph_live_test (the lens predicate over the real conformance entry: derived live == declared rust_stage0_gates closure, drift in either direction goes RED by execution); the Rust oracle consumed_input_closure_drift_test.rs remains a cross-tree redundant live-corpus check. STILL SEPARATE (not this lane): migrating the rust_stage0_gates declared values to graph queries; widening WallNow.construction from a String to a typed decl-ref (the bounded smell above -- the live fn now carried in the derive field already supersedes the String as the authority)"
}
