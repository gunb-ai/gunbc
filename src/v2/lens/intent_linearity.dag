module v2.lens.intent_linearity
import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }
import v2.lens.simulated_relationship { chain_is_simulated }
import v2.lens.complexity_rewrite { cost_is_rewritable }
import v2.lens.cost { symbolic_cost_of_node }
import v2.std.node { Node, Symbol }
import v2.std.algebra { FreeMonoid, any, length, fold_list }
import v2.std.logic { Bool }

// Intent-linearity enforcer: a program's description should equal its irreducible information content
// (minimal template + distinct data), recursively at every level -- intent 1:1 with its inputs. This is
// the registry the redundancy lenses become ROWS of (so the enforcer is itself linear: one engine, N
// rows, not a fork). Row 1 = the hand-unrolled fold (change-time); Row 2 = the complexity cost-recurrence
// catalog (run-time, v2.lens.complexity_rewrite) -- two axes, one engine.

// The §1 time-axis a rule's minimal form reduces (change-time = §2 maintenance; run-time = §1 cost).
type CostAxis = ChangeTime | RunTime

type LinearityRule {
  name: Symbol
  axis: CostAxis
  detect: fn(FreeMonoid<Node>) -> Bool
}

// Row 1 — the hand-unrolled fold (change-time). detect reuses simulated_relationship; minimal form = one
// fold over the data the chain spells out by hand.
fn unroll_to_fold_rule() -> LinearityRule {
  LinearityRule {
    name: ^unroll_to_fold,
    axis: ChangeTime,
    detect: fn(s) { chain_is_simulated(steps: s) }
  }
}

// Row 2 — complexity-reducible (run-time). detect computes each statement's runtime cost (cost.dag's
// fold_node over the AST) and fires when SOME statement's cost is reducible by a catalogued rewrite
// (the §5 'O(n^2)->O(n)' rewrites) -- the run-time twin of Row 1: a chain whose cost recurrence is not
// at its decidable minimum. Same engine, second axis (RunTime); minimal form = the lowered class.
fn chain_has_rewritable_cost(steps: FreeMonoid<Node>) -> Bool {
  any(xs: steps, predicate: fn(n) { cost_is_rewritable(c: symbolic_cost_of_node(n: n)) })
}

fn complexity_reducible_rule() -> LinearityRule {
  LinearityRule {
    name: ^complexity_reducible,
    axis: RunTime,
    detect: fn(s) { chain_has_rewritable_cost(steps: s) }
  }
}

fn linearity_registry() -> FreeMonoid<LinearityRule> {
  [ unroll_to_fold_rule(), complexity_reducible_rule() ]
}

// typed projector (avoids field access on a fold lambda element)
fn rule_fires(rule: LinearityRule, steps: FreeMonoid<Node>) -> Bool {
  rule.detect(steps)
}

// Is this chain non-linear at this level -- does ANY registry rule fire?
fn chain_is_redundant(steps: FreeMonoid<Node>) -> Bool {
  fold_list(
    xs: linearity_registry(),
    empty: false,
    cons: fn(acc, rule) { acc || rule_fires(rule: rule, steps: steps) }
  )
}

// Residual redundancy: a flagged chain of N statements collapses to 1 fold over N data, so it carries
// (N - 1) redundant hand-copies -- the O(n)->O(1) saving the minimal form realizes; 0 if already minimal.
fn chain_residual(steps: FreeMonoid<Node>) -> Int {
  if chain_is_redundant(steps: steps) {
    length(xs: steps) - 1
  } else {
    0
  }
}

fn level_is_linear(level: FreeMonoid<Node>) -> Bool {
  !chain_is_redundant(steps: level)
}

// FRACTAL fixed point: a body is its statement-chains at each nesting level (produced by the parse/
// resolve walk + chain projector; taken here as input). It is 1:1 / LINEAR iff NO level is redundant --
// every level is already at its minimal form (every hole bottomed out at an atom).
fn body_is_linear(levels: FreeMonoid<FreeMonoid<Node>>) -> Bool {
  fold_list(
    xs: levels,
    empty: true,
    cons: fn(acc, level) { acc && level_is_linear(level: level) }
  )
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding {
    grounding_authority: "the parse/resolve walk + chain projector decomposing a body into its per-level statement-chains (shared with v2.lens.simulated_relationship / v2.lens.structural_similarity)",
    dissolve_on: "body_is_linear runs over live dsl/** bodies once the walk projects per-level chains; the registry grows by rows (the RunTime-axis complexity cost-recurrence row landed alongside the change-time row -- see v2.lens.complexity_rewrite); until then this is a lens_unit over projected synthetic chains"
  },
  rationale: "Intent-linearity is a wall up to the substrate's expressible abstraction (anti-unification computes the structural minimum) and a ratchet beyond it (global minimal description is Kolmogorov-uncomputable). The registry is the decidable wall-half; complexity.dag keeps the RatchetForever optimality residue. One engine, N rows (§2-horizontal)."
}
