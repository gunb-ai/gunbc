type CostAxis = ChangeTime | RunTime

// The BINDER: which representation the engine's anti-unification kernel walks for this row. The two
// binders share one `congruent` engine but project different inputs -- a body's statement chain (the
// fold's hole is a list element) vs a module's type-declaration forest (the hole is a type parameter).
type Representation = TermChain | TypeForest

type LinearityRule {
  name: Symbol
  axis: CostAxis
  representation: Representation
  detect: fn(FreeMonoid<Node>) -> Bool
}

