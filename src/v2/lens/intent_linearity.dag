// Row 1 — the hand-unrolled fold (term chain, change-time). detect reuses simulated_relationship;
// minimal form = one fold over the data the chain spells out by hand.
=======
>>>>>>> origin/main
fn unroll_to_fold_rule() -> LinearityRule {
  LinearityRule {
    name: ^unroll_to_fold,
    axis: ChangeTime,
    representation: TermChain,
    detect: fn(s) { chain_is_simulated(steps: s) }
  }
}

// Row 2 — duplicate TYPE declarations (type forest, change-time). detect reuses structural_similarity's
// type-decl binder over the same `congruent` kernel; minimal form = one generic over the leaf that varies
// across the congruent family (the §3 nickname / `Int8`..`Int128` collapse to one `Compose` axis).
fn dup_type_to_generic_rule() -> LinearityRule {
  LinearityRule {
    name: ^dup_type_to_generic,
    axis: ChangeTime,
    representation: TypeForest,
    detect: fn(s) { type_decls_anti_unify(decls: s) }
  }
}

fn linearity_registry() -> FreeMonoid<LinearityRule> {
  [ unroll_to_fold_rule(), dup_type_to_generic_rule() ]
}

fn representation_eq(a: Representation, b: Representation) -> Bool {
  match a {
    TermChain => match b { TermChain => true  _ => false }
    TypeForest => match b { TypeForest => true _ => false }
  }
}

fn rule_fires(rule: LinearityRule, steps: FreeMonoid<Node>) -> Bool {
  rule.detect(steps)
}

