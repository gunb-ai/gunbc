// src/v2/lens/shell_program_reducibility.dag
// Scope: inline-shell reducibility guard — DESIGN.md §2 (deep decompose) + §3 (transport
//   is a Realization handler, not a fact). Peer to v2.lens.extdeps_shape_transport_policy,
//   but at the CALL SITE: a `shell.Exec.Run(script: <program>)` is a whole shell program
//   fused into one String — reducible to modeled `shell.*` ops (parameterized argv) + the
//   dag control flow + their composition. The decomposed form already exists next door:
//   `shell.Find/Env/Which` carry `transport shell { argv: [...] }` (decomposed tokens,
//   typed exit), where `Exec.Run(script:)` is the un-decomposed escape hatch.
//
// This is the first `reducible?` verdict GRADUATED out of the LLM seat into a pure
//   structural lens: for inline shell the judgment is mechanical, so it is a §6 lens, not
//   an LLM call. ReduceVerdict mirrors the ctrl `reducible?` oracle (Reduced | Irreducible
//   | Unknown), fail-closed: an unresolved (non-literal) script argument is Unknown -> red.
//
// Status: 🟡 M1 — lens-unit layer over synthetic ShellInvocationFact rows (pure, structural,
//   discriminating). Dissolve-on: Node-tree projection over live `dsl/tools/*_transport.dag`
//   (resolve `let script = "..."` -> literal) supersedes the synthetic shape, exactly as
//   extdeps_shape_transport_policy's M2 parse bridge superseded its synthetic argv rows.
//   NOT a `filesystem_read` text scan (that is grep, not a lens; see #5135 rejection).
// Consumer: claim_batch discovery over src/v2/compiler/shell_program_reducibility.

module v2.lens.shell_program_reducibility

import v2.std.algebra {
  fold_list,
  length,
  list_snoc_item
}
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }

// The reducibility verdict — same closed sum as the ctrl `reducible?` oracle carrier.
type ShellReduceVerdict
  = Reduced { parts: Int }
  | Irreducible { witness: String }
  | Unknown { missing: String }

// The command a shell invocation carries. ModeledArgv is the decomposed (good) form;
// FusedScript is a whole program in one String; Unresolved is a non-literal argument the
// lens could not project to a literal (corpus phase) — fail-closed.
type ShellCommandShape
  = ModeledArgv { token_count: Int }
  | FusedScript { program: String }
  | Unresolved { reason: String }

type ShellInvocationFact {
  path: String
  caller: String
  shape: ShellCommandShape
}

type ShellReducibilityViolation
  = InlineShellProgramReducible {
      path: String
      caller: String
      parts: Int
    }
  | UnresolvedShellArgument {
      path: String
      caller: String
      reason: String
    }

data empty_shell_reducibility_violations: List<ShellReducibilityViolation> = []
data empty_shell_invocation_facts: List<ShellInvocationFact> = []
data empty_shell_marker_list: List<String> = []

// Program-structure markers: each present marker is one fused construct that has a modeled
// home — `\n`/`;`/`&&`/`|` are sequencing (dag let-binding / `&&`), `if ` is control flow
// (dag `if`/`match`), `$(` is command substitution (a nested modeled op), `<<` is a heredoc
// (a modeled Filesystem.Write). A script with zero markers is a single bare command — the
// minimal escape-hatch boundary, left Irreducible at this tier.
data shell_program_structure_markers: List<String> = [
  "\n",
  "&&",
  ";",
  "|",
  "if ",
  "$(",
  "<<"
]

fn shell_script_construct_count(program: String) -> Int {
  length(
    xs: fold_list(
      xs: shell_program_structure_markers,
      empty: empty_shell_marker_list,
      cons: fn(acc, marker) {
        if string_contains(program, marker) {
          list_snoc_item(xs: acc, item: marker)
        } else {
          acc
        }
      }
    )
  )
}

// reducible?(shape) — the mechanical inline-shell judgment.
fn shell_shape_reduce_verdict(shape: ShellCommandShape) -> ShellReduceVerdict {
  match shape {
    ModeledArgv { token_count: _ } => Irreducible { witness: "decomposed argv" }
    Unresolved { reason: r } => Unknown { missing: r }
    FusedScript { program: p } =>
      if shell_script_construct_count(program: p) == 0 {
        Irreducible { witness: "single bare command" }
      } else {
        Reduced { parts: shell_script_construct_count(program: p) }
      }
  }
}

fn shell_invocation_violation(
  fact: ShellInvocationFact
) -> List<ShellReducibilityViolation> {
  match shell_shape_reduce_verdict(shape: fact.shape) {
    Irreducible { witness: _ } => empty_shell_reducibility_violations
    Reduced { parts: n } => [
      InlineShellProgramReducible {
        path: fact.path,
        caller: fact.caller,
        parts: n
      }
    ]
    Unknown { missing: m } => [
      UnresolvedShellArgument {
        path: fact.path,
        caller: fact.caller,
        reason: m
      }
    ]
  }
}

fn scan_shell_invocation_facts(
  facts: List<ShellInvocationFact>
) -> List<ShellReducibilityViolation> {
  fold_list(
    xs: facts,
    empty: empty_shell_reducibility_violations,
    cons: fn(acc, fact) {
      fold_list(
        xs: shell_invocation_violation(fact: fact),
        empty: acc,
        cons: fn(inner, v) { list_snoc_item(xs: inner, item: v) }
      )
    }
  )
}

fn shell_program_reducibility_violation_count(
  facts: List<ShellInvocationFact>
) -> Int {
  length(xs: scan_shell_invocation_facts(facts: facts))
}

fn shell_program_reducibility_clean_holds(
  facts: List<ShellInvocationFact>
) -> Bool {
  shell_program_reducibility_violation_count(facts: facts) == 0
}
