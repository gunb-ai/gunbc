module v2.lens.disposition_redundancy



fn decl_field_eq(a: DeclField, b: DeclField) -> Bool {
  match a {
    WholeDeclaration =>
      match b {
        WholeDeclaration => true
        NamedField { field_name: _ } => false
      }
    NamedField { field_name: an } =>
      match b {
        NamedField { field_name: bn } => an == bn
        WholeDeclaration => false
      }
  }
}

fn decl_ref_eq(a: DeclarationRef, b: DeclarationRef) -> Bool {
  a.module_path == b.module_path
    && a.decl_name == b.decl_name
    && decl_field_eq(a: a.field, b: b.field)
}

fn disposition_binds_present(d: Disposition, present: List<DeclarationRef>) -> Bool {
  match d {
    Scaffold { dissolves_to: _, bind } =>
      any(xs: present, predicate: fn(p) { decl_ref_eq(a: p, b: bind) })
    Terminal { reason: _ } => false
  }
}

fn disposition_redundancy_violation_count(dispositions: List<Disposition>, present: List<DeclarationRef>) -> Int {
  count_where(xs: dispositions, predicate: fn(d) { disposition_binds_present(d: d, present: present) })
}

fn disposition_is_terminal(d: Disposition) -> Bool {
  match d {
    Terminal { reason: _ } => true
    Scaffold { dissolves_to: _, bind: _ } => false
  }
}

fn terminal_count(dispositions: List<Disposition>) -> Int {
  count_where(xs: dispositions, predicate: fn(d) { disposition_is_terminal(d: d) })
}

fn construction_mechanism_is_single_authority(m: ConstructionMechanism) -> Bool {
  match m {
    SingleAuthority => true
    RealizationDispatch => false
    SubstrateMandatoryTag => false
  }
}

fn disposition_dissolves_to_single_authority(d: Disposition) -> Bool {
  match d {
    Scaffold { dissolves_to: mechanism, bind: _ } =>
      construction_mechanism_is_single_authority(m: mechanism)
    Terminal { reason: _ } => false
  }
}

data disposition_predicate_contract: Disposition = Terminal {
  reason: "Structural coproduct readers over Disposition, ConstructionMechanism and DeclField (disposition_is_terminal, disposition_dissolves_to_single_authority, construction_mechanism_is_single_authority, disposition_binds_present, decl_field_eq, decl_ref_eq) — closed by the declared std.disposition variants, not interim scaffolds. This module is the SINGLE reader surface for the Disposition sum: a scaffold witness asserts its shape by consuming these, never by re-matching the coproduct at the witness site (the predicate/walker dissolution rule). Discriminating corpus: src/v2/lens/disposition_redundancy_test.dag (violation/terminal counts) and dag/test/claim/cli_run_floor_lens_oracle_witness_test.dag, whose scaffold-shape cells red when a bound declaration's disposition stops dissolving to SingleAuthority."
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SubstrateMandatoryTag }
}
