module v2.test.lens_inert_carrier.inert_carrier_test

import v2.std.logic { Bool }
import v2.std.collection { List }
import v2.std.text { String }
import v2.lens.inert_carrier {
  inert_carrier_clean_holds,
  inert_carrier_live_declared_count,
  count_not_in_roster,
  count_stale_roster,
  empty_inert_carrier_names,
  inert_carrier_names_live,
  inert_carrier_rostered_names,
  inert_carrier_live_unrostered_count,
  inert_carrier_live_stale_roster_count
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data roster_one: List<String> = ["KnownEntry"]
data names_with_unknown: List<String> = ["UnknownEntry"]

test fn inert_carrier_no_unrostered_or_stale() -> Bool {
  return inert_carrier_clean_holds()
}

test fn inert_carrier_universe_is_nonempty() -> Bool {
  return inert_carrier_live_declared_count() > 0
}

test fn count_not_in_roster_detects_unrostered() -> Bool {
  return count_not_in_roster(names: names_with_unknown, roster: roster_one) == 1
}

test fn count_stale_roster_detects_stale_entry() -> Bool {
  return count_stale_roster(roster: roster_one, inert_names: empty_inert_carrier_names) == 1
}

fn probe_inert_delta() -> String {
  let live = inert_carrier_names_live()
  let roster = inert_carrier_rostered_names()
  join([
    "unrostered=", to_string(inert_carrier_live_unrostered_count()),
    " stale=", to_string(inert_carrier_live_stale_roster_count()),
    " LIVE=[", join(live, ","), "]",
    " ROSTER=[", join(roster, ","), "]",
  ], "")
}
