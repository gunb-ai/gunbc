module v2.test.lens_coverage.near_miss_vacuous_not_parallel


data near_miss_vacuous_node: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^near_miss_vacuous_symbol } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

test fn near_miss_vacuous_not_parallel_claim_holds() -> v2.std.logic.Bool {
  v2.lens.coverage.coverage_defect_vacuous_arm != v2.lens.coverage.coverage_defect_parallel_authority
}
