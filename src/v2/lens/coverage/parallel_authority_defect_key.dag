module v2.test.lens_coverage.parallel_authority_defect_key

import v2.lens.coverage {
  CoverageDefectAcceptance,
  CoverageDefectAcceptanceKey,
  ParallelAuthority,
  coverage_defect_parallel_authority
}
import v2.std.logic { Bool }
import v2.std.node { Atom, Conj, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}

data parallel_authority_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^parallel_authority_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data expected_parallel_authority_acceptance: CoverageDefectAcceptance = {
  concern: CoverageDefectAcceptanceKey { lens: ParallelAuthority }
}

fn parallel_authority_defect_key_claim_holds() -> Bool {
  coverage_defect_parallel_authority == expected_parallel_authority_acceptance
}

fn parallel_authority_defect_key_claim_rhs() -> Node {
  if parallel_authority_defect_key_claim_holds() {
    parallel_authority_node
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_parallel_authority_defect_key: TestClaim = EqualsClaim {
  label: "lens_coverage/parallel_authority_defect_key: ParallelAuthority acceptance key",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: parallel_authority_node,
  rhs: parallel_authority_defect_key_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
