module v2.test.lens_coverage.parallel_authority_defect_key


data parallel_authority_node: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^parallel_authority_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data expected_parallel_authority_acceptance: v2.lens.coverage.CoverageDefectAcceptance = {
  concern: v2.lens.coverage.CoverageDefectAcceptanceKey { lens: ParallelAuthority }
}

fn parallel_authority_defect_key_claim_holds() -> Bool {
  coverage_defect_parallel_authority == expected_parallel_authority_acceptance
}

fn parallel_authority_defect_key_claim_rhs() -> Node {
  if parallel_authority_defect_key_claim_holds() {
    parallel_authority_node
  } else {
    v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_parallel_authority_defect_key: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "lens_coverage/parallel_authority_defect_key: ParallelAuthority acceptance key",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: parallel_authority_node,
  rhs: parallel_authority_defect_key_claim_rhs(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
