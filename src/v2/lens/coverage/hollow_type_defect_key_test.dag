module v2.test.lens_coverage.hollow_type_defect_key

import v2.lens.coverage {
  CoverageDefectAcceptance,
  CoverageDefectAcceptanceKey,
  HollowType,
  coverage_defect_hollow_type
}
import v2.std.logic { Bool }
import v2.std.node { Atom, Conj, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly
data hollow_type_authority_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^hollow_type_authority_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data expected_hollow_type_acceptance: CoverageDefectAcceptance = {
  concern: CoverageDefectAcceptanceKey { lens: HollowType }
}

test fn hollow_type_defect_key_claim_holds() -> Bool {
  coverage_defect_hollow_type == expected_hollow_type_acceptance
}

fn hollow_type_defect_key_claim_rhs() -> Node {
  if hollow_type_defect_key_claim_holds() {
    hollow_type_authority_node
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

test data claim_hollow_type_defect_key: TestClaim = EqualsClaim {
  label: "lens_coverage/hollow_type_defect_key: HollowType acceptance key",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: hollow_type_authority_node,
  rhs: hollow_type_defect_key_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
