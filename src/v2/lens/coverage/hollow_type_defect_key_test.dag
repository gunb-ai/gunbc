module v2.test.lens_coverage.hollow_type_defect_key

import v2.lens.coverage {
  CoverageDefectAcceptance,
  CoverageDefectAcceptanceKey,
  HollowType,
  coverage_defect_hollow_type
}
import v2.std.logic { Bool }
import v2.std.node { Atom, Conj, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly
data hollow_type_authority_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^hollow_type_authority_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data expected_hollow_type_acceptance: CoverageDefectAcceptance = {
  concern: CoverageDefectAcceptanceKey { lens: HollowType }
}

test fn hollow_type_defect_key_claim_holds() -> Bool {
  coverage_defect_hollow_type == expected_hollow_type_acceptance
}


