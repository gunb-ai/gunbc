module v2.test.lens_coverage.hollow_type_defect_key


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly
data hollow_type_authority_node: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^hollow_type_authority_symbol } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data expected_hollow_type_acceptance: v2.lens.coverage.CoverageDefectAcceptance = {
  concern: v2.lens.coverage.CoverageDefectAcceptanceKey { lens: v2.lens.coverage.HollowType }
}

test fn hollow_type_defect_key_claim_holds() -> Bool {
  v2.lens.coverage.coverage_defect_hollow_type == expected_hollow_type_acceptance
}


