module v2.test.lens_coverage.sibling_degenerate_not_hollow

import v2.lens.coverage {
  coverage_defect_degenerate_type,
  coverage_defect_hollow_type
}
import v2.std.logic { Bool }
import v2.std.node { Atom, Conj, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
data sibling_degenerate_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^sibling_degenerate_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn sibling_degenerate_not_hollow_claim_holds() -> Bool {
  coverage_defect_degenerate_type != coverage_defect_hollow_type
}

fn sibling_degenerate_not_hollow_claim_rhs() -> Node {
  if sibling_degenerate_not_hollow_claim_holds() {
    sibling_degenerate_node
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_sibling_degenerate_not_hollow: TestClaim = EqualsClaim {
  label: "lens_coverage/sibling_degenerate_not_hollow: DegenerateType distinct from HollowType",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: sibling_degenerate_node,
  rhs: sibling_degenerate_not_hollow_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
