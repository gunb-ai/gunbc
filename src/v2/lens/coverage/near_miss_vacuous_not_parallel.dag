module v2.test.lens_coverage.near_miss_vacuous_not_parallel


data near_miss_vacuous_node: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^near_miss_vacuous_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn near_miss_vacuous_not_parallel_claim_holds() -> Bool {
  coverage_defect_vacuous_arm != coverage_defect_parallel_authority
}

fn near_miss_vacuous_not_parallel_claim_rhs() -> Node {
  if near_miss_vacuous_not_parallel_claim_holds() {
    near_miss_vacuous_node
  } else {
    v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_near_miss_vacuous_not_parallel: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "lens_coverage/near_miss_vacuous_not_parallel: VacuousArm not ParallelAuthority",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: near_miss_vacuous_node,
  rhs: near_miss_vacuous_not_parallel_claim_rhs(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
