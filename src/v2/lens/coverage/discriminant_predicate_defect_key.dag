module v2.test.lens_coverage.discriminant_predicate_defect_key


data discriminant_predicate_node: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^discriminant_predicate_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data expected_discriminant_predicate_acceptance: v2.lens.coverage.CoverageDefectAcceptance = {
  concern: v2.lens.coverage.CoverageDefectAcceptanceKey { lens: DiscriminantPredicate }
}

fn discriminant_predicate_defect_key_claim_holds() -> Bool {
  coverage_defect_discriminant_predicate == expected_discriminant_predicate_acceptance
}

fn discriminant_predicate_defect_key_claim_rhs() -> Node {
  if discriminant_predicate_defect_key_claim_holds() {
    discriminant_predicate_node
  } else {
    v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_discriminant_predicate_defect_key: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "lens_coverage/discriminant_predicate_defect_key: DiscriminantPredicate acceptance key",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: discriminant_predicate_node,
  rhs: discriminant_predicate_defect_key_claim_rhs(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
