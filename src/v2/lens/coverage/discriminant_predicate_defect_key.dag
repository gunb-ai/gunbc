module v2.test.lens_coverage.discriminant_predicate_defect_key


data discriminant_predicate_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^discriminant_predicate_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data expected_discriminant_predicate_acceptance: CoverageDefectAcceptance = {
  concern: CoverageDefectAcceptanceKey { lens: DiscriminantPredicate }
}

fn discriminant_predicate_defect_key_claim_holds() -> Bool {
  coverage_defect_discriminant_predicate == expected_discriminant_predicate_acceptance
}

fn discriminant_predicate_defect_key_claim_rhs() -> Node {
  if discriminant_predicate_defect_key_claim_holds() {
    discriminant_predicate_node
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_discriminant_predicate_defect_key: TestClaim = EqualsClaim {
  label: "lens_coverage/discriminant_predicate_defect_key: DiscriminantPredicate acceptance key",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: discriminant_predicate_node,
  rhs: discriminant_predicate_defect_key_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
