module v2.lens.testgen






type TypeConstructionSubject

  = ConnectiveKernel { connective: v2.std.node.Connective }
  | BehaviorValueSubject { behavior: v2.std.node.Behavior }

type AlgebraLawSubject { algebra: v2.std.node.Symbol, inhabitant: v2.std.node.Symbol, law: v2.std.node.Symbol }

type AlgebraLawCase { anchor: v2.std.verification.ClaimAnchorKey, subject: AlgebraLawSubject }

type LensApplicabilitySubject {
  lens: v2.std.node.Symbol
  program: v2.std.node.Node
}

type BidirectionalRoundtripSubject { language: v2.std.node.Symbol, production: v2.std.node.Symbol }

type FrozenLanguageBehaviorSnapshot {
  language: v2.std.node.Symbol
  input_node: v2.std.node.Node
  expected_value: v2.std.node.Node
}

type LanguageBehaviorIoMock {
  snapshot: FrozenLanguageBehaviorSnapshot
}

type LanguageBehaviorEquivalenceSubject {
  subject: TypeConstructionSubject
  language: v2.std.node.Symbol
}

type RefinementPreservationSubject {
  refined: v2.std.refinement.Refined<List<v2.std.node.Node>>
  original: List<v2.std.node.Node>
}

type TestgenConcept

  = TypeConstruction { subject: TypeConstructionSubject }
  | AlgebraLaw { subject: AlgebraLawSubject }
  | DiagnosticExhaustiveness { coproduct_type: v2.std.node.Symbol, omitted_variant: v2.std.node.Symbol }

  | CrossRepresentationEquality { modeled_coproduct: v2.std.node.Symbol, native_realization: v2.std.node.Symbol }
  | LensApplicability { subject: LensApplicabilitySubject }
  | BidirectionalRoundtrip { subject: BidirectionalRoundtripSubject }
  | LanguageBehaviorEquivalence {
      subject: LanguageBehaviorEquivalenceSubject
      mock: LanguageBehaviorIoMock
    }
  | RefinementPreservation { subject: RefinementPreservationSubject }

type Generator<C> {
  kind: v2.std.verification.TestClaimCoproductVariant
  classification: v2.std.verification.TestClassification
  anchor: v2.std.verification.ClaimAnchorKey
  slot: C
  provenance: v2.std.artifact.GeneratorProvenance
  profile_metadata: GeneratorProfile
}

type GeneratorProfile { profile_ref: v2.std.node.Symbol }

data testgen_lens_file_path: String = "src/v2/lens/testgen.dag"

fn default_generator_profile() -> GeneratorProfile {
  GeneratorProfile { profile_ref: ^testgen_default_profile_ref }
}
fn testgen_profile_roster_mismatch_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^testgen_profile_roster_mismatch,
    at: v2.std.diagnostic.Textual { file: ^testgen_lens_file, extent: v2.std.diagnostic.WholeFile },
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn generator_id_for_manual_anchor(key: v2.std.verification.ManualAnchorKey) -> v2.std.artifact.GeneratorId {
  match key {
    v2.std.verification.ManualTcConjEmpty => ^gen_id_tc_conj_empty
    v2.std.verification.ManualTcDisjEmpty => ^gen_id_tc_disj_empty
    v2.std.verification.ManualTcArrowTwoConj => ^gen_id_tc_arrow_two_conj
    v2.std.verification.ManualTcCardinalityEmpty => ^gen_id_tc_cardinality_empty
    v2.std.verification.ManualTcInstantiationEmpty => ^gen_id_tc_instantiation_empty
    v2.std.verification.ManualTcArrowEmpty => ^gen_id_tc_arrow_empty
    v2.std.verification.ManualTcTransformEmpty => ^gen_id_tc_transform_empty
    v2.std.verification.ManualTcBranchEmpty => ^gen_id_tc_branch_empty
    v2.std.verification.ManualTcLoopEmpty => ^gen_id_tc_loop_empty
    v2.std.verification.ManualTcBindZeroChildren => ^gen_id_tc_bind_zero_children
    v2.std.verification.ManualTcConjEqualsRefl => ^gen_id_tc_conj_equals_refl
    v2.std.verification.ManualNatAddLeftIdentity => ^gen_id_nat_add_left_identity
    v2.std.verification.ManualNatAddRightIdentity => ^gen_id_nat_add_right_identity
    v2.std.verification.ManualNatAddAssociativity => ^gen_id_nat_add_associativity
    v2.std.verification.ManualNatMulLeftIdentity => ^gen_id_nat_mul_left_identity
    v2.std.verification.ManualNatMulAnnihilator => ^gen_id_nat_mul_annihilator
    v2.std.verification.ManualNatMulAssociativity => ^gen_id_nat_mul_associativity
    v2.std.verification.ManualLbeConjDagSurface => ^gen_id_lbe_conj_dag_surface
    v2.std.verification.ManualLbeDisjDagSurface => ^gen_id_lbe_disj_dag_surface
    v2.std.verification.ManualLbeTransformDagSurface => ^gen_id_lbe_transform_dag_surface
    v2.std.verification.ManualRefinementNonEmptyListBase => ^gen_id_refinement_nonempty_list_base
    v2.std.verification.ManualAnchorAbsent => ^gen_id_anchor_absent
  }
}

fn generator_id_for_coproduct_arm(coproduct_type: v2.std.node.Symbol, omitted_variant: v2.std.node.Symbol) -> v2.std.artifact.GeneratorId {
  concat(
    "gen_id_coproduct_exhaustiveness::",
    concat(coproduct_type, concat("::", omitted_variant))
  )
}

fn generator_id_for_cross_representation_straddle(
  modeled_coproduct: v2.std.node.Symbol,
  native_realization: v2.std.node.Symbol
) -> v2.std.artifact.GeneratorId {
  concat(
    "gen_id_cross_representation_equality::",
    concat(modeled_coproduct, concat("::", native_realization))
  )
}

fn generator_id_for_generated_anchor(key: v2.std.verification.GeneratedAnchorKey) -> v2.std.artifact.GeneratorId {
  match key {
    v2.std.verification.GeneratedCoproductExhaustiveness { coproduct_type, omitted_variant } =>
      generator_id_for_coproduct_arm(coproduct_type: coproduct_type, omitted_variant: omitted_variant)
    v2.std.verification.GeneratedCrossRepresentationEquality { modeled_coproduct, native_realization } =>
      generator_id_for_cross_representation_straddle(
        modeled_coproduct: modeled_coproduct,
        native_realization: native_realization
      )
  }
}

fn generator_id_for_claim_anchor(anchor: v2.std.verification.ClaimAnchorKey) -> v2.std.artifact.GeneratorId {
  match anchor {
    v2.std.verification.ManualClaimAnchor { manual_anchor } => generator_id_for_manual_anchor(key: manual_anchor)
    v2.std.verification.GeneratedClaimAnchor { generated_anchor } => generator_id_for_generated_anchor(key: generated_anchor)
  }
}

fn generator_provenance(id: v2.std.artifact.GeneratorId) -> v2.std.artifact.GeneratorProvenance {
  v2.std.artifact.GeneratorProvenance {
    generator_id: id,
    artifact: v2.std.artifact.test_claim_generated_artifact(id: id, file_path: testgen_lens_file_path),
  }
}

type CorpusEntry {
  path: v2.extdeps.file_system.AbsolutePath
  body: v2.extdeps.file_system.FileBody
}

type CorpusTraversalScope

  = RecursiveCorpusWalk
  | SingleDirectoryCorpusWalk

type CorpusTraversalOrder

  = LexicalPathOrder
  | FilesystemNativeOrder

type CorpusDuplicatePolicy

  = PreserveDuplicateEntries
  | RejectDuplicatePaths

type CorpusTraversalPolicy {
  scope: CorpusTraversalScope
  order: CorpusTraversalOrder
  duplicates: CorpusDuplicatePolicy
}

type CorpusEnumerationRequest {
  filesystem: v2.extdeps.file_system.Filesystem
  root: v2.extdeps.file_system.AbsolutePath
  operations: v2.extdeps.file_system.FileSystemOperations
  resolution: v2.extdeps.file_system.FileKindResolutionPolicy
  traversal: CorpusTraversalPolicy
}

type CorpusEnumerationResult = v2.std.diagnostic.Outcome<List<CorpusEntry>>

type CorpusEnumerator = fn(CorpusEnumerationRequest) -> CorpusEnumerationResult

type CorpusEntryIngestResult = v2.std.diagnostic.Outcome<v2.std.node.Node>

type CorpusEntryIngestor = fn(CorpusEntry) -> CorpusEntryIngestResult

type CorpusLensReadResult<C> = v2.std.diagnostic.Outcome<C>

type CorpusLensReader<C> {
  lens: v2.std.node.Symbol
  read: fn(v2.std.node.Node) -> CorpusLensReadResult<C>
}

type CorpusLensObservation<C> {
  entry: CorpusEntry
  program: v2.std.node.Node
  output: C
}

type CorpusLensDriveResult<C> = v2.std.diagnostic.Outcome<List<CorpusLensObservation<C>>>

type CorpusLensDriver<C> = fn(
  CorpusEnumerationRequest,
  CorpusEnumerator,
  CorpusEntryIngestor,
  CorpusLensReader<C>
) -> CorpusLensDriveResult<C>

data lbe_label_conj_dag_surface: String = "generated/lbe: Conj type-node matches dag LanguageModel surface (frozen snapshot)"

data lbe_label_disj_dag_surface: String = "generated/lbe: Disj type-node matches dag LanguageModel surface (frozen snapshot)"

data lbe_label_transform_dag_surface: String = "generated/lbe: Transform computation-node matches dag LanguageModel surface (frozen snapshot)"

data refinement_label_nonempty_list_base: String = "generated/refinement: NonEmptyList preserves List base after refine"
data idempotent_label_read: String = "generated/idempotent_operation: ReadEffect f(f(x)) == f(x)"
data idempotent_label_upsert: String = "generated/idempotent_operation: UpsertEffect f(f(x)) == f(x)"
data idempotent_label_delete: String = "generated/idempotent_operation: DeleteEffect f(f(x)) == f(x)"
data idempotent_label_create_if_absent: String = "generated/idempotent_operation: CreateIfAbsentEffect f(f(x)) == f(x)"
