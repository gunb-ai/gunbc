  coproduct_arm_key_list_from_node
}

// 🟢 coproduct dissolution — LB-P4-3212.
type TypeConstructionSubject
// 🟢 coproduct dissolution — LB-P4-3212
  = ConnectiveKernel { connective: Connective }
  | BehaviorValueSubject { behavior: Behavior }

type AlgebraLawSubject { algebra: Symbol, inhabitant: Symbol, law: Symbol }

type AlgebraLawCase { anchor: ClaimAnchorKey, subject: AlgebraLawSubject }

type LensApplicabilitySubject {
  lens: Symbol
  program: Node
}

type BidirectionalRoundtripSubject { language: Symbol, production: Symbol }

// 🟡 coproduct dissolution — T19-LBE-ACTIVATION.
type FrozenLanguageBehaviorSnapshot {
  language: Symbol
  input_node: Node
  expected_value: Node
}

// 🟡 coproduct dissolution — T19-LBE-ACTIVATION.
type LanguageBehaviorIoMock {
  snapshot: FrozenLanguageBehaviorSnapshot
}

// 🟡 coproduct dissolution — T19-LBE-ACTIVATION.
type LanguageBehaviorEquivalenceSubject {
  subject: TypeConstructionSubject
  language: Symbol
}

// 🟡 coproduct dissolution — T19-REFINEMENT-PRESERVATION.
type RefinementPreservationSubject {
  refined: Refined<List<Node>>
  original: List<Node>
}

// 🟡 coproduct dissolution — LB-P4-3212.
type TestgenConcept
// 🟡 coproduct dissolution — LB-P4-3212
// RULING-1: 🟡 needs-more-work — multi-arm scheduling coproduct (seven arms) until LBE = L6 form×language coproduct shape ruled.
  = TypeConstruction { subject: TypeConstructionSubject }
  | AlgebraLaw { subject: AlgebraLawSubject }
  | DiagnosticExhaustiveness { coproduct_type: Symbol, omitted_variant: Symbol }
  | LensApplicability { subject: LensApplicabilitySubject }
  | BidirectionalRoundtrip { subject: BidirectionalRoundtripSubject }
  | LanguageBehaviorEquivalence {
      subject: LanguageBehaviorEquivalenceSubject
      mock: LanguageBehaviorIoMock
    }
  | RefinementPreservation { subject: RefinementPreservationSubject }

// RULING-1: 🟡 needs-more-work — scheduling generator slot until LBE = L6 form×language coproduct shape ruled.
// 🟡 bootstrap-limitation interim — feature:B-GENERATOR-MATCH-ARM-1 — Generator<C> record
// destructuring via v2 `match_pattern` Value::Record arm (ctrl#1476 B3 Gap-1); dissolve-on-arrival:
// unified record/variant runtime representation so match arms need no per-type bridge; forbidden:
// `match generator { Generator { ... } }` failing with non-exhaustive pattern on Generator.
// F.2-P1: every generator carries its provenance (generator identity + emitted artifact,
// bundled in v2.std.artifact.GeneratorProvenance) and its profile metadata. Bundling
// generator_id inside `provenance` (rather than a third flat field) keeps future provenance
// growth a single-type edit — CLAUDE.md Cost-of-Change — and mirrors NodeArtifactProvenance.
type Generator<C> {
  kind: TestClaimCoproductVariant
  classification: TestClassification
  anchor: ClaimAnchorKey
  slot: C
  provenance: GeneratorProvenance
  profile_metadata: GeneratorProfile
}

// F.2-P1: testgen-local generation-profile metadata. v0 carries a single profile
// reference Symbol (precedent: leaf_model_verification build_profile / tool_profile_ref);
// the record shape lets profile facts grow without touching Generator construction sites.
type GeneratorProfile { profile_ref: Symbol }

// F.2-P1: default generation profile applied to all scheduled generators until the
// testgen CLI (wise-wolf-799 lane) selects a profile per invocation.
// F.2-P1: source file the testgen generators are authored in — the artifact file_path
// for provenance until per-claim emit paths are modeled.
data testgen_lens_file_path: String = "src/v2/lens/testgen.dag"

fn default_generator_profile() -> GeneratorProfile {
  GeneratorProfile { profile_ref: ^testgen_default_profile_ref }
}
fn testgen_profile_roster_mismatch_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^testgen_profile_roster_mismatch,
    at: Textual { file: ^testgen_lens_file, extent: WholeFile },
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

// F.2-P1: canonical per-anchor GeneratorId table. Identity is DERIVED from the row's
// ClaimAnchorKey (single authority — not a coarse static category symbol), so distinct
// anchors/obligations get distinct GeneratorIds and no two scheduled generators collide.
// 🟡 dissolution target: replace this literal table with an anchor→Symbol compile-time lens projection when
// .dag can project a Symbol from a ClaimAnchorKey directly (TestClaim coproduct-arm lens).
// F.2-P1: derive a generator's identity from its ManualAnchorKey (one id per manual anchor).
fn generator_id_for_manual_anchor(key: ManualAnchorKey) -> GeneratorId {
  match key {
    ManualTcConjEmpty => ^gen_id_tc_conj_empty
    ManualTcDisjEmpty => ^gen_id_tc_disj_empty
    ManualTcArrowTwoConj => ^gen_id_tc_arrow_two_conj
    ManualTcCardinalityEmpty => ^gen_id_tc_cardinality_empty
    ManualTcInstantiationEmpty => ^gen_id_tc_instantiation_empty
    ManualTcArrowEmpty => ^gen_id_tc_arrow_empty
    ManualTcTransformEmpty => ^gen_id_tc_transform_empty
    ManualTcBranchEmpty => ^gen_id_tc_branch_empty
    ManualTcLoopEmpty => ^gen_id_tc_loop_empty
    ManualTcBindZeroChildren => ^gen_id_tc_bind_zero_children
    ManualTcConjEqualsRefl => ^gen_id_tc_conj_equals_refl
    ManualNatAddLeftIdentity => ^gen_id_nat_add_left_identity
    ManualNatAddRightIdentity => ^gen_id_nat_add_right_identity
    ManualNatAddAssociativity => ^gen_id_nat_add_associativity
    ManualNatMulLeftIdentity => ^gen_id_nat_mul_left_identity
    ManualNatMulAnnihilator => ^gen_id_nat_mul_annihilator
    ManualNatMulAssociativity => ^gen_id_nat_mul_associativity
    ManualLbeConjDagSurface => ^gen_id_lbe_conj_dag_surface
    ManualLbeDisjDagSurface => ^gen_id_lbe_disj_dag_surface
    ManualLbeTransformDagSurface => ^gen_id_lbe_transform_dag_surface
    ManualRefinementNonEmptyListBase => ^gen_id_refinement_nonempty_list_base
    ManualAnchorAbsent => ^gen_id_anchor_absent
  }
}

// F.2-P1: derive identity from a generated coproduct-exhaustiveness variant (one id per omitted arm).
fn generator_id_for_coproduct_variant(v: TestClaimCoproductVariant) -> GeneratorId {
  match v {
    TestClaimCompilesClaimVariant => ^gen_id_coproduct_compiles
    TestClaimDiagnosticClaimVariant => ^gen_id_coproduct_diagnostic
    TestClaimEqualsClaimVariant => ^gen_id_coproduct_equals
    TestClaimStructuralEqualsClaimVariant => ^gen_id_coproduct_structural_equals
    TestClaimRoundTripClaimVariant => ^gen_id_coproduct_roundtrip
  }
}

fn generator_id_for_generated_anchor(key: GeneratedAnchorKey) -> GeneratorId {
  match key {
    GeneratedCoproductExhaustiveness { omitted_variant } =>
      generator_id_for_coproduct_variant(v: omitted_variant)
  }
}

// F.2-P1: single-authority GeneratorId derivation — the row's ClaimAnchorKey IS its identity.
fn generator_id_for_claim_anchor(anchor: ClaimAnchorKey) -> GeneratorId {
  match anchor {
    ManualClaimAnchor { manual_anchor } => generator_id_for_manual_anchor(key: manual_anchor)
    GeneratedClaimAnchor { generated_anchor } => generator_id_for_generated_anchor(key: generated_anchor)
  }
}

// F.2-P1: build a generator's provenance from its identity. The emitted artifact is a
// refined GeneratedArtifact keyed by the same GeneratorId — the refined type makes
// non-generated ArtifactKinds unrepresentable (Branch H §H.5 guardrail, authored in
// v2.std.artifact). TestClaimArtifact is statically admitted, so the total constructor
// test_claim_generated_artifact stays Outcome-free; no artifact law is re-declared here.
fn generator_provenance(id: GeneratorId) -> GeneratorProvenance {
  GeneratorProvenance {
    generator_id: id,
    artifact: test_claim_generated_artifact(id: id, file_path: testgen_lens_file_path),
  }
}

