data lbe_label_disj_dag_surface: String = "generated/lbe: Disj type-node matches dag LanguageModel surface (frozen snapshot)"

data lbe_label_transform_dag_surface: String = "generated/lbe: Transform computation-node matches dag LanguageModel surface (frozen snapshot)"

data refinement_label_nonempty_list_base: String = "generated/refinement: NonEmptyList preserves List base after refine"
data idempotent_label_read: String = "generated/idempotent_operation: ReadEffect f(f(x)) == f(x)"
data idempotent_label_upsert: String = "generated/idempotent_operation: UpsertEffect f(f(x)) == f(x)"
data idempotent_label_delete: String = "generated/idempotent_operation: DeleteEffect f(f(x)) == f(x)"
data idempotent_label_create_if_absent: String = "generated/idempotent_operation: CreateIfAbsentEffect f(f(x)) == f(x)"
