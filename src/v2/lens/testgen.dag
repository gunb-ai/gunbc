fn refine_nonempty_node_list(xs: List<Node>, at: Locus) -> Outcome<Refined<List<Node>>> {
  refine(
    base: xs,
    by: Validation {
      reason: ^refinement_preservation_empty_list_reason,
      admits: fn(candidate) { non_empty(xs: candidate) }
    },
    at: at
  )
}
fn refinement_preservation_list_node(xs: List<Node>) -> Node {
  fold_list_right(
    xs: xs,
    empty: Node {
      kind: TypeNode { connective: Atom { identity: ^refinement_preservation_list_empty_node } },
      children: [],
      occurrence_id: SyntheticOccurrence
},
    snoc: fn(tail_node, h) {
      Node {
        kind: TypeNode { connective: Atom { identity: ^refinement_preservation_list_cons_node } },
        children: [
          Edge { label: Named { name: ^refinement_preservation_list_head_edge }, target: h },
          Edge {
            label: Named { name: ^refinement_preservation_list_tail_edge },
            target: tail_node
          }
        ],
        occurrence_id: SyntheticOccurrence
}
    }
  )
}

fn refinement_preservation_subject_nonempty_list_base() -> Outcome<RefinementPreservationSubject> {
  let original = [stub_empty_conj]
  match refine_nonempty_node_list(xs: original, at: node_locus(node: stub_empty_conj)) {
    Accepted { value: refined, diagnostics: None } =>
      Accepted {
        value: RefinementPreservationSubject {
          refined: refined,
          original: original,
        },
        diagnostics: None,
      }
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}

fn testgen_emit_refinement_preservation_claim(
  anchor: ManualAnchorKey,
  label: String,
  subject: RefinementPreservationSubject
) -> Outcome<TestClaim> {
  match anchor {
    ManualRefinementNonEmptyListBase =>
      Accepted {
        value: EqualsClaim {
          label: label,
          anchor: manual_claim_anchor(anchor: anchor),
          lhs: refinement_preservation_list_node(
            xs: refined_base(r: subject.refined)
          ),
          rhs: refinement_preservation_list_node(xs: subject.original),
          classification: TestClassification { tier: Tier1, layer: Unit },
        },
        diagnostics: None,
      }
    _ =>
      Rejected {
        diagnostics: diagnostics_singleton(d: manual_anchor_absent_bootstrap_diagnostic()),
      }
  }
}

fn testgen_scheduled_refinement_preservation_generators() -> Outcome<List<Generator<TestgenConcept>>> {
  match bootstrap_claim_generator_for_manual_anchor(key: ManualRefinementNonEmptyListBase) {
    Accepted { value: generator, diagnostics: d } =>
      Accepted {
        value: [generator],
        diagnostics: d,
      }
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}

fn testgen_emit_idempotent_operation_equals_claim(
  label: String,
  subject: ComposableIdempotentOperationSubject,
  classification: TestClassification
) -> Outcome<TestClaim> {
  Accepted {
    value: EqualsClaim {
      label: label,
      anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
      lhs: idempotent_operation_apply_twice(state: sample_state, subject: subject),
      rhs: idempotent_operation_apply_once(state: sample_state, subject: subject),
      classification: classification,
    },
    diagnostics: None,
  }
}

fn testgen_emit_idempotent_operation_claim(
  label: String,
  subject: IdempotentOperationSubject,
  classification: TestClassification
) -> Outcome<TestClaim> {
  match subject {
    LabelOnlyIdempotentInhabitance { shape: _, label: _ } =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: Diagnostic {
            reason: ^idempotent_operation_tautology_skip,
            at: Textual { file: ^testgen_lens_file, extent: WholeFile },
            correction: Unavailable { reason: UserInputBoundary }
          }
        )
      }
    Composable(inner) =>
      testgen_emit_idempotent_operation_equals_claim(
        label: label,
        subject: inner,
        classification: classification
      )
  }
}

fn testgen_scheduled_idempotent_operation_subjects() -> List<ComposableIdempotentOperationSubject> {
  [
    sample_read_composable,
    sample_upsert_composable,
    sample_delete_composable,
    sample_create_if_absent_composable,
  ]
}

fn testgen_emit_language_behavior_equivalence_claim(
  anchor: ManualAnchorKey,
  label: String,
  mock: LanguageBehaviorIoMock
) -> Outcome<TestClaim> {
  let snap = mock.snapshot
  match anchor {
    ManualLbeConjDagSurface =>
      Accepted {
        value: CompilesClaim {
          label: label,
          anchor: manual_claim_anchor(anchor: anchor),
          input: snap.input_node,
          expected_value: snap.expected_value,
          classification: TestClassification { tier: Tier1, layer: Unit },
        },
        diagnostics: None,
      }
    ManualLbeDisjDagSurface =>
      Accepted {
        value: CompilesClaim {
          label: label,
          anchor: manual_claim_anchor(anchor: anchor),
          input: snap.input_node,
          expected_value: snap.expected_value,
          classification: TestClassification { tier: Tier1, layer: Unit },
        },
        diagnostics: None,
      }
    ManualLbeTransformDagSurface =>
      Accepted {
        value: CompilesClaim {
          label: label,
          anchor: manual_claim_anchor(anchor: anchor),
          input: snap.input_node,
          expected_value: snap.expected_value,
          classification: TestClassification { tier: Tier1, layer: Unit },
        },
        diagnostics: None,
      }
    _ =>
      Rejected {
        diagnostics: diagnostics_singleton(d: manual_anchor_absent_bootstrap_diagnostic()),
      }
  }
}

fn testgen_emit_algebra_law_claim(
  anchor: ManualAnchorKey,
  label: String,
  lhs: Node,
  rhs: Node,
  classification: TestClassification
) -> Outcome<TestClaim> {
  if lhs == rhs {
    Rejected {
      diagnostics: diagnostics_singleton(
        d: Diagnostic {
          reason: ^t19_algebra_law_tautological_sides,
          at: Textual { file: ^testgen_lens_file, extent: WholeFile },
          correction: Unavailable { reason: UserInputBoundary }
        }
      )
    }
  } else {
    match algebra_law_manual_claim_case(anchor: anchor) {
      Accepted { value: law_case, diagnostics: None } =>
        Accepted {
          value: EqualsClaim {
            label: label,
            anchor: law_case.anchor,
            lhs: algebra_law_claim_term(subject: law_case.subject, expression: lhs),
            rhs: algebra_law_claim_term(subject: law_case.subject, expression: rhs),
            classification: classification,
          },
          diagnostics: None,
        }
      Rejected { diagnostics: d } =>
        Rejected { diagnostics: d }
    }
  }
}

fn algebra_law_manual_claim_case(anchor: ManualAnchorKey) -> Outcome<AlgebraLawCase> {
  match algebra_law_subject_for_manual_anchor(anchor: anchor) {
    Accepted { value: subject, diagnostics: None } =>
      Accepted {
        value: AlgebraLawCase {
          anchor: manual_claim_anchor(anchor: anchor),
          subject: subject,
        },
        diagnostics: None,
      }
    Rejected { diagnostics: d } =>
      Rejected { diagnostics: d }
  }
}

fn algebra_law_subject_for_manual_anchor(anchor: ManualAnchorKey) -> Outcome<AlgebraLawSubject> {
  match anchor {
    ManualNatAddLeftIdentity =>
      Accepted {
        value: AlgebraLawSubject {
          algebra: ^nat_algebra_law_subject_symbol_additive_monoid,
          inhabitant: ^nat_algebra_law_subject_symbol_inhabitant_nat,
          law: ^law_nat_add_left_identity,
        },
        diagnostics: None,
      }
    ManualNatAddRightIdentity =>
      Accepted {
        value: AlgebraLawSubject {
          algebra: ^nat_algebra_law_subject_symbol_additive_monoid,
          inhabitant: ^nat_algebra_law_subject_symbol_inhabitant_nat,
          law: ^law_nat_add_right_identity,
        },
        diagnostics: None,
      }
    ManualNatAddAssociativity =>
      Accepted {
        value: AlgebraLawSubject {
          algebra: ^nat_algebra_law_subject_symbol_additive_monoid,
          inhabitant: ^nat_algebra_law_subject_symbol_inhabitant_nat,
          law: ^law_nat_add_associativity,
        },
        diagnostics: None,
      }
    ManualNatMulLeftIdentity =>
      Accepted {
        value: AlgebraLawSubject {
          algebra: ^nat_algebra_law_subject_symbol_commutative_semiring,
          inhabitant: ^nat_algebra_law_subject_symbol_inhabitant_nat,
          law: ^law_nat_mul_left_identity,
        },
        diagnostics: None,
      }
    ManualNatMulAnnihilator =>
      Accepted {
        value: AlgebraLawSubject {
          algebra: ^nat_algebra_law_subject_symbol_commutative_semiring,
          inhabitant: ^nat_algebra_law_subject_symbol_inhabitant_nat,
          law: ^law_nat_mul_annihilator,
        },
        diagnostics: None,
      }
    ManualNatMulAssociativity =>
      Accepted {
        value: AlgebraLawSubject {
          algebra: ^nat_algebra_law_subject_symbol_commutative_semiring,
          inhabitant: ^nat_algebra_law_subject_symbol_inhabitant_nat,
          law: ^law_nat_mul_associativity,
        },
        diagnostics: None,
      }
    _ =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: Diagnostic {
            reason: ^algebra_law_anchor_mismatch,
            at: Textual { file: ^testgen_lens_file, extent: WholeFile },
            correction: Unavailable { reason: UserInputBoundary }
          }
        )
      }
  }
}

fn algebra_law_subject_atom(s: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: s } }, children: [],
 occurrence_id: SyntheticOccurrence
}
}

fn algebra_law_subject_node(subject: AlgebraLawSubject) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: ^t19_algebra_law_algebra_field }, target: algebra_law_subject_atom(s: subject.algebra) },
      Edge { label: Named { name: ^t19_algebra_law_inhabitant_field }, target: algebra_law_subject_atom(s: subject.inhabitant) },
      Edge { label: Named { name: ^t19_algebra_law_law_field }, target: algebra_law_subject_atom(s: subject.law) },
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn algebra_law_claim_term(subject: AlgebraLawSubject, expression: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: ^t19_algebra_law_subject_field }, target: algebra_law_subject_node(subject: subject) },
      Edge { label: Named { name: ^t19_algebra_law_expression_field }, target: expression },
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn witness_validity_symbol_atom_node(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn witness_validity_predicate_node(p: PreservationPredicate) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: ^witness_validity_field_algebra }, target: p.algebra },
      Edge {
        label: Named { name: ^witness_validity_field_preservation_rule },
        target: witness_validity_symbol_atom_node(s: p.preservation_rule)
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn witness_validity_witness_node(w: StructuralPropertyWitness) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^witness_validity_field_property },
        target: witness_validity_symbol_atom_node(s: w.property)
      },
      Edge { label: Named { name: ^witness_validity_field_evidence }, target: w.evidence }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn witness_validity_byte_range_unencodable_diagnostic(at_node: Node) -> Diagnostic {
  Diagnostic {
    reason: ^witness_validity_byte_range_unencodable,
    at: node_locus(node: at_node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn witness_validity_subject_node(
  source_facts: Node,
  candidate: Node,
  predicate: PreservationPredicate,
  witness: StructuralPropertyWitness
) -> Outcome<Node> {
  bind_outcome(
    o: witness_validity_outcome_node(
      o: verify_witness(
        source_facts: source_facts,
        candidate: candidate,
        predicate: predicate,
        witness: witness
      )
    ),
    f: fn(oracle_outcome) {
      Accepted {
        value: Node {
          kind: TypeNode { connective: Conj },
          children: [
            Edge { label: Named { name: ^witness_validity_field_source_facts }, target: source_facts },
            Edge { label: Named { name: ^witness_validity_field_candidate }, target: candidate },
            Edge {
              label: Named { name: ^witness_validity_field_predicate },
              target: witness_validity_predicate_node(p: predicate)
            },
            Edge {
              label: Named { name: ^witness_validity_field_witness },
              target: witness_validity_witness_node(w: witness)
            },
            Edge {
              label: Named { name: ^witness_validity_field_oracle_outcome },
              target: oracle_outcome
            }
          ],
          occurrence_id: SyntheticOccurrence
},
        diagnostics: None
      }
    }
  )
}

fn witness_validity_no_correction_reason_node(r: NoCorrectionReason) -> Node {
  match r {
    UserInputBoundary =>
      witness_validity_symbol_atom_node(s: ^witness_validity_no_correction_tag_user)
    AmbiguousIntent =>
      witness_validity_symbol_atom_node(s: ^witness_validity_no_correction_tag_ambiguous)
    ExternalContractUnknown =>
      witness_validity_symbol_atom_node(s: ^witness_validity_no_correction_tag_external)
    CorrectionNotModeled =>
      witness_validity_symbol_atom_node(s: ^witness_validity_no_correction_tag_not_modeled)
  }
}

fn witness_validity_correction_node(c: Correction) -> Node {
  match c {
    Suggested { node: n } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge { label: Named { name: ^witness_validity_correction_tag_suggested }, target: n }
        ],
        occurrence_id: SyntheticOccurrence
}
    Unavailable { reason: r } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge {
            label: Named { name: ^witness_validity_correction_tag_unavailable },
            target: witness_validity_no_correction_reason_node(r: r)
          }
        ],
        occurrence_id: SyntheticOccurrence
}
  }
}

fn witness_validity_extent_node(e: Extent) -> Outcome<Node> {
  match e {
    WholeFile =>
      Accepted {
        value: witness_validity_symbol_atom_node(s: ^witness_validity_extent_tag_whole_file),
        diagnostics: None
      }
    ByteRange { start: _, end: _ } =>
      outcome_rejected(
        d: witness_validity_byte_range_unencodable_diagnostic(
          at_node: witness_validity_symbol_atom_node(s: ^witness_validity_extent_tag_byte_range)
        )
      )
  }
}

fn witness_validity_locus_node(l: Locus) -> Outcome<Node> {
  match l {
    Textual { file: f, extent: e } =>
      bind_outcome(o: witness_validity_extent_node(e: e), f: fn(en) {
        Accepted {
          value: Node {
            kind: TypeNode { connective: Conj },
            children: [
              Edge {
                label: Named { name: ^witness_validity_locus_tag_textual },
                target: Node {
                  kind: TypeNode { connective: Conj },
                  children: [
                    Edge {
                      label: Named { name: ^witness_validity_locus_textual_file },
                      target: witness_validity_symbol_atom_node(s: f)
                    },
                    Edge {
                      label: Named { name: ^witness_validity_locus_textual_extent },
                      target: en
                    }
                  ],
                  occurrence_id: SyntheticOccurrence
}
              }
            ],
            occurrence_id: SyntheticOccurrence
},
          diagnostics: None
        }
      })
    NodeLocus { anchor: a } =>
      Accepted {
        value: Node {
          kind: TypeNode { connective: Conj },
          children: [
            Edge { label: Named { name: ^witness_validity_locus_tag_node }, target: a.at }
          ],
          occurrence_id: SyntheticOccurrence
},
        diagnostics: None
      }
    PortLocus { anchor: a } =>
      Accepted {
        value: Node {
          kind: TypeNode { connective: Conj },
          children: [
            Edge {
              label: Named { name: ^witness_validity_locus_tag_port },
              target: witness_validity_symbol_atom_node(s: a.at)
            }
          ],
          occurrence_id: SyntheticOccurrence
},
        diagnostics: None
      }
  }
}

fn witness_validity_diagnostic_node(d: Diagnostic) -> Outcome<Node> {
  bind_outcome(o: witness_validity_locus_node(l: d.at), f: fn(at_node) {
    Accepted {
      value: Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge {
            label: Named { name: ^witness_validity_diag_field_reason },
            target: witness_validity_symbol_atom_node(s: d.reason)
          },
          Edge {
            label: Named { name: ^witness_validity_diag_field_at },
            target: at_node
          },
          Edge {
            label: Named { name: ^witness_validity_diag_field_correction },
            target: witness_validity_correction_node(c: d.correction)
          }
        ],
        occurrence_id: SyntheticOccurrence
},
      diagnostics: None
    }
  })
}

fn witness_validity_diagnostic_list_node(xs: FreeMonoid<Diagnostic>) -> Outcome<Node> {
  fold_list_right(
    xs: xs,
    empty: Accepted {
      value: witness_validity_symbol_atom_node(s: ^witness_validity_list_tag_empty),
      diagnostics: None
    },
    snoc: fn(acc, h) {
      bind_outcome(o: acc, f: fn(prev_node) {
        bind_outcome(o: witness_validity_diagnostic_node(d: h), f: fn(hn) {
          Accepted {
            value: Node {
              kind: TypeNode { connective: Conj },
              children: [
                Edge { label: Named { name: ^witness_validity_list_cons_head }, target: hn },
                Edge { label: Named { name: ^witness_validity_list_cons_tail }, target: prev_node }
              ],
              occurrence_id: SyntheticOccurrence
},
            diagnostics: None
          }
        })
      })
    }
  )
}

fn witness_validity_non_empty_diagnostics_node(d: NonEmptyDiagnostics) -> Outcome<Node> {
  bind_outcome(o: witness_validity_diagnostic_node(d: d.head), f: fn(hn) {
    bind_outcome(o: witness_validity_diagnostic_list_node(xs: d.tail), f: fn(tn) {
      Accepted {
        value: Node {
          kind: TypeNode { connective: Conj },
          children: [
            Edge {
              label: Named { name: ^witness_validity_diags_field_head },
              target: hn
            },
            Edge {
              label: Named { name: ^witness_validity_diags_field_tail },
              target: tn
            }
          ],
          occurrence_id: SyntheticOccurrence
},
        diagnostics: None
      }
    })
  })
}

fn witness_validity_diagnostics_node(ds: Diagnostics) -> Outcome<Node> {
  match ds {
    None =>
      Accepted {
        value: witness_validity_symbol_atom_node(s: ^witness_validity_diagnostics_tag_none),
        diagnostics: None
      }
    Some { diagnostics: nd } =>
      bind_outcome(o: witness_validity_non_empty_diagnostics_node(d: nd), f: fn(ndn) {
        Accepted {
          value: Node {
            kind: TypeNode { connective: Conj },
            children: [
              Edge {
                label: Named { name: ^witness_validity_diagnostics_tag_some },
                target: ndn
              }
            ],
            occurrence_id: SyntheticOccurrence
},
          diagnostics: None
        }
      })
  }
}

fn witness_validity_outcome_node(o: Outcome<StructuralPropertyWitness>) -> Outcome<Node> {
  match o {
    Accepted { value: w, diagnostics: ds } =>
      bind_outcome(o: witness_validity_diagnostics_node(ds: ds), f: fn(dsn) {
        Accepted {
          value: Node {
            kind: TypeNode { connective: Conj },
            children: [
              Edge {
                label: Named { name: ^witness_validity_outcome_holds },
                target: Node {
                  kind: TypeNode { connective: Conj },
                  children: [
                    Edge {
                      label: Named { name: ^witness_validity_outcome_accepted_value },
                      target: witness_validity_witness_node(w: w)
                    },
                    Edge {
                      label: Named { name: ^witness_validity_outcome_accepted_diagnostics },
                      target: dsn
                    }
                  ],
                  occurrence_id: SyntheticOccurrence
}
              }
            ],
            occurrence_id: SyntheticOccurrence
},
          diagnostics: None
        }
      })
    Rejected { diagnostics: d } =>
      bind_outcome(o: witness_validity_non_empty_diagnostics_node(d: d), f: fn(dn) {
        Accepted {
          value: Node {
            kind: TypeNode { connective: Conj },
            children: [
              Edge {
                label: Named { name: ^witness_validity_outcome_violates },
                target: dn
              }
            ],
            occurrence_id: SyntheticOccurrence
},
          diagnostics: None
        }
      })
  }
}

fn testgen_emit_witness_validity_claim(
  label: String,
  source_facts: Node,
  candidate: Node,
  predicate: PreservationPredicate,
  witness: StructuralPropertyWitness
) -> Outcome<TestClaim> {
  bind_outcome(
    o: witness_validity_subject_node(
      source_facts: source_facts,
      candidate: candidate,
      predicate: predicate,
      witness: witness
    ),
    f: fn(input_node) {
      Accepted {
        value: RoundTripClaim {
          label: label,
          anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
          input: input_node,
          classification: TestClassification { tier: Tier1, layer: Unit }
        },
        diagnostics: None
      }
    }
  )
}

