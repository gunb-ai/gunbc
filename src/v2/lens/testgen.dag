fn testgen_non_algebra_law_scheduled_slot_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^testgen_non_algebra_law_scheduled_slot,
    at: Textual { file: ^testgen_lens_file, extent: WholeFile },
    correction: Unavailable { reason: UserInputBoundary }
  }
}

type NatAlgebraLawScheduleRow {
  obligation: NatAlgebraLawObligation
  anchor: ManualAnchorKey
}

// 🟡 gated — record-shape bridge interim — feature:nat-law-obligation-lens-migration — dissolve-on-arrival: NatAlgebraLawObligation (std/nat) is the authoritative L7 law-subject carrier; AlgebraLawSubject is the downstream lens-local shape; migrate testgen + coverage to consume NatAlgebraLawObligation directly and delete algebra_law_subject_from_nat_obligation in that same PR; forbidden: permanent parallel NatAlgebraLawObligation⇄AlgebraLawSubject record-shape drift across std/nat and lens/testgen.
fn algebra_law_subject_from_nat_obligation(o: NatAlgebraLawObligation) -> AlgebraLawSubject {
  AlgebraLawSubject {
    algebra: o.algebra,
    inhabitant: o.inhabitant,
    law: o.law,
  }
}

fn append_nat_obligation_if_law_matches(
  found: Outcome<NatAlgebraLawObligation>,
  obligation: NatAlgebraLawObligation,
  law: Symbol
) -> Outcome<NatAlgebraLawObligation> {
  match found {
    Accepted { value: _, diagnostics: None } => found
    Rejected { diagnostics: _ } =>
      if obligation.law == law {
        Accepted { value: obligation, diagnostics: None }
      } else {
        found
      }
  }
}

fn nat_algebra_law_obligation_for_law(law: Symbol) -> Outcome<NatAlgebraLawObligation> {
  fold_list(
    xs: nat_declared_algebra_law_obligations(),
    empty: Rejected {
      diagnostics: diagnostics_singleton(
        d: Diagnostic {
          reason: ^testgen_non_algebra_law_scheduled_slot,
          at: Textual { file: ^testgen_lens_file, extent: WholeFile },
          correction: Unavailable { reason: UserInputBoundary }
        }
      )
    },
    cons: fn(found, obligation) {
      append_nat_obligation_if_law_matches(
        found: found,
        obligation: obligation,
        law: law
      )
    }
  )
}

// 🟡 gated — feature:nat-algebra-law-anchor-projection — bind gunbc#4762
// dissolve-on-arrival: law↔ManualAnchorKey projection is substrate-derived from NatAlgebraLawObligation schedule rows (std/nat authority + testgen compile-time lens); delete this hand-rolled Symbol→ManualAnchorKey classifier in that same PR; forbidden: permanent per-law manual-anchor table drift from nat_declared_algebra_law_obligations().
fn testgen_manual_anchor_for_law(law: Symbol) -> Outcome<ManualAnchorKey> {
  if law == ^law_nat_add_left_identity {
    Accepted { value: ManualNatAddLeftIdentity, diagnostics: None }
  } else if law == ^law_nat_add_right_identity {
    Accepted { value: ManualNatAddRightIdentity, diagnostics: None }
  } else if law == ^law_nat_add_associativity {
    Accepted { value: ManualNatAddAssociativity, diagnostics: None }
  } else if law == ^law_nat_mul_left_identity {
    Accepted { value: ManualNatMulLeftIdentity, diagnostics: None }
  } else if law == ^law_nat_mul_annihilator {
    Accepted { value: ManualNatMulAnnihilator, diagnostics: None }
  } else if law == ^law_nat_mul_associativity {
    Accepted { value: ManualNatMulAssociativity, diagnostics: None }
  } else {
    Rejected {
      diagnostics: diagnostics_singleton(
        d: testgen_non_algebra_law_scheduled_slot_diagnostic()
      )
    }
  }
}

fn testgen_manual_anchor_from_nat_obligation(
  o: NatAlgebraLawObligation
) -> Outcome<ManualAnchorKey> {
  testgen_manual_anchor_for_law(law: o.law)
}

fn nat_algebra_law_schedule_row_from_obligation(
  obligation: NatAlgebraLawObligation
) -> Outcome<NatAlgebraLawScheduleRow> {
  bind_outcome(
    o: testgen_manual_anchor_for_law(law: obligation.law),
    f: fn(anchor) {
      Accepted {
        value: NatAlgebraLawScheduleRow { obligation: obligation, anchor: anchor },
        diagnostics: None,
      }
    }
  )
}

// 🟡 gated — derived-equality interim — bound target: exact structural equality / compiler-provided closed-sum equality — bind node://adhoc-35324347-e8a — dissolve-on-arrival: replace nat_manual_anchor_key_eq call sites with the substrate equality primitive and delete this helper in that same PR; forbidden: permanent ManualAnchorKey Nat-arm equality table drift from std/verification.dag.
fn nat_manual_anchor_key_eq(a: ManualAnchorKey, b: ManualAnchorKey) -> Bool {
  match a {
    ManualNatAddLeftIdentity =>
      match b {
        ManualNatAddLeftIdentity => true
        _ => false
      }
    ManualNatAddRightIdentity =>
      match b {
        ManualNatAddRightIdentity => true
        _ => false
      }
    ManualNatAddAssociativity =>
      match b {
        ManualNatAddAssociativity => true
        _ => false
      }
    ManualNatMulLeftIdentity =>
      match b {
        ManualNatMulLeftIdentity => true
        _ => false
      }
    ManualNatMulAnnihilator =>
      match b {
        ManualNatMulAnnihilator => true
        _ => false
      }
    ManualNatMulAssociativity =>
      match b {
        ManualNatMulAssociativity => true
        _ => false
      }
    _ => false
  }
}

fn append_nat_algebra_law_schedule_row_if_anchor_matches(
  found: Outcome<NatAlgebraLawScheduleRow>,
  obligation: NatAlgebraLawObligation,
  anchor: ManualAnchorKey
) -> Outcome<NatAlgebraLawScheduleRow> {
  match found {
    Accepted { value: _, diagnostics: _ } => found
    Rejected { diagnostics: _ } =>
      bind_outcome(
        o: nat_algebra_law_schedule_row_from_obligation(obligation: obligation),
        f: fn(row) {
          if nat_manual_anchor_key_eq(a: row.anchor, b: anchor) {
            Accepted { value: row, diagnostics: None }
          } else {
            found
          }
        }
      )
  }
}

fn nat_algebra_law_schedule_row_for_manual_anchor(
  anchor: ManualAnchorKey
) -> Outcome<NatAlgebraLawScheduleRow> {
  fold_list(
    xs: nat_declared_algebra_law_obligations(),
    empty: Rejected {
      diagnostics: diagnostics_singleton(
        d: testgen_non_algebra_law_scheduled_slot_diagnostic()
      )
    },
    cons: fn(found, obligation) {
      append_nat_algebra_law_schedule_row_if_anchor_matches(
        found: found,
        obligation: obligation,
        anchor: anchor
      )
    }
  )
}

fn testgen_algebra_law_generator_from_nat_obligation(
  obligation: NatAlgebraLawObligation
) -> Outcome<Generator<TestgenConcept>> {
  bind_outcome(
    o: testgen_manual_anchor_from_nat_obligation(o: obligation),
    f: fn(anchor) {
      Accepted {
        value: Generator {
          kind: TestClaimEqualsClaimVariant,
          classification: TestClassification { tier: Tier1, layer: Unit },
          anchor: manual_claim_anchor(anchor: anchor),
          slot: AlgebraLaw {
            subject: algebra_law_subject_from_nat_obligation(o: obligation),
          },
          provenance: generator_provenance(id: generator_id_for_manual_anchor(key: anchor)),
          profile_metadata: default_generator_profile(),
        },
        diagnostics: None,
      }
    }
  )
}

fn append_algebra_law_generator_from_nat_obligation(
  acc: Outcome<List<Generator<TestgenConcept>>>,
  obligation: NatAlgebraLawObligation
) -> Outcome<List<Generator<TestgenConcept>>> {
  bind_outcome(
    o: acc,
    f: fn(acc) {
      bind_outcome(
        o: testgen_algebra_law_generator_from_nat_obligation(obligation: obligation),
        f: fn(generator) {
          Accepted {
            value: list_snoc_item(xs: acc, item: generator),
            diagnostics: None,
          }
        }
      )
    }
  )
}

fn testgen_scheduled_algebra_law_generators() -> Outcome<List<Generator<TestgenConcept>>> {
  fold_list_right(
    xs: nat_declared_algebra_law_obligations(),
    empty: outcome_accepted(value: Empty),
    snoc: fn(o, obligation) {
      append_algebra_law_generator_from_nat_obligation(
        acc: o,
        obligation: obligation
      )
    }
  )
}

fn nat_algebra_law_obligation_for_manual_anchor(
  anchor: ManualAnchorKey
) -> Outcome<NatAlgebraLawObligation> {
  bind_outcome(
    o: nat_algebra_law_schedule_row_for_manual_anchor(anchor: anchor),
    f: fn(row) {
      Accepted { value: row.obligation, diagnostics: None }
    }
  )
}

fn testgen_algebra_law_concept_for_manual_nat_anchor(
  anchor: ManualAnchorKey
) -> Outcome<TestgenConcept> {
  bind_outcome(
    o: nat_algebra_law_obligation_for_manual_anchor(anchor: anchor),
    f: fn(obligation) {
      Accepted {
        value: AlgebraLaw {
          subject: algebra_law_subject_from_nat_obligation(o: obligation),
        },
        diagnostics: None,
      }
    }
  )
}

fn testgen_algebra_law_subject_from_scheduled_generator(
  generator: Generator<TestgenConcept>
) -> Outcome<AlgebraLawSubject> {
  match generator.slot {
    AlgebraLaw { subject: subject } =>
      Accepted { value: subject, diagnostics: None }
    TypeConstruction { subject: _ } =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: testgen_non_algebra_law_scheduled_slot_diagnostic()
        )
      }
    DiagnosticExhaustiveness { omitted_variant: _ } =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: testgen_non_algebra_law_scheduled_slot_diagnostic()
        )
      }
    LensApplicability { subject: _ } =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: testgen_non_algebra_law_scheduled_slot_diagnostic()
        )
      }
    BidirectionalRoundtrip { subject: _ } =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: testgen_non_algebra_law_scheduled_slot_diagnostic()
        )
      }
    LanguageBehaviorEquivalence { subject: _, mock: _ } =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: testgen_non_algebra_law_scheduled_slot_diagnostic()
        )
      }
    RefinementPreservation { subject: _ } =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: testgen_non_algebra_law_scheduled_slot_diagnostic()
        )
      }
  }
}

fn append_algebra_law_subject_from_scheduled_generator(
  acc: List<AlgebraLawSubject>,
  generator: Generator<TestgenConcept>
) -> Outcome<List<AlgebraLawSubject>> {
  bind_outcome(
    o: testgen_algebra_law_subject_from_scheduled_generator(generator: generator),
    f: fn(subject) {
      Accepted {
        value: Cons { head: subject, tail: acc },
        diagnostics: None,
      }
    }
  )
}

fn testgen_algebra_law_subjects_from_scheduled_generators(
  generators: List<Generator<TestgenConcept>>
) -> Outcome<List<AlgebraLawSubject>> {
  fold_list_right(
    xs: generators,
    empty: outcome_accepted(value: Empty),
    snoc: fn(o, generator) {
      bind_outcome(
        o: o,
        f: fn(acc) {
          append_algebra_law_subject_from_scheduled_generator(
            acc: acc,
            generator: generator
          )
        }
      )
    }
  )
}

fn testgen_scheduled_algebra_law_subjects() -> Outcome<List<AlgebraLawSubject>> {
  bind_outcome(
    o: testgen_scheduled_algebra_law_generators(),
    f: fn(generators) {
      testgen_algebra_law_subjects_from_scheduled_generators(generators: generators)
    }
  )
}

fn coproduct_exhaustiveness_subject_testclaim_diagnostic() -> GeneratedAnchorKey {
  GeneratedCoproductExhaustiveness { omitted_variant: TestClaimDiagnosticClaimVariant }
}

fn coproduct_exhaustiveness_subject_testclaim_compiles() -> GeneratedAnchorKey {
  GeneratedCoproductExhaustiveness { omitted_variant: TestClaimCompilesClaimVariant }
}

fn coproduct_exhaustiveness_subject_testclaim_equals() -> GeneratedAnchorKey {
  GeneratedCoproductExhaustiveness { omitted_variant: TestClaimEqualsClaimVariant }
}

fn coproduct_exhaustiveness_subject_testclaim_roundtrip() -> GeneratedAnchorKey {
  GeneratedCoproductExhaustiveness { omitted_variant: TestClaimRoundTripClaimVariant }
}

fn coproduct_exhaustiveness_anchor_omitted_variant(anchor: GeneratedAnchorKey) -> TestClaimCoproductVariant {
  match anchor {
    GeneratedCoproductExhaustiveness { omitted_variant } => omitted_variant
  }
}

fn coproduct_exhaustiveness_variant_node(variant: TestClaimCoproductVariant) -> Node {
  Node {
    kind: TypeNode {
      connective: Atom { identity: discriminant(v: variant) }
    },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn coproduct_exhaustiveness_input(anchor: GeneratedAnchorKey) -> Node {
  Node {
    kind: TypeNode {
      connective: Atom { identity: ^coproduct_exhaustiveness_testclaim_variant }
    },
    children: [
      Edge {
        label: Named { name: ^coproduct_exhaustiveness_omitted_variant_edge },
        target: coproduct_exhaustiveness_variant_node(
          variant: coproduct_exhaustiveness_anchor_omitted_variant(anchor: anchor)
        )
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn coproduct_exhaustiveness_diagnostic(
  input: Node
) -> Diagnostic {
  Diagnostic {
    reason: ^coproduct_exhaustiveness_missing_variant,
    at: node_locus(node: input),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn testgen_emit_coproduct_exhaustiveness_claim(
  anchor: GeneratedAnchorKey
) -> Outcome<TestClaim> {
  let input = coproduct_exhaustiveness_input(anchor: anchor)
  Accepted {
    value: DiagnosticClaim {
      label: coproduct_exhaustiveness_label,
      anchor: generated_claim_anchor(anchor: anchor),
      input: input,
      expected_rejection: diagnostics_singleton(
        d: coproduct_exhaustiveness_diagnostic(input: input)
      ),
      classification: TestClassification { tier: Tier1, layer: Unit },
    },
    diagnostics: None,
  }
}

fn testgen_scheduled_coproduct_exhaustiveness_generators() -> List<Generator<TestgenConcept>> {
  [
    Generator {
      kind: TestClaimDiagnosticClaimVariant,
      classification: TestClassification { tier: Tier1, layer: Unit },
      anchor: generated_claim_anchor(
        anchor: coproduct_exhaustiveness_subject_testclaim_compiles()
      ),
      slot: DiagnosticExhaustiveness { omitted_variant: TestClaimCompilesClaimVariant },
      provenance: generator_provenance(id: generator_id_for_coproduct_variant(v: TestClaimCompilesClaimVariant)),
      profile_metadata: default_generator_profile(),
    },
    Generator {
      kind: TestClaimDiagnosticClaimVariant,
      classification: TestClassification { tier: Tier1, layer: Unit },
      anchor: generated_claim_anchor(
        anchor: coproduct_exhaustiveness_subject_testclaim_diagnostic()
      ),
      slot: DiagnosticExhaustiveness { omitted_variant: TestClaimDiagnosticClaimVariant },
      provenance: generator_provenance(id: generator_id_for_coproduct_variant(v: TestClaimDiagnosticClaimVariant)),
      profile_metadata: default_generator_profile(),
    },
    Generator {
      kind: TestClaimDiagnosticClaimVariant,
      classification: TestClassification { tier: Tier1, layer: Unit },
      anchor: generated_claim_anchor(
        anchor: coproduct_exhaustiveness_subject_testclaim_equals()
      ),
      slot: DiagnosticExhaustiveness { omitted_variant: TestClaimEqualsClaimVariant },
      provenance: generator_provenance(id: generator_id_for_coproduct_variant(v: TestClaimEqualsClaimVariant)),
      profile_metadata: default_generator_profile(),
    },
    Generator {
      kind: TestClaimDiagnosticClaimVariant,
      classification: TestClassification { tier: Tier1, layer: Unit },
      anchor: generated_claim_anchor(
        anchor: coproduct_exhaustiveness_subject_testclaim_roundtrip()
      ),
      slot: DiagnosticExhaustiveness { omitted_variant: TestClaimRoundTripClaimVariant },
      provenance: generator_provenance(id: generator_id_for_coproduct_variant(v: TestClaimRoundTripClaimVariant)),
      profile_metadata: default_generator_profile(),
    },
  ]
}

// F.2-P1 provenance integrity: a generator's identity must be the one DERIVED from its
// own canonical anchor (single-authority — no row carries a foreign/colliding id), and it
// must carry profile metadata. Checking against the anchor projection is the meaningful
// property; the emitted artifact's kind/id are carried structurally by the refined
// GeneratedArtifact + the total constructor, so they are not re-inspected here.
fn generator_carries_provenance<C>(g: Generator<C>) -> Bool {
  g.provenance.generator_id == generator_id_for_claim_anchor(anchor: g.anchor)
    && g.profile_metadata.profile_ref == ^testgen_default_profile_ref
}

fn all_generators_carry_provenance(gens: List<Generator<TestgenConcept>>) -> Bool {
  fold_list(
    xs: gens,
    empty: true,
    cons: fn(acc, g) { acc && generator_carries_provenance(g: g) },
  )
}

// Fail-closed: a scheduler that cannot produce its generators fails the witness rather
// than vacuously passing — the claim is that ALL scheduled generators carry provenance.
fn outcome_generators_carry_provenance(o: Outcome<List<Generator<TestgenConcept>>>) -> Bool {
  match o {
    Accepted { value: gens, diagnostics: d } => all_generators_carry_provenance(gens: gens)
    Rejected { diagnostics: d } => false
  }
}

// F.2-P1 close criterion: every scheduled generator carries consistent provenance +
// profile metadata. Covers ALL four scheduled producers — the two direct-List schedulers
// (LBE + coproduct-exhaustiveness) and the two Outcome-returning schedulers
// (refinement-preservation + algebra-law), the latter fail-closed on Rejected.
fn scheduled_generators_carry_provenance() -> Bool {
  all_generators_carry_provenance(gens: testgen_scheduled_language_behavior_generators())
    && all_generators_carry_provenance(gens: testgen_scheduled_coproduct_exhaustiveness_generators())
    && outcome_generators_carry_provenance(o: testgen_scheduled_refinement_preservation_generators())
    && outcome_generators_carry_provenance(o: testgen_scheduled_algebra_law_generators())
}

// F.2-P2 / F.2.6 — static schedulers (always List) plus Outcome schedulers combined
// fail-closed: any Rejected scheduler rejects the whole roster (P3 — no silent truncation).
fn testgen_scheduled_generators_static_base() -> List<Generator<TestgenConcept>> {
  list_append(
    left: testgen_scheduled_language_behavior_generators(),
    right: testgen_scheduled_coproduct_exhaustiveness_generators()
  )
}

fn testgen_scheduled_generators_outcome() -> Outcome<List<Generator<TestgenConcept>>> {
  let base = testgen_scheduled_generators_static_base()
  bind_outcome(
    o: testgen_scheduled_refinement_preservation_generators(),
    f: fn(refinement_gens) {
      bind_outcome(
        o: testgen_scheduled_algebra_law_generators(),
        f: fn(algebra_gens) {
          outcome_accepted(
            value: list_append(
              left: base,
              right: list_append(left: refinement_gens, right: algebra_gens)
            )
          )
        }
      )
    }
  )
}

fn testgen_scheduled_generators_roster_holds() -> Bool {
  match testgen_scheduled_generators_outcome() {
    Accepted { value: gens, diagnostics: _ } => length(xs: gens) > 0
    Rejected { diagnostics: _ } => false
  }
}

// 🟡 coproduct dissolution — feature:lens-testgen-shadow-ci-receipt — bind F.2-P2 / F.2.6 — dissolve-on-arrival: `TestClaimRun` evaluates `lens_testgen/shadow_ci_receipt.dag` `EqualsClaim` witnesses; delete `TestgenRunReceipt` when substrate eval owns roster facts; forbidden: permanent hand-Rust roster ratchet beside modeled witnesses.
type TestgenRunReceipt {
  profile_ref: Symbol
  generators: List<Generator<TestgenConcept>>
}

fn generator_matches_profile(g: Generator<TestgenConcept>, profile_ref: Symbol) -> Bool {
  g.profile_metadata.profile_ref == profile_ref
}

fn testgen_scheduled_generators_matching_profile(
  gens: List<Generator<TestgenConcept>>,
  profile_ref: Symbol
) -> List<Generator<TestgenConcept>> {
  filter(
    xs: gens,
    predicate: fn(g) {
      generator_matches_profile(g: g, profile_ref: profile_ref)
    }
  )
}

fn testgen_run_receipt_outcome(profile_ref: Symbol) -> Outcome<TestgenRunReceipt> {
  bind_outcome(
    o: testgen_scheduled_generators_outcome(),
    f: fn(gens) {
      let matched = testgen_scheduled_generators_matching_profile(gens: gens, profile_ref: profile_ref)
      if length(xs: matched) == 0 && length(xs: gens) > 0 {
        outcome_rejected(d: testgen_profile_roster_mismatch_diagnostic())
      } else {
        outcome_accepted(
          value: TestgenRunReceipt {
            profile_ref: profile_ref,
            generators: matched
          }
        )
      }
    }
  )
}

fn generator_id_eq(left: Generator<TestgenConcept>, right: Generator<TestgenConcept>) -> Bool {
  left.provenance.generator_id == right.provenance.generator_id
}

// Canonical roster equality for F.2-P2 receipts: FreeMonoid/List order is a carried fact
// (facts-flow-forward). Authority: v2.std.algebra.zip_eq + generator_id_eq per position.
fn testgen_generators_roster_equal_by_id(
  left: List<Generator<TestgenConcept>>,
  right: List<Generator<TestgenConcept>>
) -> Bool {
  zip_eq(
    a: left,
    b: right,
    eq: fn(l, r) {
      generator_id_eq(left: l, right: r)
    }
  )
}

fn testgen_run_receipt_carries_profile_roster(receipt: TestgenRunReceipt) -> Bool {
  match testgen_scheduled_generators_outcome() {
    Accepted { value: roster, diagnostics: _ } =>
      testgen_generators_roster_equal_by_id(
        left: receipt.generators,
        right: testgen_scheduled_generators_matching_profile(
          gens: roster,
          profile_ref: receipt.profile_ref
        )
      )
    Rejected { diagnostics: _ } => false
  }
}

fn manual_anchor_absent_bootstrap_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^manual_anchor_absent_bootstrap,
    at: Textual { file: ^testgen_lens_file, extent: WholeFile },
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn manual_test_claim_for_manual_anchor(key: ManualAnchorKey) -> Outcome<TestClaim> {
  match key {
    ManualAnchorAbsent =>
      Rejected { diagnostics: diagnostics_singleton(d: manual_anchor_absent_bootstrap_diagnostic()) }
    ManualTcConjEmpty => Accepted { value: claim_conj_empty_compiles, diagnostics: None }
    ManualTcDisjEmpty => Accepted { value: claim_disj_empty_compiles, diagnostics: None }
    ManualTcArrowTwoConj => Accepted { value: claim_arrow_two_conj_compiles, diagnostics: None }
    ManualTcCardinalityEmpty => Accepted { value: claim_cardinality_empty_rejected, diagnostics: None }
    ManualTcInstantiationEmpty => Accepted { value: claim_instantiation_empty_rejected, diagnostics: None }
    ManualTcArrowEmpty => Accepted { value: claim_arrow_empty_rejected, diagnostics: None }
    ManualTcTransformEmpty => Accepted { value: claim_transform_empty_rejected, diagnostics: None }
    ManualTcBranchEmpty => Accepted { value: claim_branch_empty_rejected, diagnostics: None }
    ManualTcLoopEmpty => Accepted { value: claim_loop_empty_rejected, diagnostics: None }
    ManualTcBindZeroChildren => Accepted { value: claim_bind_zero_children_rejected, diagnostics: None }
    ManualTcConjEqualsRefl => Accepted { value: claim_conj_equals_refl, diagnostics: None }
    ManualNatAddLeftIdentity => Accepted { value: claim_nat_add_left_identity, diagnostics: None }
    ManualNatAddRightIdentity => Accepted { value: claim_nat_add_right_identity, diagnostics: None }
    ManualNatAddAssociativity => Accepted { value: claim_nat_add_associativity, diagnostics: None }
    ManualNatMulLeftIdentity => Accepted { value: claim_nat_mul_left_identity, diagnostics: None }
    ManualNatMulAnnihilator => Accepted { value: claim_nat_mul_annihilator, diagnostics: None }
    ManualNatMulAssociativity => Accepted { value: claim_nat_mul_associativity, diagnostics: None }
    ManualLbeConjDagSurface =>
      testgen_emit_language_behavior_equivalence_claim(
        anchor: ManualLbeConjDagSurface,
        label: lbe_label_conj_dag_surface,
        mock: lbe_io_mock_conj_dag_surface()
      )
    ManualLbeDisjDagSurface =>
      testgen_emit_language_behavior_equivalence_claim(
        anchor: ManualLbeDisjDagSurface,
        label: lbe_label_disj_dag_surface,
        mock: lbe_io_mock_disj_dag_surface()
      )
    ManualLbeTransformDagSurface =>
      testgen_emit_language_behavior_equivalence_claim(
        anchor: ManualLbeTransformDagSurface,
        label: lbe_label_transform_dag_surface,
        mock: lbe_io_mock_transform_dag_surface()
      )
    ManualRefinementNonEmptyListBase =>
      match refinement_preservation_subject_nonempty_list_base() {
        Accepted { value: subject, diagnostics: None } =>
          testgen_emit_refinement_preservation_claim(
            anchor: ManualRefinementNonEmptyListBase,
            label: refinement_label_nonempty_list_base,
            subject: subject
          )
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
      }
  }
}

fn testgen_concept_for_manual_claim(claim: TestClaim) -> Outcome<TestgenConcept> {
  match test_claim_anchor(c: claim) {
    ManualClaimAnchor { manual_anchor: ManualAnchorAbsent } =>
      Rejected { diagnostics: diagnostics_singleton(d: manual_anchor_absent_bootstrap_diagnostic()) }
    ManualClaimAnchor { manual_anchor: ManualTcConjEmpty } =>
      Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: Conj },
        }, diagnostics: None }
    ManualClaimAnchor { manual_anchor: ManualTcDisjEmpty } =>
      Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: Disj },
        }, diagnostics: None }
    ManualClaimAnchor { manual_anchor: ManualTcArrowTwoConj } =>
      Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: Arrow },
        }, diagnostics: None }
    ManualClaimAnchor { manual_anchor: ManualTcCardinalityEmpty } =>
      Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: Cardinality },
        }, diagnostics: None }
    ManualClaimAnchor { manual_anchor: ManualTcInstantiationEmpty } =>
      Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: Instantiation },
        }, diagnostics: None }
    ManualClaimAnchor { manual_anchor: ManualTcArrowEmpty } =>
      Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: Arrow },
        }, diagnostics: None }
    ManualClaimAnchor { manual_anchor: ManualTcTransformEmpty } =>
      Accepted { value: TypeConstruction {
          subject: BehaviorValueSubject { behavior: Transform },
        }, diagnostics: None }
    ManualClaimAnchor { manual_anchor: ManualTcBranchEmpty } =>
      Accepted { value: TypeConstruction {
          subject: BehaviorValueSubject { behavior: Branch },
        }, diagnostics: None }
    ManualClaimAnchor { manual_anchor: ManualTcLoopEmpty } =>
      Accepted { value: TypeConstruction {
          subject: BehaviorValueSubject { behavior: Loop },
        }, diagnostics: None }
    ManualClaimAnchor { manual_anchor: ManualTcBindZeroChildren } =>
      Accepted { value: TypeConstruction {
          subject: BehaviorValueSubject { behavior: Bind },
        }, diagnostics: None }
    ManualClaimAnchor { manual_anchor: ManualTcConjEqualsRefl } =>
      Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: Conj },
        }, diagnostics: None }
    ManualClaimAnchor { manual_anchor: ManualNatAddLeftIdentity } =>
      testgen_algebra_law_concept_for_manual_nat_anchor(anchor: ManualNatAddLeftIdentity)
    ManualClaimAnchor { manual_anchor: ManualNatAddRightIdentity } =>
      testgen_algebra_law_concept_for_manual_nat_anchor(anchor: ManualNatAddRightIdentity)
    ManualClaimAnchor { manual_anchor: ManualNatAddAssociativity } =>
      testgen_algebra_law_concept_for_manual_nat_anchor(anchor: ManualNatAddAssociativity)
    ManualClaimAnchor { manual_anchor: ManualNatMulLeftIdentity } =>
      testgen_algebra_law_concept_for_manual_nat_anchor(anchor: ManualNatMulLeftIdentity)
    ManualClaimAnchor { manual_anchor: ManualNatMulAnnihilator } =>
      testgen_algebra_law_concept_for_manual_nat_anchor(anchor: ManualNatMulAnnihilator)
    ManualClaimAnchor { manual_anchor: ManualNatMulAssociativity } =>
      testgen_algebra_law_concept_for_manual_nat_anchor(anchor: ManualNatMulAssociativity)
    ManualClaimAnchor { manual_anchor: ManualLbeConjDagSurface } =>
      Accepted {
        value: LanguageBehaviorEquivalence {
          subject: lbe_subject_conj_dag_surface(),
          mock: lbe_io_mock_conj_dag_surface(),
        },
        diagnostics: None,
      }
    ManualClaimAnchor { manual_anchor: ManualLbeDisjDagSurface } =>
      Accepted {
        value: LanguageBehaviorEquivalence {
          subject: lbe_subject_disj_dag_surface(),
          mock: lbe_io_mock_disj_dag_surface(),
        },
        diagnostics: None,
      }
    ManualClaimAnchor { manual_anchor: ManualLbeTransformDagSurface } =>
      Accepted {
        value: LanguageBehaviorEquivalence {
          subject: lbe_subject_transform_dag_surface(),
          mock: lbe_io_mock_transform_dag_surface(),
        },
        diagnostics: None,
      }
    GeneratedClaimAnchor { generated_anchor: GeneratedCoproductExhaustiveness { omitted_variant: v } } =>
      Accepted {
        value: DiagnosticExhaustiveness { omitted_variant: v },
        diagnostics: None,
      }
    ManualClaimAnchor { manual_anchor: ManualRefinementNonEmptyListBase } =>
      match refinement_preservation_subject_nonempty_list_base() {
        Accepted { value: subject, diagnostics: None } =>
          Accepted {
            value: RefinementPreservation {
              subject: subject,
            },
            diagnostics: None,
          }
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
      }
    ManualClaimAnchor { manual_anchor: manual_anchor } =>
      match algebra_law_subject_for_manual_anchor(anchor: manual_anchor) {
        Accepted { value: subject, diagnostics: None } =>
          Accepted {
            value: AlgebraLaw {
              subject: subject,
            },
            diagnostics: None,
          }
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
      }
  }
}

fn bootstrap_claim_generator_for_manual_anchor(
  key: ManualAnchorKey
) -> Outcome<Generator<TestgenConcept>> {
  match manual_test_claim_for_manual_anchor(key: key) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: claim, diagnostics: d0 } =>
      match testgen_concept_for_manual_claim(claim: claim) {
        Rejected { diagnostics: r } =>
          Rejected { diagnostics: rejected_with_pending(pending: d0, rejected: r) }
        Accepted { value: slot, diagnostics: d1 } =>
          Accepted {
            value: Generator {
              kind: test_claim_coproduct_variant(c: claim),
              classification: test_claim_classification(c: claim),
              anchor: test_claim_anchor(c: claim),
              slot: slot,
              provenance: generator_provenance(id: generator_id_for_claim_anchor(anchor: test_claim_anchor(c: claim))),
              profile_metadata: default_generator_profile(),
            },
            diagnostics: diagnostics_merge(outer: d0, inner: d1)
          }
    }
  }
}
