  FrozenLanguageBehaviorSnapshot {
    language: ^dag_language_model_surface_id,
    input_node: v2.test.manual.connective_anchors.stub_empty_conj,
    expected_value: v2.test.manual.connective_anchors.stub_empty_conj,
  }
}

fn lbe_frozen_snapshot_disj_dag_surface() -> FrozenLanguageBehaviorSnapshot {
  FrozenLanguageBehaviorSnapshot {
    language: ^dag_language_model_surface_id,
    input_node: v2.test.manual.connective_anchors.stub_empty_disj,
    expected_value: v2.test.manual.connective_anchors.stub_empty_disj,
  }
}

fn lbe_frozen_snapshot_transform_dag_surface() -> FrozenLanguageBehaviorSnapshot {
  FrozenLanguageBehaviorSnapshot {
    language: ^dag_language_model_surface_id,
    input_node: v2.test.manual.connective_anchors.stub_empty_transform,
    expected_value: v2.test.manual.connective_anchors.stub_empty_transform,
  }
}

fn lbe_io_mock_conj_dag_surface() -> LanguageBehaviorIoMock {
  LanguageBehaviorIoMock { snapshot: lbe_frozen_snapshot_conj_dag_surface() }
}

fn lbe_io_mock_disj_dag_surface() -> LanguageBehaviorIoMock {
  LanguageBehaviorIoMock { snapshot: lbe_frozen_snapshot_disj_dag_surface() }
}

fn lbe_io_mock_transform_dag_surface() -> LanguageBehaviorIoMock {
  LanguageBehaviorIoMock { snapshot: lbe_frozen_snapshot_transform_dag_surface() }
}

fn lbe_subject_conj_dag_surface() -> LanguageBehaviorEquivalenceSubject {
  LanguageBehaviorEquivalenceSubject {
    subject: ConnectiveKernel { connective: v2.std.node.Conj },
    language: ^dag_language_model_surface_id,
  }
}

fn lbe_subject_disj_dag_surface() -> LanguageBehaviorEquivalenceSubject {
  LanguageBehaviorEquivalenceSubject {
    subject: ConnectiveKernel { connective: v2.std.node.Disj },
    language: ^dag_language_model_surface_id,
  }
}

fn lbe_subject_transform_dag_surface() -> LanguageBehaviorEquivalenceSubject {
  LanguageBehaviorEquivalenceSubject {
    subject: BehaviorValueSubject { behavior: v2.std.node.Transform },
    language: ^dag_language_model_surface_id,
  }
}

fn refine_nonempty_node_list(xs: List<v2.std.node.Node>, at: v2.std.diagnostic.Locus) -> v2.std.diagnostic.Outcome<v2.std.refinement.Refined<List<v2.std.node.Node>>> {
  v2.std.refinement.refine(
    base: xs,
    by: v2.std.refinement.Validation {
      reason: ^refinement_preservation_empty_list_reason,
      admits: fn(candidate) { v2.std.algebra.non_empty(xs: candidate) }
    },
    at: at
  )
}
fn refinement_preservation_list_node(xs: List<v2.std.node.Node>) -> v2.std.node.Node {
  v2.std.algebra.fold_list_right(
    xs: xs,
    empty: v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^refinement_preservation_list_empty_node } },
      children: [],
      occurrence_id: v2.std.node.SyntheticOccurrence
},
    snoc: fn(tail_node, h) {
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^refinement_preservation_list_cons_node } },
        children: [
          v2.std.node.Edge { label: v2.std.node.Named { name: ^refinement_preservation_list_head_edge }, target: h },
          v2.std.node.Edge {
            label: v2.std.node.Named { name: ^refinement_preservation_list_tail_edge },
            target: tail_node
          }
        ],
        occurrence_id: v2.std.node.SyntheticOccurrence
}
    }
  )
}

fn refinement_preservation_subject_nonempty_list_base() -> v2.std.diagnostic.Outcome<RefinementPreservationSubject> {
  let original = [v2.test.manual.connective_anchors.stub_empty_conj]
  match refine_nonempty_node_list(xs: original, at: v2.std.diagnostic.node_locus(node: v2.test.manual.connective_anchors.stub_empty_conj)) {
    v2.std.diagnostic.Accepted { value: refined, diagnostics: v2.std.diagnostic.None } =>
      v2.std.diagnostic.Accepted {
        value: RefinementPreservationSubject {
          refined: refined,
          original: original,
        },
        diagnostics: v2.std.diagnostic.None,
      }
    v2.std.diagnostic.Rejected { diagnostics: d } => v2.std.diagnostic.Rejected { diagnostics: d }
  }
}

fn testgen_emit_refinement_preservation_claim(
  anchor: v2.std.verification.ManualAnchorKey,
  label: String,
  subject: RefinementPreservationSubject
) -> v2.std.diagnostic.Outcome<v2.std.verification.TestClaim> {
  match anchor {
    v2.std.verification.ManualRefinementNonEmptyListBase =>
      v2.std.diagnostic.Accepted {
        value: v2.std.verification.EqualsClaim {
          label: label,
          anchor: v2.std.verification.manual_claim_anchor(anchor: anchor),
          lhs: refinement_preservation_list_node(
            xs: v2.std.refinement.refined_base(r: subject.refined)
          ),
          rhs: refinement_preservation_list_node(xs: subject.original),
          classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit },
        },
        diagnostics: v2.std.diagnostic.None,
      }
    _ =>
      v2.std.diagnostic.Rejected {
        diagnostics: v2.std.diagnostic.diagnostics_singleton(d: manual_anchor_absent_bootstrap_diagnostic()),
      }
  }
}

fn testgen_scheduled_refinement_preservation_generators() -> v2.std.diagnostic.Outcome<List<Generator<TestgenConcept>>> {
  match bootstrap_claim_generator_for_manual_anchor(key: v2.std.verification.ManualRefinementNonEmptyListBase) {
    v2.std.diagnostic.Accepted { value: generator, diagnostics: d } =>
      v2.std.diagnostic.Accepted {
        value: [generator],
        diagnostics: d,
      }
    v2.std.diagnostic.Rejected { diagnostics: d } => v2.std.diagnostic.Rejected { diagnostics: d }
  }
}

fn testgen_emit_idempotent_operation_equals_claim(
  label: String,
  subject: v2.std.effects.ComposableIdempotentOperationSubject,
  classification: v2.std.verification.TestClassification
) -> v2.std.diagnostic.Outcome<v2.std.verification.TestClaim> {
  v2.std.diagnostic.Accepted {
    value: v2.std.verification.EqualsClaim {
      label: label,
      anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
      lhs: v2.std.effects.idempotent_operation_apply_twice(state: v2.std.effects.sample_state, subject: subject),
      rhs: v2.std.effects.idempotent_operation_apply_once(state: v2.std.effects.sample_state, subject: subject),
      classification: classification,
    },
    diagnostics: v2.std.diagnostic.None,
  }
}

fn testgen_emit_idempotent_operation_claim(
  label: String,
  subject: v2.std.effects.IdempotentOperationSubject,
  classification: v2.std.verification.TestClassification
) -> v2.std.diagnostic.Outcome<v2.std.verification.TestClaim> {
  match subject {
    v2.std.effects.LabelOnlyIdempotentInhabitance { shape: _, label: _ } =>
      v2.std.diagnostic.Rejected {
        diagnostics: v2.std.diagnostic.diagnostics_singleton(
          d: v2.std.diagnostic.Diagnostic {
            reason: ^idempotent_operation_tautology_skip,
            at: v2.std.diagnostic.Textual { file: ^testgen_lens_file, extent: v2.std.diagnostic.WholeFile },
            correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.UserInputBoundary }
          }
        )
      }
    v2.std.effects.Composable(inner) =>
      testgen_emit_idempotent_operation_equals_claim(
        label: label,
        subject: inner,
        classification: classification
      )
  }
}

fn testgen_scheduled_idempotent_operation_subjects() -> List<v2.std.effects.ComposableIdempotentOperationSubject> {
  [
    v2.std.effects.sample_read_composable,
    v2.std.effects.sample_upsert_composable,
    v2.std.effects.sample_delete_composable,
    v2.std.effects.sample_create_if_absent_composable,
  ]
}

fn testgen_emit_language_behavior_equivalence_claim(
  anchor: v2.std.verification.ManualAnchorKey,
  label: String,
  mock: LanguageBehaviorIoMock
) -> v2.std.diagnostic.Outcome<v2.std.verification.TestClaim> {
  let snap = mock.snapshot
  match anchor {
    v2.std.verification.ManualLbeConjDagSurface =>
      v2.std.diagnostic.Accepted {
        value: v2.std.verification.CompilesClaim {
          label: label,
          anchor: v2.std.verification.manual_claim_anchor(anchor: anchor),
          input: snap.input_node,
          expected_value: snap.expected_value,
          classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit },
        },
        diagnostics: v2.std.diagnostic.None,
      }
    v2.std.verification.ManualLbeDisjDagSurface =>
      v2.std.diagnostic.Accepted {
        value: v2.std.verification.CompilesClaim {
          label: label,
          anchor: v2.std.verification.manual_claim_anchor(anchor: anchor),
          input: snap.input_node,
          expected_value: snap.expected_value,
          classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit },
        },
        diagnostics: v2.std.diagnostic.None,
      }
    v2.std.verification.ManualLbeTransformDagSurface =>
      v2.std.diagnostic.Accepted {
        value: v2.std.verification.CompilesClaim {
          label: label,
          anchor: v2.std.verification.manual_claim_anchor(anchor: anchor),
          input: snap.input_node,
          expected_value: snap.expected_value,
          classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit },
        },
        diagnostics: v2.std.diagnostic.None,
      }
    _ =>
      v2.std.diagnostic.Rejected {
        diagnostics: v2.std.diagnostic.diagnostics_singleton(d: manual_anchor_absent_bootstrap_diagnostic()),
      }
  }
}

fn testgen_emit_algebra_law_claim(
  anchor: v2.std.verification.ManualAnchorKey,
  label: String,
  lhs: v2.std.node.Node,
  rhs: v2.std.node.Node,
  classification: v2.std.verification.TestClassification
) -> v2.std.diagnostic.Outcome<v2.std.verification.TestClaim> {
  if lhs == rhs {
    v2.std.diagnostic.Rejected {
      diagnostics: v2.std.diagnostic.diagnostics_singleton(
        d: v2.std.diagnostic.Diagnostic {
          reason: ^t19_algebra_law_tautological_sides,
          at: v2.std.diagnostic.Textual { file: ^testgen_lens_file, extent: v2.std.diagnostic.WholeFile },
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.UserInputBoundary }
        }
      )
    }
  } else {
    match algebra_law_manual_claim_case(anchor: anchor) {
      v2.std.diagnostic.Accepted { value: law_case, diagnostics: v2.std.diagnostic.None } =>
        v2.std.diagnostic.Accepted {
          value: v2.std.verification.EqualsClaim {
            label: label,
            anchor: law_case.anchor,
            lhs: algebra_law_claim_term(subject: law_case.subject, expression: lhs),
            rhs: algebra_law_claim_term(subject: law_case.subject, expression: rhs),
            classification: classification,
          },
          diagnostics: v2.std.diagnostic.None,
        }
      v2.std.diagnostic.Rejected { diagnostics: d } =>
        v2.std.diagnostic.Rejected { diagnostics: d }
    }
  }
}

fn algebra_law_manual_claim_case(anchor: v2.std.verification.ManualAnchorKey) -> v2.std.diagnostic.Outcome<AlgebraLawCase> {
  match algebra_law_subject_for_manual_anchor(anchor: anchor) {
    v2.std.diagnostic.Accepted { value: subject, diagnostics: v2.std.diagnostic.None } =>
      v2.std.diagnostic.Accepted {
        value: AlgebraLawCase {
          anchor: v2.std.verification.manual_claim_anchor(anchor: anchor),
          subject: subject,
        },
        diagnostics: v2.std.diagnostic.None,
      }
    v2.std.diagnostic.Rejected { diagnostics: d } =>
      v2.std.diagnostic.Rejected { diagnostics: d }
  }
}

fn algebra_law_subject_for_manual_anchor(anchor: v2.std.verification.ManualAnchorKey) -> v2.std.diagnostic.Outcome<AlgebraLawSubject> {
  match anchor {
    v2.std.verification.ManualNatAddLeftIdentity =>
      v2.std.diagnostic.Accepted {
        value: AlgebraLawSubject {
          algebra: ^nat_algebra_law_subject_symbol_additive_monoid,
          inhabitant: ^nat_algebra_law_subject_symbol_inhabitant_nat,
          law: ^law_nat_add_left_identity,
        },
        diagnostics: v2.std.diagnostic.None,
      }
    v2.std.verification.ManualNatAddRightIdentity =>
      v2.std.diagnostic.Accepted {
        value: AlgebraLawSubject {
          algebra: ^nat_algebra_law_subject_symbol_additive_monoid,
          inhabitant: ^nat_algebra_law_subject_symbol_inhabitant_nat,
          law: ^law_nat_add_right_identity,
        },
        diagnostics: v2.std.diagnostic.None,
      }
    v2.std.verification.ManualNatAddAssociativity =>
      v2.std.diagnostic.Accepted {
        value: AlgebraLawSubject {
          algebra: ^nat_algebra_law_subject_symbol_additive_monoid,
          inhabitant: ^nat_algebra_law_subject_symbol_inhabitant_nat,
          law: ^law_nat_add_associativity,
        },
        diagnostics: v2.std.diagnostic.None,
      }
    v2.std.verification.ManualNatMulLeftIdentity =>
      v2.std.diagnostic.Accepted {
        value: AlgebraLawSubject {
          algebra: ^nat_algebra_law_subject_symbol_commutative_semiring,
          inhabitant: ^nat_algebra_law_subject_symbol_inhabitant_nat,
          law: ^law_nat_mul_left_identity,
        },
        diagnostics: v2.std.diagnostic.None,
      }
    v2.std.verification.ManualNatMulAnnihilator =>
      v2.std.diagnostic.Accepted {
        value: AlgebraLawSubject {
          algebra: ^nat_algebra_law_subject_symbol_commutative_semiring,
          inhabitant: ^nat_algebra_law_subject_symbol_inhabitant_nat,
          law: ^law_nat_mul_annihilator,
        },
        diagnostics: v2.std.diagnostic.None,
      }
    v2.std.verification.ManualNatMulAssociativity =>
      v2.std.diagnostic.Accepted {
        value: AlgebraLawSubject {
          algebra: ^nat_algebra_law_subject_symbol_commutative_semiring,
          inhabitant: ^nat_algebra_law_subject_symbol_inhabitant_nat,
          law: ^law_nat_mul_associativity,
        },
        diagnostics: v2.std.diagnostic.None,
      }
    _ =>
      v2.std.diagnostic.Rejected {
        diagnostics: v2.std.diagnostic.diagnostics_singleton(
          d: v2.std.diagnostic.Diagnostic {
            reason: ^algebra_law_anchor_mismatch,
            at: v2.std.diagnostic.Textual { file: ^testgen_lens_file, extent: v2.std.diagnostic.WholeFile },
            correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.UserInputBoundary }
          }
        )
      }
  }
}

fn algebra_law_subject_atom(s: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } }, children: [],
 occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn algebra_law_subject_node(subject: AlgebraLawSubject) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge { label: v2.std.node.Named { name: ^t19_algebra_law_algebra_field }, target: algebra_law_subject_atom(s: subject.algebra) },
      v2.std.node.Edge { label: v2.std.node.Named { name: ^t19_algebra_law_inhabitant_field }, target: algebra_law_subject_atom(s: subject.inhabitant) },
      v2.std.node.Edge { label: v2.std.node.Named { name: ^t19_algebra_law_law_field }, target: algebra_law_subject_atom(s: subject.law) },
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn algebra_law_claim_term(subject: AlgebraLawSubject, expression: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge { label: v2.std.node.Named { name: ^t19_algebra_law_subject_field }, target: algebra_law_subject_node(subject: subject) },
      v2.std.node.Edge { label: v2.std.node.Named { name: ^t19_algebra_law_expression_field }, target: expression },
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn witness_validity_symbol_atom_node(s: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn witness_validity_predicate_node(p: v2.std.find_witness.PreservationPredicate) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge { label: v2.std.node.Named { name: ^witness_validity_field_algebra }, target: p.algebra },
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^witness_validity_field_preservation_rule },
        target: witness_validity_symbol_atom_node(s: p.preservation_rule)
      }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn witness_validity_witness_node(w: v2.std.witness.StructuralPropertyWitness) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^witness_validity_field_property },
        target: witness_validity_symbol_atom_node(s: w.property)
      },
      v2.std.node.Edge { label: v2.std.node.Named { name: ^witness_validity_field_evidence }, target: w.evidence }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn witness_validity_byte_range_unencodable_diagnostic(at_node: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^witness_validity_byte_range_unencodable,
    at: v2.std.diagnostic.node_locus(node: at_node),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn witness_validity_subject_node(
  source_facts: v2.std.node.Node,
  candidate: v2.std.node.Node,
  predicate: v2.std.find_witness.PreservationPredicate,
  witness: v2.std.witness.StructuralPropertyWitness
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: witness_validity_outcome_node(
      o: v2.std.find_witness.verify_witness(
        source_facts: source_facts,
        candidate: candidate,
        predicate: predicate,
        witness: witness
      )
    ),
    f: fn(oracle_outcome) {
      v2.std.diagnostic.Accepted {
        value: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
          children: [
            v2.std.node.Edge { label: v2.std.node.Named { name: ^witness_validity_field_source_facts }, target: source_facts },
            v2.std.node.Edge { label: v2.std.node.Named { name: ^witness_validity_field_candidate }, target: candidate },
            v2.std.node.Edge {
              label: v2.std.node.Named { name: ^witness_validity_field_predicate },
              target: witness_validity_predicate_node(p: predicate)
            },
            v2.std.node.Edge {
              label: v2.std.node.Named { name: ^witness_validity_field_witness },
              target: witness_validity_witness_node(w: witness)
            },
            v2.std.node.Edge {
              label: v2.std.node.Named { name: ^witness_validity_field_oracle_outcome },
              target: oracle_outcome
            }
          ],
          occurrence_id: v2.std.node.SyntheticOccurrence
},
        diagnostics: v2.std.diagnostic.None
      }
    }
  )
}

fn witness_validity_no_correction_reason_node(r: v2.std.diagnostic.NoCorrectionReason) -> v2.std.node.Node {
  match r {
    v2.std.diagnostic.UserInputBoundary =>
      witness_validity_symbol_atom_node(s: ^witness_validity_no_correction_tag_user)
    v2.std.diagnostic.AmbiguousIntent =>
      witness_validity_symbol_atom_node(s: ^witness_validity_no_correction_tag_ambiguous)
    v2.std.diagnostic.ExternalContractUnknown =>
      witness_validity_symbol_atom_node(s: ^witness_validity_no_correction_tag_external)
    CorrectionNotModeled =>
      witness_validity_symbol_atom_node(s: ^witness_validity_no_correction_tag_not_modeled)
  }
}

fn witness_validity_correction_node(c: v2.std.diagnostic.Correction) -> v2.std.node.Node {
  match c {
    v2.std.diagnostic.Suggested { node: n } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
        children: [
          v2.std.node.Edge { label: v2.std.node.Named { name: ^witness_validity_correction_tag_suggested }, target: n }
        ],
        occurrence_id: v2.std.node.SyntheticOccurrence
}
    v2.std.diagnostic.Unavailable { reason: r } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
        children: [
          v2.std.node.Edge {
            label: v2.std.node.Named { name: ^witness_validity_correction_tag_unavailable },
            target: witness_validity_no_correction_reason_node(r: r)
          }
        ],
        occurrence_id: v2.std.node.SyntheticOccurrence
}
  }
}

fn witness_validity_extent_node(e: v2.std.diagnostic.Extent) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match e {
    v2.std.diagnostic.WholeFile =>
      v2.std.diagnostic.Accepted {
        value: witness_validity_symbol_atom_node(s: ^witness_validity_extent_tag_whole_file),
        diagnostics: v2.std.diagnostic.None
      }
    v2.std.diagnostic.ByteRange { start: _, end: _ } =>
      v2.std.diagnostic.outcome_rejected(
        d: witness_validity_byte_range_unencodable_diagnostic(
          at_node: witness_validity_symbol_atom_node(s: ^witness_validity_extent_tag_byte_range)
        )
      )
  }
}

fn witness_validity_locus_node(l: v2.std.diagnostic.Locus) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match l {
    v2.std.diagnostic.Textual { file: f, extent: e } =>
      v2.std.diagnostic.bind_outcome(o: witness_validity_extent_node(e: e), f: fn(en) {
        v2.std.diagnostic.Accepted {
          value: v2.std.node.Node {
            kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
            children: [
              v2.std.node.Edge {
                label: v2.std.node.Named { name: ^witness_validity_locus_tag_textual },
                target: v2.std.node.Node {
                  kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
                  children: [
                    v2.std.node.Edge {
                      label: v2.std.node.Named { name: ^witness_validity_locus_textual_file },
                      target: witness_validity_symbol_atom_node(s: f)
                    },
                    v2.std.node.Edge {
                      label: v2.std.node.Named { name: ^witness_validity_locus_textual_extent },
                      target: en
                    }
                  ],
                  occurrence_id: v2.std.node.SyntheticOccurrence
}
              }
            ],
            occurrence_id: v2.std.node.SyntheticOccurrence
},
          diagnostics: v2.std.diagnostic.None
        }
      })
    v2.std.diagnostic.NodeLocus { anchor: a } =>
      v2.std.diagnostic.Accepted {
        value: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
          children: [
            v2.std.node.Edge { label: v2.std.node.Named { name: ^witness_validity_locus_tag_node }, target: a.at }
          ],
          occurrence_id: v2.std.node.SyntheticOccurrence
},
        diagnostics: v2.std.diagnostic.None
      }
    v2.std.diagnostic.PortLocus { anchor: a } =>
      v2.std.diagnostic.Accepted {
        value: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
          children: [
            v2.std.node.Edge {
              label: v2.std.node.Named { name: ^witness_validity_locus_tag_port },
              target: witness_validity_symbol_atom_node(s: a.at)
            }
          ],
          occurrence_id: v2.std.node.SyntheticOccurrence
},
        diagnostics: v2.std.diagnostic.None
      }
  }
}

fn witness_validity_diagnostic_node(d: v2.std.diagnostic.Diagnostic) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(o: witness_validity_locus_node(l: d.at), f: fn(at_node) {
    v2.std.diagnostic.Accepted {
      value: v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
        children: [
          v2.std.node.Edge {
            label: v2.std.node.Named { name: ^witness_validity_diag_field_reason },
            target: witness_validity_symbol_atom_node(s: d.reason)
          },
          v2.std.node.Edge {
            label: v2.std.node.Named { name: ^witness_validity_diag_field_at },
            target: at_node
          },
          v2.std.node.Edge {
            label: v2.std.node.Named { name: ^witness_validity_diag_field_correction },
            target: witness_validity_correction_node(c: d.correction)
          }
        ],
        occurrence_id: v2.std.node.SyntheticOccurrence
},
      diagnostics: v2.std.diagnostic.None
    }
  })
}

fn witness_validity_diagnostic_list_node(xs: std.algebra.FreeMonoid<v2.std.diagnostic.Diagnostic>) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.algebra.fold_list_right(
    xs: xs,
    empty: v2.std.diagnostic.Accepted {
      value: witness_validity_symbol_atom_node(s: ^witness_validity_list_tag_empty),
      diagnostics: v2.std.diagnostic.None
    },
    snoc: fn(acc, h) {
      v2.std.diagnostic.bind_outcome(o: acc, f: fn(prev_node) {
        v2.std.diagnostic.bind_outcome(o: witness_validity_diagnostic_node(d: h), f: fn(hn) {
          v2.std.diagnostic.Accepted {
            value: v2.std.node.Node {
              kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
              children: [
                v2.std.node.Edge { label: v2.std.node.Named { name: ^witness_validity_list_cons_head }, target: hn },
                v2.std.node.Edge { label: v2.std.node.Named { name: ^witness_validity_list_cons_tail }, target: prev_node }
              ],
              occurrence_id: v2.std.node.SyntheticOccurrence
},
            diagnostics: v2.std.diagnostic.None
          }
        })
      })
    }
  )
}

fn witness_validity_non_empty_diagnostics_node(d: v2.std.diagnostic.NonEmptyDiagnostics) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(o: witness_validity_diagnostic_node(d: d.head), f: fn(hn) {
    v2.std.diagnostic.bind_outcome(o: witness_validity_diagnostic_list_node(xs: d.tail), f: fn(tn) {
      v2.std.diagnostic.Accepted {
        value: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
          children: [
            v2.std.node.Edge {
              label: v2.std.node.Named { name: ^witness_validity_diags_field_head },
              target: hn
            },
            v2.std.node.Edge {
              label: v2.std.node.Named { name: ^witness_validity_diags_field_tail },
              target: tn
            }
          ],
          occurrence_id: v2.std.node.SyntheticOccurrence
},
        diagnostics: v2.std.diagnostic.None
      }
    })
  })
}

fn witness_validity_diagnostics_node(ds: v2.std.diagnostic.Diagnostics) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match ds {
    v2.std.diagnostic.None =>
      v2.std.diagnostic.Accepted {
        value: witness_validity_symbol_atom_node(s: ^witness_validity_diagnostics_tag_none),
        diagnostics: v2.std.diagnostic.None
      }
    v2.std.diagnostic.Some { diagnostics: nd } =>
      v2.std.diagnostic.bind_outcome(o: witness_validity_non_empty_diagnostics_node(d: nd), f: fn(ndn) {
        v2.std.diagnostic.Accepted {
          value: v2.std.node.Node {
            kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
            children: [
              v2.std.node.Edge {
                label: v2.std.node.Named { name: ^witness_validity_diagnostics_tag_some },
                target: ndn
              }
            ],
            occurrence_id: v2.std.node.SyntheticOccurrence
},
          diagnostics: v2.std.diagnostic.None
        }
      })
  }
}

fn witness_validity_outcome_node(o: v2.std.diagnostic.Outcome<v2.std.witness.StructuralPropertyWitness>) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match o {
    v2.std.diagnostic.Accepted { value: w, diagnostics: ds } =>
      v2.std.diagnostic.bind_outcome(o: witness_validity_diagnostics_node(ds: ds), f: fn(dsn) {
        v2.std.diagnostic.Accepted {
          value: v2.std.node.Node {
            kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
            children: [
              v2.std.node.Edge {
                label: v2.std.node.Named { name: ^witness_validity_outcome_holds },
                target: v2.std.node.Node {
                  kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
                  children: [
                    v2.std.node.Edge {
                      label: v2.std.node.Named { name: ^witness_validity_outcome_accepted_value },
                      target: witness_validity_witness_node(w: w)
                    },
                    v2.std.node.Edge {
                      label: v2.std.node.Named { name: ^witness_validity_outcome_accepted_diagnostics },
                      target: dsn
                    }
                  ],
                  occurrence_id: v2.std.node.SyntheticOccurrence
}
              }
            ],
            occurrence_id: v2.std.node.SyntheticOccurrence
},
          diagnostics: v2.std.diagnostic.None
        }
      })
    v2.std.diagnostic.Rejected { diagnostics: d } =>
      v2.std.diagnostic.bind_outcome(o: witness_validity_non_empty_diagnostics_node(d: d), f: fn(dn) {
        v2.std.diagnostic.Accepted {
          value: v2.std.node.Node {
            kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
            children: [
              v2.std.node.Edge {
                label: v2.std.node.Named { name: ^witness_validity_outcome_violates },
                target: dn
              }
            ],
            occurrence_id: v2.std.node.SyntheticOccurrence
},
          diagnostics: v2.std.diagnostic.None
        }
      })
  }
}

fn testgen_emit_witness_validity_claim(
  label: String,
  source_facts: v2.std.node.Node,
  candidate: v2.std.node.Node,
  predicate: v2.std.find_witness.PreservationPredicate,
  witness: v2.std.witness.StructuralPropertyWitness
) -> v2.std.diagnostic.Outcome<v2.std.verification.TestClaim> {
  v2.std.diagnostic.bind_outcome(
    o: witness_validity_subject_node(
      source_facts: source_facts,
      candidate: candidate,
      predicate: predicate,
      witness: witness
    ),
    f: fn(input_node) {
      v2.std.diagnostic.Accepted {
        value: v2.std.verification.RoundTripClaim {
          label: label,
          anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
          input: input_node,
          classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit }
        },
        diagnostics: v2.std.diagnostic.None
      }
    }
  )
}

fn testgen_scheduled_language_behavior_generators() -> List<Generator<TestgenConcept>> {
  [
    Generator {
      kind: v2.std.verification.TestClaimCompilesClaimVariant,
      classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit },
      anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualLbeConjDagSurface),
      slot: LanguageBehaviorEquivalence {
        subject: lbe_subject_conj_dag_surface(),
        mock: lbe_io_mock_conj_dag_surface(),
      },
      provenance: generator_provenance(id: generator_id_for_manual_anchor(key: v2.std.verification.ManualLbeConjDagSurface)),
      profile_metadata: default_generator_profile(),
    },
    Generator {
      kind: v2.std.verification.TestClaimCompilesClaimVariant,
      classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit },
      anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualLbeDisjDagSurface),
      slot: LanguageBehaviorEquivalence {
        subject: lbe_subject_disj_dag_surface(),
        mock: lbe_io_mock_disj_dag_surface(),
      },
      provenance: generator_provenance(id: generator_id_for_manual_anchor(key: v2.std.verification.ManualLbeDisjDagSurface)),
      profile_metadata: default_generator_profile(),
    },
    Generator {
      kind: v2.std.verification.TestClaimCompilesClaimVariant,
      classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit },
      anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualLbeTransformDagSurface),
      slot: LanguageBehaviorEquivalence {
        subject: lbe_subject_transform_dag_surface(),
        mock: lbe_io_mock_transform_dag_surface(),
      },
      provenance: generator_provenance(id: generator_id_for_manual_anchor(key: v2.std.verification.ManualLbeTransformDagSurface)),
      profile_metadata: default_generator_profile(),
    },
  ]
}

fn testgen_non_algebra_law_scheduled_slot_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^testgen_non_algebra_law_scheduled_slot,
    at: v2.std.diagnostic.Textual { file: ^testgen_lens_file, extent: v2.std.diagnostic.WholeFile },
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.UserInputBoundary }
  }
}

type NatAlgebraLawScheduleRow {
  obligation: v2.std.nat.NatAlgebraLawObligation
  anchor: v2.std.verification.ManualAnchorKey
}

fn algebra_law_subject_from_nat_obligation(o: v2.std.nat.NatAlgebraLawObligation) -> AlgebraLawSubject {
  AlgebraLawSubject {
    algebra: o.algebra,
    inhabitant: o.inhabitant,
    law: o.law,
  }
}

fn append_nat_obligation_if_law_matches(
  found: v2.std.diagnostic.Outcome<v2.std.nat.NatAlgebraLawObligation>,
  obligation: v2.std.nat.NatAlgebraLawObligation,
  law: v2.std.node.Symbol
) -> v2.std.diagnostic.Outcome<v2.std.nat.NatAlgebraLawObligation> {
  match found {
    v2.std.diagnostic.Accepted { value: _, diagnostics: v2.std.diagnostic.None } => found
    v2.std.diagnostic.Rejected { diagnostics: _ } =>
      if obligation.law == law {
        v2.std.diagnostic.Accepted { value: obligation, diagnostics: v2.std.diagnostic.None }
      } else {
        found
      }
  }
}

fn nat_algebra_law_obligation_for_law(law: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<v2.std.nat.NatAlgebraLawObligation> {
  v2.std.algebra.fold_list(
    xs: v2.std.nat.nat_declared_algebra_law_obligations(),
    empty: v2.std.diagnostic.Rejected {
      diagnostics: v2.std.diagnostic.diagnostics_singleton(
        d: v2.std.diagnostic.Diagnostic {
          reason: ^testgen_non_algebra_law_scheduled_slot,
          at: v2.std.diagnostic.Textual { file: ^testgen_lens_file, extent: v2.std.diagnostic.WholeFile },
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.UserInputBoundary }
        }
      )
    },
    cons: fn(found, obligation) {
      append_nat_obligation_if_law_matches(
        found: found,
        obligation: obligation,
        law: law
      )
    }
  )
}

fn testgen_manual_anchor_for_law(law: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<v2.std.verification.ManualAnchorKey> {
  if law == ^law_nat_add_left_identity {
    v2.std.diagnostic.Accepted { value: v2.std.verification.ManualNatAddLeftIdentity, diagnostics: v2.std.diagnostic.None }
  } else if law == ^law_nat_add_right_identity {
    v2.std.diagnostic.Accepted { value: v2.std.verification.ManualNatAddRightIdentity, diagnostics: v2.std.diagnostic.None }
  } else if law == ^law_nat_add_associativity {
    v2.std.diagnostic.Accepted { value: v2.std.verification.ManualNatAddAssociativity, diagnostics: v2.std.diagnostic.None }
  } else if law == ^law_nat_mul_left_identity {
    v2.std.diagnostic.Accepted { value: v2.std.verification.ManualNatMulLeftIdentity, diagnostics: v2.std.diagnostic.None }
  } else if law == ^law_nat_mul_annihilator {
    v2.std.diagnostic.Accepted { value: v2.std.verification.ManualNatMulAnnihilator, diagnostics: v2.std.diagnostic.None }
  } else if law == ^law_nat_mul_associativity {
    v2.std.diagnostic.Accepted { value: v2.std.verification.ManualNatMulAssociativity, diagnostics: v2.std.diagnostic.None }
  } else {
    v2.std.diagnostic.Rejected {
      diagnostics: v2.std.diagnostic.diagnostics_singleton(
        d: testgen_non_algebra_law_scheduled_slot_diagnostic()
      )
    }
  }
}

fn testgen_manual_anchor_from_nat_obligation(
  o: v2.std.nat.NatAlgebraLawObligation
) -> v2.std.diagnostic.Outcome<v2.std.verification.ManualAnchorKey> {
  testgen_manual_anchor_for_law(law: o.law)
}

fn nat_algebra_law_schedule_row_from_obligation(
  obligation: v2.std.nat.NatAlgebraLawObligation
) -> v2.std.diagnostic.Outcome<NatAlgebraLawScheduleRow> {
  v2.std.diagnostic.bind_outcome(
    o: testgen_manual_anchor_for_law(law: obligation.law),
    f: fn(anchor) {
      v2.std.diagnostic.Accepted {
        value: NatAlgebraLawScheduleRow { obligation: obligation, anchor: anchor },
        diagnostics: v2.std.diagnostic.None,
      }
    }
  )
}

fn nat_manual_anchor_key_eq(a: v2.std.verification.ManualAnchorKey, b: v2.std.verification.ManualAnchorKey) -> Bool {
  match a {
    v2.std.verification.ManualNatAddLeftIdentity =>
      match b {
        v2.std.verification.ManualNatAddLeftIdentity => true
        _ => false
      }
    v2.std.verification.ManualNatAddRightIdentity =>
      match b {
        v2.std.verification.ManualNatAddRightIdentity => true
        _ => false
      }
    v2.std.verification.ManualNatAddAssociativity =>
      match b {
        v2.std.verification.ManualNatAddAssociativity => true
        _ => false
      }
    v2.std.verification.ManualNatMulLeftIdentity =>
      match b {
        v2.std.verification.ManualNatMulLeftIdentity => true
        _ => false
      }
    v2.std.verification.ManualNatMulAnnihilator =>
      match b {
        v2.std.verification.ManualNatMulAnnihilator => true
        _ => false
      }
    v2.std.verification.ManualNatMulAssociativity =>
      match b {
        v2.std.verification.ManualNatMulAssociativity => true
        _ => false
      }
    _ => false
  }
}

fn append_nat_algebra_law_schedule_row_if_anchor_matches(
  found: v2.std.diagnostic.Outcome<NatAlgebraLawScheduleRow>,
  obligation: v2.std.nat.NatAlgebraLawObligation,
  anchor: v2.std.verification.ManualAnchorKey
) -> v2.std.diagnostic.Outcome<NatAlgebraLawScheduleRow> {
  match found {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => found
    v2.std.diagnostic.Rejected { diagnostics: _ } =>
      v2.std.diagnostic.bind_outcome(
        o: nat_algebra_law_schedule_row_from_obligation(obligation: obligation),
        f: fn(row) {
          if nat_manual_anchor_key_eq(a: row.anchor, b: anchor) {
            v2.std.diagnostic.Accepted { value: row, diagnostics: v2.std.diagnostic.None }
          } else {
            found
          }
        }
      )
  }
}

fn nat_algebra_law_schedule_row_for_manual_anchor(
  anchor: v2.std.verification.ManualAnchorKey
) -> v2.std.diagnostic.Outcome<NatAlgebraLawScheduleRow> {
  v2.std.algebra.fold_list(
    xs: v2.std.nat.nat_declared_algebra_law_obligations(),
    empty: v2.std.diagnostic.Rejected {
      diagnostics: v2.std.diagnostic.diagnostics_singleton(
        d: testgen_non_algebra_law_scheduled_slot_diagnostic()
      )
    },
    cons: fn(found, obligation) {
      append_nat_algebra_law_schedule_row_if_anchor_matches(
        found: found,
        obligation: obligation,
        anchor: anchor
      )
    }
  )
}

fn testgen_algebra_law_generator_from_nat_obligation(
  obligation: v2.std.nat.NatAlgebraLawObligation
) -> v2.std.diagnostic.Outcome<Generator<TestgenConcept>> {
  v2.std.diagnostic.bind_outcome(
    o: testgen_manual_anchor_from_nat_obligation(o: obligation),
    f: fn(anchor) {
      v2.std.diagnostic.Accepted {
        value: Generator {
          kind: v2.std.verification.TestClaimEqualsClaimVariant,
          classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit },
          anchor: v2.std.verification.manual_claim_anchor(anchor: anchor),
          slot: AlgebraLaw {
            subject: algebra_law_subject_from_nat_obligation(o: obligation),
          },
          provenance: generator_provenance(id: generator_id_for_manual_anchor(key: anchor)),
          profile_metadata: default_generator_profile(),
        },
        diagnostics: v2.std.diagnostic.None,
      }
    }
  )
}

fn append_algebra_law_generator_from_nat_obligation(
  acc: v2.std.diagnostic.Outcome<List<Generator<TestgenConcept>>>,
  obligation: v2.std.nat.NatAlgebraLawObligation
) -> v2.std.diagnostic.Outcome<List<Generator<TestgenConcept>>> {
  v2.std.diagnostic.bind_outcome(
    o: acc,
    f: fn(acc) {
      v2.std.diagnostic.bind_outcome(
        o: testgen_algebra_law_generator_from_nat_obligation(obligation: obligation),
        f: fn(generator) {
          v2.std.diagnostic.Accepted {
            value: v2.std.algebra.list_snoc_item(xs: acc, item: generator),
            diagnostics: v2.std.diagnostic.None,
          }
        }
      )
    }
  )
}

fn testgen_scheduled_algebra_law_generators() -> v2.std.diagnostic.Outcome<List<Generator<TestgenConcept>>> {
  v2.std.algebra.fold_list_right(
    xs: v2.std.nat.nat_declared_algebra_law_obligations(),
    empty: v2.std.diagnostic.outcome_accepted(value: std.algebra.Empty),
    snoc: fn(o, obligation) {
      append_algebra_law_generator_from_nat_obligation(
        acc: o,
        obligation: obligation
      )
    }
  )
}

fn nat_algebra_law_obligation_for_manual_anchor(
  anchor: v2.std.verification.ManualAnchorKey
) -> v2.std.diagnostic.Outcome<v2.std.nat.NatAlgebraLawObligation> {
  v2.std.diagnostic.bind_outcome(
    o: nat_algebra_law_schedule_row_for_manual_anchor(anchor: anchor),
    f: fn(row) {
      v2.std.diagnostic.Accepted { value: row.obligation, diagnostics: v2.std.diagnostic.None }
    }
  )
}

fn testgen_algebra_law_concept_for_manual_nat_anchor(
  anchor: v2.std.verification.ManualAnchorKey
) -> v2.std.diagnostic.Outcome<TestgenConcept> {
  v2.std.diagnostic.bind_outcome(
    o: nat_algebra_law_obligation_for_manual_anchor(anchor: anchor),
    f: fn(obligation) {
      v2.std.diagnostic.Accepted {
        value: AlgebraLaw {
          subject: algebra_law_subject_from_nat_obligation(o: obligation),
        },
        diagnostics: v2.std.diagnostic.None,
      }
    }
  )
}

fn testgen_algebra_law_subject_from_scheduled_generator(
  generator: Generator<TestgenConcept>
) -> v2.std.diagnostic.Outcome<AlgebraLawSubject> {
  match generator.slot {
    AlgebraLaw { subject: subject } =>
      v2.std.diagnostic.Accepted { value: subject, diagnostics: v2.std.diagnostic.None }
    TypeConstruction { subject: _ } =>
      v2.std.diagnostic.Rejected {
        diagnostics: v2.std.diagnostic.diagnostics_singleton(
          d: testgen_non_algebra_law_scheduled_slot_diagnostic()
        )
      }
    DiagnosticExhaustiveness { coproduct_type: _, omitted_variant: _ } =>
      v2.std.diagnostic.Rejected {
        diagnostics: v2.std.diagnostic.diagnostics_singleton(
          d: testgen_non_algebra_law_scheduled_slot_diagnostic()
        )
      }
    CrossRepresentationEquality { modeled_coproduct: _, native_realization: _ } =>
      v2.std.diagnostic.Rejected {
        diagnostics: v2.std.diagnostic.diagnostics_singleton(
          d: testgen_non_algebra_law_scheduled_slot_diagnostic()
        )
      }
    LensApplicability { subject: _ } =>
      v2.std.diagnostic.Rejected {
        diagnostics: v2.std.diagnostic.diagnostics_singleton(
          d: testgen_non_algebra_law_scheduled_slot_diagnostic()
        )
      }
    BidirectionalRoundtrip { subject: _ } =>
      v2.std.diagnostic.Rejected {
        diagnostics: v2.std.diagnostic.diagnostics_singleton(
          d: testgen_non_algebra_law_scheduled_slot_diagnostic()
        )
      }
    LanguageBehaviorEquivalence { subject: _, mock: _ } =>
      v2.std.diagnostic.Rejected {
        diagnostics: v2.std.diagnostic.diagnostics_singleton(
          d: testgen_non_algebra_law_scheduled_slot_diagnostic()
        )
      }
    RefinementPreservation { subject: _ } =>
      v2.std.diagnostic.Rejected {
        diagnostics: v2.std.diagnostic.diagnostics_singleton(
          d: testgen_non_algebra_law_scheduled_slot_diagnostic()
        )
      }
  }
}

fn append_algebra_law_subject_from_scheduled_generator(
  acc: List<AlgebraLawSubject>,
  generator: Generator<TestgenConcept>
) -> v2.std.diagnostic.Outcome<List<AlgebraLawSubject>> {
  v2.std.diagnostic.bind_outcome(
    o: testgen_algebra_law_subject_from_scheduled_generator(generator: generator),
    f: fn(subject) {
      v2.std.diagnostic.Accepted {
        value: std.algebra.Cons { head: subject, tail: acc },
        diagnostics: v2.std.diagnostic.None,
      }
    }
  )
}

fn testgen_algebra_law_subjects_from_scheduled_generators(
  generators: List<Generator<TestgenConcept>>
) -> v2.std.diagnostic.Outcome<List<AlgebraLawSubject>> {
  v2.std.algebra.fold_list_right(
    xs: generators,
    empty: v2.std.diagnostic.outcome_accepted(value: std.algebra.Empty),
    snoc: fn(o, generator) {
      v2.std.diagnostic.bind_outcome(
        o: o,
        f: fn(acc) {
          append_algebra_law_subject_from_scheduled_generator(
            acc: acc,
            generator: generator
          )
        }
      )
    }
  )
}

fn testgen_scheduled_algebra_law_subjects() -> v2.std.diagnostic.Outcome<List<AlgebraLawSubject>> {
  v2.std.diagnostic.bind_outcome(
    o: testgen_scheduled_algebra_law_generators(),
    f: fn(generators) {
      testgen_algebra_law_subjects_from_scheduled_generators(generators: generators)
    }
  )
}

fn coproduct_exhaustiveness_anchor(coproduct_type: v2.std.node.Symbol, omitted_variant: v2.std.node.Symbol) -> v2.std.verification.GeneratedAnchorKey {
  v2.std.verification.GeneratedCoproductExhaustiveness { coproduct_type: coproduct_type, omitted_variant: omitted_variant }
}

fn coproduct_exhaustiveness_anchor_coproduct_type(anchor: v2.std.verification.GeneratedAnchorKey) -> v2.std.node.Symbol {
  match anchor {
    v2.std.verification.GeneratedCoproductExhaustiveness { coproduct_type, omitted_variant: _ } => coproduct_type
    v2.std.verification.GeneratedCrossRepresentationEquality { modeled_coproduct: _, native_realization: _ } => ^coproduct_exhaustiveness_anchor_not_exhaustiveness
  }
}

fn coproduct_exhaustiveness_anchor_omitted_variant(anchor: v2.std.verification.GeneratedAnchorKey) -> v2.std.node.Symbol {
  match anchor {
    v2.std.verification.GeneratedCoproductExhaustiveness { coproduct_type: _, omitted_variant } => omitted_variant
    v2.std.verification.GeneratedCrossRepresentationEquality { modeled_coproduct: _, native_realization: _ } => ^coproduct_exhaustiveness_anchor_not_exhaustiveness
  }
}

fn coproduct_exhaustiveness_variant_node(omitted_variant: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode {
      connective: v2.std.node.Atom { identity: omitted_variant }
    },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn coproduct_exhaustiveness_input(anchor: v2.std.verification.GeneratedAnchorKey) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode {
      connective: v2.std.node.Atom { identity: coproduct_exhaustiveness_anchor_coproduct_type(anchor: anchor) }
    },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^coproduct_exhaustiveness_omitted_variant_edge },
        target: coproduct_exhaustiveness_variant_node(
          omitted_variant: coproduct_exhaustiveness_anchor_omitted_variant(anchor: anchor)
        )
      }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn coproduct_exhaustiveness_label(anchor: v2.std.verification.GeneratedAnchorKey) -> String {
  concat(
    "generated/diagnostic-exhaustiveness: coproduct ",
    concat(
      coproduct_exhaustiveness_anchor_coproduct_type(anchor: anchor),
      concat(
        " missing arm ",
        concat(coproduct_exhaustiveness_anchor_omitted_variant(anchor: anchor), " rejects")
      )
    )
  )
}

fn coproduct_exhaustiveness_diagnostic(
  input: v2.std.node.Node
) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^coproduct_exhaustiveness_missing_variant,
    at: v2.std.diagnostic.node_locus(node: input),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.UserInputBoundary }
  }
}

fn testgen_emit_coproduct_exhaustiveness_claim(
  anchor: v2.std.verification.GeneratedAnchorKey
) -> v2.std.diagnostic.Outcome<v2.std.verification.TestClaim> {
  let input = coproduct_exhaustiveness_input(anchor: anchor)
  v2.std.diagnostic.Accepted {
    value: v2.std.verification.DiagnosticClaim {
      label: coproduct_exhaustiveness_label(anchor: anchor),
      anchor: v2.std.verification.generated_claim_anchor(anchor: anchor),
      input: input,
      expected_rejection: v2.std.diagnostic.diagnostics_singleton(
        d: coproduct_exhaustiveness_diagnostic(input: input)
      ),
      classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit },
    },
    diagnostics: v2.std.diagnostic.None,
  }
}

fn coproduct_exhaustiveness_generator(
  coproduct_type: v2.std.node.Symbol,
  omitted_variant: v2.std.node.Symbol
) -> Generator<TestgenConcept> {
  let anchor = coproduct_exhaustiveness_anchor(
    coproduct_type: coproduct_type,
    omitted_variant: omitted_variant
  )
  Generator {
    kind: v2.std.verification.TestClaimDiagnosticClaimVariant,
    classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit },
    anchor: v2.std.verification.generated_claim_anchor(anchor: anchor),
    slot: DiagnosticExhaustiveness {
      coproduct_type: coproduct_type,
      omitted_variant: omitted_variant,
    },
    provenance: generator_provenance(id: generator_id_for_generated_anchor(key: anchor)),
    profile_metadata: default_generator_profile(),
  }
}

fn coproduct_exhaustiveness_generators_for_decl(
  decl: v2.std.concept_index.ConceptDecl
) -> List<Generator<TestgenConcept>> {
  v2.std.algebra.list_map(
    xs: v2.std.node_query.coproduct_arm_key_list_from_node(node: decl.node),
    f: fn(arm) {
      coproduct_exhaustiveness_generator(coproduct_type: decl.name, omitted_variant: arm)
    }
  )
}

fn testgen_scheduled_coproduct_exhaustiveness_generators() -> List<Generator<TestgenConcept>> {
  v2.std.algebra.list_flat_map(
    xs: v2.std.concept_index.enumerate_coproduct_decls(),
    f: fn(decl) { coproduct_exhaustiveness_generators_for_decl(decl: decl) }
  )
}

data cross_repr_native_value_bool: v2.std.node.Symbol = ^native_value_bool
data cross_repr_native_value_null: v2.std.node.Symbol = ^native_value_null

fn cross_representation_equality_anchor(
  modeled_coproduct: v2.std.node.Symbol,
  native_realization: v2.std.node.Symbol
) -> v2.std.verification.GeneratedAnchorKey {
  v2.std.verification.GeneratedCrossRepresentationEquality {
    modeled_coproduct: modeled_coproduct,
    native_realization: native_realization
  }
}

fn cross_representation_anchor_modeled_coproduct(anchor: v2.std.verification.GeneratedAnchorKey) -> v2.std.node.Symbol {
  match anchor {
    v2.std.verification.GeneratedCrossRepresentationEquality { modeled_coproduct, native_realization: _ } => modeled_coproduct
    v2.std.verification.GeneratedCoproductExhaustiveness { coproduct_type: _, omitted_variant: _ } => ^cross_representation_anchor_not_straddle
  }
}

fn cross_representation_anchor_native_realization(anchor: v2.std.verification.GeneratedAnchorKey) -> v2.std.node.Symbol {
  match anchor {
    v2.std.verification.GeneratedCrossRepresentationEquality { modeled_coproduct: _, native_realization } => native_realization
    v2.std.verification.GeneratedCoproductExhaustiveness { coproduct_type: _, omitted_variant: _ } => ^cross_representation_anchor_not_straddle
  }
}

fn cross_representation_representation_node(identity: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: identity } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn cross_representation_equality_label(anchor: v2.std.verification.GeneratedAnchorKey) -> String {
  concat(
    "generated/cross-representation-equality: modeled ",
    concat(
      cross_representation_anchor_modeled_coproduct(anchor: anchor),
      concat(
        " reconciles with native ",
        cross_representation_anchor_native_realization(anchor: anchor)
      )
    )
  )
}

fn testgen_emit_cross_representation_equality_claim(
  anchor: v2.std.verification.GeneratedAnchorKey
) -> v2.std.diagnostic.Outcome<v2.std.verification.TestClaim> {
  v2.std.diagnostic.Accepted {
    value: v2.std.verification.EqualsClaim {
      label: cross_representation_equality_label(anchor: anchor),
      anchor: v2.std.verification.generated_claim_anchor(anchor: anchor),
      lhs: cross_representation_representation_node(
        identity: cross_representation_anchor_modeled_coproduct(anchor: anchor)
      ),
      rhs: cross_representation_representation_node(
        identity: cross_representation_anchor_native_realization(anchor: anchor)
      ),
      classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit },
    },
    diagnostics: v2.std.diagnostic.None,
  }
}

fn cross_representation_equality_generator(
  modeled_coproduct: v2.std.node.Symbol,
  native_realization: v2.std.node.Symbol
) -> Generator<TestgenConcept> {
  let anchor = cross_representation_equality_anchor(
    modeled_coproduct: modeled_coproduct,
    native_realization: native_realization
  )
  Generator {
    kind: v2.std.verification.TestClaimEqualsClaimVariant,
    classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit },
    anchor: v2.std.verification.generated_claim_anchor(anchor: anchor),
    slot: CrossRepresentationEquality {
      modeled_coproduct: modeled_coproduct,
      native_realization: native_realization,
    },
    provenance: generator_provenance(id: generator_id_for_generated_anchor(key: anchor)),
    profile_metadata: default_generator_profile(),
  }
}

fn testgen_scheduled_cross_representation_equality_generators() -> List<Generator<TestgenConcept>> {
  [
    cross_representation_equality_generator(
      modeled_coproduct: ^Bool,
      native_realization: cross_repr_native_value_bool
    ),
    cross_representation_equality_generator(
      modeled_coproduct: ^Optional,
      native_realization: cross_repr_native_value_null
    ),
  ]
}

fn generator_carries_provenance<C>(g: Generator<C>) -> Bool {
  g.provenance.generator_id == generator_id_for_claim_anchor(anchor: g.anchor)
    && g.profile_metadata.profile_ref == ^testgen_default_profile_ref
}

fn all_generators_carry_provenance(gens: List<Generator<TestgenConcept>>) -> Bool {
  v2.std.algebra.fold_list(
    xs: gens,
    empty: true,
    cons: fn(acc, g) { acc && generator_carries_provenance(g: g) },
  )
}

fn outcome_generators_carry_provenance(o: v2.std.diagnostic.Outcome<List<Generator<TestgenConcept>>>) -> Bool {
  match o {
    v2.std.diagnostic.Accepted { value: gens, diagnostics: d } => all_generators_carry_provenance(gens: gens)
    v2.std.diagnostic.Rejected { diagnostics: d } => false
  }
}

fn scheduled_generators_carry_provenance() -> Bool {
  all_generators_carry_provenance(gens: testgen_scheduled_language_behavior_generators())
    && all_generators_carry_provenance(gens: testgen_scheduled_coproduct_exhaustiveness_generators())
    && all_generators_carry_provenance(gens: testgen_scheduled_cross_representation_equality_generators())
    && outcome_generators_carry_provenance(o: testgen_scheduled_refinement_preservation_generators())
    && outcome_generators_carry_provenance(o: testgen_scheduled_algebra_law_generators())
}

fn testgen_scheduled_generators_static_base() -> List<Generator<TestgenConcept>> {
  v2.std.algebra.list_append(
    left: testgen_scheduled_language_behavior_generators(),
    right: v2.std.algebra.list_append(
      left: testgen_scheduled_coproduct_exhaustiveness_generators(),
      right: testgen_scheduled_cross_representation_equality_generators()
    )
  )
}

fn testgen_scheduled_generators_outcome() -> v2.std.diagnostic.Outcome<List<Generator<TestgenConcept>>> {
  let base = testgen_scheduled_generators_static_base()
  v2.std.diagnostic.bind_outcome(
    o: testgen_scheduled_refinement_preservation_generators(),
    f: fn(refinement_gens) {
      v2.std.diagnostic.bind_outcome(
        o: testgen_scheduled_algebra_law_generators(),
        f: fn(algebra_gens) {
          v2.std.diagnostic.outcome_accepted(
            value: v2.std.algebra.list_append(
              left: base,
              right: v2.std.algebra.list_append(left: refinement_gens, right: algebra_gens)
            )
          )
        }
      )
    }
  )
}

fn testgen_scheduled_generators_roster_holds() -> Bool {
  match testgen_scheduled_generators_outcome() {
    v2.std.diagnostic.Accepted { value: gens, diagnostics: _ } => v2.std.algebra.length(xs: gens) > 0
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

type TestgenRunReceipt {
  profile_ref: v2.std.node.Symbol
  generators: List<Generator<TestgenConcept>>
}

fn generator_matches_profile(g: Generator<TestgenConcept>, profile_ref: v2.std.node.Symbol) -> Bool {
  g.profile_metadata.profile_ref == profile_ref
}

fn testgen_scheduled_generators_matching_profile(
  gens: List<Generator<TestgenConcept>>,
  profile_ref: v2.std.node.Symbol
) -> List<Generator<TestgenConcept>> {
  v2.std.algebra.filter(
    xs: gens,
    predicate: fn(g) {
      generator_matches_profile(g: g, profile_ref: profile_ref)
    }
  )
}

fn testgen_run_receipt_outcome(profile_ref: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<TestgenRunReceipt> {
  v2.std.diagnostic.bind_outcome(
    o: testgen_scheduled_generators_outcome(),
    f: fn(gens) {
      let matched = testgen_scheduled_generators_matching_profile(gens: gens, profile_ref: profile_ref)
      if v2.std.algebra.length(xs: matched) == 0 && v2.std.algebra.length(xs: gens) > 0 {
        v2.std.diagnostic.outcome_rejected(d: testgen_profile_roster_mismatch_diagnostic())
      } else {
        v2.std.diagnostic.outcome_accepted(
          value: TestgenRunReceipt {
            profile_ref: profile_ref,
            generators: matched
          }
        )
      }
    }
  )
}

fn generator_id_eq(left: Generator<TestgenConcept>, right: Generator<TestgenConcept>) -> Bool {
  left.provenance.generator_id == right.provenance.generator_id
}

fn testgen_generators_roster_equal_by_id(
  left: List<Generator<TestgenConcept>>,
  right: List<Generator<TestgenConcept>>
) -> Bool {
  v2.std.algebra.zip_eq(
    a: left,
    b: right,
    eq: fn(l, r) {
      generator_id_eq(left: l, right: r)
    }
  )
}

fn testgen_run_receipt_carries_profile_roster(receipt: TestgenRunReceipt) -> Bool {
  match testgen_scheduled_generators_outcome() {
    v2.std.diagnostic.Accepted { value: roster, diagnostics: _ } =>
      testgen_generators_roster_equal_by_id(
        left: receipt.generators,
        right: testgen_scheduled_generators_matching_profile(
          gens: roster,
          profile_ref: receipt.profile_ref
        )
      )
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn manual_anchor_absent_bootstrap_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^manual_anchor_absent_bootstrap,
    at: v2.std.diagnostic.Textual { file: ^testgen_lens_file, extent: v2.std.diagnostic.WholeFile },
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.UserInputBoundary }
  }
}

fn manual_test_claim_for_manual_anchor(key: v2.std.verification.ManualAnchorKey) -> v2.std.diagnostic.Outcome<v2.std.verification.TestClaim> {
  match key {
    v2.std.verification.ManualAnchorAbsent =>
      v2.std.diagnostic.Rejected { diagnostics: v2.std.diagnostic.diagnostics_singleton(d: manual_anchor_absent_bootstrap_diagnostic()) }
    v2.std.verification.ManualTcConjEmpty => v2.std.diagnostic.Accepted { value: v2.test.manual.connective_anchors.claim_conj_empty_compiles, diagnostics: v2.std.diagnostic.None }
    v2.std.verification.ManualTcDisjEmpty => v2.std.diagnostic.Accepted { value: v2.test.manual.connective_anchors.claim_disj_empty_compiles, diagnostics: v2.std.diagnostic.None }
    v2.std.verification.ManualTcArrowTwoConj => v2.std.diagnostic.Accepted { value: v2.test.manual.connective_anchors.claim_arrow_two_conj_compiles, diagnostics: v2.std.diagnostic.None }
    v2.std.verification.ManualTcCardinalityEmpty => v2.std.diagnostic.Accepted { value: v2.test.manual.connective_anchors.claim_cardinality_empty_rejected, diagnostics: v2.std.diagnostic.None }
    v2.std.verification.ManualTcInstantiationEmpty => v2.std.diagnostic.Accepted { value: v2.test.manual.connective_anchors.claim_instantiation_empty_rejected, diagnostics: v2.std.diagnostic.None }
    v2.std.verification.ManualTcArrowEmpty => v2.std.diagnostic.Accepted { value: v2.test.manual.connective_anchors.claim_arrow_empty_rejected, diagnostics: v2.std.diagnostic.None }
    v2.std.verification.ManualTcTransformEmpty => v2.std.diagnostic.Accepted { value: v2.test.manual.connective_anchors.claim_transform_empty_rejected, diagnostics: v2.std.diagnostic.None }
    v2.std.verification.ManualTcBranchEmpty => v2.std.diagnostic.Accepted { value: v2.test.manual.connective_anchors.claim_branch_empty_rejected, diagnostics: v2.std.diagnostic.None }
    v2.std.verification.ManualTcLoopEmpty => v2.std.diagnostic.Accepted { value: v2.test.manual.connective_anchors.claim_loop_empty_rejected, diagnostics: v2.std.diagnostic.None }
    v2.std.verification.ManualTcBindZeroChildren => v2.std.diagnostic.Accepted { value: v2.test.manual.connective_anchors.claim_bind_zero_children_rejected, diagnostics: v2.std.diagnostic.None }
    v2.std.verification.ManualTcConjEqualsRefl => v2.std.diagnostic.Accepted { value: v2.test.manual.connective_anchors.claim_conj_equals_refl, diagnostics: v2.std.diagnostic.None }
    v2.std.verification.ManualNatAddLeftIdentity => v2.std.diagnostic.Accepted { value: v2.test.manual.nat_law_anchors.claim_nat_add_left_identity, diagnostics: v2.std.diagnostic.None }
    v2.std.verification.ManualNatAddRightIdentity => v2.std.diagnostic.Accepted { value: v2.test.manual.nat_law_anchors.claim_nat_add_right_identity, diagnostics: v2.std.diagnostic.None }
    v2.std.verification.ManualNatAddAssociativity => v2.std.diagnostic.Accepted { value: v2.test.manual.nat_law_anchors.claim_nat_add_associativity, diagnostics: v2.std.diagnostic.None }
    v2.std.verification.ManualNatMulLeftIdentity => v2.std.diagnostic.Accepted { value: v2.test.manual.nat_law_anchors.claim_nat_mul_left_identity, diagnostics: v2.std.diagnostic.None }
    v2.std.verification.ManualNatMulAnnihilator => v2.std.diagnostic.Accepted { value: v2.test.manual.nat_law_anchors.claim_nat_mul_annihilator, diagnostics: v2.std.diagnostic.None }
    v2.std.verification.ManualNatMulAssociativity => v2.std.diagnostic.Accepted { value: v2.test.manual.nat_law_anchors.claim_nat_mul_associativity, diagnostics: v2.std.diagnostic.None }
    v2.std.verification.ManualLbeConjDagSurface =>
      testgen_emit_language_behavior_equivalence_claim(
        anchor: v2.std.verification.ManualLbeConjDagSurface,
        label: lbe_label_conj_dag_surface,
        mock: lbe_io_mock_conj_dag_surface()
      )
    v2.std.verification.ManualLbeDisjDagSurface =>
      testgen_emit_language_behavior_equivalence_claim(
        anchor: v2.std.verification.ManualLbeDisjDagSurface,
        label: lbe_label_disj_dag_surface,
        mock: lbe_io_mock_disj_dag_surface()
      )
    v2.std.verification.ManualLbeTransformDagSurface =>
      testgen_emit_language_behavior_equivalence_claim(
        anchor: v2.std.verification.ManualLbeTransformDagSurface,
        label: lbe_label_transform_dag_surface,
        mock: lbe_io_mock_transform_dag_surface()
      )
    v2.std.verification.ManualRefinementNonEmptyListBase =>
      match refinement_preservation_subject_nonempty_list_base() {
        v2.std.diagnostic.Accepted { value: subject, diagnostics: v2.std.diagnostic.None } =>
          testgen_emit_refinement_preservation_claim(
            anchor: v2.std.verification.ManualRefinementNonEmptyListBase,
            label: refinement_label_nonempty_list_base,
            subject: subject
          )
        v2.std.diagnostic.Rejected { diagnostics: d } => v2.std.diagnostic.Rejected { diagnostics: d }
      }
  }
}

fn testgen_concept_for_manual_claim(claim: v2.std.verification.TestClaim) -> v2.std.diagnostic.Outcome<TestgenConcept> {
  match v2.std.verification.test_claim_anchor(c: claim) {
    v2.std.verification.ManualClaimAnchor { manual_anchor: v2.std.verification.ManualAnchorAbsent } =>
      v2.std.diagnostic.Rejected { diagnostics: v2.std.diagnostic.diagnostics_singleton(d: manual_anchor_absent_bootstrap_diagnostic()) }
    v2.std.verification.ManualClaimAnchor { manual_anchor: v2.std.verification.ManualTcConjEmpty } =>
      v2.std.diagnostic.Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: v2.std.node.Conj },
        }, diagnostics: v2.std.diagnostic.None }
    v2.std.verification.ManualClaimAnchor { manual_anchor: v2.std.verification.ManualTcDisjEmpty } =>
      v2.std.diagnostic.Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: v2.std.node.Disj },
        }, diagnostics: v2.std.diagnostic.None }
    v2.std.verification.ManualClaimAnchor { manual_anchor: v2.std.verification.ManualTcArrowTwoConj } =>
      v2.std.diagnostic.Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: v2.std.node.Arrow },
        }, diagnostics: v2.std.diagnostic.None }
    v2.std.verification.ManualClaimAnchor { manual_anchor: v2.std.verification.ManualTcCardinalityEmpty } =>
      v2.std.diagnostic.Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: v2.std.node.Cardinality },
        }, diagnostics: v2.std.diagnostic.None }
    v2.std.verification.ManualClaimAnchor { manual_anchor: v2.std.verification.ManualTcInstantiationEmpty } =>
      v2.std.diagnostic.Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: v2.std.node.Instantiation },
        }, diagnostics: v2.std.diagnostic.None }
    v2.std.verification.ManualClaimAnchor { manual_anchor: v2.std.verification.ManualTcArrowEmpty } =>
      v2.std.diagnostic.Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: v2.std.node.Arrow },
        }, diagnostics: v2.std.diagnostic.None }
    v2.std.verification.ManualClaimAnchor { manual_anchor: v2.std.verification.ManualTcTransformEmpty } =>
      v2.std.diagnostic.Accepted { value: TypeConstruction {
          subject: BehaviorValueSubject { behavior: v2.std.node.Transform },
        }, diagnostics: v2.std.diagnostic.None }
    v2.std.verification.ManualClaimAnchor { manual_anchor: v2.std.verification.ManualTcBranchEmpty } =>
      v2.std.diagnostic.Accepted { value: TypeConstruction {
          subject: BehaviorValueSubject { behavior: v2.std.node.Branch },
        }, diagnostics: v2.std.diagnostic.None }
    v2.std.verification.ManualClaimAnchor { manual_anchor: v2.std.verification.ManualTcLoopEmpty } =>
      v2.std.diagnostic.Accepted { value: TypeConstruction {
          subject: BehaviorValueSubject { behavior: v2.std.node.Loop },
        }, diagnostics: v2.std.diagnostic.None }
    v2.std.verification.ManualClaimAnchor { manual_anchor: v2.std.verification.ManualTcBindZeroChildren } =>
      v2.std.diagnostic.Accepted { value: TypeConstruction {
          subject: BehaviorValueSubject { behavior: v2.std.node.Bind },
        }, diagnostics: v2.std.diagnostic.None }
    v2.std.verification.ManualClaimAnchor { manual_anchor: v2.std.verification.ManualTcConjEqualsRefl } =>
      v2.std.diagnostic.Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: v2.std.node.Conj },
        }, diagnostics: v2.std.diagnostic.None }
    v2.std.verification.ManualClaimAnchor { manual_anchor: v2.std.verification.ManualNatAddLeftIdentity } =>
      testgen_algebra_law_concept_for_manual_nat_anchor(anchor: v2.std.verification.ManualNatAddLeftIdentity)
    v2.std.verification.ManualClaimAnchor { manual_anchor: v2.std.verification.ManualNatAddRightIdentity } =>
      testgen_algebra_law_concept_for_manual_nat_anchor(anchor: v2.std.verification.ManualNatAddRightIdentity)
    v2.std.verification.ManualClaimAnchor { manual_anchor: v2.std.verification.ManualNatAddAssociativity } =>
      testgen_algebra_law_concept_for_manual_nat_anchor(anchor: v2.std.verification.ManualNatAddAssociativity)
    v2.std.verification.ManualClaimAnchor { manual_anchor: v2.std.verification.ManualNatMulLeftIdentity } =>
      testgen_algebra_law_concept_for_manual_nat_anchor(anchor: v2.std.verification.ManualNatMulLeftIdentity)
    v2.std.verification.ManualClaimAnchor { manual_anchor: v2.std.verification.ManualNatMulAnnihilator } =>
      testgen_algebra_law_concept_for_manual_nat_anchor(anchor: v2.std.verification.ManualNatMulAnnihilator)
    v2.std.verification.ManualClaimAnchor { manual_anchor: v2.std.verification.ManualNatMulAssociativity } =>
      testgen_algebra_law_concept_for_manual_nat_anchor(anchor: v2.std.verification.ManualNatMulAssociativity)
    v2.std.verification.ManualClaimAnchor { manual_anchor: v2.std.verification.ManualLbeConjDagSurface } =>
      v2.std.diagnostic.Accepted {
        value: LanguageBehaviorEquivalence {
          subject: lbe_subject_conj_dag_surface(),
          mock: lbe_io_mock_conj_dag_surface(),
        },
        diagnostics: v2.std.diagnostic.None,
      }
    v2.std.verification.ManualClaimAnchor { manual_anchor: v2.std.verification.ManualLbeDisjDagSurface } =>
      v2.std.diagnostic.Accepted {
        value: LanguageBehaviorEquivalence {
          subject: lbe_subject_disj_dag_surface(),
          mock: lbe_io_mock_disj_dag_surface(),
        },
        diagnostics: v2.std.diagnostic.None,
      }
    v2.std.verification.ManualClaimAnchor { manual_anchor: v2.std.verification.ManualLbeTransformDagSurface } =>
      v2.std.diagnostic.Accepted {
        value: LanguageBehaviorEquivalence {
          subject: lbe_subject_transform_dag_surface(),
          mock: lbe_io_mock_transform_dag_surface(),
        },
        diagnostics: v2.std.diagnostic.None,
      }
    v2.std.verification.GeneratedClaimAnchor { generated_anchor: v2.std.verification.GeneratedCoproductExhaustiveness { coproduct_type: ct, omitted_variant: v } } =>
      v2.std.diagnostic.Accepted {
        value: DiagnosticExhaustiveness { coproduct_type: ct, omitted_variant: v },
        diagnostics: v2.std.diagnostic.None,
      }
    v2.std.verification.GeneratedClaimAnchor { generated_anchor: v2.std.verification.GeneratedCrossRepresentationEquality { modeled_coproduct: mc, native_realization: nr } } =>
      v2.std.diagnostic.Accepted {
        value: CrossRepresentationEquality { modeled_coproduct: mc, native_realization: nr },
        diagnostics: v2.std.diagnostic.None,
      }
    v2.std.verification.ManualClaimAnchor { manual_anchor: v2.std.verification.ManualRefinementNonEmptyListBase } =>
      match refinement_preservation_subject_nonempty_list_base() {
        v2.std.diagnostic.Accepted { value: subject, diagnostics: v2.std.diagnostic.None } =>
          v2.std.diagnostic.Accepted {
            value: RefinementPreservation {
              subject: subject,
            },
            diagnostics: v2.std.diagnostic.None,
          }
        v2.std.diagnostic.Rejected { diagnostics: d } => v2.std.diagnostic.Rejected { diagnostics: d }
      }
    v2.std.verification.ManualClaimAnchor { manual_anchor: manual_anchor } =>
      match algebra_law_subject_for_manual_anchor(anchor: manual_anchor) {
        v2.std.diagnostic.Accepted { value: subject, diagnostics: v2.std.diagnostic.None } =>
          v2.std.diagnostic.Accepted {
            value: AlgebraLaw {
              subject: subject,
            },
            diagnostics: v2.std.diagnostic.None,
          }
        v2.std.diagnostic.Rejected { diagnostics: d } => v2.std.diagnostic.Rejected { diagnostics: d }
      }
  }
}

fn bootstrap_claim_generator_for_manual_anchor(
  key: v2.std.verification.ManualAnchorKey
) -> v2.std.diagnostic.Outcome<Generator<TestgenConcept>> {
  match manual_test_claim_for_manual_anchor(key: key) {
    v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
    v2.std.diagnostic.Accepted { value: claim, diagnostics: d0 } =>
      match testgen_concept_for_manual_claim(claim: claim) {
        v2.std.diagnostic.Rejected { diagnostics: r } =>
          v2.std.diagnostic.Rejected { diagnostics: v2.std.diagnostic.rejected_with_pending(pending: d0, rejected: r) }
        v2.std.diagnostic.Accepted { value: slot, diagnostics: d1 } =>
          v2.std.diagnostic.Accepted {
            value: Generator {
              kind: v2.std.verification.test_claim_coproduct_variant(c: claim),
              classification: v2.std.verification.test_claim_classification(c: claim),
              anchor: v2.std.verification.test_claim_anchor(c: claim),
              slot: slot,
              provenance: generator_provenance(id: generator_id_for_claim_anchor(anchor: v2.std.verification.test_claim_anchor(c: claim))),
              profile_metadata: default_generator_profile(),
            },
            diagnostics: v2.std.diagnostic.diagnostics_merge(outer: d0, inner: d1)
          }
    }
  }
}

data construction_justification: v2.lens.common.construction_justification.ConstructionJustification = v2.lens.common.construction_justification.ConstructionJustification {
  class: v2.lens.common.construction_justification.RatchetForever
}
