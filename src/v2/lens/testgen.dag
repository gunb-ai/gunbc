// F.2-P1: generator identity + provenance cross-ref. GeneratorId / GeneratorProvenance
// are authored in v2.std.artifact (artifact identity is its single authority); testgen
// only consumes them — no artifact law is duplicated here. profile_metadata stays a
// testgen-local concept (GeneratorProfile below) and must not leak into artifact.dag.
import v2.std.artifact {
  GeneratorId,
  GeneratorProvenance,
  test_claim_generated_artifact
}
// docs/plans/testgen-oracle.md §4.2 — CoproductExhaustiveness is STRUCTURAL: the roster of
// missing-arm witnesses is derived from every declared coproduct (concept_index) and that
// coproduct's own arm keys read off its Node (node_query), not a hand-list of TestClaim variants.
import v2.std.concept_index {
  ConceptDecl,
  enumerate_coproduct_decls
}
