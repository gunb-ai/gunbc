module v2.lens.identity_captured_navigation.analyze

import v2.lens.identity_captured_navigation { Finding, IdentityNodeEscapesAsValue, Suspect }
import v2.std.diagnostic { Accepted }
import v2.std.node { Authored, Edge, Node, Positional, StructuralLabel }
import std.algebra { Cons, list_append }
import v2.extdeps.languages.dag { ParseSubtreeAbsent, ParseSubtreeFound, dag_lex_token_symbol, parse_production_captured_child_optional, parse_production_emitted_identity_optional, parse_subtree_find_production_captured }
import v2.std.node_query { find_named_child }
import v2.std.collection { list_at_optional }
import v2.std.algebra { list_reverse }
import v2.std.grammar { node_atom_identity_optional }
import v2.std.optional { Optional }

fn named_child_optional(cap: Node, name: Symbol) -> Optional<Node> {
  match find_named_child(root: cap, name: name) {
    Accepted { value: c, diagnostics: _ } => Present { value: c }
    Rejected { diagnostics: _ } => Absent
  }
}

fn sequence_left_node(cap: Node) -> Optional<Node> {
  named_child_optional(cap: cap, name: ^grammar_sequence_left_node_projection)
}

fn sequence_right_node(cap: Node) -> Optional<Node> {
  named_child_optional(cap: cap, name: ^grammar_sequence_right_node_projection)
}

fn find_capture(root: Node, emitted: Symbol) -> Optional<Node> {
  match parse_subtree_find_production_captured(root: root, emitted: emitted) {
    ParseSubtreeFound { captured: c } => Present { value: c }
    ParseSubtreeAbsent => Absent
  }
}

fn capture_list_prepend(item: Node, xs: List<Node>) -> List<Node> {
  Cons { head: item, tail: xs }
}

// collect_direct_captures walks n.children only until it hits a node whose OWN production identity equals the target emitted symbol - it does not descend past a match, so it finds exactly the direct (non-nested) occurrences of a production, matching the technique v2.lens.complexity_accumulator_copy.analyze uses to read a call's own args (^dag_surface_arg) without wandering into a nested call's args.
fn collect_direct_captures(n: Node, emitted: Symbol, acc: List<Node>) -> List<Node> {
  match parse_production_emitted_identity_optional(node: n) {
    Present { value: id } =>
      if id == emitted {
        match parse_production_captured_child_optional(node: n) {
          Present { value: c } => capture_list_prepend(item: c, xs: acc)
          Absent => acc
        }
      } else {
        fold(n.children, init: acc, f: fn(a, e) {
          collect_direct_captures(n: e.target, emitted: emitted, acc: a)
        })
      }
    Absent =>
      fold(n.children, init: acc, f: fn(a, e) {
        collect_direct_captures(n: e.target, emitted: emitted, acc: a)
      })
  }
}

fn primary_expr_capture(node: Node) -> Optional<Node> {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } =>
      if id == ^dag_surface_primary_expr {
        parse_production_captured_child_optional(node: node)
      } else {
        Absent
      }
    Absent => Absent
  }
}

fn sequence_left_symbol(cap: Node) -> Optional<Symbol> {
  match sequence_left_node(cap: cap) {
    Absent => Absent
    Present { value: left } => node_atom_identity_optional(node: left)
  }
}

fn symbol_list_prepend(item: Symbol, xs: List<Symbol>) -> List<Symbol> {
  Cons { head: item, tail: xs }
}

fn symbol_list_length(xs: List<Symbol>) -> Int {
  fold(xs, init: 0, f: fn(acc, s) { acc + 1 })
}

fn edge_is_identity_projection(e: Edge) -> Bool {
  match e.label {
    Authored { name: nm } => nm == ^grammar_production_identity_node_projection
    StructuralLabel { label: _ } => false
    Positional => false
  }
}

fn mention_walk_skips_production(emitted: Symbol) -> Bool {
  emitted == ^dag_surface_pattern
}

fn collect_value_identifiers_from_node(n: Node, acc: List<Symbol>) -> List<Symbol> {
  let here = match node_atom_identity_optional(node: n) {
    Present { value: id } =>
      if dag_lex_token_symbol(sym: id) { acc } else { symbol_list_prepend(item: id, xs: acc) }
    Absent => acc
  }
  fold(n.children, init: here, f: fn(a, e) {
    if edge_is_identity_projection(e: e) {
      a
    } else {
      collect_value_identifiers_into(n: e.target, acc: a)
    }
  })
}

fn collect_value_identifiers_into(n: Node, acc: List<Symbol>) -> List<Symbol> {
  match parse_production_emitted_identity_optional(node: n) {
    Present { value: emitted } =>
      if mention_walk_skips_production(emitted: emitted) {
        acc
      } else {
        collect_value_identifiers_from_node(n: n, acc: acc)
      }
    Absent => collect_value_identifiers_from_node(n: n, acc: acc)
  }
}

// collect_value_identifiers_into skips ^grammar_production_identity_node_projection edges the same
// way v2.lens.complexity_accumulator_copy.analyze's edge_skips_identifier_count does (a wrapper's
// own identity tag is never a value mention). Binding-position idents (arg labels, field-pattern
// labels) are StampClass (dag_grammar_terminal), so they never surface as lexeme identities here.
// Constructor names and pattern binders ARE lexeme-stamped (qualified_name on
// ^dag_surface_pattern). Counting them as value mentions is why the sanctioned-reader positive
// control — Accepted { value: id_node } => node_atom_identity_optional(node: id_node) — was
// classified Suspect: remaining included Accepted/Rejected/the pattern binder on top of the one
// body mention the shape check is allowed. A ^dag_surface_pattern subtree is therefore skipped
// whole: only the arm body is a value-mention region.

// primary_expr's grammar is a Choice: caret_symbol_expr = Sequence(caret_terminal, name_terminal) for an atom literal like ^foo, vs primary_expr_core's plain-identifier case = Sequence(ident_lexeme, suffix) for a call head like find_named_child - the SAME sequence shape, but the symbol lives on the LEFT for a plain identifier and on the RIGHT for a caret-prefixed atom literal (the left is the caret token itself). arg_value_symbol reads the left first and, when it is ^dag_token_caret, reads the right. The caret's name terminal is lexeme-stamped (v2.extdeps.languages.dag dag_grammar_caret_symbol_expr), so its atom identity IS the authored symbol; a right side that is not an atom answers Absent, never a guessed symbol.
fn caret_literal_right_symbol(value_expr: Node) -> Optional<Symbol> {
  match sequence_right_node(cap: value_expr) {
    Absent => Absent
    Present { value: right } => node_atom_identity_optional(node: right)
  }
}

fn value_expr_symbol_from_left(value_expr: Node, left_id: Symbol) -> Optional<Symbol> {
  match left_id == ^dag_token_caret {
    true => caret_literal_right_symbol(value_expr: value_expr)
    false => Present { value: left_id }
  }
}

fn arg_value_symbol(arg_capture: Node) -> Optional<Symbol> {
  match find_capture(root: arg_capture, emitted: ^dag_surface_primary_expr) {
    Absent => Absent
    Present { value: value_expr } =>
      match sequence_left_symbol(cap: value_expr) {
        Present { value: left_id } =>
          value_expr_symbol_from_left(value_expr: value_expr, left_id: left_id)
        Absent => Absent
      }
  }
}

fn call_args_in_order(call_capture: Node) -> List<Node> {
  list_reverse(xs: collect_direct_captures(n: call_capture, emitted: ^dag_surface_arg, acc: std.algebra.Empty))
}

fn arg_nth_value_symbol(call_capture: Node, index: Int) -> Optional<Symbol> {
  match list_at_optional(xs: call_args_in_order(call_capture: call_capture), index: index) {
    Absent => Absent
    Present { value: arg_cap } =>
      v2.lens.identity_captured_navigation.analyze.arg_value_symbol(arg_capture: arg_cap)
  }
}

fn match_scrutinee_node(match_capture: Node) -> Optional<Node> {
  match sequence_right_node(cap: match_capture) {
    Absent => Absent
    Present { value: after_kw } => sequence_left_node(cap: after_kw)
  }
}

fn match_arms_region_node(match_capture: Node) -> Optional<Node> {
  match sequence_right_node(cap: match_capture) {
    Absent => Absent
    Present { value: after_kw } =>
      match sequence_right_node(cap: after_kw) {
        Absent => Absent
        Present { value: after_scrutinee } =>
          match sequence_right_node(cap: after_scrutinee) {
            Absent => Absent
            Present { value: arms_seq } => sequence_left_node(cap: arms_seq)
          }
      }
  }
}

fn identity_navigation_call_found(cap: Node) -> Optional<Node> {
  Present { value: cap }
}

fn no_identity_navigation_call() -> Optional<Node> {
  Absent
}

fn scrutinee_identity_navigation_call(scrutinee: Node) -> Optional<Node> {
  match find_capture(root: scrutinee, emitted: ^dag_surface_primary_expr) {
    Absent => no_identity_navigation_call()
    Present { value: cap } =>
      match sequence_left_symbol(cap: cap) {
        Present { value: head } =>
          if head == ^find_named_child {
            match arg_nth_value_symbol(call_capture: cap, index: 1) {
              Present { value: name_sym } =>
                if name_sym == ^grammar_production_identity_node_projection {
                  identity_navigation_call_found(cap: cap)
                } else {
                  no_identity_navigation_call()
                }
              Absent => no_identity_navigation_call()
            }
          } else {
            no_identity_navigation_call()
          }
        Absent => no_identity_navigation_call()
      }
  }
}

fn count_symbol(xs: List<Symbol>, needle: Symbol) -> Int {
  fold(xs, init: 0, f: fn(acc, s) { if s == needle { acc + 1 } else { acc } })
}

// Name-agnostic shape check (see identity_captured_navigation_wall_note): mentions is every value-reference identifier inside the guarding match's arm region. Removing every ^Absent (the legitimate empty-Optional literal a Rejected arm returns) and exactly one ^node_atom_identity_optional (the sanctioned reduction) should leave EXACTLY one mention - the binder passed as that reduction's sole argument. Zero reductions with a non-Absent mention present means the raw identity node was referenced without ever being reduced (the bare-return escape shape); more than one leftover mention after one reduction means something besides the reduction's own argument escaped; more than one reduction is an ambiguous shape this lens refuses rather than guesses at.
fn empty_symbol_list() -> List<Symbol> {
  std.algebra.Empty
}

fn no_identity_navigation_finding() -> Optional<Finding> {
  Absent
}

fn suspect_identity_navigation_finding(
  source_node: Node,
  match_node: Node,
  reduction_count: Int,
  remaining: Int
) -> Optional<Finding> {
  Present {
    value: Suspect {
      violation: IdentityNodeEscapesAsValue {
        source: source_node,
        at: match_node,
        reduction_count: reduction_count,
        extraneous_mentions: remaining
      }
    }
  }
}

fn unclassifiable_identity_navigation_finding(match_node: Node, cause: Symbol) -> Optional<Finding> {
  Present {
    value: v2.lens.identity_captured_navigation.Unclassifiable { at: match_node, cause: cause }
  }
}

fn classify_identity_match(source_node: Node, match_node: Node, mentions: List<Symbol>) -> Optional<Finding> {
  let non_absent = fold(mentions, init: empty_symbol_list(), f: fn(acc, s) {
    if s == ^Absent { acc } else { symbol_list_prepend(item: s, xs: acc) }
  })
  let non_absent_total = symbol_list_length(xs: non_absent)
  let reduction_count = count_symbol(xs: non_absent, needle: ^node_atom_identity_optional)
  let remaining = non_absent_total - reduction_count
  if reduction_count == 0 {
    if remaining == 0 {
      no_identity_navigation_finding()
    } else {
      suspect_identity_navigation_finding(
        source_node: source_node,
        match_node: match_node,
        reduction_count: reduction_count,
        remaining: remaining
      )
    }
  } else if reduction_count == 1 {
    if remaining == 1 {
      no_identity_navigation_finding()
    } else if remaining == 0 {
      unclassifiable_identity_navigation_finding(
        match_node: match_node,
        cause: ^identity_navigation_reduction_argless
      )
    } else {
      suspect_identity_navigation_finding(
        source_node: source_node,
        match_node: match_node,
        reduction_count: reduction_count,
        remaining: remaining
      )
    }
  } else {
    unclassifiable_identity_navigation_finding(
      match_node: match_node,
      cause: ^identity_navigation_multiple_reductions
    )
  }
}

fn identity_navigation_findings_at(node: Node) -> List<Finding> {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: emitted } =>
      if emitted == ^dag_surface_match_expr {
        match parse_production_captured_child_optional(node: node) {
          Present { value: cap } =>
            match match_scrutinee_node(match_capture: cap) {
              Present { value: scrutinee } =>
                match scrutinee_identity_navigation_call(scrutinee: scrutinee) {
                  Present { value: source_call } =>
                    match match_arms_region_node(match_capture: cap) {
                      Present { value: arms } =>
                        match classify_identity_match(
                          source_node: source_call,
                          match_node: node,
                          mentions: collect_value_identifiers_into(n: arms, acc: std.algebra.Empty)
                        ) {
                          Present { value: f } => Cons { head: f, tail: std.algebra.Empty }
                          Absent => std.algebra.Empty
                        }
                      Absent =>
                        Cons {
                          head: v2.lens.identity_captured_navigation.Unclassifiable {
                            at: node,
                            cause: ^identity_navigation_arms_unresolved
                          },
                          tail: std.algebra.Empty
                        }
                    }
                  Absent => std.algebra.Empty
                }
              Absent => std.algebra.Empty
            }
          Absent => std.algebra.Empty
        }
      } else {
        std.algebra.Empty
      }
    Absent => std.algebra.Empty
  }
}

fn identity_navigation_scan(node: Node, acc: List<Finding>) -> List<Finding> {
  let here = list_append(
    left: acc,
    right: identity_navigation_findings_at(node: node)
  )
  fold(node.children, init: here, f: fn(a, e) {
    identity_navigation_scan(node: e.target, acc: a)
  })
}

fn identity_captured_navigation_findings(root: Node) -> List<Finding> {
  identity_navigation_scan(node: root, acc: std.algebra.Empty)
}

fn finding_is_suspect(f: Finding) -> Bool {
  match f {
    Suspect { violation: _ } => true
    v2.lens.identity_captured_navigation.Unclassifiable { at: _, cause: _ } => false
  }
}

fn finding_is_refusal(f: Finding) -> Bool {
  match f {
    Suspect { violation: _ } => false
    v2.lens.identity_captured_navigation.Unclassifiable { at: _, cause: _ } => true
  }
}

fn finding_refusal_cause(f: Finding) -> Optional<Symbol> {
  match f {
    Suspect { violation: _ } => Absent
    v2.lens.identity_captured_navigation.Unclassifiable { at: _, cause: c } => Present { value: c }
  }
}
