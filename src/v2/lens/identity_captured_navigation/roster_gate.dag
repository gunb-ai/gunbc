module v2.lens.identity_captured_navigation.roster_gate

import extdeps.filesystem.filesystem_io
import v2.compiler.parse { parse_module }
import v2.compiler.tokenize { tokenize }
import v2.lens.common.source_analysis_standing {
  SourceAnalysisNotEstablishedCause,
  LanguageGrammarUnavailable,
  SourceTokenizationRejected,
  SourceParseRejected
}


data roster_gate_consumer_partition_note: String = "The fast inline-source controls are required-floor witnesses at src/v2/test/claim/identity_captured_navigation/roster_gate_test.dag. The five file_gate corpus sweeps are isolated at src/v2/test/claim/identity_captured_navigation/long/roster_gate_test.dag with ReadsLiveTree standing because filesystem_read makes their input the live production tree. A manual claim_batch recipe is diagnostic only and is not coverage; scheduling that live sweep is a separate consumer lane conditional on the real analyzer-to-dependency-fidelity consumer retaining this lens."

data source_findings_pre_normalize_note: String = "Reads the RAW parsed surface tree (parse_module, no normalize pass) rather than the normalized tree: this lens's target is a source-syntax defect (a find_named_child(name: ^grammar_production_identity_node_projection) call whose result escapes un-reduced) that must be located by the surface grammar's own ^dag_surface_match_expr production identity - the proven-working precedent (v2.test.claim.manual.body_lowering_match's body_lowering_find_match_expr) locates match_expr the same way, on the pre-normalize tree, because downstream body-lowering/normalize stages replace a match construct's surface identity with a ComputationNode\{behavior: Match\} - by the time a tree is normalized, ^dag_surface_match_expr is no longer a reliable anchor for this static-analysis walk."

// Carries artifact.span_index and the original source_text alongside the parsed tree, not just the tree: analyze.arg_value_symbol needs both to recover a caret literal's actual referenced identifier text (node_source_symbol_note in analyze.dag) - the grammar's caret-literal terminal is StampClass-stamped, so the Node tree's atom-identity field alone cannot distinguish e.g. ^grammar_production_identity_node_projection from any other caret literal.
type SourceFindingsStanding
  = SourceFindingsEstablished { findings: List<Finding> }
  | SourceFindingsNotEstablished { cause: SourceAnalysisNotEstablishedCause }

type SourceTreeStanding
  = SourceTreeEstablished { parsed: ParsedSource }
  | SourceTreeNotEstablished { cause: SourceAnalysisNotEstablishedCause }

// Local to this analyzer: only the not-established CAUSE vocabulary is shared. The standing is
// still returned whole so callers can keep clean, suspect, and could-not-analyze distinct.
type FindingStanding
  = NoSuspect
  | SuspectObserved { suspects: Int }
  | FindingNotEstablished { cause: SourceAnalysisNotEstablishedCause }

fn finding_standing_established_clean(standing: FindingStanding) -> Bool {
  match standing {
    NoSuspect => true
    SuspectObserved { suspects: _ } => false
    FindingNotEstablished { cause: _ } => false
  }
}

fn finding_standing_observed_suspect(standing: FindingStanding) -> Bool {
  match standing {
    NoSuspect => false
    SuspectObserved { suspects: _ } => true
    FindingNotEstablished { cause: _ } => false
  }
}

type ParsedSource {
  tree: Node,
  span_index: SpanIndex,
  source_text: String
}

// THE GRAMMAR IS MATCHED BEFORE THE SUBJECT IS READ, and that ordering is a correctness fix rather
// than a tidier spelling. This function used to pass `lm.grammar` straight into parse_module without
// inspecting it, so a VOID GRAMMAR ARRIVED DISGUISED AS A PARSE REJECTION: at that site the lens
// could not distinguish "the language model has no grammar" from "this text does not parse", and
// the information was already gone. Those have opposite owners -- a grammar outage cannot be
// repaired by anyone editing a snippet, an unparsable snippet is repaired by its author, at once.
// Matching first is what lets each not-established cause below be true rather than merely typed.
fn source_findings_tree(source_text: String) -> SourceTreeStanding {
  let lm = dag_language_model()
  match lm.grammar {
    VoidGrammar => SourceTreeNotEstablished { cause: LanguageGrammarUnavailable }
    ModeledGrammar { root: _ } =>
      match tokenize(
        text: source_text,
        file: ^identity_captured_navigation_roster_subject,
        rules: lm.lex
      ) {
        Rejected { diagnostics: _ } => SourceTreeNotEstablished { cause: SourceTokenizationRejected }
        Accepted { value: stream, diagnostics: _ } =>
          match parse_module(tokens: stream, grammar: lm.grammar) {
            Rejected { diagnostics: _ } => SourceTreeNotEstablished { cause: SourceParseRejected }
            Accepted { value: artifact, diagnostics: _ } =>
              SourceTreeEstablished {
                parsed: ParsedSource {
                  tree: artifact.tree,
                  span_index: artifact.span_index,
                  source_text: source_text
                }
              }
          }
      }
  }
}

fn source_findings(source_text: String) -> SourceFindingsStanding {
  match source_findings_tree(source_text: source_text) {
    SourceTreeNotEstablished { cause: cause } => SourceFindingsNotEstablished { cause: cause }
    SourceTreeEstablished { parsed: parsed } =>
      SourceFindingsEstablished {
        findings: identity_captured_navigation_findings(
          root: parsed.tree,
          span_index: parsed.span_index,
          source_text: parsed.source_text
        )
      }
  }
}

fn ingest_findings(path: String) -> Optional<List<Finding>> {
  source_findings(source_text: filesystem_read(path: path).content)
}

fn count_matching(fs: List<Finding>, pred: fn(Finding) -> Bool) -> Int {
  fold_list(xs: fs, empty: 0, cons: fn(acc, f) {
    if pred(f) { acc + 1 } else { acc }
  })
}

type RosterVerdict
  = RosterClean
  | RosterIngestRegressed
  | RosterSuspectFound
  | RosterRatchetExceeded { refusals: Int, ceiling: Int }

fn file_verdict(path: String, refusal_ceiling: Int) -> RosterVerdict {
  match ingest_findings(path: path) {
    Absent => RosterIngestRegressed
    Present { value: fs } =>
      if count_matching(fs: fs, pred: v2.lens.identity_captured_navigation.analyze.finding_is_suspect) > 0 {
        RosterSuspectFound
      } else {
        let refusals = count_matching(fs: fs, pred: v2.lens.identity_captured_navigation.analyze.finding_is_refusal)
        if refusals > refusal_ceiling {
          RosterRatchetExceeded { refusals: refusals, ceiling: refusal_ceiling }
        } else {
          RosterClean
        }
      }
  }
}

fn file_suspect_count(path: String) -> Int {
  match ingest_findings(path: path) {
    Absent => -1
    Present { value: fs } => count_matching(fs: fs, pred: v2.lens.identity_captured_navigation.analyze.finding_is_suspect)
  }
}

fn file_refusal_count(path: String) -> Int {
  match ingest_findings(path: path) {
    Absent => -1
    Present { value: fs } => count_matching(fs: fs, pred: v2.lens.identity_captured_navigation.analyze.finding_is_refusal)
  }
}

fn file_gate(path: String, refusal_ceiling: Int) -> Bool {
  match file_verdict(path: path, refusal_ceiling: refusal_ceiling) {
    RosterClean => true
    RosterIngestRegressed => false
    RosterSuspectFound => false
    RosterRatchetExceeded { refusals: _, ceiling: _ } => false
  }
}

// THE STANDING IS RETURNED, NOT COLLAPSED -- the same repair as the accumulator lens's, for the
// identical defect. `source_has_suspect -> Bool` answered `false` when the analysis could not be
// established, and `false` is the value that MEANS "no suspect", so an unread subject reported the
// clean verdict. The controls that rest on this are the `== false` GREEN controls pinning the lens
// against FALSE POSITIVES: if their snippet ever stopped parsing they asserted "not flagged" about
// a source nobody read, and the anti-false-positive guarantee would have evaporated in silence.
fn source_finding_standing(source_text: String) -> FindingStanding {
  match source_findings(source_text: source_text) {
    SourceFindingsNotEstablished { cause: cause } => FindingNotEstablished { cause: cause }
    SourceFindingsEstablished { findings: fs } => {
      let suspects = count_matching(fs: fs, pred: v2.lens.identity_captured_navigation.analyze.finding_is_suspect)
      if suspects > 0 { SuspectObserved { suspects: suspects } } else { NoSuspect }
    }
  }
}
