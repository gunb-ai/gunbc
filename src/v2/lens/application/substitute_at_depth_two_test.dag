module v2.test.lens_application.substitute_at_depth_two

data substitute_original_leaf: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^substitute_original_leaf_symbol } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data substitute_replacement_leaf: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^substitute_replacement_leaf_symbol } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data substitute_middle: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
  children: [
    v2.std.node.Edge {
      label: v2.std.node.Named { name: ^substitute_step_b },
      target: substitute_original_leaf
    }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data substitute_root: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
  children: [
    v2.std.node.Edge {
      label: v2.std.node.Named { name: ^substitute_step_a },
      target: substitute_middle
    }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data substitute_expected_root: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
  children: [
    v2.std.node.Edge {
      label: v2.std.node.Named { name: ^substitute_step_a },
      target: v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
        children: [
          v2.std.node.Edge {
            label: v2.std.node.Named { name: ^substitute_step_b },
            target: substitute_replacement_leaf
          }
        ],
        occurrence_id: v2.std.node.SyntheticOccurrence
}
    }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

test fn substitute_at_depth_two_claim_holds() -> v2.std.logic.Bool {
  match v2.lens.application.substitute_at(
    root: substitute_root,
    path: v2.std.node.Path { steps: [^substitute_step_a, ^substitute_step_b] },
    replacement: substitute_replacement_leaf
  ) {
    Accepted { value: n, diagnostics: _ } => n == substitute_expected_root
    Rejected { diagnostics: _ } => false
  }
}
