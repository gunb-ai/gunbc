module v2.test.lens_application.introspect_clean_tree_passes


data introspect_root: Node = claim_atom_node(s: ^introspect_claim_symbol)

fn introspect_tree() -> v2.compiler.infer.InferredTree {
  claim_inferred_tree(
    root: introspect_root,
    facts: claim_inferred_facts(
      type_symbol: ^introspect_type_symbol,
      algebra_symbol: ^introspect_algebra_symbol,
      descent_symbol: ^introspect_descent_symbol,
    )
  )
}

fn introspect_passing_gate(_tree: v2.compiler.infer.InferredTree) -> Outcome<Witness<Node>> {
  v2.std.diagnostic.Accepted { value: v2.std.witness.Holds { value: introspect_root }, diagnostics: None }
}

data introspect_passing_lens: v2.compiler.compile.CompileLens = v2.compiler.compile.CompileLens { gate: introspect_passing_gate }

fn introspect_clean_tree_passes_claim_holds() -> Bool {
  match apply_compile_lens(lens: introspect_passing_lens, inferred: introspect_tree(), mode: CompileLensIntrospect) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn introspect_clean_tree_passes_claim_rhs() -> Node {
  if introspect_clean_tree_passes_claim_holds() {
    introspect_root
  } else {
    v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_introspect_clean_tree_passes: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "lens_application/introspect_clean_tree_passes: Introspect apply_lens accepts clean tree",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: introspect_root,
  rhs: introspect_clean_tree_passes_claim_rhs(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
