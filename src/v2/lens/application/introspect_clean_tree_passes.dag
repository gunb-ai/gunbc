module v2.test.lens_application.introspect_clean_tree_passes

import v2.compiler.compile { CompileLens, CompileLensIntrospect, apply_compile_lens }
import v2.compiler.infer { InferredTree }
import v2.std.diagnostic { Accepted, None, Outcome, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Atom, Conj, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v2.std.witness { Holds, Witness }
import v2.test.lens_common.infer_fixture {
  claim_atom_node,
  claim_inferred_facts,
  claim_inferred_tree
}

data introspect_root: Node = claim_atom_node(s: ^introspect_claim_symbol)

fn introspect_tree() -> InferredTree {
  claim_inferred_tree(
    root: introspect_root,
    facts: claim_inferred_facts(
      type_symbol: ^introspect_type_symbol,
      algebra_symbol: ^introspect_algebra_symbol,
      descent_symbol: ^introspect_descent_symbol,
    )
  )
}

fn introspect_passing_gate(_tree: InferredTree) -> Outcome<Witness<Node>> {
  Accepted { value: Holds { value: introspect_root }, diagnostics: None }
}

data introspect_passing_lens: CompileLens = CompileLens { gate: introspect_passing_gate }

fn introspect_clean_tree_passes_claim_holds() -> Bool {
  match apply_compile_lens(lens: introspect_passing_lens, inferred: introspect_tree(), mode: CompileLensIntrospect) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn introspect_clean_tree_passes_claim_rhs() -> Node {
  if introspect_clean_tree_passes_claim_holds() {
    introspect_root
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_introspect_clean_tree_passes: TestClaim = EqualsClaim {
  label: "lens_application/introspect_clean_tree_passes: Introspect apply_lens accepts clean tree",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: introspect_root,
  rhs: introspect_clean_tree_passes_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
