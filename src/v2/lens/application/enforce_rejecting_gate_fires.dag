module v2.test.lens_application.enforce_rejecting_gate_fires


data enforce_reject_root: Node = claim_atom_node(s: ^enforce_reject_symbol)

fn enforce_reject_tree() -> InferredTree {
  claim_inferred_tree(
    root: enforce_reject_root,
    facts: claim_inferred_facts(
      type_symbol: ^enforce_reject_type_symbol,
      algebra_symbol: ^enforce_reject_algebra_symbol,
      descent_symbol: ^enforce_reject_descent_symbol,
    )
  )
}

fn enforce_rejecting_gate(_tree: InferredTree) -> Outcome<Witness<Node>> {
  outcome_rejected(
    compile_lens_gate_rejected_diagnostic(at: port_locus(port: ^enforce_reject_gate_at))
  )
}

data enforce_rejecting_lens: CompileLens = CompileLens { gate: enforce_rejecting_gate }

fn enforce_rejecting_gate_fires_claim_holds() -> Bool {
  match apply_compile_lens(lens: enforce_rejecting_lens, inferred: enforce_reject_tree(), mode: CompileLensEnforce) {
    Rejected { diagnostics: r } => r.head.reason == ^compile_lens_gate_rejected
    Accepted { value: _, diagnostics: _ } => false
  }
}

fn enforce_rejecting_gate_fires_claim_rhs() -> Node {
  if enforce_rejecting_gate_fires_claim_holds() {
    enforce_reject_root
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_enforce_rejecting_gate_fires: TestClaim = EqualsClaim {
  label: "lens_application/enforce_rejecting_gate_fires: Enforce apply_lens rejects gate",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: enforce_reject_root,
  rhs: enforce_rejecting_gate_fires_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
