module v2.test.lens_application.substitute_at_depth_two


data substitute_original_leaf: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^substitute_original_leaf_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data substitute_replacement_leaf: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^substitute_replacement_leaf_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data substitute_middle: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [
    v2.std.node.Edge {
      label: Named { name: ^substitute_step_b },
      target: substitute_original_leaf
    }
  ],
  occurrence_id: SyntheticOccurrence
}

data substitute_root: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [
    v2.std.node.Edge {
      label: Named { name: ^substitute_step_a },
      target: substitute_middle
    }
  ],
  occurrence_id: SyntheticOccurrence
}

data substitute_expected_root: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [
    v2.std.node.Edge {
      label: Named { name: ^substitute_step_a },
      target: v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: Conj },
        children: [
          v2.std.node.Edge {
            label: Named { name: ^substitute_step_b },
            target: substitute_replacement_leaf
          }
        ],
        occurrence_id: SyntheticOccurrence
}
    }
  ],
  occurrence_id: SyntheticOccurrence
}

fn substitute_at_depth_two_claim_holds() -> Bool {
  match substitute_at(
    root: substitute_root,
    path: v2.std.node.Path { steps: [^substitute_step_a, ^substitute_step_b] },
    replacement: substitute_replacement_leaf
  ) {
    Accepted { value: n, diagnostics: _ } => n == substitute_expected_root
    Rejected { diagnostics: _ } => false
  }
}

fn substitute_at_depth_two_claim_rhs() -> Node {
  if substitute_at_depth_two_claim_holds() {
    substitute_expected_root
  } else {
    v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_substitute_at_depth_two: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "lens_application/substitute_at_depth_two: path depth 2 preserves root ancestry",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: substitute_expected_root,
  rhs: substitute_at_depth_two_claim_rhs(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
