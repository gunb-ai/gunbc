// Temporary probe — delete after emission-law fixture selection.
module v2.test.lens_application.emission_law_probe

import v2.compiler.source_authority {
  canonical_dag_source_parse_print_law,
  source_authority_round_trip
}
import v2.extdeps.languages.dag {
  dag_mvp1_loop_source_text,
  dag_mvp1_loop_target_model,
  dag_mvp1_source_text,
  dag_mvp1_target_model
}
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.witness { Holds, Violates }

fn loop_law() -> Bool {
  match canonical_dag_source_parse_print_law(
    source: dag_mvp1_loop_source_text,
    canonical_source_target: dag_mvp1_loop_target_model()
  ) {
    Accepted { value: w, diagnostics: _ } =>
      match w { Holds { value: _ } => true, Violates { diagnostic: _ } => false }
    Rejected { diagnostics: _ } => false
  }
}

fn add_law() -> Bool {
  match canonical_dag_source_parse_print_law(
    source: dag_mvp1_source_text,
    canonical_source_target: dag_mvp1_target_model()
  ) {
    Accepted { value: w, diagnostics: _ } =>
      match w { Holds { value: _ } => true, Violates { diagnostic: _ } => false }
    Rejected { diagnostics: _ } => false
  }
}

test fn emission_law_probe_loop_holds() -> Bool { loop_law() }
test fn emission_law_probe_add_holds() -> Bool { add_law() }

fn add_round_trip() -> Bool {
  match source_authority_round_trip(
    source: dag_mvp1_source_text,
    canonical_source_target: dag_mvp1_target_model()
  ) {
    Accepted { value: w, diagnostics: _ } =>
      match w { Holds { value: _ } => true, Violates { diagnostic: _ } => false }
    Rejected { diagnostics: _ } => false
  }
}

test fn emission_law_probe_add_round_trip_holds() -> Bool { add_round_trip() }
