module v2.test.lens_application.subterm_at_ambiguous_duplicate_name

data ambiguous_leaf_a: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^ambiguous_leaf_a_symbol } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data ambiguous_leaf_b: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^ambiguous_leaf_b_symbol } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data ambiguous_duplicate_name_root: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
  children: [
    v2.std.node.Edge {
      label: v2.std.node.Named { name: ^ambiguous_dup_step },
      target: ambiguous_leaf_a
    },
    v2.std.node.Edge {
      label: v2.std.node.Named { name: ^ambiguous_dup_step },
      target: ambiguous_leaf_b
    }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

test fn subterm_at_ambiguous_duplicate_name_claim_holds() -> v2.std.logic.Bool {
  match v2.lens.application.subterm_at(
    root: ambiguous_duplicate_name_root,
    path: v2.std.node.Path { steps: [^ambiguous_dup_step] }
  ) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}
