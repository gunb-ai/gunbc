module v2.test.lens_application.apply_lens_introspect_rejection_is_advisory


data apply_lens_mode_root: Node = claim_atom_node(s: ^apply_lens_mode_symbol)

fn apply_lens_mode_tree() -> InferredTree {
  claim_inferred_tree(
    root: apply_lens_mode_root,
    facts: claim_inferred_facts(
      type_symbol: ^apply_lens_mode_type_symbol,
      algebra_symbol: ^apply_lens_mode_algebra_symbol,
      descent_symbol: ^apply_lens_mode_descent_symbol,
    )
  )
}

fn apply_lens_mode_rejecting_gate(_tree: InferredTree) -> Outcome<Witness<Node>> {
  outcome_rejected(
    compile_lens_gate_rejected_diagnostic(at: port_locus(port: ^apply_lens_mode_gate_at))
  )
}

data apply_lens_mode_rejecting_lens: CompileLens = CompileLens { gate: apply_lens_mode_rejecting_gate }

fn apply_lens_mode_gate_rejects_enforce() -> Bool {
  match apply_compile_lens(
    lens: apply_lens_mode_rejecting_lens,
    inferred: apply_lens_mode_tree(),
    mode: CompileLensEnforce
  ) {
    Rejected { diagnostics: r } => r.head.reason == ^compile_lens_gate_rejected
    Accepted { value: _, diagnostics: _ } => false
  }
}

fn introspect_witness_violates_reason_matches(w: Witness<Node>) -> Bool {
  match w {
    Violates { diagnostic: d } => d.reason == ^compile_lens_gate_rejected
    Holds { value: _ } => false
  }
}

fn introspect_diagnostics_head_reason_matches(od: Diagnostics) -> Bool {
  match od {
    Some { diagnostics: r } => r.head.reason == ^compile_lens_gate_rejected
    None => false
  }
}

fn apply_lens_mode_gate_is_advisory_in_introspect() -> Bool {
  match apply_compile_lens(
    lens: apply_lens_mode_rejecting_lens,
    inferred: apply_lens_mode_tree(),
    mode: CompileLensIntrospect
  ) {
    Accepted { value: w, diagnostics: od } =>
      introspect_witness_violates_reason_matches(w: w) &&
      introspect_diagnostics_head_reason_matches(od: od)
    Rejected { diagnostics: _ } => false
  }
}

fn apply_lens_introspect_rejection_is_advisory_claim_holds() -> Bool {
  apply_lens_mode_gate_rejects_enforce() && apply_lens_mode_gate_is_advisory_in_introspect()
}

fn apply_lens_introspect_rejection_is_advisory_claim_rhs() -> Node {
  if apply_lens_introspect_rejection_is_advisory_claim_holds() {
    apply_lens_mode_root
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_apply_lens_introspect_rejection_is_advisory: TestClaim = EqualsClaim {
  label: "lens_application/apply_lens_introspect_rejection_is_advisory: Introspect accepts gate rejection as advisory; head reason forwarded from original rejection",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: apply_lens_mode_root,
  rhs: apply_lens_introspect_rejection_is_advisory_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
