module v2.test.lens_application.rejecting_lens_blocks_before_compile


data rejecting_lens_target_model_stub: TargetModel = TargetModel {
  bundle: Node {
    kind: TypeNode { connective: Conj },
    children: [],
    occurrence_id: SyntheticOccurrence
},
  lex: VoidLexRules,
  binding_spellings: empty_map(),
  token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: Empty,
  runtime_row: target_emit_host_runtime_row_unconfigured
}

data rejecting_lens_authority_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^rejecting_lens_claim_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn rejecting_lens_gate(_tree: InferredTree) -> Outcome<Witness<Node>> {
  outcome_rejected(
    compile_lens_gate_rejected_diagnostic(at: port_locus(port: ^rejecting_lens_gate_at))
  )
}

data rejecting_lens: CompileLens = CompileLens { gate: rejecting_lens_gate }

fn rejecting_lens_blocks_before_compile_claim_holds() -> Bool {
  match validate_then_compile(
    source: fixture_add_resolved_tree(),
    lenses: [rejecting_lens],
    mode: TranslateTo { target: rejecting_lens_target_model_stub }
  ) {
    Rejected { diagnostics: r } => r.head.reason == ^compile_lens_gate_rejected
    Accepted { value: _, diagnostics: _ } => false
  }
}

fn rejecting_lens_blocks_before_compile_claim_rhs() -> Node {
  if rejecting_lens_blocks_before_compile_claim_holds() {
    rejecting_lens_authority_node
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_rejecting_lens_blocks_before_compile: TestClaim = EqualsClaim {
  label: "lens_application/rejecting_lens_blocks_before_compile: rejecting lens blocks compile",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: rejecting_lens_authority_node,
  rhs: rejecting_lens_blocks_before_compile_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
