module v2.test.lens_application.rejecting_lens_blocks_before_compile


data rejecting_lens_target_model_stub: v2.std.compilers.target_model.TargetModel = v2.std.compilers.target_model.TargetModel {
  produced_decl_support: ProducedDeclUnwired,
  bundle: v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [],
    occurrence_id: SyntheticOccurrence
},
  lex: VoidLexRules,
  binding_spellings: empty_map(),
  token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: std.algebra.Empty,
  runtime_row: target_emit_host_runtime_row_unconfigured
}

data rejecting_lens_authority_node: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^rejecting_lens_claim_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn rejecting_lens_gate(_tree: v2.compiler.inferred_tree.InferredTree) -> Outcome<Witness<Node>> {
  outcome_rejected(
    compile_lens_gate_rejected_diagnostic(at: port_locus(port: ^rejecting_lens_gate_at))
  )
}

data rejecting_lens: v2.compiler.compile.CompileLens = v2.compiler.compile.CompileLens { gate: rejecting_lens_gate }

fn rejecting_lens_blocks_before_compile_claim_holds() -> Bool {
  match validate_then_compile(
    source: fixture_add_resolved_tree(),
    lenses: [rejecting_lens],
    mode: v2.compiler.compile.TranslateTo { target: rejecting_lens_target_model_stub }
  ) {
    Rejected { diagnostics: r } => r.head.reason == ^compile_lens_gate_rejected
    Accepted { value: _, diagnostics: _ } => false
  }
}

fn rejecting_lens_blocks_before_compile_claim_rhs() -> Node {
  if rejecting_lens_blocks_before_compile_claim_holds() {
    rejecting_lens_authority_node
  } else {
    v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_rejecting_lens_blocks_before_compile: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "lens_application/rejecting_lens_blocks_before_compile: rejecting lens blocks compile",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: rejecting_lens_authority_node,
  rhs: rejecting_lens_blocks_before_compile_claim_rhs(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
