module v2.test.lens_application.serialize_applied_diff_swap_operands


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data serialize_loop_body_edit: Edit = Edit {
  at: Path { steps: [^arrow_body_edge] },
  replacement: dag_loop_body_wrong_value_node()
}

data serialize_loop_body_diff: Diff = Diff {
  edits: [serialize_loop_body_edit]
}

data serialize_loop_target: TargetModel = dag_loop_target_model()

fn serialize_loop_before_after_differ() -> Bool {
  match target_serialize_source_from_model(
    target: serialize_loop_target,
    emitted: dag_fixture_emitted_loop_fn
  ) {
    Accepted { value: before, diagnostics: _ } =>
      match target_serialize_source_from_model(
        target: serialize_loop_target,
        emitted: dag_loop_arrow_with_body_wrong_value_fixture
      ) {
        Accepted { value: after, diagnostics: _ } => before != after
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

data serialize_add_target: TargetModel = dag_target_model()

fn serialize_add_serializer_determinism_holds() -> Bool {
  match target_serialize_source_from_model(
    target: serialize_add_target,
    emitted: dag_fixture_emitted_add_fn
  ) {
    Accepted { value: first, diagnostics: _ } =>
      match target_serialize_source_from_model(
        target: serialize_add_target,
        emitted: dag_fixture_emitted_add_fn
      ) {
        Accepted { value: second, diagnostics: _ } =>
          match deterministic_dag_source_serializer_witness(first: first, second: second) {
            Holds { value: _ } => true
            Violates { diagnostic: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn serialize_loop_applied_diff_matches_authority_after() -> Bool {
  match apply_diff(
    root: dag_fixture_emitted_loop_fn,
    d: serialize_loop_body_diff
  ) {
    Accepted { value: patched, diagnostics: _ } =>
      match target_serialize_source_from_model(
        target: serialize_loop_target,
        emitted: patched
      ) {
        Accepted { value: patched_source, diagnostics: _ } =>
          match target_serialize_source_from_model(
            target: serialize_loop_target,
            emitted: dag_loop_arrow_with_body_wrong_value_fixture
          ) {
            Accepted { value: authority_after, diagnostics: _ } =>
              patched_source == authority_after
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn serialize_loop_apply_diff_structurally_matches() -> Bool {
  match apply_diff(
    root: dag_fixture_emitted_loop_fn,
    d: serialize_loop_body_diff
  ) {
    Accepted { value: patched, diagnostics: _ } =>
      patched == dag_loop_arrow_with_body_wrong_value_fixture
    Rejected { diagnostics: _ } => false
  }
}

fn serialize_loop_authority_before_source() -> Outcome<Medium<String>> {
  target_serialize_source_from_model(
    target: serialize_loop_target,
    emitted: dag_fixture_emitted_loop_fn
  )
}

fn serialize_loop_authority_after_source() -> Outcome<Medium<String>> {
  target_serialize_source_from_model(
    target: serialize_loop_target,
    emitted: dag_loop_arrow_with_body_wrong_value_fixture
  )
}

fn serialize_loop_patch_carrier_holds() -> Bool {
  match serialize_diff_as_source_patch(
    root: dag_fixture_emitted_loop_fn,
    diff: serialize_loop_body_diff,
    canonical_source_target: serialize_loop_target
  ) {
    Accepted { value: patch, diagnostics: _ } =>
      match serialize_loop_authority_before_source() {
        Accepted { value: authority_before, diagnostics: _ } =>
          match serialize_loop_authority_after_source() {
            Accepted { value: authority_after, diagnostics: _ } =>
              patch.before == authority_before
                && patch.after == authority_after
                && patch.before != patch.after
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn serialize_applied_diff_loop_body_claim_holds() -> Bool {
  serialize_loop_apply_diff_structurally_matches()
    && serialize_add_serializer_determinism_holds()
    && serialize_loop_before_after_differ()
    && serialize_loop_applied_diff_matches_authority_after()
    && serialize_loop_patch_carrier_holds()
}

test fn serialize_applied_diff_loop_body_holds() -> Bool {
  serialize_applied_diff_loop_body_claim_holds()
}
