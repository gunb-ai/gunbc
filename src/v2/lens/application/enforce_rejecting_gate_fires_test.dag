module v2.test.lens_application.enforce_rejecting_gate_fires

data enforce_reject_root: v2.std.node.Node = v2.test.lens_common.infer_fixture.claim_atom_node(s: ^enforce_reject_symbol)

fn enforce_reject_tree() -> v2.compiler.inferred_tree.InferredTree {
  v2.test.lens_common.infer_fixture.claim_inferred_tree(
    root: enforce_reject_root,
    facts: v2.test.lens_common.infer_fixture.claim_inferred_facts(
      type_symbol: ^enforce_reject_type_symbol,
      algebra_symbol: ^enforce_reject_algebra_symbol,
      descent_symbol: ^enforce_reject_descent_symbol,
    )
  )
}

fn enforce_rejecting_gate(_tree: v2.compiler.inferred_tree.InferredTree) -> v2.std.diagnostic.Outcome<v2.std.witness.Witness<v2.std.node.Node>> {
  v2.std.diagnostic.outcome_rejected(
    v2.compiler.compile.compile_lens_gate_rejected_diagnostic(at: v2.std.diagnostic.port_locus(port: ^enforce_reject_gate_at))
  )
}

data enforce_rejecting_lens: v2.compiler.compile.CompileLens = v2.compiler.compile.CompileLens { gate: enforce_rejecting_gate }

test fn enforce_rejecting_gate_fires_claim_holds() -> v2.std.logic.Bool {
  match v2.compiler.compile.apply_compile_lens(lens: enforce_rejecting_lens, inferred: enforce_reject_tree(), mode: v2.compiler.compile.CompileLensEnforce) {
    v2.std.diagnostic.Rejected { diagnostics: r } => r.head.reason == ^compile_lens_gate_rejected
    Accepted { value: _, diagnostics: _ } => false
  }
}
