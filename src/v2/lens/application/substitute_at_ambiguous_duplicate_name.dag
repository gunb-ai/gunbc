module v2.test.lens_application.substitute_at_ambiguous_duplicate_name


data substitute_ambiguous_leaf_a: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^substitute_ambiguous_leaf_a_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data substitute_ambiguous_leaf_b: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^substitute_ambiguous_leaf_b_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data substitute_ambiguous_replacement: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^substitute_ambiguous_replacement_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data substitute_ambiguous_duplicate_name_root: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [
    v2.std.node.Edge {
      label: Named { name: ^substitute_ambiguous_dup_step },
      target: substitute_ambiguous_leaf_a
    },
    v2.std.node.Edge {
      label: Named { name: ^substitute_ambiguous_dup_step },
      target: substitute_ambiguous_leaf_b
    }
  ],
  occurrence_id: SyntheticOccurrence
}

fn substitute_at_ambiguous_duplicate_name_claim_holds() -> Bool {
  match substitute_at(
    root: substitute_ambiguous_duplicate_name_root,
    path: v2.std.node.Path { steps: [^substitute_ambiguous_dup_step] },
    replacement: substitute_ambiguous_replacement
  ) {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}

fn substitute_at_ambiguous_duplicate_name_claim_rhs() -> Node {
  if substitute_at_ambiguous_duplicate_name_claim_holds() {
    substitute_ambiguous_duplicate_name_root
  } else {
    v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
    }
  }
}

data claim_substitute_at_ambiguous_duplicate_name: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "lens_application/substitute_at_ambiguous_duplicate_name: duplicate named edge rejects",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: substitute_ambiguous_duplicate_name_root,
  rhs: substitute_at_ambiguous_duplicate_name_claim_rhs(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
