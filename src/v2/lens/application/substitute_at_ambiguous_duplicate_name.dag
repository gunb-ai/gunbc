module v2.test.lens_application.substitute_at_ambiguous_duplicate_name


data substitute_ambiguous_leaf_a: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^substitute_ambiguous_leaf_a_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data substitute_ambiguous_leaf_b: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^substitute_ambiguous_leaf_b_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data substitute_ambiguous_replacement: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^substitute_ambiguous_replacement_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data substitute_ambiguous_duplicate_name_root: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^substitute_ambiguous_dup_step },
      target: substitute_ambiguous_leaf_a
    },
    Edge {
      label: Named { name: ^substitute_ambiguous_dup_step },
      target: substitute_ambiguous_leaf_b
    }
  ],
  occurrence_id: SyntheticOccurrence
}

fn substitute_at_ambiguous_duplicate_name_claim_holds() -> Bool {
  match substitute_at(
    root: substitute_ambiguous_duplicate_name_root,
    path: Path { steps: [^substitute_ambiguous_dup_step] },
    replacement: substitute_ambiguous_replacement
  ) {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}

fn substitute_at_ambiguous_duplicate_name_claim_rhs() -> Bool {
  substitute_at_ambiguous_duplicate_name_claim_holds()
}

data claim_substitute_at_ambiguous_duplicate_name: TestClaim = EqualsClaim {
  label: "lens_application/substitute_at_ambiguous_duplicate_name: duplicate named edge rejects",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: substitute_at_ambiguous_duplicate_name_claim_rhs(),
  rhs: true,
  classification: TestClassification { tier: Tier1, layer: Unit }
}
