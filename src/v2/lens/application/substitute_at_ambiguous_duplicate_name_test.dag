module v2.test.lens_application.substitute_at_ambiguous_duplicate_name

data substitute_ambiguous_leaf_a: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^substitute_ambiguous_leaf_a_symbol } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data substitute_ambiguous_leaf_b: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^substitute_ambiguous_leaf_b_symbol } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data substitute_ambiguous_replacement: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^substitute_ambiguous_replacement_symbol } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data substitute_ambiguous_duplicate_name_root: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
  children: [
    v2.std.node.Edge {
      label: v2.std.node.Named { name: ^substitute_ambiguous_dup_step },
      target: substitute_ambiguous_leaf_a
    },
    v2.std.node.Edge {
      label: v2.std.node.Named { name: ^substitute_ambiguous_dup_step },
      target: substitute_ambiguous_leaf_b
    }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

test fn substitute_at_ambiguous_duplicate_name_claim_holds() -> Bool {
  match v2.lens.application.substitute_at(
    root: substitute_ambiguous_duplicate_name_root,
    path: v2.std.node.Path { steps: [^substitute_ambiguous_dup_step] },
    replacement: substitute_ambiguous_replacement
  ) {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}
