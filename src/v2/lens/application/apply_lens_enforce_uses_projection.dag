module v2.test.lens_application.apply_lens_enforce_uses_projection


data projection_test_section: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^projection_section_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data projection_test_root: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^projection_test_symbol } },
  children: [
    v2.std.node.Edge {
      label: Named { name: ^projection_section_step },
      target: projection_test_section
    }
  ],
  occurrence_id: SyntheticOccurrence
}

fn projection_test_read(root: v2.std.node.Node) -> Outcome<v2.std.node.Symbol> {
  match root.kind {
    TypeNode { connective: Atom { identity: id } } => outcome_accepted(value: id)
    TypeNode { connective: Conj } => outcome_accepted(value: ^projection_test_symbol)
    ComputationNode { behavior: _ } => outcome_accepted(value: ^projection_test_symbol)
  }
}

data projection_test_lens: Lens<v2.std.node.Symbol> = v2.lens.application.Lens { read: projection_test_read }

fn projection_test_project(output: v2.std.node.Symbol) -> v2.std.node.Symbol {
  ^projection_projected_symbol
}

fn projection_test_violates(output: v2.std.node.Symbol, declared: v2.std.node.Symbol) -> Bool {
  output == ^projection_budget_fail && declared == ^projection_budget_fail
}

data projection_test_enforcement: LensEnforcement<Symbol, Symbol, Symbol> = v2.lens.application.LensEnforcement {
  project: projection_test_project,
  violates: projection_test_violates
}

data projection_test_enforceable: EnforceableLens<Symbol, Symbol, Symbol> = v2.lens.application.EnforceableLens {
  lens: projection_test_lens,
  enforcement: projection_test_enforcement
}

data projection_test_declaration: v2.lens.application.DeclarationId = v2.lens.application.DeclarationId {
  path: v2.std.node.Path { steps: [^projection_section_step] }
}

fn apply_lens_enforce_projection_claim_holds() -> Bool {
  match apply_lens_enforce(
    enforceable: projection_test_enforceable,
    section: v2.lens.application.DeclarationScope { declaration: projection_test_declaration },
    root: projection_test_root,
    budget: ^projection_budget_ok
  ) {
    Accepted { value: result, diagnostics: _ } =>
      result.output == ^projection_section_symbol && result.projected == ^projection_projected_symbol
    Rejected { diagnostics: _ } => false
  }
}

fn apply_lens_enforce_projection_claim_rhs() -> v2.std.node.Node {
  if apply_lens_enforce_projection_claim_holds() {
    projection_test_root
  } else {
    v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
    }
  }
}

data claim_apply_lens_enforce_uses_projection: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "lens_application/apply_lens_enforce_uses_projection: enforce result carries projection",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: projection_test_root,
  rhs: apply_lens_enforce_projection_claim_rhs(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
