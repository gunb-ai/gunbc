module v2.test.lens_application.substitute_at_depth_three


data depth_three_original_leaf: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^depth_three_original_leaf_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data depth_three_replacement_leaf: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^depth_three_replacement_leaf_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data depth_three_inner: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [
    v2.std.node.Edge {
      label: Named { name: ^depth_three_step_c },
      target: depth_three_original_leaf
    }
  ],
  occurrence_id: SyntheticOccurrence
}

data depth_three_middle: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [
    v2.std.node.Edge {
      label: Named { name: ^depth_three_step_b },
      target: depth_three_inner
    }
  ],
  occurrence_id: SyntheticOccurrence
}

data depth_three_root: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [
    v2.std.node.Edge {
      label: Named { name: ^depth_three_step_a },
      target: depth_three_middle
    }
  ],
  occurrence_id: SyntheticOccurrence
}

data depth_three_expected_root: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [
    v2.std.node.Edge {
      label: Named { name: ^depth_three_step_a },
      target: v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: Conj },
        children: [
          v2.std.node.Edge {
            label: Named { name: ^depth_three_step_b },
            target: v2.std.node.Node {
              kind: v2.std.node.TypeNode { connective: Conj },
              children: [
                v2.std.node.Edge {
                  label: Named { name: ^depth_three_step_c },
                  target: depth_three_replacement_leaf
                }
              ],
              occurrence_id: SyntheticOccurrence
            }
          }
        ],
        occurrence_id: SyntheticOccurrence
      }
    }
  ],
  occurrence_id: SyntheticOccurrence
}

fn substitute_at_depth_three_claim_holds() -> Bool {
  match substitute_at(
    root: depth_three_root,
    path: v2.std.node.Path {
      steps: [^depth_three_step_a, ^depth_three_step_b, ^depth_three_step_c]
    },
    replacement: depth_three_replacement_leaf
  ) {
    Accepted { value: n, diagnostics: _ } => n == depth_three_expected_root
    Rejected { diagnostics: _ } => false
  }
}

fn substitute_at_depth_three_claim_rhs() -> Node {
  if substitute_at_depth_three_claim_holds() {
    depth_three_expected_root
  } else {
    v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_substitute_at_depth_three: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "lens_application/substitute_at_depth_three: path depth 3 preserves root ancestry",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: depth_three_expected_root,
  rhs: substitute_at_depth_three_claim_rhs(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
