// Scope: by-execution witness — apply_diff + serialize_applied_diff re-emits patched .dag source.

module v2.test.lens_application.serialize_applied_diff_swap_operands

import v2.extdeps.languages.dag {
  dag_mvp1_fixture_emitted_loop_fn,
  dag_mvp1_loop_arrow_with_body_wrong_value_fixture,
  dag_mvp1_loop_body_wrong_value_node,
  dag_mvp1_loop_target_model
}
import v2.lens.application { apply_diff }
import v2.lens.application_serializer {
  serialize_applied_diff,
  serialize_dag_source,
  serialize_diff_as_source_patch
}
import v2.std.compilers.target_model { TargetModel }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Diff, Edit, Path }
import v2.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}

data serialize_loop_body_edit: Edit = Edit {
  at: Path { steps: [^arrow_body_edge] },
  replacement: dag_mvp1_loop_body_wrong_value_node()
}

data serialize_loop_body_diff: Diff = Diff {
  edits: [serialize_loop_body_edit]
}

data serialize_loop_target: TargetModel = dag_mvp1_loop_target_model()

fn serialize_loop_before_after_differ() -> Bool {
  match serialize_dag_source(
    emitted: dag_mvp1_fixture_emitted_loop_fn,
    target: serialize_loop_target
  ) {
    Accepted { value: before, diagnostics: _ } =>
      match serialize_dag_source(
        emitted: dag_mvp1_loop_arrow_with_body_wrong_value_fixture,
        target: serialize_loop_target
      ) {
        Accepted { value: after, diagnostics: _ } => before != after
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn serialize_loop_applied_diff_matches_authority_after() -> Bool {
  match serialize_applied_diff(
    root: dag_mvp1_fixture_emitted_loop_fn,
    diff: serialize_loop_body_diff,
    target: serialize_loop_target
  ) {
    Accepted { value: patched, diagnostics: _ } =>
      match serialize_dag_source(
        emitted: dag_mvp1_loop_arrow_with_body_wrong_value_fixture,
        target: serialize_loop_target
      ) {
        Accepted { value: authority_after, diagnostics: _ } => patched == authority_after
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn serialize_loop_apply_diff_structurally_matches() -> Bool {
  match apply_diff(
    root: dag_mvp1_fixture_emitted_loop_fn,
    d: serialize_loop_body_diff
  ) {
    Accepted { value: patched, diagnostics: _ } =>
      patched == dag_mvp1_loop_arrow_with_body_wrong_value_fixture
    Rejected { diagnostics: _ } => false
  }
}

fn serialize_loop_patch_carrier_holds() -> Bool {
  match serialize_diff_as_source_patch(
    root: dag_mvp1_fixture_emitted_loop_fn,
    diff: serialize_loop_body_diff,
    target: serialize_loop_target
  ) {
    Accepted { value: patch, diagnostics: _ } =>
      if patch.after == patch.before {
        false
      } else {
        serialize_loop_applied_diff_matches_authority_after()
      }
    Rejected { diagnostics: _ } => false
  }
}

fn serialize_applied_diff_loop_body_claim_holds() -> Bool {
  serialize_loop_apply_diff_structurally_matches()
    && serialize_loop_before_after_differ()
    && serialize_loop_applied_diff_matches_authority_after()
    && serialize_loop_patch_carrier_holds()
}

fn serialize_applied_diff_loop_body_claim_rhs() -> Bool {
  serialize_applied_diff_loop_body_claim_holds()
}

data claim_serialize_applied_diff_loop_body: TestClaim = EqualsClaim {
  label: "lens_application_serializer/serialize_applied_diff_loop_body: body edit re-emits distinct canonical source",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: true,
  rhs: serialize_applied_diff_loop_body_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

test fn serialize_applied_diff_loop_body_holds() -> Bool {
  serialize_applied_diff_loop_body_claim_holds()
}
