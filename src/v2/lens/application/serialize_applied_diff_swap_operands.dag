// Scope: by-execution witness — apply_diff + serialize_applied_diff re-emits canonical .dag source.

module v2.test.lens_application.serialize_applied_diff_swap_operands

import v2.extdeps.languages.dag {
  dag_mvp1_add_arrow_with_body_fixture,
  dag_mvp1_add_arrow_with_body_swapped_operands_fixture,
  dag_mvp1_add_binary_body_swapped_operands_fixture,
  dag_mvp1_source_text,
  dag_mvp1_target_model
}
import v2.lens.application_serializer {
  serialize_applied_diff,
  serialize_diff_as_source_patch,
  serialize_dag_source
}
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Diff, Edit, Path }
import v2.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}

data serialize_swap_operands_body_edit: Edit = Edit {
  at: Path { steps: [^arrow_body_edge] },
  replacement: dag_mvp1_add_binary_body_swapped_operands_fixture
}

data serialize_swap_operands_diff: Diff = Diff {
  edits: [serialize_swap_operands_body_edit]
}

data serialize_swap_operands_target: TargetModel = dag_mvp1_target_model()

fn serialize_swap_operands_round_trip_holds() -> Bool {
  match serialize_dag_source(
    emitted: dag_mvp1_add_arrow_with_body_fixture,
    target: serialize_swap_operands_target
  ) {
    Accepted { value: before, diagnostics: _ } =>
      if before == dag_mvp1_source_text {
        match serialize_applied_diff(
          root: dag_mvp1_add_arrow_with_body_fixture,
          diff: serialize_swap_operands_diff,
          target: serialize_swap_operands_target
        ) {
          Accepted { value: after, diagnostics: _ } =>
            match serialize_dag_source(
              emitted: dag_mvp1_add_arrow_with_body_swapped_operands_fixture,
              target: serialize_swap_operands_target
            ) {
              Accepted { value: authority_after, diagnostics: _ } =>
                after == authority_after
              Rejected { diagnostics: _ } => false
            }
          Rejected { diagnostics: _ } => false
        }
      } else {
        false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn serialize_swap_operands_patch_carrier_holds() -> Bool {
  match serialize_diff_as_source_patch(
    root: dag_mvp1_add_arrow_with_body_fixture,
    diff: serialize_swap_operands_diff,
    target: serialize_swap_operands_target
  ) {
    Accepted { value: patch, diagnostics: _ } =>
      patch.before == dag_mvp1_source_text && serialize_swap_operands_round_trip_holds()
    Rejected { diagnostics: _ } => false
  }
}

fn serialize_swap_operands_claim_rhs() -> Bool {
  serialize_swap_operands_patch_carrier_holds()
}

data claim_serialize_applied_diff_swap_operands: TestClaim = EqualsClaim {
  label: "lens_application_serializer/serialize_applied_diff_swap_operands: body swap re-emits y+x source",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: true,
  rhs: serialize_swap_operands_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
