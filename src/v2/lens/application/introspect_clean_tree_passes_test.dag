module v2.test.lens_application.introspect_clean_tree_passes

data introspect_root: v2.std.node.Node = v2.test.lens_common.infer_fixture.claim_atom_node(s: ^introspect_claim_symbol)

fn introspect_tree() -> v2.compiler.inferred_tree.InferredTree {
  v2.test.lens_common.infer_fixture.claim_inferred_tree(
    root: introspect_root,
    facts: v2.test.lens_common.infer_fixture.claim_inferred_facts(
      type_symbol: ^introspect_type_symbol,
      algebra_symbol: ^introspect_algebra_symbol,
      descent_symbol: ^introspect_descent_symbol,
    )
  )
}

fn introspect_passing_gate(_tree: v2.compiler.inferred_tree.InferredTree) -> v2.std.diagnostic.Outcome<v2.std.witness.Witness<v2.std.node.Node>> {
  v2.std.diagnostic.Accepted { value: v2.std.witness.Holds { value: introspect_root }, diagnostics: v2.std.diagnostic.None }
}

data introspect_passing_lens: v2.compiler.compile.CompileLens = v2.compiler.compile.CompileLens { gate: introspect_passing_gate }

test fn introspect_clean_tree_passes_claim_holds() -> Bool {
  match v2.compiler.compile.apply_compile_lens(lens: introspect_passing_lens, inferred: introspect_tree(), mode: v2.compiler.compile.CompileLensIntrospect) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}
