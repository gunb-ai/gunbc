module v2.test.lens_application.empty_required_lenses_skip_gate

data empty_lenses_target_model_stub: v2.std.compilers.target_model.TargetModel = v2.std.compilers.target_model.TargetModel {
  produced_decl_support: v2.std.compilers.target_model.ProducedDeclUnwired,
  bundle: v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
},
  lex: v2.std.compilers.lexing.VoidLexRules,
  binding_spellings: v2.std.collection.empty_map(),
    token_class_emit_transforms: v2.std.compilers.target_model.target_model_emit_transforms_empty,
  authority_source_text: std.algebra.Empty,
  runtime_row: v2.std.host_transport.target_emit_host_runtime_row_unconfigured
}

data empty_lenses_authority_node: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^empty_lenses_claim_symbol } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

fn non_empty_diagnostics_contain_reason(d: v2.std.diagnostic.NonEmptyDiagnostics, reason: v2.std.node.Symbol) -> v2.std.logic.Bool {
  if d.head.reason == reason {
    true
  } else {
    fold(d.tail, init: false, f: fn(acc, diag) {
      acc || (diag.reason == reason)
    })
  }
}

test fn empty_required_lenses_skip_gate_claim_holds() -> v2.std.logic.Bool {
  match v2.compiler.compile.validate_then_compile(
    source: v2.test.manual.infer_ground_add.fixture_add_resolved_tree(),
    lenses: [],
    mode: v2.compiler.compile.TranslateTo { target: empty_lenses_target_model_stub }
  ) {
    Rejected { diagnostics: r } =>
      !v2.test.lens_application.empty_required_lenses_skip_gate.non_empty_diagnostics_contain_reason(d: r, reason: ^compile_lens_gate_rejected)
    Accepted { value: v, diagnostics: _ } =>
      match v.value {
        TranslateResult { source: _ } => true
        _ => false
      }
  }
}
