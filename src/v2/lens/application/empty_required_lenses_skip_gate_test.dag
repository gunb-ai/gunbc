module v2.test.lens_application.empty_required_lenses_skip_gate

import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import v2.compiler.compile {
  CompileOutput,
  TranslateResult,
  TranslateTo,
  Validated,
  validate_then_compile
}
import v2.std.compilers.target_model {
  ProducedDeclUnwired, TargetModel, target_model_emit_transforms_empty }
import v2.std.compilers.lexing { VoidLexRules }
import v2.std.diagnostic { Accepted, NonEmptyDiagnostics, Outcome, Rejected }
import v2.std.logic { Bool }
import std.algebra { Empty }
import v2.std.collection { empty_map }
import v2.std.node { Atom, Conj, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.test.manual.infer_ground_add { fixture_add_resolved_tree }

data empty_lenses_target_model_stub: v2.std.compilers.target_model.TargetModel = v2.std.compilers.target_model.TargetModel {
  produced_decl_support: ProducedDeclUnwired,
  bundle: v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [],
    occurrence_id: SyntheticOccurrence
},
  lex: VoidLexRules,
  binding_spellings: empty_map(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: std.algebra.Empty,
  runtime_row: target_emit_host_runtime_row_unconfigured
}

data empty_lenses_authority_node: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^empty_lenses_claim_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn non_empty_diagnostics_contain_reason(d: v2.std.diagnostic.NonEmptyDiagnostics, reason: v2.std.node.Symbol) -> Bool {
  if d.head.reason == reason {
    true
  } else {
    fold(d.tail, init: false, f: fn(acc, diag) {
      acc || (diag.reason == reason)
    })
  }
}

test fn empty_required_lenses_skip_gate_claim_holds() -> Bool {
  match validate_then_compile(
    source: fixture_add_resolved_tree(),
    lenses: [],
    mode: v2.compiler.compile.TranslateTo { target: empty_lenses_target_model_stub }
  ) {
    Rejected { diagnostics: r } =>
      !non_empty_diagnostics_contain_reason(d: r, reason: ^compile_lens_gate_rejected)
    Accepted { value: v, diagnostics: _ } =>
      match v.value {
        TranslateResult { source: _ } => true
        _ => false
      }
  }
}
