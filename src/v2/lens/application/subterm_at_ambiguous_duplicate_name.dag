module v2.test.lens_application.subterm_at_ambiguous_duplicate_name


data ambiguous_leaf_a: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^ambiguous_leaf_a_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data ambiguous_leaf_b: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^ambiguous_leaf_b_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data ambiguous_duplicate_name_root: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [
    v2.std.node.Edge {
      label: Named { name: ^ambiguous_dup_step },
      target: ambiguous_leaf_a
    },
    v2.std.node.Edge {
      label: Named { name: ^ambiguous_dup_step },
      target: ambiguous_leaf_b
    }
  ],
  occurrence_id: SyntheticOccurrence
}

fn subterm_at_ambiguous_duplicate_name_claim_holds() -> Bool {
  match subterm_at(
    root: ambiguous_duplicate_name_root,
    path: v2.std.node.Path { steps: [^ambiguous_dup_step] }
  ) {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}

fn subterm_at_ambiguous_duplicate_name_claim_rhs() -> Node {
  if subterm_at_ambiguous_duplicate_name_claim_holds() {
    ambiguous_duplicate_name_root
  } else {
    v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
    }
  }
}

data claim_subterm_at_ambiguous_duplicate_name: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "lens_application/subterm_at_ambiguous_duplicate_name: duplicate named edge rejects",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ambiguous_duplicate_name_root,
  rhs: subterm_at_ambiguous_duplicate_name_claim_rhs(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
