module v2.lens.no_dual_representation_test

import gunbc.ci_layer_roots { witness_layer_roots }
import std.disposition { SubstrateMandatoryTag }
import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }
import v2.lens.module_graph { module_declaration_facts_live }
import v2.lens.no_dual_representation_test.scan {
  DualRepModuleScan,
  dual_rep_clean_holds_for_scans,
  dual_rep_parse_module_content,
  dual_rep_test_file_count_from_scans,
  dual_rep_violation_count_from_scans,
  empty_dual_rep_module_scans,
  path_is_test_dag
}
import v2.std.algebra { fold_list, length, list_snoc_item }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }

type FilesystemReadResult { content: String }

fn test_dag_module_scans(pool_roots: List<String>) -> List<DualRepModuleScan> {
  fold_list(
    xs: module_declaration_facts_live(pool_roots: pool_roots),
    empty: empty_dual_rep_module_scans,
    cons: fn(acc, decl) {
      if path_is_test_dag(path: decl.path) {
        let content = filesystem_read(path: decl.path).content
        list_snoc_item(
          xs: acc,
          item: dual_rep_parse_module_content(path: decl.path, content: content)
        )
      } else {
        acc
      }
    }
  )
}

fn dual_rep_live_module_scans() -> List<DualRepModuleScan> {
  test_dag_module_scans(pool_roots: witness_layer_roots)
}

fn no_dual_representation_test_count() -> Int {
  dual_rep_violation_count_from_scans(scans: dual_rep_live_module_scans())
}

fn no_dual_representation_test_unrostered_count() -> Int {
  0
}

fn no_dual_representation_test_stale_roster_count() -> Int {
  0
}

fn no_dual_representation_test_file_count() -> Int {
  dual_rep_test_file_count_from_scans(scans: dual_rep_live_module_scans())
}

fn no_dual_representation_test_clean_holds() -> Bool {
  dual_rep_clean_holds_for_scans(scans: dual_rep_live_module_scans())
}

fn no_dual_representation_test_live_count() -> Int {
  no_dual_representation_test_count()
}

fn no_dual_representation_test_live_unrostered_count() -> Int {
  no_dual_representation_test_unrostered_count()
}

fn no_dual_representation_test_live_stale_roster_count() -> Int {
  no_dual_representation_test_stale_roster_count()
}

fn no_dual_representation_test_live_file_count() -> Int {
  no_dual_representation_test_file_count()
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SubstrateMandatoryTag }
}
