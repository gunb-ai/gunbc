module v2.test.lens_fact_density.hollow_alias_no_fact

import v2.lens.fact_density { NoFact, carrier_spec_fact }
import v2.std.logic { Bool }
import v2.std.node { Atom, Conj, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}

data hollow_alias_input: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^hollow_alias_int32_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn hollow_alias_no_fact_claim_holds() -> Bool {
  carrier_spec_fact(carrier: hollow_alias_input) == NoFact
}

fn hollow_alias_no_fact_claim_rhs() -> Node {
  if hollow_alias_no_fact_claim_holds() {
    hollow_alias_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_hollow_alias_no_fact: TestClaim = EqualsClaim {
  label: "lens_fact_density/hollow_alias: alias without named fields is NoFact",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: hollow_alias_input,
  rhs: hollow_alias_no_fact_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}