module v2.test.lens_fact_density.hollow_alias_no_fact


data hollow_alias_input: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^hollow_alias_int32_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn hollow_alias_no_fact_claim_holds() -> Bool {
  carrier_spec_fact(carrier: hollow_alias_input) == NoFact
}

fn hollow_alias_no_fact_claim_rhs() -> Node {
  if hollow_alias_no_fact_claim_holds() {
    hollow_alias_input
  } else {
    v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_hollow_alias_no_fact: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "lens_fact_density/hollow_alias: alias without named fields is NoFact",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: hollow_alias_input,
  rhs: hollow_alias_no_fact_claim_rhs(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
