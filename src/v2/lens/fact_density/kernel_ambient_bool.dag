module v2.test.lens_fact_density.kernel_ambient_bool

import v2.lens.fact_density {
  KernelAmbientAtom,
  carrier_spec_fact
}
import v2.std.logic { Bool }
import v2.std.node { Atom, Conj, Node, TypeNode, SyntheticOccurrence }
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}

data kernel_ambient_bool_input: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^fact_density_kernel_ambient_bool } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn kernel_ambient_bool_claim_holds() -> Bool {
  carrier_spec_fact(carrier: kernel_ambient_bool_input) == KernelAmbientAtom
}

fn kernel_ambient_bool_claim_rhs() -> Node {
  if kernel_ambient_bool_claim_holds() {
    kernel_ambient_bool_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_kernel_ambient_bool: TestClaim = EqualsClaim {
  label: "lens_fact_density/kernel_ambient_bool: kernel ambient bool atom",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: kernel_ambient_bool_input,
  rhs: kernel_ambient_bool_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
