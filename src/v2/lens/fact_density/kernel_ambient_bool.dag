module v2.test.lens_fact_density.kernel_ambient_bool


data kernel_ambient_bool_input: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^fact_density_kernel_ambient_bool } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn kernel_ambient_bool_claim_holds() -> Bool {
  carrier_spec_fact(carrier: kernel_ambient_bool_input) == KernelAmbientAtom
}

fn kernel_ambient_bool_claim_rhs() -> Node {
  if kernel_ambient_bool_claim_holds() {
    kernel_ambient_bool_input
  } else {
    v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_kernel_ambient_bool: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "lens_fact_density/kernel_ambient_bool: kernel ambient bool atom",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: kernel_ambient_bool_input,
  rhs: kernel_ambient_bool_claim_rhs(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
