module v2.test.lens_fact_density.conj_positional_only_no_fact


data conj_positional_only_child: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^conj_positional_only_child_symbol } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data conj_positional_only_input: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
  children: [
    v2.std.node.Edge { label: v2.std.node.Positional, target: conj_positional_only_child }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

test fn conj_positional_only_no_fact_claim_holds() -> v2.std.logic.Bool {
  v2.lens.fact_density.carrier_spec_fact(carrier: conj_positional_only_input) == v2.lens.fact_density.NoFact
}
