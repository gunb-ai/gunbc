module v2.test.lens_fact_density.hollow_alias_blocked_in_run_gates



data hollow_alias_run_gates_root: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^hollow_alias_run_gates_subject } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data hollow_alias_run_gates_authority: v2.std.node.Node = v2.test.lens_common.infer_fixture.claim_atom_node(s: ^hollow_alias_run_gates_symbol)

fn hollow_alias_run_gates_tree() -> v2.compiler.inferred_tree.InferredTree {
  v2.test.lens_common.infer_fixture.claim_inferred_tree(
    root: hollow_alias_run_gates_root,
    facts: v2.test.lens_common.infer_fixture.claim_inferred_facts(
      type_symbol: ^hollow_alias_run_gates_type_sym,
      algebra_symbol: ^hollow_alias_run_gates_algebra_sym,
      descent_symbol: ^hollow_alias_run_gates_descent_sym
    )
  )
}

test fn hollow_alias_blocked_in_run_gates_holds() -> Bool {
  match v2.compiler.compile.run_required_lens_gates(
    inferred: hollow_alias_run_gates_tree(),
    lenses: [v2.compiler.compile.fact_density_lens]
  ) {
    v2.std.diagnostic.Rejected { diagnostics: r } => r.head.reason == ^fact_density_hollow_alias_locus
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
  }
}
