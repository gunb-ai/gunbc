module v2.test.lens_fact_density.computation_not_type_carrier


data computation_not_type_carrier_input: Node = Node {
  kind: ComputationNode { behavior: Transform },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn computation_not_type_carrier_claim_holds() -> Bool {
  carrier_spec_fact(carrier: computation_not_type_carrier_input) == NotATypeCarrier
}

fn computation_not_type_carrier_claim_rhs() -> Node {
  if computation_not_type_carrier_claim_holds() {
    computation_not_type_carrier_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_computation_not_type_carrier: TestClaim = EqualsClaim {
  label: "lens_fact_density/computation_not_type_carrier: Transform is NotATypeCarrier",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: computation_not_type_carrier_input,
  rhs: computation_not_type_carrier_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
