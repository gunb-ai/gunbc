module v2.test.lens_fact_density.hollow_alias_compile_lens_rejects

data hollow_alias_cl_root: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^hollow_alias_cl_subject } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data hollow_alias_cl_authority: v2.std.node.Node = v2.test.lens_common.infer_fixture.claim_atom_node(s: ^hollow_alias_cl_symbol)

fn hollow_alias_cl_tree() -> v2.compiler.inferred_tree.InferredTree {
  v2.test.lens_common.infer_fixture.claim_inferred_tree(
    root: hollow_alias_cl_root,
    facts: v2.test.lens_common.infer_fixture.claim_inferred_facts(
      type_symbol: ^hollow_alias_cl_type_sym,
      algebra_symbol: ^hollow_alias_cl_algebra_sym,
      descent_symbol: ^hollow_alias_cl_descent_sym
    )
  )
}

test fn hollow_alias_compile_lens_rejects_holds() -> v2.std.logic.Bool {
  match apply_compile_lens(
    lens: fact_density_lens,
    inferred: hollow_alias_cl_tree(),
    mode: CompileLensEnforce
  ) {
    v2.std.diagnostic.Rejected { diagnostics: r } => r.head.reason == ^fact_density_hollow_alias_locus
    Accepted { value: _, diagnostics: _ } => false
  }
}
