module v2.test.lens_fact_density.hollow_alias_compile_lens_rejects


import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Atom, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.test.lens_common.infer_fixture {
  claim_atom_node,
  claim_inferred_facts,
  claim_inferred_tree
}

data hollow_alias_cl_root: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^hollow_alias_cl_subject } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data hollow_alias_cl_authority: Node = claim_atom_node(s: ^hollow_alias_cl_symbol)

fn hollow_alias_cl_tree() -> v2.compiler.inferred_tree.InferredTree {
  claim_inferred_tree(
    root: hollow_alias_cl_root,
    facts: claim_inferred_facts(
      type_symbol: ^hollow_alias_cl_type_sym,
      algebra_symbol: ^hollow_alias_cl_algebra_sym,
      descent_symbol: ^hollow_alias_cl_descent_sym
    )
  )
}

test fn hollow_alias_compile_lens_rejects_holds() -> Bool {
  match apply_compile_lens(
    lens: fact_density_lens,
    inferred: hollow_alias_cl_tree(),
    mode: CompileLensEnforce
  ) {
    Rejected { diagnostics: r } => r.head.reason == ^fact_density_hollow_alias_locus
    Accepted { value: _, diagnostics: _ } => false
  }
}
