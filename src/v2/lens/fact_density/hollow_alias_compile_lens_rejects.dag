module v2.test.lens_fact_density.hollow_alias_compile_lens_rejects



data hollow_alias_cl_root: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^hollow_alias_cl_subject } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data hollow_alias_cl_authority: Node = claim_atom_node(s: ^hollow_alias_cl_symbol)

fn hollow_alias_cl_tree() -> InferredTree {
  claim_inferred_tree(
    root: hollow_alias_cl_root,
    facts: claim_inferred_facts(
      type_symbol: ^hollow_alias_cl_type_sym,
      algebra_symbol: ^hollow_alias_cl_algebra_sym,
      descent_symbol: ^hollow_alias_cl_descent_sym
    )
  )
}

fn hollow_alias_compile_lens_rejects_holds() -> Bool {
  match apply_compile_lens(
    lens: fact_density_lens,
    inferred: hollow_alias_cl_tree(),
    mode: CompileLensEnforce
  ) {
    Rejected { diagnostics: r } => r.head.reason == ^fact_density_hollow_alias_locus
    Accepted { value: _, diagnostics: _ } => false
  }
}

fn hollow_alias_compile_lens_rejects_rhs() -> Node {
  if hollow_alias_compile_lens_rejects_holds() {
    hollow_alias_cl_authority
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_hollow_alias_compile_lens_rejects: TestClaim = EqualsClaim {
  label: "lens_fact_density/hollow_alias_compile_lens_rejects: NoFact root rejected by fact_density_lens",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: hollow_alias_cl_authority,
  rhs: hollow_alias_compile_lens_rejects_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
