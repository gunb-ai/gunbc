module v2.test.lens_fact_density.hollow_alias_vtc_empty_lenses_rejected



data hollow_alias_el_root: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^hollow_alias_el_subject } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data hollow_alias_el_authority: Node = claim_atom_node(s: ^hollow_alias_el_symbol)

fn hollow_alias_vtc_empty_lenses_rejected_holds() -> Bool {
  match validate_then_compile(
    source: hollow_alias_el_root,
    lenses: [],
    mode: v2.compiler.compile.Eval { runtime: hollow_alias_el_root }
  ) {
    Rejected { diagnostics: r } => r.head.reason == ^fact_density_hollow_alias_locus
    Accepted { value: _, diagnostics: _ } => false
  }
}

fn hollow_alias_vtc_empty_lenses_rejected_rhs() -> Node {
  if hollow_alias_vtc_empty_lenses_rejected_holds() {
    hollow_alias_el_authority
  } else {
    v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_hollow_alias_vtc_empty_lenses_rejected: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "lens_fact_density/hollow_alias_vtc_empty_lenses_rejected: hollow alias rejected by validate_then_compile with empty caller lenses — proves always_required_lenses() fires without caller supply",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: hollow_alias_el_authority,
  rhs: hollow_alias_vtc_empty_lenses_rejected_rhs(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
