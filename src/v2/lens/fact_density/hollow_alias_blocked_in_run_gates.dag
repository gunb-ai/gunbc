module v2.test.lens_fact_density.hollow_alias_blocked_in_run_gates

import v2.compiler.compile {
  fact_density_lens,
  run_required_lens_gates
}
import v2.compiler.infer { InferredTree }

import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Atom, Conj, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v2.test.lens_common.infer_fixture {
  claim_atom_node,
  claim_inferred_facts,
  claim_inferred_tree
}

data hollow_alias_run_gates_root: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^hollow_alias_run_gates_subject } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data hollow_alias_run_gates_authority: Node = claim_atom_node(s: ^hollow_alias_run_gates_symbol)

fn hollow_alias_run_gates_tree() -> InferredTree {
  claim_inferred_tree(
    root: hollow_alias_run_gates_root,
    facts: claim_inferred_facts(
      type_symbol: ^hollow_alias_run_gates_type_sym,
      algebra_symbol: ^hollow_alias_run_gates_algebra_sym,
      descent_symbol: ^hollow_alias_run_gates_descent_sym
    )
  )
}

fn hollow_alias_blocked_in_run_gates_holds() -> Bool {
  match run_required_lens_gates(
    inferred: hollow_alias_run_gates_tree(),
    lenses: [fact_density_lens]
  ) {
    Rejected { diagnostics: r } => r.head.reason == ^fact_density_hollow_alias_locus
    Accepted { value: _, diagnostics: _ } => false
  }
}

fn hollow_alias_blocked_in_run_gates_rhs() -> Node {
  if hollow_alias_blocked_in_run_gates_holds() {
    hollow_alias_run_gates_authority
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_hollow_alias_blocked_in_run_gates: TestClaim = EqualsClaim {
  label: "lens_fact_density/hollow_alias_blocked_in_run_gates: fact_density_lens blocks hollow alias in run_required_lens_gates",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: hollow_alias_run_gates_authority,
  rhs: hollow_alias_blocked_in_run_gates_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}