module v2.test.lens_fact_density.kernel_ambient_bool


data kernel_ambient_bool_input: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^fact_density_kernel_ambient_bool } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

test fn kernel_ambient_bool_claim_holds() -> Bool {
  v2.lens.fact_density.carrier_spec_fact(carrier: kernel_ambient_bool_input) == v2.lens.fact_density.KernelAmbientAtom
}
