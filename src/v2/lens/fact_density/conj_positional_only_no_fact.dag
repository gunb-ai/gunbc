module v2.test.lens_fact_density.conj_positional_only_no_fact


data conj_positional_only_child: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^conj_positional_only_child_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data conj_positional_only_input: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [
    v2.std.node.Edge { label: Positional, target: conj_positional_only_child }
  ],
  occurrence_id: SyntheticOccurrence
}

fn conj_positional_only_no_fact_claim_holds() -> Bool {
  carrier_spec_fact(carrier: conj_positional_only_input) == NoFact
}

fn conj_positional_only_no_fact_claim_rhs() -> Node {
  if conj_positional_only_no_fact_claim_holds() {
    conj_positional_only_input
  } else {
    v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_conj_positional_only_no_fact: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "lens_fact_density/conj_positional_only: positional-only conj is NoFact",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: conj_positional_only_input,
  rhs: conj_positional_only_no_fact_claim_rhs(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
