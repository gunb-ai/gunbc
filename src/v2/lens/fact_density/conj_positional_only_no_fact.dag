module v2.test.lens_fact_density.conj_positional_only_no_fact

import v2.lens.fact_density { NoFact, carrier_spec_fact }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Node,
  Positional,
  Symbol,
  TypeNode,
  SyntheticOccurrence
}
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}

data conj_positional_only_child: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^conj_positional_only_child_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data conj_positional_only_input: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge { label: Positional, target: conj_positional_only_child }
  ],
  occurrence_id: SyntheticOccurrence
}

fn conj_positional_only_no_fact_claim_holds() -> Bool {
  carrier_spec_fact(carrier: conj_positional_only_input) == NoFact
}

fn conj_positional_only_no_fact_claim_rhs() -> Node {
  if conj_positional_only_no_fact_claim_holds() {
    conj_positional_only_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_conj_positional_only_no_fact: TestClaim = EqualsClaim {
  label: "lens_fact_density/conj_positional_only: positional-only conj is NoFact",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: conj_positional_only_input,
  rhs: conj_positional_only_no_fact_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}