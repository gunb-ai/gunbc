module v2.test.lens_fact_density.hollow_alias_vtc_empty_lenses_rejected

data hollow_alias_el_root: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^hollow_alias_el_subject } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data hollow_alias_el_authority: v2.std.node.Node = v2.test.lens_common.infer_fixture.claim_atom_node(s: ^hollow_alias_el_symbol)

test fn hollow_alias_vtc_empty_lenses_rejected_holds() -> Bool {
  match v2.compiler.compile.validate_then_compile(
    source: hollow_alias_el_root,
    lenses: [],
    mode: v2.compiler.compile.Eval { runtime: hollow_alias_el_root }
  ) {
    Rejected { diagnostics: r } =>
      v2.test.lens_application.empty_required_lenses_skip_gate.non_empty_diagnostics_contain_reason(d: r, reason: ^fact_density_hollow_alias_locus)
    Accepted { value: _, diagnostics: _ } => false
  }
}