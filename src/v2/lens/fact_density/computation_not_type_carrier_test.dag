module v2.test.lens_fact_density.computation_not_type_carrier

import v2.lens.fact_density { NotATypeCarrier, carrier_spec_fact }
import v2.std.logic { Bool }
import v2.std.node { ComputationNode, Node, Transform, SyntheticOccurrence }

data computation_not_type_carrier_input: Node = Node {
  kind: ComputationNode { behavior: Transform },
  children: [],
  occurrence_id: SyntheticOccurrence
}

test fn computation_not_type_carrier_claim_holds() -> Bool {
  carrier_spec_fact(carrier: computation_not_type_carrier_input) == NotATypeCarrier
}
