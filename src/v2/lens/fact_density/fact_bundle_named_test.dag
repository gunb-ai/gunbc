module v2.test.lens_fact_density.fact_bundle_named


data fact_bundle_alias: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^fact_bundle_alias_symbol } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data fact_bundle_input: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
  children: [
    v2.std.node.Edge {
      label: v2.std.node.Named { name: ^fact_bundle_width_field },
      target: fact_bundle_alias
    },
    v2.std.node.Edge {
      label: v2.std.node.Named { name: ^fact_bundle_signedness_field },
      target: fact_bundle_alias
    }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

test fn fact_bundle_named_claim_holds() -> Bool {
  match v2.lens.fact_density.carrier_spec_fact(carrier: fact_bundle_input) {
    v2.lens.fact_density.NamedFieldFacts { density: d } =>
      match d.prev {
        v2.std.nat.Succ { prev: q } =>
          match q {
            v2.std.nat.Zero => true
            v2.std.nat.Succ { prev: _ } => false
          }
        v2.std.nat.Zero => false
      }
    v2.lens.fact_density.KernelAmbientAtom => false
    v2.lens.fact_density.NoFact => false
    v2.lens.fact_density.NotATypeCarrier => false
  }
}
