module v2.test.lens_fact_density.fact_bundle_compile_lens_passes


data fact_bundle_cl_child: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^fact_bundle_cl_child_symbol } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data fact_bundle_cl_root: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
  children: [
    v2.std.node.Edge {
      label: v2.std.node.Named { name: ^fact_bundle_cl_field_name },
      target: fact_bundle_cl_child
    }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data fact_bundle_cl_authority: v2.std.node.Node = v2.test.lens_common.infer_fixture.claim_atom_node(s: ^fact_bundle_cl_symbol)

fn fact_bundle_cl_tree() -> v2.compiler.inferred_tree.InferredTree {
  v2.test.lens_common.infer_fixture.claim_inferred_tree(
    root: fact_bundle_cl_root,
    facts: v2.test.lens_common.infer_fixture.claim_inferred_facts(
      type_symbol: ^fact_bundle_cl_type_sym,
      algebra_symbol: ^fact_bundle_cl_algebra_sym,
      descent_symbol: ^fact_bundle_cl_descent_sym
    )
  )
}

test fn fact_bundle_compile_lens_passes_holds() -> Bool {
  match v2.compiler.compile.apply_compile_lens(
    lens: v2.compiler.compile.fact_density_lens,
    inferred: fact_bundle_cl_tree(),
    mode: v2.compiler.compile.CompileLensEnforce
  ) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}
