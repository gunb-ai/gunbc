module v2.test.lens_fact_density.fact_bundle_named


data fact_bundle_alias: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^fact_bundle_alias_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data fact_bundle_input: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [
    v2.std.node.Edge {
      label: Named { name: ^fact_bundle_width_field },
      target: fact_bundle_alias
    },
    v2.std.node.Edge {
      label: Named { name: ^fact_bundle_signedness_field },
      target: fact_bundle_alias
    }
  ],
  occurrence_id: SyntheticOccurrence
}

fn fact_bundle_named_claim_holds() -> Bool {
  carrier_spec_fact(carrier: fact_bundle_input) ==
    v2.lens.fact_density.NamedFieldFacts { density: v2.std.cardinality.NonZeroNat { prev: v2.std.nat.Succ { prev: Zero } } }
}

fn fact_bundle_named_claim_rhs() -> Node {
  if fact_bundle_named_claim_holds() {
    fact_bundle_input
  } else {
    v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_fact_bundle_named: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "lens_fact_density/fact_bundle_named: two named fields yield density 2",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: fact_bundle_input,
  rhs: fact_bundle_named_claim_rhs(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
