module v2.test.lens_fact_density.fact_bundle_named

import v2.lens.fact_density { NamedFieldFacts, carrier_spec_fact }
import v2.std.cardinality { NonZeroNat }
import v2.std.logic { Bool }
import v2.std.nat { Succ, Zero }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Symbol,
  TypeNode,
  SyntheticOccurrence
}
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
data fact_bundle_alias: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^fact_bundle_alias_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data fact_bundle_input: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^fact_bundle_width_field },
      target: fact_bundle_alias
    },
    Edge {
      label: Named { name: ^fact_bundle_signedness_field },
      target: fact_bundle_alias
    }
  ],
  occurrence_id: SyntheticOccurrence
}

fn fact_bundle_named_claim_holds() -> Bool {
  carrier_spec_fact(carrier: fact_bundle_input) ==
    NamedFieldFacts { density: NonZeroNat { prev: Succ { prev: Zero } } }
}

fn fact_bundle_named_claim_rhs() -> Node {
  if fact_bundle_named_claim_holds() {
    fact_bundle_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_fact_bundle_named: TestClaim = EqualsClaim {
  label: "lens_fact_density/fact_bundle_named: two named fields yield density 2",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: fact_bundle_input,
  rhs: fact_bundle_named_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
