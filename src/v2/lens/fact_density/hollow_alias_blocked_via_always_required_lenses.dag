module v2.test.lens_fact_density.hollow_alias_blocked_via_always_required_lenses



data hollow_alias_ar_root: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^hollow_alias_ar_subject } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data hollow_alias_ar_authority: Node = claim_atom_node(s: ^hollow_alias_ar_symbol)

fn hollow_alias_ar_tree() -> InferredTree {
  claim_inferred_tree(
    root: hollow_alias_ar_root,
    facts: claim_inferred_facts(
      type_symbol: ^hollow_alias_ar_type_sym,
      algebra_symbol: ^hollow_alias_ar_algebra_sym,
      descent_symbol: ^hollow_alias_ar_descent_sym
    )
  )
}

fn hollow_alias_blocked_via_always_required_lenses_holds() -> Bool {
  match run_required_lens_gates(
    inferred: hollow_alias_ar_tree(),
    lenses: always_required_lenses()
  ) {
    Rejected { diagnostics: r } => r.head.reason == ^fact_density_hollow_alias_locus
    Accepted { value: _, diagnostics: _ } => false
  }
}

fn hollow_alias_blocked_via_always_required_lenses_rhs() -> Node {
  if hollow_alias_blocked_via_always_required_lenses_holds() {
    hollow_alias_ar_authority
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_hollow_alias_blocked_via_always_required_lenses: TestClaim = EqualsClaim {
  label: "lens_fact_density/hollow_alias_blocked_via_always_required_lenses: always_required_lenses() (wired into validate_then_compile) blocks hollow alias",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: hollow_alias_ar_authority,
  rhs: hollow_alias_blocked_via_always_required_lenses_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
