module v2.lens.interface_summary


fn decl_kind_to_export_kind(kind: v2.std.decl_index.ItemKind) -> std.interface_summary.ExportKind? {
  match kind {
    FnItem => Present { value: std.interface_summary.ExportFn }
    FuncItem => Present { value: std.interface_summary.ExportFn }
    TypeItem => Present { value: std.interface_summary.ExportType }
    DataItem => Present { value: std.interface_summary.ExportData }
    ServiceItem => Present { value: std.interface_summary.ExportService }
    OtherItem => Absent
  }
}

fn signature_fingerprint_of_node(node: Node) -> std.interface_summary.SignatureFingerprint {
  std.content_hash.content_hash_atom(value: content_hash(n: node).digest as String)
}

fn export_entry_from_decl_fact(fact: v2.std.decl_index.DeclFact) -> std.interface_summary.ExportEntry? {
  match decl_kind_to_export_kind(kind: fact.kind) {
    Present { value: kind } =>
      Present {
        value: std.interface_summary.ExportEntry {
          name: fact.name,
          kind: kind,
          contract: std.interface_summary.signature_contract(
            signature: signature_fingerprint_of_node(node: fact.node)
          )
        }
      }
    Absent => Absent
  }
}

fn export_entries_for_rel_path(rel_path: String, facts: List<v2.std.decl_index.DeclFact>) -> List<std.interface_summary.ExportEntry> {
  fold(facts, init: std.algebra.Empty, f: fn(acc, fact) {
    if fact.rel_path == rel_path {
      match export_entry_from_decl_fact(fact: fact) {
        Present { value: entry } => list_snoc_item(xs: acc, item: entry)
        Absent => acc
      }
    } else {
      acc
    }
  })
}

fn interface_summary_for_module_path(
  module_path: std.types.NonEmptyStr,
  rel_path: String,
  facts: List<v2.std.decl_index.DeclFact>
) -> std.interface_summary.InterfaceSummary {
  let exports = export_entries_for_rel_path(rel_path: rel_path, facts: facts)
  std.interface_summary.InterfaceSummary {
    module_path: module_path,
    exports: exports,
    interface_hash: std.interface_summary.interface_summary_rollup(exports: exports)
  }
}

fn interface_summaries_from_facts(
  modules: List<v2.lens.module_graph.ModuleDeclarationFact>,
  facts: List<v2.std.decl_index.DeclFact>
) -> List<std.interface_summary.InterfaceSummary> {
  fold(modules, init: std.algebra.Empty, f: fn(acc, mod_fact) {
    list_snoc_item(
      xs: acc,
      item: interface_summary_for_module_path(
        module_path: mod_fact.module,
        rel_path: mod_fact.path,
        facts: facts
      )
    )
  })
}

fn interface_summaries_live(pool_roots: List<String>) -> List<std.interface_summary.InterfaceSummary> {
  interface_summaries_from_facts(
    modules: module_declaration_facts_live(pool_roots: pool_roots),
    facts: export_signature_facts(pool_roots: pool_roots)
  )
}

fn interface_hash_for_module_path(
  summaries: List<std.interface_summary.InterfaceSummary>,
  module_path: String
) -> std.interface_summary.InterfaceHash? {
  fold(summaries, init: optional_absent(), f: fn(found, summary) {
    match found {
      Present { value: _ } => found
      Absent =>
        match summary.module_path == module_path {
          true => Present { value: summary.interface_hash }
          false => found
        }
    }
  })
}

fn direct_import_modules(
  rel_path: String,
  edges: List<v2.lens.module_graph.ImportResolutionFact>
) -> List<String> {
  fold(edges, init: std.algebra.Empty, f: fn(acc, edge) {
    if edge.path == rel_path {
      list_snoc_item(xs: acc, item: edge.import_module)
    } else {
      acc
    }
  })
}

fn import_interface_hashes_for_module(
  rel_path: String,
  edges: List<v2.lens.module_graph.ImportResolutionFact>,
  summaries: List<std.interface_summary.InterfaceSummary>
) -> List<std.interface_summary.InterfaceHash>? {
  fold(
    direct_import_modules(rel_path: rel_path, edges: edges),
    init: Present { value: std.algebra.Empty },
    f: fn(acc, import_module) {
      match acc {
        Absent => Absent
        Present { value: hashes } =>
          match interface_hash_for_module_path(summaries: summaries, module_path: import_module) {
            Present { value: hash } =>
              Present { value: list_snoc_item(xs: hashes, item: hash) }
            Absent => Absent
          }
      }
    }
  )
}

fn module_key_for_rel_path(
  rel_path: String,
  module_path: std.types.NonEmptyStr,
  source_hash: std.content_hash.ContentHash,
  pool_roots: List<String>
) -> std.interface_summary.ModuleKey? {
  let summaries = interface_summaries_live(pool_roots: pool_roots)
  let edges = import_resolution_facts_live(
    pool_roots: pool_roots,
    importer_roots: pool_roots,
    exclude_substrings: []
  )
  match import_interface_hashes_for_module(
    rel_path: rel_path,
    edges: edges,
    summaries: summaries
  ) {
    Present { value: import_hashes } =>
      Present {
        value: std.interface_summary.module_key(
          source_hash: source_hash,
          direct_import_interface_hashes: import_hashes
        )
      }
    Absent => Absent
  }
}

fn interface_summary_for_module(
  module_path: std.types.NonEmptyStr,
  pool_roots: List<String>
) -> std.interface_summary.InterfaceSummary? {
  fold(interface_summaries_live(pool_roots: pool_roots), init: optional_absent(), f: fn(found, summary) {
    match found {
      Present { value: _ } => found
      Absent =>
        match summary.module_path == module_path {
          true => Present { value: summary }
          false => found
        }
    }
  })
}

data construction_justification: v2.lens.common.construction_justification.ConstructionJustification = v2.lens.common.construction_justification.ConstructionJustification {
  class: v2.lens.common.construction_justification.WallAfterGrounding { dissolves_to: SingleAuthority }
}
