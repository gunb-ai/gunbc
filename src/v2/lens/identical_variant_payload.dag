module v2.lens.identical_variant_payload
import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }

import std.lens_verdict {
  LensVerdict,
  LensVerdictDiagnostic,
  ModuleWholeFile,
  Unrealized,
}
import v2.std.node { Node }

type CarrierCloneTrigger
  = WholeCarrierClone
  | VariantParameterClone
  | IdenticalVariantPayload

data identical_variant_payload_module: String = "v2.lens.identical_variant_payload"

fn identical_variant_payload_unrealized_verdict() -> LensVerdict {
  Unrealized {
    diagnostic: LensVerdictDiagnostic {
      reason: "identical_variant_payload_producer_unavailable",
      at: ModuleWholeFile { module_name: identical_variant_payload_module }
    }
  }
}

type IdenticalVariantPayloadFact {
  type_locus: Node
  verdict: LensVerdict
}

fn identical_variant_payload_fact_for_type(type_node: Node) -> IdenticalVariantPayloadFact {
  IdenticalVariantPayloadFact {
    type_locus: type_node,
    verdict: identical_variant_payload_unrealized_verdict()
  }
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding {
    grounding_authority: "v2.lens.structural_similarity per-variant field-shape facts plus the equivalence-class payload-signature injectivity check",
    dissolve_on: "coproduct arms with tag-not-recoverable identical payloads are caught by the structural-similarity producer stage"
  },
  rationale: "Identical payload signatures within a decl is a decidable shape comparison; the lens is a scaffold gated on structural_similarity's producer-stage facts."
}
