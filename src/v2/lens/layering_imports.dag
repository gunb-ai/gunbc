module v2.lens.layering_imports


type LayerImportFact {
  layer: LayerPrefix
  path: String
  import_module: String
}

type LayeringImportViolation {
  layer: LayerPrefix
  path: String
  import_module: String
}

data forbidden_compiler_prefix: String = "v2.compiler."
data forbidden_compiler_exact: String = "v2.compiler"

fn char_eq(a: Char, b: Char) -> Bool {
  a == b
}

fn is_forbidden_compiler_import(module: String) -> Bool {
  module == forbidden_compiler_exact
    || is_prefix_of(prefix: forbidden_compiler_prefix, xs: module, eq: char_eq)
}

data forbidden_std_extdeps_prefix: String = "extdeps."
data forbidden_std_extdeps_exact: String = "extdeps"

fn is_std_importing_extdeps(module: String) -> Bool {
  module == forbidden_std_extdeps_exact
    || is_prefix_of(prefix: forbidden_std_extdeps_prefix, xs: module, eq: char_eq)
}

fn is_std_layer(layer: LayerPrefix) -> Bool {
  match layer {
    LayerPrefixStd => true
    LayerPrefixExtdeps => false
    LayerPrefixCompiler => false
    LayerPrefixWorkflow => false
  }
}

fn is_layering_violation(fact: LayerImportFact) -> Bool {
  is_forbidden_compiler_import(module: fact.import_module)
    || (is_std_layer(layer: fact.layer)
        && is_std_importing_extdeps(module: fact.import_module))
}

data empty_layering_import_violations: List<LayeringImportViolation> = []

fn scan_facts_for_violations(facts: List<LayerImportFact>) -> List<LayeringImportViolation> {
  fold_list(
    xs: facts,
    empty: empty_layering_import_violations,
    cons: fn(acc, fact) {
      if is_layering_violation(fact: fact) {
        list_snoc_item(
          xs: acc,
          item: LayeringImportViolation {
            layer: fact.layer,
            path: fact.path,
            import_module: fact.import_module
          }
        )
      } else {
        acc
      }
    }
  )
}

fn layering_imports_clean_holds(facts: List<LayerImportFact>) -> Bool {
  is_empty(xs: scan_facts_for_violations(facts: facts))
}

fn layering_imports_violation_count(facts: List<LayerImportFact>) -> Int {
  length(xs: scan_facts_for_violations(facts: facts))
}

fn layer_import_facts_live(
  std_roots: List<String>,
  extdeps_roots: List<String>
) -> List<LayerImportFact> {
  layer_import_facts(std_roots: std_roots, extdeps_roots: extdeps_roots)
}

data layer_import_facts_live_producer_note: String = "Transitional host producer (layering-imports-reference-repoint-design.md §3.1): import-syntax rows for import-bearing files in the scan roots, plus reference_edges_as_import_facts(strict=true) for import-less files; import-syntax wins on (path, target_module) collision. Terminal step (namespace import-grammar deletion, Phase 3) deletes the import-syntax arm — only then does layer_import_facts_live become single-authority."

data layer_prefix_classifier_scaffold_note: String = "🟡 dissolve-on: host layer_import_facts stamps LayerImportFact.layer via CLI_RUN_LAYER_PREFIX_FROM_DOTTED_MODULE_SCAFFOLD_MARKER — a Rust mirror of v2.std.cross_tree.resolution.layer_prefix_from_dotted_qualified_name. Deletes when the builtin routes layer through that .dag authority (or a shared host projection beside reference_resolution_facts)."

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SingleAuthority }
}
