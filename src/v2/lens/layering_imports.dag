// src/v2/lens/layering_imports.dag
// Scope: cross-layer import-direction lens (layer DAG dependency-direction, DESIGN.md §3 —
//        "imports point toward std"). Two forbidden directions:
//          (1) std/ and extdeps/ must not import v2.compiler.* (toward the compiler);
//          (2) std/ must not import extdeps AT ALL (std is the ROOT of the layer DAG —
//              `std ← extdeps ← compiler ← workflow`; a std→extdeps edge is the import arrow
//              inverted). Rule (2) is what let `dsl/std/credentials.dag import extdeps.shell`
//              pass undetected before this lens was tightened.
//        Rule (2) is scoped to the dsl-tree `extdeps`/`extdeps.*` module form today. The
//        `v2.extdeps.*` form is DEFERRED (🟡 dissolve-on: the pre-existing src/v2/std →
//        v2.extdeps.* importers — timeseries_signal{,_passives}, qualified_name.from_module_node,
//        grounding.terminal_gate_test — are migrated; widen `is_std_importing_extdeps` to also
//        match the `v2.extdeps`/`v2.extdeps.*` form then).
// Consumer: tools.layering_imports_gate → tools.layering_imports_transport host scan.

module v2.lens.layering_imports

import v2.std.algebra {
  fold_list,
  is_empty,
  is_prefix_of,
  length,
  list_snoc_item
}
import v2.std.collection { List }
import v2.std.layer { LayerPrefix }
import v2.std.logic { Bool }
import v2.std.text { Char, String }

// One import line fact from host enumeration (path relative to repo root).
// layer: LayerPrefix — §3 single authority; LayerLabel dissolved into LayerPrefix.
type LayerImportFact {
  layer: LayerPrefix
  path: String
  import_module: String
}

type LayeringImportViolation {
  layer: LayerPrefix
  path: String
  import_module: String
}

data forbidden_compiler_prefix: String = "v2.compiler."
data forbidden_compiler_exact: String = "v2.compiler"

fn char_eq(a: Char, b: Char) -> Bool {
  a == b
}

fn is_forbidden_compiler_import(module: String) -> Bool {
  module == forbidden_compiler_exact
    || is_prefix_of(prefix: forbidden_compiler_prefix, xs: module, eq: char_eq)
}

// std/ is the ROOT of the layer DAG — it must never import extdeps (the import arrow points
// TOWARD std, DESIGN.md §3). dsl-tree form only (`extdeps`/`extdeps.*`); the `v2.extdeps.*`
// form is deferred per the header dissolution trigger. is_prefix_of("extdeps.", "v2.extdeps.x")
// is false (the v2 form starts "v2."), so this cleanly excludes the deferred src/v2/std cases.
data forbidden_std_extdeps_prefix: String = "extdeps."
data forbidden_std_extdeps_exact: String = "extdeps"

fn is_std_importing_extdeps(module: String) -> Bool {
  module == forbidden_std_extdeps_exact
    || is_prefix_of(prefix: forbidden_std_extdeps_prefix, xs: module, eq: char_eq)
}

fn is_std_layer(layer: LayerLabel) -> Bool {
  match layer {
    LayerStd => true
    LayerExtdeps => false
  }
}

fn is_layering_violation(fact: LayerImportFact) -> Bool {
  is_forbidden_compiler_import(module: fact.import_module)
    || (is_std_layer(layer: fact.layer)
        && is_std_importing_extdeps(module: fact.import_module))
}

data empty_layering_import_violations: List<LayeringImportViolation> = []

fn scan_facts_for_violations(facts: List<LayerImportFact>) -> List<LayeringImportViolation> {
  fold_list(
    xs: facts,
    empty: empty_layering_import_violations,
    cons: fn(acc, fact) {
      if is_layering_violation(fact: fact) {
        list_snoc_item(
          xs: acc,
          item: LayeringImportViolation {
            layer: fact.layer,
            path: fact.path,
            import_module: fact.import_module
          }
        )
      } else {
        acc
      }
    }
  )
}

fn layering_imports_clean_holds(facts: List<LayerImportFact>) -> Bool {
  is_empty(xs: scan_facts_for_violations(facts: facts))
}

fn layering_imports_violation_count(facts: List<LayerImportFact>) -> Int {
  length(xs: scan_facts_for_violations(facts: facts))
}

// Parse-bridge: structural projection of import facts over the live `.dag` tree. REUSES
// the resolver's own `extract_import_paths` + `collect_dag_files_tolerant` (single
// authority) — the replacement for the deleted `scripts/layering-imports-scan.sh`
// enumerator. Layer<->root tagging is workflow POLICY: the caller passes the std-layer
// roots and the extdeps-layer roots separately (DESIGN §3 (c)), not baked here.
// dissolve-on: emit(intent, Bash) / v2 self-host folds this projection over its own
//   parsed module Node-set (the v1 handler is layering_imports_project.rs).
fn layer_import_facts_live(
  std_roots: List<String>,
  extdeps_roots: List<String>
) -> List<LayerImportFact> {
  layer_import_facts(std_roots: std_roots, extdeps_roots: extdeps_roots)
}
