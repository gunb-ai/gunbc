module v2.lens.enforcement.contract


type LensContract {
  entry: v2.lens.registry.LensRegistryEntryV0
  mode: v2.lens.enforcement.vocab.EnforcementMode
  claimed_scope: v2.lens.enforcement.vocab.ScopeRoster
  consumer_witness: v2.lens.enforcement.vocab.ConsumerWitnessBinding
  exemptions: List<String>
  boundary: v2.lens.common.construction_justification.ConstructionJustification
}

type EnrollmentDiscoveryReceipt {
  contract_id: v2.lens.registry.LensIdV0
  discovered_subject_names: v2.lens.enforcement.vocab.SubjectRoster
  scope_satisfaction: v2.lens.enforcement.vocab.ScopeSatisfaction
  consumer_enrolled: v2.lens.enforcement.vocab.ConsumerKind
  consumer_entry_identity: v2.lens.enforcement.vocab.ReceiptRef
  red_control_status: v2.lens.enforcement.vocab.RedControlStatus
  self_application_status: v2.lens.enforcement.vocab.SelfApplicationStatus
}

data lens_contract_cost: LensContract = {
  entry: lens_registry_v0_cost,
  mode: v2.lens.enforcement.vocab.Blocking,
  claimed_scope: v2.lens.enforcement.vocab.ScopeRoster { roots: ["dag", "src/v1", "src/v2"] },
  consumer_witness: v2.lens.enforcement.vocab.BoundConsumerWitness {
    witness: std.realization_schedule.ScheduleWitnessEntry {
      entry: "src/v2/test/claim/complexity_gate/budget_roster_completeness_test.dag",
      function: "complexity_budget_roster_family_gate_holds",
      kind: CorpusWitnessKind
    }
  },
  exemptions: [],
  boundary: v2.lens.common.construction_justification.ConstructionJustification {
    class: v2.lens.common.construction_justification.WallNow {
      mechanism: SubstrateMandatoryTag,
      authority: std.decl_ref.DeclarationRef { module_path: "v2.std.node", decl_name: "NodeKind", field: WholeDeclaration }
    }
  }
}

