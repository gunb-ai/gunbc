data lens_contracts_pending_fn_body_reflection_note: String = "W3.3 registry-enrollment frontier (mandate step 4): every AuditOnly contract above with consumer_witness: NoConsumerWitness is enrolled-but-unreceipted by construction, not by omission - CoverageReceipt derivation (v2.lens.enforcement.receipts) is gated on fn_body_reflection_blocker (decl_facts marshals only the fn output skeleton today, not bodies), so a live receipt cannot be honestly derived for a lens whose subject discovery or red-control probe needs body-level facts. This is the SAME typed gate receipts.dag already uses for ScopeNarrowed\{reason: TypeReflectionUnavailable\{blocker: fn_body_reflection_blocker\}\} - not a new absorption, the existing one generalized to the newly-enrolled roster. gate.dag's find_receipt already answers ReceiptAbsent -> typed LegFails for every contract_id in this list (never a fabricated CoverageReceipt), so the frontier is counted and located, never silent. Dissolve-on: fn-body reflection lands in decl_facts, at which point each id below either derives a real CoverageReceipt (moves out of this list) or is re-justified with a narrower NarrowingReason - this list must shrink to [] or every remaining member must carry a fresher reason, it must never silently grow past what receipts.dag can honestly derive."

data lens_contracts_pending_fn_body_reflection: List<LensIdV0> = [
  ComplexityAccumulatorCopy,
  ComplexityLinearityAudit,
  ComplexityLowering,
  Coverage,
  DependencyFidelity,
  Discrimination,
  DispositionRedundancy,
  DocReachability,
  DuplicateComputation,
  ExtdepsExternalAuthority,
  ExtdepsShapeTransportPolicy,
  FactCardinality,
  FactDensity,
  FnFamily,
  Grounding,
  HostLanguageTransportScript,
  IdenticalVariantPayload,
  InertCarrier,
  InertLens,
  IntentLinearity,
  InterfaceSummary,
  LanguagesConsumerCensus,
  LayeringImports,
  LeafModelVerification,
  LiveReadClassification,
  MachineShape,
  MetaExecConfinement,
  MockTotality,
  MutationAdequacy,
  NonFoldResidue,
  RealizationVocabularyContainment,
  ScheduleLens,
  SimulatedRelationship,
  StructuralSimilarity,
  Subsumption,
  Synthesis,
  TestMigrationDebt,
  UnitModeling,
  Vacuity,
  Visibility,
  WiringLiveness,
  WitnessCostLocality
]

fn lens_contracts_pending_fn_body_reflection_count() -> Int {
  length(xs: lens_contracts_pending_fn_body_reflection)
}
