module v2.lens.enforcement.contract

import v2.std.collection { List }
import v2.std.text { String }
import v2.lens.registry { LensRegistryEntryV0, LensIdV0, Cost, Complexity, lens_registry_v0_cost, lens_registry_v0_complexity }
import v2.lens.enforcement.vocab {
  SubjectRoster, ScopeRoster,
  EnforcementMode, Blocking, AuditOnly, Advisory,
  ConsumerKind, FloorGate, WitnessOnly, NoConsumer,
  ConsumerWitnessBinding, BoundConsumerWitness, NoConsumerWitness,
  ScopeSatisfaction, ScopeCovers, ScopeNarrowed, ScopeMissing,
  NarrowingReason, TypeReflectionUnavailable,
  RedControlStatus, RedControlPassed, RedControlMissing, RedControlFailedToFlip,
  SelfApplicationStatus, SelfAppliesObserved, SelfExemptObserved, SelfApplicationAbsent,
  ReceiptRef, HasReceiptRef, NoReceiptRef
}
import v2.lens.common.construction_justification { ConstructionJustification, WallNow, RatchetForever }
import std.disposition { SubstrateMandatoryTag }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.realization_schedule { ScheduleWitnessEntry, CorpusWitnessKind }

type LensContract {
  entry: LensRegistryEntryV0
  mode: EnforcementMode
  claimed_scope: ScopeRoster
  consumer_witness: ConsumerWitnessBinding
  exemptions: List<String>
  boundary: ConstructionJustification
}

type CoverageReceipt {
  contract_id: LensIdV0
  discovered_subjects: SubjectRoster
  scope_satisfaction: ScopeSatisfaction
  consumer_observed: ConsumerKind
  consumer_receipt_ref: ReceiptRef
  red_control_status: RedControlStatus
  self_application_status: SelfApplicationStatus
}

data lens_contract_cost: LensContract = {
  entry: lens_registry_v0_cost,
  mode: Blocking,
  claimed_scope: ScopeRoster { roots: ["dag", "src/v1", "src/v2"] },
  consumer_witness: BoundConsumerWitness {
    witness: ScheduleWitnessEntry {
      entry: "src/v2/test/claim/complexity_gate/budget_roster_completeness_test.dag",
      function: "complexity_budget_roster_family_gate_holds",
      kind: CorpusWitnessKind
    }
  },
  exemptions: [],
  boundary: ConstructionJustification {
    class: WallNow {
      mechanism: SubstrateMandatoryTag,
      authority: DeclarationRef { module_path: "v2.std.node", decl_name: "NodeKind", field: WholeDeclaration }
    }
  }
}

data lens_contract_complexity: LensContract = {
  entry: lens_registry_v0_complexity,
  mode: AuditOnly,
  claimed_scope: ScopeRoster { roots: ["dag", "src/v1", "src/v2"] },
  consumer_witness: NoConsumerWitness,
  exemptions: [],
  boundary: ConstructionJustification { class: RatchetForever }
}

data lens_contract_registry: List<LensContract> = [
  lens_contract_cost,
  lens_contract_complexity
]
