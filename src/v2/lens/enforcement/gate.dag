module v2.lens.enforcement.gate

import v2.std.logic { Bool }
import v2.std.collection { List }
import v2.std.text { String }
import v2.std.algebra { for_all, any, filter, contains, non_empty, list_head, HeadFound, HeadAbsent }
import v2.lens.registry { LensRegistryEntryV0, LensIdV0, lens_id_v0_eq }
import v2.lens.enforcement.vocab {
  SubjectRoster,
  EnforcementMode, Advisory, AuditOnly, Blocking, enforcement_mode_satisfies,
  ConsumerKind, ConsumerRequirement, WitnessOnly, consumer_is_live, consumer_satisfies,
  ScopeSatisfaction, ScopeCovers, ScopeNarrowed, ScopeMissing,
  subject_roster_covers,
  NarrowingReason, narrowing_reason_same_variant,
  RedControlStatus, red_control_passed,
  SelfApplicationStatus, self_application_ok
}
import v2.lens.enforcement.contract {
  LensContract, CoverageReceipt
}
import v2.lens.enforcement.lens_module_gate {
  LensInvariantSurface,
  lens_module_gate_blocking_holds,
  lens_module_gate_unenrolled_count_from_facts,
  lens_module_gate_unjustified_count_from_facts,
  lens_module_gate_redundant_blocking_count_from_surfaces,
  lens_module_gate_audit_residue_count_from_surfaces,
  lens_module_gate_surfaces
}
import v2.lens.enforcement.standing_intent {
  StandingIntent, IntentProperty, LensFamily, LensHygieneLiveness,
  LensHygieneSelfApply, LensClosureQuestionZero, ModelAnemia, SingleAuthorityConsolidation
}
import v2.lens.module_graph { ModuleDeclarationFact }

type LegVerdict = LegHolds | LegFails { reason: String }

type QuestionZeroVerdict {
  intent_id: String
  unenrolled: LegVerdict
  unjustified: LegVerdict
  redundant_claim: LegVerdict
  audit_residue_counted: LegVerdict
}

fn question_zero_verdict_holds(v: QuestionZeroVerdict) -> Bool {
  leg_holds(l: v.unenrolled)
    && leg_holds(l: v.unjustified)
    && leg_holds(l: v.redundant_claim)
    && leg_holds(l: v.audit_residue_counted)
}

fn lens_closure_question_zero_verdict(
  intent: StandingIntent,
  facts: List<ModuleDeclarationFact>,
  bound_module_paths: List<String>,
  surfaces: List<LensInvariantSurface>
) -> QuestionZeroVerdict {
  QuestionZeroVerdict {
    intent_id: intent.id,
    unenrolled: leg_of(
      ok: lens_module_gate_unenrolled_count_from_facts(facts: facts, bound_module_paths: bound_module_paths) == 0,
      reason: "candidate lens module is not enrolled and not on the consolidated roster"
    ),
    unjustified: leg_of(
      ok: lens_module_gate_unjustified_count_from_facts(facts: facts, surfaces: surfaces) == 0,
      reason: "candidate lens module lacks a lens invariant surface admission row"
    ),
    redundant_claim: leg_of(
      ok: lens_module_gate_redundant_blocking_count_from_surfaces(surfaces: surfaces) == 0,
      reason: "lens module claims a genuinely-new invariant but shares verdict-authority and remedy with an enrolled peer"
    ),
    audit_residue_counted: leg_of(
      ok: lens_module_gate_audit_residue_count_from_surfaces(surfaces: surfaces) > 0
        || lens_module_gate_redundant_blocking_count_from_surfaces(surfaces: surfaces) == 0,
      reason: "undecidable meaning-residue must be counted on the audit roster, never silently absorbed"
    )
  }
}

fn lens_closure_question_zero_holds() -> Bool {
  lens_module_gate_blocking_holds()
}

type IntentVerdict {
  intent_id: String
  claimed: LegVerdict
  scope_covered: LegVerdict
  subjects_covered: LegVerdict
  live_consumer: LegVerdict
  red_control: LegVerdict
  self_application: LegVerdict
}

type ReceiptLookup = ReceiptFound { value: CoverageReceipt } | ReceiptAbsent

type ContractLookup = ContractFound { value: LensContract } | ContractAbsent

fn leg_holds(l: LegVerdict) -> Bool {
  match l {
    LegHolds => true
    LegFails { reason } => false
  }
}

fn leg_fails(l: LegVerdict) -> Bool {
  !leg_holds(l: l)
}

fn leg_of(ok: Bool, reason: String) -> LegVerdict {
  if ok { LegHolds } else { LegFails { reason: reason } }
}

fn contract_answers(c: LensContract, p: IntentProperty) -> Bool {
  match p {
    LensFamily { lens } => lens_id_v0_eq(left: c.entry.lens_id, right: lens)
    LensHygieneLiveness => false
    LensHygieneSelfApply => false
    LensClosureQuestionZero => false
    ModelAnemia => false
    SingleAuthorityConsolidation => false
  }
}

fn receipt_matches(r: CoverageReceipt, cid: LensIdV0) -> Bool {
  lens_id_v0_eq(left: r.contract_id, right: cid)
}

fn find_receipt(cid: LensIdV0, receipts: List<CoverageReceipt>) -> ReceiptLookup {
  match list_head(xs: filter(xs: receipts, predicate: fn(r) { receipt_matches(r: r, cid: cid) })) {
    HeadFound { value: r } => ReceiptFound { value: r }
    HeadAbsent => ReceiptAbsent
  }
}

fn narrowing_allowed(reason: NarrowingReason, allowed: List<NarrowingReason>) -> Bool {
  any(xs: allowed, predicate: fn(a) { narrowing_reason_same_variant(a: a, b: reason) })
}

fn scope_leg(intent: StandingIntent, s: ScopeSatisfaction) -> LegVerdict {
  match s {
    ScopeCovers => LegHolds
    ScopeMissing => LegFails { reason: "scope missing: undeclared reach gap" }
    ScopeNarrowed { missing, reason } =>
      if narrowing_allowed(reason: reason, allowed: intent.allowed_narrowing) {
        LegHolds
      } else {
        match intent.default_mode {
          Blocking => LegFails { reason: "blocking intent narrowed by a reason not on the allow-list" }
          AuditOnly => LegHolds
          Advisory => LegHolds
        }
      }
  }
}

fn self_ok(required: Bool, s: SelfApplicationStatus) -> Bool {
  if required { self_application_ok(s: s) } else { true }
}

fn discovered_covers_required(required_subjects: SubjectRoster, discovered: SubjectRoster) -> Bool {
  subject_roster_covers(claimed: discovered, desired: required_subjects)
}

fn find_answering_contract(intent: StandingIntent, contracts: List<LensContract>) -> ContractLookup {
  match list_head(xs: filter(xs: contracts, predicate: fn(c) { contract_answers(c: c, p: intent.property) })) {
    HeadFound { value: c } => ContractFound { value: c }
    HeadAbsent => ContractAbsent
  }
}

fn claimed_mode_leg(c: LensContract, intent: StandingIntent) -> LegVerdict {
  leg_of(
    ok: enforcement_mode_satisfies(actual: c.mode, required: intent.default_mode),
    reason: "answering contract's mode does not satisfy the intent's required mode"
  )
}

fn intent_family_verdict(intent: StandingIntent, contracts: List<LensContract>, receipts: List<CoverageReceipt>) -> IntentVerdict {
  match find_answering_contract(intent: intent, contracts: contracts) {
    ContractAbsent => IntentVerdict {
      intent_id: intent.id,
      claimed: LegFails { reason: "no contract claims this property" },
      scope_covered: LegFails { reason: "unproven: no answering contract" },
      subjects_covered: LegFails { reason: "unproven: no answering contract" },
      live_consumer: LegFails { reason: "unproven: no answering contract" },
      red_control: LegFails { reason: "unproven: no answering contract" },
      self_application: LegFails { reason: "unproven: no answering contract" }
    }
    ContractFound { value: c } => match find_receipt(cid: c.entry.lens_id, receipts: receipts) {
      ReceiptAbsent => IntentVerdict {
        intent_id: intent.id,
        claimed: claimed_mode_leg(c: c, intent: intent),
        scope_covered: LegFails { reason: "no coverage receipt for this contract" },
        subjects_covered: LegFails { reason: "no coverage receipt for this contract" },
        live_consumer: LegFails { reason: "no coverage receipt for this contract" },
        red_control: LegFails { reason: "no coverage receipt for this contract" },
        self_application: LegFails { reason: "no coverage receipt for this contract" }
      }
      ReceiptFound { value: r } => IntentVerdict {
        intent_id: intent.id,
        claimed: claimed_mode_leg(c: c, intent: intent),
        scope_covered: scope_leg(intent: intent, s: r.scope_satisfaction),
        subjects_covered: leg_of(ok: discovered_covers_required(required_subjects: intent.required_subjects, discovered: r.discovered_subjects), reason: "discovered subjects do not cover required_subjects (the decl_facts / v1-reach gap, e.g. build_type_env)"),
        live_consumer: leg_of(ok: consumer_satisfies(actual: r.consumer_observed, required: intent.required_consumer), reason: "observed consumer does not satisfy the required consumer"),
        red_control: leg_of(ok: red_control_passed(s: r.red_control_status), reason: "red control did not pass by execution"),
        self_application: leg_of(ok: self_ok(required: intent.self_application_required, s: r.self_application_status), reason: "lens does not self-apply and carries no exemption")
      }
    }
  }
}

fn intent_verdict_holds(v: IntentVerdict) -> Bool {
  leg_holds(l: v.claimed)
    && leg_holds(l: v.scope_covered)
    && leg_holds(l: v.subjects_covered)
    && leg_holds(l: v.live_consumer)
    && leg_holds(l: v.red_control)
    && leg_holds(l: v.self_application)
}

fn intent_family_holds(intent: StandingIntent, contracts: List<LensContract>, receipts: List<CoverageReceipt>) -> Bool {
  intent_verdict_holds(v: intent_family_verdict(intent: intent, contracts: contracts, receipts: receipts))
}

fn contract_internally_consistent(c: LensContract, receipts: List<CoverageReceipt>) -> Bool {
  match c.mode {
    Blocking => match find_receipt(cid: c.entry.lens_id, receipts: receipts) {
      ReceiptFound { value: r } => consumer_is_live(k: r.consumer_observed)
      ReceiptAbsent => false
    }
    AuditOnly => true
    Advisory => true
  }
}

fn enforcement_consistency_holds(contracts: List<LensContract>, receipts: List<CoverageReceipt>) -> Bool {
  for_all(xs: contracts, predicate: fn(c) { contract_internally_consistent(c: c, receipts: receipts) })
}

fn receipt_self_ok(r: CoverageReceipt) -> Bool {
  self_application_ok(s: r.self_application_status)
}

fn lenses_self_apply_or_exempt_holds(receipts: List<CoverageReceipt>) -> Bool {
  for_all(xs: receipts, predicate: fn(r) { receipt_self_ok(r: r) })
}

fn non_empty_string(s: String) -> Bool {
  !(s == "")
}

fn intent_admissible(i: StandingIntent) -> Bool {
  i.recurring
    && i.receiptable
    && non_empty_string(s: i.displaced_cost)
    && non_empty_string(s: i.mechanism_class)
    && non_empty(xs: i.desired_scope.roots)
}

fn all_intents_admissible(intents: List<StandingIntent>) -> Bool {
  for_all(xs: intents, predicate: fn(i) { intent_admissible(i: i) })
}