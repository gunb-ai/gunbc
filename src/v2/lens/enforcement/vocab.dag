module v2.lens.enforcement.vocab


type SubjectRoster {
  entries: List<QualifiedName>
}

type ScopeRoster {
  roots: List<String>
}

type EnforcementMode = Advisory | AuditOnly | Blocking

type ConsumerKind
  = FloorGate | MergeAdmission | PrePushHook | PeriodicActuator
  | RoadmapDriftGate | DeployReadback | WitnessOnly | NoConsumer

type ConsumerRequirement
  = AnyLiveConsumer
  | OneOf { acceptable: List<ConsumerKind> }
  | Exact { kind: ConsumerKind }

type ConsumerWitnessBinding
  = BoundConsumerWitness { witness: ScheduleWitnessEntry }
  | NoConsumerWitness

type NarrowingReason
  = BootstrapBlocked { blocker: String }
  | TypeReflectionUnavailable { blocker: String }
  | ExternalRuntimeOnly { reason: String }
  | ExplicitOperatorExemption { signoff: String }

type ScopeSatisfaction
  = ScopeCovers
  | ScopeNarrowed { missing: ScopeRoster, reason: NarrowingReason }
  | ScopeMissing

type RedControlStatus
  = RedControlPassed | RedControlMissing | RedControlNotRun | RedControlFailedToFlip

type SelfApplicationStatus
  = SelfAppliesObserved | SelfExemptObserved { reason: String } | SelfApplicationAbsent

type ReceiptRef = HasReceiptRef { ref: String } | NoReceiptRef

fn mode_rank(m: EnforcementMode) -> Int {
  match m {
    Advisory => 1
    AuditOnly => 2
    Blocking => 3
  }
}

fn enforcement_mode_satisfies(actual: EnforcementMode, required: EnforcementMode) -> Bool {
  mode_rank(m: actual) >= mode_rank(m: required)
}

fn consumer_rank(k: ConsumerKind) -> Int {
  match k {
    FloorGate => 1
    MergeAdmission => 2
    PrePushHook => 3
    PeriodicActuator => 4
    RoadmapDriftGate => 5
    DeployReadback => 6
    WitnessOnly => 7
    NoConsumer => 8
  }
}

fn consumer_kind_eq(a: ConsumerKind, b: ConsumerKind) -> Bool {
  consumer_rank(k: a) == consumer_rank(k: b)
}

fn consumer_is_live(k: ConsumerKind) -> Bool {
  match k {
    FloorGate => true
    MergeAdmission => true
    PrePushHook => true
    PeriodicActuator => true
    RoadmapDriftGate => true
    DeployReadback => true
    WitnessOnly => false
    NoConsumer => false
  }
}

fn consumer_satisfies(actual: ConsumerKind, required: ConsumerRequirement) -> Bool {
  match required {
    AnyLiveConsumer => consumer_is_live(k: actual)
    Exact { kind } => consumer_kind_eq(a: actual, b: kind)
    OneOf { acceptable } => contains(xs: acceptable, item: actual, eq: consumer_kind_eq)
  }
}

fn red_control_passed(s: RedControlStatus) -> Bool {
  match s {
    RedControlPassed => true
    RedControlMissing => false
    RedControlNotRun => false
    RedControlFailedToFlip => false
  }
}

fn self_application_ok(s: SelfApplicationStatus) -> Bool {
  match s {
    SelfAppliesObserved => true
    SelfExemptObserved { reason } => true
    SelfApplicationAbsent => false
  }
}

data narrowing_reason_same_variant_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "v2.lens.enforcement.vocab",
    decl_name: "narrowing_reason_same_variant",
    field: WholeDeclaration
  }
}

fn narrowing_reason_same_variant(a: NarrowingReason, b: NarrowingReason) -> Bool {
  match a {
    BootstrapBlocked { blocker: a1 } => match b {
      BootstrapBlocked { blocker: b1 } => true
      TypeReflectionUnavailable { blocker: b2 } => false
      ExternalRuntimeOnly { reason: b3 } => false
      ExplicitOperatorExemption { signoff: b4 } => false
    }
    TypeReflectionUnavailable { blocker: a2 } => match b {
      BootstrapBlocked { blocker: b1 } => false
      TypeReflectionUnavailable { blocker: b2 } => true
      ExternalRuntimeOnly { reason: b3 } => false
      ExplicitOperatorExemption { signoff: b4 } => false
    }
    ExternalRuntimeOnly { reason: a3 } => match b {
      BootstrapBlocked { blocker: b1 } => false
      TypeReflectionUnavailable { blocker: b2 } => false
      ExternalRuntimeOnly { reason: b3 } => true
      ExplicitOperatorExemption { signoff: b4 } => false
    }
    ExplicitOperatorExemption { signoff: a4 } => match b {
      BootstrapBlocked { blocker: b1 } => false
      TypeReflectionUnavailable { blocker: b2 } => false
      ExternalRuntimeOnly { reason: b3 } => false
      ExplicitOperatorExemption { signoff: b4 } => true
    }
  }
}

fn string_eq(a: String, b: String) -> Bool {
  a == b
}

fn qualified_name_eq(a: QualifiedName, b: QualifiedName) -> Bool {
  a == b
}

fn subject_roster_covers(claimed: SubjectRoster, desired: SubjectRoster) -> Bool {
  for_all(xs: desired.entries, predicate: fn(r) { contains(xs: claimed.entries, item: r, eq: qualified_name_eq) })
}

fn scope_roster_covers(claimed: ScopeRoster, desired: ScopeRoster) -> Bool {
  for_all(xs: desired.roots, predicate: fn(r) { contains(xs: claimed.roots, item: r, eq: string_eq) })
}
