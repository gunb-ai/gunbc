fn lens_module_gate_surface_from_bound_entry(id: LensIdV0, path: String) -> LensInvariantSurface {
  lens_module_gate_surface_for_lens_id(id: id, module: path)
}

data lens_module_gate_consolidated_surfaces: List<LensInvariantSurface> = [
  LensInvariantSurface {
    module: "v2.lens.wiring_liveness_preflight",
    projection: ProjectionImportGraph,
    verdict_authority: VerdictLensVerdict,
    remedy: RemedyDelete,
    admission: HandlerOnKernel { host_module: "v2.lens.wiring_liveness" }
  },
  LensInvariantSurface {
    module: "v2.lens.identity_captured_navigation",
    projection: ProjectionNodeDag,
    verdict_authority: VerdictFidelityVerdict,
    remedy: RemedyReport,
    admission: HandlerOnKernel { host_module: "v2.lens.dependency_fidelity" }
  },
  LensInvariantSurface {
    module: "v2.lens.grounding_ledger",
    projection: ProjectionDocGraph,
    verdict_authority: VerdictGroundingVerdict,
    remedy: RemedyReport,
    admission: HandlerOnKernel { host_module: "v2.lens.grounding" }
  }
]

data lens_module_gate_audit_residue_rows: List<LensModuleGateResidueRow> = [
  LensModuleGateResidueRow {
    left_module: "v2.lens.structural_similarity",
    right_module: "v2.lens.simulated_relationship"
  },
  LensModuleGateResidueRow {
    left_module: "v2.lens.effect",
    right_module: "v2.lens.effect_reach"
  }
]

fn lens_module_gate_surfaces() -> List<LensInvariantSurface> {
  let enrolled = fold_list(
    xs: lens_registry_v0,
    empty: lens_module_gate_consolidated_surfaces,
    cons: fn(acc, entry) {
      match entry.module_path {
        Bound { path } => list_snoc_item(xs: acc, item: lens_module_gate_surface_from_bound_entry(id: entry.lens_id, path: path))
        Unbound => acc
      }
    }
  )
  enrolled
}

fn lens_module_gate_surface_for_module(
  module: String,
  surfaces: List<LensInvariantSurface>
) -> Bool {
  any(xs: surfaces, predicate: fn(s) { s.module == module })
}

fn lens_module_gate_unenrolled_count_from_facts(
  facts: List<ModuleDeclarationFact>,
  bound_module_paths: List<String>
) -> Int {
  lens_registry_completeness_unenrolled_count_from_facts(
    facts: facts,
    bound_module_paths: bound_module_paths
  )
}

fn lens_module_gate_unjustified_count_from_facts(
  facts: List<ModuleDeclarationFact>,
  surfaces: List<LensInvariantSurface>
) -> Int {
  count_where(xs: facts, predicate: fn(fact) {
    lens_registry_completeness_is_candidate(module_name: fact.module)
      && !lens_module_gate_surface_for_module(module: fact.module, surfaces: surfaces)
  })
}

fn lens_module_gate_residue_pair_covers(left: String, right: String, row: LensModuleGateResidueRow) -> Bool {
  (row.left_module == left && row.right_module == right)
    || (row.left_module == right && row.right_module == left)
}

fn lens_module_gate_is_audit_residue_pair(left: String, right: String) -> Bool {
  any(
    xs: lens_module_gate_audit_residue_rows,
    predicate: fn(row) { lens_module_gate_residue_pair_covers(left: left, right: right, row: row) }
  )
}

type RedundantBlockingAcc {
  redundant: Int
  seen: List<LensInvariantSurface>
}

fn lens_module_gate_redundant_blocking_step(
  acc: RedundantBlockingAcc,
  surface: LensInvariantSurface
) -> RedundantBlockingAcc {
  if lens_module_gate_is_genuinely_new(surface: surface) {
    let pair = lens_module_gate_verdict_remedy_pair(surface: surface)
    let prior = filter(
      xs: acc.seen,
      predicate: fn(other) {
        lens_module_gate_is_genuinely_new(surface: other)
          && lens_module_gate_verdict_remedy_pair_eq(
            a: lens_module_gate_verdict_remedy_pair(surface: other),
            b: pair
          )
      }
    )
    match list_head(xs: prior) {
      HeadFound { value: earlier } =>
        if lens_module_gate_is_audit_residue_pair(left: earlier.module, right: surface.module) {
          RedundantBlockingAcc {
            redundant: acc.redundant,
            seen: list_snoc_item(xs: acc.seen, item: surface)
          }
        } else {
          RedundantBlockingAcc {
            redundant: acc.redundant + 1,
            seen: list_snoc_item(xs: acc.seen, item: surface)
          }
        }
      HeadAbsent =>
        RedundantBlockingAcc {
          redundant: acc.redundant,
          seen: list_snoc_item(xs: acc.seen, item: surface)
        }
    }
  } else {
    RedundantBlockingAcc {
      redundant: acc.redundant,
      seen: list_snoc_item(xs: acc.seen, item: surface)
    }
  }
}

fn lens_module_gate_redundant_blocking_count_from_surfaces(surfaces: List<LensInvariantSurface>) -> Int {
  fold_list(
    xs: surfaces,
    empty: RedundantBlockingAcc { redundant: 0, seen: [] },
    cons: lens_module_gate_redundant_blocking_step
  ).redundant
}

fn lens_module_gate_audit_residue_count_from_surfaces(surfaces: List<LensInvariantSurface>) -> Int {
  count_where(
    xs: lens_module_gate_audit_residue_rows,
    predicate: fn(row) {
      lens_module_gate_surface_for_module(module: row.left_module, surfaces: surfaces)
        && lens_module_gate_surface_for_module(module: row.right_module, surfaces: surfaces)
    }
  )
}

fn lens_module_gate_unenrolled_count() -> Int {
  lens_module_gate_unenrolled_count_from_facts(
    facts: lens_registry_completeness_live_facts(),
    bound_module_paths: lens_registry_completeness_bound_module_paths()
  )
}

fn lens_module_gate_unjustified_count() -> Int {
  lens_module_gate_unjustified_count_from_facts(
    facts: lens_registry_completeness_live_facts(),
    surfaces: lens_module_gate_surfaces()
  )
}

fn lens_module_gate_redundant_blocking_count() -> Int {
  lens_module_gate_redundant_blocking_count_from_surfaces(surfaces: lens_module_gate_surfaces())
}

fn lens_module_gate_audit_residue_count() -> Int {
  lens_module_gate_audit_residue_count_from_surfaces(surfaces: lens_module_gate_surfaces())
}

fn lens_module_gate_blocking_holds() -> Bool {
  lens_module_gate_unenrolled_count() == 0
    && lens_module_gate_unjustified_count() == 0
    && lens_module_gate_redundant_blocking_count() == 0
}

fn lens_module_gate_holds() -> Bool {
  lens_module_gate_blocking_holds()
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: RealizationDispatch }
}
