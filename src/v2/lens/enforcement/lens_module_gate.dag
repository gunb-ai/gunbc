data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

type LensVerdictAuthority
  = VerdictLensVerdict
  | VerdictLadderVerdict
  | VerdictVacuityEvidence
  | VerdictFidelityVerdict
  | VerdictGroundingVerdict
  | VerdictDeterminismFact
  | VerdictEffectFact
  | VerdictIdempotencyFact
  | VerdictOwnershipFact
  | VerdictParallelismFact
  | VerdictAsymptoticCost

type LensInvariantRemedy
  = RemedyShare
  | RemedyDelete
  | RemedyReport
  | RemedyIndependentOracle
  | RemedyConstructionWall
  | RemedySuggestedFix

type LensInvariantProjection
  = ProjectionNodeDag
  | ProjectionImportGraph
  | ProjectionTermChain
  | ProjectionTypeForest
  | ProjectionDeclForest
  | ProjectionDocGraph
  | ProjectionTestClaim
  | ProjectionShellProgram
  | ProjectionModuleGraph

type LensModuleAdmission
  = GenuinelyNewInvariant
  | HandlerOnKernel { host_module: String }

type LensInvariantSurface {
  module: String
  projection: LensInvariantProjection
  verdict_authority: LensVerdictAuthority
  remedy: LensInvariantRemedy
  admission: LensModuleAdmission
}

type VerdictRemedyPair {
  verdict_authority: LensVerdictAuthority
  remedy: LensInvariantRemedy
}

type LensModuleGateResidueRow {
  left_module: String
  right_module: String
}

fn lens_module_gate_string_eq(a: String, b: String) -> Bool {
  a == b
}

fn lens_module_gate_string_member(xs: List<String>, x: String) -> Bool {
  contains(xs: xs, item: x, eq: lens_module_gate_string_eq)
}

fn lens_module_gate_verdict_authority_eq(a: LensVerdictAuthority, b: LensVerdictAuthority) -> Bool {
  match a {
    VerdictLensVerdict => match b { VerdictLensVerdict => true _ => false }
    VerdictLadderVerdict => match b { VerdictLadderVerdict => true _ => false }
    VerdictVacuityEvidence => match b { VerdictVacuityEvidence => true _ => false }
    VerdictFidelityVerdict => match b { VerdictFidelityVerdict => true _ => false }
    VerdictGroundingVerdict => match b { VerdictGroundingVerdict => true _ => false }
    VerdictDeterminismFact => match b { VerdictDeterminismFact => true _ => false }
    VerdictEffectFact => match b { VerdictEffectFact => true _ => false }
    VerdictIdempotencyFact => match b { VerdictIdempotencyFact => true _ => false }
    VerdictOwnershipFact => match b { VerdictOwnershipFact => true _ => false }
    VerdictParallelismFact => match b { VerdictParallelismFact => true _ => false }
    VerdictAsymptoticCost => match b { VerdictAsymptoticCost => true _ => false }
  }
}

fn lens_module_gate_remedy_eq(a: LensInvariantRemedy, b: LensInvariantRemedy) -> Bool {
  match a {
    RemedyShare => match b { RemedyShare => true _ => false }
    RemedyDelete => match b { RemedyDelete => true _ => false }
    RemedyReport => match b { RemedyReport => true _ => false }
    RemedyIndependentOracle => match b { RemedyIndependentOracle => true _ => false }
    RemedyConstructionWall => match b { RemedyConstructionWall => true _ => false }
    RemedySuggestedFix => match b { RemedySuggestedFix => true _ => false }
  }
}

fn lens_module_gate_verdict_remedy_pair_eq(a: VerdictRemedyPair, b: VerdictRemedyPair) -> Bool {
  lens_module_gate_verdict_authority_eq(a: a.verdict_authority, b: b.verdict_authority)
    && lens_module_gate_remedy_eq(a: a.remedy, b: b.remedy)
}

fn lens_module_gate_verdict_remedy_pair(surface: LensInvariantSurface) -> VerdictRemedyPair {
  VerdictRemedyPair {
    verdict_authority: surface.verdict_authority,
    remedy: surface.remedy
  }
}

fn lens_module_gate_is_genuinely_new(surface: LensInvariantSurface) -> Bool {
  match surface.admission {
    GenuinelyNewInvariant => true
    HandlerOnKernel { host_module: _ } => false
  }
}

data lens_module_gate_surface_table_dissolution_note: String = "Central lens_module_gate_surface_for_lens_id match is a WallAfterGrounding scaffold: a parallel ledger of projection, verdict-authority, remedy, and admission per LensIdV0 beside lens_registry_v0. DISSOLVES WHEN each enrolled lens module declares its own invariant surface on-carrier (ConstructionJustification surface fields on the module or a LensRegistryEntryV0 extension) and lens_module_gate_surfaces reads those declarations instead of this central table — mark-on-carrier is authority. Until then the total match with no wildcard default forces a surface row on every new LensIdV0."

