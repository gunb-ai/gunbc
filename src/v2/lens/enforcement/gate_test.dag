  id: "synthetic.parallelism.with-subject",
  property: LensFamily { lens: Parallelism },
  displaced_cost: "synthetic fixture cost",
  mechanism_class: "synthetic mechanism",
  recurring: true,
  receiptable: true,
  desired_scope: ScopeRoster { roots: ["dag", "src/v1", "src/v2"] },
  required_subjects: SubjectRoster { entries: [qualified_name_from_dotted_string(dotted: "synthetic.fixture.subject_alpha")] },
  default_mode: Blocking,
