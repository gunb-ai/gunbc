module v2.lens.enforcement.receipts


type SubjectJudgment
  = BodyJudged { verdict: Witness<v2.lens.cost.SymbolicCost> }
  | BodyUnavailable

fn node_contains_computation(n: v2.std.node.Node) -> Bool {
  match n.kind {
    ComputationNode { behavior: _ } => true
    TypeNode { connective: _ } =>
      fold(n.children, init: false, f: fn(acc, edge) {
        acc || node_contains_computation(n: edge.target)
      })
  }
}

fn judge_subject_node(n: v2.std.node.Node) -> SubjectJudgment {
  if node_contains_computation(n: n) {
    BodyJudged { verdict: cost_lens(n: n) }
  } else {
    BodyUnavailable
  }
}

fn subject_is_body_unavailable(fact: v2.std.decl_index.DeclFact) -> Bool {
  match judge_subject_node(n: fact.node) {
    BodyJudged { verdict: _ } => false
    BodyUnavailable => true
  }
}

fn fn_item_count_of(facts: List<v2.std.decl_index.DeclFact>) -> Int {
  fold(facts, init: 0, f: fn(acc, fact) {
    if decl_facts_is_fn_like(kind: fact.kind) { acc + 1 } else { acc }
  })
}

fn body_unavailable_count_of(facts: List<v2.std.decl_index.DeclFact>) -> Int {
  fold(facts, init: 0, f: fn(acc, fact) {
    if decl_facts_is_fn_like(kind: fact.kind) && subject_is_body_unavailable(fact: fact) {
      acc + 1
    } else {
      acc
    }
  })
}

fn body_judged_count_of(facts: List<v2.std.decl_index.DeclFact>) -> Int {
  fn_item_count_of(facts: facts) - body_unavailable_count_of(facts: facts)
}

fn subject_qn_of(fact: v2.std.decl_index.DeclFact) -> v2.std.qualified_name.QualifiedName {
  qualified_name_from_dotted_string(dotted: fact.qualified_name)
}

fn discovered_subject_names(facts: List<v2.std.decl_index.DeclFact>) -> v2.lens.enforcement.vocab.SubjectRoster {
  let discovered_entries = fold(facts, init: std.algebra.Empty, f: fn(acc, fact) {
    if decl_facts_is_fn_like(kind: fact.kind) {
      std.algebra.Cons { head: subject_qn_of(fact: fact), tail: acc }
    } else {
      acc
    }
  })
  v2.lens.enforcement.vocab.SubjectRoster { entries: discovered_entries }
}

fn string_starts_with(s: String, prefix: String) -> Bool {
  s.starts_with(prefix: prefix)
}

fn fact_is_unavailable_under_root(fact: v2.std.decl_index.DeclFact, root: String) -> Bool {
  decl_facts_is_fn_like(kind: fact.kind)
    && string_starts_with(s: fact.rel_path, prefix: concat(root, "/"))
    && subject_is_body_unavailable(fact: fact)
}

fn root_has_body_unavailable_subject(root: String, facts: List<v2.std.decl_index.DeclFact>) -> Bool {
  fold(facts, init: false, f: fn(acc, fact) {
    acc || fact_is_unavailable_under_root(fact: fact, root: root)
  })
}

fn roots_with_body_unavailable(scope: v2.lens.enforcement.vocab.ScopeRoster, facts: List<v2.std.decl_index.DeclFact>) -> v2.lens.enforcement.vocab.ScopeRoster {
  v2.lens.enforcement.vocab.ScopeRoster {
    roots: fold(scope.roots, init: std.algebra.Empty, f: fn(acc, root) {
      if root_has_body_unavailable_subject(root: root, facts: facts) {
        std.algebra.Cons { head: root, tail: acc }
      } else {
        acc
      }
    })
  }
}

data fn_body_reflection_blocker: String = "fn-body reflection: decl_facts marshals the fn output skeleton only (marshal_decl_fact_node, coproduct_reflection.rs:1020) - the gunbc#5364 residue named at cli_run.rs:9039; bodies arrive via the v2 front-end ingest lane (grammar-coverage receipt), not a new host builtin"

fn scope_satisfaction_for(
  claimed_scope: v2.lens.enforcement.vocab.ScopeRoster,
  desired_scope: v2.lens.enforcement.vocab.ScopeRoster,
  facts: List<v2.std.decl_index.DeclFact>
) -> v2.lens.enforcement.vocab.ScopeSatisfaction {
  if !scope_roster_covers(claimed: claimed_scope, desired: desired_scope) {
    ScopeMissing
  } else if body_unavailable_count_of(facts: facts) > 0 {
    v2.lens.enforcement.vocab.ScopeNarrowed {
      missing: roots_with_body_unavailable(scope: desired_scope, facts: facts),
      reason: v2.lens.enforcement.vocab.TypeReflectionUnavailable { blocker: fn_body_reflection_blocker }
    }
  } else {
    ScopeCovers
  }
}

fn consumer_enrolled_for(
  binding: v2.lens.enforcement.vocab.ConsumerWitnessBinding,
  ci_entries: List<std.realization_schedule.ScheduleWitnessEntry>,
  prepush_entries: List<std.realization_schedule.ScheduleWitnessEntry>
) -> v2.lens.enforcement.vocab.ConsumerKind {
  match binding {
    NoConsumerWitness => NoConsumer
    BoundConsumerWitness { witness } =>
      if contains(xs: ci_entries, item: witness, eq: schedule_witness_entry_eq) {
        EnrolledInFloorRoster
      } else if contains(xs: prepush_entries, item: witness, eq: schedule_witness_entry_eq) {
        PrePushHook
      } else {
        WitnessOnly
      }
  }
}

fn lens_contract_is_unbound(c: v2.lens.enforcement.contract.LensContract) -> Bool {
  consumer_kind_eq(
    a: consumer_enrolled_for(binding: c.consumer_witness, ci_entries: [], prepush_entries: []),
    b: v2.lens.enforcement.vocab.NoConsumer
  )
}

fn consumer_entry_identity_for(binding: v2.lens.enforcement.vocab.ConsumerWitnessBinding, enrolled: v2.lens.enforcement.vocab.ConsumerKind) -> v2.lens.enforcement.vocab.ReceiptRef {
  match binding {
    NoConsumerWitness => NoReceiptRef
    BoundConsumerWitness { witness } =>
      match enrolled {
        EnrolledInFloorRoster => v2.lens.enforcement.vocab.HasReceiptRef { ref: concat(witness.entry, "::", witness.function) }
        PrePushHook => v2.lens.enforcement.vocab.HasReceiptRef { ref: concat(witness.entry, "::", witness.function) }
        _ => NoReceiptRef
      }
  }
}

data enforcement_red_probe_body_leaf: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^enforcement_red_probe_body } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data enforcement_red_probe_measure_leaf: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^enforcement_red_probe_measure } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data enforcement_red_probe_extra_leaf: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^enforcement_red_probe_extra } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data cost_red_control_probe: Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: Loop },
  children: [
    v2.std.node.Edge { label: Positional, target: enforcement_red_probe_body_leaf },
    v2.std.node.Edge { label: Named { name: ^loop_bound_edge }, target: enforcement_red_probe_measure_leaf },
    v2.std.node.Edge { label: Named { name: ^enforcement_red_probe_extra }, target: enforcement_red_probe_extra_leaf }
  ],
  occurrence_id: SyntheticOccurrence
}

data cost_well_formed_probe: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^enforcement_well_formed_probe } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn red_control_status_for(probe: v2.std.node.Node) -> v2.lens.enforcement.vocab.RedControlStatus {
  match cost_lens(n: probe) {
    Violates { diagnostic: _ } => RedControlPassed
    Holds { value: _ } => RedControlFailedToFlip
  }
}

fn red_control_status_for_contract(contract: v2.lens.enforcement.contract.LensContract) -> v2.lens.enforcement.vocab.RedControlStatus {
  if lens_id_v0_eq(left: contract.entry.lens_id, right: Cost) {
    red_control_status_for(probe: cost_red_control_probe)
  } else {
    RedControlAbsent
  }
}

fn fact_is_self_subject(fact: v2.std.decl_index.DeclFact, module_prefix: String) -> Bool {
  decl_facts_is_fn_like(kind: fact.kind)
    && string_starts_with(s: fact.qualified_name, prefix: module_prefix)
}

fn self_application_for(facts: List<v2.std.decl_index.DeclFact>, module_prefix: String) -> v2.lens.enforcement.vocab.SelfApplicationStatus {
  if any(xs: facts, predicate: fn(fact) { fact_is_self_subject(fact: fact, module_prefix: module_prefix) }) {
    LensModuleFunctionObserved
  } else {
    SelfApplicationAbsent
  }
}

fn derive_receipt(
  contract: v2.lens.enforcement.contract.LensContract,
  desired_scope: v2.lens.enforcement.vocab.ScopeRoster,
  self_module_prefix: String,
  facts: List<v2.std.decl_index.DeclFact>,
  ci_entries: List<std.realization_schedule.ScheduleWitnessEntry>,
  prepush_entries: List<std.realization_schedule.ScheduleWitnessEntry>
) -> v2.lens.enforcement.contract.EnrollmentDiscoveryReceipt {
  let discovered = discovered_subject_names(facts: facts)
  let enrolled = consumer_enrolled_for(
    binding: contract.consumer_witness,
    ci_entries: ci_entries,
    prepush_entries: prepush_entries
  )
  v2.lens.enforcement.contract.EnrollmentDiscoveryReceipt {
    contract_id: contract.entry.lens_id,
    discovered_subject_names: discovered,
    scope_satisfaction: scope_satisfaction_for(
      claimed_scope: contract.claimed_scope,
      desired_scope: desired_scope,
      facts: facts
    ),
    consumer_enrolled: enrolled,
    consumer_entry_identity: consumer_entry_identity_for(binding: contract.consumer_witness, enrolled: enrolled),
    red_control_status: red_control_status_for_contract(contract: contract),
    self_application_status: self_application_for(facts: facts, module_prefix: self_module_prefix)
  }
}
