module v2.lens.enforcement.receipts

import gunbc.non_fold_residue { nfr_dissolve_owning_fold, nfr_reason_land_red_era }
import std.types { List }
import std.occurrence_identity { OccurrenceSynthetic }
import std.algebra { Cons, Empty, contains, non_empty }
import v2.std.integer { Int }
import v2.std.text { String }
import v2.std.node { Atom, ComputationNode, Edge, Loop, Authored, Node, Positional, TypeNode, LoopBoundEdge, core_edge_label, NotADeclaration }
import v2.std.witness { Holds, Violates, Witness }
import v2.std.decl_index { DeclFact, decl_facts_is_fn_like }
import v2.std.qualified_name { QualifiedName, qualified_name_from_dotted_string }
import v2.lens.cost { SymbolicCost, cost_lens }
import v2.lens.enforcement.vocab {
  SubjectRoster, ScopeRoster, scope_roster_covers,
  ConsumerKind, EnrolledInFloorRoster, PrePushHook, WitnessOnly, NoConsumer,
  EnrollmentWitnessUnresolved,
  ConsumerWitnessBinding, BoundConsumerWitness, NoConsumerWitness,
  ScopeSatisfaction, ScopeCovers, ScopeNarrowed, ScopeMissing,
  NarrowingReason, TypeReflectionUnavailable,
  RedControlStatus, RedControlPassed, RedControlAbsent, RedControlFailedToFlip,
  SelfApplicationStatus, LensModuleFunctionObserved, SelfApplicationAbsent,
  ReceiptRef, HasReceiptRef, NoReceiptRef,
  consumer_kind_eq
}
import v2.lens.enforcement.contract { LensContract, EnrollmentDiscoveryReceipt, Cost }
import std.realization_schedule { ScheduleWitnessEntry, schedule_witness_entry_eq }
import std.roster_frontier { FrontierRow, PathSubject }
import std.dissolution { DissolutionCondition, unbound_dissolution }

type SubjectJudgment
  = BodyJudged { verdict: Witness<SymbolicCost> }
  | BodyUnavailable

fn node_contains_computation(n: Node) -> Bool {
  match n.kind {
    ComputationNode { behavior: _ } => true
    TypeNode { connective: _ } =>
      fold(n.children, init: false, f: fn(acc, edge) {
        acc || node_contains_computation(n: edge.target)
      })
  }
}

fn judge_subject_node(n: Node) -> SubjectJudgment {
  if node_contains_computation(n: n) {
    BodyJudged { verdict: cost_lens(n: n) }
  } else {
    BodyUnavailable
  }
}

fn subject_is_body_unavailable(fact: DeclFact) -> Bool {
  match judge_subject_node(n: fact.node) {
    BodyJudged { verdict: _ } => false
    BodyUnavailable => true
  }
}

fn fn_item_count_of(facts: List<DeclFact>) -> Int {
  fold(facts, init: 0, f: fn(acc, fact) {
    if decl_facts_is_fn_like(kind: fact.kind) { acc + 1 } else { acc }
  })
}

fn body_unavailable_count_of(facts: List<DeclFact>) -> Int {
  fold(facts, init: 0, f: fn(acc, fact) {
    if decl_facts_is_fn_like(kind: fact.kind) && subject_is_body_unavailable(fact: fact) {
      acc + 1
    } else {
      acc
    }
  })
}

fn body_judged_count_of(facts: List<DeclFact>) -> Int {
  fn_item_count_of(facts: facts) - body_unavailable_count_of(facts: facts)
}

fn subject_qn_of(fact: DeclFact) -> QualifiedName {
  qualified_name_from_dotted_string(dotted: fact.qualified_name)
}

fn discovered_subject_names(facts: List<DeclFact>) -> SubjectRoster {
  let discovered_entries = fold(facts, init: Empty, f: fn(acc, fact) {
    if decl_facts_is_fn_like(kind: fact.kind) {
      Cons { head: subject_qn_of(fact: fact), tail: acc }
    } else {
      acc
    }
  })
  SubjectRoster { entries: discovered_entries }
}

fn string_starts_with(s: String, prefix: String) -> Bool {
  s.starts_with(prefix: prefix)
}

fn fact_is_unavailable_under_root(fact: DeclFact, root: String) -> Bool {
  decl_facts_is_fn_like(kind: fact.kind)
    && string_starts_with(s: fact.rel_path, prefix: concat(root, "/"))
    && subject_is_body_unavailable(fact: fact)
}

fn root_has_body_unavailable_subject(root: String, facts: List<DeclFact>) -> Bool {
  fold(facts, init: false, f: fn(acc, fact) {
    acc || fact_is_unavailable_under_root(fact: fact, root: root)
  })
}

fn roots_with_body_unavailable(scope: ScopeRoster, facts: List<DeclFact>) -> ScopeRoster {
  ScopeRoster {
    roots: scope.roots |> filter(r => root_has_body_unavailable_subject(root: r, facts: facts))
  }
}

data fn_body_reflection_blocker: String = "fn-body reflection: decl_facts marshals the fn output skeleton only (marshal_decl_fact_node, coproduct_reflection.rs:1020) - the gunbc#5364 residue named at cli_run.rs:9039; bodies arrive via the v2 front-end ingest lane (grammar-coverage receipt), not a new host builtin"

fn scope_satisfaction_for(
  claimed_scope: ScopeRoster,
  desired_scope: ScopeRoster,
  facts: List<DeclFact>
) -> ScopeSatisfaction {
  if !scope_roster_covers(claimed: claimed_scope, desired: desired_scope) {
    ScopeMissing
  } else if body_unavailable_count_of(facts: facts) > 0 {
    ScopeNarrowed {
      missing: roots_with_body_unavailable(scope: desired_scope, facts: facts),
      reason: TypeReflectionUnavailable { blocker: fn_body_reflection_blocker }
    }
  } else {
    ScopeCovers
  }
}

// THE RESOLUTION, NOT THE STRING MATCH. A roster row is an ENROLLMENT only if the (entry, function)
// it names resolves to a declaration in the closure census: some DeclFact whose rel_path is the
// entry path and whose name is the function, declared as a function item (a `fn` or a `test fn`;
// the census carries both as FnItem -- declaration_index.rs:1074 folds TestMarked into FnItem, which
// is what lets claim_batch resolve a `test fn` by name at all). A row whose witness resolves to no
// such declaration is refused EnrollmentWitnessUnresolved rather than counted EnrolledInFloorRoster:
// the defect this closes (proved at ee97d81d) counted any string-equal row as live, so a witness
// that does not exist turned the enforcement-consistency gate green.
//
// THE EMPTY FUNCTION IS NOT A MATCH. A row with check_fns: [] projects ScheduleWitnessEntry {
// function: "" }, and no declaration is named "" -- the census has no such row -- so an empty
// enrollment resolves to nothing and is refused here. That is the honest reading of case (a): the
// executed probes (claim_batch --function "" -> exit 2 "does not declare requested function(s)";
// gunbc run --function "" -> exit 1) show the empty name runs NOTHING on every route. It is NOT
// modeled here as a whole-file enrollment, and it is not silently excused either; the stated
// divergence and its trigger are on the change, per dag_absence_is_one_meaning.
fn witness_decl_resolves(witness: ScheduleWitnessEntry, facts: List<DeclFact>) -> Bool {
  non_empty(xs: filter(xs: facts, predicate: fn(fact) {
    decl_facts_is_fn_like(kind: fact.kind)
      && fact.rel_path == witness.entry
      && fact.name == witness.function
  }))
}

fn consumer_enrolled_for(
  binding: ConsumerWitnessBinding,
  ci_entries: List<ScheduleWitnessEntry>,
  prepush_entries: List<ScheduleWitnessEntry>,
  facts: List<DeclFact>
) -> ConsumerKind {
  match binding {
    NoConsumerWitness => NoConsumer
    BoundConsumerWitness { witness } =>
      if contains(xs: ci_entries, item: witness, eq: schedule_witness_entry_eq) {
        // The string match says the row is in the roster; only the census says whether the
        // witness it promises exists. Both must hold for an enrollment.
        if witness_decl_resolves(witness: witness, facts: facts) {
          EnrolledInFloorRoster
        } else {
          EnrollmentWitnessUnresolved
        }
      } else if contains(xs: prepush_entries, item: witness, eq: schedule_witness_entry_eq) {
        if witness_decl_resolves(witness: witness, facts: facts) {
          PrePushHook
        } else {
          EnrollmentWitnessUnresolved
        }
      } else {
        WitnessOnly
      }
  }
}

fn lens_contract_is_unbound(c: LensContract) -> Bool {
  consumer_kind_eq(
    a: consumer_enrolled_for(binding: c.consumer_witness, ci_entries: [], prepush_entries: [], facts: []),
    b: NoConsumer
  )
}

fn consumer_entry_identity_for(binding: ConsumerWitnessBinding, enrolled: ConsumerKind) -> ReceiptRef {
  match binding {
    NoConsumerWitness => NoReceiptRef
    BoundConsumerWitness { witness } =>
      match enrolled {
        EnrolledInFloorRoster => HasReceiptRef { ref: concat(witness.entry, "::", witness.function) }
        PrePushHook => HasReceiptRef { ref: concat(witness.entry, "::", witness.function) }
        _ => NoReceiptRef
      }
  }
}

data enforcement_red_probe_body_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^enforcement_red_probe_body } },
  children: [],
  occurrence_id: OccurrenceSynthetic
}

data enforcement_red_probe_measure_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^enforcement_red_probe_measure } },
  children: [],
  occurrence_id: OccurrenceSynthetic
}

data enforcement_red_probe_extra_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^enforcement_red_probe_extra } },
  children: [],
  occurrence_id: OccurrenceSynthetic
}

data cost_red_control_probe: Node = Node {
  kind: ComputationNode { behavior: Loop },
  children: [
    Edge { label: Positional, target: enforcement_red_probe_body_leaf, declaration: NotADeclaration },
    Edge { label: core_edge_label(marker: LoopBoundEdge), target: enforcement_red_probe_measure_leaf, declaration: NotADeclaration },
    Edge { label: Authored { name: ^enforcement_red_probe_extra }, target: enforcement_red_probe_extra_leaf, declaration: NotADeclaration }
  ],
  occurrence_id: OccurrenceSynthetic
}

data cost_well_formed_probe: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^enforcement_well_formed_probe } },
  children: [],
  occurrence_id: OccurrenceSynthetic
}

fn red_control_status_for(probe: Node) -> RedControlStatus {
  match cost_lens(n: probe) {
    Violates { diagnostic: _ } => RedControlPassed
    Holds { value: _ } => RedControlFailedToFlip
  }
}

fn red_control_status_for_contract(contract: LensContract) -> RedControlStatus {
  if (contract.entry.lens_id == Cost) {
    red_control_status_for(probe: cost_red_control_probe)
  } else {
    RedControlAbsent
  }
}

fn fact_is_self_subject(fact: DeclFact, module_prefix: String) -> Bool {
  decl_facts_is_fn_like(kind: fact.kind)
    && string_starts_with(s: fact.qualified_name, prefix: module_prefix)
}

fn self_application_for(facts: List<DeclFact>, module_prefix: String) -> SelfApplicationStatus {
  if any(xs: facts, predicate: fn(fact) { fact_is_self_subject(fact: fact, module_prefix: module_prefix) }) {
    LensModuleFunctionObserved
  } else {
    SelfApplicationAbsent
  }
}

fn derive_receipt(
  contract: LensContract,
  desired_scope: ScopeRoster,
  self_module_prefix: String,
  facts: List<DeclFact>,
  ci_entries: List<ScheduleWitnessEntry>,
  prepush_entries: List<ScheduleWitnessEntry>
) -> EnrollmentDiscoveryReceipt {
  let discovered = discovered_subject_names(facts: facts)
  // The SAME closure census that discovers subjects and judges scope decides the enrollment: a
  // roster row counts only when the witness it names is a declaration in this census. One pool,
  // one seam -- a parallel witness-existence index would be a second authority for one fact
  // (DESIGN 3) and redundant with the derivation it shadows (DESIGN 2).
  let enrolled = consumer_enrolled_for(
    binding: contract.consumer_witness,
    ci_entries: ci_entries,
    prepush_entries: prepush_entries,
    facts: facts
  )
  EnrollmentDiscoveryReceipt {
    contract_id: contract.entry.lens_id,
    discovered_subject_names: discovered,
    scope_satisfaction: scope_satisfaction_for(
      claimed_scope: contract.claimed_scope,
      desired_scope: desired_scope,
      facts: facts
    ),
    consumer_enrolled: enrolled,
    consumer_entry_identity: consumer_entry_identity_for(binding: contract.consumer_witness, enrolled: enrolled),
    red_control_status: red_control_status_for_contract(contract: contract),
    self_application_status: self_application_for(facts: facts, module_prefix: self_module_prefix)
  }
}

data non_fold_residue_frontier: List<FrontierRow> = [
  FrontierRow {
      subject: PathSubject { path: "consumer_entry_identity_for" },
      reason: nfr_reason_land_red_era,
      dissolution: nfr_dissolve_owning_fold,
    },
]
