}

type ModuleDeclarationFact {
  module: String
  path: String
}

type ImportResolutionFact {
  path: String
  import_module: String
  target_declared: Bool
}

type ModuleDependencyEdge {
  path: String
  target_module: String
  target_declared: Bool
}

data dependency_edge_source_migration_note: String = "EDGE SOURCE, isolated as the single swappable fact producer (operator constraint, 2026-07-10, on the entry_file_touched reground): today dependency_resolution_facts_live unions import_resolution_facts_live with strict-tier reference_derived_import_resolution_facts_live (host twin selection_adjacency in cli_run.rs). The namespace-only resolution thread (operator-signed 2026-07-06) deletes the import grammar at its terminal step and derives dependencies from container.member references instead — when that lands, dependency_resolution_facts_live swaps to reference_derived_resolution_facts_flagged_pending_reference_producer and nothing above it changes: dependency_closure, import_closure, touched_path_in_closure, entry_affected_by_touched_paths, and every consumer of the closure query are edge-source-agnostic by construction (they read ModuleDependencyEdge rows as data, never import syntax). Do not add a second edge producer beside dependency_resolution_facts_live; the swap replaces its body."

// Namespace-lane handoff specimens from gunbc#7908 (operator ruling 2026-08-06, msg_8e1c9e9d):
// three closure-binding failures from #6848 import stripping that whole-tree compile-clean repaired
// with explicit imports — NOT held for namespace-derived closure; main needed exact imports today,
// namespace program owns making this class unwritable later. (1) v2.lens.complexity: direct imports
// from v2.lens.cost stripped (PolynomialDegree, PolyLogExponent, SizeVariable, SymbolicCost,
// asymptotic_class_*); module referenced cost symbols with zero import lines. (2)
// v2.lens.enforcement.receipts: direct imports stripped from v2.lens.cost and
// v2.lens.enforcement.vocab (SymbolicCost, EnrolledInFloorRoster, EnrollmentDiscoveryReceipt,
// LensModuleFunctionObserved, etc.). (3) v2.extdeps.languages.rust_test_fixtures: missing
// std.algebra { Cons, Empty } bindings (#7772 partial un-strip; see
// rust_test_fixtures_rust_import_unstrip_note). Dissolve-on: bare-reference closure binding is
// construction-backed repo-wide so stripped modules cannot compile only by pool-membership
// coincidence.

data reference_derived_edge_source_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "v2.lens.module_graph",
    decl_name: "reference_derived_resolution_facts_flagged_pending_reference_producer",
    field: WholeDeclaration
  }
}

data reference_derived_edge_source_dissolution_note: String = "XL-4 swap-body producer: ModuleDependencyEdge rows derived from resolved qualified-name use sites via v2.std.symbol_index filled by v2.compiler.symbol_index_fill, never from import syntax. Import-decl subtrees are skipped so an unused import cannot mint a reference edge. Not wired into dependency_resolution_facts_live (NAMESPACE-XL STAGE XL-6). Name suffix _pending_reference_producer marks that the live edge source has not swapped; the body is no longer the import-backed stand-in."

fn import_resolution_facts_live(
  pool_roots: List<String>,
  importer_roots: List<String>,
  exclude_substrings: List<String>
) -> List<ImportResolutionFact> {
  import_resolution_facts(
    pool_roots: pool_roots,
    importer_roots: importer_roots,
    exclude_substrings: exclude_substrings
  )
}

fn reference_derived_import_resolution_facts_live(
  pool_roots: List<String>,
  importer_roots: List<String>,
  exclude_substrings: List<String>
) -> List<ImportResolutionFact> {
  reference_resolution_facts(
    pool_roots: pool_roots,
    importer_roots: importer_roots,
    exclude_substrings: exclude_substrings
  )
}

// THE UNION IS NATIVE NOW; the name is retained because gunbc.stage0_partition_closure and
// gunbc.repo_atlas_projection cite this row by symbol. HISTORY, all measured: #8044 fixed two
// quadratics in the interpreted composition here - a linear membership scan, then a list_snoc_item
// accumulator - taking it from an OOM at 396s to 173.6-177.6s. The remaining cost was never the host
// fact production those notes blamed. Per term in one process on the live corpus:
// import_resolution_facts_live 146ms, reference_derived_import_resolution_facts_live 5ms, union and
// dedup of the two 104,943ms, all of dependency_resolution_facts_live 112,261ms. The two host leaves
// are 151ms of 112,261ms, so caching them recovers nothing; the interpreted composition WAS the
// cost. Three further hypotheses were refuted by execution: duplicate (importer, target) work in the
// consuming index (raw == unique exactly, measured post-join at module grain with path-to-module
// injectivity measured and zero dropped edges); the interpreter Map primitive (map_insert 38ms at
// n=2000 and 68ms at n=8000 against a take-only subtractive control - 1.8x for 4x the items, not
// quadratic, NOT claimed as a defect); and the bucket's own list_snoc_item (replaced with a cons,
// 105,007ms against a 104,943ms baseline - no change, reverted). THE REPAIR moved the composition
// to the host builtin dependency_resolution_facts, whose single dedup authority is
// v1_compiler.cli_run union_dedup_import_facts_reference_first. THE LAW IT CARRIES is the deleted
// interpreted spelling's: reference-first order, first occurrence kept, exact identity on {path,
// import_module, target_declared}, every target_declared: false row preserved because the
// partition-closure census judges unresolved targets. The interpreted union, dedup, per-path bucket
// and accumulator are deleted rather than kept dormant - a dead 105-second implementation beside
// the live one is ambiguity, not authority. The executing consumer holding the native arm to the
// law is test.claim.module_graph_edge_source_witness_test, which points the production function at
// a four-module fixture and asserts the union at identity grain in both directions. DISSOLVE-ON:
// the namespace terminal step retires the import producer; then this row's subject is the
// reference-only producer and the union disappears with it.

fn module_declaration_facts_live(pool_roots: List<String>) -> List<ModuleDeclarationFact> {
  module_declaration_facts(pool_roots: pool_roots)
}

// The keyed read beside the population one: the row for one module, or none. Same shape as
// `module_declaration_facts_live` narrows to, so a consumer that asked "is this module declared,
// and where" stops paying for every other module's row to find out.
fn module_declaration_facts_at_live(
  pool_roots: List<String>,
  module_path: String
) -> List<ModuleDeclarationFact> {
  module_declaration_facts_at(pool_roots: pool_roots, module_path: module_path)
}

fn import_fact_to_dependency_edge(edge: ImportResolutionFact) -> ModuleDependencyEdge {
  ModuleDependencyEdge {
    path: edge.path,
    target_module: edge.import_module,
    target_declared: edge.target_declared
  }
}

fn dependency_edges_from_import_facts(edges: List<ImportResolutionFact>) -> List<ModuleDependencyEdge> {
  list_reverse(xs: fold_list(
    xs: edges,
    empty: Empty,
    cons: fn(acc, edge) {
      Cons { head: import_fact_to_dependency_edge(edge: edge), tail: acc }
    }
  ))
}

// NATIVE-REALIZED, and the measurement is the whole argument. This body used to compose the two
// producers below in the interpreter, with a union+dedup and an edge mapping, now deleted. Measured
// on the live corpus in ONE process, per term:
//
//   import_resolution_facts_live                      146ms
//   reference_derived_import_resolution_facts_live      5ms
//   union + dedup of the two                      104,943ms
//   dependency_resolution_facts_live (all of it)  112,261ms
//
// The corpus scans assumed to dominate are 151ms of 112,261ms; the interpreted composition is the
// entire cost, and effectively the whole partition-closure census that consumes it. So the repair
// moves the COMPOSITION, not caches the leaves: a snapshot join over the producers would have
// recovered 151ms and left the census over its envelope.
//
// The two producers stay where they were. This is the edge-source seam
// dependency_edge_source_migration_note designates for the namespace terminal step, and it must
// remain one swappable producer pair rather than a native black box — the native arm composes the
// same two leaves through the same reference-first exact dedup on
// \{path, import_module, target_declared\}, keeping first-occurrence order and every
// target_declared: false row, because the partition-closure census judges unresolved targets.
fn dependency_resolution_facts_live(
  pool_roots: List<String>,
  importer_roots: List<String>,
  exclude_substrings: List<String>
) -> List<ModuleDependencyEdge> {
  dependency_resolution_facts(
    pool_roots: pool_roots,
    importer_roots: importer_roots,
    exclude_substrings: exclude_substrings
  )
}

data reference_derived_ingest_anchor: Symbol = ^reference_derived_ingest_anchor

data reference_derived_qn_capture_missing: Symbol = ^reference_derived_qn_capture_missing

data no_reference_derived_edges: List<ModuleDependencyEdge> = []

data no_qn_sites: List<QualifiedName> = []

type ReferenceDerivedPool {
  index: SymbolIndex
  trees: Map<String, Node>
}

fn reference_derived_path_excluded(path: String, exclude_substrings: List<String>) -> Bool {
  any(xs: exclude_substrings, predicate: fn(sub) { string_contains(s: path, sub: sub) })
}

fn reference_derived_path_under_roots(path: String, roots: List<String>) -> Bool {
  any(xs: roots, predicate: fn(root) { starts_with(s: path, prefix: concat(root, "/")) })
}

fn reference_derived_symbol_eq(a: Symbol, b: Symbol) -> Bool {
  a == b
}

fn ingest_module_root(rel_path: String) -> Outcome<Node> {
  let lm = dag_language_model()
  bind_outcome(
    o: tokenize(
      text: filesystem_read(path: rel_path).content,
      file: reference_derived_ingest_anchor,
      rules: lm.lex
    ),
    f: fn(token_stream) {
      bind_outcome(
        o: parse_module(tokens: token_stream, grammar: lm.grammar),
        f: fn(artifact) {
          outcome_accepted(value: artifact.tree)
        }
      )
    }
  )
}

fn qn_from_qualified_name_production(production_node: Node, module_root: Node) -> Outcome<QualifiedName> {
  match parse_production_captured_child_optional(node: production_node) {
    Absent =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: Diagnostic {
            reason: reference_derived_qn_capture_missing,
            at: node_locus(node: production_node),
            correction: Unavailable { reason: ExternalContractUnknown }
          }
        )
      }
    Present { value: capture } =>
      match parse_qualified_name_segments_from_capture(qn_capture: capture, root: module_root) {
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
        Accepted { value: segments, diagnostics: _ } =>
          qualified_name_from_symbol_segments(segments: segments, root: module_root)
      }
  }
}

fn collect_non_import_qn_sites_from_edges(
  edges: List<Edge>,
  module_root: Node,
  module_qn: QualifiedName,
  acc: List<QualifiedName>
) -> Outcome<List<QualifiedName>> {
  match edges |> first {
    Absent => outcome_accepted(value: acc)
    Present { value: edge } =>
      match collect_non_import_qn_sites_from_node(
        node: edge.target,
        module_root: module_root,
        module_qn: module_qn,
        acc: acc
      ) {
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
        Accepted { value: next_acc, diagnostics: _ } =>
          collect_non_import_qn_sites_from_edges(
            edges: edges |> skip(1),
            module_root: module_root,
            module_qn: module_qn,
            acc: next_acc
          )
      }
  }
}

fn collect_non_import_qn_sites_from_node(
  node: Node,
  module_root: Node,
  module_qn: QualifiedName,
  acc: List<QualifiedName>
) -> Outcome<List<QualifiedName>> {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } =>
      if id == ^dag_surface_import_decl {
        outcome_accepted(value: acc)
      } else if id == ^dag_surface_qualified_name {
        match qn_from_qualified_name_production(production_node: node, module_root: module_root) {
          Rejected { diagnostics: d } => Rejected { diagnostics: d }
          Accepted { value: site_qn, diagnostics: _ } =>
            collect_non_import_qn_sites_from_edges(
              edges: node.children,
              module_root: module_root,
              module_qn: module_qn,
              acc: if site_qn == module_qn {
                acc
              } else {
                list_snoc_item(xs: acc, item: site_qn)
              }
            )
        }
      } else {
        collect_non_import_qn_sites_from_edges(
          edges: node.children,
          module_root: module_root,
          module_qn: module_qn,
          acc: acc
        )
      }
    Absent =>
      collect_non_import_qn_sites_from_edges(
        edges: node.children,
        module_root: module_root,
        module_qn: module_qn,
        acc: acc
      )
  }
}

fn collect_non_import_qn_sites(module_root: Node) -> Outcome<List<QualifiedName>> {
  match qualified_name_from_module_node(root: module_root) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: module_qn, diagnostics: _ } =>
      collect_non_import_qn_sites_from_node(
        node: module_root,
        module_root: module_root,
        module_qn: module_qn,
        acc: no_qn_sites
      )
  }
}

fn prefer_longer_module(acc: Optional<String>, candidate: String) -> Optional<String> {
  match acc {
    Absent => optional_present(value: candidate)
    Present { value: current } =>
      if string_length(s: candidate) > string_length(s: current) {
        optional_present(value: candidate)
      } else {
        optional_present(value: current)
      }
  }
}

fn longest_declared_module_prefix(
  path: QualifiedName,
  declared: List<ModuleDeclarationFact>
) -> Optional<String> {
  fold_list(
    xs: declared,
    empty: optional_absent(),
    cons: fn(acc, fact) {
      let decl_qn = qualified_name_from_dotted_string(dotted: fact.module)
      if length(xs: decl_qn) == 0 {
        acc
      } else if is_prefix_of(prefix: decl_qn, xs: path, eq: reference_derived_symbol_eq) {
        prefer_longer_module(acc: acc, candidate: fact.module)
      } else {
        acc
      }
    }
  )
}

fn resolved_target_module(
  index: SymbolIndex,
  site_qn: QualifiedName,
  declared: List<ModuleDeclarationFact>
) -> Optional<String> {
  match symbol_index_lookup(index: index, qualified_path: site_qn) {
    Present { value: _ } => longest_declared_module_prefix(path: site_qn, declared: declared)
    Absent => longest_declared_module_prefix(path: site_qn, declared: declared)
  }
}

fn snoc_reference_edge_unique(
  acc: List<ModuleDependencyEdge>,
  edge: ModuleDependencyEdge
) -> List<ModuleDependencyEdge> {
  if any(xs: acc, predicate: fn(existing) {
    string_eq(a: existing.path, b: edge.path) && string_eq(a: existing.target_module, b: edge.target_module)
  }) {
    acc
  } else {
    list_snoc_item(xs: acc, item: edge)
  }
}

fn edges_from_qn_sites(
  rel_path: String,
  self_module: String,
  sites: List<QualifiedName>,
  index: SymbolIndex,
  declared: List<ModuleDeclarationFact>
) -> List<ModuleDependencyEdge> {
  fold_list(
    xs: sites,
    empty: no_reference_derived_edges,
    cons: fn(acc, site_qn) {
      match resolved_target_module(index: index, site_qn: site_qn, declared: declared) {
        Absent => acc
        Present { value: target } =>
          if string_eq(a: target, b: self_module) {
            acc
          } else {
            snoc_reference_edge_unique(
              acc: acc,
              edge: ModuleDependencyEdge {
                path: rel_path,
                target_module: target,
                target_declared: true
              }
            )
          }
      }
    }
  )
}

fn absorb_pool_file(
  acc: Outcome<ReferenceDerivedPool>,
  fact: ModuleDeclarationFact
) -> Outcome<ReferenceDerivedPool> {
  bind_outcome(
    o: acc,
    f: fn(pool) {
      bind_outcome(
        o: ingest_module_root(rel_path: fact.path),
        f: fn(root) {
          outcome_accepted(
            value: ReferenceDerivedPool {
              index: symbol_index_fill_module_root(index: pool.index, root: root),
              trees: map_insert(m: pool.trees, key: fact.path, value: root)
            }
          )
        }
      )
    }
  )
}

fn empty_reference_derived_pool() -> ReferenceDerivedPool {
  ReferenceDerivedPool {
    index: empty_symbol_index(),
    trees: empty_map()
  }
}

fn load_reference_derived_pool(
  declared: List<ModuleDeclarationFact>
) -> Outcome<ReferenceDerivedPool> {
  fold_list(
    xs: declared,
    empty: outcome_accepted(value: empty_reference_derived_pool()),
    cons: fn(acc, fact) { absorb_pool_file(acc: acc, fact: fact) }
  )
}

fn emit_reference_edges_for_importer(
  fact: ModuleDeclarationFact,
  pool: ReferenceDerivedPool,
  declared: List<ModuleDeclarationFact>
) -> Outcome<List<ModuleDependencyEdge>> {
  match map_lookup_where_rejected_unreachable(m: pool.trees, key: fact.path) {
    Absent => outcome_accepted(value: no_reference_derived_edges)
    Present { value: root } =>
      match collect_non_import_qn_sites(module_root: root) {
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
        Accepted { value: sites, diagnostics: _ } =>
          outcome_accepted(
            value: edges_from_qn_sites(
              rel_path: fact.path,
              self_module: fact.module,
              sites: sites,
              index: pool.index,
              declared: declared
            )
          )
      }
  }
}

fn append_outcome_edges(
  acc: Outcome<List<ModuleDependencyEdge>>,
  more: Outcome<List<ModuleDependencyEdge>>
) -> Outcome<List<ModuleDependencyEdge>> {
  bind_outcome(
    o: acc,
    f: fn(acc_edges) {
      bind_outcome(
        o: more,
        f: fn(more_edges) {
          outcome_accepted(value: list_append(left: acc_edges, right: more_edges))
        }
      )
    }
  )
}

fn reference_derived_edges_from_resolved_targets(
  pool_roots: List<String>,
  importer_roots: List<String>,
  exclude_substrings: List<String>
) -> Outcome<List<ModuleDependencyEdge>> {
  let declared = module_declaration_facts_live(pool_roots: pool_roots)
    |> filter(fact => !reference_derived_path_excluded(path: fact.path, exclude_substrings: exclude_substrings))
  bind_outcome(
    o: load_reference_derived_pool(declared: declared),
    f: fn(pool) {
      fold_list(
        xs: declared |> filter(fact => reference_derived_path_under_roots(path: fact.path, roots: importer_roots)),
        empty: outcome_accepted(value: no_reference_derived_edges),
        cons: fn(acc, fact) {
          append_outcome_edges(
            acc: acc,
            more: emit_reference_edges_for_importer(fact: fact, pool: pool, declared: declared)
          )
        }
      )
    }
  )
}

fn reference_derived_resolution_facts_flagged_pending_reference_producer(
  pool_roots: List<String>,
  importer_roots: List<String>,
  exclude_substrings: List<String>
) -> Outcome<List<ModuleDependencyEdge>> {
  reference_derived_edges_from_resolved_targets(
    pool_roots: pool_roots,
    importer_roots: importer_roots,
    exclude_substrings: exclude_substrings
  )
}

fn string_eq(a: String, b: String) -> Bool {
  a == b
}

data no_paths: FreeMonoid<String> = Empty

data no_import_facts: List<ImportResolutionFact> = []

fn add_unseen(acc: FreeMonoid<String>, item: String) -> FreeMonoid<String> {
  if contains(xs: acc, item: item, eq: string_eq) {
    acc
  } else {
    list_snoc_item(xs: acc, item: item)
  }
}

fn union_unseen(acc: FreeMonoid<String>, more: FreeMonoid<String>) -> FreeMonoid<String> {
  fold_list(xs: more, empty: acc, cons: fn(a, x) { add_unseen(acc: a, item: x) })
}

type ImportClosureBfsState {
  reached: FreeMonoid<String>
  queue: List<String>
}

fn map_lookup_where_rejected_unreachable<K, V>(m: Map<K, V>, key: K) -> Optional<V> {
  match v2.std.collection.map_get(m: m, key: key) {
    Accepted { value: v, diagnostics: _ } => v
    Rejected { diagnostics: _ } => Absent
  }
}

fn build_module_to_path(nodes: List<ModuleDeclarationFact>) -> Map<String, String> {
  fold_list(
    xs: nodes,
    empty: empty_map(),
    cons: fn(acc, node) {
      map_insert(m: acc, key: node.module, value: node.path)
    }
  )
}

fn snoc_unseen_list(acc: List<String>, item: String) -> List<String> {
  if contains(xs: acc, item: item, eq: string_eq) {
    acc
  } else {
    list_snoc_item(xs: acc, item: item)
  }
}

fn extend_adjacency_for_dependency_edge(
  acc: Map<String, List<String>>,
  edge: ModuleDependencyEdge,
  module_to_path: Map<String, String>
) -> Map<String, List<String>> {
  match map_lookup_where_rejected_unreachable(m: module_to_path, key: edge.target_module) {
    Present { value: imported_path } =>
      match map_lookup_where_rejected_unreachable(m: acc, key: edge.path) {
        Present { value: existing } =>
          map_insert(
            m: acc,
            key: edge.path,
            value: snoc_unseen_list(acc: existing, item: imported_path)
          )
        Absent =>
          map_insert(
            m: acc,
            key: edge.path,
            value: list_snoc_item(xs: no_paths, item: imported_path)
          )
      }
    Absent => acc
  }
}

fn build_dependency_adjacency(
  edges: List<ModuleDependencyEdge>,
  nodes: List<ModuleDeclarationFact>
) -> Map<String, List<String>> {
  let module_to_path = build_module_to_path(nodes: nodes)
  fold_list(
    xs: edges,
    empty: empty_map(),
    cons: fn(acc, edge) {
      extend_adjacency_for_dependency_edge(
        acc: acc,
        edge: edge,
        module_to_path: module_to_path
      )
    }
  )
}

fn extend_adjacency_for_edge(
  acc: Map<String, List<String>>,
  edge: ImportResolutionFact,
  module_to_path: Map<String, String>
) -> Map<String, List<String>> {
  extend_adjacency_for_dependency_edge(
    acc: acc,
    edge: import_fact_to_dependency_edge(edge: edge),
    module_to_path: module_to_path
  )
}

fn build_import_adjacency(
  edges: List<ImportResolutionFact>,
  nodes: List<ModuleDeclarationFact>
) -> Map<String, List<String>> {
  build_dependency_adjacency(
    edges: dependency_edges_from_import_facts(edges: edges),
    nodes: nodes
  )
}

fn bfs_absorb_neighbor(state: ImportClosureBfsState, path: String) -> ImportClosureBfsState {
  if contains(xs: state.reached, item: path, eq: string_eq) {
    state
  } else {
    ImportClosureBfsState {
      reached: list_snoc_item(xs: state.reached, item: path),
      queue: list_snoc_item(xs: state.queue, item: path)
    }
  }
}

fn bfs_absorb_neighbors(
  state: ImportClosureBfsState,
  neighbors: List<String>
) -> ImportClosureBfsState {
  fold_list(
    xs: neighbors,
    empty: state,
    cons: fn(acc, path) { bfs_absorb_neighbor(state: acc, path: path) }
  )
}

fn import_closure_bfs_walk(
  state: ImportClosureBfsState,
  adjacency: Map<String, List<String>>
) -> FreeMonoid<String> {
  match state.queue |> first {
    Present { value: importer } =>
      let rest = state.queue |> skip(1)
      let neighbors = match map_lookup_where_rejected_unreachable(m: adjacency, key: importer) {
        Present { value: paths } => paths
        Absent => no_paths
      }
      let next = bfs_absorb_neighbors(
        state: ImportClosureBfsState { reached: state.reached, queue: rest },
        neighbors: neighbors
      )
      import_closure_bfs_walk(state: next, adjacency: adjacency)
    Absent => state.reached
  }
}

fn dependency_closure_over_adjacency(
  entry_path: String,
  adjacency: Map<String, List<String>>
) -> FreeMonoid<String> {
  import_closure_bfs_walk(
    state: ImportClosureBfsState {
      reached: list_snoc_item(xs: no_paths, item: entry_path),
      queue: list_snoc_item(xs: no_paths, item: entry_path)
    },
    adjacency: adjacency
  )
}

fn dependency_closure(
  entry_path: String,
  edges: List<ModuleDependencyEdge>,
  nodes: List<ModuleDeclarationFact>
) -> FreeMonoid<String> {
  dependency_closure_over_adjacency(
    entry_path: entry_path,
    adjacency: build_dependency_adjacency(edges: edges, nodes: nodes)
  )
}

fn import_closure(
  entry_path: String,
  edges: List<ImportResolutionFact>,
  nodes: List<ModuleDeclarationFact>
) -> FreeMonoid<String> {
  dependency_closure(
    entry_path: entry_path,
    edges: dependency_edges_from_import_facts(edges: edges),
    nodes: nodes
  )
}

data module_graph_exclude_substrings: List<String> = []

fn dependency_closure_live_excluding(
  entry_path: String,
  pool_roots: List<String>,
  exclude_substrings: List<String>
) -> FreeMonoid<String> {
  dependency_closure(
    entry_path: entry_path,
    edges: dependency_resolution_facts_live(
      pool_roots: pool_roots,
      importer_roots: pool_roots,
      exclude_substrings: exclude_substrings
    ),
    nodes: module_declaration_facts_live(pool_roots: pool_roots)
  )
}

fn import_closure_live_excluding(
  entry_path: String,
  pool_roots: List<String>,
  exclude_substrings: List<String>
) -> FreeMonoid<String> {
  dependency_closure_live_excluding(
    entry_path: entry_path,
    pool_roots: pool_roots,
    exclude_substrings: exclude_substrings
  )
}

fn import_closure_live(entry_path: String, pool_roots: List<String>) -> FreeMonoid<String> {
  import_closure_live_excluding(
    entry_path: entry_path,
    pool_roots: pool_roots,
    exclude_substrings: module_graph_exclude_substrings
  )
}

fn strip_leading_dot_slash(s: String) -> String {
  if starts_with(s: s, prefix: "./") {
    substring(s: s, start: 2, end: string_length(s: s))
  } else {
    s
  }
}

fn path_matches_touched(closure_path: String, touched_path: String) -> Bool {
  let file = strip_leading_dot_slash(closure_path)
  let target = strip_leading_dot_slash(touched_path)
  string_eq(a: file, b: target)
    || ends_with(s: file, suffix: target)
    || ends_with(s: target, suffix: file)
}

fn touched_path_in_closure(closure: FreeMonoid<String>, path: String) -> Bool {
  any(xs: closure, predicate: fn(closure_path) { path_matches_touched(closure_path: closure_path, touched_path: path) })
}

// There is deliberately NO edgeless-entry arm here. The one this branch briefly carried
// (entry_without_declared_edges_never_skips_note + module_declares_outgoing_dependency_edge, added
// after the import strip, now deleted) was the absorbing fallback DESIGN 5 names verbatim: 'can't
// compute the affected set -> rerun the entire suite'. It answered affected=true for every entry
// with no outgoing edges — ~530 claim modules after the strip — silently and uncounted, so the
// deficit's frequency was zero by construction while its cost surfaced as a 95-minute CI floor
// instead of a diagnostic. Nor was it answering an unknown: dependency_closure seeds with the entry
// itself, so an edgeless entry has the precise closure of the entry alone and 'affected iff my own
// file is touched' is a real answer. The two states that arm conflated are split on the host twin
// (cli_run.rs entry_file_touched_via_import_closure): a producer that looked and found no edges
// falls through to the closure; one that could not read or parse the file returns a typed
// AFFECTED-SET REFUSAL, because an unknown dependency set is not an empty one.

fn entry_affected_by_touched_paths_excluding(
  entry_path: String,
  pool_roots: List<String>,
  touched_paths: List<String>,
  exclude_substrings: List<String>
) -> Bool {
  let closure = dependency_closure_live_excluding(
    entry_path: entry_path,
    pool_roots: pool_roots,
    exclude_substrings: exclude_substrings
  )
  any(xs: touched_paths, predicate: fn(path) { touched_path_in_closure(closure: closure, path: path) })
}

fn entry_affected_by_touched_paths(
  entry_path: String,
  pool_roots: List<String>,
  touched_paths: List<String>
) -> Bool {
  entry_affected_by_touched_paths_excluding(
    entry_path: entry_path,
    pool_roots: pool_roots,
    touched_paths: touched_paths,
    exclude_substrings: module_graph_exclude_substrings
  )
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SingleAuthority }
}

data reference_derived_edge_source_dissolve_on: DissolutionCondition = unbound_dissolution(description: "NAMESPACE-XL STAGE XL-6 swaps dependency_resolution_facts_live onto this producer; until then the live edge source stays the import/reference union and this body stays the unused swap target")
