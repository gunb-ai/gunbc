module v2.lens.module_graph

import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }
import std.disposition { SingleAuthority }
import v2.std.algebra { FreeMonoid, fold_list, length, contains, list_snoc_item }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }

type ModuleDeclarationFact {
  module: String
  path: String
}

type ImportResolutionFact {
  path: String
  import_module: String
  target_declared: Bool
}

fn import_resolution_facts_live(
  pool_roots: List<String>,
  importer_roots: List<String>,
  exclude_substrings: List<String>
) -> List<ImportResolutionFact> {
  import_resolution_facts(
    pool_roots: pool_roots,
    importer_roots: importer_roots,
    exclude_substrings: exclude_substrings
  )
}

fn module_declaration_facts_live(pool_roots: List<String>) -> List<ModuleDeclarationFact> {
  module_declaration_facts(pool_roots: pool_roots)
}

fn string_eq(a: String, b: String) -> Bool {
  a == b
}

data no_paths: FreeMonoid<String> = []

fn add_unseen(acc: FreeMonoid<String>, item: String) -> FreeMonoid<String> {
  if contains(xs: acc, item: item, eq: string_eq) {
    acc
  } else {
    list_snoc_item(xs: acc, item: item)
  }
}

fn union_unseen(acc: FreeMonoid<String>, more: FreeMonoid<String>) -> FreeMonoid<String> {
  fold_list(xs: more, empty: acc, cons: fn(a, x) { add_unseen(acc: a, item: x) })
}

fn paths_of_module(name: String, nodes: List<ModuleDeclarationFact>) -> FreeMonoid<String> {
  fold_list(
    xs: nodes,
    empty: no_paths,
    cons: fn(acc, node) {
      if string_eq(a: node.module, b: name) {
        add_unseen(acc: acc, item: node.path)
      } else {
        acc
      }
    }
  )
}

fn imported_paths_of(
  importer: String,
  edges: List<ImportResolutionFact>,
  nodes: List<ModuleDeclarationFact>
) -> FreeMonoid<String> {
  fold_list(
    xs: edges,
    empty: no_paths,
    cons: fn(acc, edge) {
      if string_eq(a: edge.path, b: importer) {
        union_unseen(acc: acc, more: paths_of_module(name: edge.import_module, nodes: nodes))
      } else {
        acc
      }
    }
  )
}

fn expand_once(
  reached: FreeMonoid<String>,
  edges: List<ImportResolutionFact>,
  nodes: List<ModuleDeclarationFact>
) -> FreeMonoid<String> {
  fold_list(
    xs: reached,
    empty: reached,
    cons: fn(acc, importer) {
      union_unseen(acc: acc, more: imported_paths_of(importer: importer, edges: edges, nodes: nodes))
    }
  )
}

fn close_to_fixpoint(
  reached: FreeMonoid<String>,
  edges: List<ImportResolutionFact>,
  nodes: List<ModuleDeclarationFact>,
  fuel: Int
) -> FreeMonoid<String> {
  if fuel <= 0 {
    reached
  } else {
    let next = expand_once(reached: reached, edges: edges, nodes: nodes)
    if length(xs: next) == length(xs: reached) {
      reached
    } else {
      close_to_fixpoint(reached: next, edges: edges, nodes: nodes, fuel: fuel - 1)
    }
  }
}

fn import_closure(
  entry_path: String,
  edges: List<ImportResolutionFact>,
  nodes: List<ModuleDeclarationFact>
) -> FreeMonoid<String> {
  close_to_fixpoint(
    reached: list_snoc_item(xs: no_paths, item: entry_path),
    edges: edges,
    nodes: nodes,
    fuel: length(xs: nodes)
  )
}

data module_graph_exclude_substrings: List<String> = []

fn import_closure_live(entry_path: String, pool_roots: List<String>) -> FreeMonoid<String> {
  import_closure(
    entry_path: entry_path,
    edges: import_resolution_facts_live(
      pool_roots: pool_roots,
      importer_roots: pool_roots,
      exclude_substrings: module_graph_exclude_substrings
    ),
    nodes: module_declaration_facts_live(pool_roots: pool_roots)
  )
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SingleAuthority },
  rationale: "The shared module-graph primitive grounding intent-linearity's ImportGraph axis (and the LayerDAG roster axis) in the substrate. The host emits two node/edge fact tables and does NOT traverse: import_resolution_facts gives the directed edges from importer-path to imported-module-name; module_declaration_facts gives the node-resolution table from module-name to declaring-path (the asymmetric endpoint import edges lack -- a target is a module NAME, a walk needs its declaring PATH). The transitive import closure is then PURE COMPUTATION over those facts, expressed as a fixpoint fold in .dag rather than a host walk, per the seed-shrinks-to-zero discipline (Rust exposes only the irreducible fact-read, never the high-level traversal). import_closure joins each frontier path's edges to declaring paths via paths_of_module and unions unseen paths; close_to_fixpoint iterates expand_once (a monotone, union-only expansion) until the path count is stable -- length-unchanged is a sound fixpoint test exactly because expansion only ever adds, and fuel = node count is the hard termination bound (a closure cannot exceed the total declared modules, so it converges in at most that many steps), so termination and decidability fall out of the bounded-forward substrate. Unresolved or external imports drop out naturally: paths_of_module yields zero paths for a module absent from the node table. SHARED, not Axis-1-only: module_declaration_facts of the roots IS the derived LayerDAG roster, so the LayerDAG axis becomes declared-roster == module_declaration_facts projection over the same node table and the same set-equality oracle, a different derived-side fn rather than a forked second index (DESIGN 2-horizontal: one concept, both breadths). Grounding authority: the parse/resolve module index the v1 resolver already builds (build_module_path_index). Dissolved (Tier-2 LANDED): intent_linearity.import_closure_is_clean_live reads derived from import_closure over live facts via import_graph_rule.derive (the host-projected ClosureFact carrier removed), and the WallNow.construction String now names this live fn. The closure is also exercised by its live-corpus witness (the .dag-native twin of the consumed_input_closure_drift Rust oracle): import_closure over the conformance entry equals the declared consumed-input closure, set-for-set, and drift in either direction breaks the equality by execution"
}
