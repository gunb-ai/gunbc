import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.algebra { Cons, Empty, FreeMonoid }
import v2.std.algebra { any, contains, fold_list, is_prefix_of, length, list_append, list_reverse, list_snoc_item }
import v2.std.collection {
  List,
  Map,
  empty_map,
  map_get,
  map_insert
}
