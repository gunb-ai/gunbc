module v2.lens.module_graph

import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }
import std.disposition { SingleAuthority }
import std.algebra { FreeMonoid }
import v2.std.algebra { fold_list, contains, list_snoc_item, any }
import v2.std.collection { Absent, List, Map, Optional, Present, empty_map, map_get, map_insert }
import v2.std.logic { Bool }
import v2.std.text { String }

type ModuleDeclarationFact {
  module: String
  path: String
}

type ImportResolutionFact {
  path: String
  import_module: String
  target_declared: Bool
}

fn import_resolution_facts_live(
  pool_roots: List<String>,
  importer_roots: List<String>,
  exclude_substrings: List<String>
) -> List<ImportResolutionFact> {
  import_resolution_facts(
    pool_roots: pool_roots,
    importer_roots: importer_roots,
    exclude_substrings: exclude_substrings
  )
}

fn module_declaration_facts_live(pool_roots: List<String>) -> List<ModuleDeclarationFact> {
  module_declaration_facts(pool_roots: pool_roots)
}

fn string_eq(a: String, b: String) -> Bool {
  a == b
}

data no_paths: FreeMonoid<String> = []

fn add_unseen(acc: FreeMonoid<String>, item: String) -> FreeMonoid<String> {
  if contains(xs: acc, item: item, eq: string_eq) {
    acc
  } else {
    list_snoc_item(xs: acc, item: item)
  }
}

fn union_unseen(acc: FreeMonoid<String>, more: FreeMonoid<String>) -> FreeMonoid<String> {
  fold_list(xs: more, empty: acc, cons: fn(a, x) { add_unseen(acc: a, item: x) })
}

type ImportClosureBfsState {
  reached: FreeMonoid<String>
  queue: List<String>
}

data map_lookup_where_rejected_unreachable_proof: String = "map_lookup_where_rejected_unreachable is NOT a general-purpose Map accessor: map_get's Rejected (a non-absent lookup failure, witness_option_bridge_test.dag's map_get_rejects_non_absent_lookup_failure) must stay Rejected, never be coerced to a miss. This helper is only ever called (below, both call sites) on maps built exclusively via empty_map/map_insert (build_module_to_path, build_import_adjacency's acc), whose lookup closure chain can only ever surface Holds or a Violates tagged ^map_key_absent -- map_get itself maps that exact tag to Accepted(Absent), so Rejected is decidably unreachable here by construction, not by assumption. If this helper is ever reused on a differently-constructed Map, this coercion is wrong for that caller -- do not reuse it outside this module without re-deriving the proof."

fn map_lookup_where_rejected_unreachable<K, V>(m: Map<K, V>, key: K) -> Optional<V> {
  match map_get(m: m, key: key) {
    Accepted { value: v, diagnostics: _ } => v
    Rejected { diagnostics: _ } => Absent
  }
}

fn build_module_to_path(nodes: List<ModuleDeclarationFact>) -> Map<String, String> {
  fold_list(
    xs: nodes,
    empty: empty_map(),
    cons: fn(acc, node) {
      map_insert(m: acc, key: node.module, value: node.path)
    }
  )
}

fn snoc_unseen_list(acc: List<String>, item: String) -> List<String> {
  if contains(xs: acc, item: item, eq: string_eq) {
    acc
  } else {
    list_snoc_item(xs: acc, item: item)
  }
}

fn extend_adjacency_for_edge(
  acc: Map<String, List<String>>,
  edge: ImportResolutionFact,
  module_to_path: Map<String, String>
) -> Map<String, List<String>> {
  match map_lookup_where_rejected_unreachable(m: module_to_path, key: edge.import_module) {
    Present { value: imported_path } =>
      match map_lookup_where_rejected_unreachable(m: acc, key: edge.path) {
        Present { value: existing } =>
          map_insert(
            m: acc,
            key: edge.path,
            value: snoc_unseen_list(acc: existing, item: imported_path)
          )
        Absent =>
          map_insert(
            m: acc,
            key: edge.path,
            value: list_snoc_item(xs: no_paths, item: imported_path)
          )
      }
    Absent => acc
  }
}

fn build_import_adjacency(
  edges: List<ImportResolutionFact>,
  nodes: List<ModuleDeclarationFact>
) -> Map<String, List<String>> {
  let module_to_path = build_module_to_path(nodes: nodes)
  fold_list(
    xs: edges,
    empty: empty_map(),
    cons: fn(acc, edge) {
      extend_adjacency_for_edge(
        acc: acc,
        edge: edge,
        module_to_path: module_to_path
      )
    }
  )
}

fn bfs_absorb_neighbor(state: ImportClosureBfsState, path: String) -> ImportClosureBfsState {
  if contains(xs: state.reached, item: path, eq: string_eq) {
    state
  } else {
    ImportClosureBfsState {
      reached: list_snoc_item(xs: state.reached, item: path),
      queue: list_snoc_item(xs: state.queue, item: path)
    }
  }
}

fn bfs_absorb_neighbors(
  state: ImportClosureBfsState,
  neighbors: List<String>
) -> ImportClosureBfsState {
  fold_list(
    xs: neighbors,
    empty: state,
    cons: fn(acc, path) { bfs_absorb_neighbor(state: acc, path: path) }
  )
}

fn import_closure_bfs_walk(
  state: ImportClosureBfsState,
  adjacency: Map<String, List<String>>
) -> FreeMonoid<String> {
  match state.queue |> first {
    Present { value: importer } =>
      let rest = state.queue |> skip(1)
      let neighbors = match map_lookup_where_rejected_unreachable(m: adjacency, key: importer) {
        Present { value: paths } => paths
        Absent => no_paths
      }
      let next = bfs_absorb_neighbors(
        state: ImportClosureBfsState { reached: state.reached, queue: rest },
        neighbors: neighbors
      )
      import_closure_bfs_walk(state: next, adjacency: adjacency)
    Absent => state.reached
  }
}

fn import_closure(
  entry_path: String,
  edges: List<ImportResolutionFact>,
  nodes: List<ModuleDeclarationFact>
) -> FreeMonoid<String> {
  let adjacency = build_import_adjacency(edges: edges, nodes: nodes)
  import_closure_bfs_walk(
    state: ImportClosureBfsState {
      reached: list_snoc_item(xs: no_paths, item: entry_path),
      queue: list_snoc_item(xs: no_paths, item: entry_path)
    },
    adjacency: adjacency
  )
}

data module_graph_exclude_substrings: List<String> = []

fn import_closure_live_excluding(
  entry_path: String,
  pool_roots: List<String>,
  exclude_substrings: List<String>
) -> FreeMonoid<String> {
  import_closure(
    entry_path: entry_path,
    edges: import_resolution_facts_live(
      pool_roots: pool_roots,
      importer_roots: pool_roots,
      exclude_substrings: exclude_substrings
    ),
    nodes: module_declaration_facts_live(pool_roots: pool_roots)
  )
}

fn import_closure_live(entry_path: String, pool_roots: List<String>) -> FreeMonoid<String> {
  import_closure_live_excluding(
    entry_path: entry_path,
    pool_roots: pool_roots,
    exclude_substrings: module_graph_exclude_substrings
  )
}

fn strip_leading_dot_slash(s: String) -> String {
  if starts_with(s: s, prefix: "./") {
    substring(s: s, start: 2, end: string_length(s: s))
  } else {
    s
  }
}

data path_matches_touched_provenance: String = "Mirrors the Rust production predicate exactly (span_file_matches/normalize_repo_path, cli_run.rs:4079-4083) -- normalize + suffix-tolerant, not bare exact equality. A path pair where suffix matching succeeds but exact equality fails must decide the SAME on both sides. SCAFFOLD: this is a parallel representation of that Rust predicate, not a single authority (DESIGN Sec3) -- it is load-bearing for the receipt's own equivalence proof (it must be independently expressed to prove agreement, not call the Rust fn). Dissolves when path normalization/suffix-matching is grounded as its own std authority both sides call -- at that point delete this fn and repoint touched_path_in_closure at the shared authority, do not keep both."

fn path_matches_touched(closure_path: String, touched_path: String) -> Bool {
  let file = strip_leading_dot_slash(closure_path)
  let target = strip_leading_dot_slash(touched_path)
  string_eq(a: file, b: target)
    || ends_with(s: file, suffix: target)
    || ends_with(s: target, suffix: file)
}

fn touched_path_in_closure(closure: FreeMonoid<String>, path: String) -> Bool {
  any(xs: closure, predicate: fn(closure_path) { path_matches_touched(closure_path: closure_path, touched_path: path) })
}

fn entry_affected_by_touched_paths_excluding(
  entry_path: String,
  pool_roots: List<String>,
  touched_paths: List<String>,
  exclude_substrings: List<String>
) -> Bool {
  let closure = import_closure_live_excluding(
    entry_path: entry_path,
    pool_roots: pool_roots,
    exclude_substrings: exclude_substrings
  )
  any(xs: touched_paths, predicate: fn(path) { touched_path_in_closure(closure: closure, path: path) })
}

fn entry_affected_by_touched_paths(
  entry_path: String,
  pool_roots: List<String>,
  touched_paths: List<String>
) -> Bool {
  entry_affected_by_touched_paths_excluding(
    entry_path: entry_path,
    pool_roots: pool_roots,
    touched_paths: touched_paths,
    exclude_substrings: module_graph_exclude_substrings
  )
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SingleAuthority }
}
