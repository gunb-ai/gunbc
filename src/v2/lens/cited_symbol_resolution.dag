module v2.lens.cited_symbol_resolution

import gunbc.ci_layer_roots { witness_layer_roots }
import gunbc.doc_graph_roots { hand_authored_doc_declaration_refs }
import std.disposition { SubstrateMandatoryTag }
import v2.lens.common.construction_justification {
  ConstructionJustification,
  WallAfterGrounding,
}
import v2.lens.module_graph { module_declaration_facts_live }
import v2.std.decl_index { decl_facts }
import v2.std.decl_ref_resolution { cited_declaration_ref_refusal_count }

data cited_symbol_resolution_law: String = "feature:cited-symbol-resolution — every typed DeclarationRef enrolled in hand_authored_doc_declaration_refs resolves to exactly one decl_facts row over a declared module, or refuses with a typed five-arm result. Population is structural (HandAuthoredDocBind primary_work + additional_works), not corpus text scan. Resolution semantics live in v2.std.decl_ref_resolution.resolve_declaration_ref over decl_facts + module_declaration_facts — single authority, no per-kind fork. Zero production behavior change until enrollment widens; this lens is the discriminating consumer that makes dangling scaffold binds visible. dissolve-on: substrate refuses unwritable DeclarationRef at construction; enrollment widens to every structural DeclarationRef carrier when the Node-tree reader lands."

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SubstrateMandatoryTag }
}

fn cited_symbol_resolution_violation_count() -> Int {
  cited_declaration_ref_refusal_count(
    refs: hand_authored_doc_declaration_refs(),
    facts: decl_facts(pool_roots: witness_layer_roots),
    modules: module_declaration_facts_live(pool_roots: witness_layer_roots)
  )
}
