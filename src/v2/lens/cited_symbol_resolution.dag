module v2.lens.cited_symbol_resolution

import gunbc.doc_graph_roots {
  hand_authored_cited_symbol_control_declaration_refs,
  hand_authored_outside_index_declaration_refs,
  hand_authored_doc_declaration_refs,
  hand_authored_production_doc_declaration_refs,
  hand_authored_works_resolution_pool_roots,
}
import gunbc.documentary_refs { generated_document_declaration_refs }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.disposition { SubstrateMandatoryTag }
import v2.lens.common.construction_justification {
  ConstructionJustification,
  WallAfterGrounding,
}
import v2.lens.enforcement.receipts { enforcement_red_probe_body_leaf }
import v2.lens.module_graph { ModuleDeclarationFact, module_declaration_facts_live }
import v2.lens.roster_registry { roster_registry_declaration_refs }
import v2.std.decl_index { DeclFact, FnItem, decl_facts }
import v2.std.decl_ref_resolution {
  cited_declaration_ref_refusal_count,
  declaration_ref_resolves,
  resolve_declaration_ref,
  DeclarationRefAmbiguous,
  DeclarationRefResolved,
  DeclarationRefModuleAbsent,
  DeclarationRefDeclarationAbsent,
  DeclarationRefFieldAbsent,
}

data cited_symbol_resolution_law: String = "feature:cited-symbol-resolution — every typed DeclarationRef enrolled in hand_authored_production_doc_declaration_refs (HandAuthoredDocBind primary_work + additional_works, excluding permanent g1-cited-symbol-control-* probe rows) resolves to exactly one decl_facts row over a declared module, or refuses with a typed five-arm result. Population is structural, not corpus text scan. Permanent planted controls in hand_authored_cited_symbol_control_declaration_refs stay enrolled for mutation witnesses — they never retire when production goes green (operator ruling 2026-08-03, DESIGN 4b(4)). Resolution semantics live in v2.std.decl_ref_resolution.resolve_declaration_ref over decl_facts + module_declaration_facts — single authority, no per-kind fork. dissolve-on: substrate refuses unwritable DeclarationRef at construction; enrollment widens to every structural DeclarationRef carrier when the Node-tree reader lands."

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SubstrateMandatoryTag }
}

data cited_symbol_planted_ambiguous_control_ref: DeclarationRef = DeclarationRef {
  module_path: "v2.std.node",
  decl_name: "G1_planted_ambiguous_control_RED",
  field: WholeDeclaration,
}

data cited_symbol_planted_ambiguous_control_facts: List<DeclFact> = [
  DeclFact {
    qualified_name: "std.node.G1_planted_ambiguous_control_RED",
    name: "G1_planted_ambiguous_control_RED",
    kind: FnItem,
    node: enforcement_red_probe_body_leaf,
    rel_path: "synthetic/g1_ambiguous_a.dag",
  },
  DeclFact {
    qualified_name: "std.node.G1_planted_ambiguous_control_RED",
    name: "G1_planted_ambiguous_control_RED",
    kind: FnItem,
    node: enforcement_red_probe_body_leaf,
    rel_path: "synthetic/g1_ambiguous_b.dag",
  },
]

data cited_symbol_population_widened_note: String = "THE DENOMINATOR NOW INCLUDES GENERATED-DOCUMENT REFERENCES, and that widening is the entire mechanism change. Before it, this lens counted hand-authored binds only, so a system named inside gunbc.design_document could be renamed or deleted and every required check stayed green while the same system named in a hand-authored document reddened -- one class of documentary reference enforced, an adjacent one silently exempt. The population widened rather than a second resolver being written: v2.std.decl_ref_resolution stays the single authority for what resolving a reference means, because a second algorithm that agrees today is a fork that disagrees later.\n\nWHAT WIDENS AND WHAT DOES NOT: production references from both sources are counted here. The permanent g1-cited-symbol-control-* probe rows stay excluded exactly as before, because they are planted to refuse and folding them in would make this count nonzero by construction."

data cited_symbol_roster_registry_widening_note: String = "THE DENOMINATOR NOW ALSO INCLUDES gunbc.roster_registry, and this widening was bought by a live defect rather than proposed for symmetry. A RosterRegistration carries typed DeclarationRefs — the roster it names, and for a ByDerivation row the predicate it claims computes membership — and nothing resolved either of them. gunbc.stage0_emit_plan_generated generated_stage0_files stayed registered ByDerivation from gunbc.stage0_emit_plan generated_stage0_files_from_emission_plan for as long as that module has been deleted; the registry's own lens stayed green throughout, because it checks the membership SHAPE and a ByDerivation arm is a standard shape whatever its payload names. That is the DESIGN section 3 stale-citation class living inside a structural carrier instead of inside prose, which is why the remedy is enrollment here and not more review diligence: the reference is an ordinary reference the substrate can already resolve.\n\nWHY THIS IS THE LAW'S OWN NEXT STEP RATHER THAN A NEW SCOPE: cited_symbol_resolution_law dissolves on 'enrollment widens to every structural DeclarationRef carrier'. The registry is such a carrier, so it enrolls under the existing resolver — v2.std.decl_ref_resolution stays the single authority for what resolving a reference means, and no second algorithm is written. WHAT DOES NOT WIDEN: the synthetic refs in v2.test.claim.roster_registry_test are constructed inside test functions and are not members of the live roster_registry data, so they never reach this population; the permanent planted controls stay excluded exactly as before."

fn cited_symbol_production_declaration_refs() -> List<DeclarationRef> {
  concat(
    concat(hand_authored_production_doc_declaration_refs(), generated_document_declaration_refs()),
    roster_registry_declaration_refs()
  )
}

fn cited_symbol_resolution_violation_count() -> Int {
  let pool = hand_authored_works_resolution_pool_roots()
  cited_declaration_ref_refusal_count(
    refs: cited_symbol_production_declaration_refs(),
    facts: decl_facts(pool_roots: pool),
    modules: module_declaration_facts_live(pool_roots: pool)
  )
}

fn cited_symbol_enrolled_refusal_count() -> Int {
  let pool = hand_authored_works_resolution_pool_roots()
  cited_declaration_ref_refusal_count(
    refs: hand_authored_doc_declaration_refs(),
    facts: decl_facts(pool_roots: pool),
    modules: module_declaration_facts_live(pool_roots: pool)
  )
}

fn cited_symbol_planted_control_refusal_count() -> Int {
  let pool = hand_authored_works_resolution_pool_roots()
  cited_declaration_ref_refusal_count(
    refs: hand_authored_cited_symbol_control_declaration_refs(),
    facts: decl_facts(pool_roots: pool),
    modules: module_declaration_facts_live(pool_roots: pool)
  )
}

data cited_symbol_required_ci_phase_note: String = "THE LENS EXECUTES ON EVERY CI RUN AS A PHASE, NOT AS A WITNESS, AND THE REASON IS STRUCTURAL RATHER THAN BUDGETARY. Until 2026-08-21 the live-corpus claim was carried only by cited_symbol_resolution_lens_is_green_on_live_corpus in dag/test/claim/long/, whose whole file is classified OfflineLocalRecipe — so nothing executed it, and it was RED on unmodified main with 27 refusing production references while every required check stayed green. The refusals were real: the floor cut, the regen cut and the falsifier deletion each removed a module while its citations stayed authored, which is precisely the DESIGN section 3 stale-citation class this lens exists to make decidable.\n\nWHY NOT THE REQUIRED FLOOR. run_required_floor admits an identity only if its module is outside the long home AND the entry does not read the live tree; the second arm is the fatal one here, because reading the live corpus IS this census's subject — decl_facts and module_declaration_facts over compile_clean_source_roots. Relocating the file moves the identity from DeclinedLongModule to DeclinedLiveTree and never to Planned (measured at identity grain in test.claim.transport_script_wall_compile_red). No amount of making it cheaper changes that, so the floor was never the route.\n\nWHAT A PHASE IS. claim_executor --required-ci runs its phases in one process, each reporting its own outcome into one ledger, so a phase is not a claim and is outside both the per-claim safety deadline and the live-tree arm. That is the same shape parse, regen and the fixed point already use, and it matches the 2026-08-20 consolidation directive rather than working around it. The sixteen witnesses stay where they are: they are the discriminating mechanism evidence (planted controls, five-arm refusals, the ambiguity fixture), and DESIGN 4b(4) keeps them enrolled rather than retiring them when production goes green."

data cited_symbol_outside_index_guard_note: String = "THE GUARD AGAINST THE ONE DODGE THE OUTSIDE-INDEX DISPOSITION ADMITS, AND IT EXECUTES RATHER THAN BEING REVIEWED. gunbc.doc_graph_roots marks four references as outside the declaration index because decl_facts does not index test modules; a counted, typed disposition is the sanctioned remedy, but nothing in the marking itself stops an author from marking a RESOLVABLE reference outside-index to escape a red — at which point the population silently shrinks and the census reports green over a reference nobody checked.\n\nSo the report below refuses such a row by execution: a reference marked outside-index that actually RESOLVES comes back as OUTSIDE-INDEX-RESOLVES and fails the phase. A count assertion alone would not catch it (wise-boar-649 measured exactly that: their counting witness stayed green under a two-way swap while the refusal-checking witness went red), and a count is implied here anyway — under the roster shape the only way the marked population can shrink is a row that resolves, so a second count row would be a second representation of one fact.\n\nWHY IT IS HERE AND NOT IN A WITNESS: every witness carrying this lens's live-corpus claim sits in a file classified OfflineLocalRecipe and executes nowhere, which is the defect this change exists to close. In the phase it runs on every CI run."

fn cited_symbol_unresolved_reference_report() -> List<String> {
  let pool = hand_authored_works_resolution_pool_roots()
  let facts = decl_facts(pool_roots: pool)
  let modules = module_declaration_facts_live(pool_roots: pool)
  concat(
    map(
      filter(
        cited_symbol_production_declaration_refs(),
        r => !declaration_ref_resolves(ref: r, facts: facts, modules: modules)
      ),
      r => concat(
        cited_symbol_reference_refusal_arm(ref: r, facts: facts, modules: modules),
        concat(" ", concat(r.module_path as String, concat(" ", r.decl_name as String)))
      )
    ),
    map(
      filter(
        hand_authored_outside_index_declaration_refs(),
        r => declaration_ref_resolves(ref: r, facts: facts, modules: modules)
      ),
      r => concat(
        "OUTSIDE-INDEX-RESOLVES ",
        concat(
          r.module_path as String,
          concat(
            " ",
            concat(
              r.decl_name as String,
              " — marked outside the declaration index, but it resolves; the marking is false"
            )
          )
        )
      )
    )
  )
}

fn cited_symbol_reference_refusal_arm(
  ref: DeclarationRef,
  facts: List<DeclFact>,
  modules: List<ModuleDeclarationFact>
) -> String {
  match resolve_declaration_ref(ref: ref, facts: facts, modules: modules) {
    DeclarationRefResolved { declaration_identity: _ } => "RESOLVED"
    DeclarationRefModuleAbsent { reference: _ } => "MODULE-ABSENT"
    DeclarationRefDeclarationAbsent { reference: _ } => "DECLARATION-ABSENT"
    DeclarationRefFieldAbsent { reference: _ } => "FIELD-ABSENT"
    DeclarationRefAmbiguous { reference: _, candidates: _ } => "AMBIGUOUS"
  }
}
