module v2.lens.simulated_relationship
import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }

import v2.std.node { Node, Edge }
import v2.std.algebra { FreeMonoid, is_empty, length, skip, zip_eq, is_prefix_of }
import v2.std.exact_structural_equality_zip_fold_predicate { exact_structural_equality_zip_fold }
import v2.std.logic { Bool }

// §2 horizontal-redundancy detector. A "simulated relationship" is a chain of
// statements/expressions that anti-unify to ONE template over a varying data hole
// -- i.e. a hand-unrolled fold: the relationship between elements is acted out in
// control flow instead of declared as data + a catamorphism. Sibling of
// v2.lens.structural_similarity (which targets duplicate *type declarations*, the
// §3 nicknaming smell); this targets repetition *inside a body*.
//
// Variant-matching on FreeMonoid/List must stay inside v2.std.algebra (the v2
// generic-instantiation weakness rejects cross-module variant patterns), so every
// list walk here goes through algebra's combinators (zip_eq, is_prefix_of, skip).

// Two Node trees are CONGRUENT iff they share one skeleton: identical internal
// shape (same kind, same arity at every internal position), free to differ only at
// leaves. The leaves are the fold's data holes; a differing *operator* or *arity*
// is a genuine shape divergence, never a hole.
// Typed projector: field access on a lambda element trips the v2 "no field on type
// T" weakness, so the comparison lives in this typed fn and the lambda only calls it.
fn edges_match(ea: Edge, eb: Edge) -> Bool {
  ea.label == eb.label && congruent(a: ea.target, b: eb.target)
}

fn congruent(a: Node, b: Node) -> Bool {
  if is_empty(xs: a.children) {
    is_empty(xs: b.children)
  } else {
    if is_empty(xs: b.children) {
      false
    } else {
      a.kind == b.kind
        && zip_eq(
          a: a.children,
          b: b.children,
          eq: fn(ea, eb) { edges_match(ea: ea, eb: eb) }
        )
    }
  }
}

// Congruent AND actually different: same skeleton, differing at >=1 leaf. (Reuses
// the std structural-equality authority; identical steps are pure duplication, a
// different smell, so they are not flagged here.)
fn pair_is_unrolled(later: Node, earlier: Node) -> Bool {
  congruent(a: earlier, b: later)
    && !exact_structural_equality_zip_fold(source_facts: earlier, candidate: later)
}

// A chain is a SIMULATED RELATIONSHIP iff every adjacent pair is unrolled.
// `< 3` steps is not yet a relationship. Adjacency is `skip(1)` zipped against the
// original as a prefix: prefix[i] = steps[i+1] is paired with steps[i], and the
// shorter prefix stops cleanly without a length-mismatch false.
fn chain_is_simulated(steps: FreeMonoid<Node>) -> Bool {
  if length(xs: steps) < 3 {
    false
  } else {
    is_prefix_of(
      prefix: skip(xs: steps, n: 1),
      xs: steps,
      eq: fn(later, earlier) { pair_is_unrolled(later: later, earlier: earlier) }
    )
  }
}

fn chain_is_simulated_canonical(steps: FreeMonoid<Node>) -> Bool {
  chain_is_simulated(steps: steps)
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding {
    grounding_authority: "the parse/resolve walk that projects a body's statement chain into List<Node> (shared with v2.lens.structural_similarity)",
    dissolve_on: "congruent + chain_is_simulated run over live dsl/** statement chains once the parse/resolve walk produces per-body Node-chain facts; until then this is a lens_unit predicate over synthetic Node chains"
  },
  rationale: "Congruence of statement subtrees is decidable (a wall): a hand-unrolled fold is a chain whose adjacent statements share one skeleton differing only at leaf data slots. The undecidable residue (callee-position-only variance, interleaved strides, whether the variance is semantically a list) stays a ratchet, not a wall."
}
