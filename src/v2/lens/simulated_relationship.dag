module v2.lens.simulated_relationship
import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }
import std.disposition { SingleAuthority }

import v2.std.node { Node }
import v2.std.algebra { FreeMonoid, length }
import v2.std.anti_unification {
  ChainGeneralization, anti_unify_chain, template_has_hole, fillings_all_leaves
}
import v2.std.logic { Bool }

fn chain_is_simulated(steps: FreeMonoid<Node>) -> Bool {
  if length(xs: steps) < 3 {
    false
  } else {
    chain_generalization_is_fold(g: anti_unify_chain(steps: steps))
  }
}

fn chain_generalization_is_fold(g: ChainGeneralization) -> Bool {
  template_has_hole(template: g.template)
    && fillings_all_leaves(per_element: g.per_element)
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SingleAuthority },
  rationale: "Simulation of a fold is decidable (a wall): the anti-unification kernel produces the whole-chain template + per-element fillings, and a hand-unrolled fold is exactly a chain whose template holds variance only at leaf data slots. The undecidable residue (callee-position-only variance, interleaved strides, whether the variance is semantically a list) stays a ratchet, not a wall. Grounding authority: the parse/resolve walk that projects a body's statement chain into List<Node> (shared with v2.lens.structural_similarity) Dissolves on: chain_is_simulated run over live dsl/** statement chains once the parse/resolve walk produces per-body Node-chain facts; until then this is a lens_unit predicate over synthetic Node chains"
}
