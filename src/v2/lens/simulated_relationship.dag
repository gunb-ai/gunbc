module v2.lens.simulated_relationship
import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }

import v2.std.node { Node, Edge }
import v2.std.algebra { FreeMonoid, is_empty, length, skip, zip_eq, is_prefix_of }
import v2.std.exact_structural_equality_zip_fold_predicate { exact_structural_equality_zip_fold }
import v2.std.logic { Bool }


fn edges_match(ea: Edge, eb: Edge) -> Bool {
  ea.label == eb.label && congruent(a: ea.target, b: eb.target)
}

fn congruent(a: Node, b: Node) -> Bool {
  if is_empty(xs: a.children) {
    is_empty(xs: b.children)
  } else {
    if is_empty(xs: b.children) {
      false
    } else {
      a.kind == b.kind
        && zip_eq(
          a: a.children,
          b: b.children,
          eq: fn(ea, eb) { edges_match(ea: ea, eb: eb) }
        )
    }
  }
}

fn pair_is_unrolled(later: Node, earlier: Node) -> Bool {
  congruent(a: earlier, b: later)
    && !exact_structural_equality_zip_fold(source_facts: earlier, candidate: later)
}

fn chain_is_simulated(steps: FreeMonoid<Node>) -> Bool {
  if length(xs: steps) < 3 {
    false
  } else {
    is_prefix_of(
      prefix: skip(xs: steps, n: 1),
      xs: steps,
      eq: fn(later, earlier) { pair_is_unrolled(later: later, earlier: earlier) }
    )
  }
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding {
    grounding_authority: "the parse/resolve walk that projects a body's statement chain into List<Node> (shared with v2.lens.structural_similarity)",
    dissolve_on: "congruent + chain_is_simulated run over live dsl/** statement chains once the parse/resolve walk produces per-body Node-chain facts; until then this is a lens_unit predicate over synthetic Node chains"
  },
  rationale: "Congruence of statement subtrees is decidable (a wall): a hand-unrolled fold is a chain whose adjacent statements share one skeleton differing only at leaf data slots. The undecidable residue (callee-position-only variance, interleaved strides, whether the variance is semantically a list) stays a ratchet, not a wall."
}
