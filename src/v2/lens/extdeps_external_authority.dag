module v2.lens.extdeps_external_authority
import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }
import std.disposition { SubstrateMandatoryTag, SingleAuthority }

import extdeps.uri {
  Http,
  Https,
  File,
  Ftp,
  UriScheme,
  uri_scheme_is_http
}
import v2.std.algebra {
  filter,
  fold_list,
  is_empty,
  length,
  list_snoc_item
}
import v2.std.collection { List, Optional, Present, Absent }
import v2.std.logic { Bool }
import v2.std.qualified_name { QualifiedName }
import v2.std.text { String }

type ExtdepsExternalAuthorityAnchorStatus
  = AnchorAbsent
  | AnchorPresent { scheme_identity: String, locator: String }

type ExtdepsExternalAuthorityViolation
  = MissingFormalAnchor { module: QualifiedName }
  | UnrecognizedAnchorScheme { module: QualifiedName, raw_scheme: String }
  | NonExternalAnchorScheme { module: QualifiedName, raw_scheme: String }

data empty_extdeps_external_authority_violations: List<ExtdepsExternalAuthorityViolation> = []

type ExtdepsExternalAuthorityModuleFacts {
  anchor_kind: String
  scheme_identity: String
  locator: String
  is_backfill_pending: Bool
  is_machinery_exempt: Bool
  is_clean_tree_roster_excluded: Bool
  anchor_shadow_masked: Bool
}

fn anchor_kind_is_absent(kind: String) -> Bool {
  kind == "absent"
}

fn anchor_kind_is_present(kind: String) -> Bool {
  kind == "present"
}

fn decode_uri_scheme(raw: String) -> Optional<UriScheme> {
  match raw {
    "Http" => Present { value: Http }
    "Https" => Present { value: Https }
    "File" => Present { value: File }
    "Ftp" => Present { value: Ftp }
    _ => Absent
  }
}

fn extdeps_external_authority_status_for_module(
  module: QualifiedName
) -> ExtdepsExternalAuthorityAnchorStatus {
  let facts = extdeps_external_authority_facts_for_qualified_name(module: module)
  if anchor_kind_is_absent(kind: facts.anchor_kind) {
    AnchorAbsent
  } else {
    AnchorPresent {
      scheme_identity: facts.scheme_identity,
      locator: facts.locator
    }
  }
}

fn extdeps_external_authority_is_anchor_machinery_exempt(module: QualifiedName) -> Bool {
  extdeps_external_authority_facts_for_qualified_name(module: module).is_machinery_exempt
}

fn extdeps_external_authority_is_backfill_pending(module: QualifiedName) -> Bool {
  extdeps_external_authority_facts_for_qualified_name(module: module).is_backfill_pending
}

fn extdeps_external_authority_is_clean_tree_roster_excluded(module: QualifiedName) -> Bool {
  extdeps_external_authority_facts_for_qualified_name(module: module).is_clean_tree_roster_excluded
}

fn extdeps_external_authority_anchor_shadow_masked(module: QualifiedName) -> Bool {
  extdeps_external_authority_facts_for_qualified_name(module: module).anchor_shadow_masked
}

fn scheme_violations_for_present_anchor(
  module: QualifiedName,
  raw: String
) -> List<ExtdepsExternalAuthorityViolation> {
  match decode_uri_scheme(raw: raw) {
    Absent => [
      UnrecognizedAnchorScheme { module: module, raw_scheme: raw }
    ]
    Present { value: scheme } =>
      if uri_scheme_is_http(s: scheme) {
        empty_extdeps_external_authority_violations
      } else {
        [
          NonExternalAnchorScheme { module: module, raw_scheme: raw }
        ]
      }
  }
}

fn extdeps_external_authority_violations_for_module(
  module: QualifiedName
) -> List<ExtdepsExternalAuthorityViolation> {
  match extdeps_external_authority_status_for_module(module: module) {
    AnchorAbsent => [
      MissingFormalAnchor { module: module }
    ]
    AnchorPresent { scheme_identity: raw, locator: _ } =>
      scheme_violations_for_present_anchor(module: module, raw: raw)
  }
}

fn extdeps_external_authority_live_violations_for_module(
  module: QualifiedName
) -> List<ExtdepsExternalAuthorityViolation> {
  match extdeps_external_authority_status_for_module(module: module) {
    AnchorAbsent =>
      if extdeps_external_authority_is_anchor_machinery_exempt(module: module) {
        empty_extdeps_external_authority_violations
      } else if extdeps_external_authority_is_backfill_pending(module: module) {
        empty_extdeps_external_authority_violations
      } else {
        [
          MissingFormalAnchor { module: module }
        ]
      }
    AnchorPresent { scheme_identity: raw, locator: _ } =>
      if extdeps_external_authority_is_anchor_machinery_exempt(module: module) {
        empty_extdeps_external_authority_violations
      } else if extdeps_external_authority_is_backfill_pending(module: module) {
        empty_extdeps_external_authority_violations
      } else {
        scheme_violations_for_present_anchor(module: module, raw: raw)
      }
  }
}

fn extdeps_external_authority_violation_count_for_module(module: QualifiedName) -> Int {
  length(xs: extdeps_external_authority_violations_for_module(module: module))
}

fn extdeps_external_authority_live_violation_count_for_module(module: QualifiedName) -> Int {
  length(xs: extdeps_external_authority_live_violations_for_module(module: module))
}

fn extdeps_external_authority_clean_for_module(module: QualifiedName) -> Bool {
  extdeps_external_authority_violation_count_for_module(module: module) == 0
}

fn extdeps_external_authority_live_clean_for_module(module: QualifiedName) -> Bool {
  extdeps_external_authority_live_violation_count_for_module(module: module) == 0
}

fn scan_extdeps_external_authority_modules(
  modules: List<QualifiedName>
) -> List<ExtdepsExternalAuthorityViolation> {
  fold_list(
    xs: modules,
    empty: empty_extdeps_external_authority_violations,
    cons: fn(acc, mod_qn) {
      fold_list(
        xs: extdeps_external_authority_live_violations_for_module(module: mod_qn),
        empty: acc,
        cons: fn(inner, v) { list_snoc_item(xs: inner, item: v) }
      )
    }
  )
}

fn extdeps_external_authority_clean_holds(modules: List<QualifiedName>) -> Bool {
  is_empty(xs: scan_extdeps_external_authority_modules(modules: modules))
}

fn extdeps_external_authority_violation_count(modules: List<QualifiedName>) -> Int {
  length(xs: scan_extdeps_external_authority_modules(modules: modules))
}

fn extdeps_external_authority_has_missing_formal_anchor(
  module: QualifiedName
) -> Bool {
  let facts = extdeps_external_authority_facts_for_qualified_name(module: module)
  extdeps_external_authority_violation_count_for_module(module: module) == 1
    && anchor_kind_is_absent(kind: facts.anchor_kind)
}

fn extdeps_external_authority_has_missing_formal_anchor_via_live_policy(
  module: QualifiedName
) -> Bool {
  let facts = extdeps_external_authority_facts_for_qualified_name(module: module)
  extdeps_external_authority_live_violation_count_for_module(module: module) == 1
    && anchor_kind_is_absent(kind: facts.anchor_kind)
}

fn extdeps_external_authority_has_unrecognized_scheme(
  module: QualifiedName
) -> Bool {
  match extdeps_external_authority_status_for_module(module: module) {
    AnchorPresent { scheme_identity: raw, locator: _ } =>
      match decode_uri_scheme(raw: raw) {
        Absent => true
        Present { value: _ } => false
      }
    _ => false
  }
}

fn extdeps_external_authority_has_non_external_scheme(
  module: QualifiedName
) -> Bool {
  extdeps_external_authority_violation_count_for_module(module: module) == 1
    && match extdeps_external_authority_status_for_module(module: module) {
      AnchorPresent { scheme_identity: raw, locator: _ } =>
        match decode_uri_scheme(raw: raw) {
          Present { value: scheme } => !uri_scheme_is_http(s: scheme)
          Absent => false
        }
      _ => false
    }
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SubstrateMandatoryTag }
}

data shadow_mask_construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: SingleAuthority }
}
