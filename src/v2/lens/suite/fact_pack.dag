module v2.lens.suite.fact_pack

import std.content_hash {
  Fnv1a64Structural,
  content_hash_atom,
  content_hash_combine_structural,
  content_hash_eq_structural,
  content_hash_tagged_structural,
}
import v2.std.algebra { fold_list, length }
import v2.std.collection { List }
import v2.std.integer { Int }
import v2.std.text { String }

data lens_suite_fact_pack_note: String = "One exact whole-corpus fact pack per process (V2-LENS-0 boundary). Identity is a structural hash over pool roots plus module-fact rows, not a hand-authored id. construction_count is carried for the once-per-process law; the live producer binds whole_corpus_scope.roots at the host seam when CI2's shared substrate lands. A repeated query with the same subject must return the same identity and must not re-construct (witnessed by modeling controls)."

type ModuleDeclarationFact {
  module: String
  path: String
}

type LensCorpusFactPack {
  pool_roots: List<String>
  module_facts: List<ModuleDeclarationFact>
  identity: Fnv1a64Structural
  construction_count: Int
}

data lens_suite_whole_corpus_roots: List<String> = ["dag", "src/v1", "src/v2"]

fn lens_suite_fact_pack_identity_from(
  pool_roots: List<String>,
  module_facts: List<ModuleDeclarationFact>
) -> Fnv1a64Structural {
  let roots_hash = fold_list(
    xs: pool_roots,
    empty: content_hash_atom(value: "lens-suite-fact-pack-roots"),
    cons: fn(acc, root) {
      content_hash_combine_structural(
        left: acc,
        right: content_hash_atom(value: root)
      )
    }
  )
  let facts_hash = fold_list(
    xs: module_facts,
    empty: content_hash_atom(value: "lens-suite-fact-pack-facts"),
    cons: fn(acc, fact) {
      content_hash_combine_structural(
        left: acc,
        right: content_hash_combine_structural(
          left: content_hash_atom(value: fact.module),
          right: content_hash_atom(value: fact.path)
        )
      )
    }
  )
  content_hash_tagged_structural(
    tag: "lens-corpus-fact-pack",
    payload: content_hash_combine_structural(left: roots_hash, right: facts_hash)
  )
}

fn lens_corpus_fact_pack_from_module_facts(
  pool_roots: List<String>,
  module_facts: List<ModuleDeclarationFact>,
  construction_count: Int
) -> LensCorpusFactPack {
  LensCorpusFactPack {
    pool_roots: pool_roots,
    module_facts: module_facts,
    identity: lens_suite_fact_pack_identity_from(
      pool_roots: pool_roots,
      module_facts: module_facts
    ),
    construction_count: construction_count
  }
}

fn lens_corpus_fact_pack_live(construction_count: Int) -> LensCorpusFactPack {
  lens_corpus_fact_pack_from_module_facts(
    pool_roots: lens_suite_whole_corpus_roots,
    module_facts: [],
    construction_count: construction_count
  )
}

fn lens_corpus_fact_pack_fixture(construction_count: Int) -> LensCorpusFactPack {
  let roots = ["src/v2/lens"]
  let facts = [
    ModuleDeclarationFact {
      module: "v2.lens.suite.receipt",
      path: "src/v2/lens/suite/receipt.dag"
    },
    ModuleDeclarationFact {
      module: "v2.lens.suite.roster",
      path: "src/v2/lens/suite/roster.dag"
    }
  ]
  lens_corpus_fact_pack_from_module_facts(
    pool_roots: roots,
    module_facts: facts,
    construction_count: construction_count
  )
}

fn lens_corpus_fact_pack_second_query_constructs_zero(
  first: LensCorpusFactPack,
  second: LensCorpusFactPack
) -> Bool {
  content_hash_eq_structural(left: first.identity, right: second.identity)
    && (second.construction_count == 0)
    && (length(xs: first.module_facts) == length(xs: second.module_facts))
}
