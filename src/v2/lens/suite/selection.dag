module v2.lens.suite.selection

import v2.lens.registry {
  Determinism,
  LensIdV0,
  LensRegistryEntryV0,
  lens_id_v0_eq,
  lens_registry_entry_bound,
  lens_registry_v0,
}
import v2.std.algebra { fold_list }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.optional { Absent, Optional, Present }

data lens_suite_boring_selection_note: String = "Checkpoint A boring-lens selection is MECHANICAL: scan lens_registry_v0 in registry order and take the first bound row whose LensIdV0 carries a LensSuiteBoringProfile with hermetic_tree_grain, no host effect, no base-revision graph, and small fact input (operator ruling 2026-08-09). The profile table is the only authored surface; the chosen id is never hand-picked. Determinism is the seed profile — tree-grain compile gate, SubstrateInputsOnly at witness grain, no corpus live-read in the gate body."

type LensSuiteBoringProfile {
  lens_id: LensIdV0
  hermetic_tree_grain: Bool
  host_effect: Bool
  base_revision_graph: Bool
  small_fact_input: Bool
}

data lens_suite_boring_profile_determinism: LensSuiteBoringProfile = LensSuiteBoringProfile {
  lens_id: Determinism
  hermetic_tree_grain: true
  host_effect: false
  base_revision_graph: false
  small_fact_input: true
}

data lens_suite_boring_profiles: List<LensSuiteBoringProfile> = [
  lens_suite_boring_profile_determinism
]

fn lens_suite_boring_profile_for(lens_id: LensIdV0) -> Optional<LensSuiteBoringProfile> {
  fold_list(
    xs: lens_suite_boring_profiles,
    empty: Absent,
    cons: fn(acc, boring_profile) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          if lens_id_v0_eq(left: boring_profile.lens_id, right: lens_id) {
            Present { value: boring_profile }
          } else {
            Absent
          }
      }
    }
  )
}

fn lens_suite_profile_is_boring_checkpoint(boring_profile: LensSuiteBoringProfile) -> Bool {
  boring_profile.hermetic_tree_grain
    && !boring_profile.host_effect
    && !boring_profile.base_revision_graph
    && boring_profile.small_fact_input
}

fn lens_suite_entry_is_boring_checkpoint(entry: LensRegistryEntryV0) -> Bool {
  if !lens_registry_entry_bound(entry: entry) {
    false
  } else {
    match lens_suite_boring_profile_for(lens_id: entry.lens_id) {
      Present { value: boring_profile } => lens_suite_profile_is_boring_checkpoint(boring_profile: boring_profile)
      Absent => false
    }
  }
}

fn lens_suite_boring_checkpoint_lens_id() -> Optional<LensIdV0> {
  fold_list(
    xs: lens_registry_v0,
    empty: Absent,
    cons: fn(acc, entry) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          if lens_suite_entry_is_boring_checkpoint(entry: entry) {
            Present { value: entry.lens_id }
          } else {
            Absent
          }
      }
    }
  )
}

fn lens_suite_boring_checkpoint_is_determinism() -> Bool {
  match lens_suite_boring_checkpoint_lens_id() {
    Present { value: id } => lens_id_v0_eq(left: id, right: Determinism)
    Absent => false
  }
}

fn lens_suite_boring_lens_mechanically_selected() -> Bool {
  lens_suite_boring_checkpoint_is_determinism()
}
