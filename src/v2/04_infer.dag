  item_registry: Map<String, ItemInfo>
}

type InferResult {
  typed: Node
  diagnostics: List<ErrorNode>
}

type BlockInferState {
  scope: InferScope
  diag_chunks: List<List<ErrorNode>>
  last_type: Node
  typed_stmts: List<Node>
}

// SG-9: Tail-recursive block inference. Each accumulated list is a standalone
// parameter (Rc refcount=1) so list_push avoids deep clone.
fn infer_block_stmts(remaining: List<Node>, remaining_count: Int, scope: InferScope,
    typed_stmts: List<Node>, diag_chunks: List<List<ErrorNode>>,
    last_type: Node, expected: Node?) -> BlockInferState {
  match remaining |> first {
    None => BlockInferState { scope: scope, diag_chunks: diag_chunks,
                              last_type: last_type, typed_stmts: typed_stmts }
    Some { value: stmt } =>
      let is_last = remaining_count == 1
      let stmt_expected = if is_last { expected } else { none }
      let stmt_result = infer_expr(texpr: stmt, scope: scope, expected: stmt_expected)
      let stmt_typed = stmt_result.typed
      let stmt_diags = stmt_result.diagnostics
      let stmt_rt = rt_type(n: stmt_typed)
      let next_scope = scope_after_stmt_node(
        stmt: stmt,
        stmt_type: stmt_rt,
        scope: scope
      )
      infer_block_stmts(
        remaining: remaining |> skip(1),
        remaining_count: remaining_count - 1,
        scope: next_scope,
        typed_stmts: list_push(typed_stmts, stmt_typed),
        diag_chunks: list_push(diag_chunks, stmt_diags),
        last_type: stmt_rt,
        expected: expected
      )
  }
}

