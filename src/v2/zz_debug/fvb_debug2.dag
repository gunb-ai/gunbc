module v2.zz_debug.fvb_debug2

import std.process { ProcessExit, exit_failure }
import v2.compiler.compile { native_test_context_from_ingest }
import v2.compiler.reference_conservation_admission { conserved_normalize_of_text, no_explained_drops }
import v2.std.algebra { fold_list }
import v2.std.compilers.lexing { symbol_lexeme }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.text { String }
import v2.test.claim.body_lowering.function_value_body_route {
  FvbEmitRefused, FvbEmitted, fvb_emit_verdict, fvb_ingest
}

fn fvb_norm(label: String, src: String) -> String {
  match conserved_normalize_of_text(path: "fvb_probe_file", text: src, explained: no_explained_drops()) {
    Accepted { value: _, diagnostics: _ } => label + "=ok; "
    Rejected { diagnostics: d } => label + "=" + symbol_lexeme(sym: d.head.reason) + "; "
  }
}

fn fvb_debug2() -> String {
  let refusals = match native_test_context_from_ingest(ingest: fvb_ingest) {
    Rejected { diagnostics: d } => "ctx refused " + symbol_lexeme(sym: d.head.reason)
    Accepted { value: ctx, diagnostics: _ } =>
      fold_list(xs: ctx.file_refusals, empty: "file_refusals:", cons: fn(acc, r) {
        acc + " [" + symbol_lexeme(sym: r.path) + " head=" + symbol_lexeme(sym: r.head_reason) + " fatal=" + symbol_lexeme(sym: r.fatal_reason) + "]"
      })
  }
  let norms =
    fvb_norm(label: "A_typed_literal_fn_type_ret", src: "module m.t\nfn f(p: Bool) -> fn(Bool) -> Bool { fn(q: Bool) -> Bool { p } }\n")
    + fvb_norm(label: "B_untyped_literal_fn_type_ret", src: "module m.t\nfn f(p: Bool) -> fn(Bool) -> Bool { fn(q) { p } }\n")
    + fvb_norm(label: "C_typed_literal_multiline", src: "module m.t\nfn f(p: Bool) -> fn(Bool) -> Bool {\n  fn(q: Bool) -> Bool { p }\n}\n")
    + fvb_norm(label: "D_emit_src", src: "module m.t\nfn f(p: Bool) -> fn(Bool) -> fn(Bool) -> Bool { x => y => x }\n")
  let emit = match fvb_emit_verdict() {
    FvbEmitted { text: t } => "emit=OK " + t
    FvbEmitRefused { reason: r } => "emit refused " + symbol_lexeme(sym: r)
  }
  refusals + " || " + norms + " || " + emit
}

fn fvb_debug2_exit() -> ProcessExit {
  exit_failure(reason: fvb_debug2())
}
