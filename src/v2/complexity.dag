// v2 complexity analysis -- cost algebra and proof vocabulary.
//
// Defines the symbolic types for runtime complexity analysis of DAG
// execution structure. The analyzer walks authoritative program structure
// and produces symbolic cost terms. Program IR and cost IR are separate:
// these types are proof objects, not program nodes.
//
// Two metrics are first-class:
//   work  -- total operations performed
//   span  -- critical path length under DAG dependency structure
//
// D2: get_or_compute_summary -- lazy cached summary computation
// D4: build_complexity_report -- collect summaries + violations

module v2.compiler.complexity

import std.types { SourceSpan }
import v2.compiler.emit { to_string }
import v2.compiler.parse {
  ParserResultWitness,
  ParserWitnessAdvance, ParserWitnessExpect, ParserWitnessEat, ParserWitnessCall, ParserWitnessOpaque,
  ParserCallHelper, ParserCallFunction,
  parser_progress_flag_var, parser_passthrough_state_expr, parser_result_witness
}
import v2.std.core {
  Node,
  ExprData,
  ExprLiteral, ExprError, ExprVar, ExprFieldAccess, ExprCall, ExprMethodCall,
  ExprBinOp, ExprUnaryOp, BinOp, Sub, Div,
  ExprMatch, ExprIf, ExprLet, ExprRecordLit, ExprBlock, ExprForEach, ExprReturn,
  MatchPattern, Bind, VariantPattern,
  field_init_node_name, field_init_node_value,
  arg_name, arg_value, arm_body, arm_guard, arm_pattern,
  MethodSemantics, AlgebraMethodSemantics,
  PlainMethodSemantics, ServiceMethodSemantics,
  binop_left, binop_right,
  field_binding_name, field_binding_pattern,
  foreach_collection, foreach_body,
  if_condition, if_then_branch, if_else_branch,
  let_value, let_body, let_binding_name,
  match_scrutinee, match_arm_nodes,
  method_receiver, method_arg_nodes, param_node_name, param_node_type_expr, return_value,
  expr_call_func, expr_var_name, field_access_base, field_access_field,
  LiteralValue, LitNull, LitInt,
  is_child_accessor_in_model
}

// =========================================================================
// Size expressions -- symbolic sizes for analysis
//
// A SizeExpr represents a symbolic size: a constant, a named variable
// (n, m, k), the length of a named collection, or arithmetic over
// sizes. Used as loop bounds, collection cardinalities, and cost
// function arguments.
// =========================================================================

type SizeExpr
  = SizeConst { value: Int }
  | SizeVar { name: String }
  | SizeLen { collection: String }
  | SizeAdd { left: SizeExpr, right: SizeExpr }
  | SizeMax { left: SizeExpr, right: SizeExpr }

// =========================================================================
// Cost expressions -- symbolic costs
//
// A CostExpr represents the cost of a computation symbolically.
// Supports constant costs, arithmetic composition, bounded summation
// (for loops), parameterized primitive costs (for backend-specific
// operation costs), and Unknown (when the system cannot prove a
// tighter bound).
//
// =========================================================================

type CostExpr
  = CostConst { value: Int }
  | CostAdd { left: CostExpr, right: CostExpr }
  | CostMul { left: CostExpr, right: CostExpr }
  | CostMax { left: CostExpr, right: CostExpr }
  | CostSum { binder: String, upper: SizeExpr, body: CostExpr }
  | CostLog { base: Int, argument: SizeExpr }
  | CostUnknown { reason: String }

// =========================================================================
// Certainty of a proof
//
// Proven      -- the bound is exact or tight under stated assumptions.
// Conservative -- the bound is valid but may not be tight.
// Unknown     -- the system could not derive a useful bound.
// =========================================================================

type Certainty = Proven | Conservative | Unknown

// =========================================================================
// Emission cost shape -- single authority on method cost structure
//
// Every IntrinsicMethod has exactly one CostShape, computed by
// intrinsic_method_cost_shape. Adding a new IntrinsicMethod variant
// without a CostShape causes an exhaustive match failure.
//
// Shapes:
//   ShapeConstant      -- O(1) regardless of input size
//   ShapeLinearScan    -- O(|receiver|) with O(1) per element (count, join)
//   ShapeIterateBody   -- O(|receiver| * body_cost) (map, filter, fold)
//   ShapeSortBody      -- O(|receiver| * body_cost), Conservative (sort_by)
//   produces_collection -- whether the method outputs a collection
// =========================================================================

type CostShape
  = ShapeConstant
  | ShapeLinearScan { produces_collection: Bool }
  | ShapeIterateBody { produces_collection: Bool }
  | ShapeSortBody

// Data table: method name -> cost shape. Single authority on what cost
// structure each algebra method has. Adding a method's cost = one line here.
// Methods not in this table are assumed O(1) (bridge methods).
data method_cost_shape_table: Map<String, CostShape> = {
  "map": ShapeIterateBody { produces_collection: true },
  "flat_map": ShapeIterateBody { produces_collection: true },
  "filter": ShapeIterateBody { produces_collection: true },
  "enumerate": ShapeIterateBody { produces_collection: true },
  "skip": ShapeIterateBody { produces_collection: true },
  "take": ShapeIterateBody { produces_collection: true },
  "fold": ShapeIterateBody { produces_collection: false },
  "any": ShapeIterateBody { produces_collection: false },
  "all": ShapeIterateBody { produces_collection: false },
  "sort_by": ShapeSortBody,
  "count": ShapeLinearScan { produces_collection: false },
  "first": ShapeLinearScan { produces_collection: false },
  "last": ShapeLinearScan { produces_collection: false },
  "join": ShapeLinearScan { produces_collection: false },
  "string_contains": ShapeLinearScan { produces_collection: false },
  "concat": ShapeLinearScan { produces_collection: false },
  "chars": ShapeLinearScan { produces_collection: true },
  "split": ShapeLinearScan { produces_collection: true },
  "append": ShapeConstant
}

// Look up a method's cost shape from the data table.
fn method_cost_shape(method_name: String) -> CostShape? {
  lookup(method_cost_shape_table, key: method_name)
}

// Child accessor identity is now derived from the IR child layout model
// in 00_core.dag (expr_child_roles / wrapper_child_roles). The hardcoded
// child_accessor_table has been deleted — use is_child_accessor_in_model()
// imported from v2.std.core instead.

// =========================================================================
// Complexity summary -- the main output type
//
// Attaches to a function, expression, or DAG node to describe its
// runtime behavior:
//
//   work        -- total operations (sequential cost)
//   span        -- critical path (parallel cost)
//   output_size -- symbolic size of each named output
//   certainty   -- how confident the proof is
//
// The reporting rule: compute exact symbolic formulas first, then
// derive asymptotic summaries from those formulas.
// =========================================================================

type ComplexitySummary {
  work: CostExpr
  span: CostExpr
  output_size: Map<String, CostExpr>
  certainty: Certainty
}

// =========================================================================
// D2: Cost intern table -- lazy + cached complexity analysis
//
// CostExpr trees can grow exponentially during composition. The intern
// table deduplicates structurally identical subtrees via hash-consing.
// Summaries are cached per function name for lazy on-demand computation.
//
// Usage: thread CostInternTable through analysis calls. Each call may
// return an updated table with new cache entries.
// =========================================================================

type CostInternTable {
  // func_name → cached summary (lazy computation)
  summaries: Map<String, ComplexitySummary>
}

fn empty_intern_table() -> CostInternTable {
  CostInternTable { summaries: empty_map() }
}

// Cache a complexity summary for a function.
fn cache_summary(table: CostInternTable, func_name: String, summary: ComplexitySummary) -> CostInternTable {
  CostInternTable {
    summaries: map_insert(table.summaries, func_name, summary)
  }
}

// Lookup a cached summary. Returns None if not yet computed.
fn lookup_summary(table: CostInternTable, func_name: String) -> ComplexitySummary? {
  map_get(table.summaries, func_name)
}

// =========================================================================
// D3: DAG composition rules
//
// Compose complexity summaries over call graph structure.
// Each rule corresponds to a DAG pattern:
//   sequential  → cost_add
//   parallel    → cost_max (for span)
//   loop        → cost_mul(iterations, body)
//   conditional → condition + cost_max(branches)
//   recursive   → pattern-match on SCC structure
// =========================================================================

type RecursionPattern
  = LinearRecursion { iteration_var: String }
  | DivideAndConquer { split_factor: Int }
  | UnresolvableRecursion { reason: String }

type CallEdge {
  caller: String
  callee: String
}

type CallGraph {
  forward: Map<String, List<String>>
  reverse: Map<String, List<String>>
}

type CallGraphAcc {
  forward: Map<String, List<String>>
  reverse: Map<String, List<String>>
}

type SccInfo {
  members: List<String>
  member_set: Map<String, Bool>
  pattern: RecursionPattern
}

type SccBuildAcc {
  assigned: Map<String, Bool>
  index: Map<String, SccInfo>
}

type DfsFinishAcc {
  visited: Map<String, Bool>
  order: List<String>
}

type SccComponentAcc {
  visited: Map<String, Bool>
  members: List<String>
}

type SccCycleAcc {
  visited: Map<String, Bool>
  has_cycle: Bool
}

type ParserStateParam {
  name: String
  index: Int
}

type ProgressKind = ProgressUnknown | ProgressSame | ProgressStrict

type ParserResultSource
  = ParserResultAdvance { input: ProgressKind }
  | ParserResultExpect { input: ProgressKind }
  | ParserResultEat { input: ProgressKind }
  | ParserResultCall { input: ProgressKind, callee: String }
  | ParserResultOpaque

type ParserProgressEdge {
  caller: String
  callee: String
  progress: ProgressKind
}

type ParserProgressEnv {
  state_aliases: Map<String, ProgressKind>
  result_sources: Map<String, ParserResultSource>
}

type ParserProgressAcc {
  edges: List<ParserProgressEdge>
  env: ParserProgressEnv
}

// =========================================================================
// Well-founded descent model (grounded in std/termination.dag)
//
// These types formalize the termination proof structure. They replace
// the ad-hoc pattern-matching approach with a universal framework:
//   - DescentEvidence: what happens to a ranking at one call edge
//   - RankingDimension: what's being measured for descent
//   - DescentSource: HOW descent is witnessed at a call site
//   - TerminationProof: lexicographic ordering over dimensions
//   - ProofEdge: evidence per dimension per call edge
//
// Migration: defined locally until bootstrap is green. The canonical
// definitions live in dsl/std/termination.dag. After bootstrap, these
// local definitions must be replaced with imports from std.termination
// to eliminate the duplication (no duplicate representations invariant).
// =========================================================================

type DescentEvidence
  = Strict           // value provably decreases
  | NonIncreasing    // value does not increase (same or smaller)
  | DescentUnknown   // cannot determine (fail-closed)

// Bootstrap constraint: `param` is a function parameter name (String).
// .dag does not yet have first-class param references. When it does,
// param should become a structural reference into the function's param list.
type RankingDimension
  = TreeSize { param: String }           // |subtree| via child accessor
  | ListLength { param: String }         // |list| via skip/tail
  | ArithmeticValue { param: String }    // integer via n-1, n/2
  | TokenPosition { param: String }      // parser state.position
  | SetCardinality { param: String }     // |set| via remove

// Bootstrap constraint: accessor/op/witness/element are function or operator
// names (String). These are structural identities in the current .dag type
// system — the name IS the identity. When .dag supports function references,
// these fields should become structural references.
type DescentSource
  = ChildAccessor { accessor: String }
  | ListShrink { amount: Int }
  | ArithmeticDecrease { op: String, by: Int }
  | ParserAdvance { witness: String }
  | SetRemoval { element: String }
  | FoldIteration

type TerminationProof {
  dimensions: List<RankingDimension>
}

// Bootstrap constraint: caller/callee are function names (String).
// These are structural identities in the current .dag type system.
// When .dag supports function references, these should become structural.
type ProofEdge {
  caller: String
  callee: String
  evidence: List<DescentEvidence>   // one per dimension, same order as proof.dimensions
}

// Accumulator for incremental descent checking (threads vars + result through body).
type DescentCheckAcc {
  ok: Bool
  vars: Map<String, Bool>
}

// Accumulator for incremental evidence collection in block statements.
type EvidenceBlockAcc {
  evidence: DescentEvidence?
  vars: Map<String, Bool>
}

// Structural classification of list methods relevant to descent proofs.
// Replaces raw method-name string dispatch with a closed enum.
type ListMethodKind
  = SkipMethod     // skip(N): drops first N elements, List shrinks by N
  | FirstMethod    // first: projects head element (descent from list to element)
  | LastMethod     // last: projects tail element (descent from list to element)

fn classify_list_method(name: String) -> ListMethodKind? {
  if name == "skip" { Some { value: SkipMethod } }
  else if name == "first" { Some { value: FirstMethod } }
  else if name == "last" { Some { value: LastMethod } }
  else { none }
}

// Merge two descent evidences (from two branches of if/match).
// Conservative: if EITHER branch is unknown, result is unknown.
// Lattice: DescentUnknown < NonIncreasing < Strict
fn merge_evidence(a: DescentEvidence, b: DescentEvidence) -> DescentEvidence {
  match a {
    Strict => match b {
      Strict => Strict
      NonIncreasing => NonIncreasing
      DescentUnknown => DescentUnknown
    }
    NonIncreasing => match b {
      DescentUnknown => DescentUnknown
      _ => NonIncreasing
    }
    DescentUnknown => DescentUnknown
  }
}

// Bridge: convert ProgressKind → DescentEvidence (migration aid)
fn progress_to_evidence(pk: ProgressKind) -> DescentEvidence {
  match pk {
    ProgressStrict => Strict
    ProgressSame => NonIncreasing
    ProgressUnknown => DescentUnknown
  }
}

// Bridge: convert DescentEvidence → ProgressKind (migration aid)
fn evidence_to_progress(de: DescentEvidence) -> ProgressKind {
  match de {
    Strict => ProgressStrict
    NonIncreasing => ProgressSame
    DescentUnknown => ProgressUnknown
  }
}

// Check if a lexicographic proof edge is descending:
// first Strict dimension wins; all higher dimensions must be NonIncreasing.
fn is_lexicographic_descent(evidence: List<DescentEvidence>) -> Bool {
  match evidence |> first {
    None => false  // no dimensions = no proof
    Some { value: e } =>
      match e {
        Strict => true
        NonIncreasing => is_lexicographic_descent(evidence: evidence |> skip(1))
        DescentUnknown => false
      }
  }
}

// Check if a set of proof edges forms a valid termination proof:
// the subgraph of non-descending edges (all dims NonIncreasing) must be acyclic.
fn proof_has_non_descending_cycle(members: List<String>, edges: List<ProofEdge>) -> Bool {
  let non_descending = edges |> filter(e => is_lexicographic_descent(evidence: e.evidence) == false)
  let nd_progress_edges = non_descending |> map(e =>
    ParserProgressEdge { caller: e.caller, callee: e.callee, progress: ProgressSame }
  )
  same_progress_subgraph_has_cycle(members: members, edges: nd_progress_edges)
}

// Check if a CostExpr contains a placeholder for a self-recursive call.
// The placeholder reason is "computing: <func_name>", inserted by
// get_or_compute_summary before walking the body.
fn cost_contains_computing_ref(expr: CostExpr, func_name: String) -> Bool {
  let target = concat("computing: ", func_name)
  match expr {
    CostUnknown { reason: r } => r == target
    CostAdd { left: l, right: r } =>
      cost_contains_computing_ref(expr: l, func_name: func_name)
      || cost_contains_computing_ref(expr: r, func_name: func_name)
    CostMul { left: l, right: r } =>
      cost_contains_computing_ref(expr: l, func_name: func_name)
      || cost_contains_computing_ref(expr: r, func_name: func_name)
    CostMax { left: l, right: r } =>
      cost_contains_computing_ref(expr: l, func_name: func_name)
      || cost_contains_computing_ref(expr: r, func_name: func_name)
    CostSum { binder: _, upper: _, body: b } =>
      cost_contains_computing_ref(expr: b, func_name: func_name)
    _ => false
  }
}

// Replace all CostUnknown placeholders for a self-recursive call with
// a replacement cost (typically CostConst { value: 0 } to extract
// per-iteration cost).
fn replace_computing_ref(expr: CostExpr, func_name: String, replacement: CostExpr) -> CostExpr {
  let target = concat("computing: ", func_name)
  match expr {
    CostUnknown { reason: r } =>
      if r == target { replacement } else { expr }
    CostAdd { left: l, right: r } =>
      CostAdd {
        left: replace_computing_ref(expr: l, func_name: func_name, replacement: replacement),
        right: replace_computing_ref(expr: r, func_name: func_name, replacement: replacement)
      }
    CostMul { left: l, right: r } =>
      CostMul {
        left: replace_computing_ref(expr: l, func_name: func_name, replacement: replacement),
        right: replace_computing_ref(expr: r, func_name: func_name, replacement: replacement)
      }
    CostMax { left: l, right: r } =>
      CostMax {
        left: replace_computing_ref(expr: l, func_name: func_name, replacement: replacement),
        right: replace_computing_ref(expr: r, func_name: func_name, replacement: replacement)
      }
    CostSum { binder: b, upper: u, body: bd } =>
      CostSum {
        binder: b,
        upper: u,
        body: replace_computing_ref(expr: bd, func_name: func_name, replacement: replacement)
      }
    _ => expr
  }
}

fn cost_contains_any_computing_ref(expr: CostExpr, func_names: List<String>) -> Bool {
  func_names |> any(name =>
    cost_contains_computing_ref(expr: expr, func_name: name)
  )
}

fn replace_computing_refs(expr: CostExpr, func_names: List<String>, replacement: CostExpr) -> CostExpr {
  func_names |> fold(init: expr, f: (acc, name) =>
    replace_computing_ref(expr: acc, func_name: name, replacement: replacement)
  )
}

fn set_has(m: Map<String, Bool>, key: String) -> Bool {
  map_get(m, key) != none
}

fn strict_progress(progress: ProgressKind) -> ProgressKind {
  match progress {
    ProgressSame => ProgressStrict
    ProgressStrict => ProgressStrict
    _ => ProgressUnknown
  }
}

fn merge_progress(a: ProgressKind, b: ProgressKind) -> ProgressKind {
  match a {
    ProgressUnknown => ProgressUnknown
    ProgressStrict =>
      match b {
        ProgressUnknown => ProgressUnknown
        ProgressStrict => ProgressStrict
        ProgressSame => ProgressSame
      }
    ProgressSame =>
      match b {
        ProgressUnknown => ProgressUnknown
        _ => ProgressSame
      }
  }
}

fn empty_parser_progress_env() -> ParserProgressEnv {
  ParserProgressEnv {
    state_aliases: empty_map(),
    result_sources: empty_map()
  }
}

fn parser_state_param(params: List<Node>) -> ParserStateParam? {
  params |> enumerate |> fold(init: none, f: (acc, pair) =>
    if acc != none {
      acc
    } else {
      let idx = pair.first
      let param = pair.second
      if param_node_type_expr(n: param).name == "ParserState" {
        Some { value: ParserStateParam { name: param_node_name(n: param), index: idx } }
      } else {
        none
      }
    }
  )
}

fn parser_state_base_var(expr: Node) -> String? {
  match expr.expr_data {
    ExprFieldAccess =>
      match expr.children |> first {
        Some { value: base } =>
          match base.expr_data {
            ExprVar { binding_kind: _ } => Some { value: expr_var_name(texpr: base) }
            _ => none
          }
        None => none
      }
    _ => none
  }
}

fn parser_result_state_progress(source: ParserResultSource, parser_always_advancing: Map<String, Bool>, consumed_true_set: Map<String, Bool>, result_name: String) -> ProgressKind {
  match source {
    ParserResultAdvance { input: input } => strict_progress(progress: input)
    ParserResultExpect { input: input } => strict_progress(progress: input)
    ParserResultEat { input: input } =>
      if set_has(m: consumed_true_set, key: result_name) {
        strict_progress(progress: input)
      } else {
        input
      }
    ParserResultCall { input: input, callee: callee } =>
      if set_has(m: consumed_true_set, key: result_name) || set_has(m: parser_always_advancing, key: callee) {
        strict_progress(progress: input)
      } else {
        input
      }
    ParserResultOpaque => ProgressUnknown
  }
}

fn parser_state_arg_expr(call_node: Node, state_param: ParserStateParam) -> Node? {
  call_node.children |> enumerate |> fold(init: none, f: (acc, pair) =>
    if acc != none {
      acc
    } else {
      let idx = pair.first
      let arg_node = pair.second
      let matches_state = if arg_name(n: arg_node) != "" {
        arg_name(n: arg_node) == state_param.name
      } else {
        idx == state_param.index
      }
      if matches_state {
        Some { value: arg_value(n: arg_node) }
      } else {
        none
      }
    }
  )
}

fn parser_state_expr_progress(expr: Node, state_param: ParserStateParam, env: ParserProgressEnv, parser_always_advancing: Map<String, Bool>, consumed_true_set: Map<String, Bool>) -> ProgressKind {
  match expr.expr_data {
    ExprVar { binding_kind: _ } =>
      let name = expr_var_name(texpr: expr)
      if name == state_param.name {
        ProgressSame
      } else {
        match map_get(env.state_aliases, name) {
          Some { value: progress } => progress
          None => ProgressUnknown
        }
      }

    ExprFieldAccess =>
      if field_access_field(texpr: expr) == "state" {
        match parser_state_base_var(expr: expr) {
          Some { value: result_name } =>
            match map_get(env.result_sources, result_name) {
              Some { value: source } =>
                parser_result_state_progress(
                  source: source,
                  parser_always_advancing: parser_always_advancing,
                  consumed_true_set: consumed_true_set,
                  result_name: result_name
                )
              None => ProgressUnknown
            }
          None => ProgressUnknown
        }
      } else {
        ProgressUnknown
      }

    ExprCall { call_semantics: _ } =>
      match parser_passthrough_state_expr(expr: expr) {
        Some { value: state_expr } =>
          parser_state_expr_progress(
            expr: state_expr,
            state_param: state_param,
            env: env,
            parser_always_advancing: parser_always_advancing,
            consumed_true_set: consumed_true_set
          )
        None => ProgressUnknown
      }

    ExprIf =>
      let cond = if_condition(texpr: expr)
      let then_consumed = match parser_progress_flag_var(expr: cond) {
        Some { value: name } => map_insert(consumed_true_set, name, true)
        None => consumed_true_set
      }
      let then_progress = parser_state_expr_progress(
        expr: if_then_branch(texpr: expr),
        state_param: state_param,
        env: env,
        parser_always_advancing: parser_always_advancing,
        consumed_true_set: then_consumed
      )
      let else_progress = match if_else_branch(texpr: expr) {
        Some { value: eb } =>
          parser_state_expr_progress(
            expr: eb,
            state_param: state_param,
            env: env,
            parser_always_advancing: parser_always_advancing,
            consumed_true_set: consumed_true_set
          )
        None => ProgressUnknown
      }
      merge_progress(a: then_progress, b: else_progress)

    ExprLet =>
      let next_env = parser_env_with_binding(
        name: let_binding_name(texpr: expr),
        value_expr: let_value(texpr: expr),
        env: env,
        state_param: state_param,
        parser_always_advancing: parser_always_advancing,
        consumed_true_set: consumed_true_set
      )
      match let_body(texpr: expr) {
        Some { value: body } =>
          parser_state_expr_progress(
            expr: body,
            state_param: state_param,
            env: next_env,
            parser_always_advancing: parser_always_advancing,
            consumed_true_set: consumed_true_set
          )
        None => ProgressUnknown
      }

    ExprMatch =>
      let arm_progresses = match_arm_nodes(texpr: expr) |> map(arm_node =>
        parser_state_expr_progress(
          expr: arm_body(n: arm_node),
          state_param: state_param,
          env: env,
          parser_always_advancing: parser_always_advancing,
          consumed_true_set: consumed_true_set
        )
      )
      match arm_progresses |> first {
        Some { value: initial } =>
          arm_progresses |> fold(init: initial, f: (acc, p) =>
            merge_progress(a: acc, b: p)
          )
        None => ProgressUnknown
      }

    _ => ProgressUnknown
  }
}

fn parser_result_source_for_expr(expr: Node, state_param: ParserStateParam, env: ParserProgressEnv, parser_always_advancing: Map<String, Bool>, consumed_true_set: Map<String, Bool>) -> ParserResultSource {
  match expr.expr_data {
    ExprCall { call_semantics: _ } =>
      let input_progress = match parser_state_arg_expr(call_node: expr, state_param: state_param) {
        Some { value: state_expr } =>
          parser_state_expr_progress(
            expr: state_expr,
            state_param: state_param,
            env: env,
            parser_always_advancing: parser_always_advancing,
            consumed_true_set: consumed_true_set
          )
        None => ProgressUnknown
      }
      match parser_result_witness(expr: expr) {
        ParserWitnessAdvance => ParserResultAdvance { input: input_progress }
        ParserWitnessExpect => ParserResultExpect { input: input_progress }
        ParserWitnessEat => ParserResultEat { input: input_progress }
        ParserWitnessCall { callee: callee } =>
          match callee {
            ParserCallHelper { helper: _ } => ParserResultOpaque
            ParserCallFunction { name: name } =>
              match input_progress {
                ProgressUnknown => ParserResultOpaque
                _ => ParserResultCall { input: input_progress, callee: name }
              }
          }
        ParserWitnessOpaque => ParserResultOpaque
      }
    _ => ParserResultOpaque
  }
}

fn parser_env_with_binding(name: String, value_expr: Node, env: ParserProgressEnv, state_param: ParserStateParam, parser_always_advancing: Map<String, Bool>, consumed_true_set: Map<String, Bool>) -> ParserProgressEnv {
  let state_progress = parser_state_expr_progress(
    expr: value_expr,
    state_param: state_param,
    env: env,
    parser_always_advancing: parser_always_advancing,
    consumed_true_set: consumed_true_set
  )
  let result_source = parser_result_source_for_expr(
    expr: value_expr,
    state_param: state_param,
    env: env,
    parser_always_advancing: parser_always_advancing,
    consumed_true_set: consumed_true_set
  )
  ParserProgressEnv {
    state_aliases: map_insert(env.state_aliases, name, state_progress),
    result_sources: map_insert(env.result_sources, name, result_source)
  }
}

fn parser_call_edge_progress(call_node: Node, state_param: ParserStateParam, env: ParserProgressEnv, parser_always_advancing: Map<String, Bool>, consumed_true_set: Map<String, Bool>) -> ProgressKind {
  match parser_state_arg_expr(call_node: call_node, state_param: state_param) {
    Some { value: state_expr } =>
      let input_progress = parser_state_expr_progress(
        expr: state_expr,
        state_param: state_param,
        env: env,
        parser_always_advancing: parser_always_advancing,
        consumed_true_set: consumed_true_set
      )
      if set_has(m: parser_always_advancing, key: expr_call_func(texpr: call_node)) {
        strict_progress(progress: input_progress)
      } else {
        input_progress
      }
    None => ProgressUnknown
  }
}

fn collect_parser_progress_block_edges(caller: String, stmts: List<Node>, state_param: ParserStateParam, scc_name_set: Map<String, Bool>, env: ParserProgressEnv, parser_always_advancing: Map<String, Bool>, consumed_true_set: Map<String, Bool>) -> List<ParserProgressEdge> {
  let acc = stmts |> fold(init: ParserProgressAcc { edges: [], env: env }, f: (acc, stmt) =>
    match stmt.expr_data {
      ExprLet =>
        match let_body(texpr: stmt) {
          None =>
            let value_expr = let_value(texpr: stmt)
            let value_edges = collect_parser_progress_edges(
              caller: caller,
              body: value_expr,
              state_param: state_param,
              scc_name_set: scc_name_set,
              env: acc.env,
              parser_always_advancing: parser_always_advancing,
              consumed_true_set: consumed_true_set
            )
            let next_env = parser_env_with_binding(
              name: let_binding_name(texpr: stmt),
              value_expr: value_expr,
              env: acc.env,
              state_param: state_param,
              parser_always_advancing: parser_always_advancing,
              consumed_true_set: consumed_true_set
            )
            ParserProgressAcc { edges: concat(acc.edges, value_edges), env: next_env }
          Some { value: _ } =>
            let stmt_edges = collect_parser_progress_edges(
              caller: caller,
              body: stmt,
              state_param: state_param,
              scc_name_set: scc_name_set,
              env: acc.env,
              parser_always_advancing: parser_always_advancing,
              consumed_true_set: consumed_true_set
            )
            ParserProgressAcc { edges: concat(acc.edges, stmt_edges), env: acc.env }
        }
      _ =>
        let stmt_edges = collect_parser_progress_edges(
          caller: caller,
          body: stmt,
          state_param: state_param,
          scc_name_set: scc_name_set,
          env: acc.env,
          parser_always_advancing: parser_always_advancing,
          consumed_true_set: consumed_true_set
        )
        ParserProgressAcc { edges: concat(acc.edges, stmt_edges), env: acc.env }
    }
  )
  acc.edges
}

fn collect_parser_progress_edges(caller: String, body: Node, state_param: ParserStateParam, scc_name_set: Map<String, Bool>, env: ParserProgressEnv, parser_always_advancing: Map<String, Bool>, consumed_true_set: Map<String, Bool>) -> List<ParserProgressEdge> {
  match body.expr_data {
    ExprCall { call_semantics: _ } =>
      let own_edges = if set_has(m: scc_name_set, key: expr_call_func(texpr: body)) {
        [ParserProgressEdge {
          caller: caller,
          callee: expr_call_func(texpr: body),
          progress: parser_call_edge_progress(
            call_node: body,
            state_param: state_param,
            env: env,
            parser_always_advancing: parser_always_advancing,
            consumed_true_set: consumed_true_set
          )
        }]
      } else {
        []
      }
      let child_edges = body.children |> flat_map(child =>
        collect_parser_progress_edges(
          caller: caller,
          body: child,
          state_param: state_param,
          scc_name_set: scc_name_set,
          env: env,
          parser_always_advancing: parser_always_advancing,
          consumed_true_set: consumed_true_set
        )
      )
      concat(own_edges, child_edges)

    ExprIf =>
      let cond = if_condition(texpr: body)
      let cond_edges = collect_parser_progress_edges(
        caller: caller,
        body: cond,
        state_param: state_param,
        scc_name_set: scc_name_set,
        env: env,
        parser_always_advancing: parser_always_advancing,
        consumed_true_set: consumed_true_set
      )
      let then_consumed = match parser_progress_flag_var(expr: cond) {
        Some { value: name } => map_insert(consumed_true_set, name, true)
        None => consumed_true_set
      }
      let then_edges = collect_parser_progress_edges(
        caller: caller,
        body: if_then_branch(texpr: body),
        state_param: state_param,
        scc_name_set: scc_name_set,
        env: env,
        parser_always_advancing: parser_always_advancing,
        consumed_true_set: then_consumed
      )
      let else_edges = match if_else_branch(texpr: body) {
        Some { value: eb } =>
          collect_parser_progress_edges(
            caller: caller,
            body: eb,
            state_param: state_param,
            scc_name_set: scc_name_set,
            env: env,
            parser_always_advancing: parser_always_advancing,
            consumed_true_set: consumed_true_set
          )
        None => []
      }
      concat(cond_edges, then_edges, else_edges)

    ExprLet =>
      let value_expr = let_value(texpr: body)
      let value_edges = collect_parser_progress_edges(
        caller: caller,
        body: value_expr,
        state_param: state_param,
        scc_name_set: scc_name_set,
        env: env,
        parser_always_advancing: parser_always_advancing,
        consumed_true_set: consumed_true_set
      )
      let next_env = parser_env_with_binding(
        name: let_binding_name(texpr: body),
        value_expr: value_expr,
        env: env,
        state_param: state_param,
        parser_always_advancing: parser_always_advancing,
        consumed_true_set: consumed_true_set
      )
      let body_edges = match let_body(texpr: body) {
        Some { value: b } =>
          collect_parser_progress_edges(
            caller: caller,
            body: b,
            state_param: state_param,
            scc_name_set: scc_name_set,
            env: next_env,
            parser_always_advancing: parser_always_advancing,
            consumed_true_set: consumed_true_set
          )
        None => []
      }
      concat(value_edges, body_edges)

    ExprBlock =>
      collect_parser_progress_block_edges(
        caller: caller,
        stmts: body.children,
        state_param: state_param,
        scc_name_set: scc_name_set,
        env: env,
        parser_always_advancing: parser_always_advancing,
        consumed_true_set: consumed_true_set
      )

    ExprMatch =>
      let scrut_edges = collect_parser_progress_edges(
        caller: caller,
        body: match_scrutinee(texpr: body),
        state_param: state_param,
        scc_name_set: scc_name_set,
        env: env,
        parser_always_advancing: parser_always_advancing,
        consumed_true_set: consumed_true_set
      )
      let arm_edges = match_arm_nodes(texpr: body) |> flat_map(arm_node =>
        collect_parser_progress_edges(
          caller: caller,
          body: arm_body(n: arm_node),
          state_param: state_param,
          scc_name_set: scc_name_set,
          env: env,
          parser_always_advancing: parser_always_advancing,
          consumed_true_set: consumed_true_set
        )
      )
      concat(scrut_edges, arm_edges)

    _ =>
      body.children |> flat_map(child =>
        collect_parser_progress_edges(
          caller: caller,
          body: child,
          state_param: state_param,
          scc_name_set: scc_name_set,
          env: env,
          parser_always_advancing: parser_always_advancing,
          consumed_true_set: consumed_true_set
        )
      )
  }
}

fn parser_record_field_value(expr: Node, field_name: String) -> Node? {
  expr.children |> filter(child => field_init_node_name(n: child) == field_name) |> map(child => field_init_node_value(n: child)) |> first
}

fn parser_expr_is_none(expr: Node) -> Bool {
  match expr.expr_data {
    ExprLiteral { value: LitNull } => true
    _ => false
  }
}

fn parser_success_progress(expr: Node, state_param: ParserStateParam, env: ParserProgressEnv, parser_always_advancing: Map<String, Bool>, consumed_true_set: Map<String, Bool>) -> ProgressKind {
  match expr.expr_data {
    ExprReturn =>
      parser_success_progress(
        expr: return_value(texpr: expr),
        state_param: state_param,
        env: env,
        parser_always_advancing: parser_always_advancing,
        consumed_true_set: consumed_true_set
      )

    ExprVar { binding_kind: _ } =>
      match map_get(env.result_sources, expr_var_name(texpr: expr)) {
        Some { value: source } =>
          parser_result_state_progress(
            source: source,
            parser_always_advancing: parser_always_advancing,
            consumed_true_set: consumed_true_set,
            result_name: expr_var_name(texpr: expr)
          )
        None => ProgressUnknown
      }

    ExprCall { call_semantics: _ } =>
      parser_result_state_progress(
        source: parser_result_source_for_expr(
          expr: expr,
          state_param: state_param,
          env: env,
          parser_always_advancing: parser_always_advancing,
          consumed_true_set: consumed_true_set
        ),
        parser_always_advancing: parser_always_advancing,
        consumed_true_set: consumed_true_set,
        result_name: ""
      )

    ExprRecordLit { parent_enum: _ } =>
      match parser_record_field_value(expr: expr, field_name: "err") {
        Some { value: err_expr } =>
          if parser_expr_is_none(expr: err_expr) {
            match parser_record_field_value(expr: expr, field_name: "state") {
              Some { value: state_expr } =>
                parser_state_expr_progress(
                  expr: state_expr,
                  state_param: state_param,
                  env: env,
                  parser_always_advancing: parser_always_advancing,
                  consumed_true_set: consumed_true_set
                )
              None => ProgressUnknown
            }
          } else {
            ProgressUnknown
          }
        None => ProgressUnknown
      }

    ExprIf =>
      let cond = if_condition(texpr: expr)
      let then_consumed = match parser_progress_flag_var(expr: cond) {
        Some { value: name } => map_insert(consumed_true_set, name, true)
        None => consumed_true_set
      }
      let then_progress = parser_success_progress(
        expr: if_then_branch(texpr: expr),
        state_param: state_param,
        env: env,
        parser_always_advancing: parser_always_advancing,
        consumed_true_set: then_consumed
      )
      let else_progress = match if_else_branch(texpr: expr) {
        Some { value: eb } =>
          parser_success_progress(
            expr: eb,
            state_param: state_param,
            env: env,
            parser_always_advancing: parser_always_advancing,
            consumed_true_set: consumed_true_set
          )
        None => ProgressUnknown
      }
      merge_progress(a: then_progress, b: else_progress)

    ExprLet =>
      let next_env = parser_env_with_binding(
        name: let_binding_name(texpr: expr),
        value_expr: let_value(texpr: expr),
        env: env,
        state_param: state_param,
        parser_always_advancing: parser_always_advancing,
        consumed_true_set: consumed_true_set
      )
      match let_body(texpr: expr) {
        Some { value: body } =>
          parser_success_progress(
            expr: body,
            state_param: state_param,
            env: next_env,
            parser_always_advancing: parser_always_advancing,
            consumed_true_set: consumed_true_set
          )
        None => ProgressUnknown
      }

    ExprBlock =>
      let prefix = expr.children |> reverse |> skip(1) |> reverse
      let acc = prefix |> fold(init: ParserProgressAcc { edges: [], env: env }, f: (acc, stmt) =>
        match stmt.expr_data {
          ExprLet =>
            match let_body(texpr: stmt) {
              None =>
                let next_env = parser_env_with_binding(
                  name: let_binding_name(texpr: stmt),
                  value_expr: let_value(texpr: stmt),
                  env: acc.env,
                  state_param: state_param,
                  parser_always_advancing: parser_always_advancing,
                  consumed_true_set: consumed_true_set
                )
                ParserProgressAcc { edges: acc.edges, env: next_env }
              Some { value: _ } => acc
            }
          _ => acc
        }
      )
      match expr.children |> last {
        Some { value: last_stmt } =>
          parser_success_progress(
            expr: last_stmt,
            state_param: state_param,
            env: acc.env,
            parser_always_advancing: parser_always_advancing,
            consumed_true_set: consumed_true_set
          )
        None => ProgressUnknown
      }

    _ => ProgressUnknown
  }
}

fn parser_member_is_always_advancing(entry: FuncEntry, parser_name_set: Map<String, Bool>, proven: Map<String, Bool>) -> Bool {
  match parser_state_param(params: entry.params) {
    Some { value: state_param } =>
      let edges = collect_parser_progress_edges(
        caller: entry.name,
        body: entry.body,
        state_param: state_param,
        scc_name_set: parser_name_set,
        env: empty_parser_progress_env(),
        parser_always_advancing: proven,
        consumed_true_set: empty_map()
      )
      (edges |> all(edge => edge.progress == ProgressStrict))
      && parser_success_progress(
        expr: entry.body,
        state_param: state_param,
        env: empty_parser_progress_env(),
        parser_always_advancing: proven,
        consumed_true_set: empty_map()
      ) == ProgressStrict
    None => false
  }
}

fn infer_parser_always_advancing_members_worklist(queue: List<String>, func_index: Map<String, FuncEntry>, parser_name_set: Map<String, Bool>, reverse_graph: Map<String, List<String>>, proven: Map<String, Bool>) -> Map<String, Bool> {
  match queue |> first {
    Some { value: name } =>
      let rest = queue |> skip(1)
      if set_has(m: proven, key: name) {
        infer_parser_always_advancing_members_worklist(
          queue: rest,
          func_index: func_index,
          parser_name_set: parser_name_set,
          reverse_graph: reverse_graph,
          proven: proven
        )
      } else {
        match map_get(func_index, name) {
          Some { value: entry } =>
            if parser_member_is_always_advancing(entry: entry, parser_name_set: parser_name_set, proven: proven) {
              let callers = match map_get(reverse_graph, name) {
                Some { value: members } => members
                None => []
              }
              infer_parser_always_advancing_members_worklist(
                queue: deduplicate(items: concat(rest, callers)),
                func_index: func_index,
                parser_name_set: parser_name_set,
                reverse_graph: reverse_graph,
                proven: map_insert(proven, name, true)
              )
            } else {
              infer_parser_always_advancing_members_worklist(
                queue: rest,
                func_index: func_index,
                parser_name_set: parser_name_set,
                reverse_graph: reverse_graph,
                proven: proven
              )
            }
          None =>
            infer_parser_always_advancing_members_worklist(
              queue: rest,
              func_index: func_index,
              parser_name_set: parser_name_set,
              reverse_graph: reverse_graph,
              proven: proven
            )
        }
      }
    None => proven
  }
}

fn infer_parser_always_advancing_members(members: List<String>, func_index: Map<String, FuncEntry>) -> Map<String, Bool> {
  let parser_name_set = members |> fold(init: empty_map(), f: (acc, name) =>
    map_insert(acc, name, true)
  )
  let parser_entries = members |> flat_map(name =>
    match map_get(func_index, name) {
      Some { value: entry } => [entry]
      None => []
    }
  )
  let reverse_graph = build_call_graph(func_entries: parser_entries).reverse
  infer_parser_always_advancing_members_worklist(
    queue: members,
    func_index: func_index,
    parser_name_set: parser_name_set,
    reverse_graph: reverse_graph,
    proven: empty_map()
  )
}

fn parser_function_names(func_index: Map<String, FuncEntry>) -> List<String> {
  map_keys(func_index) |> filter(name =>
    match map_get(func_index, name) {
      Some { value: entry } => parser_state_param(params: entry.params) != none
      None => false
    }
  )
}

fn infer_all_parser_always_advancing(func_index: Map<String, FuncEntry>) -> Map<String, Bool> {
  let members = parser_function_names(func_index: func_index)
  infer_parser_always_advancing_members(members: members, func_index: func_index)
}

fn self_calls_have_strict_parser_progress(func_name: String, body: Node, params: List<Node>, parser_always_advancing: Map<String, Bool>) -> Bool {
  match parser_state_param(params: params) {
    Some { value: state_param } =>
      let self_set = map_insert(empty_map(), func_name, true)
      let edges = collect_parser_progress_edges(
        caller: func_name,
        body: body,
        state_param: state_param,
        scc_name_set: self_set,
        env: empty_parser_progress_env(),
        parser_always_advancing: parser_always_advancing,
        consumed_true_set: empty_map()
      )
      (edges |> count) > 0 && (edges |> all(edge => edge.progress == ProgressStrict))
    None => false
  }
}

fn build_call_graph_from_parser_edges(names: List<String>, edges: List<ParserProgressEdge>) -> CallGraph {
  let initial_forward = names |> fold(init: empty_map(), f: (acc, name) =>
    map_insert(acc, name, [])
  )
  let initial_reverse = names |> fold(init: empty_map(), f: (acc, name) =>
    map_insert(acc, name, [])
  )
  let graph_acc = edges |> fold(init: CallGraphAcc { forward: initial_forward, reverse: initial_reverse }, f: (acc, edge) =>
    let forward_neighbors = match map_get(acc.forward, edge.caller) {
      Some { value: ns } => ns
      None => []
    }
    let reverse_neighbors = match map_get(acc.reverse, edge.callee) {
      Some { value: ns } => ns
      None => []
    }
    CallGraphAcc {
      forward: map_insert(acc.forward, edge.caller, list_push(forward_neighbors, edge.callee)),
      reverse: map_insert(acc.reverse, edge.callee, list_push(reverse_neighbors, edge.caller))
    }
  )
  CallGraph { forward: graph_acc.forward, reverse: graph_acc.reverse }
}

fn same_progress_subgraph_has_cycle(members: List<String>, edges: List<ParserProgressEdge>) -> Bool {
  let same_edges = edges |> filter(edge => edge.progress == ProgressSame)
  if same_edges |> any(edge => edge.caller == edge.callee) {
    true
  } else {
    let graph = build_call_graph_from_parser_edges(names: members, edges: same_edges)
    graph_has_multi_node_scc(names: members, graph: graph)
  }
}

fn classify_parser_scc_recursion_pattern(members: List<String>, func_index: Map<String, FuncEntry>) -> RecursionPattern? {
  let scc_name_set = members |> fold(init: empty_map(), f: (acc, name) =>
    map_insert(acc, name, true)
  )
  let has_parser_state = members |> all(name =>
    match map_get(func_index, name) {
      Some { value: entry } => parser_state_param(params: entry.params) != none
      None => false
    }
  )
  if has_parser_state == false {
    none
  } else {
    let parser_always_advancing = infer_parser_always_advancing_members(
      members: parser_function_names(func_index: func_index),
      func_index: func_index
    )
    let edges = members |> flat_map(name =>
      match map_get(func_index, name) {
        Some { value: entry } =>
          match parser_state_param(params: entry.params) {
            Some { value: state_param } =>
              collect_parser_progress_edges(
                caller: name,
                body: entry.body,
                state_param: state_param,
                scc_name_set: scc_name_set,
                env: empty_parser_progress_env(),
                parser_always_advancing: parser_always_advancing,
                consumed_true_set: empty_map()
              )
            None => []
          }
        None => []
      }
    )
    let all_known = edges |> all(edge => edge.progress != ProgressUnknown)
    if all_known && same_progress_subgraph_has_cycle(members: members, edges: edges) == false {
      Some { value: LinearRecursion { iteration_var: concat("n_", scc_label(members: members)) } }
    } else {
      none
    }
  }
}

// Count direct self-calls in a function body expression tree.
// Used by classify_recursion_pattern for total call count.
fn count_self_calls(body: Node, func_name: String) -> Int {
  let own = match body.expr_data {
    ExprCall { call_semantics: _ } =>
      let f = expr_call_func(texpr: body)
      if f == func_name { 1 } else { 0 }
    _ => 0
  }
  let from_children = body.children |> fold(init: 0, f: (acc, child) =>
    acc + count_self_calls(body: child, func_name: func_name)
  )
  own + from_children
}

// Count maximum self-calls on any single execution path through an
// expression. Match/if arms are mutually exclusive (max, not sum).
// Self-calls inside fold/forEach bodies are already bounded by the
// iteration and do not contribute to the recursion branching factor.
//
// This distinguishes tree traversal (O(n)) from branching recursion
// (O(2^n)). A function with 15 self-call sites across 10 match arms
// has max_path_calls = max(arm calls), not sum(arm calls).
fn max_path_self_calls(body: Node, func_name: String) -> Int {
  max_path_self_calls_with_cont(body: body, func_name: func_name, continue_calls: 0)
}

// Count maximum self-calls on any single execution path through an
// expression, threading the self-calls from code that runs afterward.
// This keeps mutually exclusive early-return branches from being summed
// together by a surrounding block.
fn max_path_self_calls_with_cont(body: Node, func_name: String, continue_calls: Int) -> Int {
  match body.expr_data {
    ExprCall { call_semantics: _ } =>
      let f = expr_call_func(texpr: body)
      let own = if f == func_name { 1 } else { 0 }
      let arg_calls = body.children |> fold(init: 0, f: (acc, child) =>
        let val = arg_value(n: child)
        match val.expr_data {
          ExprLambda => acc
          _ => acc + max_path_self_calls_with_cont(body: val, func_name: func_name, continue_calls: 0)
        }
      )
      own + arg_calls + continue_calls

    ExprMatch =>
      // Match arms are mutually exclusive: take MAX across arms.
      let scrut_calls = max_path_self_calls_with_cont(body: match_scrutinee(texpr: body), func_name: func_name, continue_calls: 0)
      let max_arm = match_arm_nodes(texpr: body) |> fold(init: continue_calls, f: (acc, arm_node) =>
        let arm_calls = max_path_self_calls_with_cont(body: arm_body(n: arm_node), func_name: func_name, continue_calls: continue_calls)
        if arm_calls > acc { arm_calls } else { acc }
      )
      scrut_calls + max_arm

    ExprIf =>
      // If/else branches are mutually exclusive: take MAX.
      let cond_calls = max_path_self_calls_with_cont(body: if_condition(texpr: body), func_name: func_name, continue_calls: 0)
      let then_calls = max_path_self_calls_with_cont(body: if_then_branch(texpr: body), func_name: func_name, continue_calls: continue_calls)
      let else_calls = match if_else_branch(texpr: body) {
        Some { value: eb } => max_path_self_calls_with_cont(body: eb, func_name: func_name, continue_calls: continue_calls)
        None => continue_calls
      }
      let branch_max = if then_calls > else_calls { then_calls } else { else_calls }
      cond_calls + branch_max

    ExprForEach =>
      // Self-calls inside a forEach body are bounded by the iteration.
      // They do NOT contribute to the recursion branching factor.
      // Only count calls in the collection expression (not the body).
      //
      // Soundness note: this exclusion is correct for path-counting (the
      // branching factor). However, self_calls_have_descending_witness
      // DOES recurse into the forEach body via the `_ => children` arm,
      // so recursive self-calls inside forEach bodies are still checked
      // for descent witnesses. A negative test should verify this
      // (ROADMAP regression test: forEach body containing self-calls).
      max_path_self_calls_with_cont(body: foreach_collection(texpr: body), func_name: func_name, continue_calls: 0) + continue_calls

    ExprLet =>
      let val_calls = max_path_self_calls_with_cont(body: let_value(texpr: body), func_name: func_name, continue_calls: 0)
      let body_calls = match let_body(texpr: body) {
        Some { value: b } => max_path_self_calls_with_cont(body: b, func_name: func_name, continue_calls: continue_calls)
        None => continue_calls
      }
      val_calls + body_calls

    ExprBlock =>
      body.children |> reverse |> fold(init: continue_calls, f: (acc, stmt) =>
        max_path_self_calls_with_cont(body: stmt, func_name: func_name, continue_calls: acc)
      )

    ExprMethodCall { method_semantics: _ } =>
      // Receiver + non-lambda args contribute to path calls.
      // Lambda args (callbacks to fold/map/filter) are iteration-bounded
      // and excluded, same as forEach body exclusion.
      let recv_calls = max_path_self_calls_with_cont(body: method_receiver(texpr: body), func_name: func_name, continue_calls: 0)
      let arg_calls = method_arg_nodes(texpr: body) |> fold(init: 0, f: (acc, arg_node) =>
        let val = arg_value(n: arg_node)
        match val.expr_data {
          // Lambda bodies are iteration-bounded (callback to fold/map/filter)
          ExprLambda => acc
          _ => acc + max_path_self_calls_with_cont(body: val, func_name: func_name, continue_calls: 0)
        }
      )
      recv_calls + arg_calls + continue_calls

    ExprReturn =>
      max_path_self_calls_with_cont(body: return_value(texpr: body), func_name: func_name, continue_calls: 0)

    _ =>
      // Default: sum across children (conservative).
      body.children |> fold(init: 0, f: (acc, child) =>
        acc + max_path_self_calls_with_cont(body: child, func_name: func_name, continue_calls: 0)
      ) + continue_calls
  }
}

fn max_path_self_calls_block(stmts: List<Node>, func_name: String, continue_calls: Int) -> Int {
  stmts |> reverse |> fold(init: continue_calls, f: (acc, stmt) =>
    max_path_self_calls_with_cont(body: stmt, func_name: func_name, continue_calls: acc)
  )
}

fn count_target_calls(body: Node, target_set: Map<String, Bool>) -> Int {
  let own = match body.expr_data {
    ExprCall { call_semantics: _ } =>
      let f = expr_call_func(texpr: body)
      if set_has(m: target_set, key: f) { 1 } else { 0 }
    _ => 0
  }
  let from_children = body.children |> fold(init: 0, f: (acc, child) =>
    acc + count_target_calls(body: child, target_set: target_set)
  )
  own + from_children
}

fn max_path_target_calls(body: Node, target_set: Map<String, Bool>) -> Int {
  max_path_target_calls_with_cont(body: body, target_set: target_set, continue_calls: 0)
}

fn max_path_target_calls_with_cont(body: Node, target_set: Map<String, Bool>, continue_calls: Int) -> Int {
  match body.expr_data {
    ExprCall { call_semantics: _ } =>
      let f = expr_call_func(texpr: body)
      let own = if set_has(m: target_set, key: f) { 1 } else { 0 }
      let arg_calls = body.children |> fold(init: 0, f: (acc, child) =>
        acc + max_path_target_calls_with_cont(body: arg_value(n: child), target_set: target_set, continue_calls: 0)
      )
      own + arg_calls + continue_calls

    ExprMatch =>
      let scrut_calls = max_path_target_calls_with_cont(body: match_scrutinee(texpr: body), target_set: target_set, continue_calls: 0)
      let max_arm = match_arm_nodes(texpr: body) |> fold(init: continue_calls, f: (acc, arm_node) =>
        let arm_calls = max_path_target_calls_with_cont(body: arm_body(n: arm_node), target_set: target_set, continue_calls: continue_calls)
        if arm_calls > acc { arm_calls } else { acc }
      )
      scrut_calls + max_arm

    ExprIf =>
      let cond_calls = max_path_target_calls_with_cont(body: if_condition(texpr: body), target_set: target_set, continue_calls: 0)
      let then_calls = max_path_target_calls_with_cont(body: if_then_branch(texpr: body), target_set: target_set, continue_calls: continue_calls)
      let else_calls = match if_else_branch(texpr: body) {
        Some { value: eb } => max_path_target_calls_with_cont(body: eb, target_set: target_set, continue_calls: continue_calls)
        None => continue_calls
      }
      let branch_max = if then_calls > else_calls { then_calls } else { else_calls }
      cond_calls + branch_max

    ExprForEach =>
      max_path_target_calls_with_cont(body: foreach_collection(texpr: body), target_set: target_set, continue_calls: 0) + continue_calls

    ExprLet =>
      let val_calls = max_path_target_calls_with_cont(body: let_value(texpr: body), target_set: target_set, continue_calls: 0)
      let body_calls = match let_body(texpr: body) {
        Some { value: b } => max_path_target_calls_with_cont(body: b, target_set: target_set, continue_calls: continue_calls)
        None => continue_calls
      }
      val_calls + body_calls

    ExprBlock =>
      body.children |> reverse |> fold(init: continue_calls, f: (acc, stmt) =>
        max_path_target_calls_with_cont(body: stmt, target_set: target_set, continue_calls: acc)
      )

    ExprMethodCall { method_semantics: _ } =>
      let recv_calls = max_path_target_calls_with_cont(body: method_receiver(texpr: body), target_set: target_set, continue_calls: 0)
      let arg_calls = method_arg_nodes(texpr: body) |> fold(init: 0, f: (acc, arg_node) =>
        let val = arg_value(n: arg_node)
        match val.expr_data {
          ExprLambda => acc
          _ => acc + max_path_target_calls_with_cont(body: val, target_set: target_set, continue_calls: 0)
        }
      )
      recv_calls + arg_calls + continue_calls

    ExprReturn =>
      max_path_target_calls_with_cont(body: return_value(texpr: body), target_set: target_set, continue_calls: 0)

    _ =>
      body.children |> fold(init: continue_calls, f: (acc, child) =>
        acc + max_path_target_calls_with_cont(body: child, target_set: target_set, continue_calls: 0)
      )
  }
}

fn build_scc_measure_params(members: List<String>, func_index: Map<String, FuncEntry>) -> Map<String, Map<String, String>> {
  members |> fold(init: empty_map(), f: (acc, name) =>
    match map_get(func_index, name) {
      Some { value: entry } =>
        map_insert(acc, name, recursive_measure_param_names(body: entry.body, params: entry.params))
      None => acc
    }
  )
}

fn target_call_has_arithmetic_descent(call_node: Node, target_set: Map<String, Bool>, func_index: Map<String, FuncEntry>, scc_measure_params: Map<String, Map<String, String>>) -> Bool {
  let callee = expr_call_func(texpr: call_node)
  if set_has(m: target_set, key: callee) == false {
    true
  } else {
    match map_get(func_index, callee) {
      Some { value: callee_entry } =>
        let callee_measure_params = match map_get(scc_measure_params, callee) {
          Some { value: params } => params
          None => empty_map()
        }
        call_node.children |> enumerate |> any(pair =>
          let arg_expr = arg_value(n: pair.second)
          max_path_target_calls(body: arg_expr, target_set: target_set) == 0
          && is_descending_expr(expr: arg_expr)
          && match recursive_param_name_for_arg(idx: pair.first, arg_node: pair.second, params: callee_entry.params) {
            Some { value: param_name } => map_get(callee_measure_params, param_name) != none
            None => false
          }
        )
      None => false
    }
  }
}

fn scc_calls_have_arithmetic_descent(body: Node, target_set: Map<String, Bool>, func_index: Map<String, FuncEntry>, scc_measure_params: Map<String, Map<String, String>>) -> Bool {
  match body.expr_data {
    ExprCall { call_semantics: _ } =>
      target_call_has_arithmetic_descent(call_node: body, target_set: target_set, func_index: func_index, scc_measure_params: scc_measure_params)
      && (body.children |> all(child =>
        scc_calls_have_arithmetic_descent(body: child, target_set: target_set, func_index: func_index, scc_measure_params: scc_measure_params)
      ))
    _ =>
      body.children |> all(child =>
        scc_calls_have_arithmetic_descent(body: child, target_set: target_set, func_index: func_index, scc_measure_params: scc_measure_params)
      )
  }
}

fn descending_name_set_without_key(names: Map<String, String>, key: String) -> Map<String, String> {
  names |> map_keys |> fold(init: empty_map(), f: (acc, name) =>
    if name == key {
      acc
    } else {
      match map_get(names, name) {
        Some { value: source } => map_insert(acc, name, source)
        None => acc
      }
    }
  )
}

fn expr_descending_witness_source(expr: Node, descending_witness_names: Map<String, String>) -> String? {
  match expr.expr_data {
    ExprVar { binding_kind: _ } =>
      map_get(descending_witness_names, expr_var_name(texpr: expr))
    ExprBinOp { op: op } =>
      match op {
        Sub => expr_descending_witness_source(expr: binop_left(texpr: expr), descending_witness_names: descending_witness_names)
        Div => expr_descending_witness_source(expr: binop_left(texpr: expr), descending_witness_names: descending_witness_names)
        _ => none
      }
    // ExprFieldAccess and ExprMethodCall are NOT treated as descent
    // witnesses without resolved recursive-field facts. Although .dag
    // values are acyclically constructed (Decidability Invariant Part 1),
    // field access on `x` is only a valid RECURSION descent witness when
    // the accessed field is a proven recursive child position of x's type.
    // `x.metadata` (Int field) or `x.sibling_payload` (non-recursive
    // field) are substructures of x but do not prove that the recursion
    // measure decreases. Treating arbitrary field access as descent would
    // accept unsound programs like `f(match x { A(child) => child, B(_) => x })`.
    //
    // Container-child descent (CX-1) handles Node tree walkers via
    // accessor identity. User-defined recursive unions deferred until
    // resolve/infer carry descent witnesses downstream.
    _ => none
  }
}

// Soundness note on witness propagation through control flow:
//
// This function propagates descent witness names through let-bindings.
// It does NOT propagate through ExprIf or ExprMatch branches because
// "either branch yields a witness" is unsound: `if cond { n - 1 } else { n }`
// would be accepted as descent when only some execution paths actually descend.
// Similarly, `match x { A(child) => child, B(_) => x }` has a non-descending
// arm. For ExprIf/ExprMatch to propagate witnesses, ALL branches must yield
// descent from the same parameter — a requirement that is not yet enforced.
// This is tracked in ROADMAP §I1.
fn collect_descending_witness_names(body: Node, descending_witness_names: Map<String, String>) -> Map<String, String> {
  match body.expr_data {
    ExprLet =>
      let value_witnesses = collect_descending_witness_names(body: let_value(texpr: body), descending_witness_names: descending_witness_names)
      let next_witnesses_base = descending_name_set_without_key(names: value_witnesses, key: let_binding_name(texpr: body))
      let next_witnesses = match expr_descending_witness_source(expr: let_value(texpr: body), descending_witness_names: value_witnesses) {
        Some { value: source_param } => map_insert(next_witnesses_base, let_binding_name(texpr: body), source_param)
        None => next_witnesses_base
      }
      match let_body(texpr: body) {
        Some { value: b } => collect_descending_witness_names(body: b, descending_witness_names: next_witnesses)
        None => next_witnesses
      }

    ExprBlock =>
      body.children |> fold(init: descending_witness_names, f: (acc, stmt) =>
        collect_descending_witness_names(body: stmt, descending_witness_names: acc)
      )

    _ =>
      body.children |> fold(init: descending_witness_names, f: (acc, child) =>
        collect_descending_witness_names(body: child, descending_witness_names: acc)
      )
  }
}

fn condition_param_names(expr: Node, param_set: Map<String, String>) -> Map<String, String> {
  match expr.expr_data {
    ExprVar { binding_kind: _ } =>
      let name = expr_var_name(texpr: expr)
      match map_get(param_set, name) {
        Some { value: _ } => map_insert(empty_map(), name, name)
        None => empty_map()
      }
    _ =>
      expr.children |> fold(init: empty_map(), f: (acc, child) =>
        map_merge(acc, condition_param_names(expr: child, param_set: param_set))
      )
  }
}

fn recursive_measure_param_names(body: Node, params: List<Node>) -> Map<String, String> {
  let param_set = params |> fold(init: empty_map(), f: (acc, param) =>
    map_insert(acc, param_node_name(n: param), param_node_name(n: param))
  )
  match body.expr_data {
    ExprIf =>
      let then_names = recursive_measure_param_names(body: if_then_branch(texpr: body), params: params)
      let else_names = match if_else_branch(texpr: body) {
        Some { value: eb } => recursive_measure_param_names(body: eb, params: params)
        None => empty_map()
      }
      map_merge(map_merge(
        condition_param_names(expr: if_condition(texpr: body), param_set: param_set),
        then_names),
        else_names)
    ExprMatch =>
      let scrut_names = condition_param_names(expr: match_scrutinee(texpr: body), param_set: param_set)
      let arm_names = match_arm_nodes(texpr: body) |> fold(init: empty_map(), f: (acc, arm_node) =>
        map_merge(acc, recursive_measure_param_names(body: arm_body(n: arm_node), params: params))
      )
      map_merge(scrut_names, arm_names)
    ExprLet =>
      match let_body(texpr: body) {
        Some { value: b } => recursive_measure_param_names(body: b, params: params)
        None => empty_map()
      }
    ExprBlock =>
      body.children |> fold(init: empty_map(), f: (acc, stmt) =>
        map_merge(acc, recursive_measure_param_names(body: stmt, params: params))
      )
    _ =>
      body.children |> fold(init: empty_map(), f: (acc, child) =>
        map_merge(acc, recursive_measure_param_names(body: child, params: params))
      )
  }
}

fn recursive_param_name_for_arg(idx: Int, arg_node: Node, params: List<Node>) -> String? {
  match arg_name(n: arg_node) {
    Some { value: name } => Some { value: name }
    None =>
      params |> enumerate |> filter(pair => pair.first == idx) |> map(pair => param_node_name(n: pair.second)) |> first
  }
}

fn is_descending_witness_arg(expr: Node, func_name: String, param_name: String, descending_witness_names: Map<String, String>) -> Bool {
  if count_self_calls(body: expr, func_name: func_name) > 0 { false }
  else {
    match expr_descending_witness_source(expr: expr, descending_witness_names: descending_witness_names) {
      Some { value: source_param } => source_param == param_name
      None => false
    }
  }
}

fn self_calls_have_descending_witness(body: Node, func_name: String, params: List<Node>, descending_witness_names: Map<String, String>) -> Bool {
  match body.expr_data {
    ExprCall { call_semantics: _ } =>
      let own_ok = if expr_call_func(texpr: body) == func_name {
        let arg_nodes = body.children
        let args = arg_nodes |> map(arg_node => arg_value(n: arg_node))
        let arg_shape_ok = args |> all(arg_expr =>
          count_self_calls(body: arg_expr, func_name: func_name) == 0
        )
        let witness_ok = arg_nodes |> enumerate |> any(pair =>
          match recursive_param_name_for_arg(idx: pair.first, arg_node: pair.second, params: params) {
            Some { value: param_name } =>
              is_descending_witness_arg(
                expr: arg_value(n: pair.second),
                func_name: func_name,
                param_name: param_name,
                descending_witness_names: descending_witness_names
              )
            None => false
          }
        )
        arg_shape_ok && witness_ok
      } else { true }
      own_ok
      && (body.children |> all(child =>
        self_calls_have_descending_witness(
          body: child,
          func_name: func_name,
          params: params,
          descending_witness_names: descending_witness_names
        )
      ))

    _ =>
      body.children |> all(child =>
        self_calls_have_descending_witness(body: child, func_name: func_name, params: params, descending_witness_names: descending_witness_names)
      )
  }
}

// Check if an expression is provably descending: variable minus/divided by something.
fn is_descending_expr(expr: Node) -> Bool {
  match expr.expr_data {
    ExprBinOp { op: op } =>
      match op {
        Sub => match binop_left(texpr: expr).expr_data { ExprVar { binding_kind: _ } => true  _ => false }
        Div => match binop_left(texpr: expr).expr_data { ExprVar { binding_kind: _ } => true  _ => false }
        _ => false
      }
    _ => false
  }
}

// Check if ANY self-call in the body has at least one arg that is
// provably descending (param - expr or param / expr).
fn has_arithmetic_descent(body: Node, func_name: String) -> Bool {
  match body.expr_data {
    ExprCall { call_semantics: _ } =>
      let own_ok = if expr_call_func(texpr: body) == func_name {
        body.children |> any(arg_node => is_descending_expr(expr: arg_value(n: arg_node)))
      } else { false }
      if own_ok { true }
      else { body.children |> any(c => has_arithmetic_descent(body: c, func_name: func_name)) }
    _ => body.children |> any(c => has_arithmetic_descent(body: c, func_name: func_name))
  }
}

// =========================================================================
// CX-1: Container-child descent and list-shrinkage proofs.
//
// Container-child descent: function matches on param.expr_data (or
// unwraps param.children) and recurses on accessor(param) results.
// Each accessor projects into param.children → strict tree descent.
//
// List shrinkage: function matches on list |> first, recurses on
// list |> skip(1). List length strictly decreases.
// =========================================================================

// Check if an expression is `accessor(param)` where accessor is a known
// child-position accessor from 00_core.dag.
fn is_accessor_of_param(expr: Node, param_name: String) -> Bool {
  match expr.expr_data {
    ExprCall { call_semantics: _ } =>
      let callee = expr_call_func(texpr: expr)
      is_child_accessor_in_model(name: callee)
      && (expr.children |> any(arg_node =>
        match arg_value(n: arg_node).expr_data {
          ExprVar { binding_kind: _ } => expr_var_name(texpr: arg_value(n: arg_node)) == param_name
          _ => false
        }
      ))
    _ => false
  }
}

// Check if an expression accesses param.children (for direct child access
// patterns like `param.children |> first` or `param.children |> skip(N)`).
fn is_children_of_param(expr: Node, param_name: String) -> Bool {
  match expr.expr_data {
    ExprFieldAccess =>
      let base = field_access_base(texpr: expr)
      let field = field_access_field(texpr: expr)
      field == "children"
      && match base.expr_data {
        ExprVar { binding_kind: _ } => expr_var_name(texpr: base) == param_name
        _ => false
      }
    ExprMethodCall { method_semantics: _ } =>
      // Handle `param.children |> skip(N)` — projection from children list.
      match classify_list_method(name: expr_call_func(texpr: expr)) {
        Some { value: SkipMethod } => is_children_of_param(expr: method_receiver(texpr: expr), param_name: param_name)
        _ => false
      }
    _ => false
  }
}

// Check if an expression is a child-descending argument: either
// accessor(param), param.children |> first/last, or a let-bound alias.
fn is_child_descent_expr(expr: Node, param_name: String) -> Bool {
  if is_accessor_of_param(expr: expr, param_name: param_name) { true }
  else {
    match expr.expr_data {
      ExprMethodCall { method_semantics: _ } =>
        match classify_list_method(name: expr_call_func(texpr: expr)) {
          Some { value: FirstMethod } => is_children_of_param(expr: method_receiver(texpr: expr), param_name: param_name)
          Some { value: LastMethod } => is_children_of_param(expr: method_receiver(texpr: expr), param_name: param_name)
          _ => false
        }
      _ => false
    }
  }
}

// Check if an expression is a list-shrinking argument:
// param |> skip(N) where N >= 1 (proven by positive integer literal).
fn is_list_shrink_expr(expr: Node, param_name: String) -> Bool {
  match expr.expr_data {
    ExprMethodCall { method_semantics: _ } =>
      let is_skip = match classify_list_method(name: expr_call_func(texpr: expr)) {
        Some { value: SkipMethod } => true
        _ => false
      }
      is_skip
      && match method_receiver(texpr: expr).expr_data {
        ExprVar { binding_kind: _ } => expr_var_name(texpr: method_receiver(texpr: expr)) == param_name
        _ => false
      }
      // Verify skip amount is a positive integer literal (fail-closed: skip(0) or
      // non-literal skip amounts are not accepted as descent evidence).
      && match method_arg_nodes(texpr: expr) |> first {
        Some { value: arg_node } =>
          match arg_value(n: arg_node).expr_data {
            ExprLiteral { value: LitInt { value: n } } => n > 0
            _ => false
          }
        None => false
      }
    _ => false
  }
}

// Check if an expression is a descent argument — either a direct descent
// expression or a variable previously bound to one.
fn is_descent_arg(expr: Node, param_name: String, descent_vars: Map<String, Bool>, check_child: Bool, check_list: Bool) -> Bool {
  match expr.expr_data {
    ExprVar { binding_kind: _ } =>
      let vname = expr_var_name(texpr: expr)
      set_has(m: descent_vars, key: vname)
    _ =>
      (check_child && is_child_descent_expr(expr: expr, param_name: param_name))
      || (check_list && is_list_shrink_expr(expr: expr, param_name: param_name))
  }
}

// Check if an expression contains a child descent, looking through
// if/block/match wrappers. Handles `if cond { n.children |> first } else { none }`.
fn expr_contains_descent(expr: Node, param_name: String, vars: Map<String, Bool>, check_child: Bool, check_list: Bool) -> Bool {
  if (check_child && is_child_descent_expr(expr: expr, param_name: param_name))
    || (check_list && is_list_shrink_expr(expr: expr, param_name: param_name)) {
    true
  } else {
    match expr.expr_data {
      ExprIf =>
        // Both branches must contain descent for the if-expression as a whole
        // to be considered descent. Partial descent (one branch only) is not
        // sufficient — the non-descent branch could execute at runtime.
        expr_contains_descent(expr: if_then_branch(texpr: expr), param_name: param_name, vars: vars, check_child: check_child, check_list: check_list)
        && match if_else_branch(texpr: expr) {
          Some { value: eb } => expr_contains_descent(expr: eb, param_name: param_name, vars: vars, check_child: check_child, check_list: check_list)
          None => false
        }
      ExprBlock =>
        match expr.children |> last {
          Some { value: last_stmt } => expr_contains_descent(expr: last_stmt, param_name: param_name, vars: vars, check_child: check_child, check_list: check_list)
          None => false
        }
      ExprVar { binding_kind: _ } =>
        set_has(m: vars, key: expr_var_name(texpr: expr))
      _ => false
    }
  }
}

// Collect variable bindings that resolve to child descent expressions.
// Tracks: `let x = accessor(param)`, `match accessor(param) { Some { value: x } => ... }`,
// `let x = param.children |> first`, etc.
//
// Soundness: for let-bindings, ONLY accept direct descent expressions
// (is_child_descent_expr / is_list_shrink_expr / known descent var).
// Do NOT look through if/match wrappers — `let x = if c { desc } else { n }`
// is not guaranteed descent (W-3 witness propagation class).
// For match scrutinees, expr_contains_descent IS safe because the match
// extracts the descending component (W-4 is safe when gated by match).
// RC-2: Check if an if-expression produces Option where the descent branch
// returns Some(child) and the non-descent branch returns none.
// This is safe because the subsequent match on Some { value: x } guarantees
// we only recurse when the descent branch was taken.
// NOT a general relaxation of W-3 — only applies when else-branch is none.
fn is_if_option_descent(val: Node, param_name: String, vars: Map<String, Bool>, check_child: Bool, check_list: Bool) -> Bool {
  match val.expr_data {
    ExprIf =>
      let then_branch = if_then_branch(texpr: val)
      let then_has_descent = expr_contains_descent(expr: then_branch, param_name: param_name, vars: vars, check_child: check_child, check_list: check_list)
      let else_is_none = match if_else_branch(texpr: val) {
        Some { value: eb } =>
          match eb.expr_data {
            ExprVar { binding_kind: _ } => expr_var_name(texpr: eb) == "none"
            ExprLiteral { value: LitNull } => true
            _ => false
          }
        None => true
      }
      then_has_descent && else_is_none
    _ => false
  }
}

fn collect_descent_vars(body: Node, param_name: String, vars: Map<String, Bool>, check_child: Bool, check_list: Bool) -> Map<String, Bool> {
  match body.expr_data {
    ExprLet =>
      let val = let_value(texpr: body)
      let is_direct_descent = (check_child && is_child_descent_expr(expr: val, param_name: param_name))
        || (check_list && is_list_shrink_expr(expr: val, param_name: param_name))
      let is_descent_var = match val.expr_data {
        ExprVar { binding_kind: _ } => set_has(m: vars, key: expr_var_name(texpr: val))
        _ => false
      }
      // RC-2: if cond { descent } else { none } → conditional descent via Option
      let is_option_descent = is_if_option_descent(val: val, param_name: param_name, vars: vars, check_child: check_child, check_list: check_list)
      let val_is_descent = is_direct_descent || is_descent_var || is_option_descent
      let next_vars = if val_is_descent {
        map_insert(vars, let_binding_name(texpr: body), true)
      } else { vars }
      match let_body(texpr: body) {
        Some { value: b } => collect_descent_vars(body: b, param_name: param_name, vars: next_vars, check_child: check_child, check_list: check_list)
        None => next_vars
      }
    ExprMatch =>
      // If scrutinee is a descent expr or a descent var,
      // then Some { value: x } bindings are also descent.
      let scrut = match_scrutinee(texpr: body)
      let scrut_is_descent = expr_contains_descent(expr: scrut, param_name: param_name, vars: vars, check_child: check_child, check_list: check_list)
      let with_patterns = if scrut_is_descent {
        match_arm_nodes(texpr: body) |> fold(init: vars, f: (acc, arm_node) =>
          match arm_pattern(n: arm_node) {
            VariantPattern { name: vname, parent_enum: _, field_bindings: bindings } =>
              if vname == "Some" {
                bindings |> fold(init: acc, f: (inner, fb) =>
                  match field_binding_pattern(n: fb) {
                    Bind { name: binding_name } => map_insert(inner, binding_name, true)
                    _ => inner
                  }
                )
              } else { acc }
            Bind { name: binding_name } => map_insert(acc, binding_name, true)
            _ => acc
          }
        )
      } else { vars }
      // Recurse into each arm body independently from with_patterns.
      // Arm-body bindings are arm-local — they must NOT propagate to sibling arms.
      // Results are merged (union) for SCC precomputation use only.
      match_arm_nodes(texpr: body) |> fold(init: with_patterns, f: (acc, arm_node) =>
        let arm_result = collect_descent_vars(body: arm_body(n: arm_node), param_name: param_name, vars: with_patterns, check_child: check_child, check_list: check_list)
        map_merge(acc, arm_result)
      )
    ExprIf =>
      // Both branches start from the SAME input vars — then-branch bindings
      // must NOT contaminate the else-branch (they are branch-local).
      let then_vars = collect_descent_vars(body: if_then_branch(texpr: body), param_name: param_name, vars: vars, check_child: check_child, check_list: check_list)
      let else_vars = match if_else_branch(texpr: body) {
        Some { value: eb } => collect_descent_vars(body: eb, param_name: param_name, vars: vars, check_child: check_child, check_list: check_list)
        None => vars
      }
      map_merge(then_vars, else_vars)
    ExprBlock =>
      body.children |> fold(init: vars, f: (acc, stmt) =>
        collect_descent_vars(body: stmt, param_name: param_name, vars: acc, check_child: check_child, check_list: check_list)
      )
    _ => vars
  }
}

// Verify every self-call in `body` passes a child-descending or
// list-shrinking expression as the argument at `param_name`.
//
// INCREMENTAL: threads descent_vars through the body in evaluation order.
// A binding is only visible AFTER it is defined — later bindings never
// retroactively justify earlier self-calls (fixes precomputed-vars soundness bug).
// Fail-closed: any unrecognizable self-call argument → false.
fn all_self_calls_descend(body: Node, func_name: String, param_name: String, check_child: Bool, check_list: Bool) -> Bool {
  all_self_calls_descend_inc(body: body, func_name: func_name, param_name: param_name, vars: empty_map(), check_child: check_child, check_list: check_list)
}

fn all_self_calls_descend_inc(body: Node, func_name: String, param_name: String, vars: Map<String, Bool>, check_child: Bool, check_list: Bool) -> Bool {
  match body.expr_data {
    // Lambda bodies are iteration-bounded (fold/map/any callbacks).
    // Self-calls inside lambdas don't contribute to branching factor.
    // Skip: callback-local evidence must not justify outer recursion.
    ExprLambda { semantics: _ } => true
    ExprLet =>
      let val = let_value(texpr: body)
      // Check self-calls in the let-value with CURRENT vars (binding not yet visible)
      let val_ok = all_self_calls_descend_inc(body: val, func_name: func_name, param_name: param_name, vars: vars, check_child: check_child, check_list: check_list)
      // Extend vars if val is a descent expression
      let is_direct = (check_child && is_child_descent_expr(expr: val, param_name: param_name))
        || (check_list && is_list_shrink_expr(expr: val, param_name: param_name))
      let is_var = match val.expr_data {
        ExprVar { binding_kind: _ } => set_has(m: vars, key: expr_var_name(texpr: val))
        _ => false
      }
      let is_option = is_if_option_descent(val: val, param_name: param_name, vars: vars, check_child: check_child, check_list: check_list)
      let next_vars = if is_direct || is_var || is_option {
        map_insert(vars, let_binding_name(texpr: body), true)
      } else { vars }
      // Check let-body with EXTENDED vars (binding now visible)
      let body_ok = match let_body(texpr: body) {
        Some { value: b } => all_self_calls_descend_inc(body: b, func_name: func_name, param_name: param_name, vars: next_vars, check_child: check_child, check_list: check_list)
        None => true
      }
      val_ok && body_ok
    ExprMatch =>
      let scrut = match_scrutinee(texpr: body)
      let scrut_ok = all_self_calls_descend_inc(body: scrut, func_name: func_name, param_name: param_name, vars: vars, check_child: check_child, check_list: check_list)
      let scrut_is_descent = expr_contains_descent(expr: scrut, param_name: param_name, vars: vars, check_child: check_child, check_list: check_list)
      // Each arm gets INDEPENDENT vars — arm-local bindings don't leak to siblings
      let arms_ok = match_arm_nodes(texpr: body) |> all(arm_node =>
        let arm_vars = if scrut_is_descent {
          match arm_pattern(n: arm_node) {
            VariantPattern { name: vname, parent_enum: _, field_bindings: bindings } =>
              if vname == "Some" {
                bindings |> fold(init: vars, f: (inner, fb) =>
                  match field_binding_pattern(n: fb) {
                    Bind { name: binding_name } => map_insert(inner, binding_name, true)
                    _ => inner
                  }
                )
              } else { vars }
            Bind { name: binding_name } => map_insert(vars, binding_name, true)
            _ => vars
          }
        } else { vars }
        all_self_calls_descend_inc(body: arm_body(n: arm_node), func_name: func_name, param_name: param_name, vars: arm_vars, check_child: check_child, check_list: check_list)
      )
      scrut_ok && arms_ok
    ExprIf =>
      // Both branches start from the SAME vars — branch-local bindings don't leak
      let cond_ok = all_self_calls_descend_inc(body: if_condition(texpr: body), func_name: func_name, param_name: param_name, vars: vars, check_child: check_child, check_list: check_list)
      let then_ok = all_self_calls_descend_inc(body: if_then_branch(texpr: body), func_name: func_name, param_name: param_name, vars: vars, check_child: check_child, check_list: check_list)
      let else_ok = match if_else_branch(texpr: body) {
        Some { value: eb } => all_self_calls_descend_inc(body: eb, func_name: func_name, param_name: param_name, vars: vars, check_child: check_child, check_list: check_list)
        None => true
      }
      cond_ok && then_ok && else_ok
    ExprBlock =>
      // Thread vars through block statements sequentially
      let result = body.children |> fold(init: DescentCheckAcc { ok: true, vars: vars }, f: (acc, stmt) =>
        if acc.ok == false { acc }
        else {
          let stmt_ok = all_self_calls_descend_inc(body: stmt, func_name: func_name, param_name: param_name, vars: acc.vars, check_child: check_child, check_list: check_list)
          let next_vars = collect_descent_vars(body: stmt, param_name: param_name, vars: acc.vars, check_child: check_child, check_list: check_list)
          DescentCheckAcc { ok: stmt_ok, vars: next_vars }
        }
      )
      result.ok
    ExprCall { call_semantics: _ } =>
      let callee = expr_call_func(texpr: body)
      let own_ok = if callee == func_name {
        body.children |> any(arg_node =>
          let targets_param = arg_name(n: arg_node) == Some { value: param_name }
          if targets_param == false { false }
          else {
            is_descent_arg(expr: arg_value(n: arg_node), param_name: param_name, descent_vars: vars, check_child: check_child, check_list: check_list)
          }
        )
      } else { true }
      own_ok
      && (body.children |> all(child =>
        all_self_calls_descend_inc(body: child, func_name: func_name, param_name: param_name, vars: vars, check_child: check_child, check_list: check_list)
      ))
    _ =>
      body.children |> all(child =>
        all_self_calls_descend_inc(body: child, func_name: func_name, param_name: param_name, vars: vars, check_child: check_child, check_list: check_list)
      )
  }
}

// Peel let/block wrappers to find the outermost match expression.
fn unwrap_to_match(body: Node) -> Node? {
  match body.expr_data {
    ExprMatch => Some { value: body }
    ExprLet =>
      match let_body(texpr: body) {
        Some { value: b } => unwrap_to_match(body: b)
        None => none
      }
    ExprBlock =>
      match body.children |> last {
        Some { value: last_stmt } => unwrap_to_match(body: last_stmt)
        None => none
      }
    _ => none
  }
}

// Check if the body matches on `param_name.expr_data`.
fn matches_on_expr_data(body: Node, param_name: String) -> Bool {
  match unwrap_to_match(body: body) {
    Some { value: m } =>
      let scrut = match_scrutinee(texpr: m)
      match scrut.expr_data {
        ExprFieldAccess =>
          let base = field_access_base(texpr: scrut)
          let field = field_access_field(texpr: scrut)
          field == "expr_data"
          && match base.expr_data {
            ExprVar { binding_kind: _ } => expr_var_name(texpr: base) == param_name
            _ => false
          }
        _ => false
      }
    None => false
  }
}

// CX-1a: Container-child descent. Every self-call must pass
// accessor(param), param.children |> first, or a variable bound to
// such an expression. Accessors always return children[N] (proven by
// the IR model), so the argument is strictly smaller than the param
// regardless of which ExprData variant the param carries.
fn is_container_child_descent(body: Node, func_name: String, params: List<Node>) -> Bool {
  params |> any(p =>
    let pname = param_node_name(n: p)
    // Precondition: body must match on param.expr_data — without this, descent
    // could be inferred from accessor names alone on non-Node values.
    matches_on_expr_data(body: body, param_name: pname)
    && all_self_calls_descend(body: body, func_name: func_name, param_name: pname, check_child: true, check_list: false)
  )
}

// CX-1b: List-shrinkage descent. Every self-call passes param |> skip(N).
// Covers emit_*_block_stmts, kahn_drain with fuel, init_block_stmts.
fn is_list_shrinkage_descent(body: Node, func_name: String, params: List<Node>) -> Bool {
  params |> any(p =>
    let pname = param_node_name(n: p)
    all_self_calls_descend(body: body, func_name: func_name, param_name: pname, check_child: false, check_list: true)
  )
}

// =========================================================================
// T2: Unified proof constructor
//
// Tries each parameter as a candidate ranking dimension (TreeSize,
// ListLength, ArithmeticValue). Returns a TerminationProof if any
// dimension has Strict descent evidence for ALL self-calls.
// =========================================================================

// Check if an expression is `param - N` where N is a positive integer literal.
// Strict arithmetic descent: the value provably decreases by at least 1.
fn is_arithmetic_descent_expr(expr: Node, param_name: String) -> Bool {
  match expr.expr_data {
    ExprBinOp { op: Sub } =>
      let left = binop_left(texpr: expr)
      let right = binop_right(texpr: expr)
      match left.expr_data {
        ExprVar { binding_kind: _ } =>
          expr_var_name(texpr: left) == param_name
          && match right.expr_data {
            ExprLiteral { value: LitInt { value: n } } => n > 0
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

fn classify_self_call_evidence(arg_expr: Node, param_name: String, descent_vars: Map<String, Bool>, check_child: Bool, check_list: Bool) -> DescentEvidence {
  if check_child && is_child_descent_expr(expr: arg_expr, param_name: param_name) { Strict }
  else if check_list && is_list_shrink_expr(expr: arg_expr, param_name: param_name) { Strict }
  // Arithmetic descent only when neither tree nor list dimension is active
  // (prevents n-1 from being misclassified as tree descent)
  else if check_child == false && check_list == false && is_arithmetic_descent_expr(expr: arg_expr, param_name: param_name) { Strict }
  else {
    match arg_expr.expr_data {
      ExprVar { binding_kind: _ } =>
        let vname = expr_var_name(texpr: arg_expr)
        if set_has(m: descent_vars, key: vname) { Strict }
        else if vname == param_name { NonIncreasing }
        else { DescentUnknown }
      _ => DescentUnknown
    }
  }
}

fn try_dimension_for_param(body: Node, func_name: String, param_name: String, check_child: Bool, check_list: Bool) -> DescentEvidence? {
  // INCREMENTAL: threads vars through the body in evaluation order.
  // A binding is only visible AFTER it is defined.
  collect_evidence_incremental(body: body, func_name: func_name, param_name: param_name, vars: empty_map(), check_child: check_child, check_list: check_list)
}

// Merge two optional evidence values (helper for fold accumulation)
fn merge_optional_evidence(a: DescentEvidence?, b: DescentEvidence?) -> DescentEvidence? {
  match a {
    None => b
    Some { value: ea } =>
      match b {
        None => a
        Some { value: eb } => Some { value: merge_evidence(a: ea, b: eb) }
      }
  }
}

// Collect the WORST evidence across all self-calls for a given param/dimension.
// INCREMENTAL: threads descent_vars through the body in evaluation order.
// Lambda bodies are skipped (callback-local evidence must not justify outer recursion).
fn collect_evidence_incremental(body: Node, func_name: String, param_name: String, vars: Map<String, Bool>, check_child: Bool, check_list: Bool) -> DescentEvidence? {
  match body.expr_data {
    // Skip lambda bodies — callback-local evidence must not justify outer recursion
    ExprLambda { semantics: _ } => none
    ExprLet =>
      let val = let_value(texpr: body)
      // Check self-calls in let-value with CURRENT vars (binding not yet visible)
      let val_ev = collect_evidence_incremental(body: val, func_name: func_name, param_name: param_name, vars: vars, check_child: check_child, check_list: check_list)
      // Extend vars if val is descent
      let is_direct = (check_child && is_child_descent_expr(expr: val, param_name: param_name))
        || (check_list && is_list_shrink_expr(expr: val, param_name: param_name))
      let is_var = match val.expr_data {
        ExprVar { binding_kind: _ } => set_has(m: vars, key: expr_var_name(texpr: val))
        _ => false
      }
      let is_option = is_if_option_descent(val: val, param_name: param_name, vars: vars, check_child: check_child, check_list: check_list)
      let next_vars = if is_direct || is_var || is_option {
        map_insert(vars, let_binding_name(texpr: body), true)
      } else { vars }
      // Check let-body with EXTENDED vars (binding now visible)
      let body_ev = match let_body(texpr: body) {
        Some { value: b } => collect_evidence_incremental(body: b, func_name: func_name, param_name: param_name, vars: next_vars, check_child: check_child, check_list: check_list)
        None => none
      }
      merge_optional_evidence(a: val_ev, b: body_ev)
    ExprMatch =>
      let scrut = match_scrutinee(texpr: body)
      let scrut_ev = collect_evidence_incremental(body: scrut, func_name: func_name, param_name: param_name, vars: vars, check_child: check_child, check_list: check_list)
      let scrut_is_descent = expr_contains_descent(expr: scrut, param_name: param_name, vars: vars, check_child: check_child, check_list: check_list)
      // Each arm gets INDEPENDENT vars — arm-local bindings don't leak
      let arms_ev = match_arm_nodes(texpr: body) |> fold(init: none, f: (acc, arm_node) =>
        let arm_vars = if scrut_is_descent {
          match arm_pattern(n: arm_node) {
            VariantPattern { name: vname, parent_enum: _, field_bindings: bindings } =>
              if vname == "Some" {
                bindings |> fold(init: vars, f: (inner, fb) =>
                  match field_binding_pattern(n: fb) {
                    Bind { name: binding_name } => map_insert(inner, binding_name, true)
                    _ => inner
                  }
                )
              } else { vars }
            Bind { name: binding_name } => map_insert(vars, binding_name, true)
            _ => vars
          }
        } else { vars }
        let arm_ev = collect_evidence_incremental(body: arm_body(n: arm_node), func_name: func_name, param_name: param_name, vars: arm_vars, check_child: check_child, check_list: check_list)
        merge_optional_evidence(a: acc, b: arm_ev)
      )
      merge_optional_evidence(a: scrut_ev, b: arms_ev)
    ExprIf =>
      // Both branches start from the SAME vars
      let cond_ev = collect_evidence_incremental(body: if_condition(texpr: body), func_name: func_name, param_name: param_name, vars: vars, check_child: check_child, check_list: check_list)
      let then_ev = collect_evidence_incremental(body: if_then_branch(texpr: body), func_name: func_name, param_name: param_name, vars: vars, check_child: check_child, check_list: check_list)
      let else_ev = match if_else_branch(texpr: body) {
        Some { value: eb } => collect_evidence_incremental(body: eb, func_name: func_name, param_name: param_name, vars: vars, check_child: check_child, check_list: check_list)
        None => none
      }
      merge_optional_evidence(a: cond_ev, b: merge_optional_evidence(a: then_ev, b: else_ev))
    ExprCall { call_semantics: _ } =>
      let callee = expr_call_func(texpr: body)
      let own_evidence = if callee == func_name {
        let arg_evidence = body.children |> fold(init: DescentUnknown, f: (acc, arg_node) =>
          let aname = arg_name(n: arg_node)
          if aname == Some { value: param_name } {
            classify_self_call_evidence(arg_expr: arg_value(n: arg_node), param_name: param_name, descent_vars: vars, check_child: check_child, check_list: check_list)
          } else { acc }
        )
        Some { value: arg_evidence }
      } else { none }
      let child_evidence = body.children |> fold(init: none, f: (acc, child) =>
        let ce = collect_evidence_incremental(body: child, func_name: func_name, param_name: param_name, vars: vars, check_child: check_child, check_list: check_list)
        merge_optional_evidence(a: acc, b: ce)
      )
      merge_optional_evidence(a: own_evidence, b: child_evidence)
    ExprBlock =>
      // Thread vars through block statements sequentially (flat let-bindings).
      let result = body.children |> fold(init: EvidenceBlockAcc { evidence: none, vars: vars }, f: (acc, stmt) =>
        let stmt_ev = collect_evidence_incremental(body: stmt, func_name: func_name, param_name: param_name, vars: acc.vars, check_child: check_child, check_list: check_list)
        let next_vars = match stmt.expr_data {
          ExprLet =>
            let val = let_value(texpr: stmt)
            let is_direct = (check_child && is_child_descent_expr(expr: val, param_name: param_name))
              || (check_list && is_list_shrink_expr(expr: val, param_name: param_name))
            let is_var = match val.expr_data {
              ExprVar { binding_kind: _ } => set_has(m: acc.vars, key: expr_var_name(texpr: val))
              _ => false
            }
            let is_option = is_if_option_descent(val: val, param_name: param_name, vars: acc.vars, check_child: check_child, check_list: check_list)
            if is_direct || is_var || is_option {
              map_insert(acc.vars, let_binding_name(texpr: stmt), true)
            } else { acc.vars }
          _ => acc.vars
        }
        EvidenceBlockAcc { evidence: merge_optional_evidence(a: acc.evidence, b: stmt_ev), vars: next_vars }
      )
      result.evidence
    _ =>
      body.children |> fold(init: none, f: (acc, child) =>
        let ce = collect_evidence_incremental(body: child, func_name: func_name, param_name: param_name, vars: vars, check_child: check_child, check_list: check_list)
        merge_optional_evidence(a: acc, b: ce)
      )
  }
}

fn construct_termination_proof(func_name: String, body: Node, params: List<Node>) -> TerminationProof? {
  // Try each parameter as a candidate ranking dimension
  params |> fold(init: none, f: (best, p) =>
    match best {
      Some { value: _ } => best  // already found a proof
      None =>
        let pname = param_node_name(n: p)
        // Try TreeSize (child accessor descent)
        let tree_evidence = try_dimension_for_param(body: body, func_name: func_name, param_name: pname, check_child: true, check_list: false)
        match tree_evidence {
          Some { value: Strict } =>
            Some { value: TerminationProof { dimensions: [TreeSize { param: pname }] } }
          _ =>
            // Try ListLength (skip/tail descent)
            let list_evidence = try_dimension_for_param(body: body, func_name: func_name, param_name: pname, check_child: false, check_list: true)
            match list_evidence {
              Some { value: Strict } =>
                Some { value: TerminationProof { dimensions: [ListLength { param: pname }] } }
              _ =>
                // Try ArithmeticValue (param - N descent)
                let arith_evidence = try_dimension_for_param(body: body, func_name: func_name, param_name: pname, check_child: false, check_list: false)
                match arith_evidence {
                  Some { value: Strict } =>
                    Some { value: TerminationProof { dimensions: [ArithmeticValue { param: pname }] } }
                  _ => none
                }
            }
        }
    }
  )
}

fn classify_recursion_pattern(func_name: String, body: Node, params: List<Node>, parser_always_advancing: Map<String, Bool>) -> RecursionPattern {
  let path_calls = max_path_self_calls(body: body, func_name: func_name)
  if path_calls == 0 {
    LinearRecursion { iteration_var: concat("n_", func_name) }
  } else {
    // Try proof constructor FIRST — if ALL self-calls descend on children
    // (TreeSize/ListLength), the function is O(n) regardless of path_calls,
    // because children are disjoint subtrees (each node visited once).
    // ArithmeticValue descent (param - N) is only safe for single-call paths;
    // with multiple calls (e.g., fib(n-1) + fib(n-2)) it's O(2^n).
    let proof = construct_termination_proof(func_name: func_name, body: body, params: params)
    let proof_safe_for_branching = match proof {
      Some { value: p } =>
        p.dimensions |> all(dim =>
          match dim {
            TreeSize { param: _ } => true
            ListLength { param: _ } => true
            _ => false
          }
        )
      None => false
    }
    match proof {
      Some { value: _ } =>
        if path_calls == 1 || proof_safe_for_branching {
          LinearRecursion { iteration_var: concat("n_", func_name) }
        } else {
          DivideAndConquer { split_factor: path_calls }
        }
      None =>
        if path_calls > 1 {
          DivideAndConquer { split_factor: path_calls }
        } else {
          // Fall back to old classifiers for single-call patterns
          let initial_witnesses = recursive_measure_param_names(body: body, params: params)
          let descending_witness_names = collect_descending_witness_names(body: body, descending_witness_names: initial_witnesses)
          if self_calls_have_descending_witness(body: body, func_name: func_name, params: params, descending_witness_names: descending_witness_names)
            || self_calls_have_strict_parser_progress(func_name: func_name, body: body, params: params, parser_always_advancing: parser_always_advancing)
            {
            LinearRecursion { iteration_var: concat("n_", func_name) }
          } else {
            UnresolvableRecursion { reason: concat("non-descending recursion in ", func_name) }
          }
        }
    }
  }
}

// Build the bounded cost for a recursive function, given its pattern
// and the raw body cost (which still contains computing placeholders).
fn bounded_recursive_cost(pattern: RecursionPattern, raw_cost: CostExpr, func_name: String) -> CostExpr {
  // Extract per-iteration cost by replacing recursive call with 0
  let per_iter = simplify_cost(expr: replace_computing_ref(
    expr: raw_cost,
    func_name: func_name,
    replacement: CostConst { value: 0 }
  ))
  match pattern {
    LinearRecursion { iteration_var: var } =>
      // Total cost = iterations × per-iteration cost
      CostSum { binder: var, upper: SizeVar { name: var }, body: per_iter }
    DivideAndConquer { split_factor: k } =>
      // Multiple self-calls: work grows as k^depth, not depth*k.
      // CostExpr cannot express exponentials, so report as Unknown.
      // In practice, .dag multiple self-calls occur inside fold over
      // children (tree walks), where the fold CostSum already bounds
      // the recursion. True Fibonacci-style recursion is not expressible
      // in decidable .dag programs.
      CostUnknown { reason: concat("branching recursion (", concat(to_string(k), concat(" self-calls) in ", func_name))) }
    UnresolvableRecursion { reason: r } =>
        CostUnknown { reason: r }
  }
}

fn bounded_scc_cost(pattern: RecursionPattern, raw_cost: CostExpr, members: List<String>) -> CostExpr {
  let per_iter = simplify_cost(expr: replace_computing_refs(
    expr: raw_cost,
    func_names: members,
    replacement: CostConst { value: 0 }
  ))
  match pattern {
    LinearRecursion { iteration_var: var } =>
      CostSum { binder: var, upper: SizeVar { name: var }, body: per_iter }
    DivideAndConquer { split_factor: k } =>
      CostUnknown { reason: concat("branching mutual recursion (", to_string(n: k), " self-calls) in ", scc_label(members: members)) }
    UnresolvableRecursion { reason: r } =>
      CostUnknown { reason: r }
  }
}

fn collect_local_call_edges_in_expr(caller: String, body: Node, local_func_set: Map<String, Bool>) -> List<CallEdge> {
  let this_edges = match body.expr_data {
    ExprCall { call_semantics: _ } =>
      let callee = expr_call_func(texpr: body)
      if set_has(m: local_func_set, key: callee) { [CallEdge { caller: caller, callee: callee }] }
      else { [] }
    _ => []
  }
  let child_edges = body.children |> flat_map(child =>
    collect_local_call_edges_in_expr(caller: caller, body: child, local_func_set: local_func_set)
  )
  concat(this_edges, child_edges)
}

fn build_call_graph(func_entries: List<FuncEntry>) -> CallGraph {
  let names = func_entries |> map(entry => entry.name)
  let local_func_set = names |> fold(init: empty_map(), f: (acc, name) =>
    map_insert(acc, name, true)
  )
  let edges = func_entries |> flat_map(entry =>
    collect_local_call_edges_in_expr(caller: entry.name, body: entry.body, local_func_set: local_func_set)
  )
  let initial_forward = names |> fold(init: empty_map(), f: (acc, name) =>
    map_insert(acc, name, [])
  )
  let initial_reverse = names |> fold(init: empty_map(), f: (acc, name) =>
    map_insert(acc, name, [])
  )
  let graph_acc = edges |> fold(init: CallGraphAcc { forward: initial_forward, reverse: initial_reverse }, f: (acc, edge) =>
    let forward_neighbors = match map_get(acc.forward, edge.caller) {
      Some { value: ns } => ns
      None => []
    }
    let reverse_neighbors = match map_get(acc.reverse, edge.callee) {
      Some { value: ns } => ns
      None => []
    }
    CallGraphAcc {
      forward: map_insert(acc.forward, edge.caller, concat(forward_neighbors, [edge.callee])),
      reverse: map_insert(acc.reverse, edge.callee, concat(reverse_neighbors, [edge.caller]))
    }
  )
  CallGraph { forward: graph_acc.forward, reverse: graph_acc.reverse }
}

fn dfs_finish_order(node: String, adjacency: Map<String, List<String>>, acc: DfsFinishAcc) -> DfsFinishAcc {
  if set_has(m: acc.visited, key: node) {
    acc
  } else {
    let next_visited = map_insert(acc.visited, node, true)
    let neighbors = match map_get(adjacency, node) {
      Some { value: ns } => ns
      None => []
    }
    let explored = neighbors |> fold(init: DfsFinishAcc { visited: next_visited, order: acc.order }, f: (inner, neighbor) =>
      dfs_finish_order(node: neighbor, adjacency: adjacency, acc: inner)
    )
    DfsFinishAcc { visited: explored.visited, order: list_push(explored.order, node) }
  }
}

fn dfs_collect_component(node: String, adjacency: Map<String, List<String>>, acc: SccComponentAcc) -> SccComponentAcc {
  if set_has(m: acc.visited, key: node) {
    acc
  } else {
    let next_visited = map_insert(acc.visited, node, true)
    let next_members = list_push(acc.members, node)
    let neighbors = match map_get(adjacency, node) {
      Some { value: ns } => ns
      None => []
    }
    neighbors |> fold(init: SccComponentAcc { visited: next_visited, members: next_members }, f: (inner, neighbor) =>
      dfs_collect_component(node: neighbor, adjacency: adjacency, acc: inner)
    )
  }
}

fn graph_has_multi_node_scc(names: List<String>, graph: CallGraph) -> Bool {
  let finish = names |> fold(init: DfsFinishAcc { visited: empty_map(), order: [] }, f: (acc, name) =>
    dfs_finish_order(node: name, adjacency: graph.forward, acc: acc)
  )
  let result = finish.order |> reverse |> fold(init: SccCycleAcc { visited: empty_map(), has_cycle: false }, f: (acc, name) =>
    if acc.has_cycle || set_has(m: acc.visited, key: name) {
      acc
    } else {
      let component = dfs_collect_component(node: name, adjacency: graph.reverse, acc: SccComponentAcc { visited: acc.visited, members: [] })
      SccCycleAcc {
        visited: component.visited,
        has_cycle: (component.members |> count) > 1
      }
    }
  )
  result.has_cycle
}

fn scc_label(members: List<String>) -> String {
  match members |> first {
    Some { value: name } => name
    None => "scc"
  }
}

// CX-3: Classify a call to an SCC peer as Strict (accessor/descent),
// Same (unchanged param), or Unknown (fail-closed).
fn classify_scc_call_progress(arg_expr: Node, param_name: String, descent_vars: Map<String, Bool>) -> ProgressKind {
  // Check if arg is a descent expression (accessor or children projection)
  if is_child_descent_expr(expr: arg_expr, param_name: param_name) {
    ProgressStrict
  } else if is_list_shrink_expr(expr: arg_expr, param_name: param_name) {
    ProgressStrict
  } else {
    match arg_expr.expr_data {
      // Variable: check if it's a known descent var or the param itself
      ExprVar { binding_kind: _ } =>
        let vname = expr_var_name(texpr: arg_expr)
        if set_has(m: descent_vars, key: vname) { ProgressStrict }
        else if vname == param_name { ProgressSame }
        else { ProgressUnknown }
      _ => ProgressUnknown
    }
  }
}

// CX-3: Walk a function body and collect progress edges for all calls
// to SCC peers. For each call, check each named argument to see if
// it passes a descent expression for the caller's param.
fn collect_scc_child_edges(body: Node, caller: String, param_name: String, descent_vars: Map<String, Bool>, target_set: Map<String, Bool>) -> List<ParserProgressEdge> {
  match body.expr_data {
    ExprLambda { semantics: _ } => []
    ExprCall { call_semantics: _ } =>
      let callee = expr_call_func(texpr: body)
      let own_edges = if set_has(m: target_set, key: callee) {
        // SCC peer call. Check the argument targeting param_name specifically.
        // Only the argument whose name matches param_name provides evidence —
        // checking ANY argument would fabricate descent proof.
        let progress = body.children |> fold(init: ProgressUnknown, f: (acc, arg_node) =>
          let aname = arg_name(n: arg_node)
          if aname == Some { value: param_name } {
            classify_scc_call_progress(arg_expr: arg_value(n: arg_node), param_name: param_name, descent_vars: descent_vars)
          } else { acc }
        )
        [ParserProgressEdge { caller: caller, callee: callee, progress: progress }]
      } else { [] }
      let child_edges = body.children |> flat_map(child =>
        collect_scc_child_edges(body: child, caller: caller, param_name: param_name, descent_vars: descent_vars, target_set: target_set)
      )
      concat(own_edges, child_edges)
    _ =>
      body.children |> flat_map(child =>
        collect_scc_child_edges(body: child, caller: caller, param_name: param_name, descent_vars: descent_vars, target_set: target_set)
      )
  }
}

// CX-3: SCC container-child descent proof. Every cycle through the SCC
// must have at least one edge where the callee receives an accessor
// child (ProgressStrict). Fail-closed: any ProgressUnknown edge or
// any all-Same cycle means UnresolvableRecursion.
fn is_scc_container_child_descent(members: List<String>, func_index: Map<String, FuncEntry>, scc_name_set: Map<String, Bool>) -> Bool {
  // For each member, try each param as the descent param.
  // Collect edges across all members.
  let edges = members |> flat_map(name =>
    match map_get(func_index, name) {
      Some { value: entry } =>
        // Try each param — the right param will produce known edges,
        // wrong params will produce Unknown edges.
        let best_edges = entry.params |> fold(init: [], f: (best, p) =>
          let pname = param_node_name(n: p)
          let descent_vars = collect_descent_vars(body: entry.body, param_name: pname, vars: empty_map(), check_child: true, check_list: true)
          let param_edges = collect_scc_child_edges(body: entry.body, caller: name, param_name: pname, descent_vars: descent_vars, target_set: scc_name_set)
          // Heuristic: keep the param whose edges have fewest ProgressUnknown.
          // This is a SEARCH heuristic, not a proof obligation — soundness comes
          // from the subsequent same_progress_subgraph_has_cycle check, which
          // rejects any candidate with an all-Same cycle or Unknown edges.
          let unknown_count = param_edges |> filter(e => e.progress == ProgressUnknown) |> count
          let best_unknown = best |> filter(e => e.progress == ProgressUnknown) |> count
          if best |> count == 0 || unknown_count < best_unknown {
            param_edges
          } else { best }
        )
        best_edges
      None => []
    }
  )
  let all_known = edges |> all(edge => edge.progress != ProgressUnknown)
  all_known
  && (edges |> count) > 0
  && same_progress_subgraph_has_cycle(members: members, edges: edges) == false
}

// =========================================================================
// T6: SCC proof constructor with lexicographic dimensions
//
// For each member function, computes DescentEvidence per candidate
// dimension. Tries single dimensions first, then lexicographic pairs.
// Uses proof_has_non_descending_cycle (universal checker from T1).
// =========================================================================

// T6: Classify a single argument's evidence for EACH dimension independently.
// Returns [tree_evidence, list_evidence] for a 2D lexicographic proof.
fn classify_arg_multidim(arg_expr: Node, param_name: String, tree_vars: Map<String, Bool>, list_vars: Map<String, Bool>) -> List<DescentEvidence> {
  let tree_ev = if is_child_descent_expr(expr: arg_expr, param_name: param_name) { Strict }
    else {
      match arg_expr.expr_data {
        ExprVar { binding_kind: _ } =>
          let vname = expr_var_name(texpr: arg_expr)
          if set_has(m: tree_vars, key: vname) { Strict }
          else if vname == param_name { NonIncreasing }
          else { DescentUnknown }
        _ => DescentUnknown
      }
    }
  let list_ev = if is_list_shrink_expr(expr: arg_expr, param_name: param_name) { Strict }
    else {
      match arg_expr.expr_data {
        ExprVar { binding_kind: _ } =>
          let vname = expr_var_name(texpr: arg_expr)
          if set_has(m: list_vars, key: vname) { Strict }
          else if vname == param_name { NonIncreasing }
          else { DescentUnknown }
        _ => DescentUnknown
      }
    }
  [tree_ev, list_ev]
}

// T6: Collect 2D proof edges for an SCC. Each edge has evidence for
// [TreeSize, ListLength] independently. For each call to an SCC peer,
// finds the BEST argument (the one providing the most evidence) per
// dimension.
fn collect_scc_multidim_edges(body: Node, caller: String, param_name: String, tree_vars: Map<String, Bool>, list_vars: Map<String, Bool>, target_set: Map<String, Bool>) -> List<ProofEdge> {
  match body.expr_data {
    ExprLambda { semantics: _ } => []
    ExprCall { call_semantics: _ } =>
      let callee = expr_call_func(texpr: body)
      let own_edges = if set_has(m: target_set, key: callee) {
        // For each argument, compute [tree_ev, list_ev]
        // Take the BEST evidence per dimension across all args
        let best_evidence = body.children |> fold(init: [DescentUnknown, DescentUnknown], f: (best, arg_node) =>
          let arg_ev = classify_arg_multidim(arg_expr: arg_value(n: arg_node), param_name: param_name, tree_vars: tree_vars, list_vars: list_vars)
          // Per dimension: keep the better evidence (Strict > NonIncreasing > Unknown)
          let best_tree = match best |> first {
            Some { value: bt } =>
              match arg_ev |> first {
                Some { value: at } =>
                  match at {
                    Strict => Strict
                    NonIncreasing =>
                      match bt { DescentUnknown => NonIncreasing   _ => bt }
                    DescentUnknown => bt
                  }
                None => bt
              }
            None => DescentUnknown
          }
          let best_list = match best |> skip(1) |> first {
            Some { value: bl } =>
              match arg_ev |> skip(1) |> first {
                Some { value: al } =>
                  match al {
                    Strict => Strict
                    NonIncreasing =>
                      match bl { DescentUnknown => NonIncreasing   _ => bl }
                    DescentUnknown => bl
                  }
                None => bl
              }
            None => DescentUnknown
          }
          [best_tree, best_list]
        )
        [ProofEdge { caller: caller, callee: callee, evidence: best_evidence }]
      } else { [] }
      let child_edges = body.children |> flat_map(child =>
        collect_scc_multidim_edges(body: child, caller: caller, param_name: param_name, tree_vars: tree_vars, list_vars: list_vars, target_set: target_set)
      )
      concat(own_edges, child_edges)
    _ =>
      body.children |> flat_map(child =>
        collect_scc_multidim_edges(body: child, caller: caller, param_name: param_name, tree_vars: tree_vars, list_vars: list_vars, target_set: target_set)
      )
  }
}

// Collect 1D proof edges for a SINGLE dimension. Each ProofEdge has a 1-slot
// evidence list. Only valid for single-dimension proofs — the lexicographic
// path uses collect_scc_independent_dim_edges which builds 2-slot evidence.
fn collect_scc_proof_edges_for_dim(members: List<String>, func_index: Map<String, FuncEntry>, scc_name_set: Map<String, Bool>, check_child: Bool, check_list: Bool) -> List<ProofEdge> {
  members |> flat_map(name =>
    match map_get(func_index, name) {
      Some { value: entry } =>
        let best_edges = entry.params |> fold(init: [], f: (best, p) =>
          let pname = param_node_name(n: p)
          let descent_vars = collect_descent_vars(body: entry.body, param_name: pname, vars: empty_map(), check_child: check_child, check_list: check_list)
          let param_edges = collect_scc_child_edges(body: entry.body, caller: name, param_name: pname, descent_vars: descent_vars, target_set: scc_name_set)
          let as_proof_edges = param_edges |> map(pe =>
            ProofEdge { caller: pe.caller, callee: pe.callee, evidence: [progress_to_evidence(pk: pe.progress)] }
          )
          let unknown_count = param_edges |> filter(e => e.progress == ProgressUnknown) |> count
          let best_unknown = best |> filter(e =>
            match e.evidence |> first {
              Some { value: DescentUnknown } => true
              _ => false
            }
          ) |> count
          if best |> count == 0 || unknown_count < best_unknown {
            as_proof_edges
          } else { best }
        )
        best_edges
      None => []
    }
  )
}

// For each SCC call edge, independently find the best evidence for
// TreeSize and ListLength across ALL params. Different dims can use
// different params (e.g., TreeSize from "texpr", ListLength from "remaining").
fn collect_scc_independent_dim_edges(members: List<String>, func_index: Map<String, FuncEntry>, scc_name_set: Map<String, Bool>) -> List<ProofEdge> {
  members |> flat_map(name =>
    match map_get(func_index, name) {
      Some { value: entry } =>
        // Collect tree-dim edges (best param for tree)
        let tree_edge_map = entry.params |> fold(init: empty_map(), f: (best_map, p) =>
          let pname = param_node_name(n: p)
          let tree_vars = collect_descent_vars(body: entry.body, param_name: pname, vars: empty_map(), check_child: true, check_list: false)
          let param_edges = collect_scc_child_edges(body: entry.body, caller: name, param_name: pname, descent_vars: tree_vars, target_set: scc_name_set)
          param_edges |> fold(init: best_map, f: (bm, pe) =>
            let key = concat(pe.caller, concat("->", pe.callee))
            let existing = map_get(bm, key)
            let new_ev = progress_to_evidence(pk: pe.progress)
            let best_ev = match existing {
              Some { value: prev } =>
                match new_ev { Strict => Strict   NonIncreasing => match prev { DescentUnknown => NonIncreasing  _ => prev }  DescentUnknown => prev }
              None => new_ev
            }
            map_insert(bm, key, best_ev)
          )
        )
        // Collect list-dim edges (best param for list)
        let list_edge_map = entry.params |> fold(init: empty_map(), f: (best_map, p) =>
          let pname = param_node_name(n: p)
          let list_vars = collect_descent_vars(body: entry.body, param_name: pname, vars: empty_map(), check_child: false, check_list: true)
          let param_edges = collect_scc_child_edges(body: entry.body, caller: name, param_name: pname, descent_vars: list_vars, target_set: scc_name_set)
          param_edges |> fold(init: best_map, f: (bm, pe) =>
            let key = concat(pe.caller, concat("->", pe.callee))
            let existing = map_get(bm, key)
            let new_ev = progress_to_evidence(pk: pe.progress)
            let best_ev = match existing {
              Some { value: prev } =>
                match new_ev { Strict => Strict   NonIncreasing => match prev { DescentUnknown => NonIncreasing  _ => prev }  DescentUnknown => prev }
              None => new_ev
            }
            map_insert(bm, key, best_ev)
          )
        )
        // Merge into 2D proof edges
        let all_keys = concat(map_keys(tree_edge_map), map_keys(list_edge_map))
        let unique_keys = all_keys |> fold(init: empty_map(), f: (acc, k) => map_insert(acc, k, true))
        // Build caller/callee lookup from original edges
        let edge_names = entry.params |> flat_map(p =>
          let pname = param_node_name(n: p)
          let tvars = collect_descent_vars(body: entry.body, param_name: pname, vars: empty_map(), check_child: true, check_list: false)
          collect_scc_child_edges(body: entry.body, caller: name, param_name: pname, descent_vars: tvars, target_set: scc_name_set)
        )
        let name_map = edge_names |> fold(init: empty_map(), f: (acc, pe) =>
          map_insert(acc, concat(pe.caller, concat("->", pe.callee)), pe)
        )
        map_keys(unique_keys) |> map(key =>
          let tree_ev = match map_get(tree_edge_map, key) { Some { value: ev } => ev   None => DescentUnknown }
          let list_ev = match map_get(list_edge_map, key) { Some { value: ev } => ev   None => DescentUnknown }
          let caller_name = match map_get(name_map, key) { Some { value: pe } => pe.caller   None => name }
          let callee_name = match map_get(name_map, key) { Some { value: pe } => pe.callee   None => name }
          ProofEdge { caller: caller_name, callee: callee_name, evidence: [tree_ev, list_ev] }
        )
      None => []
    }
  )
}

fn construct_scc_termination_proof(members: List<String>, func_index: Map<String, FuncEntry>, scc_name_set: Map<String, Bool>) -> TerminationProof? {
  // Try single dimensions first
  let tree_edges = collect_scc_proof_edges_for_dim(members: members, func_index: func_index, scc_name_set: scc_name_set, check_child: true, check_list: false)
  let tree_all_known = tree_edges |> all(e =>
    match e.evidence |> first {
      Some { value: DescentUnknown } => false
      _ => true
    }
  )
  if tree_all_known && (tree_edges |> count) > 0 && proof_has_non_descending_cycle(members: members, edges: tree_edges) == false {
    Some { value: TerminationProof { dimensions: [TreeSize { param: "scc" }] } }
  } else {
    let list_edges = collect_scc_proof_edges_for_dim(members: members, func_index: func_index, scc_name_set: scc_name_set, check_child: false, check_list: true)
    let list_all_known = list_edges |> all(e =>
      match e.evidence |> first {
        Some { value: DescentUnknown } => false
        _ => true
      }
    )
    if list_all_known && (list_edges |> count) > 0 && proof_has_non_descending_cycle(members: members, edges: list_edges) == false {
      Some { value: TerminationProof { dimensions: [ListLength { param: "scc" }] } }
    } else {
      // Lexicographic: independently find best tree dim and best list dim per edge
      let lex_edges = collect_scc_independent_dim_edges(members: members, func_index: func_index, scc_name_set: scc_name_set)
      let lex_all_known = lex_edges |> all(e =>
        e.evidence |> any(ev => match ev { DescentUnknown => false   _ => true })
      )
      if lex_all_known && (lex_edges |> count) > 0 && proof_has_non_descending_cycle(members: members, edges: lex_edges) == false {
        Some { value: TerminationProof { dimensions: [TreeSize { param: "scc" }, ListLength { param: "scc" }] } }
      } else {
        none
      }
    }
  }
}

fn classify_scc_recursion_pattern(members: List<String>, func_index: Map<String, FuncEntry>) -> RecursionPattern {
  let scc_name_set = members |> fold(init: empty_map(), f: (acc, name) =>
    map_insert(acc, name, true)
  )
  // T6: Try unified SCC proof constructor first
  let proof = construct_scc_termination_proof(members: members, func_index: func_index, scc_name_set: scc_name_set)
  match proof {
    Some { value: _ } =>
      LinearRecursion { iteration_var: concat("n_", scc_label(members: members)) }
    None =>
      // Fall back to old classifiers
      let scc_measure_params = build_scc_measure_params(members: members, func_index: func_index)
      match classify_parser_scc_recursion_pattern(members: members, func_index: func_index) {
        Some { value: parser_pattern } => parser_pattern
        None =>
          let all_arithmetic = members |> all(name =>
            match map_get(func_index, name) {
              Some { value: entry } =>
                max_path_target_calls(body: entry.body, target_set: scc_name_set) <= 1
                && scc_calls_have_arithmetic_descent(body: entry.body, target_set: scc_name_set, func_index: func_index, scc_measure_params: scc_measure_params)
              None => false
            }
          )
          if all_arithmetic {
            LinearRecursion { iteration_var: concat("n_", scc_label(members: members)) }
          } else {
            UnresolvableRecursion { reason: concat("non-descending mutual recursion in ", scc_label(members: members)) }
          }
      }
  }
}

fn build_scc_index(func_entries: List<FuncEntry>, func_index: Map<String, FuncEntry>) -> Map<String, SccInfo> {
  let names = func_entries |> map(entry => entry.name)
  let graph = build_call_graph(func_entries: func_entries)
  let finish = names |> fold(init: DfsFinishAcc { visited: empty_map(), order: [] }, f: (acc, name) =>
    dfs_finish_order(node: name, adjacency: graph.forward, acc: acc)
  )
  let result = finish.order |> reverse |> fold(init: SccBuildAcc { assigned: empty_map(), index: empty_map() }, f: fn(acc, name) {
    if set_has(m: acc.assigned, key: name) {
      acc
    } else {
      let component = dfs_collect_component(node: name, adjacency: graph.reverse, acc: SccComponentAcc { visited: acc.assigned, members: [] })
      let member_set = component.members |> fold(init: empty_map(), f: (inner, member) =>
        map_insert(inner, member, true)
      )
      let members = names |> filter(member =>
        set_has(m: member_set, key: member)
      )
      let next_assigned = component.visited
      if members |> count > 1 {
        let info = SccInfo {
          members: members,
          member_set: member_set,
          pattern: classify_scc_recursion_pattern(members: members, func_index: func_index)
        }
        let next_index = members |> fold(init: acc.index, f: (inner, member) =>
          map_insert(inner, member, info)
        )
        SccBuildAcc { assigned: next_assigned, index: next_index }
      } else {
        SccBuildAcc { assigned: next_assigned, index: acc.index }
      }
    }
  })
  result.index
}

// Compose two sequential costs.
fn cost_seq(a: CostExpr, b: CostExpr) -> CostExpr {
  CostAdd { left: a, right: b }
}

// Compose two parallel spans (critical path).
fn cost_par(a: CostExpr, b: CostExpr) -> CostExpr {
  CostMax { left: a, right: b }
}

// Loop cost: sum of body over binder from 0 to upper.
fn cost_loop(binder: String, iterations: SizeExpr, body: CostExpr) -> CostExpr {
  CostSum { binder: binder, upper: iterations, body: body }
}

// Conditional cost: condition + max(branches). NOT sum.
fn cost_conditional(condition: CostExpr, branches: List<CostExpr>) -> CostExpr {
  let max_branch = branches |> fold(init: CostConst { value: 0 }, f: fn(acc, b) {
    CostMax { left: acc, right: b }
  })
  CostAdd { left: condition, right: max_branch }
}

// Output size for collection-producing operations: a single "result" entry
// with cost proportional to the collection size.
fn collection_output(binder: String, size: SizeExpr) -> Map<String, CostExpr> {
  let result = map_insert(empty_map(), "result", cost_loop(binder: binder, iterations: size, body: CostConst { value: 1 }))
  result
}

fn scalar_output() -> Map<String, CostExpr> {
  let result = empty_map()
  result
}


// =========================================================================
// Size variable extraction
//
// Chase receiver expressions to find the originating variable name.
// ExprMethodCall chains like `items |> filter(f) |> map(g)` are nested:
// the outermost has receiver = ExprMethodCall(filter, receiver = ExprVar(items)).
// Size-preserving methods (map, filter, etc.) pass through to the inner receiver.
// =========================================================================

fn is_size_preserving_method(method_name: String) -> Bool {
  method_name == "map" || method_name == "filter" || method_name == "flat_map"
  || method_name == "skip" || method_name == "enumerate" || method_name == "sort_by"
  || method_name == "concat" || method_name == "reverse"
}

fn method_preserves_collection_size(method_semantics: MethodSemantics?) -> Bool {
  if method_semantics == none { false }
  else {
    match method_semantics.value {
      AlgebraMethodSemantics { method_def: method_def, fold_accumulator_type: _ } =>
        is_size_preserving_method(method_name: method_def.name)
      _ => false
    }
  }
}

fn receiver_size_var(recv: Node) -> SizeExpr {
  match recv.expr_data {
    ExprVar =>
      SizeLen { collection: expr_var_name(texpr: recv) }
    ExprFieldAccess =>
      SizeLen { collection: field_access_field(texpr: recv) }
    ExprMethodCall { method_semantics: method_semantics } =>
      let inner_recv = match recv.children |> first { Some { value: r } => r  None => recv }
      if method_preserves_collection_size(method_semantics: method_semantics) {
        receiver_size_var(recv: inner_recv)
      } else {
        SizeLen { collection: "__expr" }
      }
    _ =>
      SizeLen { collection: "__expr" }
  }
}

fn size_binder_name(size: SizeExpr) -> String {
  match size {
    SizeLen { collection: c } => concat("_", c)
    SizeVar { name: n } => n
    _ => "_i"
  }
}

// =========================================================================
// CostShape dispatch -- compute cost from reconcile-provided shape
//
// Each CostShape maps to a specific cost pattern:
//   ShapeIterateBody  -- O(|receiver| * body_cost), loop over collection
//   ShapeSortBody     -- O(|receiver| * log(|receiver|) * key_cost), Proven
//   ShapeLinearScan   -- O(|receiver|) with O(1) per element
//   ShapeConstant     -- O(1) regardless of input size
// =========================================================================

fn resolve_lambda_arg(mc_arg_nodes: List<Node>) -> Node? {
  let f_arg = mc_arg_nodes |> filter(a => a.name == "f") |> first
  match f_arg {
    Some { value: fa } => Some { value: arg_value(n: fa) }
    None => mc_arg_nodes |> map(a => arg_value(n: a)) |> first
  }
}

fn resolve_callback_cost(lambda_arg: Node?, recv_r: SummaryResult, func_index: Map<String, FuncEntry>, scc_index: Map<String, SccInfo>, parser_always_advancing: Map<String, Bool>, recursion_ctx: RecursionContext) -> SummaryResult {
  match lambda_arg {
    Some { value: la } =>
      match la.expr_data {
        ExprVar =>
          let fn_ref = expr_var_name(texpr: la)
          match map_get(func_index, fn_ref) {
            Some { value: _ } =>
              get_or_compute_summary(func_name: fn_ref, func_index: func_index, scc_index: scc_index, table: recv_r.table, parser_always_advancing: parser_always_advancing, recursion_ctx: recursion_ctx)
            None =>
              cost_of_expr(texpr: la, func_index: func_index, scc_index: scc_index, table: recv_r.table, parser_always_advancing: parser_always_advancing, recursion_ctx: recursion_ctx)
          }
        _ =>
          cost_of_expr(texpr: la, func_index: func_index, scc_index: scc_index, table: recv_r.table, parser_always_advancing: parser_always_advancing, recursion_ctx: recursion_ctx)
      }
    None =>
      SummaryResult {
        summary: ComplexitySummary {
          work: CostConst { value: 1 },
          span: CostConst { value: 1 },
          output_size: empty_map(),
          certainty: Conservative
        },
        table: recv_r.table
      }
  }
}

fn cost_of_method_by_shape(shape: CostShape, recv_r: SummaryResult, mc_args: List<Node>, size: SizeExpr, binder: String, func_index: Map<String, FuncEntry>, scc_index: Map<String, SccInfo>, parser_always_advancing: Map<String, Bool>, recursion_ctx: RecursionContext) -> SummaryResult {
  match shape {
    ShapeIterateBody { produces_collection: pc } =>
      let lambda_arg = resolve_lambda_arg(mc_args: mc_args)
      let body_result = resolve_callback_cost(lambda_arg: lambda_arg, recv_r: recv_r, func_index: func_index, scc_index: scc_index, parser_always_advancing: parser_always_advancing, recursion_ctx: recursion_ctx)
      let loop_work = cost_loop(binder: binder, iterations: size, body: body_result.summary.work)
      // Space: non-producing iterators (fold/any/all) produce scalar or body output;
      // producing iterators (map/filter/etc.) produce proportional output
      let os = if pc == false {
        // fold: use body's output_size; any/all: scalar
        body_result.summary.output_size
      } else {
        let r = map_insert(empty_map(), "result", cost_loop(binder: binder, iterations: size, body: CostConst { value: 1 }))
        r
      }
      SummaryResult {
        summary: ComplexitySummary {
          work: cost_seq(a: recv_r.summary.work, b: loop_work),
          span: cost_seq(a: recv_r.summary.span, b: loop_work),
          output_size: os,
          certainty: body_result.summary.certainty
        },
        table: body_result.table
      }
    ShapeSortBody =>
      // Comparison sort is O(n log n × key_cost). CostLog makes this
      // expressible as a tight Proven bound.
      let lambda_arg = resolve_lambda_arg(mc_args: mc_args)
      let key_result = match lambda_arg {
        Some { value: la } =>
          cost_of_expr(texpr: la, func_index: func_index, scc_index: scc_index, table: recv_r.table, parser_always_advancing: parser_always_advancing, recursion_ctx: recursion_ctx)
        None =>
          SummaryResult {
            summary: ComplexitySummary {
              work: CostConst { value: 1 },
              span: CostConst { value: 1 },
              output_size: empty_map(),
              certainty: Proven
            },
            table: recv_r.table
          }
      }
      // O(n × log(n) × key_cost)
      let log_factor = CostLog { base: 2, argument: size }
      let per_comparison = key_result.summary.work
      let sort_work = CostMul {
        left: cost_loop(binder: binder, iterations: size, body: per_comparison),
        right: log_factor
      }
      let sort_os = map_insert(empty_map(), "result", cost_loop(binder: binder, iterations: size, body: CostConst { value: 1 }))
      SummaryResult {
        summary: ComplexitySummary {
          work: cost_seq(a: recv_r.summary.work, b: sort_work),
          span: cost_seq(a: recv_r.summary.span, b: sort_work),
          output_size: sort_os,
          certainty: key_result.summary.certainty
        },
        table: key_result.table
      }
    ShapeLinearScan { produces_collection: pc } =>
      let loop_work = cost_loop(binder: binder, iterations: size, body: CostConst { value: 1 })
      let scan_os = if pc {
        let r = map_insert(empty_map(), "result", cost_loop(binder: binder, iterations: size, body: CostConst { value: 1 }))
        r
      } else {
        let r = empty_map()
        r
      }
      SummaryResult {
        summary: ComplexitySummary {
          work: cost_seq(a: recv_r.summary.work, b: loop_work),
          span: cost_seq(a: recv_r.summary.span, b: loop_work),
          output_size: scan_os,
          certainty: recv_r.summary.certainty
        },
        table: recv_r.table
      }
    ShapeConstant =>
      SummaryResult {
        summary: ComplexitySummary {
          work: cost_seq(a: recv_r.summary.work, b: CostConst { value: 1 }),
          span: cost_seq(a: recv_r.summary.span, b: CostConst { value: 1 }),
          output_size: empty_map(),
          certainty: recv_r.summary.certainty
        },
        table: recv_r.table
      }
  }
}

// =========================================================================
// D4: Complexity reporting
// =========================================================================

type ComplexityViolation {
  func_name: String
  reason: String
  summary: ComplexitySummary?
  span: SourceSpan
}

type ComplexityReport {
  function_summaries: Map<String, ComplexitySummary>
  violations: List<ComplexityViolation>
  intern_table: CostInternTable
}

fn empty_complexity_report() -> ComplexityReport {
  ComplexityReport {
    function_summaries: empty_map(),
    violations: [],
    intern_table: empty_intern_table()
  }
}

// =========================================================================
// Cost simplification
//
// Constant folding and zero/one elimination. Applied to summaries before
// caching so the stored CostExpr trees are compact.
// =========================================================================

fn simplify_cost(expr: CostExpr) -> CostExpr {
  match expr {
    CostConst { value: _ } => expr
    CostUnknown { reason: _ } => expr
    CostAdd { left: l, right: r } =>
      let sl = simplify_cost(expr: l)
      let sr = simplify_cost(expr: r)
      let simplified = match sl {
        CostConst { value: 0 } => sr
        CostConst { value: a } => match sr {
          CostConst { value: 0 } => sl
          CostConst { value: b } => CostConst { value: a + b }
          _ => CostAdd { left: sl, right: sr }
        }
        _ => match sr {
          CostConst { value: 0 } => sl
          _ => CostAdd { left: sl, right: sr }
        }
      }
      simplified
    CostMul { left: l, right: r } =>
      let sl = simplify_cost(expr: l)
      let sr = simplify_cost(expr: r)
      let simplified = match sl {
        CostConst { value: 0 } => CostConst { value: 0 }
        CostConst { value: 1 } => sr
        _ => match sr {
          CostConst { value: 0 } => CostConst { value: 0 }
          CostConst { value: 1 } => sl
          _ => CostMul { left: sl, right: sr }
        }
      }
      simplified
    CostMax { left: l, right: r } =>
      let sl = simplify_cost(expr: l)
      let sr = simplify_cost(expr: r)
      let simplified = match sl {
        CostConst { value: 0 } => sr
        CostConst { value: a } => match sr {
          CostConst { value: 0 } => sl
          CostConst { value: b } => if a > b { sl } else { sr }
          _ => CostMax { left: sl, right: sr }
        }
        _ => match sr {
          CostConst { value: 0 } => sl
          _ => CostMax { left: sl, right: sr }
        }
      }
      simplified
    CostSum { binder: b, upper: u, body: bd } =>
      let sbd = simplify_cost(expr: bd)
      match sbd {
        CostConst { value: 0 } => CostConst { value: 0 }
        _ => CostSum { binder: b, upper: u, body: sbd }
      }
    CostLog { base: b, argument: a } => CostLog { base: b, argument: a }
  }
}

// =========================================================================
// Asymptotic normalization and formatting
//
// CostExpr is the single authority for complexity. Classification is
// asymptotic normalization: collapse all positive constants to 1 and
// re-simplify so identity elements absorb. The normalized CostExpr IS
// the complexity class. Formatting reads CostExpr directly.
// =========================================================================

fn format_size(size: SizeExpr) -> String {
  match size {
    SizeLen { collection: c } => concat("|", c, "|")
    SizeVar { name: n } => n
    SizeConst { value: v } => to_string(v)
    SizeAdd { left: l, right: r } => concat(format_size(size: l), " + ", format_size(size: r))
    SizeMax { left: l, right: r } => concat("max(", format_size(size: l), ", ", format_size(size: r), ")")
  }
}

// Collapse all positive constants to 1 so re-simplification absorbs them.
fn normalize_asymptotic(expr: CostExpr) -> CostExpr {
  simplify_cost(expr: normalize_constants(expr: expr))
}

fn normalize_constants(expr: CostExpr) -> CostExpr {
  match expr {
    CostConst { value: v } =>
      if v <= 0 { CostConst { value: 0 } } else { CostConst { value: 1 } }
    CostUnknown { reason: _ } => expr
    CostAdd { left: l, right: r } =>
      CostAdd { left: normalize_constants(expr: l), right: normalize_constants(expr: r) }
    CostMul { left: l, right: r } =>
      CostMul { left: normalize_constants(expr: l), right: normalize_constants(expr: r) }
    CostMax { left: l, right: r } =>
      CostMax { left: normalize_constants(expr: l), right: normalize_constants(expr: r) }
    CostSum { binder: b, upper: u, body: bd } =>
      CostSum { binder: b, upper: u, body: normalize_constants(expr: bd) }
    CostLog { base: b, argument: a } => CostLog { base: b, argument: a }
  }
}

// Format a normalized CostExpr as an O(...) string.
fn format_cost_class(expr: CostExpr) -> String {
  match expr {
    CostConst { value: _ } => "O(1)"
    CostUnknown { reason: _ } => "O(?)"
    CostSum { binder: _, upper: u, body: bd } =>
      match bd {
        CostConst { value: _ } => concat("O(", format_size(size: u), ")")
        _ => concat("O(", format_size(size: u), " * ", format_cost_inner(expr: bd), ")")
      }
    CostAdd { left: l, right: r } =>
      concat("O(", format_cost_inner(expr: l), " + ", format_cost_inner(expr: r), ")")
    CostMul { left: l, right: r } =>
      concat("O(", parenthesize_additive_cost(expr: l), " * ", parenthesize_additive_cost(expr: r), ")")
    CostMax { left: l, right: r } =>
      concat("O(max(", format_cost_inner(expr: l), ", ", format_cost_inner(expr: r), "))")
    CostLog { base: _, argument: a } => concat("O(log ", format_size(size: a), ")")
  }
}

fn format_cost_inner(expr: CostExpr) -> String {
  match expr {
    CostConst { value: _ } => "1"
    CostUnknown { reason: _ } => "?"
    CostSum { binder: _, upper: u, body: bd } =>
      match bd {
        CostConst { value: _ } => format_size(size: u)
        _ => concat(format_size(size: u), " * ", format_cost_inner(expr: bd))
      }
    CostAdd { left: l, right: r } =>
      concat(format_cost_inner(expr: l), " + ", format_cost_inner(expr: r))
    CostMul { left: l, right: r } =>
      let left_str = match l {
        CostAdd { left: _, right: _ } => concat("(", format_cost_inner(expr: l), ")")
        _ => format_cost_inner(expr: l)
      }
      let right_str = match r {
        CostAdd { left: _, right: _ } => concat("(", format_cost_inner(expr: r), ")")
        _ => format_cost_inner(expr: r)
      }
      concat(left_str, " * ", right_str)
    CostMax { left: l, right: r } =>
      concat("max(", format_cost_inner(expr: l), ", ", format_cost_inner(expr: r), ")")
    CostLog { base: _, argument: a } => concat("log ", format_size(size: a))
  }
}

fn parenthesize_additive_cost(expr: CostExpr) -> String {
  match expr {
    CostAdd { left: _, right: _ } =>
      concat("(", format_cost_inner(expr: expr), ")")
    _ => format_cost_inner(expr: expr)
  }
}

fn classify_complexity(expr: CostExpr) -> String {
  format_cost_class(expr: normalize_asymptotic(expr: simplify_cost(expr: expr)))
}

// Collect all SizeLen collection names from a CostExpr tree for the "where" clause.
fn collect_size_vars_from_size(size: SizeExpr) -> List<String> {
  match size {
    SizeLen { collection: c } =>
      if c == "__expr" { [] } else { [c] }
    SizeAdd { left: l, right: r } =>
      concat(collect_size_vars_from_size(size: l), collect_size_vars_from_size(size: r))
    SizeMax { left: l, right: r } =>
      concat(collect_size_vars_from_size(size: l), collect_size_vars_from_size(size: r))
    _ => []
  }
}

fn collect_size_vars(expr: CostExpr) -> List<String> {
  match expr {
    CostSum { binder: _, upper: u, body: bd } =>
      concat(collect_size_vars_from_size(size: u), collect_size_vars(expr: bd))
    CostAdd { left: l, right: r } =>
      concat(collect_size_vars(expr: l), collect_size_vars(expr: r))
    CostMul { left: l, right: r } =>
      concat(collect_size_vars(expr: l), collect_size_vars(expr: r))
    CostMax { left: l, right: r } =>
      concat(collect_size_vars(expr: l), collect_size_vars(expr: r))
    CostLog { base: _, argument: a } =>
      collect_size_vars_from_size(size: a)
    _ => []
  }
}

// Deduplicate a list of strings using a map accumulator.
type DeduplicateAcc {
  seen: Map<String, Bool>
  out: List<String>
}

fn deduplicate(items: List<String>) -> List<String> {
  let result = items |> fold(init: DeduplicateAcc { seen: empty_map(), out: [] }, f: fn(acc, item) {
    match map_get(acc.seen, item) {
      Some { value: _ } => acc
      None => DeduplicateAcc {
        seen: map_insert(acc.seen, item, true),
        out: list_push(acc.out, item)
      }
    }
  })
  result.out
}


// =========================================================================
// D2: Lazy cached summary computation
//
// get_or_compute_summary checks the cache first. On miss, walks the
// function body to build a CostExpr for work/span/output_size, interns
// the result, and caches the summary.
//
// FuncEntry is a lightweight representation of a function for the
// complexity analyzer: name + body Node. Threaded alongside the
// CostInternTable so recursive callee lookups can find function bodies.
// =========================================================================

type FuncEntry {
  name: String
  body: Node
  params: List<Node>
  span: SourceSpan
}

// Module-owned recursion facts: shared authority for all functions.
// Built once from the merged TypeEnv across all compiled modules,
// not copied per-function.
// Note: recursive_type_set was removed (unused downstream — the complexity
// analyzer operates on Node structure, not type-name lookups).
type RecursionContext {
}

// Result of get_or_compute_summary: updated table + the summary.
type SummaryResult {
  summary: ComplexitySummary
  table: CostInternTable
}

type MatchCostAccum {
  result: SummaryResult
  branch_costs: List<CostExpr>
}

// Walk a single expression and produce its CostExpr for work.
fn cost_of_expr(texpr: Node, func_index: Map<String, FuncEntry>, scc_index: Map<String, SccInfo>, table: CostInternTable, parser_always_advancing: Map<String, Bool>, recursion_ctx: RecursionContext) -> SummaryResult {
  match texpr.expr_data {
    ExprLiteral { value: _ } =>
      SummaryResult {
        summary: ComplexitySummary {
          work: CostConst { value: 1 },
          span: CostConst { value: 1 },
          output_size: empty_map(),
          certainty: Proven
        },
        table: table
      }

    ExprError { kind: _, message: _ } =>
      SummaryResult {
        summary: ComplexitySummary {
          work: CostConst { value: 0 },
          span: CostConst { value: 0 },
          output_size: empty_map(),
          certainty: Proven
        },
        table: table
      }

    ExprVar =>
      SummaryResult {
        summary: ComplexitySummary {
          work: CostConst { value: 1 },
          span: CostConst { value: 1 },
          output_size: empty_map(),
          certainty: Proven
        },
        table: table
      }

    ExprBinOp { op: _ } =>
      let l = binop_left(texpr: texpr)
      let r = binop_right(texpr: texpr)
      let lr = cost_of_expr(texpr: l, func_index: func_index, scc_index: scc_index, table: table, parser_always_advancing: parser_always_advancing, recursion_ctx: recursion_ctx)
      let rr = cost_of_expr(texpr: r, func_index: func_index, scc_index: scc_index, table: lr.table, parser_always_advancing: parser_always_advancing, recursion_ctx: recursion_ctx)
      SummaryResult {
        summary: ComplexitySummary {
          work: cost_seq(a: lr.summary.work, b: cost_seq(a: CostConst { value: 1 }, b: rr.summary.work)),
          span: cost_seq(a: lr.summary.span, b: cost_seq(a: CostConst { value: 1 }, b: rr.summary.span)),
          output_size: empty_map(),
          certainty: Proven
        },
        table: rr.table
      }

    ExprCall =>
      // Look up callee summary (recursive via get_or_compute_summary)
      let fname = expr_call_func(texpr: texpr)
      let callee_result = match map_get(func_index, fname) {
        Some { value: entry } =>
          get_or_compute_summary(func_name: fname, func_index: func_index, scc_index: scc_index, table: table, parser_always_advancing: parser_always_advancing, recursion_ctx: recursion_ctx)
        None =>
          SummaryResult {
            summary: ComplexitySummary {
              work: CostConst { value: 1 },
              span: CostConst { value: 1 },
              output_size: empty_map(),
              certainty: Proven
            },
            table: table
          }
      }
      // Accumulate arg costs via node.children (arg nodes)
      let args_result = texpr.children |> fold(init: SummaryResult {
        summary: ComplexitySummary {
          work: CostConst { value: 0 },
          span: CostConst { value: 0 },
          output_size: empty_map(),
          certainty: Proven
        },
        table: callee_result.table
      }, f: fn(acc, a) {
        let ar = cost_of_expr(texpr: arg_value(n: a), func_index: func_index, scc_index: scc_index, table: acc.table, parser_always_advancing: parser_always_advancing, recursion_ctx: recursion_ctx)
        SummaryResult {
          summary: ComplexitySummary {
            work: cost_seq(a: acc.summary.work, b: ar.summary.work),
            span: cost_seq(a: acc.summary.span, b: ar.summary.span),
            output_size: empty_map(),
            certainty: Proven
          },
          table: ar.table
        }
      })
      SummaryResult {
        summary: ComplexitySummary {
          work: cost_seq(a: args_result.summary.work, b: callee_result.summary.work),
          span: cost_seq(a: args_result.summary.span, b: callee_result.summary.span),
          output_size: callee_result.summary.output_size,
          certainty: callee_result.summary.certainty
        },
        table: args_result.table
      }

    ExprMethodCall { method_semantics: ms } =>
      let recv = method_receiver(texpr: texpr)
      let mc_args = method_arg_nodes(texpr: texpr)
      let recv_r = cost_of_expr(texpr: recv, func_index: func_index, scc_index: scc_index, table: table, parser_always_advancing: parser_always_advancing, recursion_ctx: recursion_ctx)
      let size = receiver_size_var(recv: recv)
      let binder = size_binder_name(size: size)
      // Dispatch on reconcile-provided method semantics.
      // AlgebraMethodSemantics carries the method name; look up intrinsic index for CostShape.
      // Bridge methods (not in intrinsic index) are O(1).
      // Plain/Service/None fall through to default cost.
      let method_cost_result = if ms == none { none } else {
        match ms.value {
          AlgebraMethodSemantics { method_def: md, fold_accumulator_type: _ } => {
            let md_name = md.name
            let shape_match = method_cost_shape(method_name: md_name)
            match shape_match {
              Some { value: shape } =>
                Some { value: cost_of_method_by_shape(shape: shape, recv_r: recv_r, mc_args: mc_args, size: size, binder: binder, func_index: func_index, scc_index: scc_index, parser_always_advancing: parser_always_advancing, recursion_ctx: recursion_ctx) }
              None =>
                // All methods not in the known set (bridge methods) are O(1)
                Some { value: SummaryResult {
                  summary: ComplexitySummary {
                    work: cost_seq(a: recv_r.summary.work, b: CostConst { value: 1 }),
                    span: cost_seq(a: recv_r.summary.span, b: CostConst { value: 1 }),
                    output_size: empty_map(),
                    certainty: recv_r.summary.certainty
                  },
                  table: recv_r.table
                } }
            }
          }
          _ => none
        }
      }
      // PlainMethodSemantics, ServiceMethodSemantics, or no semantics:
      // receiver cost + 1 for the method + arg costs
      match method_cost_result {
        Some { value: result } => result
        _ =>
        let args_result = mc_args |> fold(init: SummaryResult {
          summary: ComplexitySummary {
            work: CostConst { value: 0 },
            span: CostConst { value: 0 },
            output_size: empty_map(),
            certainty: Proven
          },
          table: recv_r.table
        }, f: fn(acc, a) {
          let ar = cost_of_expr(texpr: arg_value(n: a), func_index: func_index, scc_index: scc_index, table: acc.table, parser_always_advancing: parser_always_advancing, recursion_ctx: recursion_ctx)
          SummaryResult {
            summary: ComplexitySummary {
              work: cost_seq(a: acc.summary.work, b: ar.summary.work),
              span: cost_seq(a: acc.summary.span, b: ar.summary.span),
              output_size: empty_map(),
              certainty: Proven
            },
            table: ar.table
          }
        })
        SummaryResult {
          summary: ComplexitySummary {
            work: cost_seq(a: recv_r.summary.work, b: cost_seq(a: CostConst { value: 1 }, b: args_result.summary.work)),
            span: cost_seq(a: recv_r.summary.span, b: cost_seq(a: CostConst { value: 1 }, b: args_result.summary.span)),
            output_size: empty_map(),
            certainty: Proven
          },
          table: args_result.table
        }
      }

    ExprMatch =>
      let scrut = match_scrutinee(texpr: texpr)
      let arm_nodes = match_arm_nodes(texpr: texpr)
      let s_r = cost_of_expr(texpr: scrut, func_index: func_index, scc_index: scc_index, table: table, parser_always_advancing: parser_always_advancing, recursion_ctx: recursion_ctx)
      let arms_accum = arm_nodes |> fold(init: MatchCostAccum {
        result: SummaryResult {
          summary: ComplexitySummary {
            work: CostConst { value: 0 },
            span: CostConst { value: 0 },
            output_size: empty_map(),
            certainty: Proven
          },
          table: s_r.table
        },
        branch_costs: []
      }, f: fn(acc, arm_node) {
        let ar = cost_of_expr(texpr: arm_body(n: arm_node), func_index: func_index, scc_index: scc_index, table: acc.result.table, parser_always_advancing: parser_always_advancing, recursion_ctx: recursion_ctx)
        MatchCostAccum {
          result: SummaryResult {
            summary: ComplexitySummary {
              work: cost_par(a: acc.result.summary.work, b: ar.summary.work),
              span: cost_par(a: acc.result.summary.span, b: ar.summary.span),
              output_size: ar.summary.output_size,
              certainty: ar.summary.certainty
            },
            table: ar.table
          },
          branch_costs: concat(acc.branch_costs, [ar.summary.work])
        }
      })
      SummaryResult {
        summary: ComplexitySummary {
          work: cost_conditional(condition: s_r.summary.work, branches: arms_accum.branch_costs),
          span: cost_conditional(condition: s_r.summary.span, branches: [arms_accum.result.summary.span]),
          output_size: arms_accum.result.summary.output_size,
          certainty: arms_accum.result.summary.certainty
        },
        table: arms_accum.result.table
      }

    ExprIf =>
      let c = if_condition(texpr: texpr)
      let t = if_then_branch(texpr: texpr)
      let c_r = cost_of_expr(texpr: c, func_index: func_index, scc_index: scc_index, table: table, parser_always_advancing: parser_always_advancing, recursion_ctx: recursion_ctx)
      let t_r = cost_of_expr(texpr: t, func_index: func_index, scc_index: scc_index, table: c_r.table, parser_always_advancing: parser_always_advancing, recursion_ctx: recursion_ctx)
      let e_result = match if_else_branch(texpr: texpr) {
        Some { value: eb } =>
          let er = cost_of_expr(texpr: eb, func_index: func_index, scc_index: scc_index, table: t_r.table, parser_always_advancing: parser_always_advancing, recursion_ctx: recursion_ctx)
          SummaryResult {
            summary: er.summary,
            table: er.table
          }
        None =>
          SummaryResult {
            summary: ComplexitySummary {
              work: CostConst { value: 0 },
              span: CostConst { value: 0 },
              output_size: empty_map(),
              certainty: Proven
            },
            table: t_r.table
          }
      }
      // Space: in well-typed code all branches produce same type; use then-branch output
      SummaryResult {
        summary: ComplexitySummary {
          work: cost_conditional(condition: c_r.summary.work, branches: [t_r.summary.work, e_result.summary.work]),
          span: cost_conditional(condition: c_r.summary.span, branches: [t_r.summary.span, e_result.summary.span]),
          output_size: t_r.summary.output_size,
          certainty: Proven
        },
        table: e_result.table
      }

    ExprLet =>
      let v = let_value(texpr: texpr)
      let v_r = cost_of_expr(texpr: v, func_index: func_index, scc_index: scc_index, table: table, parser_always_advancing: parser_always_advancing, recursion_ctx: recursion_ctx)
      match let_body(texpr: texpr) {
        Some { value: b } =>
          let b_r = cost_of_expr(texpr: b, func_index: func_index, scc_index: scc_index, table: v_r.table, parser_always_advancing: parser_always_advancing, recursion_ctx: recursion_ctx)
          SummaryResult {
            summary: ComplexitySummary {
              work: cost_seq(a: v_r.summary.work, b: b_r.summary.work),
              span: cost_seq(a: v_r.summary.span, b: b_r.summary.span),
              output_size: b_r.summary.output_size,
              certainty: b_r.summary.certainty
            },
            table: b_r.table
          }
        None => v_r
      }

    ExprBlock =>
      texpr.children |> fold(init: SummaryResult {
        summary: ComplexitySummary {
          work: CostConst { value: 0 },
          span: CostConst { value: 0 },
          output_size: empty_map(),
          certainty: Proven
        },
        table: table
      }, f: fn(acc, s) {
        let sr = cost_of_expr(texpr: s, func_index: func_index, scc_index: scc_index, table: acc.table, parser_always_advancing: parser_always_advancing, recursion_ctx: recursion_ctx)
        SummaryResult {
          summary: ComplexitySummary {
            work: cost_seq(a: acc.summary.work, b: sr.summary.work),
            span: cost_seq(a: acc.summary.span, b: sr.summary.span),
            output_size: sr.summary.output_size,
            certainty: sr.summary.certainty
          },
          table: sr.table
        }
      })

    ExprForEach =>
      let c = foreach_collection(texpr: texpr)
      let bd = foreach_body(texpr: texpr)
      let c_r = cost_of_expr(texpr: c, func_index: func_index, scc_index: scc_index, table: table, parser_always_advancing: parser_always_advancing, recursion_ctx: recursion_ctx)
      let bd_r = cost_of_expr(texpr: bd, func_index: func_index, scc_index: scc_index, table: c_r.table, parser_always_advancing: parser_always_advancing, recursion_ctx: recursion_ctx)
      let size = receiver_size_var(recv: c)
      let binder = size_binder_name(size: size)
      let loop_work = cost_loop(binder: binder, iterations: size, body: bd_r.summary.work)
      SummaryResult {
        summary: ComplexitySummary {
          work: cost_seq(a: c_r.summary.work, b: loop_work),
          span: cost_seq(a: c_r.summary.span, b: loop_work),
          output_size: empty_map(),
          certainty: bd_r.summary.certainty
        },
        table: bd_r.table
      }

    NoExprData =>
      // Wrapper nodes are zero-cost -- just recurse through children.
      texpr.children |> fold(init: SummaryResult {
        summary: ComplexitySummary {
          work: CostConst { value: 0 },
          span: CostConst { value: 0 },
          output_size: empty_map(),
          certainty: Proven
        },
        table: table
      }, f: fn(acc, child) {
        let cr = cost_of_expr(texpr: child, func_index: func_index, scc_index: scc_index, table: acc.table, parser_always_advancing: parser_always_advancing, recursion_ctx: recursion_ctx)
        SummaryResult {
          summary: ComplexitySummary {
            work: cost_seq(a: acc.summary.work, b: cr.summary.work),
            span: cost_seq(a: acc.summary.span, b: cr.summary.span),
            output_size: cr.summary.output_size,
            certainty: cr.summary.certainty
          },
          table: cr.table
        }
      })
    // All remaining variants: sequential cost over node.children.
    // Handles Return, FieldAccess, UnaryOp, Lambda, RecordLit, ListLit,
    // StringInterp, Cast, Index, Slice, BinOp.
    _ =>
      texpr.children |> fold(init: SummaryResult {
        summary: ComplexitySummary {
          work: CostConst { value: 1 },
          span: CostConst { value: 1 },
          output_size: empty_map(),
          certainty: Proven
        },
        table: table
      }, f: fn(acc, child) {
        let cr = cost_of_expr(texpr: child, func_index: func_index, scc_index: scc_index, table: acc.table, parser_always_advancing: parser_always_advancing, recursion_ctx: recursion_ctx)
        SummaryResult {
          summary: ComplexitySummary {
            work: cost_seq(a: acc.summary.work, b: cr.summary.work),
            span: cost_seq(a: acc.summary.span, b: cr.summary.span),
            output_size: cr.summary.output_size,
            certainty: cr.summary.certainty
          },
          table: cr.table
        }
      })
  }
}

// Get or compute the complexity summary for a function.
// Checks cache first; on miss, walks the body and caches the result.
fn estimate_expr_size(texpr: Node, budget: Int) -> Int {
  if budget <= 0 { 0 }
  else {
    // Walk children structurally. Each child decrements budget by 1.
    texpr.children |> fold(init: budget - 1, f: (acc, child) =>
      estimate_expr_size(texpr: child, budget: acc)
    )
  }
}

fn get_or_compute_summary(func_name: String, func_index: Map<String, FuncEntry>, scc_index: Map<String, SccInfo>, table: CostInternTable, parser_always_advancing: Map<String, Bool>, recursion_ctx: RecursionContext) -> SummaryResult {
  // Check cache first
  match lookup_summary(table: table, func_name: func_name) {
    Some { value: cached } =>
      SummaryResult { summary: cached, table: table }
    None =>
      // Look up function body
      match map_get(func_index, func_name) {
        Some { value: entry } =>
          // No body-size budget: the caching/placeholder mechanism prevents
          // exponential analysis, and the decidability invariant guarantees
          // all functions terminate. Skipping large functions produces false
          // violations on the most important functions to analyze.
          {
            // Insert a placeholder to prevent infinite recursion on self-recursive functions
            let placeholder = ComplexitySummary {
              work: CostUnknown { reason: concat("computing: ", func_name) },
              span: CostUnknown { reason: concat("computing: ", func_name) },
              output_size: empty_map(),
              certainty: Unknown
            }
            let table_with_placeholder = cache_summary(table: table, func_name: func_name, summary: placeholder)
            // Walk the function body
            let result = cost_of_expr(texpr: entry.body, func_index: func_index, scc_index: scc_index, table: table_with_placeholder, parser_always_advancing: parser_always_advancing, recursion_ctx: recursion_ctx)
            // Detect and classify self-recursion: if the result cost still
            // contains the "computing: func_name" placeholder, the function
            // is recursive. Classify the pattern and produce a bounded cost.
            let is_recursive = cost_contains_computing_ref(expr: result.summary.work, func_name: func_name)
            let scc_bounded = match map_get(scc_index, func_name) {
              Some { value: info } =>
                if cost_contains_any_computing_ref(expr: result.summary.work, func_names: info.members) {
                  Some { value: ComplexitySummary {
                    work: bounded_scc_cost(pattern: info.pattern, raw_cost: result.summary.work, members: info.members),
                    span: bounded_scc_cost(pattern: info.pattern, raw_cost: result.summary.span, members: info.members),
                    output_size: result.summary.output_size,
                    certainty: Conservative
                  } }
                } else {
                  none
                }
              None => none
            }
            let bounded = match scc_bounded {
              Some { value: summary } => summary
              None =>
                if is_recursive {
                  let pattern = classify_recursion_pattern(
                    func_name: func_name,
                    body: entry.body,
                    params: entry.params,
                    parser_always_advancing: parser_always_advancing
                  )
                  ComplexitySummary {
                    work: bounded_recursive_cost(pattern: pattern, raw_cost: result.summary.work, func_name: func_name),
                    span: bounded_recursive_cost(pattern: pattern, raw_cost: result.summary.span, func_name: func_name),
                    output_size: result.summary.output_size,
                    certainty: Conservative
                  }
                } else {
                  result.summary
                }
            }
            // Simplify and cache the real summary
            let simplified = ComplexitySummary {
              work: simplify_cost(expr: bounded.work),
              span: simplify_cost(expr: bounded.span),
              output_size: bounded.output_size,
              certainty: bounded.certainty
            }
            let final_table = cache_summary(table: result.table, func_name: func_name, summary: simplified)
            SummaryResult { summary: simplified, table: final_table }
          }
        None =>
          // Unknown function -- return unknown cost
          let unknown_summary = ComplexitySummary {
            work: CostUnknown { reason: concat("function not found: ", func_name) },
            span: CostUnknown { reason: concat("function not found: ", func_name) },
            output_size: empty_map(),
            certainty: Unknown
          }
          SummaryResult { summary: unknown_summary, table: table }
      }
  }
}

// =========================================================================
// D4: Complexity reporting
//
// build_complexity_report takes function entries, computes summaries
// for each, and collects violations (CostUnknown summaries).
// =========================================================================

// Recursive walk: CostUnknown composes into trees (CostAdd, CostMul, etc.)
// so a flat root check would miss nested unknowns. The cost algebra composes
// correctly; the violation query must follow the composition.
// Extract the reason from the first CostUnknown found anywhere in a cost tree.
// Checks both branches of binary cost nodes — the unknown may be nested
// on either side of CostAdd/CostMul/CostMax compositions.
fn first_unknown_reason(expr: CostExpr) -> String {
  match expr {
    CostUnknown { reason: r } => r
    CostAdd { left: l, right: r } =>
      let lr = first_unknown_reason(expr: l)
      if lr != "unknown" { lr } else { first_unknown_reason(expr: r) }
    CostMul { left: l, right: r } =>
      let lr = first_unknown_reason(expr: l)
      if lr != "unknown" { lr } else { first_unknown_reason(expr: r) }
    CostMax { left: l, right: r } =>
      let lr = first_unknown_reason(expr: l)
      if lr != "unknown" { lr } else { first_unknown_reason(expr: r) }
    CostSum { binder: _, upper: _, body: b } => first_unknown_reason(expr: b)
    _ => "unknown"
  }
}

fn should_emit_unknown_violation(func_name: String, scc_index: Map<String, SccInfo>) -> Bool {
  match map_get(scc_index, func_name) {
    Some { value: info } =>
      match info.pattern {
        LinearRecursion { iteration_var: _ } => true
        _ => func_name == scc_label(members: info.members)
      }
    None => true
  }
}

fn is_unknown_cost(expr: CostExpr) -> Bool {
  match expr {
    CostUnknown { reason: _ } => true
    CostAdd { left: l, right: r } => is_unknown_cost(expr: l) || is_unknown_cost(expr: r)
    CostMul { left: l, right: r } => is_unknown_cost(expr: l) || is_unknown_cost(expr: r)
    CostMax { left: l, right: r } => is_unknown_cost(expr: l) || is_unknown_cost(expr: r)
    CostSum { binder: _, upper: _, body: b } => is_unknown_cost(expr: b)
    _ => false
  }
}

fn build_complexity_report(func_entries: List<FuncEntry>, recursion_ctx: RecursionContext) -> ComplexityReport {
  // Build function index for callee lookups
  let func_index = func_entries |> fold(init: empty_map(), f: (acc, entry) =>
    map_insert(acc, entry.name, entry)
  )
  let scc_index = build_scc_index(func_entries: func_entries, func_index: func_index)
  let parser_always_advancing = infer_all_parser_always_advancing(func_index: func_index)
  // Compute summaries for all functions
  let result = func_entries |> fold(init: SummaryResult {
    summary: ComplexitySummary {
      work: CostConst { value: 0 },
      span: CostConst { value: 0 },
      output_size: empty_map(),
      certainty: Proven
    },
    table: empty_intern_table()
  }, f: fn(acc, entry) {
    let sr = get_or_compute_summary(func_name: entry.name, func_index: func_index, scc_index: scc_index, table: acc.table, parser_always_advancing: parser_always_advancing, recursion_ctx: recursion_ctx)
    SummaryResult { summary: sr.summary, table: sr.table }
  })
  // Collect function summaries and violations
  let summaries_map = result.table.summaries
  let violations = func_entries |> filter(entry =>
    match map_get(summaries_map, entry.name) {
      Some { value: summary } =>
        if is_unknown_cost(expr: summary.work) {
          should_emit_unknown_violation(func_name: entry.name, scc_index: scc_index)
        } else {
          false
        }
      None => true
    }
  ) |> map(entry =>
    match map_get(summaries_map, entry.name) {
      Some { value: summary } =>
        let reason = first_unknown_reason(expr: summary.work)
        ComplexityViolation {
          func_name: entry.name,
          reason: reason,
          summary: Some { value: summary },
          span: entry.span
        }
      None =>
        ComplexityViolation {
          func_name: entry.name,
          reason: "no summary computed",
          summary: none,
          span: entry.span
        }
    }
  )
  ComplexityReport {
    function_summaries: summaries_map,
    violations: violations,
    intern_table: result.table
  }
}
