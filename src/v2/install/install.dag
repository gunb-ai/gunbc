// src/v2/install/install.dag
// Scope: gunbc binary-distribution substrate AS DATA. install.dag COMPOSES the prerequisite
//        substrate (v2.std.platform vocabulary, v2.std.target_triple constants, v2.extdeps
//        .platform_detection mappings) into release-domain facts: InstallTarget (triple ×
//        archive extension × install path × env policy), InstallChannel coproduct (GitHub
//        Releases tarball, Homebrew formula, deb package, apt repo, cargo install), and the
//        Phase 1 published-target list. Single authority (DESIGN.md §3).
//        Per parent-session guidance (snappy-bee-513, 2026-05-29): general types live in std/ +
//        extdeps/, NOT inlined here. install.dag adds only the release-domain composition.
// Status: Release Jun1 Phase 1b substrate — modeled 2026-05-29 (operator brief: "all common
//         platforms modeled/supported from day 1 — this should all be modeled properly in .dag").
//         Lowerings (release.yml build matrix, install.sh, install.ps1, Formula.rb, .deb metadata)
//         project FROM these carriers in later phases.
// Release phases: Phase 1 GitHub Releases; Phase 2 Homebrew; Phase 3 apt/deb;
//         Phase 4 cargo install.

module v2.install.install


import v2.std.collection { List }
import v2.std.node { Symbol }
import v2.std.platform { Linux, Macos, OperatingSystem, Windows }
import v2.std.target_triple {
  TargetTriple,
  tier1_macos_aarch64,
  tier1_macos_x86_64,
  tier1_windows_x86_64_msvc,
  tier2_linux_aarch64_musl,
  tier2_linux_x86_64_musl,
  tier2_windows_aarch64_msvc
}
import v2.std.text { String }


// Anchor: gunb-ai/the-gunbai understanding/rust_targets.rs asset_patterns::extensions. Archive
// extension is a per-target fact because the convention is Linux/macOS → tar.gz and Windows →
// zip; modeled as a closed coproduct so the channel-emit lens can select the extension
// structurally rather than from a string field.
// 🟢 coproduct dissolution — ArchiveExtension.
type ArchiveExtension
  = TarGz
  | TarXz
  | Zip
  | Zst


// Install-prefix policy — the path each platform installs the gunbc binary under by default.
// Closed coproduct because the path is OS-conventional, not user-configurable at this layer
// (`/usr/local/bin` on POSIX, `%LOCALAPPDATA%\Programs\gunbc` on Windows). Per-channel overrides
// (Homebrew's `bin.install` Cellar path, .deb's `/usr/bin`) layer on top of this default.
// 🟢 coproduct dissolution — InstallPrefixPolicy.
type InstallPrefixPolicy
  = PosixUsrLocalBin              // /usr/local/bin/gunbc — install.sh default.
  | WindowsLocalAppDataPrograms   // %LOCALAPPDATA%\Programs\gunbc\gunbc.exe — install.ps1 default.
  | HomebrewCellarBin             // $(brew --prefix)/bin/gunbc — set by Formula's bin.install.
  | DebUsrBin                     // /usr/bin/gunbc — Debian policy default for arch-binary packages.


// Environment-variable policy — what the installer touches on $PATH / %PATH%. The Phase 1
// install.sh prepends nothing because /usr/local/bin is on $PATH by convention; install.ps1
// must add %LOCALAPPDATA%\Programs\gunbc to %PATH% because that location is not on PATH by
// default.
// 🟢 coproduct dissolution — EnvPathPolicy.
type EnvPathPolicy
  = NoPathMutation                // POSIX install.sh: install dir is already on $PATH.
  | AppendToUserPath              // Windows install.ps1: setx PATH to include install dir.


// Anchor: Phase 1 build matrix. InstallTarget is the per-platform composition
// the release pipeline iterates over; it pins the (TargetTriple × archive extension × install
// prefix × env policy) tuple a single channel-emitter consumes for one platform.
type InstallTarget {
  triple: TargetTriple
  archive_extension: ArchiveExtension
  install_prefix: InstallPrefixPolicy
  env_path_policy: EnvPathPolicy
  // GitHub Releases asset filename identity. Resolved by the release-asset-naming projection
  // lens to <name>-<version>-<triple>.<ext> when the release tag is known; carried as a Symbol
  // identity slot so the substrate is content-addressable before the version is pinned.
  // 🟡 needs-more-work — feature:install-asset-naming-projection-lens — dissolve-on: an
  // emit-time lens projects the asset filename from triple + ArchiveExtension + release tag;
  // this field becomes derived rather than declared.
  asset_identity: Symbol
}


// Anchor: Phase 1–4. Distribution channels — closed set of mechanisms users
// run to obtain gunbc; each variant carries the channel-specific configuration the downstream
// emitter consumes.
// 🟢 coproduct dissolution — InstallChannel.
type InstallChannel
  = GitHubReleaseTarball {
      // Anchor: https://docs.github.com/en/repositories/releasing-projects-on-github.
      // 🟡 needs-more-work — feature:shell-static-install-script-emit — bind release
      // Phase 1 · dissolve-on: install.sh + install.ps1 are projected from a typed shell AST
      // (ShellStatic / PowerShellStatic emit gate) that consumes targets + UnameArchMapping
      // (v2.extdeps.platform_detection); hand-authored install.sh disappears.
      release_tag_authority: Symbol
      install_script_posix_name: String
      install_script_powershell_name: String
      targets: List<InstallTarget>
    }
  | HomebrewFormula {
      // Anchor: https://docs.brew.sh/Formula-Cookbook.
      // 🟡 needs-more-work — feature:homebrew-formula-emit — bind release Phase 2 ·
      // dissolve-on: Formula.rb is projected from a typed Ruby AST that consumes the targets
      // list + per-target sha256 carriers; hand-authored Formula.rb disappears.
      tap_repo_identity: Symbol
      formula_class_name: String
      formula_homepage: String
      targets: List<InstallTarget>
    }
  | DebPackage {
      // Anchor: https://www.debian.org/doc/debian-policy/ — Debian Policy Manual control-fields
      // chapter. Debian arch names (amd64 / arm64) project FROM Architecture by the emitter.
      // 🟡 needs-more-work — feature:deb-control-metadata-emit — bind release
      // Phase 3 · dissolve-on: cargo-deb (or equivalent) metadata is projected from this
      // carrier; hand-authored [package.metadata.deb] table in Cargo.toml disappears.
      package_section: String
      package_priority: String
      targets: List<InstallTarget>
    }
  | AptRepository {
      // Anchor: https://wiki.debian.org/DebianRepository/Format. Distinct from DebPackage
      // because the repo adds Release/InRelease metadata + a hosting boundary; the .deb is the
      // unit, the apt repo is the distribution.
      // 🟡 needs-more-work — feature:apt-repo-metadata-emit — bind release Phase 3 ·
      // dissolve-on: Release / InRelease / Packages.gz are projected from this carrier; hand-
      // authored sources.list snippet disappears.
      repo_root_authority: Symbol
      suite_name: String
      component_name: String
    }
  | CargoInstall {
      // Anchor: https://doc.rust-lang.org/cargo/commands/cargo-install.html.
      // 🟡 needs-more-work — feature:cargo-publish-metadata-emit — bind release
      // Phase 4 · dissolve-on: Cargo.toml [package] publish metadata (description / license /
      // repository / publish flag) is projected from this carrier; hand-authored workspace-
      // member publish audit disappears.
      crate_name: String
      registry_authority: Symbol
    }


// Phase 1 published-target slots. Identity Symbols pinned here; the release-asset-naming lens
// resolves them at projection time.
// 🟡 needs-more-work — feature:release-dag-published-target-authority — dissolve-on:
// src/v2/release/release.dag lands `release_published_target_triples` (per parent-session
// guidance 2026-05-29); install.dag imports from there rather than redeclaring the published
// subset.
data install_target_x86_64_linux_musl: InstallTarget = InstallTarget {
  triple: tier2_linux_x86_64_musl,
  archive_extension: TarGz,
  install_prefix: PosixUsrLocalBin,
  env_path_policy: NoPathMutation,
  asset_identity: ^x86_64_unknown_linux_musl_asset
}

data install_target_aarch64_linux_musl: InstallTarget = InstallTarget {
  triple: tier2_linux_aarch64_musl,
  archive_extension: TarGz,
  install_prefix: PosixUsrLocalBin,
  env_path_policy: NoPathMutation,
  asset_identity: ^aarch64_unknown_linux_musl_asset
}

data install_target_x86_64_macos: InstallTarget = InstallTarget {
  triple: tier1_macos_x86_64,
  archive_extension: TarGz,
  install_prefix: PosixUsrLocalBin,
  env_path_policy: NoPathMutation,
  asset_identity: ^x86_64_apple_darwin_asset
}

data install_target_aarch64_macos: InstallTarget = InstallTarget {
  triple: tier1_macos_aarch64,
  archive_extension: TarGz,
  install_prefix: PosixUsrLocalBin,
  env_path_policy: NoPathMutation,
  asset_identity: ^aarch64_apple_darwin_asset
}

data install_target_x86_64_windows_msvc: InstallTarget = InstallTarget {
  triple: tier1_windows_x86_64_msvc,
  archive_extension: Zip,
  install_prefix: WindowsLocalAppDataPrograms,
  env_path_policy: AppendToUserPath,
  asset_identity: ^x86_64_pc_windows_msvc_asset
}

data install_target_aarch64_windows_msvc: InstallTarget = InstallTarget {
  triple: tier2_windows_aarch64_msvc,
  archive_extension: Zip,
  install_prefix: WindowsLocalAppDataPrograms,
  env_path_policy: AppendToUserPath,
  asset_identity: ^aarch64_pc_windows_msvc_asset
}


// Phase 1 GitHub Releases build matrix — the four musl/darwin targets named verbatim in
// the release plan Phase 1. Windows targets are modeled (per operator "all common platforms
// from day 1") and ship via the same channel as Phase 1.5 / Phase 2; downstream channel
// projections filter by readiness gate.
data release_published_targets: List<InstallTarget> = [
  install_target_x86_64_linux_musl,
  install_target_aarch64_linux_musl,
  install_target_x86_64_macos,
  install_target_aarch64_macos,
  install_target_x86_64_windows_msvc,
  install_target_aarch64_windows_msvc
]


// Channel inhabitants. Channels whose hosting / registry identity is not yet pinned (apt repo
// root, crates.io registry symbol, release tag) carry slot Symbols that resolve when infra
// lands.
data github_release_tarball_channel: InstallChannel = GitHubReleaseTarball {
  release_tag_authority: ^gunbc_release_tag_v0_1_0,
  install_script_posix_name: "install.sh",
  install_script_powershell_name: "install.ps1",
  targets: release_published_targets
}

data homebrew_formula_channel: InstallChannel = HomebrewFormula {
  tap_repo_identity: ^gunbc_homebrew_tap_repo,
  formula_class_name: "Gunbc",
  formula_homepage: "https://github.com/gunb-ai/gunbc",
  targets: [
    install_target_x86_64_linux_musl,
    install_target_aarch64_linux_musl,
    install_target_x86_64_macos,
    install_target_aarch64_macos
  ]
}

data deb_package_channel: InstallChannel = DebPackage {
  package_section: "devel",
  package_priority: "optional",
  targets: [
    install_target_x86_64_linux_musl,
    install_target_aarch64_linux_musl
  ]
}

data apt_repository_channel: InstallChannel = AptRepository {
  repo_root_authority: ^gunbc_apt_repo_root,
  suite_name: "stable",
  component_name: "main"
}

data cargo_install_channel: InstallChannel = CargoInstall {
  crate_name: "gunbc",
  registry_authority: ^crates_io_registry
}


// The full set of channels the June 1+ release plan covers. Ordered by release phase
// (Phase 1 → Phase 4); downstream tooling that picks "which channel to project today" reads
// this list and filters by readiness gate (substrate carrier only; per-channel readiness flags
// land when each emitter does — see the 🟡 gates inside each InstallChannel variant).
data gunbc_install_channels: List<InstallChannel> = [
  github_release_tarball_channel,
  homebrew_formula_channel,
  deb_package_channel,
  apt_repository_channel,
  cargo_install_channel
]
