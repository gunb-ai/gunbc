// `check-references`: EVERY MARKED DECLARATION REFERENCE IN THE BOUND TREES' ANNOTATIONS RESOLVES.
//
// THE SOURCE POPULATION is every module the declared namespace rows store under the bound trees
// (`enumerate_bound_modules`, the population `parse-population` walks). Each is read, and a module
// whose text contains the marker spelling is LEXED -- not parsed: an annotation is a lexical capture
// (DESIGN 4c), so the check needs the comment channel and nothing the parser adds. Each capture's raw
// lexeme goes through the one extractor, std.annotation_reference annotation_references. Only the
// extracted sites are kept, so memory follows the citations and not the population.
//
// THE SPELLING TEST IS EXACT, NOT A HEURISTIC. Every marker -- resolving, broken or escaped -- is a
// substring of its file's text, so a module whose text does not contain the marker spelling has no
// marker in any of its annotations, and not lexing it loses no finding. It is what keeps the cost at
// one read per module plus one lex per CITING module, instead of a second lex of the whole population
// beside parse-population's. What it does not do is judge whether a non-citing module lexes: that is
// parse-population's question, walked over the same population.
//
// THE TARGET UNIVERSE is the modules the citations name, read under the same storage rule over the
// same bound trees, plus one re-export hop (v2.compiler.live_resolution_context). It is built from the
// cited modules only, never by resolving the corpus: a citation is not an import, so citing a module
// adds nothing to any compilation and a comment can cite above its own module's layer without
// creating an edge. Resolution is the native resolver, v2.std.decl_ref_resolution
// resolve_declaration_ref, the arm decided by that context.
//
// EVERY CITATION THAT CANNOT BE JUDGED FAILS THE CHECK, and its line says why: a cited module that
// does not read (absent file, unbound tree, unreadable) carries the reader's own cause; one that
// reads but does not normalize says so; neither is relabelled "does not exist". A population member
// that cannot be read or lexed fails the check too, because a population that silently lost a
// member would certify fewer comments than it names. Type-parameter citations parse but are not
// resolved by this version: they report UnsupportedTarget rather than reading as a missing field.
//
// WHAT RESOLVING ESTABLISHES is existence: the cited declaration (and field) is there and unique.
// It says nothing about the prose around the marker, which stays best-effort and deletable.

type ReferenceSite {
  file: String
  site: AnnotationReference
}

type MalformedSite {
  file: String
  marker: MalformedReferenceMarker
}

type ReferenceWalk {
  members: Int
  lexed: Int
  annotations: Int
  sites: List<ReferenceSite>
  target_sites: List<ReferenceWalkCaller>
  malformed: List<MalformedSite>
  unread: List<String>
}

fn reference_walk_empty() -> ReferenceWalk {
  ReferenceWalk { members: 0, lexed: 0, annotations: 0, sites: [], target_sites: [], malformed: [], unread: [] }
}

fn reference_walk_unread(walk: ReferenceWalk, line: String) -> ReferenceWalk {
  ReferenceWalk { members: walk.members, lexed: walk.lexed, annotations: walk.annotations, sites: walk.sites, target_sites: walk.target_sites, malformed: walk.malformed, unread: list_snoc_item(xs: walk.unread, item: line) }
}

fn reference_walk_annotations(walk: ReferenceWalk, file: String, annotations: List<UnboundSourceAnnotation>) -> ReferenceWalk {
  let extracted = fold_list(
    xs: annotations,
    empty: annotation_reference_extraction_empty(),
    cons: fn(acc, a) { annotation_reference_extraction_concat(left: acc, right: annotation_references_text(text: a.lexeme, start: a.start)) }
  )
  ReferenceWalk {
    members: walk.members,
    lexed: walk.lexed + 1,
    annotations: walk.annotations + length(xs: annotations),
    sites: fold_list(xs: extracted.references, empty: walk.sites, cons: fn(acc, r) { list_snoc_item(xs: acc, item: ReferenceSite { file: file, site: r }) }),
    target_sites: walk.target_sites,
    malformed: fold_list(xs: extracted.malformed, empty: walk.malformed, cons: fn(acc, m) { list_snoc_item(xs: acc, item: MalformedSite { file: file, marker: m }) }),
    unread: walk.unread,
  }
}

fn reference_walk_member(env: AcquisitionEnv, name: String, walk: ReferenceWalk) -> ReferenceWalk {
  match population_member(layout: env.layout, bindings: env.bindings, name: name) {
    PopulationMemberRefused { cause: cause } => reference_walk_unread(walk: walk, line: concat(name, ": not read: ", cause))
    PopulationMemberRead { member: member } =>
      reference_walk_read(env: env, caller: name, file: module_file_key(file: member.file), content: member.content, walk: reference_walk_counted(walk: walk))
  }
}

fn reference_walk_counted(walk: ReferenceWalk) -> ReferenceWalk {
  ReferenceWalk { members: walk.members + 1, lexed: walk.lexed, annotations: walk.annotations, sites: walk.sites, target_sites: walk.target_sites, malformed: walk.malformed, unread: walk.unread }
}

// A module is worth tokenizing if it spells the @ref marker (annotation citations) OR the run-step-target
// constructor call (a run-time entry to resolve). Either spelling is an EXACT substring pre-filter -- never a
// pattern, never a regex, never a heuristic (v2.compiler::the_cost_of_a_grammars_lexical_rulesets_bound_binds_its_lexers_admission):
// a module with neither contains nothing to extract, and a substring cannot false-negative.
fn reference_walk_read(env: AcquisitionEnv, caller: String, file: String, content: String, walk: ReferenceWalk) -> ReferenceWalk {
  let has_marker = string_contains(s: content, pattern: annotation_reference_marker)
  let has_target = string_contains(s: content, pattern: run_step_target_call_spelling)
  if !has_marker && !has_target {
    walk
  } else {
      match tokenize_artifact_prepared(text: content, file: symbol_intern_lexeme(lexeme: file), prepared: env.lex) {
        Rejected { diagnostics: _ } => reference_walk_unread(walk: walk, line: concat(file, ": not lexed, so its annotations and run-step targets were not observed"))
        Accepted { value: artifact, diagnostics: _ } =>
          reference_walk_target_sites(walk: reference_walk_annotations(walk: walk, file: file, annotations: if has_marker { lex_artifact_annotations(artifact: artifact) } else { [] }), file: file, caller: caller, artifact: artifact)
      }
  }
}

fn reference_walk_go(env: AcquisitionEnv, pending: List<String>, walk: ReferenceWalk) -> ReferenceWalk {
  match pending {
    Empty => walk
    Cons { head: name, tail: rest } => reference_walk_go(env: env, pending: rest, walk: reference_walk_member(env: env, name: name, walk: walk))
  }
}

// ---- run-step-target sites ---------------------------------------------------------------------
//
// A run-step target is a GunbcRunStepTarget built by the ONE constructor
// gunbc.ci.ci_run_step_target gunbc_run_step_target(module:, function:). The (module, function) pair names a
// declaration a workflow step runs at CI time; a typo there is invisible to the compiler (the step file does
// not import the target module, so import resolution never sees the name) and only fails when the step RUNS.
// The module half is already checked at emit by gunbc.source_layout layout_module_storage_path; the entry half
// was unchecked. Enrolling it here resolves the pair through the SAME target universe and native resolver the
// @ref markers use, so a bad entry refuses in the required job (rung 2, mechanically preventable -- DESIGN
// "A rung is a mechanism's job, and the only way up the ladder is to build it").
//
// A call is a SITE only when its callee resolves, in this check's OWN ResolutionContext and through the
// caller's imports, to that one constructor's declaring home -- not any call lexically named the same
// (DESIGN closed_grounded_substrate: a heuristic is never necessary; identity, not spelling). The symbol index
// binds an imported name at the importing module's position and a local declaration at the module itself, so a
// same-named local fn, or a same-named fn imported from elsewhere, resolves to a DIFFERENT declaring home and is
// not a site; only the real constructor resolves here. Both arguments must be string literals: a non-literal
// entry is exactly the un-checkable route this check exists to close, so it refuses typed rather than being
// skipped (never-skip is why the mint subject now carries a typed mint_target rather than two loose strings).
data gunbc_run_step_target_home_module: String = "gunbc.ci.ci_run_step_target"
data gunbc_run_step_target_constructor_name: String = "gunbc_run_step_target"
data run_step_target_call_spelling: String = "gunbc_run_step_target("
data run_step_target_module_label: String = "module"
data run_step_target_function_label: String = "function"

type RunStepTargetArg
  = RunStepTargetLiteral { value: String }
  | RunStepTargetNotLiteral { text: String }

type RunStepTargetSite {
  file: String
  caller: String
  start: Int
  module_arg: RunStepTargetArg
  function_arg: RunStepTargetArg
}

// A module whose text spells the constructor, queued for the AST walk. The check reads call STRUCTURE from
// the module's already-normalized AST (`NormalizedTree.root`, the corpus's one grammar) -- never a second
// token matcher. This queue only records WHICH modules to walk; the decision is made from the AST.
type ReferenceWalkCaller {
  caller: String
  file: String
}

fn reference_walk_target_sites(walk: ReferenceWalk, file: String, caller: String, artifact: LexArtifact) -> ReferenceWalk {
  let spells = run_step_target_text_spells_constructor(tokens: token_stream_all(stream: lex_artifact_semantic_tokens(artifact: artifact)))
  ReferenceWalk {
    members: walk.members,
    lexed: walk.lexed,
    annotations: walk.annotations,
    sites: walk.sites,
    target_sites: if spells { list_snoc_item(xs: walk.target_sites, item: ReferenceWalkCaller { caller: caller, file: file }) } else { walk.target_sites },
    malformed: walk.malformed,
    unread: walk.unread
  }
}

// The prefilter keys on the constructor IDENTIFIER, not the identifier plus `(`, so a call written
// `gunbc_run_step_target (` (a space before the paren) is still a candidate. The decision itself is AST-only.
fn run_step_target_text_spells_constructor(tokens: List<Token>) -> Bool {
  fold_list(xs: tokens, empty: false, cons: fn(acc, tok) { if acc { true } else { tok.lexeme == gunbc_run_step_target_constructor_name } })
}

// A labeled child of an already-parsed call node, read by the label's LEXEME (so a keyword label matches
// whatever token class it interned as). Read, never skipped: zero, one, or many are all accounted for --
// zero (absent label) and many (repeated label) both become typed refusals at the site, never a silent pass.
fn run_step_target_named_child_nodes(node: Node, label: String) -> List<Node> {
  fold_list(xs: node.children, empty: [], cons: fn(acc, e) {
    match e.label {
      Authored { name: n } => if symbol_lexeme(sym: n) == label { list_snoc_item(xs: acc, item: e.target) } else { acc }
      _ => acc
    }
  })
}

// Read one argument of a constructor call. A string-literal node yields its literal; anything else -- a
// variable, a concat, a parameter, an absent label, a repeated label -- is a NOT-LITERAL that refuses, never
// a skip. Literalness is the corpus's declared string-literal node test (the inverse of the literal builder),
// never a shape heuristic: the corpus warns a reference and a literal can share a shape.
fn run_step_target_arg_of_label(node: Node, label: String) -> RunStepTargetArg {
  match run_step_target_named_child_nodes(node: node, label: label) {
    Empty => RunStepTargetNotLiteral { text: concat("<", label, " absent>") }
    Cons { head: n, tail: t } =>
      if is_empty(xs: t) {
        match dag_string_literal_value_optional(node: n) {
          Present { value: v } => RunStepTargetLiteral { value: v }
          Absent => RunStepTargetNotLiteral { text: concat("<", label, " not a string literal>") }
        }
      } else {
        RunStepTargetNotLiteral { text: concat("<", label, " repeated>") }
      }
  }
}

// One call node becomes a site iff its head is an atom spelling the constructor; the (module, function) pair
// is then read from the call's labeled children. An application head that is not the constructor, or a node
// that is not an application, contributes nothing (the fold continues).
fn run_step_target_site_of_call(caller: String, file: String, node: Node) -> Optional<RunStepTargetSite> {
  match application_head_read(site: node) {
    ApplicationHeadFound { head: _, head_identity: AtomHead { identity: id }, operands: _ } =>
      if symbol_lexeme(sym: id) == gunbc_run_step_target_constructor_name {
        Present {
          value: RunStepTargetSite {
            file: file,
            caller: caller,
            start: node_occurrence_id_ceiling(node: node, floor: 0),
            module_arg: run_step_target_arg_of_label(node: node, label: run_step_target_module_label),
            function_arg: run_step_target_arg_of_label(node: node, label: run_step_target_function_label)
          }
        }
      } else {
        Absent
      }
    _ => Absent
  }
}

fn run_step_target_sites_in_root(caller: String, file: String, root: Node) -> List<RunStepTargetSite> {
  fold_list(xs: node_subtree_nodes(root: root), empty: [], cons: fn(acc, node) {
    match run_step_target_site_of_call(caller: caller, file: file, node: node) {
      Present { value: s } => list_snoc_item(xs: acc, item: s)
      Absent => acc
    }
  })
}

// THE AST WALK. Fold each candidate caller's already-normalized root (loaded once here, only for the callers
// that spell the constructor plus the constructor home, so there is no whole-corpus AST parse and no new
// effect). The caller roots are the corpus's own normalized fold, so this reads call syntax through the one
// grammar -- not a token matcher. Identity of the callee and resolution of the entry are judged later, in the
// shared context, exactly as before.
fn run_step_target_ast_sites(env: AcquisitionEnv, callers: List<ReferenceWalkCaller>) -> List<RunStepTargetSite> {
  match callers {
    Empty => []
    Cons { head: _, tail: _ } =>
      let names = fold_list(xs: callers, empty: map_insert(m: empty_map(), key: gunbc_run_step_target_home_module, value: true), cons: fn(acc, c) { map_insert(m: acc, key: c.caller, value: true) })
      let targets = cited_targets_read(env: env, pending: map_support_keys(m: names), acc: cited_targets_empty())
      let lm = dag_language_model()
      match program_assembly_ingest_scope_outcome(ingest: targets.ingest) {
        Rejected { diagnostics: _ } => []
        Accepted { value: scope, diagnostics: _ } => {
          let named = live_context_load_modules(load: live_context_load_empty(seed: occurrence_id_allocator_initial()), by_name: targets.by_name, modules: targets.readable, lex: env.lex, prepared: env.grammar, ingest_scope: scope)
          let live = live_context_finish(load: named, lm: lm, active_roots: source_root_set_from_ingest(ingest: targets.ingest), policy: ImportScoped)
          match live.context {
            Rejected { diagnostics: _ } => []
            Accepted { value: ctx, diagnostics: _ } =>
              fold_list(xs: callers, empty: [], cons: fn(acc, c) {
                match map_lookup(m: ctx.roots.by_name, key: qualified_name_from_dotted_string(dotted: c.caller)) {
                  Present { value: tree } => list_append(left: acc, right: run_step_target_sites_in_root(caller: c.caller, file: c.file, root: tree.root))
                  Absent => acc
                }
              })
          }
        }
      }
  }
}


// ---- the target universe -----------------------------------------------------------------------

fn reference_module_name(reference: DeclarationRef) -> String {
  reference.module_path as String
}

fn reference_site_supported(site: ReferenceSite) -> Bool {
  !declaration_ref_is_type_parameter(ref: site.site.reference)
}

// One module's standing as a citation target: the read that declares it, or the reader's cause.
type CitedModule
  = CitedModuleRead { read: DagSourceReadWitness }
  | CitedModuleUnread { cause: String }

fn cited_module(env: AcquisitionEnv, name: String) -> CitedModule {
  match population_member(layout: env.layout, bindings: env.bindings, name: name) {
    PopulationMemberRead { member: member } => CitedModuleRead { read: acquisition_witness(module: member) }
    PopulationMemberRefused { cause: cause } => CitedModuleUnread { cause: cause }
  }
}

fn cited_module_names(sites: List<ReferenceSite>) -> Map<String, Bool> {
  fold_list(xs: sites, empty: empty_map(), cons: fn(acc, s) { map_insert(acc, reference_module_name(reference: s.site.reference), true) })
}

fn cited_decl_names(sites: List<ReferenceSite>) -> Map<String, Bool> {
  fold_list(xs: sites, empty: empty_map(), cons: fn(acc, s) { map_insert(acc, s.site.reference.decl_name as String, true) })
}

type CitedTargets {
  standing: Map<String, CitedModule>
  readable: List<String>
  by_name: Map<String, DagSourceReadWitness>
  ingest: SourceRootIngest
}

fn cited_targets_empty() -> CitedTargets {
  CitedTargets { standing: empty_map(), readable: [], by_name: empty_map(), ingest: Empty }
}

// THE READS ARE PLAIN RECURSION, never a closure: a read is a host effect, and the emitted program
// realizes an effectful call only where a function, not a lambda, makes it (the shape
// v2.cli.population_verbs population_parse_go keeps for the same reason).
fn cited_targets_read(env: AcquisitionEnv, pending: List<String>, acc: CitedTargets) -> CitedTargets {
  match pending {
    Empty => acc
    Cons { head: m, tail: rest } =>
      match map_lookup(m: acc.standing, key: m) {
        Present { value: _ } => cited_targets_read(env: env, pending: rest, acc: acc)
        Absent => cited_targets_read(env: env, pending: rest, acc: cited_targets_with(acc: acc, name: m, standing: cited_module(env: env, name: m)))
      }
  }
}

fn cited_targets_with(acc: CitedTargets, name: String, standing: CitedModule) -> CitedTargets {
  match standing {
    CitedModuleRead { read: read } =>
      CitedTargets {
        standing: map_insert(acc.standing, name, standing),
        readable: list_snoc_item(xs: acc.readable, item: name),
        by_name: map_insert(acc.by_name, name, read),
        ingest: Cons { head: read, tail: acc.ingest }
      }
    CitedModuleUnread { cause: _ } =>
      CitedTargets { standing: map_insert(acc.standing, name, standing), readable: acc.readable, by_name: acc.by_name, ingest: acc.ingest }
  }
}

// ---- judging -----------------------------------------------------------------------------------

fn site_head(site: ReferenceSite) -> String {
  concat(site.file, "@", int_to_decimal_string(value: site.site.start), ": ", annotation_reference_marker, declaration_ref_display_key(ref: site.site.reference), ")")
}

fn malformed_line(m: MalformedSite) -> String {
  let cause = match m.marker.cause {
    MarkerUnterminated => "unterminated marker"
    CoordinateMalformed => "malformed coordinate (module.path::decl, ::field or ::<T>)"
  }
  concat(m.file, "@", int_to_decimal_string(value: m.marker.start), ": ", m.marker.text, ": ", cause)
}

fn resolution_line(site: ReferenceSite, resolution: DeclarationRefResolution) -> Optional<String> {
  match resolution {
    DeclarationRefResolved { declaration_identity: _ } => Absent
    DeclarationRefModuleAbsent { reference: _ } => Present { value: concat(site_head(site: site), ": cited module is not in the target universe") }
    DeclarationRefDeclarationAbsent { reference: _ } => Present { value: concat(site_head(site: site), ": no such declaration") }
    DeclarationRefFieldAbsent { reference: _ } => Present { value: concat(site_head(site: site), ": the declaration has no such field") }
    DeclarationRefContested { reference: _, claimants: claimants } =>
      Present { value: concat(site_head(site: site), ": contested between ", join(claimants, ", ")) }
  }
}

type ReferenceVerdicts {
  resolved: Int
  targets: Int
  lines: List<String>
}

fn reference_verdicts_push(acc: ReferenceVerdicts, line: Optional<String>) -> ReferenceVerdicts {
  match line {
    Absent => ReferenceVerdicts { resolved: acc.resolved + 1, targets: acc.targets, lines: acc.lines }
    Present { value: l } => ReferenceVerdicts { resolved: acc.resolved, targets: acc.targets, lines: list_snoc_item(xs: acc.lines, item: l) }
  }
}

// A CITED MODULE THAT READ IS A TARGET, so the resolver answering ModuleAbsent for it means its read
// did not normalize (live_resolution_context leaves a refused read out of the roots). That is a module
// that could not be indexed, not one that does not exist, and the line says which.
fn reference_site_judged(site: ReferenceSite, targets: CitedTargets, resolution: DeclarationRefResolution) -> Optional<String> {
  match map_lookup(m: targets.standing, key: reference_module_name(reference: site.site.reference)) {
    Present { value: CitedModuleUnread { cause: cause } } => Present { value: concat(site_head(site: site), ": cited module not read: ", cause) }
    Present { value: CitedModuleRead { read: _ } } =>
      match resolution {
        DeclarationRefModuleAbsent { reference: _ } => Present { value: concat(site_head(site: site), ": cited module read but did not normalize, so its declarations were not indexed") }
        _ => resolution_line(site: site, resolution: resolution)
      }
    Absent => resolution_line(site: site, resolution: resolution)
  }
}

// The modules a run-step-target site pulls into the target universe: the caller (so the callee's identity can
// be resolved through ITS imports), the named target module when the argument is a literal, and always the
// constructor's home (so a caller's import of the constructor has a loaded home to resolve to).
fn run_step_target_cited_module_names(target_sites: List<RunStepTargetSite>) -> Map<String, Bool> {
  fold_list(xs: target_sites, empty: map_insert(m: empty_map(), key: gunbc_run_step_target_home_module, value: true), cons: fn(acc, s) {
    let with_caller = map_insert(m: acc, key: s.caller, value: true)
    match s.module_arg {
      RunStepTargetLiteral { value: v } => map_insert(m: with_caller, key: v, value: true)
      RunStepTargetNotLiteral { text: _ } => with_caller
    }
  })
}

// The declaration names whose re-export homes the context loader must pull in: every targeted entry name, plus
// the constructor name itself (so a caller that IMPORTS the constructor resolves that import to its home).
fn run_step_target_decl_names(target_sites: List<RunStepTargetSite>) -> List<String> {
  let with_constructor: List<String> = [ gunbc_run_step_target_constructor_name ]
  fold_list(xs: target_sites, empty: with_constructor, cons: fn(acc, s) {
    match s.function_arg {
      RunStepTargetLiteral { value: v } => list_snoc_item(xs: acc, item: v)
      RunStepTargetNotLiteral { text: _ } => acc
    }
  })
}

fn run_step_target_arg_text(arg: RunStepTargetArg) -> String {
  match arg {
    RunStepTargetLiteral { value: v } => concat("\"", v, "\"")
    RunStepTargetNotLiteral { text: t } => t
  }
}

fn run_step_target_site_head(site: RunStepTargetSite) -> String {
  concat(
    site.file, "@", int_to_decimal_string(value: site.start), ": ",
    gunbc_run_step_target_constructor_name, "(",
    run_step_target_module_label, ": ", run_step_target_arg_text(arg: site.module_arg), ", ",
    run_step_target_function_label, ": ", run_step_target_arg_text(arg: site.function_arg), ")"
  )
}

// Judge one run-step-target site. First the callee must resolve, through the caller's imports in THIS context,
// to the one constructor's declaring home -- otherwise the call lexically names the constructor but is not it
// (a same-named local, or imported from elsewhere) and is not a site at all (condition 1, closed_grounded_substrate).
fn run_step_target_site_line(site: RunStepTargetSite, targets: CitedTargets, context: ResolutionContext) -> Optional<String> {
  match run_step_target_callee_is_constructor(caller: site.caller, context: context) {
    true => run_step_target_entry_line(site: site, targets: targets, context: context)
    false => Absent
  }
}

// The callee is the run-step-target constructor iff resolving it through the caller's imports in THIS context
// yields the SAME declaring identity as resolving the constructor from its own home module -- grounded on
// declaration identity, not on spelling (condition 1, closed_grounded_substrate). A same-named local fn, or a
// same-named fn imported from elsewhere, resolves to a DIFFERENT declaring home and is therefore not a site.
fn run_step_target_callee_is_constructor(caller: String, context: ResolutionContext) -> Bool {
  match resolve_declaration_ref(ref: decl_ref(module_path: caller, decl_name: gunbc_run_step_target_constructor_name), context: context) {
    DeclarationRefResolved { declaration_identity: site_id } =>
      match resolve_declaration_ref(ref: decl_ref(module_path: gunbc_run_step_target_home_module, decl_name: gunbc_run_step_target_constructor_name), context: context) {
        DeclarationRefResolved { declaration_identity: canon } =>
          site_id.qualified_name == canon.qualified_name && site_id.name == canon.name
        _ => false
      }
    _ => false
  }
}

// With the callee confirmed to be the constructor, the (module, function) pair must name a real declaration.
// A non-literal argument refuses typed at the site (never skipped -- it is the un-checkable route); a literal
// pair that does not resolve refuses, located, distinguishing a target module that did not even normalize.
fn run_step_target_entry_line(site: RunStepTargetSite, targets: CitedTargets, context: ResolutionContext) -> Optional<String> {
  match site.module_arg {
    RunStepTargetNotLiteral { text: mt } =>
      Present { value: concat(run_step_target_site_head(site: site), ": RunStepTargetArgumentNotLiteral: the ", run_step_target_module_label, ": argument is not a string literal (", mt, "), so its entry cannot be checked") }
    RunStepTargetLiteral { value: module_name } => match site.function_arg {
      RunStepTargetNotLiteral { text: ft } =>
        Present { value: concat(run_step_target_site_head(site: site), ": RunStepTargetArgumentNotLiteral: the ", run_step_target_function_label, ": argument is not a string literal (", ft, "), so its entry cannot be checked") }
      RunStepTargetLiteral { value: function_name } =>
        match map_lookup(m: targets.standing, key: module_name) {
          Present { value: CitedModuleUnread { cause: cause } } =>
            Present { value: concat(run_step_target_site_head(site: site), ": RunStepTargetModuleUnread: the target module was not read: ", cause) }
          Present { value: CitedModuleRead { read: _ } } =>
            run_step_target_refusal(site: site, module_name: module_name, function_name: function_name, context: context)
          Absent =>
            run_step_target_refusal(site: site, module_name: module_name, function_name: function_name, context: context)
        }
    }
  }
}

fn run_step_target_refusal(site: RunStepTargetSite, module_name: String, function_name: String, context: ResolutionContext) -> Optional<String> {
  match resolve_declaration_ref(ref: decl_ref(module_path: module_name, decl_name: function_name), context: context) {
    DeclarationRefResolved { declaration_identity: _ } => Absent
    DeclarationRefModuleAbsent { reference: _ } =>
      Present { value: concat(run_step_target_site_head(site: site), ": RunStepTargetModuleAbsent: the target module is not in the target universe, so it was never a run-time entry") }
    DeclarationRefDeclarationAbsent { reference: _ } =>
      Present { value: concat(run_step_target_site_head(site: site), ": RunStepTargetDeclarationAbsent: the target module ", module_name, " declares no ", run_step_target_function_label, " named ", function_name) }
    DeclarationRefFieldAbsent { reference: _ } =>
      Present { value: concat(run_step_target_site_head(site: site), ": RunStepTargetFieldAbsent: a run-step target names a whole declaration, not a field") }
    DeclarationRefContested { reference: _, claimants: claimants } =>
      Present { value: concat(run_step_target_site_head(site: site), ": RunStepTargetContested: the entry is contested between ", join(sep: ", ", xs: claimants)) }
  }
}

fn supported_sites(sites: List<ReferenceSite>) -> List<ReferenceSite> {
  let kept: List<ReferenceSite> = []
  fold_list(xs: sites, empty: kept, cons: fn(acc, s) { if reference_site_supported(site: s) { list_snoc_item(xs: acc, item: s) } else { acc } })
}

// The target universe is built ONCE from the union of every module any site names: the @ref-cited modules, and
// for the run-step-target sites their caller module (to resolve the callee through its imports), their named
// target module, and the constructor home. Cost follows the demands (the cited modules + the run-step callers
// and targets), never the corpus: there is no whole-corpus scan here (the fast-lane constraint,
// gunbc.ci.ci_run_step_target), and both site kinds resolve against the SAME native context.
fn reference_verdicts(env: AcquisitionEnv, sites: List<ReferenceSite>, target_callers: List<ReferenceWalkCaller>) -> ReferenceVerdicts {
  let target_sites = run_step_target_ast_sites(env: env, callers: target_callers)
  let target_seed = ReferenceVerdicts { resolved: 0, targets: length(xs: target_sites), lines: [] }
  let unsupported = fold_list(xs: sites, empty: ReferenceVerdicts { resolved: 0, targets: length(xs: target_sites), lines: [] }, cons: fn(acc, s) {
    if reference_site_supported(site: s) { acc } else {
      ReferenceVerdicts { resolved: acc.resolved, targets: acc.targets, lines: list_snoc_item(xs: acc.lines, item: concat(site_head(site: s), ": UnsupportedTarget: type-parameter references are not resolved by this version")) }
    }
  })
  let supported = supported_sites(sites: sites)
  let module_set = fold_list(xs: map_support_keys(m: run_step_target_cited_module_names(target_sites: target_sites)), empty: cited_module_names(sites: supported), cons: fn(acc, name) { map_insert(m: acc, key: name, value: true) })
  let pending = map_support_keys(m: module_set)
  if is_empty(xs: pending) {
    unsupported
  } else {
    let targets = cited_targets_read(env: env, pending: pending, acc: cited_targets_empty())
    let names = fold_list(xs: run_step_target_decl_names(target_sites: target_sites), empty: cited_decl_names(sites: supported), cons: fn(acc, name) { map_insert(m: acc, key: name, value: true) })
    match program_assembly_ingest_scope_outcome(ingest: targets.ingest) {
      Rejected { diagnostics: _ } =>
        fold_list(xs: supported, empty: fold_list(xs: target_sites, empty: target_seed, cons: fn(acc, s) { reference_verdicts_push(acc: acc, line: Present { value: concat(run_step_target_site_head(site: s), ": the cited modules' ingest scope could not be formed") }) }), cons: fn(acc, s) { reference_verdicts_push(acc: acc, line: Present { value: concat(site_head(site: s), ": the cited modules' ingest scope could not be formed") }) })
      Accepted { value: scope, diagnostics: _ } => {
        let lm = dag_language_model()
        let named = live_context_load_modules(load: live_context_load_empty(seed: occurrence_id_allocator_initial()), by_name: targets.by_name, modules: targets.readable, lex: env.lex, prepared: env.grammar, ingest_scope: scope)
        let with_homes = cited_targets_read(env: env, pending: live_context_hop_homes(load: named, names: names), acc: targets)
        let loaded = live_context_load_modules(load: named, by_name: with_homes.by_name, modules: live_context_hop_homes(load: named, names: names), lex: env.lex, prepared: env.grammar, ingest_scope: scope)
        let live = live_context_finish(load: loaded, lm: lm, active_roots: source_root_set_from_ingest(ingest: with_homes.ingest), policy: ImportScoped)
        match live.context {
          Rejected { diagnostics: _ } =>
            fold_list(xs: supported, empty: fold_list(xs: target_sites, empty: target_seed, cons: fn(acc, s) { reference_verdicts_push(acc: acc, line: Present { value: concat(run_step_target_site_head(site: s), ": the cited modules did not form a resolution context") }) }), cons: fn(acc, s) { reference_verdicts_push(acc: acc, line: Present { value: concat(site_head(site: s), ": the cited modules did not form a resolution context") }) })
          Accepted { value: context, diagnostics: _ } =>
            fold_list(xs: supported, empty: fold_list(xs: target_sites, empty: target_seed, cons: fn(acc, s) {
              reference_verdicts_push(acc: acc, line: run_step_target_site_line(site: s, targets: targets, context: context))
            }), cons: fn(acc, s) {
              reference_verdicts_push(acc: acc, line: reference_site_judged(site: s, targets: targets, resolution: resolve_declaration_ref(ref: s.site.reference, context: context)))
            })
        }
      }
    }
  }
}

// ---- the report --------------------------------------------------------------------------------

data reference_check_holds_head: String = "references resolve:"
data reference_check_refused_head: String = "references refused:"

fn reference_report(walk: ReferenceWalk, verdicts: ReferenceVerdicts) -> PopulationReport {
  let lines = concat(walk.unread, concat(list_map(xs: walk.malformed, f: fn(m) { malformed_line(m: m) }), verdicts.lines))
  let counts = concat(
    int_to_decimal_string(value: walk.members), " module(s), ",
    int_to_decimal_string(value: walk.lexed), " spelling the marker, ",
    int_to_decimal_string(value: walk.annotations), " annotation(s) in those, ",
    int_to_decimal_string(value: length(xs: walk.sites)), " marked reference(s), ",
    int_to_decimal_string(value: verdicts.resolved), " resolved, ",
    int_to_decimal_string(value: verdicts.targets), " run-step target(s)"
  )
  if is_empty(xs: lines) {
    PopulationReport { text: concat(reference_check_holds_head, " ", counts), held: true, detail: "" }
  } else {
    PopulationReport {
      text: join(Cons { head: concat(reference_check_refused_head, " ", counts), tail: lines }, "\n"),
      held: false,
      detail: concat(int_to_decimal_string(value: length(xs: lines)), " marked reference(s) or population member(s) did not resolve or could not be judged")
    }
  }
}

fn check_references_prepared(env: AcquisitionEnv) -> PopulationReport {
  match enumerate_bound_modules(layout: env.layout, bindings: env.bindings) {
    BoundModulesRefused { subject: subject, cause: cause } =>
      PopulationReport { text: concat(subject, ": ", cause), held: false, detail: concat("could not enumerate the modules of ", subject) }
    BoundModulesListed { modules: modules } =>
      if is_empty(xs: modules) {
        PopulationReport { text: "", held: false, detail: "the bound trees hold no module; a check over nothing is not a check of zero" }
      } else {
        let walk = reference_walk_go(env: env, pending: modules, walk: reference_walk_empty())
        reference_report(walk: walk, verdicts: reference_verdicts(env: env, sites: walk.sites, target_callers: walk.target_sites))
      }
  }
}

fn check_references(bindings: List<SourceRootBinding>) -> PopulationReport {
  match acquisition_env(layout: repository_storage_layout(), bindings: bindings) {
    AcquisitionEnvUnprepared { diagnostics: _ } =>
      PopulationReport { text: "", held: false, detail: "the dag grammar did not prepare; no annotation was observed" }
    AcquisitionEnvReady { env: env } => check_references_prepared(env: env)
  }
}
