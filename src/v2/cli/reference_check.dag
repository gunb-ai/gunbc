import std.algebra { string_contains, Cons, Empty, FreeMonoid, empty_map, fold_list, is_empty, length, list_map, list_reverse, list_snoc_item, map_insert, map_lookup, map_support_keys, collection_concat_shape, collection_join_shape }
import std.optional { Absent, Optional, Present }
import std.integer { int_to_decimal_string }
import std.occurrence_identity { occurrence_id_allocator_initial }
import std.decl_ref { DeclarationRef, declaration_ref_display_key, declaration_ref_is_type_parameter }
