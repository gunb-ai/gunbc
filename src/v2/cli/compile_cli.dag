// THE V2-NATIVE CLI. THIS IS THE COMPILER'S OWN FRONT DOOR, WRITTEN IN THE COMPILER'S OWN LANGUAGE.
//
// WHAT IT IS FOR, stated as the position it closes rather than as a feature. `gunbc` is the SEED's
// CLI: it is `RetainedHostCliKernel`, a clap surface dispatching into hand-authored host Rust
// (`v1_compiler.cli_run`), and a self-emitted compiler does not contain that module. So the seed's
// verbs are unreachable from a v2 binary BY CONSTRUCTION, not by omission, and the self-host step
// stops exactly there: `gunbc test //gunbc/instruments:self-host` emits v2's closure and builds it,
// and the built binary cannot emit that closure again because `v2.compiler.compile` declares
// `SourceRootEvalDriver`, whose rendered main answers `census` and `adjudicate` and has no compile
// mode. The second generation is the v2 -> v2 boundary, and this module is the door it goes through.
//
// WHY IT IS A SECOND ENTRY MODULE RATHER THAN A MODE ON THE FIRST. The emitter admits EXACTLY ONE
// `compiler_pipeline_entry` declaration per closure (`v1.compiler.emit_rust`
// `compiler_pipeline_entry_decl` answers `none` for both zero and two, and
// `compiler_pipeline_entry_is_ambiguous` refuses the emission by name), because one emitted crate
// has one entry point. Adding a compile mode to the eval driver's main would therefore have meant
// growing the ~500 lines of Rust that driver is already declared seed debt for, for a mode that
// wants none of its universe derivation, receipt admission or cost partition. This module's import
// closure does not reach `v2.compiler.compile` at all, so the two entries never appear in one
// closure and the emitter's exactly-one rule is satisfied by construction rather than by a flag
// that selects between them.
//
// THE TWO CLOSURES ARE DIFFERENT, NOT NESTED, AND THAT IS THE FACT WORTH CARRYING -- not their
// relative size, which is close enough to be no argument at all. This closure reaches modules the
// compiler entry's does not, `v2.extdeps.languages.rust` among them, because this door emits FOR a
// target while `v2.compiler.compile` reaches its own target model by a different route. So a green
// on one instrument is not evidence about the other in either direction, and widening the proven
// population is something this entry does rather than a side effect of being bigger.
//
// The native entry binds extdeps.filesystem.filesystem_io Filesystem, whose operations already
// emit through v1.compiler.emit_rust emit_file_call. v2.compiler.module_acquisition owns the
// acquisition: it reads the entry module at the file the storage layout stores it, parses it,
// reads each module that file requests, and repeats, so the closure is the requested modules and
// no directory is walked. Every read is an exact read through FilesystemExactRead, and neither an
// absent file nor a failed read can become a smaller closure. The legacy free filesystem_read
// helper is not this door's transport: its content-only contract cannot carry a typed read refusal.
//
// v2_cli_main is the one entry fold: parse before acquisition, bind the plan's roots to the
// governed trees they are, acquire the entry's closure through them, verify that the read set is
// exactly that closure, then compile. The rendered main binds the handler, supplies argv, writes
// the returned text, and realizes ProcessExit. Pure parse/run witnesses remain useful, and walk_cli_door executes
// the built CLI with accepting, parse-refusal, missing-root and unreadable-source controls, in the
// `gunbc test //gunbc/instruments:v2-native-cli` step of the required `witnesses` job.
//
// THE TWO POPULATION VERBS, `check-layout` AND `parse-population`, ARE THE SAME DOOR FOR A DIFFERENT
// SUBJECT. Compiling reads the closure an entry requests and nothing else; a job whose subject is the
// whole population -- is every governed file where the storage rule puts it, does every governed
// module parse -- is an explicit enumeration of the layout and never a side effect of compiling an
// entry. They take source roots and no entry, they acquire no closure, and v2.cli.population_verbs
// owns what each does; this module owns only the argv that selects one and the status it maps to.
//
// This removes the filesystem portion of source_root_eval_driver_seed_growth. It does not retire
// that row: the eval driver's remaining host facts and orchestration are separate obligations.

data compiler_pipeline_entry: CompilerEntryDriver = NativeCliDriver

// THE VERB SET IS CLOSED AND STARTS AT ONE. `emit` is the verb the self-host frontier needs and the
// only one whose realization exists today; a second verb is an arm here, which is a refusal that
// stops compiling if a consumer forgets it. Opening this with a catch-all would make an unknown
// verb indistinguishable from an unimplemented one.
// THE TARGET IS A CLOSED CHOICE, NOT A STRING. Each arm names one rostered `TargetModel`
// (`cli_emit_target_model`), so an operator can ask only for a target this CLI can actually hand
// to the emitter, and a misspelt one is refused where it was typed instead of reaching the emitter
// as a name it has no model for. Adding a target is one arm, one spelling row and one model arm;
// the exhaustive matches below refuse to compile until all three exist.
type CliEmitTarget
  = CliTargetRust
  | CliTargetC
  | CliTargetSwift

data cli_emit_targets: List<CliEmitTarget> = [CliTargetRust, CliTargetC, CliTargetSwift]

fn cli_emit_target_spelling(t: CliEmitTarget) -> String {
  match t {
    CliTargetRust => "rust"
    CliTargetC => "c"
    CliTargetSwift => "swift"
  }
}

fn cli_emit_target_model(t: CliEmitTarget) -> TargetModel {
  match t {
    CliTargetRust => rust_closure_crate_target_model()
    CliTargetC => c_target_model()
    CliTargetSwift => swift_target_model()
  }
}

// THE DEFAULT IS A DECLARED ROW OF THE PLAN, NOT A CONSTANT INSIDE THE RUN. An emit that names no
// `--target` was always a Rust emit (the self-host instruments spawn exactly that argv), so the plan
// records Rust as its target, and `v2_cli_run` only ever reads the target out of the plan.
data cli_default_emit_target: CliEmitTarget = CliTargetRust

fn cli_emit_target_of_spelling(spelling: String) -> Optional<CliEmitTarget> {
  fold_list(
    xs: cli_emit_targets,
    empty: optional_absent(),
    cons: fn(acc, t) {
      if cli_emit_target_spelling(t: t) == spelling { optional_present(value: t) } else { acc }
    }
  )
}

fn cli_emit_target_roster_text() -> String {
  fold_list(
    xs: cli_emit_targets,
    empty: "",
    cons: fn(acc, t) {
      if acc == "" { cli_emit_target_spelling(t: t) } else { concat(concat(acc, ", "), cli_emit_target_spelling(t: t)) }
    }
  )
}

type CliVerb
  = CliEmitClosure { entry: String, source_roots: FreeMonoid<String>, target: CliEmitTarget }
  | CliIfArmReaderDifferential { source_roots: FreeMonoid<String> }
  | CliCheckLayout { source_roots: FreeMonoid<String> }
  | CliSelectSpelledModules { source_roots: FreeMonoid<String> }
  | CliParsePopulation {
      source_roots: FreeMonoid<String>,
      compiler: Optional<String>,
      write_identity: Optional<String>,
      receipts: Optional<String>,
      reuse_from: Optional<String>
    }

// THE VERBS WHOSE ONLY OPTION IS --source-root. They parse identically and differ in spelling, usage
// and the verb they select, so the parser carries which of them it is walking instead of one pair of
// states per verb.
type CliRootsVerb
  = CliRootsDifferential
  | CliRootsCheckLayout
  | CliRootsParsePopulation
  | CliRootsSelectSpelled

data cli_roots_verbs: List<CliRootsVerb> = [CliRootsDifferential, CliRootsCheckLayout, CliRootsParsePopulation, CliRootsSelectSpelled]

fn cli_roots_verb_spelling(kind: CliRootsVerb) -> String {
  match kind {
    CliRootsDifferential => cli_verb_if_arm_reader_differential
    CliRootsCheckLayout => cli_verb_check_layout
    CliRootsParsePopulation => cli_verb_parse_population
    CliRootsSelectSpelled => cli_verb_select_spelled_modules
  }
}

fn cli_roots_verb_usage(kind: CliRootsVerb) -> String {
  match kind {
    CliRootsParsePopulation =>
      concat("usage: <binary> ", cli_roots_verb_spelling(kind: kind), " --source-root <dir> [--source-root <dir>]... [--compiler <identity>] [--write-identity <path>] [--receipts <path>] [--reuse-from <dir>]")
    CliRootsDifferential =>
      concat("usage: <binary> ", cli_roots_verb_spelling(kind: kind), " --source-root <dir> [--source-root <dir>]...")
    CliRootsCheckLayout =>
      concat("usage: <binary> ", cli_roots_verb_spelling(kind: kind), " --source-root <dir> [--source-root <dir>]...")
    CliRootsSelectSpelled =>
      concat("usage: <binary> ", cli_roots_verb_spelling(kind: kind), " --source-root <dir> [--source-root <dir>]...")
  }
}

fn cli_roots_verb_of_spelling(spelling: String) -> Optional<CliRootsVerb> {
  fold_list(
    xs: cli_roots_verbs,
    empty: optional_absent(),
    cons: fn(acc, kind) {
      if cli_roots_verb_spelling(kind: kind) == spelling { optional_present(value: kind) } else { acc }
    }
  )
}

fn cli_roots_verb_selected(
  kind: CliRootsVerb,
  roots: FreeMonoid<String>,
  compiler: Optional<String>,
  write_identity: Optional<String>,
  receipts: Optional<String>,
  reuse_from: Optional<String>
) -> CliVerb {
  match kind {
    CliRootsDifferential => CliIfArmReaderDifferential { source_roots: roots }
    CliRootsCheckLayout => CliCheckLayout { source_roots: roots }
    CliRootsSelectSpelled => CliSelectSpelledModules { source_roots: roots }
    CliRootsParsePopulation =>
      CliParsePopulation {
        source_roots: roots,
        compiler: compiler,
        write_identity: write_identity,
        receipts: receipts,
        reuse_from: reuse_from
      }
  }
}

// A PLAN IS PARSED OR IT IS REFUSED, and the refusal carries its own reason symbol rather than a
// rendered sentence, so the host renders it once and a witness can discriminate on the CAUSE. A
// plan that "parsed with no roots" is not an arm: it is the `cli_no_source_root` refusal, because a
// verb with an empty root list would walk nothing and emit an empty program, which is the
// empty-observation narrow DESIGN section 5 forbids.
type CliPlan
  = CliPlanParsed { verb: CliVerb }
  | CliPlanRefused { reason: Symbol, detail: String }

// THE PARSER'S STATE, WALKED ONE ARGUMENT AT A TIME. `SeekVerb` is the start, `SeekOption` is
// between options, and `SeekRootValue` is the position after `--source-root` where the NEXT
// argument is its value -- which is what makes a trailing `--source-root` a located refusal rather
// than a silently ignored option. `Failed` absorbs: once the parse has refused, later arguments
// cannot un-refuse it, so the FIRST cause is the one reported.
type CliParseState
  = CliParseSeekVerb
  | CliParseSeekOption { entry: String, roots: FreeMonoid<String>, target: CliEmitTarget }
  | CliParseSeekRootValue { entry: String, roots: FreeMonoid<String>, target: CliEmitTarget }
  | CliParseSeekEntryValue { entry: String, roots: FreeMonoid<String>, target: CliEmitTarget }
  | CliParseSeekTargetValue { entry: String, roots: FreeMonoid<String> }
  | CliParseSeekRootsOption {
      kind: CliRootsVerb,
      roots: FreeMonoid<String>,
      compiler: Optional<String>,
      write_identity: Optional<String>,
      receipts: Optional<String>,
      reuse_from: Optional<String>
    }
  | CliParseSeekRootsValue {
      kind: CliRootsVerb,
      roots: FreeMonoid<String>,
      compiler: Optional<String>,
      write_identity: Optional<String>,
      receipts: Optional<String>,
      reuse_from: Optional<String>
    }
  | CliParseSeekCompilerValue {
      kind: CliRootsVerb,
      roots: FreeMonoid<String>,
      write_identity: Optional<String>,
      receipts: Optional<String>,
      reuse_from: Optional<String>
    }
  | CliParseSeekWriteIdentityValue {
      kind: CliRootsVerb,
      roots: FreeMonoid<String>,
      compiler: Optional<String>,
      receipts: Optional<String>,
      reuse_from: Optional<String>
    }
  | CliParseSeekReceiptsValue {
      kind: CliRootsVerb,
      roots: FreeMonoid<String>,
      compiler: Optional<String>,
      write_identity: Optional<String>,
      reuse_from: Optional<String>
    }
  | CliParseSeekReuseFromValue {
      kind: CliRootsVerb,
      roots: FreeMonoid<String>,
      compiler: Optional<String>,
      write_identity: Optional<String>,
      receipts: Optional<String>
    }
  | CliParseFailed { reason: Symbol, detail: String }

// THE OPTION SPELLINGS MOVED to v2.cli.parse_verdict_invocation, joining the verb spellings that already
// moved to v2.cli.population_verb_names for the same reason: while they lived here, every consumer that
// needed a spelling either imported this whole closure or minted a copy -- and one of those copies was
// the content hash that CERTIFIES the invocation, so a rename here could leave the emitted command and
// the certifying stamp agreeing with each other and both wrong. This module PARSES them; it no longer
// owns how they are spelled elsewhere. The parser is a consumer of the declaration, not its authority.
data cli_option_entry: String = "--entry"

data cli_option_target: String = "--target"

data cli_verb_emit: String = "emit"

// THE NESTED-IF ARM-READER DIFFERENTIAL (v2.cli.if_arm_reader_differential). Named for exactly what
// it measures so it does not read as the general census, which lives on the native driver
// (v2.compiler.compile). It takes source roots only, and is deleted with its module.
data cli_verb_if_arm_reader_differential: String = "if-arm-reader-differential"

// THE WHOLE-POPULATION VERBS (v2.cli.population_verbs). Spellings live in
// v2.cli.population_verb_names so this closure is not the spelling authority. `check-layout` holds
// when every `.dag` file under the bound trees is stored where the module it declares is named to
// be; `parse-population` holds when every module the declared namespace rows store under them
// parses. The required-CI epoch hashes the layout policy and declared refusal classes those verbs
// consume, not these spellings.

data cli_usage: String = "usage: <binary> emit --entry <module.path> --source-root <dir> [--source-root <dir>]... [--target <target>]"

fn cli_parse_step(state: CliParseState, arg: String) -> CliParseState {
  match state {
    CliParseFailed { reason: reason, detail: detail } =>
      CliParseFailed { reason: reason, detail: detail }
    CliParseSeekVerb =>
      if arg == cli_verb_emit {
        CliParseSeekOption { entry: "", roots: Empty, target: cli_default_emit_target }
      } else {
        match cli_roots_verb_of_spelling(spelling: arg) {
          Present { value: kind } =>
            CliParseSeekRootsOption {
              kind: kind,
              roots: Empty,
              compiler: optional_absent(),
              write_identity: optional_absent(),
              receipts: optional_absent(),
              reuse_from: optional_absent()
            }
          Absent =>
            CliParseFailed {
              reason: ^cli_unknown_verb,
              detail: concat(concat("unknown verb ", arg), concat(" -- ", cli_usage))
            }
        }
      }
    CliParseSeekRootsOption { kind: kind, roots: roots, compiler: compiler, write_identity: write_identity, receipts: receipts, reuse_from: reuse_from } =>
      if arg == cli_option_source_root {
        CliParseSeekRootsValue {
          kind: kind,
          roots: roots,
          compiler: compiler,
          write_identity: write_identity,
          receipts: receipts,
          reuse_from: reuse_from
        }
      } else {
        if arg == cli_option_compiler {
          match kind {
            CliRootsParsePopulation =>
              CliParseSeekCompilerValue {
                kind: kind,
                roots: roots,
                write_identity: write_identity,
                receipts: receipts,
                reuse_from: reuse_from
              }
            CliRootsDifferential =>
              CliParseFailed {
                reason: ^cli_unknown_option,
                detail: concat(concat("unknown option ", arg), concat(" -- ", cli_roots_verb_usage(kind: kind)))
              }
            CliRootsCheckLayout =>
              CliParseFailed {
                reason: ^cli_unknown_option,
                detail: concat(concat("unknown option ", arg), concat(" -- ", cli_roots_verb_usage(kind: kind)))
              }
            CliRootsSelectSpelled =>
              CliParseFailed {
                reason: ^cli_unknown_option,
                detail: concat(concat("unknown option ", arg), concat(" -- ", cli_roots_verb_usage(kind: kind)))
              }
          }
        } else {
          if arg == cli_option_write_identity {
            match kind {
              CliRootsParsePopulation =>
                CliParseSeekWriteIdentityValue {
                  kind: kind,
                  roots: roots,
                  compiler: compiler,
                  receipts: receipts,
                  reuse_from: reuse_from
                }
              CliRootsDifferential =>
                CliParseFailed {
                  reason: ^cli_unknown_option,
                  detail: concat(concat("unknown option ", arg), concat(" -- ", cli_roots_verb_usage(kind: kind)))
                }
              CliRootsCheckLayout =>
                CliParseFailed {
                  reason: ^cli_unknown_option,
                  detail: concat(concat("unknown option ", arg), concat(" -- ", cli_roots_verb_usage(kind: kind)))
                }
              CliRootsSelectSpelled =>
                CliParseFailed {
                  reason: ^cli_unknown_option,
                  detail: concat(concat("unknown option ", arg), concat(" -- ", cli_roots_verb_usage(kind: kind)))
                }
            }
          } else {
            if arg == cli_option_receipts {
              match kind {
                CliRootsParsePopulation =>
                  CliParseSeekReceiptsValue {
                    kind: kind,
                    roots: roots,
                    compiler: compiler,
                    write_identity: write_identity,
                    reuse_from: reuse_from
                  }
                CliRootsDifferential =>
                  CliParseFailed {
                    reason: ^cli_unknown_option,
                    detail: concat(concat("unknown option ", arg), concat(" -- ", cli_roots_verb_usage(kind: kind)))
                  }
                CliRootsCheckLayout =>
                  CliParseFailed {
                    reason: ^cli_unknown_option,
                    detail: concat(concat("unknown option ", arg), concat(" -- ", cli_roots_verb_usage(kind: kind)))
                  }
                CliRootsSelectSpelled =>
                  CliParseFailed {
                    reason: ^cli_unknown_option,
                    detail: concat(concat("unknown option ", arg), concat(" -- ", cli_roots_verb_usage(kind: kind)))
                  }
              }
            } else {
              if arg == cli_option_reuse_from {
                match kind {
                  CliRootsParsePopulation =>
                    CliParseSeekReuseFromValue {
                      kind: kind,
                      roots: roots,
                      compiler: compiler,
                      write_identity: write_identity,
                      receipts: receipts
                    }
                  CliRootsDifferential =>
                    CliParseFailed {
                      reason: ^cli_unknown_option,
                      detail: concat(concat("unknown option ", arg), concat(" -- ", cli_roots_verb_usage(kind: kind)))
                    }
                  CliRootsCheckLayout =>
                    CliParseFailed {
                      reason: ^cli_unknown_option,
                      detail: concat(concat("unknown option ", arg), concat(" -- ", cli_roots_verb_usage(kind: kind)))
                    }
                  CliRootsSelectSpelled =>
                    CliParseFailed {
                      reason: ^cli_unknown_option,
                      detail: concat(concat("unknown option ", arg), concat(" -- ", cli_roots_verb_usage(kind: kind)))
                    }
                }
              } else {
                CliParseFailed {
                  reason: ^cli_unknown_option,
                  detail: concat(concat("unknown option ", arg), concat(" -- ", cli_roots_verb_usage(kind: kind)))
                }
              }
            }
          }
        }
      }
    CliParseSeekReuseFromValue { kind: kind, roots: roots, compiler: compiler, write_identity: write_identity, receipts: receipts } =>
      if cli_arg_is_option(arg: arg) {
        CliParseFailed {
          reason: ^cli_reuse_from_missing_value,
          detail: concat(cli_option_reuse_from, " takes a directory, and an option followed it")
        }
      } else {
        CliParseSeekRootsOption {
          kind: kind,
          roots: roots,
          compiler: compiler,
          write_identity: write_identity,
          receipts: receipts,
          reuse_from: optional_present(value: arg)
        }
      }
    CliParseSeekCompilerValue { kind: kind, roots: roots, write_identity: write_identity, receipts: receipts, reuse_from: reuse_from } =>
      if cli_arg_is_option(arg: arg) {
        CliParseFailed {
          reason: ^cli_compiler_missing_value,
          detail: concat(cli_option_compiler, " takes the parse-compiler identity, and an option followed it")
        }
      } else {
        CliParseSeekRootsOption {
          kind: kind,
          roots: roots,
          compiler: optional_present(value: arg),
          write_identity: write_identity,
          receipts: receipts,
          reuse_from: reuse_from
        }
      }
    CliParseSeekWriteIdentityValue { kind: kind, roots: roots, compiler: compiler, receipts: receipts, reuse_from: reuse_from } =>
      if cli_arg_is_option(arg: arg) {
        CliParseFailed {
          reason: ^cli_write_identity_missing_value,
          detail: concat(cli_option_write_identity, " takes a path, and an option followed it")
        }
      } else {
        CliParseSeekRootsOption {
          kind: kind,
          roots: roots,
          compiler: compiler,
          write_identity: optional_present(value: arg),
          receipts: receipts,
          reuse_from: reuse_from
        }
      }
    CliParseSeekReceiptsValue { kind: kind, roots: roots, compiler: compiler, write_identity: write_identity, reuse_from: reuse_from } =>
      if cli_arg_is_option(arg: arg) {
        CliParseFailed {
          reason: ^cli_receipts_missing_value,
          detail: concat(cli_option_receipts, " takes a path, and an option followed it")
        }
      } else {
        CliParseSeekRootsOption {
          kind: kind,
          roots: roots,
          compiler: compiler,
          write_identity: write_identity,
          receipts: optional_present(value: arg),
          reuse_from: reuse_from
        }
      }
    CliParseSeekRootsValue { kind: kind, roots: roots, compiler: compiler, write_identity: write_identity, receipts: receipts, reuse_from: reuse_from } =>
      if cli_arg_is_option(arg: arg) {
        CliParseFailed {
          reason: ^cli_source_root_missing_value,
          detail: concat(cli_option_source_root, " takes a directory, and an option followed it")
        }
      } else {
        CliParseSeekRootsOption {
          kind: kind,
          roots: Cons { head: arg, tail: roots },
          compiler: compiler,
          write_identity: write_identity,
          receipts: receipts,
          reuse_from: reuse_from
        }
      }
    CliParseSeekRootValue { entry: entry, roots: roots, target: target } =>
      if cli_arg_is_option(arg: arg) {
        CliParseFailed {
          reason: ^cli_source_root_missing_value,
          detail: concat(cli_option_source_root, " takes a directory, and an option followed it")
        }
      } else {
        CliParseSeekOption { entry: entry, roots: Cons { head: arg, tail: roots }, target: target }
      }
    CliParseSeekEntryValue { entry: _, roots: roots, target: target } =>
      if cli_arg_is_option(arg: arg) {
        CliParseFailed {
          reason: ^cli_entry_missing_value,
          detail: concat(cli_option_entry, " takes a module path, and an option followed it")
        }
      } else {
        CliParseSeekOption { entry: arg, roots: roots, target: target }
      }
    CliParseSeekTargetValue { entry: entry, roots: roots } =>
      if cli_arg_is_option(arg: arg) {
        CliParseFailed {
          reason: ^cli_target_missing_value,
          detail: concat(cli_option_target, " takes a target name, and an option followed it")
        }
      } else {
        match cli_emit_target_of_spelling(spelling: arg) {
          Present { value: target } => CliParseSeekOption { entry: entry, roots: roots, target: target }
          Absent =>
            CliParseFailed {
              reason: ^cli_unknown_target,
              detail: concat(
                concat("unknown target ", arg),
                concat(" -- the rostered targets are ", cli_emit_target_roster_text())
              )
            }
        }
      }
    CliParseSeekOption { entry: entry, roots: roots, target: target } =>
      if arg == cli_option_source_root {
        CliParseSeekRootValue { entry: entry, roots: roots, target: target }
      } else {
        if arg == cli_option_entry {
          CliParseSeekEntryValue { entry: entry, roots: roots, target: target }
        } else {
          if arg == cli_option_target {
            CliParseSeekTargetValue { entry: entry, roots: roots }
          } else {
            CliParseFailed {
              reason: ^cli_unknown_option,
              detail: concat(concat("unknown option ", arg), concat(" -- ", cli_usage))
            }
          }
        }
      }
  }
}

fn cli_arg_is_option(arg: String) -> Bool {
  (arg == cli_option_source_root)
    || (arg == cli_option_entry)
    || (arg == cli_option_target)
    || (arg == cli_option_compiler)
    || (arg == cli_option_write_identity)
    || (arg == cli_option_receipts)
    || (arg == cli_option_reuse_from)
}

fn cli_parse_finish(state: CliParseState) -> CliPlan {
  match state {
    CliParseFailed { reason: reason, detail: detail } =>
      CliPlanRefused { reason: reason, detail: detail }
    CliParseSeekVerb =>
      CliPlanRefused { reason: ^cli_no_verb, detail: concat("no verb given -- ", cli_usage) }
    CliParseSeekRootValue { entry: _, roots: _, target: _ } =>
      CliPlanRefused {
        reason: ^cli_source_root_missing_value,
        detail: concat(cli_option_source_root, " takes a directory, and none followed it")
      }
    CliParseSeekEntryValue { entry: _, roots: _, target: _ } =>
      CliPlanRefused {
        reason: ^cli_entry_missing_value,
        detail: concat(cli_option_entry, " takes a module path, and none followed it")
      }
    CliParseSeekTargetValue { entry: _, roots: _ } =>
      CliPlanRefused {
        reason: ^cli_target_missing_value,
        detail: concat(cli_option_target, " takes a target name, and none followed it")
      }
    CliParseSeekReuseFromValue { kind: _, roots: _, compiler: _, write_identity: _, receipts: _ } =>
      CliPlanRefused {
        reason: ^cli_reuse_from_missing_value,
        detail: concat(cli_option_reuse_from, " takes a directory, and none followed it")
      }
    CliParseSeekCompilerValue { kind: _, roots: _, write_identity: _, receipts: _, reuse_from: _ } =>
      CliPlanRefused {
        reason: ^cli_compiler_missing_value,
        detail: concat(cli_option_compiler, " takes the parse-compiler identity, and none followed it")
      }
    CliParseSeekWriteIdentityValue { kind: _, roots: _, compiler: _, receipts: _, reuse_from: _ } =>
      CliPlanRefused {
        reason: ^cli_write_identity_missing_value,
        detail: concat(cli_option_write_identity, " takes a path, and none followed it")
      }
    CliParseSeekReceiptsValue { kind: _, roots: _, compiler: _, write_identity: _, reuse_from: _ } =>
      CliPlanRefused {
        reason: ^cli_receipts_missing_value,
        detail: concat(cli_option_receipts, " takes a path, and none followed it")
      }
    CliParseSeekRootsValue { kind: _, roots: _, compiler: _, write_identity: _, receipts: _, reuse_from: _ } =>
      CliPlanRefused {
        reason: ^cli_source_root_missing_value,
        detail: concat(cli_option_source_root, " takes a directory, and none followed it")
      }
    CliParseSeekRootsOption { kind: kind, roots: roots, compiler: compiler, write_identity: write_identity, receipts: receipts, reuse_from: reuse_from } =>
      if length(xs: roots) == 0 {
        CliPlanRefused {
          reason: ^cli_no_source_root,
          detail: concat(cli_roots_verb_spelling(kind: kind), " needs at least one source root -- ", cli_roots_verb_usage(kind: kind))
        }
      } else {
        CliPlanParsed {
          verb: cli_roots_verb_selected(
            kind: kind,
            roots: list_reverse(xs: roots),
            compiler: compiler,
            write_identity: write_identity,
            receipts: receipts,
            reuse_from: reuse_from
          )
        }
      }
    CliParseSeekOption { entry: entry, roots: roots, target: target } =>
      if length(xs: roots) == 0 {
        CliPlanRefused {
          reason: ^cli_no_source_root,
          detail: concat("emit needs at least one source root -- ", cli_usage)
        }
      } else {
        if entry == "" {
          CliPlanRefused {
            reason: ^cli_no_entry,
            detail: concat("emit needs the module to resolve as its subject -- ", cli_usage)
          }
        } else {
          CliPlanParsed {
            verb: CliEmitClosure { entry: entry, source_roots: list_reverse(xs: roots), target: target }
          }
        }
      }
  }
}

fn v2_cli_parse(argv: FreeMonoid<String>) -> CliPlan {
  cli_parse_finish(
    state: fold_list(xs: argv, empty: CliParseSeekVerb, cons: cli_parse_step)
  )
}

// WHAT THE HOST MUST WALK, ANSWERED BY THE PLAN AND BY NOTHING ELSE. The host does not re-read argv
// to find the roots; if it did, the roots the walk used and the roots the verb carries would be two
// representations of one fact, free to disagree, and a run could quietly build a different closure
// than the one it reports. A refused plan walks nothing.
fn v2_cli_plan_source_roots(plan: CliPlan) -> FreeMonoid<String> {
  match plan {
    CliPlanRefused { reason: _, detail: _ } => Empty
    CliPlanParsed { verb: verb } =>
      match verb {
        CliEmitClosure { entry: _, source_roots: roots, target: _ } => roots
        CliIfArmReaderDifferential { source_roots: roots } => roots
        CliCheckLayout { source_roots: roots } => roots
        CliSelectSpelledModules { source_roots: roots } => roots
        CliParsePopulation { source_roots: roots, compiler: _, write_identity: _, receipts: _, reuse_from: _ } => roots
      }
  }
}

type CliRunOutcome
  = CliEmitted { text: String, closure_size: Int, refused_count: Int, refusal_detail: String }
  | CliRunRefused { reason: Symbol, detail: String }
  | CliUsageRefused { reason: Symbol, detail: String }
  | CliPopulationReported { text: String, held: Bool, detail: String }

// THE REFUSAL PRINTS ITS CAUSE, AND FOR ONE GENERATION IT DID NOT. The rejected arm already
// CARRIED `d.head.reason` (now the FATAL reason -- the head was the first advisory that happened
// to be pending, which is the wrong link for a `reason` field to name), and the detail beside it said
// "the located cause is this refusal's reason" -- true of the value and false of the artifact, because the rendered main prints only the
// `ProcessExit` reason string that `detail` becomes. So generation two refused with a sentence
// pointing at a symbol nobody could read, which is DESIGN section 5's located-where-the-author-can-
// act failure in its quietest form: the cause was computed, carried, and then dropped at the last
// boundary. Measured on the built binary at gunbc#11507's head -- three different entries
// (`v2.std.text`, this module, `v2.compiler.compile`) all refused with the same nine words.
//
// THE WHOLE ORDERED CHAIN, BECAUSE THE HEAD IS NOT THE CAUSE. A head can be a non-fatal advisory
// that rejected_with_pending prepended; it is never by itself the fatal. The fatal diagnostic is the last one, and `parse_g0_tokens_remain_diagnostic`
// builds its locus from the first remaining token. The fatal pick is `v2.std.diagnostic`
// `diagnostics_fatal`, the chain is `lens_verdict_diagnostics_located_chain_text_in_spans` (every
// link with its locus, so thirty-five advisories in front of the fatal each say where they are),
// and file+extent is `lens_verdict_diagnostic_locus_text_in_spans` — none a second spelling here
// (DESIGN section 3).
//
// BOTH ARE THE `_in_spans` DOORS, WHICH IS THE POINT OF THIS PACKAGE: they take the ingest's
// SpanIndex, so a NodeLocus resolves to a file and byte range instead of rendering as an
// occurrence. An earlier revision of this paragraph named the index-free spellings, which this
// module stopped calling in the same diff -- prose naming symbols its own code does not use
// (review 70138).

// THE EMPTY INGEST IS A REFUSAL AND NOT AN EMPTY PROGRAM, and this arm is the whole reason
// `v2_cli_run` does not call the emitter first and ask questions after.
// an EMPTY ingest would census nothing and refuse only at the entry lookup, and the old emitter
// (`emit_compiler_import_closure_from_ingest`) emitted an empty program and reported Accepted --
// so a source root that exists and holds no `.dag` file, or a walk the host performed against a
// typo, would otherwise print an empty emission and exit 0. That is bottom-as-answer conflated with
// bottom-as-ignorance, and it is the exact shape the closure-emit driver was written to close; this
// door owes the same refusal at its own boundary.
fn v2_cli_run(plan: CliPlan, ingest: SourceRootIngest) -> CliRunOutcome {
  match plan {
    CliPlanRefused { reason: reason, detail: detail } =>
      CliUsageRefused { reason: reason, detail: detail }
    CliPlanParsed { verb: verb } =>
      match verb {
        CliIfArmReaderDifferential { source_roots: _ } =>
          if length(xs: ingest) == 0 {
            CliRunRefused {
              reason: ^cli_empty_ingest,
              detail: "the source roots walked to zero .dag files; a census over nothing is not a census of zero"
            }
          } else {
            cli_if_arm_reader_differential_outcome(census: if_arm_reader_differential(ingest: ingest))
          }
        CliCheckLayout { source_roots: _ } => cli_verb_takes_no_ingest(verb: cli_verb_check_layout)
        CliSelectSpelledModules { source_roots: _ } => cli_verb_takes_no_ingest(verb: cli_verb_select_spelled_modules)
        CliParsePopulation { source_roots: _, compiler: _, write_identity: _, receipts: _, reuse_from: _ } =>
          cli_verb_takes_no_ingest(verb: cli_verb_parse_population)
        CliEmitClosure { entry: entry, source_roots: _, target: target } =>
          if length(xs: ingest) == 0 {
            CliRunRefused {
              reason: ^cli_empty_ingest,
              detail: "the source roots walked to zero .dag files; an empty closure is not an empty program"
            }
          } else {
            let emitted = emit_closure_from_ingest_located(
              ingest: ingest,
              entry: qualified_name_from_dotted_string(dotted: entry),
              entry_locus: v2_cli_entry_locus(entry: entry),
              target: cli_emit_target_model(t: target)
            )
            match emitted.outcome {
              Accepted { value: emission, diagnostics: _ } =>
                CliEmitted {
                  text: closure_emission_json(emission: emission),
                  closure_size: length(xs: emission.members),
                  refused_count: closure_emission_refused_count(emission: emission),
                  refusal_detail: match closure_emission_first_refusal(emission: emission) {
                    Absent => ""
                    Present { value: d } => v2_cli_refusal_detail(d: d, spans: emitted.spans)
                  }
                }
              Rejected { diagnostics: d } =>
                CliRunRefused {
                  reason: diagnostics_fatal_reason(d: d),
                  detail: v2_cli_refusal_detail(d: d, spans: emitted.spans)
                }
            }
          }
      }
  }
}

// A POPULATION VERB IS CALLED ONLY AFTER ITS ROOTS ARE BOUND, AND ACQUIRES NO CLOSURE, so it has no
// ingest to run over. Reaching it through the closure fold is a refusal that names the verb, not an
// empty-population answer.
fn cli_verb_takes_no_ingest(verb: String) -> CliRunOutcome {
  CliRunRefused {
    reason: ^cli_population_verb_takes_no_ingest,
    detail: concat(verb, " reads the bound trees itself and takes no acquired closure; it cannot run over an ingest")
  }
}

// WHAT A POPULATION VERB REPORTS: the located lines are the text, the verdict is whether it held, and
// the detail is the one sentence the process status carries.
fn cli_population_reported(report: PopulationReport) -> CliRunOutcome {
  CliPopulationReported { text: report.text, held: report.held, detail: report.detail }
}

// THE DIFFERENTIAL'S STATUS IS WHETHER THE POPULATION WAS WHOLLY OBSERVED, NEVER HOW MANY SITES
// DIFFER: the differing sites are the finding, not a failure. A file the census could not parse, or a
// grammar that did not prepare, leaves the population incomplete, and that fails the process so a
// partial count cannot be read as the whole one.
fn cli_if_arm_reader_differential_outcome(census: IardCensus) -> CliRunOutcome {
  match census {
    IardGrammarUnprepared { reason: _ } =>
      CliPopulationReported {
        text: if_arm_reader_differential_text(c: census),
        held: false,
        detail: "the grammar did not prepare; no site was observed"
      }
    IardCensusTaken { tally: t } =>
      CliPopulationReported {
        text: if_arm_reader_differential_text(c: census),
        held: t.files_refused == 0,
        detail: "some files did not parse; their sites are unobserved (see file_refused rows)"
      }
  }
}

// ONE RENDERING OF A LOCATED REFUSAL, for a refused closure and for a refused member alike: the whole
// ordered chain, then (when the fatal is an unbound mention) the census projection of WHAT failed,
// then the fatal's file and extent. `FATAL AT` stays last so suffix controls still hold. The
// projection is demand_census_unbound_locus_from_diagnostics; this renderer does not re-walk the node.
fn v2_cli_refusal_detail(d: NonEmptyDiagnostics, spans: SpanIndex) -> String {
  let chain = concat(
    "the closure did not emit; diagnostic chain: ",
    lens_verdict_diagnostics_located_chain_text_in_spans(d: d, index: spans)
  )
  let fatal = concat(
    " | FATAL AT ",
    lens_verdict_diagnostic_locus_text_in_spans(d: diagnostics_fatal(d: d), index: spans)
  )
  match demand_census_unbound_locus_from_diagnostics(d: d) {
    Absent => concat(chain, fatal)
    Present { value: loc } =>
      concat(
        concat(chain, concat(" | ", demand_census_unbound_site_text(u: optional_present(value: loc)))),
        fatal
      )
  }
}

// The entry's locus, for the one refusal that has no node of its own: an entry no ingested module
// declares (reference_closure_entry_not_rostered). The refusal's detail carries the spelling.
fn v2_cli_entry_locus(entry: String) -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: ^cli_entry_not_an_ingested_module } }, children: [])
}

// THE PROCESS STATUS IS DECIDED HERE, NOT BY THE SHIM. `std.process` `ProcessExit` is the carrier
// for an exit this program declares for ITSELF (as distinct from `std.process_termination`, which
// is an exit another process was OBSERVED to take), so the shim maps an arm to a number and decides
// nothing. A shim that chose the status from whether stdout was empty would be a second
// representation of the verdict, free to disagree with the outcome it was derived from.
// A plan refusal exits `exit_code_misuse` (2) and an emit refusal `exit_code_general_error` (1):
// "the invocation was not usable" and "the subject did not emit" ask the caller for different
// fixes, which is the split `v2.compiler.source_root_eval` `native_driver_plan_exit` already makes.
// A MEMBER'S REFUSAL IS CARRIED IN THE EMISSION AND STILL FAILS THE PROCESS: the text is written so a
// reader sees every member's arm, and the status says the closure did not wholly emit.
fn v2_cli_exit(outcome: CliRunOutcome) -> ProcessExit {
  match outcome {
    CliEmitted { text: _, closure_size: _, refused_count: refused, refusal_detail: detail } =>
      if refused == 0 {
        ExitSuccess
      } else {
        exit_failure(reason: detail)
      }
    CliRunRefused { reason: _, detail: detail } => exit_failure(reason: detail)
    CliUsageRefused { reason: _, detail: detail } =>
      ExitFailure { code: exit_code_misuse, reason: detail }
    CliPopulationReported { text: _, held: held, detail: detail } =>
      if held { ExitSuccess } else { exit_failure(reason: detail) }
  }
}

fn v2_cli_outcome_text(outcome: CliRunOutcome) -> String {
  match outcome {
    CliEmitted { text: text, closure_size: _, refused_count: _, refusal_detail: _ } => text
    CliRunRefused { reason: _, detail: _ } => ""
    CliUsageRefused { reason: _, detail: _ } => ""
    CliPopulationReported { text: text, held: _, detail: _ } => text
  }
}

// THE ACQUISITION IS VERIFIED BEFORE ANYTHING READS IT: a closure whose read set is not exactly the
// requested closure (v2.compiler.module_acquisition acquire_verified) is a refusal, never a smaller or
// larger program. The pure fold below sees the ingest of the verified members and nothing else.
fn cli_run_verified(plan: CliPlan, verified: VerifiedAcquisition) -> CliRunOutcome {
  match verified {
    AcquisitionNotVerified { reason: reason, cause: cause } =>
      CliRunRefused { reason: reason, detail: concat("the source roots did not yield an exact closure: ", cause) }
    AcquisitionVerified { modules: modules, reads: _, absent_probes: _ } =>
      v2_cli_run(plan: plan, ingest: acquisition_ingest(modules: modules))
  }
}

// WHAT EACH VERB ACQUIRES. `emit` acquires the closure of its entry. The differential's subject is a
// population, so it names the population explicitly -- every module the layout stores in the bound
// trees -- and acquires the closure of that list; nothing is walked as a side effect of compiling.
// The two population verbs acquire no closure at all: their subject is the population itself, and
// v2.cli.population_verbs reads it.
fn cli_run_acquired(plan: CliPlan, bindings: List<SourceRootBinding>, entries: List<String>) -> CliRunOutcome {
  cli_run_verified(
    plan: plan,
    verified: acquire_verified(layout: repository_storage_layout(), bindings: bindings, entries: entries)
  )
}

fn cli_run_differential(plan: CliPlan, bindings: List<SourceRootBinding>) -> CliRunOutcome {
  match enumerate_bound_modules(layout: repository_storage_layout(), bindings: bindings) {
    BoundModulesListed { modules: modules } => cli_run_acquired(plan: plan, bindings: bindings, entries: modules)
    BoundModulesRefused { subject: subject, cause: cause } =>
      CliRunRefused {
        reason: ^cli_population_unlisted,
        detail: concat("could not enumerate the modules of ", subject, ": ", cause)
      }
  }
}

fn write_if_path(path: Optional<String>, content: String, what: String) -> Optional<String> {
  match path {
    Absent => optional_absent()
    Present { value: p } => {
      let w = Filesystem.Write(path: p, content: content)
      if w.success {
        optional_absent()
      } else {
        optional_present(value: concat(concat("could not write ", what), concat(": ", w.error)))
      }
    }
  }
}

fn parse_population_written(
  bindings: List<SourceRootBinding>,
  compiler: Optional<String>,
  write_identity: Optional<String>,
  receipts: Optional<String>,
  reuse_from: Optional<String>
) -> PopulationReport {
  match reuse_from {
    Present { value: dir } => parse_population_reusing(bindings: bindings, compiler: compiler, write_identity: write_identity, receipts: receipts, dir: dir)
    Absent => parse_population_published(bindings: bindings, compiler: compiler, write_identity: write_identity, receipts: receipts)
  }
}

// REUSE IS THE PULL-REQUEST MODE AND PUBLISHING IS THE MAIN MODE; they do not combine. Reuse reports
// counts where publishing reports the receipts, so writing receipts from a reuse walk would store
// counts as a verdict. The combination is refused rather than ordered.
fn parse_population_reusing(
  bindings: List<SourceRootBinding>,
  compiler: Optional<String>,
  write_identity: Optional<String>,
  receipts: Optional<String>,
  dir: String
) -> PopulationReport {
  match compiler {
    Absent => PopulationReport { text: "", held: false, detail: "--reuse-from requires --compiler" }
    Present { value: _ } =>
      match write_identity {
        Present { value: _ } => PopulationReport { text: "", held: false, detail: "--reuse-from does not combine with --write-identity or --receipts" }
        Absent =>
          match receipts {
            Present { value: _ } => PopulationReport { text: "", held: false, detail: "--reuse-from does not combine with --write-identity or --receipts" }
            Absent =>
              parse_population(
                bindings: bindings,
                compiler: compiler,
                reuse: parse_verdict_reuse_requested(base: parse_verdict_base_read(dir: dir))
              )
          }
      }
  }
}

fn parse_population_published(
  bindings: List<SourceRootBinding>,
  compiler: Optional<String>,
  write_identity: Optional<String>,
  receipts: Optional<String>
) -> PopulationReport {
  let needs_compiler =
    match write_identity { Present { value: _ } => true  Absent => match receipts { Present { value: _ } => true  Absent => false } }
  if needs_compiler {
    match compiler {
      Absent =>
        PopulationReport {
          text: "",
          held: false,
          detail: "--write-identity and --receipts require --compiler"
        }
      Present { value: cid } => {
        let report = parse_population(bindings: bindings, compiler: compiler, reuse: parse_verdict_reuse_off())
        if !report.held {
          report
        } else {
          match write_if_path(path: write_identity, content: cid, what: "parse-compiler identity") {
            Present { value: detail } => PopulationReport { text: "", held: false, detail: detail }
            Absent =>
              match write_if_path(path: receipts, content: report.text, what: "parse-verdict receipts") {
                Present { value: detail } => PopulationReport { text: "", held: false, detail: detail }
                Absent => report
              }
          }
        }
      }
    }
  } else {
    parse_population(bindings: bindings, compiler: compiler, reuse: parse_verdict_reuse_off())
  }
}

fn cli_run_bound(plan: CliPlan, verb: CliVerb, bindings: List<SourceRootBinding>) -> CliRunOutcome {
  match verb {
    CliEmitClosure { entry: entry, source_roots: _, target: _ } =>
      cli_run_acquired(plan: plan, bindings: bindings, entries: [entry])
    CliIfArmReaderDifferential { source_roots: _ } => cli_run_differential(plan: plan, bindings: bindings)
    CliCheckLayout { source_roots: _ } => cli_population_reported(report: check_layout(bindings: bindings))
    CliSelectSpelledModules { source_roots: _ } => cli_population_reported(report: select_spelled_modules(bindings: bindings))
    CliParsePopulation { source_roots: _, compiler: compiler, write_identity: write_identity, receipts: receipts, reuse_from: reuse_from } =>
      cli_population_reported(
        report: parse_population_written(
          bindings: bindings,
          compiler: compiler,
          write_identity: write_identity,
          receipts: receipts,
          reuse_from: reuse_from
        )
      )
  }
}

fn cli_run_roots(plan: CliPlan, verb: CliVerb, roots: SourceRootBindings) -> CliRunOutcome {
  match roots {
    SourceRootsUnrecognized { argument: _ } =>
      CliUsageRefused {
        reason: ^cli_source_root_unrecognized,
        detail: source_root_bindings_refusal_text(bindings: roots)
      }
    SourceRootsDuplicated { argument: _ } =>
      CliUsageRefused {
        reason: ^cli_source_root_duplicated,
        detail: source_root_bindings_refusal_text(bindings: roots)
      }
    SourceRootsBound { bindings: bindings } => cli_run_bound(plan: plan, verb: verb, bindings: bindings)
  }
}

// One entry fold owns parse, source acquisition, and compilation. The native main supplies
// the existing Filesystem realization; a refused plan never acquires the filesystem.
fn v2_cli_main(argv: FreeMonoid<String>) -> CliRunOutcome {
  let plan = v2_cli_parse(argv: argv)
  match plan {
    CliPlanRefused { reason: reason, detail: detail } => CliUsageRefused { reason: reason, detail: detail }
    CliPlanParsed { verb: verb } =>
      cli_run_roots(plan: plan, verb: verb, roots: source_root_bindings(roots: v2_cli_plan_source_roots(plan: plan)))
  }
}
