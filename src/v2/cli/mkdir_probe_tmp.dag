module v2.cli.mkdir.probe.tmp

// One-shot probe (deleted after the read): does Filesystem.Write create missing parent
// directories, and does it refuse when a parent component is a regular file?

import std.types { Bool, String }
import extdeps.filesystem.filesystem_io { Filesystem }

fn probe(out_path: String) -> Bool {
  let base = "/tmp/gunbc-ref-mig-write-control-probe2"
  Filesystem.Write(path: "/tmp/gunbc-ref-mig-write-control-probe2-parentfile", content: "not-a-dir\n")
  let base = "/tmp"
  let deep = Filesystem.Write(path: base + "/deep/child.dag", content: "module tmp.mkdir.probe.deep\n")
  let parentfile = Filesystem.Write(path: base + "/parentfile", content: "not-a-dir\n")
  let underfile = Filesystem.Write(path: base + "/parentfile/child.dag", content: "module tmp.mkdir.probe.underfile\n")
  let text = "deep=" + (if deep.success { "ok" } else { "refused:" + deep.error })
    + " parentfile=" + (if parentfile.success { "ok" } else { "refused" })
    + " underfile=" + (if underfile.success { "ok(UNEXPECTED)" } else { "refused:" + underfile.error })
    + "\n"
  Filesystem.Write(path: out_path, content: text).success
}
