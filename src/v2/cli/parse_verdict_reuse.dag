module v2.cli.parse_verdict_reuse

import std.types { Bool, Char, Int, List, Map, String }
import std.algebra { FreeMonoid, Cons, Empty, FreeSemigroup, empty_map, fold_list, list_head, map_insert, skip }
import std.optional { Absent, Optional, Present }
import std.integer { int_to_decimal_string }
import std.coercion { unicode_scalar_fold, unicode_scalar_unfold }
import v2.std.text { string_split }
import extdeps.filesystem.filesystem_io {
  Filesystem,
  FilesystemReadOutcome,
  FilesystemReadRefused,
  FilesystemReadSucceeded,
  filesystem_read_outcome,
}
import gunbc.parse_verdict_schema {
  Reused,
  MissIdentityAbsent,
  MissIdentityMismatch,
  MissEntryAbsent,
  MissDeclaredRefused,
  MissDigestUnseen,
  ParseVerdictStanding,
  parse_verdict_restore_identity_basename,
  parse_verdict_restore_receipts_basename,
  parse_verdict_restore_ancestors_basename,
  parse_verdict_restore_ancestor_ordinals,
  parse_verdict_restore_slot_basename,
}

// THE PULL-REQUEST SIDE OF THE PARSE-VERDICT CACHE (gunbc.parse_verdict_schema owns the standing;
// this module owns reading what the workflow restored). The restored base-sha entries are read
// here and nowhere else, so the one kernel-String to Unicode-scalar crossing lives in
// `parse_verdict_receipt_lines` (ruling `gunbc.design_ruling text_crossings_go_through_the_unfold`).
//
// A READ THAT DID NOT SUCCEED IS A MISS, NEVER A PASS. A restore that found no entry (evicted,
// released after idle, or never published) leaves no file; a file that exists and cannot be read is
// also not usable. Both refuse reuse and re-parse, which is the safe direction: the failure arm
// narrows to the walk and cannot mint an Accepted. They are not distinguished here because nothing
// downstream acts differently on them; the typed standing records which blob was unusable.
type ParseVerdictBase {
  ancestor: Optional<String>
  i_base: Optional<String>
  receipt_lines: Optional<Map<String, Bool>>
}

data parse_verdict_line_delimiter: Char = 10

// ONE CROSSING: the receipts text unfolds to scalars, splits on the newline scalar, and each line
// folds back to the kernel text the digests are keyed in. The set is built once per run.
fn parse_verdict_line_scalars(text: String) -> FreeMonoid<FreeMonoid<Char>> {
  string_split(
    source: unicode_scalar_unfold(s: text),
    delimiter: FreeSemigroup { head: parse_verdict_line_delimiter, tail: Empty }
  )
}

fn parse_verdict_receipt_lines(text: String) -> Map<String, Bool> {
  let no_lines: Map<String, Bool> = empty_map()
  fold_list(
    xs: parse_verdict_line_scalars(text: text),
    empty: no_lines,
    cons: fn(acc, line) { map_insert(m: acc, key: unicode_scalar_fold(xs: line), value: true) }
  )
}

// The locator's record is at most the declared ordinals long, so a list is the right carrier here;
// the receipts, which are the whole population, stay a set built in one pass above.
fn parse_verdict_text_lines(text: String) -> List<String> {
  fold_list(
    xs: parse_verdict_line_scalars(text: text),
    empty: [],
    cons: fn(acc, line) { concat(acc, [unicode_scalar_fold(xs: line)]) }
  )
}

fn parse_verdict_base_from(
  ancestor: Optional<String>,
  identity: FilesystemReadOutcome,
  receipts: FilesystemReadOutcome
) -> ParseVerdictBase {
  ParseVerdictBase {
    ancestor: ancestor,
    i_base: match identity {
      FilesystemReadSucceeded { content: c } => Present { value: c }
      FilesystemReadRefused { error: _ } => Absent
    },
    receipt_lines: match receipts {
      FilesystemReadSucceeded { content: c } => Present { value: parse_verdict_receipt_lines(text: c) }
      FilesystemReadRefused { error: _ } => Absent
    }
  }
}

fn parse_verdict_restored_path(dir: String, basename: String) -> String { join([dir, "/", basename], "") }

fn parse_verdict_slot_path(dir: String, basename: String, ordinal: Int) -> String {
  parse_verdict_restored_path(dir: dir, basename: parse_verdict_restore_slot_basename(basename: basename, ordinal: ordinal))
}

// The sha the locator recorded at this ordinal. A missing or short record leaves it Absent, and an
// entry restored without a named ancestor is still reused only on exact identity.
fn parse_verdict_ancestor_at(ancestors: List<String>, ordinal: Int) -> Optional<String> {
  list_head(xs: skip(xs: ancestors, n: ordinal))
}

// What the restore left at one ordinal: the identity blob and the receipts, each as the read found it.
type ParseVerdictRestoredSlot {
  identity: FilesystemReadOutcome
  receipts: FilesystemReadOutcome
}

// THE LOCATOR'S SELECTION, pure over the slots the reads produced, newest first: the first ordinal
// whose identity blob was restored wins, and its receipts are the ones at the same ordinal. If no
// ordinal has a published identity the base has no identity at all, which the standing counts as
// MissIdentityAbsent. A later ancestor is never consulted once one has published, because a
// mismatched identity must refuse reuse, not fall through to a nearer match.
fn parse_verdict_base_select(ancestors: List<String>, slots: List<ParseVerdictRestoredSlot>, ordinal: Int) -> ParseVerdictBase {
  match slots {
    Empty {} => ParseVerdictBase { ancestor: Absent, i_base: Absent, receipt_lines: Absent }
    Cons { head: slot, tail: rest } =>
      match slot.identity {
        FilesystemReadSucceeded { content: _ } =>
          parse_verdict_base_from(
            ancestor: parse_verdict_ancestor_at(ancestors: ancestors, ordinal: ordinal),
            identity: slot.identity,
            receipts: slot.receipts
          )
        FilesystemReadRefused { error: _ } => parse_verdict_base_select(ancestors: ancestors, slots: rest, ordinal: ordinal + 1)
      }
  }
}

fn parse_verdict_slots_read(dir: String, ordinals: List<Int>) -> List<ParseVerdictRestoredSlot> {
  match ordinals {
    Empty {} => []
    Cons { head: ordinal, tail: rest } => {
      let identity = Filesystem.Read(path: parse_verdict_slot_path(dir: dir, basename: parse_verdict_restore_identity_basename, ordinal: ordinal))
      let receipts = Filesystem.Read(path: parse_verdict_slot_path(dir: dir, basename: parse_verdict_restore_receipts_basename, ordinal: ordinal))
      concat(
        [ParseVerdictRestoredSlot {
          identity: filesystem_read_outcome(content: identity.content, success: identity.success, error: identity.error),
          receipts: filesystem_read_outcome(content: receipts.content, success: receipts.success, error: receipts.error)
        }],
        parse_verdict_slots_read(dir: dir, ordinals: rest)
      )
    }
  }
}

fn parse_verdict_base_read(dir: String) -> ParseVerdictBase {
  let record = Filesystem.Read(path: parse_verdict_restored_path(dir: dir, basename: parse_verdict_restore_ancestors_basename))
  parse_verdict_base_select(
    ancestors: match filesystem_read_outcome(content: record.content, success: record.success, error: record.error) {
      FilesystemReadSucceeded { content: c } => parse_verdict_text_lines(text: c)
      FilesystemReadRefused { error: _ } => []
    },
    slots: parse_verdict_slots_read(dir: dir, ordinals: parse_verdict_restore_ancestor_ordinals),
    ordinal: 0
  )
}

type ParseVerdictReuseCounts {
  ancestor: String
  reused: Int
  miss_identity_absent: Int
  miss_identity_mismatch: Int
  miss_entry_absent: Int
  miss_digest_unseen: Int
  miss_declared_refused: Int
}

data parse_verdict_reuse_ancestor_none: String = "none"

fn parse_verdict_reuse_counts_zero(ancestor: Optional<String>) -> ParseVerdictReuseCounts {
  ParseVerdictReuseCounts {
    ancestor: match ancestor {
      Present { value: sha } => sha
      Absent => parse_verdict_reuse_ancestor_none
    },
    reused: 0,
    miss_identity_absent: 0,
    miss_identity_mismatch: 0,
    miss_entry_absent: 0,
    miss_digest_unseen: 0,
    miss_declared_refused: 0
  }
}

fn parse_verdict_reuse_counts_add(counts: ParseVerdictReuseCounts, standing: ParseVerdictStanding) -> ParseVerdictReuseCounts {
  match standing {
    Reused => ParseVerdictReuseCounts {
      ancestor: counts.ancestor,
      reused: counts.reused + 1,
      miss_identity_absent: counts.miss_identity_absent,
      miss_identity_mismatch: counts.miss_identity_mismatch,
      miss_entry_absent: counts.miss_entry_absent,
      miss_digest_unseen: counts.miss_digest_unseen,
      miss_declared_refused: counts.miss_declared_refused
    }
    MissIdentityAbsent => ParseVerdictReuseCounts {
      ancestor: counts.ancestor,
      reused: counts.reused,
      miss_identity_absent: counts.miss_identity_absent + 1,
      miss_identity_mismatch: counts.miss_identity_mismatch,
      miss_entry_absent: counts.miss_entry_absent,
      miss_digest_unseen: counts.miss_digest_unseen,
      miss_declared_refused: counts.miss_declared_refused
    }
    MissIdentityMismatch => ParseVerdictReuseCounts {
      ancestor: counts.ancestor,
      reused: counts.reused,
      miss_identity_absent: counts.miss_identity_absent,
      miss_identity_mismatch: counts.miss_identity_mismatch + 1,
      miss_entry_absent: counts.miss_entry_absent,
      miss_digest_unseen: counts.miss_digest_unseen,
      miss_declared_refused: counts.miss_declared_refused
    }
    MissEntryAbsent => ParseVerdictReuseCounts {
      ancestor: counts.ancestor,
      reused: counts.reused,
      miss_identity_absent: counts.miss_identity_absent,
      miss_identity_mismatch: counts.miss_identity_mismatch,
      miss_entry_absent: counts.miss_entry_absent + 1,
      miss_digest_unseen: counts.miss_digest_unseen,
      miss_declared_refused: counts.miss_declared_refused
    }
    MissDigestUnseen => ParseVerdictReuseCounts {
      ancestor: counts.ancestor,
      reused: counts.reused,
      miss_identity_absent: counts.miss_identity_absent,
      miss_identity_mismatch: counts.miss_identity_mismatch,
      miss_entry_absent: counts.miss_entry_absent,
      miss_digest_unseen: counts.miss_digest_unseen + 1,
      miss_declared_refused: counts.miss_declared_refused
    }
    MissDeclaredRefused => ParseVerdictReuseCounts {
      ancestor: counts.ancestor,
      reused: counts.reused,
      miss_identity_absent: counts.miss_identity_absent,
      miss_identity_mismatch: counts.miss_identity_mismatch,
      miss_entry_absent: counts.miss_entry_absent,
      miss_digest_unseen: counts.miss_digest_unseen,
      miss_declared_refused: counts.miss_declared_refused + 1
    }
  }
}

fn parse_verdict_reuse_counts_text(counts: ParseVerdictReuseCounts) -> String {
  join(
    [
      "parse-verdict reuse: ancestor=", counts.ancestor,
      " reused=", int_to_decimal_string(value: counts.reused),
      " miss_identity_absent=", int_to_decimal_string(value: counts.miss_identity_absent),
      " miss_identity_mismatch=", int_to_decimal_string(value: counts.miss_identity_mismatch),
      " miss_entry_absent=", int_to_decimal_string(value: counts.miss_entry_absent),
      " miss_digest_unseen=", int_to_decimal_string(value: counts.miss_digest_unseen),
      " miss_declared_refused=", int_to_decimal_string(value: counts.miss_declared_refused)
    ],
    ""
  )
}
