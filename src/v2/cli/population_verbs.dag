module v2.cli.population_verbs

import std.types { Bool, Int, List, Map }
import std.algebra { string_contains, Cons, Empty, fold_list, is_empty, length, list_head, list_map, list_reverse, skip, empty_map, map_contains_key, map_insert, map_lookup, collection_concat_shape, collection_join_shape }
import std.optional { Absent, Optional, Present }
import std.integer { int_to_decimal_string }
import v2.cli.parse_verdict_reuse { ParseVerdictBase, ParseVerdictReuseCounts, parse_verdict_reuse_counts_zero, parse_verdict_reuse_counts_add, parse_verdict_reuse_counts_text }
import gunbc.parse_population_refusals { RefusalClass, parse_population_declared_refusal_classes }
import gunbc.parse_verdict_schema {
  ParseVerdictStanding,
  Reused,
  MissIdentityAbsent,
  MissIdentityMismatch,
  MissEntryAbsent,
  MissDigestUnseen,
  MissDeclaredRefused,
  parse_verdict_standing,
  parse_verdict_stored_accepted_line,
  parse_verdict_receipts_empty_detail,
}
import gunbc.source_layout_namespaces { layout_namespaces }
import gunbc.source_root_read { SourceRootPathsRead, SourceRootPathsRefused, SourceRootWalkTask, source_root_child_path, source_root_walk }
import v2.cli.repository_layout { repository_storage_layout }
import v2.compiler.module_acquisition { AcquisitionEnv, AcquisitionEnvReady, AcquisitionEnvUnprepared, BoundModulesListed, BoundModulesRefused, MemberParseRefused, MemberParses, PopulationMemberRead, PopulationMemberRefused, SourceRootBinding, acquisition_env, acquisition_header_reader, acquisition_parse, acquisition_probe, enumerate_bound_modules, population_member }
import v2.compiler.source_authority { SourceStorageLayout, LayoutFileHeader, LayoutHolds, LayoutRefused, LayoutVerdict, ModuleFileAbsent, ModuleFilePresent, ModuleFileRef, ModuleFileRefused, layout_check, layout_verdict_holds, layout_verdict_text, module_file_key }
import v2.compiler.module_header { ModuleHeaderReader, module_header_read }
import v2.std.text { String }
import std.content_hash { content_hash_atom }
import gunbc.namespace_cut.ambient_name_home { AmbientNameHome, ambient_name_homes }


// THE WHOLE-POPULATION VERBS. Compiling an entry reads the modules that entry requests and nothing
// else (v2.compiler.module_acquisition); a job whose subject IS the population -- is every governed
// file where the storage rule puts it, does every governed module parse -- is a different question
// and gets its own explicit verb, enumerated from the layout and never a side effect of compiling
// something. Each verb holds or refuses: it has no mode that proceeds past a refusal, it reads no
// body it does not need, and it retains no index of what it read.
//
// WHAT EACH VERB'S POPULATION IS.
//   check-layout        every `.dag` file physically under a bound tree. The physical walk is the
//                       point: a file in a namespace the declared rows do not name, or one stored
//                       where its name does not put it, is invisible to any enumeration that starts
//                       from the layout, so only a walk can refuse it. Each file contributes its
//                       position and the module line it declares -- the header, not the body -- and
//                       the pure verdict is `v2.compiler.source_authority` `layout_check`.
//   parse-population   every module the declared namespace rows store under the bound trees
//                       (`enumerate_bound_modules`), read and parsed one at a time. Only the
//                       verdict of each parse is kept, so the memory is the refusals and not the
//                       population. A population that enumerates to zero modules refuses: a parse
//                       over nothing is not a parse of zero.
type PopulationReport {
  text: String
  held: Bool
  detail: String
}

// ---- check-layout -----------------------------------------------------------------------------------

type TreeFiles
  = TreeFilesListed { files: List<ModuleFileRef> }
  | TreeFilesRefused { path: String, kind: String, cause: String }

type LayoutHeaders
  = LayoutHeadersRead { headers: List<LayoutFileHeader> }
  | LayoutHeadersRefused { cause: String }

fn tree_relative_path(directory: String, path: String) -> String {
  substring(s: path, start: string_length(s: source_root_child_path(directory: directory, name: "")), end: string_length(s: path))
}

fn tree_files(binding: SourceRootBinding) -> TreeFiles {
  match source_root_walk(
    pending: [SourceRootWalkTask { path: binding.host_directory, root: true, origin: binding.host_directory }],
    paths: [],
    suffix: ".dag"
  ) {
    SourceRootPathsRefused { path: path, kind: kind, cause: cause } => TreeFilesRefused { path: path, kind: kind, cause: cause }
    SourceRootPathsRead { paths: paths } =>
      TreeFilesListed {
        files: list_map(xs: paths, f: fn(walked) {
          ModuleFileRef { tree: binding.tree, relative_path: tree_relative_path(directory: binding.host_directory, path: walked.path) }
        })
      }
  }
}

fn layout_headers_go(reader: ModuleHeaderReader, host_directory: String, pending: List<ModuleFileRef>, acc: List<LayoutFileHeader>) -> LayoutHeaders {
  match list_head(xs: pending) {
    Absent => LayoutHeadersRead { headers: acc }
    Present { value: file } =>
      match acquisition_probe(host_directory: host_directory, file: file) {
        ModuleFilePresent { file: _, content: content } =>
          layout_headers_go(
            reader: reader,
            host_directory: host_directory,
            pending: skip(xs: pending, n: 1),
            acc: Cons { head: LayoutFileHeader { file: file, declared: module_header_read(reader: reader, file: module_file_key(file: file), content: content) }, tail: acc }
          )
        ModuleFileAbsent { file: _ } =>
          LayoutHeadersRefused { cause: concat(module_file_key(file: file), ": the walk listed the file and it is absent") }
        ModuleFileRefused { file: _, cause: cause } => LayoutHeadersRefused { cause: concat(module_file_key(file: file), ": ", cause) }
      }
  }
}

fn layout_bindings_headers(reader: ModuleHeaderReader, pending: List<SourceRootBinding>, acc: List<LayoutFileHeader>) -> LayoutHeaders {
  match list_head(xs: pending) {
    Absent => LayoutHeadersRead { headers: acc }
    Present { value: binding } =>
      match tree_files(binding: binding) {
        TreeFilesRefused { path: path, kind: kind, cause: cause } =>
          LayoutHeadersRefused { cause: concat("could not walk ", path, ": ", kind, ": ", cause) }
        TreeFilesListed { files: files } =>
          match layout_headers_go(reader: reader, host_directory: binding.host_directory, pending: files, acc: acc) {
            LayoutHeadersRefused { cause: cause } => LayoutHeadersRefused { cause: cause }
            LayoutHeadersRead { headers: headers } => layout_bindings_headers(reader: reader, pending: skip(xs: pending, n: 1), acc: headers)
          }
      }
  }
}

fn layout_verdict_detail(verdict: LayoutVerdict) -> String {
  match verdict {
    LayoutHolds => "the layout holds"
    LayoutRefused { refusals: refusals } =>
      concat("the layout does not hold: ", int_to_decimal_string(value: length(xs: refusals)), " refusal(s), each on its own line of the report")
  }
}

fn layout_report(verdict: LayoutVerdict) -> PopulationReport {
  PopulationReport { text: layout_verdict_text(verdict: verdict), held: layout_verdict_holds(verdict: verdict), detail: layout_verdict_detail(verdict: verdict) }
}

// THE LAYOUT CHECK OVER THE BOUND TREES. A tree that cannot be walked or a file that cannot be read
// refuses the whole check: a layout verdict over a population that silently lost a member would
// certify a smaller repository.
fn check_layout(bindings: List<SourceRootBinding>) -> PopulationReport {
  match acquisition_env(layout: repository_storage_layout(), bindings: bindings) {
    AcquisitionEnvUnprepared { diagnostics: _ } =>
      PopulationReport { text: "", held: false, detail: "the dag grammar did not prepare; no module header was read" }
    AcquisitionEnvReady { env: env } => check_layout_prepared(env: env, bindings: bindings)
  }
}

fn check_layout_prepared(env: AcquisitionEnv, bindings: List<SourceRootBinding>) -> PopulationReport {
  match layout_bindings_headers(reader: acquisition_header_reader(env: env), pending: bindings, acc: []) {
    LayoutHeadersRefused { cause: cause } =>
      PopulationReport { text: cause, held: false, detail: concat("the layout could not be observed: ", cause) }
    LayoutHeadersRead { headers: headers } =>
      layout_report(verdict: layout_check(layout: repository_storage_layout(), namespaces: layout_namespaces(), headers: headers))
  }
}

// ---- parse-population --------------------------------------------------------------------------------

// A DECLARED REFUSAL IS A MODULE FILE KEY AND A PARSE CAUSE, EXACTLY (gunbc.parse_population_refusals): a
// module the declared classes do not name, or a named module that now fails for another cause, is not
// covered by them. The DECLARATION is also an obligation on the walk: it names modules the walk must
// meet, so a declared refusal the walk never judged is itself a refusal of the population.
type DeclaredRefusal {
  key: String
  cause: String
}

// The declaration as the fold consumes it: every declared refusal in class order, and the cause each
// module file key is declared refused for. A key is declared once, so the second map holds exactly the
// first.
type DeclaredRoster {
  ordered: List<DeclaredRefusal>
  causes: Map<String, String>
}

// What a streaming parse keeps: how many parsed outright, how many members refused exactly as
// declared, the roster and the keys the walk has judged (a declared refusal is REMAINING until its key
// is judged, and what remains when the walk ends is a located refusal), one located line per module
// the population parse must report (newest first), and the Accepted request-key receipts (source
// digest only — not the tree, not the bytes). No content and no module list survives the member
// that produced it.
// THE REUSE STATE OF ONE WALK: Absent basis means reuse was not requested (every module parses, as
// before); a Present basis answers each module's standing and the counts keep every outcome.
type ParseVerdictReuse {
  base: Optional<ParseVerdictBase>
  counts: ParseVerdictReuseCounts
}

fn parse_verdict_reuse_off() -> ParseVerdictReuse {
  ParseVerdictReuse { base: Absent, counts: parse_verdict_reuse_counts_zero(ancestor: Absent) }
}

fn parse_verdict_reuse_requested(base: ParseVerdictBase) -> ParseVerdictReuse {
  ParseVerdictReuse { base: Present { value: base }, counts: parse_verdict_reuse_counts_zero(ancestor: base.ancestor) }
}

type PopulationParse {
  parsed: Int
  declared: Int
  roster: DeclaredRoster
  judged: Map<String, Bool>
  refusals: List<String>
  accepted_receipts: List<String>
  compiler: Optional<String>
  reuse: ParseVerdictReuse
}

type RosterBuild {
  ordered_reversed: List<DeclaredRefusal>
  causes: Map<String, String>
  duplicates_reversed: List<String>
}

fn roster_build_add(acc: RosterBuild, key: String, cause: String) -> RosterBuild {
  if map_contains_key(m: acc.causes, key: key) {
    RosterBuild {
      ordered_reversed: acc.ordered_reversed,
      causes: acc.causes,
      duplicates_reversed: Cons { head: key, tail: acc.duplicates_reversed }
    }
  } else {
    RosterBuild {
      ordered_reversed: Cons { head: DeclaredRefusal { key: key, cause: cause }, tail: acc.ordered_reversed },
      causes: map_insert(m: acc.causes, key: key, value: cause),
      duplicates_reversed: acc.duplicates_reversed
    }
  }
}

// THE ROSTER REFUSES A MODULE DECLARED TWICE, whether by two classes or twice by one: a module has one
// parse result, so a second declaration is a second authority for it, and consuming whichever came first
// would hide the other.
type PopulationBegin
  = PopulationBegun { tally: PopulationParse }
  | PopulationDeclarationDuplicated { keys: List<String> }

fn population_parse_begin(classes: List<RefusalClass>, compiler: Optional<String>, reuse: ParseVerdictReuse) -> PopulationBegin {
  let no_causes: Map<String, String> = empty_map()
  let no_judged: Map<String, Bool> = empty_map()
  let built = fold_list(
    xs: classes,
    empty: RosterBuild { ordered_reversed: [], causes: no_causes, duplicates_reversed: [] },
    cons: fn(acc, group) {
      fold_list(xs: group.keys, empty: acc, cons: fn(inner, key) { roster_build_add(acc: inner, key: key, cause: group.cause) })
    }
  )
  if is_empty(xs: built.duplicates_reversed) {
    PopulationBegun {
      tally: PopulationParse {
        parsed: 0,
        declared: 0,
        roster: DeclaredRoster { ordered: list_reverse(xs: built.ordered_reversed), causes: built.causes },
        judged: no_judged,
        refusals: [],
        accepted_receipts: [],
        compiler: compiler,
        reuse: reuse
      }
    }
  } else {
    PopulationDeclarationDuplicated { keys: list_reverse(xs: built.duplicates_reversed) }
  }
}

// THE ONE LOOKUP OF A DECLARATION: the cause a module file key is declared refused for, if it is.
fn roster_cause(roster: DeclaredRoster, key: String) -> Optional<String> {
  map_lookup(m: roster.causes, key: key)
}

// Whether the declaration names this module refused for exactly this cause: how a consumer that
// judges a refusal outside the walk (the witness-set join's declared unread files) asks the same
// question the walk asks.
fn roster_declares(roster: DeclaredRoster, key: String, cause: String) -> Bool {
  match roster_cause(roster: roster, key: key) {
    Present { value: declared_cause } => declared_cause == cause
    Absent => false
  }
}

fn population_parse_judged(tally: PopulationParse, key: String) -> Map<String, Bool> {
  map_insert(m: tally.judged, key: key, value: true)
}

// A member the walk judged: exactly as declared (consumes its declaration), declared for another cause
// (consumes it and contradicts it), or not declared at all (a refusal of its own).
fn population_parse_refused(tally: PopulationParse, key: String, cause: String) -> PopulationParse {
  match roster_cause(roster: tally.roster, key: key) {
    Present { value: declared_cause } =>
      if declared_cause == cause {
        PopulationParse {
          parsed: tally.parsed,
          declared: tally.declared + 1,
          roster: tally.roster,
          judged: population_parse_judged(tally: tally, key: key),
          refusals: tally.refusals,
          accepted_receipts: tally.accepted_receipts,
          compiler: tally.compiler,
          reuse: tally.reuse
        }
      } else {
        PopulationParse {
          parsed: tally.parsed,
          declared: tally.declared,
          roster: tally.roster,
          judged: population_parse_judged(tally: tally, key: key),
          refusals: Cons {
            head: concat(key, ": ", cause, "; gunbc.parse_population_refusals declares it refused for ", declared_cause),
            tail: tally.refusals
          },
          accepted_receipts: tally.accepted_receipts,
          compiler: tally.compiler,
          reuse: tally.reuse
        }
      }
    Absent =>
      PopulationParse {
        parsed: tally.parsed,
        declared: tally.declared,
        roster: tally.roster,
        judged: tally.judged,
        refusals: Cons { head: concat(key, ": ", cause), tail: tally.refusals },
        accepted_receipts: tally.accepted_receipts,
        compiler: tally.compiler,
        reuse: tally.reuse
      }
  }
}

// THE OTHER DIRECTION OF THE SAME EXACTNESS: a module the declared classes name that parses is not an
// unchanged state, so the list can only shrink -- a class is retired by the capability, never carried
// past it.
fn population_parse_accepted(tally: PopulationParse, key: String, source_digest: String) -> PopulationParse {
  match roster_cause(roster: tally.roster, key: key) {
    Present { value: declared_cause } =>
      PopulationParse {
        parsed: tally.parsed,
        declared: tally.declared,
        roster: tally.roster,
        judged: population_parse_judged(tally: tally, key: key),
        refusals: Cons {
          head: concat(key, ": parses, but gunbc.parse_population_refusals declares it refused for ", declared_cause, "; remove it from its class"),
          tail: tally.refusals
        },
        accepted_receipts: tally.accepted_receipts,
        compiler: tally.compiler,
        reuse: tally.reuse
      }
    Absent =>
      PopulationParse {
        parsed: tally.parsed + 1,
        declared: tally.declared,
        roster: tally.roster,
        judged: tally.judged,
        refusals: tally.refusals,
        accepted_receipts: match tally.compiler {
          Absent => tally.accepted_receipts
          Present { value: compiler } => Cons {
            head: parse_verdict_stored_accepted_line(source_digest: source_digest, compiler: compiler),
            tail: tally.accepted_receipts
          }
        },
        compiler: tally.compiler,
        reuse: tally.reuse
      }
  }
}

// THE STANDING OF ONE MEMBER, or none when reuse was not requested. A module the declared classes
// name refused never reuses: a receipt records an Accepted parse, and the declaration says the module
// does not parse, so the contradiction is for the parse to report, not for a stored line to settle.
fn population_parse_standing(tally: PopulationParse, key: String, source_digest: String) -> Optional<ParseVerdictStanding> {
  match tally.reuse.base {
    Absent => Absent
    Present { value: base } =>
      match tally.compiler {
        Absent => Absent
        Present { value: i_head } =>
          match parse_verdict_standing(i_head: i_head, i_base: base.i_base, receipt_lines: base.receipt_lines, source_digest: source_digest) {
            Reused =>
              match roster_cause(roster: tally.roster, key: key) {
                Present { value: _ } => Present { value: MissDeclaredRefused }
                Absent => Present { value: Reused }
              }
            MissIdentityAbsent => Present { value: MissIdentityAbsent }
            MissIdentityMismatch => Present { value: MissIdentityMismatch }
            MissEntryAbsent => Present { value: MissEntryAbsent }
            MissDigestUnseen => Present { value: MissDigestUnseen }
            MissDeclaredRefused => Present { value: MissDeclaredRefused }
          }
      }
  }
}

fn population_parse_counted(tally: PopulationParse, standing: Optional<ParseVerdictStanding>) -> PopulationParse {
  match standing {
    Absent => tally
    Present { value: s } =>
      PopulationParse {
        parsed: tally.parsed,
        declared: tally.declared,
        roster: tally.roster,
        judged: tally.judged,
        refusals: tally.refusals,
        accepted_receipts: tally.accepted_receipts,
        compiler: tally.compiler,
        reuse: ParseVerdictReuse { base: tally.reuse.base, counts: parse_verdict_reuse_counts_add(counts: tally.reuse.counts, standing: s) }
      }
  }
}

fn population_parse_member(env: AcquisitionEnv, name: String, tally: PopulationParse) -> PopulationParse {
  match population_member(layout: env.layout, bindings: env.bindings, name: name) {
    PopulationMemberRefused { cause: cause } =>
      PopulationParse {
        parsed: tally.parsed,
        declared: tally.declared,
        roster: tally.roster,
        judged: tally.judged,
        refusals: Cons { head: concat(name, ": ", cause), tail: tally.refusals },
        accepted_receipts: tally.accepted_receipts,
        compiler: tally.compiler,
        reuse: tally.reuse
      }
    PopulationMemberRead { member: member } => {
      let key = module_file_key(file: member.file)
      let source_digest = content_hash_atom(value: member.content).digest as String
      let standing = population_parse_standing(tally: tally, key: key, source_digest: source_digest)
      let counted = population_parse_counted(tally: tally, standing: standing)
      match standing {
        Present { value: Reused } => population_parse_accepted(tally: counted, key: key, source_digest: source_digest)
        _ =>
          match acquisition_parse(env: env, file: member.file, content: member.content) {
            MemberParses => population_parse_accepted(tally: counted, key: key, source_digest: source_digest)
            MemberParseRefused { cause: cause } => population_parse_refused(tally: counted, key: key, cause: cause)
          }
      }
    }
  }
}

fn population_parse_go(env: AcquisitionEnv, pending: List<String>, tally: PopulationParse) -> PopulationParse {
  match pending {
    Empty => tally
    Cons { head: name, tail: rest } =>
      population_parse_go(env: env, pending: rest, tally: population_parse_member(env: env, name: name, tally: tally))
  }
}

// THE DECLARED REFUSALS THE WALK NEVER JUDGED, one located line each, in declaration order. A module
// deleted, renamed or left out of the enumeration leaves its declaration here, so the list may not
// outlive its files.
fn population_parse_unmet(tally: PopulationParse) -> List<String> {
  list_map(
    xs: tally.roster.ordered |> filter(fn(declaration) { !map_contains_key(m: tally.judged, key: declaration.key) }),
    f: fn(declaration) {
      concat(
        declaration.key,
        ": gunbc.parse_population_refusals declares it refused for ",
        declaration.cause,
        ", but the population parse never met the module; it is not in the enumerated population, so remove it from its class"
      )
    }
  )
}

// THE VERDICT IS THIS FUNCTION'S, AND ONLY THIS FUNCTION'S. `held` follows from the typed result: no
// contradicted or unreadable member, no declared refusal left unmet, and at least one module parsed. A
// host that prints the report reads `held`; it does not reinterpret the text to decide whether a held
// population held. A walk that observed no module at all says so in its detail (the unmet declarations
// follow from it, and stay on the text, one located line each) rather than reporting only the
// consequence.
fn population_parse_report(tally: PopulationParse) -> PopulationReport {
  let unmet = population_parse_unmet(tally: tally)
  let lines = list_reverse(xs: fold_list(xs: unmet, empty: tally.refusals, cons: fn(acc, line) { Cons { head: line, tail: acc } }))
  let nothing_observed = tally.parsed == 0 && tally.declared == 0 && is_empty(xs: tally.refusals)
  if length(xs: lines) > 0 && !nothing_observed {
    PopulationReport {
      text: join(lines, "\n"),
      held: false,
      detail: concat(
        int_to_decimal_string(value: length(xs: tally.refusals)),
        " module(s) did not parse, could not be read, or contradict the declared refusals; ",
        int_to_decimal_string(value: length(xs: unmet)),
        " declared refusal(s) never met, each on its own line of the report"
      )
    }
  } else if match tally.compiler {
    Present { value: _ } => is_empty(xs: tally.accepted_receipts)
    Absent => tally.parsed == 0
  } {
    match tally.compiler {
      Present { value: _ } =>
        PopulationReport {
          text: "",
          held: false,
          detail: parse_verdict_receipts_empty_detail
        }
      Absent =>
        PopulationReport {
          text: join(lines, "\n"),
          held: false,
          detail: "the bound trees store no module under the declared namespaces; a parse over nothing is not a parse of zero"
        }
    }
  } else {
    match tally.compiler {
      Present { value: _ } =>
        PopulationReport {
          text: match tally.reuse.base {
            Absent => join(list_reverse(xs: tally.accepted_receipts), "\n")
            Present { value: _ } => parse_verdict_reuse_counts_text(counts: tally.reuse.counts)
          },
          held: true,
          detail: "every enumerated module parsed or is refused exactly as declared, and every declared refusal was met"
        }
      Absent =>
        PopulationReport {
          text: concat(
            "population parses: ",
            int_to_decimal_string(value: tally.parsed),
            " module(s); ",
            int_to_decimal_string(value: tally.declared),
            " refusal(s) declared by gunbc.parse_population_refusals, each met"
          ),
          held: true,
          detail: "every enumerated module parsed or is refused exactly as declared, and every declared refusal was met"
        }
    }
  }
}

fn population_declaration_duplicated_report(keys: List<String>) -> PopulationReport {
  PopulationReport {
    text: join(list_map(xs: keys, f: fn(key) { concat(key, ": gunbc.parse_population_refusals declares it more than once") }), "\n"),
    held: false,
    detail: "gunbc.parse_population_refusals declares a module more than once; a module is declared in exactly one class"
  }
}

fn parse_population_listed(env: AcquisitionEnv, modules: List<String>, compiler: Optional<String>, reuse: ParseVerdictReuse) -> PopulationReport {
  match population_parse_begin(classes: parse_population_declared_refusal_classes(), compiler: compiler, reuse: reuse) {
    PopulationDeclarationDuplicated { keys: keys } => population_declaration_duplicated_report(keys: keys)
    PopulationBegun { tally: tally } => population_parse_report(tally: population_parse_go(env: env, pending: modules, tally: tally))
  }
}

fn parse_population_prepared(env: AcquisitionEnv, compiler: Optional<String>, reuse: ParseVerdictReuse) -> PopulationReport {
  match enumerate_bound_modules(layout: env.layout, bindings: env.bindings) {
    BoundModulesRefused { subject: subject, cause: cause } =>
      PopulationReport {
        text: concat(subject, ": ", cause),
        held: false,
        detail: concat("could not enumerate the modules of ", subject)
      }
    BoundModulesListed { modules: modules } => parse_population_listed(env: env, modules: modules, compiler: compiler, reuse: reuse)
  }
}

fn parse_population(bindings: List<SourceRootBinding>, compiler: Optional<String>, reuse: ParseVerdictReuse) -> PopulationReport {
  match acquisition_env(layout: repository_storage_layout(), bindings: bindings) {
    AcquisitionEnvUnprepared { diagnostics: _ } =>
      PopulationReport { text: "", held: false, detail: "the dag grammar did not prepare; no module was observed" }
    AcquisitionEnvReady { env: env } => parse_population_prepared(env: env, compiler: compiler, reuse: reuse)
  }
}

// ---- select-spelled-modules ---------------------------------------------------------------------------
//
// THE MODULES THAT SPELL A RULED NAME. The population an ambient-name census must cover at a revision is the
// modules whose source writes a name some wave moves (gunbc.namespace_cut.ambient_name_home ambient_name_homes,
// the one roster of those names). The roots are the only input: the names are the roster's, so there is no
// second place to list them. The population is the declared namespace rows' modules (`enumerate_bound_modules`,
// names derived FORWARD under the storage rule, never a path mapped back), and a module is selected when its
// text contains a ruled spelling.
//
// THIS IS AN OVER-APPROXIMATION COMPUTED AS THE ANSWER, and says so: selection is by SPELLING, not by binding. A
// comment, a string literal or a longer identifier that contains the spelling selects its module, which only
// widens the census; a module that binds the name without writing it cannot exist, because an occurrence is a
// written spelling. It is a superset of the set a binding-level census would cover, never a subset, and the
// census still reports a binding row per occurrence, so a selected module with no occurrence contributes none.
// A module that cannot be read refuses the whole selection: a population that silently lost a member would
// certify a smaller repository.
fn spelled_in(content: String, names: List<String>) -> Bool {
  fold_list(xs: names, empty: false, cons: fn(acc, name) { if acc { true } else { string_contains(s: content, pattern: name) } })
}

type SpelledSelection
  = SpelledSelected { names: List<String> }
  | SpelledRefused { module: String, cause: String }

fn select_spelled_go(
  layout: SourceStorageLayout,
  bindings: List<SourceRootBinding>,
  pending: List<String>,
  spellings: List<String>,
  acc: List<String>
) -> SpelledSelection {
  match list_head(xs: pending) {
    Absent => SpelledSelected { names: list_reverse(xs: acc) }
    Present { value: name } =>
      match population_member(layout: layout, bindings: bindings, name: name) {
        PopulationMemberRefused { cause: cause } => SpelledRefused { module: name, cause: cause }
        PopulationMemberRead { member: member } =>
          select_spelled_go(
            layout: layout,
            bindings: bindings,
            pending: skip(xs: pending, n: 1),
            spellings: spellings,
            acc: if spelled_in(content: member.content, names: spellings) { Cons { head: name, tail: acc } } else { acc }
          )
      }
  }
}

fn select_spelled_report(selection: SpelledSelection) -> PopulationReport {
  match selection {
    SpelledRefused { module: module, cause: cause } =>
      PopulationReport { text: concat(module, ": ", cause), held: false, detail: concat("could not read ", module) }
    SpelledSelected { names: names } =>
      PopulationReport { text: join(names, "\n"), held: true, detail: "" }
  }
}

fn select_spelled_listed(env: AcquisitionEnv, modules: List<String>) -> PopulationReport {
  if is_empty(xs: modules) {
    PopulationReport { text: "", held: false, detail: "the bound trees enumerate to zero modules; a selection over nothing is not a selection of zero" }
  } else {
    select_spelled_report(
      selection: select_spelled_go(
        layout: env.layout,
        bindings: env.bindings,
        pending: modules,
        spellings: list_map(xs: ambient_name_homes(), f: fn(row) { row.name as String }),
        acc: []
      )
    )
  }
}

fn select_spelled_modules(bindings: List<SourceRootBinding>) -> PopulationReport {
  match acquisition_env(layout: repository_storage_layout(), bindings: bindings) {
    AcquisitionEnvUnprepared { diagnostics: _ } =>
      PopulationReport { text: "", held: false, detail: "the dag grammar did not prepare; no module was observed" }
    AcquisitionEnvReady { env: env } =>
      match enumerate_bound_modules(layout: env.layout, bindings: env.bindings) {
        BoundModulesRefused { subject: subject, cause: cause } =>
          PopulationReport { text: concat(subject, ": ", cause), held: false, detail: concat("could not enumerate the modules of ", subject) }
        BoundModulesListed { modules: modules } => select_spelled_listed(env: env, modules: modules)
      }
  }
}
