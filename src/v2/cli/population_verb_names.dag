module v2.cli.population_verb_names

import std.types { String, Bool }

// THE SPELLING OF THE TWO WHOLE-POPULATION CLI VERBS, one place. v2.cli.compile_cli parses them.
// Putting the strings in compile_cli forced every consumer either to import that closure or to mint
// a second copy (DESIGN §3). The contract epoch hashes the guarantee rows below, not these
// spellings: a renamed verb with the same meaning must not move the epoch, and a changed meaning
// under the same spelling must.
data cli_verb_check_layout: String = "check-layout"
data cli_verb_parse_population: String = "parse-population"

// WHAT check_layout / parse_population GUARANTEE when they hold. v2.cli.population_verbs reads these
// fields before the walk (false refuses without walking); gunbc.required_ci_contract_epoch hashes
// the same rows.
type SourceLayoutCheckGuarantee {
  physical_walk_of_bound_trees: Bool
}

type PopulationParseGuarantee {
  parse_every_declared_namespace_module: Bool
  meet_declared_refusals: Bool
}

data source_layout_check_guarantee: SourceLayoutCheckGuarantee = SourceLayoutCheckGuarantee {
  physical_walk_of_bound_trees: true,
}

data population_parse_guarantee: PopulationParseGuarantee = PopulationParseGuarantee {
  parse_every_declared_namespace_module: true,
  meet_declared_refusals: true,
}

fn source_layout_check_guarantee_digest(guarantee: SourceLayoutCheckGuarantee) -> String {
  if guarantee.physical_walk_of_bound_trees {
    "physical_walk_of_bound_trees"
  } else {
    "layout_walk_not_required"
  }
}

fn population_parse_guarantee_digest(guarantee: PopulationParseGuarantee) -> String {
  join([
    if guarantee.parse_every_declared_namespace_module { "parse_every_declared_namespace_module" } else { "parse_not_required" },
    "\t",
    if guarantee.meet_declared_refusals { "meet_declared_refusals" } else { "declared_refusals_not_required" },
  ], "")
}
