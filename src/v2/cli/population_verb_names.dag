module v2.cli.population_verb_names

import std.types { String }

// THE SPELLING OF THE TWO WHOLE-POPULATION CLI VERBS, one place. v2.cli.compile_cli parses them.
// Putting the strings in compile_cli forced every consumer either to import that closure or to mint
// a second copy (DESIGN §3). The contract epoch hashes the guarantee coproducts below, not these
// spellings: a renamed verb with the same meaning must not move the epoch, and a changed meaning
// under the same spelling must.
data cli_verb_check_layout: String = "check-layout"
data cli_verb_parse_population: String = "parse-population"

// WHAT check_layout / parse_population GUARANTEE when they hold. v2.cli.population_verbs executes
// these rows (a match on the data value before the walk); gunbc.required_ci_contract_epoch hashes
// the same rows.
type SourceLayoutCheckGuarantee
  = PhysicalWalkOfBoundTreesAgainstRepositoryStorageLayout
  | LayoutGuaranteeUnspecified

type PopulationParseGuarantee
  = ParseEveryDeclaredNamespaceModuleAndMeetDeclaredRefusals
  | PopulationParseGuaranteeUnspecified

data source_layout_check_guarantee: SourceLayoutCheckGuarantee = PhysicalWalkOfBoundTreesAgainstRepositoryStorageLayout

data population_parse_guarantee: PopulationParseGuarantee = ParseEveryDeclaredNamespaceModuleAndMeetDeclaredRefusals

fn source_layout_check_guarantee_digest(guarantee: SourceLayoutCheckGuarantee) -> String {
  match guarantee {
    PhysicalWalkOfBoundTreesAgainstRepositoryStorageLayout => "physical_walk_of_bound_trees_against_repository_storage_layout"
    LayoutGuaranteeUnspecified => "layout_guarantee_unspecified"
  }
}

fn population_parse_guarantee_digest(guarantee: PopulationParseGuarantee) -> String {
  match guarantee {
    ParseEveryDeclaredNamespaceModuleAndMeetDeclaredRefusals => "parse_every_declared_namespace_module_and_meet_declared_refusals"
    PopulationParseGuaranteeUnspecified => "population_parse_guarantee_unspecified"
  }
}
