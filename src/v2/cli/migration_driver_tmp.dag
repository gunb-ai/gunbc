module v2.cli.migration_driver_tmp

// TEMPORARY local driver (untracked, never committed): chunked plan/apply for the PR 3
// corpus run, for a session whose door binary cannot be built. It drives the SAME
// bound entry points the plan/apply verbs use, with the population supplied per chunk.

import v2.cli.reference_migration_verbs { reference_migration_env, reference_migration_join, reference_migration_bound_paths, MigrationBoundPathsListed, MigrationBoundPathsRefused }
import v2.cli.population_verbs { PopulationReport }
import v2.compiler.module_acquisition { SourceRootBinding }
import v2.workflow.reference_migration {
  migration_context_policy_design,
  migration_file,
  migration_ownership_from_registry,
  migration_plan_complete,
  migration_plan_edits,
  migration_plan_render,
  migration_plan_resolution_defects,
  migration_plan_run_holds,
  MigrationFile,
  MigrationFinding,
  MigrationPlan,
  MigrationApplyOutcome,
  Applied,
  Refused,
  reference_migration_apply_bound,
  reference_migration_plan_bound,
  reference_migration_plan_with_ownership,
  reference_migration_plan_resolved,
  reference_migration_rules_parse,
  migration_read_population,
  migration_read_citations,
}
import std.algebra { Cons, Empty, fold_list, is_empty, length, list_map }
import std.optional { Absent, Present }
import extdeps.filesystem.filesystem_io { Filesystem }
import v2.std.text { string_split }
import std.integer { int_to_decimal_string }
import std.algebra { FreeSemigroup }
import std.types { Char }
import std.types { Bool, String, Char }
import std.coercion { unicode_scalar_unfold }
import v2.compiler.tokenize { tokenize_artifact_prepared }
import v2.std.compilers.lexing { LexArtifact, lex_artifact_semantic_tokens }
import v2.std.node { symbol_intern_lexeme }
import std.process { ExitSuccess, ExitFailure, ProcessExit }

fn corpus_bindings() -> List<SourceRootBinding> {
  Cons {
    head: SourceRootBinding { tree: DagTree, host_directory: "dag" },
    tail: Cons {
      head: SourceRootBinding { tree: V2Tree, host_directory: "src/v2" },
      tail: Empty,
    },
  }
}

data manifest_line_delimiter: Char = 10

fn manifest_lines(content: String) -> List<String> {
  string_split(
    source: unicode_scalar_unfold(s: content),
    delimiter: FreeSemigroup { head: manifest_line_delimiter, tail: Empty },
  )
}

fn manifest_paths(manifest_path: String) -> List<String> {
  let r = Filesystem.Read(path: manifest_path)
  if !r.success {
    fold_list(xs: Empty, empty: Empty, cons: fn(acc, x) { Cons { head: x, tail: acc } })
  } else {
    fold_list(xs: manifest_lines(content: r.content), empty: Empty, cons: fn(acc, line) { if is_empty(xs: line) { acc } else { Cons { head: line, tail: acc } } })
  }
}

fn report_lines(plan: MigrationPlan, defects: List<String>) -> String {
  reference_migration_join(
    lines: migration_plan_render(plan: plan)
      + list_map(xs: defects, f: fn(defect) { "RESOLUTION DEFECT: " + defect }),
  )
}

fn plan_chunk(manifest_path: String, rules_path: String, out_path: String) -> Bool {
  let rr = Filesystem.Read(path: rules_path)
  let input = reference_migration_rules_parse(content: rr.content)
  let paths = manifest_paths(manifest_path: manifest_path)
  match reference_migration_env(bindings: corpus_bindings()) {
    Absent => false
    Present { value: env } =>
      let policy = migration_context_policy_design()
      let plan = reference_migration_plan_bound(
        env: env,
        paths: paths,
        rules: input.rules,
        policy: policy,
        resolutions: input.resolutions,
      )
      let defects = migration_plan_resolution_defects(plan: plan, resolutions: input.resolutions)
      let body = report_lines(plan: plan, defects: defects)
      let verdict = "\nRUN_HOLDS="
        + (if migration_plan_run_holds(plan: plan) && is_empty(xs: defects) { "yes" } else { "no" })
        + "\nCOMPLETE=" + (if migration_plan_complete(plan: plan) { "yes" } else { "no" }) + "\n"
      let w = Filesystem.Write(path: out_path, content: body + verdict)
      w.success
  }
}

fn apply_chunk(manifest_path: String, rules_path: String, out_path: String) -> Bool {
  let rr = Filesystem.Read(path: rules_path)
  let input = reference_migration_rules_parse(content: rr.content)
  let paths = manifest_paths(manifest_path: manifest_path)
  match reference_migration_env(bindings: corpus_bindings()) {
    Absent => false
    Present { value: env } =>
      let policy = migration_context_policy_design()
      let plan = reference_migration_plan_bound(
        env: env,
        paths: paths,
        rules: input.rules,
        policy: policy,
        resolutions: input.resolutions,
      )
      let defects = migration_plan_resolution_defects(plan: plan, resolutions: input.resolutions)
      if !(migration_plan_run_holds(plan: plan) && is_empty(xs: defects)) {
        let w = Filesystem.Write(
          path: out_path,
          content: "APPLY REFUSED: run does not hold\n" + report_lines(plan: plan, defects: defects),
        )
        w.success
      } else {
        let selected = list_map(xs: migration_plan_edits(plan: plan), f: fn(edit) { edit.id })
        match reference_migration_apply_bound(
          env: env,
          paths: paths,
          rules: input.rules,
          policy: policy,
          resolutions: input.resolutions,
          plan: plan,
          selected: selected,
        ) {
          Applied { written: written, contents: _ } =>
            let w = Filesystem.Write(
              path: out_path,
              content: "APPLIED " + int_to_decimal_string(value: length(xs: written)) + " file(s)\n"
                + reference_migration_join(lines: written),
            )
            w.success
          Refused { refusals: refusals } =>
            let w = Filesystem.Write(
              path: out_path,
              content: "APPLY REFUSED\n"
                + reference_migration_join(
                  lines: list_map(xs: refusals, f: fn(refusal) { refusal.id + ": " + refusal.reason }),
                ),
            )
            w.success
        }
      }
  }
}

fn write_manifest(out_path: String) -> Bool {
  match reference_migration_env(bindings: corpus_bindings()) {
    Absent => false
    Present { value: env } =>
      match reference_migration_bound_paths(env: env) {
        MigrationBoundPathsRefused { subject: _, cause: _ } => false
        MigrationBoundPathsListed { paths: paths } =>
          let w = Filesystem.Write(path: out_path, content: reference_migration_join(lines: paths))
          w.success
      }
  }
}

type ChunkState {
  current: List<String>
  done: List<List<String>>
}

fn chunk_step(state: ChunkState, item: String) -> ChunkState {
  if length(xs: state.current) + 1 >= 400 {
    ChunkState { current: Cons { head: item, tail: Empty }, done: Cons { head: state.current, tail: state.done } }
  } else {
    ChunkState { current: Cons { head: item, tail: state.current }, done: state.done }
  }
}

type RunState {
  ok: Bool
  i: Int
}

fn run_chunk_step(state: RunState, chunk: List<String>) -> RunState {
  RunState {
    ok: state.ok && plan_chunk_paths(paths: chunk, rules_path: "/tmp/bst227-pr3/rules-current.txt", out_path: "/tmp/bst227-pr3/plan-c" + int_to_decimal_string(value: state.i) + ".txt"),
    i: state.i + 1,
  }
}

fn plan_all(manifest_path: String) -> ProcessExit {
  let paths = manifest_paths(manifest_path: manifest_path)
  let st = fold_list(xs: paths, empty: ChunkState { current: Empty, done: Empty }, cons: chunk_step)
  let chunks = Cons { head: st.current, tail: st.done }
  let ran = fold_list(xs: chunks, empty: RunState { ok: true, i: 0 }, cons: run_chunk_step)
  if ran.ok { ExitSuccess } else { ExitFailure { code: 1, reason: "migration driver chunk failed" } }
}

fn plan_chunk_paths(paths: List<String>, rules_path: String, out_path: String) -> Bool {
  let rr = Filesystem.Read(path: rules_path)
  let input = reference_migration_rules_parse(content: rr.content)
  match reference_migration_env(bindings: corpus_bindings()) {
    Absent => false
    Present { value: env } =>
      let policy = migration_context_policy_design()
      let plan = reference_migration_plan_bound(
        env: env,
        paths: paths,
        rules: input.rules,
        policy: policy,
        resolutions: input.resolutions,
      )
      let defects = migration_plan_resolution_defects(plan: plan, resolutions: input.resolutions)
      let body = report_lines(plan: plan, defects: defects)
      let verdict = "\nRUN_HOLDS="
        + (if migration_plan_run_holds(plan: plan) && is_empty(xs: defects) { "yes" } else { "no" })
        + "\nCOMPLETE=" + (if migration_plan_complete(plan: plan) { "yes" } else { "no" }) + "\n"
      let w = Filesystem.Write(path: out_path, content: body + verdict)
      w.success
  }
}

// TEMP probe: round-trip one file to locate the host-call probe limit.
fn probe_roundtrip(path: String, out_path: String) -> Bool {
  let r = Filesystem.Read(path: path)
  if !r.success {
    false
  } else {
    let w = Filesystem.Write(path: out_path, content: r.content)
    w.success
  }
}

// TEMP probe: pure plan on one file, report only the finding count.
fn probe_plan1(path: String, out_path: String) -> Bool {
  let r = Filesystem.Read(path: path)
  match reference_migration_env(bindings: corpus_bindings()) {
    Absent => false
    Present { value: env } =>
      let file = migration_file(path: path, content: r.content)
      let plan = reference_migration_plan_with_ownership(
        env: env,
        population: Cons { head: file, tail: Empty },
        rules: Empty,
        policy: migration_context_policy_design(),
        ownership: migration_ownership_from_registry(),
      )
      let w = Filesystem.Write(path: out_path, content: "findings=" + int_to_decimal_string(value: count_items(xs: plan.findings)))
      w.success
  }
}

fn count_items(xs: List<MigrationFinding>) -> Int {
  fold_list(xs: xs, empty: 0, cons: fn(acc, _) { acc + 1 })
}

// TEMP probe: step-by-step isolation of the JSON-128 refusal.
fn probe_steps(path: String, trace_path: String, out_path: String) -> Bool {
  let w1 = Filesystem.Write(path: trace_path, content: "step=manifest_ok\n")
  let eopt = reference_migration_env(bindings: corpus_bindings())
  match eopt {
    Absent => false
    Present { value: env } => {
      let w2 = Filesystem.Write(path: trace_path, content: "step=env_ok\n")
      let bp = reference_migration_bound_paths(env: env)
      let w3 = Filesystem.Write(path: trace_path, content: "step=bound_ok\n")
      let own = migration_ownership_from_registry()
      let w4 = Filesystem.Write(path: trace_path, content: "step=own_ok\n")
      let r = Filesystem.Read(path: path)
      let w5 = Filesystem.Write(path: trace_path, content: "step=read_ok success=" + (if r.success { "yes" } else { "no" }) + "\n")
      let file = migration_file(path: path, content: r.content)
      let w6 = Filesystem.Write(path: trace_path, content: "step=digest_ok\n")
      let w7 = Filesystem.Write(path: out_path, content: "digest=" + file.digest)
      w7.success
    }
  }
}

// TEMP probe: full plan_chunk with inter-phase trace writes.
fn plan_chunk_traced(manifest_path: String, rules_path: String, out_path: String, trace_path: String) -> Bool {
  let rr = Filesystem.Read(path: rules_path)
  let input = reference_migration_rules_parse(content: rr.content)
  let t0 = Filesystem.Write(path: trace_path, content: "phase=rules\n")
  let paths = manifest_paths(manifest_path: manifest_path)
  let t1 = Filesystem.Write(path: trace_path, content: "phase=manifest\n")
  match reference_migration_env(bindings: corpus_bindings()) {
    Absent => false
    Present { value: env } => {
      let t2 = Filesystem.Write(path: trace_path, content: "phase=env\n")
      let read = migration_read_population(paths: paths)
      let t3 = Filesystem.Write(path: trace_path, content: "phase=population\n")
      let own = migration_ownership_from_registry()
      let t4 = Filesystem.Write(path: trace_path, content: "phase=own\n")
      let plan = reference_migration_plan_resolved(env: env, population: read.files, rules: input.rules, policy: migration_context_policy_design(), ownership: own, resolutions: input.resolutions)
      let t5 = Filesystem.Write(path: trace_path, content: "phase=plan\n")
      let defects = migration_plan_resolution_defects(plan: plan, resolutions: input.resolutions)
      let body = report_lines(plan: plan, defects: defects)
      let t6 = Filesystem.Write(path: trace_path, content: "phase=render\n")
      let verdict = "\nRUN_HOLDS=yes\nCOMPLETE=no\n"
      let w = Filesystem.Write(path: out_path, content: body + verdict)
      let t7 = Filesystem.Write(path: trace_path, content: "phase=write\n")
      w.success
    }
  }
}

// TEMP probe: Read inside a host fold.
fn probe_findings(out_path: String, file: String) -> Bool {
  let pop = migration_read_population(paths: [file])
  let policy = migration_context_policy_design()
  let body = fold_list(xs: pop.files, empty: [], cons: fn(acc, f) {
    let cites = migration_read_citations(text: f.content, base: 0, policy: policy, documents: policy.documents)
    fold_list(xs: cites, empty: acc, cons: fn(a2, c) {
      cons(
        int_to_decimal_string(n: c.start) + "-" + int_to_decimal_string(n: c.end)
          + " doc=" + c.document + " label=" + c.label
          + " ext=" + (if c.external { "y" } else { "n" })
          + " bt=" + (if c.backtick_open { "y" } else { "n" }),
        a2,
      )
    })
  })
  let text = fold_list(xs: body, empty: "", cons: fn(a, l) { a + l + "\n" })
    + "TOTAL=" + int_to_decimal_string(n: length(xs: body)) + "\n"
  let w = Filesystem.Write(path: out_path, content: text)
  w.success
}

fn probe_nested_read(path: String, out_path: String) -> Bool {
  let scan = fold_list(xs: Cons { head: path, tail: Empty }, empty: 0, cons: fn(acc, p) {
    let r = Filesystem.Read(path: p)
    if r.success { acc + 1 } else { acc }
  })
  let w = Filesystem.Write(path: out_path, content: "reads=" + int_to_decimal_string(value: scan))
  w.success
}

// TEMP probe: lex alone, report token count.
fn probe_lex(path: String, out_path: String) -> Bool {
  let r = Filesystem.Read(path: path)
  match reference_migration_env(bindings: corpus_bindings()) {
    Absent => false
    Present { value: env } =>
      match tokenize_artifact_prepared(text: r.content, file: symbol_intern_lexeme(lexeme: path), prepared: env.lex) {
        Accepted { value: artifact, diagnostics: _ } =>
          let toks = lex_artifact_semantic_tokens(artifact: artifact)
          let w = Filesystem.Write(path: out_path, content: "tokens=" + int_to_decimal_string(value: length(xs: toks.all)))
          w.success
        Rejected { diagnostics: _ } =>
          let w = Filesystem.Write(path: out_path, content: "rejected")
          w.success
      }
  }
}
