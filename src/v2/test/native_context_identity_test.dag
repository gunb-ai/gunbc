module v2.test.native_context_identity

import v2.compiler.compile { native_lane_ingest_receipt, native_lane_source_facts }
import v2.compiler.source_authority {
  DagSourceReadWitness, source_ref_for_storage_path,
  discovered_source_refs_digest_for_refs, discovered_source_refs_digest_eq
}
import v2.std.artifact { Artifact, SourceFile }
import v2.std.compilers.lexing { symbol_intern_lexeme }
import v2.std.cross_tree.import_model { DagTree }
import extdeps.communication.medium { Medium, Lossless }
import v2.std.logic { Bool }
import v2.std.text { String }

fn identity_read(text: String) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: text, fidelity: Lossless },
    artifact: Artifact {
      kind: SourceFile,
      id: symbol_intern_lexeme(lexeme: "dag/fixture/context_identity.dag"),
      file_path: "dag/fixture/context_identity.dag"
    },
    compilation_unit: symbol_intern_lexeme(lexeme: "dag/fixture/context_identity.dag"),
    source_root: DagTree
  }
}

// The route's receipt producer observes the same path with one changed byte. A substituted
// path-only digest makes this witness return false rather than accepting a false context join.
test fn native_context_identity_changes_with_one_byte_at_same_path() -> Bool {
  let before = [identity_read(text: "module fixture.context_identity\ndata value: Int = 1\n")]
  let after = [identity_read(text: "module fixture.context_identity\ndata value: Int = 2\n")]
  let a = native_lane_ingest_receipt(facts: native_lane_source_facts(ingest: before), closure: ["fixture.context_identity"], ingest: before)
  let b = native_lane_ingest_receipt(facts: native_lane_source_facts(ingest: after), closure: ["fixture.context_identity"], ingest: after)
  !discovered_source_refs_digest_eq(left: a.context_identity, right: b.context_identity)
}

// A fixture may author the excluded producer. Its digest must not join the actual read-witness
// population even though both receipts name exactly the same path and root.
test fn native_context_identity_rejects_substituted_placeholder_producer() -> Bool {
  let ingest = [identity_read(text: "module fixture.context_identity\ndata value: Int = 1\n")]
  let actual = native_lane_ingest_receipt(facts: native_lane_source_facts(ingest: ingest), closure: ["fixture.context_identity"], ingest: ingest)
  let substituted = discovered_source_refs_digest_for_refs(refs: [source_ref_for_storage_path(path: "dag/fixture/context_identity.dag")])
  !discovered_source_refs_digest_eq(left: actual.context_identity, right: substituted)
}

test fn native_context_identity_repeats_for_same_read_population() -> Bool {
  let ingest = [identity_read(text: "module fixture.context_identity\ndata value: Int = 1\n")]
  let facts = native_lane_source_facts(ingest: ingest)
  let a = native_lane_ingest_receipt(facts: facts, closure: ["fixture.context_identity"], ingest: ingest)
  let b = native_lane_ingest_receipt(facts: facts, closure: ["fixture.context_identity"], ingest: ingest)
  discovered_source_refs_digest_eq(left: a.context_identity, right: b.context_identity)
}
