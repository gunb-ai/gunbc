module v2.test.lens_unit_modeling.flat_scalar_unit_leaf_flagged

import std.occurrence_identity { OccurrenceSynthetic }
import v2.lens.unit_modeling { unit_modeling_gate }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Authored,
  Node,
  Symbol,
  TypeNode,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node_query { binder_edge }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data int_leaf_target: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^dag_binding_type_int } },
  children: [],
  occurrence_id: OccurrenceSynthetic
}

data flat_scalar_unit_leaf_input: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    binder_edge(
      name: ^ram_bytes,
      type_node: int_leaf_target
    )
  ],
  occurrence_id: OccurrenceSynthetic
}

test fn flat_scalar_unit_leaf_flagged_holds() -> Bool {
  match unit_modeling_gate(node: flat_scalar_unit_leaf_input) {
    Rejected { diagnostics: r } => r.head.reason == ^unit_modeling_flat_scalar_unit_leaf_fixable
    Accepted { value: _, diagnostics: _ } => false
  }
}


