module v2.test.lens_unit_modeling.module_container_not_judged_as_record_carrier

import std.occurrence_identity { OccurrenceSynthetic }
import v2.compiler.compile {
  CompileLensSubtree,
  required_lenses_at_grain,
  run_required_lens_gates_on_subtree
}
import v2.compiler.infer { InferredTree }
import v2.lens.lifecycle_carrier { lifecycle_carrier_gate }
import v2.lens.unit_modeling { unit_modeling_gate }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.node {
  Atom,
  Arrow,
  ComputationNode,
  Conj,
  Edge,
  Authored,
  Node,
  TypeNode,
  Value,
}
import v2.test.lens_common.infer_fixture {
  claim_inferred_facts,
  claim_inferred_tree
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node_query { binder_edge }
import v2.extdeps.languages.dag { dag_node_is_record_field_carrier }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// GREEN: a Conj whose Authored member is a synthetic dag_surface_module Atom. The PARENT
// remains a record-field carrier (a module-surface child does not opt the whole Conj out).
// The member is skipped because its TARGET is a module surface, per-edge.
data module_surface_atom: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^dag_surface_module } },
  children: [],
  occurrence_id: OccurrenceSynthetic
}

data module_container_root: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge { label: Authored { name: ^child_mod }, target: module_surface_atom }
  ],
  occurrence_id: OccurrenceSynthetic
}

fn module_container_tree() -> InferredTree {
  claim_inferred_tree(
    root: module_container_root,
    facts: claim_inferred_facts(
      type_symbol: ^mod_container_type_sym,
      algebra_symbol: ^mod_container_algebra_sym,
      descent_symbol: ^mod_container_descent_sym
    )
  )
}

test fn module_container_with_a_module_surface_child_is_still_a_record_field_carrier() -> Bool {
  dag_node_is_record_field_carrier(node: module_container_root)
}

test fn unit_modeling_accepts_a_module_container() -> Bool {
  match unit_modeling_gate(node: module_container_root) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn lifecycle_carrier_accepts_a_module_container() -> Bool {
  match lifecycle_carrier_gate(node: module_container_root) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

// The door used to refuse this shape with member_not_a_binder at the module-surface child
// before later lenses (mandatory_tag at root grain among them) ran. After the carrier
// narrowing, that cause is gone. A later subtree lens may still refuse a different class
// (fact_density on a bare identity Atom is a separate subject).
test fn subtree_required_lenses_do_not_refuse_member_not_a_binder_on_a_module_container() -> Bool {
  match run_required_lens_gates_on_subtree(
    inferred: module_container_tree(),
    lenses: required_lenses_at_grain(grain: CompileLensSubtree)
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: r } => r.head.reason != ^member_not_a_binder
  }
}

data malformed_record_root: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Authored { name: ^x },
      target: Node {
        kind: TypeNode { connective: Atom { identity: ^Text } },
        children: [],
        occurrence_id: OccurrenceSynthetic
      }
    }
  ],
  occurrence_id: OccurrenceSynthetic
}

// RED: a payload Conj whose Authored member is not a binder is still refused. The carrier
// narrowing must not swallow this wall.
test fn a_hand_built_record_field_is_still_member_not_a_binder() -> Bool {
  match unit_modeling_gate(node: malformed_record_root) {
    Rejected { diagnostics: r } => r.head.reason == ^member_not_a_binder
    Accepted { value: _, diagnostics: _ } => false
  }
}

data record_with_binder: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    binder_edge(
      name: ^note,
      type_node: Node {
        kind: TypeNode { connective: Atom { identity: ^Text } },
        children: [],
        occurrence_id: OccurrenceSynthetic
      }
    )
  ],
  occurrence_id: OccurrenceSynthetic
}

test fn a_binder_payload_is_still_a_record_field_carrier() -> Bool {
  dag_node_is_record_field_carrier(node: record_with_binder)
}

data mixed_int_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^dag_binding_type_int } },
  children: [],
  occurrence_id: OccurrenceSynthetic
}

// RED (review 38602): a Conj that CONTAINS a module-surface member must still judge its
// other members. A clock_hz binder typed as bare Int was refused before the container-wide
// skip and must stay refused.
data mixed_module_and_unit_field_root: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge { label: Authored { name: ^child_mod }, target: module_surface_atom },
    binder_edge(name: ^clock_hz, type_node: mixed_int_leaf)
  ],
  occurrence_id: OccurrenceSynthetic
}

test fn a_mixed_conj_still_refuses_a_bare_int_unit_field() -> Bool {
  match unit_modeling_gate(node: mixed_module_and_unit_field_root) {
    Rejected { diagnostics: r } => r.head.reason == ^unit_modeling_flat_scalar_unit_leaf_fixable
    Accepted { value: _, diagnostics: _ } => false
  }
}

// RED (review 77837): skipping every Conj/Arrow/ComputationNode member would swallow a
// real record field. Only module-surface and fn-decl identities skip.
data conj_shaped_member_root: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Authored { name: ^payload },
      target: Node {
        kind: TypeNode { connective: Conj },
        children: [],
        occurrence_id: OccurrenceSynthetic
      }
    }
  ],
  occurrence_id: OccurrenceSynthetic
}

test fn a_conj_shaped_record_field_is_still_member_not_a_binder() -> Bool {
  match unit_modeling_gate(node: conj_shaped_member_root) {
    Rejected { diagnostics: r } => r.head.reason == ^member_not_a_binder
    Accepted { value: _, diagnostics: _ } => false
  }
}

data arrow_shaped_member_root: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Authored { name: ^payload },
      target: Node {
        kind: TypeNode { connective: Arrow },
        children: [],
        occurrence_id: OccurrenceSynthetic
      }
    }
  ],
  occurrence_id: OccurrenceSynthetic
}

test fn an_arrow_shaped_record_field_is_still_member_not_a_binder() -> Bool {
  match unit_modeling_gate(node: arrow_shaped_member_root) {
    Rejected { diagnostics: r } => r.head.reason == ^member_not_a_binder
    Accepted { value: _, diagnostics: _ } => false
  }
}

data computation_shaped_member_root: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Authored { name: ^payload },
      target: Node {
        kind: ComputationNode { behavior: Value },
        children: [],
        occurrence_id: OccurrenceSynthetic
      }
    }
  ],
  occurrence_id: OccurrenceSynthetic
}

test fn a_computation_shaped_record_field_is_still_member_not_a_binder() -> Bool {
  match unit_modeling_gate(node: computation_shaped_member_root) {
    Rejected { diagnostics: r } => r.head.reason == ^member_not_a_binder
    Accepted { value: _, diagnostics: _ } => false
  }
}
