module v2.test.lens_unit_modeling.bitwidth_flat_scalar_flagged

import std.occurrence_identity { OccurrenceSynthetic }
import v2.lens.unit_modeling { unit_modeling_gate }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Symbol,
  TypeNode,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data int_leaf_target_bitwidth: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^dag_binding_type_int } },
  children: [],
  occurrence_id: OccurrenceSynthetic
}

data bitwidth_flat_scalar_input: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^pointer_width },
      target: int_leaf_target_bitwidth
    }
  ],
  occurrence_id: OccurrenceSynthetic
}

test fn bitwidth_flat_scalar_flagged_holds() -> Bool {
  match unit_modeling_gate(node: bitwidth_flat_scalar_input) {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}


