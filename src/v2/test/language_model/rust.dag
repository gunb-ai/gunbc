  model: rust_fn_add_language_model(),
  fact_id: rust_leaf_model_fact_id_node_algebra_inhabitance_rust_facts_i32(),
  subject: rust_leaf_algebra_inhabitance_i32_subject(),
  expectation: RustRuntimeBehaviorExpectation {
    invocation_form: rust_leaf_r2b_invocation(
      build_profile: ^rust_leaf_rustc_build_release,
      overflow_disposition_field: ^rust_overflow_field_checked_arithmetic_release_default
    ),
    expected_outcome: Wrap
  },
  falsification_case: FalsificationCase {
    subject_variant: rust_leaf_algebra_inhabitance_i32_subject(),
    expected_failure_mode: RustRuntimeBehaviorExpectation {
      invocation_form: rust_leaf_r2b_invocation(
      build_profile: ^rust_leaf_rustc_build_release,
      overflow_disposition_field: ^rust_overflow_field_checked_arithmetic_release_default
    ),
      expected_outcome: Panic { panic_classification: ^rust_leaf_arithmetic_overflow_panic }
    }
  }
}

