data claim_rust_leaf_r2b_overflow_checks_disabled_overflow: RustLeafModelClaim = LeafModelClaim {
  model: rust_fn_add_language_model(),
  fact_id: rust_leaf_model_fact_id_node_algebra_inhabitance_rust_facts_i32(),
