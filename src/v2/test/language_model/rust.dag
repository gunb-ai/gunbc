module v2.test.language_model.rust
import v2.std.language_model { LanguageModel }

import v2.extdeps.languages.rust {
  rust_integer_algebra_inhabitance_rust_facts_i32,
  rust_fn_add_language_model,
  rust_leaf_model_fact_id_node_algebra_inhabitance_rust_facts_i32,
  rust_atom_realization_symbol_node,
  rust_leaf_model_fact_id_node_atom_realization_symbol,
  rust_leaf_model_fact_id_node_rust_facts_i32
}
import v2.std.collection { List }
import v2.std.diagnostic { Outcome }
import v2.std.leaf_model_verification {
  FalsificationCase,
  LeafModelClaim,
  TargetInvocation
}
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.runtime { Panic, RuntimeOutcome, Wrap }
import v2.std.rust_leaf_model_claim {
  Rustc_ErrorCode_Phase1,
  RustAlgebraInhabitanceSubject,
  RustAtomRealizationProjectionMismatchSubject,
  RustAtomRealizationSubject,
  RustClaimExpectation,
  RustClaimSubject,
  RustEmitProjectionEqualityExpectation,
  rust_leaf_phase1_algebra_carrier_ordered_ring,
  rust_leaf_phase1_primitive_i32,
  rust_leaf_phase1_err_e0308,
  rust_leaf_phase1_err_e0423,
  rust_leaf_phase1_err_e0599,
  RustPrimitiveTypeSubject,
  RustRuntimeBehaviorExpectation,
  RustcAcceptsExpectation,
  RustcRejectsExpectation
}

type RustLeafModelClaim = LeafModelClaim<Outcome<LanguageModel>, RustClaimSubject, RustClaimExpectation>

fn rust_leaf_rustc_invocation() -> TargetInvocation {
  TargetInvocation {
    toolchain: ^rust_leaf_rustc_toolchain,
    edition: ^rust_leaf_rustc_edition_2024,
    build_profile: ^rust_leaf_rustc_build_profile_compile,
    overflow_disposition_field: ^rust_leaf_overflow_disposition_field_not_applicable
  }
}

fn rust_leaf_r2b_invocation(build_profile: Symbol, overflow_disposition_field: Symbol) -> TargetInvocation {
  TargetInvocation {
    toolchain: ^rust_leaf_rustc_toolchain,
    edition: ^rust_leaf_rustc_edition_2024,
    build_profile: build_profile,
    overflow_disposition_field: overflow_disposition_field
  }
}

fn rust_leaf_rustc_accepts() -> RustClaimExpectation {
  RustcAcceptsExpectation { invocation_form: rust_leaf_rustc_invocation() }
}

fn rust_leaf_rustc_rejects(code: Rustc_ErrorCode_Phase1) -> RustClaimExpectation {
  RustcRejectsExpectation {
    invocation_form: rust_leaf_rustc_invocation(),
    expected_error_code: code
  }
}

fn rust_leaf_algebra_inhabitance_i32_subject() -> RustClaimSubject {
  RustAlgebraInhabitanceSubject {
    inhabitance_decl: rust_integer_algebra_inhabitance_rust_facts_i32
  }
}

data claim_rust_leaf_r1_i32_type: RustLeafModelClaim = LeafModelClaim {
  model: rust_fn_add_language_model(),
  fact_id: rust_leaf_model_fact_id_node_rust_facts_i32(),
  subject: RustPrimitiveTypeSubject { primitive: rust_leaf_phase1_primitive_i32 },
  expectation: rust_leaf_rustc_accepts(),
  falsification_case: FalsificationCase {
    subject_variant: RustPrimitiveTypeSubject { primitive: rust_leaf_phase1_primitive_i32 },
    expected_failure_mode: rust_leaf_rustc_rejects(code: rust_leaf_phase1_err_e0308)
  }
}

data claim_rust_leaf_r2a_i32_algebra_operations: RustLeafModelClaim = LeafModelClaim {
  model: rust_fn_add_language_model(),
  fact_id: rust_leaf_model_fact_id_node_algebra_inhabitance_rust_facts_i32(),
  subject: rust_leaf_algebra_inhabitance_i32_subject(),
  expectation: rust_leaf_rustc_accepts(),
  falsification_case: FalsificationCase {
    subject_variant: rust_leaf_algebra_inhabitance_i32_subject(),
    expected_failure_mode: rust_leaf_rustc_rejects(code: rust_leaf_phase1_err_e0599)
  }
}

data claim_rust_leaf_r2b_debug_default_overflow: RustLeafModelClaim = LeafModelClaim {
  model: rust_fn_add_language_model(),
  fact_id: rust_leaf_model_fact_id_node_algebra_inhabitance_rust_facts_i32(),
  subject: rust_leaf_algebra_inhabitance_i32_subject(),
  expectation: RustRuntimeBehaviorExpectation {
    invocation_form: rust_leaf_r2b_invocation(
      build_profile: ^rust_leaf_rustc_build_debug,
      overflow_disposition_field: ^rust_overflow_field_checked_arithmetic_debug_default
    ),
    expected_outcome: Panic { panic_classification: ^rust_leaf_arithmetic_overflow_panic }
  },
  falsification_case: FalsificationCase {
    subject_variant: rust_leaf_algebra_inhabitance_i32_subject(),
    expected_failure_mode: RustRuntimeBehaviorExpectation {
      invocation_form: rust_leaf_r2b_invocation(
      build_profile: ^rust_leaf_rustc_build_debug,
      overflow_disposition_field: ^rust_overflow_field_checked_arithmetic_debug_default
    ),
      expected_outcome: Wrap
    }
  }
}

