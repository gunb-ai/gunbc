module v2.test.wet_evidence

import v2.workflow.wet_evidence {
  WetRoute, LocalRepoCoResidentRoute, SelfHostTransportedRoute,
  WetDrySource, HermeticRouteGapObserved, DirectWetRouteDecline,
  WetEvidenceBinding, CoResidentPreparedSubject, TransportedReceiptSubject,
  WetScheduledClaim, WetTerminalRow,
  WetEvidenceRefusal,
  WetTerminalMissing, WetTerminalDuplicated, WetTerminalUnscheduled,
  WetTerminalForeignEntry, WetTerminalForeignFunction, WetTerminalVerdictNotExpected,
  WetTerminalForeignRoute,
  WetBindingPreparedSubjectDiffers, WetBindingSemanticSubjectDiffers,
  WetBindingExecutorContractDiffers, WetBindingRelationMismatch,
  WetCrossRouteIdentityOverlap,
  WetEvidenceValidation, WetEvidenceAdmitted, WetEvidenceRefused,
  wet_evidence_validate, wet_evidence_admits, wet_cross_route_overlap_causes
}
import v2.workflow.floor2_prepared_subject { WitnessIdentity }
import v2.workflow.floor_terminal_ledger {
  ClaimAttemptTerminal, Returned, RuntimeErrored, BudgetRefused,
  ClaimObservation, ObservedVerdict,
  ClaimExpectation, ExpectedToHold, ExpectedRed
}
import v2.workflow.required_floor {
  ClaimSafetyOutcome, CompletedPastSafetyLimit,
  ClaimPreemptionReachability, CooperativelyPollable
}
import v2.std.algebra { fold_list, length }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }

fn alpha_identity() -> WitnessIdentity {
  WitnessIdentity { module_path: "test.claim.fixture", function: "alpha_holds" }
}

fn passed() -> ClaimAttemptTerminal {
  Returned { observation: ObservedVerdict { holds: true } }
}

fn co_resident_binding(subject: String) -> WetEvidenceBinding {
  CoResidentPreparedSubject { prepared_subject: subject }
}

fn transported_binding(subject: String, executor: String) -> WetEvidenceBinding {
  TransportedReceiptSubject { semantic_subject: subject, executor_contract: executor }
}

fn scheduled_alpha(route: WetRoute, dry: WetDrySource, expectation: ClaimExpectation) -> WetScheduledClaim {
  WetScheduledClaim {
    route: route,
    identity: alpha_identity(),
    entry: "dag/test/claim/fixture_test.dag",
    function: "alpha_holds",
    expectation: expectation,
    dry_source: dry
  }
}

fn terminal_alpha(route: WetRoute, binding: WetEvidenceBinding, terminal: ClaimAttemptTerminal) -> WetTerminalRow {
  WetTerminalRow {
    route: route,
    identity: alpha_identity(),
    observed_entry: "dag/test/claim/fixture_test.dag",
    observed_function: "alpha_holds",
    terminal: terminal,
    binding: binding
  }
}

fn causes_of(v: WetEvidenceValidation) -> List<WetEvidenceRefusal> {
  match v {
    WetEvidenceAdmitted { binding: _, terminals: _ } => []
    WetEvidenceRefused { causes: c } => c
  }
}

fn is_prepared_subject_differs(c: WetEvidenceRefusal) -> Bool {
  match c {
    WetBindingPreparedSubjectDiffers { identity: _, observed: _, required: _ } => true
    WetTerminalMissing { identity: _ } => false
    WetTerminalDuplicated { identity: _, occurrences: _ } => false
    WetTerminalUnscheduled { identity: _ } => false
    WetTerminalForeignEntry { identity: _, observed: _, required: _ } => false
    WetTerminalForeignFunction { identity: _, observed: _, required: _ } => false
    WetTerminalVerdictNotExpected { identity: _, disposition: _ } => false
    WetTerminalForeignRoute { identity: _ } => false
    WetBindingSemanticSubjectDiffers { identity: _, observed: _, required: _ } => false
    WetBindingExecutorContractDiffers { identity: _, observed: _, required: _ } => false
    WetBindingRelationMismatch { identity: _ } => false
    WetCrossRouteIdentityOverlap { identity: _ } => false
  }
}

fn is_semantic_subject_differs(c: WetEvidenceRefusal) -> Bool {
  match c {
    WetBindingSemanticSubjectDiffers { identity: _, observed: _, required: _ } => true
    WetTerminalMissing { identity: _ } => false
    WetTerminalDuplicated { identity: _, occurrences: _ } => false
    WetTerminalUnscheduled { identity: _ } => false
    WetTerminalForeignEntry { identity: _, observed: _, required: _ } => false
    WetTerminalForeignFunction { identity: _, observed: _, required: _ } => false
    WetTerminalVerdictNotExpected { identity: _, disposition: _ } => false
    WetTerminalForeignRoute { identity: _ } => false
    WetBindingPreparedSubjectDiffers { identity: _, observed: _, required: _ } => false
    WetBindingExecutorContractDiffers { identity: _, observed: _, required: _ } => false
    WetBindingRelationMismatch { identity: _ } => false
    WetCrossRouteIdentityOverlap { identity: _ } => false
  }
}

fn is_executor_contract_differs(c: WetEvidenceRefusal) -> Bool {
  match c {
    WetBindingExecutorContractDiffers { identity: _, observed: _, required: _ } => true
    WetTerminalMissing { identity: _ } => false
    WetTerminalDuplicated { identity: _, occurrences: _ } => false
    WetTerminalUnscheduled { identity: _ } => false
    WetTerminalForeignEntry { identity: _, observed: _, required: _ } => false
    WetTerminalForeignFunction { identity: _, observed: _, required: _ } => false
    WetTerminalVerdictNotExpected { identity: _, disposition: _ } => false
    WetTerminalForeignRoute { identity: _ } => false
    WetBindingPreparedSubjectDiffers { identity: _, observed: _, required: _ } => false
    WetBindingSemanticSubjectDiffers { identity: _, observed: _, required: _ } => false
    WetBindingRelationMismatch { identity: _ } => false
    WetCrossRouteIdentityOverlap { identity: _ } => false
  }
}

fn is_relation_mismatch(c: WetEvidenceRefusal) -> Bool {
  match c {
    WetBindingRelationMismatch { identity: _ } => true
    WetTerminalMissing { identity: _ } => false
    WetTerminalDuplicated { identity: _, occurrences: _ } => false
    WetTerminalUnscheduled { identity: _ } => false
    WetTerminalForeignEntry { identity: _, observed: _, required: _ } => false
    WetTerminalForeignFunction { identity: _, observed: _, required: _ } => false
    WetTerminalVerdictNotExpected { identity: _, disposition: _ } => false
    WetTerminalForeignRoute { identity: _ } => false
    WetBindingPreparedSubjectDiffers { identity: _, observed: _, required: _ } => false
    WetBindingSemanticSubjectDiffers { identity: _, observed: _, required: _ } => false
    WetBindingExecutorContractDiffers { identity: _, observed: _, required: _ } => false
    WetCrossRouteIdentityOverlap { identity: _ } => false
  }
}

fn any_cause(causes: List<WetEvidenceRefusal>, p: fn(WetEvidenceRefusal) -> Bool) -> Bool {
  fold_list(xs: causes, empty: false, cons: fn(acc, c) { acc || p(c) })
}

// PROOF 10, ARM ONE — THE CO-RESIDENT WRONG-BINDING RED, and it is authorable, which is the
// question that had to be asked before the wall was written. A co-resident execution whose
// prepared subject is NOT the one the floor required refuses, and the refusal names the prepared
// subject axis specifically rather than reporting a generic invalidity.
//
// THE POSITIVE CONTROL IS THE SAME EVIDENCE WITH THE MATCHING SUBJECT. Without it this witness
// would pass over evidence that refuses for any reason at all, which is the vacuous-green shape:
// the two halves differ by exactly the fact under test.
test fn co_resident_wrong_prepared_subject_refuses_and_names_the_axis() -> Bool {
  let scheduled = [scheduled_alpha(route: LocalRepoCoResidentRoute {}, dry: HermeticRouteGapObserved {}, expectation: ExpectedToHold {})]
  let wrong = [terminal_alpha(route: LocalRepoCoResidentRoute {}, binding: co_resident_binding(subject: "subject-OTHER"), terminal: passed())]
  let right = [terminal_alpha(route: LocalRepoCoResidentRoute {}, binding: co_resident_binding(subject: "subject-THIS"), terminal: passed())]
  let required = co_resident_binding(subject: "subject-THIS")
  let refused = wet_evidence_validate(scheduled: scheduled, terminals: wrong, required: required)
  let admitted = wet_evidence_validate(scheduled: scheduled, terminals: right, required: required)
  !wet_evidence_admits(v: refused)
    && any_cause(causes: causes_of(v: refused), p: is_prepared_subject_differs)
    && wet_evidence_admits(v: admitted)
}

// PROOF 10, ARM TWO — THE TRANSPORTED WRONG-BINDING RED, and it is TWO reds because the transported
// binding carries two independent facts. A receipt whose SEMANTIC SUBJECT differs means the tree
// disagreed; a receipt whose EXECUTOR CONTRACT differs means the producer disagreed while the tree
// agreed. They are separate causes because they send a reader to separate places, and the second is
// the one a single-digest binding could never have expressed.
test fn transported_wrong_subject_and_wrong_executor_are_separate_reds() -> Bool {
  let scheduled = [scheduled_alpha(route: SelfHostTransportedRoute {}, dry: DirectWetRouteDecline {}, expectation: ExpectedToHold {})]
  let required = transported_binding(subject: "semantic-THIS", executor: "executor-THIS")
  let wrong_subject = [terminal_alpha(route: SelfHostTransportedRoute {}, binding: transported_binding(subject: "semantic-OTHER", executor: "executor-THIS"), terminal: passed())]
  let wrong_executor = [terminal_alpha(route: SelfHostTransportedRoute {}, binding: transported_binding(subject: "semantic-THIS", executor: "executor-OTHER"), terminal: passed())]
  let exact = [terminal_alpha(route: SelfHostTransportedRoute {}, binding: transported_binding(subject: "semantic-THIS", executor: "executor-THIS"), terminal: passed())]
  let subject_refused = wet_evidence_validate(scheduled: scheduled, terminals: wrong_subject, required: required)
  let executor_refused = wet_evidence_validate(scheduled: scheduled, terminals: wrong_executor, required: required)
  let admitted = wet_evidence_validate(scheduled: scheduled, terminals: exact, required: required)
  any_cause(causes: causes_of(v: subject_refused), p: is_semantic_subject_differs)
    && !any_cause(causes: causes_of(v: subject_refused), p: is_executor_contract_differs)
    && any_cause(causes: causes_of(v: executor_refused), p: is_executor_contract_differs)
    && !any_cause(causes: causes_of(v: executor_refused), p: is_semantic_subject_differs)
    && wet_evidence_admits(v: admitted)
}

// THE DEFECT THE BARE STRING COULD NOT SPELL. Evidence of the WRONG KIND — a transported receipt
// offered where a co-resident execution was required — is its own cause, not a digest that happens
// to differ. Under `candidate: String` this could only ever have reported "not equal", which sends
// the reader to compare two unrelated hashes. Both directions are asserted, because a wall that
// fires in only one is half a wall.
test fn evidence_of_the_wrong_kind_is_its_own_cause_in_both_directions() -> Bool {
  let local_scheduled = [scheduled_alpha(route: LocalRepoCoResidentRoute {}, dry: HermeticRouteGapObserved {}, expectation: ExpectedToHold {})]
  let transported_scheduled = [scheduled_alpha(route: SelfHostTransportedRoute {}, dry: DirectWetRouteDecline {}, expectation: ExpectedToHold {})]
  let transported_terminal = [terminal_alpha(route: LocalRepoCoResidentRoute {}, binding: transported_binding(subject: "s", executor: "x"), terminal: passed())]
  let local_terminal = [terminal_alpha(route: SelfHostTransportedRoute {}, binding: co_resident_binding(subject: "s"), terminal: passed())]
  let a = wet_evidence_validate(scheduled: local_scheduled, terminals: transported_terminal, required: co_resident_binding(subject: "s"))
  let b = wet_evidence_validate(scheduled: transported_scheduled, terminals: local_terminal, required: transported_binding(subject: "s", executor: "x"))
  any_cause(causes: causes_of(v: a), p: is_relation_mismatch)
    && any_cause(causes: causes_of(v: b), p: is_relation_mismatch)
    && !any_cause(causes: causes_of(v: a), p: is_prepared_subject_differs)
    && !any_cause(causes: causes_of(v: b), p: is_semantic_subject_differs)
}

// PROOF 7, DERIVED RATHER THAN RE-IMPLEMENTED. A claim that reached its verdict and then exceeded
// its line is NOT agreement — the ledger's own `claim_disposition` sends it to `PassedOverBudget`,
// and this join refuses it as a verdict-not-expected carrying that disposition. Nothing here
// re-derives the rule; the witness proves the join consumes the ledger's derivation.
//
// The control is the same terminal under ExpectedRed enrolment reaching KnownRedNowPassing, which
// is also refused: a cost debt must not retire an enrolled red.
test fn completed_over_budget_is_refused_and_carries_the_ledgers_disposition() -> Bool {
  let over = BudgetRefused {
    safety: CompletedPastSafetyLimit { observed_cpu: 505, observed_wall: 505, preemption: CooperativelyPollable {} }
  }
  let scheduled = [scheduled_alpha(route: SelfHostTransportedRoute {}, dry: DirectWetRouteDecline {}, expectation: ExpectedToHold {})]
  let terminals = [terminal_alpha(route: SelfHostTransportedRoute {}, binding: transported_binding(subject: "s", executor: "x"), terminal: over)]
  let v = wet_evidence_validate(scheduled: scheduled, terminals: terminals, required: transported_binding(subject: "s", executor: "x"))
  let clean = wet_evidence_validate(
    scheduled: scheduled,
    terminals: [terminal_alpha(route: SelfHostTransportedRoute {}, binding: transported_binding(subject: "s", executor: "x"), terminal: passed())],
    required: transported_binding(subject: "s", executor: "x")
  )
  !wet_evidence_admits(v: v) && wet_evidence_admits(v: clean)
}

// AN ENROLLED RED OBSERVED RED IS AGREEMENT, and this is what proves the shared expectation type
// did not narrow to the co-resident roster's single arm. The transported route derives ExpectedRed
// from canonical enrolment; the ledger maps ExpectedRed plus a false verdict to KnownRedHeld; this
// join admits it. A type that could not represent ExpectedRed would make this witness unwritable.
test fn an_enrolled_red_observed_red_is_agreement() -> Bool {
  let scheduled = [scheduled_alpha(route: SelfHostTransportedRoute {}, dry: DirectWetRouteDecline {}, expectation: ExpectedRed {})]
  let red = Returned { observation: ObservedVerdict { holds: false } }
  let terminals = [terminal_alpha(route: SelfHostTransportedRoute {}, binding: transported_binding(subject: "s", executor: "x"), terminal: red)]
  let v = wet_evidence_validate(scheduled: scheduled, terminals: terminals, required: transported_binding(subject: "s", executor: "x"))
  wet_evidence_admits(v: v)
}

// THE SET EQUALITY, BOTH DIRECTIONS, AND THE THREE CAUSES STAY THREE. A scheduled identity with no
// terminal, a terminal nobody scheduled, and two terminals for one identity are different defects
// with different remedies; a coverage count would report the first two as one number and miss the
// third entirely.
test fn missing_unscheduled_and_duplicated_stay_three_distinct_causes() -> Bool {
  let binding = transported_binding(subject: "s", executor: "x")
  let scheduled = [scheduled_alpha(route: SelfHostTransportedRoute {}, dry: DirectWetRouteDecline {}, expectation: ExpectedToHold {})]
  let none_run = wet_evidence_validate(scheduled: scheduled, terminals: [], required: binding)
  let twice_run = wet_evidence_validate(
    scheduled: scheduled,
    terminals: [
      terminal_alpha(route: SelfHostTransportedRoute {}, binding: binding, terminal: passed()),
      terminal_alpha(route: SelfHostTransportedRoute {}, binding: binding, terminal: passed())
    ],
    required: binding
  )
  let unscheduled = wet_evidence_validate(
    scheduled: [],
    terminals: [terminal_alpha(route: SelfHostTransportedRoute {}, binding: binding, terminal: passed())],
    required: binding
  )
  length(xs: causes_of(v: none_run)) == 1
    && length(xs: causes_of(v: twice_run)) == 1
    && length(xs: causes_of(v: unscheduled)) == 1
    && !wet_evidence_admits(v: none_run)
    && !wet_evidence_admits(v: twice_run)
    && !wet_evidence_admits(v: unscheduled)
}

// THE CROSS-ROUTE WALL. An identity evidenced by both routes refuses, and the union is derived from
// the two rosters rather than transcribed as a third. The negative control is two disjoint rosters,
// which must produce nothing — otherwise the wall would be firing on something other than overlap.
test fn an_identity_on_both_routes_refuses_and_disjoint_rosters_do_not() -> Bool {
  let overlap = wet_cross_route_overlap_causes(
    local_identities: ["test.claim.a.holds", "test.claim.b.holds"],
    transported_identities: ["test.claim.b.holds", "test.claim.c.holds"]
  )
  let disjoint = wet_cross_route_overlap_causes(
    local_identities: ["test.claim.a.holds"],
    transported_identities: ["test.claim.c.holds"]
  )
  length(xs: overlap) == 1 && length(xs: disjoint) == 0
}

// THE FOREIGN-RESOLUTION JOIN, and it is not tautological: the observed entry and function are what
// the executor actually resolved, so they can DISAGREE with the scheduled row. Recopying the
// scheduled values into the terminal would make this witness impossible to fail.
test fn a_terminal_that_resolved_elsewhere_refuses() -> Bool {
  let binding = transported_binding(subject: "s", executor: "x")
  let scheduled = [scheduled_alpha(route: SelfHostTransportedRoute {}, dry: DirectWetRouteDecline {}, expectation: ExpectedToHold {})]
  let foreign_entry = [
    WetTerminalRow {
      route: SelfHostTransportedRoute {},
      identity: alpha_identity(),
      observed_entry: "dag/test/claim/OTHER_test.dag",
      observed_function: "alpha_holds",
      terminal: passed(),
      binding: binding
    }
  ]
  let foreign_function = [
    WetTerminalRow {
      route: SelfHostTransportedRoute {},
      identity: alpha_identity(),
      observed_entry: "dag/test/claim/fixture_test.dag",
      observed_function: "some_other_function",
      terminal: passed(),
      binding: binding
    }
  ]
  let a = wet_evidence_validate(scheduled: scheduled, terminals: foreign_entry, required: binding)
  let b = wet_evidence_validate(scheduled: scheduled, terminals: foreign_function, required: binding)
  !wet_evidence_admits(v: a) && !wet_evidence_admits(v: b)
}
