module v2.test.lens_non_fold_residue.non_fold_residue_test

import v2.lens.non_fold_residue { nfr_roster_receipt_holds }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// Always-on PR floor receipt (operator brief 2026-07-22, class 4): nfr_roster_receipt_holds walks
// the live corpus via host-fed counters — MUST declare ReadsLiveTree so affected-set selection
// never predict-skips it (the lying SubstrateInputsOnly stamp class that kept the falsifier dark
// for 6 days). Detection-only: roster rows need reason + dissolution trigger; never auto-delete
// enrollments. Enrollment trimmed to receipt + two RED controls only;
// non_fold_residue_coproduct_universe_is_nonempty and
// non_fold_residue_discovery_roots_follow_layer_authority were dropped intentionally (census
// receipts, not required for the class-4 always-on receipt gate).

// THE TWO RED CONTROLS ARE INTERPRETER PRIMITIVES (std.primitives free_call rows
// non_fold_residue_synthetic_unrostered_red_holds / non_fold_residue_wildcard_red_fixture_holds),
// and the test fns that enrol them deliberately DO NOT share the primitive's spelling: a test fn
// named exactly as the primitive made every call of that name in this module bind, at name
// resolution, to the test fn rather than the primitive (a self-cycle through a helper), which the
// test-reference refusal forbids. A free-call primitive is reached by its bare spelling only, so
// the enrolling test fn carries a distinct name and calls the primitive directly.

test fn non_fold_residue_no_unrostered_or_stale() -> Bool {
  return nfr_roster_receipt_holds()
}

test fn non_fold_residue_synthetic_unrostered_red_control_holds() -> Bool {
  non_fold_residue_synthetic_unrostered_red_holds()
}

test fn non_fold_residue_wildcard_red_fixture_control_holds() -> Bool {
  non_fold_residue_wildcard_red_fixture_holds()
}
