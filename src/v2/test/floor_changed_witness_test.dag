// Every fixture below is authored in this source; the module reaches nothing outside the
// substrate inputs.
data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE FOLD'S EXECUTING CONSUMERS. `v2.workflow.floor_changed_witness` is the authority the
// required floor's host projection realizes (`v1_compiler.cli_run`
// `changed_witness_execution_standing`); these witnesses execute the .dag fold itself, one
// discriminating arm each, so the model's rung is established by execution rather than by the
// host citing it. This module's own identities are new under the `v2.test.` gate prefix, so
// the PR that lands them is also the projection's first live positive control: each must
// appear in its run's changed-witness lines with the terminal disposition preserved.

// THE EXISTING WITNESSES ALL READ THE NO-WET JOIN, which is the state every changed identity
// outside the local-repo wet lane is in: no route-gap agreement, no scheduled route, no terminal.
// Keeping it as one named constructor rather than an inline literal means the wet arm's own
// witnesses below differ from these by exactly the fact under test.
fn no_wet_join() -> HermeticRouteGapWetEvidence {
  HermeticRouteGapWetUnavailable {}
}

fn changed_standing_of(reading: ChangedWitnessDispositionReading) -> ChangedWitnessExecutionStanding {
  changed_witness_execution_standing(
    reading: reading, wet: no_wet_join(), identity: wet_identity, candidate: wet_candidate,
  )
}

fn changed_standing_with_wet(
  reading: ChangedWitnessDispositionReading,
  wet: HermeticRouteGapWetEvidence,
) -> ChangedWitnessExecutionStanding {
  changed_witness_execution_standing(
    reading: reading, wet: wet, identity: wet_identity, candidate: wet_candidate,
  )
}

// EVERY READING IN THIS MODULE IS BUILT THROUGH ONE OF THE TWO CONSTRUCTORS BELOW, so a new
// field on `ChangedWitnessDispositionReading` cannot be defaulted differently by fifteen call
// sites. `ordinary_changed_reading` is the pre-FLOOR-CHANGED-COST-0 shape: the ordinary cost
// policy with nothing published, which is what every changed witness outside the cost-debt
// roster reads as.
fn ordinary_changed_reading(
  disposition: RequiredFloorDisposition,
  terminal: ChangedWitnessTerminalReading,
) -> ChangedWitnessDispositionReading {
  DispositionRow {
    disposition: disposition,
    terminal: terminal,
    cost_policy: OrdinaryChangedWitnessCostPolicy {},
    cost: CostUnobserved {}
  }
}

fn verdict_only_changed_reading(
  terminal: ChangedWitnessTerminalReading,
  cost: ChangedWitnessCostReading,
) -> ChangedWitnessDispositionReading {
  DispositionRow {
    disposition: PlannedAsChangedWitness {},
    terminal: terminal,
    cost_policy: ChangedCostDebtVerdictOnly {},
    cost: cost
  }
}

// The measured shape of the specimen the ruling names: a semantic pass whose marginal CPU landed
// ABOVE the ordinary 500ms line, which is the state the four `bootstrap_footprint_anchor` rows
// oscillate through run to run.
fn cost_observation(cpu_ms: Nat, wall_ms: Nat) -> ChangedWitnessCostReading {
  CostObserved {
    observation: ChangedWitnessCostObservation {
      measured: observation_durations_cpu_and_wall(
        cpu: nanosecond(count: cpu_ms * 1000000),
        wall: nanosecond(count: wall_ms * 1000000)
      ),
      observed_against_basis: CpuClock {},
      observed_against: millisecond(count: 500)
    }
  }
}

fn over_line_observation() -> ChangedWitnessCostReading {
  cost_observation(cpu_ms: 505, wall_ms: 520)
}

// One exhaustive observation surface for the standing shape. Tests compare its answer instead
// of each growing a Boolean predicate that recursively restates the coproduct.
fn standing_kind(s: ChangedWitnessExecutionStanding) -> String {
  match s {
    PlannedAndPassed => "planned-and-passed"
    PlannedAndKnownRedHeld => "planned-and-known-red-held"
    PlannedAndPassedWithCostDebtObserved { observation: _ } =>
      "planned-and-passed-with-cost-debt-observed"
    CostObservationMissingUnderVerdictOnly => "cost-observation-missing-under-verdict-only"
    PlannedWithoutTerminalVerdict => "planned-without-terminal-verdict"
    HermeticRouteGapHeldAndWetPassed { evidence: _, identity: _, candidate: _ } => "hermetic-route-gap-held-and-wet-passed"
    Declined { disposition: _ } => "declined"
    MissingDisposition => "missing-disposition"
  }
}

// A planned identity whose terminal outcome is Passed carries the passed green standing.
test fn planned_with_passed_verdict_stands_green() -> Bool {
  standing_kind(
    s: changed_standing_of(
      reading: ordinary_changed_reading(
        disposition: Planned {},
        terminal: TerminalOutcome { outcome: Passed {} }
      )
    )
  ) == "planned-and-passed"
}

// The changed-witness sublane is a second planning mechanism, not an admission exception.
// Its terminal verdict is judged identically while its distinct disposition preserves why it ran.
test fn changed_sublane_with_passed_verdict_stands_green() -> Bool {
  standing_kind(
    s: changed_standing_of(
      reading: ordinary_changed_reading(
        disposition: PlannedAsChangedWitness {},
        terminal: TerminalOutcome { outcome: Passed {} }
      )
    )
  ) == "planned-and-passed"
}

test fn changed_selector_replaces_an_ordinary_decline_with_its_own_planned_arm() -> Bool {
  match required_floor_disposition_with_changed_selection(
    ordinary: DeclinedOutsideGateClosure {},
    selected_as_changed_witness: true,
  ) {
    PlannedAsChangedWitness => true
    Planned => false
    DeclinedLongModule { matched_prefix: _ } => false
    DeclinedOutsideRequiredGate => false
    DeclinedOutsideGateClosure => false
    DeclinedCostDebt => false
    DeclinedFixtureMember { matched_prefix: _ } => false
    DeclinedDiscoveryExcluded { matched_substring: _ } => false
  }
}

test fn unchanged_identity_keeps_its_ordinary_disposition() -> Bool {
  match required_floor_disposition_with_changed_selection(
    ordinary: DeclinedOutsideGateClosure {},
    selected_as_changed_witness: false,
  ) {
    DeclinedOutsideGateClosure => true
    Planned => false
    PlannedAsChangedWitness => false
    DeclinedLongModule { matched_prefix: _ } => false
    DeclinedOutsideRequiredGate => false
    DeclinedCostDebt => false
    DeclinedFixtureMember { matched_prefix: _ } => false
    DeclinedDiscoveryExcluded { matched_substring: _ } => false
  }
}

// A planned identity the receipt records as never executed is nonterminal — red.
test fn planned_but_not_executed_is_nonterminal() -> Bool {
  standing_kind(
    s: changed_standing_of(
      reading: ordinary_changed_reading(
        disposition: Planned {},
        terminal: NotExecuted {}
      )
    )
  ) == "planned-without-terminal-verdict"
}

// An enrolled expected-red failing exactly as enrolled reached the terminal verdict the run
// holds green for it — the sanctioned add-a-discriminating-RED move is not vetoed here.
test fn planned_with_known_red_held_verdict_stands_green() -> Bool {
  standing_kind(
    s: changed_standing_of(
      reading: ordinary_changed_reading(
        disposition: Planned {},
        terminal: TerminalOutcome { outcome: KnownRedHeld {} }
      )
    )
  ) == "planned-and-known-red-held"
}

// A planned identity with a non-Passed terminal outcome carries no passing verdict — red at
// this grain too, whatever its own mechanism already did to the floor.
test fn planned_with_failed_verdict_is_nonterminal() -> Bool {
  standing_kind(
    s: changed_standing_of(
      reading: ordinary_changed_reading(
        disposition: Planned {},
        terminal: TerminalOutcome { outcome: Failed {} }
      )
    )
  ) == "planned-without-terminal-verdict"
}

test fn planned_with_route_gap_verdict_is_nonterminal() -> Bool {
  standing_kind(
    s: changed_standing_of(
      reading: ordinary_changed_reading(
        disposition: Planned {},
        terminal: TerminalOutcome { outcome: RouteGapBeforeVerdict {} }
      )
    )
  ) == "planned-without-terminal-verdict"
}

// THE INCIDENT ARM: a changed identity declined because its module name is outside the gate
// closure classifies Declined — the exact state PRs #9672/#9675 shipped green.
test fn declined_outside_gate_closure_is_declined() -> Bool {
  standing_kind(
    s: changed_standing_of(
      reading: ordinary_changed_reading(
        disposition: DeclinedOutsideGateClosure {},
        terminal: NotExecuted {}
      )
    )
  ) == "declined"
}

test fn declined_long_module_is_declined() -> Bool {
  standing_kind(
    s: changed_standing_of(
      reading: ordinary_changed_reading(
        disposition: DeclinedLongModule { matched_prefix: "test.claim.long." },
        terminal: NotExecuted {}
      )
    )
  ) == "declined"
}

test fn declined_cost_debt_is_declined() -> Bool {
  standing_kind(
    s: changed_standing_of(
      reading: ordinary_changed_reading(
        disposition: DeclinedCostDebt {},
        terminal: NotExecuted {}
      )
    )
  ) == "declined"
}

// A changed identity with no disposition row at all is a fact the receipt cannot speak for.
test fn absent_row_is_missing_disposition() -> Bool {
  standing_kind(s: changed_standing_of(reading: NoDispositionRow {})) == "missing-disposition"
}

// Blocking polarity: the passed and enrolled-held standings are green.
test fn passed_and_known_red_held_are_green() -> Bool {
  !changed_witness_standing_blocks(standing: PlannedAndPassed {})
    && !changed_witness_standing_blocks(standing: PlannedAndKnownRedHeld {})
    && changed_witness_standing_blocks(standing: PlannedWithoutTerminalVerdict {})
    && changed_witness_standing_blocks(
      standing: Declined { disposition: DeclinedOutsideRequiredGate {} }
    )
    && changed_witness_standing_blocks(standing: MissingDisposition {})
}

// The fold keeps blocking rows in input order, drops the green rows, and CARRIES each blocker's
// cause.
test fn blocking_fold_keeps_reds_and_drops_greens() -> Bool {
  let rows = [
    ChangedWitnessRow {
      identity: "a.declined",
      standing: Declined { disposition: DeclinedOutsideGateClosure {} }
    },
    ChangedWitnessRow { identity: "b.green", standing: PlannedAndPassed {} },
    ChangedWitnessRow { identity: "c.missing", standing: MissingDisposition {} }
  ]
  match changed_witness_blockers(rows: rows) {
    Cons { head: first, tail: rest } =>
      first.identity == "a.declined"
        && first.cause == "declined_outside_gate_closure"
        && match rest {
          Cons { head: second, tail: last } =>
            second.identity == "c.missing"
              && second.cause == "changed_witness_missing_disposition"
              && match last {
                Empty {} => true
                Cons { head: _, tail: _ } => false
              }
          Empty {} => false
        }
    Empty {} => false
  }
}

// THE DISCRIMINATING RED for `gunbc.recurring_failure_mode`
// `non_verdict_disposition_surfaces_as_refusal` at this boundary, and the reason it is authored
// as a comparison rather than as two literals: the defect was not a wrong cause, it was ONE cause
// for every blocking standing. Two rows that block for materially different reasons — a witness
// that was declined and never ran, against a witness that was planned, ran, and reached no
// verdict — must arrive at the consumer distinguishable. Against the `List<String>` this fold
// returned through gunbc#10757 this assertion is UNSATISFIABLE: there was no cause to compare.
test fn two_blocking_standings_do_not_share_one_cause() -> Bool {
  let rows = [
    ChangedWitnessRow {
      identity: "a.never_ran",
      standing: Declined { disposition: DeclinedOutsideGateClosure {} }
    },
    ChangedWitnessRow { identity: "b.ran_without_verdict", standing: PlannedWithoutTerminalVerdict {} }
  ]
  match changed_witness_blockers(rows: rows) {
    Cons { head: first, tail: rest } =>
      match rest {
        Cons { head: second, tail: _ } =>
          (first.cause != second.cause)
            && (first.cause == "declined_outside_gate_closure")
            && (second.cause == "changed_witness_planned_without_terminal_verdict")
        Empty {} => false
      }
    Empty {} => false
  }
}

// AND THE PAIR THE INCIDENT WAS MEASURED ON: two DECLINES are not one cause either. The fifteen
// identities of gunbc#10757 were declined because no source root reaches their module, which is a
// different fact — and a different discharge — from a module whose authored name misses the gate
// prefixes. Enrolment follows the diff; discovery follows the source roots; the cause must say
// which of the two refused.
test fn two_declines_carry_their_own_dispositions() -> Bool {
  let outside_closure = changed_witness_blocking_cause(
    standing: Declined { disposition: DeclinedOutsideGateClosure {} }
  )
  let excluded = changed_witness_blocking_cause(
    standing: Declined { disposition: DeclinedDiscoveryExcluded { matched_substring: "/scratch/" } }
  )
  (outside_closure != excluded)
    && (excluded == "declined_discovery_excluded")
}

// NO BLOCKING STANDING REPORTS THE OLD CONSTANT. The cause the merge gate used to receive for
// every one of them was the flat name of the population itself, which offered its reader exactly
// one affordance — rerun — for standings that a rerun cannot discharge.
test fn no_blocking_cause_is_the_flat_population_name() -> Bool {
  let blocking = [
    Declined { disposition: DeclinedOutsideRequiredGate {} },
    MissingDisposition {},
    PlannedWithoutTerminalVerdict {},
    CostObservationMissingUnderVerdictOnly {}
  ]
  !any(
    xs: blocking,
    predicate: fn(s) { changed_witness_blocking_cause(standing: s) == "changed_witness_blocking" }
  )
}

// THE DEGENERATE CONTROL that widening a codomain invites: two rows blocking for the SAME reason
// must still produce TWO blockers. The identity is what the author has to act on, and a fold that
// keyed or collapsed on the cause would lose one silently — a `List<String>` made that mistake
// unobservable, and the repair must not introduce it.
test fn two_declines_with_one_disposition_stay_two_blockers() -> Bool {
  let rows = [
    ChangedWitnessRow {
      identity: "a.declined",
      standing: Declined { disposition: DeclinedOutsideGateClosure {} }
    },
    ChangedWitnessRow {
      identity: "b.declined",
      standing: Declined { disposition: DeclinedOutsideGateClosure {} }
    }
  ]
  match changed_witness_blockers(rows: rows) {
    Cons { head: first, tail: rest } =>
      first.identity == "a.declined"
        && match rest {
          Cons { head: second, tail: last } =>
            second.identity == "b.declined"
              && (first.cause == second.cause)
              && match last {
                Empty {} => true
                Cons { head: _, tail: _ } => false
              }
          Empty {} => false
        }
    Empty {} => false
  }
}

// POSITIVE CONTROL: a diff with no changed witness identities projects nothing and blocks
// nothing.
test fn empty_changed_set_blocks_nothing() -> Bool {
  match changed_witness_blockers(rows: []) {
    Empty {} => true
    Cons { head: _, tail: _ } => false
  }
}

// ---------------------------------------------------------------------------------------------
// FLOOR-CHANGED-COST-0: the typed join of changed selection and cost-debt enrollment.
//
// These witnesses are the DETERMINISTIC half of the ruling's acceptance matrix. The real
// specimen (`v2.test.manual.bootstrap_footprint_anchor.bootstrap_footprint_bad_runtime_same_identity_violates`)
// measures 474-505ms against a 500ms line, so a run of it decides which side of the line it
// happens to land on and nothing else; a fixture that constructed the `PassedOverBudget`
// terminal only by running that claim would be green on a lucky slot and silent on the arm it
// exists to test. The terminal outcome is therefore CONSTRUCTED here.

fn cost_policy_kind(policy: ChangedWitnessCostPolicy) -> String {
  match policy {
    OrdinaryChangedWitnessCostPolicy => "ordinary"
    ChangedCostDebtVerdictOnly => "verdict-only"
  }
}

fn cost_debt_standing_kind(standing: CostDebtRosterStanding) -> String {
  match standing {
    CostDebtWithheld => "withheld"
    CostDebtWithholdOverriddenForChangedVerdict => "withhold-overridden-for-changed-verdict"
    CostDebtOutsideThisRunsUniverse => "outside-this-runs-universe"
    CostDebtUndeclared => "undeclared"
    CostDebtDeclaredButNotWithheld => "declared-not-withheld"
  }
}

fn cost_debt_standing_of(disposition: RequiredFloorDisposition) -> String {
  cost_debt_standing_kind(
    standing: cost_debt_roster_standing(
      reading: CostDebtDispositionRow { disposition: disposition }
    )
  )
}

// THE INTERSECTION IS BOTH CONDITIONS. A rostered identity that this change did not touch takes
// the ordinary policy and never reaches the override; it is declined at build by
// `required_floor_site_disposition` instead.
test fn unchanged_cost_debt_identity_takes_no_verdict_only_policy() -> Bool {
  cost_policy_kind(
    policy: changed_witness_cost_policy(
      selected_as_changed_witness: false,
      module_path: "v2.test.manual.bootstrap_footprint_anchor",
      identity: "v2.test.manual.bootstrap_footprint_anchor.bootstrap_footprint_bad_runtime_same_identity_violates",
    )
  ) == "ordinary"
}

// A CHANGED identity enrolled in the cost-debt roster takes the override. The identity is read
// from the roster authority itself, so this witness reds if the specimen leaves the roster
// through the explicit debt-removal transaction and the join is not re-pointed with it.
test fn changed_cost_debt_identity_takes_the_verdict_only_policy() -> Bool {
  cost_policy_kind(
    policy: changed_witness_cost_policy(
      selected_as_changed_witness: true,
      module_path: "v2.test.manual.bootstrap_footprint_anchor",
      identity: "v2.test.manual.bootstrap_footprint_anchor.bootstrap_footprint_bad_runtime_same_identity_violates",
    )
  ) == "verdict-only"
}

// THE DISCRIMINATING CONTROL FOR "not a general widening": a changed identity that is NOT
// enrolled keeps the ordinary policy, so the CPU line still gates it.
test fn changed_ordinary_identity_keeps_the_ordinary_policy() -> Bool {
  cost_policy_kind(
    policy: changed_witness_cost_policy(
      selected_as_changed_witness: true,
      module_path: "v2.test.floor_changed_witness",
      identity: "v2.test.floor_changed_witness.changed_ordinary_identity_keeps_the_ordinary_policy",
    )
  ) == "ordinary"
}

// THE OVERRIDE NO LONGER SELECTS A CLOCK, BECAUSE NO CLAIM'S CPU IS GATED (2026-09-12). This
// witness stood here as `the_override_disarms_the_line_it_does_not_raise_it`, over a
// changed_witness_cpu_deadline predicate: the cost-debt override disarmed the CPU deadline and an ordinary
// changed witness kept it armed. Both the predicate and the two-armed `ClaimCpuDeadline` are
// deleted -- the exception was generalised to every claim, so a function distinguishing the two
// populations distinguishes nothing.
//
// WHAT REPLACES IT IS THE SAME ASSERTION ONE LEVEL UP, AND IT KEEPS THE HALF THAT MATTERED: CPU
// stopped gating and did NOT stop being published. `BasisObservedOnly` cannot be constructed
// without naming its publisher, so the arm below asserts a non-empty publisher rather than merely
// matching the variant -- a standing that gated nothing and published nothing would be the
// absorbing fallback, and it is exactly what this witness exists to refuse.
//
// THE DISCRIMINATING DIRECTION IS BOTH WAYS. Asserting only that CPU is observed-only would pass
// against a roster that observed EVERYTHING and gated nothing, which is the same failure wearing a
// different face; so the two gating clocks are asserted to gate in the same fold.
test fn cpu_is_observed_only_for_every_claim_and_still_published() -> Bool {
  match claim_cost_basis_standing(basis: CpuTimeBasis {}) {
    BasisGates => false
    BasisObservedOnly { published_by: publisher } =>
      string_contains(s: publisher, pattern: "per-claim cost receipt")
        && (claim_cost_basis_gates(basis: CpuTimeBasis {}) == false)
        && claim_cost_basis_gates(basis: EvalStepBasis {})
        && claim_cost_basis_gates(basis: WallTimeBasis {})
        && (required_floor_claim_work_envelope_ms() == 500)
  }
}

// ACCEPTANCE ROW: changed cost-debt identity, semantic pass, observed CPU above the line. Green,
// and the standing CARRIES the observation rather than laundering it into an ordinary pass.
test fn verdict_only_pass_over_the_line_is_green_with_the_cost_observed() -> Bool {
  standing_kind(
    s: changed_standing_of(
      reading: verdict_only_changed_reading(
        terminal: TerminalOutcome { outcome: PassedOverBudget {} },
        cost: over_line_observation()
      )
    )
  ) == "planned-and-passed-with-cost-debt-observed"
}

// The same row's published observation is the measurement, not a re-derivation: the standing
// hands back the marginal CPU, the wall figure and the line the run compared against.
test fn the_published_observation_carries_both_clocks_and_the_line() -> Bool {
  match changed_standing_of(
    reading: verdict_only_changed_reading(
      terminal: TerminalOutcome { outcome: PassedOverBudget {} },
      cost: over_line_observation()
    )
  ) {
    PlannedAndPassedWithCostDebtObserved { observation: o } =>
      match changed_witness_gated_clock_measurement(observation: o) {
        MeasuredValue { value: cpu } =>
          nanosecond_count(n: cpu) == 505000000
            && millisecond_count(m: o.observed_against) == 500
            && match observation_duration_of(durations: o.measured, basis: WallClock {}) {
              MeasuredValue { value: wall } => nanosecond_count(n: wall) == 520000000
              MeasuredUnavailable { cause: _ } => false
            }
        MeasuredUnavailable { cause: _ } => false
      }
    PlannedAndPassed => false
    PlannedAndKnownRedHeld => false
    CostObservationMissingUnderVerdictOnly => false
    PlannedWithoutTerminalVerdict => false
    HermeticRouteGapHeldAndWetPassed { evidence: _, identity: _, candidate: _ } => false
    Declined { disposition: _ } => false
    MissingDisposition => false
  }
}

// An ordinary pass under the override is green too, and still carries its observation — the
// specimen lands under the line on roughly half its runs and must not report a different
// standing for the same policy.
test fn verdict_only_ordinary_pass_still_publishes_its_cost() -> Bool {
  standing_kind(
    s: changed_standing_of(
      reading: verdict_only_changed_reading(
        terminal: TerminalOutcome { outcome: Passed {} },
        cost: cost_observation(cpu_ms: 474, wall_ms: 480)
      )
    )
  ) == "planned-and-passed-with-cost-debt-observed"
}

// THE DISCRIMINATING RED FOR A STOOD-DOWN GATE WITH NOTHING IN ITS PLACE.
test fn verdict_only_pass_without_a_published_cost_reds() -> Bool {
  standing_kind(
    s: changed_standing_of(
      reading: verdict_only_changed_reading(
        terminal: TerminalOutcome { outcome: Passed {} },
        cost: CostUnobserved {}
      )
    )
  ) == "cost-observation-missing-under-verdict-only"
}

// ACCEPTANCE ROW: the override moves the COST arm and nothing else. A semantic failure under the
// override is red.
test fn verdict_only_semantic_failure_reds() -> Bool {
  standing_kind(
    s: changed_standing_of(
      reading: verdict_only_changed_reading(
        terminal: TerminalOutcome { outcome: Failed {} },
        cost: over_line_observation()
      )
    )
  ) == "planned-without-terminal-verdict"
}

// ACCEPTANCE ROW: no verdict before the still-armed wall safety deadline is red under the
// override, which is the arm that keeps this from being an escape hatch.
test fn verdict_only_without_a_verdict_reds() -> Bool {
  standing_kind(
    s: changed_standing_of(
      reading: verdict_only_changed_reading(
        terminal: TerminalOutcome { outcome: BudgetRefusedBeforeVerdict {} },
        cost: over_line_observation()
      )
    )
  ) == "planned-without-terminal-verdict"
}

// ACCEPTANCE ROW, AND THE CONTROL THAT KEEPS THE OVERRIDE NARROW: the identical terminal outcome
// under the ORDINARY policy stays red. One field separates these two witnesses, so a repair that
// greened `PassedOverBudget` generally would red this one.
test fn ordinary_changed_witness_over_budget_still_reds() -> Bool {
  standing_kind(
    s: changed_standing_of(
      reading: ordinary_changed_reading(
        disposition: PlannedAsChangedWitness {},
        terminal: TerminalOutcome { outcome: PassedOverBudget {} }
      )
    )
  ) == "planned-without-terminal-verdict"
}

// The green arm is green in the blocking fold too, and the missing-observation arm blocks.
test fn cost_debt_observed_arm_is_green_and_missing_observation_blocks() -> Bool {
  match over_line_observation() {
    CostObserved { observation: o } =>
      !changed_witness_standing_blocks(
        standing: PlannedAndPassedWithCostDebtObserved { observation: o }
      )
        && changed_witness_standing_blocks(standing: CostObservationMissingUnderVerdictOnly {})
    CostUnobserved => false
  }
}

// ACCEPTANCE ROW: an unchanged rostered identity is withheld and its standing says so.
test fn withheld_row_stands_as_debt() -> Bool {
  cost_debt_standing_of(disposition: DeclinedCostDebt {}) == "withheld"
}

// ACCEPTANCE ROW: a cost-debt row planned by the changed override is NOT stale. It is still
// valid debt; changed selection temporarily required its correctness verdict.
test fn overridden_row_is_not_reported_stale() -> Bool {
  cost_debt_standing_of(disposition: PlannedAsChangedWitness {})
    == "withhold-overridden-for-changed-verdict"
    && !cost_debt_roster_standing_refuses(
      standing: CostDebtWithholdOverriddenForChangedVerdict {}
    )
}

// THE DISCRIMINATING CONTROL BESIDE IT: an ordinary planned row over an enrolled identity is
// still stale, so the new arm did not silence the whole refusal.
test fn ordinarily_planned_rostered_row_is_still_stale() -> Bool {
  cost_debt_standing_of(disposition: Planned {}) == "declared-not-withheld"
    && cost_debt_roster_standing_refuses(standing: CostDebtDeclaredButNotWithheld {})
}

// ACCEPTANCE ROW: a deleted or renamed debt identity still refuses, and an identity the gate
// never offered is still kept as record rather than counted as debt.
test fn undeclared_refuses_and_outside_the_universe_does_not() -> Bool {
  cost_debt_standing_kind(
    standing: cost_debt_roster_standing(reading: CostDebtNoDispositionRow {})
  ) == "undeclared"
    && cost_debt_roster_standing_refuses(standing: CostDebtUndeclared {})
    && cost_debt_standing_of(disposition: DeclinedOutsideGateClosure {})
      == "outside-this-runs-universe"
    && !cost_debt_roster_standing_refuses(standing: CostDebtOutsideThisRunsUniverse {})
}

// A home decline outranks cost debt in `required_floor_site_disposition`, so a rostered identity
// carrying one never entered the withhold and its roster line is stale.
test fn home_declined_rostered_row_is_stale() -> Bool {
  cost_debt_standing_of(
    disposition: DeclinedLongModule { matched_prefix: "test.claim.long." }
  ) == "declared-not-withheld"
    && cost_debt_standing_of(
      disposition: DeclinedDiscoveryExcluded { matched_substring: "sandbox" }
    ) == "outside-this-runs-universe"
}

// THE SAME ABSENCE ONE LEVEL IN: an observation that carries only the clock that was NOT stood
// down publishes nothing about the line it replaced, so it reds exactly as a missing one does.
test fn an_observation_missing_its_gated_clock_reds() -> Bool {
  standing_kind(
    s: changed_standing_of(
      reading: verdict_only_changed_reading(
        terminal: TerminalOutcome { outcome: PassedOverBudget {} },
        cost: CostObserved {
          observation: ChangedWitnessCostObservation {
            measured: [
              TimedMeasurement {
                basis: WallClock {},
                elapsed: MeasuredValue { value: nanosecond(count: 520000000) }
              }
            ],
            observed_against_basis: CpuClock {},
            observed_against: millisecond(count: 500)
          }
        }
      )
    )
  ) == "cost-observation-missing-under-verdict-only"
}

// THE JOINED STANDING, discriminated on each of its three facts independently. The control the
// ruling names by name is a_route_gap_with_no_live_route_still_blocks and its two siblings: an
// implementation that made every route-gap standing nonblocking passes the first witness here and
// fails all three of them.
data wet_identity: String = "test.claim.x.w_one"
data wet_other_identity: String = "test.claim.x.w_other"
data wet_candidate: String = "subject-8993beb0d2808db6"
data wet_other_candidate: String = "subject-0000000000000000"

fn wet_admitted(identity: String, candidate: String, lane: WetEvidenceValidation) -> HermeticRouteGapWetEvidence {
  HermeticRouteGapWetAdmitted {
    admitted: WetTerminalAdmitted { identity: identity, candidate: candidate },
    lane: lane,
  }
}

fn lane_refused() -> WetEvidenceValidation {
  WetEvidenceRefused { causes: [WetTerminalMissing { identity: wet_identity }] }
}

// THE ADMITTED LANE CARRIES ITS BINDING. The shared validator's admitted arm is not a bare marker:
// it reports WHICH subject the evidence was bound to, so a standing built on it cannot claim
// admission without naming the tree that produced it.
fn lane_holds() -> WetEvidenceValidation {
  WetEvidenceAdmitted {
    binding: CoResidentPreparedSubject { prepared_subject: wet_candidate },
    terminals: []
  }
}

fn route_gap_reading() -> ChangedWitnessDispositionReading {
  ordinary_changed_reading(
    disposition: PlannedAsChangedWitness {},
    terminal: TerminalOutcome { outcome: RouteGapBeforeVerdict {} },
  )
}

fn standing_blocks_for(wet: HermeticRouteGapWetEvidence) -> Bool {
  changed_witness_standing_blocks(
    standing: changed_standing_with_wet(reading: route_gap_reading(), wet: wet),
  )
}

fn admitted_here() -> HermeticRouteGapWetEvidence {
  wet_admitted(identity: wet_identity, candidate: wet_candidate, lane: lane_holds())
}

test fn a_route_gap_with_matching_evidence_is_admitted() -> Bool {
  match changed_standing_with_wet(reading: route_gap_reading(), wet: admitted_here()) {
    HermeticRouteGapHeldAndWetPassed { evidence: e, identity: i, candidate: c } =>
      hermetic_route_gap_wet_join_complete(evidence: e, identity: i, candidate: c)
    _ => false
  }
    && !standing_blocks_for(wet: admitted_here())
}

// THE EVIDENCE MUST BE ABOUT THIS IDENTITY. The prior shape could not express this test at all:
// three booleans carry no identity, so a terminal admitted for a DIFFERENT witness satisfied them
// exactly as well as the right one.
test fn a_route_gap_whose_evidence_names_another_identity_still_blocks() -> Bool {
  standing_blocks_for(
    wet: wet_admitted(identity: wet_other_identity, candidate: wet_candidate, lane: lane_holds()),
  )
}

// AND ABOUT THIS TREE. A terminal from another candidate is the standing that let a deleted
// workflow read as coverage for months.
test fn a_route_gap_whose_evidence_names_another_candidate_still_blocks() -> Bool {
  standing_blocks_for(
    wet: wet_admitted(identity: wet_identity, candidate: wet_other_candidate, lane: lane_holds()),
  )
}

// AND THE LANE ITSELF MUST BE HONEST. A per-identity admission is not enough while the lane's own
// schedule and terminals disagree: one member may pass while another was never run, and accepting
// the first would let a broken roster supply evidence for its intact rows.
test fn a_route_gap_admitted_under_a_refused_lane_join_still_blocks() -> Bool {
  standing_blocks_for(
    wet: wet_admitted(identity: wet_identity, candidate: wet_candidate, lane: lane_refused()),
  )
}

// THE UNCHANGED POLARITY. A route gap carrying none of the three facts -- every changed identity
// outside this lane -- keeps the standing and the block it always had, so the lane adds an arm
// rather than widening the gate.
test fn a_route_gap_with_no_wet_facts_at_all_still_blocks() -> Bool {
  standing_blocks_for(wet: no_wet_join())
    && match changed_standing_with_wet(reading: route_gap_reading(), wet: no_wet_join()) {
      PlannedWithoutTerminalVerdict => true
      _ => false
    }
}


// ---- THE LONG-HOME ARM (operator ruling A, 2026-09-11) ----

// THE DISCRIMINATING RED. A changed witness in a long module runs FOR ITS VERDICT, because the
// long home is the same declaration as a cost-debt row -- "not run on an ordinary floor, the
// 500ms line cannot carry it" -- said per module instead of per identity. Before this arm the
// identity fell through to the armed line: measured on gunbc#11004 at 6b153bf8, where touching
// one long module planned three witnesses that were budget-refused BEFORE reaching a verdict, none
// of which is planned on any ordinary floor. The instrument is that run's own floor receipt -- its
// BUDGET-REFUSED announcements and the required-floor-claim-cost artifact beside them -- and the
// figures are read from there rather than copied to here, because a transcribed number is
// unreachable from the producer that owns it (DESIGN section 6). This control is red on the code
// that shipped that run.
test fn changed_long_module_witness_takes_the_verdict_only_policy() -> Bool {
  cost_policy_kind(
    policy: changed_witness_cost_policy(
      selected_as_changed_witness: true,
      module_path: "v2.test.long.accumulator_copy_compile_gate",
      identity: "v2.test.long.accumulator_copy_compile_gate.gate_refusal_ledger_counted_not_gating",
    )
  ) == "verdict-only"
}

// THE MIRROR CONTROL, and it is the reason the arm is an arm rather than a widening: a changed
// witness that is NOT in a long module and NOT rostered still takes the ordinary policy, so the
// CPU line still converts its crossing into a red. An arm that cannot be shown to STOP somewhere
// is indistinguishable from raising the ceiling, which docs/plans/floor-cost-distribution-near-
// the-ceiling.md refuses for this class.
test fn changed_short_module_witness_still_takes_the_ordinary_policy() -> Bool {
  cost_policy_kind(
    policy: changed_witness_cost_policy(
      selected_as_changed_witness: true,
      module_path: "v2.test.claim.lens_application.some_ordinary_module",
      identity: "v2.test.claim.lens_application.some_ordinary_module.some_ordinary_witness",
    )
  ) == "ordinary"
}

// THE ARM IS KEYED ON THE MODULE, NOT ON SELECTION: an UNCHANGED witness in a long module reaches
// no policy here at all. It is declined at build by required_floor_site_disposition as
// DeclinedLongModule and never becomes a claim, so answering verdict-only for it would be a
// policy over a population that does not execute.
test fn unchanged_long_module_witness_takes_no_verdict_only_policy() -> Bool {
  cost_policy_kind(
    policy: changed_witness_cost_policy(
      selected_as_changed_witness: false,
      module_path: "v2.test.long.accumulator_copy_compile_gate",
      identity: "v2.test.long.accumulator_copy_compile_gate.gate_refusal_ledger_counted_not_gating",
    )
  ) == "ordinary"
}

// ALL THREE AUTHORED LONG PREFIXES SELECT THE ARM, because the long home is not one namespace:
// the roster carries test.claim.long., v2.test.long. and v2.test.claim.long., and a one-prefix
// reading excluded 42 rows of an expected ~310 when it was last tried. An arm keyed on one of
// the three would be narrower than the class it claims.
test fn every_long_prefix_selects_the_verdict_only_policy() -> Bool {
  !any(["test.claim.long.x", "v2.test.long.x", "v2.test.claim.long.x"], m =>
    cost_policy_kind(
      policy: changed_witness_cost_policy(
        selected_as_changed_witness: true,
        module_path: m,
        identity: "irrelevant.identity",
      )
    ) != "verdict-only")
}

// ---- THE POLICY THE ARM SELECTS MUST BE THE POLICY THE STANDING CARRIES ----

// THE RED FOR A DEFECT THAT LIVED BETWEEN TWO CORRECT HALVES. The policy fold answered
// verdict-only for a long-module changed witness, and the standing fold projected verdict-only
// readings correctly -- and the seed still greened such a row as an ordinary planned-and-passed,
// because its projection REBUILT the policy from a set the long-home identity never entered
// rather than carrying the policy its claim executed under. Both folds were right; the seam
// between them was not, so neither fold's own controls could see it.
//
// This composes them: the policy is taken from changed_witness_cost_policy for a long-module
// identity rather than written in by hand, so the control goes red if EITHER the arm stops
// selecting verdict-only or the standing stops carrying the cost fact. A hand-written
// ChangedCostDebtVerdictOnly here would have tested the standing fold twice and the join not at
// all, which is what left the gap open.
fn standing_under_selected_policy(
  module_path: String,
  identity: String,
  terminal: ChangedWitnessTerminalReading,
  cost: ChangedWitnessCostReading,
) -> ChangedWitnessExecutionStanding {
  changed_standing_of(
    reading: DispositionRow {
      disposition: PlannedAsChangedWitness {},
      terminal: terminal,
      cost_policy: changed_witness_cost_policy(
        selected_as_changed_witness: true,
        module_path: module_path,
        identity: identity,
      ),
      cost: cost
    }
  )
}

test fn a_long_module_changed_pass_carries_its_cost_debt_observation() -> Bool {
  standing_kind(
    s: standing_under_selected_policy(
      module_path: "v2.test.long.accumulator_copy_compile_gate",
      identity: "v2.test.long.accumulator_copy_compile_gate.gate_refusal_ledger_counted_not_gating",
      terminal: TerminalOutcome { outcome: Passed {} },
      cost: over_line_observation()
    )
  ) == "planned-and-passed-with-cost-debt-observed"
}

// THE OTHER HALF OF THE SAME JOIN: standing the CPU gate down and publishing nothing is the one
// new red, and it must reach a long-module row too. If a long-home witness projected as ordinary,
// this arm could never fire for it -- the gate would be stood down with no measurement in its
// place and the run would still read green.
test fn a_long_module_changed_pass_without_a_measurement_is_red() -> Bool {
  standing_kind(
    s: standing_under_selected_policy(
      module_path: "v2.test.long.accumulator_copy_compile_gate",
      identity: "v2.test.long.accumulator_copy_compile_gate.gate_refusal_ledger_counted_not_gating",
      terminal: TerminalOutcome { outcome: Passed {} },
      cost: CostUnobserved {}
    )
  ) == "cost-observation-missing-under-verdict-only"
}

// THE BOUNDARY, composed the same way: a NON-long changed witness off the roster takes the
// ordinary policy, so its pass is an ordinary pass and carries no cost-debt observation. Without
// this, the two controls above would be satisfied by an arm that made every changed witness
// verdict-only.
test fn a_short_module_changed_pass_is_an_ordinary_pass() -> Bool {
  standing_kind(
    s: standing_under_selected_policy(
      module_path: "v2.test.floor_changed_witness",
      identity: "v2.test.floor_changed_witness.some_ordinary_witness",
      terminal: TerminalOutcome { outcome: Passed {} },
      cost: over_line_observation()
    )
  ) == "planned-and-passed"
}
