module v2.test.workflow.glob_discovery_law

import std.algebra { Cons, Empty }
import v2.std.algebra { filter, fold_list, length }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.compiler.discovery_enumeration {
  OwnedBoolWitnessClaimInit,
  OwnedDataDeclInitializer,
  OwnedDataDeclRecord,
  OwnedNodeCorpusInit,
  OwnedOtherInit,
  ResolvedDeclRef,
  unified_claim_arm_bool_witness_claim_module,
  unified_claim_arm_node_corpus_module
}

fn resolved_decl_is_bool_witness_claim_arm(d: ResolvedDeclRef) -> Bool {
  (d.module == unified_claim_arm_bool_witness_claim_module)
    && (d.name == ^unified_claim_arm_bool_witness_claim)
}

fn resolved_decl_is_node_corpus_arm(d: ResolvedDeclRef) -> Bool {
  (d.module == unified_claim_arm_node_corpus_module)
    && (d.name == ^unified_claim_arm_node_corpus)
}

fn owned_decl_is_bool_witness_claim_arm(r: OwnedDataDeclRecord) -> Bool {
  match r.initializer {
    OwnedBoolWitnessClaimInit { witness_entry: _, witness_function: _ } => true
    OwnedNodeCorpusInit => false
    OwnedOtherInit { resolved: _ } => false
  }
}

fn owned_decl_is_node_corpus_arm(r: OwnedDataDeclRecord) -> Bool {
  match r.initializer {
    OwnedNodeCorpusInit => true
    OwnedBoolWitnessClaimInit { witness_entry: _, witness_function: _ } => false
    OwnedOtherInit { resolved: _ } => false
  }
}

fn owned_other_init_is_illegal_unified_claim_arm(r: OwnedDataDeclRecord) -> Bool {
  match r.initializer {
    OwnedOtherInit { resolved: d } =>
      resolved_decl_is_bool_witness_claim_arm(d: d)
        || resolved_decl_is_node_corpus_arm(d: d)
    _ => false
  }
}

fn is_unified_test_claim_arm(r: OwnedDataDeclRecord) -> Bool {
  owned_decl_is_bool_witness_claim_arm(r: r)
    || owned_decl_is_node_corpus_arm(r: r)
}

fn filter_unified_test_claim_decls(xs: List<OwnedDataDeclRecord>) -> List<OwnedDataDeclRecord> {
  filter(xs: xs, predicate: fn(r) { is_unified_test_claim_arm(r: r) })
}

fn discovery_filtered_decl_count(xs: List<OwnedDataDeclRecord>) -> Int {
  length(xs: filter_unified_test_claim_decls(xs: xs))
}

fn bool_witness_claim_record_has_complete_transport(r: OwnedDataDeclRecord) -> Bool {
  match r.initializer {
    OwnedBoolWitnessClaimInit { witness_entry: e, witness_function: f } =>
      (e != "") && (f != "")
    OwnedNodeCorpusInit => true
    OwnedOtherInit { resolved: _ } => !owned_other_init_is_illegal_unified_claim_arm(r: r)
  }
}

fn discovery_smoke_set_is_nonempty(xs: List<OwnedDataDeclRecord>) -> Bool {
  discovery_filtered_decl_count(xs: xs) > 0
}

fn filter_bool_witness_claim_decls(xs: List<OwnedDataDeclRecord>) -> List<OwnedDataDeclRecord> {
  filter(xs: xs, predicate: fn(r) { owned_decl_is_bool_witness_claim_arm(r: r) })
}

fn discovered_bool_witness_claim_count(xs: List<OwnedDataDeclRecord>) -> Int {
  length(xs: filter_bool_witness_claim_decls(xs: xs))
}

fn filter_bool_witness_claim_arms_with_complete_transport(
  xs: List<OwnedDataDeclRecord>
) -> List<OwnedDataDeclRecord> {
  filter(xs: xs, predicate: fn(r) {
    owned_decl_is_bool_witness_claim_arm(r: r)
      && bool_witness_claim_record_has_complete_transport(r: r)
  })
}

fn discovered_contains_bool_witness_decl_by_name(
  xs: List<OwnedDataDeclRecord>,
  decl_name: String
) -> Bool {
  fold_list(
    xs: xs,
    empty: false,
    cons: fn(acc, r) {
      if owned_decl_is_bool_witness_claim_arm(r: r)
          && (r.decl_name == decl_name) {
        true
      } else {
        acc
      }
    }
  )
}
