// THE ONE-BOUNDARY TRIPWIRE FOR THE SCOPED CENSUS POPULATION (quiet-carp-503, October 2026).
//
// WHY THIS MODULE IS ITS OWN FILE: the two claims below must EXECUTE to guard anything, and a claim
// that cannot prepare is not a guard (DESIGN section 5: "Done means a real consumer green by
// execution"). In v2.test.claim.census_scoped_acquisition every member is refused at prepare on the
// frontier wall -- its door claims reach std.algebra's BODY through acquire_census_closure_of, and
// std.algebra binds ambient names (list_push, ...) that do not resolve outside the contract rows the
// v2 native ruling keeps off both acquisition paths (list_push's one declared home is #14751) --
// measured, with the refusal chain, in the PR receipt and the ledger row named below. These two
// claims reach NOTHING but the identity function they pin, so their declarer closure stays clean of
// the wall and they run.
//
// WHAT THEY GUARD: fn native_census_scoped_entries (v2.compiler.source_root_eval) is THE boundary
// where the scoped census decides which modules it loads. The resolver's ambient primitive-authority
// tier (v2.compiler.resolve resolve_atom_primitive_authority) binds an unimported spelling iff its
// contract row sits in the LOADED population's symbol index -- so the moment anyone appends a module
// the subjects did not name (a contract roster, a convenience tier), the census starts binding through
// something the native ROUTE refuses at. Both closure attempts died that way, measured and recorded in
// recurring_failure_mode: gunbc.recurring_failure_mode.census_rows_read_the_loaded_population -- read
// it before touching the boundary. The CLASS ITSELF IS OPEN: the row says so, with the instrument that
// re-derives any of it (//gunbc/instruments:v2-native-census-scoped). These claims are the regression
// tripwire on the function, not closure evidence, and they do not reach call-site bypasses -- the
// prevention of those is the row's open ceiling.

module v2.test.claim.census_scoped_entries_boundary

import std.types { Bool, List, String }
import v2.compiler.source_root_eval {
  native_census_scoped_entries,
}

// Identity for every supplied population, in argv order, nothing appended -- including a population
// that spells a contract module itself: the CALLER'S name rides in the CALLER'S position, never as an
// authority the census injected. Plain equality on supplied values at the boundary; no filesystem, no
// fold surface (reimplementing std.algebra helpers to dodge the wall was refused -- it would fork the
// list ops, DESIGN section 3).
test fn the_census_admits_no_ambient_resolution_authority() -> Bool {
  native_census_scoped_entries(subjects: ["std.fermi"]) == ["std.fermi"]
    && native_census_scoped_entries(subjects: []) == []
    && native_census_scoped_entries(subjects: ["extdeps.git.versioning", "std.fermi"]) == ["extdeps.git.versioning", "std.fermi"]
}

// The shape the reversed substrate fold existed to serve, now pinned to the opposite: a population
// that never reaches the ambient tier still gets EXACTLY itself -- nothing "rides" it, and duplicates
// the caller named are the caller's own, neither added to nor removed from.
test fn a_subject_list_gets_exactly_itself_whatever_it_reaches() -> Bool {
  native_census_scoped_entries(subjects: ["std.fermi"]) == ["std.fermi"]
    && native_census_scoped_entries(subjects: ["std.fermi", "std.primitives"]) == ["std.fermi", "std.primitives"]
    && native_census_scoped_entries(subjects: ["std.primitives", "std.primitives"]) == ["std.primitives", "std.primitives"]
}
