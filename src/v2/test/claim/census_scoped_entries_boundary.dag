// THE ONE-BOUNDARY TRIPWIRE FOR THE SCOPED CENSUS POPULATION (quiet-carp-503, October 2026).
//
// WHY THIS MODULE IS ITS OWN FILE: a claim that cannot prepare is not a guard (DESIGN section 5:
// "Done means a real consumer green by execution"). Two probe rounds measured what the v2 native
// reversal permits in claim code: every `==` usage -- even a bare String literal equality with no
// call at all -- refuses at prepare with inhabitance_undecidable_formal_unresolved ->
// application_argument_does_not_inhabit, because `==` is grounded through a primitive contract row
// and the ruling keeps the contract rows off the population. Scratch branches record both rounds:
// scratch/qc503-boundary-probe1 (four `==`-over-list shapes) and scratch/qc503-boundary-probe2
// (positional probes sharing one `==` String baseline; all refused identically). The direction-
// measurements and what still opens/closes the class live in the ledger row
// gunbc.recurring_failure_mode.census_rows_read_the_loaded_population -- read it before touching
// fn native_census_scoped_entries (v2.compiler.source_root_eval).
//
// WHAT THIS CLAIM GUARDS: the boundary function must return EXACTLY the subjects it was handed --
// the same COUNT, in order, nothing appended. Count is read positionally through the list
// structure (no equality anywhere in this module, per the measurement above): an appended module --
// the exact wrongness of the first fix -- lengthens the list and REDs this claim. A swapped name
// at the same position is NOT guarded here (name equality is the contract-gated shape); that half
// stays the ledger row's open ceiling, read from the instrument
// //gunbc/instruments:v2-native-census-scoped beside the route's own first fatal.

module v2.test.claim.census_scoped_entries_boundary

import std.types { Bool, List }
import std.algebra { Cons, Empty }
import v2.compiler.source_root_eval {
  native_census_scoped_entries,
}

// One supplied subject in, exactly one element out: a head and an Empty tail. An append anywhere
// inside the boundary function makes the tail a Cons and this refuses; a dropped subject makes the
// result Empty and this refuses. argv order and per-position names are the instrument's half.
test fn one_subject_in_yields_exactly_one_entry_out() -> Bool {
  match native_census_scoped_entries(subjects: ["std.fermi"]) {
    Cons { head: _, tail: after } =>
      match after {
        Empty => true
        Cons { head: _, tail: _ } => false
      }
    Empty => false
  }
}

// Two supplied subjects in, exactly two out: head, second, Empty. Catches the append-after-second
// and the drop-middle shapes the single-subject claim cannot see.
test fn two_subjects_in_yield_exactly_two_entries_out() -> Bool {
  match native_census_scoped_entries(subjects: ["extdeps.git.versioning", "std.fermi"]) {
    Cons { head: _, tail: rest } =>
      match rest {
        Cons { head: _, tail: after } =>
          match after {
            Empty => true
            Cons { head: _, tail: _ } => false
          }
        Empty => false
      }
    Empty => false
  }
}
