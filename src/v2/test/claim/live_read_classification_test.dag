test fn g2_roster_gate_entry_classifies_literal_paths() -> Bool {
  let c = live_read_classification_g2_from_facts(
    entry_module: "v2.test.claim.complexity.accumulator_copy_roster_gate",
    facts: roster_gate_corpus_facts,
    decls: fn_arrow_decl_facts_live(),
    carrier_homes: live_read_carrier_homes_v0
  )
  classification_has_filesystem_read_carrier(classification: c)
    && classification_has_literal_path(
      classification: c,
      path: "src/v2/std/algebra.dag"
    )
}

test fn g2_roster_gate_literal_path_touched_selects() -> Bool {
  let c = live_read_classification_g2_from_facts(
    entry_module: "v2.test.claim.complexity.accumulator_copy_roster_gate",
    facts: roster_gate_corpus_facts,
    decls: fn_arrow_decl_facts_live(),
    carrier_homes: live_read_carrier_homes_v0
  )
  runtime_read_touched_by_path_g2(
    classification: c,
    touched_path: "src/v2/std/algebra.dag"
  )
    && runtime_read_touched_by_path_g2(
      classification: c,
      touched_path: "src/v2/lens/complexity_accumulator_copy.dag"
    )
}


test fn g2_implies_reads_live_tree_for_roster_gate() -> Bool {
  g2_implies_reads_live_tree(
    classification: live_read_classification_g2_from_facts(
      entry_module: "v2.test.claim.complexity.accumulator_copy_roster_gate",
      facts: roster_gate_corpus_facts,
      decls: fn_arrow_decl_facts_live(),
      carrier_homes: live_read_carrier_homes_v0
    )
  )
    && accumulator_copy_roster_gate_entry_live_tree_disposition() == ReadsLiveTree
}

test fn g2_unknown_path_pattern_fail_closed_touched() -> Bool {
  let c = live_read_classification_from_facts(
    entry_module: "fix.witness",
    facts: fixture_roster_gate_facts,
    carrier_homes: fixture_carriers
  )
  match c {
    RuntimeRead { carriers: carriers } =>
      runtime_read_touched_by_path_g2(
        classification: c,
        touched_path: "dag/unrelated.dag"
      )
    LocalRead => false
  }
}


test fn g2_fn_arrow_marshal_host_scaffold_receipt_is_checkable() -> Bool {
  match fn_arrow_skeleton_g2_marshal_host_scaffold_dissolution_trigger {
    Scaffold { dissolves_to: _, bind: _ } => true
    Terminal { reason: _ } => false
  }
}

data live_read_selection_control_law: String = "WHY THESE THREE REPLACE THE UNION TEST. g2_union_retains_g1_import_carriers_with_g2_literal_paths asserted that a completed G2 answer keeps the G1 import carriers. That assertion could only ever pass because the union supplied them: this witness's own closure does not contain the carrier homes its fixture facts name, so fn_arrow_decl_facts_live() — entry-closure scoped — returns no declarations for them, and no reachable-invocation evidence for that subject exists in this context at all. Remove the union and the same subject silently answers LocalRead, which is UNDER-selection: the floor would skip a witness that reads the tree, and a skipped witness looks like a faster green floor rather than a failure. The union was therefore masking absent evidence, not carrying a real fact.

The three controls below separate the states the single union test conflated: evidence present and negative (local), evidence absent (refuse), evidence present and imprecise (conservative runtime read). Planted declarations supply the coverage the live entry-closure cannot, so complete-facts cases are reachable here rather than waiting on the whole-tree manifest."

fn selection_atom_node(lexeme: String) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: symbol_intern_lexeme(lexeme: lexeme) } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn selection_body_node(callee: String) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [ Edge { label: Positional, target: selection_atom_node(lexeme: callee) } ],
    occurrence_id: SyntheticOccurrence
  }
}

data selection_control_facts: List<ModuleImportFact> = [
  ModuleImportFact {
    module: "synthetic.live_read_selection.entry",
    imports: [ "v2.compiler.self_host" ]
  },
  ModuleImportFact { module: "v2.compiler.self_host", imports: [] }
]

fn selection_entry_seed_decl() -> FnArrowDecl {
  FnArrowDecl {
    qualified_name: "synthetic.live_read_selection.entry.seed",
    name: "seed",
    output: selection_body_node(callee: "carrier_fn"),
    params: []
  }
}

fn selection_carrier_home_decl(callee: String) -> FnArrowDecl {
  FnArrowDecl {
    qualified_name: "v2.compiler.self_host.carrier_fn",
    name: "carrier_fn",
    output: selection_body_node(callee: callee),
    params: []
  }
}

fn selection_projection_over(decls: List<FnArrowDecl>) -> LiveReadSelectionProjection {
  live_read_selection_projection_from_facts(
    entry_module: "synthetic.live_read_selection.entry",
    facts: selection_control_facts,
    decls: decls,
    carrier_homes: live_read_carrier_homes_v0
  )
}

fn projection_is_refused(p: LiveReadSelectionProjection) -> Bool {
  match p {
    LiveReadSelectionRefused { cause: c } => !string_is_empty(s: c)
    LiveReadSelectionClassified { classification: k } => classification_is_local(classification: k) && false
  }
}

fn projection_classification_is_local(p: LiveReadSelectionProjection) -> Bool {
  match p {
    LiveReadSelectionRefused { cause: _ } => false
    LiveReadSelectionClassified { classification: c } => classification_is_local(classification: c)
  }
}

fn projection_classification_has_runtime_read(p: LiveReadSelectionProjection) -> Bool {
  match p {
    LiveReadSelectionRefused { cause: _ } => false
    LiveReadSelectionClassified { classification: c } =>
      classification_has_runtime_read(classification: c)
  }
}

test fn g2_complete_facts_reachable_home_without_carrier_call_is_local() -> Bool {
  projection_classification_is_local(
    p: selection_projection_over(
      decls: [
        selection_entry_seed_decl(),
        selection_carrier_home_decl(callee: "string_concat")
      ]
    )
  )
}



test fn g2_missing_carrier_home_facts_refuse_rather_than_local() -> Bool {
  projection_is_refused(p: selection_projection_over(decls: [ selection_entry_seed_decl() ]))
}

test fn g2_reachable_carrier_call_with_unknown_argument_is_runtime_read() -> Bool {
  projection_classification_has_runtime_read(
    p: selection_projection_over(
      decls: [
        selection_entry_seed_decl(),
        selection_carrier_home_decl(callee: "filesystem_read")
      ]
    )
  )
}

data grouped_index_equivalence_law: String = "THE GROUPED INDEX MUST ANSWER THE SAME BAG THE FULL SCAN ANSWERED, and the discriminating fixture is homonyms across nested modules. Three declarations share the name lookup_row: one in module a, one in module b, one in module b.child. A last-wins index keeps exactly one of them, so it reds here while passing every claim about which keys exist. And because module b's prefix contains b.child, the closure filter can legitimately return the same declaration under two module rows - which is why the claim is a BAG equality against the reference scan rather than a set equality, and why the reference implementation is spelled out here instead of asserted from a remembered count."

fn planted_named_decl(qualified: String) -> FnArrowDecl {
  FnArrowDecl {
    qualified_name: qualified,
    name: "lookup_row",
    output: selection_body_node(callee: "string_concat"),
    params: []
  }
}

data planted_homonym_decls: List<FnArrowDecl> = [
  planted_named_decl(qualified: "a.lookup_row"),
  planted_named_decl(qualified: "b.lookup_row"),
  planted_named_decl(qualified: "b.child.lookup_row"),
  FnArrowDecl {
    qualified_name: "a.unrelated",
    name: "unrelated",
    output: selection_body_node(callee: "string_concat"),
    params: []
  }
]

data planted_closure_modules: List<String> = ["a", "b", "b.child"]

fn reference_decls_matching_callee(
  decls: List<FnArrowDecl>,
  modules: List<String>,
  callee: String
) -> List<FnArrowDecl> {
  filter(
    xs: decls_in_modules(decls: decls, modules: modules),
    predicate: fn(decl) { decl.name == callee }
  )
}

fn qualified_names_of(decls: List<FnArrowDecl>) -> List<String> {
  list_map(xs: decls, f: fn(d) { d.qualified_name })
}

fn grouped_matches(callee: String) -> List<String> {
  qualified_names_of(
    decls: decls_matching_callee(
      index: g2_decl_index(decls: planted_homonym_decls),
      closure_modules: planted_closure_modules,
      callee: callee
    )
  )
}

fn reference_matches(callee: String) -> List<String> {
  qualified_names_of(
    decls: reference_decls_matching_callee(
      decls: planted_homonym_decls,
      modules: planted_closure_modules,
      callee: callee
    )
  )
}

test fn grouped_callee_lookup_answers_the_reference_scans_bag() -> Bool {
  grouped_matches(callee: "lookup_row") == reference_matches(callee: "lookup_row")
    && grouped_matches(callee: "unrelated") == reference_matches(callee: "unrelated")
    && grouped_matches(callee: "absent_name") == reference_matches(callee: "absent_name")
}

test fn every_planted_homonym_survives_the_grouped_lookup() -> Bool {
  contains(xs: grouped_matches(callee: "lookup_row"), item: "a.lookup_row", eq: string_eq_local)
    && contains(xs: grouped_matches(callee: "lookup_row"), item: "b.lookup_row", eq: string_eq_local)
    && contains(xs: grouped_matches(callee: "lookup_row"), item: "b.child.lookup_row", eq: string_eq_local)
}

data adjacency_hoist_fixture_nodes: List<ModuleDeclarationFact> = [
  ModuleDeclarationFact { module: "synthetic.adjacency.entry", path: "synthetic/entry.dag" },
  ModuleDeclarationFact { module: "synthetic.adjacency.carrier", path: "synthetic/carrier.dag" }
]

data adjacency_hoist_fixture_edges: List<ModuleDependencyEdge> = [
  ModuleDependencyEdge {
    path: "synthetic/entry.dag",
    target_module: "synthetic.adjacency.carrier",
    target_declared: true
  }
]

data adjacency_hoist_fixture_decls: List<FnArrowDecl> = [
  FnArrowDecl {
    qualified_name: "synthetic.adjacency.entry.reads",
    name: "reads",
    output: selection_body_node(callee: "carrier_fn"),
    params: []
  },
  FnArrowDecl {
    qualified_name: "synthetic.adjacency.entry.pure",
    name: "pure",
    output: selection_body_node(callee: "string_concat"),
    params: []
  },
  FnArrowDecl {
    qualified_name: "synthetic.adjacency.carrier.carrier_fn",
    name: "carrier_fn",
    output: selection_body_node(callee: "filesystem_read"),
    params: []
  }
]

test fn adjacency_hoist_preserves_declaration_grain_and_manifest_order() -> Bool {
  let adjacency = build_dependency_adjacency(
    edges: adjacency_hoist_fixture_edges,
    nodes: adjacency_hoist_fixture_nodes
  )
  let rows = live_read_selection_manifest_over(
    requests: [
      LiveReadSelectionRequest { entry_path: "synthetic/entry.dag", fn_name: "reads" },
      LiveReadSelectionRequest { entry_path: "synthetic/entry.dag", fn_name: "pure" }
    ],
    subject: WholeTreeFactSubject,
    edges: adjacency_hoist_fixture_edges,
    nodes: adjacency_hoist_fixture_nodes,
    decls: adjacency_hoist_fixture_decls
  )
  dependency_closure(
    entry_path: "synthetic/entry.dag",
    edges: adjacency_hoist_fixture_edges,
    nodes: adjacency_hoist_fixture_nodes
  ) == dependency_closure_from_adjacency(
    entry_path: "synthetic/entry.dag",
    adjacency: adjacency
  )
    && list_map(xs: rows, f: fn(r) { r.key }) == [
    "synthetic/entry.dag::reads",
    "synthetic/entry.dag::pure"
  ]
    && list_map(xs: rows, f: fn(r) {
      projection_classification_has_runtime_read(p: r.projection)
    }) == [true, false]
}

fn string_eq_local(a: String, b: String) -> Bool {
  a == b
}
