data fixture_two_hop_closure: List<String> = ["fix.entry", "fix.mid", "fix.std_logic", "fix.corpus_reader"]

data fixture_roster_gate_closure: List<String> = ["fix.witness", "fix.roster_gate", "fix.std_logic"]

data fixture_scope_closure: List<String> = ["fix.lever_entry", "fix.compile_scope"]

data fixture_two_hop_facts: List<ModuleImportFact> = [
  ModuleImportFact { module: "fix.entry", imports: ["fix.mid", "fix.std_logic"] },
  ModuleImportFact { module: "fix.mid", imports: ["fix.corpus_reader"] },
  ModuleImportFact { module: "fix.corpus_reader", imports: [] }
]

data fixture_severed_facts: List<ModuleImportFact> = [
  ModuleImportFact { module: "fix.entry", imports: ["fix.mid", "fix.std_logic"] },
  ModuleImportFact { module: "fix.mid", imports: [] },
  ModuleImportFact { module: "fix.corpus_reader", imports: [] }
]

data fixture_roster_gate_facts: List<ModuleImportFact> = [
  ModuleImportFact { module: "fix.witness", imports: ["fix.roster_gate", "fix.std_logic"] },
  ModuleImportFact { module: "fix.roster_gate", imports: [] }
]

