fn verdict_of(closure: List<String>) -> LiveReadClassification {
  live_read_classification(closure_modules: closure, carrier_homes: fixture_carriers)
}

test fn unit_closure_is_local_read() -> Bool {
  classification_is_local(classification: verdict_of(closure: fixture_unit_closure))
}

test fn two_hop_decl_facts_carrier_is_runtime_read() -> Bool {
  classification_has_runtime_read(classification: verdict_of(closure: fixture_two_hop_closure))
    && classification_has_corpus_scan_carrier(classification: verdict_of(closure: fixture_two_hop_closure))
}

test fn roster_gate_import_is_filesystem_runtime_read() -> Bool {
  classification_has_filesystem_read_carrier(classification: verdict_of(closure: fixture_roster_gate_closure))
    && !classification_has_corpus_scan_carrier(classification: verdict_of(closure: fixture_roster_gate_closure))
}

test fn compile_scope_import_is_corpus_scan_runtime_read() -> Bool {
  classification_has_corpus_scan_carrier(classification: verdict_of(closure: fixture_scope_closure))
}

test fn two_hop_facts_classify_as_runtime_read() -> Bool {
  classification_has_runtime_read(
    classification: live_read_classification_from_facts(
      entry_module: "fix.entry",
      facts: fixture_two_hop_facts,
      carrier_homes: fixture_carriers
    )
  )
}

test fn severed_mid_hop_is_local_read() -> Bool {
  classification_is_local(
    classification: live_read_classification_from_facts(
      entry_module: "fix.entry",
      facts: fixture_severed_facts,
      carrier_homes: fixture_carriers
    )
  )
}

test fn roster_gate_facts_classify_filesystem_carrier() -> Bool {
  let c = live_read_classification_from_facts(
    entry_module: "fix.witness",
    facts: fixture_roster_gate_facts,
    carrier_homes: fixture_carriers
  )
  classification_has_filesystem_read_carrier(classification: c)
}

test fn red_control_roster_gate_severed_is_local() -> Bool {
  classification_is_local(
    classification: live_read_classification_from_facts(
      entry_module: "fix.witness",
      facts: fixture_roster_gate_severed_facts,
      carrier_homes: fixture_carriers
