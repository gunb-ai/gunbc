  LiveReadCarrierHome { module: "fix.corpus_reader", kind: DeclFactsReflectionCarrier },
  LiveReadCarrierHome { module: "fix.roster_gate", kind: FilesystemReadCarrier },
  LiveReadCarrierHome { module: "fix.compile_scope", kind: ModuleDeclarationFactsCarrier }
]

