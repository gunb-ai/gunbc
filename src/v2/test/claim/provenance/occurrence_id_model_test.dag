module v2.test.provenance.occurrence_id_model


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn occurrence_id_allocator_mints_sequential_distinct_ids() -> Bool {
  let alloc0 = std.occurrence_identity.occurrence_id_allocator_initial()
  let r0 = std.occurrence_identity.alloc_occurrence_id(alloc: alloc0)
  let r1 = std.occurrence_identity.alloc_occurrence_id(alloc: r0.alloc)
  let r2 = std.occurrence_identity.alloc_occurrence_id(alloc: r1.alloc)
  !std.occurrence_identity.occurrence_id_eq(left: r0.id, right: r1.id)
    && !std.occurrence_identity.occurrence_id_eq(left: r1.id, right: r2.id)
    && !std.occurrence_identity.occurrence_id_eq(left: r0.id, right: r2.id)
}

test fn span_index_from_source_round_trip_holds() -> Bool {
  let alloc0 = std.occurrence_identity.occurrence_id_allocator_initial()
  let minted = std.occurrence_identity.alloc_occurrence_id(alloc: alloc0)
  let id = minted.id
  let locus = v2.std.diagnostic.Textual {
    file: ^occurrence_model_file,
    extent: v2.std.diagnostic.ByteRange { start: 0, end: 12 }
  }
  let event = v2.std.provenance.origin_event_from_source(locus: locus)
  let index = v2.std.provenance.span_index_record(
    index: v2.std.provenance.span_index_empty(),
    id: id,
    event: event
  )
  match v2.std.provenance.span_index_lookup(index: index, id: id) {
    v2.std.witness.Holds { value: got } =>
      match got {
        v2.std.provenance.FromSource { locus: got_locus } =>
          match got_locus {
            v2.std.diagnostic.Textual { file: f, extent: ext } =>
              (f == ^occurrence_model_file)
                && match ext {
                  v2.std.diagnostic.ByteRange { start: s, end: e } => (s == 0) && (e == 12)
                  v2.std.diagnostic.WholeFile => false
                }
            v2.std.diagnostic.NodeLocus { anchor: _ } => false
            v2.std.diagnostic.PortLocus { anchor: _ } => false
          }
        v2.std.provenance.DerivedBy { producer: _, from: _ } => false
        GeneratedBy { generator: _, from: _ } => false
      }
    v2.std.witness.Violates { diagnostic: _ } => false
  }
}

fn span_index_merge_lookup_from_source_holds(index: v2.std.provenance.SpanIndex, id: OccurrenceId) -> Bool {
  match v2.std.provenance.span_index_lookup(index: index, id: id) {
    v2.std.witness.Holds { value: event } =>
      match event {
        v2.std.provenance.FromSource { locus: locus } =>
          match locus {
            v2.std.diagnostic.Textual { file: f, extent: v2.std.diagnostic.ByteRange { start: start, end: end_byte } } =>
              (f == ^occurrence_model_file) && (start >= 0) && (end_byte > start)
            _ => false
          }
        _ => false
      }
    v2.std.witness.Violates { diagnostic: _ } => false
  }
}

test fn span_index_merge_disjoint_entries_holds() -> Bool {
  let alloc0 = std.occurrence_identity.occurrence_id_allocator_initial()
  let r0 = std.occurrence_identity.alloc_occurrence_id(alloc: alloc0)
  let r1 = std.occurrence_identity.alloc_occurrence_id(alloc: r0.alloc)
  let locus0 = v2.std.diagnostic.Textual {
    file: ^occurrence_model_file,
    extent: v2.std.diagnostic.ByteRange { start: 0, end: 4 }
  }
  let locus1 = v2.std.diagnostic.Textual {
    file: ^occurrence_model_file,
    extent: v2.std.diagnostic.ByteRange { start: 4, end: 8 }
  }
  let left = v2.std.provenance.span_index_record(
    index: v2.std.provenance.span_index_empty(),
    id: r0.id,
    event: v2.std.provenance.origin_event_from_source(locus: locus0)
  )
  let right = v2.std.provenance.span_index_record(
    index: v2.std.provenance.span_index_empty(),
    id: r1.id,
    event: v2.std.provenance.origin_event_from_source(locus: locus1)
  )
  let merged = v2.std.provenance.span_index_merge(base: left, incoming: right)
  span_index_merge_lookup_from_source_holds(index: merged, id: r0.id)
    && span_index_merge_lookup_from_source_holds(index: merged, id: r1.id)
}

test fn span_index_resolve_derived_chain_holds() -> Bool {
  let alloc0 = std.occurrence_identity.occurrence_id_allocator_initial()
  let r0 = std.occurrence_identity.alloc_occurrence_id(alloc: alloc0)
  let r1 = std.occurrence_identity.alloc_occurrence_id(alloc: r0.alloc)
  let locus0 = v2.std.diagnostic.Textual {
    file: ^occurrence_model_file,
    extent: v2.std.diagnostic.ByteRange { start: 0, end: 12 }
  }
  let index0 = v2.std.provenance.span_index_record(
    index: v2.std.provenance.span_index_empty(),
    id: r0.id,
    event: v2.std.provenance.origin_event_from_source(locus: locus0)
  )
  let index1 = v2.std.provenance.span_index_record(
    index: index0,
    id: r1.id,
    event: v2.std.provenance.DerivedBy { producer: ^occurrence_model_derive_producer, from: [r0.id] }
  )
  match v2.std.provenance.span_index_resolve_textual_locus(index: index1, id: r1.id) {
    v2.std.witness.Holds { value: locus } =>
      match locus {
        v2.std.diagnostic.Textual { file: f, extent: v2.std.diagnostic.ByteRange { start: s, end: e } } =>
          (f == ^occurrence_model_file) && (s == 0) && (e == 12)
        _ => false
      }
    v2.std.witness.Violates { diagnostic: _ } => false
  }
}

test fn occurrence_id_root_mint_excluded_from_structural_equality() -> Bool {
  let alloc0 = std.occurrence_identity.occurrence_id_allocator_initial()
  let m0 = std.occurrence_identity.alloc_occurrence_id(alloc: alloc0)
  let m1 = std.occurrence_identity.alloc_occurrence_id(alloc: m0.alloc)
  let child = v2.std.node.node_synthetic(
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^occurrence_eq_child } },
    children: []
  )
  let left = v2.std.node.node_with_occurrence_id(
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [v2.std.node.Edge { label: v2.std.node.Positional, target: child }],
    occurrence_id: v2.std.node.node_occurrence_minted(id: m0.id)
  )
  let right = v2.std.node.node_with_occurrence_id(
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [v2.std.node.Edge { label: v2.std.node.Positional, target: child }],
    occurrence_id: v2.std.node.node_occurrence_minted(id: m1.id)
  )
  !std.occurrence_identity.occurrence_id_eq(left: m0.id, right: m1.id)
    && !(left == right)
    && v2.std.exact_structural_equality_zip_fold_predicate.exact_structural_equality_zip_fold(source_facts: left, candidate: right)
}

test fn occurrence_id_nested_mint_excluded_from_structural_equality() -> Bool {
  let alloc0 = std.occurrence_identity.occurrence_id_allocator_initial()
  let m0 = std.occurrence_identity.alloc_occurrence_id(alloc: alloc0)
  let m1 = std.occurrence_identity.alloc_occurrence_id(alloc: m0.alloc)
  let child_left = v2.std.node.node_with_occurrence_id(
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^occurrence_eq_child } },
    children: [],
    occurrence_id: v2.std.node.node_occurrence_minted(id: m0.id)
  )
  let child_right = v2.std.node.node_with_occurrence_id(
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^occurrence_eq_child } },
    children: [],
    occurrence_id: v2.std.node.node_occurrence_minted(id: m1.id)
  )
  let left = v2.std.node.node_synthetic(
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [v2.std.node.Edge { label: v2.std.node.Positional, target: child_left }]
  )
  let right = v2.std.node.node_synthetic(
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [v2.std.node.Edge { label: v2.std.node.Positional, target: child_right }]
  )
  !std.occurrence_identity.occurrence_id_eq(left: m0.id, right: m1.id)
    && !(left == right)
    && v2.std.exact_structural_equality_zip_fold_predicate.exact_structural_equality_zip_fold(source_facts: left, candidate: right)
    && !(v2.std.node.node_for_structural_equality(n: left) == v2.std.node.node_for_structural_equality(n: right))
}

