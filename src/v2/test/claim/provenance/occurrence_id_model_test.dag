module v2.test.provenance.occurrence_id_model

import v2.std.diagnostic { ByteRange, NodeLocus, PortLocus, Textual, WholeFile }
import v2.std.exact_structural_equality_zip_fold_predicate {
  exact_structural_equality_zip_fold
}
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Node,
  Positional,
  Symbol,
  TypeNode,
  node_for_structural_equality,
  node_occurrence_minted,
  node_synthetic,
  node_with_occurrence_id
}
import v2.std.occurrence_id {
  alloc_occurrence_id,
  occurrence_id_allocator_initial,
  occurrence_id_eq
}
import v2.std.provenance {
  DerivedBy,
  FromSource,
  SpanIndex,
  origin_event_from_source,
  span_index_empty,
  span_index_lookup,
  span_index_merge,
  span_index_record,
  span_index_resolve_textual_locus
}
import v2.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}
import v2.std.witness { Holds, Violates }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn occurrence_id_allocator_mints_sequential_distinct_ids() -> Bool {
  let alloc0 = occurrence_id_allocator_initial()
  let r0 = alloc_occurrence_id(alloc: alloc0)
  let r1 = alloc_occurrence_id(alloc: r0.alloc)
  let r2 = alloc_occurrence_id(alloc: r1.alloc)
  !occurrence_id_eq(left: r0.id, right: r1.id)
    && !occurrence_id_eq(left: r1.id, right: r2.id)
    && !occurrence_id_eq(left: r0.id, right: r2.id)
}

test fn span_index_from_source_round_trip_holds() -> Bool {
  let alloc0 = occurrence_id_allocator_initial()
  let minted = alloc_occurrence_id(alloc: alloc0)
  let id = minted.id
  let locus = Textual {
    file: ^occurrence_model_file,
    extent: ByteRange { start: 0, end: 12 }
  }
  let event = origin_event_from_source(locus: locus)
  let index = span_index_record(
    index: span_index_empty(),
    id: id,
    event: event
  )
  match span_index_lookup(index: index, id: id) {
    Holds { value: got } =>
      match got {
        FromSource { locus: got_locus } =>
          match got_locus {
            Textual { file: f, extent: ext } =>
              (f == ^occurrence_model_file)
                && match ext {
                  ByteRange { start: s, end: e } => (s == 0) && (e == 12)
                  WholeFile => false
                }
            NodeLocus { anchor: _ } => false
            PortLocus { anchor: _ } => false
          }
        DerivedBy { producer: _, from: _ } => false
        GeneratedBy { generator: _, from: _ } => false
      }
    Violates { diagnostic: _ } => false
  }
}

fn span_index_merge_lookup_from_source_holds(index: SpanIndex, id: OccurrenceId) -> Bool {
  match span_index_lookup(index: index, id: id) {
    Holds { value: event } =>
      match event {
        FromSource { locus: locus } =>
          match locus {
            Textual { file: f, extent: ByteRange { start: start, end: end_byte } } =>
              (f == ^occurrence_model_file) && (start >= 0) && (end_byte > start)
            _ => false
          }
        _ => false
      }
    Violates { diagnostic: _ } => false
  }
}

test fn span_index_merge_disjoint_entries_holds() -> Bool {
  let alloc0 = occurrence_id_allocator_initial()
  let r0 = alloc_occurrence_id(alloc: alloc0)
  let r1 = alloc_occurrence_id(alloc: r0.alloc)
  let locus0 = Textual {
    file: ^occurrence_model_file,
    extent: ByteRange { start: 0, end: 4 }
  }
  let locus1 = Textual {
    file: ^occurrence_model_file,
    extent: ByteRange { start: 4, end: 8 }
  }
  let left = span_index_record(
    index: span_index_empty(),
    id: r0.id,
    event: origin_event_from_source(locus: locus0)
  )
  let right = span_index_record(
    index: span_index_empty(),
    id: r1.id,
    event: origin_event_from_source(locus: locus1)
  )
  let merged = span_index_merge(base: left, incoming: right)
  span_index_merge_lookup_from_source_holds(index: merged, id: r0.id)
    && span_index_merge_lookup_from_source_holds(index: merged, id: r1.id)
}

test fn span_index_resolve_derived_chain_holds() -> Bool {
  let alloc0 = occurrence_id_allocator_initial()
  let r0 = alloc_occurrence_id(alloc: alloc0)
  let r1 = alloc_occurrence_id(alloc: r0.alloc)
  let locus0 = Textual {
    file: ^occurrence_model_file,
    extent: ByteRange { start: 0, end: 12 }
  }
  let index0 = span_index_record(
    index: span_index_empty(),
    id: r0.id,
    event: origin_event_from_source(locus: locus0)
  )
  let index1 = span_index_record(
    index: index0,
    id: r1.id,
    event: DerivedBy { producer: ^occurrence_model_derive_producer, from: [r0.id] }
  )
  match span_index_resolve_textual_locus(index: index1, id: r1.id) {
    Holds { value: locus } =>
      match locus {
        Textual { file: f, extent: ByteRange { start: s, end: e } } =>
          (f == ^occurrence_model_file) && (s == 0) && (e == 12)
        _ => false
      }
    Violates { diagnostic: _ } => false
  }
}

test fn occurrence_id_root_mint_excluded_from_structural_equality() -> Bool {
  let alloc0 = occurrence_id_allocator_initial()
  let m0 = alloc_occurrence_id(alloc: alloc0)
  let m1 = alloc_occurrence_id(alloc: m0.alloc)
  let child = node_synthetic(
    kind: TypeNode { connective: Atom { identity: ^occurrence_eq_child } },
    children: []
  )
  let left = node_with_occurrence_id(
    kind: TypeNode { connective: Conj },
    children: [Edge { label: Positional, target: child }],
    occurrence_id: node_occurrence_minted(id: m0.id)
  )
  let right = node_with_occurrence_id(
    kind: TypeNode { connective: Conj },
    children: [Edge { label: Positional, target: child }],
    occurrence_id: node_occurrence_minted(id: m1.id)
  )
  !occurrence_id_eq(left: m0.id, right: m1.id)
    && !(left == right)
    && exact_structural_equality_zip_fold(source_facts: left, candidate: right)
}

test fn occurrence_id_nested_mint_excluded_from_structural_equality() -> Bool {
  let alloc0 = occurrence_id_allocator_initial()
  let m0 = alloc_occurrence_id(alloc: alloc0)
  let m1 = alloc_occurrence_id(alloc: m0.alloc)
  let child_left = node_with_occurrence_id(
    kind: TypeNode { connective: Atom { identity: ^occurrence_eq_child } },
    children: [],
    occurrence_id: node_occurrence_minted(id: m0.id)
  )
  let child_right = node_with_occurrence_id(
    kind: TypeNode { connective: Atom { identity: ^occurrence_eq_child } },
    children: [],
    occurrence_id: node_occurrence_minted(id: m1.id)
  )
  let left = node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [Edge { label: Positional, target: child_left }]
  )
  let right = node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [Edge { label: Positional, target: child_right }]
  )
  !occurrence_id_eq(left: m0.id, right: m1.id)
    && !(left == right)
    && exact_structural_equality_zip_fold(source_facts: left, candidate: right)
    && !(node_for_structural_equality(n: left) == node_for_structural_equality(n: right))
}

