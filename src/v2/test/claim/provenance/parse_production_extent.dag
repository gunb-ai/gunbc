module v2.test.claim.provenance.parse_production_extent

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE CONTROL roadmap node parse-node-source-extent names: a position between a block's last
// statement and its closing brace is INSIDE the block, and a position after the brace is OUTSIDE.
// The block is `{ stmt }` with a gap after the statement, tokens at 0..1, 4..9 and 20..21. A
// recorded extent that stopped at the last child (9) would put position 15 outside the block, so
// the exact 0..21 assertion is what goes RED on that defect. Its consumer is the comment-gap
// attachment of roadmap node parse-comment-gap-attachment, which reads span_index_extent.

fn parse_extent_token(class: Symbol, start: Int, end: Int) -> Token {
  Token {
    class: class,
    lexeme: std.algebra.Empty,
    file: ^parse_extent_file,
    start: start,
    end: end
  }
}

fn parse_extent_block_root() -> GrammarRoot {
  GrammarRoot {
    start: ^parse_extent_block,
    productions: Cons {
      head: GrammarProduction {
        name: ^parse_extent_block,
        expression: Sequence {
          left: Sequence {
            left: Terminal { token_class: ^parse_extent_lbrace, stamp: StampClass },
            right: Nonterminal { production: ^parse_extent_stmt }
          },
          right: Terminal { token_class: ^parse_extent_rbrace, stamp: StampClass }
        },
        emitted: grammar_atom(identity: ^parse_extent_block)
      },
      tail: Cons {
        head: GrammarProduction {
          name: ^parse_extent_stmt,
          expression: Terminal { token_class: ^parse_extent_stmt_tok, stamp: StampClass },
          emitted: grammar_atom(identity: ^parse_extent_stmt)
        },
        tail: std.algebra.Empty
      }
    },
    sync_tokens: grammar_empty_sync_tokens()
  }
}

// A nullable production that matches empty consumes no token, so it has no extent to publish.
fn parse_extent_nullable_root() -> GrammarRoot {
  GrammarRoot {
    start: ^parse_extent_block,
    productions: Cons {
      head: GrammarProduction {
        name: ^parse_extent_block,
        expression: Sequence {
          left: Nonterminal { production: ^parse_extent_stmt },
          right: Terminal { token_class: ^parse_extent_rbrace, stamp: StampClass }
        },
        emitted: grammar_atom(identity: ^parse_extent_block)
      },
      tail: Cons {
        head: GrammarProduction {
          name: ^parse_extent_stmt,
          expression: Optional { element: Terminal { token_class: ^parse_extent_stmt_tok, stamp: StampClass } },
          emitted: grammar_atom(identity: ^parse_extent_stmt)
        },
        tail: std.algebra.Empty
      }
    },
    sync_tokens: grammar_empty_sync_tokens()
  }
}

fn parse_extent_block_tokens() -> List<Token> {
  Cons {
    head: parse_extent_token(class: ^parse_extent_lbrace, start: 0, end: 1),
    tail: Cons {
      head: parse_extent_token(class: ^parse_extent_stmt_tok, start: 4, end: 9),
      tail: Cons {
        head: parse_extent_token(class: ^parse_extent_rbrace, start: 20, end: 21),
        tail: std.algebra.Empty
      }
    }
  }
}

fn parse_extent_parse(root: GrammarRoot, tokens: List<Token>) -> Outcome<v2.compiler.parse.ParseArtifact> {
  let at = invariant_port_locus(port: ^parse_stage_locus_port, invariant: ^parse_production_extent_test_grammar_contract)
  match grammar_validate_for_parse(root: root, at: at) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: validated, diagnostics: _ } =>
      parse_production(tokens: tokens, validated: validated, production_name: ^parse_extent_block)
  }
}

// THE RECORDED EXTENT OF `node`, judged against an expected range and two probe positions: `inside`
// must fall in [start, end) and `outside` must not. False when no extent was recorded.
fn parse_extent_holds(index: SpanIndex, node: Node, start: Int, end: Int, inside: Int, outside: Int) -> Bool {
  match node.occurrence_id {
    OccurrenceMinted { id: id } =>
      match span_index_extent(index: index, id: id) {
        Absent => false
        Present { value: recorded } =>
          match recorded {
            SourceExtentUnrepresentable => false
            SourceExtentKnown { locus: locus } =>
          match locus {
            Textual { file: f, extent: ext } =>
              (f == ^parse_extent_file)
                && match ext {
                  ByteRange { start: s, end: e } =>
                    (s == start) && (e == end)
                      && (s <= inside) && (inside < e)
                      && !((s <= outside) && (outside < e))
                  WholeFile => false
                }
            _ => false
          }
          }
      }
    OccurrenceSynthetic => false
    OccurrenceProjected { id: _, caused_by: _ } => false
    OccurrencePending { caused_by: _ } => false
  }
}

// The node consumed input no single range covers: recorded Unrepresentable, never Absent.
fn parse_extent_unrepresentable(index: SpanIndex, node: Node) -> Bool {
  match node.occurrence_id {
    OccurrenceMinted { id: id } =>
      match span_index_extent(index: index, id: id) {
        Present { value: recorded } =>
          match recorded {
            SourceExtentUnrepresentable => true
            SourceExtentKnown { locus: _ } => false
          }
        Absent => false
      }
    OccurrenceSynthetic => false
    OccurrenceProjected { id: _, caused_by: _ } => false
    OccurrencePending { caused_by: _ } => false
  }
}

fn parse_extent_absent(index: SpanIndex, node: Node) -> Bool {
  match node.occurrence_id {
    OccurrenceMinted { id: id } =>
      match span_index_extent(index: index, id: id) {
        Absent => true
        Present { value: _ } => false
      }
    OccurrenceSynthetic => false
    OccurrenceProjected { id: _, caused_by: _ } => false
    OccurrencePending { caused_by: _ } => false
  }
}

// The block node's recorded extent runs to the end of its closing brace; the gap before the brace
// (15) is inside it and the position after the brace (25) is not.
test fn block_extent_reaches_its_closing_brace_holds() -> Bool {
  match parse_extent_parse(root: parse_extent_block_root(), tokens: parse_extent_block_tokens()) {
    Rejected { diagnostics: _ } => false
    Accepted { value: artifact, diagnostics: _ } =>
      parse_extent_holds(index: artifact.span_index, node: artifact.tree, start: 0, end: 21, inside: 15, outside: 25)
  }
}

// The inner statement production records only its own token, so the gap after it (15) is outside
// it: the extent is the production's consumed range, not its parent's.
test fn inner_production_extent_is_its_own_consumed_range_holds() -> Bool {
  match parse_extent_parse(root: parse_extent_block_root(), tokens: parse_extent_block_tokens()) {
    Rejected { diagnostics: _ } => false
    Accepted { value: artifact, diagnostics: _ } =>
      match find_named_child(root: artifact.tree, name: ^grammar_production_captured_node_projection) {
        Rejected { diagnostics: _ } => false
        Accepted { value: outer_seq, diagnostics: _ } =>
          match find_named_child(root: outer_seq, name: ^grammar_sequence_left_node_projection) {
            Rejected { diagnostics: _ } => false
            Accepted { value: inner_seq, diagnostics: _ } =>
              match find_named_child(root: inner_seq, name: ^grammar_sequence_right_node_projection) {
                Rejected { diagnostics: _ } => false
                Accepted { value: stmt, diagnostics: _ } =>
                  parse_extent_holds(index: artifact.span_index, node: stmt, start: 4, end: 9, inside: 5, outside: 15)
              }
          }
      }
  }
}

// A production that matched empty publishes no extent, rather than a zero-width range at a guessed
// position; the enclosing production still records its own.
test fn empty_production_records_no_extent_holds() -> Bool {
  match parse_extent_parse(
    root: parse_extent_nullable_root(),
    tokens: Cons { head: parse_extent_token(class: ^parse_extent_rbrace, start: 2, end: 3), tail: std.algebra.Empty }
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: artifact, diagnostics: _ } =>
      match find_named_child(root: artifact.tree, name: ^grammar_production_captured_node_projection) {
        Rejected { diagnostics: _ } => false
        Accepted { value: seq, diagnostics: _ } =>
          match find_named_child(root: seq, name: ^grammar_sequence_left_node_projection) {
            Rejected { diagnostics: _ } => false
            Accepted { value: empty_stmt, diagnostics: _ } =>
              parse_extent_absent(index: artifact.span_index, node: empty_stmt)
                && parse_extent_holds(index: artifact.span_index, node: artifact.tree, start: 2, end: 3, inside: 2, outside: 3)
          }
      }
  }
}

fn parse_extent_single_production_root(expression: GrammarExpr) -> GrammarRoot {
  GrammarRoot {
    start: ^parse_extent_block,
    productions: Cons {
      head: GrammarProduction {
        name: ^parse_extent_block,
        expression: expression,
        emitted: grammar_atom(identity: ^parse_extent_block)
      },
      tail: std.algebra.Empty
    },
    sync_tokens: grammar_empty_sync_tokens()
  }
}

fn parse_extent_captured_holds(root: GrammarRoot, tokens: List<Token>, start: Int, end: Int, inside: Int, outside: Int) -> Bool {
  match parse_extent_parse(root: root, tokens: tokens) {
    Rejected { diagnostics: _ } => false
    Accepted { value: artifact, diagnostics: _ } =>
      match find_named_child(root: artifact.tree, name: ^grammar_production_captured_node_projection) {
        Rejected { diagnostics: _ } => false
        Accepted { value: captured, diagnostics: _ } =>
          parse_extent_holds(index: artifact.span_index, node: captured, start: start, end: end, inside: inside, outside: outside)
      }
  }
}

// One operator application `a + b` is its own source occurrence: its extent runs from the left
// operand's start to the right operand's end, so the operator position (3) is inside it.
test fn infix_application_extent_spans_its_operands_holds() -> Bool {
  parse_extent_captured_holds(
    root: parse_extent_single_production_root(expression: InfixTable {
      operand: Terminal { token_class: ^parse_extent_stmt_tok, stamp: StampClass },
      continuation_guard: NotPredicate { element: Terminal { token_class: ^parse_extent_never, stamp: StampClass } },
      operators: Cons {
        head: InfixOperatorRow { token_class: ^parse_extent_plus, binding_power: 1, associativity: InfixLeft },
        tail: std.algebra.Empty
      }
    }),
    tokens: Cons {
      head: parse_extent_token(class: ^parse_extent_stmt_tok, start: 0, end: 1),
      tail: Cons {
        head: parse_extent_token(class: ^parse_extent_plus, start: 2, end: 3),
        tail: Cons {
          head: parse_extent_token(class: ^parse_extent_stmt_tok, start: 4, end: 5),
          tail: std.algebra.Empty
        }
      }
    },
    start: 0,
    end: 5,
    inside: 3,
    outside: 6
  )
}

// A repetition's extent runs from its first item to its last, so a gap between items (5) is inside
// it and a position after the last item (10) is not.
test fn repeat_extent_spans_its_items_holds() -> Bool {
  parse_extent_captured_holds(
    root: parse_extent_single_production_root(expression: Repeat {
      element: Terminal { token_class: ^parse_extent_stmt_tok, stamp: StampClass }
    }),
    tokens: Cons {
      head: parse_extent_token(class: ^parse_extent_stmt_tok, start: 0, end: 1),
      tail: Cons {
        head: parse_extent_token(class: ^parse_extent_stmt_tok, start: 3, end: 4),
        tail: Cons {
          head: parse_extent_token(class: ^parse_extent_stmt_tok, start: 8, end: 9),
          tail: std.algebra.Empty
        }
      }
    },
    start: 0,
    end: 9,
    inside: 5,
    outside: 10
  )
}

// A COMPOSITE WHOSE CHILDREN SPAN TWO FILES RECORDS NO EXTENT. Its closing brace comes from another
// file, so no single byte range covers it; the block records Unrepresentable -- distinct from the
// Absent of a node that consumed nothing -- rather than `{ stmt` alone or a range in one file that
// ends at an offset from the other.
test fn cross_file_children_record_no_extent_holds() -> Bool {
  let tokens = Cons {
    head: parse_extent_token(class: ^parse_extent_lbrace, start: 0, end: 1),
    tail: Cons {
      head: parse_extent_token(class: ^parse_extent_stmt_tok, start: 4, end: 9),
      tail: Cons {
        head: Token { class: ^parse_extent_rbrace, lexeme: std.algebra.Empty, file: ^parse_extent_other_file, start: 20, end: 21 },
        tail: std.algebra.Empty
      }
    }
  }
  match parse_extent_parse(root: parse_extent_block_root(), tokens: tokens) {
    Rejected { diagnostics: _ } => false
    Accepted { value: artifact, diagnostics: _ } => parse_extent_unrepresentable(index: artifact.span_index, node: artifact.tree)
  }
}

// THE REFUSAL PROPAGATES. With the foreign-file token in the MIDDLE, the inner `{ stmt` sequence is
// the one that cannot compose; it records itself unrepresentable, so the outer sequence and the
// production refuse too. Were the inner refusal read as an empty child, the root would publish the
// closing brace alone (20..21).
test fn unrepresentable_child_refuses_its_ancestors_holds() -> Bool {
  let tokens = Cons {
    head: parse_extent_token(class: ^parse_extent_lbrace, start: 0, end: 1),
    tail: Cons {
      head: Token { class: ^parse_extent_stmt_tok, lexeme: std.algebra.Empty, file: ^parse_extent_other_file, start: 4, end: 9 },
      tail: Cons {
        head: parse_extent_token(class: ^parse_extent_rbrace, start: 20, end: 21),
        tail: std.algebra.Empty
      }
    }
  }
  match parse_extent_parse(root: parse_extent_block_root(), tokens: tokens) {
    Rejected { diagnostics: _ } => false
    Accepted { value: artifact, diagnostics: _ } => parse_extent_unrepresentable(index: artifact.span_index, node: artifact.tree)
  }
}
