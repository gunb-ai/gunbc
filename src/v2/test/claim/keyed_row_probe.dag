module v2.test.claim.keyed_row_probe

import v2.test.claim.type_param_binder_frame { tpb_artifact, tpb_std_optional_witness, tpb_src_ingest, tpb_assemble_over, tpb_language }
import v2.compiler.resolve { ResolvedTree }
import v2.compiler.infer { infer }
import v2.compiler.source_authority { DagSourceReadWitness }
import v2.std.diagnostic { Accepted, Outcome, Rejected, diagnostics_has_reason }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.algebra { Cons }
import extdeps.communication.medium { Lossless, Medium }
import v2.std.cross_tree.import_model { V2Tree }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// std.types peer: Int and Bool become declarations a specimen reaches by import, so the clean
// control can be clean; without it Int is an ungrounded atom and every specimen carries the advisory.
fn kp_types_witness() -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: "module std.types\n\ntype Int\n\ntype Bool\n\ntype List<T>\n", fidelity: Lossless },
    artifact: tpb_artifact,
    compilation_unit: ^keyed_row_probe_types_cu,
    source_root: V2Tree
  }
}

fn kp_ingest(src: String) -> List<DagSourceReadWitness> {
  match tpb_src_ingest(src: src) {
    Cons { head: h, tail: t } => Cons { head: h, tail: Cons { head: tpb_std_optional_witness(), tail: Cons { head: kp_types_witness(), tail: t } } }
    other => other
  }
}

fn kp_assemble(src: String) -> Outcome<ResolvedTree> {
  match tpb_language {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: prep, diagnostics: _ } => tpb_assemble_over(ingest: kp_ingest(src: src), prep: prep)
  }
}

fn kp_resolved(src: String) -> Bool {
  match kp_assemble(src: src) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn kp_clean(src: String) -> Bool {
  match kp_assemble(src: src) {
    Rejected { diagnostics: _ } => false
    Accepted { value: tree, diagnostics: _ } =>
      match infer(tree: tree) {
        Rejected { diagnostics: _ } => false
        Accepted { value: _, diagnostics: d } => !diagnostics_has_reason(d: d, reason: ^infer_grounding_not_derived)
      }
  }
}

data kp_a: String = "module p\n\ntype B<T> {\n  low: T\n  high: T\n}\n\nfn d<T>(x: T) -> B<T> {\n  B { low: x, high: x }\n}\n"
data kp_a_ctl: String = "module p\n\nimport std.types { Int }\n\ntype B {\n  low: Int\n  high: Int\n}\n\nfn d(x: Int) -> B {\n  B { low: x, high: x }\n}\n"
data kp_b: String = "module p\n\nimport std.optional { Optional, Present }\n\nfn w<T>(v: T) -> Optional<T> {\n  Present { value: v }\n}\n"
data kp_b_ctl: String = "module p\n\nimport std.optional { Optional, Present }\nimport std.types { Int }\n\nfn w(v: Int) -> Optional<Int> {\n  Present { value: v }\n}\n"
data kp_c: String = "module p\n\nimport std.optional { Optional, Absent }\n\nfn n<T>(v: T) -> Optional<T> {\n  Absent\n}\n"
data kp_d: String = "module p\n\nimport std.optional { Optional, Present }\nimport std.types { Int }\n\ntype R<K, V> {\n  row_key: K\n  value: V\n}\n\nfn f<K, V>(a: R<K, V>, acc: Optional<R<K, V>>, hit: Int) -> Optional<R<K, V>> {\n  if hit == 1 {\n    Present { value: a }\n  } else {\n    acc\n  }\n}\n"

data kp_z: String = "module p\n\nimport std.types { Int }\n\nfn one(x: Int) -> Int {\n  x\n}\n"

fn kp_rejected(src: String) -> Bool {
  match kp_assemble(src: src) {
    Rejected { diagnostics: _ } => false
    Accepted { value: tree, diagnostics: _ } =>
      match infer(tree: tree) {
        Rejected { diagnostics: _ } => true
        Accepted { value: _, diagnostics: _ } => false
      }
  }
}

fn kp_advisory(src: String) -> Bool {
  match kp_assemble(src: src) {
    Rejected { diagnostics: _ } => false
    Accepted { value: tree, diagnostics: _ } =>
      match infer(tree: tree) {
        Rejected { diagnostics: _ } => false
        Accepted { value: _, diagnostics: d } => diagnostics_has_reason(d: d, reason: ^infer_grounding_not_derived)
      }
  }
}

test fn kp_z_rejected() -> Bool { kp_rejected(src: kp_z) }
test fn kp_z_advisory() -> Bool { kp_advisory(src: kp_z) }
test fn kp_a_rejected() -> Bool { kp_rejected(src: kp_a) }
test fn kp_a_advisory() -> Bool { kp_advisory(src: kp_a) }
test fn kp_a_ctl_rejected() -> Bool { kp_rejected(src: kp_a_ctl) }
test fn kp_a_ctl_advisory() -> Bool { kp_advisory(src: kp_a_ctl) }
test fn kp_b_rejected() -> Bool { kp_rejected(src: kp_b) }
test fn kp_b_advisory() -> Bool { kp_advisory(src: kp_b) }
test fn kp_b_ctl_rejected() -> Bool { kp_rejected(src: kp_b_ctl) }
test fn kp_b_ctl_advisory() -> Bool { kp_advisory(src: kp_b_ctl) }
test fn kp_c_rejected() -> Bool { kp_rejected(src: kp_c) }
test fn kp_c_advisory() -> Bool { kp_advisory(src: kp_c) }
test fn kp_d_rejected() -> Bool { kp_rejected(src: kp_d) }
test fn kp_d_advisory() -> Bool { kp_advisory(src: kp_d) }
test fn kp_z_clean() -> Bool { kp_clean(src: kp_z) }

data kp_e: String = "module p\n\nimport std.optional { Optional, Present }\nimport std.types { Int, List }\n\ntype R<K, V> {\n  row_key: K\n  value: V\n}\n\nfn f<K, V>(rows: List<R<K, V>>, hit: Int) -> Optional<R<K, V>> {\n  fold(rows, init: none, f: fn(acc, row) {\n    if hit == 1 {\n      Present { value: row }\n    } else {\n      acc\n    }\n  })\n}\n"
data kp_e_absent: String = "module p\n\nimport std.optional { Optional, Present, Absent }\nimport std.types { Int, List }\n\ntype R<K, V> {\n  row_key: K\n  value: V\n}\n\nfn f<K, V>(rows: List<R<K, V>>, hit: Int) -> Optional<R<K, V>> {\n  fold(rows, init: Absent, f: fn(acc, row) {\n    if hit == 1 {\n      Present { value: row }\n    } else {\n      acc\n    }\n  })\n}\n"
data kp_e_int: String = "module p\n\nimport std.optional { Optional, Present }\nimport std.types { Int, List }\n\nfn f(rows: List<Int>, hit: Int) -> Optional<Int> {\n  fold(rows, init: none, f: fn(acc, row) {\n    if hit == 1 {\n      Present { value: row }\n    } else {\n      acc\n    }\n  })\n}\n"

test fn kp_e_rejected() -> Bool { kp_rejected(src: kp_e) }
test fn kp_e_advisory() -> Bool { kp_advisory(src: kp_e) }
test fn kp_e_resolves() -> Bool { kp_resolved(src: kp_e) }
test fn kp_e_absent_rejected() -> Bool { kp_rejected(src: kp_e_absent) }
test fn kp_e_absent_advisory() -> Bool { kp_advisory(src: kp_e_absent) }
test fn kp_e_absent_resolves() -> Bool { kp_resolved(src: kp_e_absent) }
test fn kp_e_int_rejected() -> Bool { kp_rejected(src: kp_e_int) }
test fn kp_e_int_advisory() -> Bool { kp_advisory(src: kp_e_int) }
test fn kp_e_int_resolves() -> Bool { kp_resolved(src: kp_e_int) }
