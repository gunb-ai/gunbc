module v2.test.claim.arrow_contract_edge_conformance

import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.arrow_signature { DeclaredSignatureEdges, declared_signature }
import v2.std.node {
  Arrow,
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Positional,
  Symbol,
  TypeNode,
  arrow_signature_edges_conform,
  content_hash,
  node_synthetic,
  symbol_intern_lexeme
}

// THE CONFORMANCE WALL FOR AN ARROW'S CONTRACT EDGES (v2.std.node arrow_signature_edges_conform):
// ^arrow_effect_claims_edge, a Conj of self-named Atoms from { readonly, idempotent }, and
// ^arrow_execution_mode_claim_edge, one Atom from { hermetic }. The subject is an operation-shaped
// Arrow built as v2.compiler.body_lowering_fold body_lower_operation builds one: one ^operation_input
// binder whose target is the input payload. The bare Arrow is the positive control, and every red
// differs from an accepted Arrow in exactly the property its claim names.

fn ace_atom(identity: Symbol) -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: identity } }, children: [])
}

fn ace_conj(children: List<Edge>) -> Node {
  node_synthetic(kind: TypeNode { connective: Conj }, children: children)
}

fn ace_named(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn ace_payload() -> Node {
  ace_conj(children: [ace_named(name: ^page, target: ace_atom(identity: ^Int))])
}

fn ace_arrow(extra: List<Edge>) -> Node {
  let signature = declared_signature(params: [ace_named(name: ^operation_input, target: ace_payload())], source: ace_payload())
  node_synthetic(
    kind: TypeNode { connective: Arrow },
    children: concat([signature.domain, Edge { label: Positional, target: ace_conj(children: []) }, signature.order], extra)
  )
}

fn ace_claims(names: List<Symbol>) -> Edge {
  ace_named(name: ^arrow_effect_claims_edge, target: ace_conj(children: names |> map(n => ace_named(name: n, target: ace_atom(identity: n)))))
}

fn ace_mode(mode: Symbol) -> Edge {
  ace_named(name: ^arrow_execution_mode_claim_edge, target: ace_atom(identity: mode))
}

fn ace_conforms(extra: List<Edge>) -> Bool {
  arrow_signature_edges_conform(children: ace_arrow(extra: extra).children)
}

test fn a_claim_free_operation_arrow_conforms() -> Bool {
  ace_conforms(extra: [])
}

test fn admitted_contract_edges_conform_and_are_not_counted_as_a_binder() -> Bool {
  ace_conforms(extra: [ace_claims(names: [symbol_intern_lexeme(lexeme: "readonly"), symbol_intern_lexeme(lexeme: "idempotent")])])
    && ace_conforms(extra: [ace_mode(mode: symbol_intern_lexeme(lexeme: "hermetic"))])
    && ace_conforms(extra: [ace_claims(names: [symbol_intern_lexeme(lexeme: "idempotent")]), ace_mode(mode: symbol_intern_lexeme(lexeme: "hermetic"))])
}

// Reds, in order: a repeated claim; two claims edges; an unknown claim; hermetic folded into the
// effect claims; a claim Atom that is not its own label.
test fn a_malformed_effect_claim_refuses() -> Bool {
  !ace_conforms(extra: [ace_claims(names: [symbol_intern_lexeme(lexeme: "readonly"), symbol_intern_lexeme(lexeme: "readonly")])])
    && !ace_conforms(extra: [ace_claims(names: [symbol_intern_lexeme(lexeme: "readonly")]), ace_claims(names: [symbol_intern_lexeme(lexeme: "idempotent")])])
    && !ace_conforms(extra: [ace_claims(names: [^pure])])
    && !ace_conforms(extra: [ace_claims(names: [symbol_intern_lexeme(lexeme: "hermetic")])])
    && !ace_conforms(extra: [ace_named(name: ^arrow_effect_claims_edge, target: ace_conj(children: [ace_named(name: symbol_intern_lexeme(lexeme: "readonly"), target: ace_atom(identity: symbol_intern_lexeme(lexeme: "idempotent")))]))])
}

// Reds, in order: an unknown mode; an effect claim on the mode edge; two mode edges; a mode that is
// a Conj rather than one Atom.
test fn a_malformed_execution_mode_claim_refuses() -> Bool {
  !ace_conforms(extra: [ace_mode(mode: ^wet)])
    && !ace_conforms(extra: [ace_mode(mode: symbol_intern_lexeme(lexeme: "readonly"))])
    && !ace_conforms(extra: [ace_mode(mode: symbol_intern_lexeme(lexeme: "hermetic")), ace_mode(mode: symbol_intern_lexeme(lexeme: "hermetic"))])
    && !ace_conforms(extra: [ace_named(name: ^arrow_execution_mode_claim_edge, target: ace_conj(children: [ace_named(name: symbol_intern_lexeme(lexeme: "hermetic"), target: ace_atom(identity: symbol_intern_lexeme(lexeme: "hermetic")))]))])
}

// Canonical identity does not depend on the authored order of the claims or of the contract edges,
// and a claim is part of identity (the claimed Arrow is not the claim-free one).
test fn contract_edge_identity_is_order_independent() -> Bool {
  (content_hash(n: ace_arrow(extra: [ace_claims(names: [symbol_intern_lexeme(lexeme: "readonly"), symbol_intern_lexeme(lexeme: "idempotent")])])) == content_hash(n: ace_arrow(extra: [ace_claims(names: [symbol_intern_lexeme(lexeme: "idempotent"), symbol_intern_lexeme(lexeme: "readonly")])])))
    && (content_hash(n: ace_arrow(extra: [ace_claims(names: [symbol_intern_lexeme(lexeme: "readonly")]), ace_mode(mode: symbol_intern_lexeme(lexeme: "hermetic"))])) == content_hash(n: ace_arrow(extra: [ace_mode(mode: symbol_intern_lexeme(lexeme: "hermetic")), ace_claims(names: [symbol_intern_lexeme(lexeme: "readonly")])])))
    && (content_hash(n: ace_arrow(extra: [ace_claims(names: [symbol_intern_lexeme(lexeme: "readonly")])])) != content_hash(n: ace_arrow(extra: [])))
}
