module v2.test.claim.declaring_identity_spelling.production_ingest

import v2.compiler.declaring_identity_spelling_census {
  DeclaringIdentitySpellingCensus,
  spelling_census_from_ingest,
  spelling_census_is_total
}
import v2.compiler.normalized_tree { normalized_tree_roots_to_nodes }
import v2.compiler.program_assembly { module_roots_from_source_root_ingest }
import v2.compiler.reference_site_collector { collect_reference_sites }
import v2.compiler.resolution_provenance {
  ProvenanceAmbiguous,
  ProvenanceOwnerless,
  ProvenanceResolved,
  ProvenanceUnbound,
  resolve_reference_provenance
}
import v2.compiler.source_authority { DagSourceReadWitness, SourceRootIngest }
import v2.compiler.symbol_index_fill { symbol_index_fill_module_roots }
import v2.extdeps.languages.dag { dag_language_model }
import v2.std.algebra { fold_list }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.cross_tree.import_model { V2Tree }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.node { Node, Symbol }
import v2.std.optional { Absent, Present }
import v2.std.qualified_name {
  qualified_name_last_segment,
  qualified_name_snoc,
  qualified_name_to_dotted_string
}
import v2.std.symbol_index { empty_symbol_index, symbol_index_lookup }
import v2.test.claim.provenance.cross_file_provenance {
  cfp_index,
  cfp_own_module_site,
  cfp_roster
}
import std.algebra { Cons, Empty, FreeMonoid }
import std.declaring_identity_spelling {
  IdentityUnbound,
  IdentityAmbiguous,
  IdentityOwnerless,
  ResolvedSpelling,
  UnresolvableSpelling
}
import extdeps.communication.medium { Lossless, Medium }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// FILE FIXTURES INGESTED ON THE PRODUCTION ROUTE (bytes match the committed files).
// Inline Medium is the same tokenize→parse→normalize as a SourceFile read; it is not a
// hand-built Node tree.

data value_outside_call_source: String = "module v2.test.fixture.declaring_identity_spelling.value_outside_call\n\ndata marker: Int = 0\n\nfn go() -> Int { marker }\n"

data shorter_source: String = "module v2.test.fixture.declaring_identity_spelling.shorter\n\ntype Marker {}\n\nfn f(x: Marker) -> Int { 0 }\n"

data unresolvable_source: String = "module v2.test.fixture.declaring_identity_spelling.unresolvable\n\ndata row: ThisNameIsNotDeclaredInThisFixture = 0\n"

data call_only_source: String = "module v2.test.fixture.declaring_identity_spelling.call_only\n\nfn helper() -> Int { 0 }\n\nfn go() -> Int { helper() }\n"

data matched_type_vs_value_source: String = "module v2.test.fixture.declaring_identity_spelling.matched_type_vs_value\n\nimport v2.std.logic { Bool }\n\ntype type_only {}\n\ndata value_only: Int = 0\n\nfn go(x: type_only, flag: Bool) -> Int { value_only }\n"

data cross_provider_source: String = "module v2.test.fixture.declaring_identity_spelling.cross_provider\n\ndata Probe: Int = 0\n\ntype ProvidedMarker {}\n\ntype ProvidedFieldMarker {}\n"

data cross_consumer_source: String = "module v2.test.fixture.declaring_identity_spelling.cross_consumer\n\nfn go() -> Int { v2.test.fixture.declaring_identity_spelling.cross_provider.Probe }\n\nfn uses(x: v2.test.fixture.declaring_identity_spelling.cross_provider.ProvidedMarker) -> Int { 0 }\n\ntype Wrapper { f: v2.test.fixture.declaring_identity_spelling.cross_provider.ProvidedFieldMarker }\n"

data qualified_cross_module_spelling: String = "v2.test.fixture.declaring_identity_spelling.cross_provider.Probe"

data qualified_type_position_spelling: String = "v2.test.fixture.declaring_identity_spelling.cross_provider.ProvidedMarker"

data qualified_field_type_spelling: String = "v2.test.fixture.declaring_identity_spelling.cross_provider.ProvidedFieldMarker"

fn fixture_read(text: String, path: String, unit: Symbol) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: text, fidelity: Lossless },
    artifact: Artifact {
      kind: SourceFile,
      id: unit,
      file_path: path
    },
    compilation_unit: unit,
    source_root: V2Tree
  }
}

fn authored_unbound(census: DeclaringIdentitySpellingCensus, spelling: String) -> Bool {
  fold_list(
    xs: census.rows,
    empty: false,
    cons: fn(acc, row) {
      acc || match row {
        UnresolvableSpelling { authored: authored, cause: cause } =>
          qualified_name_to_dotted_string(qn: authored) == spelling
            && match cause {
              IdentityUnbound => true
              IdentityAmbiguous => false
              IdentityOwnerless => false
            }
        ResolvedSpelling { authored: _, declaring: _, canonical: _, path_verdict: _ } => false
      }
    }
  )
}

fn ingest_of(text: String, path: String, unit: Symbol) -> SourceRootIngest {
  Cons {
    head: fixture_read(text: text, path: path, unit: unit),
    tail: Empty
  }
}

fn census_of(text: String, path: String, unit: Symbol) -> DeclaringIdentitySpellingCensus {
  match spelling_census_from_ingest(
    ingest: ingest_of(text: text, path: path, unit: unit),
    lm: dag_language_model()
  ) {
    Accepted { value: census, diagnostics: _ } => census
    Rejected { diagnostics: _ } =>
      DeclaringIdentitySpellingCensus { rows: Empty, unreadable_roots: Empty }
  }
}

fn authored_is(census: DeclaringIdentitySpellingCensus, spelling: String) -> Bool {
  fold_list(
    xs: census.rows,
    empty: false,
    cons: fn(acc, row) {
      acc || match row {
        ResolvedSpelling { authored: authored, declaring: _, canonical: _, path_verdict: _ } =>
          qualified_name_to_dotted_string(qn: authored) == spelling
        UnresolvableSpelling { authored: authored, cause: _ } =>
          qualified_name_to_dotted_string(qn: authored) == spelling
      }
    }
  )
}

test fn value_outside_call_ingests_holds() -> Bool {
  match spelling_census_from_ingest(
    ingest: ingest_of(
      text: value_outside_call_source,
      path: "src/v2/test/fixture/declaring_identity_spelling/value_outside_call.dag",
      unit: ^xl3_value_outside_call
    ),
    lm: dag_language_model()
  ) {
    Accepted { value: census, diagnostics: _ } => spelling_census_is_total(census: census)
    Rejected { diagnostics: _ } => false
  }
}

test fn a_bare_value_mention_outside_a_call_reaches_the_census_holds() -> Bool {
  authored_is(
    census: census_of(
      text: value_outside_call_source,
      path: "src/v2/test/fixture/declaring_identity_spelling/value_outside_call.dag",
      unit: ^xl3_value_outside_call
    ),
    spelling: "marker"
  )
}

// CONTROL: the enrolled two-module provenance witness binds a same-module name
// on resolve_reference_provenance. If this is green, IdentityUnbound on the
// ingest census is not "v2 cannot compile a local name".
test fn enrolled_same_module_site_binds_on_the_resolution_path_holds() -> Bool {
  match resolve_reference_provenance(
    index: cfp_index,
    roster: cfp_roster,
    site: cfp_own_module_site
  ) {
    ProvenanceResolved { site: _, target: _, owner: _ } => true
    ProvenanceOwnerless { site: _, target: _ } => false
    ProvenanceAmbiguous { site: _ } => false
    ProvenanceUnbound { site: _ } => false
  }
}

fn value_outside_call_roots() -> FreeMonoid<Node> {
  match module_roots_from_source_root_ingest(
    ingest: ingest_of(
      text: value_outside_call_source,
      path: "src/v2/test/fixture/declaring_identity_spelling/value_outside_call.dag",
      unit: ^xl3_value_outside_call
    ),
    lm: dag_language_model()
  ) {
    Accepted { value: normalized, diagnostics: _ } =>
      normalized_tree_roots_to_nodes(roots: normalized)
    Rejected { diagnostics: _ } => Empty
  }
}

fn marker_site_fill_lookup_is_present() -> Bool {
  let roots = value_outside_call_roots()
  let collected = collect_reference_sites(roots: roots)
  let index = symbol_index_fill_module_roots(index: empty_symbol_index(), roots: roots)
  fold_list(
    xs: collected.sites,
    empty: false,
    cons: fn(acc, site) {
      acc || (
        qualified_name_to_dotted_string(qn: site.spelling) == "marker"
          && match qualified_name_last_segment(qn: site.spelling) {
            Absent => false
            Present { value: name } =>
              match symbol_index_lookup(
                index: index,
                qualified_path: qualified_name_snoc(qn: site.position, segment: name)
              ) {
                Present { value: _ } => true
                Absent => false
              }
          }
      )
    }
  )
}

// INDEX-PATH ONLY, not a fact about 03_resolve. Parser-keyed fill lookup at the
// collector site's position. Green means fill never inserted `marker`; that is
// the step that makes the census row IdentityUnbound.
test fn ingest_fill_does_not_index_the_same_module_data_name_today() -> Bool {
  !marker_site_fill_lookup_is_present()
}

// Retracted as a compiler fact. Kept as an index-path measurement: the census
// row is Unbound because fill missed, not because the name cannot compile.
test fn a_bare_value_mention_outside_a_call_is_unbound_today() -> Bool {
  authored_unbound(
    census: census_of(
      text: value_outside_call_source,
      path: "src/v2/test/fixture/declaring_identity_spelling/value_outside_call.dag",
      unit: ^xl3_value_outside_call
    ),
    spelling: "marker"
  )
}

// User type-position names that are BARE and local REACH (fixture 1: `x: Marker`).
// That is the cheap control for qualification-vs-position: no dot, type position, found.
test fn a_user_type_position_name_reaches_the_census_today() -> Bool {
  authored_is(
    census: census_of(
      text: shorter_source,
      path: "src/v2/test/fixture/declaring_identity_spelling/shorter.dag",
      unit: ^xl3_shorter
    ),
    spelling: "Marker"
  )
}

test fn an_unbound_type_position_name_is_unresolvable_today() -> Bool {
  authored_unbound(
    census: census_of(
      text: unresolvable_source,
      path: "src/v2/test/fixture/declaring_identity_spelling/unresolvable.dag",
      unit: ^xl3_unresolvable
    ),
    spelling: "ThisNameIsNotDeclaredInThisFixture"
  )
}

test fn a_callee_name_is_absent_from_the_census_today() -> Bool {
  !authored_is(
    census: census_of(
      text: call_only_source,
      path: "src/v2/test/fixture/declaring_identity_spelling/call_only.dag",
      unit: ^xl3_call_only
    ),
    spelling: "helper"
  )
}

// Census-row spelling "Int": kernel types have no corpus declaration. Not a
// type-position collector miss and not a lowering class.
test fn a_kernel_type_position_name_is_absent_from_the_census_today() -> Bool {
  !authored_is(
    census: census_of(
      text: value_outside_call_source,
      path: "src/v2/test/fixture/declaring_identity_spelling/value_outside_call.dag",
      unit: ^xl3_value_outside_call
    ),
    spelling: "Int"
  )
}

fn matched_census() -> DeclaringIdentitySpellingCensus {
  census_of(
    text: matched_type_vs_value_source,
    path: "src/v2/test/fixture/declaring_identity_spelling/matched_type_vs_value.dag",
    unit: ^xl3_matched_type_vs_value
  )
}

// Same module, no call. User type_only REACHES. Imported Bool as a census-row
// spelling may still be absent here; that is not a collector type-position miss
// and is not a reason to hold fixtures 1-3.
test fn matched_value_only_mention_reaches_the_census_today() -> Bool {
  authored_is(census: matched_census(), spelling: "value_only")
}

test fn matched_user_type_position_mention_reaches_the_census_today() -> Bool {
  authored_is(census: matched_census(), spelling: "type_only")
}

test fn matched_imported_kernel_type_position_is_absent_from_the_census_today() -> Bool {
  !authored_is(census: matched_census(), spelling: "Bool")
}

fn two_module_ingest() -> SourceRootIngest {
  Cons {
    head: fixture_read(
      text: cross_provider_source,
      path: "src/v2/test/fixture/declaring_identity_spelling/cross_provider.dag",
      unit: ^xl3_cross_provider
    ),
    tail: Cons {
      head: fixture_read(
        text: cross_consumer_source,
        path: "src/v2/test/fixture/declaring_identity_spelling/cross_consumer.dag",
        unit: ^xl3_cross_consumer
      ),
      tail: Empty
    }
  }
}

fn two_module_census() -> DeclaringIdentitySpellingCensus {
  match spelling_census_from_ingest(ingest: two_module_ingest(), lm: dag_language_model()) {
    Accepted { value: census, diagnostics: _ } => census
    Rejected { diagnostics: _ } =>
      DeclaringIdentitySpellingCensus { rows: Empty, unreadable_roots: Empty }
  }
}

// THE USABLE CLASS: a qualified cross-module value mention outside any call, and
// nothing else in the ingest can produce that spelling. Absent today. A bare
// same-module name is not this row. Goes red when the mention reaches the census.
test fn a_qualified_cross_module_mention_is_absent_from_the_census_today() -> Bool {
  spelling_census_is_total(census: two_module_census())
    && !authored_is(census: two_module_census(), spelling: qualified_cross_module_spelling)
}

// QUALIFIED type-position, no call. Same ingest as the value-position Probe miss.
// If this is absent while bare Marker reaches, the type-position miss is
// qualification, not lowering.
test fn a_qualified_type_position_mention_is_absent_from_the_census_today() -> Bool {
  spelling_census_is_total(census: two_module_census())
    && !authored_is(census: two_module_census(), spelling: qualified_type_position_spelling)
}

// DOTTED name used only as a field type, nowhere else in the ingest. Not merged
// with the parameter-type row until this one is measured.
test fn a_qualified_field_type_mention_is_absent_from_the_census_today() -> Bool {
  spelling_census_is_total(census: two_module_census())
    && !authored_is(census: two_module_census(), spelling: qualified_field_type_spelling)
}
