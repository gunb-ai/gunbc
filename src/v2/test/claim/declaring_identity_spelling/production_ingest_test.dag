import extdeps.filesystem.filesystem_io

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// FILE FIXTURES ARE THE AUTHORITY. Ingest reads those bytes via filesystem_read; there is
// no second inline copy of the same source.

data value_outside_call_path: String = "src/v2/test/fixture/declaring_identity_spelling/value_outside_call.dag"

data shorter_path: String = "src/v2/test/fixture/declaring_identity_spelling/shorter.dag"

data unresolvable_path: String = "dag/test/probe/declaring_identity_spelling_unresolvable_probe.dag"

data call_only_path: String = "src/v2/test/fixture/declaring_identity_spelling/call_only.dag"

data matched_type_vs_value_path: String = "src/v2/test/fixture/declaring_identity_spelling/matched_type_vs_value.dag"

data field_vs_parameter_path: String = "src/v2/test/fixture/declaring_identity_spelling/field_vs_parameter.dag"

data cross_provider_path: String = "src/v2/test/fixture/declaring_identity_spelling/cross_provider.dag"

data cross_consumer_path: String = "src/v2/test/fixture/declaring_identity_spelling/cross_consumer.dag"

data qualified_cross_module_spelling: String = "v2.test.fixture.declaring_identity_spelling.cross_provider.Probe"

data qualified_type_position_spelling: String = "v2.test.fixture.declaring_identity_spelling.cross_provider.ProvidedMarker"

data qualified_field_type_spelling: String = "v2.test.fixture.declaring_identity_spelling.cross_provider.ProvidedFieldMarker"

fn fixture_read(path: String, unit: Symbol) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: filesystem_read(path: path).content, fidelity: Lossless },
    artifact: Artifact {
      kind: SourceFile,
      id: unit,
      file_path: path
    },
    compilation_unit: unit,
    source_root: V2Tree
  }
}

fn authored_unbound(census: DeclaringIdentitySpellingCensus, spelling: String) -> Bool {
  fold_list(
    xs: census.rows,
    empty: false,
    cons: fn(acc, row) {
      acc || match row {
        UnresolvableSpelling { authored: authored, cause: cause } =>
          qualified_name_to_dotted_string(qn: authored) == spelling
            && match cause {
              IdentityUnbound => true
              IdentityAmbiguous => false
              IdentityOwnerless => false
            }
        ResolvedSpelling { authored: _, declaring: _, canonical: _, path_verdict: _ } => false
      }
    }
  )
}

// ONE READ, ONE CENSUS PER FIXTURE, SHARED ACROSS THE CLAIM FRAMES. The required floor builds a
// fresh frame per claim, so each claim that parsed its own fixture re-derived the whole
// parse-and-normalize (gunbc#11461 run 35074340220: fifteen claims of this file
// COMPLETED-OVER-COST-REQUIREMENT at 130k-430k eval steps against the new-witness budget -
// gunbc.recurring_failure_mode.shared_precondition_re_derived_once_per_claim_frame). The reads
// are the world, so they are a PreparedEffectInput (xl3_fixture_reads, acquired once at
// preparation); the censuses are a CarriedInputWarmRow over it (xl3_fixture_censuses,
// ImplicitAcquisition) in v2.workflow.floor_pure_producer_share, and every claim below is a
// field read of that value. Each fixture is STILL its own single-file ingest - the census
// semantics are per file, never one combined ingest - so nothing a claim measures changed.
fn xl3_fixture_reads() -> SourceRootIngest {
  Cons {
    head: fixture_read(path: value_outside_call_path, unit: ^xl3_value_outside_call),
    tail: Cons {
      head: fixture_read(path: shorter_path, unit: ^xl3_shorter),
      tail: Cons {
        head: fixture_read(path: unresolvable_path, unit: ^xl3_unresolvable),
        tail: Cons {
          head: fixture_read(path: call_only_path, unit: ^xl3_call_only),
          tail: Cons {
            head: fixture_read(path: matched_type_vs_value_path, unit: ^xl3_matched_type_vs_value),
            tail: Cons {
              head: fixture_read(path: field_vs_parameter_path, unit: ^xl3_field_vs_parameter),
              tail: Cons {
                head: fixture_read(path: cross_provider_path, unit: ^xl3_cross_provider),
                tail: Cons {
                  head: fixture_read(path: cross_consumer_path, unit: ^xl3_cross_consumer),
                  tail: Empty
                }
              }
            }
          }
        }
      }
    }
  }
}

type Xl3PathCensus {
  path: String
  census: Optional<DeclaringIdentitySpellingCensus>
}

type Xl3FixtureCensuses {
  by_path: List<Xl3PathCensus>
  two_module: Optional<DeclaringIdentitySpellingCensus>
  value_outside_call_roots: Optional<FreeMonoid<Node>>
}

fn read_for_path(reads: SourceRootIngest, path: String) -> Optional<DagSourceReadWitness> {
  fold_list(
    xs: reads,
    empty: Absent,
    cons: fn(acc, w) {
      match acc {
        Present { value: found } => Present { value: found }
        Absent =>
          if w.artifact.file_path == path {
            optional_present(value: w)
          } else {
            optional_absent()
          }
      }
    }
  )
}

fn census_of_read(w: DagSourceReadWitness) -> Optional<DeclaringIdentitySpellingCensus> {
  match spelling_census_from_ingest(
    ingest: Cons { head: w, tail: Empty },
    lm: dag_language_model()
  ) {
    Accepted { value: census, diagnostics: _ } => Present { value: census }
    Rejected { diagnostics: _ } => Absent
  }
}

fn path_census(reads: SourceRootIngest, path: String) -> Xl3PathCensus {
  Xl3PathCensus {
    path: path,
    census: match read_for_path(reads: reads, path: path) {
      Absent => Absent
      Present { value: w } => census_of_read(w: w)
    }
  }
}

fn xl3_fixture_censuses() -> Xl3FixtureCensuses {
  let reads = xl3_fixture_reads()
  let two = match read_for_path(reads: reads, path: cross_provider_path) {
    Absent => Absent
    Present { value: provider } =>
      match read_for_path(reads: reads, path: cross_consumer_path) {
        Absent => Absent
        Present { value: consumer } =>
          match spelling_census_from_ingest(
            ingest: Cons { head: provider, tail: Cons { head: consumer, tail: Empty } },
            lm: dag_language_model()
          ) {
            Accepted { value: census, diagnostics: _ } => Present { value: census }
            Rejected { diagnostics: _ } => Absent
          }
      }
  }
  let roots = match read_for_path(reads: reads, path: value_outside_call_path) {
    Absent => Absent
    Present { value: w } =>
      match module_roots_from_source_root_ingest(
        ingest: Cons { head: w, tail: Empty },
        lm: dag_language_model()
      ) {
        Accepted { value: normalized, diagnostics: _ } =>
          Present { value: normalized_tree_roots_to_nodes(roots: normalized) }
        Rejected { diagnostics: _ } => Absent
      }
  }
  Xl3FixtureCensuses {
    by_path: [
      path_census(reads: reads, path: value_outside_call_path),
      path_census(reads: reads, path: shorter_path),
      path_census(reads: reads, path: unresolvable_path),
      path_census(reads: reads, path: call_only_path),
      path_census(reads: reads, path: matched_type_vs_value_path),
      path_census(reads: reads, path: field_vs_parameter_path)
    ],
    two_module: two,
    value_outside_call_roots: roots
  }
}

// `unit` is the fixture's compilation-unit symbol as before; the census is served from the
// warm value keyed by path, so the same call sites read the same answer without re-parsing.
fn census_of(path: String, unit: Symbol) -> Optional<DeclaringIdentitySpellingCensus> {
  fold_list(
    xs: xl3_fixture_censuses().by_path,
    empty: Absent,
    cons: fn(acc, row) {
      match acc {
        Present { value: c } => Present { value: c }
        Absent =>
          if row.path == path {
            row.census
          } else {
            optional_absent()
          }
      }
    }
  )
}

fn census_unreadable_roots_empty(census: DeclaringIdentitySpellingCensus) -> Bool {
  is_empty(xs: census.unreadable_roots)
}

fn authored_is(census: DeclaringIdentitySpellingCensus, spelling: String) -> Bool {
  fold_list(
    xs: census.rows,
    empty: false,
    cons: fn(acc, row) {
      acc || match row {
        ResolvedSpelling { authored: authored, declaring: _, canonical: _, path_verdict: _ } =>
          qualified_name_to_dotted_string(qn: authored) == spelling
        UnresolvableSpelling { authored: authored, cause: _ } =>
          qualified_name_to_dotted_string(qn: authored) == spelling
      }
    }
  )
}

test fn value_outside_call_ingests_holds() -> Bool {
  match census_of(path: value_outside_call_path, unit: ^xl3_value_outside_call) {
    Present { value: census } => census_unreadable_roots_empty(census: census)
    Absent => false
  }
}

test fn a_bare_value_mention_outside_a_call_reaches_the_census_holds() -> Bool {
  match census_of(
    path: value_outside_call_path,
    unit: ^xl3_value_outside_call
  ) {
    Present { value: census } => authored_is(census: census, spelling: "marker")
    Absent => false
  }
}

// CONTROL: the enrolled two-module provenance witness binds a same-module name
// on resolve_reference_provenance. If this is green, IdentityUnbound on the
// ingest census is not "v2 cannot compile a local name".
test fn enrolled_same_module_site_binds_on_the_resolution_path_holds() -> Bool {
  match resolve_reference_provenance(
    index: cfp_index,
    roster: cfp_roster,
    site: cfp_own_module_site
  ) {
    ProvenanceResolved { site: _, target: _, owner: _ } => true
    ProvenanceOwnerless { site: _, target: _ } => false
    ProvenanceAmbiguous { site: _ } => false
    ProvenanceUnbound { site: _ } => false
  }
}

fn value_outside_call_roots() -> Optional<FreeMonoid<Node>> {
  xl3_fixture_censuses().value_outside_call_roots
}

fn marker_site_fill_lookup_is_present(roots: FreeMonoid<Node>) -> Bool {
  let collected = collect_reference_sites(roots: roots)
  let index = symbol_index_fill_module_roots(index: empty_symbol_index(), roots: roots)
  fold_list(
    xs: collected.sites,
    empty: false,
    cons: fn(acc, site) {
      acc || (
        qualified_name_to_dotted_string(qn: site.spelling) == "marker"
          && match qualified_name_last_segment(qn: site.spelling) {
            Absent => false
            Present { value: name } =>
              match symbol_index_lookup(
                index: index,
                qualified_path: qualified_name_snoc(qn: site.position, segment: name)
              ) {
                Present { value: _ } => true
                Absent => false
              }
          }
      )
    }
  )
}

// INDEX-PATH ONLY, not a fact about 03_resolve. Parser-keyed fill lookup at the
// collector site's position. Green means fill never inserted `marker`; that is
// the step that makes the census row IdentityUnbound.
test fn ingest_fill_does_not_index_the_same_module_data_name_today() -> Bool {
  match value_outside_call_roots() {
    Present { value: roots } => !marker_site_fill_lookup_is_present(roots: roots)
    Absent => false
  }
}

// FLIPPED 2026-09-19 (DESIGN 4b(4)): `marker` is a data declaration of the same module;
// while the graft Named only fn declarations its mention in `go()` stayed IdentityUnbound.
// gunbc#11574 Names data declarations, so the mention binds. Permanent control.
test fn a_bare_value_mention_outside_a_call_is_bound_holds() -> Bool {
  match census_of(
    path: value_outside_call_path,
    unit: ^xl3_value_outside_call
  ) {
    Present { value: census } =>
      authored_is(census: census, spelling: "marker")
        && !authored_unbound(census: census, spelling: "marker")
    Absent => false
  }
}

// BARE type name in PARAMETER position (fixture 1: `x: Marker`). Reaches.
// "Type position" is too coarse: a bare FIELD type does not reach.
test fn a_user_type_position_name_reaches_the_census_today() -> Bool {
  match census_of(
    path: shorter_path,
    unit: ^xl3_shorter
  ) {
    Present { value: census } => authored_is(census: census, spelling: "Marker")
    Absent => false
  }
}

test fn an_unbound_type_position_name_is_unresolvable_today() -> Bool {
  match census_of(
    path: unresolvable_path,
    unit: ^xl3_unresolvable
  ) {
    Present { value: census } =>
      authored_unbound(census: census, spelling: "ThisNameIsNotDeclaredInThisFixture")
    Absent => false
  }
}

test fn a_callee_name_reaches_the_census_holds() -> Bool {
  match census_of(
    path: call_only_path,
    unit: ^xl3_call_only
  ) {
    Present { value: census } =>
      census_unreadable_roots_empty(census: census)
        && authored_is(census: census, spelling: "LocalParam")
        && authored_is(census: census, spelling: "helper")
    Absent => false
  }
}

// FLIPPED 2026-09-19 (DESIGN 4b(4)): the kernel type `Int` reaches the census from the
// data declaration's own type position (`data marker: Int`) once gunbc#11574 Names the
// data declaration at its content (the `: Int = 0` remainder). Before, the data shell was
// not a graft member and its type annotation reached no collector. Permanent control.
test fn a_kernel_type_position_name_reaches_the_census_holds() -> Bool {
  match census_of(
    path: value_outside_call_path,
    unit: ^xl3_value_outside_call
  ) {
    Present { value: census } =>
      authored_is(census: census, spelling: "marker")
        && authored_is(census: census, spelling: "Int")
    Absent => false
  }
}

fn matched_census() -> Optional<DeclaringIdentitySpellingCensus> {
  census_of(
    path: matched_type_vs_value_path,
    unit: ^xl3_matched_type_vs_value
  )
}

// Same module, no call. User type_only in PARAMETER position REACHES. Imported
// Bool as a census-row spelling may still be absent here; that is not a collector
// parameter-type miss and is not a reason to hold fixtures 1-3.
test fn matched_value_only_mention_reaches_the_census_today() -> Bool {
  match matched_census() {
    Present { value: census } => authored_is(census: census, spelling: "value_only")
    Absent => false
  }
}

test fn matched_user_type_position_mention_reaches_the_census_today() -> Bool {
  match matched_census() {
    Present { value: census } => authored_is(census: census, spelling: "type_only")
    Absent => false
  }
}

test fn matched_imported_kernel_type_position_is_absent_from_the_census_today() -> Bool {
  match matched_census() {
    Present { value: census } =>
      authored_is(census: census, spelling: "value_only")
        && !authored_is(census: census, spelling: "Bool")
    Absent => false
  }
}

fn two_module_census() -> Optional<DeclaringIdentitySpellingCensus> {
  xl3_fixture_censuses().two_module
}

fn two_module_usable_class_probe(census: DeclaringIdentitySpellingCensus) -> Bool {
  census_unreadable_roots_empty(census: census)
    && authored_is(census: census, spelling: "LocalParam")
}

// THE USABLE CLASS: a qualified cross-module value mention outside any call, and
// nothing else in the ingest can produce that spelling. A bare same-module name
// is not this row. LocalParam is the positive control: Rejected ingest cannot
// green these.
//
// THIS ROW WAS ENROLLED AS "IS ABSENT TODAY" AND WENT RED ON 2026-09-18 FOR THE
// REASON IT WAS ENROLLED: the mention now reaches the census as one authored
// spelling of the whole chain. The gap was v2 body lowering, not qualification
// (gunbc.recurring_failure_mode dotted_reference_truncated_at_v2_body_lowering).
// What this row asserts is the MENTION reaching, which is the census's own
// subject; whether it BINDS is a second fact -- `Probe` is a data declaration,
// and a data declaration is not yet grafted into the containment tree, so the
// row today is UnresolvableSpelling / IdentityUnbound. That binding fact has
// its own trigger (declaration grafting) and is not asserted either way here.
test fn a_qualified_cross_module_mention_reaches_the_census_holds() -> Bool {
  match two_module_census() {
    Present { value: census } =>
      two_module_usable_class_probe(census: census)
        && authored_is(census: census, spelling: qualified_cross_module_spelling)
    Absent => false
  }
}

// QUALIFIED parameter-type, no call. Same ingest as the value-position Probe
// row, and it flipped with it: a multi-segment qualified name in parameter
// position now lowers to the same spine a body chain does. Bare LocalParam is
// the control beside it.
test fn a_qualified_type_position_mention_reaches_the_census_holds() -> Bool {
  match two_module_census() {
    Present { value: census } =>
      two_module_usable_class_probe(census: census)
        && authored_is(census: census, spelling: qualified_type_position_spelling)
    Absent => false
  }
}

// QUALIFIED field type. Still absent, and now for ONE reason rather than two:
// qualification no longer hides a mention (the two rows above reach), so what is
// left is field position -- the record declaration is not grafted into the
// containment tree at all. The discriminator is field_vs_parameter.
test fn a_qualified_field_type_mention_is_absent_from_the_census_today() -> Bool {
  match two_module_census() {
    Present { value: census } =>
      two_module_usable_class_probe(census: census)
        && !authored_is(census: census, spelling: qualified_field_type_spelling)
    Absent => false
  }
}

fn field_vs_parameter_census() -> Optional<DeclaringIdentitySpellingCensus> {
  census_of(
    path: field_vs_parameter_path,
    unit: ^xl3_field_vs_parameter
  )
}

// SAME ingest, BARE names, no dots. Residual reconstruct keeps the field type
// spelling in the census the way the tree keeps it.
test fn a_bare_parameter_type_reaches_and_a_bare_field_type_does_too() -> Bool {
  match field_vs_parameter_census() {
    Present { value: census } =>
      census_unreadable_roots_empty(census: census)
        && authored_is(census: census, spelling: "ParamOnly")
        && authored_is(census: census, spelling: "FieldOnly")
    Absent => false
  }
}
