module v2.test.claim.integer.value_set_decode_reason


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn conj_carrier(children: List<v2.std.node.Edge>) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: children,
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn named_edge(name: v2.std.node.Symbol, target: v2.std.node.Node) -> v2.std.node.Edge {
  v2.std.node.Edge { label: v2.std.node.Named { name: name }, target: target }
}

fn kind_edge(kind: v2.std.node.Symbol) -> v2.std.node.Edge {
  named_edge(name: ^integer_value_set_field_kind, target: v2.std.integer_value_set.integer_value_set_atom(id: kind))
}

fn decode_reason(value_set: v2.std.node.Node) -> v2.std.node.Symbol {
  match v2.std.integer_value_set.integer_value_set_from_node(value_set: value_set) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => ^decode_unexpectedly_accepted
    v2.std.diagnostic.Rejected { diagnostics: ds } => ds.head.reason
  }
}

fn decode_cause_count(value_set: v2.std.node.Node) -> Int {
  match v2.std.integer_value_set.integer_value_set_from_node(value_set: value_set) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => 9
    v2.std.diagnostic.Rejected { diagnostics: ds } => count(ds.tail)
  }
}

data carrier_missing_kind_field: v2.std.node.Node = conj_carrier(
  children: [
    named_edge(
      name: ^integer_value_set_field_interval,
      target: v2.std.integer_value_set.integer_value_set_atom(id: ^some_interval)
    )
  ]
)

data carrier_unrecognized_kind: v2.std.node.Node = conj_carrier(
  children: [kind_edge(kind: ^integer_value_set_kind_not_a_real_kind)]
)

data carrier_interval_field_missing: v2.std.node.Node = conj_carrier(
  children: [
    kind_edge(kind: ^integer_value_set_kind_interval),
    named_edge(
      name: ^integer_value_set_field_misspelled,
      target: v2.std.integer_value_set.integer_value_set_atom(id: ^some_interval)
    )
  ]
)

data carrier_interval_spec_malformed: v2.std.node.Node = v2.std.integer_value_set.integer_interval_value_set_node(
  interval: v2.std.integer_value_set.integer_value_set_atom(id: ^not_an_interval_spec)
)

data carrier_unbounded_wrong_arity: v2.std.node.Node = conj_carrier(
  children: [
    kind_edge(kind: ^integer_value_set_kind_unbounded),
    named_edge(name: ^integer_value_set_field_extra, target: v2.std.integer_value_set.integer_value_set_atom(id: ^extra))
  ]
)

test fn well_formed_unbounded_carrier_still_decodes() -> Bool {
  match v2.std.integer_value_set.integer_value_set_from_node(value_set: v2.std.integer_value_set.integer_unbounded_value_set_node()) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn decode_refusals_carry_distinct_reason_symbols() -> Bool {
  let missing_kind = decode_reason(value_set: carrier_missing_kind_field)
  let unrecognized_kind = decode_reason(value_set: carrier_unrecognized_kind)
  let interval_missing = decode_reason(value_set: carrier_interval_field_missing)
  let interval_malformed = decode_reason(value_set: carrier_interval_spec_malformed)
  let unbounded_arity = decode_reason(value_set: carrier_unbounded_wrong_arity)
  (missing_kind == ^integer_value_set_kind_field_unresolved)
    && (unrecognized_kind == ^integer_value_set_kind_unrecognized)
    && (interval_missing == ^integer_value_set_interval_field_unresolved)
    && (interval_malformed == ^integer_value_set_interval_spec_malformed)
    && (unbounded_arity == ^integer_value_set_unbounded_field_count_unexpected)
    && (missing_kind != unrecognized_kind)
    && (missing_kind != interval_missing)
    && (interval_missing != interval_malformed)
    && (interval_malformed != unbounded_arity)
}

test fn producer_fault_refusals_retain_the_lookup_cause() -> Bool {
  (decode_cause_count(value_set: carrier_missing_kind_field) == 1)
    && (decode_cause_count(value_set: carrier_interval_field_missing) == 1)
    && (decode_cause_count(value_set: carrier_interval_spec_malformed) == 0)
}
