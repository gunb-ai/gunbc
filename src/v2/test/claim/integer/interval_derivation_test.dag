  inclusive_min: v2.std.integer.integer_concrete_zero(),
  inclusive_max: v2.std.integer.integer_concrete_bound(sign: v2.std.integer.IntegerBoundNonNegative, magnitude: v2.std.integer.DecimalNonZeroMagnitude { lead: v2.std.integer.NonZeroD3, tail: [v2.std.integer.D4, v2.std.integer.D0, v2.std.integer.D2, v2.std.integer.D8, v2.std.integer.D2, v2.std.integer.D3, v2.std.integer.D6, v2.std.integer.D6, v2.std.integer.D9, v2.std.integer.D2, v2.std.integer.D0, v2.std.integer.D9, v2.std.integer.D3, v2.std.integer.D8, v2.std.integer.D4, v2.std.integer.D6, v2.std.integer.D3, v2.std.integer.D4, v2.std.integer.D6, v2.std.integer.D3, v2.std.integer.D3, v2.std.integer.D7, v2.std.integer.D4, v2.std.integer.D6, v2.std.integer.D0, v2.std.integer.D7, v2.std.integer.D4, v2.std.integer.D3, v2.std.integer.D1, v2.std.integer.D7, v2.std.integer.D6, v2.std.integer.D8, v2.std.integer.D2, v2.std.integer.D1, v2.std.integer.D1, v2.std.integer.D4, v2.std.integer.D5, v2.std.integer.D5] })
)

fn bound_eq(a: v2.std.integer.IntegerIntervalBound, b: v2.std.integer.IntegerIntervalBound) -> Bool {
  match v2.std.integer.integer_interval_bound_compare(left: a, right: b) {
    std.algebra.Equal => true
    _ => false
  }
}

fn spec_eq(a: v2.std.integer.IntegerIntervalSpec, b: v2.std.integer.IntegerIntervalSpec) -> Bool {
  bound_eq(a: a.inclusive_min, b: b.inclusive_min)
    && bound_eq(a: a.inclusive_max, b: b.inclusive_max)
}

fn derived_matches_legacy(standard_integer_type: v2.std.integer.StandardIntegerType, legacy: v2.std.integer.IntegerIntervalSpec) -> Bool {
  spec_eq(
    a: v2.std.integer.integer_standard_integer_type_interval_spec(standard_integer_type: standard_integer_type),
    b: legacy
  )
}

test fn interval_derivation_matches_all_legacy_spelled_bounds() -> Bool {
  derived_matches_legacy(standard_integer_type: v2.std.integer.Int8, legacy: legacy_int8_spec)
    && derived_matches_legacy(standard_integer_type: v2.std.integer.Int16, legacy: legacy_int16_spec)
    && derived_matches_legacy(standard_integer_type: v2.std.integer.Int32, legacy: legacy_int32_spec)
    && derived_matches_legacy(standard_integer_type: v2.std.integer.Int64, legacy: legacy_int64_spec)
    && derived_matches_legacy(standard_integer_type: v2.std.integer.Int128, legacy: legacy_int128_spec)
    && derived_matches_legacy(standard_integer_type: v2.std.integer.UInt8, legacy: legacy_uint8_spec)
    && derived_matches_legacy(standard_integer_type: v2.std.integer.UInt16, legacy: legacy_uint16_spec)
    && derived_matches_legacy(standard_integer_type: v2.std.integer.UInt32, legacy: legacy_uint32_spec)
    && derived_matches_legacy(standard_integer_type: v2.std.integer.UInt64, legacy: legacy_uint64_spec)
    && derived_matches_legacy(standard_integer_type: v2.std.integer.UInt128, legacy: legacy_uint128_spec)
}

data planted_wrong_int8_spec: v2.std.integer.IntegerIntervalSpec = v2.std.integer.integer_interval(
  inclusive_min: v2.std.integer.integer_concrete_bound(sign: v2.std.integer.IntegerBoundNegative, magnitude: v2.std.integer.DecimalNonZeroMagnitude { lead: v2.std.integer.NonZeroD1, tail: [v2.std.integer.D2, v2.std.integer.D8] }),
  inclusive_max: v2.std.integer.integer_concrete_bound(sign: v2.std.integer.IntegerBoundNonNegative, magnitude: v2.std.integer.DecimalNonZeroMagnitude { lead: v2.std.integer.NonZeroD1, tail: [v2.std.integer.D2, v2.std.integer.D8] })
)

test fn derivation_discriminates_planted_off_by_one() -> Bool {
  !derived_matches_legacy(standard_integer_type: v2.std.integer.Int8, legacy: planted_wrong_int8_spec)
}

test fn pow2_digit_shapes_hold() -> Bool {
  let one = v2.std.integer.integer_pow2_magnitude(exponent: 0)
  let one_two_eight = v2.std.integer.integer_pow2_magnitude(exponent: 7)
  let two_pow_127 = v2.std.integer.integer_pow2_magnitude(exponent: 127)
  (v2.std.algebra.length(xs: one.tail) == 0)
    && bound_eq(
      a: v2.std.integer.integer_concrete_bound(sign: v2.std.integer.IntegerBoundNonNegative, magnitude: one_two_eight),
      b: v2.std.integer.integer_concrete_bound(sign: v2.std.integer.IntegerBoundNonNegative, magnitude: v2.std.integer.DecimalNonZeroMagnitude { lead: v2.std.integer.NonZeroD1, tail: [v2.std.integer.D2, v2.std.integer.D8] })
    )
    && (v2.std.algebra.length(xs: two_pow_127.tail) == 38)
}

test fn interval_min_not_above_max_for_all_standard_types() -> Bool {
  v2.std.algebra.fold_list(
    xs: v2.std.integer.integer_standard_integer_type_roster,
    empty: true,
    cons: fn(acc, t) {
      let spec = v2.std.integer.integer_standard_integer_type_interval_spec(standard_integer_type: t)
      acc && v2.std.integer.integer_interval_bound_less_or_equal(left: spec.inclusive_min, right: spec.inclusive_max)
    }
  )
}

fn signedness_eq(a: std.integer.Signedness, b: std.integer.Signedness) -> Bool {
  match a {
    v2.std.integer.Signed => match b {
      v2.std.integer.Signed => true
      v2.std.integer.Unsigned => false
    }
    v2.std.integer.Unsigned => match b {
      v2.std.integer.Signed => false
      v2.std.integer.Unsigned => true
    }
  }
}

fn standard_integer_type_eq(a: v2.std.integer.StandardIntegerType, b: v2.std.integer.StandardIntegerType) -> Bool {
  signedness_eq(
    a: v2.std.integer.integer_standard_integer_type_signedness(standard_integer_type: a),
    b: v2.std.integer.integer_standard_integer_type_signedness(standard_integer_type: b)
  )
    && (v2.std.integer.integer_standard_integer_type_width_bits(standard_integer_type: a) == v2.std.integer.integer_standard_integer_type_width_bits(standard_integer_type: b))
}

test fn from_node_round_trips_all_standard_types() -> Bool {
  v2.std.algebra.fold_list(
    xs: v2.std.integer.integer_standard_integer_type_roster,
    empty: true,
    cons: fn(acc, t) {
      let node = v2.std.integer.integer_interval_spec_node(spec: v2.std.integer.integer_standard_integer_type_interval_spec(standard_integer_type: t))
      acc && match v2.std.integer.integer_standard_integer_type_from_node(node: node) {
        v2.std.diagnostic.Accepted { value: decoded, diagnostics: _ } => standard_integer_type_eq(a: decoded, b: t)
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    }
  )
}
