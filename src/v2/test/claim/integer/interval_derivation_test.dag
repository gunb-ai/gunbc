module v2.test.claim.integer.interval_derivation


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data legacy_int8_spec: v2.std.integer.IntegerIntervalSpec = v2.std.integer.integer_interval(
  inclusive_min: v2.std.integer.integer_concrete_bound(sign: v2.std.integer.IntegerBoundNegative, magnitude: v2.std.integer.DecimalNonZeroMagnitude { lead: v2.std.integer.NonZeroD1, tail: [v2.std.integer.D2, v2.std.integer.D8] }),
  inclusive_max: v2.std.integer.integer_concrete_bound(sign: v2.std.integer.IntegerBoundNonNegative, magnitude: v2.std.integer.DecimalNonZeroMagnitude { lead: v2.std.integer.NonZeroD1, tail: [v2.std.integer.D2, v2.std.integer.D7] })
)

