// v2/test/claim/diagnostic_sequence_outcome_witness.dag
//
// Discriminating witnesses for sequence_outcome / append_outcome_value (DESIGN §5).
// Proves the DRY delegation path: empty list, ShortCircuit absorb, successful collect.

module v2.test.claim.diagnostic_sequence_outcome_witness

import v2.std.diagnostic {
  Outcome,
  Accepted,
  Rejected,
  StageDiagnosticPolicy,
  ShortCircuit,
  outcome_accepted,
  outcome_rejected,
  sequence_outcome,
  port_locus,
  Diagnostic,
  ExternalContractUnknown,
  Unavailable,
}
import v2.std.collection { List }

data short_circuit_policy: StageDiagnosticPolicy = StageDiagnosticPolicy { accumulation: ShortCircuit }

fn sample_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^sequence_outcome_witness_reason
    at: port_locus(port: ^sequence_outcome_witness_port)
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn witness_sequence_outcome_empty_accepts() -> Bool {
  match sequence_outcome(xs: [], policy: short_circuit_policy) {
    Accepted { value: vs, diagnostics: None } => vs.length() == 0
    Rejected { diagnostics: _ } => false
  }
}

fn witness_sequence_outcome_collects_values() -> Bool {
  match sequence_outcome(
    xs: [outcome_accepted(value: 1), outcome_accepted(value: 2)],
    policy: short_circuit_policy
  ) {
    Accepted { value: vs, diagnostics: None } =>
      (vs.length() == 2) && (vs.first() == 1) && (vs.skip(n: 1).first() == 2)
    Rejected { diagnostics: _ } => false
  }
}

// Discriminating: ShortCircuit absorbs at first Rejected (does not append later Accepted).
fn witness_sequence_outcome_short_circuits_on_reject() -> Bool {
  match sequence_outcome(
    xs: [
      outcome_accepted(value: 1),
      outcome_rejected(d: sample_diagnostic()),
      outcome_accepted(value: 99)
    ],
    policy: short_circuit_policy
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

fn diagnostic_sequence_outcome_witnesses() -> Bool {
  witness_sequence_outcome_empty_accepts()
    && witness_sequence_outcome_collects_values()
    && witness_sequence_outcome_short_circuits_on_reject()
}
