module v2.test.emit.ingested_classical_not_emit

import v2.compiler.emit_produced { emit_produced_decl_rust_with_target }
import v2.compiler.normalize { normalize }
import v2.compiler.parse { parse_module }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag {
  dag_classical_not_source_text,
  dag_language_model
}
import v2.extdeps.languages.rust {
  rust_produced_classical_not_target,
  rust_signature_with_open_from_decl
}
import extdeps.communication.medium { Medium }
import v2.std.collection { Optional, Present, Absent }
import v2.std.compilers.target_model { TargetModel }
import v2.std.diagnostic {
  Accepted,
  None,
  Outcome,
  Rejected,
  bind_outcome,
  outcome_accepted
}
import v2.std.logic { Bool }
import v2.std.node {
  Arrow,
  ComputationNode,
  Conj,
  Edge,
  Match,
  Named,
  Node,
  TypeNode,
  node_synthetic,
  well_formed
}
import v2.std.node_query { find_arrow_body_child }

data ingested_classical_not_module_source: String = concat(
  "module logic_probe\n\n",
  dag_classical_not_source_text,
  "\n"
)

data ingested_classical_not_emit_golden: String = "fn classical_not(a: Classical) -> Classical { match (a) { True => False, False => True } }"

fn ingested_classical_not_find_arrow_in_module(root: Node) -> Optional<Node> {
  match root.kind {
    TypeNode { connective: Arrow } => Present { value: root }
    _ =>
      fold(root.children, init: Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => ingested_classical_not_find_arrow_in_module(root: e.target)
        }
      })
  }
}

fn ingested_classical_not_normalized_module() -> Optional<Node> {
  let lm = dag_language_model()
  match tokenize(
    text: ingested_classical_not_module_source,
    file: ^ingested_classical_not_emit_source_file,
    rules: lm.lex
  ) {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: _ } => Absent
        Accepted { value: artifact, diagnostics: _ } =>
          match normalize(parse_tree: artifact.tree) {
            Rejected { diagnostics: _ } => Absent
            Accepted { value: tree, diagnostics: _ } => Present { value: tree }
          }
      }
  }
}

fn ingested_classical_not_ingested_arrow() -> Outcome<Node> {
  match ingested_classical_not_normalized_module() {
    Absent => Rejected { diagnostics: None }
    Present { value: tree } =>
      match ingested_classical_not_find_arrow_in_module(root: tree) {
        Absent => Rejected { diagnostics: None }
        Present { value: arrow } =>
          if well_formed(n: arrow) {
            outcome_accepted(value: arrow)
          } else {
            Rejected { diagnostics: None }
          }
      }
  }
}

fn ingested_classical_not_decl_from_arrow(arrow: Node) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^classical_not },
        target: arrow
      }
    ]
  )
}

fn ingested_classical_not_target_for_decl(decl: Node) -> Outcome<TargetModel> {
  bind_outcome(
    o: rust_signature_with_open_from_decl(decl: decl),
    f: fn(signature) {
      outcome_accepted(value: rust_produced_classical_not_target(signature_with_open: signature))
    }
  )
}

fn ingested_classical_not_emit_from_ingested() -> Outcome<Medium<String>> {
  bind_outcome(
    o: ingested_classical_not_ingested_arrow(),
    f: fn(arrow) {
      let decl = ingested_classical_not_decl_from_arrow(arrow: arrow)
      bind_outcome(
        o: ingested_classical_not_target_for_decl(decl: decl),
        f: fn(target) {
          emit_produced_decl_rust_with_target(decl: decl, target: target)
        }
      )
    }
  )
}

fn ingested_classical_not_arrow_has_match_body() -> Bool {
  match ingested_classical_not_ingested_arrow() {
    Accepted { value: arrow, diagnostics: _ } =>
      match find_arrow_body_child(root: arrow) {
        Accepted { value: body, diagnostics: _ } =>
          match body.kind {
            ComputationNode { behavior: Match } => true
            _ => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn ingested_classical_not_emit_accepts_holds() -> Bool {
  ingested_classical_not_arrow_has_match_body()
    && match ingested_classical_not_emit_from_ingested() {
      Accepted { value: source, diagnostics: d } =>
        (source.carried == ingested_classical_not_emit_golden) && (d == None)
      Rejected { diagnostics: _ } => false
    }
}
