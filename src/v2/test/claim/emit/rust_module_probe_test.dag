module v2.test.emit.rust_module_probe

import v2.compiler.body_producer { produce_mvp1_add_decl_node }
import v2.compiler.emit { emit }
import v2.compiler.emit_module { emit_module }
import v2.compiler.infer { InferredFacts, InferredTree }
import v2.extdeps.languages.rust { rust_mvp1_target_model_staging }
import v2.std.collection { Map }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  node_locus
}
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.witness { Violates, Witness }

data rust_module_probe_add_golden: String = "fn add(x: i32, y: i32) -> i32 { x + y }"

data rust_module_probe_two_golden: String = "fn add(x: i32, y: i32) -> i32 { x + y }\n\nfn add2(x: i32, y: i32) -> i32 { x + y }\n\n"

fn rust_module_probe_facts_miss(key: Node) -> Witness<InferredFacts> {
  Violates {
    diagnostic: Diagnostic {
      reason: ^rust_module_probe_facts_not_consulted,
      at: node_locus(node: key),
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  }
}

fn rust_module_probe_tree_for(root: Node) -> InferredTree {
  InferredTree {
    root: root,
    facts: Map { lookup: rust_module_probe_facts_miss }
  }
}

fn rust_module_probe_decl_tree(fn_name: Symbol) -> Outcome<InferredTree> {
  match produce_mvp1_add_decl_node(fn_name: fn_name) {
    Accepted { value: root, diagnostics: d } =>
      Accepted { value: rust_module_probe_tree_for(root: root), diagnostics: d }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn rust_module_probe_single_text() -> Outcome<String> {
  match rust_module_probe_decl_tree(fn_name: ^rust_binding_fn_add) {
    Accepted { value: tree, diagnostics: _ } =>
      match emit(tree: tree, target: rust_mvp1_target_model_staging()) {
        Accepted { value: medium, diagnostics: _ } =>
          Accepted { value: medium.carried, diagnostics: None }
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn rust_module_probe_two_text() -> Outcome<String> {
  match rust_module_probe_decl_tree(fn_name: ^rust_binding_fn_add) {
    Accepted { value: t1, diagnostics: _ } =>
      match rust_module_probe_decl_tree(fn_name: ^rust_binding_fn_add2) {
        Accepted { value: t2, diagnostics: _ } =>
          match emit_module(decls: [t1, t2], target: rust_mvp1_target_model_staging()) {
            Accepted { value: medium, diagnostics: _ } =>
              Accepted { value: medium.carried, diagnostics: None }
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
          }
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn rust_module_probe_matches(actual: Outcome<String>, golden: String) -> Bool {
  match actual {
    Accepted { value: text, diagnostics: _ } => text == golden
    Rejected { diagnostics: _ } => false
  }
}

test fn rust_module_probe_single_decl_emits_full_fn() -> Bool {
  rust_module_probe_matches(actual: rust_module_probe_single_text(), golden: rust_module_probe_add_golden)
}

test fn rust_module_probe_two_decls_assemble() -> Bool {
  rust_module_probe_matches(actual: rust_module_probe_two_text(), golden: rust_module_probe_two_golden)
}
