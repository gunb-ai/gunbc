module v2.test.emit.witness_coproduct_emit

import v2.compiler.translate {
  grammar_relation_row_for_emitted,
  grammar_relation_row_tokens_root,
  serialize_concrete_syntax_tokens_to_source
}
import v2.extdeps.languages.rust {
  rust_inhabitant_atom,
  rust_generic_enum_decl_productions_only_translation_rules,
  rust_generic_enum_decl_structural_target_model
}
import v2.test.emit.witness_record_emit {
  witness_emit_matches_golden,
  witness_hw_emitted,
  witness_hw_golden,
  witness_spw_emitted,
  witness_spw_golden
}
import v2.std.compilers.target_model {
  TargetModel,
  concrete_syntax_token_list_from_node
}
import v2.std.diagnostic {
  Accepted,
  Outcome,
  Rejected,
  bind_outcome,
  outcome_accepted
}
import v2.std.logic { Bool }
import v2.std.node {
  Conj,
  Edge,
  Node,
  Positional,
  Symbol,
  SyntheticOccurrence,
  TypeNode
}

data witness_coproduct_golden: String = "enum Witness<C> { Holds { value: C }, Violates { diagnostic: Diagnostic } }"

fn wc_sym(s: String) -> Symbol { s }

fn wc_nil() -> Node {
  Node { kind: TypeNode { connective: Conj }, children: [], occurrence_id: SyntheticOccurrence }
}

fn wc_pos(target: Node) -> Edge {
  Edge { label: Positional, target: target }
}

fn wc_qualified_name(t: Symbol) -> Node {
  Node { kind: TypeNode { connective: Conj }, children: [ wc_pos(target: rust_inhabitant_atom(id: t)) ], occurrence_id: SyntheticOccurrence }
}

fn wc_type_expr(t: Symbol) -> Node {
  Node { kind: TypeNode { connective: Conj }, children: [ wc_pos(target: wc_qualified_name(t: t)) ], occurrence_id: SyntheticOccurrence }
}

fn wc_field(name: Symbol, t: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [ wc_pos(target: rust_inhabitant_atom(id: name)), wc_pos(target: wc_type_expr(t: t)) ],
    occurrence_id: SyntheticOccurrence
  }
}

fn wc_field_list_cell(field: Node, rest: Node) -> Node {
  Node { kind: TypeNode { connective: Conj }, children: [ wc_pos(target: field), wc_pos(target: rest) ], occurrence_id: SyntheticOccurrence }
}

fn wc_field_block(field_list: Node) -> Node {
  Node { kind: TypeNode { connective: Conj }, children: [ wc_pos(target: field_list) ], occurrence_id: SyntheticOccurrence }
}

fn wc_single_field_block(fname: Symbol, ftype: Symbol) -> Node {
  wc_field_block(field_list: wc_field_list_cell(field: wc_field(name: fname, t: ftype), rest: wc_nil()))
}

fn wc_variant(name: Symbol, field_block: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [ wc_pos(target: rust_inhabitant_atom(id: name)), wc_pos(target: field_block) ],
    occurrence_id: SyntheticOccurrence
  }
}

fn wc_variant_list_cell(variant: Node, rest: Node) -> Node {
  Node { kind: TypeNode { connective: Conj }, children: [ wc_pos(target: variant), wc_pos(target: rest) ], occurrence_id: SyntheticOccurrence }
}

fn wc_variant_block(variant_list: Node) -> Node {
  Node { kind: TypeNode { connective: Conj }, children: [ wc_pos(target: variant_list) ], occurrence_id: SyntheticOccurrence }
}

fn wc_type_param_cell(param: Symbol, rest: Node) -> Node {
  Node { kind: TypeNode { connective: Conj }, children: [ wc_pos(target: rust_inhabitant_atom(id: param)), wc_pos(target: rest) ], occurrence_id: SyntheticOccurrence }
}

fn wc_params(type_param_list: Node) -> Node {
  Node { kind: TypeNode { connective: Conj }, children: [ wc_pos(target: type_param_list) ], occurrence_id: SyntheticOccurrence }
}

fn wc_enum_decl(name: Symbol, params: Node, variant_block: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [ wc_pos(target: rust_inhabitant_atom(id: name)), wc_pos(target: params), wc_pos(target: variant_block) ],
    occurrence_id: SyntheticOccurrence
  }
}

fn witness_coproduct_emitted() -> Node {
  wc_enum_decl(
    name: wc_sym(s: "Witness"),
    params: wc_params(type_param_list: wc_type_param_cell(param: wc_sym(s: "C"), rest: wc_nil())),
    variant_block: wc_variant_block(
      variant_list: wc_variant_list_cell(
        variant: wc_variant(
          name: wc_sym(s: "Holds"),
          field_block: wc_single_field_block(fname: wc_sym(s: "value"), ftype: wc_sym(s: "C"))
        ),
        rest: wc_variant_list_cell(
          variant: wc_variant(
            name: wc_sym(s: "Violates"),
            field_block: wc_single_field_block(fname: wc_sym(s: "diagnostic"), ftype: wc_sym(s: "Diagnostic"))
          ),
          rest: wc_nil()
        )
      )
    )
  )
}

fn wc_target() -> TargetModel {
  rust_generic_enum_decl_structural_target_model()
}

fn wc_emit_source_text(emitted: Node) -> Outcome<String> {
  bind_outcome(
    o: grammar_relation_row_for_emitted(
      rules: rust_generic_enum_decl_productions_only_translation_rules(),
      emitted: emitted
    ),
    f: fn(row) {
      bind_outcome(
        o: grammar_relation_row_tokens_root(row: row),
        f: fn(tokens_root) {
          bind_outcome(
            o: concrete_syntax_token_list_from_node(list_node: tokens_root),
            f: fn(tokens) {
              bind_outcome(
                o: serialize_concrete_syntax_tokens_to_source(target: wc_target(), tokens: tokens),
                f: fn(medium) { outcome_accepted(value: medium.carried) }
              )
            }
          )
        }
      )
    }
  )
}

fn wc_emit_matches_golden(emitted: Node, golden: String) -> Bool {
  match wc_emit_source_text(emitted: emitted) {
    Accepted { value: text, diagnostics: _ } => text == golden
    Rejected { diagnostics: _ } => false
  }
}

fn witness_coproduct_covered_holds() -> Bool {
  wc_emit_matches_golden(emitted: witness_coproduct_emitted(), golden: witness_coproduct_golden)
}

fn witness_coproduct_golden_discriminates_holds() -> Bool {
  !wc_emit_matches_golden(emitted: witness_coproduct_emitted(), golden: "enum Witness<C> { Holds { value: C }, Violates { diagnostic: DIAGNOSTIC } }")
}

fn witness_module_fully_emitted_holds() -> Bool {
  witness_emit_matches_golden(emitted: witness_spw_emitted(), golden: witness_spw_golden)
    && witness_emit_matches_golden(emitted: witness_hw_emitted(), golden: witness_hw_golden)
    && witness_coproduct_covered_holds()
}

test fn witness_coproduct_emit_holds() -> Bool {
  witness_coproduct_covered_holds()
    && witness_coproduct_golden_discriminates_holds()
    && witness_module_fully_emitted_holds()
}
