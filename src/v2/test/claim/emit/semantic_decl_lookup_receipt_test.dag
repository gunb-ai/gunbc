module v2.test.emit.semantic_decl_lookup_receipt_test


data expected_derive_spelling: String = v2.extdeps.languages.rust.rust_decl_derive_lex_spelling(text: extdeps.languages.rust.emit.rust_enum_derives_copy)

test fn row_lookup_returns_derive_spelling() -> Bool {
  match v2.std.compilers.semantic_decl_emission.semantic_decl_emission_from_target(target: v2.extdeps.languages.rust.rust_target_model()) {
    v2.std.diagnostic.Accepted { value: emission, diagnostics: _ } =>
      match v2.std.compilers.semantic_decl_emission.semantic_decl_binding_spelling_lookup(
        profile: emission.enum_serialize_profile,
        binding: ^rust_decl_derive_enum_copy_binding
      ) {
        v2.std.diagnostic.Accepted { value: spelling, diagnostics: _ } => spelling == expected_derive_spelling
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn map_lookup_returns_derive_spelling() -> Bool {
  match v2.std.compilers.semantic_decl_emission.semantic_decl_emission_from_target(target: v2.extdeps.languages.rust.rust_target_model()) {
    v2.std.diagnostic.Accepted { value: emission, diagnostics: _ } =>
      match v2.std.compilers.semantic_decl_emission.semantic_decl_profile_binding_spellings(profile: emission.enum_serialize_profile) {
        v2.std.diagnostic.Accepted { value: decoded_bindings, diagnostics: _ } =>
          match v2.std.compilers.target_model.bound_spelling_from_map(
            binding_spellings: decoded_bindings,
            binding: ^rust_decl_derive_enum_copy_binding
          ) {
            v2.std.diagnostic.Accepted { value: spelling, diagnostics: _ } => spelling == expected_derive_spelling
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn live_map_returns_derive_spelling() -> Bool {
  match v2.std.compilers.target_model.bound_spelling_from_map(
    binding_spellings: v2.extdeps.languages.rust.rust_decl_derive_binding_spellings(),
    binding: ^rust_decl_derive_enum_copy_binding
  ) {
    v2.std.diagnostic.Accepted { value: spelling, diagnostics: _ } => spelling == expected_derive_spelling
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}
