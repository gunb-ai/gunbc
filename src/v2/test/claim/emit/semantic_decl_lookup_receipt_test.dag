module v2.test.emit.semantic_decl_lookup_receipt_test

import v2.extdeps.languages.rust {
  rust_decl_derive_binding_spellings,
  rust_decl_derive_lex_spelling,
  rust_semantic_decl_serialize_profile_bundle_node
}
import extdeps.languages.rust.emit { rust_enum_derives_copy }
import v2.std.compilers.semantic_decl_emission {
  decode_semantic_decl_serialize_profile_bundle,
  semantic_decl_binding_spelling_lookup,
  semantic_decl_profile_binding_spellings
}
import v2.std.compilers.target_model { bound_spelling_from_map }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.text { String }

data expected_derive_spelling: String = rust_decl_derive_lex_spelling(text: rust_enum_derives_copy)

test fn row_lookup_returns_derive_spelling() -> Bool {
  match decode_semantic_decl_serialize_profile_bundle(
    bundle: rust_semantic_decl_serialize_profile_bundle_node()
  ) {
    Accepted { value: profile, diagnostics: _ } =>
      match semantic_decl_binding_spelling_lookup(
        profile: profile,
        binding: ^rust_decl_derive_enum_copy_binding
      ) {
        Accepted { value: spelling, diagnostics: _ } => spelling == expected_derive_spelling
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn map_lookup_returns_derive_spelling() -> Bool {
  match decode_semantic_decl_serialize_profile_bundle(
    bundle: rust_semantic_decl_serialize_profile_bundle_node()
  ) {
    Accepted { value: profile, diagnostics: _ } =>
      match semantic_decl_profile_binding_spellings(profile: profile) {
        Accepted { value: decoded_bindings, diagnostics: _ } =>
          match bound_spelling_from_map(
            binding_spellings: decoded_bindings,
            binding: ^rust_decl_derive_enum_copy_binding
          ) {
            Accepted { value: spelling, diagnostics: _ } => spelling == expected_derive_spelling
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn live_map_returns_derive_spelling() -> Bool {
  match bound_spelling_from_map(
    binding_spellings: rust_decl_derive_binding_spellings(),
    binding: ^rust_decl_derive_enum_copy_binding
  ) {
    Accepted { value: spelling, diagnostics: _ } => spelling == expected_derive_spelling
    Rejected { diagnostics: _ } => false
  }
}
