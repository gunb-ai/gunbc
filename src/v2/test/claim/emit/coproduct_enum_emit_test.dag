module v2.test.emit.coproduct_enum_emit

import v2.compiler.translate {
  grammar_relation_row_for_emitted,
  grammar_relation_row_tokens_root,
  serialize_concrete_syntax_tokens_to_source
}
import v2.extdeps.languages.rust {
  rust_inhabitant_atom,
  rust_enum_decl_productions_only_translation_rules,
  rust_enum_decl_structural_target_model
}
import v2.std.algebra { fold_list, fold_list_right }
import v2.std.collection { List }
import v2.std.compilers.target_model {
  TargetModel,
  concrete_syntax_token_list_from_node
}
import v2.std.diagnostic {
  Accepted,
  Outcome,
  Rejected,
  bind_outcome,
  outcome_accepted
}
import v2.std.integer { Int }
import v2.std.logic { Bool }
import v2.std.node {
  Conj,
  Edge,
  Node,
  Positional,
  Symbol,
  SyntheticOccurrence,
  TypeNode
}

data coproduct_bool_enum_golden: String = "enum Bool { True, False }"
data coproduct_execution_mode_enum_golden: String = "enum ExecutionMode { Hermetic, Wet, Record }"
data coproduct_artifact_kind_enum_golden: String = "enum ArtifactKind { SourceFile, GeneratedSource, TestClaimArtifact, ProjectionArtifact, Stage0Candidate, CorePackage, WitnessBundle }"

fn coproduct_interned_symbol(spelling: String) -> Symbol {
  spelling
}

fn coproduct_variant_nil() -> Node {
  Node { kind: TypeNode { connective: Conj }, children: [], occurrence_id: SyntheticOccurrence }
}

fn coproduct_variant_cell(variant: Symbol, rest: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Positional, target: rust_inhabitant_atom(id: variant) },
      Edge { label: Positional, target: rest }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn coproduct_variant_list_from(names: List<String>) -> Node {
  fold_list_right(
    xs: names,
    empty: coproduct_variant_nil(),
    snoc: fn(acc, name) {
      coproduct_variant_cell(variant: coproduct_interned_symbol(spelling: name), rest: acc)
    }
  )
}

fn coproduct_variant_block(variants: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [ Edge { label: Positional, target: variants } ],
    occurrence_id: SyntheticOccurrence
  }
}

fn coproduct_enum_emitted(name: Symbol, variants: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Positional, target: rust_inhabitant_atom(id: name) },
      Edge { label: Positional, target: coproduct_variant_block(variants: variants) }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn coproduct_enum_from_names(name: String, variant_names: List<String>) -> Node {
  coproduct_enum_emitted(
    name: coproduct_interned_symbol(spelling: name),
    variants: coproduct_variant_list_from(names: variant_names)
  )
}

fn coproduct_bool_enum_emitted() -> Node {
  coproduct_enum_from_names(name: "Bool", variant_names: ["True", "False"])
}

fn coproduct_execution_mode_enum_emitted() -> Node {
  coproduct_enum_from_names(name: "ExecutionMode", variant_names: ["Hermetic", "Wet", "Record"])
}

fn coproduct_artifact_kind_enum_emitted() -> Node {
  coproduct_enum_from_names(
    name: "ArtifactKind",
    variant_names: [
      "SourceFile", "GeneratedSource", "TestClaimArtifact", "ProjectionArtifact",
      "Stage0Candidate", "CorePackage", "WitnessBundle"
    ]
  )
}

fn coproduct_target() -> TargetModel {
  rust_enum_decl_structural_target_model()
}

fn coproduct_emit_source_text(emitted: Node) -> Outcome<String> {
  bind_outcome(
    o: grammar_relation_row_for_emitted(
      rules: rust_enum_decl_productions_only_translation_rules(),
      emitted: emitted
    ),
    f: fn(row) {
      bind_outcome(
        o: grammar_relation_row_tokens_root(row: row),
        f: fn(tokens_root) {
          bind_outcome(
            o: concrete_syntax_token_list_from_node(list_node: tokens_root),
            f: fn(tokens) {
              bind_outcome(
                o: serialize_concrete_syntax_tokens_to_source(target: coproduct_target(), tokens: tokens),
                f: fn(medium) { outcome_accepted(value: medium.carried) }
              )
            }
          )
        }
      )
    }
  )
}

fn coproduct_emit_matches_golden(emitted: Node, golden: String) -> Bool {
  match coproduct_emit_source_text(emitted: emitted) {
    Accepted { value: text, diagnostics: _ } => text == golden
    Rejected { diagnostics: _ } => false
  }
}

fn coproduct_construct_refused(emitted: Node) -> Bool {
  match coproduct_emit_source_text(emitted: emitted) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

fn coproduct_variant_payload_enum_emitted() -> Node {
  coproduct_enum_emitted(
    name: coproduct_interned_symbol(spelling: "Witness"),
    variants: coproduct_variant_cell(
      variant: coproduct_interned_symbol(spelling: "Holds"),
      rest: Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge {
            label: Positional,
            target: Node {
              kind: TypeNode { connective: Conj },
              children: [
                Edge { label: Positional, target: rust_inhabitant_atom(id: coproduct_interned_symbol(spelling: "Violates")) },
                Edge { label: Positional, target: rust_inhabitant_atom(id: coproduct_interned_symbol(spelling: "diagnostic")) }
              ],
              occurrence_id: SyntheticOccurrence
            }
          },
          Edge { label: Positional, target: coproduct_variant_nil() }
        ],
        occurrence_id: SyntheticOccurrence
      }
    )
  )
}

fn coproduct_generic_param_enum_emitted() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Positional, target: rust_inhabitant_atom(id: coproduct_interned_symbol(spelling: "Witness")) },
      Edge { label: Positional, target: rust_inhabitant_atom(id: coproduct_interned_symbol(spelling: "C")) },
      Edge { label: Positional, target: coproduct_variant_block(variants: coproduct_variant_list_from(names: ["Holds"])) }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

type CoproductEmitConstructRow {
  construct: Symbol
  covered: Bool
}

data coproduct_emit_construct_rows: List<CoproductEmitConstructRow> = [
  CoproductEmitConstructRow { construct: ^enum_bool_two_variants, covered: true },
  CoproductEmitConstructRow { construct: ^enum_execution_mode_three_variants, covered: true },
  CoproductEmitConstructRow { construct: ^enum_artifact_kind_seven_variants, covered: true },
  CoproductEmitConstructRow { construct: ^enum_named_variant_payload, covered: false },
  CoproductEmitConstructRow { construct: ^enum_generic_parameter, covered: false }
]

fn coproduct_covered_count() -> Int {
  fold_list(xs: coproduct_emit_construct_rows, empty: 0, cons: fn(acc, row) { if row.covered { acc + 1 } else { acc } })
}

fn coproduct_refused_count() -> Int {
  fold_list(xs: coproduct_emit_construct_rows, empty: 0, cons: fn(acc, row) { if row.covered { acc } else { acc + 1 } })
}

fn coproduct_variable_arity_covered_holds() -> Bool {
  coproduct_emit_matches_golden(emitted: coproduct_bool_enum_emitted(), golden: coproduct_bool_enum_golden)
    && coproduct_emit_matches_golden(emitted: coproduct_execution_mode_enum_emitted(), golden: coproduct_execution_mode_enum_golden)
    && coproduct_emit_matches_golden(emitted: coproduct_artifact_kind_enum_emitted(), golden: coproduct_artifact_kind_enum_golden)
}

fn coproduct_golden_discriminates_holds() -> Bool {
  !coproduct_emit_matches_golden(emitted: coproduct_bool_enum_emitted(), golden: coproduct_execution_mode_enum_golden)
    && !coproduct_emit_matches_golden(emitted: coproduct_bool_enum_emitted(), golden: "enum Bool { True, FALSE }")
}

fn coproduct_gaps_refused_holds() -> Bool {
  coproduct_construct_refused(emitted: coproduct_variant_payload_enum_emitted())
    && coproduct_construct_refused(emitted: coproduct_generic_param_enum_emitted())
    && (coproduct_refused_count() == 2)
    && (coproduct_covered_count() == 3)
}

test fn coproduct_enum_emit_holds() -> Bool {
  coproduct_variable_arity_covered_holds()
    && coproduct_golden_discriminates_holds()
    && coproduct_gaps_refused_holds()
}
