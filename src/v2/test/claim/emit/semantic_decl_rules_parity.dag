module v2.test.claim.emit.semantic_decl_rules_parity

import v2.compiler.emit_semantic_decl { emit_surface_with_leading_columns, produced_type_binding }
import std.occurrence_identity { OccurrenceSynthetic }
import v2.compiler.target_serialize { grammar_relation_row_for_emitted, grammar_relation_row_tokens_root }
import v2.extdeps.languages.rust {
  rust_enum_general_decl_productions_only_translation_rules
}
import v2.extdeps.languages.rust_fixtures { rust_semantic_decl_target_model_staging }
import v2.std.compilers.semantic_decl_emission { ConformancesTargetDefault,
  semantic_decl_emission_from_target,
  target_semantic_enum_surface_from_coproduct
}
import v2.std.compilers.semantic_decl_emission { TargetSemanticDeclConformances, TargetSemanticDeclSurfaceProjection }
import v2.std.compilers.target_model { concrete_syntax_token_list_from_node }
import v2.std.diagnostic { Accepted, Outcome, Rejected, bind_outcome }
import v2.std.node { Conj, Disj, Edge, Authored, Node, Symbol, TypeNode, NotADeclaration }
import std.algebra { Empty }

fn bool_coproduct() -> Node {
  Node {
    kind: TypeNode { connective: Disj },
    children: [
      Edge { label: Authored { name: ^True }, target: Node { kind: TypeNode { connective: Conj }, children: [], occurrence_id: OccurrenceSynthetic }, declaration: NotADeclaration },
      Edge { label: Authored { name: ^False }, target: Node { kind: TypeNode { connective: Conj }, children: [], occurrence_id: OccurrenceSynthetic }, declaration: NotADeclaration }
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

// A bare enum surface wrapped by the declaration route's own leading-column function (no docs, imports or header), so
// the claims join rules over the surface emit_semantic_type_decl builds and not a hand-built variant of it.
fn parity_enum_surface(
  projection: TargetSemanticDeclSurfaceProjection,
  name: Symbol,
  params: List<Symbol>,
  coproduct: Node,
  conformances: TargetSemanticDeclConformances,
  type_binding: fn(Node) -> Outcome<Symbol>
) -> Outcome<Node> {
  bind_outcome(
    o: target_semantic_enum_surface_from_coproduct(
      projection: projection,
      name: name,
      params: params,
      coproduct: coproduct,
      conformances: conformances,
      type_binding: type_binding
    ),
    f: fn(bare) { emit_surface_with_leading_columns(projection: projection, docs: [], imports: [], header: [], surface: bare) }
  )
}

fn tokens_for_rules(surface: Node, rules: Node) -> Bool {
  match grammar_relation_row_for_emitted(rules: rules, emitted: surface) {
    Accepted { value: row, diagnostics: _ } =>
      match grammar_relation_row_tokens_root(row: row) {
        Accepted { value: tokens_root, diagnostics: _ } =>
          match concrete_syntax_token_list_from_node(list_node: tokens_root) {
            Accepted { value: _, diagnostics: _ } => true
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn emission_rules_match_rust_rules_for_generic_surface() -> Bool {
  match semantic_decl_emission_from_target(target: rust_semantic_decl_target_model_staging()) {
    Accepted { value: emission, diagnostics: _ } =>
      match parity_enum_surface(
        projection: emission.surface,
        name: ^Bool,
        params: Empty,
        coproduct: bool_coproduct(),
        conformances: ConformancesTargetDefault,
        type_binding: produced_type_binding(target: rust_semantic_decl_target_model_staging())
      ) {
        Accepted { value: surface, diagnostics: _ } =>
          tokens_for_rules(surface: surface, rules: emission.enum_translation_rules)
            && tokens_for_rules(
              surface: surface,
              rules: rust_enum_general_decl_productions_only_translation_rules()
            )
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}
