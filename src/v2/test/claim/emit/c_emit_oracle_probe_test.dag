module v2.test.emit.c_emit_oracle_probe_test

import v2.compiler.emit_semantic_decl { emit_semantic_type_decl }
import v2.extdeps.languages.c { c_target_model }
import v2.test.emit.c_semantic_decl_routing { cdr_point_record }
import std.algebra { Empty }
import v2.std.algebra { fold_list }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }

fn emit_point_text() -> String {
  match emit_semantic_type_decl(
    name: ^Point,
    params: Empty,
    node: cdr_point_record(),
    target: c_target_model()
  ) {
    Accepted { value: medium, diagnostics: _ } => medium.carried
    Rejected { diagnostics: _ } => ""
  }
}

fn str_len(s: String) -> Int {
  fold_list(xs: s, empty: 0, cons: fn(acc, _) { acc + 1 })
}

test fn c_emit_len_35_holds() -> Bool { str_len(s: emit_point_text()) == 35 }
test fn c_emit_len_39_holds() -> Bool { str_len(s: emit_point_text()) == 39 }

test fn c_emit_oracle_int_y_x_holds() -> Bool {
  emit_point_text() == concat("typedef struct ", "{ int y; x; } Point;")
}

test fn c_emit_oracle_x_int_y_holds() -> Bool {
  emit_point_text() == concat("typedef struct ", "{ x; int y; } Point;")
}

test fn c_emit_oracle_int_semi_x_y_holds() -> Bool {
  emit_point_text() == concat("typedef struct ", "{ int; x y; } Point;")
}

test fn c_emit_oracle_missing_int_y_holds() -> Bool {
  emit_point_text() == concat("typedef struct ", "{ int x; y; } Point;")
}
