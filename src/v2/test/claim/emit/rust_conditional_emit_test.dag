module v2.test.emit.rust_conditional_emit


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data rust_conditional_emit_swapped_source_text: String = "fn one_or_two() -> i32 { if true { 2 } else { 1 } }"

fn rust_conditional_emit_facts_miss(key: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  optional_absent()
}

fn rust_conditional_emit_inferred_tree_for(root: Node) -> v2.compiler.infer.InferredTree {
  v2.compiler.infer.InferredTree {
    root: root,
    facts: std.types.Map { lookup: rust_conditional_emit_facts_miss }
  }
}

fn rust_conditional_emit_producer_inferred_tree() -> v2.std.diagnostic.Outcome<v2.compiler.infer.InferredTree> {
  match table_fixture_pick_if_arrow_with_body() {
    v2.std.diagnostic.Accepted { value: root, diagnostics: d } =>
      v2.std.diagnostic.Accepted {
        value: rust_conditional_emit_inferred_tree_for(root: root),
        diagnostics: d
      }
    v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn rust_conditional_emit_swapped_producer_inferred_tree() -> v2.std.diagnostic.Outcome<v2.compiler.infer.InferredTree> {
  match table_fixture_pick_if_arrow_with_body_swapped_arms() {
    v2.std.diagnostic.Accepted { value: root, diagnostics: d } =>
      v2.std.diagnostic.Accepted {
        value: rust_conditional_emit_inferred_tree_for(root: root),
        diagnostics: d
      }
    v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn rust_conditional_emit_from_tree(target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<Medium<String>> {
  bind_outcome(
    o: rust_conditional_emit_producer_inferred_tree(),
    f: fn(tree) {
      emit(tree: tree, target: target)
    }
  )
}

fn rust_conditional_emit_from_swapped_tree(target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<Medium<String>> {
  bind_outcome(
    o: rust_conditional_emit_swapped_producer_inferred_tree(),
    f: fn(tree) {
      emit(tree: tree, target: target)
    }
  )
}

test fn rust_conditional_emit_pick_fn_accepts() -> Bool {
  match rust_conditional_emit_from_tree(target: rust_pick_target_model_staging()) {
    v2.std.diagnostic.Accepted { value: source, diagnostics: d } =>
      (source.carried == rust_pick_source_text) && (d == v2.std.diagnostic.None)
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn rust_conditional_emit_swapped_arms_discriminates() -> Bool {
  match rust_conditional_emit_from_swapped_tree(target: rust_pick_target_model_staging()) {
    v2.std.diagnostic.Accepted { value: source, diagnostics: d } =>
      (source.carried == rust_conditional_emit_swapped_source_text) &&
      (source.carried != rust_pick_source_text) &&
      (d == v2.std.diagnostic.None)
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

