module v2.test.emit.rust_conditional_emit

import v2.test.complexity_gate.table_fixture_branch_subject_producer {
  table_fixture_pick_if_arrow_with_body,
  table_fixture_pick_if_arrow_with_body_swapped_arms
}
import v2.compiler.emit { emit }
import v2.compiler.infer { InferredFacts, InferredTree }
import v2.extdeps.languages.rust_test {
  rust_pick_source_text,
  rust_pick_target_model_staging
}
import extdeps.communication.medium { Medium }
import v2.std.collection {
  Map
}
import v2.std.optional {
  Optional,
  Present,
  Absent,
  optional_present,
  optional_absent
}
import v2.std.compilers.target_model { TargetModel }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  bind_outcome,
  node_locus
}
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.witness { Violates, Witness }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data rust_conditional_emit_swapped_source_text: String = "fn one_or_two() -> i32 { if true { 2 } else { 1 } }"

fn rust_conditional_emit_facts_miss(key: Node) -> Optional<InferredFacts> {
  optional_absent()
}

fn rust_conditional_emit_inferred_tree_for(root: Node) -> InferredTree {
  InferredTree {
    root: root,
    facts: Map { lookup: rust_conditional_emit_facts_miss }
  }
}

fn rust_conditional_emit_producer_inferred_tree() -> Outcome<InferredTree> {
  match table_fixture_pick_if_arrow_with_body() {
    Accepted { value: root, diagnostics: d } =>
      Accepted {
        value: rust_conditional_emit_inferred_tree_for(root: root),
        diagnostics: d
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn rust_conditional_emit_swapped_producer_inferred_tree() -> Outcome<InferredTree> {
  match table_fixture_pick_if_arrow_with_body_swapped_arms() {
    Accepted { value: root, diagnostics: d } =>
      Accepted {
        value: rust_conditional_emit_inferred_tree_for(root: root),
        diagnostics: d
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn rust_conditional_emit_from_tree(target: TargetModel) -> Outcome<Medium<String>> {
  bind_outcome(
    o: rust_conditional_emit_producer_inferred_tree(),
    f: fn(tree) {
      emit(tree: tree, target: target)
    }
  )
}

fn rust_conditional_emit_from_swapped_tree(target: TargetModel) -> Outcome<Medium<String>> {
  bind_outcome(
    o: rust_conditional_emit_swapped_producer_inferred_tree(),
    f: fn(tree) {
      emit(tree: tree, target: target)
    }
  )
}

fn rust_conditional_emit_pick_fn_accepts() -> Bool {
  match rust_conditional_emit_from_tree(target: rust_pick_target_model_staging()) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == rust_pick_source_text) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

fn rust_conditional_emit_swapped_arms_discriminates() -> Bool {
  match rust_conditional_emit_from_swapped_tree(target: rust_pick_target_model_staging()) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == rust_conditional_emit_swapped_source_text) &&
      (source.carried != rust_pick_source_text) &&
      (d == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn rust_conditional_emit_holds() -> Bool {
  rust_conditional_emit_pick_fn_accepts()
    && rust_conditional_emit_swapped_arms_discriminates()
}
