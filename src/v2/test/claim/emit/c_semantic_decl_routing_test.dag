fn cdr_answer_text() -> String {
  match cdr_emit_text(name: ^Answer, node: cdr_answer_coproduct()) {
    Accepted { value: text, diagnostics: _ } => text
    Rejected { diagnostics: _ } => ""
  }
}

test fn c_semantic_answer_surface_builds_holds() -> Bool {
  match semantic_decl_emission_from_target(target: c_target_model()) {
    Accepted { value: emission, diagnostics: _ } =>
      match target_semantic_enum_surface_from_coproduct(
        projection: emission.surface,
        name: ^Answer,
        params: Empty,
        coproduct: cdr_answer_coproduct()
      ) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn c_semantic_answer_grammar_row_holds() -> Bool {
  match semantic_decl_emission_from_target(target: c_target_model()) {
    Accepted { value: emission, diagnostics: _ } =>
      match target_semantic_enum_surface_from_coproduct(
        projection: emission.surface,
        name: ^Answer,
        params: Empty,
        coproduct: cdr_answer_coproduct()
      ) {
        Accepted { value: surface, diagnostics: _ } =>
          match grammar_relation_row_for_emitted(
            rules: emission.enum_translation_rules,
            emitted: surface
          ) {
            Accepted { value: _, diagnostics: _ } => true
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn c_semantic_answer_emit_accepted_holds() -> Bool {
  match cdr_emit_text(name: ^Answer, node: cdr_answer_coproduct()) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

