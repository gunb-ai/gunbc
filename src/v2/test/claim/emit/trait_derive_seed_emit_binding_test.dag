module v2.test.emit.trait_derive_seed_emit_binding_test

import std.trait_derive_shape {
  ReprDeriveClone,
  ReprDerivePartialEq,
  ReprDeriveSerialize,
  ReprDeriveElemNullaryEnumCopy,
  nullary_coproduct_derive_traits,
  record_derive_traits_heap,
  record_derive_traits_copy,
  trait_derive_attr_from_traits,
  repr_grounding_derive_completeness_predicate
}
import v2.std.logic { Bool }

data trait_derive_seed_emit_binding_note: String = "Layer-boundary mock: std.trait_derive_shape trait lists → derive attr spellings consumed by v1.compiler.trait_derive_emit (same authority path as seed emitter)."

test fn nullary_coproduct_predicate_satisfied() -> Bool {
  repr_grounding_derive_completeness_predicate(
    nullary_coproduct_derive_traits(),
    ReprDeriveElemNullaryEnumCopy
  )
}

test fn record_heap_attr_contains_serde() -> Bool {
  let heap_attr = trait_derive_attr_from_traits(record_derive_traits_heap())
  let copy_attr = trait_derive_attr_from_traits(record_derive_traits_copy())
  heap_attr != "" && heap_attr != copy_attr
}

test fn trait_derive_seed_emit_binding_witness_holds() -> Bool {
  nullary_coproduct_predicate_satisfied() && record_heap_attr_contains_serde()
}
