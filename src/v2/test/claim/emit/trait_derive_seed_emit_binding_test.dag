module v2.test.emit.trait_derive_seed_emit_binding_test

import std.trait_derive_shape {
  ReprDeriveElemNullaryEnumCopy,
  ReprDeriveElemPayloadCoproduct,
  ReprDeriveElemSymbolWrappedOrdCarrier,
  ReprDeriveElemKernelInt,
  nullary_coproduct_derive_traits,
  payload_coproduct_derive_traits,
  symbol_wrapped_ord_carrier_derive_traits,
  record_derive_traits_heap,
  record_derive_traits_copy,
  repr_grounding_derive_completeness_predicate,
  repr_grounding_supplemental_commutative_semiring_target,
  repr_grounding_supplemental_bool_host_bridge_target,
  kernel_int_arithmetic_traits
}
import extdeps.languages.rust.emit {
  rust_trait_derive_attr_from_traits,
  rust_supplemental_impls_commutative_semiring_magnitude,
  rust_supplemental_impls_bool_coproduct
}
import v2.std.logic { Bool }

data trait_derive_seed_emit_binding_note: String = "Layer-boundary mock: std.trait_derive_shape trait lists + supplemental target predicates → extdeps.languages.rust.emit spellings (same authorities v1.compiler.trait_derive_emit composes for seed emit; v1 module not importable from v2 claim closure)."

test fn nullary_coproduct_predicate_satisfied() -> Bool {
  repr_grounding_derive_completeness_predicate(
    nullary_coproduct_derive_traits(),
    ReprDeriveElemNullaryEnumCopy
  )
}

test fn record_heap_attr_contains_serde() -> Bool {
  let heap_attr = rust_trait_derive_attr_from_traits(record_derive_traits_heap())
  let copy_attr = rust_trait_derive_attr_from_traits(record_derive_traits_copy())
  heap_attr != "" && heap_attr != copy_attr
}

test fn ord_carrier_shape_rejects_nullary_copy_traits() -> Bool {
  repr_grounding_derive_completeness_predicate(
    nullary_coproduct_derive_traits(),
    ReprDeriveElemSymbolWrappedOrdCarrier
  ) == false
}

test fn ord_carrier_attr_differs_from_nullary() -> Bool {
  let ord_attr = rust_trait_derive_attr_from_traits(symbol_wrapped_ord_carrier_derive_traits())
  let nullary_attr = rust_trait_derive_attr_from_traits(nullary_coproduct_derive_traits())
  ord_attr != "" && ord_attr != nullary_attr
}

test fn payload_coproduct_predicate_satisfied() -> Bool {
  repr_grounding_derive_completeness_predicate(
    payload_coproduct_derive_traits(),
    ReprDeriveElemPayloadCoproduct
  )
}

test fn commutative_semiring_supplemental_impl_present() -> Bool {
  let supplemental = rust_supplemental_impls_commutative_semiring_magnitude()
  let target_ok = repr_grounding_supplemental_commutative_semiring_target(
    module_path: "std.algebra",
    name: "CommutativeSemiring"
  )
  let predicate_ok = repr_grounding_derive_completeness_predicate(
    kernel_int_arithmetic_traits(),
    ReprDeriveElemKernelInt
  )
  let wrong_module = repr_grounding_supplemental_commutative_semiring_target(
    module_path: "std.magma",
    name: "CommutativeSemiring"
  )
  let wrong_name = repr_grounding_supplemental_commutative_semiring_target(
    module_path: "std.algebra",
    name: "Magma"
  )
  target_ok
    && predicate_ok
    && supplemental != ""
    && supplemental.contains("unimplemented!")
    && wrong_module == false
    && wrong_name == false
}

test fn bool_supplemental_impl_present() -> Bool {
  let supplemental = rust_supplemental_impls_bool_coproduct()
  let target_ok = repr_grounding_supplemental_bool_host_bridge_target(
    module_path: "std.types",
    name: "Bool"
  )
  let predicate_ok = repr_grounding_derive_completeness_predicate(
    nullary_coproduct_derive_traits(),
    ReprDeriveElemNullaryEnumCopy
  )
  let wrong_module = repr_grounding_supplemental_bool_host_bridge_target(
    module_path: "std.logic",
    name: "Bool"
  )
  let wrong_name = repr_grounding_supplemental_bool_host_bridge_target(
    module_path: "std.types",
    name: "Quantity"
  )
  target_ok && predicate_ok && supplemental != "" && wrong_module == false && wrong_name == false
}

test fn trait_derive_seed_emit_binding_witness_holds() -> Bool {
  nullary_coproduct_predicate_satisfied()
    && payload_coproduct_predicate_satisfied()
    && record_heap_attr_contains_serde()
    && ord_carrier_shape_rejects_nullary_copy_traits()
    && ord_carrier_attr_differs_from_nullary()
    && commutative_semiring_supplemental_impl_present()
    && bool_supplemental_impl_present()
}
