module v2.test.emit.typescript_binop_emit

import v2.compiler.translate { serialize_concrete_syntax_tokens_to_source_string }
import v2.std.compilers.target_model {
  render_target_text,
  ProducedDeclUnwired,
  CanonicalOperation,
  TargetModel,
  TargetValueExpression,
  canonical_operation_op_add,
  canonical_operation_op_sub,
  canonical_operation_op_mul,
  canonical_operation_op_div,
  canonical_operation_op_and,
  canonical_operation_op_or,
  canonical_operation_op_lt,
  canonical_operation_op_le,
  canonical_operation_op_gt,
  canonical_operation_op_ge,
  canonical_operation_op_eq,
  canonical_operation_op_ne,
  target_model_emit_transforms_empty,
  target_operator_realization_node,
  target_operator_realizations_catalog_node,
  target_value_expression_binding_ref,
  target_value_expression_primitive_apply,
  target_value_expression_primitive_apply_to_concrete_tokens,
  InfixToken
}
import v2.extdeps.languages.typescript {
  ts_value_expression_projection,
  ts_operator_realizations_catalog_node,
  ts_target_model_node,
  ts_lex,
  ts_binding_spellings
}
import v2.std.diagnostic { Accepted, None, Outcome, Rejected, bind_outcome }
import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import v2.std.logic { Bool }
import v2.std.node { Node, Symbol }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Staging mirrors v2.test.manual.typescript_bind_let_iife_emit: the DEFAULT bundle and the
// DEFAULT modeled lex, so the catalog under judgment is the one real pipelines consume —
// not an ad-hoc test catalog (census #10's crack, closed here for the binary roster).
fn typescript_binop_target_model() -> TargetModel {
  TargetModel {
    produced_decl_support: ProducedDeclUnwired,
    bundle: ts_target_model_node(),
    lex: ts_lex(),
    binding_spellings: ts_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: "",
    runtime_row: target_emit_host_runtime_row_unconfigured
  }
}

fn typescript_binop_binary_expr(operation: CanonicalOperation) -> TargetValueExpression {
  target_value_expression_primitive_apply(
    operation: operation,
    operands: [
      target_value_expression_binding_ref(binding: ^ts_binding_param_x),
      target_value_expression_binding_ref(binding: ^ts_binding_param_y)
    ]
  )
}

fn typescript_binop_vep_emit(operation: CanonicalOperation, catalog: Node) -> Outcome<String> {
  bind_outcome(
    o: target_value_expression_primitive_apply_to_concrete_tokens(
      expr: typescript_binop_binary_expr(operation: operation),
      projection: ts_value_expression_projection(),
      catalog: catalog
    ),
    f: fn(tokens) {
      bind_outcome(
        o: serialize_concrete_syntax_tokens_to_source_string(
          target: typescript_binop_target_model(),
          tokens: tokens
        ),
        f: fn(carrier) {
          Accepted { value: render_target_text(t: carrier), diagnostics: None }
        }
      )
    }
  )
}

fn typescript_binop_vep_emit_accepts(operation: CanonicalOperation, expected: String) -> Bool {
  match typescript_binop_vep_emit(
    operation: operation,
    catalog: ts_operator_realizations_catalog_node()
  ) {
    Accepted { value: s, diagnostics: d } => (s == expected) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

fn typescript_binop_vep_emit_differs_from_add(operation: CanonicalOperation) -> Bool {
  match typescript_binop_vep_emit(
    operation: operation,
    catalog: ts_operator_realizations_catalog_node()
  ) {
    Accepted { value: s, diagnostics: _ } =>
      (s != "x + y") && typescript_binop_vep_emit_accepts(operation: canonical_operation_op_add(), expected: "x + y")
    Rejected { diagnostics: _ } => false
  }
}

test fn typescript_binop_vep_emit_core_catalog_holds() -> Bool {
  typescript_binop_vep_emit_accepts(operation: canonical_operation_op_add(), expected: "x + y") &&
    typescript_binop_vep_emit_accepts(operation: canonical_operation_op_sub(), expected: "x - y") &&
    typescript_binop_vep_emit_accepts(operation: canonical_operation_op_mul(), expected: "x * y") &&
    typescript_binop_vep_emit_accepts(operation: canonical_operation_op_div(), expected: "x / y") &&
    typescript_binop_vep_emit_accepts(operation: canonical_operation_op_eq(), expected: "x == y") &&
    typescript_binop_vep_emit_accepts(operation: canonical_operation_op_ne(), expected: "x != y") &&
    typescript_binop_vep_emit_accepts(operation: canonical_operation_op_and(), expected: "x && y") &&
    typescript_binop_vep_emit_accepts(operation: canonical_operation_op_or(), expected: "x || y") &&
    typescript_binop_vep_emit_accepts(operation: canonical_operation_op_lt(), expected: "x < y") &&
    typescript_binop_vep_emit_accepts(operation: canonical_operation_op_gt(), expected: "x > y") &&
    typescript_binop_vep_emit_accepts(operation: canonical_operation_op_le(), expected: "x <= y") &&
    typescript_binop_vep_emit_accepts(operation: canonical_operation_op_ge(), expected: "x >= y")
}

test fn typescript_binop_vep_emit_discriminates_from_add() -> Bool {
  typescript_binop_vep_emit_differs_from_add(operation: canonical_operation_op_sub()) &&
    typescript_binop_vep_emit_differs_from_add(operation: canonical_operation_op_mul()) &&
    typescript_binop_vep_emit_differs_from_add(operation: canonical_operation_op_eq()) &&
    typescript_binop_vep_emit_differs_from_add(operation: canonical_operation_op_lt()) &&
    typescript_binop_vep_emit_differs_from_add(operation: canonical_operation_op_and())
}

test fn typescript_binop_vep_emit_wrong_token_discriminates() -> Bool {
  match typescript_binop_vep_emit(
    operation: canonical_operation_op_sub(),
    catalog: typescript_binop_sub_mistoken_catalog()
  ) {
    Accepted { value: s, diagnostics: _ } => (s == "x + y") && (s != "x - y")
    Rejected { diagnostics: _ } => false
  }
}

test fn typescript_binop_vep_emit_missing_catalog_rejects() -> Bool {
  match typescript_binop_vep_emit(
    operation: canonical_operation_op_sub(),
    catalog: typescript_binop_add_only_catalog()
  ) {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}

fn typescript_binop_add_only_catalog() -> Node {
  target_operator_realizations_catalog_node(rows: [
    target_operator_realization_node(
      operation: canonical_operation_op_add(),
      shape: InfixToken { token: ^ts_token_plus }
    )
  ])
}

fn typescript_binop_sub_mistoken_catalog() -> Node {
  target_operator_realizations_catalog_node(rows: [
    target_operator_realization_node(
      operation: canonical_operation_op_sub(),
      shape: InfixToken { token: ^ts_token_plus }
    )
  ])
}
