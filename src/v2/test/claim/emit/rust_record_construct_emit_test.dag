module v2.test.emit.rust_record_construct_emit


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data rust_record_construct_emit_inferred_tree: InferredTree = InferredTree {
  root: dag_fixture_emitted_rec_fn,
  facts: Map { lookup: rust_record_construct_emit_facts_miss }
}

fn rust_record_construct_emit_facts_miss(key: Node) -> Optional<InferredFacts> {
  optional_absent()
}

fn rust_record_construct_emit_from_tree(target: TargetModel) -> Outcome<Medium<String>> {
  emit(tree: rust_record_construct_emit_inferred_tree, target: target)
}

test fn rust_record_construct_emit_mk_accepts() -> Bool {
  match rust_record_construct_emit_from_tree(target: rust_rec_target_model_staging()) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == rust_rec_source_text) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn rust_record_construct_emit_wrong_field_discriminates() -> Bool {
  match rust_record_construct_emit_from_tree(target: rust_rec_wrong_field_target_model_staging()) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == rust_rec_wrong_value_source_text) &&
      (source.carried != rust_rec_source_text) &&
      (d == None)
    Rejected { diagnostics: _ } => false
  }
}

