module v2.test.emit.semantic_decl_all_lex_parity

import v2.extdeps.languages.rust { rust_decl_general_lex, rust_target_model }
import v2.std.compilers.semantic_decl_emission {
  semantic_decl_emission_from_target,
  semantic_decl_profile_lex_rules
}
import v2.std.compilers.lexing { LexRules }
import v2.std.compilers.target_model { lex_rules_literal_for_class }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Symbol }

fn lex_pair_matches(token_class: Symbol) -> Bool {
  match semantic_decl_emission_from_target(target: rust_target_model()) {
    Accepted { value: emission, diagnostics: _ } =>
      match semantic_decl_profile_lex_rules(profile: emission.enum_serialize_profile) {
        Accepted { value: decoded_lex, diagnostics: _ } =>
          match lex_rules_literal_for_class(rules: decoded_lex, token_class: token_class) {
            Accepted { value: decoded, diagnostics: _ } =>
              match lex_rules_literal_for_class(rules: rust_decl_general_lex(), token_class: token_class) {
                Accepted { value: live, diagnostics: _ } => decoded == live
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn all_lex_rows_match() -> Bool {
  lex_pair_matches(token_class: ^rust_token_derive_struct)
    && lex_pair_matches(token_class: ^rust_token_derive_struct_copy)
    && lex_pair_matches(token_class: ^rust_token_derive_enum)
    && lex_pair_matches(token_class: ^rust_token_derive_enum_copy)
    && lex_pair_matches(token_class: ^rust_token_kw_struct)
    && lex_pair_matches(token_class: ^rust_token_kw_enum)
    && lex_pair_matches(token_class: ^rust_token_generic_lt)
    && lex_pair_matches(token_class: ^rust_token_generic_gt)
    && lex_pair_matches(token_class: ^rust_token_lbrace)
    && lex_pair_matches(token_class: ^rust_token_colon)
    && lex_pair_matches(token_class: ^rust_token_comma)
    && lex_pair_matches(token_class: ^rust_token_rbrace)
}