module v2.test.emit.semantic_decl_all_lex_parity


fn lex_pair_matches(token_class: v2.std.node.Symbol) -> Bool {
  match semantic_decl_emission_from_target(target: rust_target_model()) {
    Accepted { value: emission, diagnostics: _ } =>
      match semantic_decl_profile_lex_rules(profile: emission.enum_serialize_profile) {
        Accepted { value: decoded_lex, diagnostics: _ } =>
          match lex_rules_literal_for_class(rules: decoded_lex, token_class: token_class) {
            Accepted { value: decoded, diagnostics: _ } =>
              match lex_rules_literal_for_class(rules: rust_decl_general_lex(), token_class: token_class) {
                Accepted { value: live, diagnostics: _ } => decoded == live
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn all_lex_rows_match() -> Bool {
  v2.test.emit.semantic_decl_all_lex_parity.lex_pair_matches(token_class: ^rust_token_derive_struct)
    && v2.test.emit.semantic_decl_all_lex_parity.lex_pair_matches(token_class: ^rust_token_derive_struct_copy)
    && v2.test.emit.semantic_decl_all_lex_parity.lex_pair_matches(token_class: ^rust_token_derive_enum)
    && v2.test.emit.semantic_decl_all_lex_parity.lex_pair_matches(token_class: ^rust_token_derive_enum_copy)
    && v2.test.emit.semantic_decl_all_lex_parity.lex_pair_matches(token_class: ^rust_token_kw_struct)
    && v2.test.emit.semantic_decl_all_lex_parity.lex_pair_matches(token_class: ^rust_token_kw_enum)
    && v2.test.emit.semantic_decl_all_lex_parity.lex_pair_matches(token_class: ^rust_token_generic_lt)
    && v2.test.emit.semantic_decl_all_lex_parity.lex_pair_matches(token_class: ^rust_token_generic_gt)
    && v2.test.emit.semantic_decl_all_lex_parity.lex_pair_matches(token_class: ^rust_token_lbrace)
    && v2.test.emit.semantic_decl_all_lex_parity.lex_pair_matches(token_class: ^rust_token_colon)
    && v2.test.emit.semantic_decl_all_lex_parity.lex_pair_matches(token_class: ^rust_token_comma)
    && v2.test.emit.semantic_decl_all_lex_parity.lex_pair_matches(token_class: ^rust_token_rbrace)
}
