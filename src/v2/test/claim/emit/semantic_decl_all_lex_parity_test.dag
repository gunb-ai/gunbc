module v2.test.emit.semantic_decl_all_lex_parity


fn lex_pair_matches(token_class: v2.std.node.Symbol) -> Bool {
  match v2.std.compilers.semantic_decl_emission.semantic_decl_emission_from_target(target: v2.extdeps.languages.rust.rust_target_model()) {
    v2.std.diagnostic.Accepted { value: emission, diagnostics: _ } =>
      match v2.std.compilers.semantic_decl_emission.semantic_decl_profile_lex_rules(profile: emission.enum_serialize_profile) {
        v2.std.diagnostic.Accepted { value: decoded_lex, diagnostics: _ } =>
          match v2.std.compilers.target_model.lex_rules_literal_for_class(rules: decoded_lex, token_class: token_class) {
            v2.std.diagnostic.Accepted { value: decoded, diagnostics: _ } =>
              match v2.std.compilers.target_model.lex_rules_literal_for_class(rules: v2.extdeps.languages.rust.rust_decl_general_lex(), token_class: token_class) {
                v2.std.diagnostic.Accepted { value: live, diagnostics: _ } => decoded == live
                v2.std.diagnostic.Rejected { diagnostics: _ } => false
              }
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn all_lex_rows_match() -> Bool {
  lex_pair_matches(token_class: ^rust_token_derive_struct)
    && lex_pair_matches(token_class: ^rust_token_derive_struct_copy)
    && lex_pair_matches(token_class: ^rust_token_derive_enum)
    && lex_pair_matches(token_class: ^rust_token_derive_enum_copy)
    && lex_pair_matches(token_class: ^rust_token_kw_struct)
    && lex_pair_matches(token_class: ^rust_token_kw_enum)
    && lex_pair_matches(token_class: ^rust_token_generic_lt)
    && lex_pair_matches(token_class: ^rust_token_generic_gt)
    && lex_pair_matches(token_class: ^rust_token_lbrace)
    && lex_pair_matches(token_class: ^rust_token_colon)
    && lex_pair_matches(token_class: ^rust_token_comma)
    && lex_pair_matches(token_class: ^rust_token_rbrace)
}
