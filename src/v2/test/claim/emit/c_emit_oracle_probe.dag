module v2.test.emit.c_emit_oracle_probe

import v2.compiler.emit_semantic_decl { emit_semantic_type_decl }
import v2.extdeps.languages.c { c_target_model }
import std.algebra { Empty }
import v2.std.algebra { fold_list }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Conj, Edge, Named, Node, SyntheticOccurrence, TypeNode, Atom }

fn point() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: ^x }, target: Node { kind: TypeNode { connective: Atom { identity: ^Int } }, children: [], occurrence_id: SyntheticOccurrence } },
      Edge { label: Named { name: ^y }, target: Node { kind: TypeNode { connective: Atom { identity: ^Int } }, children: [], occurrence_id: SyntheticOccurrence } }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn str_len(s: String) -> Int {
  fold_list(xs: s, empty: 0, cons: fn(acc, _) { acc + 1 })
}

test fn c_emit_point_len_35_holds() -> Bool {
  match emit_semantic_type_decl(name: ^Point, params: Empty, node: point(), target: c_target_model()) {
    Accepted { value: medium, diagnostics: _ } => str_len(s: medium.carried) == 35
    Rejected { diagnostics: _ } => false
  }
}

test fn c_emit_point_len_36_holds() -> Bool {
  match emit_semantic_type_decl(name: ^Point, params: Empty, node: point(), target: c_target_model()) {
    Accepted { value: medium, diagnostics: _ } => str_len(s: medium.carried) == 36
