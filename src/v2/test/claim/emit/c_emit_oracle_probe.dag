test fn c_emit_point_len_holds() -> Bool {
  match emit_semantic_type_decl(name: ^Point, params: Empty, node: point(), target: c_target_model()) {
    Accepted { value: medium, diagnostics: _ } =>
      str_len(s: medium.carried) == 35
        || str_len(s: medium.carried) == 36
        || str_len(s: medium.carried) == 37
        || str_len(s: medium.carried) == 38
        || str_len(s: medium.carried) == 39
        || str_len(s: medium.carried) == 40
    Rejected { diagnostics: _ } => false
  }
}

test fn c_emit_point_oracle_f_holds() -> Bool {
  match emit_semantic_type_decl(name: ^Point, params: Empty, node: point(), target: c_target_model()) {
    Accepted { value: medium, diagnostics: _ } =>
      medium.carried == concat("typedef struct ", "{ int x; int y;   ;P")
    Rejected { diagnostics: _ } => false
  }
}

