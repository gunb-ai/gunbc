module v2.test.emit.c_emit_oracle_probe

import v2.compiler.emit_semantic_decl { emit_semantic_type_decl }
import v2.extdeps.languages.c { c_target_model }
import v2.test.emit.c_semantic_decl_routing { cdr_point_record }
import std.algebra { Empty }
import v2.std.algebra { fold_list }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }

fn emit_point_text() -> String {
  match emit_semantic_type_decl(
    name: ^Point,
    params: Empty,
    node: cdr_point_record(),
    target: c_target_model()
  ) {
    Accepted { value: medium, diagnostics: _ } => medium.carried
    Rejected { diagnostics: _ } => ""
  }
}

fn str_len(s: String) -> Int {
  fold_list(xs: s, empty: 0, cons: fn(acc, _) { acc + 1 })
}

test fn c_emit_len_33_holds() -> Bool { str_len(s: emit_point_text()) == 33 }
test fn c_emit_len_34_holds() -> Bool { str_len(s: emit_point_text()) == 34 }
test fn c_emit_len_35_holds() -> Bool { str_len(s: emit_point_text()) == 35 }
test fn c_emit_len_36_holds() -> Bool { str_len(s: emit_point_text()) == 36 }
test fn c_emit_len_37_holds() -> Bool { str_len(s: emit_point_text()) == 37 }
test fn c_emit_len_42_holds() -> Bool { str_len(s: emit_point_text()) == 42 }
test fn c_emit_len_43_holds() -> Bool { str_len(s: emit_point_text()) == 43 }
test fn c_emit_len_44_holds() -> Bool { str_len(s: emit_point_text()) == 44 }
test fn c_emit_len_45_holds() -> Bool { str_len(s: emit_point_text()) == 45 }
