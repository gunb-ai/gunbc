module v2.test.emit.rust_variant_construct_emit


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data rust_variant_construct_emit_wrong_value_source_text: String = "fn one_or_two() -> i32 { match (Holds { value: 1 }) { Holds { value: v } => v, True => 2 } }"

fn rust_variant_construct_emit_facts_miss(key: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  optional_absent()
}

fn rust_variant_construct_emit_inferred_tree_for(root: Node) -> v2.compiler.infer.InferredTree {
  v2.compiler.infer.InferredTree {
    root: root,
    facts: std.types.Map { lookup: rust_variant_construct_emit_facts_miss }
  }
}

data rust_variant_construct_emit_inferred_tree: v2.compiler.infer.InferredTree = rust_variant_construct_emit_inferred_tree_for(root: dag_variant_construct_arrow_with_body_fixture)

data rust_variant_construct_emit_wrong_value_inferred_tree: v2.compiler.infer.InferredTree = rust_variant_construct_emit_inferred_tree_for(root: dag_variant_construct_arrow_with_body_wrong_value_fixture)

test fn rust_variant_construct_emit_holds_accepts() -> Bool {
  match emit(
    tree: rust_variant_construct_emit_inferred_tree,
    target: rust_variant_construct_target_model_staging()
  ) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == rust_variant_construct_source_text) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn rust_variant_construct_emit_wrong_value_discriminates() -> Bool {
  match emit(
    tree: rust_variant_construct_emit_wrong_value_inferred_tree,
    target: rust_variant_construct_target_model_staging()
  ) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == rust_variant_construct_emit_wrong_value_source_text) &&
      (source.carried != rust_variant_construct_source_text) &&
      (d == None)
    Rejected { diagnostics: _ } => false
  }
}

