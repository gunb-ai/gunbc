module v2.test.emit.witness_record_emit

import v2.compiler.translate {
  grammar_relation_row_for_emitted,
  grammar_relation_row_tokens_root,
  serialize_concrete_syntax_tokens_to_source
}
import v2.extdeps.languages.rust {
  rust_inhabitant_atom,
  rust_struct_decl_productions_only_translation_rules,
  rust_struct_decl_structural_target_model
}
import v2.std.algebra { fold_list, fold_list_right }
import v2.std.collection { List }
import v2.std.compilers.target_model {
  TargetModel,
  concrete_syntax_token_list_from_node
}
import v2.std.diagnostic {
  Accepted,
  Outcome,
  Rejected,
  bind_outcome,
  outcome_accepted
}
import v2.std.integer { Int }
import v2.std.logic { Bool }
import v2.std.node {
  Conj,
  Edge,
  Node,
  Positional,
  Symbol,
  SyntheticOccurrence,
  TypeNode
}

data witness_spw_golden: String = "struct StructuralPropertyWitness { property: Symbol, evidence: Node }"
data witness_hw_golden: String = "struct HomomorphismWitness { rule: Symbol, evidence: Node }"
data witness_artifact_golden: String = "struct Artifact { kind: ArtifactKind, id: Symbol, file_path: String }"
data witness_occurrence_allocator_golden: String = "struct OccurrenceIdAllocator { next_id: Int }"

type FieldSpec {
  name: String
  type_name: String
}

fn witness_interned_symbol(spelling: String) -> Symbol {
  spelling
}

fn witness_qualified_name_emitted(name: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [ Edge { label: Positional, target: rust_inhabitant_atom(id: name) } ],
    occurrence_id: SyntheticOccurrence
  }
}

fn witness_type_expr_emitted(type_name: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [ Edge { label: Positional, target: witness_qualified_name_emitted(name: type_name) } ],
    occurrence_id: SyntheticOccurrence
  }
}

fn witness_field_nil() -> Node {
  Node { kind: TypeNode { connective: Conj }, children: [], occurrence_id: SyntheticOccurrence }
}

fn witness_field_cell(name: Symbol, type_name: Symbol, rest: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Positional, target: rust_inhabitant_atom(id: name) },
      Edge { label: Positional, target: witness_type_expr_emitted(type_name: type_name) },
      Edge { label: Positional, target: rest }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn witness_field_list_from(specs: List<FieldSpec>) -> Node {
  fold_list_right(
    xs: specs,
    empty: witness_field_nil(),
    snoc: fn(acc, spec) {
      witness_field_cell(
        name: witness_interned_symbol(spelling: spec.name),
        type_name: witness_interned_symbol(spelling: spec.type_name),
        rest: acc
      )
    }
  )
}

fn witness_field_block_emitted(fields: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [ Edge { label: Positional, target: fields } ],
    occurrence_id: SyntheticOccurrence
  }
}

fn witness_record_emitted(name: String, specs: List<FieldSpec>) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Positional, target: rust_inhabitant_atom(id: witness_interned_symbol(spelling: name)) },
      Edge { label: Positional, target: witness_field_block_emitted(fields: witness_field_list_from(specs: specs)) }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn witness_spw_emitted() -> Node {
  witness_record_emitted(
    name: "StructuralPropertyWitness",
    specs: [
      FieldSpec { name: "property", type_name: "Symbol" },
      FieldSpec { name: "evidence", type_name: "Node" }
    ]
  )
}

fn witness_hw_emitted() -> Node {
  witness_record_emitted(
    name: "HomomorphismWitness",
    specs: [
      FieldSpec { name: "rule", type_name: "Symbol" },
      FieldSpec { name: "evidence", type_name: "Node" }
    ]
  )
}

fn witness_artifact_emitted() -> Node {
  witness_record_emitted(
    name: "Artifact",
    specs: [
      FieldSpec { name: "kind", type_name: "ArtifactKind" },
      FieldSpec { name: "id", type_name: "Symbol" },
      FieldSpec { name: "file_path", type_name: "String" }
    ]
  )
}

fn witness_occurrence_allocator_emitted() -> Node {
  witness_record_emitted(
    name: "OccurrenceIdAllocator",
    specs: [ FieldSpec { name: "next_id", type_name: "Int" } ]
  )
}

fn witness_target() -> TargetModel {
  rust_struct_decl_structural_target_model()
}

fn witness_emit_source_text(emitted: Node) -> Outcome<String> {
  bind_outcome(
    o: grammar_relation_row_for_emitted(
      rules: rust_struct_decl_productions_only_translation_rules(),
      emitted: emitted
    ),
    f: fn(row) {
      bind_outcome(
        o: grammar_relation_row_tokens_root(row: row),
        f: fn(tokens_root) {
          bind_outcome(
            o: concrete_syntax_token_list_from_node(list_node: tokens_root),
            f: fn(tokens) {
              bind_outcome(
                o: serialize_concrete_syntax_tokens_to_source(target: witness_target(), tokens: tokens),
                f: fn(medium) { outcome_accepted(value: medium.carried) }
              )
            }
          )
        }
      )
    }
  )
}

fn witness_emit_matches_golden(emitted: Node, golden: String) -> Bool {
  match witness_emit_source_text(emitted: emitted) {
    Accepted { value: text, diagnostics: _ } => text == golden
    Rejected { diagnostics: _ } => false
  }
}

fn witness_construct_refused(emitted: Node) -> Bool {
  match witness_emit_source_text(emitted: emitted) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

fn witness_empty_record_emitted() -> Node {
  witness_record_emitted(name: "BoolWidthFact", specs: [])
}

fn witness_generic_param_record_emitted() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Positional, target: rust_inhabitant_atom(id: witness_interned_symbol(spelling: "Vendor")) },
      Edge { label: Positional, target: rust_inhabitant_atom(id: witness_interned_symbol(spelling: "Domain")) },
      Edge {
        label: Positional,
        target: witness_field_block_emitted(
          fields: witness_field_list_from(specs: [FieldSpec { name: "legal_name", type_name: "String" }])
        )
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

type WitnessEmitConstructRow {
  construct: Symbol
  covered: Bool
}

data witness_emit_construct_rows: List<WitnessEmitConstructRow> = [
  WitnessEmitConstructRow { construct: ^record_structural_property_witness_two_fields, covered: true },
  WitnessEmitConstructRow { construct: ^record_homomorphism_witness_two_fields, covered: true },
  WitnessEmitConstructRow { construct: ^record_artifact_three_fields, covered: true },
  WitnessEmitConstructRow { construct: ^record_occurrence_allocator_one_field, covered: true },
  WitnessEmitConstructRow { construct: ^record_empty_zero_fields, covered: false },
  WitnessEmitConstructRow { construct: ^record_generic_parameter, covered: false }
]

fn witness_covered_count() -> Int {
  fold_list(xs: witness_emit_construct_rows, empty: 0, cons: fn(acc, row) { if row.covered { acc + 1 } else { acc } })
}

fn witness_refused_count() -> Int {
  fold_list(xs: witness_emit_construct_rows, empty: 0, cons: fn(acc, row) { if row.covered { acc } else { acc + 1 } })
}

fn witness_variable_arity_covered_holds() -> Bool {
  witness_emit_matches_golden(emitted: witness_spw_emitted(), golden: witness_spw_golden)
    && witness_emit_matches_golden(emitted: witness_hw_emitted(), golden: witness_hw_golden)
    && witness_emit_matches_golden(emitted: witness_artifact_emitted(), golden: witness_artifact_golden)
    && witness_emit_matches_golden(emitted: witness_occurrence_allocator_emitted(), golden: witness_occurrence_allocator_golden)
}

fn witness_golden_discriminates_holds() -> Bool {
  !witness_emit_matches_golden(emitted: witness_spw_emitted(), golden: witness_hw_golden)
    && !witness_emit_matches_golden(emitted: witness_spw_emitted(), golden: "struct StructuralPropertyWitness { property: Symbol, evidence: NODE }")
}

fn witness_gaps_refused_holds() -> Bool {
  witness_construct_refused(emitted: witness_empty_record_emitted())
    && witness_construct_refused(emitted: witness_generic_param_record_emitted())
    && (witness_refused_count() == 2)
    && (witness_covered_count() == 4)
}

test fn witness_record_emit_holds() -> Bool {
  witness_variable_arity_covered_holds()
    && witness_golden_discriminates_holds()
    && witness_gaps_refused_holds()
}
