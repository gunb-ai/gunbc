module v2.test.emit.rust_logic_meet_join_emit


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn meet_join_emit_facts_miss(key: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  optional_absent()
}

fn meet_join_emit_tree_for(root: Node) -> v2.compiler.infer.InferredTree {
  v2.compiler.infer.InferredTree {
    root: root,
    facts: std.types.Map { lookup: meet_join_emit_facts_miss }
  }
}

fn meet_join_emit_source_equals(root: Node, target: v2.std.compilers.target_model.TargetModel, expected: String) -> Bool {
  match emit(tree: meet_join_emit_tree_for(root: root), target: target) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == expected) && (d == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

fn meet_join_emit_discriminates(
  root: Node,
  target: v2.std.compilers.target_model.TargetModel,
  expected: String,
  wrong: String
) -> Bool {
  match emit(tree: meet_join_emit_tree_for(root: root), target: target) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == expected) && (source.carried != wrong) && (d == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

test fn rust_logic_meet_emit_holds() -> Bool {
  meet_join_emit_source_equals(
    root: dag_meet_arrow_with_body_fixture,
    target: rust_logic_meet_target_model_staging(),
    expected: rust_logic_meet_source_text
  )
    && meet_join_emit_discriminates(
      root: dag_meet_arrow_with_body_swapped_arms_fixture,
      target: rust_logic_meet_target_model_staging(),
      expected: rust_logic_meet_swapped_arms_source_text,
      wrong: rust_logic_meet_source_text
    )
}

test fn rust_logic_join_emit_holds() -> Bool {
  meet_join_emit_source_equals(
    root: dag_join_arrow_with_body_fixture,
    target: rust_logic_join_target_model_staging(),
    expected: rust_logic_join_source_text
  )
    && meet_join_emit_discriminates(
      root: dag_join_arrow_with_body_swapped_arms_fixture,
      target: rust_logic_join_target_model_staging(),
      expected: rust_logic_join_swapped_arms_source_text,
      wrong: rust_logic_join_source_text
    )
}

