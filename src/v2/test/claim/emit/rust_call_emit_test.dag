module v2.test.emit.rust_call_emit


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data rust_call_fold_canonical_source_text: String = "fn add(x: i32, y: i32) -> i32 { fold_call(x, y, |acc, h| { acc + h }) }"

data rust_call_fold_swapped_source_text: String = "fn add(x: i32, y: i32) -> i32 { fold_call(x, y, |acc, h| { h + acc }) }"

fn rust_call_type_atom(id: v2.std.node.Symbol) -> Node {
  node_synthetic(
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } },
    children: []
  )
}

fn rust_call_named_edge(name: v2.std.node.Symbol, target: Node) -> v2.std.node.Edge {
  v2.std.node.Edge { label: Named { name: name }, target: target }
}

fn rust_call_positional(target: Node) -> v2.std.node.Edge {
  v2.std.node.Edge { label: Positional, target: target }
}

fn rust_call_add_domain_conj() -> Node {
  node_synthetic(
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      rust_call_named_edge(
        name: ^dag_binding_param_x,
        target: rust_call_type_atom(id: ^dag_binding_type_int)
      ),
      rust_call_named_edge(
        name: ^dag_binding_param_y,
        target: rust_call_type_atom(id: ^dag_binding_type_int)
      )
    ]
  )
}

fn rust_call_closure_arrow(left_operand: v2.std.node.Symbol, right_operand: v2.std.node.Symbol) -> Node {
  node_synthetic(
    kind: v2.std.node.TypeNode { connective: Arrow },
    children: [
      rust_call_positional(
        target: node_synthetic(
          kind: v2.std.node.TypeNode { connective: Conj },
          children: [
            rust_call_named_edge(
              name: ^rust_call_closure_acc,
              target: rust_call_type_atom(id: ^dag_binding_type_int)
            ),
            rust_call_named_edge(
              name: ^rust_call_closure_h,
              target: rust_call_type_atom(id: ^dag_binding_type_int)
            )
          ]
        )
      ),
      rust_call_positional(target: rust_call_type_atom(id: ^dag_binding_type_int)),
      rust_call_named_edge(
        name: ^arrow_body_edge,
        target: node_synthetic(
          kind: v2.std.node.ComputationNode { behavior: Transform },
          children: [
            rust_call_positional(target: rust_call_type_atom(id: ^dag_token_plus)),
            rust_call_positional(target: rust_call_type_atom(id: left_operand)),
            rust_call_positional(target: rust_call_type_atom(id: right_operand))
          ]
        )
      )
    ]
  )
}

fn rust_call_fold_body(closure: Node) -> Node {
  node_synthetic(
    kind: v2.std.node.ComputationNode { behavior: Transform },
    children: [
      rust_call_positional(target: rust_call_type_atom(id: ^rust_call_callee_fold)),
      rust_call_positional(target: rust_call_type_atom(id: ^dag_binding_param_x)),
      rust_call_positional(target: rust_call_type_atom(id: ^dag_binding_param_y)),
      rust_call_positional(target: closure)
    ]
  )
}

fn rust_call_fold_arrow(closure: Node) -> Node {
  node_synthetic(
    kind: v2.std.node.TypeNode { connective: Arrow },
    children: [
      rust_call_positional(target: rust_call_add_domain_conj()),
      rust_call_positional(target: rust_call_type_atom(id: ^dag_binding_type_int)),
      rust_call_positional(target: rust_call_type_atom(id: ^dag_binding_type_int)),
      rust_call_named_edge(
        name: ^arrow_body_edge,
        target: rust_call_fold_body(closure: closure)
      )
    ]
  )
}

fn rust_call_fold_canonical_arrow() -> Node {
  rust_call_fold_arrow(
    closure: rust_call_closure_arrow(
      left_operand: ^rust_call_closure_acc,
      right_operand: ^rust_call_closure_h
    )
  )
}

fn rust_call_fold_swapped_arrow() -> Node {
  rust_call_fold_arrow(
    closure: rust_call_closure_arrow(
      left_operand: ^rust_call_closure_h,
      right_operand: ^rust_call_closure_acc
    )
  )
}

fn rust_call_helper_body() -> Node {
  node_synthetic(
    kind: v2.std.node.ComputationNode { behavior: Transform },
    children: [
      rust_call_positional(target: rust_call_type_atom(id: ^rust_call_callee_helper)),
      rust_call_positional(target: rust_call_type_atom(id: ^dag_binding_param_x)),
      rust_call_positional(target: rust_call_type_atom(id: ^dag_binding_param_y))
    ]
  )
}

fn rust_call_helper_arrow() -> Node {
  node_synthetic(
    kind: v2.std.node.TypeNode { connective: Arrow },
    children: [
      rust_call_positional(target: rust_call_add_domain_conj()),
      rust_call_positional(target: rust_call_type_atom(id: ^dag_binding_type_int)),
      rust_call_positional(target: rust_call_type_atom(id: ^dag_binding_type_int)),
      rust_call_named_edge(
        name: ^arrow_body_edge,
        target: rust_call_helper_body()
      )
    ]
  )
}

data rust_call_helper_body_fixture: Node = rust_call_helper_body()

data rust_call_eval_arg_literal: Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: Value },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data rust_call_helper_eval_subgraph: Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: Transform },
  children: [
    v2.std.node.Edge { label: Positional, target: rust_call_eval_arg_literal },
    v2.std.node.Edge { label: Positional, target: rust_call_eval_arg_literal }
  ],
  occurrence_id: SyntheticOccurrence
}

fn rust_call_target_model(authority_source_text: String) -> v2.std.compilers.target_model.TargetModel {
  v2.std.compilers.target_model.TargetModel {
    produced_decl_support: ProducedDeclUnwired,
    bundle: rust_target_model_bundle_core(),
    lex: rust_call_lex(),
    binding_spellings: rust_call_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: authority_source_text,
    runtime_row: target_emit_host_runtime_row_unconfigured
  }
}

fn rust_call_facts_miss(key: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  optional_absent()
}

fn rust_call_inferred_tree_for(root: Node) -> v2.compiler.infer.InferredTree {
  v2.compiler.infer.InferredTree {
    root: root,
    facts: Map { lookup: rust_call_facts_miss }
  }
}

fn rust_call_emit_from_arrow(arrow: Node, authority: String) -> Outcome<Medium<String>> {
  emit(
    tree: rust_call_inferred_tree_for(root: arrow),
    target: rust_call_target_model(authority_source_text: authority)
  )
}

fn rust_call_emit_matches(arrow: Node, authority: String) -> Bool {
  match rust_call_emit_from_arrow(arrow: arrow, authority: authority) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == authority) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn rust_call_fold_closure_emit_holds() -> Bool {
  rust_call_emit_matches(
    arrow: rust_call_fold_canonical_arrow(),
    authority: rust_call_fold_canonical_source_text
  )
}

test fn rust_call_fold_closure_swap_discriminates() -> Bool {
  !rust_call_emit_matches(
    arrow: rust_call_fold_swapped_arrow(),
    authority: rust_call_fold_canonical_source_text
  )
  && rust_call_emit_matches(
    arrow: rust_call_fold_swapped_arrow(),
    authority: rust_call_fold_swapped_source_text
  )
}

test fn rust_call_helper_emit_holds() -> Bool {
  rust_call_emit_matches(
    arrow: rust_call_helper_arrow(),
    authority: rust_call_host_source_text
  )
}

