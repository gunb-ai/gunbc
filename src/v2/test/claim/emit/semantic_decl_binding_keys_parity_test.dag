module v2.test.emit.semantic_decl_binding_keys_parity


fn binding_pair_matches(binding: v2.std.node.Symbol) -> Bool {
  match v2.std.compilers.semantic_decl_emission.semantic_decl_emission_from_target(target: v2.extdeps.languages.rust.rust_target_model()) {
    v2.std.diagnostic.Accepted { value: emission, diagnostics: _ } =>
      match v2.std.compilers.semantic_decl_emission.semantic_decl_profile_binding_spellings(profile: emission.enum_serialize_profile) {
        v2.std.diagnostic.Accepted { value: decoded_bindings, diagnostics: _ } =>
          match v2.std.compilers.target_model.bound_spelling_from_map(
            binding_spellings: decoded_bindings,
            binding: binding
          ) {
            v2.std.diagnostic.Accepted { value: decoded, diagnostics: _ } =>
              match v2.std.compilers.target_model.bound_spelling_from_map(
                binding_spellings: v2.extdeps.languages.rust.rust_decl_derive_binding_spellings(),
                binding: binding
              ) {
                v2.std.diagnostic.Accepted { value: live, diagnostics: _ } => decoded == live
                v2.std.diagnostic.Rejected { diagnostics: _ } => false
              }
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn all_bool_emit_bindings_match() -> Bool {
  binding_pair_matches(binding: ^rust_decl_derive_enum_copy_binding)
    && binding_pair_matches(binding: ^Bool)
    && binding_pair_matches(binding: ^True)
    && binding_pair_matches(binding: ^False)
    && binding_pair_matches(binding: ^rust_decl_derive_enum_binding)
    && binding_pair_matches(binding: ^rust_decl_derive_struct_binding)
}
