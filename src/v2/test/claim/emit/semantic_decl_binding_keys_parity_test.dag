module v2.test.emit.semantic_decl_binding_keys_parity


fn binding_pair_matches(binding: v2.std.node.Symbol) -> v2.std.logic.Bool {
  match semantic_decl_emission_from_target(target: rust_target_model()) {
    Accepted { value: emission, diagnostics: _ } =>
      match semantic_decl_profile_binding_spellings(profile: emission.enum_serialize_profile) {
        Accepted { value: decoded_bindings, diagnostics: _ } =>
          match bound_spelling_from_map(
            binding_spellings: decoded_bindings,
            binding: binding
          ) {
            Accepted { value: decoded, diagnostics: _ } =>
              match bound_spelling_from_map(
                binding_spellings: rust_decl_derive_binding_spellings(),
                binding: binding
              ) {
                Accepted { value: live, diagnostics: _ } => decoded == live
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn all_bool_emit_bindings_match() -> v2.std.logic.Bool {
  v2.test.emit.semantic_decl_binding_keys_parity.binding_pair_matches(binding: ^rust_decl_derive_enum_copy_binding)
    && v2.test.emit.semantic_decl_binding_keys_parity.binding_pair_matches(binding: ^v2.std.logic.Bool)
    && v2.test.emit.semantic_decl_binding_keys_parity.binding_pair_matches(binding: ^True)
    && v2.test.emit.semantic_decl_binding_keys_parity.binding_pair_matches(binding: ^False)
    && v2.test.emit.semantic_decl_binding_keys_parity.binding_pair_matches(binding: ^rust_decl_derive_enum_binding)
    && v2.test.emit.semantic_decl_binding_keys_parity.binding_pair_matches(binding: ^rust_decl_derive_struct_binding)
}
