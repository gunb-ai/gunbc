module v2.test.emit.rust_signature_general_emit


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data rust_signature_add_golden: String = "fn add(x: i32, y: i32) -> i32 { "

data rust_signature_add_wrong_golden: String = "fn add(y: i32, x: i32) -> i32 { "

fn rust_signature_add_decl() -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.test.complexity_gate.table_fixture_add_subject_producer.table_fixture_add_decl_node(fn_name: ^rust_binding_fn_add)
}

fn rust_signature_add_text() -> v2.std.diagnostic.Outcome<String> {
  v2.std.diagnostic.bind_outcome(
    o: rust_signature_add_decl(),
    f: fn(decl) {
      v2.std.diagnostic.bind_outcome(
        o: v2.extdeps.languages.rust.rust_signature_with_open_from_decl(decl: decl),
        f: fn(toks) {
          v2.std.diagnostic.bind_outcome(
            o: v2.compiler.translate.serialize_concrete_syntax_tokens_to_source(
              target: v2.extdeps.languages.rust.rust_target_model_staging(),
              tokens: toks
            ),
            f: fn(medium) {
              v2.std.diagnostic.outcome_accepted(value: medium.carried)
            }
          )
        }
      )
    }
  )
}

fn rust_signature_add_matches(golden: String) -> Bool {
  match rust_signature_add_text() {
    v2.std.diagnostic.Accepted { value: text, diagnostics: _ } => text == golden
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn rust_signature_general_reproduces_add_holds() -> Bool {
  rust_signature_add_matches(golden: rust_signature_add_golden)
    && !rust_signature_add_matches(golden: rust_signature_add_wrong_golden)
}
