module v2.test.claim.emit.module_member_emission

import v2.extdeps.languages.dag { dag_surface_edge_label }

import extdeps.communication.medium { Lossless, Medium }
import v2.compiler.emit_produced { emit_module_member }
import v2.compiler.infer { InferredTree }
import std.algebra { PartialFunction }
import v2.std.symbol_index { empty_symbol_index }
import v2.compiler.body_lowering_fold { DeclaredRefinement }
import v2.compiler.self_host.closure_emission {
  ClosureEmissionLocated, ClosureMemberEmitted, ClosureMemberRefused, emit_closure_from_ingest_located,
}
import v2.compiler.source_authority { DagSourceReadWitness }
import v2.extdeps.languages.rust { rust_target_model }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.diagnostic { Accepted, Rejected, diagnostics_fatal_reason }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { Atom, Conj, Edge, Authored, Node, Symbol, TypeNode, node_synthetic, symbol_lexeme, NotADeclaration }
import std.optional { Absent, Present }
import v2.std.qualified_name { qualified_name_from_dotted_string }
import v2.std.text { String }
import v2.compiler.normalize { normalize }
import v2.compiler.parse { parse_module }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_language_model }
import v2.std.diagnostic { bind_outcome, outcome_accepted }
import v2.compiler.body_lowering_fold { DeclaredRecord }
import std.algebra { fold_list }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// EVERY DIRECT MEMBER OF A MODULE HAS ONE TARGET REALIZATION OR ONE TYPED REFUSAL
// (v2.compiler.emit_produced emit_module_member). Before this, a module was rendered only when every
// member was a bodied function, so any declared type sent the whole module to type-expression
// translate, which refused `translate_module_not_a_type_expression` -- a coproduct declared beside a
// function could not be emitted at all, although v2.compiler.emit_semantic_decl emit_semantic_type_decl
// already renders one and had no production caller. Each row drives the production door
// (v2.compiler.self_host.closure_emission emit_closure_from_ingest_located) under the production Rust
// model, and each module pairs the declaration with a bodied function, so a fold that dropped the
// declaration and published the function alone would be visible.
//
// THE REFUSAL ROWS ASSERT THE MEMBER'S OWN REASON, not merely a refusal: a module refusing for an
// unrelated cause would satisfy "was refused". The where-refinement row is the one the classification
// exists for -- after lowering it shares a record's shape, so it must refuse as undecided and never be
// rendered as a struct.
type MemberEmissionVerdict
  = MemberEmitted { text: String }
  | MemberRefused { reason: Symbol }
  | MemberClosureRefused { reason: Symbol }

fn member_emission_locus() -> Node {
  node_synthetic(kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^member_emission_locus } }, children: [])
}

fn member_emission_of(source: String) -> ClosureEmissionLocated {
  emit_closure_from_ingest_located(
    ingest: [
      DagSourceReadWitness {
        source: Medium { carried: source, fidelity: Lossless },
        artifact: Artifact { kind: SourceFile, id: ^member_emission_read, file_path: "src/v2/test/fixture/module_member_emission/entry.dag" },
        compilation_unit: ^member_emission_read,
        source_root: DagTree
      }
    ],
    entry: qualified_name_from_dotted_string(dotted: "v2.test.member_emission"),
    entry_locus: member_emission_locus(),
    target: rust_target_model()
  )
}

// ONE NULLARY PRODUCER PER SPECIMEN, published portable and WARM in v2.workflow.floor_pure_producer_share.
fn member_emission_verdict_of(source: String) -> MemberEmissionVerdict {
  match member_emission_of(source: source).outcome {
    Rejected { diagnostics: d } => MemberClosureRefused { reason: diagnostics_fatal_reason(d: d) }
    Accepted { value: ce, diagnostics: _ } =>
      match first(ce.modules) {
        Absent => MemberClosureRefused { reason: ^member_emission_no_member }
        Present { value: ClosureMemberEmitted { module: _, text: t } } => MemberEmitted { text: t }
        Present { value: ClosureMemberRefused { module: _, diagnostics: d } } => MemberRefused { reason: diagnostics_fatal_reason(d: d) }
      }
  }
}

fn member_emission_coproduct_verdict() -> MemberEmissionVerdict {
  member_emission_verdict_of(source: "module v2.test.member_emission\n\ntype Decision = Allowed | Blocked\n\nfn f(x: Int) -> Int { x as Int }\n")
}

fn member_emission_record_verdict() -> MemberEmissionVerdict {
  member_emission_verdict_of(source: "module v2.test.member_emission\n\ntype Point { a: Int }\n\nfn f(x: Int) -> Int { x as Int }\n")
}

fn member_emission_refinement_verdict() -> MemberEmissionVerdict {
  member_emission_verdict_of(source: "module v2.test.member_emission\n\ntype Pos = Int where positive\n\nfn positive(x: Int) -> Bool { true }\n\nfn f(x: Int) -> Int { x as Int }\n")
}

fn member_emission_alias_verdict() -> MemberEmissionVerdict {
  member_emission_verdict_of(source: "module v2.test.member_emission\n\ntype Id = Int\n\nfn f(x: Int) -> Int { x as Int }\n")
}

fn member_emission_opaque_verdict() -> MemberEmissionVerdict {
  member_emission_verdict_of(source: "module v2.test.member_emission\n\ntype PointerWidth\n\nfn f(x: Int) -> Int { x as Int }\n")
}

fn member_emission_generic_verdict() -> MemberEmissionVerdict {
  member_emission_verdict_of(source: "module v2.test.member_emission\n\ntype Tag<T> = A | B { value: T }\n\nfn f(x: Int) -> Int { x as Int }\n")
}

fn member_emission_generic_record_verdict() -> MemberEmissionVerdict {
  member_emission_verdict_of(source: "module v2.test.member_emission\n\ntype Box<T> { value: T }\n\nfn f(x: Int) -> Int { x as Int }\n")
}

fn member_emission_generic_refinement_verdict() -> MemberEmissionVerdict {
  member_emission_verdict_of(source: "module v2.test.member_emission\n\ntype Pos<T> = Int where positive\n\nfn positive(x: Int) -> Bool { true }\n\nfn f(x: Int) -> Int { x as Int }\n")
}

fn member_emission_payload_variant_verdict() -> MemberEmissionVerdict {
  member_emission_verdict_of(source: "module v2.test.member_emission\n\ntype Wrapped = Only { a: Int }\n\nfn f(x: Int) -> Int { x as Int }\n")
}

fn member_emission_label_spelled_record_verdict() -> MemberEmissionVerdict {
  member_emission_verdict_of(source: "module v2.test.member_emission\n\ntype Weird { dag_surface_where_refinement_clause: Int }\n\nfn f(x: Int) -> Int { x as Int }\n")
}

fn member_emission_bool_signature_verdict() -> MemberEmissionVerdict {
  member_emission_verdict_of(source: "module v2.test.member_emission\n\nfn f(p: Bool) -> Bool { p }\n")
}

fn member_emission_string_signature_verdict() -> MemberEmissionVerdict {
  member_emission_verdict_of(source: "module v2.test.member_emission\n\nfn f(s: String) -> String { s }\n")
}

fn member_emission_string_field_verdict() -> MemberEmissionVerdict {
  member_emission_verdict_of(source: "module v2.test.member_emission\n\ntype Named { name: String }\n\nfn f(x: Int) -> Int { x as Int }\n")
}

fn member_emission_declared_string_signature_verdict() -> MemberEmissionVerdict {
  member_emission_verdict_of(source: "module v2.test.member_emission\n\ntype String = Empty | Cons { head: Int }\n\nfn f(s: String) -> String { s }\n")
}

fn member_emission_declared_type_signature_verdict() -> MemberEmissionVerdict {
  member_emission_verdict_of(source: "module v2.test.member_emission\n\ntype Decision = Allowed | Blocked\n\nfn f(d: Decision) -> Decision { d }\n")
}

fn member_emission_bare_parameter_body_verdict() -> MemberEmissionVerdict {
  member_emission_verdict_of(source: "module v2.test.member_emission\n\nfn f(x: Int) -> Int { x }\n")
}

fn member_emission_bare_literal_body_verdict() -> MemberEmissionVerdict {
  member_emission_verdict_of(source: "module v2.test.member_emission\n\nfn t() -> Bool { true }\n")
}

// A coproduct beside a function: BOTH are emitted, the enum first because it is declared first -- the
// module's direct members in source order, the coproduct through the semantic-declaration emitter and
// the function through the produced-declaration rows.
test fn a_coproduct_beside_a_function_emits_both_in_source_order_holds() -> Bool {
  match member_emission_coproduct_verdict() {
    MemberEmitted { text: t } =>
      string_contains(s: t, pattern: "enum Decision")
        && string_contains(s: t, pattern: "Allowed")
        && string_contains(s: t, pattern: "Blocked")
        && string_contains(s: t, pattern: "fn f(x: i32) -> i32")
        && match first(split(s: t, delimiter: "fn f(")) {
          Present { value: before_fn } => string_contains(s: before_fn, pattern: "enum Decision")
          Absent => false
        }
    MemberRefused { reason: _ } => false
    MemberClosureRefused { reason: _ } => false
  }
}

// A WHERE-REFINEMENT IS CLASSIFIED FROM ITS DECLARATION AND NEVER RENDERED AS A RECORD, although it shares a
// record's lowered shape: on the production route (parse, normalize, lowered carrier) it emits the target's
// transparent alias, not a struct. This is the route's inhabitance claim for the supplied row below.
test fn a_where_refinement_emits_its_transparent_alias_on_the_production_route_holds() -> Bool {
  match member_emission_refinement_verdict() {
    MemberEmitted { text: t } => string_contains(s: t, pattern: "type Pos = i32;") && !string_contains(s: t, pattern: "struct")
    MemberRefused { reason: _ } => false
    MemberClosureRefused { reason: _ } => false
  }
}

// THE REFINEMENT REALIZATION ITSELF, over a SUPPLIED member whose carrier is already lowered (the form the
// lowering above will produce): named in the module's refinement facts, it emits the target's transparent
// alias, the carrier spelled by the one type resolver -- `type Pos = i32;`, never a struct. The inhabitance
// partner is the route row above, which reaches the same arm for real.
fn member_emission_supplied_refinement() -> String {
  let member = Edge {
    label: Authored { name: ^Pos },
    target: node_synthetic(
      kind: TypeNode { connective: Conj },
      children: [
        Edge { label: Authored { name: ^dag_surface_type_expr }, target: node_synthetic(kind: TypeNode { connective: Atom { identity: ^dag_binding_type_int } }, children: []), declaration: NotADeclaration },
        Edge { label: dag_surface_edge_label(edge: ^dag_surface_where_refinement_clause), target: node_synthetic(kind: TypeNode { connective: Atom { identity: ^positive } }, children: []), declaration: NotADeclaration }
      ]
    ),
    declaration: NotADeclaration
  }
  match emit_module_member(
    edge: member,
    target: rust_target_model(),
    realization_host: rust_target_model(),
    kinds: [DeclaredRefinement { name: ^Pos }],
    tree: InferredTree { root: member.target, facts: PartialFunction { lookup: fn(n) { Absent } } },
    declarations: empty_symbol_index()
  ) {
    Accepted { value: m, diagnostics: _ } => m.carried
    Rejected { diagnostics: d } => concat("REFUSED ", symbol_lexeme(sym: diagnostics_fatal_reason(d: d)))
  }
}

test fn a_refinement_with_a_lowered_carrier_emits_a_transparent_alias_holds() -> Bool {
  let text = member_emission_supplied_refinement()
  string_contains(s: text, pattern: "type Pos = i32;") && !string_contains(s: text, pattern: "struct")
}

// A record -- a Conj its module's declaration kinds call DeclaredRecord -- emits as a struct beside the function, the
// record through the semantic-declaration emitter and its field's Int through the target's spelling.
test fn a_record_beside_a_function_emits_as_a_struct_holds() -> Bool {
  match member_emission_record_verdict() {
    MemberEmitted { text: t } =>
      string_contains(s: t, pattern: "struct Point")
        && string_contains(s: t, pattern: "a: i32")
        && !string_contains(s: t, pattern: "dag_binding_type_int")
        && string_contains(s: t, pattern: "fn f(x: i32) -> i32")
    MemberRefused { reason: _ } => false
    MemberClosureRefused { reason: _ } => false
  }
}

// A PAYLOAD-BEARING SINGLE VARIANT IS A ONE-ARM COPRODUCT, not a record and not an undecided Conj:
// `type Wrapped = Only { a: Int }` lowers to a Disj, so it emits as an enum whose one variant carries its
// field, spelled by the target.
test fn a_payload_single_variant_emits_as_a_one_arm_enum_holds() -> Bool {
  match member_emission_payload_variant_verdict() {
    MemberEmitted { text: t } =>
      string_contains(s: t, pattern: "enum Wrapped")
        && string_contains(s: t, pattern: "Only")
        && string_contains(s: t, pattern: "a: i32")
        && !string_contains(s: t, pattern: "dag_binding_type_int")
    MemberRefused { reason: _ } => false
    MemberClosureRefused { reason: _ } => false
  }
}

// THE KIND IS THE DECLARATION'S, NEVER ITS SPELLING: a record whose field is literally named like the
// where-clause label is still a record, because the record fact says so.
test fn a_record_with_a_where_labelled_field_is_still_a_record_holds() -> Bool {
  match member_emission_label_spelled_record_verdict() {
    MemberEmitted { text: t } => string_contains(s: t, pattern: "struct Weird")
    MemberRefused { reason: _ } => false
    MemberClosureRefused { reason: _ } => false
  }
}

// A SIGNATURE TYPE IS SPELLED BY THE TARGET: Bool reaches Rust `bool` through its atom realization and
// the target's spelling of that surface symbol -- never its carrier name `bool_node_symbol`.
test fn a_bool_signature_is_spelled_by_its_realization_holds() -> Bool {
  match member_emission_bool_signature_verdict() {
    MemberEmitted { text: t } =>
      string_contains(s: t, pattern: "fn f(p: bool) -> bool") && !string_contains(s: t, pattern: "bool_node_symbol")
    MemberRefused { reason: _ } => false
    MemberClosureRefused { reason: _ } => false
  }
}

// HOST TEXT IS SPELLED BY ITS OWN REALIZATION ROW (v2.extdeps.languages.rust
// rust_target_atom_realization_host_text, keyed on host_text_type_node): the kernel `String` at a signature
// and at a record field reaches Rust `String`, and the first is the case that refused
// produced_decl_type_ref_unrealized before the row.
test fn a_host_text_signature_is_spelled_by_its_realization_holds() -> Bool {
  match member_emission_string_signature_verdict() {
    MemberEmitted { text: t } => string_contains(s: t, pattern: "fn f(s: String) -> String")
    MemberRefused { reason: _ } => false
    MemberClosureRefused { reason: _ } => false
  }
}

test fn a_host_text_record_field_is_spelled_by_its_realization_holds() -> Bool {
  match member_emission_string_field_verdict() {
    MemberEmitted { text: t } => string_contains(s: t, pattern: "name: String")
    MemberRefused { reason: _ } => false
    MemberClosureRefused { reason: _ } => false
  }
}

// THE IDENTITY GUARD (gunbc.design_argument::closed_grounded_substrate, text crossings): a String the module itself declares is a different
// declaration and must NOT take the host-text row. It keeps its declaration-reference spelling; spelling it
// bare `String` would be the leaf-name capture the row is keyed to avoid.
test fn a_module_declared_string_does_not_take_the_host_text_realization_holds() -> Bool {
  match member_emission_declared_string_signature_verdict() {
    MemberEmitted { text: t } =>
      string_contains(s: t, pattern: "crate::v2_test_member_emission::String")
        && !string_contains(s: t, pattern: "fn f(s: String)")
    MemberRefused { reason: _ } => false
    MemberClosureRefused { reason: _ } => false
  }
}

// A REFERENCE TO A DECLARED TYPE IS SPELLED BY THE TARGET'S DECLARATION-REFERENCE FORM -- the rule the
// type-expression translate applies (v2.std.compilers.target_model
// target_type_expr_declaration_reference_emitted): Rust's is crate-rooted, `crate::<module>::<Name>`,
// the same for this module's types and another's, and never a bare leaf name. The enum it declares is
// emitted beside the function that uses it.
test fn a_declared_type_in_a_signature_keeps_its_name_holds() -> Bool {
  match member_emission_declared_type_signature_verdict() {
    MemberEmitted { text: t } =>
      string_contains(s: t, pattern: "enum Decision")
        && string_contains(s: t, pattern: "fn f(d: crate::v2_test_member_emission::Decision) -> crate::v2_test_member_emission::Decision")
    MemberRefused { reason: _ } => false
    MemberClosureRefused { reason: _ } => false
  }
}

// A BARE PARAMETER OR LITERAL BODY is the same atom form as a nested operand and emits.
test fn a_bare_parameter_body_emits_holds() -> Bool {
  match member_emission_bare_parameter_body_verdict() {
    MemberEmitted { text: t } => string_contains(s: t, pattern: "fn f(x: i32) -> i32 { x }")
    MemberRefused { reason: _ } => false
    MemberClosureRefused { reason: _ } => false
  }
}

test fn a_bare_literal_body_emits_holds() -> Bool {
  match member_emission_bare_literal_body_verdict() {
    MemberEmitted { text: t } => string_contains(s: t, pattern: "fn t() -> bool { true }")
    MemberRefused { reason: _ } => false
    MemberClosureRefused { reason: _ } => false
  }
}

test fn an_alias_member_refuses_under_its_own_reason_holds() -> Bool {
  match member_emission_alias_verdict() {
    MemberEmitted { text: _ } => false
    MemberRefused { reason: r } => r == ^emit_module_member_alias_not_realized
    MemberClosureRefused { reason: _ } => false
  }
}

test fn a_bodyless_member_refuses_under_its_own_reason_holds() -> Bool {
  match member_emission_opaque_verdict() {
    MemberEmitted { text: _ } => false
    MemberRefused { reason: r } => r == ^emit_module_member_opaque_not_realized
    MemberClosureRefused { reason: _ } => false
  }
}

// A GENERIC COPRODUCT IS THE PLAIN COPRODUCT WITH ITS BINDERS: the classifier unwraps the declaration
// once and the same semantic-declaration route renders it with the declared parameters. Its alias and
// bodyless siblings above keep their refusal pins as the controls for the kinds still unrealized.
test fn a_generic_coproduct_member_emits_with_its_parameters_holds() -> Bool {
  match member_emission_generic_verdict() {
    MemberEmitted { text: t } =>
      string_contains(s: t, pattern: "enum Tag<T>")
        && string_contains(s: t, pattern: "value: T")
    MemberRefused { reason: _ } => false
    MemberClosureRefused { reason: _ } => false
  }
}

// THE WALKER AND INFER DECLINE THE SAME WHERE-PREDICATE SET (v2.std.type_binder where_predicate_set_edge): a where-refinement
// module is never refused at the partition closure for facts infer was not asked to derive. The claim above is
// still judged by the member classifier; this one isolates the partition boundary so its RED is not masked by it.
test fn a_where_refinement_is_not_refused_for_missing_facts_holds() -> Bool {
  match member_emission_refinement_verdict() {
    MemberEmitted { text: _ } => true
    MemberRefused { reason: r } => r != ^partition_facts_miss
    MemberClosureRefused { reason: r } => r != ^partition_facts_miss
  }
}

// THE DECLARED KIND normalize CAPTURES FOR A SOURCE, one token per kind row (the production route's own
// type_declaration_kinds, which emit_module_member classifies a plain Conj by). A where clause refines the
// declaration only at its grammar position, so these controls pin both directions.
fn kind_capture_of(source: String) -> String {
  let lm = dag_language_model()
  match bind_outcome(
    o: tokenize(text: source, file: ^member_emission_read, rules: lm.lex),
    f: fn(tokens) {
      bind_outcome(
        o: parse_module(tokens: tokens, grammar: lm.grammar),
        f: fn(artifact) {
          bind_outcome(
            o: normalize(parse_tree: artifact.tree),
            f: fn(normalized) {
              outcome_accepted(value: fold_list(xs: normalized.type_declaration_kinds, empty: "", cons: fn(acc, k) {
                concat(acc, match k {
                  DeclaredRecord { name: n } => concat("R:", concat(symbol_lexeme(sym: n), ";"))
                  DeclaredRefinement { name: n } => concat("F:", concat(symbol_lexeme(sym: n), ";"))
                  _ => "O;"
                })
              }))
            }
          )
        }
      )
    }
  ) {
    Accepted { value: t, diagnostics: _ } => t
    Rejected { diagnostics: _ } => "REJECTED"
  }
}

test fn a_where_refinement_is_captured_as_a_declared_refinement_holds() -> Bool {
  kind_capture_of(source: "module v2.test.member_emission\n\ntype Pos = Int where positive\n\nfn positive(x: Int) -> Bool { true }\n") == "F:Pos;"
}

test fn a_plain_alias_is_captured_kindless_holds() -> Bool {
  kind_capture_of(source: "module v2.test.member_emission\n\ntype Id = Int\n") == ""
}

test fn a_record_keeps_its_declared_record_kind_holds() -> Bool {
  kind_capture_of(source: "module v2.test.member_emission\n\ntype Point { a: Int }\n") == "R:Point;"
}

test fn a_field_refinement_inside_a_variant_payload_does_not_refine_the_declaration_holds() -> Bool {
  kind_capture_of(source: "module v2.test.member_emission\n\ntype Bag = A { n: Int where positive } | B\n\nfn positive(x: Int) -> Bool { true }\n") == ""
}

// A FIELD'S where INSIDE A VARIANT PAYLOAD DOES NOT REFINE THE DECLARATION ON THE LOWERING ROUTE EITHER
// (body_lower_declared_where_host_optional stops at declared member edges): the member is CLASSIFIED a
// coproduct, where before it was refused emit_module_member_record_or_refinement_undecided (probe cc2-nw at
// d834c395). It then reaches the coproduct emitter and refuses at the NEXT link, declared-wrong: the field
// type `Int where positive` is a Conj, not an atom (target_semantic_decl_field_type_not_atom). Realizing an
// inline-refined field type is a separate emitter slice; this pin names it and goes RED the moment that
// slice lands, to be replaced by an emission claim (gunbc.design_argument::guarantee_ladder: the control stays enrolled).
fn member_emission_nested_where_verdict() -> MemberEmissionVerdict {
  member_emission_verdict_of(source: "module v2.test.member_emission\n\ntype Bag = A { n: Int where positive } | B\n\nfn positive(x: Int) -> Bool { true }\n\nfn f(x: Int) -> Int { x as Int }\n")
}

test fn a_field_where_inside_a_variant_payload_is_classified_a_coproduct_and_refuses_at_the_field_type_holds() -> Bool {
  match member_emission_nested_where_verdict() {
    MemberRefused { reason: r } => r == ^target_semantic_decl_field_type_not_atom
    _ => false
  }
}

test fn a_plain_payload_coproduct_control_emits_its_enum_holds() -> Bool {
  match member_emission_verdict_of(source: "module v2.test.member_emission\n\ntype Bag2 = A { n: Int } | B\n\nfn f(x: Int) -> Int { x as Int }\n") {
    MemberEmitted { text: t } => string_contains(s: t, pattern: "enum Bag2")
    _ => false
  }
}

// THE GENERIC RECORD ARM RUNS: a generic record is the plain record with its binders, rendered through the
// same semantic-declaration route as the coproduct above.
test fn a_generic_record_member_emits_a_generic_struct_holds() -> Bool {
  match member_emission_generic_record_verdict() {
    MemberEmitted { text: t } =>
      string_contains(s: t, pattern: "struct Box<T>")
        && string_contains(s: t, pattern: "value: T")
    MemberRefused { reason: _ } => false
    MemberClosureRefused { reason: _ } => false
  }
}

// THE GENERIC KINDS STILL UNREALIZED KEEP THEIR OWN TYPED REFUSAL (4b: the RED stays enrolled when a
// sibling arm climbs). A generic refinement is neither a coproduct nor a record, so emit_generic_module_member
// refuses it under emit_module_member_generic_not_realized rather than rendering a struct or a bare alias.
test fn a_generic_refinement_member_refuses_under_the_generic_reason_holds() -> Bool {
  match member_emission_generic_refinement_verdict() {
    MemberRefused { reason: r } => r == ^emit_module_member_generic_not_realized
    MemberEmitted { text: _ } => false
    MemberClosureRefused { reason: _ } => false
  }
}
