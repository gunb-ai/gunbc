module v2.test.emit.c_answer_union_grammar_debug

import v2.compiler.translate { grammar_relation_row_for_emitted }
import v2.extdeps.languages.c_decl {
  c_enum_general_decl_productions_only_translation_rules,
  c_semantic_decl_surface_projection
}
import v2.std.compilers.semantic_decl_emission {
  TargetSemanticDeclDecorationLine,
  semantic_decl_emission_from_target,
  target_semantic_decl_surface_field,
  target_semantic_decl_surface_tagged_union_nongeneric,
  target_semantic_decl_surface_tagged_union_union_body,
  target_semantic_decl_surface_tagged_union_union_field,
  target_semantic_decl_surface_union_member_payload,
  target_semantic_decl_surface_field_block,
  target_semantic_decl_coproduct_decoration_lines,
  target_semantic_enum_surface_from_coproduct
}
import v2.extdeps.languages.c { c_target_model }
import std.algebra { Empty }
import v2.std.logic { Bool }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.node { Disj, Edge, Named, SyntheticOccurrence, TypeNode, Conj, Atom, Node }

fn yes_member() -> Node {
  target_semantic_decl_surface_union_member_payload(
    name: ^Yes,
    fields: [
      target_semantic_decl_surface_field(
        name: ^n,
        t: ^Int,
        type_before_name: true,
        type_expr_field_scope: false
      )
    ]
  )
}

fn no_member() -> Node {
  target_semantic_decl_surface_union_member_payload(
    name: ^No,
    fields: [
      target_semantic_decl_surface_field(
        name: ^code,
        t: ^Int,
        type_before_name: true,
        type_expr_field_scope: false
      )
    ]
  )
}

fn union_body() -> Node {
  target_semantic_decl_surface_tagged_union_union_body(
    variants: [ yes_member(), no_member() ],
    union_field: ^c_token_union_field
  )
}

fn union_field() -> Node {
  target_semantic_decl_surface_tagged_union_union_field(
    variants: [ yes_member(), no_member() ],
    union_field: ^c_token_union_field
  )
}

fn tag_field() -> Node {
  target_semantic_decl_surface_field(
    name: ^c_token_tag_field,
    t: ^Int,
    type_before_name: true,
    type_expr_field_scope: false
  )
}

fn field_block() -> Node {
  target_semantic_decl_surface_field_block(
    fields: [ tag_field(), union_field() ]
  )
}

fn rules() -> Node {
  c_enum_general_decl_productions_only_translation_rules()
}

fn grammar_matches(emitted: Node) -> Bool {
  match grammar_relation_row_for_emitted(rules: rules(), emitted: emitted) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn c_answer_union_member_yes_grammar_holds() -> Bool {
  grammar_matches(emitted: yes_member())
}

test fn c_answer_union_body_grammar_holds() -> Bool {
  grammar_matches(emitted: union_body())
}

test fn c_answer_union_field_grammar_holds() -> Bool {
  grammar_matches(emitted: union_field())
}

fn tagged_union_surface() -> Node {
  target_semantic_decl_surface_tagged_union_nongeneric(
    name: ^Answer,
    decoration_lines: [
      TargetSemanticDeclDecorationLine { surface_binding: ^c_decl_shape_tagged_binding }
    ],
    projection: c_semantic_decl_surface_projection(),
    variants: [ yes_member(), no_member() ]
  )
}

fn answer_coproduct() -> Node {
  Node {
    kind: TypeNode { connective: Disj },
    children: [
      Edge {
        label: Named { name: ^Yes },
        target: Node {
          kind: TypeNode { connective: Conj },
          children: [
            Edge {
              label: Named { name: ^n },
              target: Node {
                kind: TypeNode { connective: Atom { identity: ^Int } },
                children: [],
                occurrence_id: SyntheticOccurrence
              }
            }
          ],
          occurrence_id: SyntheticOccurrence
        }
      },
      Edge {
        label: Named { name: ^No },
        target: Node {
          kind: TypeNode { connective: Conj },
          children: [
            Edge {
              label: Named { name: ^code },
              target: Node {
                kind: TypeNode { connective: Atom { identity: ^Int } },
                children: [],
                occurrence_id: SyntheticOccurrence
              }
            }
          ],
          occurrence_id: SyntheticOccurrence
        }
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

test fn c_answer_target_model_surface_grammar_holds() -> Bool {
  match semantic_decl_emission_from_target(target: c_target_model()) {
    Accepted { value: emission, diagnostics: _ } =>
      match target_semantic_enum_surface_from_coproduct(
        projection: emission.surface,
        name: ^Answer,
        params: Empty,
        coproduct: answer_coproduct()
      ) {
        Accepted { value: surface, diagnostics: _ } =>
          match grammar_relation_row_for_emitted(
            rules: emission.enum_translation_rules,
            emitted: surface
          ) {
            Accepted { value: _, diagnostics: _ } => true
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn c_answer_coproduct_surface_grammar_holds() -> Bool {
  match target_semantic_enum_surface_from_coproduct(
    projection: c_semantic_decl_surface_projection(),
    name: ^Answer,
    params: Empty,
    coproduct: answer_coproduct()
  ) {
    Accepted { value: surface, diagnostics: _ } => grammar_matches(emitted: surface)
    Rejected { diagnostics: _ } => false
  }
}

test fn c_answer_tagged_union_surface_grammar_holds() -> Bool {
  grammar_matches(emitted: tagged_union_surface())
}

test fn c_answer_field_block_grammar_holds() -> Bool {
  grammar_matches(emitted: field_block())
}
