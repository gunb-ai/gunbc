module v2.test.emit.semantic_decl_rules_parity_test


fn bool_coproduct() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Disj },
    children: [
      v2.std.node.Edge { label: Named { name: ^True }, target: v2.std.node.Node { kind: v2.std.node.TypeNode { connective: Conj }, children: [], occurrence_id: SyntheticOccurrence } },
      v2.std.node.Edge { label: Named { name: ^False }, target: v2.std.node.Node { kind: v2.std.node.TypeNode { connective: Conj }, children: [], occurrence_id: SyntheticOccurrence } }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn tokens_for_rules(surface: Node, rules: Node) -> Bool {
  match grammar_relation_row_for_emitted(rules: rules, emitted: surface) {
    Accepted { value: row, diagnostics: _ } =>
      match grammar_relation_row_tokens_root(row: row) {
        Accepted { value: tokens_root, diagnostics: _ } =>
          match concrete_syntax_token_list_from_node(list_node: tokens_root) {
            Accepted { value: _, diagnostics: _ } => true
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn emission_rules_match_rust_rules_for_generic_surface() -> Bool {
  match semantic_decl_emission_from_target(target: rust_target_model()) {
    Accepted { value: emission, diagnostics: _ } =>
      match target_semantic_enum_surface_from_coproduct(
        projection: emission.surface,
        name: ^Bool,
        params: std.algebra.Empty,
        coproduct: v2.test.emit.semantic_decl_rules_parity_test.bool_coproduct()
      ) {
        Accepted { value: surface, diagnostics: _ } =>
          tokens_for_rules(surface: surface, rules: emission.enum_translation_rules)
            && tokens_for_rules(
              surface: surface,
              rules: rust_enum_general_decl_productions_only_translation_rules()
            )
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}
