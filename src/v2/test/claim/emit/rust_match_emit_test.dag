module v2.test.emit.rust_match_emit


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data rust_match_emit_swapped_source_text: String = "fn one_or_two() -> i32 { match (true) { true => 2, false => 1 } }"

fn rust_match_emit_facts_miss(key: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  optional_absent()
}

fn rust_match_emit_inferred_tree_for(root: v2.std.node.Node) -> v2.compiler.inferred_tree.InferredTree {
  v2.compiler.inferred_tree.InferredTree {
    root: root,
    facts: std.algebra.PartialFunction { lookup: rust_match_emit_facts_miss }
  }
}

fn rust_match_emit_producer_inferred_tree() -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> {
  match table_fixture_match_arrow_with_body() {
    Accepted { value: root, diagnostics: d } =>
      v2.std.diagnostic.Accepted {
        value: rust_match_emit_inferred_tree_for(root: root),
        diagnostics: d
      }
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn rust_match_emit_swapped_producer_inferred_tree() -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> {
  match table_fixture_match_arrow_with_body_swapped_arms() {
    Accepted { value: root, diagnostics: d } =>
      v2.std.diagnostic.Accepted {
        value: rust_match_emit_inferred_tree_for(root: root),
        diagnostics: d
      }
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn rust_match_emit_from_tree(target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  bind_outcome(
    o: rust_match_emit_producer_inferred_tree(),
    f: fn(tree) {
      v2.compiler.emit.emit(tree: tree, target: target)
    }
  )
}

fn rust_match_emit_from_swapped_tree(target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  bind_outcome(
    o: rust_match_emit_swapped_producer_inferred_tree(),
    f: fn(tree) {
      v2.compiler.emit.emit(tree: tree, target: target)
    }
  )
}

test fn rust_match_emit_one_or_two_accepts() -> v2.std.logic.Bool {
  match rust_match_emit_from_tree(target: rust_match_target_model_staging()) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == rust_match_source_text) && (d == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

test fn rust_match_emit_swapped_arms_discriminates() -> v2.std.logic.Bool {
  match rust_match_emit_from_swapped_tree(target: rust_match_target_model_staging()) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == rust_match_emit_swapped_source_text) &&
      (source.carried != rust_match_source_text) &&
      (d == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

