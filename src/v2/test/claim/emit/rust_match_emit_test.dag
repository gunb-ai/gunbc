module v2.test.emit.rust_match_emit


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data rust_match_emit_swapped_source_text: String = "fn one_or_two() -> i32 { match (true) { true => 2, false => 1 } }"

fn rust_match_emit_facts_miss(key: Node) -> Witness<InferredFacts> {
  Violates {
    diagnostic: Diagnostic {
      reason: ^rust_match_emit_facts_not_consulted,
      at: node_locus(node: key),
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  }
}

fn rust_match_emit_inferred_tree_for(root: Node) -> InferredTree {
  InferredTree {
    root: root,
    facts: Map { lookup: rust_match_emit_facts_miss }
  }
}

fn rust_match_emit_producer_inferred_tree() -> Outcome<InferredTree> {
  match table_fixture_match_arrow_with_body() {
    Accepted { value: root, diagnostics: d } =>
      Accepted {
        value: rust_match_emit_inferred_tree_for(root: root),
        diagnostics: d
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn rust_match_emit_swapped_producer_inferred_tree() -> Outcome<InferredTree> {
  match table_fixture_match_arrow_with_body_swapped_arms() {
    Accepted { value: root, diagnostics: d } =>
      Accepted {
        value: rust_match_emit_inferred_tree_for(root: root),
        diagnostics: d
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn rust_match_emit_from_tree(target: TargetModel) -> Outcome<Medium<String>> {
  bind_outcome(
    o: rust_match_emit_producer_inferred_tree(),
    f: fn(tree) {
      emit(tree: tree, target: target)
    }
  )
}

fn rust_match_emit_from_swapped_tree(target: TargetModel) -> Outcome<Medium<String>> {
  bind_outcome(
    o: rust_match_emit_swapped_producer_inferred_tree(),
    f: fn(tree) {
      emit(tree: tree, target: target)
    }
  )
}

fn rust_match_emit_one_or_two_accepts() -> Bool {
  match rust_match_emit_from_tree(target: rust_match_target_model_staging()) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == rust_match_source_text) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

fn rust_match_emit_swapped_arms_discriminates() -> Bool {
  match rust_match_emit_from_swapped_tree(target: rust_match_target_model_staging()) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == rust_match_emit_swapped_source_text) &&
      (source.carried != rust_match_source_text) &&
      (d == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn rust_match_emit_holds() -> Bool {
  rust_match_emit_one_or_two_accepts()
    && rust_match_emit_swapped_arms_discriminates()
}
