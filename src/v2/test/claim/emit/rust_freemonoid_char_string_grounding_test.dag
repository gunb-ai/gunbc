module v2.test.emit.rust_freemonoid_char_string_grounding


data receipt_note: String = "Discriminating receipt for the Symbol/String emit grounding (Gate 1, emit_representation_mismatch): generalizes the numeric-tower grounding (PR 5428, native form == modeled form) to the text carrier. The v2 emit path grounds Symbol to native Rust String, but without this grounding it realizes the modeled String (FreeMonoid of Char) as a Vec via the free-monoid collection choice, so the two text carriers fork (the ~2100 E0308 Symbol-vs-String pair; in v1 emit it is corpus_repr HostNative-native vs FaithfulFreeMonoid-rope, 04_infer.dag). The grounding is element-conditional at the collection-repr choice: TargetCollectionRealization carries an optional TargetTextCarrier of element_carrier and emitted_type_node; when a FreeMonoid element content-hash-equals the carrier element (Char), project_free_monoid_collection_type_node in 06_translate emits the native String type_form instead of a Vec. The Char check and String type_form live in the rust.dag realization data, never hardcoded in the target-agnostic stage; a non-Char FreeMonoid still projects to Vec. This test pins that a FreeMonoid of Char projects to the SAME node as Symbol native-String type_form (RED before the grounding, GREEN after). NOTE: the whole-emitter regen is already HostNative-green; the ~4400 E0308 the milestone sizes is the Gate-2 per-module isolated probe (closure-denominated), and the type-pair histogram behind Symbol-String 82pct was never committed."

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn fmc_freemonoid_char_source_node() -> Node {
  Node {
    kind: TypeNode { connective: Instantiation },
    children: [
      Edge { label: Positional, target: target_carrier_free_monoid_node() },
      Edge { label: Positional, target: char_kernel_type_node() }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn fmc_target() -> TargetModel {
  rust_sg2_type_expr_projection_probe_target_model()
}

fn fmc_native_string_type_form_node() -> Node {
  rust_target_atom_realization_symbol.type_form.node
}

fn fmc_projected_node() -> Node {
  match translate_type_expression_project(
    node: fmc_freemonoid_char_source_node(),
    target: fmc_target(),
    projection: rust_type_expression_projection()
  ) {
    Accepted { value: emitted, diagnostics: _ } => emitted
    Rejected { diagnostics: _ } => fmc_freemonoid_char_source_node()
  }
}

test fn fmc_projection_accepts() -> Bool {
  match translate_type_expression_project(
    node: fmc_freemonoid_char_source_node(),
    target: fmc_target(),
    projection: rust_type_expression_projection()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn fmc_freemonoid_char_grounds_to_native_string() -> Bool {
  content_hash(n: fmc_projected_node()) == content_hash(n: fmc_native_string_type_form_node())
}
