module v2.test.claim.emit.semantic_decl_doc_conformance

import std.occurrence_identity { OccurrenceSynthetic }
import v2.compiler.emit_semantic_decl { emit_semantic_type_decl }
import v2.extdeps.languages.swift { swift_target_model }
import v2.extdeps.languages.c { c_target_model }
import v2.std.compilers.target_model { TargetModel }
import std.decl_ref { DeclarationRef, NamedField }
import std.types { NonEmptyStr }
import v2.std.compilers.semantic_decl_emission { TargetSemanticDeclDocumentation, TargetSemanticDeclFieldDoc, ConformancesNamed, ConformancesTargetDefault, TargetSemanticDeclConformances }
import v2.std.diagnostic { Accepted, None, Outcome, Rejected }
import v2.std.node { Atom, Conj, Node, Symbol, TypeNode }
import v2.std.text { String }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node_query { binder_edge }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE SUBJECT IS emit_semantic_type_decl WITH DOC LINES AND A CONFORMANCE LIST over each target's doc and
// conformance projection rows. Goldens are the exact text, so a doc printed after the declaration, a dropped name,
// or a name printed under an unwired target reds here.

fn sdc_point_record(type_name: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [ binder_edge(name: ^x, type_node: Node { kind: TypeNode { connective: Atom { identity: type_name } }, children: [], occurrence_id: OccurrenceSynthetic }) ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn sdc_text_documented(documentation: TargetSemanticDeclDocumentation, conformances: TargetSemanticDeclConformances, type_name: Symbol, target: TargetModel) -> Outcome<String> {
  match emit_semantic_type_decl(header: [], documentation: documentation, conformances: conformances, imports: [], members: [], name: ^Point, params: [], node: sdc_point_record(type_name: type_name), target: target, realization_host: target) {
    Accepted { value: medium, diagnostics: _ } => Accepted { value: medium.carried, diagnostics: None }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn sdc_text(docs: List<String>, conformances: TargetSemanticDeclConformances, type_name: Symbol, target: TargetModel) -> Outcome<String> {
  sdc_text_documented(documentation: TargetSemanticDeclDocumentation { lines: docs, fields: [] }, conformances: conformances, type_name: type_name, target: target)
}

fn sdc_field_doc(decl: String, field: String, lines: List<String>) -> TargetSemanticDeclFieldDoc {
  TargetSemanticDeclFieldDoc {
    field: DeclarationRef { module_path: "m", decl_name: decl as NonEmptyStr, field: NamedField { field_name: field as NonEmptyStr } },
    lines: lines
  }
}

fn sdc_field_docs_text(fields: List<TargetSemanticDeclFieldDoc>, type_name: Symbol, target: TargetModel) -> Outcome<String> {
  sdc_text_documented(documentation: TargetSemanticDeclDocumentation { lines: [], fields: fields }, conformances: ConformancesTargetDefault, type_name: type_name, target: target)
}

fn sdc_equals(o: Outcome<String>, golden: String) -> Bool {
  match o {
    Accepted { value: text, diagnostics: _ } => text == golden
    Rejected { diagnostics: _ } => false
  }
}

test fn swift_docs_lead_the_declaration() -> Bool {
  sdc_equals(
    o: sdc_text(docs: ["A point.", "Two lines."], conformances: ConformancesTargetDefault, type_name: ^dag_binding_type_int, target: swift_target_model()),
    golden: "/// A point.\n/// Two lines.\nstruct Point: Equatable, Sendable {\n    let x: Int32\n}"
  )
}

test fn swift_named_conformances_replace_the_default() -> Bool {
  sdc_equals(
    o: sdc_text(docs: [], conformances: ConformancesNamed { names: [^Equatable, ^Codable] }, type_name: ^dag_binding_type_int, target: swift_target_model()),
    golden: "struct Point: Equatable, Codable {\n    let x: Int32\n}"
  )
}

test fn c_without_docs_or_conformances_still_emits() -> Bool {
  sdc_equals(
    o: sdc_text(docs: [], conformances: ConformancesTargetDefault, type_name: ^Int, target: c_target_model()),
    golden: "typedef struct { int x; } Point;"
  )
}

test fn c_with_docs_refuses_unwired() -> Bool {
  match sdc_text(docs: ["A point."], conformances: ConformancesTargetDefault, type_name: ^Int, target: c_target_model()) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d.head.reason == ^target_semantic_decl_doc_unwired
  }
}

test fn c_with_conformances_refuses_unwired() -> Bool {
  match sdc_text(docs: [], conformances: ConformancesNamed { names: [^Equatable] }, type_name: ^Int, target: c_target_model()) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d.head.reason == ^target_semantic_decl_conformance_unwired
  }
}

test fn swift_field_docs_lead_their_field() -> Bool {
  sdc_equals(
    o: sdc_field_docs_text(fields: [ sdc_field_doc(decl: "Point", field: "x", lines: ["The x."]) ], type_name: ^dag_binding_type_int, target: swift_target_model()),
    golden: "struct Point: Equatable, Sendable {\n    /// The x.\n    let x: Int32\n}"
  )
}

test fn c_with_field_docs_refuses_unwired() -> Bool {
  match sdc_field_docs_text(fields: [ sdc_field_doc(decl: "Point", field: "x", lines: ["The x."]) ], type_name: ^Int, target: c_target_model()) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d.head.reason == ^target_semantic_decl_doc_unwired
  }
}

fn sdc_refuses_with(o: Outcome<String>, reason: Symbol) -> Bool {
  match o {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d.head.reason == reason
  }
}

// RED: a doc entry for a field the record lacks is refused, never dropped.
test fn a_field_doc_for_a_missing_field_refuses() -> Bool {
  sdc_refuses_with(
    o: sdc_field_docs_text(fields: [ sdc_field_doc(decl: "Point", field: "y", lines: ["The y."]) ], type_name: ^dag_binding_type_int, target: swift_target_model()),
    reason: ^target_semantic_decl_field_doc_unknown_field
  )
}

// RED: an entry keyed to ANOTHER declaration's field is not this record's field.
test fn a_field_doc_keyed_to_another_declaration_refuses() -> Bool {
  sdc_refuses_with(
    o: sdc_field_docs_text(fields: [ sdc_field_doc(decl: "Other", field: "x", lines: ["The x."]) ], type_name: ^dag_binding_type_int, target: swift_target_model()),
    reason: ^target_semantic_decl_field_doc_unknown_field
  )
}

// RED: two entries for one field refuse.
test fn a_duplicate_field_doc_refuses() -> Bool {
  sdc_refuses_with(
    o: sdc_field_docs_text(fields: [ sdc_field_doc(decl: "Point", field: "x", lines: ["A."]), sdc_field_doc(decl: "Point", field: "x", lines: ["B."]) ], type_name: ^dag_binding_type_int, target: swift_target_model()),
    reason: ^target_semantic_decl_field_doc_duplicate
  )
}

// RED: a doc line (declaration or field) carrying a line break would end the doc comment and print the rest as code.
test fn a_doc_line_with_a_newline_refuses() -> Bool {
  sdc_refuses_with(
    o: sdc_text(docs: ["A point.\nstruct Evil {}"], conformances: ConformancesTargetDefault, type_name: ^dag_binding_type_int, target: swift_target_model()),
    reason: ^target_semantic_decl_line_break
  )
}

test fn a_field_doc_line_with_a_newline_refuses() -> Bool {
  sdc_refuses_with(
    o: sdc_field_docs_text(fields: [ sdc_field_doc(decl: "Point", field: "x", lines: ["The x.\nlet evil = 1"]) ], type_name: ^dag_binding_type_int, target: swift_target_model()),
    reason: ^target_semantic_decl_line_break
  )
}
