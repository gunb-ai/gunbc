module v2.test.emit.rust_produced_decl_emit

import v2.test.complexity_gate.table_fixture_add_subject_producer { table_fixture_add_decl_node }
import v2.compiler.emit_produced { emit_produced_decl_rust }
import v2.std.diagnostic { Accepted, None, Outcome, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Node, Symbol }
import v2.std.text { String }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data rust_produced_add_golden: String = "fn add(x: i32, y: i32) -> i32 { x + y }"

data rust_produced_add2_golden: String = "fn add2(x: i32, y: i32) -> i32 { x + y }"

fn rust_produced_decl_text(fn_name: Symbol) -> Outcome<String> {
  match table_fixture_add_decl_node(fn_name: fn_name) {
    Accepted { value: decl, diagnostics: _ } =>
      match emit_produced_decl_rust(decl: decl) {
        Accepted { value: medium, diagnostics: _ } =>
          Accepted { value: medium.carried, diagnostics: None }
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn rust_produced_decl_matches(fn_name: Symbol, golden: String) -> Bool {
  match rust_produced_decl_text(fn_name: fn_name) {
    Accepted { value: text, diagnostics: _ } => text == golden
    Rejected { diagnostics: _ } => false
  }
}

test fn rust_produced_decl_emits_named_add() -> Bool {
  rust_produced_decl_matches(fn_name: ^rust_binding_fn_add, golden: rust_produced_add_golden)
}

test fn rust_produced_decl_emits_named_add2() -> Bool {
  rust_produced_decl_matches(fn_name: ^rust_binding_fn_add2, golden: rust_produced_add2_golden)
}

test fn rust_produced_decl_name_discriminates() -> Bool {
  rust_produced_decl_emits_named_add()
    && rust_produced_decl_emits_named_add2()
    && !rust_produced_decl_matches(fn_name: ^rust_binding_fn_add2, golden: rust_produced_add_golden)
}