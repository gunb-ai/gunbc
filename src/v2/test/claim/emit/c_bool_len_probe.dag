module v2.test.emit.c_bool_len_probe

import v2.compiler.emit_semantic_decl { emit_semantic_type_decl }
import v2.extdeps.languages.c { c_target_model }
import std.algebra { Empty }
import v2.std.algebra { fold_list }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Conj, Disj, Edge, Named, Node, SyntheticOccurrence, TypeNode }

fn bool_coproduct() -> Node {
  Node {
    kind: TypeNode { connective: Disj },
    children: [
      Edge { label: Named { name: ^True }, target: Node { kind: TypeNode { connective: Conj }, children: [], occurrence_id: SyntheticOccurrence } },
      Edge { label: Named { name: ^False }, target: Node { kind: TypeNode { connective: Conj }, children: [], occurrence_id: SyntheticOccurrence } }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn str_len(s: String) -> Int {
  fold_list(xs: s, empty: 0, cons: fn(acc, _) { acc + 1 })
}

test fn c_bool_emit_len_is_30_holds() -> Bool {
  match emit_semantic_type_decl(name: ^Bool, params: Empty, node: bool_coproduct(), target: c_target_model()) {
    Accepted { value: medium, diagnostics: _ } => str_len(s: medium.carried) == 30
    Rejected { diagnostics: _ } => false
  }
}

test fn c_bool_emit_len_is_31_holds() -> Bool {
  match emit_semantic_type_decl(name: ^Bool, params: Empty, node: bool_coproduct(), target: c_target_model()) {
    Accepted { value: medium, diagnostics: _ } => str_len(s: medium.carried) == 31
