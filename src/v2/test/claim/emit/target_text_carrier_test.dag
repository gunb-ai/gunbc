module v2.test.emit.target_text_carrier


// TargetText carrier discriminating control (DESIGN.md §5: a wall must be green-by-execution with a control that reds when the behavior is wrong). TargetText is the typed emit-seam carrier; text_atom is the single String->carrier introduction (one grammar-classified token), target_text_seq is the grammar-owned token-sequence join, render_target_text is the whole-value exit. These witnesses red if the join loses ORDER (a symmetrized/swapped seq), drops the empty identity, or the atom/render round-trip breaks -- the faithfulness the 06_translate serialize-family migration relies on. The larger byte-identity proof is the test/claim/emit/rust_*_emit goldens (which carry their own operand-swap discriminating controls); this file guards the carrier primitive those goldens are built on.
test fn target_text_atom_render_round_trips_holds() -> Bool {
  v2.std.compilers.target_model.render_target_text(t: v2.std.compilers.target_model.text_atom(lexeme: "add")) == "add"
}

test fn target_text_seq_is_ordered_concatenation_holds() -> Bool {
  v2.std.compilers.target_model.render_target_text(
    t: v2.std.compilers.target_model.target_text_seq(acc: v2.std.compilers.target_model.text_atom(lexeme: "fn "), next: v2.std.compilers.target_model.text_atom(lexeme: "add"))
  ) == "fn add"
}

test fn target_text_seq_order_discriminates_holds() -> Bool {
  let ab = v2.std.compilers.target_model.render_target_text(t: v2.std.compilers.target_model.target_text_seq(acc: v2.std.compilers.target_model.text_atom(lexeme: "A"), next: v2.std.compilers.target_model.text_atom(lexeme: "B")))
  let ba = v2.std.compilers.target_model.render_target_text(t: v2.std.compilers.target_model.target_text_seq(acc: v2.std.compilers.target_model.text_atom(lexeme: "B"), next: v2.std.compilers.target_model.text_atom(lexeme: "A")))
  (ab == "AB") && (ba == "BA") && (ab != ba)
}

test fn target_text_empty_is_seq_identity_holds() -> Bool {
  (v2.std.compilers.target_model.render_target_text(t: v2.std.compilers.target_model.target_text_empty) == "")
    && (v2.std.compilers.target_model.render_target_text(t: v2.std.compilers.target_model.target_text_seq(acc: v2.std.compilers.target_model.target_text_empty, next: v2.std.compilers.target_model.text_atom(lexeme: "x"))) == "x")
    && (v2.std.compilers.target_model.render_target_text(t: v2.std.compilers.target_model.target_text_seq(acc: v2.std.compilers.target_model.text_atom(lexeme: "x"), next: v2.std.compilers.target_model.target_text_empty)) == "x")
}

test fn target_text_is_empty_discriminates_holds() -> Bool {
  v2.std.compilers.target_model.target_text_is_empty(t: v2.std.compilers.target_model.target_text_empty)
    && (v2.std.compilers.target_model.target_text_is_empty(t: v2.std.compilers.target_model.text_atom(lexeme: "x")) == false)
}
