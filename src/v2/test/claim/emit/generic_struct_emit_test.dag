module v2.test.emit.generic_struct_emit

import v2.compiler.translate {
  grammar_relation_row_for_emitted,
  grammar_relation_row_tokens_root,
  serialize_concrete_syntax_tokens_to_source
}
import v2.extdeps.languages.rust {
  rust_inhabitant_atom,
  rust_generic_struct_decl_productions_only_translation_rules,
  rust_generic_struct_decl_structural_target_model
}
import v2.std.algebra { fold_list, fold_list_right }
import v2.std.collection { List }
import v2.std.compilers.target_model {
  TargetModel,
  concrete_syntax_token_list_from_node
}
import v2.std.diagnostic {
  Accepted,
  Outcome,
  Rejected,
  bind_outcome,
  outcome_accepted
}
import v2.std.integer { Int }
import v2.std.logic { Bool }
import v2.std.node {
  Conj,
  Edge,
  Node,
  Positional,
  Symbol,
  SyntheticOccurrence,
  TypeNode
}

data gs_vendor_golden: String = "struct Vendor<Domain> { legal_name: String }"
data gs_pair_golden: String = "struct Pair<K, V> { key: K, value: V }"

fn gs_sym(s: String) -> Symbol { s }

fn gs_nil() -> Node {
  Node { kind: TypeNode { connective: Conj }, children: [], occurrence_id: SyntheticOccurrence }
}

fn gs_pos(target: Node) -> Edge {
  Edge { label: Positional, target: target }
}

fn gs_qualified_name(t: Symbol) -> Node {
  Node { kind: TypeNode { connective: Conj }, children: [ gs_pos(target: rust_inhabitant_atom(id: t)) ], occurrence_id: SyntheticOccurrence }
}

fn gs_type_expr(t: Symbol) -> Node {
  Node { kind: TypeNode { connective: Conj }, children: [ gs_pos(target: gs_qualified_name(t: t)) ], occurrence_id: SyntheticOccurrence }
}

fn gs_field(name: Symbol, t: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [ gs_pos(target: rust_inhabitant_atom(id: name)), gs_pos(target: gs_type_expr(t: t)) ],
    occurrence_id: SyntheticOccurrence
  }
}

fn gs_field_list_cell(field: Node, rest: Node) -> Node {
  Node { kind: TypeNode { connective: Conj }, children: [ gs_pos(target: field), gs_pos(target: rest) ], occurrence_id: SyntheticOccurrence }
}

fn gs_field_list_from(fields: List<Node>) -> Node {
  fold_list_right(
    xs: fields,
    empty: gs_nil(),
    snoc: fn(acc, field) { gs_field_list_cell(field: field, rest: acc) }
  )
}

fn gs_field_block(field_list: Node) -> Node {
  Node { kind: TypeNode { connective: Conj }, children: [ gs_pos(target: field_list) ], occurrence_id: SyntheticOccurrence }
}

fn gs_type_param_cell(param: Symbol, rest: Node) -> Node {
  Node { kind: TypeNode { connective: Conj }, children: [ gs_pos(target: rust_inhabitant_atom(id: param)), gs_pos(target: rest) ], occurrence_id: SyntheticOccurrence }
}

fn gs_type_param_list_from(params: List<String>) -> Node {
  fold_list_right(
    xs: params,
    empty: gs_nil(),
    snoc: fn(acc, param) { gs_type_param_cell(param: gs_sym(s: param), rest: acc) }
  )
}

fn gs_params(type_param_list: Node) -> Node {
  Node { kind: TypeNode { connective: Conj }, children: [ gs_pos(target: type_param_list) ], occurrence_id: SyntheticOccurrence }
}

fn gs_struct_decl(name: Symbol, params: Node, field_block: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [ gs_pos(target: rust_inhabitant_atom(id: name)), gs_pos(target: params), gs_pos(target: field_block) ],
    occurrence_id: SyntheticOccurrence
  }
}

fn gs_vendor_emitted() -> Node {
  gs_struct_decl(
    name: gs_sym(s: "Vendor"),
    params: gs_params(type_param_list: gs_type_param_list_from(params: ["Domain"])),
    field_block: gs_field_block(
      field_list: gs_field_list_from(fields: [ gs_field(name: gs_sym(s: "legal_name"), t: gs_sym(s: "String")) ])
    )
  )
}

fn gs_pair_emitted() -> Node {
  gs_struct_decl(
    name: gs_sym(s: "Pair"),
    params: gs_params(type_param_list: gs_type_param_list_from(params: ["K", "V"])),
    field_block: gs_field_block(
      field_list: gs_field_list_from(fields: [
        gs_field(name: gs_sym(s: "key"), t: gs_sym(s: "K")),
        gs_field(name: gs_sym(s: "value"), t: gs_sym(s: "V"))
      ])
    )
  )
}

fn gs_no_generic_params_emitted() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      gs_pos(target: rust_inhabitant_atom(id: gs_sym(s: "Plain"))),
      gs_pos(target: gs_field_block(
        field_list: gs_field_list_from(fields: [ gs_field(name: gs_sym(s: "value"), t: gs_sym(s: "Int")) ])
      ))
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn gs_target() -> TargetModel {
  rust_generic_struct_decl_structural_target_model()
}

fn gs_emit_source_text(emitted: Node) -> Outcome<String> {
  bind_outcome(
    o: grammar_relation_row_for_emitted(
      rules: rust_generic_struct_decl_productions_only_translation_rules(),
      emitted: emitted
    ),
    f: fn(row) {
      bind_outcome(
        o: grammar_relation_row_tokens_root(row: row),
        f: fn(tokens_root) {
          bind_outcome(
            o: concrete_syntax_token_list_from_node(list_node: tokens_root),
            f: fn(tokens) {
              bind_outcome(
                o: serialize_concrete_syntax_tokens_to_source(target: gs_target(), tokens: tokens),
                f: fn(medium) { outcome_accepted(value: medium.carried) }
              )
            }
          )
        }
      )
    }
  )
}

fn gs_emit_matches_golden(emitted: Node, golden: String) -> Bool {
  match gs_emit_source_text(emitted: emitted) {
    Accepted { value: text, diagnostics: _ } => text == golden
    Rejected { diagnostics: _ } => false
  }
}

fn gs_construct_refused(emitted: Node) -> Bool {
  match gs_emit_source_text(emitted: emitted) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

type GenericStructEmitConstructRow {
  construct: Symbol
  covered: Bool
}

data gs_construct_rows: List<GenericStructEmitConstructRow> = [
  GenericStructEmitConstructRow { construct: ^struct_vendor_generic_one_param, covered: true },
  GenericStructEmitConstructRow { construct: ^struct_pair_generic_two_params, covered: true },
  GenericStructEmitConstructRow { construct: ^struct_no_generic_params, covered: false }
]

fn gs_covered_count() -> Int {
  fold_list(xs: gs_construct_rows, empty: 0, cons: fn(acc, row) { if row.covered { acc + 1 } else { acc } })
}

fn gs_refused_count() -> Int {
  fold_list(xs: gs_construct_rows, empty: 0, cons: fn(acc, row) { if row.covered { acc } else { acc + 1 } })
}

fn gs_covered_holds() -> Bool {
  gs_emit_matches_golden(emitted: gs_vendor_emitted(), golden: gs_vendor_golden)
    && gs_emit_matches_golden(emitted: gs_pair_emitted(), golden: gs_pair_golden)
}

fn gs_golden_discriminates_holds() -> Bool {
  !gs_emit_matches_golden(emitted: gs_vendor_emitted(), golden: "struct Vendor<Domain> { legal_name: STRING }")
    && !gs_emit_matches_golden(emitted: gs_vendor_emitted(), golden: gs_pair_golden)
}

fn gs_gaps_refused_holds() -> Bool {
  gs_construct_refused(emitted: gs_no_generic_params_emitted())
    && (gs_refused_count() == 1)
    && (gs_covered_count() == 2)
}

test fn generic_struct_emit_holds() -> Bool {
  gs_covered_holds()
    && gs_golden_discriminates_holds()
    && gs_gaps_refused_holds()
}
