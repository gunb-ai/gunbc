module v2.test.emit.rust_literal_bind_emit

import v2.test.complexity_gate.table_fixture_bind_subject_producer {
  table_fixture_bind_arrow_with_body,
  table_fixture_bind_wrong_value_arrow_with_body
}
import v2.compiler.emit { emit }
import v2.compiler.infer { InferredFacts, InferredTree }
import v2.extdeps.languages.rust_test {
  rust_literal_emit_string_refusal_note,
  rust_bind_bool_literal_arrow_node,
  rust_bind_bool_literal_source_text,
  rust_bind_bool_literal_wrong_arrow_node,
  rust_bind_bool_literal_wrong_source_text,
  rust_bind_char_literal_arrow_node,
  rust_bind_char_literal_source_text,
  rust_bind_char_literal_wrong_arrow_node,
  rust_bind_char_literal_wrong_source_text,
  rust_bind_int_literal_source_text,
  rust_bind_int_literal_wrong_source_text,
  rust_bind_literal_target_model
}
import extdeps.communication.medium { Medium }
import v2.std.collection { Optional, Present, Absent, Map }
import v2.std.compilers.target_model {
  TargetModel,
  target_value_expression_string_literal,
  target_value_expression_tokens_from_target,
  target_value_expression_projection_from_target
}
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  bind_outcome,
  node_locus
}
import v2.std.logic { Bool }
import v2.std.node { Conj, Disj, Node, SyntheticOccurrence, TypeNode }
import v2.std.witness { Violates, Witness }
import v2.std.algebra { free_monoid_type_node }
import v2.std.compilers.target_model { char_kernel_type_node }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn rust_literal_bind_facts_miss(key: Node) -> Optional<InferredFacts> {
  Absent
}

fn rust_literal_bind_inferred_tree_for(root: Node) -> InferredTree {
  InferredTree {
    root: root,
    facts: Map { lookup: rust_literal_bind_facts_miss }
  }
}

fn rust_literal_bind_emit_from_root(root: Node, target: TargetModel) -> Outcome<Medium<String>> {
  emit(tree: rust_literal_bind_inferred_tree_for(root: root), target: target)
}

fn rust_literal_bind_int_emit_from_producer(target: TargetModel) -> Outcome<Medium<String>> {
  bind_outcome(
    o: table_fixture_bind_arrow_with_body(),
    f: fn(root) {
      rust_literal_bind_emit_from_root(root: root, target: target)
    }
  )
}

fn rust_literal_bind_int_wrong_emit_from_producer(target: TargetModel) -> Outcome<Medium<String>> {
  bind_outcome(
    o: table_fixture_bind_wrong_value_arrow_with_body(),
    f: fn(root) {
      rust_literal_bind_emit_from_root(root: root, target: target)
    }
  )
}

fn rust_literal_bind_int_emit_accepts() -> Bool {
  match rust_literal_bind_int_emit_from_producer(target: rust_bind_literal_target_model()) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == rust_bind_int_literal_source_text) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

fn rust_literal_bind_int_wrong_value_discriminates() -> Bool {
  match rust_literal_bind_int_emit_from_producer(target: rust_bind_literal_target_model()) {
    Accepted { value: canonical, diagnostics: dc } =>
      match rust_literal_bind_int_wrong_emit_from_producer(target: rust_bind_literal_target_model()) {
        Accepted { value: wrong, diagnostics: dw } =>
          (wrong.carried == rust_bind_int_literal_wrong_source_text) &&
          (wrong.carried != canonical.carried) &&
          (dc == None) &&
          (dw == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn rust_literal_bind_bool_emit_accepts() -> Bool {
  match rust_literal_bind_emit_from_root(
    root: rust_bind_bool_literal_arrow_node(),
    target: rust_bind_literal_target_model()
  ) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == rust_bind_bool_literal_source_text) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

fn rust_literal_bind_bool_wrong_value_discriminates() -> Bool {
  match rust_literal_bind_emit_from_root(
    root: rust_bind_bool_literal_arrow_node(),
    target: rust_bind_literal_target_model()
  ) {
    Accepted { value: canonical, diagnostics: dc } =>
      match rust_literal_bind_emit_from_root(
        root: rust_bind_bool_literal_wrong_arrow_node(),
        target: rust_bind_literal_target_model()
      ) {
        Accepted { value: wrong, diagnostics: dw } =>
          (wrong.carried == rust_bind_bool_literal_wrong_source_text) &&
          (wrong.carried != canonical.carried) &&
          (dc == None) &&
          (dw == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn rust_literal_bind_char_emit_accepts() -> Bool {
  match rust_literal_bind_emit_from_root(
    root: rust_bind_char_literal_arrow_node(),
    target: rust_bind_literal_target_model()
  ) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == rust_bind_char_literal_source_text) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

fn rust_literal_bind_char_wrong_value_discriminates() -> Bool {
  match rust_literal_bind_emit_from_root(
    root: rust_bind_char_literal_arrow_node(),
    target: rust_bind_literal_target_model()
  ) {
    Accepted { value: canonical, diagnostics: dc } =>
      match rust_literal_bind_emit_from_root(
        root: rust_bind_char_literal_wrong_arrow_node(),
        target: rust_bind_literal_target_model()
      ) {
        Accepted { value: wrong, diagnostics: dw } =>
          (wrong.carried == rust_bind_char_literal_wrong_source_text) &&
          (wrong.carried != canonical.carried) &&
          (dc == None) &&
          (dw == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn rust_literal_bind_string_rope_refusal_is_executed() -> Bool {
  match target_value_expression_projection_from_target(
    target: rust_bind_literal_target_model()
  ) {
    Accepted { value: projection, diagnostics: pd } =>
      match target_value_expression_tokens_from_target(
        expr: target_value_expression_string_literal(
          value: Node {
            kind: TypeNode { connective: Conj },
            children: [],
            occurrence_id: SyntheticOccurrence
          }
        ),
        target: rust_bind_literal_target_model(),
        projection: projection
      ) {
        Rejected { diagnostics: d } =>
          (d.head.reason == ^target_value_expression_emit_unsupported_kind) &&
          (pd == None) &&
          (rust_literal_emit_string_refusal_note != "")
        Accepted { value: _, diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn rust_literal_bind_string_rope_carrier_is_free_monoid() -> Bool {
  match free_monoid_type_node(inhabitant: char_kernel_type_node()).kind {
    TypeNode { connective: Disj } => true
    _ => false
  }
}

test fn rust_literal_bind_emit_holds() -> Bool {
  rust_literal_bind_int_emit_accepts()
    && rust_literal_bind_int_wrong_value_discriminates()
    && rust_literal_bind_bool_emit_accepts()
    && rust_literal_bind_bool_wrong_value_discriminates()
    && rust_literal_bind_char_emit_accepts()
    && rust_literal_bind_char_wrong_value_discriminates()
    && rust_literal_bind_string_rope_refusal_is_executed()
    && rust_literal_bind_string_rope_carrier_is_free_monoid()
}
