module v2.test.emit.rust_literal_bind_emit


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn rust_literal_bind_facts_miss(key: Node) -> Optional<v2.compiler.inferred_tree.InferredFacts> {
  optional_absent()
}

fn rust_literal_bind_inferred_tree_for(root: Node) -> v2.compiler.inferred_tree.InferredTree {
  v2.compiler.inferred_tree.InferredTree {
    root: root,
    facts: std.types.Map { lookup: rust_literal_bind_facts_miss }
  }
}

fn rust_literal_bind_emit_from_root(root: Node, target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  emit(tree: rust_literal_bind_inferred_tree_for(root: root), target: target)
}

fn rust_literal_bind_int_emit_from_producer(target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  bind_outcome(
    o: table_fixture_bind_arrow_with_body(),
    f: fn(root) {
      rust_literal_bind_emit_from_root(root: root, target: target)
    }
  )
}

fn rust_literal_bind_int_wrong_emit_from_producer(target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  bind_outcome(
    o: table_fixture_bind_wrong_value_arrow_with_body(),
    f: fn(root) {
      rust_literal_bind_emit_from_root(root: root, target: target)
    }
  )
}

test fn rust_literal_bind_int_emit_accepts() -> Bool {
  match rust_literal_bind_int_emit_from_producer(target: rust_bind_literal_target_model()) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == rust_bind_int_literal_source_text) && (d == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

test fn rust_literal_bind_int_wrong_value_discriminates() -> Bool {
  match rust_literal_bind_int_emit_from_producer(target: rust_bind_literal_target_model()) {
    Accepted { value: canonical, diagnostics: dc } =>
      match rust_literal_bind_int_wrong_emit_from_producer(target: rust_bind_literal_target_model()) {
        Accepted { value: wrong, diagnostics: dw } =>
          (wrong.carried == rust_bind_int_literal_wrong_source_text) &&
          (wrong.carried != canonical.carried) &&
          (dc == v2.std.diagnostic.None) &&
          (dw == v2.std.diagnostic.None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

