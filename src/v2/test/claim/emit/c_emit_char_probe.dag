module v2.test.emit.c_emit_char_probe

import v2.test.emit.c_semantic_decl_routing { c_semantic_point_golden }
import v2.std.algebra { TailAbsent, TailFound }
import v2.std.logic { Bool }
import v2.std.text { Char, CharAbsent, CharFound, String, string_head, string_tail }

fn char_at(s: String, idx: Int) -> Char {
  if idx <= 0 {
    match string_head(s: s) {
      CharFound { value: c } => c
      CharAbsent => 0
    }
  } else {
    match string_tail(s: s) {
      TailFound { tail: tail } => char_at(s: tail, idx: idx - 1)
      TailAbsent => 0
    }
  }
}

test fn golden_char0_is_116_holds() -> Bool { char_at(s: c_semantic_point_golden, idx: 0) == 116 }
test fn golden_head_is_116_holds() -> Bool {
  match string_head(s: c_semantic_point_golden) {
    CharFound { value: c } => c == 116
    CharAbsent => false
  }
}
