module v2.test.emit.rust_loop_emit


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn rust_loop_emit_facts_miss(key: Node) -> Optional<v2.compiler.inferred_tree.InferredFacts> {
  optional_absent()
}

fn rust_loop_emit_inferred_tree_for(root: Node) -> v2.compiler.inferred_tree.InferredTree {
  v2.compiler.inferred_tree.InferredTree {
    root: root,
    facts: std.types.Map { lookup: rust_loop_emit_facts_miss }
  }
}

fn rust_loop_emit_producer_inferred_tree() -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> {
  match table_fixture_loop_arrow_with_body() {
    Accepted { value: root, diagnostics: d } =>
      v2.std.diagnostic.Accepted {
        value: rust_loop_emit_inferred_tree_for(root: root),
        diagnostics: d
      }
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn rust_loop_emit_wrong_value_producer_inferred_tree() -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> {
  match table_fixture_loop_wrong_value_arrow_with_body() {
    Accepted { value: root, diagnostics: d } =>
      v2.std.diagnostic.Accepted {
        value: rust_loop_emit_inferred_tree_for(root: root),
        diagnostics: d
      }
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn rust_loop_emit_from_tree(target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  bind_outcome(
    o: rust_loop_emit_producer_inferred_tree(),
    f: fn(tree) {
      emit(tree: tree, target: target)
    }
  )
}

fn rust_loop_emit_from_wrong_value_tree(target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  bind_outcome(
    o: rust_loop_emit_wrong_value_producer_inferred_tree(),
    f: fn(tree) {
      emit(tree: tree, target: target)
    }
  )
}

test fn rust_loop_emit_one_accepts() -> Bool {
  match rust_loop_emit_from_tree(target: rust_loop_target_model_staging()) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == rust_loop_source_text) && (d == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

test fn rust_loop_emit_wrong_value_discriminates() -> Bool {
  match rust_loop_emit_from_wrong_value_tree(target: rust_loop_target_model_staging()) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == rust_loop_wrong_value_source_text) &&
      (source.carried != rust_loop_source_text) &&
      (d == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

