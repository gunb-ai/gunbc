module v2.test.emit.rust_logic_complement_emit


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn rust_logic_complement_emit_facts_miss(key: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  optional_absent()
}

fn rust_logic_complement_emit_inferred_tree_for(root: Node) -> v2.compiler.infer.InferredTree {
  v2.compiler.infer.InferredTree {
    root: root,
    facts: std.types.Map { lookup: rust_logic_complement_emit_facts_miss }
  }
}

data rust_logic_complement_emit_inferred_tree: v2.compiler.infer.InferredTree = rust_logic_complement_emit_inferred_tree_for(root: dag_complement_arrow_with_body_fixture)

data rust_logic_complement_emit_swapped_inferred_tree: v2.compiler.infer.InferredTree = rust_logic_complement_emit_inferred_tree_for(root: dag_complement_arrow_with_body_swapped_arms_fixture)

test fn rust_logic_complement_emit_accepts() -> Bool {
  match emit(
    tree: rust_logic_complement_emit_inferred_tree,
    target: rust_logic_complement_target_model_staging()
  ) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == rust_logic_complement_source_text) && (d == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

test fn rust_logic_complement_emit_swapped_discriminates() -> Bool {
  match emit(
    tree: rust_logic_complement_emit_swapped_inferred_tree,
    target: rust_logic_complement_target_model_staging()
  ) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == rust_logic_complement_swapped_arms_source_text) &&
      (source.carried != rust_logic_complement_source_text) &&
      (d == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

