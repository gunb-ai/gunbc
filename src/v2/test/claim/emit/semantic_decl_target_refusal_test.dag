module v2.test.emit.semantic_decl_target_refusal


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data semantic_decl_target_refusal_enrollment_note: String = "Enrolled via witness_discovery_scan_dirs (src/v2/test/claim/emit/) at F7 Inc1 ready — CI-gated fail-closed refusal receipt for unwired targets."

fn sdtr_empty_conj() -> v2.std.node.Node {
  v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Conj }, children: [], occurrence_id: v2.std.node.SyntheticOccurrence }
}

fn sdtr_variant_edge(name: v2.std.node.Symbol) -> v2.std.node.Edge {
  v2.std.node.Edge { label: v2.std.node.Named { name: name }, target: sdtr_empty_conj() }
}

fn sdtr_bool_coproduct() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Disj },
    children: [ sdtr_variant_edge(name: ^True), sdtr_variant_edge(name: ^False) ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn sdtr_unwired_target_refuses() -> Bool {
  match v2.compiler.emit_semantic_decl.emit_semantic_type_decl(
    name: ^Bool,
    params: std.algebra.Empty,
    node: sdtr_bool_coproduct(),
    target: v2.extdeps.languages.cpp.cpp_target_model()
  ) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
  }
}

test fn semantic_decl_unwired_target_refuses() -> Bool {
  sdtr_unwired_target_refuses()
}
