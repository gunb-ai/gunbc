module v2.test.emit.rust_fold_call_closure_emit


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn rust_fold_call_emit_facts_miss(key: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  v2.std.optional.optional_absent()
}

fn rust_fold_call_emit_inferred_tree_for(root: v2.std.node.Node) -> v2.compiler.inferred_tree.InferredTree {
  v2.compiler.inferred_tree.InferredTree {
    root: root,
    facts: PartialFunction { lookup: rust_fold_call_emit_facts_miss }
  }
}

fn rust_fold_call_emit_from_root(root: v2.std.node.Node, target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.std.diagnostic.bind_outcome(
    o: v2.std.diagnostic.Accepted {
      value: rust_fold_call_emit_inferred_tree_for(root: root),
      diagnostics: v2.std.diagnostic.None
    },
    f: fn(tree) {
      v2.compiler.emit.emit(tree: tree, target: target)
    }
  )
}

test fn rust_fold_call_emit_canonical_accepts() -> Bool {
  match rust_fold_call_emit_from_root(
    root: v2.test.emit.fold_call_closure_fixture.fold_fixture_param_canonical_arrow,
    target: v2.extdeps.languages.rust_test.rust_fold_call_target_model_staging()
  ) {
    v2.std.diagnostic.Accepted { value: source, diagnostics: d } =>
      (source.carried == v2.extdeps.languages.rust_test.rust_fold_call_source_text) && (d == v2.std.diagnostic.None)
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn rust_fold_call_emit_swap_discriminates() -> Bool {
  match rust_fold_call_emit_from_root(
    root: v2.test.emit.fold_call_closure_fixture.fold_fixture_param_canonical_arrow,
    target: v2.extdeps.languages.rust_test.rust_fold_call_target_model_staging()
  ) {
    v2.std.diagnostic.Accepted { value: canonical, diagnostics: dc } =>
      match rust_fold_call_emit_from_root(
        root: v2.test.emit.fold_call_closure_fixture.fold_fixture_param_arrow_with_closure(
          left_operand: ^dag_binding_mvp1_fold_h,
          right_operand: ^dag_binding_mvp1_fold_acc
        ),
        target: v2.extdeps.languages.rust_test.rust_fold_call_target_model_staging()
      ) {
        v2.std.diagnostic.Accepted { value: swapped, diagnostics: ds } =>
          (swapped.carried == v2.extdeps.languages.rust_test.rust_fold_call_swapped_source_text) &&
          (swapped.carried != canonical.carried) &&
          (canonical.carried == v2.extdeps.languages.rust_test.rust_fold_call_source_text) &&
          (dc == v2.std.diagnostic.None) &&
          (ds == v2.std.diagnostic.None)
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

