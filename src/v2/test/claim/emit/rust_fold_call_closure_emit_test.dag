module v2.test.emit.rust_fold_call_closure_emit


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn rust_fold_call_emit_facts_miss(key: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  optional_absent()
}

fn rust_fold_call_emit_inferred_tree_for(root: Node) -> v2.compiler.infer.InferredTree {
  v2.compiler.infer.InferredTree {
    root: root,
    facts: std.types.Map { lookup: rust_fold_call_emit_facts_miss }
  }
}

fn rust_fold_call_emit_from_root(root: Node, target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<Medium<String>> {
  bind_outcome(
    o: v2.std.diagnostic.Accepted {
      value: rust_fold_call_emit_inferred_tree_for(root: root),
      diagnostics: v2.std.diagnostic.None
    },
    f: fn(tree) {
      emit(tree: tree, target: target)
    }
  )
}

test fn rust_fold_call_emit_canonical_accepts() -> Bool {
  match rust_fold_call_emit_from_root(
    root: fold_fixture_param_canonical_arrow,
    target: rust_fold_call_target_model_staging()
  ) {
    v2.std.diagnostic.Accepted { value: source, diagnostics: d } =>
      (source.carried == rust_fold_call_source_text) && (d == v2.std.diagnostic.None)
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn rust_fold_call_emit_swap_discriminates() -> Bool {
  match rust_fold_call_emit_from_root(
    root: fold_fixture_param_canonical_arrow,
    target: rust_fold_call_target_model_staging()
  ) {
    v2.std.diagnostic.Accepted { value: canonical, diagnostics: dc } =>
      match rust_fold_call_emit_from_root(
        root: fold_fixture_param_arrow_with_closure(
          left_operand: ^dag_binding_mvp1_fold_h,
          right_operand: ^dag_binding_mvp1_fold_acc
        ),
        target: rust_fold_call_target_model_staging()
      ) {
        v2.std.diagnostic.Accepted { value: swapped, diagnostics: ds } =>
          (swapped.carried == rust_fold_call_swapped_source_text) &&
          (swapped.carried != canonical.carried) &&
          (canonical.carried == rust_fold_call_source_text) &&
          (dc == v2.std.diagnostic.None) &&
          (ds == v2.std.diagnostic.None)
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

