module v2.test.emit.c_emit_char_oracle_test

import v2.compiler.emit_semantic_decl { emit_semantic_type_decl }
import v2.extdeps.languages.c { c_target_model }
import v2.test.emit.c_semantic_decl_routing { cdr_point_record }
import std.algebra { Empty }
import v2.std.algebra { TailAbsent, TailFound }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.text { Char, CharAbsent, CharFound, String, string_head, string_tail }

fn emit_point_text() -> String {
  match emit_semantic_type_decl(
    name: ^Point,
    params: Empty,
    node: cdr_point_record(),
    target: c_target_model()
  ) {
    Accepted { value: medium, diagnostics: _ } => medium.carried
    Rejected { diagnostics: _ } => ""
  }
}

fn char_at(s: String, idx: Int) -> Char {
  if idx <= 0 {
    match string_head(s: s) {
      CharFound { value: c } => c
      CharAbsent => 0
    }
  } else {
    match string_tail(s: s) {
      TailFound { tail: tail } => char_at(s: tail, idx: idx - 1)
      TailAbsent => 0
    }
  }
}

test fn c_emit_char14_is_brace_holds() -> Bool { char_at(s: emit_point_text(), idx: 14) == 123 }
test fn c_emit_char15_is_space_holds() -> Bool { char_at(s: emit_point_text(), idx: 15) == 32 }
test fn c_emit_char16_is_i_holds() -> Bool { char_at(s: emit_point_text(), idx: 16) == 105 }
test fn c_emit_char17_is_n_holds() -> Bool { char_at(s: emit_point_text(), idx: 17) == 110 }
test fn c_emit_char18_is_t_holds() -> Bool { char_at(s: emit_point_text(), idx: 18) == 116 }
test fn c_emit_char19_is_space_holds() -> Bool { char_at(s: emit_point_text(), idx: 19) == 32 }
test fn c_emit_char20_is_x_holds() -> Bool { char_at(s: emit_point_text(), idx: 20) == 120 }
test fn c_emit_char21_is_semi_holds() -> Bool { char_at(s: emit_point_text(), idx: 21) == 59 }
test fn c_emit_char22_is_space_holds() -> Bool { char_at(s: emit_point_text(), idx: 22) == 32 }
test fn c_emit_char23_is_i_holds() -> Bool { char_at(s: emit_point_text(), idx: 23) == 105 }
test fn c_emit_char24_is_n_holds() -> Bool { char_at(s: emit_point_text(), idx: 24) == 110 }
test fn c_emit_char25_is_t_holds() -> Bool { char_at(s: emit_point_text(), idx: 25) == 116 }
test fn c_emit_char26_is_space_holds() -> Bool { char_at(s: emit_point_text(), idx: 26) == 32 }
test fn c_emit_char27_is_y_holds() -> Bool { char_at(s: emit_point_text(), idx: 27) == 121 }
