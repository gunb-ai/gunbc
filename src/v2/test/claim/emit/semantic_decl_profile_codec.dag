module v2.test.claim.emit.semantic_decl_profile_codec

import v2.extdeps.languages.rust {
  rust_decl_derive_binding_spellings,
  rust_decl_general_lex,
  rust_semantic_decl_serialize_profile_bundle_node
}
import v2.std.compilers.semantic_decl_emission {
  TargetSemanticDeclEmitTransformRow,
  TargetSemanticDeclSerializeProfile,
  semantic_decl_serialize_profile_bundle,
  decode_semantic_decl_serialize_profile_bundle,
  semantic_decl_profile_binding_spellings,
  semantic_decl_profile_lex_rules
}
import v2.std.compilers.lexing { LexRules }
import std.types { Map }
import v2.std.diagnostic { Accepted, Outcome, Rejected }
import v2.std.compilers.target_model { EmitLineBreaks, EmitSpellingEscape, EmitSpellingIdentity, EmitSpellingQuote, bound_spelling_from_map, lex_rules_literal_for_class }
import v2.std.node { Symbol }

fn decoded_profile() -> Outcome<TargetSemanticDeclSerializeProfile> {
  decode_semantic_decl_serialize_profile_bundle(
    bundle: rust_semantic_decl_serialize_profile_bundle_node()
  )
}

fn lex_literal(rules: LexRules, token_class: Symbol) -> Outcome<String> {
  lex_rules_literal_for_class(rules: rules, token_class: token_class)
}

fn binding_spelling(
  binding_spellings: Map<Symbol, String>,
  binding: Symbol
) -> Outcome<String> {
  bound_spelling_from_map(binding_spellings: binding_spellings, binding: binding)
}

test fn decoded_lex_derive_enum_copy_matches_live() -> Bool {
  match decoded_profile() {
    Accepted { value: ser_profile, diagnostics: _ } =>
      match semantic_decl_profile_lex_rules(profile: ser_profile) {
        Accepted { value: decoded_lex, diagnostics: _ } =>
          match lex_literal(rules: decoded_lex, token_class: ^rust_token_derive_enum_copy) {
            Accepted { value: decoded, diagnostics: _ } =>
              match lex_literal(rules: rust_decl_general_lex(), token_class: ^rust_token_derive_enum_copy) {
                Accepted { value: live, diagnostics: _ } => decoded == live
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn decoded_binding_spellings_match_live() -> Bool {
  match decoded_profile() {
    Accepted { value: ser_profile, diagnostics: _ } =>
      match semantic_decl_profile_binding_spellings(profile: ser_profile) {
        Accepted { value: decoded_bindings, diagnostics: _ } =>
          match binding_spelling(
            binding_spellings: decoded_bindings,
            binding: ^rust_decl_derive_enum_copy_binding
          ) {
            Accepted { value: decoded, diagnostics: _ } =>
              match binding_spelling(
                binding_spellings: rust_decl_derive_binding_spellings(),
                binding: ^rust_decl_derive_enum_copy_binding
              ) {
                Accepted { value: live, diagnostics: _ } => decoded == live
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn line_break_row() -> TargetSemanticDeclEmitTransformRow {
  TargetSemanticDeclEmitTransformRow { token_class: ^swift_token_lbrace, transform: EmitLineBreaks { before: 0, after: 1 } }
}

test fn emit_transform_rows_round_trip_through_the_bundle() -> Bool {
  match decode_semantic_decl_serialize_profile_bundle(
    bundle: semantic_decl_serialize_profile_bundle(lex_rows: [], spelling_rows: [], emit_transform_rows: [line_break_row()])
  ) {
    Accepted { value: p, diagnostics: _ } => p.emit_transform_rows == [line_break_row()]
    Rejected { diagnostics: _ } => false
  }
}

test fn rust_profile_states_only_the_string_quote_no_line_breaks() -> Bool {
  match decoded_profile() {
    Accepted { value: p, diagnostics: _ } => p.emit_transform_rows == [quote_row()]
    Rejected { diagnostics: _ } => false
  }
}

fn quote_row() -> TargetSemanticDeclEmitTransformRow {
  TargetSemanticDeclEmitTransformRow {
    token_class: ^rust_token_str_lit,
    transform: EmitSpellingQuote {
        prefix: "",
        open: "\"",
        close: "\"",
      escapes: [EmitSpellingEscape { from: "\\", to: "\\\\" }, EmitSpellingEscape { from: "\"", to: "\\\"" }, EmitSpellingEscape { from: "\r", to: "\\r" }]
    }
  }
}

test fn string_quote_rows_round_trip_through_the_bundle() -> Bool {
  match decode_semantic_decl_serialize_profile_bundle(
    bundle: semantic_decl_serialize_profile_bundle(lex_rows: [], spelling_rows: [], emit_transform_rows: [quote_row()])
  ) {
    Accepted { value: p, diagnostics: _ } => p.emit_transform_rows == [quote_row()]
    Rejected { diagnostics: _ } => false
  }
}

// A negative line-break count has no conj encoding; the decode refuses it rather than reading zero.
test fn negative_line_break_count_is_refused_not_clamped() -> Bool {
  match decode_semantic_decl_serialize_profile_bundle(
    bundle: semantic_decl_serialize_profile_bundle(
      lex_rows: [],
      spelling_rows: [],
      emit_transform_rows: [TargetSemanticDeclEmitTransformRow { token_class: ^swift_token_lbrace, transform: EmitLineBreaks { before: -1, after: 0 } }]
    )
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

// An arm the bundle does not encode (EmitSpellingIdentity) is refused typed at decode, not dropped.
test fn unproven_transform_arm_is_refused_not_dropped() -> Bool {
  match decode_semantic_decl_serialize_profile_bundle(
    bundle: semantic_decl_serialize_profile_bundle(
      lex_rows: [],
      spelling_rows: [],
      emit_transform_rows: [TargetSemanticDeclEmitTransformRow { token_class: ^swift_token_lbrace, transform: EmitSpellingIdentity }]
    )
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}
