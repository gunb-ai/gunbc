module v2.test.emit.semantic_decl_lex_binding_parity

import v2.extdeps.languages.rust {
  rust_decl_derive_binding_spellings,
  rust_decl_general_lex,
  rust_target_model
}
import v2.std.compilers.semantic_decl_emission {
  semantic_decl_emission_from_target,
  semantic_decl_profile_binding_spellings,
  semantic_decl_profile_lex_rules
}
import v2.std.compilers.lexing { LexRules }
import v2.std.collection { Map }
import v2.std.compilers.target_model { bound_spelling_from_map, lex_rules_literal_for_class }
import v2.std.diagnostic { Accepted, Outcome, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.text { String }

fn lex_literal(rules: LexRules, token_class: Symbol) -> Outcome<String> {
  lex_rules_literal_for_class(rules: rules, token_class: token_class)
}

fn binding_spelling(m: Map<Symbol, String>, binding: Symbol) -> Outcome<String> {
  bound_spelling_from_map(binding_spellings: m, binding: binding)
}

fn lex_pair_matches(token_class: Symbol) -> Bool {
  match semantic_decl_emission_from_target(target: rust_target_model()) {
    Accepted { value: emission, diagnostics: _ } =>
      match semantic_decl_profile_lex_rules(profile: emission.enum_serialize_profile) {
        Accepted { value: decoded_lex, diagnostics: _ } =>
          match lex_literal(rules: decoded_lex, token_class: token_class) {
            Accepted { value: decoded, diagnostics: _ } =>
              match lex_literal(rules: rust_decl_general_lex(), token_class: token_class) {
                Accepted { value: live, diagnostics: _ } => decoded == live
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn binding_pair_matches(binding: Symbol) -> Bool {
  match semantic_decl_emission_from_target(target: rust_target_model()) {
    Accepted { value: emission, diagnostics: _ } =>
      match semantic_decl_profile_binding_spellings(profile: emission.enum_serialize_profile) {
        Accepted { value: decoded_bindings, diagnostics: _ } =>
          match binding_spelling(m: decoded_bindings, binding: binding) {
            Accepted { value: decoded, diagnostics: _ } =>
              match binding_spelling(m: rust_decl_derive_binding_spellings(), binding: binding) {
                Accepted { value: live, diagnostics: _ } => decoded == live
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn lex_lbrace_matches() -> Bool { lex_pair_matches(token_class: ^rust_token_lbrace) }
test fn lex_comma_matches() -> Bool { lex_pair_matches(token_class: ^rust_token_comma) }
test fn lex_rbrace_matches() -> Bool { lex_pair_matches(token_class: ^rust_token_rbrace) }
test fn lex_derive_enum_copy_matches() -> Bool { lex_pair_matches(token_class: ^rust_token_derive_enum_copy) }
test fn binding_enum_copy_matches() -> Bool { binding_pair_matches(binding: ^rust_decl_derive_enum_copy_binding) }
test fn binding_bool_ident_fallback_matches() -> Bool {
  binding_pair_matches(binding: ^Bool)
}
