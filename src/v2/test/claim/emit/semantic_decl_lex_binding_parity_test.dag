module v2.test.emit.semantic_decl_lex_binding_parity


fn lex_literal(rules: v2.std.compilers.lexing.LexRules, token_class: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<String> {
  lex_rules_literal_for_class(rules: rules, token_class: token_class)
}

fn binding_spelling(m: Map<v2.std.node.Symbol, String>, binding: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<String> {
  bound_spelling_from_map(binding_spellings: m, binding: binding)
}

fn lex_pair_matches(token_class: v2.std.node.Symbol) -> v2.std.logic.Bool {
  match semantic_decl_emission_from_target(target: rust_target_model()) {
    Accepted { value: emission, diagnostics: _ } =>
      match semantic_decl_profile_lex_rules(profile: emission.enum_serialize_profile) {
        Accepted { value: decoded_lex, diagnostics: _ } =>
          match v2.test.emit.semantic_decl_lex_binding_parity.lex_literal(rules: decoded_lex, token_class: token_class) {
            Accepted { value: decoded, diagnostics: _ } =>
              match v2.test.emit.semantic_decl_lex_binding_parity.lex_literal(rules: rust_decl_general_lex(), token_class: token_class) {
                Accepted { value: live, diagnostics: _ } => decoded == live
                v2.std.diagnostic.Rejected { diagnostics: _ } => false
              }
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn binding_pair_matches(binding: v2.std.node.Symbol) -> v2.std.logic.Bool {
  match semantic_decl_emission_from_target(target: rust_target_model()) {
    Accepted { value: emission, diagnostics: _ } =>
      match semantic_decl_profile_binding_spellings(profile: emission.enum_serialize_profile) {
        Accepted { value: decoded_bindings, diagnostics: _ } =>
          match v2.test.emit.semantic_decl_lex_binding_parity.binding_spelling(m: decoded_bindings, binding: binding) {
            Accepted { value: decoded, diagnostics: _ } =>
              match v2.test.emit.semantic_decl_lex_binding_parity.binding_spelling(m: rust_decl_derive_binding_spellings(), binding: binding) {
                Accepted { value: live, diagnostics: _ } => decoded == live
                v2.std.diagnostic.Rejected { diagnostics: _ } => false
              }
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn lex_lbrace_matches() -> v2.std.logic.Bool { v2.test.emit.semantic_decl_lex_binding_parity.lex_pair_matches(token_class: ^rust_token_lbrace) }
test fn lex_comma_matches() -> v2.std.logic.Bool { v2.test.emit.semantic_decl_lex_binding_parity.lex_pair_matches(token_class: ^rust_token_comma) }
test fn lex_rbrace_matches() -> v2.std.logic.Bool { v2.test.emit.semantic_decl_lex_binding_parity.lex_pair_matches(token_class: ^rust_token_rbrace) }
test fn lex_derive_enum_copy_matches() -> v2.std.logic.Bool { v2.test.emit.semantic_decl_lex_binding_parity.lex_pair_matches(token_class: ^rust_token_derive_enum_copy) }
test fn binding_enum_copy_matches() -> v2.std.logic.Bool { v2.test.emit.semantic_decl_lex_binding_parity.binding_pair_matches(binding: ^rust_decl_derive_enum_copy_binding) }
test fn binding_bool_ident_fallback_matches() -> v2.std.logic.Bool {
  v2.test.emit.semantic_decl_lex_binding_parity.binding_pair_matches(binding: ^v2.std.logic.Bool)
}
