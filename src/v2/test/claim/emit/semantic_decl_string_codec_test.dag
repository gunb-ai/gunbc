module v2.test.emit.semantic_decl_string_codec


fn round_trip_ok(s: String) -> Bool {
  match v2.std.compilers.semantic_decl_emission.semantic_decl_string_from_bundle_node(bundle: v2.std.compilers.semantic_decl_emission.semantic_decl_string_to_bundle_node(s: s)) {
    v2.std.diagnostic.Accepted { value: decoded, diagnostics: _ } => decoded == s
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn derive_copy_spelling_round_trips() -> Bool {
  round_trip_ok(s: v2.extdeps.languages.rust.rust_decl_derive_lex_spelling(text: extdeps.languages.rust.emit.rust_enum_derives_copy))
}
