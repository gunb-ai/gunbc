module v2.test.emit.semantic_decl_decoration_binding_test


fn bool_coproduct() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Disj },
    children: [
      v2.std.node.Edge { label: Named { name: ^True }, target: v2.std.node.Node { kind: v2.std.node.TypeNode { connective: Conj }, children: [], occurrence_id: SyntheticOccurrence } },
      v2.std.node.Edge { label: Named { name: ^False }, target: v2.std.node.Node { kind: v2.std.node.TypeNode { connective: Conj }, children: [], occurrence_id: SyntheticOccurrence } }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn lines_use_enum_copy_binding(lines: List<v2.std.compilers.semantic_decl_emission.TargetSemanticDeclDecorationLine>) -> Bool {
  fold_list(
    xs: lines,
    empty: false,
    cons: fn(acc, line) {
      if acc {
        true
      } else {
        line.surface_binding == ^rust_decl_derive_enum_copy_binding
      }
    }
  )
}

test fn nullary_bool_uses_enum_copy_derive_binding() -> Bool {
  match semantic_decl_emission_from_target(target: rust_target_model()) {
    Accepted { value: emission, diagnostics: _ } =>
      match target_semantic_decl_coproduct_decoration_lines(
        projection: emission.surface,
        coproduct: v2.test.emit.semantic_decl_decoration_binding_test.bool_coproduct()
      ) {
        Accepted { value: lines, diagnostics: _ } =>
          !is_empty(xs: lines) && lines_use_enum_copy_binding(lines: lines)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}
