  source_carrier: Node,
  primary: v2.std.compilers.target_model.TargetRepresentationChoice,
  alternatives: List<v2.std.compilers.target_model.TargetRepresentationChoice>
) -> v2.std.compilers.target_model.TargetCollectionRealization {
  v2.std.compilers.target_model.TargetCollectionRealization {
    source_carrier: source_carrier,
    primary: primary,
    alternatives: alternatives,
    fallback_diagnostic: target_collection_free_monoid_no_representation_diagnostic(),
    text_carrier: Absent
  }
}

fn sgb_nested_realization() -> v2.std.compilers.target_model.TargetCollectionRealization {
  sgb_realization(
    source_carrier: sgb_nested_source_carrier_node(),
    primary: sgb_nested_choice(),
    alternatives: std.algebra.Empty
  )
}

fn sgb_empty_realization(source_carrier: Node) -> v2.std.compilers.target_model.TargetCollectionRealization {
  sgb_realization(
    source_carrier: source_carrier,
    primary: sgb_empty_choice(),
    alternatives: std.algebra.Empty
  )
}

fn sgb_wrong_choice_realization() -> v2.std.compilers.target_model.TargetCollectionRealization {
  sgb_realization(
    source_carrier: sgb_nested_source_carrier_node(),
    primary: sgb_empty_choice(),
    alternatives: std.algebra.Cons {
      head: sgb_nested_choice(),
      tail: std.algebra.Empty
    }
  )
}

fn sgb_optional_symbol_matches(
  left: Optional<v2.std.node.Symbol>,
  right: Optional<v2.std.node.Symbol>
) -> Bool {
  match left {
    Absent =>
      match right {
        Absent => true
        Present { value: _ } => false
      }
    Present { value: left_value } =>
      match right {
        Absent => false
        Present { value: right_value } => left_value == right_value
      }
  }
}

fn sgb_representation_matches(
  left: v2.std.compilers.target_model.TargetRepresentation,
  right: v2.std.compilers.target_model.TargetRepresentation
) -> Bool {
  left.kind == right.kind
    && left.apply.surface == right.apply.surface
    && left.apply.open == right.apply.open
    && left.apply.separator == right.apply.separator
    && sgb_optional_symbol_matches(
      left: left.apply.field_label_separator,
      right: right.apply.field_label_separator
    )
    && left.apply.close == right.apply.close
}

fn sgb_choice_matches_exact(
  choice: v2.std.compilers.target_model.TargetRepresentationChoice,
  expected: v2.std.compilers.target_model.TargetRepresentationChoice
) -> Bool {
  sgb_representation_matches(left: choice.form, right: expected.form)
    && choice.representation_parameters == expected.representation_parameters
    && choice.constraints == expected.constraints
    && choice.supplemental_generic_bound_contracts == expected.supplemental_generic_bound_contracts
}

fn sgb_requirement_authority_matches(
  contract: v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContract,
  representation_parameter: v2.std.node.Symbol,
  required_trait: std.trait_derive_shape.ReprGroundingDeriveTrait,
  authority: extdeps.external_authority.ExternalAuthority
) -> Bool {
  match target_derive_supplemental_generic_bound_requirement_authority(
    contract: contract,
    representation_parameter: representation_parameter,
    required_trait: required_trait
  ) {
    Absent => false
    Present { value: actual } => actual == authority
  }
}

fn sgb_contract_has_single_requirement(
  contract: v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContract,
  representation_parameter: v2.std.node.Symbol,
  required_trait: std.trait_derive_shape.ReprGroundingDeriveTrait,
  authority: extdeps.external_authority.ExternalAuthority
) -> Bool {
  count(contract.requirements.keys()) == 1
    && match contract.requirements.lookup(representation_parameter) {
      Absent => false
      Present { value: requirements } =>
        count(requirements.keys()) == 1
          && sgb_requirement_authority_matches(
            contract: contract,
            representation_parameter: representation_parameter,
            required_trait: required_trait,
            authority: authority
          )
    }
}

fn sgb_contract_has_two_requirements(
  contract: v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContract,
  first_parameter: v2.std.node.Symbol,
  first_trait: std.trait_derive_shape.ReprGroundingDeriveTrait,
  first_authority: extdeps.external_authority.ExternalAuthority,
  second_parameter: v2.std.node.Symbol,
  second_trait: std.trait_derive_shape.ReprGroundingDeriveTrait,
  second_authority: extdeps.external_authority.ExternalAuthority
) -> Bool {
  count(contract.requirements.keys()) == 2
    && match contract.requirements.lookup(first_parameter) {
      Absent => false
      Present { value: first_requirements } =>
        count(first_requirements.keys()) == 1
          && match contract.requirements.lookup(second_parameter) {
            Absent => false
            Present { value: second_requirements } =>
              count(second_requirements.keys()) == 1
                && sgb_requirement_authority_matches(
                  contract: contract,
                  representation_parameter: first_parameter,
                  required_trait: first_trait,
                  authority: first_authority
                )
                && sgb_requirement_authority_matches(
                  contract: contract,
                  representation_parameter: second_parameter,
                  required_trait: second_trait,
                  authority: second_authority
                )
          }
    }
}

fn sgb_contract_is_explicit_empty(
  contract: v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContract,
  derive_trait: std.trait_derive_shape.ReprGroundingDeriveTrait,
  authority: extdeps.external_authority.ExternalAuthority
) -> Bool {
  contract.derive_trait == derive_trait
    && contract.authority == authority
    && count(contract.requirements.keys()) == 0
}

fn sgb_hash_set_coverage_blocker_matches(
  blocker: v2.extdeps.languages.rust.RustSupplementalGenericBoundContractCoverageBlocker,
  derive_trait: std.trait_derive_shape.ReprGroundingDeriveTrait,
  authority: extdeps.external_authority.ExternalAuthority
) -> Bool {
  blocker.derive_trait == derive_trait
    && blocker.authority == authority
    && blocker.coverage == rust_hash_set_supplemental_generic_bound_contract_coverage_disposition
    && sgb_hash_set_coverage_disposition_matches(coverage: blocker.coverage)
    && blocker.requirements.member(
      v2.std.compilers.target_model.TargetCollectionWitnessEq { type_param: ^target_collection_type_param_t }
    )
    && blocker.requirements.member(
      v2.std.compilers.target_model.TargetCollectionWitnessHash { type_param: ^target_collection_type_param_t }
    )
    && !blocker.requirements.member(
      v2.std.compilers.target_model.TargetCollectionWitnessOrd { type_param: ^target_collection_type_param_t }
    )
    && !blocker.requirements.member(
      v2.std.compilers.target_model.TargetCollectionWitnessEq { type_param: ^sgb_unrelated_slot }
    )
    && !blocker.requirements.member(
      v2.std.compilers.target_model.TargetCollectionWitnessHash { type_param: ^sgb_unrelated_slot }
    )
}

fn sgb_hash_set_coverage_disposition_matches(
  coverage: extdeps.languages.rust.derive_contracts.RustSupplementalGenericBoundContractCoverageDisposition
) -> Bool {
  let requirement_set_ref = std.decl_ref.DeclarationRef {
      module_path: "v2.std.compilers.target_model",
      decl_name: "TargetDeriveSupplementalGenericBoundRequirementSet",
      field: WholeDeclaration
    }
  let property_carrier_ref = std.decl_ref.DeclarationRef {
      module_path: "v2.std.compilers.target_model",
      decl_name: "RequiredTraitWitness",
      field: WholeDeclaration
    }
  coverage.owner == requirement_set_ref
    && coverage.lane == property_carrier_ref
    && match coverage.dissolution {
      Scaffold { dissolves_to: SingleAuthority, bind: bind } =>
        bind == property_carrier_ref
      _ => false
    }
}

fn sgb_hash_set_coverage_blockers_match_exact() -> Bool {
  match rust_hash_set_supplemental_generic_bound_contract_blockers {
    Empty => false
    Cons { head: partial_eq_blocker, tail: remaining } =>
      match remaining {
        Empty => false
        Cons { head: deserialize_blocker, tail: tail } =>
          match tail {
            Cons { head: _, tail: _ } => false
            Empty =>
              sgb_hash_set_coverage_blocker_matches(
                blocker: partial_eq_blocker,
                derive_trait: ReprDerivePartialEq,
                authority: rust_1_93_hash_set_trait_implementations_authority
              )
                && sgb_hash_set_coverage_blocker_matches(
                  blocker: deserialize_blocker,
                  derive_trait: ReprDeriveDeserialize,
                  authority: serde_1_0_228_hash_set_deserialize_authority
                )
          }
      }
  }
}

