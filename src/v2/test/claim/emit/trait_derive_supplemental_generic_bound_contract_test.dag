  representation_parameter: v2.std.node.Symbol,
  required_trait: v2.std.compilers.target_model.TargetCapabilityKey,
  authority: extdeps.external_authority.ExternalAuthority
) -> v2.std.node.Node {
  v2.std.compilers.target_model.target_derive_supplemental_generic_bound_requirement_wire_node(
    representation_parameter: representation_parameter,
    required_trait: required_trait,
    authority: authority
  )
}

fn sgb_debug_contract_wire_node() -> v2.std.node.Node {
  sgb_contract_wire_node(
    derive_trait: ^target_capability_debug,
    authority: extdeps.languages.rust.derive_contracts.im_15_1_0_vector_debug_impl_authority,
    requirement_nodes: [
      sgb_requirement_wire_node(
        representation_parameter: ^sgb_left_slot,
        required_trait: ^target_capability_clone,
        authority: extdeps.languages.rust.derive_contracts.im_15_1_0_vector_debug_impl_authority
      )
    ]
  )
}

fn sgb_choice_bundle_with_contract_nodes(
  contract_nodes: List<v2.std.node.Node>
) -> v2.std.node.Node {
  let bundle = sgb_choice_bundle_node()
  match bundle.children {
    std.algebra.Cons {
      head: form_edge,
      tail: std.algebra.Cons {
        head: params_edge,
        tail: std.algebra.Cons {
          head: constraints_edge,
          tail: std.algebra.Cons {
            head: v2.std.node.Edge { label: contracts_label, target: _ },
            tail: std.algebra.Empty
          }
        }
      }
    } =>
      v2.std.node.node_rebuild(
        n: bundle,
        children: [
          form_edge,
          params_edge,
          constraints_edge,
          v2.std.node.Edge {
            label: contracts_label,
            target: v2.std.algebra.fold_list_node(
              xs: contract_nodes,
              item_node: fn(contract_node) { contract_node }
            )
          }
        ]
      )
    _ => bundle
  }
}

fn sgb_choice_bundle_with_parameter_nodes(
  parameter_nodes: List<v2.std.node.Node>
) -> v2.std.node.Node {
  let bundle = v2.extdeps.languages.rust.rust_collection_choice_bundle_node(
    choice: sgb_choice(
      representation_parameters: sgb_nested_representation_parameters(),
      contracts: v2.std.compilers.target_model.target_derive_supplemental_generic_bound_contract_authorities_empty()
    )
  )
  match bundle.children {
    std.algebra.Cons {
      head: form_edge,
      tail: std.algebra.Cons {
        head: v2.std.node.Edge { label: params_label, target: _ },
        tail: std.algebra.Cons {
          head: constraints_edge,
          tail: std.algebra.Cons {
            head: contracts_edge,
            tail: std.algebra.Empty
          }
        }
      }
    } =>
      v2.std.node.node_rebuild(
        n: bundle,
        children: [
          form_edge,
          v2.std.node.Edge {
            label: params_label,
            target: v2.std.algebra.fold_list_node(
              xs: parameter_nodes,
              item_node: fn(parameter_node) { parameter_node }
            )
          },
          constraints_edge,
          contracts_edge
        ]
      )
    _ => bundle
  }
}

fn sgb_atom_node(identity: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: identity } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn sgb_choice_bundle_missing_contract_edge_node() -> v2.std.node.Node {
  let bundle = sgb_choice_bundle_node()
  match bundle.children {
    std.algebra.Cons {
      head: form_edge,
      tail: std.algebra.Cons {
        head: params_edge,
        tail: std.algebra.Cons {
          head: constraints_edge,
          tail: std.algebra.Cons { head: _, tail: std.algebra.Empty }
        }
      }
    } =>
      v2.std.node.node_rebuild(
        n: bundle,
        children: [form_edge, params_edge, constraints_edge]
      )
    _ => bundle
  }
}

fn sgb_choice_bundle_duplicate_contract_edge_node() -> v2.std.node.Node {
  let bundle = sgb_choice_bundle_node()
  match bundle.children {
    std.algebra.Cons {
      head: form_edge,
      tail: std.algebra.Cons {
        head: params_edge,
        tail: std.algebra.Cons {
          head: constraints_edge,
          tail: std.algebra.Cons {
            head: contracts_edge,
            tail: std.algebra.Empty
          }
        }
      }
    } =>
      v2.std.node.node_rebuild(
        n: bundle,
        children: [
          form_edge,
          params_edge,
          constraints_edge,
          contracts_edge,
          contracts_edge
        ]
      )
    _ => bundle
  }
}

fn sgb_malformed_contract_row_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: sgb_atom_node(identity: ^target_capability_debug)
      }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn sgb_contract_missing_authority_node() -> v2.std.node.Node {
  let contract = sgb_debug_contract_wire_node()
  match contract.children {
    std.algebra.Cons {
      head: derive_edge,
      tail: std.algebra.Cons {
        head: _authority_edge,
        tail: std.algebra.Cons {
          head: requirements_edge,
          tail: std.algebra.Empty
        }
      }
    } =>
      v2.std.node.node_rebuild(
        n: contract,
        children: [derive_edge, requirements_edge]
      )
    _ => contract
  }
}

