  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: identity } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn sgb_choice_bundle_missing_contract_edge_node() -> Node {
  let bundle = sgb_choice_bundle_node()
  match bundle.children {
    Cons {
      head: form_edge,
      tail: Cons {
        head: params_edge,
        tail: Cons {
          head: constraints_edge,
          tail: Cons { head: _, tail: Empty }
        }
      }
    } =>
      node_rebuild(
        n: bundle,
        children: [form_edge, params_edge, constraints_edge]
      )
    _ => bundle
  }
}

fn sgb_choice_bundle_duplicate_contract_edge_node() -> Node {
  let bundle = sgb_choice_bundle_node()
  match bundle.children {
    Cons {
