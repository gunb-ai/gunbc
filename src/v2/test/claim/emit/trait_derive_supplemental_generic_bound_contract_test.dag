fn sgb_choice_bundle_with_contract_nodes(
  contract_nodes: List<Node>
) -> Node {
  let bundle = sgb_choice_bundle_node()
  match bundle.children {
    Cons {
      head: form_edge,
      tail: Cons {
        head: params_edge,
        tail: Cons {
          head: constraints_edge,
          tail: Cons {
            head: Edge { label: contracts_label, target: _ },
            tail: Empty
          }
        }
      }
    } =>
      node_rebuild(
        n: bundle,
        children: [
          form_edge,
          params_edge,
          constraints_edge,
          v2.std.node.Edge {
            label: contracts_label,
            target: fold_list_node(
              xs: contract_nodes,
              item_node: fn(contract_node) { contract_node }
            )
          }
        ]
      )
    _ => bundle
  }
}

fn sgb_choice_bundle_with_parameter_nodes(
  parameter_nodes: List<Node>
) -> Node {
  let bundle = rust_collection_choice_bundle_node(
    choice: sgb_choice(
      representation_parameters: sgb_nested_representation_parameters(),
      contracts: target_derive_supplemental_generic_bound_contract_authorities_empty()
    )
  )
  match bundle.children {
    Cons {
      head: form_edge,
      tail: Cons {
        head: Edge { label: params_label, target: _ },
        tail: Cons {
          head: constraints_edge,
          tail: Cons {
            head: contracts_edge,
            tail: Empty
          }
        }
      }
    } =>
      node_rebuild(
        n: bundle,
        children: [
          form_edge,
          v2.std.node.Edge {
            label: params_label,
            target: fold_list_node(
              xs: parameter_nodes,
              item_node: fn(parameter_node) { parameter_node }
            )
          },
          constraints_edge,
          contracts_edge
        ]
      )
    _ => bundle
  }
}

