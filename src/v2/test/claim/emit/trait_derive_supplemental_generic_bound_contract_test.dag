module v2.test.claim.emit.trait_derive_supplemental_generic_bound_contract


data trait_derive_supplemental_generic_bound_contract_note: String = "Model-only carrier, target-bundle codec, and measured Rust collection policy. The selected representation choice owns keyed parameter slots and one keyed row per derive trait. Each derive-keyed contract value owns its upstream authority and complete slot-keyed, required-trait-keyed obligations, so contract metadata cannot drift from or silently discard its requirements. The wire decoder alone sees list-shaped malformed input and refuses duplicate or undeclared keys before constructing a choice. The production Vec surface is the emitter's im::Vector alias, so its contracts consume exact im 15.1.0 implementation authorities rather than inapplicable std::vec::Vec or serde Vec rows. Versioned Rust, serde, and im authorities flow with each contract and requirement. HashSet rows whose Hash obligation is outside ReprGroundingDeriveTrait remain absent and carry a typed, authority-backed coverage blocker instead of an incomplete contract."

data sgb_type_param: v2.std.node.Symbol = ^sgb_type_param
data sgb_left_slot: v2.std.node.Symbol = ^sgb_left_slot
data sgb_right_slot: v2.std.node.Symbol = ^sgb_right_slot
data sgb_unknown_slot: v2.std.node.Symbol = ^sgb_unknown_slot
data sgb_vec_surface: v2.std.node.Symbol = ^sgb_vec_surface
data sgb_vec_open: v2.std.node.Symbol = ^sgb_vec_open
data sgb_vec_separator: v2.std.node.Symbol = ^sgb_vec_separator
data sgb_vec_close: v2.std.node.Symbol = ^sgb_vec_close
data sgb_unrelated_source: v2.std.node.Symbol = ^sgb_unrelated_source
data sgb_phantom_source: v2.std.node.Symbol = ^sgb_phantom_source

fn sgb_left_param_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^sgb_type_param } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn sgb_right_param_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^sgb_type_param } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn sgb_nested_source_carrier_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Instantiation },
    children: [
      v2.std.node.Edge { label: Positional, target: target_carrier_free_monoid_node() },
      v2.std.node.Edge { label: Positional, target: sgb_left_param_node() },
      v2.std.node.Edge { label: Positional, target: sgb_right_param_node() }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn sgb_concrete_source_carrier_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Instantiation },
    children: [
      v2.std.node.Edge { label: Positional, target: target_carrier_free_monoid_node() },
      v2.std.node.Edge { label: Positional, target: char_kernel_type_node() }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn sgb_collection_eligible_elem_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode {
      connective: v2.std.node.Atom { identity: ^target_collection_kernel_string }
    },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn sgb_atom_source_carrier_node(identity: v2.std.node.Symbol) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: identity } },
    children: [],
