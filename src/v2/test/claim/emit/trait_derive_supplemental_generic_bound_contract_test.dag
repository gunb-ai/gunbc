}

fn sgb_malformed_contract_row_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      v2.std.node.Edge {
        label: Positional,
        target: sgb_atom_node(identity: discriminant(v: ReprDeriveDebug))
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn sgb_contract_missing_authority_node() -> Node {
  let contract = sgb_debug_contract_wire_node()
  match contract.children {
    Cons {
      head: derive_edge,
      tail: Cons {
        head: _authority_edge,
        tail: Cons {
          head: requirements_edge,
          tail: Empty
        }
      }
    } =>
      node_rebuild(
        n: contract,
        children: [derive_edge, requirements_edge]
      )
    _ => contract
  }
