fn sgb_vec_representation() -> v2.std.compilers.target_model.TargetRepresentation {
  v2.std.compilers.target_model.TargetRepresentation {
    kind: TargetCollectionReprVec,
    apply: v2.std.compilers.target_model.TargetGenericApply {
      surface: ^sgb_vec_surface,
      open: ^sgb_vec_open,
      separator: ^sgb_vec_separator,
      field_label_separator: Absent,
      close: ^sgb_vec_close
    }
  }
}

fn sgb_requirement_set(
  required_trait: std.trait_derive_shape.ReprGroundingDeriveTrait,
  authority: extdeps.external_authority.ExternalAuthority
) -> v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementSet {
  map_insert(
    m: target_derive_supplemental_generic_bound_requirement_set_empty(),
    key: target_grounding_derive_trait_key(derive_trait: required_trait),
    value: v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementAuthority {
      authority: authority
    }
  )
}

fn sgb_single_parameter_requirements(
  representation_parameter: v2.std.node.Symbol,
  required_trait: std.trait_derive_shape.ReprGroundingDeriveTrait,
  authority: extdeps.external_authority.ExternalAuthority
) -> Map<v2.std.node.Symbol, v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementSet> {
  map_insert(
    m: target_derive_supplemental_generic_bound_contract_requirements_empty(),
    key: representation_parameter,
    value: sgb_requirement_set(
      required_trait: required_trait,
      authority: authority
    )
  )
}

fn sgb_single_clone_requirement(
  authority: extdeps.external_authority.ExternalAuthority
) -> Map<v2.std.node.Symbol, v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementSet> {
  sgb_single_parameter_requirements(
    representation_parameter: ^sgb_left_slot,
    required_trait: ReprDeriveClone,
    authority: authority
  )
}

fn sgb_deserialize_requirements(
  clone_authority: extdeps.external_authority.ExternalAuthority
) -> Map<v2.std.node.Symbol, v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementSet> {
  map_insert(
    m: sgb_single_clone_requirement(authority: clone_authority),
    key: ^sgb_right_slot,
    value: sgb_requirement_set(
      required_trait: ReprDeriveOrd,
      authority: serde_1_0_228_btree_set_deserialize_authority
    )
  )
}

fn sgb_contract(
  authority: extdeps.external_authority.ExternalAuthority,
  requirements: Map<v2.std.node.Symbol, v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementSet>
) -> v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContractAuthority {
  v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContractAuthority {
    authority: authority,
    requirements: requirements
  }
}

fn sgb_nested_contracts() -> Map<v2.std.compilers.target_model.TargetDeriveTraitKey, v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContractAuthority> {
  let debug_contracts = map_insert(
    m: target_derive_supplemental_generic_bound_contract_authorities_empty(),
    key: target_grounding_derive_trait_key(derive_trait: ReprDeriveDebug),
    value: sgb_contract(
      authority: im_15_1_0_vector_debug_impl_authority,
      requirements: sgb_single_clone_requirement(
        authority: im_15_1_0_vector_debug_impl_authority
      )
    )
  )
  let partial_eq_contracts = map_insert(
    m: debug_contracts,
    key: target_grounding_derive_trait_key(derive_trait: ReprDerivePartialEq),
    value: sgb_contract(
      authority: im_15_1_0_vector_partial_eq_impl_authority,
      requirements: sgb_single_clone_requirement(
        authority: im_15_1_0_vector_partial_eq_impl_authority
      )
    )
  )
  let serialize_contracts = map_insert(
    m: partial_eq_contracts,
    key: target_grounding_derive_trait_key(derive_trait: ReprDeriveSerialize),
    value: sgb_contract(
      authority: im_15_1_0_vector_serialize_impl_authority,
      requirements: sgb_single_clone_requirement(
        authority: im_15_1_0_vector_serialize_impl_authority
      )
    )
  )
  let deserialize_contracts = map_insert(
    m: serialize_contracts,
    key: target_grounding_derive_trait_key(derive_trait: ReprDeriveDeserialize),
    value: sgb_contract(
      authority: im_15_1_0_vector_deserialize_impl_authority,
      requirements: sgb_deserialize_requirements(
        clone_authority: im_15_1_0_vector_deserialize_impl_authority
      )
    )
  )
  map_insert(
    m: deserialize_contracts,
    key: target_grounding_derive_trait_key(derive_trait: ReprDeriveClone),
    value: sgb_contract(
      authority: im_15_1_0_vector_clone_impl_authority,
      requirements: target_derive_supplemental_generic_bound_contract_requirements_empty()
    )
  )
}

fn sgb_nested_representation_parameters() -> Map<v2.std.node.Symbol, v2.std.compilers.target_model.TargetRepresentationParameterSlot> {
  map_insert(
    m: map_insert(
      m: target_representation_parameter_slots_empty(),
      key: ^sgb_left_slot,
      value: target_representation_parameter_slot_empty()
    ),
    key: ^sgb_right_slot,
    value: target_representation_parameter_slot_empty()
  )
}

fn sgb_choice(
  representation_parameters: Map<v2.std.node.Symbol, v2.std.compilers.target_model.TargetRepresentationParameterSlot>,
  contracts: Map<v2.std.compilers.target_model.TargetDeriveTraitKey, v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContractAuthority>
) -> v2.std.compilers.target_model.TargetRepresentationChoice {
  v2.std.compilers.target_model.TargetRepresentationChoice {
    form: sgb_vec_representation(),
    representation_parameters: representation_parameters,
    constraints: std.algebra.Empty,
    supplemental_generic_bound_contracts: contracts
  }
}

fn sgb_empty_choice() -> v2.std.compilers.target_model.TargetRepresentationChoice {
  sgb_choice(
    representation_parameters: target_representation_parameter_slots_empty(),
    contracts: target_derive_supplemental_generic_bound_contract_authorities_empty()
  )
}

fn sgb_nested_choice() -> v2.std.compilers.target_model.TargetRepresentationChoice {
  sgb_choice(
    representation_parameters: sgb_nested_representation_parameters(),
    contracts: sgb_nested_contracts()
  )
}

