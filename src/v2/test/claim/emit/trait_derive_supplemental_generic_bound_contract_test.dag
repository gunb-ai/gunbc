module v2.test.claim.emit.trait_derive_supplemental_generic_bound_contract



data trait_derive_supplemental_generic_bound_contract_note: String = "Model-only carrier, target-bundle codec, and measured Rust collection policy. The selected representation choice owns keyed parameter slots and one keyed row per derive trait. Each derive-keyed contract value owns its upstream authority and complete slot-keyed, required-trait-keyed obligations, so contract metadata cannot drift from or silently discard its requirements. The wire decoder alone sees list-shaped malformed input and refuses duplicate or undeclared keys before constructing a choice. The production Vec surface is the emitter's im::Vector alias, so its contracts consume exact im 15.1.0 implementation authorities rather than inapplicable std::vec::Vec or serde Vec rows. Versioned Rust, serde, and im authorities flow with each contract and requirement. HashSet rows whose Hash obligation is outside TargetCapabilityKey remain absent and carry a typed, authority-backed coverage blocker instead of an incomplete contract."

data sgb_type_param: v2.std.node.Symbol = ^sgb_type_param
data sgb_left_slot: v2.std.node.Symbol = ^sgb_left_slot
data sgb_right_slot: v2.std.node.Symbol = ^sgb_right_slot
data sgb_unknown_slot: v2.std.node.Symbol = ^sgb_unknown_slot
data sgb_vec_surface: v2.std.node.Symbol = ^sgb_vec_surface
data sgb_vec_open: v2.std.node.Symbol = ^sgb_vec_open
data sgb_vec_separator: v2.std.node.Symbol = ^sgb_vec_separator
data sgb_vec_close: v2.std.node.Symbol = ^sgb_vec_close
data sgb_unrelated_source: v2.std.node.Symbol = ^sgb_unrelated_source
data sgb_phantom_source: v2.std.node.Symbol = ^sgb_phantom_source

fn sgb_left_param_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^sgb_type_param } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn sgb_right_param_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^sgb_type_param } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn sgb_nested_source_carrier_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Instantiation },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: v2.std.compilers.target_model.target_carrier_free_monoid_node() },
      v2.std.node.Edge { label: v2.std.node.Positional, target: sgb_left_param_node() },
      v2.std.node.Edge { label: v2.std.node.Positional, target: sgb_right_param_node() }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn sgb_concrete_source_carrier_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Instantiation },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: v2.std.compilers.target_model.target_carrier_free_monoid_node() },
      v2.std.node.Edge { label: v2.std.node.Positional, target: v2.std.compilers.target_model.char_kernel_type_node() }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn sgb_collection_eligible_elem_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode {
      connective: v2.std.node.Atom { identity: ^target_collection_kernel_string }
    },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn sgb_atom_source_carrier_node(identity: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: identity } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn sgb_vec_representation() -> v2.std.compilers.target_model.TargetRepresentation {
  v2.std.compilers.target_model.TargetRepresentation {
    kind: v2.std.compilers.target_model.TargetCollectionReprVec,
    apply: v2.std.compilers.target_model.TargetGenericApply {
      surface: ^sgb_vec_surface,
      open: ^sgb_vec_open,
      separator: ^sgb_vec_separator,
      field_label_separator: v2.std.optional.Absent,
      close: ^sgb_vec_close
    }
  }
}

fn sgb_requirement_set(
  required_trait: v2.std.compilers.target_model.TargetCapabilityKey,
  authority: extdeps.external_authority.ExternalAuthority
) -> v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementSet {
  v2.std.collection.map_insert(
    m: v2.std.compilers.target_model.target_derive_supplemental_generic_bound_requirement_set_empty(),
    key: required_trait,
    value: v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementAuthority {
      authority: authority
    }
  )
}

fn sgb_single_parameter_requirements(
  representation_parameter: v2.std.node.Symbol,
  required_trait: v2.std.compilers.target_model.TargetCapabilityKey,
  authority: extdeps.external_authority.ExternalAuthority
) -> Map<v2.std.node.Symbol, v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementSet> {
  v2.std.collection.map_insert(
    m: v2.std.compilers.target_model.target_derive_supplemental_generic_bound_contract_requirements_empty(),
    key: representation_parameter,
    value: sgb_requirement_set(
      required_trait: required_trait,
      authority: authority
    )
  )
}

fn sgb_single_clone_requirement(
  authority: extdeps.external_authority.ExternalAuthority
) -> Map<v2.std.node.Symbol, v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementSet> {
  sgb_single_parameter_requirements(
    representation_parameter: ^sgb_left_slot,
    required_trait: ^target_capability_clone,
    authority: authority
  )
}

fn sgb_deserialize_requirements(
  clone_authority: extdeps.external_authority.ExternalAuthority
) -> Map<v2.std.node.Symbol, v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementSet> {
  v2.std.collection.map_insert(
    m: sgb_single_clone_requirement(authority: clone_authority),
    key: ^sgb_right_slot,
    value: sgb_requirement_set(
      required_trait: ^target_capability_ord,
      authority: extdeps.languages.rust.derive_contracts.im_15_1_0_ord_set_deserialize_impl_authority
    )
  )
}

fn sgb_contract(
  authority: extdeps.external_authority.ExternalAuthority,
  requirements: Map<v2.std.node.Symbol, v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundRequirementSet>
) -> v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContractAuthority {
  v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContractAuthority {
    authority: authority,
    requirements: requirements
  }
}

fn sgb_nested_contracts() -> Map<v2.std.compilers.target_model.TargetCapabilityKey, v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContractAuthority> {
  let debug_contracts = v2.std.collection.map_insert(
    m: v2.std.compilers.target_model.target_derive_supplemental_generic_bound_contract_authorities_empty(),
    key: ^target_capability_debug,
    value: sgb_contract(
      authority: extdeps.languages.rust.derive_contracts.im_15_1_0_vector_debug_impl_authority,
      requirements: sgb_single_clone_requirement(
        authority: extdeps.languages.rust.derive_contracts.im_15_1_0_vector_debug_impl_authority
      )
    )
  )
  let partial_eq_contracts = v2.std.collection.map_insert(
    m: debug_contracts,
    key: ^target_capability_partialeq,
    value: sgb_contract(
      authority: extdeps.languages.rust.derive_contracts.im_15_1_0_vector_partial_eq_impl_authority,
      requirements: sgb_single_clone_requirement(
        authority: extdeps.languages.rust.derive_contracts.im_15_1_0_vector_partial_eq_impl_authority
      )
    )
  )
  let serialize_contracts = v2.std.collection.map_insert(
    m: partial_eq_contracts,
    key: ^target_capability_serialize,
    value: sgb_contract(
      authority: extdeps.languages.rust.derive_contracts.im_15_1_0_vector_serialize_impl_authority,
      requirements: sgb_single_clone_requirement(
        authority: extdeps.languages.rust.derive_contracts.im_15_1_0_vector_serialize_impl_authority
      )
    )
  )
  let deserialize_contracts = v2.std.collection.map_insert(
    m: serialize_contracts,
    key: ^target_capability_deserialize,
    value: sgb_contract(
      authority: extdeps.languages.rust.derive_contracts.im_15_1_0_vector_deserialize_impl_authority,
      requirements: sgb_deserialize_requirements(
        clone_authority: extdeps.languages.rust.derive_contracts.im_15_1_0_vector_deserialize_impl_authority
      )
    )
  )
  v2.std.collection.map_insert(
    m: deserialize_contracts,
    key: ^target_capability_clone,
    value: sgb_contract(
      authority: extdeps.languages.rust.derive_contracts.im_15_1_0_vector_clone_impl_authority,
      requirements: v2.std.compilers.target_model.target_derive_supplemental_generic_bound_contract_requirements_empty()
    )
  )
}

fn sgb_nested_representation_parameters() -> Map<v2.std.node.Symbol, v2.std.compilers.target_model.TargetRepresentationParameterSlot> {
  v2.std.collection.map_insert(
    m: v2.std.collection.map_insert(
      m: v2.std.compilers.target_model.target_representation_parameter_slots_empty(),
      key: ^sgb_left_slot,
      value: v2.std.compilers.target_model.target_representation_parameter_slot_empty()
    ),
    key: ^sgb_right_slot,
    value: v2.std.compilers.target_model.target_representation_parameter_slot_empty()
  )
}

fn sgb_choice(
  representation_parameters: Map<v2.std.node.Symbol, v2.std.compilers.target_model.TargetRepresentationParameterSlot>,
  contracts: Map<v2.std.compilers.target_model.TargetCapabilityKey, v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContractAuthority>
) -> v2.std.compilers.target_model.TargetRepresentationChoice {
  v2.std.compilers.target_model.TargetRepresentationChoice {
    form: sgb_vec_representation(),
    representation_parameters: representation_parameters,
    constraints: std.algebra.Empty,
    supplemental_generic_bound_contracts: contracts
  }
}

fn sgb_empty_choice() -> v2.std.compilers.target_model.TargetRepresentationChoice {
  sgb_choice(
    representation_parameters: v2.std.compilers.target_model.target_representation_parameter_slots_empty(),
    contracts: v2.std.compilers.target_model.target_derive_supplemental_generic_bound_contract_authorities_empty()
  )
}

fn sgb_nested_choice() -> v2.std.compilers.target_model.TargetRepresentationChoice {
  sgb_choice(
    representation_parameters: sgb_nested_representation_parameters(),
    contracts: sgb_nested_contracts()
  )
}

fn sgb_capability_eligibility() -> List<v2.std.compilers.target_model.TargetCapabilityEligibilityRow> {
  [
    v2.std.compilers.target_model.TargetCapabilityEligibilityRow {
      capability_key: ^target_collection_trait_ord,
      eligibility: v2.std.compilers.target_model.TargetCapabilityElementEligibility { kernel_atoms: sgb_capability_kernel_atoms }
    },
    v2.std.compilers.target_model.TargetCapabilityEligibilityRow {
      capability_key: ^target_collection_trait_hash,
      eligibility: v2.std.compilers.target_model.TargetCapabilityElementEligibility { kernel_atoms: sgb_capability_kernel_atoms }
    },
    v2.std.compilers.target_model.TargetCapabilityEligibilityRow {
      capability_key: ^target_collection_trait_eq,
      eligibility: v2.std.compilers.target_model.TargetCapabilityElementEligibility { kernel_atoms: sgb_capability_kernel_atoms }
    }
  ]
}

data sgb_capability_kernel_atoms: List<v2.std.node.Symbol> = [
  ^target_collection_kernel_string,
  ^target_collection_kernel_int,
  ^target_collection_kernel_bool,
  ^target_collection_kernel_unit
]

fn sgb_realization(
  source_carrier: v2.std.node.Node,
  primary: v2.std.compilers.target_model.TargetRepresentationChoice,
  alternatives: List<v2.std.compilers.target_model.TargetRepresentationChoice>
) -> v2.std.compilers.target_model.TargetCollectionRealization {
  v2.std.compilers.target_model.TargetCollectionRealization {
    source_carrier: source_carrier,
    primary: primary,
    alternatives: alternatives,
    fallback_diagnostic: v2.std.compilers.target_model.target_collection_free_monoid_no_representation_diagnostic(),
    text_carrier: v2.std.optional.Absent,
    capability_eligibility: sgb_capability_eligibility()
  }
}

fn sgb_nested_realization() -> v2.std.compilers.target_model.TargetCollectionRealization {
  sgb_realization(
    source_carrier: sgb_nested_source_carrier_node(),
    primary: sgb_nested_choice(),
    alternatives: std.algebra.Empty
  )
}

fn sgb_empty_realization(source_carrier: v2.std.node.Node) -> v2.std.compilers.target_model.TargetCollectionRealization {
  sgb_realization(
    source_carrier: source_carrier,
    primary: sgb_empty_choice(),
    alternatives: std.algebra.Empty
  )
}

fn sgb_wrong_choice_realization() -> v2.std.compilers.target_model.TargetCollectionRealization {
  sgb_realization(
    source_carrier: sgb_nested_source_carrier_node(),
    primary: sgb_empty_choice(),
    alternatives: std.algebra.Cons {
      head: sgb_nested_choice(),
      tail: std.algebra.Empty
    }
  )
}

fn sgb_optional_symbol_matches(
  left: v2.std.optional.Optional<v2.std.node.Symbol>,
  right: v2.std.optional.Optional<v2.std.node.Symbol>
) -> Bool {
  match left {
    v2.std.optional.Absent =>
      match right {
        v2.std.optional.Absent => true
        v2.std.optional.Present { value: _ } => false
      }
    v2.std.optional.Present { value: left_value } =>
      match right {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: right_value } => left_value == right_value
      }
  }
}

fn sgb_representation_matches(
  left: v2.std.compilers.target_model.TargetRepresentation,
  right: v2.std.compilers.target_model.TargetRepresentation
) -> Bool {
  left.kind == right.kind
    && left.apply.surface == right.apply.surface
    && left.apply.open == right.apply.open
    && left.apply.separator == right.apply.separator
    && sgb_optional_symbol_matches(
      left: left.apply.field_label_separator,
      right: right.apply.field_label_separator
    )
    && left.apply.close == right.apply.close
}

fn sgb_choice_matches_exact(
  choice: v2.std.compilers.target_model.TargetRepresentationChoice,
  expected: v2.std.compilers.target_model.TargetRepresentationChoice
) -> Bool {
  sgb_representation_matches(left: choice.form, right: expected.form)
    && choice.representation_parameters == expected.representation_parameters
    && choice.constraints == expected.constraints
    && choice.supplemental_generic_bound_contracts == expected.supplemental_generic_bound_contracts
}

fn sgb_requirement_authority_matches(
  contract: v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContract,
  representation_parameter: v2.std.node.Symbol,
  required_trait: v2.std.compilers.target_model.TargetCapabilityKey,
  authority: extdeps.external_authority.ExternalAuthority
) -> Bool {
  match v2.std.compilers.target_model.target_derive_supplemental_generic_bound_requirement_authority(
    contract: contract,
    representation_parameter: representation_parameter,
    required_trait: required_trait
  ) {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: actual } => actual == authority
  }
}

fn sgb_contract_has_single_requirement(
  contract: v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContract,
  representation_parameter: v2.std.node.Symbol,
  required_trait: v2.std.compilers.target_model.TargetCapabilityKey,
  authority: extdeps.external_authority.ExternalAuthority
) -> Bool {
  count(map_keys(contract.requirements)) == 1
    && match contract.requirements.lookup(representation_parameter) {
      v2.std.optional.Absent => false
      v2.std.optional.Present { value: requirements } =>
        count(map_keys(requirements)) == 1
          && sgb_requirement_authority_matches(
            contract: contract,
            representation_parameter: representation_parameter,
            required_trait: required_trait,
            authority: authority
          )
    }
}

fn sgb_contract_has_two_requirements(
  contract: v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContract,
  first_parameter: v2.std.node.Symbol,
  first_trait: v2.std.compilers.target_model.TargetCapabilityKey,
  first_authority: extdeps.external_authority.ExternalAuthority,
  second_parameter: v2.std.node.Symbol,
  second_trait: v2.std.compilers.target_model.TargetCapabilityKey,
  second_authority: extdeps.external_authority.ExternalAuthority
) -> Bool {
  count(map_keys(contract.requirements)) == 2
    && match contract.requirements.lookup(first_parameter) {
      v2.std.optional.Absent => false
      v2.std.optional.Present { value: first_requirements } =>
        count(map_keys(first_requirements)) == 1
          && match contract.requirements.lookup(second_parameter) {
            v2.std.optional.Absent => false
            v2.std.optional.Present { value: second_requirements } =>
              count(map_keys(second_requirements)) == 1
                && sgb_requirement_authority_matches(
                  contract: contract,
                  representation_parameter: first_parameter,
                  required_trait: first_trait,
                  authority: first_authority
                )
                && sgb_requirement_authority_matches(
                  contract: contract,
                  representation_parameter: second_parameter,
                  required_trait: second_trait,
                  authority: second_authority
                )
          }
    }
}

fn sgb_contract_has_single_parameter_two_requirements(
  contract: v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContract,
  representation_parameter: v2.std.node.Symbol,
  first_trait: v2.std.compilers.target_model.TargetCapabilityKey,
  first_authority: extdeps.external_authority.ExternalAuthority,
  second_trait: v2.std.compilers.target_model.TargetCapabilityKey,
  second_authority: extdeps.external_authority.ExternalAuthority
) -> Bool {
  count(map_keys(contract.requirements)) == 1
    && match contract.requirements.lookup(representation_parameter) {
      v2.std.optional.Absent => false
      v2.std.optional.Present { value: requirements } =>
        count(map_keys(requirements)) == 2
          && sgb_requirement_authority_matches(
            contract: contract,
            representation_parameter: representation_parameter,
            required_trait: first_trait,
            authority: first_authority
          )
          && sgb_requirement_authority_matches(
            contract: contract,
            representation_parameter: representation_parameter,
            required_trait: second_trait,
            authority: second_authority
          )
    }
}

fn sgb_contract_is_explicit_empty(
  contract: v2.std.compilers.target_model.TargetDeriveSupplementalGenericBoundContract,
  derive_trait: v2.std.compilers.target_model.TargetCapabilityKey,
  authority: extdeps.external_authority.ExternalAuthority
) -> Bool {
  contract.derive_trait == derive_trait
    && contract.authority == authority
    && count(map_keys(contract.requirements)) == 0
}

fn sgb_hash_set_coverage_blocker_matches(
  blocker: v2.extdeps.languages.rust.RustSupplementalGenericBoundContractCoverageBlocker,
  derive_trait: v2.std.compilers.target_model.TargetCapabilityKey,
  authority: extdeps.external_authority.ExternalAuthority
) -> Bool {
  blocker.derive_trait == derive_trait
    && blocker.authority == authority
    && blocker.coverage == extdeps.languages.rust.derive_contracts.rust_hash_set_supplemental_generic_bound_contract_coverage_disposition
    && sgb_hash_set_coverage_disposition_matches(coverage: blocker.coverage)
    && blocker.requirements.member(
      v2.std.compilers.target_model.TargetCapabilityRequirement { representation_parameter: ^target_collection_type_param_t, capability_key: ^target_collection_trait_eq }
    )
    && blocker.requirements.member(
      v2.std.compilers.target_model.TargetCapabilityRequirement { representation_parameter: ^target_collection_type_param_t, capability_key: ^target_collection_trait_hash }
    )
    && !blocker.requirements.member(
      v2.std.compilers.target_model.TargetCapabilityRequirement { representation_parameter: ^target_collection_type_param_t, capability_key: ^target_collection_trait_ord }
    )
    && !blocker.requirements.member(
      v2.std.compilers.target_model.TargetCapabilityRequirement { representation_parameter: ^sgb_unrelated_slot, capability_key: ^target_collection_trait_eq }
    )
    && !blocker.requirements.member(
      v2.std.compilers.target_model.TargetCapabilityRequirement { representation_parameter: ^sgb_unrelated_slot, capability_key: ^target_collection_trait_hash }
    )
}

fn sgb_hash_set_coverage_disposition_matches(
  coverage: extdeps.languages.rust.derive_contracts.RustSupplementalGenericBoundContractCoverageDisposition
) -> Bool {
  let requirement_set_ref = std.decl_ref.DeclarationRef {
      module_path: "v2.std.compilers.target_model",
      decl_name: "TargetDeriveSupplementalGenericBoundRequirementSet",
      field: std.decl_ref.WholeDeclaration
    }
  let property_carrier_ref = std.decl_ref.DeclarationRef {
      module_path: "v2.std.compilers.target_model",
      decl_name: "TargetCapabilityRequirement",
      field: std.decl_ref.WholeDeclaration
    }
  coverage.owner == requirement_set_ref
    && coverage.lane == property_carrier_ref
    && match coverage.dissolution {
      std.disposition.Scaffold { dissolves_to: std.disposition.SingleAuthority, bind: bind } =>
        bind == property_carrier_ref
      _ => false
    }
}

fn sgb_hash_set_coverage_blockers_match_exact() -> Bool {
  match v2.extdeps.languages.rust.rust_hash_set_supplemental_generic_bound_contract_blockers {
    std.algebra.Empty => false
    std.algebra.Cons { head: partial_eq_blocker, tail: remaining } =>
      match remaining {
        std.algebra.Empty => false
        std.algebra.Cons { head: deserialize_blocker, tail: tail } =>
          match tail {
            std.algebra.Cons { head: _, tail: _ } => false
            std.algebra.Empty =>
              sgb_hash_set_coverage_blocker_matches(
                blocker: partial_eq_blocker,
                derive_trait: ^target_capability_partialeq,
                authority: extdeps.languages.rust.derive_contracts.rust_1_93_hash_set_trait_implementations_authority
              )
                && sgb_hash_set_coverage_blocker_matches(
                  blocker: deserialize_blocker,
                  derive_trait: ^target_capability_deserialize,
                  authority: extdeps.languages.rust.derive_contracts.serde_1_0_228_hash_set_deserialize_authority
                )
          }
      }
  }
}

fn sgb_choice_bundle_node() -> v2.std.node.Node {
  v2.extdeps.languages.rust.rust_collection_choice_bundle_node(choice: sgb_nested_choice())
}

