  match target_derive_supplemental_generic_bound_contract_lookup_in_catalog(
    catalog: sgb_nested_contract_catalog(),
    source_carrier: sgb_nested_source_carrier_node(),
    emitted_representation: sgb_vec_representation(),
    derive_trait: ReprDeriveDeserialize
  ) {
    Accepted { value: row, diagnostics: _ } =>
      row.derive_trait == ReprDeriveDeserialize && sgb_requirements_are_clone(
        reqs: row.requirements,
        type_param: ^sgb_type_param_t
      )
    Rejected { diagnostics: _ } => false
  }
}

test fn nested_generic_clone_requires_nothing() -> Bool {
  match target_derive_supplemental_generic_bound_contract_lookup_in_catalog(
    catalog: sgb_nested_contract_catalog(),
    source_carrier: sgb_nested_source_carrier_node(),
    emitted_representation: sgb_vec_representation(),
    derive_trait: ReprDeriveClone
  ) {
    Accepted { value: row, diagnostics: _ } =>
      row.derive_trait == ReprDeriveClone && sgb_requirements_are_empty(reqs: row.requirements)
    Rejected { diagnostics: _ } => false
  }
}

test fn concrete_carrier_requires_nothing() -> Bool {
  match target_derive_supplemental_generic_bound_contract_lookup_in_catalog(
    catalog: sgb_concrete_contract_catalog(),
    source_carrier: sgb_concrete_source_carrier_node(),
    emitted_representation: sgb_vec_representation(),
    derive_trait: ReprDeriveDebug
  ) {
    Accepted { value: row, diagnostics: _ } =>
      row.derive_trait == ReprDeriveDebug && sgb_requirements_are_empty(reqs: row.requirements)
    Rejected { diagnostics: _ } => false
  }
}

test fn unrelated_carrier_requires_nothing() -> Bool {
  match target_derive_supplemental_generic_bound_contract_lookup_in_catalog(
    catalog: sgb_unrelated_contract_catalog(),
    source_carrier: sgb_unrelated_source_carrier_node(),
    emitted_representation: sgb_vec_representation(),
    derive_trait: ReprDeriveDebug
  ) {
    Accepted { value: row, diagnostics: _ } =>
      row.derive_trait == ReprDeriveDebug && sgb_requirements_are_empty(reqs: row.requirements)
    Rejected { diagnostics: _ } => false
  }
}

test fn missing_row_refuses_without_binding() -> Bool {
  match target_derive_supplemental_generic_bound_contract_lookup_in_catalog(
    catalog: sgb_empty_contract_catalog(),
    source_carrier: sgb_nested_source_carrier_node(),
    emitted_representation: sgb_vec_representation(),
    derive_trait: ReprDeriveDebug
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

test fn duplicate_matching_rows_refuse() -> Bool {
  match target_derive_supplemental_generic_bound_contract_lookup_in_catalog(
    catalog: sgb_duplicate_debug_catalog(),
    source_carrier: sgb_nested_source_carrier_node(),
    emitted_representation: sgb_vec_representation(),
    derive_trait: ReprDeriveDebug
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}
