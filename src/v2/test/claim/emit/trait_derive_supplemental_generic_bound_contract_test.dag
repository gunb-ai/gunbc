module v2.test.claim.emit.trait_derive_supplemental_generic_bound_contract

import std.algebra { Cons, Empty }
import std.trait_derive_shape {
  ReprDeriveClone,
  ReprDeriveDebug,
  ReprDeriveDeserialize,
  ReprDerivePartialEq,
  ReprDeriveSerialize,
  ReprGroundingDeriveTrait
}
import v2.std.compilers.target_model {
  TargetCollectionReprVec,
  TargetDeriveSupplementalGenericBoundContract,
  TargetDeriveSupplementalGenericBoundRequirement,
  TargetGenericApply,
  TargetRepresentationChoice,
  TargetRepresentation,
  char_kernel_type_node,
  target_carrier_free_monoid_node,
  target_derive_supplemental_generic_bound_contract_lookup_in_catalog
}
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  Edge,
  Instantiation,
  Node,
  Positional,
  SyntheticOccurrence,
  TypeNode,
  node_occurrence_minted,
  node_with_occurrence_id
}
import v2.std.collection { List, Symbol }
import v2.std.optional { Absent }
import v2.std.occurrence_id { alloc_occurrence_id, occurrence_id_allocator_initial, occurrence_id_eq }

data trait_derive_supplemental_generic_bound_contract_note: String = "Model-only contract for per-derive supplemental generic bounds: rows keyed by source carrier, selected choice relation, and derive trait. Nested generic carrier rows prove the exact extra bound set per derive; Clone itself never gets a fabricated supplemental Clone. Missing and duplicate rows refuse, never fall back to the first row."

data sgb_type_param: Symbol = ^sgb_type_param
data sgb_vec_surface: Symbol = ^sgb_vec_surface
data sgb_vec_open: Symbol = ^sgb_vec_open
data sgb_vec_separator: Symbol = ^sgb_vec_separator
data sgb_vec_close: Symbol = ^sgb_vec_close
data sgb_unrelated_source: Symbol = ^sgb_unrelated_source

fn sgb_left_param_node() -> Node {
  let minted = alloc_occurrence_id(alloc: occurrence_id_allocator_initial())
  node_with_occurrence_id(
    kind: TypeNode { connective: Atom { identity: ^sgb_type_param } },
    children: [],
    occurrence_id: node_occurrence_minted(id: minted.id)
  )
}

fn sgb_right_param_node() -> Node {
  let minted0 = alloc_occurrence_id(alloc: occurrence_id_allocator_initial())
  let minted1 = alloc_occurrence_id(alloc: minted0.alloc)
  node_with_occurrence_id(
    kind: TypeNode { connective: Atom { identity: ^sgb_type_param } },
    children: [],
    occurrence_id: node_occurrence_minted(id: minted1.id)
  )
}

fn sgb_nested_source_carrier_node() -> Node {
  Node {
    kind: TypeNode { connective: Instantiation },
    children: [
      Edge { label: Positional, target: target_carrier_free_monoid_node() },
      Edge { label: Positional, target: sgb_left_param_node() },
      Edge { label: Positional, target: sgb_right_param_node() }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn sgb_concrete_source_carrier_node() -> Node {
  Node {
    kind: TypeNode { connective: Instantiation },
    children: [
      Edge { label: Positional, target: target_carrier_free_monoid_node() },
      Edge { label: Positional, target: char_kernel_type_node() }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn sgb_unrelated_source_carrier_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^sgb_unrelated_source } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn sgb_vec_representation() -> TargetRepresentation {
  TargetRepresentation {
    kind: TargetCollectionReprVec,
    apply: TargetGenericApply {
      surface: ^sgb_vec_surface,
      open: ^sgb_vec_open,
      separator: ^sgb_vec_separator,
      field_label_separator: Absent,
      close: ^sgb_vec_close
    }
  }
}

fn sgb_vec_choice() -> TargetRepresentationChoice {
  TargetRepresentationChoice {
    form: sgb_vec_representation(),
    constraints: Empty
  }
}

fn sgb_requirement(
  generic_parameter: Node,
  derive_trait: ReprGroundingDeriveTrait
) -> TargetDeriveSupplementalGenericBoundRequirement {
  TargetDeriveSupplementalGenericBoundRequirement {
    generic_parameter: generic_parameter,
    derive_trait: derive_trait
  }
}

fn sgb_requirements_for(
  derive_trait: ReprGroundingDeriveTrait
) -> List<TargetDeriveSupplementalGenericBoundRequirement> {
  match derive_trait {
    ReprDeriveDebug => Cons {
      head: sgb_requirement(generic_parameter: sgb_left_param_node(), derive_trait: ReprDeriveClone),
      tail: Cons {
        head: sgb_requirement(generic_parameter: sgb_right_param_node(), derive_trait: ReprDeriveSerialize),
        tail: Empty
      }
    }
    ReprDerivePartialEq => Empty
    ReprDeriveSerialize => Cons {
      head: sgb_requirement(generic_parameter: sgb_right_param_node(), derive_trait: ReprDeriveClone),
      tail: Cons {
        head: sgb_requirement(generic_parameter: sgb_left_param_node(), derive_trait: ReprDeriveDeserialize),
        tail: Empty
      }
    }
    ReprDeriveDeserialize => Cons {
      head: sgb_requirement(generic_parameter: sgb_left_param_node(), derive_trait: ReprDeriveSerialize),
      tail: Cons {
        head: sgb_requirement(generic_parameter: sgb_right_param_node(), derive_trait: ReprDeriveDebug),
        tail: Empty
      }
    }
    ReprDeriveClone => Empty
    _ => Empty
  }
}

fn sgb_requirement_matches(
  req: TargetDeriveSupplementalGenericBoundRequirement,
  generic_parameter: Node,
  derive_trait: ReprGroundingDeriveTrait
) -> Bool {
  occurrence_id_eq(left: req.generic_parameter.occurrence_id, right: generic_parameter.occurrence_id)
    && req.derive_trait == derive_trait
}

fn sgb_requirements_match_exact_order(
  reqs: List<TargetDeriveSupplementalGenericBoundRequirement>,
  first_parameter: Node,
  first_trait: ReprGroundingDeriveTrait,
  second_parameter: Node,
  second_trait: ReprGroundingDeriveTrait
) -> Bool {
  match reqs {
    Cons {
      head: first_req,
      tail: Cons {
        head: second_req,
        tail: Empty
      }
    } => sgb_requirement_matches(
      req: first_req,
      generic_parameter: first_parameter,
      derive_trait: first_trait
    ) && sgb_requirement_matches(
      req: second_req,
      generic_parameter: second_parameter,
      derive_trait: second_trait
    )
    _ => false
  }
}

fn sgb_requirements_are_empty(
  reqs: List<TargetDeriveSupplementalGenericBoundRequirement>
) -> Bool {
  match reqs {
    Empty => true
    _ => false
  }
}

fn sgb_nested_contract_source_carrier() -> Node {
  sgb_nested_source_carrier_node()
}

fn sgb_contract_row(derive_trait: ReprGroundingDeriveTrait) -> TargetDeriveSupplementalGenericBoundContract {
  TargetDeriveSupplementalGenericBoundContract {
    source_carrier: sgb_nested_contract_source_carrier(),
    selected_choice: sgb_vec_choice(),
    derive_trait: derive_trait,
    requirements: sgb_requirements_for(derive_trait: derive_trait)
  }
}

fn sgb_empty_contract_catalog() -> List<TargetDeriveSupplementalGenericBoundContract> {
  Empty
}

fn sgb_nested_contract_catalog() -> List<TargetDeriveSupplementalGenericBoundContract> {
  Cons {
    head: sgb_contract_row(derive_trait: ReprDeriveDebug),
    tail: Cons {
      head: sgb_contract_row(derive_trait: ReprDerivePartialEq),
      tail: Cons {
        head: sgb_contract_row(derive_trait: ReprDeriveSerialize),
        tail: Cons {
          head: sgb_contract_row(derive_trait: ReprDeriveDeserialize),
          tail: Cons { head: sgb_contract_row(derive_trait: ReprDeriveClone), tail: Empty }
        }
      }
    }
  }
}

fn sgb_duplicate_debug_catalog() -> List<TargetDeriveSupplementalGenericBoundContract> {
  Cons {
    head: sgb_contract_row(derive_trait: ReprDeriveDebug),
    tail: Cons { head: sgb_contract_row(derive_trait: ReprDeriveDebug), tail: Empty }
  }
}

fn sgb_concrete_contract_row(derive_trait: ReprGroundingDeriveTrait) -> TargetDeriveSupplementalGenericBoundContract {
  TargetDeriveSupplementalGenericBoundContract {
    source_carrier: sgb_concrete_source_carrier_node(),
    selected_choice: sgb_vec_choice(),
    derive_trait: derive_trait,
    requirements: Empty
  }
}

fn sgb_unrelated_contract_row(derive_trait: ReprGroundingDeriveTrait) -> TargetDeriveSupplementalGenericBoundContract {
  TargetDeriveSupplementalGenericBoundContract {
    source_carrier: sgb_unrelated_source_carrier_node(),
    selected_choice: sgb_vec_choice(),
    derive_trait: derive_trait,
    requirements: Empty
  }
}

fn sgb_concrete_contract_catalog() -> List<TargetDeriveSupplementalGenericBoundContract> {
  Cons {
    head: sgb_concrete_contract_row(derive_trait: ReprDeriveDebug),
    tail: Cons { head: sgb_concrete_contract_row(derive_trait: ReprDeriveClone), tail: Empty }
  }
}

fn sgb_unrelated_contract_catalog() -> List<TargetDeriveSupplementalGenericBoundContract> {
  Cons {
    head: sgb_unrelated_contract_row(derive_trait: ReprDeriveDebug),
    tail: Cons { head: sgb_unrelated_contract_row(derive_trait: ReprDeriveClone), tail: Empty }
  }
}

test fn nested_generic_debug_requires_exact_declaration_nodes() -> Bool {
  let left_param = sgb_left_param_node()
  let right_param = sgb_right_param_node()
  match target_derive_supplemental_generic_bound_contract_lookup_in_catalog(
    catalog: sgb_nested_contract_catalog(),
    source_carrier: sgb_nested_source_carrier_node(),
    derive_trait: ReprDeriveDebug
  ) {
    Accepted { value: row, diagnostics: _ } =>
      row.derive_trait == ReprDeriveDebug
        && sgb_requirements_match_exact_order(
          reqs: row.requirements,
          first_parameter: left_param,
          first_trait: ReprDeriveClone,
          second_parameter: right_param,
          second_trait: ReprDeriveSerialize
        )
    Rejected { diagnostics: _ } => false
  }
}

test fn nested_generic_partial_eq_requires_nothing() -> Bool {
  match target_derive_supplemental_generic_bound_contract_lookup_in_catalog(
    catalog: sgb_nested_contract_catalog(),
    source_carrier: sgb_nested_source_carrier_node(),
    derive_trait: ReprDerivePartialEq
  ) {
    Accepted { value: row, diagnostics: _ } =>
      row.derive_trait == ReprDerivePartialEq && sgb_requirements_are_empty(reqs: row.requirements)
    Rejected { diagnostics: _ } => false
  }
}

test fn nested_generic_serialize_requires_exact_declaration_nodes() -> Bool {
  let left_param = sgb_left_param_node()
  let right_param = sgb_right_param_node()
  match target_derive_supplemental_generic_bound_contract_lookup_in_catalog(
    catalog: sgb_nested_contract_catalog(),
    source_carrier: sgb_nested_source_carrier_node(),
    derive_trait: ReprDeriveSerialize
  ) {
    Accepted { value: row, diagnostics: _ } =>
      row.derive_trait == ReprDeriveSerialize
        && sgb_requirements_match_exact_order(
          reqs: row.requirements,
          first_parameter: right_param,
          first_trait: ReprDeriveClone,
          second_parameter: left_param,
          second_trait: ReprDeriveDeserialize
        )
    Rejected { diagnostics: _ } => false
  }
}

test fn nested_generic_deserialize_requires_exact_declaration_nodes() -> Bool {
  let left_param = sgb_left_param_node()
  let right_param = sgb_right_param_node()
  match target_derive_supplemental_generic_bound_contract_lookup_in_catalog(
    catalog: sgb_nested_contract_catalog(),
    source_carrier: sgb_nested_source_carrier_node(),
    derive_trait: ReprDeriveDeserialize
  ) {
    Accepted { value: row, diagnostics: _ } =>
      row.derive_trait == ReprDeriveDeserialize
        && sgb_requirements_match_exact_order(
          reqs: row.requirements,
          first_parameter: left_param,
          first_trait: ReprDeriveSerialize,
          second_parameter: right_param,
          second_trait: ReprDeriveDebug
        )
    Rejected { diagnostics: _ } => false
  }
}

test fn nested_generic_swap_red_requires_exact_declaration_nodes() -> Bool {
  let left_param = sgb_left_param_node()
  let right_param = sgb_right_param_node()
  match target_derive_supplemental_generic_bound_contract_lookup_in_catalog(
    catalog: sgb_nested_contract_catalog(),
    source_carrier: sgb_nested_source_carrier_node(),
    derive_trait: ReprDeriveSerialize
  ) {
    Accepted { value: row, diagnostics: _ } =>
      !occurrence_id_eq(left: left_param.occurrence_id, right: right_param.occurrence_id)
        && row.derive_trait == ReprDeriveSerialize
        && sgb_requirements_match_exact_order(
          reqs: row.requirements,
          first_parameter: right_param,
          first_trait: ReprDeriveClone,
          second_parameter: left_param,
          second_trait: ReprDeriveDeserialize
        )
    Rejected { diagnostics: _ } => false
  }
}

test fn nested_generic_clone_requires_nothing() -> Bool {
  match target_derive_supplemental_generic_bound_contract_lookup_in_catalog(
    catalog: sgb_nested_contract_catalog(),
    source_carrier: sgb_nested_source_carrier_node(),
    derive_trait: ReprDeriveClone
  ) {
    Accepted { value: row, diagnostics: _ } =>
      row.derive_trait == ReprDeriveClone && sgb_requirements_are_empty(reqs: row.requirements)
    Rejected { diagnostics: _ } => false
  }
}

test fn concrete_carrier_requires_nothing() -> Bool {
  match target_derive_supplemental_generic_bound_contract_lookup_in_catalog(
    catalog: sgb_concrete_contract_catalog(),
    source_carrier: sgb_concrete_source_carrier_node(),
    derive_trait: ReprDeriveDebug
  ) {
    Accepted { value: row, diagnostics: _ } =>
      row.derive_trait == ReprDeriveDebug && sgb_requirements_are_empty(reqs: row.requirements)
    Rejected { diagnostics: _ } => false
  }
}

test fn unrelated_carrier_requires_nothing() -> Bool {
  match target_derive_supplemental_generic_bound_contract_lookup_in_catalog(
    catalog: sgb_unrelated_contract_catalog(),
    source_carrier: sgb_unrelated_source_carrier_node(),
    derive_trait: ReprDeriveDebug
  ) {
    Accepted { value: row, diagnostics: _ } =>
      row.derive_trait == ReprDeriveDebug && sgb_requirements_are_empty(reqs: row.requirements)
    Rejected { diagnostics: _ } => false
  }
}

test fn missing_row_refuses_without_binding() -> Bool {
  match target_derive_supplemental_generic_bound_contract_lookup_in_catalog(
    catalog: sgb_empty_contract_catalog(),
    source_carrier: sgb_nested_source_carrier_node(),
    derive_trait: ReprDeriveDebug
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

test fn duplicate_matching_rows_refuse() -> Bool {
  match target_derive_supplemental_generic_bound_contract_lookup_in_catalog(
    catalog: sgb_duplicate_debug_catalog(),
    source_carrier: sgb_nested_source_carrier_node(),
    derive_trait: ReprDeriveDebug
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}
