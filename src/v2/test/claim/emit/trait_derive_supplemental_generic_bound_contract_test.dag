test fn nested_generic_outer_inner_trait_axes_are_distinct() -> Bool {
  match target_derive_supplemental_generic_bound_contract_lookup_in_realization(
    row: sgb_nested_realization(),
    elem: char_kernel_type_node(),
    derive_trait: ReprDeriveDebug
  ) {
    Accepted { value: debug_row, diagnostics: _ } =>
      match target_derive_supplemental_generic_bound_contract_lookup_in_realization(
        row: sgb_nested_realization(),
        elem: char_kernel_type_node(),
        derive_trait: ReprDeriveClone
      ) {
        Accepted { value: clone_row, diagnostics: _ } =>
          debug_row.derive_trait == ReprDeriveDebug
            && sgb_requirements_match_single(
              reqs: debug_row.requirements,
              representation_parameter: ^sgb_left_slot,
              required_trait: ReprDeriveClone
            )
            && sgb_contract_matches_empty(
              row: clone_row,
              derive_trait: ReprDeriveClone
            )
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

