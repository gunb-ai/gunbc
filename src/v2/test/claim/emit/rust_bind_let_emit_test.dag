module v2.test.emit.rust_bind_let_emit


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data rust_bind_let_expected_source_text: String = "fn add(x: i32, y: i32) -> i32 { let x = 1; x }"

data rust_bind_let_wrong_value_source_text: String = "fn add(x: i32, y: i32) -> i32 { let x = 2; x }"

fn rust_bind_let_lex_rules() -> v2.std.compilers.lexing.LexRuleSet {
  let base = v2.extdeps.languages.rust.rust_fn_add_lex_rules()
  v2.std.compilers.lexing.LexRuleSet {
    rules: v2.std.algebra.list_append(
      left: base.rules,
      right: [
        v2.extdeps.languages.rust.rust_lex_rule(token_class: ^rust_token_kw_let, text: "let "),
        v2.extdeps.languages.rust.rust_lex_rule(token_class: ^rust_token_equal, text: " = "),
        v2.extdeps.languages.rust.rust_lex_rule(token_class: ^rust_token_semicolon, text: "; ")
      ]
    )
  }
}

fn rust_bind_let_lex() -> v2.std.compilers.lexing.LexRules {
  v2.std.compilers.lexing.ModeledLexRules { root: rust_bind_let_lex_rules() }
}

fn rust_bind_let_binding_spellings() -> Map<v2.std.node.Symbol, String> {
  let m0 = v2.std.collection.map_insert(v2.std.collection.empty_map(), ^rust_binding_fn_add, "add")
  let m1 = v2.std.collection.map_insert(m0, ^rust_binding_param_x, "x")
  let m2 = v2.std.collection.map_insert(m1, ^rust_binding_param_y, "y")
  let m3 = v2.std.collection.map_insert(m2, ^dag_binding_bind_x, "x")
  let m4 = v2.std.collection.map_insert(m3, ^dag_pick_lit_one, "1")
  let m5 = v2.std.collection.map_insert(m4, ^dag_pick_lit_two, "2")
  let m6 = v2.std.collection.map_insert(m5, ^dag_binding_pick_lit_one, "1")
  v2.std.collection.map_insert(m6, ^dag_binding_pick_lit_two, "2")
}

fn rust_bind_let_target_model() -> v2.std.compilers.target_model.TargetModel {
  v2.std.compilers.target_model.TargetModel {
    produced_decl_support: v2.std.compilers.target_model.ProducedDeclUnwired,
    bundle: v2.extdeps.languages.rust.rust_target_model_bundle_core(),
    lex: rust_bind_let_lex(),
    binding_spellings: rust_bind_let_binding_spellings(),
    token_class_emit_transforms: v2.std.compilers.target_model.target_model_emit_transforms_empty,
    authority_source_text: rust_bind_let_expected_source_text,
    runtime_row: v2.std.host_transport.target_emit_host_runtime_row_unconfigured
  }
}

fn rust_bind_let_facts_miss(key: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  v2.std.optional.optional_absent()
}

fn rust_bind_let_inferred_tree_for(root: v2.std.node.Node) -> v2.compiler.inferred_tree.InferredTree {
  v2.compiler.inferred_tree.InferredTree {
    root: root,
    facts: PartialFunction { lookup: rust_bind_let_facts_miss }
  }
}

fn rust_bind_let_producer_tree() -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> {
  match v2.test.complexity_gate.table_fixture_bind_subject_producer.table_fixture_bind_arrow_with_body() {
    v2.std.diagnostic.Accepted { value: root, diagnostics: d } =>
      v2.std.diagnostic.Accepted {
        value: rust_bind_let_inferred_tree_for(root: root),
        diagnostics: d
      }
    v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn rust_bind_let_wrong_value_producer_tree() -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> {
  match v2.test.complexity_gate.table_fixture_bind_subject_producer.table_fixture_bind_wrong_value_arrow_with_body() {
    v2.std.diagnostic.Accepted { value: root, diagnostics: d } =>
      v2.std.diagnostic.Accepted {
        value: rust_bind_let_inferred_tree_for(root: root),
        diagnostics: d
      }
    v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn rust_bind_let_emit_from_producer(target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.std.diagnostic.bind_outcome(
    o: rust_bind_let_producer_tree(),
    f: fn(tree) {
      v2.compiler.emit.emit(tree: tree, target: target)
    }
  )
}

fn rust_bind_let_emit_wrong_value_from_producer(target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.std.diagnostic.bind_outcome(
    o: rust_bind_let_wrong_value_producer_tree(),
    f: fn(tree) {
      v2.compiler.emit.emit(tree: tree, target: target)
    }
  )
}

test fn rust_bind_let_emit_holds() -> Bool {
  match rust_bind_let_emit_from_producer(target: rust_bind_let_target_model()) {
    v2.std.diagnostic.Accepted { value: source, diagnostics: d } =>
      (source.carried == rust_bind_let_expected_source_text) && (d == v2.std.diagnostic.None)
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn rust_bind_let_emit_wrong_value_discriminates() -> Bool {
  match rust_bind_let_emit_from_producer(target: rust_bind_let_target_model()) {
    v2.std.diagnostic.Accepted { value: canonical, diagnostics: dc } =>
      match rust_bind_let_emit_wrong_value_from_producer(target: rust_bind_let_target_model()) {
        v2.std.diagnostic.Accepted { value: wrong, diagnostics: dw } =>
          (wrong.carried == rust_bind_let_wrong_value_source_text) &&
          (wrong.carried != canonical.carried) &&
          (dc == v2.std.diagnostic.None) && (dw == v2.std.diagnostic.None)
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

