module v2.test.emit.rust_bind_let_emit

import v2.extdeps.languages.dag {
  dag_arrow_with_body_node,
  dag_bind_let_resolved_body_from_value_and_tail,
  dag_bind_resolved_arrow_with_body_fixture,
  dag_bind_resolved_arrow_with_body_wrong_value_fixture,
  dag_int_literal_fixture_one,
  dag_pick_arrow_domain_conj_node,
  dag_type_atom_node
}
import v2.std.qualified_name { binder_reference_node }
import std.occurrence_identity { OccurrenceSynthetic }
import v2.compiler.emit { emit }
import v2.compiler.infer { InferredFacts, InferredTree }
import v2.extdeps.languages.rust {
  rust_lex_rule,
  rust_fn_add_lex_rules
}
import v2.extdeps.languages.rust_test { rust_bind_let_target_model_bundle_core }
import std.algebra { list_append }
import v2.std.collection {
  Map,
  empty_map,
  map_insert
}
import v2.std.optional {
  Optional,
  Present,
  Absent,
  optional_present,
  optional_absent
}
import v2.std.compilers.lexing { LexRuleSet, LexRules, ModeledLexRules }
import v2.std.compilers.target_model {
  ProducedDeclUnwired, TargetModel, target_model_emit_transforms_empty }
import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import extdeps.communication.medium { Medium }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  bind_outcome,
  node_locus
}
import v2.std.logic { Bool }
import v2.std.node { Bind, ComputationNode, Edge, Node, Positional, Symbol }
import v2.std.witness { Violates, Witness }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data rust_bind_let_expected_source_text: String = "fn add(x: i32, y: i32) -> i32 { let x = 1; x }"

data rust_bind_let_wrong_value_source_text: String = "fn add(x: i32, y: i32) -> i32 { let x = 2; x }"

fn rust_bind_let_lex_rules() -> LexRuleSet {
  let base = rust_fn_add_lex_rules()
  LexRuleSet {
    rules: list_append(
      left: base.rules,
      right: [
        rust_lex_rule(token_class: ^rust_token_kw_let, text: "let "),
        rust_lex_rule(token_class: ^rust_token_equal, text: " = "),
        rust_lex_rule(token_class: ^rust_token_semicolon, text: "; ")
      ]
    )
  }
}

fn rust_bind_let_lex() -> LexRules {
  ModeledLexRules { root: rust_bind_let_lex_rules() }
}

fn rust_bind_let_binding_spellings() -> Map<Symbol, String> {
  let m0 = map_insert(empty_map(), ^rust_binding_fn_add, "add")
  let m1 = map_insert(m0, ^rust_binding_param_x, "x")
  let m2 = map_insert(m1, ^rust_binding_param_y, "y")
  let m3 = map_insert(m2, ^dag_binding_bind_x, "x")
  let m4 = map_insert(m3, ^dag_pick_lit_one, "1")
  let m5 = map_insert(m4, ^dag_pick_lit_two, "2")
  let m6 = map_insert(m5, ^dag_binding_pick_lit_one, "1")
  map_insert(m6, ^dag_binding_pick_lit_two, "2")
}

fn rust_bind_let_target_model() -> TargetModel {
  TargetModel {
    produced_decl_support: ProducedDeclUnwired,
    bundle: rust_bind_let_target_model_bundle_core(),
    lex: rust_bind_let_lex(),
    binding_spellings: rust_bind_let_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: rust_bind_let_expected_source_text,
    runtime_row: target_emit_host_runtime_row_unconfigured
  }
}

fn rust_bind_let_facts_miss(key: Node) -> Optional<InferredFacts> {
  optional_absent()
}

fn rust_bind_let_inferred_tree_for(root: Node) -> InferredTree {
  InferredTree {
    root: root,
    facts: PartialFunction { lookup: rust_bind_let_facts_miss }
  }
}

fn rust_bind_let_producer_tree() -> Outcome<InferredTree> {
  Accepted { value: rust_bind_let_inferred_tree_for(root: dag_bind_resolved_arrow_with_body_fixture), diagnostics: None }
}

fn rust_bind_let_wrong_value_producer_tree() -> Outcome<InferredTree> {
  Accepted { value: rust_bind_let_inferred_tree_for(root: dag_bind_resolved_arrow_with_body_wrong_value_fixture), diagnostics: None }
}

fn rust_bind_let_emit_from_producer(target: TargetModel) -> Outcome<Medium<String>> {
  bind_outcome(
    o: rust_bind_let_producer_tree(),
    f: fn(tree) {
      emit(tree: tree, target: target)
    }
  )
}

fn rust_bind_let_emit_wrong_value_from_producer(target: TargetModel) -> Outcome<Medium<String>> {
  bind_outcome(
    o: rust_bind_let_wrong_value_producer_tree(),
    f: fn(tree) {
      emit(tree: tree, target: target)
    }
  )
}

test fn rust_bind_let_emit_holds() -> Bool {
  match rust_bind_let_emit_from_producer(target: rust_bind_let_target_model()) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == rust_bind_let_expected_source_text) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn rust_bind_let_emit_wrong_value_discriminates() -> Bool {
  match rust_bind_let_emit_from_producer(target: rust_bind_let_target_model()) {
    Accepted { value: canonical, diagnostics: dc } =>
      match rust_bind_let_emit_wrong_value_from_producer(target: rust_bind_let_target_model()) {
        Accepted { value: wrong, diagnostics: dw } =>
          (wrong.carried == rust_bind_let_wrong_value_source_text) &&
          (wrong.carried != canonical.carried) &&
          (dc == None) && (dw == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}


// A LET-BOUND NAME IN A VALUE POSITION EMITS. The inner let's value is the outer let's binder, as
// v2.compiler.resolve hands it over (a binder reference). Before the binder carrier it was a bare atom
// the emitter checked against `add`'s parameters alone, so it refused body_scope_binding_invalid;
// the tail-only let above never reached that check because the tail had its own unchecked mint, now
// deleted.
fn rust_bind_let_nested_tree() -> InferredTree {
  let x_ref = binder_reference_node(binder: ^dag_binding_bind_x, occurrence_id: OccurrenceSynthetic)
  let inner = Node {
    kind: ComputationNode { behavior: Bind },
    children: [
      Edge { label: Positional, target: dag_type_atom_node(identity: ^dag_binding_bind_x) },
      Edge { label: Positional, target: x_ref },
      Edge { label: Positional, target: x_ref }
    ],
    occurrence_id: OccurrenceSynthetic
  }
  rust_bind_let_inferred_tree_for(root: dag_arrow_with_body_node(
    domain: dag_pick_arrow_domain_conj_node(),
    return_type_binding: ^dag_binding_type_int,
    body: dag_bind_let_resolved_body_from_value_and_tail(value: dag_int_literal_fixture_one(), tail: inner)
  ))
}

test fn a_let_bound_name_in_a_value_position_emits_holds() -> Bool {
  match emit(tree: rust_bind_let_nested_tree(), target: rust_bind_let_target_model()) {
    Accepted { value: source, diagnostics: _ } => string_contains(s: source.carried, pattern: "let x = 1;") && string_contains(s: source.carried, pattern: "let x = x;")
    Rejected { diagnostics: _ } => false
  }
}
