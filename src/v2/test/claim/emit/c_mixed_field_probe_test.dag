module v2.test.emit.c_mixed_field_probe_test

import v2.compiler.emit_semantic_decl { emit_semantic_type_decl }
import v2.extdeps.languages.c { c_target_model }
import std.algebra { Empty }
import v2.std.algebra { fold_list }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Atom, Conj, Edge, Named, Node, SyntheticOccurrence, TypeNode }
import v2.std.text { String }

fn mixed_record() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^x },
        target: Node {
          kind: TypeNode { connective: Atom { identity: ^Int } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      },
      Edge {
        label: Named { name: ^flag },
        target: Node {
          kind: TypeNode { connective: Atom { identity: ^Bool } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn emit_mixed() -> String {
  match emit_semantic_type_decl(
    name: ^Mixed,
    params: Empty,
    node: mixed_record(),
    target: c_target_model()
  ) {
    Accepted { value: medium, diagnostics: _ } => medium.carried
    Rejected { diagnostics: _ } => ""
  }
}

fn str_len(s: String) -> Int {
  fold_list(xs: s, empty: 0, cons: fn(acc, _) { acc + 1 })
}

test fn c_mixed_contains_int_x_holds() -> Bool {
  string_contains(s: emit_mixed(), pattern: "int x")
}

test fn c_mixed_contains_flag_holds() -> Bool {
  string_contains(s: emit_mixed(), pattern: "flag")
}

test fn c_mixed_len_36_holds() -> Bool { str_len(s: emit_mixed()) == 36 }
test fn c_mixed_len_37_holds() -> Bool { str_len(s: emit_mixed()) == 37 }
test fn c_mixed_len_38_holds() -> Bool { str_len(s: emit_mixed()) == 38 }
test fn c_mixed_len_39_holds() -> Bool { str_len(s: emit_mixed()) == 39 }
test fn c_mixed_len_40_holds() -> Bool { str_len(s: emit_mixed()) == 40 }
