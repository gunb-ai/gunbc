module v2.test.emit.c_semantic_decl_len_probe

import v2.compiler.emit_semantic_decl { emit_semantic_type_decl }
import v2.extdeps.languages.c { c_target_model }
import std.algebra { Empty }
import v2.std.algebra { fold_list }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Conj, Edge, Named, Node, SyntheticOccurrence, TypeNode, Atom }

data golden: String = concat("typedef struct ", "{ int x; int y; } Point;")

fn point() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^x },
        target: Node {
          kind: TypeNode { connective: Atom { identity: ^Int } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      },
      Edge {
        label: Named { name: ^y },
        target: Node {
          kind: TypeNode { connective: Atom { identity: ^Int } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn str_len(s: String) -> Int {
  fold_list(xs: s, empty: 0, cons: fn(acc, _) { acc + 1 })
}

test fn c_semantic_decl_golden_len_holds() -> Bool {
  str_len(s: golden) == 39
}

test fn c_semantic_decl_len_bracket_probe_holds() -> Bool {
  match emit_semantic_type_decl(name: ^Point, params: Empty, node: point(), target: c_target_model()) {
    Accepted { value: medium, diagnostics: _ } =>
      str_len(s: medium.carried) == 30
        || str_len(s: medium.carried) == 31
        || str_len(s: medium.carried) == 32
        || str_len(s: medium.carried) == 33
        || str_len(s: medium.carried) == 34
        || str_len(s: medium.carried) == 35
        || str_len(s: medium.carried) == 36
        || str_len(s: medium.carried) == 37
        || str_len(s: medium.carried) == 38
        || str_len(s: medium.carried) == 39
        || str_len(s: medium.carried) == 40
        || str_len(s: medium.carried) == 41
        || str_len(s: medium.carried) == 42
        || str_len(s: medium.carried) == 43
        || str_len(s: medium.carried) == 44
        || str_len(s: medium.carried) == 45
        || str_len(s: medium.carried) == 46
        || str_len(s: medium.carried) == 47
        || str_len(s: medium.carried) == 48
        || str_len(s: medium.carried) == 49
        || str_len(s: medium.carried) == 50
        || str_len(s: medium.carried) == 55
        || str_len(s: medium.carried) == 60
    Rejected { diagnostics: _ } => false
  }
}

test fn c_semantic_decl_len_probe_holds() -> Bool {
  match emit_semantic_type_decl(name: ^Point, params: Empty, node: point(), target: c_target_model()) {
    Accepted { value: medium, diagnostics: _ } =>
      str_len(s: medium.carried) == str_len(s: golden)
    Rejected { diagnostics: _ } => false
  }
}

test fn c_semantic_decl_eq_probe_holds() -> Bool {
  match emit_semantic_type_decl(name: ^Point, params: Empty, node: point(), target: c_target_model()) {
    Accepted { value: medium, diagnostics: _ } => medium.carried == golden
    Rejected { diagnostics: _ } => false
  }
}
