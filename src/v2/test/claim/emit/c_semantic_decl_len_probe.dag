module v2.test.emit.c_semantic_decl_len_probe

import v2.compiler.emit_semantic_decl { emit_semantic_type_decl }
import v2.extdeps.languages.c { c_target_model }
import std.algebra { Empty }
import v2.std.algebra { fold_list }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Conj, Edge, Named, Node, SyntheticOccurrence, TypeNode, Atom }
import v2.std.text { CharAbsent, CharFound, String, TailAbsent, TailFound, string_head, string_tail }

data actual_golden: String = concat("typedef struct ", "{ int x; int y; ", "} ; ")
data alt_golden: String = concat("typedef struct ", "{ int x; int y; y; }")

fn point() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: ^x }, target: Node { kind: TypeNode { connective: Atom { identity: ^Int } }, children: [], occurrence_id: SyntheticOccurrence } },
      Edge { label: Named { name: ^y }, target: Node { kind: TypeNode { connective: Atom { identity: ^Int } }, children: [], occurrence_id: SyntheticOccurrence } }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn str_len(s: String) -> Int {
  fold_list(xs: s, empty: 0, cons: fn(acc, _) { acc + 1 })
}

fn skip_chars(s: String, n: Int) -> String {
  if n == 0 {
    s
  } else {
    match string_tail(s: s) {
      TailFound { tail: tail } => skip_chars(s: tail, n: n - 1)
      TailAbsent => Empty
    }
  }
}

fn char_at(s: String, n: Int) -> Int {
  match string_head(s: skip_chars(s: s, n: n)) {
    CharFound { value: c } => c
    CharAbsent => 0
  }
}

fn emit_carried() -> String {
  match emit_semantic_type_decl(name: ^Point, params: Empty, node: point(), target: c_target_model()) {
    Accepted { value: medium, diagnostics: _ } => medium.carried
    Rejected { diagnostics: _ } => Empty
  }
}

test fn c_semantic_decl_len_is_35_holds() -> Bool {
  str_len(s: emit_carried()) == 35
}

test fn c_semantic_decl_eq_alt_golden_holds() -> Bool {
  emit_carried() == alt_golden
}

test fn c_semantic_decl_eq_actual_golden_holds() -> Bool {
  emit_carried() == actual_golden
}

test fn c_semantic_decl_emit_char30_code_holds() -> Bool {
  char_at(s: emit_carried(), n: 30) == 32
}

test fn c_semantic_decl_emit_char31_code_holds() -> Bool {
  char_at(s: emit_carried(), n: 31) == 125
}

test fn c_semantic_decl_emit_char32_code_holds() -> Bool {
  char_at(s: emit_carried(), n: 32) == 32
}

test fn c_semantic_decl_emit_char33_code_holds() -> Bool {
  char_at(s: emit_carried(), n: 33) == 59
}

test fn c_semantic_decl_emit_char34_code_holds() -> Bool {
  char_at(s: emit_carried(), n: 34) == 32
}