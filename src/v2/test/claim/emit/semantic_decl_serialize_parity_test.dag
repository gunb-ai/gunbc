module v2.test.emit.semantic_decl_serialize_parity

import v2.compiler.translate {
  grammar_relation_row_for_emitted,
  grammar_relation_row_tokens_root,
  serialize_concrete_syntax_tokens_to_source
}
import v2.extdeps.languages.rust {
  rust_decl_derive_binding_spellings,
  rust_decl_general_lex,
  rust_enum_general_decl_productions_only_translation_rules,
  rust_enum_general_decl_structural_target_model,
  rust_target_model
}
import extdeps.languages.rust.emit { rust_enum_derives_copy }
import v2.std.compilers.semantic_decl_emission {
  semantic_decl_emission_from_target,
  semantic_decl_profile_binding_spellings,
  semantic_decl_profile_lex_rules,
  semantic_decl_serialize_target,
  target_semantic_enum_surface_from_coproduct
}
import v2.std.compilers.lexing { LexRules }
import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import v2.std.compilers.target_model {
  TargetModel,
  concrete_syntax_token_list_from_node,
  target_model_emit_transforms_empty,
  target_model_named_edge,
  target_model_type_conj_node
}
import v2.std.collection { Map }
import v2.std.diagnostic { Accepted, Outcome, Rejected, bind_outcome, outcome_accepted }
import v2.std.logic { Bool }
import v2.std.node { Conj, Disj, Edge, Named, Node, SyntheticOccurrence, Symbol, TypeNode }
import v2.std.text { String }
import std.algebra { Empty }

data bool_golden: String = concat(rust_enum_derives_copy, "\nenum Bool { True, False }")

fn bool_coproduct() -> Node {
  Node {
    kind: TypeNode { connective: Disj },
    children: [
      Edge { label: Named { name: ^True }, target: Node { kind: TypeNode { connective: Conj }, children: [], occurrence_id: SyntheticOccurrence } },
      Edge { label: Named { name: ^False }, target: Node { kind: TypeNode { connective: Conj }, children: [], occurrence_id: SyntheticOccurrence } }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn serialize_surface_with_target(surface: Node, rules: Node, target: TargetModel) -> Outcome<String> {
  bind_outcome(
    o: grammar_relation_row_for_emitted(rules: rules, emitted: surface),
    f: fn(row) {
      bind_outcome(
        o: grammar_relation_row_tokens_root(row: row),
        f: fn(tokens_root) {
          bind_outcome(
            o: concrete_syntax_token_list_from_node(list_node: tokens_root),
            f: fn(tokens) {
              bind_outcome(
                o: serialize_concrete_syntax_tokens_to_source(target: target, tokens: tokens),
                f: fn(medium) { outcome_accepted(value: medium.carried) }
              )
            }
          )
        }
      )
    }
  )
}

fn bool_serialize_target(lex: LexRules, bindings: Map<Symbol, String>) -> TargetModel {
  TargetModel {
    bundle: target_model_type_conj_node(
      children: [
        target_model_named_edge(
          name: ^target_model_edge_translation_rules,
          target: rust_enum_general_decl_productions_only_translation_rules()
        )
      ]
    ),
    lex: lex,
    binding_spellings: bindings,
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: "",
    runtime_row: target_emit_host_runtime_row_unconfigured
  }
}

fn bool_text_with_target(target: TargetModel) -> Outcome<String> {
  bind_outcome(
    o: semantic_decl_emission_from_target(target: rust_target_model()),
    f: fn(emission) {
      bind_outcome(
        o: target_semantic_enum_surface_from_coproduct(
          projection: emission.surface,
          name: ^Bool,
          params: Empty,
          coproduct: bool_coproduct()
        ),
        f: fn(surface) {
          serialize_surface_with_target(
            surface: surface,
            rules: rust_enum_general_decl_productions_only_translation_rules(),
            target: target
          )
        }
      )
    }
  )
}

test fn same_tokens_decoded_bindings_match_live_bindings() -> Bool {
  match semantic_decl_emission_from_target(target: rust_target_model()) {
    Accepted { value: emission, diagnostics: _ } =>
      match semantic_decl_profile_binding_spellings(profile: emission.enum_serialize_profile) {
        Accepted { value: decoded_bindings, diagnostics: _ } =>
          match target_semantic_enum_surface_from_coproduct(
            projection: emission.surface,
            name: ^Bool,
            params: Empty,
            coproduct: bool_coproduct()
          ) {
            Accepted { value: surface, diagnostics: _ } =>
              match grammar_relation_row_for_emitted(
                rules: rust_enum_general_decl_productions_only_translation_rules(),
                emitted: surface
              ) {
                Accepted { value: row, diagnostics: _ } =>
                  match grammar_relation_row_tokens_root(row: row) {
                    Accepted { value: tokens_root, diagnostics: _ } =>
                      match concrete_syntax_token_list_from_node(list_node: tokens_root) {
                        Accepted { value: tokens, diagnostics: _ } =>
                          match serialize_concrete_syntax_tokens_to_source(
                            target: bool_serialize_target(
                              lex: rust_decl_general_lex(),
                              bindings: decoded_bindings
                            ),
                            tokens: tokens
                          ) {
                            Accepted { value: decoded_medium, diagnostics: _ } =>
                              match serialize_concrete_syntax_tokens_to_source(
                                target: bool_serialize_target(
                                  lex: rust_decl_general_lex(),
                                  bindings: rust_decl_derive_binding_spellings()
                                ),
                                tokens: tokens
                              ) {
                                Accepted { value: live_medium, diagnostics: _ } =>
                                  decoded_medium.carried == live_medium.carried
                                Rejected { diagnostics: _ } => false
                              }
                            Rejected { diagnostics: _ } => false
                          }
                        Rejected { diagnostics: _ } => false
                      }
                    Rejected { diagnostics: _ } => false
                  }
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn same_tokens_decoded_lex_matches_live_lex() -> Bool {
  match semantic_decl_emission_from_target(target: rust_target_model()) {
    Accepted { value: emission, diagnostics: _ } =>
      match semantic_decl_profile_lex_rules(profile: emission.enum_serialize_profile) {
        Accepted { value: decoded_lex, diagnostics: _ } =>
          match target_semantic_enum_surface_from_coproduct(
            projection: emission.surface,
            name: ^Bool,
            params: Empty,
            coproduct: bool_coproduct()
          ) {
            Accepted { value: surface, diagnostics: _ } =>
              match grammar_relation_row_for_emitted(
                rules: rust_enum_general_decl_productions_only_translation_rules(),
                emitted: surface
              ) {
                Accepted { value: row, diagnostics: _ } =>
                  match grammar_relation_row_tokens_root(row: row) {
                    Accepted { value: tokens_root, diagnostics: _ } =>
                      match concrete_syntax_token_list_from_node(list_node: tokens_root) {
                        Accepted { value: tokens, diagnostics: _ } =>
                          match serialize_concrete_syntax_tokens_to_source(
                            target: bool_serialize_target(
                              lex: decoded_lex,
                              bindings: rust_decl_derive_binding_spellings()
                            ),
                            tokens: tokens
                          ) {
                            Accepted { value: decoded_medium, diagnostics: _ } =>
                              match serialize_concrete_syntax_tokens_to_source(
                                target: bool_serialize_target(
                                  lex: rust_decl_general_lex(),
                                  bindings: rust_decl_derive_binding_spellings()
                                ),
                                tokens: tokens
                              ) {
                                Accepted { value: live_medium, diagnostics: _ } =>
                                  decoded_medium.carried == live_medium.carried
                                Rejected { diagnostics: _ } => false
                              }
                            Rejected { diagnostics: _ } => false
                          }
                        Rejected { diagnostics: _ } => false
                      }
                    Rejected { diagnostics: _ } => false
                  }
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn decoded_lex_live_bindings_match_live_target() -> Bool {
  match semantic_decl_emission_from_target(target: rust_target_model()) {
    Accepted { value: emission, diagnostics: _ } =>
      match semantic_decl_profile_lex_rules(profile: emission.enum_serialize_profile) {
        Accepted { value: decoded_lex, diagnostics: _ } =>
          match bool_text_with_target(
            target: bool_serialize_target(
              lex: decoded_lex,
              bindings: rust_decl_derive_binding_spellings()
            )
          ) {
            Accepted { value: decoded_lex_text, diagnostics: _ } =>
              match bool_text_with_target(
                target: bool_serialize_target(
                  lex: rust_decl_general_lex(),
                  bindings: rust_decl_derive_binding_spellings()
                )
              ) {
                Accepted { value: live_lex_text, diagnostics: _ } => decoded_lex_text == live_lex_text
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

data semantic_decl_serialize_parity_note: String = "Row-decoded serialize profiles round-trip bundle spellings through concat/from_code_point native String grounding at decode; aggregate golden emit matches live path."

test fn decoded_row_profile_matches_golden() -> Bool {
  match semantic_decl_emission_from_target(target: rust_target_model()) {
    Accepted { value: emission, diagnostics: _ } =>
      match semantic_decl_profile_lex_rules(profile: emission.enum_serialize_profile) {
        Accepted { value: decoded_lex, diagnostics: _ } =>
          match semantic_decl_profile_binding_spellings(profile: emission.enum_serialize_profile) {
            Accepted { value: decoded_bindings, diagnostics: _ } =>
              match bool_text_with_target(
                target: bool_serialize_target(lex: decoded_lex, bindings: decoded_bindings)
              ) {
                Accepted { value: t, diagnostics: _ } => t == bool_golden
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn live_rebuilt_target_matches_golden() -> Bool {
  match bool_text_with_target(
    target: bool_serialize_target(
      lex: rust_decl_general_lex(),
      bindings: rust_decl_derive_binding_spellings()
    )
  ) {
    Accepted { value: t, diagnostics: _ } => t == bool_golden
    Rejected { diagnostics: _ } => false
  }
}

test fn live_via_bool_serialize_target_matches_golden() -> Bool {
  match bool_text_with_target(target: rust_enum_general_decl_structural_target_model()) {
    Accepted { value: t, diagnostics: _ } => t == bool_golden
    Rejected { diagnostics: _ } => false
  }
}

test fn generic_row_profile_matches_golden() -> Bool {
  match semantic_decl_emission_from_target(target: rust_target_model()) {
    Accepted { value: emission, diagnostics: _ } =>
      match target_semantic_enum_surface_from_coproduct(
        projection: emission.surface,
        name: ^Bool,
        params: Empty,
        coproduct: bool_coproduct()
      ) {
        Accepted { value: surface, diagnostics: _ } =>
          match semantic_decl_serialize_target(
            profile: emission.enum_serialize_profile,
            rules: rust_enum_general_decl_productions_only_translation_rules()
          ) {
            Accepted { value: target, diagnostics: _ } =>
              match serialize_surface_with_target(
                surface: surface,
                rules: rust_enum_general_decl_productions_only_translation_rules(),
                target: target
              ) {
                Accepted { value: t, diagnostics: _ } => t == bool_golden
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

