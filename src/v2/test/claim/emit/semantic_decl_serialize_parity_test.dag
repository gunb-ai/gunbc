module v2.test.emit.semantic_decl_serialize_parity


data bool_golden: String = concat(extdeps.languages.rust.emit.rust_enum_derives_copy, "\nenum Bool { True, False }")

fn bool_coproduct() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Disj },
    children: [
      v2.std.node.Edge { label: v2.std.node.Named { name: ^True }, target: v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Conj }, children: [], occurrence_id: v2.std.node.SyntheticOccurrence } },
      v2.std.node.Edge { label: v2.std.node.Named { name: ^False }, target: v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Conj }, children: [], occurrence_id: v2.std.node.SyntheticOccurrence } }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn serialize_surface_with_target(surface: v2.std.node.Node, rules: v2.std.node.Node, target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<String> {
  v2.std.diagnostic.bind_outcome(
    o: v2.compiler.translate.grammar_relation_row_for_emitted(rules: rules, emitted: surface),
    f: fn(row) {
      v2.std.diagnostic.bind_outcome(
        o: v2.compiler.translate.grammar_relation_row_tokens_root(row: row),
        f: fn(tokens_root) {
          v2.std.diagnostic.bind_outcome(
            o: v2.std.compilers.target_model.concrete_syntax_token_list_from_node(list_node: tokens_root),
            f: fn(tokens) {
              v2.std.diagnostic.bind_outcome(
                o: v2.compiler.translate.serialize_concrete_syntax_tokens_to_source(target: target, tokens: tokens),
                f: fn(medium) { v2.std.diagnostic.outcome_accepted(value: medium.carried) }
              )
            }
          )
        }
      )
    }
  )
}

fn bool_serialize_target(lex: v2.std.compilers.lexing.LexRules, bindings: Map<v2.std.node.Symbol, String>) -> v2.std.compilers.target_model.TargetModel {
  v2.std.compilers.target_model.TargetModel {
    produced_decl_support: v2.std.compilers.target_model.ProducedDeclUnwired,
    bundle: v2.std.compilers.target_model.target_model_type_conj_node(
      children: [
        v2.std.compilers.target_model.target_model_named_edge(
          name: ^target_model_edge_translation_rules,
          target: v2.extdeps.languages.rust.rust_enum_general_decl_productions_only_translation_rules()
        )
      ]
    ),
    lex: lex,
    binding_spellings: bindings,
    token_class_emit_transforms: v2.std.compilers.target_model.target_model_emit_transforms_empty,
    authority_source_text: "",
    runtime_row: v2.std.host_transport.target_emit_host_runtime_row_unconfigured
  }
}

fn bool_text_with_target(target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<String> {
  v2.std.diagnostic.bind_outcome(
    o: v2.std.compilers.semantic_decl_emission.semantic_decl_emission_from_target(target: v2.extdeps.languages.rust.rust_target_model()),
    f: fn(emission) {
      v2.std.diagnostic.bind_outcome(
        o: v2.std.compilers.semantic_decl_emission.target_semantic_enum_surface_from_coproduct(
          projection: emission.surface,
          name: ^Bool,
          params: std.algebra.Empty,
          coproduct: bool_coproduct()
        ),
        f: fn(surface) {
          serialize_surface_with_target(
            surface: surface,
            rules: v2.extdeps.languages.rust.rust_enum_general_decl_productions_only_translation_rules(),
            target: target
          )
        }
      )
    }
  )
}

test fn same_tokens_decoded_bindings_match_live_bindings() -> Bool {
  match v2.std.compilers.semantic_decl_emission.semantic_decl_emission_from_target(target: v2.extdeps.languages.rust.rust_target_model()) {
    v2.std.diagnostic.Accepted { value: emission, diagnostics: _ } =>
      match v2.std.compilers.semantic_decl_emission.semantic_decl_profile_binding_spellings(profile: emission.enum_serialize_profile) {
        v2.std.diagnostic.Accepted { value: decoded_bindings, diagnostics: _ } =>
          match v2.std.compilers.semantic_decl_emission.target_semantic_enum_surface_from_coproduct(
            projection: emission.surface,
            name: ^Bool,
            params: std.algebra.Empty,
            coproduct: bool_coproduct()
          ) {
            v2.std.diagnostic.Accepted { value: surface, diagnostics: _ } =>
              match v2.compiler.translate.grammar_relation_row_for_emitted(
                rules: v2.extdeps.languages.rust.rust_enum_general_decl_productions_only_translation_rules(),
                emitted: surface
              ) {
                v2.std.diagnostic.Accepted { value: row, diagnostics: _ } =>
                  match v2.compiler.translate.grammar_relation_row_tokens_root(row: row) {
                    v2.std.diagnostic.Accepted { value: tokens_root, diagnostics: _ } =>
                      match v2.std.compilers.target_model.concrete_syntax_token_list_from_node(list_node: tokens_root) {
                        v2.std.diagnostic.Accepted { value: tokens, diagnostics: _ } =>
                          match v2.compiler.translate.serialize_concrete_syntax_tokens_to_source(
                            target: bool_serialize_target(
                              lex: v2.extdeps.languages.rust.rust_decl_general_lex(),
                              bindings: decoded_bindings
                            ),
                            tokens: tokens
                          ) {
                            v2.std.diagnostic.Accepted { value: decoded_medium, diagnostics: _ } =>
                              match v2.compiler.translate.serialize_concrete_syntax_tokens_to_source(
                                target: bool_serialize_target(
                                  lex: v2.extdeps.languages.rust.rust_decl_general_lex(),
                                  bindings: v2.extdeps.languages.rust.rust_decl_derive_binding_spellings()
                                ),
                                tokens: tokens
                              ) {
                                v2.std.diagnostic.Accepted { value: live_medium, diagnostics: _ } =>
                                  decoded_medium.carried == live_medium.carried
                                v2.std.diagnostic.Rejected { diagnostics: _ } => false
                              }
                            v2.std.diagnostic.Rejected { diagnostics: _ } => false
                          }
                        v2.std.diagnostic.Rejected { diagnostics: _ } => false
                      }
                    v2.std.diagnostic.Rejected { diagnostics: _ } => false
                  }
                v2.std.diagnostic.Rejected { diagnostics: _ } => false
              }
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn same_tokens_decoded_lex_matches_live_lex() -> Bool {
  match v2.std.compilers.semantic_decl_emission.semantic_decl_emission_from_target(target: v2.extdeps.languages.rust.rust_target_model()) {
    v2.std.diagnostic.Accepted { value: emission, diagnostics: _ } =>
      match v2.std.compilers.semantic_decl_emission.semantic_decl_profile_lex_rules(profile: emission.enum_serialize_profile) {
        v2.std.diagnostic.Accepted { value: decoded_lex, diagnostics: _ } =>
          match v2.std.compilers.semantic_decl_emission.target_semantic_enum_surface_from_coproduct(
            projection: emission.surface,
            name: ^Bool,
            params: std.algebra.Empty,
            coproduct: bool_coproduct()
          ) {
            v2.std.diagnostic.Accepted { value: surface, diagnostics: _ } =>
              match v2.compiler.translate.grammar_relation_row_for_emitted(
                rules: v2.extdeps.languages.rust.rust_enum_general_decl_productions_only_translation_rules(),
                emitted: surface
              ) {
                v2.std.diagnostic.Accepted { value: row, diagnostics: _ } =>
                  match v2.compiler.translate.grammar_relation_row_tokens_root(row: row) {
                    v2.std.diagnostic.Accepted { value: tokens_root, diagnostics: _ } =>
                      match v2.std.compilers.target_model.concrete_syntax_token_list_from_node(list_node: tokens_root) {
                        v2.std.diagnostic.Accepted { value: tokens, diagnostics: _ } =>
                          match v2.compiler.translate.serialize_concrete_syntax_tokens_to_source(
                            target: bool_serialize_target(
                              lex: decoded_lex,
                              bindings: v2.extdeps.languages.rust.rust_decl_derive_binding_spellings()
                            ),
                            tokens: tokens
                          ) {
                            v2.std.diagnostic.Accepted { value: decoded_medium, diagnostics: _ } =>
                              match v2.compiler.translate.serialize_concrete_syntax_tokens_to_source(
                                target: bool_serialize_target(
                                  lex: v2.extdeps.languages.rust.rust_decl_general_lex(),
                                  bindings: v2.extdeps.languages.rust.rust_decl_derive_binding_spellings()
                                ),
                                tokens: tokens
                              ) {
                                v2.std.diagnostic.Accepted { value: live_medium, diagnostics: _ } =>
                                  decoded_medium.carried == live_medium.carried
                                v2.std.diagnostic.Rejected { diagnostics: _ } => false
                              }
                            v2.std.diagnostic.Rejected { diagnostics: _ } => false
                          }
                        v2.std.diagnostic.Rejected { diagnostics: _ } => false
                      }
                    v2.std.diagnostic.Rejected { diagnostics: _ } => false
                  }
                v2.std.diagnostic.Rejected { diagnostics: _ } => false
              }
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn decoded_lex_live_bindings_match_live_target() -> Bool {
  match v2.std.compilers.semantic_decl_emission.semantic_decl_emission_from_target(target: v2.extdeps.languages.rust.rust_target_model()) {
    v2.std.diagnostic.Accepted { value: emission, diagnostics: _ } =>
      match v2.std.compilers.semantic_decl_emission.semantic_decl_profile_lex_rules(profile: emission.enum_serialize_profile) {
        v2.std.diagnostic.Accepted { value: decoded_lex, diagnostics: _ } =>
          match bool_text_with_target(
            target: bool_serialize_target(
              lex: decoded_lex,
              bindings: v2.extdeps.languages.rust.rust_decl_derive_binding_spellings()
            )
          ) {
            v2.std.diagnostic.Accepted { value: decoded_lex_text, diagnostics: _ } =>
              match bool_text_with_target(
                target: bool_serialize_target(
                  lex: v2.extdeps.languages.rust.rust_decl_general_lex(),
                  bindings: v2.extdeps.languages.rust.rust_decl_derive_binding_spellings()
                )
              ) {
                v2.std.diagnostic.Accepted { value: live_lex_text, diagnostics: _ } => decoded_lex_text == live_lex_text
                v2.std.diagnostic.Rejected { diagnostics: _ } => false
              }
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

// Row-decoded serialize profiles round-trip bundle spellings through concat/from_code_point native String grounding at decode; aggregate golden emit matches live path.
test fn decoded_row_profile_matches_golden() -> Bool {
  match v2.std.compilers.semantic_decl_emission.semantic_decl_emission_from_target(target: v2.extdeps.languages.rust.rust_target_model()) {
    v2.std.diagnostic.Accepted { value: emission, diagnostics: _ } =>
      match v2.std.compilers.semantic_decl_emission.semantic_decl_profile_lex_rules(profile: emission.enum_serialize_profile) {
        v2.std.diagnostic.Accepted { value: decoded_lex, diagnostics: _ } =>
          match v2.std.compilers.semantic_decl_emission.semantic_decl_profile_binding_spellings(profile: emission.enum_serialize_profile) {
            v2.std.diagnostic.Accepted { value: decoded_bindings, diagnostics: _ } =>
              match bool_text_with_target(
                target: bool_serialize_target(lex: decoded_lex, bindings: decoded_bindings)
              ) {
                v2.std.diagnostic.Accepted { value: t, diagnostics: _ } => t == bool_golden
                v2.std.diagnostic.Rejected { diagnostics: _ } => false
              }
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn live_rebuilt_target_matches_golden() -> Bool {
  match bool_text_with_target(
    target: bool_serialize_target(
      lex: v2.extdeps.languages.rust.rust_decl_general_lex(),
      bindings: v2.extdeps.languages.rust.rust_decl_derive_binding_spellings()
    )
  ) {
    v2.std.diagnostic.Accepted { value: t, diagnostics: _ } => t == bool_golden
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn live_via_bool_serialize_target_matches_golden() -> Bool {
  match bool_text_with_target(target: v2.extdeps.languages.rust.rust_enum_general_decl_structural_target_model()) {
    v2.std.diagnostic.Accepted { value: t, diagnostics: _ } => t == bool_golden
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn generic_row_profile_matches_golden() -> Bool {
  match v2.std.compilers.semantic_decl_emission.semantic_decl_emission_from_target(target: v2.extdeps.languages.rust.rust_target_model()) {
    v2.std.diagnostic.Accepted { value: emission, diagnostics: _ } =>
      match v2.std.compilers.semantic_decl_emission.target_semantic_enum_surface_from_coproduct(
        projection: emission.surface,
        name: ^Bool,
        params: std.algebra.Empty,
        coproduct: bool_coproduct()
      ) {
        v2.std.diagnostic.Accepted { value: surface, diagnostics: _ } =>
          match v2.std.compilers.semantic_decl_emission.semantic_decl_serialize_target(
            profile: emission.enum_serialize_profile,
            rules: v2.extdeps.languages.rust.rust_enum_general_decl_productions_only_translation_rules()
          ) {
            v2.std.diagnostic.Accepted { value: target, diagnostics: _ } =>
              match serialize_surface_with_target(
                surface: surface,
                rules: v2.extdeps.languages.rust.rust_enum_general_decl_productions_only_translation_rules(),
                target: target
              ) {
                v2.std.diagnostic.Accepted { value: t, diagnostics: _ } => t == bool_golden
                v2.std.diagnostic.Rejected { diagnostics: _ } => false
              }
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

