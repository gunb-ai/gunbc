module v2.test.claim.emit.generic_signature_emission

import extdeps.communication.medium { Lossless, Medium }
import v2.compiler.self_host.closure_emission {
  ClosureMemberEmitted, ClosureMemberRefused, emit_closure_from_ingest_located,
}
import v2.compiler.source_authority { DagSourceReadWitness }
import v2.extdeps.languages.rust { rust_target_model }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.diagnostic { Accepted, Rejected, diagnostics_fatal_reason }
import v2.std.node { Atom, Node, Symbol, TypeNode, node_synthetic }
import std.optional { Absent, Present }
import v2.std.qualified_name { qualified_name_from_dotted_string }
import v2.std.text { String }

// A TYPE APPLICATION IN A FUNCTION SIGNATURE (`Box<T>`, a generic type declared in the same module, over the function's own parameter) IS SPELLED BY THE
// ONE TYPE-APPLICATION RENDERER (v2.compiler.emit_semantic_decl produced_type_binding_instantiation over
// translate_type_expression_project), and the function's own type parameter binds like a type
// declaration's. Before it, every applied type in a signature refused produced_decl_type_ref_unrealized.
// The fixture declares `Box<T>`, so the row stacks on the generic member arm of the PR that introduced it.
type SignatureEmissionVerdict
  = SignatureEmitted { text: String }
  | SignatureRefused { reason: Symbol }

fn signature_emission_locus() -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: ^signature_emission_locus } }, children: [])
}

fn signature_emission_verdict_of(source: String) -> SignatureEmissionVerdict {
  match emit_closure_from_ingest_located(
    ingest: [
      DagSourceReadWitness {
        source: Medium { carried: source, fidelity: Lossless },
        artifact: Artifact { kind: SourceFile, id: ^signature_emission_read, file_path: "src/v2/test/fixture/generic_signature_emission/entry.dag" },
        compilation_unit: ^signature_emission_read,
        source_root: DagTree
      }
    ],
    entry: qualified_name_from_dotted_string(dotted: "v2.test.signature_emission"),
    entry_locus: signature_emission_locus(),
    target: rust_target_model()
  ).outcome {
    Rejected { diagnostics: d } => SignatureRefused { reason: diagnostics_fatal_reason(d: d) }
    Accepted { value: ce, diagnostics: _ } =>
      match first(ce.modules) {
        Absent => SignatureRefused { reason: ^signature_emission_no_member }
        Present { value: ClosureMemberEmitted { module: _, text: t } } => SignatureEmitted { text: t }
        Present { value: ClosureMemberRefused { module: _, diagnostics: d } } => SignatureRefused { reason: diagnostics_fatal_reason(d: d) }
      }
  }
}

fn signature_emission_applied_type_verdict() -> SignatureEmissionVerdict {
  signature_emission_verdict_of(source: "module v2.test.signature_emission\n\ntype Box<T> { value: T }\n\nfn f<T>(x: Box<T>) -> Box<T> { x }\n")
}

test fn an_applied_type_of_the_functions_own_parameter_is_spelled_in_its_signature_holds() -> Bool {
  match signature_emission_applied_type_verdict() {
    SignatureEmitted { text: t } => string_contains(s: t, pattern: "fn f<T>(") && string_contains(s: t, pattern: "Box < T >")
    SignatureRefused { reason: _ } => false
  }
}
