module v2.test.emit.bool_literal_projection


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

// Routes bool spelling through TargetBoolLiteralShape on each target projection. Emission tests
// construct canonical TargetValueExprBoolLiteral values and prove spelling derives from the
// output projection only. Source recognition threads source_bool_form from the dag language
// projection at the emit boundary; std/compilers holds no dag keyword roster.

data bool_literal_true_lower_golden: String = "true"

data bool_literal_true_upper_golden: String = "TRUE"

fn blp_probe_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^blp_emit_probe } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn blp_probe_inputs() -> v2.compiler.eval.Inputs {
  inputs_root_only(root: blp_probe_node())
}

fn blp_probe_source() -> Medium<String> {
  extdeps.communication.medium.Medium { carried: "", fidelity: Lossless }
}

fn blp_bool_literal_expr() -> v2.std.compilers.target_model.TargetValueExpression {
  target_value_expression_bool_literal(value: true)
}

fn blp_dag_source_bool_form() -> v2.std.compilers.target_model.TargetBoolLiteralShape {
  dag_value_expression_projection().bool_literal_form
}

fn blp_canonical_only_bool_form() -> v2.std.compilers.target_model.TargetBoolLiteralShape {
  v2.std.compilers.target_model.TargetBoolLiteralShape {
    true_token: ^target_value_expression_bool_true,
    false_token: ^target_value_expression_bool_false
  }
}

fn blp_lower_bool_form() -> v2.std.compilers.target_model.TargetBoolLiteralShape {
  v2.std.compilers.target_model.TargetBoolLiteralShape {
    true_token: ^blp_token_true_lower,
    false_token: ^blp_token_false_lower
  }
}

fn blp_upper_bool_form() -> v2.std.compilers.target_model.TargetBoolLiteralShape {
  v2.std.compilers.target_model.TargetBoolLiteralShape {
    true_token: ^blp_token_true_upper,
    false_token: ^blp_token_false_upper
  }
}

fn blp_projection_with(bool_form: v2.std.compilers.target_model.TargetBoolLiteralShape) -> v2.std.compilers.target_model.TargetValueExpressionProjection {
  v2.std.compilers.target_model.TargetValueExpressionProjection {
    bool_literal_form: bool_form,
    binding_ref_form: rust_value_expression_projection().binding_ref_form,
    primitive_apply_form: rust_value_expression_projection().primitive_apply_form,
    callable_apply_form: rust_value_expression_projection().callable_apply_form,
    closure_form: rust_value_expression_projection().closure_form,
    effect_apply_form: rust_value_expression_projection().effect_apply_form,
    conditional_form: rust_value_expression_projection().conditional_form,
    let_form: rust_value_expression_projection().let_form,
    loop_form: rust_value_expression_projection().loop_form,
    record_construct_form: rust_value_expression_projection().record_construct_form,
    field_access_form: rust_value_expression_projection().field_access_form,
    match_form: rust_value_expression_projection().match_form,
    block_evaluation_mode: rust_value_expression_projection().block_evaluation_mode
  }
}

fn blp_lex() -> v2.std.compilers.lexing.LexRules {
  v2.std.compilers.lexing.ModeledLexRules {
    root: v2.std.compilers.lexing.LexRuleSet {
      rules: list_append(
        left: rust_fn_add_lex_rules().rules,
        right: [
          rust_lex_rule(token_class: ^blp_token_true_lower, text: "true"),
          rust_lex_rule(token_class: ^blp_token_false_lower, text: "false"),
          rust_lex_rule(token_class: ^blp_token_true_upper, text: "TRUE"),
          rust_lex_rule(token_class: ^blp_token_false_upper, text: "FALSE")
        ]
      )
    }
  }
}

fn blp_target() -> v2.std.compilers.target_model.TargetModel {
  v2.std.compilers.target_model.TargetModel {
    produced_decl_support: ProducedDeclUnwired,
    bundle: rust_target_model().bundle,
    lex: blp_lex(),
    binding_spellings: rust_target_model().binding_spellings,
    token_class_emit_transforms: rust_target_model().token_class_emit_transforms,
    authority_source_text: rust_target_model().authority_source_text,
    runtime_row: rust_target_model().runtime_row
  }
}

fn blp_emit(
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection,
  catalog: Node
) -> v2.std.diagnostic.Outcome<String> {
  match target_value_expression_to_concrete_tokens(
    expr: blp_bool_literal_expr(),
    projection: projection,
    catalog: catalog
  ) {
    v2.std.diagnostic.Accepted { value: tokens, diagnostics: _ } =>
      match serialize_concrete_syntax_tokens_to_source_string(
        target: target,
        tokens: tokens
      ) {
        v2.std.diagnostic.Accepted { value: text, diagnostics: _ } =>
          v2.std.diagnostic.Accepted { value: render_target_text(t: text), diagnostics: v2.std.diagnostic.None }
        v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
      }
    v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn blp_emits(bool_form: v2.std.compilers.target_model.TargetBoolLiteralShape, golden: String) -> Bool {
  match blp_emit(
    target: blp_target(),
    projection: blp_projection_with(bool_form: bool_form),
    catalog: rust_operator_realizations_catalog_node()
  ) {
    v2.std.diagnostic.Accepted { value: text, diagnostics: _ } => text == golden
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn bool_spelling_is_derived_from_projection() -> Bool {
  blp_emits(bool_form: blp_lower_bool_form(), golden: bool_literal_true_lower_golden)
    && blp_emits(bool_form: blp_upper_bool_form(), golden: bool_literal_true_upper_golden)
    && !blp_emits(bool_form: blp_lower_bool_form(), golden: bool_literal_true_upper_golden)
    && !blp_emits(bool_form: blp_upper_bool_form(), golden: bool_literal_true_lower_golden)
}

fn blp_production_emits(
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetValueExpressionProjection,
  catalog: Node
) -> Bool {
  match blp_emit(target: target, projection: projection, catalog: catalog) {
    v2.std.diagnostic.Accepted { value: text, diagnostics: d } =>
      (text == bool_literal_true_lower_golden) && (d == v2.std.diagnostic.None)
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn production_rust_bool_literal_declares_rust_spelling() -> Bool {
  blp_production_emits(
    target: rust_target_model(),
    projection: rust_value_expression_projection(),
    catalog: rust_operator_realizations_catalog_node()
  )
}

test fn production_typescript_bool_literal_declares_ts_spelling() -> Bool {
  blp_production_emits(
    target: ts_target_model(),
    projection: ts_value_expression_projection(),
    catalog: ts_operator_realizations_catalog_node()
  )
}

test fn production_c_bool_literal_pins_spelling_while_known_invalid_under_c17() -> Bool {
  match c_bool_literal_emit_validity_under_declared_standard() {
    KnownInvalidUnderDeclaredStandard {
      standard_edition: CStage0EmitStandardC17,
      standard_citation: _,
      defect: MissingStdboolInclude { emitted_bool_literal_requires: _ }
    } =>
      blp_production_emits(
        target: c_target_model(),
        projection: c_value_expression_projection(),
        catalog: c_operator_realizations_catalog_node()
      )
        && match c_bool_literal_stdbool_preamble_emit_disposition {
          Scaffold { dissolves_to: RealizationDispatch, bind: _ } => true
          _ => false
        }
    _ => false
  }
}

test fn dag_source_bool_form_recognizes_dag_token() -> Bool {
  match target_value_expr_bool_literal_value_from_source_symbol(
    id: ^dag_token_kw_true,
    source_bool_form: blp_dag_source_bool_form()
  ) {
    Present { value: b } => b
    Absent => false
  }
}

test fn dag_token_unrecognized_without_source_projection() -> Bool {
  match target_value_expr_bool_literal_value_from_source_symbol(
    id: ^dag_token_kw_true,
    source_bool_form: blp_canonical_only_bool_form()
  ) {
    Present { value: _ } => false
    Absent => true
  }
}

test fn rust_spelling_token_is_not_dag_source_bool_literal() -> Bool {
  match target_value_expr_bool_literal_value_from_source_symbol(
    id: ^rust_token_kw_true,
    source_bool_form: blp_dag_source_bool_form()
  ) {
    Present { value: _ } => false
    Absent => true
  }
}

test fn dag_source_atom_projects_to_canonical_bool_literal() -> Bool {
  match target_value_expr_project_pick_literal_atom(
    id: ^dag_token_kw_true,
    source_bool_form: blp_dag_source_bool_form()
  ) {
    v2.std.diagnostic.Accepted { value: expr, diagnostics: _ } =>
      target_value_expr_is_bool_literal_expression(
        expr: expr,
        source_bool_form: blp_dag_source_bool_form()
      )
        && match expr.kind {
          TargetValueExprBoolLiteral => true
          _ => false
        }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}
