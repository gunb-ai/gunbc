module v2.test.emit.emit_module_contribution

import v2.compiler.emit_module {
  emit_module_contribution,
  emit_module_decl_separator,
  emit_module_text
}
import v2.compiler.emit { emit }
import v2.compiler.infer { InferredTree }
import v2.extdeps.languages.rust { rust_source_text }
import v2.extdeps.languages.rust_test { rust_add_target_model_staging }
import v2.test.execution.emit_host_add_equals_eval { emit_eval_subject_tree }
import v2.std.collection { List }
import v2.std.compilers.target_model { TargetModel }
import v2.std.diagnostic { Accepted, None, Outcome, Rejected }
import v2.std.logic { Bool }
import v2.std.text { String }
import v2.std.algebra { fold_list, list_append }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.algebra { Empty }
import std.decl_ref { decl_ref, declaration_ref_eq }
import std.emission_provenance {
  EmissionAuthoredFragment,
  EmissionContribution,
  EmissionSourceComposition,
  EmissionUnobservedFragment,
  EmissionOriginsObserved,
  EmissionOriginsIncomplete,
  emission_contribution_fold,
  emission_contribution_read,
  emission_contribution_unobserved
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// This is the executing consumer std.emission_provenance was waiting on: EmissionContribution
// values here are built BY THE REAL EMITTER PATH (v2.compiler.emit_module folding
// v2.compiler.emit over declaration trees), never hand-assembled. The hand-built fixtures in
// dag/test/claim/emission_provenance_test.dag prove the algebra; nothing proved a producer
// inhabits it. The subject tree and target model are the same real ones
// v2.test.execution.emit_host_module_equals_eval already emits and evaluates.
//
// All three contribution arms are REAL at this seam, none is a stand-in:
//   EmissionAuthoredFragment    the separator, whose bytes are the literal declared at
//                               v2.compiler.emit_module emit_module_decl_separator
//   EmissionSourceComposition   the module fold, and one composition per declaration
//   EmissionUnobservedFragment  v2.compiler.emit returns Medium<String>: the fold OBSERVES the
//                               bytes but emit reports no contribution structure for them, so
//                               those origins genuinely are not observed here. This records
//                               missing ORIGINS, never a missing emission -- a REJECTED
//                               declaration still refuses (DESIGN.md S5 absorbing fallback).
// The unobserved arm's next-rung trigger is v2.compiler.emit itself returning an
// EmissionContribution; when it lands this arm flips to Authored/Composition and the arm-census
// specimens below become the regression control rather than retiring (DESIGN.md S4b(4)).

fn emc_decls(n: Int) -> List<InferredTree> {
  if n <= 0 {
    Empty
  } else if n == 1 {
    [emit_eval_subject_tree()]
  } else if n == 2 {
    [emit_eval_subject_tree(), emit_eval_subject_tree()]
  } else {
    [emit_eval_subject_tree(), emit_eval_subject_tree(), emit_eval_subject_tree()]
  }
}

fn emc_target() -> TargetModel {
  rust_add_target_model_staging()
}

fn emc_text(n: Int) -> Outcome<String> {
  emit_module_text(decls: emc_decls(n: n), target: emc_target())
}

fn emc_contribution(n: Int) -> Outcome<EmissionContribution> {
  emit_module_contribution(decls: emc_decls(n: n), target: emc_target())
}

// ---------------------------------------------------------------------------
// Instrument 1: byte identity of the production emission against the repeated-append
// concatenation emit_module_text performed before it was derived from the contribution tree.
// The reference lives HERE, in the control, so production keeps ONE authority for the bytes
// (DESIGN.md S3) while the change to that authority stays measured rather than asserted.
// ---------------------------------------------------------------------------

fn emc_reference_step(acc: Outcome<String>, tree: InferredTree) -> Outcome<String> {
  match acc {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: partial, diagnostics: _ } =>
      match emit(tree: tree, target: emc_target()) {
        Accepted { value: medium, diagnostics: _ } =>
          Accepted {
            value: list_append(
              left: list_append(left: partial, right: medium.carried),
              right: emit_module_decl_separator
            ),
            diagnostics: None
          }
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
  }
}

fn emc_reference_text(n: Int) -> Outcome<String> {
  fold_list(
    xs: emc_decls(n: n),
    empty: Accepted { value: Empty, diagnostics: None },
    cons: fn(acc, tree) {
      emc_reference_step(acc: acc, tree: tree)
    }
  )
}

fn emc_text_equals_reference(n: Int) -> Bool {
  match emc_text(n: n) {
    Accepted { value: produced, diagnostics: _ } =>
      match emc_reference_text(n: n) {
        Accepted { value: reference, diagnostics: _ } => produced == reference
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn emc_expected_one() -> String {
  list_append(left: rust_source_text, right: emit_module_decl_separator)
}

fn emc_text_matches(n: Int, golden: String) -> Bool {
  match emc_text(n: n) {
    Accepted { value: produced, diagnostics: _ } => produced == golden
    Rejected { diagnostics: _ } => false
  }
}

test fn emc_production_text_is_byte_identical_to_repeated_append_holds() -> Bool {
  emc_text_equals_reference(n: 0)
    && emc_text_equals_reference(n: 1)
    && emc_text_equals_reference(n: 2)
    && emc_text_equals_reference(n: 3)
}

// Discriminating red for the equality above: it CAN fail. The empty-declaration module is exactly
// the empty string (no leading or trailing separator), and a one-declaration module is the
// declaration text followed by exactly one separator -- so a golden that adds or drops a separator
// is refused. Without this, the equality specimen could be green over two identically-broken folds.
test fn emc_separator_placement_discriminates_holds() -> Bool {
  emc_text_matches(n: 0, golden: Empty)
    && !emc_text_matches(n: 0, golden: emit_module_decl_separator)
    && emc_text_matches(n: 1, golden: emc_expected_one())
    && !emc_text_matches(n: 1, golden: rust_source_text)
    && !emc_text_matches(n: 1, golden: list_append(left: emc_expected_one(), right: emit_module_decl_separator))
    && emc_text_matches(n: 2, golden: list_append(left: emc_expected_one(), right: emc_expected_one()))
}

// ---------------------------------------------------------------------------
// Instrument 2: the contribution tree read back through emission_contribution_read, and every
// arm walked through emission_contribution_fold.
// ---------------------------------------------------------------------------

data emc_arm_authored: String = "authored"
data emc_arm_composition: String = "composition"
data emc_arm_unobserved: String = "unobserved"

fn emc_arm_of(contribution: EmissionContribution) -> String {
  match contribution {
    EmissionAuthoredFragment { origin: _, source: _ } => emc_arm_authored
    EmissionSourceComposition { origin: _, parts: _ } => emc_arm_composition
    EmissionUnobservedFragment { producer: _, cause: _, source: _ } => emc_arm_unobserved
  }
}

fn emc_arm_count(n: Int, arm: String) -> Int {
  match emc_contribution(n: n) {
    Accepted { value: contribution, diagnostics: _ } =>
      emission_contribution_fold(
        contribution: contribution,
        read: fn(node, children) {
          fold_list(
            xs: children,
            empty: if emc_arm_of(contribution: node) == arm { 1 } else { 0 },
            cons: fn(acc, child) { acc + child }
          )
        }
      )
    Rejected { diagnostics: _ } => 0 - 1
  }
}

// A two-declaration module: one root composition plus one composition per declaration, one
// authored separator per declaration, one unobserved emit fragment per declaration.
test fn emc_all_three_arms_are_constructed_by_the_emitter_holds() -> Bool {
  (emc_arm_count(n: 2, arm: emc_arm_composition) == 3)
    && (emc_arm_count(n: 2, arm: emc_arm_authored) == 2)
    && (emc_arm_count(n: 2, arm: emc_arm_unobserved) == 2)
    && (emc_arm_count(n: 1, arm: emc_arm_composition) == 2)
    && (emc_arm_count(n: 1, arm: emc_arm_authored) == 1)
    && (emc_arm_count(n: 1, arm: emc_arm_unobserved) == 1)
    && (emc_arm_count(n: 0, arm: emc_arm_composition) == 1)
    && (emc_arm_count(n: 0, arm: emc_arm_authored) == 0)
    && (emc_arm_count(n: 0, arm: emc_arm_unobserved) == 0)
}

fn emc_read_source_matches(n: Int) -> Bool {
  match emc_contribution(n: n) {
    Accepted { value: contribution, diagnostics: _ } =>
      match emc_text(n: n) {
        Accepted { value: produced, diagnostics: _ } =>
          emission_contribution_read(contribution: contribution).source == produced
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn emc_read_materializes_the_emitted_source_holds() -> Bool {
  emc_read_source_matches(n: 0)
    && emc_read_source_matches(n: 1)
    && emc_read_source_matches(n: 2)
}

fn emc_origins_observed_count(n: Int) -> Int {
  match emc_contribution(n: n) {
    Accepted { value: contribution, diagnostics: _ } =>
      match emission_contribution_read(contribution: contribution).origins {
        EmissionOriginsObserved { origins } => fold_list(xs: origins, empty: 0, cons: fn(acc, o) { acc + 1 })
        EmissionOriginsIncomplete { observed, missing: _ } =>
          fold_list(xs: observed, empty: 0, cons: fn(acc, o) { acc + 1 })
      }
    Rejected { diagnostics: _ } => 0 - 1
  }
}

fn emc_origins_are_incomplete(n: Int) -> Bool {
  match emc_contribution(n: n) {
    Accepted { value: contribution, diagnostics: _ } =>
      match emission_contribution_read(contribution: contribution).origins {
        EmissionOriginsObserved { origins: _ } => false
        EmissionOriginsIncomplete { observed: _, missing: _ } => true
      }
    Rejected { diagnostics: _ } => false
  }
}

fn emc_unobserved_producers(n: Int) -> Int {
  match emc_contribution(n: n) {
    Accepted { value: contribution, diagnostics: _ } =>
      fold_list(
        xs: emission_contribution_unobserved(contribution: contribution),
        empty: 0,
        cons: fn(acc, producer) {
          if declaration_ref_eq(
            a: producer,
            b: decl_ref(module_path: "v2.compiler.emit", decl_name: "emit")
          ) {
            acc + 1
          } else {
            0 - 1
          }
        }
      )
    Rejected { diagnostics: _ } => 0 - 1
  }
}

// The origin metadata is the point of the carrier, not decoration: a module whose declarations
// were emitted through v2.compiler.emit reads back INCOMPLETE, naming that producer once per
// declaration, while a module with no declarations observes its own root origin and nothing else.
test fn emc_origins_locate_the_unobserved_producer_holds() -> Bool {
  emc_origins_are_incomplete(n: 2)
    && (emc_unobserved_producers(n: 2) == 2)
    && emc_origins_are_incomplete(n: 1)
    && (emc_unobserved_producers(n: 1) == 1)
    && !emc_origins_are_incomplete(n: 0)
    && (emc_unobserved_producers(n: 0) == 0)
    && (emc_origins_observed_count(n: 0) == 1)
    && (emc_origins_observed_count(n: 1) == 3)
    && (emc_origins_observed_count(n: 2) == 5)
}
