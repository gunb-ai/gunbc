module v2.test.emit.arrow_scope_atom_refuses_unresolved

import v2.compiler.translate { translate_project_transform_in_arrow_scope }
import v2.extdeps.languages.dag { dag_value_expression_projection }
import v2.extdeps.languages.typescript { ts_binding_spellings, ts_source_text_authority, ts_fn_add_lex_rules }
import v2.std.diagnostic { Accepted, Outcome, Rejected, diagnostics_fatal, node_locus }
import v2.std.logic { Bool }
import v2.std.node {
  Arrow,
  Atom,
  ComputationNode,
  Conj,
  Edge,
  Named,
  Node,
  Positional,
  Symbol,
  Transform,
  TypeNode,
  node_synthetic
}
import v2.std.compilers.target_model {
  ProducedDeclUnwired,
  TargetModel,
  TargetValueExpression,
  target_model_emit_transforms_empty,
  target_operator_realizations_catalog_node,
  target_project_arrow_body_to_value_expression,
  value_expr_projection_bundle_node
}
import v2.std.compilers.lexing { ModeledLexRules }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE SUBJECT IS AN ATOM THAT MISSES ARROW SCOPE (v2.std.compilers.target_model
// target_value_expr_project_atom_in_arrow_scope). Before this change its Rejected arm fell through to
// the literal projector, whose last arm minted the name as a symbol_identity -- an unresolved name
// emitted as if it resolved (DESIGN §5, absorbing fallback). The fixture is `f(xs, (acc) => <atom>)`:
// the closure is a call argument, so its body atom reaches exactly that site with the closure as its
// arrow. An atom that names nothing in scope must refuse `body_scope_binding_invalid`, LOCATED AT THE
// ATOM; an atom that spells a literal (`true`) still projects. Restoring the fallback makes the
// refusal row false.
fn probe_atom(id: Symbol) -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: id } }, children: [])
}

fn probe_named(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn probe_positional(target: Node) -> Edge {
  Edge { label: Positional, target: target }
}

fn probe_closure(body: Node) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Arrow },
    children: [
      probe_positional(
        target: node_synthetic(
          kind: TypeNode { connective: Conj },
          children: [probe_named(name: ^fold_call_closure_acc, target: probe_atom(id: ^fold_call_type_int))]
        )
      ),
      probe_positional(target: probe_atom(id: ^fold_call_type_int)),
      probe_named(name: ^arrow_body_edge, target: body)
    ]
  )
}

fn probe_arrow(closure_body: Node) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Arrow },
    children: [
      probe_positional(
        target: node_synthetic(
          kind: TypeNode { connective: Conj },
          children: [probe_named(name: ^fold_call_param_xs, target: probe_atom(id: ^fold_call_type_int))]
        )
      ),
      probe_positional(target: probe_atom(id: ^fold_call_type_int)),
      probe_named(
        name: ^arrow_body_edge,
        target: node_synthetic(
          kind: ComputationNode { behavior: Transform },
          children: [
            probe_positional(target: probe_atom(id: ^fold_call_callee)),
            probe_positional(target: probe_atom(id: ^fold_call_param_xs)),
            probe_positional(target: probe_closure(body: closure_body))
          ]
        )
      )
    ]
  )
}

fn probe_target_model() -> TargetModel {
  TargetModel {
    produced_decl_support: ProducedDeclUnwired,
    bundle: node_synthetic(
      kind: TypeNode { connective: Conj },
      children: [
        probe_named(
          name: ^target_model_edge_value_expression_projection,
          target: value_expr_projection_bundle_node(projection: dag_value_expression_projection())
        ),
        probe_named(
          name: ^target_model_edge_operator_realizations,
          target: target_operator_realizations_catalog_node(rows: [])
        )
      ]
    ),
    lex: ModeledLexRules { root: ts_fn_add_lex_rules() },
    binding_spellings: ts_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: ts_source_text_authority(),
    runtime_row: target_emit_host_runtime_row_unconfigured
  }
}

fn probe_project(closure_body: Node) -> Outcome<TargetValueExpression> {
  target_project_arrow_body_to_value_expression(
    arrow: probe_arrow(closure_body: closure_body),
    target: probe_target_model(),
    source_bool_form: dag_value_expression_projection().bool_literal_form,
    handle_transform: fn(a, b, t) { translate_project_transform_in_arrow_scope(arrow: a, body: b, target: t) }
  )
}

data probe_unbound_atom: Node = probe_atom(id: ^arrow_scope_probe_unbound_name)

// THE WALL: the name resolves in no scope, so the projection refuses at that atom.
test fn arrow_scope_unresolved_atom_refuses_located() -> Bool {
  match probe_project(closure_body: probe_unbound_atom) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } =>
      diagnostics_fatal(d: d).reason == ^target_value_expr_reason_body_scope_binding_invalid
        && diagnostics_fatal(d: d).at == node_locus(node: probe_unbound_atom)
  }
}

// THE POSITIVE CONTROL ON THE SAME ROUTE: an atom that spells a literal still projects as that literal,
// so the refusal above is about the name, not the position.
test fn arrow_scope_literal_atom_still_projects() -> Bool {
  match probe_project(closure_body: probe_atom(id: ^dag_token_kw_true)) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}
