module v2.test.emit.c_emit_token_probe_test

import v2.compiler.emit_semantic_decl { emit_semantic_type_decl }
import v2.compiler.translate {
  grammar_relation_row_for_emitted,
  grammar_relation_row_tokens_root
}
import v2.extdeps.languages.c { c_target_model }
import v2.std.compilers.semantic_decl_emission {
  semantic_decl_emission_from_target,
  target_semantic_struct_surface_from_record
}
import v2.std.compilers.target_model { concrete_syntax_token_list_from_node }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Conj, Edge, Named, Node, SyntheticOccurrence, TypeNode, Atom }
import std.algebra { Empty, fold_list }

fn cdr_point_record() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^x },
        target: Node {
          kind: TypeNode { connective: Atom { identity: ^Int } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      },
      Edge {
        label: Named { name: ^y },
        target: Node {
          kind: TypeNode { connective: Atom { identity: ^Int } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn point_token_count() -> Int {
  match semantic_decl_emission_from_target(target: c_target_model()) {
    Accepted { value: emission, diagnostics: _ } =>
      match target_semantic_struct_surface_from_record(
        projection: emission.surface,
        name: ^Point,
        params: Empty,
        record: cdr_point_record()
      ) {
        Accepted { value: surface, diagnostics: _ } =>
          match grammar_relation_row_for_emitted(
            rules: emission.struct_translation_rules,
            emitted: surface
          ) {
            Accepted { value: row, diagnostics: _ } =>
              match grammar_relation_row_tokens_root(row: row) {
                Accepted { value: tokens_root, diagnostics: _ } =>
                  match concrete_syntax_token_list_from_node(list_node: tokens_root) {
                    Accepted { value: tokens, diagnostics: _ } =>
                      fold_list(xs: tokens, empty: 0, cons: fn(acc, _) { acc + 1 })
                    Rejected { diagnostics: _ } => 0 - 1
                  }
                Rejected { diagnostics: _ } => 0 - 2
              }
            Rejected { diagnostics: _ } => 0 - 3
          }
        Rejected { diagnostics: _ } => 0 - 4
      }
    Rejected { diagnostics: _ } => 0 - 5
  }
}

test fn c_emit_token_count_is_11_holds() -> Bool {
  point_token_count() == 11
}

test fn c_emit_token_count_is_10_holds() -> Bool {
  point_token_count() == 10
}

test fn c_emit_token_count_is_9_holds() -> Bool {
  point_token_count() == 9
}

test fn c_emit_token_count_is_8_holds() -> Bool {
  point_token_count() == 8
}
