module v2.test.claim.emit.semantic_decl_decoration_binding

import std.types { List }
import std.occurrence_identity { OccurrenceSynthetic }
import v2.extdeps.languages.rust_fixtures { rust_semantic_decl_target_model_staging }
import v2.std.compilers.semantic_decl_emission {
  TargetSemanticDeclDecorationLine,
  semantic_decl_emission_from_target,
  target_semantic_decl_coproduct_decoration_lines
}
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.node { Conj, Disj, Edge, Authored, Node, TypeNode, NotADeclaration }

import v2.std.text { is_empty }
import std.algebra { Empty, fold_list }

fn bool_coproduct() -> Node {
  Node {
    kind: TypeNode { connective: Disj },
    children: [
      Edge { label: Authored { name: ^True }, target: Node { kind: TypeNode { connective: Conj }, children: [], occurrence_id: OccurrenceSynthetic }, declaration: NotADeclaration },
      Edge { label: Authored { name: ^False }, target: Node { kind: TypeNode { connective: Conj }, children: [], occurrence_id: OccurrenceSynthetic }, declaration: NotADeclaration }
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn lines_use_enum_copy_binding(lines: List<TargetSemanticDeclDecorationLine>) -> Bool {
  fold_list(
    xs: lines,
    empty: false,
    cons: fn(acc, line) {
      if acc {
        true
      } else {
        line.surface_binding == ^rust_decl_derive_enum_copy_binding
      }
    }
  )
}

test fn nullary_bool_uses_enum_copy_derive_binding() -> Bool {
  match semantic_decl_emission_from_target(target: rust_semantic_decl_target_model_staging()) {
    Accepted { value: emission, diagnostics: _ } =>
      match target_semantic_decl_coproduct_decoration_lines(
        projection: emission.surface,
        coproduct: bool_coproduct()
      ) {
        Accepted { value: lines, diagnostics: _ } =>
          !is_empty(xs: lines) && lines_use_enum_copy_binding(lines: lines)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}
