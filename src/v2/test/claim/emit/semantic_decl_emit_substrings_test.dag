module v2.test.emit.semantic_decl_emit_substrings_test

import std.occurrence_identity { OccurrenceSynthetic }
import v2.compiler.emit_semantic_decl { emit_semantic_type_decl }
import v2.extdeps.languages.rust_test { rust_semantic_decl_target_model_staging }
import extdeps.languages.rust.emit { rust_enum_derives_copy }
import v2.std.diagnostic { Accepted, Rejected, Outcome, None }
import v2.std.logic { Bool }
import v2.std.node { Conj, Disj, Edge, Named, Node, Symbol, TypeNode }
import v2.std.text { String }
import std.algebra { Empty }

fn sdr_empty_conj() -> Node {
  Node { kind: TypeNode { connective: Conj }, children: [], occurrence_id: OccurrenceSynthetic }
}

fn sdr_variant_edge(name: Symbol) -> Edge {
  Edge { label: Named { name: name }, target: sdr_empty_conj() }
}

fn semantic_bool_coproduct() -> Node {
  Node {
    kind: TypeNode { connective: Disj },
    children: [ sdr_variant_edge(name: ^True), sdr_variant_edge(name: ^False) ],
    occurrence_id: OccurrenceSynthetic
  }
}

data golden: String = concat(rust_enum_derives_copy, "\nenum Bool { True, False }")

test fn emit_eq_golden() -> Bool {
  match emit_semantic_type_decl(
    name: ^Bool,
    params: Empty,
    node: semantic_bool_coproduct(),
    target: rust_semantic_decl_target_model_staging()
  ) {
    Accepted { value: m, diagnostics: _ } => m.carried == golden
    Rejected { diagnostics: _ } => false
  }
}
