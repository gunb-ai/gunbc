module v2.test.emit.semantic_decl_emit_substrings_test


fn sdr_empty_conj() -> Node {
  v2.std.node.Node { kind: v2.std.node.TypeNode { connective: Conj }, children: [], occurrence_id: SyntheticOccurrence }
}

fn sdr_variant_edge(name: v2.std.node.Symbol) -> v2.std.node.Edge {
  v2.std.node.Edge { label: Named { name: name }, target: v2.test.emit.semantic_decl_emit_substrings_test.sdr_empty_conj() }
}

fn semantic_bool_coproduct() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Disj },
    children: [ v2.test.emit.semantic_decl_emit_substrings_test.sdr_variant_edge(name: ^True), v2.test.emit.semantic_decl_emit_substrings_test.sdr_variant_edge(name: ^False) ],
    occurrence_id: SyntheticOccurrence
  }
}

data golden: String = concat(extdeps.languages.rust.emit.rust_enum_derives_copy, "\nenum Bool { True, False }")

test fn emit_eq_golden() -> Bool {
  match emit_semantic_type_decl(
    name: ^Bool,
    params: std.algebra.Empty,
    node: v2.test.emit.semantic_decl_emit_substrings_test.semantic_bool_coproduct(),
    target: rust_target_model()
  ) {
    Accepted { value: m, diagnostics: _ } => m.carried == golden
    Rejected { diagnostics: _ } => false
  }
}
