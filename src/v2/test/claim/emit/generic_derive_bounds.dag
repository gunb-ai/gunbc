module v2.test.claim.emit.generic_derive_bounds

import v2.std.compilers.semantic_decl_emission { target_semantic_decl_no_documentation, ConformancesTargetDefault }
import std.types { List }
import std.occurrence_identity { OccurrenceSynthetic }
import v2.compiler.emit_semantic_decl { emit_semantic_type_decl }
import v2.extdeps.languages.rust { rust_target_model }
import std.algebra { Empty }
import v2.std.diagnostic { Accepted, None, Outcome, Rejected }
import v2.std.node { Atom, Conj, Disj, Edge, Authored, Node, Positional, Symbol, TypeNode, Instantiation, NotADeclaration }
import v2.std.compilers.target_model { target_carrier_free_monoid_node }
import v2.std.text { String }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node_query { binder_edge }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// RED for gunbc.recurring_failure_mode accepted_source_emits_uncompilable_target (generic derive
// bounds): a derive on a generic item whose field realizes as im::Vector<K> needs K: Clone on the
// DECLARATION (im 15.1.0 Debug/PartialEq/Serialize/Deserialize for Vector<A> are conditional on
// A: Clone; derive copies a declaration's bounds onto its impls). The expected spelling is the
// bound in the type-parameter list; the controls pin that a non-generic item is unchanged and a
// generic item whose field needs nothing gets no bound.

fn gdb_atom_type(name: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: name } }, children: [], occurrence_id: OccurrenceSynthetic }
}

fn gdb_list_of(name: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Instantiation },
    children: [
      Edge { label: Positional, target: target_carrier_free_monoid_node(), declaration: NotADeclaration },
      Edge { label: Positional, target: gdb_atom_type(name: name), declaration: NotADeclaration }
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn gdb_record(edges: List<Edge>) -> Node {
  Node { kind: TypeNode { connective: Conj }, children: edges, occurrence_id: OccurrenceSynthetic }
}

fn gdb_variant_edge(name: Symbol, payload: Node) -> Edge {
  Edge { label: Authored { name: name }, target: payload, declaration: NotADeclaration }
}

// enum Keys<K> { Complete, Missing { keys: List<K> } }
fn gdb_list_enum() -> Node {
  Node {
    kind: TypeNode { connective: Disj },
    children: [
      gdb_variant_edge(name: ^Complete, payload: gdb_record(edges: [])),
      gdb_variant_edge(name: ^Missing, payload: gdb_record(edges: [ binder_edge(name: ^keys, type_node: gdb_list_of(name: ^K)) ]))
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

// enum Plain<K> { Complete, Held { value: K } }
fn gdb_scalar_enum() -> Node {
  Node {
    kind: TypeNode { connective: Disj },
    children: [
      gdb_variant_edge(name: ^Complete, payload: gdb_record(edges: [])),
      gdb_variant_edge(name: ^Held, payload: gdb_record(edges: [ binder_edge(name: ^value, type_node: gdb_atom_type(name: ^K)) ]))
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

// enum Ints { Complete, Many { keys: List<Int> } }
fn gdb_nongeneric_enum() -> Node {
  Node {
    kind: TypeNode { connective: Disj },
    children: [
      gdb_variant_edge(name: ^Complete, payload: gdb_record(edges: [])),
      gdb_variant_edge(name: ^Many, payload: gdb_record(edges: [ binder_edge(name: ^keys, type_node: gdb_list_of(name: ^dag_binding_type_int)) ]))
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn gdb_emit_text(name: Symbol, params: List<Symbol>, node: Node) -> Outcome<String> {
  match emit_semantic_type_decl(header: [], documentation: target_semantic_decl_no_documentation(), conformances: ConformancesTargetDefault, imports: [], members: [], name: name, params: params, node: node, target: rust_target_model(), realization_host: rust_target_model()) {
    Accepted { value: medium, diagnostics: _ } => Accepted { value: medium.carried, diagnostics: None }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn gdb_text_has(name: Symbol, params: List<Symbol>, node: Node, pattern: String) -> Bool {
  match gdb_emit_text(name: name, params: params, node: node) {
    Accepted { value: text, diagnostics: _ } => string_contains(s: text, pattern: pattern)
    Rejected { diagnostics: _ } => false
  }
}

test fn generic_enum_over_list_param_carries_clone_bound() -> Bool {
  gdb_text_has(name: ^Keys, params: [^K], node: gdb_list_enum(), pattern: "enum Keys<K: Clone>")
}

test fn generic_enum_over_scalar_param_stays_bare() -> Bool {
  gdb_text_has(name: ^Plain, params: [^K], node: gdb_scalar_enum(), pattern: "enum Plain<K>")
    && !gdb_text_has(name: ^Plain, params: [^K], node: gdb_scalar_enum(), pattern: "K: Clone")
}

test fn nongeneric_enum_over_list_is_unchanged() -> Bool {
  gdb_text_has(name: ^Ints, params: Empty, node: gdb_nongeneric_enum(), pattern: "enum Ints {")
}

// Probe: the list-field emission is Accepted at all (a Rejected here, not the bound check, explains a failing control).
test fn list_field_enum_emission_is_accepted() -> Bool {
  match gdb_emit_text(name: ^Ints, params: Empty, node: gdb_nongeneric_enum()) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}
