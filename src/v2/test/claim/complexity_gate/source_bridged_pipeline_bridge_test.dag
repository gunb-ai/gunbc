module v2.test.complexity_gate.source_bridged_pipeline_bridge_test


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn source_bridged_bridge_test_loop_grammar_root() -> GrammarRoot {
  GrammarRoot {
    start: ^dag_production_fn_loop,
    productions: [dag_grammar_production_fn_loop()],
    sync_tokens: Set { member: fn(_) { false } }
  }
}

test fn source_bridged_pipeline_bridge_resolves_loop_source() -> Bool {
  match source_bridged_resolved_root(
    source_text: dag_loop_source_text,
    parse_root: source_bridged_bridge_test_loop_grammar_root(),
    production_name: ^dag_production_fn_loop,
    file: ^source_bridged_pipeline_bridge_test_file
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}
