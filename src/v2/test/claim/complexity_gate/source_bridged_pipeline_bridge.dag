module v2.test.complexity_gate.source_bridged_pipeline_bridge

import v2.compiler.normalize { normalize }
import v2.compiler.parse { ValidatedGrammarRoot, grammar_validate_for_parse, parse_production_tree }
import v2.compiler.resolve { resolve }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_language_model_wave1 }
import v2.std.collection { List }
import v2.std.compilers.lexing { Token, token_stream_all, token_stream_remaining }
import v2.std.diagnostic { Accepted, Outcome, Rejected, bind_outcome, port_locus }
import v2.std.grammar { GrammarRoot, ParseTree }
import v2.std.node { Node, Symbol }
import v2.std.text { String }

fn source_bridged_resolved_root(
  source_text: String,
  parse_root: GrammarRoot,
  production_name: Symbol,
  file: Symbol
) -> Outcome<Node> {
  let lm = dag_language_model_wave1()
  match grammar_validate_for_parse(
    root: parse_root,
    at: port_locus(port: ^source_bridged_pipeline_bridge_grammar_locus)
  ) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: validated, diagnostics: _ } =>
      bind_outcome(
        o: tokenize(text: source_text, file: file, rules: lm.lex),
        f: fn(token_stream) {
          bind_outcome(
            o: parse_production_tree(
              tokens: token_stream_remaining(stream: token_stream),
              validated: validated,
              production_name: production_name
            ),
            f: fn(parsed) {
              bind_outcome(
                o: normalize(parse_tree: parsed),
                f: fn(normalized) {
                  resolve(tree: normalized, lm: lm)
                }
              )
            }
          )
        }
      )
  }
}
