module v2.test.complexity_gate.source_bridged_pipeline_bridge

import v2.compiler.normalize { normalize }
import v2.compiler.parse { parse_module }
import v2.compiler.resolve { resolve }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_language_model }
import v2.std.diagnostic { Outcome, bind_outcome }
import v2.std.node { Node, Symbol }
import v2.std.text { String }

fn source_bridged_resolved_root(
  source_text: String,
  file: Symbol
) -> Outcome<Node> {
  let lm = dag_language_model()
  bind_outcome(
    o: tokenize(text: source_text, file: file, rules: lm.lex),
    f: fn(token_stream) {
      bind_outcome(
        o: parse_module(tokens: token_stream, grammar: lm.grammar),
        f: fn(artifact) {
          bind_outcome(
            o: normalize(parse_tree: artifact.tree),
            f: fn(normalized) {
              resolve(tree: normalized, lm: lm)
            }
          )
        }
      )
    }
  )
}
