module v2.test.complexity_gate.source_bridged_branch_subject_producer


fn source_bridged_branch_parse_root() -> GrammarRoot {
  GrammarRoot {
    start: ^dag_production_fn_pick,
    productions: [dag_grammar_production_fn_pick()],
    sync_tokens: Set {
      member: fn(_) {
        false
      }
    }
  }
}

fn source_bridged_branch_parse_tokens(tokens: List<Token>) -> Outcome<ParseTree> {
  let root = source_bridged_branch_parse_root()
  match grammar_validate_for_parse(root: root, at: port_locus(port: ^parse_stage_locus_port)) {
    Accepted { value: validated, diagnostics: _ } =>
      parse_production_tree(
        tokens: tokens,
        validated: validated,
        production_name: ^dag_production_fn_pick
      )
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn source_bridged_resolved_pick_arrow_from_text(source_text: String) -> Outcome<Node> {
  let lm = dag_language_model()
  bind_outcome(
    o: tokenize(
      text: source_text,
      file: ^source_bridged_branch_subject_source_file,
      rules: lm.lex
    ),
    f: fn(tokens) {
      bind_outcome(
        o: source_bridged_branch_parse_tokens(tokens: token_stream_remaining(stream: tokens)),
        f: fn(parsed) {
          bind_outcome(
            o: normalize(parse_tree: parsed),
            f: fn(normalized) {
              resolve(tree: normalized, lm: lm)
            }
          )
        }
      )
    }
  )
}

fn source_bridged_resolved_pick_arrow() -> Outcome<Node> {
  source_bridged_resolved_pick_arrow_from_text(source_text: dag_pick_source_text)
}

fn source_bridged_resolved_pick_false_arrow() -> Outcome<Node> {
  source_bridged_resolved_pick_arrow_from_text(source_text: dag_pick_false_source_text)
}

fn source_bridged_pick_if_arrow_with_body_from_resolved(
  resolved: Node
) -> Outcome<Node> {
  produce_pick_if_arrow_with_body_from_resolved(resolved_root: resolved)
}

fn source_bridged_pick_if_arrow_with_body() -> Outcome<Node> {
  bind_outcome(
    o: source_bridged_resolved_pick_arrow(),
    f: fn(resolved) {
      source_bridged_pick_if_arrow_with_body_from_resolved(resolved: resolved)
    }
  )
}

fn source_bridged_pick_false_if_arrow_with_body() -> Outcome<Node> {
  bind_outcome(
    o: source_bridged_resolved_pick_false_arrow(),
    f: fn(resolved) {
      source_bridged_pick_if_arrow_with_body_from_resolved(resolved: resolved)
    }
  )
}
