module v2.test.complexity_gate.source_bridged_branch_subject_producer

import v2.compiler.ingested_fixture_arrows {
  ingested_pick_if_arrow_with_body,
  ingested_pick_if_arrow_with_body_false_condition,
  ingested_pick_module_source,
  ingested_resolved_module_from_source
}
import v2.std.diagnostic { Outcome }
import v2.std.node { Node }

fn source_bridged_resolved_pick_arrow() -> Outcome<Node> {
  ingested_resolved_module_from_source(
    source: ingested_pick_module_source,
    file: ^source_bridged_branch_subject_source_file
  )
}

fn source_bridged_pick_if_arrow_with_body() -> Outcome<Node> {
  ingested_pick_if_arrow_with_body()
}

fn source_bridged_pick_false_if_arrow_with_body() -> Outcome<Node> {
  ingested_pick_if_arrow_with_body_false_condition()
}
