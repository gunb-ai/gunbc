module v2.test.complexity_gate.source_bridged_loop_budget


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn table_fixture_loop_cost_lens_holds(body: v2.std.node.Node) -> v2.std.logic.Bool {
  match cost_lens(n: body) {
    Holds { value: _ } => true
    _ => false
  }
}

fn table_fixture_loop_tightened_budget_fails_dominance(
  body: v2.std.node.Node,
  row: v2.test.complexity_gate.subject_complexity_budget_roster.LensSubjectComplexityBudgetRow
) -> v2.std.logic.Bool {
  let computed = complexity_lens(n: body)
  !complexity_bound_dominates(
    a: ConstantComplexity,
    b: computed
  )
  && complexity_bound_dominates(
    a: complexity_declared_budget_for_row(row: row, body: body),
    b: computed
  )
}

test fn table_fixture_loop_budget_claim_holds() -> v2.std.logic.Bool {
  let row = complexity_budget_row_table_fixture_loop
  match lens_subject_arrow_body_for_budget_row(row: row) {
    Accepted { value: body, diagnostics: _ } =>
      table_fixture_loop_cost_lens_holds(body: body)
        && table_fixture_loop_tightened_budget_fails_dominance(body: body, row: row)
    Rejected { diagnostics: _ } => false
  }
}
