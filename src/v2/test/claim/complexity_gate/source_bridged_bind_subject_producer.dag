module v2.test.complexity_gate.source_bridged_bind_subject_producer

import v2.extdeps.languages.dag {
  dag_bind_arrow_with_body_fixture,
  dag_bind_arrow_with_body_wrong_value_fixture
}
import v2.std.diagnostic { Outcome, outcome_accepted }
import v2.std.node { Node }

data source_bridged_bind_subject_producer_note: String = "Fast-lane subject producer: table fixture Arrows. Census ingest proofs live in ingested_fixture_arrows + long lane."

fn source_bridged_bind_arrow_with_body() -> Outcome<Node> {
  outcome_accepted(value: dag_bind_arrow_with_body_fixture)
}

fn source_bridged_bind_wrong_value_arrow_with_body() -> Outcome<Node> {
  outcome_accepted(value: dag_bind_arrow_with_body_wrong_value_fixture)
}
