module v2.test.complexity_gate.table_fixture_branch_subject_producer

import v2.extdeps.languages.dag {
  dag_pick_arrow_with_body_fixture,
  dag_pick_arrow_with_body_false_condition_fixture,
  dag_pick_arrow_with_body_swapped_arms_fixture
}
import v2.std.diagnostic { Outcome, outcome_accepted }
import v2.std.node { Node }

data table_fixture_branch_subject_producer_note: String = "Fast-lane subject producer: table fixture Arrows. Census ingest proofs live in ingested_fixture_arrows + long lane."

fn table_fixture_pick_if_arrow_with_body() -> Outcome<Node> {
  outcome_accepted(value: dag_pick_arrow_with_body_fixture)
}

fn table_fixture_pick_false_if_arrow_with_body() -> Outcome<Node> {
  outcome_accepted(value: dag_pick_arrow_with_body_false_condition_fixture)
}

fn table_fixture_pick_if_arrow_with_body_swapped_arms() -> Outcome<Node> {
  outcome_accepted(value: dag_pick_arrow_with_body_swapped_arms_fixture)
}
