module v2.test.complexity_gate.source_bridged_add_budget

import v2.lens.complexity {
  ConstantComplexity,
  complexity_bound_dominates,
  complexity_lens,
  linear_complexity
}
import v2.lens.cost { SizeVariable, cost_lens }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.witness { Holds }
import v2.test.complexity_gate.lens_subject_body_supply {
  lens_subject_arrow_body_for_budget_row
}
import v2.test.complexity_gate.subject_complexity_budget_roster {
  LensSubjectComplexityBudgetRow,
  complexity_budget_row_table_fixture_add,
  complexity_declared_budget_for_row
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn table_fixture_add_cost_lens_holds(body: Node) -> Bool {
  match cost_lens(n: body) {
    Holds { value: _ } => true
    _ => false
  }
}

fn table_fixture_add_tightened_budget_fails_dominance(
  body: Node,
  row: LensSubjectComplexityBudgetRow
) -> Bool {
  match complexity_lens(n: body) {
    Holds { value: computed } =>
      !complexity_bound_dominates(
        a: ConstantComplexity,
        b: linear_complexity(size_var: SizeVariable { source: body })
      )
      && complexity_bound_dominates(
        a: complexity_declared_budget_for_row(row: row, body: body),
        b: computed
      )
    _ => false
  }
}

test fn table_fixture_add_budget_claim_holds() -> Bool {
  let row = complexity_budget_row_table_fixture_add
  match lens_subject_arrow_body_for_budget_row(row: row) {
    Accepted { value: body, diagnostics: _ } =>
      table_fixture_add_cost_lens_holds(body: body)
        && table_fixture_add_tightened_budget_fails_dominance(body: body, row: row)
    Rejected { diagnostics: _ } => false
  }
}