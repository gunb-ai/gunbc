module v2.test.complexity_gate.table_fixture_add_subject_producer


data table_fixture_add_subject_producer_note: String = "Fast-lane subject producer: table fixture Arrow (dag_add_arrow_with_body_fixture). Census ingest proofs live in ingested_fixture_arrows + long/wave1_gate1_d_mvp_subsumption_witness_test.dag."

fn table_fixture_add_arrow_with_body() -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.outcome_accepted(value: v2.extdeps.languages.dag.dag_add_arrow_with_body_fixture)
}

fn table_fixture_add_arrow_with_body_swapped_operands() -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.outcome_accepted(value: v2.extdeps.languages.dag.dag_add_arrow_with_body_swapped_operands_fixture)
}

fn table_fixture_add_decl_node(fn_name: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: table_fixture_add_arrow_with_body(),
    f: fn(arrow_with_body) {
      v2.std.diagnostic.outcome_accepted(
        value: v2.std.node.node_synthetic(
          kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
          children: [
            v2.std.node.Edge {
              label: v2.std.node.Named { name: fn_name },
              target: arrow_with_body
            }
          ]
        )
      )
    }
  )
}
