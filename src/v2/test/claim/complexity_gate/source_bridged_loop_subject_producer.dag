module v2.test.complexity_gate.source_bridged_loop_subject_producer

import v2.compiler.body_producer { produce_loop_arrow_with_body_from_resolved }
import v2.compiler.normalize { normalize }
import v2.compiler.parse {
  grammar_validate_for_parse,
  parse_production_tree,
}
import v2.compiler.resolve { resolve }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag {
  dag_formal_production_fn_loop,
  dag_grammar_production_fn_loop,
  dag_language_model_wave1,
  dag_loop_source_text,
  dag_loop_wrong_value_source_text
}
import v2.std.collection { List, Set }
import v2.std.diagnostic { Accepted, Outcome, Rejected, bind_outcome, port_locus }
import v2.std.grammar { GrammarRoot, ParseTree }
import v2.std.compilers.lexing { Token, token_stream_remaining }
import v2.std.node { Node, Symbol }

fn source_bridged_loop_parse_root() -> GrammarRoot {
  GrammarRoot {
    start: ^dag_production_fn_loop,
    productions: [dag_grammar_production_fn_loop()],
    sync_tokens: Set {
      member: fn(_) {
        false
      }
    }
  }
}

fn source_bridged_loop_parse_tokens(tokens: List<Token>) -> Outcome<ParseTree> {
  let root = source_bridged_loop_parse_root()
  match grammar_validate_for_parse(root: root, at: port_locus(port: ^parse_stage_locus_port)) {
    Accepted { value: validated, diagnostics: _ } =>
      parse_production_tree(
        tokens: tokens,
        validated: validated,
        production_name: ^dag_production_fn_loop
      )
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn source_bridged_resolved_loop_arrow_from_text(source_text: String) -> Outcome<Node> {
  let lm = dag_language_model_wave1()
  bind_outcome(
    o: tokenize(
      text: source_text,
      file: ^source_bridged_loop_subject_source_file,
      rules: lm.lex
    ),
    f: fn(tokens) {
      bind_outcome(
        o: source_bridged_loop_parse_tokens(tokens: token_stream_remaining(stream: tokens)),
        f: fn(parsed) {
          bind_outcome(
            o: normalize(parse_tree: parsed),
            f: fn(normalized) {
              resolve(tree: normalized, lm: lm)
            }
          )
        }
      )
    }
  )
}

fn source_bridged_resolved_loop_arrow() -> Outcome<Node> {
  source_bridged_resolved_loop_arrow_from_text(source_text: dag_loop_source_text)
}

fn source_bridged_resolved_loop_wrong_value_arrow() -> Outcome<Node> {
  source_bridged_resolved_loop_arrow_from_text(source_text: dag_loop_wrong_value_source_text)
}

fn source_bridged_loop_arrow_with_body_from_resolved(
  resolved: Node
) -> Outcome<Node> {
  produce_loop_arrow_with_body_from_resolved(resolved_root: resolved)
}

fn source_bridged_loop_arrow_with_body() -> Outcome<Node> {
  bind_outcome(
    o: source_bridged_resolved_loop_arrow(),
    f: fn(resolved) {
      source_bridged_loop_arrow_with_body_from_resolved(resolved: resolved)
    }
  )
}

fn source_bridged_loop_wrong_value_arrow_with_body() -> Outcome<Node> {
  bind_outcome(
    o: source_bridged_resolved_loop_wrong_value_arrow(),
    f: fn(resolved) {
      source_bridged_loop_arrow_with_body_from_resolved(resolved: resolved)
    }
  )
}
