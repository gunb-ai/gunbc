module v2.test.complexity_gate.budget_roster_completeness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn complexity_declared_budget_is_rated(budget: v2.lens.complexity.ComplexityBound) -> Bool {
  match budget {
    v2.lens.complexity.UnknownComplexity { diagnostic: _ } => false
    _ => true
  }
}

data complexity_budget_row_unrated_declared_budget_semantic_red: v2.test.complexity_gate.subject_complexity_budget_roster.LensSubjectComplexityBudgetRow = v2.test.complexity_gate.subject_complexity_budget_roster.LensSubjectComplexityBudgetRow {
  subject_producer: v2.test.complexity_gate.table_fixture_add_subject_producer.table_fixture_add_arrow_with_body,
  declared_budget: fn(body) {
    v2.lens.complexity.unknown_complexity()
  }
}

fn complexity_budget_row_dominates(row: v2.test.complexity_gate.subject_complexity_budget_roster.LensSubjectComplexityBudgetRow) -> Bool {
  match v2.test.complexity_gate.lens_subject_body_supply.lens_subject_arrow_body_for_budget_row(row: row) {
    v2.std.diagnostic.Accepted { value: body, diagnostics: _ } =>
      let declared = v2.test.complexity_gate.subject_complexity_budget_roster.complexity_declared_budget_for_row(row: row, body: body)
      if !complexity_declared_budget_is_rated(budget: declared) {
        false
      } else {
        v2.lens.complexity.complexity_bound_dominates(
          a: declared,
          b: v2.lens.complexity.complexity_lens(n: body)
        )
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn complexity_budget_roster_family_all_rows_hold(rows: List<v2.test.complexity_gate.subject_complexity_budget_roster.LensSubjectComplexityBudgetRow>) -> Bool {
  v2.std.algebra.fold_list(
    xs: rows,
    empty: true,
    cons: fn(acc, row) {
      acc && complexity_budget_row_dominates(row: row)
    }
  )
}

test fn complexity_budget_roster_unrated_declared_budget_semantic_red_holds() -> Bool {
  !complexity_budget_roster_family_all_rows_hold(
    rows: v2.std.algebra.list_append(
      left: v2.test.complexity_gate.subject_complexity_budget_roster.complexity_subject_budget_rows,
      right: [complexity_budget_row_unrated_declared_budget_semantic_red]
    )
  )
}

test fn complexity_budget_roster_family_gate_holds() -> Bool {
  if v2.std.algebra.is_empty(xs: v2.test.complexity_gate.subject_complexity_budget_roster.complexity_subject_budget_rows) {
    false
  } else {
    complexity_budget_roster_family_all_rows_hold(rows: v2.test.complexity_gate.subject_complexity_budget_roster.complexity_subject_budget_rows)
      && complexity_budget_roster_unrated_declared_budget_semantic_red_holds()
  }
}
