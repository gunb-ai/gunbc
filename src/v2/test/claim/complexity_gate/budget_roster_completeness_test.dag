module v2.test.complexity_gate.budget_roster_completeness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn complexity_declared_budget_is_rated(budget: v2.lens.complexity.ComplexityBound) -> v2.std.logic.Bool {
  match budget {
    UnknownComplexity { diagnostic: _ } => false
    _ => true
  }
}

data complexity_budget_row_unrated_declared_budget_semantic_red: v2.test.complexity_gate.subject_complexity_budget_roster.LensSubjectComplexityBudgetRow = v2.test.complexity_gate.subject_complexity_budget_roster.LensSubjectComplexityBudgetRow {
  subject_producer: v2.test.complexity_gate.table_fixture_add_subject_producer.table_fixture_add_arrow_with_body,
  declared_budget: fn(body) {
    unknown_complexity()
  }
}

fn complexity_budget_row_dominates(row: v2.test.complexity_gate.subject_complexity_budget_roster.LensSubjectComplexityBudgetRow) -> v2.std.logic.Bool {
  match lens_subject_arrow_body_for_budget_row(row: row) {
    Accepted { value: body, diagnostics: _ } =>
      let declared = complexity_declared_budget_for_row(row: row, body: body)
      if !complexity_declared_budget_is_rated(budget: declared) {
        false
      } else {
        complexity_bound_dominates(
          a: declared,
          b: complexity_lens(n: body)
        )
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn complexity_budget_roster_family_all_rows_hold(rows: List<v2.test.complexity_gate.subject_complexity_budget_roster.LensSubjectComplexityBudgetRow>) -> v2.std.logic.Bool {
  fold_list(
    xs: rows,
    empty: true,
    cons: fn(acc, row) {
      acc && complexity_budget_row_dominates(row: row)
    }
  )
}

test fn complexity_budget_roster_unrated_declared_budget_semantic_red_holds() -> v2.std.logic.Bool {
  !complexity_budget_roster_family_all_rows_hold(
    rows: list_append(
      left: complexity_subject_budget_rows,
      right: [complexity_budget_row_unrated_declared_budget_semantic_red]
    )
  )
}

test fn complexity_budget_roster_family_gate_holds() -> v2.std.logic.Bool {
  if is_empty(xs: complexity_subject_budget_rows) {
    false
  } else {
    complexity_budget_roster_family_all_rows_hold(rows: complexity_subject_budget_rows)
      && complexity_budget_roster_unrated_declared_budget_semantic_red_holds()
  }
}
