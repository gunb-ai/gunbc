module v2.test.complexity_gate.subject_complexity_budget_roster


type LensSubjectComplexityBudgetRow {
  subject_producer: fn() -> Outcome<Node>
  declared_budget: fn(Node) -> ComplexityBound
}

fn complexity_declared_budget_for_row(
  row: LensSubjectComplexityBudgetRow,
  body: Node
) -> ComplexityBound {
  row.declared_budget(body: body)
}

fn complexity_declared_budget_constant(_body: Node) -> ComplexityBound {
  ConstantComplexity
}

fn complexity_declared_budget_loop_linear(body: Node) -> ComplexityBound {
  match loop_bound_witness_for_node(n: body) {
    Holds { value: bound } =>
      linear_complexity(
        size_var: SizeVariable { source: loop_bound_measure(bound: bound) }
      )
    Violates { diagnostic: _ } => unknown_complexity()
  }
}

data complexity_budget_row_table_fixture_add: LensSubjectComplexityBudgetRow = LensSubjectComplexityBudgetRow {
  subject_producer: table_fixture_add_arrow_with_body,
  declared_budget: complexity_declared_budget_constant
}

data complexity_budget_row_table_fixture_bind: LensSubjectComplexityBudgetRow = LensSubjectComplexityBudgetRow {
  subject_producer: table_fixture_bind_arrow_with_body,
  declared_budget: complexity_declared_budget_constant
}

data complexity_budget_row_table_fixture_branch: LensSubjectComplexityBudgetRow = LensSubjectComplexityBudgetRow {
  subject_producer: table_fixture_pick_if_arrow_with_body,
  declared_budget: complexity_declared_budget_constant
}

data complexity_budget_row_table_fixture_loop: LensSubjectComplexityBudgetRow = LensSubjectComplexityBudgetRow {
  subject_producer: table_fixture_loop_arrow_with_body,
  declared_budget: complexity_declared_budget_loop_linear
}

data complexity_subject_budget_rows: List<LensSubjectComplexityBudgetRow> = [
  complexity_budget_row_table_fixture_add,
  complexity_budget_row_table_fixture_bind,
  complexity_budget_row_table_fixture_branch,
  complexity_budget_row_table_fixture_loop
]
