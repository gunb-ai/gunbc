module v2.test.complexity_gate.subject_complexity_budget_roster


type LensSubjectComplexityBudgetRow {
  subject_producer: fn() -> v2.std.diagnostic.Outcome<v2.std.node.Node>
  declared_budget: fn(v2.std.node.Node) -> v2.lens.complexity.ComplexityBound
}

fn complexity_declared_budget_for_row(
  row: LensSubjectComplexityBudgetRow,
  body: v2.std.node.Node
) -> v2.lens.complexity.ComplexityBound {
  row.declared_budget(body: body)
}

fn complexity_declared_budget_constant(_body: v2.std.node.Node) -> v2.lens.complexity.ComplexityBound {
  v2.lens.complexity.ConstantComplexity
}

fn complexity_declared_budget_loop_linear(body: v2.std.node.Node) -> v2.lens.complexity.ComplexityBound {
  match v2.std.cardinality.loop_bound_witness_for_node(n: body) {
    v2.std.witness.Holds { value: bound } =>
      v2.lens.complexity.linear_complexity(
        size_var: v2.lens.cost.SizeVariable { source: v2.std.cardinality.loop_bound_measure(bound: bound) }
      )
    v2.std.witness.Violates { diagnostic: _ } => v2.lens.complexity.unknown_complexity()
  }
}

data complexity_budget_row_table_fixture_add: LensSubjectComplexityBudgetRow = LensSubjectComplexityBudgetRow {
  subject_producer: v2.test.complexity_gate.table_fixture_add_subject_producer.table_fixture_add_arrow_with_body,
  declared_budget: complexity_declared_budget_constant
}

data complexity_budget_row_table_fixture_bind: LensSubjectComplexityBudgetRow = LensSubjectComplexityBudgetRow {
  subject_producer: v2.test.complexity_gate.table_fixture_bind_subject_producer.table_fixture_bind_arrow_with_body,
  declared_budget: complexity_declared_budget_constant
}

data complexity_budget_row_table_fixture_branch: LensSubjectComplexityBudgetRow = LensSubjectComplexityBudgetRow {
  subject_producer: v2.test.complexity_gate.table_fixture_branch_subject_producer.table_fixture_pick_if_arrow_with_body,
  declared_budget: complexity_declared_budget_constant
}

data complexity_budget_row_table_fixture_loop: LensSubjectComplexityBudgetRow = LensSubjectComplexityBudgetRow {
  subject_producer: v2.test.complexity_gate.table_fixture_loop_subject_producer.table_fixture_loop_arrow_with_body,
  declared_budget: complexity_declared_budget_loop_linear
}

data complexity_subject_budget_rows: List<LensSubjectComplexityBudgetRow> = [
  complexity_budget_row_table_fixture_add,
  complexity_budget_row_table_fixture_bind,
  complexity_budget_row_table_fixture_branch,
  complexity_budget_row_table_fixture_loop
]
