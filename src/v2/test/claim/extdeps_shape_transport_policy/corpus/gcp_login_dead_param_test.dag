module v2.test.extdeps_shape_transport_policy.corpus.gcp_login_dead_param


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data gcp_login_service: String = "gcloud.Auth"
data gcp_login_operation: String = "Login"

test fn corpus_gcp_login_dead_param_defused_holds() -> Bool {
  extdeps_live_module_dead_param_count_for_operation(
    module: extdeps_gcp_module,
    service: gcp_login_service,
    operation: gcp_login_operation
  ) == 0
}
