module v2.test.extdeps_shape_transport_policy.corpus.gist_create_policy_leak


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn corpus_gist_create_defused_holds() -> Bool {
  extdeps_live_module_gist_create_declares_filename_input(
    module: extdeps_github_gists_module
  )
    && extdeps_live_module_gist_create_files_keyed_by_filename(
      module: extdeps_github_gists_module
    )
}
