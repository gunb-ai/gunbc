module v2.test.extdeps_shape_transport_policy.corpus.gist_create_policy_leak



data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn corpus_gist_create_defused_holds() -> Bool {
  v2.lens.extdeps_shape_transport_policy.extdeps_live_module_gist_create_declares_filename_input(
    module: v2.lens.extdeps_shape_transport_policy.module_refs.extdeps_github_gists_module
  )
    && v2.lens.extdeps_shape_transport_policy.extdeps_live_module_gist_create_files_keyed_by_filename(
      module: v2.lens.extdeps_shape_transport_policy.module_refs.extdeps_github_gists_module
    )
}
