module v2.test.extdeps_shape_transport_policy.corpus.cargo_doc_dead_param


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data cargo_doc_service: String = "cargo.Build"
data cargo_doc_operation: String = "Doc"

test fn corpus_cargo_doc_dead_param_defused_holds() -> Bool {
  extdeps_live_module_dead_param_count_for_operation(
    module: extdeps_cargo_build_module,
    service: cargo_doc_service,
    operation: cargo_doc_operation
  ) == 0
}
