test fn dead_param_cargo_clippy_is_red_holds() -> Bool {
  v2.lens.extdeps_shape_transport_policy.extdeps_shape_transport_policy_dead_param_count_for_operation(
    argv_facts: dead_param_cargo_clippy_argv_facts,
    input_facts: dead_param_cargo_clippy_input_facts,
    module: v2.lens.extdeps_shape_transport_policy.module_refs.extdeps_cargo_build_module,
    service: dead_param_cargo_clippy_service,
    operation: dead_param_cargo_clippy_operation
