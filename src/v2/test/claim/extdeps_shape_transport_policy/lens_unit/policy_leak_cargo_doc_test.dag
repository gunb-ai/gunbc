module v2.test.extdeps_shape_transport_policy.lens_unit.policy_leak_cargo_doc


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data policy_leak_cargo_doc_argv_facts: List<v2.lens.extdeps_shape_transport_policy.ExtdepsTransportArgvFact> = [
  v2.lens.extdeps_shape_transport_policy.ExtdepsTransportArgvFact {
    module: extdeps_cargo_build_module,
    service: "cargo.Build",
    operation: "Doc",
    transport_kind: Shell,
    argv_index: 2,
    argv_token: "--no-deps"
  }
]

data policy_leak_cargo_doc_fusion_facts: List<v2.lens.extdeps_shape_transport_policy.ExtdepsTransportFusionFact> = []

test fn policy_leak_cargo_doc_is_red_holds() -> Bool {
  extdeps_shape_transport_policy_violation_count(
    argv_facts: policy_leak_cargo_doc_argv_facts,
    fusion_facts: policy_leak_cargo_doc_fusion_facts
  ) == 1
}
