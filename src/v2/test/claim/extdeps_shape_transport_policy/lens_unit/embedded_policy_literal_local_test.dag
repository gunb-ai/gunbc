module v2.test.extdeps_shape_transport_policy.lens_unit.embedded_policy_literal_local


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data embedded_policy_local_data_name: String = "local_dev_runtime"
data embedded_policy_local_field_name: String = "fallback_auth_command"
data embedded_policy_local_literal: String = "gcloud auth print-access-token"

data embedded_policy_local_facts: List<ExtdepsEmbeddedPolicyLiteralFact> = [
  ExtdepsEmbeddedPolicyLiteralFact {
    module: extdeps_runtime_local_module,
    data_name: embedded_policy_local_data_name,
    field_name: embedded_policy_local_field_name,
    literal_value: embedded_policy_local_literal
  },
  ExtdepsEmbeddedPolicyLiteralFact {
    module: extdeps_runtime_local_module,
    data_name: embedded_policy_local_data_name,
    field_name: "adc_env_var",
    literal_value: "GOOGLE_APPLICATION_CREDENTIALS"
  }
]

test fn embedded_policy_literal_local_is_red_holds() -> Bool {
  extdeps_shape_transport_policy_embedded_policy_literal_count(
    facts: embedded_policy_local_facts
  ) == 1
}
