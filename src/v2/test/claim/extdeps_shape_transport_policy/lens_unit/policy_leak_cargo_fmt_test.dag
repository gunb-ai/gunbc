module v2.test.extdeps_shape_transport_policy.lens_unit.policy_leak_cargo_fmt


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data policy_leak_cargo_fmt_argv_facts: List<ExtdepsTransportArgvFact> = [
  ExtdepsTransportArgvFact {
    module: extdeps_cargo_build_module,
    service: "cargo.Build",
    operation: "Fmt",
    transport_kind: Shell,
    argv_index: 2,
    argv_token: "--all"
  },
  ExtdepsTransportArgvFact {
    module: extdeps_cargo_build_module,
    service: "cargo.Build",
    operation: "Fmt",
    transport_kind: Shell,
    argv_index: 3,
    argv_token: "--check"
  }
]

data policy_leak_cargo_fmt_fusion_facts: List<ExtdepsTransportFusionFact> = []

test fn policy_leak_cargo_fmt_is_red_holds() -> Bool {
  extdeps_shape_transport_policy_violation_count(
    argv_facts: policy_leak_cargo_fmt_argv_facts,
    fusion_facts: policy_leak_cargo_fmt_fusion_facts
  ) == 2
}
