module v2.test.extdeps_shape_transport_policy.lens_unit.transport_fusion_gcp_oauth



data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data transport_fusion_gcp_oauth_argv_facts: List<v2.lens.extdeps_shape_transport_policy.ExtdepsTransportArgvFact> = []

data transport_fusion_gcp_oauth_fusion_facts: List<v2.lens.extdeps_shape_transport_policy.ExtdepsTransportFusionFact> = [
  v2.lens.extdeps_shape_transport_policy.ExtdepsTransportFusionFact {
    module: v2.lens.extdeps_shape_transport_policy.module_refs.extdeps_gcp_module,
    endpoint_key: "oauth2:refresh",
    service_a: "oauth2.Google",
    service_b: "shell.OAuth2"
  }
]

test fn transport_fusion_gcp_oauth_is_red_holds() -> Bool {
  v2.lens.extdeps_shape_transport_policy.extdeps_shape_transport_policy_violation_count(
    argv_facts: transport_fusion_gcp_oauth_argv_facts,
    fusion_facts: transport_fusion_gcp_oauth_fusion_facts
  ) == 1
}
