fn roster_rejects_with(probe: GrainProbe, reason: Symbol) -> Bool {
  match probe {
    GrainStageRejected => false
    GrainTree { root: root } =>
      let inferred = InferredTree { root: root, facts: empty_map() }
      fold(always_required_root_lenses(), init: false, f: fn(acc, lens) {
        acc
          || match lens.gate(inferred) {
            Accepted { value: _, diagnostics: _ } => false
            Rejected { diagnostics: d } =>
              if d.head.reason == reason {
                true
              } else {
                fold(d.tail, init: false, f: fn(acc2, diag) { acc2 || diag.reason == reason })
              }
          }
      })
  }
}

test fn mandatory_tag_enrolled_in_root_roster_rejects_violating_module() -> Bool {
  roster_rejects_with(
    probe: parse_grain_tree(source: src_missing),
    reason: ^mandatory_tag_missing_required_decl
  )
}
