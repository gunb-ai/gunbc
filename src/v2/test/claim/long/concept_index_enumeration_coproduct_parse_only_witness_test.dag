  parse_only_concept_matches,
  fields_contains,
}
import v2.std.logic { Bool }

data concept_index_coproduct_parse_only_long_note: String = "LONG lane (operator 5s rule): witness_coproduct_arms_parse_only exceeded 6065ms thread-CPU on PR CI run 31017039134 (3850ms measured basis on srv_fleet_arm64, witness_row_cost_basis.tsv) — corpus-breadth cost scales with src/v2/test/claim pool size, not this witness's own source (docs/plans/witness-evidence-lifecycle-design.md). Enrolled on falsifier_substrate_long_lane_rows (nightly falsifier batch 6). Local recipe: claim_batch --source-root dag --source-root src/v2 --entry src/v2/test/claim/long/concept_index_enumeration_coproduct_parse_only_witness_test.dag --function witness_coproduct_arms_parse_only"

test fn witness_coproduct_arms_parse_only() -> Bool {
  parse_only_concept_matches(
    target_qn: "v2.test.claim.concept_index_enumeration.ConceptIndexWitnessCoproduct",
    short_name: "ConceptIndexWitnessCoproduct",
    field_count: 2,
    check: fn(fields) {
      fields_contains(fields: fields, fname: "NullaryArm", tname: "coproduct_nullary_payload")
        && fields_contains(
          fields: fields,
          fname: "NamedFieldArm",
          tname: "{ alpha: String, beta: Bool }"
        )
    }
  )
}
