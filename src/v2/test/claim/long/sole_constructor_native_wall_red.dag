import std.algebra { Cons, Empty, fold_list }
import v2.compiler.infer { infer }
import v2.compiler.name_resolve { Admission, ResolutionSubject }
import v2.compiler.program_assembly { assemble_program_from_ingest }
import v2.compiler.resolve { ResolvedTree }
import v2.compiler.self_host.closure_emission {
  ClosureEmissionLocated,
  ClosureMemberEmitted,
  ClosureMemberRefused,
  emit_closure_from_ingest_located
}
import v2.compiler.source_authority { DagSourceReadWitness, SourceRootIngest }
import v2.extdeps.languages.dag { dag_language_model }
import v2.extdeps.languages.rust { rust_target_model }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.cross_tree.import_model { V2Tree }
import std.types { List }
import v2.std.diagnostic { Accepted, Diagnostic, Outcome, Rejected, diagnostics_fatal_reason }
import v2.std.integer { Int }
import v2.std.logic { Bool }
import v2.std.node { Node, Symbol, node_synthetic }
import v2.std.qualified_name { qualified_name_from_dotted_string }
import v2.std.text { String }
import v2.workflow.realization_attempt {
  PhaseInfer,
  PhaseTranslate,
  V2RealizationRefused,
  V2TranslateSerialized,
  attempt_assembled
}

fn wall_peer_sealed_text() -> String {
  "module aca\n\ntype SealedRec sole_constructor { n: Int }\n\ntype SealedChoice sole_constructor\n  = SealedA { n: Int }\n  | SealedB { s: String }\n\nfn mint_rec(n: Int) -> SealedRec {\n  SealedRec { n: n }\n}\n\nfn read_rec(v: SealedRec) -> Int { v.n }\n"
}

fn wall_peer_open_text() -> String {
  "module aca\n\ntype SealedRec { n: Int }\n\ntype SealedChoice\n  = SealedA { n: Int }\n  | SealedB { s: String }\n\nfn mint_rec(n: Int) -> SealedRec {\n  SealedRec { n: n }\n}\n\nfn read_rec(v: SealedRec) -> Int { v.n }\n"
}

fn wall_subject_forge_literal_text() -> String {
  "module bcb\n\nimport aca { SealedRec }\n\nfn forged_lit() -> SealedRec { SealedRec { n: 999 } }\n"
}

fn wall_subject_forge_cast_text() -> String {
  "module bcb\n\nimport aca { SealedRec }\n\nfn forged_cast(x: Int) -> SealedRec { x as SealedRec }\n"
}

fn wall_subject_forge_variant_text() -> String {
  "module bcb\n\nimport aca { SealedChoice, SealedA }\n\nfn forged_variant() -> SealedChoice { SealedA { n: 999 } }\n"
}

fn wall_subject_forge_default_text() -> String {
  "module bcb\n\nimport aca { SealedRec }\n\nfn forged_default(p: SealedRec = SealedRec { n: 1 }) -> SealedRec { p }\n"
}

fn wall_subject_forge_all_text() -> String {
  "module bcb\n\nimport aca { SealedRec, SealedChoice, SealedA, mint_rec, read_rec }\n\nfn forged_lit() -> SealedRec { SealedRec { n: 999 } }\n\nfn forged_cast(x: Int) -> SealedRec { x as SealedRec }\n\nfn forged_variant() -> SealedChoice { SealedA { n: 999 } }\n\nfn forged_default(p: SealedRec = SealedRec { n: 1 }) -> SealedRec { p }\n\nfn consume(n: Int) -> Int {\n  read_rec(v: mint_rec(n: n))\n}\n"
}

fn wall_subject_consume_text() -> String {
  "module bcb\n\nimport aca { mint_rec, read_rec }\n\nfn consume(n: Int) -> Int {\n  read_rec(v: mint_rec(n: n))\n}\n"
}

fn wall_subject_match_inspect_text() -> String {
  "module bcb\n\nimport aca { SealedChoice, SealedA, SealedB }\n\nfn inspect(d: SealedChoice) -> Int {\n  match d {\n    SealedA { n: n } => n\n    SealedB { s: _ } => 0\n  }\n}\n"
}

fn wall_subject_match_and_forge_text() -> String {
  "module bcb\n\nimport aca { SealedChoice, SealedA, SealedB }\n\nfn inspect_and_forge(d: SealedChoice) -> SealedChoice {\n  match d {\n    SealedA { n: n } => d\n    SealedB { s: _ } => SealedA { n: 0 }\n  }\n}\n"
}

fn wall_peer_imported_open_emit_text() -> String {
  "module aca\n\ntype DupShape { n: Int }\n\nfn id(n: Int) -> Int { n }\n"
}

fn wall_subject_imported_open_emit_text() -> String {
  "module bcb\n\nimport aca { DupShape }\n\nfn own() -> DupShape { DupShape { n: 1 } }\n"
}

fn wall_peer_imported_open_variant_emit_text() -> String {
  "module aca\n\ntype ProcessExit\n  = ExitSuccess\n  | ExitFailure { code: Int }\n"
}

fn wall_subject_imported_open_variant_emit_text() -> String {
  "module bcb\n\nimport aca { ProcessExit, ExitFailure }\n\nfn own() -> ProcessExit { ExitFailure { code: 1 } }\n"
}

fn wall_peer_imported_sealed_variant_emit_text() -> String {
  "module aca\n\ntype ProcessExit sole_constructor\n  = ExitSuccess\n  | ExitFailure { code: Int }\n\nfn mint() -> ProcessExit { ExitFailure { code: 0 } }\n"
}

fn wall_subject_imported_sealed_variant_emit_text() -> String {
  "module bcb\n\nimport aca { ProcessExit, ExitFailure }\n\nfn forge() -> ProcessExit { ExitFailure { code: 999 } }\n"
}

fn wall_peer_imported_sealed_emit_text() -> String {
  "module aca\n\ntype DupShape sole_constructor { n: Int }\n\nfn mint() -> DupShape { DupShape { n: 0 } }\n"
}

fn wall_subject_imported_sealed_emit_text() -> String {
  "module bcb\n\nimport aca { DupShape }\n\nfn forge() -> DupShape { DupShape { n: 999 } }\n"
}

fn wall_peer_imported_open_text() -> String {
  "module aca\n\ntype DupShape { n: Int }\n"
}

fn wall_other_sealed_homonym_text() -> String {
  "module ccc\n\ntype DupShape sole_constructor { n: Int }\n"
}

fn wall_subject_imported_open_text() -> String {
  "module bcb\n\nimport aca { DupShape }\n\nfn own() -> DupShape { DupShape { n: 1 } }\n"
}

fn wall_peer_homonym_sealed_text() -> String {
  "module aca\n\ntype DupShape sole_constructor { n: Int }\n"
}

fn wall_subject_homonym_plain_own_text() -> String {
  "module bcb\n\ntype DupShape { n: Int }\n\nfn own() -> DupShape { DupShape { n: 1 } }\n"
}

fn wall_subject_homonym_plain_and_forge_text() -> String {
  "module bcb\n\nimport aca\n\ntype DupShape { n: Int }\n\nfn own() -> DupShape { DupShape { n: 1 } }\n\nfn forge() -> aca.DupShape { aca.DupShape { n: 999 } }\n"
}

data wall_subject_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^wall_sc_subject_artifact,
  file_path: "src/v2/pilot/sole_constructor_wall_subject.dag"
}

data wall_peer_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^wall_sc_peer_artifact,
  file_path: "src/v2/pilot/sole_constructor_wall_peer.dag"
}

data wall_other_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^wall_sc_other_artifact,
  file_path: "src/v2/pilot/sole_constructor_wall_other.dag"
}

fn wall_source(src: String, artifact: Artifact, cu: Symbol) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: src, fidelity: Lossless },
    artifact: artifact,
    compilation_unit: cu,
    source_root: V2Tree
  }
}

fn wall_assembled(subject_src: String, peer_src: String) -> Outcome<ResolvedTree> {
  assemble_program_from_ingest(
    ingest: Cons {
      head: wall_source(src: subject_src, artifact: wall_subject_artifact, cu: ^wall_sc_subject_cu),
      tail: [
        wall_source(src: peer_src, artifact: wall_peer_artifact, cu: ^wall_sc_peer_cu)
      ]
    },
    admission: Admission {
      subject: ResolutionSubject { name: Cons { head: ^bcb, tail: Empty } },
      imports: Empty
    },
    lm: dag_language_model()
  )
}

fn wall_assembled3(subject_src: String, peer_src: String, other_src: String) -> Outcome<ResolvedTree> {
  assemble_program_from_ingest(
    ingest: Cons {
      head: wall_source(src: subject_src, artifact: wall_subject_artifact, cu: ^wall_sc_subject_cu),
      tail: [
        wall_source(src: peer_src, artifact: wall_peer_artifact, cu: ^wall_sc_peer_cu),
        wall_source(src: other_src, artifact: wall_other_artifact, cu: ^wall_sc_other_cu)
      ]
    },
    admission: Admission {
      subject: ResolutionSubject { name: Cons { head: ^bcb, tail: Empty } },
      imports: Empty
    },
    lm: dag_language_model()
  )
}

fn wall_refusal_count(head: Diagnostic, tail: List<Diagnostic>) -> Int {
  fold_list(
    xs: tail,
    empty: if head.reason == ^infer_reason_sole_constructor_refused { 1 } else { 0 },
    cons: fn(n, d) { if d.reason == ^infer_reason_sole_constructor_refused { n + 1 } else { n } }
  )
}

fn wall_infer_refusal_count(assembled: Outcome<ResolvedTree>) -> Int {
  match assembled {
    Rejected { diagnostics: d } => wall_refusal_count(head: d.head, tail: d.tail)
    Accepted { value: rt, diagnostics: _ } =>
      match infer(tree: rt) {
        Rejected { diagnostics: d } => wall_refusal_count(head: d.head, tail: d.tail)
        Accepted { value: _, diagnostics: _ } => 0
      }
  }
}

fn wall_two_ingest(subject_src: String, peer_src: String) -> SourceRootIngest {
  Cons {
    head: wall_source(src: subject_src, artifact: wall_subject_artifact, cu: ^wall_sc_subject_cu),
    tail: [
      wall_source(src: peer_src, artifact: wall_peer_artifact, cu: ^wall_sc_peer_cu)
    ]
  }
}

fn wall_emit(entry: String, ingest: SourceRootIngest) -> ClosureEmissionLocated {
  emit_closure_from_ingest_located(
    ingest: ingest,
    entry: qualified_name_from_dotted_string(dotted: entry),
    entry_locus: node_synthetic(kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^wall_sc_emit_locus } }, children: []),
    target: rust_target_model()
  )
}

fn wall_emission_all_members_emitted(located: ClosureEmissionLocated) -> Bool {
  match located.outcome {
    Rejected { diagnostics: _ } => false
    Accepted { value: ce, diagnostics: _ } =>
      fold_list(xs: ce.modules, empty: true, cons: fn(ok, m) {
        if !ok {
          false
        } else {
          match m {
            ClosureMemberEmitted { module: _, text: _ } => true
            ClosureMemberRefused { module: _, diagnostics: _ } => false
          }
        }
      })
  }
}

fn wall_emission_has_reason(located: ClosureEmissionLocated, reason: Symbol) -> Bool {
  match located.outcome {
    Rejected { diagnostics: d } =>
      (d.head.reason == reason)
        || fold_list(xs: d.tail, empty: false, cons: fn(acc, x) { acc || (x.reason == reason) })
    Accepted { value: ce, diagnostics: _ } =>
      fold_list(xs: ce.modules, empty: false, cons: fn(acc, m) {
        if acc {
          true
        } else {
          match m {
            ClosureMemberEmitted { module: _, text: _ } => false
            ClosureMemberRefused { module: _, diagnostics: d } => diagnostics_fatal_reason(d: d) == reason
          }
        }
      })
  }
}

fn wall_infer_has_reason(assembled: Outcome<ResolvedTree>, reason: Symbol) -> Bool {
  match assembled {
    Rejected { diagnostics: d } =>
      (d.head.reason == reason)
        || fold_list(xs: d.tail, empty: false, cons: fn(acc, x) { acc || (x.reason == reason) })
    Accepted { value: rt, diagnostics: _ } =>
      match infer(tree: rt) {
        Rejected { diagnostics: d } =>
          (d.head.reason == reason)
            || fold_list(xs: d.tail, empty: false, cons: fn(acc, x) { acc || (x.reason == reason) })
        Accepted { value: _, diagnostics: _ } => false
      }
  }
}

test fn the_native_route_refuses_a_foreign_record_literal_holds() -> Bool {
  wall_infer_has_reason(
    assembled: wall_assembled(subject_src: wall_subject_forge_literal_text(), peer_src: wall_peer_sealed_text()),
    reason: ^infer_reason_sole_constructor_refused
  )
}

test fn the_native_route_refuses_a_foreign_cast_holds() -> Bool {
  wall_infer_refusal_count(
    assembled: wall_assembled(subject_src: wall_subject_forge_cast_text(), peer_src: wall_peer_sealed_text())
  ) >= 1
}

test fn the_native_route_refuses_a_foreign_variant_holds() -> Bool {
  wall_infer_refusal_count(
    assembled: wall_assembled(subject_src: wall_subject_forge_variant_text(), peer_src: wall_peer_sealed_text())
  ) >= 1
}

test fn the_native_route_refuses_a_foreign_parameter_default_holds() -> Bool {
  wall_infer_refusal_count(
    assembled: wall_assembled(subject_src: wall_subject_forge_default_text(), peer_src: wall_peer_sealed_text())
  ) >= 1
}

test fn the_native_route_admits_in_module_construction_and_foreign_consumption_holds() -> Bool {
  match wall_assembled(subject_src: wall_subject_consume_text(), peer_src: wall_peer_sealed_text()) {
    Rejected { diagnostics: _ } => false
    Accepted { value: rt, diagnostics: _ } =>
      match infer(tree: rt) {
        Rejected { diagnostics: _ } => false
        Accepted { value: _, diagnostics: _ } => true
      }
  }
}

test fn removing_the_modifier_clears_the_sole_constructor_refusals_holds() -> Bool {
  wall_infer_refusal_count(
    assembled: wall_assembled(subject_src: wall_subject_forge_all_text(), peer_src: wall_peer_open_text())
  ) == 0
}

test fn a_plain_homonym_may_construct_its_own_type_while_a_peer_seals_the_same_name_holds() -> Bool {
  match wall_assembled(subject_src: wall_subject_homonym_plain_own_text(), peer_src: wall_peer_homonym_sealed_text()) {
    Rejected { diagnostics: _ } => false
    Accepted { value: rt, diagnostics: _ } =>
      match infer(tree: rt) {
        Rejected { diagnostics: _ } => false
        Accepted { value: _, diagnostics: _ } => true
      }
  }
}

test fn a_foreign_construction_of_the_sealed_homonym_still_refuses_holds() -> Bool {
  wall_infer_has_reason(
    assembled: wall_assembled(subject_src: wall_subject_homonym_plain_and_forge_text(), peer_src: wall_peer_homonym_sealed_text()),
    reason: ^infer_reason_sole_constructor_refused
  )
}

test fn a_foreign_match_over_a_sealed_variant_is_not_construction_holds() -> Bool {
  match wall_assembled(subject_src: wall_subject_match_inspect_text(), peer_src: wall_peer_sealed_text()) {
    Rejected { diagnostics: _ } => false
    Accepted { value: rt, diagnostics: _ } =>
      match infer(tree: rt) {
        Rejected { diagnostics: _ } => false
        Accepted { value: _, diagnostics: _ } => true
      }
  }
}

test fn an_imported_unsealed_record_is_constructable_when_a_peer_seals_the_same_leaf_holds() -> Bool {
  match wall_assembled3(
    subject_src: wall_subject_imported_open_text(),
    peer_src: wall_peer_imported_open_text(),
    other_src: wall_other_sealed_homonym_text()
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: rt, diagnostics: _ } =>
      match infer(tree: rt) {
        Rejected { diagnostics: _ } => false
        Accepted { value: _, diagnostics: _ } => true
      }
  }
}

test fn constructing_a_sealed_variant_inside_a_foreign_match_arm_refuses_exactly_once_holds() -> Bool {
  wall_infer_refusal_count(
    assembled: wall_assembled(subject_src: wall_subject_match_and_forge_text(), peer_src: wall_peer_sealed_text())
  ) == 1
}

test fn attempt_joined_admits_in_module_construction_of_a_sealed_type_holds() -> Bool {
  match attempt_assembled(
    ingest: Cons {
      head: wall_source(src: wall_peer_sealed_text(), artifact: wall_peer_artifact, cu: ^wall_sc_peer_cu),
      tail: Empty
    },
    admission: Admission {
      subject: ResolutionSubject { name: Cons { head: ^aca, tail: Empty } },
      imports: Empty
    },
    fn_name: ^mint_rec,
    entry: "planted://wall_sc_home_mint"
  ).standing {
    V2TranslateSerialized { emitted_nonempty: _ } => true
    V2RealizationRefused { phase: p, exact_cause: _, located: _ } =>
      match p {
        PhaseTranslate => true
        _ => false
      }
  }
}

test fn attempt_joined_refuses_a_foreign_extracted_construction_holds() -> Bool {
  match attempt_assembled(
    ingest: wall_two_ingest(subject_src: wall_subject_forge_literal_text(), peer_src: wall_peer_sealed_text()),
    admission: Admission {
      subject: ResolutionSubject { name: Cons { head: ^bcb, tail: Empty } },
      imports: Empty
    },
    fn_name: ^forged_lit,
    entry: "planted://wall_sc_foreign_forge"
  ).standing {
    V2TranslateSerialized { emitted_nonempty: _ } => false
    V2RealizationRefused { phase: p, exact_cause: c, located: _ } =>
      match p {
        PhaseInfer => c == ^infer_reason_sole_constructor_refused
        _ => false
      }
  }
}

test fn closure_emission_admits_imported_unsealed_construction_holds() -> Bool {
  wall_emission_all_members_emitted(
    located: wall_emit(
      entry: "bcb",
      ingest: wall_two_ingest(subject_src: wall_subject_imported_open_emit_text(), peer_src: wall_peer_imported_open_emit_text())
    )
  )
}

test fn closure_emission_refuses_imported_sealed_construction_holds() -> Bool {
  wall_emission_has_reason(
    located: wall_emit(
      entry: "bcb",
      ingest: wall_two_ingest(subject_src: wall_subject_imported_sealed_emit_text(), peer_src: wall_peer_imported_sealed_emit_text())
    ),
    reason: ^infer_reason_sole_constructor_refused
  )
}

// NATIVE-ROUTE ALIAS CHASE (before: empty closure_declarations, infer_reason_sole_constructor_modifiers_unreadable
// or infer_reason_declaration_identity_unavailable on bcb's ExitFailure { code: 1 }; after: every member emits,
// because aca.ExitFailure chases to aca.ProcessExit.ExitFailure and the coproduct is unsealed).
test fn closure_emission_admits_imported_unsealed_variant_alias_holds() -> Bool {
  wall_emission_all_members_emitted(
    located: wall_emit(
      entry: "bcb",
      ingest: wall_two_ingest(subject_src: wall_subject_imported_open_variant_emit_text(), peer_src: wall_peer_imported_open_variant_emit_text())
    )
  )
}

test fn closure_emission_refuses_imported_sealed_variant_alias_holds() -> Bool {
  wall_emission_has_reason(
    located: wall_emit(
      entry: "bcb",
      ingest: wall_two_ingest(subject_src: wall_subject_imported_sealed_variant_emit_text(), peer_src: wall_peer_imported_sealed_variant_emit_text())
    ),
    reason: ^infer_reason_sole_constructor_refused
  )
}
