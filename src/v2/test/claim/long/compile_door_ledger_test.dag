module v2.test.long.compile_door_ledger

import v2.std.algebra { fold_list }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.text { String }
import v2.workflow.compile_door_ledger {
  DoorCompiled,
  DoorLedgerRow,
  DoorRefused,
  all_refused_causes_attributed,
  door_ledger,
  ledger_all_compiled,
  ledger_cause_count,
  ledger_refused_count
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data compile_door_ledger_witness_note: String = "PR-2 ledger receipt: the door_real_module_probe frontier receipts re-pinned THROUGH the AuditOnly ledger machinery — one typed counted row per subject path, shared module-graph census, per-row import closure fed into the door ingest, aggregated into the cause histogram (the burn-down list). Three REAL corpus modules over one affected set, each reaching the door's deep stages, produce three DISTINCT correctly-attributed causes post phase-2 flip: std.determinism reds at fact_density_hollow_alias_locus (calibration burn-down); std.error_primitives and std.bit both reds at resolve_reason_unbound_symbol (generics / shared self-host critical path). resolve_ambiguous_export zeroed by the NamespaceOnlyY default (subject admit_named_exports skip); std.bit's Nibble.bits / Byte.bits are position-distinct under containment projection."

data closure_feeding_frontier_note: String = "HONEST frontier finding (DESIGN 5, no fail-open receipt): the ledger's import-closure feeding is WIRED (door_ledger feeds import_closure into the door ingest) and structurally exercised — modules reach the door's deep resolve/infer/lens stages. std.bit now clears the migration-owned resolve_ambiguous_export cause and reds later at resolve_reason_unbound_symbol (generics), demonstrating the admission path reaches resolve beyond subject admission. A load-bearing closure-feeding receipt where a peer's exports decide the outcome remains staged for phase-3 import-as-reference migration."

data ledger_pool_roots: List<String> = ["dag", "src/v2"]

data affected_set_paths: List<String> = [
  "dag/std/determinism.dag",
  "dag/std/error_primitives.dag",
  "dag/std/bit.dag"
]

fn affected_rows() -> List<DoorLedgerRow> {
  door_ledger(paths: affected_set_paths, pool_roots: ledger_pool_roots)
}

test fn ledger_cause_histogram_over_mixed_affected_set() -> Bool {
  let rows = affected_rows()
  ledger_refused_count(rows: rows) == 3
    && ledger_all_compiled(rows: rows) == false
    && all_refused_causes_attributed(rows: rows) == true
    && ledger_cause_count(rows: rows, reason: ^fact_density_hollow_alias_locus) == 1
    && ledger_cause_count(rows: rows, reason: ^resolve_reason_unbound_symbol) == 2
    && ledger_cause_count(rows: rows, reason: ^resolve_ambiguous_export) == 0
}
