module v2.test.long.compile_door_ledger

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE REAL DOOR ROUTE, ONE SUBJECT, END TO END (advisories step 2, DESIGN section 3's witness rule).
// The mixed-set histogram this module used to pin over three real subjects is now a SUPPLIED-CHAIN
// claim at the ledger's own boundary: v2.test.claim.advisories.fatal_first_readers
// door_ledger_histogram_counts_each_refusals_fatal_holds supplies the three refusal chains those
// subjects produce and asserts the fatal-cause histogram (red when door_refused_row reads the head).
// The real run of all three, recorded on gunbc.recurring_failure_mode
// restoration_promise_names_a_route_that_does_not_exist with its head sha, found determinism at
// resolve_reason_unbound_symbol and error_primitives and bit at member_not_a_binder. This claim is
// that boundary's inhabitance pairing: the real door path (module graph facts, import closure,
// compile) reaches the ledger for one real subject, and the ROUTE is asserted -- the row is refused,
// at the subject's fatal cause, and that cause is owned. The former residue pin is gone: the ledger
// counts fatal causes, so an advisory head is never a row's reason.

data ledger_pool_roots: List<String> = ["dag", "src/v2"]

data single_subject_path: String = "dag/std/bit.dag"

fn single_subject_rows() -> List<DoorLedgerRow> {
  door_ledger(paths: [single_subject_path], pool_roots: ledger_pool_roots)
}

test fn real_door_route_refuses_one_subject_at_its_owned_fatal_cause() -> Bool {
  let rows = single_subject_rows()
  ledger_refused_count(rows: rows) == 1
    && all_refused_causes_attributed(rows: rows) == true
    && ledger_cause_count(rows: rows, reason: ^member_not_a_binder) == 1
}
