module v2.test.long.accumulator_copy_compile_gate

import std.occurrence_identity { OccurrenceSynthetic }
import std.algebra { Empty }
import v2.compiler.tokenize { tokenize }
import v2.compiler.parse { parse }
import v2.compiler.normalize { normalize }
import v2.compiler.compile {
  CompileLensRoot,
  required_lenses_at_grain,
  run_required_lens_gates
}
import v2.compiler.infer { infer }
import v2.extdeps.languages.dag { dag_language_model }
import v2.lens.complexity_accumulator_copy.compile_gate { accumulator_copy_compile_gate }
