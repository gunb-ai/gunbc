module v2.test.long.accumulator_copy_compile_gate


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data compile_gate_witness_note: String = "RED/GREEN controls for the accumulator-copy compile gate at its two consumption grains. Gate grain (normalize output — the tree shape the lens provably reads): the quadratic snippet REJECTS with accumulator_copy_poly2_suspect located at the finding node; the identity fold ACCEPTS clean; the unregistered-combiner-carrying-carrier snippet ACCEPTS with the refusal ledger attached (typed per-cause, counted, non-gating — the stopped-line audit channel). Door grain (validate_then_compile): the resolved add fixture passes through the root-required roster with empty caller lenses — proving the roster RUNS on every door call and passes clean trees. The end-to-end door RED (real module with imports through tokenize->resolve->infer->gate) rides the PR-2 CI transport stage whose red control ingests a real corpus module; an import-free snippet cannot pass resolve (proven by execution 2026-07-13), so the door-grain suspect red is homed there, not here."

data quad_snippet: String = "module quad\n\nfn f(xs: List<Int>) -> Int {\n  fold(xs, init: 0, f: fn(acc, x) { list_append(left: acc, right: x) })\n}\n"

data identity_snippet: String = "module ident\n\nfn f(xs: List<Int>) -> Int {\n  fold(xs, init: 0, f: fn(acc, x) { acc })\n}\n"

data unregistered_combiner_snippet: String = "module unreg\n\nfn f(xs: List<Int>) -> Int {\n  fold(xs, init: 0, f: fn(acc, x) { mystery_op(a: acc, b: x) })\n}\n"

type NormalizedProbe
  = ProbeStageRejected { stage: String }
  | ProbeNormalized { root: v2.std.node.Node }

fn normalized_of(source: String) -> NormalizedProbe {
  let lm = v2.extdeps.languages.dag.dag_language_model()
  match v2.compiler.tokenize.tokenize(text: source, file: ^compile_gate_witness_file, rules: lm.lex) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => ProbeStageRejected { stage: "tokenize" }
    v2.std.diagnostic.Accepted { value: stream, diagnostics: _ } =>
      match v2.compiler.parse.parse(tokens: stream, grammar: lm.grammar) {
        v2.std.diagnostic.Rejected { diagnostics: _ } => ProbeStageRejected { stage: "parse" }
        v2.std.diagnostic.Accepted { value: parse_tree, diagnostics: _ } =>
          match v2.compiler.normalize.normalize(parse_tree: parse_tree) {
            v2.std.diagnostic.Rejected { diagnostics: _ } => ProbeStageRejected { stage: "normalize" }
            v2.std.diagnostic.Accepted { value: normalized, diagnostics: _ } =>
              ProbeNormalized { root: normalized }
          }
      }
  }
}

fn non_empty_contains_reason(d: v2.std.diagnostic.NonEmptyDiagnostics, reason: v2.std.node.Symbol) -> Bool {
  if d.head.reason == reason {
    true
  } else {
    fold(d.tail, init: false, f: fn(acc, diag) {
      acc || (diag.reason == reason)
    })
  }
}

test fn gate_red_quadratic_rejects() -> Bool {
  match normalized_of(source: quad_snippet) {
    ProbeStageRejected { stage: _ } => false
    ProbeNormalized { root: root } =>
      match v2.lens.complexity_accumulator_copy.compile_gate.accumulator_copy_compile_gate(node: root) {
        v2.std.diagnostic.Rejected { diagnostics: d } =>
          non_empty_contains_reason(d: d, reason: ^accumulator_copy_poly2_suspect)
        v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
      }
  }
}

test fn gate_green_identity_accepts_clean() -> Bool {
  match normalized_of(source: identity_snippet) {
    ProbeStageRejected { stage: _ } => false
    ProbeNormalized { root: root } =>
      match v2.lens.complexity_accumulator_copy.compile_gate.accumulator_copy_compile_gate(node: root) {
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
        v2.std.diagnostic.Accepted { value: _, diagnostics: d } =>
          match d {
            v2.std.diagnostic.None => true
            v2.std.diagnostic.Some { diagnostics: _ } => false
          }
      }
  }
}

test fn gate_refusal_ledger_counted_not_gating() -> Bool {
  match normalized_of(source: unregistered_combiner_snippet) {
    ProbeStageRejected { stage: _ } => false
    ProbeNormalized { root: root } =>
      match v2.lens.complexity_accumulator_copy.compile_gate.accumulator_copy_compile_gate(node: root) {
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
        v2.std.diagnostic.Accepted { value: _, diagnostics: d } =>
          match d {
            v2.std.diagnostic.None => false
            v2.std.diagnostic.Some { diagnostics: ledger } =>
              non_empty_contains_reason(
                d: ledger,
                reason: ^combiner_unregistered_carrier_reaches
              )
          }
      }
  }
}

data compile_gate_target_stub: v2.std.compilers.target_model.TargetModel = v2.std.compilers.target_model.TargetModel {
  produced_decl_support: v2.std.compilers.target_model.ProducedDeclUnwired,
  bundle: v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
  },
  lex: v2.std.compilers.lexing.VoidLexRules,
  binding_spellings: v2.std.collection.empty_map(),
  token_class_emit_transforms: v2.std.compilers.target_model.target_model_emit_transforms_empty,
  authority_source_text: std.algebra.Empty,
  runtime_row: v2.std.host_transport.target_emit_host_runtime_row_unconfigured
}

test fn door_root_roster_runs_and_passes_clean_tree() -> Bool {
  match v2.compiler.compile.validate_then_compile(
    source: v2.test.manual.infer_ground_add.fixture_add_resolved_tree(),
    lenses: [],
    mode: v2.compiler.compile.TranslateTo { target: compile_gate_target_stub }
  ) {
    v2.std.diagnostic.Rejected { diagnostics: d } =>
      !non_empty_contains_reason(d: d, reason: ^accumulator_copy_poly2_suspect)
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
  }
}
