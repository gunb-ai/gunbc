import v2.test.manual.infer_ground_add { fixture_add_resolved_tree }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// RED/GREEN controls for the accumulator-copy compile gate at its two consumption grains. Gate
// grain (normalize output — the tree shape the lens provably reads): the quadratic snippet REJECTS
// with accumulator_copy_poly2_suspect located at the finding node; the identity fold ACCEPTS clean;
// the unregistered-combiner-carrying-carrier snippet ACCEPTS with the refusal ledger attached
// (typed per-cause, counted, non-gating — the stopped-line audit channel). Door grain
// (validate_then_compile): the resolved add fixture passes through the root-required roster with
// empty caller lenses — proving the roster RUNS on every door call and passes clean trees. The
// end-to-end door RED (real module with imports through tokenize->resolve->infer->gate) rides the
// PR-2 CI transport stage whose red control ingests a real corpus module; an import-free snippet
// cannot pass resolve (proven by execution 2026-07-13), so the door-grain suspect red is homed
// there, not here.

// THE PROBE SOURCES ARE CUT TO THE SMALLEST FORM THAT STILL DISCRIMINATES, and what survives is
// exactly the discriminator: the RED still copies the accumulator through list_append inside the
// fold, the GREEN is still its non-copying twin, and the ledger probe still calls a combiner no
// registry knows. Only the names shrank -- module names, the list binder, the lambda binders. No
// arm, no type annotation and no call shape was removed, because each of those is what the gate
// reads.
//
// WHAT THIS IS EXPECTED TO BUY, stated before the floor measures it so the prediction is falsifiable
// rather than fitted afterwards: the per-claim cost of these three is mostly FIXED. Two points from
// the earlier measurement -- 88 bytes at 534ms and 116 bytes at 618ms -- put the marginal cost near
// 3ms/byte and imply ~285ms paid before a single byte of snippet exists. These cuts remove 9, 10 and
// 19 bytes, so the predicted saving is tens of milliseconds against a row that needs 180. If the
// floor lands them clearly under 500ms, this model is wrong in the useful direction and the cost is
// superlinear in source size rather than fixed; if they land near 590, 505 and 625, the budget grain
// is the defect and not the sources. Either way the floor decides it, because claim_batch cannot
// measure this module at all -- it fails at the serve boundary described above.
data quad_snippet: String = "module q\n\nfn f(x: List<Int>) -> Int {\n  fold(x, init: 0, f: fn(a, i) { list_append(left: a, right: i) })\n}\n"

data identity_snippet: String = "module g\n\nfn f(x: List<Int>) -> Int {\n  fold(x, init: 0, f: fn(a, i) { a })\n}\n"

data unregistered_combiner_snippet: String = "module u\n\nfn f(x: List<Int>) -> Int {\n  fold(x, init: 0, f: fn(a, i) { m(a: a, b: i) })\n}\n"

type NormalizedProbe
  = ProbeStageRejected { stage: String }
  | ProbeNormalized { root: Node }

fn normalized_of(source: String) -> NormalizedProbe {
  let lm = dag_language_model()
  match tokenize(text: source, file: ^compile_gate_witness_file, rules: lm.lex) {
    Rejected { diagnostics: _ } => ProbeStageRejected { stage: "tokenize" }
    Accepted { value: stream, diagnostics: _ } =>
      match parse(tokens: stream, grammar: lm.grammar) {
        Rejected { diagnostics: _ } => ProbeStageRejected { stage: "parse" }
        Accepted { value: parse_tree, diagnostics: _ } =>
          match normalize(parse_tree: parse_tree) {
            Rejected { diagnostics: _ } => ProbeStageRejected { stage: "normalize" }
            Accepted { value: normalized, diagnostics: _ } =>
              ProbeNormalized { root: normalized }
          }
      }
  }
}

fn non_empty_contains_reason(d: NonEmptyDiagnostics, reason: Symbol) -> Bool {
  if d.head.reason == reason {
    true
  } else {
    fold(d.tail, init: false, f: fn(acc, diag) {
      acc || (diag.reason == reason)
    })
  }
}

// THE FRONT END IS THE PER-CLAIM COST HERE, AND THE SHARE THAT WOULD NET IT IS WITHDRAWN UNTIL THE
// SERVED VALUE SURVIVES CONSUMPTION. MEASURED (claim_batch over this module's four witnesses, one
// BuildBuddy dispatch, 2026-09-11): the three source-path rows cost 534-680ms of CPU against a 500ms
// per-claim ceiling, while door_root_roster_accepts_clean_inferred_tree -- same gate area, hand-built
// node fixture, no front end -- costs 50ms. Three DIFFERENT four-line snippets spread ~150ms over a
// ~530ms base, so the base is the front end itself and not the snippets, and the ledger row that
// trips first is only 80ms above its nearest sibling. Re-derive with that instrument.
//
// THE SHARE WAS TRIED AND IT NETTED THE COST EXACTLY AS INTENDED: enrolled WARM in
// v2.workflow.floor_pure_producer_share, the floor stored all three producers during strict
// preparation (disposition=Stored, 868ms, 496ms and 571ms of front end paid outside every per-claim
// budget), which is the diagnosis confirmed by execution rather than by argument.
//
// AND THEN ALL THREE CLAIMS FAILED ON THE SERVED VALUE: `no field 'kind' on type 'NormalizedTree'`,
// three witnesses that pass when each claim derives its own tree. That is the SAME error claim_batch
// reports for this module under its own preparation, which had read as an instrument quirk while the
// floor was green; the two observations together say it is not about the instrument but about a
// normalized tree produced OUTSIDE the frame that consumes it. Enrolling these rows therefore trades
// a budget refusal for three failing witnesses, which is strictly worse, so the rows are withdrawn
// and the producers below stay as plain helpers -- each claim calls one and derives its own tree,
// exactly as before.
//
// WHAT THE ROWS RETURN ON, stated as a capability rather than an artifact: a normalized tree that
// survives the cross-claim serve boundary, so that the value a claim is handed is the value it would
// have derived. Until then the per-claim front end stands, and the budget question it raises is a
// budget question rather than a witness question -- no witness here should be moved onto a fixture
// to buy it, because that trades what these witnesses prove.
fn quad_normalized() -> NormalizedProbe {
  normalized_of(source: quad_snippet)
}

fn identity_normalized() -> NormalizedProbe {
  normalized_of(source: identity_snippet)
}

fn unregistered_combiner_normalized() -> NormalizedProbe {
  normalized_of(source: unregistered_combiner_snippet)
}

test fn gate_red_quadratic_rejects() -> Bool {
  match quad_normalized() {
    ProbeStageRejected { stage: _ } => false
    ProbeNormalized { root: root } =>
      match accumulator_copy_compile_gate(node: root) {
        Rejected { diagnostics: d } =>
          non_empty_contains_reason(d: d, reason: ^accumulator_copy_poly2_suspect)
        Accepted { value: _, diagnostics: _ } => false
      }
  }
}

test fn gate_green_identity_accepts_clean() -> Bool {
  match identity_normalized() {
    ProbeStageRejected { stage: _ } => false
    ProbeNormalized { root: root } =>
      match accumulator_copy_compile_gate(node: root) {
        Rejected { diagnostics: _ } => false
        Accepted { value: _, diagnostics: d } =>
          match d {
            None => true
            Some { diagnostics: _ } => false
          }
      }
  }
}

test fn gate_refusal_ledger_counted_not_gating() -> Bool {
  match unregistered_combiner_normalized() {
    ProbeStageRejected { stage: _ } => false
    ProbeNormalized { root: root } =>
      match accumulator_copy_compile_gate(node: root) {
        Rejected { diagnostics: _ } => false
        Accepted { value: _, diagnostics: d } =>
          match d {
            None => false
            Some { diagnostics: ledger } =>
              non_empty_contains_reason(
                d: ledger,
                reason: ^combiner_unregistered_carrier_reaches
              )
          }
      }
  }
}

// WHAT THIS CONTROL DISCRIMINATES, AND WHY IT WAS RE-SCOPED. Its previous form called
// validate_then_compile and accepted EITHER an Accepted compile OR any Rejected whose diagnostics
// lacked the poly2 suspect. Measured: the door REFUSES this fixture, so the check was green on a
// refusal and would have stayed green if the root roster had stopped running altogether - a
// permanently-green check cited as coverage (DESIGN section 4b). The refusal is located, and it is
// neither infer nor the root roster: infer Accepts this fixture, the root-required roster Accepts
// the inferred tree, and the SUBTREE-grain roster refuses it. So the honest root-grain claim is
// this one - infer accepts and every root-registered gate accepts the real inferred tree, with no
// tolerance for an unrelated refusal - and the door-grain positive control (an Accepted
// validate_then_compile carrying its coverage receipt) is a declared frontier recorded in
// v2.test.lens_application.required_lens_coverage_join, triggered by a route that reaches Accepted
// through the door.
test fn door_root_roster_accepts_clean_inferred_tree() -> Bool {
  match infer(tree: fixture_add_resolved_tree()) {
    Rejected { diagnostics: _ } => false
    Accepted { value: inferred, diagnostics: _ } =>
      match run_required_lens_gates(
        inferred: inferred,
        lenses: required_lenses_at_grain(grain: CompileLensRoot)
      ) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
  }
}
