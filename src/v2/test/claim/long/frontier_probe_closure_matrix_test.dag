test fn frontier_probe_read_failure_detail_refused_holds() -> Bool {
  match frontier_probe_receipt_for_subject(
    subject: fp_matrix_read_failure_subject(),
    fixture_module_path: ""
  ).detail {
    SourceRefReadRefused { source_ref: _, error: _ } => true
    _ => false
  }
}

test fn frontier_probe_hash_mismatch_detail_carries_observed_holds() -> Bool {
  match frontier_probe_receipt_for_subject(
    subject: fp_matrix_hash_mismatch_subject(),
    fixture_module_path: ""
  ).detail {
    SourceRefContentHashMismatch { source_ref: _, expected: _, observed: _ } => true
    _ => false
  }
}

test fn frontier_probe_storage_hash_conflict_refused_holds() -> Bool {
  match frontier_probe_receipt_for_subject(
    subject: fp_matrix_storage_hash_conflict_subject(),
