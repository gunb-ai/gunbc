}

test fn frontier_probe_below_cap_complete_passes_population_gate_holds() -> Bool {
  match frontier_probe_receipt_for_subject(
    subject: fp_matrix_below_cap_complete_subject(),
    fixture_module_path: ""
  ) {
    FrontierProbeReceipt {
      located_stage: ProbeStageEmit,
      detail: FrontierProbeDetailAbsent,
      module_path: _,
      blocker_class: _,
      located_reason: _
    } => true
    _ => false
  }
}

test fn frontier_probe_elided_complete_refs_passes_population_gate_holds() -> Bool {
  match frontier_probe_receipt_for_subject(
