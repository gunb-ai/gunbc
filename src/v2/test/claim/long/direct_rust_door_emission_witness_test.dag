module v2.test.long.direct_rust_door_emission_witness

import v2.compiler.self_host.candidate_generation {
  generate_provenanced_rust_candidate_from_ingest,
  provenanced_rust_artifact_seed_independent
}
import v2.compiler.self_host.direct_rust_door_fixture {
  direct_rust_door_admission,
  direct_rust_door_expected_source,
  direct_rust_door_ingest,
  direct_rust_door_module_path,
  direct_rust_door_target_model
}
import v2.compiler.self_host.emitter_producer_provenance {
  emission_qualifications_list_contains,
  SourceProduced,
  V2EmitterInterpreted
}
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.text { String }

data direct_rust_door_emission_witness_long_note: String = "LONG lane (operator 5s rule): ingest-assemble-infer-emit provenance witness exceeds per-PR discovery budget (gunbc_ci_fast_lane_rule_note). Enrolled on falsifier_substrate_long_lane_rows (nightly falsifier batch 6). Local recipe: claim_batch --source-root dag --source-root src/v2 --entry src/v2/test/claim/long/direct_rust_door_emission_witness_test.dag --function witness_direct_rust_door_provenanced_artifact_holds"

test fn witness_direct_rust_door_provenanced_artifact_holds() -> Bool {
  match generate_provenanced_rust_candidate_from_ingest(
    ingest: direct_rust_door_ingest(),
    admission: direct_rust_door_admission(),
    target: direct_rust_door_target_model(),
    module_path: direct_rust_door_module_path
  ) {
    Accepted { value: artifact, diagnostics: _ } =>
      (artifact.source.carried == direct_rust_door_expected_source)
        && provenanced_rust_artifact_seed_independent(artifact: artifact)
        && (artifact.producer_receipt.producer == V2EmitterInterpreted)
        && emission_qualifications_list_contains(
          xs: artifact.producer_receipt.qualifications,
          wanted: SourceProduced
        )
    Rejected { diagnostics: _ } => false
  }
}
