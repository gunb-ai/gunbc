    ExpectedBinding { declaring: "std.declaring_identity_spelling.declaring_identity_spelling_resolved", occurrences: 1 },
    ExpectedBinding { declaring: "std.declaring_identity_spelling.declaring_identity_spelling_unresolvable", occurrences: 1 },
    ExpectedBinding { declaring: "std.declaring_identity_spelling.resolved_path_verdict", occurrences: 2 },
    ExpectedBinding { declaring: "std.live_tree.LiveTreeDisposition", occurrences: 1 },
    ExpectedBinding { declaring: "std.live_tree.SubstrateInputsOnly", occurrences: 1 },
    ExpectedBinding { declaring: "v2.std.qualified_name.QualifiedName", occurrences: 5 },
    ExpectedBinding { declaring: "v2.std.qualified_name.qualified_name_from_dotted_string", occurrences: 5 },
  ]
}

// The wrong-declaration arm for this subject: `v2.std.logic.Bool` is a real declaration with the same
// leaf as the `Bool` this module uses, reached through v2.std.logic's re-export of std.types.Bool.
// A wave that rebound a bare `Bool` to the re-export instead of the declaring home would look like this
// table holding; the resolution paths must refuse it. (tidy-ant-251: this shared-leaf shape is the one
// that discriminates binding to a re-export from binding to the declaring home; no identity leaf has a
// same-leaf twin at 345d6077fc4a, so a second arm per identity was not needed.)
// CORRECTION to that last clause, found by reading: one identity leaf DOES have a same-leaf twin at
// 345d6077fc4a -- IdentityAmbiguous is also a variant of RoadmapIdentityResolution in
// dag/gunbc/roadmap/roadmap_identity.dag:132 (module gunbc.roadmap.roadmap_identity), which does NOT
// import std.declaring_identity_spelling and so is outside wave 2's population. That twin is exactly the
// shape option (ii) was meant to probe, so the arm below carries it as a second row: a wave that inserted
// an import carrying the same leaf would re-point a bare IdentityAmbiguous to the roadmap variant, and the
// resolution paths must refuse that table. The two rows are the same arm, not two arms.
fn verdict_fold_wrong_table() -> List<ExpectedBinding> {
  [
    ExpectedBinding { declaring: "v2.std.logic.Bool", occurrences: 1 },
    ExpectedBinding { declaring: "gunbc.roadmap.roadmap_identity.IdentityAmbiguous", occurrences: 1 },
  ]
}

fn verdict_fold_paths() -> Optional<List<String>> {
  match native_test_context_from_ingest(ingest: verdict_fold_ingest()) {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: context, diagnostics: _ } =>
      match native_test_resolve_module(context: context, module: verdict_fold_subject()).resolved {
        Rejected { diagnostics: _ } => Absent
        Accepted { value: tree, diagnostics: _ } => Present { value: declaring_paths(tree: tree) }
      }
  }
}

// GREEN: every pinned declaring path is bound exactly as often as the table says.
// RED: the same paths refuse the wrong-declaration table, so the witness discriminates by declaration
// identity and not by leaf name. Absent (a refusal) fails the test, so a run reports the refusal
// rather than passing silently.
test fn wave2_verdict_fold_every_reference_binds_its_declaring_home_and_refuses_the_wrong_one_holds() -> Bool {
  match verdict_fold_paths() {
    Present { value: paths } =>
      table_holds(paths: paths, table: verdict_fold_table())
        && !table_holds(paths: paths, table: verdict_fold_wrong_table())
    Absent => false
  }
}

// THE REST OF THE POPULATION: files that mention `declaring_identity_spelling` but carry NO import row
// for it -- string literals, comments, field labels and layout/roster entries. Wave 2's edit is an edit
// to import rows and to unqualified heads; with no import row there is no edge for it to move, so these
// files carry no occurrence to witness. The test asserts the property that puts them outside the wave,
// read off the real bytes: no file in this list contains an import row for the wave-defining module.
data name_only_files: List<String> = [
  "artifacts/rung-drops/required_lanes_do_not_resolve_product_layer_modules_2026-09-20.txt",
  "dag/gunbc/compiler_frontend_program_status.dag",
  "dag/gunbc/source_layout_namespaces.dag",
  "dag/test/probe/declaring_identity_spelling_unresolvable_probe.dag",
  "src/v2/test/fixture/declaring_identity_spelling/call_only.dag",
  "src/v2/test/fixture/declaring_identity_spelling/cross_consumer.dag",
  "src/v2/test/fixture/declaring_identity_spelling/cross_provider.dag",
  "src/v2/test/fixture/declaring_identity_spelling/field_vs_parameter.dag",
  "src/v2/test/fixture/declaring_identity_spelling/matched_type_vs_value.dag",
  "src/v2/test/fixture/declaring_identity_spelling/shorter.dag",
  "src/v2/test/fixture/declaring_identity_spelling/value_outside_call.dag",
  "src/v2/workflow/floor_pure_producer_share.dag"
]

fn no_import_row_of(content: String) -> Bool {
  !string_contains(s: content, pattern: "import std.declaring_identity_spelling")
}

test fn wave2_name_only_files_carry_no_import_edge_for_the_wave_module_holds() -> Bool {
  fold_list(
    xs: name_only_files,
    empty: true,
    cons: fn(acc, path) {
      acc && no_import_row_of(content: Filesystem.Read(path: path).content)
    }
  )
}
