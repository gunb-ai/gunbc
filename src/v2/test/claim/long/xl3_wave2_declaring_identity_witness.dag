// The wrong-declaration arm for this subject: `v2.std.logic.Bool` is a real declaration with the same
// leaf as the `Bool` this module uses, reached through v2.std.logic's re-export of std.types.Bool.
// A wave that rebound a bare `Bool` to the re-export instead of the declaring home would look like this
// table holding; the resolution paths must refuse it. (tidy-ant-251: this shared-leaf shape is the one
// that discriminates binding to a re-export from binding to the declaring home; no identity leaf has a
// same-leaf twin at 345d6077fc4a, so a second arm per identity was not needed.)
// CORRECTION to that last clause, found by reading: one identity leaf DOES have a same-leaf twin at
// 345d6077fc4a -- IdentityAmbiguous is also a variant of RoadmapIdentityResolution in
// dag/gunbc/roadmap/roadmap_identity.dag:132 (module gunbc.roadmap.roadmap_identity), which does NOT
// import std.declaring_identity_spelling and so is outside wave 2's population. That twin is exactly the
// shape option (ii) was meant to probe, so the arm below carries it as a second row: a wave that inserted
// an import carrying the same leaf would re-point a bare IdentityAmbiguous to the roadmap variant, and the
// resolution paths must refuse that table. The two rows are the same arm, not two arms.
fn census_wrong_table() -> List<ExpectedBinding> {
  [
    ExpectedBinding { declaring: "v2.std.logic.Bool", occurrences: 1 },
    ExpectedBinding { declaring: "gunbc.roadmap.roadmap_identity.IdentityAmbiguous", occurrences: 2 },
  ]
}

fn census_paths() -> Optional<List<String>> {
  match native_test_context_from_ingest(ingest: census_ingest()) {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: context, diagnostics: _ } =>
      match native_test_resolve_module(context: context, module: census_subject()).resolved {
        Rejected { diagnostics: _ } => Absent
        Accepted { value: tree, diagnostics: _ } => Present { value: declaring_paths(tree: tree) }
      }
  }
}

// GREEN: every pinned declaring path is bound exactly as often as the table says.
// RED: the same paths refuse the wrong-declaration table, so the witness discriminates by declaration
// identity and not by leaf name. Absent (a refusal) fails the test, so a run reports the refusal
// rather than passing silently.
test fn wave2_census_every_reference_binds_its_declaring_home_and_refuses_the_wrong_one_holds() -> Bool {
  match census_paths() {
    Present { value: paths } =>
      table_holds(paths: paths, table: census_table())
        && !table_holds(paths: paths, table: census_wrong_table())
    Absent => false
  }
}

