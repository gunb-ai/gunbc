// The one named live integration for this module: a single call to v2.std.fn_index.fn_arrow_decl_facts_live()
// (a whole-tree scan) grounds every G2 roster-gate assertion below. Three tests used to each
// call it independently against the identical entry/facts/carrier_homes triple, paying the
// live scan three times for one fixed input — DESIGN §5 witness-cost-derives-from-purpose
// forbids a test claiming arbitrary computation merely because it is a test. Every other test
// in this module classifies over explicit fixture facts and never reaches this authority.
fn roster_gate_g2_live_classification() -> v2.std.live_read.LiveReadClassification {
  v2.lens.live_read_classification.live_read_classification_g2_from_facts(
    entry_module: "v2.test.claim.complexity.accumulator_copy_roster_gate",
    facts: roster_gate_corpus_facts,
    decls: v2.std.fn_index.fn_arrow_decl_facts_live(),
    carrier_homes: v2.std.live_read.live_read_carrier_homes_v0
  )
}

test fn g2_roster_gate_live_integration_holds() -> Bool {
  let c = roster_gate_g2_live_classification()
  v2.lens.live_read_classification.classification_has_filesystem_read_carrier(classification: c)
    && v2.lens.live_read_classification.classification_has_literal_path(
      classification: c,
      path: "src/v2/std/algebra.dag"
    )
    && v2.lens.live_read_classification.runtime_read_touched_by_path_g2(
      classification: c,
      touched_path: "src/v2/std/algebra.dag"
    )
    && v2.lens.live_read_classification.runtime_read_touched_by_path_g2(
      classification: c,
      touched_path: "src/v2/lens/complexity_accumulator_copy.dag"
    )
    && v2.lens.live_read_classification.g2_implies_reads_live_tree(classification: c)
    && v2.test.claim.complexity.accumulator_copy_roster_gate.accumulator_copy_roster_gate_entry_live_tree_disposition() == v2.std.live_tree.ReadsLiveTree
}

test fn g2_unknown_path_pattern_fail_closed_touched() -> Bool {
  let c = v2.lens.live_read_classification.live_read_classification_from_facts(
    entry_module: "fix.witness",
    facts: fixture_roster_gate_facts,
    carrier_homes: fixture_carriers
  )
  match c {
    RuntimeRead { carriers: carriers } =>
      v2.lens.live_read_classification.runtime_read_touched_by_path_g2(
        classification: c,
        touched_path: "dag/unrelated.dag"
      )
    LocalRead => false
  }
}


test fn g2_fn_arrow_marshal_host_scaffold_receipt_is_checkable() -> Bool {
  match v2.std.fn_index.fn_arrow_skeleton_g2_marshal_host_scaffold_dissolution_trigger {
    std.disposition.Scaffold { dissolves_to: _, bind: _ } => true
    std.disposition.Terminal { reason: _ } => false
  }
}

data live_read_selection_control_law: String = "WHY THESE THREE REPLACE THE UNION TEST. g2_union_retains_g1_import_carriers_with_g2_literal_paths asserted that a completed G2 answer keeps the G1 import carriers. That assertion could only ever pass because the union supplied them: this witness's own closure does not contain the carrier homes its fixture facts name, so v2.std.fn_index.fn_arrow_decl_facts_live() — entry-closure scoped — returns no declarations for them, and no reachable-invocation evidence for that subject exists in this context at all. Remove the union and the same subject silently answers LocalRead, which is UNDER-selection: the floor would skip a witness that reads the tree, and a skipped witness looks like a faster green floor rather than a failure. The union was therefore masking absent evidence, not carrying a real fact.

The three controls below separate the states the single union test conflated: evidence present and negative (local), evidence absent (refuse), evidence present and imprecise (conservative runtime read). Planted declarations supply the coverage the live entry-closure cannot, so complete-facts cases are reachable here rather than waiting on the whole-tree manifest."

fn selection_atom_node(lexeme: String) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: v2.std.compilers.lexing.symbol_intern_lexeme(lexeme: lexeme) } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn selection_body_node(callee: String) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [ v2.std.node.Edge { label: v2.std.node.Positional, target: selection_atom_node(lexeme: callee) } ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

data selection_control_facts: List<v2.lens.witness_cost_locality.ModuleImportFact> = [
  v2.lens.witness_cost_locality.ModuleImportFact {
    module: "synthetic.live_read_selection.entry",
    imports: [ "v2.compiler.self_host" ]
  },
  v2.lens.witness_cost_locality.ModuleImportFact { module: "v2.compiler.self_host", imports: [] }
]

fn selection_entry_seed_decl() -> v2.std.fn_index.FnArrowDecl {
  v2.std.fn_index.FnArrowDecl {
    qualified_name: "synthetic.live_read_selection.entry.seed",
    name: "seed",
    output: selection_body_node(callee: "carrier_fn"),
    params: []
  }
}

fn selection_carrier_home_decl(callee: String) -> v2.std.fn_index.FnArrowDecl {
  v2.std.fn_index.FnArrowDecl {
    qualified_name: "v2.compiler.self_host.carrier_fn",
    name: "carrier_fn",
    output: selection_body_node(callee: callee),
    params: []
  }
}

fn selection_projection_over(decls: List<v2.std.fn_index.FnArrowDecl>) -> v2.std.live_read.LiveReadSelectionProjection {
  v2.lens.live_read_classification.live_read_selection_projection_from_facts(
    entry_module: "synthetic.live_read_selection.entry",
    facts: selection_control_facts,
    decls: decls,
    carrier_homes: v2.std.live_read.live_read_carrier_homes_v0
  )
}

fn projection_is_refused(p: v2.std.live_read.LiveReadSelectionProjection) -> Bool {
  match p {
    v2.std.live_read.LiveReadSelectionRefused { cause: c } => !string_is_empty(s: c)
    v2.std.live_read.LiveReadSelectionClassified { classification: k } => v2.lens.live_read_classification.classification_is_local(classification: k) && false
  }
}

fn projection_classification_is_local(p: v2.std.live_read.LiveReadSelectionProjection) -> Bool {
  match p {
    v2.std.live_read.LiveReadSelectionRefused { cause: _ } => false
    v2.std.live_read.LiveReadSelectionClassified { classification: c } => v2.lens.live_read_classification.classification_is_local(classification: c)
  }
}

fn projection_classification_has_runtime_read(p: v2.std.live_read.LiveReadSelectionProjection) -> Bool {
  match p {
    v2.std.live_read.LiveReadSelectionRefused { cause: _ } => false
    v2.std.live_read.LiveReadSelectionClassified { classification: c } =>
      v2.lens.live_read_classification.classification_has_runtime_read(classification: c)
  }
}

test fn g2_complete_facts_reachable_home_without_carrier_call_is_local() -> Bool {
  projection_classification_is_local(
    p: selection_projection_over(
      decls: [
        selection_entry_seed_decl(),
        selection_carrier_home_decl(callee: "string_concat")
      ]
    )
  )
}



test fn g2_missing_carrier_home_facts_refuse_rather_than_local() -> Bool {
  projection_is_refused(p: selection_projection_over(decls: [ selection_entry_seed_decl() ]))
}

test fn g2_reachable_carrier_call_with_unknown_argument_is_runtime_read() -> Bool {
  projection_classification_has_runtime_read(
    p: selection_projection_over(
      decls: [
        selection_entry_seed_decl(),
        selection_carrier_home_decl(callee: "filesystem_read")
      ]
    )
  )
}
