module v2.test.claim.long.live_read_classification_test


data fixture_carriers: List<v2.std.live_read.LiveReadCarrierHome> = [
  v2.std.live_read.LiveReadCarrierHome { module: "fix.corpus_reader", kind: v2.std.live_read.DeclFactsReflectionCarrier },
  v2.std.live_read.LiveReadCarrierHome { module: "fix.roster_gate", kind: v2.std.live_read.FilesystemReadCarrier },
  v2.std.live_read.LiveReadCarrierHome { module: "fix.compile_scope", kind: v2.std.live_read.ModuleDeclarationFactsCarrier }
]

data fixture_unit_closure: List<String> = ["fix.entry", "fix.std_logic", "fix.std_text"]

data fixture_two_hop_closure: List<String> = ["fix.entry", "fix.mid", "fix.std_logic", "fix.corpus_reader"]

data fixture_roster_gate_closure: List<String> = ["fix.witness", "fix.roster_gate", "fix.std_logic"]

data fixture_scope_closure: List<String> = ["fix.lever_entry", "fix.compile_scope"]

data fixture_two_hop_facts: List<v2.lens.witness_cost_locality.ModuleImportFact> = [
  v2.lens.witness_cost_locality.ModuleImportFact { module: "fix.entry", imports: ["fix.mid", "fix.std_logic"] },
  v2.lens.witness_cost_locality.ModuleImportFact { module: "fix.mid", imports: ["fix.corpus_reader"] },
  v2.lens.witness_cost_locality.ModuleImportFact { module: "fix.corpus_reader", imports: [] }
]

data fixture_severed_facts: List<v2.lens.witness_cost_locality.ModuleImportFact> = [
  v2.lens.witness_cost_locality.ModuleImportFact { module: "fix.entry", imports: ["fix.mid", "fix.std_logic"] },
  v2.lens.witness_cost_locality.ModuleImportFact { module: "fix.mid", imports: [] },
  v2.lens.witness_cost_locality.ModuleImportFact { module: "fix.corpus_reader", imports: [] }
]

data fixture_roster_gate_facts: List<v2.lens.witness_cost_locality.ModuleImportFact> = [
  v2.lens.witness_cost_locality.ModuleImportFact { module: "fix.witness", imports: ["fix.roster_gate", "fix.std_logic"] },
  v2.lens.witness_cost_locality.ModuleImportFact { module: "fix.roster_gate", imports: [] }
]

data fixture_roster_gate_severed_facts: List<v2.lens.witness_cost_locality.ModuleImportFact> = [
  v2.lens.witness_cost_locality.ModuleImportFact { module: "fix.witness", imports: ["fix.std_logic"] },
  v2.lens.witness_cost_locality.ModuleImportFact { module: "fix.roster_gate", imports: [] }
]

data fixture_scope_facts: List<v2.lens.witness_cost_locality.ModuleImportFact> = [
  v2.lens.witness_cost_locality.ModuleImportFact { module: "fix.lever_entry", imports: ["fix.compile_scope"] },
  v2.lens.witness_cost_locality.ModuleImportFact { module: "fix.compile_scope", imports: [] }
]

fn verdict_of(closure: List<String>) -> v2.std.live_read.LiveReadClassification {
  v2.lens.live_read_classification.live_read_classification(closure_modules: closure, carrier_homes: fixture_carriers)
}

test fn unit_closure_is_local_read() -> Bool {
  v2.lens.live_read_classification.classification_is_local(classification: verdict_of(closure: fixture_unit_closure))
}

test fn two_hop_decl_facts_carrier_is_runtime_read() -> Bool {
  v2.lens.live_read_classification.classification_has_runtime_read(classification: verdict_of(closure: fixture_two_hop_closure))
    && v2.lens.live_read_classification.classification_has_corpus_scan_carrier(classification: verdict_of(closure: fixture_two_hop_closure))
}

test fn roster_gate_import_is_filesystem_runtime_read() -> Bool {
  v2.lens.live_read_classification.classification_has_filesystem_read_carrier(classification: verdict_of(closure: fixture_roster_gate_closure))
    && !v2.lens.live_read_classification.classification_has_corpus_scan_carrier(classification: verdict_of(closure: fixture_roster_gate_closure))
}

test fn compile_scope_import_is_corpus_scan_runtime_read() -> Bool {
  v2.lens.live_read_classification.classification_has_corpus_scan_carrier(classification: verdict_of(closure: fixture_scope_closure))
}

test fn two_hop_facts_classify_as_runtime_read() -> Bool {
  v2.lens.live_read_classification.classification_has_runtime_read(
    classification: v2.lens.live_read_classification.live_read_classification_from_facts(
      entry_module: "fix.entry",
      facts: fixture_two_hop_facts,
      carrier_homes: fixture_carriers
    )
  )
}

test fn severed_mid_hop_is_local_read() -> Bool {
  v2.lens.live_read_classification.classification_is_local(
    classification: v2.lens.live_read_classification.live_read_classification_from_facts(
      entry_module: "fix.entry",
      facts: fixture_severed_facts,
      carrier_homes: fixture_carriers
    )
  )
}

test fn roster_gate_facts_classify_filesystem_carrier() -> Bool {
  let c = v2.lens.live_read_classification.live_read_classification_from_facts(
    entry_module: "fix.witness",
    facts: fixture_roster_gate_facts,
    carrier_homes: fixture_carriers
  )
  v2.lens.live_read_classification.classification_has_filesystem_read_carrier(classification: c)
}

test fn red_control_roster_gate_severed_is_local() -> Bool {
  v2.lens.live_read_classification.classification_is_local(
    classification: v2.lens.live_read_classification.live_read_classification_from_facts(
      entry_module: "fix.witness",
      facts: fixture_roster_gate_severed_facts,
      carrier_homes: fixture_carriers
    )
  )
}

test fn scope_facts_classify_module_declaration_scan() -> Bool {
  v2.lens.live_read_classification.classification_has_corpus_scan_carrier(
    classification: v2.lens.live_read_classification.live_read_classification_from_facts(
      entry_module: "fix.lever_entry",
      facts: fixture_scope_facts,
      carrier_homes: fixture_carriers
    )
  )
}

test fn g1_runtime_read_touched_by_nonempty_path() -> Bool {
  v2.lens.live_read_classification.runtime_read_touched_by_path_g1(
    classification: verdict_of(closure: fixture_roster_gate_closure),
    touched_path: "dag/std/logic.dag"
  )
}

test fn g1_local_read_not_touched() -> Bool {
  !v2.lens.live_read_classification.runtime_read_touched_by_path_g1(
    classification: verdict_of(closure: fixture_unit_closure),
    touched_path: "dag/std/logic.dag"
  )
}

