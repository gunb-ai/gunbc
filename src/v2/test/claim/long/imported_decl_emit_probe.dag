// Enrolled RED/control for native emit of imported nullary coproduct arms.
// One shared producer. Does not import v2.compiler.compile.

module v2.test.claim.long.imported_decl_emit_probe

import extdeps.communication.medium { Lossless, Medium }
import std.algebra { Empty, FreeMonoid, fold_list, length, list_find_first, list_map, map_lookup, string_contains }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.optional { Absent, Optional, Present }
