fn probe_line(k: String, v: String) -> String {
  concat(concat(k, "="), concat(v, "\n"))
}

fn probe_yes_no(eq: Bool) -> String {
  if eq { "yes" } else { "no" }
}

fn probe_dump() -> String {
  match probe_bundle() {
    Absent => "PROBE_BUNDLE_ABSENT\n"
    Present { value: b } =>
      concat(
        probe_line(k: "emit_refusal_located", v: b.emit_refusal_located),
        concat(
          probe_line(k: "emit_b_reason", v: b.emit_b_reason),
          concat(
            probe_line(k: "emit_infer_reason", v: b.emit_infer_reason),
            concat(
              probe_line(k: "native_b_reason", v: b.native_b_reason),
              concat(
                probe_line(k: "emit_color_body", v: b.emit_color_body),
                concat(
                  probe_line(k: "native_color_body", v: b.native_color_body),
                  concat(
                    probe_line(k: "color_bodies_equal", v: probe_yes_no(eq: b.emit_color_body == b.native_color_body)),
                    concat(
                      probe_line(k: "emit_red_body", v: b.emit_red_body),
                      concat(
                        probe_line(k: "native_red_body", v: b.native_red_body),
                        concat(
                          probe_line(k: "red_bodies_equal", v: probe_yes_no(eq: b.emit_red_body == b.native_red_body)),
                          concat(
                            probe_line(k: "emit_red_declaring", v: b.emit_red_declaring),
                            concat(
                              probe_line(k: "native_red_declaring", v: b.native_red_declaring),
                              concat(
                                probe_line(k: "emit_red_declaring_raw", v: b.emit_red_declaring_raw),
                                probe_line(k: "native_red_declaring_raw", v: b.native_red_declaring_raw)
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
  }
}

fn probe_dump_cli() -> ProcessExit {
  ExitFailure { code: 1, reason: probe_dump() }
}
