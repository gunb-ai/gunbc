module v2.test.long.vacuity_consumer_witness

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = ReadsLiveTree

data vacuity_consumer_witness_long_lane_note: String = "Rehomed from src/v2/test/claim/vacuity_consumer_witness_test.dag to test/claim/long/ (operator 5-second rule, 2026-07-12; authority: gunbc_ci_fast_lane_witness_eval_budget in v2.workflow.ci_floor_plan; home mechanism: long_lane_exclusion_note in gunbc.ci_layer_roots) after CI run 30731820103 measured this file's four corpus-ingesting witnesses well over the 5000ms fast-lane budget (fixture_ingest_is_accepted_by_execution, derived_equals_classified_sites: 32423ms, shadows_reconcile_with_admitted_exceptions: 29754ms, real_test_fn_gap_stays_unknown_by_execution: 88996ms, measured locally). These four each drive a real tokenize/parse/normalize pass over the vacuity-owned fixture file per witness (vacuity_consumer_witness_live_derived_sites), which is genuine corpus-reading cost, not a fixture-shaped defect — so per long_lane_exclusion_note's HOME pattern (not a per-function SubstrateLongLaneRow exclusion) the file itself moves. The two fast, self-contained witnesses that do not call the corpus-ingest path (fixture_module_reached_by_direct_call: 6ms, pr7614_shape_red_control_classifies_proven_duplicate: 19ms) stay in the original per-PR-discovered file — splitting rather than moving the whole file keeps their fast-lane coverage from being lost. Local recipe: claim_batch --source-root dag --source-root src/v2 --entry src/v2/test/claim/long/vacuity_consumer_witness_long_test.dag --functions <csv>. Dissolve-on: same as long_lane_exclusion_note's own trigger — a per-witness declared cost envelope (witness-cost-locality admission law) subsumes the dir grain, or the corpus-ingest path this file drives amortizes under 5s on a measured run and the four witnesses re-enroll per-PR."

data vacuity_consumer_witness_note: String = "Binds lens_contract_vacuity.consumer_witness (mandate item 5) to vacuity_consumer_witness_real_test_fn_gap_stays_unknown_by_execution (fourth correction, review 46947, superseding the third correction from review 46930, which superseded the second correction from review 46910, which itself superseded the first correction from review 46886). Review 46886 first moved the binding off the hand-constructed RED control (it never executes corpus ingestion at all). Review 46910 then found the replacement (fixture_ingest_is_accepted_by_execution, still bound at that point) was too weak in a different way — that function proves only that the fixture file INGESTS, and separately found derived_equals_classified_sites was a tautology (classified_sites was a pure passthrough of derived_sites, literally `x == x`); the tautology was fixed in classified_sites (see vacuity_consumer_witness_classified_sites_tautology_fix_note) but the CONTRACT was rebound only to the ingest-only test, not to anything that calls the classifier. Review 46930 caught exactly that gap: `fixture_ingest_is_accepted_by_execution` never invokes classify_unified_test_claim_vacuity or validates its output, so a classifier regression could stay green under that binding. Rebound at that point to a witness that called classify_unified_test_claim_vacuity with a BoolWitnessClaim naming a real file and real function symbol and asserted the result equals Unknown — real corpus execution, not a hand-constructed record. Review 46947 then found THAT assertion still too weak: `== Unknown` is the identical output produced by an ingest Rejected, a missing fn declaration, and a genuinely-classified-but-inconclusive body (vacuity_bool_witness_evidence's three independent Unknown-producing branches), so the witness stayed green under total pipeline breakage, not only under honest fail-closed classification. Fixed per vacuity_consumer_witness_real_test_fn_gap_distinguishes_failure_note: the witness now separately asserts (1) ingest of the target file is Accepted, (2) the target fn symbol is genuinely Absent from real fn-decl lookup on that same parsed module (the actual, named reason, not a silently-assumed one), and (3) classification on the identical claim still returns exactly Unknown — so an ingest regression, a fn-decl-collection change, or a classifier bug that fabricated a non-Unknown result despite genuine Absent each independently RED this witness, honestly bounded by the documented corpus-wide fn-decl-collection ceiling (vacuity_consumer_witness_derived_sites_ceiling_note) that makes a genuinely non-Unknown real-corpus witness unconstructible today without fabrication. The join tests (derived_equals_classified_sites, shadows_reconcile_with_admitted_exceptions) stay enrolled as the mandate's four-set-difference identity check, honestly vacuous today (empty == empty, see the ceiling note) and are not the contract's bound witness — they check set membership, not classifier correctness, which is a narrower claim than what consumer_witness needs to substantiate. The file separately carries a genuine synthetic RED control shaped exactly like the PR #7614 defect (a LiveSurfaceSnapshot value compared against a LiteralOracle with no independent oracle) which MUST classify ProvenDuplicate through the real classify_vacuity_same_eval_record call, not a stand-in assertion — this proves the classifier MECHANISM is correct when reached on that shape specifically, complementary to the now-bound witness's proof that the classifier fails closed (Unknown) when reached on a real, currently-unparseable test fn. The same-eval fail-open (classify_vacuity_same_eval_record's deepest else branch) was already flagged by the lens's own W3 dissolution note in vacuity.dag — the mechanism knew about its own defect and carried the marker, and the defect survived anyway because nothing executed the lens (AuditOnly with NoConsumerWitness). A declared, marked, honestly-noted defect is still a live fail-open when no consumer runs the thing that would report it."

data vacuity_consumer_witness_join_note: String = "Correction (calm-badger-682 review, relayed): a hand-authored 'known ProvenDuplicate instances' list reconciled against a live scan by STRING label is the exact vacuity-class failure this lane exists to remove, recreated one level up. So this witness never hand-picks WHICH functions to classify: vacuity_consumer_witness_live_derived_sites() parses the one declared vacuity-owned fixture file and enumerates every fn decl found (vacuity_collect_fn_decls, the same corpus-reading fold v2.lens.vacuity's item-2 classifier uses) — the derived-site set IS whatever the parser finds, not a curated roster, so 'live derived sites == classified sites' holds by construction (every derived site is classified, nothing classified that was not derived) rather than by two lists kept in sync by hand. The substantive check is the second pair: vacuity_consumer_witness_live_shadows() (the derived sites whose evidence is ProvenDuplicate) reconciled against vacuity_consumer_witness_admitted_exceptions() (a small TYPED roster of VacuitySiteKey { file, function: Symbol } pairs, compared by Symbol/String structural equality — never a concatenated string label) via the same both-directions empty-diff shape v2.lens.inert_carrier.dag's count_not_in_roster/count_stale_roster already uses for roster-vs-live reconciliation, generalized from String names to typed VacuitySiteKey identity. A shadow with no admitted exception, or an admitted exception no longer observed as a shadow, is a nonempty diff — never silently absorbed. admitted_exceptions is empty today, not a placeholder: see vacuity_bool_witness_body_lowering_ceiling_note in v2.lens.vacuity — a bare top-level `==` fn body (the only shape classify_vacuity_same_eval_record's real-corpus path detects as ProvenDuplicate) does not survive normalize() under the current body-lowering implementation (confirmed by direct execution, on this branch and on a pristine origin/main checkout), so no real parseable site can honestly shadow as ProvenDuplicate yet; the fixture's fn instead uses a match-over-a-local-type body (the shape v2.std.nat's nat_cata already uses in the real corpus) to exercise derived-site enumeration and the join for real, and classifies Unknown, never a fabricated ProvenDuplicate. The empty-vs-empty reconciliation still holds by real execution, not vacuously skipped. classify_vacuity_same_eval_record's own ProvenDuplicate-detection correctness is proven independently by vacuity_consumer_witness_pr7614_shape_red_control_classifies_proven_duplicate (src/v2/test/claim/vacuity_consumer_witness_test.dag, kept fast-lane), a direct call bypassing the ingest pipeline — mechanism proven correct, real-corpus reachability separately ceilinged (DESIGN.md §4b), citing the SAME 'general body producer' open-thread trigger DESIGN.md already names, not a second one (§3 single authority)."

data vacuity_consumer_witness_scan_scope_note: String = "Scope is one declared, bounded, vacuity-owned file (dissolve-on: v2.extdeps.languages.dag's dag_language_model() grammar gains a `test` keyword/production, at which point real `test fn` declarations parse and this scan widens to the corpus discovery roster like cost_coverage/grammar_coverage do). vacuity_consumer_witness_real_test_fn_gap_stays_unknown_by_execution is a separate, direct receipt of that documented ceiling — it is not part of the derived-site/shadow join and carries no roster of its own."

fn vacuity_consumer_witness_scan_file() -> String {
  "src/v2/lens/vacuity_self_application_fixture.dag"
}

type VacuitySiteKey {
  file: String,
  function: v2.std.node.Symbol
}

fn vacuity_site_key_eq(a: VacuitySiteKey, b: VacuitySiteKey) -> Bool {
  (a.file == b.file) && (a.function == b.function)
}

fn vacuity_site_key_in(key: VacuitySiteKey, keys: List<VacuitySiteKey>) -> Bool {
  any(keys, fn(k) { vacuity_site_key_eq(a: k, b: key) })
}

fn vacuity_site_key_count_not_in(keys: List<VacuitySiteKey>, roster: List<VacuitySiteKey>) -> Int {
  fold_list(xs: keys, empty: 0, cons: fn(count, key) {
    if vacuity_site_key_in(key: key, keys: roster) { count } else { count + 1 }
  })
}

fn vacuity_consumer_witness_live_derived_sites() -> List<VacuitySiteKey> {
  let source_text = filesystem_read(path: vacuity_consumer_witness_scan_file()).content
  match vacuity_witness_ingest_source_text(
    source_text: source_text,
    file: vacuity_bool_witness_file_anchor
  ) {
    Rejected { diagnostics: _ } => std.algebra.Empty
    Accepted { value: module_root, diagnostics: _ } =>
      fold_list(
        xs: vacuity_collect_fn_decls(root: module_root.root, acc: std.algebra.Empty),
        empty: std.algebra.Empty,
        cons: fn(acc, fn_decl) {
          match vacuity_fn_decl_name_optional(fn_decl: fn_decl) {
            Absent => acc
            Present { value: name } =>
              list_append(
                left: acc,
                right: [VacuitySiteKey { file: vacuity_consumer_witness_scan_file(), function: name }]
              )
          }
        }
      )
  }
}

fn vacuity_consumer_witness_evidence_for_site(site: VacuitySiteKey) -> v2.lens.vacuity.VacuityEvidence {
  classify_unified_test_claim_vacuity(
    claim: v2.std.verification.BoolWitnessClaim { witness: v2.std.verification.BoolWitness { entry: site.file, function: site.function } },
    lhs_provenance: OperandProvenanceUnknown,
    rhs_provenance: OperandProvenanceUnknown,
    operand_provenance: OperandProvenanceUnknown
  )
}

data vacuity_consumer_witness_classified_sites_tautology_fix_note: String = "Corrected per review 46910: this fn used to read `vacuity_consumer_witness_live_derived_sites()` verbatim, making derived_equals_classified_sites literally `x == x` (classified WAS derived, by definition — a check that cannot fail regardless of what the ingest/classify pipeline does, the specification-without-execution shape DESIGN §5 forbids, applied to the consumer-witness slot). Fixed by threading every derived site through classify_unified_test_claim_vacuity (evidence_for_site) and only admitting a site whose classification actually returns a VacuityEvidence value — so this fn's result depends on classification genuinely running, not on re-stating derived_sites. The set membership still coincides with derived_sites under today's total classifier (no site is ever dropped), so the join remains honestly vacuous while derived_sites is empty (the fn-decl-collection ceiling, unchanged by this fix) — but it is no longer definitionally identical: a future regression that made classification skip or crash on a site would show up here, where the old alias could never have caught it."

fn vacuity_consumer_witness_classified_sites() -> List<VacuitySiteKey> {
  fold_list(
    xs: vacuity_consumer_witness_live_derived_sites(),
    empty: std.algebra.Empty,
    cons: fn(acc, site) {
      match vacuity_consumer_witness_evidence_for_site(site: site) {
        ProvenDuplicate => list_append(left: acc, right: [site])
        ProvenIndependent => list_append(left: acc, right: [site])
        Unknown => acc
      }
    }
  )
}

fn vacuity_consumer_witness_live_shadows() -> List<VacuitySiteKey> {
  fold_list(
    xs: vacuity_consumer_witness_classified_sites(),
    empty: std.algebra.Empty,
    cons: fn(acc, site) {
      if vacuity_evidence_eq(a: vacuity_consumer_witness_evidence_for_site(site: site), b: ProvenDuplicate) {
        list_append(left: acc, right: [site])
      } else {
        acc
      }
    }
  )
}

fn vacuity_consumer_witness_admitted_exceptions() -> List<VacuitySiteKey> {
  []
}

data vacuity_consumer_witness_derived_sites_ceiling_note: String = "vacuity_consumer_witness_derived_sites_nonempty_by_execution formerly asserted a nonempty derived-site list. BROADER, CORPUS-WIDE CEILING CONFIRMED BY DIRECT EXECUTION (this PR): fn-declaration collection via dag_node_is_fn_decl/parse_production_emitted_identity_optional over normalize() output returns EMPTY for real corpus files regardless of body shape — not only the narrower bare-`==`-body case vacuity_bool_witness_body_lowering_ceiling_note already documents. Verified by running v2.lens.vacuity's vacuity_collect_fn_decls AND src/v2/lens/enforcement/cost_coverage.dag's byte-identical cost_coverage_collect_fn_decls over the SAME successfully-parsed module_root (src/v2/std/nat.dag) in one execution: both returned empty. Independently re-confirmed by executing cost_coverage's own already-merged witnesses directly (cost_coverage_dag_logic_has_three_fn_bodies, cost_coverage_v2_tree_receipt_by_execution) — both FAIL by direct execution today, and the same failure reproduces on a pristine origin/main checkout (git worktree add against origin/main, same compiled claim_batch binary), so this is pre-existing corpus-wide, not introduced by this branch or specific to vacuity.dag. So a nonempty derived-site count is not honestly achievable via this ingest mechanism against ANY real file today; asserting it would be exactly the fabricated-plausible-output failure DESIGN.md §5 forbids. The replacement test below asserts what IS honestly true by execution — the fixture file parses (Accepted) and the derived-site list is legitimately empty, which is why the join reconciliation below holds vacuously (empty == empty) rather than skipped. Same DESIGN.md 'general body producer' open-thread trigger as the narrower ceiling — not a second one (§3)."

test fn vacuity_consumer_witness_fixture_ingest_is_accepted_by_execution() -> Bool {
  let source_text = filesystem_read(path: vacuity_consumer_witness_scan_file()).content
  match vacuity_witness_ingest_source_text(
    source_text: source_text,
    file: vacuity_bool_witness_file_anchor
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: _, diagnostics: _ } => true
  }
}

test fn vacuity_consumer_witness_derived_equals_classified_sites() -> Bool {
  let derived = vacuity_consumer_witness_live_derived_sites()
  let classified = vacuity_consumer_witness_classified_sites()
  (vacuity_site_key_count_not_in(keys: derived, roster: classified) == 0)
    && (vacuity_site_key_count_not_in(keys: classified, roster: derived) == 0)
}

test fn vacuity_consumer_witness_shadows_reconcile_with_admitted_exceptions() -> Bool {
  let shadows = vacuity_consumer_witness_live_shadows()
  let admitted = vacuity_consumer_witness_admitted_exceptions()
  (vacuity_site_key_count_not_in(keys: shadows, roster: admitted) == 0)
    && (vacuity_site_key_count_not_in(keys: admitted, roster: shadows) == 0)
}

data vacuity_consumer_witness_real_test_fn_gap_distinguishes_failure_note: String = "Correction (review 46947): the prior version of this witness asserted only classify_unified_test_claim_vacuity(...) == Unknown, which is the SAME output produced by an ingest Rejected, a missing fn declaration, AND a genuinely-classified-but-inconclusive body (vacuity_bool_witness_evidence's three independent Unknown-producing branches) — so the witness stayed green under a total pipeline breakage, not only under honest fail-closed classification, which is exactly the specification-without-execution failure DESIGN.md §5 forbids applied to this consumer-witness slot. Fixed by asserting the three facts separately rather than only their collapsed result: (1) real ingest of the target file succeeds (Accepted, not Rejected) — a corpus-discovery regression reds here; (2) the target fn symbol is genuinely Absent from vacuity_find_fn_decl_by_name over vacuity_collect_fn_decls on that SAME parsed module — the actual, named reason classification cannot proceed, not a silently-assumed one, and a future fn-decl-collection fix that made this Present would red here rather than being masked; (3) classify_unified_test_claim_vacuity on the identical BoolWitnessClaim still returns exactly Unknown — a classifier bug that fabricated ProvenDuplicate/ProvenIndependent despite genuine Absent reds here. A witness reaching a genuinely non-Unknown real-corpus classification (the reviewer's most literal ask) is not honestly constructible today: vacuity_bool_witness_fn_decl_collection_ceiling_note documents, by direct execution on this branch AND a pristine origin/main checkout, that fn-declaration collection returns empty for every real corpus file regardless of body shape — so no real file/function pair exists today for which the classifier can honestly reach its body-evidence path at all. Asserting a non-Unknown result would itself be the fabricated-plausible-output failure DESIGN.md §5 forbids. This three-part shape is the strongest honest witness available at the current ceiling for the BoolWitnessClaim path specifically: it fails (reds) under every one of ingest regression, fn-decl-collection change, and classifier misbehavior on that path, and only stays green when all three hold exactly as documented."

data vacuity_consumer_witness_constant_unknown_collapse_control_note: String = "Correction (review 47124): the three-part shape above still could not distinguish a genuinely working classifier from classify_unified_test_claim_vacuity being replaced wholesale with a function that unconditionally returns Unknown — every one of its three assertions is equally satisfied by that degenerate collapse, because the ONLY path this witness drove through the dispatcher was the Absent-fn arm, whose real behavior IS Unknown. A collapsed constant-Unknown dispatcher is indistinguishable from the honest one along that single path. Fixed by adding a fourth, independent assertion that drives the SAME public dispatcher (classify_unified_test_claim_vacuity — not a different function, and not a bypass of it) through its NodeCorpus{EqualsClaim} arm with lhs_provenance: LiveSurfaceSnapshot / rhs_provenance: LiteralOracle — the PR #7614 shape, which classify_vacuity_same_eval_record's vacuity_same_eval_is_live_snapshot_duplicate branch classifies ProvenDuplicate by construction, independent of the operand Node values themselves (that branch is reached before operands_structurally_equal is ever consulted). This does not reintroduce the fabrication DESIGN.md §5 forbids: the record shape here is intentionally synthetic (a hand-built claim reaching a known dispatcher branch), the same license already exercised by the pre-existing PR7614 RED control (vacuity_consumer_witness_pr7614_shape_red_control_classifies_proven_duplicate, src/v2/test/claim/vacuity_consumer_witness_test.dag, kept fast-lane) — the difference is that control calls classify_vacuity_same_eval_record directly, bypassing classify_unified_test_claim_vacuity's own dispatch, so it never previously proved the DISPATCHER (the thing the contract actually binds to) does anything but return Unknown. With this fourth assertion ANDed into the same bound witness, a wholesale collapse of classify_unified_test_claim_vacuity to `_ => Unknown` now reds here (ProvenDuplicate != Unknown), so the witness is no longer indistinguishable from that degenerate case. Paired with vacuity_consumer_witness_classified_sites no longer appending Unknown-classified sites unconditionally (review 47124's second finding, fixed at its own definition site) so the derived/classified set check is no longer invariant to classifier output either."

fn vacuity_consumer_witness_synthetic_equals_operand() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

test fn vacuity_consumer_witness_real_test_fn_gap_stays_unknown_by_execution() -> Bool {
  let target_file = vacuity_consumer_witness_scan_file()
  let target_fn = ^vacuity_consumer_witness_nonexistent_probe_target
  let source_text = filesystem_read(path: target_file).content
  let absent_fn_path_holds = match vacuity_witness_ingest_source_text(
    source_text: source_text,
    file: vacuity_bool_witness_file_anchor
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: module_root, diagnostics: _ } =>
      let fn_lookup = vacuity_find_fn_decl_by_name(
        decls: vacuity_collect_fn_decls(root: module_root.root, acc: std.algebra.Empty),
        name: target_fn
      )
      let fn_genuinely_absent = match fn_lookup {
        Absent => true
        Present { value: _ } => false
      }
      let classified = classify_unified_test_claim_vacuity(
        claim: v2.std.verification.BoolWitnessClaim { witness: v2.std.verification.BoolWitness { entry: target_file, function: target_fn } },
        lhs_provenance: OperandProvenanceUnknown,
        rhs_provenance: OperandProvenanceUnknown,
        operand_provenance: OperandProvenanceUnknown
      )
      fn_genuinely_absent && vacuity_evidence_eq(a: classified, b: Unknown)
  }
  let operand = vacuity_consumer_witness_synthetic_equals_operand()
  let dispatcher_reaches_proven_duplicate = vacuity_evidence_eq(
    a: classify_unified_test_claim_vacuity(
      claim: v2.std.verification.NodeCorpus {
        claim: v2.std.verification.EqualsClaim {
          label: "vacuity_consumer_witness: dispatcher reaches ProvenDuplicate via NodeCorpus, not just Unknown",
          anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
          lhs: operand,
          rhs: operand,
          classification: v2.std.verification.TestClassification { tier: Tier1, layer: v2.std.verification.Unit }
        },
        transport: EvalOnly
      },
      lhs_provenance: LiveSurfaceSnapshot,
      rhs_provenance: LiteralOracle,
      operand_provenance: OperandProvenanceUnknown
    ),
    b: ProvenDuplicate
  )
  absent_fn_path_holds && dispatcher_reaches_proven_duplicate
}
