module v2.test.long.production_qualification_origin_probe_witness

import v2.lens.production_qualification_origin_probe {
  derived_production_qualification_mint_sites_live,
  ingest_mint_surface_discovered_in_live_scope,
  known_fixture_origin_mint_surface_count_in_scope,
  production_qualification_origin_probe_admission_holds,
  structural_red_control_live_fixture_mint_site_discovered
}
import v2.test.claim.self_host.production_qualification_origin_probe_structural_fixture {
  structural_red_control_mint_site_qualified_name
}
import v2.std.algebra { any }
import v2.std.logic { Bool }
import v2.std.text { String }

// THE SUBJECT IS THE SELF-HOST ROOTS THIS PROBE ACTUALLY RANGES OVER. Every row in this file asks
// about mint surfaces in the self-host candidate-generation path and about the planted fixture
// beside it, both of which live under these two roots. Naming witness_layer_roots was measured
// exceeding the floor's cpu budget on all five rows, which returns NO VERDICT rather than a wider
// answer -- and for the four admitted-RED rows an undecided row is strictly worse than a red one,
// because an expecting-red roster entry that never decides stops discriminating anything.
//
// THIS NARROWS NOTHING THAT WAS BEING CHECKED. Until gunbc#10245 these rows answered from this
// witness's own resolved import closure, which is why their admitted-RED reasons speak of what is
// "discoverable in the entry closure"; the roots below make that scope declared instead of
// incidental. The blocker those rows wait on is unchanged and is the G2 marshal, not the subject.
data origin_probe_subject_roots: List<String> = []

// FILE GRAIN, BECAUSE THE SUBJECT IS TWO MODULES AND THE SMALLEST DIRECTORIES HOLDING THEM ARE 63
// FILES. Measured: those two directories cost 543ms against a 500ms line, and these two files cost
// about 25ms. candidate_generation carries the ingest mint site the probe looks for; the fixture
// carries the planted FixtureDerived row the structural control names.
data origin_probe_subject_files: List<String> = [
  "src/v2/compiler/self_host/candidate_generation.dag",
  "src/v2/test/claim/self_host/production_qualification_origin_probe_structural_fixture.dag"
]

data production_qualification_origin_probe_long_witness_note: String = "LONG lane (operator 5s rule): witnesses that walk fn_arrow_decl_facts_live or derived_production_qualification_mint_sites_live over their declared subject roots exceed per-PR discovery budget. GREEN witnesses only on falsifier_substrate_long_lane_rows (nightly falsifier batch 6). Expecting-RED frontier witnesses are explicit_witness_admission only — never dual-enrolled in ordinary long projection. Repository-wide call-occurrence closure has no admitted RED witness until a queryable population authority exists (wise-ram-22). Planted closed-subject witnesses stay in self_host/. Local recipe: claim_batch --source-root dag --source-root src/v2 --entry src/v2/test/claim/long/production_qualification_origin_probe_witness_test.dag --functions <csv>"

test fn witness_production_qualification_origin_probe_admission_holds() -> Bool {
  production_qualification_origin_probe_admission_holds(
    pool_roots: origin_probe_subject_roots,
    pool_files: origin_probe_subject_files
  )
}

data witness_live_scope_fixture_origin_discoverable_in_entry_closure_red_note: String = "Admitted RED (review 48255): live FixtureDerived mint sites are not discoverable in the fn_arrow_decl_facts_live population this witness names (G2 marshal prunes callee atoms; the subject is origin_probe_subject_roots and declared since gunbc#10245, so the gap is the marshal and no longer the scope). Replaces the retired 0==0 policy-oracle equality witness — greens when marshal exposes live fixture mint surfaces and known_fixture_origin_mint_surface_count_in_scope(pool_roots: origin_probe_subject_roots) > 0."

test fn witness_live_scope_fixture_origin_discoverable_in_entry_closure_reds() -> Bool {
  known_fixture_origin_mint_surface_count_in_scope(
    pool_roots: origin_probe_subject_roots,
    pool_files: origin_probe_subject_files
  ) > 0
}

data witness_live_structural_fixture_mint_site_discovered_red_note: String = "Admitted RED: G2 fn-arrow marshal currently yields an empty skeleton for the live structural_red_control_mint_site_probe body (match/let mint call); classifier cannot discover the exact FixtureDerived SourceProduced row until call-occurrence derivation or marshal exposes callee atoms."

test fn witness_live_structural_fixture_mint_site_discovered_reds() -> Bool {
  structural_red_control_live_fixture_mint_site_discovered(
    pool_roots: origin_probe_subject_roots,
    pool_files: origin_probe_subject_files,
    live_qualified_name: structural_red_control_mint_site_qualified_name
  )
}

data witness_ingest_mint_surface_requires_call_occurrence_frontier_red_note: String = "Admitted RED: generate_provenanced_rust_candidate_from_ingest calls mint_provenanced_rust_artifact at fn-arrow skeleton grain; G2 marshal currently prunes that ExprCall — witness greens when structural probe discovers a SourceProduced row on the ingest entry via mint_provenanced_rust_artifact."

test fn witness_ingest_mint_surface_requires_call_occurrence_frontier_reds() -> Bool {
  ingest_mint_surface_discovered_in_live_scope(
    pool_roots: origin_probe_subject_roots,
    pool_files: origin_probe_subject_files
  )
}

data witness_direct_door_smoke_requires_closure_or_call_occurrence_frontier_red_note: String = "Admitted RED: direct-door smoke is not in the witness entry import closure without a roster import — repository-wide discovery requires call-occurrence substrate or whole-tree fn_arrow facts."

test fn witness_direct_door_smoke_requires_closure_or_call_occurrence_frontier_reds() -> Bool {
  any(
    xs: derived_production_qualification_mint_sites_live(
      pool_roots: origin_probe_subject_roots,
      pool_files: origin_probe_subject_files
    ),
    predicate: fn(row) {
      string_contains(
        s: row.qualified_name,
        pattern: "run_direct_rust_door_emit_write_compile_smoke"
      )
    }
  )
}
