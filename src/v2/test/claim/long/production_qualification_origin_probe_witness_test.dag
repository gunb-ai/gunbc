module v2.test.long.production_qualification_origin_probe_witness

import v2.lens.production_qualification_origin_probe {
  derived_production_qualification_mint_sites_live,
  ingest_mint_surface_discovered_in_live_scope,
  known_fixture_origin_mint_surface_count_in_scope,
  production_qualification_origin_probe_admission_holds,
  structural_red_control_live_fixture_mint_site_discovered
}
import v2.test.claim.self_host.production_qualification_origin_probe_structural_fixture {
  structural_red_control_mint_site_qualified_name
}
import v2.std.algebra { any }
import v2.std.logic { Bool }
import v2.std.text { String }

// THE SUBJECT IS THE SELF-HOST ROOTS THIS PROBE ACTUALLY RANGES OVER. Every row in this file asks
// about mint surfaces in the self-host candidate-generation path and about the planted fixture
// beside it, both of which live under these two roots. Naming witness_layer_roots was measured
// exceeding the floor's cpu budget on all five rows, which returns NO VERDICT rather than a wider
// answer -- and for the four admitted-RED rows an undecided row is strictly worse than a red one,
// because an expecting-red roster entry that never decides stops discriminating anything.
//
// THIS NARROWS NOTHING THAT WAS BEING CHECKED. Until gunbc#10245 these rows answered from this
// witness's own resolved import closure, which is why their admitted-RED reasons speak of what is
// "discoverable in the entry closure"; the roots below make that scope declared instead of
// incidental.
//
// THE FOUR ADMITTED-RED ROWS DO NOT SHARE A BLOCKER, and this file used to say they did -- "the
// blocker those rows wait on is unchanged and is the G2 marshal". That sentence was decided false by
// execution over this declared subject at gunbc#10282: the mint-callee read reaches into block
// bodies, the population is non-empty, and a marshal repair greens none of these rows. Each note
// below now carries the cause its own row actually waits on, and they are three different ones --
// marker-read depth, inter-declaration call reachability, and the declared subject itself. The
// distinction is load-bearing rather than tidy: an admitted RED retires by ITS trigger, so a row
// carrying an overtaken cause retires against an innocent repair and its still-standing red is then
// read as a regression that repair introduced.
data origin_probe_subject_roots: List<String> = []

// FILE GRAIN, BECAUSE THE SUBJECT IS TWO MODULES AND THE SMALLEST DIRECTORIES HOLDING THEM ARE 63
// FILES. Measured: those two directories cost 543ms against a 500ms line, and these two files cost
// about 25ms. candidate_generation carries the ingest mint site the probe looks for; the fixture
// carries the planted FixtureDerived row the structural control names.
data origin_probe_subject_files: List<String> = [
  "src/v2/compiler/self_host/candidate_generation.dag",
  "src/v2/test/claim/self_host/production_qualification_origin_probe_structural_fixture.dag"
]

data production_qualification_origin_probe_long_witness_note: String = "LONG lane (operator 5s rule): witnesses that walk fn_arrow_decl_facts_live or derived_production_qualification_mint_sites_live over their declared subject roots exceed per-PR discovery budget. GREEN witnesses only on falsifier_substrate_long_lane_rows (nightly falsifier batch 6). Expecting-RED frontier witnesses are explicit_witness_admission only — never dual-enrolled in ordinary long projection. Repository-wide call-occurrence closure has no admitted RED witness until a queryable population authority exists (wise-ram-22). Planted closed-subject witnesses stay in self_host/. Local recipe: claim_batch --source-root dag --source-root src/v2 --entry src/v2/test/claim/long/production_qualification_origin_probe_witness_test.dag --functions <csv>"

test fn witness_production_qualification_origin_probe_admission_holds() -> Bool {
  production_qualification_origin_probe_admission_holds(
    pool_roots: origin_probe_subject_roots,
    pool_files: origin_probe_subject_files
  )
}

data witness_live_scope_fixture_origin_discoverable_in_entry_closure_red_note: String = "Admitted RED. THE MARSHAL IS NOT THE CAUSE, decided by execution over this witness declared subject at gunbc#10282 (ce937d0c4d): derived_production_qualification_mint_sites_live returns a NON-EMPTY population, so the mint callee is read at depth, and the count this row asserts is nonetheless zero because every discovered row classifies UnknownOrigin. The residual cause is the MARKER read rather than the callee read — decl_has_fixture_marker reaches atom_identities_in_node, which sees a declaration root and its immediate children only, while direct_rust_door_inferred_tree sits deeper in the body. Greens when the marker read reaches declaration subtrees and known_fixture_origin_mint_surface_count_in_scope over this subject > 0. Retiring this row on a callee-marshal repair would leave the red standing and misattribute it to whoever landed that repair."

test fn witness_live_scope_fixture_origin_discoverable_in_entry_closure_reds() -> Bool {
  known_fixture_origin_mint_surface_count_in_scope(
    pool_roots: origin_probe_subject_roots,
    pool_files: origin_probe_subject_files
  ) > 0
}

data witness_live_structural_fixture_mint_site_discovered_red_note: String = "Admitted RED whose declared cause is FALSIFIED. The skeleton for structural_red_control_mint_site_probe is not empty: executed over this subject at gunbc#10282 (ce937d0c4d), the probe discovers a row carrying that declaration qualified name on the SourceProduced axis, so the mint callee inside the match/let body IS read. This row is red on ORIGIN alone — the discovered row is UnknownOrigin because the fixture marker is read at declaration-root-plus-immediate-children depth. Greens when the marker read reaches declaration subtrees, without any change to the callee path and without a taught qualified-name pin."

test fn witness_live_structural_fixture_mint_site_discovered_reds() -> Bool {
  structural_red_control_live_fixture_mint_site_discovered(
    pool_roots: origin_probe_subject_roots,
    pool_files: origin_probe_subject_files,
    live_qualified_name: structural_red_control_mint_site_qualified_name
  )
}

data witness_ingest_mint_surface_requires_call_occurrence_frontier_red_note: String = "Admitted RED whose premise is FALSE IN THE SOURCE: generate_provenanced_rust_candidate_from_ingest does not call mint_provenanced_rust_artifact. It calls provenanced_rust_emission_observation_outcome over observe_provenanced_rust_emission_from_ingest, and the mint is at least two declarations further in. Measured over this subject at gunbc#10282 (ce937d0c4d): the ingest declaration IS in the population, and neither it nor observe_provenanced_rust_emission_from_ingest contributes a row. NO WIDENING OF THE WITHIN-DECLARATION HORIZON CAN GREEN THIS. Greens only when the probe classifies through inter-declaration call reachability, so a transitively reached mint is attributed to the declaration that reaches it."

test fn witness_ingest_mint_surface_requires_call_occurrence_frontier_reds() -> Bool {
  ingest_mint_surface_discovered_in_live_scope(
    pool_roots: origin_probe_subject_roots,
    pool_files: origin_probe_subject_files
  )
}

data witness_direct_door_smoke_requires_closure_or_call_occurrence_frontier_red_note: String = "Admitted RED whose cited boundary no longer exists: gunbc#10245 replaced the entry import closure with a caller-declared pool, so the population is exactly origin_probe_subject_files, and run_direct_rust_door_emit_write_compile_smoke lives in dag/test/claim/direct_rust_door_write_compile_witness_test.dag, which that list does not name. The cause is the declared subject and is decidable by reading it — not the marshal and not the reachability horizon. Greens when a population authority enumerates fn-arrow declarations repository-wide within this lane budget. Adding that one file to origin_probe_subject_files would also green it and is NOT the trigger: it would green the row without the capability the row stands for."

test fn witness_direct_door_smoke_requires_closure_or_call_occurrence_frontier_reds() -> Bool {
  any(
    xs: derived_production_qualification_mint_sites_live(
      pool_roots: origin_probe_subject_roots,
      pool_files: origin_probe_subject_files
    ),
    predicate: fn(row) {
      string_contains(
        s: row.qualified_name,
        pattern: "run_direct_rust_door_emit_write_compile_smoke"
      )
    }
  )
}
