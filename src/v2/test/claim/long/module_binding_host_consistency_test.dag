module v2.test.long.module_binding_host_consistency


data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data mbhc_note: String = "CONDITION 3 of the module-binding supply carrier: the host transport must agree with the in-graph model. After task 4 both sides derive module names through parse — the host via v1_compiler_parse at the bootstrap boundary, the oracle via module_storage_bindings_from_ingest over host_source_root_ingest. module_storage_host_agrees_with_oracle checks structural parity of the binding table (module identity + storage path), keeping the host handler a TRANSPORT of the modeled op instead of a second authority (§3).

Both manifests are host-emitted into one overlay source root by the transport: --emit-dag-manifest supplies the SOURCE TEXT the oracle parses (bounded by the ingest manifest's corpus-protection inline cap, hence a small scan dir), and --emit-module-binding-manifest supplies the whole-tree parsed rows (no source text, so uncapped). The oracle is therefore a subset of the host table by construction, which is why coverage and divergence are reported as DIFFERENT variants: an oracle row the host resolves to another module is a real divergence, while a row the host lacks is a coverage gap, and their remedies differ (§5 — do not collapse distinct states into one boolean).

Lives in long/ because the oracle re-parses every module it covers (~6.5s eval per module, operator 5-second fast-lane rule). That cost is acceptable at ORACLE scale and is exactly why the oracle is not the consumer path."

data mbhc_oracle_vacuity_note: String = "Two ways this witness could go green while testing NOTHING, both closed here (review 39729 caught the first). (1) A Rejected oracle must FAIL, never degrade to Empty: module_storage_host_agrees_with_oracle folds over the oracle starting at ModuleStorageAgrees, so an empty oracle agrees vacuously — a failed derivation would have reported agreement (§5 fabricated plausible output; the sibling ingest witness already returns false on Rejected). (2) An oracle that is legitimately Accepted but EMPTY is equally vacuous — that is the state when the overlay manifest is absent and host_source_root_ingest is still the committed empty stub, i.e. exactly the mis-run this witness must not silently pass. So the oracle is required to be non-empty as well as derivable. Neither arm widens: both refuse."

test fn module_binding_host_manifest_is_populated() -> Bool {
  host_module_binding_count > 0
}

test fn module_binding_host_agrees_with_parse_oracle() -> Bool {
  match module_storage_bindings_from_ingest(ingest: host_source_root_ingest) {
    Rejected { diagnostics: _ } => false
    Accepted { value: oracle, diagnostics: _ } =>
      if length(xs: oracle) == 0 {
        false
      } else {
        match module_storage_host_agrees_with_oracle(
          oracle: oracle,
          host: host_module_bindings
        ) {
          ModuleStorageAgrees => true
          ModuleStorageDivergent { path: _ } => false
          ModuleStorageUncovered { path: _ } => false
        }
      }
  }
}

test fn module_binding_host_resolves_a_known_compiler_module() -> Bool {
  match module_storage_module_for_path(
    index: host_module_bindings,
    file_path: "src/v2/compiler/source_authority.dag"
  ) {
    Absent => false
    Present { value: qn } =>
      qualified_name_to_dotted_string(qn: qn) == "v2.compiler.source_authority"
  }
}
