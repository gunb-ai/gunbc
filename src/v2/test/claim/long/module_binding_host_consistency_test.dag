module v2.test.long.module_binding_host_consistency

import v2.compiler.source_authority {
  ModuleStorageAgrees,
  ModuleStorageDivergent,
  ModuleStorageIndex,
  ModuleStorageUncovered,
  module_storage_bindings_from_ingest,
  module_storage_host_agrees_with_oracle,
  module_storage_module_for_path
}
import v2.test.workflow.host_module_binding_manifest {
  host_module_binding_count,
  host_module_bindings
}
import v2.test.workflow.host_source_root_ingest_manifest { host_source_root_ingest }
import v2.std.collection { Absent, Present }
import std.algebra { Empty }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.std.logic { Bool }
import v2.std.qualified_name { qualified_name_to_dotted_string }
import v2.std.text { String }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data mbhc_note: String = "CONDITION 3 of the module-binding supply carrier: the host transport must agree with the in-graph model. The host rows (host_module_bindings) are DeclarationScanned — produced by build_module_path_index via extract_module_path, a substring scan. The oracle (module_storage_bindings_from_ingest over host_source_root_ingest) genuinely PARSES. So this witness asks a real question — does the scan agree with the parser? — rather than restating one derivation against itself. That is what keeps the host handler a TRANSPORT of the modeled op instead of a second authority (§3), and it is why DeclarationScanned is its own provenance arm.

Both manifests are host-emitted into one overlay source root by the transport: --emit-dag-manifest supplies the SOURCE TEXT the oracle parses (bounded by the ingest manifest's corpus-protection inline cap, hence a small scan dir), and --emit-module-binding-manifest supplies the whole-tree scanned rows (no source text, so uncapped). The oracle is therefore a subset of the host table by construction, which is why coverage and divergence are reported as DIFFERENT variants: an oracle row the host resolves to another module is a real divergence, while a row the host lacks is a coverage gap, and their remedies differ (§5 — do not collapse distinct states into one boolean).

Lives in long/ because the oracle re-parses every module it covers (~6.5s eval per module, operator 5-second fast-lane rule). That cost is acceptable at ORACLE scale and is exactly why the oracle is not the consumer path."

fn mbhc_oracle_index() -> ModuleStorageIndex {
  match module_storage_bindings_from_ingest(ingest: host_source_root_ingest) {
    Accepted { value: index, diagnostics: _ } => index
    Rejected { diagnostics: _ } => Empty
  }
}

test fn module_binding_host_manifest_is_populated() -> Bool {
  host_module_binding_count > 0
}

test fn module_binding_host_agrees_with_parse_oracle() -> Bool {
  match module_storage_host_agrees_with_oracle(
    oracle: mbhc_oracle_index(),
    host: host_module_bindings
  ) {
    ModuleStorageAgrees => true
    ModuleStorageDivergent { path: _ } => false
    ModuleStorageUncovered { path: _ } => false
  }
}

test fn module_binding_host_resolves_a_known_compiler_module() -> Bool {
  match module_storage_module_for_path(
    index: host_module_bindings,
    file_path: "src/v2/compiler/source_authority.dag"
  ) {
    Absent => false
    Present { value: qn } =>
      qualified_name_to_dotted_string(qn: qn) == "v2.compiler.source_authority"
  }
}
