module v2.test.long.frontier_probe_real_module_cause

import v2.compiler.self_host.frontier_probe { frontier_probe_emit_from_ingest }
import v2.compiler.self_host.frontier_probe_types {
  AssembleMissingModule,
  AssembleRejectionDetail,
  FrontierProbeReceipt,
  GrammarChoiceOverlap,
  MaskedAssembleRefusal,
  MaskedAssembleRefusalWithoutEvidence,
  MissingModuleIdentityUnavailable,
  NoFrontierProbeDetail,
  OtherAssembleRefusal
}
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.std.logic { Bool }
import v2.std.text { String }
import v2.test.workflow.host_source_root_ingest_manifest {
  host_compiler_closure_admission,
  host_source_root_ingest
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data frontier_probe_real_module_cause_note: String = "SH-D D1 detailed-cause instrument: runs frontier_probe_emit_from_ingest against a REAL module closure supplied by the host_source_root_ingest_manifest overlay, and discriminates the AssembleRejectionCause variant the receipt actually carries. This is the DETAILED grain the operator ruling requires and the survey does not currently produce: frontier_gap_clustering_from_receipts counts blocker CLASSES and then supplies a hardcoded located_reason literal per branch, so it cannot distinguish two modules whose ambiguity rows differ. One arm per variant because a Bool witness cannot report a variant; the arm that greens IS the measurement. Same overlay recipe as direct_rust_door_real_module_probe. NOT ADMITTED for CI: real-pipeline walk, needs an explicit admission row with declared cost."

fn frontier_probe_real_module_receipt() -> FrontierProbeReceipt {
  frontier_probe_emit_from_ingest(
    module_path: frontier_probe_real_module_path,
    ingest: host_source_root_ingest,
    admission: host_compiler_closure_admission
  )
}

data frontier_probe_real_module_path: String = "src/v2/compiler/use_site_verdict.dag"

test fn real_module_cause_is_grammar_choice_overlap() -> Bool {
  match frontier_probe_real_module_receipt().assemble_detail {
    NoFrontierProbeDetail => false
    AssembleRejectionDetail { rejection_chain: _, cause: c, at: _ } =>
      match c {
        GrammarChoiceOverlap { rows: _ } => true
        MaskedAssembleRefusal { overlap_evidence: _, remaining_chain: _ } => false
        MaskedAssembleRefusalWithoutEvidence { remaining_chain: _ } => false
        AssembleMissingModule { requested: _ } => false
        MissingModuleIdentityUnavailable => false
        OtherAssembleRefusal { reason: _, at: _ } => false
      }
  }
}

test fn real_module_cause_is_masked_with_evidence() -> Bool {
  match frontier_probe_real_module_receipt().assemble_detail {
    NoFrontierProbeDetail => false
    AssembleRejectionDetail { rejection_chain: _, cause: c, at: _ } =>
      match c {
        GrammarChoiceOverlap { rows: _ } => false
        MaskedAssembleRefusal { overlap_evidence: _, remaining_chain: _ } => true
        MaskedAssembleRefusalWithoutEvidence { remaining_chain: _ } => false
        AssembleMissingModule { requested: _ } => false
        MissingModuleIdentityUnavailable => false
        OtherAssembleRefusal { reason: _, at: _ } => false
      }
  }
}

test fn real_module_cause_is_masked_without_evidence() -> Bool {
  match frontier_probe_real_module_receipt().assemble_detail {
    NoFrontierProbeDetail => false
    AssembleRejectionDetail { rejection_chain: _, cause: c, at: _ } =>
      match c {
        GrammarChoiceOverlap { rows: _ } => false
        MaskedAssembleRefusal { overlap_evidence: _, remaining_chain: _ } => false
        MaskedAssembleRefusalWithoutEvidence { remaining_chain: _ } => true
        AssembleMissingModule { requested: _ } => false
        MissingModuleIdentityUnavailable => false
        OtherAssembleRefusal { reason: _, at: _ } => false
      }
  }
}

test fn real_module_cause_is_missing_module() -> Bool {
  match frontier_probe_real_module_receipt().assemble_detail {
    NoFrontierProbeDetail => false
    AssembleRejectionDetail { rejection_chain: _, cause: c, at: _ } =>
      match c {
        GrammarChoiceOverlap { rows: _ } => false
        MaskedAssembleRefusal { overlap_evidence: _, remaining_chain: _ } => false
        MaskedAssembleRefusalWithoutEvidence { remaining_chain: _ } => false
        AssembleMissingModule { requested: _ } => true
        MissingModuleIdentityUnavailable => true
        OtherAssembleRefusal { reason: _, at: _ } => false
      }
  }
}

test fn real_module_cause_is_other_assemble_refusal() -> Bool {
  match frontier_probe_real_module_receipt().assemble_detail {
    NoFrontierProbeDetail => false
    AssembleRejectionDetail { rejection_chain: _, cause: c, at: _ } =>
      match c {
        GrammarChoiceOverlap { rows: _ } => false
        MaskedAssembleRefusal { overlap_evidence: _, remaining_chain: _ } => false
        MaskedAssembleRefusalWithoutEvidence { remaining_chain: _ } => false
        AssembleMissingModule { requested: _ } => false
        MissingModuleIdentityUnavailable => false
        OtherAssembleRefusal { reason: _, at: _ } => true
      }
  }
}

test fn real_module_assemble_detail_absent() -> Bool {
  match frontier_probe_real_module_receipt().assemble_detail {
    NoFrontierProbeDetail => true
    AssembleRejectionDetail { rejection_chain: _, cause: _, at: _ } => false
  }
}
