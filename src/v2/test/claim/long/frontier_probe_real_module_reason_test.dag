module v2.test.long.frontier_probe_real_module_reason

import v2.compiler.self_host.frontier_probe { frontier_probe_emit_from_ingest }
import v2.compiler.self_host.frontier_probe_types {
  AssembleMissingModule,
  AssembleRejectionDetail,
  FrontierProbeReceipt,
  GrammarChoiceOverlap,
  MaskedAssembleRefusal,
  MaskedAssembleRefusalWithoutEvidence,
  MissingModuleIdentityUnavailable,
  NoFrontierProbeDetail,
  OtherAssembleRefusal
}
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.text { String }
import v2.test.workflow.host_source_root_ingest_manifest {
  host_compiler_closure_admission,
  host_source_root_ingest
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data frontier_probe_real_module_reason_note: String = "SH-D D1 follow-up: the cause probe established that use_site_verdict's assemble rejection binds OtherAssembleRefusal (the catch-all), NOT GrammarChoiceOverlap, while its frontier row names located_reason ^parse_grammar_choice_overlap_residue. Two readings remain open and this instrument separates them: either the underlying reason symbol genuinely differs from the row (the row is misattributed), or the reason symbol matches and only the OVERLAP EVIDENCE failed to bind, which routes to OtherAssembleRefusal per frontier_probe_overlap_detail_note. Those have different owners and different repairs, so the symbol itself is read here rather than inferred. Also reads receipt.located_reason directly, since that is the field the survey clusters on."

fn frontier_probe_real_module_receipt() -> FrontierProbeReceipt {
  frontier_probe_emit_from_ingest(
    module_path: frontier_probe_real_module_path,
    ingest: host_source_root_ingest,
    admission: host_compiler_closure_admission
  )
}

data frontier_probe_real_module_path: String = "src/v2/compiler/use_site_verdict.dag"

fn real_module_other_refusal_reason() -> Symbol {
  match frontier_probe_real_module_receipt().assemble_detail {
    NoFrontierProbeDetail => ^no_assemble_detail
    AssembleRejectionDetail { rejection_chain: _, cause: c, at: _ } =>
      match c {
        GrammarChoiceOverlap { rows: _ } => ^bound_grammar_choice_overlap
        MaskedAssembleRefusal { overlap_evidence: _, remaining_chain: _ } => ^bound_masked_with_evidence
        MaskedAssembleRefusalWithoutEvidence { remaining_chain: _ } => ^bound_masked_without_evidence
        AssembleMissingModule { requested: _ } => ^bound_missing_module
        MissingModuleIdentityUnavailable => ^bound_missing_module_identity
        OtherAssembleRefusal { reason: r, at: _ } => r
      }
  }
}

test fn other_refusal_reason_is_parse_grammar_choice_overlap_residue() -> Bool {
  real_module_other_refusal_reason() == ^parse_grammar_choice_overlap_residue
}

test fn located_reason_is_parse_grammar_choice_overlap_residue() -> Bool {
  frontier_probe_real_module_receipt().located_reason == ^parse_grammar_choice_overlap_residue
}

test fn other_refusal_reason_is_resolve_module_not_found() -> Bool {
  real_module_other_refusal_reason() == ^resolve_module_not_found
}
