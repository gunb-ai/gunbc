module v2.test.long.direct_rust_door_observation

import v2.compiler.self_host.direct_rust_door_observation {
  DirectRustDoorObservation,
  DirectRustDoorSourceProduced,
  direct_rust_door_observation_is_candidate_rejection,
  observe_direct_rust_door_provenance
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.text { String }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data direct_rust_door_observation_deferred_terminal_note: String = "TERMINAL CONTROL DEFERRED (operator review 2026-08-04). An expecting-red witness asserting DirectRustDoorSourceProduced is NOT enrolled here. Enrolling it would have placed one function in both explicit_witness_admissions (which inverts) and falsifier_substrate_long_lane_rows (which does not) - the scheduler builds those as separate batches, so the same function would be inverted in one and read as a hard false in the other. That is precisely the batch-6 defect this lane exists to repair, and the first draft of this PR committed it. The terminal control lands after step 4 delivers pointwise, function-grain expectation matching; until then the existing direct-door known-red control carries the obligation. This witness asserts only the CURRENT measured state."

data direct_rust_door_observation_long_note: String = "LONG lane (operator 5s rule): runs the full ingest-assemble-infer-mint path; measured 13-15s per evaluation on a cold single-entry index. Enrolled on falsifier_substrate_long_lane_rows. Local recipe: claim_batch --source-root dag --source-root src/v2 --entry src/v2/test/claim/long/direct_rust_door_observation_test.dag --functions direct_rust_door_observation_is_candidate_rejected"

test fn direct_rust_door_observation_is_candidate_rejected() -> Bool {
  direct_rust_door_observation_is_candidate_rejection(o: observe_direct_rust_door_provenance())
}


