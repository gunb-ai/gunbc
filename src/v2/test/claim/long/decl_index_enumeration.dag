module v2.test.claim.long.decl_index_enumeration

import gunbc.ci.ci_layer_roots { witness_layer_roots }
import v2.std.decl_index {
  DeclFact,
  decl_fact_node_has_body,
  decl_facts,
  decl_facts_count,
  decl_facts_fn_item_count,
  decl_facts_is_fn_like,
  qualified_name_from_module
}
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

test fn decl_facts_nonempty_over_witness_roots() -> Bool {
  return decl_facts_count(pool_roots: witness_layer_roots) > 500
}

test fn decl_facts_fn_items_nonempty_over_witness_roots() -> Bool {
  return decl_facts_fn_item_count(pool_roots: witness_layer_roots) > 100
}

test fn decl_facts_rows_carry_locked_shape_fields() -> Bool {
  fold(decl_facts(pool_roots: witness_layer_roots), init: false, f: fn(found, fact) {
    if found {
      found
    } else if fact.name == "eval_bind_node_eval" {
      decl_facts_is_fn_like(kind: fact.kind)
        && (fact.rel_path.length() > 0)
        && decl_fact_node_has_body(node: fact.node)
    } else {
      false
    }
  })
}

test fn qualified_name_keeps_the_v2_prefix() -> Bool {
  return qualified_name_from_module(
    module_name: "v2.std.concept_index",
    name: "enumerate_concepts"
  ) == "v2.std.concept_index.enumerate_concepts"
}
