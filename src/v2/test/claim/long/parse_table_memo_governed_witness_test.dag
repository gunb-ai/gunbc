module v2.test.long.parse_table_memo_governed_witness


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data parse_table_memo_governed_witness_note: String = "Governed memo door receipts: Memoize verdict consumed at parse_table_lookup/insert (non-Memoize refuses store); warm==cold content-hash purity on the bisect fixture; RED on bypass insert (Recompute carrier with hand-populated entries). Door fns parse_table_memo_lookup_refuses_store / parse_table_memo_insert_refused are the direct oracle — witnesses call them, not map shape alone. parse_table_memo_door_order_independent composes insert-then-lookup and lookup-then-insert (Case A: seed ParseTableMemo must not serve/populate on non-Memoize — v1_interpreter.rs gated). reconcile-as-lookup-path is the next increment."

fn governed_witness_probe_key() -> ParsePositionKey {
  ParsePositionKey { position: 0, production: ^governed_witness_probe_prod }
}

fn governed_witness_dummy_entry() -> ParseMemoEntry {
  ParseMemoRejected { diagnostics: [] }
}

fn parse_table_recompute_fixture() -> ParseTable {
  let base = parse_table_empty()
  ParseTableRealization {
    artifact_kind: base.artifact_kind,
    provider_id: base.provider_id,
    materialization: Recompute,
    grammar_digest: base.grammar_digest,
    token_stream_digest: base.token_stream_digest,
    entries: base.entries,
    memo_hits: base.memo_hits,
    memo_misses: base.memo_misses,
    memo_lookup_calls: base.memo_lookup_calls,
    nullable_set: base.nullable_set,
    first_rows: base.first_rows
  }
}

fn parse_table_memoize_fixture() -> ParseTable {
  let base = parse_table_empty()
  ParseTableRealization {
    artifact_kind: base.artifact_kind,
    provider_id: base.provider_id,
    materialization: Memoize,
    grammar_digest: base.grammar_digest,
    token_stream_digest: base.token_stream_digest,
    entries: base.entries,
    memo_hits: base.memo_hits,
    memo_misses: base.memo_misses,
    memo_lookup_calls: base.memo_lookup_calls,
    nullable_set: base.nullable_set,
    first_rows: base.first_rows
  }
}

fn witness_materialization_gate_recompute_denies_store() -> Bool {
  !materialization_allows_memo_store(m: Recompute)
}

fn witness_recompute_fixture_carries_recompute_verdict() -> Bool {
  !materialization_allows_memo_store(m: parse_table_recompute_fixture().materialization)
}

fn witness_door_insert_refused_for_recompute_table() -> Bool {
  parse_table_memo_insert_refused(
    table: parse_table_recompute_fixture(),
    key: governed_witness_probe_key(),
    value: governed_witness_dummy_entry()
  )
}

fn witness_door_lookup_refused_for_recompute_table() -> Bool {
  parse_table_memo_lookup_refuses_store(
    table: parse_table_recompute_fixture(),
    key: governed_witness_probe_key()
  )
}

fn witness_door_insert_then_lookup_refused_for_recompute_table() -> Bool {
  witness_door_insert_refused_for_recompute_table()
    && witness_door_lookup_refused_for_recompute_table()
}

fn witness_door_lookup_then_insert_refused_for_recompute_table() -> Bool {
  witness_door_lookup_refused_for_recompute_table()
    && witness_door_insert_refused_for_recompute_table()
}

fn witness_door_order_independent_for_recompute_table() -> Bool {
  witness_door_insert_then_lookup_refused_for_recompute_table()
    && witness_door_lookup_then_insert_refused_for_recompute_table()
}

fn parse_table_entries_contain_key(table: ParseTable, key: ParsePositionKey) -> Bool {
  match v2.std.collection.map_get(m: table.entries, key: key) {
    Accepted { value: Present { value: _ } } => true
    Accepted { value: Absent } => false
    Rejected { diagnostics: _ } => false
  }
}

fn parse_table_memo_store_well_formed_at(table: ParseTable, key: ParsePositionKey) -> Bool {
  match materialization_allows_memo_store(m: table.materialization) {
    true => true
    false => !parse_table_entries_contain_key(table: table, key: key)
  }
}

fn witness_bypass_store_reds_non_memoize_carrier() -> Bool {
  let key = governed_witness_probe_key()
  let base = parse_table_recompute_fixture()
  let bypass = ParseTableRealization {
    artifact_kind: base.artifact_kind,
    provider_id: base.provider_id,
    materialization: Recompute,
    grammar_digest: base.grammar_digest,
    token_stream_digest: base.token_stream_digest,
    entries: map_insert(
      m: empty_map(),
      key: key,
      value: governed_witness_dummy_entry()
    ),
    memo_hits: base.memo_hits,
    memo_misses: base.memo_misses,
    memo_lookup_calls: base.memo_lookup_calls,
    nullable_set: base.nullable_set,
    first_rows: base.first_rows
  }
  !parse_table_memo_store_well_formed_at(table: bypass, key: key)
}

fn witness_memoize_carrier_allows_store() -> Bool {
  let table = parse_table_memoize_fixture()
  let key = governed_witness_probe_key()
  let after = parse_table_insert(
    table: table,
    key: key,
    value: governed_witness_dummy_entry()
  )
  parse_table_entries_contain_key(table: after, key: key)
}

fn witness_content_key_subject_stable() -> Bool {
  let table = parse_table_memoize_fixture()
  let key = governed_witness_probe_key()
  let a = parse_table_subject(table: table, key: key)
  let b = parse_table_subject(table: table, key: key)
  a == b
}

test fn parse_table_memo_governed_store_refused_when_recompute() -> Bool {
  witness_materialization_gate_recompute_denies_store()
    && witness_recompute_fixture_carries_recompute_verdict()
    && witness_door_insert_refused_for_recompute_table()
    && witness_door_lookup_refused_for_recompute_table()
}

test fn parse_table_memo_door_order_independent() -> Bool {
  witness_door_order_independent_for_recompute_table()
}

test fn parse_table_memo_bypass_store_reds() -> Bool {
  witness_bypass_store_reds_non_memoize_carrier()
}

test fn parse_table_memo_governed_memoize_allows_store() -> Bool {
  witness_memoize_carrier_allows_store()
    && witness_content_key_subject_stable()
}

test fn parse_table_memo_warm_equals_cold_content_hash() -> Bool {
  witness_parse_table_memo_hit_path_content_hash_stable()
}
