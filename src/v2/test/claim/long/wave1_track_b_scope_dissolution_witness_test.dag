data wave1_track_b_scope_dissolution_long_note: String = "Wave 1 Track B scope scaffold dissolution execution witnesses (long lane): full tokenize→parse_module→normalize→resolve ingest paths exceed the per-PR 5s fast-lane eval budget. Proven here by execution: after fn_decl→Arrow lowering, ingested add resolves with param refs bound via add_arrow_domain_named_params only (dag_fn_decl_param_binding_atoms + scope_with_fn_decl_params dissolved). Fast compile-gate import closure lives in self_host/wave1_track_b_scope_dissolution_witness_test.dag. Local recipe: claim_batch --source-root src/v2 --source-root dag --entry src/v2/test/claim/long/wave1_track_b_scope_dissolution_witness_test.dag --function <name>."

test fn wave1_track_b_ingested_add_resolves_after_scope_dissolution_holds() -> Bool {
  wave1_gate1_normalized_add_resolves_holds()
    && wave1_gate1_resolved_add_arrow_transform_holds()
}
