module v2.test.long.histogram_cause_diag

import std.algebra { Cons, Empty }
import v2.std.algebra { fold_list }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.std.collection { List }
import v2.std.node { Symbol }
import v2.std.text { String }
import v2.workflow.compile_door_ledger { DoorCompiled, DoorLedgerRow, DoorRefused, door_ledger }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data diag_pool_roots: List<String> = ["dag", "src/v2"]

fn row_cause(row: DoorLedgerRow) -> Symbol {
  match row.outcome {
    DoorCompiled => ^DIAG_compiled
    DoorRefused { reason: r } => r
  }
}

fn first_row_cause(path: String) -> Symbol {
  fold_list(
    xs: door_ledger(paths: Cons { head: path, tail: Empty }, pool_roots: diag_pool_roots),
    empty: ^DIAG_no_row,
    cons: fn(acc, row) { row_cause(row: row) }
  )
}

test fn diag_determinism_cause() -> Symbol {
  first_row_cause(path: "dag/std/determinism.dag")
}

test fn diag_error_primitives_cause() -> Symbol {
  first_row_cause(path: "dag/std/error_primitives.dag")
}

test fn diag_bit_cause() -> Symbol {
  first_row_cause(path: "dag/std/bit.dag")
}
