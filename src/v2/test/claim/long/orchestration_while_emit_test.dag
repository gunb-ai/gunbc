module v2.test.long.orchestration_while_emit

import v2.compiler.emit_orchestration { orch_emit_step, orch_emit_pipeline }
import v2.extdeps.languages.bash_orchestration_emit { bash_orchestration_emit_medium }
import v2.extdeps.languages.bash_orch_if {
  bash_path_predicate_target_model,
  bash_dirname_ascent_target_model
}
import v2.std.orchestration {
  Do,
  ExitZero,
  FailFast,
  Pipeline,
  PipelineStep,
  Run,
  While
}
import std.path_intent { And, DirnameAscent, Not, PathEntryKind, PathIntent, PathJoin, PathLiteral, PathNonempty, PathNotEq, PathRef }
import v2.std.collection { Absent }
import v2.std.diagnostic { Accepted, None, Rejected }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.filesystem.types { RegularFile, Directory, Missing }
import std.types { FilePathParts, NonEmptyStr }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data orch_while_long_lane_note: String = "Relocated here from v2.workflow (the per-PR fast-lane discovery roster) because these three check_fns' own eval exceeds the operator's 5-second fast-lane budget (gunbc_ci_fast_lane_rule_note; see commit_workflow_long_lane_note for the authority and precedent on repoint-vs-delete). This is model-only carrier/lowering validation: production ci_floor_peak leaves intentionally remain raw in this PR, and the separate consumer PR will migrate exactly those two live leaves and add construction refusal. No test content changed — all three still assert byte-identical goldens against orch_while_locate_golden. Excluded from discovery and the affected-set falsifier by the test/claim/long/ dir grain (gunbc.ci_layer_roots witness_exclusion_substrings), same offlining contract as the realization_vocabulary_containment_witness_test.dag sibling. Local recipe until the long-lane scheduled falsifier follow-on enrolls this row (dissolve-on): gunbc run --source-root dag --source-root src/v2 --claim-run --entry src/v2/test/claim/long/orchestration_while_emit_test.dag --function <one of the three check_fns above>, run once per check_fn."

data orch_while_golden_note: String = "Goldens are hand-authored model-authority bytes independent of grammar row spellings; byte tests compare emit against these literals so carrier/lowering regressions cannot go green by perturbing both sides at once. The live ci_floor_peak workflow stays raw until the follow-up consumer PR."

data orch_while_locate_golden: String = "d=\"/sys/fs/cgroup$(awk -F: '$1==\"0\"\{print $3\}' /proc/self/cgroup)\"\nwhile [ -n \"$d\" ] && [ \"$d\" != \"/sys/fs/cgroup\" ] && ! [ -f \"$d/memory.peak\" ]; do d=$(dirname \"$d\"); done"

data orch_while_assign_cgroup_dir_command: String = "d=\"/sys/fs/cgroup$(awk -F: '$1==\"0\"\{print $3\}' /proc/self/cgroup)\""

test data orch_while_path_ref: PathIntent = PathRef { name: "d" as NonEmptyStr }

test data orch_while_root_path: PathIntent = PathLiteral {
  parts: FilePathParts { segments: ["sys", "fs", "cgroup"] }
}

test data orch_while_memory_peak_path: PathIntent = PathJoin {
  base: orch_while_path_ref,
  suffix: FilePathParts { segments: ["memory.peak"] }
}

test data orch_while_predicate: std.path_intent.PathPredicate = And {
  lhs: PathNonempty { path: orch_while_path_ref },
  rhs: And {
    lhs: PathNotEq {
      lhs: orch_while_path_ref,
      rhs: orch_while_root_path
    },
    rhs: Not {
      inner: PathEntryKind {
        path: orch_while_memory_peak_path,
        kind: RegularFile
      }
    }
  }
}

test data orch_while_ascent: DirnameAscent = DirnameAscent {
  path: orch_while_path_ref,
  target: "d" as NonEmptyStr
}

fn orch_while_cond_model_text() -> String {
  match bash_path_predicate_target_model(predicate: orch_while_predicate) {
    Accepted { value: source, diagnostics: dg } =>
      match dg {
        None => source.authority_source_text
        Some { diagnostics: _ } => ""
      }
    Rejected { diagnostics: _ } => ""
  }
}

fn orch_while_body_model_text() -> String {
  match bash_dirname_ascent_target_model(ascent: orch_while_ascent) {
    Accepted { value: source, diagnostics: dg } =>
      match dg {
        None => source.authority_source_text
        Some { diagnostics: _ } => ""
      }
    Rejected { diagnostics: _ } => ""
  }
}

test data orch_while_cond_command: String = orch_while_cond_model_text()

test data orch_while_body_command: String = orch_while_body_model_text()

test data orch_while_locate_intent: PipelineStep = While {
  cond: ExitZero {
    run: Run {
      command: orch_while_cond_command,
      env: [],
      redirect: Absent,
      capture: Absent
    }
  },
  body: Pipeline {
    steps: [
      Do {
        run: Run {
          command: orch_while_body_command,
          env: [],
          redirect: Absent,
          capture: Absent
        }
      }
    ],
    on_failure: FailFast
  }
}

test data orch_while_locate_perturbed_intent: PipelineStep = While {
  cond: ExitZero {
    run: Run {
      command: concat(orch_while_cond_command, " # perturbed"),
      env: [],
      redirect: Absent,
      capture: Absent
    }
  },
  body: Pipeline {
    steps: [
      Do {
        run: Run {
          command: orch_while_body_command,
          env: [],
          redirect: Absent,
          capture: Absent
        }
      }
    ],
    on_failure: FailFast
  }
}

test data orch_while_locate_body_perturbed_intent: PipelineStep = While {
  cond: ExitZero {
    run: Run {
      command: orch_while_cond_command,
      env: [],
      redirect: Absent,
      capture: Absent
    }
  },
  body: Pipeline {
    steps: [
      Do {
        run: Run {
          command: concat(orch_while_body_command, " # perturbed"),
          env: [],
          redirect: Absent,
          capture: Absent
        }
      }
    ],
    on_failure: FailFast
  }
}

test fn orch_while_locate_pipeline_matches_golden_holds() -> Bool {
  match orch_emit_pipeline(
    p: Pipeline {
      steps: [
        Do {
          run: Run {
            command: orch_while_assign_cgroup_dir_command,
            env: [],
            redirect: Absent,
            capture: Absent
          }
        },
        orch_while_locate_intent
      ],
      on_failure: FailFast
    },
    medium: bash_orchestration_emit_medium()
  ) {
    Accepted { value: source, diagnostics: dg } =>
      (source.carried == orch_while_locate_golden) && (dg == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_while_step_matches_golden_holds() -> Bool {
  match orch_emit_pipeline(
    p: Pipeline {
      steps: [
        Do {
          run: Run {
            command: orch_while_assign_cgroup_dir_command,
            env: [],
            redirect: Absent,
            capture: Absent
          }
        },
        orch_while_locate_intent
      ],
      on_failure: FailFast
    },
    medium: bash_orchestration_emit_medium()
  ) {
    Accepted { value: source, diagnostics: dg } =>
      (source.carried == orch_while_locate_golden) && (dg == None)
    Rejected { diagnostics: _ } => false
  }
}

data orch_while_raw_while_deferred_note: String = "Raw While construction refusal is deferred here: the current seam only proves emitted-bytes perturbation, because orch_emit_step routes While through the byte-emitting target model and does not expose a dedicated construction/lens refusal carrier yet. This witness only checks that changing the raw cond text changes the emitted bytes."

test fn orch_while_raw_while_perturbation_changes_bytes_holds() -> Bool {
  match orch_emit_step(
    s: While {
      cond: ExitZero {
        run: Run {
          command: concat(orch_while_cond_command, " # raw-while"),
          env: [],
          redirect: Absent,
          capture: Absent
        }
      },
      body: Pipeline {
        steps: [
          Do {
            run: Run {
              command: orch_while_body_command,
              env: [],
              redirect: Absent,
              capture: Absent
            }
          }
        ],
        on_failure: FailFast
      }
    },
    medium: bash_orchestration_emit_medium()
  ) {
    Accepted { value: source, diagnostics: _ } =>
      source.carried != orch_while_locate_golden
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_while_path_kind_discriminates_regular_directory_missing_holds() -> Bool {
  let regular = match bash_path_predicate_target_model(
    predicate: PathEntryKind {
      path: orch_while_memory_peak_path,
      kind: RegularFile
    }
  ) {
    Accepted { value: source, diagnostics: _ } => source.authority_source_text
    Rejected { diagnostics: _ } => ""
  }
  let directory = match bash_path_predicate_target_model(
    predicate: PathEntryKind {
      path: orch_while_memory_peak_path,
      kind: Directory
    }
  ) {
    Accepted { value: source, diagnostics: _ } => source.authority_source_text
    Rejected { diagnostics: _ } => ""
  }
  let missing = match bash_path_predicate_target_model(
    predicate: PathEntryKind {
      path: orch_while_memory_peak_path,
      kind: Missing
    }
  ) {
    Accepted { value: source, diagnostics: _ } => source.authority_source_text
    Rejected { diagnostics: _ } => ""
  }
  (regular == "[ -f \"$d/memory.peak\" ]")
    && (directory == "[ -d \"$d/memory.peak\" ]")
    && (missing == "[ ! -e \"$d/memory.peak\" ]")
    && (regular != directory)
    && (regular != missing)
    && (directory != missing)
}
