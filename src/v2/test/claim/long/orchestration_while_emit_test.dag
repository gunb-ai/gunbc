module v2.test.long.orchestration_while_emit

import v2.compiler.emit_orchestration { orch_emit_step, orch_emit_pipeline }
import v2.extdeps.languages.bash_orchestration_emit { bash_orchestration_emit_medium }
import v2.extdeps.languages.bash_orch_if {
  bash_path_predicate_target_model,
  bash_dirname_ascent_target_model
}
import v2.workflow.ci_floor_peak_emit {
  ci_floor_peak_cgroup_locate_pipeline,
  ci_floor_peak_assign_cgroup_dir_command,
  ci_floor_peak_while_cond_command
}
import v2.std.orchestration {
  Do,
  ExitZero,
  FailFast,
  Pipeline,
  PipelineStep,
  Run,
  While
}
import std.path_intent {
  And,
  DirnameAscent,
  Not,
  PathEntryKind,
  PathIntent,
  PathJoin,
  PathLiteral,
  PathNonempty,
  PathNotEq,
  PathRef
}
import v2.std.collection { Absent }
import v2.std.diagnostic { Accepted, None, Rejected }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.filesystem.types { RegularFile, Directory, Missing }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data orch_while_long_lane_note: String = "Relocated here from v2.workflow (the per-PR fast-lane discovery roster) because these three check_fns' own eval exceeds the operator's 5-second fast-lane budget (gunbc_ci_fast_lane_rule_note; see commit_workflow_long_lane_note for the authority and precedent on repoint-vs-delete). No test content changed — all three still assert byte-identical goldens against orch_while_locate_golden. Excluded from discovery and the affected-set falsifier by the test/claim/long/ dir grain (gunbc.ci_layer_roots witness_exclusion_substrings), same offlining contract as the realization_vocabulary_containment_witness_test.dag sibling. Local recipe until the long-lane scheduled falsifier follow-on enrolls this row (dissolve-on): gunbc run --source-root dag --source-root src/v2 --claim-run --entry src/v2/test/claim/long/orchestration_while_emit_test.dag --function <one of the three check_fns above>, run once per check_fn."

data orch_while_golden_note: String = "Goldens are hand-authored bytes independent of grammar row spellings; byte tests compare emit against these literals so row/emitter regressions cannot go green by perturbing both sides at once."

data orch_while_locate_golden: String = "d=\"/sys/fs/cgroup$(awk -F: '$1==\"0\"\{print $3\}' /proc/self/cgroup)\"\nwhile [ -n \"$d\" ] && [ \"$d\" != \"/sys/fs/cgroup\" ] && [ ! -f \"$d/memory.peak\" ]; do d=$(dirname \"$d\"); done"

data orch_while_body_command: String = "d=$(dirname \"$d\")"

fn ci_floor_peak_path_ref() -> PathIntent {
  PathRef { name: "d" }
}

fn ci_floor_peak_root_path() -> PathIntent {
  PathLiteral {
    parts: FilePathParts { segments: ["sys", "fs", "cgroup"] }
  }
}

fn ci_floor_peak_memory_peak_path() -> PathIntent {
  PathJoin {
    base: ci_floor_peak_path_ref(),
    suffix: FilePathParts { segments: ["memory.peak"] }
  }
}

fn ci_floor_peak_while_predicate() -> std.path_intent.PathPredicate {
  And {
    lhs: PathNonempty { path: ci_floor_peak_path_ref() },
    rhs: And {
      lhs: PathNotEq {
        lhs: ci_floor_peak_path_ref(),
        rhs: ci_floor_peak_root_path()
      },
      rhs: Not {
        inner: PathEntryKind {
          path: ci_floor_peak_memory_peak_path(),
          kind: RegularFile
        }
      }
    }
  }
}

fn ci_floor_peak_while_ascent() -> DirnameAscent {
  DirnameAscent { path: ci_floor_peak_path_ref() }
}

fn typed_ci_floor_peak_path_kind(kind: std.filesystem.types.EntryKind) -> std.path_intent.PathPredicate {
  PathEntryKind {
    path: ci_floor_peak_memory_peak_path(),
    kind: kind
  }
}

fn orch_while_locate_intent() -> PipelineStep {
  While {
    cond: ExitZero {
      run: Run {
        command: ci_floor_peak_while_cond_command,
        env: [],
        redirect: Absent,
        capture: Absent
      }
    },
    body: Pipeline {
      steps: [
        Do {
          run: Run {
            command: orch_while_body_command,
            env: [],
            redirect: Absent,
            capture: Absent
          }
        }
      ],
      on_failure: FailFast
    }
  }
}

fn orch_while_locate_perturbed_intent() -> PipelineStep {
  While {
    cond: ExitZero {
      run: Run {
        command: concat(ci_floor_peak_while_cond_command, " # perturbed"),
        env: [],
        redirect: Absent,
        capture: Absent
      }
    },
    body: Pipeline {
      steps: [
        Do {
          run: Run {
            command: orch_while_body_command,
            env: [],
            redirect: Absent,
            capture: Absent
          }
        }
      ],
      on_failure: FailFast
    }
  }
}

fn orch_while_locate_body_perturbed_intent() -> PipelineStep {
  While {
    cond: ExitZero {
      run: Run {
        command: ci_floor_peak_while_cond_command,
        env: [],
        redirect: Absent,
        capture: Absent
      }
    },
    body: Pipeline {
      steps: [
        Do {
          run: Run {
            command: concat(orch_while_body_command, " # perturbed"),
            env: [],
            redirect: Absent,
            capture: Absent
          }
        }
      ],
      on_failure: FailFast
    }
  }
}

test fn orch_while_locate_pipeline_matches_golden_holds() -> Bool {
  match orch_emit_pipeline(
    p: ci_floor_peak_cgroup_locate_pipeline(),
    medium: bash_orchestration_emit_medium()
  ) {
    Accepted { value: source, diagnostics: dg } =>
      (source.carried == orch_while_locate_golden) && (dg == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_while_typed_predicate_matches_golden_holds() -> Bool {
  match bash_path_predicate_target_model(predicate: ci_floor_peak_while_predicate()) {
    Accepted { value: source, diagnostics: dg } =>
      (source.authority_source_text == "[ -n \"$d\" ] && ! [ \"$d\" = \"/sys/fs/cgroup\" ] && ! [ -f \"$d/memory.peak\" ]") && (dg == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_while_typed_ascent_matches_golden_holds() -> Bool {
  match bash_dirname_ascent_target_model(ascent: ci_floor_peak_while_ascent()) {
    Accepted { value: source, diagnostics: dg } =>
      (source.authority_source_text == orch_while_body_command) && (dg == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_while_path_kind_discriminates_regular_directory_missing_holds() -> Bool {
  let regular = match bash_path_predicate_target_model(predicate: typed_ci_floor_peak_path_kind(kind: RegularFile)) {
    Accepted { value: source, diagnostics: _ } => source.authority_source_text
    Rejected { diagnostics: _ } => ""
  }
  let directory = match bash_path_predicate_target_model(predicate: typed_ci_floor_peak_path_kind(kind: Directory)) {
    Accepted { value: source, diagnostics: _ } => source.authority_source_text
    Rejected { diagnostics: _ } => ""
  }
  let missing = match bash_path_predicate_target_model(predicate: typed_ci_floor_peak_path_kind(kind: Missing)) {
    Accepted { value: source, diagnostics: _ } => source.authority_source_text
    Rejected { diagnostics: _ } => ""
  }
  (regular == "[ -f \"$d/memory.peak\" ]")
    && (directory == "[ -d \"$d/memory.peak\" ]")
    && (missing == "[ ! -e \"$d/memory.peak\" ]")
    && (regular != directory)
    && (regular != missing)
    && (directory != missing)
}

test fn orch_while_path_predicate_refuses_unsafe_operand_holds() -> Bool {
  match bash_path_predicate_target_model(
    predicate: And {
      lhs: PathNonempty { path: PathRef { name: "d;rm -rf /" } },
      rhs: PathNonempty { path: ci_floor_peak_path_ref() }
    }
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

test fn orch_while_step_matches_golden_holds() -> Bool {
  match orch_emit_pipeline(
    p: Pipeline {
      steps: [
        Do {
          run: Run {
            command: ci_floor_peak_assign_cgroup_dir_command,
            env: [],
            redirect: Absent,
            capture: Absent
          }
        },
        orch_while_locate_intent()
      ],
      on_failure: FailFast
    },
    medium: bash_orchestration_emit_medium()
  ) {
    Accepted { value: source, diagnostics: dg } =>
      (source.carried == orch_while_locate_golden) && (dg == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_while_emit_cond_has_teeth_holds() -> Bool {
  match orch_emit_step(s: orch_while_locate_perturbed_intent(), medium: bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: _ } =>
      source.carried != "while [ -n \"$d\" ] && [ \"$d\" != \"/sys/fs/cgroup\" ] && [ ! -f \"$d/memory.peak\" ]; do d=$(dirname \"$d\"); done"
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_while_emit_body_has_teeth_holds() -> Bool {
  match orch_emit_step(s: orch_while_locate_body_perturbed_intent(), medium: bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: _ } =>
      source.carried != "while [ -n \"$d\" ] && [ \"$d\" != \"/sys/fs/cgroup\" ] && [ ! -f \"$d/memory.peak\" ]; do d=$(dirname \"$d\"); done"
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_while_typed_root_stop_matches_golden_holds() -> Bool {
  match bash_path_predicate_target_model(
    predicate: PathNotEq {
      lhs: ci_floor_peak_path_ref(),
      rhs: ci_floor_peak_root_path()
    }
  ) {
    Accepted { value: source, diagnostics: dg } =>
      (source.authority_source_text == "! [ \"$d\" = \"/sys/fs/cgroup\" ]") && (dg == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_while_typed_predicate_perturbation_has_teeth_holds() -> Bool {
  match bash_path_predicate_target_model(
    predicate: And {
      lhs: PathNonempty { path: ci_floor_peak_path_ref() },
      rhs: And {
        lhs: PathNotEq {
          lhs: ci_floor_peak_path_ref(),
          rhs: PathLiteral {
            parts: FilePathParts { segments: ["sys", "fs", "cgroup", "alt"] }
          }
        },
        rhs: Not {
          inner: PathEntryKind {
            path: ci_floor_peak_memory_peak_path(),
            kind: RegularFile
          }
        }
      }
    }
  ) {
    Accepted { value: source, diagnostics: _ } =>
      source.authority_source_text != "[ -n \"$d\" ] && ! [ \"$d\" = \"/sys/fs/cgroup\" ] && ! [ -f \"$d/memory.peak\" ]"
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_while_typed_ascent_perturbation_has_teeth_holds() -> Bool {
  match bash_dirname_ascent_target_model(
    ascent: DirnameAscent {
      path: ci_floor_peak_root_path()
    }
  ) {
    Accepted { value: source, diagnostics: _ } =>
      source.authority_source_text != orch_while_body_command
    Rejected { diagnostics: _ } => false
  }
}

test fn orch_while_path_predicate_refuses_unsafe_join_operand_holds() -> Bool {
  match bash_path_predicate_target_model(
    predicate: PathEntryKind {
      path: PathJoin {
        base: PathRef { name: "d" },
        suffix: FilePathParts { segments: ["memory.peak;rm -rf /"] }
      },
      kind: RegularFile
    }
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}
