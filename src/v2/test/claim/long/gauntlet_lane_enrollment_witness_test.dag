module test.claim.long.gauntlet_lane_enrollment_witness


data gauntlet_lane_enrollment_note: String = "Executing consumer for the gunbc.commit_workflow.FalsifierCadenceJob lane (gunbc.commit_workflow falsifier_cadence_surface_note / bare_deenrollment_wall_note). It exists because the lane's whole value is the difference between 're-homed' and 'dropped', and that difference is invisible in a diff: both look like a surface list edit. Three claims, the third a RED control so the first two cannot pass vacuously. This file lives under test/claim/long/ for HOMING consistency with the rows it guards, but is enrolled per-PR on gunbc.commit_workflow.GithubActionsCiJob deliberately — it is a pure roster fold with no live-tree read and no host effect, measured well inside the fast-lane budget, and its whole point is to red on the PR that de-enrolls something rather than up to 4 hours later."

fn synthetic_rehomed_row() -> gunbc.commit_workflow.CommitCheckEnrollment {
  gunbc.commit_workflow.CommitCheckEnrollment {
    check: gunbc.commit_workflow.CommitWitnessClaim {
      entry: "src/v2/test/claim/long/synthetic_rehomed_witness_test.dag",
      check_fns: ["synthetic_rehomed_holds"],
      kind: std.realization_schedule.ExecutionWitnessKind,
      span: std.realization_schedule.SpanUndeclared
    },
    surfaces: [gunbc.commit_workflow.FalsifierCadenceJob]
  }
}

fn synthetic_pr_row() -> gunbc.commit_workflow.CommitCheckEnrollment {
  gunbc.commit_workflow.CommitCheckEnrollment {
    check: gunbc.commit_workflow.CommitWitnessClaim {
      entry: "src/v2/test/claim/synthetic_pr_witness_test.dag",
      check_fns: ["synthetic_pr_holds"],
      kind: std.realization_schedule.ExecutionWitnessKind,
      span: std.realization_schedule.SpanUndeclared
    },
    surfaces: [gunbc.commit_workflow.GithubActionsCiJob]
  }
}

fn synthetic_bare_deenrolled_row() -> gunbc.commit_workflow.CommitCheckEnrollment {
  gunbc.commit_workflow.CommitCheckEnrollment {
    check: gunbc.commit_workflow.CommitWitnessClaim {
      entry: "src/v2/test/claim/long/synthetic_dropped_witness_test.dag",
      check_fns: ["synthetic_dropped_holds"],
      kind: std.realization_schedule.ExecutionWitnessKind,
      span: std.realization_schedule.SpanUndeclared
    },
    surfaces: [gunbc.commit_workflow.GitPrePushHook]
  }
}

fn falsifier_entries_contain(entries: List<std.realization_schedule.ScheduleWitnessEntry>, f: String) -> Bool {
  v2.std.algebra.any(entries, e => e.function == f)
}

data substrate_long_lane_is_a_sibling_cadence_note: String = "wave1_gate1_d_census_subsumption_witness_holds moved off gunbc.commit_workflow.FalsifierCadenceJob onto gunbc.ci_layer_roots.falsifier_substrate_long_lane_rows (nightly falsifier batch 6) when main landed the Class C split. That is a re-home between two cadence lanes, NOT a de-enrollment, so the invariant this file guards still holds — but the pin has to read the lane the row actually sits on. Dropping the pin instead would have been the narrowing this witness exists to prevent: the row would then be free to vanish from BOTH lanes with nothing red. The check below therefore asserts substrate-long-lane membership by function name, which is the same claim ('this re-homed row still executes on a cadence') read against the correct authority."

fn substrate_long_lane_contains(f: String) -> Bool {
  v2.std.algebra.any(gunbc.ci_layer_roots.falsifier_substrate_long_lane_rows, row => row.function == f)
}

data provenance_producer_rows_deleted_not_rehomed_note: String = "Three identities formerly asserted here — lens_affected_set_provenance_producer_rejects_malformed_ingest_holds, _rejects_beyond_surface_ingest_holds, _coverage_receipt_holds — are REMOVED, not corrected in place, because they no longer name anything a rehome claim can be made about. Commit 60fa7b248f (2026-08-17) deleted src/v2/lens/affected_set/provenance_producer.dag and src/v2/test/claim/long/affected_set_provenance_producer_witness_test.dag whole, dispositioned RETIRED WITH THE MACHINERY: 'a witness whose subject no longer exists cannot be re-enrolled against anything.' Asserting these three names are cadence-enrolled was therefore unwitnessable from that commit forward — no roster row and no source file can name them — and this witness was silently RED for it, which is the actual '3 of 7 unenrolled' failure this file exists to prevent from going unnoticed. dag/gunbc/commit_workflow.dag provenance_wall_cadence_rehome_risk is retired in the same change with the full disposition. Re-adding these three assertions is correct again only if the provenance-producer lens itself is rebuilt and re-enrolled — at which point it needs a fresh claim naming the new home, not this one resurrected."

test fn witness_rehomed_rows_are_cadence_enrolled() -> Bool {
  let entries = gunbc.commit_workflow.live_roster_falsifier_witness_entries()
  substrate_long_lane_contains(f: "wave1_gate1_d_census_subsumption_witness_holds")
    && falsifier_entries_contain(entries: entries, f: "wave1_gate1_d_ingested_bind_executes_witness_holds")
    && falsifier_entries_contain(entries: entries, f: "wave1_gate1_d_ingested_loop_executes_witness_holds")
    && falsifier_entries_contain(entries: entries, f: "witness_parse_binding_fidelity_distinct_identifiers_holds")
}

test fn witness_split_entries_keep_cheap_half_per_pr() -> Bool {
  let cadence = gunbc.commit_workflow.live_roster_falsifier_witness_entries()
  !falsifier_entries_contain(entries: cadence, f: "lens_affected_set_provenance_producer_git_diff_wire_holds")
    && !falsifier_entries_contain(entries: cadence, f: "witness_resolve_distinct_param_bindings_holds")
}

test fn gauntlet_lane_rehome_is_never_bare_deenrollment_holds() -> Bool {
  gunbc.commit_workflow.live_roster_has_no_bare_deenrolled_witness()
    && gunbc.commit_workflow.roster_has_no_bare_deenrolled_witness(
         roster: [synthetic_pr_row(), synthetic_rehomed_row()]
       )
}

test fn gauntlet_lane_rehome_bare_deenrollment_RED_control_holds() -> Bool {
  !gunbc.commit_workflow.roster_has_no_bare_deenrolled_witness(
    roster: [synthetic_pr_row(), synthetic_rehomed_row(), synthetic_bare_deenrolled_row()]
  )
}

data gate_half_of_the_wall_note: String = "The GATE half, added 2026-07-26 when an audit found the wall above covers only CommitWitnessClaim rows. A gunbc.commit_workflow.CommitSpecGate could be moved to surfaces: [FalsifierCadenceJob] — or to [] outright — and execute nowhere with nothing red, because roster_has_no_bare_deenrolled_witness filters on enrollment_is_witness_claim, which answers false for a gate. That made the gate the single enrollment shape whose de-enrollment was invisible, in a lane about to be used to re-home three of them. The claims below mirror the witness half exactly, minus the surface asymmetry, which is RETIRED. AMENDED 2026-08-19 (regen root cut): the positive control here used to be a gate on GithubActionsCiRegenJob, paired against a byte-identical witness row that had to FAIL — the pair demonstrated that regen counted for gates and never for witnesses. That surface was the entire asymmetry and it is deleted, so the two enrollment predicates collapsed into one (gunbc.commit_workflow enrollment_is_scheduled) and NO row can demonstrate the distinction any more, because it no longer exists. The pair is re-pointed rather than dropped: synthetic_enrolled_gate_row rides gunbc.commit_workflow.GithubActionsCiJob and must pass, synthetic_bare_deenrolled_gate_row rides gunbc.commit_workflow.GitPrePushHook alone and must red. That still discriminates the claim that survives — a declared row must ride a surface that executes it — and gunbc.commit_workflow.GitPrePushHook still counts for neither kind. What is no longer witnessed, stated rather than quietly dropped: that the gate and witness predicates DIFFER. If a future surface executes one kind and not the other, the split and its controls have to be reintroduced. enrollment_surface_asymmetry_retired_note carries the retirement."

fn synthetic_cadence_gate_row() -> gunbc.commit_workflow.CommitCheckEnrollment {
  gunbc.commit_workflow.CommitCheckEnrollment {
    check: gunbc.commit_workflow.CommitSpecGate { gate: gunbc.ci_gate.CheapClaimPoolGate },
    surfaces: [gunbc.commit_workflow.FalsifierCadenceJob]
  }
}

// Was synthetic_regen_gate_row, on GithubActionsCiRegenJob. That surface is deleted with
// the regen root cut and it WAS the whole gate/witness asymmetry, so this row can no longer
// demonstrate the asymmetry — nothing can. It is re-pointed at the per-PR floor and keeps the
// claim that survives: a gate riding an executing surface is correctly enrolled, paired against
// synthetic_bare_deenrolled_gate_row on GitPrePushHook, which is not.
fn synthetic_enrolled_gate_row() -> gunbc.commit_workflow.CommitCheckEnrollment {
  gunbc.commit_workflow.CommitCheckEnrollment {
    check: gunbc.commit_workflow.CommitSpecGate { gate: gunbc.ci_gate.GeneratedArtifactDriftGate },
    surfaces: [gunbc.commit_workflow.GithubActionsCiJob]
  }
}

fn synthetic_bare_deenrolled_gate_row() -> gunbc.commit_workflow.CommitCheckEnrollment {
  gunbc.commit_workflow.CommitCheckEnrollment {
    check: gunbc.commit_workflow.CommitSpecGate { gate: gunbc.ci_gate.CheapClaimPoolGate },
    surfaces: [gunbc.commit_workflow.GitPrePushHook]
  }
}

test fn gauntlet_lane_gate_rehome_is_never_bare_deenrollment_holds() -> Bool {
  gunbc.commit_workflow.live_roster_has_no_bare_deenrolled_gate()
    && gunbc.commit_workflow.roster_has_no_bare_deenrolled_gate(
         roster: [synthetic_cadence_gate_row(), synthetic_enrolled_gate_row()]
       )
}

test fn gauntlet_lane_gate_bare_deenrollment_RED_control_holds() -> Bool {
  !gunbc.commit_workflow.roster_has_no_bare_deenrolled_gate(
    roster: [synthetic_cadence_gate_row(), synthetic_bare_deenrolled_gate_row()]
  )
}
