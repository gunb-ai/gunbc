module v2.test.long.frontier_probe_reason_readout

import v2.compiler.self_host.frontier_probe { frontier_probe_emit_from_ingest }
import v2.compiler.self_host.frontier_probe_types {
  AssembleMissingModule,
  AssembleRejectionDetail,
  FrontierProbeReceipt,
  GrammarChoiceOverlap,
  MaskedAssembleRefusal,
  MaskedAssembleRefusalWithoutEvidence,
  MissingModuleIdentityUnavailable,
  NoFrontierProbeDetail,
  OtherAssembleRefusal,
  CauseLocationTextual,
  CauseLocationUnavailable
}
import v2.std.diagnostic { ByteRange, WholeFile }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.std.node { Symbol }
import v2.std.text { String }
import v2.test.workflow.host_source_root_ingest_manifest {
  host_compiler_closure_admission,
  host_source_root_ingest
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data frontier_probe_reason_readout_note: String = "SH-D readout entry, NOT a witness: three equality probes established that use_site_verdict's measured located_reason is neither ^parse_grammar_choice_overlap_residue (the symbol its frontier row records) nor ^resolve_module_not_found, and that its assemble cause is OtherAssembleRefusal. Guessing further symbols at ~80s per equality test is the wrong instrument, so these fns RETURN the symbol for gunbc run to print. No test fn here on purpose: this reads a value, it does not assert one."

fn readout_receipt() -> FrontierProbeReceipt {
  frontier_probe_emit_from_ingest(
    module_path: readout_module_path,
    ingest: host_source_root_ingest,
    admission: host_compiler_closure_admission
  )
}

data readout_module_path: String = "src/v2/compiler/use_site_verdict.dag"

fn readout_located_reason() -> Symbol {
  readout_receipt().located_reason
}

fn readout_assemble_cause_reason() -> Symbol {
  match readout_receipt().assemble_detail {
    NoFrontierProbeDetail => ^no_assemble_detail
    AssembleRejectionDetail { rejection_chain: _, cause: c, at: _ } =>
      match c {
        GrammarChoiceOverlap { rows: _ } => ^bound_grammar_choice_overlap
        MaskedAssembleRefusal { overlap_evidence: _, remaining_chain: _ } => ^bound_masked_with_evidence
        MaskedAssembleRefusalWithoutEvidence { remaining_chain: _ } => ^bound_masked_without_evidence
        AssembleMissingModule { requested: _ } => ^bound_missing_module
        MissingModuleIdentityUnavailable => ^bound_missing_module_identity
        OtherAssembleRefusal { reason: r, at: _ } => r
      }
  }
}

fn readout_assemble_cause_locus_file() -> Symbol {
  match readout_receipt().assemble_detail {
    NoFrontierProbeDetail => ^no_assemble_detail
    AssembleRejectionDetail { rejection_chain: _, cause: c, at: _ } =>
      match c {
        GrammarChoiceOverlap { rows: _ } => ^locus_not_carried_overlap
        MaskedAssembleRefusal { overlap_evidence: _, remaining_chain: _ } => ^locus_not_carried_masked
        MaskedAssembleRefusalWithoutEvidence { remaining_chain: _ } => ^locus_not_carried_masked_bare
        AssembleMissingModule { requested: _ } => ^locus_not_carried_missing_module
        MissingModuleIdentityUnavailable => ^locus_not_carried_missing_identity
        OtherAssembleRefusal { reason: _, at: a } =>
          match a {
            CauseLocationTextual { file: f, extent: _ } => f
            CauseLocationUnavailable { reason: u } => u
          }
      }
  }
}

fn readout_assemble_cause_locus_extent() -> Symbol {
  match readout_receipt().assemble_detail {
    NoFrontierProbeDetail => ^no_assemble_detail
    AssembleRejectionDetail { rejection_chain: _, cause: c, at: _ } =>
      match c {
        GrammarChoiceOverlap { rows: _ } => ^not_other_refusal
        MaskedAssembleRefusal { overlap_evidence: _, remaining_chain: _ } => ^not_other_refusal
        MaskedAssembleRefusalWithoutEvidence { remaining_chain: _ } => ^not_other_refusal
        AssembleMissingModule { requested: _ } => ^not_other_refusal
        MissingModuleIdentityUnavailable => ^not_other_refusal
        OtherAssembleRefusal { reason: _, at: a } =>
          match a {
            CauseLocationTextual { file: _, extent: e } =>
              match e {
                WholeFile => ^extent_whole_file
                ByteRange { start: _, end: _ } => ^extent_byte_range
              }
            CauseLocationUnavailable { reason: u } => u
          }
      }
  }
}
