module v2.test.long.cwc_resolution_probe

import v2.compiler.normalized_tree { NormalizedTree }
import v2.compiler.normalize { normalize }
import v2.compiler.tokenize { tokenize }
import v2.std.diagnostic { diagnostics_fatal_reason }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data cwc_src_type_two: String = "module probe\ntype T = A | B\n"
data cwc_src_type_three: String = "module probe\ntype T = A | B | C\n"
data cwc_src_type_review: String = "module probe\ntype ReviewEvent = Approve | RequestChanges | Comment | Pending\n"

data cwc_src_type_scalar: String = "module probe\ntype T = Int\n"

data cwc_src_type_malformed_coproduct: String = "module probe\ntype T = { x: Int } | B | C\n"

data cwc_src_cwc_module: String = "module probe\ntype VariantNaming = AsAuthored | ScreamingSnakeCase\ntype VariantEncoding = StringVariant { naming: VariantNaming }\ntype CoproductWireContract { coproduct: String, encoding: VariantEncoding }\ntype ReviewEvent = Approve | RequestChanges | Comment | Pending\ndata review_event_wire_contract: CoproductWireContract = { coproduct: \"ReviewEvent\", encoding: StringVariant { naming: ScreamingSnakeCase } }\n"

fn cwc_norm_of(src: String) -> Outcome<NormalizedTree> {
  let lm = dag_language_model()
  bind_outcome(
    o: tokenize(text: src, file: ^cwc_probe_file, rules: lm.lex),
    f: fn(toks) {
      bind_outcome(o: parse(tokens: toks, grammar: lm.grammar), f: fn(ptree) {
        normalize(parse_tree: ptree)
      })
    }
  )
}

fn cwc_norm_accepts(src: String) -> Bool {
  match cwc_norm_of(src: src) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn cwc_norm_two_variant_accepts() -> Bool {
  cwc_verdicts().norm_two_variant_accepts
}

test fn cwc_norm_three_variant_accepts() -> Bool {
  cwc_verdicts().norm_three_variant_accepts
}

fn cwc_tree_has_disj_algebra() -> NodeFold<Bool> {
  NodeFold {
    init: fn(node) {
      match node.kind {
        TypeNode { connective: Disj } => true
        _ => false
      }
    },
    step: fn(acc, _edge, child_acc) {
      if acc {
        true
      } else {
        child_acc
      }
    }
  }
}

fn cwc_tree_has_disj(n: Node) -> Bool {
  fold_node(n: n, algebra: cwc_tree_has_disj_algebra())
}

fn cwc_disj_arm_count_algebra() -> NodeFold<Int> {
  NodeFold {
    init: fn(node) {
      match node.kind {
        TypeNode { connective: Disj } => count(node.children)
        _ => 0
      }
    },
    step: fn(acc, _edge, child_acc) {
      if acc > 0 {
        acc
      } else {
        child_acc
      }
    }
  }
}

fn cwc_disj_arm_count(n: Node) -> Int {
  fold_node(n: n, algebra: cwc_disj_arm_count_algebra())
}

fn cwc_norm_rejects(src: String) -> Bool {
  match cwc_norm_of(src: src) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

test fn cwc_non_coproduct_rhs_passes_through() -> Bool {
  cwc_verdicts().non_coproduct_rhs_passes_through
}

// A coproduct arm with no constructor name cannot be built or matched, so normalize owes a refusal.
// This claim is RED today: normalize and resolve both accept the source. It is the one claim over
// this shape; its negation used to stand beside it as a second test fn, so one of the pair was red
// whatever normalize did, and neither discriminated.
test fn cwc_malformed_nary_coproduct_normalize_rejects() -> Bool {
  cwc_verdicts().malformed_nary_coproduct_normalize_rejects
}

test fn cwc_norm_review_event_accepts() -> Bool {
  cwc_verdicts().norm_review_event_accepts
}

fn cwc_resolve_accepts(src: String) -> Bool {
  let lm = dag_language_model()
  match cwc_norm_of(src: src) {
    Accepted { value: tree, diagnostics: _ } =>
      match v2.compiler.resolve.resolve(tree: tree, lm: lm) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn cwc_cwc_module_resolve_accepts() -> Bool {
  cwc_verdicts().cwc_module_resolve_accepts
}

// The single-tree door (v2.compiler.resolve build_program_namespace) binds a module's own variants
// and record declarations. Each was refused on that door before it carried the module's path and
// record names: a variant in value position as resolve_reason_unbound_symbol, a headless record
// literal as resolve_anonymous_record_expected_type_not_record.
data cwc_src_variant_value: String = "module probe\ntype U = U1 | U2\ndata u: U = U1\n"
data cwc_src_record_headless: String = "module probe\ntype U = U1 | U2\ntype W { a: U, b: U }\ndata w: W = { a: U1, b: U2 }\n"
data cwc_src_variant_absent: String = "module probe\ntype U = U1 | U2\ndata u: U = U3\n"
data cwc_src_headless_at_coproduct: String = "module probe\ntype U = U1 | U2\ndata u: U = { a: U1 }\n"

fn cwc_resolve_refuses_with(src: String, reason: Symbol) -> Bool {
  let lm = dag_language_model()
  match cwc_norm_of(src: src) {
    Accepted { value: tree, diagnostics: _ } =>
      match v2.compiler.resolve.resolve(tree: tree, lm: lm) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: d } => diagnostics_fatal_reason(d: d) == reason
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn cwc_single_tree_variant_value_resolves() -> Bool {
  cwc_verdicts().single_tree_variant_value_resolves
}

test fn cwc_single_tree_headless_record_resolves() -> Bool {
  cwc_verdicts().single_tree_headless_record_resolves
}

// Controls: the door still refuses what it should, at the same reasons.
test fn cwc_single_tree_undeclared_variant_refuses() -> Bool {
  cwc_verdicts().single_tree_undeclared_variant_refuses
}

test fn cwc_single_tree_headless_at_coproduct_refuses() -> Bool {
  cwc_verdicts().single_tree_headless_at_coproduct_refuses
}

test fn cwc_review_normalized_has_disj() -> Bool {
  cwc_verdicts().review_normalized_has_disj
}

test fn cwc_review_disj_has_four_arms() -> Bool {
  cwc_verdicts().review_disj_has_four_arms
}

// EVERY VERDICT IS COMPUTED ONCE. Each source pays a full tokenize -> parse -> normalize (and
// resolve, for the resolve claims); computed per claim frame, each claim ran over the required
// floor's new-witness margin (v2.workflow.required_floor claim_eval_step_budget_for_identity).
// The stored value is Bools only (no Node, no closure), so it is portable, and cwc_verdicts is
// enrolled warm in v2.workflow.floor_pure_producer_share floor_cross_claim_pure_producers_warm.
type CwcVerdicts {
  norm_two_variant_accepts: Bool,
  norm_three_variant_accepts: Bool,
  non_coproduct_rhs_passes_through: Bool,
  malformed_nary_coproduct_normalize_rejects: Bool,
  norm_review_event_accepts: Bool,
  cwc_module_resolve_accepts: Bool,
  single_tree_variant_value_resolves: Bool,
  single_tree_headless_record_resolves: Bool,
  single_tree_undeclared_variant_refuses: Bool,
  single_tree_headless_at_coproduct_refuses: Bool,
  review_normalized_has_disj: Bool,
  review_disj_has_four_arms: Bool,
}

fn cwc_verdicts() -> CwcVerdicts {
  CwcVerdicts {
    norm_two_variant_accepts: cwc_verdict_norm_two_variant_accepts(),
    norm_three_variant_accepts: cwc_verdict_norm_three_variant_accepts(),
    non_coproduct_rhs_passes_through: cwc_verdict_non_coproduct_rhs_passes_through(),
    malformed_nary_coproduct_normalize_rejects: cwc_verdict_malformed_nary_coproduct_normalize_rejects(),
    norm_review_event_accepts: cwc_verdict_norm_review_event_accepts(),
    cwc_module_resolve_accepts: cwc_verdict_cwc_module_resolve_accepts(),
    single_tree_variant_value_resolves: cwc_verdict_single_tree_variant_value_resolves(),
    single_tree_headless_record_resolves: cwc_verdict_single_tree_headless_record_resolves(),
    single_tree_undeclared_variant_refuses: cwc_verdict_single_tree_undeclared_variant_refuses(),
    single_tree_headless_at_coproduct_refuses: cwc_verdict_single_tree_headless_at_coproduct_refuses(),
    review_normalized_has_disj: cwc_verdict_review_normalized_has_disj(),
    review_disj_has_four_arms: cwc_verdict_review_disj_has_four_arms(),
  }
}

fn cwc_verdict_norm_two_variant_accepts() -> Bool {
  cwc_norm_accepts(src: cwc_src_type_two)
}

fn cwc_verdict_norm_three_variant_accepts() -> Bool {
  cwc_norm_accepts(src: cwc_src_type_three)
}

fn cwc_verdict_non_coproduct_rhs_passes_through() -> Bool {
  match cwc_norm_of(src: cwc_src_type_scalar) {
    Accepted { value: root, diagnostics: _ } => !cwc_tree_has_disj(n: root.root)
    Rejected { diagnostics: _ } => false
  }
}

fn cwc_verdict_malformed_nary_coproduct_normalize_rejects() -> Bool {
  cwc_norm_rejects(src: cwc_src_type_malformed_coproduct)
}

fn cwc_verdict_norm_review_event_accepts() -> Bool {
  cwc_norm_accepts(src: cwc_src_type_review)
}

fn cwc_verdict_cwc_module_resolve_accepts() -> Bool {
  cwc_resolve_accepts(src: cwc_src_cwc_module)
}

fn cwc_verdict_single_tree_variant_value_resolves() -> Bool {
  cwc_resolve_accepts(src: cwc_src_variant_value)
}

fn cwc_verdict_single_tree_headless_record_resolves() -> Bool {
  cwc_resolve_accepts(src: cwc_src_record_headless)
}

fn cwc_verdict_single_tree_undeclared_variant_refuses() -> Bool {
  cwc_resolve_refuses_with(src: cwc_src_variant_absent, reason: ^resolve_reason_unbound_symbol)
}

fn cwc_verdict_single_tree_headless_at_coproduct_refuses() -> Bool {
  cwc_resolve_refuses_with(src: cwc_src_headless_at_coproduct, reason: ^resolve_anonymous_record_expected_type_not_record)
}

fn cwc_verdict_review_normalized_has_disj() -> Bool {
  match cwc_norm_of(src: cwc_src_type_review) {
    Accepted { value: root, diagnostics: _ } => cwc_tree_has_disj(n: root.root)
    Rejected { diagnostics: _ } => false
  }
}

fn cwc_verdict_review_disj_has_four_arms() -> Bool {
  match cwc_norm_of(src: cwc_src_type_review) {
    Accepted { value: root, diagnostics: _ } => cwc_disj_arm_count(n: root.root) == 4
    Rejected { diagnostics: _ } => false
  }
}
