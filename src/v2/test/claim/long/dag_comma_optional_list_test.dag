module v2.test.long.dag_comma_optional_list


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn parses(src: String) -> Bool {
  let lm = dag_language_model()
  match tokenize(text: src, file: ^probe, rules: lm.lex) {
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn comma_optional_two_newline_fields_accepts_holds() -> Bool {
  parses(src: "module m.t\ntype Foo {\n  a: Int\n  b: Int\n}\n")
}

test fn comma_optional_record_payload_newline_accepts_holds() -> Bool {
  parses(src: "module m.t\ntype X = Foo {\n  a: Int\n  b: Int\n}\n")
}

test fn comma_optional_comma_separated_still_accepts_holds() -> Bool {
  parses(src: "module m.t\ntype Foo {\n  a: Int,\n  b: Int\n}\n")
}

test fn comma_optional_one_field_still_accepts_holds() -> Bool {
  parses(src: "module m.t\ntype Foo {\n  a: Int\n}\n")
}

test fn comma_optional_missing_colon_field_rejects_control_holds() -> Bool {
  match parses(src: "module m.t\ntype Foo {\n  a: Int\n  b\n}\n") {
    true => false
    false => true
  }
}
