fn edge_list_prepend(item: Edge, xs: List<Edge>) -> List<Edge> {
  Cons { head: item, tail: xs }
}

fn no_edges() -> List<Edge> {
  Empty
}

fn opaque_head_node() -> Node {
  Node { kind: TypeNode { connective: Conj }, children: [], occurrence_id: SyntheticOccurrence }
}

fn edge_target_is_mystery(e: Edge) -> Bool {
  match v2.std.grammar.node_atom_identity_optional(node: e.target) {
    Present { value: id } => id == ^mystery_op
    Absent => false
  }
}

fn edge_is_seq_left(e: Edge) -> Bool {
  match e.label {
    Named { name: nm } => nm == ^grammar_sequence_left_node_projection
    Positional => false
  }
}

fn rebuilt_edge(e: Edge) -> Edge {
  if edge_is_seq_left(e: e) {
    if edge_target_is_mystery(e: e) {
      Edge { label: e.label, target: opaque_head_node() }
    } else {
      Edge { label: e.label, target: break_mystery_head(n: e.target) }
    }
  } else {
    Edge { label: e.label, target: break_mystery_head(n: e.target) }
  }
}

fn break_mystery_head(n: Node) -> Node {
  Node {
    kind: n.kind,
    children: v2.std.algebra.list_reverse(xs: fold(n.children, init: no_edges(), f: fn(acc, e) {
      edge_list_prepend(item: rebuilt_edge(e: e), xs: acc)
    })),
    occurrence_id: n.occurrence_id
  }
}

test fn unreadable_call_head_with_carrier_port_refuses() -> Bool {
  match ingest(source_text: unregistered_combiner_snippet, file: ^brokenhead_file) {
    Absent => false
    Present { value: tree } =>
      v2.lens.complexity_accumulator_copy.analyze.findings_have_refusal_cause(
        fs: v2.lens.complexity_accumulator_copy.analyze.accumulator_copy_findings(root: break_mystery_head(n: tree)),
        cause: ^call_head_unreadable
      )
  }
}

