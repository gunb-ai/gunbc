// GREEN since gunbc#11322 carries the let remainder Loop-first; was rostered RED. A plain fn, not a
// test fn: an ingest-reaching identity newly enrolled after gunbc#11195 is judged at the
// 100ms-equivalent tier and refused, so it joins gunbc.rung_drop
// accumulator_copy_positive_controls_off_every_lane's population and executes under claim_batch.
fn let_prefixed_fold_copy_is_caught() -> Bool {
  match findings_of(source_text: let_prefixed_planted_snippet, file: ^letplanted_file) {
    Absent => false
    Present { value: fs } => v2.lens.complexity_accumulator_copy.analyze.findings_have_suspect(fs: fs)
  }
}

// GREEN since gunbc#11322 lowers match-arm bodies through call apply; was rostered RED. Plain fn
// on the same standing as its let_prefixed sibling above.
fn match_arm_fold_copy_is_caught() -> Bool {
  match findings_of(source_text: match_arm_planted_snippet, file: ^matchplanted_file) {
    Absent => false
    Present { value: fs } => v2.lens.complexity_accumulator_copy.analyze.findings_have_suspect(fs: fs)
  }
}

// RED, rostered at gunbc.explicit_witness_admission: the by-name step's accumulator flow. This is
// the CAPABILITY witness for the by-name half of fold_shape_visible_to_no_lens, stronger than
// named_step_fold_refuses_accumulator_unread: a declared step with a planted copy must mint a
// suspect, not merely a refusal, once the site is visible and the step is resolved.
test fn declared_named_step_fold_copy_is_caught() -> Bool {
  match findings_of(source_text: declared_named_step_planted_snippet, file: ^declstep_file) {
    Absent => false
    Present { value: fs } => v2.lens.complexity_accumulator_copy.analyze.findings_have_suspect(fs: fs)
  }
}

// POSITIVE CONTROL, green today: both folds of the nested specimen are counted and the inner
// planted copy is caught -- the inner fold survives as a SURFACE call inside the outer seam Loop's
// retained body, so count_fold_sites's surface arm fires here. A change that makes this go red
// has narrowed the lens's domain.
//
// A PLAIN fn RATHER THAN A test fn, on the standing v2.test.claim.complexity
// accumulator_copy_corpus_path_test records for its own ingest-reaching predicates: this control
// reaches the interpreted ingest, which measures several times
// v2.workflow.required_floor required_floor_claim_cpu_safety_limit_ms (1732ms CPU on run
// 34786156711 against a 500ms line), and a NEWLY ENROLLED identity over that line is refused at
// enrolment margin -- the unchanged test fns of this file sit outside per-PR discovery and are
// not re-measured, which is why they are not refused and why this cannot simply join them. It
// passes by execution under claim_batch beside the three RED probes above and is enrolled in
// nothing; it dissolves into a test fn on the same trigger as its corpus-path siblings.
fn nested_fold_inside_a_sole_body_fold_is_visible() -> Bool {
  match ingest(source_text: nested_planted_snippet, file: ^nestedplanted_file) {
    Absent => false
    Present { value: tree } =>
      let r = v2.lens.complexity_accumulator_copy.analyze.accumulator_copy_report(root: tree)
      (r.folds_seen == 2) && (r.carriers_bound == 2)
        && v2.lens.complexity_accumulator_copy.analyze.findings_have_suspect(fs: r.findings)
  }
}

// PLAIN fns, on the same standing as nested_fold_inside_a_sole_body_fold_is_visible below: both
// reach the interpreted ingest. They pass by execution under claim_batch.
//
// RED CONTROL for the step-slot read: a lambda in a non-step argument must not become the step.
// Went from loop=yes to loop=no between 42e5937 and a5f5585; a reading that searches the whole
// call for a lambda makes this go red again.
fn a_lambda_in_a_non_step_argument_mints_no_carrier() -> Bool {
  match ingest(source_text: by_name_step_with_lambda_in_other_argument_snippet, file: ^decoylambda_file) {
    Absent => false
    Present { value: tree } =>
      let r = v2.lens.complexity_accumulator_copy.analyze.accumulator_copy_report(root: tree)
      (r.carriers_bound == 0)
        && !v2.lens.complexity_accumulator_copy.analyze.tree_contains_lowered_loop(root: tree)
  }
}

// POSITIVE CONTROL: the same decoy beside a real inline step still lowers and the planted copy on
// the real carrier is caught. Without this the red control is satisfiable by refusing every fold.
fn an_inline_step_beside_a_decoy_lambda_is_still_caught() -> Bool {
  match ingest(source_text: inline_step_beside_lambda_in_other_argument_snippet, file: ^decoylambdactrl_file) {
    Absent => false
    Present { value: tree } =>
      let r = v2.lens.complexity_accumulator_copy.analyze.accumulator_copy_report(root: tree)
      (r.folds_seen == 1) && (r.carriers_bound == 1)
        && v2.lens.complexity_accumulator_copy.analyze.findings_have_suspect(fs: r.findings)
  }
}

