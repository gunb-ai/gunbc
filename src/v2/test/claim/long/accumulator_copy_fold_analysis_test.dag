module v2.test.long.accumulator_copy_fold_analysis

import v2.std.algebra { Cons, Empty }


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data quadratic_snippet: String = "module quad\n\nfn f(xs: List<Int>) -> Int {\n  fold(xs, init: 0, f: fn(acc, x) { list_append(left: x, right: acc) })\n}\n"

data noncarrier_name_snippet: String = "module lin\n\nfn f(xs: List<Int>) -> Int {\n  fold(xs, init: 0, f: fn(acc, x) { list_append(left: acc, right: x) })\n}\n"

data identity_snippet: String = "module ident\n\nfn f(xs: List<Int>) -> Int {\n  fold(xs, init: 0, f: fn(acc, x) { acc })\n}\n"

data real_branch_body_snippet: String = "module rs\n\nfn g(xs: List<Int>) -> Int {\n  fold_list(xs: xs, empty: Empty, cons: fn(acc, r) {\n    if pred(r: r) {\n      list_append(left: Cons { head: r, tail: Empty }, right: acc)\n    } else {\n      acc\n    }\n  })\n}\n"

data let_alias_snippet: String = "module alias\n\nfn f(xs: List<Int>) -> Int {\n  fold(xs, init: 0, f: fn(acc, x) {\n    let grown = acc\n    list_append(left: x, right: grown)\n  })\n}\n"

data nested_call_snippet: String = "module nested\n\nfn f(xs: List<Int>) -> Int {\n  fold(xs, init: 0, f: fn(acc, x) { list_append(left: x, right: reverse(acc)) })\n}\n"

data unregistered_combiner_snippet: String = "module unreg\n\nfn f(xs: List<Int>) -> Int {\n  fold(xs, init: 0, f: fn(acc, x) { mystery_op(a: acc, b: x) })\n}\n"

data compound_copied_port_snippet: String = "module compound\n\nfn f(xs: List<Int>) -> Int {\n  fold(xs, init: 0, f: fn(acc, x) { list_append(left: x, right: x + acc) })\n}\n"

data out_of_iteration_snippet: String = "module once\n\nfn f(xs: List<Int>, ys: List<Int>) -> Int {\n  list_append(left: xs, right: ys)\n}\n"

data named_step_snippet: String = "module namedstep\n\nfn f(xs: List<Int>) -> Int {\n  fold(xs, init: 0, f: step)\n}\n"

// THE POSITION SPECIMENS, one per body position the source admits a fold in. Each is the
// quadratic_snippet's planted copy (fold / list_append with the carrier on the copied port) moved
// to a different position of an fn body and nothing else changed, so what a witness over one of
// them answers is about POSITION and not about spelling or about the combiner. Measured on the
// tokenize / parse_module / normalize route (gunbc.recurring_failure_mode
// fold_shape_visible_to_no_lens, receipts of 2026-09-13): the sole-body fold lowers to the seam
// Loop the lens enumerates; the same fold after a `let`, in a `match` arm or in an `if` branch
// reaches normalize's output with its arguments erased, so no Loop, no surface fold call and no
// site -- the class gunbc.recurring_failure_mode call_expression_erased_at_v2_body_lowering, seen
// from the lens's side. A fold NESTED inside a sole-body fold's step keeps its surface form
// inside the retained Loop body and IS seen, which is the control that shows the surface arm of
// count_fold_sites is reachable and not permanently green.
data let_prefixed_planted_snippet: String = "module letplanted\n\nfn f(xs: List<Int>) -> Int {\n  let seed = 0\n  fold(xs, init: seed, f: fn(acc, x) { list_append(left: x, right: acc) })\n}\n"

data match_arm_planted_snippet: String = "module matchplanted\n\nfn f(xs: List<Int>, b: Bool) -> Int {\n  match b {\n    true => fold(xs, init: 0, f: fn(acc, x) { list_append(left: x, right: acc) })\n    false => 0\n  }\n}\n"

data nested_planted_snippet: String = "module nestedplanted\n\nfn f(xs: List<List<Int>>) -> Int {\n  fold(xs, init: 0, f: fn(acc, ys) { fold(ys, init: acc, f: fn(a2, y) { list_append(left: y, right: a2) }) })\n}\n"

// THE BY-NAME CAPABILITY SPECIMEN: the step is DECLARED in the same module and carries the planted
// copy in its own body, so the accumulator flow the class names is authored and readable -- the
// step's Arrow member sits in the normalized root with `acc` as its first domain binding
// (v2.std.node_query arrow_domain_named_param_bindings reads it). What is missing is the SITE: the
// call `fold(xs, init: 0, f: step)` is erased before any lens runs.
data declared_named_step_planted_snippet: String = "module declstep\n\nfn step(acc: Int, x: Int) -> Int {\n  list_append(left: x, right: acc)\n}\n\nfn f(xs: List<Int>) -> Int {\n  fold(xs, init: 0, f: step)\n}\n"

// THE STEP-SLOT DISCRIMINATOR IN THE OTHER DIRECTION (review 65763 on gunbc#11315). The step is
// BY NAME and a two-binder lambda sits in the NON-step argument. Before v2.compiler.fold_lowering
// read the step at the callee-declared slot, fold_call_step_form found that lambda by whole-subtree
// first match and minted a seam Loop whose carrier was `a` -- measured on 42e5937 (folds_seen 1,
// carriers_bound 1, loop yes). At the slot read (a5f5585 and after) the call yields no Loop: the
// step slot carries no inline form, which is StepByName and the honest no-Loop state. Its twin
// puts the planted copy IN the slot beside the same decoy and must still lower and be caught.
data by_name_step_with_lambda_in_other_argument_snippet: String = "module decoylambda\n\nfn f(xs: List<Int>) -> Int {\n  fold(map(xs, f: (a, b) => list_append(left: b, right: a)), init: 0, f: step)\n}\n"

data inline_step_beside_lambda_in_other_argument_snippet: String = "module decoylambdactrl\n\nfn f(xs: List<Int>) -> Int {\n  fold(map(xs, f: (a, b) => a), init: 0, f: (acc, x) => list_append(left: x, right: acc))\n}\n"

data let_unknown_alias_snippet: String = "module unknownalias\n\nfn f(xs: List<Int>) -> Int {\n  fold(xs, init: 0, f: fn(acc, x) {\n    let grown = mystery\n    list_append(left: x, right: grown)\n  })\n}\n"

data let_fresh_snippet: String = "module freshlet\n\nfn f(xs: List<Int>) -> Int {\n  fold(xs, init: 0, f: fn(acc, x) {\n    let seed = 0\n    list_append(left: x, right: seed)\n  })\n}\n"

data let_transitive_alias_snippet: String = "module transalias\n\nfn f(xs: List<Int>) -> Int {\n  fold(xs, init: 0, f: fn(acc, x) {\n    let g = acc\n    let h = g\n    list_append(left: x, right: h)\n  })\n}\n"

data carrier_in_computed_arg_snippet: String = "module hiddencarrier\n\nfn f(xs: List<Int>) -> Int {\n  fold(xs, init: 0, f: fn(acc, x) {\n    mystery(box: Wrapped { inner: acc })\n  })\n}\n"

data item_in_computed_arg_snippet: String = "module hiddenitem\n\nfn f(xs: List<Int>) -> Int {\n  fold(xs, init: 0, f: fn(acc, x) {\n    mystery(box: Wrapped { inner: x })\n  })\n}\n"

data computed_let_mention_snippet: String = "module hiddenlet\n\nfn f(xs: List<Int>) -> Int {\n  fold(xs, init: 0, f: fn(acc, x) {\n    let boxed = Wrapped { inner: acc }\n    mystery(box: boxed)\n  })\n}\n"

data projection_call_carrier_snippet: String = "module projcar\n\nfn f(xs: List<Int>) -> Int {\n  fold(xs, init: 0, f: fn(acc, x) {\n    helper.step(a: acc, b: x)\n  })\n}\n"

data multiline_unregistered_snippet: String = "module unreg\n\nfn f(xs: List<Int>) -> Int {\n  fold(xs, init: 0, f: fn(acc, x) {\n    mystery_op(a: acc, b: x)\n  })\n}\n"

fn ingest(source_text: String, file: Symbol) -> Optional<Node> {
  let lm = v2.extdeps.languages.dag.dag_language_model()
  match v2.compiler.tokenize.tokenize(text: source_text, file: file, rules: lm.lex) {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: ts, diagnostics: _ } =>
      match v2.compiler.parse.parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: _ } => Absent
        Accepted { value: artifact, diagnostics: _ } =>
          match v2.compiler.normalize.normalize(parse_tree: artifact.tree) {
            Rejected { diagnostics: _ } => Absent
            Accepted { value: normalized, diagnostics: _ } => Present { value: normalized.root }
          }
      }
  }
}

fn findings_of(source_text: String, file: Symbol) -> Optional<List<v2.lens.complexity_accumulator_copy.Finding>> {
  match ingest(source_text: source_text, file: file) {
    Absent => Absent
    Present { value: tree } => Present { value: v2.lens.complexity_accumulator_copy.analyze.accumulator_copy_findings(root: tree) }
  }
}

fn is_empty_findings(fs: List<v2.lens.complexity_accumulator_copy.Finding>) -> Bool {
  match fs {
    Empty => true
    Cons { head: _, tail: _ } => false
  }
}

test fn quadratic_fold_has_suspect() -> Bool {
  match findings_of(source_text: quadratic_snippet, file: ^quad_file) {
    Absent => false
    Present { value: fs } => v2.lens.complexity_accumulator_copy.analyze.findings_have_suspect(fs: fs)
  }
}

