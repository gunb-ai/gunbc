module v2.test.claim.long.effect_reach_test


data sn_source_rel_path: String = "src/v2/compiler/03_normalize.dag"

data fixture_transport_facts: List<v2.lens.witness_cost_locality.ModuleImportFact> = [
  v2.lens.witness_cost_locality.ModuleImportFact {
    module: "fix.witness",
    imports: ["fix.transport", "fix.std_logic"]
  },
  v2.lens.witness_cost_locality.ModuleImportFact { module: "fix.transport", imports: ["fix.harness"] },
  v2.lens.witness_cost_locality.ModuleImportFact { module: "fix.harness", imports: [] }
]

data fixture_severed_facts: List<v2.lens.witness_cost_locality.ModuleImportFact> = [
  v2.lens.witness_cost_locality.ModuleImportFact { module: "fix.witness", imports: ["fix.std_logic"] }
]

data fixture_hermetic_facts: List<v2.lens.witness_cost_locality.ModuleImportFact> = [
  v2.lens.witness_cost_locality.ModuleImportFact { module: "fix.hermetic_witness", imports: ["fix.std_logic"] }
]

data fixture_path_data_inits: List<v2.std.data_index.DataInitDecl> = [
  v2.std.data_index.DataInitDecl {
    qualified_name: "fix.transport.sn_source_rel",
    module: "fix.transport",
    name: "sn_source_rel",
    literal_fp: "str:\"src/v2/compiler/03_normalize.dag\""
  }
]

data fixture_empty_data_inits: List<v2.std.data_index.DataInitDecl> = []

// Explicit fixture standing in for `decls` on every synthetic "fix.*" specimen below.
// call_reachable_decls filters decls by qualified-name membership in the fixture's own
// closure_modules ("fix.*"), and no real corpus decl is ever named "fix.*" — so the
// live-scan result is filtered to nothing for these specimens regardless, and substituting
// it costs a whole-tree scan for zero signal (DESIGN §5 witness-cost-derives-from-purpose:
// a test is not entitled to arbitrary computation merely because it is a test). Only the
// one named live integration below (effect_reach_live_03_normalize_witness_derived_host_reading_holds)
// legitimately reads fn_arrow_decl_facts_live().
data fixture_empty_decls: List<v2.std.fn_index.FnArrowDecl> = []

data fixture_prose_facts: List<v2.lens.witness_cost_locality.ModuleImportFact> = [
  v2.lens.witness_cost_locality.ModuleImportFact { module: "fix.prose_witness", imports: ["fix.std_logic"] }
]

data fixture_prose_doc_inits: List<v2.std.data_index.DataInitDecl> = [
  v2.std.data_index.DataInitDecl {
    qualified_name: "fix.prose_witness.witness_doc",
    module: "fix.prose_witness",
    name: "witness_doc",
    literal_fp: "str:\"receipt cites src/v2/compiler/03_normalize.dag but never reads it\""
  }
]

data fixture_concat_path_facts: List<v2.lens.witness_cost_locality.ModuleImportFact> = [
  v2.lens.witness_cost_locality.ModuleImportFact {
    module: "fix.concat_witness",
    imports: ["fix.concat_transport", "fix.std_logic"]
  },
  v2.lens.witness_cost_locality.ModuleImportFact { module: "fix.concat_transport", imports: [] }
]

data fixture_concat_path_data_inits: List<v2.std.data_index.DataInitDecl> = [
  v2.std.data_index.DataInitDecl {
    qualified_name: "fix.concat_transport.sn_path_prefix",
    module: "fix.concat_transport",
    name: "sn_path_prefix",
    literal_fp: "str:\"src/\""
  },
  v2.std.data_index.DataInitDecl {
    qualified_name: "fix.concat_transport.sn_path_suffix",
    module: "fix.concat_transport",
    name: "sn_path_suffix",
    literal_fp: "str:\"v2/compiler/03_normalize.dag\""
  }
]

fn transport_classification() -> v2.std.effect_reach.EffectReachClassification {
  v2.lens.effect_reach.effect_reach_classification_from_facts(
    entry_module: "fix.witness",
    facts: fixture_transport_facts,
    decls: fixture_empty_decls,
    data_inits: fixture_path_data_inits
  )
}

test fn effect_reach_path_data_init_derived_host_reading_holds() -> v2.std.logic.Bool {
  v2.lens.effect_reach.derived_host_reading(classification: transport_classification())
}

test fn effect_reach_path_data_init_red_when_import_severed_holds() -> v2.std.logic.Bool {
  let c = v2.lens.effect_reach.effect_reach_classification_from_facts(
    entry_module: "fix.witness",
    facts: v2.test.claim.long.effect_reach_test.fixture_severed_facts,
    decls: fixture_empty_decls,
    data_inits: fixture_path_data_inits
  )
  v2.lens.effect_reach.classification_is_local(classification: c)
}

test fn effect_reach_path_touch_selects_on_normalize_path_holds() -> v2.std.logic.Bool {
  v2.lens.effect_reach.effect_reach_touched_by_paths(
    classification: transport_classification(),
    touched_paths: [sn_source_rel_path]
  )
}

test fn effect_reach_unrelated_path_does_not_select_holds() -> v2.std.logic.Bool {
  !v2.lens.effect_reach.effect_reach_touched_by_paths(
    classification: transport_classification(),
    touched_paths: ["src/v2/std/logic.dag"]
  )
}

test fn effect_reach_hermetic_fixture_stays_local_holds() -> v2.std.logic.Bool {
  let c = v2.lens.effect_reach.effect_reach_classification_from_facts(
    entry_module: "fix.hermetic_witness",
    facts: fixture_hermetic_facts,
    decls: fixture_empty_decls,
    data_inits: fixture_empty_data_inits
  )
  v2.lens.effect_reach.classification_is_local(classification: c)
    && v2.lens.effect_reach.effect_reach_flow_count(classification: c) == 0
}

test fn effect_reach_prose_string_path_does_not_classify_holds() -> v2.std.logic.Bool {
  let c = v2.lens.effect_reach.effect_reach_classification_from_facts(
    entry_module: "fix.prose_witness",
    facts: fixture_prose_facts,
    decls: fixture_empty_decls,
    data_inits: fixture_prose_doc_inits
  )
  v2.lens.effect_reach.classification_is_local(classification: c)
    && !v2.lens.effect_reach.derived_host_reading(classification: c)
    && v2.lens.effect_reach.effect_reach_flow_count(classification: c) == 0
}

fn witness_frontier_concat_built_path_not_classified() -> v2.std.logic.Bool {
  let c = v2.lens.effect_reach.effect_reach_classification_from_facts(
    entry_module: "fix.concat_witness",
    facts: fixture_concat_path_facts,
    decls: fixture_empty_decls,
    data_inits: fixture_concat_path_data_inits
  )
  v2.lens.effect_reach.classification_is_local(classification: c)
    && !v2.lens.effect_reach.derived_host_reading(classification: c)
    && v2.lens.effect_reach.effect_reach_flow_count(classification: c) == 0
}

test fn effect_reach_concat_built_path_frontier_not_classified_holds() -> v2.std.logic.Bool {
  witness_frontier_concat_built_path_not_classified()
}

data live_03_normalize_facts: List<v2.lens.witness_cost_locality.ModuleImportFact> = [
  v2.lens.witness_cost_locality.ModuleImportFact {
    module: "test.claim.self_host_03_normalize_behavioral_witness",
    imports: ["tools.self_host_module_behavioral_transport_roster"]
  },
  v2.lens.witness_cost_locality.ModuleImportFact {
    module: "tools.self_host_module_behavioral_transport_roster",
    imports: [
      "tools.self_host_curated_seed_linked_harness",
      "v2.std.algebra",
      "v2.std.collection",
      "v2.std.logic",
      "v2.std.text"
    ]
  },
  v2.lens.witness_cost_locality.ModuleImportFact {
    module: "tools.self_host_curated_seed_linked_harness",
    imports: [
      "extdeps.shell",
      "extdeps.filesystem.filesystem_io",
      "extdeps.cargo_build",
      "extdeps.git",
      "extdeps.gunbc",
      "std.logic",
      "v2.std.algebra",
      "v2.std.collection",
      "v2.std.text",
      "tools.host_prelude"
    ]
  }
]

data live_03_normalize_data_inits: List<v2.std.data_index.DataInitDecl> = [
  v2.std.data_index.DataInitDecl {
    qualified_name: "tools.self_host_module_behavioral_transport_roster.compiler_module_behavioral_transport_roster",
    module: "tools.self_host_module_behavioral_transport_roster",
    name: "compiler_module_behavioral_transport_roster",
    literal_fp: "str:\"src/v2/compiler/03_normalize.dag\""
  }
]

test fn effect_reach_live_03_normalize_witness_derived_host_reading_holds() -> v2.std.logic.Bool {
  v2.lens.effect_reach.derived_host_reading(
    classification: v2.lens.effect_reach.effect_reach_classification_from_facts(
      entry_module: "test.claim.self_host_03_normalize_behavioral_witness",
      facts: live_03_normalize_facts,
      decls: v2.std.fn_index.fn_arrow_decl_facts_live(),
      data_inits: live_03_normalize_data_inits
    )
  )
}
