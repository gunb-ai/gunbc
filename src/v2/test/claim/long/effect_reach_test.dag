module v2.test.claim.long.effect_reach_test

import std.occurrence_identity { OccurrenceSynthetic }
import v2.lens.effect_reach {
  effect_reach_classification_from_facts,
  derived_host_reading,
  classification_is_local,
  effect_reach_flow_count,
  effect_reach_touched_by_paths
}
import v2.lens.witness_cost_locality { ModuleImportFact }
import v2.std.collection { List }
import v2.std.data_index { DataInitDecl }
import v2.std.effect_reach { EffectReachClassification }
import v2.std.compilers.lexing { symbol_intern_lexeme }
import v2.std.fn_index { FnArrowDecl }
import v2.std.logic { Bool }
import v2.std.node { Atom, ComputationNode, Conj, Edge, Node, Positional, Transform, TypeNode }
import v2.std.text { String }

data sn_source_rel_path: String = "src/v2/compiler/03_normalize.dag"

data fixture_transport_facts: List<ModuleImportFact> = [
  ModuleImportFact {
    module: "fix.witness",
    imports: ["fix.transport", "fix.std_logic"]
  },
  ModuleImportFact { module: "fix.transport", imports: ["fix.harness"] },
  ModuleImportFact { module: "fix.harness", imports: [] }
]

data fixture_severed_facts: List<ModuleImportFact> = [
  ModuleImportFact { module: "fix.witness", imports: ["fix.std_logic"] }
]

data fixture_hermetic_facts: List<ModuleImportFact> = [
  ModuleImportFact { module: "fix.hermetic_witness", imports: ["fix.std_logic"] }
]

data fixture_path_data_inits: List<DataInitDecl> = [
  DataInitDecl {
    qualified_name: "fix.transport.sn_source_rel",
    module: "fix.transport",
    name: "sn_source_rel",
    literal_fp: "str:\"src/v2/compiler/03_normalize.dag\""
  }
]

data fixture_empty_data_inits: List<DataInitDecl> = []

// Explicit fixture standing in for `decls` on EVERY specimen in this module.
// v2.std.fn_index call_reachable_decls filters decls by qualified-name membership in the fixture's own
// closure_modules ("fix.*"), and no real corpus decl is ever named "fix.*" — so the
// live-scan result is filtered to nothing for these specimens regardless, and substituting
// it costs a whole-tree scan for zero signal (DESIGN §5 witness-cost-derives-from-purpose:
// a test is not entitled to arbitrary computation merely because it is a test).
//
// AN EARLIER REVISION OF THIS PARAGRAPH ENDED "Only the one named live integration below
// (effect_reach_live_03_normalize_witness_derived_host_reading_holds) legitimately reads
// fn_arrow_decl_facts_live()", AND THAT SENTENCE WAS FALSE IN BOTH DIRECTIONS. That row passed
// fn_arrow_decl_facts_live() as `decls` while ALSO passing a hand-authored one-element
// live_03_normalize_data_inits as `data_inits`, and in effect_reach_classification_from_facts the
// data-init arm (closure_data_init_path_flows) reads NEITHER decls NOR reachability: a path-shaped
// literal_fp in any closure module yields a GunbcCompileEntrySink flow on its own, so the
// classification was HostEffectReach before the decls argument was consulted at all. MEASURED, both
// arms, via claim_batch on this lens: with decls SUBSTITUTED TO EMPTY and the same hand data_inits,
// derived_host_reading still holds; with the LIVE decls and data_inits EMPTY, derived_host_reading
// is FALSE and effect_reach_flow_count is 0 — the live scan contributes zero flows from this entry.
// So the "live" name and the whole-tree fill it bought were carried entirely by a hand-authored
// fixture arm, which is the decoration DESIGN §4b calls worse than absent because it is cited as
// coverage. The row is deleted rather than renamed because its deciding arm is already enrolled,
// over the identical literal_fp, as effect_reach_path_data_init_derived_host_reading_holds in this module —
// renaming would have kept a §2 duplicate of that row spelled with real module names.
//
// AND NO LIVE ROW IS AUTHORABLE ON THIS LENS TODAY, which is why the deletion leaves no gap to fill
// here: effect_reach_classification_from_facts takes its closure from ModuleImportFact, and
// v2.lens.live_read_classification g2_live_production_boundary_law declares that shape FIXTURE-FACING
// with no live producer in the corpus. A row whose `facts` are hand-authored is a fixture row however
// its other arguments are sourced. The next-rung trigger is that law's own: a live
// ModuleDependencyEdge closure reaching this lens, at which point a genuinely live 03_normalize row
// has a producer to read.
data fixture_empty_decls: List<FnArrowDecl> = []

data fixture_call_channel_facts: List<ModuleImportFact> = [
  ModuleImportFact { module: "fix.call_channel.entry", imports: ["fix.call_channel.helper"] },
  ModuleImportFact { module: "fix.call_channel.helper", imports: [] }
]

fn call_channel_atom(text: String) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: symbol_intern_lexeme(lexeme: text) } },
    children: [],
    occurrence_id: OccurrenceSynthetic
  }
}

fn call_channel_call(callee: String) -> Node {
  Node {
    kind: ComputationNode { behavior: Transform },
    children: [Edge { label: Positional, target: call_channel_atom(text: callee) }],
    occurrence_id: OccurrenceSynthetic
  }
}

fn call_channel_entry(output: Node) -> FnArrowDecl {
  FnArrowDecl {
    qualified_name: "fix.call_channel.entry.seed",
    name: "seed",
    output: output,
    params: []
  }
}

fn call_channel_helper() -> FnArrowDecl {
  FnArrowDecl {
    qualified_name: "fix.call_channel.helper.helper_fn",
    name: "helper_fn",
    output: call_channel_call(callee: "Read"),
    params: []
  }
}

fn call_channel_effect_classification(entry_output: Node) -> EffectReachClassification {
  effect_reach_classification_from_facts(
    entry_module: "fix.call_channel.entry",
    facts: fixture_call_channel_facts,
    decls: [call_channel_entry(output: entry_output), call_channel_helper()],
    data_inits: fixture_empty_data_inits
  )
}

test fn effect_reach_follows_a_structural_call_to_the_sink_helper() -> Bool {
  derived_host_reading(classification: call_channel_effect_classification(
    entry_output: call_channel_call(callee: "helper_fn")
  ))
}

test fn effect_reach_does_not_follow_a_non_call_atom_collision() -> Bool {
  classification_is_local(classification: call_channel_effect_classification(
    entry_output: Node {
      kind: TypeNode { connective: Conj },
      children: [Edge { label: Positional, target: call_channel_atom(text: "helper_fn") }],
      occurrence_id: OccurrenceSynthetic
    }
  ))
}

data fixture_prose_facts: List<ModuleImportFact> = [
  ModuleImportFact { module: "fix.prose_witness", imports: ["fix.std_logic"] }
]

data fixture_prose_doc_inits: List<DataInitDecl> = [
  DataInitDecl {
    qualified_name: "fix.prose_witness.witness_doc",
    module: "fix.prose_witness",
    name: "witness_doc",
    literal_fp: "str:\"receipt cites src/v2/compiler/03_normalize.dag but never reads it\""
  }
]

data fixture_concat_path_facts: List<ModuleImportFact> = [
  ModuleImportFact {
    module: "fix.concat_witness",
    imports: ["fix.concat_transport", "fix.std_logic"]
  },
  ModuleImportFact { module: "fix.concat_transport", imports: [] }
]

data fixture_concat_path_data_inits: List<DataInitDecl> = [
  DataInitDecl {
    qualified_name: "fix.concat_transport.sn_path_prefix",
    module: "fix.concat_transport",
    name: "sn_path_prefix",
    literal_fp: "str:\"src/\""
  },
  DataInitDecl {
    qualified_name: "fix.concat_transport.sn_path_suffix",
    module: "fix.concat_transport",
    name: "sn_path_suffix",
    literal_fp: "str:\"v2/compiler/03_normalize.dag\""
  }
]

fn transport_classification() -> EffectReachClassification {
  effect_reach_classification_from_facts(
    entry_module: "fix.witness",
    facts: fixture_transport_facts,
    decls: fixture_empty_decls,
    data_inits: fixture_path_data_inits
  )
}

test fn effect_reach_path_data_init_derived_host_reading_holds() -> Bool {
  derived_host_reading(classification: transport_classification())
}

test fn effect_reach_path_data_init_red_when_import_severed_holds() -> Bool {
  let c = effect_reach_classification_from_facts(
    entry_module: "fix.witness",
    facts: fixture_severed_facts,
    decls: fixture_empty_decls,
    data_inits: fixture_path_data_inits
  )
  classification_is_local(classification: c)
}

test fn effect_reach_path_touch_selects_on_normalize_path_holds() -> Bool {
  effect_reach_touched_by_paths(
    classification: transport_classification(),
    touched_paths: [sn_source_rel_path]
  )
}

test fn effect_reach_unrelated_path_does_not_select_holds() -> Bool {
  !effect_reach_touched_by_paths(
    classification: transport_classification(),
    touched_paths: ["src/v2/std/logic.dag"]
  )
}

test fn effect_reach_hermetic_fixture_stays_local_holds() -> Bool {
  let c = effect_reach_classification_from_facts(
    entry_module: "fix.hermetic_witness",
    facts: fixture_hermetic_facts,
    decls: fixture_empty_decls,
    data_inits: fixture_empty_data_inits
  )
  classification_is_local(classification: c)
    && effect_reach_flow_count(classification: c) == 0
}

test fn effect_reach_prose_string_path_does_not_classify_holds() -> Bool {
  let c = effect_reach_classification_from_facts(
    entry_module: "fix.prose_witness",
    facts: fixture_prose_facts,
    decls: fixture_empty_decls,
    data_inits: fixture_prose_doc_inits
  )
  classification_is_local(classification: c)
    && !derived_host_reading(classification: c)
    && effect_reach_flow_count(classification: c) == 0
}

fn witness_frontier_concat_built_path_not_classified() -> Bool {
  let c = effect_reach_classification_from_facts(
    entry_module: "fix.concat_witness",
    facts: fixture_concat_path_facts,
    decls: fixture_empty_decls,
    data_inits: fixture_concat_path_data_inits
  )
  classification_is_local(classification: c)
    && !derived_host_reading(classification: c)
    && effect_reach_flow_count(classification: c) == 0
}

test fn effect_reach_concat_built_path_frontier_not_classified_holds() -> Bool {
  witness_frontier_concat_built_path_not_classified()
}
