module v2.test.long.wave1_gate1_c1_copied_port_derivation_witness

import v2.test.lens_cost.arrow_body_cost_domain_excluded {
  arrow_body_cost_domain_excluded_holds
}
import v2.lens.cost.copied_port_citations {
  copied_port_citation_list_append,
  copied_port_citation_list_snoc_item,
  copied_port_citation_map_merge,
  citation_arrow_multi_linear_ambiguous
}
import v2.lens.cost.copied_port_derivation { derive_copied_port_index_from_arrow }
import v2.test.claim.body_lowering.wave1_gate1_c1_copied_port_helpers {
  wave1_gate1_c1_derived_indices_match_retired_registry_holds,
  wave1_gate1_c1_unpriceable_combiner_refuses_holds,
  wave1_gate1_c1_unregistered_combiner_lookup_refuses_holds,
  wave1_gate1_c1_citation_retained_frontier_count_holds
}
import v2.std.collection { Absent, Present }
import v2.std.logic { Bool }

data wave1_gate1_c1_long_witness_note: String = "Wave 1 Gate 1 C1 execution witnesses (long lane): per-combiner derivation greens, domain-exclusion RED, unpriceable refuse, multi-linear-ambiguous refuse — enrolled per-PR via CommitWitnessClaim ExecutionWitnessKind in gunbc.commit_workflow. Fast compile-gate receipts live in self_host/wave1_gate1_c1_copied_port_derivation_witness_test.dag."

test fn wave1_gate1_c1_derived_list_append_index_witness_holds() -> Bool {
  match derive_copied_port_index_from_arrow(
    arrow: copied_port_citation_list_append.arrow
  ) {
    Present { value: idx } => idx == 0
    Absent => false
  }
}

test fn wave1_gate1_c1_derived_list_snoc_index_witness_holds() -> Bool {
  match derive_copied_port_index_from_arrow(
    arrow: copied_port_citation_list_snoc_item.arrow
  ) {
    Present { value: idx } => idx == 0
    Absent => false
  }
}

test fn wave1_gate1_c1_derived_map_merge_index_witness_holds() -> Bool {
  match derive_copied_port_index_from_arrow(
    arrow: copied_port_citation_map_merge.arrow
  ) {
    Present { value: idx } => idx == 1
    Absent => false
  }
}

test fn wave1_gate1_c1_arrow_body_cost_domain_excluded_witness_holds() -> Bool {
  arrow_body_cost_domain_excluded_holds()
}

test fn wave1_gate1_c1_unpriceable_combiner_refusal_witness_holds() -> Bool {
  wave1_gate1_c1_unpriceable_combiner_refuses_holds()
    && wave1_gate1_c1_unregistered_combiner_lookup_refuses_holds()
}

test fn wave1_gate1_c1_multi_linear_ambiguous_refusal_witness_holds() -> Bool {
  match derive_copied_port_index_from_arrow(
    arrow: citation_arrow_multi_linear_ambiguous(
      left_sym: ^copied_port_derivation_test_multi_linear_left,
      right_sym: ^copied_port_derivation_test_multi_linear_right
    )
  ) {
    Absent => true
    Present { value: _ } => false
  }
}

test fn wave1_gate1_c1_derived_registry_execution_witness_holds() -> Bool {
  wave1_gate1_c1_derived_indices_match_retired_registry_holds()
    && wave1_gate1_c1_unpriceable_combiner_refuses_holds()
    && wave1_gate1_c1_unregistered_combiner_lookup_refuses_holds()
    && wave1_gate1_c1_citation_retained_frontier_count_holds()
}
