module v2.test.long.validate_ingest_staging_stage_bisect


data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data bisect_empty_source: Medium<String> = Medium { carried: "module stage0.bisect.empty\n", fidelity: Lossless }
data bisect_add_module_source: Medium<String> = Medium { carried: "module bisect.add\n\nfn add(x:Int, y:Int) -> Int { x + y }", fidelity: Lossless }
data bisect_add_module_truncated_source: Medium<String> = Medium { carried: "module bisect.add\n\nfn add(x:Int, y:Int) -> Int { x + ", fidelity: Lossless }
fn bisect_through_tokenize() -> Outcome<TokenStream> {
  let lm = dag_language_model()
  tokenize(
    text: bisect_empty_source.carried,
    file: ^compile_ingest_staging_source_file,
    rules: lm.lex
  )
}

fn bisect_through_parse() -> Outcome<ParseTree> {
  let lm = dag_language_model()
  bind_outcome(
    o: tokenize(
      text: bisect_empty_source.carried,
      file: ^compile_ingest_staging_source_file,
      rules: lm.lex
    ),
    f: fn(token_stream) {
      parse(tokens: token_stream, grammar: lm.grammar)
    }
  )
}

fn bisect_through_normalize() -> Outcome<Node> {
  let lm = dag_language_model()
  bind_outcome(
    o: tokenize(
      text: bisect_empty_source.carried,
      file: ^compile_ingest_staging_source_file,
      rules: lm.lex
    ),
    f: fn(token_stream) {
      bind_outcome(
        o: parse(tokens: token_stream, grammar: lm.grammar),
        f: fn(parse_tree) {
          normalize(parse_tree: parse_tree)
        }
      )
    }
  )
}

fn bisect_tokenize_terminates() -> Bool {
  match bisect_through_tokenize() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => true
  }
}

fn bisect_parse_terminates() -> Bool {
  match bisect_through_parse() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => true
  }
}

fn bisect_through_grammar_validate() -> Outcome<ValidatedGrammarRoot> {
  let lm = dag_language_model()
  match lm.grammar {
    ModeledGrammar { root: root } =>
      grammar_validate_for_parse(root: root, at: port_locus(port: ^parse_stage_locus_port))
    _ =>
      Rejected { diagnostics: None }
  }
}

fn bisect_grammar_validate_terminates() -> Bool {
  match bisect_through_grammar_validate() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => true
  }
}

fn bisect_through_parse_production() -> Outcome<ParseTree> {
  let lm = dag_language_model()
  bind_outcome(
    o: tokenize(
      text: bisect_empty_source.carried,
      file: ^compile_ingest_staging_source_file,
      rules: lm.lex
    ),
    f: fn(token_stream) {
      bind_outcome(
        o: bisect_through_grammar_validate(),
        f: fn(validated) {
          match lm.grammar {
            ModeledGrammar { root: root } =>
              parse_production_tree(
                tokens: token_stream_remaining(stream: token_stream),
                validated: validated,
                production_name: root.start
              )
            _ =>
              Rejected { diagnostics: None }
          }
        }
      )
    }
  )
}

fn bisect_parse_production_terminates() -> Bool {
  match bisect_through_parse_production() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => true
  }
}

fn bisect_single_module_parse_expr() -> Bool {
  let lm = dag_language_model()
  match lm.grammar {
    ModeledGrammar { root: root } =>
      bind_outcome(
        o: tokenize(
          text: bisect_empty_source.carried,
          file: ^compile_ingest_staging_source_file,
          rules: lm.lex
        ),
        f: fn(token_stream) {
          match grammar_lookup_production(root: root, name: root.start) {
            Holds { value: production } =>
              match parse_expr(
                expr: production.expression,
                tokens: token_stream_remaining(stream: token_stream),
                all_tokens: token_stream_all(stream: token_stream),
                root: root,
                table: parse_table_empty(),
                prov: parse_prov_initial()
              ) {
                ParseExprAccepted { remaining: _, captured: _, diagnostics: _, prov: _, table: _ } =>
                  outcome_accepted(value: true)
                ParseExprRejected { diagnostics: _, table: _ } =>
                  outcome_accepted(value: true)
              }
            Violates { diagnostic: _ } =>
              Rejected { diagnostics: None }
          }
        }
      )
    _ =>
      Rejected { diagnostics: None }
  }
}

fn bisect_single_module_parse_expr_terminates() -> Bool {
  match bisect_single_module_parse_expr() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => true
  }
}

fn bisect_normalize_terminates() -> Bool {
  match bisect_through_normalize() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => true
  }
}

fn bisect_parse_module_add_parse_accepts() -> Bool {
  let lm = dag_language_model()
  match tokenize(
    text: bisect_add_module_source.carried,
    file: ^compile_ingest_staging_source_file,
    rules: lm.lex
  ) {
    Accepted { value: token_stream, diagnostics: _ } =>
      match parse(tokens: token_stream, grammar: lm.grammar) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn bisect_parse_module_add_resolve_accepts() -> Bool {
  let lm = dag_language_model()
  match tokenize(
    text: bisect_add_module_source.carried,
    file: ^compile_ingest_staging_source_file,
    rules: lm.lex
  ) {
    Accepted { value: token_stream, diagnostics: _ } =>
      match parse(tokens: token_stream, grammar: lm.grammar) {
        Accepted { value: parsed, diagnostics: _ } =>
          match normalize(parse_tree: parsed) {
            Accepted { value: normalized, diagnostics: _ } =>
              match resolve(tree: normalized, lm: lm) {
                Accepted { value: _, diagnostics: _ } => true
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn bisect_parse_module_truncated_rejects() -> Bool {
  let lm = dag_language_model()
  match tokenize(
    text: bisect_add_module_truncated_source.carried,
    file: ^compile_ingest_staging_source_file,
    rules: lm.lex
  ) {
    Accepted { value: token_stream, diagnostics: _ } =>
      match parse(tokens: token_stream, grammar: lm.grammar) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: _ } => true
      }
    Rejected { diagnostics: _ } => true
  }
}

fn bisect_parse_module_add_well_formed_after_normalize() -> Bool {
  let lm = dag_language_model()
  match tokenize(
    text: bisect_add_module_source.carried,
    file: ^compile_ingest_staging_source_file,
    rules: lm.lex
  ) {
    Accepted { value: token_stream, diagnostics: _ } =>
      match parse(tokens: token_stream, grammar: lm.grammar) {
        Accepted { value: parsed, diagnostics: _ } =>
          match normalize(parse_tree: parsed) {
            Accepted { value: normalized, diagnostics: _ } => well_formed(n: normalized)
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn bisect_parse_module_add_normalize_accepts() -> Bool {
  let lm = dag_language_model()
  match tokenize(
    text: bisect_add_module_source.carried,
    file: ^compile_ingest_staging_source_file,
    rules: lm.lex
  ) {
    Accepted { value: token_stream, diagnostics: _ } =>
      match parse(tokens: token_stream, grammar: lm.grammar) {
        Accepted { value: parsed, diagnostics: _ } =>
          match normalize(parse_tree: parsed) {
            Accepted { value: _, diagnostics: _ } => true
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn witness_bisect_parse_module_add_correctness_holds() -> Bool {
  bisect_parse_module_add_parse_accepts()
    && bisect_parse_module_add_normalize_accepts()
    && bisect_parse_module_add_well_formed_after_normalize()
    && bisect_parse_module_add_resolve_accepts()
    && bisect_parse_module_truncated_rejects()
    && ((bisect_parse_module_add_parse_accepts() == false) == false)
}

fn bisect_through_resolve() -> Outcome<Node> {
  let lm = dag_language_model()
  bind_outcome(
    o: tokenize(
      text: bisect_empty_source.carried,
      file: ^compile_ingest_staging_source_file,
      rules: lm.lex
    ),
    f: fn(token_stream) {
      bind_outcome(
        o: parse(tokens: token_stream, grammar: lm.grammar),
        f: fn(parse_tree) {
          bind_outcome(
            o: normalize(parse_tree: parse_tree),
            f: fn(normalized) {
              resolve(tree: normalized, lm: lm)
            }
          )
        }
      )
    }
  )
}

fn bisect_through_infer() -> Outcome<InferredTree> {
  bind_outcome(
    o: bisect_through_resolve(),
    f: fn(resolved) {
      infer(tree: resolved)
    }
  )
}

fn bisect_through_lens_subtree() -> Outcome<List<LensGateWitness>> {
  bind_outcome(
    o: bisect_through_infer(),
    f: fn(inferred) {
      run_required_lens_gates_on_subtree(
        inferred: inferred,
        lenses: always_required_lenses()
      )
    }
  )
}

fn bisect_resolve_terminates() -> Bool {
  match bisect_through_resolve() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => true
  }
}

fn bisect_infer_terminates() -> Bool {
  match bisect_through_infer() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => true
  }
}

fn bisect_lens_subtree_terminates() -> Bool {
  match bisect_through_lens_subtree() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => true
  }
}

data bisect_unbound_reference_source: Medium<String> = Medium { carried: "module bisect.add\n\nfn add(x:Int, y:Int) -> Int { x + zzz }", fidelity: Lossless }
data bisect_unbound_reference_no_binding_source: Medium<String> = Medium { carried: "module bisect.add\n\nfn add() -> Int { zzz }", fidelity: Lossless }
data bisect_unbound_reference_note: String = "Discriminating red controls for resolution vacuity (DESIGN section 5). Before the StampLexeme binding migration, every class-stamped identifier collapsed to ^dag_token_ident, which is grammar-carried and therefore canonical, so resolve accepted ANY body reference - including unbound ones (proven on main: both sources below resolved Accepted). These witnesses pin the non-vacuous behavior: a body reference with no binding (zzz, with and without params in scope) must resolve-reject. They go false if the vacuity ever returns - a canonical-symbol arm widening, a stamp regression, or an over-broad scope harvest."

fn bisect_resolve_accepts_text(text: String) -> Bool {
  let lm = dag_language_model()
  match tokenize(
    text: text,
    file: ^compile_ingest_staging_source_file,
    rules: lm.lex
  ) {
    Accepted { value: token_stream, diagnostics: _ } =>
      match parse(tokens: token_stream, grammar: lm.grammar) {
        Accepted { value: parsed, diagnostics: _ } =>
          match normalize(parse_tree: parsed) {
            Accepted { value: normalized, diagnostics: _ } =>
              match resolve(tree: normalized, lm: lm) {
                Accepted { value: _, diagnostics: _ } => true
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn witness_bisect_unbound_reference_rejected() -> Bool {
  bisect_resolve_accepts_text(text: bisect_unbound_reference_source.carried) == false
}

test fn witness_bisect_unbound_reference_no_binding_rejected() -> Bool {
  bisect_resolve_accepts_text(text: bisect_unbound_reference_no_binding_source.carried) == false
}
