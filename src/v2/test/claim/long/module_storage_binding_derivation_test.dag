module v2.test.long.module_storage_binding_derivation

import extdeps.communication.medium { Lossless, Medium }
import v2.compiler.source_authority {
  DagSourceReadWitness,
  SourceRootIngest,
  module_storage_bindings_from_ingest,
  module_storage_module_for_path,
  module_storage_path_for_module
}
import v2.std.artifact { Artifact, SourceFile }
import v2.std.collection { Absent, Present }
import v2.std.cross_tree.import_model { V2Tree }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.qualified_name { QualifiedName, qualified_name_to_dotted_string }
import v2.std.text { String }
import std.algebra { Cons, Empty }

data msb_qualified_name_collision_note: String = "QualifiedName values here are constructed directly from Cons/Empty. Historical: the constructor name qualified_name_from_segment_list was FORKED across std/extdeps (FreeMonoid<Symbol> vs Outcome<QualifiedName>) when this witness was authored; that fork was DISSOLVED in this integration wave by renaming apart — qualified_name_from_string_segments (std, List<String>) vs qualified_name_from_symbol_segments (extdeps dag parse, List<Symbol> -> Outcome). Direct construction is retained here so the witness stays independent of either helper."
data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data msb_claim_note: String = "Phase 1 discriminating witnesses for the path⇄module binding authority (docs/plans/module-identity-storage-binding-design.md §2). GREEN: the binding is DERIVED from parse — nothing here authors the module name, it is read back out of the parsed module node, so a fixture whose text says one thing and whose declared path says another cannot agree by construction. REDs: the duplicate-module case refuses (the modeled form of the host collision panic, enforcing the live 1:1 binding), and the underivable-name case refuses instead of dropping the row — the pre-Phase-1 program_assembly derivation silently kept the root and left the index unchanged there, so the module went invisible (§5: a failure arm refuses, never widens)."

data msb_v2_path: String = "src/v2/std/msb_fixture.dag"

data msb_read: DagSourceReadWitness = DagSourceReadWitness {
  source: Medium { carried: "module v2.std.msb_fixture", fidelity: Lossless },
  artifact: Artifact {
    kind: SourceFile,
    id: ^msb_artifact,
    file_path: msb_v2_path
  },
  compilation_unit: ^msb_cu,
  source_root: V2Tree
}

data msb_other_read: DagSourceReadWitness = DagSourceReadWitness {
  source: Medium { carried: "module v2.std.msb_other_fixture", fidelity: Lossless },
  artifact: Artifact {
    kind: SourceFile,
    id: ^msb_other_artifact,
    file_path: "src/v2/std/msb_other_fixture.dag"
  },
  compilation_unit: ^msb_other_cu,
  source_root: V2Tree
}

data msb_duplicate_read: DagSourceReadWitness = DagSourceReadWitness {
  source: Medium { carried: "module v2.std.msb_fixture", fidelity: Lossless },
  artifact: Artifact {
    kind: SourceFile,
    id: ^msb_duplicate_artifact,
    file_path: "src/v2/std/msb_fixture_copy.dag"
  },
  compilation_unit: ^msb_duplicate_cu,
  source_root: V2Tree
}

data msb_unparseable_read: DagSourceReadWitness = DagSourceReadWitness {
  source: Medium { carried: "this source declares no module at all", fidelity: Lossless },
  artifact: Artifact {
    kind: SourceFile,
    id: ^msb_unparseable_artifact,
    file_path: "src/v2/std/msb_unparseable_fixture.dag"
  },
  compilation_unit: ^msb_unparseable_cu,
  source_root: V2Tree
}

data msb_fixture_qn: QualifiedName = Cons {
  head: ^v2,
  tail: Cons { head: ^std, tail: Cons { head: ^msb_fixture, tail: Empty } }
}

data msb_ingest: SourceRootIngest = [msb_read, msb_other_read]
data msb_duplicate_ingest: SourceRootIngest = [msb_read, msb_duplicate_read]
data msb_unparseable_ingest: SourceRootIngest = [msb_unparseable_read]

test fn module_storage_binding_derived_from_parse_holds() -> Bool {
  match module_storage_bindings_from_ingest(ingest: msb_ingest) {
    Rejected { diagnostics: _ } => false
    Accepted { value: index, diagnostics: _ } =>
      match module_storage_module_for_path(index: index, file_path: msb_v2_path) {
        Absent => false
        Present { value: qn } =>
          qualified_name_to_dotted_string(qn: qn) == "v2.std.msb_fixture"
      }
  }
}

test fn module_storage_path_projection_holds() -> Bool {
  match module_storage_bindings_from_ingest(ingest: msb_ingest) {
    Rejected { diagnostics: _ } => false
    Accepted { value: index, diagnostics: _ } =>
      match module_storage_path_for_module(
        index: index,
        module: msb_fixture_qn
      ) {
        Absent => false
        Present { value: p } => p == msb_v2_path
      }
  }
}

test fn module_storage_duplicate_module_refuses() -> Bool {
  match module_storage_bindings_from_ingest(ingest: msb_duplicate_ingest) {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}

test fn module_storage_underivable_module_name_refuses() -> Bool {
  match module_storage_bindings_from_ingest(ingest: msb_unparseable_ingest) {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}
