module v2.test.long.parse_table_memo_amortization


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data memo_amort_empty_a_source: extdeps.communication.medium.Medium<String> = extdeps.communication.medium.Medium { carried: "module memo_amort_a\n", fidelity: extdeps.communication.medium.Lossless }
data memo_amort_empty_b_source: extdeps.communication.medium.Medium<String> = extdeps.communication.medium.Medium { carried: "module memo_amort_b\n", fidelity: extdeps.communication.medium.Lossless }
data memo_amort_bisect_add_source: extdeps.communication.medium.Medium<String> = extdeps.communication.medium.Medium { carried: "module bisect.add\n\nfn add(x:Int, y:Int) -> Int { x + y }", fidelity: extdeps.communication.medium.Lossless }
data memo_amort_file_a_read: v2.compiler.source_authority.DagSourceReadWitness = v2.compiler.source_authority.DagSourceReadWitness {
  source: memo_amort_empty_a_source,
  artifact: v2.std.artifact.Artifact {
    kind: v2.std.artifact.SourceFile,
    id: ^memo_amort_file_a_artifact,
    file_path: "src/v2/test/fixture/memo_amort_file_a.dag"
  },
  compilation_unit: ^memo_amort_cu_a,
  source_root: v2.std.cross_tree.import_model.V2Tree
}

data memo_amort_file_b_read: v2.compiler.source_authority.DagSourceReadWitness = v2.compiler.source_authority.DagSourceReadWitness {
  source: memo_amort_empty_b_source,
  artifact: v2.std.artifact.Artifact {
    kind: v2.std.artifact.SourceFile,
    id: ^memo_amort_file_b_artifact,
    file_path: "src/v2/test/fixture/memo_amort_file_b.dag"
  },
  compilation_unit: ^memo_amort_cu_b,
  source_root: v2.std.cross_tree.import_model.V2Tree
}

data memo_amort_bisect_add_read: v2.compiler.source_authority.DagSourceReadWitness = v2.compiler.source_authority.DagSourceReadWitness {
  source: memo_amort_bisect_add_source,
  artifact: v2.std.artifact.Artifact {
    kind: v2.std.artifact.SourceFile,
    id: ^memo_amort_bisect_add_artifact,
    file_path: "src/v2/test/fixture/memo_amort_bisect_add.dag"
  },
  compilation_unit: ^memo_amort_cu_bisect_add,
  source_root: v2.std.cross_tree.import_model.V2Tree
}

data memo_amort_ingest_one_file: v2.compiler.source_authority.SourceRootIngest = std.algebra.Cons {
  head: memo_amort_file_a_read,
  tail: std.algebra.Empty
}

data memo_amort_ingest_two_files: v2.compiler.source_authority.SourceRootIngest = std.algebra.Cons {
  head: memo_amort_file_a_read,
  tail: std.algebra.Cons { head: memo_amort_file_b_read, tail: std.algebra.Empty }
}

data memo_amort_ingest_bisect_add: v2.compiler.source_authority.SourceRootIngest = std.algebra.Cons {
  head: memo_amort_bisect_add_read,
  tail: std.algebra.Empty
}

fn memo_amort_not_single_root_rejection<T>() -> v2.std.diagnostic.Outcome<T> {
  v2.std.diagnostic.Rejected {
    diagnostics: v2.std.diagnostic.diagnostics_singleton(
      d: v2.std.diagnostic.Diagnostic {
        reason: ^memo_amort_expected_exactly_one_module_root,
        at: v2.std.diagnostic.port_locus(port: ^memo_amort_single_root_locus_port),
        correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.CorrectionNotModeled }
      }
    )
  }
}

fn memo_amort_single_root_content_hash(ingest: v2.compiler.source_authority.SourceRootIngest) -> v2.std.diagnostic.Outcome<v2.std.node.Hash> {
  match v2.compiler.program_assembly.module_roots_from_source_root_ingest(
    ingest: ingest,
    lm: v2.extdeps.languages.dag.dag_language_model()
  ) {
    v2.std.diagnostic.Accepted { value: roots, diagnostics: _ } =>
      match v2.std.algebra.length(xs: roots) == 1 {
        true =>
          v2.std.algebra.fold_list(
            xs: roots,
            empty: memo_amort_not_single_root_rejection(),
            cons: fn(_acc, root) {
              v2.std.diagnostic.outcome_accepted(value: v2.std.node.content_hash(n: root))
            }
          )
        false =>
          memo_amort_not_single_root_rejection()
      }
    v2.std.diagnostic.Rejected { diagnostics: d } =>
      v2.std.diagnostic.Rejected { diagnostics: d }
  }
}

test fn memo_amort_parse_one_file_holds() -> Bool {
  match v2.compiler.program_assembly.module_roots_from_source_root_ingest(
    ingest: memo_amort_ingest_one_file,
    lm: v2.extdeps.languages.dag.dag_language_model()
  ) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn memo_amort_parse_two_files_holds() -> Bool {
  match v2.compiler.program_assembly.module_roots_from_source_root_ingest(
    ingest: memo_amort_ingest_two_files,
    lm: v2.extdeps.languages.dag.dag_language_model()
  ) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn memo_amort_parse_two_files_twice_holds() -> Bool {
  memo_amort_parse_two_files_holds() && memo_amort_parse_two_files_holds()
}

fn witness_parse_table_memo_hit_path_content_hash_stable() -> Bool {
  match memo_amort_single_root_content_hash(ingest: memo_amort_ingest_bisect_add) {
    v2.std.diagnostic.Accepted { value: hash_miss, diagnostics: _ } =>
      match memo_amort_single_root_content_hash(ingest: memo_amort_ingest_bisect_add) {
        v2.std.diagnostic.Accepted { value: hash_hit, diagnostics: _ } =>
          match memo_amort_single_root_content_hash(ingest: memo_amort_ingest_one_file) {
            v2.std.diagnostic.Accepted { value: hash_empty, diagnostics: _ } =>
              hash_miss == hash_hit && hash_miss != hash_empty
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn parse_table_grammar_memo_multi_file_ingest_parses() -> Bool {
  memo_amort_parse_two_files_holds()
}

test fn parse_table_memo_hit_path_content_hash_stable_holds() -> Bool {
  witness_parse_table_memo_hit_path_content_hash_stable()
}

data empty_ingest_guard_note: String = "Covers the empty-ingest branch of program_assembly_fold_ingest, added with the prepare-once hoist: an empty ingest must assemble to empty roots WITHOUT paying the one-time grammar preparation (well-formed + 5-check validation + FIRST analysis) for zero modules. Discriminating — RED if the guard rejected, fabricated a root, or (regression) fell through to prepare_grammar for no modules. Fast by construction (no prepare, no parse), unlike the multi-file amortization witnesses above which each pay exactly ONE preparation for the whole fold."

test fn empty_ingest_assembles_to_empty_roots_without_prepare() -> Bool {
  match v2.compiler.program_assembly.module_roots_from_source_root_ingest(
    ingest: std.algebra.Empty,
    lm: v2.extdeps.languages.dag.dag_language_model()
  ) {
    v2.std.diagnostic.Accepted { value: roots, diagnostics: _ } => v2.std.algebra.length(xs: roots) == 0
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}
