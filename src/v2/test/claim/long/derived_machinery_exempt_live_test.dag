module v2.test.long.derived_machinery_exempt_live

import v2.lens.extdeps_external_authority {
  extdeps_external_authority_is_anchor_machinery_exempt,
  extdeps_external_authority_live_clean_for_module
}
import v2.std.algebra { fold_list }
import v2.std.logic { Bool }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn derived_machinery_exempt_modules_are_live_clean_holds() -> Bool {
  fold_list(
    xs: extdeps_derived_extdeps_modules(),
    empty: true,
    cons: fn(acc, mod_qn) {
      if extdeps_external_authority_is_anchor_machinery_exempt(module: mod_qn) {
        acc && extdeps_external_authority_live_clean_for_module(module: mod_qn)
      } else {
        acc
      }
    }
  )
}
