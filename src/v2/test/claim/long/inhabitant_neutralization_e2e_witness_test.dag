test fn inhabitant_neutralization_python_to_go_discriminates_on_real_tree() -> Bool {
  match v2.test.manual.python_grammar_claim.python_grammar_parse_fixture() {
    v2.std.diagnostic.Accepted { value: python_parse_tree, diagnostics: _ } =>
      match v2.compiler.ingest.cross_language_compile(
        parse_tree: python_parse_tree,
        source_model: v2.extdeps.languages.python.python_target_model(),
        target_model: v2.extdeps.languages.go.go_target_model()
      ) {
        v2.std.diagnostic.Rejected { diagnostics: d } =>
          d.head.reason == ^infer_grounding_not_derived
        v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn inhabitant_neutralization_python_to_go_holds() -> Bool {
  inhabitant_neutralization_python_to_go_cross_language_compile_refuses_underived_holds()
    && inhabitant_neutralization_python_to_go_discriminates_on_real_tree()
}

test fn inhabitant_neutralization_python_to_go_translate_rejects() -> Bool {
  match v2.std.inhabitant_neutralization.neutralize_core_for_target(
    core: v2.extdeps.languages.python.python_emitted_add_fn_node(),
    target: v2.extdeps.languages.go.go_target_model()
  ) {
    v2.std.diagnostic.Accepted { value: neutralized, diagnostics: _ } =>
      match v2.compiler.infer.infer(tree: neutralized) {
        v2.std.diagnostic.Accepted { value: inferred, diagnostics: _ } =>
          match v2.compiler.translate.translate(tree: inferred, target: v2.extdeps.languages.go.go_target_model()) {
            v2.std.diagnostic.Rejected { diagnostics: _ } => true
            v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

