module v2.test.long.inhabitant_neutralization_e2e_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data inhabitant_neutralization_e2e_long_note: String = "Offline/long disposition for inhabitant cross-language e2e + translate/emit refusal poles (review 43557): these were never per-PR enrolled and must not use if-false orphan pins (DESIGN §5 specification-without-execution). They live under test/claim/long/ (OfflineLocalRecipe) as real test fns — local recipe / future falsifier enrollment, never fabricated reachability. Dissolve-on: re-enroll per-PR when measured under gunbc_ci_fast_lane_witness_eval_budget, or delete as duplicate of a faster mechanism receipt."

test fn inhabitant_neutralization_python_to_ts_cross_language_compile_refuses_underived_holds() -> Bool {
  match v2.test.manual.python_grammar_claim.python_grammar_parse_fixture() {
    v2.std.diagnostic.Accepted { value: python_parse_tree, diagnostics: _ } =>
      match v2.compiler.ingest.cross_language_compile(
        parse_tree: python_parse_tree,
        source_model: v2.extdeps.languages.python.python_target_model(),
        target_model: v2.extdeps.languages.typescript.ts_target_model()
      ) {
        v2.std.diagnostic.Rejected { diagnostics: d } =>
          d.head.reason == ^infer_grounding_not_derived
        v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

