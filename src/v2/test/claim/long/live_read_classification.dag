}

test fn g1_runtime_read_touched_by_nonempty_path() -> Bool {
  runtime_read_touched_by_path_g1(
    classification: verdict_of(closure: fixture_roster_gate_closure),
    touched_path: "dag/std/logic.dag"
  )
}

test fn g1_local_read_not_touched() -> Bool {
  !runtime_read_touched_by_path_g1(
    classification: verdict_of(closure: fixture_unit_closure),
    touched_path: "dag/std/logic.dag"
  )
}

