// The one named live integration for this module: a single call to fn_arrow_decl_facts_live()
// (a whole-tree scan) grounds every G2 roster-gate assertion below. Three tests used to each
// call it independently against the identical entry/facts/carrier_homes triple, paying the
// live scan three times for one fixed input — DESIGN §5 witness-cost-derives-from-purpose
// forbids a test claiming arbitrary computation merely because it is a test. Every other test
// in this module classifies over explicit fixture facts and never reaches this authority.
fn roster_gate_g2_live_classification() -> LiveReadClassification {
  live_read_classification_g2_from_facts(
    entry_module: "v2.test.claim.complexity.accumulator_copy_roster_gate",
    facts: roster_gate_corpus_facts,
    decls: fn_arrow_decl_facts_live(pool_roots: witness_layer_roots, pool_files: []),
    carrier_homes: live_read_carrier_homes_v0
  )
}

test fn g2_roster_gate_live_integration_holds() -> Bool {
  let c = roster_gate_g2_live_classification()
  classification_has_filesystem_read_carrier(classification: c)
    && classification_has_literal_path(
      classification: c,
      path: "dag/std/algebra.dag"
    )
    && runtime_read_touched_by_path_g2(
      classification: c,
      touched_path: "dag/std/algebra.dag"
    )
    && runtime_read_touched_by_path_g2(
      classification: c,
      touched_path: "src/v2/lens/complexity_accumulator_copy.dag"
    )
    && g2_implies_reads_live_tree(classification: c)
    && accumulator_copy_roster_gate_entry_live_tree_disposition() == ReadsLiveTree
}

test fn g2_unknown_path_pattern_fail_closed_touched() -> Bool {
  let c = live_read_classification_from_facts(
    entry_module: "fix.witness",
    facts: fixture_roster_gate_facts,
    carrier_homes: fixture_carriers
  )
  match c {
    RuntimeRead { carriers: carriers } =>
      runtime_read_touched_by_path_g2(
        classification: c,
        touched_path: "dag/unrelated.dag"
      )
    LocalRead => false
    LiveReadUnestablished { refusals: _ } => false
  }
}


test fn g2_fn_arrow_marshal_host_scaffold_receipt_is_checkable() -> Bool {
  match fn_arrow_skeleton_g2_marshal_host_scaffold_dissolution_trigger {
    Scaffold { dissolves_to: _, bind: _ } => true
    Terminal { reason: _ } => false
  }
}

data live_read_selection_control_law: String = "WHY THESE THREE REPLACE THE UNION TEST. g2_union_retains_g1_import_carriers_with_g2_literal_paths asserted that a completed G2 answer keeps the G1 import carriers. That assertion could only ever pass because the union supplied them: this witness's own closure does not contain the carrier homes its fixture facts name, so fn_arrow_decl_facts_live returned no declarations for them when it was entry-closure scoped (it now takes pool_roots; this reading is the record of why the union was removed, not a live claim about the producer's scope), and no reachable-invocation evidence for that subject exists in this context at all. Remove the union and the same subject silently answers LocalRead, which is UNDER-selection: the floor would skip a witness that reads the tree, and a skipped witness looks like a faster green floor rather than a failure. The union was therefore masking absent evidence, not carrying a real fact.

The three controls below separate the states the single union test conflated: evidence present and negative (local), evidence absent (refuse), evidence present and imprecise (conservative runtime read). Planted declarations supply the coverage the live entry-closure cannot, so complete-facts cases are reachable here rather than waiting on the whole-tree manifest."

fn selection_atom_node(lexeme: String) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: symbol_intern_lexeme(lexeme: lexeme) } },
    children: [],
    occurrence_id: OccurrenceSynthetic
  }
}

fn selection_body_node(callee: String) -> Node {
  Node {
    kind: ComputationNode { behavior: Transform },
    children: [ Edge { label: Positional, target: selection_atom_node(lexeme: callee), declaration: NotADeclaration } ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn selection_non_call_atom_body(text: String) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [ Edge { label: Positional, target: selection_atom_node(lexeme: text), declaration: NotADeclaration } ],
    occurrence_id: OccurrenceSynthetic
  }
}

data selection_control_facts: List<ModuleImportFact> = [
  ModuleImportFact {
    module: "synthetic.live_read_selection.entry",
    imports: [ "v2.compiler.self_host" ]
  },
  ModuleImportFact { module: "v2.compiler.self_host", imports: [] }
]

fn selection_entry_seed_decl() -> FnArrowDecl {
  FnArrowDecl {
    test_marked: false,
    qualified_name: "synthetic.live_read_selection.entry.seed",
    name: "seed",
    output: selection_body_node(callee: "carrier_fn"),
    params: []
  }
}

fn selection_carrier_home_decl(callee: String) -> FnArrowDecl {
  FnArrowDecl {
    test_marked: false,
    qualified_name: "v2.compiler.self_host.carrier_fn",
    name: "carrier_fn",
    output: selection_body_node(callee: callee),
    params: []
  }
}

fn selection_projection_over(decls: List<FnArrowDecl>) -> LiveReadSelectionProjection {
  live_read_selection_projection_from_facts(
    entry_module: "synthetic.live_read_selection.entry",
    facts: selection_control_facts,
    decls: decls,
    carrier_homes: live_read_carrier_homes_v0
  )
}

fn projection_is_refused(p: LiveReadSelectionProjection) -> Bool {
  match p {
    LiveReadSelectionRefused { cause: c } => !string_is_empty(s: c)
    LiveReadSelectionClassified { classification: k } => classification_is_local(classification: k) && false
  }
}

fn projection_classification_is_local(p: LiveReadSelectionProjection) -> Bool {
  match p {
    LiveReadSelectionRefused { cause: _ } => false
    LiveReadSelectionClassified { classification: c } => classification_is_local(classification: c)
  }
}

fn projection_classification_has_runtime_read(p: LiveReadSelectionProjection) -> Bool {
  match p {
    LiveReadSelectionRefused { cause: _ } => false
    LiveReadSelectionClassified { classification: c } =>
      classification_has_runtime_read(classification: c)
  }
}

test fn g2_complete_facts_reachable_home_without_carrier_call_is_local() -> Bool {
  projection_classification_is_local(
    p: selection_projection_over(
      decls: [
        selection_entry_seed_decl(),
        selection_carrier_home_decl(callee: "string_concat")
      ]
    )
  )
}



test fn g2_missing_carrier_home_facts_refuse_rather_than_local() -> Bool {
  projection_is_refused(p: selection_projection_over(decls: [ selection_entry_seed_decl() ]))
}

test fn g2_reachable_carrier_call_with_unknown_argument_is_runtime_read() -> Bool {
  projection_classification_has_runtime_read(
    p: selection_projection_over(
      decls: [
        selection_entry_seed_decl(),
        selection_carrier_home_decl(callee: "filesystem_read")
      ]
    )
  )
}

test fn g2_non_call_atom_collision_does_not_reach_carrier_helper() -> Bool {
  projection_classification_is_local(
    p: selection_projection_over(
      decls: [
        FnArrowDecl {
          test_marked: false,
          qualified_name: "synthetic.live_read_selection.entry.seed",
          name: "seed",
          output: selection_non_call_atom_body(text: "carrier_fn"),
          params: []
        },
        selection_carrier_home_decl(callee: "filesystem_read")
      ]
    )
  )
}

// ---- derived equality for PathPattern / LiveReadCarrier (nfr_dissolve_derived_equality payoff) --
// path_pattern_eq / live_read_carrier_eq (hand structural equality over variant + every field,
// off-variant wildcard arm returning false) dissolved to the derived ==: operator_realization.dag
// -- every structural declaration realizes equality structurally (== / != / && are the host
// token by construction). The fixtures are distinct real values, not hand-built equality verdicts.

// PathPattern fixtures.
data path_pattern_fixture_literal_a: PathPattern = LiteralPath { path: "v2/lens" }
data path_pattern_fixture_literal_b: PathPattern = LiteralPath { path: "v2/test" }
data path_pattern_fixture_param: PathPattern = ParamRef { name: "module_path" }

// RED: distinct variants and distinct same-variant field values must compare unequal (a
// non-structural == collapsing variants or ignoring fields would turn this false).
test fn path_pattern_structural_eq_distinguishes() -> Bool {
  path_pattern_fixture_literal_a != path_pattern_fixture_literal_b
    && path_pattern_fixture_literal_a != path_pattern_fixture_param
    && path_pattern_fixture_literal_a != UnknownPath
    && path_pattern_fixture_param != UnknownPath
}

// POSITIVE CONTROL, paired with the distinguishing red above: identical values compare equal.
test fn path_pattern_structural_eq_equal_control() -> Bool {
  path_pattern_fixture_literal_a == path_pattern_fixture_literal_a
    && path_pattern_fixture_param == ParamRef { name: "module_path" }
    && UnknownPath == UnknownPath
}

// LiveReadCarrier fixtures (FilesystemReadPath wraps a PathPattern arm; the two nullary arms and
// the home field of DeclFactsReflection are the other carriers).
data live_read_carrier_fixture_fs_a: LiveReadCarrier = FilesystemReadPath {
  path_pattern: path_pattern_fixture_literal_a
}
data live_read_carrier_fixture_fs_b: LiveReadCarrier = FilesystemReadPath {
  path_pattern: path_pattern_fixture_literal_b
}
data live_read_carrier_fixture_scan: LiveReadCarrier = ModuleDeclarationFactsScan
data live_read_carrier_fixture_home_a: LiveReadCarrier = DeclFactsReflection { home: "v2.std.decl_index" }
data live_read_carrier_fixture_home_b: LiveReadCarrier = DeclFactsReflection { home: "v2.std.fn_index" }

// RED: distinct arms and distinct same-arm field values (including the nested PathPattern field)
// must compare unequal.
test fn live_read_carrier_structural_eq_distinguishes() -> Bool {
  live_read_carrier_fixture_fs_a != live_read_carrier_fixture_fs_b
    && live_read_carrier_fixture_fs_a != live_read_carrier_fixture_scan
    && live_read_carrier_fixture_fs_a != live_read_carrier_fixture_home_a
    && live_read_carrier_fixture_scan != live_read_carrier_fixture_home_a
    && live_read_carrier_fixture_home_a != live_read_carrier_fixture_home_b
}

// POSITIVE CONTROL, paired with the distinguishing red above: identical carriers (nested field
// included) compare equal.
test fn live_read_carrier_structural_eq_equal_control() -> Bool {
  live_read_carrier_fixture_fs_a == FilesystemReadPath {
    path_pattern: LiteralPath { path: "v2/lens" }
  }
    && live_read_carrier_fixture_scan == ModuleDeclarationFactsScan
    && live_read_carrier_fixture_home_a == DeclFactsReflection { home: "v2.std.decl_index" }
}
