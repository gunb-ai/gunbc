module v2.test.long.arrow_body_form_witness

import v2.compiler.ingested_fixture_arrows {
  ingested_add_arrow_with_body,
  ingested_id_arrow_with_body,
  ingested_match_arrow_with_body,
  ingested_zero_arrow_with_body
}
import v2.std.diagnostic { Accepted, Rejected }
import v2.test.claim.body_lowering.arrow_body_form_semantic_helpers {
  ArrowBodyFormAdmissionProduction,
  ArrowBodyFormAdmissionRedNoComputationBody,
  ArrowBodyFormAdmissionRedNoDirectAtom,
  arrow_body_form_eval_call_does_not_reject_unsupported_callee,
  arrow_body_form_eval_int_literal_optional,
  arrow_body_form_eval_nullary_call_node,
  arrow_body_form_eval_unary_call_node,
  arrow_body_form_semantic_binary_int_if_body_admits_holds,
  arrow_body_form_semantic_nullary_int_if_body_admits_holds,
  arrow_body_form_semantic_unary_int_if_body_admits_holds
}

// Semantic ArrowBodyForm witnesses: id(7)==7, zero()==0, add(2,3)==5 through
// ingested normalize, plus RED mirrors over the same admission population.
// NOT enrolled on falsifier_substrate_long_lane_rows in this PR — eval helpers
// still need wiring before cadence enrollment. Fast-lane witnesses exercise the
// classifier, structural admission, eval-entry population, and eval dispatch
// (including DirectAtomBody through-call admission). Local recipe:
// claim_batch --source-root dag --source-root src/v2 --entry
// src/v2/test/claim/long/arrow_body_form_witness_test.dag --functions <csv>.

test fn arrow_body_form_semantic_id_seven_executes_holds() -> Bool {
  match ingested_id_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      arrow_body_form_semantic_unary_int_if_body_admits_holds(
        callee: arrow,
        arg_lex: "7",
        expected: 7,
        mirror: ArrowBodyFormAdmissionProduction
      )
    Rejected { diagnostics: _ } => false
  }
}

test fn arrow_body_form_semantic_zero_executes_holds() -> Bool {
  match ingested_zero_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      arrow_body_form_semantic_nullary_int_if_body_admits_holds(
        callee: arrow,
        expected: 0,
        mirror: ArrowBodyFormAdmissionProduction
      )
    Rejected { diagnostics: _ } => false
  }
}

test fn arrow_body_form_semantic_add_executes_holds() -> Bool {
  match ingested_add_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      arrow_body_form_semantic_binary_int_if_body_admits_holds(
        callee: arrow,
        left_lex: "2",
        right_lex: "3",
        expected: 5,
        mirror: ArrowBodyFormAdmissionProduction
      )
    Rejected { diagnostics: _ } => false
  }
}

test fn arrow_body_form_RED_no_direct_atom_id_semantic_observed_false_holds() -> Bool {
  match ingested_id_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      !arrow_body_form_semantic_unary_int_if_body_admits_holds(
        callee: arrow,
        arg_lex: "7",
        expected: 7,
        mirror: ArrowBodyFormAdmissionRedNoDirectAtom
      )
    Rejected { diagnostics: _ } => false
  }
}

test fn arrow_body_form_RED_no_direct_atom_zero_semantic_observed_false_holds() -> Bool {
  match ingested_zero_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      !arrow_body_form_semantic_nullary_int_if_body_admits_holds(
        callee: arrow,
        expected: 0,
        mirror: ArrowBodyFormAdmissionRedNoDirectAtom
      )
    Rejected { diagnostics: _ } => false
  }
}

test fn arrow_body_form_RED_no_direct_atom_add_semantic_observed_true_holds() -> Bool {
  match ingested_add_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      arrow_body_form_semantic_binary_int_if_body_admits_holds(
        callee: arrow,
        left_lex: "2",
        right_lex: "3",
        expected: 5,
        mirror: ArrowBodyFormAdmissionRedNoDirectAtom
      )
    Rejected { diagnostics: _ } => false
  }
}

test fn arrow_body_form_RED_no_computation_add_semantic_observed_false_holds() -> Bool {
  match ingested_add_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      !arrow_body_form_semantic_binary_int_if_body_admits_holds(
        callee: arrow,
        left_lex: "2",
        right_lex: "3",
        expected: 5,
        mirror: ArrowBodyFormAdmissionRedNoComputationBody
      )
    Rejected { diagnostics: _ } => false
  }
}

test fn arrow_body_form_RED_no_computation_id_semantic_observed_true_holds() -> Bool {
  match ingested_id_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      arrow_body_form_semantic_unary_int_if_body_admits_holds(
        callee: arrow,
        arg_lex: "7",
        expected: 7,
        mirror: ArrowBodyFormAdmissionRedNoComputationBody
      )
    Rejected { diagnostics: _ } => false
  }
}

test fn arrow_body_form_RED_no_computation_zero_semantic_observed_true_holds() -> Bool {
  match ingested_zero_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      arrow_body_form_semantic_nullary_int_if_body_admits_holds(
        callee: arrow,
        expected: 0,
        mirror: ArrowBodyFormAdmissionRedNoComputationBody
      )
    Rejected { diagnostics: _ } => false
  }
}

test fn arrow_body_form_match_body_refused_eval_entry_holds() -> Bool {
  match ingested_match_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      match arrow_body_form_eval_int_literal_optional(lexeme: "1") {
        Present { value: arg } =>
          !arrow_body_form_eval_call_does_not_reject_unsupported_callee(
            call: arrow_body_form_eval_unary_call_node(callee: arrow, arg: arg)
          )
        Absent => false
      }
    Rejected { diagnostics: _ } => false
  }
}
