module v2.test.long.compiler_frontier_probe_entry

import v2.compiler.self_host.frontier_probe {
  frontier_probe_emit_from_ingest
}
import v2.compiler.self_host.frontier_probe_types {
  EmitSurfaceGap,
  FrontierBlockerClass,
  FrontierProbeReceipt,
  NameResolutionGap,
  RealizationGap,
  SelfEmitReady,
  UnclassifiedProbeReason
}
import v2.test.workflow.host_source_root_ingest_manifest {
  host_compiler_closure_admission,
  host_source_root_ingest
}
import v2.std.logic { Bool }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.text { String }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data frontier_probe_entry_module_path: String = "src/v2/compiler/parse_engine_hooks.dag"

fn frontier_probe_entry_receipt() -> FrontierProbeReceipt {
  frontier_probe_emit_from_ingest(
    module_path: frontier_probe_entry_module_path,
    ingest: host_source_root_ingest,
    admission: host_compiler_closure_admission
  )
}

fn frontier_probe_entry_blocker_is_emit_surface() -> Bool {
  match frontier_probe_entry_receipt().blocker_class {
    EmitSurfaceGap => true
    _ => false
  }
}

test fn frontier_probe_entry_parse_engine_hooks_emit_surface_holds() -> Bool {
  frontier_probe_entry_blocker_is_emit_surface()
}
