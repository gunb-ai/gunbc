module v2.test.long.compiler_frontier_probe_entry

import v2.compiler.self_host.frontier_probe {
  FrontierProbeFixture,
  FrontierProbeIngestSubject,
  FrontierProbeReferencedClosure,
  frontier_probe_receipt_for_subject
}
import v2.compiler.self_host.frontier_probe_types {
  EmitSurfaceGap,
  FrontierProbeReceipt,
  ProbeStageEmit
}
import v2.test.workflow.host_source_root_ingest_manifest {
  frontier_probe_entry_module_path,
  frontier_probe_entry_source_ref,
  host_compiler_closure_admission,
  host_source_root_closure_refs,
  host_source_root_ingest,
  host_source_root_ingest_coverage_receipt
}
import v2.std.logic { Bool }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

fn frontier_probe_entry_subject() -> FrontierProbeIngestSubject {
  if frontier_probe_entry_module_path != "" {
    FrontierProbeReferencedClosure {
      refs: host_source_root_closure_refs,
      coverage: host_source_root_ingest_coverage_receipt.coverage,
      ingest_read_count: host_source_root_ingest_coverage_receipt.ingest_read_count,
      entry: frontier_probe_entry_source_ref
    }
  } else {
    FrontierProbeFixture {
      ingest: host_source_root_ingest,
      admission: host_compiler_closure_admission
    }
  }
}

fn frontier_probe_entry_receipt() -> FrontierProbeReceipt {
  frontier_probe_receipt_for_subject(
    subject: frontier_probe_entry_subject(),
    fixture_module_path: frontier_probe_entry_module_path
  )
}

test fn frontier_probe_entry_blocker_is_emit_surface() -> Bool {
  match frontier_probe_entry_receipt().blocker_class {
    EmitSurfaceGap => true
    _ => false
  }
}

test fn frontier_probe_entry_located_stage_is_emit_holds() -> Bool {
  frontier_probe_entry_receipt().located_stage == ProbeStageEmit
}

fn frontier_probe_entry_overlay_present() -> Bool {
  frontier_probe_entry_module_path != ""
}

test fn frontier_probe_entry_overlay_present_holds() -> Bool {
  frontier_probe_entry_overlay_present()
}
