module v2.test.long.compiler_frontier_probe_entry


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = ReadsLiveTree

fn frontier_probe_entry_receipt() -> v2.compiler.self_host.frontier_probe_types.FrontierProbeReceipt {
  if frontier_probe_entry_module_path != "" {
    frontier_probe_receipt_for_host_manifest_entry(
      refs: host_source_root_closure_refs,
      entry: frontier_probe_entry_source_ref,
      coverage: host_source_root_ingest_coverage_receipt.coverage,
      ingest_read_count: host_source_root_ingest_coverage_receipt.ingest_read_count,
      host_discovered_digest: host_source_root_ingest_coverage_receipt.discovered_source_refs_digest,
      fixture_module_path: frontier_probe_entry_module_path
    )
  } else {
    frontier_probe_receipt_for_subject(
      subject: v2.compiler.self_host.frontier_probe.FrontierProbeFixture {
        ingest: host_source_root_ingest,
        admission: host_compiler_closure_admission
      },
      fixture_module_path: ""
    )
  }
}

test fn frontier_probe_entry_blocker_is_emit_surface() -> v2.std.logic.Bool {
  match frontier_probe_entry_receipt().blocker_class {
    EmitSurfaceGap => true
    _ => false
  }
}

test fn frontier_probe_entry_located_stage_is_emit_holds() -> v2.std.logic.Bool {
  frontier_probe_entry_receipt().located_stage == ProbeStageEmit
}

fn frontier_probe_entry_overlay_present() -> v2.std.logic.Bool {
  frontier_probe_entry_module_path != ""
}

test fn frontier_probe_entry_overlay_present_holds() -> v2.std.logic.Bool {
  frontier_probe_entry_overlay_present()
}
