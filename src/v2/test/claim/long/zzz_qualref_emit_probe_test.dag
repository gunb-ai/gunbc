module v2.test.long.zzz_qualref_emit_probe

import extdeps.communication.medium { Lossless, Medium }
import v2.compiler.name_resolve {
  Admission,
  ResolutionSubject
}
import v2.compiler.self_host.compiler_closure_emit {
  CompilerClosureEmitReceipt,
  emit_compiler_import_closure_from_ingest
}
import v2.extdeps.languages.dag { dag_language_model }
import v2.compiler.source_authority {
  DagSourceReadWitness,
  SourceRootIngest
}
import v2.extdeps.languages.rust { rust_target_model }
import std.algebra { Cons, Empty }
import v2.std.cross_tree.import_model { V2Tree }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.diagnostic { Accepted, Outcome, Rejected, bind_outcome }
import v2.std.logic { Bool }
import v2.std.node { Node, Symbol }
import v2.std.text { String }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data zqe_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^zqe_artifact,
  file_path: "src/v2/pilot/zqe_pilot.dag"
}

fn zqe_ingest_for(src: String) -> SourceRootIngest {
  Cons {
    head: DagSourceReadWitness {
      source: Medium { carried: src, fidelity: Lossless },
      artifact: zqe_artifact,
      compilation_unit: ^zqe_pilot_cu,
      source_root: V2Tree
    },
    tail: Empty
  }
}

fn zqe_admission() -> Admission {
  Admission {
    subject: ResolutionSubject {
      name: Cons { head: ^zqe_pilot, tail: Empty }
    },
    imports: Empty
  }
}

fn zqe_emit_text(src: String) -> String {
  match emit_compiler_import_closure_from_ingest(
    ingest: zqe_ingest_for(src: src),
    admission: zqe_admission(),
    target: rust_target_model()
  ) {
    Accepted { value: receipt, diagnostics: _ } => receipt.source.carried
    Rejected { diagnostics: d } => concat("REJECTED:", d.head.reason)
  }
}

data src_bare_ref: String = "module zqe_pilot\n\ntype Flag = On | Off\n\ntype Alias = Flag\n"

data src_qual_ref: String = "module zqe_pilot\n\ntype Flag = On | Off\n\ntype Alias = zqe_pilot.Flag\n"

test fn zqe_bare_ref_emit_shows() -> String {
  zqe_emit_text(src: src_bare_ref)
}

test fn zqe_qual_ref_emit_shows() -> String {
  zqe_emit_text(src: src_qual_ref)
}
