module v2.test.long.ledger_histogram_probe

import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.workflow.compile_door_ledger {
  DoorCompiled,
  DoorRefused,
  door_ledger,
  ledger_cause_count,
  ledger_refused_count
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data paths: List<String> = [
  "dag/std/determinism.dag",
  "dag/std/error_primitives.dag",
  "dag/std/bit.dag"
]

test fn bit_compiled_after_flip_holds() -> Bool {
  let rows = door_ledger(paths: paths, pool_roots: ["dag", "src/v2"])
  ledger_refused_count(rows: rows) == 2
    && ledger_cause_count(rows: rows, reason: ^resolve_ambiguous_export) == 0
    && ledger_cause_count(rows: rows, reason: ^fact_density_hollow_alias_locus) == 1
    && ledger_cause_count(rows: rows, reason: ^resolve_reason_unbound_symbol) == 1
}
