module v2.test.long.direct_rust_door_production_group

import v2.compiler.self_host.candidate_generation {
  ArtifactProduced,
  AssemblyRejected,
  EmissionRejected,
  InferenceRejected,
  ProducerReceiptRejected,
}
import v2.compiler.self_host.v2_emitter_direct_rust_door_contract {
  direct_rust_door_leaf_established,
  direct_rust_door_production_group,
  direct_rust_door_production_group_holds,
}
import v2.std.logic { Bool }
import v2.std.text { String }

data direct_rust_door_production_group_test_note: String = "LONG lane (5s rule): walks the real ingest-assemble-infer-emit path once. The five stage functions below are a DISCRIMINATION SET, not five independent claims — exactly one stage function is true for any run, so the set locates where production stops. They are permanent: when the lane closes, production_reaches_artifact is the one that greens and the other four become standing regression controls proving production did not silently retreat to an earlier stage. Local recipe: claim_batch --source-root dag --source-root src/v2 --entry src/v2/test/claim/long/direct_rust_door_production_group_test.dag --functions <csv>"

test fn direct_rust_door_production_stops_at_assembly() -> Bool {
  match direct_rust_door_production_group().emission {
    AssemblyRejected { diagnostics: _ } => true
    InferenceRejected { diagnostics: _ } => false
    EmissionRejected { diagnostics: _ } => false
    ProducerReceiptRejected { diagnostics: _ } => false
    ArtifactProduced { artifact: _ } => false
  }
}

test fn direct_rust_door_production_stops_at_inference() -> Bool {
  match direct_rust_door_production_group().emission {
    AssemblyRejected { diagnostics: _ } => false
    InferenceRejected { diagnostics: _ } => true
    EmissionRejected { diagnostics: _ } => false
    ProducerReceiptRejected { diagnostics: _ } => false
    ArtifactProduced { artifact: _ } => false
  }
}

test fn direct_rust_door_production_stops_at_emission() -> Bool {
  match direct_rust_door_production_group().emission {
    AssemblyRejected { diagnostics: _ } => false
    InferenceRejected { diagnostics: _ } => false
    EmissionRejected { diagnostics: _ } => true
    ProducerReceiptRejected { diagnostics: _ } => false
    ArtifactProduced { artifact: _ } => false
  }
}

test fn direct_rust_door_production_stops_at_producer_receipt() -> Bool {
  match direct_rust_door_production_group().emission {
    AssemblyRejected { diagnostics: _ } => false
    InferenceRejected { diagnostics: _ } => false
    EmissionRejected { diagnostics: _ } => false
    ProducerReceiptRejected { diagnostics: _ } => true
    ArtifactProduced { artifact: _ } => false
  }
}

test fn direct_rust_door_production_reaches_artifact() -> Bool {
  match direct_rust_door_production_group().emission {
    AssemblyRejected { diagnostics: _ } => false
    InferenceRejected { diagnostics: _ } => false
    EmissionRejected { diagnostics: _ } => false
    ProducerReceiptRejected { diagnostics: _ } => false
    ArtifactProduced { artifact: _ } => true
  }
}

test fn direct_rust_door_missing_rule_leaf_established() -> Bool {
  direct_rust_door_leaf_established(
    leaf: direct_rust_door_production_group().missing_translation_rule_refusal
  )
}

test fn direct_rust_door_production_group_closing_expectation_holds() -> Bool {
  direct_rust_door_production_group_holds(group: direct_rust_door_production_group())
}
