module v2.test.long.v2_emitter_direct_rust_door_acceptance

import v2.compiler.self_host.v2_emitter_direct_rust_door_contract {
  v2_emitter_direct_rust_door_acceptance_admissions,
  v2_emitter_direct_rust_door_closing_contract_holds,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data v2_emitter_direct_rust_door_acceptance_long_note: String = "LONG lane (operator 5s rule): closing contract runs ingest-path production admissions and exceeds per-PR discovery budget."

test fn witness_v2_emitter_direct_rust_door_closing_contract_holds() -> Bool {
  v2_emitter_direct_rust_door_closing_contract_holds(
    admissions: v2_emitter_direct_rust_door_acceptance_admissions(),
  )
}
