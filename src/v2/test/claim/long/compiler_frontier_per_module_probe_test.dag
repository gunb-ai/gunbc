module v2.test.long.compiler_frontier_per_module_probe

import v2.compiler.self_host.frontier {
  compiler_frontier_receipt_totality_wall_holds,
  compiler_frontier_roster,
  compiler_frontier_roster_all_classified_holds,
  compiler_frontier_roster_count,
  compiler_frontier_roster_located_reason_not_class_projection_holds,
  compiler_frontier_roster_module_paths,
  compiler_frontier_row_for_path_matches_probe,
  compiler_frontier_roster_matches_survey_holds
}
import v2.compiler.self_host.frontier_probe_survey {
  CommonRoot,
  HeterogeneousGaps,
  frontier_gap_clustering_from_receipts,
  frontier_probe_survey_blocker_partition_totality_holds,
  frontier_probe_survey_has_unclassified,
  frontier_probe_survey_roster_bidirectional_totality_holds,
  frontier_wave2_name_resolution_module_count,
  frontier_wave2_realization_module_count,
  frontier_wave2_self_emit_ready_module_count
}
import v2.compiler.self_host.frontier_probe_types {
  NameResolutionGap,
  RealizationGap,
  SelfEmitReady
}
import v2.test.workflow.host_frontier_probe_survey_manifest {
  host_frontier_probe_survey,
  host_frontier_probe_survey_module_count
}
import v2.std.algebra { length }
import v2.std.logic { Bool }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data compiler_frontier_per_module_probe_note: String = "Fixture-FREE per-module emit-frontier probe over all 27 compiler modules via frontier_probe_survey bin (real ingest, no injected derisk fixtures). Validates roster blocker classes against execution-measured receipts; answers common-root (blocker-class clustering) vs heterogeneous located-reason gaps. OFFLINE consumer only — per-PR CI does not run this file (test/claim/long/ dir grain + gunbc.ci_layer_roots compiler_frontier_per_module_probe_exclusion_note). Local recipe authority: compiler_frontier_per_module_probe_exclusion_note in gunbc.ci_layer_roots."

data compiler_frontier_wave2_self_emit_ready_zero_note: String = "ready_count == 0 in wave2 sizing witnesses is green-by-construction on this probe slice: frontier_probe_emit_from_ingest never returns SelfEmitReady (emit-accept → UnknownProbeCause{^probe_emit_accept_self_host_bar_unbound}). Not a discriminating SelfEmitReady RED until the fixture-free emit→compile→run→equivalent bar is inhabited; honest deferral per ^probe_emit_accept_self_host_bar_unbound, not fabrication."

test fn compiler_frontier_per_module_probe_survey_holds() -> Bool {
  compiler_frontier_roster_matches_survey_holds(survey: host_frontier_probe_survey)
    && (host_frontier_probe_survey_module_count == compiler_frontier_roster_count())
    && (length(xs: host_frontier_probe_survey) == compiler_frontier_roster_count())
    && !frontier_probe_survey_has_unclassified(xs: host_frontier_probe_survey)
    && compiler_frontier_roster_all_classified_holds()
    && compiler_frontier_roster_located_reason_not_class_projection_holds()
}

test fn compiler_frontier_gap_clustering_common_root_at_blocker_class_holds() -> Bool {
  match frontier_gap_clustering_from_receipts(
    xs: host_frontier_probe_survey,
    module_count: host_frontier_probe_survey_module_count
  ) {
    CommonRoot {
      dominant_located_reason: _,
      dominant_module_count: _,
      module_count: _
    } => true
    HeterogeneousGaps {
      distinct_located_reason_count: _,
      module_count: _
    } => false
  }
}

test fn compiler_frontier_wave2_blocker_partition_totality_holds() -> Bool {
  frontier_probe_survey_blocker_partition_totality_holds(
    receipts: host_frontier_probe_survey,
    module_count: host_frontier_probe_survey_module_count
  )
}

test fn compiler_frontier_roster_bidirectional_totality_live_survey_holds() -> Bool {
  frontier_probe_survey_roster_bidirectional_totality_holds(
    survey: host_frontier_probe_survey,
    roster_paths: compiler_frontier_roster_module_paths(),
    roster_count: compiler_frontier_roster_count()
  )
}

test fn compiler_frontier_receipt_totality_wall_live_survey_holds() -> Bool {
  compiler_frontier_receipt_totality_wall_holds(survey: host_frontier_probe_survey)
}

data compiler_frontier_wave2_sizing_band_a_leaf_count_note: String = "Interim audit slice (neat-cat-330, 17/27 at 9f978aa8df — NOT closeout): assemble-stage grammar residue dominates in the surveyed modules — RealizationGap(parse_grammar_choice_overlap_residue) is the common root, not emit/upstream. ready_count == 0 remains green-by-construction; dominant realization_count >= 20 replaces the prior emit+upstream >= 20 band that assumed pre-emit measurement."

test fn compiler_frontier_wave2_emit_surface_dominates_holds() -> Bool {
  let realization_count = frontier_wave2_realization_module_count(receipts: host_frontier_probe_survey)
  let name_count = frontier_wave2_name_resolution_module_count(receipts: host_frontier_probe_survey)
  frontier_wave2_self_emit_ready_module_count(receipts: host_frontier_probe_survey) == 0
    && realization_count >= name_count
}

test fn compiler_frontier_wave2_sizing_band_a_leaf_count_holds() -> Bool {
  let realization_count = frontier_wave2_realization_module_count(receipts: host_frontier_probe_survey)
  frontier_wave2_self_emit_ready_module_count(receipts: host_frontier_probe_survey) == 0
    && realization_count >= 20
}
