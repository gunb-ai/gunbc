module v2.test.long.compiler_frontier_per_module_probe

import v2.compiler.self_host.frontier {
  compiler_frontier_receipt_totality_wall_holds,
  compiler_frontier_roster,
  compiler_frontier_roster_all_classified_holds,
  compiler_frontier_roster_count,
  compiler_frontier_roster_located_reason_not_class_projection_holds,
  compiler_frontier_roster_module_paths,
  compiler_frontier_row_for_path_matches_probe,
  compiler_frontier_roster_matches_survey_holds
}
import v2.compiler.self_host.frontier_probe_survey {
  CommonRoot,
  HeterogeneousGaps,
  frontier_gap_clustering_from_receipts,
  frontier_probe_survey_blocker_partition_totality_holds,
  frontier_probe_survey_has_unclassified,
  frontier_probe_survey_roster_bidirectional_totality_holds,
  frontier_survey_manifest_well_formed_holds,
  frontier_wave2_name_resolution_module_count,
  frontier_wave2_realization_module_count,
  frontier_wave2_self_emit_ready_module_count
}
import v2.compiler.self_host.frontier_probe_types {
  NameResolutionGap,
  RealizationGap,
  SelfEmitReady
}
import v2.test.workflow.host_frontier_probe_survey_manifest {
  host_frontier_probe_survey_manifest
}
import v2.std.algebra { length }
import v2.std.logic { Bool }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data compiler_frontier_per_module_probe_note: String = "Fixture-FREE per-module emit-frontier probe over all 27 compiler modules via frontier_probe_survey bin (real ingest, no injected derisk fixtures). Validates roster blocker classes against execution-measured receipts; answers common-root (blocker-class clustering) vs heterogeneous located-reason gaps. TERMINATING one-shot (witness_deferral_freeze TERMINATING specimen): runs once at a pinned head, then row + scaffold delete via dissolve_on — no per-PR cadence. CI ENROLLMENT: NOT in per-PR discovery — witness_discovery_scan_dirs omits src/v2/test/claim/long/; WitnessExclusionRow excludes test/claim/long/ and this file at OfflineLocalRecipe grain; not in falsifier_substrate_long_lane_entries or commit_gate_roster. Per-PR CI never executes these seven functions; green CI does not assert survey coverage. Local recipe RED on stub manifest (receipts Empty) is offline-only until the authoritative survey runs — not a CI failure shape. Local recipe authority: compiler_frontier_per_module_probe_exclusion_note in gunbc.ci_layer_roots."

data compiler_frontier_wave2_self_emit_ready_zero_note: String = "ready_count == 0 in wave2 sizing witnesses is green-by-construction on this probe slice: frontier_probe_emit_from_ingest never returns SelfEmitReady (emit-accept → UnknownProbeCause{^probe_emit_accept_self_host_bar_unbound}). Not a discriminating SelfEmitReady RED until the fixture-free emit→compile→run→equivalent bar is inhabited; honest deferral per ^probe_emit_accept_self_host_bar_unbound, not fabrication."

test fn compiler_frontier_per_module_probe_survey_holds() -> Bool {
  frontier_survey_manifest_well_formed_holds(manifest: host_frontier_probe_survey_manifest)
    && compiler_frontier_roster_matches_survey_holds(survey: host_frontier_probe_survey_manifest.receipts)
    && (length(xs: host_frontier_probe_survey_manifest.receipts) == compiler_frontier_roster_count())
    && !frontier_probe_survey_has_unclassified(xs: host_frontier_probe_survey_manifest.receipts)
    && compiler_frontier_roster_all_classified_holds()
    && compiler_frontier_roster_located_reason_not_class_projection_holds()
}

data compiler_frontier_gap_clustering_empty_stub_note: String = "This claim requires a NONEMPTY survey before it reads the verdict, and the requirement is the point rather than a guard. Against the checked-in stub (receipts Empty) it previously passed: clustering asked self_emit_ready_count == module_count, both were 0, and it answered CommonRoot with dominant_located_reason ^probe_stage_emit_ok — a survey with no receipts reporting that every module reached emit. That is the vacuous green this lane exists to prevent, and it sat inside the one claim whose subject is the clustering verdict. Receipt-derived clustering now answers HeterogeneousGaps for an empty survey (empty_survey_is_never_a_common_root_holds pins it per-PR), so this claim reds on the stub — the same state its siblings were already in, since compiler_frontier_per_module_probe_survey_holds compares the receipt count against the 27-row roster and 0 is not 27. Red-on-stub is the file's declared offline condition, not a CI failure shape; the length check makes THIS claim's red say so explicitly rather than leaving it to be read as a clustering disagreement."

test fn compiler_frontier_gap_clustering_common_root_at_blocker_class_holds() -> Bool {
  clustering_survey_is_nonempty() && clustering_verdict_is_common_root()
}

fn clustering_survey_is_nonempty() -> Bool {
  length(xs: host_frontier_probe_survey_manifest.receipts) > 0
}

fn clustering_verdict_is_common_root() -> Bool {
  match frontier_gap_clustering_from_receipts(
    xs: host_frontier_probe_survey_manifest.receipts,
    module_count: length(xs: host_frontier_probe_survey_manifest.receipts)
  ) {
    CommonRoot {
      dominant_located_reason: _,
      dominant_module_count: _,
      module_count: _
    } => true
    HeterogeneousGaps {
      distinct_located_reason_count: _,
      module_count: _
    } => false
  }
}

test fn compiler_frontier_wave2_blocker_partition_totality_holds() -> Bool {
  frontier_probe_survey_blocker_partition_totality_holds(
    receipts: host_frontier_probe_survey_manifest.receipts,
    module_count: length(xs: host_frontier_probe_survey_manifest.receipts)
  )
}

test fn compiler_frontier_roster_bidirectional_totality_live_survey_holds() -> Bool {
  frontier_probe_survey_roster_bidirectional_totality_holds(
    survey: host_frontier_probe_survey_manifest.receipts,
    roster_paths: compiler_frontier_roster_module_paths(),
    roster_count: compiler_frontier_roster_count()
  )
}

test fn compiler_frontier_receipt_totality_wall_live_survey_holds() -> Bool {
  compiler_frontier_receipt_totality_wall_holds(survey: host_frontier_probe_survey_manifest.receipts)
}

data compiler_frontier_wave2_sizing_band_a_leaf_count_note: String = "Closeout band: realization_count >= 20 applies when host_frontier_probe_survey_manifest binds all 27 execution_measurement receipts at one pinned source_head. Prior interim audit at 9f978aa8df (#7697) had execution_measurement=17 (14 RealizationGap + 3 NameResolutionGap at ProbeStageAssemble, self_emit_ready=0); superseded — not combinable with a later head."

test fn compiler_frontier_wave2_emit_surface_dominates_holds() -> Bool {
  let realization_count = frontier_wave2_realization_module_count(receipts: host_frontier_probe_survey_manifest.receipts)
  let name_count = frontier_wave2_name_resolution_module_count(receipts: host_frontier_probe_survey_manifest.receipts)
  frontier_wave2_self_emit_ready_module_count(receipts: host_frontier_probe_survey_manifest.receipts) == 0
    && realization_count >= name_count
}

test fn compiler_frontier_wave2_sizing_band_a_leaf_count_holds() -> Bool {
  let realization_count = frontier_wave2_realization_module_count(receipts: host_frontier_probe_survey_manifest.receipts)
  frontier_wave2_self_emit_ready_module_count(receipts: host_frontier_probe_survey_manifest.receipts) == 0
    && realization_count >= 20
}
