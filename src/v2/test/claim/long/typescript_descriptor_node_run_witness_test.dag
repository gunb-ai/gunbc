module v2.test.long.typescript_descriptor_node_run_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data typescript_descriptor_node_run_long_note: String = "Wet host-run typescript descriptor probes (review 43557). OfflineLocalRecipe under long/; helpers live in typescript_descriptor_node_run.dag (not *_test.dag). Dissolve-on: emit-host MVP smokes subsume these, or measured under fast-lane and re-enroll per-PR."

test fn typescript_descriptor_node_ts_node_run_add_holds() -> Bool {
  match v2.test.manual.add_body_emit_typescript.add_body_ts_emit_from_producer_tree(target: v2.extdeps.languages.typescript.ts_target_model()) {
    v2.std.diagnostic.Accepted { value: source, diagnostics: v2.std.diagnostic.None } =>
      match v2.test.manual.typescript_descriptor_node_run_support.typescript_descriptor_node_host_run_i32(target: v2.extdeps.languages.typescript.ts_target_model(), source: source) {
        v2.std.diagnostic.Accepted { value: n, diagnostics: v2.std.diagnostic.None } => n == 5
        _ => false
      }
    _ => false
  }
}

test fn typescript_descriptor_node_ts_node_run_catalog_minus_discriminates() -> Bool {
  match v2.test.manual.add_body_emit_typescript.add_body_ts_emit_from_producer_tree(target: v2.test.manual.add_body_emit_typescript.add_body_ts_target_model_minus_catalog()) {
    v2.std.diagnostic.Accepted { value: source, diagnostics: v2.std.diagnostic.None } =>
      match v2.test.manual.typescript_descriptor_node_run_support.typescript_descriptor_node_host_run_i32(
        target: v2.test.manual.add_body_emit_typescript.add_body_ts_target_model_minus_catalog(),
        source: source
      ) {
        v2.std.diagnostic.Accepted { value: n, diagnostics: v2.std.diagnostic.None } => n == -1
        _ => false
      }
    _ => false
  }
}
