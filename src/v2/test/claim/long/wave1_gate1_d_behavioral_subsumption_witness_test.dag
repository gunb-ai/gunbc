module v2.test.long.wave1_gate1_d_behavioral_subsumption_witness

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.test.execution.add_arrow_eval_by_execution {
  add_arrow_ingested_canonical_executes_holds,
  add_arrow_ingested_swapped_operands_red_holds
}
import v2.test.execution.bind_eval_by_execution {
  bind_ingested_canonical_executes_holds,
  bind_ingested_wrong_value_red_holds
}
import v2.test.execution.branch_eval_by_execution {
  branch_ingested_pick_false_executes_holds,
  branch_ingested_pick_true_executes_holds,
  branch_ingested_swapped_arms_red_holds
}
import v2.test.execution.emit_host_classical_not_ingested_equals_eval {
  emit_host_classical_not_ingested_equals_eval_holds,
  emit_host_classical_not_ingested_swapped_refuses_holds
}
import v2.test.execution.loop_eval_by_execution {
  loop_ingested_canonical_executes_holds,
  loop_ingested_wrong_value_red_holds
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data wave1_gate1_d_behavioral_subsumption_note: String = "Wave 1 Gate 1 Stage D long lane: census-ingest Arrows (ingested_fixture_arrows) execute equivalently to the retired produce_* fixture family — canonical eval greens plus swapped-operand/wrong-value RED controls. Well-formedness-only receipts live in wave1_gate1_d_mvp_subsumption_witness_test.dag; table_fixture fast-lane receipts live in self_host/wave1_gate1_d_mvp_subsumption_witness_test.dag."

test fn wave1_gate1_d_ingested_add_behavioral_subsumption_holds() -> Bool {
  add_arrow_ingested_canonical_executes_holds()
    && add_arrow_ingested_swapped_operands_red_holds()
}

test fn wave1_gate1_d_ingested_pick_behavioral_subsumption_holds() -> Bool {
  branch_ingested_pick_true_executes_holds()
    && branch_ingested_pick_false_executes_holds()
    && branch_ingested_swapped_arms_red_holds()
}

test fn wave1_gate1_d_ingested_loop_behavioral_subsumption_holds() -> Bool {
  loop_ingested_canonical_executes_holds()
    && loop_ingested_wrong_value_red_holds()
}

test fn wave1_gate1_d_ingested_bind_behavioral_subsumption_holds() -> Bool {
  bind_ingested_canonical_executes_holds()
    && bind_ingested_wrong_value_red_holds()
}

test fn wave1_gate1_d_ingested_match_behavioral_subsumption_holds() -> Bool {
  emit_host_classical_not_ingested_equals_eval_holds()
    && emit_host_classical_not_ingested_swapped_refuses_holds()
}
