module v2.test.long.cross_tree_real_ingest_activation

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data ct_real_v2_subject_source: Medium<String> = extdeps.communication.medium.Medium {
  carried: "module v2.ct_real_subject\n",
  fidelity: extdeps.communication.medium.Lossless
}

data ct_real_dag_target_source: Medium<String> = extdeps.communication.medium.Medium {
  carried: "module ct_real_target\n",
  fidelity: extdeps.communication.medium.Lossless
}

data ct_real_v2_subject_artifact: v2.std.artifact.Artifact = v2.std.artifact.Artifact {
  kind: SourceFile,
  id: ^ct_real_v2_subject_artifact,
  file_path: "src/v2/ct_real_subject.dag"
}

data ct_real_dag_target_artifact: v2.std.artifact.Artifact = v2.std.artifact.Artifact {
  kind: SourceFile,
  id: ^ct_real_dag_target_artifact,
  file_path: "dag/ct_real_target.dag"
}

data ct_real_v2_to_dag_subject_read: v2.compiler.source_authority.DagSourceReadWitness = v2.compiler.source_authority.DagSourceReadWitness {
  source: ct_real_v2_subject_source,
  artifact: ct_real_v2_subject_artifact,
  compilation_unit: ^ct_real_subject_cu,
  source_root: V2Tree
}

data ct_real_v2_to_dag_target_read: v2.compiler.source_authority.DagSourceReadWitness = v2.compiler.source_authority.DagSourceReadWitness {
  source: ct_real_dag_target_source,
  artifact: ct_real_dag_target_artifact,
  compilation_unit: ^ct_real_target_cu,
  source_root: DagTree
}

data ct_real_v2_to_dag_ingest: v2.compiler.source_authority.SourceRootIngest = std.algebra.Cons {
  head: ct_real_v2_to_dag_subject_read,
  tail: std.algebra.Cons { head: ct_real_v2_to_dag_target_read, tail: std.algebra.Empty }
}

data ct_real_dag_to_v2_subject_read: v2.compiler.source_authority.DagSourceReadWitness = v2.compiler.source_authority.DagSourceReadWitness {
  source: ct_real_v2_subject_source,
  artifact: ct_real_v2_subject_artifact,
  compilation_unit: ^ct_real_subject_cu,
  source_root: DagTree
}

data ct_real_dag_to_v2_target_read: v2.compiler.source_authority.DagSourceReadWitness = v2.compiler.source_authority.DagSourceReadWitness {
  source: ct_real_dag_target_source,
  artifact: ct_real_dag_target_artifact,
  compilation_unit: ^ct_real_target_cu,
  source_root: V2Tree
}

data ct_real_dag_to_v2_ingest: v2.compiler.source_authority.SourceRootIngest = std.algebra.Cons {
  head: ct_real_dag_to_v2_subject_read,
  tail: std.algebra.Cons { head: ct_real_dag_to_v2_target_read, tail: std.algebra.Empty }
}

fn ct_real_subject_qn() -> v2.std.qualified_name.QualifiedName {
  std.algebra.Cons { head: ^v2, tail: std.algebra.Cons { head: ^ct_real_subject, tail: std.algebra.Empty } }
}

fn ct_real_target_qn() -> v2.std.qualified_name.QualifiedName {
  std.algebra.Cons { head: ^ct_real_target, tail: std.algebra.Empty }
}

fn ct_real_edge_decision(ingest: v2.compiler.source_authority.SourceRootIngest) -> v2.std.cross_tree.resolution.CrossTreeEdgeDecision {
  match program_assembly_fold_ingest(ingest: ingest, lm: dag_language_model()) {
    ProgramAssemblyFoldFailed { diagnostics: _ } => EdgeCrossAmbiguous
    ProgramAssemblyFoldOk { roots: _, index: idx } =>
      cross_tree_edge_decision(
        index: idx,
        from_qn: ct_real_subject_qn(),
        to_qn: ct_real_target_qn(),
        active_roots: source_root_set_from_ingest(ingest: ingest)
      )
  }
}

test fn cross_tree_real_ingest_v2_to_dag_admitted_holds() -> Bool {
  match ct_real_edge_decision(ingest: ct_real_v2_to_dag_ingest) {
    EdgeCrossAdmitted => true
    EdgeCrossDenied => false
    EdgeNormalResolution => false
    EdgeCrossAmbiguous => false
  }
}

test fn cross_tree_real_ingest_dag_to_v2_denied_holds() -> Bool {
  match ct_real_edge_decision(ingest: ct_real_dag_to_v2_ingest) {
    EdgeCrossDenied => true
    EdgeCrossAdmitted => false
    EdgeNormalResolution => false
    EdgeCrossAmbiguous => false
  }
}

