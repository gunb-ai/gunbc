data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// WITNESSES FOR THE ACQUIRER'S EXACTNESS VERDICT (docs/plans/source-layout-authority.md R9: the read set
// of a compile is checked against the requested closure, exactly). The verdict is a pure fold over a
// completed acquisition's receipt -- the entries, the members with the requests each one's own text made,
// and the keys of the files that were read -- so every control here states the receipt a host would hand
// the fold and asserts the verdict; nothing reads a file. The pairing obligation (DESIGN section 3, a
// witness discriminates at one interface) is carried by the native layout and compile verbs, which run
// the same acquirer over the real repository: deleting that integration would not fail THIS file, which is
// why it names no repository path.
//
// Every refusal control pins the KIND and the located subject of the one refusal it expects, because a
// verdict that said "not exact" for the wrong reason would pass a boolean.

fn exactness_kind(verdict: AcquisitionExactness) -> String {
  match verdict {
    AcquisitionExact => "exact"
    AcquisitionReadWithoutMember { key: key } => concat("read-without-member:", key)
    AcquisitionReadTwice { key: key } => concat("read-twice:", key)
    AcquisitionMemberNotRead { key: key } => concat("member-not-read:", key)
    AcquisitionReadNotRequested { module: unrequested } => concat("read-not-requested:", unrequested)
    AcquisitionRequestedNotRead { spelling: spelling, from_module: from_module } =>
      concat("requested-not-read:", spelling, "@", from_module)
  }
}

fn a_request(from_module: String, spelling: String, kind: AcquisitionKind) -> AcquisitionRequest {
  AcquisitionRequest { from_module: from_module, from_tree: V2Tree {}, spelling: spelling, kind: kind }
}

fn a_member(name: String, path: String, requests: List<AcquisitionRequest>) -> AcquiredModule {
  AcquiredModule {
    name: name,
    file: ModuleFileRef { tree: V2Tree {}, relative_path: path },
    host_directory: "src/v2",
    content: "",
    requests: requests,
    test_markers: []
  }
}

fn key_of(member: AcquiredModule) -> String {
  module_file_key(file: member.file)
}

// The subject imports the logic module; the outsider is a module no request names.
fn subject_importing(spelling: String) -> AcquiredModule {
  a_member(
    name: "v2.test.subject",
    path: "test/subject.dag",
    requests: [a_request(from_module: "v2.test.subject", spelling: spelling, kind: AcquireImportedModule {})]
  )
}

fn subject_member() -> AcquiredModule {
  subject_importing(spelling: "v2.std.logic")
}

fn logic_member() -> AcquiredModule {
  a_member(name: "v2.std.logic", path: "std/logic.dag", requests: [])
}

fn outsider_member() -> AcquiredModule {
  a_member(name: "v2.unrelated.outsider", path: "unrelated/outsider.dag", requests: [])
}

fn closure_entries() -> List<String> {
  ["v2.test.subject"]
}

fn verdict_over(entries: List<String>, modules: List<AcquiredModule>, reads: List<String>) -> String {
  exactness_kind(verdict: acquisition_exactness(entries: entries, modules: modules, reads: reads))
}

test fn a_read_set_that_is_the_requested_closure_is_exact() -> Bool {
  verdict_over(
    entries: closure_entries(),
    modules: [subject_member(), logic_member()],
    reads: [key_of(member: subject_member()), key_of(member: logic_member())]
  ) == "exact"
}

// THE DISCRIMINATING RED FOR "A MODULE OUTSIDE THE CLOSURE CHANGES NOTHING": the outsider was read, and
// no entry and no member's own text asked for it, so the closure the run holds is wider than the one it
// requested and the verdict names the module -- never a smaller set, never a silently wider one.
test fn a_module_nothing_requested_is_refused_as_unrequested() -> Bool {
  verdict_over(
    entries: closure_entries(),
    modules: [subject_member(), logic_member(), outsider_member()],
    reads: [key_of(member: subject_member()), key_of(member: logic_member()), key_of(member: outsider_member())]
  ) == "read-not-requested:v2.unrelated.outsider"
}

test fn a_member_the_walk_did_not_read_is_refused() -> Bool {
  verdict_over(
    entries: closure_entries(),
    modules: [subject_member(), logic_member()],
    reads: [key_of(member: subject_member())]
  ) == "member-not-read:v2:std/logic.dag"
}

test fn a_file_read_twice_is_refused() -> Bool {
  verdict_over(
    entries: closure_entries(),
    modules: [subject_member(), logic_member()],
    reads: [key_of(member: subject_member()), key_of(member: logic_member()), key_of(member: logic_member())]
  ) == "read-twice:v2:std/logic.dag"
}

test fn a_read_that_belongs_to_no_member_is_refused() -> Bool {
  verdict_over(
    entries: closure_entries(),
    modules: [subject_member(), logic_member()],
    reads: [key_of(member: subject_member()), key_of(member: logic_member()), "v2:std/ghost.dag"]
  ) == "read-without-member:v2:std/ghost.dag"
}

// An import is an EXACT request: it names a module whole, so a closure that holds no such member is
// short of what its own text asked for, and the refusal carries the module that asked.
test fn an_import_whose_module_was_never_acquired_is_refused() -> Bool {
  verdict_over(
    entries: closure_entries(),
    modules: [subject_importing(spelling: "v2.std.missing")],
    reads: [key_of(member: subject_member())]
  ) == "requested-not-read:v2.std.missing@v2.test.subject"
}

test fn an_entry_no_member_covers_is_refused() -> Bool {
  verdict_over(
    entries: ["v2.test.subject", "v2.test.absent"],
    modules: [subject_member(), logic_member()],
    reads: [key_of(member: subject_member()), key_of(member: logic_member())]
  ) == "requested-not-read:v2.test.absent@"
}

// A QUALIFIED REFERENCE IS NOT AN EXACT REQUEST. It names every dotted prefix of its spelling because the
// lookup splits a reference by probing prefixes, so the module that owns `v2.std.logic.and` is requested
// by it; and a reference whose prefixes name no module was never owed a read.
test fn a_qualified_reference_requests_the_module_that_owns_it() -> Bool {
  verdict_over(
    entries: closure_entries(),
    modules: [
      a_member(
        name: "v2.test.subject",
        path: "test/subject.dag",
        requests: [a_request(from_module: "v2.test.subject", spelling: "v2.std.logic.and", kind: AcquireQualifiedReference {})]
      ),
      logic_member()
    ],
    reads: [key_of(member: subject_member()), key_of(member: logic_member())]
  ) == "exact"
}

test fn a_qualified_reference_that_names_no_module_is_not_owed_a_read() -> Bool {
  verdict_over(
    entries: closure_entries(),
    modules: [
      a_member(
        name: "v2.test.subject",
        path: "test/subject.dag",
        requests: [a_request(from_module: "v2.test.subject", spelling: "local.record.field", kind: AcquireQualifiedReference {})]
      )
    ],
    reads: [key_of(member: subject_member())]
  ) == "exact"
}

// ---- the acquired members as the ingest later stages read ---------------------------------------------

test fn the_ingest_holds_exactly_the_acquired_modules() -> Bool {
  length(xs: acquisition_ingest(modules: [subject_member(), logic_member()])) == 2
}

test fn a_member_is_named_by_the_host_path_it_was_read_from() -> Bool {
  acquisition_module_path(module: subject_member()) == "src/v2/test/subject.dag"
}

// ---- the member's own text, read by the front end -------------------------------------------------------

// WHAT A MEMBER ASKS FOR IS READ BY THE FRONT END AND BY NOTHING ELSE. The acquirer is the only reader of
// a member's import lines now, so an import line that names no module must REFUSE the member rather than
// be skipped: a skipped import is a NARROWED CLOSURE -- the module the line meant to name is never read,
// its declarations never reach the universe, and the run ends green over a smaller population than the
// source asked for. DESIGN section 5 forbids exactly that arm, and narrowing is the worse direction
// because it terminates in a pass rather than in a visible over-scan. (Review 64474 item 5; the controls
// of 2026-09-12 were written against the text scan that this reading replaced.)
//
// THE SUBJECT IS acquisition_member_requests, NOT A LINE PREDICATE: a test that stopped at a predicate
// would prove the malformed line is recognised and nothing about whether recognition reaches the
// verdict. The two malformed spellings differ in the shape a prefix test cannot see -- `import` with only
// spaces after it trims to `import`, so a predicate keyed on the prefix `import ` is false for it -- and
// the well-formed control differs from them in the import line alone, so the refusal is attributable to
// it and a reader that refused everything is told apart.

fn member_read_text(read: AcquisitionMemberRead) -> String {
  match read {
    AcquisitionMemberReadOk { requests: requests, test_markers: markers } =>
      concat("read|", join(requests.imports, ","), "|", join(markers, ","))
    AcquisitionMemberReadRefused { refusal: refusal } => acquisition_refusal_text(refusal: refusal)
  }
}

fn member_read_of(content: String) -> String {
  match prepare_grammar(grammar: dag_language_model().grammar) {
    Rejected { diagnostics: _ } => "grammar-unprepared"
    Accepted { value: prepared, diagnostics: _ } =>
      member_read_text(
        read: acquisition_member_requests(
          env: AcquisitionEnv {
            layout: repository_storage_layout(),
            bindings: [],
            lex: prepare_lex_rules(rules: dag_language_model().lex),
            grammar: prepared
          },
          module: "v2.test.subject",
          file: ModuleFileRef { tree: V2Tree {}, relative_path: "test/subject.dag" },
          content: content
        )
      )
  }
}

fn refused_member_prefix() -> String {
  "module v2.test.subject at v2:test/subject.dag did not front-end"
}

test fn a_malformed_import_line_refuses_the_member_it_sits_in() -> Bool {
  starts_with(
    s: member_read_of(content: "module v2.test.subject\nimport \nfn subject() -> Bool { true }\n"),
    prefix: refused_member_prefix()
  )
}

test fn a_bare_import_line_refuses_the_member_it_sits_in() -> Bool {
  starts_with(
    s: member_read_of(content: "module v2.test.subject\nimport    \nfn subject() -> Bool { true }\n"),
    prefix: refused_member_prefix()
  )
}

// The positive control, and the member's marked declarations ride the same read.
test fn a_well_formed_import_is_requested_and_its_marked_declaration_is_captured() -> Bool {
  member_read_of(
    content: "module v2.test.subject\nimport v2.std.optional { Present }\ntest fn a_claim() -> Bool { true }\n"
  ) == "read|v2.std.optional|a_claim"
}

// ---- the marker channel, read off the parse tree alone -----------------------------------------------------
//
// THE SUBJECT IS acquisition_test_markers: which declarations of one member carry the authored `test`
// marker, asked of a member whether or not it can be lowered. The paired control is the member read above:
// a service declaration whose realization is set aside refuses ordinary normalization, so the same text
// that member_read_of refuses is the text whose markers are still read here -- the route is asserted, not
// only the answer. And the refusal arm is the other half: a file that does not parse is a refusal, never
// an empty list, because an unread file read as unmarked is the absent-reads-as-false class the channel
// exists to close.

fn markers_text(read: AcquisitionMarkerRead) -> String {
  match read {
    AcquisitionMarkersRead { names: names } => concat("read|", join(names, ","))
    AcquisitionMarkersRefused { cause: cause } => concat("refused|", cause)
  }
}

fn markers_of(content: String) -> String {
  match prepare_grammar(grammar: dag_language_model().grammar) {
    Rejected { diagnostics: _ } => "grammar-unprepared"
    Accepted { value: prepared, diagnostics: _ } =>
      markers_text(
        read: acquisition_test_markers(
          env: AcquisitionEnv {
            layout: repository_storage_layout(),
            bindings: [],
            lex: prepare_lex_rules(rules: dag_language_model().lex),
            grammar: prepared
          },
          file: ModuleFileRef { tree: V2Tree {}, relative_path: "test/subject.dag" },
          content: content
        )
      )
  }
}

fn service_with_a_marked_claim() -> String {
  concat(
    "module v2.test.subject\nservice s.Svc {\n  operation Op {\n    requires none\n    input { n: Int }\n",
    "    output { ok: Bool from \"exit_success\" }\n    transport shell { argv: [\"true\"] }\n",
    "    exit {\n      0 => Unit\n      nonzero => String \"failed\"\n    }\n  }\n}\n",
    "test fn a_claim() -> Bool { true }\n"
  )
}

test fn only_the_marked_declaration_of_a_member_is_read_as_marked() -> Bool {
  markers_of(content: "module v2.test.subject\nfn plain() -> Bool { true }\ntest fn a_claim() -> Bool { true }\n") == "read|a_claim"
}

test fn a_member_declaring_no_test_reads_as_marked_nothing_not_as_refused() -> Bool {
  markers_of(content: "module v2.test.subject\nfn plain() -> Bool { true }\n") == "read|"
}

test fn a_member_that_does_not_parse_is_refused_not_read_as_unmarked() -> Bool {
  starts_with(s: markers_of(content: "module v2.test.subject\ntest fn a_claim( -> Bool { true }\n"), prefix: "refused|")
}

test fn a_member_ordinary_normalization_refuses_still_has_its_markers_read() -> Bool {
  starts_with(s: member_read_of(content: service_with_a_marked_claim()), prefix: refused_member_prefix())
    && markers_of(content: service_with_a_marked_claim()) == "read|a_claim"
}

// ---- enumerating the declared namespaces ----------------------------------------------------------------
//
// THE SUBJECT IS THE PURE HALF OF THE ENUMERATION: which directories a declared namespace list puts a
// walk under, and which module name a walked path denotes. The walk itself reads a host directory, so
// the claim that it lists the files a tree really holds is carried by the native lane's census over a
// real root, which is the route deleting the integration would fail; these controls state the values
// the walk is handed and the names it hands back.

fn joined(names: List<String>) -> String {
  join(names, ",")
}

// A declared namespace is walked from its top-level segment once, so a nested row adds nothing to the
// walks and the first row to name a top-level namespace fixes its place.
test fn nested_rows_collapse_to_their_distinct_top_level_namespaces_in_first_named_order() -> Bool {
  joined(top_level_namespaces(namespaces: ["gunbc", "gunbc.auth", "std", "v2.compiler", "v2.std", "std.algebra"])) == "gunbc,std,v2"
}

test fn no_declared_namespace_walks_nothing() -> Bool {
  length(xs: top_level_namespaces(namespaces: [])) == 0
}

test fn a_single_segment_namespace_is_its_own_top_level() -> Bool {
  namespace_top_level(namespace: "std") == "std"
}

test fn a_dotted_namespace_names_its_first_segment() -> Bool {
  namespace_top_level(namespace: "gunbc.auth.access") == "gunbc"
}

// The directory a namespace occupies is the directory of a probe module placed directly in it, less
// the probe's own file name; a namespace the rule stores at the tree's root occupies the root itself.
test fn a_namespace_stored_at_the_tree_root_occupies_the_root() -> Bool {
  namespace_relative_directory(probe_relative_path: "x.dag") == ""
}

test fn a_namespace_occupies_the_directory_its_probe_module_sits_in() -> Bool {
  namespace_relative_directory(probe_relative_path: "std/x.dag") == "std"
}

test fn a_nested_namespace_occupies_a_nested_directory() -> Bool {
  namespace_relative_directory(probe_relative_path: "gunbc/auth/x.dag") == "gunbc/auth"
}

// A walked path denotes the module the rule would store there: the namespace the walk started from,
// then the path below the walked directory with its separators read as segment dots.
test fn a_walked_path_below_the_namespace_directory_names_its_module() -> Bool {
  namespace_module_name(namespace: "gunbc", directory: "dag/gunbc", path: "dag/gunbc/auth/access.dag") == "gunbc.auth.access"
}

test fn a_walked_path_directly_in_the_namespace_directory_names_a_direct_member() -> Bool {
  namespace_module_name(namespace: "std", directory: "dag/std", path: "dag/std/logic.dag") == "std.logic"
}

// A listing is added in its own order ahead of what earlier namespaces already listed, so the
// enumeration the callers see is one flat list of module names with none repeated and none dropped.
test fn a_listing_is_added_ahead_of_the_names_already_listed() -> Bool {
  joined(bound_modules_prepended(listed: ["a.x", "a.y"], acc: ["b.z"])) == "a.x,a.y,b.z"
}

// ---- what a walk of one namespace directory means to a caller who named the namespace ------------------
//
// THE SUBJECT IS THE MAPPING FROM WHAT A DIRECTORY WALK OBSERVED TO WHAT A CALLER IS TOLD. A caller that
// names one namespace asked for a population that must be there, so an absent directory refuses; the
// population enumeration over every bound tree reads the same observation as an empty namespace instead,
// and that reading is not stated here because it is a different caller of the same walk. The three
// walk observations are supplied; the walk itself is carried by the native population verbs over a real
// tree.

fn named_listing_text(listing: NamespaceModules) -> String {
  match listing {
    NamespaceModulesListed { namespace: namespace, modules: modules } => concat("listed|", namespace, "|", joined(modules))
    NamespaceModulesRefused { namespace: namespace, cause: cause } => concat("refused|", namespace, "|", cause)
  }
}

test fn a_named_namespace_with_no_directory_is_refused_naming_the_directory() -> Bool {
  named_listing_text(
    listing: namespace_named_listing(walk: NamespaceWalkAbsent { namespace: "std", directory: "dag/std" })
  ) == "refused|std|dag/std: the namespace has no directory under its tree"
}

test fn a_listed_namespace_hands_back_its_modules_in_the_order_the_walk_observed() -> Bool {
  named_listing_text(
    listing: namespace_named_listing(walk: NamespaceWalkListed { namespace: "std", modules: ["std.a", "std.b"] })
  ) == "listed|std|std.a,std.b"
}

test fn a_namespace_whose_walk_failed_is_refused_with_the_walks_own_cause() -> Bool {
  named_listing_text(
    listing: namespace_named_listing(walk: NamespaceWalkRefused { namespace: "std", cause: "dag/std/x: permission_denied: denied" })
  ) == "refused|std|dag/std/x: permission_denied: denied"
}

// ---- when a refused walk is the namespace directory itself being absent --------------------------------
//
// Only the namespace directory missing answers "no module of this namespace is stored here"; the same
// failure kind one level down, or another kind on the directory, is a listing that failed and stays a
// refusal. The four controls differ from the one positive in exactly one input each, so a predicate
// that read only the kind, only the path, or accepted any kind it could not name is told apart.

test fn the_namespace_directory_not_being_found_is_the_absent_path() -> Bool {
  namespace_directory_is_the_absent_path(path: "dag/std", directory: "dag/std", kind: "not_found")
}

test fn a_missing_entry_beneath_the_namespace_directory_is_not_the_absent_path() -> Bool {
  namespace_directory_is_the_absent_path(path: "dag/std/x", directory: "dag/std", kind: "not_found") == false
}

test fn an_unreadable_namespace_directory_is_not_the_absent_path() -> Bool {
  namespace_directory_is_the_absent_path(path: "dag/std", directory: "dag/std", kind: "permission_denied") == false
}

test fn a_failure_kind_the_filesystem_authority_does_not_name_is_not_the_absent_path() -> Bool {
  namespace_directory_is_the_absent_path(path: "dag/std", directory: "dag/std", kind: "no_such_kind") == false
}

// ---- whether one member parses, and what is kept of it -------------------------------------------------
//
// THE SUBJECT IS THE VERDICT THE STREAMING POPULATION PARSE FOLDS: parses, or refused with the cause.
// The well-formed control differs from the malformed one in one token, so a verdict that refused every
// member, or accepted every member, is told apart.

fn member_parse_text(content: String) -> String {
  match prepare_grammar(grammar: dag_language_model().grammar) {
    Rejected { diagnostics: _ } => "grammar-unprepared"
    Accepted { value: prepared, diagnostics: _ } =>
      match acquisition_parse(
        env: AcquisitionEnv {
          layout: repository_storage_layout(),
          bindings: [],
          lex: prepare_lex_rules(rules: dag_language_model().lex),
          grammar: prepared
        },
        file: ModuleFileRef { tree: V2Tree {}, relative_path: "test/subject.dag" },
        content: content
      ) {
        MemberParses => "parses"
        MemberParseRefused { cause: _ } => "refused"
      }
  }
}

test fn a_well_formed_member_parses() -> Bool {
  member_parse_text(content: "module v2.test.subject\nfn subject() -> Bool { true }\n") == "parses"
}

test fn a_member_with_an_unclosed_body_is_refused() -> Bool {
  member_parse_text(content: "module v2.test.subject\nfn subject() -> Bool { true\n") == "refused"
}
