module v2.test.claim.caller_admission_native_wall

// THE DISCRIMINATING REDS AND THEIR CONTROLS for gunbc.rung_drop
// admit_callers_discarded_on_the_native_route. The clause was parsed by the v2 grammar and then
// discarded at Arrow lowering, so the native route never checked caller admission; the wall now
// lives in v2.compiler.infer (infer_caller_admission_diags), keyed on the admit_callers edge
// v2.compiler.body_lowering_fold body_lower_fn_admit_clause_edges carries onto the Arrow. The
// claims drive fixture modules through the real pipeline (tokenize -> parse -> normalize ->
// admitted normalized tree -> resolve -> infer, or assemble_program_from_ingest for the
// cross-module fixtures) and assert the seed's verdicts, copied symbol for symbol from v1's
// constructor_call_admission_diags:
//   - a call from a declaration outside the list refuses (^infer_reason_caller_admission_refused),
//     SAME-MODULE (caller and sealed fn in one module) and CROSS-MODULE (the subject module calls a
//     sealed fn imported from a peer module -- the clause's real work: the judge reads the callee's
//     declared Arrow through the use's facts entry, whose grounding evidence is the peer's
//     declaration, edges included);
//   - a call from the listed declaration is admitted (the floor's own behavior unchanged),
//     SAME-MODULE and CROSS-MODULE;
//   - an entry that is not a decl_ref(module_path: "...", decl_name: "...") call refuses at the
//     entry (^infer_reason_admit_callers_entry_not_decl_ref), never shrinking the roster silently.
// The fixtures are strings, so a refusal here is a verdict ABOUT the fixture, not a refusal of
// this claim module's own prepare: the floor stays green with the wall live. Each fixture's
// resolved outcome is computed ONCE as a nullary value of this module, and the claims read it --
// a claim that drove its own parse inline was over the new-witness eval-step budget, as the
// trailing-comma claim records.

import v2.compiler.infer { ObligatedInferredTree, infer, body_infer_projection_child }
import v2.compiler.name_resolve { Admission, ResolutionSubject }
import v2.compiler.normalized_tree { NormalizedTree, admit_normalized_tree, no_type_declaration_modifiers }
import v2.compiler.parse { parse_module_prepared }
import v2.compiler.program_assembly { assemble_program_from_ingest, dag_prepared_grammar, program_assembly_phase_normalize_seeded, program_assembly_normalized_outcome }
import v2.compiler.source_authority { DagSourceReadWitness }
import v2.extdeps.languages.dag { dag_language_model, dag_lex, named_child_lookup, NamedChildFound, NamedChildMissing, NamedChildAmbiguous }
import v2.compiler.body_lowering_fold { body_lower_find_production_shell_optional, body_lower_deep_unwrap_optional, body_lower_where_leaf_atom_optional, body_lower_where_argument_items, body_lower_where_arguments, WherePredicateArgument, WhereArgumentLabelled, WhereArgumentPositional }
import v2.std.compilers.sugar { sugar_sequence_pair_optional }
import std.content_hash { Fnv1a64Structural }
import std.occurrence_identity { OccurrenceIdAllocator }
import v2.compiler.resolve { ResolvedTree, resolve }
import v2.compiler.tokenize { tokenize }
import extdeps.communication.medium { Lossless, Medium }
import std.algebra { Cons, Empty }
import v2.extdeps.languages.dag { dag_language_model, dag_lex }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.cross_tree.import_model { V2Tree }
import v2.std.diagnostic { Accepted, Outcome, Rejected, bind_outcome }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.node { Edge, Symbol, symbol_eq, symbol_lexeme, core_edge_target_lookup, AdmitCallersEdge, CoreMarker, ProductionEdge, TypeNode, ComputationNode, Connective, Atom, Conj, Disj, Arrow, Cardinality, Instantiation, Behavior, Value, Transform, Branch, Loop, Bind, Match }
import v2.compiler.namespace_graft { namespace_graft_module_body_optional }
import std.process { ProcessExit, exit_failure }
import v2.std.text { String }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn aca_normalized(text: String) -> Outcome<NormalizedTree> {
  match dag_prepared_grammar() {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: prepared, diagnostics: residue } =>
      bind_outcome(
        o: tokenize(text: text, file: ^aca_fixture, rules: dag_lex()),
        f: fn(token_stream) {
          program_assembly_normalized_outcome(
            phase: program_assembly_phase_normalize_seeded(
              parsed: parse_module_prepared(tokens: token_stream, prepared: prepared, validation_residue: residue),
              seed: OccurrenceIdAllocator { next_id: 10 },
              scope: Fnv1a64Structural { digest: "00000000000000ad" }
            )
          )
        }
      )
  }
}

fn aca_resolved(text: String) -> Outcome<ResolvedTree> {
  match aca_normalized(text: text) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: t, diagnostics: _ } =>
      match admit_normalized_tree(root: t.root, test_markers: t.test_markers, import_bindings: t.import_bindings, type_declaration_kinds: t.type_declaration_kinds, type_declaration_modifiers: no_type_declaration_modifiers(), diagnostics: None) {
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
        Accepted { value: tree, diagnostics: _ } => resolve(tree: tree, lm: dag_language_model())
      }
  }
}

fn aca_inferred(text: String) -> Outcome<ObligatedInferredTree> {
  match aca_resolved(text: text) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: rt, diagnostics: _ } => infer(tree: rt)
  }
}

// THE CROSS-MODULE PIPELINE: the subject module (whose calls the wall walks) plus peer modules it
// imports. Admission carries no import-level bindings -- the subject's own `import` lines are what
// bind the peers' names -- the same shape body_let_annotation_test drives for imported types.
data aca_subject_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^aca_subject_artifact,
  file_path: "src/v2/pilot/caller_admission_subject.dag"
}

data aca_peer_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^aca_peer_artifact,
  file_path: "src/v2/pilot/caller_admission_peer.dag"
}

fn aca_source(src: String, artifact: Artifact, cu: Symbol) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: src, fidelity: Lossless },
    artifact: artifact,
    compilation_unit: cu,
    source_root: V2Tree
  }
}

fn aca_assembled_with_peer(subject_src: String, peer_src: String) -> Outcome<ResolvedTree> {
  assemble_program_from_ingest(
    ingest: Cons {
      head: aca_source(src: subject_src, artifact: aca_subject_artifact, cu: ^caller_admission_subject_cu),
      tail: [
        aca_source(src: peer_src, artifact: aca_peer_artifact, cu: ^caller_admission_peer_cu)
      ]
    },
    admission: Admission { subject: ResolutionSubject { name: Cons { head: ^bcb, tail: Empty } }, imports: Empty },
    lm: dag_language_model()
  )
}

fn aca_cross_inferred(subject_src: String, peer_src: String) -> Outcome<ObligatedInferredTree> {
  match aca_assembled_with_peer(subject_src: subject_src, peer_src: peer_src) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: rt, diagnostics: _ } => infer(tree: rt)
  }
}

// THE SINGLE-MODULE ROUTE. The same assembled-program pipeline as the cross-module fixtures —
// one ingest source, no imports — so every fixture's sealed fn rides the real body lowering
// (the carrier edge) and infer grounds the same way. An earlier spelling drove the normalized
// tree through admit_normalized_tree and resolve directly; the clause property survived raw in
// that image and infer refused the whole fixture on its ungrounded decl_ref call before the wall
// ever fired.
fn aca_assembled_single(src: String, subject_dotted: String) -> Outcome<ResolvedTree> {
  assemble_program_from_ingest(
    ingest: Cons {
      head: aca_source(src: src, artifact: aca_subject_artifact, cu: ^caller_admission_subject_cu),
      tail: []
    },
    admission: Admission {
      subject: ResolutionSubject { name: qualified_name_from_dotted_string(dotted: subject_dotted) },
      imports: Empty
    },
    lm: dag_language_model()
  )
}

fn aca_assembled_inferred_single(src: String, subject_dotted: String) -> Outcome<ObligatedInferredTree> {
  match aca_assembled_single(src: src, subject_dotted: subject_dotted) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: rt, diagnostics: _ } => infer(tree: rt)
  }
}

// THE RED: the module compiles clean to resolve, and infer refuses it on the call from
// outside_caller, which the list does not name.
fn aca_outside_caller_text() -> String {
  "module aca.t\n\nfn sealed_mint(n: Int) -> Int\n  admit_callers: [decl_ref(module_path: \"aca.t\", decl_name: \"listed_caller\")]\n  = n + 1\n\nfn listed_caller(n: Int) -> Int = sealed_mint(n: n)\n\nfn outside_caller(n: Int) -> Int = sealed_mint(n: n)\n"
}

// THE CONTROL: the same sealed fn, called only from the listed declaration. The wall admits it,
// and everything downstream of the wall is unchanged.
fn aca_listed_caller_text() -> String {
  "module aca.c\n\nfn sealed_mint(n: Int) -> Int\n  admit_callers: [decl_ref(module_path: \"aca.c\", decl_name: \"listed_caller\")]\n  = n + 1\n\nfn listed_caller(n: Int) -> Int = sealed_mint(n: n)\n"
}

// THE ENTRY-SHAPE RED: a bare-name entry parses (the clause admits any expression, as the
// trailing-comma claim records) and the wall refuses it at the entry, as v1 refuses an entry it
// cannot read as a decl_ref call.
fn aca_bare_entry_text() -> String {
  "module aca.u\n\nfn sealed_mint(n: Int) -> Int\n  admit_callers: [listed_caller]\n  = n + 1\n\nfn listed_caller(n: Int) -> Int = sealed_mint(n: n)\n"
}

// THE CROSS-MODULE PEER: the sealed fn in module aca, naming its one permitted caller by the
// caller's OWN module path and declaration name.
fn aca_cross_peer_text() -> String {
  "module aca\n\nfn sealed_mint(n: Int) -> Int\n  admit_callers: [decl_ref(module_path: \"bcb\", decl_name: \"listed_caller\")]\n  = n + 1\n"
}

// THE CROSS-MODULE RED: the subject module imports the sealed fn and calls it from a declaration
// the peer's list does not name. The refusal must reach across the import: the judge reads the
// callee's declared Arrow through the call's facts entry, so the edge the peer's body_lowering
// carried survives into the subject module's judgment.
fn aca_cross_red_subject_text() -> String {
  "module bcb\n\nimport aca { sealed_mint }\n\nfn unlisted_caller(n: Int) -> Int = sealed_mint(n: n)\n"
}

// THE CROSS-MODULE CONTROL: the same import, called from the listed declaration in the subject
// module. Admitted -- the roster spans modules exactly as v1's did.
fn aca_cross_control_subject_text() -> String {
  "module bcb\n\nimport aca { sealed_mint }\n\nfn listed_caller(n: Int) -> Int = sealed_mint(n: n)\n"
}

fn aca_outside_inferred() -> Outcome<ObligatedInferredTree> {
  aca_assembled_inferred_single(src: aca_outside_caller_text(), subject_dotted: "aca.t")
}

fn aca_listed_inferred() -> Outcome<ObligatedInferredTree> {
  aca_assembled_inferred_single(src: aca_listed_caller_text(), subject_dotted: "aca.c")
}

fn aca_bare_entry_inferred() -> Outcome<ObligatedInferredTree> {
  aca_assembled_inferred_single(src: aca_bare_entry_text(), subject_dotted: "aca.u")
}

fn aca_cross_red_inferred() -> Outcome<ObligatedInferredTree> {
  aca_cross_inferred(subject_src: aca_cross_red_subject_text(), peer_src: aca_cross_peer_text())
}

fn aca_cross_control_inferred() -> Outcome<ObligatedInferredTree> {
  aca_cross_inferred(subject_src: aca_cross_control_subject_text(), peer_src: aca_cross_peer_text())
}

fn aca_rejected_with(r: Outcome<ObligatedInferredTree>, reason: Symbol) -> Bool {
  match r {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: ned } => symbol_eq(a: ned.head.reason, b: reason)
  }
}

fn aca_accepted_clean(r: Outcome<ObligatedInferredTree>) -> Bool {
  match r {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn the_native_wall_refuses_a_call_from_outside_the_list_holds() -> Bool {
  aca_rejected_with(r: aca_outside_inferred(), reason: ^infer_reason_caller_admission_refused)
}

test fn the_native_wall_admits_a_call_from_the_listed_caller_holds() -> Bool {
  aca_accepted_clean(r: aca_listed_inferred())
}

test fn the_native_wall_refuses_an_entry_that_is_not_a_decl_ref_call_holds() -> Bool {
  aca_rejected_with(r: aca_bare_entry_inferred(), reason: ^infer_reason_admit_callers_entry_not_decl_ref)
}

test fn the_native_wall_refuses_a_cross_module_call_from_outside_the_list_holds() -> Bool {
  aca_rejected_with(r: aca_cross_red_inferred(), reason: ^infer_reason_caller_admission_refused)
}

test fn the_native_wall_admits_a_cross_module_call_from_the_listed_caller_holds() -> Bool {
  aca_accepted_clean(r: aca_cross_control_inferred())
}

// DBG-PROBE (temporary): identity chain of the clause shell's captured child.
fn dbg_clause_reader_verdict() -> ProcessExit {
  match aca_normalized(text: aca_cross_peer_text()) {
    Rejected { diagnostics: _ } => exit_failure(reason: "normalize-refused")
    Accepted { value: t, diagnostics: _ } =>
      match body_lower_find_production_shell_optional(root: t.root, emitted: ^dag_surface_admit_callers_clause) {
        Absent => exit_failure(reason: "clause-not-found-under-root")
        Present { value: clause } =>
          match find_named_child(root: clause, name: ^grammar_production_captured_node_projection) {
            Rejected { diagnostics: _ } => exit_failure(reason: "clause-captured-missing")
            Accepted { value: cap2, diagnostics: _ } =>
              match parse_production_emitted_identity_optional(node: cap2) {
                Present { value: id } => exit_failure(reason: symbol_lexeme(sym: id))
                Absent =>
                  match parse_production_captured_child_optional(node: cap2) {
                    Present { value: inner } =>
                      match parse_production_emitted_identity_optional(node: inner) {
                        Present { value: id2 } => exit_failure(reason: symbol_lexeme(sym: id2))
                        Absent => exit_failure(reason: "cap2-plain-inner-plain")
                      }
                    Absent => exit_failure(reason: "cap2-plain-no-inner")
                  }
              }
          }
      }
  }
}

// DBG-PROBE (temporary): first refusal reason of the cross-control fixture, after the reader fix.
fn dbg_clause_first_child() -> ProcessExit {
  match aca_cross_control_inferred() {
    Accepted { value: _, diagnostics: _ } => exit_failure(reason: "inferred-ok")
    Rejected { diagnostics: ned } => exit_failure(reason: symbol_lexeme(sym: ned.head.reason))
  }
}

// DBG-PROBE (temporary): first refusal reason of the cross-red fixture.
fn dbg_cross_red_reason() -> ProcessExit {
  match aca_cross_red_inferred() {
    Accepted { value: _, diagnostics: _ } => exit_failure(reason: "inferred-ok")
    Rejected { diagnostics: ned } => exit_failure(reason: symbol_lexeme(sym: ned.head.reason))
  }
}

// DBG-PROBE (temporary): the peer assembled as its own subject, so the sealed fn's clause is
// walkable from the root.
fn dbg_peer_assembled() -> Outcome<ResolvedTree> {
  assemble_program_from_ingest(
    ingest: Cons {
      head: aca_source(src: aca_cross_peer_text(), artifact: aca_peer_artifact, cu: ^caller_admission_peer_cu),
      tail: []
    },
    admission: Admission { subject: ResolutionSubject { name: Cons { head: ^aca, tail: Empty } }, imports: Empty },
    lm: dag_language_model()
  )
}

// DBG-PROBE (temporary): the assembled single-module red fixture's failing node, richly.
fn dbg_same_listed_locus() -> ProcessExit {
  match aca_outside_inferred() {
    Accepted { value: _, diagnostics: _ } => exit_failure(reason: "inferred-ok")
    Rejected { diagnostics: ned } =>
      match ned.head.at {
        NodeLocus { anchor: a } =>
          match parse_production_emitted_identity_optional(node: a.at) {
            Present { value: id } => exit_failure(reason: symbol_lexeme(sym: id))
            Absent => exit_failure(reason: concat("P=", dbg_anat_label(n: a.at), " kids:", dbg_anat_edges(n: a.at)))
          }
        Textual { file: f, extent: _ } => exit_failure(reason: symbol_lexeme(sym: f))
        SourcePortLocus { anchor: _, file: f, extent: _ } => exit_failure(reason: symbol_lexeme(sym: f))
        InvariantPortLocus { anchor: _, invariant: s } => exit_failure(reason: symbol_lexeme(sym: s))
        DeclarationLocus { declaration: _ } => exit_failure(reason: "decl-locus")
      }
  }
}

// DBG-PROBE (temporary): faithful anatomy of the entry node — kind marker + edge descriptors.
fn dbg_anat_label(n: Node) -> String {
  match n.kind {
    TypeNode { connective: Atom { identity: id } } => concat("atom:", symbol_lexeme(sym: id))
    TypeNode { connective: Conj } => "conj"
    TypeNode { connective: Disj } => "disj"
    TypeNode { connective: Arrow } => "arrow"
    TypeNode { connective: Cardinality } => "card"
    TypeNode { connective: Instantiation } => "inst"
    ComputationNode { behavior: Value } => "comp:value"
    ComputationNode { behavior: Transform } => "comp:transform"
    ComputationNode { behavior: Branch } => "comp:branch"
    ComputationNode { behavior: Loop } => "comp:loop"
    ComputationNode { behavior: Bind } => "comp:bind"
    ComputationNode { behavior: Match } => "comp:match"
  }
}

fn dbg_anat_edge_desc(e: Edge) -> String {
  match e.label {
    Authored { name: sym } => concat("@", symbol_lexeme(sym: sym), ":", dbg_anat_label(n: e.target))
    StructuralLabel { label: CoreMarker { marker: _ } } => concat("core:", dbg_anat_label(n: e.target))
    StructuralLabel { label: ProductionEdge { language: _, edge: _ } } => concat("prod:", dbg_anat_label(n: e.target))
    Positional => concat("*:", dbg_anat_label(n: e.target))
  }
}

fn dbg_anat_edges(n: Node) -> String {
  concat(fold(xs: n.children, init: "", f: fn(acc, e) { concat(acc, " ", dbg_anat_edge_desc(e: e)) }), " ]")
}

// DBG-PROBE (temporary): dump the captured sequence's right-spine, four levels, each level's full
// edge list, to pin the reader's positional contract against the runtime tree.
fn dbg_anat_edge_label(e: Edge) -> String {
  match e.label {
    Authored { name: sym } => concat("@", symbol_lexeme(sym: sym))
    StructuralLabel { label: CoreMarker { marker: _ } } => "core"
    StructuralLabel { label: ProductionEdge { language: _, edge: _ } } => "prod"
    Positional => "*"
  }
}

fn dbg_anat_deep(n: Node, depth: Int) -> String {
  if depth == 0 {
    dbg_anat_label(n: n)
  } else {
    concat(
      dbg_anat_label(n: n),
      "[",
      fold(xs: n.children, init: "", f: fn(acc, e) { concat(acc, " ", dbg_anat_edge_label(e: e), "=", dbg_anat_deep(n: e.target, depth: depth - 1)) }),
      "]"
    )
  }
}

fn dbg_spine_level(n: Node, name: String) -> String {
  concat(name, "=", dbg_anat_label(n: n), "[", dbg_anat_edges(n: n), "]")
}

fn dbg_peer_entry_shape() -> ProcessExit {
  match dbg_peer_assembled() {
    Rejected { diagnostics: _ } => exit_failure(reason: "assemble-refused")
    Accepted { value: rt, diagnostics: _ } =>
      match namespace_graft_module_body_optional(root: rt.root) {
        Absent => exit_failure(reason: "no-body-under-root")
        Present { value: body } =>
          match find_named_child(root: body, name: ^sealed_mint) {
            Rejected { diagnostics: _ } => exit_failure(reason: "no-sealed-mint-in-body")
            Accepted { value: arrow, diagnostics: _ } =>
              match core_edge_target_lookup(children: arrow.children, marker: AdmitCallersEdge) {
                Absent => exit_failure(reason: "no-carrier-edge")
                Ambiguous => exit_failure(reason: "carrier-edge-ambiguous")
                Found { target: clause } =>
                  match parse_production_captured_child_optional(node: clause) {
                    Absent => exit_failure(reason: "clause-no-captured")
                    Present { value: c } =>
                      match find_named_child(root: c, name: ^grammar_sequence_right_node_projection) {
                        Rejected { diagnostics: _ } =>
                          exit_failure(reason: concat("C0:", dbg_spine_level(n: c, name: "C"), " no-right"))
                        Accepted { value: a, diagnostics: _ } =>
                          match find_named_child(root: a, name: ^grammar_sequence_right_node_projection) {
                            Rejected { diagnostics: _ } =>
                              exit_failure(reason: concat(dbg_spine_level(n: c, name: "C"), " | ", dbg_spine_level(n: a, name: "A"), " no-A-right"))
                            Accepted { value: b, diagnostics: _ } =>
                              match find_named_child(root: b, name: ^grammar_sequence_right_node_projection) {
                                Rejected { diagnostics: _ } =>
                                  exit_failure(reason: concat(dbg_spine_level(n: c, name: "C"), " | ", dbg_spine_level(n: a, name: "A"), " | ", dbg_spine_level(n: b, name: "B"), " no-B-right"))
                                Accepted { value: d, diagnostics: _ } =>
                                  match find_named_child(root: d, name: ^grammar_sequence_left_node_projection) {
                                    Rejected { diagnostics: _ } =>
                                      exit_failure(reason: concat(dbg_spine_level(n: c, name: "C"), " | ", dbg_spine_level(n: d, name: "D"), " no-D-left"))
                                    Accepted { value: entry1, diagnostics: _ } =>
                                      match sugar_sequence_pair_optional(node: body_lower_deep_unwrap_optional(node: entry1)) {
                                        Absent => exit_failure(reason: "entry1-no-pair")
                                        Present { value: entry_pair } =>
                                          exit_failure(reason: concat("CHAIN=", dbg_anat_deep(n: body_lower_deep_unwrap_optional(node: entry_pair.left), depth: 8)))
                                      }
                                  }
                              }
                          }
                      }
                  }
              }
          }
      }
  }
}

// DBG-PROBE (temporary): one marker per argument.
fn dbg_anat_args(args: List<WherePredicateArgument>) -> String {
  match args {
    Empty => "args:[]"
    Cons { head: h, tail: t } =>
      match h {
        WhereArgumentLabelled { label: l, value: v } =>
          concat("@", symbol_lexeme(sym: l), "=", dbg_anat_deep(n: v, depth: 2), " ", dbg_anat_args(args: t))
        WhereArgumentPositional { value: v } =>
          concat("pos=", dbg_anat_deep(n: v, depth: 2), " ", dbg_anat_args(args: t))
      }
  }
}

// DBG-PROBE (temporary): first refusal reason of the same-module outside-caller red.
fn dbg_same_outside_reason() -> ProcessExit {
  match aca_outside_inferred() {
    Accepted { value: _, diagnostics: _ } => exit_failure(reason: "inferred-ok")
    Rejected { diagnostics: ned } => exit_failure(reason: symbol_lexeme(sym: ned.head.reason))
  }
}
