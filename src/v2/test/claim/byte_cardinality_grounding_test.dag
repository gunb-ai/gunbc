module v2.test.claim.byte_cardinality_grounding


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

type Byte = Refined<List<Int>>

fn byte_from_bits(bits: List<Int>, at: v2.std.diagnostic.Locus) -> v2.std.diagnostic.Outcome<Byte> {
  refine(
    base: bits,
    by: v2.std.refinement.Validation {
      reason: ^byte_must_be_8_bits,
      admits: fn(items) { length(xs: items) == 8 }
    },
    at: at
  )
}

fn byte_locus() -> v2.std.diagnostic.Locus { port_locus(port: ^byte_cardinality_grounding) }

fn eight_bits() -> List<Int> { [1, 0, 1, 0, 1, 0, 1, 0] }
fn seven_bits() -> List<Int> { [1, 0, 1, 0, 1, 0, 1] }

fn is_accepted(o: v2.std.diagnostic.Outcome<Byte>) -> Bool {
  match o {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}
fn is_rejected(o: v2.std.diagnostic.Outcome<Byte>) -> Bool {
  match o {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
  }
}

test fn byte_grounding_accepts_8_bits() -> Bool {
  is_accepted(o: byte_from_bits(bits: eight_bits(), at: byte_locus()))
}

test fn byte_grounding_rejects_7_bits() -> Bool {
  is_rejected(o: byte_from_bits(bits: seven_bits(), at: byte_locus()))
}
