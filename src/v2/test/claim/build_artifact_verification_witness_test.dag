module v2.test.claim.build_artifact_verification_witness

import std.logic { Bool }
import extdeps.languages.bash.program {
  ShellStmt, ShellWord, ShellProgram,
  If, Command, Concat, VarRef, Lit,
  lit, var_ref, serialize_bash
}
import v2.workflow.bash_program_emit { bash_program_serialize, bash_program_serialize_stmt }
import v2.workflow.build_step_emit { verifications_script }
import tools.build_step { BuildArtifact, emit_verifications }
import gunbc.ci_spec { ci_floor_build_verify_script }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn probe_artifact() -> BuildArtifact {
  BuildArtifact {
    path: Concat { parts: [var_ref(name: "ROOT"), lit(text: "/target/release/probe_bin")] },
    name: "probe_bin"
  }
}

fn probe_stmts() -> List<ShellStmt> {
  emit_verifications(produces: [probe_artifact()])
}

fn stmt_text(s: ShellStmt) -> Bool {
  match bash_program_serialize_stmt(stmt: s) {
    Accepted { value: text, diagnostics: _ } =>
      string_contains(s: text, pattern: "-x")
        && !string_contains(s: text, pattern: "-newer")
    Rejected { diagnostics: _ } => false
  }
}

fn is_if(s: ShellStmt) -> Bool {
  match s {
    If { cond: c, then: t } => true
    _ => false
  }
}

fn witness_single_artifact_produces_two_checks() -> Bool {
  let stmts = probe_stmts()
  stmts.length() == 2 && is_if(s: stmts.first())
}

fn witness_existence_check_no_mtime() -> Bool {
  stmt_text(s: probe_stmts().first())
}

fn witness_serialized_conjuncts_and_teeth() -> Bool {
  match verifications_script(produces: [probe_artifact()]) {
    Accepted { value: script, diagnostics: _ } =>
      string_contains(s: script, pattern: "-x")
        && string_contains(s: script, pattern: "-s")
        && !string_contains(s: script, pattern: "-newer")
        && string_contains(s: script, pattern: "/target/release/probe_bin")
        && string_contains(s: script, pattern: "exit 1")
    Rejected { diagnostics: _ } => false
  }
}

fn witness_verifications_script_byte_identical_to_serialize_bash() -> Bool {
  let probe = [probe_artifact()]
  let v1 = serialize_bash(p: ShellProgram {
    set_e: false,
    statements: emit_verifications(produces: probe)
  })
  match verifications_script(produces: probe) {
    Accepted { value: v2, diagnostics: _ } => v2 == v1
    Rejected { diagnostics: _ } => false
  }
}

fn witness_floor_covers_both_release_bins() -> Bool {
  let script = ci_floor_build_verify_script()
  string_contains(s: script, pattern: "--verify-build-artifacts")
    && string_contains(s: script, pattern: "/target/release/claim_executor")
    && string_contains(s: script, pattern: "/target/release/gunbc")
    && !string_contains(s: script, pattern: "-newer")
}

test fn build_artifact_verification_holds() -> Bool {
  witness_verifications_script_byte_identical_to_serialize_bash()
    && witness_single_artifact_produces_two_checks()
    && witness_existence_check_no_mtime()
    && witness_serialized_conjuncts_and_teeth()
    && witness_floor_covers_both_release_bins()
}
