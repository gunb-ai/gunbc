// ── THE TWO AUTHORITIES FOR "WHAT DOES THIS CRATE DEPEND ON", AND WHY THE BOUND IS AN EQUALITY ──
//
// stage0's edges were once authored rather than derived, and the re-export rows still are. The size
// of any gap between them is DERIVED by stage0_reexport_derivation_disagreements rather than transcribed into
// prose (gunbc.design_argument::how_to_work), and this pins its population at IDENTITY grain rather than by count: a count
// equality would stay green if one unit were repaired while another began to diverge.
//
// EQUALITY AGAINST THE LEDGER, IN BOTH DIRECTIONS, plus the repaired roster. A one-way subset --
// which this claim used to be -- catches a NEW divergence and nothing else: once
// v1-stage0-v1-artifact is repaired the derived set empties, the subset still holds, and the ledger
// keeps naming a unit that no longer diverges. A stale entry then silently re-admits that unit to
// diverge again with this claim green, which is the regression gunbc.design_argument::guarantee_ladder (no silent regression) forbids.
//
// The objection to equality does not apply, because this is equality against the LEDGER rather than
// against the derived set: it cannot stop a lane over debt the ledger already declares, and it reds
// in exactly one situation -- the ledger disagreeing with reality.
//
// Three arms, each with its own red. no_new_divergence: a unit outside the ledger started
// diverging. no_stale_ledger_entry: a ledger unit stopped diverging and nobody recorded it, which
// is what forces the removal edit and its typed disposition (gunbc.design_argument::fail_closed). And
// no_repaired_divergence_returned: something recorded as repaired came back -- the gunbc.design_argument::guarantee_ladder (dissolution on climb) regression
// control, which keeps the climb real rather than retiring with it.
test fn stage0_reexport_derivation_disagreements_are_bounded_to_the_known_unit() -> Bool {
  match stage0_reexport_derivation_disagreements() {
    Stage0ReexportDisagreementsUnavailable { cause: _ } => false
    Stage0ReexportDisagreementsDerived { packages: packages } => {
      let no_new_divergence = packages |> fold(init: true, f: fn(ok, pkg) {
        ok && (stage0_reexport_derivation_known_divergent_packages |> any(known => known == pkg))
      })
      let no_stale_ledger_entry = stage0_reexport_derivation_known_divergent_packages
        |> fold(init: true, f: fn(ok, known) {
          ok && (packages |> any(pkg => pkg == known))
        })
      let no_repaired_divergence_returned = stage0_reexport_derivation_repaired_divergences
        |> fold(init: true, f: fn(ok, repaired) {
          ok && !(packages |> any(pkg => pkg == repaired.package_name))
        })
      no_new_divergence && no_stale_ledger_entry && no_repaired_divergence_returned
    }
  }
}

// THE VACUOUS-GREEN GUARD, and it is the claim that keeps the one above honest. Subset-of-known-bad
// is green when the disagreement set is EMPTY and equally green when the detector is BROKEN and
// finds nothing -- the same observation from two different worlds. v1-stage0-v1-artifact used to
// inhabit the set and mask that; the set emptied when the edge list was derived, and the mask went
// with it, leaving a permanently green assertion with no evidence it can still see anything, which
// is the inert lens gunbc.design_argument::fail_closed names. So the detector is run over SUPPLIED units and rows
// carrying a PLANTED disagreement: "probe-diverging" authors a dependency the unit graph does not
// give it, "probe-agreeing" authors exactly what it derives. Removing the comparison from
// reexport_derivation_disagreements_over reds this and leaves the OTHER two claims untouched.
fn probe_edge(from: String, to: String) -> UnitDepEdge {
  UnitDepEdge { from: from as CompilationUnitId, to: to as CompilationUnitId }
}

fn probe_row(package: String, unit: String, reexports: List<String>) -> Stage0PartitionCrateRow {
  Stage0PartitionCrateRow {
    unit_id: unit as CompilationUnitId,
    package_name: package,
    crate_dir: "src/probe",
    kind: Stage0LayeredCoreCrate,
    modules: [],
    reexport_packages: reexports,
    carries_non_empty_wrappers: false,
  }
}

test fn the_disagreement_detector_finds_a_planted_divergence() -> Bool {
  let edges = [probe_edge(from: "u-agree", to: "u-base")]
  let rows = [
    probe_row(package: "probe-base", unit: "u-base", reexports: []),
    probe_row(package: "probe-agreeing", unit: "u-agree", reexports: ["probe-base"]),
    probe_row(package: "probe-diverging", unit: "u-diverge", reexports: ["probe-base"]),
  ]
  match reexport_derivation_disagreements_over(edges: edges, rows: rows) {
    ReexportDisagreementScanUnitHasNoRow { unit_id: _ } => false
    ReexportDisagreementScanOk { packages: found } =>
      (found |> any(p => p == "probe-diverging"))
        && !(found |> any(p => p == "probe-agreeing"))
        && !(found |> any(p => p == "probe-base"))
  }
}

// THE DISCRIMINATOR FOR THE FALSE GREEN, and it is the input the detector used to certify.
// A FOUNDATION row authors reexport_packages: [] and has a derived edge to a unit that NO package
// row covers. The old fold dropped that edge, leaving derived [] against authored [], and reported
// AGREEMENT from a projection it could not complete -- the exact shape this declaration exists to
// make impossible, reached through the arm rather than through the comparison.
//
// It must REFUSE. Restoring `Absent => acc` inside derived_dep_packages reds this claim and leaves
// the planted-divergence guard above green, because that fixture pairs every edge destination with
// a row and so never reaches the arm -- which is why this case needed its own claim rather than a
// wider fixture.
test fn a_dep_edge_to_a_unit_with_no_package_row_refuses() -> Bool {
  let edges = [probe_edge(from: "u-foundation", to: "u-unrostered")]
  let rows = [probe_row(package: "probe-foundation", unit: "u-foundation", reexports: [])]
  match reexport_derivation_disagreements_over(edges: edges, rows: rows) {
    ReexportDisagreementScanUnitHasNoRow { unit_id: unit_id } => (unit_id as String) == "u-unrostered"
    ReexportDisagreementScanOk { packages: _ } => false
  }
}
// The debt row's trigger has now been repointed twice, and BOTH previous targets named an
// authority that could not carry the fact -- a roster row and then a module-to-location index.
// This pins the current one: the dissolve target must name the module ACQUIRER, whose per-module
// contents are the capability, and not a carrier that merely sits near it. Repointing it back at
// ModuleStorageIndex, or at any other declaration, reds this claim -- which is the whole point,
// because nothing else in the corpus re-reads a dissolve target once it is written.
test fn witness_interface_grounding_target_names_the_module_acquirer_holds() -> Bool {
  let target = stage0_module_interface_grounding_target()
  ((target.module_path as String) == "v2.compiler.module_acquisition")
    && ((target.decl_name as String) == "acquire_closure_of")
}

// A DECLARATION REF NAMES A DECLARATION AND NOTHING ELSE, so the claim above pins only the supply.
// gunbc.design_argument::guarantee_ladder (no silent regression) wants the trigger to name the CAPABILITY and what the artifact must be SUFFICIENT
// FOR. Both debt carriers must hold the same typed capability: the acquirer as the contents supply,
// and the emitted-closure derivation as the population. Pointing either at another declaration, or
// letting the two maps disagree, reds this claim.
//
// STATED AT ITS STRENGTH: this pins which declarations the trigger names. It does NOT evaluate
// whether the supply carries declaration contents -- no program can yet, which is the debt.
test fn witness_interface_grounding_trigger_states_both_capability_halves_holds() -> Bool {
  match stage0_module_dag_interface_grounding() {
    Stage0ModuleDagInterfaceSourceGrounded => false
    Stage0ModuleDagInterfaceUngrounded { exports_map: exports_map, type_definitions_map: type_definitions_map } =>
      interface_grounding_capability_is_the_declared_one(capability: exports_map.capability)
        && interface_grounding_capability_is_the_declared_one(capability: type_definitions_map.capability)
  }
}

fn interface_grounding_capability_is_the_declared_one(capability: InterfaceGroundingCapability) -> Bool {
  ((capability.contents_supply.module_path as String) == "v2.compiler.module_acquisition")
    && ((capability.contents_supply.decl_name as String) == "acquire_closure_of")
    && ((capability.population.module_path as String) == "v2.workflow.rust_crate_partition")
    && ((capability.population.decl_name as String) == "module_dag_from_dependency_facts")
}



// ── THE STAGE0 SOURCE EDGES ARE DERIVED ────────────────────────────────────────────────────
//
// POSITIVE CONTROL, ON THE LIVE TREE, ASSERTING THE ROUTE. v1_compiler_languages importing
// extdeps.languages.dag.emit is an edge the old hand list never carried, and its absence was what
// made v1-stage0-v1-artifact derive only the runtime as a dependency. It is present here only if the
// DAG is read from the dependency facts: re-authoring a hand list without it reds this claim.
test fn stage0_source_edges_are_read_from_the_dependency_facts() -> Bool {
  match stage0_partition_derivation {
    Stage0PartitionDerivationRefused { cause: _ } => false
    Stage0PartitionDerived { module_dag: source, placements: _ } =>
      source.edges |> any(edge =>
        (edge.from as String) == "v1_compiler_languages" && (edge.to as String) == "extdeps_languages_dag_emit")
  }
}

// THE DERIVATION OVER SUPPLIED FACTS, so each arm is reached by an input built to reach it. The
// fixture's modules sit under `w`; the policy floors the whole namespace at u-a and raises w.high and
// w.y to u-b, over the unit order u-rt < u-a < u-b. These claims supply the facts at the derivation's
// interface; the live-tree claims above and below are the inhabitance claims that the real fact
// producers reach it.
fn witness_decl(module_name: String, path: String) -> ModuleDeclarationFact {
  ModuleDeclarationFact { module: module_name, path: path }
}

fn witness_source_decls() -> List<ModuleDeclarationFact> {
  [
    witness_decl(module_name: "w.root", path: "f/root.dag"),
    witness_decl(module_name: "w.low", path: "f/low.dag"),
    witness_decl(module_name: "w.high", path: "f/high.dag"),
    witness_decl(module_name: "w.stray", path: "f/stray.dag"),
    witness_decl(module_name: "w.x", path: "f/x.dag"),
    witness_decl(module_name: "w.y", path: "f/y.dag"),
  ]
}

fn witness_source_dep(path: String, target: String, declared: Bool) -> ModuleDependencyEdge {
  ModuleDependencyEdge { path: path, target_module: target, target_declared: declared }
}

fn witness_floors() -> List<Stage0UnitFloor> {
  [
    Stage0UnitFloor { prefix: "w", unit_id: "u-a" as CompilationUnitId },
    Stage0UnitFloor { prefix: "w.high", unit_id: "u-b" as CompilationUnitId },
    Stage0UnitFloor { prefix: "w.y", unit_id: "u-b" as CompilationUnitId },
  ]
}

fn witness_order() -> List<CompilationUnitId> {
  ["u-rt" as CompilationUnitId, "u-a" as CompilationUnitId, "u-b" as CompilationUnitId]
}

// The base tree's facts: w.root imports w.low (an import and a reference, so twice) and names
// itself; w.stray is reached by no root and depends on a module nobody declares.
fn witness_base_deps() -> List<ModuleDependencyEdge> {
  [
    witness_source_dep(path: "f/root.dag", target: "w.low", declared: true),
    witness_source_dep(path: "f/root.dag", target: "w.low", declared: true),
    witness_source_dep(path: "f/root.dag", target: "w.root", declared: true),
    witness_source_dep(path: "f/stray.dag", target: "not.declared", declared: false),
  ]
}

fn witness_derive(roots: List<String>, deps: List<ModuleDependencyEdge>) -> Stage0PartitionDerivation {
  stage0_partition_derivation_over(
    roots: roots,
    floors: witness_floors(),
    order: witness_order(),
    declarations: witness_source_decls(),
    dependencies: deps
  )
}

fn witness_unit_of(placements: List<Stage0Placement>, basename: String) -> String {
  placements |> fold(init: "unplaced", f: fn(acc, placement) {
    if placement.basename == basename { placement.unit_id as String } else { acc }
  })
}

// The placements' basenames, IN ORDER: == on a list is not part of the dialect, so position i of
// each is compared through a fold that carries the index.
type WitnessOrderScan {
  index: Int
  ok: Bool
}

fn witness_nth_basename(placements: List<Stage0Placement>, wanted: Int) -> String {
  let found = placements |> fold(init: WitnessNthScan { index: 0, value: "" }, f: fn(acc, p) {
    if acc.index == wanted { WitnessNthScan { index: acc.index + 1, value: p.basename } } else { WitnessNthScan { index: acc.index + 1, value: acc.value } }
  })
  found.value
}

type WitnessNthScan {
  index: Int
  value: String
}

fn witness_basenames_are(placements: List<Stage0Placement>, expected: List<String>) -> Bool {
  let scan = expected |> fold(init: WitnessOrderScan { index: 0, ok: true }, f: fn(acc, name) {
    WitnessOrderScan { index: acc.index + 1, ok: acc.ok && witness_nth_basename(placements: placements, wanted: acc.index) == name }
  })
  (count(placements) == count(expected)) && scan.ok
}

// THE ROSTER IS THE ROOTS' CLOSURE PLUS THE RUNTIME, AND EACH DEPENDENCY IS ONE EDGE. w.stray is
// declared and unresolvable, and the derivation never inspects it, because no root reaches it: an
// unrelated broken module leaves the partition alone. The runtime is placed in the first unit, and
// the placements come back in basename order, the order the crate rows list their modules in.
test fn stage0_source_derivation_records_each_dependency_once() -> Bool {
  match witness_derive(roots: ["w.root"], deps: witness_base_deps()) {
    Stage0PartitionDerivationRefused { cause: _ } => false
    Stage0PartitionDerived { module_dag: dag, placements: placements } =>
      witness_basenames_are(placements: placements, expected: [rust_runtime_prelude_module, "w_low", "w_root"])
        && witness_unit_of(placements: placements, basename: rust_runtime_prelude_module) == "u-rt"
        && witness_unit_of(placements: placements, basename: "w_low") == "u-a"
        && witness_unit_of(placements: placements, basename: "w_root") == "u-a"
        && (dag.edges |> count) == 1
        && dag.edges |> all(edge => (edge.from as String) == "w_root" && (edge.to as String) == "w_low")
  }
}

// ONE ADDED IMPORT, AND NO LIST EDITED. w.root now imports w.high, which the partition did not
// hold: w.high joins at its own floor (u-b), and w.root, which depends on it, is raised to u-b with
// it, because a crate:: path resolves only into a unit the importer's unit re-exports. w.low, which
// the import does not touch, keeps u-a. A roster or a placement that ignored the facts would leave
// w.high unplaced and w.root at u-a.
test fn one_added_import_brings_a_module_in_and_raises_its_importer() -> Bool {
  let deps = witness_base_deps() |> list_push(witness_source_dep(path: "f/root.dag", target: "w.high", declared: true))
  match witness_derive(roots: ["w.root"], deps: deps) {
    Stage0PartitionDerivationRefused { cause: _ } => false
    Stage0PartitionDerived { module_dag: _, placements: placements } =>
      witness_unit_of(placements: placements, basename: "w_high") == "u-b"
        && witness_unit_of(placements: placements, basename: "w_root") == "u-b"
        && witness_unit_of(placements: placements, basename: "w_low") == "u-a"
  }
}

// REMOVING THE LAST PATH DROPS THE MODULE. Without w.root's imports of w.low, nothing reaches w.low,
// so it leaves the partition; the root stays.
test fn removing_the_last_import_drops_a_non_root_module() -> Bool {
  match witness_derive(roots: ["w.root"], deps: []) {
    Stage0PartitionDerivationRefused { cause: _ } => false
    Stage0PartitionDerived { module_dag: _, placements: placements } =>
      witness_basenames_are(placements: placements, expected: [rust_runtime_prelude_module, "w_root"])
  }
}

// A CYCLE IS PLACED TOGETHER, WHATEVER ORDER ITS FACTS ARRIVE IN. w.x and w.y import each other;
// w.x's floor is u-a and w.y's is u-b, so a member-by-member placement would split them and the
// answer would depend on which was read first. Both orders give both u-b.
test fn a_mixed_floor_cycle_lands_in_one_unit_in_either_input_order() -> Bool {
  let forward = [
    witness_source_dep(path: "f/x.dag", target: "w.y", declared: true),
    witness_source_dep(path: "f/y.dag", target: "w.x", declared: true),
  ]
  let backward = [
    witness_source_dep(path: "f/y.dag", target: "w.x", declared: true),
    witness_source_dep(path: "f/x.dag", target: "w.y", declared: true),
  ]
  let reversed_decls = witness_source_decls() |> fold(init: [], f: fn(acc, decl) { [decl] |> concat(acc) })
  let first = witness_derive(roots: ["w.x"], deps: forward)
  let second = stage0_partition_derivation_over(
    roots: ["w.y"],
    floors: witness_floors(),
    order: witness_order(),
    declarations: reversed_decls,
    dependencies: backward
  )
  match first {
    Stage0PartitionDerivationRefused { cause: _ } => false
    Stage0PartitionDerived { module_dag: _, placements: a } =>
      match second {
        Stage0PartitionDerivationRefused { cause: _ } => false
        Stage0PartitionDerived { module_dag: _, placements: b } =>
          witness_unit_of(placements: a, basename: "w_x") == "u-b"
            && witness_unit_of(placements: a, basename: "w_y") == "u-b"
            && witness_unit_of(placements: b, basename: "w_x") == "u-b"
            && witness_unit_of(placements: b, basename: "w_y") == "u-b"
      }
  }
}

// RED: a root the pool does not declare is refused by name, never an empty partition.
test fn stage0_source_undeclared_root_refuses() -> Bool {
  match witness_derive(roots: ["w.ghost"], deps: witness_base_deps()) {
    Stage0PartitionDerivationRefused { cause: Stage0SourceRootUndeclared { module_name: module_name } } => module_name == "w.ghost"
    _ => false
  }
}

// RED: an unresolved dependency of a REACHED module refuses with its importer and target, never
// dropping out of a closure that would then read as complete. (The same shape on w.stray, which no
// root reaches, is the positive control above.)
test fn stage0_source_unresolved_dependency_refuses() -> Bool {
  match witness_derive(roots: ["w.root"], deps: [witness_source_dep(path: "f/root.dag", target: "w.missing", declared: false)]) {
    Stage0PartitionDerivationRefused { cause: Stage0SourceDependencyUnresolved { importer_path: path, target_module: target } } =>
      path == "f/root.dag" && target == "w.missing"
    _ => false
  }
}

// RED: two reached modules that emit to one mirror file would be one crate module with two
// sources; the derivation names both instead of picking one.
test fn stage0_source_ambiguous_basename_refuses() -> Bool {
  let decls = witness_source_decls()
    |> concat([witness_decl(module_name: "w.a_b", path: "f/a_b.dag"), witness_decl(module_name: "w.a.b", path: "f/a/b.dag")])
  match stage0_partition_derivation_over(
    roots: ["w.root"],
    floors: witness_floors(),
    order: witness_order(),
    declarations: decls,
    dependencies: [
      witness_source_dep(path: "f/root.dag", target: "w.a_b", declared: true),
      witness_source_dep(path: "f/root.dag", target: "w.a.b", declared: true),
    ]
  ) {
    Stage0PartitionDerivationRefused { cause: Stage0PartitionedBasenameAmbiguous { basename: basename, modules: modules } } =>
      basename == "w_a_b" && (modules |> count) == 2
    _ => false
  }
}

// RED: a reached module no floor row covers has no lowest unit, and the derivation refuses rather
// than placing it by its dependencies alone.
test fn stage0_source_module_without_a_floor_refuses() -> Bool {
  let decls = witness_source_decls() |> list_push(witness_decl(module_name: "z.m", path: "f/z.dag"))
  match stage0_partition_derivation_over(
    roots: ["w.root"],
    floors: witness_floors(),
    order: witness_order(),
    declarations: decls,
    dependencies: [witness_source_dep(path: "f/root.dag", target: "z.m", declared: true)]
  ) {
    Stage0PartitionDerivationRefused { cause: Stage0UnitFloorMissing { module_name: module_name } } => module_name == "z.m"
    _ => false
  }
}

// RED: a floor row naming a unit the order does not list has no rank to compare.
test fn stage0_source_floor_naming_an_unordered_unit_refuses() -> Bool {
  match stage0_partition_derivation_over(
    roots: ["w.root"],
    floors: [Stage0UnitFloor { prefix: "w", unit_id: "u-nowhere" as CompilationUnitId }],
    order: witness_order(),
    declarations: witness_source_decls(),
    dependencies: []
  ) {
    Stage0PartitionDerivationRefused { cause: Stage0UnitFloorUnranked { prefix: prefix, unit_id: unit } } =>
      prefix == "w" && (unit as String) == "u-nowhere"
    _ => false
  }
}

// THE EMITTED RUNTIME EDGES REACH THE PARTITION FROM THE EMITTER'S OWN ROW PRODUCER. Positive
// control: over the stage0 source DAG, the prelude rows merge, and every emitted member other than
// the runtime module gains exactly one edge to it -- the hand-listed runtime edges are gone from
// the source list, so every one of these was derived. If the merge stopped reading the rows, or
// the rows stopped naming the runtime module, the count moves and this reds.
test fn witness_stage0_runtime_edges_are_derived_from_the_emitter_rows_holds() -> Bool {
  match stage0_partition_derivation {
    Stage0PartitionDerivationRefused { cause: _ } => false
    Stage0PartitionDerived { module_dag: source, placements: _ } => {
      let source_runtime_edges = source.edges
        |> filter(edge => (edge.to as String) == rust_runtime_prelude_module)
        |> count
      match stage0_module_dag_merge_over(source: source) {
        ModuleDagEmittedRefused { cause: _ } => false
        ModuleDagEmittedMerged { module_dag: merged } =>
          source_runtime_edges == 0
            && (merged.edges |> filter(edge => (edge.to as String) == rust_runtime_prelude_module) |> count)
              == ((source.modules |> count) - 1)
            && (merged.edges |> count) == (source.edges |> count) + ((source.modules |> count) - 1)
      }
    }
  }
}

// DISCRIMINATING RED: an emitted edge that reverses a source dependency is refused BY NAME, with
// the provenance that produced it, not merged into a DAG whose R4 verdict would report an anonymous
// cycle. v1_std_core imports std_algebra in the source edges, so an emitter-written
// std_algebra -> v1_std_core path closes a cycle the source does not have.
test fn witness_emitter_reverse_edge_is_refused_by_name_holds() -> Bool {
  let reverse = EmittedEdge {
    from: "std_algebra",
    to: EmittedModuleTarget { module: "v1_std_core" },
    provenance: RuntimePrelude
  }
  match stage0_partition_derivation {
    Stage0PartitionDerivationRefused { cause: _ } => false
    Stage0PartitionDerived { module_dag: source, placements: _ } =>
      match module_dag_with_emitted_edges(
        module_dag: source,
        emitted: module_dag_runtime_prelude_edges(module_dag: source) |> list_push(reverse)
      ) {
        ModuleDagEmittedRefused { cause: EmitterReverseEdge { from: from, to: to, provenance: RuntimePrelude } } =>
          (from as String) == "std_algebra" && (to as String) == "v1_std_core"
        _ => false
      }
  }
}

// An emitted edge to a module the DAG does not declare is refused, never dropped: dropping it
// answers for a smaller graph than the emitted code carries.
test fn witness_emitted_edge_outside_dag_is_refused_holds() -> Bool {
  let stranger = EmittedEdge {
    from: "v1_std_core",
    to: EmittedModuleTarget { module: "not_a_stage0_module" },
    provenance: RuntimePrelude
  }
  match stage0_partition_derivation {
    Stage0PartitionDerivationRefused { cause: _ } => false
    Stage0PartitionDerived { module_dag: source, placements: _ } =>
      match module_dag_with_emitted_edges(module_dag: source, emitted: [stranger]) {
        ModuleDagEmittedRefused { cause: EmittedEdgeEndpointOutsideDag { from: from, to: to } } =>
          from == "v1_std_core" && to == "not_a_stage0_module"
        _ => false
      }
  }
}


// ── THE CONSUMERS FOLLOW THE PARTITION, NOT THE PARTITION'S SNAPSHOT ──────────────────────────
//
// `gunbc.stage0.stage0_crate_partition_generated` is a rendering of
// `v2.workflow.rust_crate_partition.stage0_partition_crate_rows`, refreshed by
// `claim_executor --emit-partition-crates --write` -- which runs in the INSTALL step of the regen
// that is deciding whether to accept a change. Four readers took the rendering as their authority.
// For a converged tree the two are the same seven rows, so nothing here is a tautology about today:
// each arm below is evaluated on the tree under review, and a seed-module change is exactly the tree
// where a row is authored and not yet snapshotted. That is why the executed pair -- these arms over
// a tree whose carrier lags its partition -- is the reading the ledger row cites, and not the
// equality alone. The fork, the runs that executed it (srv1 `ppy-16358`), and the rule that
// separates this from the legitimate "seed projecting itself" reads live in
// gunbc.recurring_failure_mode.adding_a_seed_module_refuses_convergence_on_an_unowned_lib_rs.
//
// Only the readers this corpus can reach are witnessed here. The boundary-write arms live with the
// code they judge: the host test
// the_boundary_write_gives_an_authored_only_package_its_manifest_and_module_list in
// src/v1/stage0/src/required_regen_host.rs puts a package no committed rendering holds in front of
// the fold, and the live-tree pin
// the_partition_crate_call_sites_ask_the_declared_partition_and_not_the_snapshot in
// dag/test/claim/required_regen_admission_witness.dag reddens if a call site goes back to the
// snapshot. A claim witness cannot ask v1.compiler.stage0_crates: see the note on this file's
// imports.

// THE REQUIRED BUILD PHASE BUILDS EVERY PACKAGE THE PARTITION DECLARES.
//
// `repo_self_build_partition_crate_packages` spelled `cargo build -p` for each package out of the
// committed rows, so a change authoring a row for a NEW package kept that package out of the phase
// that is the wall against a bad seed. The same fork, one file later: the partition says a package
// is part of the seed, and the build command consulted the previous answer.
test fn the_required_build_phase_covers_every_declared_partition_package() -> Bool {
  let packages = repo_self_build_partition_crate_packages()
  (stage0_partition_crate_specs() |> all(spec => packages |> any(p => p == spec.package_name)))
    && (packages |> all(p => stage0_partition_crate_specs() |> any(spec => spec.package_name == p)))
}
