test fn stage0_partition_emitted_reference_oracle_red_extra_observation_refuses_holds() -> Bool {
  !stage0_partition_emitted_reference_membership_lists_oracle_holds(
    derived_modules: ["v1_rt"],
    observed_modules: ["v1_rt", "stage0_oracle_phantom_module"]
  )
}

test fn stage0_partition_emitted_reference_oracle_red_missing_observation_refuses_holds() -> Bool {
  !stage0_partition_emitted_reference_membership_lists_oracle_holds(
    derived_modules: ["v1_rt", "std_algebra"],
    observed_modules: ["v1_rt"]
  )
}

test fn stage0_partition_emitted_reference_oracle_set_order_independence_holds() -> Bool {
  stage0_partition_emitted_reference_membership_lists_oracle_holds(
    derived_modules: ["a", "b"],
    observed_modules: ["b", "a"]
  )
}

test fn stage0_partition_emitted_reference_oracle_set_exact_match_holds() -> Bool {
  stage0_partition_emitted_reference_membership_lists_oracle_holds(
    derived_modules: ["a", "b"],
    observed_modules: ["a", "b"]
  )
}

test fn stage0_partition_emitted_reference_oracle_red_duplicate_blind_set_refuses_holds() -> Bool {
  !stage0_partition_emitted_reference_membership_lists_oracle_holds(
    derived_modules: ["a", "a"],
    observed_modules: ["a", "b"]
  )
}
