module v2.test.duplicate_computation.placement_grain_witness

import v2.lens.duplicate_computation {
  ComputationDemandFact,
  UnguardedDemand, GuardedFallbackDemand,
  SingleRun, ReplicatedOracle,
  duplicate_computation_violation_count,
  duplicate_computation_clean_holds
}
import v2.std.logic { Bool }
import v2.std.text { String }

data placement_grain_witness_note: String = "Placement-grain discriminating witness for the codebase-wide duplicate-work lens (docs/plans/duplicate-work-graph-lens-design.md). Flagship real case: CI builds the release binary on THREE independent jobs (ci_job / ci_regen_job / rust_tests warm step; all needs:[], no artifact Share edge; ci_workflow.dag:255/381/414). This proves the SAME violation logic #6372 ships already catches placement duplication once each independently-building job is projected as one demand for the shared build identity — the general lens SUBSUMES #6372 (argv grain and job/placement grain are one law); the only piece #6372 lacked was the cross-job projection. Multiplicity source = placement (one identity, N runners, no Share edge), not fork. A job that consumes the shared artifact emits no build demand and never flags — exactly the fix the lens forces. Per the materialization reframe this is the content-hash generalization of std.realization reconcile keyed on the identity lattice; the ComputationDemandFact rows here stand in for materialization records pending that unification."

data release_build_key: String = "cargo build -p v1-compiler --release --bins"

data ci_job_build_demand: ComputationDemandFact = {
  site: "ci_workflow.ci_job",
  computation_key: release_build_key,
  guard: UnguardedDemand,
  replication: SingleRun
}

data ci_regen_job_build_demand: ComputationDemandFact = {
  site: "ci_workflow.ci_regen_job",
  computation_key: release_build_key,
  guard: UnguardedDemand,
  replication: SingleRun
}

data rust_tests_job_build_demand: ComputationDemandFact = {
  site: "ci_workflow.rust_tests_job.sccache_warm",
  computation_key: release_build_key,
  guard: UnguardedDemand,
  replication: SingleRun
}

data producer_only_build_demand: ComputationDemandFact = {
  site: "ci_workflow.build_job",
  computation_key: release_build_key,
  guard: UnguardedDemand,
  replication: SingleRun
}

data consumer_guarded_fallback_demand: ComputationDemandFact = {
  site: "ci_workflow.consumer_job",
  computation_key: release_build_key,
  guard: GuardedFallbackDemand,
  replication: SingleRun
}

data per_placement_a: ComputationDemandFact = {
  site: "ci_workflow.arch_amd64",
  computation_key: release_build_key,
  guard: UnguardedDemand,
  replication: ReplicatedOracle { runs: 2 }
}

data per_placement_b: ComputationDemandFact = {
  site: "ci_workflow.arch_arm64",
  computation_key: release_build_key,
  guard: UnguardedDemand,
  replication: ReplicatedOracle { runs: 2 }
}

test fn ci_build_across_three_jobs_is_one_violation() -> Bool {
  duplicate_computation_violation_count(facts: [
    ci_job_build_demand,
    ci_regen_job_build_demand,
    rust_tests_job_build_demand
  ]) == 1
}

test fn shared_artifact_rewire_is_clean() -> Bool {
  duplicate_computation_clean_holds(facts: [
    producer_only_build_demand,
    consumer_guarded_fallback_demand
  ])
}

test fn single_producer_is_clean() -> Bool {
  duplicate_computation_clean_holds(facts: [producer_only_build_demand])
}

test fn declared_per_placement_is_admissible() -> Bool {
  duplicate_computation_clean_holds(facts: [per_placement_a, per_placement_b])
}

test fn per_placement_observed_exceeds_declared_is_violation() -> Bool {
  duplicate_computation_violation_count(facts: [
    per_placement_a,
    per_placement_b,
    ci_job_build_demand
  ]) == 1
}
