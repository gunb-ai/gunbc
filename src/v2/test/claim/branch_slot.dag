module v2.test.claim.branch_slot

import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.occurrence_identity { OccurrenceSynthetic }
import std.optional { Absent, Present, optional_absent, optional_present }
import std.types { Bool }
import v2.std.node {
  Atom,
  BranchConditionSlot,
  BranchElseSlot,
  BranchThenSlot,
  ComputationNode,
  Branch,
  Edge,
  Node,
  Positional,
  Symbol,
  TypeNode,
  branch_positional_slot,
  branch_slot_target
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE BRANCH SLOT TABLE, read through the one reader (v2.std.node branch_slot_target). The fixture is the
// shape where reading a role off an edge goes wrong: the condition and the then arm are ONE node, so their
// edges are equal and only the ordinal tells them apart. A reader that found "the child equal to the
// condition" or the first match of any kind would return the same node for the else slot's neighbour; the
// distinct else node is what makes the slot lookups tell the three roles apart.
fn bs_atom(s: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: s } }, children: [], occurrence_id: OccurrenceSynthetic }
}

fn bs_branch() -> Node {
  Node {
    kind: ComputationNode { behavior: Branch },
    children: [
      Edge { label: Positional, target: bs_atom(s: ^bs_shared) },
      Edge { label: Positional, target: bs_atom(s: ^bs_shared) },
      Edge { label: Positional, target: bs_atom(s: ^bs_else) }
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

test fn bs_a_table_maps_ordinals_to_roles_holds() -> Bool {
  branch_positional_slot(ordinal: 0) == optional_present(value: BranchConditionSlot)
    && branch_positional_slot(ordinal: 1) == optional_present(value: BranchThenSlot)
    && branch_positional_slot(ordinal: 2) == optional_present(value: BranchElseSlot)
}

// A FOURTH POSITIONAL CHILD HAS NO ROLE: ordinal 3 is Absent, and a four-positional Branch yields no slot
// target at all, so a malformed Branch is refused at the accessor and never read as two else arms.
test fn bs_c_fourth_positional_has_no_role_holds() -> Bool {
  branch_positional_slot(ordinal: 3) == optional_absent()
    && branch_positional_slot(ordinal: 9) == optional_absent()
    && branch_slot_target(n: bs_branch_four(), slot: BranchElseSlot) == optional_absent()
    && branch_slot_target(n: bs_branch_four(), slot: BranchConditionSlot) == optional_absent()
}

fn bs_branch_four() -> Node {
  Node {
    kind: ComputationNode { behavior: Branch },
    children: [
      Edge { label: Positional, target: bs_atom(s: ^bs_shared) },
      Edge { label: Positional, target: bs_atom(s: ^bs_shared) },
      Edge { label: Positional, target: bs_atom(s: ^bs_else) },
      Edge { label: Positional, target: bs_atom(s: ^bs_fourth) }
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

test fn bs_b_shared_condition_and_then_resolve_by_slot_holds() -> Bool {
  match branch_slot_target(n: bs_branch(), slot: BranchElseSlot) {
    Present { value: e } =>
      e == bs_atom(s: ^bs_else)
        && match branch_slot_target(n: bs_branch(), slot: BranchThenSlot) {
          Present { value: t } => t == bs_atom(s: ^bs_shared) && t != e
          Absent => false
        }
        && match branch_slot_target(n: bs_branch(), slot: BranchConditionSlot) {
          Present { value: c } => c == bs_atom(s: ^bs_shared)
          Absent => false
        }
    Absent => false
  }
}
