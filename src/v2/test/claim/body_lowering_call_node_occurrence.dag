module v2.test.claim.body_lowering_call_node_occurrence

// A LOWERED PRIMARY CALL NODE KEEPS ITS SOURCE'S OCCURRENCE, AND THAT IS WHAT MAKES A FATAL ON IT
// LOCATABLE. `leaf()` in a function body is authored text; v2.compiler.body_lowering_fold lowers it
// to its semantic form, so the result stands for that text and takes its occurrence
// (v2.std.node node_lowered_from, node.dag:423) closed at the root with close_lowered_image (:446) --
// the same contract the where-predicate call already honours (:1238) and the index-read twin honours
// through body_lower_index_read_node. Until this claim, the site built it through the bare
// node_synthetic in body_lower_transform_call, so the node entered resolve and infer as
// OccurrenceSynthetic while its argument nodes stayed OccurrenceMinted -- an authored tree under a
// parent with no authored origin. The cost is observability, exactly where it hurts:
// v2.compiler.source_root_eval native_census_owner_key (:844) answers Absent for OccurrenceSynthetic,
// so a fatal anchored on the call node could never enter the census loci map and its row fell to
// FileRefusalAtUnresolvedNode with occurrence null -- the uniform occurrence:null every seat
// measured for the application_argument_does_not_inhabit class. (Refusal CAUSATION is unchanged
// here: what an argument fails is the inhabitance relation's business, not this file's.)

import v2.compiler.reference_conservation_admission { conserved_normalize_of_text }
import v2.compiler.source_root_eval { native_census_owner_key }
import v2.std.diagnostic { Accepted, Rejected }
import std.occurrence_identity { OccurrenceSynthetic }
import std.optional { Present, Absent }
import v2.std.node {
  Atom,
  ComputationNode,
  Node,
  TypeNode,
  node_subtree_nodes
}
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.list { Empty, first_where }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// The one call text this claim needs: a nullary primary call in a block body -- the shape
// body_lower_try_primary_ident_call recognizes (name, then a call suffix), the same source the
// accepted v2.test.claim.body_lowering_block_body_call drives.
data lowered_call_subject_source: String = "module wall.same\n\nfn leaf() -> Bool = true\n\nfn rollup() -> Bool {\n  leaf()\n}\n"

// THE LOWERED CALL NODE: a Transform whose callee slot is the authored `leaf` spine. Exactly one
// exists in this tree; the subject is fixed, so this is a lookup, not a search over inputs.
fn lowered_call_node_opt(tree: Node) -> Optional<Node> {
  first_where(
    xs: node_subtree_nodes(root: tree),
    keep: fn(n) {
        match n.kind {
          ComputationNode { behavior: _ } =>
            match n.children {
              Cons { head: callee, tail: _ } =>
                match callee.target.kind {
                  TypeNode { connective: Atom { identity: id } } => id == ^leaf
                  _ => false
                }
              Empty => false
            }
          _ => false
        }
    }
  )
}

fn lowered_call_tree() -> Optional<Node> {
  match conserved_normalize_of_text(path: "body_lowering_call_node_occurrence_file", text: lowered_call_subject_source) {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: tree, diagnostics: _ } => Present { value: tree.root }
  }
}

// THE RED, and the property: the call node is LOCATABLE -- native_census_owner_key answers Present,
// which is false for OccurrenceSynthetic and true for the Minted root a closed image keeps. Before
// the fix this claim fails; the fix is the site passing its source through node_lowered_from and
// closing the image. This asserts the census-relevant identity, not a spelling: Pending is also not
// locatable (owner_key drops it too), so an implementation that marked the root Pending instead of
// keeping the source's Minted at the root would not pass.
test fn lowered_primary_call_node_is_locatable_by_the_census() -> Bool {
  match lowered_call_tree() {
    Absent => false
    Present { value: root } =>
      match lowered_call_node_opt(tree: root) {
        Absent => false
        Present { value: call } =>
          match native_census_owner_key(node: call) {
            Present { value: _ } => true
            Absent => false
          }
      }
  }
}

// POSITIVE -- THE CAUSATION SIDE IS UNTOUCHED: the call still lowers to a call. It is a Transform
// over the `leaf` spine, and the tree still normalizes under the conservation admission. A repair
// that dropped the node, or rebuilt it as something application readers no longer recognize, fails
// this while the claim above could still pass.
test fn lowered_primary_call_still_lowers_to_a_transform_over_its_callee() -> Bool {
  match lowered_call_tree() {
    Absent => false
    Present { value: root } =>
      match lowered_call_node_opt(tree: root) {
        Present { value: _ } => true
        Absent => false
      }
  }
}

// POSITIVE -- THE CALL NODE IS NO LONGER SYNTHETIC. The companion to the locatability claim, read
// off the identity itself rather than through the census reader, so a change to owner_key's table
// cannot mask a regression here: the authored call's semantic form must not claim it has no authored
// origin.
test fn lowered_primary_call_node_is_not_synthetic() -> Bool {
  match lowered_call_tree() {
    Absent => false
    Present { value: root } =>
      match lowered_call_node_opt(tree: root) {
        Absent => false
        Present { value: call } =>
          match call.occurrence_id {
            OccurrenceSynthetic => false
            _ => true
          }
      }
  }
}
