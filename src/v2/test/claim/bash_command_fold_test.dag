  }
}

fn bash_fold_with_redir_stmt(node: v2.std.node.Node) -> v2.workflow.bash_emit.BashEmitStmt {
  v2.workflow.bash_emit.BashEmitStmt {
    node: node,
    production_binding: ^bash_production_fold_with_redir,
    rule_name: ^bash_relation_rule_fold_with_redir
  }
}

fn bash_fold_direct_serialize_matches_golden(emitted: v2.std.node.Node, target: v2.std.compilers.target_model.TargetModel, golden: String) -> Bool {
  match v2.compiler.translate.target_serialize_source_from_model(target: target, emitted: emitted) {
    v2.std.diagnostic.Accepted { value: source, diagnostics: d } =>
      (source.carried == golden) && (d == v2.std.diagnostic.None)
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn bash_fold_relation_row_true_witness_holds() -> Bool {
  match v2.extdeps.languages.bash_command_fold.bash_fold_relation_row_witness(
    emitted: v2.extdeps.languages.bash_command_fold.bash_fold_cmd_true_emitted,
    lhs: ^bash_production_fold_command
  ) {
    v2.std.witness.Holds { value: _ } => true
    v2.std.witness.Violates { diagnostic: _ } => false
  }
}

test fn bash_fold_command_single_lit_true_holds() -> Bool {
  v2.workflow.bash_emit.bash_emit_matches_golden(
    stmt: bash_fold_command_stmt(node: v2.extdeps.languages.bash_command_fold.bash_fold_cmd_true_emitted),
    golden: bash_fold_cmd_true_golden
  )
}

test fn bash_fold_command_multi_lit_echo_hi_holds() -> Bool {
  v2.extdeps.languages.bash_command_fold.bash_fold_stmt_kind_sentinel == from_code_point(cp: 2)
    && v2.extdeps.languages.bash_command_fold.bash_fold_word_lit_sentinel == from_code_point(cp: 0)
    && v2.extdeps.languages.bash_command_fold.bash_fold_word_var_sentinel == from_code_point(cp: 1)
    && v2.extdeps.languages.bash_command_fold.bash_fold_word_concat_sentinel == from_code_point(cp: 3)
    && v2.extdeps.languages.bash_command_fold.bash_fold_word_cmdsubst_sentinel == from_code_point(cp: 4)
    && v2.workflow.bash_emit.bash_emit_matches_golden(
      stmt: bash_fold_command_stmt(node: v2.extdeps.languages.bash_command_fold.bash_fold_cmd_echo_hi_emitted),
      golden: bash_fold_cmd_echo_hi_golden
    )
}

test fn bash_fold_command_var_ref_x_holds() -> Bool {
  v2.workflow.bash_emit.bash_emit_matches_golden(
    stmt: bash_fold_command_stmt(node: v2.extdeps.languages.bash_command_fold.bash_fold_cmd_var_x_emitted),
    golden: bash_fold_cmd_var_x_golden
  )
}

