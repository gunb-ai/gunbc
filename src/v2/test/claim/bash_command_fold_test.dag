fn bash_fold_heredoc_wrong_spellings_rejects_oracle_holds() -> Bool {
  bash_fold_wrong_production_mismatch_holds(
    stmt: Heredoc {
      path: Lit { text: "out" },
      delimiter: "EOF",
      body: "hello"
    },
    golden: bash_fold_heredoc_golden,
    wrong_target_witness: bash_fold_heredoc_wrong_target_model_witness()
  )
}

fn bash_fold_with_redir_wrong_production_rejects_oracle_holds() -> Bool {
  match bash_fold_relation_row_witness(
    emitted: bash_stmt_with_redir_emitted,
    lhs: ^bash_production_fold_command
  ) {
    Holds { value: _ } => false
    Violates { diagnostic: _ } => true
  }
}

