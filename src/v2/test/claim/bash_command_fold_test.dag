test fn bash_fold_structural_tier_holds() -> Bool {
  bash_fold_relation_row_true_witness_holds()
  && bash_fold_emitted_tree_differs_on_wrong_fixture_holds()
  && bash_fold_delegated_bundle_fail_closed_holds()
}

test fn bash_fold_command_tier_holds() -> Bool {
  bash_fold_command_single_lit_true_holds()
  && bash_fold_command_multi_lit_echo_hi_holds()
  && bash_fold_command_var_ref_x_holds()
  && bash_fold_command_arbitrary_grep_triple_holds()
  && bash_fold_command_arbitrary_var_home_holds()
  && bash_fold_command_arbitrary_lit_quote_escape_holds()
  && bash_fold_wrong_production_rejects_oracle_holds()
}

test fn bash_fold_direct_serialize_tier_holds() -> Bool {
  bash_fold_direct_serialize_single_lit_true_holds()
  && bash_fold_direct_serialize_multi_lit_echo_hi_holds()
  && bash_fold_direct_serialize_var_ref_x_holds()
}

test fn bash_fold_exit_assign_tier_holds() -> Bool {
  bash_fold_exit_code_42_holds()
  && bash_fold_exit_code_0_holds()
  && bash_fold_exit_wrong_production_rejects_oracle_holds()
  && bash_fold_assign_lit_foo_bar_holds()
  && bash_fold_assign_var_x_home_holds()
  && bash_fold_assign_lit_quote_escape_holds()
  && bash_fold_assign_wrong_production_rejects_oracle_holds()
}

test fn bash_fold_andor_pipe_tier_holds() -> Bool {
  bash_fold_and_then_true_false_holds()
  && bash_fold_or_else_true_false_holds()
  && bash_fold_pipe_echo_hi_wc_holds()
  && bash_fold_and_then_wrong_production_rejects_oracle_holds()
  && bash_fold_pipe_wrong_production_rejects_oracle_holds()
  && bash_fold_pipe_and_then_left_holds()
  && bash_fold_pipe_three_stage_holds()
}

test fn bash_fold_subshell_if_tier_holds() -> Bool {
  bash_fold_subshell_true_holds()
  && bash_fold_subshell_multi_stmt_holds()
  && bash_fold_subshell_nested_and_then_holds()
  && bash_fold_if_true_then_echo_holds()
  && bash_fold_if_multi_then_holds()
  && bash_fold_if_then_pipe_soundness_holds()
  && bash_fold_subshell_wrong_production_rejects_oracle_holds()
  && bash_fold_if_wrong_production_rejects_oracle_holds()
}

test fn bash_fold_rawline_tier_holds() -> Bool {
  bash_fold_raw_line_orch_emit_holds()
  && bash_fold_raw_line_x_eq_holds()
  && bash_fold_raw_line_cmdsubst_holds()
  && bash_fold_raw_line_paren_holds()
  && bash_fold_raw_line_quoted_holds()
  && bash_fold_raw_line_mktemp_holds()
  && bash_fold_raw_line_trailing_nl_holds()
  && bash_fold_raw_line_wrong_spellings_rejects_oracle_holds()
  && bash_fold_raw_line_wrong_production_rejects_oracle_holds()
}

test fn bash_fold_redir_heredoc_tier_holds() -> Bool {
  bash_fold_with_redir_stderr_null_holds()
  && bash_fold_with_redir_stdout_and_stderr_null_holds()
  && bash_fold_with_redir_stdout_to_stderr_holds()
  && bash_fold_with_redir_redir_to_file_var_holds()
  && bash_fold_with_redir_wrong_spellings_rejects_oracle_holds()
  && bash_fold_with_redir_wrong_production_rejects_oracle_holds()
  && bash_fold_with_redir_pipe_soundness_holds()
  && bash_fold_heredoc_holds()
  && bash_fold_heredoc_wrong_spellings_rejects_oracle_holds()
  && bash_fold_heredoc_wrong_production_rejects_oracle_holds()
}

test fn bash_fold_negation_env_tier_holds() -> Bool {
  bash_fold_negation_subshell_false_holds()
  && bash_fold_negation_subshell_rawline_holds()
  && bash_fold_negation_wrong_spellings_rejects_oracle_holds()
  && bash_fold_negation_wrong_production_rejects_oracle_holds()
  && bash_fold_env_prefixed_lit_t_holds()
  && bash_fold_env_prefixed_wrong_spellings_rejects_oracle_holds()
  && bash_fold_env_prefixed_wrong_production_rejects_oracle_holds()
}
