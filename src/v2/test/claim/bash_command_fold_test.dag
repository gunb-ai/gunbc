data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data bash_fold_golden_note: String = "Goldens below are hand-authored expected bytes, deliberately independent of extdeps.languages.bash.program serialize_stmt and of the grammar rows/segment spellings. Each fold test compares bash_program_serialize_stmt (row-emit) against its golden only (PR #6467 ci_cargo_eagain_retry_core_golden pattern)."
data bash_fold_and_then_golden: String = "'true' && 'false'"
data bash_fold_assign_foo_golden: String = "FOO='bar'"
data bash_fold_assign_home_golden: String = "X=\"$HOME\""
data bash_fold_assign_quote_golden: String = "VAR='a'\\''b'"
data bash_fold_cmd_echo_hi_golden: String = "'echo' 'hi'"
data bash_fold_cmd_grep_golden: String = "'grep' '-rn' 'foo_bar.baz'"
data bash_fold_cmd_home_golden: String = "\"$HOME\""
data bash_fold_cmd_quote_golden: String = "'a'\\''b'"
data bash_fold_cmd_true_golden: String = "'true'"
data bash_fold_cmd_var_x_golden: String = "\"$X\""
data bash_fold_env_prefixed_golden: String = "TMPDIR='/t' 'true'"
data bash_fold_exit_0_golden: String = "exit 0"
data bash_fold_exit_42_golden: String = "exit 42"
data bash_fold_heredoc_golden: String = "cat > 'out' <<'EOF'\nhello\nEOF"
data bash_fold_if_echo_golden: String = "if 'true'; then 'echo' 'hi'; fi"
data bash_fold_if_multi_golden: String = "if 'true'; then 'echo' 'hi'; 'false'; fi"
data bash_fold_if_pipe_golden: String = "if 'true'; then 'echo' 'hi' | 'wc' '-c'; fi"
data bash_fold_negation_golden: String = "! ('false')"
data bash_fold_negation_raw_golden: String = "! (do_verify\nmore)"
data bash_fold_or_else_golden: String = "'true' || 'false'"
data bash_fold_pipe_golden: String = "'echo' 'hi' | 'wc' '-c'"
data bash_fold_pipe_and_then_golden: String = "'true' && 'false' | 'wc' '-c'"
data bash_fold_pipe_three_golden: String = "'echo' 'hi' | 'wc' '-c' | 'tr' '-d' ' '"
data bash_fold_raw_cmdsubst_golden: String = "$(a)"
data bash_fold_raw_mktemp_golden: String = "TMPDIR=$('mktemp' '-d')"
data bash_fold_raw_nl_golden: String = "ab\n"
data bash_fold_raw_orch_golden: String = "! ( foo )"
data bash_fold_raw_paren_golden: String = "a)b"
data bash_fold_raw_quoted_golden: String = "'q'"
data bash_fold_raw_xeq_golden: String = "x=y"
data bash_fold_redir_both_golden: String = "'true' >/dev/null 2>&1"
data bash_fold_redir_file_golden: String = "'true' > \"$PROBE_BIN\""
data bash_fold_redir_pipe_golden: String = "'echo' 'hi' | 'wc' '-c' 2>/dev/null"
data bash_fold_redir_stderr_golden: String = "'true' 2>/dev/null"
data bash_fold_redir_stdout_stderr_golden: String = "'true' >&2"
data bash_fold_subshell_golden: String = "('true')"
data bash_fold_subshell_multi_golden: String = "('true'; 'false')"
data bash_fold_subshell_nested_golden: String = "('true' && 'false')"

fn bash_fold_emit_stmt_with_target(stmt: ShellStmt, target: TargetModel) -> Outcome<String> {
  match stmt {
    RawLine { text: _ } =>
      bash_fold_emit_from_emitted(
        emitted: bash_word_pass_emitted,
        target: target
      )
    WithRedir { stmt: _, redir: _ } =>
      bash_fold_emit_from_emitted(
        emitted: bash_stmt_with_redir_emitted,
        target: target
      )
    Heredoc { path: _, delimiter: _, body: _ } =>
      bash_fold_emit_from_emitted(
        emitted: bash_stmt_heredoc_emitted,
        target: target
      )
    Negation { stmt: _ } =>
      bash_fold_emit_from_emitted(
        emitted: bash_stmt_negation_emitted,
        target: target
      )
    EnvPrefixed { name: _, value: _, command: _ } =>
      bash_fold_emit_from_emitted(
        emitted: bash_stmt_env_prefixed_emitted,
        target: target
      )
    Command { words: _ } =>
      bash_fold_fold_serialize(stmt: stmt, target: target)
    Assign { name: _, value: _ } =>
      bash_fold_fold_serialize(stmt: stmt, target: target)
    Exit { code: _ } =>
      bash_fold_fold_serialize(stmt: stmt, target: target)
    AndOr { left: _, op: _, right: _ } =>
      bash_fold_fold_serialize(stmt: stmt, target: target)
    Pipe { left: _, right: _ } =>
      bash_fold_fold_serialize(stmt: stmt, target: target)
    Subshell { body: _ } =>
      bash_fold_fold_serialize(stmt: stmt, target: target)
    If { cond: _, then: _ } =>
      bash_fold_fold_serialize(stmt: stmt, target: target)
    BraceGroup { body: _ } =>
      bash_fold_fold_serialize(stmt: stmt, target: target)
  }
}

fn bash_fold_facts_lookup(key: Node) -> Witness<InferredFacts> {
  Violates {
    diagnostic: Diagnostic {
      reason: ^bash_fold_facts_unexpected_consultation,
      at: node_locus(node: key),
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  }
}

fn bash_fold_emit_from_emitted(emitted: Node, target: TargetModel) -> Outcome<String> {
  let tree = InferredTree {
    root: emitted,
    facts: Map { lookup: bash_fold_facts_lookup }
  }
  match emit(tree: tree, target: target) {
    Accepted { value: source, diagnostics: d } =>
      match d {
        None => Accepted { value: source.carried, diagnostics: None }
        Some { diagnostics: r } => Rejected { diagnostics: r }
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn bash_fold_fold_serialize(stmt: ShellStmt, target: TargetModel) -> Outcome<String> {
  match bash_fold_stmt_emitted_witness(stmt: stmt) {
    Holds { value: emitted } =>
      let tree = InferredTree {
        root: emitted,
        facts: Map { lookup: bash_fold_facts_lookup }
      }
      match emit(tree: tree, target: target) {
        Accepted { value: source, diagnostics: d } =>
          match d {
            None => Accepted { value: source.carried, diagnostics: None }
            Some { diagnostics: r } => Rejected { diagnostics: r }
          }
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    Violates { diagnostic: d } => Rejected { diagnostics: Some { diagnostics: [d] } }
  }
}

fn bash_fold_fold_matches_golden(stmt: ShellStmt, golden: String) -> Bool {
  match bash_program_serialize_stmt(stmt: stmt) {
    Accepted { value: folded, diagnostics: _ } => folded == golden
    Rejected { diagnostics: _ } => false
  }
}

fn bash_fold_relation_row_true_witness_holds() -> Bool {
  match bash_fold_relation_row_witness(
    emitted: bash_fold_cmd_true_emitted,
    lhs: ^bash_production_fold_command
  ) {
    Holds { value: _ } => true
    Violates { diagnostic: _ } => false
  }
}

fn bash_fold_command_single_lit_true_holds() -> Bool {
  bash_fold_fold_matches_golden(
    stmt: Command { words: [Lit { text: "true" }] },
    golden: bash_fold_cmd_true_golden
  )
}

fn bash_fold_command_multi_lit_echo_hi_holds() -> Bool {
  bash_fold_fold_matches_golden(
    stmt: Command { words: [Lit { text: "echo" }, Lit { text: "hi" }] },
    golden: bash_fold_cmd_echo_hi_golden
  )
}

fn bash_fold_command_var_ref_x_holds() -> Bool {
  bash_fold_fold_matches_golden(
    stmt: Command { words: [VarRef { name: "X" }] },
    golden: bash_fold_cmd_var_x_golden
  )
}

fn bash_fold_command_arbitrary_grep_triple_holds() -> Bool {
  bash_fold_fold_matches_golden(
    stmt: Command {
      words: [
        Lit { text: "grep" },
        Lit { text: "-rn" },
        Lit { text: "foo_bar.baz" }
      ]
    },
    golden: bash_fold_cmd_grep_golden
