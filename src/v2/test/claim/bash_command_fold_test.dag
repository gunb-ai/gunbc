fn bash_fold_delegated_bundle_fail_closed_holds() -> Bool {
  match bash_fold_stmt_bundle_witness(
    stmt: Heredoc {
      path: Lit { text: "/tmp/x" },
      delimiter: "EOF",
      body: "x"
    }
  ) {
    Holds { value: _ } => false
    Violates { diagnostic: _ } => true
  }
}

