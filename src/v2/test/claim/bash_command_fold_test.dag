}
import v2.std.logic { Bool }
import v2.std.node { Conj, Node, SyntheticOccurrence, TypeNode }
import v2.std.witness { Holds, Violates, Witness }

fn bash_fold_emit_stmt_with_target(stmt: ShellStmt, target: TargetModel) -> Outcome<String> {
  match stmt {
    RawLine { text: _ } =>
      bash_fold_emit_from_emitted(
        emitted: bash_word_pass_emitted,
        target: target
      )
    WithRedir { stmt: _, redir: _ } =>
      bash_fold_emit_from_emitted(
        emitted: bash_stmt_with_redir_emitted,
        target: target
      )
    Heredoc { path: _, delimiter: _, body: _ } =>
      bash_fold_emit_from_emitted(
        emitted: bash_stmt_heredoc_emitted,
        target: target
      )
    Negation { stmt: _ } =>
      bash_fold_emit_from_emitted(
        emitted: bash_stmt_negation_emitted,
        target: target
      )
    EnvPrefixed { name: _, value: _, command: _ } =>
      bash_fold_emit_from_emitted(
        emitted: bash_stmt_env_prefixed_emitted,
        target: target
      )
    Command { words: _ } =>
      bash_fold_fold_serialize(stmt: stmt, target: target)
    Assign { name: _, value: _ } =>
      bash_fold_fold_serialize(stmt: stmt, target: target)
    Exit { code: _ } =>
      bash_fold_fold_serialize(stmt: stmt, target: target)
    AndOr { left: _, op: _, right: _ } =>
      bash_fold_fold_serialize(stmt: stmt, target: target)
    Pipe { left: _, right: _ } =>
      bash_fold_fold_serialize(stmt: stmt, target: target)
    Subshell { body: _ } =>
      bash_fold_fold_serialize(stmt: stmt, target: target)
    If { cond: _, then: _ } =>
      bash_fold_fold_serialize(stmt: stmt, target: target)
    BraceGroup { body: _ } =>
      bash_fold_fold_serialize(stmt: stmt, target: target)
  }
}

fn bash_fold_facts_lookup(key: Node) -> Witness<InferredFacts> {
  Violates {
    diagnostic: Diagnostic {
      reason: ^bash_fold_facts_unexpected_consultation,
      at: node_locus(node: key),
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  }
}

fn bash_fold_emit_from_emitted(emitted: Node, target: TargetModel) -> Outcome<String> {
  let tree = InferredTree {
    root: emitted,
    facts: Map { lookup: bash_fold_facts_lookup }
  }
  match emit(tree: tree, target: target) {
    Accepted { value: source, diagnostics: d } =>
      match d {
        None => Accepted { value: source.carried, diagnostics: None }
        Some { diagnostics: r } => Rejected { diagnostics: r }
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn bash_fold_emit_word_spelling(w: ShellWord) -> Outcome<String> {
  bash_fold_emit_inner_stmt_spelling(
    stmt: Command { words: [w] }
  )
}

fn bash_fold_emit_redir_spelling(r: Redir) -> Outcome<String> {
  match r {
    StderrToNull =>
      bash_fold_emit_from_emitted(
        emitted: bash_redir_stderr_null_emitted,
        target: bash_redir_stderr_null_target_model()
      )
    StdoutAndStderrToNull =>
      bash_fold_emit_from_emitted(
        emitted: bash_redir_stdout_and_stderr_null_emitted,
        target: bash_redir_stdout_and_stderr_null_target_model()
      )
    StdoutToStderr =>
      bash_fold_emit_from_emitted(
        emitted: bash_redir_stdout_to_stderr_emitted,
        target: bash_redir_stdout_to_stderr_target_model()
      )
    RedirToFile { path: p } =>
      match bash_fold_emit_word_spelling(w: p) {
        Accepted { value: path_spelling, diagnostics: d } =>
          bash_fold_emit_from_emitted(
            emitted: bash_redir_to_file_emitted,
            target: bash_redir_to_file_target_model(path: path_spelling)
          )
        Rejected { diagnostics: rd } => Rejected { diagnostics: rd }
      }
  }
}

fn bash_fold_stmt_list_has_delegated(stmts: List<ShellStmt>) -> Bool {
  match list_head(xs: stmts) {
    HeadAbsent => false
    HeadFound { value: s } =>
      match s {
        WithRedir { stmt: _, redir: _ } => true
        Heredoc { path: _, delimiter: _, body: _ } => true
        RawLine { text: _ } => true
        Negation { stmt: _ } => true
        EnvPrefixed { name: _, value: _, command: _ } => true
        Command { words: _ } =>
          match list_tail(xs: stmts) {
            TailFound { tail: t } => bash_fold_stmt_list_has_delegated(stmts: t)
            TailAbsent => false
          }
        Assign { name: _, value: _ } =>
          match list_tail(xs: stmts) {
            TailFound { tail: t } => bash_fold_stmt_list_has_delegated(stmts: t)
            TailAbsent => false
          }
        If { cond: _, then: _ } =>
          match list_tail(xs: stmts) {
            TailFound { tail: t } => bash_fold_stmt_list_has_delegated(stmts: t)
            TailAbsent => false
          }
        Subshell { body: _ } =>
          match list_tail(xs: stmts) {
            TailFound { tail: t } => bash_fold_stmt_list_has_delegated(stmts: t)
            TailAbsent => false
          }
        BraceGroup { body: _ } =>
          match list_tail(xs: stmts) {
            TailFound { tail: t } => bash_fold_stmt_list_has_delegated(stmts: t)
            TailAbsent => false
          }
        AndOr { left: _, op: _, right: _ } =>
          match list_tail(xs: stmts) {
            TailFound { tail: t } => bash_fold_stmt_list_has_delegated(stmts: t)
            TailAbsent => false
          }
        Pipe { left: _, right: _ } =>
          match list_tail(xs: stmts) {
            TailFound { tail: t } => bash_fold_stmt_list_has_delegated(stmts: t)
            TailAbsent => false
          }
        Exit { code: _ } =>
          match list_tail(xs: stmts) {
            TailFound { tail: t } => bash_fold_stmt_list_has_delegated(stmts: t)
            TailAbsent => false
          }
      }
  }
}

fn bash_fold_emit_stmts_semi_step(acc: String, first: Bool, part: String) -> String {
  if first { part } else { concat(acc, concat("; ", part)) }
}

fn bash_fold_emit_stmts_semi_spelling_from(
  acc: String,
  first: Bool,
  rest: List<ShellStmt>
) -> Outcome<String> {
  match list_head(xs: rest) {
    HeadAbsent => Accepted { value: acc, diagnostics: None }
    HeadFound { value: s } =>
      match bash_fold_emit_inner_stmt_spelling(stmt: s) {
        Accepted { value: part, diagnostics: d } =>
          let next = bash_fold_emit_stmts_semi_step(acc: acc, first: first, part: part)
          match list_tail(xs: rest) {
            TailFound { tail: t } =>
              bash_fold_emit_stmts_semi_spelling_from(
                acc: next,
                first: false,
                rest: t
              )
            TailAbsent => Accepted { value: next, diagnostics: None }
          }
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
  }
}

fn bash_fold_emit_stmts_semi_spelling(stmts: List<ShellStmt>) -> Outcome<String> {
  bash_fold_emit_stmts_semi_spelling_from(acc: "", first: true, rest: stmts)
}

fn bash_fold_emit_inner_stmt_spelling(stmt: ShellStmt) -> Outcome<String> {
  match stmt {
    RawLine { text: _ } => bash_fold_delegated_fold_serialize(stmt: stmt)
    WithRedir { stmt: _, redir: _ } => bash_fold_delegated_fold_serialize(stmt: stmt)
    Heredoc { path: _, delimiter: _, body: _ } => bash_fold_delegated_fold_serialize(stmt: stmt)
    Negation { stmt: _ } => bash_fold_delegated_fold_serialize(stmt: stmt)
    EnvPrefixed { name: _, value: _, command: _ } =>
      bash_fold_delegated_fold_serialize(stmt: stmt)
    Subshell { body: b } =>
      if bash_fold_stmt_list_has_delegated(stmts: b) {
        match bash_fold_emit_stmts_semi_spelling(stmts: b) {
          Accepted { value: body_spelling, diagnostics: d } =>
            Accepted {
              value: concat("(", concat(body_spelling, ")")),
              diagnostics: None
            }
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
        }
      } else {
        match bash_fold_target_model_for_stmt_witness(stmt: stmt) {
          Holds { value: target } =>
            bash_fold_fold_serialize(stmt: stmt, target: target)
          Violates { diagnostic: d } =>
            Rejected { diagnostics: Some { diagnostics: [d] } }
        }
      }
    Command { words: _ } =>
      match bash_fold_target_model_for_stmt_witness(stmt: stmt) {
        Holds { value: target } =>
          bash_fold_fold_serialize(stmt: stmt, target: target)
        Violates { diagnostic: d } =>
          Rejected { diagnostics: Some { diagnostics: [d] } }
      }
    Assign { name: _, value: _ } =>
      match bash_fold_target_model_for_stmt_witness(stmt: stmt) {
        Holds { value: target } =>
          bash_fold_fold_serialize(stmt: stmt, target: target)
        Violates { diagnostic: d } =>
          Rejected { diagnostics: Some { diagnostics: [d] } }
      }
    Exit { code: _ } =>
      match bash_fold_target_model_for_stmt_witness(stmt: stmt) {
        Holds { value: target } =>
          bash_fold_fold_serialize(stmt: stmt, target: target)
        Violates { diagnostic: d } =>
          Rejected { diagnostics: Some { diagnostics: [d] } }
      }
    AndOr { left: _, op: _, right: _ } =>
      match bash_fold_target_model_for_stmt_witness(stmt: stmt) {
        Holds { value: target } =>
          bash_fold_fold_serialize(stmt: stmt, target: target)
        Violates { diagnostic: d } =>
          Rejected { diagnostics: Some { diagnostics: [d] } }
      }
    Pipe { left: _, right: _ } =>
      match bash_fold_target_model_for_stmt_witness(stmt: stmt) {
        Holds { value: target } =>
          bash_fold_fold_serialize(stmt: stmt, target: target)
        Violates { diagnostic: d } =>
          Rejected { diagnostics: Some { diagnostics: [d] } }
      }
    If { cond: _, then: _ } =>
      match bash_fold_target_model_for_stmt_witness(stmt: stmt) {
        Holds { value: target } =>
          bash_fold_fold_serialize(stmt: stmt, target: target)
        Violates { diagnostic: d } =>
          Rejected { diagnostics: Some { diagnostics: [d] } }
      }
    BraceGroup { body: _ } =>
      match bash_fold_target_model_for_stmt_witness(stmt: stmt) {
        Holds { value: target } =>
          bash_fold_fold_serialize(stmt: stmt, target: target)
        Violates { diagnostic: d } =>
          Rejected { diagnostics: Some { diagnostics: [d] } }
      }
  }
}

fn bash_fold_delegated_fold_unexpected_stmt_rejected() -> Outcome<String> {
  Rejected {
    diagnostics: Some {
      diagnostics: [
        Diagnostic {
          reason: ^bash_fold_delegated_fold_unexpected_stmt,
          at: node_locus(node: Node {
            kind: TypeNode { connective: Conj },
            children: [],
            occurrence_id: SyntheticOccurrence
          }),
          correction: Unavailable { reason: ExternalContractUnknown }
        }
      ]
    }
  }
}

fn bash_fold_delegated_fold_serialize(stmt: ShellStmt) -> Outcome<String> {
  match stmt {
    RawLine { text: t } =>
      bash_fold_emit_from_emitted(
        emitted: bash_word_pass_emitted,
        target: bash_fold_raw_line_target_model(text: t)
      )
    WithRedir { stmt: st, redir: rd } =>
      match bash_fold_emit_inner_stmt_spelling(stmt: st) {
        Accepted { value: stmt_spelling, diagnostics: d } =>
          match bash_fold_emit_redir_spelling(r: rd) {
            Accepted { value: redir_spelling, diagnostics: rd2 } =>
              bash_fold_emit_from_emitted(
                emitted: bash_stmt_with_redir_emitted,
                target: bash_fold_with_redir_target_model(
                  stmt_spelling: stmt_spelling,
                  redir_spelling: redir_spelling
                )
              )
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
          }
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    Heredoc { path: p, delimiter: delim, body: b } =>
      match bash_fold_emit_word_spelling(w: p) {
        Accepted { value: path_spelling, diagnostics: dg } =>
          bash_fold_emit_from_emitted(
            emitted: bash_stmt_heredoc_emitted,
            target: bash_fold_heredoc_target_model(
              path_spelling: path_spelling,
              delimiter: delim,
              body: b
            )
          )
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    Negation { stmt: inner } =>
      match bash_fold_emit_inner_stmt_spelling(stmt: inner) {
        Accepted { value: inner_spelling, diagnostics: d } =>
          bash_fold_emit_from_emitted(
            emitted: bash_stmt_negation_emitted,
            target: bash_fold_negation_target_model(inner_spelling: inner_spelling)
          )
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    EnvPrefixed { name: n, value: v, command: c } =>
      match bash_fold_emit_word_spelling(w: v) {
        Accepted { value: value_spelling, diagnostics: d } =>
          match bash_fold_emit_inner_stmt_spelling(stmt: c) {
            Accepted { value: command_spelling, diagnostics: dc } =>
              bash_fold_emit_from_emitted(
                emitted: bash_stmt_env_prefixed_emitted,
                target: bash_fold_env_prefixed_target_model(
                  name: n,
                  value_spelling: value_spelling,
                  command_spelling: command_spelling
                )
              )
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
          }
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    Command { words: _ } => bash_fold_delegated_fold_unexpected_stmt_rejected()
    Assign { name: _, value: _ } => bash_fold_delegated_fold_unexpected_stmt_rejected()
    Exit { code: _ } => bash_fold_delegated_fold_unexpected_stmt_rejected()
    AndOr { left: _, op: _, right: _ } => bash_fold_delegated_fold_unexpected_stmt_rejected()
    Pipe { left: _, right: _ } => bash_fold_delegated_fold_unexpected_stmt_rejected()
    Subshell { body: _ } => bash_fold_delegated_fold_unexpected_stmt_rejected()
    If { cond: _, then: _ } => bash_fold_delegated_fold_unexpected_stmt_rejected()
    BraceGroup { body: _ } => bash_fold_delegated_fold_unexpected_stmt_rejected()
  }
}

fn bash_fold_fold_serialize(stmt: ShellStmt, target: TargetModel) -> Outcome<String> {
  match bash_fold_stmt_emitted_witness(stmt: stmt) {
    Holds { value: emitted } =>
      let tree = InferredTree {
        root: emitted,
        facts: Map { lookup: bash_fold_facts_lookup }
      }
      match emit(tree: tree, target: target) {
        Accepted { value: source, diagnostics: d } =>
          match d {
            None => Accepted { value: source.carried, diagnostics: None }
            Some { diagnostics: r } => Rejected { diagnostics: r }
          }
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    Violates { diagnostic: d } => Rejected { diagnostics: Some { diagnostics: [d] } }
  }
}

fn bash_fold_fold_serialize_stmt(stmt: ShellStmt) -> Outcome<String> {
  match stmt {
    RawLine { text: _ } =>
      bash_fold_delegated_fold_serialize(stmt: stmt)
    WithRedir { stmt: _, redir: _ } =>
      bash_fold_delegated_fold_serialize(stmt: stmt)
    Heredoc { path: _, delimiter: _, body: _ } =>
      bash_fold_delegated_fold_serialize(stmt: stmt)
    Negation { stmt: _ } =>
      bash_fold_delegated_fold_serialize(stmt: stmt)
    EnvPrefixed { name: _, value: _, command: _ } =>
      bash_fold_delegated_fold_serialize(stmt: stmt)
    Subshell { body: b } =>
      if bash_fold_stmt_list_has_delegated(stmts: b) {
        match bash_fold_emit_stmts_semi_spelling(stmts: b) {
          Accepted { value: body_spelling, diagnostics: d } =>
            match bash_fold_emit_from_emitted(
              emitted: bash_stmt_subshell_emitted,
              target: bash_stmt_subshell_target_model(body: body_spelling)
            ) {
              Accepted { value: folded, diagnostics: fd } =>
                match fd {
                  None => Accepted { value: folded, diagnostics: None }
                  Some { diagnostics: r } => Rejected { diagnostics: r }
                }
              Rejected { diagnostics: r } => Rejected { diagnostics: r }
            }
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
        }
      } else {
        match bash_fold_target_model_for_stmt_witness(stmt: stmt) {
          Holds { value: target } =>
            bash_fold_fold_serialize(stmt: stmt, target: target)
          Violates { diagnostic: d } =>
            Rejected { diagnostics: Some { diagnostics: [d] } }
        }
      }
    Command { words: _ } =>
      match bash_fold_target_model_for_stmt_witness(stmt: stmt) {
        Holds { value: target } =>
          bash_fold_fold_serialize(stmt: stmt, target: target)
        Violates { diagnostic: d } =>
          Rejected { diagnostics: Some { diagnostics: [d] } }
      }
    Assign { name: _, value: _ } =>
      match bash_fold_target_model_for_stmt_witness(stmt: stmt) {
        Holds { value: target } =>
          bash_fold_fold_serialize(stmt: stmt, target: target)
        Violates { diagnostic: d } =>
          Rejected { diagnostics: Some { diagnostics: [d] } }
      }
    Exit { code: _ } =>
      match bash_fold_target_model_for_stmt_witness(stmt: stmt) {
        Holds { value: target } =>
          bash_fold_fold_serialize(stmt: stmt, target: target)
        Violates { diagnostic: d } =>
          Rejected { diagnostics: Some { diagnostics: [d] } }
      }
    AndOr { left: _, op: _, right: _ } =>
      match bash_fold_target_model_for_stmt_witness(stmt: stmt) {
        Holds { value: target } =>
          bash_fold_fold_serialize(stmt: stmt, target: target)
        Violates { diagnostic: d } =>
          Rejected { diagnostics: Some { diagnostics: [d] } }
      }
    Pipe { left: _, right: _ } =>
      match bash_fold_target_model_for_stmt_witness(stmt: stmt) {
        Holds { value: target } =>
          bash_fold_fold_serialize(stmt: stmt, target: target)
        Violates { diagnostic: d } =>
          Rejected { diagnostics: Some { diagnostics: [d] } }
      }
    If { cond: _, then: _ } =>
      match bash_fold_target_model_for_stmt_witness(stmt: stmt) {
        Holds { value: target } =>
          bash_fold_fold_serialize(stmt: stmt, target: target)
        Violates { diagnostic: d } =>
          Rejected { diagnostics: Some { diagnostics: [d] } }
      }
    BraceGroup { body: _ } =>
      match bash_fold_target_model_for_stmt_witness(stmt: stmt) {
        Holds { value: target } =>
          bash_fold_fold_serialize(stmt: stmt, target: target)
        Violates { diagnostic: d } =>
          Rejected { diagnostics: Some { diagnostics: [d] } }
      }
  }
}

fn bash_fold_fold_matches_oracle(stmt: ShellStmt) -> Bool {
  match bash_fold_fold_serialize_stmt(stmt: stmt) {
    Accepted { value: folded, diagnostics: _ } => folded == serialize_stmt(s: stmt)
    Rejected { diagnostics: _ } => false
  }
}

fn bash_fold_relation_row_true_witness_holds() -> Bool {
  match bash_fold_relation_row_witness(
    emitted: bash_fold_cmd_true_emitted,
    lhs: ^bash_production_fold_command
  ) {
    Holds { value: _ } => true
    Violates { diagnostic: _ } => false
  }
}

fn bash_fold_command_single_lit_true_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: Command { words: [Lit { text: "true" }] }
  )
}

fn bash_fold_command_multi_lit_echo_hi_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: Command { words: [Lit { text: "echo" }, Lit { text: "hi" }] }
  )
}

fn bash_fold_command_var_ref_x_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: Command { words: [VarRef { name: "X" }] }
  )
}

fn bash_fold_command_arbitrary_grep_triple_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: Command {
      words: [
        Lit { text: "grep" },
        Lit { text: "-rn" },
        Lit { text: "foo_bar.baz" }
      ]
    }
  )
}

fn bash_fold_command_arbitrary_var_home_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: Command { words: [VarRef { name: "HOME" }] }
  )
}

fn bash_fold_command_arbitrary_lit_quote_escape_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: Command { words: [Lit { text: "a'b" }] }
  )
}

fn bash_fold_wrong_production_rejects_oracle_holds() -> Bool {
  let stmt = Command { words: [Lit { text: "true" }] }
  match bash_fold_cmd_true_wrong_target_model_witness() {
    Holds { value: target } =>
      match bash_fold_fold_serialize(stmt: stmt, target: target) {
        Accepted { value: folded, diagnostics: _ } => folded != serialize_stmt(s: stmt)
        Rejected { diagnostics: _ } => true
      }
    Violates { diagnostic: _ } => false
  }
}

fn bash_fold_direct_serialize_matches_oracle(emitted: Node, target: TargetModel, stmt: ShellStmt) -> Bool {
  match target_serialize_source_from_model(target: target, emitted: emitted) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == serialize_stmt(s: stmt)) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

fn bash_fold_direct_serialize_single_lit_true_holds() -> Bool {
  let stmt = Command { words: [Lit { text: "true" }] }
  match bash_fold_target_model_for_stmt_witness(stmt: stmt) {
    Holds { value: target } =>
      bash_fold_direct_serialize_matches_oracle(
        emitted: bash_fold_cmd_true_emitted,
        target: target,
        stmt: stmt
      )
    Violates { diagnostic: _ } => false
  }
}

fn bash_fold_direct_serialize_multi_lit_echo_hi_holds() -> Bool {
  let stmt = Command { words: [Lit { text: "echo" }, Lit { text: "hi" }] }
  match bash_fold_target_model_for_stmt_witness(stmt: stmt) {
    Holds { value: target } =>
      bash_fold_direct_serialize_matches_oracle(
        emitted: bash_fold_cmd_echo_hi_emitted,
