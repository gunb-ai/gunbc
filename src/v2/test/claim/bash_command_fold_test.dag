fn bash_fold_heredoc_holds() -> Bool {
  match bash_emit_heredoc(path_spelling: "'out'", delimiter: "EOF", body: "hello") {
    Accepted { value: folded, diagnostics: _ } => folded == bash_fold_heredoc_golden
    Rejected { diagnostics: _ } => false
  }
}

fn bash_fold_with_redir_wrong_spellings_rejects_oracle_holds() -> Bool {
  match bash_fold_with_redir_wrong_target_model_witness() {
    Holds { value: target } =>
      bash_emit_wrong_spelling_oracle_holds(
        emit_o: bash_emit_from_target(emitted: bash_stmt_with_redir_emitted, target: target),
        golden: bash_fold_redir_stderr_golden
      )
    Violates { diagnostic: _ } => false
  }
}

fn bash_fold_heredoc_wrong_spellings_rejects_oracle_holds() -> Bool {
  match bash_fold_heredoc_wrong_target_model_witness() {
    Holds { value: target } =>
      target.authority_source_text != bash_fold_heredoc_golden
    Violates { diagnostic: _ } => false
  }
}

