fn bash_fold_cmd_true_stmt() -> ShellStmt {
  Command { words: [Lit { text: "true" }] }
}

fn bash_fold_cmd_false_stmt() -> ShellStmt {
  Command { words: [Lit { text: "false" }] }
}

fn bash_fold_and_then_true_false_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: AndOr {
      left: bash_fold_cmd_true_stmt(),
      op: AndThen,
      right: bash_fold_cmd_false_stmt()
    }
  )
}

fn bash_fold_or_else_true_false_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: AndOr {
      left: bash_fold_cmd_true_stmt(),
      op: OrElse,
      right: bash_fold_cmd_false_stmt()
    }
  )
}

fn bash_fold_pipe_echo_hi_wc_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: Pipe {
      left: Command { words: [Lit { text: "echo" }, Lit { text: "hi" }] },
      right: Command { words: [Lit { text: "wc" }, Lit { text: "-c" }] }
    }
  )
}

fn bash_fold_and_then_wrong_production_rejects_oracle_holds() -> Bool {
  match bash_fold_relation_row_witness(
    emitted: bash_fold_and_then_true_false_emitted,
    lhs: ^bash_production_fold_or_else
  ) {
    Holds { value: _ } => false
    Violates { diagnostic: _ } => true
  }
}

fn bash_fold_pipe_wrong_production_rejects_oracle_holds() -> Bool {
  match bash_fold_relation_row_witness(
    emitted: bash_fold_pipe_echo_hi_wc_emitted,
    lhs: ^bash_production_fold_and_then
  ) {
    Holds { value: _ } => false
    Violates { diagnostic: _ } => true
  }
}

fn bash_fold_pipe_and_then_left_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: Pipe {
      left: AndOr {
        left: bash_fold_cmd_true_stmt(),
        op: AndThen,
        right: bash_fold_cmd_false_stmt()
      },
      right: Command { words: [Lit { text: "wc" }, Lit { text: "-c" }] }
    }
  )
}

fn bash_fold_pipe_three_stage_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: Pipe {
      left: Pipe {
        left: Command { words: [Lit { text: "echo" }, Lit { text: "hi" }] },
        right: Command { words: [Lit { text: "wc" }, Lit { text: "-c" }] }
      },
      right: Command { words: [Lit { text: "tr" }, Lit { text: "-d" }, Lit { text: " " }] }
    }
  )
}

fn bash_fold_subshell_true_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: Subshell { body: [Command { words: [Lit { text: "true" }] }] }
  )
}

fn bash_fold_subshell_multi_stmt_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: Subshell {
      body: [
        Command { words: [Lit { text: "true" }] },
        Command { words: [Lit { text: "false" }] }
      ]
    }
