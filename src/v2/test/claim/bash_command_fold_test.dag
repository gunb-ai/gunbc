fn bash_fold_raw_line_wrong_spellings_rejects_oracle_holds() -> Bool {
  match bash_fold_raw_line_wrong_target_model_witness() {
    Holds { value: target } =>
      bash_emit_wrong_spelling_oracle_holds(
        emit_o: bash_emit_from_target(emitted: bash_word_pass_emitted, target: target),
        golden: bash_fold_raw_orch_golden
      )
    Violates { diagnostic: _ } => false
  }
}

fn bash_fold_raw_line_wrong_production_rejects_oracle_holds() -> Bool {
  match bash_fold_relation_row_witness(
    emitted: bash_word_pass_emitted,
    lhs: ^bash_production_fold_command
  ) {
    Holds { value: _ } => false
    Violates { diagnostic: _ } => true
  }
}

fn bash_fold_negation_subshell_false_holds() -> Bool {
  match bash_emit_negation(
    inner: bash_build_subshell_from_stmts(stmts: [bash_build_command_from_lits(lits: ["false"])])
  ) {
    Accepted { value: folded, diagnostics: _ } => folded == bash_fold_negation_golden
    Rejected { diagnostics: _ } => false
  }
}

fn bash_fold_negation_subshell_rawline_holds() -> Bool {
