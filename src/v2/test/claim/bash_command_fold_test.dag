test fn bash_fold_wrong_production_rejects_oracle_holds() -> Bool {
  v2.workflow.bash_emit.bash_emit_wrong_target_oracle_holds(
    emitted: v2.extdeps.languages.bash_command_fold.bash_fold_cmd_true_emitted,
    golden: bash_fold_cmd_true_golden,
    wrong_target_witness: v2.extdeps.languages.bash_command_fold.bash_fold_cmd_true_wrong_target_model_witness()
  )
}

test fn bash_fold_direct_serialize_single_lit_true_holds() -> Bool {
  match v2.extdeps.languages.bash_command_fold.bash_fold_target_model_for_emitted_witness(
    emitted: v2.extdeps.languages.bash_command_fold.bash_fold_cmd_true_emitted,
    source_literal: ^bash_fold_dynamic_source_literal,
    source_text: bash_fold_cmd_true_golden,
    production_binding: ^bash_production_fold_command,
    rule_name: ^bash_relation_rule_fold_command
  ) {
    v2.std.witness.Holds { value: target } =>
      bash_fold_direct_serialize_matches_golden(
        emitted: v2.extdeps.languages.bash_command_fold.bash_fold_cmd_true_emitted,
        target: target,
        golden: bash_fold_cmd_true_golden
      )
    v2.std.witness.Violates { diagnostic: _ } => false
  }
}

