fn bash_fold_subshell_wrong_production_rejects_oracle_holds() -> Bool {
  match bash_fold_stmt_bundle_witness(
    stmt: Subshell { body: [Command { words: [Lit { text: "true" }] }] }
  ) {
    Holds { value: bundle } =>
      match bash_fold_relation_row_witness(
        emitted: bundle.emitted,
        lhs: ^bash_production_fold_if
      ) {
        Holds { value: _ } => false
        Violates { diagnostic: _ } => true
      }
    Violates { diagnostic: _ } => false
  }
}

