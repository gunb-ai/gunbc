fn bash_fold_if_true_then_echo_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: If {
      cond: Command { words: [Lit { text: "true" }] },
      then: [Command { words: [Lit { text: "echo" }, Lit { text: "hi" }] }]
    }
  )
}

fn bash_fold_if_multi_then_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: If {
      cond: Command { words: [Lit { text: "true" }] },
      then: [
        Command { words: [Lit { text: "echo" }, Lit { text: "hi" }] },
        Command { words: [Lit { text: "false" }] }
      ]
    }
  )
}

fn bash_fold_if_then_pipe_soundness_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: If {
      cond: Command { words: [Lit { text: "true" }] },
      then: [
        Pipe {
          left: Command { words: [Lit { text: "echo" }, Lit { text: "hi" }] },
          right: Command { words: [Lit { text: "wc" }, Lit { text: "-c" }] }
        }
      ]
    }
  )
}

fn bash_fold_subshell_wrong_production_rejects_oracle_holds() -> Bool {
  match bash_fold_stmt_bundle_witness(
    stmt: Subshell { body: [Command { words: [Lit { text: "true" }] }] }
  ) {
    Holds { value: bundle } =>
      match bash_fold_relation_row_witness(
        emitted: bundle.emitted,
        lhs: ^bash_production_fold_if
      ) {
        Holds { value: _ } => false
        Violates { diagnostic: _ } => true
      }
    Violates { diagnostic: _ } => false
  }
}

fn bash_fold_if_wrong_production_rejects_oracle_holds() -> Bool {
  match bash_fold_stmt_bundle_witness(
    stmt: If {
      cond: Command { words: [Lit { text: "true" }] },
      then: [Command { words: [Lit { text: "echo" }, Lit { text: "hi" }] }]
    }
  ) {
    Holds { value: bundle } =>
      match bash_fold_relation_row_witness(
        emitted: bundle.emitted,
        lhs: ^bash_production_fold_subshell
      ) {
        Holds { value: _ } => false
        Violates { diagnostic: _ } => true
      }
    Violates { diagnostic: _ } => false
  }
}

