}

fn bash_fold_and_then_true_false_holds() -> Bool {
  bash_fold_fold_matches_golden(
    stmt: AndOr {
      left: bash_fold_cmd_true_stmt(),
      op: AndThen,
      right: bash_fold_cmd_false_stmt()
    },
    golden: bash_fold_and_then_golden
  )
}

fn bash_fold_or_else_true_false_holds() -> Bool {
