fn bash_fold_assign_lit_quote_escape_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: Assign { name: "VAR", value: Lit { text: "a'b" } }
  )
}

fn bash_fold_assign_wrong_production_rejects_oracle_holds() -> Bool {
  bash_fold_wrong_production_mismatch_holds(
    stmt: Assign { name: "FOO", value: Lit { text: "bar" } },
    wrong_target_witness: bash_fold_assign_wrong_target_model_witness()
  )
