  bash_fold_cmd_true_wrong_target_model_witness,
  bash_fold_cmd_var_x_emitted,
  bash_fold_env_prefixed_target_model,
  bash_fold_env_prefixed_wrong_target_model_witness,
  bash_fold_exit_wrong_target_model_witness,
  bash_fold_heredoc_target_model,
  bash_fold_heredoc_wrong_target_model_witness,
  bash_fold_negation_target_model,
