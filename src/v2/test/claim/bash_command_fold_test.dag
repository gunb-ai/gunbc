fn bash_fold_with_redir_stmt(node: Node) -> BashEmitStmt {
  BashEmitStmt {
    node: node,
    production_binding: ^bash_production_fold_with_redir,
    rule_name: ^bash_relation_rule_fold_with_redir
  }
}

fn bash_fold_direct_serialize_matches_golden(emitted: Node, target: TargetModel, golden: String) -> Bool {
  match target_serialize_source_from_model(target: target, emitted: emitted) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == golden) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

fn bash_fold_relation_row_true_witness_holds() -> Bool {
  match bash_fold_relation_row_witness(
    emitted: bash_fold_cmd_true_emitted,
    lhs: ^bash_production_fold_command
  ) {
    Holds { value: _ } => true
    Violates { diagnostic: _ } => false
  }
}

fn bash_fold_command_single_lit_true_holds() -> Bool {
  bash_emit_matches_golden(
    stmt: bash_fold_command_stmt(node: bash_fold_cmd_true_emitted),
    golden: bash_fold_cmd_true_golden
  )
}

fn bash_fold_command_multi_lit_echo_hi_holds() -> Bool {
  bash_emit_matches_golden(
    stmt: bash_fold_command_stmt(node: bash_fold_cmd_echo_hi_emitted),
    golden: bash_fold_cmd_echo_hi_golden
  )
}

fn bash_fold_command_var_ref_x_holds() -> Bool {
  bash_emit_matches_golden(
    stmt: bash_fold_command_stmt(node: bash_fold_cmd_var_x_emitted),
    golden: bash_fold_cmd_var_x_golden
  )
}

fn bash_fold_command_arbitrary_grep_triple_holds() -> Bool {
  bash_emit_matches_golden(
