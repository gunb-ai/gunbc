module v2.test.claim.bash_command_fold

import extdeps.languages.bash.program {
  AndOr,
  AndThen,
  Assign,
  Command,
  Exit,
  If,
  Lit,
  OrElse,
  Pipe,
  ShellStmt,
  Subshell,
  VarRef,
  serialize_stmt
}
import v2.compiler.emit { emit }
import v2.compiler.infer { InferredFacts, InferredTree }
import v2.compiler.translate { target_serialize_source_from_model }
import v2.extdeps.languages.bash_command_fold {
  bash_fold_and_then_true_false_emitted,
  bash_fold_and_then_wrong_target_model_witness,
  bash_fold_assign_wrong_target_model_witness,
  bash_fold_cmd_echo_hi_emitted,
  bash_fold_cmd_true_emitted,
  bash_fold_cmd_true_wrong_emitted,
  bash_fold_cmd_true_wrong_target_model_witness,
  bash_fold_cmd_var_x_emitted,
  bash_fold_exit_wrong_target_model_witness,
  bash_fold_if_wrong_target_model_witness,
  bash_fold_pipe_wrong_target_model_witness,
  bash_fold_relation_row_witness,
  bash_fold_subshell_wrong_target_model_witness,
  bash_fold_stmt_emitted_witness,
  bash_fold_target_model_for_stmt_witness
}
import v2.std.compilers.target_model { TargetModel }
import v2.std.collection { Map }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Some,
  Unavailable,
  node_locus
}
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.witness { Holds, Violates, Witness }

fn bash_fold_facts_lookup(key: Node) -> Witness<InferredFacts> {
  Violates {
    diagnostic: Diagnostic {
      reason: ^bash_fold_facts_unexpected_consultation,
      at: node_locus(node: key),
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  }
}

fn bash_fold_fold_serialize(stmt: ShellStmt, target: TargetModel) -> Outcome<String> {
  match bash_fold_stmt_emitted_witness(stmt: stmt) {
    Holds { value: emitted } =>
      let tree = InferredTree {
        root: emitted,
        facts: Map { lookup: bash_fold_facts_lookup }
      }
      match emit(tree: tree, target: target) {
        Accepted { value: source, diagnostics: d } =>
          match d {
            None => Accepted { value: source.carried, diagnostics: None }
            Some { diagnostics: r } => Rejected { diagnostics: r }
          }
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    Violates { diagnostic: d } => Rejected { diagnostics: Some { diagnostics: [d] } }
  }
}

fn bash_fold_fold_matches_oracle(stmt: ShellStmt) -> Bool {
  match bash_fold_target_model_for_stmt_witness(stmt: stmt) {
    Holds { value: target } =>
      match bash_fold_fold_serialize(stmt: stmt, target: target) {
        Accepted { value: folded, diagnostics: _ } => folded == serialize_stmt(s: stmt)
        Rejected { diagnostics: _ } => false
      }
    Violates { diagnostic: _ } => false
  }
}

test fn bash_fold_relation_row_true_witness_holds() -> Bool {
  match bash_fold_relation_row_witness(
    emitted: bash_fold_cmd_true_emitted,
    lhs: ^bash_production_fold_command
  ) {
    Holds { value: _ } => true
    Violates { diagnostic: _ } => false
  }
}

test fn bash_fold_command_single_lit_true_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: Command { words: [Lit { text: "true" }] }
  )
}

test fn bash_fold_command_multi_lit_echo_hi_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: Command { words: [Lit { text: "echo" }, Lit { text: "hi" }] }
  )
}

test fn bash_fold_command_var_ref_x_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: Command { words: [VarRef { name: "X" }] }
  )
}

test fn bash_fold_command_arbitrary_grep_triple_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: Command {
      words: [
        Lit { text: "grep" },
        Lit { text: "-rn" },
        Lit { text: "foo_bar.baz" }
      ]
    }
  )
}

test fn bash_fold_command_arbitrary_var_home_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: Command { words: [VarRef { name: "HOME" }] }
  )
}

test fn bash_fold_command_arbitrary_lit_quote_escape_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: Command { words: [Lit { text: "a'b" }] }
  )
}

fn bash_fold_wrong_production_oracle_mismatch_holds() -> Bool {
  let stmt = Command { words: [Lit { text: "true" }] }
  match bash_fold_cmd_true_wrong_target_model_witness() {
    Holds { value: target } =>
      match bash_fold_fold_serialize(stmt: stmt, target: target) {
        Accepted { value: folded, diagnostics: _ } => folded != serialize_stmt(s: stmt)
        Rejected { diagnostics: _ } => true
      }
    Violates { diagnostic: _ } => false
  }
}

test fn bash_fold_wrong_production_rejects_oracle_holds() -> Bool {
  bash_fold_wrong_production_oracle_mismatch_holds()
}

fn bash_fold_direct_serialize_matches_oracle(emitted: Node, target: TargetModel, stmt: ShellStmt) -> Bool {
  match target_serialize_source_from_model(target: target, emitted: emitted) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == serialize_stmt(s: stmt)) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn bash_fold_direct_serialize_single_lit_true_holds() -> Bool {
  let stmt = Command { words: [Lit { text: "true" }] }
  match bash_fold_target_model_for_stmt_witness(stmt: stmt) {
    Holds { value: target } =>
      bash_fold_direct_serialize_matches_oracle(
        emitted: bash_fold_cmd_true_emitted,
        target: target,
        stmt: stmt
      )
    Violates { diagnostic: _ } => false
  }
}

test fn bash_fold_direct_serialize_multi_lit_echo_hi_holds() -> Bool {
  let stmt = Command { words: [Lit { text: "echo" }, Lit { text: "hi" }] }
  match bash_fold_target_model_for_stmt_witness(stmt: stmt) {
    Holds { value: target } =>
      bash_fold_direct_serialize_matches_oracle(
        emitted: bash_fold_cmd_echo_hi_emitted,
        target: target,
        stmt: stmt
      )
    Violates { diagnostic: _ } => false
  }
}

test fn bash_fold_direct_serialize_var_ref_x_holds() -> Bool {
  let stmt = Command { words: [VarRef { name: "X" }] }
  match bash_fold_target_model_for_stmt_witness(stmt: stmt) {
    Holds { value: target } =>
      bash_fold_direct_serialize_matches_oracle(
        emitted: bash_fold_cmd_var_x_emitted,
        target: target,
        stmt: stmt
      )
    Violates { diagnostic: _ } => false
  }
}

test fn bash_fold_emitted_tree_differs_on_wrong_fixture_holds() -> Bool {
  bash_fold_cmd_true_emitted != bash_fold_cmd_true_wrong_emitted
}

fn bash_fold_wrong_production_mismatch_holds(
  stmt: ShellStmt,
  wrong_target_witness: Witness<TargetModel>
) -> Bool {
  match wrong_target_witness {
    Holds { value: target } =>
      match bash_fold_fold_serialize(stmt: stmt, target: target) {
        Accepted { value: folded, diagnostics: _ } => folded != serialize_stmt(s: stmt)
        Rejected { diagnostics: _ } => true
      }
    Violates { diagnostic: _ } => false
  }
}

test fn bash_fold_exit_code_42_holds() -> Bool {
  bash_fold_fold_matches_oracle(stmt: Exit { code: 42 })
}

test fn bash_fold_exit_code_0_holds() -> Bool {
  bash_fold_fold_matches_oracle(stmt: Exit { code: 0 })
}

test fn bash_fold_exit_wrong_production_rejects_oracle_holds() -> Bool {
  bash_fold_wrong_production_mismatch_holds(
    stmt: Exit { code: 42 },
    wrong_target_witness: bash_fold_exit_wrong_target_model_witness()
  )
}

test fn bash_fold_assign_lit_foo_bar_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: Assign { name: "FOO", value: Lit { text: "bar" } }
  )
}

test fn bash_fold_assign_var_x_home_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: Assign { name: "X", value: VarRef { name: "HOME" } }
  )
}

test fn bash_fold_assign_lit_quote_escape_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: Assign { name: "VAR", value: Lit { text: "a'b" } }
  )
}

test fn bash_fold_assign_wrong_production_rejects_oracle_holds() -> Bool {
  bash_fold_wrong_production_mismatch_holds(
    stmt: Assign { name: "FOO", value: Lit { text: "bar" } },
    wrong_target_witness: bash_fold_assign_wrong_target_model_witness()
  )
}

fn bash_fold_cmd_true_stmt() -> ShellStmt {
  Command { words: [Lit { text: "true" }] }
}

fn bash_fold_cmd_false_stmt() -> ShellStmt {
  Command { words: [Lit { text: "false" }] }
}

test fn bash_fold_and_then_relation_row_holds() -> Bool {
  match bash_fold_relation_row_witness(
    emitted: bash_fold_and_then_true_false_emitted,
    lhs: ^bash_production_fold_and_then
  ) {
    Holds { value: _ } => true
    Violates { diagnostic: _ } => false
  }
}

test fn bash_fold_and_then_true_false_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: AndOr {
      left: bash_fold_cmd_true_stmt(),
      op: AndThen,
      right: bash_fold_cmd_false_stmt()
    }
  )
}

test fn bash_fold_or_else_true_false_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: AndOr {
      left: bash_fold_cmd_true_stmt(),
      op: OrElse,
      right: bash_fold_cmd_false_stmt()
    }
  )
}

test fn bash_fold_pipe_echo_hi_wc_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: Pipe {
      left: Command { words: [Lit { text: "echo" }, Lit { text: "hi" }] },
      right: Command { words: [Lit { text: "wc" }, Lit { text: "-c" }] }
    }
  )
}

test fn bash_fold_and_then_wrong_production_rejects_oracle_holds() -> Bool {
  bash_fold_wrong_production_mismatch_holds(
    stmt: AndOr {
      left: bash_fold_cmd_true_stmt(),
      op: AndThen,
      right: bash_fold_cmd_false_stmt()
    },
    wrong_target_witness: bash_fold_and_then_wrong_target_model_witness()
  )
}

test fn bash_fold_pipe_wrong_production_rejects_oracle_holds() -> Bool {
  bash_fold_wrong_production_mismatch_holds(
    stmt: Pipe {
      left: Command { words: [Lit { text: "echo" }, Lit { text: "hi" }] },
      right: Command { words: [Lit { text: "wc" }, Lit { text: "-c" }] }
    },
    wrong_target_witness: bash_fold_pipe_wrong_target_model_witness()
  )
}

test fn bash_fold_pipe_and_then_left_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: Pipe {
      left: AndOr {
        left: bash_fold_cmd_true_stmt(),
        op: AndThen,
        right: bash_fold_cmd_false_stmt()
      },
      right: Command { words: [Lit { text: "wc" }, Lit { text: "-c" }] }
    }
  )
}

test fn bash_fold_pipe_three_stage_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: Pipe {
      left: Pipe {
        left: Command { words: [Lit { text: "echo" }, Lit { text: "hi" }] },
        right: Command { words: [Lit { text: "wc" }, Lit { text: "-c" }] }
      },
      right: Command { words: [Lit { text: "tr" }, Lit { text: "-d" }, Lit { text: " " }] }
    }
  )
}

test fn bash_fold_subshell_true_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: Subshell { body: [Command { words: [Lit { text: "true" }] }] }
  )
}

test fn bash_fold_subshell_multi_stmt_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: Subshell {
      body: [
        Command { words: [Lit { text: "true" }] },
        Command { words: [Lit { text: "false" }] }
      ]
    }
  )
}

test fn bash_fold_subshell_nested_and_then_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: Subshell {
      body: [
        AndOr {
          left: Command { words: [Lit { text: "true" }] },
          op: AndThen,
          right: Command { words: [Lit { text: "false" }] }
        }
      ]
    }
  )
}

test fn bash_fold_if_true_then_echo_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: If {
      cond: Command { words: [Lit { text: "true" }] },
      then: [Command { words: [Lit { text: "echo" }, Lit { text: "hi" }] }]
    }
  )
}

test fn bash_fold_if_multi_then_holds() -> Bool {
  bash_fold_fold_matches_oracle(
    stmt: If {
      cond: Command { words: [Lit { text: "true" }] },
      then: [
        Command { words: [Lit { text: "echo" }, Lit { text: "hi" }] },
        Command { words: [Lit { text: "false" }] }
      ]
    }
  )
}

test fn bash_fold_subshell_wrong_production_rejects_oracle_holds() -> Bool {
  bash_fold_wrong_production_mismatch_holds(
    stmt: Subshell { body: [Command { words: [Lit { text: "true" }] }] },
    wrong_target_witness: bash_fold_subshell_wrong_target_model_witness()
  )
}

test fn bash_fold_if_wrong_production_rejects_oracle_holds() -> Bool {
  bash_fold_wrong_production_mismatch_holds(
    stmt: If {
      cond: Command { words: [Lit { text: "true" }] },
      then: [Command { words: [Lit { text: "echo" }, Lit { text: "hi" }] }]
    },
    wrong_target_witness: bash_fold_if_wrong_target_model_witness()
  )
}
