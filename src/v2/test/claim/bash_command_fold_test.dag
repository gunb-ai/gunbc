fn bash_fold_emitted_tree_differs_on_wrong_fixture_holds() -> Bool {
  bash_fold_cmd_true_emitted != bash_fold_cmd_true_wrong_emitted
}

fn bash_fold_wrong_production_mismatch_holds(
  stmt: ShellStmt,
  wrong_target_witness: Witness<TargetModel>
) -> Bool {
  match wrong_target_witness {
    Holds { value: target } =>
      match bash_fold_emit_stmt_with_target(stmt: stmt, target: target) {
        Accepted { value: folded, diagnostics: _ } => folded != serialize_stmt(s: stmt)
        Rejected { diagnostics: _ } => true
      }
    Violates { diagnostic: _ } => false
  }
}

