fn bash_fold_command_arbitrary_lit_quote_escape_holds() -> Bool {
  bash_fold_fold_matches_golden(
    stmt: Command { words: [Lit { text: "a'b" }] },
    golden: bash_fold_cmd_quote_golden
  )
}

fn bash_fold_wrong_production_rejects_oracle_holds() -> Bool {
  let stmt = Command { words: [Lit { text: "true" }] }
  match bash_fold_cmd_true_wrong_target_model_witness() {
    Holds { value: target } =>
      match bash_fold_fold_serialize(stmt: stmt, target: target) {
        Accepted { value: folded, diagnostics: _ } => folded != bash_fold_cmd_true_golden
        Rejected { diagnostics: _ } => true
      }
    Violates { diagnostic: _ } => false
  }
}

fn bash_fold_direct_serialize_matches_golden(emitted: Node, target: TargetModel, golden: String) -> Bool {
  match target_serialize_source_from_model(target: target, emitted: emitted) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == golden) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

fn bash_fold_direct_serialize_single_lit_true_holds() -> Bool {
  let stmt = Command { words: [Lit { text: "true" }] }
  match bash_fold_target_model_for_stmt_witness(stmt: stmt) {
    Holds { value: target } =>
      bash_fold_direct_serialize_matches_golden(
        emitted: bash_fold_cmd_true_emitted,
        target: target,
        golden: bash_fold_cmd_true_golden
      )
    Violates { diagnostic: _ } => false
  }
}

fn bash_fold_direct_serialize_multi_lit_echo_hi_holds() -> Bool {
  let stmt = Command { words: [Lit { text: "echo" }, Lit { text: "hi" }] }
  match bash_fold_target_model_for_stmt_witness(stmt: stmt) {
    Holds { value: target } =>
      bash_fold_direct_serialize_matches_golden(
        emitted: bash_fold_cmd_echo_hi_emitted,
        target: target,
        golden: bash_fold_cmd_echo_hi_golden
      )
    Violates { diagnostic: _ } => false
  }
}

fn bash_fold_direct_serialize_var_ref_x_holds() -> Bool {
  let stmt = Command { words: [VarRef { name: "X" }] }
  match bash_fold_target_model_for_stmt_witness(stmt: stmt) {
    Holds { value: target } =>
      bash_fold_direct_serialize_matches_golden(
        emitted: bash_fold_cmd_var_x_emitted,
        target: target,
        golden: bash_fold_cmd_var_x_golden
      )
    Violates { diagnostic: _ } => false
  }
}

fn bash_fold_emitted_tree_differs_on_wrong_fixture_holds() -> Bool {
  bash_fold_cmd_true_emitted != bash_fold_cmd_true_wrong_emitted
}

fn bash_fold_wrong_production_mismatch_holds(
  stmt: ShellStmt,
  golden: String,
  wrong_target_witness: Witness<TargetModel>
) -> Bool {
  match wrong_target_witness {
    Holds { value: target } =>
      match bash_fold_emit_stmt_with_target(stmt: stmt, target: target) {
        Accepted { value: folded, diagnostics: _ } => folded != golden
        Rejected { diagnostics: _ } => true
      }
    Violates { diagnostic: _ } => false
  }
}

fn bash_fold_exit_code_42_holds() -> Bool {
  bash_fold_fold_matches_golden(stmt: Exit { code: 42 }, golden: bash_fold_exit_42_golden)
}

fn bash_fold_exit_code_0_holds() -> Bool {
  bash_fold_fold_matches_golden(stmt: Exit { code: 0 }, golden: bash_fold_exit_0_golden)
}

fn bash_fold_exit_wrong_production_rejects_oracle_holds() -> Bool {
  bash_fold_wrong_production_mismatch_holds(
    stmt: Exit { code: 42 },
    golden: bash_fold_exit_42_golden,
    wrong_target_witness: bash_fold_exit_wrong_target_model_witness()
  )
}

