data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data bash_fold_golden_note: String = "Goldens below are hand-authored expected bytes, deliberately independent of extdeps.languages.bash.program serialize_stmt and of the grammar rows/segment spellings. Each fold test compares bash_emit (row-emit) against its golden only (PR #6467 ci_cargo_eagain_retry_core_golden pattern)."
data bash_fold_and_then_golden: String = "'true' && 'false'"
data bash_fold_assign_foo_golden: String = "FOO='bar'"
data bash_fold_assign_home_golden: String = "X=\"$HOME\""
data bash_fold_assign_quote_golden: String = "VAR='a'\\''b'"
data bash_fold_cmd_echo_hi_golden: String = "'echo' 'hi'"
data bash_fold_cmd_grep_golden: String = "'grep' '-rn' 'foo_bar.baz'"
data bash_fold_cmd_home_golden: String = "\"$HOME\""
data bash_fold_cmd_quote_golden: String = "'a'\\''b'"
data bash_fold_cmd_true_golden: String = "'true'"
data bash_fold_cmd_var_x_golden: String = "\"$X\""
data bash_fold_env_prefixed_golden: String = "TMPDIR='/t' 'true'"
data bash_fold_exit_0_golden: String = "exit 0"
data bash_fold_exit_42_golden: String = "exit 42"
data bash_fold_heredoc_golden: String = "cat > 'out' <<'EOF'\nhello\nEOF"
data bash_fold_if_echo_golden: String = "if 'true'; then 'echo' 'hi'; fi"
data bash_fold_if_multi_golden: String = "if 'true'; then 'echo' 'hi'; 'false'; fi"
data bash_fold_if_pipe_golden: String = "if 'true'; then 'echo' 'hi' | 'wc' '-c'; fi"
data bash_fold_negation_golden: String = "! ('false')"
data bash_fold_negation_raw_golden: String = "! (do_verify\nmore)"
data bash_fold_or_else_golden: String = "'true' || 'false'"
data bash_fold_pipe_golden: String = "'echo' 'hi' | 'wc' '-c'"
data bash_fold_pipe_and_then_golden: String = "'true' && 'false' | 'wc' '-c'"
data bash_fold_pipe_three_golden: String = "'echo' 'hi' | 'wc' '-c' | 'tr' '-d' ' '"
data bash_fold_raw_cmdsubst_golden: String = "$(a)"
data bash_fold_raw_mktemp_golden: String = "TMPDIR=$('mktemp' '-d')"
data bash_fold_raw_nl_golden: String = "ab\n"
data bash_fold_raw_orch_golden: String = "! ( foo )"
data bash_fold_raw_paren_golden: String = "a)b"
data bash_fold_raw_quoted_golden: String = "'q'"
data bash_fold_raw_xeq_golden: String = "x=y"
data bash_fold_redir_both_golden: String = "'true' >/dev/null 2>&1"
data bash_fold_redir_file_golden: String = "'true' > \"$PROBE_BIN\""
data bash_fold_redir_pipe_golden: String = "'echo' 'hi' | 'wc' '-c' 2>/dev/null"
data bash_fold_redir_stderr_golden: String = "'true' 2>/dev/null"
data bash_fold_redir_stdout_stderr_golden: String = "'true' >&2"
data bash_fold_subshell_golden: String = "('true')"
data bash_fold_subshell_multi_golden: String = "('true'; 'false')"
data bash_fold_subshell_nested_golden: String = "('true' && 'false')"

fn bash_fold_command_stmt(node: Node) -> BashEmitStmt {
  BashEmitStmt {
    node: node,
    production_binding: ^bash_production_fold_command,
    rule_name: ^bash_relation_rule_fold_command
  }
}

fn bash_fold_assign_stmt(node: Node) -> BashEmitStmt {
  BashEmitStmt {
    node: node,
    production_binding: ^bash_production_fold_assign,
    rule_name: ^bash_relation_rule_fold_assign
  }
}

