module v2.test.extdeps.spice_rc_passive_deck_claims



data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn spice_rc_passive_deck_named_node_holds(node: v2.extdeps.formats.spice.NodeRef, expected: String) -> Bool {
  match node {
    Named { node: v2.extdeps.formats.spice.NamedNode { name: name } } => name == expected
    _ => false
  }
}

fn spice_rc_passive_deck_first_resistor_holds(body: List<v2.extdeps.formats.spice.DeckStatement>) -> Bool {
  match v2.std.collection.list_at_optional(xs: body, index: 0) {
    Present {
      value: v2.extdeps.formats.spice.DeckComponent {
        component: v2.extdeps.formats.spice.Resistor {
          name: name,
          n_plus: n_plus,
          n_minus: n_minus,
          value: value
        }
      }
    } =>
      name == "1"
        && spice_rc_passive_deck_named_node_holds(node: n_plus, expected: "vin")
        && spice_rc_passive_deck_named_node_holds(node: n_minus, expected: "mid")
        && match value {
          v2.extdeps.formats.spice.SpiceValue { lexeme: lexeme } => lexeme == "1k"
          _ => false
        }
    Absent => false
  }
}

fn spice_rc_passive_deck_second_capacitor_holds(body: List<v2.extdeps.formats.spice.DeckStatement>) -> Bool {
  match v2.std.collection.list_at_optional(xs: body, index: 1) {
    Present {
      value: v2.extdeps.formats.spice.DeckComponent {
        component: v2.extdeps.formats.spice.Capacitor {
          name: name,
          n_plus: n_plus,
          n_minus: n_minus,
          value: value
        }
      }
    } =>
      name == "1"
        && spice_rc_passive_deck_named_node_holds(node: n_plus, expected: "mid")
        && match n_minus {
          v2.extdeps.formats.spice.Ground => true
          _ => false
        }
        && match value {
          v2.extdeps.formats.spice.SpiceValue { lexeme: lexeme } => lexeme == "1u"
          _ => false
        }
    Absent => false
  }
}

fn spice_rc_passive_deck_op_directive_holds(body: List<v2.extdeps.formats.spice.DeckStatement>) -> Bool {
  match v2.std.collection.list_at_optional(xs: body, index: 2) {
    Present {
      value: v2.extdeps.formats.spice.DeckDirective {
        directive: directive
      }
    } =>
      match directive {
        v2.extdeps.formats.spice.Op => true
        _ => false
      }
    Absent => false
  }
}

test fn spice_rc_passive_deck_authority_holds() -> Bool {
  match v2.test.fixture.spice_rc_passive_deck.spice_rc_passive_deck {
    v2.extdeps.formats.spice.SpiceNetlist { title: title, body: body } =>
      title == "RC passive series deck"
        && v2.std.algebra.length(xs: body) == 3
        && spice_rc_passive_deck_first_resistor_holds(body: body)
        && spice_rc_passive_deck_second_capacitor_holds(body: body)
        && spice_rc_passive_deck_op_directive_holds(body: body)
    _ => false
  }
}
