module v2.test.extdeps.spice_rc_passive_deck_claims


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn spice_rc_passive_deck_named_node_holds(node: NodeRef, expected: Symbol) -> Bool {
  match node {
    Named { node: NamedNode { name: name } } => name == expected
    _ => false
  }
}

fn spice_rc_passive_deck_first_resistor_holds(body: List<DeckStatement>) -> Bool {
  match list_at_optional(xs: body, index: 0) {
    Present {
      value: DeckComponent {
        component: Resistor {
          name: name,
          n_plus: n_plus,
          n_minus: n_minus,
          value: value
        }
      }
    } =>
      name == ^r1
        && spice_rc_passive_deck_named_node_holds(node: n_plus, expected: ^vin)
        && spice_rc_passive_deck_named_node_holds(node: n_minus, expected: ^mid)
        && match value {
          SpiceValue { lexeme: lexeme } => lexeme == "1k"
          _ => false
        }
    Absent => false
  }
}

fn spice_rc_passive_deck_second_capacitor_holds(body: List<DeckStatement>) -> Bool {
  match list_at_optional(xs: body, index: 1) {
    Present {
      value: DeckComponent {
        component: Capacitor {
          name: name,
          n_plus: n_plus,
          n_minus: n_minus,
          value: value
        }
      }
    } =>
      name == ^c1
        && spice_rc_passive_deck_named_node_holds(node: n_plus, expected: ^mid)
        && match n_minus {
          Ground => true
          _ => false
        }
        && match value {
          SpiceValue { lexeme: lexeme } => lexeme == "1u"
          _ => false
        }
    Absent => false
  }
}

fn spice_rc_passive_deck_op_directive_holds(body: List<DeckStatement>) -> Bool {
  match list_at_optional(xs: body, index: 2) {
    Present {
      value: DeckDirective {
        directive: directive
      }
    } =>
      match directive {
        Op => true
        _ => false
      }
    Absent => false
  }
}

test fn spice_rc_passive_deck_authority_holds() -> Bool {
  match spice_rc_passive_deck {
    SpiceNetlist { title: title, body: body } =>
      title == "RC passive series deck"
        && length(xs: body) == 3
        && spice_rc_passive_deck_first_resistor_holds(body: body)
        && spice_rc_passive_deck_second_capacitor_holds(body: body)
        && spice_rc_passive_deck_op_directive_holds(body: body)
    _ => false
  }
}
