module v2.test.claim.normalize.operation_modifier

import v2.compiler.reference_conservation_admission { conservation_subject_of_text }
import v2.std.diagnostic { Accepted, Rejected, diagnostics_fatal_reason }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.collection { List }
import v2.std.node { Arrow, Atom, Conj, Edge, Named, Node, Symbol, TypeNode, named_edge_target_lookup, Found, symbol_intern_lexeme }
import v2.std.text { String }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// AN OPERATION'S MODIFIERS LOWER ONTO ITS ARROW'S CONTRACT EDGES (XL-2 PR2c-i;
// v2.compiler.body_lowering_fold body_lower_operation_modifier). `readonly` and `idempotent` are effect
// claims on ^arrow_effect_claims_edge, `hermetic` the execution-mode claim on
// ^arrow_execution_mode_claim_edge, each projected through v2.std.arrow_contract. The module normalizes
// on the full route, and the lowered Arrow carries all three. A modifier declared twice refuses at the
// second as body_lowering_reason_operation_modifier_repeated. Each outcome is computed ONCE as a
// nullary value, enrolled WARM in v2.workflow.floor_pure_producer_share, and each claim reads it.

data all_modifiers_source: String = "module m\n\nservice S {\n  operation Op {\n    readonly\n    idempotent\n    hermetic\n  }\n}\n"
data repeated_modifier_source: String = "module m\n\nservice S {\n  operation Op {\n    readonly\n    readonly\n  }\n}\n"

fn om_arrow_carries(n: Node, effects: List<Symbol>, mode: Symbol) -> Bool {
  match n.kind {
    TypeNode { connective: Arrow } =>
      om_effects_carried(children: n.children, effects: effects) && om_mode_carried(children: n.children, mode: mode)
    _ => false
  }
}

fn om_effects_carried(children: List<Edge>, effects: List<Symbol>) -> Bool {
  match named_edge_target_lookup(children: children, name: ^arrow_effect_claims_edge) {
    Found { target: claims } =>
      fold(effects, init: true, f: fn(acc, l) { acc && om_has_named(children: claims.children, name: l) })
    _ => false
  }
}

fn om_mode_carried(children: List<Edge>, mode: Symbol) -> Bool {
  match named_edge_target_lookup(children: children, name: ^arrow_execution_mode_claim_edge) {
    Found { target: m } =>
      match m.kind {
        TypeNode { connective: Atom { identity: id } } => id == mode
        _ => false
      }
    _ => false
  }
}

fn om_has_named(children: List<Edge>, name: Symbol) -> Bool {
  fold(children, init: false, f: fn(acc, e) { acc || om_edge_named(e: e, name: name) })
}

fn om_edge_named(e: Edge, name: Symbol) -> Bool {
  match e.label {
    Named { name: n } => n == name
    _ => false
  }
}

fn om_tree_has_claimed_arrow(n: Node) -> Bool {
  om_arrow_carries(n: n, effects: [symbol_intern_lexeme(lexeme: "readonly"), symbol_intern_lexeme(lexeme: "idempotent")], mode: symbol_intern_lexeme(lexeme: "hermetic"))
    || fold(n.children, init: false, f: fn(found, e) { found || om_tree_has_claimed_arrow(n: e.target) })
}

fn om_all_modifiers_lowered() -> Bool {
  match conservation_subject_of_text(path: "probe_operation_modifier.dag", text: all_modifiers_source).normalized {
    Accepted { value: tree, diagnostics: _ } => om_tree_has_claimed_arrow(n: tree.root)
    Rejected { diagnostics: _ } => false
  }
}

fn om_repeated_modifier_refused() -> Bool {
  match conservation_subject_of_text(path: "probe_operation_modifier.dag", text: repeated_modifier_source).normalized {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => diagnostics_fatal_reason(d: d) == ^body_lowering_reason_operation_modifier_repeated
  }
}

test fn an_operations_modifiers_lower_onto_its_contract_edges_holds() -> Bool {
  om_all_modifiers_lowered()
}

test fn a_repeated_modifier_refuses_at_the_second_holds() -> Bool {
  om_repeated_modifier_refused()
}
