module v2.test.claim.normalize.census_mode

import v2.compiler.normalize { normalize, normalize_census }
import v2.compiler.normalized_tree {
  CensusTree,
  NormalizedTree,
  census_tree_binding_source,
  normalized_tree_roots_to_binding_sources
}
import v2.compiler.resolution_provenance {
  ProvenanceAmbiguous,
  ProvenanceOwnerless,
  ProvenanceResolved,
  ProvenanceUnbound,
  ReferenceSite,
  module_roster_from_roots,
  resolve_reference_provenance
}
import v2.compiler.symbol_index_fill { symbol_index_fill_module_roots }
import v2.test.parse.supplied_token_stream_support { supplied_stream_matches_tokenize, supplied_stream_parse }
import v2.std.compilers.lexing { Token, TokenStream, token_stream_new }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_lex }
import v2.std.namespace_alias { ModuleBindingSource }
import v2.std.symbol_index { SymbolIndex, empty_symbol_index, symbol_index_lookup }
import v2.std.node_query { find_arrow_body_child }
import v2.std.diagnostic { Accepted, Outcome, Rejected, bind_outcome, diagnostics_fatal_reason }
import v2.std.optional { Absent, Optional, Present }
import v2.std.qualified_name { QualifiedName, qualified_name_from_dotted_string }
import v2.std.logic { Bool }
import v2.std.node { Node, Symbol }
import v2.std.text { String }
import std.algebra { Cons, Empty, FreeMonoid }

// CENSUS MODE'S CONTROLS (gen-two door, PR-b). A module outside the compiled closure is normalized to
// census grade -- every declaration, no fn body -- so a body the lowering cannot yet read cannot
// refuse a module nobody compiles, while a closure member's reference into it still answers with the
// identity whole-root ingest gives. The refusing body is an else-less `if`, which the full fold
// refuses with body_lowering_reason_else_less_if_unlowered; the TWIN differs only in that body, so
// whole-root ingest runs over the twin and census mode over the refusing original.
//
// COST SHAPE (DESIGN section 3, a witness discriminates at one interface). Each claim parses ONE
// small provider and nothing else: the referencing closure member is named by the site's position
// alone, since a bare reference that no lexical scope binds answers from the global unique lookup,
// and the census and whole-root answers are each pinned to the same literal declaring path in their
// own claim -- equal to one literal is equal to each other -- rather than one claim paying for both
// parses. Providers enter as supplied token streams, each paired with a fidelity claim against the
// real tokenizer, and are parsed for real: census mode's input IS a parse tree. The unparseable
// provider alone goes through the real tokenizer inside its claim, which is cheap because the parse
// stops at the missing brace.

data census_record: String = "module c.p
type Point {
  x: Int
}
"

data census_variant: String = "module c.v\ntype Shape = Circle | Square\n"

data census_fn_only_refusing: String = "module c
fn g() -> Int {
  if true {
    return 1
  }
  2
}
"

// The declaration census never admits what did not parse: an unterminated type block.
data census_provider_unparseable: String = "module c.p\ntype Point {\n  x: Int\n"

data census_member_qn: QualifiedName = qualified_name_from_dotted_string(dotted: "c.member")

fn census_parse(source: String) -> Outcome<Node> {
  bind_outcome(
    o: tokenize(text: source, file: ^census_mode_probe, rules: dag_lex()),
    f: fn(tokens) { supplied_stream_parse(tokens: tokens) }
  )
}

fn census_of_stream(tokens: TokenStream) -> Outcome<CensusTree> {
  bind_outcome(o: supplied_stream_parse(tokens: tokens), f: fn(tree) { normalize_census(parse_tree: tree) })
}

fn full_of_stream(tokens: TokenStream) -> Outcome<NormalizedTree> {
  bind_outcome(o: supplied_stream_parse(tokens: tokens), f: fn(tree) { normalize(parse_tree: tree) })
}

fn census_of(source: String) -> Outcome<CensusTree> {
  bind_outcome(
    o: census_parse(source: source),
    f: fn(tree) { normalize_census(parse_tree: tree) }
  )
}

fn index_of(sources: FreeMonoid<ModuleBindingSource>) -> SymbolIndex {
  symbol_index_fill_module_roots(index: empty_symbol_index(), roots: sources)
}

fn member_answer(index: SymbolIndex, provider_root: Node, spelling: String) -> Optional<QualifiedName> {
  match resolve_reference_provenance(
    index: index,
    roster: module_roster_from_roots(roots: Cons { head: provider_root, tail: Empty }),
    site: ReferenceSite {
      position: census_member_qn,
      spelling: qualified_name_from_dotted_string(dotted: spelling)
    }
  ) {
    ProvenanceResolved { site: _, target: target, owner: _ } => Present { value: target }
    ProvenanceOwnerless { site: _, target: _ } => Absent
    ProvenanceAmbiguous { site: _ } => Absent
    ProvenanceUnbound { site: _ } => Absent
  }
}

fn answers(a: Optional<QualifiedName>, expected: String) -> Bool {
  match a {
    Absent => false
    Present { value: x } => x == qualified_name_from_dotted_string(dotted: expected)
  }
}

fn declares(index: SymbolIndex, path: String) -> Bool {
  match symbol_index_lookup(index: index, qualified_path: qualified_name_from_dotted_string(dotted: path)) {
    Absent => false
    Present { value: _ } => true
  }
}

fn record_identities_hold(index: SymbolIndex, provider_root: Node) -> Bool {
  answers(a: member_answer(index: index, provider_root: provider_root, spelling: "Point"), expected: "c.p.Point")
}

// A bare variant-type reference and both variant-arm paths. An arm is indexed twice -- at its Disj
// path and, being unique in the module, at its alias path -- so its identity is asserted at index
// grain; a bare arm spelling hits both and answers without a single target in either mode.
fn variant_identities_hold(index: SymbolIndex, provider_root: Node) -> Bool {
  answers(a: member_answer(index: index, provider_root: provider_root, spelling: "Shape"), expected: "c.v.Shape")
    && declares(index: index, path: "c.v.Shape.Circle")
    && declares(index: index, path: "c.v.Circle")
}

fn census_identities(tokens: TokenStream, holds: fn(SymbolIndex, Node) -> Bool) -> Bool {
  match census_of_stream(tokens: tokens) {
    Rejected { diagnostics: _ } => false
    Accepted { value: provider, diagnostics: _ } =>
      holds(
        index_of(sources: Cons { head: census_tree_binding_source(t: provider), tail: Empty }),
        provider.root
      )
  }
}

fn whole_root_identities(tokens: TokenStream, holds: fn(SymbolIndex, Node) -> Bool) -> Bool {
  match full_of_stream(tokens: tokens) {
    Rejected { diagnostics: _ } => false
    Accepted { value: twin, diagnostics: _ } =>
      holds(
        index_of(sources: normalized_tree_roots_to_binding_sources(roots: Cons { head: twin, tail: Empty })),
        twin.root
      )
  }
}

// ROUTE PRECONDITION: the full fold really refuses this body, and for the cause the census arm exists
// to avoid -- otherwise the census claims would pass over a body nothing refuses.
test fn full_fold_refuses_the_provider_body_holds() -> Bool {
  match full_of_stream(tokens: census_fn_only_refusing_stream()) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } =>
      diagnostics_fatal_reason(d: d) == ^body_lowering_reason_else_less_if_unlowered
  }
}

// Census admits the same source, and the fn's index entry is its signature with no body: which is
// what keeps a non-member's body out of the Disj and alias scans and out of the stored entry.
test fn census_admits_the_refusing_body_and_stores_no_body_holds() -> Bool {
  match census_of_stream(tokens: census_fn_only_refusing_stream()) {
    Rejected { diagnostics: _ } => false
    Accepted { value: provider, diagnostics: _ } =>
      match symbol_index_lookup(
        index: index_of(sources: Cons { head: census_tree_binding_source(t: provider), tail: Empty }),
        qualified_path: qualified_name_from_dotted_string(dotted: "c.g")
      ) {
        Absent => false
        Present { value: entry } =>
          match find_arrow_body_child(root: entry) {
            Accepted { value: _, diagnostics: _ } => false
            Rejected { diagnostics: _ } => true
          }
      }
  }
}

// CONTROL 2: a module whose declarations failed to parse is never admitted at census grade.
test fn census_refuses_a_module_that_did_not_parse_holds() -> Bool {
  match census_of(source: census_provider_unparseable) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

// CONTROL 1, COMPLETENESS. Each pair runs census mode and whole-root ingest over ONE provider and pins
// both to the SAME literal declaring paths, so the two modes agree at identity grain. The providers
// carry no fn: census mode departs from the full fold only at fn, data and test-fn declarations, and
// the refusing fn body is exercised on its own by the admission claim above, whose index entry at the
// fn's path is asserted to exist and to carry no body. Putting a refusing body beside each record or
// variant would only add parse cost to claims already at the new-witness eval-step budget (DESIGN
// section 3).
test fn census_record_references_answer_with_the_declaring_paths_holds() -> Bool {
  census_identities(tokens: census_record_stream(), holds: fn(i, r) { record_identities_hold(index: i, provider_root: r) })
}

test fn whole_root_record_references_answer_with_the_same_paths_holds() -> Bool {
  whole_root_identities(tokens: census_record_stream(), holds: fn(i, r) { record_identities_hold(index: i, provider_root: r) })
}

test fn census_variant_references_answer_with_the_declaring_paths_holds() -> Bool {
  census_identities(tokens: census_variant_stream(), holds: fn(i, r) { variant_identities_hold(index: i, provider_root: r) })
}

test fn whole_root_variant_references_answer_with_the_same_paths_holds() -> Bool {
  whole_root_identities(tokens: census_variant_stream(), holds: fn(i, r) { variant_identities_hold(index: i, provider_root: r) })
}

// The discriminating RED: with no census root in the index the same reference is unbound, so the
// census answer is the census root's doing. Supplies an empty index -- no parse at all.
test fn without_the_census_root_the_reference_is_unbound_RED() -> Bool {
  match resolve_reference_provenance(
    index: empty_symbol_index(),
    roster: Empty,
    site: ReferenceSite {
      position: census_member_qn,
      spelling: qualified_name_from_dotted_string(dotted: "Point")
    }
  ) {
    ProvenanceUnbound { site: _ } => true
    ProvenanceResolved { site: _, target: _, owner: _ } => false
    ProvenanceOwnerless { site: _, target: _ } => false
    ProvenanceAmbiguous { site: _ } => false
  }
}

// SUPPLIED TOKEN STREAMS (the v2.test.parse.supplied_token_stream_support pattern): tokenizing each
// provider inside every claim cost a third of its budget. Each stream is paired with a fidelity claim
// below that the real tokenizer produces exactly it, so supplying it removes no execution of the
// real path (DESIGN section 3 pairing obligation).
fn census_variant_stream() -> TokenStream {
  token_stream_new(all: [
    Token { class: ^dag_token_kw_module, lexeme: "module", file: ^census_mode_probe, start: 0, end: 6 },
    Token { class: ^dag_token_ident, lexeme: "c", file: ^census_mode_probe, start: 7, end: 8 },
    Token { class: ^dag_token_dot, lexeme: ".", file: ^census_mode_probe, start: 8, end: 9 },
    Token { class: ^dag_token_ident, lexeme: "v", file: ^census_mode_probe, start: 9, end: 10 },
    Token { class: ^dag_token_kw_type, lexeme: "type", file: ^census_mode_probe, start: 11, end: 15 },
    Token { class: ^dag_token_ident, lexeme: "Shape", file: ^census_mode_probe, start: 16, end: 21 },
    Token { class: ^dag_token_eq, lexeme: "=", file: ^census_mode_probe, start: 22, end: 23 },
    Token { class: ^dag_token_ident, lexeme: "Circle", file: ^census_mode_probe, start: 24, end: 30 },
    Token { class: ^dag_token_pipe, lexeme: "|", file: ^census_mode_probe, start: 31, end: 32 },
    Token { class: ^dag_token_ident, lexeme: "Square", file: ^census_mode_probe, start: 33, end: 39 }
  ])
}

test fn census_variant_stream_is_what_tokenize_produces_holds() -> Bool {
  supplied_stream_matches_tokenize(text: census_variant, file: ^census_mode_probe, supplied: census_variant_stream())
}

fn census_fn_only_refusing_stream() -> TokenStream {
  token_stream_new(all: [
    Token { class: ^dag_token_kw_module, lexeme: "module", file: ^census_mode_probe, start: 0, end: 6 },
    Token { class: ^dag_token_ident, lexeme: "c", file: ^census_mode_probe, start: 7, end: 8 },
    Token { class: ^dag_token_kw_fn, lexeme: "fn", file: ^census_mode_probe, start: 9, end: 11 },
    Token { class: ^dag_token_ident, lexeme: "g", file: ^census_mode_probe, start: 12, end: 13 },
    Token { class: ^dag_token_lparen, lexeme: "(", file: ^census_mode_probe, start: 13, end: 14 },
    Token { class: ^dag_token_rparen, lexeme: ")", file: ^census_mode_probe, start: 14, end: 15 },
    Token { class: ^dag_token_arrow, lexeme: "->", file: ^census_mode_probe, start: 16, end: 18 },
    Token { class: ^dag_token_ident, lexeme: "Int", file: ^census_mode_probe, start: 19, end: 22 },
    Token { class: ^dag_token_lbrace, lexeme: "{", file: ^census_mode_probe, start: 23, end: 24 },
    Token { class: ^dag_token_kw_if, lexeme: "if", file: ^census_mode_probe, start: 27, end: 29 },
    Token { class: ^dag_token_kw_true, lexeme: "true", file: ^census_mode_probe, start: 30, end: 34 },
    Token { class: ^dag_token_lbrace, lexeme: "{", file: ^census_mode_probe, start: 35, end: 36 },
    Token { class: ^dag_token_kw_return, lexeme: "return", file: ^census_mode_probe, start: 41, end: 47 },
    Token { class: ^dag_token_int_literal, lexeme: "1", file: ^census_mode_probe, start: 48, end: 49 },
    Token { class: ^dag_token_rbrace, lexeme: "}", file: ^census_mode_probe, start: 52, end: 53 },
    Token { class: ^dag_token_int_literal, lexeme: "2", file: ^census_mode_probe, start: 56, end: 57 },
    Token { class: ^dag_token_rbrace, lexeme: "}", file: ^census_mode_probe, start: 58, end: 59 }
  ])
}

test fn census_fn_only_refusing_stream_is_what_tokenize_produces_holds() -> Bool {
  supplied_stream_matches_tokenize(text: census_fn_only_refusing, file: ^census_mode_probe, supplied: census_fn_only_refusing_stream())
}

fn census_record_stream() -> TokenStream {
  token_stream_new(all: [
    Token { class: ^dag_token_kw_module, lexeme: "module", file: ^census_mode_probe, start: 0, end: 6 },
    Token { class: ^dag_token_ident, lexeme: "c", file: ^census_mode_probe, start: 7, end: 8 },
    Token { class: ^dag_token_dot, lexeme: ".", file: ^census_mode_probe, start: 8, end: 9 },
    Token { class: ^dag_token_ident, lexeme: "p", file: ^census_mode_probe, start: 9, end: 10 },
    Token { class: ^dag_token_kw_type, lexeme: "type", file: ^census_mode_probe, start: 11, end: 15 },
    Token { class: ^dag_token_ident, lexeme: "Point", file: ^census_mode_probe, start: 16, end: 21 },
    Token { class: ^dag_token_lbrace, lexeme: "{", file: ^census_mode_probe, start: 22, end: 23 },
    Token { class: ^dag_token_ident, lexeme: "x", file: ^census_mode_probe, start: 26, end: 27 },
    Token { class: ^dag_token_colon, lexeme: ":", file: ^census_mode_probe, start: 27, end: 28 },
    Token { class: ^dag_token_ident, lexeme: "Int", file: ^census_mode_probe, start: 29, end: 32 },
    Token { class: ^dag_token_rbrace, lexeme: "}", file: ^census_mode_probe, start: 33, end: 34 }
  ])
}

test fn census_record_stream_is_what_tokenize_produces_holds() -> Bool {
  supplied_stream_matches_tokenize(text: census_record, file: ^census_mode_probe, supplied: census_record_stream())
}
