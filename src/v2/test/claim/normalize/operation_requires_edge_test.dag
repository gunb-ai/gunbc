// THE TWO WHOLE-CLAUSE WORDS (D13 ruling B) lower onto the SAME edge as childless Atoms, so the one
// carrier has three declared states and an operation with no clause carries none of them.
data requires_words_source: String = "module m\nservice S {\n  operation Q {\n    requires none\n  }\n  operation X {\n    requires opaque\n  }\n}\n"

data requires_none_with_member_source: String = "module m\nservice S {\n  operation Q {\n    requires none, N\n  }\n}\n"

fn requirements_atom_count(root: Node, identity: Symbol) -> Int {
  fold(node_subtree_nodes(root: root), init: 0, f: fn(acc, n) { acc + node_requirements_atom_count(n: n, identity: identity) })
}

fn node_requirements_atom_count(n: Node, identity: Symbol) -> Int {
  match core_edge_target_lookup(children: n.children, marker: ArrowResourceRequirementsEdge) {
    Found { target: t } =>
      match t.kind {
        TypeNode { connective: Atom { identity: id } } => if id == identity { 1 } else { 0 }
        _ => 0
      }
    _ => 0
  }
}

test fn requires_none_and_requires_opaque_lower_to_their_declared_atoms_holds() -> Bool {
  match census_of_stream(tokens: requires_words_stream()) {
    Rejected { diagnostics: _ } => false
    Accepted { value: t, diagnostics: _ } =>
      let root = census_tree_binding_source(t: t).root
      (requirements_atom_count(root: root, identity: ^requirements_declared_none) == 1)
        && (requirements_atom_count(root: root, identity: ^requirements_opaque) == 1)
  }
}

test fn requires_none_followed_by_a_member_refuses_RED() -> Bool {
  match census_of_stream(tokens: requires_none_with_member_stream()) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

