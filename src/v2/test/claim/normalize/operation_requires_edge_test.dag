// ONE RESOURCE NAMED TWICE, AT THE DECISION'S OWN INTERFACE (DESIGN section 3: a witness supplies the
// inputs of the one interface it discriminates). v2.compiler.resolve resolve_requirement_member_refusal_optional
// decides over resolved members and the index; the members here are supplied as the declaration
// references resolve produces for `N` and `m.N` -- one path under two labels -- and the index is the
// census index of a module that declares N. The real route through normalize and resolve stays
// exercised by a_requirement_naming_a_declared_resource_resolves_at_resolve_holds (a member resolving to a marked
// resource path) and a_requirement_naming_a_non_resource_refuses_at_resolve_RED, so supplying the members here
// removes no execution of it.
data resource_only_source: String = "module m\nresource N {\n  kind: Capability\n  mode: Read\n}\n"

test fn one_resource_named_twice_is_refused_by_the_requirement_decision_RED() -> Bool {
  match census_of_stream(tokens: resource_only_stream()) {
    Rejected { diagnostics: _ } => false
    Accepted { value: t, diagnostics: _ } =>
      let index = symbol_index_fill_module_roots(index: empty_symbol_index(), roots: Cons { head: census_tree_binding_source(t: t), tail: Empty })
      let path = Cons { head: ^m, tail: Cons { head: ^N, tail: Empty } }
      let members = [
        Edge { label: Authored { name: ^N }, target: declaration_reference_node(qn: path, occurrence_id: OccurrenceSynthetic) },
        Edge { label: Authored { name: symbol_intern_lexeme(lexeme: "m.N") }, target: declaration_reference_node(qn: path, occurrence_id: OccurrenceSynthetic) }
      ]
      match resolve_requirement_member_refusal_optional(index: index, members: members) {
        Present { value: d } => d.reason == ^resolve_reason_requirement_repeated
        Absent => false
      }
  }
}

// The same decision admits the resource named once, so the refusal above is the repetition and not the
// member: a discriminating control at the same interface.
test fn one_resource_named_once_is_admitted_by_the_requirement_decision_holds() -> Bool {
  match census_of_stream(tokens: resource_only_stream()) {
    Rejected { diagnostics: _ } => false
    Accepted { value: t, diagnostics: _ } =>
      let index = symbol_index_fill_module_roots(index: empty_symbol_index(), roots: Cons { head: census_tree_binding_source(t: t), tail: Empty })
      let members = [Edge { label: Authored { name: ^N }, target: declaration_reference_node(qn: Cons { head: ^m, tail: Cons { head: ^N, tail: Empty } }, occurrence_id: OccurrenceSynthetic) }]
      match resolve_requirement_member_refusal_optional(index: index, members: members) {
        Present { value: _ } => false
        Absent => true
      }
  }
}

