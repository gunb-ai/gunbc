// THE RESOLVE HALF OF THE ROUTE. A module m declaring T, its header naming m through the qualified-name
// spine a parsed header carries (fold_list_node, as v2.test.resolve.qualified_module_projection_resolve
// builds it), so the index fill reads the module's own path; an operation Arrow whose requirements edge names
// T, as body_lower_operation_requires builds it. Resolved at m through the real resolve_node.
fn req_module_root() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_surface_edge(edge: ^dag_surface_module_header, target: dag_grammar_atom(id: ^dag_surface_module_header)),
      dag_surface_edge(edge: ^dag_surface_module_header_qualified_name, target: fold_list_node(xs: Cons { head: ^m, tail: Empty }, item_node: fn(sym) { req_atom(sym: sym) })),
      Edge { label: Authored { name: ^T }, target: req_atom(sym: ^T) }
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn req_atom(sym: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: sym } }, children: [], occurrence_id: OccurrenceSynthetic }
}

fn req_operation_arrow() -> Node {
  let signature = declared_signature(params: [], source: req_atom(sym: ^Op))
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      signature.domain,
      Edge { label: Positional, target: Node { kind: TypeNode { connective: Conj }, children: [], occurrence_id: OccurrenceSynthetic } },
      signature.order,
      Edge {
        label: core_edge_label(marker: ArrowResourceRequirementsEdge),
        target: Node { kind: TypeNode { connective: Conj }, children: [Edge { label: Authored { name: ^T }, target: req_atom(sym: ^T) }], occurrence_id: OccurrenceSynthetic }
      }
    ],
    occurrence_id: OccurrenceSynthetic
  }
}


fn req_refusal_reason(resources: FreeMonoid<Symbol>) -> Symbol {
  let index = symbol_index_fill_module_root(index: empty_symbol_index(), root: req_module_root(), record_declarations: Empty, resource_declarations: resources)
  let module_qn = Cons { head: ^m, tail: Empty }
  let namespace = Namespace {
    bindings: empty_map(),
    canonical_symbols: empty_canonical_symbol_set(),
    symbol_index: index,
    module_qn: module_qn,
    test_code: test_code_index_empty(),
    declared_in: module_qn,
    imported_origins: empty_map()
  }
  match resolve_node(
    ctx: ResolveContext {
      scope: scope_from_namespace(namespace: namespace),
      type_scope: scope_from_namespace(namespace: namespace),
      namespace: namespace,
      policy: NamespaceOnlyY,
      position: module_qn,
      lm: dag_language_model_surface_empty_prelude(),
      under_module_root: false,
      declaring: NotDeclaring
    },
    n: req_operation_arrow()
  ) {
    Accepted { value: _, diagnostics: _ } => ^accepted
    Rejected { diagnostics: r } => diagnostics_fatal_reason(d: r)
  }
}

test fn a_requirement_naming_a_declared_resource_resolves_at_resolve_holds() -> Bool {
  req_refusal_reason(resources: Cons { head: ^T, tail: Empty }) == ^accepted
}

test fn a_requirement_naming_a_non_resource_refuses_at_resolve_RED() -> Bool {
  req_refusal_reason(resources: Empty) == ^resolve_reason_requirement_not_a_resource
}
