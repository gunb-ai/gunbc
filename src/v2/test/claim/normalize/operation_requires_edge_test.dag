import v2.std.integer { Int }
import v2.std.text { String }

// AN OPERATION'S DECLARED RESOURCE REQUIREMENTS (D13 step a; v2.std.node
// CoreEdgeLabel ArrowResourceRequirementsEdge). `requires R, ..` lowers onto the operation Arrow
// (v2.compiler.body_lowering_fold body_lower_operation_requires) and v2.compiler.resolve
// resolve_arrow_resource_requirements checks, in the Arrow's type scope, that every member names a
// declared resource (v2.std.symbol_index symbol_index_declares_resource_at) at most once. These claims
// are that check's production route; the resource fixtures are the module's own declarations, which the
// single-module resolve marks from its normalize-captured resource names.
//
// SUPPLIED TOKEN STREAMS, each paired with a fidelity claim that the real tokenizer produces it
// (DESIGN section 3 pairing obligation), as v2.test.claim.normalize.resource_declaration_lowering does.

// An operation requiring a resource the module declares: the positive control.
data requires_resource_source: String = "module m\nresource N {\n  kind: Capability\n  mode: Read\n}\nservice S {\n  operation Op {\n    requires N\n  }\n}\n"


// RED: one spelling written twice is an ill-formed requirements Conj, refused at lowering.
data requires_spelled_twice_source: String = "module m\nresource N {\n  kind: Capability\n  mode: Read\n}\nservice S {\n  operation Op {\n    requires N, N\n  }\n}\n"


// An operation with no requires clause: its Arrow carries no requirements edge.
data no_requires_source: String = "module m\nservice S {\n  operation Op {}\n}\n"


fn census_of_stream(tokens: TokenStream) -> Outcome<CensusTree> {
  bind_outcome(o: supplied_stream_parse(tokens: tokens), f: fn(tree) { normalize_census(parse_tree: tree) })
}

fn node_carries_requirements_edge(n: Node) -> Bool {
  match core_edge_target_lookup(children: n.children, marker: ArrowResourceRequirementsEdge) {
    Found { target: _ } => true
    _ => false
  }
}

fn carries_requirements_edge(root: Node) -> Bool {
  fold(node_subtree_nodes(root: root), init: false, f: fn(found, n) { found || node_carries_requirements_edge(n: n) })
}


// THE REAL ROUTE, AT A MOVED BOUNDARY. Whole-module normalize-and-resolve claims sat at the new-witness
// eval-step budget (72,309, then 72,394 of 72,300 on composed revisions): their cost is the fixed
// overhead of lowering and resolving a module, which no smaller fixture removes. The route is therefore
// split at its own seam, and each half runs for real: LOWERING of a `requires` clause onto the operation
// Arrow is held on source text by a_requires_clause_lowers_onto_the_operation_arrow_holds; RESOLUTION of
// that edge -- v2.compiler.resolve resolve_node into resolve_arrow_node_in, its requirements arm, and the
// requirement decision -- is held by the pair below over an operation Arrow of exactly that shape and a
// symbol index filled by v2.compiler.symbol_index_fill from a module root that declares T. The pair
// differs in one fact (whether T is marked a declared resource), so neither verdict can come from
// anything but the requirement check.
// The positive fixture's Arrow does carry the edge, so the absence below is a discriminating control.
test fn a_requires_clause_lowers_onto_the_operation_arrow_holds() -> Bool {
  match census_of_stream(tokens: requires_resource_stream()) {
    Rejected { diagnostics: _ } => false
    Accepted { value: t, diagnostics: _ } => carries_requirements_edge(root: census_tree_binding_source(t: t).root)
  }
}

// A REQUIREMENT-FREE OPERATION KEEPS ITS IDENTITY: no requires clause, no edge, so its Arrow is the
// three signature edges it was before this change (v2.compiler.body_lowering_fold
// body_lower_operation_arrow_children).
test fn an_operation_without_requires_carries_no_requirements_edge_holds() -> Bool {
  match census_of_stream(tokens: no_requires_stream()) {
    Rejected { diagnostics: _ } => false
    Accepted { value: t, diagnostics: _ } => !carries_requirements_edge(root: census_tree_binding_source(t: t).root)
  }
}


test fn a_requirement_spelled_twice_refuses_at_lowering_RED() -> Bool {
  match census_of_stream(tokens: requires_spelled_twice_stream()) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: r } => diagnostics_fatal_reason(d: r) == ^body_lowering_reason_operation_requirement_repeated
  }
}


