module v2.test.claim.normalize.operation_requires_edge

import v2.compiler.normalize { normalize, normalize_census }
import v2.compiler.normalized_tree { CensusTree, NormalizedTree, census_tree_binding_source }
import v2.compiler.resolve { ResolvedTree, resolve, resolve_requirement_member_refusal_optional }
import v2.compiler.symbol_index_fill { symbol_index_fill_module_roots }
import v2.std.symbol_index { empty_symbol_index }
import v2.std.qualified_name { declaration_reference_node }
import std.algebra { Cons, Empty }
import v2.extdeps.languages.dag { dag_language_model_surface_empty_prelude }
import v2.test.parse.supplied_token_stream_support { supplied_stream_matches_tokenize, supplied_stream_parse }
import v2.std.compilers.lexing { Token, TokenStream, token_stream_new }
import v2.std.diagnostic { Accepted, Outcome, Rejected, bind_outcome, diagnostics_fatal_reason }
import v2.std.optional { Absent, Present }
import v2.std.logic { Bool }
import std.occurrence_identity { OccurrenceSynthetic }
import v2.std.node { Edge, Found, Named, Node, named_edge_target_lookup, node_subtree_nodes, symbol_intern_lexeme }
import v2.std.text { String }

// AN OPERATION'S DECLARED RESOURCE REQUIREMENTS (D13 step a; v2.std.node
// ^arrow_resource_requirements_edge). `requires R, ..` lowers onto the operation Arrow
// (v2.compiler.body_lowering_fold body_lower_operation_requires) and v2.compiler.resolve
// resolve_arrow_resource_requirements checks, in the Arrow's type scope, that every member names a
// declared resource (v2.std.symbol_index symbol_index_declares_resource_at) at most once. These claims
// are that check's production route; the resource fixtures are the module's own declarations, which the
// single-module resolve marks from its normalize-captured resource names.
//
// SUPPLIED TOKEN STREAMS, each paired with a fidelity claim that the real tokenizer produces it
// (DESIGN section 3 pairing obligation), as v2.test.claim.normalize.resource_declaration_lowering does.

// An operation requiring a resource the module declares: the positive control.
data requires_resource_source: String = "module m\nresource N {\n  kind: Capability\n  mode: Read\n}\nservice S {\n  operation Op {\n    requires N\n  }\n}\n"

// RED: a requirement naming a record resolves to a declaration that is not a resource.
data requires_record_source: String = "module m\ntype T {}\nservice S {\n  operation Op {\n    requires T\n  }\n}\n"

// RED: one spelling written twice is an ill-formed requirements Conj, refused at lowering.
data requires_spelled_twice_source: String = "module m\nresource N {\n  kind: Capability\n  mode: Read\n}\nservice S {\n  operation Op {\n    requires N, N\n  }\n}\n"


// An operation with no requires clause: its Arrow carries no requirements edge.
data no_requires_source: String = "module m\nservice S {\n  operation Op {}\n}\n"

fn resolved_of_stream(tokens: TokenStream) -> Outcome<ResolvedTree> {
  bind_outcome(o: supplied_stream_parse(tokens: tokens), f: fn(tree) {
    bind_outcome(o: normalize(parse_tree: tree), f: fn(normalized) { resolve(tree: normalized, lm: dag_language_model_surface_empty_prelude()) })
  })
}

fn census_of_stream(tokens: TokenStream) -> Outcome<CensusTree> {
  bind_outcome(o: supplied_stream_parse(tokens: tokens), f: fn(tree) { normalize_census(parse_tree: tree) })
}

fn node_carries_requirements_edge(n: Node) -> Bool {
  match named_edge_target_lookup(children: n.children, name: ^arrow_resource_requirements_edge) {
    Found { target: _ } => true
    _ => false
  }
}

fn carries_requirements_edge(root: Node) -> Bool {
  fold(node_subtree_nodes(root: root), init: false, f: fn(found, n) { found || node_carries_requirements_edge(n: n) })
}

test fn a_requirement_naming_a_declared_resource_resolves_holds() -> Bool {
  match resolved_of_stream(tokens: requires_resource_stream()) {
    Rejected { diagnostics: _ } => false
    Accepted { value: _, diagnostics: _ } => true
  }
}

// The positive fixture's Arrow does carry the edge, so the absence below is a discriminating control.
test fn a_requires_clause_lowers_onto_the_operation_arrow_holds() -> Bool {
  match census_of_stream(tokens: requires_resource_stream()) {
    Rejected { diagnostics: _ } => false
    Accepted { value: t, diagnostics: _ } => carries_requirements_edge(root: census_tree_binding_source(t: t).root)
  }
}

// A REQUIREMENT-FREE OPERATION KEEPS ITS IDENTITY: no requires clause, no edge, so its Arrow is the
// three signature edges it was before this change (v2.compiler.body_lowering_fold
// body_lower_operation_arrow_children).
test fn an_operation_without_requires_carries_no_requirements_edge_holds() -> Bool {
  match census_of_stream(tokens: no_requires_stream()) {
    Rejected { diagnostics: _ } => false
    Accepted { value: t, diagnostics: _ } => !carries_requirements_edge(root: census_tree_binding_source(t: t).root)
  }
}

test fn a_requirement_naming_a_record_refuses_located_RED() -> Bool {
  match resolved_of_stream(tokens: requires_record_stream()) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: r } => diagnostics_fatal_reason(d: r) == ^resolve_reason_requirement_not_a_resource
  }
}

test fn a_requirement_spelled_twice_refuses_at_lowering_RED() -> Bool {
  match census_of_stream(tokens: requires_spelled_twice_stream()) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: r } => diagnostics_fatal_reason(d: r) == ^body_lowering_reason_operation_requirement_repeated
  }
}


fn requires_resource_stream() -> TokenStream {
  token_stream_new(all: [
    Token { class: ^dag_token_kw_module, lexeme: "module", file: ^requires_edge_probe, start: 0, end: 6 },
    Token { class: ^dag_token_ident, lexeme: "m", file: ^requires_edge_probe, start: 7, end: 8 },
    Token { class: ^dag_token_ident, lexeme: "resource", file: ^requires_edge_probe, start: 9, end: 17 },
    Token { class: ^dag_token_ident, lexeme: "N", file: ^requires_edge_probe, start: 18, end: 19 },
    Token { class: ^dag_token_lbrace, lexeme: "{", file: ^requires_edge_probe, start: 20, end: 21 },
    Token { class: ^dag_token_ident, lexeme: "kind", file: ^requires_edge_probe, start: 24, end: 28 },
    Token { class: ^dag_token_colon, lexeme: ":", file: ^requires_edge_probe, start: 28, end: 29 },
    Token { class: ^dag_token_ident, lexeme: "Capability", file: ^requires_edge_probe, start: 30, end: 40 },
    Token { class: ^dag_token_ident, lexeme: "mode", file: ^requires_edge_probe, start: 43, end: 47 },
    Token { class: ^dag_token_colon, lexeme: ":", file: ^requires_edge_probe, start: 47, end: 48 },
    Token { class: ^dag_token_ident, lexeme: "Read", file: ^requires_edge_probe, start: 49, end: 53 },
    Token { class: ^dag_token_rbrace, lexeme: "}", file: ^requires_edge_probe, start: 54, end: 55 },
    Token { class: ^dag_token_ident, lexeme: "service", file: ^requires_edge_probe, start: 56, end: 63 },
    Token { class: ^dag_token_ident, lexeme: "S", file: ^requires_edge_probe, start: 64, end: 65 },
    Token { class: ^dag_token_lbrace, lexeme: "{", file: ^requires_edge_probe, start: 66, end: 67 },
    Token { class: ^dag_token_ident, lexeme: "operation", file: ^requires_edge_probe, start: 70, end: 79 },
    Token { class: ^dag_token_ident, lexeme: "Op", file: ^requires_edge_probe, start: 80, end: 82 },
    Token { class: ^dag_token_lbrace, lexeme: "{", file: ^requires_edge_probe, start: 83, end: 84 },
    Token { class: ^dag_token_ident, lexeme: "requires", file: ^requires_edge_probe, start: 89, end: 97 },
    Token { class: ^dag_token_ident, lexeme: "N", file: ^requires_edge_probe, start: 98, end: 99 },
    Token { class: ^dag_token_rbrace, lexeme: "}", file: ^requires_edge_probe, start: 102, end: 103 },
    Token { class: ^dag_token_rbrace, lexeme: "}", file: ^requires_edge_probe, start: 104, end: 105 }
  ])
}

test fn requires_resource_stream_is_what_tokenize_produces_holds() -> Bool {
  supplied_stream_matches_tokenize(text: requires_resource_source, file: ^requires_edge_probe, supplied: requires_resource_stream())
}

