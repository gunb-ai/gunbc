// ONE RESOURCE NAMED TWICE, AT THE DECISION'S OWN INTERFACE (DESIGN section 3: a witness supplies the
// inputs of the one interface it discriminates). v2.compiler.resolve resolve_requirement_member_refusal_optional
// decides over resolved members and the index; the members here are supplied as the declaration
// references resolve produces for `N` and `m.N` -- one path under two labels -- and the index is the
// census index of a module that declares N. The real route through normalize and resolve stays
// exercised by a_requirement_naming_a_declared_resource_resolves_holds (a member resolving to a marked
// resource path) and a_requirement_naming_a_record_refuses_located_RED, so supplying the members here
// removes no execution of it.
data resource_only_source: String = "module m\nresource N {\n  kind: Capability\n  mode: Read\n}\n"

test fn one_resource_named_twice_is_refused_by_the_requirement_decision_RED() -> Bool {
  match census_of_stream(tokens: resource_only_stream()) {
    Rejected { diagnostics: _ } => false
    Accepted { value: t, diagnostics: _ } =>
      let index = symbol_index_fill_module_roots(index: empty_symbol_index(), roots: Cons { head: census_tree_binding_source(t: t), tail: Empty })
      let path = Cons { head: ^m, tail: Cons { head: ^N, tail: Empty } }
      let members = [
        Edge { label: Named { name: ^N }, target: declaration_reference_node(qn: path, occurrence_id: OccurrenceSynthetic) },
        Edge { label: Named { name: symbol_intern_lexeme(lexeme: "m.N") }, target: declaration_reference_node(qn: path, occurrence_id: OccurrenceSynthetic) }
      ]
      match resolve_requirement_member_refusal_optional(index: index, members: members) {
        Present { value: d } => d.reason == ^resolve_reason_requirement_repeated
        Absent => false
      }
  }
}

// The same decision admits the resource named once, so the refusal above is the repetition and not the
// member: a discriminating control at the same interface.
test fn one_resource_named_once_is_admitted_by_the_requirement_decision_holds() -> Bool {
  match census_of_stream(tokens: resource_only_stream()) {
    Rejected { diagnostics: _ } => false
    Accepted { value: t, diagnostics: _ } =>
      let index = symbol_index_fill_module_roots(index: empty_symbol_index(), roots: Cons { head: census_tree_binding_source(t: t), tail: Empty })
      let members = [Edge { label: Named { name: ^N }, target: declaration_reference_node(qn: Cons { head: ^m, tail: Cons { head: ^N, tail: Empty } }, occurrence_id: OccurrenceSynthetic) }]
      match resolve_requirement_member_refusal_optional(index: index, members: members) {
        Present { value: _ } => false
        Absent => true
      }
  }
}

fn resource_only_stream() -> TokenStream {
  token_stream_new(all: [
    Token { class: ^dag_token_kw_module, lexeme: "module", file: ^requires_edge_probe, start: 0, end: 6 },
    Token { class: ^dag_token_ident, lexeme: "m", file: ^requires_edge_probe, start: 7, end: 8 },
    Token { class: ^dag_token_ident, lexeme: "resource", file: ^requires_edge_probe, start: 9, end: 17 },
    Token { class: ^dag_token_ident, lexeme: "N", file: ^requires_edge_probe, start: 18, end: 19 },
    Token { class: ^dag_token_lbrace, lexeme: "{", file: ^requires_edge_probe, start: 20, end: 21 },
    Token { class: ^dag_token_ident, lexeme: "kind", file: ^requires_edge_probe, start: 24, end: 28 },
    Token { class: ^dag_token_colon, lexeme: ":", file: ^requires_edge_probe, start: 28, end: 29 },
    Token { class: ^dag_token_ident, lexeme: "Capability", file: ^requires_edge_probe, start: 30, end: 40 },
    Token { class: ^dag_token_ident, lexeme: "mode", file: ^requires_edge_probe, start: 43, end: 47 },
    Token { class: ^dag_token_colon, lexeme: ":", file: ^requires_edge_probe, start: 47, end: 48 },
    Token { class: ^dag_token_ident, lexeme: "Read", file: ^requires_edge_probe, start: 49, end: 53 },
    Token { class: ^dag_token_rbrace, lexeme: "}", file: ^requires_edge_probe, start: 54, end: 55 }
  ])
}

test fn resource_only_stream_is_what_tokenize_produces_holds() -> Bool {
  supplied_stream_matches_tokenize(text: resource_only_source, file: ^requires_edge_probe, supplied: resource_only_stream())
}
