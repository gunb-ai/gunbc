module v2.test.claim.complexity_contract_subject_partition_witness


// C0(c) discriminating controls: the legacy mixed lens_contract_complexity row partitions into derived-kernel (WallAfterGrounding / SingleAuthority) and optimality (RatchetForever). Positive: every legacy claim maps to exactly one subject roster and both contract rows carry the matching boundary class. RED: a derived claim classified under OptimalityResidue fails; a planted duplicate in a synthetic roster fails the no-duplicates check.
test fn complexity_contract_subjects_partition_legacy_mixed_row_holds() -> Bool {
  v2.lens.enforcement.complexity_contract_subject.complexity_contract_subjects_partition_legacy_mixed_row()
    && v2.lens.enforcement.complexity_contract_subject.complexity_derived_kernel_boundary_is_wall_after_grounding()
    && v2.lens.enforcement.complexity_contract_subject.complexity_optimality_boundary_is_ratchet_forever()
    && match lens_contract_complexity_derived_kernel.boundary.class {
      v2.lens.common.construction_justification.WallAfterGrounding { dissolves_to: std.disposition.SingleAuthority } => true
      _ => false
    }
    && match lens_contract_complexity_optimality.boundary.class {
      v2.lens.common.construction_justification.RatchetForever => true
      _ => false
    }
}

test fn derived_claim_rejects_optimality_subject_red() -> Bool {
  !v2.lens.enforcement.complexity_contract_subject.complexity_mixed_row_claim_belongs_to_subject(
    claim: v2.lens.enforcement.complexity_contract_subject.DerivedClaim { claim: v2.lens.enforcement.complexity_contract_subject.AsymptoticCostProjection },
    subject: v2.lens.enforcement.complexity_contract_subject.OptimalityResidue
  )
    && v2.lens.enforcement.complexity_contract_subject.complexity_mixed_row_claim_belongs_to_subject(
      claim: v2.lens.enforcement.complexity_contract_subject.DerivedClaim { claim: v2.lens.enforcement.complexity_contract_subject.AsymptoticCostProjection },
      subject: v2.lens.enforcement.complexity_contract_subject.DerivedKernel
    )
}

test fn optimality_claim_rejects_derived_kernel_subject_red() -> Bool {
  !v2.lens.enforcement.complexity_contract_subject.complexity_mixed_row_claim_belongs_to_subject(
    claim: v2.lens.enforcement.complexity_contract_subject.OptimalityClaim { claim: v2.lens.enforcement.complexity_contract_subject.GlobalOptimality },
    subject: v2.lens.enforcement.complexity_contract_subject.DerivedKernel
  )
    && v2.lens.enforcement.complexity_contract_subject.complexity_mixed_row_claim_belongs_to_subject(
      claim: v2.lens.enforcement.complexity_contract_subject.OptimalityClaim { claim: v2.lens.enforcement.complexity_contract_subject.GlobalOptimality },
      subject: v2.lens.enforcement.complexity_contract_subject.OptimalityResidue
    )
}

test fn complexity_scope_roster_duplicate_planted_red() -> Bool {
  !v2.lens.enforcement.complexity_contract_subject.complexity_scope_roster_has_no_duplicates(
  claim: v2.lens.enforcement.complexity_contract_subject.BoundedSummation,
  planted_duplicate: v2.lens.enforcement.complexity_contract_subject.BoundedSummation
  )
}
