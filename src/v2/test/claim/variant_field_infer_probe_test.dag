}

test fn vfp_mo_chain_has_undecidable_argument_holds() -> Bool {
  vfp_reports(reading: vfp_match_only_reading(), reason: ^inhabitance_undecidable_argument_type_not_derived)
}

test fn vfp_mo_chain_has_non_exhaustive_holds() -> Bool {
  vfp_reports(reading: vfp_match_only_reading(), reason: ^infer_match_non_exhaustive)
}

test fn vfp_mo_the_match_types_from_its_arms_holds() -> Bool {
  vfp_match_only_reading().match_fact == ^Int
}

test fn vfp_mo_the_arm_binder_types_from_the_payload_field_holds() -> Bool {
