module v2.test.claim.variant_field_infer_probe

import v2.compiler.resolve { ResolvedTree }
import v2.compiler.infer {
  ConstructIsRecord,
  ConstructIsVariantArm,
  ConstructNotARecord,
  infer,
  infer_record_construct_read,
  inferred_facts_resolved_type
}
import v2.std.qualified_name { declaration_reference_path_optional, qualified_name_last_segment }
import v2.std.witness { Holds, Violates }
import v2.compiler.name_resolve { Admission, ResolutionSubject }
import v2.compiler.program_assembly { assemble_program_from_ingest }
import v2.compiler.source_authority { DagSourceReadWitness }
import v2.extdeps.languages.dag { dag_language_model }
import extdeps.communication.medium { Lossless, Medium }
import std.algebra { Cons, Empty, list_append }
import v2.std.cross_tree.import_model { V2Tree }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.diagnostic { Accepted, NonEmptyDiagnostics, None, Outcome, Rejected, Some }
import v2.std.algebra { contains, list_map }
import v2.std.node {
  Atom,
  ComputationNode,
  CoreMarker,
  Match,
  MatchArmBodyEdge,
  Node,
  StructuralLabel,
  Symbol,
  TypeNode,
  symbol_lexeme
}
import v2.compiler.inferred_tree { ObligatedInferredTree }
import v2.std.node_query { construct_tag_optional }
import v2.std.qualified_name { qualified_name_init }
import v2.std.optional { Absent, Optional, Present }
import v2.std.text { String }
import v2.std.collection { List }
import gunbc.cli_wire { CliWireResponse, CliWirePrintable }
import std.process { ProcessExit, ExitSuccess }

data vfp_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^variant_field_infer_probe_artifact,
  file_path: "src/v2/pilot/variant_field_infer_probe_pilot.dag"
}

fn vfp_assemble(src: String) -> Outcome<ResolvedTree> {
  assemble_program_from_ingest(
    ingest: Cons {
      head: DagSourceReadWitness {
        source: Medium { carried: src, fidelity: Lossless },
        artifact: vfp_artifact,
        compilation_unit: ^variant_field_infer_probe_cu,
        source_root: V2Tree
      },
      tail: Empty
    },
    admission: Admission { subject: ResolutionSubject { name: Cons { head: ^p, tail: Empty } }, imports: Empty },
    lm: dag_language_model()
  )
}

fn vfp_reasons(r: NonEmptyDiagnostics) -> List<Symbol> {
  Cons { head: r.head.reason, tail: list_map(xs: r.tail, f: fn(d) { d.reason }) }
}

fn vfp_last(xs: List<Symbol>) -> Symbol {
  fold(xs, init: ^vfp_no_reason, f: fn(acc, x) { x })
}

fn vfp_find_match(n: Node) -> Optional<Node> {
  match n.kind {
    ComputationNode { behavior: Match } => Present { value: n }
    _ => fold(n.children, init: Absent, f: fn(acc, e) {
      match acc {
        Present { value: _ } => acc
        Absent => vfp_find_match(n: e.target)
      }
    })
  }
}

fn vfp_find_construction(n: Node) -> Optional<Node> {
  match construct_tag_optional(n: n) {
    Present { value: _ } => Present { value: n }
    Absent => fold(n.children, init: Absent, f: fn(acc, e) {
      match acc {
        Present { value: _ } => acc
        Absent => vfp_find_construction(n: e.target)
      }
    })
  }
}

fn vfp_first_arm_body_of(m: Node) -> Optional<Node> {
  fold(m.children, init: Absent, f: fn(acc, e) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        match e.label {
          StructuralLabel { label: CoreMarker { marker: MatchArmBodyEdge } } => Present { value: e.target }
          _ => Absent
        }
    }
  })
}

fn vfp_type_name(t: Node) -> Symbol {
  match declaration_reference_path_optional(node: t) {
    Present { value: path } =>
      match qualified_name_last_segment(qn: path) {
        Present { value: s } => s
        Absent => ^vfp_empty_path
      }
    Absent =>
      match t.kind {
        TypeNode { connective: Atom { identity: s } } => s
        _ => ^vfp_type_not_named
      }
  }
}


fn vfp_fact_in(inferred: ObligatedInferredTree, subject: Optional<Node>) -> Symbol {
  match subject {
    Absent => ^vfp_subject_absent
    Present { value: s } =>
      match inferred.facts.lookup(s) {
        Absent => ^vfp_no_facts
        Present { value: facts } =>
          match inferred_facts_resolved_type(facts: facts) {
            Violates { diagnostic: _ } => ^vfp_underived
            Holds { value: t } => vfp_type_name(t: t)
          }
      }
  }
}

fn vfp_reports(reading: VfpReading, reason: Symbol) -> Bool {
  contains(xs: reading.reasons, item: reason, eq: fn(a, b) { a == b })
}

fn vfp_infers(reading: VfpReading) -> Bool {
  match reading.reasons {
    Cons { head: h, tail: _ } => h == ^infers
    Empty => false
  }
}

// THE CONSTRUCT READ, DECODED: what infer_record_construct_read answers for the fixture's
// construction, read directly on the resolved tree. The variant arm is named by its declaring
// path's last segment (^Boxed when the read mints the variant row); the sentinels say where the
// read stopped instead. TEMPORARY decode instrument: goes out with the RFM retirement once the
// per-identity evidence is recorded.
fn vfp_construct_read_decode(resolved: ResolvedTree) -> Symbol {
  match vfp_find_construction(n: resolved.root) {
    Absent => ^vfp_read_subject_absent
    Present { value: node } =>
      match infer_record_construct_read(node: node, resolved: resolved) {
        ConstructIsRecord { construct: _ } => ^vfp_read_record
        ConstructIsVariantArm { construct: c } =>
          match qualified_name_last_segment(qn: c.arm_path) {
            Present { value: s } => s
            Absent => ^vfp_read_arm_path_absent
          }
        ConstructNotARecord => ^vfp_read_not_a_record
      }
  }
}

// THE CARRIER HALF OF THE SAME DECODE: what the read names as the variant's declaring coproduct
// (^Seal for the fixture) -- the field the alias mechanism exists to fill, since the tag's own
// path (the module-level alias `p.Boxed`) does not carry it. TEMPORARY: goes out with the RFM
// retirement.
fn vfp_construct_read_carrier_decode(resolved: ResolvedTree) -> Symbol {
  match vfp_find_construction(n: resolved.root) {
    Absent => ^vfp_read_subject_absent
    Present { value: node } =>
      match infer_record_construct_read(node: node, resolved: resolved) {
        ConstructIsRecord { construct: _ } => ^vfp_read_record
        ConstructIsVariantArm { construct: c } =>
          match qualified_name_last_segment(qn: c.variant_path) {
            Present { value: s } => s
            Absent => ^vfp_read_no_carrier
          }
        ConstructNotARecord => ^vfp_read_not_a_record
      }
  }
}

// WHAT THE FIXTURE ESTABLISHES, decided once per program by one nullary producer enrolled WARM in
// v2.workflow.floor_pure_producer_share. `reasons` is the whole chain in order: a resolve or infer
// refusal's reasons, or `^infers` followed by the accepted inference's advisories. A FACT field is
// the picked node's resolved type name on an accepted inference, or the sentinels where the route
// stops: ^vfp_subject_absent when the finder found nothing, ^vfp_no_facts when the node carries no
// facts, ^vfp_underived when the facts do not resolve, or the refusal's reason (the head at resolve,
// the last at infer).
type VfpReading {
  reasons: List<Symbol>
  construction_fact: Symbol
  match_fact: Symbol
  arm_body_fact: Symbol
  construct_read: Symbol
  construct_read_carrier: Symbol
}

// THE COMBINED FIXTURE'S READING: one module exercising every shape the enrolled claims measure
// (positional + named payload binders, a formal-typed payload field, a compound payload, an arrow
// payload, a monomorphic projection). ONE nullary producer so every planned claim reaches one
// closed computation identity and the derived producer-share admits it -- per-claim re-runs of
// this fill refused the enrolment margin (~609k eval steps each).
type VfpFixtureReading {
  reasons: List<Symbol>
  construct_read: Symbol
  construct_read_carrier: Symbol
  rt_construction_fact: Symbol
  rt_match_fact: Symbol
  rt_arm_fact: Symbol
  generic_arm_fact: Symbol
  projection_fact: Symbol
  compound_arm_fact: Symbol
  arrow_arm_fact: Symbol
}

// PREORDER COLLECTORS over the resolved tree: all matches, and a match's arm bodies in order.
fn vfp_matches_of(n: Node) -> List<Node> {
  match n.kind {
    ComputationNode { behavior: Match } =>
      Cons { head: n, tail: fold(n.children, init: Empty, f: fn(acc, e) { list_append(left: acc, right: vfp_matches_of(n: e.target)) }) }
    _ =>
      fold(n.children, init: Empty, f: fn(acc, e) { list_append(left: acc, right: vfp_matches_of(n: e.target)) })
  }
}

fn vfp_arm_bodies_of(m: Node) -> List<Node> {
  fold(m.children, init: Empty, f: fn(acc, e) {
    match e.label {
      StructuralLabel { label: CoreMarker { marker: MatchArmBodyEdge } } => list_append(left: acc, right: Cons { head: e.target, tail: Empty })
      _ => acc
    }
  })
}

fn vfp_first_of(xs: List<Node>) -> Optional<Node> {
  match xs {
    Cons { head: h, tail: _ } => Present { value: h }
    Empty => Absent
  }
}

fn vfp_second_of(xs: List<Node>) -> Optional<Node> {
  match xs {
    Cons { head: _, tail: t } => vfp_first_of(xs: t)
    Empty => Absent
  }
}

fn vfp_third_of(xs: List<Node>) -> Optional<Node> {
  match xs {
    Cons { head: _, tail: t } => vfp_second_of(xs: t)
    Empty => Absent
  }
}

fn vfp_fourth_of(xs: List<Node>) -> Optional<Node> {
  match xs {
    Cons { head: _, tail: t } => vfp_third_of(xs: t)
    Empty => Absent
  }
}

fn vfp_arm_body_first(m: Optional<Node>) -> Optional<Node> {
  match m {
    Absent => Absent
    Present { value: n } => vfp_first_of(xs: vfp_arm_bodies_of(n: n))
  }
}

fn vfp_arm_body_second(m: Optional<Node>) -> Optional<Node> {
  match m {
    Absent => Absent
    Present { value: n } => vfp_second_of(xs: vfp_arm_bodies_of(n: n))
  }
}

// THE EXHAUSTIVENESS CONTROL: the same carrier with one arm dropped, so the match must refuse for
// want of coverage -- decided by the single inhabitance relation, which surfaces the established
// non-exhaustive reason (the same one the inline count it replaced reported).
fn vfp_partial_reading() -> VfpReading { vfp_reading(src: vfp_partial_src) }

data vfp_partial_src: String = "module p\n\ntype Seal = Boxed(Int) | Held { value: Int }\n\nfn partial(s: Seal) -> Int {\n  match s {\n    Boxed(v) => v\n  }\n}"

data vfp_fixture_src: String = "module p\n\ntype ParseTree {\n  root: Int\n}\n\ntype NonEmptyDiagnostics {\n  head: Int\n}\n\ntype Diagnostics\n  = None\n  | Some { diagnostics: NonEmptyDiagnostics }\n\ntype Outcome<T>\n  = Accepted { value: T, diagnostics: Diagnostics }\n  | Rejected { diagnostics: NonEmptyDiagnostics }\n\ntype Box<T> = Wrapped { inner: T }\n\ntype Hold<T>\n  = Keep { boxed: Box<T> }\n  | Dropped\n\ntype Apply<T>\n  = Mk { f: fn(ParseTree) -> T }\n\ntype Seal\n  = Boxed(ParseTree)\n  | Held { value: ParseTree }\n\nfn make(n: ParseTree) -> Seal {\n  Boxed(n)\n}\n\nfn unbox(s: Seal) -> ParseTree {\n  match s {\n    Boxed(v) => v\n    Held { value: w } => w\n  }\n}\n\nfn pick(o: Outcome<ParseTree>) -> ParseTree {\n  match o {\n    Accepted { value: val } => val\n    Rejected { diagnostics: d } => d.head\n  }\n}\n\nfn unkeep(k: Hold<Box<ParseTree>>, fallback: ParseTree) -> ParseTree {\n  match k {\n    Keep { boxed: b } => b.inner\n    Dropped => fallback\n  }\n}\n\nfn useit(a: Apply<ParseTree>, n: ParseTree) -> ParseTree {\n  match a {\n    Mk { f: g } => g(n)\n  }\n}"


fn vfp_reading(src: String) -> VfpReading {
  match vfp_assemble(src: src) {
    Rejected { diagnostics: r } => VfpReading {
      reasons: vfp_reasons(r: r),
      construction_fact: r.head.reason,
      match_fact: r.head.reason,
      arm_body_fact: r.head.reason,
      construct_read: ^vfp_refused_at_resolve,
      construct_read_carrier: ^vfp_refused_at_resolve
    }
    Accepted { value: resolved, diagnostics: _ } =>
      match infer(tree: resolved) {
        Rejected { diagnostics: r } => VfpReading {
          reasons: vfp_reasons(r: r),
          construction_fact: vfp_last(xs: vfp_reasons(r: r)),
          match_fact: vfp_last(xs: vfp_reasons(r: r)),
          arm_body_fact: vfp_last(xs: vfp_reasons(r: r)),
          construct_read: vfp_construct_read_decode(resolved: resolved),
          construct_read_carrier: vfp_construct_read_carrier_decode(resolved: resolved)
        }
        Accepted { value: inferred, diagnostics: d } => VfpReading {
          reasons: match d {
            None => [^infers]
            Some { diagnostics: r } => Cons { head: ^infers, tail: vfp_reasons(r: r) }
          },
          construction_fact: vfp_fact_in(
            inferred: inferred,
            subject: vfp_find_construction(n: resolved.root)
          ),
          match_fact: vfp_fact_in(
            inferred: inferred,
            subject: vfp_find_match(n: resolved.root)
          ),
          arm_body_fact: vfp_fact_in(
            inferred: inferred,
            subject: match vfp_find_match(n: resolved.root) {
              Absent => Absent
              Present { value: m } => vfp_first_arm_body_of(m: m)
            }
          ),
          construct_read: vfp_construct_read_decode(resolved: resolved),
          construct_read_carrier: vfp_construct_read_carrier_decode(resolved: resolved)
        }
      }
  }
}

// THE COMBINED FIXTURE'S PRODUCER: matches appear in fixture declaration order -- unbox, pick,
// unkeep, useit. The first construct-tagged node in preorder is make's `Boxed(n)`.
fn vfp_fixture_reading() -> VfpFixtureReading {
  match vfp_assemble(src: vfp_fixture_src) {
    Rejected { diagnostics: r } => VfpFixtureReading {
      reasons: vfp_reasons(r: r),
      construct_read: ^vfp_refused_at_resolve,
      construct_read_carrier: ^vfp_refused_at_resolve,
      rt_construction_fact: r.head.reason,
      rt_match_fact: r.head.reason,
      rt_arm_fact: r.head.reason,
      generic_arm_fact: r.head.reason,
      projection_fact: r.head.reason,
      compound_arm_fact: r.head.reason,
      arrow_arm_fact: r.head.reason
    }
    Accepted { value: resolved, diagnostics: _ } =>
      match infer(tree: resolved) {
        Rejected { diagnostics: r } => VfpFixtureReading {
          reasons: vfp_reasons(r: r),
          construct_read: vfp_construct_read_decode(resolved: resolved),
          construct_read_carrier: vfp_construct_read_carrier_decode(resolved: resolved),
          rt_construction_fact: vfp_last(xs: vfp_reasons(r: r)),
          rt_match_fact: vfp_last(xs: vfp_reasons(r: r)),
          rt_arm_fact: vfp_last(xs: vfp_reasons(r: r)),
          generic_arm_fact: vfp_last(xs: vfp_reasons(r: r)),
          projection_fact: vfp_last(xs: vfp_reasons(r: r)),
          compound_arm_fact: vfp_last(xs: vfp_reasons(r: r)),
          arrow_arm_fact: vfp_last(xs: vfp_reasons(r: r))
        }
        Accepted { value: inferred, diagnostics: d } => VfpFixtureReading {
          reasons: match d {
            None => [^infers]
            Some { diagnostics: r } => Cons { head: ^infers, tail: vfp_reasons(r: r) }
          },
          construct_read: vfp_construct_read_decode(resolved: resolved),
          construct_read_carrier: vfp_construct_read_carrier_decode(resolved: resolved),
          rt_construction_fact: vfp_fact_in(
            inferred: inferred,
            subject: vfp_find_construction(n: resolved.root)
          ),
          rt_match_fact: vfp_fact_in(
            inferred: inferred,
            subject: vfp_first_of(xs: vfp_matches_of(n: resolved.root))
          ),
          rt_arm_fact: vfp_fact_in(
            inferred: inferred,
            subject: vfp_arm_body_first(m: vfp_first_of(xs: vfp_matches_of(n: resolved.root)))
          ),
          generic_arm_fact: vfp_fact_in(
            inferred: inferred,
            subject: vfp_arm_body_first(m: vfp_second_of(xs: vfp_matches_of(n: resolved.root)))
          ),
          projection_fact: vfp_fact_in(
            inferred: inferred,
            subject: vfp_arm_body_second(m: vfp_second_of(xs: vfp_matches_of(n: resolved.root)))
          ),
          compound_arm_fact: vfp_fact_in(
            inferred: inferred,
            subject: vfp_arm_body_first(m: vfp_third_of(xs: vfp_matches_of(n: resolved.root)))
          ),
          arrow_arm_fact: vfp_fact_in(
            inferred: inferred,
            subject: vfp_arm_body_first(m: vfp_fourth_of(xs: vfp_matches_of(n: resolved.root)))
          )
        }
      }
  }
}

// THE CLAIMS OVER THE ROUND-TRIP FIXTURE: the construction derives the carrier, its tag resolves to
// the carrier's declaration, the match types from its arms, and the arm's binder types from the
// variant's payload field. Together they are the positive control for the native route's
// variant-scrutinee inference: each names one stage, so a regression lands on one row, not four.
test fn vfp_the_construction_types_as_its_carrier_holds() -> Bool {
  vfp_fixture_reading().rt_construction_fact == ^Seal
}

test fn vfp_the_construct_read_names_the_variant_holds() -> Bool {
  vfp_fixture_reading().construct_read == ^Boxed
}

test fn vfp_the_construct_read_carrier_is_the_declaring_coproduct_holds() -> Bool {
  vfp_fixture_reading().construct_read_carrier == ^Seal
}

test fn vfp_the_match_types_from_its_arms_holds() -> Bool {
  vfp_fixture_reading().rt_match_fact == ^ParseTree
}

test fn vfp_the_arm_binder_types_from_the_payload_field_holds() -> Bool {
  vfp_fixture_reading().rt_arm_fact == ^ParseTree
}

// THE COVERAGE CONTROL: a one-arm match over a two-variant carrier must refuse, and the refusal must
// be the non-exhaustive reason the coverage obligation reports on the inhabitance relation's refusal.
test fn vfp_the_partial_match_refuses_as_not_covering_the_carrier_holds() -> Bool {
  vfp_reports(reading: vfp_partial_reading(), reason: ^infer_match_non_exhaustive)
}

// THE GENERIC COPRODUCT CONTROL: the payload binder under a formal-typed field instantiates at the
// scrutinee's argument. The arm body is `val`, whose only declared type is the variant field's raw
// formal T; the read must hold ParseTree (the instance) and never the formal. Red without
// instantiation. Its SECOND arm is the monomorphic projection control: `d.head` carries no formal
// at all, so it must read Int on any grounding-healthy run.
test fn vfp_the_generic_arm_binder_types_at_the_scrutinees_argument_holds() -> Bool {
  vfp_fixture_reading().generic_arm_fact == ^ParseTree
}

test fn vfp_the_projection_arm_types_from_the_rejected_payload_holds() -> Bool {
  vfp_fixture_reading().projection_fact == ^Int
}

// THE COMPOUND CONTROL, DECLARED RED pending deep instantiation: `b` binds `boxed: Box<T>`, but a
// pattern binder's facts are minted by the lexical facts path under the parent frame, whose
// infer_frame_instantiated substitutes shallowly -- Box<T> holds raw, so the body `b.inner` reads
// the formal and the fact is T. This row asserts the defect as it stands and goes red (flips to
// ^Int) when the follow-up lands: deep substitution inside infer_frame_instantiated (the one
// instantiation authority), with match arms a coproduct-instance frame if the facts still do not
// flow; the operand-level helper is interim there and is deleted by it.
test fn vfp_the_compound_arm_binder_still_rides_the_formal_pending_deep_instantiation() -> Bool {
  vfp_fixture_reading().compound_arm_fact == ^T
}

// THE ARROW CONTROL, DECLARED RED pending deep instantiation: `g` binds `f: fn(Int) -> T` and the
// arm body `g(x)` reads the formal for the same reason as the compound row -- the facts layer's
// shallow substitution never rewrites the Arrow's result. Asserts the defect as it stands; flips
// to ^Int with the same follow-up that deletes the interim operand helper.
test fn vfp_the_arrow_arm_binder_still_rides_the_formal_pending_deep_instantiation() -> Bool {
  vfp_fixture_reading().arrow_arm_fact == ^T
}
// THE RESOLVE-SIDE CONTROL ON THE SAME READING: even while infer refuses the partial match for
// want of coverage, resolve has already bound the construction's tag to its variant's declaring
// path -- the control separates the resolve binding (green on both sides of the fix) from the
// infer facts (red on main, green here), and gives the partial reading its second consumer under
// the warm-producer sharing conjunct.
test fn vfp_the_partial_fixture_still_mints_its_variant_row_holds() -> Bool {
  vfp_partial_reading().construct_read == ^Boxed
}

// THE BISECT FIXTURES THE LEDGER CITES (temporary; they go out when their rows' follow-ups
// land): the nullary single-arm sum the single_arm_sum_parses_as_an_alias row's 2026-10-06
// receipt cites, and the recursive record the grounding-cascade row cites.
data vfp_nullary_sum_src: String = "module p\n\ntype A = MkA\n\nfn f() -> A { MkA }"

data vfp_fx2_src: String = "module p\n\ntype N = Wrap { seed: N }\n\nfn f(a: N) -> N {\n  a\n}"

// TEMPORARY DECODE INSTRUMENT -- the one reading for the combined fixture: prints every field
// through `gunbc run --function` so the actual values are readable, not guessed. DELETED WITH THE
// RFM RETIREMENT RECEIPT.
fn vfp_decode_fixture_reading(r: VfpFixtureReading) -> CliWireResponse {
  CliWirePrintable { bytes: "read=" + symbol_lexeme(sym: r.construct_read) + " carr=" + symbol_lexeme(sym: r.construct_read_carrier) + " rt_constr=" + symbol_lexeme(sym: r.rt_construction_fact) + " rt_match=" + symbol_lexeme(sym: r.rt_match_fact) + " rt_arm=" + symbol_lexeme(sym: r.rt_arm_fact) + " gen_arm=" + symbol_lexeme(sym: r.generic_arm_fact) + " proj=" + symbol_lexeme(sym: r.projection_fact) + " comp=" + symbol_lexeme(sym: r.compound_arm_fact) + " arr=" + symbol_lexeme(sym: r.arrow_arm_fact), exit: ExitSuccess }
}

fn vfp_decode_fixture() -> CliWireResponse { vfp_decode_fixture_reading(r: vfp_fixture_reading()) }
