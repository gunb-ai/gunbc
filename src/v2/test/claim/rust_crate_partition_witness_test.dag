// Every red control below runs through resolve_partition_outcome itself, the one entry an
// assignment passes before anything may realize it: an SCC divided between units, a unit graph
// with a cycle, a module left unowned, a module the DAG does not carry, and a non-positive policy
// target each refuse with their own cause. The policy positives assert the ROUTE -- PolicyDerived
// provenance naming the resolver -- as well as the answer.

data witness_mod_a: ModuleId = "witness.scc.a" as NonEmptyStr
data witness_mod_b: ModuleId = "witness.scc.b" as NonEmptyStr
data witness_mod_c: ModuleId = "witness.scc.c" as NonEmptyStr
data witness_unit_x: CompilationUnitId = "witness-unit-x" as CompilationUnitId
data witness_unit_y: CompilationUnitId = "witness-unit-y" as CompilationUnitId

data witness_unit_p: CompilationUnitId = "witness-unit-p" as CompilationUnitId
data witness_unit_q: CompilationUnitId = "witness-unit-q" as CompilationUnitId
data witness_mod_p: ModuleId = "witness.unit.p" as NonEmptyStr
data witness_mod_q: ModuleId = "witness.unit.q" as NonEmptyStr

fn witness_triangle_scc_dag() -> ModuleDag {
  ModuleDag {
    modules: [witness_mod_a, witness_mod_b, witness_mod_c],
    edges: [
      ModuleDagEdge { from: witness_mod_a, to: witness_mod_b },
      ModuleDagEdge { from: witness_mod_b, to: witness_mod_c },
      ModuleDagEdge { from: witness_mod_c, to: witness_mod_a },
    ],
    exports: empty_map(),
    type_definitions: empty_map(),
  }
}

fn witness_forced_scc_split_assignment() -> Map<ModuleId, CompilationUnitId> {
  empty_map()
    |> map_insert(witness_mod_a, witness_unit_x)
    |> map_insert(witness_mod_b, witness_unit_x)
    |> map_insert(witness_mod_c, witness_unit_y)
}

fn witness_explicit(assignment: Map<ModuleId, CompilationUnitId>) -> PartitionParameter {
  ExplicitPartitionParam { partition: ExplicitPartition { assignment: assignment } }
}

fn witness_refused_by_rust_rule(outcome: ResolvePartitionOutcome) -> String {
  match outcome {
    ResolvePartitionRefused { cause: PartitionRustAdmissibilityRefused { cause: SccSplit { detail: _ } } } => "scc-split"
    ResolvePartitionRefused { cause: PartitionRustAdmissibilityRefused { cause: UnitGraphCycle { detail: _ } } } => "unit-graph-cycle"
    ResolvePartitionRefused { cause: PartitionRustAdmissibilityRefused { cause: LinkageCycle { detail: _ } } } => "linkage-cycle"
    ResolvePartitionRefused { cause: PartitionRustAdmissibilityRefused { cause: ByValueTypeCycle { detail: _ } } } => "by-value-type-cycle"
    ResolvePartitionRefused { cause: PolicyTargetCountNotPositive { policy: _ } } => "target-not-positive"
    ResolvePartitionRefused { cause: AssignmentOmitsModule { module_id: _ } } => "omits-module"
    ResolvePartitionRefused { cause: AssignmentNamesModuleOutsideDag { module_id: _ } } => "outside-dag"
    ResolvePartitionOk { assignment: _, provenance: _ } => "admitted"
  }
}

test fn witness_r4_refuses_forced_scc_split_holds() -> Bool {
  witness_refused_by_rust_rule(outcome: resolve_partition_outcome(
    parameter: witness_explicit(assignment: witness_forced_scc_split_assignment()),
    module_dag: witness_triangle_scc_dag()
  )) == "scc-split"
}

data witness_mod_r: ModuleId = "witness.unit.r" as NonEmptyStr
data witness_mod_s: ModuleId = "witness.unit.s" as NonEmptyStr

// Acyclic at module grain, cyclic at unit grain: p -> q crosses P -> Q and r -> s crosses Q -> P.
fn witness_crossing_module_dag() -> ModuleDag {
  ModuleDag {
    modules: [witness_mod_p, witness_mod_q, witness_mod_r, witness_mod_s],
    edges: [
      ModuleDagEdge { from: witness_mod_p, to: witness_mod_q },
      ModuleDagEdge { from: witness_mod_r, to: witness_mod_s },
    ],
    exports: empty_map(),
    type_definitions: empty_map(),
  }
}

fn witness_crossing_unit_assignment() -> Map<ModuleId, CompilationUnitId> {
  empty_map()
    |> map_insert(witness_mod_p, witness_unit_p)
    |> map_insert(witness_mod_s, witness_unit_p)
    |> map_insert(witness_mod_q, witness_unit_q)
    |> map_insert(witness_mod_r, witness_unit_q)
}

test fn witness_r4_refuses_unit_graph_cycle_holds() -> Bool {
  witness_refused_by_rust_rule(outcome: resolve_partition_outcome(
    parameter: witness_explicit(assignment: witness_crossing_unit_assignment()),
    module_dag: witness_crossing_module_dag()
  )) == "unit-graph-cycle"
}

test fn explicit_assignment_leaving_a_module_unowned_refuses() -> Bool {
  witness_refused_by_rust_rule(outcome: resolve_partition_outcome(
    parameter: witness_explicit(assignment: empty_map()
      |> map_insert(witness_mod_p, witness_unit_p)
      |> map_insert(witness_mod_q, witness_unit_q)
      |> map_insert(witness_mod_r, witness_unit_q)),
    module_dag: witness_crossing_module_dag()
  )) == "omits-module"
}

test fn explicit_assignment_naming_a_module_outside_the_dag_refuses() -> Bool {
  witness_refused_by_rust_rule(outcome: resolve_partition_outcome(
    parameter: witness_explicit(assignment: witness_forced_scc_split_assignment() |> map_insert(witness_mod_p, witness_unit_x)),
    module_dag: witness_triangle_scc_dag()
  )) == "outside-dag"
}

test fn policy_target_below_one_refuses() -> Bool {
  witness_refused_by_rust_rule(outcome: resolve_partition_outcome(
    parameter: PolicyPartitionParam { policy: PartitionPolicy { target_crate_count: 0 } },
    module_dag: witness_crossing_module_dag()
  )) == "target-not-positive"
}

// A chain with one cycle in the middle: e -> d -> {c <-> b} -> a. Five modules, two targets.
data witness_chain_a: ModuleId = "witness.chain.a" as NonEmptyStr
data witness_chain_b: ModuleId = "witness.chain.b" as NonEmptyStr
data witness_chain_c: ModuleId = "witness.chain.c" as NonEmptyStr
data witness_chain_d: ModuleId = "witness.chain.d" as NonEmptyStr
data witness_chain_e: ModuleId = "witness.chain.e" as NonEmptyStr

fn witness_chain_dag(edges: List<ModuleDagEdge>) -> ModuleDag {
  ModuleDag {
    modules: [witness_chain_a, witness_chain_b, witness_chain_c, witness_chain_d, witness_chain_e],
    edges: edges,
    exports: empty_map(),
    type_definitions: empty_map(),
  }
}

fn witness_chain_edges() -> List<ModuleDagEdge> {
  [
    ModuleDagEdge { from: witness_chain_e, to: witness_chain_d },
    ModuleDagEdge { from: witness_chain_d, to: witness_chain_c },
    ModuleDagEdge { from: witness_chain_c, to: witness_chain_b },
    ModuleDagEdge { from: witness_chain_b, to: witness_chain_c },
    ModuleDagEdge { from: witness_chain_b, to: witness_chain_a },
  ]
}

fn witness_policy_two() -> PartitionParameter {
  PolicyPartitionParam { policy: PartitionPolicy { target_crate_count: 2 } }
}

fn witness_owner(assignment: Map<ModuleId, CompilationUnitId>, module_id: ModuleId) -> String {
  match map_get(assignment, module_id) {
    Accepted { value: Present { value: unit }, diagnostics: _ } => unit as String
    Accepted { value: Absent, diagnostics: _ } => "unowned"
    Rejected { diagnostics: _ } => "unowned"
  }
}

// The positive control, and the route: the policy arm admits, stamps PolicyDerived naming the
// resolver, gives every module an owner, keeps the cycle {b, c} in one unit, and puts the
// dependency end of the chain in the first unit. Five modules over two units is a quota of three:
// a, then {b, c}, fill the first unit; d and e open the second.
test fn policy_partition_admits_a_balanced_acyclic_assignment() -> Bool {
  match resolve_partition_outcome(parameter: witness_policy_two(), module_dag: witness_chain_dag(edges: witness_chain_edges())) {
    ResolvePartitionOk { assignment: assignment, provenance: PolicyDerived { policy: policy } } =>
      (policy.decl_name as String) == "policy_partition_assignment"
        && witness_owner(assignment: assignment, module_id: witness_chain_a) == "policy-unit-0"
        && witness_owner(assignment: assignment, module_id: witness_chain_b) == "policy-unit-0"
        && witness_owner(assignment: assignment, module_id: witness_chain_c) == "policy-unit-0"
        && witness_owner(assignment: assignment, module_id: witness_chain_d) == "policy-unit-1"
        && witness_owner(assignment: assignment, module_id: witness_chain_e) == "policy-unit-1"
    ResolvePartitionOk { assignment: _, provenance: HandExplicit } => false
    ResolvePartitionRefused { cause: _ } => false
  }
}

// The mutation control: one import edge is added, and the assignment the resolver derives must
// move with it. a -> e closes the whole chain into one cycle, so the resolver may no longer split
// it and every module shares e's owner -- where the unmutated positive control puts a and e in
// different units. A resolver that ignored its edges would read the positive control's owners and
// fail here.
test fn a_mutated_import_edge_moves_the_policy_assignment() -> Bool {
  let mutated = witness_chain_edges() |> list_push(ModuleDagEdge { from: witness_chain_a, to: witness_chain_e })
  match resolve_partition_outcome(parameter: witness_policy_two(), module_dag: witness_chain_dag(edges: mutated)) {
    ResolvePartitionOk { assignment: assignment, provenance: _ } =>
      witness_owner(assignment: assignment, module_id: witness_chain_a) == witness_owner(assignment: assignment, module_id: witness_chain_e)
        && witness_owner(assignment: assignment, module_id: witness_chain_b) == witness_owner(assignment: assignment, module_id: witness_chain_e)
    ResolvePartitionRefused { cause: _ } => false
  }
}

test fn witness_partition_perturbation_member_coverage_holds() -> Bool {
  let coverage_same = stage0_partition_member_coverage_consistent(
    left: stage0_single_crate_fold_outcome(),
    right: stage0_partition_receipt_outcome
  )
  perturbation_consistent(
    reading: ForwardSameInSameOut,
    output_responded: !coverage_same
  )
}

test fn witness_interim_physical_crate_count_holds() -> Bool {
  stage0_physical_crate_count() == rust_crate_partition_declared_core_target
}

test fn witness_interim_module_bearing_unit_count_holds() -> Bool {
  stage0_module_bearing_unit_count() == rust_crate_partition_module_bearing_unit_target
}

test fn witness_interim_provenance_is_hand_explicit_holds() -> Bool {
  match stage0_partition_provenance() {
    HandExplicit => true
    PolicyDerived { policy: _ } => false
  }
}

test fn witness_provenance_distinct_from_policy_derived_holds() -> Bool {
  let explicit = partition_provenance_hand_explicit()
  let derived = partition_provenance_policy_derived(
    policy: DeclarationRef {
      module_path: "v2.workflow.rust_crate_partition" as NonEmptyStr,
      decl_name: "resolve_partition" as NonEmptyStr,
      field: WholeDeclaration,
    }
  )
  !partition_provenance_eq(left: explicit, right: derived)
}

test fn witness_runtime_unit_members_holds() -> Bool {
  match stage0_partition_receipt_outcome {
    Stage0PartitionReceiptOk { units: units } =>
      match partition_unit_by_id(units: units, unit_id: stage0_unit_runtime) {
        Present { value: unit } =>
          (unit.members |> count) == 1
        Absent => false
      }
    Stage0PartitionReceiptResolveRefused { cause: _ } => false
    Stage0PartitionReceiptFoldRefused { cause: _ } => false
  }
}

// THIS WAS `== 9` AND THE 9 WAS THE WHOLE ASSERTION, which is why it is not `== 10` now.
// #9689 added three modules to stage0 and the v1-infer roster gained one of them
// (gunbc_rust_source_type_bindings), so the literal went stale the moment the roster it
// measures changed -- and the only available repair for a literal is to retype it, which
// DESIGN section 5 names exactly: if automating the update collapses the assertion to
// measure() == measure(), the manual update was the test's entire content.
//
// The join below is not that collapse, and the reason is which side each half comes from.
// stage0_v1_infer_modules() is the DECLARED roster, a list in the partition authority.
// unit.members is what came back through stage0_assign_modules_to_unit and then through
// partition_fold_outcome -- the assignment map keyed by ModuleId, folded and grouped. So
// this asserts the fold routed exactly the declared modules to this unit and invented,
// dropped and misfiled none, which is a property of the plumbing rather than of the list.
// It is honest about its blind spot: an error in the ROSTER ITSELF is invisible here, as it
// was to the count, because both sides then move together. That class is the required build
// lane's (gunbc.repo_self_build repo_self_build_partition_crates_command), where rustc is
// the oracle.
//
// The sibling unit witnesses still carry count literals with the same defect. They are left
// alone deliberately: this one is converted because this change broke it, and converting the
// rest is a separate diff rather than a rider on an unbreak.
test fn witness_v1_infer_unit_members_holds() -> Bool {
  match stage0_partition_receipt_outcome {
    Stage0PartitionReceiptOk { units: units } =>
      match partition_unit_by_id(units: units, unit_id: stage0_unit_v1_infer) {
        Present { value: unit } => {
          let declared = stage0_v1_infer_modules()
            |> map(basename => stage0_module_id(basename: basename))
          (unit.members |> count) == (declared |> count)
            && declared |> all(d => unit.members |> any(m => m == d))
            && unit.members |> all(m => declared |> any(d => d == m))
        }
        Absent => false
      }
    Stage0PartitionReceiptResolveRefused { cause: _ } => false
    Stage0PartitionReceiptFoldRefused { cause: _ } => false
  }
}

test fn witness_v1_artifact_unit_members_holds() -> Bool {
  match stage0_partition_receipt_outcome {
    Stage0PartitionReceiptOk { units: units } =>
      match partition_unit_by_id(units: units, unit_id: stage0_unit_v1_artifact) {
        Present { value: unit } =>
          (unit.members |> count) == 2
        Absent => false
      }
    Stage0PartitionReceiptResolveRefused { cause: _ } => false
    Stage0PartitionReceiptFoldRefused { cause: _ } => false
  }
}

test fn witness_partition_fold_unit_count_holds() -> Bool {
  stage0_partition_fold_ok()
}

test fn witness_partition_r4_valid_on_interim_holds() -> Bool {
  stage0_partition_r4_valid()
}

test fn witness_resolve_partition_explicit_returns_assignment_holds() -> Bool {
  match resolve_partition_outcome(parameter: stage0_partition_parameter(), module_dag: stage0_module_dag) {
    ResolvePartitionOk { assignment: resolved, provenance: _ } => {
      let expected = stage0_interim_explicit_assignment()
      (resolved |> count) == (expected |> count)
    }
    ResolvePartitionRefused { cause: _ } => false
  }
}

test fn witness_stage0_partition_row_lookups_resolved_holds() -> Bool {
  stage0_partition_row_lookups_resolved()
}


test fn witness_stage0_module_dag_interface_grounding_debt_declared_holds() -> Bool {
  stage0_module_dag_interface_grounding_is_debt()
}


