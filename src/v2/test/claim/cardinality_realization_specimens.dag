module v2.test.claim.cardinality_realization_specimens

import extdeps.languages.json.parse {
  FieldAbsent,
  FieldMalformed,
  FieldRead,
  JsonDocumentParsed,
  JsonDocumentUnreadable,
  JsonFieldRead,
  JsonMemberMissing,
  JsonMemberNull,
  JsonMemberPresence,
  JsonMemberUnreadable,
  JsonMemberValue,
  json_field_string,
  json_member_presence,
  parse_json_document
}
import extdeps.languages.json.emit { JsonNull, JsonValue }
import std.algebra { FreeMonoid, length }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.optional { Absent, Optional, Present }
import v2.std.integer { Int }
import v2.std.text { String }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE NINE CONTROLLED SPECIMENS of roadmap node cardinality-realization-conformance, each reduced
// to ONE Int tag by an elimination that keeps every distinction the specimen exists to test, so two
// specimens that a realization conflates read as one tag and the pairwise claim reds. This module
// covers the EVALUATOR PATH ONLY. The Rust emit path and the native v2 route are an OPEN FRONTIER
// of roadmap node cardinality-realization-conformance, not covered here: no `gunbc test <label>`
// re-derives them yet, and their one-off observations are PR evidence, not an instrument. Trigger:
// a TargetModel realization-support row keyed by (target, shape), whose consumer executes these
// nine specimens on each path or refuses explicitly. Until then the rung is the minimum across paths.
//   1 Absent                      2 Present(Absent)              3 Present(Present(7))
//   4 absent collection           5 present empty collection     6 present collection of absent entries
//   7 foreign member missing      8 foreign member present with null   9 foreign member present, invalid value

fn specimen_absent() -> Optional<Int> { Absent }

fn specimen_present_absent() -> Optional<Optional<Int>> { Present { value: Absent } }

fn specimen_present_present() -> Optional<Optional<Int>> { Present { value: Present { value: 7 } } }

fn specimen_absent_collection() -> Optional<FreeMonoid<Int>> { Absent }

fn specimen_present_empty_collection() -> Optional<FreeMonoid<Int>> { Present { value: [] } }

fn specimen_present_absent_entries() -> Optional<FreeMonoid<Optional<Int>>> { Present { value: [Absent] } }

fn tag_flat(x: Optional<Int>) -> Int {
  match x {
    Absent => 1
    Present { value: _ } => 3
  }
}

fn tag_nested(x: Optional<Optional<Int>>) -> Int {
  match x {
    Absent => 10
    Present { value: inner } =>
      match inner {
        Absent => 20
        Present { value: v } => 30 + v
      }
  }
}

fn tag_collection(x: Optional<FreeMonoid<Int>>) -> Int {
  match x {
    Absent => 40
    Present { value: xs } => 50 + length(xs: xs)
  }
}

fn tag_entries(x: Optional<FreeMonoid<Optional<Int>>>) -> Int {
  match x {
    Absent => 60
    Present { value: xs } => 70 + length(xs: xs)
  }
}

fn json_object_a(text: String) -> JsonValue {
  match parse_json_document(s: text) {
    JsonDocumentParsed { value: v } => v
    JsonDocumentUnreadable { gap: _ } => JsonNull
  }
}

fn tag_presence(p: JsonMemberPresence) -> Int {
  match p {
    JsonMemberMissing => 80
    JsonMemberNull => 81
    JsonMemberValue { value: _ } => 82
    JsonMemberUnreadable { cause: _ } => 83
  }
}

fn tag_field(r: JsonFieldRead<String>) -> Int {
  match r {
    FieldAbsent => 90
    FieldRead { value: _ } => 91
    FieldMalformed { cause: _ } => 92
  }
}

// THE NINE TAGS, specimen 7 to 9 read through json_member_presence, which keeps wire null apart
// from a missing member; specimen 9 is a number where a string was asked for.
fn specimen_tags() -> FreeMonoid<Int> {
  [
    tag_flat(x: specimen_absent()),
    tag_nested(x: specimen_present_absent()),
    tag_nested(x: specimen_present_present()),
    tag_collection(x: specimen_absent_collection()),
    tag_collection(x: specimen_present_empty_collection()),
    tag_entries(x: specimen_present_absent_entries()),
    tag_presence(p: json_member_presence(obj: json_object_a(text: "{}"), key: "a")),
    tag_presence(p: json_member_presence(obj: json_object_a(text: "{\"a\":null}"), key: "a")),
    tag_field(r: json_field_string(obj: json_object_a(text: "{\"a\":5}"), key: "a"))
  ]
}

test fn nested_absence_keeps_its_depth() -> Bool {
  tag_nested(x: specimen_present_absent()) == 20
    && tag_nested(x: specimen_present_present()) == 37
    && tag_flat(x: specimen_absent()) == 1
}

test fn absent_collection_is_not_empty_collection_and_entries_keep_their_count() -> Bool {
  tag_collection(x: specimen_absent_collection()) == 40
    && tag_collection(x: specimen_present_empty_collection()) == 50
    && tag_entries(x: specimen_present_absent_entries()) == 71
}

test fn foreign_missing_null_and_invalid_stay_three_answers() -> Bool {
  specimen_tags() == [1, 20, 37, 40, 50, 71, 80, 81, 92]
}

// THE DISCRIMINATING CONTROL: a realization that flattened Present(Absent) to Absent, or read an
// absent collection as an empty one, or a JSON null as a missing member, would give the neighbouring
// specimen's tag. json_field_string's null reading is the DECLARED collapse (its own policy), so it
// is asserted as such, beside, and is not a loss.
test fn the_collapsing_readings_differ_from_the_specimens() -> Bool {
  tag_nested(x: Absent) != tag_nested(x: specimen_present_absent())
    && tag_collection(x: Absent) != tag_collection(x: specimen_present_empty_collection())
    && tag_presence(p: JsonMemberMissing) != tag_presence(p: JsonMemberNull)
    && tag_field(r: json_field_string(obj: json_object_a(text: "{\"a\":null}"), key: "a")) == 90
}
