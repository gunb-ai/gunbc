module v2.test.claim.use_site_verdict_test

import v2.compiler.use_site_verdict {
  Borrow,
  CloneShared,
  MoveField,
  MoveWhole,
  Unclassified,
  UseSiteVerdict,
  VerdictAbsent,
  VerdictFound,
  attach_use_site_verdict,
  use_site_verdict_lookup
}
import v2.std.node { Behavior, ComputationNode, Node, Value, node_synthetic }

fn bare_occurrence_node() -> Node {
  node_synthetic(kind: ComputationNode { behavior: Value }, children: [])
}

fn round_trips(verdict: UseSiteVerdict) -> Bool {
  let decorated = attach_use_site_verdict(node: bare_occurrence_node(), verdict: verdict)
  match use_site_verdict_lookup(node: decorated) {
    VerdictFound { verdict: found } => use_site_verdict_eq(a: found, b: verdict)
    _ => false
  }
}

fn use_site_verdict_eq(a: UseSiteVerdict, b: UseSiteVerdict) -> Bool {
  match a {
    MoveWhole => match b { MoveWhole => true, _ => false }
    Borrow => match b { Borrow => true, _ => false }
    CloneShared => match b { CloneShared => true, _ => false }
    Unclassified => match b { Unclassified => true, _ => false }
    MoveField { field: fa } =>
      match b {
        MoveField { field: fb } => fa == fb
        _ => false
      }
  }
}

test fn use_site_verdict_round_trips_every_variant() -> Bool {
  round_trips(verdict: MoveWhole)
    && round_trips(verdict: Borrow)
    && round_trips(verdict: CloneShared)
    && round_trips(verdict: Unclassified)
    && round_trips(verdict: MoveField { field: ^seen })
}

test fn use_site_verdict_absent_edge_is_distinguishable_from_unclassified() -> Bool {
  match use_site_verdict_lookup(node: bare_occurrence_node()) {
    VerdictAbsent => true
    _ => false
  }
}
