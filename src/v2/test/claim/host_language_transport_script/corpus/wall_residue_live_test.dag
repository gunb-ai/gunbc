module v2.test.host_language_transport_script.corpus.wall_residue_live


data wall_residue_live_note: String = "§5.E wall activation (operator ruling 2026-07-24): the previously-inert host_language_transport_script lens is wired as a per-PR live consumer over the shell.Exec.Run anchor sites that route host/foreign shell bodies through the RetainedShellScript record wall + the retained_* counted bridges. Each site must carry ZERO literal-blob transport-script positions: after the wall every script body is either a RetainedShellScript row or a retained_foreign/retained_runtime/retained_transport call (ComputedApplication, deliberately green — the counted, reviewed path), never a bare/let/interp literal typed directly at Exec.Run. A NEW raw literal at any enrolled Run position reds this witness. Disposition is ReadsLiveTree: the lens re-reads module source text by path (parse_module_items_for_transport_script), reaching outside a root lens's hermetic compiled-tree input, so it is stamped live and never predict-skips per the CI floor's host/live-tree rule."

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data wall_residue_roster_note: String = "The roster is the non-test corpus set of shell.Exec.Run anchor sites carrying host/foreign shell bodies (the residue the wall governs). A new file with an Exec.Run script position must be added here — an unenrolled Run site is a counted review gap, not silent coverage. The already-covered dag/tools/*_transport.dag + src/v2/workflow/*_transport.dag emit carve-outs stay in the sibling migrated_transports_clean witness."

test fn residue_host_effect_realize_clean() -> Bool {
  transport_script_live_literal_violation_count_for_path(
    path: "dag/gunbc/host_effect_realize.dag"
  ) == 0
}

