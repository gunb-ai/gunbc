data red_control_note: String = "RED control: the planted bare-literal fixture MUST flag > 0 so a green residue roster is never vacuously green — it proves the live scan actually detects a raw literal at an Exec.Run position. If this goes to 0 the scanner has gone blind and every clean-holds above is meaningless."

test fn red_control_planted_bare_literal_flags() -> Bool {
  transport_script_live_literal_violation_count_for_path(
    path: "src/v2/test/fixture/transport_script_scan/bare_string_literal/plant.dag"
  ) > 0
}
