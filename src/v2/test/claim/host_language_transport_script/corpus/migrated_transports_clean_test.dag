module v2.test.host_language_transport_script.corpus.migrated_transports_clean

import v2.lens.host_language_transport_script {
  transport_script_live_literal_violation_count_for_path
}
import v2.std.logic { Bool }

test fn corpus_dag_compile_clean_transport_clean_holds() -> Bool {
  transport_script_live_literal_violation_count_for_path(
    path: "dag/tools/dag_compile_clean_transport.dag"
  ) == 0
}

