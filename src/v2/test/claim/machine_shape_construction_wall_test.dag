module v2.test.claim.machine_shape_construction_wall

import std.occurrence_identity { OccurrenceSynthetic }
import v2.compiler.reference_conservation_admission { conservation_subject_of_text, conserved_normalize, no_explained_drops }
import v2.compiler.reference_conservation { ReferenceConservationSubject }
import v2.lens.machine_shape { machine_shape_compile_gate }
import v2.std.diagnostic { Accepted, NonEmptyDiagnostics, Outcome, Rejected, bind_outcome }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  ComputationNode,
  Conj,
  Edge,
  Node,
  Positional,
  Symbol,
  Transform,
  TypeNode,
}
import v2.std.witness { Witness }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// RED/GREEN controls for MachineShape single-constructor compile gate (synthetic fixtures). A
// Transform call with callee Atom ^MachineShape is unsanctioned outside std.machine_shape and
// extdeps.*.machine_shape; ^shape_from_catalog is the sanctioned producer path.

fn ms_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: [],
    occurrence_id: OccurrenceSynthetic
  }
}

fn ms_positional(target: Node) -> Edge {
  Edge { label: Positional, target: target }
}

fn ms_call(callee: Symbol, arg: Node) -> Node {
  Node {
    kind: ComputationNode { behavior: Transform },
    children: [ms_positional(target: ms_atom(id: callee)), ms_positional(target: arg)],
    occurrence_id: OccurrenceSynthetic
  }
}

fn machine_shape_literal_fixture() -> Node {
  ms_call(
    callee: ^MachineShape,
    arg: Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: OccurrenceSynthetic
    }
  )
}

fn shape_from_catalog_call_fixture() -> Node {
  ms_call(callee: ^shape_from_catalog, arg: ms_atom(id: ^machine_shape_wall_fixture_input))
}

fn non_empty_contains_reason(d: NonEmptyDiagnostics, reason: Symbol) -> Bool {
  if d.head.reason == reason {
    true
  } else {
    fold(d.tail, init: false, f: fn(acc, diag) {
      acc || (diag.reason == reason)
    })
  }
}

fn gate_accepts(o: Outcome<Witness<Node>>) -> Bool {
  match o {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn gate_red_synthetic_machine_shape_call() -> Bool {
  match machine_shape_compile_gate(node: machine_shape_literal_fixture()) {
    Rejected { diagnostics: d } =>
      non_empty_contains_reason(d: d, reason: ^machine_shape_unsanctioned_construction)
    Accepted { value: _, diagnostics: _ } => false
  }
}

test fn gate_green_synthetic_shape_from_catalog_call() -> Bool {
  gate_accepts(o: machine_shape_compile_gate(node: shape_from_catalog_call_fixture()))
}

// ---- PRODUCTION-FED: the record-literal spelling, parsed and normalized from real source. ----
// Until MQ-2 (gunbc#12202) the gate read only the call spelling, so this literal passed unseen:
// `MachineShape { .. }` lowers to a construct, not an application.

data machine_shape_record_literal_source: String = "module wall.forge\n\nfn forged() -> MachineShape = MachineShape { cores: 1 }\n"

data machine_shape_record_literal_home_source: String = "module std.machine_shape\n\nfn made() -> MachineShape = MachineShape { cores: 1 }\n"

data machine_shape_destructured_source: String = "module wall.forge\n\nfn read(s: MachineShape) -> Int = match s {\n  MachineShape { cores: c } => c\n}\n"

// Nullary and pure, enrolled WARM in v2.workflow.floor_pure_producer_share: the parse and normalize
// of each fixture source are paid once, and each claim is charged only the admitted conservation
// route and the gate walk it names (the route v2.test.claim.body_lowering_block_body_call uses).
fn machine_shape_record_literal_subject() -> ReferenceConservationSubject {
  conservation_subject_of_text(path: "machine_shape_wall_record_literal", text: machine_shape_record_literal_source)
}

fn machine_shape_record_literal_home_subject() -> ReferenceConservationSubject {
  conservation_subject_of_text(path: "machine_shape_wall_record_literal_home", text: machine_shape_record_literal_home_source)
}

fn machine_shape_destructured_subject() -> ReferenceConservationSubject {
  conservation_subject_of_text(path: "machine_shape_wall_destructured", text: machine_shape_destructured_source)
}

fn gate_over_subject(subject: ReferenceConservationSubject) -> Outcome<Witness<Node>> {
  match conserved_normalize(subject: subject, explained: no_explained_drops()) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: tree, diagnostics: _ } => machine_shape_compile_gate(node: tree.root)
  }
}

test fn gate_red_machine_shape_record_literal_outside_its_home() -> Bool {
  match gate_over_subject(subject: machine_shape_record_literal_subject()) {
    Rejected { diagnostics: d } =>
      non_empty_contains_reason(d: d, reason: ^machine_shape_unsanctioned_construction)
    Accepted { value: _, diagnostics: _ } => false
  }
}

test fn gate_green_machine_shape_record_literal_in_its_home() -> Bool {
  gate_accepts(o: gate_over_subject(subject: machine_shape_record_literal_home_subject()))
}

test fn gate_green_machine_shape_destructuring_pattern() -> Bool {
  gate_accepts(o: gate_over_subject(subject: machine_shape_destructured_subject()))
}

