fn kpy_pre() -> String {
  "module p\n\ntype Resolution\n  = Static\n  | Pointer\n\ntype Box<n: Resolution> = Int\n\nfn mk8() -> Box<8> {\n  0\n}\n\n"
}
test fn kpy_kinded_no_body_read_runs() -> Bool { kpt_runs(src: concat(kpy_pre(), "fn constant<bits: Resolution>(x: Box<bits>) -> Int {\n  3\n}\n\nfn consumer() -> Int {\n  constant(x: mk8())\n}\n"), name: ^constant) }
test fn kpy_mk8_runs() -> Bool { kpt_runs(src: concat(kpy_pre(), "fn consumer() -> Int {\n  3\n}\n"), name: ^mk8) }
test fn kpy_box_param_nongeneric_runs() -> Bool { kpt_runs(src: concat(kpy_pre(), "fn take(x: Box<8>) -> Int {\n  3\n}\n\nfn consumer() -> Int {\n  take(x: mk8())\n}\n"), name: ^take) }
test fn kpy_unkinded_box_runs() -> Bool { kpt_runs(src: "module p\n\ntype Box<n> = Int\n\nfn mk8() -> Box<8> {\n  0\n}\n\nfn constant<n>(x: Box<n>) -> Int {\n  3\n}\n\nfn consumer() -> Int {\n  constant(x: mk8())\n}\n", name: ^constant) }

fn kpz_unkinded_src() -> String {
  "module p\n\ntype Box<n> = Int\n\nfn mk8() -> Box<8> {\n  0\n}\n\nfn constant<n>(x: Box<n>) -> Int {\n  3\n}\n\nfn consumer() -> Int {\n  constant(x: mk8())\n}\n"
}
fn kpz_infer_clean(src: String) -> Bool {
  match cref_assemble(src: src) {
    Rejected { diagnostics: _ } => false
    Accepted { value: resolved, diagnostics: _ } =>
      match infer(tree: resolved) {
        Rejected { diagnostics: _ } => false
        Accepted { value: _, diagnostics: d } => infer_diagnostics_none(d: d)
      }
  }
}
fn kpz_call_grounded(src: String, name: Symbol) -> Bool {
  match cref_inferred_of(o: cref_assemble(src: src)) {
    Absent => false
    Present { value: tree } =>
      match cref_the_call_to(root: tree.root, name: name) {
        Absent => false
        Present { value: call } =>
          match tree.facts.lookup(call) {
            Absent => false
            Present { value: facts } => inferred_facts_grounding_derived(facts: facts)
          }
      }
  }
}
test fn kpz_unkinded_infer_clean() -> Bool { kpz_infer_clean(src: kpz_unkinded_src()) }
test fn kpz_unkinded_call_grounded() -> Bool { kpz_call_grounded(src: kpz_unkinded_src(), name: ^constant) }
test fn kpz_alias_kinded_infer_clean() -> Bool { kpz_infer_clean(src: kpw_src()) }
test fn kpz_alias_kinded_call_grounded() -> Bool { kpz_call_grounded(src: kpw_src(), name: ^width_of) }
test fn kpz_take_call_grounded() -> Bool { kpz_call_grounded(src: concat(kpy_pre(), "fn take(x: Box<8>) -> Int {\n  3\n}\n\nfn consumer() -> Int {\n  take(x: mk8())\n}\n"), name: ^take) }

test fn kpq2_bare_type_param_call_grounded() -> Bool { kpz_call_grounded(src: "module p\n\nfn id<t>(x: t) -> Int {\n  3\n}\n\nfn consumer() -> Int {\n  id(x: 3)\n}\n", name: ^id) }
test fn kpq2_list_of_param_call_grounded() -> Bool { kpz_call_grounded(src: "module p\n\nfn f<t>(x: List<t>) -> Int {\n  3\n}\n\nfn consumer() -> Int {\n  f(x: [1])\n}\n", name: ^f) }
test fn kpq2_record_kinded_call_grounded() -> Bool { kpz_call_grounded(src: concat(kpe_prelude(), "fn constant<bits: Resolution>(x: Box<bits>) -> Int {\n  3\n}\n\nfn consumer() -> Int {\n  constant(x: mk8())\n}\n"), name: ^constant) }
test fn kpq2_record_unkinded_call_grounded() -> Bool { kpz_call_grounded(src: "module p\n\ntype Box<n> {\n  v: Int\n}\n\nfn mk() -> Box<Int> {\n  Box { v: 0 }\n}\n\nfn constant<n>(x: Box<n>) -> Int {\n  3\n}\n\nfn consumer() -> Int {\n  constant(x: mk())\n}\n", name: ^constant) }

fn kpr2_src() -> String {
  "module p\n\ntype Resolution\n  = Static\n  | Pointer\n\ntype Box<n: Resolution> = Int where bx_any\n\nfn bx_any(value: Int) -> Bool {\n  true\n}\n\nfn mk8() -> Box<8> {\n  0\n}\n\nfn width_of<bits: Resolution>(x: Box<bits>) -> Int {\n  bits\n}\n\nfn consumer() -> Int {\n  width_of(x: mk8())\n}\n"
}
test fn kpr2_assembles() -> Bool { match cref_inferred_of(o: cref_assemble(src: kpr2_src())) { Present { value: _ } => true
  Absent => false } }
test fn kpr2_call_grounded() -> Bool { kpz_call_grounded(src: kpr2_src(), name: ^width_of) }
test fn kpr2_is_8() -> Bool { kpe_int_of(r: cref_eval_of_call_to(o: cref_assemble(src: kpr2_src()), name: ^width_of)) == Present { value: 8 } }

fn kps2_src() -> String {
  "module p\n\ntype Resolution\n  = Static\n  | Pointer\n\ntype Box<n: Resolution> {\n  v: Int\n}\n\nfn mk8() -> Box<8> {\n  let r = Box { v: 0 }\n  r\n}\n\nfn width_of<bits: Resolution>(x: Box<bits>) -> Int {\n  bits\n}\n\nfn consumer() -> Int {\n  width_of(x: mk8())\n}\n"
}
