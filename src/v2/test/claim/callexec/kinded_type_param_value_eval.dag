fn kpa_reason() -> Optional<Symbol> {
  match cref_eval_of_call_to(o: cref_assemble(src: kps2_src()), name: ^width_of) {
    Present { value: Rejected { diagnostics: d } } => Present { value: diagnostics_fatal_reason(d: d) }
    _ => Absent
