test fn kpx_bind_value_absent() -> Bool { kpx_reason() == Present { value: ^eval_rejected_bind_value_absent } }
test fn kpx_invalid_node() -> Bool { kpx_reason() == Present { value: ^eval_rejected_invalid_node } }
test fn kpx_callee_absent() -> Bool { kpx_reason() == Present { value: ^eval_rejected_callee_absent } }
test fn kpx_grounding_node_mismatch() -> Bool { kpx_reason() == Present { value: ^eval_rejected_grounding_node_mismatch } }
test fn kpx_resolved_type_mismatch() -> Bool { kpx_reason() == Present { value: ^eval_rejected_resolved_type_mismatch } }
