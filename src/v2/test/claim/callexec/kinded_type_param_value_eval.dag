module v2.test.claim.callexec.kinded_type_param_value_eval

import v2.compiler.resolve { ResolvedTree }
import v2.compiler.infer { infer, infer_diagnostics_none, inferred_facts_grounding_derived }
import v2.extdeps.runtimes.v2_evaluator { v2_eval_is_literal_shaped_node }
import v2.std.inhabitance { type_variable_instance_lookup }
import v2.test.claim.callexec.declaration_reference_eval {
  cref_assemble,
  cref_eval_of_call_to,
  cref_inferred_of,
  cref_the_call_to,
  cref_value_int_optional
}
import v2.std.diagnostic { Accepted, Outcome, Rejected, diagnostics_fatal_reason }
import std.optional { Absent, Optional, Present }
import std.algebra { Empty }
import v2.std.runtime { RuntimeValue }
import v2.std.integer { Int }

// A KINDED TYPE PARAMETER IS A VALUE OF ITS FN'S BODY, EVALUATED (A0-1a). Real path: assemble, resolve,
// infer, eval of one call. The instance eval binds is the one infer solved for that call
// (InferredFacts.type_instances), keyed by the binder's declaring path, so each row below discriminates
// a different way the binding could be wrong: a made-up default, a type argument read as a value, a body
// let capturing the binder.
fn kpe_prelude() -> String {
  "module p\n\ntype Resolution\n  = Static\n  | Pointer\n\ntype Box<n: Resolution> {\n  v: Int\n}\n\nfn mk8() -> Box<8> {\n  Box { v: 0 }\n}\n\n"
}

fn kpe_eval(body: String, name: Symbol) -> Optional<Outcome<RuntimeValue>> {
  cref_eval_of_call_to(o: cref_assemble(src: concat(kpe_prelude(), body)), name: name)
}

fn kpe_int_of(r: Optional<Outcome<RuntimeValue>>) -> Optional<Int> {
  match r {
    Present { value: Accepted { value: v, diagnostics: _ } } => cref_value_int_optional(v: v)
    _ => Absent
  }
}

fn kpe_refused_with(r: Optional<Outcome<RuntimeValue>>, reason: Symbol) -> Bool {
  match r {
    Present { value: Rejected { diagnostics: d } } => diagnostics_fatal_reason(d: d) == reason
    _ => false
  }
}

// POSITIVE: the value the body reads is the literal the application's type argument carried.
test fn kpe_kinded_parameter_value_is_the_applied_literal() -> Bool {
  kpe_int_of(r: kpe_eval(body: "fn width_of<bits: Resolution>(x: Box<bits>) -> Int {\n  bits\n}\n\nfn consumer() -> Int {\n  width_of(x: mk8())\n}\n", name: ^width_of)) == Present { value: 8 }
}

// CONTROL: a body let of the binder's spelling is its own binding; the kinded N is not captured by it.
test fn kpe_body_let_of_the_same_spelling_is_not_the_kinded_parameter() -> Bool {
  kpe_int_of(r: kpe_eval(body: "fn shadowed<bits: Resolution>(x: Box<bits>) -> Int {\n  let bits = 5\n  bits\n}\n\nfn consumer() -> Int {\n  shadowed(x: mk8())\n}\n", name: ^shadowed)) == Present { value: 5 }
}

// CONTROL: a non-generic call carries the EMPTY instance list (never a missing read).
test fn kpe_non_generic_call_carries_no_instances() -> Bool {
  match cref_inferred_of(o: cref_assemble(src: "module p\n\nfn callee(only_arg: Int) -> Int {\n  only_arg\n}\n\nfn consumer() -> Int {\n  callee(only_arg: 3)\n}\n")) {
    Absent => false
    Present { value: inferred } =>
      match cref_the_call_to(root: inferred.root, name: ^callee) {
        Absent => false
        Present { value: call } =>
          match inferred.facts.lookup(call) {
            Absent => false
            Present { value: facts } => facts.type_instances == Empty
          }
      }
  }
}

fn kpp_ok(src: String) -> Bool {
  match cref_assemble(src: src) { Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false }
}

test fn kpp_a_resolution_only() -> Bool { kpp_ok(src: "module p\n\ntype Resolution\n  = Static\n  | Pointer\n") }
test fn kpp_b_box_record() -> Bool { kpp_ok(src: "module p\n\ntype Resolution\n  = Static\n  | Pointer\n\ntype Box<n: Resolution> {\n  v: Int\n}\n") }
test fn kpp_c_ctors() -> Bool { kpp_ok(src: concat(kpe_prelude(), "")) }
test fn kpp_d_fn_only() -> Bool { kpp_ok(src: concat(kpe_prelude(), "fn width_of<bits: Resolution>(x: Box<bits>) -> Int {\n  bits\n}\n")) }
test fn kpp_e_full() -> Bool { kpp_ok(src: concat(kpe_prelude(), "fn width_of<bits: Resolution>(x: Box<bits>) -> Int {\n  bits\n}\n\nfn consumer() -> Int {\n  width_of(x: mk8())\n}\n")) }
test fn kpp_f_fn_no_param_use() -> Bool { kpp_ok(src: "module p\n\ntype Resolution\n  = Static\n  | Pointer\n\ntype Box<n: Resolution> {\n  v: Int\n}\n\nfn width_of<bits: Resolution>(x: Box<bits>) -> Int {\n  3\n}\n") }

test fn kpq_g_plain_fn() -> Bool { kpp_ok(src: concat("module p\n\nfn k() -> Int {\n  0\n}\n", "")) }
test fn kpq_h_ctor_box8() -> Bool { kpp_ok(src: "module p\n\ntype Resolution\n  = Static\n  | Pointer\n\ntype Box<n: Resolution> {\n  v: Int\n}\n\nfn mk8() -> Box<8> {\n  Box { v: 0 }\n}\n") }
test fn kpq_i_ctor_boxp() -> Bool { kpp_ok(src: "module p\n\ntype Resolution\n  = Static\n  | Pointer\n\ntype Box<n: Resolution> {\n  v: Int\n}\n\nfn mkp() -> Box<Pointer> {\n  Box { v: 0 }\n}\n") }
test fn kpq_j_ctor_unannotated() -> Bool { kpp_ok(src: "module p\n\ntype Plain {\n  v: Int\n}\n\nfn mk() -> Plain {\n  Plain { v: 0 }\n}\n") }
test fn kpq_k_param_only() -> Bool { kpp_ok(src: "module p\n\ntype Resolution\n  = Static\n  | Pointer\n\ntype Box<n: Resolution> {\n  v: Int\n}\n\nfn take(x: Box<8>) -> Int {\n  1\n}\n") }

fn kpr_src() -> String {
  concat(kpe_prelude(), "fn width_of<bits: Resolution>(x: Box<bits>) -> Int {\n  bits\n}\n\nfn consumer() -> Int {\n  width_of(x: mk8())\n}\n")
}

test fn kpp_infers() -> Bool {
  match cref_inferred_of(o: cref_assemble(src: kpr_src())) { Present { value: _ } => true
    Absent => false }
}

test fn kpp_call_found() -> Bool {
  match cref_inferred_of(o: cref_assemble(src: kpr_src())) {
    Absent => false
    Present { value: inferred } => match cref_the_call_to(root: inferred.root, name: ^width_of) { Present { value: _ } => true
      Absent => false }
  }
}

fn kpr_reason() -> Optional<Symbol> {
  match cref_eval_of_call_to(o: cref_assemble(src: kpr_src()), name: ^width_of) {
    Present { value: Rejected { diagnostics: d } } => Present { value: diagnostics_fatal_reason(d: d) }
    _ => Absent
  }
}

test fn kpp_is_absent_eval_not_run() -> Bool { kpr_reason() == Absent }
test fn kpp_is_instance_absent() -> Bool { kpr_reason() == Present { value: ^eval_rejected_type_argument_instance_absent } }
test fn kpp_is_not_value() -> Bool { kpr_reason() == Present { value: ^eval_rejected_type_argument_read_as_value } }
test fn kpp_is_unbound_param() -> Bool { kpr_reason() == Present { value: ^eval_rejected_parameter_reference_unbound } }
test fn kpp_is_grounding() -> Bool { kpr_reason() == Present { value: ^eval_rejected_grounding_not_derived } }
test fn kpp_is_lookup_miss() -> Bool { kpr_reason() == Present { value: ^eval_rejected_runtime_binding_lookup_miss } }

test fn kps_type_node() -> Bool { kpr_reason() == Present { value: ^eval_rejected_type_node } }
test fn kps_unsupported_callee() -> Bool { kpr_reason() == Present { value: ^eval_rejected_unsupported_callee } }
test fn kps_unrepresentable() -> Bool { kpr_reason() == Present { value: ^eval_rejected_runtime_value_node_unrepresentable } }
test fn kps_arg_bind_absent() -> Bool { kpr_reason() == Present { value: ^eval_rejected_argument_bind_absent } }
test fn kps_bind_value_absent() -> Bool { kpr_reason() == Present { value: ^eval_rejected_bind_value_absent } }
test fn kps_invalid_node() -> Bool { kpr_reason() == Present { value: ^eval_rejected_invalid_node } }
test fn kps_callee_absent() -> Bool { kpr_reason() == Present { value: ^eval_rejected_callee_absent } }
test fn kps_canonical_mismatch() -> Bool { kpr_reason() == Present { value: ^eval_rejected_canonical_mismatch } }
test fn kps_node_mismatch() -> Bool { kpr_reason() == Present { value: ^eval_rejected_grounding_node_mismatch } }
test fn kps_mk8_executes() -> Bool {
  match cref_eval_of_call_to(o: cref_assemble(src: kpr_src()), name: ^mk8) { Present { value: Accepted { value: _, diagnostics: _ } } => true
    _ => false }
}

fn kpt_runs(src: String, name: Symbol) -> Bool {
  match cref_eval_of_call_to(o: cref_assemble(src: src), name: name) { Present { value: Accepted { value: _, diagnostics: _ } } => true
    _ => false }
}

test fn kpt_plain_int_param_fn_runs() -> Bool { kpt_runs(src: "module p\n\nfn plain(x: Int) -> Int {\n  x\n}\n\nfn consumer() -> Int {\n  plain(x: 3)\n}\n", name: ^plain) }
test fn kpt_generic_unkinded_fn_runs() -> Bool { kpt_runs(src: "module p\n\nfn ident<t>(x: Int) -> Int {\n  x\n}\n\nfn consumer() -> Int {\n  ident(x: 3)\n}\n", name: ^ident) }
test fn kpt_generic_kinded_fn_no_body_read_runs() -> Bool { kpt_runs(src: concat(kpe_prelude(), "fn constant<bits: Resolution>(x: Box<bits>) -> Int {\n  3\n}\n\nfn consumer() -> Int {\n  constant(x: mk8())\n}\n"), name: ^constant) }
test fn kpt_ctor_fn_runs() -> Bool { kpt_runs(src: concat(kpe_prelude(), "fn consumer() -> Int {\n  3\n}\n"), name: ^mk8) }
test fn kpt_box_param_plain_fn_runs() -> Bool { kpt_runs(src: concat(kpe_prelude(), "fn take(x: Box<8>) -> Int {\n  3\n}\n\nfn consumer() -> Int {\n  take(x: mk8())\n}\n"), name: ^take) }

fn kpu_src(call: String) -> String {
  concat("module p\n\ntype Resolution\n  = Static\n  | Pointer\n\nfn width_of<bits: Resolution>() -> Int {\n  bits\n}\n\nfn consumer() -> Int {\n  ", concat(call, "\n}\n"))
}

test fn kpu_explicit_literal_runs() -> Bool { kpt_runs(src: kpu_src(call: "width_of<8>()"), name: ^width_of) }
test fn kpu_explicit_literal_assembles() -> Bool { match cref_inferred_of(o: cref_assemble(src: kpu_src(call: "width_of<8>()"))) { Present { value: _ } => true
  Absent => false } }
test fn kpu_explicit_variant_assembles() -> Bool { match cref_inferred_of(o: cref_assemble(src: kpu_src(call: "width_of<Pointer>()"))) { Present { value: _ } => true
  Absent => false } }

