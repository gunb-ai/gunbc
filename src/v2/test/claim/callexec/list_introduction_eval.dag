fn lie_locus_is(list: Node, wanted: Node) -> Bool {
  match lie_eval(list: list) {
    Present { value: Rejected { diagnostics: ds } } =>
      match ds.head.at {
        NodeLocus { anchor: a } => a.at == wanted
        _ => false
      }
    _ => false
  }
}

test fn lie_locus_list() -> Bool {
  lie_locus_is(list: lie_forward, wanted: lie_forward)
}

test fn lie_locus_head() -> Bool {
  lie_locus_is(list: lie_forward, wanted: lie_head())
}

test fn lie_locus_first_element() -> Bool {
  lie_locus_is(list: lie_forward, wanted: dag_int_literal_fixture_one())
}

test fn lie_locus_second_element() -> Bool {
  lie_locus_is(list: lie_forward, wanted: dag_int_literal_fixture_two())
}
