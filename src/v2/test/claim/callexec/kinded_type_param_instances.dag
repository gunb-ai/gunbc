module v2.test.claim.callexec.kinded_type_param_instances

import v2.test.claim.callexec.declaration_reference_eval { cref_assemble, cref_inferred_of, cref_the_call_to }
import v2.extdeps.runtimes.v2_evaluator { v2_eval_is_literal_shaped_node }
import v2.std.inhabitance { type_variable_instance_lookup }
import std.optional { Absent, Optional, Present }
import std.algebra { Empty }

// WHAT INFER SOLVES FOR A KINDED GENERIC APPLICATION (A0-1a). Real path: assemble, resolve, infer. The
// instance recorded on the call node (InferredFacts.type_instances) is the one value a body-read of the
// kinded binder must take; eval consuming it is held until eval runs record constructors
// (branch session/fierce-newt-112-a0-eval-held, owner sunny-crab-777).
fn kti_instance_of(src: String, name: Symbol, binder: Symbol) -> Optional<Node> {
  match cref_inferred_of(o: cref_assemble(src: src)) {
    Absent => Absent
    Present { value: tree } =>
      match cref_the_call_to(root: tree.root, name: name) {
        Absent => Absent
        Present { value: call } =>
          match tree.facts.lookup(call) {
            Absent => Absent
            Present { value: facts } => type_variable_instance_lookup(instances: facts.type_instances, binder: binder)
          }
      }
  }
}

fn kti_prelude() -> String {
  "module p\n\ntype Resolution\n  = Static\n  | Pointer\n\ntype Box<n: Resolution> {\n  v: Int\n}\n\nfn width_of<bits: Resolution>(x: Box<bits>) -> Int {\n  bits\n}\n\n"
}

test fn kti_literal_argument_is_the_inferred_instance() -> Bool {
  match kti_instance_of(src: concat(kti_prelude(), "fn mk8() -> Box<8> {\n  let r = Box { v: 0 }\n  r\n}\n\nfn consumer() -> Int {\n  width_of(x: mk8())\n}\n"), name: ^width_of, binder: ^bits) {
    Present { value: i } => v2_eval_is_literal_shaped_node(node: i)
    Absent => false
  }
}

test fn kti_forwarded_binder_is_a_non_literal_instance() -> Bool {
  match kti_instance_of(src: concat(kti_prelude(), "fn forward<m: Resolution>(y: Box<m>) -> Int {\n  width_of(x: y)\n}\n"), name: ^width_of, binder: ^bits) {
    Present { value: i } => !v2_eval_is_literal_shaped_node(node: i)
    Absent => false
  }
}

test fn kti_non_generic_call_carries_no_instances() -> Bool {
  match cref_inferred_of(o: cref_assemble(src: "module p\n\nfn callee(only_arg: Int) -> Int {\n  only_arg\n}\n\nfn consumer() -> Int {\n  callee(only_arg: 3)\n}\n")) {
    Absent => false
    Present { value: inferred } =>
      match cref_the_call_to(root: inferred.root, name: ^callee) {
        Absent => false
        Present { value: call } =>
          match inferred.facts.lookup(call) {
            Absent => false
            Present { value: facts } => facts.type_instances == Empty
          }
      }
  }
}
