module v2.test.claim.body_lowering_wrapper_retained

import v2.compiler.body_lowering_fold { BodyLowered, BodyWrapperRetained, body_lower_wrapper_retained_shell }
import v2.std.diagnostic { Accepted, None, Rejected, Some }
import v2.std.logic { Bool }
import v2.std.node { Conj, Node, TypeNode, content_hash, node_synthetic }

// The retention minter's shape (MQ-4). Retention is a VARIANT of the lowering's result, not an
// advisory diagnostic: the minter answers BodyWrapperRetained carrying the retained shell, and emits
// NO diagnostic, because the refusal is minted from the variant by the reader that consumes it
// (v2.compiler.normalized_tree admit_retention_free). This row used to pin the opposite -- that the
// retained outcome's diagnostics inhabited Some and carried body_lowering_reason_wrapper_retained_emitted
// (the 2026-07-11 s1_closure floor panic) -- and that reason no longer exists. It is red against the
// pre-MQ-4 minter, which answered the bare shell as a lowered value with a diagnostic beside it.

fn wrapper_retained_probe_shell() -> Node {
  node_synthetic(kind: TypeNode { connective: Conj }, children: [])
}

test fn body_lowering_wrapper_retained_is_the_retained_variant_holds() -> Bool {
  let shell = wrapper_retained_probe_shell()
  match body_lower_wrapper_retained_shell(shell: shell) {
    Accepted { value: BodyWrapperRetained { retention: r }, diagnostics: _ } => content_hash(n: r.shell) == content_hash(n: shell)
    Accepted { value: BodyLowered { node: _ }, diagnostics: _ } => false
    Rejected { diagnostics: _ } => false
  }
}

test fn body_lowering_wrapper_retained_emits_no_diagnostic_holds() -> Bool {
  match body_lower_wrapper_retained_shell(shell: wrapper_retained_probe_shell()) {
    Accepted { value: _, diagnostics: None } => true
    Accepted { value: _, diagnostics: Some { diagnostics: _ } } => false
    Rejected { diagnostics: _ } => false
  }
}
