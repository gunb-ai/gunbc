module v2.test.claim.body_lowering_wrapper_retained


data wrapper_retained_diagnostics_shape_note: String = "Discriminating witness for the 2026-07-11 s1_closure floor panic: body_lower_wrapper_retained_shell constructed Accepted whose diagnostics field held a RAW NonEmptyDiagnostics where the Diagnostics coproduct (None | Some) is declared - the first downstream match over Diagnostics (diagnostics_merge in the normalize child fold) then panicked non-exhaustive on every file with a wrapper-retained fn body. This witness pins the SHAPE: the wrapper-retained outcome's diagnostics must inhabit the Some arm of Diagnostics and carry the typed wrapper-retained reason. Pre-fix it returns false (the Some pattern cannot match a raw record); post-fix true. Reproduced red/green by execution on dag/std/error_primitives.dag via s1_file_parses."

fn witness_wrapper_retained_diagnostics_inhabit_coproduct() -> Bool {
  let shell = node_synthetic(kind: TypeNode { connective: Conj }, children: [])
  match body_lower_wrapper_retained_shell(shell: shell) {
    Accepted { value: _, diagnostics: Some { diagnostics: ne } } =>
      ne.head.reason == ^body_lowering_reason_wrapper_retained_emitted
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => false
  }
}

test fn body_lowering_wrapper_retained_diagnostics_holds() -> Bool {
  witness_wrapper_retained_diagnostics_inhabit_coproduct()
}
