module v2.test.claim.emitted_closure_crate_partition

import std.types { Bool, Int, List, String }
import v2.lens.module_graph { dependency_resolution_facts_live, module_declaration_facts_live }
import v2.std.collection { map_get }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.optional { Absent, Present }
import v2.std.compilers.compilation_unit {
  CompilationUnitId,
  HandExplicit,
  ModuleId,
  PolicyDerived
}
import v2.workflow.emitted_closure_crate_partition {
  ClosureDependencyUnresolved,
  ClosureEntryUndeclared,
  EmittedClosureDagRefused,
  EmittedClosurePartitionOutcome,
  EmittedClosureResolved,
  derived_policy_partition,
  module_dag_from_dependency_facts
}
import v2.workflow.rust_crate_partition {
  PartitionPolicy,
  ResolvePartitionOk,
  ResolvePartitionRefused
}

// THE INHABITANCE CLAIM FOR THE DERIVED CRATE PARTITION: the real fact producers, the real DAG
// derivation and the real policy resolver, run over a source tree rather than handed a DAG. The
// resolver's refusals and its balance are discriminated against supplied DAGs in
// v2.test.claim.rust_crate_partition_witness; this is the claim that keeps the route from source
// imports to an assignment executing, and it asserts the ROUTE (PolicyDerived) with the answer.
//
// Three fixture trees. base: entry imports left and right, both import sink, and stray imports
// sink but nothing imports stray. mutated: the same, plus entry imports stray. missing: entry
// imports left, and left imports a sink the tree does not declare. Each pool is its fixture
// directory alone and is complete by construction: the fixtures import nothing outside it
// (Int is a builtin), so an undeclared target in these trees is the defect under test and never
// an artifact of a narrow pool. Pointing the whole-tree producers at the live corpus instead is the measurement
// emitted_compiler_closure_policy_partition exists for, and at minutes of evaluation it is not a
// floor claim.

data base_root: String = "dag/test/fixture/emitted_closure_partition/base"
data mutated_root: String = "dag/test/fixture/emitted_closure_partition/mutated"
data missing_root: String = "dag/test/fixture/emitted_closure_partition/missing"

fn fixture_partition_at(root: String, entry: String) -> EmittedClosurePartitionOutcome {
  derived_policy_partition(
    derivation: module_dag_from_dependency_facts(
      entry_path: root + "/" + entry,
      edges: dependency_resolution_facts_live(pool_roots: [root], importer_roots: [root], exclude_substrings: []),
      declarations: module_declaration_facts_live(pool_roots: [root])
    ),
    policy: PartitionPolicy { target_crate_count: 2 }
  )
}

fn owner_of(assignment: Map<ModuleId, CompilationUnitId>, module_id: String) -> String {
  match map_get(assignment, module_id as ModuleId) {
    Accepted { value: Present { value: unit }, diagnostics: _ } => unit as String
    Accepted { value: Absent, diagnostics: _ } => "unowned"
    Rejected { diagnostics: _ } => "unowned"
  }
}

// Positive control. The closure is exactly {entry, left, right, sink} -- stray is declared in the
// tree and reached by nothing -- and the policy splits it two ways with the shared dependency in
// the first unit and the entry in the last. Those two placements are forced: the policy lays
// components out dependencies first, so sink precedes everything and entry follows everything.
test fn a_source_tree_resolves_to_a_policy_derived_partition_of_its_closure() -> Bool {
  let p = "test.fixture.emitted_closure_partition.base."
  match fixture_partition_at(root: base_root, entry: "entry.dag") {
    EmittedClosureResolved { outcome: ResolvePartitionOk { assignment: assignment, provenance: PolicyDerived { policy: _ } } } =>
      (map_keys(assignment) |> count) == 4
        && owner_of(assignment: assignment, module_id: p + "sink") == "policy-unit-0"
        && owner_of(assignment: assignment, module_id: p + "entry") == "policy-unit-1"
        && owner_of(assignment: assignment, module_id: p + "left") != "unowned"
        && owner_of(assignment: assignment, module_id: p + "right") != "unowned"
        && owner_of(assignment: assignment, module_id: p + "stray") == "unowned"
    EmittedClosureResolved { outcome: ResolvePartitionOk { assignment: _, provenance: HandExplicit } } => false
    EmittedClosureResolved { outcome: ResolvePartitionRefused { cause: _ } } => false
    EmittedClosureDagRefused { cause: _ } => false
  }
}

// Mutation control: the one added import in the mutated tree brings stray into the closure, and
// the resolver must now own it. If the DAG were not derived from the tree's imports -- a roster, or
// an edge source that ignored this file -- stray would stay unowned exactly as in the base tree.
test fn one_added_import_changes_the_derived_assignment() -> Bool {
  let p = "test.fixture.emitted_closure_partition.mutated."
  match fixture_partition_at(root: mutated_root, entry: "entry.dag") {
    EmittedClosureResolved { outcome: ResolvePartitionOk { assignment: assignment, provenance: PolicyDerived { policy: _ } } } =>
      (map_keys(assignment) |> count) == 5
        && owner_of(assignment: assignment, module_id: p + "stray") != "unowned"
        && owner_of(assignment: assignment, module_id: p + "sink") == "policy-unit-0"
        && owner_of(assignment: assignment, module_id: p + "entry") == "policy-unit-1"
    EmittedClosureResolved { outcome: ResolvePartitionOk { assignment: _, provenance: HandExplicit } } => false
    EmittedClosureResolved { outcome: ResolvePartitionRefused { cause: _ } } => false
    EmittedClosureDagRefused { cause: _ } => false
  }
}

// (a) A required dependency the pool does not declare refuses at the facts-to-DAG boundary, naming
// the importer and the target -- it does not become a smaller closure that partitions cleanly.
// Restoring it is the base tree, where the same shape resolves with the dependency owned.
test fn an_unresolved_required_dependency_refuses_rather_than_shrinking_the_closure() -> Bool {
  match fixture_partition_at(root: missing_root, entry: "entry.dag") {
    EmittedClosureDagRefused { cause: ClosureDependencyUnresolved { importer_path: importer, target_module: target } } =>
      importer == missing_root + "/left.dag"
        && target == "test.fixture.emitted_closure_partition.missing.sink"
    EmittedClosureDagRefused { cause: ClosureEntryUndeclared { entry_path: _ } } => false
    EmittedClosureResolved { outcome: _ } => false
  }
}

// (c) An entry the pool does not declare is refused by name, never an accepted empty partition.
test fn an_undeclared_entry_refuses_rather_than_resolving_an_empty_closure() -> Bool {
  match fixture_partition_at(root: base_root, entry: "absent.dag") {
    EmittedClosureDagRefused { cause: ClosureEntryUndeclared { entry_path: path } } => path == base_root + "/absent.dag"
    EmittedClosureDagRefused { cause: ClosureDependencyUnresolved { importer_path: _, target_module: _ } } => false
    EmittedClosureResolved { outcome: _ } => false
  }
}
