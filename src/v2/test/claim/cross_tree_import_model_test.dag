// Scope: Route C lens-unit witnesses — cross-tree import model (synthetic facts, no host).
//
// GREEN: admitted cross-tree import under valid TreeFundamentalityOrder + layer-direction.
// RED:   denied cross-tree import — wrong layer direction (std→compiler cross-tree).
// RED:   fail-closed — FundamentalityUnknown denies any cross-tree edge.
// RED:   missing root — to_tree not in SourceRootSet → denied.
// RED:   LessFundamental — to-tree less fundamental → denied.
//
// Enrolled in CI via _test.dag naming convention (floor discovery auto-enroll).

module v2.test.claim.cross_tree_import_model

import v2.std.collection { List }
import v2.std.cross_tree.import_model {
  CoFundamental,
  CrossTreeAdmitted,
  CrossTreeAdmissionVerdict,
  CrossTreeDenied,
  CrossTreeImport,
  DslTree,
  FundamentalityUnknown,
  ImportClosure,
  LayerPrefixCompiler,
  LayerPrefixStd,
  LayerPrefixWorkflow,
  LessFundamental,
  MoreFundamental,
  SourceRootSet,
  V2Tree,
  cross_tree_import_admitted,
  cross_tree_import_closure_admitted
}
import v2.std.logic { Bool }


// ── Shared fixtures ────────────────────────────────────────────────────────────

// Both trees in scope (dual-root compilation).
data both_roots: SourceRootSet = [V2Tree, DslTree]

// Only dsl in scope (single-root; v2 absent).
data dsl_only_roots: SourceRootSet = [DslTree]

// dsl.std → v2.std.* : same layer ordinal (std=0), order determines admission.
data dsl_std_to_v2_std_edge: CrossTreeImport = CrossTreeImport {
  from_tree: DslTree,
  from_layer: LayerPrefixStd,
  from_module: "dsl.std.freeMonoid",
  to_tree: V2Tree,
  to_layer: LayerPrefixStd,
  to_module: "v2.std.algebra"
}

// dsl.std → v2.compiler.* : layer-direction violated (std cannot import compiler; ordinal 0 < 2).
data dsl_std_to_v2_compiler_edge: CrossTreeImport = CrossTreeImport {
  from_tree: DslTree,
  from_layer: LayerPrefixStd,
  from_module: "dsl.std.bad",
  to_tree: V2Tree,
  to_layer: LayerPrefixCompiler,
  to_module: "v2.compiler.tokenize"
}

// v2.workflow → dsl.std : workflow can import std (ordinal 3 >= 0); valid direction.
data v2_workflow_to_dsl_std_edge: CrossTreeImport = CrossTreeImport {
  from_tree: V2Tree,
  from_layer: LayerPrefixWorkflow,
  from_module: "v2.workflow.ci_floor_plan",
  to_tree: DslTree,
  to_layer: LayerPrefixStd,
  to_module: "dsl.std.types"
}


// ── GREEN witnesses ────────────────────────────────────────────────────────────

// dsl.std → v2.std admitted when V2Tree is MoreFundamental than DslTree.
fn witness_dsl_std_to_v2_std_more_fundamental_admitted_holds() -> Bool {
  match cross_tree_import_admitted(
    edge: dsl_std_to_v2_std_edge,
    roots: both_roots,
    order: MoreFundamental
  ) {
    CrossTreeAdmitted => true
    CrossTreeDenied { reason: _ } => false
  }
}

// dsl.std → v2.std admitted when trees are CoFundamental (peer std, same ordinal).
fn witness_dsl_std_to_v2_std_co_fundamental_admitted_holds() -> Bool {
  match cross_tree_import_admitted(
    edge: dsl_std_to_v2_std_edge,
    roots: both_roots,
    order: CoFundamental
  ) {
    CrossTreeAdmitted => true
    CrossTreeDenied { reason: _ } => false
  }
}

// v2.workflow → dsl.std admitted when DslTree is MoreFundamental than V2Tree.
fn witness_v2_workflow_to_dsl_std_more_fundamental_admitted_holds() -> Bool {
  match cross_tree_import_admitted(
    edge: v2_workflow_to_dsl_std_edge,
    roots: both_roots,
    order: MoreFundamental
  ) {
    CrossTreeAdmitted => true
    CrossTreeDenied { reason: _ } => false
  }
}

// Closure of two admitted edges admitted end-to-end.
fn witness_import_closure_all_admitted_holds() -> Bool {
  let closure = [dsl_std_to_v2_std_edge, v2_workflow_to_dsl_std_edge]
  match cross_tree_import_closure_admitted(
    closure: closure,
    roots: both_roots,
    order: MoreFundamental
  ) {
    CrossTreeAdmitted => true
    CrossTreeDenied { reason: _ } => false
  }
}


// ── RED witnesses ─────────────────────────────────────────────────────────────

// dsl.std → v2.compiler: layer-direction violated (std ordinal 0 < compiler ordinal 2).
fn witness_layer_direction_violated_denied_holds() -> Bool {
  match cross_tree_import_admitted(
    edge: dsl_std_to_v2_compiler_edge,
    roots: both_roots,
    order: MoreFundamental
  ) {
    CrossTreeAdmitted => false
    CrossTreeDenied { reason: _ } => true
  }
}

// FundamentalityUnknown: fail-closed — any cross-tree edge denied.
fn witness_fundamentality_unknown_denied_holds() -> Bool {
  match cross_tree_import_admitted(
    edge: dsl_std_to_v2_std_edge,
    roots: both_roots,
    order: FundamentalityUnknown
  ) {
    CrossTreeAdmitted => false
    CrossTreeDenied { reason: _ } => true
  }
}

// Missing root: v2 absent from SourceRootSet → dsl→v2 denied.
fn witness_missing_root_denied_holds() -> Bool {
  match cross_tree_import_admitted(
    edge: dsl_std_to_v2_std_edge,
    roots: dsl_only_roots,
    order: MoreFundamental
  ) {
    CrossTreeAdmitted => false
    CrossTreeDenied { reason: _ } => true
  }
}

// LessFundamental: to-tree less fundamental → deny regardless of layer.
fn witness_less_fundamental_denied_holds() -> Bool {
  match cross_tree_import_admitted(
    edge: dsl_std_to_v2_std_edge,
    roots: both_roots,
    order: LessFundamental
  ) {
    CrossTreeAdmitted => false
    CrossTreeDenied { reason: _ } => true
  }
}

// Closure short-circuits on first denied edge (one bad edge taints the whole closure).
fn witness_closure_denied_on_bad_edge_holds() -> Bool {
  let closure = [dsl_std_to_v2_std_edge, dsl_std_to_v2_compiler_edge]
  match cross_tree_import_closure_admitted(
    closure: closure,
    roots: both_roots,
    order: MoreFundamental
  ) {
    CrossTreeAdmitted => false
    CrossTreeDenied { reason: _ } => true
  }
}


// ── Composite test fn (enrolled by CI floor discovery) ────────────────────────

test fn cross_tree_import_model_witnesses() -> Bool {
  witness_dsl_std_to_v2_std_more_fundamental_admitted_holds()
    && witness_dsl_std_to_v2_std_co_fundamental_admitted_holds()
    && witness_v2_workflow_to_dsl_std_more_fundamental_admitted_holds()
    && witness_import_closure_all_admitted_holds()
    && witness_layer_direction_violated_denied_holds()
    && witness_fundamentality_unknown_denied_holds()
    && witness_missing_root_denied_holds()
    && witness_less_fundamental_denied_holds()
    && witness_closure_denied_on_bad_edge_holds()
}
