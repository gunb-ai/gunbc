module v2.test.claim.cross_tree_import_model


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data both_roots: SourceRootSet = [V2Tree, DagTree]

data dag_only_roots: SourceRootSet = [DagTree]

data dag_std_to_v2_std_edge: CrossTreeImport = CrossTreeImport {
  from_tree: DagTree,
  from_layer: LayerPrefixStd,
  from_module: "dag.std.freeMonoid",
  to_tree: V2Tree,
  to_layer: LayerPrefixStd,
  to_module: "v2.std.algebra"
}

data dag_std_to_v2_compiler_edge: CrossTreeImport = CrossTreeImport {
  from_tree: DagTree,
  from_layer: LayerPrefixStd,
  from_module: "dag.std.bad",
  to_tree: V2Tree,
  to_layer: LayerPrefixCompiler,
  to_module: "v2.compiler.tokenize"
}

data v2_workflow_to_dag_std_edge: CrossTreeImport = CrossTreeImport {
  from_tree: V2Tree,
  from_layer: LayerPrefixWorkflow,
  from_module: "v2.workflow.ci_floor_plan",
  to_tree: DagTree,
  to_layer: LayerPrefixStd,
  to_module: "dag.std.types"
}

fn witness_dag_std_to_v2_std_more_fundamental_admitted_holds() -> Bool {
  match cross_tree_import_admitted(
    edge: dag_std_to_v2_std_edge,
    roots: both_roots,
    order: MoreFundamental
  ) {
    CrossTreeAdmitted => true
    CrossTreeDenied { reason: _ } => false
  }
}

fn witness_dag_std_to_v2_std_co_fundamental_admitted_holds() -> Bool {
  match cross_tree_import_admitted(
    edge: dag_std_to_v2_std_edge,
    roots: both_roots,
    order: CoFundamental
  ) {
    CrossTreeAdmitted => true
    CrossTreeDenied { reason: _ } => false
  }
}

fn witness_v2_workflow_to_dag_std_more_fundamental_admitted_holds() -> Bool {
  match cross_tree_import_admitted(
    edge: v2_workflow_to_dag_std_edge,
    roots: both_roots,
    order: MoreFundamental
  ) {
    CrossTreeAdmitted => true
    CrossTreeDenied { reason: _ } => false
  }
}

fn witness_import_closure_all_admitted_holds() -> Bool {
  let closure = [dag_std_to_v2_std_edge, v2_workflow_to_dag_std_edge]
  match cross_tree_import_closure_admitted(
    closure: closure,
    roots: both_roots,
    order: MoreFundamental
  ) {
    CrossTreeAdmitted => true
    CrossTreeDenied { reason: _ } => false
  }
}

fn witness_layer_direction_violated_denied_holds() -> Bool {
  match cross_tree_import_admitted(
    edge: dag_std_to_v2_compiler_edge,
    roots: both_roots,
    order: MoreFundamental
  ) {
    CrossTreeAdmitted => false
    CrossTreeDenied { reason: _ } => true
  }
}

fn witness_fundamentality_unknown_denied_holds() -> Bool {
  match cross_tree_import_admitted(
    edge: dag_std_to_v2_std_edge,
    roots: both_roots,
    order: FundamentalityUnknown
  ) {
    CrossTreeAdmitted => false
    CrossTreeDenied { reason: _ } => true
  }
}

fn witness_missing_root_denied_holds() -> Bool {
  match cross_tree_import_admitted(
    edge: dag_std_to_v2_std_edge,
    roots: dag_only_roots,
    order: MoreFundamental
  ) {
    CrossTreeAdmitted => false
    CrossTreeDenied { reason: _ } => true
  }
}

fn witness_less_fundamental_denied_holds() -> Bool {
  match cross_tree_import_admitted(
    edge: dag_std_to_v2_std_edge,
    roots: both_roots,
    order: LessFundamental
  ) {
    CrossTreeAdmitted => false
    CrossTreeDenied { reason: _ } => true
  }
}

fn witness_closure_denied_on_bad_edge_holds() -> Bool {
  let closure = [dag_std_to_v2_std_edge, dag_std_to_v2_compiler_edge]
  match cross_tree_import_closure_admitted(
    closure: closure,
    roots: both_roots,
    order: MoreFundamental
  ) {
    CrossTreeAdmitted => false
    CrossTreeDenied { reason: _ } => true
  }
}

test fn cross_tree_import_model_witnesses() -> Bool {
  witness_dag_std_to_v2_std_more_fundamental_admitted_holds()
    && witness_dag_std_to_v2_std_co_fundamental_admitted_holds()
    && witness_v2_workflow_to_dag_std_more_fundamental_admitted_holds()
    && witness_import_closure_all_admitted_holds()
    && witness_layer_direction_violated_denied_holds()
    && witness_fundamentality_unknown_denied_holds()
    && witness_missing_root_denied_holds()
    && witness_less_fundamental_denied_holds()
    && witness_closure_denied_on_bad_edge_holds()
}
