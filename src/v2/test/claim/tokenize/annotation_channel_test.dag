module v2.test.tokenize.annotation_channel

import v2.std.text { String }
import v2.std.logic { Bool }
import v2.std.algebra { fold_list, length }
import v2.std.collection { List }
import std.source_annotation { LeadingAfterLineIndent, TrailingAfterSemanticToken }
import v2.std.compilers.lexing {
  AnnotationRule, TokenRule, TriviaRule,
  LexRuleSet, LexArtifact,
  CharClassPattern, LiteralPattern, OneOrMorePattern, RepeatPattern, SequencePattern, EmptyPattern,
  IdentContinueChar, LineCommentTextChar, WhitespaceChar,
  lex_artifact_annotations, lex_artifact_semantic_tokens,
  token_stream_all
}
import v2.compiler.tokenize {
  LexRuleAnnotation, LexRuleToken, LexRuleTrivia, LexRuleNoMatch,
  lex_try_rule, lex_walk, lex_walk_artifact
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data annotation_channel_witness_note: String = "The exhaustiveness arms added to lex_match_thunk_claims prove only that a new variant was handled; they never CONSTRUCT an AnnotationRule, so they establish nothing about whether the third channel works. These do: every claim below routes real source through the real walk and asserts where the lexeme landed. Pre-regen by design — the whole point is evidence before a long regen cycle, so nothing here needs a rebuilt stage0."

fn annotation_pattern() -> LexPattern {
  SequencePattern {
    left: LiteralPattern { text: "//" },
    right: RepeatPattern { element: CharClassPattern { class: LineCommentTextChar } }
  }
}

fn test_rules() -> LexRuleSet {
  LexRuleSet {
    rules: [
      AnnotationRule { annotation_class: ^line_comment, pattern: annotation_pattern() },
      TriviaRule { pattern: OneOrMorePattern { element: CharClassPattern { class: WhitespaceChar } } },
      TokenRule { token_class: ^ident, pattern: OneOrMorePattern { element: CharClassPattern { class: IdentContinueChar } } }
    ]
  }
}

fn artifact_of(source: String) -> LexArtifact {
  match lex_walk_artifact(source: source, file: ^probe, rules: test_rules()) {
    v2.std.diagnostic.Accepted { value: a, diagnostics: _ } => a
    v2.std.diagnostic.Rejected { diagnostics: _ } => LexArtifact { tokens: v2.std.compilers.lexing.token_stream_empty(), annotations: [] }
  }
}

fn annotation_count(source: String) -> Int {
  length(xs: lex_artifact_annotations(artifact: artifact_of(source: source)))
}

fn token_lexemes(source: String) -> List<String> {
  fold_list(
    xs: token_stream_all(stream: lex_artifact_semantic_tokens(artifact: artifact_of(source: source))),
    empty: [],
    cons: fn(acc, t) { acc |> list_snoc_item(item: t.lexeme) }
  )
}

test fn annotation_rule_routes_to_the_annotation_arm() -> Bool {
  match lex_try_rule(rule: AnnotationRule { annotation_class: ^line_comment, pattern: annotation_pattern() }, source: "// hi") {
    LexRuleAnnotation { class: c, lexeme: _, remaining: _ } => c == ^line_comment
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
    LexRuleTrivia { lexeme: _, remaining: _ } => false
    LexRuleNoMatch => false
  }
}

test fn walk_captures_the_annotation() -> Bool {
  annotation_count(source: "a\n// note\nb\n") == 1
}

test fn semantic_tokens_are_unchanged_by_the_annotation() -> Bool {
  token_lexemes(source: "a\n// note\nb\n") == token_lexemes(source: "a\nb\n")
}

test fn leading_and_trailing_placements_differ() -> Bool {
  let leading = lex_artifact_annotations(artifact: artifact_of(source: "a\n// note\n"))
  let trailing = lex_artifact_annotations(artifact: artifact_of(source: "a // note\n"))
  let l = leading |> first()
  let t = trailing |> first()
  match l {
    Present { value: lv } =>
      match t {
        Present { value: tv } =>
          lv.placement == LeadingAfterLineIndent && tv.placement == TrailingAfterSemanticToken
        Absent => false
      }
    Absent => false
  }
}

test fn annotation_at_eof_is_still_captured() -> Bool {
  annotation_count(source: "a\n// trailing at eof") == 1
}

test fn zero_width_annotation_rule_refuses_rather_than_looping() -> Bool {
  match lex_walk_artifact(
    source: "a",
    file: ^probe,
    rules: LexRuleSet { rules: [ AnnotationRule { annotation_class: ^empty_ann, pattern: EmptyPattern } ] }
  ) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
  }
}

test fn source_without_annotations_captures_none() -> Bool {
  annotation_count(source: "a\nb\n") == 0
}

test fn lex_walk_projection_drops_annotations_but_keeps_tokens() -> Bool {
  match lex_walk(source: "a\n// note\nb\n", file: ^probe, rules: test_rules()) {
    v2.std.diagnostic.Accepted { value: stream, diagnostics: _ } =>
      length(xs: token_stream_all(stream: stream)) == length(xs: token_lexemes(source: "a\nb\n"))
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}
