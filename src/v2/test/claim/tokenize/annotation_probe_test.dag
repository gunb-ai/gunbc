module v2.test.tokenize.annotation_probe

import v2.std.text { String }
import v2.std.logic { Bool }
import v2.std.algebra { is_empty }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data probe_src: String = "fn a"

test fn probe_literal_is_v2_string() -> Bool {
  is_empty(xs: probe_src) == false
}
