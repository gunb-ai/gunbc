module v2.test.tokenize.lex_match_thunk_claims


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data str_a: String = std.algebra.Cons { head: 97, tail: std.algebra.Empty }
data str_b: String = std.algebra.Cons { head: 98, tail: std.algebra.Empty }
data str_ab: String = std.algebra.Cons { head: 97, tail: std.algebra.Cons { head: 98, tail: std.algebra.Empty } }
data str_ac: String = std.algebra.Cons { head: 97, tail: std.algebra.Cons { head: 99, tail: std.algebra.Empty } }
data str_abc: String = std.algebra.Cons { head: 97, tail: std.algebra.Cons { head: 98, tail: std.algebra.Cons { head: 99, tail: std.algebra.Empty } } }
data str_bc: String = std.algebra.Cons { head: 98, tail: std.algebra.Cons { head: 99, tail: std.algebra.Empty } }
data str_aab: String = std.algebra.Cons { head: 97, tail: std.algebra.Cons { head: 97, tail: std.algebra.Cons { head: 98, tail: std.algebra.Empty } } }
data str_123: String = std.algebra.Cons { head: 49, tail: std.algebra.Cons { head: 50, tail: std.algebra.Cons { head: 51, tail: std.algebra.Empty } } }
data str_fn: String = std.algebra.Cons { head: 102, tail: std.algebra.Cons { head: 110, tail: std.algebra.Empty } }
data str_fn_space: String = std.algebra.Cons { head: 102, tail: std.algebra.Cons { head: 110, tail: std.algebra.Cons { head: 32, tail: std.algebra.Empty } } }
data str_fna: String = std.algebra.Cons { head: 102, tail: std.algebra.Cons { head: 110, tail: std.algebra.Cons { head: 97, tail: std.algebra.Empty } } }
data str_slash_star: String = std.algebra.Cons { head: 47, tail: std.algebra.Cons { head: 42, tail: std.algebra.Empty } }
data str_star_slash: String = std.algebra.Cons { head: 42, tail: std.algebra.Cons { head: 47, tail: std.algebra.Empty } }

data str_block_comment: String = std.algebra.Cons { head: 47, tail: std.algebra.Cons { head: 42, tail: std.algebra.Cons { head: 42, tail: std.algebra.Cons { head: 47, tail: std.algebra.Empty } } } }

data str_block_comment_extra_star: String = std.algebra.Cons { head: 47, tail: std.algebra.Cons { head: 42, tail: std.algebra.Cons { head: 42, tail: std.algebra.Cons { head: 42, tail: std.algebra.Cons { head: 47, tail: std.algebra.Empty } } } } }

test fn lex_match_thunk_claims_holds() -> Bool {

  let r1 = match lex_try_rule(
    rule: v2.std.compilers.lexing.TriviaRule { pattern: EmptyPattern },
    source: str_abc
  ) {
    LexRuleTrivia { lexeme: lex, remaining: _ } => is_empty(xs: lex)
    LexRuleNoMatch => false
    LexRuleAnnotation { class: _, lexeme: _, remaining: _ } => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }

  let r2_accept = match lex_try_rule(
    rule: v2.std.compilers.lexing.TriviaRule { pattern: v2.std.compilers.lexing.LiteralPattern { text: str_ab } },
    source: str_abc
  ) {
    LexRuleTrivia { lexeme: _, remaining: rem } => is_empty(xs: rem) == false
    LexRuleNoMatch => false
    LexRuleAnnotation { class: _, lexeme: _, remaining: _ } => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r2_reject = match lex_try_rule(
    rule: v2.std.compilers.lexing.TriviaRule { pattern: v2.std.compilers.lexing.LiteralPattern { text: str_fn } },
    source: str_abc
  ) {
    LexRuleNoMatch => true
    LexRuleAnnotation { class: _, lexeme: _, remaining: _ } => false
    LexRuleTrivia { lexeme: _, remaining: _ } => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r2 = r2_accept && r2_reject

  let r3_accept = match lex_try_rule(
    rule: v2.std.compilers.lexing.TriviaRule { pattern: v2.std.compilers.lexing.KeywordPattern { text: str_fn } },
    source: str_fn_space
  ) {
    LexRuleTrivia { lexeme: _, remaining: _ } => true
    LexRuleNoMatch => false
    LexRuleAnnotation { class: _, lexeme: _, remaining: _ } => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r3_reject = match lex_try_rule(
    rule: v2.std.compilers.lexing.TriviaRule { pattern: v2.std.compilers.lexing.KeywordPattern { text: str_fn } },
    source: str_fna
  ) {
    LexRuleNoMatch => true
    LexRuleAnnotation { class: _, lexeme: _, remaining: _ } => false
    LexRuleTrivia { lexeme: _, remaining: _ } => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r3 = r3_accept && r3_reject

  let r4_accept = match lex_try_rule(
    rule: v2.std.compilers.lexing.TriviaRule { pattern: v2.std.compilers.lexing.CharPattern { char: 97 } },
    source: str_abc
  ) {
    LexRuleTrivia { lexeme: _, remaining: _ } => true
    LexRuleNoMatch => false
    LexRuleAnnotation { class: _, lexeme: _, remaining: _ } => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r4_reject = match lex_try_rule(
    rule: v2.std.compilers.lexing.TriviaRule { pattern: v2.std.compilers.lexing.CharPattern { char: 97 } },
    source: str_bc
  ) {
    LexRuleNoMatch => true
    LexRuleAnnotation { class: _, lexeme: _, remaining: _ } => false
    LexRuleTrivia { lexeme: _, remaining: _ } => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r4 = r4_accept && r4_reject

  let r5_accept = match lex_try_rule(
    rule: v2.std.compilers.lexing.TriviaRule { pattern: v2.std.compilers.lexing.CharClassPattern { class: DigitChar } },
    source: str_123
  ) {
    LexRuleTrivia { lexeme: _, remaining: _ } => true
    LexRuleNoMatch => false
    LexRuleAnnotation { class: _, lexeme: _, remaining: _ } => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r5_reject = match lex_try_rule(
    rule: v2.std.compilers.lexing.TriviaRule { pattern: v2.std.compilers.lexing.CharClassPattern { class: DigitChar } },
    source: str_abc
  ) {
    LexRuleNoMatch => true
    LexRuleAnnotation { class: _, lexeme: _, remaining: _ } => false
    LexRuleTrivia { lexeme: _, remaining: _ } => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r5 = r5_accept && r5_reject

  let r6_accept = match lex_try_rule(
    rule: v2.std.compilers.lexing.TriviaRule { pattern: v2.std.compilers.lexing.SequencePattern {
      left: v2.std.compilers.lexing.CharPattern { char: 97 },
      right: v2.std.compilers.lexing.CharPattern { char: 98 }
    } },
    source: str_ab
  ) {
    LexRuleTrivia { lexeme: _, remaining: _ } => true
    LexRuleNoMatch => false
    LexRuleAnnotation { class: _, lexeme: _, remaining: _ } => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r6_reject = match lex_try_rule(
    rule: v2.std.compilers.lexing.TriviaRule { pattern: v2.std.compilers.lexing.SequencePattern {
      left: v2.std.compilers.lexing.CharPattern { char: 97 },
      right: v2.std.compilers.lexing.CharPattern { char: 98 }
    } },
    source: str_ac
  ) {
    LexRuleNoMatch => true
    LexRuleAnnotation { class: _, lexeme: _, remaining: _ } => false
    LexRuleTrivia { lexeme: _, remaining: _ } => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r6 = r6_accept && r6_reject

  let r7_left_wins = match lex_try_rule(
    rule: v2.std.compilers.lexing.TriviaRule { pattern: v2.std.compilers.lexing.ChoicePattern {
      left: v2.std.compilers.lexing.CharPattern { char: 97 },
      right: v2.std.compilers.lexing.CharPattern { char: 98 }
    } },
    source: str_abc
  ) {
    LexRuleTrivia { lexeme: _, remaining: _ } => true
    LexRuleNoMatch => false
    LexRuleAnnotation { class: _, lexeme: _, remaining: _ } => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r7_right_wins = match lex_try_rule(
    rule: v2.std.compilers.lexing.TriviaRule { pattern: v2.std.compilers.lexing.ChoicePattern {
      left: v2.std.compilers.lexing.CharPattern { char: 97 },
      right: v2.std.compilers.lexing.CharPattern { char: 98 }
    } },
    source: str_bc
  ) {
    LexRuleTrivia { lexeme: _, remaining: _ } => true
    LexRuleNoMatch => false
    LexRuleAnnotation { class: _, lexeme: _, remaining: _ } => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r7_both_reject = match lex_try_rule(
    rule: v2.std.compilers.lexing.TriviaRule { pattern: v2.std.compilers.lexing.ChoicePattern {
      left: v2.std.compilers.lexing.CharPattern { char: 97 },
      right: v2.std.compilers.lexing.CharPattern { char: 98 }
    } },
    source: str_123
  ) {
    LexRuleNoMatch => true
    LexRuleAnnotation { class: _, lexeme: _, remaining: _ } => false
    LexRuleTrivia { lexeme: _, remaining: _ } => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r7 = r7_left_wins && r7_right_wins && r7_both_reject

  let r8_match = match lex_try_rule(
    rule: v2.std.compilers.lexing.TriviaRule { pattern: v2.std.compilers.lexing.OptionalPattern { element: v2.std.compilers.lexing.CharPattern { char: 97 } } },
    source: str_abc
  ) {
    LexRuleTrivia { lexeme: _, remaining: _ } => true
    LexRuleNoMatch => false
    LexRuleAnnotation { class: _, lexeme: _, remaining: _ } => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r8_no_match = match lex_try_rule(
    rule: v2.std.compilers.lexing.TriviaRule { pattern: v2.std.compilers.lexing.OptionalPattern { element: v2.std.compilers.lexing.CharPattern { char: 97 } } },
    source: str_bc
  ) {
    LexRuleTrivia { lexeme: lex, remaining: _ } => is_empty(xs: lex)
    LexRuleNoMatch => false
    LexRuleAnnotation { class: _, lexeme: _, remaining: _ } => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r8 = r8_match && r8_no_match

  let r9_multi = match lex_try_rule(
    rule: v2.std.compilers.lexing.TriviaRule { pattern: v2.std.compilers.lexing.RepeatPattern { element: v2.std.compilers.lexing.CharPattern { char: 97 } } },
    source: str_aab
  ) {
    LexRuleTrivia { lexeme: _, remaining: rem } => is_empty(xs: rem) == false
    LexRuleNoMatch => false
    LexRuleAnnotation { class: _, lexeme: _, remaining: _ } => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r9_zero_width_guard = match lex_try_rule(
    rule: v2.std.compilers.lexing.TriviaRule { pattern: v2.std.compilers.lexing.RepeatPattern { element: v2.std.compilers.lexing.OptionalPattern { element: v2.std.compilers.lexing.CharPattern { char: 97 } } } },
    source: str_b
  ) {
    LexRuleTrivia { lexeme: lex, remaining: _ } => is_empty(xs: lex)
    LexRuleNoMatch => false
    LexRuleAnnotation { class: _, lexeme: _, remaining: _ } => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r9 = r9_multi && r9_zero_width_guard

  let r10_accept = match lex_try_rule(
    rule: v2.std.compilers.lexing.TriviaRule { pattern: v2.std.compilers.lexing.OneOrMorePattern { element: v2.std.compilers.lexing.CharPattern { char: 97 } } },
    source: str_aab
  ) {
    LexRuleTrivia { lexeme: _, remaining: _ } => true
    LexRuleNoMatch => false
    LexRuleAnnotation { class: _, lexeme: _, remaining: _ } => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r10_reject = match lex_try_rule(
    rule: v2.std.compilers.lexing.TriviaRule { pattern: v2.std.compilers.lexing.OneOrMorePattern { element: v2.std.compilers.lexing.CharPattern { char: 97 } } },
    source: str_b
  ) {
    LexRuleNoMatch => true
    LexRuleAnnotation { class: _, lexeme: _, remaining: _ } => false
    LexRuleTrivia { lexeme: _, remaining: _ } => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r10 = r10_accept && r10_reject

  let r11_accept = match lex_try_rule(
    rule: v2.std.compilers.lexing.TriviaRule { pattern: v2.std.compilers.lexing.DelimitedPattern {
      open: v2.std.compilers.lexing.LiteralPattern { text: str_slash_star },
      body: v2.std.compilers.lexing.CharClassPattern { class: BlockCommentTextChar },
      close: v2.std.compilers.lexing.LiteralPattern { text: str_star_slash }
    } },
    source: str_block_comment
  ) {
    LexRuleTrivia { lexeme: _, remaining: rem } => is_empty(xs: rem)
    LexRuleNoMatch => false
    LexRuleAnnotation { class: _, lexeme: _, remaining: _ } => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r11_reject = match lex_try_rule(
    rule: v2.std.compilers.lexing.TriviaRule { pattern: v2.std.compilers.lexing.DelimitedPattern {
      open: v2.std.compilers.lexing.LiteralPattern { text: str_slash_star },
      body: v2.std.compilers.lexing.CharClassPattern { class: BlockCommentTextChar },
      close: v2.std.compilers.lexing.LiteralPattern { text: str_star_slash }
    } },
    source: str_block_comment_extra_star
  ) {
    LexRuleNoMatch => true
    LexRuleAnnotation { class: _, lexeme: _, remaining: _ } => false
    LexRuleTrivia { lexeme: _, remaining: _ } => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r11 = r11_accept && r11_reject

  r1 && r2 && r3 && r4 && r5 && r6 && r7 && r8 && r9 && r10 && r11
}
