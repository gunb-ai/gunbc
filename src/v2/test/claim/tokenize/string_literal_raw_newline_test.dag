module v2.test.tokenize.string_literal_raw_newline

import v2.std.text { String }
import v2.std.logic { Bool }
import v2.std.compilers.lexing { ModeledLexRules, TokenStream }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_lex_rules }
import v2.std.diagnostic { ByteRange, Textual, WholeFile }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn dag_lex(src: String) -> Outcome<TokenStream> {
  tokenize(text: src, file: ^probe, rules: ModeledLexRules { root: dag_lex_rules() })
}

test fn string_literal_with_raw_newline_lexes_holds() -> Bool {
  match dag_lex(src: "data d: String = \"line one\nline two\"") {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn escaped_newline_in_string_still_lexes_holds() -> Bool {
  match dag_lex(src: "data d: String = \"line one\\nline two\"") {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn em_dash_in_identifier_position_still_refuses_holds() -> Bool {
  match dag_lex(src: "x—y") {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: ds } => ds.head.reason == ^tokenize_lex_e1_unrecognized_char
  }
}

test fn unterminated_string_locus_covers_the_opening_quote_holds() -> Bool {
  match dag_lex(src: "\"oops") {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: ds } =>
      (ds.head.reason == ^tokenize_lex_e1_unrecognized_char) &&
        match ds.head.at {
          Textual { file: _, extent: e } =>
            match e {
              ByteRange { start: s, end: end_byte } => (s == 0) && (end_byte >= 1)
              WholeFile => false
            }
          NodeLocus { anchor: _ } => false
          SourcePortLocus { anchor: _, file: _, extent: _ } => false
          InvariantPortLocus { anchor: _, invariant: _ } => false
        }
  }
}
