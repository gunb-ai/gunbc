module v2.test.tokenize.string_literal_raw_newline

import v2.std.text { String }
import std.types { List }
import v2.std.compilers.lexing { ModeledLexRules, TokenStream }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_lex_rules }
import v2.std.diagnostic { Accepted, ByteRange, DeclarationLocus, Outcome, Rejected, Textual, WholeFile }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { Symbol }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn tokenize_probe_with_dag_lex_rules(src: String) -> Outcome<TokenStream> {
  tokenize(text: src, file: ^probe, rules: ModeledLexRules { root: dag_lex_rules() })
}

fn dag_string_token_classes(src: String) -> List<Symbol> {
  match tokenize_probe_with_dag_lex_rules(src: src) {
    Rejected { diagnostics: _ } => []
    Accepted { value: ts, diagnostics: _ } => fold(ts.all, init: [], f: fn(acc, t) { concat(acc, [t.class]) })
  }
}

// DISCRIMINATING RED (review 78485): `\u{E9}` is a Unicode escape. E is IdentStartChar, so if the
// body walk does not consume `\u{` as v1 scan_string_body does, `{E` is a hole opener and this
// source is a template. It must stay one string literal.
test fn unicode_escape_letter_hex_lexes_as_one_string_literal() -> Bool {
  dag_string_token_classes(src: "\"\\u\{E9\}\"") == [^dag_token_string_literal]
}

// GREEN: a digit after the brace is not a hole start, so `\u{0002}` already survived; it must keep
// surviving once the letter-hex arm is admitted.
test fn unicode_escape_digit_hex_lexes_as_one_string_literal() -> Bool {
  dag_string_token_classes(src: "\"\\u\{0002\}\"") == [^dag_token_string_literal]
}

test fn string_literal_with_raw_newline_lexes_holds() -> Bool {
  match tokenize_probe_with_dag_lex_rules(src: "data d: String = \"line one\nline two\"") {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn escaped_newline_in_string_still_lexes_holds() -> Bool {
  match tokenize_probe_with_dag_lex_rules(src: "data d: String = \"line one\\nline two\"") {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn em_dash_in_identifier_position_still_refuses_holds() -> Bool {
  match tokenize_probe_with_dag_lex_rules(src: "x—y") {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: ds } => ds.head.reason == ^tokenize_lex_e1_unrecognized_char
  }
}

test fn unterminated_string_locus_covers_the_opening_quote_holds() -> Bool {
  match tokenize_probe_with_dag_lex_rules(src: "\"oops") {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: ds } =>
      (ds.head.reason == ^tokenize_lex_e1_unrecognized_char) &&
        match ds.head.at {
          Textual { file: _, extent: e } =>
            match e {
              ByteRange { start: s, end: end_byte } => (s == 0) && (end_byte >= 1)
              WholeFile => false
            }
          NodeLocus { anchor: _ } => false
          SourcePortLocus { anchor: _, file: _, extent: _ } => false
          InvariantPortLocus { anchor: _, invariant: _ } => false
          DeclarationLocus { declaration: _ } => false
        }
  }
}
