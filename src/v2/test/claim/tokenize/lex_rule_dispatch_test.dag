module v2.test.tokenize.lex_rule_dispatch

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// FIRST-CHARACTER DISPATCH MUST CHOOSE WHAT TRYING EVERY RULE CHOSE. At every suffix of the specimen
// the longest-match fold over the dispatched candidates is compared with the same fold over every
// compiled rule in declared order -- the pre-dispatch behaviour, which lex_try_rules still computes
// when handed the full list. The specimen is .dag text chosen to reach each kind of FIRST set: keyword
// rules against identifiers that begin with a keyword, one- and two-character operators that share a
// first character, the empty scrutinee literal (nullable), character-class rules (whitespace, digits,
// identifiers), a string literal with an escape and non-ASCII text, a line comment and an atom.
data lex_rule_dispatch_specimen: String = "module m.spec\n\n// a comment -> not => tokens\nfn iffy(fnord: Int, in_x: Int) -> Int {\n  let s = \"esc \\\" λμ done\"\n  if fnord >= 10 && in_x != 0 || fnord <= 2 { fnord |> g } else { match in_x { 0 => ^atom_a  _ => fnord % 3 } }\n}\n"

type LexDispatchCensus {
  positions: Int
  pruned_positions: Int
  disagreements: Int
}

fn lex_dispatch_census_step(census: LexDispatchCensus, dispatch: LexRuleDispatch, suffix: String) -> LexDispatchCensus {
  let candidates = lex_dispatch_candidates(dispatch: dispatch, source: suffix)
  LexDispatchCensus {
    positions: census.positions + 1,
    pruned_positions: if length(xs: candidates) < length(xs: dispatch.all) { census.pruned_positions + 1 } else { census.pruned_positions },
    disagreements: if lex_try_rules(rules: candidates, source: suffix) == lex_try_rules(rules: dispatch.all, source: suffix) {
      census.disagreements
    } else {
      census.disagreements + 1
    }
  }
}

type LexDispatchWalk {
  census: LexDispatchCensus
  suffix: String
}

fn lex_dispatch_census(dispatch: LexRuleDispatch, source: String) -> LexDispatchCensus {
  let walked = fold_list(
    xs: source,
    empty: LexDispatchWalk {
      census: LexDispatchCensus { positions: 0, pruned_positions: 0, disagreements: 0 },
      suffix: source
    },
    cons: fn(acc, _) {
      LexDispatchWalk {
        census: lex_dispatch_census_step(census: acc.census, dispatch: dispatch, suffix: acc.suffix),
        suffix: match string_tail(s: acc.suffix) {
          TailFound { tail: rest } => rest
          TailAbsent => acc.suffix
        }
      }
    }
  )
  walked.census
}

fn lex_dispatch_census_dag_specimen() -> LexDispatchCensus {
  lex_dispatch_census(
    dispatch: lex_rule_dispatch(compiled_rules: lex_compile_rules(rules: dag_lex_rules().rules)),
    source: lex_rule_dispatch_specimen
  )
}

fn lex_dispatch_census_positions(census: LexDispatchCensus) -> Int {
  census.positions
}

fn lex_dispatch_census_pruned_positions(census: LexDispatchCensus) -> Int {
  census.pruned_positions
}

fn lex_dispatch_census_disagreements(census: LexDispatchCensus) -> Int {
  census.disagreements
}

// Non-vacuous: every character position was checked, and dispatch actually removed candidates at
// some of them -- a dispatch that returned every rule everywhere would agree trivially.
test fn lex_rule_dispatch_agrees_with_trying_every_rule() -> Bool {
  let census = lex_dispatch_census_dag_specimen()
  (lex_dispatch_census_positions(census: census) == length(xs: lex_rule_dispatch_specimen))
    && (lex_dispatch_census_pruned_positions(census: census) > 0)
    && (lex_dispatch_census_disagreements(census: census) == 0)
}
