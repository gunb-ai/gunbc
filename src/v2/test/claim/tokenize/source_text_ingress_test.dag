module v2.test.tokenize.source_text_ingress

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE EXECUTING EVIDENCE FOR THE ONE SOURCE-TEXT INGRESS (operator ruling, 2026-09-01, arm B).
//
// v2.compiler.tokenize takes host-valued text because the filesystem REPORTS source text, and
// converts it to the structural character carrier exactly once, above every lexical operation,
// through the same scalar decomposition the literal elaborator uses. These rows make that sentence
// checkable rather than asserted.
//
// WHAT EACH ROW WOULD RED ON, because a row whose failure mode is unstated is decoration. The
// scalar rows red if the ingress ever reads UTF-8 BYTES or UTF-16 CODE UNITS instead of Unicode
// scalars -- substitutions that agree with the truth on ASCII and diverge on the first non-ASCII
// source file, which is why an ASCII-only battery would have been permanently green by
// construction against the defect it was written to catch. The public-boundary rows red if the
// conversion is removed or moved below the match, because both arms read the converted value.
//
// THE ASSERTIONS ARE STATED OVER v2.std.algebra OPERATIONS, NOT OVER v2.std.text ONES, AND THAT IS
// NOT A STYLE CHOICE. v2.std.text's own operations declare their parameter as a bare String, which
// resolves to the KERNEL String under uniform kernel precedence -- so string_head and
// string_is_empty take HOST text and refuse a scalar sequence. The structural carrier's operations
// are the free-monoid ones. Measured: an earlier revision of this file called
// string_head(s: chars(...)) and the floor refused it with declared Primitive(String), produced
// Container(List, Primitive(Int)).
//
// THIS DOES NOT WITNESS text_boundary_identity_wall AND MUST NOT BE READ AS DOING SO. That row's
// subject is an arbitrary non-literal host value crossing an exact structural-text boundary
// through permissive compatibility. These rows exercise ONE named morphism at ONE ingress.

data ingress_ascii_host: String = "ab"

// U+00E9 LATIN SMALL LETTER E WITH ACUTE. One scalar, 233. Two bytes in UTF-8 (195, 169), so a
// byte-grained decomposition answers length 2 with head 195 and this row separates the two.
data ingress_non_ascii_host: String = "é"

// U+1F600 GRINNING FACE. One scalar, 128512 -- above the Basic Multilingual Plane, so a UTF-16
// code-unit decomposition answers length 2 (a surrogate pair) and neither smaller row catches it.
data ingress_astral_host: String = "😀"

data ingress_empty_host: String = ""

data ingress_ascii_structural: v2.std.text.String = Cons { head: 97, tail: Cons { head: 98, tail: std.algebra.Empty } }

test fn source_text_ingress_converts_at_scalar_grain() -> Bool {

  let ascii_agrees = is_prefix_of(prefix: chars(s: ingress_ascii_host), xs: ingress_ascii_structural, eq: fn(a, b) { a == b })
    && length(xs: chars(s: ingress_ascii_host)) == 2

  let non_ascii_scalar = match list_head(xs: chars(s: ingress_non_ascii_host)) {
    HeadFound { value: c } => c == 233
    HeadAbsent => false
  }
  let non_ascii_length = length(xs: chars(s: ingress_non_ascii_host)) == 1

  let astral_scalar = match list_head(xs: chars(s: ingress_astral_host)) {
    HeadFound { value: c } => c == 128512
    HeadAbsent => false
  }
  let astral_length = length(xs: chars(s: ingress_astral_host)) == 1

  let empty_is_identity = is_empty(xs: chars(s: ingress_empty_host))

  ascii_agrees && non_ascii_scalar && non_ascii_length && astral_scalar && astral_length && empty_is_identity
}

// The public argument is host-valued by ruling. Under VoidLexRules an empty host source is the
// accepted arm and a non-empty one is the refusal, and both arms read the CONVERTED value -- so
// this row also fails if the conversion is moved below the match rather than kept above it.
test fn source_text_ingress_accepts_host_text_at_the_public_boundary() -> Bool {
  let empty_accepted = match tokenize(text: ingress_empty_host, file: ^source_text_ingress_file, rules: VoidLexRules) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
  let non_empty_refused = match tokenize(text: ingress_ascii_host, file: ^source_text_ingress_file, rules: VoidLexRules) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
  }
  empty_accepted && non_empty_refused
}
