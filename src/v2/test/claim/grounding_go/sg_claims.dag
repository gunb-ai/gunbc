data claim_go_g2_sg5_collection_absence_executable: TestClaim = EqualsClaim {
  label: "Go G.2 SG-5 evidence records absent collection realization edge fail-closed",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: go_g2_executable_claim_input(ok: go_g2_sg5_collection_realization_absence_holds()),
  rhs: eval_add_subgraph(),
