data subject_go_g2_sg2_projection_absence: TestClaimEvalSubject<Node> = eval_test_claim_subject(
  claim: claim_go_g2_sg2_projection_absence_executable,
  context: eval_context(),
  tree: eval_inferred_tree(),
  evaluator_pin: ^eval_evaluator_pin
