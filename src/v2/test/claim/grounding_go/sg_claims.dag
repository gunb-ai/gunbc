module v2.test.grounding_go.sg_claims

fn go_g2_claim_fail_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^go_g2_claim_fail_symbol } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn go_g2_executable_claim_input(ok: Bool) -> Node {
  if ok {
    eval_add_subgraph()
  } else {
    go_g2_claim_fail_node()
  }
}

fn go_g2_source_carrier_eq(a: Node, b: Node) -> Bool {
  content_hash(n: a) == content_hash(n: b)
}

fn go_g2_sg1_symbol_evidence() -> GroundingEvidenceSchema {
  Sg1Evidence { source_carrier: symbol_kernel_type_node() }
}

fn go_g2_sg2_absence_evidence() -> GroundingEvidenceSchema {
  Sg2Evidence { source_carrier: symbol_kernel_type_node() }
}

fn go_g2_sg5_absence_evidence() -> GroundingEvidenceSchema {
  Sg5Evidence { source_carrier: symbol_kernel_type_node() }
}

fn go_g2_sg1_symbol_evidence_targets_canonical_carrier() -> Bool {
  match go_g2_sg1_symbol_evidence() {
    Sg1Evidence { source_carrier } =>
      go_g2_source_carrier_eq(a: source_carrier, b: symbol_kernel_type_node())
    _ => false
  }
}

fn go_g2_sg2_absence_evidence_targets_canonical_carrier() -> Bool {
  match go_g2_sg2_absence_evidence() {
    Sg2Evidence { source_carrier } =>
      go_g2_source_carrier_eq(a: source_carrier, b: symbol_kernel_type_node())
    _ => false
  }
}

fn go_g2_sg5_absence_evidence_targets_canonical_carrier() -> Bool {
  match go_g2_sg5_absence_evidence() {
    Sg5Evidence { source_carrier } =>
      go_g2_source_carrier_eq(a: source_carrier, b: symbol_kernel_type_node())
    _ => false
  }
}

fn go_g2_sg1_atom_lookup_accepts(source_carrier: Node) -> Bool {
  match target_atom_realization_lookup_in_catalog(
    catalog: go_target_atom_realization_catalog,
    source_carrier: source_carrier
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn go_g2_sg1_atom_realizations_hold() -> Bool {
  go_g2_sg1_symbol_evidence_targets_canonical_carrier()
    && go_g2_sg1_atom_lookup_accepts(source_carrier: symbol_kernel_type_node())
    && go_g2_sg1_atom_lookup_accepts(source_carrier: bool_node())
    && go_g2_sg1_atom_lookup_accepts(source_carrier: char_kernel_type_node())
}

fn go_g2_g1_3_fact_registry_accepts() -> Bool {
  match go_g1_3_per_language_fact_bundle_registry() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn go_g2_sg2_projection_absence_holds() -> Bool {
  go_g2_sg2_absence_evidence_targets_canonical_carrier()
    && match target_bundle_child_optional_type_expr_projection(
      target: go_target_model()
    ) {
      Accepted { value: ProjectionAbsent, diagnostics: _ } => true
      Accepted { value: _, diagnostics: _ } => false
      Rejected { diagnostics: _ } => false
    }
}

fn go_g2_sg5_collection_realization_absence_holds() -> Bool {
  go_g2_sg5_absence_evidence_targets_canonical_carrier()
    && match collection_realization_from_target(target: go_target_model()) {
      Accepted { value: _, diagnostics: _ } => false
      Rejected { diagnostics: _ } => true
    }
    && match free_monoid_collection_realization_from_target(
      target: go_target_model()
    ) {
      Accepted { value: _, diagnostics: _ } => false
      Rejected { diagnostics: _ } => true
    }
}

data claim_go_g2_sg1_atom_realizations_executable: TestClaim = EqualsClaim {
  label: "Go G.2 SG-1 atom realization evidence is executable through run_test_claim",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: go_g2_executable_claim_input(ok: go_g2_sg1_atom_realizations_hold()),
  rhs: eval_add_subgraph(),
  classification: TestClassification { tier: Tier1, layer: Integration }
}

data subject_go_g2_sg1_atom_realizations: TestClaimEvalSubject<Node> = eval_test_claim_subject(
  claim: claim_go_g2_sg1_atom_realizations_executable,
  context: eval_context(),
  tree: eval_inferred_tree(),
  evaluator_pin: ^eval_evaluator_pin
)

data run_go_g2_sg1_atom_realizations: TestClaimRun<Node, RuntimeValue> = run_test_claim(
  subject: subject_go_g2_sg1_atom_realizations
)

data claim_go_g2_g1_3_fact_registry_executable: TestClaim = EqualsClaim {
  label: "Go G.2 G.1.3 fact bundle registry folds through fail-closed insert",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: go_g2_executable_claim_input(ok: go_g2_g1_3_fact_registry_accepts()),
  rhs: eval_add_subgraph(),
  classification: TestClassification { tier: Tier1, layer: Integration }
}

data subject_go_g2_g1_3_fact_registry: TestClaimEvalSubject<Node> = eval_test_claim_subject(
  claim: claim_go_g2_g1_3_fact_registry_executable,
  context: eval_context(),
  tree: eval_inferred_tree(),
  evaluator_pin: ^eval_evaluator_pin
)

data run_go_g2_g1_3_fact_registry: TestClaimRun<Node, RuntimeValue> = run_test_claim(
  subject: subject_go_g2_g1_3_fact_registry
)

data claim_go_g2_sg2_projection_absence_executable: TestClaim = EqualsClaim {
  label: "Go G.2 SG-2 evidence records absent type-expression projection edge fail-closed",
