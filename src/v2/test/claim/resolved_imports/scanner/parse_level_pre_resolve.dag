// Scope: scanner-execution receipt — the live import-RESOLUTION projection must flag a
//        planted dangling import at the TEXT/parse level (committed fixture, read by
//        execution — no typecheck required). REUSES the layering_scan
//        parse_level_pre_resolve fixture (src/v2/test/fixture/layering_scan/.../std/plant.dag),
//        which imports BOTH `v2.compiler.tokenize` (a real declared module → resolved)
//        AND `totally.broken.unresolved.module` (declared nowhere → unresolved). So the
//        projection must flag EXACTLY ONE unresolved import — discriminating that
//        resolution (target exists at all) is distinct from layering direction.
// Status: 🟡 DRAFT-until-signed — zesty signs load-bearing witness receipts.

module v2.test.resolved_imports.scanner.parse_level_pre_resolve

import v2.lens.resolved_imports {
  resolved_imports_violation_count,
  resolved_imports_clean_holds,
  import_resolution_facts_live
}
import gunbc.ci_layer_roots { witness_layer_roots }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }

// Importer = the fixture dir directly (empty exclusion so the text fixture IS scanned);
// pool = the real witness tree (so v2.compiler.tokenize resolves but the broken one does not).
data parse_level_pre_resolve_importer_roots: List<String> = ["src/v2/test/fixture/layering_scan/parse_level_pre_resolve/std"]
data parse_level_pre_resolve_no_exclude: List<String> = []

fn scanner_parse_level_pre_resolve_detects_holds() -> Bool {
  let facts = import_resolution_facts_live(
    pool_roots: witness_layer_roots,
    importer_roots: parse_level_pre_resolve_importer_roots,
    exclude_substrings: parse_level_pre_resolve_no_exclude
  )
  (resolved_imports_violation_count(facts: facts) == 1)
    && (resolved_imports_clean_holds(facts: facts) == false)
}
