data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// DO NOT MERGE. #12640 differential, split for the 7 specimens that differed in run 36621886463:
// one answer per aspect, so the floor says WHICH of verdict / diagnostics / per-node facts differs.
type DnmSplit { verdict: Bool, diagnostics: Bool, facts: Bool, root: Bool, assembled: Bool, new_key_conflict: Bool }

fn dnm_split(src: String) -> DnmSplit {
  match tpb_assemble(src: src) {
    Rejected { diagnostics: _ } => DnmSplit { verdict: true, diagnostics: true, facts: true, root: true, assembled: false, new_key_conflict: false }
    Accepted { value: tree, diagnostics: _ } =>
      match infer(tree: tree) {
        Rejected { diagnostics: rn } =>
          match infer_old(tree: tree) {
            Rejected { diagnostics: ro } => DnmSplit { verdict: true, diagnostics: rn == ro, facts: true, root: true, assembled: true, new_key_conflict: diagnostics_fatal_reason(d: rn) == ^infer_facts_key_conflict }
            Accepted { value: _, diagnostics: _ } => DnmSplit { verdict: false, diagnostics: false, facts: false, root: false, assembled: true, new_key_conflict: diagnostics_fatal_reason(d: rn) == ^infer_facts_key_conflict }
          }
        Accepted { value: tn, diagnostics: dn } =>
          match infer_old(tree: tree) {
            Rejected { diagnostics: _ } => DnmSplit { verdict: false, diagnostics: false, facts: false, root: false, assembled: true, new_key_conflict: false }
            Accepted { value: to, diagnostics: dold } =>
              DnmSplit {
                verdict: true,
                diagnostics: dn == dold,
                facts: fold(node_subtree_nodes(root: tn.root), init: true, f: fn(acc, n) { acc && (tn.facts.lookup(n) == to.facts.lookup(n)) }),
                root: tn.facts.lookup(tn.root) == to.facts.lookup(tn.root),
                assembled: true,
                new_key_conflict: false
              }
          }
      }
  }
}

fn dnm_ig_043() -> DnmSplit {
  dnm_split(src: "module p\n\nfn positive(x: Int) -> Bool { true }\n\ntype Pos = Int where positive\n\ndata d: Pos = 1 as Pos\n")
}

test fn dnm_ig_043_verdict_agrees_holds() -> Bool {
  dnm_ig_043().verdict
}

test fn dnm_ig_043_diagnostics_agrees_holds() -> Bool {
  dnm_ig_043().diagnostics
}

test fn dnm_ig_043_facts_agrees_holds() -> Bool {
  dnm_ig_043().facts
}

test fn dnm_ig_043_root_agrees_holds() -> Bool {
  dnm_ig_043().root
}

