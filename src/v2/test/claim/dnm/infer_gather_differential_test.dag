module v2.test.claim.dnm.infer_gather_differential

import v2.compiler.infer { infer }
import v2.test.claim.dnm.infer_old_gather { infer_old }
import v2.std.diagnostic { Accepted, Diagnostic, Diagnostics, NonEmptyDiagnostics, None, Rejected, Some, diagnostics_fatal_reason }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.node { Symbol, node_subtree_nodes }
import std.algebra { Cons }
import v2.std.algebra { length }
import v2.std.integer { Int }
