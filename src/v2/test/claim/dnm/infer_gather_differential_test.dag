module v2.test.claim.dnm.infer_gather_differential

import v2.compiler.infer { infer }
import v2.test.claim.dnm.infer_old_gather { infer_old }
import v2.std.diagnostic { Accepted, Diagnostic, Diagnostics, NonEmptyDiagnostics, None, Rejected, Some, diagnostics_fatal, diagnostics_fatal_reason }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.node { Symbol, node_subtree_nodes }
import std.algebra { Cons }
import v2.std.algebra { length }
import v2.std.integer { Int }
import v2.std.text { String }
import v2.test.claim.type_param_binder_frame { tpb_assemble }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// DO NOT MERGE. #12640 differential, split for the 7 specimens that differed in run 36621886463:
// one answer per aspect, so the floor says WHICH of verdict / diagnostics / per-node facts differs.
type DnmSplit { verdict: Bool, diagnostics: Bool, facts: Bool, root: Bool, assembled: Bool, new_key_conflict: Bool, new_accepted: Bool, old_accepted: Bool, old_key_conflict: Bool }

// THE ONE STATED EXCEPTION (ruled by quiet-gull-780): two refusals agree when their chains are equal, or
// when both stop at infer_facts_key_conflict naming the SAME key and locus -- the threaded gather refuses at
// the first conflicting insert, the list gather at map build, so the chain before the fatal may be shorter.
fn dnm_refusals_agree(rn: NonEmptyDiagnostics, ro: NonEmptyDiagnostics) -> Bool {
  (rn == ro)
    || ((diagnostics_fatal_reason(d: rn) == ^infer_facts_key_conflict)
      && (diagnostics_fatal(d: rn) == diagnostics_fatal(d: ro)))
}

fn dnm_split(src: String) -> DnmSplit {
  match tpb_assemble(src: src) {
    Rejected { diagnostics: _ } => DnmSplit { verdict: true, diagnostics: true, facts: true, root: true, assembled: false, new_key_conflict: false, new_accepted: false, old_accepted: false, old_key_conflict: false }
    Accepted { value: tree, diagnostics: _ } =>
      match infer(tree: tree) {
        Rejected { diagnostics: rn } =>
          match infer_old(tree: tree) {
            Rejected { diagnostics: ro } => DnmSplit { verdict: true, diagnostics: dnm_refusals_agree(rn: rn, ro: ro), facts: true, root: true, assembled: true, new_key_conflict: diagnostics_fatal_reason(d: rn) == ^infer_facts_key_conflict, new_accepted: false, old_accepted: false, old_key_conflict: diagnostics_fatal_reason(d: ro) == ^infer_facts_key_conflict }
            Accepted { value: _, diagnostics: _ } => DnmSplit { verdict: false, diagnostics: false, facts: false, root: false, assembled: true, new_key_conflict: diagnostics_fatal_reason(d: rn) == ^infer_facts_key_conflict, new_accepted: false, old_accepted: true, old_key_conflict: false }
          }
        Accepted { value: tn, diagnostics: dn } =>
          match infer_old(tree: tree) {
            Rejected { diagnostics: _ } => DnmSplit { verdict: false, diagnostics: false, facts: false, root: false, assembled: true, new_key_conflict: false, new_accepted: true, old_accepted: false, old_key_conflict: false }
            Accepted { value: to, diagnostics: dold } =>
              DnmSplit {
                verdict: true,
                diagnostics: dn == dold,
                facts: fold(node_subtree_nodes(root: tn.root), init: true, f: fn(acc, n) { acc && (tn.facts.lookup(n) == to.facts.lookup(n)) }),
                root: tn.facts.lookup(tn.root) == to.facts.lookup(tn.root),
                assembled: true,
                new_key_conflict: false,
                new_accepted: true,
                old_accepted: true,
                old_key_conflict: false
              }
          }
      }
  }
}

fn dnm_ig_000() -> DnmSplit {
  dnm_split(src: "module p\n")
}

test fn dnm_ig_000_old_and_new_gather_agree_holds() -> Bool {
  let v = dnm_ig_000()
  v.verdict && v.diagnostics && v.facts && v.root
}

