// ROUND 3 (DO NOT MERGE): for 046/051/070, pin WHAT differs in the diagnostics chain.
type DnmDiag { new_accepted: Bool, old_accepted: Bool, count_equal: Bool, new_reasons_in_old: Bool, old_reasons_in_new: Bool, frontier_count_equal: Bool, other_count_equal: Bool }

fn dnm_diag_list(d: Diagnostics) -> List<Diagnostic> {
  match d {
    None => []
    Some { diagnostics: nds } => Cons { head: nds.head, tail: nds.tail }
  }
}

fn dnm_nds_list(nds: NonEmptyDiagnostics) -> List<Diagnostic> {
  Cons { head: nds.head, tail: nds.tail }
}

fn dnm_count_reason(xs: List<Diagnostic>, reason: Symbol) -> Int {
  fold(xs, init: 0, f: fn(acc, d) { if d.reason == reason { acc + 1 } else { acc } })
}

fn dnm_all_reasons_in(xs: List<Diagnostic>, ys: List<Diagnostic>) -> Bool {
  fold(xs, init: true, f: fn(acc, d) { acc && (dnm_count_reason(xs: ys, reason: d.reason) > 0) })
}

fn dnm_diag_compare(new_accepted: Bool, old_accepted: Bool, n: List<Diagnostic>, o: List<Diagnostic>) -> DnmDiag {
  let nf = dnm_count_reason(xs: n, reason: ^infer_grounding_not_derived)
  let of = dnm_count_reason(xs: o, reason: ^infer_grounding_not_derived)
  DnmDiag {
    new_accepted: new_accepted,
    old_accepted: old_accepted,
    count_equal: length(xs: n) == length(xs: o),
    new_reasons_in_old: dnm_all_reasons_in(xs: n, ys: o),
    old_reasons_in_new: dnm_all_reasons_in(xs: o, ys: n),
    frontier_count_equal: nf == of,
    other_count_equal: (length(xs: n) - nf) == (length(xs: o) - of)
  }
}

fn dnm_diag(src: String) -> DnmDiag {
  match tpb_assemble(src: src) {
    Rejected { diagnostics: _ } => dnm_diag_compare(new_accepted: false, old_accepted: false, n: [], o: [])
    Accepted { value: tree, diagnostics: _ } =>
      match infer(tree: tree) {
        Rejected { diagnostics: rn } =>
          match infer_old(tree: tree) {
            Rejected { diagnostics: ro } => dnm_diag_compare(new_accepted: false, old_accepted: false, n: dnm_nds_list(nds: rn), o: dnm_nds_list(nds: ro))
            Accepted { value: _, diagnostics: dold } => dnm_diag_compare(new_accepted: false, old_accepted: true, n: dnm_nds_list(nds: rn), o: dnm_diag_list(d: dold))
          }
        Accepted { value: _, diagnostics: dn } =>
          match infer_old(tree: tree) {
            Rejected { diagnostics: ro } => dnm_diag_compare(new_accepted: true, old_accepted: false, n: dnm_diag_list(d: dn), o: dnm_nds_list(nds: ro))
            Accepted { value: _, diagnostics: dold } => dnm_diag_compare(new_accepted: true, old_accepted: true, n: dnm_diag_list(d: dn), o: dnm_diag_list(d: dold))
          }
      }
  }
}

fn dnm_diag_046() -> DnmDiag {
  dnm_diag(src: "module p\n\nfn positive(x: Int) -> Bool { true }\n\ntype Pos = Int where positive\n\nfn f(x: Pos) -> Pos {\n  x as Pos\n}\n")
}

