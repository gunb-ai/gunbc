module v2.test.resolve.zzz_resolve_identity_probe

import v2.compiler.resolve {
  Namespace,
  ResolveContext,
  empty_canonical_symbol_set,
  resolve_node,
  scope_from_namespace
}
import v2.compiler.symbol_index_fill { symbol_index_fill_module_root }
import v2.extdeps.languages.dag {
  dag_grammar_atom,
  dag_language_model,
  dag_named_edge
}
import v2.std.algebra { fold_list_node }
import std.algebra { Cons, Empty, FreeMonoid }
import v2.std.collection { empty_map }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Symbol,
  SyntheticOccurrence,
  TypeNode
}
import v2.std.qualified_name { qualified_name_from_dotted_string, qualified_name_snoc }
import v2.std.resolution_policy { NamespaceOnlyY }
import v2.std.symbol_index { empty_symbol_index, SymbolIndex }
import v2.std.text { String }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn qn_spine(segments: FreeMonoid<Symbol>) -> Node {
  fold_list_node(
    xs: segments,
    item_node: fn(sym) {
      Node {
        kind: TypeNode { connective: Atom { identity: sym } },
        children: [],
        occurrence_id: SyntheticOccurrence
      }
    }
  )
}

data provider_qn: FreeMonoid<Symbol> = qualified_name_from_dotted_string(
  dotted: "v2.test.resolve.provider"
)

data provider_root: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    dag_named_edge(
      name: ^dag_surface_module_header,
      target: dag_grammar_atom(id: ^dag_surface_module_header)
    ),
    dag_named_edge(
      name: ^dag_surface_module_header_qualified_name,
      target: qn_spine(segments: provider_qn)
    ),
    Edge {
      label: Named { name: ^ProviderType },
      target: Node {
        kind: TypeNode { connective: Atom { identity: ^ProviderType } },
        children: [],
        occurrence_id: SyntheticOccurrence
      }
    }
  ],
  occurrence_id: SyntheticOccurrence
}

data provider_index: SymbolIndex = symbol_index_fill_module_root(
  index: empty_symbol_index(),
  root: provider_root
)

data consumer_qn: FreeMonoid<Symbol> = qualified_name_from_dotted_string(
  dotted: "v2.test.resolve.consumer"
)

data qualified_ref: Node = qn_spine(
  segments: qualified_name_from_dotted_string(
    dotted: "v2.test.resolve.provider.ProviderType"
  )
)

fn resolved_identity() -> String {
  let namespace = Namespace {
    bindings: empty_map(),
    canonical_symbols: empty_canonical_symbol_set(),
    symbol_index: provider_index,
    module_qn: consumer_qn
  }
  match resolve_node(
    ctx: ResolveContext {
      scope: scope_from_namespace(namespace: namespace),
      namespace: namespace,
      policy: NamespaceOnlyY,
      position: qualified_name_snoc(qn: consumer_qn, segment: ^LocalAlias),
      lm: dag_language_model(),
      under_module_root: false
    },
    n: qualified_ref
  ) {
    Accepted { value: resolved, diagnostics: _ } =>
      match resolved.kind {
        TypeNode { connective: Atom { identity: id } } => id
        _ => "NOT_ATOM"
      }
    Rejected { diagnostics: _ } => "REJECTED"
  }
}

test fn resolved_identity_probe() -> String {
  resolved_identity()
}
