module v2.test.resolve.qualified_module_projection_resolve


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn qmpr_qn_spine(segments: std.algebra.FreeMonoid<v2.std.node.Symbol>) -> v2.std.node.Node {
  v2.std.algebra.fold_list_node(
    xs: segments,
    item_node: fn(sym) {
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: sym } },
        children: [],
        occurrence_id: v2.std.node.SyntheticOccurrence
      }
    }
  )
}

data qmpr_provider_qn: std.algebra.FreeMonoid<v2.std.node.Symbol> = v2.std.qualified_name.qualified_name_from_dotted_string(
  dotted: "v2.test.resolve.qualified_module_projection_provider"
)

data qmpr_provider_root: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
  children: [
    v2.extdeps.languages.dag.dag_named_edge(
      name: ^dag_surface_module_header,
      target: v2.extdeps.languages.dag.dag_grammar_atom(id: ^dag_surface_module_header)
    ),
    v2.extdeps.languages.dag.dag_named_edge(
      name: ^dag_surface_module_header_qualified_name,
      target: qmpr_qn_spine(segments: qmpr_provider_qn)
    ),
    v2.std.node.Edge {
      label: v2.std.node.Named { name: ^ProviderType },
      target: v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^ProviderType } },
        children: [],
        occurrence_id: v2.std.node.SyntheticOccurrence
      }
    }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data qmpr_provider_index: v2.std.symbol_index.SymbolIndex = v2.compiler.symbol_index_fill.symbol_index_fill_module_root(
  index: v2.std.symbol_index.empty_symbol_index(),
  root: qmpr_provider_root
)

data qmpr_consumer_qn: std.algebra.FreeMonoid<v2.std.node.Symbol> = v2.std.qualified_name.qualified_name_from_dotted_string(
  dotted: "v2.test.resolve.qualified_module_projection_stripped_fixture"
)

data qmpr_qualified_ref: v2.std.node.Node = qmpr_qn_spine(
  segments: v2.std.qualified_name.qualified_name_from_dotted_string(
    dotted: "v2.test.resolve.qualified_module_projection_provider.ProviderType"
  )
)

fn qmpr_namespace(index: v2.std.symbol_index.SymbolIndex) -> v2.compiler.resolve.Namespace {
  v2.compiler.resolve.Namespace {
    bindings: v2.std.collection.empty_map(),
    canonical_symbols: v2.compiler.resolve.empty_canonical_symbol_set(),
    symbol_index: index,
    module_qn: qmpr_consumer_qn
  }
}

test fn witness_qualified_name_node_resolves_holds() -> Bool {
  let namespace = qmpr_namespace(index: qmpr_provider_index)
  match v2.compiler.resolve.resolve_node(
    ctx: v2.compiler.resolve.ResolveContext {
      scope: v2.compiler.resolve.scope_from_namespace(namespace: namespace),
      namespace: namespace,
      policy: v2.std.resolution_policy.NamespaceOnlyY,
      position: v2.std.qualified_name.qualified_name_snoc(qn: qmpr_consumer_qn, segment: ^LocalAlias),
      lm: v2.extdeps.languages.dag.dag_language_model(),
      under_module_root: false
    },
    n: qmpr_qualified_ref
  ) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn witness_qualified_name_node_miss_red_holds() -> Bool {
  let namespace = qmpr_namespace(index: v2.std.symbol_index.empty_symbol_index())
  match v2.compiler.resolve.resolve_node(
    ctx: v2.compiler.resolve.ResolveContext {
      scope: v2.compiler.resolve.scope_from_namespace(namespace: namespace),
      namespace: namespace,
      policy: v2.std.resolution_policy.NamespaceOnlyY,
      position: qmpr_consumer_qn,
      lm: v2.extdeps.languages.dag.dag_language_model(),
      under_module_root: false
    },
    n: qmpr_qualified_ref
  ) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
  }
}

