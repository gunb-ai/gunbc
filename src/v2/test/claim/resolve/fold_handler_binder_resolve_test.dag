module v2.test.claim.resolve.fold_handler_binder_resolve

import v2.compiler.compile {
  NativeCensusModuleFileRefused,
  NativeCensusModuleOutcome,
  NativeCensusModuleResolveRefused,
  NativeCensusModuleResolved,
  NativeTestContext,
  native_census_module_resolution,
  native_census_modules,
  native_lane_file_refusal_index,
  native_test_context_from_ingest
}
import v2.compiler.source_authority { DagSourceReadWitness, SourceRootIngest }
import v2.std.algebra { fold_list }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.diagnostic { Accepted, NodeLocus, Rejected }
import v2.std.grammar { node_atom_identity_optional }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { Symbol }
import std.optional { Absent, Optional, Present, optional_absent }
import v2.std.text { String }
import std.algebra { Cons, Empty }
import extdeps.communication.medium { Lossless, Medium }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// A FOLD HANDLER'S PARAMETERS BIND AT NATIVE RESOLVE, THE SAME WAY AN ORDINARY LAMBDA'S DO.
//
// THE SUBJECT IS v2.compiler.resolve on the native ingest route (native_test_context_from_ingest,
// then native_census_module_resolution). gunbc.recurring_failure_mode
// fold_cons_handler_binder_unbound_on_the_native_resolver: a `f: fn(acc, item)` / `cons: fn(acc, item)`
// handler's binders were unbound at prepare (resolve_reason_unbound_symbol), while the interpreted
// floor bound the same spelling. The interpreter scopes a lambda's parameters over its body; the
// native resolver owes that same frame once fold_lowering has placed the step as an ordinary Arrow.
//
// THREE MODULES, ONE VARIABLE EACH. `fold` is the specimen: the item binder is used in the handler
// body. `lambda` is the already-binding control: the same two-parameter fn literal as a call
// argument, not a fold step. `undeclared` keeps an unbound name in a fold handler as the sole
// refusal at its atom, so the repair did not start accepting names the handler does not bind.

data fhb_fold_source: String = "module v2.test.fhb_fold\n\ntype Item { path: Bool }\n\nfn fhb_probe(xs: Item) -> Bool {\n  fold(xs, false, fn(acc, candidate) { acc || candidate.path })\n}\n"

data fhb_lambda_source: String = "module v2.test.fhb_lambda\n\ntype Item { path: Bool }\n\nfn fhb_apply(f: Bool, v: Bool) -> Bool { v }\n\nfn fhb_probe(p: Item) -> Bool { fhb_apply(f: fn(acc, candidate) { acc || candidate.path }, v: true) }\n"

data fhb_undeclared_source: String = "module v2.test.fhb_undeclared\n\ntype Item { path: Bool }\n\nfn fhb_probe(xs: Item) -> Bool {\n  fold(xs, false, fn(acc, candidate) { acc || fhb_undeclared_item })\n}\n"

fn fhb_read(source: String, id: Symbol, unit: Symbol, path: String) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: source, fidelity: Lossless },
    artifact: Artifact { kind: SourceFile, id: id, file_path: path },
    compilation_unit: unit,
    source_root: DagTree
  }
}

data fhb_ingest: SourceRootIngest = Cons {
    head: fhb_read(source: fhb_fold_source, id: ^fhb_fold_artifact, unit: ^fhb_fold_cu, path: "src/v2/test/fixture/resolve/fhb_fold.dag"),
    tail: Cons {
    head: fhb_read(source: fhb_lambda_source, id: ^fhb_lambda_artifact, unit: ^fhb_lambda_cu, path: "src/v2/test/fixture/resolve/fhb_lambda.dag"),
    tail: Cons {
    head: fhb_read(source: fhb_undeclared_source, id: ^fhb_undeclared_artifact, unit: ^fhb_undeclared_cu, path: "src/v2/test/fixture/resolve/fhb_undeclared.dag"),
    tail: Empty
  }
  }
  }

type FhbVerdict
  = FhbResolved
  | FhbRefused { reason: Symbol, at_atom: Optional<Symbol>, sole_chain: Bool }
  | FhbFileRefused
  | FhbAbsent

type FhbOutcomes
  = FhbContextRefused
  | FhbOutcomesDecided { fold: FhbVerdict, lambda: FhbVerdict, undeclared: FhbVerdict }

fn fhb_verdict_of(outcome: NativeCensusModuleOutcome) -> FhbVerdict {
  match outcome {
    NativeCensusModuleResolved => FhbResolved
    NativeCensusModuleFileRefused => FhbFileRefused
    NativeCensusModuleResolveRefused { first: d, rest: rest, observation: _ } =>
      FhbRefused {
        reason: d.head.reason,
        at_atom: match d.head.at {
          NodeLocus { anchor: a } => node_atom_identity_optional(node: a.at)
          _ => optional_absent()
        },
        sole_chain: match rest {
          Empty => true
          Cons { head: _, tail: _ } => false
        }
      }
  }
}

fn fhb_verdict_in(context: NativeTestContext, module_name: String) -> FhbVerdict {
  fold_list(
    xs: native_census_modules(ingest: fhb_ingest),
    empty: FhbAbsent,
    cons: fn(acc, entry) {
      if entry.module == module_name {
        fhb_verdict_of(
          outcome: native_census_module_resolution(
            context: context,
            refusal_index: native_lane_file_refusal_index(refusals: context.file_refusals),
            entry: entry
          ).outcome
        )
      } else {
        acc
      }
    }
  )
}

fn fhb_outcomes() -> FhbOutcomes {
  match native_test_context_from_ingest(ingest: fhb_ingest) {
    Rejected { diagnostics: _ } => FhbContextRefused
    Accepted { value: context, diagnostics: _ } =>
      FhbOutcomesDecided {
        fold: fhb_verdict_in(context: context, module_name: "v2.test.fhb_fold"),
        lambda: fhb_verdict_in(context: context, module_name: "v2.test.fhb_lambda"),
        undeclared: fhb_verdict_in(context: context, module_name: "v2.test.fhb_undeclared")
      }
  }
}

fn fhb_is_resolved(v: FhbVerdict) -> Bool {
  match v {
    FhbResolved => true
    _ => false
  }
}

test fn a_fold_handler_item_binder_resolves() -> Bool {
  match fhb_outcomes() {
    FhbOutcomesDecided { fold: v, lambda: _, undeclared: _ } => fhb_is_resolved(v: v)
    FhbContextRefused => false
  }
}

test fn a_non_fold_lambda_argument_still_resolves() -> Bool {
  match fhb_outcomes() {
    FhbOutcomesDecided { fold: _, lambda: v, undeclared: _ } => fhb_is_resolved(v: v)
    FhbContextRefused => false
  }
}

test fn an_undeclared_name_in_a_fold_handler_is_the_sole_refusal_at_its_atom() -> Bool {
  match fhb_outcomes() {
    FhbOutcomesDecided { fold: _, lambda: _, undeclared: v } =>
      match v {
        FhbRefused { reason: r, at_atom: Present { value: id }, sole_chain: sole } =>
          (r == ^resolve_reason_unbound_symbol) && (id == ^fhb_undeclared_item) && sole
        _ => false
      }
    FhbContextRefused => false
  }
}
