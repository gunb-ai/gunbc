module v2.test.claim.single_constructor_wall

import std.occurrence_identity { OccurrenceSynthetic }
import v2.compiler.normalize { normalize }
import v2.compiler.parse { parse_module_prepared }
import v2.compiler.program_assembly { dag_prepared_grammar }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_lex }
import v2.lens.single_constructor { single_constructor_compile_gate }
import v2.std.diagnostic { Accepted, NonEmptyDiagnostics, Outcome, Rejected, bind_outcome }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  ComputationNode,
  Conj,
  Edge,
  Node,
  Positional,
  Symbol,
  Transform,
  TypeNode,
}
import v2.std.witness { Witness }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// RED/GREEN controls for the single-constructor compile gate (v2.lens.single_constructor).
// MachineShape, synthetic: a Transform call with callee Atom ^MachineShape is unsanctioned outside
// std.machine_shape and extdeps.*.machine_shape; ^shape_from_catalog is the sanctioned producer
// path. FnArrowDecl, PRODUCTION-FED: real source parsed and normalized, so the construction reaches
// the gate in the spelling the compiler actually lowers a record literal to.

fn ms_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: [],
    occurrence_id: OccurrenceSynthetic
  }
}

fn ms_positional(target: Node) -> Edge {
  Edge { label: Positional, target: target }
}

fn ms_call(callee: Symbol, arg: Node) -> Node {
  Node {
    kind: ComputationNode { behavior: Transform },
    children: [ms_positional(target: ms_atom(id: callee)), ms_positional(target: arg)],
    occurrence_id: OccurrenceSynthetic
  }
}

fn machine_shape_literal_fixture() -> Node {
  ms_call(
    callee: ^MachineShape,
    arg: Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: OccurrenceSynthetic
    }
  )
}

fn shape_from_catalog_call_fixture() -> Node {
  ms_call(callee: ^shape_from_catalog, arg: ms_atom(id: ^machine_shape_wall_fixture_input))
}

fn non_empty_contains_reason(d: NonEmptyDiagnostics, reason: Symbol) -> Bool {
  if d.head.reason == reason {
    true
  } else {
    fold(d.tail, init: false, f: fn(acc, diag) {
      acc || (diag.reason == reason)
    })
  }
}

fn gate_accepts(o: Outcome<Witness<Node>>) -> Bool {
  match o {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn gate_red_synthetic_machine_shape_call() -> Bool {
  match single_constructor_compile_gate(node: machine_shape_literal_fixture()) {
    Rejected { diagnostics: d } =>
      non_empty_contains_reason(d: d, reason: ^machine_shape_unsanctioned_construction)
    Accepted { value: _, diagnostics: _ } => false
  }
}

test fn gate_green_synthetic_shape_from_catalog_call() -> Bool {
  gate_accepts(o: single_constructor_compile_gate(node: shape_from_catalog_call_fixture()))
}

// ---- FnArrowDecl: the provenance v2.std.fn_index skeleton_application_read rests on. ----

data fn_arrow_decl_forged_source: String = "module wall.forge\n\nfn forged() -> FnArrowDecl = FnArrowDecl { qualified_name: \"x\", name: \"x\" }\n"

data fn_arrow_decl_home_source: String = "module v2.std.fn_index\n\nfn made() -> FnArrowDecl = FnArrowDecl { qualified_name: \"x\", name: \"x\" }\n"

data fn_arrow_decl_destructured_source: String = "module wall.forge\n\nfn read(d: FnArrowDecl) -> String = match d {\n  FnArrowDecl { qualified_name: _, name: n } => n\n}\n"

fn single_constructor_wall_normalized(source: String) -> Outcome<Node> {
  match dag_prepared_grammar() {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: prepared, diagnostics: residue } =>
      bind_outcome(
        o: tokenize(text: source, file: ^single_constructor_wall_file, rules: dag_lex()),
        f: fn(token_stream) {
          match parse_module_prepared(tokens: token_stream, prepared: prepared, validation_residue: residue) {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: artifact, diagnostics: _ } =>
              match normalize(parse_tree: artifact.tree) {
                Rejected { diagnostics: r } => Rejected { diagnostics: r }
                Accepted { value: tree, diagnostics: d } => Accepted { value: tree.root, diagnostics: d }
              }
          }
        }
      )
  }
}

fn gate_over_source(source: String) -> Outcome<Witness<Node>> {
  bind_outcome(o: single_constructor_wall_normalized(source: source), f: fn(root) {
    single_constructor_compile_gate(node: root)
  })
}

// RED: a record literal of FnArrowDecl in a module that is neither v2.std.fn_index nor a witness.
test fn gate_red_fn_arrow_decl_record_literal_outside_its_home() -> Bool {
  match gate_over_source(source: fn_arrow_decl_forged_source) {
    Rejected { diagnostics: d } =>
      non_empty_contains_reason(d: d, reason: ^fn_arrow_decl_unsanctioned_construction)
    Accepted { value: _, diagnostics: _ } => false
  }
}

// GREEN, same literal, in the home module: the red above is the module, not the shape.
test fn gate_green_fn_arrow_decl_record_literal_in_its_home() -> Bool {
  gate_accepts(o: gate_over_source(source: fn_arrow_decl_home_source))
}

// GREEN: destructuring an FnArrowDecl in a match arm is not a construction.
test fn gate_green_fn_arrow_decl_destructuring_pattern() -> Bool {
  gate_accepts(o: gate_over_source(source: fn_arrow_decl_destructured_source))
}
