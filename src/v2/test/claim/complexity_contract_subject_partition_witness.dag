module v2.test.claim.complexity_contract_subject_partition_witness

import v2.lens.enforcement.complexity_contract_subject {
  AsymptoticCostProjection,
  BoundedSummation,
  ComplexityClassComparison,
  ComplexityDerivedKernelClaim,
  ComplexityContractSubject,
  ComplexityOptimalityClaim,
  CompleteRewriteDiscovery,
  DerivedClaim,
  DerivedKernel,
  GlobalOptimality,
  OptimalityClaim,
  OptimalityResidue,
  UnrestrictedSemanticComplexityEquivalence,
  complexity_contract_subjects_partition_legacy_mixed_row,
  complexity_derived_kernel_boundary_is_wall_after_grounding,
  complexity_mixed_row_claim_belongs_to_subject,
  complexity_optimality_boundary_is_outside_modeled_guarantee,
  complexity_scope_roster_has_no_duplicates
}
import v2.lens.enforcement.contract {
  lens_contract_complexity_derived_kernel,
  lens_contract_complexity_optimality
}
import v2.lens.common.construction_justification { WallAfterGrounding, OutsideModeledGuarantee }
import std.disposition { SingleAuthority }

// C0(c) discriminating controls: the legacy mixed lens_contract_complexity row partitions into derived-kernel (WallAfterGrounding / SingleAuthority) and optimality (OutsideModeledGuarantee / Rice residue). Positive: every legacy claim maps to exactly one subject roster and both contract rows carry the matching boundary class. RED: a derived claim classified under OptimalityResidue fails; a planted duplicate in a synthetic roster fails the no-duplicates check.
test fn complexity_contract_subjects_partition_legacy_mixed_row_holds() -> Bool {
  complexity_contract_subjects_partition_legacy_mixed_row()
    && complexity_derived_kernel_boundary_is_wall_after_grounding()
    && complexity_optimality_boundary_is_outside_modeled_guarantee()
    && match lens_contract_complexity_derived_kernel.boundary.class {
      WallAfterGrounding { dissolves_to: SingleAuthority } => true
      _ => false
    }
    && match lens_contract_complexity_optimality.boundary.class {
      OutsideModeledGuarantee { boundary: _ } => true
      _ => false
    }
}

test fn derived_claim_rejects_optimality_subject_red() -> Bool {
  !complexity_mixed_row_claim_belongs_to_subject(
    claim: DerivedClaim { claim: AsymptoticCostProjection },
    subject: OptimalityResidue
  )
    && complexity_mixed_row_claim_belongs_to_subject(
      claim: DerivedClaim { claim: AsymptoticCostProjection },
      subject: DerivedKernel
    )
}

test fn optimality_claim_rejects_derived_kernel_subject_red() -> Bool {
  !complexity_mixed_row_claim_belongs_to_subject(
    claim: OptimalityClaim { claim: GlobalOptimality },
    subject: DerivedKernel
  )
    && complexity_mixed_row_claim_belongs_to_subject(
      claim: OptimalityClaim { claim: GlobalOptimality },
      subject: OptimalityResidue
    )
}

test fn complexity_scope_roster_duplicate_planted_red() -> Bool {
  !complexity_scope_roster_has_no_duplicates(
  claim: BoundedSummation,
  planted_duplicate: BoundedSummation
  )
}

// D1 derived-equality backfill: the hand equality folds (complexity_derived_kernel_claim_eq /
// complexity_optimality_claim_eq) are deleted; their call sites now read the derived == from
// dag/std/algebra (DESIGN §3/§4). The RED is the control for the backfill: distinct variants
// compare unequal, so any equality that conflated them (the failure mode the hand folds were
// backfilling) FAILs. The positive control pins the equal-values-equal-equal direction.

test fn complexity_derived_kernel_claim_derived_eq_red_distinct_variants_unequal() -> Bool {
  (AsymptoticCostProjection == AsymptoticCostProjection)
    && (AsymptoticCostProjection != ComplexityClassComparison)
    && (AsymptoticCostProjection != BoundedSummation)
    && (ComplexityClassComparison != BoundedSummation)
}

test fn complexity_derived_kernel_claim_derived_eq_positive_control_equal_values_equal() -> Bool {
  (BoundedSummation == BoundedSummation)
    && (ComplexityClassComparison == ComplexityClassComparison)
    && (AsymptoticCostProjection == AsymptoticCostProjection)
}

test fn complexity_optimality_claim_derived_eq_red_distinct_variants_unequal() -> Bool {
  (GlobalOptimality == GlobalOptimality)
    && (GlobalOptimality != CompleteRewriteDiscovery)
    && (GlobalOptimality != UnrestrictedSemanticComplexityEquivalence)
    && (CompleteRewriteDiscovery != UnrestrictedSemanticComplexityEquivalence)
}

test fn complexity_optimality_claim_derived_eq_positive_control_equal_values_equal() -> Bool {
  (CompleteRewriteDiscovery == CompleteRewriteDiscovery)
    && (UnrestrictedSemanticComplexityEquivalence == UnrestrictedSemanticComplexityEquivalence)
    && (GlobalOptimality == GlobalOptimality)
}
