module v2.test.claim.pr_native_batch_test

import v2.workflow.ci_floor_plan {
  gunbc_pr_native_entries,
  gunbc_pr_native_batch_enrolled,
  gunbc_ci_floor_batches,
  gunbc_ci_floor_realization_plan
}
import v2.compiler.self_host.native_routing_frontier { native_routed_rows }
import v2.std.algebra { length }
import v2.std.logic { Bool }

fn witness_two_routed_families_enrolled() -> Bool {
  (length(xs: native_routed_rows()) == 2)
    && gunbc_pr_native_batch_enrolled()
    && (length(xs: gunbc_pr_native_entries()) == 2)
}

fn witness_floor_batches_gain_native_batch() -> Bool {
  length(xs: gunbc_ci_floor_batches()) == length(xs: gunbc_ci_floor_realization_plan().schedule) + 1
}

test fn pr_native_batch_witnesses() -> Bool {
  witness_two_routed_families_enrolled()
    && witness_floor_batches_gain_native_batch()
}
