module v2.test.claim.generated_dag_artifacts_at_rule_position

import std.types { Bool, List }
import std.optional { Absent, Optional, Present }
import v2.std.text { String }
import v2.std.algebra { filter, length, list_map }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.compiler.source_authority {
  LayoutFileHeader,
  LayoutHolds,
  LayoutRefused,
  layout_check,
  module_header_declared_name,
  module_namespace
}
import v2.cli.repository_layout { repository_module_file_of_path, repository_storage_layout }
import gunbc.generated_artifact { GeneratedArtifact, artifact_path }
import gunbc.generated_artifact_registry { generated_artifact_registry }
import gunbc.generated_artifact_emit { ArtifactGenerated, ArtifactGenerationRefused, artifact_generate }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE REGISTRY'S SIDE OF THE LAYOUT. The layout check holds every governed `.dag` file to its rule
// position and says nothing about which files are generated: `gunbc.generated_artifact_registry` is
// that fact's single authority, and it cannot be read from the compiler's own CLI without pulling the
// fleet hosts and plans it enumerates into that closure. So the converse is owed here, beside the
// registry: a registered `.dag` artifact is a module, and the module its producer declares is the
// module its registered location is the rule position of.
//
// The subject is the registry and its producers, not the tree: the content is what each producer
// emits and the position is what `layout_check` derives, so a registry row moved without its producer
// (or the reverse) is refused here whether or not the file exists. That the file exists is the
// generated-artifact gate's observation, and a file absent from its rule position is a module no
// request reaches -- neither is a fact of this witness.
//
// WHERE THIS RUNS, stated at its true rung. No required compile reaches a registered `.dag`
// artifact, and nothing on the required job runs claims, so this is mitigation: it executes when the
// claim set is run and not on `witnesses`. That loss is held by the declared drop `gunbc.rung_drop`
// `v1_required_lanes_withdrawn`, which names the artifacts.

// The one namespace row the single header occupies, so the layout check's row join judges the
// position and nothing else.
fn registered_namespace_rows(declared: Optional<String>) -> List<String> {
  match declared {
    Absent => []
    Present { value: name } => [module_namespace(name: name)]
  }
}

// Empty when the content's module line is the rule position of the path; otherwise the cause.
fn registered_position_cause(path: String, content: String) -> String {
  match repository_module_file_of_path(path: path) {
    Absent => concat(path, ": the registered path lies under no governed tree")
    Present { value: file } => {
      let declared = module_header_declared_name(content: content)
      match layout_check(
        layout: repository_storage_layout(),
        namespaces: registered_namespace_rows(declared: declared),
        headers: [LayoutFileHeader { file: file, declared_module: declared }]
      ) {
        LayoutHolds => ""
        LayoutRefused { refusals: _ } =>
          concat(path, ": the producer's module line is not the rule position of the registered path")
      }
    }
  }
}

fn registered_artifact_cause(a: GeneratedArtifact) -> String {
  match artifact_generate(a: a) {
    ArtifactGenerated { content: content } => registered_position_cause(path: artifact_path(a: a), content: content)
    ArtifactGenerationRefused { reason: reason } =>
      concat(artifact_path(a: a), ": the producer refused: ", reason)
  }
}

fn registered_dag_artifacts() -> List<GeneratedArtifact> {
  filter(xs: generated_artifact_registry, predicate: fn(a) { artifact_path(a: a).ends_with(suffix: ".dag") })
}

fn registered_dag_artifact_causes() -> List<String> {
  filter(
    xs: list_map(xs: registered_dag_artifacts(), f: fn(a) { registered_artifact_cause(a: a) }),
    predicate: fn(cause) { cause != "" }
  )
}

// ---- supplied values: one discriminating red per fact, against a positive control -------------------

test fn a_producer_declaring_the_registered_dag_module_holds() -> Bool {
  registered_position_cause(path: "dag/a/b/c.dag", content: "module a.b.c\n") == ""
}

test fn a_producer_declaring_the_registered_v2_module_holds() -> Bool {
  registered_position_cause(path: "src/v2/std/text.dag", content: "// GENERATED\nmodule v2.std.text\n") == ""
}

// The module line names another module than the registered path is the rule position of: the row
// and its producer have drifted apart, and neither is the authority for the other.
test fn a_producer_declaring_another_module_than_its_registered_path_is_refused() -> Bool {
  registered_position_cause(path: "dag/a/b/c.dag", content: "module a.b.zzz\n") != ""
}

test fn a_producer_without_a_module_line_is_refused() -> Bool {
  registered_position_cause(path: "dag/a/b/c.dag", content: "fn f() -> Bool { true }\n") != ""
}

test fn a_registered_path_under_no_governed_tree_is_refused() -> Bool {
  registered_position_cause(path: "docs/a/b/c.dag", content: "module a.b.c\n") != ""
}

// A v2 module registered under the dag tree is the one misplacement the rule's elision exists to
// forbid: its position is src/v2/std/text.dag.
test fn a_v2_module_registered_under_the_dag_tree_is_refused() -> Bool {
  registered_position_cause(path: "dag/v2/std/text.dag", content: "module v2.std.text\n") != ""
}

// ---- the real registry through the real producers (the inhabitance claims) ------------------------

// A registry that registered no `.dag` artifact would make the next claim vacuous.
test fn the_registry_registers_dag_artifacts() -> Bool {
  length(xs: registered_dag_artifacts()) > 0
}

// Runs every registered `.dag` artifact's real producer: deleting the registry or a producer, or
// moving either away from the other, fails this claim.
test fn every_registered_dag_artifact_is_at_the_rule_position_its_producer_declares() -> Bool {
  registered_dag_artifact_causes() == []
}
