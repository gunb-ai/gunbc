module v2.test.claim.grammar.formal_productions_for_lhs

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data formal_productions_for_lhs_fixture_a: v2.std.node.Symbol = ^formal_productions_for_lhs_fixture_a
data formal_productions_for_lhs_fixture_b: v2.std.node.Symbol = ^formal_productions_for_lhs_fixture_b
data formal_productions_for_lhs_fixture_t: v2.std.node.Symbol = ^formal_productions_for_lhs_fixture_t
data formal_productions_for_lhs_fixture_missing: v2.std.node.Symbol = ^formal_productions_for_lhs_fixture_missing

fn formal_productions_for_lhs_fixture_catalog() -> List<v2.std.grammar.FormalProduction> {
  [
    grammar_formal_production(
      lhs: ^formal_productions_for_lhs_fixture_a,
      rhs: [grammar_formal_terminal(identity: ^formal_productions_for_lhs_fixture_t)]
    ),
    grammar_formal_production(
      lhs: ^formal_productions_for_lhs_fixture_b,
      rhs: [grammar_formal_terminal(identity: ^formal_productions_for_lhs_fixture_t)]
    ),
    grammar_formal_production(
      lhs: ^formal_productions_for_lhs_fixture_a,
      rhs: [
        grammar_formal_terminal(identity: ^formal_productions_for_lhs_fixture_t),
        grammar_formal_terminal(identity: ^formal_productions_for_lhs_fixture_t)
      ]
    )
  ]
}

fn formal_productions_for_lhs_all_match_lhs(filtered: List<v2.std.grammar.FormalProduction>, lhs: v2.std.node.Symbol) -> Bool {
  fold_list(
    xs: filtered,
    empty: true,
    cons: fn(ok, production) {
      ok && formal_production_lhs_matches(production: production, lhs: lhs)
    }
  )
}

fn formal_productions_for_lhs_count(xs: List<v2.std.grammar.FormalProduction>) -> Int {
  fold_list(
    xs: xs,
    empty: 0,
    cons: fn(acc, _) { acc + 1 }
  )
}

test fn formal_productions_for_lhs_filters_to_lhs_holds() -> Bool {
  let catalog = formal_productions_for_lhs_fixture_catalog()
  let filtered = formal_productions_for_lhs(
    productions: catalog,
    lhs: ^formal_productions_for_lhs_fixture_a
  )
  formal_productions_for_lhs_all_match_lhs(
    filtered: filtered,
    lhs: ^formal_productions_for_lhs_fixture_a
  )
    && formal_productions_for_lhs_count(xs: filtered) == 2
}

test fn formal_productions_for_lhs_empty_when_missing_holds() -> Bool {
  let catalog = formal_productions_for_lhs_fixture_catalog()
  let filtered = formal_productions_for_lhs(
    productions: catalog,
    lhs: ^formal_productions_for_lhs_fixture_missing
  )
  fold_list(
    xs: filtered,
    empty: true,
    cons: fn(_, _) { false }
  )
}

