module v2.test.claim.grammar.validate_grammar

import std.algebra { Cons, Empty }
import v2.std.collection { Set }
import v2.std.grammar {
  FormalGrammar,
  FormalTerminal,
  grammar_alphabet_enumeration_deferred_4766,
  grammar_formal_nonterminal,
  grammar_formal_production,
  grammar_formal_terminal,
  validate_grammar
}
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.witness { Holds, Violates }

data validate_grammar_fixture_start: Symbol = ^validate_grammar_fixture_start
data validate_grammar_fixture_terminal_a: Symbol = ^validate_grammar_fixture_terminal_a
data validate_grammar_fixture_other_nt: Symbol = ^validate_grammar_fixture_other_nt
data validate_grammar_fixture_bad_lhs: Symbol = ^validate_grammar_fixture_bad_lhs
data validate_grammar_fixture_orphan_terminal: Symbol = ^validate_grammar_fixture_orphan_terminal

fn validate_grammar_fixture_well_formed() -> FormalGrammar {
  let start = grammar_formal_nonterminal(identity: ^validate_grammar_fixture_start)
  let terminal = FormalTerminal { identity: ^validate_grammar_fixture_terminal_a }
  FormalGrammar {
    nonterminals: Set { member: fn(n) { n == start } },
    terminals: Set { member: fn(t) { t == terminal } },
    productions: Cons {
      head: grammar_formal_production(
        lhs: ^validate_grammar_fixture_start,
        rhs: [grammar_formal_terminal(identity: ^validate_grammar_fixture_terminal_a)]
      ),
      tail: Empty
    },
    start: start
  }
}

fn validate_grammar_fixture_start_not_in_nonterminals() -> FormalGrammar {
  let start = grammar_formal_nonterminal(identity: ^validate_grammar_fixture_start)
  let other_nt = grammar_formal_nonterminal(identity: ^validate_grammar_fixture_other_nt)
  let terminal = FormalTerminal { identity: ^validate_grammar_fixture_terminal_a }
  FormalGrammar {
    nonterminals: Set { member: fn(n) { n == other_nt } },
    terminals: Set { member: fn(t) { t == terminal } },
    productions: Cons {
      head: grammar_formal_production(
        lhs: ^validate_grammar_fixture_other_nt,
        rhs: [grammar_formal_terminal(identity: ^validate_grammar_fixture_terminal_a)]
      ),
      tail: Empty
    },
    start: start
  }
}

fn validate_grammar_fixture_lhs_not_in_nonterminals() -> FormalGrammar {
  let start = grammar_formal_nonterminal(identity: ^validate_grammar_fixture_start)
  let terminal = FormalTerminal { identity: ^validate_grammar_fixture_terminal_a }
  FormalGrammar {
    nonterminals: Set { member: fn(n) { n == start } },
    terminals: Set { member: fn(t) { t == terminal } },
    productions: Cons {
      head: grammar_formal_production(
        lhs: ^validate_grammar_fixture_bad_lhs,
        rhs: [grammar_formal_terminal(identity: ^validate_grammar_fixture_terminal_a)]
      ),
      tail: Empty
    },
    start: start
  }
}

fn validate_grammar_fixture_rhs_symbol_not_in_alphabet() -> FormalGrammar {
  let start = grammar_formal_nonterminal(identity: ^validate_grammar_fixture_start)
  let terminal = FormalTerminal { identity: ^validate_grammar_fixture_terminal_a }
  FormalGrammar {
    nonterminals: Set { member: fn(n) { n == start } },
    terminals: Set { member: fn(t) { t == terminal } },
    productions: Cons {
      head: grammar_formal_production(
        lhs: ^validate_grammar_fixture_start,
        rhs: [grammar_formal_terminal(identity: ^validate_grammar_fixture_orphan_terminal)]
      ),
      tail: Empty
    },
    start: start
  }
}

fn witness_validate_grammar_well_formed_accepts_holds() -> Bool {
  match validate_grammar(g: validate_grammar_fixture_well_formed()) {
    Holds { value: w } =>
      (w.alphabet_enumeration == grammar_alphabet_enumeration_deferred_4766())
        && (w.grammar.start.identity == ^validate_grammar_fixture_start)
    Violates { diagnostic: _ } => false
  }
}

fn witness_validate_grammar_start_not_in_nonterminals_rejects_holds() -> Bool {
  match validate_grammar(g: validate_grammar_fixture_start_not_in_nonterminals()) {
    Holds { value: _ } => false
    Violates { diagnostic: _ } => true
  }
}

fn witness_validate_grammar_lhs_not_in_nonterminals_rejects_holds() -> Bool {
  match validate_grammar(g: validate_grammar_fixture_lhs_not_in_nonterminals()) {
    Holds { value: _ } => false
    Violates { diagnostic: _ } => true
  }
}

fn witness_validate_grammar_rhs_symbol_not_in_alphabet_rejects_holds() -> Bool {
  match validate_grammar(g: validate_grammar_fixture_rhs_symbol_not_in_alphabet()) {
    Holds { value: _ } => false
    Violates { diagnostic: _ } => true
  }
}

test fn validate_grammar_witnesses() -> Bool {
  witness_validate_grammar_well_formed_accepts_holds()
    && witness_validate_grammar_start_not_in_nonterminals_rejects_holds()
    && witness_validate_grammar_lhs_not_in_nonterminals_rejects_holds()
    && witness_validate_grammar_rhs_symbol_not_in_alphabet_rejects_holds()
}
