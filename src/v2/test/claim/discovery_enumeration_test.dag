module v2.test.claim.discovery_enumeration_test


test fn discovery_enumeration_unified_claim_arm_modules_holds() -> Bool {
  v2.compiler.discovery_enumeration.unified_claim_arm_bool_witness_claim_module == "v2.std.verification"
    && v2.compiler.discovery_enumeration.unified_claim_arm_node_corpus_module == "v2.std.verification"
}

test fn corpus_init_round_trips() -> Bool {
  let init: v2.compiler.discovery_enumeration.OwnedDataDeclInitializer = v2.compiler.discovery_enumeration.OwnedNodeCorpusInit
  match init {
    v2.compiler.discovery_enumeration.OwnedNodeCorpusInit => true
    _ => false
  }
}

test fn bool_witness_init_round_trips() -> Bool {
  let init: v2.compiler.discovery_enumeration.OwnedDataDeclInitializer = v2.compiler.discovery_enumeration.OwnedBoolWitnessClaimInit {
    witness_entry: "entry.dag",
    witness_function: "witness_fn"
  }
  match init {
    v2.compiler.discovery_enumeration.OwnedBoolWitnessClaimInit { witness_entry: e, witness_function: f } =>
      (e == "entry.dag") && (f == "witness_fn")
    _ => false
  }
}

test fn other_init_round_trips() -> Bool {
  let init: v2.compiler.discovery_enumeration.OwnedDataDeclInitializer = v2.compiler.discovery_enumeration.OwnedOtherInit {
    resolved: v2.compiler.discovery_enumeration.ResolvedDeclRef { module: "v2.example", name: ^sym }
  }
  match init {
    v2.compiler.discovery_enumeration.OwnedOtherInit { resolved: d } =>
      (d.module == "v2.example") && (d.name == ^sym)
    _ => false
  }
}

test fn discovery_enumeration_receipt_zero_default_holds() -> Bool {
  let receipt = v2.compiler.discovery_enumeration.OwnedDataDiscoveryReceipt {
    unified_claim_arm_count: 0,
    bool_witness_claim_arm_count: 0,
    illegal_other_init_count: 0,
    bool_witness_transport_row_count: 0,
    transport_projection_complete: false
  }
  receipt.unified_claim_arm_count == 0 && receipt.transport_projection_complete == false
}
