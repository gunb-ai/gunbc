module v2.test.graph_invariant.lens_unit.reach_kernel_test

import v2.std.collection { List }
import v2.std.dependency { Contains, DependencyView, dependency_lens }
import v2.std.graph_invariant {
  graph_reach_wiring_correction,
  graph_reaches,
  graph_universe_nonempty_for_count,
  graph_unreached_clean_for_count
}
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  Node,
  Symbol,
  SyntheticOccurrence,
  TypeNode
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn gi_atom(identity: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: identity } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn gi_input() -> Node { gi_atom(identity: ^gi_input) }
fn gi_mid() -> Node { gi_atom(identity: ^gi_mid) }
fn gi_out() -> Node { gi_atom(identity: ^gi_output) }
fn gi_dangling() -> Node { gi_atom(identity: ^gi_dangling) }

fn gi_edge(source: Node, dependent: Node) -> DependencyView {
  DependencyView {
    source: source,
    dependent: dependent,
    kind: Contains,
    usage_site: dependent
  }
}

fn gi_live_slice() -> List<DependencyView> {
  [
    gi_edge(source: gi_out(), dependent: gi_mid()),
    gi_edge(source: gi_mid(), dependent: gi_input())
  ]
}

test fn graph_reaches_live_slice() -> Bool {
  graph_reaches(dependence: gi_live_slice(), from: gi_out(), to: gi_input())
}

test fn graph_reaches_dead_target() -> Bool {
  graph_reaches(dependence: gi_live_slice(), from: gi_out(), to: gi_dangling()) == false
}

test fn graph_universe_nonempty_flips_on_empty() -> Bool {
  graph_universe_nonempty_for_count(count: 1)
    && (graph_universe_nonempty_for_count(count: 0) == false)
}

test fn graph_unreached_clean_flips_on_positive() -> Bool {
  graph_unreached_clean_for_count(unreached_count: 0)
    && (graph_unreached_clean_for_count(unreached_count: 1) == false)
}

test fn graph_reach_wiring_correction_wires_dead_input() -> Bool {
  let corrected = graph_reach_wiring_correction(output: gi_out(), declared_input: gi_dangling())
  graph_reaches(
    dependence: dependency_lens(root: corrected),
    from: corrected,
    to: gi_dangling()
  )
}
