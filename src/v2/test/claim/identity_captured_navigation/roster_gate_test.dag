module v2.test.claim.identity_captured_navigation_roster_gate


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data planted_identity_escape_snippet: String = "module identity_escape_probe\n\nfn leaky_identity_probe(node: Node) -> Optional<Node> {\n  match find_named_child(root: node, name: ^grammar_production_identity_node_projection) {\n    Accepted { value: id_node, diagnostics: _ } => Present { value: id_node }\n    Rejected { diagnostics: _ } => Absent\n  }\n}\n"

test fn red_control_planted_identity_escape_still_alarms() -> Bool {
  v2.lens.identity_captured_navigation.roster_gate.finding_standing_observed_suspect(
    standing: v2.lens.identity_captured_navigation.roster_gate.source_finding_standing(source_text: planted_identity_escape_snippet)
  )
}

test fn red_control_planted_identity_escape_finding_count_is_one() -> Bool {
  match v2.lens.identity_captured_navigation.roster_gate.source_findings(source_text: planted_identity_escape_snippet) {
    SourceFindingsNotEstablished { cause: _ } => false
    SourceFindingsEstablished { findings: fs } => finding_list_length(fs: fs) == 1
  }
}

test fn planted_source_analysis_is_established() -> Bool {
  match v2.lens.identity_captured_navigation.roster_gate.source_findings(source_text: planted_identity_escape_snippet) {
    SourceFindingsNotEstablished { cause: _ } => false
    SourceFindingsEstablished { findings: _ } => true
  }
}

data sanctioned_reader_probe_snippet: String = "module sanctioned_reader_probe\n\nfn parse_production_emitted_identity_optional(node: Node) -> Optional<Symbol> {\n  match find_named_child(root: node, name: ^grammar_production_identity_node_projection) {\n    Accepted { value: id_node, diagnostics: _ } => node_atom_identity_optional(node: id_node)\n    Rejected { diagnostics: _ } => Absent\n  }\n}\n"

test fn green_control_sanctioned_reader_body_not_flagged() -> Bool {
  v2.lens.identity_captured_navigation.roster_gate.finding_standing_established_clean(
    standing: v2.lens.identity_captured_navigation.roster_gate.source_finding_standing(source_text: sanctioned_reader_probe_snippet)
  )
}

test fn sanctioned_source_analysis_is_established() -> Bool {
  match v2.lens.identity_captured_navigation.roster_gate.source_findings(source_text: sanctioned_reader_probe_snippet) {
    SourceFindingsNotEstablished { cause: _ } => false
    SourceFindingsEstablished { findings: _ } => true
  }
}

data green_control_note: String = "The canonical sanctioned-reader source must reach NoSuspect. finding_standing_established_clean is false for both SuspectObserved and FindingNotEstablished, so neither a false positive nor a future ingest refusal can impersonate the green repair; this is the single exact observed expected-red for that analyzer defect."

fn finding_list_length(fs: List<v2.lens.identity_captured_navigation.Finding>) -> Int {
  fold_list(xs: fs, empty: 0, cons: fn(acc, f) { acc + 1 })
}

data unrelated_caret_literal_snippet: String = "module unrelated_caret_literal_probe\n\nfn other_named_lookup(node: Node) -> Optional<Node> {\n  match find_named_child(root: node, name: ^grammar_production_captured_node_projection) {\n    Accepted { value: v, diagnostics: _ } => Present { value: v }\n    Rejected { diagnostics: _ } => Absent\n  }\n}\n"

// Pins the caret-literal text-recovery fix (node_source_symbol) against a false positive: a find_named_child(name: ^grammar_production_captured_node_projection) call - a DIFFERENT caret literal, same StampClass token shape as the identity-edge name - must not be misclassified as the identity-escape shape this lens targets.
test fn unrelated_caret_literal_call_not_flagged() -> Bool {
  v2.lens.identity_captured_navigation.roster_gate.finding_standing_established_clean(
    standing: v2.lens.identity_captured_navigation.roster_gate.source_finding_standing(source_text: unrelated_caret_literal_snippet)
  )
}

data unreadable_source_snippet: String = "@"

test fn unreadable_source_finding_standing_not_established() -> Bool {
  match v2.lens.identity_captured_navigation.roster_gate.source_finding_standing(source_text: unreadable_source_snippet) {
    FindingNotEstablished { cause: _ } => true
    NoSuspect => false
    SuspectObserved { suspects: _ } => false
  }
}
