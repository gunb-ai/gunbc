fn leaky_identity_probe(node: Node) -> Optional<Node> {
  match find_named_child(root: node, name: ^grammar_production_identity_node_projection) {
    Accepted { value: id_node, diagnostics: _ } => Present { value: id_node }
    Rejected { diagnostics: _ } => Absent
  }
}
