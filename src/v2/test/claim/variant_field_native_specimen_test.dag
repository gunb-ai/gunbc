module v2.test.claim.variant_field_native_specimen

import std.algebra { FreeMonoid }
import v2.compiler.normalized_tree { no_record_declarations, no_resource_declarations }
import v2.compiler.symbol_index_fill { symbol_index_fill_module_root }
import v2.extdeps.languages.dag { dag_grammar_atom, dag_surface_edge_label }
import v2.std.algebra { fold_list, fold_list_node, is_empty }
import std.types { List }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node {
  Atom,
  Conj,
  Disj,
  Edge,
  Authored,
  Node,
  Symbol,
  TypeNode,
  node_synthetic
}
import v2.std.qualified_name {
  qualified_name_from_dotted_string,
  qualified_name_snoc,
  qualified_name_to_dotted_string
}
import v2.std.symbol_index {
  SymbolIndex,
  empty_symbol_index,
  symbol_index_candidates_at
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// SUBJECT: the restoration trigger of gunbc.rung_drop
// variant_fields_unlowered_on_the_native_route (declared 2026-09-21), SPECIMEN HALF: the binder
// `node` of the `Present { value: node }` arms of v2.std.symbol_index symbol_index_candidates_at,
// verbatim from the row. The claim calls the real std fn (not a mirror) and holds that the
// candidate it returns CARRIES the bound node — the value the arm's binder delivered. A native
// execution that dropped the binder cannot produce it. The round-trip half lives beside this file
// in v2.test.claim.variant_field_native_binding.
//
// CI ENROLLMENT WAITS ON gunbc.rung_drop v2_native_route_off_the_merge_path: until the
// `emit-build` lane's first green fleet run executes the frontier, this universe is adjudicated
// natively only by the operator-invoked instrument, and the floor executes it interpreted. The
// interpreted floor run and the native adjudicate are two executions of the same claims; the
// native receipt is recorded on the retiring PR.
//
// THE discriminating red is a mutation receipt: with the binder binding
// broken (the arm's binder dropped in v2.std.symbol_index, the #11998 state), the specimen
// claims refuse or return false — on the floor before the change, on the native route after it.

// ---- THE FILED SPECIMEN: the real symbol_index_candidates_at, called for real ----

fn vfb_qn_spine(segments: FreeMonoid<Symbol>) -> Node {
  fold_list_node(
    xs: segments,
    item_node: fn(sym) {
      node_synthetic(
        kind: TypeNode { connective: Atom { identity: sym } },
        children: []
      )
    }
  )
}

fn vfb_module_root(qn_spine: Node) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: dag_surface_edge_label(edge: ^dag_surface_module_header),
        target: dag_grammar_atom(id: ^dag_surface_module_header)
      },
      Edge {
        label: dag_surface_edge_label(edge: ^dag_surface_module_header_qualified_name),
        target: qn_spine
      },
      vfb_type_with_variants(type_sym: ^Mood)
    ]
  )
}

fn vfb_type_with_variants(type_sym: Symbol) -> Edge {
  Edge {
    label: Authored { name: type_sym },
    target: node_synthetic(
      kind: TypeNode { connective: Disj },
      children: [
        vfb_variant_arm_edge(variant_sym: ^Yes),
        vfb_variant_arm_edge(variant_sym: ^No)
      ]
    )
  }
}

fn vfb_variant_arm_edge(variant_sym: Symbol) -> Edge {
  Edge {
    label: Authored { name: variant_sym },
    target: node_synthetic(
      kind: TypeNode { connective: Atom { identity: variant_sym } },
      children: []
    )
  }
}

data vfb_specimen_module_qn: FreeMonoid<Symbol> = qualified_name_from_dotted_string(
  dotted: "v2.test.variant_field_binding_specimen"
)

data vfb_specimen_root: Node = vfb_module_root(
  qn_spine: vfb_qn_spine(segments: vfb_specimen_module_qn)
)

data vfb_specimen_index: SymbolIndex = symbol_index_fill_module_root(
  index: empty_symbol_index(),
  root: vfb_specimen_root,
  record_declarations: no_record_declarations(), resource_declarations: no_resource_declarations()
)

// THE SPECIMEN OBSERVATION: symbol_index_candidates_at's `Present { value: node }` arm binds
// `node` and the candidate CARRIES it — the declared type's node, at the declared path. If the
// binder were dropped the way #11998 dropped positional binders, the arm cannot hand this back.
// The fold spells the observation without a record pattern: the candidate arrives as the fold's
// item, and the claim holds when exactly it — the single candidate the specimen declares —
// carries the type node at the declared path.
test fn vfb_specimen_binder_present_value_node_binds() -> Bool  {
  fold_list(
    xs: symbol_index_candidates_at(
      index: vfb_specimen_index,
      position: vfb_specimen_module_qn,
      name: ^Mood
    ),
    empty: false,
    cons: fn(acc, candidate) {
      acc
        || ((qualified_name_to_dotted_string(qn: candidate.path) == "v2.test.variant_field_binding_specimen.Mood")
          && (match candidate.node.kind {
            TypeNode { connective: Disj } => true
            _ => false
          }))
    }
  )
}

// THE BINDER CARRIES THE VARIANT ARM TOO: position inside the type, name = variant — the same
// `Present { value: node }` arm, a different declared field identity ("0" on a variant declared
// positionally is the OTHER arm of the row's one fact; here the variant's node comes back).
test fn vfb_specimen_variant_binder_binds() -> Bool  {
  let type_position = qualified_name_snoc(qn: vfb_specimen_module_qn, segment: ^Mood)
  fold_list(
    xs: symbol_index_candidates_at(
      index: vfb_specimen_index,
      position: type_position,
      name: ^Yes
    ),
    empty: false,
    cons: fn(acc, candidate) {
      acc
        || ((qualified_name_to_dotted_string(qn: candidate.path) == "v2.test.variant_field_binding_specimen.Mood.Yes")
          && (match candidate.node.kind {
            TypeNode { connective: Atom { identity: sym } } => sym == ^Yes
            _ => false
          }))
    }
  )
}

// AN ABSENT LOOKUP STAYS ABSENT: the arm that answers Empty is the other edge of the same
// Optional the specimen matches over.
test fn vfb_specimen_unbound_name_yields_no_candidates() -> Bool  {
  is_empty(
    xs: symbol_index_candidates_at(
      index: vfb_specimen_index,
      position: vfb_specimen_module_qn,
      name: ^Nowhere
    )
  )
}
