module v2.test.program_assembly.real_ingest


data real_ingest_test_import_restoration_note: String = "Main-red repair (2026-07-20): #6848 landed this file referencing module_roots_from_source_root_ingest, validate_module_roots, dag_language_model, LiveTreeDisposition/SubstrateInputsOnly, and the host_source_root_ingest manifest triple without importing any of them - unresolved-type/undefined-variable errors that failed whole-tree typecheck and cascaded into batch 4 (source_root_ingest_gate_passes). Restoring the imports is a TEMPORARY fix, not the end state: v1's dependency-pool pull (resolve_transitively_with_seen in src/v1/stage0/src/main.rs) walks import lines to build the compiled set, so a same-tree provider with no import edge silently drops out even when it lives in the resolved corpus. Dissolves-at: pool-pull becomes reference-driven (consumer reachability, not import-line text-walk) - at that point an explicit import is no longer load-bearing for inclusion and this note goes with it."

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = ReadsLiveTree

fn real_ingest_from_manifest() -> v2.compiler.source_authority.SourceRootIngest {
  match source_root_ingest_build_from_source_refs(refs: host_source_root_closure_refs) {
    SourceRootIngestBuildOk { ingest: ingest } => ingest
    SourceRootIngestBuildReadFailed { result: _ } => Empty
  }
}

test fn program_assembly_real_ingest_module_roots_parse_holds() -> v2.std.logic.Bool {
  match module_roots_from_source_root_ingest(
    ingest: real_ingest_from_manifest(),
    lm: dag_language_model()
  ) {
    Accepted { value: roots, diagnostics: _ } => length(xs: roots) == 2
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn program_assembly_real_ingest_host_manifest_receipt_holds() -> v2.std.logic.Bool {
  source_root_coverage_is_complete(coverage: host_source_root_ingest_coverage_receipt.coverage)
    && (host_source_root_ingest_coverage_receipt.ingest_read_count == 2)
    && (host_source_root_ingest_coverage_receipt.produced_row_count == 2)
    && (length(xs: host_source_root_closure_refs) == 2)
    && (string_is_empty(s: host_source_root_ingest_content_hash) == false)
}

test fn program_assembly_real_ingest_validate_module_roots_red_on_parsed_roots() -> v2.std.logic.Bool {
  match module_roots_from_source_root_ingest(
    ingest: real_ingest_from_manifest(),
    lm: dag_language_model()
  ) {
    Accepted { value: roots, diagnostics: _ } =>
      match validate_module_roots(roots: roots) {
        Accepted { value: _, diagnostics: _ } => true
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}
