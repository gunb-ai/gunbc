// Scope: Stage C Lane 3a — by-execution receipt for assemble_program_from_ingest on host-
//   enumerated real multi-file SourceRootIngest (closes #5070 fixture-only gap).
// Anchor: DESIGN.md §5 — host manifest overlay required at runtime (see
//   tools.source_root_ingest_transport).

module v2.test.program_assembly.real_ingest

import v2.compiler.name_resolve {
  Admission,
  ResolutionSubject
}
import v2.compiler.program_assembly {
  assemble_program_from_ingest,
  module_roots_from_source_root_ingest
}
import v2.extdeps.languages.dag { dag_language_model_wave1 }
import v2.std.algebra { Empty, length }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.qualified_name { QnCons, QnEmpty, QualifiedName }
import v2.std.text { string_is_empty }
import v2.test.workflow.host_source_root_ingest_manifest {
  host_source_root_ingest,
  host_source_root_ingest_content_hash,
  host_source_root_ingest_coverage_receipt
}

fn pa_real_qn_bisect_add() -> QualifiedName {
  QnCons { head: ^bisect, tail: QnCons { head: ^add, tail: QnEmpty } }
}

fn pa_real_add_admission() -> Admission {
  Admission {
    subject: ResolutionSubject {
      name: pa_real_qn_bisect_add()
    },
    imports: Empty
  }
}

test fn program_assembly_real_ingest_module_roots_parse_holds() -> Bool {
  match module_roots_from_source_root_ingest(
    ingest: host_source_root_ingest,
    lm: dag_language_model_wave1()
  ) {
    Accepted { value: roots, diagnostics: _ } => length(xs: roots) >= 1
    Rejected { diagnostics: _ } => false
  }
}

test fn program_assembly_real_ingest_assembles_holds() -> Bool {
  match assemble_program_from_ingest(
    ingest: host_source_root_ingest,
    admission: pa_real_add_admission(),
    lm: dag_language_model_wave1()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn program_assembly_real_ingest_host_manifest_receipt_holds() -> Bool {
  host_source_root_ingest_coverage_receipt.coverage_complete
    && (host_source_root_ingest_coverage_receipt.ingest_read_count >= 1)
    && (length(xs: host_source_root_ingest) >= 1)
    && (string_is_empty(s: host_source_root_ingest_content_hash) == false)
}
