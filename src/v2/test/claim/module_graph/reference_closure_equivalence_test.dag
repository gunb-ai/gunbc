module v2.test.module_graph.reference_closure_equivalence

import gunbc.ci_layer_roots { witness_layer_roots }
import v2.lens.module_graph { import_closure_live, no_paths }
import v2.lens.reference_deps {
  reference_closure_ingest_refusal_witness,
  reference_closure_live,
  reference_parsed_tree_facts_match_import_facts_at_path
}
import v2.lens.module_graph { module_graph_exclude_substrings }
import std.algebra { FreeMonoid }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import v2.std.algebra { contains, for_all, list_snoc_item, fold_list }
import v2.std.collection { List }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.text { String }

data expected_conformance_closure: FreeMonoid<String> = [
  "src/v2/test/claim/module_graph/conformance_imports_only.dag",
  "dag/std/algebra.dag",
  "dag/std/error_primitives.dag",
  "dag/std/primitives.dag",
  "src/v2/std/algebra.dag",
  "src/v2/std/collection.dag",
  "src/v2/std/diagnostic.dag",
  "src/v2/std/logic.dag",
  "src/v2/std/node.dag",
  "src/v2/std/node_query.dag",
  "src/v2/std/witness.dag"
]

data conformance_entry: String = "src/v2/test/claim/module_graph/conformance_imports_only.dag"

data conformance_import_envelope_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "v2.test.manual.coproduct_reflection_conformance",
    decl_name: "reflect_connective_type",
    field: WholeDeclaration
  }
}

data conformance_import_envelope_dissolution_note: String = "conformance_imports_only.dag mirrors coproduct_reflection_conformance_test.dag import envelope only (no extra imports — closure goldens stay byte-identical). v2 parse_module rejects test fn bodies today, so equivalence gates use this pipeline-parseable stub. Dissolves when parse_module accepts fn bodies (repoint conformance_entry to src/v2/test/claim/manual/coproduct_reflection_conformance_test.dag) or when a shared import-envelope fixture subsumes both."

data workspace_root_cross_runner_hand_rust_receipt: String = "Cross-runner CI unblock for release-bins handoff (operator ruling 2026-07-11, gunbc.ci_spec ci_floor_required_artifact_names_note): claim_executor built on runner A bakes CARGO_MANIFEST_DIR to A's checkout; floor job on runner B must index module paths under B's tree. Hand-Rust: cli_run.rs workspace_root() prefers GITHUB_WORKSPACE then process cwd when dag/ and src/v2/ are present, else baked root. Executable backstop: build_module_path_index_accepts_relative_roots_at_process_cwd (#6462). Dissolves when workspace_root is a modeled std authority or release-bins carry a content-addressed checkout-root manifest binding the handoff."

data bogus_never_referenced: String = "src/v2/std/__bogus_never_referenced__.dag"

data reference_closure_equivalence_note: String = "B2 safety wall (operator, sharp-bee-290): resolution RESULTS are preserved when the module graph is derived from parsed-tree qualified-name use sites instead of import declarations. On the current import-only corpus, reference_closure_live (import_resolution_facts BFS) must match the declared golden (witnessed here) and import_closure_live (witnessed in import_closure_live_test.dag on the same golden); reference_parsed_tree_matches_import_facts_on_conformance_entry_holds proves parsed-tree census agrees with import facts on the entry file. Transitivity: reference == expected && import == expected && parsed≡import on entry ⇒ reference == import on the conformance fixture. Witness entry is conformance_imports_only.dag (pipeline-parseable stub). Scaffold marker for the parallel envelope lives on this witness module (conformance_import_envelope_disposition), not on the stub. Any ingest refusal poisons the parsed census (fail-closed) as Outcome Rejected. RED ingest control uses reference_closure_ingest_refusal_witness."

fn string_eq(a: String, b: String) -> Bool {
  a == b
}

fn set_subset(xs: FreeMonoid<String>, ys: FreeMonoid<String>) -> Bool {
  for_all(xs: xs, predicate: fn(x) { contains(xs: ys, item: x, eq: string_eq) })
}

fn set_equal(xs: FreeMonoid<String>, ys: FreeMonoid<String>) -> Bool {
  set_subset(xs: xs, ys: ys) && set_subset(xs: ys, ys: xs)
}

fn import_conformance_closure() -> FreeMonoid<String> {
  import_closure_live(entry_path: conformance_entry, pool_roots: witness_layer_roots)
}

fn reference_conformance_closure_outcome() -> Outcome<FreeMonoid<String>> {
  reference_closure_live(entry_path: conformance_entry, pool_roots: witness_layer_roots)
}

test fn reference_parsed_tree_matches_import_facts_on_conformance_entry_holds() -> Bool {
  reference_parsed_tree_facts_match_import_facts_at_path(
    rel_path: conformance_entry,
    pool_roots: witness_layer_roots,
    exclude_substrings: module_graph_exclude_substrings
  )
}

test fn reference_closure_conformance_equivalence_holds() -> Bool {
  match reference_conformance_closure_outcome() {
    Accepted { value: reference_closure, diagnostics: _ } =>
      let with_bogus = list_snoc_item(xs: expected_conformance_closure, item: bogus_never_referenced)
      set_equal(xs: reference_closure, ys: expected_conformance_closure)
        && set_equal(xs: reference_closure, ys: with_bogus) == false
    Rejected { diagnostics: _ } => false
  }
}

test fn import_reference_closure_mismatch_discriminates_red_holds() -> Bool {
  let declared_without_entry = fold_list(
    xs: expected_conformance_closure,
    empty: no_paths,
    cons: fn(acc, p) {
      if string_eq(a: p, b: conformance_entry) {
        acc
      } else {
        list_snoc_item(xs: acc, item: p)
      }
    }
  )
  set_equal(xs: import_conformance_closure(), ys: declared_without_entry) == false
}

test fn reference_closure_ingest_refusal_is_rejected_not_empty_red_holds() -> Bool {
  match reference_closure_ingest_refusal_witness(pool_roots: witness_layer_roots) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}
