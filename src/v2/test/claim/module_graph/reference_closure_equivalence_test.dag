module v2.test.module_graph.reference_closure_equivalence

import gunbc.ci_layer_roots { witness_layer_roots }
import extdeps.communication.fidelity_carriers { Lossless }
import extdeps.communication.medium { Medium }
import v2.compiler.normalize { normalize }
import v2.compiler.parse { parse_module }
import v2.compiler.program_assembly { program_assembly_read_to_normalized_root }
import v2.compiler.source_authority { DagSourceReadWitness }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_language_model }
import v2.lens.module_graph { import_closure_live, no_paths }
import v2.lens.reference_deps { reference_closure_ingest_refusal_witness, reference_closure_live }
import std.algebra { FreeMonoid }
import v2.std.algebra { contains, for_all, list_snoc_item, fold_list }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.collection { List }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.text { String }

data conformance_entry_compilation_unit: Symbol = ^conformance_entry_compilation_unit

data expected_conformance_closure: FreeMonoid<String> = [
  "src/v2/test/claim/manual/coproduct_reflection_conformance_test.dag",
  "dag/std/algebra.dag",
  "dag/std/error_primitives.dag",
  "dag/std/primitives.dag",
  "src/v2/std/algebra.dag",
  "src/v2/std/collection.dag",
  "src/v2/std/diagnostic.dag",
  "src/v2/std/logic.dag",
  "src/v2/std/node.dag",
  "src/v2/std/node_query.dag",
  "src/v2/std/witness.dag"
]

data conformance_entry: String = "src/v2/test/claim/manual/coproduct_reflection_conformance_test.dag"

data bogus_never_referenced: String = "src/v2/std/__bogus_never_referenced__.dag"

data reference_closure_equivalence_note: String = "B2 safety wall (operator, sharp-bee-290): resolution RESULTS are preserved when the module graph is derived from parsed-tree qualified-name use sites instead of import declarations. On the current corpus every cross-module edge is still an import, so reference-closure must equal import-closure on the conformance witness — equal module sets imply the same resolve inputs. Any ingest refusal poisons reference-closure (fail-closed) as Outcome Rejected, never as an empty FreeMonoid; a strict superset without equality would be a located deficit before any import deletion. RED ingest control uses reference_closure_ingest_refusal_witness (inline unparseable source via reference_file_census_from_source — same refusal→Rejected arm as BFS, green-by-execution without a broken .dag in the compile graph)."

fn string_eq(a: String, b: String) -> Bool {
  a == b
}

fn set_subset(xs: FreeMonoid<String>, ys: FreeMonoid<String>) -> Bool {
  for_all(xs: xs, predicate: fn(x) { contains(xs: ys, item: x, eq: string_eq) })
}

fn set_equal(xs: FreeMonoid<String>, ys: FreeMonoid<String>) -> Bool {
  set_subset(xs: xs, ys: ys) && set_subset(xs: ys, ys: xs)
}

fn import_conformance_closure() -> FreeMonoid<String> {
  import_closure_live(entry_path: conformance_entry, pool_roots: witness_layer_roots)
}

fn reference_conformance_closure_accepted() -> FreeMonoid<String> {
  match reference_closure_live(entry_path: conformance_entry, pool_roots: witness_layer_roots) {
    Accepted { value: closure, diagnostics: _ } => closure
    Rejected { diagnostics: _ } => no_paths
  }
}

fn conformance_entry_source_text() -> String {
  filesystem_read(path: conformance_entry).content
}

fn conformance_entry_tokenize_accepts() -> Bool {
  match tokenize(
    text: conformance_entry_source_text(),
    file: conformance_entry_compilation_unit,
    rules: dag_language_model().lex
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: _, diagnostics: _ } => true
  }
}

fn conformance_entry_parse_accepts() -> Bool {
  match tokenize(
    text: conformance_entry_source_text(),
    file: conformance_entry_compilation_unit,
    rules: dag_language_model().lex
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: dag_language_model().grammar) {
        Rejected { diagnostics: _ } => false
        Accepted { value: _, diagnostics: _ } => true
      }
  }
}

fn conformance_entry_normalize_accepts() -> Bool {
  match tokenize(
    text: conformance_entry_source_text(),
    file: conformance_entry_compilation_unit,
    rules: dag_language_model().lex
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: dag_language_model().grammar) {
        Rejected { diagnostics: _ } => false
        Accepted { value: artifact, diagnostics: _ } =>
          match normalize(parse_tree: artifact.tree) {
            Rejected { diagnostics: _ } => false
            Accepted { value: _, diagnostics: _ } => true
          }
      }
  }
}

fn conformance_entry_ingest_accepts() -> Bool {
  match program_assembly_read_to_normalized_root(
    read: DagSourceReadWitness {
      source: Medium {
        carried: filesystem_read(path: conformance_entry).content,
        fidelity: Lossless
      },
      artifact: Artifact {
        kind: SourceFile,
        id: conformance_entry_compilation_unit,
        file_path: conformance_entry
      },
      compilation_unit: conformance_entry_compilation_unit,
      source_root: DagTree
    },
    lm: dag_language_model()
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: _, diagnostics: _ } => true
  }
}

test fn conformance_entry_tokenize_accepts_holds() -> Bool {
  conformance_entry_tokenize_accepts()
}

test fn conformance_entry_parse_accepts_holds() -> Bool {
  conformance_entry_parse_accepts()
}

test fn conformance_entry_normalize_accepts_holds() -> Bool {
  conformance_entry_normalize_accepts()
}

test fn conformance_imports_only_parse_accepts_holds() -> Bool {
  let path = "src/v2/test/claim/module_graph/conformance_imports_only.dag"
  match tokenize(
    text: filesystem_read(path: path).content,
    file: conformance_entry_compilation_unit,
    rules: dag_language_model().lex
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: dag_language_model().grammar) {
        Rejected { diagnostics: _ } => false
        Accepted { value: _, diagnostics: _ } => true
      }
  }
}

test fn dag_std_algebra_parse_accepts_holds() -> Bool {
  let path = "dag/std/algebra.dag"
  match tokenize(
    text: filesystem_read(path: path).content,
    file: conformance_entry_compilation_unit,
    rules: dag_language_model().lex
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: dag_language_model().grammar) {
        Rejected { diagnostics: _ } => false
        Accepted { value: _, diagnostics: _ } => true
      }
  }
}

test fn conformance_entry_pipeline_ingest_accepts_holds() -> Bool {
  conformance_entry_ingest_accepts()
}

test fn reference_closure_live_accepted_on_conformance_holds() -> Bool {
  match reference_closure_live(entry_path: conformance_entry, pool_roots: witness_layer_roots) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn reference_closure_superset_of_import_closure_holds() -> Bool {
  set_subset(xs: import_conformance_closure(), ys: reference_conformance_closure_accepted())
}

test fn reference_closure_equals_import_closure_on_conformance_holds() -> Bool {
  set_equal(
    xs: import_conformance_closure(),
    ys: reference_conformance_closure_accepted()
  )
}

test fn reference_closure_matches_declared_conformance_closure_holds() -> Bool {
  set_equal(xs: reference_conformance_closure_accepted(), ys: expected_conformance_closure)
}

test fn reference_closure_drift_discriminates_over_declaration_red_holds() -> Bool {
  let with_bogus = list_snoc_item(xs: expected_conformance_closure, item: bogus_never_referenced)
  set_equal(xs: reference_conformance_closure_accepted(), ys: with_bogus) == false
}

test fn import_reference_closure_mismatch_discriminates_red_holds() -> Bool {
  let declared_without_entry = fold_list(
    xs: expected_conformance_closure,
    empty: no_paths,
    cons: fn(acc, p) {
      if string_eq(a: p, b: conformance_entry) {
        acc
      } else {
        list_snoc_item(xs: acc, item: p)
      }
    }
  )
  set_equal(xs: import_conformance_closure(), ys: declared_without_entry) == false
}

test fn reference_closure_ingest_refusal_is_rejected_not_empty_red_holds() -> Bool {
  match reference_closure_ingest_refusal_witness(pool_roots: witness_layer_roots) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}
