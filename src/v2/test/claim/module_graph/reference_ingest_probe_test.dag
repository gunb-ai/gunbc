module v2.test.module_graph.reference_ingest_probe

import extdeps.communication.fidelity_carriers { Lossless }
import extdeps.communication.medium { Medium }
import v2.compiler.normalize { normalize }
import v2.compiler.parse { parse, parse_module }
import v2.compiler.source_authority {
  normalize_dag_source_ast,
  parse_dag_source_ast_with_model
}
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_language_model }
import v2.lens.reference_deps { reference_deps_ingest_source_text }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.text { String }

data probe_path: String = "src/v2/test/claim/manual/coproduct_reflection_conformance_test.dag"
data probe_file: Symbol = ^reference_deps_file_anchor

fn probe_source_text() -> String {
  filesystem_read(path: probe_path).content
}

test fn tokenize_clean_holds() -> Bool {
  let lm = dag_language_model()
  match tokenize(text: probe_source_text(), file: probe_file, rules: lm.lex) {
    Rejected { diagnostics: _ } => false
    Accepted { value: _, diagnostics: _ } => true
  }
}

test fn parse_module_clean_holds() -> Bool {
  let lm = dag_language_model()
  match tokenize(text: probe_source_text(), file: probe_file, rules: lm.lex) {
    Rejected { diagnostics: _ } => false
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: _ } => false
        Accepted { value: _, diagnostics: _ } => true
      }
  }
}

test fn parse_clean_holds() -> Bool {
  let lm = dag_language_model()
  match tokenize(text: probe_source_text(), file: probe_file, rules: lm.lex) {
    Rejected { diagnostics: _ } => false
    Accepted { value: ts, diagnostics: _ } =>
      match parse(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: _ } => false
        Accepted { value: _, diagnostics: _ } => true
      }
  }
}

test fn normalize_clean_holds() -> Bool {
  let lm = dag_language_model()
  match tokenize(text: probe_source_text(), file: probe_file, rules: lm.lex) {
    Rejected { diagnostics: _ } => false
    Accepted { value: ts, diagnostics: _ } =>
      match parse(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: _ } => false
        Accepted { value: tree, diagnostics: _ } =>
          match normalize(parse_tree: tree) {
            Rejected { diagnostics: _ } => false
            Accepted { value: _, diagnostics: _ } => true
          }
      }
  }
}

test fn source_authority_ingest_clean_holds() -> Bool {
  let source = Medium { carried: probe_source_text(), fidelity: Lossless }
  let lm = dag_language_model()
  match parse_dag_source_ast_with_model(
    source: source,
    compilation_unit: probe_file,
    lm: lm
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: ast, diagnostics: _ } =>
      match normalize_dag_source_ast(ast: ast) {
        Rejected { diagnostics: _ } => false
        Accepted { value: _, diagnostics: _ } => true
      }
  }
}

test fn reference_deps_ingest_clean_holds() -> Bool {
  match reference_deps_ingest_source_text(
    source_text: probe_source_text(),
    file: probe_file
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: _, diagnostics: _ } => true
  }
}
