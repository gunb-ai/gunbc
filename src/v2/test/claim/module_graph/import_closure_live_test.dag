module v2.test.module_graph.import_closure_live

import v2.lens.module_graph { import_closure_live }
import gunbc.ci_layer_roots { witness_layer_roots }
import tools.rust_stage0_gates { coproduct_reflection_conformance_consumed_closure }
import v2.std.algebra { FreeMonoid, contains, for_all, list_snoc_item, fold_list }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }

data conformance_entry: String = "src/v2/test/claim/manual/coproduct_reflection_conformance_test.dag"

data bogus_never_imported: String = "src/v2/std/__bogus_never_imported__.dag"

data no_paths: FreeMonoid<String> = []

fn string_eq(a: String, b: String) -> Bool {
  a == b
}

fn set_subset(xs: FreeMonoid<String>, ys: FreeMonoid<String>) -> Bool {
  for_all(xs: xs, predicate: fn(x) { contains(xs: ys, item: x, eq: string_eq) })
}

fn set_equal(xs: FreeMonoid<String>, ys: FreeMonoid<String>) -> Bool {
  set_subset(xs: xs, ys: ys) && set_subset(xs: ys, ys: xs)
}

fn declared_paths() -> FreeMonoid<String> {
  coproduct_reflection_conformance_consumed_closure.consumed_dag_paths
}

fn declared_without_entry() -> FreeMonoid<String> {
  fold_list(
    xs: declared_paths(),
    empty: no_paths,
    cons: fn(acc, p) {
      if string_eq(a: p, b: conformance_entry) {
        acc
      } else {
        list_snoc_item(xs: acc, item: p)
      }
    }
  )
}

fn declared_with_bogus() -> FreeMonoid<String> {
  list_snoc_item(xs: declared_paths(), item: bogus_never_imported)
}

fn derived_conformance_closure() -> FreeMonoid<String> {
  import_closure_live(entry_path: conformance_entry, pool_roots: witness_layer_roots)
}

test fn dag_import_closure_equals_declared_conformance_closure() -> Bool {
  set_equal(xs: derived_conformance_closure(), ys: declared_paths())
}

test fn dag_import_closure_drift_discriminates_under_declaration() -> Bool {
  set_equal(xs: derived_conformance_closure(), ys: declared_without_entry()) == false
}

test fn dag_import_closure_drift_discriminates_over_declaration() -> Bool {
  set_equal(xs: derived_conformance_closure(), ys: declared_with_bogus()) == false
}
