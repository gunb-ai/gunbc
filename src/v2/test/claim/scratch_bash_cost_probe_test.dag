module v2.test.claim.scratch_bash_cost_probe

import std.logic { Bool }
import v2.extdeps.languages.bash_build {
  bash_build_command_with_words,
  bash_build_exit,
  bash_build_word_concat_parts,
  bash_build_word_lit,
  bash_build_word_var
}
import v2.workflow.bash_command_fold_serialize {
  bash_fold_serialize_node,
  bash_fold_serialize_word_node,
  bash_fold_serialize_program
}
import v2.workflow.build_step_emit { verifications_script }
import tools.build_step { BuildArtifact, build_test_not_executable, build_verify_echo, emit_verifications }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { Node }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn probe_path() -> Node {
  bash_build_word_concat_parts(parts: [
    bash_build_word_var(name: "ROOT"),
    bash_build_word_lit(text: "/target/release/probe_bin")
  ])
}

fn probe_artifact() -> BuildArtifact {
  BuildArtifact { path: probe_path(), name: "probe_bin" }
}

fn accepted_stmt(s: Node) -> Bool {
  match bash_fold_serialize_node(stmt: s) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn accepted_word(w: Node) -> Bool {
  match bash_fold_serialize_word_node(word: w) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn p0_build_stmts_only() -> Bool {
  emit_verifications(produces: [probe_artifact()]).length() == 2
}

test fn p1_lit_word() -> Bool {
  accepted_word(w: bash_build_word_lit(text: "echo"))
}

test fn p2_var_word() -> Bool {
  accepted_word(w: bash_build_word_var(name: "ROOT"))
}

test fn p3_concat_word() -> Bool {
  accepted_word(w: probe_path())
}

test fn p4_exit_stmt() -> Bool {
  accepted_stmt(s: bash_build_exit(code: "1"))
}

test fn p5_single_word_command() -> Bool {
  accepted_stmt(s: bash_build_command_with_words(words: [bash_build_word_lit(text: "true")]))
}

test fn p6_test_bracket_cond() -> Bool {
  accepted_stmt(s: build_test_not_executable(path: probe_path()))
}

test fn p7_echo_with_redir() -> Bool {
  accepted_stmt(s: build_verify_echo(msg: bash_build_word_lit(text: "hi")))
}

test fn p8_first_if_stmt() -> Bool {
  accepted_stmt(s: emit_verifications(produces: [probe_artifact()]).first())
}

test fn p9_whole_program() -> Bool {
  match verifications_script(produces: [probe_artifact()]) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn p10_whole_program_again() -> Bool {
  match verifications_script(produces: [probe_artifact()]) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}
