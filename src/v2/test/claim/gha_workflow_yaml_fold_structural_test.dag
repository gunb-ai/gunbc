module v2.test.claim.gha_workflow_yaml_fold_structural

import gunbc.gha_yaml_fold_pilot { gha_fold_pilot_job }
import v2.extdeps.languages.gha_workflow_yaml_fold {
  gha_fold_job_emitted_witness,
  gha_fold_relation_row_witness
}
import v2.std.logic { Bool }
import v2.std.witness { Holds, Violates }

fn gha_fold_relation_row_job_witness_holds() -> Bool {
  match gha_fold_job_emitted_witness(job: gha_fold_pilot_job) {
    Holds { value: emitted } =>
      match gha_fold_relation_row_witness(
        emitted: emitted,
        lhs: ^gha_production_fold_job
      ) {
        Holds { value: _ } => true
        Violates { diagnostic: _ } => false
      }
    Violates { diagnostic: _ } => false
  }
}

test fn gha_fold_structural_tier_holds() -> Bool {
  gha_fold_relation_row_job_witness_holds()
}
