  bla_infers(o: tpb_assemble(src: "module p\n\nfn positive(x: Int) -> Bool { true }\n\ntype Pos = Int where positive\n\ntype Pos2 = Pos where positive\n\ntype Neg = Int where positive\n\ntype R {\n  v: Int\n}\n\nfn f(x: Pos2) -> R {\n  R { v: x }\n}\n"))
}

fn bla_let_neg_pos() -> Outcome<Bool> {
  bla_infers(o: tpb_assemble(src: "module p\n\nfn positive(x: Int) -> Bool { true }\n\ntype Pos = Int where positive\n\ntype Pos2 = Pos where positive\n\ntype Neg = Int where positive\n\nfn f(x: Neg) -> Int {\n  let y: Pos = x\n  0\n}\n"))
}

fn bla_ret_neg_pos() -> Outcome<Bool> {
  bla_infers(o: tpb_assemble(src: "module p\n\nfn positive(x: Int) -> Bool { true }\n\ntype Pos = Int where positive\n\ntype Pos2 = Pos where positive\n\ntype Neg = Int where positive\n\nfn f(x: Neg) -> Pos {\n  x\n}\n"))
