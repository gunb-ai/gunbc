}

fn bla_fld_pos2_pos() -> Outcome<Bool> {
  bla_infers(o: tpb_assemble(src: "module p\n\nfn positive(x: Int) -> Bool { true }\n\ntype Pos = Int where positive\n\ntype Pos2 = Pos where positive\n\ntype Neg = Int where positive\n\ntype R {\n  v: Pos\n}\n\nfn f(x: Pos2) -> R {\n  R { v: x }\n}\n"))
}

fn bla_let_pos2_int() -> Outcome<Bool> {
  bla_infers(o: tpb_assemble(src: "module p\n\nfn positive(x: Int) -> Bool { true }\n\ntype Pos = Int where positive\n\ntype Pos2 = Pos where positive\n\ntype Neg = Int where positive\n\nfn f(x: Pos2) -> Int {\n  let y: Int = x\n  0\n}\n"))
}

fn bla_ret_pos2_int() -> Outcome<Bool> {
  bla_infers(o: tpb_assemble(src: "module p\n\nfn positive(x: Int) -> Bool { true }\n\ntype Pos = Int where positive\n\ntype Pos2 = Pos where positive\n\ntype Neg = Int where positive\n\nfn f(x: Pos2) -> Int {\n  x\n}\n"))
}

