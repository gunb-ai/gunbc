module v2.test.claim.body_let_annotation

import std.algebra { Cons, Empty }
import v2.std.coercion { NoTargetCandidate }
import v2.test.claim.type_param_binder_frame { tpb_accepts, tpb_assemble }
import v2.compiler.emit { emit }
import v2.compiler.infer { InferredFacts, InferredTree, infer }
import v2.extdeps.languages.dag { dag_arrow_domain_conj_node, dag_arrow_with_body_node, dag_type_atom_node }
import v2.extdeps.languages.rust_test { rust_binop_target_model_staging }
import v2.std.compilers.body_lowering { lower_bind, lower_bind_annotated }
import v2.std.collection { List, list_at_optional }
import v2.std.diagnostic {
  None,
  Accepted,
  NodeLocus,
  NonEmptyDiagnostics,
  Outcome,
  Rejected,
  diagnostics_fatal,
  diagnostics_fatal_reason,
  diagnostics_list_has_reason
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.node { named_edges, positional_edges, Atom, Bind, ComputationNode, Edge, Named, Node, Positional, Symbol, TypeNode, content_hash, node_subtree_nodes, node_synthetic }
import v2.std.optional { Absent, Optional, Present, optional_present }
import v2.std.type_binder { cast_target_edge, edge_is_type_annotation, type_annotation_edge, type_annotation_optional, type_binder_labels_conform }
import v2.compiler.reference_conservation_admission { conservation_subject_of_text }
import v2.compiler.normalized_tree { admit_normalized_tree }
import v2.compiler.resolve { resolve }
import v2.extdeps.languages.dag { dag_language_model }
import v2.std.algebra { length, list_snoc_item, skip }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// SUBJECT: a statement let's type annotation is CARRIED as the v2.std.type_binder
// <type-annotation> edge on its Bind -- through lowering, resolve (type-role frame) and infer (the
// bound value is checked against it) -- and translate refuses an annotated Bind until a target
// models it. BOUNDARY: source text in, assembled program out through
// v2.test.claim.type_param_binder_frame tpb_assemble -- the production route -- for lowering,
// resolve and infer; translate is driven over a supplied Bind whose shape rows (1)-(2) establish
// the real producer emits.
//
// RED BEFORE: on the parent of this change every annotated let refused
// body_lowering_reason_type_annotation_not_carried at its annotation (gunbc.rung_drop
// typed_statement_let_refuses_until_the_bind_annotation_carrier), so (1)-(5) were red.

fn bla_concrete() -> Outcome<Node> {
  tpb_assemble(src: "module p\n\nfn f(x: Int) -> Int {\n  let y: Int = x\n  y\n}\n")
}

fn bla_generic() -> Outcome<Node> {
  tpb_assemble(src: "module p\n\nfn f<T>(x: T) -> T {\n  let y: T = x\n  y\n}\n")
}

fn bla_type_param_as_value() -> Outcome<Node> {
  tpb_assemble(src: "module p\n\nfn f<T>(x: T) -> T {\n  let y: T = T\n  y\n}\n")
}

fn bla_value_param_as_type() -> Outcome<Node> {
  tpb_assemble(src: "module p\n\nfn f(Q: Int) -> Int {\n  let y: Q = Q\n  y\n}\n")
}

// The bound value is an Int sum, whose grounding infer DERIVES, so the check is judged rather than
// left on the frontier. A let-bound literal is not derived there, so it would leave the check
// unjudged and admit both rows without discriminating anything. The infer outcomes below are
// enrolled share points, so a claim reads the result and pays for none of the sum's derivation.
fn bla_int_sum_as_int() -> Outcome<Node> {
  tpb_assemble(src: "module p\n\nfn f(x: Int) -> Int {\n  let y: Int = x + x\n  y\n}\n")
}

fn bla_int_sum_as_bool() -> Outcome<Node> {
  tpb_assemble(src: "module p\n\nfn f(x: Int) -> Int {\n  let y: Bool = x + x\n  x\n}\n")
}

fn bla_annotations(n: Node) -> List<Node> {
  fold(node_subtree_nodes(root: n), init: Empty, f: fn(acc, x) {
    match type_annotation_optional(n: x) {
      Present { value: t } => Cons { head: t, tail: acc }
      Absent => acc
    }
  })
}

fn bla_atom_identity(n: Node) -> Optional<Symbol> {
  match n.kind {
    TypeNode { connective: Atom { identity: id } } => optional_present(value: id)
    _ => Absent
  }
}

// The one annotation a tree carries, as its atom identity; Absent when refused, when no Bind carries
// one, or when more than one does.
fn bla_annotation_identity(o: Outcome<Node>) -> Optional<Symbol> {
  match o {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: root, diagnostics: _ } =>
      match bla_annotations(n: root) {
        Cons { head: t, tail: Empty } => bla_atom_identity(n: t)
        _ => Absent
      }
  }
}

fn bla_atom_in(n: Node, id: Symbol) -> Bool {
  fold(node_subtree_nodes(root: n), init: false, f: fn(acc, x) {
    acc || match bla_atom_identity(n: x) {
      Present { value: s } => s == id
      Absent => false
    }
  })
}


// The annotation is a type expression; the bound value `x + x` is a Transform and the binder is `y`,
// so a locus holding no computation and no `y` is the annotation's.
fn bla_has_computation(n: Node) -> Bool {
  fold(node_subtree_nodes(root: n), init: false, f: fn(acc, x) {
    acc || match x.kind {
      ComputationNode { behavior: _ } => true
      _ => false
    }
  })
}

fn bla_has_reason(d: NonEmptyDiagnostics, reason: Symbol) -> Bool {
  diagnostics_list_has_reason(xs: Cons { head: d.head, tail: d.tail }, reason: reason)
}

// (1) A let annotation naming a declared type lowers and resolves, carrying exactly one annotation
// whose target is a resolved atom. A lowering that drops the edge reds this row: the count is 0.
test fn bla_concrete_annotation_is_carried() -> Bool {
  match bla_annotation_identity(o: bla_concrete()) {
    Present { value: _ } => true
    Absent => false
  }
}

// (2) The annotation resolves in the TYPE-ROLE frame: the enclosing fn's <T> binds a body
// annotation's `T`.
test fn bla_generic_annotation_binds_the_type_parameter() -> Bool {
  bla_annotation_identity(o: bla_generic()) == optional_present(value: ^T)
}

// (3) A type parameter in VALUE position still refuses, with its own reason, located at the value
// use: the frame that binds the annotation's `T` does not answer for the bound value's.
test fn bla_type_parameter_in_value_position_refuses_located() -> Bool {
  match bla_type_param_as_value() {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } =>
      (diagnostics_fatal_reason(d: d) == ^resolve_reason_type_parameter_in_value_position)
        && match diagnostics_fatal(d: d).at {
          NodeLocus { anchor: a } =>
            bla_atom_in(n: a.at, id: ^T)
              && !bla_atom_in(n: a.at, id: ^dag_token_kw_let)
              && !bla_atom_in(n: a.at, id: ^dag_token_eq)
          _ => false
        }
  }
}

// (4) ... and a VALUE binder never answers for the annotation: a parameter named `Q` leaves the
// annotation `Q` unbound.
test fn bla_value_binder_does_not_answer_the_annotation() -> Bool {
  match bla_value_param_as_type() {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => diagnostics_fatal_reason(d: d) == ^resolve_reason_unbound_symbol
  }
}

fn bla_infers(o: Outcome<Node>) -> Outcome<Bool> {
  match o {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: root, diagnostics: _ } =>
      match infer(tree: root) {
        Accepted { value: _, diagnostics: d } => Accepted { value: true, diagnostics: d }
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
      }
  }
}

// (5) INFER CHECKS THE BOUND VALUE AGAINST THE ANNOTATION through v2.std.coercion: an Int sum
// ascribed Int is admitted; the same sum ascribed Bool resolves and then refuses with coercion's
// typed mismatch as the cause, and a fatal of its own located at the annotation `Bool`, not at the
// sum. RED BEFORE the infer rule: the Bool ascription was admitted.
fn bla_int_sum_as_int_inferred() -> Outcome<Bool> {
  bla_infers(o: bla_int_sum_as_int())
}

fn bla_int_sum_as_bool_inferred() -> Outcome<Bool> {
  bla_infers(o: bla_int_sum_as_bool())
}

test fn bla_infer_admits_int_sum_ascribed_int() -> Bool {
  match bla_int_sum_as_int_inferred() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn bla_infer_refuses_int_sum_ascribed_bool() -> Bool {
  tpb_accepts(o: bla_int_sum_as_bool())
    && match bla_int_sum_as_bool_inferred() {
      Accepted { value: _, diagnostics: _ } => false
      Rejected { diagnostics: d } =>
        bla_has_reason(d: d, reason: discriminant(v: NoTargetCandidate))
          && (diagnostics_fatal_reason(d: d) == ^infer_reason_bound_value_does_not_inhabit_annotation)
          && match diagnostics_fatal(d: d).at {
            NodeLocus { anchor: a } =>
              !bla_has_computation(n: a.at) && !bla_atom_in(n: a.at, id: ^y)
            _ => false
          }
    }
}

// TRANSLATE is driven over the Bind rows (1)-(2) establish lowering produces: three positionals and
// the <type-annotation> edge.
fn bla_bind(annotated: Bool) -> Node {
  let key = dag_type_atom_node(identity: ^bla_y)
  let value = dag_type_atom_node(identity: ^dag_binding_param_x)
  let body = dag_type_atom_node(identity: ^bla_y)
  if annotated {
    lower_bind_annotated(key_binding: key, value: value, body_binding: body, annotation: dag_type_atom_node(identity: ^dag_binding_type_int))
  } else {
    lower_bind(key_binding: key, value: value, body_binding: body)
  }
}

fn bla_no_facts(key: Node) -> Optional<InferredFacts> {
  Absent
}

fn bla_emit_rust(body: Node) -> Outcome<String> {
  match emit(
    tree: InferredTree {
      root: dag_arrow_with_body_node(domain: dag_arrow_domain_conj_node(), return_type_binding: ^dag_binding_type_int, body: body),
      facts: PartialFunction { lookup: bla_no_facts }
    },
    target: rust_binop_target_model_staging()
  ) {
    Accepted { value: m, diagnostics: d } => Accepted { value: m.carried, diagnostics: d }
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}

fn bla_refused_for_annotation(o: Outcome<String>) -> Bool {
  match o {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => bla_has_reason(d: d, reason: ^target_value_expr_reason_bind_annotation_not_modeled)
  }
}

// (6) TRANSLATE REFUSES AN ANNOTATED BIND until a target models the annotation, rather than
// projecting it as a plain let and dropping the type ...
fn bla_annotated_bind_emitted() -> Outcome<String> {
  bla_emit_rust(body: bla_bind(annotated: true))
}

test fn bla_translate_refuses_an_annotated_bind() -> Bool {
  bla_refused_for_annotation(o: bla_annotated_bind_emitted())
}

// ... and the refusal is the annotation's: the accessor translate branches on answers the annotation
// for the annotated Bind and Absent for the same Bind without the edge. Read at the accessor, not
// through a second full emit.
test fn bla_translate_gate_is_the_annotations() -> Bool {
  (type_annotation_optional(n: bla_bind(annotated: true)) == optional_present(value: dag_type_atom_node(identity: ^dag_binding_type_int)))
    && (type_annotation_optional(n: bla_bind(annotated: false)) == Absent)
}

// (7) THE NAMED EDGE'S PLACE DOES NOT MOVE THE CONTENT HASH (v2.std.node
// PositionalPlusOneNamedEdges): the annotation first or last is one node.
test fn bla_annotation_order_does_not_move_the_hash() -> Bool {
  let key = Edge { label: Positional, target: dag_type_atom_node(identity: ^bla_y) }
  let value = Edge { label: Positional, target: dag_type_atom_node(identity: ^dag_binding_param_x) }
  let body = Edge { label: Positional, target: dag_type_atom_node(identity: ^bla_y) }
  let annotation = type_annotation_edge(annotation: dag_type_atom_node(identity: ^dag_binding_type_int))
  content_hash(n: node_synthetic(kind: ComputationNode { behavior: Bind }, children: [key, value, body, annotation]))
    == content_hash(n: node_synthetic(kind: ComputationNode { behavior: Bind }, children: [annotation, key, value, body]))
}

// (8) THE LABEL HALF: a Bind admits its own <type-annotation> and nothing else. v2.std.node admits one
// Named edge on a Bind by shape, so a Bind carrying a cast's <cast-target> passes the shape and must
// be refused here, by v2.std.type_binder type_binder_labels_conform, which resolve runs on the whole
// tree. Dropping the Bind arm of that rule greens the mislabelled Bind and reds this row.
test fn bla_bind_admits_only_its_annotation_label() -> Bool {
  let key = Edge { label: Positional, target: dag_type_atom_node(identity: ^bla_y) }
  let value = Edge { label: Positional, target: dag_type_atom_node(identity: ^dag_binding_param_x) }
  let body = Edge { label: Positional, target: dag_type_atom_node(identity: ^bla_y) }
  let t = dag_type_atom_node(identity: ^dag_binding_type_int)
  type_binder_labels_conform(root: node_synthetic(kind: ComputationNode { behavior: Bind }, children: [key, value, body, type_annotation_edge(annotation: t)]))
    && !type_binder_labels_conform(root: node_synthetic(kind: ComputationNode { behavior: Bind }, children: [key, value, body, cast_target_edge(target_type: t)]))
}

// (9) A BIND'S SLOTS ARE POSITIONAL, ON THE REAL RESOLVER. [binder, value, body, annotation] and
// [binder, annotation, value, body] are one node to content_hash, and resolve walks the tree as a
// producer wrote it -- so a reader that counted edge ordinals put the VALUE in the binder's inner
// scope once the annotation stood second, and `let y: Int = y` resolved its initializer against
// itself. The specimens are the production normalize route's output (v2.compiler
// .reference_conservation_admission conservation_subject_of_text), with every Bind's annotation
// moved to position 1, handed to v2.compiler.resolve resolve. The self-reference still refuses
// unbound; its twin binding the outer parameter `x` resolves, so the refusal is the initializer's
// and not the reordering's. Enrolled as share points: the real resolver runs once per specimen.
type BlaReorderedResolve {
  reordered: Bool
  fatal: Optional<Symbol>
}


// Every Bind's children rewritten as [binder, annotation, value, body]; any other node keeps its
// order. Children are rewritten first, so a nested Bind is moved too.
fn bla_annotation_second(n: Node) -> Node {
  let rebuilt = fold(n.children, init: [], f: fn(acc, e) {
    list_snoc_item(xs: acc, item: Edge { label: e.label, target: bla_annotation_second(n: e.target) })
  })
  let children = match n.kind {
    ComputationNode { behavior: Bind } =>
      let positionals = positional_edges(children: rebuilt)
      let binder = fold(positionals, init: [], f: fn(acc, e) { if length(xs: acc) == 0 { [e] } else { acc } })
      concat(concat(binder, named_edges(children: rebuilt)), skip(xs: positionals, n: 1))
    _ => rebuilt
  }
  Node { kind: n.kind, children: children, occurrence_id: n.occurrence_id }
}

fn bla_annotation_stands_second(root: Node) -> Bool {
  fold(node_subtree_nodes(root: root), init: false, f: fn(acc, n) {
    acc || match n.kind {
      ComputationNode { behavior: Bind } =>
        match list_at_optional(xs: n.children, index: 1) {
          Present { value: e } => edge_is_type_annotation(e: e)
          Absent => false
        }
      _ => false
    }
  })
}

fn bla_reordered_resolve(text: String) -> BlaReorderedResolve {
  match conservation_subject_of_text(path: "body_let_annotation_subject", text: text).normalized {
    Rejected { diagnostics: d } => BlaReorderedResolve { reordered: false, fatal: optional_present(value: diagnostics_fatal_reason(d: d)) }
    Accepted { value: t, diagnostics: _ } =>
      let root = bla_annotation_second(n: t.root)
      match admit_normalized_tree(root: root, test_markers: t.test_markers, import_bindings: t.import_bindings, record_declarations: t.record_declarations, diagnostics: None) {
        Rejected { diagnostics: d } => BlaReorderedResolve { reordered: false, fatal: optional_present(value: diagnostics_fatal_reason(d: d)) }
        Accepted { value: tree, diagnostics: _ } =>
          BlaReorderedResolve {
            reordered: bla_annotation_stands_second(root: root),
            fatal: match resolve(tree: tree, lm: dag_language_model()) {
              Accepted { value: _, diagnostics: _ } => Absent
              Rejected { diagnostics: d } => optional_present(value: diagnostics_fatal_reason(d: d))
            }
          }
      }
  }
}

fn bla_reordered_self_reference() -> BlaReorderedResolve {
  bla_reordered_resolve(text: "module m.t\nfn f(x: Int) -> Int {\n  let y: Int = y\n  y\n}\n")
}

fn bla_reordered_outer_reference() -> BlaReorderedResolve {
  bla_reordered_resolve(text: "module m.t\nfn f(x: Int) -> Int {\n  let y: Int = x\n  y\n}\n")
}

test fn bla_reordered_annotation_keeps_the_initializer_outside_its_binder() -> Bool {
  let bad = bla_reordered_self_reference()
  let good = bla_reordered_outer_reference()
  bad.reordered
    && good.reordered
    && (bad.fatal == optional_present(value: ^resolve_reason_unbound_symbol))
    && (good.fatal == Absent)
}
