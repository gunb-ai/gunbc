data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// SUBJECT: a statement let's type annotation is CARRIED as the v2.std.type_binder
// <type-annotation> edge on its Bind -- through lowering, resolve (type-role frame) and infer (the
// bound value is checked against it) -- and translate refuses an annotated Bind until a target
// models it. BOUNDARY: source text in, assembled program out through
// v2.test.claim.type_param_binder_frame tpb_assemble -- the production route -- for lowering,
// resolve and infer; translate is driven over a supplied Bind whose shape rows (1)-(2) establish
// the real producer emits.
//
// RED BEFORE: on the parent of this change every annotated let refused
// body_lowering_reason_type_annotation_not_carried at its annotation (gunbc.rung_drop
// typed_statement_let_refuses_until_the_bind_annotation_carrier), so (1)-(5) were red.

fn bla_concrete() -> Outcome<ResolvedTree> {
  tpb_assemble(src: "module p\n\nfn f(x: Int) -> Int {\n  let y: Int = x\n  y\n}\n")
}

fn bla_generic() -> Outcome<ResolvedTree> {
  tpb_assemble(src: "module p\n\nfn f<T>(x: T) -> T {\n  let y: T = x\n  y\n}\n")
}

fn bla_type_param_as_value() -> Outcome<ResolvedTree> {
  tpb_assemble(src: "module p\n\nfn f<T>(x: T) -> T {\n  let y: T = T\n  y\n}\n")
}

fn bla_value_param_as_type() -> Outcome<ResolvedTree> {
  tpb_assemble(src: "module p\n\nfn f(Q: Int) -> Int {\n  let y: Q = Q\n  y\n}\n")
}

// The bound value is an Int sum, whose grounding infer DERIVES, so the check is judged rather than
// left on the frontier. The infer outcomes below are enrolled share points, so a claim reads the
// result and pays for none of the sum's derivation.
fn bla_int_sum_as_int() -> Outcome<ResolvedTree> {
  tpb_assemble(src: "module p\n\nfn f(x: Int) -> Int {\n  let y: Int = x + x\n  y\n}\n")
}

fn bla_int_sum_as_bool() -> Outcome<ResolvedTree> {
  tpb_assemble(src: "module p\n\nfn f(x: Int) -> Int {\n  let y: Bool = x + x\n  x\n}\n")
}

// A let-bound int LITERAL grounds too: lowering hands infer the canonical literal
// (dag_token_int_literal with its magnitude payload) and infer derives it as Int, so the check is
// judged at the literal as well. Until main 980761c this was believed to sit on the
// GroundingNotDerived frontier (the #12322 handoff); rows (5b) pin that it does not.
fn bla_int_literal_as_int() -> Outcome<ResolvedTree> {
  tpb_assemble(src: "module p\n\nfn f(x: Int) -> Int {\n  let y: Int = 1\n  x\n}\n")
}

fn bla_int_literal_as_bool() -> Outcome<ResolvedTree> {
  tpb_assemble(src: "module p\n\nfn f(x: Int) -> Int {\n  let y: Bool = 1\n  x\n}\n")
}

fn bla_annotations(n: Node) -> List<Node> {
  fold(node_subtree_nodes(root: n), init: Empty, f: fn(acc, x) {
    match type_annotation_optional(n: x) {
      Present { value: t } => Cons { head: t, tail: acc }
      Absent => acc
    }
  })
}

fn bla_atom_identity(n: Node) -> Optional<Symbol> {
  match n.kind {
    TypeNode { connective: Atom { identity: id } } => optional_present(value: id)
    _ => Absent
  }
}

// The one annotation a tree carries, as its atom identity; Absent when refused, when no Bind carries
// one, or when more than one does.
fn bla_annotation_identity(o: Outcome<ResolvedTree>) -> Optional<Symbol> {
  match o {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: root, diagnostics: _ } =>
      match bla_annotations(n: root.root) {
        Cons { head: t, tail: Empty } => bla_atom_identity(n: t)
        _ => Absent
      }
  }
}

fn bla_atom_in(n: Node, id: Symbol) -> Bool {
  fold(node_subtree_nodes(root: n), init: false, f: fn(acc, x) {
    acc || match bla_atom_identity(n: x) {
      Present { value: s } => s == id
      Absent => false
    }
  })
}


// The annotation is a type expression; the bound value `x + x` is a Transform and the binder is `y`,
// so a locus holding no computation and no `y` is the annotation's.
fn bla_has_computation(n: Node) -> Bool {
  fold(node_subtree_nodes(root: n), init: false, f: fn(acc, x) {
    acc || match x.kind {
      ComputationNode { behavior: _ } => true
      _ => false
    }
  })
}

fn bla_has_reason(d: NonEmptyDiagnostics, reason: Symbol) -> Bool {
  diagnostics_list_has_reason(xs: Cons { head: d.head, tail: d.tail }, reason: reason)
}

// (1) A let annotation naming a declared type lowers and resolves, carrying exactly one annotation
// whose target is a resolved atom. A lowering that drops the edge reds this row: the count is 0.
test fn bla_concrete_annotation_is_carried() -> Bool {
  match bla_annotation_identity(o: bla_concrete()) {
    Present { value: _ } => true
    Absent => false
  }
}

// (2) The annotation resolves in the TYPE-ROLE frame: the enclosing fn's <T> binds a body
// annotation's `T`.
test fn bla_generic_annotation_binds_the_type_parameter() -> Bool {
  bla_annotation_identity(o: bla_generic()) == optional_present(value: ^T)
}

// (3) A type parameter in VALUE position still refuses, with its own reason, located at the value
// use: the frame that binds the annotation's `T` does not answer for the bound value's.
test fn bla_type_parameter_in_value_position_refuses_located() -> Bool {
  match bla_type_param_as_value() {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } =>
      (diagnostics_fatal_reason(d: d) == ^resolve_reason_type_parameter_in_value_position)
        && match diagnostics_fatal(d: d).at {
          NodeLocus { anchor: a } =>
            bla_atom_in(n: a.at, id: ^T)
              && !bla_atom_in(n: a.at, id: ^dag_token_kw_let)
              && !bla_atom_in(n: a.at, id: ^dag_token_eq)
          _ => false
        }
  }
}

// (4) ... and a VALUE binder never answers for the annotation: a parameter named `Q` leaves the
// annotation `Q` unbound.
test fn bla_value_binder_does_not_answer_the_annotation() -> Bool {
  match bla_value_param_as_type() {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => diagnostics_fatal_reason(d: d) == ^resolve_reason_unbound_symbol
  }
}

fn bla_infers(o: Outcome<ResolvedTree>) -> Outcome<Bool> {
  match o {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: root, diagnostics: _ } =>
      match infer(tree: root) {
        Accepted { value: _, diagnostics: d } => Accepted { value: true, diagnostics: d }
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
      }
  }
}

// THE ROUTE: a let's refusal is v2.std.inhabitance's, judged at PositionLetAnnotation -- its
// correction names that position -- not v2.std.coercion's cast mismatch (NoTargetCandidate), which
// is what the let answered while it was judged by the cast relation
// (gunbc.recurring_failure_mode annotated_let_judged_by_the_cast_relation_not_the_inhabitance_relation).
fn bla_judged_at_the_let_position(d: NonEmptyDiagnostics) -> Bool {
  match diagnostics_fatal(d: d).correction {
    Suggested { node: n } =>
      fold(n.children, init: false, f: fn(acc, e) {
        acc || match e.label {
          Authored { name: nm } => nm == ^position_let_annotation
          _ => false
        }
      })
    _ => false
  }
}

// (5) INFER JUDGES THE BOUND VALUE AT THE ANNOTATION through v2.std.inhabitance, the relation an
// argument meets at its formal: an Int sum ascribed Int is admitted; the same sum ascribed Bool
// resolves and then refuses at the let position, located at the annotation `Bool`, not at the
// sum. RED BEFORE the infer rule: the Bool ascription was admitted.
fn bla_int_sum_as_int_inferred() -> Outcome<Bool> {
  bla_infers(o: bla_int_sum_as_int())
}

fn bla_int_sum_as_bool_inferred() -> Outcome<Bool> {
  bla_infers(o: bla_int_sum_as_bool())
}

test fn bla_infer_admits_int_sum_ascribed_int() -> Bool {
  match bla_int_sum_as_int_inferred() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn bla_infer_refuses_int_sum_ascribed_bool() -> Bool {
  tpb_accepts(o: bla_int_sum_as_bool())
    && match bla_int_sum_as_bool_inferred() {
      Accepted { value: _, diagnostics: _ } => false
      Rejected { diagnostics: d } =>
        bla_judged_at_the_let_position(d: d)
          && (diagnostics_fatal_reason(d: d) == ^infer_reason_bound_value_does_not_inhabit_annotation)
          && match diagnostics_fatal(d: d).at {
            NodeLocus { anchor: a } =>
              !bla_has_computation(n: a.at) && !bla_atom_in(n: a.at, id: ^y)
            _ => false
          }
    }
}

// (5b) THE SAME CHECK IS JUDGED AT A LET-BOUND LITERAL: `1` ascribed Int is admitted; `1` ascribed
// Bool refuses at the let position with the annotation's own fatal. RED if the
// literal falls back to the GroundingNotDerived frontier: the Bool ascription is then admitted.
fn bla_int_literal_as_int_inferred() -> Outcome<Bool> {
  bla_infers(o: bla_int_literal_as_int())
}

fn bla_int_literal_as_bool_inferred() -> Outcome<Bool> {
  bla_infers(o: bla_int_literal_as_bool())
}

test fn bla_infer_admits_int_literal_ascribed_int() -> Bool {
  match bla_int_literal_as_int_inferred() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn bla_infer_refuses_int_literal_ascribed_bool() -> Bool {
  tpb_accepts(o: bla_int_literal_as_bool())
    && match bla_int_literal_as_bool_inferred() {
      Accepted { value: _, diagnostics: _ } => false
      Rejected { diagnostics: d } =>
        bla_judged_at_the_let_position(d: d)
          && (diagnostics_fatal_reason(d: d) == ^infer_reason_bound_value_does_not_inhabit_annotation)
    }
}

// (5e) ONE RELATION FOR EVERY DECLARED POSITION (gunbc.recurring_failure_mode
// annotated_let_judged_by_the_cast_relation_not_the_inhabitance_relation). Each row states the
// same value at a let, at a declared return and at a record field -- the declared positions a source
// program reaches the relation at today -- and the verdicts must agree. (A call to a NAMED fn does not
// reach it from source: infer reads no formals off a callee reference, FormalsUnresolved,
// gunbc.recurring_failure_mode argument_type_obligation_absent_while_the_route_advances; the argument
// position's widening is claimed on the relation with a supplied obligation,
// v2.test.claim.compiler.infer_application_argument_inhabitance_witness_test.)
// - An optional at a required Int refuses at EACH with the one relation's own reason
//   (v2.std.inhabitance inhabitance_optional_produced_at_required_declared). RED while the let was
//   judged by the cast relation: its refusal carried coercion's mismatch, never this reason.
// - A refinement value (`x: Pos`, `type Pos = Int where positive`) inhabits its declared carrier Int
//   at each, admitted AND decided. RED BEFORE: the return and the field refused (no widening in the
//   relation).
// - One step only: `x: Pos2` (`type Pos2 = Pos where ..`) inhabits Pos and not Int, at each.
// - A sibling refinement (`x: Neg` at Pos, both refinements of Int) refuses at each.
fn bla_let_optional() -> Outcome<Bool> {
  bla_infers(o: tpb_assemble(src: "module p\n\nfn positive(x: Int) -> Bool { true }\n\ntype Pos = Int where positive\n\ntype Pos2 = Pos where positive\n\ntype Neg = Int where positive\n\nfn f(x: Int?) -> Int {\n  let y: Int = x\n  0\n}\n"))
}

fn bla_ret_optional() -> Outcome<Bool> {
  bla_infers(o: tpb_assemble(src: "module p\n\nfn positive(x: Int) -> Bool { true }\n\ntype Pos = Int where positive\n\ntype Pos2 = Pos where positive\n\ntype Neg = Int where positive\n\nfn f(x: Int?) -> Int {\n  x\n}\n"))
}

fn bla_fld_optional() -> Outcome<Bool> {
  bla_infers(o: tpb_assemble(src: "module p\n\nfn positive(x: Int) -> Bool { true }\n\ntype Pos = Int where positive\n\ntype Pos2 = Pos where positive\n\ntype Neg = Int where positive\n\ntype R {\n  v: Int\n}\n\nfn f(x: Int?) -> R {\n  R { v: x }\n}\n"))
}

fn bla_let_pos_int() -> Outcome<Bool> {
  bla_infers(o: tpb_assemble(src: "module p\n\nfn positive(x: Int) -> Bool { true }\n\ntype Pos = Int where positive\n\ntype Pos2 = Pos where positive\n\ntype Neg = Int where positive\n\nfn f(x: Pos) -> Int {\n  let y: Int = x\n  0\n}\n"))
}

fn bla_ret_pos_int() -> Outcome<Bool> {
  bla_infers(o: tpb_assemble(src: "module p\n\nfn positive(x: Int) -> Bool { true }\n\ntype Pos = Int where positive\n\ntype Pos2 = Pos where positive\n\ntype Neg = Int where positive\n\nfn f(x: Pos) -> Int {\n  x\n}\n"))
}

fn bla_fld_pos_int() -> Outcome<Bool> {
  bla_infers(o: tpb_assemble(src: "module p\n\nfn positive(x: Int) -> Bool { true }\n\ntype Pos = Int where positive\n\ntype Pos2 = Pos where positive\n\ntype Neg = Int where positive\n\ntype R {\n  v: Int\n}\n\nfn f(x: Pos) -> R {\n  R { v: x }\n}\n"))
}

fn bla_let_pos2_pos() -> Outcome<Bool> {
  bla_infers(o: tpb_assemble(src: "module p\n\nfn positive(x: Int) -> Bool { true }\n\ntype Pos = Int where positive\n\ntype Pos2 = Pos where positive\n\ntype Neg = Int where positive\n\nfn f(x: Pos2) -> Int {\n  let y: Pos = x\n  0\n}\n"))
