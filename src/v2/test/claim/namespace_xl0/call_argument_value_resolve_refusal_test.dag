// ONE FRONT END FOR EVERY CLAIM, enrolled WARM in v2.workflow.floor_pure_producer_share for the
// reason v2.test.claim.namespace_xl0.sequence_operand_resolve_refusal sqo_outcomes is: the stored
// value is a verdict per module with no resolution context, Node or closure in it.
type CavVerdict
  = CavResolved
  | CavRefused { reason: Symbol, at_atom: Optional<Symbol> }
  | CavFileRefused { fatal_reason: Optional<Symbol> }
  | CavAbsent

type CavOutcomes
  = CavContextRefused
  | CavOutcomesDecided {
      list_named: CavVerdict
      list_positional: CavVerdict
      call_named: CavVerdict
      call_list: CavVerdict
      call_positional: CavVerdict
      record: CavVerdict
      record_list: CavVerdict
      group: CavVerdict
      literals: CavVerdict
      empty_list: CavVerdict
      declared_inside: CavVerdict
      plain_name: CavVerdict
      match_scrutinee: CavVerdict
    }

fn cav_file_refusal_reason(context: NativeTestContext, unit: Symbol) -> Optional<Symbol> {
  fold_list(
    xs: context.file_refusals,
    empty: optional_absent(),
    cons: fn(acc, refusal) {
      if refusal.path == unit { optional_present(value: refusal.fatal_reason) } else { acc }
    }
  )
}

fn cav_verdict_of(context: NativeTestContext, unit: Symbol, outcome: NativeCensusModuleOutcome) -> CavVerdict {
  match outcome {
    NativeCensusModuleResolved => CavResolved
    NativeCensusModuleFileRefused =>
      CavFileRefused { fatal_reason: cav_file_refusal_reason(context: context, unit: unit) }
    NativeCensusModuleResolveRefused { first: d, rest: _, observation: _ } =>
      CavRefused {
        reason: d.head.reason,
        at_atom: match d.head.at {
          NodeLocus { anchor: a } => node_atom_identity_optional(node: a.at)
          _ => optional_absent()
        }
      }
  }
}

fn cav_verdict_in(context: NativeTestContext, module_name: String, unit: Symbol) -> CavVerdict {
  fold_list(
    xs: native_census_modules(ingest: cav_ingest),
    empty: CavAbsent,
    cons: fn(acc, entry) {
      if entry.module == module_name {
        cav_verdict_of(
          context: context,
          unit: unit,
          outcome: native_census_module_resolution(
            context: context,
            refusal_index: native_lane_file_refusal_index(refusals: context.file_refusals),
            entry: entry
          )
        )
      } else {
        acc
      }
    }
  )
}

fn cav_outcomes() -> CavOutcomes {
  match native_test_context_from_ingest(ingest: cav_ingest) {
    Rejected { diagnostics: _ } => CavContextRefused
    Accepted { value: context, diagnostics: _ } =>
      CavOutcomesDecided {
        list_named: cav_verdict_in(context: context, module_name: "v2.test.cav_list_named", unit: ^cav_list_named_cu),
        list_positional: cav_verdict_in(context: context, module_name: "v2.test.cav_list_positional", unit: ^cav_list_positional_cu),
        call_named: cav_verdict_in(context: context, module_name: "v2.test.cav_call_named", unit: ^cav_call_named_cu),
        call_list: cav_verdict_in(context: context, module_name: "v2.test.cav_call_list", unit: ^cav_call_list_cu),
        call_positional: cav_verdict_in(context: context, module_name: "v2.test.cav_call_positional", unit: ^cav_call_positional_cu),
        record: cav_verdict_in(context: context, module_name: "v2.test.cav_record", unit: ^cav_record_cu),
        record_list: cav_verdict_in(context: context, module_name: "v2.test.cav_record_list", unit: ^cav_record_list_cu),
        group: cav_verdict_in(context: context, module_name: "v2.test.cav_group", unit: ^cav_group_cu),
        literals: cav_verdict_in(context: context, module_name: "v2.test.cav_literals", unit: ^cav_literals_cu),
        empty_list: cav_verdict_in(context: context, module_name: "v2.test.cav_empty_list", unit: ^cav_empty_list_cu),
        declared_inside: cav_verdict_in(context: context, module_name: "v2.test.cav_declared_inside", unit: ^cav_declared_inside_cu),
        plain_name: cav_verdict_in(context: context, module_name: "v2.test.cav_plain_name", unit: ^cav_plain_name_cu),
        match_scrutinee: cav_verdict_in(context: context, module_name: "v2.test.cav_match_scrutinee", unit: ^cav_match_scrutinee_cu)
      }
  }
}

fn cav_is_resolved(v: CavVerdict) -> Bool {
  match v {
    CavResolved => true
    _ => false
  }
}

// A list argument is no longer refused at normalize: v2.compiler.body_lowering_fold
// body_lower_list_literal lowers it as its free-monoid construction and the module REACHES RESOLVE.
// The verdict is "reached resolve", not "unbound at the element's atom", because this ingest does
// not carry v2.std.algebra, whose operations the lowered list calls, so which reference resolve
// reports first is not this claim's subject. That every element is lowered, in order, is claimed
// on the lowered tree by v2.test.claim.namespace_xl0.list_literal_value_lowering. Before the
// producer these modules were CavFileRefused under body_lowering_reason_list_literal_unlowered.
fn cav_reached_resolve(v: CavVerdict) -> Bool {
  match v {
    CavRefused { reason: _, at_atom: _ } => true
    CavResolved => true
    _ => false
  }
}

// Refused at resolve, the first refusal is unbound, and its locus is the name's own atom.
fn cav_is_unbound_at(v: CavVerdict, spelling: Symbol) -> Bool {
  match v {
    CavRefused { reason: r, at_atom: Present { value: id } } =>
      (r == ^resolve_reason_unbound_symbol) && (id == spelling)
    _ => false
  }
}

test fn a_named_list_argument_reaches_resolve() -> Bool {
  match cav_outcomes() {
    CavOutcomesDecided { list_named: v, list_positional: _, call_named: _, call_list: _, call_positional: _, record: _, record_list: _, group: _, literals: _, empty_list: _, declared_inside: _, plain_name: _, match_scrutinee: _ } =>
      cav_reached_resolve(v: v)
    CavContextRefused => false
  }
}

test fn a_positional_list_argument_reaches_resolve() -> Bool {
  match cav_outcomes() {
    CavOutcomesDecided { list_named: _, list_positional: v, call_named: _, call_list: _, call_positional: _, record: _, record_list: _, group: _, literals: _, empty_list: _, declared_inside: _, plain_name: _, match_scrutinee: _ } =>
      cav_reached_resolve(v: v)
    CavContextRefused => false
  }
}

test fn an_undeclared_name_in_a_nested_call_argument_refuses_at_resolve_at_its_atom() -> Bool {
  match cav_outcomes() {
    CavOutcomesDecided { list_named: _, list_positional: _, call_named: v, call_list: _, call_positional: _, record: _, record_list: _, group: _, literals: _, empty_list: _, declared_inside: _, plain_name: _, match_scrutinee: _ } =>
      cav_is_unbound_at(v: v, spelling: ^cav_undeclared_call_named)
    CavContextRefused => false
  }
}

