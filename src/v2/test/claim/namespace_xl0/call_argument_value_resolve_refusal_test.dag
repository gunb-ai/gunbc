data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// A CALL ARGUMENT WHOSE VALUE IS A LIST, A NESTED CALL, A RECORD OR A GROUP IS READ WHOLE, AND AN
// UNDECLARED NAME INSIDE IT REFUSES AT RESOLVE, AT ITS ATOM.
//
// THE SUBJECT IS THE NATIVE LANE'S FRONT END AND RESOLVE: native_test_context_from_ingest
// tokenizes, parses, normalizes and indexes the supplied sources, and native_census_module_resolution
// resolves one module against it. v2.compiler.body_lowering_fold body_lower_call_arg_value read an
// argument's value with the operand reader alone. Before gunbc#12145 that reader narrowed any
// sequence to its left element, so `h(q: a)` read as `h` and `[a]` as `[` and the names inside were
// silently dropped; after it, the same arguments answered Absent and body_lower_call_arg_value refused
// the WHOLE module as call_argument_unread. The value is now lowered by body_lower_value_lowered, the
// reader field initializers and if-conditions use, with the operand reader as its fallback.
//
// A MATCH SCRUTINEE IS THE SAME KIND OF VALUE: body_lower_match_scrutinee_optional read it with the
// operand reader alone, so `match t(p: x) {..}` narrowed to `t` before gunbc#12145 and refused the whole
// match after it; it now goes through body_lower_value_lowered too.
//
// THE MODULES VARY ONE THING EACH. Seven candidates put an undeclared name inside a named list, a
// positional list, a nested call, a list inside a nested call, a positional nested call, a record
// literal and a parenthesised group; on main each refused normalize, before gunbc#12145 each resolved
// with the name dropped. Three controls must resolve: literal and string lists, an empty list and a
// nullary call, and declared names in the same positions -- so reading an argument whole is not by
// itself a refusal. The plain-name module is the neighbour main already read, refusing on both sides.
data cav_list_named_source: String = "module v2.test.cav_list_named\n\nimport v2.std.logic { Bool }\n\ntype CavRecord { f: Bool }\n\nfn cav_h(xs: Bool) -> Bool { xs }\n\nfn cav_g(a: Bool, b: Bool) -> Bool { a }\n\nfn cav_t(p: Bool) -> Bool { p }\n\nfn cav_probe(c: Bool) -> Bool { cav_h(xs: [cav_undeclared_list_named]) }\n"

data cav_list_positional_source: String = "module v2.test.cav_list_positional\n\nimport v2.std.logic { Bool }\n\ntype CavRecord { f: Bool }\n\nfn cav_h(xs: Bool) -> Bool { xs }\n\nfn cav_g(a: Bool, b: Bool) -> Bool { a }\n\nfn cav_t(p: Bool) -> Bool { p }\n\nfn cav_probe(c: Bool) -> Bool { cav_h([cav_undeclared_list_positional]) }\n"

data cav_call_named_source: String = "module v2.test.cav_call_named\n\nimport v2.std.logic { Bool }\n\ntype CavRecord { f: Bool }\n\nfn cav_h(xs: Bool) -> Bool { xs }\n\nfn cav_g(a: Bool, b: Bool) -> Bool { a }\n\nfn cav_t(p: Bool) -> Bool { p }\n\nfn cav_probe(c: Bool) -> Bool { cav_g(a: cav_t(p: cav_undeclared_call_named), b: true) }\n"

data cav_call_list_source: String = "module v2.test.cav_call_list\n\nimport v2.std.logic { Bool }\n\ntype CavRecord { f: Bool }\n\nfn cav_h(xs: Bool) -> Bool { xs }\n\nfn cav_g(a: Bool, b: Bool) -> Bool { a }\n\nfn cav_t(p: Bool) -> Bool { p }\n\nfn cav_probe(c: Bool) -> Bool { cav_g(a: true, b: cav_h(xs: [cav_undeclared_call_list])) }\n"

data cav_call_positional_source: String = "module v2.test.cav_call_positional\n\nimport v2.std.logic { Bool }\n\ntype CavRecord { f: Bool }\n\nfn cav_h(xs: Bool) -> Bool { xs }\n\nfn cav_g(a: Bool, b: Bool) -> Bool { a }\n\nfn cav_t(p: Bool) -> Bool { p }\n\nfn cav_probe(c: Bool) -> Bool { cav_h(cav_t(p: cav_undeclared_call_positional)) }\n"

data cav_record_source: String = "module v2.test.cav_record\n\nimport v2.std.logic { Bool }\n\ntype CavRecord { f: Bool }\n\nfn cav_h(xs: Bool) -> Bool { xs }\n\nfn cav_g(a: Bool, b: Bool) -> Bool { a }\n\nfn cav_t(p: Bool) -> Bool { p }\n\nfn cav_probe(c: Bool) -> Bool { cav_h(xs: CavRecord { f: cav_undeclared_record }) }\n"

data cav_record_list_source: String = "module v2.test.cav_record_list\n\nimport v2.std.logic { Bool }\n\ntype CavRecord { f: Bool }\n\nfn cav_h(xs: Bool) -> Bool { xs }\n\nfn cav_g(a: Bool, b: Bool) -> Bool { a }\n\nfn cav_t(p: Bool) -> Bool { p }\n\nfn cav_probe(c: Bool) -> Bool { cav_h(xs: CavRecord { f: [cav_undeclared_record_list] }) }\n"

data cav_group_source: String = "module v2.test.cav_group\n\nimport v2.std.logic { Bool }\n\ntype CavRecord { f: Bool }\n\nfn cav_h(xs: Bool) -> Bool { xs }\n\nfn cav_g(a: Bool, b: Bool) -> Bool { a }\n\nfn cav_t(p: Bool) -> Bool { p }\n\nfn cav_probe(c: Bool) -> Bool { cav_h(xs: (cav_undeclared_group)) }\n"

data cav_literals_source: String = "module v2.test.cav_literals\n\nimport v2.std.logic { Bool }\n\ntype CavRecord { f: Bool }\n\nfn cav_h(xs: Bool) -> Bool { xs }\n\nfn cav_g(a: Bool, b: Bool) -> Bool { a }\n\nfn cav_t(p: Bool) -> Bool { p }\n\nfn cav_probe(c: Bool) -> Bool { cav_g(a: 1, b: cav_h(xs: \"a\")) }\n"

data cav_empty_list_source: String = "module v2.test.cav_empty_list\n\nimport v2.std.logic { Bool }\n\ntype CavRecord { f: Bool }\n\nfn cav_h(xs: Bool) -> Bool { xs }\n\nfn cav_g(a: Bool, b: Bool) -> Bool { a }\n\nfn cav_t(p: Bool) -> Bool { p }\n\nfn cav_probe(c: Bool) -> Bool { cav_g(a: cav_t(), b: 2) }\n"

data cav_declared_inside_source: String = "module v2.test.cav_declared_inside\n\nimport v2.std.logic { Bool }\n\ntype CavRecord { f: Bool }\n\nfn cav_h(xs: Bool) -> Bool { xs }\n\nfn cav_g(a: Bool, b: Bool) -> Bool { a }\n\nfn cav_t(p: Bool) -> Bool { p }\n\ndata cav_declared: Bool = true\n\nfn cav_probe(c: Bool) -> Bool { cav_g(a: cav_t(p: cav_declared), b: cav_h(xs: CavRecord { f: cav_declared })) }\n"

data cav_plain_name_source: String = "module v2.test.cav_plain_name\n\nimport v2.std.logic { Bool }\n\ntype CavRecord { f: Bool }\n\nfn cav_h(xs: Bool) -> Bool { xs }\n\nfn cav_g(a: Bool, b: Bool) -> Bool { a }\n\nfn cav_t(p: Bool) -> Bool { p }\n\nfn cav_probe(c: Bool) -> Bool { cav_g(a: 1, b: cav_undeclared_plain) }\n"

data cav_match_scrutinee_source: String = "module v2.test.cav_match_scrutinee\n\nimport v2.std.logic { Bool }\n\ntype CavRecord { f: Bool }\n\nfn cav_h(xs: Bool) -> Bool { xs }\n\nfn cav_g(a: Bool, b: Bool) -> Bool { a }\n\nfn cav_t(p: Bool) -> Bool { p }\n\nfn cav_probe(c: Bool) -> Bool {\n  match cav_t(p: cav_undeclared_scrutinee) {\n    true => c\n    false => c\n  }\n}\n"

fn cav_read(source: String, id: Symbol, unit: Symbol, path: String) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: source, fidelity: Lossless },
    artifact: Artifact { kind: SourceFile, id: id, file_path: path },
    compilation_unit: unit,
    source_root: DagTree
  }
}

data cav_ingest: SourceRootIngest = Cons {
    head: cav_read(source: cav_list_named_source, id: ^cav_list_named_artifact, unit: ^cav_list_named_cu, path: "src/v2/test/fixture/namespace_xl0/cav_list_named.dag"),
    tail: Cons {
    head: cav_read(source: cav_list_positional_source, id: ^cav_list_positional_artifact, unit: ^cav_list_positional_cu, path: "src/v2/test/fixture/namespace_xl0/cav_list_positional.dag"),
    tail: Cons {
    head: cav_read(source: cav_call_named_source, id: ^cav_call_named_artifact, unit: ^cav_call_named_cu, path: "src/v2/test/fixture/namespace_xl0/cav_call_named.dag"),
    tail: Cons {
    head: cav_read(source: cav_call_list_source, id: ^cav_call_list_artifact, unit: ^cav_call_list_cu, path: "src/v2/test/fixture/namespace_xl0/cav_call_list.dag"),
    tail: Cons {
    head: cav_read(source: cav_call_positional_source, id: ^cav_call_positional_artifact, unit: ^cav_call_positional_cu, path: "src/v2/test/fixture/namespace_xl0/cav_call_positional.dag"),
    tail: Cons {
    head: cav_read(source: cav_record_source, id: ^cav_record_artifact, unit: ^cav_record_cu, path: "src/v2/test/fixture/namespace_xl0/cav_record.dag"),
    tail: Cons {
    head: cav_read(source: cav_record_list_source, id: ^cav_record_list_artifact, unit: ^cav_record_list_cu, path: "src/v2/test/fixture/namespace_xl0/cav_record_list.dag"),
    tail: Cons {
    head: cav_read(source: cav_group_source, id: ^cav_group_artifact, unit: ^cav_group_cu, path: "src/v2/test/fixture/namespace_xl0/cav_group.dag"),
    tail: Cons {
    head: cav_read(source: cav_literals_source, id: ^cav_literals_artifact, unit: ^cav_literals_cu, path: "src/v2/test/fixture/namespace_xl0/cav_literals.dag"),
    tail: Cons {
    head: cav_read(source: cav_empty_list_source, id: ^cav_empty_list_artifact, unit: ^cav_empty_list_cu, path: "src/v2/test/fixture/namespace_xl0/cav_empty_list.dag"),
    tail: Cons {
