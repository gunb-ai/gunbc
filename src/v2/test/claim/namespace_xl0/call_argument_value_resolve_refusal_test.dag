    tail: Cons {
    head: cav_read(source: cav_match_scrutinee_source, id: ^cav_match_scrutinee_artifact, unit: ^cav_match_scrutinee_cu, path: "src/v2/test/fixture/namespace_xl0/cav_match_scrutinee.dag"),
    tail: Empty
  }
  }
  }
  }
