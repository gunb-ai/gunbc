data lst_arm_block_if_match_source: String = "module v2.test.fixture.namespace_xl0.lst_arm_block_if_match\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LstS = LstA { v: Int } | LstB\n\nfn lst_uses(x: Int) -> Int { x }\n\nfn lst_predicate(i: Int) -> Bool { i > 0 }\n\n// The shape dag/gunbc/instruments/fabric_control_plane_live_probe.dag:1053 authored: a braced arm block\n// whose first statement binds an `if` whose branches are matches, and whose last statement reads that\n// binding. Resolving it means the block is read as a statement sequence, not as a head.\nfn lst_probe(s: LstS, i: Int) -> Int { match s {\n  LstA { v: v } => {\n    let chosen = if lst_predicate(i: v) {\n      match s {\n        LstA { v: w } => lst_uses(x: w)\n        LstB => i\n      }\n    } else {\n      match s {\n        LstA { v: w } => lst_uses(x: w)\n        LstB => 0\n      }\n    }\n    let shifted = chosen + 1\n    lst_uses(x: shifted)\n  }\n  LstB => i\n} }\n"
