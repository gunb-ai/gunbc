module v2.test.claim.namespace_xl0.zz_xl2_probe

import v2.test.claim.namespace_xl0.dropped_shape_resolve_refusal { an_undeclared_call_argument_in_a_then_arm_refuses_at_resolve_at_its_atom, an_undeclared_call_argument_in_an_else_arm_refuses_at_resolve_at_its_atom, a_declared_call_argument_in_an_arm_resolves, an_undeclared_call_argument_outside_an_if_refuses_at_resolve_at_its_atom, a_second_statement_after_a_non_binding_one_refuses_at_normalize, an_undeclared_statement_after_a_let_refuses_at_resolve_at_its_atom, a_let_bound_continuation_resolves, an_undeclared_name_in_a_parenthesised_operand_of_a_match_arm_refuses_at_resolve_at_its_atom, an_undeclared_name_in_a_parenthesised_operand_of_a_let_value_refuses_at_resolve_at_its_atom, an_undeclared_name_in_a_parenthesised_operand_of_a_call_argument_refuses_at_resolve_at_its_atom, a_declared_name_in_a_parenthesised_operand_resolves, an_undeclared_plain_right_operand_of_a_call_argument_refuses_at_resolve_at_its_atom }
import v2.test.claim.body_lowering.statement_let_bind { statement_let_then_reference_lowers_holds, statement_let_chain_lowers_holds, unbound_statement_prefix_refuses_holds, single_statement_body_unchanged_holds, let_in_form_unchanged_holds, typed_statement_let_lowers_holds }
import std.process { ProcessExit, ExitSuccess, ExitFailure }
import v2.std.logic { Bool }
import v2.std.text { String }

fn zz_bit(ok: Bool, w: String) -> String { if ok { "" } else { w } }

fn zz_probe() -> ProcessExit {
  let red = zz_bit(ok: an_undeclared_call_argument_in_a_then_arm_refuses_at_resolve_at_its_atom(), w: "0 ") + zz_bit(ok: an_undeclared_call_argument_in_an_else_arm_refuses_at_resolve_at_its_atom(), w: "1 ") + zz_bit(ok: a_declared_call_argument_in_an_arm_resolves(), w: "2 ") + zz_bit(ok: an_undeclared_call_argument_outside_an_if_refuses_at_resolve_at_its_atom(), w: "3 ") + zz_bit(ok: a_second_statement_after_a_non_binding_one_refuses_at_normalize(), w: "4 ") + zz_bit(ok: an_undeclared_statement_after_a_let_refuses_at_resolve_at_its_atom(), w: "5 ") + zz_bit(ok: a_let_bound_continuation_resolves(), w: "6 ") + zz_bit(ok: an_undeclared_name_in_a_parenthesised_operand_of_a_match_arm_refuses_at_resolve_at_its_atom(), w: "7 ") + zz_bit(ok: an_undeclared_name_in_a_parenthesised_operand_of_a_let_value_refuses_at_resolve_at_its_atom(), w: "8 ") + zz_bit(ok: an_undeclared_name_in_a_parenthesised_operand_of_a_call_argument_refuses_at_resolve_at_its_atom(), w: "9 ") + zz_bit(ok: a_declared_name_in_a_parenthesised_operand_resolves(), w: "10 ") + zz_bit(ok: an_undeclared_plain_right_operand_of_a_call_argument_refuses_at_resolve_at_its_atom(), w: "11 ") + zz_bit(ok: statement_let_then_reference_lowers_holds(), w: "12 ") + zz_bit(ok: statement_let_chain_lowers_holds(), w: "13 ") + zz_bit(ok: unbound_statement_prefix_refuses_holds(), w: "14 ") + zz_bit(ok: single_statement_body_unchanged_holds(), w: "15 ") + zz_bit(ok: let_in_form_unchanged_holds(), w: "16 ") + zz_bit(ok: typed_statement_let_lowers_holds(), w: "17 ")
  if red == "" { ExitSuccess } else { ExitFailure { code: 1, reason: "RED " + red } }
}
