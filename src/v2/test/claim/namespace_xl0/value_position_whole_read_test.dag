data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// A CALL IN SCRUTINEE OR ARGUMENT POSITION LOWERS WHOLE AND REACHES RESOLVE (HOLDS); A FUNCTION VALUE
// IN ARGUMENT POSITION DOES NOT YET (EXPECTED-RED, THE LAMBDA FRONTIER BELOW).
//
// THE SUBJECT IS THE TWO VALUE-POSITION READERS OF v2.compiler.body_lowering_fold on the route the
// native lane runs (native_test_context_from_ingest, then native_census_module_resolution): the match
// scrutinee and the call argument. Both read through body_lower_operand_ref_optional, whose sequence
// arm narrowed a call `f(x)` to `f` and a lambda `x => body` to `x` -- a silent truncation, which is
// why an undeclared name inside them reached no reference site. gunbc#12145 removed that truncation
// and thereby EXPOSED these consumers: from then on the match refused its whole file as
// body_lowering_reason_match_arm_navigation_refused and the argument as
// body_lowering_reason_call_argument_unread (with operator_operand_unread, 85 added and 4 removed
// (cause, path) identities on the native lane against #12145's parent). gunbc#12173 repaired both
// readers by reading the value whole through body_lower_value_lowered; the claims below that hold are
// its permanent regression controls: measured red on the refusing fold (main before #12173), and red
// on the truncating fold by construction, since truncation drops the atom they look for (not run).
//
// THE MODULES VARY ONE THING EACH. An undeclared name as the argument of a call scrutinee must refuse
// at resolve at its own atom (the scrutinee reached resolve whole); the declared twin resolves. An
// undeclared name inside a nested call argument must refuse at its atom. Call arguments and
// scrutinees as such are gunbc#12173's subject (v2.test.claim.namespace_xl0.call_argument_value_resolve_refusal);
// they are here as the population the shape claims below read, which assert the lowered call's SHAPE.
//
// THE LAMBDA CLAIMS. A lambda argument whose body uses its own parameter must RESOLVE, and an
// undeclared name in a lambda body must refuse at its atom. Both were enrolled expected-red by
// gunbc#12198 (a lambda argument refused its module as call_argument_unread, gen-one's first fatal at
// dag/examples/weather/weather.dag, and carrying its shell whole left the parameter unscoped at
// resolve). They hold now that the lambda lowers to the Arrow a named fn lowers to
// (body_lowering_fold body_lower_function_value), its binder a Named edge of the Arrow's domain
// that resolve scopes through the one Arrow binder model.
data vpw_match_call_source: String = "module v2.test.vpw_match_call\n\nimport std.types { Bool }\n\nfn vpw_id(p: Bool) -> Bool { p }\n\nfn vpw_probe(p: Bool) -> Bool {\n  match vpw_id(p: vpw_undeclared_scrutinee) {\n    true => p\n    false => p\n  }\n}\n"

data vpw_match_declared_source: String = "module v2.test.vpw_match_declared\n\nimport std.types { Bool }\n\nfn vpw_id(p: Bool) -> Bool { p }\n\nfn vpw_probe(p: Bool) -> Bool {\n  match vpw_id(p: p) {\n    true => p\n    false => p\n  }\n}\n"

data vpw_arg_lambda_source: String = "module v2.test.vpw_arg_lambda\n\nimport std.types { Bool }\n\nfn vpw_apply(f: Bool, v: Bool) -> Bool { v }\n\nfn vpw_probe(p: Bool) -> Bool { vpw_apply(f: x => x, v: p) }\n"

data vpw_lambda_undeclared_source: String = "module v2.test.vpw_lambda_undeclared\n\nimport std.types { Bool }\n\nfn vpw_apply(f: Bool, v: Bool) -> Bool { v }\n\nfn vpw_probe(p: Bool) -> Bool { vpw_apply(f: x => vpw_undeclared_lambda_body, v: p) }\n"

// A fn literal in argument position, once with an expression body and once with a let-block body.
// The callees differ from the lambda fixture's so each shape claim is satisfied by its own module.
data vpw_arg_fn_literal_source: String = "module v2.test.vpw_arg_fn_literal\n\nimport std.types { Bool }\n\nfn vpw_apply_literal(f: Bool, v: Bool) -> Bool { v }\n\nfn vpw_apply_block(f: Bool, v: Bool) -> Bool { v }\n\nfn vpw_probe(p: Bool) -> Bool { vpw_apply_literal(f: fn(x) { x }, v: p) }\n\nfn vpw_probe_block(p: Bool) -> Bool {\n  vpw_apply_block(f: fn(x) {\n    let y = x\n    y\n  }, v: p)\n}\n"

// THE SEVEN'S token_stream WALL, MINIMISED (warm-bear-132's chunk c00017 of
// src/v2/test/claim/parse/expression_bodied_fn_decl_parse_test.dag g_tokenize_parse): a match arm
// whose body is a call taking a fn literal, whose own body is a match over the literal's binder and
// also reads the enclosing fn's parameter. Before fn literals lowered, the binder was never scoped and
// resolve refused it as resolve_reason_unbound_symbol.
data vpw_fn_literal_in_arm_source: String = "module v2.test.vpw_fn_literal_in_arm\n\nimport std.types { Bool }\n\nfn vpw_then(o: Bool, f: Bool) -> Bool { o }\n\nfn vpw_probe(p: Bool) -> Bool {\n  match p {\n    true =>\n      vpw_then(\n        o: p,\n        f: fn(token_stream) {\n          match token_stream {\n            true => token_stream\n            false => p\n          }\n        }\n      )\n    false => p\n  }\n}\n"

// FN LITERALS AS RECORD FIELDS INSIDE A CALL ARGUMENT (warm-bear-132's 02_parse c01376 / c02555 and
// grammar c01874 shapes, and c01376's `fn(_, _)` wildcards): the argument value is folded bottom-up
// before it is read, and a function
// value must reach its producer unfolded. A single-atom body once came back unread, and a
// record-construct body as an Arrow the post-normalize well-formedness gate refused.
data vpw_fn_literal_record_source: String = "module v2.test.vpw_fn_literal_record\n\nimport std.types { Bool }\n\nfn vpw_apply_record(r: Bool, v: Bool) -> Bool { v }\n\nfn vpw_probe(p: Bool) -> Bool {\n  vpw_apply_record(\n    r: VpwAlgebra {\n      leaf: fn(t) { t },\n      wild: fn(_, _) { false },\n      node: fn(l, r) { VpwPair { a: l, b: r } }\n    },\n    v: p\n  )\n}\n"

// TWO LAMBDAS, ONE PARAMETER NAME: each must carry its OWN fresh type parameter, not share one.
data vpw_two_lambdas_source: String = "module v2.test.vpw_two_lambdas\n\nimport std.types { Bool }\n\nfn vpw_apply_two(f: Bool, g: Bool) -> Bool { g }\n\nfn vpw_probe(p: Bool) -> Bool { vpw_apply_two(f: x => x, g: x => p) }\n"

// A LET-BOUND FN LITERAL WITH A WRITTEN RETURN TYPE (crisp-dove-95's specimen for
// gunbc.recurring_failure_mode body_type_annotation_dropped_before_resolve_in_v2): the let's value
// once lowered to the literal's first token, dropping the literal and its `-> Bool`.
data vpw_let_fn_literal_source: String = "module v2.test.vpw_let_fn_literal\n\nimport std.types { Bool }\n\nfn vpw_probe(x: Bool) -> Bool {\n  let g = fn(y) -> Bool { y }\n  x\n}\n"

// A FIELD PROJECTION ON A CALL RESULT (warm-bear-132's 02_parse c02590, parse_memo_recurrence_census:
// `acc + expr_parse_demand_fold(expr: p.expression).discarding_sites`), once as an operator operand
// inside a fn literal -- the specimen -- and once as a two-step projection in fn-body value position.
// Before the chain door lowered a call head, the first refused its module operator_operand_unread.
data vpw_call_projection_source: String = "module v2.test.vpw_call_projection\n\nimport std.types { Bool }\n\nfn vpw_probe(p: Bool) -> Bool { vpw_fold(f: fn(acc, q) { acc + vpw_demand(e: q.expression).sites }) }\n\nfn vpw_probe_chain(p: Bool) -> Bool { vpw_demand_two(e: p).outer.inner }\n"

// FRESH TYPE VARIABLES ARE NAMED BY STRUCTURAL PATH (ruled on gunbc#12210). Consumers identify type
// variables by spelling (gunbc.recurring_failure_mode type_variable_identified_by_spelling_in_v2), so
// a function value's minted variables must be distinct from any other function value's its types can
// meet -- a nested literal reusing its parameter name, and siblings -- while the same lambda at the same
// position in two declarations keeps the same type and content hash (no occurrence in the type).
// THE NESTED LITERALS BIND DIFFERENT NAMES, AND THE RENAME IS THE POINT OF THIS COMMENT. This fixture
// used to nest `fn(x) { let g = fn(x) { x } ... }` -- the same value name at both levels. That was
// INCIDENTAL to what the claim over it establishes, which is that a nested literal's fresh TYPE variables
// are not a shadow of the outer's; the shared spelling did no work for that subject. Once
// v2.compiler.resolve admitted value binders through one gate, the inner `x` hid the outer `x` and the
// fixture refused resolve_reason_binder_hides_visible_value -- so the claim could no longer reach its own
// subject, and reversing it would have deleted a property rather than recording a rule.
//
// The value-shadowing rule has its own control at its own interface
// (v2.test.claim.binder_admission.callable_binder_slice cbs_a_binder_hiding_an_enclosing_binder_refuses),
// so nothing is lost by making this fixture bind distinct names: the type-variable property stays
// exercised by two nested literals that each mint their own, and the shadowing property is asserted where
// it belongs instead of riding on an unrelated fixture.
data vpw_fv_nest_source: String = "module v2.test.vpw_fv_nest\n\nimport std.types { Bool }\n\nfn vpw_apply_nest(f: Bool, v: Bool) -> Bool { v }\n\nfn vpw_probe_nest(p: Bool) -> Bool {\n  vpw_apply_nest(f: fn(x) {\n    let g = fn(y) { y }\n    g\n  }, v: p)\n}\n"

data vpw_fv_siblings_source: String = "module v2.test.vpw_fv_siblings\n\nimport std.types { Bool }\n\nfn vpw_pair(f: Bool, g: Bool, v: Bool) -> Bool { v }\n\nfn vpw_probe_siblings(p: Bool) -> Bool { vpw_pair(f: x => x, g: x => x, v: p) }\n\nfn vpw_site_one(p: Bool) -> Bool { vpw_site(f: y => y, v: p) }\n\nfn vpw_site_two(p: Bool) -> Bool { vpw_site(f: y => y, v: p) }\n\nfn vpw_site(f: Bool, v: Bool) -> Bool { v }\n\nfn vpw_order_site(f: Bool, v: Bool) -> Bool { v }\n\nfn vpw_probe_order(p: Bool) -> Bool { vpw_order_site(f: (y, x) => y, v: p) }\n"

data vpw_arg_call_source: String = "module v2.test.vpw_arg_call\n\nimport std.types { Bool }\n\nfn vpw_id(p: Bool) -> Bool { p }\n\nfn vpw_probe(p: Bool) -> Bool { vpw_id(p: vpw_id(p: vpw_undeclared_argument)) }\n"

fn vpw_read(source: String, id: Symbol, unit: Symbol, path: String) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: source, fidelity: Lossless },
    artifact: Artifact { kind: SourceFile, id: id, file_path: path },
    compilation_unit: unit,
    source_root: DagTree
  }
}

data vpw_ingest: SourceRootIngest = Cons {
    head: vpw_read(source: vpw_match_call_source, id: ^vpw_match_call_artifact, unit: ^vpw_match_call_cu, path: "src/v2/test/fixture/namespace_xl0/vpw_match_call.dag"),
    tail: Cons {
      head: vpw_read(source: vpw_match_declared_source, id: ^vpw_match_declared_artifact, unit: ^vpw_match_declared_cu, path: "src/v2/test/fixture/namespace_xl0/vpw_match_declared.dag"),
      tail: Cons {
        head: vpw_read(source: vpw_arg_lambda_source, id: ^vpw_arg_lambda_artifact, unit: ^vpw_arg_lambda_cu, path: "src/v2/test/fixture/namespace_xl0/vpw_arg_lambda.dag"),
        tail: Cons {
          head: vpw_read(source: vpw_arg_call_source, id: ^vpw_arg_call_artifact, unit: ^vpw_arg_call_cu, path: "src/v2/test/fixture/namespace_xl0/vpw_arg_call.dag"),
          tail: Cons {
            head: vpw_read(source: vpw_lambda_undeclared_source, id: ^vpw_lambda_undeclared_artifact, unit: ^vpw_lambda_undeclared_cu, path: "src/v2/test/fixture/namespace_xl0/vpw_lambda_undeclared.dag"),
            tail: Cons {
              head: vpw_read(source: vpw_fn_literal_in_arm_source, id: ^vpw_fn_literal_in_arm_artifact, unit: ^vpw_fn_literal_in_arm_cu, path: "src/v2/test/fixture/namespace_xl0/vpw_fn_literal_in_arm.dag"),
              tail: Cons {
                head: vpw_read(source: vpw_fv_nest_source, id: ^vpw_fv_nest_resolve_artifact, unit: ^vpw_fv_nest_resolve_cu, path: "src/v2/test/fixture/namespace_xl0/vpw_fv_nest_resolve.dag"),
                tail: Empty
              }
            }
          }
        }
      }
    }
  }

// ONE FRONT END FOR THE VERDICT CLAIMS; the stored value is a verdict per module, no Node or context.
type VpwVerdict
  = VpwResolved
  | VpwRefused { reason: Symbol, at_atom: Optional<Symbol> }
  | VpwFileRefused
  | VpwAbsent

type VpwOutcomes
  = VpwContextRefused
  | VpwOutcomesDecided {
      match_call: VpwVerdict
      match_declared: VpwVerdict
      arg_lambda: VpwVerdict
      arg_call: VpwVerdict
      lambda_undeclared: VpwVerdict
      fn_literal_in_arm: VpwVerdict
      fv_nest: VpwVerdict
    }

fn vpw_verdict_of(outcome: NativeCensusModuleOutcome) -> VpwVerdict {
  match outcome {
    NativeCensusModuleResolved => VpwResolved
    NativeCensusModuleFileRefused => VpwFileRefused
    NativeCensusModuleResolveRefused { first: d, rest: _, observation: _ } =>
      VpwRefused {
        reason: d.head.reason,
        at_atom: match d.head.at {
          NodeLocus { anchor: a } => node_atom_identity_optional(node: a.at)
          _ => optional_absent()
        }
      }
  }
}

fn vpw_verdict_in(context: NativeTestContext, module_name: String) -> VpwVerdict {
  fold_list(
    xs: native_census_modules(ingest: vpw_ingest),
    empty: VpwAbsent,
    cons: fn(acc, entry) {
      if entry.module == module_name {
        vpw_verdict_of(
          outcome: native_census_module_resolution(
            context: context,
            refusal_index: native_lane_file_refusal_index(refusals: context.file_refusals),
            entry: entry
          ).outcome
        )
      } else {
        acc
      }
    }
  )
}

fn vpw_outcomes() -> VpwOutcomes {
  match native_test_context_from_ingest(ingest: vpw_ingest) {
    Rejected { diagnostics: _ } => VpwContextRefused
    Accepted { value: context, diagnostics: _ } =>
      VpwOutcomesDecided {
        match_call: vpw_verdict_in(context: context, module_name: "v2.test.vpw_match_call"),
        match_declared: vpw_verdict_in(context: context, module_name: "v2.test.vpw_match_declared"),
        arg_lambda: vpw_verdict_in(context: context, module_name: "v2.test.vpw_arg_lambda"),
        arg_call: vpw_verdict_in(context: context, module_name: "v2.test.vpw_arg_call"),
        lambda_undeclared: vpw_verdict_in(context: context, module_name: "v2.test.vpw_lambda_undeclared"),
        fn_literal_in_arm: vpw_verdict_in(context: context, module_name: "v2.test.vpw_fn_literal_in_arm"),
        fv_nest: vpw_verdict_in(context: context, module_name: "v2.test.vpw_fv_nest")
      }
  }
}

fn vpw_is_resolved(v: VpwVerdict) -> Bool {
  match v {
    VpwResolved => true
    _ => false
  }
}

fn vpw_is_unbound_at(v: VpwVerdict, spelling: Symbol) -> Bool {
  match v {
    VpwRefused { reason: r, at_atom: Present { value: id } } =>
      (r == ^resolve_reason_unbound_symbol) && (id == spelling)
    _ => false
  }
}

test fn an_undeclared_name_inside_a_call_scrutinee_refuses_at_resolve_at_its_atom() -> Bool  {
  match vpw_outcomes() {
    VpwOutcomesDecided { match_call: v, match_declared: _, arg_lambda: _, arg_call: _, lambda_undeclared: _, fn_literal_in_arm: _, fv_nest: _ } =>
      vpw_is_unbound_at(v: v, spelling: ^vpw_undeclared_scrutinee)
    VpwContextRefused => false
  }
}

test fn a_match_on_a_call_with_declared_names_resolves() -> Bool  {
  match vpw_outcomes() {
    VpwOutcomesDecided { match_call: _, match_declared: v, arg_lambda: _, arg_call: _, lambda_undeclared: _, fn_literal_in_arm: _, fv_nest: _ } =>
      vpw_is_resolved(v: v)
    VpwContextRefused => false
  }
}

test fn a_lambda_argument_whose_body_uses_its_parameter_resolves() -> Bool  {
  match vpw_outcomes() {
    VpwOutcomesDecided { match_call: _, match_declared: _, arg_lambda: v, arg_call: _, lambda_undeclared: _, fn_literal_in_arm: _, fv_nest: _ } =>
      vpw_is_resolved(v: v)
    VpwContextRefused => false
  }
}

test fn an_undeclared_name_inside_a_lambda_argument_body_refuses_at_resolve_at_its_atom() -> Bool  {
  match vpw_outcomes() {
    VpwOutcomesDecided { match_call: _, match_declared: _, arg_lambda: _, arg_call: _, lambda_undeclared: v, fn_literal_in_arm: _, fv_nest: _ } =>
      vpw_is_unbound_at(v: v, spelling: ^vpw_undeclared_lambda_body)
    VpwContextRefused => false
  }
}

test fn an_undeclared_name_inside_a_call_argument_refuses_at_resolve_at_its_atom() -> Bool  {
  match vpw_outcomes() {
    VpwOutcomesDecided { match_call: _, match_declared: _, arg_lambda: _, arg_call: v, lambda_undeclared: _, fn_literal_in_arm: _, fv_nest: _ } =>
      vpw_is_unbound_at(v: v, spelling: ^vpw_undeclared_argument)
    VpwContextRefused => false
  }
}

// THE SHAPE, NOT ONLY THE VERDICT. The claims above establish that a name inside a call scrutinee or
// argument reaches resolve; the claims below read the LOWERED TREE the production route hands the
// resolver (program_assembly module_roots_from_source_root_ingest, projected through
// normalized_tree_roots_to_nodes) and assert the call's shape: a Transform whose operator is the
// authored callee, with exactly one argument, whose argument is the authored inner call or atom.
// Narrowing (the pre-#12145 truncation to the callee atom) and refusal (the fail-closed exposure after #12145) both
// fail these. Renaming the callee in the expected spelling makes them red. The ingest is enrolled warm
// beside vpw_outcomes; the walk runs per claim.
// The shape ingest carries the lambda fixture too: module_roots_from_source_root_ingest refuses the
// whole ingest when one module refuses, so a lambda argument that stopped lowering reds every shape
// claim here, not only its own.
data vpw_shape_ingest: SourceRootIngest = Cons {
    head: vpw_read(source: vpw_match_call_source, id: ^vpw_match_call_artifact, unit: ^vpw_match_call_cu, path: "src/v2/test/fixture/namespace_xl0/vpw_match_call.dag"),
    tail: Cons {
      head: vpw_read(source: vpw_arg_call_source, id: ^vpw_arg_call_artifact, unit: ^vpw_arg_call_cu, path: "src/v2/test/fixture/namespace_xl0/vpw_arg_call.dag"),
      tail: Cons {
        head: vpw_read(source: vpw_arg_lambda_source, id: ^vpw_arg_lambda_artifact, unit: ^vpw_arg_lambda_cu, path: "src/v2/test/fixture/namespace_xl0/vpw_arg_lambda.dag"),
        tail: Cons {
          head: vpw_read(source: vpw_arg_fn_literal_source, id: ^vpw_arg_fn_literal_artifact, unit: ^vpw_arg_fn_literal_cu, path: "src/v2/test/fixture/namespace_xl0/vpw_arg_fn_literal.dag"),
          tail: Cons {
            head: vpw_read(source: vpw_fn_literal_record_source, id: ^vpw_fn_literal_record_artifact, unit: ^vpw_fn_literal_record_cu, path: "src/v2/test/fixture/namespace_xl0/vpw_fn_literal_record.dag"),
            tail: Cons {
              head: vpw_read(source: vpw_two_lambdas_source, id: ^vpw_two_lambdas_artifact, unit: ^vpw_two_lambdas_cu, path: "src/v2/test/fixture/namespace_xl0/vpw_two_lambdas.dag"),
              tail: Cons {
                head: vpw_read(source: vpw_let_fn_literal_source, id: ^vpw_let_fn_literal_artifact, unit: ^vpw_let_fn_literal_cu, path: "src/v2/test/fixture/namespace_xl0/vpw_let_fn_literal.dag"),
                tail: Cons {
                  head: vpw_read(source: vpw_call_projection_source, id: ^vpw_call_projection_artifact, unit: ^vpw_call_projection_cu, path: "src/v2/test/fixture/namespace_xl0/vpw_call_projection.dag"),
                  tail: Cons {
                    head: vpw_read(source: vpw_fv_nest_source, id: ^vpw_fv_nest_artifact, unit: ^vpw_fv_nest_cu, path: "src/v2/test/fixture/namespace_xl0/vpw_fv_nest.dag"),
                    tail: Cons {
                      head: vpw_read(source: vpw_fv_siblings_source, id: ^vpw_fv_siblings_artifact, unit: ^vpw_fv_siblings_cu, path: "src/v2/test/fixture/namespace_xl0/vpw_fv_siblings.dag"),
                      tail: Empty
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

fn vpw_normalized() -> Outcome<FreeMonoid<NormalizedTree>> {
  module_roots_from_source_root_ingest(ingest: vpw_shape_ingest, lm: dag_language_model())
}

fn vpw_roots() -> FreeMonoid<Node> {
  match vpw_normalized() {
    Accepted { value: roots, diagnostics: _ } => normalized_tree_roots_to_nodes(roots: roots)
    Rejected { diagnostics: _ } => Empty
  }
}

// The call shape is read through v2.std.compilers.body_lowering application_read -- the authority
// for "what a lowered call is", not a reader of this claim's own. A refused application is not a
// call of the looked-for shape, so it answers false here and the claim reds, which is the point.
fn vpw_is_call_to(n: Node, callee: Symbol) -> Bool {
  match application_read(site: n) {
    Application { view: v } => vpw_is_atom(n: v.head, id: callee)
    NotApplication => false
    ApplicationRefused { diagnostics: _ } => false
  }
}

// A lowered call's operands, read through application_read like every other call reader here; a
// node that is not an application has none.
fn vpw_operands(n: Node) -> List<Node> {
  match application_read(site: n) {
    Application { view: v } => v.operands
    NotApplication => Empty
    ApplicationRefused { diagnostics: _ } => Empty
  }
}

// The single argument of a one-argument call.
fn vpw_sole_argument(n: Node) -> Optional<Node> {
  match application_read(site: n) {
    Application { view: v } =>
      if length(xs: v.operands) == 1 {
        list_at_optional(xs: v.operands, index: 0)
      } else {
        optional_absent()
      }
    NotApplication => optional_absent()
    ApplicationRefused { diagnostics: _ } => optional_absent()
  }
}

fn vpw_is_atom(n: Node, id: Symbol) -> Bool {
  match node_atom_identity_optional(node: n) {
    Present { value: got } => got == id
    Absent => false
  }
}

// callee(callee(inner)) with arity one at each level, the innermost argument the atom `inner`.
fn vpw_nested_call_shape(n: Node, callee: Symbol, inner: Symbol) -> Bool {
  vpw_is_call_to(n: n, callee: callee) && (match vpw_sole_argument(n: n) {
    Present { value: a } =>
      vpw_is_call_to(n: a, callee: callee) && (match vpw_sole_argument(n: a) {
        Present { value: b } => vpw_is_atom(n: b, id: inner)
        Absent => false
      })
    Absent => false
  })
}

// The two shapes the claims below look for.
type VpwShape
  = VpwNestedCall { callee: Symbol, inner: Symbol }
  | VpwSingleCall { callee: Symbol, inner: Symbol }
  | VpwLambdaArgument { callee: Symbol, binder: Symbol }
  | VpwFnLiteralBlockArgument { callee: Symbol, binder: Symbol }

fn vpw_node_has_shape(n: Node, shape: VpwShape) -> Bool {
  match shape {
    VpwNestedCall { callee: c, inner: i } => vpw_nested_call_shape(n: n, callee: c, inner: i)
    VpwSingleCall { callee: c, inner: i } => vpw_single_call_shape(n: n, callee: c, inner: i)
    VpwLambdaArgument { callee: c, binder: b } => vpw_lambda_argument_shape(n: n, callee: c, binder: b)
    VpwFnLiteralBlockArgument { callee: c, binder: b } => vpw_fn_literal_block_argument_shape(n: n, callee: c, binder: b)
  }
}

fn vpw_nodes_have_shape(xs: List<Node>, shape: VpwShape) -> Bool {
  fold_list(xs: xs, empty: false, cons: fn(acc, n) { acc || vpw_node_has_shape(n: n, shape: shape) })
}

// Whether any node of any lowered root has the shape; the subtree is enumerated by v2.std.node
// node_subtree_nodes, so this claim walks no edges of its own.
fn vpw_any_node(shape: VpwShape) -> Bool {
  fold_list(xs: vpw_roots(), empty: false, cons: fn(acc, r) {
    acc || vpw_nodes_have_shape(xs: node_subtree_nodes(root: r), shape: shape)
  })
}

test fn a_call_argument_lowers_to_the_authored_nested_call_with_arity_one() -> Bool  {
  vpw_any_node(shape: VpwNestedCall { callee: ^vpw_id, inner: ^vpw_undeclared_argument })
}

test fn a_call_scrutinee_lowers_whole_to_the_authored_call() -> Bool  {
  vpw_any_node(shape: VpwSingleCall { callee: ^vpw_id, inner: ^vpw_undeclared_scrutinee })
}

// The scrutinee fixture is one level deep -- vpw_id(p: vpw_undeclared_scrutinee) -- so it is read as
// a call to vpw_id whose sole argument is that atom.
fn vpw_single_call_shape(n: Node, callee: Symbol, inner: Symbol) -> Bool {
  vpw_is_call_to(n: n, callee: callee) && (match vpw_sole_argument(n: n) {
    Present { value: a } => vpw_is_atom(n: a, id: inner)
    Absent => false
  })
}

// THE LAMBDA ARGUMENT'S SHAPE: a call to `callee` one of whose arguments is an Arrow whose first
// positional child (the domain) has the Named edge `binder` typed by one of THAT Arrow's own type
// parameters (v2.std.type_binder type_param_names -- the fresh `'p` gunbc#12217's binder model
// carries), and whose arrow_body_edge target is the atom `binder` at its AUTHORED occurrence -- the
// body's own use, not the binder's position (the type variable carries the binder's occurrence).
// Dropping the binder edge, narrowing the lambda to its parameter, carrying its shell, or typing
// the binder as anything but its own fresh type parameter each fail it.
fn vpw_symbol_in(xs: List<Symbol>, s: Symbol) -> Bool {
  fold_list(xs: xs, empty: false, cons: fn(acc, x) { acc || (x == s) })
}

fn vpw_domain_binds(arrow: Node, binder: Symbol) -> Optional<Node> {
  match list_at_optional(xs: node_positional_child_targets(node: arrow), index: 0) {
    Present { value: domain } =>
      match named_edge_target_lookup(children: domain.children, name: binder) {
        Found { target: t } =>
          match node_atom_identity_optional(node: t) {
            Present { value: tv } =>
              if vpw_symbol_in(xs: type_param_names(n: arrow), s: tv) { optional_present(value: t) } else { optional_absent() }
            Absent => optional_absent()
          }
        _ => optional_absent()
      }
    Absent => optional_absent()
  }
}

fn vpw_is_lambda_using_its_binder(n: Node, binder: Symbol) -> Bool {
  match n.kind {
    TypeNode { connective: Arrow } =>
      match vpw_domain_binds(arrow: n, binder: binder) {
        Present { value: elided } =>
          match arrow_body_target_lookup(children: n.children) {
            Found { target: body } =>
              vpw_is_atom(n: body, id: binder) && (body.occurrence_id != elided.occurrence_id)
            _ => false
          }
        Absent => false
      }
    _ => false
  }
}

fn vpw_lambda_argument_shape(n: Node, callee: Symbol, binder: Symbol) -> Bool {
  vpw_is_call_to(n: n, callee: callee)
    && fold_list(xs: vpw_operands(n: n), empty: false, cons: fn(acc, a) {
      acc || vpw_is_lambda_using_its_binder(n: a, binder: binder)
    })
}

test fn a_lambda_argument_lowers_to_an_arrow_binding_its_parameter_for_its_body() -> Bool  {
  vpw_any_node(shape: VpwLambdaArgument { callee: ^vpw_apply, binder: ^x })
}

test fn a_fn_literal_argument_lowers_to_the_same_arrow_as_a_lambda() -> Bool  {
  vpw_any_node(shape: VpwLambdaArgument { callee: ^vpw_apply_literal, binder: ^x })
}

// A let-block body is lowered by the named fn's body lowering, so the Arrow's body is the Bind a
// named fn's `let` lowers to -- not the block's first atom, and not an unlowered shell.
fn vpw_is_arrow_binding_with_bind_body(a: Node, binder: Symbol) -> Bool {
  match a.kind {
    TypeNode { connective: Arrow } =>
      match vpw_domain_binds(arrow: a, binder: binder) {
        Present { value: _ } =>
          match arrow_body_target_lookup(children: a.children) {
            Found { target: body } =>
              match body.kind {
                ComputationNode { behavior: Bind } => true
                _ => false
              }
            _ => false
          }
        Absent => false
      }
    _ => false
  }
}

fn vpw_fn_literal_block_argument_shape(n: Node, callee: Symbol, binder: Symbol) -> Bool {
  vpw_is_call_to(n: n, callee: callee)
    && fold_list(xs: vpw_operands(n: n), empty: false, cons: fn(acc, a) {
      acc || vpw_is_arrow_binding_with_bind_body(a: a, binder: binder)
    })
}

test fn a_fn_literal_argument_with_a_let_block_body_lowers_its_body_as_a_named_fn_does() -> Bool  {
  vpw_any_node(shape: VpwFnLiteralBlockArgument { callee: ^vpw_apply_block, binder: ^x })
}

test fn a_fn_literal_in_a_match_arm_binds_its_parameter_for_its_match_body() -> Bool  {
  match vpw_outcomes() {
    VpwOutcomesDecided { match_call: _, match_declared: _, arg_lambda: _, arg_call: _, lambda_undeclared: _, fn_literal_in_arm: v, fv_nest: _ } =>
      vpw_is_resolved(v: v)
    VpwContextRefused => false
  }
}

// Any lowered node that is a function value binding `binder` whose body is that binder's own use.
fn vpw_any_function_value_using(binder: Symbol) -> Bool {
  fold_list(xs: vpw_roots(), empty: false, cons: fn(acc, r) {
    acc || fold_list(xs: node_subtree_nodes(root: r), empty: false, cons: fn(a, n) {
      a || vpw_is_lambda_using_its_binder(n: n, binder: binder)
    })
  })
}

// Any lowered Arrow binding `binder` in its domain, whatever its body.
fn vpw_is_arrow_binding(n: Node, binder: Symbol) -> Bool {
  match n.kind {
    TypeNode { connective: Arrow } =>
      match vpw_domain_binds(arrow: n, binder: binder) {
        Present { value: _ } => true
        Absent => false
      }
    _ => false
  }
}

fn vpw_any_function_value_binding(binder: Symbol) -> Bool {
  fold_list(xs: vpw_roots(), empty: false, cons: fn(acc, r) {
    acc || fold_list(xs: node_subtree_nodes(root: r), empty: false, cons: fn(a, n) {
      a || vpw_is_arrow_binding(n: n, binder: binder)
    })
  })
}

test fn a_fn_literal_record_field_with_a_single_atom_body_lowers_unfolded() -> Bool  {
  vpw_any_function_value_using(binder: ^t)
}

// The shape ingest refuses as a whole if the record-construct-bodied literal's Arrow fails the
// post-normalize well-formedness gate, so this claim is also that gate's control.
test fn a_fn_literal_record_field_with_a_record_construct_body_lowers_well_formed() -> Bool  {
  vpw_any_function_value_binding(binder: ^l)
}

fn vpw_is_arrow(n: Node) -> Bool {
  match n.kind {
    TypeNode { connective: Arrow } => true
    _ => false
  }
}

// Each lambda binds `x` in its own domain, typed by a type parameter declared on ITS OWN Arrow
// (vpw_domain_binds reads the type variable against that Arrow's type_param_names). A fresh
// type parameter shared across the two -- declared on one Arrow and referenced from the other, or a
// domain typed by a variable no Arrow in the pair declares -- fails it.
fn vpw_binds_x_in_own_frame(a: Node) -> Bool {
  vpw_is_arrow(n: a) && (match vpw_domain_binds(arrow: a, binder: ^x) {
    Present { value: _ } => true
    Absent => false
  })
}

fn vpw_two_distinct_type_binders(n: Node, callee: Symbol) -> Bool {
  vpw_is_call_to(n: n, callee: callee)
    && (length(xs: vpw_operands(n: n)) == 2)
    && fold_list(xs: vpw_operands(n: n), empty: true, cons: fn(acc, a) { acc && vpw_binds_x_in_own_frame(a: a) })
}

test fn two_lambdas_with_one_parameter_name_each_carry_their_own_fresh_type_parameter() -> Bool  {
  fold_list(xs: vpw_roots(), empty: false, cons: fn(acc, r) {
    acc || fold_list(xs: node_subtree_nodes(root: r), empty: false, cons: fn(a, n) {
      a || vpw_two_distinct_type_binders(n: n, callee: ^vpw_apply_two)
    })
  })
}

// The let's bound value is the literal's whole Arrow: binder `y`, its body the use of `y`, and the
// authored return type carried as the codomain (so the literal declares a type parameter for `y` only).
fn vpw_is_let_bound_arrow(n: Node) -> Bool {
  match n.kind {
    ComputationNode { behavior: Bind } =>
      fold_list(xs: node_positional_child_targets(node: n), empty: false, cons: fn(acc, c) {
        acc || (vpw_is_lambda_using_its_binder(n: c, binder: ^y) && (length(xs: type_param_names(n: c)) == 1))
      })
    _ => false
  }
}

test fn a_let_bound_fn_literal_lowers_whole_with_its_authored_return_type() -> Bool  {
  fold_list(xs: vpw_roots(), empty: false, cons: fn(acc, r) {
    acc || fold_list(xs: node_subtree_nodes(root: r), empty: false, cons: fn(a, n) { a || vpw_is_let_bound_arrow(n: n) })
  })
}

// THE PROJECTION IS KEPT, OFF THE CALL (gunbc.recurring_failure_mode
// call_expression_erased_at_v2_body_lowering, the call-then-field residue). The operand is
// v2.std.node_query field_projection_node over the lowered call: the projection is the one form a
// field access off any value lowers to, the call its base. A lowering that dropped the projection
// (answering the call), kept the head atom, or refused the module (the shape ingest then refuses
// whole) fails these.
fn vpw_projects(n: Node, field: Symbol) -> Optional<Node> {
  match field_projection_optional(n: n) {
    Present { value: fp } => if fp.field == field { optional_present(value: fp.base) } else { optional_absent() }
    Absent => optional_absent()
  }
}

fn vpw_is_projection_of_call(n: Node, field: Symbol, callee: Symbol) -> Bool {
  match vpw_projects(n: n, field: field) {
    Present { value: base } => vpw_is_call_to(n: base, callee: callee)
    Absent => false
  }
}

fn vpw_is_two_step_projection_of_call(n: Node) -> Bool {
  match vpw_projects(n: n, field: ^inner) {
    Present { value: mid } => vpw_is_projection_of_call(n: mid, field: ^outer, callee: ^vpw_demand_two)
    Absent => false
  }
}

test fn a_field_projection_on_a_call_result_in_an_operand_lowers_whole() -> Bool  {
  fold_list(xs: vpw_roots(), empty: false, cons: fn(acc, r) {
    acc || fold_list(xs: node_subtree_nodes(root: r), empty: false, cons: fn(a, n) {
      a || vpw_is_projection_of_call(n: n, field: ^sites, callee: ^vpw_demand)
    })
  })
}

test fn a_two_step_projection_on_a_call_result_lowers_every_step() -> Bool  {
  fold_list(xs: vpw_roots(), empty: false, cons: fn(acc, r) {
    acc || fold_list(xs: node_subtree_nodes(root: r), empty: false, cons: fn(a, n) {
      a || vpw_is_two_step_projection_of_call(n: n)
    })
  })
}

// `fn(_, _)`: two wildcard parameters in one domain. A domain is a record (every edge Named, every
// name distinct), so the wildcards are minted distinct unauthorable labels by the one anonymous-slot
// mint (v2.std.anonymous_binder anonymous_binder_mint_parameter_list), as a named fn's are; two edges named
// `_` failed the post-normalize well-formedness gate and refused the whole ingest (02_parse c01376 /
// c02555).
fn vpw_is_two_wildcard_arrow(n: Node) -> Bool {
  vpw_is_arrow(n: n) && (match list_at_optional(xs: node_positional_child_targets(node: n), index: 0) {
    Present { value: domain } => (length(xs: domain.children) == 2) && (length(xs: type_param_names(n: n)) == 3)
    Absent => false
  })
}

test fn a_fn_literal_with_two_wildcard_parameters_lowers_well_formed() -> Bool  {
  fold_list(xs: vpw_roots(), empty: false, cons: fn(acc, r) {
    acc || fold_list(xs: node_subtree_nodes(root: r), empty: false, cons: fn(a, n) { a || vpw_is_two_wildcard_arrow(n: n) })
  })
}

// Two symbol lists share no element.
fn vpw_disjoint(a: List<Symbol>, b: List<Symbol>) -> Bool {
  fold_list(xs: a, empty: true, cons: fn(acc, x) { acc && !vpw_symbol_in(xs: b, s: x) })
}

// A function value's Arrow: an Arrow declaring type parameters (its fresh variables).
fn vpw_is_function_value_arrow(n: Node) -> Bool {
  vpw_is_arrow(n: n) && (length(xs: type_param_names(n: n)) > 0)
}

// Some function-value Arrow strictly inside `outer` whose type parameters are disjoint from outer's.
fn vpw_has_disjoint_nested_function_value(outer: Node) -> Bool {
  fold_list(xs: node_subtree_nodes(root: outer), empty: false, cons: fn(acc, inner) {
    acc || (vpw_is_function_value_arrow(n: inner) && (content_hash(n: inner) != content_hash(n: outer)) && vpw_disjoint(a: type_param_names(n: outer), b: type_param_names(n: inner)))
  })
}

fn vpw_any_nested_distinct() -> Bool {
  fold_list(xs: vpw_roots(), empty: false, cons: fn(acc, r) {
    acc || fold_list(xs: node_subtree_nodes(root: r), empty: false, cons: fn(a, n) {
      a || (vpw_is_function_value_arrow(n: n) && vpw_has_disjoint_nested_function_value(outer: n))
    })
  })
}

// `fn(x) { let g = fn(x) { x }  g }`: the nested literal reuses `x`, and its fresh variables are not
// the outer's. A mutation naming them by depth-free label alone (both `x`) reds it.
test fn a_nested_fn_literal_reusing_its_parameter_name_mints_distinct_type_variables() -> Bool  {
  vpw_any_nested_distinct()
}

// The function-value arguments of the call to `callee`, in order.
fn vpw_function_value_args(n: Node, callee: Symbol) -> List<Node> {
  let no_nodes: List<Node> = []
  if vpw_is_call_to(n: n, callee: callee) {
    fold(vpw_operands(n: n), init: no_nodes, f: fn(acc, a) {
      if vpw_is_function_value_arrow(n: a) { list_append(left: acc, right: [a]) } else { acc }
    })
  } else {
    no_nodes
  }
}

// Every function-value argument of every call to `callee` across the lowered roots, in walk order.
fn vpw_all_function_value_args(callee: Symbol) -> List<Node> {
  let no_nodes: List<Node> = []
  fold(vpw_roots(), init: no_nodes, f: fn(acc, r) {
    fold(node_subtree_nodes(root: r), init: acc, f: fn(a, n) { list_append(left: a, right: vpw_function_value_args(n: n, callee: callee)) })
  })
}

fn vpw_pair_disjoint(xs: List<Node>) -> Bool {
  (length(xs: xs) == 2) && (match list_at_optional(xs: xs, index: 0) {
    Present { value: f } =>
      match list_at_optional(xs: xs, index: 1) {
        Present { value: g } => vpw_disjoint(a: type_param_names(n: f), b: type_param_names(n: g))
        Absent => false
      }
    Absent => false
  })
}

// `pair(x => x, x => x)`: two sibling lambdas with one parameter name mint distinct variables. A
// mutation naming them by nesting depth alone (both depth 1) reds it.
test fn sibling_lambdas_with_one_parameter_name_mint_distinct_type_variables() -> Bool  {
  vpw_pair_disjoint(xs: vpw_all_function_value_args(callee: ^vpw_pair))
}

// The same lambda at the same position in two declarations: EQUAL content hash, which covers its
// type-parameter list. This is the property that rules an occurrence out of the name.
test fn the_same_lambda_at_two_sites_has_equal_type_variables_and_content_hash() -> Bool  {
  let sites = vpw_all_function_value_args(callee: ^vpw_site)
  (length(xs: sites) == 2) && (match list_at_optional(xs: sites, index: 0) {
    Present { value: f } =>
      match list_at_optional(xs: sites, index: 1) {
        Present { value: g } => (content_hash(n: f) == content_hash(n: g)) && (length(xs: type_param_names(n: f)) > 0)
        Absent => false
      }
    Absent => false
  })
}

// The nested module RESOLVES: a nested literal's fresh variables are not a shadow of the outer's.
test fn a_nested_fn_literal_resolves_without_a_type_parameter_shadow_refusal() -> Bool  {
  match vpw_outcomes() {
    VpwOutcomesDecided { match_call: _, match_declared: _, arg_lambda: _, arg_call: _, lambda_undeclared: _, fn_literal_in_arm: _, fv_nest: v } =>
      vpw_is_resolved(v: v)
    VpwContextRefused => false
  }
}

// A FUNCTION VALUE'S ARROW CARRIES ITS DECLARED PARAMETER ORDER, READ WHERE POSITIONAL BINDING READS
// IT. The domain is a Conj sorted by label, so `(y, x) => y` stores x before y; positional binding
// (v2.compiler.infer infer_application_formals, v2.compiler.eval eval_bind_arrow_params) reads order
// only through v2.std.arrow_signature arrow_declared_parameter_order, off the Arrow's
// ^arrow_signature_order_edge, and refuses application_parameter_order_absent without one. The
// lambda is lowered from production source, and the claim asks that reader for [y, x] -- the
// authored order, not the sorted one. Dropping the order edge from body_lower_function_value_arrow
// makes the reader answer ArrowParameterOrderAbsent and reds this.
fn vpw_declares_order(n: Node, first: Symbol, second: Symbol) -> Bool {
  vpw_is_arrow(n: n) && (match arrow_declared_parameter_order(arrow: n) {
    ArrowParameterOrderDeclared { labels: ls } =>
      (length(xs: ls) == 2) && (match list_at_optional(xs: ls, index: 0) {
        Present { value: a } => (a == first) && (match list_at_optional(xs: ls, index: 1) {
          Present { value: b } => b == second
          Absent => false
        })
        Absent => false
      })
    ArrowParameterOrderAbsent => false
    ArrowParameterOrderMalformed => false
  })
}

test fn a_positionally_bound_lambda_reads_its_declared_order_from_the_order_edge() -> Bool  {
  fold_list(xs: vpw_roots(), empty: false, cons: fn(acc, r) {
    acc || fold_list(xs: node_subtree_nodes(root: r), empty: false, cons: fn(a, n) { a || vpw_declares_order(n: n, first: ^y, second: ^x) })
  })
}
