module v2.test.claim.namespace_xl0.field_type_tree_presence

import v2.compiler.normalized_tree { normalized_tree_roots_to_nodes }
import v2.std.algebra { fold_list }
import v2.std.compilers.lexing { symbol_lexeme }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.node { Atom, Edge, Named, Node, Positional, TypeNode, node_subtree_nodes }
import v2.std.text { String }
import v2.test.claim.namespace_xl0.call_argument_mention_survival { call_argument_fixture_normalized }
import std.algebra { Empty, FreeMonoid }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// COLLECTOR OR TREE, ASKED OF THE FIELD-TYPE ABSENCE BEFORE IT IS CALLED A CLASS.
//
// A bare field type is absent from the collector's output. That is measured. WHAT CAUSES IT IS NOT,
// and the dotted case is the reason not to guess: there, an absence measured through my own walker
// looked like a tree loss and was my own speculative exclusion. v2 must resolve record field types
// to typecheck anything at all, so a real normalize loss there would be surprising.
//
// This reads the ingested roots with node_subtree_nodes and a lexeme comparison -- NOT through
// v2.compiler.reference_site_collector -- so the answer cannot inherit the walker's blind spots.
//
//   ATOM PRESENT  -> the tree carries the field type and the COLLECTOR misses the
//                    type-declaration field representation. No fourth class; a collector fix.
//   ATOM ABSENT   -> normalization drops field types, which is a lowering-class finding with a
//                    trigger of its own.
//
// THE CONTROL IS THE PAIR, NOT THE ROW. `Xl0UserType` is the same kind of locally declared bare
// type name and DOES reach the collector, so it must be present in the tree too. If the control is
// absent, this probe is reading the wrong tree and says nothing about fields.
// THE INGEST IS THE SIBLING MODULE'S ENROLLED WARM PRODUCER, NOT A SECOND CALL TO THE SAME STAGE.
//
// Both folds below need the same parsed-and-normalized fixture, and they used to reach it by
// calling module_roots_from_source_root_ingest directly -- twice per claim, over the same two
// inline sources the sibling module already ingests. Under the required floor that is fatal rather
// than merely slow: the floor builds a fresh evaluation frame per claim, so every claim in this
// file re-derived the whole ingest and came back budget-refused before reaching a verdict, which is
// neither pass nor fail. Measured: on run 34738510974 these four claims are the ONLY
// budget-refused-before-verdict rows in the entire required floor.
//
// v2.test.claim.namespace_xl0.call_argument_mention_survival call_argument_fixture_normalized is
// already enrolled WARM in v2.workflow.floor_pure_producer_share, so it is forced once during
// strict preparation, outside every per-claim budget. Consuming it here needs no second roster row
// and deletes a duplicated call site at the same time -- one producer, two consuming files, which
// is what DESIGN section 2 asks for rather than two enrolments of one stage.
//
// THE PROBE IS UNAFFECTED, WHICH IS THE ONLY THING THAT COULD HAVE MADE THIS A BAD TRADE. What is
// shared is the INGEST; what this file measures is the shape of the tree that ingest produces, and
// both folds below still walk it themselves. Sharing the stage a claim NAMES would hand it its own
// answer; sharing the stage that merely feeds it does not.
fn fixture_atom_lexemes() -> FreeMonoid<String> {
  match call_argument_fixture_normalized() {
    Accepted { value: roots, diagnostics: _ } =>
      fold_list(
        xs: normalized_tree_roots_to_nodes(roots: roots),
        empty: Empty,
        cons: fn(outer, root) {
          fold(node_subtree_nodes(root: root), init: outer, f: fn(acc, n) {
            match n.kind {
              TypeNode { connective: Atom { identity: sym } } =>
                concat(acc, [symbol_lexeme(sym: sym)])
              _ => acc
            }
          })
        }
      )
    Rejected { diagnostics: _ } => Empty
  }
}

fn atom_present(lexeme: String) -> Bool {
  any(fixture_atom_lexemes(), s => s == lexeme)
}

// A name may be an Atom (StampLexeme under residual reconstruct) or a Named edge.
// present_anywhere is both, so residual survival is not "not an atom".
fn fixture_edge_label_lexemes() -> FreeMonoid<String> {
  match call_argument_fixture_normalized() {
    Accepted { value: roots, diagnostics: _ } =>
      fold_list(
        xs: normalized_tree_roots_to_nodes(roots: roots),
        empty: Empty,
        cons: fn(outer, root) {
          fold(node_subtree_nodes(root: root), init: outer, f: fn(acc, n) {
            fold(n.children, init: acc, f: fn(inner, e) {
              match e.label {
                Named { name: sym } => concat(inner, [symbol_lexeme(sym: sym)])
                Positional => inner
              }
            })
          })
        }
      )
    Rejected { diagnostics: _ } => Empty
  }
}

fn label_present(lexeme: String) -> Bool {
  any(fixture_edge_label_lexemes(), s => s == lexeme)
}

fn present_anywhere(lexeme: String) -> Bool {
  atom_present(lexeme: lexeme) || label_present(lexeme: lexeme)
}

test fn control_a_parameter_type_name_is_an_atom_in_the_tree_holds() -> Bool {
  atom_present(lexeme: "Xl0UserType")
}

// Residual reconstruct keeps the field_decl_block type_decl unit; these lexemes
// are StampLexeme atoms under that shell. Combined is nonempty (fns/data in the
// XL-0 fixture), so the residual branch is taken. Rejected yields no lexemes, so
// presence is not true on a refused ingest. Named skip is enrolled on
// declaration_graft !assemble_accepts, not as tree absence.
// gunbc.recurring_failure_mode.type_decl_field_decl_block_not_named_at_graft.
test fn the_record_type_declaration_survives_in_the_tree_today() -> Bool {
  present_anywhere(lexeme: "Xl0Wrapper")
}

test fn the_bare_field_type_survives_in_the_tree_today() -> Bool {
  present_anywhere(lexeme: "Xl0FieldOnly")
}

test fn the_field_name_survives_in_the_tree_today() -> Bool {
  present_anywhere(lexeme: "fld")
}
