module v2.test.claim.namespace_xl0.reference_conservation

import v2.compiler.program_assembly { dag_prepared_grammar }
import v2.compiler.reference_conservation {
  ReferenceConservationReport,
  ReferenceConservationSubject,
  dag_declared_token_classes,
  reference_conservation_accepted,
  reference_conservation_admitted,
  reference_conservation_holds,
  reference_conservation_of_subject,
  reference_conservation_subject_of_read
}
import v2.compiler.source_authority { DagSourceReadWitness }
import v2.extdeps.languages.dag { dag_language_model }
import v2.std.algebra { fold_list, length }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.compilers.lexing { symbol_intern_lexeme }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.text { String }
import v2.std.integer { Int }
import extdeps.communication.medium { Lossless, Medium }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE FIXTURE CONTROLS FOR v2.compiler.reference_conservation.
//
// Each drop fixture carries ONE shape lowering is known to lose and names the one atom it loses;
// the clean control carries the same kinds of atom in positions lowering keeps. The claims assert
// two things per drop fixture -- the check is RED on it, and the red names the expected atom -- so
// a check that went red for some other reason (a population bug, an unreadable extent) cannot
// stand in for the discrimination. The control asserts the check is GREEN with a nonzero
// population, so a check that found nothing to conserve cannot pass as clean.
//
// THE DROP CLAIMS ARE STATED AS TODAY'S MEASUREMENT. When a lowering repair lands, its fixture's
// drop claim reds; the repair re-states it as a conserved control rather than deleting it (DESIGN
// section 4b(4): the discriminating evidence stays enrolled after the climb). The `a + b` fixture
// is the one #12145 repaired; it is now a conserved control.

fn conservation_fixture_read(id_tail: String, source: String) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: source, fidelity: Lossless },
    artifact: Artifact {
      kind: SourceFile,
      id: symbol_intern_lexeme(lexeme: "reference_conservation_fixture_" + id_tail),
      file_path: "src/v2/test/fixture/reference_conservation/" + id_tail + ".dag"
    },
    compilation_unit: symbol_intern_lexeme(lexeme: "reference_conservation_cu_" + id_tail),
    source_root: DagTree
  }
}

// THE SHARED PRODUCER IS THE SUBJECT (parse + normalize), NEVER THE VERDICT. Each fixture's
// `*_subject` is nullary and pure (its source is inline) and is enrolled WARM in
// v2.workflow.floor_pure_producer_share, so the production phases no claim here is about are paid
// once; every claim still executes reference_conservation_of_subject, which is what it names.
fn conservation_subject(id_tail: String, source: String) -> ReferenceConservationSubject {
  match dag_prepared_grammar() {
    Accepted { value: prepared, diagnostics: residue } =>
      reference_conservation_subject_of_read(
        read: conservation_fixture_read(id_tail: id_tail, source: source),
        lm: dag_language_model(),
        prepared: prepared,
        residue: residue
      )
    Rejected { diagnostics: d } =>
      ReferenceConservationSubject { path: "grammar-unprepared", parsed: Rejected { diagnostics: d }, normalized: Rejected { diagnostics: d } }
  }
}

fn conservation_report_of(subject: ReferenceConservationSubject) -> ReferenceConservationReport {
  reference_conservation_of_subject(subject: subject, token_classes: dag_declared_token_classes())
}

fn report_drops_identity(report: ReferenceConservationReport, wanted: Symbol) -> Bool {
  report_drop_count(report: report, wanted: wanted) > 0
}

fn report_drop_count(report: ReferenceConservationReport, wanted: Symbol) -> Int {
  fold_list(
    xs: report.dropped,
    empty: 0,
    cons: fn(acc, row) { if row.atom.identity == wanted { acc + 1 } else { acc } }
  )
}

// ---- the clean control -------------------------------------------------------------------------

data clean_control_source: String = "module v2.test.reference_conservation_clean\n\nimport v2.std.logic { Bool }\n\nfn rc_callee(probe: Bool) -> Bool { probe }\n\nfn rc_body(a: Bool, b: Bool) -> Bool { rc_callee(a) }\n\nfn rc_bare(c: Bool) -> Bool { c }\n\ndata rc_row: Int = 7\n\ntest fn rc_marked_holds() -> Bool { rc_bare(true) }\n"

fn clean_control_subject() -> ReferenceConservationSubject {
  conservation_subject(id_tail: "clean", source: clean_control_source)
}

fn clean_control_report() -> ReferenceConservationReport {
  conservation_report_of(subject: clean_control_subject())
}

test fn the_clean_control_conserves_every_authored_atom_holds() -> Bool {
  reference_conservation_admitted(report: clean_control_report())
}

// The three numbers are separate and together account for the whole population: a check that
// found nothing to conserve, or that summed locus-erased into conserved, cannot pass this.
test fn the_clean_control_accounts_for_its_population_in_three_separate_numbers_holds() -> Bool {
  let r = clean_control_report()
  r.conserved > 0 && r.locus_erased > 0 && r.conserved + r.locus_erased == r.authored
}

test fn the_clean_control_routes_imports_to_the_import_channel_holds() -> Bool {
  clean_control_report().import_channel > 0
}

// The `test` marker is consumed into NormalizedTree.test_markers; it is counted there, and the
// test fn it marks is still found and conserved as an ordinary declaration.
test fn the_clean_control_routes_the_test_marker_to_its_channel_holds() -> Bool {
  clean_control_report().test_marker_channel == 1
}

// ---- drop 1: the second statement of a block ---------------------------------------------------

data block_second_statement_source: String = "module v2.test.reference_conservation_block\n\nfn rc_block() -> Int { 1 \n 2 }\n"

fn block_second_statement_subject() -> ReferenceConservationSubject {
  conservation_subject(id_tail: "block_second_statement", source: block_second_statement_source)
}

fn block_second_statement_report() -> ReferenceConservationReport {
  conservation_report_of(subject: block_second_statement_subject())
}

test fn the_block_second_statement_is_reported_dropped_holds() -> Bool {
  let r = block_second_statement_report()
  reference_conservation_accepted(report: r) && report_drop_count(report: r, wanted: ^dag_token_int_literal) == 1
}

// ---- former drop 2: a call argument inside an if-arm (repaired by #12221) ---------------------

// MEASURED BOTH WAYS. Before gunbc#12221 the if-arm's call argument `rc_arm_arg` reached no reference
// site and this check reported it as exactly one DroppedReference. After #12221 (if-arms lower
// through the statement authority) the argument keeps its occurrence, and the pinned-drop claim went
// red on origin/main 53828ae4b2 (fierce-gull-556, seed-interpreted). Restated, not deleted (DESIGN
// section 4b(4)): it is now the permanent regression control that the if-arm argument is conserved.
// The argument is POSITIONAL on purpose: a named argument's label is its own, separately rostered
// drop (a_named_argument_label_is_reported_dropped_holds below), which would red this control for a
// reason that is not the if-arm. The argument's spelling is used NOWHERE else in its declaration, so
// the declaration-scoped pool cannot account for it: a regression drops it and names exactly it.
data if_arm_call_argument_source: String = "module v2.test.reference_conservation_if_arm\n\nimport v2.std.logic { Bool }\n\nfn rc_callee(probe: Bool) -> Bool { probe }\n\ndata rc_arm_arg: Bool = true\n\nfn rc_if_arm(c: Bool) -> Bool { if c { rc_callee(rc_arm_arg) } else { c } }\n"

fn if_arm_call_argument_subject() -> ReferenceConservationSubject {
  conservation_subject(id_tail: "if_arm_call_argument", source: if_arm_call_argument_source)
}

fn if_arm_call_argument_report() -> ReferenceConservationReport {
  conservation_report_of(subject: if_arm_call_argument_subject())
}

test fn the_if_arm_call_argument_is_conserved_holds() -> Bool {
  let r = if_arm_call_argument_report()
  reference_conservation_admitted(report: r) && report_drop_count(report: r, wanted: ^rc_arm_arg) == 0
}

// ---- former drop 3: a later operand of an operator chain (repaired by #12145) ------------------

// MEASURED BOTH WAYS. On main fec339d561 (before #12145) this check reported `rc_rhs` as exactly one
// DroppedReference. On #12145's head babf511 and on main after it, the operand keeps its occurrence
// and the row is gone. The fixture stays enrolled as the regression control DESIGN section 4b(4)
// asks for: if the operator tower ever drops a later operand again, this goes red on that atom.
data infix_right_operand_source: String = "module v2.test.reference_conservation_infix\n\nimport v2.std.logic { Bool }\n\ndata rc_lhs: Int = 1\n\ndata rc_rhs: Int = 2\n\nfn rc_compare() -> Bool { rc_lhs == rc_rhs }\n"

fn infix_right_operand_subject() -> ReferenceConservationSubject {
  conservation_subject(id_tail: "infix_right_operand", source: infix_right_operand_source)
}

fn infix_right_operand_report() -> ReferenceConservationReport {
  conservation_report_of(subject: infix_right_operand_subject())
}

test fn the_infix_right_operand_is_conserved_holds() -> Bool {
  let r = infix_right_operand_report()
  reference_conservation_admitted(report: r) && report_drop_count(report: r, wanted: ^rc_rhs) == 0
}

// ---- a measured drop outside the brief: the named-argument label ------------------------------

// Found by this check, not assumed: a call lowers its arguments positionally, so the LABEL of a
// named argument (`probe:` below) reaches no node and no edge of the normalized tree. The label
// names the callee's parameter, so it is a reference the resolver can no longer check. Stated as
// today's measurement; it reds when lowering carries the label.
data named_argument_label_source: String = "module v2.test.reference_conservation_label\n\nimport v2.std.logic { Bool }\n\nfn rc_callee(rc_label: Bool) -> Bool { rc_label }\n\nfn rc_labelled(c: Bool) -> Bool { rc_callee(rc_label: c) }\n"

fn named_argument_label_subject() -> ReferenceConservationSubject {
  conservation_subject(id_tail: "named_argument_label", source: named_argument_label_source)
}

fn named_argument_label_report() -> ReferenceConservationReport {
  conservation_report_of(subject: named_argument_label_subject())
}

test fn a_named_argument_label_is_reported_dropped_holds() -> Bool {
  let r = named_argument_label_report()
  reference_conservation_accepted(report: r) && report_drop_count(report: r, wanted: ^rc_label) == 1 && length(xs: r.dropped) == 1
}

// ---- a list-literal call argument: conserved (was a module-wide refusal) ---------------------

// Measured on main 1b2f64fd49: a call argument whose value was a list literal refused the WHOLE
// module at normalize, so every atom of the module was lost with no refusal at or above it
// (RefusalNotAtOrAbove rows). v2.compiler.body_lowering_fold body_lower_list_literal now lowers the
// literal as its free-monoid construction with every element whole, so this is restated as a
// conserved control (DESIGN section 4b(4)): both elements, and the callee, reach the lowered tree.
// A producer that kept only the first element drops `rc_list_second` and reds this. The argument
// is POSITIONAL on purpose: a named argument's label is a separate, already-rostered drop
// (a_named_argument_label_is_reported_dropped_holds below), and carrying it here would make this
// control red for a reason that is not the list.
data list_literal_argument_source: String = "module v2.test.reference_conservation_list_arg\n\nfn rc_list_callee(xs: List<Int>) -> Int { 1 }\n\ndata rc_elsewhere: Int = 3\n\ndata rc_list_second: Int = 4\n\nfn rc_list_caller() -> Int { rc_list_callee([rc_elsewhere, rc_list_second]) }\n"

fn list_literal_argument_subject() -> ReferenceConservationSubject {
  conservation_subject(id_tail: "list_literal_argument", source: list_literal_argument_source)
}

fn list_literal_argument_report() -> ReferenceConservationReport {
  conservation_report_of(subject: list_literal_argument_subject())
}

test fn a_list_literal_call_argument_conserves_every_element_holds() -> Bool {
  let r = list_literal_argument_report()
  reference_conservation_admitted(report: r)
    && report_drop_count(report: r, wanted: ^rc_elsewhere) == 0
    && report_drop_count(report: r, wanted: ^rc_list_second) == 0
    && report_drop_count(report: r, wanted: ^rc_list_callee) == 0
}

// ---- the multiset control: a repeated spelling, one copy dropped -------------------------------

// `rc_rep` is spelled three times in the declaration `rc_repeat`: as its parameter binder (rebuilt
// into an edge label, so LocusErased against the pool's one label), as the named argument's LABEL at
// the call (dropped: a call lowers its arguments positionally -- the rostered NamedArgumentLabel
// shape), and as the argument's VALUE (its occurrence survives). The pool is declaration-scoped and
// holds one copy, which the binder consumes, so exactly ONE DroppedReference remains -- neither zero
// (a pool that failed to consume) nor two (a pool that was never read). `rc_callee`'s own `rc_rep`
// binder and body use sit in a different declaration and cannot feed this pool.
// RE-PINNED after gunbc#12221: the previous fixture dropped its repeated copy as the second of two
// block statements (`{ rc_rep \n rc_rep }`), and #12221 made a statement followed by another refuse
// located, so it no longer dropped one copy (red on origin/main 53828ae4b2). The multiset property is
// the subject, not the statement shape, so the fixture now drops through the one shape still
// rostered as a known drop.
data repeated_spelling_source: String = "module v2.test.reference_conservation_repeat\n\nimport v2.std.logic { Bool }\n\nfn rc_callee(rc_rep: Bool) -> Bool { rc_rep }\n\nfn rc_repeat(rc_rep: Bool) -> Bool { rc_callee(rc_rep: rc_rep) }\n"

fn repeated_spelling_subject() -> ReferenceConservationSubject {
  conservation_subject(id_tail: "repeated_spelling", source: repeated_spelling_source)
}

fn repeated_spelling_report() -> ReferenceConservationReport {
  conservation_report_of(subject: repeated_spelling_subject())
}

test fn a_repeated_spelling_with_one_copy_dropped_is_exactly_one_row_holds() -> Bool {
  let r = repeated_spelling_report()
  reference_conservation_accepted(report: r) && report_drop_count(report: r, wanted: ^rc_rep) == 1 && length(xs: r.dropped) == 1
}

// ---- a measured drop found by admission: the where-refinement predicate -----------------------

// Found when v2.test.claim.body_lowering.declaration_structure_preserved was routed through
// v2.compiler.reference_conservation_admission conserved_normalize (MQ-6): normalize ACCEPTS a
// `where` refinement alias, and the predicate's name reaches no node and no edge of the normalized
// tree. Stated as today's measurement; it reds when lowering carries the predicate, and the
// explanation that fixture declares reds with it (conservation_reason_explanation_stale).
data where_refinement_predicate_source: String = "module v2.test.reference_conservation_where\n\ntype RcTight = String where rc_pred\n"

fn where_refinement_predicate_subject() -> ReferenceConservationSubject {
  conservation_subject(id_tail: "where_refinement_predicate", source: where_refinement_predicate_source)
}

test fn the_where_refinement_predicate_is_reported_dropped_holds() -> Bool {
  let r = conservation_report_of(subject: where_refinement_predicate_subject())
  reference_conservation_accepted(report: r) && report_drop_count(report: r, wanted: ^rc_pred) == 1 && length(xs: r.dropped) == 1
}

// ---- measured drops found by admission: a later match arm, a statement-let binder -------------

// Found when v2.test.claim.body_lowering.single_arm_match was routed through the admitted
// normalize (MQ-6): normalize ACCEPTS a three-arm match and the THIRD arm -- its pattern and its
// body -- reaches no node of the normalized tree. A two-arm match keeps both arms. The arm's body
// spelling is used nowhere else in the declaration, so the red names it.
data match_later_arm_source: String = "module v2.test.reference_conservation_match\n\ntype RcT = RcA | RcB | RcC\n\ndata rc_first: Int = 1\n\ndata rc_second: Int = 2\n\ndata rc_third: Int = 3\n\nfn rc_match(t: RcT) -> Int {\n  match t {\n    RcA => rc_first\n    RcB => rc_second\n    RcC => rc_third\n  }\n}\n"

test fn the_third_match_arm_is_reported_dropped_holds() -> Bool {
  let r = conservation_report_of(subject: match_later_arm_subject())
  reference_conservation_accepted(report: r) && report_drops_identity(report: r, wanted: ^rc_third)
}

// Found the same way through v2.test.claim.body_lowering.statement_let_bind: a statement-form let's
// binder keeps neither its occurrence nor an unconsumed copy of its spelling, while the later use
// of the name is conserved at its own occurrence.
data statement_let_binder_source: String = "module v2.test.reference_conservation_let\n\nfn rc_let() -> Int {\n  let rc_bound = 1\n  rc_bound\n}\n"

test fn a_statement_let_binder_is_reported_dropped_holds() -> Bool {
  let r = conservation_report_of(subject: statement_let_binder_subject())
  reference_conservation_accepted(report: r) && report_drop_count(report: r, wanted: ^rc_bound) == 1 && length(xs: r.dropped) == 1
}

fn match_later_arm_subject() -> ReferenceConservationSubject {
  conservation_subject(id_tail: "match_later_arm", source: match_later_arm_source)
}

fn statement_let_binder_subject() -> ReferenceConservationSubject {
  conservation_subject(id_tail: "statement_let_binder", source: statement_let_binder_source)
}

// ---- anonymous parameter slots are conserved by their minted identity -------------------------

// Each `_` parameter lowers to its own minted binder (v2.std.anonymous_binder), so the label is
// never the spelling `_`. The pool credits an authored `_` against the anonymous-slot class, keyed
// on the minted identity: both `_` here are conserved and none is dropped. Keying the pool on the
// spelling instead drops both.
data anonymous_slots_source: String = "module v2.test.reference_conservation_anonymous\n\nfn rc_anon(_: Int, _: Bool) -> Int { 1 }\n"

fn anonymous_slots_subject() -> ReferenceConservationSubject {
  conservation_subject(id_tail: "anonymous_slots", source: anonymous_slots_source)
}

test fn two_anonymous_parameter_slots_are_conserved_by_minted_identity_holds() -> Bool {
  let r = conservation_report_of(subject: anonymous_slots_subject())
  reference_conservation_admitted(report: r)
    && report_drop_count(report: r, wanted: symbol_intern_lexeme(lexeme: "_")) == 0
    && r.authored > 0
}

// ---- the refusing fixture: acceptance is not the absence of drops -------------------------------

// A MODULE NORMALIZATION REFUSES MUST NOT PASS AS CONSERVED. A caret-symbol operand has no lowered
// form yet (gunbc.recurring_failure_mode caret_symbol_has_no_lowered_form), so this module refuses
// at normalize, located at the operand. reference_conservation_holds does not see that: a located
// refusal accounts for the atoms it covers, so the report can have no drops and no unmeasured rows.
// Every "lowered, and ..." control above therefore reads reference_conservation_accepted /
// reference_conservation_admitted, and this is their shared mutation: on a refusing report the
// shared predicate is false, so each of those controls would be red. When caret symbols lower, this
// fixture stops refusing and this claim reds -- restate it on whatever still refuses then.
data refusing_fixture_source: String = "module v2.test.reference_conservation_refusing\n\nimport v2.std.logic { Bool }\nimport v2.std.node { Symbol }\n\nfn rc_refusing(rc_sym_arg: Symbol) -> Bool { rc_sym_arg == ^rc_caret }\n"

fn refusing_fixture_subject() -> ReferenceConservationSubject {
  conservation_subject(id_tail: "refusing_fixture", source: refusing_fixture_source)
}

test fn a_refusing_module_is_neither_accepted_nor_admitted_holds() -> Bool {
  let r = conservation_report_of(subject: refusing_fixture_subject())
  (r.refused > 0)
    && !reference_conservation_accepted(report: r)
    && !reference_conservation_admitted(report: r)
}
