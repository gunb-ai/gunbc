test fn an_undeclared_plain_right_operand_of_a_call_argument_refuses_at_resolve_at_its_atom() -> Bool {
  match dsr_outcomes() {
    DsrOutcomesDecided { then_arm: _, else_arm: _, declared_arm: _, outside_call: _, second_statement: _, let_headed: _, let_reference: _, group_match_arm: _, group_let_value: _, group_call_arg: _, group_declared: _, plain_call_arg: v } =>
      dsr_is_unbound_at(v: v, spelling: ^dsr_undeclared_plain_arg)
