test fn a_declared_name_in_a_parenthesised_operand_resolves() -> Bool {
  match dsr_outcomes() {
    DsrOutcomesDecided { then_arm: _, else_arm: _, declared_arm: _, outside_call: _, second_statement: _, let_headed: _, let_reference: _, group_match_arm: _, group_let_value: _, group_call_arg: _, group_declared: v, plain_call_arg: _ } =>
      dsr_is_resolved(v: v)
    DsrContextRefused => false
