fn lst_unbound_at(v: LstVerdict, atom: Symbol) -> Bool {
  match v {
    LstRefused { reason: r, at_atom: Present { value: id } } => (r == ^resolve_reason_unbound_symbol) && (id == atom)
    _ => false
  }
}
