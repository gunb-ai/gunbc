  Cons {
    head: lst_read(source: lst_ctl_body_let_source, id: ^lst_ctl_body_let_artifact, unit: ^lst_ctl_body_let_cu, path: "src/v2/test/fixture/namespace_xl0/lst_ctl_body_let.dag"),
    tail: Cons {
    head: lst_read(source: lst_ctl_arm_expr_source, id: ^lst_ctl_arm_expr_artifact, unit: ^lst_ctl_arm_expr_cu, path: "src/v2/test/fixture/namespace_xl0/lst_ctl_arm_expr.dag"),
    tail: Cons {
