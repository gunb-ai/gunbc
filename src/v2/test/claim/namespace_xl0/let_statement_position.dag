    LstOutcomesDecided { ctl_body_let: _, ctl_arm_expr: _, ctl_arm_block: _, ctl_if_branch: _, ctl_fn_value: _, tail_let: _, tail_let_after_let: _, tail_let_match: _, tail_let_und: _, arm_block_let: _, arm_block_two_let: _, arm_tail_let: _, arm_block_if_match: _, if_match_branch: _, arm_rest_und: _, tail_call: _, last_arm_block: v, let_und_reachable: _ } => lst_is_resolved(v: v)
    LstContextRefused => false
  }
}

// NOT A WIDENING. A body that normalizes -- statement let, then a trailing expression -- still hands the
// let's bound value to the resolver, so the undeclared atom refuses AT ITS OWN ATOM. If the fold had
// begun to drop a tail it could not justify, this file would lower instead of refusing.
test fn a_reachable_statement_let_refuses_its_undeclared_atom() -> Bool {
  match lst_outcomes() {
    LstOutcomesDecided { ctl_body_let: _, ctl_arm_expr: _, ctl_arm_block: _, ctl_if_branch: _, ctl_fn_value: _, tail_let: _, tail_let_after_let: _, tail_let_match: _, tail_let_und: _, arm_block_let: _, arm_block_two_let: _, arm_tail_let: _, arm_block_if_match: _, if_match_branch: _, arm_rest_und: _, tail_call: _, last_arm_block: _, let_und_reachable: v } => lst_unbound_at(v: v, atom: ^lst_undeclared_atom)
    LstContextRefused => false
  }
}
// ---------------------------------------------------------------------------
// PROBE (temporary, not a claim). The paired run at 76a531366d3d reported 13 of 17 rows false at BOTH
// legs -- every is_accepted control -- so the archived author recorded predictions rather than readings, and
// the runner prints no values (claim_batch gives PASS / FAIL / UNOBSERVED plus closure diagnostics, never a
// computed value; confirmed with the build owner). These rows classify verdicts instead of pinning
// behaviour, so each PASS is one reading of what this route actually decides. probe_verdict_of re-enters the
// same ingest the claims read, so the classes below are the same verdicts the pinned rows see. This block is
// deleted before the PR lands; the pinned rows are rewritten from the readings it produces, which is what
// review 92393 asks for (run the suite, cite the run).

fn probe_verdict_of(name: String, unit: Symbol) -> LstVerdict {
  match native_test_context_from_ingest(ingest: lst_ingest()) {
    Rejected { diagnostics: _ } => LstAbsent
    Accepted { value: context, diagnostics: _ } => lst_verdict_in(context: context, module_name: name, unit: unit)
  }
}

fn probe_class(name: String, unit: Symbol, want: Symbol) -> Bool {
  match probe_verdict_of(name: name, unit: unit) {
    LstResolved => want == ^probe_class_resolved
    LstRefused { reason: _, at_atom: _ } => want == ^probe_class_resolve_refused
    LstFileRefused { fatal_reason: _ } => want == ^probe_class_file_refused
    LstAbsent => want == ^probe_class_absent
  }
}

fn probe_file_reason(name: String, unit: Symbol, want: Symbol) -> Bool {
  match probe_verdict_of(name: name, unit: unit) {
    LstFileRefused { fatal_reason: Present { value: r } } => r == want
    _ => false
  }
}

fn probe_file_reason_present(name: String, unit: Symbol) -> Bool {
  match probe_verdict_of(name: name, unit: unit) {
    LstFileRefused { fatal_reason: Present { value: _ } } => true
    _ => false
  }
}

