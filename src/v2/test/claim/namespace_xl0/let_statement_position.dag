    LstContextRefused => false
  }
}

// The shape BOTH gap files author, which the earlier fixtures did not pin: the braced block is the LAST
// arm of the match, preceded by an arm whose body is a plain value.
test fn a_braced_block_that_is_the_last_match_arm_lowers() -> Bool {
