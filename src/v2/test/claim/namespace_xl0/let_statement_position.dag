    tail: Cons {
    head: lst_read(source: lst_ctl_fn_value_source, id: ^lst_ctl_fn_value_artifact, unit: ^lst_ctl_fn_value_cu, path: "src/v2/test/fixture/namespace_xl0/lst_ctl_fn_value.dag"),
    tail: Cons {
