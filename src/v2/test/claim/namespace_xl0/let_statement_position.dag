  }
  }
  }
  }
  }
  }
  }
  }
  }
  }
  }
  }
  }
  }
}

type LstVerdict
  = LstResolved
  | LstRefused { reason: Symbol, at_atom: Optional<Symbol> }
  | LstFileRefused { fatal_reason: Optional<Symbol> }
  | LstAbsent

type LstOutcomes
  = LstContextRefused
  | LstOutcomesDecided {
      ctl_body_let: LstVerdict
      ctl_arm_expr: LstVerdict
      ctl_arm_block: LstVerdict
      ctl_if_branch: LstVerdict
      ctl_fn_value: LstVerdict
      tail_let: LstVerdict
      tail_let_after_let: LstVerdict
      tail_let_match: LstVerdict
      tail_let_und: LstVerdict
      arm_block_let: LstVerdict
      arm_block_two_let: LstVerdict
      arm_tail_let: LstVerdict
      arm_block_if_match: LstVerdict
      if_match_branch: LstVerdict
      arm_rest_und: LstVerdict
    }

fn lst_file_refusal_reason(context: NativeTestContext, unit: Symbol) -> Optional<Symbol> {
  fold_list(
    xs: context.file_refusals,
    empty: optional_absent(),
    cons: fn(acc, refusal) {
      if refusal.path == unit { optional_present(value: native_test_file_refusal_fatal_reason(fr: refusal)) } else { acc }
    }
  )
}

fn lst_verdict_of(context: NativeTestContext, unit: Symbol, outcome: NativeCensusModuleOutcome) -> LstVerdict {
  match outcome {
    NativeCensusModuleResolved => LstResolved
    NativeCensusModuleFileRefused =>
      LstFileRefused { fatal_reason: lst_file_refusal_reason(context: context, unit: unit) }
    NativeCensusModuleResolveRefused { first: d, rest: _, observation: _ } =>
      LstRefused {
        reason: d.head.reason,
        at_atom: match d.head.at {
          NodeLocus { anchor: a } => node_atom_identity_optional(node: a.at)
          _ => optional_absent()
        }
      }
  }
}

fn lst_verdict_in(context: NativeTestContext, module_name: String, unit: Symbol) -> LstVerdict {
  fold_list(
    xs: native_census_modules(ingest: lst_ingest()),
    empty: LstAbsent,
    cons: fn(acc, entry) {
      if entry.module == module_name {
        lst_verdict_of(
          context: context,
          unit: unit,
          outcome: native_census_module_resolution(
            context: context,
            refusal_index: native_lane_file_refusal_index(refusals: context.file_refusals),
            entry: entry
          ).outcome
        )
      } else {
        acc
      }
    }
  )
}

fn lst_outcomes() -> LstOutcomes {
  match native_test_context_from_ingest(ingest: lst_ingest()) {
    Rejected { diagnostics: _ } => LstContextRefused
    Accepted { value: context, diagnostics: _ } =>
      LstOutcomesDecided {
        ctl_body_let: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_ctl_body_let", unit: ^lst_ctl_body_let_cu),
        ctl_arm_expr: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_ctl_arm_expr", unit: ^lst_ctl_arm_expr_cu),
        ctl_arm_block: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_ctl_arm_block", unit: ^lst_ctl_arm_block_cu),
        ctl_if_branch: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_ctl_if_branch", unit: ^lst_ctl_if_branch_cu),
        ctl_fn_value: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_ctl_fn_value", unit: ^lst_ctl_fn_value_cu),
        tail_let: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_tail_let", unit: ^lst_tail_let_cu),
        tail_let_after_let: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_tail_let_after_let", unit: ^lst_tail_let_after_let_cu),
        tail_let_match: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_tail_let_match", unit: ^lst_tail_let_match_cu),
        tail_let_und: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_tail_let_und", unit: ^lst_tail_let_und_cu),
        arm_block_let: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_arm_block_let", unit: ^lst_arm_block_let_cu),
        arm_block_two_let: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_arm_block_two_let", unit: ^lst_arm_block_two_let_cu),
        arm_tail_let: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_arm_tail_let", unit: ^lst_arm_tail_let_cu),
        arm_block_if_match: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_arm_block_if_match", unit: ^lst_arm_block_if_match_cu),
        if_match_branch: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_if_match_branch", unit: ^lst_if_match_branch_cu),
        arm_rest_und: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_arm_rest_und", unit: ^lst_arm_rest_und_cu)
      }
  }
}

fn lst_is_resolved(v: LstVerdict) -> Bool {
  match v {
    LstResolved => true
    _ => false
  }
}

fn lst_refuses_as(v: LstVerdict, reason: Symbol) -> Bool {
  match v {
    LstFileRefused { fatal_reason: Present { value: r } } => r == reason
    _ => false
  }
}

fn lst_unbound_at(v: LstVerdict, atom: Symbol) -> Bool {
  match v {
    LstRefused { reason: r, at_atom: Present { value: id } } => (r == ^resolve_reason_unbound_symbol) && (id == atom)
    _ => false
  }
}

// THE SPINE ALREADY OWNS THESE. They hold on main and must hold after the repair: the spine's own
// let-with-a-following-statement, an arm body of one expression, a let inside an if-branch, a let
// inside a function value's braced body.
test fn a_body_top_level_let_with_a_following_statement_is_accepted() -> Bool {
  match lst_outcomes() {
    LstOutcomesDecided { ctl_body_let: v, ctl_arm_expr: _, ctl_arm_block: _, ctl_if_branch: _, ctl_fn_value: _, tail_let: _, tail_let_after_let: _, tail_let_match: _, tail_let_und: _, arm_block_let: _, arm_block_two_let: _, arm_tail_let: _, arm_block_if_match: _, if_match_branch: _, arm_rest_und: _ } => lst_is_resolved(v: v)
    LstContextRefused => false
  }
}

test fn a_braced_arm_of_one_expression_is_accepted() -> Bool {
  match lst_outcomes() {
    LstOutcomesDecided { ctl_body_let: _, ctl_arm_expr: _, ctl_arm_block: v, ctl_if_branch: _, ctl_fn_value: _, tail_let: _, tail_let_after_let: _, tail_let_match: _, tail_let_und: _, arm_block_let: _, arm_block_two_let: _, arm_tail_let: _, arm_block_if_match: _, if_match_branch: _, arm_rest_und: _ } => lst_is_resolved(v: v)
    LstContextRefused => false
  }
}

test fn a_let_in_an_if_branch_is_accepted() -> Bool {
  match lst_outcomes() {
    LstOutcomesDecided { ctl_body_let: _, ctl_arm_expr: _, ctl_arm_block: _, ctl_if_branch: v, ctl_fn_value: _, tail_let: _, tail_let_after_let: _, tail_let_match: _, tail_let_und: _, arm_block_let: _, arm_block_two_let: _, arm_tail_let: _, arm_block_if_match: _, if_match_branch: _, arm_rest_und: _ } => lst_is_resolved(v: v)
    LstContextRefused => false
  }
}

test fn a_let_in_a_function_value_body_is_accepted() -> Bool {
  match lst_outcomes() {
    LstOutcomesDecided { ctl_body_let: _, ctl_arm_expr: _, ctl_arm_block: _, ctl_if_branch: _, ctl_fn_value: v, tail_let: _, tail_let_after_let: _, tail_let_match: _, tail_let_und: _, arm_block_let: _, arm_block_two_let: _, arm_tail_let: _, arm_block_if_match: _, if_match_branch: _, arm_rest_und: _ } => lst_is_resolved(v: v)
    LstContextRefused => false
  }
}

// THE REDS (v2.extdeps.languages.dag dag_grammar_let_expr drops the `in` form, so a statement let has no
// body of its own and the door-holder refuses it): each of these is the whole of what the position adds
// to a shape the compiler already lowers.
test fn a_tail_statement_let_in_a_fn_body_is_accepted() -> Bool {
  match lst_outcomes() {
    LstOutcomesDecided { ctl_body_let: _, ctl_arm_expr: _, ctl_arm_block: _, ctl_if_branch: _, ctl_fn_value: _, tail_let: v, tail_let_after_let: _, tail_let_match: _, tail_let_und: _, arm_block_let: _, arm_block_two_let: _, arm_tail_let: _, arm_block_if_match: _, if_match_branch: _, arm_rest_und: _ } => lst_is_resolved(v: v)
    LstContextRefused => false
  }
}

