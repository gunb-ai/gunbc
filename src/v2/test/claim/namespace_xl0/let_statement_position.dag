// A STATEMENT LET REACHED AS A VALUE REFUSES AT THE DOOR-HOLDER RATHER THAN LOWERING.
//
// THE SUBJECT IS THE NATIVE LANE'S NORMALIZE, as in
// v2.test.claim.namespace_xl0.return_tail_position and
// v2.test.claim.namespace_xl0.let_match_early_return.
//
// v2.compiler.body_lowering_fold reads a STATEMENT let in exactly one place: body_lower_stmt_spine,
// which binds the let's key to its lowered value and the lowered REST of the spine as its body, and
// body_lower_let_expr is the door-holder for the `in` form the grammar dropped — every arm of it
// refuses, and its Present arm answers body_lowering_reason_let_body_not_reachable_from_node. So a
// let-shaped node that reaches the term dispatcher (body_lower_fold_dispatch, whose let arm calls that
// door-holder) cannot lower, whatever the source said.
//
// Two positions in the corpus hand a statement let to the VALUE reader, and both sit in the whole-corpus
// census on plain main, each keeping its file on the wave's fallback:
//
//   fci1_canonical_cleanup_disposition, in dag/gunbc/instruments/fabric_control_plane_live_probe.dag —
//     the LAST statement of its body is a statement let (`let disposition = match ...`, with
//     no following expression). A spine with no following statement leaves body_lower_stmt_spine through
//     its Absent arm to body_lower_tail_statement_read, which reads the statement as a VALUE: the let
//     reaches the dispatcher and refuses.
//   path_is_under_production_instance_root, in dag/gunbc/instruments/compute_run_unit_cold.dag — the
//     braced arm block of its `ProdRoleRealizedBy { holder }` arm begins with a
//     statement let (`let root = holder.instance.instance_root`) and ends with the arm's value
//     expression, which READS that binding. The arm's body reaches the same value reader and refuses at
//     the let, before its rest is ever read.
//
// THE REDS are the two positions and their siblings, each varying one thing; THE CONTROLS are the same
// shapes that the spine already owns — a body-top-level let with a following statement, a braced arm with
// one expression, a let in an if-branch — and must resolve. The three `_und` fixtures put an undeclared
// name in a position the lowering either reads or refuses before reading, and which one it is differs by
// position: a SPINE let's value (`lst_let_und_reachable`) and an ARM BLOCK'S rest (`lst_arm_rest_und`) are
// read, so each must refuse unbound AT ITS OWN ATOM; a TAIL let's value (`lst_tail_let_und`) is the one
// place the lowering door-holder answers first, so that row expects the tail-position refusal and NO unbound
// atom — it pins which door answers first, not that the value is reached. And the arm-block let's binder
// must stay readable from its rest, which is what the plain `is_accepted` claim for that shape checks. A
// fix that dropped the binding, or dropped either half, would flip one of those rows.
// FIXTURE SOURCES LIVE IN THIS CLAIM, NOT ON DISK. Each row's module is carried inline as the `source` of
// a DagSourceReadWitness, and the `path` argument is an artifact LABEL, not a repository file. This branch
// once also materialized each fixture under src/v2/test/fixture/namespace_xl0/ and added a
// source_layout_namespaces row to make those files compilable: two sources for one fact, one of which
// nothing read (the claim never opens a file). The files and the layout row are removed; this claim is the
// single home, so a fixture cannot drift from what is asserted about it.
//
// ONE ROW THE ARCHIVED BRANCH HAD IS WITHDRAWN, NOT RESTORED. It pinned a braced arm block whose tail
// statement opens with a parenthesized expression as a door-holder refusal. That expectation asserts how
// the parser resolves a line-leading `(` -- a question this suite cannot answer, since the grammar declares
// no statement terminator and exactly one newline-continuation guard (`-`, v2.extdeps.languages
// dag_grammar_additive_newline_minus_guard) -- and a module the seed ACCEPTS authors exactly that shape: the
// line-leading `(` in path_is_under_production_instance_root, dag/gunbc/instruments/compute_run_unit_cold.dag.
// The suite has never been run, so the row recorded a prediction about the parser as if it were a reading.
// Re-pinning it in the other direction would be the same fabrication mirrored, so the question -- can a
// statement expression begin with `(` -- is left open and unrowed until someone RUNS the shape.
//
data lst_ctl_body_let_source: String = "module v2.test.fixture.namespace_xl0.lst_ctl_body_let\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\nfn lst_probe(i: Int) -> Int {\n  let x = i\n  x\n}\n"

data lst_ctl_arm_expr_source: String = "module v2.test.fixture.namespace_xl0.lst_ctl_arm_expr\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LstS = LstA { v: Int } | LstB\n\nfn lst_probe(s: LstS, i: Int) -> Int { match s {\n  LstA { v: v } => v\n  LstB => i\n} }\n"

data lst_ctl_arm_block_source: String = "module v2.test.fixture.namespace_xl0.lst_ctl_arm_block\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LstS = LstA { v: Int } | LstB\n\nfn lst_probe(s: LstS, i: Int) -> Int { match s {\n  LstA { v: v } => { v }\n  LstB => i\n} }\n"

data lst_ctl_if_branch_source: String = "module v2.test.fixture.namespace_xl0.lst_ctl_if_branch\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\nfn lst_probe(c: Bool, i: Int) -> Int { if c {\n    let x = i\n    x\n  } else { i } }\n"

data lst_ctl_fn_value_source: String = "module v2.test.fixture.namespace_xl0.lst_ctl_fn_value\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\nfn lst_probe(i: Int) -> Int {\n  let g = fn(x) {\n    let y = x\n    y\n  }\n  i\n}\n"

data lst_tail_let_source: String = "module v2.test.fixture.namespace_xl0.lst_tail_let\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\nfn lst_probe(i: Int) -> Int {\n  let x = i\n}\n"

data lst_tail_let_after_let_source: String = "module v2.test.fixture.namespace_xl0.lst_tail_let_after_let\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\nfn lst_probe(i: Int, j: Int) -> Int {\n  let a = i\n  let d = j\n}\n"

data lst_tail_let_match_source: String = "module v2.test.fixture.namespace_xl0.lst_tail_let_match\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LstS = LstA { v: Int } | LstB\n\nfn lst_probe(s: LstS, i: Int) -> Int {\n  let j = i\n  let d = match s {\n    LstA { v: v } => v\n    LstB => j\n  }\n}\n"

data lst_tail_let_und_source: String = "module v2.test.fixture.namespace_xl0.lst_tail_let_und\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\nfn lst_probe(i: Int) -> Int {\n  let x = lst_undeclared_tail_value\n}\n"

data lst_arm_block_let_source: String = "module v2.test.fixture.namespace_xl0.lst_arm_block_let\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LstS = LstA { v: Int } | LstB\n\nfn lst_uses(x: Int) -> Int { x }\n\nfn lst_probe(s: LstS, i: Int) -> Int { match s {\n  LstA { v: v } => {\n    let r = v\n    lst_uses(x: r)\n  }\n  LstB => i\n} }\n"

data lst_arm_block_two_let_source: String = "module v2.test.fixture.namespace_xl0.lst_arm_block_two_let\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LstS = LstA { v: Int } | LstB\n\nfn lst_uses(x: Int, y: Int) -> Int { x }\n\nfn lst_probe(s: LstS, i: Int) -> Int { match s {\n  LstA { v: v } => {\n    let r = v\n    let q = i\n    lst_uses(x: r, y: q)\n  }\n  LstB => i\n} }\n"

data lst_arm_tail_let_source: String = "module v2.test.fixture.namespace_xl0.lst_arm_tail_let\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LstS = LstA { v: Int } | LstB\n\nfn lst_probe(s: LstS, i: Int) -> Int { match s {\n  LstA { v: v } => {\n    let r = v\n  }\n  LstB => i\n} }\n"
data lst_arm_block_if_match_source: String = "module v2.test.fixture.namespace_xl0.lst_arm_block_if_match\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LstS = LstA { v: Int } | LstB\n\nfn lst_uses(x: Int) -> Int { x }\n\nfn lst_predicate(i: Int) -> Bool { i > 0 }\n\n// The shape dag/gunbc/instruments/fabric_control_plane_live_probe.dag:1053 authored: a braced arm block\n// whose first statement binds an `if` whose branches are matches, and whose last statement reads that\n// binding. Resolving it means the block is read as a statement sequence, not as a head.\nfn lst_probe(s: LstS, i: Int) -> Int { match s {\n  LstA { v: v } => {\n    let chosen = if lst_predicate(i: v) {\n      match s {\n        LstA { v: w } => lst_uses(x: w)\n        LstB => i\n      }\n    } else {\n      match s {\n        LstA { v: w } => lst_uses(x: w)\n        LstB => 0\n      }\n    }\n    let shifted = chosen + 1\n    lst_uses(x: shifted)\n  }\n  LstB => i\n} }\n"
data lst_if_match_branch_source: String = "module v2.test.fixture.namespace_xl0.lst_if_match_branch\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LstS = LstA { v: Int } | LstB\n\nfn lst_uses(x: Int) -> Int { x }\n\nfn lst_predicate(i: Int) -> Bool { i > 0 }\n\n// The SIBLING leaf of the arm block (DESIGN 6b root generalization): an `if` at term position whose\n// branches are braced statement sequences. One rule reads a braced block in term position, so a braced\n// if-branch must be read the same way as a braced arm body -- or the fix is a per-leaf patch.\nfn lst_probe(s: LstS, i: Int) -> Int { if lst_predicate(i: i) {\n  let left = lst_uses(x: i)\n  let scaled = left * 2\n  lst_uses(x: scaled)\n} else {\n  match s {\n    LstA { v: v } => lst_uses(x: v)\n    LstB => 0\n  }\n} }\n"

data lst_arm_rest_und_source: String = "module v2.test.fixture.namespace_xl0.lst_arm_rest_und\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LstS = LstA { v: Int } | LstB\n\nfn lst_probe(s: LstS, i: Int) -> Int { match s {\n  LstA { v: v } => {\n    let r = v\n    lst_undeclared_arm_rest\n  }\n  LstB => i\n} }\n"

data lst_tail_call_source: String = "// Materialized fixture for the statement-position claim suite (v2.test.claim.namespace_xl0.let_statement_position).\n// Inline source of this claim's own artifact (the path in lst_ingest is a label, not a repository file). Same braced block and bindings as the parenthesized variant that is NOT pinned here: the tail statement is a plain call. Must lower.\nmodule v2.test.fixture.namespace_xl0.lst_tail_call\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LstS = LstA { v: Int } | LstB\n\nfn lst_uses(x: Int) -> Int { x }\n\nfn lst_equal(a: Int, b: Int) -> Bool { a == b }\n\nfn lst_probe(s: LstS, i: Int) -> Int { match s {\n  LstA { v: v } => lst_uses(x: v)\n  LstB => {\n    let root = i\n    lst_uses(x: root)\n  }\n} }"
data lst_last_arm_block_source: String = "// Materialized fixture for the statement-position claim suite (v2.test.claim.namespace_xl0.let_statement_position).\n// Read as a module by the native lane. Shape of both gap files: the braced block is the LAST arm of the match, preceded by an arm whose body is a plain value. Must lower.\nmodule v2.test.fixture.namespace_xl0.lst_last_arm_block\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LstS = LstA { v: Int } | LstB\n\nfn lst_uses(x: Int) -> Int { x }\n\nfn lst_equal(a: Int, b: Int) -> Bool { a == b }\n\nfn lst_probe(s: LstS, i: Int) -> Int { match s {\n  LstA { v: v } => v\n  LstB => {\n    let root = i\n    lst_uses(x: root)\n  }\n} }"
data lst_let_und_reachable_source: String = "// Materialized fixture for the statement-position claim suite (v2.test.claim.namespace_xl0.let_statement_position).\n// Read as a module by the native lane. The body normalizes: the statement `let` is followed by a trailing\n// expression, so it is not a tail let and no wrapper is retained. Its bound value names an atom this module never\n// declares. This is the non-widening control for the fold change: if the binder still hands that atom to the\n// resolver the census must refuse it with resolve_reason_unbound_symbol here, and if the fold were silently\n// dropping the tail the file would lower.\nmodule v2.test.fixture.namespace_xl0.lst_let_und_reachable\n\nimport v2.std.integer { Int }\n\nfn lst_uses(x: Int) -> Int { x }\n\nfn lst_probe(i: Int) -> Int {\n  let q = lst_undeclared_atom(x: i)\n  lst_uses(x: q)\n}"

fn lst_read(source: String, id: Symbol, unit: Symbol, path: String) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: source, fidelity: Lossless },
    artifact: Artifact { kind: SourceFile, id: id, file_path: path },
    compilation_unit: unit,
    source_root: DagTree
  }
}

