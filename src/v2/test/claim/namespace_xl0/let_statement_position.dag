// The fabric shape: an `if` bound by a statement let inside a braced arm block, read back by the last
// statement. This is the gap the census reports at fabric_control_plane_live_probe.dag:1053:3.
test fn an_if_bound_by_a_let_in_a_braced_match_arm_block_is_an_accepted_control() -> Bool {
  match lst_outcomes() {
    LstOutcomesDecided { ctl_body_let: _, ctl_arm_expr: _, ctl_arm_block: _, ctl_if_branch: _, ctl_fn_value: _, tail_let: _, tail_let_after_let: _, tail_let_match: _, arm_block_let: _, arm_block_two_let: _, arm_tail_let: _, arm_rest_und: _, arm_block_if_match: v, if_match_branch: _, tail_call: _, let_und_reachable: _, tail_let_und: _, last_arm_block: _ } => lst_is_resolved(v: v)
    LstContextRefused => false
  }
}

// The sibling leaf: braced `if` branches at term position, each a statement sequence with its own lets.
