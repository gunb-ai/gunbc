// The shape dag/gunbc/instruments/compute_run_unit_cold.dag:97 authored: a braced arm block that begins
// with a statement let and ends with a value expression that READS the binding. Resolving this one is
// what rules out the cheap answer of dropping the binding — the rest names it.
test fn a_let_in_a_braced_match_arm_block_is_an_accepted_control() -> Bool {
  match lst_outcomes() {
    LstOutcomesDecided { ctl_body_let: _, ctl_arm_expr: _, ctl_arm_block: _, ctl_if_branch: _, ctl_fn_value: _, tail_let: _, tail_let_after_let: _, tail_let_match: _, arm_block_let: v, arm_block_two_let: _, arm_tail_let: _, arm_block_if_match: _, if_match_branch: _, arm_rest_und: _, tail_call: _, let_und_reachable: _, tail_let_und: _, last_arm_block: _ } => lst_is_resolved(v: v)
    LstContextRefused => false
  }
}

