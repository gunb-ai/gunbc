// The positive control for the arm-block rows: the same block, the same bindings, the tail statement a
// plain call. If this refuses too, the refusals above are about something other than statement position.
test fn a_tail_statement_call_in_the_same_arm_block_lowers() -> Bool {
  match lst_outcomes() {
    LstOutcomesDecided { ctl_body_let: _, ctl_arm_expr: _, ctl_arm_block: _, ctl_if_branch: _, ctl_fn_value: _, tail_let: _, tail_let_after_let: _, tail_let_match: _, arm_block_let: _, arm_block_two_let: _, arm_tail_let: _, arm_block_if_match: _, if_match_branch: _, arm_rest_und: _, tail_call: v, let_und_reachable: _, tail_let_und: _, last_arm_block: _ } => lst_is_resolved(v: v)
    LstContextRefused => false
  }
}


// NOT A WIDENING. A body that normalizes -- statement let, then a trailing expression -- still hands the
// let's bound value to the resolver, so the undeclared atom refuses AT ITS OWN ATOM. If the fold had
// begun to drop a tail it could not justify, this file would lower instead of refusing.
test fn a_reachable_statement_let_refuses_unbound_at_its_own_atom() -> Bool {
  match lst_outcomes() {
    LstOutcomesDecided { ctl_body_let: _, ctl_arm_expr: _, ctl_arm_block: _, ctl_if_branch: _, ctl_fn_value: _, tail_let: _, tail_let_after_let: _, tail_let_match: _, arm_block_let: _, arm_block_two_let: _, arm_tail_let: _, arm_block_if_match: _, if_match_branch: _, arm_rest_und: _, tail_call: _, let_und_reachable: v, tail_let_und: _, last_arm_block: _ } => lst_unbound_at(v: v, atom: ^lst_undeclared_atom)
    LstContextRefused => false
  }
}

// RESTORED PAIR (work item adhoc-d6e47a99-2e0): the two intents whose fixtures lively-crane-453 dropped
// unexecuted in #15363. They never had a row; both are pinned to an executed reading, paired against main.
// A tail `let` is refused before it is ever resolved, so its undeclared value is never reached -- whereas the
// arm block's rest below IS resolved.
test fn a_tail_statement_let_whose_value_is_undeclared_is_never_resolved() -> Bool {
  match lst_outcomes() {
    LstOutcomesDecided { ctl_body_let: _, ctl_arm_expr: _, ctl_arm_block: _, ctl_if_branch: _, ctl_fn_value: _, tail_let: _, tail_let_after_let: _, tail_let_match: _, arm_block_let: _, arm_block_two_let: _, arm_tail_let: _, arm_block_if_match: _, if_match_branch: _, arm_rest_und: _, tail_call: _, let_und_reachable: _, tail_let_und: v, last_arm_block: _ } => lst_is_not_resolved(v: v)
    LstContextRefused => false
  }
}

test fn a_braced_block_that_is_the_last_match_arm_lowers() -> Bool {
  match lst_outcomes() {
    LstOutcomesDecided { ctl_body_let: _, ctl_arm_expr: _, ctl_arm_block: _, ctl_if_branch: _, ctl_fn_value: _, tail_let: _, tail_let_after_let: _, tail_let_match: _, arm_block_let: _, arm_block_two_let: _, arm_tail_let: _, arm_block_if_match: _, if_match_branch: _, arm_rest_und: _, tail_call: _, let_und_reachable: _, tail_let_und: _, last_arm_block: v } => lst_is_resolved(v: v)
    LstContextRefused => false
  }
}
