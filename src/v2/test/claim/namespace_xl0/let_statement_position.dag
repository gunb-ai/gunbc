// TEMPORARY probe leg C -- DELETE before landing. Leg A (inv 6a5c39ae-91ad-48e6-98c5-34d11c9352db)
// reads 12 of the 14 both-legs-failing fixtures as resolve_refused, and a resolve_refused reading
// does not name its diagnostic. These rows carry the whole reason alphabet the resolve stage and
// the inference stage can emit (37 `resolve_reason_*` plus 50 `infer_reason_*`, taken from the
// symbols in use under src/v2) against ONE fixture, `lst_ctl_body_let`, whose pinned control row
// expects it to come back resolved and whose reading is false at both legs. Exactly one of these
// rows should pass; that names why the accepted-control fixtures never reach Resolved, and it is
// the same question main's sibling module `v2.test.claim.namespace_xl0.let_match_early_return`
// (12 of 18 rows false at b36c11f3fb3b15f3c3c8b88fc8d61975e9607e66) is asking.
fn probe_resolve_reason_of(name: String, unit: Symbol, want: Symbol) -> Bool {
  match probe_verdict_of(name: name, unit: unit) {
    LstRefused { reason: r, at_atom: _ } => r == want
    _ => false
  }
}

