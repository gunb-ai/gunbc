    tail: Cons {
    head: lst_read(source: lst_arm_tail_let_source, id: ^lst_arm_tail_let_artifact, unit: ^lst_arm_tail_let_cu, path: "src/v2/test/fixture/namespace_xl0/lst_arm_tail_let.dag"),
    tail: Cons {
    head: lst_read(source: lst_arm_block_if_match_source, id: ^lst_arm_block_if_match_artifact, unit: ^lst_arm_block_if_match_cu, path: "src/v2/test/fixture/namespace_xl0/lst_arm_block_if_match.dag"),
    tail: Cons {
    head: lst_read(source: lst_if_match_branch_source, id: ^lst_if_match_branch_artifact, unit: ^lst_if_match_branch_cu, path: "src/v2/test/fixture/namespace_xl0/lst_if_match_branch.dag"),
    tail: Cons {
