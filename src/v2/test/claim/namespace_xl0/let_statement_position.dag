// THE SHAPES THAT ARE ILL-FORMED, AND MUST REFUSE WITH THE CAUSE THAT SAYS SO. A statement `let` has no
// body of its own (v2.extdeps.languages.dag dag_grammar_let_expr drops the `in` form), so a block that
// ENDS with one has no value: refusing is right. What was wrong is the reason. At main these fall through
// to body_lower_value_read and report let_body_not_reachable_from_node, which points at a reachability
// question that never arose; the fold now recognises the form and reports
// body_lowering_reason_statement_let_in_tail_position at the door-holder. These four rows are therefore
// RED at main and GREEN at this head, and none of them asks the compiler to accept a body with no value.
test fn a_bare_tail_statement_let_in_a_fn_body_is_claimed_by_an_earlier_normalization_check() -> Bool {
  match lst_outcomes() {
    LstOutcomesDecided { ctl_body_let: _, ctl_arm_expr: _, ctl_arm_block: _, ctl_if_branch: _, ctl_fn_value: _, tail_let: v, tail_let_after_let: _, tail_let_match: _, arm_block_let: _, arm_block_two_let: _, arm_tail_let: _, arm_block_if_match: _, if_match_branch: _, arm_rest_und: _, tail_call: _, let_und_reachable: _, tail_let_und: _, last_arm_block: _ } => lst_refuses_as(v: v, reason: ^normalized_tree_reason_wrapper_retention_not_normalized)
    LstContextRefused => false
  }
}

test fn a_tail_statement_let_after_another_let_refuses_at_the_door_holder() -> Bool {
  match lst_outcomes() {
    LstOutcomesDecided { ctl_body_let: _, ctl_arm_expr: _, ctl_arm_block: _, ctl_if_branch: _, ctl_fn_value: _, tail_let: _, tail_let_after_let: v, tail_let_match: _, arm_block_let: _, arm_block_two_let: _, arm_tail_let: _, arm_block_if_match: _, if_match_branch: _, arm_rest_und: _, tail_call: _, let_und_reachable: _, tail_let_und: _, last_arm_block: _ } => lst_refuses_as(v: v, reason: ^body_lowering_reason_statement_let_in_tail_position)
    LstContextRefused => false
  }
}

