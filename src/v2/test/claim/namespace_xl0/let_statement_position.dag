data lst_tail_let_match_source: String = "module v2.test.fixture.namespace_xl0.lst_tail_let_match\n\ntype LstS = LstA { v: Int } | LstB\n\nfn lst_probe(s: LstS, i: Int) -> Int {\n  let j = i\n  let d = match s {\n    LstA { v: v } => v\n    LstB => j\n  }\n}\n"


data lst_arm_block_let_source: String = "module v2.test.fixture.namespace_xl0.lst_arm_block_let\n\ntype LstS = LstA { v: Int } | LstB\n\nfn lst_uses(x: Int) -> Int { x }\n\nfn lst_probe(s: LstS, i: Int) -> Int { match s {\n  LstA { v: v } => {\n    let r = v\n    lst_uses(x: r)\n  }\n  LstB => i\n} }\n"

data lst_arm_block_two_let_source: String = "module v2.test.fixture.namespace_xl0.lst_arm_block_two_let\n\ntype LstS = LstA { v: Int } | LstB\n\nfn lst_uses(x: Int, y: Int) -> Int { x }\n\nfn lst_probe(s: LstS, i: Int) -> Int { match s {\n  LstA { v: v } => {\n    let r = v\n    let q = i\n    lst_uses(x: r, y: q)\n  }\n  LstB => i\n} }\n"

data lst_arm_tail_let_source: String = "module v2.test.fixture.namespace_xl0.lst_arm_tail_let\n\ntype LstS = LstA { v: Int } | LstB\n\nfn lst_probe(s: LstS, i: Int) -> Int { match s {\n  LstA { v: v } => {\n    let r = v\n  }\n  LstB => i\n} }\n"
data lst_arm_block_if_match_source: String = "module v2.test.fixture.namespace_xl0.lst_arm_block_if_match\n\ntype LstS = LstA { v: Int } | LstB\n\nfn lst_uses(x: Int) -> Int { x }\n\nfn lst_predicate(i: Int) -> Bool { i > 0 }\n\n// The shape dag/gunbc/instruments/fabric_control_plane_live_probe.dag:1053 authored: a braced arm block\n// whose first statement binds an `if` whose branches are matches, and whose last statement reads that\n// binding. Resolving it means the block is read as a statement sequence, not as a head.\nfn lst_probe(s: LstS, i: Int) -> Int { match s {\n  LstA { v: v } => {\n    let chosen = if lst_predicate(i: v) {\n      match s {\n        LstA { v: w } => lst_uses(x: w)\n        LstB => i\n      }\n    } else {\n      match s {\n        LstA { v: w } => lst_uses(x: w)\n        LstB => 0\n      }\n    }\n    let shifted = chosen + 1\n    lst_uses(x: shifted)\n  }\n  LstB => i\n} }\n"
data lst_if_match_branch_source: String = "module v2.test.fixture.namespace_xl0.lst_if_match_branch\n\ntype LstS = LstA { v: Int } | LstB\n\nfn lst_uses(x: Int) -> Int { x }\n\nfn lst_predicate(i: Int) -> Bool { i > 0 }\n\n// The SIBLING leaf of the arm block (DESIGN 6b root generalization): an `if` at term position whose\n// branches are braced statement sequences. One rule reads a braced block in term position, so a braced\n// if-branch must be read the same way as a braced arm body -- or the fix is a per-leaf patch.\nfn lst_probe(s: LstS, i: Int) -> Int { if lst_predicate(i: i) {\n  let left = lst_uses(x: i)\n  let scaled = left * 2\n  lst_uses(x: scaled)\n} else {\n  match s {\n    LstA { v: v } => lst_uses(x: v)\n    LstB => 0\n  }\n} }\n"

data lst_arm_rest_und_source: String = "module v2.test.fixture.namespace_xl0.lst_arm_rest_und\n\ntype LstS = LstA { v: Int } | LstB\n\nfn lst_probe(s: LstS, i: Int) -> Int { match s {\n  LstA { v: v } => {\n    let r = v\n    lst_undeclared_arm_rest\n  }\n  LstB => i\n} }\n"

data lst_tail_call_source: String = "// Materialized fixture for the statement-position claim suite (v2.test.claim.namespace_xl0.let_statement_position).\n// Inline source of this claim's own artifact (the path in lst_ingest is a label, not a repository file). Same braced block and bindings as the parenthesized variant that is NOT pinned here: the tail statement is a plain call. Must lower.\nmodule v2.test.fixture.namespace_xl0.lst_tail_call\n\ntype LstS = LstA { v: Int } | LstB\n\nfn lst_uses(x: Int) -> Int { x }\n\nfn lst_equal(a: Int, b: Int) -> Bool { a == b }\n\nfn lst_probe(s: LstS, i: Int) -> Int { match s {\n  LstA { v: v } => lst_uses(x: v)\n  LstB => {\n    let root = i\n    lst_uses(x: root)\n  }\n} }"
data lst_let_und_reachable_source: String = "// Materialized fixture for the statement-position claim suite (v2.test.claim.namespace_xl0.let_statement_position).\n// Read as a module by the native lane. The body normalizes: the statement `let` is followed by a trailing\n// expression, so it is not a tail let and no wrapper is retained. Its bound value names an atom this module never\n// declares. This is the non-widening control for the fold change: if the binder still hands that atom to the\n// resolver the census must refuse it with resolve_reason_unbound_symbol here, and if the fold were silently\n// dropping the tail the file would lower.\nmodule v2.test.fixture.namespace_xl0.lst_let_und_reachable\n\nfn lst_uses(x: Int) -> Int { x }\n\nfn lst_probe(i: Int) -> Int {\n  let q = lst_undeclared_atom(x: i)\n  lst_uses(x: q)\n}"
data lst_tail_let_und_source: String = "module v2.test.fixture.namespace_xl0.lst_tail_let_und\n\nfn lst_probe(i: Int) -> Int {\n  let x = lst_undeclared_tail_value\n}\n"
data lst_last_arm_block_source: String = "// Materialized fixture for the statement-position claim suite (v2.test.claim.namespace_xl0.let_statement_position).\n// Read as a module by the native lane. Shape of both gap files: the braced block is the LAST arm of the match, preceded by an arm whose body is a plain value. Must lower.\nmodule v2.test.fixture.namespace_xl0.lst_last_arm_block\n\ntype LstS = LstA { v: Int } | LstB\n\nfn lst_uses(x: Int) -> Int { x }\n\nfn lst_equal(a: Int, b: Int) -> Bool { a == b }\n\nfn lst_probe(s: LstS, i: Int) -> Int { match s {\n  LstA { v: v } => v\n  LstB => {\n    let root = i\n    lst_uses(x: root)\n  }\n} }"

fn lst_read(source: String, id: Symbol, unit: Symbol, path: String) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: source, fidelity: Lossless },
    artifact: Artifact { kind: SourceFile, id: id, file_path: path },
    compilation_unit: unit,
    source_root: DagTree
  }
}

