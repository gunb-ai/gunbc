type LstVerdict
  = LstResolved
  | LstRefused { reason: Symbol, at_atom: Optional<Symbol> }
  | LstFileRefused { fatal_reason: Optional<Symbol> }
  | LstAbsent

type LstOutcomes
  = LstContextRefused
  | LstOutcomesDecided {
      ctl_body_let: LstVerdict
      ctl_arm_expr: LstVerdict
      ctl_arm_block: LstVerdict
      ctl_if_branch: LstVerdict
      ctl_fn_value: LstVerdict
      tail_let: LstVerdict
      tail_let_after_let: LstVerdict
      tail_let_match: LstVerdict
      arm_block_let: LstVerdict
      arm_block_two_let: LstVerdict
      arm_tail_let: LstVerdict
      arm_block_if_match: LstVerdict
      if_match_branch: LstVerdict
      arm_rest_und: LstVerdict
      tail_call: LstVerdict
      let_und_reachable: LstVerdict
      tail_let_und: LstVerdict
      last_arm_block: LstVerdict
    }

fn lst_file_refusal_reason(context: NativeTestContext, unit: Symbol) -> Optional<Symbol> {
  fold_list(
    xs: context.file_refusals,
    empty: optional_absent(),
    cons: fn(acc, refusal) {
      if refusal.path == unit { optional_present(value: native_test_file_refusal_fatal_reason(fr: refusal)) } else { acc }
    }
  )
}

fn lst_verdict_of(context: NativeTestContext, unit: Symbol, outcome: NativeCensusModuleOutcome) -> LstVerdict {
  match outcome {
    NativeCensusModuleResolved => LstResolved
    NativeCensusModuleFileRefused =>
      LstFileRefused { fatal_reason: lst_file_refusal_reason(context: context, unit: unit) }
    NativeCensusModuleResolveRefused { first: d, rest: _, observation: _ } =>
      LstRefused {
        reason: d.head.reason,
        at_atom: match d.head.at {
          NodeLocus { anchor: a } => node_atom_identity_optional(node: a.at.node)
          _ => optional_absent()
        }
      }
  }
}

fn lst_verdict_in(context: NativeTestContext, module_name: String, unit: Symbol) -> LstVerdict {
  fold_list(
    xs: native_census_modules(ingest: lst_ingest()),
    empty: LstAbsent,
    cons: fn(acc, entry) {
      if entry.module == module_name {
        lst_verdict_of(
          context: context,
          unit: unit,
          outcome: native_census_module_resolution(
            context: context,
            refusal_index: native_lane_file_refusal_index(refusals: context.file_refusals),
            entry: entry
          ).outcome
        )
      } else {
        acc
      }
    }
  )
}

fn lst_outcomes() -> LstOutcomes {
  match native_test_context_from_ingest(ingest: lst_ingest()) {
    Rejected { diagnostics: _ } => LstContextRefused
    Accepted { value: context, diagnostics: _ } =>
      LstOutcomesDecided {
        ctl_body_let: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_ctl_body_let", unit: ^lst_ctl_body_let_cu),
        ctl_arm_expr: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_ctl_arm_expr", unit: ^lst_ctl_arm_expr_cu),
        ctl_arm_block: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_ctl_arm_block", unit: ^lst_ctl_arm_block_cu),
        ctl_if_branch: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_ctl_if_branch", unit: ^lst_ctl_if_branch_cu),
        ctl_fn_value: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_ctl_fn_value", unit: ^lst_ctl_fn_value_cu),
        tail_let: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_tail_let", unit: ^lst_tail_let_cu),
        tail_let_after_let: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_tail_let_after_let", unit: ^lst_tail_let_after_let_cu),
        tail_let_match: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_tail_let_match", unit: ^lst_tail_let_match_cu),
        arm_block_let: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_arm_block_let", unit: ^lst_arm_block_let_cu),
        arm_block_two_let: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_arm_block_two_let", unit: ^lst_arm_block_two_let_cu),
        arm_tail_let: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_arm_tail_let", unit: ^lst_arm_tail_let_cu),
        arm_block_if_match: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_arm_block_if_match", unit: ^lst_arm_block_if_match_cu),
        if_match_branch: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_if_match_branch", unit: ^lst_if_match_branch_cu),
        arm_rest_und: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_arm_rest_und", unit: ^lst_arm_rest_und_cu),
        tail_call: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_tail_call", unit: ^lst_tail_call_cu),
        let_und_reachable: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_let_und_reachable", unit: ^lst_let_und_reachable_cu),
        tail_let_und: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_tail_let_und", unit: ^lst_tail_let_und_cu),
        last_arm_block: lst_verdict_in(context: context, module_name: "v2.test.fixture.namespace_xl0.lst_last_arm_block", unit: ^lst_last_arm_block_cu)
      }
  }
}

fn lst_is_resolved(v: LstVerdict) -> Bool {
  match v {
    LstResolved => true
    _ => false
  }
}

// The resolve-stage reading, named: the inline ingest root carries ONLY the fixture modules, so a
// fixture that imports any vocabulary is refused here, before the door is reached, with
// `resolve_module_not_found` and no located atom. Measured, not inferred: value read at
// f850b7abcdef72ca8ba7cd84b3b63c8fcd99b4ec (BuildBuddy invocation
// c07a2e0a-6277-4727-ad62-7faf05e3f81d) for `lst_ctl_body_let`, and
// ea744ba0-3e3a-4d1e-8a6d-8b8db84f9da5 for `lst_ctl_arm_block`.
fn lst_resolve_refused_as(v: LstVerdict, reason: Symbol) -> Bool {
  match v {
    LstRefused { reason: r, at_atom: _ } => r == reason
    _ => false
  }
}

fn lst_refuses_as(v: LstVerdict, reason: Symbol) -> Bool {
  match v {
    LstFileRefused { fatal_reason: Present { value: r } } => r == reason
    _ => false
  }
}

fn lst_unbound_at(v: LstVerdict, atom: Symbol) -> Bool {
  match v {
    LstRefused { reason: r, at_atom: Present { value: id } } => (r == ^resolve_reason_unbound_symbol) && (id == atom)
    _ => false
  }
}

fn lst_is_not_resolved(v: LstVerdict) -> Bool {
  match v {
    LstResolved => false
    _ => true
  }
}

// THE ROWS, AND WHAT EACH ONE IS.
//
// THREE DISCRIMINATORS. A statement `let` in a TAIL position refuses at the door holder with
// `body_lowering_reason_statement_let_in_tail_position`. Three rows pin that reading -- a tail let
// after another let, a tail let bound to a match, and a tail let in a braced match-arm block. Each
// PASSes at this head and FAILs at the merge base; that pair is the claim this PR makes, and nothing
// else in this file is offered as evidence for it.
//
// ELEVEN TRIPWIRES OVER THIS SUITE'S OWN HARNESS DEFECT -- NOT EVIDENCE FOR THIS CHANGE. The inline
// ingest root carries only the fixture modules, so a fixture that imports vocabulary
// (`import v2.std.integer { Int }`) is refused at RESOLVE with `resolve_module_not_found` and no
// located atom, at BOTH legs, before body lowering is reached: the archived branch's `is_accepted`
// expectations for those shapes were never observable. Those rows are pinned to the named reading and
// named for it, and each goes RED when the ingest starts carrying vocabulary -- which is when the
// accepted controls this change was written with can be written at all. The same defect makes main's
// `v2.test.claim.namespace_xl0.let_match_early_return` (12 of 18 rows false) and
// `return_tail_position` (14 of 17 false) unreadable; repairing the shared fixture pattern is its own
// change (work item adhoc-d6e47a99-2e0), not part of this one.
//
// ONE SHAPE THAT IS NOT THIS DOOR'S TO CLAIM. A `let` that is the whole body of a function is refused
// at file level by `normalized_tree_reason_wrapper_retention_not_normalized` -- a normalization check
// that runs first -- which is why the bare shape cannot be the discriminator, and why the refusals
// this change observes are the ones where the block has a preceding statement.
//
// TWO ROWS AND THEIR FIXTURES WERE REMOVED, NOT LEFT UNEXECUTED: the pair over `lst_tail_let_und` (a
// refused tail let is never resolved while an arm block's rest is) and `lst_last_arm_block` (a braced
// block that is the last match arm lowers). No row ever read either fixture, so the fixtures and their
// `LstOutcomesDecided` fields are gone as well: a fixture no row reads is dangling. Both intents
// return with the ingest change above.
//
// Every row here states what the route reports, not what it should report: the suite was executed
// (granted executor; the paired HEAD/BASE per-row receipts are in the PR description). The archived
// branch's 17 rows were never executed -- three held, thirteen did not.

test fn a_body_top_level_let_is_an_accepted_control() -> Bool {
  match lst_outcomes() {
    LstOutcomesDecided { ctl_body_let: v, ctl_arm_expr: _, ctl_arm_block: _, ctl_if_branch: _, ctl_fn_value: _, tail_let: _, tail_let_after_let: _, tail_let_match: _, arm_block_let: _, arm_block_two_let: _, arm_tail_let: _, arm_block_if_match: _, if_match_branch: _, arm_rest_und: _, tail_call: _, let_und_reachable: _, tail_let_und: _, last_arm_block: _ } => lst_is_resolved(v: v)
    LstContextRefused => false
  }
}

