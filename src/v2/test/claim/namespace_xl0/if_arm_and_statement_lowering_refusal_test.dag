test fn a_let_followed_by_its_body_resolves() -> Bool {
  match iasl_outcomes() {
    IaslOutcomesDecided { ifarm_und: _, ifarm_else_und: _, ifarm_nested_und: _, block_und: _, ifarm_block_und: _, let_then_bare_und: _, block_ctl: _, ifarm_ctl: _, ifarm_nested_ctl: _, ifarm_letblock_ctl: _, let_block_ctl: v, ifarm_bare_und: _, ifarm_match_ctl: _ } =>
      iasl_is_resolved(v: v)
    IaslContextRefused => false
  }
}

test fn a_match_in_an_if_arm_resolves() -> Bool {
  match iasl_outcomes() {
    IaslOutcomesDecided { ifarm_und: _, ifarm_else_und: _, ifarm_nested_und: _, block_und: _, ifarm_block_und: _, let_then_bare_und: _, block_ctl: _, ifarm_ctl: _, ifarm_nested_ctl: _, ifarm_letblock_ctl: _, let_block_ctl: _, ifarm_bare_und: _, ifarm_match_ctl: v } =>
      iasl_is_resolved(v: v)
    IaslContextRefused => false
  }
}
