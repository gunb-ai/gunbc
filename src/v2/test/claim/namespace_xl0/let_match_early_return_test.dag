// (a) THE ARM'S BINDERS END BEFORE THE REST: the rest names `lme_arm_binder`, bound only by the
// binding arm's pattern, and refuses unbound at it -- under the arm it would have silently bound the
// arm's binder. (The name is unique to this fixture so the refusal is the plain unbound one, not
// resolve's declared-in-another-module variant.)
test fn the_rest_does_not_see_the_binding_arms_binders() -> Bool {
  match lme_outcomes() {
    LmeOutcomesDecided { ctl: _, rest_und: _, exit_und: _, bind_und: _, nested_ctl: _, multi: _, nontail: _, bind_return: _, lambda_ctl: _, uri: _, reach: _, leak: v, ctor_arm: _, hides: _, some_none: _, literal: _ } => lme_unbound_at(v: v, atom: ^lme_arm_binder)
    LmeContextRefused => false
  }
}

// (b) `LmeB => LmeB` beside returning arms: LmeB is a nullary constructor, judged by resolve on the
// authored pattern; read as a binder it would hide the visible constructor and refuse.
test fn a_bare_constructor_binding_arm_stays_a_constructor_pattern() -> Bool {
  match lme_outcomes() {
    LmeOutcomesDecided { ctl: _, rest_und: _, exit_und: _, bind_und: _, nested_ctl: _, multi: _, nontail: _, bind_return: _, lambda_ctl: _, uri: _, reach: _, leak: _, ctor_arm: v, hides: _, some_none: _, literal: _ } => lme_is_resolved(v: v)
    LmeContextRefused => false
  }
}

// (c) The arm binder `v` hides the parameter `v`: refused, judged against the authored arm scope.
test fn an_arm_binder_hiding_an_outer_parameter_still_refuses() -> Bool {
  match lme_outcomes() {
    LmeOutcomesDecided { ctl: _, rest_und: _, exit_und: _, bind_und: _, nested_ctl: _, multi: _, nontail: _, bind_return: _, lambda_ctl: _, uri: _, reach: _, leak: _, ctor_arm: _, hides: v, some_none: _, literal: _ } => match v { LmeRefused { reason: r, at_atom: _ } => r == ^resolve_reason_binder_hides_visible_value
 _ => false }
    LmeContextRefused => false
  }
}

// (d) `LmeSome { value: LmeB }`: the field sub-pattern names a constructor, not a binder.
test fn a_nested_constructor_in_a_field_pattern_is_classified_by_resolve() -> Bool {
  match lme_outcomes() {
    LmeOutcomesDecided { ctl: _, rest_und: _, exit_und: _, bind_und: _, nested_ctl: _, multi: _, nontail: _, bind_return: _, lambda_ctl: _, uri: _, reach: _, leak: _, ctor_arm: _, hides: _, some_none: v, literal: _ } => lme_is_resolved(v: v)
    LmeContextRefused => false
  }
}

// (e) A literal pattern binds nothing: `0 => 1` beside a returning wildcard arm.
test fn a_literal_binding_arm_is_accepted() -> Bool {
  match lme_outcomes() {
    LmeOutcomesDecided { ctl: _, rest_und: _, exit_und: _, bind_und: _, nested_ctl: _, multi: _, nontail: _, bind_return: _, lambda_ctl: _, uri: _, reach: _, leak: _, ctor_arm: _, hides: _, some_none: _, literal: v } => lme_is_resolved(v: v)
    LmeContextRefused => false
  }
}

fn lme_body_lowering_admitted(v: LmeVerdict) -> Bool {
  match v {
    LmeResolved => true
    LmeRefused { reason: _, at_atom: _ } => true
    LmeFileRefused { fatal_reason: _ } => false
    LmeAbsent => false
  }
}

test fn the_uri_path_segment_parser_is_admitted_by_body_lowering() -> Bool {
  match lme_outcomes() {
    LmeOutcomesDecided { ctl: _, rest_und: _, exit_und: _, bind_und: _, nested_ctl: _, multi: _, nontail: _, bind_return: _, lambda_ctl: _, uri: v, reach: _, leak: _, ctor_arm: _, hides: _, some_none: _, literal: _ } => lme_body_lowering_admitted(v: v)
    LmeContextRefused => false
  }
}

// A binding arm's value may use its own binders (`LmeA { v: v } => v + 1`): they are in scope for the
// value, which resolves in the arm's scope (v2.std.node MatchArmScopeExitEdge).
test fn a_binding_arm_value_may_use_its_binders_and_is_accepted() -> Bool {
  match lme_outcomes() {
    LmeOutcomesDecided { ctl: _, rest_und: _, exit_und: _, bind_und: _, nested_ctl: _, multi: _, nontail: _, bind_return: _, lambda_ctl: _, uri: _, reach: v, leak: _, ctor_arm: _, hides: _, some_none: _, literal: _ } => lme_is_resolved(v: v)
    LmeContextRefused => false
  }
}

// THE REST APPEARS ONCE. `lme_shape_source` has one binding arm and three returning arms, and the
// rest of the spine is a call to `lme_rest_marker`; normalize (tokenize -> parse -> normalize, the
// producers called directly) must ACCEPT it with the marker atom EXACTLY ONCE in the lowered tree --
// a lowering that copied the rest into each arm would count four -- and with every returning arm's
// operand kept (lme_exit_marker three times). On main it refuses as return_not_in_tail_position.
data lme_shape_source: String = "module v2.test.lme_shape\n\nimport v2.std.integer { Int }\n\ntype LmeS = LmeA { v: Int } | LmeB | LmeC { w: Int } | LmeD\n\nfn lme_probe(s: LmeS, k: Int) -> Int {\n  let x = match s {\n    LmeA { v: v } => v\n    LmeB => return lme_exit_marker\n    LmeC { w: w } => return lme_exit_marker\n    LmeD => return lme_exit_marker\n  }\n  lme_rest_marker(x: x)\n}\n"

type LmeShape {
  outcome: Symbol
  rest: Int
  exits: Int
}

fn lme_atom_count(nodes: List<Node>, atom: Symbol) -> Int {
  match nodes {
    Empty => 0
    Cons { head: n, tail: rest } =>
      match node_atom_identity_optional(node: n) {
        Present { value: id } =>
          if id == atom { 1 + lme_atom_count(nodes: rest, atom: atom) } else { lme_atom_count(nodes: rest, atom: atom) }
        Absent => lme_atom_count(nodes: rest, atom: atom)
      }
  }
}

fn lme_shape_marker(marker: Symbol) -> LmeShape {
  LmeShape { outcome: marker, rest: 0, exits: 0 }
}

// ONE PRODUCER for the shape claims, enrolled warm in v2.workflow.floor_pure_producer_share; the
// stored value is four scalars.
fn lme_shape() -> LmeShape {
  let lm = dag_language_model()
  match tokenize(text: lme_shape_source, file: ^let_match_early_return_file, rules: lm.lex) {
    Rejected { diagnostics: _ } => lme_shape_marker(marker: ^lme_tokenize_refused)
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: _ } => lme_shape_marker(marker: ^lme_parse_refused)
        Accepted { value: artifact, diagnostics: _ } =>
          match normalize(parse_tree: artifact.tree) {
            Rejected { diagnostics: _ } => lme_shape_marker(marker: ^lme_normalize_refused)
            Accepted { value: normalized, diagnostics: _ } =>
              let nodes = node_subtree_nodes(root: normalized.root)
              LmeShape {
                outcome: ^lme_accepted,
                rest: lme_atom_count(nodes: nodes, atom: ^lme_rest_marker),
                exits: lme_atom_count(nodes: nodes, atom: ^lme_exit_marker)
              }
          }
      }
  }
}

test fn the_rest_after_a_let_match_appears_exactly_once_in_the_lowered_tree() -> Bool {
  let shape = lme_shape()
  (shape.outcome == ^lme_accepted) && (shape.rest == 1)
}

test fn every_returning_arm_of_a_let_match_keeps_its_operand_in_the_lowered_tree() -> Bool {
  let shape = lme_shape()
  (shape.outcome == ^lme_accepted) && (shape.exits == 3)
}
