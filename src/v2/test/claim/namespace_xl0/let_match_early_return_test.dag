data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// A LET WHOSE VALUE IS A MATCH WITH RETURNING ARMS, HEADING A TAIL SPINE, LOWERS TO THAT MATCH WITH
// THE REST OF THE SPINE UNDER ITS ONE BINDING ARM (v2.compiler.body_lowering_fold
// body_lower_let_match_exit_join, admitted by body_lower_exit_walk_let_match).
//
// THE SUBJECT is the native route (native_test_context_from_ingest, then
// native_census_module_resolution), as v2.test.claim.namespace_xl0.return_tail_position drives it.
// THE RED ON MAIN is `ctl`, `nested_ctl` and `lambda_ctl`: each refused
// return_not_in_tail_position, the form extdeps.uri_path parse_segment_tokens uses. The `_und`
// discriminators prove the rest, the exiting arm and the binding arm are each READ (an undeclared
// atom there refuses unbound at it, so none is dropped). `multi` (two binding arms) refuses
// multi_binding_arm_early_return_needs_join_point rather than copying the rest per arm; `nontail`
// (the let-match inside a let-bound if) and `bind_return` (a return inside the binding arm's value)
// keep refusing return_not_in_tail_position. `lambda_ctl` is the lambda boundary: a fn value owns its
// own exits, so its let-match lowers inside it and exits only it.
data lme_ctl_source: String = "module v2.test.lme_ctl\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LmeS = LmeA { v: Int } | LmeB | LmeC { w: Int } | LmeD\n\nfn lme_probe(s: LmeS, k: Int) -> Int {\n  let x = match s {\n    LmeA { v: v } => v\n    LmeB => return k\n    LmeC { w: w } => return w\n    LmeD => return k\n  }\n  x\n}\n"
data lme_rest_und_source: String = "module v2.test.lme_rest_und\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LmeS = LmeA { v: Int } | LmeB | LmeC { w: Int } | LmeD\n\nfn lme_probe(s: LmeS, k: Int) -> Int {\n  let x = match s {\n    LmeA { v: v } => v\n    LmeB => return k\n    LmeC { w: w } => return w\n    LmeD => return k\n  }\n  lme_undeclared_rest\n}\n"
data lme_exit_und_source: String = "module v2.test.lme_exit_und\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LmeS = LmeA { v: Int } | LmeB | LmeC { w: Int } | LmeD\n\nfn lme_probe(s: LmeS, k: Int) -> Int {\n  let x = match s {\n    LmeA { v: v } => v\n    LmeB => return lme_undeclared_exit\n    LmeC { w: w } => return w\n    LmeD => return k\n  }\n  x\n}\n"
data lme_bind_und_source: String = "module v2.test.lme_bind_und\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LmeS = LmeA { v: Int } | LmeB | LmeC { w: Int } | LmeD\n\nfn lme_probe(s: LmeS, k: Int) -> Int {\n  let x = match s {\n    LmeA { v: v } => return v\n    LmeB => return k\n    LmeC { w: _ } => lme_undeclared_bind\n    LmeD => return k\n  }\n  x\n}\n"
data lme_nested_ctl_source: String = "module v2.test.lme_nested_ctl\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LmeS = LmeA { v: Int } | LmeB | LmeC { w: Int } | LmeD\n\nfn lme_probe(s: LmeS, t: LmeS, k: Int) -> Int {\n  let x = match s {\n    LmeA { v: v } => v\n    LmeB => return k\n    LmeC { w: w } => return w\n    LmeD => return k\n  }\n  let y = match t {\n    LmeA { v: v } => v\n    LmeB => return x\n    LmeC { w: w } => return w\n    LmeD => return k\n  }\n  y\n}\n"
data lme_multi_source: String = "module v2.test.lme_multi\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LmeS = LmeA { v: Int } | LmeB | LmeC { w: Int } | LmeD\n\nfn lme_probe(s: LmeS, k: Int) -> Int {\n  let x = match s {\n    LmeA { v: v } => v\n    LmeB => return k\n    LmeC { w: w } => w\n    LmeD => return k\n  }\n  x\n}\n"
data lme_nontail_source: String = "module v2.test.lme_nontail\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LmeS = LmeA { v: Int } | LmeB | LmeC { w: Int } | LmeD\n\nfn lme_probe(c: Bool, s: LmeS, k: Int) -> Int {\n  let y = if c {\n    let x = match s {\n      LmeA { v: v } => v\n      LmeB => return k\n      LmeC { w: w } => return w\n      LmeD => return k\n    }\n    x\n  } else { k }\n  y\n}\n"
data lme_bind_return_source: String = "module v2.test.lme_bind_return\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LmeS = LmeA { v: Int } | LmeB | LmeC { w: Int } | LmeD\n\nfn lme_probe(c: Bool, s: LmeS, k: Int) -> Int {\n  let x = match s {\n    LmeA { v: v } => if c { return k } else { v }\n    LmeB => return k\n    LmeC { w: w } => return w\n    LmeD => return k\n  }\n  x\n}\n"
data lme_lambda_ctl_source: String = "module v2.test.lme_lambda_ctl\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LmeS = LmeA { v: Int } | LmeB | LmeC { w: Int } | LmeD\n\nfn lme_probe(s: LmeS, k: Int) -> Int {\n  let g = fn(t) {\n    let x = match t {\n      LmeA { v: v } => v\n      LmeB => return k\n      LmeC { w: w } => return w\n      LmeD => return k\n    }\n    x\n  }\n  k\n}\n"

data lme_reach_source: String = "module v2.test.lme_reach\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LmeS = LmeA { v: Int } | LmeB | LmeC { w: Int } | LmeD\n\nfn lme_probe(s: LmeS, k: Int) -> Int {\n  let x = match s {\n    LmeA { v: v } => v + 1\n    LmeB => return k\n    LmeC { w: w } => return w\n    LmeD => return k\n  }\n  x\n}\n"

data lme_leak_source: String = "module v2.test.lme_leak\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LmeS = LmeA { v: Int } | LmeB | LmeC { w: Int } | LmeD\n\nfn lme_probe(s: LmeS, k: Int) -> Int {\n  let x = match s {\n    LmeA { v: lme_arm_binder } => lme_arm_binder\n    LmeB => return k\n    LmeC { w: w } => return w\n    LmeD => return k\n  }\n  lme_arm_binder\n}\n"

data lme_ctor_arm_source: String = "module v2.test.lme_ctor_arm\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LmeS = LmeA { v: Int } | LmeB | LmeC { w: Int } | LmeD\n\nfn lme_probe(s: LmeS) -> LmeS {\n  let x = match s {\n    LmeB => LmeB\n    LmeA { v: _ } => return s\n    LmeC { w: _ } => return s\n    LmeD => return s\n  }\n  x\n}\n"

data lme_hides_source: String = "module v2.test.lme_hides\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LmeS = LmeA { v: Int } | LmeB | LmeC { w: Int } | LmeD\n\nfn lme_probe(s: LmeS, v: Int) -> Int {\n  let x = match s {\n    LmeA { v: v } => v\n    LmeB => return v\n    LmeC { w: w } => return w\n    LmeD => return v\n  }\n  x\n}\n"

data lme_some_none_source: String = "module v2.test.lme_some_none\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LmeS = LmeA { v: Int } | LmeB | LmeC { w: Int } | LmeD\n\ntype LmeO = LmeSome { value: LmeS } | LmeNone\n\nfn lme_probe(o: LmeO) -> Int {\n  let x = match o {\n    LmeSome { value: LmeB } => 1\n    LmeSome { value: _ } => return 2\n    LmeNone => return 3\n  }\n  x\n}\n"

data lme_literal_source: String = "module v2.test.lme_literal\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LmeS = LmeA { v: Int } | LmeB | LmeC { w: Int } | LmeD\n\nfn lme_probe(n: Int) -> Int {\n  let x = match n {\n    0 => 1\n    _ => return n\n  }\n  x\n}\n"

// THE N7 SPECIMEN: extdeps.uri_path parse_segment_tokens and its result types, verbatim -- two
// guards and four let-matches with returning arms. This ingest carries no v2.std, so the module
// refuses at RESOLVE (first at the unbound `List` of its result type, measured); the claim is that
// BODY LOWERING admits it -- not a file refusal -- which on main it was not
// (return_not_in_tail_position). The full extdeps.uri_path is the N7 lane's own measurement.
data lme_uri_source: String = "module v2.test.lme_uri\n\nimport v2.std.text { String }\nimport v2.std.collection { List }\n\ntype UrlPathToken\n  = LiteralToken { text: String }\n  | ParamToken   { name: String }\n\ntype PathSegmentTokensResult\n  = ParsedSegmentTokens { tokens: List<UrlPathToken> }\n  | MalformedPathSegment { segment: String, reason: String }\n\ntype PathTemplateParseResult\n  = ParsedPathTemplate { template: PathTemplate }\n  | MalformedPathTemplate { raw: String, segment: String, reason: String }\n\nfn parse_segment_tokens(seg: String) -> PathSegmentTokensResult {\n  if !(seg |> contains(\"{\")) {\n    if seg |> contains(\"}\") {\n      MalformedPathSegment { segment: seg, reason: \"stray closing brace\" }\n    } else {\n      ParsedSegmentTokens { tokens: [LiteralToken { text: seg }] }\n    }\n  } else {\n    let before_and_rest = seg |> split(delimiter: \"{\")\n    if count(before_and_rest) != 2 {\n      return MalformedPathSegment { segment: seg, reason: \"multiple opening braces in one segment\" }\n    }\n\n    let prefix = match before_and_rest |> first {\n      Present { value: p } => p\n      Absent => return MalformedPathSegment { segment: seg, reason: \"internal: missing prefix after opening-brace split\" }\n    }\n    let after_open = match before_and_rest |> skip(1) |> first {\n      Present { value: r } => r\n      Absent => return MalformedPathSegment { segment: seg, reason: \"internal: missing tail after opening-brace split\" }\n    }\n    let name_and_suffix = after_open |> split(delimiter: \"}\")\n    if prefix |> contains(\"}\") || count(name_and_suffix) != 2 {\n      return MalformedPathSegment { segment: seg, reason: \"missing closing brace or extra closing brace\" }\n    }\n    let param_name = match name_and_suffix |> first {\n      Present { value: p } => p\n      Absent => return MalformedPathSegment { segment: seg, reason: \"internal: missing parameter name after closing-brace split\" }\n    }\n    let suffix = match name_and_suffix |> skip(1) |> first {\n      Present { value: s } => s\n      Absent => return MalformedPathSegment { segment: seg, reason: \"internal: missing suffix after closing-brace split\" }\n    }\n    let prefix_tokens = if prefix != \"\" {\n      [LiteralToken { text: prefix }]\n    } else { [] }\n    let param_tokens = if param_name != \"\" {\n      [ParamToken { name: param_name }]\n    } else { [] }\n    let suffix_tokens = if suffix != \"\" {\n      [LiteralToken { text: suffix }]\n    } else { [] }\n    if param_name == \"\" || suffix |> contains(\"{\") || suffix |> contains(\"}\") {\n      MalformedPathSegment { segment: seg, reason: \"invalid parameter segment structure\" }\n    } else {\n      ParsedSegmentTokens { tokens: concat(prefix_tokens, param_tokens, suffix_tokens) }\n    }\n  }\n}\n"

fn lme_read(source: String, id: Symbol, unit: Symbol, path: String) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: source, fidelity: Lossless },
    artifact: Artifact { kind: SourceFile, id: id, file_path: path },
    compilation_unit: unit,
    source_root: DagTree
  }
}
data lme_ingest: SourceRootIngest = Cons {
    head: lme_read(source: lme_literal_source, id: ^lme_literal_artifact, unit: ^lme_literal_cu, path: "src/v2/test/fixture/namespace_xl0/lme_literal.dag"),
    tail: Cons {
    head: lme_read(source: lme_some_none_source, id: ^lme_some_none_artifact, unit: ^lme_some_none_cu, path: "src/v2/test/fixture/namespace_xl0/lme_some_none.dag"),
    tail: Cons {
    head: lme_read(source: lme_hides_source, id: ^lme_hides_artifact, unit: ^lme_hides_cu, path: "src/v2/test/fixture/namespace_xl0/lme_hides.dag"),
    tail: Cons {
    head: lme_read(source: lme_ctor_arm_source, id: ^lme_ctor_arm_artifact, unit: ^lme_ctor_arm_cu, path: "src/v2/test/fixture/namespace_xl0/lme_ctor_arm.dag"),
    tail: Cons {
    head: lme_read(source: lme_leak_source, id: ^lme_leak_artifact, unit: ^lme_leak_cu, path: "src/v2/test/fixture/namespace_xl0/lme_leak.dag"),
    tail: Cons {
    head: lme_read(source: lme_reach_source, id: ^lme_reach_artifact, unit: ^lme_reach_cu, path: "src/v2/test/fixture/namespace_xl0/lme_reach.dag"),
    tail: Cons {
    head: lme_read(source: lme_uri_source, id: ^lme_uri_artifact, unit: ^lme_uri_cu, path: "src/v2/test/fixture/namespace_xl0/lme_uri.dag"),
    tail: Cons {
    head: lme_read(source: lme_ctl_source, id: ^lme_ctl_artifact, unit: ^lme_ctl_cu, path: "src/v2/test/fixture/namespace_xl0/lme_ctl.dag"),
    tail: Cons {
    head: lme_read(source: lme_rest_und_source, id: ^lme_rest_und_artifact, unit: ^lme_rest_und_cu, path: "src/v2/test/fixture/namespace_xl0/lme_rest_und.dag"),
    tail: Cons {
    head: lme_read(source: lme_exit_und_source, id: ^lme_exit_und_artifact, unit: ^lme_exit_und_cu, path: "src/v2/test/fixture/namespace_xl0/lme_exit_und.dag"),
    tail: Cons {
    head: lme_read(source: lme_bind_und_source, id: ^lme_bind_und_artifact, unit: ^lme_bind_und_cu, path: "src/v2/test/fixture/namespace_xl0/lme_bind_und.dag"),
    tail: Cons {
    head: lme_read(source: lme_nested_ctl_source, id: ^lme_nested_ctl_artifact, unit: ^lme_nested_ctl_cu, path: "src/v2/test/fixture/namespace_xl0/lme_nested_ctl.dag"),
    tail: Cons {
    head: lme_read(source: lme_multi_source, id: ^lme_multi_artifact, unit: ^lme_multi_cu, path: "src/v2/test/fixture/namespace_xl0/lme_multi.dag"),
    tail: Cons {
    head: lme_read(source: lme_nontail_source, id: ^lme_nontail_artifact, unit: ^lme_nontail_cu, path: "src/v2/test/fixture/namespace_xl0/lme_nontail.dag"),
    tail: Cons {
    head: lme_read(source: lme_bind_return_source, id: ^lme_bind_return_artifact, unit: ^lme_bind_return_cu, path: "src/v2/test/fixture/namespace_xl0/lme_bind_return.dag"),
    tail: Cons {
    head: lme_read(source: lme_lambda_ctl_source, id: ^lme_lambda_ctl_artifact, unit: ^lme_lambda_ctl_cu, path: "src/v2/test/fixture/namespace_xl0/lme_lambda_ctl.dag"),
    tail: Empty } } } } } } } } } } } } } } } }

// ONE FRONT END FOR EVERY CLAIM: a verdict per module, with no resolution context or Node in it.
type LmeVerdict
  = LmeResolved
  | LmeRefused { reason: Symbol, at_atom: Optional<Symbol> }
  | LmeFileRefused { fatal_reason: Optional<Symbol> }
  | LmeAbsent

type LmeOutcomes
  = LmeContextRefused
  | LmeOutcomesDecided {
      ctl: LmeVerdict
      rest_und: LmeVerdict
      exit_und: LmeVerdict
      bind_und: LmeVerdict
      nested_ctl: LmeVerdict
      multi: LmeVerdict
      nontail: LmeVerdict
      bind_return: LmeVerdict
      lambda_ctl: LmeVerdict
      uri: LmeVerdict
      reach: LmeVerdict
      literal: LmeVerdict
      some_none: LmeVerdict
      hides: LmeVerdict
      ctor_arm: LmeVerdict
      leak: LmeVerdict
    }

fn lme_file_refusal_reason(context: NativeTestContext, unit: Symbol) -> Optional<Symbol> {
  fold_list(
    xs: context.file_refusals,
    empty: optional_absent(),
    cons: fn(acc, refusal) {
      if refusal.path == unit { optional_present(value: refusal.fatal_reason) } else { acc }
    }
  )
}

fn lme_verdict_of(context: NativeTestContext, unit: Symbol, outcome: NativeCensusModuleOutcome) -> LmeVerdict {
  match outcome {
    NativeCensusModuleResolved => LmeResolved
    NativeCensusModuleFileRefused =>
      LmeFileRefused { fatal_reason: lme_file_refusal_reason(context: context, unit: unit) }
    NativeCensusModuleResolveRefused { first: d, rest: _, observation: _ } =>
      LmeRefused {
        reason: d.head.reason,
        at_atom: match d.head.at {
          NodeLocus { anchor: a } => node_atom_identity_optional(node: a.at)
          _ => optional_absent()
        }
      }
  }
}

fn lme_verdict_in(context: NativeTestContext, module_name: String, unit: Symbol) -> LmeVerdict {
  fold_list(
    xs: native_census_modules(ingest: lme_ingest),
    empty: LmeAbsent,
    cons: fn(acc, entry) {
      if entry.module == module_name {
        lme_verdict_of(
          context: context,
          unit: unit,
          outcome: native_census_module_resolution(
            context: context,
            refusal_index: native_lane_file_refusal_index(refusals: context.file_refusals),
            entry: entry
          ).outcome
        )
      } else {
        acc
      }
    }
  )
}

fn lme_outcomes() -> LmeOutcomes {
  match native_test_context_from_ingest(ingest: lme_ingest) {
    Rejected { diagnostics: _ } => LmeContextRefused
    Accepted { value: context, diagnostics: _ } =>
      LmeOutcomesDecided {
        ctl: lme_verdict_in(context: context, module_name: "v2.test.lme_ctl", unit: ^lme_ctl_cu),
        rest_und: lme_verdict_in(context: context, module_name: "v2.test.lme_rest_und", unit: ^lme_rest_und_cu),
        exit_und: lme_verdict_in(context: context, module_name: "v2.test.lme_exit_und", unit: ^lme_exit_und_cu),
        bind_und: lme_verdict_in(context: context, module_name: "v2.test.lme_bind_und", unit: ^lme_bind_und_cu),
        nested_ctl: lme_verdict_in(context: context, module_name: "v2.test.lme_nested_ctl", unit: ^lme_nested_ctl_cu),
        multi: lme_verdict_in(context: context, module_name: "v2.test.lme_multi", unit: ^lme_multi_cu),
        nontail: lme_verdict_in(context: context, module_name: "v2.test.lme_nontail", unit: ^lme_nontail_cu),
        bind_return: lme_verdict_in(context: context, module_name: "v2.test.lme_bind_return", unit: ^lme_bind_return_cu),
        lambda_ctl: lme_verdict_in(context: context, module_name: "v2.test.lme_lambda_ctl", unit: ^lme_lambda_ctl_cu),
        uri: lme_verdict_in(context: context, module_name: "v2.test.lme_uri", unit: ^lme_uri_cu),
        reach: lme_verdict_in(context: context, module_name: "v2.test.lme_reach", unit: ^lme_reach_cu),
        leak: lme_verdict_in(context: context, module_name: "v2.test.lme_leak", unit: ^lme_leak_cu),
        ctor_arm: lme_verdict_in(context: context, module_name: "v2.test.lme_ctor_arm", unit: ^lme_ctor_arm_cu),
        hides: lme_verdict_in(context: context, module_name: "v2.test.lme_hides", unit: ^lme_hides_cu),
        some_none: lme_verdict_in(context: context, module_name: "v2.test.lme_some_none", unit: ^lme_some_none_cu),
        literal: lme_verdict_in(context: context, module_name: "v2.test.lme_literal", unit: ^lme_literal_cu)
      }
  }
}

fn lme_is_resolved(v: LmeVerdict) -> Bool {
  match v {
    LmeResolved => true
    _ => false
  }
}

fn lme_refuses_as(v: LmeVerdict, reason: Symbol) -> Bool {
  match v {
    LmeFileRefused { fatal_reason: Present { value: r } } => r == reason
    _ => false
  }
}

fn lme_unbound_at(v: LmeVerdict, atom: Symbol) -> Bool {
  match v {
    LmeRefused { reason: r, at_atom: Present { value: id } } => (r == ^resolve_reason_unbound_symbol) && (id == atom)
    _ => false
  }
}

test fn a_let_match_with_one_binding_arm_and_returning_arms_is_accepted() -> Bool {
  match lme_outcomes() {
    LmeOutcomesDecided { ctl: v, rest_und: _, exit_und: _, bind_und: _, nested_ctl: _, multi: _, nontail: _, bind_return: _, lambda_ctl: _, uri: _, reach: _, leak: _, ctor_arm: _, hides: _, some_none: _, literal: _ } => lme_is_resolved(v: v)
    LmeContextRefused => false
  }
}

test fn the_rest_after_a_let_match_is_read_and_refuses_unbound_at_its_atom() -> Bool {
  match lme_outcomes() {
    LmeOutcomesDecided { ctl: _, rest_und: v, exit_und: _, bind_und: _, nested_ctl: _, multi: _, nontail: _, bind_return: _, lambda_ctl: _, uri: _, reach: _, leak: _, ctor_arm: _, hides: _, some_none: _, literal: _ } => lme_unbound_at(v: v, atom: ^lme_undeclared_rest)
    LmeContextRefused => false
  }
}

test fn a_returning_arm_operand_is_read_and_refuses_unbound_at_its_atom() -> Bool {
  match lme_outcomes() {
    LmeOutcomesDecided { ctl: _, rest_und: _, exit_und: v, bind_und: _, nested_ctl: _, multi: _, nontail: _, bind_return: _, lambda_ctl: _, uri: _, reach: _, leak: _, ctor_arm: _, hides: _, some_none: _, literal: _ } => lme_unbound_at(v: v, atom: ^lme_undeclared_exit)
    LmeContextRefused => false
  }
}

test fn a_binder_free_binding_arm_value_is_read_and_refuses_unbound_at_its_atom() -> Bool {
  match lme_outcomes() {
    LmeOutcomesDecided { ctl: _, rest_und: _, exit_und: _, bind_und: v, nested_ctl: _, multi: _, nontail: _, bind_return: _, lambda_ctl: _, uri: _, reach: _, leak: _, ctor_arm: _, hides: _, some_none: _, literal: _ } => lme_unbound_at(v: v, atom: ^lme_undeclared_bind)
    LmeContextRefused => false
  }
}

