module v2.test.claim.namespace_xl0.let_match_early_return

import v2.compiler.compile {
  NativeCensusModuleFileRefused,
  NativeCensusModuleOutcome,
  NativeCensusModuleResolveRefused,
  NativeCensusModuleResolved,
  NativeTestContext,
  native_census_module_resolution,
  native_census_modules,
  native_lane_file_refusal_index,
  native_test_context_from_ingest
}
import v2.compiler.source_authority { DagSourceReadWitness, SourceRootIngest }
import v2.std.algebra { fold_list }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.diagnostic { Accepted, NodeLocus, Rejected }
import v2.std.grammar { node_atom_identity_optional }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.optional { Absent, Optional, Present, optional_absent, optional_present }
import v2.std.text { String }
import std.algebra { Cons, Empty }
import extdeps.communication.medium { Lossless, Medium }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// A LET WHOSE VALUE IS A MATCH WITH RETURNING ARMS, HEADING A TAIL SPINE, LOWERS TO THAT MATCH WITH
// THE REST OF THE SPINE UNDER ITS ONE BINDING ARM (v2.compiler.body_lowering_fold
// body_lower_let_match_exit_join, admitted by body_lower_exit_walk_let_match).
//
// THE SUBJECT is the native route (native_test_context_from_ingest, then
// native_census_module_resolution), as v2.test.claim.namespace_xl0.return_tail_position drives it.
// THE RED ON MAIN is `ctl`, `nested_ctl` and `lambda_ctl`: each refused
// return_not_in_tail_position, the form extdeps.uri_path parse_segment_tokens uses. The `_und`
// discriminators prove the rest, the exiting arm and the binding arm are each READ (an undeclared
// atom there refuses unbound at it, so none is dropped). `multi` (two binding arms) refuses
// multi_binding_arm_early_return_needs_join_point rather than copying the rest per arm; `nontail`
// (the let-match inside a let-bound if) and `bind_return` (a return inside the binding arm's value)
// keep refusing return_not_in_tail_position. `lambda_ctl` is the lambda boundary: a fn value owns its
// own exits, so its let-match lowers inside it and exits only it.
data lme_ctl_source: String = "module v2.test.lme_ctl\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LmeS = LmeA { v: Int } | LmeB | LmeC { w: Int } | LmeD\n\nfn lme_probe(s: LmeS, k: Int) -> Int {\n  let x = match s {\n    LmeA { v: v } => v\n    LmeB => return k\n    LmeC { w: w } => return w\n    LmeD => return k\n  }\n  x\n}\n"
data lme_rest_und_source: String = "module v2.test.lme_rest_und\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LmeS = LmeA { v: Int } | LmeB | LmeC { w: Int } | LmeD\n\nfn lme_probe(s: LmeS, k: Int) -> Int {\n  let x = match s {\n    LmeA { v: v } => v\n    LmeB => return k\n    LmeC { w: w } => return w\n    LmeD => return k\n  }\n  lme_undeclared_rest\n}\n"
data lme_exit_und_source: String = "module v2.test.lme_exit_und\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LmeS = LmeA { v: Int } | LmeB | LmeC { w: Int } | LmeD\n\nfn lme_probe(s: LmeS, k: Int) -> Int {\n  let x = match s {\n    LmeA { v: v } => v\n    LmeB => return lme_undeclared_exit\n    LmeC { w: w } => return w\n    LmeD => return k\n  }\n  x\n}\n"
data lme_bind_und_source: String = "module v2.test.lme_bind_und\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LmeS = LmeA { v: Int } | LmeB | LmeC { w: Int } | LmeD\n\nfn lme_probe(s: LmeS, k: Int) -> Int {\n  let x = match s {\n    LmeA { v: v } => lme_undeclared_bind\n    LmeB => return k\n    LmeC { w: w } => return w\n    LmeD => return k\n  }\n  x\n}\n"
data lme_nested_ctl_source: String = "module v2.test.lme_nested_ctl\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LmeS = LmeA { v: Int } | LmeB | LmeC { w: Int } | LmeD\n\nfn lme_probe(s: LmeS, t: LmeS, k: Int) -> Int {\n  let x = match s {\n    LmeA { v: v } => v\n    LmeB => return k\n    LmeC { w: w } => return w\n    LmeD => return k\n  }\n  let y = match t {\n    LmeA { v: v } => v\n    LmeB => return x\n    LmeC { w: w } => return w\n    LmeD => return k\n  }\n  y\n}\n"
data lme_multi_source: String = "module v2.test.lme_multi\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LmeS = LmeA { v: Int } | LmeB | LmeC { w: Int } | LmeD\n\nfn lme_probe(s: LmeS, k: Int) -> Int {\n  let x = match s {\n    LmeA { v: v } => v\n    LmeB => return k\n    LmeC { w: w } => w\n    LmeD => return k\n  }\n  x\n}\n"
data lme_nontail_source: String = "module v2.test.lme_nontail\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LmeS = LmeA { v: Int } | LmeB | LmeC { w: Int } | LmeD\n\nfn lme_probe(c: Bool, s: LmeS, k: Int) -> Int {\n  let y = if c {\n    let x = match s {\n      LmeA { v: v } => v\n      LmeB => return k\n      LmeC { w: w } => return w\n      LmeD => return k\n    }\n    x\n  } else { k }\n  y\n}\n"
data lme_bind_return_source: String = "module v2.test.lme_bind_return\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LmeS = LmeA { v: Int } | LmeB | LmeC { w: Int } | LmeD\n\nfn lme_probe(c: Bool, s: LmeS, k: Int) -> Int {\n  let x = match s {\n    LmeA { v: v } => if c { return k } else { v }\n    LmeB => return k\n    LmeC { w: w } => return w\n    LmeD => return k\n  }\n  x\n}\n"
data lme_lambda_ctl_source: String = "module v2.test.lme_lambda_ctl\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\ntype LmeS = LmeA { v: Int } | LmeB | LmeC { w: Int } | LmeD\n\nfn lme_probe(s: LmeS, k: Int) -> Int {\n  let g = fn(t) {\n    let x = match t {\n      LmeA { v: v } => v\n      LmeB => return k\n      LmeC { w: w } => return w\n      LmeD => return k\n    }\n    x\n  }\n  k\n}\n"

fn lme_read(source: String, id: Symbol, unit: Symbol, path: String) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: source, fidelity: Lossless },
    artifact: Artifact { kind: SourceFile, id: id, file_path: path },
    compilation_unit: unit,
    source_root: DagTree
  }
}
data lme_ingest: SourceRootIngest = Cons {
    head: lme_read(source: lme_ctl_source, id: ^lme_ctl_artifact, unit: ^lme_ctl_cu, path: "src/v2/test/fixture/namespace_xl0/lme_ctl.dag"),
    tail: Cons {
    head: lme_read(source: lme_rest_und_source, id: ^lme_rest_und_artifact, unit: ^lme_rest_und_cu, path: "src/v2/test/fixture/namespace_xl0/lme_rest_und.dag"),
    tail: Cons {
    head: lme_read(source: lme_exit_und_source, id: ^lme_exit_und_artifact, unit: ^lme_exit_und_cu, path: "src/v2/test/fixture/namespace_xl0/lme_exit_und.dag"),
    tail: Cons {
    head: lme_read(source: lme_bind_und_source, id: ^lme_bind_und_artifact, unit: ^lme_bind_und_cu, path: "src/v2/test/fixture/namespace_xl0/lme_bind_und.dag"),
    tail: Cons {
    head: lme_read(source: lme_nested_ctl_source, id: ^lme_nested_ctl_artifact, unit: ^lme_nested_ctl_cu, path: "src/v2/test/fixture/namespace_xl0/lme_nested_ctl.dag"),
    tail: Cons {
    head: lme_read(source: lme_multi_source, id: ^lme_multi_artifact, unit: ^lme_multi_cu, path: "src/v2/test/fixture/namespace_xl0/lme_multi.dag"),
    tail: Cons {
    head: lme_read(source: lme_nontail_source, id: ^lme_nontail_artifact, unit: ^lme_nontail_cu, path: "src/v2/test/fixture/namespace_xl0/lme_nontail.dag"),
    tail: Cons {
    head: lme_read(source: lme_bind_return_source, id: ^lme_bind_return_artifact, unit: ^lme_bind_return_cu, path: "src/v2/test/fixture/namespace_xl0/lme_bind_return.dag"),
    tail: Cons {
    head: lme_read(source: lme_lambda_ctl_source, id: ^lme_lambda_ctl_artifact, unit: ^lme_lambda_ctl_cu, path: "src/v2/test/fixture/namespace_xl0/lme_lambda_ctl.dag"),
    tail: Empty } } } } } } } } }

// ONE FRONT END FOR EVERY CLAIM: a verdict per module, with no resolution context or Node in it.
type LmeVerdict
  = LmeResolved
  | LmeRefused { reason: Symbol, at_atom: Optional<Symbol> }
  | LmeFileRefused { fatal_reason: Optional<Symbol> }
  | LmeAbsent

type LmeOutcomes
  = LmeContextRefused
  | LmeOutcomesDecided {
      ctl: LmeVerdict
      rest_und: LmeVerdict
      exit_und: LmeVerdict
      bind_und: LmeVerdict
      nested_ctl: LmeVerdict
      multi: LmeVerdict
      nontail: LmeVerdict
      bind_return: LmeVerdict
      lambda_ctl: LmeVerdict
    }

fn lme_file_refusal_reason(context: NativeTestContext, unit: Symbol) -> Optional<Symbol> {
  fold_list(
    xs: context.file_refusals,
    empty: optional_absent(),
    cons: fn(acc, refusal) {
      if refusal.path == unit { optional_present(value: refusal.fatal_reason) } else { acc }
    }
  )
}

fn lme_verdict_of(context: NativeTestContext, unit: Symbol, outcome: NativeCensusModuleOutcome) -> LmeVerdict {
  match outcome {
    NativeCensusModuleResolved => LmeResolved
    NativeCensusModuleFileRefused =>
      LmeFileRefused { fatal_reason: lme_file_refusal_reason(context: context, unit: unit) }
    NativeCensusModuleResolveRefused { first: d, rest: _, observation: _ } =>
      LmeRefused {
        reason: d.head.reason,
        at_atom: match d.head.at {
          NodeLocus { anchor: a } => node_atom_identity_optional(node: a.at)
          _ => optional_absent()
        }
      }
  }
}

fn lme_verdict_in(context: NativeTestContext, module_name: String, unit: Symbol) -> LmeVerdict {
  fold_list(
    xs: native_census_modules(ingest: lme_ingest),
    empty: LmeAbsent,
    cons: fn(acc, entry) {
      if entry.module == module_name {
        lme_verdict_of(
          context: context,
          unit: unit,
          outcome: native_census_module_resolution(
            context: context,
            refusal_index: native_lane_file_refusal_index(refusals: context.file_refusals),
            entry: entry
          ).outcome
        )
      } else {
        acc
      }
    }
  )
}

fn lme_outcomes() -> LmeOutcomes {
  match native_test_context_from_ingest(ingest: lme_ingest) {
    Rejected { diagnostics: _ } => LmeContextRefused
    Accepted { value: context, diagnostics: _ } =>
      LmeOutcomesDecided {
        ctl: lme_verdict_in(context: context, module_name: "v2.test.lme_ctl", unit: ^lme_ctl_cu),
        rest_und: lme_verdict_in(context: context, module_name: "v2.test.lme_rest_und", unit: ^lme_rest_und_cu),
        exit_und: lme_verdict_in(context: context, module_name: "v2.test.lme_exit_und", unit: ^lme_exit_und_cu),
        bind_und: lme_verdict_in(context: context, module_name: "v2.test.lme_bind_und", unit: ^lme_bind_und_cu),
        nested_ctl: lme_verdict_in(context: context, module_name: "v2.test.lme_nested_ctl", unit: ^lme_nested_ctl_cu),
        multi: lme_verdict_in(context: context, module_name: "v2.test.lme_multi", unit: ^lme_multi_cu),
        nontail: lme_verdict_in(context: context, module_name: "v2.test.lme_nontail", unit: ^lme_nontail_cu),
        bind_return: lme_verdict_in(context: context, module_name: "v2.test.lme_bind_return", unit: ^lme_bind_return_cu),
        lambda_ctl: lme_verdict_in(context: context, module_name: "v2.test.lme_lambda_ctl", unit: ^lme_lambda_ctl_cu)
      }
  }
}

fn lme_is_resolved(v: LmeVerdict) -> Bool {
  match v {
    LmeResolved => true
    _ => false
  }
}

fn lme_refuses_as(v: LmeVerdict, reason: Symbol) -> Bool {
  match v {
    LmeFileRefused { fatal_reason: Present { value: r } } => r == reason
    _ => false
  }
}

fn lme_unbound_at(v: LmeVerdict, atom: Symbol) -> Bool {
  match v {
    LmeRefused { reason: r, at_atom: Present { value: id } } => (r == ^resolve_reason_unbound_symbol) && (id == atom)
    _ => false
  }
}

test fn a_let_match_with_one_binding_arm_and_returning_arms_is_accepted() -> Bool {
  match lme_outcomes() {
    LmeOutcomesDecided { ctl: v, rest_und: _, exit_und: _, bind_und: _, nested_ctl: _, multi: _, nontail: _, bind_return: _, lambda_ctl: _ } => lme_is_resolved(v: v)
    LmeContextRefused => false
  }
}

test fn the_rest_after_a_let_match_is_read_and_refuses_unbound_at_its_atom() -> Bool {
  match lme_outcomes() {
    LmeOutcomesDecided { ctl: _, rest_und: v, exit_und: _, bind_und: _, nested_ctl: _, multi: _, nontail: _, bind_return: _, lambda_ctl: _ } => lme_unbound_at(v: v, atom: ^lme_undeclared_rest)
    LmeContextRefused => false
  }
}

test fn a_returning_arm_operand_is_read_and_refuses_unbound_at_its_atom() -> Bool {
  match lme_outcomes() {
    LmeOutcomesDecided { ctl: _, rest_und: _, exit_und: v, bind_und: _, nested_ctl: _, multi: _, nontail: _, bind_return: _, lambda_ctl: _ } => lme_unbound_at(v: v, atom: ^lme_undeclared_exit)
    LmeContextRefused => false
  }
}

test fn the_binding_arm_value_is_read_and_refuses_unbound_at_its_atom() -> Bool {
  match lme_outcomes() {
    LmeOutcomesDecided { ctl: _, rest_und: _, exit_und: _, bind_und: v, nested_ctl: _, multi: _, nontail: _, bind_return: _, lambda_ctl: _ } => lme_unbound_at(v: v, atom: ^lme_undeclared_bind)
    LmeContextRefused => false
  }
}

test fn a_let_match_in_the_rest_of_another_is_accepted() -> Bool {
  match lme_outcomes() {
    LmeOutcomesDecided { ctl: _, rest_und: _, exit_und: _, bind_und: _, nested_ctl: v, multi: _, nontail: _, bind_return: _, lambda_ctl: _ } => lme_is_resolved(v: v)
    LmeContextRefused => false
  }
}

test fn two_binding_arms_refuse_as_needing_a_join_point() -> Bool {
  match lme_outcomes() {
    LmeOutcomesDecided { ctl: _, rest_und: _, exit_und: _, bind_und: _, nested_ctl: _, multi: v, nontail: _, bind_return: _, lambda_ctl: _ } => lme_refuses_as(v: v, reason: ^body_lowering_reason_multi_binding_arm_early_return_needs_join_point)
    LmeContextRefused => false
  }
}

test fn a_let_match_outside_a_tail_spine_still_refuses_as_not_in_tail_position() -> Bool {
  match lme_outcomes() {
    LmeOutcomesDecided { ctl: _, rest_und: _, exit_und: _, bind_und: _, nested_ctl: _, multi: _, nontail: v, bind_return: _, lambda_ctl: _ } => lme_refuses_as(v: v, reason: ^body_lowering_reason_return_not_in_tail_position)
    LmeContextRefused => false
  }
}

test fn a_return_inside_the_binding_arm_still_refuses_as_not_in_tail_position() -> Bool {
  match lme_outcomes() {
    LmeOutcomesDecided { ctl: _, rest_und: _, exit_und: _, bind_und: _, nested_ctl: _, multi: _, nontail: _, bind_return: v, lambda_ctl: _ } => lme_refuses_as(v: v, reason: ^body_lowering_reason_return_not_in_tail_position)
    LmeContextRefused => false
  }
}

test fn a_let_match_in_a_fn_value_exits_only_the_fn_value_and_is_accepted() -> Bool {
  match lme_outcomes() {
    LmeOutcomesDecided { ctl: _, rest_und: _, exit_und: _, bind_und: _, nested_ctl: _, multi: _, nontail: _, bind_return: _, lambda_ctl: v } => lme_is_resolved(v: v)
    LmeContextRefused => false
  }
}
