module v2.test.claim.namespace_xl0.accepted_module_silent_drop

import v2.compiler.compile {
  NativeCensusModuleFileRefused,
  NativeCensusModuleOutcome,
  NativeCensusModuleResolveRefused,
  NativeCensusModuleResolved,
  native_census_module_resolution,
  native_census_modules,
  native_lane_file_refusal_index,
  native_test_context_from_ingest
}
import v2.compiler.source_authority { DagSourceReadWitness, SourceRootIngest }
import v2.std.algebra { fold_list }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.diagnostic { Accepted, NodeLocus, Rejected }
import v2.std.grammar { node_atom_identity_optional }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.optional { Optional, Present, optional_absent }
import v2.std.text { String }
import std.algebra { Cons, Empty }
import extdeps.communication.medium { Lossless, Medium }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// A NAME IN A POSITION v2 BODY LOWERING DROPS WHILE NORMALIZE STILL ACCEPTS THE MODULE.
//
// THE SUBJECT IS THE NATIVE LANE'S FRONT END AND RESOLVE, the same route as
// v2.test.claim.namespace_xl0.call_argument_value_resolve_refusal: native_test_context_from_ingest
// tokenizes, parses, normalizes and indexes the supplied sources, and native_census_module_resolution
// resolves one module against it. Each specimen puts ONE undeclared name where the XL-2 conservation
// census (v2.compiler.reference_conservation_census reference_conservation_census_for_paths over
// reference_conservation_stratified_sample_paths) found authored atoms absent from the normalized
// tree of an ACCEPTED module. Each claim holds only when resolve refuses the module as unbound AT
// that name's atom: that is the one route on which the name is known to have survived lowering.
// Resolving is the silent drop, since the name never reached resolve. A refusal at normalize does not
// count, because no normalize reason for these positions exists yet, and "refused for any reason"
// would let a parse or import regression green a specimen while the drop stands (review 71360). A
// repair that chooses to refuse the position at normalize names its reason here in the same change.
//
// EACH GROUP IS ITS OWN INGEST, and each claim resolves only the module it asks about, so a claim
// pays for its specimen and control and not for the other groups (DESIGN section 3, a witness
// discriminates at one interface; review 71360).
//
// EACH SPECIMEN HAS A CONTROL THAT VARIES ONE THING, so a red names the dropped position and not
// the route: the same undeclared name one arm earlier, as the operand of a binary expression whose
// other operand is not block-headed, and as a record field value instead of a map value. The controls
// refuse at the atom today; the specimens resolve today, and are enrolled expected-red in
// v2.workflow.floor_expected_red until body lowering carries the position.
//
// Rostered as gunbc.recurring_failure_mode match_arms_after_the_second_are_dropped_at_v2_body_lowering,
// binary_operand_beside_a_block_headed_operand_is_dropped_at_v2_body_lowering and
// map_literal_lowers_to_its_opening_brace_at_v2_body_lowering.
data sd_arm_three_source: String = "module v2.test.sd_arm_three\n\nimport v2.std.logic { Bool }\n\ntype SdW = SdA | SdB | SdC\n\nfn sd_probe(w: SdW) -> Bool {\n  match w {\n    SdA => true\n    SdB => true\n    SdC => sd_undeclared_arm_three\n  }\n}\n"

data sd_arm_two_source: String = "module v2.test.sd_arm_two\n\nimport v2.std.logic { Bool }\n\ntype SdW = SdA | SdB\n\nfn sd_probe(w: SdW) -> Bool {\n  match w {\n    SdA => true\n    SdB => sd_undeclared_arm_two\n  }\n}\n"

data sd_and_match_source: String = "module v2.test.sd_and_match\n\nimport v2.std.logic { Bool }\n\ntype SdW = SdA | SdB\n\nfn sd_probe(w: SdW, c: Bool) -> Bool {\n  sd_undeclared_and_match && match w {\n    SdA => true\n    SdB => c\n  }\n}\n"

data sd_and_if_source: String = "module v2.test.sd_and_if\n\nimport v2.std.logic { Bool }\n\nfn sd_probe(c: Bool) -> Bool {\n  sd_undeclared_and_if && if c { true } else { false }\n}\n"

data sd_and_plain_source: String = "module v2.test.sd_and_plain\n\nimport v2.std.logic { Bool }\n\nfn sd_probe(c: Bool) -> Bool {\n  sd_undeclared_and_plain && c\n}\n"

data sd_map_value_source: String = "module v2.test.sd_map_value\n\nimport v2.std.logic { Bool }\nimport v2.std.text { String }\nimport v2.std.collection { Map }\n\ndata sd_probe: Map<String, Bool> = { \"k\": sd_undeclared_map_value }\n"

data sd_record_value_source: String = "module v2.test.sd_record_value\n\nimport v2.std.logic { Bool }\n\ntype SdR { k: Bool }\n\ndata sd_probe: SdR = SdR { k: sd_undeclared_record_value }\n"

fn sd_read(source: String, id: Symbol, unit: Symbol, path: String) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: source, fidelity: Lossless },
    artifact: Artifact { kind: SourceFile, id: id, file_path: path },
    compilation_unit: unit,
    source_root: DagTree
  }
}

data sd_arm_ingest: SourceRootIngest = Cons {
    head: sd_read(source: sd_arm_three_source, id: ^sd_arm_three_artifact, unit: ^sd_arm_three_cu, path: "src/v2/test/fixture/namespace_xl0/sd_arm_three.dag"),
    tail: Cons {
    head: sd_read(source: sd_arm_two_source, id: ^sd_arm_two_artifact, unit: ^sd_arm_two_cu, path: "src/v2/test/fixture/namespace_xl0/sd_arm_two.dag"),
    tail: Empty
  }
  }

data sd_operand_ingest: SourceRootIngest = Cons {
    head: sd_read(source: sd_and_match_source, id: ^sd_and_match_artifact, unit: ^sd_and_match_cu, path: "src/v2/test/fixture/namespace_xl0/sd_and_match.dag"),
    tail: Cons {
    head: sd_read(source: sd_and_if_source, id: ^sd_and_if_artifact, unit: ^sd_and_if_cu, path: "src/v2/test/fixture/namespace_xl0/sd_and_if.dag"),
    tail: Cons {
    head: sd_read(source: sd_and_plain_source, id: ^sd_and_plain_artifact, unit: ^sd_and_plain_cu, path: "src/v2/test/fixture/namespace_xl0/sd_and_plain.dag"),
    tail: Empty
  }
  }
  }

data sd_literal_ingest: SourceRootIngest = Cons {
    head: sd_read(source: sd_map_value_source, id: ^sd_map_value_artifact, unit: ^sd_map_value_cu, path: "src/v2/test/fixture/namespace_xl0/sd_map_value.dag"),
    tail: Cons {
    head: sd_read(source: sd_record_value_source, id: ^sd_record_value_artifact, unit: ^sd_record_value_cu, path: "src/v2/test/fixture/namespace_xl0/sd_record_value.dag"),
    tail: Empty
  }
  }

type SdVerdict
  = SdResolved
  | SdFileRefused
  | SdRefused { reason: Symbol, at_atom: Optional<Symbol> }
  | SdAbsent
  | SdContextRefused

fn sd_verdict_of(outcome: NativeCensusModuleOutcome) -> SdVerdict {
  match outcome {
    NativeCensusModuleResolved => SdResolved
    NativeCensusModuleFileRefused => SdFileRefused
    NativeCensusModuleResolveRefused { first: d, rest: _, observation: _ } =>
      SdRefused {
        reason: d.head.reason,
        at_atom: match d.head.at {
          NodeLocus { anchor: a } => node_atom_identity_optional(node: a.at)
          _ => optional_absent()
        }
      }
  }
}

// The one module the claim asks about, resolved against its group's context; the group's other
// modules are indexed (they are the ingest) but not resolved.
fn sd_verdict(ingest: SourceRootIngest, module_name: String) -> SdVerdict {
  match native_test_context_from_ingest(ingest: ingest) {
    Rejected { diagnostics: _ } => SdContextRefused
    Accepted { value: context, diagnostics: _ } =>
      fold_list(
        xs: native_census_modules(ingest: ingest),
        empty: SdAbsent,
        cons: fn(acc, entry) {
          if entry.module == module_name {
            sd_verdict_of(
              outcome: native_census_module_resolution(
                context: context,
                refusal_index: native_lane_file_refusal_index(refusals: context.file_refusals),
                entry: entry
              )
            )
          } else {
            acc
          }
        }
      )
  }
}

// Refused at resolve, the first refusal is unbound, and its locus is the name's own atom.
fn sd_is_unbound_at(v: SdVerdict, spelling: Symbol) -> Bool {
  match v {
    SdRefused { reason: r, at_atom: Present { value: id } } =>
      (r == ^resolve_reason_unbound_symbol) && (id == spelling)
    _ => false
  }
}

test fn a_third_match_arm_reaches_resolve() -> Bool {
  sd_is_unbound_at(v: sd_verdict(ingest: sd_arm_ingest, module_name: "v2.test.sd_arm_three"), spelling: ^sd_undeclared_arm_three)
}

test fn a_second_match_arm_reaches_resolve() -> Bool {
  sd_is_unbound_at(v: sd_verdict(ingest: sd_arm_ingest, module_name: "v2.test.sd_arm_two"), spelling: ^sd_undeclared_arm_two)
}

test fn a_binary_operand_beside_a_match_reaches_resolve() -> Bool {
  sd_is_unbound_at(v: sd_verdict(ingest: sd_operand_ingest, module_name: "v2.test.sd_and_match"), spelling: ^sd_undeclared_and_match)
}

test fn a_binary_operand_beside_an_if_reaches_resolve() -> Bool {
  sd_is_unbound_at(v: sd_verdict(ingest: sd_operand_ingest, module_name: "v2.test.sd_and_if"), spelling: ^sd_undeclared_and_if)
}

test fn a_binary_operand_beside_a_name_reaches_resolve() -> Bool {
  sd_is_unbound_at(v: sd_verdict(ingest: sd_operand_ingest, module_name: "v2.test.sd_and_plain"), spelling: ^sd_undeclared_and_plain)
}

test fn a_map_literal_value_reaches_resolve() -> Bool {
  sd_is_unbound_at(v: sd_verdict(ingest: sd_literal_ingest, module_name: "v2.test.sd_map_value"), spelling: ^sd_undeclared_map_value)
}

test fn a_record_literal_value_reaches_resolve() -> Bool {
  sd_is_unbound_at(v: sd_verdict(ingest: sd_literal_ingest, module_name: "v2.test.sd_record_value"), spelling: ^sd_undeclared_record_value)
}
