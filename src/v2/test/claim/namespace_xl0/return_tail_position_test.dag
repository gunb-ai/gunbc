data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// A `return` LOWERS ONLY AS THE TAIL OF A FUNCTION'S OWN BODY, AND REFUSES LOCATED EVERYWHERE ELSE.
//
// THE SUBJECT is v2.compiler.body_lowering_fold's return wall (body_lower_return_outside_tail_optional
// at the fn declaration, the fn value block body and the data initializer) and its tail read
// (body_lower_tail_statement_read), on the native lane's route (native_test_context_from_ingest, then
// native_census_module_resolution) -- the same route
// v2.test.claim.namespace_xl0.if_arm_and_statement_lowering_refusal drives.
//
// THE STRUCTURED TAIL (the RFM's next rung): a return in an arm of a tail if or match, and a guard
// heading a tail spine with a following statement, are admitted and lower -- the arm to its value,
// the guard to Branch(c, arm, rest) -- and their `_und` twins prove the arm and the rest are READ.
// A guard that falls through, is the last statement, or sits in a non-tail spine still refuses.
//
// THE RED ON MAIN is `bug`: `let x = if c { return j } else { k }` followed by `x`. No reader named
// the `return` keyword, so a first-match search answered the statement with its operand: the module
// was ACCEPTED as x = Branch(c, j, k), the function continuing where it should have exited
// (gunbc.recurring_failure_mode return_lowered_as_its_operand_outside_the_function_tail). It refuses
// now, located at the return. `arm` (a return in an if arm, the if in tail position) and
// `lambda_nontail` were accepted the same way; `nontail` refused on main under the generic
// statement_precedes_without_binding and now names its own cause. `guard` keeps refusing
// else_less_if_unlowered: the guard needs the tail position carried through the value readers (the
// same row's next-rung trigger).
//
// THE CONTROLS hold on both sides: a tail return in a fn body, after a let, and in a fn value's
// block body are accepted. `tail_und` is the discriminator that the tail return's operand is READ,
// not dropped: its undeclared operand refuses unbound at that atom.
data rtp_bug_source: String = "module v2.test.rtp_bug\n\nimport std.types { Bool }\nimport v2.std.integer { Int }\n\nfn rtp_probe(c: Bool, j: Int, k: Int) -> Int {\n  let x = if c { return j } else { k }\n  x\n}\n"

data rtp_nontail_source: String = "module v2.test.rtp_nontail\n\nimport std.types { Bool }\nimport v2.std.integer { Int }\n\nfn rtp_probe(i: Int) -> Int {\n  return i\n  i\n}\n"

data rtp_lambda_nontail_source: String = "module v2.test.rtp_lambda_nontail\n\nimport std.types { Bool }\nimport v2.std.integer { Int }\n\nfn rtp_probe(i: Int) -> Int {\n  let g = fn(x) {\n    return x\n    x\n  }\n  i\n}\n"

data rtp_guard_fallthrough_source: String = "module v2.test.rtp_guard_fallthrough\n\nimport std.types { Bool }\nimport v2.std.integer { Int }\n\nfn rtp_probe(c: Bool, i: Int) -> Int {\n  if c { i }\n  i\n}\n"

data rtp_guard_last_source: String = "module v2.test.rtp_guard_last\n\nimport std.types { Bool }\nimport v2.std.integer { Int }\n\nfn rtp_probe(c: Bool, i: Int) -> Int {\n  let j = i\n  if c { return j }\n}\n"

data rtp_guard_nontail_source: String = "module v2.test.rtp_guard_nontail\n\nimport std.types { Bool }\nimport v2.std.integer { Int }\n\nfn rtp_probe(c: Bool, j: Int, k: Int) -> Int {\n  let x = if c {\n    if c { return j }\n    k\n  } else { k }\n  x\n}\n"

data rtp_tail_ctl_source: String = "module v2.test.rtp_tail_ctl\n\nimport std.types { Bool }\nimport v2.std.integer { Int }\n\nfn rtp_probe(i: Int) -> Int { return i }\n"

data rtp_let_tail_ctl_source: String = "module v2.test.rtp_let_tail_ctl\n\nimport std.types { Bool }\nimport v2.std.integer { Int }\n\nfn rtp_probe(i: Int) -> Int {\n  let x = i\n  return x\n}\n"

data rtp_lambda_tail_ctl_source: String = "module v2.test.rtp_lambda_tail_ctl\n\nimport std.types { Bool }\nimport v2.std.integer { Int }\n\nfn rtp_probe(i: Int) -> Int {\n  let g = fn(x) { return x }\n  i\n}\n"

data rtp_tail_und_source: String = "module v2.test.rtp_tail_und\n\nimport std.types { Bool }\nimport v2.std.integer { Int }\n\nfn rtp_probe(i: Int) -> Int { return rtp_undeclared_tail }\n"

data rtp_arm_ctl_source: String = "module v2.test.rtp_arm_ctl\n\nimport std.types { Bool }\nimport v2.std.integer { Int }\n\nfn rtp_probe(c: Bool, i: Int) -> Int { if c { return i } else { i } }\n"

data rtp_guard_ctl_source: String = "module v2.test.rtp_guard_ctl\n\nimport std.types { Bool }\nimport v2.std.integer { Int }\n\nfn rtp_probe(c: Bool, i: Int) -> Int {\n  if c { return i }\n  let j = i\n  j\n}\n"

data rtp_guard_arm_und_source: String = "module v2.test.rtp_guard_arm_und\n\nimport std.types { Bool }\nimport v2.std.integer { Int }\n\nfn rtp_probe(c: Bool, i: Int) -> Int {\n  if c { return rtp_undeclared_guard_arm }\n  i\n}\n"

data rtp_guard_rest_und_source: String = "module v2.test.rtp_guard_rest_und\n\nimport std.types { Bool }\nimport v2.std.integer { Int }\n\nfn rtp_probe(c: Bool, i: Int) -> Int {\n  if c { return i }\n  rtp_undeclared_guard_rest\n}\n"

data rtp_match_ctl_source: String = "module v2.test.rtp_match_ctl\n\nimport std.types { Bool }\nimport v2.std.integer { Int }\n\ntype RtpS = RtpA | RtpB\n\nfn rtp_probe(s: RtpS, i: Int) -> Int { match s {\n  RtpA => return i\n  RtpB => i\n} }\n"

data rtp_match_und_source: String = "module v2.test.rtp_match_und\n\nimport std.types { Bool }\nimport v2.std.integer { Int }\n\ntype RtpS = RtpA | RtpB\n\nfn rtp_probe(s: RtpS, i: Int) -> Int { match s {\n  RtpA => return rtp_undeclared_match_arm\n  RtpB => i\n} }\n"

data rtp_match_nested_ctl_source: String = "module v2.test.rtp_match_nested_ctl\n\nimport std.types { Bool }\nimport v2.std.integer { Int }\n\ntype RtpS = RtpA | RtpB\n\nfn rtp_probe(s: RtpS, t: RtpS, i: Int) -> Int { match s {\n  RtpA => return i\n  RtpB =>\n    match t {\n      RtpA => return i\n      RtpB => return i\n    }\n} }\n"

fn rtp_read(source: String, id: Symbol, unit: Symbol, path: String) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: source, fidelity: Lossless },
    artifact: Artifact { kind: SourceFile, id: id, file_path: path },
    compilation_unit: unit,
    source_root: DagTree
  }
}

data rtp_ingest: SourceRootIngest = Cons {
    head: rtp_read(source: rtp_match_nested_ctl_source, id: ^rtp_match_nested_ctl_artifact, unit: ^rtp_match_nested_ctl_cu, path: "src/v2/test/fixture/namespace_xl0/rtp_match_nested_ctl.dag"),
    tail: Cons {
    head: rtp_read(source: rtp_bug_source, id: ^rtp_bug_artifact, unit: ^rtp_bug_cu, path: "src/v2/test/fixture/namespace_xl0/rtp_bug.dag"),
    tail: Cons {
    head: rtp_read(source: rtp_nontail_source, id: ^rtp_nontail_artifact, unit: ^rtp_nontail_cu, path: "src/v2/test/fixture/namespace_xl0/rtp_nontail.dag"),
    tail: Cons {
    head: rtp_read(source: rtp_lambda_nontail_source, id: ^rtp_lambda_nontail_artifact, unit: ^rtp_lambda_nontail_cu, path: "src/v2/test/fixture/namespace_xl0/rtp_lambda_nontail.dag"),
    tail: Cons {
    head: rtp_read(source: rtp_guard_fallthrough_source, id: ^rtp_guard_fallthrough_artifact, unit: ^rtp_guard_fallthrough_cu, path: "src/v2/test/fixture/namespace_xl0/rtp_guard_fallthrough.dag"),
    tail: Cons {
    head: rtp_read(source: rtp_guard_last_source, id: ^rtp_guard_last_artifact, unit: ^rtp_guard_last_cu, path: "src/v2/test/fixture/namespace_xl0/rtp_guard_last.dag"),
    tail: Cons {
    head: rtp_read(source: rtp_guard_nontail_source, id: ^rtp_guard_nontail_artifact, unit: ^rtp_guard_nontail_cu, path: "src/v2/test/fixture/namespace_xl0/rtp_guard_nontail.dag"),
    tail: Cons {
    head: rtp_read(source: rtp_tail_ctl_source, id: ^rtp_tail_ctl_artifact, unit: ^rtp_tail_ctl_cu, path: "src/v2/test/fixture/namespace_xl0/rtp_tail_ctl.dag"),
    tail: Cons {
    head: rtp_read(source: rtp_let_tail_ctl_source, id: ^rtp_let_tail_ctl_artifact, unit: ^rtp_let_tail_ctl_cu, path: "src/v2/test/fixture/namespace_xl0/rtp_let_tail_ctl.dag"),
    tail: Cons {
    head: rtp_read(source: rtp_lambda_tail_ctl_source, id: ^rtp_lambda_tail_ctl_artifact, unit: ^rtp_lambda_tail_ctl_cu, path: "src/v2/test/fixture/namespace_xl0/rtp_lambda_tail_ctl.dag"),
    tail: Cons {
    head: rtp_read(source: rtp_tail_und_source, id: ^rtp_tail_und_artifact, unit: ^rtp_tail_und_cu, path: "src/v2/test/fixture/namespace_xl0/rtp_tail_und.dag"),
    tail: Cons {
    head: rtp_read(source: rtp_arm_ctl_source, id: ^rtp_arm_ctl_artifact, unit: ^rtp_arm_ctl_cu, path: "src/v2/test/fixture/namespace_xl0/rtp_arm_ctl.dag"),
    tail: Cons {
    head: rtp_read(source: rtp_guard_ctl_source, id: ^rtp_guard_ctl_artifact, unit: ^rtp_guard_ctl_cu, path: "src/v2/test/fixture/namespace_xl0/rtp_guard_ctl.dag"),
    tail: Cons {
    head: rtp_read(source: rtp_guard_arm_und_source, id: ^rtp_guard_arm_und_artifact, unit: ^rtp_guard_arm_und_cu, path: "src/v2/test/fixture/namespace_xl0/rtp_guard_arm_und.dag"),
    tail: Cons {
    head: rtp_read(source: rtp_guard_rest_und_source, id: ^rtp_guard_rest_und_artifact, unit: ^rtp_guard_rest_und_cu, path: "src/v2/test/fixture/namespace_xl0/rtp_guard_rest_und.dag"),
    tail: Cons {
    head: rtp_read(source: rtp_match_ctl_source, id: ^rtp_match_ctl_artifact, unit: ^rtp_match_ctl_cu, path: "src/v2/test/fixture/namespace_xl0/rtp_match_ctl.dag"),
    tail: Cons {
    head: rtp_read(source: rtp_match_und_source, id: ^rtp_match_und_artifact, unit: ^rtp_match_und_cu, path: "src/v2/test/fixture/namespace_xl0/rtp_match_und.dag"),
    tail: Empty
  }
  }
  }
  }
  }
  }
  }
  }
