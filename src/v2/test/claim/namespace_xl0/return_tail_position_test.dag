module v2.test.claim.namespace_xl0.return_tail_position

import v2.compiler.compile {
  NativeCensusModuleFileRefused,
  NativeCensusModuleOutcome,
  NativeCensusModuleResolveRefused,
  NativeCensusModuleResolved,
  NativeTestContext,
  native_census_module_resolution,
  native_census_modules,
  native_lane_file_refusal_index,
  native_test_context_from_ingest
}
import v2.compiler.source_authority { DagSourceReadWitness, SourceRootIngest }
import v2.std.algebra { fold_list }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.diagnostic { Accepted, NodeLocus, Rejected }
import v2.std.grammar { node_atom_identity_optional }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.optional { Absent, Optional, Present, optional_absent, optional_present }
import v2.std.text { String }
import std.algebra { Cons, Empty }
import extdeps.communication.medium { Lossless, Medium }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// A `return` LOWERS ONLY AS THE TAIL OF A FUNCTION'S OWN BODY, AND REFUSES LOCATED EVERYWHERE ELSE.
//
// THE SUBJECT is v2.compiler.body_lowering_fold's return wall (body_lower_return_outside_tail_optional
// at the fn declaration, the fn value block body and the data initializer) and its tail read
// (body_lower_tail_statement_read), on the native lane's route (native_test_context_from_ingest, then
// native_census_module_resolution) -- the same route
// v2.test.claim.namespace_xl0.if_arm_and_statement_lowering_refusal drives.
//
// THE RED ON MAIN is `bug`: `let x = if c { return j } else { k }` followed by `x`. No reader named
// the `return` keyword, so a first-match search answered the statement with its operand: the module
// was ACCEPTED as x = Branch(c, j, k), the function continuing where it should have exited
// (gunbc.recurring_failure_mode return_lowered_as_its_operand_outside_the_function_tail). It refuses
// now, located at the return. `arm` (a return in an if arm, the if in tail position) and
// `lambda_nontail` were accepted the same way; `nontail` refused on main under the generic
// statement_precedes_without_binding and now names its own cause. `guard` keeps refusing
// else_less_if_unlowered: the guard needs the tail position carried through the value readers (the
// same row's next-rung trigger).
//
// THE CONTROLS hold on both sides: a tail return in a fn body, after a let, and in a fn value's
// block body are accepted. `tail_und` is the discriminator that the tail return's operand is READ,
// not dropped: its undeclared operand refuses unbound at that atom.
data rtp_bug_source: String = "module v2.test.rtp_bug\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\nfn rtp_probe(c: Bool, j: Int, k: Int) -> Int {\n  let x = if c { return j } else { k }\n  x\n}\n"

data rtp_nontail_source: String = "module v2.test.rtp_nontail\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\nfn rtp_probe(i: Int) -> Int {\n  return i\n  i\n}\n"

data rtp_arm_source: String = "module v2.test.rtp_arm\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\nfn rtp_probe(c: Bool, i: Int) -> Int { if c { return i } else { i } }\n"

data rtp_guard_source: String = "module v2.test.rtp_guard\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\nfn rtp_probe(c: Bool, i: Int) -> Int {\n  if c { return i }\n  i\n}\n"

data rtp_lambda_nontail_source: String = "module v2.test.rtp_lambda_nontail\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\nfn rtp_probe(i: Int) -> Int {\n  let g = fn(x) {\n    return x\n    x\n  }\n  i\n}\n"

data rtp_tail_ctl_source: String = "module v2.test.rtp_tail_ctl\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\nfn rtp_probe(i: Int) -> Int { return i }\n"

data rtp_let_tail_ctl_source: String = "module v2.test.rtp_let_tail_ctl\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\nfn rtp_probe(i: Int) -> Int {\n  let x = i\n  return x\n}\n"

data rtp_tail_und_source: String = "module v2.test.rtp_tail_und\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\nfn rtp_probe(i: Int) -> Int { return rtp_undeclared_tail }\n"

data rtp_lambda_tail_ctl_source: String = "module v2.test.rtp_lambda_tail_ctl\n\nimport v2.std.logic { Bool }\nimport v2.std.integer { Int }\n\nfn rtp_probe(i: Int) -> Int {\n  let g = fn(x) { return x }\n  i\n}\n"

fn rtp_read(source: String, id: Symbol, unit: Symbol, path: String) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: source, fidelity: Lossless },
    artifact: Artifact { kind: SourceFile, id: id, file_path: path },
    compilation_unit: unit,
    source_root: DagTree
  }
}

data rtp_ingest: SourceRootIngest = Cons {
    head: rtp_read(source: rtp_bug_source, id: ^rtp_bug_artifact, unit: ^rtp_bug_cu, path: "src/v2/test/fixture/namespace_xl0/rtp_bug.dag"),
    tail: Cons {
    head: rtp_read(source: rtp_nontail_source, id: ^rtp_nontail_artifact, unit: ^rtp_nontail_cu, path: "src/v2/test/fixture/namespace_xl0/rtp_nontail.dag"),
    tail: Cons {
    head: rtp_read(source: rtp_arm_source, id: ^rtp_arm_artifact, unit: ^rtp_arm_cu, path: "src/v2/test/fixture/namespace_xl0/rtp_arm.dag"),
    tail: Cons {
    head: rtp_read(source: rtp_guard_source, id: ^rtp_guard_artifact, unit: ^rtp_guard_cu, path: "src/v2/test/fixture/namespace_xl0/rtp_guard.dag"),
    tail: Cons {
    head: rtp_read(source: rtp_lambda_nontail_source, id: ^rtp_lambda_nontail_artifact, unit: ^rtp_lambda_nontail_cu, path: "src/v2/test/fixture/namespace_xl0/rtp_lambda_nontail.dag"),
    tail: Cons {
    head: rtp_read(source: rtp_tail_ctl_source, id: ^rtp_tail_ctl_artifact, unit: ^rtp_tail_ctl_cu, path: "src/v2/test/fixture/namespace_xl0/rtp_tail_ctl.dag"),
    tail: Cons {
    head: rtp_read(source: rtp_let_tail_ctl_source, id: ^rtp_let_tail_ctl_artifact, unit: ^rtp_let_tail_ctl_cu, path: "src/v2/test/fixture/namespace_xl0/rtp_let_tail_ctl.dag"),
    tail: Cons {
    head: rtp_read(source: rtp_tail_und_source, id: ^rtp_tail_und_artifact, unit: ^rtp_tail_und_cu, path: "src/v2/test/fixture/namespace_xl0/rtp_tail_und.dag"),
    tail: Cons {
    head: rtp_read(source: rtp_lambda_tail_ctl_source, id: ^rtp_lambda_tail_ctl_artifact, unit: ^rtp_lambda_tail_ctl_cu, path: "src/v2/test/fixture/namespace_xl0/rtp_lambda_tail_ctl.dag"),
    tail: Empty
  }
  }
  }
  }
  }
  }
  }
  }
  }

// ONE FRONT END FOR EVERY CLAIM, enrolled WARM in v2.workflow.floor_pure_producer_share: the stored
// value is a verdict per module with no resolution context, Node or closure in it.
type RtpVerdict
  = RtpResolved
  | RtpRefused { reason: Symbol, at_atom: Optional<Symbol> }
  | RtpFileRefused { fatal_reason: Optional<Symbol> }
  | RtpAbsent

type RtpOutcomes
  = RtpContextRefused
  | RtpOutcomesDecided {
      bug: RtpVerdict
      nontail: RtpVerdict
      arm: RtpVerdict
      guard: RtpVerdict
      lambda_nontail: RtpVerdict
      tail_ctl: RtpVerdict
      let_tail_ctl: RtpVerdict
      tail_und: RtpVerdict
      lambda_tail_ctl: RtpVerdict
    }

fn rtp_file_refusal_reason(context: NativeTestContext, unit: Symbol) -> Optional<Symbol> {
  fold_list(
    xs: context.file_refusals,
    empty: optional_absent(),
    cons: fn(acc, refusal) {
      if refusal.path == unit { optional_present(value: refusal.fatal_reason) } else { acc }
    }
  )
}

fn rtp_verdict_of(context: NativeTestContext, unit: Symbol, outcome: NativeCensusModuleOutcome) -> RtpVerdict {
  match outcome {
    NativeCensusModuleResolved => RtpResolved
    NativeCensusModuleFileRefused =>
      RtpFileRefused { fatal_reason: rtp_file_refusal_reason(context: context, unit: unit) }
    NativeCensusModuleResolveRefused { first: d, rest: _, observation: _ } =>
      RtpRefused {
        reason: d.head.reason,
        at_atom: match d.head.at {
          NodeLocus { anchor: a } => node_atom_identity_optional(node: a.at)
          _ => optional_absent()
        }
      }
  }
}

fn rtp_verdict_in(context: NativeTestContext, module_name: String, unit: Symbol) -> RtpVerdict {
  fold_list(
    xs: native_census_modules(ingest: rtp_ingest),
    empty: RtpAbsent,
    cons: fn(acc, entry) {
      if entry.module == module_name {
        rtp_verdict_of(
          context: context,
          unit: unit,
          outcome: native_census_module_resolution(
            context: context,
            refusal_index: native_lane_file_refusal_index(refusals: context.file_refusals),
            entry: entry
          )
        )
      } else {
        acc
      }
    }
  )
}

fn rtp_outcomes() -> RtpOutcomes {
  match native_test_context_from_ingest(ingest: rtp_ingest) {
    Rejected { diagnostics: _ } => RtpContextRefused
    Accepted { value: context, diagnostics: _ } =>
      RtpOutcomesDecided {
        bug: rtp_verdict_in(context: context, module_name: "v2.test.rtp_bug", unit: ^rtp_bug_cu),
        nontail: rtp_verdict_in(context: context, module_name: "v2.test.rtp_nontail", unit: ^rtp_nontail_cu),
        arm: rtp_verdict_in(context: context, module_name: "v2.test.rtp_arm", unit: ^rtp_arm_cu),
        guard: rtp_verdict_in(context: context, module_name: "v2.test.rtp_guard", unit: ^rtp_guard_cu),
        lambda_nontail: rtp_verdict_in(context: context, module_name: "v2.test.rtp_lambda_nontail", unit: ^rtp_lambda_nontail_cu),
        tail_ctl: rtp_verdict_in(context: context, module_name: "v2.test.rtp_tail_ctl", unit: ^rtp_tail_ctl_cu),
        let_tail_ctl: rtp_verdict_in(context: context, module_name: "v2.test.rtp_let_tail_ctl", unit: ^rtp_let_tail_ctl_cu),
        tail_und: rtp_verdict_in(context: context, module_name: "v2.test.rtp_tail_und", unit: ^rtp_tail_und_cu),
        lambda_tail_ctl: rtp_verdict_in(context: context, module_name: "v2.test.rtp_lambda_tail_ctl", unit: ^rtp_lambda_tail_ctl_cu)
      }
  }
}

fn rtp_is_resolved(v: RtpVerdict) -> Bool {
  match v {
    RtpResolved => true
    _ => false
  }
}

fn rtp_refuses_as(v: RtpVerdict, reason: Symbol) -> Bool {
  match v {
    RtpFileRefused { fatal_reason: Present { value: r } } => r == reason
    _ => false
  }
}

test fn a_return_inside_a_let_bound_if_refuses_rather_than_binding_its_operand() -> Bool {
  match rtp_outcomes() {
    RtpOutcomesDecided { bug: v, nontail: _, arm: _, guard: _, lambda_nontail: _, tail_ctl: _, let_tail_ctl: _, tail_und: _, lambda_tail_ctl: _ } => rtp_refuses_as(v: v, reason: ^body_lowering_reason_return_not_in_tail_position)
    RtpContextRefused => false
  }
}

test fn a_return_followed_by_a_statement_refuses_as_not_in_tail_position() -> Bool {
  match rtp_outcomes() {
    RtpOutcomesDecided { bug: _, nontail: v, arm: _, guard: _, lambda_nontail: _, tail_ctl: _, let_tail_ctl: _, tail_und: _, lambda_tail_ctl: _ } => rtp_refuses_as(v: v, reason: ^body_lowering_reason_return_not_in_tail_position)
    RtpContextRefused => false
  }
}

test fn a_return_in_an_if_arm_refuses_as_not_in_tail_position() -> Bool {
  match rtp_outcomes() {
    RtpOutcomesDecided { bug: _, nontail: _, arm: v, guard: _, lambda_nontail: _, tail_ctl: _, let_tail_ctl: _, tail_und: _, lambda_tail_ctl: _ } => rtp_refuses_as(v: v, reason: ^body_lowering_reason_return_not_in_tail_position)
    RtpContextRefused => false
  }
}

test fn a_return_before_another_statement_in_a_fn_value_refuses() -> Bool {
  match rtp_outcomes() {
    RtpOutcomesDecided { bug: _, nontail: _, arm: _, guard: _, lambda_nontail: v, tail_ctl: _, let_tail_ctl: _, tail_und: _, lambda_tail_ctl: _ } => rtp_refuses_as(v: v, reason: ^body_lowering_reason_return_not_in_tail_position)
    RtpContextRefused => false
  }
}

test fn an_else_less_guard_still_refuses_as_unlowered() -> Bool {
  match rtp_outcomes() {
    RtpOutcomesDecided { bug: _, nontail: _, arm: _, guard: v, lambda_nontail: _, tail_ctl: _, let_tail_ctl: _, tail_und: _, lambda_tail_ctl: _ } => rtp_refuses_as(v: v, reason: ^body_lowering_reason_else_less_if_unlowered)
    RtpContextRefused => false
  }
}

test fn a_tail_return_of_a_fn_body_is_accepted() -> Bool {
  match rtp_outcomes() {
    RtpOutcomesDecided { bug: _, nontail: _, arm: _, guard: _, lambda_nontail: _, tail_ctl: v, let_tail_ctl: _, tail_und: _, lambda_tail_ctl: _ } => rtp_is_resolved(v: v)
    RtpContextRefused => false
  }
}

test fn a_tail_return_after_a_let_is_accepted() -> Bool {
  match rtp_outcomes() {
    RtpOutcomesDecided { bug: _, nontail: _, arm: _, guard: _, lambda_nontail: _, tail_ctl: _, let_tail_ctl: v, tail_und: _, lambda_tail_ctl: _ } => rtp_is_resolved(v: v)
    RtpContextRefused => false
  }
}

test fn a_tail_return_of_a_fn_value_block_body_is_accepted() -> Bool {
  match rtp_outcomes() {
    RtpOutcomesDecided { bug: _, nontail: _, arm: _, guard: _, lambda_nontail: _, tail_ctl: _, let_tail_ctl: _, tail_und: _, lambda_tail_ctl: v } => rtp_is_resolved(v: v)
    RtpContextRefused => false
  }
}

test fn a_tail_return_operand_is_read_and_refuses_unbound_at_its_atom() -> Bool {
  match rtp_outcomes() {
    RtpOutcomesDecided { bug: _, nontail: _, arm: _, guard: _, lambda_nontail: _, tail_ctl: _, let_tail_ctl: _, tail_und: v, lambda_tail_ctl: _ } => match v {
      RtpRefused { reason: r, at_atom: Present { value: id } } => (r == ^resolve_reason_unbound_symbol) && (id == ^rtp_undeclared_tail)
      _ => false
    }
    RtpContextRefused => false
  }
}
