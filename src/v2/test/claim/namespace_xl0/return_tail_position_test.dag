// ONE FRONT END FOR EVERY CLAIM, enrolled WARM in v2.workflow.floor_pure_producer_share: the stored
// value is a verdict per module with no resolution context, Node or closure in it.
type RtpVerdict
  = RtpResolved
  | RtpRefused { reason: Symbol, at_atom: Optional<Symbol> }
  | RtpFileRefused { fatal_reason: Optional<Symbol> }
  | RtpAbsent

type RtpOutcomes
  = RtpContextRefused
  | RtpOutcomesDecided {
      bug: RtpVerdict
      nontail: RtpVerdict
      lambda_nontail: RtpVerdict
      guard_fallthrough: RtpVerdict
      guard_last: RtpVerdict
      guard_nontail: RtpVerdict
      tail_ctl: RtpVerdict
      let_tail_ctl: RtpVerdict
      lambda_tail_ctl: RtpVerdict
      tail_und: RtpVerdict
      arm_ctl: RtpVerdict
      guard_ctl: RtpVerdict
      guard_arm_und: RtpVerdict
      guard_rest_und: RtpVerdict
      match_ctl: RtpVerdict
      match_und: RtpVerdict
      match_nested_ctl: RtpVerdict
    }

fn rtp_file_refusal_reason(context: NativeTestContext, unit: Symbol) -> Optional<Symbol> {
  fold_list(
    xs: context.file_refusals,
    empty: optional_absent(),
    cons: fn(acc, refusal) {
      if refusal.path == unit { optional_present(value: refusal.fatal_reason) } else { acc }
    }
  )
}

fn rtp_verdict_of(context: NativeTestContext, unit: Symbol, outcome: NativeCensusModuleOutcome) -> RtpVerdict {
  match outcome {
    NativeCensusModuleResolved => RtpResolved
    NativeCensusModuleFileRefused =>
      RtpFileRefused { fatal_reason: rtp_file_refusal_reason(context: context, unit: unit) }
    NativeCensusModuleResolveRefused { first: d, rest: _, observation: _ } =>
      RtpRefused {
        reason: d.head.reason,
        at_atom: match d.head.at {
          NodeLocus { anchor: a } => node_atom_identity_optional(node: a.at)
          _ => optional_absent()
        }
      }
  }
}

fn rtp_verdict_in(context: NativeTestContext, module_name: String, unit: Symbol) -> RtpVerdict {
  fold_list(
    xs: native_census_modules(ingest: rtp_ingest),
    empty: RtpAbsent,
    cons: fn(acc, entry) {
      if entry.module == module_name {
        rtp_verdict_of(
          context: context,
          unit: unit,
          outcome: native_census_module_resolution(
            context: context,
            refusal_index: native_lane_file_refusal_index(refusals: context.file_refusals),
            entry: entry
          ).outcome
        )
      } else {
        acc
      }
    }
  )
}

fn rtp_outcomes() -> RtpOutcomes {
  match native_test_context_from_ingest(ingest: rtp_ingest) {
    Rejected { diagnostics: _ } => RtpContextRefused
    Accepted { value: context, diagnostics: _ } =>
      RtpOutcomesDecided {
        bug: rtp_verdict_in(context: context, module_name: "v2.test.rtp_bug", unit: ^rtp_bug_cu),
        nontail: rtp_verdict_in(context: context, module_name: "v2.test.rtp_nontail", unit: ^rtp_nontail_cu),
        lambda_nontail: rtp_verdict_in(context: context, module_name: "v2.test.rtp_lambda_nontail", unit: ^rtp_lambda_nontail_cu),
        guard_fallthrough: rtp_verdict_in(context: context, module_name: "v2.test.rtp_guard_fallthrough", unit: ^rtp_guard_fallthrough_cu),
        guard_last: rtp_verdict_in(context: context, module_name: "v2.test.rtp_guard_last", unit: ^rtp_guard_last_cu),
        guard_nontail: rtp_verdict_in(context: context, module_name: "v2.test.rtp_guard_nontail", unit: ^rtp_guard_nontail_cu),
        tail_ctl: rtp_verdict_in(context: context, module_name: "v2.test.rtp_tail_ctl", unit: ^rtp_tail_ctl_cu),
        let_tail_ctl: rtp_verdict_in(context: context, module_name: "v2.test.rtp_let_tail_ctl", unit: ^rtp_let_tail_ctl_cu),
        lambda_tail_ctl: rtp_verdict_in(context: context, module_name: "v2.test.rtp_lambda_tail_ctl", unit: ^rtp_lambda_tail_ctl_cu),
        tail_und: rtp_verdict_in(context: context, module_name: "v2.test.rtp_tail_und", unit: ^rtp_tail_und_cu),
        arm_ctl: rtp_verdict_in(context: context, module_name: "v2.test.rtp_arm_ctl", unit: ^rtp_arm_ctl_cu),
        guard_ctl: rtp_verdict_in(context: context, module_name: "v2.test.rtp_guard_ctl", unit: ^rtp_guard_ctl_cu),
        guard_arm_und: rtp_verdict_in(context: context, module_name: "v2.test.rtp_guard_arm_und", unit: ^rtp_guard_arm_und_cu),
        guard_rest_und: rtp_verdict_in(context: context, module_name: "v2.test.rtp_guard_rest_und", unit: ^rtp_guard_rest_und_cu),
        match_ctl: rtp_verdict_in(context: context, module_name: "v2.test.rtp_match_ctl", unit: ^rtp_match_ctl_cu),
        match_und: rtp_verdict_in(context: context, module_name: "v2.test.rtp_match_und", unit: ^rtp_match_und_cu),
        match_nested_ctl: rtp_verdict_in(context: context, module_name: "v2.test.rtp_match_nested_ctl", unit: ^rtp_match_nested_ctl_cu)
      }
  }
}

fn rtp_is_resolved(v: RtpVerdict) -> Bool {
  match v {
    RtpResolved => true
    _ => false
  }
}

fn rtp_refuses_as(v: RtpVerdict, reason: Symbol) -> Bool {
  match v {
    RtpFileRefused { fatal_reason: Present { value: r } } => r == reason
    _ => false
  }
}

fn rtp_unbound_at(v: RtpVerdict, atom: Symbol) -> Bool {
  match v {
    RtpRefused { reason: r, at_atom: Present { value: id } } => (r == ^resolve_reason_unbound_symbol) && (id == atom)
    _ => false
  }
}

test fn a_return_inside_a_let_bound_if_refuses_rather_than_binding_its_operand() -> Bool {
  match rtp_outcomes() {
    RtpOutcomesDecided { bug: v, nontail: _, lambda_nontail: _, guard_fallthrough: _, guard_last: _, guard_nontail: _, tail_ctl: _, let_tail_ctl: _, lambda_tail_ctl: _, tail_und: _, arm_ctl: _, guard_ctl: _, guard_arm_und: _, guard_rest_und: _, match_ctl: _, match_und: _, match_nested_ctl: _ } => rtp_refuses_as(v: v, reason: ^body_lowering_reason_return_not_in_tail_position)
    RtpContextRefused => false
  }
}

test fn a_return_followed_by_a_statement_refuses_as_not_in_tail_position() -> Bool {
  match rtp_outcomes() {
    RtpOutcomesDecided { bug: _, nontail: v, lambda_nontail: _, guard_fallthrough: _, guard_last: _, guard_nontail: _, tail_ctl: _, let_tail_ctl: _, lambda_tail_ctl: _, tail_und: _, arm_ctl: _, guard_ctl: _, guard_arm_und: _, guard_rest_und: _, match_ctl: _, match_und: _, match_nested_ctl: _ } => rtp_refuses_as(v: v, reason: ^body_lowering_reason_return_not_in_tail_position)
    RtpContextRefused => false
  }
}

test fn a_return_before_another_statement_in_a_fn_value_refuses() -> Bool {
  match rtp_outcomes() {
    RtpOutcomesDecided { bug: _, nontail: _, lambda_nontail: v, guard_fallthrough: _, guard_last: _, guard_nontail: _, tail_ctl: _, let_tail_ctl: _, lambda_tail_ctl: _, tail_und: _, arm_ctl: _, guard_ctl: _, guard_arm_und: _, guard_rest_und: _, match_ctl: _, match_und: _, match_nested_ctl: _ } => rtp_refuses_as(v: v, reason: ^body_lowering_reason_return_not_in_tail_position)
    RtpContextRefused => false
  }
}

test fn an_else_less_if_that_falls_through_still_refuses_as_unlowered() -> Bool {
  match rtp_outcomes() {
    RtpOutcomesDecided { bug: _, nontail: _, lambda_nontail: _, guard_fallthrough: v, guard_last: _, guard_nontail: _, tail_ctl: _, let_tail_ctl: _, lambda_tail_ctl: _, tail_und: _, arm_ctl: _, guard_ctl: _, guard_arm_und: _, guard_rest_und: _, match_ctl: _, match_und: _, match_nested_ctl: _ } => rtp_refuses_as(v: v, reason: ^body_lowering_reason_else_less_if_unlowered)
    RtpContextRefused => false
  }
}

test fn an_else_less_if_as_the_last_statement_still_refuses_as_unlowered() -> Bool {
  match rtp_outcomes() {
    RtpOutcomesDecided { bug: _, nontail: _, lambda_nontail: _, guard_fallthrough: _, guard_last: v, guard_nontail: _, tail_ctl: _, let_tail_ctl: _, lambda_tail_ctl: _, tail_und: _, arm_ctl: _, guard_ctl: _, guard_arm_und: _, guard_rest_und: _, match_ctl: _, match_und: _, match_nested_ctl: _ } => rtp_refuses_as(v: v, reason: ^body_lowering_reason_else_less_if_unlowered)
    RtpContextRefused => false
  }
}

test fn a_guard_in_a_non_tail_spine_still_refuses_as_unlowered() -> Bool {
  match rtp_outcomes() {
    RtpOutcomesDecided { bug: _, nontail: _, lambda_nontail: _, guard_fallthrough: _, guard_last: _, guard_nontail: v, tail_ctl: _, let_tail_ctl: _, lambda_tail_ctl: _, tail_und: _, arm_ctl: _, guard_ctl: _, guard_arm_und: _, guard_rest_und: _, match_ctl: _, match_und: _, match_nested_ctl: _ } => rtp_refuses_as(v: v, reason: ^body_lowering_reason_else_less_if_unlowered)
    RtpContextRefused => false
  }
}

test fn a_tail_return_of_a_fn_body_is_accepted() -> Bool {
  match rtp_outcomes() {
    RtpOutcomesDecided { bug: _, nontail: _, lambda_nontail: _, guard_fallthrough: _, guard_last: _, guard_nontail: _, tail_ctl: v, let_tail_ctl: _, lambda_tail_ctl: _, tail_und: _, arm_ctl: _, guard_ctl: _, guard_arm_und: _, guard_rest_und: _, match_ctl: _, match_und: _, match_nested_ctl: _ } => rtp_is_resolved(v: v)
    RtpContextRefused => false
  }
}

test fn a_tail_return_after_a_let_is_accepted() -> Bool {
  match rtp_outcomes() {
    RtpOutcomesDecided { bug: _, nontail: _, lambda_nontail: _, guard_fallthrough: _, guard_last: _, guard_nontail: _, tail_ctl: _, let_tail_ctl: v, lambda_tail_ctl: _, tail_und: _, arm_ctl: _, guard_ctl: _, guard_arm_und: _, guard_rest_und: _, match_ctl: _, match_und: _, match_nested_ctl: _ } => rtp_is_resolved(v: v)
    RtpContextRefused => false
  }
}

test fn a_tail_return_of_a_fn_value_block_body_is_accepted() -> Bool {
  match rtp_outcomes() {
    RtpOutcomesDecided { bug: _, nontail: _, lambda_nontail: _, guard_fallthrough: _, guard_last: _, guard_nontail: _, tail_ctl: _, let_tail_ctl: _, lambda_tail_ctl: v, tail_und: _, arm_ctl: _, guard_ctl: _, guard_arm_und: _, guard_rest_und: _, match_ctl: _, match_und: _, match_nested_ctl: _ } => rtp_is_resolved(v: v)
    RtpContextRefused => false
  }
}

test fn a_tail_return_operand_is_read_and_refuses_unbound_at_its_atom() -> Bool {
  match rtp_outcomes() {
    RtpOutcomesDecided { bug: _, nontail: _, lambda_nontail: _, guard_fallthrough: _, guard_last: _, guard_nontail: _, tail_ctl: _, let_tail_ctl: _, lambda_tail_ctl: _, tail_und: v, arm_ctl: _, guard_ctl: _, guard_arm_und: _, guard_rest_und: _, match_ctl: _, match_und: _, match_nested_ctl: _ } => rtp_unbound_at(v: v, atom: ^rtp_undeclared_tail)
    RtpContextRefused => false
  }
}

test fn a_return_in_an_arm_of_a_tail_if_is_accepted() -> Bool {
  match rtp_outcomes() {
    RtpOutcomesDecided { bug: _, nontail: _, lambda_nontail: _, guard_fallthrough: _, guard_last: _, guard_nontail: _, tail_ctl: _, let_tail_ctl: _, lambda_tail_ctl: _, tail_und: _, arm_ctl: v, guard_ctl: _, guard_arm_und: _, guard_rest_und: _, match_ctl: _, match_und: _, match_nested_ctl: _ } => rtp_is_resolved(v: v)
    RtpContextRefused => false
  }
}

test fn a_guard_followed_by_statements_is_accepted() -> Bool {
  match rtp_outcomes() {
    RtpOutcomesDecided { bug: _, nontail: _, lambda_nontail: _, guard_fallthrough: _, guard_last: _, guard_nontail: _, tail_ctl: _, let_tail_ctl: _, lambda_tail_ctl: _, tail_und: _, arm_ctl: _, guard_ctl: v, guard_arm_und: _, guard_rest_und: _, match_ctl: _, match_und: _, match_nested_ctl: _ } => rtp_is_resolved(v: v)
    RtpContextRefused => false
  }
}

test fn a_guard_arm_return_operand_is_read_and_refuses_unbound_at_its_atom() -> Bool {
  match rtp_outcomes() {
    RtpOutcomesDecided { bug: _, nontail: _, lambda_nontail: _, guard_fallthrough: _, guard_last: _, guard_nontail: _, tail_ctl: _, let_tail_ctl: _, lambda_tail_ctl: _, tail_und: _, arm_ctl: _, guard_ctl: _, guard_arm_und: v, guard_rest_und: _, match_ctl: _, match_und: _, match_nested_ctl: _ } => rtp_unbound_at(v: v, atom: ^rtp_undeclared_guard_arm)
    RtpContextRefused => false
  }
}

test fn the_statements_after_a_guard_are_read_and_refuse_unbound_at_their_atom() -> Bool {
  match rtp_outcomes() {
    RtpOutcomesDecided { bug: _, nontail: _, lambda_nontail: _, guard_fallthrough: _, guard_last: _, guard_nontail: _, tail_ctl: _, let_tail_ctl: _, lambda_tail_ctl: _, tail_und: _, arm_ctl: _, guard_ctl: _, guard_arm_und: _, guard_rest_und: v, match_ctl: _, match_und: _, match_nested_ctl: _ } => rtp_unbound_at(v: v, atom: ^rtp_undeclared_guard_rest)
