module v2.test.claim.namespace_xl0.cross_module_reference_resolution

import v2.compiler.name_resolve {
  Admission,
  ResolutionSubject,
  resolution_context,
  resolve_with_admission_context_policy
}
import v2.std.cross_tree.resolution { source_root_index_empty }
import v2.std.resolution_policy { default_name_resolution_policy }
import v2.compiler.normalized_tree { NormalizedTree, normalized_tree_roots_to_nodes }
import v2.compiler.program_assembly { module_roots_from_source_root_ingest }
import v2.compiler.repair_input_origin_roster {
  RepairInputOriginRoster,
  repair_input_origin_roster_is_total,
  repair_input_origin_roster_over_roots
}
import v2.compiler.source_authority { DagSourceReadWitness, SourceRootIngest }
import std.repair_input_origin {
  RenderedTargetVocabularyCarrier,
  RepairInputDeclared,
  SourceCarrierCandidate,
  SourceDeclarationCarrier
}
import v2.std.algebra { fold_list, length }
import v2.extdeps.languages.dag { dag_language_model }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.diagnostic { Accepted, NonEmptyDiagnostics, Outcome, Rejected }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.node { Atom, Node, Symbol, TypeNode, node_subtree_nodes }
import v2.std.qualified_name { qualified_name_from_dotted_string }
import v2.std.text { String, string_eq }
import std.algebra { Cons, Empty, FreeMonoid }
import extdeps.communication.medium { Lossless, Medium }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE RESOLVER'S SIDE OF THE CROSS-MODULE REFERENCE CLASS, ON THE PRODUCTION ROUTE.
//
// WHAT THIS FILE PROVES, AND NO MORE: that a source-produced, root-qualified spine reaches the
// resolver's qualified arm and is accepted by its CURRENT lookup, which is corpus-root ABSOLUTE
// (v2.compiler.resolve try_resolve_qualified_name_node, whose own header marks unique-on-chain
// UNFIRED). It does NOT establish docs/plans/namespace-resolution-design.md section 13 -- first
// segment resolved on the ancestor chain, shadowing refused, remainder projected -- nor
// local-receiver projection. Those two standings are measured by today-rows at the end of this
// file, which are their triggers (review 67513 on gunbc#11582).
//
// v2.test.claim.namespace_xl0.call_argument_mention_survival measures what the COLLECTOR sees. This
// file measures what RESOLUTION does with the same lowered shape, because the two consume one
// producer: the fold_list qualified-name spine that body lowering now constructs for a dotted chain
// (v2.compiler.body_lowering_fold body_lower_dotted_reference_optional). A spine the collector can
// read but the resolver refuses would be a denominator with no numerator, and a spine the resolver
// ACCEPTS by widening what resolves would be the fail-open arm DESIGN section 5 forbids. So the
// rows are a matched set, and the middle one is the boundary: reassembling the chain must make a
// DECLARED cross-module target resolve and must leave an UNDECLARED one refusing for its own
// reason.
//
// WHAT RESOLVES HERE IS THE SUBJECT ROOT ALONE. v2.compiler.name_resolve resolve_with_admission
// resolves the module the Admission names and consults the other ingested roots only through the
// symbol index, so three consumer modules can share ONE ingest and each claim selects its subject.
// That is what lets one warm producer serve every row: the parse-and-normalize of seven inline
// modules is the stage no row is about, and it is shared exactly as the sibling file shares its
// ingest (v2.workflow.floor_pure_producer_share); the resolve is executed per claim.
//
// THE TARGET IS A FUNCTION, DELIBERATELY. A cross-module reference to a `data` or `type`
// declaration still refuses on this route, and not because of anything in the reference: the
// declaration itself never reaches the containment tree (v2.compiler.namespace_graft rehomes a
// fn_decl under a Named edge and nothing rehomes a type_decl or data_decl -- see
// v2.test.claim.namespace_xl0.field_type_tree_presence). That is a declaration-grafting loss with
// its own trigger and is measured, not repaired, here: the row at the end of this file asserts the
// refusal so it reds -- and gets re-stated -- when grafting lands.
data xl0r_provider_source: String = "module v2.test.xl0r_provider\n\nimport v2.std.logic { Bool }\n\nfn xl0r_provided_fn(p: Bool) -> Bool { p }\n\ndata xl0r_provided_value: Bool = true\n"

data xl0r_local_consumer_source: String = "module v2.test.xl0r_local_consumer\n\nimport v2.std.logic { Bool }\n\nfn xl0r_same_module(x: Bool) -> Bool { x }\n"

data xl0r_declared_consumer_source: String = "module v2.test.xl0r_declared_consumer\n\nimport v2.std.logic { Bool }\n\nfn xl0r_uses_provided_fn() -> Bool { v2.test.xl0r_provider.xl0r_provided_fn }\n"

data xl0r_undeclared_consumer_source: String = "module v2.test.xl0r_undeclared_consumer\n\nimport v2.std.logic { Bool }\n\nfn xl0r_uses_nothing_declared() -> Bool { v2.test.xl0r_provider.xl0r_no_such_declaration }\n"

data xl0r_data_target_consumer_source: String = "module v2.test.xl0r_data_target_consumer\n\nimport v2.std.logic { Bool }\n\nfn xl0r_uses_provided_value() -> Bool { v2.test.xl0r_provider.xl0r_provided_value }\n"

data xl0r_field_access_consumer_source: String = "module v2.test.xl0r_field_access_consumer\n\nimport v2.std.logic { Bool }\n\nfn xl0r_projects(r: Bool) -> Bool { r.v }\n"

data xl0r_shadowing_consumer_source: String = "module v2.test.xl0r_shadowing_consumer\n\nimport v2.std.logic { Bool }\n\nfn xl0r_shadows(v2: Bool) -> Bool { v2.test.xl0r_provider.xl0r_provided_fn }\n"

fn xl0r_read(source: String, id: Symbol, unit: Symbol, path: String) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: source, fidelity: Lossless },
    artifact: Artifact { kind: SourceFile, id: id, file_path: path },
    compilation_unit: unit,
    source_root: DagTree
  }
}

data xl0r_ingest: SourceRootIngest = Cons {
  head: xl0r_read(
    source: xl0r_provider_source,
    id: ^xl0r_provider_read,
    unit: ^xl0r_provider_cu,
    path: "src/v2/test/fixture/namespace_xl0/resolution_provider.dag"
  ),
  tail: Cons {
    head: xl0r_read(
      source: xl0r_local_consumer_source,
      id: ^xl0r_local_consumer_read,
      unit: ^xl0r_local_consumer_cu,
      path: "src/v2/test/fixture/namespace_xl0/resolution_local_consumer.dag"
    ),
    tail: Cons {
    head: xl0r_read(
      source: xl0r_declared_consumer_source,
      id: ^xl0r_declared_consumer_read,
      unit: ^xl0r_declared_consumer_cu,
      path: "src/v2/test/fixture/namespace_xl0/resolution_declared_consumer.dag"
    ),
    tail: Cons {
      head: xl0r_read(
        source: xl0r_undeclared_consumer_source,
        id: ^xl0r_undeclared_consumer_read,
        unit: ^xl0r_undeclared_consumer_cu,
        path: "src/v2/test/fixture/namespace_xl0/resolution_undeclared_consumer.dag"
      ),
      tail: Cons {
        head: xl0r_read(
          source: xl0r_data_target_consumer_source,
          id: ^xl0r_data_target_consumer_read,
          unit: ^xl0r_data_target_consumer_cu,
          path: "src/v2/test/fixture/namespace_xl0/resolution_data_target_consumer.dag"
        ),
        tail: Cons {
          head: xl0r_read(
            source: xl0r_field_access_consumer_source,
            id: ^xl0r_field_access_consumer_read,
            unit: ^xl0r_field_access_consumer_cu,
            path: "src/v2/test/fixture/namespace_xl0/resolution_field_access_consumer.dag"
          ),
          tail: Cons {
            head: xl0r_read(
              source: xl0r_shadowing_consumer_source,
              id: ^xl0r_shadowing_consumer_read,
              unit: ^xl0r_shadowing_consumer_cu,
              path: "src/v2/test/fixture/namespace_xl0/resolution_shadowing_consumer.dag"
            ),
            tail: Empty
          }
        }
      }
    }
  }
  }
}

// Nullary, pure, inline sources, and a value that reifies to the bottom -- the same shape the
// sibling file's producer has. Enrolled WARM in v2.workflow.floor_pure_producer_share.
fn xl0r_fixture_normalized() -> Outcome<FreeMonoid<NormalizedTree>> {
  module_roots_from_source_root_ingest(ingest: xl0r_ingest, lm: dag_language_model())
}

fn xl0r_admission(subject: String) -> Admission {
  Admission {
    subject: ResolutionSubject { name: qualified_name_from_dotted_string(dotted: subject) },
    imports: Empty
  }
}

// THE SHARE POINT IS THE RESOLVED OUTCOME PER SUBJECT, AND THE ROAD HERE IS RECORDED BECAUSE THE
// NEXT AUTHOR WILL WALK IT. gunbc#11582's first floor run (35317696454) reached every verdict and
// refused on COST: each resolve row spent ~92k eval steps against the 72,300-step line for work
// arriving after the cut, with the ingest already served. The second run (35327371663) tried to
// share v2.compiler.name_resolve resolution_context and was refused
// PureProducerShareWarmNotStored: the value carries the LanguageModel, whose
// canonical_symbols.member is a CLOSURE, and the cross-claim store serves values, not functions --
// a fair refusal of a non-portable producer, not an obstacle. Measured beside it (claim_batch on
// the same file): the context is ~12k steps and resolving even a one-fn subject is ~64k, so a
// portable context would still leave every row over the line. Resolution of the smallest subject
// costs more than a new witness may spend; that is the resolver's cost profile and is not this
// file's to repair.
//
// So each subject's resolution is a NULLARY WARM PRODUCER (one per subject, enrolled in
// v2.workflow.floor_pure_producer_share beside the ingest), executed by the floor's preparation --
// the real path, run once, refused loudly there if it cannot run -- and the rows below read the
// Outcome<Node> it produced. This is the shape v2.compiler.self_host.direct_rust_door_fixture
// direct_rust_door_specimen_resolved already inhabits for a resolved specimen. The values are
// Nodes and located diagnostics, portable to the bottom.
fn xl0r_resolve_subject(subject: String) -> Outcome<Node> {
  match xl0r_fixture_normalized() {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: roots, diagnostics: _ } =>
      resolve_with_admission_context_policy(
        context: resolution_context(lm: dag_language_model(), roots: roots),
        admission: xl0r_admission(subject: subject),
        index: source_root_index_empty(),
        active_roots: Empty,
        policy: default_name_resolution_policy()
      )
  }
}

fn xl0r_resolved_local_consumer() -> Outcome<Node> {
  xl0r_resolve_subject(subject: "v2.test.xl0r_local_consumer")
}

fn xl0r_resolved_declared_consumer() -> Outcome<Node> {
  xl0r_resolve_subject(subject: "v2.test.xl0r_declared_consumer")
}

fn xl0r_resolved_undeclared_consumer() -> Outcome<Node> {
  xl0r_resolve_subject(subject: "v2.test.xl0r_undeclared_consumer")
}

fn xl0r_resolved_data_target_consumer() -> Outcome<Node> {
  xl0r_resolve_subject(subject: "v2.test.xl0r_data_target_consumer")
}

fn xl0r_resolved_field_access_consumer() -> Outcome<Node> {
  xl0r_resolve_subject(subject: "v2.test.xl0r_field_access_consumer")
}

fn xl0r_resolved_shadowing_consumer() -> Outcome<Node> {
  xl0r_resolve_subject(subject: "v2.test.xl0r_shadowing_consumer")
}

fn xl0r_resolved_atom_present(root: Node, identity: Symbol) -> Bool {
  fold(node_subtree_nodes(root: root), init: false, f: fn(acc, n) {
    acc || (match n.kind {
      TypeNode { connective: Atom { identity: sym } } => sym == identity
      _ => false
    })
  })
}

// The FINAL refusal is the one the resolver raised, behind whatever pending parse-stage residue the
// pipeline carries forward (rejected_with_pending prepends the pending rows, so `head` is not it).
fn xl0r_last_reason(d: NonEmptyDiagnostics) -> Symbol {
  fold(d.tail, init: d.head.reason, f: fn(acc, x) { x.reason })
}

test fn the_resolution_fixture_ingests_holds() -> Bool {
  match xl0r_fixture_normalized() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

// THE CONTROL: a module whose only reference is same-module resolves, so a red on the row after it
// is about the cross-module chain and not about this route being dead. It is its own module so
// that the primary's verdict cannot leak into it.
test fn a_same_module_reference_resolves_on_the_production_route_holds() -> Bool {
  match xl0r_resolved_local_consumer() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

// THE PRIMARY: a cross-module dotted reference to a DECLARED function resolves, and the resolved
// body carries the declaration's own name as its canonical identity. Before the lowering repair
// this module refused with resolve_reason_unbound_symbol on the bare `v2` the infix arm left behind;
// before the resolver's fallback repair it was Accepted carrying `resolve_reason_unbound_symbol` AS
// THE IDENTITY, which the second conjunct is here to keep unwritable.
test fn a_cross_module_reference_to_a_declared_fn_resolves_holds() -> Bool {
  match xl0r_resolved_declared_consumer() {
    Accepted { value: resolved, diagnostics: _ } =>
      xl0r_resolved_atom_present(root: resolved, identity: ^xl0r_provided_fn)
        && !xl0r_resolved_atom_present(root: resolved, identity: ^resolve_reason_unbound_symbol)
    Rejected { diagnostics: _ } => false
  }
}

// THE BOUNDARY: the same chain shape naming a declaration that does not exist refuses, at resolve,
// with the unbound-symbol reason -- reassembling the chain widened nothing.
test fn a_cross_module_reference_to_an_undeclared_name_refuses_unbound() -> Bool {
  match xl0r_resolved_undeclared_consumer() {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => xl0r_last_reason(d: d) == ^resolve_reason_unbound_symbol
  }
}

// MEASURED, NOT REPAIRED: a cross-module reference to a DATA declaration refuses today, because the
// data declaration is not grafted into the containment tree. This reds when declaration grafting
// lands, and must then be re-stated as resolving.
test fn a_cross_module_reference_to_a_data_declaration_refuses_today() -> Bool {
  match xl0r_resolved_data_target_consumer() {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => xl0r_last_reason(d: d) == ^resolve_reason_unbound_symbol
  }
}

// THE LOCAL-RECEIVER CLASS, MEASURED AND NOT CLAIMED (review 67513 on gunbc#11582).
//
// `r.v` over a parameter lowers to the same spine as a module path -- that is deliberate, and the
// lowering's header says why. What the RESOLVER does with it today is a separate fact, and it is
// not the unique-on-chain projection docs/plans/namespace-resolution-design.md section 13 rules:
// try_resolve_qualified_name_node still sends the path to symbol_index_lookup as corpus-root
// absolute (its own header calls that arm UNFIRED), so a local field access refuses as an
// absolute-path miss. It refused BEFORE this lowering too, for a different wrong reason: the
// infix arm lowered `r.v` to Transform(dot, r, v) and the bare `v` was unbound at resolve. Same
// verdict, same reason symbol, neither the honest "field projection unresolved". So this is not a
// rung drop -- refuse-for-the-wrong-reason before, refuse-for-the-wrong-reason after -- and it is
// enrolled as a today-row so the day the projection arm lands, this reds and gets re-stated as
// resolving. What this row rules out is the silent arm: a local field access must not be Accepted.
test fn a_local_field_access_refuses_unbound_today() -> Bool {
  match xl0r_resolved_field_access_consumer() {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => xl0r_last_reason(d: d) == ^resolve_reason_unbound_symbol
  }
}

// THE COLLISION THE ABSOLUTE-PATH ARM ADMITS, MEASURED SO IT IS COUNTED RATHER THAN DISCOVERED.
// A parameter named like a root segment (`v2`) and a body chain starting with it: section 13 says
// shadowing REFUSES at the reference site; the unfired arm instead resolves the whole chain as an
// absolute path and Accepts, ignoring the binder on the chain. Before this lowering the same body
// lowered to Transform(dot, v2, test) and refused (`test` unbound) -- a refusal for the wrong
// reason that happened to be the safe verdict. This row states the standing the arm actually has
// today, and reds when unique-on-chain lands, which is the trigger it names.
test fn a_binder_shadowing_a_root_segment_is_not_yet_refused_today() -> Bool {
  match xl0r_resolved_shadowing_consumer() {
    Accepted { value: resolved, diagnostics: _ } =>
      xl0r_resolved_atom_present(root: resolved, identity: ^xl0r_provided_fn)
    Rejected { diagnostics: _ } => false
  }
}

// XL-0'S OWN PRODUCER, EXECUTED ON THE PRODUCTION ROUTE. The rows above exercise the collector
// and the resolver beside v2.compiler.repair_input_origin_roster; these execute
// repair_input_origin_roster_over_roots itself over the same normalized roots and ask what a
// denominator owes: is it TOTAL (no unreadable root), and does it carry the cross-module mention
// as a SourceDeclarationCarrier whose provenance is RepairInputDeclared -- answered by the
// resolver, not merely mentioned. Pinning a base is ACT-0's act and is not claimed here; this is
// the delivery half, over a fixture.
fn xl0r_roster() -> RepairInputOriginRoster {
  match xl0r_fixture_normalized() {
    Accepted { value: roots, diagnostics: _ } =>
      repair_input_origin_roster_over_roots(roots: normalized_tree_roots_to_nodes(roots: roots))
    Rejected { diagnostics: _ } =>
      RepairInputOriginRoster { carriers: Empty, unreadable_roots: Empty }
  }
}

fn xl0r_roster_has_declared_carrier(roster: RepairInputOriginRoster, spelling: String) -> Bool {
  fold_list(
    xs: roster.carriers,
    empty: false,
    cons: fn(acc, c) {
      acc || (match c {
        SourceDeclarationCarrier { identity: id } =>
          string_eq(a: id.authored_spelling, b: spelling)
            && (match id.provenance {
              RepairInputDeclared { declaring: _ } => true
              _ => false
            })
        SourceCarrierCandidate { identity: _ } => false
        RenderedTargetVocabularyCarrier { identity: _ } => false
      })
    }
  )
}

test fn the_repair_input_origin_roster_is_total_and_non_empty_on_the_production_route_holds() -> Bool {
  let roster = xl0r_roster()
  repair_input_origin_roster_is_total(roster: roster) && length(xs: roster.carriers) > 0
}

test fn the_repair_input_origin_roster_carries_the_declared_cross_module_mention_holds() -> Bool {
  xl0r_roster_has_declared_carrier(
    roster: xl0r_roster(),
    spelling: "v2.test.xl0r_provider.xl0r_provided_fn"
  )
}
