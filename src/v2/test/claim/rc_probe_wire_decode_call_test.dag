module v2.test.claim.rc_probe_wire_decode_call

import extdeps.filesystem.filesystem_io
import v2.std.logic { Bool }

type FilesystemReadResult { content: String }

data target_model_path: String = "src/v2/std/compilers/target_model.dag"

data rc_probe_wire_decode_call_provenance: String = "Floor witness migrated from src/v1/tests/src/rc_probe_wire_decode_call_test.rs (1 v1 #[test] fn): SG-RC probe must call target_type_expr_emitted_wire_decode with (node:, projection:) in target_model.dag:target_reference_layer_probe_from_emitted_type, and must not regress to the misnamed emitted: kwarg (ctrl#1476 B3-Gap2)."

fn target_model_live_content() -> String {
  let result = filesystem_read(path: target_model_path)
  result.content
}

test fn probe_wire_decode_call_uses_node_and_projection_args() -> Bool {
  let live = target_model_live_content()
  string_contains(
    s: live,
    pattern: "target_type_expr_emitted_wire_decode(node: emitted, projection: projection)"
  ) && !string_contains(
    s: live,
    pattern: "target_type_expr_emitted_wire_decode(emitted:"
  )
}
