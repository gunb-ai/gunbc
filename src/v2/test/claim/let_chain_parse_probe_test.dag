module v2.test.claim.let_chain_parse_probe

import v2.compiler.source_authority { parse_dag_source_ast, DagSourceAst, semantic_ir_from_source, DagSemanticIr }
import extdeps.communication.medium { Medium }
import extdeps.filesystem.filesystem_io
import v2.std.diagnostic {
  Outcome,
  Accepted,
  Rejected,
  Diagnostic,
  NonEmptyDiagnostics,
}
import v2.std.logic { Bool }

// A module whose function body is a real let-chain:
//   let x = foo();  let y = bar(x);   x + y
// expressed in the dag surface (let stmt-seq form, no `in`).
data let_chain_module_source: String = "module probe.sample\nfn compute() -> Int {\n  let x = foo(a: 1)\n  let y = bar(b: x)\n  x + y\n}\n"

fn wrap(s: String) -> Medium<String> {
  Medium { carried: s }
}

fn outcome_is_accepted(o: Outcome<DagSourceAst>) -> Bool {
  match o {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

// PROBE 1: parse the inline multi-let body module.
func let_chain_inline_parses_accepted() -> Bool {
  outcome_is_accepted(o: parse_dag_source_ast(source: wrap(s: let_chain_module_source)))
}

// PROBE 2: parse a real on-disk .dag file that itself contains let-chains.
func real_file_with_let_chain_parses_accepted() -> Bool {
  let result = filesystem_read(path: "dsl/test/claim/filesystem_read_hermetic_witness.dag")
  outcome_is_accepted(o: parse_dag_source_ast(source: wrap(s: result.content)))
}

// Discriminators: isolate which surface feature the wave1 grammar rejects.

// 2a: `func` keyword instead of `fn`.
data src_func_kw: String = "module probe\nfunc compute() -> Int {\n  let x = foo(a: 1)\n  x\n}\n"
func disc_func_keyword() -> Bool {
  outcome_is_accepted(o: parse_dag_source_ast(source: wrap(s: src_func_kw)))
}

// 2b: `return` statement in body.
data src_return: String = "module probe\nfn compute() -> Int {\n  let x = foo(a: 1)\n  return x\n}\n"
func disc_return_stmt() -> Bool {
  outcome_is_accepted(o: parse_dag_source_ast(source: wrap(s: src_return)))
}

// 2c: single let-chain ending in a call expr (mirrors the real file body, but fn/no-return).
data src_single_let_call: String = "module probe\nfn compute() -> Bool {\n  let result = filesystem_read(path: \"x\")\n  string_contains(result.content, \"y\")\n}\n"
func disc_single_let_call() -> Bool {
  outcome_is_accepted(o: parse_dag_source_ast(source: wrap(s: src_single_let_call)))
}

// 2e: match expression in a let-chain body.
data src_match: String = "module probe\nfn compute(o: Foo) -> Int {\n  let x = match o {\n    A => 1\n    B => 2\n  }\n  x\n}\n"
func disc_match_expr() -> Bool {
  outcome_is_accepted(o: parse_dag_source_ast(source: wrap(s: src_match)))
}

// 2f: binary operators chained in body.
data src_binops: String = "module probe\nfn compute() -> Int {\n  let a = 1\n  let b = 2\n  a + b * a - b\n}\n"
func disc_binops() -> Bool {
  outcome_is_accepted(o: parse_dag_source_ast(source: wrap(s: src_binops)))
}

// END-TO-END: full parse -> normalize -> resolve on the multi-let body.
fn ir_is_accepted(o: Outcome<DagSemanticIr>) -> Bool {
  match o {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}
data src_resolvable_let_chain: String = "module probe\nfn compute() -> Int {\n  let x = 1\n  let y = 2\n  x + y\n}\n"
func let_chain_resolves_to_semantic_ir() -> Bool {
  ir_is_accepted(o: semantic_ir_from_source(source: wrap(s: src_resolvable_let_chain)))
}

// 2d: exact real-file content but s/func/fn/ and drop `return`.
data src_realish: String = "module probe\nimport extdeps.filesystem.filesystem_io\nfn witness() -> Bool {\n  let result = filesystem_read(path: \"dsl/std/filesystem.dag\")\n  string_contains(result.content, \"module std.filesystem\")\n}\n"
func disc_realish() -> Bool {
  outcome_is_accepted(o: parse_dag_source_ast(source: wrap(s: src_realish)))
}
