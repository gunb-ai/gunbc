module v2.test.claim.sql_create_table_fold

import v2.extdeps.formats.sql {
  SqlColumnConstraints,
  SqlColumnDefaultAbsent,
  SqlColumnDefinition,
  SqlDropTable,
  SqlRegularIdentifier,
  SqlSchemaOperation,
  SqlTypeCharacterLargeObject,
  SqlTypeNumeric,
  sql_serialize_data_type,
  sql_serialize_schema_operation
}
import v2.std.cardinality { NonZeroNat }
import v2.std.nat { Zero }
import v2.extdeps.formats.sql_create_table_fold {
  sql_fold_operation_emitted_witness,
  sql_fold_relation_row_witness,
  sql_fold_schema_operation_bundle_witness,
  sql_fold_target_model_for_operation_witness,
  sql_fold_tasks_pk_table,
  sql_fold_tasks_single_col_table,
  sql_fold_tasks_two_col_table,
  sql_fold_column_list_uses_recursive_list_production_witness
}
import v2.compiler.emit { emit }
import v2.compiler.infer { InferredFacts, InferredTree }
import v2.compiler.translate { target_serialize_source_from_model }
import v2.std.compilers.target_model { TargetModel }
import v2.std.collection {
  Map
}
import v2.std.optional {
  Optional,
  Present,
  Absent,
  optional_present,
  optional_absent
}
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Some,
  Unavailable,
  node_locus
}
import v2.std.logic { Bool }
import v2.std.node { Conj, Node, SyntheticOccurrence, TypeNode }
import v2.std.witness { Holds, Violates, Witness }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn sql_fold_facts_lookup(key: Node) -> Optional<InferredFacts> {
  optional_absent()
}

fn sql_fold_fold_serialize(
  op: SqlSchemaOperation,
  target: TargetModel
) -> Outcome<String> {
  match sql_fold_operation_emitted_witness(op: op) {
    Holds { value: emitted } =>
      let tree = InferredTree {
        root: emitted,
        facts: Map { lookup: sql_fold_facts_lookup }
      }
      match emit(tree: tree, target: target) {
        Accepted { value: source, diagnostics: d } =>
          match d {
            None => Accepted { value: source.carried, diagnostics: None }
            Some { diagnostics: r } => Rejected { diagnostics: r }
          }
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    Violates { diagnostic: d } => Rejected { diagnostics: Some { diagnostics: [d] } }
  }
}

fn sql_fold_fold_serialize_operation(op: SqlSchemaOperation) -> Outcome<String> {
  match sql_fold_target_model_for_operation_witness(op: op) {
    Holds { value: target } =>
      sql_fold_fold_serialize(op: op, target: target)
    Violates { diagnostic: d } =>
      Rejected { diagnostics: Some { diagnostics: [d] } }
  }
}

fn sql_fold_fold_matches_oracle(op: SqlSchemaOperation) -> Bool {
  match sql_fold_fold_serialize_operation(op: op) {
    Accepted { value: folded, diagnostics: _ } =>
      match sql_serialize_schema_operation(op: op) {
        Accepted { value: oracle, diagnostics: od } =>
          (folded == oracle) && (od == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn sql_fold_single_col_operation() -> SqlSchemaOperation {
  SqlCreateTable { table: sql_fold_tasks_single_col_table }
}

fn sql_fold_two_col_operation() -> SqlSchemaOperation {
  SqlCreateTable { table: sql_fold_tasks_two_col_table }
}

fn sql_fold_pk_operation() -> SqlSchemaOperation {
  SqlCreateTable { table: sql_fold_tasks_pk_table }
}

fn sql_fold_relation_row_single_col_witness_holds() -> Bool {
  let op = sql_fold_single_col_operation()
  match sql_fold_schema_operation_bundle_witness(op: op) {
    Holds { value: bundle } =>
      match sql_fold_relation_row_witness(
        emitted: bundle.emitted,
        lhs: bundle.production_binding
      ) {
        Holds { value: _ } => true
        Violates { diagnostic: _ } => false
      }
    Violates { diagnostic: _ } => false
  }
}

fn sql_fold_create_table_single_col_holds() -> Bool {
  sql_fold_fold_matches_oracle(op: sql_fold_single_col_operation())
}

fn sql_fold_create_table_two_col_holds() -> Bool {
  sql_fold_fold_matches_oracle(op: sql_fold_two_col_operation())
}

fn sql_fold_create_table_with_pk_holds() -> Bool {
  sql_fold_fold_matches_oracle(op: sql_fold_pk_operation())
}

fn sql_fold_direct_serialize_matches_oracle(
  op: SqlSchemaOperation,
  target: TargetModel
) -> Bool {
  match sql_fold_operation_emitted_witness(op: op) {
    Holds { value: emitted } =>
      match target_serialize_source_from_model(target: target, emitted: emitted) {
        Accepted { value: source, diagnostics: d } =>
          match sql_serialize_schema_operation(op: op) {
            Accepted { value: oracle, diagnostics: od } =>
              (source.carried == oracle) && (d == None) && (od == None)
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Violates { diagnostic: _ } => false
  }
}

fn sql_fold_direct_serialize_single_col_holds() -> Bool {
  let op = sql_fold_single_col_operation()
  match sql_fold_target_model_for_operation_witness(op: op) {
    Holds { value: target } =>
      sql_fold_direct_serialize_matches_oracle(op: op, target: target)
    Violates { diagnostic: _ } => false
  }
}

fn sql_fold_wrong_production_rejects_oracle_holds() -> Bool {
  let op = sql_fold_single_col_operation()
  match sql_fold_schema_operation_bundle_witness(op: op) {
    Holds { value: bundle } =>
      match sql_fold_relation_row_witness(
        emitted: bundle.emitted,
        lhs: ^sql_production_fold_create_table_pk
      ) {
        Holds { value: _ } => false
        Violates { diagnostic: _ } => true
      }
    Violates { diagnostic: _ } => false
  }
}

fn sql_fold_emitted_tree_differs_on_two_col_fixture_holds() -> Bool {
  match sql_fold_operation_emitted_witness(op: sql_fold_single_col_operation()) {
    Holds { value: single } =>
      match sql_fold_operation_emitted_witness(op: sql_fold_two_col_operation()) {
        Holds { value: two } => single != two
        Violates { diagnostic: _ } => false
      }
    Violates { diagnostic: _ } => false
  }
}

fn sql_fold_oracle_rejects_unsupported_drop_table_holds() -> Bool {
  match sql_serialize_schema_operation(
    op: SqlDropTable { table_name: SqlRegularIdentifier { name: "t" } }
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

fn sql_fold_oracle_rejects_parameterized_numeric_type_holds() -> Bool {
  match sql_serialize_data_type(
    dt: SqlTypeNumeric {
      precision: NonZeroNat { prev: Zero },
      scale: Zero
    }
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

fn sql_fold_two_col_uses_recursive_list_production_holds() -> Bool {
  match sql_fold_column_list_uses_recursive_list_production_witness(
    cols: sql_fold_tasks_two_col_table.columns
  ) {
    Holds { value: true } => true
    Holds { value: false } => false
    Violates { diagnostic: _ } => false
  }
}

fn sql_fold_single_col_uses_leaf_list_production_holds() -> Bool {
  match sql_fold_column_list_uses_recursive_list_production_witness(
    cols: sql_fold_tasks_single_col_table.columns
  ) {
    Holds { value: false } => true
    Holds { value: true } => false
    Violates { diagnostic: _ } => false
  }
}

test fn sql_fold_structural_tier_holds() -> Bool {
  sql_fold_relation_row_single_col_witness_holds()
  && sql_fold_emitted_tree_differs_on_two_col_fixture_holds()
  && sql_fold_wrong_production_rejects_oracle_holds()
  && sql_fold_oracle_rejects_unsupported_drop_table_holds()
  && sql_fold_oracle_rejects_parameterized_numeric_type_holds()
  && sql_fold_two_col_uses_recursive_list_production_holds()
  && sql_fold_single_col_uses_leaf_list_production_holds()
}

test fn sql_fold_create_table_tier_holds() -> Bool {
  sql_fold_create_table_single_col_holds()
  && sql_fold_create_table_two_col_holds()
  && sql_fold_create_table_with_pk_holds()
}

test fn sql_fold_direct_serialize_tier_holds() -> Bool {
  sql_fold_direct_serialize_single_col_holds()
}
