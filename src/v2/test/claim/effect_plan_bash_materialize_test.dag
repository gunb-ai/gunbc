module v2.test.claim.effect_plan_bash_materialize_test

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.ReadsLiveTree

data effect_plan_bash_materialize_test_note: String = "Model-only Wave A executable model surface. These witnesses read real extdeps operation declarations, encode actual Bash grammar Nodes, and emit those Nodes through the grammar serializer. No production workflow imports the materializer. The poison cases live only here and discriminate every refusal arm requested by the charter."

fn operation_ref(path: String, service: String, operation: String) -> v2.std.operation_argv.OperationRef {
  v2.std.operation_argv.OperationRef {
    path: path,
    service: service,
    operation: operation
  }
}

fn invocation(
  path: String,
  service: String,
  operation: String,
  bindings: List<v2.std.operation_argv.OperationInputBinding>
) -> v2.workflow.effect_plan_bash_materialize.BashBoundOperationInvocation {
  v2.workflow.effect_plan_bash_materialize.bash_bind_operation_invocation(
    at: operation_ref(path: path, service: service, operation: operation),
    bindings: bindings
  )
}

fn id_invocation(operation: String) -> v2.workflow.effect_plan_bash_materialize.BashBoundOperationInvocation {
  invocation(
    path: "dag/extdeps/tools/id.dag",
    service: "os.Id",
    operation: operation,
    bindings: []
  )
}

fn test_path_invocation(operation: String, path: String) -> v2.workflow.effect_plan_bash_materialize.BashBoundOperationInvocation {
  invocation(
    path: "dag/extdeps/shell.dag",
    service: "shell.Test",
    operation: operation,
    bindings: [v2.std.operation_argv.operation_argv_bind_text(name: "path", text: path)]
  )
}

fn show_property_invocation(bindings: List<v2.std.operation_argv.OperationInputBinding>) -> v2.workflow.effect_plan_bash_materialize.BashBoundOperationInvocation {
  invocation(
    path: "dag/extdeps/systemd/systemctl.dag",
    service: "systemd.Systemctl",
    operation: "ShowProperty",
    bindings: bindings
  )
}

fn fail_fast_plan(steps: List<v2.std.effect_plan.EffectPlanStep<v2.workflow.effect_plan_bash_materialize.BashBoundOperationInvocation>>) -> v2.std.effect_plan.EffectPlan<v2.workflow.effect_plan_bash_materialize.BashBoundOperationInvocation> {
  v2.std.effect_plan.EffectPlan { steps: steps, on_failure: v2.std.orchestration.FailFast }
}

fn one_step_plan(inv: v2.workflow.effect_plan_bash_materialize.BashBoundOperationInvocation) -> v2.std.effect_plan.EffectPlan<v2.workflow.effect_plan_bash_materialize.BashBoundOperationInvocation> {
  fail_fast_plan(steps: [v2.std.effect_plan.Do { effect: inv }])
}

fn emitted_source_is(
  plan: v2.std.effect_plan.EffectPlan<v2.workflow.effect_plan_bash_materialize.BashBoundOperationInvocation>,
  expected: String
) -> Bool {
  match v2.workflow.effect_plan_bash_materialize.effect_plan_bash_materialize(plan: plan) {
    EffectPlanBashMaterialized { source: source } => source == expected
    EffectPlanBashMaterializationRefused { refusal: _ } => false
  }
}

fn emitted_sources_differ(
  left: v2.std.effect_plan.EffectPlan<v2.workflow.effect_plan_bash_materialize.BashBoundOperationInvocation>,
  right: v2.std.effect_plan.EffectPlan<v2.workflow.effect_plan_bash_materialize.BashBoundOperationInvocation>
) -> Bool {
  match v2.workflow.effect_plan_bash_materialize.effect_plan_bash_materialize(plan: left) {
    EffectPlanBashMaterialized { source: left_source } =>
      match v2.workflow.effect_plan_bash_materialize.effect_plan_bash_materialize(plan: right) {
        EffectPlanBashMaterialized { source: right_source } =>
          left_source != right_source
        EffectPlanBashMaterializationRefused { refusal: _ } => false
      }
    EffectPlanBashMaterializationRefused { refusal: _ } => false
  }
}

fn operation_locus_is(
  locus: v2.std.optional.Optional<v2.std.operation_argv.OperationRef>,
  path: String,
  service: String,
  operation: String
) -> Bool {
  match locus {
    Present { value: at } =>
      at.path == path && at.service == service && at.operation == operation
    Absent => false
  }
}

test fn effect_plan_bash_two_declared_operations_encode_and_emit_through_carrier() -> Bool {
  let plan = fail_fast_plan(
    steps: [
      v2.std.effect_plan.Do { effect: test_path_invocation(operation: "IsExecutable", path: "/bin/sh") },
      v2.std.effect_plan.Do { effect: id_invocation(operation: "Uid") }
    ]
  )
  let encoded = match v2.workflow.effect_plan_bash_materialize.effect_plan_bash_encode(plan: plan) {
    EffectPlanBashEncodingAccepted {
      encoding: v2.workflow.effect_plan_bash_materialize.EffectPlanBashEncoded { statement: _ }
    } => true
    _ => false
  }
  encoded && emitted_source_is(
    plan: plan,
    expected: "'test' '-x' '/bin/sh' && 'id' '-u'"
  )
}

test fn effect_plan_bash_host_env_executable_replaces_declaration_literal_argv0() -> Bool {
  let plan = one_step_plan(
    inv: v2.workflow.effect_plan_bash_materialize.bash_bind_operation_invocation_host_env_executable(
      at: operation_ref(
        path: "dag/extdeps/rust/cargo_build.dag",
        service: "cargo.Build",
        operation: "Check"
      ),
      bindings: [
        v2.std.operation_argv.operation_argv_bind_text_list(
          name: "extra_args",
          items: ["-p", "v1-compiler-tests", "--tests"]
        )
      ],
      env_var: "CARGO_BIN"
    )
  )
  emitted_source_is(
    plan: plan,
    expected: "\"$CARGO_BIN\" 'check' '-p' 'v1-compiler-tests' '--tests'"
  )
}

test fn effect_plan_bash_operation_and_input_perturbations_change_emitted_bytes() -> Bool {
  let uid = one_step_plan(inv: id_invocation(operation: "Uid"))
  let gid = one_step_plan(inv: id_invocation(operation: "Gid"))
  let different_ref = one_step_plan(inv: test_path_invocation(operation: "IsExecutable", path: "/bin/sh"))
  let active = one_step_plan(inv: show_property_invocation(bindings: [
    v2.std.operation_argv.operation_argv_bind_text(name: "unit", text: "gunbc.service"),
    v2.std.operation_argv.operation_argv_bind_text(name: "property", text: "ActiveState")
  ]))
  let sub = one_step_plan(inv: show_property_invocation(bindings: [
    v2.std.operation_argv.operation_argv_bind_text(name: "unit", text: "gunbc.service"),
    v2.std.operation_argv.operation_argv_bind_text(name: "property", text: "SubState")
  ]))
  emitted_source_is(plan: uid, expected: "'id' '-u'")
    && emitted_source_is(plan: gid, expected: "'id' '-g'")
    && emitted_sources_differ(left: uid, right: gid)
    && emitted_sources_differ(left: uid, right: different_ref)
    && emitted_sources_differ(left: active, right: sub)
    && emitted_source_is(
      plan: active,
      expected: "'systemctl' 'show' 'gunbc.service' '--property=ActiveState' '--value'"
    )
    && emitted_source_is(
      plan: sub,
      expected: "'systemctl' 'show' 'gunbc.service' '--property=SubState' '--value'"
    )
}

test fn effect_plan_bash_metacharacters_and_newline_remain_one_quoted_word() -> Bool {
  let metachar = one_step_plan(inv: test_path_invocation(
    operation: "IsFile",
    path: "/tmp/a;$(printf PWN)*'tail"
  ))
  let newline = one_step_plan(inv: test_path_invocation(
    operation: "IsFile",
    path: "/tmp/line-one\nline-two"
  ))
  emitted_source_is(
    plan: metachar,
    expected: "'test' '-f' '/tmp/a;$(printf PWN)*'\\''tail'"
  )
    && emitted_source_is(
      plan: newline,
      expected: "'test' '-f' '/tmp/line-one\nline-two'"
    )
}

data unicode_escape_nul_witness_note: String = "This is also the CI-enforcing receipt for the language's Unicode escape: keep the production guard pattern authored with the Unicode escape while constructing the poison input independently with from_code_point(0). If the tokenizer regresses to passthrough, the pattern becomes printable text, no longer matches this real NUL, and this witness reds. Rewriting the guard pattern to from_code_point would make both sides share a constructor and remove this discrimination."

test fn effect_plan_bash_RED_nul_is_located_and_refused() -> Bool {
  let nul = from_code_point(cp: 0)
  let third_argument = v2.workflow.effect_plan_bash_materialize.effect_plan_bash_materialize(plan: one_step_plan(inv: test_path_invocation(
    operation: "IsFile",
    path: concat("/tmp/a", concat(nul, "b"))
  )))
  let second_argument = v2.workflow.effect_plan_bash_materialize.effect_plan_bash_materialize(plan: one_step_plan(inv: invocation(
    path: "dag/extdeps/tools/id.dag",
    service: "os.Id",
    operation: "Lookup",
    bindings: [v2.std.operation_argv.operation_argv_bind_text(name: "user", text: concat("a", concat(nul, "b")))]
  )))
  let third_holds = match third_argument {
    EffectPlanBashMaterializationRefused { refusal: refusal } =>
      refusal.step_index == 0
        && operation_locus_is(
          locus: refusal.operation,
          path: "dag/extdeps/shell.dag",
          service: "shell.Test",
          operation: "IsFile"
        )
        && match refusal.cause {
          ArgumentContainsNul { argument_index: index } => index == 2
          _ => false
        }
    _ => false
  }
  let second_holds = match second_argument {
    EffectPlanBashMaterializationRefused { refusal: refusal } =>
      refusal.step_index == 0
        && operation_locus_is(
          locus: refusal.operation,
          path: "dag/extdeps/tools/id.dag",
          service: "os.Id",
          operation: "Lookup"
        )
        && match refusal.cause {
          ArgumentContainsNul { argument_index: index } => index == 1
          _ => false
        }
    _ => false
  }
  let literal_escape_text_is_not_nul = match v2.workflow.effect_plan_bash_materialize.effect_plan_bash_materialize(
    plan: one_step_plan(inv: test_path_invocation(
      operation: "IsFile",
      path: "/tmp/a\\u{0000}b"
    ))
  ) {
    EffectPlanBashMaterialized { source: _ } => true
    _ => false
  }
  third_holds && second_holds && literal_escape_text_is_not_nul
}

test fn effect_plan_bash_RED_missing_operation_is_typed_and_located() -> Bool {
  match v2.workflow.effect_plan_bash_materialize.effect_plan_bash_materialize(plan: one_step_plan(inv: invocation(
    path: "dag/extdeps/tools/id.dag",
    service: "os.Id",
    operation: "Missing",
    bindings: []
  ))) {
    EffectPlanBashMaterializationRefused { refusal: refusal } =>
      refusal.step_index == 0
        && operation_locus_is(
          locus: refusal.operation,
          path: "dag/extdeps/tools/id.dag",
          service: "os.Id",
          operation: "Missing"
        )
        && match refusal.cause {
          OperationArgvRefused { cause: v2.std.operation_argv.OperationNotFound } => true
          _ => false
        }
    _ => false
  }
}

test fn effect_plan_bash_RED_reference_perturbation_refuses_instead_of_falling_back() -> Bool {
  match v2.workflow.effect_plan_bash_materialize.effect_plan_bash_materialize(plan: one_step_plan(inv: invocation(
    path: "dag/extdeps/tools/id.dag",
    service: "os.WrongId",
    operation: "Uid",
    bindings: []
  ))) {
    EffectPlanBashMaterializationRefused { refusal: refusal } =>
      refusal.step_index == 0
        && operation_locus_is(
          locus: refusal.operation,
          path: "dag/extdeps/tools/id.dag",
          service: "os.WrongId",
          operation: "Uid"
        )
        && match refusal.cause {
          OperationArgvRefused { cause: v2.std.operation_argv.OperationNotFound } => true
          _ => false
        }
    _ => false
  }
}

test fn effect_plan_bash_RED_undeclared_duplicate_and_unbound_inputs_discriminate() -> Bool {
  let undeclared = v2.workflow.effect_plan_bash_materialize.effect_plan_bash_materialize(plan: one_step_plan(inv: show_property_invocation(bindings: [
    v2.std.operation_argv.operation_argv_bind_text(name: "unit", text: "gunbc.service"),
    v2.std.operation_argv.operation_argv_bind_text(name: "property", text: "ActiveState"),
    v2.std.operation_argv.operation_argv_bind_text(name: "bin", text: "sh")
  ])))
  let duplicate = v2.workflow.effect_plan_bash_materialize.effect_plan_bash_materialize(plan: one_step_plan(inv: show_property_invocation(bindings: [
    v2.std.operation_argv.operation_argv_bind_text(name: "unit", text: "gunbc.service"),
    v2.std.operation_argv.operation_argv_bind_text(name: "unit", text: "other.service"),
    v2.std.operation_argv.operation_argv_bind_text(name: "property", text: "ActiveState")
  ])))
  let unbound = v2.workflow.effect_plan_bash_materialize.effect_plan_bash_materialize(plan: one_step_plan(inv: show_property_invocation(bindings: [
    v2.std.operation_argv.operation_argv_bind_text(name: "unit", text: "gunbc.service")
  ])))
  let undeclared_holds = match undeclared {
    EffectPlanBashMaterializationRefused { refusal: refusal } =>
      refusal.step_index == 0
        && operation_locus_is(
          locus: refusal.operation,
          path: "dag/extdeps/systemd/systemctl.dag",
          service: "systemd.Systemctl",
          operation: "ShowProperty"
        )
        && match refusal.cause {
          OperationArgvRefused { cause: v2.std.operation_argv.UndeclaredInputBound { name: name } } => name == "bin"
          _ => false
        }
    _ => false
  }
  let duplicate_holds = match duplicate {
    EffectPlanBashMaterializationRefused { refusal: refusal } =>
      refusal.step_index == 0
        && operation_locus_is(
          locus: refusal.operation,
          path: "dag/extdeps/systemd/systemctl.dag",
          service: "systemd.Systemctl",
          operation: "ShowProperty"
        )
        && match refusal.cause {
          OperationArgvRefused { cause: v2.std.operation_argv.DuplicateInputBinding { name: name } } => name == "unit"
          _ => false
        }
    _ => false
  }
  let unbound_holds = match unbound {
    EffectPlanBashMaterializationRefused { refusal: refusal } =>
      refusal.step_index == 0
        && operation_locus_is(
          locus: refusal.operation,
          path: "dag/extdeps/systemd/systemctl.dag",
          service: "systemd.Systemctl",
          operation: "ShowProperty"
        )
        && match refusal.cause {
          OperationArgvRefused { cause: v2.std.operation_argv.DeclaredInputUnbound { name: name } } => name == "property"
          _ => false
        }
    _ => false
  }
  undeclared_holds && duplicate_holds && unbound_holds
}

test fn effect_plan_bash_RED_unsupported_argv_expression_preserves_operation_locus() -> Bool {
  let plan = one_step_plan(inv: invocation(
    path: "dag/extdeps/git/git.dag",
    service: "git.Core",
    operation: "DiffUnified0",
    bindings: [
      v2.std.operation_argv.operation_argv_bind_text(name: "base", text: "origin/main"),
      v2.std.operation_argv.operation_argv_bind_text(name: "head", text: "HEAD"),
      v2.std.operation_argv.operation_argv_bind_text(name: "range", text: "MergeBase")
    ]
  ))
  match v2.workflow.effect_plan_bash_materialize.effect_plan_bash_materialize(plan: plan) {
    EffectPlanBashMaterializationRefused { refusal: refusal } =>
      refusal.step_index == 0
        && operation_locus_is(
          locus: refusal.operation,
          path: "dag/extdeps/git/git.dag",
          service: "git.Core",
          operation: "DiffUnified0"
        )
        && match refusal.cause {
          OperationArgvRefused {
            cause: v2.std.operation_argv.ArgvExpressionUnsupported { detail: _ }
          } => true
          _ => false
        }
    _ => false
  }
}

test fn effect_plan_bash_RED_continue_policy_is_typed_before_any_step() -> Bool {
  match v2.workflow.effect_plan_bash_materialize.effect_plan_bash_materialize(plan: v2.std.effect_plan.EffectPlan {
    steps: [v2.std.effect_plan.Do { effect: id_invocation(operation: "Uid") }],
    on_failure: v2.std.orchestration.Continue
  }) {
    EffectPlanBashMaterializationRefused { refusal: refusal } =>
      refusal.step_index == -1
        && refusal.operation == v2.std.optional.Absent
        && match refusal.cause {
          UnsupportedFailurePolicy { policy: v2.std.orchestration.Continue } => true
          _ => false
        }
    _ => false
  }
}

fn empty_plan() -> v2.std.effect_plan.EffectPlan<v2.workflow.effect_plan_bash_materialize.BashBoundOperationInvocation> {
  fail_fast_plan(steps: [])
}

fn unsupported_step_refuses(
  step: v2.std.effect_plan.EffectPlanStep<v2.workflow.effect_plan_bash_materialize.BashBoundOperationInvocation>,
  expected: v2.workflow.effect_plan_bash_materialize.EffectPlanBashUnsupportedStep
) -> Bool {
  match v2.workflow.effect_plan_bash_materialize.effect_plan_bash_materialize(plan: fail_fast_plan(steps: [step])) {
    EffectPlanBashMaterializationRefused { refusal: refusal } =>
      refusal.step_index == 0
        && refusal.operation == v2.std.optional.Absent
        && match refusal.cause {
          UnsupportedEffectPlanStep { kind: actual } => actual == expected
          _ => false
        }
    _ => false
  }
}

test fn effect_plan_bash_RED_every_unsupported_step_arm_is_typed() -> Bool {
  let predicate = v2.std.orchestration.StrEq { lhs: "a", rhs: "a" }
  unsupported_step_refuses(
    step: v2.std.effect_plan.If { cond: predicate, then_: empty_plan(), else_: v2.std.optional.Absent },
    expected: v2.workflow.effect_plan_bash_materialize.UnsupportedIf
  )
    && unsupported_step_refuses(
      step: v2.std.effect_plan.For { binder: ^item, over: v2.std.orchestration.ModeledList { items: Empty }, body: empty_plan() },
      expected: v2.workflow.effect_plan_bash_materialize.UnsupportedFor
    )
    && unsupported_step_refuses(
      step: v2.std.effect_plan.While { cond: predicate, body: empty_plan() },
      expected: v2.workflow.effect_plan_bash_materialize.UnsupportedWhile
    )
    && unsupported_step_refuses(
      step: v2.std.effect_plan.Retry { body: empty_plan(), escalations: Empty, on_exhausted: empty_plan() },
      expected: v2.workflow.effect_plan_bash_materialize.UnsupportedRetry
    )
    && unsupported_step_refuses(
      step: v2.std.effect_plan.Let { name: "x", value: v2.std.orchestration.ExprLit { spelling: "x" } },
      expected: v2.workflow.effect_plan_bash_materialize.UnsupportedLet
    )
    && unsupported_step_refuses(
      step: v2.std.effect_plan.Call { callee: "x", args: [] },
      expected: v2.workflow.effect_plan_bash_materialize.UnsupportedCall
    )
}

test fn effect_plan_bash_empty_fail_fast_plan_is_total() -> Bool {
  emitted_source_is(plan: empty_plan(), expected: "")
}
