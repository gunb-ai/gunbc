module v2.test.claim.parse_engine_hooks_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn parse_engine_hooks_symbols_match_grammar_productions() -> Bool {
  (v2.compiler.parse_engine_hooks.parse_engine_match_arm_body_production == ^dag_production_match_arm_body)
    && (v2.compiler.parse_engine_hooks.parse_engine_match_arm_stmt_body_production == ^dag_production_match_arm_stmt_body)
    && (v2.compiler.parse_engine_hooks.parse_engine_expr_production == ^dag_production_expr)
}
