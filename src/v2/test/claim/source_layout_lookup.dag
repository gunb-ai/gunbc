module v2.test.claim.source_layout_lookup

import std.types { Bool, List }
import std.coercion { unicode_scalar_fold }
import v2.std.text { String }
import std.algebra { for_all, length, list_map }
import v2.std.cross_tree.import_model { DagTree, V2Tree }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.compiler.module_header { ModuleHeaderAbsent, ModuleHeaderDeclared, ModuleHeaderReader, ModuleHeaderRefused, module_header_reader }
import v2.compiler.parse { PreparedVoidGrammar }
import v2.compiler.program_assembly { dag_prepared_grammar, dag_prepared_lex }
import v2.std.diagnostic { Accepted, Rejected }
import v2.compiler.source_authority {
  LayoutFileHeader,
  LayoutHolds,
  LayoutRefusal,
  LayoutRefused,
  DeclaredModuleUnderivable,
  DuplicateModule,
  FileNotNamed,
  ModuleFileAbsent,
  ModuleFileDerived,
  ModuleFilePresent,
  ModuleFileRef,
  ModuleFileRefused,
  ModuleHeaderUnreadable,
  ModuleLineMissing,
  ModuleNameUnderivable,
  NamespaceRowWithoutModules,
  NotAtRulePosition,
  ReferenceCrossTreeDenied,
  ReferenceModuleHeaderRefused,
  ReferenceModuleLineDisagrees,
  ReferenceModuleLineMissing,
  ReferenceRefused,
  ReferenceResolved,
  ReferenceUnknownModule,
  SourceStorageLayout,
  StorageNamespaceRoot,
  UndeclaredNamespace,
  layout_check,
  layout_refusal_text,
  layout_verdict_holds,
  layout_verdict_text,
  module_file,
  module_file_key,
  reference_prefixes,
  resolve_reference_over
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// WITNESSES FOR THE GENERIC STORAGE LOOKUP AND LAYOUT CHECK (gunbc.plans.source_layout_authority).
// Both are folds over SUPPLIED observations -- a probe per candidate file, a header per
// enumerated file -- so each control states the shape the host would hand the fold and asserts the
// fold's decision; nothing here walks a tree. The pairing obligation (DESIGN 3, a witness
// discriminates at one interface) is carried by the native layout-check and parse-all verbs, which
// run the same folds over the real repository on `witnesses`: deleting that integration would not
// fail THIS file, which is why it names no repository path.
//
// Every refusal control pins the KIND of the one refusal it expects, not a count: a count of one
// is satisfied by any refusal, and a fold that refused for the wrong reason would pass it.

fn layout() -> SourceStorageLayout {
  SourceStorageLayout {
    namespace_roots: [StorageNamespaceRoot { namespace: "v2", tree: V2Tree {}, elides_namespace: true }],
    default_tree: DagTree {},
    derived_rosters: []
  }
}

// The reader the acquirer's lookup takes (v2.compiler.module_acquisition acquisition_header_reader),
// over the prepared lexer and grammar every claim shares (v2.compiler.program_assembly
// dag_prepared_lex, dag_prepared_grammar). A grammar that does not prepare reads as void, which
// refuses every header, so no control below can pass over a reader that read nothing.
fn header_reader() -> ModuleHeaderReader {
  module_header_reader(
    lex: dag_prepared_lex(),
    grammar: match dag_prepared_grammar() {
      Accepted { value: prepared, diagnostics: _ } => prepared
      Rejected { diagnostics: _ } => PreparedVoidGrammar
    }
  )
}

fn dag_file(path: String) -> ModuleFileRef {
  ModuleFileRef { tree: DagTree {}, relative_path: path }
}

fn v2_file(path: String) -> ModuleFileRef {
  ModuleFileRef { tree: V2Tree {}, relative_path: path }
}

// ---- lookup by name ------------------------------------------------------------------------------

test fn lookup_candidates_are_the_prefixes_longest_first() -> Bool {
  reference_prefixes(reference: "a.b.c") == ["a.b.c", "a.b", "a"]
}

// `a.b.c.d` is read longest prefix first: a.b.c.d (Absent), then a.b.c (Present) wins, and a.b is
// never consulted for the answer even though it is also present.
test fn lookup_longest_present_prefix_wins() -> Bool {
  match resolve_reference_over(reader: header_reader(), layout: layout(), from_tree: DagTree {}, from_module: "m", reference: "a.b.c.d", observed: [
    ModuleFileAbsent { file: dag_file(path: "a/b/c/d.dag") },
    ModuleFilePresent { file: dag_file(path: "a/b.dag"), content: "module a.b\n" },
    ModuleFilePresent { file: dag_file(path: "a/b/c.dag"), content: "module a.b.c\n" }
  ]) {
    ReferenceResolved { module: named, member: member, file: _, content: _ } => named == "a.b.c" && member == "d"
    ReferenceUnknownModule { reference: _ } => false
    ReferenceRefused { module: _, file: _, cause: _ } => false
    ReferenceModuleHeaderRefused { module: _, file: _, cause: _ } => false
    ReferenceModuleLineMissing { module: _, file: _ } => false
    ReferenceModuleLineDisagrees { module: _, declared: _, file: _ } => false
    ReferenceCrossTreeDenied { module: _, file: _, reason: _ } => false
  }
}

test fn lookup_absent_prefix_falls_back_to_the_shorter_one() -> Bool {
  match resolve_reference_over(reader: header_reader(), layout: layout(), from_tree: DagTree {}, from_module: "m", reference: "a.b.c.d", observed: [
    ModuleFileAbsent { file: dag_file(path: "a/b/c/d.dag") },
    ModuleFileAbsent { file: dag_file(path: "a/b/c.dag") },
    ModuleFilePresent { file: dag_file(path: "a/b.dag"), content: "module a.b\n" }
  ]) {
    ReferenceResolved { module: named, member: member, file: _, content: _ } => named == "a.b" && member == "c.d"
    ReferenceUnknownModule { reference: _ } => false
    ReferenceRefused { module: _, file: _, cause: _ } => false
    ReferenceModuleHeaderRefused { module: _, file: _, cause: _ } => false
    ReferenceModuleLineMissing { module: _, file: _ } => false
    ReferenceModuleLineDisagrees { module: _, declared: _, file: _ } => false
    ReferenceCrossTreeDenied { module: _, file: _, reason: _ } => false
  }
}

// A refused read at a longer prefix ends the lookup: falling back to the shorter prefix would
// answer a question the host could not ask, which is the widening DESIGN 5 forbids.
test fn lookup_refused_read_refuses_instead_of_falling_back() -> Bool {
  match resolve_reference_over(reader: header_reader(), layout: layout(), from_tree: DagTree {}, from_module: "m", reference: "a.b.c.d", observed: [
    ModuleFileAbsent { file: dag_file(path: "a/b/c/d.dag") },
    ModuleFileRefused { file: dag_file(path: "a/b/c.dag"), cause: "unreadable" },
    ModuleFilePresent { file: dag_file(path: "a/b.dag"), content: "module a.b\n" }
  ]) {
    ReferenceRefused { module: named, file: _, cause: cause } => named == "a.b.c" && cause == "unreadable"
    ReferenceResolved { module: _, member: _, file: _, content: _ } => false
    ReferenceUnknownModule { reference: _ } => false
    ReferenceModuleHeaderRefused { module: _, file: _, cause: _ } => false
    ReferenceModuleLineMissing { module: _, file: _ } => false
    ReferenceModuleLineDisagrees { module: _, declared: _, file: _ } => false
    ReferenceCrossTreeDenied { module: _, file: _, reason: _ } => false
  }
}

test fn lookup_no_present_file_is_an_unknown_module() -> Bool {
  match resolve_reference_over(reader: header_reader(), layout: layout(), from_tree: DagTree {}, from_module: "m", reference: "a.b.c", observed: [
    ModuleFileAbsent { file: dag_file(path: "a/b/c.dag") },
    ModuleFileAbsent { file: dag_file(path: "a/b.dag") },
    ModuleFileAbsent { file: dag_file(path: "a.dag") }
  ]) {
    ReferenceUnknownModule { reference: unresolved } => unresolved == "a.b.c"
    ReferenceResolved { module: _, member: _, file: _, content: _ } => false
    ReferenceRefused { module: _, file: _, cause: _ } => false
    ReferenceModuleHeaderRefused { module: _, file: _, cause: _ } => false
    ReferenceModuleLineMissing { module: _, file: _ } => false
    ReferenceModuleLineDisagrees { module: _, declared: _, file: _ } => false
    ReferenceCrossTreeDenied { module: _, file: _, reason: _ } => false
  }
}

// The file's own `module` line is the authority for which module it is: a file at the rule
// position that declares a different module is a layout defect and refuses, naming both.
test fn lookup_module_line_disagreeing_with_the_request_refuses() -> Bool {
  match resolve_reference_over(reader: header_reader(), layout: layout(), from_tree: DagTree {}, from_module: "m", reference: "a.b", observed: [
    ModuleFilePresent { file: dag_file(path: "a/b.dag"), content: "// c\nmodule a.other\n" }
  ]) {
    ReferenceModuleLineDisagrees { module: named, declared: declared, file: _ } => named == "a.b" && declared == "a.other"
    ReferenceResolved { module: _, member: _, file: _, content: _ } => false
    ReferenceUnknownModule { reference: _ } => false
    ReferenceRefused { module: _, file: _, cause: _ } => false
    ReferenceModuleHeaderRefused { module: _, file: _, cause: _ } => false
    ReferenceModuleLineMissing { module: _, file: _ } => false
    ReferenceCrossTreeDenied { module: _, file: _, reason: _ } => false
  }
}

// WHAT THE LOOKUP TAKES FROM A FILE'S HEADER (v2.compiler.module_header). The header is read by the real
// lexer and the grammar's module_header production over the start of the file's tokens, so every
// control below pins the KIND the lookup answers and, for an agreement, the name it carries.
fn lookup_kind_of(content: String) -> String {
  match resolve_reference_over(reader: header_reader(), layout: layout(), from_tree: DagTree {}, from_module: "m", reference: "a.b", observed: [
    ModuleFilePresent { file: dag_file(path: "a/b.dag"), content: content }
  ]) {
    ReferenceResolved { module: named, member: _, file: _, content: _ } => concat("resolved:", named)
    ReferenceModuleLineDisagrees { module: _, declared: declared, file: _ } => concat("disagrees:", declared)
    ReferenceModuleLineMissing { module: _, file: _ } => "missing"
    ReferenceModuleHeaderRefused { module: _, file: _, cause: _ } => "header-refused"
    ReferenceUnknownModule { reference: _ } => "unknown"
    ReferenceRefused { module: _, file: _, cause: _ } => "refused"
    ReferenceCrossTreeDenied { module: _, file: _, reason: _ } => "denied"
  }
}

// A file with no token at all declares nothing: the lookup says there is no module line. A file whose
// first token is not a header is a different fact, and is not mistaken for a missing one.
test fn lookup_file_without_a_module_line_refuses() -> Bool {
  lookup_kind_of(content: "") == "missing"
    && lookup_kind_of(content: "// only prose\n\n") == "missing"
    && lookup_kind_of(content: "\n  \n\t\n") == "missing"
}

test fn lookup_file_whose_first_declaration_is_not_a_header_refuses_with_the_parse_cause() -> Bool {
  lookup_kind_of(content: "no header here\n") == "header-refused"
    && lookup_kind_of(content: "fn f() -> Bool { true }\n") == "header-refused"
}

// ACCEPTED SPELLINGS. Whitespace between the tokens, the line terminator and an annotation beside the
// header are the lexer's to classify, so each reads as the header it is; the positive control is the
// plain spelling. A trailing annotation never reaches the grammar (it is not a semantic token), and
// neither do the comment lines around the header.
test fn lookup_reads_a_header_however_the_lexer_spells_its_trivia() -> Bool {
  lookup_kind_of(content: "module a.b\n") == "resolved:a.b"
    && lookup_kind_of(content: "module   a.b   \n") == "resolved:a.b"
    && lookup_kind_of(content: "module\ta.b\n") == "resolved:a.b"
    && lookup_kind_of(content: "module \t a.b\t\n") == "resolved:a.b"
    && lookup_kind_of(content: "module a.b\r\n") == "resolved:a.b"
    && lookup_kind_of(content: "// lead\r\n\r\nmodule a.b\r\nfn f() -> Bool { true }\r\n") == "resolved:a.b"
    && lookup_kind_of(content: "module a.b // trailing note\nfn f() -> Bool { true }\n") == "resolved:a.b"
    && lookup_kind_of(content: "// above\nmodule a.b\n// below\n// below again\nfn f() -> Bool { true }\n") == "resolved:a.b"
}

// A GENUINE MISMATCH IS STILL REFUSED, and by the name the file declares: the answer carries the parsed
// identity, so the refusal names both modules.
test fn lookup_refuses_a_header_that_declares_another_module() -> Bool {
  lookup_kind_of(content: "// c\nmodule a.other\n") == "disagrees:a.other"
    && lookup_kind_of(content: "module a.b.c\n") == "disagrees:a.b.c"
    && lookup_kind_of(content: "module a\n") == "disagrees:a"
    && lookup_kind_of(content: "module\ta.other // note\n") == "disagrees:a.other"
}

// A LATER `module` IS NOT THE HEADER. The header is the first thing the file says, so a comment, a string
// or a declaration further down that spells `module a.b` is never reached: the first control declares
// another module and the requested name appears only in a later comment and string; the others have no
// header at all and a later line that reads like one.
test fn lookup_never_reads_a_later_string_or_comment_as_the_header() -> Bool {
  lookup_kind_of(content: "module a.other\n// module a.b\ndata s: String = \"module a.b\"\n") == "disagrees:a.other"
    && lookup_kind_of(content: "// module a.b\nfn f() -> Bool { true }\n") == "header-refused"
    && lookup_kind_of(content: "data s: String = \"module a.b\"\n") == "header-refused"
    && lookup_kind_of(content: "fn f() -> Bool { true }\nmodule a.b\n") == "header-refused"
}

// A NAME THAT DOES NOT BEGIN AS A PATH IS REFUSED, and a header's extent is the grammar's: the production
// reads across line breaks and stops where its path stops, so a header that continues on a later line, or
// shares its line with the first declaration, is read as it parses -- the spellings an earlier line-bounded
// reading refused although the grammar accepts them. (v2.test.claim.module_header holds the reading's own
// controls, including its agreement with the full module parse.)
test fn lookup_refuses_a_name_that_does_not_begin_a_path() -> Bool {
  lookup_kind_of(content: "module .a.b\n") == "header-refused"
    && lookup_kind_of(content: "module\n") == "header-refused"
}

test fn lookup_reads_a_header_across_lines_and_beside_a_declaration() -> Bool {
  lookup_kind_of(content: "module\na.b\n") == "resolved:a.b"
    && lookup_kind_of(content: "module a.b fn f() -> Bool { true }\n") == "resolved:a.b"
    && lookup_kind_of(content: "module\na.other\nfn f() -> Bool { true }\n") == "disagrees:a.other"
}

// THE LAW: header agreement accepts exactly when the parsed module identity equals the requested one.
// Each case states the module a reader sees in the text (authored here, not derived by the reader under
// test; an empty name is a file that declares none), and the lookup of `a.b` over it must resolve exactly
// for the cases that name `a.b`, disagree with the authored name otherwise, and never resolve a file that
// declares none.
type HeaderCase {
  content: String
  authored: String
}

data header_cases: List<HeaderCase> = [
  HeaderCase { content: "module a.b\n", authored: "a.b" },
  HeaderCase { content: "module\ta.b\n", authored: "a.b" },
  HeaderCase { content: "module a.b // a.c\n", authored: "a.b" },
  HeaderCase { content: "// a.c\r\nmodule a.b\r\n", authored: "a.b" },
  HeaderCase { content: "module a.c\n// module a.b\n", authored: "a.c" },
  HeaderCase { content: "module a.b.c\n", authored: "a.b.c" },
  HeaderCase { content: "module a\n", authored: "a" },
  HeaderCase { content: "// module a.b\n", authored: "" },
  HeaderCase { content: "data s: String = \"module a.b\"\n", authored: "" },
  HeaderCase { content: "module\na.b\n", authored: "a.b" },
  HeaderCase { content: "module a.b fn f() -> Bool { true }\n", authored: "a.b" },
  HeaderCase { content: "module .a\n", authored: "" }
]

fn case_agrees_with_the_lookup(case: HeaderCase) -> Bool {
  if case.authored == "a.b" {
    lookup_kind_of(content: case.content) == "resolved:a.b"
  } else if case.authored == "" {
    lookup_kind_of(content: case.content) == "missing" || lookup_kind_of(content: case.content) == "header-refused"
  } else {
    lookup_kind_of(content: case.content) == concat("disagrees:", case.authored)
  }
}

test fn header_agreement_accepts_exactly_when_the_parsed_identity_is_the_requested_one() -> Bool {
  length(xs: header_cases) > 5 && for_all(xs: header_cases, predicate: fn(case) { case_agrees_with_the_lookup(case: case) })
}

// The tree direction survives the lookup: a dag-tree module resolving a name that lives in the v2
// tree is denied through the same storage verdict the import graph uses (DESIGN 4,
// tree_fundamentality_order), and the denial is decided from the candidate's name and tree BEFORE
// any file is read -- so no observation is supplied, and a regression that probed first and
// denied afterwards would still be answered here by the module it names.
test fn lookup_dag_to_v2_reference_is_denied_before_any_read() -> Bool {
  match resolve_reference_over(reader: header_reader(), layout: layout(), from_tree: DagTree {}, from_module: "m", reference: "v2.std.text.String", observed: []) {
    ReferenceCrossTreeDenied { module: named, file: file, reason: _ } =>
      named == "v2.std.text.String" && file.relative_path == "std/text/String.dag"
    ReferenceResolved { module: _, member: _, file: _, content: _ } => false
    ReferenceUnknownModule { reference: _ } => false
    ReferenceRefused { module: _, file: _, cause: _ } => false
    ReferenceModuleHeaderRefused { module: _, file: _, cause: _ } => false
    ReferenceModuleLineMissing { module: _, file: _ } => false
    ReferenceModuleLineDisagrees { module: _, declared: _, file: _ } => false
  }
}

test fn lookup_v2_to_dag_reference_is_admitted() -> Bool {
  match resolve_reference_over(reader: header_reader(), layout: layout(), from_tree: V2Tree {}, from_module: "v2.m", reference: "a.b.f", observed: [
    ModuleFilePresent { file: dag_file(path: "a/b.dag"), content: "module a.b\n" }
  ]) {
    ReferenceResolved { module: named, member: member, file: _, content: _ } => named == "a.b" && member == "f"
    ReferenceCrossTreeDenied { module: _, file: _, reason: _ } => false
    ReferenceUnknownModule { reference: _ } => false
    ReferenceRefused { module: _, file: _, cause: _ } => false
    ReferenceModuleHeaderRefused { module: _, file: _, cause: _ } => false
    ReferenceModuleLineMissing { module: _, file: _ } => false
    ReferenceModuleLineDisagrees { module: _, declared: _, file: _ } => false
  }
}

// A namespace that is elided from its tree's paths has no file of its own: the bare name `v2` is
// skipped as a candidate rather than read as `src/v2/.dag`, so the lookup ends unknown.
test fn lookup_elided_namespace_alone_is_not_a_candidate() -> Bool {
  match resolve_reference_over(reader: header_reader(), layout: layout(), from_tree: V2Tree {}, from_module: "v2.m", reference: "v2.zzz", observed: [
    ModuleFileAbsent { file: v2_file(path: "zzz.dag") }
  ]) {
    ReferenceUnknownModule { reference: unresolved } => unresolved == "v2.zzz"
    ReferenceResolved { module: _, member: _, file: _, content: _ } => false
    ReferenceCrossTreeDenied { module: _, file: _, reason: _ } => false
    ReferenceRefused { module: _, file: _, cause: _ } => false
    ReferenceModuleHeaderRefused { module: _, file: _, cause: _ } => false
    ReferenceModuleLineMissing { module: _, file: _ } => false
    ReferenceModuleLineDisagrees { module: _, declared: _, file: _ } => false
  }
}

// ---- layout check --------------------------------------------------------------------------------

fn header(file: ModuleFileRef, declared: String) -> LayoutFileHeader {
  LayoutFileHeader { file: file, declared: ModuleHeaderDeclared { module: declared } }
}

fn good_headers() -> List<LayoutFileHeader> {
  [
    header(file: dag_file(path: "a/b/c.dag"), declared: "a.b.c"),
    header(file: dag_file(path: "a/b/d.dag"), declared: "a.b.d"),
    header(file: v2_file(path: "std/text.dag"), declared: "v2.std.text")
  ]
}

fn good_namespaces() -> List<String> {
  ["a.b", "v2.std"]
}

fn refusal_kind(refusal: LayoutRefusal) -> String {
  match refusal {
    UndeclaredNamespace { file: _, namespace: _ } => "undeclared-namespace"
    NamespaceRowWithoutModules { namespace: _ } => "namespace-row-without-modules"
    NotAtRulePosition { file: _, declared: _, expected: _ } => "not-at-rule-position"
    DeclaredModuleUnderivable { file: _, declared: _, cause: _ } => "declared-module-underivable"
    FileNotNamed { file: _, cause: _ } => "file-not-named"
    ModuleLineMissing { file: _ } => "module-line-missing"
    ModuleHeaderUnreadable { file: _, cause: _ } => "module-header-unreadable"
    DuplicateModule { module: _, files: _ } => "duplicate-module"
  }
}

// The kinds of the check's refusals, in order; empty when the layout holds.
fn refusal_kinds(
  namespaces: List<String>,
  headers: List<LayoutFileHeader>
) -> List<String> {
  match layout_check(layout: layout(), namespaces: namespaces, headers: headers) {
    LayoutHolds => []
    LayoutRefused { refusals: refusals } => list_map(xs: refusals, f: fn(refusal) { refusal_kind(refusal: refusal) })
  }
}

// The positive control: every discriminating red below differs from this input in exactly one
// fact, so a refusal there is attributable to that fact.
test fn layout_check_holds_on_a_placed_population() -> Bool {
  refusal_kinds(namespaces: good_namespaces(), headers: good_headers()) == []
}

// A file whose namespace has no row: the rows are the written-down namespace roster, and a module
// in a namespace nobody declared is a new directory born without a decision.
test fn layout_check_refuses_a_namespace_without_a_row() -> Bool {
  refusal_kinds(namespaces: ["a.b"], headers: good_headers()) == ["undeclared-namespace"]
}

// The converse: a row that no file occupies is a stale row, not a harmless extra.
test fn layout_check_refuses_a_row_no_module_occupies() -> Bool {
  refusal_kinds(namespaces: ["a.b", "v2.std", "q.r"], headers: good_headers()) == ["namespace-row-without-modules"]
}

// A file whose `module` line names another module than its position implies: the position is the
// rule, the line is the claim, and a disagreement is neither's authority.
test fn layout_check_refuses_a_module_line_that_disagrees_with_the_position() -> Bool {
  refusal_kinds(namespaces: good_namespaces(), headers: [
    header(file: dag_file(path: "a/b/c.dag"), declared: "a.b.zzz"),
    header(file: dag_file(path: "a/b/d.dag"), declared: "a.b.d"),
    header(file: v2_file(path: "std/text.dag"), declared: "v2.std.text")
  ]) == ["not-at-rule-position"]
}

test fn layout_check_refuses_a_file_without_a_module_line() -> Bool {
  refusal_kinds(namespaces: good_namespaces(), headers: [
    LayoutFileHeader { file: dag_file(path: "a/b/c.dag"), declared: ModuleHeaderAbsent },
    header(file: dag_file(path: "a/b/d.dag"), declared: "a.b.d"),
    header(file: v2_file(path: "std/text.dag"), declared: "v2.std.text")
  ]) == ["module-line-missing"]
}

// A header the reader refuses is its own refusal, located on the file and carrying the parse's cause: it
// is neither a missing module line nor a name, so no name enters the placement or the duplicate join.
test fn layout_check_refuses_a_file_whose_header_does_not_parse() -> Bool {
  refusal_kinds(namespaces: good_namespaces(), headers: [
    LayoutFileHeader { file: dag_file(path: "a/b/c.dag"), declared: ModuleHeaderRefused { cause: "fixture cause" } },
    header(file: dag_file(path: "a/b/d.dag"), declared: "a.b.d"),
    header(file: v2_file(path: "std/text.dag"), declared: "v2.std.text")
  ]) == ["module-header-unreadable"]
}

// Two modules differing only by ASCII case collide on a case-insensitive filesystem; the check
// groups by the case fold so the collision is refused here, not discovered on a developer's laptop.
test fn layout_check_refuses_modules_that_collide_under_case_folding() -> Bool {
  refusal_kinds(namespaces: good_namespaces(), headers: [
    header(file: dag_file(path: "a/b/c.dag"), declared: "a.b.c"),
    header(file: dag_file(path: "a/b/C.dag"), declared: "a.b.C"),
    header(file: v2_file(path: "std/text.dag"), declared: "v2.std.text")
  ]) == ["duplicate-module"]
}

// A v2 module placed in the dag tree is one misplacement: its namespace is declared and occupied,
// so nothing else fires, and the refusal names the rule position the file should hold.
test fn layout_check_refuses_a_v2_module_in_the_dag_tree() -> Bool {
  refusal_kinds(namespaces: ["a.b", "v2.std"], headers: [
    header(file: dag_file(path: "a/b/c.dag"), declared: "a.b.c"),
    header(file: dag_file(path: "v2/std/text.dag"), declared: "v2.std.text")
  ]) == ["not-at-rule-position"]
}

// The refusal carries the position the rule derives, not only a kind.
test fn layout_check_names_the_rule_position_of_a_misplaced_module() -> Bool {
  match layout_check(layout: layout(), namespaces: ["a.b", "v2.std"], headers: [
    header(file: dag_file(path: "a/b/c.dag"), declared: "a.b.c"),
    header(file: dag_file(path: "v2/std/text.dag"), declared: "v2.std.text")
  ]) {
    LayoutHolds => false
    LayoutRefused { refusals: refusals } => refusals |> any(fn(refusal) { is_misplacement_of_text(refusal: refusal) })
  }
}

fn is_misplacement_of_text(refusal: LayoutRefusal) -> Bool {
  match refusal {
    NotAtRulePosition { file: file, declared: declared, expected: expected } =>
      declared == "v2.std.text" && expected.relative_path == "std/text.dag" && file.relative_path == "v2/std/text.dag"
    UndeclaredNamespace { file: _, namespace: _ } => false
    NamespaceRowWithoutModules { namespace: _ } => false
    DeclaredModuleUnderivable { file: _, declared: _, cause: _ } => false
    FileNotNamed { file: _, cause: _ } => false
    ModuleLineMissing { file: _ } => false
    ModuleHeaderUnreadable { file: _, cause: _ } => false
    DuplicateModule { module: _, files: _ } => false
  }
}

// ---- the order a duplicate's evidence is reported in ----------------------------------------------------
//
// The grouping behind the duplicate refusal is built newest-first and restored once, so the report is
// the same one a grouping that appended would give: duplicate keys in the order their first member
// appears, and the files of each in the order the headers listed them. The controls interleave two
// colliding pairs so that an order restored the wrong way round, or a grouping that flattened the
// pairs together, reports a different line.

fn duplicate_files_text(refusal: LayoutRefusal) -> String {
  match refusal {
    DuplicateModule { module: module, files: files } =>
      concat(module, "=", join(list_map(xs: files, f: fn(file) { module_file_key(file: file) }), ","))
    UndeclaredNamespace { file: _, namespace: _ } => "other"
    NamespaceRowWithoutModules { namespace: _ } => "other"
    NotAtRulePosition { file: _, declared: _, expected: _ } => "other"
    DeclaredModuleUnderivable { file: _, declared: _, cause: _ } => "other"
    FileNotNamed { file: _, cause: _ } => "other"
    ModuleLineMissing { file: _ } => "other"
    ModuleHeaderUnreadable { file: _, cause: _ } => "other"
  }
}

fn colliding_pairs() -> List<LayoutFileHeader> {
  [
    header(file: dag_file(path: "a/b/c.dag"), declared: "a.b.c"),
    header(file: dag_file(path: "a/b/d.dag"), declared: "a.b.d"),
    header(file: dag_file(path: "a/b/C.dag"), declared: "a.b.C"),
    header(file: dag_file(path: "a/b/D.dag"), declared: "a.b.D")
  ]
}

test fn colliding_modules_are_reported_in_first_appearance_order_with_their_files_in_header_order() -> Bool {
  match layout_check(layout: layout(), namespaces: ["a.b"], headers: colliding_pairs()) {
    LayoutHolds => false
    LayoutRefused { refusals: refusals } =>
      join(list_map(xs: refusals, f: fn(refusal) { duplicate_files_text(refusal: refusal) }), ";")
        == "a.b.c=dag:a/b/c.dag,dag:a/b/C.dag;a.b.d=dag:a/b/d.dag,dag:a/b/D.dag"
  }
}

// ---- the report a refusal is read from -----------------------------------------------------------------
//
// One line per refusal, each starting with the located file or namespace, so the operator reading a
// failed run is pointed at the offending subject without a second lookup.

test fn a_misplaced_module_is_reported_with_its_file_and_its_rule_position() -> Bool {
  layout_refusal_text(refusal: NotAtRulePosition {
    file: dag_file(path: "v2/std/text.dag"),
    declared: "v2.std.text",
    expected: v2_file(path: "std/text.dag")
  }) == "dag:v2/std/text.dag: declares module v2.std.text, whose rule position is v2:std/text.dag"
}

test fn a_stale_row_is_reported_by_the_namespace_it_declares() -> Bool {
  layout_refusal_text(refusal: NamespaceRowWithoutModules { namespace: "q.r" })
    == "namespace q.r is declared but no governed file holds a module in it"
}

test fn a_refused_layout_is_reported_one_line_per_refusal() -> Bool {
  layout_verdict_text(verdict: LayoutRefused {
    refusals: [
      ModuleLineMissing { file: dag_file(path: "a/b/c.dag") },
      NamespaceRowWithoutModules { namespace: "q.r" }
    ]
  }) == "dag:a/b/c.dag: no module line\nnamespace q.r is declared but no governed file holds a module in it"
}

test fn an_unreadable_header_is_reported_with_its_file_and_its_cause() -> Bool {
  layout_refusal_text(refusal: ModuleHeaderUnreadable { file: dag_file(path: "a/b/c.dag"), cause: "tokens remain" })
    == "dag:a/b/c.dag: the module header does not parse: tokens remain"
}

test fn a_layout_that_holds_says_so_and_a_refused_one_does_not() -> Bool {
  layout_verdict_holds(verdict: LayoutHolds {}) && layout_verdict_holds(verdict: LayoutRefused { refusals: [ModuleLineMissing { file: dag_file(path: "a/b/c.dag") }] }) == false
}

// ---- the name-to-path map is injective over the names it accepts, and confined --------------------------
//
// A module name is stored at the file it derives, so two accepted names deriving one file would make a
// file the key of two modules. The path rule joins segments with `/`, so a segment admitted with a
// separator in it is the way that happens: `v2.a/b` has no empty dot segment and would derive a/b.dag,
// the file of `v2.a.b`. The storage authority therefore accepts only identifier segments (the tokenizer's
// own alphabet), and these controls state the property over a supplied population that includes the
// colliding forms rather than over one example: every name the rule accepts derives a path no other
// accepted name derives, every derived path stays beneath its tree, and each path-syntax form is refused
// before any path exists.

data adversarial_names: List<String> = [
  "a.b",
  "a.b.c",
  "a.b_c",
  "a.b2",
  "v2.a.b",
  "v2.a/b",
  "a/b",
  "a.b/c",
  "/a",
  "v2./a",
  "..",
  "a..b",
  "a.",
  ".a",
  "v2..a",
  "a.b ",
  " a.b",
  "a-b",
  "a.9b",
  "9a.b",
  "",
  "v2",
  "v2.a%2Fb"
]

fn derived_key(name: String) -> String {
  match module_file(layout: layout(), name: name) {
    ModuleFileDerived { file: file } => module_file_key(file: file)
    ModuleNameUnderivable { name: _, cause: _ } => ""
  }
}

fn derived_relative_path(name: String) -> String {
  match module_file(layout: layout(), name: name) {
    ModuleFileDerived { file: file } => file.relative_path
    ModuleNameUnderivable { name: _, cause: _ } => ""
  }
}

fn accepted_names() -> List<String> {
  adversarial_names |> filter(fn(name) { derived_key(name: name) != "" })
}

fn is_underivable(name: String) -> Bool {
  derived_key(name: name) == ""
}

test fn distinct_accepted_module_names_derive_distinct_files() -> Bool {
  let keys = list_map(xs: accepted_names(), f: fn(name) { derived_key(name: name) })
  length(xs: keys) > 4 && for_all(xs: keys, predicate: fn(key) { length(xs: keys |> filter(fn(other) { other == key })) == 1 })
}

// Every derived path is a chain of nonempty components under the tree, ending at the `.dag` file:
// nothing climbs out of the bound source root and nothing is absolute.
fn path_is_confined(path: String) -> Bool {
  path != "" && path.ends_with(suffix: ".dag") && for_all(
    xs: split(s: path, delimiter: "/"),
    predicate: fn(part) { part != "" && part != "." && part != ".." && part != ".dag" }
  )
}

test fn every_derived_relative_path_is_confined_beneath_its_source_root() -> Bool {
  length(xs: accepted_names()) > 4
    && for_all(xs: accepted_names(), predicate: fn(name) { path_is_confined(path: derived_relative_path(name: name)) })
}

test fn the_colliding_forms_are_split_one_accepted_and_one_refused() -> Bool {
  derived_relative_path(name: "v2.a.b") == "a/b.dag" && is_underivable(name: "v2.a/b") && is_underivable(name: "a/b")
}

test fn a_name_carrying_path_syntax_is_refused_before_any_path_is_derived() -> Bool {
  is_underivable(name: "v2.a/b")
    && is_underivable(name: "/a")
    && is_underivable(name: "v2./a")
    && is_underivable(name: "..")
    && is_underivable(name: "a..b")
    && is_underivable(name: ".a")
    && is_underivable(name: "a.")
    && is_underivable(name: "a.b ")
    && is_underivable(name: "a-b")
    && is_underivable(name: "9a.b")
    && is_underivable(name: "v2.a%2Fb")
}

// The backslash is a path separator on a host that takes one; its code point is written as a code point
// so no string-escape reading can turn the control into a different name.
test fn a_name_carrying_a_backslash_is_refused() -> Bool {
  is_underivable(name: concat("a", unicode_scalar_fold(xs: [92]), "b"))
}

test fn a_name_of_identifier_segments_is_still_derived() -> Bool {
  derived_relative_path(name: "a.b_c") == "a/b_c.dag" && derived_relative_path(name: "a.b2") == "a/b2.dag" && derived_relative_path(name: "v2.a.b") == "a/b.dag"
}
