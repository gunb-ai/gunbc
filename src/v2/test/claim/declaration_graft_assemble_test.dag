module v2.test.claim.declaration_graft_assemble

import extdeps.communication.medium { Lossless, Medium }
import v2.compiler.name_resolve {
  Admission,
  ResolutionSubject
}
import v2.compiler.program_assembly { assemble_program_from_ingest }
import v2.compiler.source_authority {
  DagSourceReadWitness,
  SourceRootIngest
}
import v2.extdeps.languages.dag { dag_language_model }
import std.algebra { Cons, Empty }
import v2.std.cross_tree.import_model { V2Tree }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.diagnostic { Accepted, Outcome, Rejected }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.node { Atom, Named, Node, Positional, TypeNode, node_subtree_nodes }
import v2.std.text { String }
import v2.std.compilers.lexing { symbol_lexeme }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data declaration_graft_module_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^declaration_graft_module_artifact,
  file_path: "src/v2/pilot/declaration_graft_pilot.dag"
}

fn declaration_graft_ingest_for(src: String) -> SourceRootIngest {
  Cons {
    head: DagSourceReadWitness {
      source: Medium { carried: src, fidelity: Lossless },
      artifact: declaration_graft_module_artifact,
      compilation_unit: ^declaration_graft_pilot_cu,
      source_root: V2Tree
    },
    tail: Empty
  }
}

fn declaration_graft_admission() -> Admission {
  Admission {
    subject: ResolutionSubject {
      name: Cons { head: ^p, tail: Empty }
    },
    imports: Empty
  }
}

fn declaration_graft_assemble_for(src: String) -> Outcome<Node> {
  assemble_program_from_ingest(
    ingest: declaration_graft_ingest_for(src: src),
    admission: declaration_graft_admission(),
    lm: dag_language_model()
  )
}

fn declaration_graft_assemble_accepts(src: String) -> Bool {
  match declaration_graft_assemble_for(src: src) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn declaration_graft_label_present(root: Node, lexeme: String) -> Bool {
  fold(
    node_subtree_nodes(root: root),
    init: false,
    f: fn(found, n) {
      if found {
        true
      } else {
        fold(n.children, init: false, f: fn(inner, e) {
          if inner {
            true
          } else {
            match e.label {
              Named { name: sym } => symbol_lexeme(sym: sym) == lexeme
              Positional => false
            }
          }
        })
      }
    }
  )
}

fn declaration_graft_atom_present(root: Node, lexeme: String) -> Bool {
  fold(
    node_subtree_nodes(root: root),
    init: false,
    f: fn(found, n) {
      if found {
        true
      } else {
        match n.kind {
          TypeNode { connective: Atom { identity: sym } } => symbol_lexeme(sym: sym) == lexeme
          _ => false
        }
      }
    }
  )
}

fn declaration_graft_named_reachable(src: String, lexeme: String) -> Bool {
  match declaration_graft_assemble_for(src: src) {
    Accepted { value: root, diagnostics: _ } =>
      declaration_graft_label_present(root: root, lexeme: lexeme)
    Rejected { diagnostics: _ } => false
  }
}

data src_a: String = "module p\n"
data src_b: String = "module p\n\nfn f(x: Int) -> Int { x }\n"
data src_c: String = "module p\n\ntype Flag = On | Off\n"
data src_h: String = "module p\n\ntype Name = String where brand(\"Name\")\n"
data src_i: String = "module p\n\ntype Name = String where brand(\"Name\")\nfn f(x: Int) -> Int { x }\n"
data src_d: String = "module p\n\ntype Flag = On | Off\nfn g(f: Flag) -> Flag { f }\n"
data src_e: String = "module p\n\ntype Flag = On | Off\nfn h() -> Flag { On }\n"
data src_f: String = "module p\n\ntype Flag = On | Off\nfn flip(f: Flag) -> Flag { match f { On => Off } }\n"
data src_g: String = "module p\n\ntype Rec { n: Int }\nfn mk() -> Rec { Rec { n: 1 } }\n"
data src_g_type_only: String = "module p\n\ntype Rec { n: Int }\n"
data src_dag_user_fn: String = "module p\n\nfn dag_user(x: Int) -> Int { x }\n"
data src_flag_and_rec: String = "module p\n\ntype Flag = On | Off\ntype Rec { n: Int }\n"

data src_flag_and_fn: String = "module p\n\ntype Flag = On | Off\nfn f(x: Int) -> Int { x }\n"
data src_import_and_fn: String = "module p\n\nimport v2.std.logic { Bool }\n\nfn f() -> Bool { true }\n"

test fn declaration_graft_empty_module_accepts() -> Bool {
  declaration_graft_assemble_accepts(src: src_a)
}

test fn declaration_graft_fn_only_accepts() -> Bool {
  declaration_graft_assemble_accepts(src: src_b)
}

test fn declaration_graft_type_only_accepts() -> Bool {
  declaration_graft_assemble_accepts(src: src_c)
}

test fn declaration_graft_type_only_flag_is_named() -> Bool {
  declaration_graft_named_reachable(src: src_c, lexeme: "Flag")
}

test fn declaration_graft_where_alias_accepts() -> Bool {
  declaration_graft_assemble_accepts(src: src_h)
}

test fn declaration_graft_silent_drop_control_type_is_named() -> Bool {
  declaration_graft_named_reachable(src: src_i, lexeme: "Name")
}

test fn declaration_graft_fn_referencing_type_accepts() -> Bool {
  declaration_graft_assemble_accepts(src: src_d)
}

test fn declaration_graft_variant_construct_accepts() -> Bool {
  declaration_graft_assemble_accepts(src: src_e)
}

test fn declaration_graft_match_variants_accepts() -> Bool {
  declaration_graft_assemble_accepts(src: src_f)
}

test fn declaration_graft_dag_prefix_user_fn_is_named() -> Bool {
  declaration_graft_named_reachable(src: src_dag_user_fn, lexeme: "dag_user")
}

// Partial graft must not drop a sibling fn: Flag Named and f Named on the same
// Accepted assemble. Rejected is not agreement.
test fn declaration_graft_coproduct_beside_fn_keeps_both() -> Bool {
  match declaration_graft_assemble_for(src: src_flag_and_fn) {
    Rejected { diagnostics: _ } => false
    Accepted { value: root, diagnostics: _ } =>
      declaration_graft_label_present(root: root, lexeme: "Flag")
        && declaration_graft_label_present(root: root, lexeme: "f")
  }
}

// A record beside a graftable coproduct is carried as a residual shell, not
// dropped (main dropped it silently). The shell is UNLOWERED -- body_lower_type_decl
// rehomes a type_decl only with a where-clause -- so its surface tokens reach
// resolve as bare mentions and a closure without a parse-phase declaration
// index refuses resolve_reason_unbound_symbol (measured: even `type Rec { }`).
// Standing RED of gunbc.recurring_failure_mode.type_decl_field_decl_block_not_named_at_graft;
// flips to an Accepted-with-Rec-Named control when the rehome lands.
test fn declaration_graft_coproduct_beside_record_refuses_unbound_today() -> Bool {
  match declaration_graft_assemble_for(src: src_flag_and_rec) {
    Rejected { diagnostics: d } => d.head.reason == ^resolve_reason_unbound_symbol
    Accepted { value: _, diagnostics: _ } => false
  }
}

// Record assemble standing RED (one spelling of the field_decl_block skip):
// gunbc.recurring_failure_mode.type_decl_field_decl_block_not_named_at_graft.
// Not asserted via !named_reachable: that is true on every Rejected.
test fn declaration_graft_record_type_only_does_not_accept_today() -> Bool {
  !declaration_graft_assemble_accepts(src: src_g_type_only)
}

test fn declaration_graft_record_construct_does_not_accept_today() -> Bool {
  !declaration_graft_assemble_accepts(src: src_g)
}

// An import_decl unit dissolves at the partition (admitted upstream as
// Admission.imports): it is neither Named nor a residual shell. The control is a
// one-module ingest whose closure does NOT contain v2.std.logic: carried as a
// residual shell, resolve walks `logic` / `Bool` as bare mentions and refuses
// (v2.test.native_decl_selection went red on exactly this). Green on main via
// the flatten; red on the partition until the UnitDissolved arm.
test fn declaration_graft_import_beside_fn_accepts_and_dissolves_the_import() -> Bool {
  match declaration_graft_assemble_for(src: src_import_and_fn) {
    Rejected { diagnostics: _ } => false
    Accepted { value: root, diagnostics: _ } =>
      declaration_graft_label_present(root: root, lexeme: "f")
        && !declaration_graft_atom_present(root: root, lexeme: "logic")
  }
}
