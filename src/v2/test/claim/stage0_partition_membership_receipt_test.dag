module v2.test.claim.stage0_partition_membership_receipt

import v2.std.algebra { HeadAbsent, HeadFound, list_head, list_snoc_item }
import v2.workflow.rust_crate_partition {
  stage0_derived_assignment_succeeds_on_enrolled_graph,
  stage0_partition_crate_rows,
  stage0_partition_crate_row_membership_derived,
  stage0_partition_derived_membership_matches_enrolled_baseline_holds,
  stage0_partition_membership_closure_covers_seeds,
  stage0_partition_membership_order_independence,
  stage0_partition_witness_assignment_conflict_refuses_holds,
  stage0_partition_witness_assignment_conflict_cause_carries_reachers_holds,
  stage0_partition_witness_nonconvergence_refuses_holds,
  stage0_partition_witness_shared_dependency_v1_rt_not_in_std_core_holds,
  rust_crate_partition_declared_core_target,
  stage0_physical_crate_count
}

data stage0_partition_membership_receipt_note: String = "C2 equivalence receipt: derived per-unit membership matches a frozen baseline from origin/main hand lists (independent oracle — not row.modules, which is populated from the same derivation). Order-independence, convergence budget |domain|, and typed collision policy witnessed separately. RED controls: zero-step raw reach refuses; two-unit owner ambiguity refuses; forward vs reversed unit-order iteration yields identical membership."

test fn stage0_partition_membership_closure_covers_seeds_holds() -> Bool {
  stage0_partition_membership_closure_covers_seeds()
}

test fn stage0_partition_derived_membership_matches_enrolled_baseline_witness_holds() -> Bool {
  stage0_partition_derived_membership_matches_enrolled_baseline_holds()
}

test fn stage0_partition_derived_assignment_succeeds_on_enrolled_graph_holds() -> Bool {
  stage0_derived_assignment_succeeds_on_enrolled_graph()
}

test fn stage0_partition_shared_dependency_v1_rt_not_in_std_core_holds() -> Bool {
  stage0_partition_witness_shared_dependency_v1_rt_not_in_std_core_holds()
}

test fn stage0_partition_membership_order_independence_holds() -> Bool {
  stage0_partition_membership_order_independence()
}

test fn stage0_partition_nonconvergence_refuses_holds() -> Bool {
  stage0_partition_witness_nonconvergence_refuses_holds()
}

test fn stage0_partition_assignment_conflict_refuses_holds() -> Bool {
  stage0_partition_witness_assignment_conflict_refuses_holds()
}

test fn stage0_partition_assignment_conflict_cause_carries_reachers_holds() -> Bool {
  stage0_partition_witness_assignment_conflict_cause_carries_reachers_holds()
}

test fn stage0_partition_physical_crate_count_is_seven_holds() -> Bool {
  stage0_physical_crate_count() == rust_crate_partition_declared_core_target
}

test fn stage0_partition_red_control_wrong_module_not_derived_holds() -> Bool {
  match list_head(xs: stage0_partition_crate_rows()) {
    HeadAbsent => false
    HeadFound { value: head } => {
      let derived = stage0_partition_crate_row_membership_derived(row: head)
      !(derived == list_snoc_item(xs: derived, item: "synthetic_unassigned_module"))
    }
  }
}
