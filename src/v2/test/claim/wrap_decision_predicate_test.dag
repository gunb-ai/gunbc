module v2.test.claim.wrap_decision_predicate


data wrap_decision_predicate_note: String = "Derisk witnesses for rc-ownership-wrap-decision-design.md: wrap_decision_gate is the single authority for Rc/Box/owned type wrapping at ONE emit position, and wrap_decision_flow_gate is the single authority over a producer/consumer PAIR, refusing disagreement. UseSiteVerdict enrolled (owned-at-all-sites). RED, position surface: omit Diagnostics param row -> param witness rejects; add silent default wrap on WrapGateInapplicable -> bundle_absent witness fails. RED, flow surface (measured, non-uniform): force wrap_decision_gates_agree to true -> over_wrap, under_wrap and distinct_reference_layers witnesses red while missing_row and both accept controls stay green; make wrap_decisions_equal layer-blind -> distinct_reference_layers alone reds. A witness set that reds together says less than one whose profile names which witness guards which arm."

fn wrap_decision_sg_rc_target() -> v2.std.compilers.target_model.TargetModel {
  v2.extdeps.languages.rust.rust_sg2_type_expr_target_model()
}

fn wrap_decision_bundle_absent_target() -> v2.std.compilers.target_model.TargetModel {
  v2.std.compilers.target_model.TargetModel {
    produced_decl_support: v2.std.compilers.target_model.ProducedDeclUnwired,
    bundle: v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
      children: [],
      occurrence_id: v2.std.node.SyntheticOccurrence
    },
    lex: wrap_decision_sg_rc_target().lex,
    binding_spellings: wrap_decision_sg_rc_target().binding_spellings,
    token_class_emit_transforms: wrap_decision_sg_rc_target().token_class_emit_transforms,
    authority_source_text: wrap_decision_sg_rc_target().authority_source_text,
    runtime_row: wrap_decision_sg_rc_target().runtime_row
  }
}

fn wrap_decision_partial_bundle_target() -> v2.std.compilers.target_model.TargetModel {
  v2.std.compilers.target_model.TargetModel {
    produced_decl_support: v2.std.compilers.target_model.ProducedDeclUnwired,
    bundle: v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
      children: [
        v2.extdeps.languages.rust.rust_named_edge(
          name: ^target_model_edge_use_site_ownership_realizations,
          target: v2.std.compilers.target_model.target_use_site_ownership_catalog_node(
            rows: v2.extdeps.languages.rust.rust_sg_rc_use_site_ownership_catalog()
          )
        )
      ],
      occurrence_id: v2.std.node.SyntheticOccurrence
    },
    lex: wrap_decision_sg_rc_target().lex,
    binding_spellings: wrap_decision_sg_rc_target().binding_spellings,
    token_class_emit_transforms: wrap_decision_sg_rc_target().token_class_emit_transforms,
    authority_source_text: wrap_decision_sg_rc_target().authority_source_text,
    runtime_row: wrap_decision_sg_rc_target().runtime_row
  }
}

fn wrap_decision_gate_is_by_value(
  target: v2.std.compilers.target_model.TargetModel,
  source_carrier: v2.std.node.Node,
  use_site: v2.std.compilers.target_model.TargetOwnershipUseSite
) -> Bool {
  match v2.compiler.wrap_decision.wrap_decision_gate(
    target: target,
    source_carrier: source_carrier,
    use_site: use_site
  ) {
    v2.std.diagnostic.Accepted {
      value: v2.std.compilers.target_model.WrapGateDecided { decision: v2.std.compilers.target_model.WrapByValue },
      diagnostics: _
    } => true
    _ => false
  }
}

fn wrap_decision_gate_is_rc_reference(
  target: v2.std.compilers.target_model.TargetModel,
  source_carrier: v2.std.node.Node,
  use_site: v2.std.compilers.target_model.TargetOwnershipUseSite
) -> Bool {
  wrap_decision_gate_is_reference_layer(
    target: target,
    source_carrier: source_carrier,
    use_site: use_site,
    layer: v2.std.compilers.target_model.ReferenceLayerRc
  )
}

