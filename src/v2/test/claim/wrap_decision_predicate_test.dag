data wrap_decision_composite_note: String = "Discriminates the wrap_decision_predicate caller-side bypass (v1_deletion_plan.dag ^wrap_decision_predicate, RE-OPENED 2026-07-24): translate_apply_use_site_ownership_to_projected_boundary must recurse ownership-wrap into TargetTypeExprInstantiation-kind wires (Option<T>/Rc<T>/List<T> shapes) instead of returning the composite unwrapped via the _ => outcome_accepted(projected) arm."

fn wrap_decision_composite_projected_arg() -> v2.std.node.Node {
  v2.std.compilers.target_model.target_type_expr_atom_emitted(
    form: v2.extdeps.languages.rust.rust_type_expression_projection().atom_form,
    identity: ^wrap_decision_composite_leaf_binding
  )
}

fn wrap_decision_composite_projected() -> v2.std.node.Node {
  v2.std.compilers.target_model.target_type_expr_instantiation_emitted(
    form: v2.extdeps.languages.rust.rust_type_expression_projection().instantiation_form,
    head: v2.std.compilers.target_model.target_type_expr_atom_emitted(
      form: v2.extdeps.languages.rust.rust_type_expression_projection().atom_form,
      identity: ^wrap_decision_composite_outer_binding
    ),
    args: [wrap_decision_composite_projected_arg()]
  )
}

fn wrap_decision_composite_source() -> v2.std.node.Node {
  v2.std.compilers.target_model.target_type_expr_instantiation_emitted(
    form: v2.extdeps.languages.rust.rust_type_expression_projection().instantiation_form,
    head: v2.std.compilers.target_model.target_type_expr_atom_emitted(
      form: v2.extdeps.languages.rust.rust_type_expression_projection().atom_form,
      identity: ^wrap_decision_composite_outer_binding
    ),
    args: [v2.std.compilers.target_model.target_carrier_node_node()]
  )
}

fn wrap_decision_composite_boundary_result() -> v2.std.node.Node {
  match v2.compiler.translate.translate_apply_use_site_ownership_to_projected_boundary(
    projected: wrap_decision_composite_projected(),
    source_for_binding: wrap_decision_composite_source(),
    target: wrap_decision_sg_rc_target(),
    projection: v2.extdeps.languages.rust.rust_type_expression_projection(),
    use_site: v2.std.compilers.target_model.OwnershipAtStructField
  ) {
    v2.std.diagnostic.Accepted { value: node, diagnostics: _ } => node
    v2.std.diagnostic.Rejected { diagnostics: _ } => wrap_decision_composite_projected()
  }
}

fn wrap_decision_composite_result_arg() -> v2.std.node.Node {
  match v2.std.collection.list_at_optional(
    xs: v2.std.node_query.node_positional_child_targets(node: wrap_decision_composite_boundary_result()),
    index: 1
  ) {
    v2.std.optional.Present { value: arg } => arg
    v2.std.optional.Absent => wrap_decision_composite_projected_arg()
  }
}

test fn wrap_decision_instantiation_arg_is_wrapped() -> Bool {
  match v2.std.compilers.target_model.target_type_expr_emitted_wire_decode(
    node: wrap_decision_composite_result_arg(),
    projection: v2.extdeps.languages.rust.rust_type_expression_projection()
  ) {
    v2.std.diagnostic.Accepted { value: wire, diagnostics: _ } => wire.kind == v2.std.compilers.target_model.TargetTypeExprInstantiation
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}
