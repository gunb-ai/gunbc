fn wrap_decision_gate_is_reference_layer(
  target: v2.std.compilers.target_model.TargetModel,
  source_carrier: v2.std.node.Node,
  use_site: v2.std.compilers.target_model.TargetOwnershipUseSite,
  layer: v2.std.compilers.target_model.TargetReferenceLayer
) -> Bool {
  match v2.compiler.wrap_decision.wrap_decision_gate(
    target: target,
    source_carrier: source_carrier,
    use_site: use_site
  ) {
    v2.std.diagnostic.Accepted {
      value: v2.std.compilers.target_model.WrapGateDecided { decision: v2.std.compilers.target_model.WrapByReference { layer: decided } },
      diagnostics: _
    } => decided == layer
    _ => false
  }
}

