module v2.test.claim.native_cache_fusion_test

import v2.workflow.native_cache_fusion {
  HostWarmObservation,
  host_compile_skipped,
  fusion_agreement_holds_for
}
import v2.std.logic { Bool }

test fn witness_warm_marker_agrees_share() -> Bool {
  fusion_agreement_holds_for(
    o: HostWarmObservation { marker_exists: true, cold_control: false }
  )
}

test fn witness_cold_marker_absent_agrees_recompute() -> Bool {
  fusion_agreement_holds_for(
    o: HostWarmObservation { marker_exists: false, cold_control: false }
  )
}

test fn witness_cold_control_forces_recompute_agreement() -> Bool {
  let skipped = host_compile_skipped(
    o: HostWarmObservation { marker_exists: true, cold_control: true }
  )
  skipped == false
    && fusion_agreement_holds_for(
      o: HostWarmObservation { marker_exists: true, cold_control: true }
    )
}

