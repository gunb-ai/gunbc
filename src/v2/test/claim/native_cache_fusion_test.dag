module v2.test.claim.native_cache_fusion_test


fn witness_warm_marker_agrees_share() -> Bool {
  fusion_agreement_holds_for(
    o: HostWarmObservation { marker_exists: true, cold_control: false }
  )
}

fn witness_cold_marker_absent_agrees_recompute() -> Bool {
  fusion_agreement_holds_for(
    o: HostWarmObservation { marker_exists: false, cold_control: false }
  )
}

fn witness_cold_control_forces_recompute_agreement() -> Bool {
  let skipped = host_compile_skipped(
    o: HostWarmObservation { marker_exists: true, cold_control: true }
  )
  skipped == false
    && fusion_agreement_holds_for(
      o: HostWarmObservation { marker_exists: true, cold_control: true }
    )
}

test fn native_cache_fusion_witnesses() -> Bool {
  witness_warm_marker_agrees_share()
    && witness_cold_marker_absent_agrees_recompute()
    && witness_cold_control_forces_recompute_agreement()
}
