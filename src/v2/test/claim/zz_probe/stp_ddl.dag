module v2.test.claim.zz_probe.stp_ddl

import v2.test.execution.data_decl_lowering_grounding { ddl_childless_conj, ddl_unauthorized_atom, ddl_arrow_with, ddl_hand_grounding, ddl_resolved_type }
import v2.std.node { Node, TypeNode, Conj, Atom, Arrow, Disj, node_subtree_nodes }
import std.occurrence_identity { OccurrenceId, OccurrenceMinted }
import v2.std.algebra { fold_list, length }
import v2.std.optional { Absent, Present }
import v2.std.text { String }
import std.process { ProcessExit, exit_failure }

fn sd_int(n: Int) -> String {
  if n == 0 { "0" } else if n == 1 { "1" } else if n == 2 { "2" } else if n == 3 { "3" } else if n == 4 { "4" } else if n > 4 { ">4" } else { "<0" }
}

fn sd_kind(n: Node) -> String {
  match n.kind {
    TypeNode { connective: Conj } => "Conj"
    TypeNode { connective: Arrow } => "Arrow"
    TypeNode { connective: Disj } => "Disj"
    TypeNode { connective: Atom { identity: _ } } => "Atom"
    _ => "other"
  }
}

fn sd_is_childless_conj(n: Node) -> Bool {
  match n.kind { TypeNode { connective: Conj } => length(xs: n.children) == 0  _ => false }
}

fn sd_case(label: String, codomain: Node) -> String {
  let tree = ddl_arrow_with(domain: ddl_unauthorized_atom(), codomain: codomain)
  let nodes = node_subtree_nodes(root: tree)
  let childless = fold_list(xs: nodes, empty: 0, cons: fn(acc, n) { if sd_is_childless_conj(n: n) { acc + 1 } else { acc } })
  let equal = fold_list(xs: nodes, empty: 0, cons: fn(acc, n) { if n == codomain { acc + 1 } else { acc } })
  label + ": grounding=" + sd_int(n: ddl_hand_grounding(tree: tree, n: codomain))
    + " subtree_nodes=" + sd_int(n: length(xs: nodes))
    + " childless_conj_nodes=" + sd_int(n: childless)
    + " nodes_equal_to_codomain=" + sd_int(n: equal)
    + " evidence=" + (match ddl_resolved_type(tree: tree, n: codomain) {
      Present { value: t } => sd_kind(n: t) + "/" + sd_int(n: length(xs: t.children)) + (if t == codomain { "/SELF" } else { "/fresh" })
      Absent => "none"
    })
}

fn sd_report() -> ProcessExit {
  exit_failure(reason: "SDD " + sd_case(label: "synthetic", codomain: ddl_childless_conj())
    + " | " + sd_case(label: "minted", codomain: Node { kind: TypeNode { connective: Conj }, children: [], occurrence_id: OccurrenceMinted { id: OccurrenceId { value: 987654 } } }))
}
