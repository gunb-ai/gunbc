module v2.test.claim.zz_probe.p7

import std.occurrence_identity { DeclarationRole, LexicalValueOccurrence, ReferenceRole }
import v2.compiler.occurrence_role { OccurrenceRoleOutcome, OccurrenceRoleTableRefused, OccurrenceRolesRead, dag_name_production_rows, occurrence_roles_of_tree }
import v2.compiler.reference_conservation { ReferenceConservationReport }
import v2.test.claim.namespace_xl0.reference_conservation { conservation_subject, conservation_report_of }
import v2.extdeps.languages.dag { dag_grammar_root }
import v2.std.algebra { fold_list, length }
import v2.std.diagnostic { Accepted, Rejected }
import std.process { ProcessExit, exit_failure }

data p7_source: String = "module v2.test.p7\n\ntype Box = Holds { value: Int }\n\nfn f(b: Box) -> Int = match b {\n  Holds { value: v } => v\n}\n\nfn g(x: Int) -> Int {\n  let y = x\n  y + y\n}\n"

fn p7_i(n: Int) -> String {
  if n < 0 { "-" + p7_i(n: 0 - n) } else if n < 10 { (if n == 0 { "0" } else if n == 1 { "1" } else if n == 2 { "2" } else if n == 3 { "3" } else if n == 4 { "4" } else if n == 5 { "5" } else if n == 6 { "6" } else if n == 7 { "7" } else if n == 8 { "8" } else { "9" }) } else { p7_i(n: n / 10) + p7_i(n: n - (n / 10) * 10) }
}

fn p7_report() -> ProcessExit {
  let subject = conservation_subject(id_tail: "p7", source: p7_source)
  let roles = match subject.parsed {
    Rejected { diagnostics: _ } => "ROLES unparsed"
    Accepted { value: artifact, diagnostics: _ } =>
      match occurrence_roles_of_tree(tree: artifact.tree, root: dag_grammar_root(), rows: dag_name_production_rows()) {
        OccurrenceRoleTableRefused { unlisted: _, unknown: _, unkeyed: _ } => "ROLES refused"
        OccurrenceRolesRead { roles: r } =>
          "ROLES total=" + p7_i(n: length(xs: r.roles))
            + " decl_lexical=" + p7_i(n: fold_list(xs: r.roles, empty: 0, cons: fn(acc, a) { if a.role == DeclarationRole && a.category == LexicalValueOccurrence { acc + 1 } else { acc } }))
            + " ref_lexical=" + p7_i(n: fold_list(xs: r.roles, empty: 0, cons: fn(acc, a) { if a.role == ReferenceRole && a.category == LexicalValueOccurrence { acc + 1 } else { acc } }))
            + " unminted=" + p7_i(n: r.unminted)
      }
  }
  let rep = conservation_report_of(subject: subject)
  exit_failure(reason: "P7 " + roles + " | RC authored=" + p7_i(n: rep.authored) + " conserved=" + p7_i(n: rep.conserved) + " locus_erased=" + p7_i(n: rep.locus_erased) + " role_excluded=" + p7_i(n: rep.role_excluded) + " not_yet_read=" + p7_i(n: rep.role_not_yet_read) + " refused=" + p7_i(n: rep.refused) + " dropped=" + p7_i(n: length(xs: rep.dropped)))
}
