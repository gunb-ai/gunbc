module v2.test.claim.zz_probe.p6

import v2.compiler.infer { InferredTree, infer }
import v2.compiler.inferred_tree { DerivedGrounding, GroundingNotDerived }
import v2.test.claim.type_param_binder_frame { tpb_assemble }
import v2.std.diagnostic { Accepted, Rejected, diagnostics_fatal_reason }
import v2.std.node { Node, symbol_lexeme, node_subtree_nodes }
import v2.std.grammar { node_atom_identity_optional }
import v2.std.optional { Absent, Present }
import std.process { ProcessExit, exit_failure }
import v2.std.qualified_name { binder_reference_symbol_optional }

fn pp_facts(t: InferredTree, n: Node) -> String {
  match t.facts.lookup(n) {
    Absent => "MISS"
    Present { value: f } =>
      match f.grounding {
        GroundingNotDerived { node: _ } => "NOTDERIVED"
        DerivedGrounding { grounding: g } =>
          match node_atom_identity_optional(node: g.witness.structural.evidence) {
            Present { value: e } => "DERIVED:" + symbol_lexeme(sym: e)
            Absent => "DERIVED:nonatom"
          }
      }
  }
}

fn pp_report() -> ProcessExit {
  let r = match tpb_assemble(src: "module p\n\nfn f(x: Int) -> Int {\n  let g = fn(a) { a + x }\n  g(x)\n}\n") {
    Rejected { diagnostics: d } => "RESOLVE-REJ " + symbol_lexeme(sym: diagnostics_fatal_reason(d: d))
    Accepted { value: rt, diagnostics: _ } =>
      match infer(tree: rt) {
        Rejected { diagnostics: d } => "INFER-REJ " + symbol_lexeme(sym: diagnostics_fatal_reason(d: d))
        Accepted { value: t, diagnostics: _ } =>
          fold(node_subtree_nodes(root: t.root), init: "", f: fn(acc, n) {
            if binder_reference_symbol_optional(node: n) == Present { value: ^a } { acc + " [" + pp_facts(t: t, n: n) + "]" } else { acc }
          })
      }
  }
  exit_failure(reason: "PP6" + r)
}
