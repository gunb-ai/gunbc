module v2.test.claim.witness_admission_test

import v2.workflow.witness_admission {
  witness_consumer_cadence_for_row,
  witness_admission_holds_for_row,
  witness_admission_explicit_consumer_manifest,
  witness_admission_manifest_covers_row
}
import std.witness_admission {
  FalsifierRehomedBinWet,
  FalsifierSubstrateLongLane,
  WitnessConsumerCadence,
  BinWitnessWet,
  QuarantineProbeExpectRed,
  OfflineLocalRecipe,
  DiscoverySelection,
  NoConsumer
}
import v2.std.algebra { length }
import v2.std.logic { Bool }
import v2.std.text { String }

data normalize_entry: String = "dag/test/claim/self_host_03_normalize_behavioral_witness_test.dag"
data normalize_fn: String = "self_host_03_normalize_behavioral_receipt_holds"

data normalize_wet_known_red_admission_note: String = "2026-07-25 review #7199: SelfEmitted wet bindings that red on assemble are Wet expect_red quarantine (falsifier_self_host_wet_known_red_entries). 03_normalize's behavioral receipt consumer is QuarantineProbeExpectRed via the explicit roster (takes priority); the file-grain exclusion stays OfflineLocalRecipe so sibling declared_source_refs_complete_holds is not orphaned (english_emit_add pattern). Dissolve-on: local wet greens → known-red entry deletes → SelfHostWetReceiptBinding restores."

data synthetic_orphan_entry: String = "dag/test/claim/synthetic_orphan_admission_witness_test.dag"
data synthetic_orphan_fn: String = "synthetic_orphan_no_consumer_holds"

test fn witness_03_normalize_wet_known_red_consumer_holds() -> Bool {
  match witness_consumer_cadence_for_row(
    entry: normalize_entry,
    function: normalize_fn,
    excluded_from_discovery: true
  ) {
    QuarantineProbeExpectRed => true
    _ => false
  }
}

test fn witness_03_normalize_wet_known_red_manifest_covers_holds() -> Bool {
  witness_admission_manifest_covers_row(entry: normalize_entry, function: normalize_fn)
}

test fn witness_synthetic_orphan_has_no_consumer_holds() -> Bool {
  match witness_consumer_cadence_for_row(
    entry: synthetic_orphan_entry,
    function: synthetic_orphan_fn,
    excluded_from_discovery: true
  ) {
    NoConsumer => true
    _ => false
  }
}

test fn witness_synthetic_orphan_admission_red_holds() -> Bool {
  !witness_admission_holds_for_row(
    entry: synthetic_orphan_entry,
    function: synthetic_orphan_fn
  )
}

test fn witness_known_red_probe_consumer_holds() -> Bool {
  match witness_consumer_cadence_for_row(
    entry: "src/v2/test/claim/emit/logic_ground_truth_test.dag",
    function: "logic_complement_truth_table",
    excluded_from_discovery: true
  ) {
    QuarantineProbeExpectRed => true
    _ => false
  }
}

