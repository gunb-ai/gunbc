module v2.test.claim.witness_admission_test

import v2.workflow.witness_admission {
  witness_consumer_cadence_for_row,
  witness_admission_holds_for_row,
  witness_admission_explicit_consumer_manifest,
  witness_admission_manifest_covers_row
}
import std.witness_admission {
  FalsifierRehomedBinWet,
  WitnessConsumerCadence,
  FalsifierSelfHostWet,
  BinWitnessWet,
  QuarantineProbeExpectRed,
  OfflineLocalRecipe,
  DiscoverySelection,
  NoConsumer
}
import v2.std.algebra { length }
import v2.std.logic { Bool }
import v2.std.text { String }

data normalize_entry: String = "dag/test/claim/self_host_03_normalize_behavioral_witness_test.dag"
data normalize_fn: String = "self_host_03_normalize_behavioral_receipt_holds"

data synthetic_orphan_entry: String = "dag/test/claim/synthetic_orphan_admission_witness_test.dag"
data synthetic_orphan_fn: String = "synthetic_orphan_no_consumer_holds"

fn witness_03_normalize_falsifier_wet_consumer_holds() -> Bool {
  match witness_consumer_cadence_for_row(
    entry: normalize_entry,
    function: normalize_fn,
    excluded_from_discovery: true
  ) {
    FalsifierSelfHostWet => true
    _ => false
  }
}

fn witness_03_normalize_manifest_covers_holds() -> Bool {
  witness_admission_manifest_covers_row(entry: normalize_entry, function: normalize_fn)
}

fn witness_synthetic_orphan_has_no_consumer_holds() -> Bool {
  match witness_consumer_cadence_for_row(
    entry: synthetic_orphan_entry,
    function: synthetic_orphan_fn,
    excluded_from_discovery: true
  ) {
    NoConsumer => true
    _ => false
  }
}

fn witness_synthetic_orphan_admission_red_holds() -> Bool {
  !witness_admission_holds_for_row(
    entry: synthetic_orphan_entry,
    function: synthetic_orphan_fn
  )
}

fn witness_known_red_probe_consumer_holds() -> Bool {
  match witness_consumer_cadence_for_row(
    entry: "src/v2/test/claim/emit/logic_ground_truth_test.dag",
    function: "logic_complement_truth_table",
    excluded_from_discovery: true
  ) {
    QuarantineProbeExpectRed => true
    _ => false
  }
}

fn witness_field_access_wet_falsifier_consumer_holds() -> Bool {
  match witness_consumer_cadence_for_row(
    entry: "src/v2/test/claim/execution/emit_on_demand_field_access_family_witness_test.dag",
    function: "emit_on_demand_field_access_family_witnesses",
    excluded_from_discovery: true
  ) {
    FalsifierSelfHostWet => true
    _ => false
  }
}

fn witness_complement_wet_falsifier_consumer_holds() -> Bool {
  match witness_consumer_cadence_for_row(
    entry: "src/v2/test/claim/execution/emit_on_demand_complement_family_witness_test.dag",
    function: "emit_on_demand_complement_family_witnesses",
    excluded_from_discovery: true
  ) {
    FalsifierSelfHostWet => true
    _ => false
  }
}

fn witness_offline_execution_lane_consumer_holds() -> Bool {
  match witness_consumer_cadence_for_row(
    entry: "src/v2/test/claim/execution/synthetic_optin_exec_witness_test.dag",
    function: "synthetic_optin_exec_witness",
    excluded_from_discovery: true
  ) {
    OfflineLocalRecipe => true
    _ => false
  }
}

fn witness_discovery_row_consumer_holds() -> Bool {
  match witness_consumer_cadence_for_row(
    entry: "src/v2/test/claim/effect_reach_test.dag",
    function: "effect_reach_path_data_init_derived_host_reading_holds",
    excluded_from_discovery: false
  ) {
    DiscoverySelection => true
    _ => false
  }
}

fn witness_rehomed_bin_wet_consumer_holds() -> Bool {
  match witness_consumer_cadence_for_row(
    entry: "dag/test/claim/floor_skip_discovery_witness_test.dag",
    function: "floor_skip_discovery_keystone_holds",
    excluded_from_discovery: true
  ) {
    FalsifierRehomedBinWet => true
    _ => false
  }
}

fn witness_rehomed_bin_wet_manifest_covers_holds() -> Bool {
  witness_admission_manifest_covers_row(
    entry: "dag/test/claim/floor_skip_discovery_witness_test.dag",
    function: "floor_skip_discovery_keystone_holds"
  )
}

fn witness_explicit_manifest_nonempty_holds() -> Bool {
  length(xs: witness_admission_explicit_consumer_manifest()) > 0
}

test fn witness_admission_invariant_holds() -> Bool {
  witness_03_normalize_falsifier_wet_consumer_holds()
    && witness_03_normalize_manifest_covers_holds()
    && witness_synthetic_orphan_has_no_consumer_holds()
    && witness_synthetic_orphan_admission_red_holds()
    && witness_known_red_probe_consumer_holds()
    && witness_field_access_wet_falsifier_consumer_holds()
    && witness_complement_wet_falsifier_consumer_holds()
    && witness_offline_execution_lane_consumer_holds()
    && witness_discovery_row_consumer_holds()
    && witness_rehomed_bin_wet_consumer_holds()
    && witness_rehomed_bin_wet_manifest_covers_holds()
    && witness_explicit_manifest_nonempty_holds()
}
