module v2.test.generated.refinement_preservation

import v2.lens.testgen {
  Generator,
  RefinementPreservationSubject,
  TestgenConcept,
  refinement_preservation_list_node,
  refinement_preservation_subject_nonempty_list_base,
  refinement_label_nonempty_list_base,
  testgen_emit_refinement_preservation_claim,
  testgen_scheduled_refinement_preservation_generators
}
import v2.std.algebra { length }
import v2.std.collection { List }
import v2.std.diagnostic {
  Accepted,
  None,
  Outcome,
  Rejected
}
import v2.std.node { Node }
import v2.std.refinement { refined_base }
import v2.std.verification {
  TestClaim,
  ManualRefinementNonEmptyListBase
}
import v2.test.manual.connective_anchors {
  stub_empty_conj
}

fn refinement_preservation_claim_from_testgen_emit(
  subject: RefinementPreservationSubject
) -> Outcome<TestClaim> {
  testgen_emit_refinement_preservation_claim(
    anchor: ManualRefinementNonEmptyListBase,
    label: refinement_label_nonempty_list_base,
    subject: subject
  )
}

fn refinement_preservation_generated_nonempty_list_claim() -> Outcome<TestClaim> {
  match refinement_preservation_subject_nonempty_list_base() {
    Accepted { value: subject, diagnostics: None } =>
      match refinement_preservation_claim_from_testgen_emit(subject: subject) {
        Accepted { value: claim, diagnostics: None } => Accepted { value: claim, diagnostics: None }
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
      }
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}

data claim_refinement_nonempty_list_base_preserved: Outcome<TestClaim> = refinement_preservation_generated_nonempty_list_claim()

data witness_refinement_preserves_nonempty_list_base: Bool = match refinement_preservation_subject_nonempty_list_base() {
  Accepted { value: subject, diagnostics: None } => refined_base(r: subject.refined) == subject.original
  Rejected { diagnostics: _ } => false
}

fn refinement_preservation_subject_base_value() -> Outcome<Node> {
  match refinement_preservation_subject_nonempty_list_base() {
    Accepted { value: subject, diagnostics: None } =>
      Accepted {
        value: refinement_preservation_list_node(xs: subject.original),
        diagnostics: None
      }
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}

data witness_refinement_preservation_subject_anchor: Bool = match refinement_preservation_subject_base_value() {
  Accepted { value: base, diagnostics: None } => base == refinement_preservation_list_node(xs: [stub_empty_conj])
  Rejected { diagnostics: _ } => false
}

fn scheduled_refinement_preservation_generators() -> Outcome<List<Generator<TestgenConcept>>> {
  testgen_scheduled_refinement_preservation_generators()
}

data witness_refinement_preservation_scheduler_emits_one_generator: Bool = match scheduled_refinement_preservation_generators() {
  Accepted { value: generators, diagnostics: None } => length(xs: generators) == 1
  Rejected { diagnostics: _ } => false
}
