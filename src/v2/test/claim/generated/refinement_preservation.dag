module v2.test.generated.refinement_preservation


fn refinement_preservation_claim_from_testgen_emit(
  subject: v2.lens.testgen.RefinementPreservationSubject
) -> v2.std.diagnostic.Outcome<v2.std.verification.TestClaim> {
  v2.lens.testgen.testgen_emit_refinement_preservation_claim(
    anchor: v2.std.verification.ManualRefinementNonEmptyListBase,
    label: v2.lens.testgen.refinement_label_nonempty_list_base,
    subject: subject
  )
}

fn refinement_preservation_generated_nonempty_list_claim() -> v2.std.diagnostic.Outcome<v2.std.verification.TestClaim> {
  match v2.lens.testgen.refinement_preservation_subject_nonempty_list_base() {
    v2.std.diagnostic.Accepted { value: subject, diagnostics: v2.std.diagnostic.None } =>
      match refinement_preservation_claim_from_testgen_emit(subject: subject) {
        v2.std.diagnostic.Accepted { value: claim, diagnostics: v2.std.diagnostic.None } => v2.std.diagnostic.Accepted { value: claim, diagnostics: v2.std.diagnostic.None }
        v2.std.diagnostic.Rejected { diagnostics: d } => v2.std.diagnostic.Rejected { diagnostics: d }
      }
    v2.std.diagnostic.Rejected { diagnostics: d } => v2.std.diagnostic.Rejected { diagnostics: d }
  }
}

data claim_refinement_nonempty_list_base_preserved: v2.std.diagnostic.Outcome<v2.std.verification.TestClaim> = refinement_preservation_generated_nonempty_list_claim()

data witness_refinement_preserves_nonempty_list_base: Bool = match v2.lens.testgen.refinement_preservation_subject_nonempty_list_base() {
  v2.std.diagnostic.Accepted { value: subject, diagnostics: v2.std.diagnostic.None } => v2.std.refinement.refined_base(r: subject.refined) == subject.original
  v2.std.diagnostic.Rejected { diagnostics: _ } => false
}

fn refinement_preservation_subject_base_value() -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match v2.lens.testgen.refinement_preservation_subject_nonempty_list_base() {
    v2.std.diagnostic.Accepted { value: subject, diagnostics: v2.std.diagnostic.None } =>
      v2.std.diagnostic.Accepted {
        value: v2.lens.testgen.refinement_preservation_list_node(xs: subject.original),
        diagnostics: v2.std.diagnostic.None
      }
    v2.std.diagnostic.Rejected { diagnostics: d } => v2.std.diagnostic.Rejected { diagnostics: d }
  }
}

data witness_refinement_preservation_subject_anchor: Bool = match refinement_preservation_subject_base_value() {
  v2.std.diagnostic.Accepted { value: base, diagnostics: v2.std.diagnostic.None } => base == v2.lens.testgen.refinement_preservation_list_node(xs: [v2.test.manual.connective_anchors.stub_empty_conj])
  v2.std.diagnostic.Rejected { diagnostics: _ } => false
}

fn scheduled_refinement_preservation_generators() -> v2.std.diagnostic.Outcome<List<v2.lens.testgen.Generator<v2.lens.testgen.TestgenConcept>>> {
  v2.lens.testgen.testgen_scheduled_refinement_preservation_generators()
}

data witness_refinement_preservation_scheduler_emits_one_generator: Bool = match scheduled_refinement_preservation_generators() {
  v2.std.diagnostic.Accepted { value: generators, diagnostics: v2.std.diagnostic.None } => v2.std.algebra.length(xs: generators) == 1
  v2.std.diagnostic.Rejected { diagnostics: _ } => false
}
