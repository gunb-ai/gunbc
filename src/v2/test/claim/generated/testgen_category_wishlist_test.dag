module v2.test.generated.testgen_category_wishlist

type TestgenOracleBasis
  = StructuralConstructionWitness
  | AlgebraLawWitness
  | DiagnosticNegativeFixture
  | LensObservationFixture
  | RoundTripDifferential
  | FrozenIoSnapshot
  | RefinementProjectionWitness

type TestgenWishlistRow {
  generator: v2.std.diagnostic.Outcome<v2.lens.testgen.Generator<v2.lens.testgen.TestgenConcept>>
  oracle: TestgenOracleBasis
  dispatch_key: v2.std.node.Symbol
}
fn wishlist_type_construction_generator() -> v2.std.diagnostic.Outcome<v2.lens.testgen.Generator<v2.lens.testgen.TestgenConcept>> {
  v2.std.diagnostic.Accepted {
    value: v2.lens.testgen.Generator {
      kind: v2.std.verification.TestClaimCompilesClaimVariant,
      classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: v2.std.verification.Unit },
      anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
      slot: v2.lens.testgen.TypeConstruction {
        subject: v2.lens.testgen.ConnectiveKernel { connective: v2.std.node.Conj },
      },
      provenance: v2.lens.testgen.generator_provenance(id: ^wishlist_gen_id_type_construction),
      profile_metadata: v2.lens.testgen.default_generator_profile(),
    },
    diagnostics: v2.std.diagnostic.None,
  }
}

fn dispatched_algebra_law_generator() -> v2.std.diagnostic.Outcome<v2.lens.testgen.Generator<v2.lens.testgen.TestgenConcept>> {
  v2.std.diagnostic.Accepted {
    value: v2.lens.testgen.Generator {
      kind: v2.std.verification.TestClaimEqualsClaimVariant,
      classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: v2.std.verification.Unit },
      anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualNatAddAssociativity),
      slot: v2.lens.testgen.AlgebraLaw {
        subject: v2.lens.testgen.AlgebraLawSubject {
          algebra: ^nat_algebra_law_subject_symbol_additive_monoid,
          inhabitant: ^nat_algebra_law_subject_symbol_inhabitant_nat,
          law: ^law_nat_add_associativity,
        },
      },
      provenance: v2.lens.testgen.generator_provenance(id: ^wishlist_gen_id_algebra_law),
      profile_metadata: v2.lens.testgen.default_generator_profile(),
    },
    diagnostics: v2.std.diagnostic.None,
  }
}

fn dispatched_diagnostic_exhaustiveness_generator() -> v2.std.diagnostic.Outcome<v2.lens.testgen.Generator<v2.lens.testgen.TestgenConcept>> {
  v2.std.diagnostic.Accepted {
    value: v2.lens.testgen.Generator {
      kind: v2.std.verification.TestClaimDiagnosticClaimVariant,
      classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: v2.std.verification.Unit },
      anchor: v2.std.verification.generated_claim_anchor(
        anchor: v2.std.verification.GeneratedCoproductExhaustiveness {
          coproduct_type: ^TestClaim,
          omitted_variant: ^DiagnosticClaim,
        }
      ),
      slot: v2.lens.testgen.DiagnosticExhaustiveness {
        coproduct_type: ^TestClaim,
        omitted_variant: ^DiagnosticClaim,
      },
      provenance: v2.lens.testgen.generator_provenance(id: ^wishlist_gen_id_diagnostic_exhaustiveness),
      profile_metadata: v2.lens.testgen.default_generator_profile(),
    },
    diagnostics: v2.std.diagnostic.None,
  }
}

fn wishlist_lens_applicability_generator() -> v2.std.diagnostic.Outcome<v2.lens.testgen.Generator<v2.lens.testgen.TestgenConcept>> {
  v2.std.diagnostic.Accepted {
    value: v2.lens.testgen.Generator {
      kind: v2.std.verification.TestClaimCompilesClaimVariant,
      classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier2, layer: v2.std.verification.Integration },
      anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
      slot: v2.lens.testgen.LensApplicability {
        subject: v2.lens.testgen.LensApplicabilitySubject {
          lens: ^t19_generator_wishlist_lens_structural_resolution,
          program: v2.test.manual.connective_anchors.stub_empty_conj,
        },
      },
      provenance: v2.lens.testgen.generator_provenance(id: ^wishlist_gen_id_lens_applicability),
      profile_metadata: v2.lens.testgen.default_generator_profile(),
    },
    diagnostics: v2.std.diagnostic.None,
  }
}

fn wishlist_bidirectional_roundtrip_generator() -> v2.std.diagnostic.Outcome<v2.lens.testgen.Generator<v2.lens.testgen.TestgenConcept>> {
  v2.std.diagnostic.Accepted {
    value: v2.lens.testgen.Generator {
      kind: v2.std.verification.TestClaimRoundTripClaimVariant,
      classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier3, layer: v2.std.verification.Integration },
      anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
      slot: v2.lens.testgen.BidirectionalRoundtrip {
        subject: v2.lens.testgen.BidirectionalRoundtripSubject {
          language: ^dag_language_model_surface_id,
          production: ^t19_generator_wishlist_dag_surface_production,
        },
      },
      provenance: v2.lens.testgen.generator_provenance(id: ^wishlist_gen_id_bidirectional_roundtrip),
      profile_metadata: v2.lens.testgen.default_generator_profile(),
    },
    diagnostics: v2.std.diagnostic.None,
  }
}

fn dispatched_language_behavior_equivalence_generator() -> v2.std.diagnostic.Outcome<v2.lens.testgen.Generator<v2.lens.testgen.TestgenConcept>> {
  v2.std.diagnostic.Accepted {
    value: v2.lens.testgen.Generator {
      kind: v2.std.verification.TestClaimCompilesClaimVariant,
      classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: v2.std.verification.Unit },
      anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualLbeConjDagSurface),
      slot: v2.lens.testgen.LanguageBehaviorEquivalence {
        subject: v2.lens.testgen.lbe_subject_conj_dag_surface(),
        mock: v2.lens.testgen.lbe_io_mock_conj_dag_surface(),
      },
      provenance: v2.lens.testgen.generator_provenance(id: ^wishlist_gen_id_language_behavior_equivalence),
      profile_metadata: v2.lens.testgen.default_generator_profile(),
    },
    diagnostics: v2.std.diagnostic.None,
  }
}

fn dispatched_refinement_preservation_generator() -> v2.std.diagnostic.Outcome<v2.lens.testgen.Generator<v2.lens.testgen.TestgenConcept>> {
  match v2.lens.testgen.refinement_preservation_subject_nonempty_list_base() {
    Accepted { value: subject, diagnostics: d } =>
      v2.std.diagnostic.Accepted {
        value: v2.lens.testgen.Generator {
          kind: v2.std.verification.TestClaimEqualsClaimVariant,
          classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: v2.std.verification.Unit },
          anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualRefinementNonEmptyListBase),
          slot: v2.lens.testgen.RefinementPreservation {
            subject: subject,
          },
          provenance: v2.lens.testgen.generator_provenance(id: ^wishlist_gen_id_refinement_preservation),
          profile_metadata: v2.lens.testgen.default_generator_profile(),
        },
        diagnostics: d,
      }
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}

fn testgen_pending_non_tautological_generator_wishlist() -> std.types.List<TestgenWishlistRow> {
  [
    TestgenWishlistRow {
      generator: wishlist_type_construction_generator(),
      oracle: StructuralConstructionWitness,
      dispatch_key: ^t19_wishlist_type_construction_dispatch,
    },
    TestgenWishlistRow {
      generator: wishlist_lens_applicability_generator(),
      oracle: LensObservationFixture,
      dispatch_key: ^t19_wishlist_lens_applicability_dispatch,
    },
    TestgenWishlistRow {
      generator: wishlist_bidirectional_roundtrip_generator(),
      oracle: RoundTripDifferential,
      dispatch_key: ^t19_wishlist_bidirectional_roundtrip_dispatch,
    },
  ]
}

fn testgen_dispatched_non_tautological_generators() -> std.types.List<TestgenWishlistRow> {
  [
    TestgenWishlistRow {
      generator: dispatched_language_behavior_equivalence_generator(),
      oracle: FrozenIoSnapshot,
      dispatch_key: ^t19_dispatched_language_behavior_equivalence,
    },
    TestgenWishlistRow {
      generator: dispatched_algebra_law_generator(),
      oracle: AlgebraLawWitness,
      dispatch_key: ^t19_dispatched_algebra_law,
    },
    TestgenWishlistRow {
      generator: dispatched_diagnostic_exhaustiveness_generator(),
      oracle: DiagnosticNegativeFixture,
      dispatch_key: ^t19_dispatched_diagnostic_exhaustiveness,
    },
    TestgenWishlistRow {
      generator: dispatched_refinement_preservation_generator(),
      oracle: RefinementProjectionWitness,
      dispatch_key: ^t19_dispatched_refinement_preservation,
    },
  ]
}

test fn pending_non_tautological_generator_count_is_three() -> Bool {
  v2.std.algebra.length(xs: testgen_pending_non_tautological_generator_wishlist()) == 3
}

test fn dispatched_non_tautological_generator_count_is_four() -> Bool {
  v2.std.algebra.length(xs: testgen_dispatched_non_tautological_generators()) == 4
}
