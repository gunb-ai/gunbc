module v2.test.generated.testgen_category_wishlist

fn refinement_preservation_stub_locus() -> v2.std.diagnostic.Locus {
  v2.std.diagnostic.port_locus(port: ^refinement_preservation_stub_locus_port)
}

fn refinement_preservation_stub_admits(xs: List<v2.std.node.Node>) -> Bool {
  true
}

data refinement_preservation_stub_validation: v2.std.refinement.Validation<List<v2.std.node.Node>> = v2.std.refinement.Validation {
  reason: ^refinement_preservation_stub_invalid,
  admits: refinement_preservation_stub_admits
}

data refinement_preservation_stub_vacuous_validation: v2.std.refinement.VacuousValidation<List<v2.std.node.Node>> = v2.std.refinement.VacuousValidation {
  reason: ^refinement_preservation_stub_invalid,
  vacuous: v2.std.refinement.vacuous_admits_marker
}

fn refinement_preservation_stub_generator_refined_terminal() -> v2.std.refinement.Refined<List<v2.std.node.Node>> {
  v2.std.refinement.refined_vacuous_stub_pack(
    base: [v2.test.manual.connective_anchors.stub_empty_conj],
    by: refinement_preservation_stub_vacuous_validation,
    at: refinement_preservation_stub_locus()
  )
}

fn refinement_preservation_stub_generator_refined() -> v2.std.refinement.Refined<List<v2.std.node.Node>> {
  match v2.std.refinement.refine(
    base: [v2.test.manual.connective_anchors.stub_empty_conj],
    by: refinement_preservation_stub_validation,
    at: refinement_preservation_stub_locus()
  ) {
    Accepted { value: refined, diagnostics: _ } => refined
    Rejected { diagnostics: _ } => refinement_preservation_stub_generator_refined_terminal()
  }
}

type TestgenOracleBasis
  = StructuralConstructionWitness
  | AlgebraLawWitness
  | DiagnosticNegativeFixture
  | LensObservationFixture
  | RoundTripDifferential
  | FrozenIoSnapshot
  | RefinementProjectionWitness

type TestgenWishlistRow {
  generator: Generator<v2.lens.testgen.TestgenConcept>
  oracle: TestgenOracleBasis
  dispatch_key: v2.std.node.Symbol
}
fn wishlist_type_construction_generator() -> Generator<v2.lens.testgen.TestgenConcept> {
  v2.lens.testgen.Generator {
    kind: v2.std.verification.TestClaimCompilesClaimVariant,
    classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: v2.std.verification.Unit },
    anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
    slot: v2.lens.testgen.TypeConstruction {
      subject: v2.lens.testgen.ConnectiveKernel { connective: v2.std.node.Conj },
    },
    provenance: generator_provenance(id: ^wishlist_gen_id_type_construction),
    profile_metadata: default_generator_profile(),
  }
}

fn dispatched_algebra_law_generator() -> Generator<v2.lens.testgen.TestgenConcept> {
  v2.lens.testgen.Generator {
    kind: v2.std.verification.TestClaimEqualsClaimVariant,
    classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: v2.std.verification.Unit },
    anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualNatAddAssociativity),
    slot: v2.lens.testgen.AlgebraLaw {
      subject: v2.lens.testgen.AlgebraLawSubject {
        algebra: ^nat_algebra_law_subject_symbol_additive_monoid,
        inhabitant: ^nat_algebra_law_subject_symbol_inhabitant_nat,
        law: ^law_nat_add_associativity,
      },
    },
    provenance: generator_provenance(id: ^wishlist_gen_id_algebra_law),
    profile_metadata: default_generator_profile(),
  }
}

fn dispatched_diagnostic_exhaustiveness_generator() -> Generator<v2.lens.testgen.TestgenConcept> {
  v2.lens.testgen.Generator {
    kind: v2.std.verification.TestClaimDiagnosticClaimVariant,
    classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: v2.std.verification.Unit },
    anchor: v2.std.verification.generated_claim_anchor(
      anchor: v2.std.verification.GeneratedCoproductExhaustiveness {
        coproduct_type: ^TestClaim,
        omitted_variant: ^DiagnosticClaim,
      }
    ),
    slot: v2.lens.testgen.DiagnosticExhaustiveness {
      coproduct_type: ^TestClaim,
      omitted_variant: ^DiagnosticClaim,
    },
    provenance: generator_provenance(id: ^wishlist_gen_id_diagnostic_exhaustiveness),
    profile_metadata: default_generator_profile(),
  }
}

