  anchor: ManualLbeTransformDagSurface,
  label: lbe_label_transform_dag_surface,
  mock: lbe_io_mock_transform_dag_surface()
) {
  Pass => true
  SemanticMismatch { actual: _, falsification: _ } => false
    BuildFailed { actual: _, diagnostic: _ } => false
    RunFailed { actual: _, diagnostic: _ } => false
  Deferred { actual: _, diagnostic: _ } => false
}

data run_lbe_conj_via_run_test_claim: TestClaimRun<Node, RuntimeValue> = lbe_test_claim_run_from_emit(
  anchor: ManualLbeConjDagSurface,
  label: lbe_label_conj_dag_surface,
  mock: lbe_io_mock_conj_dag_surface()
)

data run_lbe_disj_via_run_test_claim: TestClaimRun<Node, RuntimeValue> = lbe_test_claim_run_from_emit(
  anchor: ManualLbeDisjDagSurface,
  label: lbe_label_disj_dag_surface,
  mock: lbe_io_mock_disj_dag_surface()
)

data run_lbe_transform_via_run_test_claim: TestClaimRun<Node, RuntimeValue> = lbe_test_claim_run_from_emit(
  anchor: ManualLbeTransformDagSurface,
  label: lbe_label_transform_dag_surface,
  mock: lbe_io_mock_transform_dag_surface()
)

fn lbe_witness_testgen_schedules_three_generators() -> Bool {
  length(xs: testgen_scheduled_language_behavior_generators()) == 3
}

fn lbe_witness_dag_surface_language_identity() -> Bool {
  lbe_io_mock_conj_dag_surface().snapshot.language == ^dag_language_model_surface_id
}

data witness_testgen_schedules_three_lbe_generators: Bool = lbe_witness_testgen_schedules_three_generators()

data witness_dag_surface_language_identity: Bool = lbe_witness_dag_surface_language_identity()
