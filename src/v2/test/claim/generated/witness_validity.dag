module v2.test.generated.witness_validity

import v2.std.diagnostic { Outcome }
import v2.std.node { Symbol }
import v2.std.witness { StructuralPropertyWitness }
import v2.std.find_witness {
  PreservationPredicate,
}
import v2.std.verification { TestClaim }
import v2.lens.testgen { testgen_emit_witness_validity_claim }
import v2.test.manual.connective_anchors { stub_empty_conj, stub_empty_disj }
data row_witness_validity_constraint_satisfaction_holds: Outcome<TestClaim> = testgen_emit_witness_validity_claim(
    label: "witness-validity: constraint-satisfaction holds (positive)",
    source_facts: stub_empty_conj,
    candidate: stub_empty_conj,
    predicate: PreservationPredicate {
      algebra: stub_empty_conj,
      preservation_rule: ^preservation_rule_constraint_satisfaction,
    },
    witness: StructuralPropertyWitness {
      property: ^preservation_rule_constraint_satisfaction,
      evidence: stub_empty_conj,
    }
  )

data row_witness_validity_property_symbol_mismatch: Outcome<TestClaim> = testgen_emit_witness_validity_claim(
    label: "witness-validity: property symbol mismatch (invalid witness)",
    source_facts: stub_empty_conj,
    candidate: stub_empty_conj,
    predicate: PreservationPredicate {
      algebra: stub_empty_conj,
      preservation_rule: ^preservation_rule_constraint_satisfaction,
    },
    witness: StructuralPropertyWitness {
      property: ^witness_validity_unrealized_rule,
      evidence: stub_empty_conj,
    }
  )

data row_witness_validity_evidence_node_mismatch: Outcome<TestClaim> = testgen_emit_witness_validity_claim(
    label: "witness-validity: evidence node mismatch (invalid witness)",
    source_facts: stub_empty_conj,
    candidate: stub_empty_conj,
    predicate: PreservationPredicate {
      algebra: stub_empty_conj,
      preservation_rule: ^preservation_rule_constraint_satisfaction,
    },
    witness: StructuralPropertyWitness {
      property: ^preservation_rule_constraint_satisfaction,
      evidence: stub_empty_disj,
    }
  )

data row_witness_validity_rule_not_realized: Outcome<TestClaim> = testgen_emit_witness_validity_claim(
    label: "witness-validity: preservation rule not realized",
    source_facts: stub_empty_conj,
    candidate: stub_empty_conj,
    predicate: PreservationPredicate {
      algebra: stub_empty_conj,
      preservation_rule: ^witness_validity_unrealized_rule,
    },
    witness: StructuralPropertyWitness {
      property: ^witness_validity_unrealized_rule,
      evidence: stub_empty_conj,
    }
  )
