module v2.test.generated.witness_validity

data row_witness_validity_constraint_satisfaction_holds: Outcome<v2.std.verification.TestClaim> = testgen_emit_witness_validity_claim(
    label: "witness-validity: constraint-satisfaction holds (positive)",
    source_facts: v2.test.manual.connective_anchors.stub_empty_conj,
    candidate: v2.test.manual.connective_anchors.stub_empty_conj,
    predicate: v2.std.find_witness.PreservationPredicate {
      algebra: v2.test.manual.connective_anchors.stub_empty_conj,
      preservation_rule: ^preservation_rule_constraint_satisfaction,
    },
    witness: v2.std.witness.StructuralPropertyWitness {
      property: ^preservation_rule_constraint_satisfaction,
      evidence: v2.test.manual.connective_anchors.stub_empty_conj,
    }
  )

