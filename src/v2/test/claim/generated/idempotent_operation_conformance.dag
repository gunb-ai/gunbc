module v2.test.generated.idempotent_operation_conformance

fn idempotent_operation_missing_semantics_diagnostic(node: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^idempotent_operation_eval_missing_semantics,
    at: v2.std.diagnostic.node_locus(node: node),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn idempotent_operation_allocate_literal(node: v2.std.node.Node, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.Rejected {
    diagnostics: v2.std.diagnostic.diagnostics_singleton(
      d: idempotent_operation_missing_semantics_diagnostic(node: node)
    )
  }
}

fn idempotent_operation_call_primitive(node: v2.std.node.Node, _args: List<v2.std.runtime.RuntimeValue>, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.Rejected {
    diagnostics: v2.std.diagnostic.diagnostics_singleton(
      d: idempotent_operation_missing_semantics_diagnostic(node: node)
    )
  }
}

fn idempotent_operation_choose_branch(node: v2.std.node.Node, _value: v2.std.runtime.RuntimeValue, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.Accepted { value: node, diagnostics: v2.std.diagnostic.None }
}

fn idempotent_operation_step_loop(node: v2.std.node.Node, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.ControlTransfer> {
  v2.std.diagnostic.Rejected {
    diagnostics: v2.std.diagnostic.diagnostics_singleton(
      d: idempotent_operation_missing_semantics_diagnostic(node: node)
    )
  }
}

fn idempotent_operation_bind_value(
  _key: v2.std.runtime.EnvironmentBindingKey,
  _value: v2.std.runtime.RuntimeValue,
  env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.EvaluationEnvironment> {
  v2.std.diagnostic.Accepted { value: env, diagnostics: v2.std.diagnostic.None }
}

fn idempotent_operation_interpretation_structure_witness() -> v2.std.runtime.InterpretationStructureWitness {
  v2.std.runtime.InterpretationStructureWitness {
    allocate_literal: ^idempotent_operation_eval_allocate_literal,
    call_primitive: ^idempotent_operation_eval_call_primitive,
    choose_branch: ^idempotent_operation_eval_choose_branch,
    step_loop: ^idempotent_operation_eval_step_loop,
    bind_value: ^idempotent_operation_eval_bind_value,
    choose_arm: ^runtime_reject_match_arm
  }
}

fn idempotent_operation_eval_context() -> v2.compiler.eval.EvalContext {
  v2.compiler.eval.eval_context_with_semantics(
    runtime_identity: ^idempotent_operation_eval_runtime,
    interpretation: v2.std.runtime.InterpretationAlgebra {
      value: v2.std.runtime.ValueInterpreter {
        allocate_literal: idempotent_operation_allocate_literal,
        identity: ^idempotent_operation_allocate_literal
      },
      transform: v2.std.runtime.TransformInterpreter {
        call_primitive: idempotent_operation_call_primitive,
        identity: ^idempotent_operation_call_primitive
      },
      branch: v2.std.runtime.BranchInterpreter {
        choose_branch: idempotent_operation_choose_branch,
        identity: ^idempotent_operation_choose_branch
      },
      loop: v2.std.runtime.LoopInterpreter {
        step_loop: idempotent_operation_step_loop,
        identity: ^idempotent_operation_step_loop
      },
      bind: v2.std.runtime.BindInterpreter {
        bind_value: idempotent_operation_bind_value,
        identity: ^idempotent_operation_bind_value
      },
    match: v2.std.runtime.MatchInterpreter {
      choose_arm: v2.std.runtime.runtime_reject_match_arm,
      identity: ^runtime_reject_match_arm    }
    },
    structure_witness: idempotent_operation_interpretation_structure_witness()
  )
}

fn idempotent_operation_inferred_facts(root: v2.std.node.Node) -> v2.compiler.inferred_tree.InferredFacts {
  v2.test.lens_common.infer_fixture.claim_inferred_facts_from_nodes(
    resolved: root,
    algebra: root,
    descent: v2.std.witness.Holds {
      value: v2.std.cardinality.TerminationProof {
        non_increasing: [],
        strict: v2.std.cardinality.RankingDimension { measured: ^idempotent_operation_descent_dimension }
      }
    }
  )
}

fn idempotent_operation_inferred_tree(root: v2.std.node.Node) -> v2.compiler.inferred_tree.InferredTree {
  let facts = idempotent_operation_inferred_facts(root: root)
  v2.compiler.inferred_tree.InferredTree {
    root: root,
    facts: std.types.Map {
      lookup: fn(_) {
        Present { value: facts }
      }
    }
  }
}

fn idempotent_operation_subject_from_claim(claim: v2.std.verification.TestClaim) -> v2.compiler.eval.TestClaimEvalSubject<v2.std.node.Node> {
  let input = v2.std.verification.test_claim_input(c: claim)
  v2.compiler.eval.eval_test_claim_subject(
    claim: claim,
    context: idempotent_operation_eval_context(),
    tree: idempotent_operation_inferred_tree(root: input),
    evaluator_pin: ^idempotent_operation_evaluator_pin
  )
}

fn idempotent_operation_run_via_test_claim(claim: v2.std.verification.TestClaim) -> v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue> {
  v2.compiler.eval.run_test_claim(subject: idempotent_operation_subject_from_claim(claim: claim))
}

fn idempotent_operation_generated_run(row: v2.std.diagnostic.Outcome<v2.std.verification.TestClaim>) -> v2.std.diagnostic.Outcome<v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>> {
  match row {
    Accepted { value: claim, diagnostics: None } =>
      v2.std.diagnostic.Accepted {
        value: idempotent_operation_run_via_test_claim(claim: claim),
        diagnostics: v2.std.diagnostic.None
      }
    Rejected { diagnostics: d } =>
      v2.std.diagnostic.Rejected { diagnostics: d }
  }
}

fn idempotent_operation_run_non_pass(row: v2.std.diagnostic.Outcome<v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>>) -> v2.std.logic.Bool {
  match row {
    Accepted { value: run, diagnostics: None } =>
      match run.verdict {
        Pass => false
        SemanticMismatch { actual: _, falsification: _ } => true
        BuildFailed { actual: _, diagnostic: _ } => true
        RunFailed { actual: _, diagnostic: _ } => true
        Deferred { actual: _, diagnostic: _ } => true
      }
    Rejected { diagnostics: _ } => true
  }
}

data generated_read_idempotent_operation_claim: v2.std.diagnostic.Outcome<v2.std.verification.TestClaim> = v2.lens.testgen.testgen_emit_idempotent_operation_claim(
  label: v2.lens.testgen.idempotent_label_read,
  subject: v2.std.effects.sample_read_subject,
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: v2.std.verification.Unit }
)

data generated_upsert_idempotent_operation_claim: v2.std.diagnostic.Outcome<v2.std.verification.TestClaim> = v2.lens.testgen.testgen_emit_idempotent_operation_claim(
  label: v2.lens.testgen.idempotent_label_upsert,
  subject: v2.std.effects.sample_upsert_subject,
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: v2.std.verification.Unit }
)

data generated_delete_idempotent_operation_claim: v2.std.diagnostic.Outcome<v2.std.verification.TestClaim> = v2.lens.testgen.testgen_emit_idempotent_operation_claim(
  label: v2.lens.testgen.idempotent_label_delete,
  subject: v2.std.effects.sample_delete_subject,
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: v2.std.verification.Unit }
)

data generated_create_if_absent_idempotent_operation_claim: v2.std.diagnostic.Outcome<v2.std.verification.TestClaim> = v2.lens.testgen.testgen_emit_idempotent_operation_claim(
  label: v2.lens.testgen.idempotent_label_create_if_absent,
  subject: v2.std.effects.sample_create_if_absent_subject,
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: v2.std.verification.Unit }
)

data generated_label_only_idempotent_skip: v2.std.diagnostic.Outcome<v2.std.verification.TestClaim> = v2.lens.testgen.testgen_emit_idempotent_operation_claim(
  label: "generated/idempotent_operation: skip label-only inhabitance without composable body",
  subject: v2.std.effects.sample_label_only_subject,
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: v2.std.verification.Unit }
)

fn generated_label_only_skip_is_rejected() -> v2.std.logic.Bool {
  match generated_label_only_idempotent_skip {
    Rejected { diagnostics: d } => d.head.reason == ^idempotent_operation_tautology_skip
    Accepted { value: _, diagnostics: _ } => false
  }
}

data generated_label_only_skip_pins_rejection: v2.std.logic.Bool = generated_label_only_skip_is_rejected()

data run_read_idempotent_operation_via_run_test_claim: v2.std.diagnostic.Outcome<v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>> = idempotent_operation_generated_run(
  row: generated_read_idempotent_operation_claim
)

data run_upsert_idempotent_operation_via_run_test_claim: v2.std.diagnostic.Outcome<v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>> = idempotent_operation_generated_run(
  row: generated_upsert_idempotent_operation_claim
)

data run_delete_idempotent_operation_via_run_test_claim: v2.std.diagnostic.Outcome<v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>> = idempotent_operation_generated_run(
  row: generated_delete_idempotent_operation_claim
)

data run_create_if_absent_idempotent_operation_via_run_test_claim: v2.std.diagnostic.Outcome<v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>> = idempotent_operation_generated_run(
  row: generated_create_if_absent_idempotent_operation_claim
)

data witness_read_idempotent_operation_run_non_pass: v2.std.logic.Bool = idempotent_operation_run_non_pass(
  row: run_read_idempotent_operation_via_run_test_claim
)

data witness_upsert_idempotent_operation_run_non_pass: v2.std.logic.Bool = idempotent_operation_run_non_pass(
  row: run_upsert_idempotent_operation_via_run_test_claim
)

data witness_delete_idempotent_operation_run_non_pass: v2.std.logic.Bool = idempotent_operation_run_non_pass(
  row: run_delete_idempotent_operation_via_run_test_claim
)

data witness_create_if_absent_idempotent_operation_run_non_pass: v2.std.logic.Bool = idempotent_operation_run_non_pass(
  row: run_create_if_absent_idempotent_operation_via_run_test_claim
)

fn generated_idempotent_operation_claim_rows() -> List<v2.std.diagnostic.Outcome<v2.std.verification.TestClaim>> {
  [
    generated_read_idempotent_operation_claim,
    generated_upsert_idempotent_operation_claim,
    generated_delete_idempotent_operation_claim,
    generated_create_if_absent_idempotent_operation_claim,
  ]
}

fn generated_idempotent_operation_sample_count_is_four() -> v2.std.logic.Bool {
  v2.std.algebra.length(xs: generated_idempotent_operation_claim_rows()) == 4
}

fn generated_idempotent_operation_scheduled_subject_count_is_four() -> v2.std.logic.Bool {
  v2.std.algebra.length(xs: v2.lens.testgen.testgen_scheduled_idempotent_operation_subjects()) == 4
}

fn generated_idempotent_operation_run_rows() -> List<v2.std.diagnostic.Outcome<v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>>> {
  [
    run_read_idempotent_operation_via_run_test_claim,
    run_upsert_idempotent_operation_via_run_test_claim,
    run_delete_idempotent_operation_via_run_test_claim,
    run_create_if_absent_idempotent_operation_via_run_test_claim,
  ]
}

fn generated_idempotent_operation_run_count_is_four() -> v2.std.logic.Bool {
  v2.std.algebra.length(xs: generated_idempotent_operation_run_rows()) == 4
}
