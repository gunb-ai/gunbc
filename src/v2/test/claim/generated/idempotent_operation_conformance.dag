module v2.test.generated.idempotent_operation_conformance

import v2.compiler.eval {
  EvalContext,
  TestClaimEvalSubject,
  TestClaimRun,
  eval_context_with_semantics,
  eval_test_claim_subject,
  run_test_claim
}
import v2.compiler.infer {
  InferredFacts,
  InferredTree
}
import v2.lens.testgen {
  testgen_emit_idempotent_operation_claim,
  testgen_scheduled_idempotent_operation_subjects,
  idempotent_label_create_if_absent,
  idempotent_label_delete,
  idempotent_label_read,
  idempotent_label_upsert
}
import v2.std.algebra { length }
import v2.std.cardinality { RankingDimension, TerminationProof }
import v2.std.collection { List, Map }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  diagnostics_singleton,
  node_locus
}
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.node { Node }
import v2.std.runtime {
  BindInterpreter,
  BranchInterpreter,
  ControlTransfer,
  EnvironmentBindingKey,
  EvaluationEnvironment,
  InterpretationAlgebra,
  InterpretationStructureWitness,
  LoopInterpreter,
  RuntimeValue,
  TransformInterpreter,
  ValueInterpreter,
  MatchInterpreter,
  runtime_reject_match_arm
}
import v2.std.verdict { verdict_establishes_divergence }
import v2.std.verification {
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  test_claim_input
}
import v2.std.witness { Holds }
import v2.std.effects {
  sample_create_if_absent_subject,
  sample_delete_subject,
  sample_label_only_subject,
  sample_read_subject,
  sample_upsert_subject
}
import v2.test.lens_common.infer_fixture { claim_inferred_facts_from_nodes }
fn idempotent_operation_missing_semantics_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: ^idempotent_operation_eval_missing_semantics,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn idempotent_operation_allocate_literal(node: Node, _env: EvaluationEnvironment) -> Outcome<RuntimeValue> {
  Rejected {
    diagnostics: diagnostics_singleton(
      d: idempotent_operation_missing_semantics_diagnostic(node: node)
    )
  }
}

fn idempotent_operation_call_primitive(node: Node, _args: List<RuntimeValue>, _env: EvaluationEnvironment) -> Outcome<RuntimeValue> {
  Rejected {
    diagnostics: diagnostics_singleton(
      d: idempotent_operation_missing_semantics_diagnostic(node: node)
    )
  }
}

fn idempotent_operation_choose_branch(node: Node, _value: RuntimeValue, _env: EvaluationEnvironment) -> Outcome<Node> {
  Accepted { value: node, diagnostics: None }
}

fn idempotent_operation_step_loop(node: Node, _env: EvaluationEnvironment) -> Outcome<ControlTransfer> {
  Rejected {
    diagnostics: diagnostics_singleton(
      d: idempotent_operation_missing_semantics_diagnostic(node: node)
    )
  }
}

fn idempotent_operation_bind_value(
  _key: EnvironmentBindingKey,
  _value: RuntimeValue,
  env: EvaluationEnvironment
) -> Outcome<EvaluationEnvironment> {
  Accepted { value: env, diagnostics: None }
}

fn idempotent_operation_interpretation_structure_witness() -> InterpretationStructureWitness {
  InterpretationStructureWitness {
    allocate_literal: ^idempotent_operation_eval_allocate_literal,
    call_primitive: ^idempotent_operation_eval_call_primitive,
    choose_branch: ^idempotent_operation_eval_choose_branch,
    step_loop: ^idempotent_operation_eval_step_loop,
    bind_value: ^idempotent_operation_eval_bind_value,
    choose_arm: ^runtime_reject_match_arm
  }
}

fn idempotent_operation_eval_context() -> EvalContext {
  eval_context_with_semantics(
    runtime_identity: ^idempotent_operation_eval_runtime,
    interpretation: InterpretationAlgebra {
      value: ValueInterpreter {
        allocate_literal: idempotent_operation_allocate_literal,
        identity: ^idempotent_operation_allocate_literal
      },
      transform: TransformInterpreter {
        call_primitive: idempotent_operation_call_primitive,
        identity: ^idempotent_operation_call_primitive
      },
      branch: BranchInterpreter {
        choose_branch: idempotent_operation_choose_branch,
        identity: ^idempotent_operation_choose_branch
      },
      loop: LoopInterpreter {
        step_loop: idempotent_operation_step_loop,
        identity: ^idempotent_operation_step_loop
      },
      bind: BindInterpreter {
        bind_value: idempotent_operation_bind_value,
        identity: ^idempotent_operation_bind_value
      },
    match: MatchInterpreter {
      choose_arm: runtime_reject_match_arm,
      identity: ^runtime_reject_match_arm
    }
    },
    structure_witness: idempotent_operation_interpretation_structure_witness()
  )
}

fn idempotent_operation_inferred_facts(root: Node) -> InferredFacts {
  claim_inferred_facts_from_nodes(
    resolved: root,
    algebra: root,
    descent: Holds {
      value: v2.std.cardinality.TerminationProof {
        non_increasing: [],
        strict: v2.std.cardinality.RankingDimension { measured: ^idempotent_operation_descent_dimension }
      }
    }
  )
}

fn idempotent_operation_inferred_tree(root: Node) -> InferredTree {
  let facts = idempotent_operation_inferred_facts(root: root)
  InferredTree {
    root: root,
    facts: PartialFunction {
      lookup: fn(_) {
        Present { value: facts }
      }
    }
  }
}

fn idempotent_operation_subject_from_claim(claim: TestClaim) -> TestClaimEvalSubject<Node> {
  let input = test_claim_input(c: claim)
  eval_test_claim_subject(
    claim: claim,
    context: idempotent_operation_eval_context(),
    tree: idempotent_operation_inferred_tree(root: input),
    evaluator_pin: ^idempotent_operation_evaluator_pin
  )
}

fn idempotent_operation_run_via_test_claim(claim: TestClaim) -> TestClaimRun<Node, RuntimeValue> {
  run_test_claim(subject: idempotent_operation_subject_from_claim(claim: claim))
}

fn idempotent_operation_generated_run(row: Outcome<TestClaim>) -> Outcome<TestClaimRun<Node, RuntimeValue>> {
  match row {
    Accepted { value: claim, diagnostics: ds } =>
      Accepted {
        value: idempotent_operation_run_via_test_claim(claim: claim),
        diagnostics: ds
      }
    Rejected { diagnostics: d } =>
      Rejected { diagnostics: d }
  }
}

// THE SHARPEST LIVE SPECIMEN OF CLAIM-ENTAILING EVIDENCE IN AN EXECUTING CONSUMER, and the reason
// this function changed rather than being left alone as "conservative".
//
// Its four consumers are `test fn`s that assert this answers TRUE
// (generated_idempotent_read_run_non_pass and its three siblings in
// v2.test.generated_conformance_floor). So TRUE is the PASSING value, and the predecessor answered
// true on five different paths:
//
//     SemanticMismatch -> true   the comparison ran and disagreed          <- the only real evidence
//     BuildFailed      -> true   the emitted crate did not compile
//     RunFailed        -> true   the process did not run
//     Deferred         -> true   the comparison was deferred
//     Rejected         -> true   the CLAIM ITSELF never constructed
//
// Four of those five are ways of NOT MEASURING the operation, and every one of them made the
// assertion pass. The predicate's truth set was wider than the proposition it was cited to prove
// (an idempotency claim about a generated operation), which is the exact aliasing shape the
// evidence rule names -- and unlike its siblings in this migration, here the aliasing points the
// DANGEROUS way. A `*_is_pass` fold that answers false for a broken toolchain is wrong but
// conservative: the test goes red and someone looks. This one goes GREEN when nothing was measured,
// so a total collapse of the emitter would be indistinguishable from four conformance claims
// holding.
//
// The repair is the legal projection and nothing more: a non-pass claim is established only by a
// comparison that RAN and DIVERGED. A claim that would not construct is an instrument refusal and
// establishes nothing, so `Rejected` now answers false where it used to answer true.
fn idempotent_operation_run_non_pass(row: Outcome<TestClaimRun<Node, RuntimeValue>>) -> Bool {
  match row {
    Accepted { value: run, diagnostics: _ } =>
      verdict_establishes_divergence(v: run.verdict)
    Rejected { diagnostics: _ } => false
  }
}

data generated_read_idempotent_operation_claim: Outcome<TestClaim> = testgen_emit_idempotent_operation_claim(
  label: idempotent_label_read,
  subject: sample_read_subject,
  classification: TestClassification { tier: Tier1, layer: Unit }
)

data generated_upsert_idempotent_operation_claim: Outcome<TestClaim> = testgen_emit_idempotent_operation_claim(
  label: idempotent_label_upsert,
  subject: sample_upsert_subject,
  classification: TestClassification { tier: Tier1, layer: Unit }
)

data generated_delete_idempotent_operation_claim: Outcome<TestClaim> = testgen_emit_idempotent_operation_claim(
  label: idempotent_label_delete,
  subject: sample_delete_subject,
  classification: TestClassification { tier: Tier1, layer: Unit }
)

data generated_create_if_absent_idempotent_operation_claim: Outcome<TestClaim> = testgen_emit_idempotent_operation_claim(
  label: idempotent_label_create_if_absent,
  subject: sample_create_if_absent_subject,
  classification: TestClassification { tier: Tier1, layer: Unit }
)

data generated_label_only_idempotent_skip: Outcome<TestClaim> = testgen_emit_idempotent_operation_claim(
  label: "generated/idempotent_operation: skip label-only inhabitance without composable body",
  subject: sample_label_only_subject,
  classification: TestClassification { tier: Tier1, layer: Unit }
)

fn generated_label_only_skip_is_rejected() -> Bool {
  match generated_label_only_idempotent_skip {
    Rejected { diagnostics: d } => d.head.reason == ^idempotent_operation_tautology_skip
    Accepted { value: _, diagnostics: _ } => false
  }
}

data generated_label_only_skip_pins_rejection: Bool = generated_label_only_skip_is_rejected()

data run_read_idempotent_operation_via_run_test_claim: Outcome<TestClaimRun<Node, RuntimeValue>> = idempotent_operation_generated_run(
  row: generated_read_idempotent_operation_claim
)

data run_upsert_idempotent_operation_via_run_test_claim: Outcome<TestClaimRun<Node, RuntimeValue>> = idempotent_operation_generated_run(
  row: generated_upsert_idempotent_operation_claim
)

data run_delete_idempotent_operation_via_run_test_claim: Outcome<TestClaimRun<Node, RuntimeValue>> = idempotent_operation_generated_run(
  row: generated_delete_idempotent_operation_claim
)

data run_create_if_absent_idempotent_operation_via_run_test_claim: Outcome<TestClaimRun<Node, RuntimeValue>> = idempotent_operation_generated_run(
  row: generated_create_if_absent_idempotent_operation_claim
)

data witness_read_idempotent_operation_run_non_pass: Bool = idempotent_operation_run_non_pass(
  row: run_read_idempotent_operation_via_run_test_claim
)

data witness_upsert_idempotent_operation_run_non_pass: Bool = idempotent_operation_run_non_pass(
  row: run_upsert_idempotent_operation_via_run_test_claim
)

data witness_delete_idempotent_operation_run_non_pass: Bool = idempotent_operation_run_non_pass(
  row: run_delete_idempotent_operation_via_run_test_claim
)

data witness_create_if_absent_idempotent_operation_run_non_pass: Bool = idempotent_operation_run_non_pass(
  row: run_create_if_absent_idempotent_operation_via_run_test_claim
)

fn generated_idempotent_operation_claim_rows() -> List<Outcome<TestClaim>> {
  [
    generated_read_idempotent_operation_claim,
    generated_upsert_idempotent_operation_claim,
    generated_delete_idempotent_operation_claim,
    generated_create_if_absent_idempotent_operation_claim,
  ]
}

fn generated_idempotent_operation_sample_count_is_four() -> Bool {
  length(xs: generated_idempotent_operation_claim_rows()) == 4
}

fn generated_idempotent_operation_scheduled_subject_count_is_four() -> Bool {
  length(xs: testgen_scheduled_idempotent_operation_subjects()) == 4
}

fn generated_idempotent_operation_run_rows() -> List<Outcome<TestClaimRun<Node, RuntimeValue>>> {
  [
    run_read_idempotent_operation_via_run_test_claim,
    run_upsert_idempotent_operation_via_run_test_claim,
    run_delete_idempotent_operation_via_run_test_claim,
    run_create_if_absent_idempotent_operation_via_run_test_claim,
  ]
}

fn generated_idempotent_operation_run_count_is_four() -> Bool {
  length(xs: generated_idempotent_operation_run_rows()) == 4
}
