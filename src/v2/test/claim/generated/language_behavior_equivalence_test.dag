module v2.test.generated.language_behavior_equivalence



fn lbe_symbol_node(s: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn lbe_runtime_value() -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimePrimitive {
    value: v2.std.runtime.RuntimePrimitiveValue {
      primitive_type: lbe_symbol_node(s: ^lbe_runtime_value_symbol),
      bytes: []
    }
  }
}

fn lbe_runtime_diagnostic(n: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^lbe_interpretation_rejected,
    at: v2.std.diagnostic.node_locus(node: n),
    correction: v2.std.diagnostic.Unavailable { reason: AmbiguousIntent }
  }
}

fn lbe_allocate_literal(node: v2.std.node.Node, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.Rejected { diagnostics: v2.std.diagnostic.diagnostics_singleton(d: lbe_runtime_diagnostic(n: node)) }
}

fn lbe_call_primitive(_node: v2.std.node.Node, _args: List<v2.std.runtime.RuntimeValue>, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.Rejected {
    diagnostics: v2.std.diagnostic.diagnostics_singleton(d: lbe_runtime_diagnostic(n: _node))
  }
}

fn lbe_choose_branch(node: v2.std.node.Node, _value: v2.std.runtime.RuntimeValue, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.Rejected { diagnostics: v2.std.diagnostic.diagnostics_singleton(d: lbe_runtime_diagnostic(n: node)) }
}

fn lbe_step_loop(node: v2.std.node.Node, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.ControlTransfer> {
  v2.std.diagnostic.Rejected { diagnostics: v2.std.diagnostic.diagnostics_singleton(d: lbe_runtime_diagnostic(n: node)) }
}

fn lbe_bind_value(
  _key: v2.std.runtime.EnvironmentBindingKey,
  _value: v2.std.runtime.RuntimeValue,
  env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.EvaluationEnvironment> {
  v2.std.diagnostic.Accepted { value: env, diagnostics: v2.std.diagnostic.None }
}

fn lbe_inferred_facts(resolved: v2.std.node.Node) -> v2.compiler.inferred_tree.InferredFacts {
  v2.test.lens_common.infer_fixture.claim_inferred_facts_from_nodes(
    resolved: resolved,
    algebra: resolved,
    descent: v2.std.witness.Violates {
      diagnostic: v2.compiler.eval.eval_diagnostic(reason: ^eval_rejected_lbe_projection_deferred, node: resolved)
    }
  )
}

fn lbe_inferred_tree(root: v2.std.node.Node) -> v2.compiler.inferred_tree.InferredTree {
  let facts = lbe_inferred_facts(resolved: root)
  v2.compiler.inferred_tree.InferredTree {
    root: root,
    facts: std.types.Map {
      lookup: fn(_) {
        Present { value: facts }
      }
    }
  }
}

fn lbe_interpretation_structure_witness() -> v2.std.runtime.InterpretationStructureWitness {
  v2.std.runtime.InterpretationStructureWitness {
    allocate_literal: ^lbe_allocate_literal,
    call_primitive: ^lbe_call_primitive,
    choose_branch: ^lbe_choose_branch,
    step_loop: ^lbe_step_loop,
    bind_value: ^lbe_bind_value,    choose_arm: ^runtime_reject_match_arm
  }
}

fn lbe_eval_context() -> v2.compiler.eval.EvalContext {
  v2.compiler.eval.eval_context_with_semantics(
    runtime_identity: ^lbe_interpretation_pin,
    interpretation: v2.std.runtime.InterpretationAlgebra {
      value: v2.std.runtime.ValueInterpreter {
        allocate_literal: lbe_allocate_literal,
        identity: ^lbe_allocate_literal
      },
      transform: v2.std.runtime.TransformInterpreter {
        call_primitive: lbe_call_primitive,
        identity: ^lbe_call_primitive
      },
      branch: v2.std.runtime.BranchInterpreter {
        choose_branch: lbe_choose_branch,
        identity: ^lbe_choose_branch
      },
      loop: v2.std.runtime.LoopInterpreter {
        step_loop: lbe_step_loop,
        identity: ^lbe_step_loop
      },
      bind: v2.std.runtime.BindInterpreter {
        bind_value: lbe_bind_value,
        identity: ^lbe_bind_value
      },
    match: v2.std.runtime.MatchInterpreter {
      choose_arm: v2.std.runtime.runtime_reject_match_arm,
      identity: ^runtime_reject_match_arm    }
    },
    structure_witness: lbe_interpretation_structure_witness()
  )
}

fn lbe_claim_from_testgen_emit(
  anchor: v2.std.verification.ManualAnchorKey,
  label: String,
  mock: v2.lens.testgen.LanguageBehaviorIoMock
) -> v2.std.diagnostic.Outcome<v2.std.verification.TestClaim> {
  v2.lens.testgen.testgen_emit_language_behavior_equivalence_claim(anchor: anchor, label: label, mock: mock)
}

fn lbe_subject_from_claim(claim: v2.std.verification.TestClaim) -> v2.compiler.eval.TestClaimEvalSubject<v2.std.node.Node> {
  let input = v2.std.verification.test_claim_input(c: claim)
  v2.compiler.eval.TestClaimEvalSubject {
    claim: claim,
    context: lbe_eval_context(),
    tree: lbe_inferred_tree(root: input),
    input: v2.compiler.eval.test_claim_typed_input_node(
      evaluator_input: input,
      evaluator_pin: ^lbe_evaluator_pin
    )
  }
}

fn lbe_run_via_test_claim(claim: v2.std.verification.TestClaim) -> v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue> {
  v2.compiler.eval.run_test_claim(subject: lbe_subject_from_claim(claim: claim))
}

fn lbe_emit_rejection_sentinel_claim(
  label: String,
  mock: v2.lens.testgen.LanguageBehaviorIoMock,
  expected: v2.std.diagnostic.NonEmptyDiagnostics
) -> v2.std.verification.TestClaim {
  v2.std.verification.DiagnosticClaim {
    label: label,
    anchor: v2.std.verification.manual_claim_anchor(anchor: ManualAnchorAbsent),
    input: mock.snapshot.input_node,
    expected_rejection: expected,
    classification: v2.std.verification.TestClassification { tier: Tier1, layer: v2.std.verification.Unit }
  }
}

fn lbe_rejected_emit_cache_receipt(
  label: String,
  mock: v2.lens.testgen.LanguageBehaviorIoMock,
  expected: v2.std.diagnostic.NonEmptyDiagnostics
) -> v2.compiler.eval.TestClaimCacheReceipt<v2.std.node.Node> {
  let claim = lbe_emit_rejection_sentinel_claim(label: label, mock: mock, expected: expected)
  v2.compiler.eval.test_claim_cache_receipt(subject: lbe_subject_from_claim(claim: claim))
}

fn lbe_run_test_claim_assert_from_emit(
  anchor: v2.std.verification.ManualAnchorKey,
  label: String,
  mock: v2.lens.testgen.LanguageBehaviorIoMock
) -> v2.std.verdict.Verdict<v2.compiler.eval.TestClaimEvalSubject<v2.std.node.Node>, v2.std.node.Node> {
  match lbe_claim_from_testgen_emit(anchor: anchor, label: label, mock: mock) {
    Accepted { value: claim, diagnostics: None } =>
      lbe_run_test_claim_assert_from_mock(claim: claim, mock: mock)
    Rejected { diagnostics: d } =>
      v2.std.verdict.SemanticMismatch { actual: v2.std.diagnostic.Rejected { diagnostics: d }, falsification: v2.std.optional.Absent }
  }
}

fn lbe_test_claim_run_from_emit(
  anchor: v2.std.verification.ManualAnchorKey,
  label: String,
  mock: v2.lens.testgen.LanguageBehaviorIoMock
) -> v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue> {
  match lbe_claim_from_testgen_emit(anchor: anchor, label: label, mock: mock) {
    Accepted { value: claim, diagnostics: None } =>
      lbe_run_via_test_claim(claim: claim)
    Rejected { diagnostics: d } =>
      v2.compiler.eval.TestClaimRun {
        cache: lbe_rejected_emit_cache_receipt(label: label, mock: mock, expected: d),
        verdict: v2.std.verdict.SemanticMismatch { actual: v2.std.diagnostic.Rejected { diagnostics: d }, falsification: v2.std.optional.Absent }
      }
  }
}

fn lbe_mock_actual(mock: v2.lens.testgen.LanguageBehaviorIoMock) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.Accepted {
    value: mock.snapshot.expected_value,
    diagnostics: v2.std.diagnostic.None
  }
}

fn lbe_run_test_claim_assert_from_mock(
  claim: v2.std.verification.TestClaim,
  mock: v2.lens.testgen.LanguageBehaviorIoMock
) -> v2.std.verdict.Verdict<v2.compiler.eval.TestClaimEvalSubject<v2.std.node.Node>, v2.std.node.Node> {
  v2.compiler.eval.run_test_claim_assert(
    claim: claim,
    actual: lbe_mock_actual(mock: mock),
    at: mock.snapshot.input_node
  )
}

data witness_lbe_conj_snapshot_pass: Bool = match lbe_run_test_claim_assert_from_emit(
  anchor: ManualLbeConjDagSurface,
  label: v2.lens.testgen.lbe_label_conj_dag_surface,
  mock: v2.lens.testgen.lbe_io_mock_conj_dag_surface()
) {
  Pass => true
  SemanticMismatch { actual: _, falsification: _ } => false
    BuildFailed { actual: _, diagnostic: _ } => false
    RunFailed { actual: _, diagnostic: _ } => false
  Deferred { actual: _, diagnostic: _ } => false
}

data witness_lbe_disj_snapshot_pass: Bool = match lbe_run_test_claim_assert_from_emit(
  anchor: ManualLbeDisjDagSurface,
  label: v2.lens.testgen.lbe_label_disj_dag_surface,
  mock: v2.lens.testgen.lbe_io_mock_disj_dag_surface()
) {
  Pass => true
  SemanticMismatch { actual: _, falsification: _ } => false
    BuildFailed { actual: _, diagnostic: _ } => false
    RunFailed { actual: _, diagnostic: _ } => false
  Deferred { actual: _, diagnostic: _ } => false
}

data witness_lbe_transform_snapshot_pass: Bool = match lbe_run_test_claim_assert_from_emit(
  anchor: ManualLbeTransformDagSurface,
  label: v2.lens.testgen.lbe_label_transform_dag_surface,
  mock: v2.lens.testgen.lbe_io_mock_transform_dag_surface()
) {
  Pass => true
  SemanticMismatch { actual: _, falsification: _ } => false
    BuildFailed { actual: _, diagnostic: _ } => false
    RunFailed { actual: _, diagnostic: _ } => false
  Deferred { actual: _, diagnostic: _ } => false
}

data run_lbe_conj_via_run_test_claim: v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue> = lbe_test_claim_run_from_emit(
  anchor: ManualLbeConjDagSurface,
  label: v2.lens.testgen.lbe_label_conj_dag_surface,
  mock: v2.lens.testgen.lbe_io_mock_conj_dag_surface()
)

data run_lbe_disj_via_run_test_claim: v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue> = lbe_test_claim_run_from_emit(
  anchor: ManualLbeDisjDagSurface,
  label: v2.lens.testgen.lbe_label_disj_dag_surface,
  mock: v2.lens.testgen.lbe_io_mock_disj_dag_surface()
)

data run_lbe_transform_via_run_test_claim: v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue> = lbe_test_claim_run_from_emit(
  anchor: ManualLbeTransformDagSurface,
  label: v2.lens.testgen.lbe_label_transform_dag_surface,
  mock: v2.lens.testgen.lbe_io_mock_transform_dag_surface()
)

fn lbe_witness_testgen_schedules_three_generators() -> Bool {
  v2.std.algebra.length(xs: v2.lens.testgen.testgen_scheduled_language_behavior_generators()) == 3
}

fn lbe_witness_dag_surface_language_identity() -> Bool {
  v2.lens.testgen.lbe_io_mock_conj_dag_surface().snapshot.language == ^dag_language_model_surface_id
}

data witness_testgen_schedules_three_lbe_generators: Bool = lbe_witness_testgen_schedules_three_generators()

data witness_dag_surface_language_identity: Bool = lbe_witness_dag_surface_language_identity()
