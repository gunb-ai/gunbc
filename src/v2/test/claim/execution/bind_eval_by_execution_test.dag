module v2.test.execution.bind_eval_by_execution


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn bind_atom(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    occurrence_id: SyntheticOccurrence,
    children: []
  }
}

fn bind_byte() -> Byte {
  Byte { bits: [true] }
}

fn bind_i64_node() -> Node {
  bind_atom(s: ^bind_i64)
}

fn bind_int_value(bytes: List<Byte>) -> RuntimeValue {
  RuntimePrimitive {
    value: RuntimePrimitiveValue {
      primitive_type: bind_i64_node(),
      bytes: bytes
    }
  }
}

fn bind_one_value() -> RuntimeValue {
  bind_int_value(bytes: [bind_byte()])
}

fn bind_two_value() -> RuntimeValue {
  bind_int_value(bytes: [bind_byte(), bind_byte()])
}

fn bind_literal_one_node() -> Node {
  dag_int_literal_fixture_one()
}

fn bind_literal_two_node() -> Node {
  dag_int_literal_fixture_two()
}

fn bind_runtime_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^bind_runtime_rejected,
    at: node_locus(node: n),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn bind_runtime_int_is_one(value: RuntimeValue) -> Bool {
  match value {
    RuntimePrimitive { value: p } =>
      (p.primitive_type == bind_i64_node()) && (count(p.bytes) == 1)
    _ => false
  }
}

fn bind_runtime_int_is_two(value: RuntimeValue) -> Bool {
  match value {
    RuntimePrimitive { value: p } =>
      (p.primitive_type == bind_i64_node()) && (count(p.bytes) == 2)
    _ => false
  }
}

fn bind_allocate_literal(node: Node, _env: EvaluationEnvironment) -> Outcome<RuntimeValue> {
  if dag_node_is_int_literal_atom(node: node) {
    match dag_int_literal_magnitude_int_from_node(node: node) {
      Accepted { value: mag, diagnostics: _ } =>
        if mag == 1 {
          outcome_accepted(value: bind_one_value())
        } else if mag == 2 {
          outcome_accepted(value: bind_two_value())
        } else {
          outcome_rejected(d: bind_runtime_diagnostic(n: node))
        }
      Rejected { diagnostics: d } => Rejected { diagnostics: d }
    }
  } else {
    outcome_rejected(d: bind_runtime_diagnostic(n: node))
  }
}

fn bind_call_primitive(
  _node: Node,
  _args: List<RuntimeValue>,
  _env: EvaluationEnvironment
) -> Outcome<RuntimeValue> {
  outcome_rejected(d: bind_runtime_diagnostic(n: _node))
}

fn bind_choose_branch(
  node: Node,
  _condition: RuntimeValue,
  _env: EvaluationEnvironment
) -> Outcome<Node> {
  outcome_rejected(d: bind_runtime_diagnostic(n: node))
}

fn bind_step_loop(node: Node, _env: EvaluationEnvironment) -> Outcome<ControlTransfer> {
  outcome_rejected(d: bind_runtime_diagnostic(n: node))
}

fn bind_bind_value(
  key: EnvironmentBindingKey,
  value: RuntimeValue,
  env: EvaluationEnvironment
) -> Outcome<EvaluationEnvironment> {
  Accepted {
    value: EvaluationEnvironment {
      bindings: map_insert(m: env.bindings, key: key, value: value)
    },
    diagnostics: None
  }
}

fn bind_interpretation() -> InterpretationAlgebra {
  InterpretationAlgebra {
    value: ValueInterpreter {
      allocate_literal: bind_allocate_literal
    },
    transform: TransformInterpreter {
      call_primitive: bind_call_primitive
    },
    branch: BranchInterpreter {
      choose_branch: bind_choose_branch
    },
    loop: LoopInterpreter {
      step_loop: bind_step_loop
    },
    bind: BindInterpreter {
      bind_value: bind_bind_value
    },
    match: MatchInterpreter {
      choose_arm: runtime_reject_match_arm
    }
  }
}

fn bind_interpretation_structure_witness() -> InterpretationStructureWitness {
  InterpretationStructureWitness {
    allocate_literal: ^bind_allocate_literal_sym,
    call_primitive: ^bind_call_primitive_sym,
    choose_branch: ^bind_choose_branch_sym,
    step_loop: ^bind_step_loop_sym,
    bind_value: ^bind_bind_value_sym,
    choose_arm: ^runtime_reject_match_arm
  }
}

fn bind_context() -> EvalContext {
  eval_context_with_semantics(
    runtime_identity: ^bind_runtime_id,
    interpretation: bind_interpretation(),
    structure_witness: bind_interpretation_structure_witness()
  )
}

fn bind_pick_call(callee: Node) -> Node {
  Node {
    kind: ComputationNode { behavior: Transform },
    occurrence_id: SyntheticOccurrence,
    children: [
      Edge { label: Positional, target: callee }
    ]
  }
}

fn bind_tree_root(call: Node, expected: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    occurrence_id: SyntheticOccurrence,
    children: [
      Edge { label: Named { name: ^bind_actual }, target: call },
      Edge { label: Named { name: ^bind_expected }, target: expected }
    ]
  }
}

fn bind_facts_lookup(key: Node) -> Witness<InferredFacts> {
  Holds {
    value: claim_inferred_facts_from_nodes(
      resolved: key,
      algebra: bind_i64_node(),
      descent: termination_proof_witness_for_node(n: key)
    )
  }
}

fn bind_admitted_tree(root: Node) -> InferredTree {
  InferredTree {
    root: root,
    facts: Map {
      lookup: bind_facts_lookup
    }
  }
}

fn bind_inferred_run_tree(callee: Node, expected: Node) -> Outcome<InferredTree> {
  let call = bind_pick_call(callee: callee)
  let root = bind_tree_root(call: call, expected: expected)
  outcome_accepted(value: bind_admitted_tree(root: root))
}

fn bind_claim(input: Node, expected: Node) -> TestClaim {
  CompilesClaim {
    label: "manual/bind: source-bridged let-in Bind.body executes through eval",
    anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
    input: input,
    expected_value: expected,
    classification: TestClassification { tier: Tier1, layer: Unit }
  }
}

fn bind_subject(
  tree: InferredTree,
  input: Node,
  expected: Node
) -> TestClaimEvalSubject<Node> {
  TestClaimEvalSubject {
    claim: bind_claim(input: input, expected: expected),
    context: bind_context(),
    tree: tree,
    input: test_claim_typed_input_node(
      evaluator_input: input,
      evaluator_pin: ^bind_pick_call_pin
    )
  }
}

fn bind_run(
  callee: Node,
  expected: Node
) -> Outcome<TestClaimRun<Node, RuntimeValue>> {
  let input = bind_pick_call(callee: callee)
  bind_outcome(
    o: bind_inferred_run_tree(callee: callee, expected: expected),
    f: fn(tree) {
      outcome_accepted(
        value: run_test_claim(
          subject: bind_subject(tree: tree, input: input, expected: expected)
        )
      )
    }
  )
}

fn bind_run_passes(run: Outcome<TestClaimRun<Node, RuntimeValue>>) -> Bool {
  match run {
    Accepted { value: r, diagnostics: _ } =>
      match test_claim_run_verdict(run: r) {
        Pass => true
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn bind_source_pipeline_admits_holds() -> Bool {
  match table_fixture_bind_arrow_with_body() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn bind_source_driven_executes_holds() -> Bool {
  match table_fixture_bind_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      bind_run_passes(
        run: bind_run(
          callee: arrow,
          expected: bind_literal_one_node()
        )
      )
    Rejected { diagnostics: _ } => false
  }
}

fn bind_direct_runtime_holds() -> Bool {
  match table_fixture_bind_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } => {
      let input = bind_pick_call(callee: arrow)
      match bind_inferred_run_tree(
        callee: arrow,
        expected: bind_literal_one_node()
      ) {
        Accepted { value: tree, diagnostics: _ } =>
          match eval(
            tree: tree,
            interpretation: bind_interpretation(),
            inputs: inputs_root_only(root: input)
          ) {
            Accepted { value: actual, diagnostics: None } =>
              bind_runtime_int_is_one(value: actual)
            _ => false
          }
        Rejected { diagnostics: _ } => false
      }
    }
    Rejected { diagnostics: _ } => false
  }
}

fn bind_value_perturbation_red_holds() -> Bool {
  match table_fixture_bind_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      bind_run_passes(
        run: bind_run(
          callee: arrow,
          expected: bind_literal_two_node()
        )
      ) == false
    Rejected { diagnostics: _ } => false
  }
}

fn bind_fixture_producer_holds() -> Bool {
  match table_fixture_bind_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      bind_run_passes(
        run: bind_run(
          callee: arrow,
          expected: bind_literal_one_node()
        )
      )
    Rejected { diagnostics: _ } => false
  }
}

fn bind_fixture_wrong_value_red_holds() -> Bool {
  match table_fixture_bind_wrong_value_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      bind_run_passes(
        run: bind_run(
          callee: arrow,
          expected: bind_literal_one_node()
        )
      ) == false
    Rejected { diagnostics: _ } => false
  }
}

fn bind_census_ingested_executes_holds() -> Bool {
  match ingested_bind_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      bind_run_passes(
        run: bind_run(
          callee: arrow,
          expected: bind_literal_one_node()
        )
      )
    Rejected { diagnostics: _ } => false
  }
}

fn bind_census_ingested_wrong_value_red_holds() -> Bool {
  match ingested_bind_arrow_with_body_wrong_value() {
    Accepted { value: arrow, diagnostics: _ } =>
      bind_run_passes(
        run: bind_run(
          callee: arrow,
          expected: bind_literal_one_node()
        )
      ) == false
    Rejected { diagnostics: _ } => false
  }
}

test fn bind_eval_by_execution_keystone_holds() -> Bool {
  bind_source_driven_executes_holds()
    && bind_direct_runtime_holds()
    && bind_source_pipeline_admits_holds()
    && bind_value_perturbation_red_holds()
    && bind_fixture_producer_holds()
    && bind_fixture_wrong_value_red_holds()
}
