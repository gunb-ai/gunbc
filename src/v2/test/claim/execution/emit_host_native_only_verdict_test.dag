module v2.test.execution.emit_host_native_only_verdict

import v2.compiler.emit { emit }
import v2.compiler.emit_host { emit_host_octets_byte_string, run_emit_host }
import v2.compiler.eval { inputs_root_only }
import v2.extdeps.languages.rust_test { rust_classical_not_ingested_target_model_staging }
import v2.test.execution.emit_host_classical_not_ingested_equals_eval {
  ingested_classical_not_source,
  ingested_classical_not_swapped_source,
  ingested_inferred_tree_from_source,
}
import v2.std.diagnostic { Accepted, Rejected, Outcome, None }
import v2.std.host_run { HostLogicalRun }
import v2.std.logic { Bool }
import v2.std.text { String }
import v2.std.integer { Int }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data emit_host_native_only_verdict_note: String = "Kernel-D Stage 2 (parent sharp-bee-290 msg_9bf66b9b/msg_fe5a876e): the floor's verdict here is decided SOLELY by the emitted native run's own decoded stdout compared against a fixed expected octet constant chosen by the test author -- eval() never runs for classical_not's body in this chain, so v1_interpreter is not load-bearing for the semantics under test (axis (a): witness-body-runs-native; axis (b), the .dag host/meta-orchestration itself running natively, is Gate 1/emitter self-hosting and out of scope here -- this file's own control flow still executes via v1_interpreter today). The underlying compare-to-fixed-octet shape already existed, entangled inside the emit-on-demand caching witness (classical_not_family_cached_run_with_source); this file surfaces it as its own standalone, clearly-named claim rather than re-deriving a second copy (DESIGN.md S2)."

data native_eval_batch: List<String> = [
  "emit_host_native_only_classical_not_holds",
  "emit_host_native_only_classical_not_swapped_mismatch_detected_holds",
]

fn native_only_matches_expected(source: String, expected_octet: Int) -> Bool {
  match ingested_inferred_tree_from_source(source: source) {
    Accepted { value: tree, diagnostics: _ } =>
      match emit(tree: tree, target: rust_classical_not_ingested_target_model_staging()) {
        Accepted { value: emitted, diagnostics: _ } =>
          match run_emit_host(
            target: rust_classical_not_ingested_target_model_staging(),
            source: emitted,
            fixture_inputs: inputs_root_only(root: tree.root)
          ) {
            Accepted { value: receipt, diagnostics: _ } =>
              match receipt.logical_run {
                Accepted { value: HostLogicalRun { stdout: stdout }, diagnostics: None } =>
                  stdout.bytes == emit_host_octets_byte_string(octets: [0, expected_octet, 0, 0, 0])
                _ => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_host_native_only_classical_not_holds() -> Bool {
  native_only_matches_expected(source: ingested_classical_not_source, expected_octet: 0)
}

test fn emit_host_native_only_classical_not_swapped_mismatch_detected_holds() -> Bool {
  native_only_matches_expected(source: ingested_classical_not_swapped_source, expected_octet: 0) == false
}

test fn emit_host_native_only_verdict_all_holds() -> Bool {
  emit_host_native_only_classical_not_holds()
    && emit_host_native_only_classical_not_swapped_mismatch_detected_holds()
}
