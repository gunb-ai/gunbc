module v2.test.claim.execution.eval_bind_non_bind_interpreter_rejects


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

test fn eval_bind_node_eval_rejects_value_interpreter_holds() -> Bool {
  let node = v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: Bind },
    occurrence_id: SyntheticOccurrence,
    children: []
  }
  let tree = v2.compiler.inferred_tree.InferredTree {
    root: node,
    facts: std.types.Map {
      lookup: fn(n) {
        Absent
      }
    }
  }
  match v2.compiler.eval.eval_bind_node_eval(
    node: node,
    tree: tree,
    interpretation: v2.compiler.eval.eval_default_interpretation(),
    interpreter: ValueRuntimeInterpreter {
      interpreter: v2.std.runtime.ValueInterpreter {
        allocate_literal: v2.extdeps.runtimes.v2_evaluator.v2_eval_allocate_literal,
        identity: ^v2.extdeps.runtimes.v2_evaluator.v2_eval_allocate_literal      }
    },
    environment: v2.compiler.eval.empty_evaluation_environment(),
    runtime: v2.compiler.eval.eval_runtime(),
    effect_io: EffectIoEvalAbsent
  ) {
    Rejected { diagnostics: d } => d.head.reason == ^eval_rejected_type_node
    Accepted { value: _, diagnostics: _ } => false
  }
}
