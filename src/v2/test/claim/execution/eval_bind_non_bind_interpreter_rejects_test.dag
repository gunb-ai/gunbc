module v2.test.claim.execution.eval_bind_non_bind_interpreter_rejects

import v2.compiler.eval {
  EffectIoEvalAbsent,
  empty_evaluation_environment,
  eval_bind_node_eval,
  eval_default_interpretation,
  eval_diagnostic,
  eval_runtime
}
import v2.compiler.infer { InferredTree }
import v2.extdeps.runtimes.v2_evaluator { v2_eval_wave1_allocate_literal }
import v2.std.collection { Map }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node {
  Bind,
  ComputationNode,
  Node,
  SyntheticOccurrence
}
import v2.std.runtime {
  ValueInterpreter,
  ValueRuntimeInterpreter
}
import v2.std.witness { Violates }

test fn eval_bind_node_eval_rejects_value_interpreter_holds() -> Bool {
  let node = Node {
    kind: ComputationNode { behavior: Bind },
    occurrence_id: SyntheticOccurrence,
    children: []
  }
  let tree = InferredTree {
    root: node,
    facts: Map {
      lookup: fn(n) {
        Violates {
          diagnostic: eval_diagnostic(reason: ^eval_rejected_type_node, node: n)
        }
      }
    }
  }
  match eval_bind_node_eval(
    node: node,
    tree: tree,
    interpretation: eval_default_interpretation(),
    interpreter: ValueRuntimeInterpreter {
      interpreter: ValueInterpreter {
        allocate_literal: v2_eval_wave1_allocate_literal
      }
    },
    environment: empty_evaluation_environment(),
    runtime: eval_runtime(),
    effect_io: EffectIoEvalAbsent
  ) {
    Rejected { diagnostics: d } => d.head.reason == ^eval_rejected_type_node
    Accepted { value: _, diagnostics: _ } => false
  }
}
