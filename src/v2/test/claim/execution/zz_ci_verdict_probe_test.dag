module v2.test.execution.zz_ci_verdict_probe

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn ciprobe_variant_ok_verdict() -> Verdict<TestClaimEvalSubject<Node>, RuntimeValue> {
  emit_variant_construct_eval_run(tree: emit_variant_construct_eval_tree).verdict
}

test fn ciprobe_variant_ok_is_pass() -> Bool {
  match ciprobe_variant_ok_verdict() {
    Pass => true
    _ => false
  }
}

test fn ciprobe_variant_ok_is_mismatch() -> Bool {
  match ciprobe_variant_ok_verdict() {
    SemanticMismatch { actual: _, falsification: _ } => true
    _ => false
  }
}

test fn ciprobe_variant_ok_is_build_failed() -> Bool {
  match ciprobe_variant_ok_verdict() {
    BuildFailed { actual: _, diagnostic: _ } => true
    _ => false
  }
}

test fn ciprobe_variant_ok_is_run_failed() -> Bool {
  match ciprobe_variant_ok_verdict() {
    RunFailed { actual: _, diagnostic: _ } => true
    _ => false
  }
}

test fn ciprobe_variant_ok_is_deferred() -> Bool {
  match ciprobe_variant_ok_verdict() {
    Deferred { actual: _, diagnostic: _ } => true
    _ => false
  }
}

