fn ciprobe_variant_ok_receipt() -> Outcome<EmitHostRunReceipt> {
  match emit(tree: emit_variant_construct_eval_tree, target: rust_variant_construct_target_model_staging()) {
    Accepted { value: source, diagnostics: _ } =>
      run_emit_host(target: rust_variant_construct_target_model_staging(), source: source, fixture_inputs: inputs_root_only(root: dag_variant_construct_body_fixture))
    Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
  }
}

fn ciprobe_variant_ok_exit_code() -> Optional<Int> {
  match ciprobe_variant_ok_receipt() {
    Accepted { value: rc, diagnostics: _ } =>
      match rc.exit.outcome {
        Accepted { value: Holds { value: ok }, diagnostics: _ } => Present { value: ok.code }
        _ => Absent
      }
    Rejected { diagnostics: _ } => Absent
  }
}

test fn ciprobe_variant_ok_receipt_accepted() -> Bool {
  match ciprobe_variant_ok_receipt() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn ciprobe_variant_ok_exit_ok_zero() -> Bool {
  match ciprobe_variant_ok_exit_code() {
    Present { value: c } => c == 0
    Absent => false
  }
}

test fn ciprobe_variant_ok_exit_violates() -> Bool {
  match ciprobe_variant_ok_receipt() {
    Accepted { value: rc, diagnostics: _ } =>
      match rc.exit.outcome {
        Accepted { value: Violates { diagnostic: _ }, diagnostics: _ } => true
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn ciprobe_variant_ok_logical_run_accepted() -> Bool {
  match ciprobe_variant_ok_receipt() {
    Accepted { value: rc, diagnostics: _ } =>
      match rc.logical_run {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn ciprobe_variant_ok_stderr_empty() -> Bool {
  match ciprobe_variant_ok_receipt() {
    Accepted { value: rc, diagnostics: _ } => is_empty(xs: rc.stderr_bytes)
    Rejected { diagnostics: _ } => false
  }
}

test fn ciprobe_variant_ok_build_log_empty() -> Bool {
  match ciprobe_variant_ok_receipt() {
    Accepted { value: rc, diagnostics: _ } => is_empty(xs: rc.build_log.lines)
    Rejected { diagnostics: _ } => false
  }
}

test fn ciprobe_variant_ok_compile_skipped() -> Bool {
  match ciprobe_variant_ok_receipt() {
    Accepted { value: rc, diagnostics: _ } => rc.compile_skipped
    Rejected { diagnostics: _ } => false
  }
}


