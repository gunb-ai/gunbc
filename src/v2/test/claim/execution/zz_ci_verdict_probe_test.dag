module v2.test.execution.zz_ci_verdict_probe

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn ciprobe_run_failed_reason(v: Verdict<TestClaimEvalSubject<Node>, RuntimeValue>) -> Optional<Symbol> {
  match v {
    RunFailed { actual: _, diagnostic: d } => Present { value: d.reason }
    _ => Absent
  }
}

fn ciprobe_run_failed_actual_reason(v: Verdict<TestClaimEvalSubject<Node>, RuntimeValue>) -> Optional<Symbol> {
  match v {
    RunFailed { actual: Rejected { diagnostics: ds }, diagnostic: _ } => Present { value: ds.head.reason }
    _ => Absent
  }
}

fn ciprobe_reason_is(o: Optional<Symbol>, want: Symbol) -> Bool {
  match o {
    Present { value: r } => r == want
    Absent => false
  }
}

fn ciprobe_variant_ok_verdict() -> Verdict<TestClaimEvalSubject<Node>, RuntimeValue> {
  emit_variant_construct_eval_run(tree: emit_variant_construct_eval_tree).verdict
}

test fn ciprobe_variant_ok_is_pass() -> Bool {
  match ciprobe_variant_ok_verdict() {
    Pass => true
    _ => false
  }
}

test fn ciprobe_variant_ok_is_mismatch() -> Bool {
  match ciprobe_variant_ok_verdict() {
    SemanticMismatch { actual: _, falsification: _ } => true
    _ => false
  }
}

test fn ciprobe_variant_ok_is_build_failed() -> Bool {
  match ciprobe_variant_ok_verdict() {
    BuildFailed { actual: _, diagnostic: _ } => true
    _ => false
  }
}

test fn ciprobe_variant_ok_is_run_failed() -> Bool {
  match ciprobe_variant_ok_verdict() {
    RunFailed { actual: _, diagnostic: _ } => true
    _ => false
  }
}

test fn ciprobe_variant_ok_is_deferred() -> Bool {
  match ciprobe_variant_ok_verdict() {
    Deferred { actual: _, diagnostic: _ } => true
    _ => false
  }
}

test fn ciprobe_variant_ok_rf_diag_exit_not_ok() -> Bool {
  ciprobe_reason_is(o: ciprobe_run_failed_reason(v: ciprobe_variant_ok_verdict()), want: ^emit_host_exit_not_ok)
}

test fn ciprobe_variant_ok_rf_actual_rejected() -> Bool {
  match ciprobe_run_failed_actual_reason(v: ciprobe_variant_ok_verdict()) {
    Present { value: _ } => true
    Absent => false
  }
}

test fn ciprobe_variant_ok_rf_actual_exit_not_ok() -> Bool {
  ciprobe_reason_is(o: ciprobe_run_failed_actual_reason(v: ciprobe_variant_ok_verdict()), want: ^emit_host_exit_not_ok)
}

test fn ciprobe_variant_ok_rf_actual_accepted() -> Bool {
  match ciprobe_variant_ok_verdict() {
    RunFailed { actual: Accepted { value: _, diagnostics: _ }, diagnostic: _ } => true
    _ => false
  }
}

