test fn ciprobe_english_witness_copy() -> Bool {
  let serialize_ok = english_emit_add_matches_serialize_holds()
  let grammar_ok = english_emit_add_grammar_inverse_holds()
  let ingest_ok = match english_emit_add_receipt {
    Rejected { diagnostics: _ } => false
    Accepted { value: source, diagnostics: _ } =>
      match english_emit_add_ingest_parse(source: source) {
        Accepted { value: tree, diagnostics: d } =>
          english_emit_add_parse_identity_matches(
            root: tree,
            expected: english_emit_add_emitted_root
          ) && (d == v2.std.diagnostic.None)
        Rejected { diagnostics: _ } => false
      }
  }
  serialize_ok && grammar_ok && ingest_ok
}

test fn ciprobe_english_original() -> Bool {
  english_emit_add_ingest_round_trip_holds()
}

type CiprobeScan {
  matched: Int
  found: Bool
}

fn ciprobe_bytes_contain(bs: ByteString, pattern: List<Int>) -> Bool {
  let n = length(xs: pattern)
  let r = fold_list(
    xs: bs,
    empty: CiprobeScan { matched: 0, found: false },
    cons: fn(acc, b) {
      if acc.found {
        acc
      } else {
        let want = match list_at_optional(xs: pattern, index: acc.matched) {
          Present { value: o } => emit_host_byte_from_octet(octet: o) == b
          Absent => false
        }
        let restart = match list_at_optional(xs: pattern, index: 0) {
          Present { value: o } => emit_host_byte_from_octet(octet: o) == b
          Absent => false
        }
        let m = if want { acc.matched + 1 } else if restart { 1 } else { 0 }
        CiprobeScan { matched: m, found: m == n }
      }
    }
  )
  r.found
}


