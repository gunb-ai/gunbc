    Accepted { value: source, diagnostics: _ } =>
      match target_serialize_source_from_model(target: target, emitted: (emit_variant_construct_eval_tree).root) {
        Accepted { value: authority, diagnostics: _ } => source == authority
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}


