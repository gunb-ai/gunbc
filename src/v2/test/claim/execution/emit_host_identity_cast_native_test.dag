module v2.test.execution.emit_host_identity_cast_native

import extdeps.communication.medium { Lossless, Medium }
import std.emit_on_demand { emit_on_demand_family_cache_root }
import v2.compiler.emit_host { emit_host_octets_byte_string, run_emit_host_cached_with_run_args }
import v2.compiler.eval { Inputs, inputs_root_only }
import v2.extdeps.languages.rust_test { rust_identity_cast_run_args, rust_identity_cast_target_model }
import v2.std.diagnostic { Accepted, None, Rejected }
import v2.std.host_run { EmitHostRunReceipt, HostLogicalRun }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { Node, node_synthetic }
import std.optional { Absent, Optional, Present, optional_absent, optional_present }
import v2.std.text { String }
import v2.std.witness { Violates }
import v2.test.claim.coercion.identity_cast_emission_route {
  IdentityCastClosureRefused, IdentityCastEntryEmitted, IdentityCastEntryRefused, identity_cast_route_verdict,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE ADMITTED IDENTITY CAST, BUILT AND RUN. v2.test.claim.coercion.identity_cast_emission_route
// establishes that `fn f(x: Int) -> Int { x as Int }` is admitted and reaches Rust on the source
// route; this module establishes what the emitted function DOES. The text under test is the entry
// member that route emits -- never a hand-written `f` -- and the host row
// (v2.extdeps.languages.rust_test rust_identity_cast_target_model) only reads the value from argv,
// calls it and frames the return value.
//
// STANDING, STATED SO IT IS NOT READ AS COVERAGE: this module is outside the required gate
// (v2.workflow.required_floor required_gate_authored_modules) by operator decision, because every
// run spawns the host build tool. The required floor therefore executes it ONLY as a changed witness
// (v2.workflow.floor_changed_witness) -- on a change that touches this module or its closure -- and
// nothing re-runs it between such changes. It is change-time native evidence, not standing
// regression enforcement. Its admission partner, v2.test.claim.coercion.identity_cast_emission_route,
// IS a gate row and runs on every required run. It is not a member of
// gunbc.guarantee_stall.self_host_wet_route_receipt_lifetime_stall's measured population and does
// not discharge that stall.
//
// ONE BUILD, REUSED: every run shares one workspace, so within a claim the second run must report
// compile_skipped -- the inputs are supplied to one artifact after it is built, and constant
// evaluation cannot have removed the operation under test. The inputs are distinct, include zero and
// a negative, and each expected frame is the input's own little-endian i32 bytes, so an `f` that
// returned a constant, or the magnitude, or dropped the sign, is false on at least one row.
data identity_cast_native_workspace: String = emit_on_demand_family_cache_root(family: "identity_cast_native")

fn identity_cast_native_inputs() -> Inputs {
  inputs_root_only(root: node_synthetic(kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^identity_cast_native_probe } }, children: []))
}

// The entry member's emitted text, read from the route module's shared verdict rather than emitted a
// second time: the text built here is the text the admission row asserted on. Absent when the route
// did not emit exactly the entry.
fn identity_cast_native_emitted() -> Optional<String> {
  match identity_cast_route_verdict() {
    IdentityCastEntryEmitted { text: t, members: n } => if n == 1 { optional_present(value: t) } else { optional_absent() }
    IdentityCastEntryRefused { reason: _, members: _ } => optional_absent()
    IdentityCastClosureRefused { reason: _ } => optional_absent()
  }
}

// One run of the emitted program on one argv value: true only when it exited through the logical-run
// arm, its compile-skip standing is the one expected, and its frame is exactly `octets`.
fn identity_cast_native_run_is(text: String, value: String, expect_skipped: Bool, octets: List<Int>) -> Bool {
  match run_emit_host_cached_with_run_args(
    workspace_dir: identity_cast_native_workspace,
    target: rust_identity_cast_target_model(),
    source: Medium { carried: text, fidelity: Lossless },
    fixture_inputs: identity_cast_native_inputs(),
    run_args: rust_identity_cast_run_args(value: value)
  ) {
    Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        Accepted { value: HostLogicalRun { stdout: stdout }, diagnostics: None } =>
          (!expect_skipped || receipt.compile_skipped)
            && stdout.bytes == emit_host_octets_byte_string(octets: octets)
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

// TWO INDEPENDENT PAIRS, NOT ONE CONJUNCTION: each run spawns the host build tool, and four in one
// claim measured 397ms cpu against the 302ms enrolment margin while two measured 212ms. The pairs
// share nothing but the artifact, so splitting them loses no coverage; within each pair the second
// run must reuse the build the first found or made. Positive and negative in one pair, zero and a
// value past 16 bits in the other.
test fn the_emitted_identity_cast_preserves_a_positive_and_a_negative_argument_holds() -> Bool {
  match identity_cast_native_emitted() {
    Absent => false
    Present { value: text } =>
      identity_cast_native_run_is(text: text, value: "7", expect_skipped: false, octets: [0, 7, 0, 0, 0])
        && identity_cast_native_run_is(text: text, value: "-17", expect_skipped: true, octets: [0, 239, 255, 255, 255])
  }
}

test fn the_emitted_identity_cast_preserves_zero_and_a_wide_argument_holds() -> Bool {
  match identity_cast_native_emitted() {
    Absent => false
    Present { value: text } =>
      identity_cast_native_run_is(text: text, value: "0", expect_skipped: false, octets: [0, 0, 0, 0, 0])
        && identity_cast_native_run_is(text: text, value: "70000", expect_skipped: true, octets: [0, 112, 17, 1, 0])
  }
}

// THE HOST FAILS RATHER THAN DEFAULTING. A malformed argument must end the invocation with a non-zero
// exit and no logical run -- not merely "not a zero frame", which a driver that defaulted to any
// other value would satisfy (review 5333329244: `.unwrap_or(9)` would frame 9 and pass). The valid
// run goes FIRST on the same artifact and must succeed, and the malformed run must report
// compile_skipped: so the failure is the run's, on an artifact that just built and ran, never a
// build or transport failure standing in for it.
fn identity_cast_native_run_fails_on_a_reused_build(text: String, value: String) -> Bool {
  match run_emit_host_cached_with_run_args(
    workspace_dir: identity_cast_native_workspace,
    target: rust_identity_cast_target_model(),
    source: Medium { carried: text, fidelity: Lossless },
    fixture_inputs: identity_cast_native_inputs(),
    run_args: rust_identity_cast_run_args(value: value)
  ) {
    Accepted { value: receipt, diagnostics: _ } =>
      receipt.compile_skipped
        && match receipt.exit.outcome {
          Accepted { value: Violates { diagnostic: _ }, diagnostics: _ } =>
            match receipt.logical_run {
              Accepted { value: _, diagnostics: _ } => false
              Rejected { diagnostics: _ } => true
            }
          _ => false
        }
    Rejected { diagnostics: _ } => false
  }
}

test fn a_malformed_runtime_argument_fails_the_invocation_holds() -> Bool {
  match identity_cast_native_emitted() {
    Absent => false
    Present { value: text } =>
      identity_cast_native_run_is(text: text, value: "3", expect_skipped: false, octets: [0, 3, 0, 0, 0])
        && identity_cast_native_run_fails_on_a_reused_build(text: text, value: "not-an-int")
  }
}
