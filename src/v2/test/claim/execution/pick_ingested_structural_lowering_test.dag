import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data pick_ingested_source: String = "module m\n\nfn pick(b: Bool) -> Int { if b { 1 } else { 2 } }\n"

data pick_ingested_swapped_source: String = "module m\n\nfn pick(b: Bool) -> Int { if b { 2 } else { 1 } }\n"

fn pick_eval_atom(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    occurrence_id: SyntheticOccurrence,
    children: []
  }
}

fn pick_eval_bool_type_node() -> Node {
  pick_eval_atom(s: ^pick_eval_bool_type)
}

fn pick_eval_i64_node() -> Node {
  pick_eval_atom(s: ^pick_eval_i64)
}

fn pick_eval_byte() -> Byte {
  Byte { bits: [true] }
}

fn pick_eval_int_value(bytes: List<Byte>) -> RuntimeValue {
  RuntimePrimitive {
    value: RuntimePrimitiveValue {
      primitive_type: pick_eval_i64_node(),
      bytes: bytes
    }
  }
}

fn pick_eval_bool_value(is_true: Bool) -> RuntimeValue {
  if is_true {
    RuntimePrimitive {
      value: RuntimePrimitiveValue {
        primitive_type: pick_eval_bool_type_node(),
        bytes: [pick_eval_byte()]
      }
    }
  } else {
    RuntimePrimitive {
      value: RuntimePrimitiveValue {
        primitive_type: pick_eval_bool_type_node(),
        bytes: Empty
      }
    }
  }
}

fn pick_eval_one_value() -> RuntimeValue {
  pick_eval_int_value(bytes: [pick_eval_byte()])
}

fn pick_eval_two_value() -> RuntimeValue {
  pick_eval_int_value(bytes: [pick_eval_byte(), pick_eval_byte()])
}

fn pick_eval_literal_one_node() -> Node {
  pick_eval_atom(s: ^dag_pick_lit_one)
}

fn pick_eval_literal_two_node() -> Node {
  pick_eval_atom(s: ^dag_pick_lit_two)
}

fn pick_eval_kw_true_node() -> Node {
  pick_eval_atom(s: ^dag_token_kw_true)
}

fn pick_eval_kw_false_node() -> Node {
  pick_eval_atom(s: ^dag_token_kw_false)
}

fn pick_eval_runtime_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^pick_eval_runtime_rejected,
    at: node_locus(node: n),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn pick_eval_literal_node_is_one(node: Node) -> Bool {
  node == pick_eval_literal_one_node()
    || node == pick_eval_atom(s: ^dag_binding_pick_lit_one)
}

fn pick_eval_literal_node_is_two(node: Node) -> Bool {
  node == pick_eval_literal_two_node()
    || node == pick_eval_atom(s: ^dag_binding_pick_lit_two)
}

fn pick_eval_allocate_literal(node: Node, _env: EvaluationEnvironment) -> Outcome<RuntimeValue> {
  if pick_eval_literal_node_is_one(node: node) {
    outcome_accepted(value: pick_eval_one_value())
  } else if pick_eval_literal_node_is_two(node: node) {
    outcome_accepted(value: pick_eval_two_value())
  } else if node == pick_eval_kw_true_node() {
    outcome_accepted(value: pick_eval_bool_value(is_true: true))
  } else if node == pick_eval_kw_false_node() {
    outcome_accepted(value: pick_eval_bool_value(is_true: false))
  } else {
    outcome_rejected(d: pick_eval_runtime_diagnostic(n: node))
  }
}

fn pick_eval_call_primitive(
  _node: Node,
  _args: List<RuntimeValue>,
  _env: EvaluationEnvironment
) -> Outcome<RuntimeValue> {
  outcome_rejected(d: pick_eval_runtime_diagnostic(n: _node))
}

fn pick_eval_runtime_bool_true(value: RuntimeValue) -> Bool {
  match value {
    RuntimePrimitive { value: p } =>
      (p.primitive_type == pick_eval_bool_type_node()) && (count(p.bytes) == 1)
    _ => false
  }
}

fn pick_eval_runtime_bool_false(value: RuntimeValue) -> Bool {
  match value {
    RuntimePrimitive { value: p } =>
      (p.primitive_type == pick_eval_bool_type_node()) && (count(p.bytes) == 0)
    _ => false
  }
}

fn pick_eval_runtime_int_is_one(value: RuntimeValue) -> Bool {
  match value {
    RuntimePrimitive { value: p } =>
      (p.primitive_type == pick_eval_i64_node()) && (count(p.bytes) == 1)
    _ => false
  }
}

fn pick_eval_runtime_int_is_two(value: RuntimeValue) -> Bool {
  match value {
    RuntimePrimitive { value: p } =>
      (p.primitive_type == pick_eval_i64_node()) && (count(p.bytes) == 2)
    _ => false
  }
}

fn pick_eval_nth_child_target(node: Node, wanted: Int) -> Outcome<Node> {
  match list_at_optional(xs: node.children, index: wanted) {
    Present { value: child } =>
      match child {
        Edge { label: _, target: arm } =>
          outcome_accepted(value: arm)
      }
    Absent =>
      outcome_rejected(d: pick_eval_runtime_diagnostic(n: node))
  }
}

fn pick_eval_choose_branch_bool_if_else(
  node: Node,
  condition: RuntimeValue,
  _env: EvaluationEnvironment
) -> Outcome<Node> {
  if count(node.children) == 3 {
    if pick_eval_runtime_bool_true(value: condition) {
      pick_eval_nth_child_target(node: node, wanted: 1)
    } else if pick_eval_runtime_bool_false(value: condition) {
      pick_eval_nth_child_target(node: node, wanted: 2)
    } else {
      outcome_rejected(d: pick_eval_runtime_diagnostic(n: node))
    }
  } else {
    outcome_rejected(d: pick_eval_runtime_diagnostic(n: node))
  }
}

fn pick_eval_step_loop(node: Node, _env: EvaluationEnvironment) -> Outcome<ControlTransfer> {
  outcome_rejected(d: pick_eval_runtime_diagnostic(n: node))
}

fn pick_eval_bind_value(
  key: EnvironmentBindingKey,
  value: RuntimeValue,
  env: EvaluationEnvironment
) -> Outcome<EvaluationEnvironment> {
  Accepted {
    value: EvaluationEnvironment {
      bindings: map_insert(m: env.bindings, key: key, value: value)
    },
    diagnostics: None
  }
}

fn pick_eval_interpretation() -> InterpretationAlgebra {
  InterpretationAlgebra {
    value: ValueInterpreter {
      allocate_literal: pick_eval_allocate_literal
    },
    transform: TransformInterpreter {
      call_primitive: pick_eval_call_primitive
    },
    branch: BranchInterpreter {
      choose_branch: pick_eval_choose_branch_bool_if_else
    },
    loop: LoopInterpreter {
      step_loop: pick_eval_step_loop
    },
    bind: BindInterpreter {
      bind_value: pick_eval_bind_value
    }
  }
}

fn pick_eval_interpretation_structure_witness() -> InterpretationStructureWitness {
  InterpretationStructureWitness {
    allocate_literal: ^pick_eval_allocate_literal_sym,
    call_primitive: ^pick_eval_call_primitive_sym,
    choose_branch: ^pick_eval_choose_branch_bool_if_else_sym,
    step_loop: ^pick_eval_step_loop_sym,
    bind_value: ^pick_eval_bind_value_sym,
    choose_arm: ^runtime_reject_match_arm
  }
}

fn pick_eval_context() -> EvalContext {
  eval_context_with_semantics(
    runtime_identity: ^pick_eval_runtime_id,
    interpretation: pick_eval_interpretation(),
    structure_witness: pick_eval_interpretation_structure_witness()
  )
}

data pick_ingested_eval_deferred_note: String = "ingested Int-literal operands in if arms are lexeme-stamped atoms, not grounded to the numeric tower — resolve and eval-equals are deferred until general Int-literal ingestion lands (migrate_when_general_body_producer_lands). Structural if_expr→Branch lowering is proven by normalized_branch + arm-lexeme swapped RED; fabricated pick-lit bridge deleted."

fn pick_ingested_normalized_module_from_source(source: String) -> Outcome<Node> {
  let lm = dag_language_model()
  bind_outcome(
    o: tokenize(text: source, file: ^pick_ingested_source_file, rules: lm.lex),
    f: fn(tokens) {
      bind_outcome(
        o: parse_module(tokens: tokens, grammar: lm.grammar),
        f: fn(artifact) {
          normalize(parse_tree: artifact.tree)
        }
      )
    }
  )
}

fn pick_ingested_find_arrow_in_module(root: Node) -> Optional<Node> {
  match root.kind {
    TypeNode { connective: Arrow } => Present { value: root }
    _ =>
      fold(root.children, init: Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => pick_ingested_find_arrow_in_module(root: e.target)
        }
      })
  }
}

fn pick_ingested_normalized_arrow_has_branch_body(source: String) -> Bool {
  match pick_ingested_normalized_module_from_source(source: source) {
    Accepted { value: normalized, diagnostics: _ } =>
      match pick_ingested_find_arrow_in_module(root: normalized) {
        Present { value: arrow } =>
          match find_arrow_body_child(root: arrow) {
            Accepted { value: body, diagnostics: _ } =>
              match body.kind {
                ComputationNode { behavior: Branch } => true
                _ => false
              }
            Rejected { diagnostics: _ } => false
          }
        Absent => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn pick_ingested_branch_arm_lexeme_optional(body: Node, arm_index: Int) -> Optional<String> {
  match list_at_optional(xs: body.children, index: arm_index) {
    Present { value: edge } =>
      match edge {
        Edge { label: _, target: arm } => pick_ingested_atom_lexeme_optional(node: arm)
      }
    Absent => Absent
  }
}

fn pick_ingested_atom_lexeme_optional(node: Node) -> Optional<String> {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } =>
      Present { value: symbol_lexeme(sym: id) }
    _ => Absent
  }
}

fn pick_ingested_normalized_branch_arms_lexeme_holds(
  source: String,
  then_lex: String,
  else_lex: String
) -> Bool {
  match pick_ingested_normalized_module_from_source(source: source) {
    Accepted { value: normalized, diagnostics: _ } =>
      match pick_ingested_find_arrow_in_module(root: normalized) {
        Present { value: arrow } =>
          match find_arrow_body_child(root: arrow) {
            Accepted { value: body, diagnostics: _ } =>
              match pick_ingested_branch_arm_lexeme_optional(body: body, arm_index: 1) {
                Present { value: then_found } =>
                  match pick_ingested_branch_arm_lexeme_optional(body: body, arm_index: 2) {
                    Present { value: else_found } =>
                      (then_found == then_lex) && (else_found == else_lex)
                    Absent => false
                  }
                Absent => false
              }
            Rejected { diagnostics: _ } => false
          }
        Absent => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn pick_ingested_normalized_swapped_arms_structural_red_holds() -> Bool {
  pick_ingested_normalized_branch_arms_lexeme_holds(
    source: pick_ingested_source,
    then_lex: "1",
    else_lex: "2"
  ) && pick_ingested_normalized_branch_arms_lexeme_holds(
    source: pick_ingested_swapped_source,
    then_lex: "2",
    else_lex: "1"
  )
}

fn pick_ingested_resolved_module_from_source(source: String) -> Outcome<Node> {
  let lm = dag_language_model()
  bind_outcome(
    o: tokenize(text: source, file: ^pick_ingested_source_file, rules: lm.lex),
    f: fn(tokens) {
      bind_outcome(
        o: parse_module(tokens: tokens, grammar: lm.grammar),
        f: fn(artifact) {
          bind_outcome(
            o: normalize(parse_tree: artifact.tree),
            f: fn(normalized) {
              resolve(tree: normalized, lm: lm)
            }
          )
        }
      )
    }
  )
}

fn pick_ingested_arrow_from_source(source: String) -> Outcome<Node> {
  bind_outcome(
    o: pick_ingested_resolved_module_from_source(source: source),
    f: fn(resolved) {
      match pick_ingested_find_arrow_in_module(root: resolved) {
        Present { value: arrow } => outcome_accepted(value: arrow)
        Absent =>
          outcome_rejected(
            d: pick_eval_runtime_diagnostic(
              n: pick_eval_atom(s: ^pick_ingested_arrow_miss)
            )
          )
      }
    }
  )
}

fn pick_ingested_arrow_has_branch_body(source: String) -> Bool {
  match pick_ingested_arrow_from_source(source: source) {
    Accepted { value: arrow, diagnostics: _ } =>
      match find_arrow_body_child(root: arrow) {
        Accepted { value: body, diagnostics: _ } =>
          match body.kind {
            ComputationNode { behavior: Branch } => true
            _ => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn pick_eval_pick_call(callee: Node, condition: Node) -> Node {
  Node {
    kind: ComputationNode { behavior: Transform },
    occurrence_id: SyntheticOccurrence,
    children: [
      Edge { label: Positional, target: callee },
      Edge { label: Positional, target: condition }
    ]
  }
}

fn pick_eval_tree_root(call: Node, expected: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    occurrence_id: SyntheticOccurrence,
    children: [
      Edge { label: Named { name: ^pick_eval_actual }, target: call },
      Edge { label: Named { name: ^pick_eval_expected }, target: expected }
    ]
  }
}

fn pick_eval_facts_lookup(key: Node) -> Witness<InferredFacts> {
  Holds {
    value: claim_inferred_facts_from_nodes(
      resolved: key,
      algebra: pick_eval_i64_node(),
      descent: termination_proof_witness_for_node(n: key)
    )
  }
}

fn pick_eval_admitted_tree(root: Node) -> InferredTree {
  InferredTree {
    root: root,
    facts: Map {
      lookup: pick_eval_facts_lookup
    }
  }
}

fn pick_eval_inferred_run_tree(call: Node, expected: Node) -> Outcome<InferredTree> {
  let root = pick_eval_tree_root(call: call, expected: expected)
  outcome_accepted(value: pick_eval_admitted_tree(root: root))
}

fn pick_eval_claim(input: Node, expected: Node) -> TestClaim {
  CompilesClaim {
    label: "execution/pick-ingested: census-path if_expr→Branch structural lowering + resolve/eval deferred RED",
    anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
    input: input,
    expected_value: expected,
    classification: TestClassification { tier: Tier1, layer: Unit }
  }
}

fn pick_eval_subject(
  tree: InferredTree,
  input: Node,
  expected: Node
) -> TestClaimEvalSubject<Node> {
  TestClaimEvalSubject {
    claim: pick_eval_claim(input: input, expected: expected),
    context: pick_eval_context(),
    tree: tree,
    input: test_claim_typed_input_node(
      evaluator_input: input,
      evaluator_pin: ^pick_eval_pick_call_pin
    )
  }
}

fn pick_eval_run_with_condition(
  callee: Node,
  condition: Node,
  expected: Node
) -> Outcome<TestClaimRun<Node, RuntimeValue>> {
  let input = pick_eval_pick_call(callee: callee, condition: condition)
  bind_outcome(
    o: pick_eval_inferred_run_tree(call: input, expected: expected),
    f: fn(tree) {
      outcome_accepted(
        value: run_test_claim(
          subject: pick_eval_subject(tree: tree, input: input, expected: expected)
        )
      )
    }
  )
}

fn pick_eval_run_passes(run: Outcome<TestClaimRun<Node, RuntimeValue>>) -> Bool {
  match run {
    Accepted { value: r, diagnostics: _ } =>
      match test_claim_run_verdict(run: r) {
        Pass => true
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn pick_ingested_pick_true_executes_holds() -> Bool {
  match pick_ingested_arrow_from_source(source: pick_ingested_source) {
    Accepted { value: arrow, diagnostics: _ } =>
      pick_eval_run_passes(
        run: pick_eval_run_with_condition(
          callee: arrow,
          condition: pick_eval_kw_true_node(),
          expected: pick_eval_literal_one_node()
        )
      )
    Rejected { diagnostics: _ } => false
  }
}

fn pick_ingested_pick_false_executes_holds() -> Bool {
  match pick_ingested_arrow_from_source(source: pick_ingested_source) {
    Accepted { value: arrow, diagnostics: _ } =>
      pick_eval_run_passes(
        run: pick_eval_run_with_condition(
          callee: arrow,
          condition: pick_eval_kw_false_node(),
          expected: pick_eval_literal_two_node()
        )
      )
    Rejected { diagnostics: _ } => false
  }
}

fn pick_ingested_swapped_arms_red_holds() -> Bool {
  match pick_ingested_arrow_from_source(source: pick_ingested_swapped_source) {
    Accepted { value: arrow, diagnostics: _ } =>
      pick_eval_run_passes(
        run: pick_eval_run_with_condition(
          callee: arrow,
          condition: pick_eval_kw_true_node(),
          expected: pick_eval_literal_one_node()
        )
      ) == false
    Rejected { diagnostics: _ } => false
  }
}

fn pick_ingested_resolve_deferred_red_holds() -> Bool {
  pick_ingested_pipeline_resolves_holds() == false
}

fn pick_ingested_eval_equals_deferred_red_holds() -> Bool {
  (pick_ingested_pick_true_executes_holds() == false)
    && (pick_ingested_pick_false_executes_holds() == false)
}

fn pick_ingested_pipeline_resolves_holds() -> Bool {
  match pick_ingested_resolved_module_from_source(source: pick_ingested_source) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn pick_ingested_structural_lowering_keystone_holds() -> Bool {
  pick_ingested_normalized_arrow_has_branch_body(source: pick_ingested_source)
    && pick_ingested_normalized_swapped_arms_structural_red_holds()
    && pick_ingested_resolve_deferred_red_holds()
    && pick_ingested_eval_equals_deferred_red_holds()
}
