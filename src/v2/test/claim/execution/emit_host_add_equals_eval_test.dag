module v2.test.execution.emit_host_add_equals_eval


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn emit_eval_oct5_value(n: Int) -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimePrimitive {
    value: v2.std.runtime.RuntimePrimitiveValue {
      primitive_type: rust_emit_host_runtime_primitive_type_node(),
      bytes: emit_host_octets_byte_string(octets: [0, n, 0, 0, 0])
    }
  }
}

fn emit_eval_diagnostic(reason: v2.std.node.Symbol, node: Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: reason,
    at: node_locus(node: node),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn emit_eval_allocate_literal(_node: Node, _env: v2.std.runtime.EvaluationEnvironment) -> Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.Accepted { value: emit_eval_oct5_value(n: 2), diagnostics: None }
}

fn emit_eval_arg_is_two(value: v2.std.runtime.RuntimeValue) -> Bool {
  value == emit_eval_oct5_value(n: 2)
}

fn emit_eval_args_are_two_twos(args: List<v2.std.runtime.RuntimeValue>) -> Bool {
  if count(args) == 2 {
    match list_nth(xs: args, wanted: 0, absent: emit_eval_diagnostic(reason: ^emit_eval_args_bad, node: eval_add_subgraph_node)) {
      Holds { value: left } =>
        match list_nth(xs: args, wanted: 1, absent: emit_eval_diagnostic(reason: ^emit_eval_args_bad, node: eval_add_subgraph_node)) {
          Holds { value: right } =>
            emit_eval_arg_is_two(value: left) && emit_eval_arg_is_two(value: right)
          Violates { diagnostic: _ } => false
        }
      Violates { diagnostic: _ } => false
    }
  } else {
    false
  }
}

fn emit_eval_call_primitive_sum(result: Int, node: Node, args: List<v2.std.runtime.RuntimeValue>, _env: v2.std.runtime.EvaluationEnvironment) -> Outcome<v2.std.runtime.RuntimeValue> {
  if emit_eval_args_are_two_twos(args: args) {
    v2.std.diagnostic.Accepted { value: emit_eval_oct5_value(n: result), diagnostics: None }
  } else {
    v2.std.diagnostic.Rejected { diagnostics: diagnostics_singleton(d: emit_eval_diagnostic(reason: ^emit_eval_args_bad, node: node)) }
  }
}

fn emit_eval_call_primitive_five(node: Node, args: List<v2.std.runtime.RuntimeValue>, env: v2.std.runtime.EvaluationEnvironment) -> Outcome<v2.std.runtime.RuntimeValue> {
  emit_eval_call_primitive_sum(result: 5, node: node, args: args, _env: env)
}

fn emit_eval_call_primitive_six(node: Node, args: List<v2.std.runtime.RuntimeValue>, env: v2.std.runtime.EvaluationEnvironment) -> Outcome<v2.std.runtime.RuntimeValue> {
  emit_eval_call_primitive_sum(result: 6, node: node, args: args, _env: env)
}

fn emit_eval_choose_branch(_node: Node, _value: v2.std.runtime.RuntimeValue, _env: v2.std.runtime.EvaluationEnvironment) -> Outcome<Node> {
  v2.std.diagnostic.Accepted { value: eval_add_subgraph_node, diagnostics: None }
}

fn emit_eval_step_loop(_node: Node, _env: v2.std.runtime.EvaluationEnvironment) -> Outcome<v2.std.runtime.ControlTransfer> {
  v2.std.diagnostic.Accepted { value: v2.std.runtime.Continue { value: emit_eval_oct5_value(n: 5) }, diagnostics: None }
}

fn emit_eval_bind_value(_key: v2.std.runtime.EnvironmentBindingKey, _value: v2.std.runtime.RuntimeValue, env: v2.std.runtime.EvaluationEnvironment) -> Outcome<v2.std.runtime.EvaluationEnvironment> {
  v2.std.diagnostic.Accepted { value: env, diagnostics: None }
}

fn emit_eval_interpretation(call_primitive: fn(Node, List<RuntimeValue>, EvaluationEnvironment) -> Outcome<RuntimeValue>) -> v2.std.runtime.InterpretationAlgebra {
  v2.std.runtime.InterpretationAlgebra {
    value: v2.std.runtime.ValueInterpreter { allocate_literal: emit_eval_allocate_literal },
    transform: v2.std.runtime.TransformInterpreter { call_primitive: call_primitive },
    branch: v2.std.runtime.BranchInterpreter { choose_branch: emit_eval_choose_branch },
    loop: v2.std.runtime.LoopInterpreter { step_loop: emit_eval_step_loop },
    bind: v2.std.runtime.BindInterpreter { bind_value: emit_eval_bind_value },
    match: v2.std.runtime.MatchInterpreter {
      choose_arm: runtime_reject_match_arm
    }
  }
}

fn emit_eval_structure_witness() -> v2.std.runtime.InterpretationStructureWitness {
  v2.std.runtime.InterpretationStructureWitness {
    allocate_literal: ^emit_eval_allocate_literal_sym,
    call_primitive: ^emit_eval_call_primitive_sym,
    choose_branch: ^emit_eval_choose_branch_sym,
    step_loop: ^emit_eval_step_loop_sym,
    bind_value: ^emit_eval_bind_value_sym,
    choose_arm: ^runtime_reject_match_arm
  }
}

fn emit_eval_context(call_primitive: fn(Node, List<RuntimeValue>, EvaluationEnvironment) -> Outcome<RuntimeValue>) -> v2.compiler.eval.EvalContext {
  eval_context_with_semantics(
    runtime_identity: ^emit_eval_interpretation_pin,
    interpretation: emit_eval_interpretation(call_primitive: call_primitive),
    structure_witness: emit_eval_structure_witness()
  )
}

fn emit_eval_generic_facts(node: Node) -> v2.compiler.infer.InferredFacts {
  claim_inferred_facts_from_nodes(
    resolved: node,
    algebra: rust_emit_host_runtime_primitive_type_node(),
    descent: v2.std.witness.Holds {
      value: v2.std.cardinality.TerminationProof {
        non_increasing: [],
        strict: v2.std.cardinality.RankingDimension { measured: ^emit_eval_generic_descent }
      }
    }
  )
}

fn emit_eval_composed_facts(node: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  match rust_add_inferred_tree.facts.lookup(node) {
    Present { value: f } => optional_present(value: f)
    Absent => optional_present(value: emit_eval_generic_facts(node: node))
  }
}

fn emit_eval_subject_tree() -> v2.compiler.infer.InferredTree {
  v2.compiler.infer.InferredTree {
    root: rust_fixture_emitted_add_fn,
    facts: std.types.Map { lookup: emit_eval_composed_facts }
  }
}

fn emit_eval_claim(rhs_result_node: Node) -> v2.std.verification.TestClaim {
  v2.std.verification.EqualsClaim {
    label: "S0: rust emit(add-fn) host-run == eval(add-subgraph) via shared octet codec",
    anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
    lhs: rhs_result_node,
    rhs: rhs_result_node,
    classification: v2.std.verification.TestClassification { tier: Tier3, layer: Integration }
  }
}

fn emit_eval_subject(call_primitive: fn(Node, List<RuntimeValue>, EvaluationEnvironment) -> Outcome<RuntimeValue>) -> TestClaimEvalSubject<Node> {
  eval_test_claim_subject(
    claim: emit_eval_claim(rhs_result_node: eval_add_subgraph_node),
    context: emit_eval_context(call_primitive: call_primitive),
    tree: emit_eval_subject_tree(),
    evaluator_pin: ^emit_eval_evaluator_pin
  )
}

fn emit_eval_run(call_primitive: fn(Node, List<RuntimeValue>, EvaluationEnvironment) -> Outcome<RuntimeValue>) -> TestClaimRun<Node, RuntimeValue> {
  run_test_claim_emit_vs_eval(
    subject: emit_eval_subject(call_primitive: call_primitive),
    target: rust_target_model_staging()
  )
}

fn emit_eval_verdict_is_pass(run: TestClaimRun<Node, RuntimeValue>) -> Bool {
  match run.verdict {
    Pass => true
    SemanticMismatch { actual: _, falsification: _ } => false
    BuildFailed { actual: _, diagnostic: _ } => false
    RunFailed { actual: _, diagnostic: _ } => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}

fn emit_eval_verdict_is_semantic_mismatch(run: TestClaimRun<Node, RuntimeValue>) -> Bool {
  match run.verdict {
    SemanticMismatch { actual: _, falsification: _ } => true
    Pass => false
    BuildFailed { actual: _, diagnostic: _ } => false
    RunFailed { actual: _, diagnostic: _ } => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}

test fn emit_host_add_equals_eval_holds() -> Bool {
  emit_eval_verdict_is_pass(run: emit_eval_run(call_primitive: emit_eval_call_primitive_five))
}

test fn emit_host_add_wrong_oracle_refuses_holds() -> Bool {
  emit_eval_verdict_is_semantic_mismatch(run: emit_eval_run(call_primitive: emit_eval_call_primitive_six))
}

