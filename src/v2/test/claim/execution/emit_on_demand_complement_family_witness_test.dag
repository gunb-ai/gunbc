module v2.test.execution.emit_on_demand_complement_family_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.ReadsLiveTree

data emit_on_demand_complement_family_note: String = "Witness-realization lane 2 (witness_family_fanout): emit_host_complement family — PURE receipts only (grain/closure keys, store hit/miss materialization, interpreter role bound, packed-width budget refusal). Native execution + eval-anchored agreement for complement MIGRATED to family grain (merry-pike-487 follow-on, std.emit_on_demand witness_family_build_grain_ruling): the executing consumer is emit_on_demand_family_crate_witness_test — complement runs as a warm member of the logic family crate (agreement Pass via run_test_claim_from_source_emit_vs_eval_cached; wrong-fixture discriminator = the all-alt family octet flip 0 -> 1); the equals_eval harness's own mismatch RED stays live in emit_host_complement_equals_eval_test. Residue is pure; the LiveTreeDisposition flip to SubstrateInputsOnly is a named follow-on."

data complement_family_emitter: String = "v2.compiler.emit"
data complement_family_provider: std.materialization_ladder.CacheProvider = std.materialization_ladder.provider_row(
  id: "emit-on-demand-complement",
  scope: [],
  coverage: std.materialization_ladder.CoversAllComputations,
  tier: std.materialization_ladder.ArtifactTier { keying: std.materialization_ladder.ContentKeyed },
  retention: std.materialization_ladder.persistent_retention(capacity: std.cache_interface.CapacityBounded { limit: std.cache_interface.ByteCapacity { limit: std.cache_interface.ExactLimit { value: std.measure.byte_size(count: 1000000) } }, at_capacity: std.cache_interface.ReplaceExisting { strategy: std.cache_interface.LeastRecentlyUsed } })
)

fn complement_family_primary_tree() -> v2.compiler.inferred_tree.InferredTree {
  v2.test.execution.emit_host_complement_equals_eval.emit_complement_eval_tree_for(root: v2.extdeps.languages.dag.dag_complement_arrow_with_body_fixture)
}

fn complement_family_alt_tree() -> v2.compiler.inferred_tree.InferredTree {
  v2.test.execution.emit_host_complement_equals_eval.emit_complement_eval_tree_for(root: v2.extdeps.languages.dag.dag_complement_arrow_with_body_swapped_arms_fixture)
}

fn complement_family_native_key_for(tree: v2.compiler.inferred_tree.InferredTree) -> std.content_hash.ContentHash {
  std.emit_on_demand.emit_on_demand_key(
    closure_digest: v2.compiler.eval.inferred_tree_digest(tree: tree),
    emitter_identity: complement_family_emitter,
    target_language: "rust",
    grain: std.emit_on_demand.NativeArtifact
  )
}

fn complement_family_test_store() -> std.artifact_store.ArtifactStore {
  match std.artifact_store.store_over_provider(provider: complement_family_provider) {
    std.artifact_store.StoreReady { store: s } => s
    std.artifact_store.StoreRefusedRetention { provider_id: _, declared: _ } =>
      std.artifact_store.ArtifactStore { budget: std.measure.byte_size(count: 0), next_ordinal: 1, rows: [] }
  }
}

test fn emit_on_demand_complement_grain_keys_differ_holds() -> Bool {
  let digest = v2.compiler.eval.inferred_tree_digest(tree: complement_family_primary_tree())
  let source = std.emit_on_demand.emit_on_demand_key(
    closure_digest: digest,
    emitter_identity: complement_family_emitter,
    target_language: "rust",
    grain: std.emit_on_demand.SourceArtifact
  )
  let native = std.emit_on_demand.emit_on_demand_key(
    closure_digest: digest,
    emitter_identity: complement_family_emitter,
    target_language: "rust",
    grain: std.emit_on_demand.NativeArtifact
  )
  (source == native) == false
}

test fn emit_on_demand_complement_materialize_recompute_on_miss_holds() -> Bool {
  let lookup = std.emit_on_demand.emit_on_demand_lookup(
    store: complement_family_test_store(),
    key: complement_family_native_key_for(tree: complement_family_primary_tree())
  )
  match lookup {
    std.emit_on_demand.EmitOnDemandMiss => std.emit_on_demand.materialization_for_lookup(lookup: lookup) == std.realization.Recompute
    std.emit_on_demand.EmitOnDemandHit { receipt: _ } => false
  }
}

test fn emit_on_demand_complement_interpreter_roles_bounded_holds() -> Bool {
  std.emit_on_demand.interpreter_surviving_roles_bounded()
}

test fn emit_on_demand_complement_schedule_refuses_unreadable_budget_holds() -> Bool {
  let tree = complement_family_primary_tree()
  match v2.std.emit_on_demand.witness_family_realize_width(
    bound_bytes: std.measure.byte_size(count: 25),
    budget: std.realize_pack.BudgetUnreadable,
    witness_root: tree.root,
    independence_override: 4
  ) {
    std.realize_pack.BudgetRefused => true
    std.realize_pack.PackedWidth { width: _ } => false
    std.realize_pack.MaturationReserve { width: _ } => false
  }
}

test fn emit_on_demand_complement_closure_keys_differ_for_distinct_trees_holds() -> Bool {
  (complement_family_native_key_for(tree: complement_family_primary_tree()) == complement_family_native_key_for(tree: complement_family_alt_tree())) == false
}

test fn emit_on_demand_complement_materialize_share_on_hit_holds() -> Bool {
  let tree = complement_family_primary_tree()
  let key = complement_family_native_key_for(tree: tree)
  std.artifact_store.store_put_fold(
    outcome: std.artifact_store.store_put(store: complement_family_test_store(), key: key, artifact_bytes: std.measure.byte_size(count: 64)),
    admitted: fn(put_store, evicted) {
      let lookup = std.emit_on_demand.emit_on_demand_lookup(store: put_store, key: key)
      match lookup {
        std.emit_on_demand.EmitOnDemandHit { receipt: r } =>
          r.compile_skipped
            && std.emit_on_demand.materialization_for_lookup(lookup: lookup) == std.realization.Share
        std.emit_on_demand.EmitOnDemandMiss => false
      }
    },
    did_not_fit: (a, b) => false
  )
}

