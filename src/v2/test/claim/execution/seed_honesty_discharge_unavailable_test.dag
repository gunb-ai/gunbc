module v2.test.claim.execution.seed_honesty_discharge_unavailable_test

import v2.workflow.bootstrap {
  BootstrapHashPin,
  DiverseCompilationAgreement,
  DiverseCompilationRun,
  IndependentCompilerPair,
  bootstrap_seed_honesty_discharge,
  bootstrap_seed_honesty_discharge_witness,
  independent_compiler_evidence_unavailable,
  independent_compiler_pair_witness,
  pinned_v4_fixed_point_hash,
  seed_self_verify_check,
  seed_honesty_decision,
  SeedHonestyDecision,
  SeedHonestyUndecided,
  IndependentRebuildRequiredFirst,
  FixedPointTrustSufficient
}
import v2.std.node { Symbol }
import v2.std.witness { Holds, Violates, Witness }
import v2.std.logic { Bool }
import v2.std.diagnostic { Accepted, Rejected, None }

data seed_honesty_discharge_unavailable_offline_recipe_note: String = "The file sits under the test/claim/execution/ OfflineLocalRecipe home. v1_seed_honesty_decision_closing_contract_holds WAS enrolled QuarantineProbeExpectRed while seed_honesty_decision was SeedHonestyUndecided; the operator verdict of 2026-08-02 recorded FixedPointTrustSufficient, the aggregate greened, and the quarantine enrollment was deleted in the same change. The closing contract executes five conjuncts: a reflexive claim/check artifact refuses with a located bootstrap_self_verify_same_artifact diagnostic, a separately identified planted divergence refuses with bootstrap_self_verify_diverged, mismatched source/compiler/hash-pin provenance refuses with bootstrap_self_verify_provenance_mismatch, a distinct equal-content pair with equal provenance passes so none of the refusals is a blanket red, and the decision carries a NonEmptyStr rationale in one of the two decided arms.\n\nWHY THE EXPECT-RED PROBE WAS FLIPPED RATHER THAN DELETED. DESIGN 4b(4) rules that a climb dissolves the redundant lower-rung PRODUCTION machinery and keeps the discriminating evidence enrolled, because deleting the evidence recreates specification-without-execution one rung up. seed_honesty_undecided_keeps_closing_contract_red read the live decision constant, so once the verdict landed it could only assert the state that no longer exists -- it had to either go red or be deleted, and both are wrong. The conjunction is therefore now a FUNCTION of the decision, seed_honesty_closing_contract_over, applied to the live constant by the contract and to SeedHonestyUndecided by the permanent control seed_honesty_undecided_would_keep_closing_contract_red. That control keeps the fifth conjunct load-bearing: if someone weakened the decision arm so an undecided value satisfied the contract, the contract itself would stay green and only this control would red. Without it the aggregate would pass on four conjuncts that were already passing before the verdict.\n\nThe unavailable-evidence witnesses keep the larger DDC discharge fail-closed independently of the verdict, which is deliberate -- the verdict removes the DDC prerequisite edge from the v1-exit finish lines, it does not admit unavailable evidence."

data seed_honesty_primary_compiler: Symbol = ^seed_honesty_primary_compiler
data seed_honesty_secondary_compiler: Symbol = ^seed_honesty_secondary_compiler
data seed_honesty_shared_compiler: Symbol = ^seed_honesty_shared_compiler
data seed_honesty_perturbed_primary_compiler: Symbol = ^seed_honesty_perturbed_primary_compiler
data seed_honesty_perturbed_secondary_compiler: Symbol = ^seed_honesty_perturbed_secondary_compiler

fn seed_self_verify_run_with_provenance(
  output: Symbol,
  digest: Symbol,
  source: Symbol,
  compiler: Symbol,
  pin: Symbol
) -> DiverseCompilationRun {
  DiverseCompilationRun {
    source: source,
    compiler: compiler,
    output: output,
    output_hash: BootstrapHashPin {
      digest: digest,
      pin: pin
    }
  }
}

fn seed_self_verify_run(output: Symbol, digest: Symbol) -> DiverseCompilationRun {
  seed_self_verify_run_with_provenance(
    output: output,
    digest: digest,
    source: ^seed_honesty_fabricated_source,
    compiler: seed_honesty_shared_compiler,
    pin: ^seed_honesty_closing_contract_hash_pin
  )
}

fn seed_self_verify_same_artifact_refuses() -> Bool {
  let same = seed_self_verify_run(
    output: ^seed_honesty_same_artifact,
    digest: ^seed_honesty_matching_digest
  )
  match seed_self_verify_check(
    claim: same,
    check: same
  ) {
    Rejected { diagnostics: d } => d.head.reason == ^bootstrap_self_verify_same_artifact
    Accepted { value: _, diagnostics: _ } => false
  }
}

fn seed_self_verify_planted_divergence_refuses() -> Bool {
  match seed_self_verify_check(
    claim: seed_self_verify_run(
      output: ^seed_honesty_claim_artifact,
      digest: ^seed_honesty_matching_digest
    ),
    check: seed_self_verify_run(
      output: ^seed_honesty_check_artifact,
      digest: ^seed_honesty_perturbed_digest
    )
  ) {
    Rejected { diagnostics: d } => d.head.reason == ^bootstrap_self_verify_diverged
    Accepted { value: _, diagnostics: _ } => false
  }
}

fn seed_self_verify_provenance_mismatch_refuses() -> Bool {
  match seed_self_verify_check(
    claim: seed_self_verify_run(
      output: ^seed_honesty_claim_artifact,
      digest: ^seed_honesty_matching_digest
    ),
    check: seed_self_verify_run_with_provenance(
      output: ^seed_honesty_check_artifact,
      digest: ^seed_honesty_matching_digest,
      source: ^seed_honesty_other_source,
      compiler: seed_honesty_shared_compiler,
      pin: ^seed_honesty_closing_contract_hash_pin
    )
  ) {
    Rejected { diagnostics: d } => d.head.reason == ^bootstrap_self_verify_provenance_mismatch
    Accepted { value: _, diagnostics: _ } => false
  }
}

fn seed_self_verify_distinct_equal_artifacts_hold() -> Bool {
  match seed_self_verify_check(
    claim: seed_self_verify_run(
      output: ^seed_honesty_claim_artifact,
      digest: ^seed_honesty_matching_digest
    ),
    check: seed_self_verify_run(
      output: ^seed_honesty_check_artifact,
      digest: ^seed_honesty_matching_digest
    )
  ) {
    Accepted { value: receipt, diagnostics: None } =>
      !(receipt.claim.output == receipt.check.output)
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => false
  }
}

fn seed_honesty_closing_contract_over(decision: SeedHonestyDecision) -> Bool {
  seed_self_verify_same_artifact_refuses()
    && seed_self_verify_planted_divergence_refuses()
    && seed_self_verify_provenance_mismatch_refuses()
    && seed_self_verify_distinct_equal_artifacts_hold()
    && match decision {
      SeedHonestyUndecided => false
      IndependentRebuildRequiredFirst { rationale: _ } => true
      FixedPointTrustSufficient { rationale: _ } => true
    }
}

test fn v1_seed_honesty_decision_closing_contract_holds() -> Bool {
  seed_honesty_closing_contract_over(decision: seed_honesty_decision)
}

test fn seed_honesty_check_four_poles_hold_before_decision() -> Bool {
  seed_self_verify_same_artifact_refuses()
    && seed_self_verify_planted_divergence_refuses()
    && seed_self_verify_provenance_mismatch_refuses()
    && seed_self_verify_distinct_equal_artifacts_hold()
}

test fn seed_honesty_undecided_would_keep_closing_contract_red() -> Bool {
  !seed_honesty_closing_contract_over(decision: SeedHonestyUndecided)
}

fn seed_honesty_fabricated_agreement(
  primary_compiler: Symbol,
  secondary_compiler: Symbol
) -> Witness<DiverseCompilationAgreement> {
  Holds {
    value: DiverseCompilationAgreement {
      primary: DiverseCompilationRun {
        source: ^seed_honesty_fabricated_source,
        compiler: primary_compiler,
        output: ^seed_honesty_fabricated_output,
        output_hash: BootstrapHashPin {
          digest: pinned_v4_fixed_point_hash,
          pin: ^pinned_v4_fixed_point_hash_pin
        }
      },
      secondary: DiverseCompilationRun {
        source: ^seed_honesty_fabricated_source,
        compiler: secondary_compiler,
        output: ^seed_honesty_fabricated_output,
        output_hash: BootstrapHashPin {
          digest: pinned_v4_fixed_point_hash,
          pin: ^pinned_v4_fixed_point_hash_pin
        }
      },
      independent_compilers: IndependentCompilerPair {
        primary: primary_compiler,
        secondary: secondary_compiler
      },
      agreed_hash: BootstrapHashPin {
        digest: pinned_v4_fixed_point_hash,
        pin: ^pinned_v4_fixed_point_hash_pin
      }
    }
  }
}

fn seed_honesty_discharge_refuses_when_unavailable() -> Bool {
  match bootstrap_seed_honesty_discharge {
    Violates { diagnostic: d } => d.reason == ^bootstrap_diverse_compilation_mismatch
    Holds { value: _ } => false
  }
}

fn seed_honesty_discharge_witness_refuses_holds_agreement() -> Bool {
  match bootstrap_seed_honesty_discharge_witness(
    axiom: ^seed_honesty_axiom,
    diverse_double_compilation: seed_honesty_fabricated_agreement(
      primary_compiler: seed_honesty_primary_compiler,
      secondary_compiler: seed_honesty_secondary_compiler
    )
  ) {
    Violates { diagnostic: d } => d.reason == ^bootstrap_diverse_compilation_mismatch
    Holds { value: _ } => false
  }
}

fn seed_honesty_discharge_witness_refuses_old_magic_atom() -> Bool {
  match bootstrap_seed_honesty_discharge_witness(
    axiom: ^seed_honesty_axiom,
    diverse_double_compilation: seed_honesty_fabricated_agreement(
      primary_compiler: ^independent_compiler_witness,
      secondary_compiler: ^independent_compiler_witness
    )
  ) {
    Violates { diagnostic: d } => d.reason == ^bootstrap_diverse_compilation_mismatch
    Holds { value: _ } => false
  }
}

fn independent_compiler_pair_witness_refuses_distinct_compilers_unavailable() -> Bool {
  match independent_compiler_pair_witness(
    primary: seed_honesty_primary_compiler,
    secondary: seed_honesty_secondary_compiler,
    evidence: independent_compiler_evidence_unavailable()
  ) {
    Violates { diagnostic: d } => d.reason == ^bootstrap_diverse_compilation_mismatch
    Holds { value: _ } => false
  }
}

fn independent_compiler_pair_witness_refuses_matching_compilers_unavailable() -> Bool {
  match independent_compiler_pair_witness(
    primary: seed_honesty_shared_compiler,
    secondary: seed_honesty_shared_compiler,
    evidence: independent_compiler_evidence_unavailable()
  ) {
    Violates { diagnostic: d } => d.reason == ^bootstrap_diverse_compilation_mismatch
    Holds { value: _ } => false
  }
}

fn independent_compiler_pair_witness_refuses_perturbed_compilers_unavailable() -> Bool {
  match independent_compiler_pair_witness(
    primary: seed_honesty_perturbed_primary_compiler,
    secondary: seed_honesty_perturbed_secondary_compiler,
    evidence: independent_compiler_evidence_unavailable()
  ) {
    Violates { diagnostic: d } => d.reason == ^bootstrap_diverse_compilation_mismatch
    Holds { value: _ } => false
  }
}

test fn seed_honesty_discharge_unavailable_top_level_refuses() -> Bool {
  seed_honesty_discharge_refuses_when_unavailable()
}

test fn seed_honesty_discharge_unavailable_holds_agreement_refuses() -> Bool {
  seed_honesty_discharge_witness_refuses_holds_agreement()
}

test fn seed_honesty_discharge_unavailable_old_magic_atom_refuses() -> Bool {
  seed_honesty_discharge_witness_refuses_old_magic_atom()
}

test fn independent_compiler_pair_unavailable_distinct_refuses() -> Bool {
  independent_compiler_pair_witness_refuses_distinct_compilers_unavailable()
}

test fn independent_compiler_pair_unavailable_matching_refuses() -> Bool {
  independent_compiler_pair_witness_refuses_matching_compilers_unavailable()
}

test fn independent_compiler_pair_unavailable_perturbed_refuses() -> Bool {
  independent_compiler_pair_witness_refuses_perturbed_compilers_unavailable()
}
