module v2.test.execution.std_logic_behavioral_selfhost_witness

import extdeps.communication.medium { Medium }
import v2.compiler.emit_host {
  emit_host_octets_byte_string,
  run_test_claim_from_source_emit_vs_eval
}
import v2.compiler.eval {
  EvalContext,
  TestClaimEvalSubject,
  TestClaimRun,
  eval_context_with_semantics,
  eval_test_claim_subject
}
import v2.compiler.infer { InferredFacts, InferredTree }
import v2.extdeps.languages.rust {
  rust_emit_host_runtime_primitive_type_node,
  rust_fixture_emitted_add_fn
}
import v2.extdeps.languages.rust_test {
  rust_std_logic_witness_target_model_staging,
  rust_std_logic_witness_truth_table_packed_i32_dissolution_trigger,
  rust_std_logic_witness_truth_table_packed_i32,
  rust_std_logic_witness_truth_table_wrong_packed_i32
}
import v2.test.fixture.std_logic_module {
  std_logic_golden_emit_source,
  std_logic_module_emit_source
}
import v2.test.lens_common.infer_fixture { claim_inferred_facts_from_nodes }
import v2.std.cardinality { RankingDimension, TerminationProof }
import v2.std.collection { List, Map }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  node_locus,
  outcome_accepted,
  outcome_rejected
}
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  Node,
  Symbol,
  SyntheticOccurrence,
  TypeNode
}
import v2.std.runtime {
  BindInterpreter,
  BranchInterpreter,
  ControlTransfer,
  EnvironmentBindingKey,
  EvaluationEnvironment,
  InterpretationAlgebra,
  InterpretationStructureWitness,
  LoopInterpreter,
  MatchInterpreter,
  RuntimePrimitive,
  RuntimePrimitiveValue,
  RuntimeValue,
  TransformInterpreter,
  ValueInterpreter
}
import v2.std.verdict { Deferred, Fail, Pass, Verdict }
import v2.std.verification {
  EqualsClaim,
  Integration,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier3,
  manual_claim_anchor
}
import v2.std.witness { Holds, Witness }

data std_logic_truth_table_claim_root: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^std_logic_truth_table_claim_root } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data std_logic_truth_table_packed_i32_note: String = rust_std_logic_witness_truth_table_packed_i32_dissolution_trigger

fn std_logic_truth_table_oct5_value(packed_i32: Int) -> RuntimeValue {
  RuntimePrimitive {
    value: RuntimePrimitiveValue {
      primitive_type: rust_emit_host_runtime_primitive_type_node(),
      bytes: emit_host_octets_byte_string(
        octets: [
          0,
          packed_i32 % 256,
          (packed_i32 / 256) % 256,
          (packed_i32 / 65536) % 256,
          (packed_i32 / 16777216) % 256
        ]
      )
    }
  }
}

fn std_logic_truth_table_diagnostic(reason: Symbol, node: Node) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn std_logic_truth_table_call_primitive(
  packed_i32: Int,
  node: Node,
  _args: List<RuntimeValue>,
  _env: EvaluationEnvironment
) -> Outcome<RuntimeValue> {
  Accepted {
    value: std_logic_truth_table_oct5_value(packed_i32: packed_i32),
    diagnostics: None
  }
}

fn std_logic_truth_table_call_primitive_correct(
  node: Node,
  args: List<RuntimeValue>,
  env: EvaluationEnvironment
) -> Outcome<RuntimeValue> {
  std_logic_truth_table_call_primitive(
    packed_i32: rust_std_logic_witness_truth_table_packed_i32,
    node: node,
    args: args,
    env: env
  )
}

fn std_logic_truth_table_call_primitive_wrong(
  node: Node,
  args: List<RuntimeValue>,
  env: EvaluationEnvironment
) -> Outcome<RuntimeValue> {
  std_logic_truth_table_call_primitive(
    packed_i32: rust_std_logic_witness_truth_table_wrong_packed_i32,
    node: node,
    args: args,
    env: env
  )
}

fn std_logic_truth_table_allocate_literal(
  _node: Node,
  _env: EvaluationEnvironment
) -> Outcome<RuntimeValue> {
  Accepted {
    value: std_logic_truth_table_oct5_value(packed_i32: rust_std_logic_witness_truth_table_packed_i32),
    diagnostics: None
  }
}

fn std_logic_truth_table_choose_branch(
  _node: Node,
  _value: RuntimeValue,
  _env: EvaluationEnvironment
) -> Outcome<Node> {
  outcome_accepted(value: std_logic_truth_table_claim_root)
}

fn std_logic_truth_table_step_loop(
  _node: Node,
  _env: EvaluationEnvironment
) -> Outcome<ControlTransfer> {
  outcome_rejected(
    d: std_logic_truth_table_diagnostic(
      reason: ^std_logic_truth_table_loop_miss,
      node: std_logic_truth_table_claim_root
    )
  )
}

fn std_logic_truth_table_bind_value(
  _key: EnvironmentBindingKey,
  _value: RuntimeValue,
  env: EvaluationEnvironment
) -> Outcome<EvaluationEnvironment> {
  Accepted { value: env, diagnostics: None }
}

fn std_logic_truth_table_choose_arm(
  _node: Node,
  _scrutinee: RuntimeValue,
  _env: EvaluationEnvironment
) -> Outcome<Node> {
  outcome_rejected(
    d: std_logic_truth_table_diagnostic(
      reason: ^std_logic_truth_table_match_miss,
      node: std_logic_truth_table_claim_root
    )
  )
}

fn std_logic_truth_table_interpretation(
  call_primitive: fn(Node, List<RuntimeValue>, EvaluationEnvironment) -> Outcome<RuntimeValue>
) -> InterpretationAlgebra {
  InterpretationAlgebra {
    value: ValueInterpreter { allocate_literal: std_logic_truth_table_allocate_literal },
    transform: TransformInterpreter { call_primitive: call_primitive },
    branch: BranchInterpreter { choose_branch: std_logic_truth_table_choose_branch },
    loop: LoopInterpreter { step_loop: std_logic_truth_table_step_loop },
    bind: BindInterpreter { bind_value: std_logic_truth_table_bind_value },
    match: MatchInterpreter { choose_arm: std_logic_truth_table_choose_arm }
  }
}

fn std_logic_truth_table_structure_witness() -> InterpretationStructureWitness {
  InterpretationStructureWitness {
    allocate_literal: ^std_logic_truth_table_allocate_literal_sym,
    call_primitive: ^std_logic_truth_table_call_primitive_sym,
    choose_branch: ^std_logic_truth_table_choose_branch_sym,
    step_loop: ^std_logic_truth_table_step_loop_sym,
    bind_value: ^std_logic_truth_table_bind_value_sym,
    choose_arm: ^std_logic_truth_table_choose_arm_sym
  }
}

fn std_logic_truth_table_context(
  call_primitive: fn(Node, List<RuntimeValue>, EvaluationEnvironment) -> Outcome<RuntimeValue>
) -> EvalContext {
  eval_context_with_semantics(
    runtime_identity: ^std_logic_truth_table_interpretation_pin,
    interpretation: std_logic_truth_table_interpretation(call_primitive: call_primitive),
    structure_witness: std_logic_truth_table_structure_witness()
  )
}

fn std_logic_truth_table_generic_facts(node: Node) -> InferredFacts {
  claim_inferred_facts_from_nodes(
    resolved: node,
    algebra: rust_emit_host_runtime_primitive_type_node(),
    descent: Holds {
      value: TerminationProof {
        non_increasing: [],
        strict: RankingDimension { measured: ^std_logic_truth_table_generic_descent }
      }
    }
  )
}

fn std_logic_truth_table_composed_facts(node: Node) -> Witness<InferredFacts> {
  Holds { value: std_logic_truth_table_generic_facts(node: node) }
}

fn std_logic_truth_table_subject_tree() -> InferredTree {
  InferredTree {
    root: rust_fixture_emitted_add_fn,
    facts: Map { lookup: std_logic_truth_table_composed_facts }
  }
}

fn std_logic_truth_table_claim() -> TestClaim {
  EqualsClaim {
    label: "S2 std/logic Milestone B: whole-program rust emit host-run truth table == eval oracle",
    anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
    lhs: std_logic_truth_table_claim_root,
    rhs: std_logic_truth_table_claim_root,
    classification: TestClassification { tier: Tier3, layer: Integration }
  }
}

fn std_logic_truth_table_subject(
  call_primitive: fn(Node, List<RuntimeValue>, EvaluationEnvironment) -> Outcome<RuntimeValue>
) -> TestClaimEvalSubject<Node> {
  eval_test_claim_subject(
    claim: std_logic_truth_table_claim(),
    context: std_logic_truth_table_context(call_primitive: call_primitive),
    tree: std_logic_truth_table_subject_tree(),
    evaluator_pin: ^std_logic_truth_table_evaluator_pin
  )
}

fn std_logic_truth_table_run_with_source(
  call_primitive: fn(Node, List<RuntimeValue>, EvaluationEnvironment) -> Outcome<RuntimeValue>,
  source_outcome: Outcome<Medium<String>>
) -> TestClaimRun<Node, RuntimeValue> {
  run_test_claim_from_source_emit_vs_eval(
    subject: std_logic_truth_table_subject(call_primitive: call_primitive),
    source_outcome: source_outcome,
    target: rust_std_logic_witness_target_model_staging()
  )
}

fn std_logic_truth_table_run(
  call_primitive: fn(Node, List<RuntimeValue>, EvaluationEnvironment) -> Outcome<RuntimeValue>
) -> TestClaimRun<Node, RuntimeValue> {
  std_logic_truth_table_run_with_source(
    call_primitive: call_primitive,
    source_outcome: std_logic_module_emit_source()
  )
}

fn std_logic_truth_table_verdict_is_pass(run: TestClaimRun<Node, RuntimeValue>) -> Bool {
  match run.verdict {
    Pass => true
    Fail { actual: _, falsification: _ } => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}

fn std_logic_truth_table_verdict_is_fail(run: TestClaimRun<Node, RuntimeValue>) -> Bool {
  match run.verdict {
    Fail { actual: _, falsification: _ } => true
    Pass => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}

test fn std_logic_golden_rust_emit_host_holds() -> Bool {
  std_logic_truth_table_verdict_is_pass(
    run: std_logic_truth_table_run_with_source(
      call_primitive: std_logic_truth_table_call_primitive_correct,
      source_outcome: std_logic_golden_emit_source()
    )
  )
}

test fn std_logic_behavioral_selfhost_emit_equals_eval_holds() -> Bool {
  std_logic_truth_table_verdict_is_pass(
    run: std_logic_truth_table_run(call_primitive: std_logic_truth_table_call_primitive_correct)
  )
}

test fn std_logic_behavioral_selfhost_wrong_oracle_refuses_holds() -> Bool {
  std_logic_truth_table_verdict_is_fail(
    run: std_logic_truth_table_run(call_primitive: std_logic_truth_table_call_primitive_wrong)
  )
}

test fn std_logic_witness_truth_table_packed_i32_carries_dissolution_trigger() -> Bool {
  std_logic_truth_table_packed_i32_note == rust_std_logic_witness_truth_table_packed_i32_dissolution_trigger
}

test fn std_logic_behavioral_selfhost_all_holds() -> Bool {
  std_logic_behavioral_selfhost_emit_equals_eval_holds()
    && std_logic_behavioral_selfhost_wrong_oracle_refuses_holds()
}
