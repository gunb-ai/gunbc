test fn native_selected_witness_bundle_unavailable_is_counted_holds() -> Bool {
  let primary = selected_logic_primary_plan()
  let unavailable = SelectedWitnessPlan {
    compiler_identity: primary.compiler_identity
    shard_policy: primary.shard_policy
    members: concat(primary.members, [InterpreterFrontier {
      witness: SelectedWitnessIdentity {
        entry: "src/v2/test/claim/execution/unrealized_selected_witness.dag"
        function: "unrealized_selected_witness"
        subject_digest: content_hash_atom(value: "unrealized-selected-subject")
      }
      cause: NativeRealizationAbsent
      reason: "The emitter has no native realization for this selected member."
      dissolution: unbound_dissolution(description: "feature:selected-witness-native-realization")
    }])
  }
  selected_witness_plan_interpreter_frontier_count(plan: unavailable) == 1
    && content_hash_eq_structural(
      left: native_witness_bundle_from_plan(plan: unavailable).identity.structural_fingerprint,
      right: native_witness_bundle_from_plan(plan: primary).identity.structural_fingerprint
    )
}

test fn native_selected_witness_bundle_compiler_identity_keys_holds() -> Bool {
  let primary = selected_logic_primary_plan()
  let changed = SelectedWitnessPlan {
    compiler_identity: content_hash_atom(value: "changed-compiler-identity")
    shard_policy: primary.shard_policy
    members: primary.members
  }
  !content_hash_eq_structural(
    left: native_witness_bundle_from_plan(plan: primary).identity.structural_fingerprint,
    right: native_witness_bundle_from_plan(plan: changed).identity.structural_fingerprint
  )
}
