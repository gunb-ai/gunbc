module v2.test.execution.emit_on_demand_field_access_family_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = ReadsLiveTree

data emit_on_demand_field_access_family_note: String = "Witness-realization lane 2 (witness_family_fanout), consolidated to ONE-BUILD grain (std.emit_on_demand witness_family_build_grain_ruling, merry-pike-487 fan-out): the singleton family's crate builds ONCE per corpus pass. The single wet receipt is emit_on_demand_field_access_native_one_build_holds: one root, both keys evicted up front; primary cold then warm (octet 9), the eval-anchored agreement AND the wrong-fixture semantic-mismatch RED (wrong-field subject over the primary build) run WARM on the same build, then the wrong-field alt tree colds in the SAME root with the flipped octet 1. Formerly ~7 crate builds per pass; now 2. Wet tests run before pure share-on-hit in the aggregate (eval-call memo ordering trap). Pure receipts unchanged."

data field_access_family_cache_root: String = "/tmp/gunbc_emit_on_demand_field_access"
data field_access_family_emitter: String = "v2.compiler.emit"
data field_access_family_provider: std.materialization_ladder.CacheProvider = std.materialization_ladder.provider_row(
  id: "emit-on-demand-field-access",
  scope: [],
  coverage: std.materialization_ladder.CoversAllComputations,
  tier: std.materialization_ladder.ArtifactTier { keying: std.materialization_ladder.ContentKeyed },
  retention: std.materialization_ladder.persistent_retention(capacity: std.cache_interface.CapacityBounded { limit: std.cache_interface.ByteCapacity { limit: std.cache_interface.ExactLimit { value: std.measure.byte_size(count: 1000000) } }, at_capacity: std.cache_interface.ReplaceExisting { strategy: std.cache_interface.LeastRecentlyUsed } })
)

fn field_access_family_native_key_for(tree: v2.compiler.inferred_tree.InferredTree) -> std.content_hash.ContentHash {
  std.emit_on_demand.emit_on_demand_key(
    closure_digest: inferred_tree_digest(tree: tree),
    emitter_identity: field_access_family_emitter,
    target_language: "rust",
    grain: std.emit_on_demand.NativeArtifact
  )
}

fn field_access_family_primary_tree() -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> {
  emit_field_eval_producer_tree()
}

fn field_access_family_alt_tree() -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> {
  emit_field_eval_alt_descent_producer_tree()
}

fn field_access_family_test_store() -> std.artifact_store.ArtifactStore {
  match std.artifact_store.store_over_provider(provider: field_access_family_provider) {
    StoreReady { store: s } => s
    StoreRefusedRetention { provider_id: _, declared: _ } =>
      std.artifact_store.ArtifactStore { budget: std.measure.byte_size(count: 0), next_ordinal: 1, rows: [] }
  }
}

test fn emit_on_demand_field_access_grain_keys_differ_holds() -> Bool {
  match field_access_family_primary_tree() {
    Accepted { value: tree, diagnostics: _ } =>
      let digest = inferred_tree_digest(tree: tree)
      let source = std.emit_on_demand.emit_on_demand_key(
        closure_digest: digest,
        emitter_identity: field_access_family_emitter,
        target_language: "rust",
        grain: std.emit_on_demand.SourceArtifact
      )
      let native = std.emit_on_demand.emit_on_demand_key(
        closure_digest: digest,
        emitter_identity: field_access_family_emitter,
        target_language: "rust",
        grain: std.emit_on_demand.NativeArtifact
      )
      (source == native) == false
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_on_demand_field_access_materialize_recompute_on_miss_holds() -> Bool {
  match field_access_family_primary_tree() {
    Accepted { value: tree, diagnostics: _ } =>
      let lookup = std.emit_on_demand.emit_on_demand_lookup(
        store: field_access_family_test_store(),
        key: field_access_family_native_key_for(tree: tree)
      )
      match lookup {
        EmitOnDemandMiss => std.emit_on_demand.materialization_for_lookup(lookup: lookup) == std.realization.Recompute
        EmitOnDemandHit { receipt: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_on_demand_field_access_interpreter_roles_bounded_holds() -> Bool {
  std.emit_on_demand.interpreter_surviving_roles_bounded()
}

test fn emit_on_demand_field_access_schedule_refuses_unreadable_budget_holds() -> Bool {
  match field_access_family_primary_tree() {
    Accepted { value: tree, diagnostics: _ } =>
      match witness_family_realize_width(
        bound_bytes: std.measure.byte_size(count: 25),
        budget: BudgetUnreadable,
        witness_root: tree.root,
        independence_override: 4
      ) {
        BudgetRefused => true
        PackedWidth { width: _ } => false
        MaturationReserve { width: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn field_access_family_fixture_inputs() -> v2.compiler.eval.Inputs {
  inputs_for_emit_host(
    claim_input_root: emit_field_eval_subgraph_node,
    expected_eval_root: emit_field_eval_subgraph_node,
    claim_pin: ^emit_field_eval_evaluator_pin
  )
}

fn field_access_family_cached_run_with_source(
  workspace: String,
  tree: v2.compiler.inferred_tree.InferredTree,
  source: Medium<String>,
  expect_compile_skipped: Bool,
  expected_octet: Int
) -> Bool {
  match run_emit_host_cached(
    workspace_dir: workspace,
    target: rust_field_access_target_model_staging(),
    source: source,
    fixture_inputs: field_access_family_fixture_inputs()
  ) {
    Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        Accepted {
          value: HostLogicalRun { stdout: stdout },
          diagnostics: None
        } =>
          receipt.compile_skipped == expect_compile_skipped
            && stdout.bytes == emit_host_octets_byte_string(octets: [0, expected_octet, 0, 0, 0])
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn field_access_family_cache_root_for(test_id: String) -> String {
  concat(field_access_family_cache_root, "/", test_id)
}

fn field_access_cached_agreement_pass(workspace: String, tree: v2.compiler.inferred_tree.InferredTree) -> Bool {
  emit_field_eval_verdict_is_pass(
    run: run_test_claim_from_source_emit_vs_eval_cached(
      subject: emit_field_eval_subject(tree: tree),
      source_outcome: emit(tree: tree, target: rust_field_access_target_model_staging()),
      target: rust_field_access_target_model_staging(),
      workspace_dir: workspace,
      run_args: emit_host_no_run_args()
    )
  )
}

fn field_access_cached_wrong_fixture_mismatch(workspace: String, tree: v2.compiler.inferred_tree.InferredTree) -> Bool {
  emit_field_eval_verdict_is_semantic_mismatch(
    run: run_test_claim_from_source_emit_vs_eval_cached(
      subject: emit_field_eval_wrong_fixture_subject(tree: tree),
      source_outcome: emit(tree: tree, target: rust_field_access_target_model_staging()),
      target: rust_field_access_target_model_staging(),
      workspace_dir: workspace,
      run_args: emit_host_no_run_args()
    )
  )
}

fn field_access_family_cached_run_checks(
  workspace: String,
  tree: v2.compiler.inferred_tree.InferredTree,
  expect_compile_skipped: Bool,
  expected_octet: Int
) -> Bool {
  match emit(tree: tree, target: rust_field_access_target_model_staging()) {
    Accepted { value: source, diagnostics: _ } =>
      field_access_family_cached_run_with_source(
        workspace: workspace,
        tree: tree,
        source: source,
        expect_compile_skipped: expect_compile_skipped,
        expected_octet: expected_octet
      )
    Rejected { diagnostics: _ } => false
  }
}

fn field_access_family_cached_cold_then_warm(
  workspace: String,
  tree: v2.compiler.inferred_tree.InferredTree,
  expected_octet: Int
) -> Bool {
  match emit(tree: tree, target: rust_field_access_target_model_staging()) {
    Accepted { value: source, diagnostics: _ } =>
      field_access_family_cached_run_with_source(
        workspace: workspace,
        tree: tree,
        source: source,
        expect_compile_skipped: false,
        expected_octet: expected_octet
      )
        && field_access_family_cached_run_with_source(
          workspace: workspace,
          tree: tree,
          source: source,
          expect_compile_skipped: true,
          expected_octet: expected_octet
        )
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_on_demand_field_access_closure_keys_differ_for_distinct_trees_holds() -> Bool {
  match field_access_family_primary_tree() {
    Accepted { value: primary, diagnostics: _ } =>
      match field_access_family_alt_tree() {
        Accepted { value: alt, diagnostics: _ } =>
          (field_access_family_native_key_for(tree: primary) == field_access_family_native_key_for(tree: alt)) == false
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_on_demand_field_access_native_one_build_holds() -> Bool {
  match field_access_family_primary_tree() {
    Accepted { value: tree_primary, diagnostics: _ } =>
      let shared_parent = field_access_family_cache_root_for(test_id: "native_one_build")
      let key_primary = field_access_family_native_key_for(tree: tree_primary)
      let workspace_primary = extdeps.realization.emit_on_demand_host.native_cache_workspace_root(
        cache_root: shared_parent,
        key: key_primary
      )
      let _evict_primary = extdeps.realization.emit_on_demand_host.emit_on_demand_evict_native_cache(
        cache_root: shared_parent,
        key: key_primary
      )
      field_access_family_cached_cold_then_warm(
        workspace: workspace_primary,
        tree: tree_primary,
        expected_octet: 9
      )
        && field_access_cached_agreement_pass(
          workspace: workspace_primary,
          tree: tree_primary
        )
        && field_access_cached_wrong_fixture_mismatch(
          workspace: workspace_primary,
          tree: tree_primary
        )
        && match field_access_family_alt_tree() {
          Accepted { value: tree_alt, diagnostics: _ } =>
            let key_alt = field_access_family_native_key_for(tree: tree_alt)
            let workspace_alt = extdeps.realization.emit_on_demand_host.native_cache_workspace_root(
              cache_root: shared_parent,
              key: key_alt
            )
            let _evict_alt = extdeps.realization.emit_on_demand_host.emit_on_demand_evict_native_cache(
              cache_root: shared_parent,
              key: key_alt
            )
            field_access_family_cached_run_checks(
              workspace: workspace_alt,
              tree: tree_alt,
              expect_compile_skipped: false,
              expected_octet: 9
            )
          Rejected { diagnostics: _ } => false
        }
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_on_demand_field_access_materialize_share_on_hit_holds() -> Bool {
  match field_access_family_primary_tree() {
    Accepted { value: tree, diagnostics: _ } =>
      let key = field_access_family_native_key_for(tree: tree)
      std.artifact_store.store_put_fold(
        outcome: std.artifact_store.store_put(store: field_access_family_test_store(), key: key, artifact_bytes: std.measure.byte_size(count: 64)),
        admitted: fn(put_store, evicted) {
          let lookup = std.emit_on_demand.emit_on_demand_lookup(store: put_store, key: key)
          match lookup {
            EmitOnDemandHit { receipt: r } =>
              r.compile_skipped
                && std.emit_on_demand.materialization_for_lookup(lookup: lookup) == std.realization.Share
            EmitOnDemandMiss => false
          }
        },
        did_not_fit: (a, b) => false
      )
    Rejected { diagnostics: _ } => false
  }
}

