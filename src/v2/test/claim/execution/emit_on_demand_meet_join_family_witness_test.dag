module v2.test.execution.emit_on_demand_meet_join_family_witness


data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data emit_on_demand_meet_join_family_note: String = "Witness-realization fan-out lane 4 (meet_join): PURE receipts only — grain/closure key sensitivity, store hit/miss materialization, interpreter role bound, packed-width budget refusal. Native execution for meet/join MIGRATED to family grain (merry-pike-487 follow-on, std.emit_on_demand witness_family_build_grain_ruling): the executing consumer is emit_on_demand_family_crate_witness_test (one-build members-warm, eval-anchored member agreements, all-alt wrong-fixture octet flips) — the per-witness cold/warm/wrong-fixture crate builds formerly here are deleted, never rebuilt per witness. Residue is pure; the LiveTreeDisposition flip to SubstrateInputsOnly is a named follow-on (not flipped in the migration PR to keep the selection-safety change separately reviewable)."

data meet_join_family_emitter: String = "v2.compiler.emit"
data meet_join_family_provider: CacheProvider = provider_row(
  id: "emit-on-demand-meet-join-family",
  scope: [],
  coverage: CoversAllComputations,
  tier: ArtifactTier { keying: ContentKeyed },
  eviction: SpacePacked { budget: "meet join family native cache" }
)

fn meet_join_family_native_key_for(tree: InferredTree) -> ContentHash {
  emit_on_demand_key(
    closure_digest: inferred_tree_digest(tree: tree),
    emitter_identity: meet_join_family_emitter,
    target_language: "rust",
    grain: NativeArtifact
  )
}

fn meet_join_family_test_store() -> ArtifactStore {
  match store_over_provider(provider: meet_join_family_provider, budget: byte_size(count: 1000000)) {
    StoreReady { store: s } => s
    StoreRefusedEviction { provider_id: _, declared: _ } =>
      ArtifactStore { budget: byte_size(count: 0), next_ordinal: 1, rows: [] }
  }
}

fn meet_family_tree() -> InferredTree {
  meet_join_eval_tree_for(root: dag_meet_arrow_with_body_fixture)
}

fn meet_family_alt_tree() -> InferredTree {
  meet_join_eval_tree_for(root: dag_meet_arrow_with_body_swapped_arms_fixture)
}

fn join_family_tree() -> InferredTree {
  meet_join_eval_tree_for(root: dag_join_arrow_with_body_fixture)
}

fn join_family_alt_tree() -> InferredTree {
  meet_join_eval_tree_for(root: dag_join_arrow_with_body_swapped_arms_fixture)
}

test fn emit_on_demand_meet_join_grain_keys_differ_holds() -> Bool {
  let digest = inferred_tree_digest(tree: meet_family_tree())
  let source = emit_on_demand_key(
    closure_digest: digest,
    emitter_identity: meet_join_family_emitter,
    target_language: "rust",
    grain: SourceArtifact
  )
  let native = emit_on_demand_key(
    closure_digest: digest,
    emitter_identity: meet_join_family_emitter,
    target_language: "rust",
    grain: NativeArtifact
  )
  (source == native) == false
}

test fn emit_on_demand_meet_join_materialize_share_on_hit_holds() -> Bool {
  let key = meet_join_family_native_key_for(tree: meet_family_tree())
  let put = store_put(store: meet_join_family_test_store(), key: key, artifact_bytes: byte_size(count: 64))
  let lookup = emit_on_demand_lookup(store: put.store, key: key)
  match lookup {
    EmitOnDemandHit { receipt: r } =>
      r.compile_skipped
        && materialization_for_lookup(lookup: lookup) == Share
    EmitOnDemandMiss => false
  }
}

test fn emit_on_demand_meet_join_materialize_recompute_on_miss_holds() -> Bool {
  let lookup = emit_on_demand_lookup(
    store: meet_join_family_test_store(),
    key: meet_join_family_native_key_for(tree: meet_family_tree())
  )
  match lookup {
    EmitOnDemandMiss => materialization_for_lookup(lookup: lookup) == Recompute
    EmitOnDemandHit { receipt: _ } => false
  }
}

test fn emit_on_demand_meet_join_interpreter_roles_bounded_holds() -> Bool {
  interpreter_surviving_roles_bounded()
}

test fn emit_on_demand_meet_join_schedule_refuses_unreadable_budget_holds() -> Bool {
  match witness_family_realize_width(
    bound_bytes: byte_size(count: 25),
    budget: BudgetUnreadable,
    witness_root: meet_family_tree().root,
    independence_override: 4
  ) {
    BudgetRefused => true
    PackedWidth { width: _ } => false
    MaturationReserve { width: _ } => false
  }
}

test fn emit_on_demand_meet_closure_keys_differ_for_distinct_trees_holds() -> Bool {
  let key_primary = meet_join_family_native_key_for(tree: meet_family_tree())
  let key_alt = meet_join_family_native_key_for(tree: meet_family_alt_tree())
  key_primary != key_alt
}

test fn emit_on_demand_join_closure_keys_differ_for_distinct_trees_holds() -> Bool {
  let key_primary = meet_join_family_native_key_for(tree: join_family_tree())
  let key_alt = meet_join_family_native_key_for(tree: join_family_alt_tree())
  key_primary != key_alt
}

test fn emit_on_demand_meet_join_family_witnesses() -> Bool {
  emit_on_demand_meet_join_grain_keys_differ_holds()
    && emit_on_demand_meet_join_materialize_recompute_on_miss_holds()
    && emit_on_demand_meet_join_interpreter_roles_bounded_holds()
    && emit_on_demand_meet_join_schedule_refuses_unreadable_budget_holds()
    && emit_on_demand_meet_closure_keys_differ_for_distinct_trees_holds()
    && emit_on_demand_join_closure_keys_differ_for_distinct_trees_holds()
    && emit_on_demand_meet_join_materialize_share_on_hit_holds()
}
