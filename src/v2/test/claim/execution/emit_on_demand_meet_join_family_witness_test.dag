module v2.test.execution.emit_on_demand_meet_join_family_witness

import std.logic { Bool }
import std.types { ContentHash, String }
import std.measure { ByteSize, byte_size }
import std.materialization_ladder {
  CacheProvider, CoversAllComputations, ArtifactTier, ContentKeyed, SpacePacked, provider_row,
}
import std.artifact_store {
  ArtifactStore, StoreReady, StoreRefusedEviction, store_over_provider, store_put,
}
import std.realization { Share, Recompute }
import std.realize_pack {
  BudgetUnreadable, PackedWidth, MaturationReserve, BudgetRefused,
}
import std.emit_on_demand {
  SourceArtifact, NativeArtifact,
  emit_on_demand_key, emit_on_demand_lookup,
  materialization_for_lookup, EmitOnDemandHit, EmitOnDemandMiss,
  interpreter_surviving_roles_bounded,
}
import v2.std.emit_on_demand { witness_family_realize_width }
import extdeps.realization.emit_on_demand_host {
  native_cache_workspace_root, emit_on_demand_evict_native_cache,
}
import v2.compiler.emit { emit }
import extdeps.communication.medium { Medium }
import v2.compiler.emit_host {
  emit_host_octets_byte_string,
  run_emit_host_cached,
}
import v2.compiler.eval {
  Inputs,
  inputs_for_emit_host,
  inferred_tree_digest,
}
import v2.compiler.infer { InferredTree }
import v2.extdeps.languages.dag {
  dag_meet_arrow_with_body_fixture,
  dag_meet_arrow_with_body_swapped_arms_fixture,
  dag_meet_eval_subgraph_fixture,
  dag_join_arrow_with_body_fixture,
  dag_join_arrow_with_body_swapped_arms_fixture,
  dag_join_eval_subgraph_fixture,
}
import v2.extdeps.languages.rust_test {
  rust_logic_meet_target_model_staging,
  rust_logic_join_target_model_staging,
}
import v2.std.compilers.target_model { TargetModel }
import v2.test.execution.emit_host_meet_join_equals_eval {
  meet_join_eval_tree_for,
}
import v2.std.diagnostic { Accepted, Rejected, Outcome }
import v2.std.host_run { HostLogicalRun }
import v2.std.node { Node }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data emit_on_demand_meet_join_family_note: String = "Witness-realization fan-out lane 4 (meet_join): emit-on-demand native execution for std/logic meet and join — extension of #6879 kernel. Wet: interpreted==native equals_eval (emit_host_meet_join_equals_eval_test.dag — green via dag_node_is_eval_literal_atom complement-root repair, witty-owl-841), native cold/warm receipts, closure_digest key sensitivity, swapped-arms RED."

data meet_join_family_cache_root: String = "/tmp/gunbc_emit_on_demand_meet_join_family"
data meet_join_family_emitter: String = "v2.compiler.emit"
data meet_join_family_provider: CacheProvider = provider_row(
  id: "emit-on-demand-meet-join-family",
  scope: [],
  coverage: CoversAllComputations,
  tier: ArtifactTier { keying: ContentKeyed },
  eviction: SpacePacked { budget: "meet join family native cache" }
)

fn meet_join_family_native_key_for(tree: InferredTree) -> ContentHash {
  emit_on_demand_key(
    closure_digest: inferred_tree_digest(tree: tree),
    emitter_identity: meet_join_family_emitter,
    target_language: "rust",
    grain: NativeArtifact
  )
}

fn meet_join_family_test_store() -> ArtifactStore {
  match store_over_provider(provider: meet_join_family_provider, budget: byte_size(count: 1000000)) {
    StoreReady { store: s } => s
    StoreRefusedEviction { provider_id: _, declared: _ } =>
      ArtifactStore { budget: byte_size(count: 0), next_ordinal: 1, rows: [] }
  }
}

fn meet_family_tree() -> InferredTree {
  meet_join_eval_tree_for(root: dag_meet_arrow_with_body_fixture)
}

fn meet_family_alt_tree() -> InferredTree {
  meet_join_eval_tree_for(root: dag_meet_arrow_with_body_swapped_arms_fixture)
}

fn join_family_tree() -> InferredTree {
  meet_join_eval_tree_for(root: dag_join_arrow_with_body_fixture)
}

fn join_family_alt_tree() -> InferredTree {
  meet_join_eval_tree_for(root: dag_join_arrow_with_body_swapped_arms_fixture)
}

fn meet_join_family_fixture_inputs(subgraph: Node) -> Inputs {
  inputs_for_emit_host(
    claim_input_root: subgraph,
    expected_eval_root: subgraph,
    claim_pin: ^meet_join_eval_evaluator_pin
  )
}

fn meet_join_family_cache_root_for(test_id: String) -> String {
  concat(meet_join_family_cache_root, "/", test_id)
}

fn meet_join_family_evict_and_workspace(test_id: String, tree: InferredTree) -> String {
  let key = meet_join_family_native_key_for(tree: tree)
  let root = meet_join_family_cache_root_for(test_id: test_id)
  let _evict = emit_on_demand_evict_native_cache(cache_root: root, key: key)
  native_cache_workspace_root(cache_root: root, key: key)
}

fn meet_join_family_cached_run_with_source(
  workspace: String,
  tree: InferredTree,
  target: TargetModel,
  subgraph: Node,
  source: Medium<String>,
  expect_compile_skipped: Bool,
  expected_octet: Int
) -> Bool {
  match run_emit_host_cached(
    workspace_dir: workspace,
    target: target,
    source: source,
    fixture_inputs: meet_join_family_fixture_inputs(subgraph: subgraph)
  ) {
    Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        Accepted {
          value: HostLogicalRun { stdout: stdout },
          diagnostics: None
        } =>
          receipt.compile_skipped == expect_compile_skipped
            && stdout.bytes == emit_host_octets_byte_string(octets: [0, expected_octet, 0, 0, 0])
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn meet_join_family_cached_run_checks(
  workspace: String,
  tree: InferredTree,
  target: TargetModel,
  subgraph: Node,
  expect_compile_skipped: Bool,
  expected_octet: Int
) -> Bool {
  match emit(tree: tree, target: target) {
    Accepted { value: source, diagnostics: _ } =>
      meet_join_family_cached_run_with_source(
        workspace: workspace,
        tree: tree,
        target: target,
        subgraph: subgraph,
        source: source,
        expect_compile_skipped: expect_compile_skipped,
        expected_octet: expected_octet
      )
    Rejected { diagnostics: _ } => false
  }
}

fn meet_join_family_cached_cold_then_warm(
  workspace: String,
  tree: InferredTree,
  target: TargetModel,
  subgraph: Node,
  expected_octet: Int
) -> Bool {
  match emit(tree: tree, target: target) {
    Accepted { value: source, diagnostics: _ } =>
      meet_join_family_cached_run_with_source(
        workspace: workspace,
        tree: tree,
        target: target,
        subgraph: subgraph,
        source: source,
        expect_compile_skipped: false,
        expected_octet: expected_octet
      )
        && meet_join_family_cached_run_with_source(
          workspace: workspace,
          tree: tree,
          target: target,
          subgraph: subgraph,
          source: source,
          expect_compile_skipped: true,
          expected_octet: expected_octet
        )
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_on_demand_meet_join_grain_keys_differ_holds() -> Bool {
  let digest = inferred_tree_digest(tree: meet_family_tree())
  let source = emit_on_demand_key(
    closure_digest: digest,
    emitter_identity: meet_join_family_emitter,
    target_language: "rust",
    grain: SourceArtifact
  )
  let native = emit_on_demand_key(
    closure_digest: digest,
    emitter_identity: meet_join_family_emitter,
    target_language: "rust",
    grain: NativeArtifact
  )
  (source == native) == false
}

test fn emit_on_demand_meet_join_materialize_share_on_hit_holds() -> Bool {
  let key = meet_join_family_native_key_for(tree: meet_family_tree())
  let put = store_put(store: meet_join_family_test_store(), key: key, artifact_bytes: byte_size(count: 64))
  let lookup = emit_on_demand_lookup(store: put.store, key: key)
  match lookup {
    EmitOnDemandHit { receipt: r } =>
      r.compile_skipped
        && materialization_for_lookup(lookup: lookup) == Share
    EmitOnDemandMiss => false
  }
}

test fn emit_on_demand_meet_join_materialize_recompute_on_miss_holds() -> Bool {
  let lookup = emit_on_demand_lookup(
    store: meet_join_family_test_store(),
    key: meet_join_family_native_key_for(tree: meet_family_tree())
  )
  match lookup {
    EmitOnDemandMiss => materialization_for_lookup(lookup: lookup) == Recompute
    EmitOnDemandHit { receipt: _ } => false
  }
}

test fn emit_on_demand_meet_join_interpreter_roles_bounded_holds() -> Bool {
  interpreter_surviving_roles_bounded()
}

test fn emit_on_demand_meet_join_schedule_refuses_unreadable_budget_holds() -> Bool {
  match witness_family_realize_width(
    bound_bytes: byte_size(count: 25),
    budget: BudgetUnreadable,
    witness_root: meet_family_tree().root,
    independence_override: 4
  ) {
    BudgetRefused => true
    PackedWidth { width: _ } => false
    MaturationReserve { width: _ } => false
  }
}

test fn emit_on_demand_meet_closure_keys_differ_for_distinct_trees_holds() -> Bool {
  let key_primary = meet_join_family_native_key_for(tree: meet_family_tree())
  let key_alt = meet_join_family_native_key_for(tree: meet_family_alt_tree())
  key_primary != key_alt
}

test fn emit_on_demand_join_closure_keys_differ_for_distinct_trees_holds() -> Bool {
  let key_primary = meet_join_family_native_key_for(tree: join_family_tree())
  let key_alt = meet_join_family_native_key_for(tree: join_family_alt_tree())
  key_primary != key_alt
}

test fn emit_on_demand_meet_wrong_fixture_refuses_holds() -> Bool {
  let workspace = meet_join_family_evict_and_workspace(
    test_id: "meet_wrong_fixture_native",
    tree: meet_family_alt_tree()
  )
  meet_join_family_cached_run_checks(
    workspace: workspace,
    tree: meet_family_alt_tree(),
    target: rust_logic_meet_target_model_staging(),
    subgraph: dag_meet_eval_subgraph_fixture,
    expect_compile_skipped: false,
    expected_octet: 0
  )
}

test fn emit_on_demand_join_wrong_fixture_refuses_holds() -> Bool {
  let workspace = meet_join_family_evict_and_workspace(
    test_id: "join_wrong_fixture_native",
    tree: join_family_alt_tree()
  )
  meet_join_family_cached_run_checks(
    workspace: workspace,
    tree: join_family_alt_tree(),
    target: rust_logic_join_target_model_staging(),
    subgraph: dag_join_eval_subgraph_fixture,
    expect_compile_skipped: false,
    expected_octet: 0
  )
}

test fn emit_on_demand_meet_native_content_change_cold_rebuild_holds() -> Bool {
  let shared_parent = meet_join_family_cache_root_for(test_id: "meet_content_change_miss")
  let tree_primary = meet_family_tree()
  let tree_alt = meet_family_alt_tree()
  let key_primary = meet_join_family_native_key_for(tree: tree_primary)
  let key_alt = meet_join_family_native_key_for(tree: tree_alt)
  if key_primary == key_alt {
    false
  } else {
    let workspace_primary = native_cache_workspace_root(cache_root: shared_parent, key: key_primary)
    let _evict_primary = emit_on_demand_evict_native_cache(cache_root: shared_parent, key: key_primary)
    let _evict_alt = emit_on_demand_evict_native_cache(cache_root: shared_parent, key: key_alt)
    let warmed = meet_join_family_cached_cold_then_warm(
      workspace: workspace_primary,
      tree: tree_primary,
      target: rust_logic_meet_target_model_staging(),
      subgraph: dag_meet_eval_subgraph_fixture,
      expected_octet: 1
    )
    let workspace_alt = native_cache_workspace_root(cache_root: shared_parent, key: key_alt)
    warmed
      && meet_join_family_cached_run_checks(
        workspace: workspace_alt,
        tree: tree_alt,
        target: rust_logic_meet_target_model_staging(),
        subgraph: dag_meet_eval_subgraph_fixture,
        expect_compile_skipped: false,
        expected_octet: 0
      )
  }
}

test fn emit_on_demand_meet_native_cold_holds() -> Bool {
  let workspace = meet_join_family_evict_and_workspace(test_id: "meet_native_cold", tree: meet_family_tree())
  meet_join_family_cached_run_checks(
    workspace: workspace,
    tree: meet_family_tree(),
    target: rust_logic_meet_target_model_staging(),
    subgraph: dag_meet_eval_subgraph_fixture,
    expect_compile_skipped: false,
    expected_octet: 1
  )
}

test fn emit_on_demand_meet_native_cold_then_warm_holds() -> Bool {
  let workspace = meet_join_family_evict_and_workspace(test_id: "meet_native_cold_then_warm", tree: meet_family_tree())
  meet_join_family_cached_cold_then_warm(
    workspace: workspace,
    tree: meet_family_tree(),
    target: rust_logic_meet_target_model_staging(),
    subgraph: dag_meet_eval_subgraph_fixture,
    expected_octet: 1
  )
}

test fn emit_on_demand_join_native_cold_then_warm_holds() -> Bool {
  let workspace = meet_join_family_evict_and_workspace(test_id: "join_native_cold_then_warm", tree: join_family_tree())
  meet_join_family_cached_cold_then_warm(
    workspace: workspace,
    tree: join_family_tree(),
    target: rust_logic_join_target_model_staging(),
    subgraph: dag_join_eval_subgraph_fixture,
    expected_octet: 1
  )
}

test fn emit_on_demand_meet_join_family_witnesses() -> Bool {
  emit_on_demand_meet_join_grain_keys_differ_holds()
    && emit_on_demand_meet_join_materialize_recompute_on_miss_holds()
    && emit_on_demand_meet_join_interpreter_roles_bounded_holds()
    && emit_on_demand_meet_join_schedule_refuses_unreadable_budget_holds()
    && emit_on_demand_meet_closure_keys_differ_for_distinct_trees_holds()
    && emit_on_demand_join_closure_keys_differ_for_distinct_trees_holds()
    && emit_on_demand_meet_wrong_fixture_refuses_holds()
    && emit_on_demand_join_wrong_fixture_refuses_holds()
    && emit_on_demand_meet_native_content_change_cold_rebuild_holds()
    && emit_on_demand_meet_native_cold_holds()
    && emit_on_demand_meet_native_cold_then_warm_holds()
    && emit_on_demand_join_native_cold_then_warm_holds()
    && emit_on_demand_meet_join_materialize_share_on_hit_holds()
}
