module v2.test.execution.emit_host_complement_equals_eval

import v2.compiler.emit_host {
  emit_host_octets_byte_string,
  run_test_claim_emit_vs_eval
}
import v2.compiler.eval {
  EvalContext,
  TestClaimEvalSubject,
  TestClaimRun,
  eval_context_with_semantics,
  eval_test_claim_subject
}
import v2.compiler.infer { InferredFacts, InferredTree }
import v2.extdeps.languages.dag {
  dag_complement_arrow_with_body_fixture,
  dag_complement_arrow_with_body_swapped_arms_fixture,
  dag_complement_eval_subgraph_fixture
}
import v2.extdeps.languages.rust { rust_emit_host_runtime_primitive_type_node }
import v2.extdeps.languages.rust_test { rust_logic_complement_target_model_staging }
import v2.test.lens_common.infer_fixture { claim_inferred_facts_from_nodes }
import v2.std.cardinality { RankingDimension, TerminationProof }
import v2.std.collection { Absent, List, Map, Present, list_at_optional }
import v2.std.node { match_arm_body }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  node_locus,
  outcome_accepted,
  outcome_rejected
}
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Node,
  Symbol,
  TypeNode
}
import v2.std.node_query {
  find_named_child
}
import v2.std.runtime {
  BindInterpreter,
  BranchInterpreter,
  ControlTransfer,
  EnvironmentBindingKey,
  EvaluationEnvironment,
  InterpretationAlgebra,
  InterpretationStructureWitness,
  LoopInterpreter,
  MatchInterpreter,
  RuntimePrimitive,
  RuntimePrimitiveValue,
  RuntimeValue,
  TransformInterpreter,
  ValueInterpreter
}
import v2.std.verdict { BuildFailed, Deferred, Pass, RunFailed, SemanticMismatch, Verdict }
import v2.std.verification {
  EqualsClaim,
  Integration,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier3,
  manual_claim_anchor
}
import v2.std.witness { Holds, Witness }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data emit_complement_eval_subgraph_node: Node = dag_complement_eval_subgraph_fixture

fn emit_complement_eval_generic_facts(node: Node) -> InferredFacts {
  claim_inferred_facts_from_nodes(
    resolved: node,
    algebra: rust_emit_host_runtime_primitive_type_node(),
    descent: Holds {
      value: TerminationProof {
        non_increasing: [],
        strict: RankingDimension { measured: ^emit_complement_eval_generic_descent }
      }
    }
  )
}

fn emit_complement_eval_composed_facts(key: Node) -> Witness<InferredFacts> {
  Holds { value: emit_complement_eval_generic_facts(node: key) }
}

fn emit_complement_eval_tree_for(root: Node) -> InferredTree {
  InferredTree {
    root: root,
    facts: Map { lookup: emit_complement_eval_composed_facts }
  }
}

fn emit_complement_eval_octet_value(n: Int) -> RuntimeValue {
  RuntimePrimitive {
    value: RuntimePrimitiveValue {
      primitive_type: rust_emit_host_runtime_primitive_type_node(),
      bytes: emit_host_octets_byte_string(octets: [0, n, 0, 0, 0])
    }
  }
}

fn emit_complement_eval_diagnostic(reason: Symbol, node: Node) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn emit_complement_eval_bool_true(value: RuntimeValue) -> Bool {
  value == emit_complement_eval_octet_value(n: 1)
}

fn emit_complement_eval_bool_false(value: RuntimeValue) -> Bool {
  value == emit_complement_eval_octet_value(n: 0)
}

fn emit_complement_eval_allocate_literal(node: Node, _env: EvaluationEnvironment) -> Outcome<RuntimeValue> {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id == ^dag_complement_lit_true {
        outcome_accepted(value: emit_complement_eval_octet_value(n: 1))
      } else if id == ^dag_complement_lit_false {
        outcome_accepted(value: emit_complement_eval_octet_value(n: 0))
      } else {
        outcome_rejected(
          d: emit_complement_eval_diagnostic(reason: ^emit_complement_eval_literal_miss, node: node)
        )
      }
    _ =>
      outcome_rejected(
        d: emit_complement_eval_diagnostic(reason: ^emit_complement_eval_literal_miss, node: node)
      )
  }
}

fn emit_complement_eval_call_primitive(
  node: Node,
  _args: List<RuntimeValue>,
  _env: EvaluationEnvironment
) -> Outcome<RuntimeValue> {
  outcome_rejected(
    d: emit_complement_eval_diagnostic(reason: ^emit_complement_eval_call_primitive_miss, node: node)
  )
}

fn emit_complement_eval_choose_branch(
  node: Node,
  _value: RuntimeValue,
  _env: EvaluationEnvironment
) -> Outcome<Node> {
  outcome_rejected(
    d: emit_complement_eval_diagnostic(reason: ^emit_complement_eval_branch_miss, node: node)
  )
}

fn emit_complement_eval_step_loop(
  node: Node,
  _env: EvaluationEnvironment
) -> Outcome<ControlTransfer> {
  outcome_rejected(
    d: emit_complement_eval_diagnostic(reason: ^emit_complement_eval_loop_miss, node: node)
  )
}

fn emit_complement_eval_bind_value(
  _key: EnvironmentBindingKey,
  _value: RuntimeValue,
  env: EvaluationEnvironment
) -> Outcome<EvaluationEnvironment> {
  outcome_accepted(value: env)
}

fn emit_complement_eval_nth_arm_wire(node: Node, wanted: Int) -> Outcome<Node> {
  match list_at_optional(xs: node.children, index: wanted) {
    Present { value: child } =>
      match child {
        Edge { label: _, target: arm_wire } => outcome_accepted(value: arm_wire)
      }
    Absent =>
      outcome_rejected(
        d: emit_complement_eval_diagnostic(reason: ^emit_complement_eval_arm_miss, node: node)
      )
  }
}

fn emit_complement_eval_arm_body_node(arm_wire: Node) -> Outcome<Node> {
  match find_named_child(root: arm_wire, name: match_arm_body) {
    Accepted { value: body, diagnostics: _ } => outcome_accepted(value: body)
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn emit_complement_eval_choose_arm(
  node: Node,
  scrutinee: RuntimeValue,
  _env: EvaluationEnvironment
) -> Outcome<Node> {
  if emit_complement_eval_bool_true(value: scrutinee) {
    match emit_complement_eval_nth_arm_wire(node: node, wanted: 1) {
      Accepted { value: arm, diagnostics: _ } =>
        emit_complement_eval_arm_body_node(arm_wire: arm)
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
    }
  } else if emit_complement_eval_bool_false(value: scrutinee) {
    match emit_complement_eval_nth_arm_wire(node: node, wanted: 2) {
      Accepted { value: arm, diagnostics: _ } =>
        emit_complement_eval_arm_body_node(arm_wire: arm)
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
    }
  } else {
    outcome_rejected(
      d: emit_complement_eval_diagnostic(reason: ^emit_complement_eval_arm_miss, node: node)
    )
  }
}

fn emit_complement_eval_interpretation() -> InterpretationAlgebra {
  InterpretationAlgebra {
    value: ValueInterpreter { allocate_literal: emit_complement_eval_allocate_literal },
    transform: TransformInterpreter { call_primitive: emit_complement_eval_call_primitive },
    branch: BranchInterpreter { choose_branch: emit_complement_eval_choose_branch },
    loop: LoopInterpreter { step_loop: emit_complement_eval_step_loop },
    bind: BindInterpreter { bind_value: emit_complement_eval_bind_value },
    match: MatchInterpreter { choose_arm: emit_complement_eval_choose_arm }
  }
}

fn emit_complement_eval_structure_witness() -> InterpretationStructureWitness {
  InterpretationStructureWitness {
    allocate_literal: ^emit_complement_eval_allocate_literal_sym,
    call_primitive: ^emit_complement_eval_call_primitive_sym,
    choose_branch: ^emit_complement_eval_choose_branch_sym,
    step_loop: ^emit_complement_eval_step_loop_sym,
    bind_value: ^emit_complement_eval_bind_value_sym,
    choose_arm: ^emit_complement_eval_choose_arm_sym
  }
}

fn emit_complement_eval_context() -> EvalContext {
  eval_context_with_semantics(
    runtime_identity: ^emit_complement_eval_interpretation_pin,
    interpretation: emit_complement_eval_interpretation(),
    structure_witness: emit_complement_eval_structure_witness()
  )
}

fn emit_complement_eval_claim(rhs_result_node: Node) -> TestClaim {
  EqualsClaim {
    label: "S2 std/logic complement: rust emit(complement-fn) host-run(complement(True)) == eval(complement(True)) via shared octet codec",
    anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
    lhs: rhs_result_node,
    rhs: rhs_result_node,
    classification: TestClassification { tier: Tier3, layer: Integration }
  }
}

fn emit_complement_eval_subject(tree: InferredTree) -> TestClaimEvalSubject<Node> {
  eval_test_claim_subject(
    claim: emit_complement_eval_claim(rhs_result_node: emit_complement_eval_subgraph_node),
    context: emit_complement_eval_context(),
    tree: tree,
    evaluator_pin: ^emit_complement_eval_evaluator_pin
  )
}

fn emit_complement_eval_run(tree: InferredTree) -> TestClaimRun<Node, RuntimeValue> {
  run_test_claim_emit_vs_eval(
    subject: emit_complement_eval_subject(tree: tree),
    target: rust_logic_complement_target_model_staging()
  )
}

fn emit_complement_eval_verdict_is_pass(run: TestClaimRun<Node, RuntimeValue>) -> Bool {
  match run.verdict {
    Pass => true
    SemanticMismatch { actual: _, falsification: _ } => false
    BuildFailed { actual: _, diagnostic: _ } => false
    RunFailed { actual: _, diagnostic: _ } => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}

fn emit_complement_eval_verdict_is_semantic_mismatch(run: TestClaimRun<Node, RuntimeValue>) -> Bool {
  match run.verdict {
    SemanticMismatch { actual: _, falsification: _ } => true
    Pass => false
    BuildFailed { actual: _, diagnostic: _ } => false
    RunFailed { actual: _, diagnostic: _ } => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}

test fn emit_host_complement_equals_eval_holds() -> Bool {
  emit_complement_eval_verdict_is_pass(
    run: emit_complement_eval_run(
      tree: emit_complement_eval_tree_for(root: dag_complement_arrow_with_body_fixture)
    )
  )
}

test fn emit_host_complement_wrong_fixture_refuses_holds() -> Bool {
  emit_complement_eval_verdict_is_semantic_mismatch(
    run: emit_complement_eval_run(
      tree: emit_complement_eval_tree_for(root: dag_complement_arrow_with_body_swapped_arms_fixture)
    )
  )
}

test fn emit_host_complement_equals_eval_all_holds() -> Bool {
  emit_host_complement_equals_eval_holds() && emit_host_complement_wrong_fixture_refuses_holds()
}
