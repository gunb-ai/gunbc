module v2.test.execution.emit_host_fold_closure_equals_eval


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data emit_fold_eval_subgraph_node: v2.std.node.Node = v2.test.emit.fold_call_closure_fixture.fold_fixture_param_call_body

fn emit_fold_eval_generic_facts(node: v2.std.node.Node) -> v2.compiler.inferred_tree.InferredFacts {
  v2.test.lens_common.infer_fixture.claim_inferred_facts_from_nodes(
    resolved: node,
    algebra: v2.extdeps.languages.rust.rust_emit_host_runtime_primitive_type_node(),
    descent: v2.std.witness.Holds {
      value: v2.std.cardinality.TerminationProof {
        non_increasing: [],
        strict: v2.std.cardinality.RankingDimension { measured: ^emit_fold_eval_generic_descent }
      }
    }
  )
}

fn emit_fold_eval_composed_facts(key: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  v2.std.optional.optional_present(value: emit_fold_eval_generic_facts(node: key))
}

fn emit_fold_eval_tree_for(root: v2.std.node.Node) -> v2.compiler.inferred_tree.InferredTree {
  v2.compiler.inferred_tree.InferredTree {
    root: root,
    facts: PartialFunction { lookup: emit_fold_eval_composed_facts }
  }
}

fn emit_fold_eval_octet_value(n: Int) -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimePrimitive {
    value: v2.std.runtime.RuntimePrimitiveValue {
      primitive_type: v2.extdeps.languages.rust.rust_emit_host_runtime_primitive_type_node(),
      bytes: v2.compiler.emit_host.emit_host_octets_byte_string(octets: [0, n, 0, 0, 0])
    }
  }
}

fn emit_fold_eval_diagnostic(reason: v2.std.node.Symbol, node: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: reason,
    at: v2.std.diagnostic.node_locus(node: node),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn emit_fold_eval_nth_positional_target(node: v2.std.node.Node, wanted: Int) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match v2.std.collection.list_at_optional(xs: node.children, index: wanted) {
    v2.std.optional.Present { value: child } =>
      match child {
        v2.std.node.Edge { label: v2.std.node.Positional, target: t } => v2.std.diagnostic.outcome_accepted(value: t)
        v2.std.node.Edge { label: _, target: _ } =>
          v2.std.diagnostic.outcome_rejected(
            d: emit_fold_eval_diagnostic(reason: ^emit_fold_eval_child_miss, node: node)
          )
      }
    v2.std.optional.Absent =>
      v2.std.diagnostic.outcome_rejected(
        d: emit_fold_eval_diagnostic(reason: ^emit_fold_eval_child_miss, node: node)
      )
  }
}

fn emit_fold_eval_closure_operator_is_sub(closure: v2.std.node.Node) -> Bool {
  match v2.std.node_query.find_arrow_body_child(root: closure) {
    v2.std.diagnostic.Accepted { value: body, diagnostics: _ } =>
      match body.kind {
        v2.std.node.ComputationNode { behavior: v2.std.node.Transform } =>
          match emit_fold_eval_nth_positional_target(node: body, wanted: 0) {
            v2.std.diagnostic.Accepted { value: op, diagnostics: _ } =>
              match op.kind {
                v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } } => id == ^dag_token_minus
                _ => false
              }
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
          }
        _ => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn emit_fold_eval_allocate_literal(node: v2.std.node.Node, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  match node.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } } =>
      if id == ^dag_binding_mvp1_fold_xs || id == ^dag_binding_mvp1_fold_lit_three {
        v2.std.diagnostic.outcome_accepted(value: emit_fold_eval_octet_value(n: 3))
      } else if id == ^dag_binding_mvp1_fold_z || id == ^dag_binding_mvp1_fold_lit_four {
        v2.std.diagnostic.outcome_accepted(value: emit_fold_eval_octet_value(n: 4))
      } else {
        v2.std.diagnostic.outcome_rejected(
          d: emit_fold_eval_diagnostic(reason: ^emit_fold_eval_literal_miss, node: node)
        )
      }
    _ =>
      v2.std.diagnostic.outcome_rejected(
        d: emit_fold_eval_diagnostic(reason: ^emit_fold_eval_literal_miss, node: node)
      )
  }
}

data emit_fold_eval_closure_arg_note: String = "The closure operand is read from the EVALUATED argument list (the RuntimeClosure the eval walk materialized for transform child 3), not re-walked from the node AST. This is what makes the interpreted leg genuinely exercise structural closure-arg evaluation: if eval fails to produce a closure value at position 3, this refuses rather than silently falling back to an AST read that would pass without eval ever having evaluated the closure."

fn emit_fold_eval_closure_arrow_of(v: v2.std.runtime.RuntimeValue, node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match v {
    v2.std.runtime.RuntimeClosure { value: c } => v2.std.diagnostic.outcome_accepted(value: c.arrow)
    v2.std.runtime.RuntimePrimitive { value: _ } =>
      v2.std.diagnostic.outcome_rejected(
        d: emit_fold_eval_diagnostic(reason: ^emit_fold_eval_closure_arg_not_closure, node: node)
      )
    v2.std.runtime.RuntimeAggregate { value: _ } =>
      v2.std.diagnostic.outcome_rejected(
        d: emit_fold_eval_diagnostic(reason: ^emit_fold_eval_closure_arg_not_closure, node: node)
      )
    v2.std.runtime.RuntimeReference { value: _ } =>
      v2.std.diagnostic.outcome_rejected(
        d: emit_fold_eval_diagnostic(reason: ^emit_fold_eval_closure_arg_not_closure, node: node)
      )
    v2.std.runtime.RuntimeUnit { value: _ } =>
      v2.std.diagnostic.outcome_rejected(
        d: emit_fold_eval_diagnostic(reason: ^emit_fold_eval_closure_arg_not_closure, node: node)
      )
  }
}

fn emit_fold_eval_closure_arg(args: List<v2.std.runtime.RuntimeValue>, node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match v2.std.collection.list_nth(
    xs: args,
    wanted: 2,
    absent: emit_fold_eval_diagnostic(reason: ^emit_fold_eval_closure_arg_absent, node: node)
  ) {
    v2.std.witness.Holds { value: arg } => emit_fold_eval_closure_arrow_of(v: arg, node: node)
    v2.std.witness.Violates { diagnostic: d } => v2.std.diagnostic.outcome_rejected(d: d)
  }
}

fn emit_fold_eval_call_primitive(
  node: v2.std.node.Node,
  args: List<v2.std.runtime.RuntimeValue>,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  match emit_fold_eval_closure_arg(args: args, node: node) {
    v2.std.diagnostic.Accepted { value: closure, diagnostics: _ } =>
      if emit_fold_eval_closure_operator_is_sub(closure: closure) {
        v2.std.diagnostic.outcome_accepted(value: emit_fold_eval_octet_value(n: -1))
      } else {
        v2.std.diagnostic.outcome_accepted(value: emit_fold_eval_octet_value(n: 7))
      }
    v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn emit_fold_eval_choose_branch(
  node: v2.std.node.Node,
  _value: v2.std.runtime.RuntimeValue,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.outcome_rejected(
    d: emit_fold_eval_diagnostic(reason: ^emit_fold_eval_branch_miss, node: node)
  )
}

fn emit_fold_eval_step_loop(
  node: v2.std.node.Node,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.ControlTransfer> {
  v2.std.diagnostic.outcome_rejected(
    d: emit_fold_eval_diagnostic(reason: ^emit_fold_eval_loop_miss, node: node)
  )
}

fn emit_fold_eval_bind_value(
  _key: v2.std.runtime.EnvironmentBindingKey,
  _value: v2.std.runtime.RuntimeValue,
  env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.EvaluationEnvironment> {
  v2.std.diagnostic.outcome_accepted(value: env)
}

fn emit_fold_eval_choose_arm(
  node: v2.std.node.Node,
  _scrutinee: v2.std.runtime.RuntimeValue,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.outcome_rejected(
    d: emit_fold_eval_diagnostic(reason: ^emit_fold_eval_match_miss, node: node)
  )
}

fn emit_fold_eval_interpretation() -> v2.std.runtime.InterpretationAlgebra {
  v2.std.runtime.InterpretationAlgebra {
    value: v2.std.runtime.ValueInterpreter { allocate_literal: emit_fold_eval_allocate_literal, identity: ^emit_fold_eval_allocate_literal },
    transform: v2.std.runtime.TransformInterpreter { call_primitive: emit_fold_eval_call_primitive, identity: ^emit_fold_eval_call_primitive },
    branch: v2.std.runtime.BranchInterpreter { choose_branch: emit_fold_eval_choose_branch, identity: ^emit_fold_eval_choose_branch },
    loop: v2.std.runtime.LoopInterpreter { step_loop: emit_fold_eval_step_loop, identity: ^emit_fold_eval_step_loop },
    bind: v2.std.runtime.BindInterpreter { bind_value: emit_fold_eval_bind_value, identity: ^emit_fold_eval_bind_value },
    match: v2.std.runtime.MatchInterpreter { choose_arm: emit_fold_eval_choose_arm, identity: ^emit_fold_eval_choose_arm }
  }
}

fn emit_fold_eval_structure_witness() -> v2.std.runtime.InterpretationStructureWitness {
  v2.std.runtime.InterpretationStructureWitness {
    allocate_literal: ^emit_fold_eval_allocate_literal,
    call_primitive: ^emit_fold_eval_call_primitive,
    choose_branch: ^emit_fold_eval_choose_branch,
    step_loop: ^emit_fold_eval_step_loop,
    bind_value: ^emit_fold_eval_bind_value,
    choose_arm: ^emit_fold_eval_choose_arm
  }
}

fn emit_fold_eval_context() -> v2.compiler.eval.EvalContext {
  v2.compiler.eval.eval_context_with_semantics(
    runtime_identity: ^emit_fold_eval_interpretation_pin,
    interpretation: emit_fold_eval_interpretation(),
    structure_witness: emit_fold_eval_structure_witness()
  )
}

fn emit_fold_eval_claim(rhs_result_node: v2.std.node.Node) -> v2.std.verification.TestClaim {
  v2.std.verification.EqualsClaim {
    label: "S2 F5: rust emit(fold-call-closure-fn) host-run == eval(fold-body) via shared octet codec",
    anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
    lhs: rhs_result_node,
    rhs: rhs_result_node,
    classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier3, layer: v2.std.verification.Integration }
  }
}

fn emit_fold_eval_subject(root: v2.std.node.Node) -> v2.compiler.eval.TestClaimEvalSubject<v2.std.node.Node> {
  v2.compiler.eval.eval_test_claim_subject(
    claim: emit_fold_eval_claim(rhs_result_node: emit_fold_eval_subgraph_node),
    context: emit_fold_eval_context(),
    tree: emit_fold_eval_tree_for(root: root),
    evaluator_pin: ^emit_fold_eval_evaluator_pin
  )
}

fn emit_fold_eval_run(root: v2.std.node.Node) -> v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue> {
  v2.compiler.emit_host.run_test_claim_emit_vs_eval(
    subject: emit_fold_eval_subject(root: root),
    target: v2.extdeps.languages.rust_test.rust_fold_call_target_model_staging()
  )
}

fn emit_fold_eval_verdict_is_pass(run: v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>) -> Bool {
  match run.verdict {
    v2.std.verdict.Pass => true
    v2.std.verdict.SemanticMismatch { actual: _, falsification: _ } => false
    v2.std.verdict.BuildFailed { actual: _, diagnostic: _ } => false
    v2.std.verdict.RunFailed { actual: _, diagnostic: _ } => false
    v2.std.verdict.Deferred { actual: _, diagnostic: _ } => false
  }
}

fn emit_fold_eval_verdict_is_semantic_mismatch(run: v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>) -> Bool {
  match run.verdict {
    v2.std.verdict.SemanticMismatch { actual: _, falsification: _ } => true
    v2.std.verdict.Pass => false
    v2.std.verdict.BuildFailed { actual: _, diagnostic: _ } => false
    v2.std.verdict.RunFailed { actual: _, diagnostic: _ } => false
    v2.std.verdict.Deferred { actual: _, diagnostic: _ } => false
  }
}

test fn emit_host_fold_closure_equals_eval_holds() -> Bool {
  emit_fold_eval_verdict_is_pass(run: emit_fold_eval_run(root: v2.test.emit.fold_call_closure_fixture.fold_fixture_param_canonical_arrow))
}

test fn emit_host_fold_closure_wrong_fixture_refuses_holds() -> Bool {
  emit_fold_eval_verdict_is_semantic_mismatch(run: emit_fold_eval_run(root: v2.test.emit.fold_call_closure_fixture.fold_fixture_param_wrong_arrow))
}

