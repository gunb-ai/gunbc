module v2.test.execution.emit_on_demand_variant_construct_family_witness

import std.logic { Bool }
import std.types { ContentHash, String }
import std.measure { ByteSize, byte_size }
import std.materialization_ladder {
  CacheProvider, CoversAllComputations, ArtifactTier, ContentKeyed, SpacePacked, provider_row,
}
import std.artifact_store {
  ArtifactStore, StoreReady, StoreRefusedEviction, store_over_provider, store_put,
}
import std.realization { Share, Recompute }
import std.realize_pack {
  BudgetUnreadable, PackedWidth, MaturationReserve, BudgetRefused,
}
import std.emit_on_demand {
  SourceArtifact, NativeArtifact,
  emit_on_demand_key, emit_on_demand_lookup,
  materialization_for_lookup, EmitOnDemandHit, EmitOnDemandMiss,
  interpreter_surviving_roles_bounded,
}
import v2.std.emit_on_demand { witness_family_realize_width }
import extdeps.realization.emit_on_demand_host {
  native_cache_workspace_root, emit_on_demand_evict_native_cache,
}
import v2.compiler.emit { emit }
import extdeps.communication.medium { Medium }
import v2.compiler.emit_host {
  emit_host_octets_byte_string,
  run_emit_host_cached,
}
import v2.compiler.eval {
  Inputs,
  inputs_for_emit_host,
  inferred_tree_digest,
}
import v2.compiler.infer { InferredTree }
import v2.extdeps.languages.dag { dag_variant_construct_body_fixture }
import v2.extdeps.languages.rust_test { rust_variant_construct_target_model_staging }
import v2.test.execution.emit_host_variant_construct_equals_eval {
  emit_variant_construct_eval_tree,
  emit_variant_construct_eval_wrong_value_tree,
  emit_variant_construct_eval_subgraph_node,
}
import v2.std.diagnostic { Accepted, Rejected, Outcome }
import v2.std.host_run { HostLogicalRun }
import v2.std.node { Node }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data emit_on_demand_variant_construct_family_note: String = "Witness-realization fan-out lane 4 (variant_construct), consolidated to ONE-BUILD grain (std.emit_on_demand witness_family_build_grain_ruling, merry-pike-487 fan-out): the singleton family's crate builds ONCE per corpus pass. The single wet receipt is emit_on_demand_variant_construct_native_one_build_holds: one root, both keys evicted up front; primary cold then warm (octet 9), then the wrong-value alt tree colds in the SAME root with the flipped octet 1 — the content-change MISS and the wrong-value RED in one cold rebuild. Formerly 5 crate builds per pass (per-test eviction roots); now 2. Interpreted==native agreement stays in emit_host_variant_construct_equals_eval_test.dag (its own oracle leg). Pure receipts unchanged."

data variant_construct_family_cache_root: String = "/tmp/gunbc_emit_on_demand_variant_construct_family"
data variant_construct_family_emitter: String = "v2.compiler.emit"
data variant_construct_family_provider: CacheProvider = provider_row(
  id: "emit-on-demand-variant-construct-family",
  scope: [],
  coverage: CoversAllComputations,
  tier: ArtifactTier { keying: ContentKeyed },
  eviction: SpacePacked { budget: "variant construct family native cache" }
)

fn variant_construct_family_native_key_for(tree: InferredTree) -> ContentHash {
  emit_on_demand_key(
    closure_digest: inferred_tree_digest(tree: tree),
    emitter_identity: variant_construct_family_emitter,
    target_language: "rust",
    grain: NativeArtifact
  )
}

fn variant_construct_family_test_store() -> ArtifactStore {
  match store_over_provider(provider: variant_construct_family_provider, budget: byte_size(count: 1000000)) {
    StoreReady { store: s } => s
    StoreRefusedEviction { provider_id: _, declared: _ } =>
      ArtifactStore { budget: byte_size(count: 0), next_ordinal: 1, rows: [] }
  }
}

fn variant_construct_family_fixture_inputs() -> Inputs {
  inputs_for_emit_host(
    claim_input_root: emit_variant_construct_eval_subgraph_node,
    expected_eval_root: emit_variant_construct_eval_subgraph_node,
    claim_pin: ^emit_variant_construct_eval_evaluator_pin
  )
}

fn variant_construct_family_cache_root_for(test_id: String) -> String {
  concat(variant_construct_family_cache_root, "/", test_id)
}

fn variant_construct_family_cached_run_with_source(
  workspace: String,
  tree: InferredTree,
  source: Medium<String>,
  expect_compile_skipped: Bool,
  expected_octet: Int
) -> Bool {
  match run_emit_host_cached(
    workspace_dir: workspace,
    target: rust_variant_construct_target_model_staging(),
    source: source,
    fixture_inputs: variant_construct_family_fixture_inputs()
  ) {
    Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        Accepted {
          value: HostLogicalRun { stdout: stdout },
          diagnostics: None
        } =>
          receipt.compile_skipped == expect_compile_skipped
            && stdout.bytes == emit_host_octets_byte_string(octets: [0, expected_octet, 0, 0, 0])
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn variant_construct_family_cached_run_checks(
  workspace: String,
  tree: InferredTree,
  expect_compile_skipped: Bool,
  expected_octet: Int
) -> Bool {
  match emit(tree: tree, target: rust_variant_construct_target_model_staging()) {
    Accepted { value: source, diagnostics: _ } =>
      variant_construct_family_cached_run_with_source(
        workspace: workspace,
        tree: tree,
        source: source,
        expect_compile_skipped: expect_compile_skipped,
        expected_octet: expected_octet
      )
    Rejected { diagnostics: _ } => false
  }
}

fn variant_construct_family_cached_cold_then_warm(
  workspace: String,
  tree: InferredTree,
  expected_octet: Int
) -> Bool {
  match emit(tree: tree, target: rust_variant_construct_target_model_staging()) {
    Accepted { value: source, diagnostics: _ } =>
      variant_construct_family_cached_run_with_source(
        workspace: workspace,
        tree: tree,
        source: source,
        expect_compile_skipped: false,
        expected_octet: expected_octet
      )
        && variant_construct_family_cached_run_with_source(
          workspace: workspace,
          tree: tree,
          source: source,
          expect_compile_skipped: true,
          expected_octet: expected_octet
        )
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_on_demand_variant_construct_grain_keys_differ_holds() -> Bool {
  let digest = inferred_tree_digest(tree: emit_variant_construct_eval_tree)
  let source = emit_on_demand_key(
    closure_digest: digest,
    emitter_identity: variant_construct_family_emitter,
    target_language: "rust",
    grain: SourceArtifact
  )
  let native = emit_on_demand_key(
    closure_digest: digest,
    emitter_identity: variant_construct_family_emitter,
    target_language: "rust",
    grain: NativeArtifact
  )
  (source == native) == false
}

test fn emit_on_demand_variant_construct_materialize_share_on_hit_holds() -> Bool {
  let key = variant_construct_family_native_key_for(tree: emit_variant_construct_eval_tree)
  let put = store_put(store: variant_construct_family_test_store(), key: key, artifact_bytes: byte_size(count: 64))
  let lookup = emit_on_demand_lookup(store: put.store, key: key)
  match lookup {
    EmitOnDemandHit { receipt: r } =>
      r.compile_skipped
        && materialization_for_lookup(lookup: lookup) == Share
    EmitOnDemandMiss => false
  }
}

test fn emit_on_demand_variant_construct_materialize_recompute_on_miss_holds() -> Bool {
  let lookup = emit_on_demand_lookup(
    store: variant_construct_family_test_store(),
    key: variant_construct_family_native_key_for(tree: emit_variant_construct_eval_tree)
  )
  match lookup {
    EmitOnDemandMiss => materialization_for_lookup(lookup: lookup) == Recompute
    EmitOnDemandHit { receipt: _ } => false
  }
}

test fn emit_on_demand_variant_construct_interpreter_roles_bounded_holds() -> Bool {
  interpreter_surviving_roles_bounded()
}

test fn emit_on_demand_variant_construct_schedule_refuses_unreadable_budget_holds() -> Bool {
  match witness_family_realize_width(
    bound_bytes: byte_size(count: 25),
    budget: BudgetUnreadable,
    witness_root: emit_variant_construct_eval_tree.root,
    independence_override: 4
  ) {
    BudgetRefused => true
    PackedWidth { width: _ } => false
    MaturationReserve { width: _ } => false
  }
}

test fn emit_on_demand_variant_construct_closure_keys_differ_for_distinct_trees_holds() -> Bool {
  let key_primary = variant_construct_family_native_key_for(tree: emit_variant_construct_eval_tree)
  let key_alt = variant_construct_family_native_key_for(tree: emit_variant_construct_eval_wrong_value_tree)
  key_primary != key_alt
}

test fn emit_on_demand_variant_construct_native_one_build_holds() -> Bool {
  let shared_parent = variant_construct_family_cache_root_for(test_id: "native_one_build")
  let tree_primary = emit_variant_construct_eval_tree
  let tree_alt = emit_variant_construct_eval_wrong_value_tree
  let key_primary = variant_construct_family_native_key_for(tree: tree_primary)
  let key_alt = variant_construct_family_native_key_for(tree: tree_alt)
  if key_primary == key_alt {
    false
  } else {
    let workspace_primary = native_cache_workspace_root(cache_root: shared_parent, key: key_primary)
    let _evict_primary = emit_on_demand_evict_native_cache(cache_root: shared_parent, key: key_primary)
    let _evict_alt = emit_on_demand_evict_native_cache(cache_root: shared_parent, key: key_alt)
    let warmed = variant_construct_family_cached_cold_then_warm(
      workspace: workspace_primary,
      tree: tree_primary,
      expected_octet: 9
    )
    let workspace_alt = native_cache_workspace_root(cache_root: shared_parent, key: key_alt)
    warmed
      && variant_construct_family_cached_run_checks(
        workspace: workspace_alt,
        tree: tree_alt,
        expect_compile_skipped: false,
        expected_octet: 1
      )
  }
}

test fn emit_on_demand_variant_construct_family_witnesses() -> Bool {
  emit_on_demand_variant_construct_grain_keys_differ_holds()
    && emit_on_demand_variant_construct_materialize_recompute_on_miss_holds()
    && emit_on_demand_variant_construct_interpreter_roles_bounded_holds()
    && emit_on_demand_variant_construct_schedule_refuses_unreadable_budget_holds()
    && emit_on_demand_variant_construct_closure_keys_differ_for_distinct_trees_holds()
    && emit_on_demand_variant_construct_native_one_build_holds()
    && emit_on_demand_variant_construct_materialize_share_on_hit_holds()
}
