module v2.test.execution.emit_ingest_python_same_language_round_trip

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn emit_ingest_python_row_token_spine_classes(row: Node) -> v2.std.diagnostic.Outcome<List<v2.std.node.Symbol>> {
  bind_outcome(
    o: find_named_child(root: row, name: ^grammar_relation_field_tokens),
    f: fn(tokens_root) {
      bind_outcome(
        o: concrete_syntax_token_list_from_node(list_node: tokens_root),
        f: fn(tokens) {
          let classes = fold(
            tokens,
            init: std.algebra.Empty,
            f: fn(acc, t) {
              list_append(left: acc, right: [concrete_syntax_token_class(token: t)])
            }
          )
          outcome_accepted(value: classes)
        }
      )
    }
  )
}

fn emit_ingest_python_shared_rules() -> Node {
  python_translation_rules_node()
}

fn emit_ingest_python_canonical_row() -> Node {
  python_grammar_relation_row_node(row: python_grammar_relation_row())
}

fn emit_ingest_python_canonical_emitted() -> Node {
  python_emitted_add_fn_node()
}

test fn emit_python_backward_selects_canonical_row_holds() -> Bool {
  match grammar_relation_row_for_emitted(
    rules: emit_ingest_python_shared_rules(),
    emitted: emit_ingest_python_canonical_emitted()
  ) {
    v2.std.diagnostic.Accepted { value: row, diagnostics: _ } =>
      row == emit_ingest_python_canonical_row()
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn ingest_python_forward_selects_canonical_emitted_holds() -> Bool {
  match emit_ingest_python_row_token_spine_classes(row: emit_ingest_python_canonical_row()) {
    v2.std.diagnostic.Accepted { value: frontier, diagnostics: _ } =>
      match grammar_relation_row_forward_selection(
        frontier: frontier,
        rules: emit_ingest_python_shared_rules()
      ) {
        v2.std.diagnostic.Accepted { value: emitted, diagnostics: _ } =>
          emitted == emit_ingest_python_canonical_emitted()
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn emit_then_ingest_python_selector_identity_holds() -> Bool {
  match grammar_relation_row_for_emitted(
    rules: emit_ingest_python_shared_rules(),
    emitted: emit_ingest_python_canonical_emitted()
  ) {
    v2.std.diagnostic.Accepted { value: row, diagnostics: _ } =>
      match emit_ingest_python_row_token_spine_classes(row: row) {
        v2.std.diagnostic.Accepted { value: frontier, diagnostics: _ } =>
          match grammar_relation_row_forward_selection(
            frontier: frontier,
            rules: emit_ingest_python_shared_rules()
          ) {
            v2.std.diagnostic.Accepted { value: recovered, diagnostics: _ } =>
              recovered == emit_ingest_python_canonical_emitted()
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn ingest_then_emit_python_selector_identity_holds() -> Bool {
  match emit_ingest_python_row_token_spine_classes(row: emit_ingest_python_canonical_row()) {
    v2.std.diagnostic.Accepted { value: frontier, diagnostics: _ } =>
      match grammar_relation_row_forward_selection(
        frontier: frontier,
        rules: emit_ingest_python_shared_rules()
      ) {
        v2.std.diagnostic.Accepted { value: emitted, diagnostics: _ } =>
          match grammar_relation_row_for_emitted(
            rules: emit_ingest_python_shared_rules(),
            emitted: emitted
          ) {
            v2.std.diagnostic.Accepted { value: row, diagnostics: _ } =>
              row == emit_ingest_python_canonical_row()
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn emit_ingest_python_perturbed_frontier_fails_closed() -> Bool {
  match emit_ingest_python_row_token_spine_classes(row: emit_ingest_python_canonical_row()) {
    v2.std.diagnostic.Accepted { value: frontier, diagnostics: _ } =>
      match grammar_relation_row_forward_selection(
        frontier: list_append(left: frontier, right: [^emit_ingest_python_perturb_bogus_tok]),
        rules: emit_ingest_python_shared_rules()
      ) {
        v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
        v2.std.diagnostic.Rejected { diagnostics: _ } => true
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn ingest_python_forward_fails_closed_off_frontier_holds() -> Bool {
  match grammar_relation_row_forward_selection(
    frontier: std.algebra.Cons { head: ^emit_ingest_python_perturb_bogus_tok, tail: std.algebra.Empty },
    rules: emit_ingest_python_shared_rules()
  ) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
  }
}

test fn emit_python_backward_fails_closed_on_foreign_emitted_holds() -> Bool {
  match grammar_relation_row_for_emitted(
    rules: emit_ingest_python_shared_rules(),
    emitted: dag_fixture_emitted_add_fn
  ) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
  }
}

test fn python_same_language_parse_bridge_holds() -> Bool {
  match python_grammar_parse_fixture() {
    v2.std.diagnostic.Accepted { value: tree, diagnostics: _ } =>
      match parse_tree_to_target_model_bridge(
        parse_tree: tree,
        source_model: python_target_model()
      ) {
        v2.std.diagnostic.Accepted { value: recovered, diagnostics: _ } =>
          recovered == emit_ingest_python_canonical_emitted()
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn python_same_language_source_emit_round_trip_holds() -> Bool {
  match python_grammar_parse_fixture() {
    v2.std.diagnostic.Accepted { value: tree, diagnostics: _ } =>
      match cross_language_compile(
        parse_tree: tree,
        source_model: python_target_model(),
        target_model: python_target_model()
      ) {
        v2.std.diagnostic.Accepted { value: source, diagnostics: _ } =>
          (source.carried == python_source_text)
            && python_same_language_discriminates_on_real_tree()
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn python_same_language_discriminates_on_real_tree() -> Bool {
  match python_grammar_parse_fixture() {
    v2.std.diagnostic.Accepted { value: tree, diagnostics: _ } =>
      match parse_tree_to_emitted_node(
        parse_tree: tree,
        source_model: dag_target_model()
      ) {
        v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
        v2.std.diagnostic.Rejected { diagnostics: _ } => true
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn emit_ingest_python_same_language_round_trip_holds() -> Bool {
  emit_python_backward_selects_canonical_row_holds()
    && ingest_python_forward_selects_canonical_emitted_holds()
    && emit_then_ingest_python_selector_identity_holds()
    && ingest_then_emit_python_selector_identity_holds()
    && emit_ingest_python_perturbed_frontier_fails_closed()
    && ingest_python_forward_fails_closed_off_frontier_holds()
    && emit_python_backward_fails_closed_on_foreign_emitted_holds()
    && python_same_language_parse_bridge_holds()
    && python_same_language_source_emit_round_trip_holds()
    && python_same_language_discriminates_on_real_tree()
}
