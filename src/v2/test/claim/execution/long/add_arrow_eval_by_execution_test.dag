fn add_arrow_excess_actual_call_optional(callee: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match add_arrow_eval_int_literal_optional(lexeme: "2") {
    Present { value: two_lit } =>
      match add_arrow_eval_int_literal_optional(lexeme: "3") {
        Present { value: three_lit } =>
          v2.std.optional.Present {
            value: v2.std.node.Node {
              kind: v2.std.node.ComputationNode { behavior: v2.std.node.Transform },
              occurrence_id: v2.std.node.SyntheticOccurrence,
              children: [
                v2.std.node.Edge { label: v2.std.node.Positional, target: callee },
                v2.std.node.Edge { label: v2.std.node.Positional, target: two_lit },
                v2.std.node.Edge { label: v2.std.node.Positional, target: three_lit },
                v2.std.node.Edge { label: v2.std.node.Positional, target: two_lit }
              ]
            }
          }
        v2.std.optional.Absent => v2.std.optional.Absent
      }
    v2.std.optional.Absent => v2.std.optional.Absent
  }
}

fn add_arrow_eval_run_passes(run: v2.std.diagnostic.Outcome<v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>>) -> Bool {
  match run {
    Accepted { value: r, diagnostics: _ } =>
      match v2.compiler.eval.test_claim_run_verdict(run: r) {
        v2.std.verdict.Pass => true
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn add_arrow_eval_source_pipeline_admits_add_holds() -> Bool {
  match add_arrow_source_ingested_add_infers() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn add_arrow_eval_canonical_tree_infers_holds() -> Bool {
