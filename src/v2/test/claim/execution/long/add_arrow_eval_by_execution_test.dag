module v2.test.long.add_arrow_eval_by_execution


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn add_arrow_eval_atom(s: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } },
    occurrence_id: v2.std.node.SyntheticOccurrence,
    children: []
  }
}

fn add_arrow_eval_i64_node() -> v2.std.node.Node {
  add_arrow_eval_atom(s: ^add_arrow_eval_i64)
}

fn add_arrow_eval_int_literal_optional(lexeme: String) -> v2.std.optional.Optional<v2.std.node.Node> {
  match v2.extdeps.languages.dag.dag_int_literal_node_from_lexeme(lexeme: lexeme, occurrence_id: v2.std.node.SyntheticOccurrence) {
    Accepted { value: node, diagnostics: _ } => v2.std.optional.Present { value: node }
    Rejected { diagnostics: _ } => v2.std.optional.Absent
  }
}

fn add_arrow_eval_runtime_int_equals(value: v2.std.runtime.RuntimeValue, n: Int) -> Bool {
  match value {
    RuntimePrimitive { value: gunbc.plans.md_helpers.p } =>
      match v2.std.integer.integer_signed_i32_le_bytes_to_int(bytes: p.bytes) {
        Accepted { value: magnitude, diagnostics: _ } => magnitude == n
        Rejected { diagnostics: _ } => false
      }
    _ => false
  }
}

fn add_arrow_eval_runtime_diagnostic(n: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^add_arrow_eval_runtime_rejected,
    at: v2.std.diagnostic.node_locus(node: n),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn add_arrow_eval_ordered_add_args(args: std.types.List<v2.std.runtime.RuntimeValue>) -> Bool {
  if count(args) == 2 {
    match v2.std.collection.list_at_optional(xs: args, index: 0) {
      Present { value: left } =>
        match v2.std.collection.list_at_optional(xs: args, index: 1) {
          Present { value: right } =>
            add_arrow_eval_runtime_int_equals(value: left, n: 2)
              && add_arrow_eval_runtime_int_equals(value: right, n: 3)
          v2.std.optional.Absent => false
        }
      v2.std.optional.Absent => false
    }
  } else {
    false
  }
}

fn add_arrow_eval_int_runtime_value(n: Int) -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimePrimitive {
    value: v2.std.runtime.RuntimePrimitiveValue {
      primitive_type: add_arrow_eval_i64_node(),
      bytes: v2.std.integer.integer_int_to_signed_i32_le_bytes(value: n)
    }
  }
}

fn add_arrow_eval_call_primitive(
  node: v2.std.node.Node,
  args: std.types.List<v2.std.runtime.RuntimeValue>,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  if add_arrow_eval_ordered_add_args(args: args) {
    v2.std.diagnostic.outcome_accepted(value: add_arrow_eval_int_runtime_value(n: 5))
  } else {
    v2.std.diagnostic.outcome_rejected(d: add_arrow_eval_runtime_diagnostic(n: node))
  }
}

fn add_arrow_eval_choose_first_arm(node: v2.std.node.Node, _value: v2.std.runtime.RuntimeValue, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match v2.std.collection.list_at_optional(xs: v2.std.node_query.node_positional_child_targets(node: node), index: 1) {
    Present { value: extdeps.vendor.arm.arm } => v2.std.diagnostic.outcome_accepted(value: extdeps.vendor.arm.arm)
    v2.std.optional.Absent => v2.std.diagnostic.outcome_rejected(d: add_arrow_eval_runtime_diagnostic(n: node))
  }
}

fn add_arrow_eval_lazy_arm_interpretation() -> v2.std.runtime.InterpretationAlgebra {
  v2.std.runtime.InterpretationAlgebra {
    value: v2.std.runtime.ValueInterpreter {
      allocate_literal: v2.extdeps.runtimes.v2_evaluator.v2_eval_allocate_literal,
      identity: ^v2.extdeps.runtimes.v2_evaluator.v2_eval_allocate_literal
    },
    transform: v2.std.runtime.TransformInterpreter {
      call_primitive: add_arrow_eval_call_primitive,
      identity: ^add_arrow_eval_call_primitive
    },
    branch: v2.std.runtime.BranchInterpreter {
      choose_branch: add_arrow_eval_choose_first_arm,
      identity: ^add_arrow_eval_choose_first_arm
    },
    loop: v2.std.runtime.LoopInterpreter {
      step_loop: add_arrow_eval_step_loop,
      identity: ^add_arrow_eval_step_loop
    },
    bind: v2.std.runtime.BindInterpreter {
      bind_value: add_arrow_eval_bind_value,
      identity: ^add_arrow_eval_bind_value
    },
    match: v2.std.runtime.MatchInterpreter {
      choose_arm: v2.std.runtime.runtime_reject_match_arm,
      identity: ^v2.std.runtime.runtime_reject_match_arm    }
  }
}

fn add_arrow_eval_lazy_arm_branch_node() -> v2.std.node.Node {
  match add_arrow_eval_int_literal_optional(lexeme: "2") {
    Present { value: two_lit } =>
      match add_arrow_eval_int_literal_optional(lexeme: "5") {
        Present { value: five_lit } =>
          v2.std.node.Node {
            kind: v2.std.node.ComputationNode { behavior: v2.std.node.Branch },
            occurrence_id: v2.std.node.SyntheticOccurrence,
            children: [
              v2.std.node.Edge { label: v2.std.node.Positional, target: two_lit },
              v2.std.node.Edge { label: v2.std.node.Positional, target: five_lit },
              v2.std.node.Edge {
                label: v2.std.node.Positional,
                target: add_arrow_eval_atom(s: ^add_arrow_eval_unknown_arm_literal)
              }
            ]
          }
        v2.std.optional.Absent =>
          add_arrow_eval_atom(s: ^add_arrow_eval_lazy_arm_branch_miss)
      }
    v2.std.optional.Absent =>
      add_arrow_eval_atom(s: ^add_arrow_eval_lazy_arm_branch_miss)
  }
}

fn add_arrow_eval_step_loop(node: v2.std.node.Node, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.ControlTransfer> {
  v2.std.diagnostic.outcome_rejected(d: add_arrow_eval_runtime_diagnostic(n: node))
}

fn add_arrow_eval_bind_value(
  key: v2.std.runtime.EnvironmentBindingKey,
  value: v2.std.runtime.RuntimeValue,
  env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.EvaluationEnvironment> {
  v2.std.diagnostic.Accepted {
    value: v2.std.runtime.EvaluationEnvironment {
      bindings: v2.std.collection.map_insert(m: env.bindings, key: key, value: value)
    },
    diagnostics: v2.std.diagnostic.None
  }
}

fn add_arrow_eval_context() -> v2.compiler.eval.EvalContext {
  v2.compiler.eval.eval_context_v4_evaluator()
}

fn add_arrow_eval_parse_tokens(tokens: v2.std.compilers.lexing.TokenStream) -> v2.std.diagnostic.Outcome<v2.std.grammar.ParseTree> {
  let lm = v2.extdeps.languages.dag.dag_language_model()
  v2.std.diagnostic.bind_outcome(
    o: v2.compiler.parse.parse_module(tokens: tokens, grammar: lm.grammar),
    f: fn(artifact) {
      v2.std.diagnostic.outcome_accepted(value: artifact.tree)
    }
  )
}

fn add_arrow_source_ingested_add_infers() -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> {
  let lm = v2.extdeps.languages.dag.dag_language_model()
  v2.std.diagnostic.bind_outcome(
    o: v2.compiler.tokenize.tokenize(text: v2.compiler.ingested_fixture_arrows.ingested_add_module_source, file: ^add_arrow_eval_source_file, rules: lm.lex),
    f: fn(tokens) {
      v2.std.diagnostic.bind_outcome(
        o: add_arrow_eval_parse_tokens(tokens: tokens),
        f: fn(parsed) {
          v2.std.diagnostic.bind_outcome(
            o: v2.compiler.normalize.normalize(parse_tree: parsed),
            f: fn(normalized) {
              v2.std.diagnostic.bind_outcome(
                o: v2.compiler.resolve.resolve(tree: normalized, lm: lm),
                f: fn(resolved) {
                  v2.std.diagnostic.outcome_accepted(value: add_arrow_eval_admitted_tree(root: resolved))
                }
              )
            }
          )
        }
      )
    }
  )
}

fn add_arrow_eval_tokenize_source() -> v2.std.diagnostic.Outcome<v2.std.compilers.lexing.TokenStream> {
  let lm = v2.extdeps.languages.dag.dag_language_model()
  v2.compiler.tokenize.tokenize(text: v2.compiler.ingested_fixture_arrows.ingested_add_module_source, file: ^add_arrow_eval_source_file, rules: lm.lex)
}




// ONE PIPELINE RUN, NOT FOUR (witness-cost consolidation, 2026-08-19). This claim
// used to be the deepest step of a staircase: separate tokenize, parse, normalize
// and resolve claims, each redoing every stage before its own, so four stages cost
// ten stage-runs across four fresh frames. Each earlier claim asserted only that
// its stage ACCEPTED, and this one cannot reach resolve unless all three did -- a
// tokenize, parse or normalize refusal reds this row exactly as it redded its own.
// So the three are removed as subsumed rather than as unimportant, and what is lost
// is which stage failed, read from the refusal rather than from the row name.
//
// add_arrow_eval_produced_add_body_executes_holds went with them: its body was
// byte-identical to add_arrow_eval_source_driven_add_executes_holds, same fixture,
// same operands, same expected value. Both deletions are receipted in the
// gunbc.witness_deferral_freeze shrink log, and the roster rows go in this change
// because a frozen row naming an absent witness is a StaleFrozenPathDeferral refusal.
test fn add_arrow_eval_resolve_holds() -> Bool {
  let lm = v2.extdeps.languages.dag.dag_language_model()
  match add_arrow_eval_tokenize_source() {
    Accepted { value: tokens, diagnostics: _ } =>
      match add_arrow_eval_parse_tokens(tokens: tokens) {
        Accepted { value: parsed, diagnostics: _ } =>
          match v2.compiler.normalize.normalize(parse_tree: parsed) {
            Accepted { value: normalized, diagnostics: _ } =>
              match v2.compiler.resolve.resolve(tree: normalized, lm: lm) {
                Accepted { value: _, diagnostics: _ } => true
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn add_arrow_eval_add_call_optional(
  callee: v2.std.node.Node,
  left_lex: String,
  right_lex: String
) -> v2.std.optional.Optional<v2.std.node.Node> {
  match add_arrow_eval_int_literal_optional(lexeme: left_lex) {
    Present { value: left } =>
      match add_arrow_eval_int_literal_optional(lexeme: right_lex) {
        Present { value: right } =>
          v2.std.optional.Present {
            value: v2.std.node.Node {
              kind: v2.std.node.ComputationNode { behavior: v2.std.node.Transform },
              occurrence_id: v2.std.node.SyntheticOccurrence,
              children: [
                v2.std.node.Edge { label: v2.std.node.Positional, target: callee },
                v2.std.node.Edge { label: v2.std.node.Positional, target: left },
                v2.std.node.Edge { label: v2.std.node.Positional, target: right }
              ]
            }
          }
        v2.std.optional.Absent => v2.std.optional.Absent
      }
    v2.std.optional.Absent => v2.std.optional.Absent
  }
}

fn add_arrow_eval_tree_root(call: v2.std.node.Node, expected: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    occurrence_id: v2.std.node.SyntheticOccurrence,
    children: [
      v2.std.node.Edge { label: v2.std.node.Named { name: ^add_arrow_eval_actual }, target: call },
      v2.std.node.Edge { label: v2.std.node.Named { name: ^add_arrow_eval_expected }, target: expected }
    ]
  }
}

fn add_arrow_eval_facts_lookup(key: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  v2.std.optional.optional_present(value: v2.test.lens_common.infer_fixture.claim_inferred_facts_from_nodes(
      resolved: key,
      algebra: add_arrow_eval_i64_node(),
      descent: v2.std.cardinality.termination_proof_witness_for_node(n: key)
    ))
}

fn add_arrow_eval_admitted_tree(root: v2.std.node.Node) -> v2.compiler.inferred_tree.InferredTree {
  v2.compiler.inferred_tree.InferredTree {
    root: root,
    facts: std.types.Map {
      lookup: add_arrow_eval_facts_lookup
    }
  }
}

fn add_arrow_eval_inferred_run_tree(
  callee: v2.std.node.Node,
  left_lex: String,
  right_lex: String,
  expected_lex: String
) -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> {
  match add_arrow_eval_add_call_optional(callee: callee, left_lex: left_lex, right_lex: right_lex) {
    Present { value: call } =>
      match add_arrow_eval_int_literal_optional(lexeme: expected_lex) {
        Present { value: expected } => {
          let root = add_arrow_eval_tree_root(call: call, expected: expected)
          v2.std.diagnostic.outcome_accepted(value: add_arrow_eval_admitted_tree(root: root))
        }
        v2.std.optional.Absent =>
          v2.std.diagnostic.outcome_rejected(
            d: add_arrow_eval_runtime_diagnostic(
              n: add_arrow_eval_atom(s: ^add_arrow_eval_literal_miss)
            )
          )
      }
    v2.std.optional.Absent =>
      v2.std.diagnostic.outcome_rejected(
        d: add_arrow_eval_runtime_diagnostic(
          n: add_arrow_eval_atom(s: ^add_arrow_eval_literal_miss)
        )
      )
  }
}

fn add_arrow_eval_claim(input: v2.std.node.Node, expected: v2.std.node.Node) -> v2.std.verification.TestClaim {
  v2.std.verification.CompilesClaim {
    label: "manual/add_arrow: source-bridged add v2.std.node.Arrow.body executes through v2.compiler.eval.eval callee dispatch",
    anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
    input: input,
    expected_value: expected,
    classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: v2.std.verification.Unit }
  }
}

fn add_arrow_eval_subject(tree: v2.compiler.inferred_tree.InferredTree, input: v2.std.node.Node, expected: v2.std.node.Node) -> v2.compiler.eval.TestClaimEvalSubject<v2.std.node.Node> {
  v2.compiler.eval.TestClaimEvalSubject {
    claim: add_arrow_eval_claim(input: input, expected: expected),
    context: add_arrow_eval_context(),
    tree: tree,
    input: v2.compiler.eval.test_claim_typed_input_node(
      evaluator_input: input,
      evaluator_pin: ^add_arrow_eval_add_call_pin
    )
  }
}

fn add_arrow_eval_run(
  callee: v2.std.node.Node,
  left_lex: String,
  right_lex: String,
  expected_lex: String
) -> v2.std.diagnostic.Outcome<v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>> {
  match add_arrow_eval_add_call_optional(
    callee: callee,
    left_lex: left_lex,
    right_lex: right_lex
  ) {
    Present { value: v2.lens.no_dual_representation_test.scan.call_node } =>
      match add_arrow_eval_int_literal_optional(lexeme: expected_lex) {
        Present { value: expected } =>
          v2.std.diagnostic.bind_outcome(
            o: add_arrow_eval_inferred_run_tree(
              callee: callee,
              left_lex: left_lex,
              right_lex: right_lex,
              expected_lex: expected_lex
            ),
            f: fn(tree) {
              v2.std.diagnostic.outcome_accepted(
                value: v2.compiler.eval.run_test_claim(
                  subject: add_arrow_eval_subject(tree: tree, input: v2.lens.no_dual_representation_test.scan.call_node, expected: expected)
                )
              )
            }
          )
        v2.std.optional.Absent =>
          v2.std.diagnostic.outcome_rejected(
            d: add_arrow_eval_runtime_diagnostic(
              n: add_arrow_eval_atom(s: ^add_arrow_eval_literal_miss)
            )
          )
      }
    v2.std.optional.Absent =>
      v2.std.diagnostic.outcome_rejected(
        d: add_arrow_eval_runtime_diagnostic(
          n: add_arrow_eval_atom(s: ^add_arrow_eval_literal_miss)
        )
      )
  }
}

