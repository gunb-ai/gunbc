fn add_arrow_eval_step_loop_continue(node: v2.std.node.Node, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.ControlTransfer> {
  v2.std.diagnostic.outcome_accepted(value: v2.std.runtime.Continue { value: add_arrow_eval_int_runtime_value(n: 5) })
}

fn add_arrow_eval_lazy_arm_loop_interpretation() -> v2.std.runtime.InterpretationAlgebra {
  v2.std.runtime.InterpretationAlgebra {
    value: v2.std.runtime.ValueInterpreter { allocate_literal: v2.extdeps.runtimes.v2_evaluator.v2_eval_allocate_literal, identity: ^v2.extdeps.runtimes.v2_evaluator.v2_eval_allocate_literal },
    transform: v2.std.runtime.TransformInterpreter { call_primitive: add_arrow_eval_call_primitive, identity: ^add_arrow_eval_call_primitive },
    branch: v2.std.runtime.BranchInterpreter { choose_branch: add_arrow_eval_choose_first_arm, identity: ^add_arrow_eval_choose_first_arm },
    loop: v2.std.runtime.LoopInterpreter { step_loop: add_arrow_eval_step_loop_continue, identity: ^add_arrow_eval_step_loop_continue },
    bind: v2.std.runtime.BindInterpreter { bind_value: add_arrow_eval_bind_value, identity: ^add_arrow_eval_bind_value },
    match: v2.std.runtime.MatchInterpreter { choose_arm: v2.std.runtime.runtime_reject_match_arm, identity: ^v2.std.runtime.runtime_reject_match_arm }  }
}

fn add_arrow_eval_lazy_arm_loop_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: v2.std.node.Loop },
    occurrence_id: v2.std.node.SyntheticOccurrence,
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: add_arrow_eval_atom(s: ^add_arrow_eval_unknown_arm_literal) },
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^loop_bound_edge },
        target: add_arrow_eval_atom(s: ^add_arrow_eval_loop_measure_literal)
      }
    ]
  }
}

fn add_arrow_eval_loop_admitted_tree(root: v2.std.node.Node) -> v2.compiler.inferred_tree.InferredTree {
  v2.compiler.inferred_tree.InferredTree {
    root: root,
    facts: std.types.Map {
      lookup: fn(key) {
        match key.kind {
          ComputationNode { behavior: v2.std.node.Loop } =>
            v2.std.optional.Present {
              value: v2.test.lens_common.infer_fixture.claim_inferred_facts_from_nodes(
                resolved: key,
                algebra: add_arrow_eval_i64_node(),
                descent: v2.std.witness.Holds {
                  value: v2.std.cardinality.TerminationProof {
                    non_increasing: [],
                    strict: v2.std.cardinality.RankingDimension {
                      measured: ^add_arrow_eval_loop_measure_literal
                    }
                  }
                }
              )
            }
          _ =>
            add_arrow_eval_facts_lookup(key: key)
        }
      }
    }
  }
}

test fn add_arrow_eval_lazy_arm_loop_suppression_holds() -> Bool {
  let loop_node = add_arrow_eval_lazy_arm_loop_node()
  let tree = add_arrow_eval_loop_admitted_tree(root: loop_node)
  match v2.compiler.eval.eval(
    tree: tree,
    interpretation: add_arrow_eval_lazy_arm_loop_interpretation(),
    inputs: v2.compiler.eval.inputs_root_only(root: loop_node)
  ) {
    Accepted { value: v, diagnostics: _ } =>
      add_arrow_eval_runtime_int_equals(value: v, n: 5)
    Rejected { diagnostics: _ } => false
  }
}

