  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: v2.std.node.Transform },
    occurrence_id: v2.std.node.SyntheticOccurrence,
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: add_arrow_eval_atom(s: ^dag_token_plus) },
      v2.std.node.Edge { label: v2.std.node.Positional, target: add_arrow_eval_atom(s: ^dag_binding_param_y) },
      v2.std.node.Edge { label: v2.std.node.Positional, target: add_arrow_eval_atom(s: ^dag_binding_param_x) }
    ]
  }
}

