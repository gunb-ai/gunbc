module v2.test.long.emit_host_classical_not_ingested_equals_eval


data ingested_classical_not_source: String = "module m\n\nfn classical_not(x: Int) -> Int {\n  match x {\n    true => false,\n    false => true\n  }\n}\n"

data ingested_classical_not_swapped_source: String = "module m\n\nfn classical_not(x: Int) -> Int {\n  match x {\n    true => true,\n    false => false\n  }\n}\n"

fn ingested_find_arrow_in_module(root: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match root.kind {
    TypeNode { connective: Arrow } => v2.std.optional.Present { value: root }
    _ =>
      fold(root.children, init: v2.std.optional.Absent, f: fn(acc, e) {
        match acc {
          v2.std.optional.Present { value: _ } => acc
          v2.std.optional.Absent => v2.test.long.emit_host_classical_not_ingested_equals_eval.ingested_find_arrow_in_module(root: e.target)
        }
      })
  }
}

fn ingested_resolved_module_from_source(source: String) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  let lm = v2.extdeps.languages.dag.dag_language_model()
  v2.std.diagnostic.bind_outcome(
    o: v2.compiler.tokenize.tokenize(text: source, file: ^ingested_classical_not_file, rules: lm.lex),
    f: fn(tokens) {
      v2.std.diagnostic.bind_outcome(
        o: v2.compiler.parse.parse_module(tokens: tokens, grammar: lm.grammar),
        f: fn(artifact) {
          v2.std.diagnostic.bind_outcome(
            o: v2.compiler.normalize.normalize(parse_tree: artifact.tree),
            f: fn(normalized) {
              v2.compiler.resolve.resolve(tree: normalized, lm: lm)
            }
          )
        }
      )
    }
  )
}

fn ingested_arrow_from_source(source: String) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: v2.test.long.emit_host_classical_not_ingested_equals_eval.ingested_resolved_module_from_source(source: source),
    f: fn(resolved) {
      match v2.test.long.emit_host_classical_not_ingested_equals_eval.ingested_find_arrow_in_module(root: resolved) {
        v2.std.optional.Present { value: arrow } => v2.std.diagnostic.outcome_accepted(value: arrow)
        v2.std.optional.Absent =>
          v2.std.diagnostic.outcome_rejected(
            d: ingested_classical_not_diagnostic(reason: ^ingested_classical_not_arrow_miss, node: resolved)
          )
      }
    }
  )
}
fn ingested_canonical_inferred_tree_from_source(source: String) -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> {
  v2.std.diagnostic.bind_outcome(
    o: v2.test.long.emit_host_classical_not_ingested_equals_eval.ingested_arrow_from_source(source: source),
    f: fn(arrow) {
      v2.compiler.infer.infer(tree: arrow)
    }
  )
}

fn ingested_classical_not_staging_facts_lookup(
  canonical: v2.compiler.inferred_tree.InferredTree,
  key: v2.std.node.Node
) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  match v2.compiler.infer.inferred_facts_witness_for_node(tree: canonical, node: key) {
    Holds { value: facts } =>
      v2.std.optional.Present { value: facts }
    Violates { diagnostic: _ } =>
      v2.std.optional.Present { value: ingested_classical_not_composed_facts(key: key) }
  }
}

fn ingested_staging_inferred_tree_from_source(source: String) -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> {
  v2.std.diagnostic.bind_outcome(
    o: v2.test.long.emit_host_classical_not_ingested_equals_eval.ingested_arrow_from_source(source: source),
    f: fn(arrow) {
      v2.std.diagnostic.bind_outcome(
        o: v2.compiler.infer.infer(tree: arrow),
        f: fn(inferred) {
          v2.std.diagnostic.outcome_accepted(
            value: v2.compiler.inferred_tree.InferredTree {
              root: inferred.root,
              facts: std.types.Map {
                lookup: fn(key) {
                  ingested_classical_not_staging_facts_lookup(canonical: inferred, key: key)
                }
              }
            }
          )
        }
      )
    }
  )
}

fn ingested_emit_shape_frontier_tree_from_source(source: String) -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> {
  v2.std.diagnostic.bind_outcome(
    o: v2.test.long.emit_host_classical_not_ingested_equals_eval.ingested_arrow_from_source(source: source),
    f: fn(arrow) {
      v2.std.diagnostic.outcome_accepted(
        value: v2.compiler.inferred_tree.InferredTree {
          root: arrow,
          facts: std.types.Map {
            lookup: fn(_key) {
              v2.std.optional.Absent
            }
          }
        }
      )
    }
  )
}

fn ingested_wet_emit_eval_composed_tree_from_source(source: String) -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> {
  v2.std.diagnostic.bind_outcome(
    o: v2.test.long.emit_host_classical_not_ingested_equals_eval.ingested_arrow_from_source(source: source),
    f: fn(arrow) {
      v2.std.diagnostic.bind_outcome(
        o: v2.compiler.infer.infer(tree: arrow),
        f: fn(inferred) {
          v2.std.diagnostic.outcome_accepted(
            value: v2.compiler.inferred_tree.InferredTree {
              root: inferred.root,
              facts: std.types.Map {
                lookup: fn(key) {
                  v2.std.optional.Present { value: ingested_classical_not_composed_facts(key: key) }
                }
              }
            }
          )
        }
      )
    }
  )
}

fn ingested_inferred_tree_from_source(source: String) -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> {
  ingested_staging_inferred_tree_from_source(source: source)
}

fn ingested_classical_not_eval_subgraph_canonical() -> v2.std.node.Node {
  v2.extdeps.languages.dag.dag_match_body_from_arms(
    scrutinee: v2.extdeps.languages.dag.dag_type_atom_node(identity: ^dag_token_kw_true),
    true_arm: v2.extdeps.languages.dag.dag_match_arm_node(
      pattern_lit: ^dag_token_kw_true,
      body_lit: ^dag_token_kw_false
    ),
    false_arm: v2.extdeps.languages.dag.dag_match_arm_node(
      pattern_lit: ^dag_token_kw_false,
      body_lit: ^dag_token_kw_true
    )
  )
}

fn ingested_classical_not_diagnostic(reason: v2.std.node.Symbol, node: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: reason,
    at: v2.std.diagnostic.node_locus(node: node),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn ingested_resolves(source: String) -> v2.std.logic.Bool {
  match v2.test.long.emit_host_classical_not_ingested_equals_eval.ingested_resolved_module_from_source(source: source) {
    Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn ingested_arrow_has_match_body(source: String) -> v2.std.logic.Bool {
  match v2.test.long.emit_host_classical_not_ingested_equals_eval.ingested_arrow_from_source(source: source) {
    Accepted { value: arrow, diagnostics: _ } =>
      match v2.std.node_query.find_arrow_body_child(root: arrow) {
        Accepted { value: body, diagnostics: _ } =>
          match body.kind {
            ComputationNode { behavior: Match } => true
            _ => false
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn ingested_classical_not_generic_facts(node: v2.std.node.Node) -> v2.compiler.inferred_tree.InferredFacts {
  v2.test.lens_common.infer_fixture.claim_inferred_facts_from_nodes(
    resolved: node,
    algebra: v2.extdeps.languages.rust.rust_emit_host_runtime_primitive_type_node(),
    descent: v2.std.witness.Holds {
      value: v2.std.cardinality.TerminationProof {
        non_increasing: [],
        strict: v2.std.cardinality.RankingDimension { measured: ^ingested_classical_not_generic_descent }
      }
    }
  )
}

fn ingested_classical_not_composed_facts(key: v2.std.node.Node) -> v2.compiler.inferred_tree.InferredFacts {
  ingested_classical_not_generic_facts(node: key)
}

fn ingested_classical_not_octet_value(n: Int) -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimePrimitive {
    value: v2.std.runtime.RuntimePrimitiveValue {
      primitive_type: v2.extdeps.languages.rust.rust_emit_host_runtime_primitive_type_node(),
      bytes: v2.compiler.emit_host.emit_host_octets_byte_string(octets: [0, n, 0, 0, 0])
    }
  }
}

fn ingested_classical_not_bool_true(value: v2.std.runtime.RuntimeValue) -> v2.std.logic.Bool {
  value == ingested_classical_not_octet_value(n: 1)
}

fn ingested_classical_not_bool_false(value: v2.std.runtime.RuntimeValue) -> v2.std.logic.Bool {
  value == ingested_classical_not_octet_value(n: 0)
}

fn ingested_classical_not_allocate_literal(node: v2.std.node.Node, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id == ^dag_token_kw_true {
        v2.std.diagnostic.outcome_accepted(value: ingested_classical_not_octet_value(n: 1))
      } else if id == ^dag_token_kw_false {
        v2.std.diagnostic.outcome_accepted(value: ingested_classical_not_octet_value(n: 0))
      } else {
        v2.std.diagnostic.outcome_rejected(
          d: ingested_classical_not_diagnostic(reason: ^ingested_classical_not_literal_miss, node: node)
        )
      }
    _ =>
      v2.std.diagnostic.outcome_rejected(
        d: ingested_classical_not_diagnostic(reason: ^ingested_classical_not_literal_miss, node: node)
      )
  }
}

fn ingested_classical_not_call_primitive(
  node: v2.std.node.Node,
  _args: std.types.List<v2.std.runtime.RuntimeValue>,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.outcome_rejected(
    d: ingested_classical_not_diagnostic(reason: ^ingested_classical_not_call_primitive_miss, node: node)
  )
}

fn ingested_classical_not_choose_branch(
  node: v2.std.node.Node,
  _value: v2.std.runtime.RuntimeValue,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.outcome_rejected(
    d: ingested_classical_not_diagnostic(reason: ^ingested_classical_not_branch_miss, node: node)
  )
}

fn ingested_classical_not_step_loop(
  node: v2.std.node.Node,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.ControlTransfer> {
  v2.std.diagnostic.outcome_rejected(
    d: ingested_classical_not_diagnostic(reason: ^ingested_classical_not_loop_miss, node: node)
  )
}

fn ingested_classical_not_bind_value(
  _key: v2.std.runtime.EnvironmentBindingKey,
  _value: v2.std.runtime.RuntimeValue,
  env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.EvaluationEnvironment> {
  v2.std.diagnostic.outcome_accepted(value: env)
}

fn ingested_classical_not_nth_arm_wire(node: v2.std.node.Node, wanted: Int) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match v2.std.collection.list_at_optional(xs: node.children, index: wanted) {
    v2.std.optional.Present { value: child } =>
      match child {
        Edge { label: _, target: arm_wire } => v2.std.diagnostic.outcome_accepted(value: arm_wire)
      }
    v2.std.optional.Absent =>
      v2.std.diagnostic.outcome_rejected(
        d: ingested_classical_not_diagnostic(reason: ^ingested_classical_not_arm_miss, node: node)
      )
  }
}

fn ingested_classical_not_arm_body_node(arm_wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match v2.std.node_query.find_named_child(root: arm_wire, name: v2.std.node.match_arm_body) {
    Accepted { value: body, diagnostics: _ } => v2.std.diagnostic.outcome_accepted(value: body)
    v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn ingested_classical_not_choose_arm(
  node: v2.std.node.Node,
  scrutinee: v2.std.runtime.RuntimeValue,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  if ingested_classical_not_bool_true(value: scrutinee) {
    match ingested_classical_not_nth_arm_wire(node: node, wanted: 1) {
      Accepted { value: arm, diagnostics: _ } =>
        ingested_classical_not_arm_body_node(arm_wire: extdeps.vendor.arm.arm)
      v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
    }
  } else if ingested_classical_not_bool_false(value: scrutinee) {
    match ingested_classical_not_nth_arm_wire(node: node, wanted: 2) {
      Accepted { value: arm, diagnostics: _ } =>
        ingested_classical_not_arm_body_node(arm_wire: extdeps.vendor.arm.arm)
      v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
    }
  } else {
    v2.std.diagnostic.outcome_rejected(
      d: ingested_classical_not_diagnostic(reason: ^ingested_classical_not_arm_miss, node: node)
    )
  }
}

fn ingested_classical_not_interpretation() -> v2.std.runtime.InterpretationAlgebra {
  v2.std.runtime.InterpretationAlgebra {
    value: v2.std.runtime.ValueInterpreter { allocate_literal: ingested_classical_not_allocate_literal, identity: ^ingested_classical_not_allocate_literal },
    transform: v2.std.runtime.TransformInterpreter { call_primitive: ingested_classical_not_call_primitive, identity: ^ingested_classical_not_call_primitive },
    branch: v2.std.runtime.BranchInterpreter { choose_branch: ingested_classical_not_choose_branch, identity: ^ingested_classical_not_choose_branch },
    loop: v2.std.runtime.LoopInterpreter { step_loop: ingested_classical_not_step_loop, identity: ^ingested_classical_not_step_loop },
    bind: v2.std.runtime.BindInterpreter { bind_value: ingested_classical_not_bind_value, identity: ^ingested_classical_not_bind_value },
    match: v2.std.runtime.MatchInterpreter { choose_arm: ingested_classical_not_choose_arm, identity: ^ingested_classical_not_choose_arm }
  }
}

fn ingested_classical_not_structure_witness() -> v2.std.runtime.InterpretationStructureWitness {
  v2.std.runtime.InterpretationStructureWitness {
    allocate_literal: ^ingested_classical_not_allocate_literal,
    call_primitive: ^ingested_classical_not_call_primitive,
    choose_branch: ^ingested_classical_not_choose_branch,
    step_loop: ^ingested_classical_not_step_loop,
    bind_value: ^ingested_classical_not_bind_value,
    choose_arm: ^ingested_classical_not_choose_arm  }
}

fn ingested_classical_not_context() -> v2.compiler.eval.EvalContext {
  v2.compiler.eval.eval_context_with_semantics(
    runtime_identity: ^ingested_classical_not_interpretation_pin,
    interpretation: ingested_classical_not_interpretation(),
    structure_witness: ingested_classical_not_structure_witness()
  )
}

fn ingested_classical_not_claim(rhs_result_node: v2.std.node.Node) -> v2.std.verification.TestClaim {
  v2.std.verification.EqualsClaim {
    label: "Wave1 exit: ingested classical_not emit-host == eval (true scrutinee → false)",
    anchor: v2.std.verification.manual_claim_anchor(anchor: ManualAnchorAbsent),
    lhs: rhs_result_node,
    rhs: rhs_result_node,
    classification: v2.std.verification.TestClassification { tier: Tier3, layer: Integration }
  }
}

fn ingested_classical_not_subject(tree: v2.compiler.inferred_tree.InferredTree, subgraph: v2.std.node.Node) -> v2.compiler.eval.TestClaimEvalSubject<v2.std.node.Node> {
  v2.compiler.eval.eval_test_claim_subject(
    claim: ingested_classical_not_claim(rhs_result_node: subgraph),
    context: ingested_classical_not_context(),
    tree: tree,
    evaluator_pin: ^ingested_classical_not_evaluator_pin
  )
}

fn ingested_classical_not_run(tree: v2.compiler.inferred_tree.InferredTree, subgraph: v2.std.node.Node) -> v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue> {
  v2.compiler.emit_host.run_test_claim_emit_vs_eval(
    subject: ingested_classical_not_subject(tree: tree, subgraph: subgraph),
    target: v2.extdeps.languages.rust_test.rust_classical_not_ingested_target_model_staging()
  )
}

fn ingested_classical_not_verdict_is_pass(run: v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>) -> v2.std.logic.Bool {
  match run.verdict {
    Pass => true
    SemanticMismatch { actual: _, falsification: _ } => false
    v2.std.verdict.BuildFailed { actual: _, diagnostic: _ } => false
    RunFailed { actual: _, diagnostic: _ } => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}

fn ingested_classical_not_verdict_is_semantic_mismatch(run: v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>) -> v2.std.logic.Bool {
  match run.verdict {
    SemanticMismatch { actual: _, falsification: _ } => true
    Pass => false
    v2.std.verdict.BuildFailed { actual: _, diagnostic: _ } => false
    RunFailed { actual: _, diagnostic: _ } => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}

test fn ingested_classical_not_eval_subgraph_canonical_octet_zero_holds() -> v2.std.logic.Bool {
  match ingested_inferred_tree_from_source(source: ingested_classical_not_source) {
    Accepted { value: tree, diagnostics: _ } =>
      match v2.compiler.eval.eval(
        tree: tree,
        interpretation: ingested_classical_not_interpretation(),
        inputs: v2.compiler.eval.inputs_root_only(root: ingested_classical_not_eval_subgraph_canonical())
      ) {
        Accepted { value: v, diagnostics: _ } =>
          v == ingested_classical_not_octet_value(n: 0)
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn ingested_classical_not_emit_octet_bridge_shape_holds() -> v2.std.logic.Bool {
  match ingested_emit_shape_frontier_tree_from_source(source: ingested_classical_not_source) {
    Accepted { value: tree, diagnostics: _ } =>
      match v2.compiler.emit.emit(tree: tree, target: v2.extdeps.languages.rust_test.rust_classical_not_ingested_target_model_staging()) {
        v2.std.diagnostic.Accepted { value: extdeps.communication.medium.Medium { carried: source, fidelity: _ }, diagnostics: _ } =>
          string_contains(s: source, pattern: "!= ")
            && string_contains(s: source, pattern: "true => 0")
            && string_contains(s: source, pattern: "false => 1")
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn ingested_classical_not_emit_source_arm_shape_holds() -> v2.std.logic.Bool {
  match ingested_emit_shape_frontier_tree_from_source(source: ingested_classical_not_source) {
    Accepted { value: tree, diagnostics: _ } =>
      match v2.compiler.emit.emit(tree: tree, target: v2.extdeps.languages.rust_test.rust_classical_not_ingested_target_model_staging()) {
        v2.std.diagnostic.Accepted { value: extdeps.communication.medium.Medium { carried: source, fidelity: _ }, diagnostics: _ } =>
          string_contains(s: source, pattern: "pub fn classical_not(x")
            || string_contains(s: source, pattern: "fn classical_not(x")
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn ingested_classical_not_canonical_emit_refuses_underived_holds() -> v2.std.logic.Bool {
  match ingested_canonical_inferred_tree_from_source(source: ingested_classical_not_source) {
    Accepted { value: tree, diagnostics: _ } =>
      match v2.compiler.emit.emit(tree: tree, target: v2.extdeps.languages.rust_test.rust_classical_not_ingested_target_model_staging()) {
        v2.std.diagnostic.Rejected { diagnostics: d } =>
          d.head.reason == ^infer_grounding_not_derived
        Accepted { value: _, diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn ingested_classical_not_resolves_holds() -> v2.std.logic.Bool {
  ingested_resolves(source: ingested_classical_not_source)
}

test fn ingested_classical_not_arrow_has_match_holds() -> v2.std.logic.Bool {
  ingested_arrow_has_match_body(source: ingested_classical_not_source)
}

fn ingested_classical_not_staging_emit_refuses_underived(source: String) -> v2.std.logic.Bool {
  match ingested_staging_inferred_tree_from_source(source: source) {
    Accepted { value: tree, diagnostics: _ } =>
      match v2.compiler.emit.emit(tree: tree, target: v2.extdeps.languages.rust_test.rust_classical_not_ingested_target_model_staging()) {
        v2.std.diagnostic.Rejected { diagnostics: d } =>
          d.head.reason == ^infer_grounding_not_derived
        Accepted { value: _, diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn ingested_classical_not_staging_emit_refuses_underived_holds() -> v2.std.logic.Bool {
  ingested_classical_not_staging_emit_refuses_underived(source: ingested_classical_not_source)
}

test fn ingested_classical_not_staging_swapped_emit_refuses_underived_holds() -> v2.std.logic.Bool {
  ingested_classical_not_staging_emit_refuses_underived(source: ingested_classical_not_swapped_source)
}

test fn emit_host_classical_not_ingested_equals_eval_holds() -> v2.std.logic.Bool {
  match ingested_wet_emit_eval_composed_tree_from_source(source: ingested_classical_not_source) {
    Accepted { value: tree, diagnostics: _ } =>
      ingested_classical_not_verdict_is_pass(
        run: ingested_classical_not_run(
          tree: tree,
          subgraph: ingested_classical_not_eval_subgraph_canonical()
        )
      )
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn emit_host_classical_not_ingested_swapped_refuses_holds() -> v2.std.logic.Bool {
  match ingested_wet_emit_eval_composed_tree_from_source(source: ingested_classical_not_swapped_source) {
    Accepted { value: tree, diagnostics: _ } =>
      ingested_classical_not_verdict_is_semantic_mismatch(
        run: ingested_classical_not_run(
          tree: tree,
          subgraph: ingested_classical_not_eval_subgraph_canonical()
        )
      )
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn ingested_classical_not_emit_accepts_holds() -> v2.std.logic.Bool {
  match ingested_emit_shape_frontier_tree_from_source(source: ingested_classical_not_source) {
    Accepted { value: tree, diagnostics: _ } =>
      match v2.compiler.emit.emit(tree: tree, target: v2.extdeps.languages.rust_test.rust_classical_not_ingested_target_model_staging()) {
        Accepted { value: _, diagnostics: _ } => true
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn ingested_classical_not_real_infer_holds() -> v2.std.logic.Bool {
  match v2.test.long.emit_host_classical_not_ingested_equals_eval.ingested_arrow_from_source(source: ingested_classical_not_source) {
    Accepted { value: arrow, diagnostics: _ } =>
      match v2.compiler.infer.infer(tree: arrow) {
        Accepted { value: _, diagnostics: _ } => true
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

