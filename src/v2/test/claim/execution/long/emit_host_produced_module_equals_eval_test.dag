module v2.test.long.emit_host_produced_module_equals_eval


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data produced_module_two_golden: String = "fn add(x: i32, y: i32) -> i32 { x + y }\n\nfn add2(x: i32, y: i32) -> i32 { x + y }\n\n"

fn produced_add_module_source() -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  match v2.compiler.ingested_fixture_arrows.ingested_add_decl_node(fn_name: ^rust_binding_fn_add) {
    Accepted { value: d1, diagnostics: _ } =>
      match v2.compiler.ingested_fixture_arrows.ingested_add_decl_node(fn_name: ^rust_binding_fn_add2) {
        Accepted { value: d2, diagnostics: _ } =>
          v2.compiler.emit_produced.emit_produced_module(decls: [d1, d2], target: v2.extdeps.languages.rust.rust_target_model_staging())
        Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
      }
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn produced_module_run(
  cp: fn(v2.std.node.Node, List<v2.std.runtime.RuntimeValue>, v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue>,
  cp_identity: v2.std.node.Symbol) -> v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue> {
  v2.compiler.emit_host.run_test_claim_from_source_emit_vs_eval(
    subject: v2.test.execution.emit_host_add_equals_eval.emit_eval_subject(call_primitive: cp, call_primitive_identity: cp_identity),
    source_outcome: produced_add_module_source(),
    target: v2.extdeps.languages.rust.rust_target_model_staging()
  )
}

fn produced_module_source_matches(golden: String) -> v2.std.logic.Bool {
  match produced_add_module_source() {
    Accepted { value: medium, diagnostics: _ } => medium.carried == golden
    Rejected { diagnostics: _ } => false
  }
}

test fn produced_module_two_distinct_fns_assemble() -> v2.std.logic.Bool {
  produced_module_source_matches(golden: produced_module_two_golden)
}

test fn emit_host_produced_module_add_equals_eval_holds() -> v2.std.logic.Bool {
  v2.test.execution.emit_host_add_equals_eval.emit_eval_verdict_is_pass(
    run: produced_module_run(cp: v2.test.execution.emit_host_add_equals_eval.emit_eval_call_primitive_five, cp_identity: ^emit_eval_call_primitive_five)
  )
}

test fn emit_host_produced_module_wrong_oracle_refuses_holds() -> v2.std.logic.Bool {
  v2.test.execution.emit_host_add_equals_eval.emit_eval_verdict_is_semantic_mismatch(
    run: produced_module_run(cp: v2.test.execution.emit_host_add_equals_eval.emit_eval_call_primitive_six, cp_identity: ^emit_eval_call_primitive_six)
  )
}

