module v2.test.long.pick_ingested_structural_lowering


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data pick_ingested_source: String = "module m\n\nfn pick() -> Int { if true { 1 } else { 2 } }\n"

data pick_ingested_false_source: String = "module m\n\nfn pick() -> Int { if false { 1 } else { 2 } }\n"

data pick_ingested_swapped_source: String = "module m\n\nfn pick() -> Int { if true { 2 } else { 1 } }\n"

data pick2_ingested_source: String = "module m\n\nfn pick() -> Int { if true { 3 } else { 4 } }\n"

data pick2_ingested_false_source: String = "module m\n\nfn pick() -> Int { if false { 3 } else { 4 } }\n"

data pick2_ingested_swapped_source: String = "module m\n\nfn pick() -> Int { if true { 4 } else { 3 } }\n"

fn pick_eval_atom(s: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } },
    occurrence_id: v2.std.node.SyntheticOccurrence,
    children: []
  }
}

fn pick_eval_int_type_node() -> v2.std.node.Node {
  pick_eval_atom(s: ^dag_binding_type_int)
}

fn pick_eval_runtime_diagnostic(n: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^pick_eval_runtime_rejected,
    at: v2.std.diagnostic.node_locus(node: n),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn pick_eval_int_literal_optional(lexeme: String) -> v2.std.optional.Optional<v2.std.node.Node> {
  match v2.extdeps.languages.dag.dag_int_literal_node_from_lexeme(lexeme: lexeme, occurrence_id: v2.std.node.SyntheticOccurrence) {
    v2.std.diagnostic.Accepted { value: node, diagnostics: _ } => v2.std.optional.Present { value: node }
    v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.optional.Absent
  }
}

fn pick_ingested_normalized_module_from_source(source: String) -> v2.std.diagnostic.Outcome<v2.compiler.normalized_tree.NormalizedTree> {
  let lm = v2.extdeps.languages.dag.dag_language_model()
  v2.std.diagnostic.bind_outcome(
    o: v2.compiler.tokenize.tokenize(text: source, file: ^pick_ingested_source_file, rules: lm.lex),
    f: fn(tokens) {
      v2.std.diagnostic.bind_outcome(
        o: v2.compiler.parse.parse_module(tokens: tokens, grammar: lm.grammar),
        f: fn(artifact) {
          v2.compiler.normalize.normalize(parse_tree: artifact.tree)
        }
      )
    }
  )
}

fn pick_ingested_parsed_module_from_source(source: String) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  let lm = v2.extdeps.languages.dag.dag_language_model()
  v2.std.diagnostic.bind_outcome(
    o: v2.compiler.tokenize.tokenize(text: source, file: ^pick_ingested_source_file, rules: lm.lex),
    f: fn(tokens) {
      v2.std.diagnostic.bind_outcome(
        o: v2.compiler.parse.parse_module(tokens: tokens, grammar: lm.grammar),
        f: fn(artifact) {
          v2.std.diagnostic.outcome_accepted(value: artifact.tree)
        }
      )
    }
  )
}

fn pick_ingested_find_arrow_in_module(root: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match root.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Arrow } => v2.std.optional.Present { value: root }
    _ =>
      fold(root.children, init: v2.std.optional.Absent, f: fn(acc, e) {
        match acc {
          v2.std.optional.Present { value: _ } => acc
          v2.std.optional.Absent => pick_ingested_find_arrow_in_module(root: e.target)
        }
      })
  }
}

fn pick_ingested_normalized_arrow_has_branch_body(source: String) -> Bool {
  match pick_ingested_normalized_module_from_source(source: source) {
    v2.std.diagnostic.Accepted { value: normalized, diagnostics: _ } =>
      match pick_ingested_find_arrow_in_module(root: normalized.root) {
        v2.std.optional.Present { value: arrow } =>
          match v2.std.node_query.find_arrow_body_child(root: arrow) {
            v2.std.diagnostic.Accepted { value: body, diagnostics: _ } =>
              match body.kind {
                v2.std.node.ComputationNode { behavior: v2.std.node.Branch } => true
                _ => false
              }
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
          }
        v2.std.optional.Absent => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn pick_ingested_deep_unwrap(node: v2.std.node.Node) -> v2.std.node.Node {
  match v2.std.node_query.find_named_child(root: node, name: ^grammar_optional_element_node_projection) {
    v2.std.diagnostic.Accepted { value: child, diagnostics: _ } => pick_ingested_deep_unwrap(node: child)
    v2.std.diagnostic.Rejected { diagnostics: _ } => node
  }
}

fn pick_ingested_int_literal_node_optional(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  let unwrapped = pick_ingested_deep_unwrap(node: node)
  if v2.extdeps.languages.dag.dag_node_is_int_literal_atom(node: unwrapped) {
    v2.std.optional.optional_present(value: unwrapped)
  } else {
    fold(unwrapped.children, init: v2.std.optional.Absent, f: fn(acc, e) {
      match acc {
        v2.std.optional.Present { value: _ } => acc
        v2.std.optional.Absent => pick_ingested_int_literal_node_optional(node: e.target)
      }
    })
  }
}

fn pick_ingested_branch_arm_magnitude_optional(body: v2.std.node.Node, arm_index: Int) -> v2.std.optional.Optional<Int> {
  match v2.std.collection.list_at_optional(xs: body.children, index: arm_index) {
    v2.std.optional.Present { value: edge } =>
      match edge {
        v2.std.node.Edge { label: _, target: arm } =>
          match pick_ingested_int_literal_node_optional(node: arm) {
            v2.std.optional.Present { value: literal } =>
              match v2.extdeps.languages.dag.dag_int_literal_magnitude_int_from_node(node: literal) {
                v2.std.diagnostic.Accepted { value: magnitude, diagnostics: _ } => v2.std.optional.Present { value: magnitude }
                v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.optional.Absent
              }
            v2.std.optional.Absent => v2.std.optional.Absent
          }
      }
    v2.std.optional.Absent => v2.std.optional.Absent
  }
}

fn pick_ingested_normalized_branch_arms_magnitude_holds(
  source: String,
  then_mag: Int,
  else_mag: Int
) -> Bool {
  match pick_ingested_normalized_module_from_source(source: source) {
    v2.std.diagnostic.Accepted { value: normalized, diagnostics: _ } =>
      match pick_ingested_find_arrow_in_module(root: normalized.root) {
        v2.std.optional.Present { value: arrow } =>
          match v2.std.node_query.find_arrow_body_child(root: arrow) {
            v2.std.diagnostic.Accepted { value: body, diagnostics: _ } =>
              match pick_ingested_branch_arm_magnitude_optional(body: body, arm_index: 1) {
                v2.std.optional.Present { value: then_found } =>
                  match pick_ingested_branch_arm_magnitude_optional(body: body, arm_index: 2) {
                    v2.std.optional.Present { value: else_found } =>
                      (then_found == then_mag) && (else_found == else_mag)
                    v2.std.optional.Absent => false
                  }
                v2.std.optional.Absent => false
              }
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
          }
        v2.std.optional.Absent => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn pick_ingested_normalized_swapped_arms_structural_red_holds() -> Bool {
  pick_ingested_normalized_branch_arms_magnitude_holds(
    source: pick_ingested_source,
    then_mag: 1,
    else_mag: 2
  ) && pick_ingested_normalized_branch_arms_magnitude_holds(
    source: pick_ingested_swapped_source,
    then_mag: 2,
    else_mag: 1
  )
}

fn pick_ingested_resolved_module_from_source(source: String) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  let lm = v2.extdeps.languages.dag.dag_language_model()
  v2.std.diagnostic.bind_outcome(
    o: v2.compiler.tokenize.tokenize(text: source, file: ^pick_ingested_source_file, rules: lm.lex),
    f: fn(tokens) {
      v2.std.diagnostic.bind_outcome(
        o: v2.compiler.parse.parse_module(tokens: tokens, grammar: lm.grammar),
        f: fn(artifact) {
          v2.std.diagnostic.bind_outcome(
            o: v2.compiler.normalize.normalize(parse_tree: artifact.tree),
            f: fn(normalized) {
              v2.compiler.resolve.resolve(tree: normalized, lm: lm)
            }
          )
        }
      )
    }
  )
}

fn pick_ingested_arrow_from_source(source: String) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: pick_ingested_resolved_module_from_source(source: source),
    f: fn(resolved) {
      match pick_ingested_find_arrow_in_module(root: resolved) {
        v2.std.optional.Present { value: arrow } => v2.std.diagnostic.outcome_accepted(value: arrow)
        v2.std.optional.Absent =>
          v2.std.diagnostic.outcome_rejected(
            d: pick_eval_runtime_diagnostic(
              n: pick_eval_atom(s: ^pick_ingested_arrow_miss)
            )
          )
      }
    }
  )
}

fn pick_eval_pick_call(callee: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: v2.std.node.Transform },
    occurrence_id: v2.std.node.SyntheticOccurrence,
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: callee }
    ]
  }
}

fn pick_eval_tree_root(call: v2.std.node.Node, expected: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    occurrence_id: v2.std.node.SyntheticOccurrence,
    children: [
      v2.std.node.Edge { label: v2.std.node.Named { name: ^pick_eval_actual }, target: call },
      v2.std.node.Edge { label: v2.std.node.Named { name: ^pick_eval_expected }, target: expected }
    ]
  }
}

fn pick_eval_facts_lookup(key: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  v2.std.optional.optional_present(value: v2.test.lens_common.infer_fixture.claim_inferred_facts_from_nodes(
      resolved: key,
      algebra: pick_eval_int_type_node(),
      descent: v2.std.cardinality.termination_proof_witness_for_node(n: key)
    ))
}

fn pick_eval_admitted_tree(root: v2.std.node.Node) -> v2.compiler.inferred_tree.InferredTree {
  v2.compiler.inferred_tree.InferredTree {
    root: root,
    facts: PartialFunction {
      lookup: pick_eval_facts_lookup
    }
  }
}

fn pick_eval_inferred_run_tree(call: v2.std.node.Node, expected: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> {
  let root = pick_eval_tree_root(call: call, expected: expected)
  v2.std.diagnostic.outcome_accepted(value: pick_eval_admitted_tree(root: root))
}

fn pick_eval_claim(input: v2.std.node.Node, expected: v2.std.node.Node) -> v2.std.verification.TestClaim {
  v2.std.verification.CompilesClaim {
    label: "execution/pick-ingested: if_expr→Branch structural lowering + eval-equals on default v2_evaluator",
    anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
    input: input,
    expected_value: expected,
    classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit }
  }
}

fn pick_eval_subject(
  tree: v2.compiler.inferred_tree.InferredTree,
  input: v2.std.node.Node,
  expected: v2.std.node.Node
) -> v2.compiler.eval.TestClaimEvalSubject<v2.std.node.Node> {
  v2.compiler.eval.TestClaimEvalSubject {
    claim: pick_eval_claim(input: input, expected: expected),
    context: v2.compiler.eval.eval_context_v4_evaluator(),
    tree: tree,
    input: v2.compiler.eval.test_claim_typed_input_node(
      evaluator_input: input,
      evaluator_pin: ^pick_eval_pick_call_pin
    )
  }
}

fn pick_eval_run(
  callee: v2.std.node.Node,
  expected_lexeme: String
) -> v2.std.diagnostic.Outcome<v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>> {
  match pick_eval_int_literal_optional(lexeme: expected_lexeme) {
    v2.std.optional.Present { value: expected } => {
      let call_node = pick_eval_pick_call(callee: callee)
      v2.std.diagnostic.bind_outcome(
        o: pick_eval_inferred_run_tree(call: call_node, expected: expected),
        f: fn(tree) {
          v2.std.diagnostic.outcome_accepted(
            value: v2.compiler.eval.run_test_claim(
              subject: pick_eval_subject(tree: tree, input: call_node, expected: expected)
            )
          )
        }
      )
    }
    v2.std.optional.Absent =>
      v2.std.diagnostic.outcome_rejected(
        d: pick_eval_runtime_diagnostic(n: pick_eval_atom(s: ^pick_eval_literal_miss))
      )
  }
}

fn pick_eval_run_passes(run: v2.std.diagnostic.Outcome<v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>>) -> Bool {
  match run {
    v2.std.diagnostic.Accepted { value: r, diagnostics: _ } =>
      match v2.compiler.eval.test_claim_run_verdict(run: r) {
        v2.std.verdict.Pass => true
        _ => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn pick_ingested_pick_true_executes_holds() -> Bool {
  match pick_ingested_arrow_from_source(source: pick_ingested_source) {
    v2.std.diagnostic.Accepted { value: arrow, diagnostics: _ } =>
      pick_eval_run_passes(
        run: pick_eval_run(
          callee: arrow,
          expected_lexeme: "1"
        )
      )
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn pick_ingested_pick_false_executes_holds() -> Bool {
  match pick_ingested_arrow_from_source(source: pick_ingested_false_source) {
    v2.std.diagnostic.Accepted { value: arrow, diagnostics: _ } =>
      pick_eval_run_passes(
        run: pick_eval_run(
          callee: arrow,
          expected_lexeme: "2"
        )
      )
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn pick_ingested_swapped_arms_red_holds() -> Bool {
  match pick_ingested_arrow_from_source(source: pick_ingested_swapped_source) {
    v2.std.diagnostic.Accepted { value: arrow, diagnostics: _ } =>
      pick_eval_run_passes(
        run: pick_eval_run(
          callee: arrow,
          expected_lexeme: "1"
        )
      ) == false
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn pick_ingested_pipeline_resolves_holds() -> Bool {
  match pick_ingested_resolved_module_from_source(source: pick_ingested_source) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn pick_ingested_normalized_arrow_has_branch_body_holds() -> Bool {
  pick_ingested_normalized_arrow_has_branch_body(source: pick_ingested_source)
}

test fn pick_ingested_parsed_module_from_source_holds() -> Bool {
  match pick_ingested_parsed_module_from_source(source: pick_ingested_source) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn pick2_ingested_pick_true_executes_holds() -> Bool {
  match pick_ingested_arrow_from_source(source: pick2_ingested_source) {
    v2.std.diagnostic.Accepted { value: arrow, diagnostics: _ } =>
      pick_eval_run_passes(
        run: pick_eval_run(
          callee: arrow,
          expected_lexeme: "3"
        )
      )
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn pick2_ingested_pick_false_executes_holds() -> Bool {
  match pick_ingested_arrow_from_source(source: pick2_ingested_false_source) {
    v2.std.diagnostic.Accepted { value: arrow, diagnostics: _ } =>
      pick_eval_run_passes(
        run: pick_eval_run(
          callee: arrow,
          expected_lexeme: "4"
        )
      )
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn pick2_ingested_swapped_arms_red_holds() -> Bool {
  match pick_ingested_arrow_from_source(source: pick2_ingested_swapped_source) {
    v2.std.diagnostic.Accepted { value: arrow, diagnostics: _ } =>
      pick_eval_run_passes(
        run: pick_eval_run(
          callee: arrow,
          expected_lexeme: "3"
        )
      ) == false
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

