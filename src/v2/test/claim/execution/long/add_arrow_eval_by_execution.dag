// EXACT-REASON SIBLINGS of the five reds. swapped_operands and wrong_value are SemanticMismatch by design
// (value computed, wrong expectation). The three excess reds are PRE-REGISTERED HYPOTHESES (the cause was not
// derived from source for body/signature) and may FAIL; a FAIL reads the red as UNPROVEN.
test fn add_arrow_swapped_operands_red_reason_is_semantic_mismatch_holds() -> Bool { aa_swapped_reason() == "V2_semantic_mismatch" }
test fn add_arrow_wrong_value_red_reason_is_semantic_mismatch_holds() -> Bool { aa_wrong_value_reason() == "V2_semantic_mismatch" }
test fn add_arrow_excess_signature_red_reason_is_argument_bind_absent_holds() -> Bool { aa_excess_signature_reason() == "eval_rejected_argument_bind_absent" }
test fn add_arrow_excess_body_red_reason_is_hypothesis_semantic_mismatch_holds() -> Bool { aa_excess_body_reason() == "V2_semantic_mismatch" }
test fn add_arrow_excess_actual_red_reason_is_argument_bind_absent_holds() -> Bool { aa_excess_actual_reason() == "eval_rejected_argument_bind_absent" }
