data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn add_arrow_eval_atom(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    occurrence_id: OccurrenceSynthetic,
    children: []
  }
}

fn add_arrow_eval_i64_node() -> Node {
  add_arrow_eval_atom(s: ^add_arrow_eval_i64)
}

fn add_arrow_eval_int_literal_optional(lexeme: String) -> Optional<Node> {
  match dag_int_literal_node_from_lexeme(lexeme: lexeme, occurrence_id: OccurrenceSynthetic) {
    Accepted { value: node, diagnostics: _ } => Present { value: node }
    Rejected { diagnostics: _ } => Absent
  }
}

fn add_arrow_eval_runtime_int_equals(value: RuntimeValue, n: Int) -> Bool {
  match value {
    RuntimePrimitive { value: p } =>
      match integer_signed_i32_le_bytes_to_int(bytes: p.bytes) {
        Accepted { value: magnitude, diagnostics: _ } => magnitude == n
        Rejected { diagnostics: _ } => false
      }
    _ => false
  }
}

fn add_arrow_eval_runtime_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^add_arrow_eval_runtime_rejected,
    at: node_locus(node: n),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn add_arrow_eval_ordered_add_args(args: List<RuntimeValue>) -> Bool {
  if count(args) == 2 {
    match list_at_optional(xs: args, index: 0) {
      Present { value: left } =>
        match list_at_optional(xs: args, index: 1) {
          Present { value: right } =>
            add_arrow_eval_runtime_int_equals(value: left, n: 2)
              && add_arrow_eval_runtime_int_equals(value: right, n: 3)
          Absent => false
        }
      Absent => false
    }
  } else {
    false
  }
}

fn add_arrow_eval_int_runtime_value(n: Int) -> RuntimeValue {
  RuntimePrimitive {
    value: RuntimePrimitiveValue {
      primitive_type: add_arrow_eval_i64_node(),
      bytes: integer_int_to_signed_i32_le_bytes(value: n)
    }
  }
}

fn add_arrow_eval_call_primitive(
  node: Node,
  args: List<RuntimeValue>,
  _env: EvaluationEnvironment
) -> Outcome<RuntimeValue> {
  if add_arrow_eval_ordered_add_args(args: args) {
    outcome_accepted(value: add_arrow_eval_int_runtime_value(n: 5))
  } else {
    outcome_rejected(d: add_arrow_eval_runtime_diagnostic(n: node))
  }
}

fn add_arrow_eval_choose_first_arm(node: Node, _value: RuntimeValue, _env: EvaluationEnvironment) -> Outcome<Node> {
  match list_at_optional(xs: positional_child_target_nodes(node: node), index: 1) {
    Present { value: arm } => outcome_accepted(value: arm)
    Absent => outcome_rejected(d: add_arrow_eval_runtime_diagnostic(n: node))
  }
}

fn add_arrow_eval_lazy_arm_interpretation() -> InterpretationAlgebra {
  InterpretationAlgebra {
    value: ValueInterpreter {
      allocate_literal: v2_eval_allocate_literal,
      identity: ^v2_eval_allocate_literal
    },
    transform: TransformInterpreter {
      call_primitive: add_arrow_eval_call_primitive,
      identity: ^add_arrow_eval_call_primitive
    },
    branch: BranchInterpreter {
      choose_branch: add_arrow_eval_choose_first_arm,
      identity: ^add_arrow_eval_choose_first_arm
    },
    loop: LoopInterpreter {
      step_loop: add_arrow_eval_step_loop,
      identity: ^add_arrow_eval_step_loop
    },
    bind: BindInterpreter {
      bind_value: add_arrow_eval_bind_value,
      identity: ^add_arrow_eval_bind_value
    },
    match: MatchInterpreter {
      choose_arm: runtime_reject_match_arm,
      identity: ^runtime_reject_match_arm
    }
  }
}

fn add_arrow_eval_lazy_arm_branch_node() -> Node {
  match add_arrow_eval_int_literal_optional(lexeme: "2") {
    Present { value: two_lit } =>
      match add_arrow_eval_int_literal_optional(lexeme: "5") {
        Present { value: five_lit } =>
          Node {
            kind: ComputationNode { behavior: Branch },
            occurrence_id: OccurrenceSynthetic,
            children: [
              Edge { label: Positional, target: two_lit, declaration: NotADeclaration },
              Edge { label: Positional, target: five_lit, declaration: NotADeclaration },
              Edge {
                label: Positional,
                target: add_arrow_eval_atom(s: ^add_arrow_eval_unknown_arm_literal),
                declaration: NotADeclaration
              }
            ]
          }
        Absent =>
          add_arrow_eval_atom(s: ^add_arrow_eval_lazy_arm_branch_miss)
      }
    Absent =>
      add_arrow_eval_atom(s: ^add_arrow_eval_lazy_arm_branch_miss)
  }
}

fn add_arrow_eval_step_loop(node: Node, _env: EvaluationEnvironment) -> Outcome<ControlTransfer> {
  outcome_rejected(d: add_arrow_eval_runtime_diagnostic(n: node))
}

fn add_arrow_eval_bind_value(
  key: EnvironmentBindingKey,
  value: RuntimeValue,
  env: EvaluationEnvironment
) -> Outcome<EvaluationEnvironment> {
  Accepted {
    value: EvaluationEnvironment {
      bindings: map_insert(m: env.bindings, key: key, value: value)
    },
    diagnostics: None
  }
}

fn add_arrow_eval_context() -> EvalContext {
  eval_context_v4_evaluator()
}

fn add_arrow_eval_parse_tokens(tokens: TokenStream) -> Outcome<ParseTree> {
  let lm = dag_language_model()
  bind_outcome(
    o: parse_module(tokens: tokens, grammar: lm.grammar),
    f: fn(artifact) {
      outcome_accepted(value: artifact.tree)
    }
  )
}

fn add_arrow_source_ingested_add_infers() -> Outcome<InferredTree> {
  let lm = dag_language_model()
  bind_outcome(
    o: tokenize(text: ingested_add_module_source, file: ^add_arrow_eval_source_file, rules: lm.lex),
    f: fn(tokens) {
      bind_outcome(
        o: add_arrow_eval_parse_tokens(tokens: tokens),
        f: fn(parsed) {
          bind_outcome(
            o: normalize(parse_tree: parsed),
            f: fn(normalized) {
              bind_outcome(
                o: resolve(tree: normalized, lm: lm),
                f: fn(resolved) {
                  outcome_accepted(value: add_arrow_eval_admitted_tree(root: resolved.root))
                }
              )
            }
          )
        }
      )
    }
  )
}

fn add_arrow_eval_tokenize_source() -> Outcome<TokenStream> {
  let lm = dag_language_model()
  tokenize(text: ingested_add_module_source, file: ^add_arrow_eval_source_file, rules: lm.lex)
}




// ONE PIPELINE RUN, NOT FOUR (witness-cost consolidation, 2026-08-19). This claim
// used to be the deepest step of a staircase: separate tokenize, parse, normalize
// and resolve claims, each redoing every stage before its own, so four stages cost
// ten stage-runs across four fresh frames. Each earlier claim asserted only that
// its stage ACCEPTED, and this one cannot reach resolve unless all three did -- a
// tokenize, parse or normalize refusal reds this row exactly as it redded its own.
// So the three are removed as subsumed rather than as unimportant, and what is lost
// is which stage failed, read from the refusal rather than from the row name.
//
// add_arrow_eval_produced_add_body_executes_holds went with them: its body was
// byte-identical to add_arrow_eval_source_driven_add_executes_holds, same fixture,
// same operands, same expected value. Both deletions are receipted in the
// gunbc.witness.witness_deferral_freeze shrink log, and the roster rows go in this change
// because a frozen row naming an absent witness is a StaleFrozenPathDeferral refusal.
test fn add_arrow_eval_resolve_holds() -> Bool {
  let lm = dag_language_model()
  match add_arrow_eval_tokenize_source() {
    Accepted { value: tokens, diagnostics: _ } =>
      match add_arrow_eval_parse_tokens(tokens: tokens) {
        Accepted { value: parsed, diagnostics: _ } =>
          match normalize(parse_tree: parsed) {
            Accepted { value: normalized, diagnostics: _ } =>
              match resolve(tree: normalized, lm: lm) {
                Accepted { value: _, diagnostics: _ } => true
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn add_arrow_eval_add_call_optional(
  callee: Node,
  left_lex: String,
  right_lex: String
) -> Optional<Node> {
  match add_arrow_eval_int_literal_optional(lexeme: left_lex) {
    Present { value: left } =>
      match add_arrow_eval_int_literal_optional(lexeme: right_lex) {
        Present { value: right } =>
          Present {
            value: Node {
              kind: ComputationNode { behavior: Transform },
              occurrence_id: OccurrenceSynthetic,
              children: [
                Edge { label: Positional, target: callee, declaration: NotADeclaration },
                Edge { label: Positional, target: left, declaration: NotADeclaration },
                Edge { label: Positional, target: right, declaration: NotADeclaration }
              ]
            }
          }
        Absent => Absent
      }
    Absent => Absent
  }
}

fn add_arrow_eval_tree_root(call: Node, expected: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    occurrence_id: OccurrenceSynthetic,
    children: [
      Edge { label: Authored { name: ^add_arrow_eval_actual }, target: call, declaration: NotADeclaration },
      Edge { label: Authored { name: ^add_arrow_eval_expected }, target: expected, declaration: NotADeclaration }
    ]
  }
}

fn add_arrow_eval_facts_lookup(key: Node) -> Optional<InferredFacts> {
  optional_present(value: claim_inferred_facts_from_nodes(
      resolved: key,
      algebra: add_arrow_eval_i64_node(),
      descent: termination_proof_witness_for_node(n: key)
    ))
}

fn add_arrow_eval_admitted_tree(root: Node) -> InferredTree {
  InferredTree {
    root: root,
    facts: PartialFunction {
      lookup: add_arrow_eval_facts_lookup
    }
  }
}

fn add_arrow_eval_inferred_run_tree(
  callee: Node,
  left_lex: String,
  right_lex: String,
  expected_lex: String
) -> Outcome<InferredTree> {
  match add_arrow_eval_add_call_optional(callee: callee, left_lex: left_lex, right_lex: right_lex) {
    Present { value: call } =>
      match add_arrow_eval_int_literal_optional(lexeme: expected_lex) {
        Present { value: expected } => {
          let root = add_arrow_eval_tree_root(call: call, expected: expected)
          outcome_accepted(value: add_arrow_eval_admitted_tree(root: root))
        }
        Absent =>
          outcome_rejected(
            d: add_arrow_eval_runtime_diagnostic(
              n: add_arrow_eval_atom(s: ^add_arrow_eval_literal_miss)
            )
          )
      }
    Absent =>
      outcome_rejected(
        d: add_arrow_eval_runtime_diagnostic(
          n: add_arrow_eval_atom(s: ^add_arrow_eval_literal_miss)
        )
      )
  }
}

fn add_arrow_eval_claim(input: Node, expected: Node) -> TestClaim {
  CompilesClaim {
    label: "manual/add_arrow: source-bridged add Arrow.body executes through eval callee dispatch",
    anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
    input: input,
    expected_value: expected,
    classification: TestClassification { tier: Tier1, layer: Unit }
  }
}

fn add_arrow_eval_subject(tree: InferredTree, input: Node, expected: Node) -> TestClaimEvalSubject<Node> {
  TestClaimEvalSubject {
    claim: add_arrow_eval_claim(input: input, expected: expected),
    context: add_arrow_eval_context(),
    tree: tree,
    input: test_claim_typed_input_node(
      evaluator_input: input,
      evaluator_pin: ^add_arrow_eval_add_call_pin
    )
  }
}

fn add_arrow_eval_run(
  callee: Node,
  left_lex: String,
  right_lex: String,
  expected_lex: String
) -> Outcome<TestClaimRun<Node, RuntimeValue>> {
  match add_arrow_eval_add_call_optional(
    callee: callee,
    left_lex: left_lex,
    right_lex: right_lex
  ) {
    Present { value: call_node } =>
      match add_arrow_eval_int_literal_optional(lexeme: expected_lex) {
        Present { value: expected } =>
          bind_outcome(
            o: add_arrow_eval_inferred_run_tree(
              callee: callee,
              left_lex: left_lex,
              right_lex: right_lex,
              expected_lex: expected_lex
            ),
            f: fn(tree) {
              outcome_accepted(
                value: run_test_claim(
                  subject: add_arrow_eval_subject(tree: tree, input: call_node, expected: expected)
                )
              )
            }
          )
        Absent =>
          outcome_rejected(
            d: add_arrow_eval_runtime_diagnostic(
              n: add_arrow_eval_atom(s: ^add_arrow_eval_literal_miss)
            )
          )
      }
    Absent =>
      outcome_rejected(
        d: add_arrow_eval_runtime_diagnostic(
          n: add_arrow_eval_atom(s: ^add_arrow_eval_literal_miss)
        )
      )
  }
}

fn add_arrow_swapped_operand_body() -> Node {
  Node {
    kind: ComputationNode { behavior: Transform },
    occurrence_id: OccurrenceSynthetic,
    children: [
      Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_token_plus), declaration: NotADeclaration },
      Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_param_y), declaration: NotADeclaration },
      Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_param_x), declaration: NotADeclaration }
    ]
  }
}

// The red controls below share the declared (x: Int, y: Int) signature, so each is red for its own
// defect -- the body or the extra parameter -- and not for a signature shape no producer emits.
fn add_arrow_xy_params() -> List<Edge> {
  [
    binder_edge(name: ^dag_binding_param_x, type_node: add_arrow_eval_atom(s: ^dag_binding_type_int)),
    binder_edge(name: ^dag_binding_param_y, type_node: add_arrow_eval_atom(s: ^dag_binding_type_int))
  ]
}

fn add_arrow_swapped_add_arrow() -> Node {
  let signature = declared_signature(params: add_arrow_xy_params(), source: add_arrow_eval_atom(s: ^dag_binding_type_int))
  Node {
    kind: TypeNode { connective: Arrow },
    occurrence_id: OccurrenceSynthetic,
    children: [
      signature.domain,
      Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_type_int), declaration: NotADeclaration },
      signature.order,
      Edge { label: core_edge_label(marker: ArrowBodyEdge), target: add_arrow_swapped_operand_body(), declaration: NotADeclaration }
    ]
  }
}

fn add_arrow_excess_signature_arrow() -> Node {
  let signature = declared_signature(params: concat(add_arrow_xy_params(), [binder_edge(name: pattern_wildcard_name(), type_node: add_arrow_eval_atom(s: ^dag_binding_type_int))]), source: add_arrow_eval_atom(s: ^dag_binding_type_int))
  Node {
    kind: TypeNode { connective: Arrow },
    occurrence_id: OccurrenceSynthetic,
    children: [
      signature.domain,
      Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_type_int), declaration: NotADeclaration },
      signature.order,
      Edge { label: core_edge_label(marker: ArrowBodyEdge), target: add_arrow_eval_canonical_body(), declaration: NotADeclaration }
    ]
  }
}

fn add_arrow_eval_canonical_body() -> Node {
  Node {
    kind: ComputationNode { behavior: Transform },
    occurrence_id: OccurrenceSynthetic,
    children: [
      Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_token_plus), declaration: NotADeclaration },
      Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_param_x), declaration: NotADeclaration },
      Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_param_y), declaration: NotADeclaration }
    ]
  }
}

fn add_arrow_excess_body_arrow() -> Node {
  let signature = declared_signature(params: add_arrow_xy_params(), source: add_arrow_eval_atom(s: ^dag_binding_type_int))
  Node {
    kind: TypeNode { connective: Arrow },
    occurrence_id: OccurrenceSynthetic,
    children: [
      signature.domain,
      Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_type_int), declaration: NotADeclaration },
      signature.order,
      Edge { label: core_edge_label(marker: ArrowBodyEdge), target: add_arrow_excess_body(), declaration: NotADeclaration }
    ]
  }
}

fn add_arrow_excess_body() -> Node {
  Node {
    kind: ComputationNode { behavior: Transform },
    occurrence_id: OccurrenceSynthetic,
    children: [
      Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_token_plus), declaration: NotADeclaration },
      Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_param_x), declaration: NotADeclaration },
      Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_param_y), declaration: NotADeclaration },
      Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_param_x), declaration: NotADeclaration }
    ]
  }
}

fn add_arrow_excess_actual_call_optional(callee: Node) -> Optional<Node> {
  match add_arrow_eval_int_literal_optional(lexeme: "2") {
    Present { value: two_lit } =>
      match add_arrow_eval_int_literal_optional(lexeme: "3") {
        Present { value: three_lit } =>
          Present {
            value: Node {
              kind: ComputationNode { behavior: Transform },
              occurrence_id: OccurrenceSynthetic,
              children: [
                Edge { label: Positional, target: callee, declaration: NotADeclaration },
                Edge { label: Positional, target: two_lit, declaration: NotADeclaration },
                Edge { label: Positional, target: three_lit, declaration: NotADeclaration },
                Edge { label: Positional, target: two_lit, declaration: NotADeclaration }
              ]
            }
          }
        Absent => Absent
      }
    Absent => Absent
  }
}

fn add_arrow_eval_run_passes(run: Outcome<TestClaimRun<Node, RuntimeValue>>) -> Bool {
  match run {
    Accepted { value: r, diagnostics: _ } =>
      match test_claim_run_verdict(run: r) {
        Pass => true
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn add_arrow_eval_source_pipeline_admits_add_holds() -> Bool {
  match add_arrow_source_ingested_add_infers() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn add_arrow_eval_canonical_tree_infers_holds() -> Bool {
  match table_fixture_add_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      match add_arrow_eval_inferred_run_tree(
        callee: arrow,
        left_lex: "2",
        right_lex: "3",
        expected_lex: "5"
      ) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn add_arrow_eval_runtime_value_is_n(value: RuntimeValue, n: Int) -> Bool {
  add_arrow_eval_runtime_int_equals(value: value, n: n)
}

test fn add_arrow_eval_direct_runtime_holds() -> Bool {
  match table_fixture_add_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      match add_arrow_eval_add_call_optional(callee: arrow, left_lex: "2", right_lex: "3") {
        Present { value: call_node } =>
          match add_arrow_eval_inferred_run_tree(
            callee: arrow,
            left_lex: "2",
            right_lex: "3",
            expected_lex: "5"
          ) {
            Accepted { value: tree, diagnostics: _ } =>
              match eval(
                tree: tree,
                interpretation: v2_evaluator_interpretation(),
                inputs: inputs_root_only(root: call_node)
              ) {
                Accepted { value: actual, diagnostics: None } =>
                  add_arrow_eval_runtime_value_is_n(value: actual, n: 5)
                _ => false
              }
            Rejected { diagnostics: _ } => false
          }
        Absent => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn add_arrow_eval_source_driven_add_executes_holds() -> Bool {
  match table_fixture_add_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      add_arrow_eval_run_passes(
        run: add_arrow_eval_run(
          callee: arrow,
          left_lex: "2",
          right_lex: "3",
          expected_lex: "5"
        )
      )
    Rejected { diagnostics: _ } => false
  }
}


test fn add_arrow_eval_generality_executes_holds() -> Bool {
  match table_fixture_add_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      add_arrow_eval_run_passes(
        run: add_arrow_eval_run(
          callee: arrow,
          left_lex: "7",
          right_lex: "8",
          expected_lex: "15"
        )
      )
    Rejected { diagnostics: _ } => false
  }
}

