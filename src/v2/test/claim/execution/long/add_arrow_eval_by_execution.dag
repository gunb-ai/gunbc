fn add_arrow_eval_step_loop_continue(node: Node, _env: EvaluationEnvironment) -> Outcome<ControlTransfer> {
  outcome_accepted(value: Completed { value: add_arrow_eval_int_runtime_value(n: 5) })
}

fn add_arrow_eval_lazy_arm_loop_interpretation() -> InterpretationAlgebra {
  InterpretationAlgebra {
    value: ValueInterpreter { allocate_literal: v2_eval_allocate_literal, identity: ^v2_eval_allocate_literal },
    transform: TransformInterpreter { call_primitive: add_arrow_eval_call_primitive, identity: ^add_arrow_eval_call_primitive },
    branch: BranchInterpreter { choose_branch: add_arrow_eval_choose_first_arm, identity: ^add_arrow_eval_choose_first_arm },
    loop: LoopInterpreter { step_loop: add_arrow_eval_step_loop_continue, identity: ^add_arrow_eval_step_loop_continue },
    bind: BindInterpreter { bind_value: add_arrow_eval_bind_value, identity: ^add_arrow_eval_bind_value },
    match: MatchInterpreter { choose_arm: runtime_reject_match_arm, identity: ^runtime_reject_match_arm }
  }
}

fn add_arrow_eval_lazy_arm_loop_node() -> Node {
  Node {
    kind: ComputationNode { behavior: Loop },
    occurrence_id: OccurrenceSynthetic,
    children: [
      Edge { label: Positional, target: add_arrow_eval_atom(s: ^add_arrow_eval_unknown_arm_literal), declaration: NotADeclaration },
      Edge {
        label: core_edge_label(marker: LoopBoundEdge),
        target: add_arrow_eval_atom(s: ^add_arrow_eval_loop_measure_literal),
        declaration: NotADeclaration
      }
    ]
  }
}

fn add_arrow_eval_loop_admitted_tree(root: Node) -> InferredTree {
  InferredTree {
    root: root,
    facts: PartialFunction {
      lookup: fn(key) {
        match key.kind {
          ComputationNode { behavior: Loop } =>
            Present {
              value: claim_inferred_facts_from_nodes(
                resolved: key,
                algebra: add_arrow_eval_i64_node(),
                descent: Holds {
                  value: v2.std.cardinality.TerminationProof {
                    non_increasing: [],
                    strict: v2.std.cardinality.RankingComponent {
                      measured: ^add_arrow_eval_loop_measure_literal
                    }
                  }
                }
              )
            }
          _ =>
            add_arrow_eval_facts_lookup(key: key)
        }
      }
    }
  }
}

test fn add_arrow_eval_lazy_arm_loop_suppression_holds() -> Bool {
  let loop_node = add_arrow_eval_lazy_arm_loop_node()
  let tree = add_arrow_eval_loop_admitted_tree(root: loop_node)
  match eval(
    tree: tree,
    interpretation: add_arrow_eval_lazy_arm_loop_interpretation(),
    inputs: inputs_root_only(root: loop_node)
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } =>
      symbol_lexeme(sym: diagnostics_fatal_reason(d: d)) == "v2_eval_loop_requires_termination_proof"
  }
}

// ===== DISCRIMINATOR (source only; ENROLLED-NOT-EXECUTED; no run) =====
// Cells return Bool, so a bare FAIL names no cause. These sibling cells PARTITION each positive cell's outcome.
// Pre-registered reading: for EACH route group below EXACTLY ONE member cell PASSes (one member per
// enumerated reason, Accepted, and one REMAINDER). Zero or two PASSing members in a group = the partition or
// the receipt is broken, not a verdict. The PA refinements (value == 5, diagnostics None) are the positive cells
// themselves and sit OUTSIDE the exactly-one count; Accepted in a group says only that eval accepted.
// KNOWN LIMITS of the remainder (reasons NOT enumerated because their bodies were not read):
//   eval_bind_positional_domain, eval_formal_binding_key, eval_list_introduction_value (eval.dag), and the
//   infer-owned descent reason of inferred_facts_descent (a Violates diagnostic). The run_test_claim groups
//   see the verdict arm only (V1..V5) and not the inner actual's reason; Rejected-before-verdict shows the reason.
// JOINT READING: a positive cell PASS with its group's Accepted PASS = accepted by execution. A positive FAIL is
// attributed ONLY by the group member that PASSes (a remainder PASS = unattributed, an open cause). A red cell
// PASS counts as discriminating ONLY with its exact-reason sibling PASS (a red is vacuously true under any
// refusal); a red whose sibling FAILs is read as UNPROVEN, not green. Reds' non-Pass hypotheses are PRE-REGISTERED
// and may FAIL.

fn aa_reason_of_eval(o: Outcome<RuntimeValue>) -> String {
  match o {
    Accepted { value: _, diagnostics: _ } => "accepted"
    Rejected { diagnostics: d } => symbol_lexeme(sym: diagnostics_fatal_reason(d: d))
  }
}

fn aa_direct_reason_for(call_optional: Optional<Node>, callee: Node) -> String {
  match call_optional {
    Present { value: call_node } =>
      match add_arrow_eval_inferred_run_tree(callee: callee, left_lex: "2", right_lex: "3", expected_lex: "5") {
        Accepted { value: tree, diagnostics: _ } =>
          aa_reason_of_eval(o: eval(tree: tree, interpretation: v2_evaluator_interpretation(), inputs: inputs_root_only(root: call_node)))
        Rejected { diagnostics: d } => symbol_lexeme(sym: diagnostics_fatal_reason(d: d))
      }
    Absent => "fixture_absent"
  }
}

fn aa_direct_reason() -> String {
  match table_fixture_add_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      aa_direct_reason_for(call_optional: add_arrow_eval_add_call_optional(callee: arrow, left_lex: "2", right_lex: "3"), callee: arrow)
    Rejected { diagnostics: _ } => "fixture_absent"
  }
}

fn aa_verdict_label<S, A>(v: Verdict<S, A>) -> String {
  match v {
    Pass => "V1_pass"
    SemanticMismatch { actual: _, falsification: _ } => "V2_semantic_mismatch"
    BuildFailed { actual: _, diagnostic: _ } => "V3_build_failed"
    RunFailed { actual: _, diagnostic: _ } => "V4_run_failed"
    Deferred { actual: _, diagnostic: _ } => "V5_deferred"
  }
}

fn aa_run_reason_of(run: Outcome<TestClaimRun<Node, RuntimeValue>>) -> String {
  match run {
    Accepted { value: r, diagnostics: _ } => aa_verdict_label(v: test_claim_run_verdict(run: r))
    Rejected { diagnostics: d } => symbol_lexeme(sym: diagnostics_fatal_reason(d: d))
  }
}

fn aa_run_reason(left: String, right: String, expected: String) -> String {
  match table_fixture_add_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      aa_run_reason_of(run: add_arrow_eval_run(callee: arrow, left_lex: left, right_lex: right, expected_lex: expected))
    Rejected { diagnostics: _ } => "fixture_absent"
  }
}

fn aa_source_reason() -> String { aa_run_reason(left: "2", right: "3", expected: "5") }
fn aa_generality_reason() -> String { aa_run_reason(left: "7", right: "8", expected: "15") }
fn aa_wrong_value_reason() -> String { aa_run_reason(left: "7", right: "8", expected: "16") }

fn aa_branch_reason() -> String {
  let branch = add_arrow_eval_lazy_arm_branch_node()
  aa_reason_of_eval(
    o: eval(
      tree: add_arrow_eval_admitted_tree(root: branch),
      interpretation: add_arrow_eval_lazy_arm_interpretation(),
      inputs: inputs_root_only(root: branch)
    )
  )
}

fn aa_swapped_reason() -> String {
  aa_run_reason_of(run: add_arrow_eval_run(callee: add_arrow_swapped_add_arrow(), left_lex: "2", right_lex: "3", expected_lex: "6"))
}
