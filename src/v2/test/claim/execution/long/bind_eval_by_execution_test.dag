module v2.test.long.bind_eval_by_execution


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn bind_atom(s: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } },
    occurrence_id: SyntheticOccurrence,
    children: []
  }
}

fn bind_byte() -> std.bit.Byte {
  std.bit.Byte { bits: [true] }
}

fn bind_i64_node() -> v2.std.node.Node {
  bind_atom(s: ^bind_i64)
}

fn bind_int_value(bytes: std.types.List<std.bit.Byte>) -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimePrimitive {
    value: v2.std.runtime.RuntimePrimitiveValue {
      primitive_type: bind_i64_node(),
      bytes: bytes
    }
  }
}

fn bind_one_value() -> v2.std.runtime.RuntimeValue {
  bind_int_value(bytes: [bind_byte()])
}

fn bind_two_value() -> v2.std.runtime.RuntimeValue {
  bind_int_value(bytes: [bind_byte(), bind_byte()])
}

fn bind_literal_one_node() -> v2.std.node.Node {
  v2.extdeps.languages.dag.dag_int_literal_fixture_one()
}

fn bind_literal_two_node() -> v2.std.node.Node {
  v2.extdeps.languages.dag.dag_int_literal_fixture_two()
}

fn bind_runtime_diagnostic(n: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^bind_runtime_rejected,
    at: v2.std.diagnostic.node_locus(node: n),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn bind_runtime_int_is_one(value: v2.std.runtime.RuntimeValue) -> Bool {
  match value {
    RuntimePrimitive { value: p } =>
      (p.primitive_type == bind_i64_node()) && (count(p.bytes) == 1)
    _ => false
  }
}

fn bind_allocate_literal(node: v2.std.node.Node, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  if v2.extdeps.languages.dag.dag_node_is_int_literal_atom(node: node) {
    match v2.extdeps.languages.dag.dag_int_literal_magnitude_int_from_node(node: node) {
      Accepted { value: mag, diagnostics: _ } =>
        if mag == 1 {
          v2.std.diagnostic.outcome_accepted(value: bind_one_value())
        } else if mag == 2 {
          v2.std.diagnostic.outcome_accepted(value: bind_two_value())
        } else {
          v2.std.diagnostic.outcome_rejected(d: bind_runtime_diagnostic(n: node))
        }
      Rejected { diagnostics: d } => v2.std.diagnostic.Rejected { diagnostics: d }
    }
  } else {
    v2.std.diagnostic.outcome_rejected(d: bind_runtime_diagnostic(n: node))
  }
}

fn bind_call_primitive(
  _node: v2.std.node.Node,
  _args: std.types.List<v2.std.runtime.RuntimeValue>,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.outcome_rejected(d: bind_runtime_diagnostic(n: _node))
}

fn bind_choose_branch(
  node: v2.std.node.Node,
  _condition: v2.std.runtime.RuntimeValue,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.outcome_rejected(d: bind_runtime_diagnostic(n: node))
}

fn bind_step_loop(node: v2.std.node.Node, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.ControlTransfer> {
  v2.std.diagnostic.outcome_rejected(d: bind_runtime_diagnostic(n: node))
}

fn bind_bind_value(
  key: v2.std.runtime.EnvironmentBindingKey,
  value: v2.std.runtime.RuntimeValue,
  env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.EvaluationEnvironment> {
  v2.std.diagnostic.Accepted {
    value: v2.std.runtime.EvaluationEnvironment {
      bindings: v2.std.collection.map_insert(m: env.bindings, key: key, value: value)
    },
    diagnostics: v2.std.diagnostic.None
  }
}

fn bind_interpretation() -> v2.std.runtime.InterpretationAlgebra {
  v2.std.runtime.InterpretationAlgebra {
    value: v2.std.runtime.ValueInterpreter {
      allocate_literal: bind_allocate_literal,
      identity: ^bind_allocate_literal
    },
    transform: v2.std.runtime.TransformInterpreter {
      call_primitive: bind_call_primitive,
      identity: ^bind_call_primitive
    },
    branch: v2.std.runtime.BranchInterpreter {
      choose_branch: bind_choose_branch,
      identity: ^bind_choose_branch
    },
    loop: v2.std.runtime.LoopInterpreter {
      step_loop: bind_step_loop,
      identity: ^bind_step_loop
    },
    bind: v2.std.runtime.BindInterpreter {
      bind_value: bind_bind_value,
      identity: ^bind_bind_value
    },
    match: v2.std.runtime.MatchInterpreter {
      choose_arm: v2.std.runtime.runtime_reject_match_arm,
      identity: ^runtime_reject_match_arm    }
  }
}

fn bind_interpretation_structure_witness() -> v2.std.runtime.InterpretationStructureWitness {
  v2.std.runtime.InterpretationStructureWitness {
    allocate_literal: ^bind_allocate_literal,
    call_primitive: ^bind_call_primitive,
    choose_branch: ^bind_choose_branch,
    step_loop: ^bind_step_loop,
    bind_value: ^bind_bind_value,    choose_arm: ^runtime_reject_match_arm
  }
}

fn bind_context() -> v2.compiler.eval.EvalContext {
  v2.compiler.eval.eval_context_with_semantics(
    runtime_identity: ^bind_runtime_id,
    interpretation: bind_interpretation(),
    structure_witness: bind_interpretation_structure_witness()
  )
}

fn bind_pick_call(callee: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: Transform },
    occurrence_id: SyntheticOccurrence,
    children: [
      v2.std.node.Edge { label: Positional, target: callee }
    ]
  }
}

fn bind_tree_root(call: v2.std.node.Node, expected: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    occurrence_id: SyntheticOccurrence,
    children: [
      v2.std.node.Edge { label: Named { name: ^bind_actual }, target: call },
      v2.std.node.Edge { label: Named { name: ^bind_expected }, target: expected }
    ]
  }
}

fn bind_facts_lookup(key: v2.std.node.Node) -> Optional<v2.compiler.inferred_tree.InferredFacts> {
  v2.std.optional.optional_present(value: v2.test.lens_common.infer_fixture.claim_inferred_facts_from_nodes(
      resolved: key,
      algebra: bind_i64_node(),
      descent: v2.std.cardinality.termination_proof_witness_for_node(n: key)
    ))
}

fn bind_admitted_tree(root: v2.std.node.Node) -> v2.compiler.inferred_tree.InferredTree {
  v2.compiler.inferred_tree.InferredTree {
    root: root,
    facts: std.types.Map {
      lookup: bind_facts_lookup
    }
  }
}

fn bind_inferred_run_tree(callee: v2.std.node.Node, expected: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> {
  let call = bind_pick_call(callee: callee)
  let root = bind_tree_root(call: call, expected: expected)
  v2.std.diagnostic.outcome_accepted(value: bind_admitted_tree(root: root))
}

fn bind_claim(input: v2.std.node.Node, expected: v2.std.node.Node) -> v2.std.verification.TestClaim {
  v2.std.verification.CompilesClaim {
    label: "manual/bind: source-bridged let-in Bind.body executes through eval",
    anchor: v2.std.verification.manual_claim_anchor(anchor: ManualAnchorAbsent),
    input: input,
    expected_value: expected,
    classification: v2.std.verification.TestClassification { tier: Tier1, layer: v2.std.verification.Unit }
  }
}

fn bind_subject(
  tree: v2.compiler.inferred_tree.InferredTree,
  input: v2.std.node.Node,
  expected: v2.std.node.Node
) -> v2.compiler.eval.TestClaimEvalSubject<v2.std.node.Node> {
  v2.compiler.eval.TestClaimEvalSubject {
    claim: bind_claim(input: input, expected: expected),
    context: bind_context(),
    tree: tree,
    input: v2.compiler.eval.test_claim_typed_input_node(
      evaluator_input: input,
      evaluator_pin: ^bind_pick_call_pin
    )
  }
}

fn bind_run(
  callee: v2.std.node.Node,
  expected: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>> {
  let input = bind_pick_call(callee: callee)
  v2.std.diagnostic.bind_outcome(
    o: bind_inferred_run_tree(callee: callee, expected: expected),
    f: fn(tree) {
      v2.std.diagnostic.outcome_accepted(
        value: v2.compiler.eval.run_test_claim(
          subject: bind_subject(tree: tree, input: input, expected: expected)
        )
      )
    }
  )
}

fn bind_run_passes(run: v2.std.diagnostic.Outcome<v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>>) -> Bool {
  match run {
    Accepted { value: r, diagnostics: _ } =>
      match v2.compiler.eval.test_claim_run_verdict(run: r) {
        Pass => true
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn bind_source_pipeline_admits_holds() -> Bool {
  match v2.test.complexity_gate.table_fixture_bind_subject_producer.table_fixture_bind_arrow_with_body() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn bind_source_driven_executes_holds() -> Bool {
  match v2.test.complexity_gate.table_fixture_bind_subject_producer.table_fixture_bind_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      bind_run_passes(
        run: bind_run(
          callee: arrow,
          expected: bind_literal_one_node()
        )
      )
    Rejected { diagnostics: _ } => false
  }
}

test fn bind_direct_runtime_holds() -> Bool {
  match v2.test.complexity_gate.table_fixture_bind_subject_producer.table_fixture_bind_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } => {
      let input = bind_pick_call(callee: arrow)
      match bind_inferred_run_tree(
        callee: arrow,
        expected: bind_literal_one_node()
      ) {
        Accepted { value: tree, diagnostics: _ } =>
          match v2.compiler.eval.eval(
            tree: tree,
            interpretation: bind_interpretation(),
            inputs: v2.compiler.eval.inputs_root_only(root: input)
          ) {
            Accepted { value: actual, diagnostics: None } =>
              bind_runtime_int_is_one(value: actual)
            _ => false
          }
        Rejected { diagnostics: _ } => false
      }
    }
    Rejected { diagnostics: _ } => false
  }
}

test fn bind_value_perturbation_red_holds() -> Bool {
  match v2.test.complexity_gate.table_fixture_bind_subject_producer.table_fixture_bind_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      bind_run_passes(
        run: bind_run(
          callee: arrow,
          expected: bind_literal_two_node()
        )
      ) == false
    Rejected { diagnostics: _ } => false
  }
}

test fn bind_fixture_producer_holds() -> Bool {
  match v2.test.complexity_gate.table_fixture_bind_subject_producer.table_fixture_bind_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      bind_run_passes(
        run: bind_run(
          callee: arrow,
          expected: bind_literal_one_node()
        )
      )
    Rejected { diagnostics: _ } => false
  }
}

test fn bind_fixture_wrong_value_red_holds() -> Bool {
  match v2.test.complexity_gate.table_fixture_bind_subject_producer.table_fixture_bind_wrong_value_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      bind_run_passes(
        run: bind_run(
          callee: arrow,
          expected: bind_literal_one_node()
        )
      ) == false
    Rejected { diagnostics: _ } => false
  }
}

test fn bind_census_ingested_executes_holds() -> Bool {
  match v2.compiler.ingested_fixture_arrows.ingested_bind_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      bind_run_passes(
        run: bind_run(
          callee: arrow,
          expected: bind_literal_one_node()
        )
      )
    Rejected { diagnostics: _ } => false
  }
}

test fn bind_census_ingested_wrong_value_red_holds() -> Bool {
  match v2.compiler.ingested_fixture_arrows.ingested_bind_arrow_with_body_wrong_value() {
    Accepted { value: arrow, diagnostics: _ } =>
      bind_run_passes(
        run: bind_run(
          callee: arrow,
          expected: bind_literal_one_node()
        )
      ) == false
    Rejected { diagnostics: _ } => false
  }
}

