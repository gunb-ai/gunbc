module v2.test.long.loop_eval_by_execution


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn loop_atom(s: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } },
    occurrence_id: SyntheticOccurrence,
    children: []
  }
}

fn loop_byte() -> std.bit.Byte {
  std.bit.Byte { bits: [true] }
}

fn loop_i64_node() -> v2.std.node.Node {
  loop_atom(s: ^loop_i64)
}

fn loop_int_value(bytes: List<std.bit.Byte>) -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimePrimitive {
    value: v2.std.runtime.RuntimePrimitiveValue {
      primitive_type: loop_i64_node(),
      bytes: bytes
    }
  }
}

fn loop_one_value() -> v2.std.runtime.RuntimeValue {
  loop_int_value(bytes: [loop_byte()])
}

fn loop_two_value() -> v2.std.runtime.RuntimeValue {
  loop_int_value(bytes: [loop_byte(), loop_byte()])
}

fn loop_literal_one_node() -> v2.std.node.Node {
  v2.extdeps.languages.dag.dag_int_literal_fixture_one()
}

fn loop_literal_two_node() -> v2.std.node.Node {
  v2.extdeps.languages.dag.dag_int_literal_fixture_two()
}

fn loop_runtime_diagnostic(n: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^loop_runtime_rejected,
    at: v2.std.diagnostic.node_locus(node: n),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn loop_runtime_int_is_one(value: v2.std.runtime.RuntimeValue) -> v2.std.logic.Bool {
  match value {
    RuntimePrimitive { value: p } =>
      (p.primitive_type == loop_i64_node()) && (count(p.bytes) == 1)
    _ => false
  }
}

fn loop_allocate_literal(node: v2.std.node.Node, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  if v2.extdeps.languages.dag.dag_node_is_int_literal_atom(node: node) {
    match v2.extdeps.languages.dag.dag_int_literal_magnitude_int_from_node(node: node) {
      Accepted { value: mag, diagnostics: _ } =>
        if mag == 1 {
          v2.std.diagnostic.outcome_accepted(value: loop_one_value())
        } else if mag == 2 {
          v2.std.diagnostic.outcome_accepted(value: loop_two_value())
        } else {
          v2.std.diagnostic.outcome_rejected(d: loop_runtime_diagnostic(n: node))
        }
      Rejected { diagnostics: d } => v2.std.diagnostic.Rejected { diagnostics: d }
    }
  } else {
    v2.std.diagnostic.outcome_rejected(d: loop_runtime_diagnostic(n: node))
  }
}

fn loop_call_primitive(
  _node: v2.std.node.Node,
  _args: List<v2.std.runtime.RuntimeValue>,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.outcome_rejected(d: loop_runtime_diagnostic(n: _node))
}

fn loop_choose_branch(
  node: v2.std.node.Node,
  _condition: v2.std.runtime.RuntimeValue,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.outcome_rejected(d: loop_runtime_diagnostic(n: node))
}

fn loop_step_loop(node: v2.std.node.Node, env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.ControlTransfer> {
  match v2.std.collection.list_at_optional(xs: v2.std.node_query.node_positional_child_targets(node: node), index: 0) {
    Present { value: body } =>
      v2.std.diagnostic.bind_outcome(
        o: loop_allocate_literal(node: body, env: env),
        f: fn(value) {
          v2.std.diagnostic.outcome_accepted(value: v2.std.runtime.Continue { value: value })
        }
      )
    Absent =>
      v2.std.diagnostic.outcome_rejected(d: loop_runtime_diagnostic(n: node))
  }
}

fn loop_bind_value(
  _key: v2.std.runtime.EnvironmentBindingKey,
  _value: v2.std.runtime.RuntimeValue,
  env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.EvaluationEnvironment> {
  v2.std.diagnostic.Accepted { value: env, diagnostics: v2.std.diagnostic.None }
}

fn loop_interpretation() -> v2.std.runtime.InterpretationAlgebra {
  v2.std.runtime.InterpretationAlgebra {
    value: v2.std.runtime.ValueInterpreter {
      allocate_literal: loop_allocate_literal,
      identity: ^loop_allocate_literal
    },
    transform: v2.std.runtime.TransformInterpreter {
      call_primitive: loop_call_primitive,
      identity: ^loop_call_primitive
    },
    branch: v2.std.runtime.BranchInterpreter {
      choose_branch: loop_choose_branch,
      identity: ^loop_choose_branch
    },
    loop: v2.std.runtime.LoopInterpreter {
      step_loop: loop_step_loop,
      identity: ^loop_step_loop
    },
    bind: v2.std.runtime.BindInterpreter {
      bind_value: loop_bind_value,
      identity: ^loop_bind_value
    },
    match: v2.std.runtime.MatchInterpreter {
      choose_arm: v2.std.runtime.runtime_reject_match_arm,
      identity: ^runtime_reject_match_arm    }
  }
}

fn loop_interpretation_structure_witness() -> v2.std.runtime.InterpretationStructureWitness {
  v2.std.runtime.InterpretationStructureWitness {
    allocate_literal: ^loop_allocate_literal,
    call_primitive: ^loop_call_primitive,
    choose_branch: ^loop_choose_branch,
    step_loop: ^loop_step_loop,
    bind_value: ^loop_bind_value,    choose_arm: ^runtime_reject_match_arm
  }
}

fn loop_context() -> v2.compiler.eval.EvalContext {
  v2.compiler.eval.eval_context_with_semantics(
    runtime_identity: ^loop_runtime_id,
    interpretation: loop_interpretation(),
    structure_witness: loop_interpretation_structure_witness()
  )
}

fn loop_pick_call(callee: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: v2.std.node.Transform },
    occurrence_id: SyntheticOccurrence,
    children: [
      v2.std.node.Edge { label: Positional, target: callee }
    ]
  }
}

fn loop_tree_root(call: v2.std.node.Node, expected: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    occurrence_id: SyntheticOccurrence,
    children: [
      v2.std.node.Edge { label: v2.std.node.Named { name: ^loop_actual }, target: call },
      v2.std.node.Edge { label: v2.std.node.Named { name: ^loop_expected }, target: expected }
    ]
  }
}

fn loop_node_is_loop(node: v2.std.node.Node) -> v2.std.logic.Bool {
  match node.kind {
    ComputationNode { behavior: Loop } => true
    _ => false
  }
}

fn loop_loop_termination_proof() -> v2.std.cardinality.TerminationProof {
  v2.std.cardinality.TerminationProof {
    non_increasing: [],
    strict: v2.std.cardinality.RankingDimension { measured: ^dag_loop_measure_sym }
  }
}

fn loop_bounded_descent() -> v2.std.witness.Witness<v2.std.cardinality.TerminationProof> {
  v2.std.witness.Holds { value: v2.std.cardinality.structural_node_size_termination_proof() }
}

fn loop_facts_lookup(key: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  if loop_node_is_loop(node: key) {
    v2.std.optional.optional_present(value: v2.test.lens_common.infer_fixture.claim_inferred_facts_from_nodes(
        resolved: key,
        algebra: loop_i64_node(),
        descent: v2.std.witness.Holds { value: loop_loop_termination_proof() }
      ))
  } else {
    v2.std.optional.optional_present(value: v2.test.lens_common.infer_fixture.claim_inferred_facts_from_nodes(
        resolved: key,
        algebra: loop_i64_node(),
        descent: loop_bounded_descent()
      ))
  }
}

fn loop_admitted_tree(root: v2.std.node.Node) -> v2.compiler.inferred_tree.InferredTree {
  v2.compiler.inferred_tree.InferredTree {
    root: root,
    facts: std.algebra.PartialFunction {
      lookup: loop_facts_lookup
    }
  }
}

fn loop_inferred_run_tree(callee: v2.std.node.Node, expected: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> {
  let call = loop_pick_call(callee: callee)
  let root = loop_tree_root(call: call, expected: expected)
  v2.std.diagnostic.outcome_accepted(value: loop_admitted_tree(root: root))
}

fn loop_claim(input: v2.std.node.Node, expected: v2.std.node.Node) -> v2.std.verification.TestClaim {
  v2.std.verification.CompilesClaim {
    label: "manual/loop: source-bridged loop body executes through eval",
    anchor: v2.std.verification.manual_claim_anchor(anchor: ManualAnchorAbsent),
    input: input,
    expected_value: expected,
    classification: v2.std.verification.TestClassification { tier: Tier1, layer: v2.std.verification.Unit }
  }
}

fn loop_subject(
  tree: v2.compiler.inferred_tree.InferredTree,
  input: v2.std.node.Node,
  expected: v2.std.node.Node
) -> v2.compiler.eval.TestClaimEvalSubject<v2.std.node.Node> {
  v2.compiler.eval.TestClaimEvalSubject {
    claim: loop_claim(input: input, expected: expected),
    context: loop_context(),
    tree: tree,
    input: v2.compiler.eval.test_claim_typed_input_node(
      evaluator_input: input,
      evaluator_pin: ^loop_pick_call_pin
    )
  }
}

fn loop_run(
  callee: v2.std.node.Node,
  expected: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>> {
  let input = loop_pick_call(callee: callee)
  v2.std.diagnostic.bind_outcome(
    o: loop_inferred_run_tree(callee: callee, expected: expected),
    f: fn(tree) {
      v2.std.diagnostic.outcome_accepted(
        value: v2.compiler.eval.run_test_claim(
          subject: loop_subject(tree: tree, input: input, expected: expected)
        )
      )
    }
  )
}

fn loop_run_passes(run: v2.std.diagnostic.Outcome<v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>>) -> v2.std.logic.Bool {
  match run {
    Accepted { value: r, diagnostics: _ } =>
      match v2.compiler.eval.test_claim_run_verdict(run: r) {
        Pass => true
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn loop_source_pipeline_admits_holds() -> v2.std.logic.Bool {
  match v2.test.complexity_gate.table_fixture_loop_subject_producer.table_fixture_loop_arrow_with_body() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn loop_source_driven_executes_holds() -> v2.std.logic.Bool {
  match v2.test.complexity_gate.table_fixture_loop_subject_producer.table_fixture_loop_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      loop_run_passes(
        run: loop_run(
          callee: arrow,
          expected: loop_literal_one_node()
        )
      )
    Rejected { diagnostics: _ } => false
  }
}

test fn loop_source_driven_wrong_value_red_holds() -> v2.std.logic.Bool {
  match v2.test.complexity_gate.table_fixture_loop_subject_producer.table_fixture_loop_wrong_value_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      loop_run_passes(
        run: loop_run(
          callee: arrow,
          expected: loop_literal_one_node()
        )
      ) == false
    Rejected { diagnostics: _ } => false
  }
}

test fn loop_direct_runtime_holds() -> v2.std.logic.Bool {
  match v2.test.complexity_gate.table_fixture_loop_subject_producer.table_fixture_loop_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } => {
      let input = loop_pick_call(callee: arrow)
      match loop_inferred_run_tree(
        callee: arrow,
        expected: loop_literal_one_node()
      ) {
        Accepted { value: tree, diagnostics: _ } =>
          match v2.compiler.eval.eval(
            tree: tree,
            interpretation: loop_interpretation(),
            inputs: v2.compiler.eval.inputs_root_only(root: input)
          ) {
            Accepted { value: actual, diagnostics: None } =>
              loop_runtime_int_is_one(value: actual)
            _ => false
          }
        Rejected { diagnostics: _ } => false
      }
    }
    Rejected { diagnostics: _ } => false
  }
}

test fn loop_value_perturbation_red_holds() -> v2.std.logic.Bool {
  match v2.test.complexity_gate.table_fixture_loop_subject_producer.table_fixture_loop_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      loop_run_passes(
        run: loop_run(
          callee: arrow,
          expected: loop_literal_two_node()
        )
      ) == false
    Rejected { diagnostics: _ } => false
  }
}

test fn loop_fixture_producer_holds() -> v2.std.logic.Bool {
  match v2.test.complexity_gate.table_fixture_loop_subject_producer.table_fixture_loop_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      loop_run_passes(
        run: loop_run(
          callee: arrow,
          expected: loop_literal_one_node()
        )
      )
    Rejected { diagnostics: _ } => false
  }
}

test fn loop_fixture_wrong_value_red_holds() -> v2.std.logic.Bool {
  match v2.test.complexity_gate.table_fixture_loop_subject_producer.table_fixture_loop_wrong_value_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      loop_run_passes(
        run: loop_run(
          callee: arrow,
          expected: loop_literal_one_node()
        )
      ) == false
    Rejected { diagnostics: _ } => false
  }
}

test fn loop_census_ingested_executes_holds() -> v2.std.logic.Bool {
  match v2.compiler.ingested_fixture_arrows.ingested_loop_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      loop_run_passes(
        run: loop_run(
          callee: arrow,
          expected: loop_literal_one_node()
        )
      )
    Rejected { diagnostics: _ } => false
  }
}

test fn loop_census_ingested_wrong_value_red_holds() -> v2.std.logic.Bool {
  match v2.compiler.ingested_fixture_arrows.ingested_loop_arrow_with_body_wrong_value() {
    Accepted { value: arrow, diagnostics: _ } =>
      loop_run_passes(
        run: loop_run(
          callee: arrow,
          expected: loop_literal_one_node()
        )
      ) == false
    Rejected { diagnostics: _ } => false
  }
}

