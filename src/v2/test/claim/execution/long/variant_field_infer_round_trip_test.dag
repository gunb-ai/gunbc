module v2.test.long.variant_field_infer_round_trip

// THE ONE REAL-PATH INHABITANCE CLAIM over the variant round-trip fixture. The probe module's
// controls (v2.test.claim.variant_field_infer_probe) read a warm producer, so each is a value read;
// this claim runs the pipeline in its own claim frame, which is the billed work -- a
// new-witness-budget bill, reported rather than decided here. It is the row that goes red if the
// warm lane ever short-circuits the route the controls are supposed to witness.
//
// The fixture is the enrolled variant_field_native_binding claims' own shape: a positional
// construction, a variant-scrutinee match over the closed coproduct, and a binder read from the
// variant's payload. On the rostered refusal (gunbc.recurring_failure_mode
// native_infer_accepts_only_bool_and_int_match_scrutinees) this fixture refused
// infer_match_scrutinee_not_bool; the claims it feeds are the evidence the retirement cites.
//
// THE FIXTURE IS THE PROBE'S COMBINED ONE, READ THROUGH vfp_infers over the probe's OWN-FRAME
// reading entry (vfp_reading_direct, a separate computation identity from the probe's warm nullary
// producer): this call's identity is reached by one planned claim, so the derived producer-share
// does not admit it and the fill is billed to THIS claim's own frame -- the billed work this module
// exists to keep on the real path. The route is the LOWERED one (DESIGN 3: the subject as a value);
// the assembled-text route grounds nothing at infer (gunbc.recurring_failure_mode
// authored_text_fixtures_ground_nothing_at_infer).

import v2.test.claim.variant_field_infer_probe { vfp_infers, vfp_reading_direct }

test fn vfp_the_round_trip_fixture_infers_holds() -> Bool {
  vfp_infers(reading: vfp_reading_direct())
}
