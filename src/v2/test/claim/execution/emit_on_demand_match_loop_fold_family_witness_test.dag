data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data emit_on_demand_match_loop_fold_note: String = "Witness-realization fan-out lane 3 (#6879 kernel extension): emit_host match + loop + fold_closure families end-to-end. P3 per family: (a) interpreted==native agreement via emit_host_*_equals_eval — match, loop, and fold all green (fold un-quarantined 2026-07-20 once the eval walk gained structural closure-arg support: an Arrow TypeNode in runtime-argument position materializes RuntimeClosure instead of refusing, so the closure at transform child 3 of fold_fixture_param_call_body evaluates; the native cached-path witnesses remain a separate leg and are not the agreement oracle); (b) native cached-path octet discrimination; (c) native cold-then-warm with compile_skipped; (d) distinct inferred_tree_digest -> new key -> cold rebuild; (e) wrong-oracle RED via discriminating native octets. Shared pure: store Share/Recompute, realize_pack refusal, interpreter roles bounded."

data family_cache_root: String = "/tmp/gunbc_emit_on_demand_match_loop_fold_family"
data family_emitter: String = "v2.compiler.emit"
data family_provider: CacheProvider = provider_row(
  id: "emit-on-demand-match-loop-fold-family",
  scope: [],
  coverage: CoversAllComputations,
  tier: ArtifactTier { keying: ContentKeyed },
  eviction: SpacePacked { budget: "match loop fold native cache" }
)

fn family_open_test_store() -> Optional<ArtifactStore> {
  match store_over_provider(provider: family_provider, budget: byte_size(count: 1000000)) {
    StoreReady { store: s } => optional_present(value: s)
    StoreRefusedEviction { provider_id: _, declared: _ } => optional_absent()
  }
}

fn family_native_key_for(tree: InferredTree) -> ContentHash {
  emit_on_demand_key(
    closure_digest: inferred_tree_digest(tree: tree),
    emitter_identity: family_emitter,
    target_language: "rust",
    grain: NativeArtifact
  )
}

fn family_cache_root_for(test_id: String) -> String {
  concat(family_cache_root, "/", test_id)
}

fn family_cached_run_logical_ok(
  workspace: String,
  target: TargetModel,
  source: Medium<String>,
  fixture_inputs: Inputs,
  expect_compile_skipped: Bool
) -> Bool {
  match run_emit_host_cached(
    workspace_dir: workspace,
    target: target,
    source: source,
    fixture_inputs: fixture_inputs
  ) {
    Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        Accepted { value: HostLogicalRun { stdout: _ }, diagnostics: None } =>
          receipt.compile_skipped == expect_compile_skipped
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn family_cached_run_succeeded(
  workspace: String,
  target: TargetModel,
  source: Medium<String>,
  fixture_inputs: Inputs,
  expect_compile_skipped: Bool,
  expected_octets: List<Byte>
) -> Bool {
  match run_emit_host_cached(
    workspace_dir: workspace,
    target: target,
    source: source,
    fixture_inputs: fixture_inputs
  ) {
    Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        Accepted {
          value: HostLogicalRun { stdout: stdout },
          diagnostics: None
        } =>
          receipt.compile_skipped == expect_compile_skipped
            && stdout.bytes == emit_host_octets_byte_string(octets: expected_octets)
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn family_cached_run_checks_for_tree(
  workspace: String,
  tree: InferredTree,
  target: TargetModel,
  fixture_inputs: Inputs,
  expect_compile_skipped: Bool,
  expected_octets: List<Byte>
) -> Bool {
  match emit(tree: tree, target: target) {
    Accepted { value: source, diagnostics: _ } =>
      family_cached_run_succeeded(
        workspace: workspace,
        target: target,
        source: source,
        fixture_inputs: fixture_inputs,
        expect_compile_skipped: expect_compile_skipped,
        expected_octets: expected_octets
      )
    Rejected { diagnostics: _ } => false
  }
}

fn family_cached_run_logical_checks_for_tree(
  workspace: String,
  tree: InferredTree,
  target: TargetModel,
  fixture_inputs: Inputs,
  expect_compile_skipped: Bool
) -> Bool {
  match emit(tree: tree, target: target) {
    Accepted { value: source, diagnostics: _ } =>
      family_cached_run_logical_ok(
        workspace: workspace,
        target: target,
        source: source,
        fixture_inputs: fixture_inputs,
        expect_compile_skipped: expect_compile_skipped
      )
    Rejected { diagnostics: _ } => false
  }
}

fn family_cached_cold_then_warm_for_tree(
  workspace: String,
  tree: InferredTree,
  target: TargetModel,
  fixture_inputs: Inputs,
  expected_octets: List<Byte>
) -> Bool {
  match emit(tree: tree, target: target) {
    Accepted { value: source, diagnostics: _ } =>
      family_cached_run_succeeded(
        workspace: workspace,
        target: target,
        source: source,
        fixture_inputs: fixture_inputs,
        expect_compile_skipped: false,
        expected_octets: expected_octets
      )
        && family_cached_run_succeeded(
          workspace: workspace,
          target: target,
          source: source,
          fixture_inputs: fixture_inputs,
          expect_compile_skipped: true,
          expected_octets: expected_octets
        )
    Rejected { diagnostics: _ } => false
  }
}

fn family_evict_and_workspace(test_id: String, key: ContentHash) -> String {
  let root = family_cache_root_for(test_id: test_id)
  let _evict = emit_on_demand_evict_native_cache(cache_root: root, key: key)
  native_cache_workspace_root(cache_root: root, key: key)
}

data match_expected_octets: List<Byte> = [0, 1, 0, 0, 0]
data match_alt_expected_octets: List<Byte> = [0, 2, 0, 0, 0]

fn match_fixture_inputs() -> Inputs {
  inputs_for_emit_host(
    claim_input_root: emit_match_eval_subgraph_node,
    expected_eval_root: emit_match_eval_subgraph_node,
    claim_pin: ^emit_match_eval_evaluator_pin
  )
}

fn match_primary_tree() -> Outcome<InferredTree> {
  emit_match_eval_producer_tree()
}

fn match_alt_tree() -> Outcome<InferredTree> {
  emit_match_eval_swapped_producer_tree()
}

test fn emit_on_demand_match_agreement_holds() -> Bool {
  match emit_match_eval_producer_tree() {
    Accepted { value: tree, diagnostics: _ } =>
      emit_match_eval_verdict_is_pass(run: emit_match_eval_run(tree: tree))
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_on_demand_match_native_cached_octets_holds() -> Bool {
  match match_primary_tree() {
    Accepted { value: tree, diagnostics: _ } =>
      let key = family_native_key_for(tree: tree)
      let workspace = family_evict_and_workspace(test_id: "match_agreement", key: key)
      family_cached_run_checks_for_tree(
        workspace: workspace,
        tree: tree,
        target: rust_match_target_model_staging(),
        fixture_inputs: match_fixture_inputs(),
        expect_compile_skipped: false,
        expected_octets: match_expected_octets
      )
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_on_demand_match_wrong_fixture_refuses_holds() -> Bool {
  match match_alt_tree() {
    Accepted { value: tree, diagnostics: _ } =>
      let key = family_native_key_for(tree: tree)
      let workspace = family_evict_and_workspace(test_id: "match_wrong_fixture", key: key)
      family_cached_run_checks_for_tree(
        workspace: workspace,
        tree: tree,
        target: rust_match_target_model_staging(),
        fixture_inputs: match_fixture_inputs(),
        expect_compile_skipped: false,
        expected_octets: match_alt_expected_octets
      )
        && (match_alt_expected_octets == match_expected_octets) == false
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_on_demand_match_native_cold_holds() -> Bool {
  match match_primary_tree() {
    Accepted { value: tree, diagnostics: _ } =>
      let key = family_native_key_for(tree: tree)
      let workspace = family_evict_and_workspace(test_id: "match_native_cold", key: key)
      family_cached_run_checks_for_tree(
        workspace: workspace,
        tree: tree,
        target: rust_match_target_model_staging(),
        fixture_inputs: match_fixture_inputs(),
        expect_compile_skipped: false,
        expected_octets: match_expected_octets
      )
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_on_demand_match_native_cold_then_warm_holds() -> Bool {
  match match_primary_tree() {
    Accepted { value: tree, diagnostics: _ } =>
      let key = family_native_key_for(tree: tree)
      let workspace = family_evict_and_workspace(test_id: "match_native_cold_then_warm", key: key)
      family_cached_cold_then_warm_for_tree(
        workspace: workspace,
        tree: tree,
        target: rust_match_target_model_staging(),
        fixture_inputs: match_fixture_inputs(),
        expected_octets: match_expected_octets
      )
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_on_demand_match_content_change_cold_rebuild_holds() -> Bool {
  match match_primary_tree() {
    Accepted { value: tree_primary, diagnostics: _ } =>
      match match_alt_tree() {
        Accepted { value: tree_alt, diagnostics: _ } =>
          let key_primary = family_native_key_for(tree: tree_primary)
          let key_alt = family_native_key_for(tree: tree_alt)
          if key_primary == key_alt {
            false
          } else {
            let shared_parent = family_cache_root_for(test_id: "match_content_change")
            let workspace_primary = native_cache_workspace_root(
              cache_root: shared_parent,
              key: key_primary
            )
            let _evict_primary = emit_on_demand_evict_native_cache(
              cache_root: shared_parent,
              key: key_primary
            )
            let _evict_alt = emit_on_demand_evict_native_cache(
              cache_root: shared_parent,
              key: key_alt
            )
            let warmed = family_cached_cold_then_warm_for_tree(
              workspace: workspace_primary,
              tree: tree_primary,
              target: rust_match_target_model_staging(),
              fixture_inputs: match_fixture_inputs(),
              expected_octets: match_expected_octets
            )
            let workspace_alt = native_cache_workspace_root(
              cache_root: shared_parent,
              key: key_alt
            )
            warmed
              && family_cached_run_logical_checks_for_tree(
                workspace: workspace_alt,
                tree: tree_alt,
                target: rust_match_target_model_staging(),
                fixture_inputs: match_fixture_inputs(),
                expect_compile_skipped: false
              )
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

