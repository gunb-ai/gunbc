                expect_compile_skipped: false
              )
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

data fold_expected_octets: List<Byte> = [0, 7, 0, 0, 0]
data fold_alt_expected_octets: List<Byte> = [0, 255, 255, 255, 255]

fn fold_fixture_inputs() -> Inputs {
  inputs_for_emit_host(
    claim_input_root: emit_fold_eval_subgraph_node,
    expected_eval_root: emit_fold_eval_subgraph_node,
    claim_pin: ^emit_fold_eval_evaluator_pin
  )
}

fn fold_primary_tree() -> InferredTree {
  emit_fold_eval_tree_for(root: fold_fixture_param_canonical_arrow)
}

fn fold_alt_tree() -> InferredTree {
  emit_fold_eval_tree_for(root: fold_fixture_param_wrong_arrow)
}

data emit_on_demand_fold_agreement_note: String = "The (a) leg for fold, restored on un-quarantine (2026-07-20) once eval gained structural closure-arg support. Like the match and loop agreement witnesses it routes through emit_fold_eval_run -> run_test_claim_emit_vs_eval, so the verdict is a comparison of BOTH legs: emit()-to-native host run versus eval() of the same subgraph. It is deliberately NOT a native-cached-path assertion — the cached-octets witnesses below cover that, and an agreement fn that read the native path as its own oracle would be checking the native leg against itself."

test fn emit_on_demand_fold_closure_agreement_holds() -> Bool {
  emit_fold_eval_verdict_is_pass(
    run: emit_fold_eval_run(root: fold_fixture_param_canonical_arrow)
  )
}

test fn emit_on_demand_fold_closure_native_cached_octets_holds() -> Bool {
  let tree = fold_primary_tree()
  let key = family_native_key_for(tree: tree)
  let workspace = family_evict_and_workspace(test_id: "fold_native_cached_octets", key: key)
  family_cached_run_checks_for_tree(
    workspace: workspace,
    tree: tree,
    target: rust_fold_call_target_model_staging(),
    fixture_inputs: fold_fixture_inputs(),
    expect_compile_skipped: false,
    expected_octets: fold_expected_octets
  )
}

test fn emit_on_demand_fold_closure_wrong_fixture_refuses_holds() -> Bool {
  let tree = fold_alt_tree()
  let key = family_native_key_for(tree: tree)
  let workspace = family_evict_and_workspace(test_id: "fold_wrong_fixture", key: key)
  family_cached_run_checks_for_tree(
    workspace: workspace,
    tree: tree,
    target: rust_fold_call_target_model_staging(),
    fixture_inputs: fold_fixture_inputs(),
    expect_compile_skipped: false,
    expected_octets: fold_alt_expected_octets
  )
    && (fold_alt_expected_octets == fold_expected_octets) == false
}

test fn emit_on_demand_fold_closure_native_cold_holds() -> Bool {
  let tree = fold_primary_tree()
  let key = family_native_key_for(tree: tree)
  let workspace = family_evict_and_workspace(test_id: "fold_native_cold", key: key)
  family_cached_run_checks_for_tree(
    workspace: workspace,
    tree: tree,
    target: rust_fold_call_target_model_staging(),
    fixture_inputs: fold_fixture_inputs(),
    expect_compile_skipped: false,
    expected_octets: fold_expected_octets
  )
}

test fn emit_on_demand_fold_closure_native_cold_then_warm_holds() -> Bool {
  let tree = fold_primary_tree()
  let key = family_native_key_for(tree: tree)
  let workspace = family_evict_and_workspace(test_id: "fold_native_cold_then_warm", key: key)
  family_cached_cold_then_warm_for_tree(
    workspace: workspace,
    tree: tree,
    target: rust_fold_call_target_model_staging(),
    fixture_inputs: fold_fixture_inputs(),
    expected_octets: fold_expected_octets
  )
}

test fn emit_on_demand_fold_closure_content_change_cold_rebuild_holds() -> Bool {
  let tree_primary = fold_primary_tree()
  let tree_alt = fold_alt_tree()
  let key_primary = family_native_key_for(tree: tree_primary)
  let key_alt = family_native_key_for(tree: tree_alt)
  if key_primary == key_alt {
    false
  } else {
    let shared_parent = family_cache_root_for(test_id: "fold_content_change")
    let workspace_primary = native_cache_workspace_root(
      cache_root: shared_parent,
      key: key_primary
    )
    let _evict_primary = emit_on_demand_evict_native_cache(
      cache_root: shared_parent,
      key: key_primary
    )
    let _evict_alt = emit_on_demand_evict_native_cache(
      cache_root: shared_parent,
      key: key_alt
    )
    let warmed = family_cached_cold_then_warm_for_tree(
      workspace: workspace_primary,
      tree: tree_primary,
      target: rust_fold_call_target_model_staging(),
      fixture_inputs: fold_fixture_inputs(),
      expected_octets: fold_expected_octets
    )
    let workspace_alt = native_cache_workspace_root(
      cache_root: shared_parent,
      key: key_alt
    )
    warmed
      && family_cached_run_logical_checks_for_tree(
        workspace: workspace_alt,
        tree: tree_alt,
        target: rust_fold_call_target_model_staging(),
        fixture_inputs: fold_fixture_inputs(),
        expect_compile_skipped: false
      )
  }
}

test fn emit_on_demand_match_loop_fold_grain_keys_differ_holds() -> Bool {
  match match_primary_tree() {
    Accepted { value: tree, diagnostics: _ } =>
      let digest = inferred_tree_digest(tree: tree)
      let source = emit_on_demand_key(
        closure_digest: digest,
        emitter_identity: family_emitter,
        target_language: "rust",
        grain: SourceArtifact
      )
      let native = emit_on_demand_key(
        closure_digest: digest,
        emitter_identity: family_emitter,
        target_language: "rust",
        grain: NativeArtifact
      )
      (source == native) == false
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_on_demand_match_loop_fold_materialize_share_on_hit_holds() -> Bool {
  match match_primary_tree() {
    Accepted { value: tree, diagnostics: _ } =>
      match family_open_test_store() {
        Present { value: store } =>
          let key = family_native_key_for(tree: tree)
          let put = store_put(store: store, key: key, artifact_bytes: byte_size(count: 64))
          let lookup = emit_on_demand_lookup(store: put.store, key: key)
          match lookup {
            EmitOnDemandHit { receipt: r } =>
              r.compile_skipped
                && materialization_for_lookup(lookup: lookup) == Share
            EmitOnDemandMiss => false
          }
        Absent => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_on_demand_match_loop_fold_materialize_recompute_on_miss_holds() -> Bool {
  match match_primary_tree() {
    Accepted { value: tree, diagnostics: _ } =>
      match family_open_test_store() {
        Present { value: store } =>
          let lookup = emit_on_demand_lookup(
            store: store,
            key: family_native_key_for(tree: tree)
          )
          match lookup {
            EmitOnDemandMiss => materialization_for_lookup(lookup: lookup) == Recompute
            EmitOnDemandHit { receipt: _ } => false
          }
        Absent => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_on_demand_match_loop_fold_interpreter_roles_bounded_holds() -> Bool {
  interpreter_surviving_roles_bounded()
}

test fn emit_on_demand_match_loop_fold_schedule_refuses_unreadable_budget_holds() -> Bool {
  match match_primary_tree() {
    Accepted { value: tree, diagnostics: _ } =>
      match witness_family_realize_width(
        bound_bytes: byte_size(count: 25),
        budget: BudgetUnreadable,
        witness_root: tree.root,
        independence_override: 4
      ) {
        BudgetRefused => true
        PackedWidth { width: _ } => false
        MaturationReserve { width: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_on_demand_match_loop_fold_family_witnesses() -> Bool {
  emit_on_demand_match_loop_fold_grain_keys_differ_holds()
    && emit_on_demand_match_loop_fold_materialize_recompute_on_miss_holds()
    && emit_on_demand_match_loop_fold_interpreter_roles_bounded_holds()
    && emit_on_demand_match_loop_fold_schedule_refuses_unreadable_budget_holds()
    && emit_on_demand_match_agreement_holds()
    && emit_on_demand_match_native_cached_octets_holds()
    && emit_on_demand_match_wrong_fixture_refuses_holds()
    && emit_on_demand_match_native_cold_holds()
    && emit_on_demand_match_native_cold_then_warm_holds()
    && emit_on_demand_match_content_change_cold_rebuild_holds()
    && emit_on_demand_loop_agreement_holds()
    && emit_on_demand_loop_wrong_fixture_refuses_holds()
    && emit_on_demand_loop_native_cold_holds()
    && emit_on_demand_loop_native_cold_then_warm_holds()
    && emit_on_demand_loop_content_change_cold_rebuild_holds()
    && emit_on_demand_fold_closure_agreement_holds()
    && emit_on_demand_fold_closure_native_cached_octets_holds()
    && emit_on_demand_fold_closure_wrong_fixture_refuses_holds()
    && emit_on_demand_fold_closure_native_cold_holds()
    && emit_on_demand_fold_closure_native_cold_then_warm_holds()
    && emit_on_demand_fold_closure_content_change_cold_rebuild_holds()
    && emit_on_demand_match_loop_fold_materialize_share_on_hit_holds()
}
