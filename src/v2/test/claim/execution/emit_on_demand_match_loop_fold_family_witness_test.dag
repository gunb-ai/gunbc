test fn emit_on_demand_loop_content_change_cold_rebuild_holds() -> Bool {
  match loop_primary_tree() {
    Accepted { value: tree_primary, diagnostics: _ } =>
      match loop_alt_tree() {
        Accepted { value: tree_alt, diagnostics: _ } =>
          let key_primary = family_native_key_for(tree: tree_primary)
          let key_alt = family_native_key_for(tree: tree_alt)
          if key_primary == key_alt {
            false
          } else {
            let shared_parent = family_cache_root_for(test_id: "loop_content_change")
            let workspace_primary = native_cache_workspace_root(
              cache_root: shared_parent,
              key: key_primary
            )
            let _evict_primary = emit_on_demand_evict_native_cache(
              cache_root: shared_parent,
              key: key_primary
