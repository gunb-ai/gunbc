module v2.test.execution.emit_on_demand_match_loop_fold_family_witness


data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data emit_on_demand_match_loop_fold_note: String = "Witness-realization fan-out lane 3, migrated to FAMILY-CRATE grain (std.emit_on_demand witness_family_build_grain_ruling, merry-pike-487 fan-out): match + loop + fold are three members of ONE native crate (emit_family concatenation under the derived argv-dispatched main rust_match_loop_fold_family_target_model_staging; the fold member's helper fn rides the family prelude). The single native receipt is emit_on_demand_match_loop_fold_family_one_build_holds: ONE root, both family keys evicted up front; the primary family builds once (match cold, loop/fold/match-again compile_skipped), the eval-anchored member agreements (interpreted == native via run_test_claim_from_source_emit_vs_eval_cached — the agreement oracle stays eval, never the native path itself) and the unknown-member refusal run WARM on the same build; the ALL-ALT family (swapped match, wrong-value loop, wrong-arrow fold) is the content-change RED: new family key -> ONE cold rebuild carrying every wrong-fixture octet flip (match 1->2, loop 1->2, fold 7->-1) plus the eval-anchored loop mismatch. Under the prior per-witness grain this suite paid ~20 crate builds per corpus pass; now 2. Shared pure receipts unchanged: store Share/Recompute, realize_pack refusal, interpreter roles bounded, grain key split."

data family_cache_root: String = emit_on_demand_family_cache_root(family: "match_loop_fold_family")
data family_emitter: String = "v2.compiler.emit"
data family_provider: CacheProvider = provider_row(
  id: "emit-on-demand-match-loop-fold-family",
  scope: [],
  coverage: CoversAllComputations,
  tier: ArtifactTier { keying: ContentKeyed },
  eviction: SpacePacked { budget: "match loop fold native cache" }
)

fn family_open_test_store() -> Optional<ArtifactStore> {
  match store_over_provider(provider: family_provider, budget: byte_size(count: 1000000)) {
    StoreReady { store: s } => optional_present(value: s)
    StoreRefusedEviction { provider_id: _, declared: _ } => optional_absent()
  }
}

fn family_native_key_for(tree: InferredTree) -> ContentHash {
  emit_on_demand_key(
    closure_digest: inferred_tree_digest(tree: tree),
    emitter_identity: family_emitter,
    target_language: "rust",
    grain: NativeArtifact
  )
}

fn family_cache_root_for(test_id: String) -> String {
  concat(family_cache_root, "/", test_id)
}

data match_expected_octets: List<Byte> = [0, 1, 0, 0, 0]
data match_alt_expected_octets: List<Byte> = [0, 2, 0, 0, 0]
data loop_expected_octets: List<Byte> = [0, 1, 0, 0, 0]
data loop_alt_expected_octets: List<Byte> = [0, 2, 0, 0, 0]
data fold_expected_octets: List<Byte> = [0, 7, 0, 0, 0]
data fold_alt_expected_octets: List<Byte> = [0, 255, 255, 255, 255]

fn match_fixture_inputs() -> Inputs {
  inputs_for_emit_host(
    claim_input_root: emit_match_eval_subgraph_node,
    expected_eval_root: emit_match_eval_subgraph_node,
    claim_pin: ^emit_match_eval_evaluator_pin
  )
}

fn match_primary_tree() -> Outcome<InferredTree> {
  emit_match_eval_producer_tree()
}

fn match_alt_tree() -> Outcome<InferredTree> {
  emit_match_eval_swapped_producer_tree()
}

fn loop_primary_tree() -> Outcome<InferredTree> {
  emit_loop_eval_producer_tree()
}

fn loop_alt_tree() -> Outcome<InferredTree> {
  emit_loop_eval_wrong_value_producer_tree()
}

fn fold_primary_tree() -> InferredTree {
  emit_fold_eval_tree_for(root: fold_fixture_param_canonical_arrow)
}

fn fold_alt_tree() -> InferredTree {
  emit_fold_eval_tree_for(root: fold_fixture_param_wrong_arrow)
}

fn mlf_family_members(
  match_tree: InferredTree,
  loop_tree: InferredTree,
  fold_tree: InferredTree
) -> List<EmitFamilyMember> {
  [
    EmitFamilyMember {
      tree: match_tree,
      target: rust_match_target_model_staging()
    },
    EmitFamilyMember {
      tree: loop_tree,
      target: rust_loop_target_model_staging()
    },
    EmitFamilyMember {
      tree: fold_tree,
      target: rust_fold_call_target_model_staging()
    }
  ]
}

fn mlf_no_member_digests() -> List<ContentHash> {
  []
}

fn mlf_family_digest(members: List<EmitFamilyMember>) -> ContentHash {
  family_closure_digest(
    members: fold_list(
      xs: members,
      empty: mlf_no_member_digests(),
      cons: fn(acc, member) {
        concat(acc, [inferred_tree_digest(tree: member.tree)])
      }
    )
  )
}

fn mlf_family_native_key(members: List<EmitFamilyMember>) -> ContentHash {
  emit_on_demand_key(
    closure_digest: mlf_family_digest(members: members),
    emitter_identity: family_emitter,
    target_language: "rust",
    grain: NativeArtifact
  )
}

fn mlf_family_member_run(
  workspace: String,
  source: Medium<String>,
  member_id: String,
  expect_compile_skipped: Bool,
  expected_octets: List<Byte>
) -> Bool {
  match run_emit_host_cached_with_run_args(
    workspace_dir: workspace,
    target: rust_match_loop_fold_family_target_model_staging(),
    source: source,
    fixture_inputs: match_fixture_inputs(),
    run_args: rust_family_member_run_args(member_id: member_id)
  ) {
    Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        Accepted {
          value: HostLogicalRun { stdout: stdout },
          diagnostics: None
        } =>
          receipt.compile_skipped == expect_compile_skipped
            && stdout.bytes == emit_host_octets_byte_string(octets: expected_octets)
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn mlf_family_member_run_refused(
  workspace: String,
  source: Medium<String>,
  member_id: String
) -> Bool {
  match run_emit_host_cached_with_run_args(
    workspace_dir: workspace,
    target: rust_match_loop_fold_family_target_model_staging(),
    source: source,
    fixture_inputs: match_fixture_inputs(),
    run_args: rust_family_member_run_args(member_id: member_id)
  ) {
    Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: _ } => true
      }
    Rejected { diagnostics: _ } => false
  }
}

fn mlf_family_primary_agreements(
  workspace: String,
  source: Medium<String>,
  match_tree: InferredTree,
  loop_tree: InferredTree
) -> Bool {
  emit_match_eval_verdict_is_pass(
    run: run_test_claim_from_source_emit_vs_eval_cached(
      subject: emit_match_eval_subject(tree: match_tree),
      source_outcome: Accepted { value: source, diagnostics: None },
      target: rust_match_loop_fold_family_target_model_staging(),
      workspace_dir: workspace,
      run_args: rust_family_member_run_args(member_id: "match")
    )
  )
    && emit_loop_eval_verdict_is_pass(
      run: run_test_claim_from_source_emit_vs_eval_cached(
        subject: emit_loop_eval_subject(tree: loop_tree),
        source_outcome: Accepted { value: source, diagnostics: None },
        target: rust_match_loop_fold_family_target_model_staging(),
        workspace_dir: workspace,
        run_args: rust_family_member_run_args(member_id: "loop")
      )
    )
    && emit_fold_eval_verdict_is_pass(
      run: run_test_claim_from_source_emit_vs_eval_cached(
        subject: emit_fold_eval_subject(root: fold_fixture_param_canonical_arrow),
        source_outcome: Accepted { value: source, diagnostics: None },
        target: rust_match_loop_fold_family_target_model_staging(),
        workspace_dir: workspace,
        run_args: rust_family_member_run_args(member_id: "fold")
      )
    )
}

fn mlf_family_alt_loop_mismatch(
  workspace: String,
  source: Medium<String>,
  loop_alt: InferredTree
) -> Bool {
  emit_loop_eval_verdict_is_fail(
    run: run_test_claim_from_source_emit_vs_eval_cached(
      subject: emit_loop_eval_subject(tree: loop_alt),
      source_outcome: Accepted { value: source, diagnostics: None },
      target: rust_match_loop_fold_family_target_model_staging(),
      workspace_dir: workspace,
      run_args: rust_family_member_run_args(member_id: "loop")
    )
  )
}

fn mlf_family_primary_runs(workspace: String, source: Medium<String>) -> Bool {
  mlf_family_member_run(
    workspace: workspace,
    source: source,
    member_id: "match",
    expect_compile_skipped: false,
    expected_octets: match_expected_octets
  )
    && mlf_family_member_run(
      workspace: workspace,
      source: source,
      member_id: "loop",
      expect_compile_skipped: true,
      expected_octets: loop_expected_octets
    )
    && mlf_family_member_run(
      workspace: workspace,
      source: source,
      member_id: "fold",
      expect_compile_skipped: true,
      expected_octets: fold_expected_octets
    )
    && mlf_family_member_run(
      workspace: workspace,
      source: source,
      member_id: "match",
      expect_compile_skipped: true,
      expected_octets: match_expected_octets
    )
}

fn mlf_family_alt_runs(workspace: String, source: Medium<String>) -> Bool {
  mlf_family_member_run(
    workspace: workspace,
    source: source,
    member_id: "match",
    expect_compile_skipped: false,
    expected_octets: match_alt_expected_octets
  )
    && mlf_family_member_run(
      workspace: workspace,
      source: source,
      member_id: "loop",
      expect_compile_skipped: true,
      expected_octets: loop_alt_expected_octets
    )
    && mlf_family_member_run(
      workspace: workspace,
      source: source,
      member_id: "fold",
      expect_compile_skipped: true,
      expected_octets: fold_alt_expected_octets
    )
    && (match_alt_expected_octets == match_expected_octets) == false
    && (loop_alt_expected_octets == loop_expected_octets) == false
    && (fold_alt_expected_octets == fold_expected_octets) == false
}

fn mlf_family_one_build_with_sources(
  workspace_primary: String,
  workspace_alt: String,
  source: Medium<String>,
  alt_source: Medium<String>,
  match_tree: InferredTree,
  loop_tree: InferredTree,
  loop_alt: InferredTree
) -> Bool {
  mlf_family_primary_runs(workspace: workspace_primary, source: source)
    && mlf_family_primary_agreements(
      workspace: workspace_primary,
      source: source,
      match_tree: match_tree,
      loop_tree: loop_tree
    )
    && mlf_family_member_run_refused(
      workspace: workspace_primary,
      source: source,
      member_id: "absent_member"
    )
    && mlf_family_alt_runs(workspace: workspace_alt, source: alt_source)
    && mlf_family_alt_loop_mismatch(
      workspace: workspace_alt,
      source: alt_source,
      loop_alt: loop_alt
    )
}

test fn emit_on_demand_match_loop_fold_family_one_build_holds() -> Bool {
  match match_primary_tree() {
    Accepted { value: match_tree, diagnostics: _ } =>
      match loop_primary_tree() {
        Accepted { value: loop_tree, diagnostics: _ } =>
          match match_alt_tree() {
            Accepted { value: match_alt, diagnostics: _ } =>
              match loop_alt_tree() {
                Accepted { value: loop_alt, diagnostics: _ } =>
                  let members = mlf_family_members(
                    match_tree: match_tree,
                    loop_tree: loop_tree,
                    fold_tree: fold_primary_tree()
                  )
                  let alt_members = mlf_family_members(
                    match_tree: match_alt,
                    loop_tree: loop_alt,
                    fold_tree: fold_alt_tree()
                  )
                  let key_primary = mlf_family_native_key(members: members)
                  let key_alt = mlf_family_native_key(members: alt_members)
                  if key_primary == key_alt {
                    false
                  } else {
                    let root = family_cache_root_for(test_id: "family_one_build")
                    let _evict_primary = emit_on_demand_evict_native_cache(
                      cache_root: root,
                      key: key_primary
                    )
                    let _evict_alt = emit_on_demand_evict_native_cache(
                      cache_root: root,
                      key: key_alt
                    )
                    let workspace_primary = native_cache_workspace_root(
                      cache_root: root,
                      key: key_primary
                    )
                    let workspace_alt = native_cache_workspace_root(
                      cache_root: root,
                      key: key_alt
                    )
                    match emit_family(
                      members: members,
                      transport_target: rust_match_loop_fold_family_target_model_staging()
                    ) {
                      Accepted { value: source, diagnostics: _ } =>
                        match emit_family(
                          members: alt_members,
                          transport_target: rust_match_loop_fold_family_target_model_staging()
                        ) {
                          Accepted { value: alt_source, diagnostics: _ } =>
                            mlf_family_one_build_with_sources(
                              workspace_primary: workspace_primary,
                              workspace_alt: workspace_alt,
                              source: source,
                              alt_source: alt_source,
                              match_tree: match_tree,
                              loop_tree: loop_tree,
                              loop_alt: loop_alt
                            )
                          Rejected { diagnostics: _ } => false
                        }
                      Rejected { diagnostics: _ } => false
                    }
                  }
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_on_demand_match_loop_fold_grain_keys_differ_holds() -> Bool {
  match match_primary_tree() {
    Accepted { value: tree, diagnostics: _ } =>
      let digest = inferred_tree_digest(tree: tree)
      let source = emit_on_demand_key(
        closure_digest: digest,
        emitter_identity: family_emitter,
        target_language: "rust",
        grain: SourceArtifact
      )
      let native = emit_on_demand_key(
        closure_digest: digest,
        emitter_identity: family_emitter,
        target_language: "rust",
        grain: NativeArtifact
      )
      (source == native) == false
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_on_demand_match_loop_fold_materialize_share_on_hit_holds() -> Bool {
  match match_primary_tree() {
    Accepted { value: tree, diagnostics: _ } =>
      match family_open_test_store() {
        Present { value: store } =>
          let key = family_native_key_for(tree: tree)
          let put = store_put(store: store, key: key, artifact_bytes: byte_size(count: 64))
          let lookup = emit_on_demand_lookup(store: put.store, key: key)
          match lookup {
            EmitOnDemandHit { receipt: r } =>
              r.compile_skipped
                && materialization_for_lookup(lookup: lookup) == Share
            EmitOnDemandMiss => false
          }
        Absent => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_on_demand_match_loop_fold_materialize_recompute_on_miss_holds() -> Bool {
  match match_primary_tree() {
    Accepted { value: tree, diagnostics: _ } =>
      match family_open_test_store() {
        Present { value: store } =>
          let lookup = emit_on_demand_lookup(
            store: store,
            key: family_native_key_for(tree: tree)
          )
          match lookup {
            EmitOnDemandMiss => materialization_for_lookup(lookup: lookup) == Recompute
            EmitOnDemandHit { receipt: _ } => false
          }
        Absent => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_on_demand_match_loop_fold_interpreter_roles_bounded_holds() -> Bool {
  interpreter_surviving_roles_bounded()
}

test fn emit_on_demand_match_loop_fold_schedule_refuses_unreadable_budget_holds() -> Bool {
  match match_primary_tree() {
    Accepted { value: tree, diagnostics: _ } =>
      match witness_family_realize_width(
        bound_bytes: byte_size(count: 25),
        budget: BudgetUnreadable,
        witness_root: tree.root,
        independence_override: 4
      ) {
        BudgetRefused => true
        PackedWidth { width: _ } => false
        MaturationReserve { width: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_on_demand_match_loop_fold_family_witnesses() -> Bool {
  emit_on_demand_match_loop_fold_grain_keys_differ_holds()
    && emit_on_demand_match_loop_fold_materialize_recompute_on_miss_holds()
    && emit_on_demand_match_loop_fold_interpreter_roles_bounded_holds()
    && emit_on_demand_match_loop_fold_schedule_refuses_unreadable_budget_holds()
    && emit_on_demand_match_loop_fold_family_one_build_holds()
    && emit_on_demand_match_loop_fold_materialize_share_on_hit_holds()
}
