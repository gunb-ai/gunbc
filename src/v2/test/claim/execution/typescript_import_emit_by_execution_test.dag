module v2.test.execution.typescript_import_emit_by_execution


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data ts_import_canonical_source_text: String = "import { Cons, Empty } from \"v2/std/algebra\";"

fn ts_import_symbol_atom(sym: v2.std.node.Symbol) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: sym } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn ts_import_block_node(names: List<v2.std.node.Symbol>) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: fold_list(
      xs: names,
      empty: std.algebra.Empty,
      cons: fn(acc, sym) {
        list_append(
          left: acc,
          right: [v2.std.node.Edge { label: Positional, target: ts_import_symbol_atom(sym: sym) }]
        )
      }
    ),
    occurrence_id: SyntheticOccurrence
  }
}

fn ts_import_qn_node(segments: List<v2.std.node.Symbol>) -> Node {
  fold_list_node(xs: segments, item_node: fn(sym) { ts_import_symbol_atom(sym: sym) })
}

fn ts_import_carrier_node(segments: List<v2.std.node.Symbol>, names: List<v2.std.node.Symbol>) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      v2.std.node.Edge {
        label: Named { name: ^dag_surface_import_decl },
        target: ts_import_symbol_atom(sym: ^dag_surface_import_decl)
      },
      v2.std.node.Edge {
        label: Named { name: ^dag_surface_import_decl_qualified_name },
        target: ts_import_qn_node(segments: segments)
      },
      v2.std.node.Edge {
        label: Named { name: ^dag_surface_import_decl_block },
        target: ts_import_block_node(names: names)
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn ts_import_missing_qn_carrier_node(names: List<v2.std.node.Symbol>) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      v2.std.node.Edge {
        label: Named { name: ^dag_surface_import_decl },
        target: ts_import_symbol_atom(sym: ^dag_surface_import_decl)
      },
      v2.std.node.Edge {
        label: Named { name: ^dag_surface_import_decl_block },
        target: ts_import_block_node(names: names)
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn ts_import_binding_spellings() -> Map<v2.std.node.Symbol, String> {
  map_insert(
    map_insert(
      map_insert(
        map_insert(
          map_insert(
            map_insert(empty_map(), ^seg_v2, "v2"),
            ^seg_std, "std"
          ),
          ^seg_algebra, "algebra"
        ),
        ^seg_collection, "collection"
      ),
      ^name_cons, "Cons"
    ),
    ^name_empty, "Empty"
  )
}

fn ts_import_witness_target_model() -> v2.std.compilers.target_model.TargetModel {
  v2.std.compilers.target_model.TargetModel {
    produced_decl_support: ProducedDeclUnwired,
    bundle: ts_target_model_node(),
    lex: ts_lex(),
    binding_spellings: ts_import_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: "",
    runtime_row: target_emit_host_runtime_row_unconfigured
  }
}

fn ts_import_qualified_name_symbols(qn: v2.std.qualified_name.QualifiedName) -> List<v2.std.node.Symbol> {
  match qn {
    Empty => std.algebra.Empty
    Cons { head: h, tail: t } =>
      std.algebra.Cons { head: h, tail: ts_import_qualified_name_symbols(qn: t) }
  }
}

fn ts_import_name_symbols_from_block(block: Node) -> Outcome<List<v2.std.node.Symbol>> {
  fold(
    node_positional_child_targets(node: block),
    init: outcome_accepted(value: std.algebra.Empty),
    f: fn(acc, nd) {
      bind_outcome(
        o: acc,
        f: fn(syms) {
          bind_outcome(
            o: target_node_atom_identity(node: nd),
            f: fn(sym) {
              outcome_accepted(
                value: list_append(left: syms, right: std.algebra.Cons { head: sym, tail: Empty })
              )
            }
          )
        }
      )
    }
  )
}

fn ts_import_value_from_carrier(carrier: Node) -> Outcome<v2.std.compilers.target_model.TargetImport> {
  bind_outcome(
    o: find_named_child(root: carrier, name: ^dag_surface_import_decl_qualified_name),
    f: fn(qn_node) {
      bind_outcome(
        o: qualified_name_from_node(root: qn_node),
        f: fn(qn) {
          bind_outcome(
            o: find_named_child(root: carrier, name: ^dag_surface_import_decl_block),
            f: fn(block) {
              bind_outcome(
                o: ts_import_name_symbols_from_block(block: block),
                f: fn(names) {
                  outcome_accepted(
                    value: v2.std.compilers.target_model.TargetImport {
                      path_segments: ts_import_qualified_name_symbols(qn: qn),
                      names: names
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn ts_emit_import_from_carrier(carrier: Node) -> Outcome<Medium<String>> {
  bind_outcome(
    o: ts_import_value_from_carrier(carrier: carrier),
    f: fn(import_value) {
      bind_outcome(
        o: target_import_to_concrete_tokens(
          import_value: import_value,
          projection: ts_module_projection()
        ),
        f: fn(tokens) {
          serialize_concrete_syntax_tokens_to_source(
            target: ts_import_witness_target_model(),
            tokens: tokens
          )
        }
      )
    }
  )
}

fn ts_import_emit_text(carrier: Node) -> String {
  match ts_emit_import_from_carrier(carrier: carrier) {
    Accepted { value: source, diagnostics: _ } => source.carried
    Rejected { diagnostics: _ } => "TS_IMPORT_EMIT_REJECTED"
  }
}

fn ts_import_canonical_carrier() -> Node {
  ts_import_carrier_node(
    segments: [^seg_v2, ^seg_std, ^seg_algebra],
    names: [^name_cons, ^name_empty]
  )
}

fn ts_import_swapped_names_carrier() -> Node {
  ts_import_carrier_node(
    segments: [^seg_v2, ^seg_std, ^seg_algebra],
    names: [^name_empty, ^name_cons]
  )
}

fn ts_import_other_path_carrier() -> Node {
  ts_import_carrier_node(
    segments: [^seg_v2, ^seg_std, ^seg_collection],
    names: [^name_cons, ^name_empty]
  )
}

fn ts_import_missing_qn_carrier() -> Node {
  ts_import_missing_qn_carrier_node(names: [^name_cons, ^name_empty])
}

fn ts_import_empty_names_carrier() -> Node {
  ts_import_carrier_node(segments: [^seg_v2, ^seg_std, ^seg_algebra], names: std.algebra.Empty)
}

test fn ts_import_emit_by_execution_exact_holds() -> Bool {
  ts_import_emit_text(carrier: ts_import_canonical_carrier()) == ts_import_canonical_source_text
}

test fn ts_import_emit_swapped_names_discriminates_holds() -> Bool {
  (ts_import_emit_text(carrier: ts_import_canonical_carrier()) == ts_import_canonical_source_text)
    && (ts_import_emit_text(carrier: ts_import_swapped_names_carrier()) != ts_import_canonical_source_text)
    && (ts_import_emit_text(carrier: ts_import_swapped_names_carrier()) != "TS_IMPORT_EMIT_REJECTED")
}

test fn ts_import_emit_other_path_discriminates_holds() -> Bool {
  (ts_import_emit_text(carrier: ts_import_canonical_carrier()) == ts_import_canonical_source_text)
    && (ts_import_emit_text(carrier: ts_import_other_path_carrier()) != ts_import_canonical_source_text)
    && (ts_import_emit_text(carrier: ts_import_other_path_carrier()) != "TS_IMPORT_EMIT_REJECTED")
}

test fn ts_import_emit_missing_qn_fails_closed_holds() -> Bool {
  match ts_emit_import_from_carrier(carrier: ts_import_missing_qn_carrier()) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

test fn ts_import_emit_empty_names_fails_closed_holds() -> Bool {
  match ts_emit_import_from_carrier(carrier: ts_import_empty_names_carrier()) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}
