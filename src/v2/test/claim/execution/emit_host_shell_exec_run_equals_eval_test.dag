module v2.test.execution.emit_host_shell_exec_run_equals_eval

import v2.compiler.emit_host { emit_host_octets_byte_string, run_emit_host_cached_with_run_args }
import v2.compiler.eval { inputs_root_only }
import v2.compiler.target_carriers { source_medium }
import extdeps.communication.medium { Lossless, Medium }
import v2.extdeps.languages.dag { dag_meet_eval_subgraph_fixture }
import v2.extdeps.languages.rust_test {
  rust_shell_exec_run_family_target_model_staging,
  rust_family_member_run_args
}
import v2.std.compilers.target_model { TargetModel }
import v2.std.diagnostic { Accepted, None, Outcome, Rejected }
import v2.std.host_run { HostLogicalRun }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data emit_host_shell_exec_run_equals_eval_note: String = "Agreement test shape for the shell_exec_run native family (neat-carp-312, Task 2), mirroring emit_host_filesystem_read_equals_eval_test.dag's shape. The 'eval' side is real interpreted execution of the same operation via shell_materialize_argv_for_operation + a direct string check, not a fabricated InterpretationAlgebra oracle (there is no .dag-authored arrow body being translated here). Both legs derive the same argv from dag/extdeps/shell/exec.dag's shell.Exec.Run operation -- the native leg's Command::new(...)/.arg(...) literals are baked at .dag construction time from that SAME shell_materialize_argv_for_operation call, so the two legs cannot silently drift apart (see rust_shell_exec_run_family_note in rust_test.dag)."

fn shell_exec_run_witness_argv() -> List<String> {
  shell_materialize_argv_for_operation(
    "dag/extdeps/shell/exec.dag",
    "shell.Exec",
    "Run",
    "",
    "",
    []
  )
}

data shell_exec_run_witness_workspace: String = "/tmp/gunbc_emit_on_demand_shell_exec_run/witness"

fn shell_exec_run_eval_expected_octet() -> Int {
  if length(xs: shell_exec_run_witness_argv()) == 2
    && shell_exec_run_witness_argv().skip(n: 0).first() == "bash"
    && shell_exec_run_witness_argv().skip(n: 1).first() == "-s" { 1 } else { 0 }
}

fn shell_exec_run_native_source() -> Medium<String> {
  source_medium(text: "", fidelity: Lossless)
}

fn shell_exec_run_native_target() -> TargetModel {
  rust_shell_exec_run_family_target_model_staging()
}

fn shell_exec_run_native_run(expected_octet: Int) -> Bool {
  match run_emit_host_cached_with_run_args(
    workspace_dir: shell_exec_run_witness_workspace,
    target: shell_exec_run_native_target(),
    source: shell_exec_run_native_source(),
    fixture_inputs: inputs_root_only(root: dag_meet_eval_subgraph_fixture),
    run_args: rust_family_member_run_args(member_id: "echo_native_shell_ok")
  ) {
    Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        Accepted {
          value: HostLogicalRun { stdout: stdout },
          diagnostics: None
        } =>
          stdout.bytes == emit_host_octets_byte_string(octets: [0, expected_octet, 0, 0, 0])
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn shell_exec_run_eval_argv_is_bash_dash_s() -> Bool {
  shell_exec_run_eval_expected_octet() == 1
}

test fn emit_host_shell_exec_run_equals_eval_holds() -> Bool {
  shell_exec_run_native_run(expected_octet: shell_exec_run_eval_expected_octet())
}

test fn emit_host_shell_exec_run_wrong_oracle_refuses_holds() -> Bool {
  shell_exec_run_native_run(expected_octet: 1 - shell_exec_run_eval_expected_octet()) == false
}

test fn emit_host_shell_exec_run_equals_eval_all_holds() -> Bool {
  shell_exec_run_eval_argv_is_bash_dash_s()
    && emit_host_shell_exec_run_equals_eval_holds()
    && emit_host_shell_exec_run_wrong_oracle_refuses_holds()
}
