import v2.std.diagnostic { Accepted, None, Outcome, Rejected }
import v2.std.host_run { HostLogicalRun }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.std.operation_argv { operation_argv_tokens_or_refusal_label }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data emit_host_shell_exec_run_equals_eval_note: String = "Agreement test shape for the shell_exec_run native family (neat-carp-312, Task 2), mirroring emit_host_filesystem_read_equals_eval_test.dag's shape. The 'eval' side is real interpreted execution of the same operation via shell_materialize_operation_argv + a direct string check, not a fabricated InterpretationAlgebra oracle (there is no .dag-authored arrow body being translated here). Both legs derive the same argv from dag/extdeps/shell/exec.dag's shell.Exec.Run operation -- the native leg's Command::new(...)/.arg(...) literals are baked at .dag construction time from that SAME shell_materialize_operation_argv call, so the two legs cannot silently drift apart (see rust_shell_exec_run_family_note in rust_test.dag)."

fn shell_exec_run_witness_argv() -> List<String> {
  operation_argv_tokens_or_refusal_label(
    m: shell_materialize_operation_argv(
      "dag/extdeps/shell/exec.dag",
      "shell.Exec",
      "Run",
      []
    )
  )
}

data shell_exec_run_witness_workspace: String = "/tmp/gunbc_emit_on_demand_shell_exec_run/witness"

fn shell_exec_run_eval_expected_octet() -> Int {
  if length(xs: shell_exec_run_witness_argv()) == 2
    && shell_exec_run_witness_argv().skip(n: 0).first() == "bash"
    && shell_exec_run_witness_argv().skip(n: 1).first() == "-s" { 1 } else { 0 }
}

fn shell_exec_run_native_source() -> Medium<String> {
  source_medium(text: "", fidelity: Lossless)
}

fn shell_exec_run_native_target() -> TargetModel {
  rust_shell_exec_run_family_target_model_staging()
}
import v2.extdeps.languages.rust { RustGramBuild1StateReady, RustGrammarRelationRow, rust_add_declared_inhabitants_root, rust_binding_spellings, rust_collection_realization_catalog_node, rust_concrete_token_node, rust_declared_inhabitants_root, rust_emit_host_cargo_manifest, rust_emit_host_runtime_primitive_type_node, rust_emit_host_toolchain_pin, rust_fn_add_lex, rust_fn_add_lex_rules, rust_formal_production_fn_add, rust_formal_rhs_from_tokens, rust_grammar_atom, rust_grammar_relation_row_node, rust_grammar_sequence_from_concrete_tokens, rust_grammar_terminal, rust_ident_lex_rule, rust_inhabitant_atom, rust_int_literal_lex_rule, rust_lex_rule, rust_named_edge, rust_operator_realizations_catalog_node, rust_reference_layer_tokens, rust_runtime_row, rust_selection_policy_node, rust_sg_rc_use_site_ownership_catalog, rust_source_text_authority, rust_staging_lex, rust_target_model_bundle_core, rust_target_model_core_edges_with_operators, rust_type_expression_projection_bundle_node, rust_value_expression_projection, rust_value_semantics_carrier_atoms, rust_whitespace_trivia_rule }
import v2.std.algebra { fold_list, list_append, list_snoc_item }
import v2.std.compilers.lexing { LexRule, LexRuleSet, LexRules, ModeledLexRules }
import v2.std.grammar { FormalGrammarSymbol, FormalProduction, GrammarExpr, GrammarProduction, Sequence, derive_grammar_relation_row_node, formal_production_for_lhs_exact, formal_productions_catalog_to_node, grammar_formal_nonterminal_occurrence, grammar_formal_production, grammar_formal_terminal, grammar_formal_terminal_bound, grammar_formal_terminal_free, grammar_relation_tokens_node }
import v2.std.host_transport { EmitHostRuntimeRow, EmittedWithSuffix, FixedText, FixedWidthBytes, HostRuntimeRowPresent, HostToolProgram, HostTransportDescriptor, LiteralArg, ProcessInvocation, TargetEmitHostRuntimeRow, WorkspaceFile, emitted_family_runtime_row_gated, target_emit_host_runtime_row_unconfigured }
import v2.std.logic { bool_boolean_algebra }
import v2.std.node { Atom, ComputationNode, Edge, Node, Symbol, TypeNode }
import v2.std.witness { Violates }

fn shell_exec_run_native_run(expected_octet: Int) -> Bool {
  match run_emit_host_cached_with_run_args(
    workspace_dir: shell_exec_run_witness_workspace,
    target: shell_exec_run_native_target(),
    source: shell_exec_run_native_source(),
    fixture_inputs: inputs_root_only(root: dag_meet_eval_subgraph_fixture),
    run_args: rust_family_member_run_args(member_id: "echo_native_shell_ok")
  ) {
    Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        Accepted {
          value: HostLogicalRun { stdout: stdout },
          diagnostics: None
        } =>
          stdout.bytes == emit_host_octets_byte_string(octets: [0, expected_octet, 0, 0, 0])
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn shell_exec_run_eval_argv_is_bash_dash_s() -> Bool {
  shell_exec_run_eval_expected_octet() == 1
}

test fn emit_host_shell_exec_run_equals_eval_holds() -> Bool {
  shell_exec_run_native_run(expected_octet: shell_exec_run_eval_expected_octet())
}

test fn emit_host_shell_exec_run_wrong_oracle_refuses_holds() -> Bool {
  shell_exec_run_native_run(expected_octet: 1 - shell_exec_run_eval_expected_octet()) == false
}

