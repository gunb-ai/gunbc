module v2.test.execution.branch_if_then_else_round_trip


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data branch_if_then_else_emitted_root: Node = dag_fixture_emitted_pick_fn
data branch_if_then_else_target_model: v2.std.compilers.target_model.TargetModel = dag_pick_target_model()

fn branch_if_then_else_canonical_grounding(
  node: Node,
  algebra: Node
) -> v2.std.constraints.CanonicalGrounding {
  v2.std.constraints.CanonicalGrounding {
    node: node,
    witness: v2.std.constraints.CanonicalGroundingWitness {
      structural: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn branch_if_then_else_canonical_grounding_for(node: Node) -> Witness<v2.std.constraints.CanonicalGrounding> {
  if node == dag_fixture_emitted_pick_fn {
    v2.std.witness.Holds {
      value: branch_if_then_else_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_fixture_int_inhabitant {
    v2.std.witness.Holds {
      value: branch_if_then_else_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_inhabitant_atom(id: ^dag_inhabitant_int) {
    v2.std.witness.Holds {
      value: branch_if_then_else_canonical_grounding(
        node: node,
        algebra: dag_fixture_int_inhabitant
      )
    }
  } else if node == dag_inhabitant_atom(id: ^dag_surface_spelling_int) {
    v2.std.witness.Holds {
      value: branch_if_then_else_canonical_grounding(
        node: node,
        algebra: dag_fixture_int_inhabitant
      )
    }
  } else if node == dag_type_atom_node(identity: ^dag_binding_type_int) {
    v2.std.witness.Holds {
      value: branch_if_then_else_canonical_grounding(
        node: node,
        algebra: dag_fixture_int_inhabitant
      )
    }
  } else if node == dag_type_atom_node(identity: ^dag_token_kw_true) {
    v2.std.witness.Holds {
      value: branch_if_then_else_canonical_grounding(node: node, algebra: node)
    }
  } else if dag_node_is_int_literal_atom(node: node) {
    v2.std.witness.Holds {
      value: branch_if_then_else_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_type_atom_node(identity: ^dag_pick_lit_one) {
    v2.std.witness.Holds {
      value: branch_if_then_else_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_type_atom_node(identity: ^dag_pick_lit_two) {
    v2.std.witness.Holds {
      value: branch_if_then_else_canonical_grounding(node: node, algebra: node)
    }
  } else {
    v2.std.witness.Violates {
      diagnostic: v2.std.diagnostic.Diagnostic {
        reason: ^branch_if_then_else_grounding_miss,
        at: node_locus(node: node),
        correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn branch_if_then_else_inferred_facts_for(node: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  match branch_if_then_else_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => optional_absent()
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => optional_absent()
        Holds { value: proof } =>
          optional_present(value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: v2.std.witness.Holds { value: proof }
            ))
      }
  }
}

fn branch_if_then_else_facts_lookup(key: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  branch_if_then_else_inferred_facts_for(node: key)
}

data branch_if_then_else_inferred_tree: v2.compiler.infer.InferredTree = v2.compiler.infer.InferredTree {
  root: branch_if_then_else_emitted_root,
  facts: std.types.Map {
    lookup: branch_if_then_else_facts_lookup
  }
}

fn branch_if_then_else_emit_accepts() -> Outcome<Medium<String>> {
  emit(tree: branch_if_then_else_inferred_tree, target: branch_if_then_else_target_model)
}

data branch_if_then_else_emit_receipt: Outcome<Medium<String>> = branch_if_then_else_emit_accepts()

fn branch_if_then_else_coercion_quality_is_faithful(q: v2.std.coercion.CoercionQuality) -> Bool {
  match q {
    Exact => true
    Identity => true
    Widened => false
  }
}

test fn branch_if_then_else_emit_matches_serialize_holds() -> Bool {
  match target_serialize_source_from_model(
    target: branch_if_then_else_target_model,
    emitted: branch_if_then_else_emitted_root
  ) {
    Accepted { value: authority, diagnostics: ad } =>
      match branch_if_then_else_emit_receipt {
        Accepted { value: source, diagnostics: d } =>
          (source == authority) && (d == v2.std.diagnostic.None) && (ad == v2.std.diagnostic.None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn branch_if_then_else_grammar_inverse_holds() -> Bool {
  match grammar_inverse_source_validated(
    target: branch_if_then_else_target_model,
    emitted: branch_if_then_else_emitted_root
  ) {
    Accepted { value: _, diagnostics: d } => d == v2.std.diagnostic.None
    Rejected { diagnostics: _ } => false
  }
}

test fn branch_if_then_else_ingest_via_coerce_matches_canonical() -> Bool {
  match coerce_grounded_node(
    source: branch_if_then_else_emitted_root,
    tree: branch_if_then_else_inferred_tree,
    target: branch_if_then_else_target_model
  ) {
    Accepted { value: result, diagnostics: d } =>
      (result.target == dag_fixture_emitted_pick_fn)
        && branch_if_then_else_coercion_quality_is_faithful(q: result.quality)
        && (d == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

