module v2.test.execution.emit_host_module_equals_eval


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn emit_module_single_add_decls() -> std.types.List<v2.compiler.inferred_tree.InferredTree> {
  [v2.test.execution.emit_host_add_equals_eval.emit_eval_subject_tree()]
}

fn emit_module_run(
  cp: fn(v2.std.node.Node, std.types.List<v2.std.runtime.RuntimeValue>, v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue>,
  cp_identity: v2.std.node.Symbol) -> v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue> {
  v2.compiler.emit_host.run_test_claim_module_emit_vs_eval(
    subject: v2.test.execution.emit_host_add_equals_eval.emit_eval_subject(call_primitive: cp, call_primitive_identity: cp_identity),
    module_decls: emit_module_single_add_decls(),
    target: v2.extdeps.languages.rust.rust_target_model_staging()
  )
}

fn emit_module_expected_single_source() -> String {
  v2.std.algebra.list_append(left: v2.extdeps.languages.rust.rust_source_text, right: v2.compiler.emit_module.emit_module_decl_separator)
}

fn emit_module_expected_two_source() -> String {
  v2.std.algebra.list_append(
    left: emit_module_expected_single_source(),
    right: emit_module_expected_single_source()
  )
}

fn emit_module_two_add_decls() -> std.types.List<v2.compiler.inferred_tree.InferredTree> {
  [v2.test.execution.emit_host_add_equals_eval.emit_eval_subject_tree(), v2.test.execution.emit_host_add_equals_eval.emit_eval_subject_tree()]
}

fn emit_module_two_text() -> v2.std.diagnostic.Outcome<String> {
  match v2.compiler.emit_module.emit_module(decls: emit_module_two_add_decls(), target: v2.extdeps.languages.rust.rust_target_model_staging()) {
    Accepted { value: medium, diagnostics: _ } =>
      v2.std.diagnostic.Accepted { value: medium.carried, diagnostics: v2.std.diagnostic.None }
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn emit_module_two_text_matches(golden: String) -> Bool {
  match emit_module_two_text() {
    Accepted { value: text, diagnostics: _ } => text == golden
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_host_module_add_equals_eval_holds() -> Bool {
  v2.test.execution.emit_host_add_equals_eval.emit_eval_verdict_is_pass(
    run: emit_module_run(cp: v2.test.execution.emit_host_add_equals_eval.emit_eval_call_primitive_five, cp_identity: ^v2.test.execution.emit_host_add_equals_eval.emit_eval_call_primitive_five)
  )
}

test fn emit_host_module_wrong_oracle_refuses_holds() -> Bool {
  v2.test.execution.emit_host_add_equals_eval.emit_eval_verdict_is_semantic_mismatch(
    run: emit_module_run(cp: v2.test.execution.emit_host_add_equals_eval.emit_eval_call_primitive_six, cp_identity: ^v2.test.execution.emit_host_add_equals_eval.emit_eval_call_primitive_six)
  )
}

test fn emit_module_join_concatenates_two_decls() -> Bool {
  emit_module_two_text_matches(golden: emit_module_expected_two_source())
    && !emit_module_two_text_matches(golden: emit_module_expected_single_source())
}

