module v2.test.execution.emit_host_module_equals_eval



data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn emit_module_single_add_decls() -> List<InferredTree> {
  [emit_eval_subject_tree()]
}

fn emit_module_run(
  cp: fn(Node, List<RuntimeValue>, EvaluationEnvironment) -> Outcome<RuntimeValue>
) -> TestClaimRun<Node, RuntimeValue> {
  run_test_claim_module_emit_vs_eval(
    subject: emit_eval_subject(call_primitive: cp),
    module_decls: emit_module_single_add_decls(),
    target: rust_target_model_staging()
  )
}

fn emit_module_expected_single_source() -> String {
  list_append(left: rust_source_text, right: emit_module_decl_separator)
}

fn emit_module_expected_two_source() -> String {
  list_append(
    left: emit_module_expected_single_source(),
    right: emit_module_expected_single_source()
  )
}

fn emit_module_two_add_decls() -> List<InferredTree> {
  [emit_eval_subject_tree(), emit_eval_subject_tree()]
}

fn emit_module_two_text() -> Outcome<String> {
  match emit_module(decls: emit_module_two_add_decls(), target: rust_target_model_staging()) {
    Accepted { value: medium, diagnostics: _ } =>
      Accepted { value: medium.carried, diagnostics: None }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn emit_module_two_text_matches(golden: String) -> Bool {
  match emit_module_two_text() {
    Accepted { value: text, diagnostics: _ } => text == golden
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_host_module_add_equals_eval_holds() -> Bool {
  emit_eval_verdict_is_pass(run: emit_module_run(cp: emit_eval_call_primitive_five))
}

test fn emit_host_module_wrong_oracle_refuses_holds() -> Bool {
  emit_eval_verdict_is_semantic_mismatch(run: emit_module_run(cp: emit_eval_call_primitive_six))
}

test fn emit_module_join_concatenates_two_decls() -> Bool {
  emit_module_two_text_matches(golden: emit_module_expected_two_source())
    && !emit_module_two_text_matches(golden: emit_module_expected_single_source())
}

test fn emit_host_module_all_holds() -> Bool {
  emit_host_module_add_equals_eval_holds()
    && emit_host_module_wrong_oracle_refuses_holds()
    && emit_module_join_concatenates_two_decls()
}
