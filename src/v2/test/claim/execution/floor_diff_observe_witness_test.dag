module v2.test.execution.floor_diff_observe_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

test fn witness_ci_policy_observation_succeeds() -> Bool {
  match floor_observe_git_diff_unified_for_ci() {
    UnifiedDiffOk { text: _ } => true
    UnifiedDiffFail { reason: _ } => false
  }
}

test fn witness_invalid_base_fails_closed() -> Bool {
  match floor_run_git_diff_unified(base: "__gunbc_invalid_diff_base__", head: "HEAD", mode: DiffMergeBase) {
    UnifiedDiffFail { reason: _ } => true
    UnifiedDiffOk { text: _ } => false
  }
}

test fn witness_ci_policy_name_status_observation_succeeds() -> Bool {
  match floor_observe_git_diff_name_status_for_ci() {
    NameStatusDiffOk { changed_paths: _, departed_paths: _ } => true
    NameStatusDiffFail { reason: _ } => false
  }
}

test fn witness_invalid_base_name_status_fails_closed() -> Bool {
  match floor_run_git_diff_name_status(base: "__gunbc_invalid_diff_base__", head: "HEAD", mode: DiffMergeBase) {
    NameStatusDiffFail { reason: _ } => true
    NameStatusDiffOk { changed_paths: _, departed_paths: _ } => false
  }
}

