module v2.test.execution.bind_round_trip


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data bind_emitted_root: Node = dag_fixture_emitted_bind_fn
data bind_target_model: v2.std.compilers.target_model.TargetModel = dag_bind_target_model()

fn bind_canonical_grounding(
  node: Node,
  algebra: Node
) -> v2.std.constraints.CanonicalGrounding {
  v2.std.constraints.CanonicalGrounding {
    node: node,
    witness: v2.std.constraints.CanonicalGroundingWitness {
      structural: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn bind_canonical_grounding_for(node: Node) -> Witness<v2.std.constraints.CanonicalGrounding> {
  if node == dag_fixture_emitted_bind_fn {
    v2.std.witness.Holds {
      value: bind_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_fixture_int_inhabitant {
    v2.std.witness.Holds {
      value: bind_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_inhabitant_atom(id: ^dag_inhabitant_int) {
    v2.std.witness.Holds {
      value: bind_canonical_grounding(
        node: node,
        algebra: dag_fixture_int_inhabitant
      )
    }
  } else if node == dag_inhabitant_atom(id: ^dag_surface_spelling_int) {
    v2.std.witness.Holds {
      value: bind_canonical_grounding(
        node: node,
        algebra: dag_fixture_int_inhabitant
      )
    }
  } else if node == dag_type_atom_node(identity: ^dag_binding_type_int) {
    v2.std.witness.Holds {
      value: bind_canonical_grounding(
        node: node,
        algebra: dag_fixture_int_inhabitant
      )
    }
  } else if node == dag_type_atom_node(identity: ^dag_pick_lit_one) {
    v2.std.witness.Holds {
      value: bind_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_type_atom_node(identity: ^dag_pick_lit_two) {
    v2.std.witness.Holds {
      value: bind_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_bind_let_body_fixture {
    v2.std.witness.Holds {
      value: bind_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_pick_arrow_domain_conj_node() {
    v2.std.witness.Holds {
      value: bind_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_type_atom_node(identity: ^dag_binding_fn_one) {
    v2.std.witness.Holds {
      value: bind_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_type_atom_node(identity: ^dag_binding_bind_x) {
    v2.std.witness.Holds {
      value: bind_canonical_grounding(node: node, algebra: node)
    }
  } else {
    v2.std.witness.Violates {
      diagnostic: v2.std.diagnostic.Diagnostic {
        reason: ^bind_grounding_miss,
        at: node_locus(node: node),
        correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn bind_round_trip_inferred_facts_for(node: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  match bind_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => optional_absent()
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => optional_absent()
        Holds { value: proof } =>
          optional_present(value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: v2.std.witness.Holds { value: proof }
            ))
      }
  }
}

fn bind_round_trip_facts_lookup(key: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  bind_round_trip_inferred_facts_for(node: key)
}

data bind_inferred_tree: v2.compiler.infer.InferredTree = v2.compiler.infer.InferredTree {
  root: bind_emitted_root,
  facts: std.types.Map {
    lookup: bind_round_trip_facts_lookup
  }
}

fn bind_emit_accepts() -> v2.std.diagnostic.Outcome<Medium<String>> {
  emit(tree: bind_inferred_tree, target: bind_target_model)
}

data bind_emit_receipt: Outcome<Medium<String>> = bind_emit_accepts()

fn bind_coercion_quality_is_faithful(q: v2.std.coercion.CoercionQuality) -> Bool {
  match q {
    Exact => true
    Identity => true
    Widened => false
  }
}

test fn bind_emit_matches_serialize_holds() -> Bool {
  match target_serialize_source_from_model(
    target: bind_target_model,
    emitted: bind_emitted_root
  ) {
    v2.std.diagnostic.Accepted { value: authority, diagnostics: ad } =>
      match bind_emit_receipt {
        v2.std.diagnostic.Accepted { value: source, diagnostics: d } =>
          (source == authority) && (d == v2.std.diagnostic.None) && (ad == v2.std.diagnostic.None)
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn bind_grammar_inverse_holds() -> Bool {
  match grammar_inverse_source_validated(
    target: bind_target_model,
    emitted: bind_emitted_root
  ) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: d } => d == v2.std.diagnostic.None
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn bind_ingest_via_coerce_matches_canonical() -> Bool {
  match coerce_grounded_node(
    source: bind_emitted_root,
    tree: bind_inferred_tree,
    target: bind_target_model
  ) {
    v2.std.diagnostic.Accepted { value: result, diagnostics: d } =>
      (result.target == dag_fixture_emitted_bind_fn)
        && bind_coercion_quality_is_faithful(q: result.quality)
        && (d == v2.std.diagnostic.None)
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

