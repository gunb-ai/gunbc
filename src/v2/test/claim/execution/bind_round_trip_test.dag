module v2.test.execution.bind_round_trip

import v2.compiler.emit { emit }
import v2.compiler.infer { InferredFacts, InferredTree }
import extdeps.communication.medium { Lossless, Medium }
import v2.compiler.translate {
  coerce_grounded_node,
  grammar_inverse_source_validated,
  target_serialize_source_from_model
}
import v2.extdeps.languages.dag {
  dag_inhabitant_atom,
  dag_bind_target_model,
  dag_bind_let_body_fixture,
  dag_fixture_emitted_bind_fn,
  dag_fixture_int_inhabitant,
  dag_pick_arrow_domain_conj_node,
  dag_type_atom_node
}
import v2.test.lens_common.infer_fixture { claim_inferred_facts_witness }
import v2.std.cardinality { termination_proof_witness_for_node }
import v2.std.collection {
  Map
}
import v2.std.optional {
  Optional,
  Present,
  Absent,
  optional_present,
  optional_absent
}
import v2.std.constraints {
  CanonicalGrounding,
  CanonicalGroundingWitness
}
import v2.std.coercion { CoercionQuality, Exact, Identity, Widened }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  node_locus
}
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.compilers.target_model { TargetModel }
import v2.std.witness { Holds, StructuralPropertyWitness, Violates, Witness }
import v2.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data bind_emitted_root: Node = dag_fixture_emitted_bind_fn
data bind_target_model: TargetModel = dag_bind_target_model()

fn bind_canonical_grounding(
  node: Node,
  algebra: Node
) -> CanonicalGrounding {
  CanonicalGrounding {
    node: node,
    witness: CanonicalGroundingWitness {
      structural: StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn bind_canonical_grounding_for(node: Node) -> Witness<CanonicalGrounding> {
  if node == dag_fixture_emitted_bind_fn {
    Holds {
      value: bind_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_fixture_int_inhabitant {
    Holds {
      value: bind_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_inhabitant_atom(id: ^dag_inhabitant_int) {
    Holds {
      value: bind_canonical_grounding(
        node: node,
        algebra: dag_fixture_int_inhabitant
      )
    }
  } else if node == dag_inhabitant_atom(id: ^dag_surface_spelling_int) {
    Holds {
      value: bind_canonical_grounding(
        node: node,
        algebra: dag_fixture_int_inhabitant
      )
    }
  } else if node == dag_type_atom_node(identity: ^dag_binding_type_int) {
    Holds {
      value: bind_canonical_grounding(
        node: node,
        algebra: dag_fixture_int_inhabitant
      )
    }
  } else if node == dag_type_atom_node(identity: ^dag_pick_lit_one) {
    Holds {
      value: bind_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_type_atom_node(identity: ^dag_pick_lit_two) {
    Holds {
      value: bind_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_bind_let_body_fixture {
    Holds {
      value: bind_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_pick_arrow_domain_conj_node() {
    Holds {
      value: bind_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_type_atom_node(identity: ^dag_binding_fn_one) {
    Holds {
      value: bind_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_type_atom_node(identity: ^dag_binding_bind_x) {
    Holds {
      value: bind_canonical_grounding(node: node, algebra: node)
    }
  } else {
    Violates {
      diagnostic: Diagnostic {
        reason: ^bind_grounding_miss,
        at: node_locus(node: node),
        correction: Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn bind_round_trip_inferred_facts_for(node: Node) -> Optional<InferredFacts> {
  match bind_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => optional_absent()
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => optional_absent()
        Holds { value: proof } =>
          optional_present(value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: Holds { value: proof }
            ))
      }
  }
}

fn bind_round_trip_facts_lookup(key: Node) -> Optional<InferredFacts> {
  bind_round_trip_inferred_facts_for(node: key)
}

data bind_inferred_tree: InferredTree = InferredTree {
  root: bind_emitted_root,
  facts: Map {
    lookup: bind_round_trip_facts_lookup
  }
}

fn bind_emit_accepts() -> Outcome<Medium<String>> {
  emit(tree: bind_inferred_tree, target: bind_target_model)
}

data bind_emit_receipt: Outcome<Medium<String>> = bind_emit_accepts()

fn bind_coercion_quality_is_faithful(q: CoercionQuality) -> Bool {
  match q {
    Exact => true
    Identity => true
    Widened => false
  }
}

fn bind_emit_matches_serialize_holds() -> Bool {
  match target_serialize_source_from_model(
    target: bind_target_model,
    emitted: bind_emitted_root
  ) {
    Accepted { value: authority, diagnostics: ad } =>
      match bind_emit_receipt {
        Accepted { value: source, diagnostics: d } =>
          (source == authority) && (d == None) && (ad == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn bind_grammar_inverse_holds() -> Bool {
  match grammar_inverse_source_validated(
    target: bind_target_model,
    emitted: bind_emitted_root
  ) {
    Accepted { value: _, diagnostics: d } => d == None
    Rejected { diagnostics: _ } => false
  }
}

fn bind_ingest_via_coerce_matches_canonical() -> Bool {
  match coerce_grounded_node(
    source: bind_emitted_root,
    tree: bind_inferred_tree,
    target: bind_target_model
  ) {
    Accepted { value: result, diagnostics: d } =>
      (result.target == dag_fixture_emitted_bind_fn)
        && bind_coercion_quality_is_faithful(q: result.quality)
        && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn bind_round_trip_keystone_holds() -> Bool {
  bind_emit_matches_serialize_holds()
    && bind_grammar_inverse_holds()
    && bind_ingest_via_coerce_matches_canonical()
}
