module v2.test.execution.emit_ingest_typescript_same_language_round_trip

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn emit_ingest_typescript_row_token_spine_classes(row: Node) -> Outcome<List<Symbol>> {
  bind_outcome(
    o: find_named_child(root: row, name: ^grammar_relation_field_tokens),
    f: fn(tokens_root) {
      bind_outcome(
        o: concrete_syntax_token_list_from_node(list_node: tokens_root),
        f: fn(tokens) {
          let classes = fold(
            tokens,
            init: std.algebra.Empty,
            f: fn(acc, t) {
              list_append(left: acc, right: [concrete_syntax_token_class(token: t)])
            }
          )
          outcome_accepted(value: classes)
        }
      )
    }
  )
}

fn emit_ingest_typescript_shared_rules() -> Node {
  ts_translation_rules_node()
}

fn emit_ingest_typescript_canonical_row() -> Node {
  ts_fn_add_bodied_relation_row_node()
}

fn emit_ingest_typescript_canonical_emitted() -> Node {
  ts_emitted_add_fn_node()
}

test fn emit_typescript_backward_selects_canonical_row_holds() -> Bool {
  match grammar_relation_row_for_emitted(
    rules: emit_ingest_typescript_shared_rules(),
    emitted: emit_ingest_typescript_canonical_emitted()
  ) {
    Accepted { value: row, diagnostics: _ } =>
      row == emit_ingest_typescript_canonical_row()
    Rejected { diagnostics: _ } => false
  }
}

test fn ingest_typescript_forward_selects_canonical_emitted_holds() -> Bool {
  match emit_ingest_typescript_row_token_spine_classes(row: emit_ingest_typescript_canonical_row()) {
    Accepted { value: frontier, diagnostics: _ } =>
      match grammar_relation_row_forward_selection(
        frontier: frontier,
        rules: emit_ingest_typescript_shared_rules()
      ) {
        Accepted { value: emitted, diagnostics: _ } =>
          emitted == emit_ingest_typescript_canonical_emitted()
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_then_ingest_typescript_selector_identity_holds() -> Bool {
  match grammar_relation_row_for_emitted(
    rules: emit_ingest_typescript_shared_rules(),
    emitted: emit_ingest_typescript_canonical_emitted()
  ) {
    Accepted { value: row, diagnostics: _ } =>
      match emit_ingest_typescript_row_token_spine_classes(row: row) {
        Accepted { value: frontier, diagnostics: _ } =>
          match grammar_relation_row_forward_selection(
            frontier: frontier,
            rules: emit_ingest_typescript_shared_rules()
          ) {
            Accepted { value: recovered, diagnostics: _ } =>
              recovered == emit_ingest_typescript_canonical_emitted()
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn ingest_then_emit_typescript_selector_identity_holds() -> Bool {
  match emit_ingest_typescript_row_token_spine_classes(row: emit_ingest_typescript_canonical_row()) {
    Accepted { value: frontier, diagnostics: _ } =>
      match grammar_relation_row_forward_selection(
        frontier: frontier,
        rules: emit_ingest_typescript_shared_rules()
      ) {
        Accepted { value: emitted, diagnostics: _ } =>
          match grammar_relation_row_for_emitted(
            rules: emit_ingest_typescript_shared_rules(),
            emitted: emitted
          ) {
            Accepted { value: row, diagnostics: _ } =>
              row == emit_ingest_typescript_canonical_row()
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_ingest_typescript_perturbed_frontier_fails_closed() -> Bool {
  match emit_ingest_typescript_row_token_spine_classes(row: emit_ingest_typescript_canonical_row()) {
    Accepted { value: frontier, diagnostics: _ } =>
      match grammar_relation_row_forward_selection(
        frontier: list_append(left: frontier, right: [^emit_ingest_typescript_perturb_bogus_tok]),
        rules: emit_ingest_typescript_shared_rules()
      ) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: _ } => true
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn ingest_typescript_forward_fails_closed_off_frontier_holds() -> Bool {
  match grammar_relation_row_forward_selection(
    frontier: Cons { head: ^emit_ingest_typescript_perturb_bogus_tok, tail: std.algebra.Empty },
    rules: emit_ingest_typescript_shared_rules()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

test fn emit_typescript_backward_fails_closed_on_foreign_emitted_holds() -> Bool {
  match grammar_relation_row_for_emitted(
    rules: emit_ingest_typescript_shared_rules(),
    emitted: dag_fixture_emitted_add_fn
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}
