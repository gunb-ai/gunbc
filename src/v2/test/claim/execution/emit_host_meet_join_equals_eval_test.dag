module v2.test.execution.emit_host_meet_join_equals_eval


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn meet_join_eval_generic_facts(node: v2.std.node.Node) -> v2.compiler.inferred_tree.InferredFacts {
  v2.test.lens_common.infer_fixture.claim_inferred_facts_from_nodes(
    resolved: node,
    algebra: v2.extdeps.languages.rust.rust_emit_host_runtime_primitive_type_node(),
    descent: v2.std.witness.Holds {
      value: v2.std.cardinality.TerminationProof {
        non_increasing: [],
        strict: v2.std.cardinality.RankingDimension { measured: ^meet_join_eval_generic_descent }
      }
    }
  )
}

fn meet_join_eval_composed_facts(key: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  v2.std.optional.optional_present(value: meet_join_eval_generic_facts(node: key))
}

fn meet_join_eval_tree_for(root: v2.std.node.Node) -> v2.compiler.inferred_tree.InferredTree {
  v2.compiler.inferred_tree.InferredTree {
    root: root,
    facts: std.algebra.PartialFunction { lookup: meet_join_eval_composed_facts }
  }
}

fn meet_join_eval_octet_value(n: Int) -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimePrimitive {
    value: v2.std.runtime.RuntimePrimitiveValue {
      primitive_type: v2.extdeps.languages.rust.rust_emit_host_runtime_primitive_type_node(),
      bytes: v2.compiler.emit_host.emit_host_octets_byte_string(octets: [0, n, 0, 0, 0])
    }
  }
}

fn meet_join_eval_diagnostic(reason: v2.std.node.Symbol, node: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: reason,
    at: v2.std.diagnostic.node_locus(node: node),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn meet_join_eval_bool_true(value: v2.std.runtime.RuntimeValue) -> v2.std.logic.Bool {
  value == meet_join_eval_octet_value(n: 1)
}

fn meet_join_eval_bool_false(value: v2.std.runtime.RuntimeValue) -> v2.std.logic.Bool {
  value == meet_join_eval_octet_value(n: 0)
}

fn meet_join_eval_allocate_literal(node: v2.std.node.Node, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id == ^dag_complement_lit_true {
        v2.std.diagnostic.outcome_accepted(value: meet_join_eval_octet_value(n: 1))
      } else if id == ^dag_complement_lit_false {
        v2.std.diagnostic.outcome_accepted(value: meet_join_eval_octet_value(n: 0))
      } else {
        v2.std.diagnostic.outcome_rejected(
          d: meet_join_eval_diagnostic(reason: ^meet_join_eval_literal_miss, node: node)
        )
      }
    _ =>
      v2.std.diagnostic.outcome_rejected(
        d: meet_join_eval_diagnostic(reason: ^meet_join_eval_literal_miss, node: node)
      )
  }
}

fn meet_join_eval_call_primitive(
  node: v2.std.node.Node,
  _args: List<v2.std.runtime.RuntimeValue>,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.outcome_rejected(
    d: meet_join_eval_diagnostic(reason: ^meet_join_eval_call_primitive_miss, node: node)
  )
}

fn meet_join_eval_choose_branch(
  node: v2.std.node.Node,
  _value: v2.std.runtime.RuntimeValue,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.outcome_rejected(
    d: meet_join_eval_diagnostic(reason: ^meet_join_eval_branch_miss, node: node)
  )
}

fn meet_join_eval_step_loop(
  node: v2.std.node.Node,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.ControlTransfer> {
  v2.std.diagnostic.outcome_rejected(
    d: meet_join_eval_diagnostic(reason: ^meet_join_eval_loop_miss, node: node)
  )
}

fn meet_join_eval_bind_value(
  _key: v2.std.runtime.EnvironmentBindingKey,
  _value: v2.std.runtime.RuntimeValue,
  env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.EvaluationEnvironment> {
  v2.std.diagnostic.outcome_accepted(value: env)
}

fn meet_join_eval_nth_arm_wire(node: v2.std.node.Node, wanted: Int) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match v2.std.collection.list_at_optional(xs: node.children, index: wanted) {
    Present { value: child } =>
      match child {
        Edge { label: _, target: arm_wire } => v2.std.diagnostic.outcome_accepted(value: arm_wire)
      }
    Absent =>
      v2.std.diagnostic.outcome_rejected(
        d: meet_join_eval_diagnostic(reason: ^meet_join_eval_arm_miss, node: node)
      )
  }
}

fn meet_join_eval_arm_body_node(arm_wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match v2.std.node_query.find_named_child(root: arm_wire, name: v2.std.node.match_arm_body) {
    Accepted { value: body, diagnostics: _ } => v2.std.diagnostic.outcome_accepted(value: body)
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn meet_join_eval_choose_arm(
  node: v2.std.node.Node,
  scrutinee: v2.std.runtime.RuntimeValue,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  if meet_join_eval_bool_true(value: scrutinee) {
    match meet_join_eval_nth_arm_wire(node: node, wanted: 1) {
      Accepted { value: arm, diagnostics: _ } =>
        meet_join_eval_arm_body_node(arm_wire: extdeps.vendor.arm.arm)
      Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
    }
  } else if meet_join_eval_bool_false(value: scrutinee) {
    match meet_join_eval_nth_arm_wire(node: node, wanted: 2) {
      Accepted { value: arm, diagnostics: _ } =>
        meet_join_eval_arm_body_node(arm_wire: extdeps.vendor.arm.arm)
      Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
    }
  } else {
    v2.std.diagnostic.outcome_rejected(
      d: meet_join_eval_diagnostic(reason: ^meet_join_eval_arm_miss, node: node)
    )
  }
}

fn meet_join_eval_interpretation() -> v2.std.runtime.InterpretationAlgebra {
  v2.std.runtime.InterpretationAlgebra {
    value: v2.std.runtime.ValueInterpreter { allocate_literal: meet_join_eval_allocate_literal, identity: ^meet_join_eval_allocate_literal },
    transform: v2.std.runtime.TransformInterpreter { call_primitive: meet_join_eval_call_primitive, identity: ^meet_join_eval_call_primitive },
    branch: v2.std.runtime.BranchInterpreter { choose_branch: meet_join_eval_choose_branch, identity: ^meet_join_eval_choose_branch },
    loop: v2.std.runtime.LoopInterpreter { step_loop: meet_join_eval_step_loop, identity: ^meet_join_eval_step_loop },
    bind: v2.std.runtime.BindInterpreter { bind_value: meet_join_eval_bind_value, identity: ^meet_join_eval_bind_value },
    match: v2.std.runtime.MatchInterpreter { choose_arm: meet_join_eval_choose_arm, identity: ^meet_join_eval_choose_arm }
  }
}

fn meet_join_eval_structure_witness() -> v2.std.runtime.InterpretationStructureWitness {
  v2.std.runtime.InterpretationStructureWitness {
    allocate_literal: ^meet_join_eval_allocate_literal,
    call_primitive: ^meet_join_eval_call_primitive,
    choose_branch: ^meet_join_eval_choose_branch,
    step_loop: ^meet_join_eval_step_loop,
    bind_value: ^meet_join_eval_bind_value,
    choose_arm: ^meet_join_eval_choose_arm  }
}

fn meet_join_eval_context() -> v2.compiler.eval.EvalContext {
  v2.compiler.eval.eval_context_with_semantics(
    runtime_identity: ^meet_join_eval_interpretation_pin,
    interpretation: meet_join_eval_interpretation(),
    structure_witness: meet_join_eval_structure_witness()
  )
}

fn meet_join_eval_claim(rhs_result_node: v2.std.node.Node) -> v2.std.verification.TestClaim {
  v2.std.verification.EqualsClaim {
    label: "S2 std/logic meet/join: rust emit host-run == eval via shared octet codec",
    anchor: v2.std.verification.manual_claim_anchor(anchor: ManualAnchorAbsent),
    lhs: rhs_result_node,
    rhs: rhs_result_node,
    classification: v2.std.verification.TestClassification { tier: Tier3, layer: Integration }
  }
}

fn meet_join_eval_subject(tree: v2.compiler.inferred_tree.InferredTree, subgraph: v2.std.node.Node) -> v2.compiler.eval.TestClaimEvalSubject<v2.std.node.Node> {
  v2.compiler.eval.eval_test_claim_subject(
    claim: meet_join_eval_claim(rhs_result_node: subgraph),
    context: meet_join_eval_context(),
    tree: tree,
    evaluator_pin: ^meet_join_eval_evaluator_pin
  )
}

fn meet_join_eval_run(
  root: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel,
  subgraph: v2.std.node.Node
) -> v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue> {
  v2.compiler.emit_host.run_test_claim_emit_vs_eval(
    subject: meet_join_eval_subject(tree: meet_join_eval_tree_for(root: root), subgraph: subgraph),
    target: target
  )
}

fn meet_join_eval_verdict_is_pass(run: v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>) -> v2.std.logic.Bool {
  match run.verdict {
    Pass => true
    SemanticMismatch { actual: _, falsification: _ } => false
    BuildFailed { actual: _, diagnostic: _ } => false
    RunFailed { actual: _, diagnostic: _ } => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}

fn meet_join_eval_verdict_is_semantic_mismatch(run: v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>) -> v2.std.logic.Bool {
  match run.verdict {
    SemanticMismatch { actual: _, falsification: _ } => true
    Pass => false
    BuildFailed { actual: _, diagnostic: _ } => false
    RunFailed { actual: _, diagnostic: _ } => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}

test fn emit_host_meet_equals_eval_holds() -> v2.std.logic.Bool {
  meet_join_eval_verdict_is_pass(
    run: meet_join_eval_run(
      root: v2.extdeps.languages.dag.dag_meet_arrow_with_body_fixture,
      target: v2.extdeps.languages.rust_test.rust_logic_meet_target_model_staging(),
      subgraph: v2.extdeps.languages.dag.dag_meet_eval_subgraph_fixture
    )
  )
}

test fn emit_host_meet_wrong_fixture_refuses_holds() -> v2.std.logic.Bool {
  meet_join_eval_verdict_is_semantic_mismatch(
    run: meet_join_eval_run(
      root: v2.extdeps.languages.dag.dag_meet_arrow_with_body_swapped_arms_fixture,
      target: v2.extdeps.languages.rust_test.rust_logic_meet_target_model_staging(),
      subgraph: v2.extdeps.languages.dag.dag_meet_eval_subgraph_fixture
    )
  )
}

test fn emit_host_join_equals_eval_holds() -> v2.std.logic.Bool {
  meet_join_eval_verdict_is_pass(
    run: meet_join_eval_run(
      root: v2.extdeps.languages.dag.dag_join_arrow_with_body_fixture,
      target: v2.extdeps.languages.rust_test.rust_logic_join_target_model_staging(),
      subgraph: v2.extdeps.languages.dag.dag_join_eval_subgraph_fixture
    )
  )
}

test fn emit_host_join_wrong_fixture_refuses_holds() -> v2.std.logic.Bool {
  meet_join_eval_verdict_is_semantic_mismatch(
    run: meet_join_eval_run(
      root: v2.extdeps.languages.dag.dag_join_arrow_with_body_swapped_arms_fixture,
      target: v2.extdeps.languages.rust_test.rust_logic_join_target_model_staging(),
      subgraph: v2.extdeps.languages.dag.dag_join_eval_subgraph_fixture
    )
  )
}

