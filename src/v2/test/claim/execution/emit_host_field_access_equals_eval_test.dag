module v2.test.execution.emit_host_field_access_equals_eval


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data emit_field_eval_subgraph_node: v2.std.node.Node = v2.extdeps.languages.dag.dag_field_access_body_fixture

fn emit_field_eval_facts_with_descent(node: v2.std.node.Node, descent_symbol: v2.std.node.Symbol) -> v2.compiler.inferred_tree.InferredFacts {
  v2.test.lens_common.infer_fixture.claim_inferred_facts_from_nodes(
    resolved: node,
    algebra: v2.extdeps.languages.rust.rust_emit_host_runtime_primitive_type_node(),
    descent: v2.std.witness.Holds {
      value: v2.std.cardinality.TerminationProof {
        non_increasing: [],
        strict: v2.std.cardinality.RankingDimension { measured: descent_symbol }
      }
    }
  )
}

fn emit_field_eval_generic_facts(node: v2.std.node.Node) -> v2.compiler.inferred_tree.InferredFacts {
  emit_field_eval_facts_with_descent(
    node: node,
    descent_symbol: ^emit_field_eval_generic_descent
  )
}

fn emit_field_eval_composed_facts(key: v2.std.node.Node) -> Optional<v2.compiler.inferred_tree.InferredFacts> {
  v2.std.optional.optional_present(value: emit_field_eval_generic_facts(node: key))
}

fn emit_field_eval_alt_descent_composed_facts(key: v2.std.node.Node) -> Optional<v2.compiler.inferred_tree.InferredFacts> {
  v2.std.optional.optional_present(value: emit_field_eval_facts_with_descent(
    node: key,
    descent_symbol: ^emit_field_eval_alt_descent
  ))
}

fn rust_field_access_emit_host_wrong_field_body() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: Transform },
    children: [
      v2.std.node.Edge {
        label: Positional,
        target: v2.extdeps.languages.dag.dag_type_atom_node(identity: ^dag_token_dot)
      },
      v2.std.node.Edge {
        label: Positional,
        target: v2.extdeps.languages.dag.dag_type_atom_node(identity: ^dag_binding_param_r)
      },
      v2.std.node.Edge {
        label: Positional,
        target: v2.extdeps.languages.dag.dag_type_atom_node(identity: ^dag_binding_pick_lit_one)
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn emit_field_eval_producer_tree() -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> {
  v2.std.diagnostic.outcome_accepted(
    value: v2.compiler.inferred_tree.InferredTree {
      root: v2.extdeps.languages.dag.dag_field_access_arrow_with_body_fixture,
      facts: std.types.Map { lookup: emit_field_eval_composed_facts }
    }
  )
}

fn emit_field_eval_alt_descent_producer_tree() -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> {
  v2.std.diagnostic.outcome_accepted(
    value: v2.compiler.inferred_tree.InferredTree {
      root: v2.extdeps.languages.dag.dag_field_access_arrow_with_body_fixture,
      facts: std.types.Map { lookup: emit_field_eval_alt_descent_composed_facts }
    }
  )
}

fn emit_field_eval_octet_value(n: Int) -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimePrimitive {
    value: v2.std.runtime.RuntimePrimitiveValue {
      primitive_type: v2.extdeps.languages.rust.rust_emit_host_runtime_primitive_type_node(),
      bytes: v2.compiler.emit_host.emit_host_octets_byte_string(octets: [0, n, 0, 0, 0])
    }
  }
}

fn emit_field_eval_diagnostic(reason: v2.std.node.Symbol, node: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: reason,
    at: v2.std.diagnostic.node_locus(node: node),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn emit_field_eval_field_index_from_transform(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<Int> {
  match v2.std.collection.list_at_optional(xs: v2.std.node_query.node_positional_child_targets(node: node), index: 2) {
    Present { value: field_node } =>
      match field_node.kind {
        TypeNode { connective: Atom { identity: id } } =>
          if id == ^dag_binding_rec_v {
            v2.std.diagnostic.outcome_accepted(0)
          } else if id == ^dag_binding_pick_lit_one {
            v2.std.diagnostic.outcome_accepted(1)
          } else {
            v2.std.diagnostic.outcome_rejected(
              d: emit_field_eval_diagnostic(reason: ^emit_field_eval_field_miss, node: node)
            )
          }
        _ =>
          v2.std.diagnostic.outcome_rejected(
            d: emit_field_eval_diagnostic(reason: ^emit_field_eval_field_miss, node: node)
          )
      }
    Absent =>
      v2.std.diagnostic.outcome_rejected(
        d: emit_field_eval_diagnostic(reason: ^emit_field_eval_field_miss, node: node)
      )
  }
}

fn emit_field_eval_call_primitive(
  node: v2.std.node.Node,
  args: std.types.List<v2.std.runtime.RuntimeValue>,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  match emit_field_eval_field_index_from_transform(node: node) {
    Accepted { value: field_index, diagnostics: _ } =>
      if field_index == 0 {
        if v2.std.algebra.length(xs: args) == 2 {
          match v2.std.collection.list_at_optional(xs: args, index: 0) {
            Present { value: base } =>
              v2.std.diagnostic.outcome_accepted(value: base)
            Absent =>
              v2.std.diagnostic.outcome_rejected(
                d: emit_field_eval_diagnostic(reason: ^emit_field_eval_args_bad, node: node)
              )
          }
        } else {
          v2.std.diagnostic.outcome_rejected(
            d: emit_field_eval_diagnostic(reason: ^emit_field_eval_args_bad, node: node)
          )
        }
      } else {
        v2.std.diagnostic.outcome_accepted(value: emit_field_eval_octet_value(n: 0))
      }
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn emit_field_eval_allocate_literal(node: v2.std.node.Node, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id == ^dag_binding_param_r {
        v2.std.diagnostic.outcome_accepted(value: emit_field_eval_octet_value(n: 9))
      } else if id == ^dag_binding_rec_v {
        v2.std.diagnostic.outcome_accepted(value: emit_field_eval_octet_value(n: 0))
      } else if id == ^dag_binding_pick_lit_one {
        v2.std.diagnostic.outcome_accepted(value: emit_field_eval_octet_value(n: 1))
      } else {
        v2.std.diagnostic.outcome_rejected(
          d: emit_field_eval_diagnostic(reason: ^emit_field_eval_literal_miss, node: node)
        )
      }
    _ =>
      v2.std.diagnostic.outcome_rejected(
        d: emit_field_eval_diagnostic(reason: ^emit_field_eval_literal_miss, node: node)
      )
  }
}

fn emit_field_eval_choose_branch(
  node: v2.std.node.Node,
  _value: v2.std.runtime.RuntimeValue,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.outcome_rejected(
    d: emit_field_eval_diagnostic(reason: ^emit_field_eval_branch_miss, node: node)
  )
}

fn emit_field_eval_step_loop(
  node: v2.std.node.Node,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.ControlTransfer> {
  v2.std.diagnostic.outcome_rejected(
    d: emit_field_eval_diagnostic(reason: ^emit_field_eval_loop_miss, node: node)
  )
}

fn emit_field_eval_bind_value(
  _key: v2.std.runtime.EnvironmentBindingKey,
  _value: v2.std.runtime.RuntimeValue,
  env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.EvaluationEnvironment> {
  v2.std.diagnostic.outcome_accepted(value: env)
}

fn emit_field_eval_choose_arm(
  node: v2.std.node.Node,
  _scrutinee: v2.std.runtime.RuntimeValue,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.outcome_rejected(
    d: emit_field_eval_diagnostic(reason: ^emit_field_eval_match_miss, node: node)
  )
}

fn emit_field_eval_interpretation() -> v2.std.runtime.InterpretationAlgebra {
  v2.std.runtime.InterpretationAlgebra {
    value: v2.std.runtime.ValueInterpreter { allocate_literal: emit_field_eval_allocate_literal, identity: ^emit_field_eval_allocate_literal },
    transform: v2.std.runtime.TransformInterpreter { call_primitive: emit_field_eval_call_primitive, identity: ^emit_field_eval_call_primitive },
    branch: v2.std.runtime.BranchInterpreter { choose_branch: emit_field_eval_choose_branch, identity: ^emit_field_eval_choose_branch },
    loop: v2.std.runtime.LoopInterpreter { step_loop: emit_field_eval_step_loop, identity: ^emit_field_eval_step_loop },
    bind: v2.std.runtime.BindInterpreter { bind_value: emit_field_eval_bind_value, identity: ^emit_field_eval_bind_value },
    match: v2.std.runtime.MatchInterpreter { choose_arm: emit_field_eval_choose_arm, identity: ^emit_field_eval_choose_arm }
  }
}

fn emit_field_eval_structure_witness() -> v2.std.runtime.InterpretationStructureWitness {
  v2.std.runtime.InterpretationStructureWitness {
    allocate_literal: ^emit_field_eval_allocate_literal,
    call_primitive: ^emit_field_eval_call_primitive,
    choose_branch: ^emit_field_eval_choose_branch,
    step_loop: ^emit_field_eval_step_loop,
    bind_value: ^emit_field_eval_bind_value,
    choose_arm: ^emit_field_eval_choose_arm  }
}

fn emit_field_eval_context() -> v2.compiler.eval.EvalContext {
  v2.compiler.eval.eval_context_with_semantics(
    runtime_identity: ^emit_field_eval_interpretation_pin,
    interpretation: emit_field_eval_interpretation(),
    structure_witness: emit_field_eval_structure_witness()
  )
}

fn emit_field_eval_claim(rhs_result_node: v2.std.node.Node) -> v2.std.verification.TestClaim {
  v2.std.verification.EqualsClaim {
    label: "S2 F4: rust emit(field-access-fn) host-run == eval(field-access-body) via shared octet codec",
    anchor: v2.std.verification.manual_claim_anchor(anchor: ManualAnchorAbsent),
    lhs: rhs_result_node,
    rhs: rhs_result_node,
    classification: v2.std.verification.TestClassification { tier: Tier3, layer: Integration }
  }
}

fn emit_field_eval_subject(tree: v2.compiler.inferred_tree.InferredTree) -> v2.compiler.eval.TestClaimEvalSubject<v2.std.node.Node> {
  v2.compiler.eval.eval_test_claim_subject(
    claim: emit_field_eval_claim(rhs_result_node: emit_field_eval_subgraph_node),
    context: emit_field_eval_context(),
    tree: tree,
    evaluator_pin: ^emit_field_eval_evaluator_pin
  )
}

fn emit_field_eval_wrong_fixture_subject(tree: v2.compiler.inferred_tree.InferredTree) -> v2.compiler.eval.TestClaimEvalSubject<v2.std.node.Node> {
  v2.compiler.eval.eval_test_claim_subject(
    claim: emit_field_eval_claim(rhs_result_node: rust_field_access_emit_host_wrong_field_body()),
    context: emit_field_eval_context(),
    tree: tree,
    evaluator_pin: ^emit_field_eval_evaluator_pin
  )
}

fn emit_field_eval_run(tree: v2.compiler.inferred_tree.InferredTree) -> v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue> {
  v2.compiler.emit_host.run_test_claim_emit_vs_eval(
    subject: emit_field_eval_subject(tree: tree),
    target: v2.extdeps.languages.rust_test.rust_field_access_target_model_staging()
  )
}

fn emit_field_eval_verdict_is_pass(run: v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>) -> Bool {
  match run.verdict {
    Pass => true
    SemanticMismatch { actual: _, falsification: _ } => false
    BuildFailed { actual: _, diagnostic: _ } => false
    RunFailed { actual: _, diagnostic: _ } => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}

fn emit_field_eval_verdict_is_semantic_mismatch(run: v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>) -> Bool {
  match run.verdict {
    SemanticMismatch { actual: _, falsification: _ } => true
    Pass => false
    BuildFailed { actual: _, diagnostic: _ } => false
    RunFailed { actual: _, diagnostic: _ } => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}

test fn emit_host_field_access_equals_eval_holds() -> Bool {
  match emit_field_eval_producer_tree() {
    Accepted { value: tree, diagnostics: _ } =>
      emit_field_eval_verdict_is_pass(run: emit_field_eval_run(tree: tree))
        && match emit_field_eval_alt_descent_producer_tree() {
          Accepted { value: alt, diagnostics: _ } =>
            emit_field_eval_verdict_is_pass(run: emit_field_eval_run(tree: alt))
          Rejected { diagnostics: _ } => false
        }
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_host_field_access_wrong_fixture_refuses_holds() -> Bool {
  match emit_field_eval_producer_tree() {
    Accepted { value: tree, diagnostics: _ } =>
      emit_field_eval_verdict_is_semantic_mismatch(
        run: v2.compiler.emit_host.run_test_claim_emit_vs_eval(
          subject: emit_field_eval_wrong_fixture_subject(tree: tree),
          target: v2.extdeps.languages.rust_test.rust_field_access_target_model_staging()
        )
      )
    Rejected { diagnostics: _ } => false
  }
}

