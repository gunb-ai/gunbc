import v2.std.verification {
  EqualsClaim,
  Integration,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier3,
  manual_claim_anchor
}
import v2.std.node_query { node_positional_child_targets }
import v2.std.witness { Holds, Witness }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data emit_field_eval_subgraph_node: Node = dag_field_access_body_fixture

fn emit_field_eval_facts_with_descent(node: Node, descent_symbol: Symbol) -> InferredFacts {
  claim_inferred_facts_from_nodes(
    resolved: node,
    algebra: rust_emit_host_runtime_primitive_type_node(),
    descent: Holds {
      value: v2.std.cardinality.TerminationProof {
        non_increasing: [],
        strict: v2.std.cardinality.RankingDimension { measured: descent_symbol }
      }
    }
  )
}

fn emit_field_eval_generic_facts(node: Node) -> InferredFacts {
  emit_field_eval_facts_with_descent(
    node: node,
    descent_symbol: ^emit_field_eval_generic_descent
  )
}

fn emit_field_eval_composed_facts(key: Node) -> Optional<InferredFacts> {
  optional_present(value: emit_field_eval_generic_facts(node: key))
}

fn emit_field_eval_alt_descent_composed_facts(key: Node) -> Optional<InferredFacts> {
  optional_present(value: emit_field_eval_facts_with_descent(
      node: key,
      descent_symbol: ^emit_field_eval_alt_descent
    ))
}

fn rust_field_access_emit_host_wrong_field_body() -> Node {
  Node {
    kind: ComputationNode { behavior: Transform },
    children: [
      Edge {
        label: Positional,
        target: dag_type_atom_node(identity: ^dag_token_dot)
      },
      Edge {
        label: Positional,
        target: dag_type_atom_node(identity: ^dag_binding_param_r)
      },
      Edge {
        label: Positional,
        target: dag_type_atom_node(identity: ^dag_binding_pick_lit_one)
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn emit_field_eval_producer_tree() -> Outcome<InferredTree> {
  outcome_accepted(
    value: InferredTree {
      root: dag_field_access_arrow_with_body_fixture,
      facts: Map { lookup: emit_field_eval_composed_facts }
    }
  )
}

data emit_field_eval_alt_descent_producer_note: String = "Valid alternative tree for the emit-on-demand content-change probe, mirroring kernel_alt_subject_tree: same root, different facts (descent ranking symbol) -> different inferred_tree_digest -> new native key, while the emitted Rust stays the valid fn get(r: (i32,)) -> i32 { r.0 } producing octet 9. The wrong-field tree (r.1 on a 1-tuple) is NOT a valid alt: it is the semantic-mismatch RED fixture and does not compile natively (rustc E0609)."

fn emit_field_eval_alt_descent_producer_tree() -> Outcome<InferredTree> {
  outcome_accepted(
    value: InferredTree {
      root: dag_field_access_arrow_with_body_fixture,
      facts: Map { lookup: emit_field_eval_alt_descent_composed_facts }
    }
  )
}

fn emit_field_eval_octet_value(n: Int) -> RuntimeValue {
  RuntimePrimitive {
    value: RuntimePrimitiveValue {
      primitive_type: rust_emit_host_runtime_primitive_type_node(),
      bytes: emit_host_octets_byte_string(octets: [0, n, 0, 0, 0])
    }
  }
}

fn emit_field_eval_diagnostic(reason: Symbol, node: Node) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn emit_field_eval_field_index_from_transform(node: Node) -> Outcome<Int> {
  match list_at_optional(xs: node_positional_child_targets(node: node), index: 2) {
    Present { value: field_node } =>
      match field_node.kind {
        TypeNode { connective: Atom { identity: id } } =>
          if id == ^dag_binding_rec_v {
            outcome_accepted(0)
          } else if id == ^dag_binding_pick_lit_one {
            outcome_accepted(1)
          } else {
            outcome_rejected(
              d: emit_field_eval_diagnostic(reason: ^emit_field_eval_field_miss, node: node)
            )
          }
        _ =>
          outcome_rejected(
            d: emit_field_eval_diagnostic(reason: ^emit_field_eval_field_miss, node: node)
          )
      }
    Absent =>
      outcome_rejected(
        d: emit_field_eval_diagnostic(reason: ^emit_field_eval_field_miss, node: node)
      )
  }
}

fn emit_field_eval_call_primitive(
  node: Node,
  args: List<RuntimeValue>,
  _env: EvaluationEnvironment
) -> Outcome<RuntimeValue> {
  match emit_field_eval_field_index_from_transform(node: node) {
    Accepted { value: field_index, diagnostics: _ } =>
      if field_index == 0 {
        if length(xs: args) == 2 {
          match list_at_optional(xs: args, index: 0) {
            Present { value: base } =>
              outcome_accepted(value: base)
            Absent =>
              outcome_rejected(
                d: emit_field_eval_diagnostic(reason: ^emit_field_eval_args_bad, node: node)
              )
          }
        } else {
          outcome_rejected(
            d: emit_field_eval_diagnostic(reason: ^emit_field_eval_args_bad, node: node)
          )
        }
      } else {
        outcome_accepted(value: emit_field_eval_octet_value(n: 0))
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn emit_field_eval_allocate_literal(node: Node, _env: EvaluationEnvironment) -> Outcome<RuntimeValue> {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id == ^dag_binding_param_r {
        outcome_accepted(value: emit_field_eval_octet_value(n: 9))
      } else if id == ^dag_binding_rec_v {
        outcome_accepted(value: emit_field_eval_octet_value(n: 0))
      } else if id == ^dag_binding_pick_lit_one {
        outcome_accepted(value: emit_field_eval_octet_value(n: 1))
      } else {
        outcome_rejected(
          d: emit_field_eval_diagnostic(reason: ^emit_field_eval_literal_miss, node: node)
        )
      }
    _ =>
      outcome_rejected(
        d: emit_field_eval_diagnostic(reason: ^emit_field_eval_literal_miss, node: node)
      )
  }
}

fn emit_field_eval_choose_branch(
  node: Node,
  _value: RuntimeValue,
  _env: EvaluationEnvironment
) -> Outcome<Node> {
  outcome_rejected(
    d: emit_field_eval_diagnostic(reason: ^emit_field_eval_branch_miss, node: node)
  )
}

fn emit_field_eval_step_loop(
  node: Node,
  _env: EvaluationEnvironment
) -> Outcome<ControlTransfer> {
  outcome_rejected(
    d: emit_field_eval_diagnostic(reason: ^emit_field_eval_loop_miss, node: node)
  )
}

fn emit_field_eval_bind_value(
  _key: EnvironmentBindingKey,
  _value: RuntimeValue,
  env: EvaluationEnvironment
) -> Outcome<EvaluationEnvironment> {
  outcome_accepted(value: env)
}

fn emit_field_eval_choose_arm(
  node: Node,
  _scrutinee: RuntimeValue,
  _env: EvaluationEnvironment
) -> Outcome<Node> {
  outcome_rejected(
    d: emit_field_eval_diagnostic(reason: ^emit_field_eval_match_miss, node: node)
  )
}

fn emit_field_eval_interpretation() -> InterpretationAlgebra {
  InterpretationAlgebra {
    value: ValueInterpreter { allocate_literal: emit_field_eval_allocate_literal },
    transform: TransformInterpreter { call_primitive: emit_field_eval_call_primitive },
    branch: BranchInterpreter { choose_branch: emit_field_eval_choose_branch },
    loop: LoopInterpreter { step_loop: emit_field_eval_step_loop },
    bind: BindInterpreter { bind_value: emit_field_eval_bind_value },
    match: MatchInterpreter { choose_arm: emit_field_eval_choose_arm }
  }
}

fn emit_field_eval_structure_witness() -> InterpretationStructureWitness {
  InterpretationStructureWitness {
    allocate_literal: ^emit_field_eval_allocate_literal_sym,
    call_primitive: ^emit_field_eval_call_primitive_sym,
    choose_branch: ^emit_field_eval_choose_branch_sym,
    step_loop: ^emit_field_eval_step_loop_sym,
    bind_value: ^emit_field_eval_bind_value_sym,
    choose_arm: ^emit_field_eval_choose_arm_sym
  }
}

fn emit_field_eval_context() -> EvalContext {
  eval_context_with_semantics(
    runtime_identity: ^emit_field_eval_interpretation_pin,
    interpretation: emit_field_eval_interpretation(),
    structure_witness: emit_field_eval_structure_witness()
  )
}

fn emit_field_eval_claim(rhs_result_node: Node) -> TestClaim {
  EqualsClaim {
    label: "S2 F4: rust emit(field-access-fn) host-run == eval(field-access-body) via shared octet codec",
    anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
    lhs: rhs_result_node,
    rhs: rhs_result_node,
    classification: TestClassification { tier: Tier3, layer: Integration }
  }
}

fn emit_field_eval_subject(tree: InferredTree) -> TestClaimEvalSubject<Node> {
  eval_test_claim_subject(
    claim: emit_field_eval_claim(rhs_result_node: emit_field_eval_subgraph_node),
    context: emit_field_eval_context(),
    tree: tree,
    evaluator_pin: ^emit_field_eval_evaluator_pin
  )
}

fn emit_field_eval_wrong_fixture_subject(tree: InferredTree) -> TestClaimEvalSubject<Node> {
  eval_test_claim_subject(
    claim: emit_field_eval_claim(rhs_result_node: rust_field_access_emit_host_wrong_field_body()),
    context: emit_field_eval_context(),
    tree: tree,
    evaluator_pin: ^emit_field_eval_evaluator_pin
  )
}

fn emit_field_eval_run(tree: InferredTree) -> TestClaimRun<Node, RuntimeValue> {
  run_test_claim_emit_vs_eval(
    subject: emit_field_eval_subject(tree: tree),
    target: rust_field_access_target_model_staging()
  )
}

fn emit_field_eval_verdict_is_pass(run: TestClaimRun<Node, RuntimeValue>) -> Bool {
  match run.verdict {
    Pass => true
    SemanticMismatch { actual: _, falsification: _ } => false
    BuildFailed { actual: _, diagnostic: _ } => false
    RunFailed { actual: _, diagnostic: _ } => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}

fn emit_field_eval_verdict_is_semantic_mismatch(run: TestClaimRun<Node, RuntimeValue>) -> Bool {
  match run.verdict {
    SemanticMismatch { actual: _, falsification: _ } => true
    Pass => false
    BuildFailed { actual: _, diagnostic: _ } => false
    RunFailed { actual: _, diagnostic: _ } => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}

test fn emit_host_field_access_equals_eval_holds() -> Bool {
  match emit_field_eval_producer_tree() {
    Accepted { value: tree, diagnostics: _ } =>
      emit_field_eval_verdict_is_pass(run: emit_field_eval_run(tree: tree))
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_host_field_access_wrong_fixture_refuses_holds() -> Bool {
  match emit_field_eval_producer_tree() {
    Accepted { value: tree, diagnostics: _ } =>
      emit_field_eval_verdict_is_semantic_mismatch(
        run: run_test_claim_emit_vs_eval(
          subject: emit_field_eval_wrong_fixture_subject(tree: tree),
          target: rust_field_access_target_model_staging()
        )
      )
    Rejected { diagnostics: _ } => false
  }
}

