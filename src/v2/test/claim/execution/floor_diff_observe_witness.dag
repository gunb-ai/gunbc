module v2.test.claim.execution.floor_diff_observe_witness

import std.logic { Bool }
import std.types { List, String }
import std.materialization_ladder { string_list_contains }
import std.algebra { string_contains }
import gunbc.ci.ci_diff_policy { DiffMergeBase }
import v2.workflow.floor_discovery_row { FloorMarkedSource }
import v2.workflow.floor_diff_observe {
  FloorUnifiedDiffResult,
  UnifiedDiffOk,
  UnifiedDiffFail,
  UnifiedBaseRefUnresolvable,
  FloorNameStatusDiffResult,
  NameStatusDiffOk,
  NameStatusDiffFail,
  NameStatusBaseRefUnresolvable,
  FloorBaseRefVerdict,
  BaseRefVerified,
  BaseRefAbsent,
  BaseRefStoreUnusable,
  floor_base_ref_verdict,
  FloorBaseTestDeclCensus,
  BaseTestDeclCensus,
  BaseTestDeclCensusRefused,
  floor_run_git_diff_unified,
  floor_run_git_diff_name_status,
  floor_observe_git_diff_unified_for_ci,
  floor_observe_git_diff_name_status_for_ci,
  floor_base_test_decl_census_from_listing,
  floor_base_test_decl_names_for_path
}
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn witness_ci_policy_observation_succeeds() -> Bool {
  match floor_observe_git_diff_unified_for_ci() {
    UnifiedDiffOk { text: _ } => true
    UnifiedDiffFail { reason: _ } => false
    UnifiedBaseRefUnresolvable { base_ref: _, reason: _ } => false
  }
}

// THE REFUSAL STAYS REFUSAL: with the base pre-flight in front of the diff, an unresolvable base
// must still end in a refusal arm and never in `UnifiedDiffOk`. Which refusal arm it is, and
// whether it names the base, is pinned by the pure witnesses below (the diff runners reach git,
// and a witness does not hold git).
test fn witness_invalid_base_fails_closed() -> Bool {
  match floor_run_git_diff_unified(base: "__gunbc_invalid_diff_base__", head: "HEAD", mode: DiffMergeBase) {
    UnifiedDiffFail { reason: _ } => true
    UnifiedBaseRefUnresolvable { base_ref: _, reason: _ } => true
    UnifiedDiffOk { text: _ } => false
  }
}

test fn witness_invalid_base_name_status_fails_closed() -> Bool {
  match floor_run_git_diff_name_status(base: "__gunbc_invalid_diff_base__", head: "HEAD", mode: DiffMergeBase) {
    NameStatusDiffFail { reason: _ } => true
    NameStatusBaseRefUnresolvable { base_ref: _, reason: _ } => true
    NameStatusDiffOk { changed_paths: _, departed_paths: _ } => false
  }
}

// THE RED (the defect this row exists for). The base is ASKED OF GIT and answered by a typed arm
// that carries the ref it could not resolve. At the pin this row was filed against there was no
// such arm: an unresolvable base fell through to the generic nonzero-exit arm — the same words
// the round gets when the directory is not a repository at all — and in the round the scope was
// simply computed from whatever came back, so a clone without the base produced a SCOPE instead
// of a REFUSAL and correct mirror content was deleted with it. Both failure states are named
// separately because their remedies are opposite: an absent ref is fetched or replaced by the
// base the caller means; an unreachable store means stop and repair the checkout. Neither may be
// read as "no changes".
test fn witness_missing_base_verdict_names_the_ref() -> Bool {
  match floor_base_ref_verdict(
    base: "__gunbc_invalid_diff_base__",
    listing_success: false,
    listing_stderr: "fatal: not a valid object name '__gunbc_invalid_diff_base__'"
  ) {
    BaseRefAbsent { name: name, stderr: stderr } =>
      name == "__gunbc_invalid_diff_base__"
        && string_contains(s: stderr, pattern: "__gunbc_invalid_diff_base__")
    BaseRefVerified { name: _ } => false
    BaseRefStoreUnusable { name: _ } => false
  }
}

// THE UNREACHABLE STORE IS NOT THE ABSENT REF: same failed observation, different state, because
// the remedies are opposite.
test fn witness_unreachable_store_is_not_an_absent_base() -> Bool {
  match floor_base_ref_verdict(
    base: "origin/main",
    listing_success: false,
    listing_stderr: "fatal: not a git repository (or any of the parent directories): .git"
  ) {
    BaseRefStoreUnusable { name: name } => name == "origin/main"
    BaseRefVerified { name: _ } => false
    BaseRefAbsent { name: _, stderr: _ } => false
  }
}

// THE GREEN: a base that names a commit is ADMITTED and the scope is computed normally — the
// pre-flight must not become a refusal to do any work.
test fn witness_resolvable_base_is_admitted() -> Bool {
  match floor_base_ref_verdict(base: "origin/main", listing_success: true, listing_stderr: "") {
    BaseRefVerified { name: name } => name == "origin/main"
    BaseRefAbsent { name: _, stderr: _ } => false
    BaseRefStoreUnusable { name: _ } => false
  }
}

test fn witness_resolvable_base_computes_the_scope_normally() -> Bool {
  match floor_run_git_diff_unified(base: "HEAD", head: "HEAD", mode: DiffMergeBase) {
    UnifiedDiffOk { text: _ } => true
    UnifiedDiffFail { reason: _ } => false
    UnifiedBaseRefUnresolvable { base_ref: _, reason: _ } => false
  }
}

test fn witness_ci_policy_name_status_observation_succeeds() -> Bool {
  match floor_observe_git_diff_name_status_for_ci() {
    NameStatusDiffOk { changed_paths: _, departed_paths: _ } => true
    NameStatusDiffFail { reason: _ } => false
    NameStatusBaseRefUnresolvable { base_ref: _, reason: _ } => false
  }
}

data base_census_present_path: String = "src/v2/test/claim/execution/floor_diff_observe_witness.dag"
data base_census_absent_path: String = "__gunbc_absent_declaration_census__.dag"
data base_census_known_test_fn: String = "witness_present_path_yields_declared_test_fn_names"
data base_census_unknown_test_fn: String = "witness_this_name_is_not_declared_in_this_file"

fn base_census_fact(path: String, marked: List<String>) -> FloorMarkedSource {
  FloorMarkedSource { repo_path: path, marked: marked }
}

// The census controls exercise `floor_base_test_decl_census_from_listing`, the same fold
// production uses after the base tree listing returns. They do not call
// `ListTreePathsAtRevision` -- that operation declares no hermetic `mock_response`, and a
// changed witness that stops there never reaches a verdict. Production
// (`floor_run_base_test_decl_census`) remains the listing caller. The marked names are SUPPLIED
// values here exactly as they are in production: no content is shown and no text is scanned, so
// a perturbation changes what is supplied and never bytes a scan would have to find.

test fn witness_invalid_base_declaration_census_fails_closed() -> Bool {
  match floor_base_test_decl_census_from_listing(
    base: "__gunbc_invalid_diff_base__",
    paths: [base_census_present_path],
    listing_success: false,
    listing_stderr: "fatal: invalid object",
    paths_nul: "",
    base_marked: []
  ) {
    BaseTestDeclCensusRefused { reason: _ } => true
    BaseTestDeclCensus { rows: _ } => false
  }
}

test fn witness_absent_path_at_valid_base_is_empty_not_refused() -> Bool {
  let census = floor_base_test_decl_census_from_listing(
    base: "HEAD",
    paths: [base_census_absent_path],
    listing_success: true,
    listing_stderr: "",
    paths_nul: "",
    base_marked: []
  )
  match census {
    BaseTestDeclCensusRefused { reason: _ } => false
    BaseTestDeclCensus { rows: _ } =>
      count(floor_base_test_decl_names_for_path(
        census: census,
        path: base_census_absent_path
      )) == 0
  }
}

// The listing decides presence: a fact supplied for a path the base tree does not list is not
// evidence the path was declared there, so the answer stays empty names.
test fn witness_listing_not_a_supplied_fact_decides_presence() -> Bool {
  let census = floor_base_test_decl_census_from_listing(
    base: "HEAD",
    paths: [base_census_absent_path],
    listing_success: true,
    listing_stderr: "",
    paths_nul: "",
    base_marked: [base_census_fact(path: base_census_absent_path, marked: [base_census_known_test_fn])]
  )
  match census {
    BaseTestDeclCensusRefused { reason: _ } => false
    BaseTestDeclCensus { rows: _ } =>
      count(floor_base_test_decl_names_for_path(
        census: census,
        path: base_census_absent_path
      )) == 0
  }
}

test fn witness_present_path_yields_supplied_marked_names() -> Bool {
  let census = floor_base_test_decl_census_from_listing(
    base: "HEAD",
    paths: [base_census_present_path],
    listing_success: true,
    listing_stderr: "",
    paths_nul: base_census_present_path,
    base_marked: [base_census_fact(path: base_census_present_path, marked: [base_census_known_test_fn])]
  )
  match census {
    BaseTestDeclCensusRefused { reason: _ } => false
    BaseTestDeclCensus { rows: _ } =>
      string_list_contains(
        xs: floor_base_test_decl_names_for_path(
          census: census,
          path: base_census_present_path
        ),
        wanted: base_census_known_test_fn
      ) && !string_list_contains(
        xs: floor_base_test_decl_names_for_path(
          census: census,
          path: base_census_present_path
        ),
        wanted: base_census_unknown_test_fn
      )
  }
}

// RED: a path the base tree lists with NO supplied fact refuses. The old shape read the file and
// scanned it; an unobserved base is not an empty list of tests, so there is no arm that absorbs it.
test fn witness_listed_path_without_a_marker_fact_refuses() -> Bool {
  match floor_base_test_decl_census_from_listing(
    base: "HEAD",
    paths: [base_census_present_path],
    listing_success: true,
    listing_stderr: "",
    paths_nul: base_census_present_path,
    base_marked: []
  ) {
    BaseTestDeclCensusRefused { reason: reason } =>
      string_contains(s: reason, pattern: "no marker fact was supplied")
        && string_contains(s: reason, pattern: base_census_present_path)
    BaseTestDeclCensus { rows: _ } => false
  }
}

// RED: a supplier that names one path twice has no answer for it.
test fn witness_listed_path_with_two_marker_facts_refuses() -> Bool {
  match floor_base_test_decl_census_from_listing(
    base: "HEAD",
    paths: [base_census_present_path],
    listing_success: true,
    listing_stderr: "",
    paths_nul: base_census_present_path,
    base_marked: [
      base_census_fact(path: base_census_present_path, marked: [base_census_known_test_fn]),
      base_census_fact(path: base_census_present_path, marked: [])
    ]
  ) {
    BaseTestDeclCensusRefused { reason: reason } =>
      string_contains(s: reason, pattern: "more than one marker fact was supplied")
    BaseTestDeclCensus { rows: _ } => false
  }
}
