module v2.test.execution.emit_host_match_equals_eval


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data emit_match_eval_subgraph_node: Node = dag_match_if_body_fixture

fn emit_match_eval_generic_facts(node: v2.std.node.Node) -> v2.compiler.infer.InferredFacts {
  claim_inferred_facts_from_nodes(
    resolved: node,
    algebra: rust_emit_host_runtime_primitive_type_node(),
    descent: v2.std.witness.Holds {
      value: v2.std.cardinality.TerminationProof {
        non_increasing: [],
        strict: v2.std.cardinality.RankingDimension { measured: ^emit_match_eval_generic_descent }
      }
    }
  )
}

fn emit_match_eval_composed_facts(key: v2.std.node.Node) -> Optional<v2.compiler.infer.InferredFacts> {
  optional_present(value: emit_match_eval_generic_facts(node: key))
}

fn emit_match_eval_producer_tree() -> v2.std.diagnostic.Outcome<v2.compiler.infer.InferredTree> {
  match table_fixture_match_arrow_with_body() {
    v2.std.diagnostic.Accepted { value: root, diagnostics: _ } =>
      outcome_accepted(
        value: v2.compiler.infer.InferredTree {
          root: root,
          facts: std.types.Map { lookup: emit_match_eval_composed_facts }
        }
      )
    v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn emit_match_eval_swapped_producer_tree() -> v2.std.diagnostic.Outcome<v2.compiler.infer.InferredTree> {
  match table_fixture_match_arrow_with_body_swapped_arms() {
    v2.std.diagnostic.Accepted { value: root, diagnostics: _ } =>
      outcome_accepted(
        value: v2.compiler.infer.InferredTree {
          root: root,
          facts: std.types.Map { lookup: emit_match_eval_composed_facts }
        }
      )
    v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn emit_match_eval_octet_value(n: Int) -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimePrimitive {
    value: v2.std.runtime.RuntimePrimitiveValue {
      primitive_type: rust_emit_host_runtime_primitive_type_node(),
      bytes: emit_host_octets_byte_string(octets: [0, n, 0, 0, 0])
    }
  }
}

fn emit_match_eval_diagnostic(reason: v2.std.node.Symbol, node: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: reason,
    at: node_locus(node: node),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn emit_match_eval_bool_true(value: v2.std.runtime.RuntimeValue) -> Bool {
  value == emit_match_eval_octet_value(n: 1)
}

fn emit_match_eval_bool_false(value: v2.std.runtime.RuntimeValue) -> Bool {
  value == emit_match_eval_octet_value(n: 0)
}

fn emit_match_eval_allocate_literal(node: v2.std.node.Node, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id == ^dag_token_kw_true {
        outcome_accepted(value: emit_match_eval_octet_value(n: 1))
      } else if id == ^dag_token_kw_false {
        outcome_accepted(value: emit_match_eval_octet_value(n: 0))
      } else if id == ^dag_pick_lit_one {
        outcome_accepted(value: emit_match_eval_octet_value(n: 1))
      } else if id == ^dag_pick_lit_two {
        outcome_accepted(value: emit_match_eval_octet_value(n: 2))
      } else {
        outcome_rejected(
          d: emit_match_eval_diagnostic(reason: ^emit_match_eval_literal_miss, node: node)
        )
      }
    TypeNode { connective: Conj } =>
      outcome_accepted(value: emit_match_eval_octet_value(n: 0))
    _ =>
      outcome_rejected(
        d: emit_match_eval_diagnostic(reason: ^emit_match_eval_literal_miss, node: node)
      )
  }
}

fn emit_match_eval_call_primitive(
  node: v2.std.node.Node,
  _args: List<v2.std.runtime.RuntimeValue>,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  outcome_rejected(
    d: emit_match_eval_diagnostic(reason: ^emit_match_eval_call_primitive_miss, node: node)
  )
}

fn emit_match_eval_choose_branch(
  node: v2.std.node.Node,
  _value: v2.std.runtime.RuntimeValue,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  outcome_rejected(
    d: emit_match_eval_diagnostic(reason: ^emit_match_eval_branch_miss, node: node)
  )
}

fn emit_match_eval_step_loop(
  node: v2.std.node.Node,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.ControlTransfer> {
  outcome_rejected(
    d: emit_match_eval_diagnostic(reason: ^emit_match_eval_loop_miss, node: node)
  )
}

fn emit_match_eval_bind_value(
  _key: v2.std.runtime.EnvironmentBindingKey,
  _value: v2.std.runtime.RuntimeValue,
  env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.EvaluationEnvironment> {
  outcome_accepted(value: env)
}

fn emit_match_eval_nth_arm_wire(node: v2.std.node.Node, wanted: Int) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match list_at_optional(xs: node.children, index: wanted) {
    Present { value: child } =>
      match child {
        Edge { label: _, target: arm_wire } => outcome_accepted(value: arm_wire)
      }
    Absent =>
      outcome_rejected(
        d: emit_match_eval_diagnostic(reason: ^emit_match_eval_arm_miss, node: node)
      )
  }
}

fn emit_match_eval_arm_body_node(arm_wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match find_named_child(root: arm_wire, name: match_arm_body) {
    v2.std.diagnostic.Accepted { value: body, diagnostics: _ } => outcome_accepted(value: body)
    v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn emit_match_eval_choose_arm(
  node: v2.std.node.Node,
  scrutinee: v2.std.runtime.RuntimeValue,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  if emit_match_eval_bool_true(value: scrutinee) {
    match emit_match_eval_nth_arm_wire(node: node, wanted: 1) {
      v2.std.diagnostic.Accepted { value: arm, diagnostics: _ } =>
        emit_match_eval_arm_body_node(arm_wire: arm)
      v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
    }
  } else if emit_match_eval_bool_false(value: scrutinee) {
    match emit_match_eval_nth_arm_wire(node: node, wanted: 2) {
      v2.std.diagnostic.Accepted { value: arm, diagnostics: _ } =>
        emit_match_eval_arm_body_node(arm_wire: arm)
      v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
    }
  } else {
    outcome_rejected(
      d: emit_match_eval_diagnostic(reason: ^emit_match_eval_arm_miss, node: node)
    )
  }
}

fn emit_match_eval_interpretation() -> v2.std.runtime.InterpretationAlgebra {
  v2.std.runtime.InterpretationAlgebra {
    value: v2.std.runtime.ValueInterpreter { allocate_literal: emit_match_eval_allocate_literal },
    transform: v2.std.runtime.TransformInterpreter { call_primitive: emit_match_eval_call_primitive },
    branch: v2.std.runtime.BranchInterpreter { choose_branch: emit_match_eval_choose_branch },
    loop: v2.std.runtime.LoopInterpreter { step_loop: emit_match_eval_step_loop },
    bind: v2.std.runtime.BindInterpreter { bind_value: emit_match_eval_bind_value },
    match: v2.std.runtime.MatchInterpreter { choose_arm: emit_match_eval_choose_arm }
  }
}

fn emit_match_eval_structure_witness() -> v2.std.runtime.InterpretationStructureWitness {
  v2.std.runtime.InterpretationStructureWitness {
    allocate_literal: ^emit_match_eval_allocate_literal_sym,
    call_primitive: ^emit_match_eval_call_primitive_sym,
    choose_branch: ^emit_match_eval_choose_branch_sym,
    step_loop: ^emit_match_eval_step_loop_sym,
    bind_value: ^emit_match_eval_bind_value_sym,
    choose_arm: ^emit_match_eval_choose_arm_sym
  }
}

fn emit_match_eval_context() -> v2.compiler.eval.EvalContext {
  eval_context_with_semantics(
    runtime_identity: ^emit_match_eval_interpretation_pin,
    interpretation: emit_match_eval_interpretation(),
    structure_witness: emit_match_eval_structure_witness()
  )
}

fn emit_match_eval_claim(rhs_result_node: v2.std.node.Node) -> v2.std.verification.TestClaim {
  v2.std.verification.EqualsClaim {
    label: "S2 B9: rust emit(match-fn) host-run == eval(match-body) via shared octet codec",
    anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
    lhs: rhs_result_node,
    rhs: rhs_result_node,
    classification: v2.std.verification.TestClassification { tier: Tier3, layer: Integration }
  }
}

fn emit_match_eval_subject(tree: v2.compiler.infer.InferredTree) -> TestClaimEvalSubject<v2.std.node.Node> {
  eval_test_claim_subject(
    claim: emit_match_eval_claim(rhs_result_node: emit_match_eval_subgraph_node),
    context: emit_match_eval_context(),
    tree: tree,
    evaluator_pin: ^emit_match_eval_evaluator_pin
  )
}

fn emit_match_eval_run(tree: v2.compiler.infer.InferredTree) -> v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue> {
  run_test_claim_emit_vs_eval(
    subject: emit_match_eval_subject(tree: tree),
    target: rust_match_target_model_staging()
  )
}

fn emit_match_eval_verdict_is_pass(run: v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>) -> Bool {
  match run.verdict {
    Pass => true
    SemanticMismatch { actual: _, falsification: _ } => false
    BuildFailed { actual: _, diagnostic: _ } => false
    RunFailed { actual: _, diagnostic: _ } => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}

fn emit_match_eval_verdict_is_semantic_mismatch(run: v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>) -> Bool {
  match run.verdict {
    SemanticMismatch { actual: _, falsification: _ } => true
    Pass => false
    BuildFailed { actual: _, diagnostic: _ } => false
    RunFailed { actual: _, diagnostic: _ } => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}

test fn emit_host_match_equals_eval_holds() -> Bool {
  match emit_match_eval_producer_tree() {
    v2.std.diagnostic.Accepted { value: tree, diagnostics: _ } =>
      emit_match_eval_verdict_is_pass(run: emit_match_eval_run(tree: tree))
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn emit_host_match_wrong_fixture_refuses_holds() -> Bool {
  match emit_match_eval_swapped_producer_tree() {
    v2.std.diagnostic.Accepted { value: tree, diagnostics: _ } =>
      emit_match_eval_verdict_is_semantic_mismatch(run: emit_match_eval_run(tree: tree))
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn emit_host_match_eval_only_accepts() -> Bool {
  match emit_match_eval_producer_tree() {
    v2.std.diagnostic.Accepted { value: tree, diagnostics: _ } =>
      match eval(
        tree: tree,
        interpretation: emit_match_eval_interpretation(),
        inputs: inputs_root_only(root: emit_match_eval_subgraph_node)
      ) {
        v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn emit_host_match_emit_only_accepts() -> Bool {
  match emit_match_eval_producer_tree() {
    v2.std.diagnostic.Accepted { value: tree, diagnostics: _ } =>
      match emit(tree: tree, target: rust_match_target_model_staging()) {
        v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

