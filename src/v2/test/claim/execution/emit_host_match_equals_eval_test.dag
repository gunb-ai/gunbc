module v2.test.execution.emit_host_match_equals_eval


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data emit_match_eval_subgraph_node: v2.std.node.Node = v2.extdeps.languages.dag.dag_match_if_body_fixture

fn emit_match_eval_generic_facts(node: v2.std.node.Node) -> v2.compiler.inferred_tree.InferredFacts {
  v2.test.lens_common.infer_fixture.claim_inferred_facts_from_nodes(
    resolved: node,
    algebra: v2.extdeps.languages.rust.rust_emit_host_runtime_primitive_type_node(),
    descent: v2.std.witness.Holds {
      value: v2.std.cardinality.TerminationProof {
        non_increasing: [],
        strict: v2.std.cardinality.RankingDimension { measured: ^emit_match_eval_generic_descent }
      }
    }
  )
}

fn emit_match_eval_composed_facts(key: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  v2.std.optional.optional_present(value: emit_match_eval_generic_facts(node: key))
}

fn emit_match_eval_producer_tree() -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> {
  match v2.test.complexity_gate.table_fixture_match_subject_producer.table_fixture_match_arrow_with_body() {
    Accepted { value: root, diagnostics: _ } =>
      v2.std.diagnostic.outcome_accepted(
        value: v2.compiler.inferred_tree.InferredTree {
          root: root,
          facts: std.algebra.PartialFunction { lookup: emit_match_eval_composed_facts }
        }
      )
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn emit_match_eval_swapped_producer_tree() -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> {
  match v2.test.complexity_gate.table_fixture_match_subject_producer.table_fixture_match_arrow_with_body_swapped_arms() {
    Accepted { value: root, diagnostics: _ } =>
      v2.std.diagnostic.outcome_accepted(
        value: v2.compiler.inferred_tree.InferredTree {
          root: root,
          facts: std.algebra.PartialFunction { lookup: emit_match_eval_composed_facts }
        }
      )
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn emit_match_eval_octet_value(n: Int) -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimePrimitive {
    value: v2.std.runtime.RuntimePrimitiveValue {
      primitive_type: v2.extdeps.languages.rust.rust_emit_host_runtime_primitive_type_node(),
      bytes: v2.compiler.emit_host.emit_host_octets_byte_string(octets: [0, n, 0, 0, 0])
    }
  }
}

fn emit_match_eval_diagnostic(reason: v2.std.node.Symbol, node: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: reason,
    at: v2.std.diagnostic.node_locus(node: node),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn emit_match_eval_bool_true(value: v2.std.runtime.RuntimeValue) -> v2.std.logic.Bool {
  value == emit_match_eval_octet_value(n: 1)
}

fn emit_match_eval_bool_false(value: v2.std.runtime.RuntimeValue) -> v2.std.logic.Bool {
  value == emit_match_eval_octet_value(n: 0)
}

fn emit_match_eval_allocate_literal(node: v2.std.node.Node, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id == ^dag_token_kw_true {
        v2.std.diagnostic.outcome_accepted(value: emit_match_eval_octet_value(n: 1))
      } else if id == ^dag_token_kw_false {
        v2.std.diagnostic.outcome_accepted(value: emit_match_eval_octet_value(n: 0))
      } else if id == ^dag_pick_lit_one {
        v2.std.diagnostic.outcome_accepted(value: emit_match_eval_octet_value(n: 1))
      } else if id == ^dag_pick_lit_two {
        v2.std.diagnostic.outcome_accepted(value: emit_match_eval_octet_value(n: 2))
      } else {
        v2.std.diagnostic.outcome_rejected(
          d: emit_match_eval_diagnostic(reason: ^emit_match_eval_literal_miss, node: node)
        )
      }
    TypeNode { connective: Conj } =>
      v2.std.diagnostic.outcome_accepted(value: emit_match_eval_octet_value(n: 0))
    _ =>
      v2.std.diagnostic.outcome_rejected(
        d: emit_match_eval_diagnostic(reason: ^emit_match_eval_literal_miss, node: node)
      )
  }
}

fn emit_match_eval_call_primitive(
  node: v2.std.node.Node,
  _args: List<v2.std.runtime.RuntimeValue>,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.outcome_rejected(
    d: emit_match_eval_diagnostic(reason: ^emit_match_eval_call_primitive_miss, node: node)
  )
}

fn emit_match_eval_choose_branch(
  node: v2.std.node.Node,
  _value: v2.std.runtime.RuntimeValue,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.outcome_rejected(
    d: emit_match_eval_diagnostic(reason: ^emit_match_eval_branch_miss, node: node)
  )
}

fn emit_match_eval_step_loop(
  node: v2.std.node.Node,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.ControlTransfer> {
  v2.std.diagnostic.outcome_rejected(
    d: emit_match_eval_diagnostic(reason: ^emit_match_eval_loop_miss, node: node)
  )
}

fn emit_match_eval_bind_value(
  _key: v2.std.runtime.EnvironmentBindingKey,
  _value: v2.std.runtime.RuntimeValue,
  env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.EvaluationEnvironment> {
  v2.std.diagnostic.outcome_accepted(value: env)
}

fn emit_match_eval_nth_arm_wire(node: v2.std.node.Node, wanted: Int) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match v2.std.collection.list_at_optional(xs: node.children, index: wanted) {
    Present { value: child } =>
      match child {
        Edge { label: _, target: arm_wire } => v2.std.diagnostic.outcome_accepted(value: arm_wire)
      }
    Absent =>
      v2.std.diagnostic.outcome_rejected(
        d: emit_match_eval_diagnostic(reason: ^emit_match_eval_arm_miss, node: node)
      )
  }
}

fn emit_match_eval_arm_body_node(arm_wire: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match v2.std.node_query.find_named_child(root: arm_wire, name: v2.std.node.match_arm_body) {
    Accepted { value: body, diagnostics: _ } => v2.std.diagnostic.outcome_accepted(value: body)
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn emit_match_eval_choose_arm(
  node: v2.std.node.Node,
  scrutinee: v2.std.runtime.RuntimeValue,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  if emit_match_eval_bool_true(value: scrutinee) {
    match emit_match_eval_nth_arm_wire(node: node, wanted: 1) {
      Accepted { value: arm, diagnostics: _ } =>
        emit_match_eval_arm_body_node(arm_wire: extdeps.vendor.arm.arm)
      Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
    }
  } else if emit_match_eval_bool_false(value: scrutinee) {
    match emit_match_eval_nth_arm_wire(node: node, wanted: 2) {
      Accepted { value: arm, diagnostics: _ } =>
        emit_match_eval_arm_body_node(arm_wire: extdeps.vendor.arm.arm)
      Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
    }
  } else {
    v2.std.diagnostic.outcome_rejected(
      d: emit_match_eval_diagnostic(reason: ^emit_match_eval_arm_miss, node: node)
    )
  }
}

fn emit_match_eval_interpretation() -> v2.std.runtime.InterpretationAlgebra {
  v2.std.runtime.InterpretationAlgebra {
    value: v2.std.runtime.ValueInterpreter { allocate_literal: emit_match_eval_allocate_literal, identity: ^emit_match_eval_allocate_literal },
    transform: v2.std.runtime.TransformInterpreter { call_primitive: emit_match_eval_call_primitive, identity: ^emit_match_eval_call_primitive },
    branch: v2.std.runtime.BranchInterpreter { choose_branch: emit_match_eval_choose_branch, identity: ^emit_match_eval_choose_branch },
    loop: v2.std.runtime.LoopInterpreter { step_loop: emit_match_eval_step_loop, identity: ^emit_match_eval_step_loop },
    bind: v2.std.runtime.BindInterpreter { bind_value: emit_match_eval_bind_value, identity: ^emit_match_eval_bind_value },
    match: v2.std.runtime.MatchInterpreter { choose_arm: emit_match_eval_choose_arm, identity: ^emit_match_eval_choose_arm }
  }
}

fn emit_match_eval_structure_witness() -> v2.std.runtime.InterpretationStructureWitness {
  v2.std.runtime.InterpretationStructureWitness {
    allocate_literal: ^emit_match_eval_allocate_literal,
    call_primitive: ^emit_match_eval_call_primitive,
    choose_branch: ^emit_match_eval_choose_branch,
    step_loop: ^emit_match_eval_step_loop,
    bind_value: ^emit_match_eval_bind_value,
    choose_arm: ^emit_match_eval_choose_arm  }
}

fn emit_match_eval_context() -> v2.compiler.eval.EvalContext {
  v2.compiler.eval.eval_context_with_semantics(
    runtime_identity: ^emit_match_eval_interpretation_pin,
    interpretation: emit_match_eval_interpretation(),
    structure_witness: emit_match_eval_structure_witness()
  )
}

fn emit_match_eval_claim(rhs_result_node: v2.std.node.Node) -> v2.std.verification.TestClaim {
  v2.std.verification.EqualsClaim {
    label: "S2 B9: rust emit(match-fn) host-run == eval(match-body) via shared octet codec",
    anchor: v2.std.verification.manual_claim_anchor(anchor: ManualAnchorAbsent),
    lhs: rhs_result_node,
    rhs: rhs_result_node,
    classification: v2.std.verification.TestClassification { tier: Tier3, layer: Integration }
  }
}

fn emit_match_eval_subject(tree: v2.compiler.inferred_tree.InferredTree) -> v2.compiler.eval.TestClaimEvalSubject<v2.std.node.Node> {
  v2.compiler.eval.eval_test_claim_subject(
    claim: emit_match_eval_claim(rhs_result_node: emit_match_eval_subgraph_node),
    context: emit_match_eval_context(),
    tree: tree,
    evaluator_pin: ^emit_match_eval_evaluator_pin
  )
}

fn emit_match_eval_run(tree: v2.compiler.inferred_tree.InferredTree) -> v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue> {
  v2.compiler.emit_host.run_test_claim_emit_vs_eval(
    subject: emit_match_eval_subject(tree: tree),
    target: v2.extdeps.languages.rust_test.rust_match_target_model_staging()
  )
}

fn emit_match_eval_verdict_is_pass(run: v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>) -> v2.std.logic.Bool {
  match run.verdict {
    Pass => true
    SemanticMismatch { actual: _, falsification: _ } => false
    BuildFailed { actual: _, diagnostic: _ } => false
    RunFailed { actual: _, diagnostic: _ } => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}

fn emit_match_eval_verdict_is_semantic_mismatch(run: v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>) -> v2.std.logic.Bool {
  match run.verdict {
    SemanticMismatch { actual: _, falsification: _ } => true
    Pass => false
    BuildFailed { actual: _, diagnostic: _ } => false
    RunFailed { actual: _, diagnostic: _ } => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}

test fn emit_host_match_equals_eval_holds() -> v2.std.logic.Bool {
// WHAT THIS PAIR ESTABLISHES, AND THE STRONGER THING IT DOES NOT. Each `test fn` is its own
// execution and each calls emit_match_eval_run, so the equals row and this row launch TWO
// INDEPENDENT UNCACHED rustc subprocesses over the same subject. They are two samples of the
// environment, not two classifications of one run.
//
// So the reading "equals red + reached green therefore emit and eval genuinely disagree" DOES NOT
// FOLLOW, and an earlier revision of this file's PR asserted it. The counter-case is precisely the
// population being diagnosed: the first subprocess dies under contention (BuildFailed or RunFailed)
// while the second, moments later, passes. Both rows would then be telling the truth about
// different attempts, and the pair would have accused the compiler on the strength of an
// environment failure -- the same wrong-owner conclusion, one level up.
//
// WHAT IT HONESTLY BUYS: a second, independently sampled row whose subject is "can the emit-host
// path reach a semantic judgment here at all". Both rows red is strong evidence the environment
// could not run, since two independent attempts failed to reach semantics. Equals red with this
// row green is a NARROWING, not a proof: it says a contemporaneous run of the same subject did
// reach judgment, which raises but does not settle the question of what the equals run did.
//
// NEXT-RUNG TRIGGER, and it is the durable fix rather than more rows: the floor receipt preserving
// the typed Verdict instead of reducing it to Bool. One run, one Verdict, both propositions read
// off the same value -- at which point this row's job is done by construction and it becomes a
// regression control rather than a sampler. That is a change to the witness protocol, not to this
// module, which is why it is named here instead of attempted here.
//
// AND THE TRIGGER IS NOT DEFERRED POLISH, BECAUSE A CLASSIFICATION REQUIRES A SINGLE RECEIPT
// LINEAGE. Cross-execution comparison may establish INSTABILITY; it can never classify the CAUSE
// of either execution. emit -> host run -> parse actual -> compare must sit in ONE lineage. So
// without the typed Verdict carried with its receipt, this row can only ever report stability,
// never cause -- the current shape cannot answer the question the row's NAME asks.
  match emit_match_eval_producer_tree() {
    Accepted { value: tree, diagnostics: _ } =>
      emit_match_eval_verdict_is_pass(run: emit_match_eval_run(tree: tree))
    Rejected { diagnostics: _ } => false
  }
}

// TEST-SIDE PROJECTION AT THE ASSERTION BOUNDARY, WHICH IS WHERE THE COLLAPSE IS ALLOWED TO LIVE.
// A `test fn` must return Bool, so a witness over a coproduct verdict has to collapse it somewhere;
// the predicate-dissolution rule forbids the AUTHORITY exposing an is_* Bool over its own coproduct,
// not the witness performing the collapse it is obliged to perform. v2.std.verdict exposes no such
// predicate and this change adds none to it. The precedent is recorded in
// test.claim.self_host_promotion_admission `pa_admitted`, whose annotation states the boundary in
// as many words after review 51217.
//
// AND THE CANONICAL QUERY SURFACE CANNOT ANSWER THIS QUESTION, WHICH IS THE WHOLE POINT OF THE ROW.
// v2.std.verdict verdict_tally_add is the fold over Verdict, and it counts SemanticMismatch,
// BuildFailed and RunFailed all as `fail`. That is the exact collapse this witness exists to
// undo: routing through it would classify "the compiler disagreed with itself" and "rustc was
// killed" into one bucket again, one layer further from the assertion. A tally is the right
// surface for counting outcomes and the wrong one for distinguishing two of them.
fn emit_match_eval_verdict_reached_semantics(run: v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>) -> v2.std.logic.Bool {
  match run.verdict {
    v2.std.verdict.Pass => true
    v2.std.verdict.SemanticMismatch { actual: _, falsification: _ } => true
    BuildFailed { actual: _, diagnostic: _ } => false
    v2.std.verdict.RunFailed { actual: _, diagnostic: _ } => false
    v2.std.verdict.Deferred { actual: _, diagnostic: _ } => false
  }
}

data emit_match_eval_unbuildable_source_text: String = "fn main() { this is not rust"

fn emit_match_eval_unbuildable_run(tree: v2.compiler.inferred_tree.InferredTree) -> v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue> {
  v2.compiler.emit_host.run_test_claim_from_source_emit_vs_eval(
    subject: emit_match_eval_subject(tree: tree),
    source_outcome: v2.std.diagnostic.outcome_accepted(
      value: Medium { carried: emit_match_eval_unbuildable_source_text, fidelity: extdeps.communication.medium.Lossless }
    ),
    target: v2.extdeps.languages.rust_test.rust_match_target_model_staging()
  )
}

test fn emit_host_match_run_reaches_semantics_holds() -> v2.std.logic.Bool {
  match emit_match_eval_producer_tree() {
    Accepted { value: tree, diagnostics: _ } =>
      emit_match_eval_verdict_reached_semantics(run: emit_match_eval_run(tree: tree))
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn emit_host_match_unbuildable_source_does_not_reach_semantics_holds() -> v2.std.logic.Bool {
  match emit_match_eval_producer_tree() {
    Accepted { value: tree, diagnostics: _ } =>
      emit_match_eval_verdict_reached_semantics(
        run: emit_match_eval_unbuildable_run(tree: tree)
      ) == false
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn emit_host_match_equals_eval_holds() -> v2.std.logic.Bool {
  match emit_match_eval_producer_tree() {
    Accepted { value: tree, diagnostics: _ } =>
      emit_match_eval_verdict_is_pass(run: emit_match_eval_run(tree: tree))
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_host_match_wrong_fixture_refuses_holds() -> v2.std.logic.Bool {
  match emit_match_eval_swapped_producer_tree() {
    Accepted { value: tree, diagnostics: _ } =>
      emit_match_eval_verdict_is_semantic_mismatch(run: emit_match_eval_run(tree: tree))
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_host_match_eval_only_accepts() -> v2.std.logic.Bool {
  match emit_match_eval_producer_tree() {
    Accepted { value: tree, diagnostics: _ } =>
      match v2.compiler.eval.eval(
        tree: tree,
        interpretation: emit_match_eval_interpretation(),
        inputs: v2.compiler.eval.inputs_root_only(root: emit_match_eval_subgraph_node)
      ) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_host_match_emit_only_accepts() -> v2.std.logic.Bool {
  match emit_match_eval_producer_tree() {
    Accepted { value: tree, diagnostics: _ } =>
      match v2.compiler.emit.emit(tree: tree, target: v2.extdeps.languages.rust_test.rust_match_target_model_staging()) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

