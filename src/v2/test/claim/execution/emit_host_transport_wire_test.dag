module v2.test.execution.emit_host_transport_wire


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn wire_probe_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^emit_host_wire_probe } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn wire_inputs() -> v2.compiler.eval.Inputs {
  inputs_root_only(root: wire_probe_node())
}

fn wire_source() -> Medium<String> {
  extdeps.communication.medium.Medium { carried: rust_source_text, fidelity: Lossless }
}

fn wire_fixed_main_row(main_text: String) -> v2.std.host_transport.EmitHostRuntimeRow {
  v2.std.host_transport.EmitHostRuntimeRow {
    transport: v2.std.host_transport.HostTransportDescriptor {
      identity: ^emit_host_wire_probe_fixed_main,
      workspace: [
        v2.std.host_transport.WorkspaceFile {
          path: "Cargo.toml",
          content: v2.std.host_transport.FixedText { text: rust_emit_host_cargo_manifest }
        },
        v2.std.host_transport.WorkspaceFile {
          path: "src/main.rs",
          content: v2.std.host_transport.FixedText { text: main_text }
        }
      ],
      build: [],
      run: v2.std.host_transport.ProcessInvocation {
        program: v2.std.host_transport.HostToolProgram { executable: "cargo" },
        args: [v2.std.host_transport.LiteralArg { text: "run" }, v2.std.host_transport.LiteralArg { text: "--quiet" }]
      },
      runtime_value_codec: v2.std.host_transport.FixedWidthBytes { width: 5 }
    },
    runtime_primitive_type: wire_probe_node()
  }
}

fn wire_escaping_row() -> v2.std.host_transport.EmitHostRuntimeRow {
  v2.std.host_transport.EmitHostRuntimeRow {
    transport: v2.std.host_transport.HostTransportDescriptor {
      identity: ^emit_host_wire_probe_escaping,
      workspace: [
        v2.std.host_transport.WorkspaceFile {
          path: "../escape.rs",
          content: v2.std.host_transport.FixedText { text: "fn main() {}" }
        }
      ],
      build: [],
      run: v2.std.host_transport.ProcessInvocation {
        program: v2.std.host_transport.HostToolProgram { executable: "cargo" },
        args: [v2.std.host_transport.LiteralArg { text: "run" }, v2.std.host_transport.LiteralArg { text: "--quiet" }]
      },
      runtime_value_codec: v2.std.host_transport.FixedWidthBytes { width: 5 }
    },
    runtime_primitive_type: wire_probe_node()
  }
}

test fn emit_host_transport_outside_grant_refuses_holds() -> Bool {
  match run_host_process(
    row: wire_escaping_row(),
    target: rust_target_model_staging(),
    source: wire_source(),
    fixture_inputs: wire_inputs()
  ) {
    Rejected { diagnostics: r } => r.head.reason == ^emit_host_transport_outside_grant
    Accepted { value: _, diagnostics: _ } => false
  }
}

test fn emit_host_transport_green_run_holds() -> Bool {
  match run_emit_host(
    target: rust_target_model_staging(),
    source: wire_source(),
    fixture_inputs: wire_inputs()
  ) {
    Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        Accepted { value: HostLogicalRun { stdout: stdout }, diagnostics: None } =>
          match runtime_value_parse(target: rust_target_model_staging(), stdout: stdout) {
            Accepted { value: _, diagnostics: _ } =>
              stdout.bytes == emit_host_octets_byte_string(octets: [0, 5, 0, 0, 0])
            Rejected { diagnostics: _ } => false
          }
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_host_transport_nonzero_exit_refuses_holds() -> Bool {
  match run_host_process(
    row: wire_fixed_main_row(main_text: "fn main() { std::process::exit(3); }"),
    target: rust_target_model_staging(),
    source: wire_source(),
    fixture_inputs: wire_inputs()
  ) {
    Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        Rejected { diagnostics: _ } => true
        Accepted { value: _, diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_host_transport_byte_width_mismatch_refuses_holds() -> Bool {
  match run_host_process(
    row: wire_fixed_main_row(main_text: "fn main() { let _ = std::io::Write::write_all(&mut std::io::stdout(), &[0u8; 4]); }"),
    target: rust_target_model_staging(),
    source: wire_source(),
    fixture_inputs: wire_inputs()
  ) {
    Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        Accepted { value: HostLogicalRun { stdout: stdout }, diagnostics: None } =>
          match runtime_value_parse(target: rust_target_model_staging(), stdout: stdout) {
            Rejected { diagnostics: _ } => true
            Accepted { value: _, diagnostics: _ } => false
          }
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_host_row_bound_executable_identity_holds() -> Bool {
  match emit_host_process_program_name(program: v2.std.host_transport.HostToolProgram { executable: "go" }) {
    Accepted { value: name, diagnostics: None } => name == "go"
    Rejected { diagnostics: _ } => false
    Accepted { value: _, diagnostics: Some { diagnostics: _ } } => false
  }
}

test fn emit_host_row_bound_executable_identity_discriminates_holds() -> Bool {
  match emit_host_process_program_name(program: v2.std.host_transport.HostToolProgram { executable: "python3" }) {
    Accepted { value: name, diagnostics: None } => name == "python3"
    Rejected { diagnostics: _ } => false
    Accepted { value: _, diagnostics: Some { diagnostics: _ } } => false
  }
}

