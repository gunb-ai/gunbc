module v2.test.execution.emit_host_transport_wire


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn wire_probe_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^emit_host_wire_probe } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn wire_inputs() -> v2.compiler.eval.Inputs {
  v2.compiler.eval.inputs_root_only(root: wire_probe_node())
}

fn wire_source() -> extdeps.communication.medium.Medium<String> {
  extdeps.communication.medium.Medium { carried: v2.extdeps.languages.rust.rust_source_text, fidelity: extdeps.communication.medium.Lossless }
}

fn wire_fixed_main_row(main_text: String) -> v2.std.host_transport.EmitHostRuntimeRow {
  v2.std.host_transport.EmitHostRuntimeRow {
    transport: v2.std.host_transport.HostTransportDescriptor {
      identity: ^emit_host_wire_probe_fixed_main,
      workspace: [
        v2.std.host_transport.WorkspaceFile {
          path: "Cargo.toml",
          content: v2.std.host_transport.FixedText { text: v2.extdeps.languages.rust.rust_emit_host_cargo_manifest }
        },
        v2.std.host_transport.WorkspaceFile {
          path: "src/main.rs",
          content: v2.std.host_transport.FixedText { text: main_text }
        }
      ],
      build: [],
      run: v2.std.host_transport.ProcessInvocation {
        program: v2.std.host_transport.HostToolProgram { executable: "cargo" },
        args: [v2.std.host_transport.LiteralArg { text: "run" }, v2.std.host_transport.LiteralArg { text: "--quiet" }]
      },
      runtime_value_codec: v2.std.host_transport.FixedWidthBytes { width: 5 }
    },
    runtime_primitive_type: wire_probe_node()
  }
}

fn wire_escaping_row() -> v2.std.host_transport.EmitHostRuntimeRow {
  v2.std.host_transport.EmitHostRuntimeRow {
    transport: v2.std.host_transport.HostTransportDescriptor {
      identity: ^emit_host_wire_probe_escaping,
      workspace: [
        v2.std.host_transport.WorkspaceFile {
          path: "../escape.rs",
          content: v2.std.host_transport.FixedText { text: "fn main() {}" }
        }
      ],
      build: [],
      run: v2.std.host_transport.ProcessInvocation {
        program: v2.std.host_transport.HostToolProgram { executable: "cargo" },
        args: [v2.std.host_transport.LiteralArg { text: "run" }, v2.std.host_transport.LiteralArg { text: "--quiet" }]
      },
      runtime_value_codec: v2.std.host_transport.FixedWidthBytes { width: 5 }
    },
    runtime_primitive_type: wire_probe_node()
  }
}

test fn emit_host_transport_outside_grant_refuses_holds() -> Bool {
  match v2.compiler.emit_host.run_host_process(
    row: wire_escaping_row(),
    target: v2.extdeps.languages.rust.rust_target_model_staging(),
    source: wire_source(),
    fixture_inputs: wire_inputs()
  ) {
    v2.std.diagnostic.Rejected { diagnostics: r } => r.head.reason == ^emit_host_transport_outside_grant
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
  }
}

test fn emit_host_transport_green_run_holds() -> Bool {
  match v2.compiler.emit_host.run_emit_host(
    target: v2.extdeps.languages.rust.rust_target_model_staging(),
    source: wire_source(),
    fixture_inputs: wire_inputs()
  ) {
    v2.std.diagnostic.Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        v2.std.diagnostic.Accepted { value: v2.std.host_run.HostLogicalRun { stdout: stdout }, diagnostics: v2.std.diagnostic.None } =>
          match v2.compiler.emit_host.runtime_value_parse(target: v2.extdeps.languages.rust.rust_target_model_staging(), stdout: stdout) {
            v2.std.diagnostic.Accepted { value: _, diagnostics: _ } =>
              stdout.bytes == v2.compiler.emit_host.emit_host_octets_byte_string(octets: [0, 5, 0, 0, 0])
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
          }
        _ => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn emit_host_transport_nonzero_exit_refuses_holds() -> Bool {
  match v2.compiler.emit_host.run_host_process(
    row: wire_fixed_main_row(main_text: "fn main() { std::process::exit(3); }"),
    target: v2.extdeps.languages.rust.rust_target_model_staging(),
    source: wire_source(),
    fixture_inputs: wire_inputs()
  ) {
    v2.std.diagnostic.Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        v2.std.diagnostic.Rejected { diagnostics: _ } => true
        v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn emit_host_transport_byte_width_mismatch_refuses_holds() -> Bool {
  match v2.compiler.emit_host.run_host_process(
    row: wire_fixed_main_row(main_text: "fn main() { let _ = std::io::Write::write_all(&mut std::io::stdout(), &[0u8; 4]); }"),
    target: v2.extdeps.languages.rust.rust_target_model_staging(),
    source: wire_source(),
    fixture_inputs: wire_inputs()
  ) {
    v2.std.diagnostic.Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        v2.std.diagnostic.Accepted { value: v2.std.host_run.HostLogicalRun { stdout: stdout }, diagnostics: v2.std.diagnostic.None } =>
          match v2.compiler.emit_host.runtime_value_parse(target: v2.extdeps.languages.rust.rust_target_model_staging(), stdout: stdout) {
            v2.std.diagnostic.Rejected { diagnostics: _ } => true
            v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
          }
        _ => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn emit_host_row_bound_executable_identity_holds() -> Bool {
  match v2.compiler.emit_host.emit_host_process_program_name(program: v2.std.host_transport.HostToolProgram { executable: "go" }) {
    v2.std.diagnostic.Accepted { value: name, diagnostics: v2.std.diagnostic.None } => name == "go"
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
    v2.std.diagnostic.Accepted { value: _, diagnostics: Some { diagnostics: _ } } => false
  }
}

test fn emit_host_row_bound_executable_identity_discriminates_holds() -> Bool {
  match v2.compiler.emit_host.emit_host_process_program_name(program: v2.std.host_transport.HostToolProgram { executable: "python3" }) {
    v2.std.diagnostic.Accepted { value: name, diagnostics: v2.std.diagnostic.None } => name == "python3"
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
    v2.std.diagnostic.Accepted { value: _, diagnostics: Some { diagnostics: _ } } => false
  }
}

