module v2.test.execution.emit_host_transport_wire

import extdeps.communication.medium { Lossless, Medium }
import v2.compiler.emit_host {
  emit_host_octets_byte_string,
  emit_host_process_program_name,
  run_emit_host,
  run_host_process,
  runtime_value_parse
}
import v2.compiler.eval { Inputs, inputs_root_only }
import v2.extdeps.languages.rust {
  rust_emit_host_cargo_manifest,
  rust_source_text,
  rust_target_model_staging
}
import v2.std.diagnostic { Accepted, Rejected, None }
import v2.std.host_run { HostLogicalRun }
import v2.std.host_transport {
  EmitHostRuntimeRow,
  FixedText,
  FixedWidthBytes,
  HostToolProgram,
  HostTransportDescriptor,
  LiteralArg,
  ProcessInvocation,
  WorkspaceFile
}
import v2.std.logic { Bool }
import v2.std.node { Atom, Node, SyntheticOccurrence, TypeNode }
import v2.std.text { String }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn wire_probe_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^emit_host_wire_probe } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn wire_inputs() -> Inputs {
  inputs_root_only(root: wire_probe_node())
}

fn wire_source() -> Medium<String> {
  Medium { carried: rust_source_text, fidelity: Lossless }
}

fn wire_fixed_main_row(main_text: String) -> EmitHostRuntimeRow {
  EmitHostRuntimeRow {
    transport: HostTransportDescriptor {
      identity: ^emit_host_wire_probe_fixed_main,
      workspace: [
        WorkspaceFile {
          path: "Cargo.toml",
          content: FixedText { text: rust_emit_host_cargo_manifest }
        },
        WorkspaceFile {
          path: "src/main.rs",
          content: FixedText { text: main_text }
        }
      ],
      build: [],
      run: ProcessInvocation {
        program: HostToolProgram { executable: "cargo" },
        args: [LiteralArg { text: "run" }, LiteralArg { text: "--quiet" }]
      },
      runtime_value_codec: FixedWidthBytes { width: 5 }
    },
    runtime_primitive_type: wire_probe_node()
  }
}

fn wire_escaping_row() -> EmitHostRuntimeRow {
  EmitHostRuntimeRow {
    transport: HostTransportDescriptor {
      identity: ^emit_host_wire_probe_escaping,
      workspace: [
        WorkspaceFile {
          path: "../escape.rs",
          content: FixedText { text: "fn main() {}" }
        }
      ],
      build: [],
      run: ProcessInvocation {
        program: HostToolProgram { executable: "cargo" },
        args: [LiteralArg { text: "run" }, LiteralArg { text: "--quiet" }]
      },
      runtime_value_codec: FixedWidthBytes { width: 5 }
    },
    runtime_primitive_type: wire_probe_node()
  }
}

test fn emit_host_transport_outside_grant_refuses_holds() -> Bool {
  match run_host_process(
    row: wire_escaping_row(),
    target: rust_target_model_staging(),
    source: wire_source(),
    fixture_inputs: wire_inputs()
  ) {
    Rejected { diagnostics: r } => r.head.reason == ^emit_host_transport_outside_grant
    Accepted { value: _, diagnostics: _ } => false
  }
}

test fn emit_host_transport_green_run_holds() -> Bool {
  match run_emit_host(
    target: rust_target_model_staging(),
    source: wire_source(),
    fixture_inputs: wire_inputs()
  ) {
    Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        Accepted { value: HostLogicalRun { stdout: stdout }, diagnostics: None } =>
          match runtime_value_parse(target: rust_target_model_staging(), stdout: stdout) {
            Accepted { value: _, diagnostics: _ } =>
              stdout.bytes == emit_host_octets_byte_string(octets: [0, 5, 0, 0, 0])
            Rejected { diagnostics: _ } => false
          }
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_host_transport_nonzero_exit_refuses_holds() -> Bool {
  match run_host_process(
    row: wire_fixed_main_row(main_text: "fn main() { std::process::exit(3); }"),
    target: rust_target_model_staging(),
    source: wire_source(),
    fixture_inputs: wire_inputs()
  ) {
    Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        Rejected { diagnostics: _ } => true
        Accepted { value: _, diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_host_transport_byte_width_mismatch_refuses_holds() -> Bool {
  match run_host_process(
    row: wire_fixed_main_row(main_text: "fn main() { let _ = std::io::Write::write_all(&mut std::io::stdout(), &[0u8; 4]); }"),
    target: rust_target_model_staging(),
    source: wire_source(),
    fixture_inputs: wire_inputs()
  ) {
    Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        Accepted { value: HostLogicalRun { stdout: stdout }, diagnostics: None } =>
          match runtime_value_parse(target: rust_target_model_staging(), stdout: stdout) {
            Rejected { diagnostics: _ } => true
            Accepted { value: _, diagnostics: _ } => false
          }
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_host_row_bound_executable_identity_holds() -> Bool {
  match emit_host_process_program_name(program: HostToolProgram { executable: "go" }) {
    Accepted { value: name, diagnostics: None } => name == "go"
    Rejected { diagnostics: _ } => false
    Accepted { value: _, diagnostics: Some { diagnostics: _ } } => false
  }
}

test fn emit_host_row_bound_executable_identity_discriminates_holds() -> Bool {
  match emit_host_process_program_name(program: HostToolProgram { executable: "python3" }) {
    Accepted { value: name, diagnostics: None } => name == "python3"
    Rejected { diagnostics: _ } => false
    Accepted { value: _, diagnostics: Some { diagnostics: _ } } => false
  }
}

test fn emit_host_transport_wire_all_holds() -> Bool {
  emit_host_transport_outside_grant_refuses_holds()
    && emit_host_transport_green_run_holds()
    && emit_host_transport_nonzero_exit_refuses_holds()
    && emit_host_transport_byte_width_mismatch_refuses_holds()
    && emit_host_row_bound_executable_identity_holds()
    && emit_host_row_bound_executable_identity_discriminates_holds()
}
