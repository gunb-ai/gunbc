module v2.test.execution.rust_record_construct_emit_host_equals_eval

import v2.compiler.emit_host {
  emit_host_octets_byte_string,
  run_test_claim_emit_vs_eval
}
import v2.compiler.eval {
  EvalContext,
  TestClaimEvalSubject,
  TestClaimRun,
  eval_context_with_semantics,
  eval_test_claim_subject
}
import v2.compiler.infer { InferredFacts, InferredTree }
import v2.extdeps.languages.dag {
  dag_arrow_with_body_node,
  dag_pick_arrow_domain_conj_node,
  dag_rec_construct_body_fixture,
  dag_type_atom_node
}
import v2.extdeps.languages.rust { rust_emit_host_runtime_primitive_type_node }
import v2.extdeps.languages.rust_test {
  rust_rec_nine_target_model_staging,
  rust_rec_nine_wrong_field_target_model_staging
}
import extdeps.communication.medium { Medium }
import v2.test.lens_common.infer_fixture { claim_inferred_facts_from_nodes }
import v2.std.algebra { length }
import v2.std.cardinality { RankingDimension, TerminationProof }
import v2.std.collection { List, Map, list_at_optional }
import v2.std.compilers.target_model { TargetModel }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  node_locus,
  outcome_accepted,
  outcome_rejected
}
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  ComputationNode,
  Conj,
  Edge,
  Node,
  Positional,
  Symbol,
  SyntheticOccurrence,
  Transform,
  TypeNode
}
import v2.std.node_query { node_positional_child_targets }
import v2.std.runtime {
  BindInterpreter,
  BranchInterpreter,
  ControlTransfer,
  EnvironmentBindingKey,
  EvaluationEnvironment,
  InterpretationAlgebra,
  InterpretationStructureWitness,
  LoopInterpreter,
  MatchInterpreter,
  RuntimePrimitive,
  RuntimePrimitiveValue,
  RuntimeValue,
  TransformInterpreter,
  ValueInterpreter
}
import v2.std.verdict { BuildFailed, Deferred, Pass, RunFailed, SemanticMismatch, Verdict }
import v2.std.verification {
  EqualsClaim,
  Integration,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier3,
  manual_claim_anchor
}
import v2.std.witness { Holds, Witness }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn rust_rec_nine_field_access_body_node() -> Node {
  Node {
    kind: ComputationNode { behavior: Transform },
    children: [
      Edge {
        label: Positional,
        target: dag_type_atom_node(identity: ^dag_token_dot)
      },
      Edge {
        label: Positional,
        target: dag_rec_construct_body_fixture
      },
      Edge {
        label: Positional,
        target: dag_type_atom_node(identity: ^dag_binding_rec_v)
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn rust_rec_nine_arrow_node() -> Node {
  dag_arrow_with_body_node(
    domain: dag_pick_arrow_domain_conj_node(),
    return_type_binding: ^dag_binding_type_int,
    body: rust_rec_nine_field_access_body_node()
  )
}

data rust_rec_nine_eval_subgraph_node: Node = rust_rec_nine_field_access_body_node()

fn rust_rec_nine_eval_generic_facts(node: Node) -> InferredFacts {
  claim_inferred_facts_from_nodes(
    resolved: node,
    algebra: rust_emit_host_runtime_primitive_type_node(),
    descent: Holds {
      value: TerminationProof {
        non_increasing: [],
        strict: RankingDimension { measured: ^rust_rec_nine_eval_generic_descent }
      }
    }
  )
}

fn rust_rec_nine_eval_composed_facts(key: Node) -> Witness<InferredFacts> {
  Holds { value: rust_rec_nine_eval_generic_facts(node: key) }
}

fn rust_rec_nine_eval_inferred_tree() -> InferredTree {
  InferredTree {
    root: rust_rec_nine_arrow_node(),
    facts: Map { lookup: rust_rec_nine_eval_composed_facts }
  }
}

fn rust_rec_nine_eval_octet_value(n: Int) -> RuntimeValue {
  RuntimePrimitive {
    value: RuntimePrimitiveValue {
      primitive_type: rust_emit_host_runtime_primitive_type_node(),
      bytes: emit_host_octets_byte_string(octets: [0, n, 0, 0, 0])
    }
  }
}

fn rust_rec_nine_eval_diagnostic(reason: Symbol, node: Node) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn rust_rec_nine_eval_field_index_from_transform(node: Node) -> Outcome<Int> {
  match list_at_optional(xs: node_positional_child_targets(node: node), index: 2) {
    Present { value: field_node } =>
      match field_node.kind {
        TypeNode { connective: Atom { identity: id } } =>
          if id == ^dag_binding_rec_v {
            outcome_accepted(0)
          } else {
            outcome_rejected(
              d: rust_rec_nine_eval_diagnostic(
                reason: ^rust_rec_nine_eval_field_miss,
                node: node
              )
            )
          }
        _ =>
          outcome_rejected(
            d: rust_rec_nine_eval_diagnostic(
              reason: ^rust_rec_nine_eval_field_miss,
              node: node
            )
          )
      }
    Absent =>
      outcome_rejected(
        d: rust_rec_nine_eval_diagnostic(reason: ^rust_rec_nine_eval_field_miss, node: node)
      )
  }
}

fn rust_rec_nine_eval_allocate_literal(node: Node, _env: EvaluationEnvironment) -> Outcome<RuntimeValue> {
  match node.kind {
    TypeNode { connective: Conj } =>
      outcome_accepted(value: rust_rec_nine_eval_octet_value(n: 9))
    TypeNode { connective: Atom { identity: id } } =>
      if id == ^dag_binding_type_rec {
        outcome_accepted(value: rust_rec_nine_eval_octet_value(n: 0))
      } else if id == ^dag_rec_lit_nine {
        outcome_accepted(value: rust_rec_nine_eval_octet_value(n: 9))
      } else if id == ^dag_binding_rec_v {
        outcome_accepted(value: rust_rec_nine_eval_octet_value(n: 0))
      } else {
        outcome_rejected(
          d: rust_rec_nine_eval_diagnostic(
            reason: ^rust_rec_nine_eval_literal_miss,
            node: node
          )
        )
      }
    _ =>
      outcome_rejected(
        d: rust_rec_nine_eval_diagnostic(
          reason: ^rust_rec_nine_eval_literal_miss,
          node: node
        )
      )
  }
}

fn rust_rec_nine_eval_call_primitive(
  node: Node,
  args: List<RuntimeValue>,
  _env: EvaluationEnvironment
) -> Outcome<RuntimeValue> {
  match rust_rec_nine_eval_field_index_from_transform(node: node) {
    Accepted { value: field_index, diagnostics: _ } =>
      if field_index == 0 {
        if length(xs: args) == 2 {
          match list_at_optional(xs: args, index: 0) {
            Present { value: base } => outcome_accepted(value: base)
            Absent =>
              outcome_rejected(
                d: rust_rec_nine_eval_diagnostic(
                  reason: ^rust_rec_nine_eval_args_bad,
                  node: node
                )
              )
          }
        } else {
          outcome_rejected(
            d: rust_rec_nine_eval_diagnostic(
              reason: ^rust_rec_nine_eval_args_bad,
              node: node
            )
          )
        }
      } else {
        outcome_accepted(value: rust_rec_nine_eval_octet_value(n: 0))
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn rust_rec_nine_eval_choose_branch(
  node: Node,
  _value: RuntimeValue,
  _env: EvaluationEnvironment
) -> Outcome<Node> {
  outcome_rejected(
    d: rust_rec_nine_eval_diagnostic(reason: ^rust_rec_nine_eval_branch_miss, node: node)
  )
}

fn rust_rec_nine_eval_step_loop(
  node: Node,
  _env: EvaluationEnvironment
) -> Outcome<ControlTransfer> {
  outcome_rejected(
    d: rust_rec_nine_eval_diagnostic(reason: ^rust_rec_nine_eval_loop_miss, node: node)
  )
}

fn rust_rec_nine_eval_bind_value(
  _key: EnvironmentBindingKey,
  _value: RuntimeValue,
  env: EvaluationEnvironment
) -> Outcome<EvaluationEnvironment> {
  outcome_accepted(value: env)
}

fn rust_rec_nine_eval_choose_arm(
  node: Node,
  _scrutinee: RuntimeValue,
  _env: EvaluationEnvironment
) -> Outcome<Node> {
  outcome_rejected(
    d: rust_rec_nine_eval_diagnostic(reason: ^rust_rec_nine_eval_match_miss, node: node)
  )
}

fn rust_rec_nine_eval_interpretation() -> InterpretationAlgebra {
  InterpretationAlgebra {
    value: ValueInterpreter { allocate_literal: rust_rec_nine_eval_allocate_literal },
    transform: TransformInterpreter { call_primitive: rust_rec_nine_eval_call_primitive },
    branch: BranchInterpreter { choose_branch: rust_rec_nine_eval_choose_branch },
    loop: LoopInterpreter { step_loop: rust_rec_nine_eval_step_loop },
    bind: BindInterpreter { bind_value: rust_rec_nine_eval_bind_value },
    match: MatchInterpreter { choose_arm: rust_rec_nine_eval_choose_arm }
  }
}

fn rust_rec_nine_eval_structure_witness() -> InterpretationStructureWitness {
  InterpretationStructureWitness {
    allocate_literal: ^rust_rec_nine_eval_allocate_literal_sym,
    call_primitive: ^rust_rec_nine_eval_call_primitive_sym,
    choose_branch: ^rust_rec_nine_eval_choose_branch_sym,
    step_loop: ^rust_rec_nine_eval_step_loop_sym,
    bind_value: ^rust_rec_nine_eval_bind_value_sym,
    choose_arm: ^rust_rec_nine_eval_choose_arm_sym
  }
}

fn rust_rec_nine_eval_context() -> EvalContext {
  eval_context_with_semantics(
    runtime_identity: ^rust_rec_nine_eval_interpretation_pin,
    interpretation: rust_rec_nine_eval_interpretation(),
    structure_witness: rust_rec_nine_eval_structure_witness()
  )
}

fn rust_rec_nine_eval_claim(rhs_result_node: Node) -> TestClaim {
  EqualsClaim {
    label: "S2 F3: rust emit(record-construct.field) host-run == eval(construct-then-field-access) via shared octet codec",
    anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
    lhs: rhs_result_node,
    rhs: rhs_result_node,
    classification: TestClassification { tier: Tier3, layer: Integration }
  }
}

fn rust_rec_nine_eval_subject(tree: InferredTree) -> TestClaimEvalSubject<Node> {
  eval_test_claim_subject(
    claim: rust_rec_nine_eval_claim(rhs_result_node: rust_rec_nine_eval_subgraph_node),
    context: rust_rec_nine_eval_context(),
    tree: tree,
    evaluator_pin: ^rust_rec_nine_eval_evaluator_pin
  )
}

fn rust_rec_nine_eval_run(
  tree: InferredTree,
  target: TargetModel
) -> TestClaimRun<Node, RuntimeValue> {
  run_test_claim_emit_vs_eval(
    subject: rust_rec_nine_eval_subject(tree: tree),
    target: target
  )
}

fn rust_rec_nine_eval_verdict_is_pass(run: TestClaimRun<Node, RuntimeValue>) -> Bool {
  match run.verdict {
    Pass => true
    SemanticMismatch { actual: _, falsification: _ } => false
    BuildFailed { actual: _, diagnostic: _ } => false
    RunFailed { actual: _, diagnostic: _ } => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}

fn rust_rec_nine_eval_verdict_is_semantic_mismatch(run: TestClaimRun<Node, RuntimeValue>) -> Bool {
  match run.verdict {
    SemanticMismatch { actual: _, falsification: _ } => true
    Pass => false
    BuildFailed { actual: _, diagnostic: _ } => false
    RunFailed { actual: _, diagnostic: _ } => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}

test fn rust_record_construct_emit_host_equals_eval_holds() -> Bool {
  rust_rec_nine_eval_verdict_is_pass(
    run: rust_rec_nine_eval_run(
      tree: rust_rec_nine_eval_inferred_tree(),
      target: rust_rec_nine_target_model_staging()
    )
  )
}

test fn rust_record_construct_emit_host_wrong_field_refuses_holds() -> Bool {
  rust_rec_nine_eval_verdict_is_semantic_mismatch(
    run: rust_rec_nine_eval_run(
      tree: rust_rec_nine_eval_inferred_tree(),
      target: rust_rec_nine_wrong_field_target_model_staging()
    )
  )
}

test fn rust_record_construct_emit_host_equals_eval_all_holds() -> Bool {
  rust_record_construct_emit_host_equals_eval_holds()
    && rust_record_construct_emit_host_wrong_field_refuses_holds()
}
