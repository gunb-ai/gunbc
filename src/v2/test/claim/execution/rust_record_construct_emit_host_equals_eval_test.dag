module v2.test.execution.rust_record_construct_emit_host_equals_eval


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn rust_rec_nine_field_access_body_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: v2.std.node.Transform },
    children: [
      v2.std.node.Edge {
        label: Positional,
        target: v2.extdeps.languages.dag.dag_type_atom_node(identity: ^dag_token_dot)
      },
      v2.std.node.Edge {
        label: Positional,
        target: v2.extdeps.languages.dag.dag_rec_construct_body_fixture
      },
      v2.std.node.Edge {
        label: Positional,
        target: v2.extdeps.languages.dag.dag_type_atom_node(identity: ^dag_binding_rec_v)
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn rust_rec_nine_arrow_node() -> v2.std.node.Node {
  v2.extdeps.languages.dag.dag_arrow_with_body_node(
    domain: v2.extdeps.languages.dag.dag_pick_arrow_domain_conj_node(),
    return_type_binding: ^dag_binding_type_int,
    body: rust_rec_nine_field_access_body_node()
  )
}

data rust_rec_nine_eval_subgraph_node: v2.std.node.Node = rust_rec_nine_field_access_body_node()

fn rust_rec_nine_eval_generic_facts(node: v2.std.node.Node) -> v2.compiler.inferred_tree.InferredFacts {
  v2.test.lens_common.infer_fixture.claim_inferred_facts_from_nodes(
    resolved: node,
    algebra: v2.extdeps.languages.rust.rust_emit_host_runtime_primitive_type_node(),
    descent: v2.std.witness.Holds {
      value: v2.std.cardinality.TerminationProof {
        non_increasing: [],
        strict: v2.std.cardinality.RankingDimension { measured: ^rust_rec_nine_eval_generic_descent }
      }
    }
  )
}

fn rust_rec_nine_eval_composed_facts(key: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  v2.std.optional.optional_present(value: rust_rec_nine_eval_generic_facts(node: key))
}

fn rust_rec_nine_eval_inferred_tree() -> v2.compiler.inferred_tree.InferredTree {
  v2.compiler.inferred_tree.InferredTree {
    root: rust_rec_nine_arrow_node(),
    facts: std.types.Map { lookup: rust_rec_nine_eval_composed_facts }
  }
}

fn rust_rec_nine_eval_octet_value(n: Int) -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimePrimitive {
    value: v2.std.runtime.RuntimePrimitiveValue {
      primitive_type: v2.extdeps.languages.rust.rust_emit_host_runtime_primitive_type_node(),
      bytes: v2.compiler.emit_host.emit_host_octets_byte_string(octets: [0, n, 0, 0, 0])
    }
  }
}

fn rust_rec_nine_eval_diagnostic(reason: v2.std.node.Symbol, node: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: reason,
    at: v2.std.diagnostic.node_locus(node: node),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn rust_rec_nine_eval_field_index_from_transform(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<Int> {
  match v2.std.collection.list_at_optional(xs: v2.std.node_query.node_positional_child_targets(node: node), index: 2) {
    Present { value: field_node } =>
      match field_node.kind {
        TypeNode { connective: Atom { identity: id } } =>
          if id == ^dag_binding_rec_v {
            v2.std.diagnostic.outcome_accepted(0)
          } else {
            v2.std.diagnostic.outcome_rejected(
              d: rust_rec_nine_eval_diagnostic(
                reason: ^rust_rec_nine_eval_field_miss,
                node: node
              )
            )
          }
        _ =>
          v2.std.diagnostic.outcome_rejected(
            d: rust_rec_nine_eval_diagnostic(
              reason: ^rust_rec_nine_eval_field_miss,
              node: node
            )
          )
      }
    Absent =>
      v2.std.diagnostic.outcome_rejected(
        d: rust_rec_nine_eval_diagnostic(reason: ^rust_rec_nine_eval_field_miss, node: node)
      )
  }
}

fn rust_rec_nine_eval_allocate_literal(node: v2.std.node.Node, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  match node.kind {
    TypeNode { connective: Conj } =>
      v2.std.diagnostic.outcome_accepted(value: rust_rec_nine_eval_octet_value(n: 9))
    TypeNode { connective: Atom { identity: id } } =>
      if id == ^dag_binding_type_rec {
        v2.std.diagnostic.outcome_accepted(value: rust_rec_nine_eval_octet_value(n: 0))
      } else if id == ^dag_rec_lit_nine {
        v2.std.diagnostic.outcome_accepted(value: rust_rec_nine_eval_octet_value(n: 9))
      } else if id == ^dag_binding_rec_v {
        v2.std.diagnostic.outcome_accepted(value: rust_rec_nine_eval_octet_value(n: 0))
      } else {
        v2.std.diagnostic.outcome_rejected(
          d: rust_rec_nine_eval_diagnostic(
            reason: ^rust_rec_nine_eval_literal_miss,
            node: node
          )
        )
      }
    _ =>
      v2.std.diagnostic.outcome_rejected(
        d: rust_rec_nine_eval_diagnostic(
          reason: ^rust_rec_nine_eval_literal_miss,
          node: node
        )
      )
  }
}

fn rust_rec_nine_eval_call_primitive(
  node: v2.std.node.Node,
  args: std.types.List<v2.std.runtime.RuntimeValue>,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  match rust_rec_nine_eval_field_index_from_transform(node: node) {
    Accepted { value: field_index, diagnostics: _ } =>
      if field_index == 0 {
        if v2.std.algebra.length(xs: args) == 2 {
          match v2.std.collection.list_at_optional(xs: args, index: 0) {
            Present { value: base } => v2.std.diagnostic.outcome_accepted(value: base)
            Absent =>
              v2.std.diagnostic.outcome_rejected(
                d: rust_rec_nine_eval_diagnostic(
                  reason: ^rust_rec_nine_eval_args_bad,
                  node: node
                )
              )
          }
        } else {
          v2.std.diagnostic.outcome_rejected(
            d: rust_rec_nine_eval_diagnostic(
              reason: ^rust_rec_nine_eval_args_bad,
              node: node
            )
          )
        }
      } else {
        v2.std.diagnostic.outcome_accepted(value: rust_rec_nine_eval_octet_value(n: 0))
      }
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn rust_rec_nine_eval_choose_branch(
  node: v2.std.node.Node,
  _value: v2.std.runtime.RuntimeValue,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.outcome_rejected(
    d: rust_rec_nine_eval_diagnostic(reason: ^rust_rec_nine_eval_branch_miss, node: node)
  )
}

fn rust_rec_nine_eval_step_loop(
  node: v2.std.node.Node,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.ControlTransfer> {
  v2.std.diagnostic.outcome_rejected(
    d: rust_rec_nine_eval_diagnostic(reason: ^rust_rec_nine_eval_loop_miss, node: node)
  )
}

fn rust_rec_nine_eval_bind_value(
  _key: v2.std.runtime.EnvironmentBindingKey,
  _value: v2.std.runtime.RuntimeValue,
  env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.EvaluationEnvironment> {
  v2.std.diagnostic.outcome_accepted(value: env)
}

fn rust_rec_nine_eval_choose_arm(
  node: v2.std.node.Node,
  _scrutinee: v2.std.runtime.RuntimeValue,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.outcome_rejected(
    d: rust_rec_nine_eval_diagnostic(reason: ^rust_rec_nine_eval_match_miss, node: node)
  )
}

fn rust_rec_nine_eval_interpretation() -> v2.std.runtime.InterpretationAlgebra {
  v2.std.runtime.InterpretationAlgebra {
    value: v2.std.runtime.ValueInterpreter { allocate_literal: rust_rec_nine_eval_allocate_literal, identity: ^rust_rec_nine_eval_allocate_literal },
    transform: v2.std.runtime.TransformInterpreter { call_primitive: rust_rec_nine_eval_call_primitive, identity: ^rust_rec_nine_eval_call_primitive },
    branch: v2.std.runtime.BranchInterpreter { choose_branch: rust_rec_nine_eval_choose_branch, identity: ^rust_rec_nine_eval_choose_branch },
    loop: v2.std.runtime.LoopInterpreter { step_loop: rust_rec_nine_eval_step_loop, identity: ^rust_rec_nine_eval_step_loop },
    bind: v2.std.runtime.BindInterpreter { bind_value: rust_rec_nine_eval_bind_value, identity: ^rust_rec_nine_eval_bind_value },
    match: v2.std.runtime.MatchInterpreter { choose_arm: rust_rec_nine_eval_choose_arm, identity: ^rust_rec_nine_eval_choose_arm }
  }
}

fn rust_rec_nine_eval_structure_witness() -> v2.std.runtime.InterpretationStructureWitness {
  v2.std.runtime.InterpretationStructureWitness {
    allocate_literal: ^rust_rec_nine_eval_allocate_literal,
    call_primitive: ^rust_rec_nine_eval_call_primitive,
    choose_branch: ^rust_rec_nine_eval_choose_branch,
    step_loop: ^rust_rec_nine_eval_step_loop,
    bind_value: ^rust_rec_nine_eval_bind_value,
    choose_arm: ^rust_rec_nine_eval_choose_arm  }
}

fn rust_rec_nine_eval_context() -> v2.compiler.eval.EvalContext {
  v2.compiler.eval.eval_context_with_semantics(
    runtime_identity: ^rust_rec_nine_eval_interpretation_pin,
    interpretation: rust_rec_nine_eval_interpretation(),
    structure_witness: rust_rec_nine_eval_structure_witness()
  )
}

fn rust_rec_nine_eval_claim(rhs_result_node: v2.std.node.Node) -> v2.std.verification.TestClaim {
  v2.std.verification.EqualsClaim {
    label: "S2 F3: rust emit(record-construct.field) host-run == eval(construct-then-field-access) via shared octet codec",
    anchor: v2.std.verification.manual_claim_anchor(anchor: ManualAnchorAbsent),
    lhs: rhs_result_node,
    rhs: rhs_result_node,
    classification: v2.std.verification.TestClassification { tier: Tier3, layer: Integration }
  }
}

fn rust_rec_nine_eval_subject(tree: v2.compiler.inferred_tree.InferredTree) -> v2.compiler.eval.TestClaimEvalSubject<v2.std.node.Node> {
  v2.compiler.eval.eval_test_claim_subject(
    claim: rust_rec_nine_eval_claim(rhs_result_node: rust_rec_nine_eval_subgraph_node),
    context: rust_rec_nine_eval_context(),
    tree: tree,
    evaluator_pin: ^rust_rec_nine_eval_evaluator_pin
  )
}

fn rust_rec_nine_eval_run(
  tree: v2.compiler.inferred_tree.InferredTree,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue> {
  v2.compiler.emit_host.run_test_claim_emit_vs_eval(
    subject: rust_rec_nine_eval_subject(tree: tree),
    target: target
  )
}

fn rust_rec_nine_eval_verdict_is_pass(run: v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>) -> v2.std.logic.Bool {
  match run.verdict {
    Pass => true
    SemanticMismatch { actual: _, falsification: _ } => false
    BuildFailed { actual: _, diagnostic: _ } => false
    RunFailed { actual: _, diagnostic: _ } => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}

fn rust_rec_nine_eval_verdict_is_semantic_mismatch(run: v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>) -> v2.std.logic.Bool {
  match run.verdict {
    SemanticMismatch { actual: _, falsification: _ } => true
    Pass => false
    BuildFailed { actual: _, diagnostic: _ } => false
    RunFailed { actual: _, diagnostic: _ } => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}

test fn rust_record_construct_emit_host_equals_eval_holds() -> v2.std.logic.Bool {
  rust_rec_nine_eval_verdict_is_pass(
    run: rust_rec_nine_eval_run(
      tree: rust_rec_nine_eval_inferred_tree(),
      target: v2.extdeps.languages.rust_test.rust_rec_nine_target_model_staging()
    )
  )
}

test fn rust_record_construct_emit_host_wrong_field_refuses_holds() -> v2.std.logic.Bool {
  rust_rec_nine_eval_verdict_is_semantic_mismatch(
    run: rust_rec_nine_eval_run(
      tree: rust_rec_nine_eval_inferred_tree(),
      target: v2.extdeps.languages.rust_test.rust_rec_nine_wrong_field_target_model_staging()
    )
  )
}

