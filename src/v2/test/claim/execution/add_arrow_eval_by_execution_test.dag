test fn add_arrow_excess_body_red_holds() -> Bool {
  add_arrow_eval_run_passes(
    run: add_arrow_eval_run(
      callee: add_arrow_excess_body_arrow(),
      left_lex: "2",
      right_lex: "3",
      expected_lex: "5"
    )
  ) == false
}

fn add_arrow_excess_actual_executes_to_five() -> Bool {
  match table_fixture_add_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      match add_arrow_excess_actual_call_optional(callee: arrow) {
        Present { value: call_node } =>
          match add_arrow_eval_inferred_run_tree(
            callee: arrow,
            left_lex: "2",
            right_lex: "3",
            expected_lex: "5"
          ) {
            Accepted { value: tree, diagnostics: _ } =>
              match eval(
                tree: tree,
                interpretation: v2_evaluator_interpretation(),
                inputs: inputs_root_only(root: call_node)
              ) {
                Accepted { value: actual, diagnostics: None } =>
                  add_arrow_eval_runtime_value_is_n(value: actual, n: 5)
                _ => false
              }
            Rejected { diagnostics: _ } => false
          }
        Absent => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn add_arrow_excess_actual_red_holds() -> Bool {
  add_arrow_excess_actual_executes_to_five() == false
}

