    interpretation: add_arrow_eval_lazy_arm_interpretation(),
    inputs: inputs_root_only(root: branch)
  ) {
    Accepted { value: v, diagnostics: _ } =>
      add_arrow_eval_runtime_int_equals(value: v, n: 5)
    Rejected { diagnostics: _ } => false
  }
}

fn add_arrow_eval_step_loop_continue(node: Node, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.ControlTransfer> {
  outcome_accepted(value: v2.std.runtime.Continue { value: add_arrow_eval_int_runtime_value(n: 5) })
}

fn add_arrow_eval_lazy_arm_loop_interpretation() -> v2.std.runtime.InterpretationAlgebra {
  v2.std.runtime.InterpretationAlgebra {
    value: v2.std.runtime.ValueInterpreter { allocate_literal: v2_eval_allocate_literal },
    transform: v2.std.runtime.TransformInterpreter { call_primitive: add_arrow_eval_call_primitive },
    branch: v2.std.runtime.BranchInterpreter { choose_branch: add_arrow_eval_choose_first_arm },
    loop: v2.std.runtime.LoopInterpreter { step_loop: add_arrow_eval_step_loop_continue },
    bind: v2.std.runtime.BindInterpreter { bind_value: add_arrow_eval_bind_value },
    match: v2.std.runtime.MatchInterpreter { choose_arm: runtime_reject_match_arm }
  }
}

fn add_arrow_eval_lazy_arm_loop_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: Loop },
    occurrence_id: SyntheticOccurrence,
    children: [
      v2.std.node.Edge { label: Positional, target: add_arrow_eval_atom(s: ^add_arrow_eval_unknown_arm_literal) },
      v2.std.node.Edge {
        label: Named { name: ^loop_bound_edge },
        target: add_arrow_eval_atom(s: ^add_arrow_eval_loop_measure_literal)
      }
    ]
  }
}

fn add_arrow_eval_loop_admitted_tree(root: Node) -> v2.compiler.infer.InferredTree {
  v2.compiler.infer.InferredTree {
    root: root,
    facts: std.types.Map {
      lookup: fn(key) {
        match key.kind {
          ComputationNode { behavior: Loop } =>
            Present {
              value: claim_inferred_facts_from_nodes(
                resolved: key,
                algebra: add_arrow_eval_i64_node(),
                descent: v2.std.witness.Holds {
                  value: v2.std.cardinality.TerminationProof {
                    non_increasing: [],
                    strict: v2.std.cardinality.RankingDimension {
                      measured: ^add_arrow_eval_loop_measure_literal
                    }
                  }
                }
              )
            }
          _ =>
            add_arrow_eval_facts_lookup(key: key)
        }
      }
    }
  }
}

test fn add_arrow_eval_lazy_arm_loop_suppression_holds() -> Bool {
  let loop_node = add_arrow_eval_lazy_arm_loop_node()
  let tree = add_arrow_eval_loop_admitted_tree(root: loop_node)
  match eval(
