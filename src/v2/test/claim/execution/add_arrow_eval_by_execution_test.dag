  match add_arrow_source_ingested_add_infers() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn add_arrow_eval_canonical_tree_infers_holds() -> Bool {
  match table_fixture_add_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      match add_arrow_eval_inferred_run_tree(
        callee: arrow,
        left_lex: "2",
        right_lex: "3",
        expected_lex: "5"
      ) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn add_arrow_eval_runtime_value_is_n(value: v2.std.runtime.RuntimeValue, n: Int) -> Bool {
  add_arrow_eval_runtime_int_equals(value: value, n: n)
}

test fn add_arrow_eval_direct_runtime_holds() -> Bool {
  match table_fixture_add_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      match add_arrow_eval_add_call_optional(callee: arrow, left_lex: "2", right_lex: "3") {
        Present { value: call_node } =>
          match add_arrow_eval_inferred_run_tree(
            callee: arrow,
            left_lex: "2",
            right_lex: "3",
            expected_lex: "5"
          ) {
            Accepted { value: tree, diagnostics: _ } =>
              match eval(
                tree: tree,
                interpretation: v2_evaluator_interpretation(),
                inputs: inputs_root_only(root: call_node)
              ) {
                Accepted { value: actual, diagnostics: None } =>
                  add_arrow_eval_runtime_value_is_n(value: actual, n: 5)
                _ => false
              }
            Rejected { diagnostics: _ } => false
          }
        Absent => false
      }
    Rejected { diagnostics: _ } => false
  }
}

