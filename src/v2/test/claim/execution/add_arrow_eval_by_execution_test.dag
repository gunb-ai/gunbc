}

fn add_arrow_excess_actual_call_optional(callee: Node) -> Optional<Node> {
  match add_arrow_eval_int_literal_optional(lexeme: "2") {
    Present { value: two_lit } =>
      match add_arrow_eval_int_literal_optional(lexeme: "3") {
        Present { value: three_lit } =>
          Present {
            value: v2.std.node.Node {
              kind: v2.std.node.ComputationNode { behavior: Transform },
              occurrence_id: SyntheticOccurrence,
              children: [
                v2.std.node.Edge { label: Positional, target: callee },
                v2.std.node.Edge { label: Positional, target: two_lit },
                v2.std.node.Edge { label: Positional, target: three_lit },
                v2.std.node.Edge { label: Positional, target: two_lit }
              ]
            }
          }
        Absent => Absent
      }
    Absent => Absent
  }
}

fn add_arrow_eval_run_passes(run: v2.std.diagnostic.Outcome<TestClaimRun<Node, RuntimeValue>>) -> Bool {
  match run {
    Accepted { value: r, diagnostics: _ } =>
      match test_claim_run_verdict(run: r) {
        Pass => true
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

