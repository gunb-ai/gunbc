module v2.test.execution.add_arrow_eval_by_execution


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn add_arrow_eval_atom(s: v2.std.node.Symbol) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } },
    occurrence_id: SyntheticOccurrence,
    children: []
  }
}

fn add_arrow_eval_i64_node() -> Node {
  add_arrow_eval_atom(s: ^add_arrow_eval_i64)
}

fn add_arrow_eval_int_literal_optional(lexeme: String) -> Optional<Node> {
  match dag_int_literal_node_from_lexeme(lexeme: lexeme, occurrence_id: SyntheticOccurrence) {
    Accepted { value: node, diagnostics: _ } => Present { value: node }
    Rejected { diagnostics: _ } => Absent
  }
}

fn add_arrow_eval_runtime_int_equals(value: v2.std.runtime.RuntimeValue, n: Int) -> Bool {
  match value {
    RuntimePrimitive { value: p } =>
      match integer_signed_i32_le_bytes_to_int(bytes: p.bytes) {
        Accepted { value: magnitude, diagnostics: _ } => magnitude == n
        Rejected { diagnostics: _ } => false
      }
    _ => false
  }
}

fn add_arrow_eval_runtime_diagnostic(n: Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^add_arrow_eval_runtime_rejected,
    at: node_locus(node: n),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn add_arrow_eval_ordered_add_args(args: List<v2.std.runtime.RuntimeValue>) -> Bool {
  if count(args) == 2 {
    match list_at_optional(xs: args, index: 0) {
      Present { value: left } =>
        match list_at_optional(xs: args, index: 1) {
          Present { value: right } =>
            add_arrow_eval_runtime_int_equals(value: left, n: 2)
              && add_arrow_eval_runtime_int_equals(value: right, n: 3)
          Absent => false
        }
      Absent => false
    }
  } else {
    false
  }
}

fn add_arrow_eval_int_runtime_value(n: Int) -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimePrimitive {
    value: v2.std.runtime.RuntimePrimitiveValue {
      primitive_type: add_arrow_eval_i64_node(),
      bytes: integer_int_to_signed_i32_le_bytes(value: n)
    }
  }
}

fn add_arrow_eval_call_primitive(
  node: Node,
  args: List<v2.std.runtime.RuntimeValue>,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  if add_arrow_eval_ordered_add_args(args: args) {
    outcome_accepted(value: add_arrow_eval_int_runtime_value(n: 5))
  } else {
    outcome_rejected(d: add_arrow_eval_runtime_diagnostic(n: node))
  }
}

fn add_arrow_eval_choose_first_arm(node: Node, _value: v2.std.runtime.RuntimeValue, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<Node> {
  match list_at_optional(xs: node_positional_child_targets(node: node), index: 1) {
    Present { value: arm } => outcome_accepted(value: arm)
    Absent => outcome_rejected(d: add_arrow_eval_runtime_diagnostic(n: node))
  }
}

fn add_arrow_eval_lazy_arm_interpretation() -> v2.std.runtime.InterpretationAlgebra {
  v2.std.runtime.InterpretationAlgebra {
    value: v2.std.runtime.ValueInterpreter {
      allocate_literal: v2_eval_allocate_literal
    },
    transform: v2.std.runtime.TransformInterpreter {
      call_primitive: add_arrow_eval_call_primitive
    },
    branch: v2.std.runtime.BranchInterpreter {
      choose_branch: add_arrow_eval_choose_first_arm
    },
    loop: v2.std.runtime.LoopInterpreter {
      step_loop: add_arrow_eval_step_loop
    },
    bind: v2.std.runtime.BindInterpreter {
      bind_value: add_arrow_eval_bind_value
    },
    match: v2.std.runtime.MatchInterpreter {
      choose_arm: runtime_reject_match_arm
    }
  }
}

fn add_arrow_eval_lazy_arm_branch_node() -> Node {
  match add_arrow_eval_int_literal_optional(lexeme: "2") {
    Present { value: two_lit } =>
      match add_arrow_eval_int_literal_optional(lexeme: "5") {
        Present { value: five_lit } =>
          v2.std.node.Node {
            kind: v2.std.node.ComputationNode { behavior: Branch },
            occurrence_id: SyntheticOccurrence,
            children: [
              v2.std.node.Edge { label: Positional, target: two_lit },
              v2.std.node.Edge { label: Positional, target: five_lit },
              v2.std.node.Edge {
                label: Positional,
                target: add_arrow_eval_atom(s: ^add_arrow_eval_unknown_arm_literal)
              }
            ]
          }
        Absent =>
          add_arrow_eval_atom(s: ^add_arrow_eval_lazy_arm_branch_miss)
      }
    Absent =>
      add_arrow_eval_atom(s: ^add_arrow_eval_lazy_arm_branch_miss)
  }
}

fn add_arrow_eval_step_loop(node: Node, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.ControlTransfer> {
  outcome_rejected(d: add_arrow_eval_runtime_diagnostic(n: node))
}

fn add_arrow_eval_bind_value(
  key: v2.std.runtime.EnvironmentBindingKey,
  value: v2.std.runtime.RuntimeValue,
  env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.EvaluationEnvironment> {
  v2.std.diagnostic.Accepted {
    value: v2.std.runtime.EvaluationEnvironment {
      bindings: map_insert(m: env.bindings, key: key, value: value)
    },
    diagnostics: v2.std.diagnostic.None
  }
}

fn add_arrow_eval_context() -> v2.compiler.eval.EvalContext {
  eval_context_v4_evaluator()
}

fn add_arrow_eval_parse_tokens(tokens: v2.std.compilers.lexing.TokenStream) -> v2.std.diagnostic.Outcome<v2.std.grammar.ParseTree> {
  let lm = dag_language_model()
  bind_outcome(
    o: parse_module(tokens: tokens, grammar: lm.grammar),
    f: fn(artifact) {
      outcome_accepted(value: artifact.tree)
    }
  )
}

fn add_arrow_source_ingested_add_infers() -> v2.std.diagnostic.Outcome<v2.compiler.infer.InferredTree> {
  let lm = dag_language_model()
  bind_outcome(
    o: tokenize(text: ingested_add_module_source, file: ^add_arrow_eval_source_file, rules: lm.lex),
    f: fn(tokens) {
      bind_outcome(
        o: add_arrow_eval_parse_tokens(tokens: tokens),
        f: fn(parsed) {
          bind_outcome(
            o: normalize(parse_tree: parsed),
            f: fn(normalized) {
              bind_outcome(
                o: v2.compiler.resolve.resolve(tree: normalized, lm: lm),
                f: fn(resolved) {
                  outcome_accepted(value: add_arrow_eval_admitted_tree(root: resolved))
                }
              )
            }
          )
        }
      )
    }
  )
}

fn add_arrow_eval_tokenize_source() -> v2.std.diagnostic.Outcome<v2.std.compilers.lexing.TokenStream> {
  let lm = dag_language_model()
  tokenize(text: ingested_add_module_source, file: ^add_arrow_eval_source_file, rules: lm.lex)
}

test fn add_arrow_eval_tokenize_holds() -> Bool {
  match add_arrow_eval_tokenize_source() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn add_arrow_eval_parse_holds() -> Bool {
  match add_arrow_eval_tokenize_source() {
    Accepted { value: tokens, diagnostics: _ } =>
      match add_arrow_eval_parse_tokens(tokens: tokens) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn add_arrow_eval_normalize_holds() -> Bool {
  match add_arrow_eval_tokenize_source() {
    Accepted { value: tokens, diagnostics: _ } =>
      match add_arrow_eval_parse_tokens(tokens: tokens) {
        Accepted { value: parsed, diagnostics: _ } =>
          match normalize(parse_tree: parsed) {
            Accepted { value: _, diagnostics: _ } => true
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn add_arrow_eval_resolve_holds() -> Bool {
  let lm = dag_language_model()
  match add_arrow_eval_tokenize_source() {
    Accepted { value: tokens, diagnostics: _ } =>
      match add_arrow_eval_parse_tokens(tokens: tokens) {
        Accepted { value: parsed, diagnostics: _ } =>
          match normalize(parse_tree: parsed) {
            Accepted { value: normalized, diagnostics: _ } =>
              match v2.compiler.resolve.resolve(tree: normalized, lm: lm) {
                Accepted { value: _, diagnostics: _ } => true
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn add_arrow_eval_add_call_optional(
  callee: Node,
  left_lex: String,
  right_lex: String
) -> Optional<Node> {
  match add_arrow_eval_int_literal_optional(lexeme: left_lex) {
    Present { value: left } =>
      match add_arrow_eval_int_literal_optional(lexeme: right_lex) {
        Present { value: right } =>
          Present {
            value: v2.std.node.Node {
              kind: v2.std.node.ComputationNode { behavior: Transform },
              occurrence_id: SyntheticOccurrence,
              children: [
                v2.std.node.Edge { label: Positional, target: callee },
                v2.std.node.Edge { label: Positional, target: left },
                v2.std.node.Edge { label: Positional, target: right }
              ]
            }
          }
        Absent => Absent
      }
    Absent => Absent
  }
}

fn add_arrow_eval_tree_root(call: Node, expected: Node) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    occurrence_id: SyntheticOccurrence,
    children: [
      v2.std.node.Edge { label: Named { name: ^add_arrow_eval_actual }, target: call },
      v2.std.node.Edge { label: Named { name: ^add_arrow_eval_expected }, target: expected }
    ]
  }
}

fn add_arrow_eval_facts_lookup(key: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  optional_present(value: claim_inferred_facts_from_nodes(
      resolved: key,
      algebra: add_arrow_eval_i64_node(),
      descent: termination_proof_witness_for_node(n: key)
    ))
}

fn add_arrow_eval_admitted_tree(root: Node) -> v2.compiler.infer.InferredTree {
  v2.compiler.infer.InferredTree {
    root: root,
    facts: std.types.Map {
      lookup: add_arrow_eval_facts_lookup
    }
  }
}

fn add_arrow_eval_inferred_run_tree(
  callee: Node,
  left_lex: String,
  right_lex: String,
  expected_lex: String
) -> v2.std.diagnostic.Outcome<v2.compiler.infer.InferredTree> {
  match add_arrow_eval_add_call_optional(callee: callee, left_lex: left_lex, right_lex: right_lex) {
    Present { value: call } =>
      match add_arrow_eval_int_literal_optional(lexeme: expected_lex) {
        Present { value: expected } => {
          let root = add_arrow_eval_tree_root(call: call, expected: expected)
          outcome_accepted(value: add_arrow_eval_admitted_tree(root: root))
        }
        Absent =>
          outcome_rejected(
            d: add_arrow_eval_runtime_diagnostic(
              n: add_arrow_eval_atom(s: ^add_arrow_eval_literal_miss)
            )
          )
      }
    Absent =>
      outcome_rejected(
        d: add_arrow_eval_runtime_diagnostic(
          n: add_arrow_eval_atom(s: ^add_arrow_eval_literal_miss)
        )
      )
  }
}

fn add_arrow_eval_claim(input: Node, expected: Node) -> v2.std.verification.TestClaim {
  v2.std.verification.CompilesClaim {
    label: "manual/add_arrow: source-bridged add Arrow.body executes through eval callee dispatch",
    anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
    input: input,
    expected_value: expected,
    classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
  }
}

fn add_arrow_eval_subject(tree: v2.compiler.infer.InferredTree, input: Node, expected: Node) -> TestClaimEvalSubject<Node> {
  v2.compiler.eval.TestClaimEvalSubject {
    claim: add_arrow_eval_claim(input: input, expected: expected),
    context: add_arrow_eval_context(),
    tree: tree,
    input: test_claim_typed_input_node(
      evaluator_input: input,
      evaluator_pin: ^add_arrow_eval_add_call_pin
    )
  }
}

fn add_arrow_eval_run(
  callee: Node,
  left_lex: String,
  right_lex: String,
  expected_lex: String
) -> v2.std.diagnostic.Outcome<TestClaimRun<Node, RuntimeValue>> {
  match add_arrow_eval_add_call_optional(
    callee: callee,
    left_lex: left_lex,
    right_lex: right_lex
  ) {
    Present { value: call_node } =>
      match add_arrow_eval_int_literal_optional(lexeme: expected_lex) {
        Present { value: expected } =>
          bind_outcome(
            o: add_arrow_eval_inferred_run_tree(
              callee: callee,
              left_lex: left_lex,
              right_lex: right_lex,
              expected_lex: expected_lex
            ),
            f: fn(tree) {
              outcome_accepted(
                value: run_test_claim(
                  subject: add_arrow_eval_subject(tree: tree, input: call_node, expected: expected)
                )
              )
            }
          )
        Absent =>
          outcome_rejected(
            d: add_arrow_eval_runtime_diagnostic(
              n: add_arrow_eval_atom(s: ^add_arrow_eval_literal_miss)
            )
          )
      }
    Absent =>
      outcome_rejected(
        d: add_arrow_eval_runtime_diagnostic(
          n: add_arrow_eval_atom(s: ^add_arrow_eval_literal_miss)
        )
      )
  }
}

fn add_arrow_swapped_operand_body() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: Transform },
    occurrence_id: SyntheticOccurrence,
    children: [
      v2.std.node.Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_token_plus) },
      v2.std.node.Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_param_y) },
      v2.std.node.Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_param_x) }
    ]
  }
}

fn add_arrow_swapped_add_arrow() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Arrow },
    occurrence_id: SyntheticOccurrence,
    children: [
      v2.std.node.Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_type_int) },
      v2.std.node.Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_type_int) },
      v2.std.node.Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_type_int) },
      v2.std.node.Edge { label: Named { name: ^arrow_body_edge }, target: add_arrow_swapped_operand_body() }
    ]
  }
}

fn add_arrow_excess_signature_arrow() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Arrow },
    occurrence_id: SyntheticOccurrence,
    children: [
      v2.std.node.Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_type_int) },
      v2.std.node.Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_type_int) },
      v2.std.node.Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_type_int) },
      v2.std.node.Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_type_int) },
      v2.std.node.Edge { label: Named { name: ^arrow_body_edge }, target: add_arrow_eval_canonical_body() }
    ]
  }
}

fn add_arrow_eval_canonical_body() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: Transform },
    occurrence_id: SyntheticOccurrence,
    children: [
      v2.std.node.Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_token_plus) },
      v2.std.node.Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_param_x) },
      v2.std.node.Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_param_y) }
    ]
  }
}

fn add_arrow_excess_body_arrow() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Arrow },
    occurrence_id: SyntheticOccurrence,
    children: [
      v2.std.node.Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_type_int) },
      v2.std.node.Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_type_int) },
      v2.std.node.Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_type_int) },
      v2.std.node.Edge { label: Named { name: ^arrow_body_edge }, target: add_arrow_excess_body() }
    ]
  }
}

fn add_arrow_excess_body() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: Transform },
    occurrence_id: SyntheticOccurrence,
    children: [
      v2.std.node.Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_token_plus) },
      v2.std.node.Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_param_x) },
      v2.std.node.Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_param_y) },
      v2.std.node.Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_param_x) }
    ]
