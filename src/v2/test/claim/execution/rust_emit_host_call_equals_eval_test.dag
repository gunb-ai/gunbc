module v2.test.execution.rust_emit_host_call_equals_eval

import v2.compiler.emit_host {
  emit_host_octets_byte_string,
  run_test_claim_emit_vs_eval
}
import v2.compiler.eval {
  EvalContext,
  TestClaimEvalSubject,
  TestClaimRun,
  eval,
  eval_context_interpretation,
  eval_context_with_semantics,
  eval_test_claim_subject,
  inputs_root_only
}
import v2.compiler.infer { InferredFacts, InferredTree }
import v2.extdeps.languages.rust { rust_emit_host_runtime_primitive_type_node }
import v2.extdeps.languages.rust_test { rust_call_target_model_staging }
import v2.test.emit.rust_call_emit {
  rust_call_facts_miss,
  rust_call_helper_arrow,
  rust_call_helper_eval_subgraph
}
import v2.test.lens_common.infer_fixture { claim_inferred_facts_from_nodes }
import v2.std.cardinality { RankingDimension, TerminationProof }
import v2.std.collection { Optional, Present, Absent, List, Map }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  diagnostics_singleton,
  node_locus,
  outcome_accepted
}
import v2.std.logic { Bool }
import v2.std.node { Node, Symbol }
import v2.std.runtime {
  BindInterpreter,
  BranchInterpreter,
  ControlTransfer,
  EnvironmentBindingKey,
  EvaluationEnvironment,
  InterpretationAlgebra,
  InterpretationStructureWitness,
  LoopInterpreter,
  RuntimePrimitive,
  RuntimePrimitiveValue,
  RuntimeValue,
  TransformInterpreter,
  ValueInterpreter,
  MatchInterpreter,
  runtime_reject_match_arm
}
import v2.std.verdict { BuildFailed, Deferred, Pass, RunFailed, SemanticMismatch, Verdict }
import v2.std.verification {
  EqualsClaim,
  Integration,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier3,
  manual_claim_anchor
}
import v2.std.witness { Holds, Witness }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn emit_call_eval_octet_value(n: Int) -> RuntimeValue {
  RuntimePrimitive {
    value: RuntimePrimitiveValue {
      primitive_type: rust_emit_host_runtime_primitive_type_node(),
      bytes: emit_host_octets_byte_string(octets: [0, n, 0, 0, 0])
    }
  }
}

fn emit_call_eval_diagnostic(reason: Symbol, node: Node) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn emit_call_eval_allocate_literal(_node: Node, _env: EvaluationEnvironment) -> Outcome<RuntimeValue> {
  outcome_accepted(value: emit_call_eval_octet_value(n: 3))
}

fn emit_call_eval_call_primitive_seven(
  _node: Node,
  _args: List<RuntimeValue>,
  _env: EvaluationEnvironment
) -> Outcome<RuntimeValue> {
  outcome_accepted(value: emit_call_eval_octet_value(n: 7))
}

fn emit_call_eval_call_primitive_eight(
  _node: Node,
  _args: List<RuntimeValue>,
  _env: EvaluationEnvironment
) -> Outcome<RuntimeValue> {
  outcome_accepted(value: emit_call_eval_octet_value(n: 8))
}

fn emit_call_eval_choose_branch(
  _node: Node,
  _value: RuntimeValue,
  _env: EvaluationEnvironment
) -> Outcome<Node> {
  Rejected {
    diagnostics: diagnostics_singleton(
      d: emit_call_eval_diagnostic(
        reason: ^emit_call_eval_branch_miss,
        node: rust_call_helper_eval_subgraph
      )
    )
  }
}

fn emit_call_eval_step_loop(
  _node: Node,
  _env: EvaluationEnvironment
) -> Outcome<ControlTransfer> {
  Rejected {
    diagnostics: diagnostics_singleton(
      d: emit_call_eval_diagnostic(
        reason: ^emit_call_eval_loop_miss,
        node: rust_call_helper_eval_subgraph
      )
    )
  }
}

fn emit_call_eval_bind_value(
  _key: EnvironmentBindingKey,
  _value: RuntimeValue,
  env: EvaluationEnvironment
) -> Outcome<EvaluationEnvironment> {
  outcome_accepted(value: env)
}

fn emit_call_eval_interpretation(
  call_primitive: fn(Node, List<RuntimeValue>, EvaluationEnvironment) -> Outcome<RuntimeValue>
) -> InterpretationAlgebra {
  InterpretationAlgebra {
    value: ValueInterpreter { allocate_literal: emit_call_eval_allocate_literal },
    transform: TransformInterpreter { call_primitive: call_primitive },
    branch: BranchInterpreter { choose_branch: emit_call_eval_choose_branch },
    loop: LoopInterpreter { step_loop: emit_call_eval_step_loop },
    bind: BindInterpreter { bind_value: emit_call_eval_bind_value },
    match: MatchInterpreter {
      choose_arm: runtime_reject_match_arm
    }
  }
}

fn emit_call_eval_structure_witness() -> InterpretationStructureWitness {
  InterpretationStructureWitness {
    allocate_literal: ^emit_call_eval_allocate_literal_sym,
    call_primitive: ^emit_call_eval_call_primitive_sym,
    choose_branch: ^emit_call_eval_choose_branch_sym,
    step_loop: ^emit_call_eval_step_loop_sym,
    bind_value: ^emit_call_eval_bind_value_sym,
    choose_arm: ^runtime_reject_match_arm
  }
}

fn emit_call_eval_context(
  call_primitive: fn(Node, List<RuntimeValue>, EvaluationEnvironment) -> Outcome<RuntimeValue>
) -> EvalContext {
  eval_context_with_semantics(
    runtime_identity: ^emit_call_eval_interpretation_pin,
    interpretation: emit_call_eval_interpretation(call_primitive: call_primitive),
    structure_witness: emit_call_eval_structure_witness()
  )
}

fn emit_call_eval_generic_facts(node: Node) -> InferredFacts {
  claim_inferred_facts_from_nodes(
    resolved: node,
    algebra: rust_emit_host_runtime_primitive_type_node(),
    descent: Holds {
      value: v2.std.cardinality.TerminationProof {
        non_increasing: [],
        strict: v2.std.cardinality.RankingDimension { measured: ^emit_call_eval_generic_descent }
      }
    }
  )
}

fn emit_call_eval_composed_facts(key: Node) -> Optional<InferredFacts> {
  match rust_call_facts_miss(key: key) {
    Holds { value: f } => Present { value: f }
    Violates { diagnostic: _ } => Present { value: emit_call_eval_generic_facts(node: key) }
  }
}

fn emit_call_eval_producer_tree() -> InferredTree {
  InferredTree {
    root: rust_call_helper_arrow(),
    facts: Map { lookup: emit_call_eval_composed_facts }
  }
}

fn emit_call_eval_claim(rhs_result_node: Node) -> TestClaim {
  EqualsClaim {
    label: "S2 F2: rust emit(call-fn) host-run == eval(call-subgraph) via shared octet codec",
    anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
    lhs: rhs_result_node,
    rhs: rhs_result_node,
    classification: TestClassification { tier: Tier3, layer: Integration }
  }
}

fn emit_call_eval_subject(
  call_primitive: fn(Node, List<RuntimeValue>, EvaluationEnvironment) -> Outcome<RuntimeValue>
) -> TestClaimEvalSubject<Node> {
  eval_test_claim_subject(
    claim: emit_call_eval_claim(rhs_result_node: rust_call_helper_eval_subgraph),
    context: emit_call_eval_context(call_primitive: call_primitive),
    tree: emit_call_eval_producer_tree(),
    evaluator_pin: ^emit_call_eval_evaluator_pin
  )
}

fn emit_call_eval_run(
  call_primitive: fn(Node, List<RuntimeValue>, EvaluationEnvironment) -> Outcome<RuntimeValue>
) -> TestClaimRun<Node, RuntimeValue> {
  run_test_claim_emit_vs_eval(
    subject: emit_call_eval_subject(call_primitive: call_primitive),
    target: rust_call_target_model_staging()
  )
}

fn emit_call_eval_verdict_is_pass(run: TestClaimRun<Node, RuntimeValue>) -> Bool {
  match run.verdict {
    Pass => true
    SemanticMismatch { actual: _, falsification: _ } => false
    BuildFailed { actual: _, diagnostic: _ } => false
    RunFailed { actual: _, diagnostic: _ } => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}

fn emit_call_eval_verdict_is_semantic_mismatch(run: TestClaimRun<Node, RuntimeValue>) -> Bool {
  match run.verdict {
    SemanticMismatch { actual: _, falsification: _ } => true
    Pass => false
    BuildFailed { actual: _, diagnostic: _ } => false
    RunFailed { actual: _, diagnostic: _ } => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}

test fn rust_emit_host_call_eval_subgraph_holds() -> Bool {
  match eval(
    tree: emit_call_eval_producer_tree(),
    interpretation: emit_call_eval_interpretation(
      call_primitive: emit_call_eval_call_primitive_seven
    ),
    inputs: inputs_root_only(root: rust_call_helper_eval_subgraph)
  ) {
    Accepted { value: v, diagnostics: d } =>
      (v == emit_call_eval_octet_value(n: 7)) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn rust_emit_host_call_equals_eval_holds() -> Bool {
  emit_call_eval_verdict_is_pass(
    run: emit_call_eval_run(call_primitive: emit_call_eval_call_primitive_seven)
  )
}

test fn rust_emit_host_call_wrong_oracle_refuses_holds() -> Bool {
  emit_call_eval_verdict_is_semantic_mismatch(
    run: emit_call_eval_run(call_primitive: emit_call_eval_call_primitive_eight)
  )
}

test fn rust_emit_host_call_equals_eval_all_holds() -> Bool {
  rust_emit_host_call_equals_eval_holds() && rust_emit_host_call_wrong_oracle_refuses_holds()
}
