module v2.test.execution.rust_emit_host_call_equals_eval


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn emit_call_eval_octet_value(n: Int) -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimePrimitive {
    value: v2.std.runtime.RuntimePrimitiveValue {
      primitive_type: v2.extdeps.languages.rust.rust_emit_host_runtime_primitive_type_node(),
      bytes: v2.compiler.emit_host.emit_host_octets_byte_string(octets: [0, n, 0, 0, 0])
    }
  }
}

fn emit_call_eval_diagnostic(reason: v2.std.node.Symbol, node: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: reason,
    at: v2.std.diagnostic.node_locus(node: node),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn emit_call_eval_allocate_literal(_node: v2.std.node.Node, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.outcome_accepted(value: emit_call_eval_octet_value(n: 3))
}

fn emit_call_eval_call_primitive_seven(
  _node: v2.std.node.Node,
  _args: List<v2.std.runtime.RuntimeValue>,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.outcome_accepted(value: emit_call_eval_octet_value(n: 7))
}

fn emit_call_eval_call_primitive_eight(
  _node: v2.std.node.Node,
  _args: List<v2.std.runtime.RuntimeValue>,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.outcome_accepted(value: emit_call_eval_octet_value(n: 8))
}

fn emit_call_eval_choose_branch(
  _node: v2.std.node.Node,
  _value: v2.std.runtime.RuntimeValue,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.Rejected {
    diagnostics: v2.std.diagnostic.diagnostics_singleton(
      d: emit_call_eval_diagnostic(
        reason: ^emit_call_eval_branch_miss,
        node: v2.test.emit.rust_call_emit.rust_call_helper_eval_subgraph
      )
    )
  }
}

fn emit_call_eval_step_loop(
  _node: v2.std.node.Node,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.ControlTransfer> {
  v2.std.diagnostic.Rejected {
    diagnostics: v2.std.diagnostic.diagnostics_singleton(
      d: emit_call_eval_diagnostic(
        reason: ^emit_call_eval_loop_miss,
        node: v2.test.emit.rust_call_emit.rust_call_helper_eval_subgraph
      )
    )
  }
}

fn emit_call_eval_bind_value(
  _key: v2.std.runtime.EnvironmentBindingKey,
  _value: v2.std.runtime.RuntimeValue,
  env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.EvaluationEnvironment> {
  v2.std.diagnostic.outcome_accepted(value: env)
}

fn emit_call_eval_interpretation(
  call_primitive: fn(v2.std.node.Node, List<v2.std.runtime.RuntimeValue>, v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue>,
  call_primitive_identity: v2.std.node.Symbol
) -> v2.std.runtime.InterpretationAlgebra {
  v2.std.runtime.InterpretationAlgebra {
    value: v2.std.runtime.ValueInterpreter { allocate_literal: emit_call_eval_allocate_literal, identity: ^emit_call_eval_allocate_literal },
    transform: v2.std.runtime.TransformInterpreter { call_primitive: call_primitive, identity: call_primitive_identity },
    branch: v2.std.runtime.BranchInterpreter { choose_branch: emit_call_eval_choose_branch, identity: ^emit_call_eval_choose_branch },
    loop: v2.std.runtime.LoopInterpreter { step_loop: emit_call_eval_step_loop, identity: ^emit_call_eval_step_loop },
    bind: v2.std.runtime.BindInterpreter { bind_value: emit_call_eval_bind_value, identity: ^emit_call_eval_bind_value },
    match: v2.std.runtime.MatchInterpreter {
      choose_arm: v2.std.runtime.runtime_reject_match_arm,
      identity: ^runtime_reject_match_arm    }
  }
}

fn emit_call_eval_structure_witness(call_primitive_identity: v2.std.node.Symbol) -> v2.std.runtime.InterpretationStructureWitness {
  v2.std.runtime.InterpretationStructureWitness {
    allocate_literal: ^emit_call_eval_allocate_literal,
    call_primitive: call_primitive_identity,
    choose_branch: ^emit_call_eval_choose_branch,
    step_loop: ^emit_call_eval_step_loop,
    bind_value: ^emit_call_eval_bind_value,    choose_arm: ^runtime_reject_match_arm
  }
}

fn emit_call_eval_context(
  call_primitive: fn(v2.std.node.Node, List<v2.std.runtime.RuntimeValue>, v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue>,
  call_primitive_identity: v2.std.node.Symbol
) -> v2.compiler.eval.EvalContext {  v2.compiler.eval.eval_context_with_semantics(
    runtime_identity: ^emit_call_eval_interpretation_pin,
    interpretation: emit_call_eval_interpretation(call_primitive: call_primitive, call_primitive_identity: call_primitive_identity),
    structure_witness: emit_call_eval_structure_witness(call_primitive_identity: call_primitive_identity)
  )
}

fn emit_call_eval_generic_facts(node: v2.std.node.Node) -> v2.compiler.inferred_tree.InferredFacts {
  v2.test.lens_common.infer_fixture.claim_inferred_facts_from_nodes(
    resolved: node,
    algebra: v2.extdeps.languages.rust.rust_emit_host_runtime_primitive_type_node(),
    descent: v2.std.witness.Holds {
      value: v2.std.cardinality.TerminationProof {
        non_increasing: [],
        strict: v2.std.cardinality.RankingDimension { measured: ^emit_call_eval_generic_descent }
      }
    }
  )
}

fn emit_call_eval_composed_facts(key: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  match v2.test.emit.rust_call_emit.rust_call_facts_miss(key: key) {
    Present { value: f } => v2.std.optional.optional_present(value: f)
    Absent => v2.std.optional.optional_present(value: emit_call_eval_generic_facts(node: key))
  }
}

fn emit_call_eval_producer_tree() -> v2.compiler.inferred_tree.InferredTree {
  v2.compiler.inferred_tree.InferredTree {
    test.claim.extdeps_llm_claude_trust_witness.root: v2.test.emit.rust_call_emit.rust_call_helper_arrow(),
    facts: std.algebra.PartialFunction { lookup: emit_call_eval_composed_facts }
  }
}

fn emit_call_eval_claim(rhs_result_node: v2.std.node.Node) -> v2.std.verification.TestClaim {
  v2.std.verification.EqualsClaim {
    label: "S2 F2: rust emit(call-fn) host-run == eval(call-subgraph) via shared octet codec",
    anchor: v2.std.verification.manual_claim_anchor(anchor: ManualAnchorAbsent),
    lhs: rhs_result_node,
    rhs: rhs_result_node,
    classification: v2.std.verification.TestClassification { tier: Tier3, layer: Integration }
  }
}

fn emit_call_eval_subject(
  call_primitive: fn(v2.std.node.Node, List<v2.std.runtime.RuntimeValue>, v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue>,
  call_primitive_identity: v2.std.node.Symbol
) -> v2.compiler.eval.TestClaimEvalSubject<v2.std.node.Node> {
  v2.compiler.eval.eval_test_claim_subject(
    claim: emit_call_eval_claim(rhs_result_node: v2.test.emit.rust_call_emit.rust_call_helper_eval_subgraph),
    context: emit_call_eval_context(call_primitive: call_primitive, call_primitive_identity: call_primitive_identity),
    tree: emit_call_eval_producer_tree(),
    evaluator_pin: ^emit_call_eval_evaluator_pin
  )
}

fn emit_call_eval_run(
  call_primitive: fn(v2.std.node.Node, List<v2.std.runtime.RuntimeValue>, v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue>,
  call_primitive_identity: v2.std.node.Symbol
) -> v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue> {  v2.compiler.emit_host.run_test_claim_emit_vs_eval(
    subject: emit_call_eval_subject(call_primitive: call_primitive, call_primitive_identity: call_primitive_identity),
    target: v2.extdeps.languages.rust_test.rust_call_target_model_staging()
  )
}

fn emit_call_eval_verdict_is_pass(run: v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>) -> v2.std.logic.Bool {
  match run.verdict {
    Pass => true
    SemanticMismatch { actual: _, falsification: _ } => false
    BuildFailed { actual: _, diagnostic: _ } => false
    RunFailed { actual: _, diagnostic: _ } => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}

fn emit_call_eval_verdict_is_semantic_mismatch(run: v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>) -> v2.std.logic.Bool {
  match run.verdict {
    SemanticMismatch { actual: _, falsification: _ } => true
    Pass => false
    BuildFailed { actual: _, diagnostic: _ } => false
    RunFailed { actual: _, diagnostic: _ } => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}

test fn rust_emit_host_call_eval_subgraph_holds() -> v2.std.logic.Bool {
  match v2.compiler.eval.eval(
    tree: emit_call_eval_producer_tree(),
    interpretation: emit_call_eval_interpretation(
      call_primitive: emit_call_eval_call_primitive_seven,
      call_primitive_identity: ^emit_call_eval_call_primitive_seven
    ),
    inputs: v2.compiler.eval.inputs_root_only(root: v2.test.emit.rust_call_emit.rust_call_helper_eval_subgraph)
  ) {
    Accepted { value: v, diagnostics: d } =>
      (v == emit_call_eval_octet_value(n: 7)) && (d == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

test fn rust_emit_host_call_equals_eval_holds() -> v2.std.logic.Bool {
  emit_call_eval_verdict_is_pass(
    run: emit_call_eval_run(
      call_primitive: emit_call_eval_call_primitive_seven,
      call_primitive_identity: ^emit_call_eval_call_primitive_seven
    )
  )
}

test fn rust_emit_host_call_wrong_oracle_refuses_holds() -> v2.std.logic.Bool {
  emit_call_eval_verdict_is_semantic_mismatch(
    run: emit_call_eval_run(
      call_primitive: emit_call_eval_call_primitive_eight,
      call_primitive_identity: ^emit_call_eval_call_primitive_eight
    )
  )
}

