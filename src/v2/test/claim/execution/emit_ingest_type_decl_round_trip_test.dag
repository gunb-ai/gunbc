module v2.test.execution.emit_ingest_type_decl_round_trip

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data type_decl_round_trip_foreign_binding: v2.std.node.Symbol = ^type_decl_round_trip_foreign_binding
data type_decl_round_trip_source_file: v2.std.node.Symbol = ^type_decl_round_trip_source_file

data type_decl_point_source_text: String = "type Point { x: Int, y: Int }"
data type_decl_pixel_source_text: String = "type Pixel { px: Int, py: Int }"

fn type_decl_rules() -> v2.std.node.Node {
  v2.extdeps.languages.dag.dag_type_decl_productions_only_translation_rules()
}

fn type_decl_target() -> v2.std.compilers.target_model.TargetModel {
  v2.extdeps.languages.dag.dag_type_decl_structural_target_model()
}

fn type_decl_interned_symbol(spelling: String) -> v2.std.node.Symbol {
  spelling
}

fn type_decl_qualified_name_emitted(name: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: v2.extdeps.languages.dag.dag_inhabitant_atom(id: name) }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn type_decl_type_expr_emitted(type_name: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: type_decl_qualified_name_emitted(name: type_name)
      }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn type_decl_field_list_suffix_empty() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn type_decl_two_field_list_emitted(
  f1: v2.std.node.Symbol,
  t1: v2.std.node.Symbol,
  f2: v2.std.node.Symbol,
  t2: v2.std.node.Symbol
) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: v2.extdeps.languages.dag.dag_inhabitant_atom(id: f1) },
      v2.std.node.Edge { label: v2.std.node.Positional, target: type_decl_type_expr_emitted(type_name: t1) },
      v2.std.node.Edge { label: v2.std.node.Positional, target: v2.extdeps.languages.dag.dag_inhabitant_atom(id: f2) },
      v2.std.node.Edge { label: v2.std.node.Positional, target: type_decl_type_expr_emitted(type_name: t2) },
      v2.std.node.Edge { label: v2.std.node.Positional, target: type_decl_field_list_suffix_empty() }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn type_decl_field_block_emitted(fields: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: fields }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn type_decl_record_emitted(name: v2.std.node.Symbol, fields: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: v2.extdeps.languages.dag.dag_inhabitant_atom(id: name) },
      v2.std.node.Edge { label: v2.std.node.Positional, target: type_decl_field_block_emitted(fields: fields) }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn type_decl_point_emitted() -> v2.std.node.Node {
  type_decl_record_emitted(
    name: type_decl_interned_symbol(spelling: "Point"),
    fields: type_decl_two_field_list_emitted(
      f1: type_decl_interned_symbol(spelling: "x"),
      t1: type_decl_interned_symbol(spelling: "Int"),
      f2: type_decl_interned_symbol(spelling: "y"),
      t2: type_decl_interned_symbol(spelling: "Int")
    )
  )
}

fn type_decl_pixel_emitted() -> v2.std.node.Node {
  type_decl_record_emitted(
    name: type_decl_interned_symbol(spelling: "Pixel"),
    fields: type_decl_two_field_list_emitted(
      f1: type_decl_interned_symbol(spelling: "px"),
      t1: type_decl_interned_symbol(spelling: "Int"),
      f2: type_decl_interned_symbol(spelling: "py"),
      t2: type_decl_interned_symbol(spelling: "Int")
    )
  )
}

fn type_decl_foreign_emitted() -> v2.std.node.Node {
  type_decl_record_emitted(
    name: ^type_decl_round_trip_foreign_binding,
    fields: type_decl_two_field_list_emitted(f1: ^x, t1: ^Int, f2: ^y, t2: ^Int)
  )
}

fn type_decl_row_token_spine_classes(row: v2.std.node.Node) -> v2.std.diagnostic.Outcome<std.types.List<v2.std.node.Symbol>> {
  v2.std.diagnostic.bind_outcome(
    o: v2.std.node_query.find_named_child(root: row, name: ^grammar_relation_field_tokens),
    f: fn(tokens_root) {
      v2.std.diagnostic.bind_outcome(
        o: v2.std.compilers.target_model.concrete_syntax_token_list_from_node(list_node: tokens_root),
        f: fn(tokens) {
          let classes = v2.std.algebra.fold_list(
            xs: tokens,
            empty: std.algebra.Empty,
            cons: fn(acc, t) {
              v2.std.algebra.list_append(left: acc, right: [v2.std.compilers.target_model.concrete_syntax_token_class(token: t)])
            }
          )
          v2.std.diagnostic.outcome_accepted(value: classes)
        }
      )
    }
  )
}

fn type_decl_emit_source_text(emitted: v2.std.node.Node) -> v2.std.diagnostic.Outcome<String> {
  type_decl_emit_source_text_with_rules(emitted: emitted, rules: type_decl_rules())
}

fn type_decl_emit_source_text_with_rules(emitted: v2.std.node.Node, rules: v2.std.node.Node) -> v2.std.diagnostic.Outcome<String> {
  let target = type_decl_target()
  v2.std.diagnostic.bind_outcome(
    o: v2.compiler.translate.grammar_relation_row_for_emitted(rules: rules, emitted: emitted),
    f: fn(row) {
      v2.std.diagnostic.bind_outcome(
        o: v2.compiler.translate.grammar_relation_row_tokens_root(row: row),
        f: fn(tokens_root) {
          v2.std.diagnostic.bind_outcome(
            o: v2.std.compilers.target_model.concrete_syntax_token_list_from_node(list_node: tokens_root),
            f: fn(tokens) {
              v2.std.diagnostic.bind_outcome(
                o: v2.compiler.translate.serialize_concrete_syntax_tokens_to_source(target: target, tokens: tokens),
                f: fn(medium) {
                  v2.std.diagnostic.outcome_accepted(value: medium.carried)
                }
              )
            }
          )
        }
      )
    }
  )
}

fn type_decl_lexer_token_to_concrete(token: v2.std.compilers.lexing.Token) -> v2.std.compilers.target_model.ConcreteSyntaxToken {
  if token.class == ^dag_token_ident {
    v2.std.compilers.target_model.BoundToken { token_class: ^dag_token_ident, binding: token.lexeme }
  } else {
    v2.std.compilers.target_model.FixedToken { token_class: token.class }
  }
}

fn type_decl_lexer_tokens_to_concrete_syntax(tokens: std.types.List<v2.std.compilers.lexing.Token>) -> std.types.List<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  v2.std.algebra.fold_list(
    xs: tokens,
    empty: std.algebra.Empty,
    cons: fn(acc, t) {
      v2.std.algebra.list_append(
        left: acc,
        right: [type_decl_lexer_token_to_concrete(token: t)]
      )
    }
  )
}

fn type_decl_tokenize_source_text(source: String) -> v2.std.diagnostic.Outcome<std.types.List<v2.std.compilers.lexing.Token>> {
  v2.std.diagnostic.bind_outcome(
    o: v2.compiler.tokenize.tokenize(
      text: source,
      file: type_decl_round_trip_source_file,
      rules: type_decl_target().lex
    ),
    f: fn(stream) {
      v2.std.diagnostic.outcome_accepted(value: v2.std.compilers.lexing.token_stream_all(stream: stream))
    }
  )
}

fn type_decl_emit_row_tokens(emitted: v2.std.node.Node) -> v2.std.diagnostic.Outcome<std.types.List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  v2.std.diagnostic.bind_outcome(
    o: v2.compiler.translate.grammar_relation_row_for_emitted(rules: type_decl_rules(), emitted: emitted),
    f: fn(row) {
      v2.std.diagnostic.bind_outcome(
        o: v2.compiler.translate.grammar_relation_row_tokens_root(row: row),
        f: fn(tokens_root) {
          v2.std.compilers.target_model.concrete_syntax_token_list_from_node(list_node: tokens_root)
        }
      )
    }
  )
}

fn type_decl_emit_row_forward_identity_holds(emitted: v2.std.node.Node) -> v2.std.logic.Bool {
  match type_decl_emit_row_tokens(emitted: emitted) {
    Accepted { value: tokens, diagnostics: _ } =>
      match v2.compiler.ingest.grammar_relation_row_forward_token_selection(
        tokens: tokens,
        rules: type_decl_rules(),
        start_lhs: ^dag_production_type_decl
      ) {
        Accepted { value: recovered, diagnostics: _ } => recovered == emitted
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn type_decl_reparse_emitted_from_source(source: String) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  type_decl_reparse_from_source_with_rules(source: source, rules: type_decl_rules())
}

fn type_decl_reparse_from_source_with_rules(source: String, rules: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: type_decl_tokenize_source_text(source: source),
    f: fn(tokens) {
      v2.compiler.ingest.grammar_relation_row_forward_token_selection(
        tokens: type_decl_lexer_tokens_to_concrete_syntax(tokens: tokens),
        rules: rules,
        start_lhs: ^dag_production_type_decl
      )
    }
  )
}

fn type_decl_emit_frontier(emitted: v2.std.node.Node) -> v2.std.diagnostic.Outcome<std.types.List<v2.std.node.Symbol>> {
  v2.std.diagnostic.bind_outcome(
    o: v2.compiler.translate.grammar_relation_row_for_emitted(rules: type_decl_rules(), emitted: emitted),
    f: fn(row) { type_decl_row_token_spine_classes(row: row) }
  )
}

fn type_decl_parse_from_emitted_source_holds(emitted: v2.std.node.Node) -> v2.std.logic.Bool {
  match type_decl_emit_source_text(emitted: emitted) {
    Accepted { value: source, diagnostics: _ } =>
      match type_decl_reparse_emitted_from_source(source: source) {
        Accepted { value: recovered, diagnostics: _ } => recovered == emitted
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn type_decl_source_text_emit_round_trip_holds(source: String) -> v2.std.logic.Bool {
  type_decl_source_text_emit_round_trip_with_rules(
    rules: type_decl_rules(),
    source: source
  )
}

fn type_decl_source_text_emit_round_trip_with_rules(rules: v2.std.node.Node, source: String) -> v2.std.logic.Bool {
  match type_decl_reparse_from_source_with_rules(source: source, rules: rules) {
    Accepted { value: node, diagnostics: _ } =>
      match type_decl_emit_source_text_with_rules(emitted: node, rules: rules) {
        Accepted { value: emitted_text, diagnostics: _ } => emitted_text == source
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn type_decl_perturbed_rules_for_point_source() -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match v2.compiler.translate.grammar_relation_row_for_emitted(
    rules: type_decl_rules(),
    emitted: type_decl_pixel_emitted()
  ) {
    Accepted { value: pixel_row, diagnostics: _ } =>
      v2.std.diagnostic.outcome_accepted(value: type_decl_translation_rules_with_row(row: pixel_row))
    Rejected { diagnostics: d } => v2.std.diagnostic.Rejected { diagnostics: d }
  }
}

fn type_decl_perturbed_row_breaks_source_roundtrip_holds() -> v2.std.logic.Bool {
  match type_decl_perturbed_rules_for_point_source() {
    Accepted { value: perturbed_rules, diagnostics: _ } =>
      type_decl_source_text_emit_round_trip_holds(source: type_decl_point_source_text)
        && !type_decl_source_text_emit_round_trip_with_rules(
          rules: perturbed_rules,
          source: type_decl_point_source_text
        )
    Rejected { diagnostics: _ } => false
  }
}

test fn type_decl_real_source_round_trip_holds() -> v2.std.logic.Bool {
  type_decl_source_text_emit_round_trip_holds(source: type_decl_point_source_text)
    && type_decl_perturbed_row_breaks_source_roundtrip_holds()
    && type_decl_emit_structural_not_fixture_lookup_holds()
    && type_decl_forward_class_spine_ambiguous_rejects_holds()
}

fn type_decl_derived_row_preserves_emitted_holds(emitted: v2.std.node.Node) -> v2.std.logic.Bool {
  match v2.compiler.translate.grammar_relation_row_for_emitted(rules: type_decl_rules(), emitted: emitted) {
    Accepted { value: row, diagnostics: _ } =>
      match v2.std.node_query.find_named_child(root: row, name: ^grammar_relation_field_emitted) {
        Accepted { value: row_emitted, diagnostics: _ } => row_emitted == emitted
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn type_decl_emit_derive_idempotent_holds(emitted: v2.std.node.Node) -> v2.std.logic.Bool {
  match v2.compiler.translate.grammar_relation_row_for_emitted(rules: type_decl_rules(), emitted: emitted) {
    Accepted { value: row1, diagnostics: _ } =>
      match v2.compiler.translate.grammar_relation_row_for_emitted(rules: type_decl_rules(), emitted: emitted) {
        Accepted { value: row2, diagnostics: _ } => row1 == row2
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn type_decl_row_with_foreign_emitted_fixture(canonical_row: v2.std.node.Node, foreign: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: v2.std.node_query.find_named_child(root: canonical_row, name: ^grammar_relation_field_production),
    f: fn(production) {
      v2.std.diagnostic.bind_outcome(
        o: v2.std.node_query.find_named_child(root: canonical_row, name: ^grammar_relation_field_tokens),
        f: fn(tokens) {
          v2.std.diagnostic.outcome_accepted(
            value: v2.std.node.Node {
              kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
              children: [
                v2.std.node.Edge {
                  label: v2.std.node.Named { name: ^grammar_relation_field_production },
                  target: production
                },
                v2.std.node.Edge {
                  label: v2.std.node.Named { name: ^grammar_relation_field_emitted },
                  target: foreign
                },
                v2.std.node.Edge {
                  label: v2.std.node.Named { name: ^grammar_relation_field_tokens },
                  target: tokens
                }
              ],
              occurrence_id: v2.std.node.SyntheticOccurrence
            }
          )
        }
      )
    }
  )
}

fn type_decl_translation_rules_with_row(row: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^grammar_relation_rules_formal_productions },
        target: v2.std.grammar.formal_productions_catalog_to_node(
          productions: v2.extdeps.languages.dag.dag_type_decl_structural_formal_productions()
        )
      },
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^type_decl_round_trip_foreign_binding },
        target: row
      }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn type_decl_emit_structural_not_fixture_lookup_holds() -> v2.std.logic.Bool {
  match v2.compiler.translate.grammar_relation_row_for_emitted(rules: type_decl_rules(), emitted: type_decl_point_emitted()) {
    Accepted { value: canonical_row, diagnostics: _ } =>
      match type_decl_row_with_foreign_emitted_fixture(
        canonical_row: canonical_row,
        foreign: type_decl_foreign_emitted()
      ) {
        Accepted { value: perturbed_row, diagnostics: _ } =>
          match v2.compiler.translate.grammar_relation_row_for_emitted(
            rules: type_decl_translation_rules_with_row(row: perturbed_row),
            emitted: type_decl_point_emitted()
          ) {
            Accepted { value: selected, diagnostics: _ } => selected == perturbed_row
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn type_decl_forward_class_spine_ambiguous_rejects_holds() -> v2.std.logic.Bool {
  match type_decl_emit_frontier(emitted: type_decl_point_emitted()) {
    Accepted { value: frontier, diagnostics: _ } =>
      match v2.compiler.ingest.grammar_relation_row_forward_selection(frontier: frontier, rules: type_decl_rules()) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: _ } => true
      }
    Rejected { diagnostics: _ } => false
  }
}

fn type_decl_emit_source_text_matches_golden_holds(emitted: v2.std.node.Node, golden: String) -> v2.std.logic.Bool {
  match type_decl_emit_source_text(emitted: emitted) {
    Accepted { value: text, diagnostics: _ } => text == golden
    Rejected { diagnostics: _ } => false
  }
}

fn type_decl_point_pixel_emit_distinct_holds() -> v2.std.logic.Bool {
  match type_decl_emit_source_text(emitted: type_decl_point_emitted()) {
    Accepted { value: point_text, diagnostics: _ } =>
      match type_decl_emit_source_text(emitted: type_decl_pixel_emitted()) {
        Accepted { value: pixel_text, diagnostics: _ } => point_text != pixel_text
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_ingest_type_decl_round_trip_holds() -> v2.std.logic.Bool {
  type_decl_emit_row_forward_identity_holds(emitted: type_decl_point_emitted())
    && type_decl_emit_row_forward_identity_holds(emitted: type_decl_pixel_emitted())
    && type_decl_parse_from_emitted_source_holds(emitted: type_decl_point_emitted())
    && type_decl_parse_from_emitted_source_holds(emitted: type_decl_pixel_emitted())
    && type_decl_emit_source_text_matches_golden_holds(
      emitted: type_decl_point_emitted(),
      golden: type_decl_point_source_text
    )
    && type_decl_emit_source_text_matches_golden_holds(
      emitted: type_decl_pixel_emitted(),
      golden: type_decl_pixel_source_text
    )
    && type_decl_point_pixel_emit_distinct_holds()
    && type_decl_derived_row_preserves_emitted_holds(emitted: type_decl_point_emitted())
    && type_decl_emit_derive_idempotent_holds(emitted: type_decl_point_emitted())
    && type_decl_emit_structural_not_fixture_lookup_holds()
    && type_decl_forward_class_spine_ambiguous_rejects_holds()
}
