data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data emit_on_demand_family_crate_note: String = "Family-grain build receipt (std.emit_on_demand witness_family_build_grain_ruling, operator-directed 2026-07-21): per-witness crates measured ~17s each and LOSE to the interpreter; ONE family crate wins. Members meet + join + complement concatenate into one emitted source (emit_family, per-member target models) under the derived argv-dispatched family main (rust_logic_family_target_model_staging). THE flip receipt is family_crate_one_build_members_warm_holds: the first member run builds the crate (compile_skipped false); every later member run on the same family workspace is compile_skipped TRUE — under per-witness grain each member would be its own ~17s cold build. This module is the ONE executing consumer for the logic family's native execution (suite migration, merry-pike-487 follow-on): the eval-anchored member agreements (interpreted == native via run_test_claim_from_source_emit_vs_eval_cached, per-member fixtures derived from each subject's claim) and the unknown-member refusal all run WARM on the same one-build workspace — the per-witness native builds formerly in emit_on_demand_meet_join_family_witness_test and emit_on_demand_complement_family_witness_test are deleted, those suites keep the pure key/store/budget receipts. REDs: unknown member id refuses (dispatcher exits 2 — refused logical_run, never fabricated octets); the ALL-ALT family (every member the swapped-arms tree) changes family_closure_digest -> new key -> ONE cold rebuild carrying every wrong-fixture discriminator at once (meet 1 -> 0, join 1 -> 0, complement 0 -> 1; members 2..3 warm). Key sensitivity is pure: family digest differs from every member digest (tag-seeded, singleton included) and member LIST ORDER is declared key material."

data family_crate_cache_root: String = emit_on_demand_family_cache_root(family: "family_crate")
data family_crate_emitter: String = "v2.compiler.emit"

fn family_crate_meet_tree() -> InferredTree {
  meet_join_eval_tree_for(root: dag_meet_arrow_with_body_fixture)
}

fn family_crate_meet_alt_tree() -> InferredTree {
  meet_join_eval_tree_for(root: dag_meet_arrow_with_body_swapped_arms_fixture)
}

fn family_crate_join_tree() -> InferredTree {
  meet_join_eval_tree_for(root: dag_join_arrow_with_body_fixture)
}

fn family_crate_complement_tree() -> InferredTree {
  emit_complement_eval_tree_for(root: dag_complement_arrow_with_body_fixture)
}

fn family_crate_members() -> List<EmitFamilyMember> {
  [
    EmitFamilyMember {
      tree: family_crate_meet_tree(),
      target: rust_logic_meet_target_model_staging()
    },
    EmitFamilyMember {
      tree: family_crate_join_tree(),
      target: rust_logic_join_target_model_staging()
    },
    EmitFamilyMember {
      tree: family_crate_complement_tree(),
      target: rust_logic_complement_target_model_staging()
    }
  ]
}

fn family_crate_join_alt_tree() -> InferredTree {
  meet_join_eval_tree_for(root: dag_join_arrow_with_body_swapped_arms_fixture)
}

fn family_crate_complement_alt_tree() -> InferredTree {
  emit_complement_eval_tree_for(root: dag_complement_arrow_with_body_swapped_arms_fixture)
}

fn family_crate_alt_members() -> List<EmitFamilyMember> {
  [
    EmitFamilyMember {
      tree: family_crate_meet_alt_tree(),
      target: rust_logic_meet_target_model_staging()
    },
    EmitFamilyMember {
      tree: family_crate_join_alt_tree(),
      target: rust_logic_join_target_model_staging()
    },
    EmitFamilyMember {
      tree: family_crate_complement_alt_tree(),
      target: rust_logic_complement_target_model_staging()
    }
  ]
}

fn family_crate_member_digest(member: EmitFamilyMember) -> ContentHash {
  inferred_tree_digest(tree: member.tree)
}

fn family_crate_member_digests(members: List<EmitFamilyMember>) -> List<ContentHash> {
  match members {
    Empty => []
    Cons { head: m, tail: t } =>
      concat(
        [family_crate_member_digest(member: m)],
        family_crate_member_digests(members: t)
      )
  }
}

fn family_crate_digest(members: List<EmitFamilyMember>) -> ContentHash {
  family_closure_digest(members: family_crate_member_digests(members: members))
}

fn family_crate_native_key(members: List<EmitFamilyMember>) -> ContentHash {
  emit_on_demand_key(
    closure_digest: family_crate_digest(members: members),
    emitter_identity: family_crate_emitter,
    target_language: "rust",
    grain: NativeArtifact
  )
}

fn family_crate_fixture_inputs() -> Inputs {
  inputs_for_emit_host(
    claim_input_root: dag_meet_eval_subgraph_fixture,
    expected_eval_root: dag_meet_eval_subgraph_fixture,
    claim_pin: ^family_crate_evaluator_pin
  )
}

fn family_crate_cache_root_for(test_id: String) -> String {
  concat(family_crate_cache_root, "/", test_id)
}

fn family_crate_evict_and_workspace(
  test_id: String,
  members: List<EmitFamilyMember>
) -> String {
  let key = family_crate_native_key(members: members)
  let root = family_crate_cache_root_for(test_id: test_id)
  let _evict = emit_on_demand_evict_native_cache(cache_root: root, key: key)
  native_cache_workspace_root(cache_root: root, key: key)
}

fn family_crate_member_run(
  workspace: String,
  source: Medium<String>,
  member_id: String,
  expect_compile_skipped: Bool,
  expected_octet: Int
) -> Bool {
  match run_emit_host_cached_with_run_args(
    workspace_dir: workspace,
    target: rust_logic_family_target_model_staging(),
    source: source,
    fixture_inputs: family_crate_fixture_inputs(),
    run_args: rust_family_member_run_args(member_id: member_id)
  ) {
    Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        Accepted {
          value: HostLogicalRun { stdout: stdout },
          diagnostics: None
        } =>
          receipt.compile_skipped == expect_compile_skipped
            && stdout.bytes == emit_host_octets_byte_string(octets: [0, expected_octet, 0, 0, 0])
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn family_crate_meet_join_member_agreement_divergence(
  workspace: String,
  source: Medium<String>,
  tree: InferredTree,
  subgraph: Node,
  member_id: String
) -> Optional<NativeAgreementDivergence> {
  native_agreement_divergence_from_run(
    member_id: member_id,
    run: run_test_claim_from_source_emit_vs_eval_cached(
      subject: meet_join_eval_subject(tree: tree, subgraph: subgraph),
      source_outcome: Accepted { value: source, diagnostics: None },
      target: rust_logic_family_target_model_staging(),
      workspace_dir: workspace,
      run_args: rust_family_member_run_args(member_id: member_id)
    )
  )
}

fn family_crate_meet_join_member_agreement(
  workspace: String,
  source: Medium<String>,
  tree: InferredTree,
  subgraph: Node,
  member_id: String
) -> Bool {
  match family_crate_meet_join_member_agreement_divergence(
    workspace: workspace,
    source: source,
    tree: tree,
    subgraph: subgraph,
    member_id: member_id
  ) {
    Absent => true
    Present { value: _ } => false
  }
}

fn family_crate_complement_member_agreement_divergence(
  workspace: String,
  source: Medium<String>
) -> Optional<NativeAgreementDivergence> {
  native_agreement_divergence_from_run(
    member_id: "complement",
    run: run_test_claim_from_source_emit_vs_eval_cached(
      subject: emit_complement_eval_subject(tree: family_crate_complement_tree()),
      source_outcome: Accepted { value: source, diagnostics: None },
      target: rust_logic_family_target_model_staging(),
      workspace_dir: workspace,
      run_args: rust_family_member_run_args(member_id: "complement")
    )
  )
}

fn family_crate_complement_member_agreement(
  workspace: String,
  source: Medium<String>
) -> Bool {
  match family_crate_complement_member_agreement_divergence(
    workspace: workspace,
    source: source
  ) {
    Absent => true
    Present { value: _ } => false
  }
}

fn optional_divergence_to_list(
  opt: Optional<NativeAgreementDivergence>
) -> List<NativeAgreementDivergence> {
  match opt {
    Absent => []
    Present { value: d } => [d]
  }
}

fn family_crate_emit_family_rejected_divergence() -> NativeAgreementDivergence {
  NativeAgreementDivergence {
    member_id: "emit_family",
    interpreted_value: "emit_rejected",
    native_value: "emit_rejected"
  }
}

fn family_crate_pr_native_agreement_divergences() -> List<NativeAgreementDivergence> {
  let members = family_crate_members()
  let workspace = native_cache_workspace_root(
    cache_root: family_crate_cache_root_for(test_id: "pr_native"),
    key: family_crate_native_key(members: members)
  )
  match emit_family(
    members: members,
    transport_target: rust_logic_family_target_model_staging()
  ) {
    Accepted { value: source, diagnostics: _ } =>
      list_append(
        left: optional_divergence_to_list(
          opt: family_crate_meet_join_member_agreement_divergence(
            workspace: workspace,
            source: source,
            tree: family_crate_meet_tree(),
            subgraph: dag_meet_eval_subgraph_fixture,
            member_id: "meet"
          )
        ),
        right: list_append(
          left: optional_divergence_to_list(
            opt: family_crate_meet_join_member_agreement_divergence(
              workspace: workspace,
              source: source,
              tree: family_crate_join_tree(),
              subgraph: dag_join_eval_subgraph_fixture,
              member_id: "join"
            )
          ),
          right: optional_divergence_to_list(
            opt: family_crate_complement_member_agreement_divergence(
              workspace: workspace,
              source: source
            )
          )
        )
      )
    Rejected { diagnostics: _ } => [family_crate_emit_family_rejected_divergence()]
  }
}

fn family_crate_member_run_refused(
  workspace: String,
  source: Medium<String>,
  member_id: String
) -> Bool {
  match run_emit_host_cached_with_run_args(
    workspace_dir: workspace,
    target: rust_logic_family_target_model_staging(),
    source: source,
    fixture_inputs: family_crate_fixture_inputs(),
    run_args: rust_family_member_run_args(member_id: member_id)
  ) {
    Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: _ } => true
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn family_crate_digest_differs_from_member_digests_holds() -> Bool {
  let d_meet = inferred_tree_digest(tree: family_crate_meet_tree())
  let d_join = inferred_tree_digest(tree: family_crate_join_tree())
  let d_complement = inferred_tree_digest(tree: family_crate_complement_tree())
  let fam = family_closure_digest(members: [d_meet, d_join, d_complement])
  fam != d_meet
    && fam != d_join
    && fam != d_complement
    && family_closure_digest(members: [d_meet]) != d_meet
}

test fn family_crate_member_change_key_sensitivity_holds() -> Bool {
  let key_primary = family_crate_native_key(members: family_crate_members())
  let key_alt = family_crate_native_key(members: family_crate_alt_members())
  key_primary != key_alt
}

test fn family_crate_member_order_key_sensitivity_holds() -> Bool {
  let d_meet = inferred_tree_digest(tree: family_crate_meet_tree())
  let d_join = inferred_tree_digest(tree: family_crate_join_tree())
  let forward = family_closure_digest(members: [d_meet, d_join])
  let reversed = family_closure_digest(members: [d_join, d_meet])
  forward != reversed
}

test fn family_crate_one_build_members_warm_holds() -> Bool {
  let members = family_crate_members()
  let workspace = family_crate_evict_and_workspace(
    test_id: "one_build_members_warm",
    members: members
  )
  match emit_family(
    members: members,
    transport_target: rust_logic_family_target_model_staging()
  ) {
    Accepted { value: source, diagnostics: _ } =>
      family_crate_member_run(
        workspace: workspace,
        source: source,
        member_id: "meet",
        expect_compile_skipped: false,
        expected_octet: 1
      )
        && family_crate_member_run(
          workspace: workspace,
          source: source,
          member_id: "join",
          expect_compile_skipped: true,
          expected_octet: 1
        )
        && family_crate_member_run(
          workspace: workspace,
          source: source,
          member_id: "complement",
          expect_compile_skipped: true,
          expected_octet: 0
        )
        && family_crate_member_run(
          workspace: workspace,
          source: source,
          member_id: "meet",
          expect_compile_skipped: true,
          expected_octet: 1
        )
        && family_crate_meet_join_member_agreement(
          workspace: workspace,
          source: source,
          tree: family_crate_meet_tree(),
          subgraph: dag_meet_eval_subgraph_fixture,
          member_id: "meet"
        )
        && family_crate_meet_join_member_agreement(
          workspace: workspace,
          source: source,
          tree: family_crate_join_tree(),
          subgraph: dag_join_eval_subgraph_fixture,
          member_id: "join"
        )
        && family_crate_complement_member_agreement(
          workspace: workspace,
          source: source
        )
        && family_crate_member_run_refused(
          workspace: workspace,
          source: source,
          member_id: "absent_member"
        )
    Rejected { diagnostics: _ } => false
  }
}

test fn family_crate_member_change_cold_rebuild_holds() -> Bool {
  let members = family_crate_members()
  let alt_members = family_crate_alt_members()
  if family_crate_native_key(members: members) == family_crate_native_key(members: alt_members) {
    false
  } else {
    let workspace = family_crate_evict_and_workspace(
      test_id: "member_change_cold_rebuild",
      members: alt_members
    )
    match emit_family(
      members: alt_members,
      transport_target: rust_logic_family_target_model_staging()
    ) {
      Accepted { value: source, diagnostics: _ } =>
        family_crate_member_run(
          workspace: workspace,
          source: source,
          member_id: "meet",
          expect_compile_skipped: false,
          expected_octet: 0
        )
          && family_crate_member_run(
            workspace: workspace,
            source: source,
            member_id: "join",
            expect_compile_skipped: true,
            expected_octet: 0
          )
          && family_crate_member_run(
            workspace: workspace,
            source: source,
            member_id: "complement",
            expect_compile_skipped: true,
            expected_octet: 1
          )
      Rejected { diagnostics: _ } => false
    }
  }
}

test fn emit_on_demand_family_crate_witnesses() -> Bool {
  family_crate_digest_differs_from_member_digests_holds()
    && family_crate_member_change_key_sensitivity_holds()
    && family_crate_member_order_key_sensitivity_holds()
    && family_crate_one_build_members_warm_holds()
    && family_crate_member_change_cold_rebuild_holds()
}

data family_crate_pr_native_note: String = "Per-PR native carrier (routing frontier, 2026-07-22): the NO-EVICT agreement leg — same one-build workspace derivation as the receipts above but under the fixed pr_native test_id and never evicted, so the first CI run on a runner cold-builds once and every later PR run is warm (compile_skipped observed via the cached transport receipts). Assertions are agreement-only (interpreted == native per member), skip-state-agnostic by design: cold and warm runs both green, which is what a per-PR gate needs. Hermetic-clean: no evict intrinsic (which refuses hermetic), and the cached transport runs on the Admitted verdict in every mode."

test fn emit_on_demand_family_crate_pr_native_agreement_holds() -> Bool {
  length(xs: family_crate_pr_native_agreement_divergences()) == 0
}

test fn family_crate_emit_family_rejected_divergence_holds() -> Bool {
  format_native_agreement_divergence(d: family_crate_emit_family_rejected_divergence()) == "member=emit_family interpreted=emit_rejected native=emit_rejected"
}

fn emit_on_demand_family_crate_pr_native_agreement_failure_receipt() -> String {
  native_agreement_failure_receipt(
    divergences: family_crate_pr_native_agreement_divergences()
  )
}
