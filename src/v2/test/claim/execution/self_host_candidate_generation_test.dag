module v2.test.execution.self_host_candidate_generation


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.ReadsLiveTree

fn symbol_eq(left: v2.std.node.Symbol, right: v2.std.node.Symbol) -> Bool {
  left == right
}

fn translate_diagnostic_reason_variant_symbols(variants: List<v2.compiler.translate.TranslateDiagnosticReason>) -> List<v2.std.node.Symbol> {
  fold(variants, init: [], f: fn(acc, variant) {
    v2.std.algebra.list_snoc_item(xs: acc, item: v2.compiler.translate.translate_diagnostic_reason_symbol(reason: variant))
  })
}

fn translate_diagnostic_reason_from_symbol_over_variants(
  sym: v2.std.node.Symbol,
  variants: List<v2.compiler.translate.TranslateDiagnosticReason>
) -> v2.std.optional.Optional<v2.compiler.translate.TranslateDiagnosticReason> {
  fold(variants, init: v2.std.optional.optional_absent(), f: fn(acc, variant) {
    match acc {
      v2.std.optional.Present { value: _ } => acc
      v2.std.optional.Absent =>
        if sym == v2.compiler.translate.translate_diagnostic_reason_symbol(reason: variant) {
          v2.std.optional.optional_present(value: variant)
        } else {
          acc
        }
    }
  })
}

fn translate_diagnostic_reason_variants_without_malformed() -> List<v2.compiler.translate.TranslateDiagnosticReason> {
  fold(v2.compiler.translate.translate_diagnostic_reason_variants(), init: [], f: fn(acc, variant) {
    match variant {
      v2.compiler.translate.TargetBundleMalformed => acc
      _ => v2.std.algebra.list_snoc_item(xs: acc, item: variant)
    }
  })
}

fn translate_diagnostic_reason_variant_round_trips(variant: v2.compiler.translate.TranslateDiagnosticReason) -> Bool {
  match v2.compiler.translate.translate_diagnostic_reason_from_symbol(sym: v2.compiler.translate.translate_diagnostic_reason_symbol(reason: variant)) {
    v2.std.optional.Present { value: reason } => v2.compiler.translate.translate_diagnostic_reason_symbol(reason: reason) == v2.compiler.translate.translate_diagnostic_reason_symbol(reason: variant)
    v2.std.optional.Absent => false
  }
}

fn translate_diagnostic_reason_symbol_round_trip_holds() -> Bool {
  fold(v2.compiler.translate.translate_diagnostic_reason_variants(), init: true, f: fn(acc, variant) {
    acc && translate_diagnostic_reason_variant_round_trips(variant: variant)
  })
}

fn translate_diagnostic_reason_roster_matches_variants() -> Bool {
  v2.std.algebra.bag_eq(
    xs: v2.compiler.translate.translate_diagnostic_reason_roster(),
    ys: translate_diagnostic_reason_variant_symbols(
      variants: v2.compiler.translate.translate_diagnostic_reason_variants()
    ),
    eq: symbol_eq
  )
}

fn translate_diagnostic_reason_variants_drop_malformed_perturb_red_holds() -> Bool {
  match translate_diagnostic_reason_from_symbol_over_variants(
    sym: v2.compiler.translate.translate_diagnostic_reason_symbol(reason: v2.compiler.translate.TargetBundleMalformed),
    variants: translate_diagnostic_reason_variants_without_malformed()
  ) {
    v2.std.optional.Absent => true
    v2.std.optional.Present { value: _ } => false
  }
}

fn witness_translate_diagnostic_reason_symbol_inverse() -> Bool {
  translate_diagnostic_reason_symbol_round_trip_holds()
    && translate_diagnostic_reason_roster_matches_variants()
    && translate_diagnostic_reason_variants_drop_malformed_perturb_red_holds()
}

fn candidate_generation_dag_add_slice_accepts() -> Bool {
  match v2.compiler.self_host.candidate_generation.generate_translate_self_emit_candidate(
    resolved_module: v2.test.execution.dag_add_emit_round_trip.dag_add_emitted_root,
    dag_target: v2.test.execution.dag_add_emit_round_trip.dag_add_target_model
  ) {
    v2.std.diagnostic.Accepted { value: candidate, diagnostics: d } =>
      (candidate.emitted == v2.extdeps.languages.dag.dag_emitted_add_fn_node()) && (d == v2.std.diagnostic.None)
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn translate_error_profile_roster_nonempty() -> Bool {
  v2.std.algebra.length(xs: v2.compiler.translate.translate_diagnostic_reason_roster()) > 0
}

fn translate_error_profile_rust_add_malformed_bundle_known() -> Bool {
  match v2.compiler.translate.target_serialize_source_from_model(
    target: v2.test.manual.rust_add_emit_translate.rust_add_missing_translation_rules_target,
    emitted: v2.test.manual.rust_add_emit_translate.rust_add_emitted_root
  ) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
    v2.std.diagnostic.Rejected { diagnostics: r } =>
      match v2.compiler.translate.translate_diagnostic_reason_from_symbol(sym: r.head.reason) {
        v2.std.optional.Present { value: v2.compiler.translate.TargetBundleMalformed } => true
        v2.std.optional.Present { value: _ } => false
        v2.std.optional.Absent => false
      }
  }
}

fn translate_error_profile_sg2_projected_arrow_serialize_known() -> Bool {
  match v2.compiler.translate.target_serialize_source_from_model(
    target: v2.test.manual.sg2_type_expression_projection.sg2_type_expr_target,
    emitted: v2.test.manual.sg2_type_expression_projection.sg2_project_arrow_emitted()
  ) {
    v2.std.diagnostic.Accepted { value: source, diagnostics: _ } => source.carried == v2.test.manual.sg2_type_expression_projection.sg2_expected_arrow_text
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn translate_error_profile_sg2_projected_conj_serialize_known() -> Bool {
  match v2.compiler.translate.target_serialize_source_from_model(
    target: v2.test.manual.sg2_type_expression_projection.sg2_type_expr_target,
    emitted: v2.test.manual.sg2_type_expression_projection.sg2_project_conj_emitted()
  ) {
    v2.std.diagnostic.Accepted { value: source, diagnostics: _ } => source.carried == v2.test.manual.sg2_type_expression_projection.sg2_expected_conj_text
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn translate_error_profile_sg2_projected_instantiation_serialize_known() -> Bool {
  match v2.compiler.translate.target_serialize_source_from_model(
    target: v2.test.manual.sg2_type_expression_projection.sg2_type_expr_target,
    emitted: v2.test.manual.sg2_type_expression_projection.sg2_project_instantiation_emitted()
  ) {
    v2.std.diagnostic.Accepted { value: source, diagnostics: _ } => source.carried == v2.test.manual.sg2_type_expression_projection.sg2_expected_type_text
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn translate_diagnostic_reason_from_symbol_swapped_malformed_duplicate(
  sym: v2.std.node.Symbol
) -> v2.std.optional.Optional<v2.compiler.translate.TranslateDiagnosticReason> {
  let malformed_sym = v2.compiler.translate.translate_diagnostic_reason_symbol(reason: v2.compiler.translate.TargetBundleMalformed)
  let duplicate_sym = v2.compiler.translate.translate_diagnostic_reason_symbol(reason: v2.compiler.translate.TargetBundleDuplicateEdge)
  if sym == malformed_sym {
    v2.std.optional.optional_present(value: v2.compiler.translate.TargetBundleDuplicateEdge)
  } else if sym == duplicate_sym {
    v2.std.optional.optional_present(value: v2.compiler.translate.TargetBundleMalformed)
  } else {
    v2.compiler.translate.translate_diagnostic_reason_from_symbol(sym: sym)
  }
}

fn translate_error_profile_coproduct_swap_perturb_discriminates() -> Bool {
  match v2.compiler.translate.target_serialize_source_from_model(
    target: v2.test.manual.rust_add_emit_translate.rust_add_missing_translation_rules_target,
    emitted: v2.test.manual.rust_add_emit_translate.rust_add_emitted_root
  ) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
    v2.std.diagnostic.Rejected { diagnostics: r } =>
      match v2.compiler.translate.translate_diagnostic_reason_from_symbol(sym: r.head.reason) {
        v2.std.optional.Present { value: v2.compiler.translate.TargetBundleMalformed } =>
          match translate_diagnostic_reason_from_symbol_swapped_malformed_duplicate(sym: r.head.reason) {
            v2.std.optional.Present { value: v2.compiler.translate.TargetBundleDuplicateEdge } => true
            v2.std.optional.Present { value: _ } => false
            v2.std.optional.Absent => false
          }
        v2.std.optional.Present { value: _ } => false
        v2.std.optional.Absent => false
      }
  }
}

test fn translate_diagnostic_reason_symbol_inverse_holds() -> Bool {
  witness_translate_diagnostic_reason_symbol_inverse()
}

test fn candidate_generation_translate_self_emit_dag_add_slice_holds() -> Bool {
  candidate_generation_dag_add_slice_accepts()
}

test fn translate_error_profile_roster_nonempty_holds() -> Bool {
  translate_error_profile_roster_nonempty()
}

test fn translate_error_profile_rust_add_malformed_bundle_classified() -> Bool {
  translate_error_profile_rust_add_malformed_bundle_known()
}

test fn translate_error_profile_sg2_projected_arrow_serialize_accepts() -> Bool {
  translate_error_profile_sg2_projected_arrow_serialize_known()
}

test fn translate_error_profile_sg2_projected_conj_serialize_accepts() -> Bool {
  translate_error_profile_sg2_projected_conj_serialize_known()
}

test fn translate_error_profile_sg2_projected_instantiation_serialize_accepts() -> Bool {
  translate_error_profile_sg2_projected_instantiation_serialize_known()
}

test fn translate_error_profile_coproduct_mapping_perturb_red_holds() -> Bool {
  translate_error_profile_coproduct_swap_perturb_discriminates()
}
