import v2.extdeps.languages.rust_fixtures {
  rust_list_fold_target_model_staging,
  rust_list_fold_target_model_staging_with,
  rust_list_fold_unwired_projection
}
import v2.test.claim.emit.fold_call_closure_fixture {
  fold_fixture_arrow_with_body,
  fold_fixture_atom,
  fold_fixture_call_body,
  fold_fixture_closure_arrow
}
import v2.test.claim.callexec.list_introduction_eval { lie_list }
import v2.test.lens_common.infer_fixture { claim_inferred_facts_from_nodes }
import v2.std.cardinality { RankingComponent, TerminationProof }
import std.algebra { list_at_optional, list_snoc_item }
import v2.std.integer { Int }
import std.optional {
