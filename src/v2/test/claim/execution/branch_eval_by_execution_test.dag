module v2.test.execution.branch_eval_by_execution


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn branch_atom(s: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } },
    occurrence_id: SyntheticOccurrence,
    children: []
  }
}

fn branch_byte() -> std.bit.Byte {
  std.bit.Byte { bits: [true] }
}

fn branch_bool_type_node() -> v2.std.node.Node {
  branch_atom(s: ^branch_bool_type)
}

fn branch_i64_node() -> v2.std.node.Node {
  branch_atom(s: ^branch_i64)
}

fn branch_int_value(bytes: std.types.List<std.bit.Byte>) -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimePrimitive {
    value: v2.std.runtime.RuntimePrimitiveValue {
      primitive_type: branch_i64_node(),
      bytes: bytes
    }
  }
}

fn branch_bool_value(is_true: Bool) -> v2.std.runtime.RuntimeValue {
  if is_true {
    v2.std.runtime.RuntimePrimitive {
      value: v2.std.runtime.RuntimePrimitiveValue {
        primitive_type: branch_bool_type_node(),
        bytes: [branch_byte()]
      }
    }
  } else {
    v2.std.runtime.RuntimePrimitive {
      value: v2.std.runtime.RuntimePrimitiveValue {
        primitive_type: branch_bool_type_node(),
        bytes: std.algebra.Empty
      }
    }
  }
}

fn branch_one_value() -> v2.std.runtime.RuntimeValue {
  branch_int_value(bytes: [branch_byte()])
}

fn branch_two_value() -> v2.std.runtime.RuntimeValue {
  branch_int_value(bytes: [branch_byte(), branch_byte()])
}

fn branch_literal_one_node() -> v2.std.node.Node {
  v2.extdeps.languages.dag.dag_int_literal_fixture_one()
}

fn branch_literal_two_node() -> v2.std.node.Node {
  v2.extdeps.languages.dag.dag_int_literal_fixture_two()
}

fn branch_runtime_diagnostic(n: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^branch_runtime_rejected,
    at: v2.std.diagnostic.node_locus(node: n),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn branch_runtime_bool_true(value: v2.std.runtime.RuntimeValue) -> Bool {
  match value {
    RuntimePrimitive { value: p } =>
      (p.primitive_type == branch_bool_type_node()) && (count(p.bytes) == 1)
    _ => false
  }
}

fn branch_runtime_bool_false(value: v2.std.runtime.RuntimeValue) -> Bool {
  match value {
    RuntimePrimitive { value: p } =>
      (p.primitive_type == branch_bool_type_node()) && (count(p.bytes) == 0)
    _ => false
  }
}

fn branch_runtime_int_is_one(value: v2.std.runtime.RuntimeValue) -> Bool {
  match value {
    RuntimePrimitive { value: p } =>
      (p.primitive_type == branch_i64_node()) && (count(p.bytes) == 1)
    _ => false
  }
}

fn branch_kw_true_node() -> v2.std.node.Node {
  branch_atom(s: ^dag_token_kw_true)
}

fn branch_kw_false_node() -> v2.std.node.Node {
  branch_atom(s: ^dag_token_kw_false)
}

fn branch_allocate_literal(node: v2.std.node.Node, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  if v2.extdeps.languages.dag.dag_node_is_int_literal_atom(node: node) {
    match v2.extdeps.languages.dag.dag_int_literal_magnitude_int_from_node(node: node) {
      Accepted { value: mag, diagnostics: _ } =>
        if mag == 1 {
          v2.std.diagnostic.outcome_accepted(value: branch_one_value())
        } else if mag == 2 {
          v2.std.diagnostic.outcome_accepted(value: branch_two_value())
        } else {
          v2.std.diagnostic.outcome_rejected(d: branch_runtime_diagnostic(n: node))
        }
      Rejected { diagnostics: d } => v2.std.diagnostic.Rejected { diagnostics: d }
    }
  } else if node == branch_kw_true_node() {
    v2.std.diagnostic.outcome_accepted(value: branch_bool_value(is_true: true))
  } else if node == branch_kw_false_node() {
    v2.std.diagnostic.outcome_accepted(value: branch_bool_value(is_true: false))
  } else {
    v2.std.diagnostic.outcome_rejected(d: branch_runtime_diagnostic(n: node))
  }
}

fn branch_call_primitive(
  _node: v2.std.node.Node,
  _args: std.types.List<v2.std.runtime.RuntimeValue>,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.outcome_rejected(d: branch_runtime_diagnostic(n: _node))
}

fn branch_nth_child_target(node: v2.std.node.Node, wanted: Int) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match v2.std.collection.list_at_optional(xs: node.children, index: wanted) {
    Present { value: child } =>
      match child {
        Edge { label: _, target: arm } =>
          v2.std.diagnostic.outcome_accepted(value: extdeps.vendor.arm.arm)
      }
    Absent =>
      v2.std.diagnostic.outcome_rejected(d: branch_runtime_diagnostic(n: node))
  }
}

fn branch_choose_branch_bool_if_else(
  node: v2.std.node.Node,
  condition: v2.std.runtime.RuntimeValue,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  if count(node.children) == 3 {
    if branch_runtime_bool_true(value: condition) {
      branch_nth_child_target(node: node, wanted: 1)
    } else if branch_runtime_bool_false(value: condition) {
      branch_nth_child_target(node: node, wanted: 2)
    } else {
      v2.std.diagnostic.outcome_rejected(d: branch_runtime_diagnostic(n: node))
    }
  } else {
    v2.std.diagnostic.outcome_rejected(d: branch_runtime_diagnostic(n: node))
  }
}

fn branch_step_loop(node: v2.std.node.Node, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.ControlTransfer> {
  v2.std.diagnostic.outcome_rejected(d: branch_runtime_diagnostic(n: node))
}

fn branch_bind_value(
  key: v2.std.runtime.EnvironmentBindingKey,
  value: v2.std.runtime.RuntimeValue,
  env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.EvaluationEnvironment> {
  v2.std.diagnostic.Accepted {
    value: v2.std.runtime.EvaluationEnvironment {
      bindings: v2.std.collection.map_insert(m: env.bindings, key: key, value: value)
    },
    diagnostics: v2.std.diagnostic.None
  }
}

fn branch_interpretation() -> v2.std.runtime.InterpretationAlgebra {
  v2.std.runtime.InterpretationAlgebra {
    value: v2.std.runtime.ValueInterpreter {
      allocate_literal: branch_allocate_literal,
      identity: ^branch_allocate_literal
    },
    transform: v2.std.runtime.TransformInterpreter {
      call_primitive: branch_call_primitive,
      identity: ^branch_call_primitive
    },
    branch: v2.std.runtime.BranchInterpreter {
      choose_branch: branch_choose_branch_bool_if_else,
      identity: ^branch_choose_branch_bool_if_else
    },
    loop: v2.std.runtime.LoopInterpreter {
      step_loop: branch_step_loop,
      identity: ^branch_step_loop
    },
    bind: v2.std.runtime.BindInterpreter {
      bind_value: branch_bind_value,
      identity: ^branch_bind_value
    },
    match: v2.std.runtime.MatchInterpreter {
      choose_arm: v2.std.runtime.runtime_reject_match_arm,
      identity: ^runtime_reject_match_arm    }
  }
}

fn branch_interpretation_structure_witness() -> v2.std.runtime.InterpretationStructureWitness {
  v2.std.runtime.InterpretationStructureWitness {
    allocate_literal: ^branch_allocate_literal,
    call_primitive: ^branch_call_primitive,
    choose_branch: ^branch_choose_branch_bool_if_else,
    step_loop: ^branch_step_loop,
    bind_value: ^branch_bind_value,    choose_arm: ^runtime_reject_match_arm
  }
}

fn branch_context() -> v2.compiler.eval.EvalContext {
  v2.compiler.eval.eval_context_with_semantics(
    runtime_identity: ^branch_runtime_id,
    interpretation: branch_interpretation(),
    structure_witness: branch_interpretation_structure_witness()
  )
}

fn branch_pick_call(callee: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: Transform },
    occurrence_id: SyntheticOccurrence,
    children: [
      v2.std.node.Edge { label: Positional, target: callee }
    ]
  }
}

fn branch_tree_root(call: v2.std.node.Node, expected: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    occurrence_id: SyntheticOccurrence,
    children: [
      v2.std.node.Edge { label: Named { name: ^branch_actual }, target: call },
      v2.std.node.Edge { label: Named { name: ^branch_expected }, target: expected }
    ]
  }
}

fn branch_facts_lookup(key: v2.std.node.Node) -> Optional<v2.compiler.inferred_tree.InferredFacts> {
  v2.std.optional.optional_present(value: v2.test.lens_common.infer_fixture.claim_inferred_facts_from_nodes(
      resolved: key,
      algebra: branch_i64_node(),
      descent: v2.std.cardinality.termination_proof_witness_for_node(n: key)
    ))
}

fn branch_admitted_tree(root: v2.std.node.Node) -> v2.compiler.inferred_tree.InferredTree {
  v2.compiler.inferred_tree.InferredTree {
    root: root,
    facts: std.types.Map {
      lookup: branch_facts_lookup
    }
  }
}

fn branch_inferred_run_tree(callee: v2.std.node.Node, expected: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> {
  let call = branch_pick_call(callee: callee)
  let root = branch_tree_root(call: call, expected: expected)
  v2.std.diagnostic.outcome_accepted(value: branch_admitted_tree(root: root))
}

fn branch_claim(input: v2.std.node.Node, expected: v2.std.node.Node) -> v2.std.verification.TestClaim {
  v2.std.verification.CompilesClaim {
    label: "manual/branch: source-bridged if-then-else Branch.body executes through eval",
    anchor: v2.std.verification.manual_claim_anchor(anchor: ManualAnchorAbsent),
    input: input,
    expected_value: expected,
    classification: v2.std.verification.TestClassification { tier: Tier1, layer: v2.std.verification.Unit }
  }
}

fn branch_subject(
  tree: v2.compiler.inferred_tree.InferredTree,
  input: v2.std.node.Node,
  expected: v2.std.node.Node
) -> v2.compiler.eval.TestClaimEvalSubject<v2.std.node.Node> {
  v2.compiler.eval.TestClaimEvalSubject {
    claim: branch_claim(input: input, expected: expected),
    context: branch_context(),
    tree: tree,
    input: v2.compiler.eval.test_claim_typed_input_node(
      evaluator_input: input,
      evaluator_pin: ^branch_pick_call_pin
    )
  }
}

fn branch_run(
  callee: v2.std.node.Node,
  expected: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>> {
  let input = branch_pick_call(callee: callee)
  v2.std.diagnostic.bind_outcome(
    o: branch_inferred_run_tree(callee: callee, expected: expected),
    f: fn(tree) {
      v2.std.diagnostic.outcome_accepted(
        value: v2.compiler.eval.run_test_claim(
          subject: branch_subject(tree: tree, input: input, expected: expected)
        )
      )
    }
  )
}

fn branch_run_passes(run: v2.std.diagnostic.Outcome<v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>>) -> Bool {
  match run {
    Accepted { value: r, diagnostics: _ } =>
      match v2.compiler.eval.test_claim_run_verdict(run: r) {
        Pass => true
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn branch_source_pipeline_admits_holds() -> Bool {
  match v2.test.complexity_gate.table_fixture_branch_subject_producer.table_fixture_pick_if_arrow_with_body() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn branch_source_driven_pick_true_executes_holds() -> Bool {
  match v2.test.complexity_gate.table_fixture_branch_subject_producer.table_fixture_pick_if_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      branch_run_passes(
        run: branch_run(
          callee: arrow,
          expected: branch_literal_one_node()
        )
      )
    Rejected { diagnostics: _ } => false
  }
}

test fn branch_source_driven_pick_false_executes_holds() -> Bool {
  match v2.test.complexity_gate.table_fixture_branch_subject_producer.table_fixture_pick_false_if_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      branch_run_passes(
        run: branch_run(
          callee: arrow,
          expected: branch_literal_two_node()
        )
      )
    Rejected { diagnostics: _ } => false
  }
}

test fn branch_condition_perturbation_red_holds() -> Bool {
  match v2.test.complexity_gate.table_fixture_branch_subject_producer.table_fixture_pick_if_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      branch_run_passes(
        run: branch_run(
          callee: arrow,
          expected: branch_literal_two_node()
        )
      ) == false
    Rejected { diagnostics: _ } => false
  }
}

test fn branch_direct_runtime_true_holds() -> Bool {
  match v2.test.complexity_gate.table_fixture_branch_subject_producer.table_fixture_pick_if_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } => {
      let input = branch_pick_call(callee: arrow)
      match branch_inferred_run_tree(
        callee: arrow,
        expected: branch_literal_one_node()
      ) {
        Accepted { value: tree, diagnostics: _ } =>
          match v2.compiler.eval.eval(
            tree: tree,
            interpretation: branch_interpretation(),
            inputs: v2.compiler.eval.inputs_root_only(root: input)
          ) {
            Accepted { value: actual, diagnostics: None } =>
              branch_runtime_int_is_one(value: actual)
            _ => false
          }
        Rejected { diagnostics: _ } => false
      }
    }
    Rejected { diagnostics: _ } => false
  }
}

test fn branch_swapped_arms_red_holds() -> Bool {
  match v2.test.complexity_gate.table_fixture_branch_subject_producer.table_fixture_pick_if_arrow_with_body_swapped_arms() {
    Accepted { value: arrow, diagnostics: _ } =>
      branch_run_passes(
        run: branch_run(
          callee: arrow,
          expected: branch_literal_one_node()
        )
      ) == false
    Rejected { diagnostics: _ } => false
  }
}

test fn branch_fixture_producer_holds() -> Bool {
  match v2.test.complexity_gate.table_fixture_branch_subject_producer.table_fixture_pick_if_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      branch_run_passes(
        run: branch_run(
          callee: arrow,
          expected: branch_literal_one_node()
        )
      )
    Rejected { diagnostics: _ } => false
  }
}

