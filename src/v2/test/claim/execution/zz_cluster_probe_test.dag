module v2.test.execution.zz_cluster_probe

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn probe_diag(ds: NonEmptyDiagnostics) -> String {
  symbol_lexeme(sym: ds.head.reason)
}

fn probe_diags(d: Diagnostics) -> String {
  match d {
    None => "no-diags"
    Some { diagnostics: ds } => probe_diag(ds: ds)
  }
}

fn probe_node_outcome(o: Outcome<Node>) -> List<String> {
  match o {
    Accepted { value: _, diagnostics: d } => ["accepted", probe_diags(d: d)]
    Rejected { diagnostics: ds } => ["rejected", probe_diag(ds: ds)]
  }
}

fn probe_dag_add() -> List<String> {
  let c = match coerce_grounded_node(
    source: dag_arrow_domain_conj_node(),
    tree: dag_add_inferred_tree,
    target: dag_add_target_model
  ) {
    Accepted { value: _, diagnostics: d } => ["coerce-accepted", probe_diags(d: d)]
    Rejected { diagnostics: ds } => ["coerce-rejected", probe_diag(ds: ds)]
  }
  let t = probe_node_outcome(o: translate_emitted_node(
    tree: InferredTree {
      root: dag_arrow_domain_conj_node(),
      facts: PartialFunction { lookup: dag_add_facts_lookup }
    },
    target: dag_add_target_model
  ))
  let l = match dag_add_facts_lookup(key: dag_arrow_domain_conj_node()) {
    Present { value: _ } => "lookup-conj:present"
    Absent => "lookup-conj:absent"
  }
  let l2 = match dag_add_facts_lookup(key: dag_type_atom_node(identity: dag_int_type_binding())) {
    Present { value: _ } => "lookup-atom:present"
    Absent => "lookup-atom:absent"
  }
  list_append(left: list_append(left: c, right: list_append(left: ["translate:"], right: t)), right: [l, l2])
}

fn probe_english() -> List<String> {
  let s = if english_emit_add_matches_serialize_holds() { "serialize:ok" } else { "serialize:FAIL" }
  let g = if english_emit_add_grammar_inverse_holds() { "grammar:ok" } else { "grammar:FAIL" }
  let i = match english_emit_add_receipt {
    Rejected { diagnostics: ds } => ["emit-rejected", probe_diag(ds: ds)]
    Accepted { value: source, diagnostics: _ } =>
      match english_emit_add_ingest_parse(source: source) {
        Rejected { diagnostics: ds } => ["ingest-rejected", probe_diag(ds: ds), source.carried]
        Accepted { value: tree, diagnostics: d } =>
          [
            "ingest-accepted",
            probe_diags(d: d),
            if english_emit_add_parse_identity_matches(root: tree, expected: english_emit_add_emitted_root) { "identity:ok" } else { "identity:FAIL" }
          ]
      }
  }
  list_append(left: [s, g], right: i)
}

fn probe_join(xs: List<String>) -> String {
  fold_list(xs: xs, empty: "", cons: fn(acc, s) { concat(acc, " | ", s) })
}

fn probe_main() -> ProcessExit {
  ExitFailure { code: 3, reason: probe_join(xs: list_append(left: list_append(left: ["DAGADD"], right: probe_dag_add()), right: list_append(left: ["ENGLISH"], right: probe_english()))) }
}
