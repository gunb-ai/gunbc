module v2.test.execution.emit_ingest_grammar_relation_round_trip


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = ReadsLiveTree

fn grammar_relation_row_token_spine_classes(row: Node) -> v2.std.diagnostic.Outcome<List<v2.std.node.Symbol>> {
  bind_outcome(
    o: find_named_child(root: row, name: ^grammar_relation_field_tokens),
    f: fn(tokens_root) {
      bind_outcome(
        o: concrete_syntax_token_list_from_node(list_node: tokens_root),
        f: fn(tokens) {
          let classes = fold(
            tokens,
            init: std.algebra.Empty,
            f: fn(acc, t) {
              list_append(left: acc, right: [concrete_syntax_token_class(token: t)])
            }
          )
          outcome_accepted(value: classes)
        }
      )
    }
  )
}

fn emit_ingest_shared_rules() -> Node {
  dag_translation_rules_node()
}

fn emit_ingest_canonical_row() -> Node {
  dag_add_grammar_relation_row_node()
}

fn emit_ingest_canonical_emitted() -> Node {
  dag_fixture_emitted_add_fn
}

test fn emit_backward_selects_canonical_row_holds() -> Bool {
  match grammar_relation_row_for_emitted(
    rules: emit_ingest_shared_rules(),
    emitted: emit_ingest_canonical_emitted()
  ) {
    v2.std.diagnostic.Accepted { value: row, diagnostics: _ } =>
      row == emit_ingest_canonical_row()
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn ingest_forward_selects_canonical_emitted_holds() -> Bool {
  match grammar_relation_row_token_spine_classes(row: emit_ingest_canonical_row()) {
    v2.std.diagnostic.Accepted { value: frontier, diagnostics: _ } =>
      match grammar_relation_row_forward_selection(
        frontier: frontier,
        rules: emit_ingest_shared_rules()
      ) {
        v2.std.diagnostic.Accepted { value: emitted, diagnostics: _ } =>
          emitted == emit_ingest_canonical_emitted()
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn emit_then_ingest_selector_identity_holds() -> Bool {
  match grammar_relation_row_for_emitted(
    rules: emit_ingest_shared_rules(),
    emitted: emit_ingest_canonical_emitted()
  ) {
    v2.std.diagnostic.Accepted { value: row, diagnostics: _ } =>
      match grammar_relation_row_token_spine_classes(row: row) {
        v2.std.diagnostic.Accepted { value: frontier, diagnostics: _ } =>
          match grammar_relation_row_forward_selection(
            frontier: frontier,
            rules: emit_ingest_shared_rules()
          ) {
            v2.std.diagnostic.Accepted { value: recovered, diagnostics: _ } =>
              recovered == emit_ingest_canonical_emitted()
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn ingest_then_emit_selector_identity_holds() -> Bool {
  match grammar_relation_row_token_spine_classes(row: emit_ingest_canonical_row()) {
    v2.std.diagnostic.Accepted { value: frontier, diagnostics: _ } =>
      match grammar_relation_row_forward_selection(
        frontier: frontier,
        rules: emit_ingest_shared_rules()
      ) {
        v2.std.diagnostic.Accepted { value: emitted, diagnostics: _ } =>
          match grammar_relation_row_for_emitted(
            rules: emit_ingest_shared_rules(),
            emitted: emitted
          ) {
            v2.std.diagnostic.Accepted { value: row, diagnostics: _ } =>
              row == emit_ingest_canonical_row()
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn emit_ingest_parsed_add_tree() -> v2.std.diagnostic.Outcome<v2.std.grammar.ParseTree> {
  let lm = dag_language_model()
  bind_outcome(
    o: tokenize(
      text: ingested_add_module_source,
      file: ^emit_ingest_round_trip_source_file,
      rules: lm.lex
    ),
    f: fn(stream) {
      bind_outcome(
        o: parse_module(tokens: stream, grammar: lm.grammar),
        f: fn(artifact) {
          outcome_accepted(value: artifact.tree)
        }
      )
    }
  )
}

test fn same_grammar_parse_ingest_bridge_holds() -> Bool {
  match emit_ingest_parsed_add_tree() {
    v2.std.diagnostic.Accepted { value: tree, diagnostics: _ } =>
      match parse_tree_to_emitted_node(
        parse_tree: tree,
        source_model: dag_target_model()
      ) {
        v2.std.diagnostic.Accepted { value: recovered, diagnostics: _ } =>
          recovered == emit_ingest_canonical_emitted()
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

