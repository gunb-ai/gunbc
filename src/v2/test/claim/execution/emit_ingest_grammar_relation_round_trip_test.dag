module v2.test.execution.emit_ingest_grammar_relation_round_trip


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.ReadsLiveTree

fn grammar_relation_row_token_spine_classes(row: v2.std.node.Node) -> v2.std.diagnostic.Outcome<List<v2.std.node.Symbol>> {
  v2.std.diagnostic.bind_outcome(
    o: v2.std.node_query.find_named_child(root: row, name: ^grammar_relation_field_tokens),
    f: fn(tokens_root) {
      v2.std.diagnostic.bind_outcome(
        o: v2.std.compilers.target_model.concrete_syntax_token_list_from_node(list_node: tokens_root),
        f: fn(tokens) {
          let classes = fold(
            tokens,
            init: std.algebra.Empty,
            f: fn(acc, t) {
              v2.std.algebra.list_append(left: acc, right: [v2.std.compilers.target_model.concrete_syntax_token_class(token: t)])
            }
          )
          v2.std.diagnostic.outcome_accepted(value: classes)
        }
      )
    }
  )
}

fn emit_ingest_shared_rules() -> v2.std.node.Node {
  v2.extdeps.languages.dag.dag_translation_rules_node()
}

fn emit_ingest_canonical_row() -> v2.std.node.Node {
  v2.extdeps.languages.dag.dag_add_grammar_relation_row_node()
}

fn emit_ingest_canonical_emitted() -> v2.std.node.Node {
  v2.extdeps.languages.dag.dag_fixture_emitted_add_fn
}

test fn emit_backward_selects_canonical_row_holds() -> Bool {
  match v2.compiler.translate.grammar_relation_row_for_emitted(
    rules: emit_ingest_shared_rules(),
    emitted: emit_ingest_canonical_emitted()
  ) {
    Accepted { value: row, diagnostics: _ } =>
      row == emit_ingest_canonical_row()
    Rejected { diagnostics: _ } => false
  }
}

test fn ingest_forward_selects_canonical_emitted_holds() -> Bool {
  match v2.test.execution.emit_ingest_grammar_relation_round_trip.grammar_relation_row_token_spine_classes(row: emit_ingest_canonical_row()) {
    Accepted { value: frontier, diagnostics: _ } =>
      match v2.compiler.ingest.grammar_relation_row_forward_selection(
        frontier: frontier,
        rules: emit_ingest_shared_rules()
      ) {
        Accepted { value: emitted, diagnostics: _ } =>
          emitted == emit_ingest_canonical_emitted()
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_then_ingest_selector_identity_holds() -> Bool {
  match v2.compiler.translate.grammar_relation_row_for_emitted(
    rules: emit_ingest_shared_rules(),
    emitted: emit_ingest_canonical_emitted()
  ) {
    Accepted { value: row, diagnostics: _ } =>
      match v2.test.execution.emit_ingest_grammar_relation_round_trip.grammar_relation_row_token_spine_classes(row: row) {
        Accepted { value: frontier, diagnostics: _ } =>
          match v2.compiler.ingest.grammar_relation_row_forward_selection(
            frontier: frontier,
            rules: emit_ingest_shared_rules()
          ) {
            Accepted { value: recovered, diagnostics: _ } =>
              recovered == emit_ingest_canonical_emitted()
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn ingest_then_emit_selector_identity_holds() -> Bool {
  match v2.test.execution.emit_ingest_grammar_relation_round_trip.grammar_relation_row_token_spine_classes(row: emit_ingest_canonical_row()) {
    Accepted { value: frontier, diagnostics: _ } =>
      match v2.compiler.ingest.grammar_relation_row_forward_selection(
        frontier: frontier,
        rules: emit_ingest_shared_rules()
      ) {
        Accepted { value: emitted, diagnostics: _ } =>
          match v2.compiler.translate.grammar_relation_row_for_emitted(
            rules: emit_ingest_shared_rules(),
            emitted: emitted
          ) {
            Accepted { value: row, diagnostics: _ } =>
              row == emit_ingest_canonical_row()
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn emit_ingest_parsed_add_tree() -> v2.std.diagnostic.Outcome<v2.std.grammar.ParseTree> {
  let lm = v2.extdeps.languages.dag.dag_language_model()
  v2.std.diagnostic.bind_outcome(
    o: v2.compiler.tokenize.tokenize(
      text: v2.compiler.ingested_fixture_arrows.ingested_add_module_source,
      file: ^emit_ingest_round_trip_source_file,
      rules: lm.lex
    ),
    f: fn(stream) {
      v2.std.diagnostic.bind_outcome(
        o: v2.compiler.parse.parse_module(tokens: stream, grammar: lm.grammar),
        f: fn(artifact) {
          v2.std.diagnostic.outcome_accepted(value: artifact.tree)
        }
      )
    }
  )
}

test fn same_grammar_parse_ingest_bridge_holds() -> Bool {
  match emit_ingest_parsed_add_tree() {
    Accepted { value: tree, diagnostics: _ } =>
      match v2.compiler.ingest.parse_tree_to_emitted_node(
        parse_tree: tree,
        source_model: v2.extdeps.languages.dag.dag_target_model()
      ) {
        Accepted { value: recovered, diagnostics: _ } =>
          recovered == emit_ingest_canonical_emitted()
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

