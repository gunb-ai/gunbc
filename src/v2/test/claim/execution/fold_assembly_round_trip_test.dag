module v2.test.execution.fold_assembly_round_trip


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn atom(id: v2.std.node.Symbol) -> Node {
  node_synthetic(kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } }, children: [])
}
fn conj2(a: Node, b: Node) -> Node {
  node_synthetic(kind: v2.std.node.TypeNode { connective: Conj }, children: [
    v2.std.node.Edge { label: Positional, target: a },
    v2.std.node.Edge { label: Positional, target: b }
  ])
}
fn conj3(a: Node, b: Node, c: Node) -> Node {
  node_synthetic(kind: v2.std.node.TypeNode { connective: Conj }, children: [
    v2.std.node.Edge { label: Positional, target: a },
    v2.std.node.Edge { label: Positional, target: b },
    v2.std.node.Edge { label: Positional, target: c }
  ])
}

fn node_eq(a: Node, b: Node) -> Bool {
  exact_structural_equality_zip_fold(source_facts: a, candidate: b)
}
fn chain_eq(a: FreeMonoid<Node>, b: FreeMonoid<Node>) -> Bool {
  (length(xs: a) == length(xs: b))
    && zip_eq(a: a, b: b, eq: fn(x, y) { v2.test.execution.fold_assembly_round_trip.node_eq(a: x, b: y) })
}

fn expansion_equals(form: Node, expected: FreeMonoid<Node>) -> Bool {
  match expand_fold(fold_form: form) {
    Accepted { value: steps, diagnostics: _ } => chain_eq(a: steps, b: expected)
    Rejected { diagnostics: _ } => false
  }
}
fn expansion_rejected(form: Node) -> Bool {
  match expand_fold(fold_form: form) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}
fn expansion_accepted_but_differs(form: Node, expected: FreeMonoid<Node>) -> Bool {
  match expand_fold(fold_form: form) {
    Accepted { value: steps, diagnostics: _ } => !chain_eq(a: steps, b: expected)
    Rejected { diagnostics: _ } => false
  }
}

data gate_chain: List<Node> = [
  v2.test.execution.fold_assembly_round_trip.conj3(a: v2.test.execution.fold_assembly_round_trip.atom(id: ^run), b: v2.test.execution.fold_assembly_round_trip.atom(id: ^gate_rust),  c: v2.test.execution.fold_assembly_round_trip.atom(id: ^acc0)),
  v2.test.execution.fold_assembly_round_trip.conj3(a: v2.test.execution.fold_assembly_round_trip.atom(id: ^run), b: v2.test.execution.fold_assembly_round_trip.atom(id: ^gate_emit),  c: v2.test.execution.fold_assembly_round_trip.atom(id: ^acc1)),
  v2.test.execution.fold_assembly_round_trip.conj3(a: v2.test.execution.fold_assembly_round_trip.atom(id: ^run), b: v2.test.execution.fold_assembly_round_trip.atom(id: ^gate_layer), c: v2.test.execution.fold_assembly_round_trip.atom(id: ^acc2))
]

data divergent_chain: List<Node> = [
  v2.test.execution.fold_assembly_round_trip.conj2(a: v2.test.execution.fold_assembly_round_trip.atom(id: ^is_if),     b: v2.test.execution.fold_assembly_round_trip.atom(id: ^stmt_first)),
  v2.test.execution.fold_assembly_round_trip.conj2(a: v2.test.execution.fold_assembly_round_trip.atom(id: ^is_assign), b: v2.test.execution.fold_assembly_round_trip.conj2(a: v2.test.execution.fold_assembly_round_trip.atom(id: ^skip), b: v2.test.execution.fold_assembly_round_trip.atom(id: ^stmt_first))),
  v2.test.execution.fold_assembly_round_trip.conj2(a: v2.test.execution.fold_assembly_round_trip.atom(id: ^is_loop),   b: v2.test.execution.fold_assembly_round_trip.conj2(a: v2.test.execution.fold_assembly_round_trip.atom(id: ^skip), b: v2.test.execution.fold_assembly_round_trip.atom(id: ^stmt_first)))
]

data short_chain: List<Node> = [
  v2.test.execution.fold_assembly_round_trip.conj3(a: v2.test.execution.fold_assembly_round_trip.atom(id: ^run), b: v2.test.execution.fold_assembly_round_trip.atom(id: ^gate_rust), c: v2.test.execution.fold_assembly_round_trip.atom(id: ^acc0)),
  v2.test.execution.fold_assembly_round_trip.conj3(a: v2.test.execution.fold_assembly_round_trip.atom(id: ^run), b: v2.test.execution.fold_assembly_round_trip.atom(id: ^gate_emit), c: v2.test.execution.fold_assembly_round_trip.atom(id: ^acc1))
]

fn round_trips(steps: FreeMonoid<Node>) -> Bool {
  expansion_equals(form: assemble_fold(g: anti_unify_chain(steps: steps)), expected: steps)
}

test fn gate_chain_round_trips() -> Bool {
  v2.test.execution.fold_assembly_round_trip.round_trips(steps: gate_chain)
}
test fn divergent_chain_round_trips() -> Bool {
  v2.test.execution.fold_assembly_round_trip.round_trips(steps: divergent_chain)
}
test fn short_chain_round_trips() -> Bool {
  v2.test.execution.fold_assembly_round_trip.round_trips(steps: short_chain)
}

fn apply_recovers_step(template: Node, step: Node) -> Bool {
  v2.test.execution.fold_assembly_round_trip.node_eq(a: apply_fills(template: template, fills: extract_fillings(template: template, element: step)), b: step)
}
test fn apply_inverts_extract_on_gate_step() -> Bool {
  apply_recovers_step(template: anti_unify_chain(steps: gate_chain).template, step: v2.test.execution.fold_assembly_round_trip.conj3(a: v2.test.execution.fold_assembly_round_trip.atom(id: ^run), b: v2.test.execution.fold_assembly_round_trip.atom(id: ^gate_emit), c: v2.test.execution.fold_assembly_round_trip.atom(id: ^acc1)))
}

test fn fold_form_has_exactly_one_template_edge() -> Bool {
  name_occurrences(name: fold_template_edge, children: assemble_fold(g: anti_unify_chain(steps: gate_chain)).children) == 1
}

fn outcome_node_is(o: v2.std.diagnostic.Outcome<Node>, expected: Node) -> Bool {
  match o {
    Accepted { value: t, diagnostics: _ } => v2.test.execution.fold_assembly_round_trip.node_eq(a: t, b: expected)
    Rejected { diagnostics: _ } => false
  }
}
test fn fold_form_template_is_the_kernel_template() -> Bool {
  outcome_node_is(
    o: fold_template_of(fold_form: assemble_fold(g: anti_unify_chain(steps: gate_chain))),
    expected: anti_unify_chain(steps: gate_chain).template
  )
}

fn fills_eq(a: FreeMonoid<Node>, b: FreeMonoid<Node>) -> Bool {
  (length(xs: a) == length(xs: b)) && zip_eq(a: a, b: b, eq: fn(x, y) { v2.test.execution.fold_assembly_round_trip.node_eq(a: x, b: y) })
}
fn per_element_eq(a: FreeMonoid<FreeMonoid<Node>>, b: FreeMonoid<FreeMonoid<Node>>) -> Bool {
  (length(xs: a) == length(xs: b)) && zip_eq(a: a, b: b, eq: fn(x, y) { fills_eq(a: x, b: y) })
}
test fn fold_form_preserves_per_element_fills() -> Bool {
  match fold_per_element_of(fold_form: assemble_fold(g: anti_unify_chain(steps: gate_chain))) {
    Accepted { value: pe, diagnostics: _ } => v2.test.execution.fold_assembly_round_trip.per_element_eq(a: pe, b: anti_unify_chain(steps: gate_chain).per_element)
    Rejected { diagnostics: _ } => false
  }
}

fn corrupted_per_element() -> FreeMonoid<FreeMonoid<Node>> {
  list_snoc_item(
    xs: list_snoc_item(
      xs: list_snoc_item(
        xs: freemonoid_empty(),
        item: list_snoc_item(xs: list_snoc_item(xs: freemonoid_empty(), item: v2.test.execution.fold_assembly_round_trip.atom(id: ^WRONG)), item: v2.test.execution.fold_assembly_round_trip.atom(id: ^acc0))
      ),
      item: list_snoc_item(xs: list_snoc_item(xs: freemonoid_empty(), item: v2.test.execution.fold_assembly_round_trip.atom(id: ^gate_emit)), item: v2.test.execution.fold_assembly_round_trip.atom(id: ^acc1))
    ),
    item: list_snoc_item(xs: list_snoc_item(xs: freemonoid_empty(), item: v2.test.execution.fold_assembly_round_trip.atom(id: ^gate_layer)), item: v2.test.execution.fold_assembly_round_trip.atom(id: ^acc2))
  )
}
fn corrupted_fold_form() -> Node {
  node_synthetic(kind: v2.std.node.TypeNode { connective: Conj }, children: [
    v2.std.node.Edge { label: Named { name: fold_template_edge }, target: anti_unify_chain(steps: gate_chain).template },
    v2.std.node.Edge { label: Named { name: ^fold_elements }, target: encode_per_element(per_element: corrupted_per_element()) }
  ])
}
test fn corrupted_content_expands_but_differs() -> Bool {
  expansion_accepted_but_differs(form: corrupted_fold_form(), expected: gate_chain)
}

fn good_elements_node() -> Node {
  encode_per_element(per_element: anti_unify_chain(steps: gate_chain).per_element)
}

fn missing_template_form() -> Node {
  node_synthetic(kind: v2.std.node.TypeNode { connective: Conj }, children: [
    v2.std.node.Edge { label: Named { name: ^fold_elements }, target: good_elements_node() }
  ])
}
test fn structural_missing_template_edge_is_rejected() -> Bool {
  expansion_rejected(form: missing_template_form())
}

fn duplicate_template_form() -> Node {
  node_synthetic(kind: v2.std.node.TypeNode { connective: Conj }, children: [
    v2.std.node.Edge { label: Named { name: fold_template_edge }, target: anti_unify_chain(steps: gate_chain).template },
    v2.std.node.Edge { label: Named { name: fold_template_edge }, target: anti_unify_chain(steps: gate_chain).template },
    v2.std.node.Edge { label: Named { name: ^fold_elements }, target: good_elements_node() }
  ])
}
test fn structural_duplicate_template_edge_is_rejected() -> Bool {
  expansion_rejected(form: duplicate_template_form())
}

fn head_without_tail_elements_form() -> Node {
  node_synthetic(kind: v2.std.node.TypeNode { connective: Conj }, children: [
    v2.std.node.Edge { label: Named { name: fold_template_edge }, target: anti_unify_chain(steps: gate_chain).template },
    v2.std.node.Edge { label: Named { name: ^fold_elements }, target: node_synthetic(kind: v2.std.node.TypeNode { connective: Conj }, children: [
      v2.std.node.Edge { label: Named { name: ^fold_list_node_head }, target: encode_per_element(per_element: anti_unify_chain(steps: gate_chain).per_element) }
    ]) }
  ])
}
test fn structural_cons_head_without_tail_is_rejected() -> Bool {
  expansion_rejected(form: head_without_tail_elements_form())
}

fn arity_mismatch_form() -> Node {
  assemble_fold(g: v2.std.anti_unification.ChainGeneralization {
    template: anti_unify_chain(steps: gate_chain).template,
    per_element: list_snoc_item(
      xs: freemonoid_empty(),
      item: list_snoc_item(xs: freemonoid_empty(), item: v2.test.execution.fold_assembly_round_trip.atom(id: ^only_one_fill))
    )
  })
}
test fn structural_fill_arity_mismatch_is_rejected() -> Bool {
  expansion_rejected(form: arity_mismatch_form())
}
