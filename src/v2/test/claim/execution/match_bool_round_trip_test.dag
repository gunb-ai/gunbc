module v2.test.execution.match_bool_round_trip

import v2.compiler.emit { emit }
import v2.compiler.infer { InferredFacts, InferredTree }
import extdeps.communication.medium { Lossless, Medium }
import v2.compiler.translate {
  coerce_grounded_node,
  grammar_inverse_source_validated,
  target_serialize_source_from_model
}
import v2.extdeps.languages.dag {
  dag_inhabitant_atom,
  dag_fixture_emitted_match_fn,
  dag_fixture_int_inhabitant,
  dag_match_target_model,
  dag_type_atom_node
}
import v2.test.lens_common.infer_fixture { claim_inferred_facts_witness }
import v2.std.cardinality { termination_proof_witness_for_node }
import v2.std.collection { Map }
import v2.std.constraints {
  CanonicalGrounding,
  CanonicalGroundingWitness
}
import v2.std.coercion { CoercionQuality, Exact, Identity, Widened }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  node_locus
}
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.compilers.target_model { TargetModel }
import v2.std.witness { Holds, StructuralPropertyWitness, Violates, Witness }
import v2.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data match_bool_emitted_root: Node = dag_fixture_emitted_match_fn
data match_bool_target_model: TargetModel = dag_match_target_model()

fn match_bool_canonical_grounding(
  node: Node,
  algebra: Node
) -> CanonicalGrounding {
  CanonicalGrounding {
    node: node,
    witness: CanonicalGroundingWitness {
      structural: StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn match_bool_canonical_grounding_for(node: Node) -> Witness<CanonicalGrounding> {
  if node == dag_fixture_emitted_match_fn {
    Holds {
      value: match_bool_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_fixture_int_inhabitant {
    Holds {
      value: match_bool_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_inhabitant_atom(id: ^dag_inhabitant_int) {
    Holds {
      value: match_bool_canonical_grounding(
        node: node,
        algebra: dag_fixture_int_inhabitant
      )
    }
  } else if node == dag_inhabitant_atom(id: ^dag_surface_spelling_int) {
    Holds {
      value: match_bool_canonical_grounding(
        node: node,
        algebra: dag_fixture_int_inhabitant
      )
    }
  } else if node == dag_type_atom_node(identity: ^dag_binding_type_int) {
    Holds {
      value: match_bool_canonical_grounding(
        node: node,
        algebra: dag_fixture_int_inhabitant
      )
    }
  } else if node == dag_type_atom_node(identity: ^dag_token_kw_true) {
    Holds {
      value: match_bool_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_type_atom_node(identity: ^dag_token_kw_false) {
    Holds {
      value: match_bool_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_type_atom_node(identity: ^dag_pick_lit_one) {
    Holds {
      value: match_bool_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_type_atom_node(identity: ^dag_pick_lit_two) {
    Holds {
      value: match_bool_canonical_grounding(node: node, algebra: node)
    }
  } else {
    Violates {
      diagnostic: Diagnostic {
        reason: ^match_bool_grounding_miss,
        at: node_locus(node: node),
        correction: Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn match_bool_inferred_facts_for(node: Node) -> Witness<InferredFacts> {
  match match_bool_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => Violates { diagnostic: d }
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => Violates { diagnostic: d }
        Holds { value: proof } =>
          Holds {
            value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: Holds { value: proof }
            )
          }
      }
  }
}

fn match_bool_facts_lookup(key: Node) -> Witness<InferredFacts> {
  match_bool_inferred_facts_for(node: key)
}

data match_bool_inferred_tree: InferredTree = InferredTree {
  root: match_bool_emitted_root,
  facts: Map {
    lookup: match_bool_facts_lookup
  }
}

fn match_bool_emit_accepts() -> Outcome<Medium<String>> {
  emit(tree: match_bool_inferred_tree, target: match_bool_target_model)
}

data match_bool_emit_receipt: Outcome<Medium<String>> = match_bool_emit_accepts()

fn match_bool_coercion_quality_is_faithful(q: CoercionQuality) -> Bool {
  match q {
    Exact => true
    Identity => true
    Widened => false
  }
}

fn match_bool_emit_matches_serialize_holds() -> Bool {
  match target_serialize_source_from_model(
    target: match_bool_target_model,
    emitted: match_bool_emitted_root
  ) {
    Accepted { value: authority, diagnostics: ad } =>
      match match_bool_emit_receipt {
        Accepted { value: source, diagnostics: d } =>
          (source == authority) && (d == None) && (ad == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn match_bool_grammar_inverse_holds() -> Bool {
  match grammar_inverse_source_validated(
    target: match_bool_target_model,
    emitted: match_bool_emitted_root
  ) {
    Accepted { value: _, diagnostics: d } => d == None
    Rejected { diagnostics: _ } => false
  }
}

fn match_bool_ingest_via_coerce_matches_canonical() -> Bool {
  match coerce_grounded_node(
    source: match_bool_emitted_root,
    tree: match_bool_inferred_tree,
    target: match_bool_target_model
  ) {
    Accepted { value: result, diagnostics: d } =>
      (result.target == dag_fixture_emitted_match_fn)
        && match_bool_coercion_quality_is_faithful(q: result.quality)
        && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn match_bool_round_trip_keystone_holds() -> Bool {
  match_bool_emit_matches_serialize_holds()
    && match_bool_grammar_inverse_holds()
    && match_bool_ingest_via_coerce_matches_canonical()
}
