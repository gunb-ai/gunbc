module v2.test.execution.match_bool_round_trip


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data match_bool_emitted_root: v2.std.node.Node = dag_fixture_emitted_match_fn
data match_bool_target_model: v2.std.compilers.target_model.TargetModel = dag_match_target_model()

fn match_bool_canonical_grounding(
  node: v2.std.node.Node,
  algebra: v2.std.node.Node
) -> v2.std.constraints.CanonicalGrounding {
  v2.std.constraints.CanonicalGrounding {
    node: node,
    witness: v2.std.constraints.CanonicalGroundingWitness {
      structural: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn match_bool_canonical_grounding_for(node: v2.std.node.Node) -> Witness<v2.std.constraints.CanonicalGrounding> {
  if node == dag_fixture_emitted_match_fn {
    v2.std.witness.Holds {
      value: match_bool_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_fixture_int_inhabitant {
    v2.std.witness.Holds {
      value: match_bool_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_inhabitant_atom(id: ^dag_inhabitant_int) {
    v2.std.witness.Holds {
      value: match_bool_canonical_grounding(
        node: node,
        algebra: dag_fixture_int_inhabitant
      )
    }
  } else if node == dag_inhabitant_atom(id: ^dag_surface_spelling_int) {
    v2.std.witness.Holds {
      value: match_bool_canonical_grounding(
        node: node,
        algebra: dag_fixture_int_inhabitant
      )
    }
  } else if node == dag_type_atom_node(identity: ^dag_binding_type_int) {
    v2.std.witness.Holds {
      value: match_bool_canonical_grounding(
        node: node,
        algebra: dag_fixture_int_inhabitant
      )
    }
  } else if node == dag_type_atom_node(identity: ^dag_token_kw_true) {
    v2.std.witness.Holds {
      value: match_bool_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_type_atom_node(identity: ^dag_token_kw_false) {
    v2.std.witness.Holds {
      value: match_bool_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_type_atom_node(identity: ^dag_pick_lit_one) {
    v2.std.witness.Holds {
      value: match_bool_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_type_atom_node(identity: ^dag_pick_lit_two) {
    v2.std.witness.Holds {
      value: match_bool_canonical_grounding(node: node, algebra: node)
    }
  } else {
    v2.std.witness.Violates {
      diagnostic: v2.std.diagnostic.Diagnostic {
        reason: ^match_bool_grounding_miss,
        at: node_locus(node: node),
        correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn match_bool_inferred_facts_for(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  match match_bool_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => optional_absent()
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => optional_absent()
        Holds { value: proof } =>
          optional_present(value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: v2.std.witness.Holds { value: proof }
            ))
      }
  }
}

fn match_bool_facts_lookup(key: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  match_bool_inferred_facts_for(node: key)
}

data match_bool_inferred_tree: v2.compiler.inferred_tree.InferredTree = v2.compiler.inferred_tree.InferredTree {
  root: match_bool_emitted_root,
  facts: std.types.Map {
    lookup: match_bool_facts_lookup
  }
}

fn match_bool_emit_accepts() -> v2.std.diagnostic.Outcome<Medium<String>> {
  v2.compiler.emit.emit(tree: match_bool_inferred_tree, target: match_bool_target_model)
}

data match_bool_emit_receipt: v2.std.diagnostic.Outcome<Medium<String>> = match_bool_emit_accepts()

fn match_bool_coercion_quality_is_faithful(q: v2.std.coercion.CoercionQuality) -> v2.std.logic.Bool {
  match q {
    Exact => true
    Identity => true
    Widened => false
  }
}

test fn match_bool_emit_matches_serialize_holds() -> v2.std.logic.Bool {
  match target_serialize_source_from_model(
    target: match_bool_target_model,
    emitted: match_bool_emitted_root
  ) {
    Accepted { value: authority, diagnostics: ad } =>
      match match_bool_emit_receipt {
        Accepted { value: source, diagnostics: d } =>
          (source == authority) && (d == v2.std.diagnostic.None) && (ad == v2.std.diagnostic.None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn match_bool_grammar_inverse_holds() -> v2.std.logic.Bool {
  match grammar_inverse_source_validated(
    target: match_bool_target_model,
    emitted: match_bool_emitted_root
  ) {
    Accepted { value: _, diagnostics: d } => d == v2.std.diagnostic.None
    Rejected { diagnostics: _ } => false
  }
}

test fn match_bool_ingest_via_coerce_matches_canonical() -> v2.std.logic.Bool {
  match coerce_grounded_node(
    source: match_bool_emitted_root,
    tree: match_bool_inferred_tree,
    target: match_bool_target_model
  ) {
    Accepted { value: result, diagnostics: d } =>
      (result.target == dag_fixture_emitted_match_fn)
        && match_bool_coercion_quality_is_faithful(q: result.quality)
        && (d == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

