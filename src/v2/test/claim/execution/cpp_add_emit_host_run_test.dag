module v2.test.execution.cpp_add_emit_host_run

import extdeps.communication.medium { Lossless, Medium }
import v2.compiler.emit_host {
  emit_host_octets_byte_string,
  run_emit_host,
  run_host_process,
  runtime_value_parse
}
import v2.compiler.eval { Inputs, inputs_root_only }
import v2.extdeps.languages.cpp {
  cpp_emit_host_runtime_primitive_type_node,
  cpp_source_text,
  cpp_target_model
}
import v2.std.diagnostic { Accepted, Rejected, None }
import v2.std.host_run { HostLogicalRun }
import v2.std.host_transport {
  EmitHostRuntimeRow,
  FixedText,
  FixedWidthBytes,
  HostToolProgram,
  HostTransportDescriptor,
  LiteralArg,
  ProcessInvocation,
  ProducedProgram,
  WorkspaceFile
}
import v2.std.logic { Bool }
import v2.std.node { Atom, Node, SyntheticOccurrence, TypeNode }
import v2.std.text { String }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn cpp_run_probe_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^cpp_emit_host_run_probe } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn cpp_run_inputs() -> Inputs {
  inputs_root_only(root: cpp_run_probe_node())
}

fn cpp_run_source() -> Medium<String> {
  Medium { carried: cpp_source_text, fidelity: Lossless }
}

fn cpp_fixed_source_row(source_text: String) -> EmitHostRuntimeRow {
  EmitHostRuntimeRow {
    transport: HostTransportDescriptor {
      identity: ^cpp_emit_host_run_probe_fixed,
      workspace: [
        WorkspaceFile {
          path: "fixture.c",
          content: FixedText { text: source_text }
        }
      ],
      build: [
        ProcessInvocation {
          program: HostToolProgram { executable: "cc" },
          args: [LiteralArg { text: "fixture.c" }, LiteralArg { text: "-o" }, LiteralArg { text: "fixture" }]
        }
      ],
      run: ProcessInvocation {
        program: ProducedProgram { path: "fixture" },
        args: []
      },
      runtime_value_codec: FixedWidthBytes { width: 5 }
    },
    runtime_primitive_type: cpp_emit_host_runtime_primitive_type_node()
  }
}

test fn cpp_add_emit_host_green_run_holds() -> Bool {
  match run_emit_host(
    target: cpp_target_model(),
    source: cpp_run_source(),
    fixture_inputs: cpp_run_inputs()
  ) {
    Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        Accepted { value: HostLogicalRun { stdout: stdout }, diagnostics: None } =>
          match runtime_value_parse(target: cpp_target_model(), stdout: stdout) {
            Accepted { value: _, diagnostics: _ } =>
              stdout.bytes == emit_host_octets_byte_string(octets: [0, 5, 0, 0, 0])
            Rejected { diagnostics: _ } => false
          }
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn cpp_add_emit_host_nonzero_exit_refuses_holds() -> Bool {
  match run_host_process(
    row: cpp_fixed_source_row(source_text: "int main(void) { return 3; }"),
    target: cpp_target_model(),
    source: cpp_run_source(),
    fixture_inputs: cpp_run_inputs()
  ) {
    Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        Rejected { diagnostics: _ } => true
        Accepted { value: _, diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn cpp_add_emit_host_byte_width_mismatch_refuses_holds() -> Bool {
  match run_host_process(
    row: cpp_fixed_source_row(source_text: "extern long write(int, const void *, unsigned long);\nint main(void) { unsigned char b[4] = {0, 0, 0, 0}; write(1, b, 4); return 0; }"),
    target: cpp_target_model(),
    source: cpp_run_source(),
    fixture_inputs: cpp_run_inputs()
  ) {
    Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        Accepted { value: HostLogicalRun { stdout: stdout }, diagnostics: None } =>
          match runtime_value_parse(target: cpp_target_model(), stdout: stdout) {
            Rejected { diagnostics: _ } => true
            Accepted { value: _, diagnostics: _ } => false
          }
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn cpp_add_emit_host_run_all_holds() -> Bool {
  cpp_add_emit_host_green_run_holds()
    && cpp_add_emit_host_nonzero_exit_refuses_holds()
    && cpp_add_emit_host_byte_width_mismatch_refuses_holds()
}
