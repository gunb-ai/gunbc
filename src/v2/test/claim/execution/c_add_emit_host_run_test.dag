module v2.test.execution.c_add_emit_host_run


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn c_run_probe_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^c_emit_host_run_probe } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn c_run_inputs() -> v2.compiler.eval.Inputs {
  inputs_root_only(root: c_run_probe_node())
}

fn c_run_source() -> Medium<String> {
  extdeps.communication.medium.Medium { carried: c_source_text, fidelity: Lossless }
}

fn c_expected_add_stdout_octets() -> List<Int> {
  [0, 5, 0, 0, 0]
}

fn c_fixed_source_row(source_text: String) -> v2.std.host_transport.EmitHostRuntimeRow {
  v2.std.host_transport.EmitHostRuntimeRow {
    transport: v2.std.host_transport.HostTransportDescriptor {
      identity: ^c_emit_host_run_probe_fixed,
      workspace: [
        v2.std.host_transport.WorkspaceFile {
          path: "fixture.c",
          content: v2.std.host_transport.FixedText { text: source_text }
        }
      ],
      build: [
        v2.std.host_transport.ProcessInvocation {
          program: v2.std.host_transport.HostToolProgram { executable: "cc" },
          args: [v2.std.host_transport.LiteralArg { text: "fixture.c" }, v2.std.host_transport.LiteralArg { text: "-o" }, v2.std.host_transport.LiteralArg { text: "fixture" }]
        }
      ],
      run: v2.std.host_transport.ProcessInvocation {
        program: v2.std.host_transport.ProducedProgram { path: "fixture" },
        args: []
      },
      runtime_value_codec: v2.std.host_transport.FixedWidthBytes { width: 5 }
    },
    runtime_primitive_type: c_emit_host_runtime_primitive_type_node()
  }
}

test fn c_add_emit_host_green_run_holds() -> Bool {
  match run_emit_host(
    target: c_target_model(),
    source: c_run_source(),
    fixture_inputs: c_run_inputs()
  ) {
    Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        Accepted { value: HostLogicalRun { stdout: stdout }, diagnostics: None } =>
          match runtime_value_parse(target: c_target_model(), stdout: stdout) {
            Accepted { value: _, diagnostics: _ } =>
              stdout.bytes == emit_host_octets_byte_string(octets: c_expected_add_stdout_octets())
            Rejected { diagnostics: _ } => false
          }
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn c_add_emit_host_inject_fault_refuses_holds() -> Bool {
  match c_inject_fault_runtime_row() {
    HostRuntimeRowAbsent => false
    HostRuntimeRowPresent { row: row } =>
      match run_host_process(
        row: row,
        target: c_target_model(),
        source: c_run_source(),
        fixture_inputs: c_run_inputs()
      ) {
        Accepted { value: receipt, diagnostics: _ } =>
          match receipt.logical_run {
            Accepted { value: HostLogicalRun { stdout: stdout }, diagnostics: None } =>
              match runtime_value_parse(target: c_target_model(), stdout: stdout) {
                Rejected { diagnostics: _ } => true
                Accepted { value: _, diagnostics: _ } =>
                  stdout.bytes != emit_host_octets_byte_string(octets: c_expected_add_stdout_octets())
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
  }
}

test fn c_add_emit_host_nonzero_exit_refuses_holds() -> Bool {
  match run_host_process(
    row: c_fixed_source_row(source_text: "int main(void) { return 3; }"),
    target: c_target_model(),
    source: c_run_source(),
    fixture_inputs: c_run_inputs()
  ) {
    Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        Rejected { diagnostics: _ } => true
        Accepted { value: _, diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn c_add_emit_host_byte_width_mismatch_refuses_holds() -> Bool {
  match run_host_process(
    row: c_fixed_source_row(source_text: "extern long write(int, const void *, unsigned long);\nint main(void) { unsigned char b[4] = {0, 0, 0, 0}; write(1, b, 4); return 0; }"),
    target: c_target_model(),
    source: c_run_source(),
    fixture_inputs: c_run_inputs()
  ) {
    Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        Accepted { value: HostLogicalRun { stdout: stdout }, diagnostics: None } =>
          match runtime_value_parse(target: c_target_model(), stdout: stdout) {
            Rejected { diagnostics: _ } => true
            Accepted { value: _, diagnostics: _ } => false
          }
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

