module v2.test.execution.loop_round_trip


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data loop_emitted_root: v2.std.node.Node = v2.extdeps.languages.dag.dag_fixture_emitted_loop_fn
data loop_target_model: v2.std.compilers.target_model.TargetModel = v2.extdeps.languages.dag.dag_loop_target_model()

fn loop_canonical_grounding(
  node: v2.std.node.Node,
  algebra: v2.std.node.Node
) -> v2.std.constraints.CanonicalGrounding {
  v2.std.constraints.CanonicalGrounding {
    node: node,
    witness: v2.std.constraints.CanonicalGroundingWitness {
      structural: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn loop_canonical_grounding_for(node: v2.std.node.Node) -> Witness<v2.std.constraints.CanonicalGrounding> {
  if node == v2.extdeps.languages.dag.dag_fixture_emitted_loop_fn {
    v2.std.witness.Holds {
      value: loop_canonical_grounding(node: node, algebra: node)
    }
  } else if node == v2.extdeps.languages.dag.dag_fixture_int_inhabitant {
    v2.std.witness.Holds {
      value: loop_canonical_grounding(node: node, algebra: node)
    }
  } else if node == v2.extdeps.languages.dag.dag_inhabitant_atom(id: ^dag_inhabitant_int) {
    v2.std.witness.Holds {
      value: loop_canonical_grounding(
        node: node,
        algebra: v2.extdeps.languages.dag.dag_fixture_int_inhabitant
      )
    }
  } else if node == v2.extdeps.languages.dag.dag_inhabitant_atom(id: ^dag_surface_spelling_int) {
    v2.std.witness.Holds {
      value: loop_canonical_grounding(
        node: node,
        algebra: v2.extdeps.languages.dag.dag_fixture_int_inhabitant
      )
    }
  } else if node == v2.extdeps.languages.dag.dag_type_atom_node(identity: ^dag_binding_type_int) {
    v2.std.witness.Holds {
      value: loop_canonical_grounding(
        node: node,
        algebra: v2.extdeps.languages.dag.dag_fixture_int_inhabitant
      )
    }
  } else if node == v2.extdeps.languages.dag.dag_type_atom_node(identity: ^dag_pick_lit_one) {
    v2.std.witness.Holds {
      value: loop_canonical_grounding(node: node, algebra: node)
    }
  } else if node == v2.extdeps.languages.dag.dag_type_atom_node(identity: ^dag_pick_lit_two) {
    v2.std.witness.Holds {
      value: loop_canonical_grounding(node: node, algebra: node)
    }
  } else if node == v2.extdeps.languages.dag.dag_loop_body_fixture {
    v2.std.witness.Holds {
      value: loop_canonical_grounding(node: node, algebra: node)
    }
  } else if node == v2.extdeps.languages.dag.dag_pick_arrow_domain_conj_node() {
    v2.std.witness.Holds {
      value: loop_canonical_grounding(node: node, algebra: node)
    }
  } else if node == v2.extdeps.languages.dag.dag_type_atom_node(identity: ^dag_binding_fn_one) {
    v2.std.witness.Holds {
      value: loop_canonical_grounding(node: node, algebra: node)
    }
  } else if node == v2.extdeps.languages.dag.dag_type_atom_node(identity: ^dag_loop_measure_sym) {
    v2.std.witness.Holds {
      value: loop_canonical_grounding(node: node, algebra: node)
    }
  } else {
    v2.std.witness.Violates {
      diagnostic: v2.std.diagnostic.Diagnostic {
        reason: ^loop_grounding_miss,
        at: v2.std.diagnostic.node_locus(node: node),
        correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
      }
    }
  }
}

data loop_descent_fabrication_dissolved_note: String = "The former loop_descent_witness_for hand-fabricated Holds { v2.std.cardinality.TerminationProof { strict: ^dag_loop_measure_sym } } for every loop node because the tag-only multiplicity path unconditionally refused loops. Body-lowering Stage 2 (measure_descent_fact_registry, v2.std.cardinality) derives that exact proof from the measure, so the fabrication is deleted and this test consumes the real derivation."

fn loop_descent_witness_for(node: v2.std.node.Node) -> Witness<v2.std.cardinality.TerminationProof> {
  v2.std.cardinality.termination_proof_witness_for_node(n: node)
}

fn loop_round_trip_inferred_facts_for(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  match loop_canonical_grounding_for(node: node) {
    v2.std.witness.Violates { diagnostic: d } => v2.std.optional.optional_absent()
    v2.std.witness.Holds { value: grounding } =>
      match loop_descent_witness_for(node: node) {
        v2.std.witness.Violates { diagnostic: d } => v2.std.optional.optional_absent()
        v2.std.witness.Holds { value: proof } =>
          v2.std.optional.optional_present(value: v2.test.lens_common.infer_fixture.claim_inferred_facts_witness(
              grounding: grounding,
              descent: v2.std.witness.Holds { value: proof }
            ))
      }
  }
}

fn loop_round_trip_facts_lookup(key: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  loop_round_trip_inferred_facts_for(node: key)
}

data loop_inferred_tree: v2.compiler.inferred_tree.InferredTree = v2.compiler.inferred_tree.InferredTree {
  root: loop_emitted_root,
  facts: PartialFunction {
    lookup: loop_round_trip_facts_lookup
  }
}

fn loop_emit_accepts() -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.compiler.emit.emit(tree: loop_inferred_tree, target: loop_target_model)
}

data loop_emit_receipt: v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> = loop_emit_accepts()

fn loop_coercion_quality_is_faithful(q: v2.std.coercion.CoercionQuality) -> Bool {
  match q {
    v2.std.coercion.Exact => true
    v2.std.coercion.Identity => true
    v2.std.coercion.Widened => false
  }
}

test fn loop_emit_matches_serialize_holds() -> Bool {
  match v2.compiler.translate.target_serialize_source_from_model(
    target: loop_target_model,
    emitted: loop_emitted_root
  ) {
    v2.std.diagnostic.Accepted { value: authority, diagnostics: ad } =>
      match loop_emit_receipt {
        v2.std.diagnostic.Accepted { value: source, diagnostics: d } =>
          (source == authority) && (d == v2.std.diagnostic.None) && (ad == v2.std.diagnostic.None)
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn loop_grammar_inverse_holds() -> Bool {
  match v2.compiler.translate.grammar_inverse_source_validated(
    target: loop_target_model,
    emitted: loop_emitted_root
  ) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: d } => d == v2.std.diagnostic.None
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn loop_ingest_via_coerce_matches_canonical() -> Bool {
  match v2.compiler.translate.coerce_grounded_node(
    source: loop_emitted_root,
    tree: loop_inferred_tree,
    target: loop_target_model
  ) {
    v2.std.diagnostic.Accepted { value: result, diagnostics: d } =>
      (result.target == v2.extdeps.languages.dag.dag_fixture_emitted_loop_fn)
        && loop_coercion_quality_is_faithful(q: result.quality)
        && (d == v2.std.diagnostic.None)
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

