module v2.test.execution.c_type_decl_emit_host_run


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn ctd_run_probe_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^c_type_decl_emit_host_run_probe } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn ctd_run_inputs() -> v2.compiler.eval.Inputs {
  v2.compiler.eval.inputs_root_only(root: ctd_run_probe_node())
}

fn ctd_empty_conj() -> v2.std.node.Node {
  v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Conj }, children: [], occurrence_id: v2.std.node.SyntheticOccurrence }
}

fn ctd_atom_type(name: Symbol) -> v2.std.node.Node {
  v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: name } }, children: [], occurrence_id: v2.std.node.SyntheticOccurrence }
}

fn ctd_field_edge(name: Symbol, type_name: Symbol) -> v2.std.node.Edge {
  v2.std.node.Edge { label: v2.std.node.Named { name: name }, target: ctd_atom_type(name: type_name) }
}

fn ctd_variant_edge(name: Symbol) -> v2.std.node.Edge {
  v2.std.node.Edge { label: v2.std.node.Named { name: name }, target: ctd_empty_conj() }
}

fn ctd_point_record() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      ctd_field_edge(name: ^x, type_name: ^Int),
      ctd_field_edge(name: ^y, type_name: ^Int)
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn ctd_bool_coproduct() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Disj },
    children: [ ctd_variant_edge(name: ^True), ctd_variant_edge(name: ^False) ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn ctd_emit_decl_source() -> extdeps.communication.medium.Medium<String> {
  match v2.compiler.emit_semantic_decl.emit_semantic_type_decl(name: ^Point, params: std.algebra.Empty, node: ctd_point_record(), target: v2.extdeps.languages.c.c_type_decl_target_model()) {
    v2.std.diagnostic.Accepted { value: point, diagnostics: _ } =>
      match v2.compiler.emit_semantic_decl.emit_semantic_type_decl(name: ^Bool, params: std.algebra.Empty, node: ctd_bool_coproduct(), target: v2.extdeps.languages.c.c_type_decl_target_model()) {
        v2.std.diagnostic.Accepted { value: bool_decl, diagnostics: _ } =>
          extdeps.communication.medium.Medium {
            carried: concat(concat(point.carried, bool_decl.carried), "\n"),
            fidelity: extdeps.communication.medium.Lossless
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } =>
          extdeps.communication.medium.Medium { carried: "", fidelity: extdeps.communication.medium.Lossless }
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } =>
      extdeps.communication.medium.Medium { carried: "", fidelity: extdeps.communication.medium.Lossless }
  }
}

fn ctd_expected_stdout_octets() -> List<Int> {
  [0, 5, 0, 0, 0]
}

test fn c_type_decl_emit_host_green_run_holds() -> Bool {
  match v2.compiler.emit_host.run_emit_host(
    target: v2.extdeps.languages.c.c_type_decl_target_model(),
    source: ctd_emit_decl_source(),
    fixture_inputs: ctd_run_inputs()
  ) {
    v2.std.diagnostic.Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        v2.std.diagnostic.Accepted { value: v2.std.host_run.HostLogicalRun { stdout: stdout }, diagnostics: v2.std.diagnostic.None } =>
          match v2.compiler.emit_host.runtime_value_parse(target: v2.extdeps.languages.c.c_type_decl_target_model(), stdout: stdout) {
            v2.std.diagnostic.Accepted { value: _, diagnostics: _ } =>
              stdout.bytes == v2.compiler.emit_host.emit_host_octets_byte_string(octets: ctd_expected_stdout_octets())
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
          }
        _ => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn c_type_decl_emit_host_inject_fault_refuses_holds() -> Bool {
  match v2.extdeps.languages.c.c_type_decl_inject_fault_runtime_row() {
    v2.std.host_transport.HostRuntimeRowAbsent => false
    v2.std.host_transport.HostRuntimeRowPresent { row: row } =>
      match v2.compiler.emit_host.run_host_process(
        row: row,
        target: v2.extdeps.languages.c.c_type_decl_target_model(),
        source: ctd_emit_decl_source(),
        fixture_inputs: ctd_run_inputs()
      ) {
        v2.std.diagnostic.Accepted { value: receipt, diagnostics: _ } =>
          match receipt.logical_run {
            v2.std.diagnostic.Accepted { value: v2.std.host_run.HostLogicalRun { stdout: stdout }, diagnostics: v2.std.diagnostic.None } =>
              match v2.compiler.emit_host.runtime_value_parse(target: v2.extdeps.languages.c.c_type_decl_target_model(), stdout: stdout) {
                v2.std.diagnostic.Rejected { diagnostics: _ } => true
                v2.std.diagnostic.Accepted { value: _, diagnostics: _ } =>
                  stdout.bytes != v2.compiler.emit_host.emit_host_octets_byte_string(octets: ctd_expected_stdout_octets())
              }
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
  }
}

