module v2.test.execution.c_type_decl_emit_host_run


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn ctd_run_probe_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^c_type_decl_emit_host_run_probe } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn ctd_run_inputs() -> Inputs {
  inputs_root_only(root: ctd_run_probe_node())
}

fn ctd_empty_conj() -> Node {
  Node { kind: TypeNode { connective: Conj }, children: [], occurrence_id: SyntheticOccurrence }
}

fn ctd_atom_type(name: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: name } }, children: [], occurrence_id: SyntheticOccurrence }
}

fn ctd_field_edge(name: Symbol, type_name: Symbol) -> Edge {
  Edge { label: Named { name: name }, target: ctd_atom_type(name: type_name) }
}

fn ctd_variant_edge(name: Symbol) -> Edge {
  Edge { label: Named { name: name }, target: ctd_empty_conj() }
}

fn ctd_point_record() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ctd_field_edge(name: ^x, type_name: ^Int),
      ctd_field_edge(name: ^y, type_name: ^Int)
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn ctd_bool_coproduct() -> Node {
  Node {
    kind: TypeNode { connective: Disj },
    children: [ ctd_variant_edge(name: ^True), ctd_variant_edge(name: ^False) ],
    occurrence_id: SyntheticOccurrence
  }
}

fn ctd_emit_decl_source() -> Medium<String> {
  match emit_semantic_type_decl(name: ^Point, params: Empty, node: ctd_point_record(), target: c_type_decl_target_model()) {
    Accepted { value: point, diagnostics: _ } =>
      match emit_semantic_type_decl(name: ^Bool, params: Empty, node: ctd_bool_coproduct(), target: c_type_decl_target_model()) {
        Accepted { value: bool_decl, diagnostics: _ } =>
          Medium {
            carried: concat(concat(point.carried, bool_decl.carried), "\n"),
            fidelity: Lossless
          }
        Rejected { diagnostics: _ } =>
          Medium { carried: "", fidelity: Lossless }
      }
    Rejected { diagnostics: _ } =>
      Medium { carried: "", fidelity: Lossless }
  }
}

fn ctd_expected_stdout_octets() -> List<Int> {
  [0, 5, 0, 0, 0]
}

test fn c_type_decl_emit_host_green_run_holds() -> Bool {
  match run_emit_host(
    target: c_type_decl_target_model(),
    source: ctd_emit_decl_source(),
    fixture_inputs: ctd_run_inputs()
  ) {
    Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        Accepted { value: HostLogicalRun { stdout: stdout }, diagnostics: None } =>
          match runtime_value_parse(target: c_type_decl_target_model(), stdout: stdout) {
            Accepted { value: _, diagnostics: _ } =>
              stdout.bytes == emit_host_octets_byte_string(octets: ctd_expected_stdout_octets())
            Rejected { diagnostics: _ } => false
          }
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn c_type_decl_emit_host_inject_fault_refuses_holds() -> Bool {
  match c_type_decl_inject_fault_runtime_row() {
    HostRuntimeRowAbsent => false
    HostRuntimeRowPresent { row: row } =>
      match run_host_process(
        row: row,
        target: c_type_decl_target_model(),
        source: ctd_emit_decl_source(),
        fixture_inputs: ctd_run_inputs()
      ) {
        Accepted { value: receipt, diagnostics: _ } =>
          match receipt.logical_run {
            Accepted { value: HostLogicalRun { stdout: stdout }, diagnostics: None } =>
              match runtime_value_parse(target: c_type_decl_target_model(), stdout: stdout) {
                Rejected { diagnostics: _ } => true
                Accepted { value: _, diagnostics: _ } =>
                  stdout.bytes != emit_host_octets_byte_string(octets: ctd_expected_stdout_octets())
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
  }
}

test fn c_type_decl_emit_host_run_all_holds() -> Bool {
  c_type_decl_emit_host_green_run_holds()
    && c_type_decl_emit_host_inject_fault_refuses_holds()
}
