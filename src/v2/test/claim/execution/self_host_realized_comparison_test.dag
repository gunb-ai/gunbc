module v2.test.execution.self_host_realized_comparison

import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  Node,
  TypeNode,
  SyntheticOccurrence
}
import v2.compiler.self_host {
  fixed_point_scaffold,
  fold_side_bytes,
  source_models_from_manifest_and_roots
}
import v2.std.witness { Holds, Violates }
import tools.self_host_realized_comparison_transport {
  realized_comparison_committed_src_root,
  realized_comparison_emitted_src_root,
  realized_comparison_roster_manifest_path
}

fn realized_comparison_fixture_leaf() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^realized_comparison_fixture_leaf } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

test fn self_host_realized_comparison_reads_real_bytes_both_sides_holds() -> Bool {
  let stage1_folded = fold_side_bytes(
    root: realized_comparison_committed_src_root,
    roster: ["lib.rs"]
  )
  let stage2_folded = fold_side_bytes(
    root: realized_comparison_emitted_src_root,
    roster: ["lib.rs"]
  )
  string_contains(stage1_folded, "Generated by v1 compiler")
  && string_contains(stage2_folded, "Generated by v1 compiler")
}

test fn self_host_realized_comparison_staleness_gate_holds() -> Bool {
  let models = source_models_from_manifest_and_roots(
    committed_root: realized_comparison_committed_src_root,
    emitted_root: realized_comparison_emitted_src_root,
    manifest_path: realized_comparison_roster_manifest_path
  )
  match fixed_point_scaffold(
    stage1_node: realized_comparison_fixture_leaf(),
    stage2_node: realized_comparison_fixture_leaf(),
    source_models: models
  ) {
    Holds { value: _ } => true
    Violates { diagnostic: _ } => false
  }
}
