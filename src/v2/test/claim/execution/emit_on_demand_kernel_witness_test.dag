module v2.test.execution.emit_on_demand_kernel_witness

import std.logic { Bool }
import std.types { ContentHash, String }
import std.content_hash { content_hash_atom }
import std.measure { ByteSize, byte_size }
import std.materialization_ladder {
  CacheProvider, CoversAllComputations, ArtifactTier, ContentKeyed, SpacePacked, provider_row,
}
import std.artifact_store {
  ArtifactStore, StoreReady, StoreRefusedEviction, store_over_provider, store_put,
}
import std.realization { Share, Recompute }
import std.realize_pack {
  BudgetUnreadable, PackedWidth, MaturationReserve, BudgetRefused,
}
import std.emit_on_demand { emit_on_demand_family_cache_root }
import std.emit_on_demand {
  SourceArtifact, NativeArtifact,
  emit_on_demand_key, emit_on_demand_lookup,
  materialization_for_lookup, EmitOnDemandHit, EmitOnDemandMiss,
  interpreter_surviving_roles_bounded,
}
import v2.std.emit_on_demand { witness_family_realize_width }
import extdeps.realization.emit_on_demand_host {
  native_cache_workspace_root, emit_on_demand_evict_native_cache,
}
import v2.compiler.emit { emit }
import extdeps.communication.medium { Medium }
import v2.compiler.emit_host {
  emit_host_octets_byte_string,
  emit_host_no_run_args,
  run_emit_host_cached,
  run_test_claim_from_source_emit_vs_eval_cached,
}
import v2.compiler.eval {
  TestClaimEvalSubject,
  Inputs,
  eval_test_claim_subject,
  inputs_for_emit_host,
  inferred_tree_digest,
}
import v2.compiler.infer { InferredTree }
import v2.extdeps.languages.rust { rust_target_model_staging, rust_fixture_emitted_add_fn }
import v2.test.manual.eval_runtime { eval_add_subgraph_node }
import v2.test.manual.rust_add_emit_translate { rust_add_inferred_tree }
import v2.test.execution.emit_host_add_equals_eval {
  emit_eval_context,
  emit_eval_claim,
  emit_eval_subject_tree,
  emit_eval_verdict_is_pass,
  emit_eval_verdict_is_semantic_mismatch,
  emit_eval_call_primitive_five,
  emit_eval_call_primitive_six,
}
import v2.std.collection { List }
import v2.std.diagnostic { Accepted, Rejected, Outcome }
import v2.std.runtime { RuntimeValue, EvaluationEnvironment }
import v2.std.host_run { HostLogicalRun }
import v2.std.node { Node }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data emit_on_demand_kernel_note: String = "Witness-realization kernel ACCEPT witnesses (plan P3) for the emit_host_add family — the serial kernel's first customer, consolidated to ONE-BUILD grain (std.emit_on_demand witness_family_build_grain_ruling, merry-pike-487 fan-out): the singleton family's crate is built ONCE per corpus pass. The single wet receipt is emit_on_demand_kernel_native_one_build_holds: one root, both keys evicted up front; primary cold then warm (compile_skipped octet receipts), the eval-anchored agreement (run_test_claim_from_source_emit_vs_eval_cached, oracle = eval, primitive-five subject) and the wrong-oracle RED (primitive-six subject -> semantic mismatch) run WARM on the same build, then the changed-tree alt key colds in the SAME root (cache-impurity MISS discriminator). Formerly ~7 crate builds per pass (per-test eviction roots + 2 uncached agreement runs); now 2. Pure receipts unchanged. Workspace path suffix is emit_on_demand_key(inferred_tree_digest(tree), ...), not test_id."

data kernel_cache_root: String = emit_on_demand_family_cache_root(family: "kernel")
data kernel_emitter: String = "v2.compiler.emit"
data kernel_provider: CacheProvider = provider_row(
  id: "emit-on-demand-kernel",
  scope: [],
  coverage: CoversAllComputations,
  tier: ArtifactTier { keying: ContentKeyed },
  eviction: SpacePacked { budget: "kernel native cache" }
)

fn kernel_closure_digest() -> ContentHash {
  content_hash_atom(value: "emit-host-add-kernel-fixture")
}

fn kernel_native_key_for(tree: InferredTree) -> ContentHash {
  emit_on_demand_key(
    closure_digest: inferred_tree_digest(tree: tree),
    emitter_identity: kernel_emitter,
    target_language: "rust",
    grain: NativeArtifact
  )
}

fn kernel_native_key() -> ContentHash {
  kernel_native_key_for(tree: emit_eval_subject_tree())
}

fn kernel_alt_subject_tree() -> InferredTree {
  InferredTree {
    root: rust_fixture_emitted_add_fn,
    facts: rust_add_inferred_tree.facts
  }
}

fn kernel_test_store() -> ArtifactStore {
  match store_over_provider(provider: kernel_provider, budget: byte_size(count: 1000000)) {
    StoreReady { store: s } => s
    StoreRefusedEviction { provider_id: _, declared: _ } =>
      ArtifactStore { budget: byte_size(count: 0), next_ordinal: 1, rows: [] }
  }
}

test fn emit_on_demand_grain_keys_differ_holds() -> Bool {
  let digest = kernel_closure_digest()
  let source = emit_on_demand_key(
    closure_digest: digest,
    emitter_identity: kernel_emitter,
    target_language: "rust",
    grain: SourceArtifact
  )
  let native = emit_on_demand_key(
    closure_digest: digest,
    emitter_identity: kernel_emitter,
    target_language: "rust",
    grain: NativeArtifact
  )
  (source == native) == false
}

test fn emit_on_demand_materialize_share_on_hit_holds() -> Bool {
  let key = kernel_native_key()
  let put = store_put(store: kernel_test_store(), key: key, artifact_bytes: byte_size(count: 64))
  let lookup = emit_on_demand_lookup(store: put.store, key: key)
  match lookup {
    EmitOnDemandHit { receipt: r } =>
      r.compile_skipped
        && materialization_for_lookup(lookup: lookup) == Share
    EmitOnDemandMiss => false
  }
}

test fn emit_on_demand_materialize_recompute_on_miss_holds() -> Bool {
  let lookup = emit_on_demand_lookup(
    store: kernel_test_store(),
    key: kernel_native_key()
  )
  match lookup {
    EmitOnDemandMiss => materialization_for_lookup(lookup: lookup) == Recompute
    EmitOnDemandHit { receipt: _ } => false
  }
}

test fn emit_on_demand_interpreter_roles_bounded_holds() -> Bool {
  interpreter_surviving_roles_bounded()
}

test fn emit_on_demand_schedule_refuses_unreadable_budget_holds() -> Bool {
  match witness_family_realize_width(
    bound_bytes: byte_size(count: 25),
    budget: BudgetUnreadable,
    witness_root: emit_eval_subject_tree().root,
    independence_override: 4
  ) {
    BudgetRefused => true
    PackedWidth { width: _ } => false
    MaturationReserve { width: _ } => false
  }
}

fn kernel_add_subject(call_primitive: fn(Node, List<RuntimeValue>, EvaluationEnvironment) -> Outcome<RuntimeValue>) -> TestClaimEvalSubject<Node> {
  eval_test_claim_subject(
    claim: emit_eval_claim(rhs_result_node: eval_add_subgraph_node),
    context: emit_eval_context(call_primitive: call_primitive),
    tree: emit_eval_subject_tree(),
    evaluator_pin: ^emit_eval_evaluator_pin
  )
}

fn kernel_add_fixture_inputs() -> Inputs {
  inputs_for_emit_host(
    claim_input_root: eval_add_subgraph_node,
    expected_eval_root: eval_add_subgraph_node,
    claim_pin: ^emit_eval_evaluator_pin
  )
}

fn kernel_cached_run_with_source_for_tree(
  workspace: String,
  tree: InferredTree,
  source: Medium<String>,
  expect_compile_skipped: Bool
) -> Bool {
  match run_emit_host_cached(
    workspace_dir: workspace,
    target: rust_target_model_staging(),
    source: source,
    fixture_inputs: kernel_add_fixture_inputs()
  ) {
    Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        Accepted {
          value: HostLogicalRun { stdout: stdout },
          diagnostics: None
        } =>
          receipt.compile_skipped == expect_compile_skipped
            && stdout.bytes == emit_host_octets_byte_string(octets: [0, 5, 0, 0, 0])
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn kernel_cache_root_for(test_id: String) -> String {
  concat(kernel_cache_root, "/", test_id)
}

fn kernel_cached_run_checks_for_tree(
  workspace: String,
  tree: InferredTree,
  expect_compile_skipped: Bool
) -> Bool {
  match emit(tree: tree, target: rust_target_model_staging()) {
    Accepted { value: source, diagnostics: _ } =>
      kernel_cached_run_with_source_for_tree(
        workspace: workspace,
        tree: tree,
        source: source,
        expect_compile_skipped: expect_compile_skipped
      )
    Rejected { diagnostics: _ } => false
  }
}

fn kernel_cached_cold_then_warm_for_tree(workspace: String, tree: InferredTree) -> Bool {
  match emit(tree: tree, target: rust_target_model_staging()) {
    Accepted { value: source, diagnostics: _ } =>
      kernel_cached_run_with_source_for_tree(
        workspace: workspace,
        tree: tree,
        source: source,
        expect_compile_skipped: false
      )
        && kernel_cached_run_with_source_for_tree(
          workspace: workspace,
          tree: tree,
          source: source,
          expect_compile_skipped: true
        )
    Rejected { diagnostics: _ } => false
  }
}

fn kernel_cached_agreement_pass(workspace: String) -> Bool {
  emit_eval_verdict_is_pass(
    run: run_test_claim_from_source_emit_vs_eval_cached(
      subject: kernel_add_subject(call_primitive: emit_eval_call_primitive_five),
      source_outcome: emit(tree: emit_eval_subject_tree(), target: rust_target_model_staging()),
      target: rust_target_model_staging(),
      workspace_dir: workspace,
      run_args: emit_host_no_run_args()
    )
  )
}

fn kernel_cached_wrong_oracle_mismatch(workspace: String) -> Bool {
  emit_eval_verdict_is_semantic_mismatch(
    run: run_test_claim_from_source_emit_vs_eval_cached(
      subject: kernel_add_subject(call_primitive: emit_eval_call_primitive_six),
      source_outcome: emit(tree: emit_eval_subject_tree(), target: rust_target_model_staging()),
      target: rust_target_model_staging(),
      workspace_dir: workspace,
      run_args: emit_host_no_run_args()
    )
  )
}

test fn emit_on_demand_closure_keys_differ_for_distinct_trees_holds() -> Bool {
  let key_primary = kernel_native_key_for(tree: emit_eval_subject_tree())
  let key_alt = kernel_native_key_for(tree: kernel_alt_subject_tree())
  key_primary != key_alt
}

test fn emit_on_demand_kernel_native_one_build_holds() -> Bool {
  let shared_parent = kernel_cache_root_for(test_id: "native_one_build")
  let tree_primary = emit_eval_subject_tree()
  let tree_alt = kernel_alt_subject_tree()
  let key_primary = kernel_native_key_for(tree: tree_primary)
  let key_alt = kernel_native_key_for(tree: tree_alt)
  if key_primary == key_alt {
    false
  } else {
    let workspace_primary = native_cache_workspace_root(
      cache_root: shared_parent,
      key: key_primary
    )
    let _evict_primary = emit_on_demand_evict_native_cache(
      cache_root: shared_parent,
      key: key_primary
    )
    let _evict_alt = emit_on_demand_evict_native_cache(
      cache_root: shared_parent,
      key: key_alt
    )
    let warmed = kernel_cached_cold_then_warm_for_tree(
      workspace: workspace_primary,
      tree: tree_primary
    )
    let workspace_alt = native_cache_workspace_root(
      cache_root: shared_parent,
      key: key_alt
    )
    warmed
      && kernel_cached_agreement_pass(workspace: workspace_primary)
      && kernel_cached_wrong_oracle_mismatch(workspace: workspace_primary)
      && kernel_cached_run_checks_for_tree(
        workspace: workspace_alt,
        tree: tree_alt,
        expect_compile_skipped: false
      )
  }
}

