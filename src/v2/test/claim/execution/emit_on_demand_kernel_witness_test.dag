module v2.test.execution.emit_on_demand_kernel_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = ReadsLiveTree

data emit_on_demand_kernel_note: String = "Witness-realization kernel ACCEPT witnesses (plan P3) for the emit_host_add family — the serial kernel's first customer, consolidated to ONE-BUILD grain (std.emit_on_demand witness_family_build_grain_ruling, merry-pike-487 fan-out): the singleton family's crate is built ONCE per corpus pass. The single wet receipt is emit_on_demand_kernel_native_one_build_holds: one root, both keys evicted up front; primary cold then warm (compile_skipped octet receipts), the eval-anchored agreement (run_test_claim_from_source_emit_vs_eval_cached, oracle = eval, primitive-five subject) and the wrong-oracle RED (primitive-six subject -> semantic mismatch) run WARM on the same build, then the changed-tree alt key colds in the SAME root (cache-impurity MISS discriminator). Formerly ~7 crate builds per pass (per-test eviction roots + 2 uncached agreement runs); now 2. Pure receipts unchanged. Workspace path suffix is std.emit_on_demand.emit_on_demand_key(inferred_tree_digest(tree), ...), not test_id."

data kernel_cache_root: String = std.emit_on_demand.emit_on_demand_family_cache_root(family: "kernel")
data kernel_emitter: String = "v2.compiler.emit"
data kernel_provider: std.materialization_ladder.CacheProvider = std.materialization_ladder.provider_row(
  id: "emit-on-demand-kernel",
  scope: [],
  coverage: std.materialization_ladder.CoversAllComputations,
  tier: std.materialization_ladder.ArtifactTier { keying: std.materialization_ladder.ContentKeyed },
  retention: std.materialization_ladder.persistent_retention(capacity: std.cache_interface.CapacityBounded { limit: std.cache_interface.ByteCapacity { limit: std.cache_interface.ExactLimit { value: std.measure.byte_size(count: 1000000) } }, at_capacity: std.cache_interface.ReplaceExisting { strategy: std.cache_interface.LeastRecentlyUsed } })
)

fn kernel_closure_digest() -> std.content_hash.Fnv1a64Structural {
  std.content_hash.content_hash_atom(value: "emit-host-add-kernel-fixture")
}

fn kernel_native_key_for(tree: v2.compiler.inferred_tree.InferredTree) -> std.content_hash.ContentHash {
  std.emit_on_demand.emit_on_demand_key(
    closure_digest: v2.compiler.eval.inferred_tree_digest(tree: tree),
    emitter_identity: kernel_emitter,
    target_language: "rust",
    grain: std.emit_on_demand.NativeArtifact
  )
}

fn kernel_native_key() -> std.content_hash.ContentHash {
  kernel_native_key_for(tree: v2.test.execution.emit_host_add_equals_eval.emit_eval_subject_tree())
}

fn kernel_alt_subject_tree() -> v2.compiler.inferred_tree.InferredTree {
  v2.compiler.inferred_tree.InferredTree {
    root: v2.extdeps.languages.rust.rust_fixture_emitted_add_fn,
    facts: v2.test.manual.rust_add_emit_translate.rust_add_inferred_tree.facts
  }
}

fn kernel_test_store() -> std.artifact_store.ArtifactStore {
  match std.artifact_store.store_over_provider(provider: kernel_provider) {
    StoreReady { store: s } => s
    StoreRefusedRetention { provider_id: _, declared: _ } =>
      std.artifact_store.ArtifactStore { budget: std.measure.byte_size(count: 0), next_ordinal: 1, rows: [] }
  }
}

test fn emit_on_demand_grain_keys_differ_holds() -> Bool {
  let digest = kernel_closure_digest()
  let source = std.emit_on_demand.emit_on_demand_key(
    closure_digest: digest,
    emitter_identity: kernel_emitter,
    target_language: "rust",
    grain: std.emit_on_demand.SourceArtifact
  )
  let native = std.emit_on_demand.emit_on_demand_key(
    closure_digest: digest,
    emitter_identity: kernel_emitter,
    target_language: "rust",
    grain: std.emit_on_demand.NativeArtifact
  )
  (source == native) == false
}

test fn emit_on_demand_materialize_share_on_hit_holds() -> Bool {
  let key = kernel_native_key()
  std.artifact_store.store_put_fold(
    outcome: std.artifact_store.store_put(store: kernel_test_store(), key: key, artifact_bytes: std.measure.byte_size(count: 64)),
    admitted: fn(put_store, evicted) {
      let lookup = std.emit_on_demand.emit_on_demand_lookup(store: put_store, key: key)
      match lookup {
        EmitOnDemandHit { receipt: r } =>
          r.compile_skipped
            && std.emit_on_demand.materialization_for_lookup(lookup: lookup) == std.realization.Share
        EmitOnDemandMiss => false
      }
    },
    did_not_fit: (a, b) => false
  )
}

test fn emit_on_demand_materialize_recompute_on_miss_holds() -> Bool {
  let lookup = std.emit_on_demand.emit_on_demand_lookup(
    store: kernel_test_store(),
    key: kernel_native_key()
  )
  match lookup {
    EmitOnDemandMiss => std.emit_on_demand.materialization_for_lookup(lookup: lookup) == std.realization.Recompute
    EmitOnDemandHit { receipt: _ } => false
  }
}

test fn emit_on_demand_interpreter_roles_bounded_holds() -> Bool {
  std.emit_on_demand.interpreter_surviving_roles_bounded()
}

fn wet_surface_is_enrolled(id: String) -> Bool {
  v2.std.algebra.any(std.emit_on_demand.interpreter_wet_surfaces, surface => surface.id == id)
}

test fn emit_on_demand_wet_effect_surfaces_role_enrolled_holds() -> Bool {
  v2.std.algebra.any(std.emit_on_demand.interpreter_surviving_roles, role => role.id == "wet-effect-surfaces")
    && wet_surface_is_enrolled(id: std.emit_on_demand.gunbc_serve_wet_surface.id)
    && wet_surface_is_enrolled(id: std.emit_on_demand.main_wet_regen_surface.id)
    && wet_surface_is_enrolled(id: std.emit_on_demand.gunbc_ci_emission_surface.id)
    && wet_surface_is_enrolled(id: std.emit_on_demand.pre_push_transport_surface.id)
    && wet_surface_is_enrolled(id: std.emit_on_demand.probe_bins_surface.id)
}

test fn emit_on_demand_wet_effect_surfaces_role_dissolves_at_zero_holds() -> Bool {
  !v2.std.algebra.any(
    std.emit_on_demand.interpreter_surviving_roles_from_wet_surfaces(wet_surfaces: []),
    role => role.id == "wet-effect-surfaces"
  )
}

test fn emit_on_demand_schedule_refuses_unreadable_budget_holds() -> Bool {
  match v2.std.emit_on_demand.witness_family_realize_width(
    bound_bytes: std.measure.byte_size(count: 25),
    budget: BudgetUnreadable,
    witness_root: v2.test.execution.emit_host_add_equals_eval.emit_eval_subject_tree().root,
    independence_override: 4
  ) {
    BudgetRefused => true
    PackedWidth { width: _ } => false
    MaturationReserve { width: _ } => false
  }
}

fn kernel_add_subject(
  call_primitive: fn(v2.std.node.Node, std.types.List<v2.std.runtime.RuntimeValue>, v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue>,
  call_primitive_identity: v2.std.node.Symbol
) -> v2.compiler.eval.TestClaimEvalSubject<v2.std.node.Node> {
  v2.compiler.eval.eval_test_claim_subject(
    claim: v2.test.execution.emit_host_add_equals_eval.emit_eval_claim(rhs_result_node: v2.test.manual.eval_runtime.eval_add_subgraph_node),
    context: v2.test.execution.emit_host_add_equals_eval.emit_eval_context(call_primitive: call_primitive, call_primitive_identity: call_primitive_identity),    tree: v2.test.execution.emit_host_add_equals_eval.emit_eval_subject_tree(),
    evaluator_pin: ^emit_eval_evaluator_pin
  )
}

fn kernel_add_fixture_inputs() -> v2.compiler.eval.Inputs {
  v2.compiler.eval.inputs_for_emit_host(
    claim_input_root: v2.test.manual.eval_runtime.eval_add_subgraph_node,
    expected_eval_root: v2.test.manual.eval_runtime.eval_add_subgraph_node,
    claim_pin: ^emit_eval_evaluator_pin
  )
}

fn kernel_cached_run_with_source_for_tree(
  workspace: String,
  tree: v2.compiler.inferred_tree.InferredTree,
  source: extdeps.communication.medium.Medium<String>,
  expect_compile_skipped: Bool
) -> Bool {
  match v2.compiler.emit_host.run_emit_host_cached(
    workspace_dir: workspace,
    target: v2.extdeps.languages.rust.rust_target_model_staging(),
    source: source,
    fixture_inputs: kernel_add_fixture_inputs()
  ) {
    Accepted { value: receipt, diagnostics: _ } =>
      match receipt.logical_run {
        Accepted {
          value: v2.std.host_run.HostLogicalRun { stdout: stdout },
          diagnostics: None
        } =>
          receipt.compile_skipped == expect_compile_skipped
            && stdout.bytes == v2.compiler.emit_host.emit_host_octets_byte_string(octets: [0, 5, 0, 0, 0])
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn kernel_cache_root_for(test_id: String) -> String {
  concat(kernel_cache_root, "/", test_id)
}

fn kernel_cached_run_checks_for_tree(
  workspace: String,
  tree: v2.compiler.inferred_tree.InferredTree,
  expect_compile_skipped: Bool
) -> Bool {
  match v2.compiler.emit.emit(tree: tree, target: v2.extdeps.languages.rust.rust_target_model_staging()) {
    Accepted { value: source, diagnostics: _ } =>
      kernel_cached_run_with_source_for_tree(
        workspace: workspace,
        tree: tree,
        source: source,
        expect_compile_skipped: expect_compile_skipped
      )
    Rejected { diagnostics: _ } => false
  }
}

fn kernel_cached_cold_then_warm_for_tree(workspace: String, tree: v2.compiler.inferred_tree.InferredTree) -> Bool {
  match v2.compiler.emit.emit(tree: tree, target: v2.extdeps.languages.rust.rust_target_model_staging()) {
    Accepted { value: source, diagnostics: _ } =>
      kernel_cached_run_with_source_for_tree(
        workspace: workspace,
        tree: tree,
        source: source,
        expect_compile_skipped: false
      )
        && kernel_cached_run_with_source_for_tree(
          workspace: workspace,
          tree: tree,
          source: source,
          expect_compile_skipped: true
        )
    Rejected { diagnostics: _ } => false
  }
}

fn kernel_cached_agreement_pass(workspace: String) -> Bool {
  v2.test.execution.emit_host_add_equals_eval.emit_eval_verdict_is_pass(
    run: v2.compiler.emit_host.run_test_claim_from_source_emit_vs_eval_cached(
      subject: kernel_add_subject(
        call_primitive: v2.test.execution.emit_host_add_equals_eval.emit_eval_call_primitive_five,
        call_primitive_identity: ^v2.test.execution.emit_host_add_equals_eval.emit_eval_call_primitive_five
      ),
      source_outcome: v2.compiler.emit.emit(tree: v2.test.execution.emit_host_add_equals_eval.emit_eval_subject_tree(), target: v2.extdeps.languages.rust.rust_target_model_staging()),
      target: v2.extdeps.languages.rust.rust_target_model_staging(),
      workspace_dir: workspace,
      run_args: v2.compiler.emit_host.emit_host_no_run_args()
    )
  )
}

fn kernel_cached_wrong_oracle_mismatch(workspace: String) -> Bool {
  v2.test.execution.emit_host_add_equals_eval.emit_eval_verdict_is_semantic_mismatch(
    run: v2.compiler.emit_host.run_test_claim_from_source_emit_vs_eval_cached(
      subject: kernel_add_subject(
        call_primitive: v2.test.execution.emit_host_add_equals_eval.emit_eval_call_primitive_six,
        call_primitive_identity: ^v2.test.execution.emit_host_add_equals_eval.emit_eval_call_primitive_six
      ),
      source_outcome: v2.compiler.emit.emit(tree: v2.test.execution.emit_host_add_equals_eval.emit_eval_subject_tree(), target: v2.extdeps.languages.rust.rust_target_model_staging()),
      target: v2.extdeps.languages.rust.rust_target_model_staging(),
      workspace_dir: workspace,
      run_args: v2.compiler.emit_host.emit_host_no_run_args()
    )
  )
}

test fn emit_on_demand_closure_keys_differ_for_distinct_trees_holds() -> Bool {
  let key_primary = kernel_native_key_for(tree: v2.test.execution.emit_host_add_equals_eval.emit_eval_subject_tree())
  let key_alt = kernel_native_key_for(tree: kernel_alt_subject_tree())
  key_primary != key_alt
}

test fn emit_on_demand_kernel_native_one_build_holds() -> Bool {
  let shared_parent = kernel_cache_root_for(test_id: "native_one_build")
  let tree_primary = v2.test.execution.emit_host_add_equals_eval.emit_eval_subject_tree()
  let tree_alt = kernel_alt_subject_tree()
  let key_primary = kernel_native_key_for(tree: tree_primary)
  let key_alt = kernel_native_key_for(tree: tree_alt)
  if key_primary == key_alt {
    false
  } else {
    let workspace_primary = extdeps.realization.emit_on_demand_host.native_cache_workspace_root(
      cache_root: shared_parent,
      key: key_primary
    )
    let _evict_primary = extdeps.realization.emit_on_demand_host.emit_on_demand_evict_native_cache(
      cache_root: shared_parent,
      key: key_primary
    )
    let _evict_alt = extdeps.realization.emit_on_demand_host.emit_on_demand_evict_native_cache(
      cache_root: shared_parent,
      key: key_alt
    )
    let warmed = kernel_cached_cold_then_warm_for_tree(
      workspace: workspace_primary,
      tree: tree_primary
    )
    let workspace_alt = extdeps.realization.emit_on_demand_host.native_cache_workspace_root(
      cache_root: shared_parent,
      key: key_alt
    )
    warmed
      && kernel_cached_agreement_pass(workspace: workspace_primary)
      && kernel_cached_wrong_oracle_mismatch(workspace: workspace_primary)
      && kernel_cached_run_checks_for_tree(
        workspace: workspace_alt,
        tree: tree_alt,
        expect_compile_skipped: false
      )
  }
}
