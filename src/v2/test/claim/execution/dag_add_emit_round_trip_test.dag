module v2.test.execution.dag_add_emit_round_trip



data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly
data dag_add_emitted_root: v2.std.node.Node = v2.extdeps.languages.dag.dag_fixture_emitted_add_fn

data dag_add_target_model: v2.std.compilers.target_model.TargetModel = v2.extdeps.languages.dag.dag_target_model()

fn dag_add_canonical_grounding(
  node: v2.std.node.Node,
  algebra: v2.std.node.Node
) -> v2.std.constraints.CanonicalGrounding {
  v2.std.constraints.CanonicalGrounding {
    node: node,
    witness: v2.std.constraints.CanonicalGroundingWitness {
      structural: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn dag_add_canonical_grounding_for(node: v2.std.node.Node) -> Witness<v2.std.constraints.CanonicalGrounding> {
  if node == v2.extdeps.languages.dag.dag_fixture_emitted_add_fn {
    v2.std.witness.Holds {
      value: dag_add_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == v2.extdeps.languages.dag.dag_fixture_int_inhabitant {
    v2.std.witness.Holds {
      value: dag_add_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == v2.extdeps.languages.dag.dag_inhabitant_atom(id: ^dag_inhabitant_int) {
    v2.std.witness.Holds {
      value: dag_add_canonical_grounding(
        node: node,
        algebra: v2.extdeps.languages.dag.dag_fixture_int_inhabitant
      )
    }
  } else if node == v2.extdeps.languages.dag.dag_inhabitant_atom(id: ^dag_surface_spelling_int) {
    v2.std.witness.Holds {
      value: dag_add_canonical_grounding(
        node: node,
        algebra: v2.extdeps.languages.dag.dag_fixture_int_inhabitant
      )
    }
  } else {
    v2.std.witness.Violates {
      diagnostic: v2.std.diagnostic.Diagnostic {
        reason: ^dag_add_grounding_miss,
        at: v2.std.diagnostic.node_locus(node: node),
        correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
      }
    }
  }
}

fn dag_add_inferred_facts_for(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  match dag_add_canonical_grounding_for(node: node) {
    v2.std.witness.Violates { diagnostic: d } => v2.std.optional.optional_absent()
    v2.std.witness.Holds { value: grounding } =>
      match v2.std.cardinality.termination_proof_witness_for_node(n: node) {
        v2.std.witness.Violates { diagnostic: d } => v2.std.optional.optional_absent()
        v2.std.witness.Holds { value: proof } =>
          v2.std.optional.optional_present(value: v2.test.lens_common.infer_fixture.claim_inferred_facts_witness(
              grounding: grounding,
              descent: v2.std.witness.Holds { value: proof }
            ))
      }
  }
}

fn dag_add_facts_lookup(key: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  dag_add_inferred_facts_for(node: key)
}

data dag_add_inferred_tree: v2.compiler.inferred_tree.InferredTree = v2.compiler.inferred_tree.InferredTree {
  root: dag_add_emitted_root,
  facts: PartialFunction {
    lookup: dag_add_facts_lookup
  }
}

fn anchor_dag_add_emit_accepts() -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.compiler.emit.emit(tree: dag_add_inferred_tree, target: dag_add_target_model)
}

data dag_add_emit_receipt: v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> = anchor_dag_add_emit_accepts()

fn dag_add_coercion_quality_is_faithful(q: v2.std.coercion.CoercionQuality) -> Bool {
  match q {
    v2.std.coercion.Exact => true
    v2.std.coercion.Identity => true
    v2.std.coercion.Widened => false
  }
}

test fn dag_add_emit_matches_serialize_holds() -> Bool {
  match v2.compiler.translate.target_serialize_source_from_model(
    target: dag_add_target_model,
    emitted: dag_add_emitted_root
  ) {
    v2.std.diagnostic.Accepted { value: authority, diagnostics: ad } =>
      match dag_add_emit_receipt {
        v2.std.diagnostic.Accepted { value: source, diagnostics: d } =>
          (source == authority) && (d == v2.std.diagnostic.None) && (ad == v2.std.diagnostic.None)
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn dag_add_grammar_inverse_holds() -> Bool {
  match v2.compiler.translate.grammar_inverse_source_validated(
    target: dag_add_target_model,
    emitted: dag_add_emitted_root
  ) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: d } => d == v2.std.diagnostic.None
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn dag_add_ingest_via_coerce_matches_canonical() -> Bool {
  match v2.compiler.translate.coerce_grounded_node(
    source: dag_add_emitted_root,
    tree: dag_add_inferred_tree,
    target: dag_add_target_model
  ) {
    v2.std.diagnostic.Accepted { value: result, diagnostics: d } =>
      (result.target == v2.extdeps.languages.dag.dag_fixture_emitted_add_fn)
        && dag_add_coercion_quality_is_faithful(q: result.quality)
        && (d == v2.std.diagnostic.None)
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn dag_add_domain_coerce_accepts_holds() -> Bool {
  match v2.compiler.translate.coerce_grounded_node(
    source: v2.extdeps.languages.dag.dag_arrow_domain_conj_node(),
    tree: dag_add_inferred_tree,
    target: dag_add_target_model
  ) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: d } => d == v2.std.diagnostic.None
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn dag_add_domain_translate_accepts_holds() -> Bool {
  match v2.compiler.translate.translate_emitted_node(
    tree: v2.compiler.inferred_tree.InferredTree {
      root: v2.extdeps.languages.dag.dag_arrow_domain_conj_node(),
      facts: PartialFunction { lookup: dag_add_facts_lookup }
    },
    target: dag_add_target_model
  ) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: d } => d == v2.std.diagnostic.None
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn dag_add_translate_accepts_holds() -> Bool {
  match v2.compiler.translate.translate_emitted_node(tree: dag_add_inferred_tree, target: dag_add_target_model) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: d } => d == v2.std.diagnostic.None
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

