module v2.test.execution.dag_add_emit_round_trip



data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly
data dag_add_emitted_root: Node = dag_fixture_emitted_add_fn

data dag_add_target_model: TargetModel = dag_target_model()

fn dag_add_canonical_grounding(
  node: Node,
  algebra: Node
) -> CanonicalGrounding {
  CanonicalGrounding {
    node: node,
    witness: CanonicalGroundingWitness {
      structural: StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn dag_add_canonical_grounding_for(node: Node) -> Witness<CanonicalGrounding> {
  if node == dag_fixture_emitted_add_fn {
    Holds {
      value: dag_add_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == dag_fixture_int_inhabitant {
    Holds {
      value: dag_add_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == dag_inhabitant_atom(id: ^dag_inhabitant_int) {
    Holds {
      value: dag_add_canonical_grounding(
        node: node,
        algebra: dag_fixture_int_inhabitant
      )
    }
  } else if node == dag_inhabitant_atom(id: ^dag_surface_spelling_int) {
    Holds {
      value: dag_add_canonical_grounding(
        node: node,
        algebra: dag_fixture_int_inhabitant
      )
    }
  } else {
    Violates {
      diagnostic: Diagnostic {
        reason: ^dag_add_grounding_miss,
        at: node_locus(node: node),
        correction: Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn dag_add_inferred_facts_for(node: Node) -> Witness<InferredFacts> {
  match dag_add_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => Violates { diagnostic: d }
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => Violates { diagnostic: d }
        Holds { value: proof } =>
          Holds {
            value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: Holds { value: proof }
            )
          }
      }
  }
}

fn dag_add_facts_lookup(key: Node) -> Witness<InferredFacts> {
  dag_add_inferred_facts_for(node: key)
}

data dag_add_inferred_tree: InferredTree = InferredTree {
  root: dag_add_emitted_root,
  facts: Map {
    lookup: dag_add_facts_lookup
  }
}

fn anchor_dag_add_emit_accepts() -> Outcome<Medium<String>> {
  emit(tree: dag_add_inferred_tree, target: dag_add_target_model)
}

data dag_add_emit_receipt: Outcome<Medium<String>> = anchor_dag_add_emit_accepts()

fn dag_add_coercion_quality_is_faithful(q: CoercionQuality) -> Bool {
  match q {
    Exact => true
    Identity => true
    Widened => false
  }
}

test fn dag_add_emit_matches_serialize_holds() -> Bool {
  match target_serialize_source_from_model(
    target: dag_add_target_model,
    emitted: dag_add_emitted_root
  ) {
    Accepted { value: authority, diagnostics: ad } =>
      match dag_add_emit_receipt {
        Accepted { value: source, diagnostics: d } =>
          (source == authority) && (d == None) && (ad == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn dag_add_grammar_inverse_holds() -> Bool {
  match grammar_inverse_source_validated(
    target: dag_add_target_model,
    emitted: dag_add_emitted_root
  ) {
    Accepted { value: _, diagnostics: d } => d == None
    Rejected { diagnostics: _ } => false
  }
}

fn dag_add_ingest_via_coerce_matches_canonical() -> Bool {
  match coerce_grounded_node(
    source: dag_add_emitted_root,
    tree: dag_add_inferred_tree,
    target: dag_add_target_model
  ) {
    Accepted { value: result, diagnostics: d } =>
      (result.target == dag_fixture_emitted_add_fn)
        && dag_add_coercion_quality_is_faithful(q: result.quality)
        && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

fn dag_add_domain_coerce_accepts_holds() -> Bool {
  match coerce_grounded_node(
    source: dag_arrow_domain_conj_node(),
    tree: dag_add_inferred_tree,
    target: dag_add_target_model
  ) {
    Accepted { value: _, diagnostics: d } => d == None
    Rejected { diagnostics: _ } => false
  }
}

fn dag_add_domain_translate_accepts_holds() -> Bool {
  match translate_emitted_node(
    tree: InferredTree {
      root: dag_arrow_domain_conj_node(),
      facts: Map { lookup: dag_add_facts_lookup }
    },
    target: dag_add_target_model
  ) {
    Accepted { value: _, diagnostics: d } => d == None
    Rejected { diagnostics: _ } => false
  }
}

fn dag_add_translate_accepts_holds() -> Bool {
  match translate_emitted_node(tree: dag_add_inferred_tree, target: dag_add_target_model) {
    Accepted { value: _, diagnostics: d } => d == None
    Rejected { diagnostics: _ } => false
  }
}

fn dag_add_emit_add_fn_accepts_holds() -> Bool {
  dag_add_emit_matches_serialize_holds()
}

test fn dag_add_emit_ingest_round_trip_holds() -> Bool {
  dag_add_emit_add_fn_accepts_holds()
    && dag_add_grammar_inverse_holds()
    && dag_add_ingest_via_coerce_matches_canonical()
}
