module v2.test.claim.staged_front_end

import std.types { List, SourceSpan }
import std.algebra { Cons, Empty, fold_list, FreeMonoid, length, string_contains }
import std.dissolution { dissolution_is_bound }
import std.source_annotation {
  LeadingAfterLineIndent,
  NormalizedAnnotationCapture,
  SourceAnnotationGraph,
  attach_annotations,
  region_contains,
  SourceAnnotationDebt,
  source_annotation_graph_rows,
}
import std.list { first_where }
import v2.std.compilers.lexing { UnboundSourceAnnotation }
import v2.std.node { Symbol }
import v2.std.qualified_name { qualified_name_to_dotted_string }
import v2.compiler.parse { authored_normalized_capture }
import v2.compiler.staged_front_end {
  FrontEndBoundReached,
  FrontEndParse,
  FrontEndRefused,
  FrontEndResolvedModule,
  FrontEndRun,
  FrontEndStage,
  FrontEndStagePassed,
  FrontEndStageRejected,
  FrontEndStageReceipt,
  ParsedModule,
  front_end_placement_control_next_rung,
  front_end_stage_index,
  front_end_run_outcome,
  front_end_bounded_diagnostics,
  front_end_incomplete_diagnostics,
  run_front_end,
  run_front_end_to,
}
import v2.std.diagnostic { Accepted, DeclarerRefused, Diagnostic, Unavailable, invariant_port_locus }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.optional { Absent, Optional, Present }
import v2.std.text { String }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data staged_front_end_test_note: String = "THE DISCRIMINATING PAIR IS THE POINT OF THE DECOMPOSITION. Before it, the front end answered one Outcome<Node> for four stages, so a candidate that died at parse and a candidate that died at resolve were the same observation. These two candidates must land on DIFFERENT stages; if they ever land on the same one, the decomposition carries nothing and the harness's per-stage evidence is decorative. The tokenize candidate is the third point on the same axis, and the accepted candidate is the positive control that keeps the whole set from passing vacuously."

data candidate_accepted_source: String = "module m\n\nfn add(x: Int, y: Int) -> Int { x + y }\n"
data candidate_dies_at_parse_source: String = "module m\n\nfn add(x: Int, y: Int) -> Int { x + y\n"
data candidate_dies_at_resolve_source: String = "module m\n\nfn add(x: Int, y: Int) -> Int { undefined_name }\n"

fn stage_of_first_rejection(run: FrontEndRun) -> Optional<FrontEndStage> {
  fold(run.steps, init: Absent, f: fn(acc, step) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        match step {
          FrontEndStageRejected { stage: s, diagnostics: _ } => Present { value: s }
          FrontEndStagePassed { stage: _, receipt: _, diagnostics: _ } => Absent
        }
    }
  })
}

fn rejected_at_index(source: String, index: Int) -> Bool {
  match stage_of_first_rejection(run: run_front_end(source: source, file: ^candidate_module)) {
    Absent => false
    Present { value: stage } => front_end_stage_index(stage: stage) == index
  }
}

fn passed_stage_count(run: FrontEndRun) -> Int {
  fold(run.steps, init: 0, f: fn(acc, step) {
    match step {
      FrontEndStagePassed { stage: _, receipt: _, diagnostics: _ } => acc + 1
      FrontEndStageRejected { stage: _, diagnostics: _ } => acc
    }
  })
}

test fn staged_front_end_accepts_a_well_formed_module() -> Bool {
  let run = run_front_end(source: candidate_accepted_source, file: ^candidate_module)
  match run.completion {
    FrontEndResolvedModule { resolved: _ } => passed_stage_count(run: run) == 4
    FrontEndBoundReached { last: _ } => false
    FrontEndRefused => false
  }
}

test fn staged_front_end_parse_and_resolve_deaths_land_on_different_stages() -> Bool {
  rejected_at_index(source: candidate_dies_at_parse_source, index: 2)
    && rejected_at_index(source: candidate_dies_at_resolve_source, index: 4)
}

test fn staged_front_end_resolve_death_still_passes_parse() -> Bool {
  passed_stage_count(
    run: run_front_end(source: candidate_dies_at_resolve_source, file: ^candidate_module)
  ) == 3
}

test fn staged_front_end_projection_agrees_with_the_staged_steps() -> Bool {
  match front_end_run_outcome(
    run: run_front_end(source: candidate_accepted_source, file: ^candidate_module)
  ) {
    Accepted { value: _, diagnostics: _ } =>
      match front_end_run_outcome(
        run: run_front_end(source: candidate_dies_at_resolve_source, file: ^candidate_module)
      ) {
        Rejected { diagnostics: _ } => true
        Accepted { value: _, diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn staged_front_end_bound_stops_before_the_stages_it_was_not_asked_for() -> Bool {
  let run = run_front_end_to(source: candidate_dies_at_resolve_source, file: ^candidate_module, depth: 2)
  match run.completion {
    FrontEndBoundReached { last: last } => front_end_stage_index(stage: last) == 2
    FrontEndResolvedModule { resolved: _ } => false
    FrontEndRefused => false
  }
}

test fn staged_front_end_bounded_run_refuses_the_whole_front_end_question() -> Bool {
  match front_end_run_outcome(
    run: run_front_end_to(source: candidate_accepted_source, file: ^candidate_module, depth: 2)
  ) {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}

data unbound_symbol_reason_note: String = "The floor property, pinned in the direction it should hold. An undeclared name in VALUE position must refuse at resolve, and it must refuse with the reason that names what went wrong rather than with any refusal at all — a stage that refuses for an unrelated cause would satisfy a looser assertion while the diagnostic vocabulary rotted. Only this direction is pinned: the sibling measurement, that an undeclared CALLEE passes resolve silently on the v2 path (because v2 normalize erases the call before resolve runs, not because resolve admits it: gunbc.recurring_failure_mode.call_expression_erased_at_v2_body_lowering), is recorded in v2.test.claim.dag_acceptance frontier_arm_note as a dated measurement and is deliberately NOT asserted here, because a test that goes red when the compiler starts refusing the callee would be a defender for the gap rather than a check on it."

fn first_refusal_reason(source: String) -> Symbol {
  fold(run_front_end(source: source, file: ^candidate_module).steps, init: ^no_refusal, f: fn(acc, step) {
    match step {
      FrontEndStageRejected { stage: _, diagnostics: d } => d.head.reason
      FrontEndStagePassed { stage: _, receipt: _, diagnostics: _ } => acc
    }
  })
}

test fn staged_front_end_unbound_value_name_refuses_with_its_own_reason() -> Bool {
  first_refusal_reason(source: candidate_dies_at_resolve_source) == ^resolve_reason_unbound_symbol
}

// ──────────────────────────────────────────────────────────────────────────────────────────────
// THE PARSE STAGE IS A PRODUCTION CONSUMER OF THE AUTHORED PARSE, AND THESE PIN IT.
// Roadmap node parse-comment-gap-attachment-v2-consumed put parse_module_authored on the production
// front end (v2.compiler.staged_front_end front_end_parse_step), which is the route every .dag
// candidate the acceptance harness runs walks. The four tests above pin the ladder's SHAPE -- which
// stage a candidate dies at -- and every one of them would still pass if the parse stage dropped the
// authored artifact's annotations, because none of them reads the attachment. These read it: the
// positive control that a comment-bearing module walks all four stages through the authored parse, and
// the guard's DISCRIMINATING PAIR -- a graph the fold made from the same captures is accepted, a graph
// missing an edge capture is refused. The guard asks COVERAGE, not multiplicity (an interior loss stays
// unseen by it, which its own claim pins by executing it, and whose exit is the gunbc roadmap node
// rn_ZR45MIQ7KTC56XVLT23LXQ3W4A (source-annotation-fold-carries-absorbed-capture-count). The v1/v2
// agreement half --
// WHICH gap a capture landed in -- is the MANUAL, UNGATED control
// v2.test.claim.manual.annotation_gap_v1_v2_agreement, whose probe pair
// v2.test.claim.manual.annotation_gap_v1_v2_agreement_probe_pair re-derives that control's rung from
// v2.workflow.required_floor required_gate_admits. It sits under manual/, no
// gated row admits it and the required floor executes nothing, so none of these tests stands in for it and
// none of them is run by CI either; the executed evidence for all of these lives in this PR's run-log
// comments, not in carriers inside these modules.

data annotated_candidate_source: String = "module m\n\n// why the reader needs this\nfn add(x: Int, y: Int) -> Int { x + y }\n"

fn parse_stage_passed_with_nodes(run: FrontEndRun) -> Bool {
  fold(run.steps, init: false, f: fn(acc, step) {
    match step {
      FrontEndStagePassed { stage: FrontEndParse, receipt: ParsedModule { node_count: n, annotation_count: _ }, diagnostics: _ } =>
        acc || n > 0
      FrontEndStagePassed { stage: _, receipt: _, diagnostics: _ } => acc
      FrontEndStageRejected { stage: _, diagnostics: _ } => acc
    }
  })
}

// THE ROW'S HANDBACK CLAIM, AND THE CONSUMER THE CONSUMPTION ARGUMENT REQUIRES. The production parse stage
// calls parse_module_authored, a module carrying a comment reaches resolve, and the annotation half that call
// produced is read back out of the stage's own receipt: a positive annotation_count for the commented module and
// zero for the uncommented one. The zero leg is the point -- a read that returns a positive number whatever the
// input is decoration, and the two legs together are what make the read mean something. Falsifiable both ways:
// delete the comment line from annotated_candidate_source and the positive leg goes red; add one to
// candidate_accepted_source and the negative leg goes red.
// WHAT IT DOES NOT PROVE, SAID RATHER THAN LEFT TO BE ASSUMED: the count comes from the fold and is only
// counted here, so it shows the fold emitted rows for the capture -- not WHICH gap a capture landed in
// (placement is the v1/v2 agreement control's question), and not that an interior loss inside a joined block is
// caught. Deciding coverage is the guard below, executed by name.
fn parse_stage_annotation_count(run: FrontEndRun) -> Int {
  fold(run.steps, init: 0, f: fn(acc, step) {
    match step {
      FrontEndStagePassed { stage: FrontEndParse, receipt: ParsedModule { node_count: _, annotation_count: a }, diagnostics: _ } =>
        acc + a
      FrontEndStagePassed { stage: _, receipt: _, diagnostics: _ } => acc
      FrontEndStageRejected { stage: _, diagnostics: _ } => acc
    }
  })
}

test fn staged_front_end_produces_the_authored_parse_for_an_annotated_module() -> Bool {
  let run = run_front_end(source: annotated_candidate_source, file: ^candidate_module)
  let bare = run_front_end(source: candidate_accepted_source, file: ^candidate_module)
  match run.completion {
    FrontEndResolvedModule { resolved: _ } =>
      passed_stage_count(run: run) == 4
        && parse_stage_passed_with_nodes(run: run)
        && parse_stage_annotation_count(run: run) > 0
        && parse_stage_annotation_count(run: bare) == 0
    FrontEndBoundReached { last: _ } => false
    FrontEndRefused => false
  }
}


// THE FIXTURES FOR THE GUARD'S DISCRIMINATING PAIR. Three comment captures at adjacent offsets, spelled
// TWICE: as the lexer emits them (guard_fixture_capture, what the guard is given) and as the fold consumes
// them (attach_fixture_capture, what attach_annotations is given), with IDENTICAL offsets so the only thing
// that can make the guard refuse is what the fold was handed. The fold is called for real in every leg below
// -- no row in these fixtures is hand-built, so no claim here can certify a graph the authority would not
// have produced.
fn attach_fixture_capture(text: String, start: Int, end: Int, adjacent: Bool) -> NormalizedAnnotationCapture {
  NormalizedAnnotationCapture {
    text: text,
    origin: SourceSpan { file: "candidate.dag", start: start, end: end },
    placement: LeadingAfterLineIndent,
    preceded_by_blank_line: false,
    preceded_by_annotation_line: adjacent
  }
}

fn guard_fixture_capture(text: String, start: Int, end: Int, adjacent: Bool) -> UnboundSourceAnnotation {
  UnboundSourceAnnotation {
    annotation_class: ^line_comment,
    lexeme: text,
    placement: LeadingAfterLineIndent,
    preceded_by_blank_line: false,
    preceded_by_annotation_line: adjacent,
    file: ^candidate_module,
    start: start,
    end: end
  }
}

// THE RUNG STATEMENT IN THE GUARD'S COMMENT HAS A TYPE BEHIND IT. The guard says placement is checked only by a
// manual, ungated control and that the moment to gate it is declared, not deferred; that is carried as a
// DissolutionCondition (front_end_placement_control_next_rung) rather than as prose. This claim decides whether
// it is UNBOUND -- true because nothing in the tree fires it: the required-floor runner is deleted
// (gunbc.rung_drop_amendment.manual_required_floor_runner_deleted) and no workflow passes a --required flag --
// and refuses if it is ever bound while no floor can execute. It does not grep the carrier for the control's
// name or for the roster's name: those are read from the carrier by whoever binds it, and a conjunct that
// matches this module's own description can only fail when its author rewrites it.
test fn front_end_placement_next_rung_is_declared_and_names_the_control() -> Bool {
  !dissolution_is_bound(condition: front_end_placement_control_next_rung)
}

// THE GUARD'S DISCRIMINATING PAIR, AND THE LIMIT IT CANNOT CROSS. The guard asks whether SOME row's origin
// covers each capture's span, through the authority's own predicate -- so the pair is a graph the fold made
// from those captures (accepted) against the graph the fold would have made had it dropped the LAST capture
// (refused), each leg calling the real std.source_annotation attach_annotations. Nothing here is hand-built,
// so no claim in this file can certify a graph the authority would not itself have produced. The third claim
// is the honest half, and it names BOTH of the guard's limits -- an interior loss inside a joined block, and
// a capture naming a different file -- because a claim that advertises only one of them is how the other gets
// forgotten. That is a weaker guard with DECLARED limits, whose exit is recorded once in the roadmap --
// rn_ZR45MIQ7KTC56XVLT23LXQ3W4A (source-annotation-fold-carries-absorbed-capture-count) -- not left for a
// reader to infer from a green tick.
fn guard_fixture_captures() -> List<UnboundSourceAnnotation> {
  [
    guard_fixture_capture(text: "// one", start: 0, end: 6, adjacent: false),
    guard_fixture_capture(text: "// two", start: 7, end: 13, adjacent: true),
    guard_fixture_capture(text: "// three", start: 14, end: 22, adjacent: true)
  ]
}

fn fold_fixture_all_three() -> List<NormalizedAnnotationCapture> {
  [
    attach_fixture_capture(text: "// one", start: 0, end: 6, adjacent: false),
    attach_fixture_capture(text: "// two", start: 7, end: 13, adjacent: true),
    attach_fixture_capture(text: "// three", start: 14, end: 22, adjacent: true)
  ]
}

// The same block with its LAST capture already gone: no surviving row's origin reaches 14..22.
fn fold_fixture_missing_edge() -> List<NormalizedAnnotationCapture> {
  [
    attach_fixture_capture(text: "// one", start: 0, end: 6, adjacent: false),
    attach_fixture_capture(text: "// two", start: 7, end: 13, adjacent: true)
  ]
}

// The same block with its MIDDLE capture already gone: "// three" still claims to continue the line above, so
// the fold joins it to "// one" and the surviving row's origin runs 0..22 -- which is precisely what covers
// the capture that is missing.
fn fold_fixture_missing_middle() -> List<NormalizedAnnotationCapture> {
  [
    attach_fixture_capture(text: "// one", start: 0, end: 6, adjacent: false),
    attach_fixture_capture(text: "// three", start: 14, end: 22, adjacent: true)
  ]
}


// THE LOSS GUARD, WHERE THE LANE THAT EXECUTES IT LIVES. It was authored in v2.compiler.staged_front_end and
// moved here (manager ruling 2026-11-26, carrying neat-badger's modified REINSTATE ruling): no production module
// ships a loss check that no executing route reaches, and containment stays enforced on the gated route that
// actually runs these witnesses. It borrows the containment predicate verbatim from
// std.source_annotation::region_contains and mints no geometry of its own; its worst case is captures x rows
// calls to that predicate, which is why it is not production's cost to pay. Its exit is gunbc roadmap node
// rn_ZR45MIQ7KTC56XVLT23LXQ3W4A (source-annotation-fold-carries-absorbed-capture-count): when the fold carries
// a per-row capture count the authority can answer coverage once per row and the scan disappears.
// attach_annotations is total by construction -- every capture lies in some gap, the file's at worst -- so a
// capture whose span NO row's origin covers was lost by the attachment itself: the fold, not the source, is
// wrong, and gunbc.design_argument::fail_closed refuses to let dropped authored prose pass quietly.
// WHAT THE GATED CLAIM READS, AND WHAT THAT READ CANNOT SEE. attach_annotations is total by
// construction: every capture lies in some gap, the file's at worst -- so a capture whose span NO row's
// origin covers was lost by the attachment itself. The fold, not the source, is wrong, and a compiler that
// silently drops authored prose at the parse stage is exactly what gunbc.design_argument::fail_closed
// refuses to let happen quietly. The check is language-neutral: it asks a coverage question, it does not
// interpret.
// IT OWNS NO GEOMETRY. Whether one span lies inside another is answered by the ONE predicate the authority
// that decides attachment already uses -- std.source_annotation::region_contains -- and the span a capture
// is measured against is the span the fold itself was given for it, taken through
// v2.compiler.parse::authored_normalized_capture (its `annotation_text` is the identity here because only
// `.origin` is read, never the text). No offset is compared anywhere in this module, so nothing in this
// module can disagree with the fold about containment (gunbc.design_argument::single_authority).
// WHAT IT CANNOT SEE, BOTH LIMITS STATED HERE AND CARRIED IN ONE TYPE BESIDE IT. (1) INTERIOR LOSS: an
// ADJACENT block joins into ONE row whose origin runs from its first capture's start to its last capture's
// end (std.source_annotation annotation_attach_step), so a capture lost in the MIDDLE of such a block leaves
// every capture's span still covered -- coverage is not multiplicity. (2) FILE-BLINDNESS: the predicate this
// guard borrows, std.source_annotation::region_contains, compares start and end only and reads no file field
// of either SourceSpan -- so a
// capture naming a DIFFERENT FILE than the row covering it reads as contained, which makes this a
// SINGLE-MODULE attach check and nothing more. Nothing in production refuses either case today; the moment
// they become checkable is recorded once in the roadmap -- gunbc roadmap node
// rn_ZR45MIQ7KTC56XVLT23LXQ3W4A (source-annotation-fold-carries-absorbed-capture-count), because a fold that
// carries its own per-row capture count can answer both by the authority that decides attachment.
// WHAT IT ALSO DOES NOT SEE: WHICH gap a capture landed in. Placement is checked only by the v1/v2 agreement
// control (v2.test.claim.manual.annotation_gap_v1_v2_agreement), which publishes its identity AND its rung as
// carriers there -- this comment states no rung, because a status written twice is a status that can lie:
// probe_pair_rung_agrees_with_the_floors_own_admission re-derives it from v2.workflow.required_floor
// required_gate_admits. Read that carrier: while it reads ManualUngated, a placement divergence is caught only
// when someone runs the control by hand, so THIS guard is a loss guard and nothing more. The moment that
// changes is declared, not deferred: front_end_placement_control_next_rung
// (gunbc.design_argument::guarantee_ladder, no untracked stall).
fn front_end_capture_origin_as_the_fold_sees(capture: UnboundSourceAnnotation) -> SourceSpan {
  // Identity stripping, because only the span is read. Routing through the fold's own normalization is the
  // point: the guard measures a capture by the span attachment was handed, never by one it minted itself.
  authored_normalized_capture(capture: capture, annotation_text: fn(t) { t }).origin
}

// A capture is landed when SOME row's origin covers its span -- asked of the authority's own predicate, with no
// local comparison of offsets. THE SCAN IS THE REPO'S OWN SHORT-CIRCUITING ONE and the capture's span is built
// ONCE per capture rather than once per (capture, row) pair: std.list::first_where stops calling the predicate as
// soon as it holds a witness, so the rows stop being visited the moment the answer is known, and
// authored_normalized_capture runs exactly once per capture instead of once per pair.
// WHAT THIS DOES NOT REMOVE, stated rather than left to be inferred: with no ordering decision available from the
// authority -- std.source_annotation::region_contains answers containment for ONE pair and nothing else -- "does
// SOME row cover this span" must still be asked pair by pair in the worst case. Removing that residue is the
// fold's work, not a consumer's: it is the per-row absorbed-capture count that
// rn_ZR45MIQ7KTC56XVLT23LXQ3W4A asks the fold to carry, because a consumer that
// guessed where a row ends would be deciding std.source_annotation annotation_attach_step's join rule in a second
// place (gunbc.design_argument::single_authority, and how_to_work on a proven cost-shape defect being always
// fixed). The consumer's own waste -- one authority call per pair, and visits after the answer was known -- is
// what is fixed here.
fn front_end_capture_is_covered(
  capture: UnboundSourceAnnotation,
  rows: List<SourceAnnotationDebt>
) -> Bool {
  let origin = front_end_capture_origin_as_the_fold_sees(capture: capture)
  match first_where(xs: rows, keep: fn(row) {
    region_contains(extent: row.origin, origin: origin)
  }) {
    Present { value: _ } => true
    Absent => false
  }
}

// The outer scan short-circuits the same way: the FIRST capture no row covers decides the whole answer, so a
// module that is already refused does not pay for the captures that follow it.
fn front_end_captures_all_covered(
  captures: List<UnboundSourceAnnotation>,
  rows: List<SourceAnnotationDebt>
) -> Bool {
  match first_where(xs: captures, keep: fn(capture) {
    !front_end_capture_is_covered(capture: capture, rows: rows)
  }) {
    Present { value: _ } => false
    Absent => true
  }
}

// WHO REFUSED, IN A FORM A CENSUS CAN JOIN ON. An uncovered capture means the fold, not the source, is
// wrong, so the refusal names the declarer whose contract it depends on instead of shrugging with
// ExternalContractUnknown: std.source_annotation::annotation_attach_step, the fold that decides both the join
// rule and the containment predicate this guard borrows. Carried as the qualified path in SEGMENTS, exactly as
// DeclarationLocus carries one (v2.std.diagnostic NoCorrectionReason DeclarerRefused), so a census joins on the
// identity and never on the reason's prose. v2.test.claim.staged_front_end
// front_end_unlanded_capture_refusal_names_the_fold_as_the_refused_declarer pins it, and
// front_end_sibling_refusals_name_no_refused_declarer keeps the arm from being a default.
fn front_end_capture_authority_declarer() -> FreeMonoid<Symbol> {
  Cons {
    head: ^std,
    tail: Cons { head: ^source_annotation, tail: Cons { head: ^annotation_attach_step, tail: Empty } }
  }
}

fn front_end_unlanded_annotation_diagnostic(
  captures: List<UnboundSourceAnnotation>,
  graph: SourceAnnotationGraph
) -> Optional<Diagnostic> {
  if front_end_captures_all_covered(
    captures: captures,
    rows: source_annotation_graph_rows(graph: graph)
  ) {
    Absent
  } else {
    Present {
      value: Diagnostic {
        reason: ^staged_front_end_annotation_capture_unlanded,
        at: invariant_port_locus(
          port: ^staged_front_end_locus_port,
          invariant: ^staged_front_end_annotation_capture_unlanded
        ),
        correction: Unavailable { reason: DeclarerRefused { declarer: front_end_capture_authority_declarer() } }
      }
    }
  }
}

// THE ACCEPTED LEG. A graph the fold produced from exactly the captures the lexer made must be silent: this
// is also the positive control that keeps the refused leg from passing because the guard refuses everything.
test fn front_end_annotation_guard_accepts_the_graph_the_fold_made_from_the_same_captures() -> Bool {
  let graph = attach_annotations(captures: fold_fixture_all_three(), regions: [])
  match front_end_unlanded_annotation_diagnostic(captures: guard_fixture_captures(), graph: graph) {
    Absent => true
    Present { value: _ } => false
  }
}

// THE REFUSED LEG. Drop the last capture before the fold ever sees it and the parse stage must refuse with
// its own reason -- the loss is the fold's, never the author's, and fail_closed says a silently dropped
// piece of authored prose may not pass quietly.
test fn front_end_annotation_guard_refuses_an_edge_loss_the_fold_dropped() -> Bool {
  let graph = attach_annotations(captures: fold_fixture_missing_edge(), regions: [])
  match front_end_unlanded_annotation_diagnostic(captures: guard_fixture_captures(), graph: graph) {
    Present { value: refusal } => refusal.reason == ^staged_front_end_annotation_capture_unlanded
    Absent => false
  }
}

// NON-VACUITY OF THE PAIR: no captures at all, nothing to cover, silence.
test fn front_end_annotation_guard_stays_silent_when_nothing_is_lost() -> Bool {
  match front_end_unlanded_annotation_diagnostic(captures: [], graph: SourceAnnotationGraph { rows: [] }) {
    Absent => true
    Present { value: _ } => false
  }
}

// THE BLIND SPOTS, EXECUTED RATHER THAN APOLOGISED FOR -- and read carefully, because a PASS here is not
// safety: it PASSES by showing the guard accept two real losses. Both limits are written into the claim's
// NAME, because a green tick behind a one-sided name is exactly how a weak guard gets cited later as
// protection against the case it cannot see. (1) INTERIOR LOSS: one joined row's origin spans its whole
// block, so the middle capture that is gone is still covered and coverage reports nothing missing -- the
// first conjunct proves WHY (the fold made exactly ONE row for that block) and the second is the guard's own
// silence on it. (2) FILE-BLINDNESS: the predicate the guard borrows, std.source_annotation::region_contains,
// compares start and end only and reads no file field, so a capture naming a DIFFERENT FILE than the row
// covering it reads as contained. `foreign_file` and `row_file` show the two files really differ -- asked of
// authored_normalized_capture, the authority's own constructor, not of a hand-built span -- and
// `foreign_capture_silent` is the guard's silence on that cross-file capture, which is the behaviour that makes
// this a SINGLE-MODULE attach check only. `condition` is the rung carrying BOTH limits, unbound today; the
// limits themselves are read from that carrier, and this claim does not grep its description, because a
// conjunct over this module's own prose can only go red when its author rewrites the sentence. When the fold
// starts carrying the per-row capture count, `interior_loss_silent` and `foreign_capture_silent` must be
// rewritten into refusals; those rewrites are the executed signal that the limits moved.
test fn front_end_annotation_guard_declares_both_limits_interior_loss_and_file_blindness() -> Bool {
  let graph = attach_annotations(captures: fold_fixture_missing_middle(), regions: [])
  let rows = source_annotation_graph_rows(graph: graph)
  let interior_loss_silent =
    match front_end_unlanded_annotation_diagnostic(captures: guard_fixture_captures(), graph: graph) {
      Absent => true
      Present { value: _ } => false
    }
  let foreign_capture = UnboundSourceAnnotation {
    annotation_class: ^line_comment,
    lexeme: "// one",
    placement: LeadingAfterLineIndent,
    preceded_by_blank_line: false,
    preceded_by_annotation_line: false,
    file: ^another_module,
    start: 0,
    end: 6
  }
  let foreign_capture_silent =
    match front_end_unlanded_annotation_diagnostic(captures: [foreign_capture], graph: graph) {
      Absent => true
      Present { value: _ } => false
    }
  let row_file = fold_list(xs: rows, empty: "", cons: fn(acc, row) { acc + row.origin.file })
  let foreign_file = authored_normalized_capture(capture: foreign_capture, annotation_text: fn(t) { t }).origin.file
  length(xs: rows) == 1
    && interior_loss_silent
    && string_contains(s: foreign_file, pattern: "another_module")
    && string_contains(s: row_file, pattern: "candidate.dag")
    && !string_contains(s: foreign_file, pattern: "candidate")
    && foreign_capture_silent
}

// FINDING 2, POSITIVE: THE REFUSAL NAMES WHO REFUSED. An uncovered capture is the fold's defect, not the
// author's, so the correction must carry the qualified path of the declarer whose contract was refused --
// std.source_annotation::annotation_attach_step, the fold deciding both the join rule and the containment
// predicate the guard borrows -- in SEGMENTS a census can join on, not as prose to be read. A refusal that
// fires for the right reason but names nobody cannot be routed to a repair.
test fn front_end_unlanded_capture_refusal_names_the_fold_as_the_refused_declarer() -> Bool {
  let graph = attach_annotations(captures: fold_fixture_missing_edge(), regions: [])
  match front_end_unlanded_annotation_diagnostic(captures: guard_fixture_captures(), graph: graph) {
    Present { value: refusal } =>
      match refusal.correction {
        Unavailable { reason: DeclarerRefused { declarer: d } } =>
          qualified_name_to_dotted_string(qn: d) == "std.source_annotation.annotation_attach_step"
        _ => false
      }
    Absent => false
  }
}

// FINDING 2, NEGATIVE: THE ARM IS NOT A DEFAULT. The two refusals this module makes for its OWN bounded and
// incomplete runs name no refused declarer -- they are the front end's own bounded questions, and main's
// ExternalContractUnknown on them is correct -- so neither may take the DeclarerRefused arm. Without this leg
// the positive above would also pass if every correction in the module matched DeclarerRefused, which is not a
// witness. The carrier is read back too, so a stale or wrong path cannot hide behind the arm's shape.
fn claim_names_a_refused_declarer(d: Diagnostic) -> Bool {
  match d.correction {
    Unavailable { reason: DeclarerRefused { declarer: _ } } => true
    _ => false
  }
}

fn claim_refused_declarer_count(xs: List<Diagnostic>) -> Int {
  fold_list(xs: xs, empty: 0, cons: fn(acc, d) { if claim_names_a_refused_declarer(d: d) { acc + 1 } else { acc } })
}

test fn front_end_sibling_refusals_name_no_refused_declarer() -> Bool {
  let bounded = front_end_bounded_diagnostics(last: FrontEndParse)
  let incomplete = front_end_incomplete_diagnostics()
  let carrier = front_end_capture_authority_declarer()
  qualified_name_to_dotted_string(qn: carrier) == "std.source_annotation.annotation_attach_step"
    && !claim_names_a_refused_declarer(d: bounded.head)
    && !claim_names_a_refused_declarer(d: incomplete.head)
    && claim_refused_declarer_count(xs: bounded.tail) == 0
    && claim_refused_declarer_count(xs: incomplete.tail) == 0
}
