module v2.test.claim.affected_set_full_predicate_equivalence

import v2.std.logic { Bool }
import v2.workflow.affected_set_floor_runner {
  DiffPathsProduced,
  FrontierProduced,
  RunWitness,
  SkipAssumedGreen,
  floor_kernel_would_skip,
  floor_witness_run_disposition
}
import v2.std.node { Atom, Node, SyntheticOccurrence, TypeNode }

data full_predicate_fixture_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^full_predicate_fixture_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data full_predicate_fixture_changed_path: String = "src/v2/test/fixture/floor_skip/node_precise_discriminator_test.dag"

fn full_predicate_node_frontier_only_skips_holds() -> Bool {
  floor_kernel_would_skip(
    changed_paths: [full_predicate_fixture_changed_path],
    frontier_nodes: [full_predicate_fixture_node],
    touches_frontier: false,
    function_edited: false
  )
}

fn full_predicate_node_frontier_only_runs_holds() -> Bool {
  !floor_kernel_would_skip(
    changed_paths: [full_predicate_fixture_changed_path],
    frontier_nodes: [full_predicate_fixture_node],
    touches_frontier: true,
    function_edited: false
  )
}

fn full_predicate_function_edited_only_runs_holds() -> Bool {
  !floor_kernel_would_skip(
    changed_paths: [full_predicate_fixture_changed_path],
    frontier_nodes: [full_predicate_fixture_node],
    touches_frontier: false,
    function_edited: true
  )
}

fn full_predicate_both_axes_false_skips_holds() -> Bool {
  match floor_witness_run_disposition(
    diff: DiffPathsProduced { changed_paths: [full_predicate_fixture_changed_path] },
    frontier: FrontierProduced { nodes: [full_predicate_fixture_node] },
    touches_frontier: false,
    function_edited: false
  ) {
    SkipAssumedGreen => true
    RunWitness { reason: _ } => false
  }
}

fn full_predicate_either_axis_runs_holds() -> Bool {
  match floor_witness_run_disposition(
    diff: DiffPathsProduced { changed_paths: [full_predicate_fixture_changed_path] },
    frontier: FrontierProduced { nodes: [full_predicate_fixture_node] },
    touches_frontier: false,
    function_edited: true
  ) {
    RunWitness { reason: _ } => true
    SkipAssumedGreen => false
  }
    && match floor_witness_run_disposition(
      diff: DiffPathsProduced { changed_paths: [full_predicate_fixture_changed_path] },
      frontier: FrontierProduced { nodes: [full_predicate_fixture_node] },
      touches_frontier: true,
      function_edited: false
    ) {
      RunWitness { reason: _ } => true
      SkipAssumedGreen => false
    }
}

test fn affected_set_full_predicate_disposition_both_axes_holds() -> Bool {
  full_predicate_node_frontier_only_skips_holds()
    && full_predicate_node_frontier_only_runs_holds()
    && full_predicate_function_edited_only_runs_holds()
    && full_predicate_both_axes_false_skips_holds()
    && full_predicate_either_axis_runs_holds()
}
