module v2.test.claim.ci_placement_witness


test fn ci_placement_gauntlet_always_admissible_holds() -> Bool {
  v2.workflow.ci_placement.placement_is_admissible(p: v2.workflow.ci_placement.Gauntlet { reason: "awaiting D2 warm-cost measurement" })
}

test fn ci_placement_valid_pr_tier_admissible_holds() -> Bool {
  v2.workflow.ci_placement.placement_is_admissible(p: v2.workflow.ci_placement.PrTier {
    warm_cost: v2.workflow.ci_placement.WarmCostReceipt { measured_ms: 1600, run_ref: "synthetic-warm-receipt" },
    classification: v2.workflow.ci_placement.Hermetic
  })
}

test fn ci_placement_over_budget_pr_tier_refused_holds() -> Bool {
  !v2.workflow.ci_placement.placement_is_admissible(p: v2.workflow.ci_placement.PrTier {
    warm_cost: v2.workflow.ci_placement.WarmCostReceipt { measured_ms: 6000, run_ref: "synthetic-over-budget" },
    classification: v2.workflow.ci_placement.Hermetic
  })
}

test fn ci_placement_unclassified_pr_tier_refused_holds() -> Bool {
  !v2.workflow.ci_placement.placement_is_admissible(p: v2.workflow.ci_placement.PrTier {
    warm_cost: v2.workflow.ci_placement.WarmCostReceipt { measured_ms: 100, run_ref: "synthetic-unclassified" },
    classification: v2.workflow.ci_placement.Unclassified
  })
}

fn placement_shadow_receipt(
  identity: gunbc.commit_workflow.CommitCheckEnrollment,
  observed_on: String,
  host_ref: String,
  run_ref: String,
  source_sha: String,
  binary_sha: String,
  roster_sha: String,
  warm_state: v2.workflow.ci_placement.PlacementShadowWarmState,
  cache_state: v2.workflow.ci_placement.PlacementShadowCacheState,
  warm_cost: v2.workflow.ci_placement.PlacementShadowWarmCostEvidence
) -> v2.workflow.ci_placement.PlacementShadowDatedReceipt {
  v2.workflow.ci_placement.PlacementShadowDatedReceipt {
    identity: identity,
    observed_on: observed_on,
    host_class: "srv_fleet_arm64",
    host_ref: host_ref,
    run_ref: run_ref,
    source_sha: source_sha,
    binary_sha: binary_sha,
    roster_sha: roster_sha,
    warm_state: warm_state,
    cache_state: cache_state,
    warm_cost: warm_cost
  }
}

fn placement_shadow_measured_warm_cost(run_ref: String, measured_ms: v2.std.nat.Nat) -> v2.workflow.ci_placement.PlacementShadowWarmCostEvidence {
  v2.workflow.ci_placement.ShadowWarmCostMeasured {
    receipt: v2.workflow.ci_placement.WarmCostReceipt {
      measured_ms: measured_ms,
      run_ref: run_ref
    }
  }
}

fn placement_shadow_unavailable_warm_cost() -> v2.workflow.ci_placement.PlacementShadowWarmCostEvidence {
  v2.workflow.ci_placement.ShadowWarmCostUnavailable { reason: "warm measurement unavailable" }
}

fn placement_shadow_multi_fn_identity() -> gunbc.commit_workflow.CommitCheckEnrollment {
  gunbc.commit_workflow.CommitCheckEnrollment {
    check: gunbc.commit_workflow.CommitWitnessClaim {
      entry: "src/v2/lens/non_fold_residue_test.dag",
      check_fns: [
        "non_fold_residue_no_unrostered_or_stale",
        "non_fold_residue_synthetic_unrostered_red_holds",
        "non_fold_residue_wildcard_red_fixture_holds"
      ],
      kind: std.realization_schedule.CorpusWitnessKind,
      span: std.realization_schedule.SpanUndeclared
    },
    surfaces: [gunbc.commit_workflow.GithubActionsCiJob]
  }
}

fn placement_shadow_entry_wide_identity() -> gunbc.commit_workflow.CommitCheckEnrollment {
  gunbc.commit_workflow.CommitCheckEnrollment {
    check: gunbc.commit_workflow.CommitWitnessClaim {
      entry: "src/v2/test/claim/execution/long/bind_eval_by_execution_test.dag",
      check_fns: [],
      kind: std.realization_schedule.ExecutionWitnessKind,
      span: std.realization_schedule.SpanUndeclared
    },
    surfaces: [gunbc.commit_workflow.GithubActionsCiJob]
  }
}

fn placement_shadow_missing_identity() -> gunbc.commit_workflow.CommitCheckEnrollment {
  gunbc.commit_workflow.CommitCheckEnrollment {
    check: gunbc.commit_workflow.CommitWitnessClaim {
      entry: "dag/test/claim/orchestration_if_emit_test.dag",
      check_fns: [],
      kind: std.realization_schedule.CorpusWitnessKind,
      span: std.realization_schedule.SpanUndeclared
    },
    surfaces: [gunbc.commit_workflow.GithubActionsCiJob]
  }
}

test fn ci_placement_shadow_report_matches_commit_gate_roster_identities_holds() -> Bool {
  v2.workflow.ci_placement.placement_shadow_report_matches_roster(
    roster: gunbc.commit_workflow.commit_gate_roster,
    report: v2.workflow.ci_placement.placement_shadow_report(
      roster: gunbc.commit_workflow.commit_gate_roster,
      basis: v2.workflow.ci_placement.PlacementShadowSignedBasis { receipts: [] }
    )
  )
}

test fn ci_placement_shadow_row_qualifies_multi_and_entrywide_rows_holds() -> Bool {
  let shared_source = "src-sha-2026-07-27"
  let shared_binary = "bin-sha-2026-07-27"
  let shared_roster = "roster-sha-2026-07-27"
  let multi_identity = placement_shadow_multi_fn_identity()
  let entrywide_identity = placement_shadow_entry_wide_identity()
  let basis = v2.workflow.ci_placement.PlacementShadowSignedBasis {
    receipts: [
      placement_shadow_receipt(
        identity: multi_identity,
        observed_on: "2026-07-26",
        host_ref: "srv-a",
        run_ref: "run-a",
        source_sha: shared_source,
        binary_sha: shared_binary,
        roster_sha: shared_roster,
        warm_state: ShadowWarm,
        cache_state: ShadowCacheWarm,
        warm_cost: placement_shadow_measured_warm_cost(run_ref: "run-a", measured_ms: 1400)
      ),
      placement_shadow_receipt(
        identity: multi_identity,
        observed_on: "2026-07-27",
        host_ref: "srv-b",
        run_ref: "run-b",
        source_sha: shared_source,
        binary_sha: shared_binary,
        roster_sha: shared_roster,
        warm_state: ShadowWarm,
        cache_state: ShadowCacheWarm,
        warm_cost: placement_shadow_measured_warm_cost(run_ref: "run-b", measured_ms: 1500)
      ),
      placement_shadow_receipt(
        identity: entrywide_identity,
        observed_on: "2026-07-26",
        host_ref: "srv-c",
        run_ref: "run-c",
        source_sha: shared_source,
        binary_sha: shared_binary,
        roster_sha: shared_roster,
        warm_state: ShadowWarm,
        cache_state: ShadowCacheWarm,
        warm_cost: placement_shadow_measured_warm_cost(run_ref: "run-c", measured_ms: 900)
      ),
      placement_shadow_receipt(
        identity: entrywide_identity,
        observed_on: "2026-07-27",
        host_ref: "srv-d",
        run_ref: "run-d",
        source_sha: shared_source,
        binary_sha: shared_binary,
        roster_sha: shared_roster,
        warm_state: ShadowWarm,
        cache_state: ShadowCacheWarm,
        warm_cost: placement_shadow_measured_warm_cost(run_ref: "run-d", measured_ms: 1000)
      )
    ]
  }
  let multi_row = v2.workflow.ci_placement.placement_shadow_row_report(identity: multi_identity, basis: basis)
  let entrywide_row = v2.workflow.ci_placement.placement_shadow_row_report(identity: entrywide_identity, basis: basis)
  match multi_row.outcome {
    Qualified => match entrywide_row.outcome {
      Qualified => true
      _ => false
    }
    _ => false
  }
}

test fn ci_placement_shadow_row_missing_incomplete_ambiguous_holds() -> Bool {
  let shared_source = "src-sha-2026-07-27"
  let shared_binary = "bin-sha-2026-07-27"
  let shared_roster = "roster-sha-2026-07-27"
  let missing_row = v2.workflow.ci_placement.placement_shadow_row_report(
    identity: placement_shadow_missing_identity(),
    basis: v2.workflow.ci_placement.PlacementShadowSignedBasis { receipts: [] }
  )
  let incomplete_row = v2.workflow.ci_placement.placement_shadow_row_report(
    identity: placement_shadow_missing_identity(),
    basis: v2.workflow.ci_placement.PlacementShadowSignedBasis {
      receipts: [
        placement_shadow_receipt(
          identity: placement_shadow_missing_identity(),
          observed_on: "2026-07-26",
          host_ref: "srv-a",
          run_ref: "run-a",
          source_sha: shared_source,
          binary_sha: shared_binary,
          roster_sha: shared_roster,
          warm_state: ShadowWarm,
          cache_state: ShadowCacheWarm,
          warm_cost: placement_shadow_measured_warm_cost(run_ref: "run-a", measured_ms: 800)
        )
      ]
    }
  )
  let ambiguous_row = v2.workflow.ci_placement.placement_shadow_row_report(
    identity: placement_shadow_missing_identity(),
    basis: v2.workflow.ci_placement.PlacementShadowSignedBasis {
      receipts: [
        placement_shadow_receipt(
          identity: placement_shadow_missing_identity(),
          observed_on: "2026-07-26",
          host_ref: "srv-a",
          run_ref: "run-a",
          source_sha: shared_source,
          binary_sha: shared_binary,
          roster_sha: shared_roster,
          warm_state: ShadowWarm,
          cache_state: ShadowCacheWarm,
          warm_cost: placement_shadow_measured_warm_cost(run_ref: "run-a", measured_ms: 800)
        ),
        placement_shadow_receipt(
          identity: placement_shadow_missing_identity(),
          observed_on: "2026-07-27",
          host_ref: "srv-b",
          run_ref: "run-b",
          source_sha: "source-drift",
          binary_sha: shared_binary,
          roster_sha: shared_roster,
          warm_state: ShadowCold,
          cache_state: ShadowCacheCold,
          warm_cost: placement_shadow_measured_warm_cost(run_ref: "run-b", measured_ms: 700)
        )
      ]
    }
  )
  match missing_row.outcome {
    Missing { reason: _ } =>
      match incomplete_row.outcome {
        Incomplete { reason: _ } =>
          match ambiguous_row.outcome {
            Ambiguous { reason: _ } => true
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn ci_placement_shadow_unknown_cold_and_missing_cost_stay_incomplete_holds() -> Bool {
  let identity = placement_shadow_entry_wide_identity()
  let shared_source = "src-sha-2026-07-27"
  let shared_binary = "bin-sha-2026-07-27"
  let shared_roster = "roster-sha-2026-07-27"
  let basis = v2.workflow.ci_placement.PlacementShadowSignedBasis {
    receipts: [
      placement_shadow_receipt(
        identity: identity,
        observed_on: "2026-07-26",
        host_ref: "srv-a",
        run_ref: "run-a",
        source_sha: shared_source,
        binary_sha: shared_binary,
        roster_sha: shared_roster,
        warm_state: ShadowWarmUnknown,
        cache_state: ShadowCacheUnknown,
        warm_cost: placement_shadow_unavailable_warm_cost()
      ),
      placement_shadow_receipt(
        identity: identity,
        observed_on: "2026-07-27",
        host_ref: "srv-b",
        run_ref: "run-b",
        source_sha: shared_source,
        binary_sha: shared_binary,
        roster_sha: shared_roster,
        warm_state: ShadowCold,
        cache_state: ShadowCacheCold,
        warm_cost: placement_shadow_measured_warm_cost(run_ref: "run-b", measured_ms: 700)
      )
    ]
  }
  match v2.workflow.ci_placement.placement_shadow_row_report(identity: identity, basis: basis).outcome {
    Incomplete { reason: _ } => true
    _ => false
  }
}
