module v2.test.claim.enforcement_live_witness


data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

test fn enforcement_consistency_gate_holds() -> Bool {
  enforcement_consistency_live() && all_intents_admissible(intents: standing_intent_registry)
}

test fn complexity_repo_wide_verdict_matches_roadmap() -> Bool {
  let v = complexity_repo_wide_verdict_live()
  leg_holds(l: v.claimed)
    && leg_fails(l: v.scope_covered)
    && leg_holds(l: v.subjects_covered)
    && leg_holds(l: v.live_consumer)
    && leg_holds(l: v.red_control)
    && leg_holds(l: v.self_application)
}

data synthetic_binding_witness: ScheduleWitnessEntry = {
  entry: "src/v2/test/claim/synthetic_enforcement_probe_test.dag",
  function: "synthetic_probe_holds",
  kind: CorpusWitnessKind
}

test fn roster_read_liveness_discriminates() -> Bool {
  let bound = BoundConsumerWitness { witness: synthetic_binding_witness }
  consumer_kind_eq(
    a: consumer_observed_for(binding: bound, ci_entries: [synthetic_binding_witness], prepush_entries: []),
    b: FloorGate
  )
    && consumer_kind_eq(
      a: consumer_observed_for(binding: bound, ci_entries: [], prepush_entries: []),
      b: WitnessOnly
    )
    && consumer_kind_eq(
      a: consumer_observed_for(binding: NoConsumerWitness, ci_entries: [synthetic_binding_witness], prepush_entries: []),
      b: NoConsumer
    )
}

test fn empty_facts_feed_reds_subjects_leg() -> Bool {
  let receipt = derive_receipt(
    contract: lens_contract_cost,
    desired_scope: whole_corpus_scope,
    self_module_prefix: "lens.cost.",
    facts: [],
    ci_entries: [],
    prepush_entries: [],
    red_probe: cost_red_control_probe
  )
  leg_fails(
    l: intent_family_verdict(
      intent: standing_intent_complexity_repo_wide,
      contracts: [lens_contract_cost],
      receipts: [receipt]
    ).subjects_covered
  )
}

fn red_status_is_failed_to_flip(s: RedControlStatus) -> Bool {
  match s {
    RedControlFailedToFlip => true
    _ => false
  }
}

fn red_status_is_passed(s: RedControlStatus) -> Bool {
  match s {
    RedControlPassed => true
    _ => false
  }
}

test fn red_control_of_red_control_flips() -> Bool {
  red_status_is_passed(s: red_control_status_for(probe: cost_red_control_probe))
    && red_status_is_failed_to_flip(s: red_control_status_for(probe: cost_well_formed_probe))
}

fn self_status_is_observed(s: SelfApplicationStatus) -> Bool {
  match s {
    SelfAppliesObserved => true
    _ => false
  }
}

fn self_status_is_absent(s: SelfApplicationStatus) -> Bool {
  match s {
    SelfApplicationAbsent => true
    _ => false
  }
}

data synthetic_self_fn_fact: DeclFact = {
  qualified_name: "lens.cost.cost_lens",
  name: "cost_lens",
  kind: FnItem,
  node: enforcement_red_probe_body_leaf,
  rel_path: "src/v2/lens/cost.dag"
}

data synthetic_other_fn_fact: DeclFact = {
  qualified_name: "workflow.other_fn",
  name: "other_fn",
  kind: FnItem,
  node: enforcement_red_probe_body_leaf,
  rel_path: "src/v2/workflow/other.dag"
}

data synthetic_self_type_fact: DeclFact = {
  qualified_name: "lens.cost.some_cost_type",
  name: "some_cost_type",
  kind: TypeItem,
  node: enforcement_red_probe_body_leaf,
  rel_path: "src/v2/lens/cost.dag"
}

test fn self_application_liveness_discriminates() -> Bool {
  self_status_is_observed(
    s: self_application_for(facts: [synthetic_self_fn_fact], module_prefix: "lens.cost.")
  )
    && self_status_is_absent(
      s: self_application_for(facts: [synthetic_other_fn_fact], module_prefix: "lens.cost.")
    )
    && self_status_is_absent(
      s: self_application_for(facts: [synthetic_self_type_fact], module_prefix: "lens.cost.")
    )
}

data synthetic_skeleton_fact: DeclFact = {
  qualified_name: "synthetic.skeleton_fn",
  name: "skeleton_fn",
  kind: FnItem,
  node: enforcement_red_probe_body_leaf,
  rel_path: "src/v2/synthetic_skeleton.dag"
}

data synthetic_computation_fact: DeclFact = {
  qualified_name: "synthetic.computation_fn",
  name: "computation_fn",
  kind: FnItem,
  node: cost_red_control_probe,
  rel_path: "src/v2/synthetic_computation.dag"
}

data synthetic_type_fact: DeclFact = {
  qualified_name: "synthetic.some_type",
  name: "some_type",
  kind: TypeItem,
  node: enforcement_red_probe_body_leaf,
  rel_path: "dag/synthetic_type.dag"
}

data synthetic_facts: List<DeclFact> = [
  synthetic_skeleton_fact,
  synthetic_computation_fact,
  synthetic_type_fact
]

test fn skeleton_only_fact_lands_body_unavailable() -> Bool {
  subject_is_body_unavailable(fact: synthetic_skeleton_fact)
    && !subject_is_body_unavailable(fact: synthetic_computation_fact)
}

test fn totality_judged_plus_unavailable_equals_fn_items() -> Bool {
  let judged_plus_unavailable = body_judged_count_of(facts: synthetic_facts) + body_unavailable_count_of(facts: synthetic_facts)
  (fn_item_count_of(facts: synthetic_facts) == 2)
    && (body_unavailable_count_of(facts: synthetic_facts) == 1)
    && (body_judged_count_of(facts: synthetic_facts) == 1)
    && (judged_plus_unavailable == fn_item_count_of(facts: synthetic_facts))
}

fn fact_has_qualified_name(fact: DeclFact, name: String) -> Bool {
  fact.qualified_name == name
}

fn facts_contain_qualified_name(facts: List<DeclFact>, name: String) -> Bool {
  fold(facts, init: false, f: fn(acc, fact) {
    acc || fact_has_qualified_name(fact: fact, name: name)
  })
}

test fn per_root_sentinels_hold_in_one_walk() -> Bool {
  let facts = enforcement_corpus_facts()
  facts_contain_qualified_name(facts: facts, name: "gunbc.commit_workflow.commit_gate_roster")
    && facts_contain_qualified_name(facts: facts, name: "v1.compiler.infer.build_type_env")
    && facts_contain_qualified_name(facts: facts, name: "lens.cost.cost_lens")
}

test fn live_corpus_is_currently_all_body_unavailable() -> Bool {
  let facts = enforcement_corpus_facts()
  (fn_item_count_of(facts: facts) > 500)
    && (body_unavailable_count_of(facts: facts) == fn_item_count_of(facts: facts))
}
