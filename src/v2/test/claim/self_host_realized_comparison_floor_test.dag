module v2.test.self_host_realized_comparison_floor

import v2.compiler.self_host {
  fold_side_bytes
}
import v2.std.logic { Bool }

data floor_committed_root: String = "src/v1/stage0/src"

test fn self_host_realized_comparison_committed_bytes_stage1_known_fragment_holds() -> Bool {
  let folded = fold_side_bytes(root: floor_committed_root, roster: ["lib.rs"])
  string_contains(folded, "Generated by v1 compiler")
}

test fn self_host_realized_comparison_boundary_tag_contains_filename_holds() -> Bool {
  let folded = fold_side_bytes(root: floor_committed_root, roster: ["lib.rs"])
  string_contains(folded, "lib.rs")
}

test fn self_host_realized_comparison_generated_file_change_flips_verdict_holds() -> Bool {
  let fold_lib = fold_side_bytes(root: floor_committed_root, roster: ["lib.rs"])
  let fold_vrt = fold_side_bytes(root: floor_committed_root, roster: ["v1_rt.rs"])
  fold_lib != fold_vrt
}
