module v2.test.claim.bash_program_fold_support


data bash_program_fold_support_note: String = "Shared bash fold tag helpers + real-program fixture builders for long/bash_program_real_probes_witness_test (review 43557 orphan fallout). Not a *_test.dag — module-local orphan hygiene would false-red cross-module-only helpers. Dissolve-on: rename remains honest as long as long/ is the consumer."

fn bash_program_fold_tagged(
  node: v2.std.node.Node,
  production_binding: v2.std.node.Symbol,
  rule_name: v2.std.node.Symbol
) -> v2.workflow.bash_emit.BashEmitSpecial {
  v2.workflow.bash_emit.BashEmitTagged {
    stmt: v2.workflow.bash_emit.BashEmitStmt {
      node: node,
      production_binding: production_binding,
      rule_name: rule_name
    }
  }
}

fn bash_program_fold_tag_command(node: v2.std.node.Node) -> v2.workflow.bash_emit.BashEmitSpecial {
  bash_program_fold_tagged(
    node: node,
    production_binding: ^bash_production_fold_command,
    rule_name: ^bash_relation_rule_fold_command
  )
}

fn bash_program_fold_tag_assign(node: v2.std.node.Node) -> v2.workflow.bash_emit.BashEmitSpecial {
  bash_program_fold_tagged(
    node: node,
    production_binding: ^bash_production_fold_assign,
    rule_name: ^bash_relation_rule_fold_assign
  )
}

fn bash_program_fold_tag_if(node: v2.std.node.Node) -> v2.workflow.bash_emit.BashEmitSpecial {
  bash_program_fold_tagged(
    node: node,
    production_binding: ^bash_production_fold_if,
    rule_name: ^bash_relation_rule_fold_if
  )
}

fn bash_program_fold_tag_subshell(node: v2.std.node.Node) -> v2.workflow.bash_emit.BashEmitSpecial {
  bash_program_fold_tagged(
    node: node,
    production_binding: ^bash_production_fold_subshell,
    rule_name: ^bash_relation_rule_fold_subshell
  )
}

fn bash_program_fold_tag_or_else(node: v2.std.node.Node) -> v2.workflow.bash_emit.BashEmitSpecial {
  bash_program_fold_tagged(
    node: node,
    production_binding: ^bash_production_fold_or_else,
    rule_name: ^bash_relation_rule_fold_or_else
  )
}

fn bash_program_fold_tag_with_redir(node: v2.std.node.Node) -> v2.workflow.bash_emit.BashEmitSpecial {
  bash_program_fold_tagged(
    node: node,
    production_binding: ^bash_production_fold_with_redir,
    rule_name: ^bash_relation_rule_fold_with_redir
  )
}

fn bash_program_fold_tag_if_nodes(nodes: List<v2.std.node.Node>) -> List<v2.workflow.bash_emit.BashEmitSpecial> {
  v2.std.algebra.list_map(xs: nodes, f: fn(n) { bash_program_fold_tag_if(node: n) })
}

fn bash_program_fold_test_not_executable_node(path: v2.std.node.Node) -> v2.std.node.Node {
  v2.extdeps.languages.bash_build.bash_build_command_from_word_nodes(words: [
    v2.extdeps.languages.bash_build.bash_build_word_lit(text: "["),
    v2.extdeps.languages.bash_build.bash_build_word_lit(text: "!"),
    v2.extdeps.languages.bash_build.bash_build_word_lit(text: "-x"),
    path,
    v2.extdeps.languages.bash_build.bash_build_word_lit(text: "]")
  ])
}

fn bash_program_fixture_assign_root_node() -> v2.std.node.Node {
  v2.extdeps.languages.bash_build.bash_build_assign(
    name: "ROOT",
    value: v2.extdeps.languages.bash_build.bash_build_word_cmdsubst(
      body: v2.extdeps.languages.bash_build.bash_build_or_else(
        left: v2.extdeps.languages.bash_build.bash_build_with_redir(
          inner: v2.extdeps.languages.bash_build.bash_build_command_from_lits(lits: ["git", "rev-parse", "--show-toplevel"]),
          redir: ^bash_production_fold_redir_stderr_null
        ),
        right: v2.extdeps.languages.bash_build.bash_build_command_from_lits(lits: ["pwd"])
      )
    )
  )
}

fn bash_program_fixture_build_bin_if_absent(bin_path: v2.std.node.Node, root: v2.std.node.Node, bin_name: String) -> v2.std.node.Node {
  v2.extdeps.languages.bash_build.bash_build_if_from_stmts(
    cond: bash_program_fold_test_not_executable_node(path: bin_path),
    then_stmts: [
      v2.extdeps.languages.bash_build.bash_build_or_else(
        left: v2.extdeps.languages.bash_build.bash_build_subshell_from_stmts(stmts: [
          v2.extdeps.languages.bash_build.bash_build_and_then(
            left: v2.extdeps.languages.bash_build.bash_build_command_from_word_nodes(words: [
              v2.extdeps.languages.bash_build.bash_build_word_lit(text: "cd"),
              root
            ]),
            right: v2.extdeps.languages.bash_build.bash_build_command_from_lits(lits: [
              "cargo", "build", "-p", "v1-compiler", "--release", "--bin", bin_name
            ])
          )
        ]),
        right: v2.extdeps.languages.bash_build.bash_build_exit(code: "1")
      )
    ]
  )
}

fn bash_program_fixture_ensure_bin_specials(var_name: String, bin_name: String) -> List<v2.workflow.bash_emit.BashEmitSpecial> {
  let root = v2.extdeps.languages.bash_build.bash_build_word_var(name: "ROOT")
  let bin = v2.extdeps.languages.bash_build.bash_build_word_var(name: var_name)
  let bin_path = v2.extdeps.languages.bash_build.bash_build_word_concat_from_nodes(parts: [
    root,
    v2.extdeps.languages.bash_build.bash_build_word_lit(text: concat("/target/release/", bin_name))
  ])
  let verify_nodes = tools.build_step.emit_verifications(
    produces: [tools.build_step.BuildArtifact { path: bin_path, name: bin_name }]
  )
  v2.std.algebra.list_append(
    left: [
      bash_program_fold_tag_assign(node: bash_program_fixture_assign_root_node()),
      bash_program_fold_tag_assign(
        node: v2.extdeps.languages.bash_build.bash_build_assign(
          name: var_name,
          value: v2.extdeps.languages.bash_build.bash_build_word_concat(
            parts: v2.extdeps.languages.bash_build.bash_build_command_words_pair(
              left: v2.extdeps.languages.bash_build.bash_build_command_words_single(word: root),
              right: v2.extdeps.languages.bash_build.bash_build_word_lit(text: concat("/target/release/", bin_name))
            )
          )
        )
      ),
      bash_program_fold_tag_if(
        node: bash_program_fixture_build_bin_if_absent(
          bin_path: bin_path,
          root: root,
          bin_name: bin_name
        )
      )
    ],
    right: bash_program_fold_tag_if_nodes(nodes: verify_nodes)
  )
}

fn bash_program_fixture_witness_bin_specials(
  var_name: String,
  bin_name: String,
  args: List<String>
) -> List<v2.workflow.bash_emit.BashEmitSpecial> {
  let root = v2.extdeps.languages.bash_build.bash_build_word_var(name: "ROOT")
  let invoke = v2.extdeps.languages.bash_build.bash_build_word_var(name: var_name)
  v2.std.algebra.list_append(
    left: bash_program_fixture_ensure_bin_specials(var_name: var_name, bin_name: bin_name),
    right: [
      bash_program_fold_tag_command(
        node: v2.extdeps.languages.bash_build.bash_build_command_from_word_nodes(words: [
          v2.extdeps.languages.bash_build.bash_build_word_lit(text: "cd"),
          root
        ])
      ),
      bash_program_fold_tag_command(
        node: v2.extdeps.languages.bash_build.bash_build_command_from_word_nodes(
          words: v2.std.algebra.list_append(
            left: [invoke],
            right: v2.std.algebra.list_map(xs: args, f: fn(a) { v2.extdeps.languages.bash_build.bash_build_word_lit(text: a) })
          )
        )
      )
    ]
  )
}

fn bash_program_fixture_gunbc_claims_specials() -> List<v2.workflow.bash_emit.BashEmitSpecial> {
  v2.std.algebra.list_append(
    left: bash_program_fixture_ensure_bin_specials(var_name: "GUNBC", bin_name: "gunbc"),
    right: [
      bash_program_fold_tag_command(
        node: v2.extdeps.languages.bash_build.bash_build_command_from_word_nodes(words: [
          v2.extdeps.languages.bash_build.bash_build_word_var(name: "GUNBC"),
          v2.extdeps.languages.bash_build.bash_build_word_lit(text: "run"),
          v2.extdeps.languages.bash_build.bash_build_word_lit(text: "--source-root"),
          v2.extdeps.languages.bash_build.bash_build_word_lit(text: "src/v2"),
          v2.extdeps.languages.bash_build.bash_build_word_lit(text: "--source-root"),
          v2.extdeps.languages.bash_build.bash_build_word_lit(text: "dag"),
          v2.extdeps.languages.bash_build.bash_build_word_lit(text: "--entry"),
          v2.extdeps.languages.bash_build.bash_build_word_lit(text: "src/v2/test/claim/bash_program_fold_test.dag"),
          v2.extdeps.languages.bash_build.bash_build_word_lit(text: "--function"),
          v2.extdeps.languages.bash_build.bash_build_word_lit(text: "bash_program_serialize_matches_golden_holds"),
          v2.extdeps.languages.bash_build.bash_build_word_lit(text: "--claim-run")
        ])
      )
    ]
  )
}
