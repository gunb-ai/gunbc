module v2.test.claim.affected_set_witness_a_prove

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data witness_a_fixture_fn_edit_touch: FloorDiffLineTouch = FloorDiffLineTouch {
  path: "src/v2/test/fixture/floor_skip/node_precise_discriminator_test.dag",
  start_line: 74,
  end_line: 74
}

fn witness_a_node_eq(left: Node, right: Node) -> Bool {
  exact_structural_equality_zip_fold(source_facts: left, candidate: right)
}

fn witness_a_dag_affected_nodes_for_path(changed: RepoPath) -> List<Node> {
  match provenance_producer_reading_from_provenance(
    git_diff: GitDiffNameOnly { changed_paths: [changed] },
    provenance: provenance_producer_node_precision_provenance
  ) {
    Holds { value: nodes } => nodes
    Violates { diagnostic: _ } => []
  }
}

fn witness_a_dag_affected_includes_mid_for_path(changed: RepoPath) -> Bool {
  count_equal(
    xs: witness_a_dag_affected_nodes_for_path(changed: changed),
    item: affected_set_mid,
    eq: witness_a_node_eq
  ) >= 1
}

data witness_a_fixture_fn_body_edit_touch: FloorDiffLineTouch = FloorDiffLineTouch {
  path: "src/v2/test/fixture/floor_skip/node_precise_discriminator_test.dag",
  start_line: 78,
  end_line: 78
}

test fn witness_a_dag_function_edited_model_holds() -> Bool {
  floor_test_fn_declaration_edited(
    touches: [witness_a_fixture_fn_edit_touch],
    file_path: "src/v2/test/fixture/floor_skip/node_precise_discriminator_test.dag",
    test_fn_decl_line: 74,
    test_fn_decl_end_line: 84
  )
}

test fn witness_a_dag_function_edited_body_touch_holds() -> Bool {
  floor_test_fn_declaration_edited(
    touches: [witness_a_fixture_fn_body_edit_touch],
    file_path: "src/v2/test/fixture/floor_skip/node_precise_discriminator_test.dag",
    test_fn_decl_line: 74,
    test_fn_decl_end_line: 84
  )
}

test fn witness_a_dag_superset_predicate_holds() -> Bool {
  floor_rust_run_implies_dag_run(
    rust_touches_frontier: true,
    rust_function_edited: false,
    dag_touches_frontier: true,
    dag_function_edited: false
  )
    && !floor_rust_run_implies_dag_run(
      rust_touches_frontier: true,
      rust_function_edited: false,
      dag_touches_frontier: false,
      dag_function_edited: false
    )
}

test fn witness_a_dag_closure_fires_on_mid_path_holds() -> Bool {
  witness_a_dag_affected_includes_mid_for_path(changed: provenance_producer_path_mid)
}

