module v2.test.claim.map_carrier_shape_gate

import std.decl_ref { decl_ref }
import std.primitive_identity {
  declaration_and_primitive_are_one_authority,
  primitive_projection_for_declaration,
}
import std.primitive_projection {
  DeclarationPrimitiveUndisposed,
  DeclarationProjectsNoPrimitive,
  DeclarationProjectsPrimitive,
  DivergentProjection,
  HostRealizedSeam,
  ModeledProjection,
  primitive_lookup,
  primitive_map_insert,
}
import std.types { Int, Map }
import v2.std.collection {
  empty_map,
  map_insert,
  map_insert_non_native_carrier_is_refused,
  map_lookup,
}
import v2.std.optional { Absent, Present }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE GATE ON THE MAP CONSTRUCTION DELEGATE AFTER IT LANDED.
//
// `map_insert` used to construct `Map { lookup: ... }` so a record-shaped map could still insert
// when the interpreter's native HAMT arm returned Ok(None). That body was O(n) per lookup of
// the earliest key. The HostRealizedSeam delegates are now the insert and lookup authority:
// `map_insert_primitive_delegate` / `map_lookup_primitive_delegate` self-call, and the public
// surfaces call them. Native maps stay HAMT. A record-shaped `Map { lookup: ... }` reaching
// `map_insert` TypeErrors at the seam (Ok(None) is not fallthrough into a wrap body).
//
// `native_map_reaches_map_insert` is the positive control. `record_shaped_map_reaches_map_insert`
// is inverted: it feeds a record-shaped Map into `map_insert_non_native_carrier_is_refused`,
// which runs `map_insert`'s grounding and treats TypeError as true. HostRealizedSeam tests
// below are roster agreement only. `first_inserted_key_is_found_after_many_inserts` is the
// executing cost witness (green on the delegate HAMT). Paired wall-clock at two sizes is an
// instrument, not a merge-blocking literal.

fn native_map_after_insert() -> Optional<String> {
  let m = empty_map()
  map_lookup(m: map_insert(m, "k", "v"), key: "k")
}

fn insert_from(m: Map<Int, Int>, i: Int, n: Int) -> Map<Int, Int> {
  if i >= n {
    m
  } else {
    insert_from(m: map_insert(m, i, i), i: i + 1, n: n)
  }
}

fn first_key_survives_later_inserts(n: Int) -> Bool {
  match map_lookup(m: insert_from(m: empty_map(), i: 0, n: n), key: 0) {
    Present { value: v } => v == 0
    Absent => false
  }
}

test fn native_map_reaches_map_insert() -> Bool {
  match native_map_after_insert() {
    Present { value: v } => v == "v"
    Absent => false
  }
}

test fn record_shaped_map_reaches_map_insert() -> Bool {
  map_insert_non_native_carrier_is_refused(
    m: Map { lookup: fn(_) { Absent } },
    key: "k",
    value: "v",
  )
    && !map_insert_non_native_carrier_is_refused(m: empty_map(), key: "k", value: "v")
}

test fn map_insert_delegate_is_host_realized_seam() -> Bool {
  declaration_and_primitive_are_one_authority(
    declaration: decl_ref(module_path: "v2.std.collection", decl_name: "map_insert_primitive_delegate"),
    primitive: primitive_map_insert,
  )
    && match primitive_projection_for_declaration(
      declaration: decl_ref(module_path: "v2.std.collection", decl_name: "map_insert_primitive_delegate")
    ) {
      DeclarationProjectsNoPrimitive => false
      DeclarationPrimitiveUndisposed { authored_symbol: _ } => false
      DeclarationProjectsPrimitive { identity: _, fidelity: fidelity } =>
        match fidelity {
          HostRealizedSeam => true
          ModeledProjection => false
          DivergentProjection { divergence: _ } => false
        }
    }
}

test fn map_lookup_delegate_is_host_realized_seam() -> Bool {
  declaration_and_primitive_are_one_authority(
    declaration: decl_ref(module_path: "v2.std.collection", decl_name: "map_lookup_primitive_delegate"),
    primitive: primitive_lookup,
  )
    && match primitive_projection_for_declaration(
      declaration: decl_ref(module_path: "v2.std.collection", decl_name: "map_lookup_primitive_delegate")
    ) {
      DeclarationProjectsNoPrimitive => false
      DeclarationPrimitiveUndisposed { authored_symbol: _ } => false
      DeclarationProjectsPrimitive { identity: _, fidelity: fidelity } =>
        match fidelity {
          HostRealizedSeam => true
          ModeledProjection => false
          DivergentProjection { divergence: _ } => false
        }
    }
}

test fn map_insert_surface_is_modeled_projection_of_the_insert_primitive() -> Bool {
  declaration_and_primitive_are_one_authority(
    declaration: decl_ref(module_path: "v2.std.collection", decl_name: "map_insert"),
    primitive: primitive_map_insert,
  )
    && match primitive_projection_for_declaration(
      declaration: decl_ref(module_path: "v2.std.collection", decl_name: "map_insert")
    ) {
      DeclarationProjectsNoPrimitive => false
      DeclarationPrimitiveUndisposed { authored_symbol: _ } => false
      DeclarationProjectsPrimitive { identity: _, fidelity: fidelity } =>
        match fidelity {
          HostRealizedSeam => false
          ModeledProjection => true
          DivergentProjection { divergence: _ } => false
        }
    }
}

test fn first_inserted_key_is_found_after_many_inserts() -> Bool {
  first_key_survives_later_inserts(n: 8)
    && first_key_survives_later_inserts(n: 64)
}
