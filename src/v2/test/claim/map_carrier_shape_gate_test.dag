module v2.test.claim.map_carrier_shape_gate


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE GATE ON THE MAP CONSTRUCTION DELEGATE, AND WHY IT IS A WITNESS RATHER THAN AN AGREEMENT.
//
// `std.types.Map` is reached through two constructors today: `v2.std.collection.empty_map()` yields the host's native map,
// and a `std.types.Map { lookup: ... }` record literal yields a closure carrying its own lookup. The
// interpreter grounds `v2.std.collection` `v2.std.collection.map_insert` on the NATIVE shape only —
// `eval_builtin`'s `free_call.map_insert` arm matches `[Value::std.types.Map, k, v]` and answers `Ok(None)`
// for anything else, which `try_v2_std_collection_map_primitive_grounding` turns into `None`,
// falling through to the `.dag` body. So `v2.std.collection.map_insert`'s body is NOT dead: it is the live arm for
// every record-shaped map.
//
// That was learned the expensive way. `v2.std.collection.map_insert` was switched to delegate to its primitive
// after measuring zero cross-module references in the EMITTED tree — true, and true only of the
// emitted path. The interpreter half was inferred from the same premise rather than measured, and
// 14 floor witnesses died with "call depth exceeded 100000 at fn 'map_insert_primitive_delegate'".
// A review approved the diff; the defect was not in the diff.
//
// These two arms are that measurement, enrolled. `record_shaped` is the discriminating one: it
// passes only while a record-shaped map can still reach `v2.std.collection.map_insert`, so it goes RED the moment
// the delegate lands while any `std.types.Map { lookup: ... }` literal survives — which is exactly the
// premature-landing defect, caught in seconds instead of by a floor run.
//
// DISSOLUTION: when the finite `std.types.Map { lookup: ... }` literals have migrated to
// `v2.std.collection.empty_map` + `v2.std.collection.map_insert` and the delegate lands as the closing move, `record_shaped` inverts —
// it must then assert that the record route is unrepresentable, not that it works. It does not
// simply delete: deleting it would remove the only executing evidence that the two shapes were
// ever reconciled.
// DISSOLUTION, AND ITS PREMISE IS NOW NARROWER THAN WHEN IT WAS WRITTEN. The original condition
// read: when the finite `Map { lookup: ... }` literals have migrated to `empty_map` + `map_insert`
// and the delegate lands as the closing move, `record_shaped` inverts — asserting the record route
// is unrepresentable rather than that it works. It does not simply delete: that would remove the
// only executing evidence that the two shapes were ever reconciled.
//
// The migration named there has happened. The 25 finite fact maps are `map_insert` chains over
// `empty_map()`, the 8 empties are `empty_map()`, and the open population — every literal whose
// lookup is a delegate or an unbounded-domain closure — names `PartialFunction` and is no longer
// spelled `Map` at all. What survives is not a residue awaiting migration: `map_insert`'s own
// `.dag` body constructs a record-shaped `Map` and MUST, because that is the arm the interpreter
// falls through to. So the record route is now produced by exactly one authority — the insert
// itself — plus this file's fixture.
//
// That changes what the closing move can be. The delegate cannot land by waiting for literals to
// disappear, because the last one is `map_insert`'s own return value: making `map_insert` delegate
// to the primitive while its body is the only record producer is the self-recursion that killed 14
// floor witnesses. The remaining condition is a HOST fact, not a corpus one — the interpreter's
// `free_call.map_insert` arm accepting the record shape, or the record shape ceasing to be
// reachable — and until one of those holds, this gate is a healthy guard being quiet, not a dead
// one.
data map_carrier_shape_gate_note: String = "Gate for the map construction delegate. map_insert grounds on the native map shape only; its .dag body is the live arm for record-shaped maps built by Map { lookup: ... } literals. record_shaped_map_reaches_map_insert reds if the delegate lands while any such literal survives."

fn native_map_after_insert() -> Optional<String> {
  let m = v2.std.collection.empty_map()
  v2.std.collection.map_lookup(m: v2.std.collection.map_insert(m, "k", "v"), key: "k")
}

fn record_shaped_map_after_insert() -> Optional<String> {
  let m = std.types.Map { lookup: fn(_) { Absent } }
  v2.std.collection.map_lookup(m: v2.std.collection.map_insert(m, "k", "v"), key: "k")
}

test fn native_map_reaches_map_insert() -> Bool {
  match native_map_after_insert() {
    Present { value: v } => v == "v"
    Absent => false
  }
}

test fn record_shaped_map_reaches_map_insert() -> Bool {
  match record_shaped_map_after_insert() {
    Present { value: v } => v == "v"
    Absent => false
  }
}
