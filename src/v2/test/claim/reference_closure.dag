module v2.test.claim.reference_closure

import v2.compiler.resolve { ResolvedTree }
import extdeps.communication.medium { Lossless, Medium }
import std.algebra { Cons, Empty, FreeMonoid, fold_list }
import v2.compiler.name_resolve {
  Admission,
  ResolutionSubject,
  resolution_context,
  resolve_in_context
}
import v2.compiler.normalized_tree { NormalizedTree }
import v2.compiler.program_assembly { module_roots_from_source_root_ingest }
import v2.compiler.reference_closure { ReferenceOwnerless, ReferenceOwnership, ReferencesOwned, reference_closure_ownership }
import v2.compiler.source_authority { DagSourceReadWitness, SourceRootIngest, text_set_of }
import v2.extdeps.languages.dag { dag_language_model, qualified_name_from_module_node }
import std.optional { Absent, Optional, Present }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.cross_tree.resolution { source_root_index_empty }
import v2.std.diagnostic { Accepted, Outcome, Rejected }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { Symbol }
import v2.std.qualified_name { QualifiedName, qualified_name_from_dotted_string, qualified_name_to_dotted_string }
import v2.std.resolution_policy { default_name_resolution_policy }
import v2.std.text { String }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// WHAT THIS FILE ESTABLISHES, AND NO MORE. v2.compiler.reference_closure reference_closure_ownership,
// with the member's resolution supplied by the real resolver over the inline corpus below, answers
// that a closure holding every module the entry's resolved references and import rows point into owns
// them, and answers the located ownerless target where a module is missing. That is a SUPPLIED-INPUT
// claim at the check's interface (DESIGN section 3): which modules a closure holds is the acquirer's
// fact (v2.compiler.module_acquisition), and the claim that the acquirer's closure and the resolver's
// references agree over the real corpus is the route's, held by the emission of the two native entries
// (gunbc test //gunbc/instruments:self-host and //gunbc/instruments:v2-native-cli), where every member
// is checked against the closure the acquirer read.
//
// THE CORPUS HAS ONE MEMBER PER EDGE KIND: an import no body mentions (rc_imported), and a fully
// qualified reference with no import (rc_dotted, the shape of a member the import graph does not
// name). The discriminating half is the missing module: a check that answered "owned" for every
// closure would pass the full-closure row and fail both rows that withhold one.

data rc_entry_source: String = "module v2.test.rc_entry\n\nimport std.types { Bool }\nimport v2.test.rc_imported { rc_imported_fn }\n\nfn rc_entry_fn(p: Bool) -> Bool { v2.test.rc_dotted.rc_dotted_fn(p: p) }\n\ndata rc_entry_literal: Int = 606060\n"

data rc_imported_source: String = "module v2.test.rc_imported\n\nimport std.types { Bool }\n\nfn rc_imported_fn(p: Bool) -> Bool { p }\n"

data rc_dotted_source: String = "module v2.test.rc_dotted\n\nimport std.types { Bool }\n\nfn rc_dotted_fn(p: Bool) -> Bool { v2.test.rc_transitive.rc_transitive_fn(p: p) }\n"

data rc_transitive_source: String = "module v2.test.rc_transitive\n\nimport std.types { Bool }\n\nfn rc_transitive_fn(p: Bool) -> Bool { p }\n"

data rc_logic_source: String = "module v2.std.logic\n\ntype Bool = True | False\n"

fn rc_read(source: String, id: Symbol, path: String) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: source, fidelity: Lossless },
    artifact: Artifact { kind: SourceFile, id: id, file_path: path },
    compilation_unit: id,
    source_root: DagTree
  }
}

data rc_ingest: SourceRootIngest = [
  rc_read(source: rc_logic_source, id: ^rc_logic_read, path: "src/v2/test/fixture/reference_closure/logic.dag"),
  rc_read(source: rc_entry_source, id: ^rc_entry_read, path: "src/v2/test/fixture/reference_closure/entry.dag"),
  rc_read(source: rc_imported_source, id: ^rc_imported_read, path: "src/v2/test/fixture/reference_closure/imported.dag"),
  rc_read(source: rc_dotted_source, id: ^rc_dotted_read, path: "src/v2/test/fixture/reference_closure/dotted.dag"),
  rc_read(source: rc_transitive_source, id: ^rc_transitive_read, path: "src/v2/test/fixture/reference_closure/transitive.dag")
]

// THE SHARE POINTS ARE THE STAGES NO CLAIM HERE IS ABOUT: the parse-and-normalize of the inline
// corpus, and the resolution of the entry. Both are NULLARY PRODUCERS enrolled in
// v2.workflow.floor_pure_producer_share, the shape v2.test.claim.namespace_xl0
// cross_module_reference_resolution already inhabits and for the same measured reason: resolving
// even a one-fn subject costs more than a new witness may spend. The real path still runs -- the
// floor's preparation executes each producer once and refuses loudly if it cannot -- and every claim
// below executes the ownership check itself, which is what each claim is about.
fn rc_fixture_normalized() -> Outcome<FreeMonoid<NormalizedTree>> {
  module_roots_from_source_root_ingest(ingest: rc_ingest, lm: dag_language_model())
}

fn rc_resolved_entry() -> Outcome<ResolvedTree> {
  match rc_fixture_normalized() {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: roots, diagnostics: _ } =>
      resolve_in_context(
        context: resolution_context(lm: dag_language_model(), roots: roots, index: source_root_index_empty(), active_roots: Empty, policy: default_name_resolution_policy()),
        admission: Admission {
          subject: ResolutionSubject { name: qualified_name_from_dotted_string(dotted: "v2.test.rc_entry") },
          imports: Empty
        }
      ).resolved
  }
}

fn rc_entry_import_targets(roots: FreeMonoid<NormalizedTree>) -> FreeMonoid<QualifiedName> {
  fold_list(xs: roots, empty: Empty, cons: fn(acc, tree) {
    match qualified_name_from_module_node(root: tree.root) {
      Accepted { value: qn, diagnostics: _ } =>
        if qn == qualified_name_from_dotted_string(dotted: "v2.test.rc_entry") {
          fold_list(xs: tree.import_bindings, empty: acc, cons: fn(a, row) { Cons { head: row.target, tail: a } })
        } else {
          acc
        }
      Rejected { diagnostics: _ } => acc
    }
  })
}

// The entry's ownership over a closure of the named modules.
fn rc_ownership_over(members: FreeMonoid<String>) -> Optional<ReferenceOwnership> {
  match rc_fixture_normalized() {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: roots, diagnostics: _ } =>
      match rc_resolved_entry() {
        Rejected { diagnostics: _ } => Absent
        Accepted { value: resolved, diagnostics: _ } =>
          Present {
            value: reference_closure_ownership(
              resolved: resolved.root,
              import_targets: rc_entry_import_targets(roots: roots),
              roster: text_set_of(names: members)
            )
          }
      }
  }
}

fn rc_every_module() -> FreeMonoid<String> {
  ["v2.test.rc_entry", "v2.test.rc_imported", "v2.test.rc_dotted", "v2.test.rc_transitive", "v2.std.logic"]
}

fn rc_without(name: String) -> FreeMonoid<String> {
  rc_every_module() |> filter(fn(m) { m != name })
}

fn rc_ownership_target(ownership: ReferenceOwnership) -> String {
  match ownership {
    ReferencesOwned => ""
    ReferenceOwnerless { target: target, at: _ } => qualified_name_to_dotted_string(qn: target)
  }
}

// The ownerless target's dotted spelling, or the empty text when every reference is owned.
fn rc_ownerless_target(members: FreeMonoid<String>) -> String {
  match rc_ownership_over(members: members) {
    Absent => "unresolved"
    Present { value: ownership } => rc_ownership_target(ownership: ownership)
  }
}

// The entry also declares an integer literal. Its lowering is a cons list of digit atoms, the same
// shape as a declaration-reference spine. The resolver marks the references it mints
// (v2.std.qualified_name declaration_reference_path_optional reads the marker, gunbc#12220), so the
// literal is no reference, and this row reds if it is ever misread again (as it was on the native
// CLI door's fixture at gunbc#12218): a literal read as a path would be ownerless.
test fn a_closure_holding_every_module_the_entry_reaches_owns_its_references_holds() -> Bool {
  rc_ownerless_target(members: rc_every_module()) == ""
}

// The seed-closure shape the import graph misses: a qualified reference with no import.
test fn a_qualified_reference_with_no_import_needs_its_module_in_the_closure_holds() -> Bool {
  starts_with(s: rc_ownerless_target(members: rc_without(name: "v2.test.rc_dotted")), prefix: "v2.test.rc_dotted")
}

// An import no body mentions leaves no reference in the resolved tree; its row is checked anyway.
test fn an_import_no_body_mentions_needs_its_module_in_the_closure_holds() -> Bool {
  starts_with(s: rc_ownerless_target(members: rc_without(name: "v2.test.rc_imported")), prefix: "v2.test.rc_imported")
}

// THE DISCRIMINATING RED: a check that answered "owned" for every closure would pass the full-closure
// row and fail here, where the entry's own references point into a closure that lacks the language's
// Bool.
test fn a_closure_lacking_the_module_a_type_resolves_into_refuses_holds() -> Bool {
  rc_ownerless_target(members: rc_without(name: "v2.std.logic")) != ""
}
