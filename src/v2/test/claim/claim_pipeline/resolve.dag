module v2.test.claim_pipeline.resolve


data spine_resolve_module_subject: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^spine_resolve_module } },
  children: [],
  occurrence_id: SyntheticOccurrence
}
fn spine_resolve_service_parse_tree() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode {
      connective: v2.std.node.Atom { identity: ^dag_c3_surface_sugar_service }
    },
    children: [
      v2.std.node.Edge {
        label: Named { name: ^spine_resolve_service_decl },
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: Conj },
          children: [],
          occurrence_id: SyntheticOccurrence
}
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn spine_resolve_accepts_normalized_tree() -> Bool {
  match normalize(parse_tree: spine_resolve_service_parse_tree()) {
    Accepted { value: normalized, diagnostics: _ } =>
      match resolve(tree: normalized, lm: dag_language_model_void()) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn spine_resolve_bool_atom(b: Bool) -> Node {
  match b {
    true =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^spine_resolve_pass } },
        children: [],
        occurrence_id: SyntheticOccurrence
}
    false =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^spine_resolve_fail } },
        children: [],
        occurrence_id: SyntheticOccurrence
}
  }
}

data claim_pipeline_resolve_module_compiles: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "claim_pipeline/resolve: v2.compiler.resolve stage module compiles",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: spine_resolve_module_subject,
  expected_value: spine_resolve_module_subject,
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_pipeline_resolve_accepts_normalize_chain: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "claim_pipeline/resolve: resolve accepts normalize output on the void language model",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: spine_resolve_bool_atom(b: spine_resolve_accepts_normalized_tree()),
  rhs: spine_resolve_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
