module v2.test.claim_pipeline.resolve

import v2.compiler.normalize { normalize }
import v2.compiler.normalized_tree { admit_normalized_tree }
import v2.compiler.resolve { resolve }
import v2.extdeps.languages.dag {
  dag_language_model_surface_empty_prelude,
  dag_language_model_void
}
import v2.std.diagnostic { Accepted, None, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.verification {
  CompilesClaim,
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}

data spine_resolve_module_subject: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^spine_resolve_module } },
  children: [],
  occurrence_id: SyntheticOccurrence
}
fn spine_resolve_service_parse_tree() -> Node {
  Node {
    kind: TypeNode {
      connective: Atom { identity: ^dag_c3_surface_sugar_service }
    },
    children: [
      Edge {
        label: Named { name: ^spine_resolve_service_decl },
        target: Node {
          kind: TypeNode { connective: Conj },
          children: [],
          occurrence_id: SyntheticOccurrence
}
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn spine_resolve_accepts_normalized_tree() -> Bool {
  match normalize(parse_tree: spine_resolve_service_parse_tree()) {
    Accepted { value: normalized, diagnostics: _ } =>
      match resolve(tree: normalized, lm: dag_language_model_void()) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

data spine_resolve_reject_module_subject: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^spine_resolve_reject_decl },
      target: Node {
        kind: TypeNode {
          connective: Atom { identity: ^spine_resolve_reject_bogus_ref }
        },
        children: [],
        occurrence_id: SyntheticOccurrence
}
    }
  ],
  occurrence_id: SyntheticOccurrence
}

// Discriminates the class-4 defect (gunbc#8505 probe A): the module root is
// legitimately declared (spine_resolve_reject_decl), but its target atom
// (spine_resolve_reject_bogus_ref) is neither declared elsewhere in the
// tree nor in canonical_symbols. Before the fix to
// namespace_bindings_augment_from_module_atoms, build_program_namespace
// self-bound every Atom node anywhere in the tree -- including this
// reference -- so it resolved without ever consulting canonical_symbols.
fn spine_resolve_rejects_noncanonical_root_atom() -> Bool {
  match admit_normalized_tree(root: spine_resolve_reject_module_subject, diagnostics: None) {
    Accepted { value: normalized, diagnostics: _ } =>
      match resolve(tree: normalized, lm: dag_language_model_surface_empty_prelude()) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: _ } => true
      }
    Rejected { diagnostics: _ } => false
  }
}

fn spine_resolve_bool_atom(b: Bool) -> Node {
  match b {
    true =>
      Node {
        kind: TypeNode { connective: Atom { identity: ^spine_resolve_pass } },
        children: [],
        occurrence_id: SyntheticOccurrence
}
    false =>
      Node {
        kind: TypeNode { connective: Atom { identity: ^spine_resolve_fail } },
        children: [],
        occurrence_id: SyntheticOccurrence
}
  }
}

data claim_pipeline_resolve_module_compiles: TestClaim = CompilesClaim {
  label: "claim_pipeline/resolve: v2.compiler.resolve stage module compiles",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: spine_resolve_module_subject,
  expected_value: spine_resolve_module_subject,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_pipeline_resolve_accepts_normalize_chain: TestClaim = EqualsClaim {
  label: "claim_pipeline/resolve: resolve accepts normalize output on the void language model",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: spine_resolve_bool_atom(b: spine_resolve_accepts_normalized_tree()),
  rhs: spine_resolve_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_pipeline_resolve_rejects_noncanonical_root_atom: TestClaim = EqualsClaim {
  label: "claim_pipeline/resolve: resolve rejects a root atom absent from both module declarations and canonical_symbols",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: spine_resolve_bool_atom(b: spine_resolve_rejects_noncanonical_root_atom()),
  rhs: spine_resolve_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
