module v2.test.claim_pipeline.translate

import v2.compiler.translate { translate }
import v2.extdeps.languages.rust { rust_mvp1_target_model }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Atom, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.verification {
  CompilesClaim,
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v2.test.manual.rust_add_emit_translate { rust_add_inferred_tree }
data spine_translate_module_subject: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^spine_translate_module } },
  children: [],
  occurrence_id: SyntheticOccurrence
}
fn spine_translate_accepts_rust_add_inferred_tree() -> Bool {
  match translate(tree: rust_add_inferred_tree, target: rust_mvp1_target_model()) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn spine_translate_bool_atom(b: Bool) -> Node {
  match b {
    true =>
      Node {
        kind: TypeNode { connective: Atom { identity: ^spine_translate_pass } },
        children: [],
        occurrence_id: SyntheticOccurrence
}
    false =>
      Node {
        kind: TypeNode { connective: Atom { identity: ^spine_translate_fail } },
        children: [],
        occurrence_id: SyntheticOccurrence
}
  }
}

data claim_pipeline_translate_module_compiles: TestClaim = CompilesClaim {
  label: "claim_pipeline/translate: v2.compiler.translate stage module compiles",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: spine_translate_module_subject,
  expected_value: spine_translate_module_subject,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_pipeline_translate_accepts_rust_add_inferred_tree: TestClaim = EqualsClaim {
  label: "claim_pipeline/translate: translate accepts rust add-fn InferredTree on rust_mvp1_target_model",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: spine_translate_bool_atom(b: spine_translate_accepts_rust_add_inferred_tree()),
  rhs: spine_translate_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
