module v2.test.claim_pipeline.resolve

import std.occurrence_identity { OccurrenceSynthetic }
import v2.compiler.normalize { normalize }
import v2.std.declaration_marker { test_marker_channel_empty }
import v2.compiler.normalized_tree { admit_normalized_tree, no_import_bindings, no_type_declaration_kinds, no_type_declaration_modifiers, no_declared_admitted_callers }
import v2.compiler.resolve { resolve }
import v2.extdeps.languages.dag {
  dag_language_model_surface_empty_prelude,
  dag_language_model_void
}
import v2.std.diagnostic { Accepted, None, Rejected }
import v2.std.node { Atom, Conj, Edge, Authored, Node, TypeNode }

// The module root as normalize hands it on: a Conj of labelled declarations. This fixture used
// to wrap it in a hand-built Atom{^dag_c3_surface_sugar_service} that a sugar rule rewrote to this
// Conj; no producer emitted that atom and the rule is deleted, so the Conj is supplied directly.
fn spine_resolve_service_parse_tree() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Authored { name: ^spine_resolve_service_decl },
        target: Node {
          kind: TypeNode { connective: Conj },
          children: [],
          occurrence_id: OccurrenceSynthetic
}
      }
    ],
    occurrence_id: OccurrenceSynthetic
}
}

test fn spine_resolve_accepts_normalized_tree() -> Bool {
  match normalize(parse_tree: spine_resolve_service_parse_tree()) {
    Accepted { value: normalized, diagnostics: _ } =>
      match resolve(tree: normalized, lm: dag_language_model_void()) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

data spine_resolve_reject_module_subject: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Authored { name: ^spine_resolve_reject_decl },
      target: Node {
        kind: TypeNode {
          connective: Atom { identity: ^spine_resolve_reject_bogus_ref }
        },
        children: [],
        occurrence_id: OccurrenceSynthetic
}
    }
  ],
  occurrence_id: OccurrenceSynthetic
}

// Discriminates the class-4 defect (gunbc#8505 probe A): the module root is
// legitimately declared (spine_resolve_reject_decl), but its target atom
// (spine_resolve_reject_bogus_ref) is neither declared elsewhere in the
// tree nor in canonical_symbols. Before the fix to
// namespace_bindings_augment_from_module_atoms, build_program_namespace
// self-bound every Atom node anywhere in the tree -- including this
// reference -- so it resolved without ever consulting canonical_symbols.
test fn spine_resolve_rejects_noncanonical_root_atom() -> Bool {
  match admit_normalized_tree(import_bindings: no_import_bindings(), type_declaration_kinds: no_type_declaration_kinds(), type_declaration_modifiers: no_type_declaration_modifiers(), declared_admitted_callers: no_declared_admitted_callers(), test_markers: test_marker_channel_empty(), root: spine_resolve_reject_module_subject, diagnostics: None) {
    Accepted { value: normalized, diagnostics: _ } =>
      match resolve(tree: normalized, lm: dag_language_model_surface_empty_prelude()) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: _ } => true
      }
    Rejected { diagnostics: _ } => false
  }
}
