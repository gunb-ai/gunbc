module v2.test.claim_pipeline.resolve

fn spine_resolve_service_parse_tree() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode {
      connective: v2.std.node.Atom { identity: ^dag_c3_surface_sugar_service }
    },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^spine_resolve_service_decl },
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
          children: [],
          occurrence_id: v2.std.node.SyntheticOccurrence
}
      }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

test fn spine_resolve_accepts_normalized_tree() -> v2.std.logic.Bool {
  match v2.compiler.normalize.normalize(parse_tree: spine_resolve_service_parse_tree()) {
    Accepted { value: normalized, diagnostics: _ } =>
      match v2.compiler.resolve.resolve(tree: normalized, lm: v2.extdeps.languages.dag.dag_language_model_void()) {
        Accepted { value: _, diagnostics: _ } => true
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

data spine_resolve_reject_module_subject: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
  children: [
    v2.std.node.Edge {
      label: v2.std.node.Named { name: ^spine_resolve_reject_decl },
      target: v2.std.node.Node {
        kind: v2.std.node.TypeNode {
          connective: v2.std.node.Atom { identity: ^spine_resolve_reject_bogus_ref }
        },
        children: [],
        occurrence_id: v2.std.node.SyntheticOccurrence
}
    }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

// Discriminates the class-4 defect (gunbc#8505 probe A): the module root is
// legitimately declared (spine_resolve_reject_decl), but its target atom
// (spine_resolve_reject_bogus_ref) is neither declared elsewhere in the
// tree nor in canonical_symbols. Before the fix to
// namespace_bindings_augment_from_module_atoms, build_program_namespace
// self-bound every Atom node anywhere in the tree -- including this
// reference -- so it resolved without ever consulting canonical_symbols.
test fn spine_resolve_rejects_noncanonical_root_atom() -> v2.std.logic.Bool {
  match v2.compiler.normalized_tree.admit_normalized_tree(root: spine_resolve_reject_module_subject, diagnostics: v2.std.diagnostic.None) {
    Accepted { value: normalized, diagnostics: _ } =>
      match v2.compiler.resolve.resolve(tree: normalized, lm: v2.extdeps.languages.dag.dag_language_model_surface_empty_prelude()) {
        Accepted { value: _, diagnostics: _ } => false
        v2.std.diagnostic.Rejected { diagnostics: _ } => true
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}
