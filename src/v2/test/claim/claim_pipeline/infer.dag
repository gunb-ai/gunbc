module v2.test.claim_pipeline.infer


data spine_infer_module_subject: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^spine_infer_module } },
  children: [],
  occurrence_id: SyntheticOccurrence
}
fn spine_infer_accepts_resolved_tree() -> Bool {
  match infer(tree: fixture_add_resolved_tree()) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn spine_infer_bool_atom(b: Bool) -> Node {
  match b {
    true =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^spine_infer_pass } },
        children: [],
        occurrence_id: SyntheticOccurrence
}
    false =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^spine_infer_fail } },
        children: [],
        occurrence_id: SyntheticOccurrence
}
  }
}

data claim_pipeline_infer_module_compiles: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "claim_pipeline/infer: v2.compiler.infer stage module compiles",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: spine_infer_module_subject,
  expected_value: spine_infer_module_subject,
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_pipeline_infer_accepts_resolved_tree: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "claim_pipeline/infer: infer accepts add-shaped ResolvedTree (T-9 worked fixture)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: spine_infer_bool_atom(b: spine_infer_accepts_resolved_tree()),
  rhs: spine_infer_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
