module v2.test.claim.roster_registry_test





// Constructs the empty condition through the NON-LITERAL path deliberately.
// The literal form `unbound_dissolution(description: "")` is refused at compile
// now that the parameter is NonEmptyStr -- that is the wall. Refinement at
// non-literal positions is still deferred, and that gap is exactly what the
// downstream well-formedness guard defends, so this control has to reach it
// through the gap to keep proving the guard works (DESIGN 4b(4): production
// machinery dissolves on a climb, the evidence stays enrolled).
fn synthetic_nonliteral_text(text: String) -> std.types.NonEmptyStr {
  concat(text, "")
}

fn synthetic_empty_condition(text: String) -> std.dissolution.DissolutionCondition {
  std.dissolution.unbound_dissolution(description: synthetic_nonliteral_text(text: text))
}

fn synthetic_registration(membership: gunbc.roster_registry.GroupMembership) -> gunbc.roster_registry.RosterRegistration {
  gunbc.roster_registry.RosterRegistration {
    roster: gunbc.roster_registry.roster_decl(module_path: "v2.test.synthetic", decl_name: "synthetic_roster"),
    unit_kind: "synthetic unit",
    membership: membership
  }
}


fn nickname_registration() -> gunbc.roster_registry.RosterRegistration {
  synthetic_registration(
    membership: DeclaredFrontier { reason: "", dissolution: std.dissolution.unbound_dissolution(description: "nickname-class control: the reason axis is the writable one") }
  )
}

test fn roster_registry_standard_holds_live() -> Bool {
  roster_registry_standard_holds() && (roster_registry_nonstandard_count() == 0)
}

test fn roster_registry_enrolls_known_rosters() -> Bool {
  length(xs: gunbc.roster_registry.roster_registry) >= 26
}


fn empty_trigger_registration() -> gunbc.roster_registry.RosterRegistration {
  synthetic_registration(
    membership: DeclaredFrontier {
      reason: "a reason without a trigger is not a frontier row",
      dissolution: synthetic_empty_condition(text: "")
    }
  )
}

// Restored alongside the production guard, for the same reason: an empty
// condition is still constructible, so this is the executing evidence that the
// restored check refuses it.
test fn roster_registry_red_control_empty_trigger_reds() -> Bool {
  roster_registry_nonstandard_count_from(
    registrations: [empty_trigger_registration()]
  ) == 1
}

test fn roster_registry_red_control_nickname_reds() -> Bool {
  let findings = nonstandard_registrations_from(
    registrations: [nickname_registration()]
  )
  (length(xs: findings) == 1)
    && fold(
      findings,
      init: true,
      f: fn(acc, f) { acc && (f.roster_decl_name == "synthetic_roster") }
    )
}

test fn roster_registry_green_control_standard_forms_pass() -> Bool {
  roster_registry_nonstandard_count_from(
    registrations: [
      synthetic_registration(membership: ByContainment),
      synthetic_registration(
        membership: gunbc.roster_registry.ByDerivation {
          predicate: gunbc.roster_registry.roster_decl(module_path: "v2.test.synthetic", decl_name: "derivation_fn")
        }
      ),
      synthetic_registration(
        membership: DeclaredFrontier {
          reason: "declared with a reason",
          dissolution: std.dissolution.unbound_dissolution(description: "and a trigger")
        }
      )
    ]
  ) == 0
}
