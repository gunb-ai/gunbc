module v2.test.claim.build_workspace_grant_witness

import std.types { Bool, String, List }
import std.effect_grant {
  Read, Write, verb_eq,
  NamespaceTree, FilesystemPathTree, UriTree,
  NamespacePosition, position_under,
  EffectAdmission, Admitted, EffectOutsideGrant, admit_effect,
  Envelope,
}
import std.materialization_ladder { Frame, SharedStateFrame }
import v2.compiler.build_workspace_grant { build_workspace_grant_envelope }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data build_workspace_grant_witness_note: String = "Discriminating witnesses for the build-envelope authority (v2.compiler.build_workspace_grant, docs/plans/effect-namespace-grants.md 6). The claim is fail-closed build admissibility (DESIGN 5): a build's WRITES are scoped to its own workspace, its READS to the content-addressed closure + pinned toolchain + its own workspace (the emitted sources and intermediates it reads back), and network is refused BY CONSTRUCTION (no UriTree grant, so no arm to widen). Every positive arm is paired with a RED control that goes red if a scope is dropped: writing the repo tree admits, writing the read-only toolchain/closure admits, reading the LIVE repo tree (instead of the content-addressed closure) admits, or any network target admits. The workspace Read grant resolves the ownership-implies-read question this row initially deferred: P-B (build_transport_admission) decided a build reads its own workspace, so it is asserted here (build_workspace_grant_admits_workspace_read)."

data build_frame: Frame = Frame { name: "build", kind: SharedStateFrame }

data ws_root: NamespacePosition = NamespacePosition {
  tree: FilesystemPathTree,
  path: ["build", "ws"]
}

data closure_root: NamespacePosition = NamespacePosition {
  tree: FilesystemPathTree,
  path: ["substrate", "closure"]
}

data toolchain_root: NamespacePosition = NamespacePosition {
  tree: FilesystemPathTree,
  path: ["toolchain", "rustc-pinned"]
}

data build_env: Envelope = build_workspace_grant_envelope(
  workspace_root: ws_root,
  substrate_closure_root: closure_root,
  toolchain_root: toolchain_root,
  frame: build_frame
)

data ws_write_target: NamespacePosition = NamespacePosition {
  tree: FilesystemPathTree,
  path: ["build", "ws", "target", "obj.o"]
}

data closure_read_target: NamespacePosition = NamespacePosition {
  tree: FilesystemPathTree,
  path: ["substrate", "closure", "cafe1234", "mod.dag"]
}

data toolchain_read_target: NamespacePosition = NamespacePosition {
  tree: FilesystemPathTree,
  path: ["toolchain", "rustc-pinned", "bin", "rustc"]
}

data repo_tree_target: NamespacePosition = NamespacePosition {
  tree: FilesystemPathTree,
  path: ["repo", "src", "main.rs"]
}

data network_target: NamespacePosition = NamespacePosition {
  tree: UriTree,
  path: ["https://crates.io", "api", "download"]
}

fn is_admitted(a: EffectAdmission) -> Bool {
  match a {
    Admitted { via_root: r } => true
    EffectOutsideGrant { verb: v, target: t, frame: f } => false
  }
}

fn is_refused(a: EffectAdmission) -> Bool {
  match a {
    Admitted { via_root: r } => false
    EffectOutsideGrant { verb: v, target: t, frame: f } => true
  }
}

test fn build_workspace_grant_admits_declared_reach() -> Bool {
  is_admitted(a: admit_effect(env: build_env, verb: Write, target: ws_write_target))
    && is_admitted(a: admit_effect(env: build_env, verb: Read, target: closure_read_target))
    && is_admitted(a: admit_effect(env: build_env, verb: Read, target: toolchain_read_target))
}

test fn build_workspace_grant_admits_workspace_read() -> Bool {
  is_admitted(a: admit_effect(env: build_env, verb: Read, target: ws_write_target))
    && is_refused(a: admit_effect(env: build_env, verb: Read, target: repo_tree_target))
}

test fn build_workspace_grant_refuses_undeclared_write() -> Bool {
  is_refused(a: admit_effect(env: build_env, verb: Write, target: repo_tree_target))
    && is_refused(a: admit_effect(env: build_env, verb: Write, target: toolchain_read_target))
    && is_refused(a: admit_effect(env: build_env, verb: Write, target: closure_read_target))
}

test fn build_workspace_grant_refuses_live_repo_read() -> Bool {
  is_refused(a: admit_effect(env: build_env, verb: Read, target: repo_tree_target))
    && is_admitted(a: admit_effect(env: build_env, verb: Read, target: closure_read_target))
}

test fn build_workspace_grant_refuses_network_by_construction() -> Bool {
  is_refused(a: admit_effect(env: build_env, verb: Read, target: network_target))
    && is_refused(a: admit_effect(env: build_env, verb: Write, target: network_target))
}

test fn build_workspace_grant_refusal_is_located() -> Bool {
  match admit_effect(env: build_env, verb: Write, target: repo_tree_target) {
    EffectOutsideGrant { verb: v, target: t, frame: f } =>
      verb_eq(a: v, b: Write)
        && position_under(target: repo_tree_target, root: t)
        && position_under(target: t, root: repo_tree_target)
    Admitted { via_root: r } => false
  }
}
