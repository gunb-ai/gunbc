module v2.test.claim.coproduct_fixture

import std.occurrence_identity { OccurrenceSynthetic }
import v2.std.node { Authored, Conj, Disj, Edge, Node, Symbol, TypeNode, NotADeclaration }

// THE ONE SHAPE TWO CLAIMS MEET AT (DESIGN section 3 pairing obligation). The lowering claim
// (v2.test.claim.coproduct_pipe_chain_declaration_order) asserts that the pipe chain
// `Active | Pending | Revoked | Zed | Beta` lowers to the arm edges of this node, in this order; the
// emit claim (v2.test.claim.emit.swift_semantic_decl_routing, added by the stacked L2a-records PR; its
// import of cpf_standing_disj lands when that PR does) takes this node as the INPUT of
// emit_semantic_type_decl. cpf_arm is also the arm constructor of the hash-identity claim. A change to the declared order or arm shape edits this constructor and
// breaks whichever side no longer agrees, so neither claim can be satisfied by a private fixture.
fn cpf_arm(name: Symbol) -> Edge {
  Edge {
    label: Authored { name: name },
    target: Node { kind: TypeNode { connective: Conj }, children: [], occurrence_id: OccurrenceSynthetic },
    declaration: NotADeclaration
  }
}

fn cpf_standing_disj() -> Node {
  Node {
    kind: TypeNode { connective: Disj },
    children: [ cpf_arm(name: ^Active), cpf_arm(name: ^Pending), cpf_arm(name: ^Revoked), cpf_arm(name: ^Zed), cpf_arm(name: ^Beta) ],
    occurrence_id: OccurrenceSynthetic
  }
}
