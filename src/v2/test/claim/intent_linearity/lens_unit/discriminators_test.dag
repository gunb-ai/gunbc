module v2.test.intent_linearity.lens_unit.discriminators


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn atom(id: v2.std.node.Symbol) -> Node {
  node_synthetic(kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } }, children: [])
}
fn conj2(a: Node, b: Node) -> Node {
  node_synthetic(kind: v2.std.node.TypeNode { connective: Conj }, children: [
    v2.std.node.Edge { label: Positional, target: a }, v2.std.node.Edge { label: Positional, target: b } ])
}

data red_chain: List<Node> = [
  v2.test.intent_linearity.lens_unit.discriminators.conj2(a: v2.test.intent_linearity.lens_unit.discriminators.atom(id: ^run), b: v2.test.intent_linearity.lens_unit.discriminators.atom(id: ^gate_rust)),
  v2.test.intent_linearity.lens_unit.discriminators.conj2(a: v2.test.intent_linearity.lens_unit.discriminators.atom(id: ^run), b: v2.test.intent_linearity.lens_unit.discriminators.atom(id: ^gate_emit)),
  v2.test.intent_linearity.lens_unit.discriminators.conj2(a: v2.test.intent_linearity.lens_unit.discriminators.atom(id: ^run), b: v2.test.intent_linearity.lens_unit.discriminators.atom(id: ^gate_layer))
]

data linear_chain_a: List<Node> = [
  v2.test.intent_linearity.lens_unit.discriminators.conj2(a: v2.test.intent_linearity.lens_unit.discriminators.atom(id: ^is_if),     b: v2.test.intent_linearity.lens_unit.discriminators.atom(id: ^s0)),
  v2.test.intent_linearity.lens_unit.discriminators.conj2(a: v2.test.intent_linearity.lens_unit.discriminators.atom(id: ^is_assign), b: v2.test.intent_linearity.lens_unit.discriminators.conj2(a: v2.test.intent_linearity.lens_unit.discriminators.atom(id: ^skip), b: v2.test.intent_linearity.lens_unit.discriminators.atom(id: ^s1))),
  v2.test.intent_linearity.lens_unit.discriminators.conj2(a: v2.test.intent_linearity.lens_unit.discriminators.atom(id: ^is_loop),   b: v2.test.intent_linearity.lens_unit.discriminators.conj2(a: v2.test.intent_linearity.lens_unit.discriminators.atom(id: ^skip), b: v2.test.intent_linearity.lens_unit.discriminators.atom(id: ^s2)))
]
data linear_chain_b: List<Node> = [
  v2.test.intent_linearity.lens_unit.discriminators.conj2(a: v2.test.intent_linearity.lens_unit.discriminators.atom(id: ^emit),  b: v2.test.intent_linearity.lens_unit.discriminators.atom(id: ^t0)),
  v2.test.intent_linearity.lens_unit.discriminators.conj2(a: v2.test.intent_linearity.lens_unit.discriminators.atom(id: ^parse), b: v2.test.intent_linearity.lens_unit.discriminators.conj2(a: v2.test.intent_linearity.lens_unit.discriminators.atom(id: ^wrap), b: v2.test.intent_linearity.lens_unit.discriminators.atom(id: ^t1))),
  v2.test.intent_linearity.lens_unit.discriminators.conj2(a: v2.test.intent_linearity.lens_unit.discriminators.atom(id: ^check), b: v2.test.intent_linearity.lens_unit.discriminators.conj2(a: v2.test.intent_linearity.lens_unit.discriminators.atom(id: ^wrap), b: v2.test.intent_linearity.lens_unit.discriminators.atom(id: ^t2)))
]

test fn unroll_detected_by_registry() -> Bool {
  chain_is_redundant(steps: red_chain)
}
test fn residual_is_n_minus_one() -> Bool {
  chain_residual(steps: red_chain) == 2
}
test fn minimal_chain_has_zero_residual() -> Bool {
  chain_residual(steps: linear_chain_a) == 0
}

data nonlinear_body: List<List<Node>> = [ red_chain, red_chain ]
test fn body_with_unroll_is_not_linear() -> Bool {
  !body_is_linear(levels: nonlinear_body)
}
data linear_body: List<List<Node>> = [ linear_chain_a, linear_chain_b ]
test fn all_minimal_body_is_linear() -> Bool {
  body_is_linear(levels: linear_body)
}
test fn single_minimal_level_is_linear() -> Bool {
  level_is_linear(level: linear_chain_b)
}

data dup_type_pair: List<Node> = [
  v2.test.intent_linearity.lens_unit.discriminators.conj2(a: v2.test.intent_linearity.lens_unit.discriminators.atom(id: ^x86), b: v2.test.intent_linearity.lens_unit.discriminators.atom(id: ^arm)),
  v2.test.intent_linearity.lens_unit.discriminators.conj2(a: v2.test.intent_linearity.lens_unit.discriminators.atom(id: ^x86), b: v2.test.intent_linearity.lens_unit.discriminators.atom(id: ^arm))
]
test fn dup_type_decls_redundant_through_registry() -> Bool {
  forest_is_redundant(decls: dup_type_pair)
}
test fn dup_type_pair_not_flagged_by_term_binder() -> Bool {
  !chain_is_redundant(steps: dup_type_pair)
}
