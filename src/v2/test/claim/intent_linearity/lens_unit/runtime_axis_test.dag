module v2.test.intent_linearity.lens_unit.runtime_axis

import v2.lens.intent_linearity { chain_has_rewritable_cost, chain_is_redundant, level_is_linear }
import v2.std.node {
  Cardinality,
  ComputationNode,
  Edge,
  Node,
  Positional,
  Transform,
  TypeNode,
  node_synthetic
}
import v2.std.collection { List }
import v2.std.logic { Bool }

fn transform_leaf() -> Node {
  node_synthetic(kind: ComputationNode { behavior: Transform }, children: [])
}
fn cardinality_over(child: Node) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Cardinality },
    children: [ Edge { label: Positional, target: child } ]
  )
}

// A nested loop -- cardinality over cardinality over transform -- costs ProductCost(Linear, Linear) = O(n^2).
data nested_loop: Node = cardinality_over(child: cardinality_over(child: transform_leaf()))
// A flat loop -- a single cardinality -- costs LinearCost = O(n), already at its run-time minimum.
data flat_loop: Node = cardinality_over(child: transform_leaf())

data nested_chain: List<Node> = [ nested_loop ]
data flat_chain: List<Node> = [ flat_loop ]

// ── the RunTime engine directly: the nested-loop cost is reducible, the flat-loop cost is not ───────
test fn nested_loop_cost_is_rewritable() -> Bool {
  chain_has_rewritable_cost(steps: nested_chain)
}
test fn flat_loop_cost_not_rewritable() -> Bool {
  !chain_has_rewritable_cost(steps: flat_chain)
}

// ── through the registry (Row 1 unroll + Row 2 complexity): the RunTime row flags the nested loop ───
test fn nested_loop_chain_is_redundant() -> Bool {
  chain_is_redundant(steps: nested_chain)
}
test fn flat_loop_chain_is_linear() -> Bool {
  level_is_linear(level: flat_chain)
}
