module v2.test.claim.intent_linearity.lens_unit.runtime_axis

import std.types { List }
import v2.lens.complexity_lowering { cost_is_lowerable }
import v2.lens.cost { symbolic_cost_of_node }
import v2.lens.fn_family { sigma_families_of_defs }
import v2.lens.intent_linearity {
  chain_has_lowerable_cost,
  chain_has_runtime_lowering_candidate,
  chain_is_redundant,
  level_is_linear
}
import v2.lens.simulated_relationship { chain_is_simulated }
import v2.lens.structural_similarity { type_decls_anti_unify }
import v2.std.node {
  Atom,
  Loop,
  LoopBoundEdge,
  core_edge_label,
  ComputationNode,
  Edge,
  Node,
  Positional,
  Transform,
  TypeNode,
  node_synthetic,
  NotADeclaration
}
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn transform_leaf() -> Node {
  node_synthetic(kind: ComputationNode { behavior: Transform }, children: [])
}
fn loop_over(child: Node) -> Node {
  node_synthetic(
    kind: ComputationNode { behavior: Loop },
    children: [
      Edge { label: Positional, target: child, declaration: NotADeclaration },
      Edge {
        label: core_edge_label(marker: LoopBoundEdge),
        target: node_synthetic(kind: TypeNode { connective: Atom { identity: ^runtime_axis_measure_atom } }, children: []), declaration: NotADeclaration
}
    ]
  )
}

data nested_loop: Node = loop_over(child: loop_over(child: transform_leaf()))
data flat_loop: Node = loop_over(child: transform_leaf())

data nested_chain: List<Node> = [ nested_loop ]
data flat_chain: List<Node> = [ flat_loop ]

test fn nested_loop_cost_is_lowerable() -> Bool {
  chain_has_lowerable_cost(steps: nested_chain)
}
test fn flat_loop_cost_not_lowerable() -> Bool {
  !chain_has_lowerable_cost(steps: flat_chain)
}

test fn nested_loop_is_runtime_candidate() -> Bool {
  chain_has_runtime_lowering_candidate(steps: nested_chain)
}
test fn flat_loop_not_runtime_candidate() -> Bool {
  !chain_has_runtime_lowering_candidate(steps: flat_chain)
}

test fn nested_loop_not_changetime_redundant() -> Bool {
  !chain_is_redundant(steps: nested_chain)
}
test fn flat_loop_is_linear() -> Bool {
  level_is_linear(level: flat_chain)
}
