module v2.test.intent_linearity.lens_unit.import_graph

import v2.lens.intent_linearity {
  ClosureFact,
  ParallelRepresentationRule,
  ChangeTime,
  ImportGraph,
  import_graph_rule,
  import_closure_is_clean,
  closure_drift,
  closure_is_clean,
  closures_match
}
import v2.lens.common.construction_justification { WallAfterGrounding }
import std.disposition { SingleAuthority }
import v2.std.collection { List }
import v2.std.text { String }
import v2.std.logic { Bool }

data clean_declared: List<String> = ["self.dag", "a.dag", "b.dag"]
data clean_derived: List<String> = ["self.dag", "a.dag", "b.dag"]

data clean_fact: ClosureFact = ClosureFact {
  unit: ^clean_unit,
  declared: clean_declared,
  derived: clean_derived
}

data under_declared_fact: ClosureFact = ClosureFact {
  unit: ^under_unit,
  declared: ["self.dag", "a.dag"],
  derived: ["self.dag", "a.dag", "b.dag"]
}

data over_declared_fact: ClosureFact = ClosureFact {
  unit: ^over_unit,
  declared: ["self.dag", "a.dag", "b.dag", "stale.dag"],
  derived: ["self.dag", "a.dag", "b.dag"]
}

data reordered_fact: ClosureFact = ClosureFact {
  unit: ^reordered_unit,
  declared: ["b.dag", "self.dag", "a.dag"],
  derived: ["self.dag", "a.dag", "b.dag"]
}

test fn clean_closure_is_clean() -> Bool {
  import_closure_is_clean(fact: clean_fact)
}

test fn clean_closure_has_no_drift() -> Bool {
  !closure_drift(fact: clean_fact)
}

test fn under_declared_is_not_clean() -> Bool {
  !import_closure_is_clean(fact: under_declared_fact)
}

test fn under_declared_drifts() -> Bool {
  closure_drift(fact: under_declared_fact)
}

test fn over_declared_is_not_clean() -> Bool {
  !import_closure_is_clean(fact: over_declared_fact)
}

test fn over_declared_drifts() -> Bool {
  closure_drift(fact: over_declared_fact)
}

test fn drift_is_set_not_list_order() -> Bool {
  closures_match(declared: reordered_fact.declared, derived: reordered_fact.derived)
    && import_closure_is_clean(fact: reordered_fact)
}

test fn import_graph_rule_is_wall_now() -> Bool {
  closure_is_clean(rule: import_graph_rule(), fact: clean_fact)
    && !closure_is_clean(rule: import_graph_rule(), fact: under_declared_fact)
}

fn shrinking_scaffold_rule() -> ParallelRepresentationRule {
  ParallelRepresentationRule {
    name: ^exception_roster,
    axis: ChangeTime,
    representation: ImportGraph,
    class: WallAfterGrounding { dissolves_to: SingleAuthority }
  }
}

test fn wall_after_grounding_tracks_drift_not_fails() -> Bool {
  closure_drift(fact: under_declared_fact)
    && closure_is_clean(rule: shrinking_scaffold_rule(), fact: under_declared_fact)
}
