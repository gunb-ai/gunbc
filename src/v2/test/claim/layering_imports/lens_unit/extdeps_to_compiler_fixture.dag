  LayerImportFact,
  layering_imports_violation_count
}
import v2.std.collection { List }
import v2.std.layer { LayerPrefixExtdeps }
import v2.std.logic { Bool }

data extdeps_to_compiler_fixture_facts: List<LayerImportFact> = [
  LayerImportFact {
    layer: LayerPrefixExtdeps,
    path: "src/v2/extdeps/_perturb_layering_extdeps_to_compiler.dag",
    import_module: "v2.compiler.parse"
  }
]

fn detects_extdeps_to_compiler_import_holds() -> Bool {
  layering_imports_violation_count(facts: extdeps_to_compiler_fixture_facts) == 1
}
