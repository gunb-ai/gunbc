module v2.test.layering_imports.lens_unit.dag_extdeps_v4_exact_fixture


data dag_extdeps_v4_exact_fixture_facts: List<LayerImportFact> = [
  LayerImportFact {
    layer: LayerPrefixExtdeps,
    path: "dag/extdeps/_perturb_v4_compiler_exact.dag",
    import_module: "v2.compiler"
  }
]

fn detects_dag_extdeps_v4_exact_compiler_import_holds() -> Bool {
  layering_imports_violation_count(facts: dag_extdeps_v4_exact_fixture_facts) == 1
}
