module v2.test.layering_imports.lens_unit.dsl_extdeps_v4_exact_fixture

import v2.lens.layering_imports {
  LayerImportFact,
  layering_imports_violation_count
}
import v2.std.collection { List }
import v2.std.layer { LayerPrefixExtdeps }
import v2.std.logic { Bool }

data dsl_extdeps_v4_exact_fixture_facts: List<LayerImportFact> = [
  LayerImportFact {
    layer: LayerPrefixExtdeps,
    path: "dsl/extdeps/_perturb_v4_compiler_exact.dag",
    import_module: "v2.compiler"
  }
]

fn detects_dsl_extdeps_v4_exact_compiler_import_holds() -> Bool {
  layering_imports_violation_count(facts: dsl_extdeps_v4_exact_fixture_facts) == 1
}
