module v2.test.layering_imports.scanner.parse_level_pre_resolve

import v2.lens.layering_imports {
  layering_imports_violation_count,
  layering_imports_clean_holds,
  layer_import_facts_live
}
import v2.std.collection { List }
import v2.std.logic { Bool }

data parse_level_pre_resolve_std_roots: List<String> = ["src/v2/test/fixture/layering_scan/parse_level_pre_resolve/std"]
data parse_level_pre_resolve_extdeps_roots: List<String> = []

fn scanner_parse_level_pre_resolve_detects_holds() -> Bool {
  let facts = layer_import_facts_live(
    std_roots: parse_level_pre_resolve_std_roots,
    extdeps_roots: parse_level_pre_resolve_extdeps_roots
  )
  (layering_imports_violation_count(facts: facts) == 1)
    && (layering_imports_clean_holds(facts: facts) == false)
}
