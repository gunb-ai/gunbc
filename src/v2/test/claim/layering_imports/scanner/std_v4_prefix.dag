module v2.test.layering_imports.scanner.std_v4_prefix


data std_v4_prefix_std_roots: List<String> = ["src/v2/test/fixture/layering_scan/std_v4_prefix/std"]
data std_v4_prefix_extdeps_roots: List<String> = []

fn scanner_std_v4_prefix_detects_holds() -> Bool {
  let facts = layer_import_facts_live(
    std_roots: std_v4_prefix_std_roots,
    extdeps_roots: std_v4_prefix_extdeps_roots
  )
  (layering_imports_violation_count(facts: facts) == 1)
    && (layering_imports_clean_holds(facts: facts) == false)
}
