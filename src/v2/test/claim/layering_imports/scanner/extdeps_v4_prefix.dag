module v2.test.layering_imports.scanner.extdeps_v4_prefix


data extdeps_v4_prefix_std_roots: List<String> = []
data extdeps_v4_prefix_extdeps_roots: List<String> = ["src/v2/test/fixture/layering_scan/extdeps_v4_prefix/extdeps"]

fn scanner_extdeps_v4_prefix_detects_holds() -> Bool {
  let facts = layer_import_facts_live(
    std_roots: extdeps_v4_prefix_std_roots,
    extdeps_roots: extdeps_v4_prefix_extdeps_roots
  )
  (layering_imports_violation_count(facts: facts) == 1)
    && (layering_imports_clean_holds(facts: facts) == false)
}
