module v2.test.layering_imports.scanner.std_imports_extdeps


data std_imports_extdeps_std_roots: List<String> = ["src/v2/test/fixture/layering_scan/std_imports_extdeps/std"]
data std_imports_extdeps_extdeps_roots: List<String> = []

fn scanner_std_imports_extdeps_detects_holds() -> Bool {
  let facts = layer_import_facts_live(
    std_roots: std_imports_extdeps_std_roots,
    extdeps_roots: std_imports_extdeps_extdeps_roots
  )
  (layering_imports_violation_count(facts: facts) == 1)
    && (layering_imports_clean_holds(facts: facts) == false)
}
