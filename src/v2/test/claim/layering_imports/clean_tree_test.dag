module v2.test.layering_imports.clean_tree


data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data layering_std_roots: List<String> = ["src/v2/std", "dag/std"]
data layering_extdeps_roots: List<String> = ["src/v2/extdeps", "dag/extdeps"]

test fn clean_tree_no_wrong_direction_imports_holds() -> Bool {
  layering_imports_clean_holds(facts: layer_import_facts_live(
    std_roots: layering_std_roots,
    extdeps_roots: layering_extdeps_roots
  ))
}
