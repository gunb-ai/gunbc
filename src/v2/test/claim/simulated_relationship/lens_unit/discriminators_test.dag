module v2.test.simulated_relationship.lens_unit.discriminators


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn atom(id: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.node_synthetic(kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } }, children: [])
}
fn conj2(a: v2.std.node.Node, b: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.node_synthetic(
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: a },
      v2.std.node.Edge { label: v2.std.node.Positional, target: b }
    ]
  )
}
fn conj3(a: v2.std.node.Node, b: v2.std.node.Node, c: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.node_synthetic(
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: a },
      v2.std.node.Edge { label: v2.std.node.Positional, target: b },
      v2.std.node.Edge { label: v2.std.node.Positional, target: c }
    ]
  )
}

data red_gate_chain: List<v2.std.node.Node> = [
  conj3(a: atom(id: ^run), b: atom(id: ^gate_rust),  c: atom(id: ^acc0)),
  conj3(a: atom(id: ^run), b: atom(id: ^gate_emit),  c: atom(id: ^acc1)),
  conj3(a: atom(id: ^run), b: atom(id: ^gate_layer), c: atom(id: ^acc2))
]

data red_positional_typecheck: List<v2.std.node.Node> = [
  conj3(a: atom(id: ^eq), b: atom(id: ^skip0), c: atom(id: ^demand_isolation)),
  conj3(a: atom(id: ^eq), b: atom(id: ^skip1), c: atom(id: ^demand_cpu)),
  conj3(a: atom(id: ^eq), b: atom(id: ^skip2), c: atom(id: ^demand_memory))
]

data green_divergent_op: List<v2.std.node.Node> = [
  conj2(a: atom(id: ^is_if),     b: atom(id: ^stmt_first)),
  conj2(a: atom(id: ^is_assign), b: conj2(a: atom(id: ^skip), b: atom(id: ^stmt_first))),
  conj2(a: atom(id: ^is_loop),   b: conj2(a: atom(id: ^skip), b: atom(id: ^stmt_first)))
]

data green_distinct_input: List<v2.std.node.Node> = [
  conj2(a: atom(id: ^label), b: atom(id: ^v_nullary)),
  conj2(a: atom(id: ^label), b: conj2(a: atom(id: ^record_ctor), b: atom(id: ^field_a))),
  conj2(a: atom(id: ^label), b: conj2(a: atom(id: ^record_ctor), b: atom(id: ^field_b)))
]

data green_too_short: List<v2.std.node.Node> = [
  conj3(a: atom(id: ^run), b: atom(id: ^gate_rust), c: atom(id: ^acc0)),
  conj3(a: atom(id: ^run), b: atom(id: ^gate_emit), c: atom(id: ^acc1))
]

data green_pure_duplication: List<v2.std.node.Node> = [
  conj2(a: atom(id: ^x), b: atom(id: ^y)),
  conj2(a: atom(id: ^x), b: atom(id: ^y)),
  conj2(a: atom(id: ^x), b: atom(id: ^y))
]

test fn gate_chain_is_simulated() -> Bool {
  v2.lens.simulated_relationship.chain_is_simulated(steps: red_gate_chain)
}
test fn positional_typecheck_is_simulated() -> Bool {
  v2.lens.simulated_relationship.chain_is_simulated(steps: red_positional_typecheck)
}
test fn divergent_operation_is_not_simulated() -> Bool {
  !v2.lens.simulated_relationship.chain_is_simulated(steps: green_divergent_op)
}
test fn distinct_input_is_not_simulated() -> Bool {
  !v2.lens.simulated_relationship.chain_is_simulated(steps: green_distinct_input)
}
test fn too_short_chain_is_not_simulated() -> Bool {
  !v2.lens.simulated_relationship.chain_is_simulated(steps: green_too_short)
}
test fn pure_duplication_is_not_simulated() -> Bool {
  !v2.lens.simulated_relationship.chain_is_simulated(steps: green_pure_duplication)
}

fn node_eq(a: v2.std.node.Node, b: v2.std.node.Node) -> Bool {
  v2.std.exact_structural_equality_zip_fold_predicate.exact_structural_equality_zip_fold(source_facts: a, candidate: b)
}
fn fillings_eq(a: std.algebra.FreeMonoid<v2.std.node.Node>, b: std.algebra.FreeMonoid<v2.std.node.Node>) -> Bool {
  v2.std.algebra.zip_eq(a: a, b: b, eq: fn(x, y) { node_eq(a: x, b: y) })
}
fn per_element_eq(
  a: std.algebra.FreeMonoid<std.algebra.FreeMonoid<v2.std.node.Node>>,
  b: std.algebra.FreeMonoid<std.algebra.FreeMonoid<v2.std.node.Node>>
) -> Bool {
  v2.std.algebra.zip_eq(a: a, b: b, eq: fn(x, y) { fillings_eq(a: x, b: y) })
}

fn expected_gate_template() -> v2.std.node.Node {
  conj3(a: atom(id: ^run), b: v2.std.anti_unification.hole_node(), c: v2.std.anti_unification.hole_node())
}
data expected_gate_fillings: List<List<v2.std.node.Node>> = [
  [atom(id: ^gate_rust),  atom(id: ^acc0)],
  [atom(id: ^gate_emit),  atom(id: ^acc1)],
  [atom(id: ^gate_layer), atom(id: ^acc2)]
]

test fn gate_template_is_the_minimal_form() -> Bool {
  node_eq(a: v2.std.anti_unification.anti_unify_chain(steps: red_gate_chain).template, b: expected_gate_template())
}
test fn gate_fillings_are_the_substitution_list() -> Bool {
  per_element_eq(
    a: v2.std.anti_unification.anti_unify_chain(steps: red_gate_chain).per_element,
    b: expected_gate_fillings
  )
}

test fn divergent_op_fillings_are_not_all_leaves() -> Bool {
  !v2.std.anti_unification.fillings_all_leaves(per_element: v2.std.anti_unification.anti_unify_chain(steps: green_divergent_op).per_element)
}
test fn divergent_op_template_still_has_a_hole() -> Bool {
  v2.std.anti_unification.template_has_hole(template: v2.std.anti_unification.anti_unify_chain(steps: green_divergent_op).template)
}
test fn pure_duplication_template_has_no_hole() -> Bool {
  !v2.std.anti_unification.template_has_hole(template: v2.std.anti_unification.anti_unify_chain(steps: green_pure_duplication).template)
}
