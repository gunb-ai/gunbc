module v2.test.claim.ci_spec_witness

import v2.std.algebra { bag_eq, list_snoc_item }
import v2.std.collection { List }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Behavior, Symbol }
import v2.std.node_query { coproduct_arm_keys, coproduct_nullary_inhabitants }
import gunbc.ci_layer_roots { witness_layer_roots, witness_layer_source_flags }
import gunbc.ci_spec {
  CiSpec, DiffPolicy, DiffMergeBase, Gate, RustMonolithGate,
  gunbc_ci_spec, gunbc_ci_gates, gunbc_ci_floor_gates, gunbc_ci_rust_job_gates,
  ci_release_features,
  scheduler_invoke, gunbc_ci_run_script, gunbc_ci_workflow_run, gunbc_ci_floor_only_script, git_fetch_script,
  ci_release_build_script, gunbc_ci_rust_job_run, gunbc_ci_rust_gate_only_script, ci_floor_build_verify_script,
  gunbc_ci_rust_gate_invoke, ci_repo_root_shell,
  ci_documentation_only_diff_note,
}

data golden_floor_build_verify_script: String = "\"$ROOT/target/release/claim_executor\" --verify-build-artifacts \"$ROOT/target/release/claim_executor\" \"$ROOT/target/release/gunbc\"\n"

data reflect_gate_type: Symbol = ^Gate

data spec_alternate_notice: CiSpec = {
  gates: [],
  witness_entries: [],
  diff_policy: {
    base: "upstream/dev",
    head: "HEAD",
    mode: DiffMergeBase
  },
  notice_title: "alt-notice",
  deploy_stages: [],
}

data alternate_witness_layer_roots: List<String> = ["Z9Z9Z9-witness-root"]

fn symbol_eq(a: Symbol, b: Symbol) -> Bool {
  a == b
}

fn gate_arm_symbol(g: Gate) -> Symbol {
  discriminant(v: g)
}

fn gate_arm_symbols(gates: List<Gate>) -> List<Symbol> {
  fold(gates, init: [], f: fn(acc, g) {
    list_snoc_item(xs: acc, item: gate_arm_symbol(g: g))
  })
}

fn nullary_inhabitant_discriminants(inhabitants: List<Behavior>) -> List<Symbol> {
  fold(inhabitants, init: [], f: fn(acc, v) {
    list_snoc_item(xs: acc, item: discriminant(v: v))
  })
}

fn symbol_in(syms: List<Symbol>, s: Symbol) -> Bool {
  fold(syms, init: false, f: fn(acc, x) { acc || (x == s) })
}

fn witness_rust_gate_step_is_gate_only_script() -> Bool {
  gunbc_ci_rust_gate_only_script() == concat(
    concat("ROOT=", ci_repo_root_shell(), "\n"),
    concat(
      concat(git_fetch_script(policy: gunbc_ci_spec.diff_policy), "\n"),
      gunbc_ci_rust_gate_invoke()
    )
  ) && !string_contains(s: gunbc_ci_rust_gate_only_script(), pattern: "cargo\" build -p v1-compiler")
}

fn witness_collapsed_rust_job_is_build_plus_gate() -> Bool {
  gunbc_ci_rust_job_run() == concat(
    concat(ci_release_build_script(), "\n"),
    gunbc_ci_rust_gate_only_script()
  )
}

fn witness_rust_gate_split_is_real() -> Bool {
  let rust = discriminant(v: RustMonolithGate)
  let floor_syms = gate_arm_symbols(gates: gunbc_ci_floor_gates)
  let rustjob_syms = gate_arm_symbols(gates: gunbc_ci_rust_job_gates)
  let spec_syms = gate_arm_symbols(gates: gunbc_ci_spec.gates)
  let rust_job_script = gunbc_ci_rust_job_run()
  !symbol_in(syms: floor_syms, s: rust) &&
    symbol_in(syms: rustjob_syms, s: rust) &&
    bag_eq(xs: spec_syms, ys: floor_syms, eq: symbol_eq) &&
    string_contains(s: rust_job_script, pattern: "dag/tools/rust_gates_ci.dag") &&
    string_contains(s: rust_job_script, pattern: "\"$CARGO_HOME/bin/cargo\" build -p v1-compiler --release")
}

fn witness_gate_roster_matches_coproduct_arms() -> Bool {
  let arm_keys = coproduct_arm_keys(type_name: reflect_gate_type)
  match coproduct_nullary_inhabitants(type_name: reflect_gate_type) {
    Accepted { value: inhabitants, diagnostics: _ } =>
      bag_eq(
        xs: gate_arm_symbols(gates: gunbc_ci_gates),
        ys: arm_keys,
        eq: symbol_eq
      ) && bag_eq(
        xs: nullary_inhabitant_discriminants(inhabitants: inhabitants),
        ys: arm_keys,
        eq: symbol_eq
      )
    Rejected { diagnostics: _ } => false
  }
}

fn witness_roots_fold_into_scheduler() -> Bool {
  let script = scheduler_invoke(spec: gunbc_ci_spec)
  string_contains(s: script, pattern: " --source-root src/v2") &&
    string_contains(s: script, pattern: " --source-root dag")
}

fn witness_layer_authority_drives_source_flags() -> Bool {
  let flags = witness_layer_source_flags(roots: witness_layer_roots)
  (flags != witness_layer_source_flags(roots: alternate_witness_layer_roots)) &&
    string_contains(s: flags, pattern: " --source-root src/v2") &&
    !string_contains(s: flags, pattern: "Z9Z9Z9-witness-root")
}

fn witness_scan_subtree_not_in_scheduler_argv() -> Bool {
  let script = scheduler_invoke(spec: gunbc_ci_spec)
  !string_contains(s: script, pattern: " --scan-dir") &&
    string_contains(s: script, pattern: " --source-root src/v2")
}

fn witness_diff_policy_drives_fetch() -> Bool {
  let fetch = git_fetch_script(policy: gunbc_ci_spec.diff_policy)
  string_contains(s: fetch, pattern: "git fetch --no-tags origin main") &&
    (git_fetch_script(policy: spec_alternate_notice.diff_policy) != fetch) &&
    string_contains(
      s: git_fetch_script(policy: spec_alternate_notice.diff_policy),
      pattern: "git fetch --no-tags upstream dev"
    )
}

fn witness_notice_title_from_spec() -> Bool {
  string_contains(
    s: scheduler_invoke(spec: gunbc_ci_spec),
    pattern: concat(concat(" --notice-title \"", gunbc_ci_spec.notice_title), "\"")
  ) && string_contains(
    s: scheduler_invoke(spec: spec_alternate_notice),
    pattern: concat(concat(" --notice-title \"", spec_alternate_notice.notice_title), "\"")
  )
}

fn witness_run_script_invokes_scheduler() -> Bool {
  let script = gunbc_ci_run_script(spec: gunbc_ci_spec)
  string_contains(s: script, pattern: git_fetch_script(policy: gunbc_ci_spec.diff_policy)) &&
    string_contains(s: script, pattern: scheduler_invoke(spec: gunbc_ci_spec)) &&
    string_contains(s: script, pattern: "--plan-function gunbc_ci_floor_batches") &&
    !string_contains(s: script, pattern: "--bin claim_batch") &&
    !string_contains(s: script, pattern: "cargo run -p v1-compiler --release --bin claim_executor")
}

fn witness_release_build_unifies_features() -> Bool {
  string_contains(
    s: ci_release_build_script(),
    pattern: concat("--features ", ci_release_features)
  )
}

fn witness_release_build_eagain_cold_retry() -> Bool {
  let script = ci_release_build_script()
  string_contains(s: script, pattern: "Resource temporarily unavailable|failed to spawn") &&
    string_contains(s: script, pattern: "CARGO_BUILD_JOBS=1") &&
    string_contains(s: script, pattern: "keep sccache") &&
    string_contains(s: script, pattern: "without RUSTC_WRAPPER") &&
    string_contains(s: script, pattern: "env -u RUSTC_WRAPPER") &&
    string_contains(s: script, pattern: "sccache --show-stats")
}

fn witness_release_build_eagain_tiers_wrap_build_command() -> Bool {
  let script = ci_release_build_script()
  let build_cmd = ci_release_build_line()
  string_contains(s: script, pattern: concat("if ! (", concat(build_cmd, ") 2>&1")))
    && string_contains(s: script, pattern: concat("CARGO_BUILD_JOBS=1 ", concat(build_cmd, " ) 2>&1")))
    && string_contains(s: script, pattern: concat("env -u RUSTC_WRAPPER CARGO_BUILD_JOBS=1 ", concat(build_cmd, " || exit 1")))
}

fn witness_release_build_verifies_nonempty_artifacts() -> Bool {
  let script = ci_release_build_script()
  string_contains(s: script, pattern: "--verify-build-artifacts") &&
    string_contains(s: script, pattern: "$ROOT/target/release/gunbc") &&
    !string_contains(s: script, pattern: "-newer")
}

fn witness_floor_build_verify_script_byte_identical() -> Bool {
  ci_floor_build_verify_script() == golden_floor_build_verify_script
}

fn witness_scheduler_uses_release_binary() -> Bool {
  string_contains(
    s: scheduler_invoke(spec: gunbc_ci_spec),
    pattern: "$ROOT/target/release/claim_executor"
  ) &&
    !string_contains(s: scheduler_invoke(spec: gunbc_ci_spec), pattern: "cargo run")
}

fn witness_workflow_run_is_floor_only_script() -> Bool {
  gunbc_ci_workflow_run(spec: gunbc_ci_spec) == gunbc_ci_floor_only_script(spec: gunbc_ci_spec)
}

fn witness_documentation_only_shortcut_in_floor_script() -> Bool {
  let script = gunbc_ci_floor_only_script(spec: gunbc_ci_spec)
  string_contains(s: script, pattern: "documentation-only diff") &&
    string_contains(s: script, pattern: "[[ \"$_ci_path\" == docs/* ]]") &&
    string_contains(s: script, pattern: ci_documentation_only_diff_note)
}

fn witness_collapsed_run_script_is_build_plus_floor() -> Bool {
  gunbc_ci_run_script(spec: gunbc_ci_spec) == concat(
    concat(ci_release_build_script(), "\n"),
    gunbc_ci_floor_only_script(spec: gunbc_ci_spec)
  )
}

test fn ci_spec_witnesses() -> Bool {
  witness_roots_fold_into_scheduler() &&
    witness_layer_authority_drives_source_flags() &&
    witness_scan_subtree_not_in_scheduler_argv() &&
    witness_diff_policy_drives_fetch() &&
    witness_notice_title_from_spec() &&
    witness_run_script_invokes_scheduler() &&
    witness_release_build_unifies_features() &&
    witness_release_build_eagain_cold_retry() &&
    witness_release_build_eagain_tiers_wrap_build_command() &&
    witness_release_build_verifies_nonempty_artifacts() &&
    witness_floor_build_verify_script_byte_identical() &&
    witness_scheduler_uses_release_binary() &&
    witness_workflow_run_is_floor_only_script() &&
    witness_documentation_only_shortcut_in_floor_script() &&
    witness_collapsed_run_script_is_build_plus_floor() &&
    witness_rust_gate_step_is_gate_only_script() &&
    witness_collapsed_rust_job_is_build_plus_gate() &&
    witness_gate_roster_matches_coproduct_arms() &&
    witness_rust_gate_split_is_real()
}
