import gunbc.ci_gate { Gate }
import gunbc.ci_spec {
  CiSpec, DiffPolicy, DiffMergeBase,
  gunbc_ci_spec, gunbc_ci_gates, gunbc_ci_floor_gates,
  gunbc_ci_regen_floor_gates, gunbc_ci_falsifier_gates,
  ci_release_features,
  scheduler_invoke, gunbc_ci_workflow_run, gunbc_ci_floor_only_script, git_fetch_script,
  ci_floor_build_verify_script,
  ci_documentation_only_floor_shortcut_retired_note,
}
import v2.workflow.ci_release_build_emit { gunbc_ci_run_script, ci_release_build_script }
import gunbc.repo_identity {
  gunbc_merge_target_ref,
  gunbc_default_remote_name,
  gunbc_default_branch_name,
}
import extdeps.git { GitRemoteRefParts, git_remote_ref }
import gunbc.ci_materialization {
  ci_floor_resolve_receipt_gate_script,
  ci_floor_materialization_receipt_gate_script,
}
import gunbc.ci_workflow { ci_selection_control_script }
import gunbc.merge_admission_produce {
  ci_floor_disposition_marker_path,
  ci_floor_disposition_marker_init_note,
  ci_floor_disposition_marker_init_shell_emit_dissolution_trigger,
  merge_admission_floor_disposition_documentation_only_skipped,
  merge_admission_floor_disposition_floor_running,
  merge_admission_stamp_invoke,
  merge_admission_merge_base_ref,
  ci_documentation_only_gate_skip_prefix_shell_emit_dissolution_trigger,
  ci_merge_admission_gate_script,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data golden_floor_build_verify_script: String = "\"$ROOT/target/release/claim_executor\" --verify-build-artifacts \"$ROOT/target/release/claim_executor\" \"$ROOT/target/release/gunbc\" \"$ROOT/target/release/compile_clean_floor_skip_witness\" \"$ROOT/target/release/regen_floor_skip_witness\" \"$ROOT/target/release/floor_skip_discovery_witness\" \"$ROOT/target/release/discover_source_root_ingest\" \"$ROOT/target/release/claim_batch\" \"$ROOT/target/release/regen_stage0\" \"$ROOT/target/release/interp_recorded_fixture_witness\" \"$ROOT/target/release/v1_src_dag_parse\" \"$ROOT/target/release/auth_declared_but_unwired_witness\" \"$ROOT/target/release/bootstrap_witness\" \"$ROOT/target/release/dag_collect_fingerprint_witness\" \"$ROOT/target/release/diagnostics_witness\" \"$ROOT/target/release/effects_rest_transport_witness\" \"$ROOT/target/release/infer_semantics_witness\" \"$ROOT/target/release/parse_witness\" \"$ROOT/target/release/resolution_divergence_census\"\n"

data reflect_gate_type: Symbol = ^Gate

data spec_alternate_notice: CiSpec = {
  gates: [],
  witness_entries: [],
  discovery_scan_dirs: [],
  diff_policy: {
    base: "upstream/dev",
    head: "HEAD",
    mode: DiffMergeBase
  },
  notice_title: "alt-notice",
  deploy_stages: [],
}

data alternate_witness_layer_roots: List<String> = ["Z9Z9Z9-witness-root"]

fn symbol_eq(a: Symbol, b: Symbol) -> Bool {
  a == b
}

fn gate_arm_symbol(g: Gate) -> Symbol {
  discriminant(v: g)
}

fn gate_arm_symbols(gates: List<Gate>) -> List<Symbol> {
  fold(gates, init: [], f: fn(acc, g) {
    list_snoc_item(xs: acc, item: gate_arm_symbol(g: g))
  })
}

fn nullary_inhabitant_discriminants(inhabitants: List<Behavior>) -> List<Symbol> {
  fold(inhabitants, init: [], f: fn(acc, v) {
    list_snoc_item(xs: acc, item: discriminant(v: v))
  })
}

fn symbol_in(syms: List<Symbol>, s: Symbol) -> Bool {
  fold(syms, init: false, f: fn(acc, x) { acc || (x == s) })
}

test fn witness_gate_roster_matches_coproduct_arms() -> Bool {
  let arm_keys = coproduct_arm_keys(type_name: reflect_gate_type)
  match coproduct_nullary_inhabitants(type_name: reflect_gate_type) {
    Accepted { value: inhabitants, diagnostics: _ } =>
      bag_eq(
        xs: gate_arm_symbols(gates: concat(concat(gunbc_ci_gates, gunbc_ci_regen_floor_gates), gunbc_ci_falsifier_gates)),
        ys: arm_keys,
        eq: symbol_eq
      ) && bag_eq(
        xs: nullary_inhabitant_discriminants(inhabitants: inhabitants),
        ys: arm_keys,
        eq: symbol_eq
      )
    Rejected { diagnostics: _ } => false
  }
}

test fn witness_roots_fold_into_scheduler() -> Bool {
  let script = scheduler_invoke(spec: gunbc_ci_spec)
  string_contains(s: script, pattern: " --source-root \"$ROOT/src/v2\"") &&
    string_contains(s: script, pattern: " --source-root \"$ROOT/dag\"")
}

test fn witness_layer_authority_drives_source_flags() -> Bool {
  let flags = witness_layer_source_flags(roots: witness_layer_roots)
  (flags != witness_layer_source_flags(roots: alternate_witness_layer_roots)) &&
    string_contains(s: flags, pattern: " --source-root src/v2") &&
    !string_contains(s: flags, pattern: "Z9Z9Z9-witness-root")
}

test fn witness_scan_subtree_not_in_scheduler_argv() -> Bool {
  let script = scheduler_invoke(spec: gunbc_ci_spec)
  !string_contains(s: script, pattern: " --scan-dir") &&
    string_contains(s: script, pattern: " --source-root \"$ROOT/src/v2\"")
}

test fn witness_diff_policy_drives_fetch() -> Bool {
  let fetch = git_fetch_script(policy: gunbc_ci_spec.diff_policy)
  string_contains(s: fetch, pattern: "git fetch --no-tags origin main") &&
    (git_fetch_script(policy: spec_alternate_notice.diff_policy) != fetch) &&
    string_contains(
      s: git_fetch_script(policy: spec_alternate_notice.diff_policy),
      pattern: "git fetch --no-tags upstream dev"
    )
}

test fn witness_notice_title_from_spec() -> Bool {
  string_contains(
    s: scheduler_invoke(spec: gunbc_ci_spec),
    pattern: concat(concat(" --notice-title \"", gunbc_ci_spec.notice_title), "\"")
  ) && string_contains(
    s: scheduler_invoke(spec: spec_alternate_notice),
    pattern: concat(concat(" --notice-title \"", spec_alternate_notice.notice_title), "\"")
  )
}

test fn witness_run_script_invokes_scheduler() -> Bool {
  let script = gunbc_ci_run_script(spec: gunbc_ci_spec)
  let floor_script = gunbc_ci_floor_only_script(spec: gunbc_ci_spec)
  string_contains(s: script, pattern: git_fetch_script(policy: gunbc_ci_spec.diff_policy)) &&
    string_contains(s: script, pattern: scheduler_invoke(spec: gunbc_ci_spec)) &&
    string_contains(s: script, pattern: "--plan-function gunbc_ci_floor_batches") &&
    !string_contains(s: floor_script, pattern: "--bin claim_batch") &&
    !string_contains(s: floor_script, pattern: "cargo build") &&
    !string_contains(s: script, pattern: "cargo run -p v1-compiler --release --bin claim_executor")
}

test fn witness_release_build_unifies_features() -> Bool {
  string_contains(
    s: ci_release_build_script(),
    pattern: concat("--features ", ci_release_features)
  )
}

test fn witness_release_build_eagain_cold_retry() -> Bool {
  let script = ci_release_build_script()
  string_contains(s: script, pattern: "Resource temporarily unavailable|failed to spawn") &&
    string_contains(s: script, pattern: "CARGO_BUILD_JOBS=1") &&
    string_contains(s: script, pattern: "keep sccache") &&
    !string_contains(s: script, pattern: "without RUSTC_WRAPPER") &&
    !string_contains(s: script, pattern: "env -u RUSTC_WRAPPER") &&
    string_contains(s: script, pattern: "sccache --show-stats")
}

test fn witness_release_build_eagain_tiers_wrap_build_command() -> Bool {
  let script = ci_release_build_script()
  let build_cmd = ci_release_build_line()
  string_contains(s: script, pattern: concat("if ! (", concat(build_cmd, ") 2>&1")))
    && string_contains(s: script, pattern: concat("CARGO_BUILD_JOBS=1 ", build_cmd))
    && !string_contains(s: script, pattern: "env -u RUSTC_WRAPPER")
}

test fn witness_release_build_verifies_nonempty_artifacts() -> Bool {
  let script = ci_release_build_script()
  string_contains(s: script, pattern: "--verify-build-artifacts") &&
    string_contains(s: script, pattern: "$ROOT/target/release/gunbc") &&
    !string_contains(s: script, pattern: "-newer")
}

test fn witness_floor_build_verify_script_byte_identical() -> Bool {
  ci_floor_build_verify_script() == golden_floor_build_verify_script
}

test fn witness_scheduler_uses_release_binary() -> Bool {
  string_contains(
    s: scheduler_invoke(spec: gunbc_ci_spec),
    pattern: "$ROOT/target/release/claim_executor"
  ) &&
    !string_contains(s: scheduler_invoke(spec: gunbc_ci_spec), pattern: "cargo run")
}

test fn witness_workflow_run_is_floor_only_script() -> Bool {
  gunbc_ci_workflow_run(spec: gunbc_ci_spec) == gunbc_ci_floor_only_script(spec: gunbc_ci_spec)
}

test fn witness_documentation_only_floor_shortcut_retired() -> Bool {
  let script = gunbc_ci_floor_only_script(spec: gunbc_ci_spec)
  string_contains(s: script, pattern: ci_documentation_only_floor_shortcut_retired_note) &&
    string_contains(s: script, pattern: "gunbc#7023") &&
    !string_contains(s: script, pattern: "_ci_floor_skip=$(\"") &&
    !string_contains(s: script, pattern: "if [ \"$_ci_floor_skip\" = \"documentation_only_skip\" ]; then") &&
    !string_contains(s: script, pattern: "floor skipped (CI_FLOOR_DISPOSITION=") &&
    !string_contains(s: script, pattern: "CI_FLOOR_DISPOSITION=documentation_only_skipped") &&
    string_contains(s: script, pattern: "--plan-function gunbc_ci_floor_batches")
}

test fn witness_merge_base_ref_single_authority() -> Bool {
  merge_admission_merge_base_ref == gunbc_ci_spec.diff_policy.base
    && merge_admission_merge_base_ref == (gunbc_merge_target_ref as String)
    && (gunbc_merge_target_ref as String) == "origin/main"
}

test fn witness_repo_identity_single_authority_perturbation() -> Bool {
  let real = git_remote_ref(
    parts: GitRemoteRefParts { remote: gunbc_default_remote_name, ref_name: gunbc_default_branch_name }
  )
  let perturbed = git_remote_ref(
    parts: GitRemoteRefParts { remote: gunbc_default_remote_name, ref_name: "develop" }
  )
  (real as String) == (gunbc_merge_target_ref as String)
    && (real as String) != (perturbed as String)
    && (perturbed as String) == "origin/develop"
}

test fn witness_documentation_only_gate_skip_prefix_dissolve_on_named() -> Bool {
  string_contains(
    s: ci_documentation_only_gate_skip_prefix_shell_emit_dissolution_trigger,
    pattern: "dissolve-on: ci_documentation_only_gate_skip_prefix"
  )
}

test fn witness_documentation_only_gate_skip_emits_dissolve_on_in_runners() -> Bool {
  let marker = concat("# ", ci_documentation_only_gate_skip_prefix_shell_emit_dissolution_trigger)
  string_contains(s: ci_floor_resolve_receipt_gate_script(), pattern: marker)
    && string_contains(s: ci_floor_materialization_receipt_gate_script(), pattern: marker)
    && string_contains(s: ci_selection_control_script(), pattern: marker)
    && string_contains(s: ci_merge_admission_gate_script(), pattern: marker)
}

test fn witness_floor_disposition_marker_init_dissolve_on_named() -> Bool {
  string_contains(
    s: ci_floor_disposition_marker_init_shell_emit_dissolution_trigger,
    pattern: "dissolve-on: ci_floor_disposition_marker_init_script"
  )
}

test fn witness_floor_disposition_marker_init_emits_dissolve_on_in_floor_runner() -> Bool {
  let marker = concat("# ", ci_floor_disposition_marker_init_shell_emit_dissolution_trigger)
  string_contains(s: gunbc_ci_floor_only_script(spec: gunbc_ci_spec), pattern: marker)
}

test fn witness_floor_disposition_marker_initialized_at_floor_start() -> Bool {
  let script = gunbc_ci_floor_only_script(spec: gunbc_ci_spec)
  let stamp = concat(
    concat("echo ", merge_admission_floor_disposition_floor_running),
    concat(" > ", ci_floor_disposition_marker_path)
  )
  string_contains(s: script, pattern: ci_floor_disposition_marker_init_note) &&
    string_contains(s: script, pattern: stamp)
}

test fn witness_collapsed_run_script_is_build_plus_floor() -> Bool {
  gunbc_ci_run_script(spec: gunbc_ci_spec) == concat(
    concat(ci_release_build_script(), "\n"),
    gunbc_ci_floor_only_script(spec: gunbc_ci_spec)
  )
}

