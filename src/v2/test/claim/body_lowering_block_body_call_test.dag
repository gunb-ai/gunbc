module v2.test.claim.body_lowering_block_body_call

import v2.compiler.normalize { normalize }
import v2.compiler.parse { parse_module_prepared }
import v2.compiler.program_assembly { dag_prepared_grammar }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_lex }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.grammar { node_atom_identity_optional }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.node_query {
  call_callee_target,
  find_arrow_body_child,
  find_named_child,
  node_is_call
}
import v2.std.optional { Absent, Present }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data body_lowering_block_call_source: String = "module wall.same\n\nfn rollup() -> Bool {\n  leaf()\n}\n"

test fn body_lowering_block_body_call_reaches_arrow_body() -> Bool {
  match dag_prepared_grammar() {
    Rejected { diagnostics: _ } => false
    Accepted { value: prepared, diagnostics: residue } =>
      match tokenize(
        text: body_lowering_block_call_source,
        file: ^body_lowering_block_call_file,
        rules: dag_lex()
      ) {
        Rejected { diagnostics: _ } => false
        Accepted { value: token_stream, diagnostics: _ } =>
          match parse_module_prepared(
            tokens: token_stream,
            prepared: prepared,
            validation_residue: residue
          ) {
            Rejected { diagnostics: _ } => false
            Accepted { value: artifact, diagnostics: _ } =>
              match normalize(parse_tree: artifact.tree) {
                Rejected { diagnostics: _ } => false
                Accepted { value: tree, diagnostics: _ } =>
                  match find_named_child(root: tree.root, name: ^grammar_production_captured_node_projection) {
                    Rejected { diagnostics: _ } => false
                    Accepted { value: captured, diagnostics: _ } =>
                      match find_named_child(root: captured, name: ^wall) {
                        Rejected { diagnostics: _ } => false
                        Accepted { value: wall_n, diagnostics: _ } =>
                          match find_named_child(root: wall_n, name: ^same) {
                            Rejected { diagnostics: _ } => false
                            Accepted { value: members, diagnostics: _ } =>
                              match find_named_child(root: members, name: ^rollup) {
                                Rejected { diagnostics: _ } => false
                                Accepted { value: rollup_member, diagnostics: _ } =>
                                  match find_arrow_body_child(root: rollup_member) {
                                    Rejected { diagnostics: _ } => false
                                    Accepted { value: body, diagnostics: _ } =>
                                      if node_is_call(node: body) {
                                        match call_callee_target(node: body) {
                                          Rejected { diagnostics: _ } => false
                                          Accepted { value: callee, diagnostics: _ } =>
                                            match node_atom_identity_optional(node: callee) {
                                              Present { value: id } => id == ^leaf
                                              Absent => false
                                            }
                                        }
                                      } else {
                                        false
                                      }
                                  }
                              }
                          }
                      }
                  }
              }
          }
      }
  }
}
