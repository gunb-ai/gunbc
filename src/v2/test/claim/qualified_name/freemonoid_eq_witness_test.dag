module v2.test.claim.qualified_name.freemonoid_eq_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

type QnPath = FreeMonoid<v2.std.node.Symbol>

fn ab() -> QnPath {
  std.algebra.Cons { head: ^a, tail: std.algebra.Cons { head: ^b, tail: std.algebra.Empty } }
}

fn ab2() -> QnPath {
  std.algebra.Cons { head: ^a, tail: std.algebra.Cons { head: ^b, tail: std.algebra.Empty } }
}

fn ac() -> QnPath {
  std.algebra.Cons { head: ^a, tail: std.algebra.Cons { head: ^c, tail: std.algebra.Empty } }
}

fn a_only() -> QnPath {
  std.algebra.Cons { head: ^a, tail: std.algebra.Empty }
}

fn empty_path() -> QnPath {
  std.algebra.Empty
}

test fn freemonoid_structural_eq_matches_qn_eq() -> Bool {
  ab() == ab2()
    && !(ab() == ac())
    && !(ab() == a_only())
    && !(a_only() == empty_path())
    && empty_path() == empty_path()
    && !(ab() == empty_path())
}
