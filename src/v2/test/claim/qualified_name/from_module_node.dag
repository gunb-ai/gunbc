module v2.test.qualified_name.from_module_node


fn fmn_sym_node(sym: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: sym } }, children: [],
 occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn fmn_bool_atom(b: Bool) -> v2.std.node.Node {
  match b {
    true => v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^fmn_bool_true_sym } }, children: [],
 occurrence_id: v2.std.node.SyntheticOccurrence
}
    false => v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^fmn_bool_false_sym } }, children: [],
 occurrence_id: v2.std.node.SyntheticOccurrence
}
  }
}

fn fmn_outcome_accepted(out: v2.std.diagnostic.Outcome<v2.std.qualified_name.QualifiedName>) -> Bool {
  match out {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn fmn_value_eq(out: v2.std.diagnostic.Outcome<v2.std.qualified_name.QualifiedName>, expected: v2.std.qualified_name.QualifiedName) -> Bool {
  match out {
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
    v2.std.diagnostic.Accepted { value: actual, diagnostics: _ } => actual == expected
  }
}

data fmn_qn_node: v2.std.node.Node = v2.std.algebra.fold_list_node(
  xs: std.algebra.Cons { head: ^fmn_sym_a, tail: std.algebra.Cons { head: ^fmn_sym_b, tail: std.algebra.Empty } },
  item_node: fn(sym) { fmn_sym_node(sym: sym) }
)

data fmn_module_header_node: v2.std.node.Node = v2.extdeps.languages.dag.emit_module_header_emitted_node(qualified_name: fmn_qn_node)

data fmn_bare_conj_node: v2.std.node.Node = v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Conj }, children: [],
 occurrence_id: v2.std.node.SyntheticOccurrence
}

data fmn_qn_empty_node: v2.std.node.Node = v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Conj }, children: [],
 occurrence_id: v2.std.node.SyntheticOccurrence
}
data fmn_module_header_empty_qn_node: v2.std.node.Node = v2.extdeps.languages.dag.emit_module_header_emitted_node(qualified_name: fmn_qn_empty_node)

data fmn_qn_gated_node: v2.std.node.Node = v2.std.algebra.fold_list_node(
  xs: std.algebra.Cons { head: ^dag_token_ident, tail: std.algebra.Empty },
  item_node: fn(sym) { fmn_sym_node(sym: sym) }
)

data fmn_module_header_gated_node: v2.std.node.Node = v2.extdeps.languages.dag.emit_module_header_emitted_node(qualified_name: fmn_qn_gated_node)

data claim_from_module_node_accepted: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "qualified_name_from_module_node returns Accepted with [^fmn_sym_a, ^fmn_sym_b] for a well-formed module header emitted node",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
  lhs: fmn_bool_atom(b: fmn_value_eq(
    out: v2.extdeps.languages.dag.qualified_name_from_module_node(root: fmn_module_header_node),
    expected: std.algebra.Cons { head: ^fmn_sym_a, tail: std.algebra.Cons { head: ^fmn_sym_b, tail: std.algebra.Empty } }
  )),
  rhs: fmn_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit }
}

data claim_from_module_node_missing_edge_rejected: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "qualified_name_from_module_node returns Rejected when dag_surface_module_header_qualified_name edge is absent",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
  lhs: fmn_bool_atom(b: fmn_outcome_accepted(out: v2.extdeps.languages.dag.qualified_name_from_module_node(root: fmn_bare_conj_node))),
  rhs: fmn_bool_atom(b: false),
  classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit }
}

data claim_from_module_node_empty_qn_rejected: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "qualified_name_from_module_node returns Rejected for a module header whose QN edge is an empty fold_list_node (vacuous for_all must not accept)",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
  lhs: fmn_bool_atom(b: fmn_outcome_accepted(out: v2.extdeps.languages.dag.qualified_name_from_module_node(root: fmn_module_header_empty_qn_node))),
  rhs: fmn_bool_atom(b: false),
  classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit }
}

data claim_from_module_node_t8_gated: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "qualified_name_from_module_node returns Rejected when QN segment is dag_token_ident (T-8 gate)",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
  lhs: fmn_bool_atom(b: fmn_outcome_accepted(out: v2.extdeps.languages.dag.qualified_name_from_module_node(root: fmn_module_header_gated_node))),
  rhs: fmn_bool_atom(b: false),
  classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit }
}
