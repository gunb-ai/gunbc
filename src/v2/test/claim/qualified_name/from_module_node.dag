module v2.test.qualified_name.from_module_node

import v2.extdeps.languages.dag {
  emit_module_header_emitted_node,
  qualified_name_from_module_node
}
import std.algebra { Cons, Empty }
import v2.std.algebra { fold_list_node }
import v2.std.diagnostic { Accepted, Outcome, Rejected }
import v2.std.node { Atom, Conj, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.qualified_name { QualifiedName }
import v2.std.logic { Bool }
import v2.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}
fn fmn_sym_node(sym: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: sym } }, children: [],
 occurrence_id: SyntheticOccurrence
}
}

fn fmn_bool_atom(b: Bool) -> Node {
  match b {
    true => Node { kind: TypeNode { connective: Atom { identity: ^fmn_bool_true_sym } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => Node { kind: TypeNode { connective: Atom { identity: ^fmn_bool_false_sym } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

fn fmn_outcome_accepted(out: Outcome<QualifiedName>) -> Bool {
  match out {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn fmn_value_eq(out: Outcome<QualifiedName>, expected: QualifiedName) -> Bool {
  match out {
    Rejected { diagnostics: _ } => false
    Accepted { value: actual, diagnostics: _ } => actual == expected
  }
}

data fmn_qn_node: Node = fold_list_node(
  xs: Cons { head: ^fmn_sym_a, tail: Cons { head: ^fmn_sym_b, tail: Empty } },
  item_node: fn(sym) { fmn_sym_node(sym: sym) }
)

data fmn_module_header_node: Node = emit_module_header_emitted_node(qualified_name: fmn_qn_node)

data fmn_bare_conj_node: Node = Node { kind: TypeNode { connective: Conj }, children: [],
 occurrence_id: SyntheticOccurrence
}

data fmn_qn_empty_node: Node = Node { kind: TypeNode { connective: Conj }, children: [],
 occurrence_id: SyntheticOccurrence
}
data fmn_module_header_empty_qn_node: Node = emit_module_header_emitted_node(qualified_name: fmn_qn_empty_node)

data fmn_qn_gated_node: Node = fold_list_node(
  xs: Cons { head: ^dag_token_ident, tail: Empty },
  item_node: fn(sym) { fmn_sym_node(sym: sym) }
)

data fmn_module_header_gated_node: Node = emit_module_header_emitted_node(qualified_name: fmn_qn_gated_node)

data claim_from_module_node_accepted: TestClaim = EqualsClaim {
  label: "qualified_name_from_module_node returns Accepted with [^fmn_sym_a, ^fmn_sym_b] for a well-formed module header emitted node",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: fmn_bool_atom(b: fmn_value_eq(
    out: qualified_name_from_module_node(root: fmn_module_header_node),
    expected: Cons { head: ^fmn_sym_a, tail: Cons { head: ^fmn_sym_b, tail: Empty } }
  )),
  rhs: fmn_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_from_module_node_missing_edge_rejected: TestClaim = EqualsClaim {
  label: "qualified_name_from_module_node returns Rejected when dag_surface_module_header_qualified_name edge is absent",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: fmn_bool_atom(b: fmn_outcome_accepted(out: qualified_name_from_module_node(root: fmn_bare_conj_node))),
  rhs: fmn_bool_atom(b: false),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_from_module_node_empty_qn_rejected: TestClaim = EqualsClaim {
  label: "qualified_name_from_module_node returns Rejected for a module header whose QN edge is an empty fold_list_node (vacuous for_all must not accept)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: fmn_bool_atom(b: fmn_outcome_accepted(out: qualified_name_from_module_node(root: fmn_module_header_empty_qn_node))),
  rhs: fmn_bool_atom(b: false),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_from_module_node_t8_gated: TestClaim = EqualsClaim {
  label: "qualified_name_from_module_node returns Rejected when QN segment is dag_token_ident (T-8 gate)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: fmn_bool_atom(b: fmn_outcome_accepted(out: qualified_name_from_module_node(root: fmn_module_header_gated_node))),
  rhs: fmn_bool_atom(b: false),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
