module v2.test.claim.qualified_name.from_dotted_string


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

test fn qualified_name_from_dotted_string_empty_holds() -> Bool {
  qualified_name_from_dotted_string(dotted: "") == std.algebra.Empty
}

test fn qualified_name_from_dotted_string_singleton_holds() -> Bool {
  qualified_name_from_dotted_string(dotted: "std") == std.algebra.Cons { head: ^std, tail: std.algebra.Empty }
}

test fn qualified_name_from_dotted_string_multi_segment_holds() -> Bool {
  qualified_name_from_dotted_string(dotted: "v2.std.text") == std.algebra.Cons {
    head: ^v2,
    tail: std.algebra.Cons { head: ^std, tail: std.algebra.Cons { head: ^text, tail: std.algebra.Empty } }
  }
}

test fn qualified_name_from_dotted_string_layer_prefix_holds() -> Bool {
  layer_prefix_from_dotted_qualified_name(qn: "v2.std") == LayerPrefixStd
}
