module v2.test.claim.ambiguous_leaf_value_ref_compile

import std.types { String, Bool, Int, List }
import gunbc.instruments.multi_module_compile_fixture {
  MultiModuleCompileFixture,
  MultiModuleCompileFixtureOutcome,
  FixtureInstrumentRefused,
  FixtureCompileRefused,
  FixtureCompileCompleted,
  FixtureSource,
  fixture_source,
  compile_fixture,
  fixture_has_class,
  fixture_blocking_rows
}

// THE DISCRIMINATING RED FOR THE AMBIGUOUS-LEAF-AT-RESOLUTION RUNG. The recurring failure mode
// dag/gunbc/recurring_failure_mode/bare_name_resolved_by_proximity_standing_in_for_resolution records
// that a value-reference to a leaf whose spelling two modules declare used to be bound only at
// emission, where the emitter rendered it a diverging `panic!(...)`: the crate COMPILED, resolution
// reported zero blocking errors, and the refusal either never ran or surfaced as rustc's misleading
// "unreachable expression" on the NEXT field. The operator ruling 2026-11-09 ("yes please, lets fix
// that") moved that refusal to the earliest boundary that knows the fact -- the resolution pass that
// builds `item_leaf_owner_modules` from the complete item registry (DESIGN.md
// gunbc.design_argument::earliest_unjustified_boundary, gunbc.design_argument::fail_closed) -- and
// deleted the emitted `panic!` branch rather than keeping it as a fallback
// (gunbc.design_argument::replacement_migration).
//
// WHY AN ISOLATED MULTI-MODULE FIXTURE, NOT AN IN-CORPUS PAIR. The subject is a leaf held by two
// modules at once, and the corpus is not a controlled setting for that: under whole-corpus floor
// preparation every witness folds through one prepared subject, so a third module could supply the
// spelling and neither the red nor the green would be attributable. Every byte compiled here is
// authored below, so only this file can add, rename or remove `shared_leaf` in that compile. This is
// the same construction v2.test.claim.local_binding_shadow_compile uses for its shadowed name.
//
// THE POPULATION THIS REFUSES IS EXACTLY THE EMITTER'S OLD PANIC SET, not a wider net: a BARE
// (unqualified) reference, not a local, not a match binder, not a variant, not the importing module's
// OWN declaration, to a leaf the registry's owner index says two-plus modules declare. The positive
// control below holds the leaf at the SAME two owners and only changes the reference to name the owner
// -- the fix shape #16155 applied in the corpus -- so the refusal is a property of the BARE SPELLING,
// never of the leaf being shared.

data peer_a_source: String = "module ambx.peer_a\ndata shared_leaf: Int = 1\nfn peer_a_probe() -> Int { shared_leaf }\n"

data peer_b_source: String = "module ambx.peer_b\ndata shared_leaf: Int = 2\nfn peer_b_probe() -> Int { shared_leaf }\n"

// RED. The entry pulls both peers into the closure (so two modules declare `shared_leaf`), and then
// references `shared_leaf` BARE, without importing it and without declaring it itself. There is no
// single declaration to name: the emitter used to print `panic!(...)` here.
data entry_bare: String = "module ambx.entry\nimport ambx.peer_a { peer_a_probe }\nimport ambx.peer_b { peer_b_probe }\ndata picked: Int = shared_leaf\nfn use_picked() -> Int { picked + peer_a_probe() + peer_b_probe() }\n"

// POSITIVE CONTROL. The identical program, but the reference NAMES the owner -- `ambx.peer_a.shared_leaf`
// -- exactly as #16155 qualified the six production sites. The leaf is still declared by two modules;
// what changed is that this reference states which one. It must compile clean, so the red cannot be
// satisfied by a compiler that refuses every reference to a shared leaf.
data entry_owner_named: String = "module ambx.entry\nimport ambx.peer_a { peer_a_probe }\nimport ambx.peer_b { peer_b_probe }\ndata picked: Int = ambx.peer_a.shared_leaf\nfn use_picked() -> Int { picked + peer_a_probe() + peer_b_probe() }\n"

fn compile_ambiguous_leaf_fixture(entry: String) -> MultiModuleCompileFixtureOutcome {
  compile_fixture(MultiModuleCompileFixture {
    sources: [
      fixture_source("ambx/peer_a.dag", peer_a_source),
      fixture_source("ambx/peer_b.dag", peer_b_source),
      fixture_source("ambx/entry.dag", entry)
    ],
    entry: "ambx/entry.dag"
  })
}

fn compiles_clean(o: MultiModuleCompileFixtureOutcome) -> Bool {
  match o {
    FixtureCompileCompleted { module_count: _, emitted_files: _, resolved_rust_functions: _, diagnostics: rows, source_digest: _, compiler_digest: _ } => count(fixture_blocking_rows(rows)) == 0,
    FixtureCompileRefused { module_count: _, diagnostics: _, source_digest: _, compiler_digest: _ } => false,
    FixtureInstrumentRefused { cause: _ } => false
  }
}

fn refuses_with_class(o: MultiModuleCompileFixtureOutcome, wanted: String) -> Bool {
  match o {
    FixtureCompileRefused { module_count: _, diagnostics: rows, source_digest: _, compiler_digest: _ } => fixture_has_class(rows, wanted),
    FixtureCompileCompleted { module_count: _, emitted_files: _, resolved_rust_functions: _, diagnostics: _, source_digest: _, compiler_digest: _ } => false,
    FixtureInstrumentRefused { cause: _ } => false
  }
}

// THE RED, WITH ITS POSITIVE CONTROL. The bare reference is refused at COMPILE time with the located
// `AmbiguousReference` class -- the same blocking diagnostic the compiler already mints for an
// ambiguous on-chain reference -- and the FIRST conjunct is not satisfied by a compiler that refuses
// everything, because the second conjunct compiles the same shared leaf clean once the reference names
// its owner. Removing `ambiguous_leaf_value_ref_diagnostics` flips the first conjunct red (the bare
// reference would then compile and the emitter would print a `panic!`), which is what makes this a
// discriminating red rather than a compiler-wide refusal detector.
test fn the_bare_ambiguous_leaf_is_refused_at_compile_time_and_the_owner_named_form_compiles() -> Bool {
  refuses_with_class(compile_ambiguous_leaf_fixture(entry_bare), "AmbiguousReference")
    && compiles_clean(compile_ambiguous_leaf_fixture(entry_owner_named))
}
