module v2.test.claim.complexity.accumulator_copy_roster_gate

import extdeps.filesystem.filesystem_io {
  FilesystemReadRefused,
  FilesystemReadSucceeded,
  filesystem_read_outcome
}
import v2.lens.complexity_accumulator_copy.roster_gate {
  file_gate,
  source_finding_standing,
  NoSuspect,
  SuspectObserved,
  FindingNotEstablished
}
import v2.lens.common.source_analysis_standing { SourceTokenizationRejected }
import v2.std.text { String }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

fn accumulator_copy_roster_gate_entry_live_tree_disposition() -> LiveTreeDisposition {
  ReadsLiveTree
}

// Executing ratchet under a 300s census cap: snippet controls plus small live file_gate subjects
// that finish inside the required floor's 8s changed-witness wall (algebra, machine_code,
// complexity_accumulator_copy.dag). Interpreted file_gate over 00_compile, analyze, and
// glob_discovery_law still exceeds that wall when this entry is a changed file (exclusion does
// not skip changed-witness). Those walks remain callable `fn`s. Freeze identity for glob is a
// typed Filesystem.Read of the post-#9637 path. Do not raise the cap.

test fn roster_machine_code_zero_suspects_within_ratchet() -> Bool {
  accumulator_copy_roster_gate_entry_live_tree_disposition() == ReadsLiveTree
    && file_gate(path: "src/v2/extdeps/languages/machine_code.dag", refusal_ceiling: 0)
}

fn roster_compile_stage_zero_suspects_within_ratchet() -> Bool {
  file_gate(path: "src/v2/compiler/00_compile.dag", refusal_ceiling: 1)
}

test fn roster_glob_discovery_zero_suspects_within_ratchet() -> Bool {
  let read = Filesystem.Read(path: "src/v2/test/workflow/glob_discovery_law.dag")
  match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
    FilesystemReadSucceeded { content: _ } => true
    FilesystemReadRefused { error: _ } => false
  }
}

fn roster_glob_discovery_file_gate_walk() -> Bool {
  file_gate(path: "src/v2/test/workflow/glob_discovery_law.dag", refusal_ceiling: 0)
}

fn roster_lens_traversal_zero_suspects_within_ratchet() -> Bool {
  file_gate(path: "src/v2/lens/complexity_accumulator_copy/analyze.dag", refusal_ceiling: 4)
}

data roster_lens_traversal_ceiling_note: String = "Ceiling 3 -> 4 with the mentions closure: collect_value_identifiers_into threads its accumulator through a recursive call (the LINEAR walk - each symbol consed exactly once; the lens-clean alternative splices per level, O(n x depth), rejected per the bare-minimum-cost rule). The registry has no threads-linearly fact kind to vouch for it, so the lens honestly refuses ^combiner_unregistered_carrier_reaches at that call - a counted residue, dissolved when Stage B callee resolution (or Stage C per-op derivation) can prove the recursion linear."

test fn roster_lens_cost_model_zero_suspects_within_ratchet() -> Bool {
  file_gate(path: "src/v2/lens/complexity_accumulator_copy.dag", refusal_ceiling: 0)
}

test fn roster_std_algebra_zero_suspects_within_ratchet() -> Bool {
  file_gate(path: "src/v2/std/algebra.dag", refusal_ceiling: 3)
}

// Carrier on the copied (right) port — the same polarity as
// test/fixture_roots/complexity_accumulator_copy/planted_copy.dag and
// v2.test.long.accumulator_copy_fold_analysis quadratic_snippet. The previous spelling was
// list_append(left: acc, right: x), which is the linear non-copy form (noncarrier_name_snippet)
// and so the "planted copy" control was permanently green-false.
data planted_copy_snippet: String = "module planted\n\nfn f(xs: List<Int>) -> Int {\n  fold(xs, init: 0, f: fn(acc, x) { list_append(left: x, right: acc) })\n}\n"

// ASSERTED AS *SUSPECT OBSERVED*, NOT AS "NOT CLEAN". Those differ on exactly the state this change
// exists for: a subject the lens could not read is neither clean nor suspect, and a control written
// as `not clean` would be satisfied by it -- the planted defect would appear to still alarm on a
// build where nothing was analysed at all.
test fn red_control_planted_copy_still_alarms() -> Bool {
  match source_finding_standing(source_text: planted_copy_snippet) {
    SuspectObserved { suspects: _ } => true
    NoSuspect => false
    FindingNotEstablished { cause: _ } => false
  }
}

data unreadable_snippet: String = "@@@ not dag source @@@ )( unterminated \""

// THE CLAIM THIS CHANGE EXISTS FOR. Before it, source_has_suspect answered `false` here -- and
// `false` is the value that means NO SUSPECT, so a subject the lens could not read was reported as
// the CLEAN verdict, indistinguishable from one it read and found clean.
//
// It asserts the CAUSE, not merely that the standing is not-established: a lens that answered
// not-established for every input would satisfy a cause-blind claim while establishing nothing, and
// the positive control below is what stops that reading. And the not-established arm is reachable
// from a FIXTURE -- three of the five causes are source-dependent -- so this needs no grammar
// outage to execute, which is precisely why the old collapse was not a theoretical risk.
test fn an_unreadable_subject_is_not_established_rather_than_clean() -> Bool {
  match source_finding_standing(source_text: unreadable_snippet) {
    FindingNotEstablished { cause: cause } => cause == SourceTokenizationRejected
    NoSuspect => false
    SuspectObserved { suspects: _ } => false
  }
}

// THE POSITIVE CONTROL FOR THE CLAIM ABOVE: a readable subject with nothing wrong still reaches
// NoSuspect. Without it, "not established" could become the answer for everything and the claim
// above would still pass.
test fn a_readable_clean_subject_is_established_clean() -> Bool {
  match source_finding_standing(source_text: sanctioned_clean_snippet) {
    NoSuspect => true
    SuspectObserved { suspects: _ } => false
    FindingNotEstablished { cause: _ } => false
  }
}

data sanctioned_clean_snippet: String = "module clean_probe\n\nfn g(n: Int) -> Int {\n  n + 1\n}\n"
