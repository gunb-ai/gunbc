module v2.test.claim.complexity.accumulator_copy_unreadable_subject

import v2.lens.common.source_analysis_standing { SourceUnreadable }
import v2.lens.complexity_accumulator_copy.roster_gate {
  GateClean,
  GateNotEstablished,
  GateRefusalBudgetExceeded,
  GateSuspectObserved,
  file_gate_disposition
}
import v2.std.logic { Bool }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE RED CONTROL FOR A DEFECT THAT DID NOT RETURN A WRONG ANSWER -- IT ENDED THE RUN. file_gate's
// subject used to be read by the `filesystem_read` intrinsic, whose result type carries `content`
// and no success channel, so a path that does not exist raised an interpreter type error and took
// the whole process down with it. On a nine-row roster that reads as one red test; on a corpus
// sweep it is an absorbing failure -- every subject after the missing one is never asked.
//
// The receipt is not hypothetical: src/v2/workflow/glob_discovery_law.dag moved to
// src/v2/test/workflow/ in the #9637 directory reorganisation, the roster row naming it was not
// repointed, and because the roster gate is offline nothing executed it. It crashed rather than
// refused for as long as that row stood.
//
// This witness fails on the pre-fix build with a runtime error rather than a false, which is the
// discrimination: it cannot pass by accident, and it cannot pass while the read is untyped.
test fn an_unreadable_subject_is_refused_with_its_cause() -> Bool {
  match file_gate_disposition(
    path: "src/v2/workflow/this_path_is_deliberately_absent.dag",
    refusal_ceiling: 0
  ) {
    GateNotEstablished { cause: cause } => cause == SourceUnreadable
    GateClean => false
    GateSuspectObserved { suspects: _ } => false
    GateRefusalBudgetExceeded { refusals: _, ceiling: _ } => false
  }
}

// THE POSITIVE CONTROL ON THE SAME PATH. Without it, a read that refused every subject would
// satisfy the claim above while establishing nothing -- the arm would be permanently green for the
// wrong reason. This subject is a file the lens is already known to read and find clean (it is the
// roster's own cost-model row), so a green here says the typed read still reaches real bytes.
test fn a_readable_subject_still_reaches_the_lens() -> Bool {
  match file_gate_disposition(
    path: "src/v2/lens/complexity_accumulator_copy.dag",
    refusal_ceiling: 0
  ) {
    GateClean => true
    GateNotEstablished { cause: _ } => false
    GateSuspectObserved { suspects: _ } => false
    GateRefusalBudgetExceeded { refusals: _, ceiling: _ } => false
  }
}
