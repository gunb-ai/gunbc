module v2.test.claim.complexity.r1_surface_subject

import v2.compiler.normalize { normalize }
import v2.compiler.parse { parse_module }
import v2.compiler.tokenize { tokenize }
import v2.lens.complexity_r1_accumulator_copy {
  R1Clean,
  R1MalformedSubject,
  R1PolyTwoSuspect,
  r1_judge_fold_step
}
import v2.lens.complexity_r1_accumulator_copy.surface_subject { fold_call_to_r1_subject }
import v2.extdeps.languages.dag {
  ParseSubtreeAbsent,
  ParseSubtreeFound,
  dag_language_model_wave1,
  parse_subtree_find_production_captured
}
import v2.std.collection { Absent, Optional, Present }
import v2.std.diagnostic { Accepted, Outcome, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Node, Symbol }
import v2.std.text { String }

data r1_surface_subject_note: String = "Catches a real quadratic end-to-end: real source -> census ingest (tokenize/parse/normalize) -> locate the fold call -> fold_call_to_r1_subject distills the surface fold body into R1's fold-step subject -> r1_judge_fold_step. The RED (list_append(left: acc, right: x)) has the accumulator in list_append's copied (left) port, so R1 projects Poly(2). The GREEN uses the SAME combiner with the accumulator flipped to the non-copied (right) port (list_append(left: x, right: acc)) — clean — isolating the copied-port check as the sole difference. The REFUSE control is an identity-body fold (fn(acc, x) { acc }) with no two-argument combiner call: the distiller refuses (fail-closed), never fabricating a subject that R1 would read as clean."

data quadratic_snippet: String = "module quad\n\nfn f(xs: List<Int>) -> Int {\n  fold(xs, init: 0, f: fn(acc, x) { list_append(left: acc, right: x) })\n}\n"

data linear_snippet: String = "module lin\n\nfn f(xs: List<Int>) -> Int {\n  fold(xs, init: 0, f: fn(acc, x) { list_append(left: x, right: acc) })\n}\n"

data identity_snippet: String = "module ident\n\nfn f(xs: List<Int>) -> Int {\n  fold(xs, init: 0, f: fn(acc, x) { acc })\n}\n"

fn ingest(source_text: String, file: Symbol) -> Optional<Node> {
  let lm = dag_language_model_wave1()
  match tokenize(text: source_text, file: file, rules: lm.lex) {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: _ } => Absent
        Accepted { value: artifact, diagnostics: _ } =>
          match normalize(parse_tree: artifact.tree) {
            Rejected { diagnostics: _ } => Absent
            Accepted { value: tree, diagnostics: _ } => Present { value: tree }
          }
      }
  }
}

fn locate_fold_call(root: Node) -> Optional<Node> {
  match parse_subtree_find_production_captured(root: root, emitted: ^dag_surface_primary_expr) {
    ParseSubtreeFound { captured: call } => Present { value: call }
    ParseSubtreeAbsent => Absent
  }
}

fn located_subject(source_text: String, file: Symbol) -> Optional<Outcome<Node>> {
  match ingest(source_text: source_text, file: file) {
    Absent => Absent
    Present { value: tree } =>
      match locate_fold_call(root: tree) {
        Absent => Absent
        Present { value: call } => Present { value: fold_call_to_r1_subject(fold_call: call) }
      }
  }
}

test fn quadratic_fold_projects_poly_two() -> Bool {
  match located_subject(source_text: quadratic_snippet, file: ^quad_file) {
    Absent => false
    Present { value: outcome } =>
      match outcome {
        Rejected { diagnostics: _ } => false
        Accepted { value: subject, diagnostics: _ } =>
          match r1_judge_fold_step(n: subject) {
            R1PolyTwoSuspect { implied_cost: _, flow_opaque_count: _ } => true
            R1Clean { flow_opaque_count: _ } => false
            R1MalformedSubject => false
          }
      }
  }
}

test fn linear_fold_is_clean() -> Bool {
  match located_subject(source_text: linear_snippet, file: ^lin_file) {
    Absent => false
    Present { value: outcome } =>
      match outcome {
        Rejected { diagnostics: _ } => false
        Accepted { value: subject, diagnostics: _ } =>
          match r1_judge_fold_step(n: subject) {
            R1PolyTwoSuspect { implied_cost: _, flow_opaque_count: _ } => false
            R1Clean { flow_opaque_count: _ } => true
            R1MalformedSubject => false
          }
      }
  }
}

test fn identity_body_fold_refuses() -> Bool {
  match located_subject(source_text: identity_snippet, file: ^ident_file) {
    Absent => false
    Present { value: outcome } =>
      match outcome {
        Rejected { diagnostics: _ } => true
        Accepted { value: _, diagnostics: _ } => false
      }
  }
}
