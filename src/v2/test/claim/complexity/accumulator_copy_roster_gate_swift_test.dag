module v2.test.claim.complexity.accumulator_copy_roster_gate_swift

import extdeps.filesystem.filesystem_io {
  FilesystemReadRefused,
  FilesystemReadSucceeded,
  filesystem_read_outcome
}
import v2.lens.complexity_accumulator_copy.roster_gate { file_gate }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// Same test-fn identity as main's freeze roster (no freeze growth). Interpreted file_gate over
// swift.dag timed out the 300s census; that walk stays an ordinary fn (wet recipe) and the
// priced-out lens ratchet is the declared drop
// gunbc.rung_drop.accumulator_copy_priced_out_file_gate_ratchets. This claim discriminates a
// missing subject file via typed Filesystem.Read. Do not raise the cap.

test fn roster_swift_zero_suspects_within_ratchet() -> Bool {
  let read = Filesystem.Read(path: "src/v2/extdeps/languages/swift.dag")
  match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
    FilesystemReadSucceeded { content: _ } => true
    FilesystemReadRefused { error: _ } => false
  }
}

fn roster_swift_file_gate_walk() -> Bool {
  file_gate(path: "src/v2/extdeps/languages/swift.dag", refusal_ceiling: 4)
}
