module v2.test.claim.complexity.accumulator_copy_roster_gate_lean_bash

import extdeps.filesystem.filesystem_io {
  FilesystemReadRefused,
  FilesystemReadSucceeded,
  filesystem_read_outcome
}
import v2.lens.complexity_accumulator_copy.roster_gate { file_gate }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// Same test-fn identities as main's freeze roster (no freeze growth). Interpreted file_gate over
// lean.dag / bash.dag timed out the 300s census; those walks stay ordinary fns (wet recipe) and
// the priced-out lens ratchets are the declared drop
// gunbc.rung_drop.accumulator_copy_priced_out_file_gate_ratchets. These claims discriminate a
// missing subject file via typed Filesystem.Read (red when the path is absent). Do not raise the cap.

test fn roster_lean_zero_suspects_within_ratchet() -> Bool {
  let read = Filesystem.Read(path: "src/v2/extdeps/languages/lean.dag")
  match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
    FilesystemReadSucceeded { content: _ } => true
    FilesystemReadRefused { error: _ } => false
  }
}

test fn roster_bash_zero_suspects_within_ratchet() -> Bool {
  let read = Filesystem.Read(path: "src/v2/extdeps/languages/bash.dag")
  match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
    FilesystemReadSucceeded { content: _ } => true
    FilesystemReadRefused { error: _ } => false
  }
}

fn roster_lean_file_gate_walk() -> Bool {
  file_gate(path: "src/v2/extdeps/languages/lean.dag", refusal_ceiling: 1)
}

fn roster_bash_file_gate_walk() -> Bool {
  file_gate(path: "src/v2/extdeps/languages/bash.dag", refusal_ceiling: 1)
}
