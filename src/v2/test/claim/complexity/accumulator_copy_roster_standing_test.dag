module v2.test.claim.complexity.accumulator_copy_roster_standing

import v2.lens.complexity_accumulator_copy.roster_gate {
  AnalysisNotEstablished,
  FindingNotEstablished,
  NoSuspect,
  RefusalBudgetExceeded,
  RosterStanding,
  SourceFindingsEstablished,
  SourceFindingsNotEstablished,
  SuspectObserved,
  Within,
  not_established_standing,
  source_findings,
  standing_from_counts
}
import v2.lens.common.source_analysis_standing {
  LanguageGrammarRejected,
  LanguageGrammarUnavailable,
  SourceNormalizationRejected,
  SourceParseRejected,
  SourceTokenizationRejected,
  SourceUnreadable
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// PURE CLASSIFIER EVIDENCE. These fixtures discriminate the product standing without reading or
// re-parsing the repository. The live file censuses remain a separate, offline coverage question.
test fn suspect_and_analysis_standings_are_both_preserved() -> Bool {
  match standing_from_counts(suspects: 1, refusals: 1, refusal_ceiling: 0) {
    RosterStanding {
      finding: SuspectObserved { suspects: 1 },
      analysis: RefusalBudgetExceeded { refusals: 1, ceiling: 0 }
    } => true
    _ => false
  }
}

test fn refusal_above_ceiling_is_analysis_coverage_debt() -> Bool {
  match standing_from_counts(suspects: 0, refusals: 4, refusal_ceiling: 3) {
    RosterStanding {
      finding: NoSuspect,
      analysis: RefusalBudgetExceeded { refusals: 4, ceiling: 3 }
    } => true
    _ => false
  }
}

test fn refusal_at_ceiling_is_within_standing() -> Bool {
  match standing_from_counts(suspects: 0, refusals: 3, refusal_ceiling: 3) {
    RosterStanding {
      finding: NoSuspect,
      analysis: Within { refusals: 3, ceiling: 3 }
    } => true
    _ => false
  }
}

test fn not_established_cause_is_preserved_on_both_axes() -> Bool {
  match not_established_standing(cause: SourceNormalizationRejected) {
    RosterStanding {
      finding: FindingNotEstablished { cause: SourceNormalizationRejected },
      analysis: AnalysisNotEstablished { cause: SourceNormalizationRejected }
    } => true
    _ => false
  }
}

// EVERY CAUSE IS WRITTEN OUT BELOW, INCLUDING ONE THIS CALL CANNOT PRODUCE. source_findings takes
// the source text it is handed and never reads a file, so SourceUnreadable is unreachable here and
// its arm answers false. The arm exists because the match is deliberately total with no wildcard,
// and that totality is what made widening the cause coproduct fail LOUDLY at this consumer instead
// of defaulting through a catch-all -- the wall doing its job on the change that added the variant.
test fn malformed_source_reports_tokenization_rejection() -> Bool {
  match v2.lens.complexity_accumulator_copy.roster_gate.source_findings(source_text: "@@@ not dag source @@@ )( unterminated \"") {
    SourceFindingsNotEstablished { cause: SourceTokenizationRejected } => true
    SourceFindingsNotEstablished { cause: LanguageGrammarUnavailable } => false
    SourceFindingsNotEstablished { cause: LanguageGrammarRejected } => false
    SourceFindingsNotEstablished { cause: SourceParseRejected } => false
    SourceFindingsNotEstablished { cause: SourceNormalizationRejected } => false
    SourceFindingsNotEstablished { cause: SourceUnreadable } => false
    SourceFindingsEstablished { findings: _ } => false
  }
}
