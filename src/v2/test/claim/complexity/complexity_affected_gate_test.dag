module v2.test.claim.complexity.complexity_affected_gate

import v2.workflow.complexity_affected_gate {
  ChangedFileClean,
  ChangedFileSuspect,
  ChangedFileUnanalyzable,
  affected_complexity_gate_passes,
  classify_changed_dag
}
import v2.std.logic { Bool }
import v2.std.text { String }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data suspect_fixture: String = "src/v2/test/fixture/complexity/quadratic_accumulator_fixture.dag"
data clean_subject: String = "src/v2/workflow/affected_set_floor_runner.dag"

data gate_test_note: String = "RED control (suspect_fixture) is a proven Poly2 accumulator-copy (the analysis test's quadratic_snippet shape: fold + list_append(left: acc)); it MUST refuse the gate. GREEN control is the real floor runner, verified suspect-free (file_gate PASS after the list_flat_map fix). The gate reads live tree (filesystem_read on each changed path) — declared ReadsLiveTree, so no diff can predict-skip it; it always runs, scoped to the changed .dag set by construction."

test fn red_control_suspect_refuses_gate() -> Bool {
  affected_complexity_gate_passes(changed_paths: [suspect_fixture]) == false
}

test fn green_control_clean_passes_gate() -> Bool {
  affected_complexity_gate_passes(changed_paths: [clean_subject])
}

test fn non_dag_path_filtered_out() -> Bool {
  affected_complexity_gate_passes(changed_paths: ["README.md", "docs/plans/x.md"])
}

test fn mixed_diff_refuses_on_the_suspect() -> Bool {
  affected_complexity_gate_passes(changed_paths: [clean_subject, "README.md", suspect_fixture]) == false
}

test fn classify_suspect_fixture() -> Bool {
  match classify_changed_dag(path: suspect_fixture) {
    ChangedFileSuspect { path: _ } => true
    ChangedFileClean { path: _ } => false
    ChangedFileUnanalyzable { path: _ } => false
  }
}

test fn classify_clean_subject() -> Bool {
  match classify_changed_dag(path: clean_subject) {
    ChangedFileClean { path: _ } => true
    ChangedFileSuspect { path: _ } => false
    ChangedFileUnanalyzable { path: _ } => false
  }
}
