module v2.test.claim.complexity.probe_gate_std_count

// TRIAGE PROBE 2 (silent-bee-194, manager ruling msg_adddb844 item 2 follow-up). The arm is
// established: GateRefusalBudgetExceeded. This claim returns the refusal COUNT as the exit code so
// one executed run names it. Delete after triage.

import v2.lens.complexity_accumulator_copy.roster_gate {
  GateClean,
  GateNotEstablished,
  GateRefusalBudgetExceeded,
  GateSuspectObserved,
  file_gate_disposition
}
import std.process { ProcessExit, ExitFailure, ExitSuccess }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

test fn probe_gate_std_refusal_count() -> ProcessExit {
  match file_gate_disposition(path: "dag/std/change.dag", refusal_ceiling: 13) {
    GateRefusalBudgetExceeded { refusals: refusals, ceiling: _ } =>
      ExitFailure { code: refusals, reason: "refusal-count-in-code" }
    GateClean => ExitFailure { code: 0, reason: "clean" }
    GateSuspectObserved { suspects: _ } => ExitFailure { code: -1, reason: "suspects" }
    GateNotEstablished { cause: _ } => ExitFailure { code: -2, reason: "not-established" }
  }
}
