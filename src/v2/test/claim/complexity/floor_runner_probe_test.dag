module v2.test.claim.complexity.floor_runner_probe

import v2.lens.complexity_accumulator_copy.roster_gate { ingest_findings }
import v2.std.collection { Absent, Present }
import v2.std.logic { Bool }
import v2.std.text { String }

fn ingests(path: String) -> Bool {
  match ingest_findings(path: path) {
    Absent => false
    Present { value: _ } => true
  }
}

test fn ingest_change_dag() -> Bool { ingests(path: "dag/std/change.dag") }
test fn ingest_floor_runner() -> Bool { ingests(path: "src/v2/workflow/affected_set_floor_runner.dag") }
test fn ingest_affected_selection() -> Bool { ingests(path: "src/v2/workflow/affected_set_selection.dag") }
test fn ingest_witness_cost_locality() -> Bool { ingests(path: "src/v2/lens/witness_cost_locality.dag") }
test fn ingest_roster_gate() -> Bool { ingests(path: "src/v2/lens/complexity_accumulator_copy/roster_gate.dag") }
test fn ingest_ci_floor_plan() -> Bool { ingests(path: "src/v2/workflow/ci_floor_plan.dag") }
