module v2.test.claim.native_census.whole_tree_census_resolve

import v2.compiler.compile {
  NativeCensusModule,
  NativeCensusModuleFileRefused,
  NativeCensusModuleResolveRefused,
  NativeCensusModuleResolved,
  NativeCensusModuleOutcome,
  NativeCensusResidualRow,
  NativeCensusCompletenessObserved,
  NativeCensusCompletenessUnavailable,
  NativeTestContext,
  native_census_module_completeness,
  native_census_module_resolution,
  native_census_modules,
  native_census_residual_rows,
  native_lane_file_refusal_index,
  native_test_context_from_ingest
}
import v2.compiler.native_test_vocabulary { NativeTestFileRefusal }
import v2.compiler.source_authority { DagSourceReadWitness, SourceRootIngest }
import v2.std.algebra { fold_list, length }
import v2.std.collection { Map }
import v2.std.integer { Int }
import std.algebra { Cons, Empty }
import v2.std.artifact { Artifact, SourceFile }
import extdeps.communication.medium { Lossless, Medium }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.diagnostic { Accepted, Outcome, Rejected, diagnostics_fatal }
import v2.compiler.resolve { ObservationComplete, ObservationIncomplete }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.optional { Absent, Optional, Present, optional_absent, optional_present }
import v2.std.text { String }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE SOURCES ARE SUPPLIED AND THE ROUTE IS REAL, which is the split DESIGN section 3 asks for: the
// boundary this claim discriminates is native_census_module_resolution, so its INPUT -- source bytes
// -- is constructed rather than read off a disk this substrate cannot reach, and everything above
// that boundary is the production fold. native_test_context_from_ingest is the same whole-ingest
// context the driver's census assembles, and native_test_resolve_module underneath the verdict is
// the same resolver the adjudicating lane runs. Nothing here is a hand-built Node tree: the
// discriminator gunbc#11202 lost was one that never reached the production fold at all, and the
// three specimens below reach it through tokenize, parse, normalize and resolve in order.
//
// THREE SPECIMENS, BECAUSE A CONTROL SATISFIED BY ANY REFUSAL IS GREEN ON A CAUSE IT NEVER SAW.
// The census exists to report RESOLVE refusals, and the two states that would counterfeit one are a
// module the context already refused before the resolver was reached, and a module that resolves.
// So the roster carries one of each and the claims below assert which arm each lands in -- a census
// that reported the poison file as a resolve refusal would be inventing a residual, and one that
// reported the unbound reference as a file refusal would be losing the one it exists to find.

// THE SPECIMENS ARE ONE LINE OF SOURCE EACH, and each imports what it legitimately uses, so the
// only unbound name in the tree is the one the middle specimen exists to carry. A probe whose
// return type were also unbound would still be reported resolve_refused and would stop telling you
// WHICH absence the census saw.
data census_clean_source: String = "module v2.census_probe_clean\n\nimport v2.std.logic { Bool }\n\nfn census_probe_clean_value(p: Bool) -> Bool { p }\n"

// THE UNBOUND REFERENCE IS THE SUBJECT, and it is shaped like what an XL-2 rehearsal actually
// leaves behind: the module parses and normalizes cleanly -- so the context admits the file and
// mints no file refusal for it -- and refuses at NAME RESOLUTION, because the declaration its
// reference named is no longer reachable. That is a stripped import's residual, one site of it.
data census_unbound_source: String = "module v2.census_probe_unbound\n\nimport v2.std.logic { Bool }\n\nfn census_probe_unbound_value(p: Bool) -> Bool { census_probe_absent_callee }\n"

// TWO INDEPENDENT REFUSALS IN ONE MODULE -- THE DISCRIMINATOR FOR OCCURRENCE GRAIN.
//
// Two declarations, each naming a DIFFERENT absent callee. Neither reference depends on the other,
// and the module's scope is fixed before its children are walked, so both sites are independently
// observable: observing the second cannot be an artifact of the first having failed.
//
// WHAT MAKES THIS THE DISCRIMINATING RED. A resolver that stops after the first rejected child
// reports ONE residual row for this module and never sees the second site -- truthful at MODULE
// grain and an undercount at OCCURRENCE grain, which is the grain XL-2's rehearsal residual needs.
// The single-site specimen above CANNOT tell those apart: it yields one row either way. So the
// claim below is the only arm in this file with the power to fail when the walk hides refusals.
data census_two_source: String = "module v2.census_probe_two\n\nimport v2.std.logic { Bool }\n\nfn census_probe_two_first(p: Bool) -> Bool { census_probe_absent_one }\n\nfn census_probe_two_second(p: Bool) -> Bool { census_probe_absent_two }\n"

// ONE CHAIN WITH A PENDING ADVISORY. The declaration names a value another probe module DOES
// declare but this one never imports, so its one refusal carries the resolver's declared-elsewhere
// advisory in front of its fatal: two diagnostics, ONE refused occurrence. A fan-out that made the
// advisory a row of its own reports two residual sites here.
data census_advised_source: String = "module v2.census_probe_advised\n\nimport v2.std.logic { Bool }\n\nfn census_probe_advised_first(p: Bool) -> Bool { census_probe_clean_value }\n"

// PENDING ADVISORIES STAY WITH THEIR OWN FATAL ACROSS CHAINS. The first declaration's refusal
// carries the declared-elsewhere advisory; the second names a value nothing declares, so its chain
// carries none. A walk that let the advisory drift onto the neighbouring chain, or duplicated it
// there, is red on the claim that reads this module.
data census_advised_two_source: String = "module v2.census_probe_advised_two\n\nimport v2.std.logic { Bool }\n\nfn census_probe_advised_two_first(p: Bool) -> Bool { census_probe_clean_value }\n\nfn census_probe_advised_two_second(p: Bool) -> Bool { census_probe_absent_three }\n"

// THE POISON SPECIMEN REFUSES IN THE FRONT END, before the resolver is entered at all. The bytes
// are the same shape as the lane's committed malformed control (fixtures/native_lane_malformed):
// a string that never terminates, which any honest front end refuses at tokenize.
data census_poison_source: String = "module v2.census_probe_poison\n\ndata census_probe_broken: String = \"this string never terminates\n"

fn census_probe_read(source: String, id: Symbol, unit: Symbol, path: String) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: source, fidelity: Lossless },
    artifact: Artifact { kind: SourceFile, id: id, file_path: path },
    compilation_unit: unit,
    source_root: DagTree
  }
}

data census_probe_ingest: SourceRootIngest = Cons {
  head: census_probe_read(
    source: census_clean_source,
    id: ^census_probe_clean_artifact,
    unit: ^census_probe_clean_cu,
    path: "dag/census_probe_clean.dag"
  ),
  tail: Cons {
    head: census_probe_read(
      source: census_unbound_source,
      id: ^census_probe_unbound_artifact,
      unit: ^census_probe_unbound_cu,
      path: "dag/census_probe_unbound.dag"
    ),
    tail: Cons {
      head: census_probe_read(
        source: census_poison_source,
        id: ^census_probe_poison_artifact,
        unit: ^census_probe_poison_cu,
        path: "dag/census_probe_poison.dag"
      ),
      tail: Cons {
        head: census_probe_read(
          source: census_two_source,
          id: ^census_probe_two_artifact,
          unit: ^census_probe_two_cu,
          path: "dag/census_probe_two.dag"
        ),
        tail: Cons {
          head: census_probe_read(
            source: census_advised_source,
            id: ^census_probe_advised_artifact,
            unit: ^census_probe_advised_cu,
            path: "dag/census_probe_advised.dag"
          ),
          tail: Cons {
            head: census_probe_read(
              source: census_advised_two_source,
              id: ^census_probe_advised_two_artifact,
              unit: ^census_probe_advised_two_cu,
              path: "dag/census_probe_advised_two.dag"
            ),
            tail: Empty
          }
        }
      }
    }
  }
}

// ONE NULLARY PRODUCER, FORCED ONCE, BECAUSE THE FLOOR BUILDS A FRESH EVALUATION FRAME PER CLAIM.
//
// WHAT THIS REPLACES AND WHY. The first shape of this file was a `census_probe_outcome_for(module)`
// helper that each claim called, and every call re-entered native_test_context_from_ingest -- the
// language model, the grammar preparation and the tokenize/parse/normalize of all three specimens,
// once per claim. The required floor measured the result and refused it: four identities at
// 197116-200054 evaluator steps against the 72300-step new-witness budget of
// v2.workflow.required_floor claim_eval_step_budget_for_identity (run 35464948266, job
// 105955463881, cause=completed_over_cost_requirement). The cost was never what the claims
// ASSERT -- each inspects one module's outcome -- it was one call whose result shape is all they
// read, which is the shape DESIGN section 3's standing rule names: a claim whose evaluation is
// dominated by ONE call it only inspects the result of.
//
// THE REPAIR IS TO STOP RECOMPUTING, NOT TO RAISE THE LINE (v2.workflow.floor_pure_producer_share's
// own words). This declaration is nullary and pure, so it is preparation-forceable: enrolled as a
// WARM row it is evaluated once during strict preparation and billed there, and each claim below
// then reads a value rather than rebuilding a front end. The precedent is exact --
// v2.test.native_decl_selection's four witnesses drove this same native_test_context_from_ingest
// over one synthetic ingest, were refused on the same ground, and were repaired by the warm row
// `v2.test.native_decl_selection.collision_resolved` rather than by moving or excusing them.
//
// THE REAL ROUTE STILL EXECUTES, WHICH IS THE POINT OF THE PAIRING OBLIGATION. Sharing moves WHERE
// the front end is paid, not WHETHER it runs: this producer performs the same tokenize, parse,
// normalize and resolve over the same supplied bytes that the driver's census-resolve mode performs
// over a source root. Deleting the integration still reds every claim below.
type CensusProbeOutcomes
  = CensusProbeContextRefused
  | CensusProbeOutcomesDecided {
      clean: NativeCensusModuleOutcome
      unbound: NativeCensusModuleOutcome
      poison: NativeCensusModuleOutcome
      advised: NativeCensusModuleOutcome
      unbound_residual_rows: Int
      two_residual_rows: Int
      advised_rows: List<NativeCensusResidualRow>
      two: NativeCensusModuleOutcome
      advised_two: NativeCensusModuleOutcome
    }

fn census_probe_outcome_in(
  context: NativeTestContext,
  index: Map<Symbol, NativeTestFileRefusal>,
  module_name: String
) -> Optional<NativeCensusModuleOutcome> {
  fold_list(
    xs: native_census_modules(ingest: census_probe_ingest),
    empty: optional_absent(),
    cons: fn(acc, entry) {
      if entry.module == module_name {
        optional_present(
          value: native_census_module_resolution(
            context: context,
            refusal_index: index,
            entry: entry
          )
        )
      } else {
        acc
      }
    }
  )
}

// THE RESIDUAL FAN-OUT IS COUNTED HERE RATHER THAN IN THE CLAIM, so the claim that asserts
// occurrence grain reads an Int instead of re-entering the resolver to obtain the chain it would
// then fan out.
fn census_probe_unbound_rows(entry: NativeCensusModule, outcome: NativeCensusModuleOutcome) -> Int {
  match outcome {
    NativeCensusModuleResolveRefused { first: f, rest: r, observation: _ } =>
      length(xs: native_census_residual_rows(entry: entry, first: f, rest: r))
    NativeCensusModuleFileRefused => 0
    NativeCensusModuleResolved => 0
  }
}

fn census_probe_unbound_entry() -> NativeCensusModule {
  NativeCensusModule {
    module: "v2.census_probe_unbound",
    path: ^census_probe_unbound_cu
  }
}

fn census_probe_two_entry() -> NativeCensusModule {
  NativeCensusModule {
    module: "v2.census_probe_two",
    path: ^census_probe_two_cu
  }
}

fn census_probe_advised_entry() -> NativeCensusModule {
  NativeCensusModule {
    module: "v2.census_probe_advised",
    path: ^census_probe_advised_cu
  }
}

fn census_probe_rows_of(entry: NativeCensusModule, outcome: NativeCensusModuleOutcome) -> List<NativeCensusResidualRow> {
  match outcome {
    NativeCensusModuleResolveRefused { first: f, rest: r, observation: _ } =>
      native_census_residual_rows(entry: entry, first: f, rest: r)
    NativeCensusModuleFileRefused => []
    NativeCensusModuleResolved => []
  }
}

fn census_probe_outcomes() -> CensusProbeOutcomes {
  match native_test_context_from_ingest(ingest: census_probe_ingest) {
    Rejected { diagnostics: _ } => CensusProbeContextRefused
    Accepted { value: context, diagnostics: _ } => {
      let index = native_lane_file_refusal_index(refusals: context.file_refusals)
      let unbound = census_probe_outcome_in(
        context: context,
        index: index,
        module_name: "v2.census_probe_unbound"
      )
      match unbound {
        Absent => CensusProbeContextRefused
        Present { value: unbound_outcome } =>
          match census_probe_outcome_in(context: context, index: index, module_name: "v2.census_probe_clean") {
            Absent => CensusProbeContextRefused
            Present { value: clean_outcome } =>
              match census_probe_outcome_in(context: context, index: index, module_name: "v2.census_probe_poison") {
                Absent => CensusProbeContextRefused
                Present { value: poison_outcome } =>
                  match census_probe_outcome_in(context: context, index: index, module_name: "v2.census_probe_two") {
                    Absent => CensusProbeContextRefused
                    Present { value: two_outcome } =>
                      match census_probe_outcome_in(context: context, index: index, module_name: "v2.census_probe_advised") {
                        Absent => CensusProbeContextRefused
                        Present { value: advised_outcome } =>
                      match census_probe_outcome_in(context: context, index: index, module_name: "v2.census_probe_advised_two") {
                        Absent => CensusProbeContextRefused
                        Present { value: advised_two_outcome } =>
                      CensusProbeOutcomesDecided {
                        two: two_outcome,
                        advised_two: advised_two_outcome,
                        clean: clean_outcome,
                        unbound: unbound_outcome,
                        poison: poison_outcome,
                        advised: advised_outcome,
                        advised_rows: census_probe_rows_of(entry: census_probe_advised_entry(), outcome: advised_outcome),
                        unbound_residual_rows: census_probe_unbound_rows(
                          entry: census_probe_unbound_entry(),
                          outcome: unbound_outcome
                        ),
                        two_residual_rows: census_probe_unbound_rows(
                          entry: census_probe_two_entry(),
                          outcome: two_outcome
                        )
                      }
                      }
                      }
                  }
              }
          }
      }
    }
  }
}

// THE ROSTER IS READ FROM THE INGEST AND IT IS TOTAL. A census whose module roster silently dropped
// a file would under-report by exactly the files it dropped, and no per-module claim below could
// see it: each of them asks about a module the roster already produced.
test fn census_roster_carries_every_declared_module_holds() -> Bool {
  length(xs: native_census_modules(ingest: census_probe_ingest)) == 6
}

test fn census_unbound_module_is_resolve_refused_holds() -> Bool {
  match census_probe_outcomes() {
    CensusProbeContextRefused => false
    CensusProbeOutcomesDecided { clean: _, unbound: unbound, poison: _, advised: _, unbound_residual_rows: _, two_residual_rows: _, advised_rows: _, two: _, advised_two: _ } =>
      match unbound {
        NativeCensusModuleResolveRefused { first: _, rest: _, observation: _ } => true
        NativeCensusModuleFileRefused => false
        NativeCensusModuleResolved => false
      }
  }
}

// ONE REFUSED SITE IS ONE ROW, AND THE ROW NAMES ITS SITE. This replaces a control that compared
// the row count to the chain's own diagnostic count (rows == tail + 1): that arithmetic made every
// pending advisory a residual site, so it was green on exactly the inflation it should refuse.
test fn census_single_refusal_is_one_row_naming_its_site_holds() -> Bool {
  match census_probe_outcomes() {
    CensusProbeContextRefused => false
    CensusProbeOutcomesDecided { clean: _, unbound: unbound, poison: _, advised: _, unbound_residual_rows: rows, two_residual_rows: _, advised_rows: _, two: _, advised_two: _ } =>
      match unbound {
        NativeCensusModuleResolveRefused { first: d, rest: _, observation: _ } =>
          rows == 1 && diagnostics_fatal(d: d).reason == ^resolve_reason_unbound_symbol
        NativeCensusModuleFileRefused => false
        NativeCensusModuleResolved => false
      }
  }
}

// A SINGLE CHAIN WITH A PENDING ADVISORY IS EXACTLY ONE ROW, AND THE ROW CARRIES THE WHOLE CHAIN.
// The advised module's chain is [declared-elsewhere advisory, unbound fatal]: two diagnostics, one
// occurrence. RED under a per-diagnostic fan-out (two rows), and RED if the row dropped the
// advisory or carried anything but the unbound fatal as its diagnostics_fatal.
test fn census_advised_chain_is_one_row_carrying_its_chain_holds() -> Bool {
  match census_probe_outcomes() {
    CensusProbeContextRefused => false
    CensusProbeOutcomesDecided { clean: _, unbound: _, poison: _, advised: _, unbound_residual_rows: _, two_residual_rows: _, advised_rows: rows, two: _, advised_two: _ } =>
      length(xs: rows) == 1
        && fold_list(xs: rows, empty: true, cons: fn(acc, row) {
          acc
            && row.chain.head.reason == ^resolve_unbound_name_is_declared_elsewhere
            && length(xs: row.chain.tail) == 1
            && diagnostics_fatal(d: row.chain).reason == ^resolve_reason_unbound_symbol
        })
  }
}

// THE DISCRIMINATOR AGAINST "ANY REFUSAL IS A RESIDUAL". The poison file refuses in the front end,
// so the census must attribute it to the CONTEXT and not to the resolver it never entered. Without
// this arm every claim here is satisfied by a census that reports every refusal as a resolve
// refusal, which would inflate the residual with files the strip never affected.
test fn census_poison_module_is_file_refused_not_resolve_refused_holds() -> Bool {
  match census_probe_outcomes() {
    CensusProbeContextRefused => false
    CensusProbeOutcomesDecided { clean: _, unbound: _, poison: poison, advised: _, unbound_residual_rows: _, two_residual_rows: _, advised_rows: _, two: _, advised_two: _ } =>
      match poison {
        NativeCensusModuleFileRefused => true
        NativeCensusModuleResolveRefused { first: _, rest: _, observation: _ } => false
        NativeCensusModuleResolved => false
      }
  }
}

// THE DENOMINATOR IS NOT EMPTY AND IT IS NOT ALL REFUSALS. Without this arm every claim above is
// satisfied by a census that refuses everything, which is the failure gunbc#11582 landed and
// withdrew: a discriminator that agreed with its subject for the wrong reason.
test fn census_clean_module_resolves_holds() -> Bool {
  match census_probe_outcomes() {
    CensusProbeContextRefused => false
    CensusProbeOutcomesDecided { clean: clean, unbound: _, poison: _, advised: _, unbound_residual_rows: _, two_residual_rows: _, advised_rows: _, two: _, advised_two: _ } =>
      match clean {
        NativeCensusModuleResolved => true
        NativeCensusModuleFileRefused => false
        NativeCensusModuleResolveRefused { first: _, rest: _, observation: _ } => false
      }
  }
}

// TWO INDEPENDENT REFUSALS IN ONE MODULE BOTH REACH THE CENSUS.
//
// THE ONLY ARM IN THIS FILE THAT CAN FAIL WHEN THE WALK HIDES REFUSALS. Every other claim asks
// about a module carrying ONE refusal, and one refusal yields one residual row whether the walk
// stops at the first or observes them all -- so a green sweep over those arms is consistent with a
// resolver that discards everything after the first site. This module carries two, in two
// declarations, naming two different absent callees, so the fan-out's own arithmetic separates the
// two behaviours: a stopping walk reports ONE row, an occurrence-complete walk reports TWO.
//
// RESTORING THE SHORT-CIRCUIT TURNS THIS RED AND LEAVES EVERY OTHER ARM GREEN, which is what makes
// it the discriminator rather than a restatement of the single-site claim above it.
test fn census_two_independent_refusals_both_reach_the_census_holds() -> Bool {
  match census_probe_outcomes() {
    CensusProbeContextRefused => false
    CensusProbeOutcomesDecided { clean: _, unbound: _, poison: _, advised: _, unbound_residual_rows: _, two_residual_rows: rows, advised_rows: _, two: _, advised_two: _ } =>
      rows == 2
  }
}

// EACH CHAIN KEEPS ITS OWN ADVISORY. The first chain is [declared-elsewhere advisory, unbound
// fatal]; the second is the unbound fatal alone. RED if the advisory drifted to the second chain,
// was duplicated onto it, or became a chain of its own.
test fn census_advisory_stays_with_its_own_fatal_holds() -> Bool {
  match census_probe_outcomes() {
    CensusProbeContextRefused => false
    CensusProbeOutcomesDecided { clean: _, unbound: _, poison: _, advised: _, unbound_residual_rows: _, two_residual_rows: _, advised_rows: _, two: _, advised_two: advised_two } =>
      match advised_two {
        NativeCensusModuleResolveRefused { first: f, rest: r, observation: _ } =>
          f.head.reason == ^resolve_unbound_name_is_declared_elsewhere
            && length(xs: f.tail) == 1
            && diagnostics_fatal(d: f).reason == ^resolve_reason_unbound_symbol
            && fold_list(xs: r, empty: length(xs: r) == 1, cons: fn(acc, c) {
              acc && length(xs: c.tail) == 0 && c.head.reason == ^resolve_reason_unbound_symbol
            })
        NativeCensusModuleFileRefused => false
        NativeCensusModuleResolved => false
      }
  }
}

// A FILE THAT NEVER REACHED RESOLVE HAS NO OCCURRENCE COMPLETENESS TO REPORT, and the census says
// so as a typed answer rather than as the absence of rows -- which would read as "complete, zero
// residual". The resolved and the two-refusal modules were walked in full and say that instead.
test fn census_completeness_is_unavailable_for_a_file_that_never_resolved_holds() -> Bool {
  match census_probe_outcomes() {
    CensusProbeContextRefused => false
    CensusProbeOutcomesDecided { clean: clean, unbound: _, poison: poison, advised: _, unbound_residual_rows: _, two_residual_rows: _, advised_rows: _, two: two, advised_two: _ } =>
      match native_census_module_completeness(outcome: poison) {
        NativeCensusCompletenessUnavailable { reason: _ } =>
          census_probe_observed_complete(outcome: clean) && census_probe_observed_complete(outcome: two)
        NativeCensusCompletenessObserved { observation: _ } => false
      }
  }
}

fn census_probe_observed_complete(outcome: NativeCensusModuleOutcome) -> Bool {
  match native_census_module_completeness(outcome: outcome) {
    NativeCensusCompletenessUnavailable { reason: _ } => false
    NativeCensusCompletenessObserved { observation: o } =>
      match o {
        ObservationComplete => true
        ObservationIncomplete { reason: _ } => false
      }
  }
}
