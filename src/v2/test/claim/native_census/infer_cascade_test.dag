module v2.test.claim.native_census.infer_cascade

import v2.compiler.compile {
  NativeCensusCascadeMemberOf,
  NativeCensusCascadeNone,
  NativeCensusCascadeUnattributed,
  NativeCensusCascadeRoot,
  NativeCensusCauseFrontEnd,
  NativeCensusCauseInfer,
  NativeCensusCauseMember,
  NativeCensusCauseResolve,
  NativeCensusCauseStage,
  NativeCensusClosureFanOutAtLeast,
  NativeCensusClosureFanOutCounted,
  NativeCensusClosureFanOutUnavailable,
  NativeCensusInSubjectClosure,
  NativeCensusOutsideSubjectClosure,
  NativeCensusSubjectMembershipUnavailable,
  native_census_cause_group_rows,
  native_census_cause_groups_add_infer_module,
  native_census_cause_groups_from_file_refusals,
  native_census_closure_index,
  native_census_module_inference,
  native_census_module_paths,
  native_census_modules,
  native_census_root_subject_membership,
  native_census_roots_ranked,
  native_census_subject_closure,
  native_lane_file_refusal_index,
  native_test_context_from_ingest
}
import v2.compiler.source_authority { DagSourceReadWitness, SourceRootIngest }
import v2.std.algebra { fold_list, length }
import v2.std.collection { List }
import v2.std.integer { Int }
import std.algebra { Cons, Empty }
import v2.std.artifact { Artifact, SourceFile }
import extdeps.communication.medium { Lossless, Medium }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.text { String }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// CENSUS PART 2'S CASCADE CONTROLS, OVER THE REAL census-infer ROUTE. The sources are supplied (DESIGN
// section 3: at this boundary the input is source bytes). Everything above them is the production fold
// the census-infer driver runs: native_test_context_from_ingest, the census roster, the closure index,
// native_census_module_inference per module (resolve and then the real infer_and_discharge), and
// native_census_cause_groups_add_infer_module. Removing the infer call from that step removes every
// Infer-stage row, which reds the cascade and negative controls (the route, not only the answer).
//
// THE EDGE THESE CONTROLS EXERCISE IS THE ONE v2 INFER HAS (v2.compiler.compile
// native_census_infer_cascade, superseding docs/plans/census-part-2-inference-design.md section 4 on
// this point). Provider b fails RESOLVE (an unbound name in a body beside the record). Importer a
// resolves, because b's declarations are indexed, and then fails INFER projecting that record, because
// a provider that never resolved contributes nothing to the closure index. a's chain carries b's
// resolve chain immediately ahead of its closure-miss fatal.

data infer_b_unresolvable_source: String = "module v2.census_infer_b\n\ntype InferLeg {\n  target: Int\n}\n\nfn census_infer_b_broken() -> Int {\n  no_such_name_anywhere\n}\n"

// b RESOLVES and fails only INFER: a projection off a scalar receiver declares no fields.
data infer_b_infer_only_source: String = "module v2.census_infer_b\n\ntype InferLeg {\n  target: Int\n}\n\nfn census_infer_b_bad(n: Int) -> Int {\n  n.target\n}\n"

// b with its defect removed: the route control. Both rows must disappear.
data infer_b_fixed_source: String = "module v2.census_infer_b\n\ntype InferLeg {\n  target: Int\n}\n"

data infer_a_source: String = "module v2.census_infer_a\n\nimport v2.census_infer_b { InferLeg }\n\nfn census_infer_a_read(l: InferLeg) -> Int {\n  l.target\n}\n"

// THE SUBJECT-CLOSURE SHAPE: subject s imports a, a imports b, and b fails only infer. u fails infer on
// its own and nothing imports it. The label names s's package exactly as the native test target's label
// names its module (v2.compiler.compile native_census_subject_label), so the same fold reads both.
data infer_subject_label: String = "//v2/census_infer_s:all"

data infer_s_source: String = "module v2.census_infer_s\n\nimport v2.census_infer_a { census_infer_a_read }\nimport v2.census_infer_b { InferLeg }\n\nfn census_infer_s_read(l: InferLeg) -> Int {\n  census_infer_a_read(l: l)\n}\n"

data infer_u_source: String = "module v2.census_infer_u\n\nfn census_infer_u_bad(n: Int) -> Int {\n  n.target\n}\n"

fn infer_read(source: String, unit: Symbol, path: String) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: source, fidelity: Lossless },
    artifact: Artifact { kind: SourceFile, id: unit, file_path: path },
    compilation_unit: unit,
    source_root: DagTree
  }
}

fn infer_ingest(b_source: String) -> SourceRootIngest {
  [
    infer_read(source: infer_a_source, unit: ^census_infer_a_cu, path: "dag/census_infer_a.dag"),
    infer_read(source: b_source, unit: ^census_infer_b_cu, path: "dag/census_infer_b.dag")
  ]
}

fn infer_subject_ingest() -> SourceRootIngest {
  [
    infer_read(source: infer_a_source, unit: ^census_infer_a_cu, path: "dag/census_infer_a.dag"),
    infer_read(source: infer_b_infer_only_source, unit: ^census_infer_b_cu, path: "dag/census_infer_b.dag"),
    infer_read(source: infer_s_source, unit: ^census_infer_s_cu, path: "dag/census_infer_s.dag"),
    infer_read(source: infer_u_source, unit: ^census_infer_u_cu, path: "dag/census_infer_u.dag")
  ]
}

// WHAT THE CENSUS REPORTED, reduced to what the claims read. `walls` counts every member that is NOT a
// cascade member, so a census that filed a's infer refusal as a root of its own is counted there.
type InferCensus
  = InferCensusContextRefused
  | InferCensusReported {
      walls: Int
      roots: List<NativeCensusCauseMember>
      a_members: List<NativeCensusCauseMember>
      roots_in_subject: List<Symbol>
      roots_outside_subject: List<Symbol>
    }

fn infer_census(ingest: SourceRootIngest) -> InferCensus {
  match native_test_context_from_ingest(ingest: ingest) {
    Rejected { diagnostics: _ } => InferCensusContextRefused
    Accepted { value: context, diagnostics: _ } =>
      {
        let refusal_index = native_lane_file_refusal_index(refusals: context.file_refusals)
        let modules = native_census_modules(ingest: ingest)
        let closure = native_census_closure_index(context: context, refusal_index: refusal_index, modules: modules)
        let module_paths = native_census_module_paths(modules: modules)
        let groups = fold_list(
          xs: modules,
          empty: native_census_cause_groups_from_file_refusals(refusals: context.file_refusals, closure: closure, resolves: true),
          cons: fn(acc, entry) {
            native_census_cause_groups_add_infer_module(
              groups: acc,
              closure: closure,
              module_paths: module_paths,
              entry: entry,
              step: native_census_module_inference(context: context, refusal_index: refusal_index, entry: entry)
            )
          }
        )
        let rows = native_census_cause_group_rows(groups: groups)
        let roots = native_census_roots_ranked(rows: rows)
        let subject = native_census_subject_closure(index: closure, modules: modules, label: infer_subject_label)
        InferCensusReported {
          walls: fold_list(xs: rows, empty: 0, cons: fn(n, g) {
            fold_list(xs: g.members, empty: n, cons: fn(k, m) {
              match m.cascade {
                NativeCensusCascadeMemberOf { root: _, root_reason: _ } => k
                NativeCensusCascadeNone => k + 1
                NativeCensusCascadeUnattributed { reason: _ } => k + 1
                NativeCensusCascadeRoot { closure_fan_out: _, resolve_refused_importers: _ } => k + 1
              }
            })
          }),
          roots: roots,
          roots_in_subject: fold_list(xs: roots, empty: Empty, cons: fn(acc, m) {
            match native_census_root_subject_membership(subject: subject, root: m) {
              NativeCensusInSubjectClosure => Cons { head: m.path, tail: acc }
              NativeCensusOutsideSubjectClosure => acc
              NativeCensusSubjectMembershipUnavailable { reason: _ } => acc
            }
          }),
          roots_outside_subject: fold_list(xs: roots, empty: Empty, cons: fn(acc, m) {
            match native_census_root_subject_membership(subject: subject, root: m) {
              NativeCensusInSubjectClosure => acc
              NativeCensusOutsideSubjectClosure => Cons { head: m.path, tail: acc }
              NativeCensusSubjectMembershipUnavailable { reason: _ } => acc
            }
          }),
          a_members: fold_list(xs: rows, empty: Empty, cons: fn(acc, g) {
            fold_list(xs: g.members, empty: acc, cons: fn(ms, m) {
              if m.path == ^census_infer_a_cu { Cons { head: m, tail: ms } } else { ms }
            })
          })
        }
      }
  }
}

// ONE NULLARY PRODUCER FOR ALL THREE SHAPES, forced once and shared by the claims (the warm-row
// precedent v2.test.claim.native_census.cascade_root_fan_out states).
type InferCensuses {
  cascade: InferCensus
  infer_only: InferCensus
  fixed: InferCensus
  subject: InferCensus
}

fn infer_censuses() -> InferCensuses {
  InferCensuses {
    cascade: infer_census(ingest: infer_ingest(b_source: infer_b_unresolvable_source)),
    infer_only: infer_census(ingest: infer_ingest(b_source: infer_b_infer_only_source)),
    fixed: infer_census(ingest: infer_ingest(b_source: infer_b_fixed_source)),
    subject: infer_census(ingest: infer_subject_ingest())
  }
}

fn infer_stage_is(stage: NativeCensusCauseStage, infer: Bool) -> Bool {
  match stage {
    NativeCensusCauseInfer => infer
    NativeCensusCauseResolve => !infer
    NativeCensusCauseFrontEnd => false
  }
}

// THE ONE ROOT IS b, AT THE GIVEN STAGE, WITH AN EXACT CLOSURE FAN-OUT.
fn infer_single_root_is_b(roots: List<NativeCensusCauseMember>, infer: Bool, fan_out: Int) -> Bool {
  match roots {
    Empty => false
    Cons { head: m, tail: rest } =>
      length(xs: rest) == 0 && m.path == ^census_infer_b_cu && infer_stage_is(stage: m.stage, infer: infer) && match m.cascade {
        NativeCensusCascadeRoot { closure_fan_out: f, resolve_refused_importers: _ } =>
          match f {
            NativeCensusClosureFanOutCounted { modules: n } => n == fan_out
            NativeCensusClosureFanOutAtLeast { modules: _, unread_refused_files: _ } => false
            NativeCensusClosureFanOutUnavailable { reason: _ } => false
          }
        NativeCensusCascadeNone => false
        NativeCensusCascadeMemberOf { root: _, root_reason: _ } => false
        NativeCensusCascadeUnattributed { reason: _ } => false
      }
  }
}

// CONTROL 1, THE CASCADE. b refuses resolve, a refuses infer only because b's record never entered the
// closure index. Expected: ONE wall, b, a Resolve-stage root with closure fan-out 1 ({a}). a has exactly
// one member, at the Infer stage, a cascade member of b. RED if a's infer refusal is filed as its own root
// (walls 2), if a's row is stamped Resolve (the stage conflation design section 3 forbids), if b carries no
// fan-out, or if the infer call is gone (a has no member at all).
test fn census_infer_provider_cascade_is_one_root_with_fan_out_one_holds() -> Bool {
  match infer_censuses().cascade {
    InferCensusContextRefused => false
    InferCensusReported { walls: w, roots: roots, a_members: a, roots_in_subject: _, roots_outside_subject: _ } =>
      w == 1
        && infer_single_root_is_b(roots: roots, infer: false, fan_out: 1)
        && match a {
          Empty => false
          Cons { head: m, tail: rest } =>
            length(xs: rest) == 0 && infer_stage_is(stage: m.stage, infer: true) && match m.cascade {
              NativeCensusCascadeMemberOf { root: r, root_reason: _ } => r == ^census_infer_b_cu
              NativeCensusCascadeNone => false
              NativeCensusCascadeRoot { closure_fan_out: _, resolve_refused_importers: _ } => false
              NativeCensusCascadeUnattributed { reason: _ } => false
            }
        }
  }
}

// CONTROL 2, THE NEGATIVE. b resolves and fails only INFER. a reads b's record through the closure index,
// which b's resolved declarations fill, so a infers. Expected: ONE wall, b, an Infer-stage root with
// fan-out 1, and NO row for a. RED if the census invents the infer->infer edge v2 infer does not have:
// a member for a, or a second wall.
test fn census_infer_only_refusal_does_not_cascade_into_its_importer_holds() -> Bool {
  match infer_censuses().infer_only {
    InferCensusContextRefused => false
    InferCensusReported { walls: w, roots: roots, a_members: a, roots_in_subject: _, roots_outside_subject: _ } =>
      w == 1 && length(xs: a) == 0 && infer_single_root_is_b(roots: roots, infer: true, fan_out: 1)
  }
}

// CONTROL 3, THE ROUTE (DESIGN section 3 pairing). With b's defect removed, both rows must disappear:
// a's row existed only because of b. RED if a still refuses with b fixed, which would mean control 1's
// member was not caused by the edge it claims.
test fn census_infer_fixing_the_provider_removes_both_rows_holds() -> Bool {
  match infer_censuses().fixed {
    InferCensusContextRefused => false
    InferCensusReported { walls: w, roots: roots, a_members: a, roots_in_subject: _, roots_outside_subject: _ } =>
      w == 0 && length(xs: roots) == 0 && length(xs: a) == 0
  }
}

// CONTROL 4, THE SUBJECT CLOSURE. Two infer roots, b and u. b is in s's import closure (s -> a -> b);
// u is in no one's. Expected: b marked inside and u outside, each exactly once. RED if every root were
// marked inside (u would be), or if the walk followed importers instead of imports (b would be
// outside, since nothing b imports reaches s).
test fn census_infer_roots_are_marked_against_the_subject_closure_holds() -> Bool {
  match infer_censuses().subject {
    InferCensusContextRefused => false
    InferCensusReported { walls: _, roots: _, a_members: _, roots_in_subject: inside, roots_outside_subject: outside } =>
      inside == [^census_infer_b_cu] && outside == [^census_infer_u_cu]
  }
}
