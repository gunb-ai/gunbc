module v2.test.claim.body_lowering_data_literal_door

import v2.compiler.normalize { normalize }
import v2.test.parse.expression_bodied_fn_decl_parse { g_tokenize_parse, g_tree_has_arrow_body }
import v2.std.diagnostic { Accepted, Outcome, Rejected }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.text { String }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE NATIVE DOOR'S ONE-LINE CONTROL, ON THE INTERPRETED v2 ROUTE (MQ-5, #12942). The door's accepting
// control (fixture.native_cli_door.door_probe) is a `data` declaration whose initializer is one Int
// literal; the emitted compiler refused it with body_lowering_reason_unrecognised_lowered_shape at a
// synthetic node once the cut made every reader classify its input through body_term_of. Nothing on the
// required floor normalized that shape, so the refusal surfaced only on the native emit-build lane. This
// claim normalizes the same source through the same v2 pipeline, interpreted, and asserts it is admitted
// with its arrow body present -- the data declaration lowered to its nullary member.
//
// The parse and normalize are one nullary producer, filled in preparation under the single-claim fill
// debt of v2.workflow.floor_pure_producer_share floor_single_claim_fill_debt:
// a whole-grammar parse plus normalize is past one claim's budget, and the claim reads the result.

data door_data_literal_source: String = "module fixture.native_cli_door.door_probe\n\ndata native_cli_door_probe_value: Int = 606060\n"

fn door_data_literal_normalized() -> Outcome<Node> {
  match g_tokenize_parse(text: door_data_literal_source, file: ^probe_door_data_literal) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: tree, diagnostics: _ } =>
      match normalize(parse_tree: tree) {
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
        Accepted { value: normalized, diagnostics: d } => Accepted { value: normalized.root, diagnostics: d }
      }
  }
}

test fn a_data_declaration_with_an_int_literal_normalizes_holds() -> Bool {
  match door_data_literal_normalized() {
    Rejected { diagnostics: _ } => false
    Accepted { value: root, diagnostics: _ } => g_tree_has_arrow_body(root: root)
  }
}
