module v2.test.claim.module_header

import std.types { Bool, List }
import v2.std.integer { Int }
import v2.std.text { String }
import v2.std.algebra { for_all, length }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.diagnostic { Accepted, Rejected }
import v2.compiler.module_header {
  ModuleHeaderAbsent,
  ModuleHeaderDeclared,
  ModuleHeaderRead,
  ModuleHeaderReader,
  ModuleHeaderRefused,
  module_header_read
}
import v2.compiler.module_acquisition { AcquisitionEnvReady, AcquisitionEnvUnprepared, acquisition_env, acquisition_header_reader }
import v2.compiler.parse { PreparedVoidGrammar }
import v2.compiler.program_assembly { dag_prepared_grammar, dag_prepared_lex }
import v2.cli.repository_layout { repository_storage_layout }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// WITNESSES OF THE ONE MODULE-HEADER READING (v2.compiler.module_header module_header_read). The subject is
// the reading itself, so each control hands it SUPPLIED TEXT and asserts what it takes from the text: the
// name a header declares, the absence of any, or the refusal of text that is not a header. The real lexer
// and the grammar's module_header production decide each case; none of the controls recognises a keyword
// or a delimiter, so a control that passed because the reader spelled `module` itself would fail the
// cases that spell it differently.
//
// The reader the controls hold is built from the shared prepared carriers (dag_prepared_lex,
// dag_prepared_grammar), the carriers the lookup's reader is built from, and the INHABITANCE CONTROL at the
// end builds the reader the acquirer and the layout verb really use (acquisition_env) and asserts it reads
// as this one does. A grammar that did not prepare reads as void and refuses every header, so no control
// can pass over a reader that read nothing.

fn reader() -> ModuleHeaderReader {
  ModuleHeaderReader {
    lex: dag_prepared_lex(),
    grammar: match dag_prepared_grammar() {
      Accepted { value: prepared, diagnostics: _ } => prepared
      Rejected { diagnostics: _ } => PreparedVoidGrammar
    }
  }
}

fn read_text(read: ModuleHeaderRead) -> String {
  match read {
    ModuleHeaderDeclared { module: name } => concat("declared:", name)
    ModuleHeaderAbsent => "absent"
    ModuleHeaderRefused { cause: _ } => "refused"
  }
}

fn header_of(content: String) -> String {
  read_text(read: module_header_read(reader: reader(), file: "test/header.dag", content: content))
}

// ---- accepted spellings ---------------------------------------------------------------------------------------

test fn the_plain_header_declares_its_module() -> Bool {
  header_of(content: "module a.b\n") == "declared:a.b"
    && header_of(content: "module a.b.c.d\n") == "declared:a.b.c.d"
    && header_of(content: "module a\n") == "declared:a"
}

test fn a_header_with_tabs_or_mixed_whitespace_declares_its_module() -> Bool {
  header_of(content: "module\ta.b\n") == "declared:a.b"
    && header_of(content: "module \t a.b\n") == "declared:a.b"
    && header_of(content: "module  a.b  \t \n") == "declared:a.b"
    && header_of(content: "  module a.b\n") == "declared:a.b"
}

test fn a_header_with_crlf_line_endings_declares_its_module() -> Bool {
  header_of(content: "module a.b\r\n") == "declared:a.b"
    && header_of(content: "\r\n// lead\r\nmodule a.b\r\nfn f() -> Bool { true }\r\n") == "declared:a.b"
}

test fn a_header_with_a_trailing_annotation_declares_its_module() -> Bool {
  header_of(content: "module a.b // note\n") == "declared:a.b"
    && header_of(content: "module a.b // module a.c\nfn f() -> Bool { true }\n") == "declared:a.b"
    && header_of(content: "module a.b//tight\n") == "declared:a.b"
}

test fn blank_lines_and_annotations_around_the_header_do_not_move_it() -> Bool {
  header_of(content: "\n\n// lead\n\nmodule a.b\n// after\n\nfn f() -> Bool { true }\n") == "declared:a.b"
    && header_of(content: "// one\n// two\nmodule a.b") == "declared:a.b"
}

test fn a_header_without_a_final_newline_declares_its_module() -> Bool {
  header_of(content: "module a.b") == "declared:a.b"
}

// ---- no header, and what is not one ----------------------------------------------------------------------------

test fn a_file_with_no_token_declares_nothing() -> Bool {
  header_of(content: "") == "absent"
    && header_of(content: "\n\n  \t\n") == "absent"
    && header_of(content: "// only prose\n\n// and more\n") == "absent"
}

test fn text_whose_first_token_is_not_a_header_is_refused_not_absent() -> Bool {
  header_of(content: "no header here\n") == "refused"
    && header_of(content: "fn f() -> Bool { true }\n") == "refused"
    && header_of(content: "import std.types { Bool }\nmodule a.b\n") == "refused"
}

// ---- a later `module` is not the header -------------------------------------------------------------------------

// The header is the first thing a file says. Each control below holds a `module a.b` that is NOT the
// header, in a comment, a string and a declaration, and the reading is the file's actual first token's.
test fn a_later_comment_string_or_line_that_spells_a_module_is_never_the_header() -> Bool {
  header_of(content: "module a.real\n// module a.b\n") == "declared:a.real"
    && header_of(content: "module a.real\ndata s: String = \"module a.b\"\n") == "declared:a.real"
    && header_of(content: "module a.real\nmodule a.b\n") == "declared:a.real"
    && header_of(content: "// module a.b\nfn f() -> Bool { true }\n") == "refused"
    && header_of(content: "data s: String = \"module a.b\"\nmodule a.b\n") == "refused"
}

// ---- malformed names, and headers the reader cannot take whole ---------------------------------------------------

test fn a_malformed_name_is_refused_and_never_read_as_a_shorter_one() -> Bool {
  header_of(content: "module a..b\n") == "refused"
    && header_of(content: "module .a\n") == "refused"
    && header_of(content: "module a.\n") == "refused"
    && header_of(content: "module a b\n") == "refused"
    && header_of(content: "module\n") == "refused"
    && header_of(content: "module 1a\n") == "refused"
    && header_of(content: "module \"a.b\"\n") == "refused"
}

// The production consumes a whole token list, so the unit the reader hands it is a line: a header that
// shares its line with another declaration, or continues on the next, refuses with the parse's cause and is
// never truncated to the name that happened to come first.
test fn a_header_sharing_or_splitting_its_line_is_refused() -> Bool {
  header_of(content: "module a.b fn f() -> Bool { true }\n") == "refused"
    && header_of(content: "module a.b module a.c\n") == "refused"
    && header_of(content: "module\na.b\n") == "refused"
    && header_of(content: "module a.\nb\n") == "refused"
}

// ---- cost shape: the read is linear in the lines before the header ---------------------------------------------------

fn trivia_lines(remaining: Int) -> String {
  if remaining <= 0 {
    ""
  } else {
    concat("// leading note\n\n", trivia_lines(remaining: remaining - 1))
  }
}

// A leading block of annotations and blank lines reads exactly as the header alone: the lines are tokenized
// one at a time because a line that yields no token leaves the lexer where it began.
test fn a_long_leading_block_reads_as_the_header_alone() -> Bool {
  header_of(content: concat(trivia_lines(remaining: 40), "module a.b\n")) == header_of(content: "module a.b\n")
    && header_of(content: concat(trivia_lines(remaining: 40), "module a.b\n")) == "declared:a.b"
    && header_of(content: trivia_lines(remaining: 40)) == "absent"
    && header_of(content: concat(trivia_lines(remaining: 40), "no header here\n")) == "refused"
}

// ---- the law ---------------------------------------------------------------------------------------------------------

// The module a reader of the TEXT sees (authored here, not derived by the reader under test), per case. An
// empty name is a text that declares none. The reader accepts exactly the text whose authored module it
// declares, and declares nothing for the rest.
type HeaderCase {
  content: String
  authored: String
}

data header_cases: List<HeaderCase> = [
  HeaderCase { content: "module a.b\n", authored: "a.b" },
  HeaderCase { content: "module\ta.b\n", authored: "a.b" },
  HeaderCase { content: "module a.b // a.c\n", authored: "a.b" },
  HeaderCase { content: "// a.c\r\nmodule a.b\r\n", authored: "a.b" },
  HeaderCase { content: "module a.c\n// module a.b\n", authored: "a.c" },
  HeaderCase { content: "module a.b.c\n", authored: "a.b.c" },
  HeaderCase { content: "// module a.b\n", authored: "" },
  HeaderCase { content: "data s: String = \"module a.b\"\n", authored: "" },
  HeaderCase { content: "module a..b\n", authored: "" },
  HeaderCase { content: "module a.b fn f() -> Bool { true }\n", authored: "" }
]

fn reads_as_authored(case: HeaderCase) -> Bool {
  match module_header_read(reader: reader(), file: "test/header.dag", content: case.content) {
    ModuleHeaderDeclared { module: name } => name == case.authored
    ModuleHeaderAbsent => case.authored == ""
    ModuleHeaderRefused { cause: _ } => case.authored == ""
  }
}

test fn the_reader_declares_exactly_the_module_a_reader_of_the_text_sees() -> Bool {
  length(xs: header_cases) > 5 && for_all(xs: header_cases, predicate: fn(case) { reads_as_authored(case: case) })
}

// ---- inhabitance ---------------------------------------------------------------------------------------------------------

// The reader the acquirer's lookup and the layout verb really hold is the one acquisition_env builds. It
// reads the spellings above as this claim's reader does, and a reader that read nothing would fail the
// declared case; deleting the production reader makes this fail, so the supplied values above stay
// attached to the route the corpus takes.
test fn the_reader_the_acquirer_holds_reads_headers_as_this_reader_does() -> Bool {
  match acquisition_env(layout: repository_storage_layout(), bindings: []) {
    AcquisitionEnvUnprepared { diagnostics: _ } => false
    AcquisitionEnvReady { env: env } =>
      read_text(read: module_header_read(reader: acquisition_header_reader(env: env), file: "test/header.dag", content: "// note\nmodule\ta.b // tail\nfn f() -> Bool { true }\n")) == "declared:a.b"
        && read_text(read: module_header_read(reader: acquisition_header_reader(env: env), file: "test/header.dag", content: "data s: String = \"module a.b\"\nmodule a.b\n")) == "refused"
        && read_text(read: module_header_read(reader: acquisition_header_reader(env: env), file: "test/header.dag", content: "// only\n")) == "absent"
  }
}
