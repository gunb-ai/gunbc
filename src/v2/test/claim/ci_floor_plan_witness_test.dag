// v2/test/claim/ci_floor_plan_witness_test.dag
//
// Model witnesses for the spec-derived CI floor plan (`v2.workflow.ci_floor_plan`) — the
// topology the scheduler runs as the default CI runtime. These prove the ORDER and
// PARALLELISM facts on the pure plan (no host), each discriminating (DESIGN §5):
//   - dependency order: the compile-clean gate is the sole batch-0 job;
//   - fail-fast root:   the corpus does NOT run before compile-clean;
//   - parallelism:      the independent gates + corpus share one later layer.
// (The fail-closed-on-RED + halt fact is the host's `--perturb-check` receipt.)

module v2.test.claim.ci_floor_plan_witness

import std.realization {
  Runnable, RunnableSingleClaim, RunnableDiscoveryBatch,
}
import v2.workflow.ci_floor_plan {
  gunbc_ci_floor_batches, corpus_runnable,
  gunbc_ci_floor_plan_serializes_heavy_resolves,
  gunbc_ci_floor_plan_co_runs_heavy_without_serialization,
  witness_floor_tight_budget_backs_off_envelope,
  witness_floor_fail_open_would_exceed_budget,
  witness_floor_unreadable_budget_uses_conservative_envelope,
}
import gunbc.ci_layer_roots { witness_discovery_scan_dirs, witness_layer_roots }
import v2.std.algebra { length, list_snoc_item }
import v2.std.collection { List }

data corpus_sentinel: String = "__corpus__"

fn runnable_function(r: Runnable) -> String {
  match r {
    RunnableSingleClaim { entry: _, function: f } => f
    RunnableDiscoveryBatch { source_roots: _, scan_dirs: _, explicit_entries: _, skip_unaffected_node_frontier: _ } => corpus_sentinel
  }
}

fn batch_functions(b: List<Runnable>) -> List<String> {
  fold(b, init: [], f: fn(acc, r) { list_snoc_item(xs: acc, item: runnable_function(r: r)) })
}

fn list_contains_str(xs: List<String>, target: String) -> Bool {
  fold(xs, init: false, f: fn(acc, x) { acc || (x == target) })
}

// Three readiness layers: compile-clean (root), then the corpus + cheap gates, then the
// serialized heavy source-root-ingest resolve (at most one heavy whole-tree resolve per layer,
// so it never co-runs with the corpus once run_walk launches a whole layer at once).
fn witness_three_readiness_layers() -> Bool {
  gunbc_ci_floor_batches().length() == 3
}

// Dependency order: the compile-clean gate is the SOLE batch-0 job.
fn witness_compile_root_runs_first() -> Bool {
  let batches = gunbc_ci_floor_batches()
  (batches.first().length() == 1) &&
    list_contains_str(xs: batch_functions(b: batches.first()), target: "dsl_compile_clean_gate_passes")
}

// Discriminating: the corpus must NOT be in batch 0 — it depends on compile-clean,
// so a plan that scheduled it eagerly (no dependency edge) goes RED here.
fn witness_corpus_not_before_compile() -> Bool {
  let batches = gunbc_ci_floor_batches()
  !list_contains_str(xs: batch_functions(b: batches.first()), target: corpus_sentinel)
}

// Parallelism: the independent gates + corpus share one later readiness layer
// (a per-node serialization would split them, giving length 1 → RED).
fn witness_independent_jobs_parallelize() -> Bool {
  gunbc_ci_floor_batches().skip(n: 1).first().length() > 1
}

// Scan dirs are carried by the plan discovery batch — authority from ci_layer_roots.
fn witness_discovery_scan_dirs_in_plan() -> Bool {
  match corpus_runnable() {
    RunnableDiscoveryBatch { source_roots: _, scan_dirs: dirs, explicit_entries: _, skip_unaffected_node_frontier: _ } =>
      list_contains_str(xs: dirs, target: "dsl/test/claim")
    _ => false
  }
}

fn witness_scan_dirs_match_layer_authority() -> Bool {
  match corpus_runnable() {
    RunnableDiscoveryBatch { source_roots: _, scan_dirs: dirs, explicit_entries: _, skip_unaffected_node_frontier: _ } =>
      list_contains_str(xs: dirs, target: witness_discovery_scan_dirs.first())
    _ => false
  }
}

// Dissolution relocated from CiSpec.witness_entries: the plan's discovery batch
// is marker-driven only — no hand-listed explicit_entries (§3/§5).
fn witness_corpus_has_no_explicit_entries() -> Bool {
  match corpus_runnable() {
    RunnableDiscoveryBatch { source_roots: roots, scan_dirs: _, explicit_entries: entries, skip_unaffected_node_frontier: _ } =>
      (length(xs: entries) == 0) &&
        list_contains_str(xs: roots, target: "src/v2") &&
        list_contains_str(xs: roots, target: "dsl") &&
        list_contains_str(xs: roots, target: witness_layer_roots.first())
    _ => false
  }
}

fn witness_corpus_skip_node_frontier_enabled() -> Bool {
  match corpus_runnable() {
    RunnableDiscoveryBatch { source_roots: _, scan_dirs: _, explicit_entries: _, skip_unaffected_node_frontier: enabled } =>
      enabled
    _ => false
  }
}

// Per-node serialization: the heavy source-root-ingest resolve is NOT in the corpus's layer
// (batch 2) — it sits alone in a later layer (batch 3). Discriminating: a plan without the
// resource edge would place it next to the corpus in batch 2, flipping this RED.
fn witness_source_ingest_serialized_after_corpus() -> Bool {
  let batches = gunbc_ci_floor_batches()
  let corpus_layer = batches.skip(n: 1).first()
  let ingest_layer = batches.skip(n: 2).first()
  list_contains_str(xs: batch_functions(b: corpus_layer), target: corpus_sentinel) &&
    !list_contains_str(xs: batch_functions(b: corpus_layer), target: "source_root_ingest_gate_passes") &&
    list_contains_str(xs: batch_functions(b: ingest_layer), target: "source_root_ingest_gate_passes")
}

// §5 plan oracle bundled with its discriminating control (true-when-correct, so discovery-safe):
// every scheduled readiness layer carries at most one heavy whole-tree resolve, AND dropping the
// serialization edge co-runs two in the corpus layer. The witness that would catch a concurrent
// heavy-resolve OOM (exit 137) at model time.
fn witness_plan_serializes_heavy_resolves() -> Bool {
  gunbc_ci_floor_plan_serializes_heavy_resolves() &&
    gunbc_ci_floor_plan_co_runs_heavy_without_serialization()
}

test fn ci_floor_plan_witnesses() -> Bool {
  witness_three_readiness_layers() &&
    witness_compile_root_runs_first() &&
    witness_corpus_not_before_compile() &&
    witness_independent_jobs_parallelize() &&
    witness_discovery_scan_dirs_in_plan() &&
    witness_scan_dirs_match_layer_authority() &&
    witness_corpus_has_no_explicit_entries() &&
    witness_corpus_skip_node_frontier_enabled() &&
    witness_source_ingest_serialized_after_corpus() &&
    witness_plan_serializes_heavy_resolves()
}

// §1-C: the floor's exposed per-run demand ResourceEnvelope, on the LIVE floor inputs (real breadth +
// measured per-shard peak). A tight host budget backs the derived width below shard_count and the
// envelope's memory stays under budget; a memory-blind width over-commits the same budget (RED control,
// same shared fit predicate); a 0-byte budget exposes the conservative committed width. The floor never
// OOMs by construction — the exposed demand can never exceed the budget it was derived against.
test fn ci_floor_run_envelope_witnesses() -> Bool {
  witness_floor_tight_budget_backs_off_envelope() &&
    witness_floor_fail_open_would_exceed_budget() &&
    witness_floor_unreadable_budget_uses_conservative_envelope()
}
