module v2.test.claim.collection.list_at_equivalence

import std.types { List }
import v2.std.collection { list_at_optional, list_at_reference }
import v2.std.optional { Absent, Optional, Present }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE ONE FIXTURE BOTH ROUTES ANSWER. `list_at_optional` is the realized projection of the `get`
// primitive (the seed indexes its persistent carrier); `list_at_reference` is the modeled fold the
// `gunbc.primitive_egress` `get` row names as its reference. Each row carries its expected value
// explicitly, so a kernel that agreed with the reference by sharing its bug would still be false.
// Absent reads as -1, which no element of the fixture is.
data list_at_fixture: List<Int> = [10, 20, 30]

fn list_at_value(answer: Optional<Int>) -> Int {
  match answer {
    Present { value: v } => v
    Absent => -1
  }
}

fn list_at_row_holds(index: Int, expected: Int) -> Bool {
  list_at_value(answer: list_at_optional(xs: list_at_fixture, index: index)) == expected
    && list_at_value(answer: list_at_reference(xs: list_at_fixture, index: index)) == expected
}

test fn list_at_reads_every_in_range_index_on_both_routes() -> Bool  {
  list_at_row_holds(index: 0, expected: 10)
    && list_at_row_holds(index: 1, expected: 20)
    && list_at_row_holds(index: 2, expected: 30)
}

// THE REFUSAL SHAPE, the row a sentinel-returning kernel fails: past the end and negative are both
// Absent on both routes, never a default element.
test fn list_at_answers_absent_outside_the_list_on_both_routes() -> Bool  {
  list_at_row_holds(index: 3, expected: -1)
    && list_at_row_holds(index: 100, expected: -1)
    && list_at_row_holds(index: -1, expected: -1)
}

test fn list_at_on_the_empty_list_is_absent_on_both_routes() -> Bool  {
  list_at_value(answer: list_at_optional(xs: [], index: 0)) == -1
    && list_at_value(answer: list_at_reference(xs: [], index: 0)) == -1
}
